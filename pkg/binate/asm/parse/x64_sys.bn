package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sys"

// The x86-64 system instructions (pkg/binate/asm/x64/sys), as clang takes them: without operands
// (x64SysZero); `clzero` and `invlpga` with their implicit registers written or not (`clzero rax`,
// `invlpga rax, ecx`); with a memory operand (the descriptor tables, invlpg, the prefetches, the
// cache-line instructions, the xsave and fxsave families, ldmxcsr / stmxcsr); with one register or
// word (lldt, ltr, verr, verw, lmsw, sldt, str, smsw, rdrand, rdseed, the fs / gs bases, rdpid);
// with two operands (lar, lsl, invpcid, ud1, GNU as's ud0, in, out, lfs, lgs, lss); and the
// control, debug and segment registers (x64_sysreg.bn).  The encoders check the operands.

// x64SysZero reports whether mnem names a system instruction without operands, emitting it when
// emit is set.
func x64SysZero(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	var k int = x64WordIndex(mnem,
			" rdmsr wrmsr rdpmc rdtsc rdtscp cpuid lfence mfence sfence cli sti clac stac clts swapgs "
					"invd wbinvd wbnoinvd monitor mwait monitorx mwaitx xgetbv xsetbv rdpkru wrpkru rsm ")
	if k < 0 { return false }
	if emit { x64EmitSysZero(a, k) }
	return true
}

// x64WordIndex returns the position among list's space-separated words (list starts and ends with
// a space) of the one name names, case-insensitively, or -1.
func x64WordIndex(name *[]readonly char, list *[]readonly char) int {
	var k int = 0
	var start int = 1
	for i := 1; i < len(list); i++ {
		if list[i] != ' ' { continue }
		if mnemIs(name, list[start:i]) { return k }
		k++
		start = i + 1
	}
	return -1
}

// x64EmitSysZero emits the system instruction without operands at position k of x64SysZero's
// list.
func x64EmitSysZero(a @asm.Assembler, k int) {
	switch k {
	case 0:  sys.Rdmsr(a)
	case 1:  sys.Wrmsr(a)
	case 2:  sys.Rdpmc(a)
	case 3:  sys.Rdtsc(a)
	case 4:  sys.Rdtscp(a)
	case 5:  sys.Cpuid(a)
	case 6:  sys.Lfence(a)
	case 7:  sys.Mfence(a)
	case 8:  sys.Sfence(a)
	case 9:  sys.Cli(a)
	case 10: sys.Sti(a)
	case 11: sys.Clac(a)
	case 12: sys.Stac(a)
	case 13: sys.Clts(a)
	case 14: sys.Swapgs(a)
	case 15: sys.Invd(a)
	case 16: sys.Wbinvd(a)
	case 17: sys.Wbnoinvd(a)
	case 18: sys.Monitor(a)
	case 19: sys.Mwait(a)
	case 20: sys.Monitorx(a)
	case 21: sys.Mwaitx(a)
	case 22: sys.Xgetbv(a)
	case 23: sys.Xsetbv(a)
	case 24: sys.Rdpkru(a)
	case 25: sys.Wrpkru(a)
	default: sys.Rsm(a)
	}
}

// x64SysInstruction parses and emits the system instruction mnem (l just after it) when it names
// one with operands, or `mov`, `push` or `pop` of a control, debug or segment register, and
// reports whether it did.
func x64SysInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if mnemIs(mnem, "mov") { return x64SysMov(p, l) }
	if x64SysPushPop(p, l, mnem) { return true }
	if mnemIs(mnem, "clzero") || mnemIs(mnem, "invlpga") {
		parseX64SysImplicit(p, l, mnem)
		return true
	}
	var kind int = x64SysOperands(mnem)
	if kind == 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	var first x64.Operand
	l, tok, first = parseX64Operand(p, l, tok)
	if p.HasError { return true }
	var second x64.Operand = x64.Imm(0)
	if kind == 2 {
		l, tok, second = expectX64CommaOp(p, l, tok)
		if p.HasError { return true }
	}
	if !x64AtEOL(p, tok) || !x64TlsCallOk(p, first) || !x64TlsCallOk(p, second) { return true }
	x64EmitSeg(p)
	if kind == 1 {
		x64EmitSysOne(p.Asm, mnem, first)
	} else {
		x64EmitSysTwo(p.Asm, mnem, first, second)
	}
	return true
}

// x64SysOperands returns the number of operands of the system instruction mnem, 1 or 2, or 0 when
// mnem names none with operands.
func x64SysOperands(mnem *[]readonly char) int {
	if x64WordIndex(mnem, " lar lsl invpcid ud0 ud1 in out lfs lgs lss ") >= 0 { return 2 }
	if x64SysMemIndex(mnem) >= 0 || x64SysRegIndex(mnem) >= 0 { return 1 }
	return 0
}

// parseX64SysImplicit parses clzero or invlpga (mnem; l just after it), bare or with its implicit
// registers written as clang takes them (`clzero rax`, `invlpga rax, ecx`), and emits it.
func parseX64SysImplicit(p @Parser, l Lexer, mnem *[]readonly char) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF {
		// The registers written: rax, then (invlpga) ecx.
		var count int = 1
		if mnemIs(mnem, "invlpga") { count = 2 }
		for i := 0; i < count; i++ {
			if i > 0 {
				if tok.Kind != TOK_COMMA {
					setErr(p, "expected ','")
					return
				}
				l, tok = LexNext(l)
			}
			if tok.Kind != TOK_IDENT || x64WordIndex(tok.Text, " rax ecx ") != i {
				setErr(p, "clzero takes rax, and invlpga rax, ecx, if any operands")
				return
			}
			l, tok = LexNext(l)
		}
		if !x64AtEOL(p, tok) { return }
	}
	if mnemIs(mnem, "clzero") {
		sys.Clzero(p.Asm)
	} else {
		sys.Invlpga(p.Asm)
	}
}

// x64SysMemIndex returns the position in its list of the system instruction mnem with a memory
// operand, or -1.
func x64SysMemIndex(mnem *[]readonly char) int {
	return x64WordIndex(mnem,
			" lgdt lidt sgdt sidt invlpg prefetcht0 prefetcht1 prefetcht2 prefetchnta prefetchit0 "
					"prefetchit1 prefetch prefetchw prefetchwt1 clflush clflushopt clwb cldemote ldmxcsr "
					"stmxcsr xsave xsave64 xrstor xrstor64 xsaveopt xsaveopt64 xsavec xsavec64 xsaves "
					"xsaves64 xrstors xrstors64 fxsave fxsave64 fxrstor fxrstor64 ")
}

// x64SysRegIndex returns the position in its list of the system instruction mnem with one register
// or word operand, or -1.
func x64SysRegIndex(mnem *[]readonly char) int {
	return x64WordIndex(mnem,
			" lldt ltr verr verw lmsw sldt str smsw rdrand rdseed rdfsbase rdgsbase wrfsbase wrgsbase "
					"rdpid ")
}

// x64EmitSysOne emits the one-operand system instruction mnem (x64SysMemIndex, x64SysRegIndex).
func x64EmitSysOne(a @asm.Assembler, mnem *[]readonly char, op x64.Operand) {
	var m int = x64SysMemIndex(mnem)
	if m >= 20 {
		// The state saves and restores, in pairs: the plain form, then its 64.
		var w64 bool = (m - 20) % 2 == 1
		switch (m - 20) / 2 {
		case 0:  sys.Xsave(a, op, w64)
		case 1:  sys.Xrstor(a, op, w64)
		case 2:  sys.Xsaveopt(a, op, w64)
		case 3:  sys.Xsavec(a, op, w64)
		case 4:  sys.Xsaves(a, op, w64)
		case 5:  sys.Xrstors(a, op, w64)
		case 6:  sys.Fxsave(a, op, w64)
		default: sys.Fxrstor(a, op, w64)
		}
		return
	}
	switch m {
	case 0:  sys.Lgdt(a, op)
	case 1:  sys.Lidt(a, op)
	case 2:  sys.Sgdt(a, op)
	case 3:  sys.Sidt(a, op)
	case 4:  sys.Invlpg(a, op)
	case 5:  sys.Prefetcht0(a, op)
	case 6:  sys.Prefetcht1(a, op)
	case 7:  sys.Prefetcht2(a, op)
	case 8:  sys.Prefetchnta(a, op)
	case 9:  sys.Prefetchit0(a, op)
	case 10: sys.Prefetchit1(a, op)
	case 11: sys.Prefetch(a, op)
	case 12: sys.Prefetchw(a, op)
	case 13: sys.Prefetchwt1(a, op)
	case 14: sys.Clflush(a, op)
	case 15: sys.Clflushopt(a, op)
	case 16: sys.Clwb(a, op)
	case 17: sys.Cldemote(a, op)
	case 18: sys.Ldmxcsr(a, op)
	case 19: sys.Stmxcsr(a, op)
	default: x64EmitSysReg(a, x64SysRegIndex(mnem), op)
	}
}

// x64EmitSysReg emits the system instruction with one register or word operand at position k of
// x64SysRegIndex's list.
func x64EmitSysReg(a @asm.Assembler, k int, op x64.Operand) {
	switch k {
	case 0:  sys.Lldt(a, op)
	case 1:  sys.Ltr(a, op)
	case 2:  sys.Verr(a, op)
	case 3:  sys.Verw(a, op)
	case 4:  sys.Lmsw(a, op)
	case 5:  sys.Sldt(a, op)
	case 6:  sys.Str(a, op)
	case 7:  sys.Smsw(a, op)
	case 8:  sys.Rdrand(a, op)
	case 9:  sys.Rdseed(a, op)
	case 10: sys.Rdfsbase(a, op)
	case 11: sys.Rdgsbase(a, op)
	case 12: sys.Wrfsbase(a, op)
	case 13: sys.Wrgsbase(a, op)
	default: sys.Rdpid(a, op)
	}
}

// x64EmitSysTwo emits the two-operand system instruction mnem (x64SysOperands).
func x64EmitSysTwo(a @asm.Assembler, mnem *[]readonly char, first x64.Operand, second x64.Operand) {
	if mnemIs(mnem, "lar") {
		sys.Lar(a, first, second)
	} else if mnemIs(mnem, "lsl") {
		sys.Lsl(a, first, second)
	} else if mnemIs(mnem, "invpcid") {
		sys.Invpcid(a, first, second)
	} else if mnemIs(mnem, "ud0") {
		sys.Ud0(a, first, second)
	} else if mnemIs(mnem, "ud1") {
		sys.Ud1(a, first, second)
	} else if mnemIs(mnem, "in") {
		sys.In(a, first, second)
	} else if mnemIs(mnem, "out") {
		sys.Out(a, first, second)
	} else if mnemIs(mnem, "lfs") {
		sys.Lfs(a, first, second)
	} else if mnemIs(mnem, "lgs") {
		sys.Lgs(a, first, second)
	} else {
		sys.Lss(a, first, second)
	}
}
