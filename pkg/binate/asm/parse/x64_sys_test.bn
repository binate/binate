package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The system instructions (x64_sys.bn, and sysret / sysenter / sysexit in x64_zero.bn) against
// clang's bytes and relocations (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`);
// the encodings in full are package sys's tests, these the parsing.  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64TlsCase in x64_tls_test.bn.)

// Without operands, the implicit registers of clzero and invlpga written or not, in upper case
// too; the system call returns.
func TestX64SysNoOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rdmsr", "0f 32")
	e = x64SrcHex(e, "CPUID", "0f a2")
	e = x64SrcHex(e, "lfence", "0f ae e8")
	e = x64SrcHex(e, "wbnoinvd", "f3 0f 09")
	e = x64SrcHex(e, "rsm", "0f aa")
	e = x64SrcHex(e, "rdtscp", "0f 01 f9")
	e = x64SrcHex(e, "swapgs", "0f 01 f8")
	e = x64SrcHex(e, "monitor", "0f 01 c8")
	e = x64SrcHex(e, "mwaitx", "0f 01 fb")
	e = x64SrcHex(e, "clzero", "0f 01 fc")
	e = x64SrcHex(e, "clzero rax", "0f 01 fc")
	e = x64SrcHex(e, "invlpga", "0f 01 df")
	e = x64SrcHex(e, "invlpga rax, ecx", "0f 01 df")
	e = x64SrcHex(e, "sysret", "0f 07")
	e = x64SrcHex(e, "sysretq", "48 0f 07")
	e = x64SrcHex(e, "sysenter", "0f 34")
	e = x64SrcHex(e, "sysexit", "0f 35")
	e = x64SrcHex(e, "sysexitq", "48 0f 35")
	return e
}

// The memory forms: each size class, a segment override, R8..R15 in the address, the 64 forms.
func TestX64SysMemory() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lgdt [rax]", "0f 01 10")
	e = x64SrcHex(e, "lgdt fword ptr [rax]", "0f 01 10")
	e = x64SrcHex(e, "lidt tbyte ptr [rax]", "0f 01 18")
	e = x64SrcHex(e, "sgdt fs:[rax]", "64 0f 01 00")
	e = x64SrcHex(e, "invlpg byte ptr [rax]", "0f 01 38")
	e = x64SrcHex(e, "prefetcht0 byte ptr [rax]", "0f 18 08")
	e = x64SrcHex(e, "prefetchw [rax]", "0f 0d 08")
	e = x64SrcHex(e, "prefetchit1 [rbx + 8]", "0f 18 73 08")
	e = x64SrcHex(e, "clflushopt byte ptr [r9 + r10*4 + 8]", "66 43 0f ae 7c 91 08")
	e = x64SrcHex(e, "cldemote [rax]", "0f 1c 00")
	e = x64SrcHex(e, "xsave64 [rax]", "48 0f ae 20")
	e = x64SrcHex(e, "xsavec [rax]", "0f c7 20")
	e = x64SrcHex(e, "xrstors64 [rax]", "48 0f c7 18")
	e = x64SrcHex(e, "fxrstor64 [rax]", "48 0f ae 08")
	e = x64SrcHex(e, "fxsave [r9 + 8]", "41 0f ae 41 08")
	e = x64SrcHex(e, "ldmxcsr dword ptr [rax]", "0f ae 10")
	e = x64SrcHex(e, "stmxcsr [rax]", "0f ae 18")
	e = x64SrcHex(e, "invpcid rax, xmmword ptr [rbx]", "66 0f 38 82 03")
	e = x64SrcHex(e, "invpcid r9, [r10]", "66 45 0f 38 82 0a")
	return e
}

// The register and word forms, the two-operand ones, port I/O.
func TestX64SysRegisters() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lldt ax", "0f 00 d0")
	e = x64SrcHex(e, "ltr word ptr [rax]", "0f 00 18")
	e = x64SrcHex(e, "verw word ptr [rax]", "0f 00 28")
	e = x64SrcHex(e, "lmsw ax", "0f 01 f0")
	e = x64SrcHex(e, "sldt rax", "48 0f 00 c0")
	e = x64SrcHex(e, "str ax", "66 0f 00 c8")
	e = x64SrcHex(e, "smsw word ptr [rax]", "0f 01 20")
	e = x64SrcHex(e, "lar rax, word ptr [rbx]", "48 0f 02 03")
	e = x64SrcHex(e, "lar ax, rbx", "66 0f 02 c3")
	e = x64SrcHex(e, "lsl r9d, r10w", "45 0f 03 ca")
	e = x64SrcHex(e, "rdrand rax", "48 0f c7 f0")
	e = x64SrcHex(e, "rdseed r9", "49 0f c7 f9")
	e = x64SrcHex(e, "rdfsbase rax", "f3 48 0f ae c0")
	e = x64SrcHex(e, "wrgsbase eax", "f3 0f ae d8")
	e = x64SrcHex(e, "rdpid rax", "f3 0f c7 f8")
	e = x64SrcHex(e, "ud1 eax, ebx", "0f b9 c3")
	e = x64SrcHex(e, "ud1 rax, qword ptr [rbx]", "48 0f b9 03")
	e = x64SrcHex(e, "ud0 rax, rbx", "48 0f ff c3")
	e = x64SrcHex(e, "in al, 0x60", "e4 60")
	e = x64SrcHex(e, "in ax, dx", "66 ed")
	e = x64SrcHex(e, "in al, -1", "e4 ff")
	e = x64SrcHex(e, "out 0x60, eax", "e7 60")
	e = x64SrcHex(e, "out dx, al", "ee")
	e = x64SrcHex(e, "N = 4\nin eax, N", "e5 04")
	return e
}

// RIP-relative and GOT memory operands, symbolic ports.
func TestX64SysSymbols() testing.TestResult {
	var e @[]char = ""
	e = x64TlsCase(e, "prefetcht0 [rip + x]", "0f 18 0d 00 00 00 00", x64.FIX_REL32_LEA, 3, 0)
	e = x64TlsCase(e, "cldemote byte ptr [rip + x]", "0f 1c 05 00 00 00 00", x64.FIX_REL32_LEA, 3, 0)
	e = x64TlsCase(e, "lgdt [rip + x@GOTPCREL]", "0f 01 15 00 00 00 00", x64.FIX_GOTPCREL_PLAIN, 3, 0)
	e = x64TlsCase(e, "in al, offset x", "e4 00", asm.FIX_DATA_ABS8, 1, 0)
	e = x64TlsCase(e, "out offset x, al", "e6 00", asm.FIX_DATA_ABS8, 1, 0)
	return e
}

// What clang rejects: operands of the wrong kind or size, ports past an imm8 or not DX, written
// operands of the bare instructions (clang's `monitor rax, ecx, edx` among them), `sysretl`; and
// what bnas rejects as GNU as does: a lock, repeat prefix or lock-elision hint before them.
func TestX64SysRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "in al, 256")
	e = x64LineRejected(e, "in al, -129")
	e = x64LineRejected(e, "in rax, dx")
	e = x64LineRejected(e, "in al, cx")
	e = x64LineRejected(e, "out dx, rax")
	e = x64LineRejected(e, "lldt eax")
	e = x64LineRejected(e, "verr eax")
	e = x64LineRejected(e, "invlpg qword ptr [rax]")
	e = x64LineRejected(e, "invlpg rax")
	e = x64LineRejected(e, "prefetcht0 qword ptr [rax]")
	e = x64LineRejected(e, "prefetcht0 rax")
	e = x64LineRejected(e, "clflush qword ptr [rax]")
	e = x64LineRejected(e, "stmxcsr qword ptr [rax]")
	e = x64LineRejected(e, "invpcid eax, xmmword ptr [rbx]")
	e = x64LineRejected(e, "rdrand word ptr [rax]")
	e = x64LineRejected(e, "rdfsbase ax")
	e = x64LineRejected(e, "rdpid eax")
	e = x64LineRejected(e, "lar eax, dword ptr [rbx]")
	e = x64LineRejected(e, "ud1 eax, bx")
	e = x64LineRejected(e, "ud0")
	e = x64LineRejected(e, "xgetbv eax")
	e = x64LineRejected(e, "cpuid eax")
	e = x64LineRejected(e, "sysret rax")
	e = x64LineRejected(e, "sysretl")
	e = x64LineRejected(e, "monitor rax, ecx, edx")
	e = x64LineRejected(e, "mwait eax, ecx")
	e = x64LineRejected(e, "clzero eax")
	e = x64LineRejected(e, "invlpga eax, ecx")
	e = x64LineRejected(e, "invlpga rax")
	e = x64LineRejected(e, "lock lgdt [rax]")
	e = x64LineRejected(e, "lock cpuid")
	e = x64LineRejected(e, "rep cpuid")
	e = x64LineRejected(e, "xacquire rdtsc")
	return e
}

// LFS / LGS / LSS with memory of any size, a segment override, R8..R15, a RIP-relative far
// pointer; LDS and LES, which 64-bit mode lacks, and a register source are errors.
func TestX64FarPointerLoads() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lfs eax, [rax]", "0f b4 00")
	e = x64SrcHex(e, "lfs ax, dword ptr [rax]", "66 0f b4 00")
	e = x64SrcHex(e, "lfs rax, tbyte ptr [rax]", "48 0f b4 00")
	e = x64SrcHex(e, "lgs r9, tbyte ptr [r10]", "4d 0f b5 0a")
	e = x64SrcHex(e, "lgs ax, fs:[rax]", "64 66 0f b5 00")
	e = x64SrcHex(e, "lss ax, [r9 + 8]", "66 41 0f b2 41 08")
	e = x64TlsCase(e, "lfs eax, [rip + x]", "0f b4 05 00 00 00 00", x64.FIX_REL32_LEA, 3, 0)
	e = x64LineRejected(e, "lfs eax, ebx")
	e = x64LineRejected(e, "lds eax, fword ptr [rax]")
	e = x64LineRejected(e, "les eax, fword ptr [rax]")
	return e
}

// mmword (a qword) and xword (a tbyte), clang's other size names.
func TestX64SizeAliases() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lgdt mmword ptr [rax]", "0f 01 10")
	e = x64SrcHex(e, "mov rax, mmword ptr [rbx]", "48 8b 03")
	e = x64SrcHex(e, "ud1 rax, mmword ptr [rbx]", "48 0f b9 03")
	e = x64SrcHex(e, "lgdt xword ptr [rax]", "0f 01 10")
	e = x64SrcHex(e, "xsave mmword ptr [rax]", "0f ae 20")
	e = x64LineRejected(e, "mov eax, mmword ptr [rbx]")
	e = x64LineRejected(e, "mov rax, xword ptr [rbx]")
	return e
}

// XLAT: `xlatb`, `xlat` with exactly [rbx] (a byte or no size) in any segment, its override
// emitted (clang drops it), ds: emitting nothing; a prefix written before it.  Another address,
// another size, `xlat` alone (GNU as's) and an operand of xlatb are errors.
func TestX64Xlat() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "xlatb", "d7")
	e = x64SrcHex(e, "xlat byte ptr [rbx]", "d7")
	e = x64SrcHex(e, "xlat [rbx]", "d7")
	e = x64SrcHex(e, "XLAT byte ptr fs:[rbx]", "64 d7")
	e = x64SrcHex(e, "xlat byte ptr ds:[rbx]", "d7")
	e = x64SrcHex(e, "fs xlatb", "64 d7")
	e = x64SrcHex(e, "rex64 xlatb", "48 d7")
	e = x64LineRejected(e, "xlat")
	e = x64LineRejected(e, "xlat byte ptr [rax]")
	e = x64LineRejected(e, "xlat word ptr [rbx]")
	e = x64LineRejected(e, "xlat byte ptr [rbx + 1]")
	e = x64LineRejected(e, "xlatb rax")
	e = x64LineRejected(e, "rep xlatb")
	e = x64LineRejected(e, "lock xlatb")
	return e
}
