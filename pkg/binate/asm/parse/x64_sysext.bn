package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sys"

// The x86-64 system extensions (pkg/binate/asm/x64/sys), as clang takes them: without operands
// (x64SysExtZero; invlpgb with `rax, edx` written too, x64ImplicitRegs), PadLock's among them;
// xbegin to a label plus numbers or `sym@PLT`; xabort and hreset with an imm8; the CET
// instructions, their size in the name's d / q (incsspd, rdsspq, wrssd, wrussq) matching the
// register's; umonitor, umwait, tpause, senduipi, ptwrite, lkgs, rstorssp, clrssbsy, the wide Key
// Locker instructions, llwpcb, slwpcb and prefetchrst2 with one operand; movdiri, movdir64b,
// enqcmd, enqcmds, encodekey128 and encodekey256 with two; rdmsr / wrmsrns with an immediate MSR
// number (bare, they are the instructions without operands), urdmsr and uwrmsr; and lwpins and
// lwpval with three.  The encoders check the operands.

// x64SysExtZero reports whether mnem names a system extension without operands, emitting it when
// emit is set.
func x64SysExtZero(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	var k int = x64WordIndex(mnem,
			" xend xtest xsusldtrk xresldtrk endbr64 endbr32 saveprevssp setssbsy serialize uiret testui "
					"clui stui pconfig rdpru invlpgb tlbsync pbndkb erets eretu wrmsrns rdmsrlist wrmsrlist "
					"xstore xstorerng xcryptecb xcryptcbc xcryptctr xcryptcfb xcryptofb montmul xsha1 xsha256 ")
	if k < 0 { return false }
	if !emit { return true }
	switch k {
	case 0:      sys.Xend(a)
	case 1:      sys.Xtest(a)
	case 2:      sys.Xsusldtrk(a)
	case 3:      sys.Xresldtrk(a)
	case 4:      sys.Endbr64(a)
	case 5:      sys.Endbr32(a)
	case 6:      sys.Saveprevssp(a)
	case 7:      sys.Setssbsy(a)
	case 8:      sys.Serialize(a)
	case 9:      sys.Uiret(a)
	case 10:     sys.Testui(a)
	case 11:     sys.Clui(a)
	case 12:     sys.Stui(a)
	case 13:     sys.Pconfig(a)
	case 14:     sys.Rdpru(a)
	case 15:     sys.Invlpgb(a)
	case 16:     sys.Tlbsync(a)
	case 17:     sys.Pbndkb(a)
	case 18:     sys.Erets(a)
	case 19:     sys.Eretu(a)
	case 20:     sys.Wrmsrns(a)
	case 21:     sys.Rdmsrlist(a)
	case 22:     sys.Wrmsrlist(a)
	case 23, 24: sys.Xstore(a)
	case 25:     sys.Xcryptecb(a)
	case 26:     sys.Xcryptcbc(a)
	case 27:     sys.Xcryptctr(a)
	case 28:     sys.Xcryptcfb(a)
	case 29:     sys.Xcryptofb(a)
	case 30:     sys.Montmul(a)
	case 31:     sys.Xsha1(a)
	default:     sys.Xsha256(a)
	}
	return true
}

// x64PadlockOwnRep reports whether mnem names a PadLock instruction whose F3 is part of it
// (xcrypt*, montmul, xsha*): rep, repe or repz before one stands for that F3, and repne or repnz
// cannot stand there, as GNU as has it (clang emits both bytes).
func x64PadlockOwnRep(mnem *[]readonly char) bool {
	return x64WordIndex(mnem,
			" xcryptecb xcryptcbc xcryptctr xcryptcfb xcryptofb montmul xsha1 xsha256 ") >= 0
}

// x64SysExtInstruction parses and emits the system extension mnem (l just after it) when it names
// one with operands, and reports whether it did.
func x64SysExtInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if mnemIs(mnem, "xbegin") {
		parseX64Xbegin(p, l)
		return true
	}
	if mnemIs(mnem, "xabort") || mnemIs(mnem, "hreset") {
		var tok Token
		l, tok = LexNext(l)
		var imm x64.Operand
		var ok bool = false
		l, tok, imm, ok = parseX64ImmOperand(p, l, tok, mnem)
		if !ok || !x64AtEOL(p, tok) { return true }
		if mnemIs(mnem, "xabort") {
			sys.Xabort(p.Asm, imm)
		} else {
			sys.Hreset(p.Asm, imm)
		}
		return true
	}
	// rdmsr and wrmsrns with operands are the immediate-MSR forms; bare, they are x64SysZero's and
	// x64SysExtZero's.
	if mnemIs(mnem, "rdmsr") || mnemIs(mnem, "wrmsrns") {
		var next Token
		_, next = LexNext(l)
		if next.Kind == TOK_EOF { return false }
	}
	var one int = x64WordIndex(mnem,
			" incsspd incsspq rdsspd rdsspq umonitor umwait tpause senduipi ptwrite lkgs rstorssp "
					"clrssbsy aesencwide128kl aesdecwide128kl aesencwide256kl aesdecwide256kl llwpcb slwpcb "
					"prefetchrst2 ")
	var two int = x64WordIndex(mnem,
			" wrssd wrssq wrussd wrussq movdiri movdir64b enqcmd enqcmds rdmsr wrmsrns urdmsr uwrmsr "
					"encodekey128 encodekey256 ")
	var three int = x64WordIndex(mnem, " lwpins lwpval ")
	if one < 0 && two < 0 && three < 0 { return false }
	var n int = 1
	if two >= 0 { n = 2 }
	if three >= 0 { n = 3 }
	first, second, third, ok := parseX64SysOperands(p, l, n)
	if !ok { return true }
	if one >= 0 {
		x64EmitSysExtOne(p, one, first)
	} else if two >= 0 {
		x64EmitSysExtTwo(p, two, first, second)
	} else if three == 0 {
		sys.Lwpins(p.Asm, first, second, third)
	} else {
		sys.Lwpval(p.Asm, first, second, third)
	}
	return true
}

// parseX64Xbegin parses xbegin's target from l (just after the mnemonic) — a label plus numbers
// (parseX64Target), or `sym@PLT` — and emits it.
func parseX64Xbegin(p @Parser, l Lexer) {
	var tok Token
	l, tok = LexNext(l)
	var plt bool = false
	var ahead Lexer = l
	var t Token = tok
	for t.Kind != TOK_EOF {
		if t.Kind == TOK_AT { plt = true }
		ahead, t = LexNext(ahead)
	}
	var target @[]char
	var addend int64 = 0
	var ok bool = false
	l, tok, target, addend, ok = parseX64Target(p, l, tok)
	if ok && x64AtEOL(p, tok) { sys.Xbegin(p.Asm, target, addend, plt) }
}

// x64CetSizeOk reports whether register-size suffix of the CET mnemonic at position k of a word
// list (its d / q: even positions d, odd q) matches size, else sets the error.
func x64CetSizeOk(p @Parser, k int, size int) bool {
	var want int = x64.SZ32
	if k % 2 == 1 { want = x64.SZ64 }
	if size == want { return true }
	setErr(p, "the d / q in the name is the register's size, 32 or 64 bits")
	return false
}

// x64EmitSysExtOne emits the one-operand system extension at position k of x64SysExtInstruction's
// list.
func x64EmitSysExtOne(p @Parser, k int, op x64.Operand) {
	var a @asm.Assembler = p.Asm
	if k < 4 && op.Kind == x64.OP_REG && !x64CetSizeOk(p, k, op.Size) { return }
	switch k {
	case 0, 1: sys.Incssp(a, op)
	case 2, 3: sys.Rdssp(a, op)
	case 4:    sys.Umonitor(a, op)
	case 5:    sys.Umwait(a, op)
	case 6:    sys.Tpause(a, op)
	case 7:    sys.Senduipi(a, op)
	case 8:
		if x64Unsized(op) {
			x64AmbiguousSize(p, "ptwrite")
			return
		}
		sys.Ptwrite(a, op)
	case 9:  sys.Lkgs(a, op)
	case 10: sys.Rstorssp(a, op)
	case 11: sys.Clrssbsy(a, op)
	case 12: sys.Aesencwide128kl(a, op)
	case 13: sys.Aesdecwide128kl(a, op)
	case 14: sys.Aesencwide256kl(a, op)
	case 15: sys.Aesdecwide256kl(a, op)
	case 16: sys.Llwpcb(a, op)
	case 17: sys.Slwpcb(a, op)
	default: sys.Prefetchrst2(a, op)
	}
}

// x64EmitSysExtTwo emits the two-operand system extension at position k of x64SysExtInstruction's
// list.
func x64EmitSysExtTwo(p @Parser, k int, first x64.Operand, second x64.Operand) {
	var a @asm.Assembler = p.Asm
	if k < 4 && second.Kind == x64.OP_REG && !x64CetSizeOk(p, k, second.Size) { return }
	switch k {
	case 0, 1: sys.Wrss(a, first, second)
	case 2, 3: sys.Wruss(a, first, second)
	case 4:    sys.Movdiri(a, first, second)
	case 5:    sys.Movdir64b(a, first, second)
	case 6:    sys.Enqcmd(a, first, second)
	case 7:    sys.Enqcmds(a, first, second)
	case 8:    sys.RdmsrImm(a, first, second)
	case 9:    sys.WrmsrnsImm(a, first, second)
	case 10:   sys.Urdmsr(a, first, second)
	case 11:   sys.Uwrmsr(a, first, second)
	case 12:   sys.Encodekey128(a, first, second)
	default:   sys.Encodekey256(a, first, second)
	}
}
