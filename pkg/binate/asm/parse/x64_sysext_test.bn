package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The system extensions (x64_sysext.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`), RSTORSSP and CLRSSBSY's qword against
// GNU as's; the encodings in full are package sys's tests, these the parsing.  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64TlsCase in x64_tls_test.bn, x64LineErrorHas in
// x64_prefix_test.bn.)

// Without operands, in upper case too, invlpgb's implicit registers written or not; rdmsr and
// wrmsrns bare.
func TestX64SysExtNoOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "xend", "0f 01 d5")
	e = x64SrcHex(e, "XTEST", "0f 01 d6")
	e = x64SrcHex(e, "xsusldtrk", "f2 0f 01 e8")
	e = x64SrcHex(e, "xresldtrk", "f2 0f 01 e9")
	e = x64SrcHex(e, "endbr64", "f3 0f 1e fa")
	e = x64SrcHex(e, "endbr32", "f3 0f 1e fb")
	e = x64SrcHex(e, "saveprevssp", "f3 0f 01 ea")
	e = x64SrcHex(e, "setssbsy", "f3 0f 01 e8")
	e = x64SrcHex(e, "serialize", "0f 01 e8")
	e = x64SrcHex(e, "uiret", "f3 0f 01 ec")
	e = x64SrcHex(e, "testui", "f3 0f 01 ed")
	e = x64SrcHex(e, "clui", "f3 0f 01 ee")
	e = x64SrcHex(e, "stui", "f3 0f 01 ef")
	e = x64SrcHex(e, "pconfig", "0f 01 c5")
	e = x64SrcHex(e, "rdpru", "0f 01 fd")
	e = x64SrcHex(e, "invlpgb", "0f 01 fe")
	e = x64SrcHex(e, "invlpgb rax, edx", "0f 01 fe")
	e = x64SrcHex(e, "tlbsync", "0f 01 ff")
	e = x64SrcHex(e, "pbndkb", "0f 01 c7")
	e = x64SrcHex(e, "erets", "f2 0f 01 ca")
	e = x64SrcHex(e, "eretu", "f3 0f 01 ca")
	e = x64SrcHex(e, "wrmsrns", "0f 01 c6")
	e = x64SrcHex(e, "rdmsrlist", "f2 0f 01 c6")
	e = x64SrcHex(e, "wrmsrlist", "f3 0f 01 c6")
	e = x64SrcHex(e, "rdmsr", "0f 32")
	e = x64SrcHex(e, "fs xend", "64 0f 01 d5")
	return e
}

// XBEGIN's rel32: R_X86_64_PC32's fixup (x64.FIX_REL32_PC) with an addend, PLT32's with @PLT, a
// label defined after it resolved in place, a numeric local label; XABORT's and HRESET's imm8.
func TestX64Transactions() testing.TestResult {
	var e @[]char = ""
	e = x64TlsCase(e, "xbegin x", "c7 f8 00 00 00 00", x64.FIX_REL32_PC, 2, 0)
	e = x64TlsCase(e, "xbegin x + 4", "c7 f8 00 00 00 00", x64.FIX_REL32_PC, 2, 4)
	e = x64TlsCase(e, "xbegin x@PLT", "c7 f8 00 00 00 00", x64.FIX_REL32, 2, 0)
	e = x64SrcHex(e, "xbegin L\nnop\nL:", "c7 f8 01 00 00 00 90")
	e = x64SrcHex(e, "xbegin 1f\n1:", "c7 f8 00 00 00 00")
	e = x64SrcHex(e, "xabort 5", "c6 f8 05")
	e = x64SrcHex(e, "xabort -1", "c6 f8 ff")
	e = x64SrcHex(e, "N = 4\nxabort N * 2", "c6 f8 08")
	e = x64TlsCase(e, "xabort offset x", "c6 f8 00", asm.FIX_DATA_ABS8, 2, 0)
	e = x64SrcHex(e, "hreset 1", "f3 0f 3a f0 c0 01")
	e = x64SrcHex(e, "hreset 255", "f3 0f 3a f0 c0 ff")
	return e
}

// The CET, user-wait, direct-store, user-interrupt and other forms with operands: each size,
// memory of the written size and of none, R8..R15.
func TestX64SysExtOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "incsspd eax", "f3 0f ae e8")
	e = x64SrcHex(e, "incsspq rax", "f3 48 0f ae e8")
	e = x64SrcHex(e, "rdsspd r9d", "f3 41 0f 1e c9")
	e = x64SrcHex(e, "rdsspq r9", "f3 49 0f 1e c9")
	e = x64SrcHex(e, "rstorssp [rax]", "f3 0f 01 28")
	e = x64SrcHex(e, "rstorssp qword ptr [rax]", "f3 0f 01 28")
	e = x64SrcHex(e, "clrssbsy [rax]", "f3 0f ae 30")
	e = x64SrcHex(e, "wrssd dword ptr [rax], eax", "0f 38 f6 00")
	e = x64SrcHex(e, "wrssq [r9], r10", "4d 0f 38 f6 11")
	e = x64SrcHex(e, "wrussd [rax], eax", "66 0f 38 f5 00")
	e = x64SrcHex(e, "wrussq qword ptr [rax], rax", "66 48 0f 38 f5 00")
	e = x64SrcHex(e, "umonitor r9", "f3 41 0f ae f1")
	e = x64SrcHex(e, "umwait eax", "f2 0f ae f0")
	e = x64SrcHex(e, "umwait rax", "f2 0f ae f0")
	e = x64SrcHex(e, "tpause r10d", "66 41 0f ae f2")
	e = x64SrcHex(e, "movdiri [rax], eax", "0f 38 f9 00")
	e = x64SrcHex(e, "movdiri qword ptr [rax], rax", "48 0f 38 f9 00")
	e = x64SrcHex(e, "movdir64b r9, [r10]", "66 45 0f 38 f8 0a")
	e = x64SrcHex(e, "enqcmd rax, [rbx]", "f2 0f 38 f8 03")
	e = x64SrcHex(e, "enqcmds r9, [r10]", "f3 45 0f 38 f8 0a")
	e = x64SrcHex(e, "senduipi r9", "f3 41 0f c7 f1")
	e = x64SrcHex(e, "ptwrite eax", "f3 0f ae e0")
	e = x64SrcHex(e, "ptwrite r9", "f3 49 0f ae e1")
	e = x64SrcHex(e, "ptwrite qword ptr [rax]", "f3 48 0f ae 20")
	e = x64SrcHex(e, "lkgs ax", "f2 0f 00 f0")
	e = x64SrcHex(e, "lkgs [rax]", "f2 0f 00 30")
	e = x64SrcHex(e, "lkgs r9w", "f2 41 0f 00 f1")
	e = x64TlsCase(e, "movdiri dword ptr [rip + x], eax", "0f 38 f9 05 00 00 00 00", x64.FIX_REL32_LEA,
			4, 0)
	return e
}

// RDMSR / WRMSRNS with an immediate MSR number (VEX map 7), past 2^31 too (clang takes such a
// number only written negative), a symbol; URDMSR / UWRMSR with a register or an immediate.
func TestX64MsrOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rdmsr rax, 0x10", "c4 e7 7b f6 c0 10 00 00 00")
	e = x64SrcHex(e, "rdmsr r9, 0x10", "c4 c7 7b f6 c1 10 00 00 00")
	e = x64SrcHex(e, "wrmsrns 0x10, rax", "c4 e7 7a f6 c0 10 00 00 00")
	e = x64SrcHex(e, "rdmsr rax, -1073741696", "c4 e7 7b f6 c0 80 00 00 c0")
	e = x64SrcHex(e, "rdmsr rax, 0xC0000080", "c4 e7 7b f6 c0 80 00 00 c0")
	e = x64TlsCase(e, "rdmsr rax, offset x", "c4 e7 7b f6 c0 00 00 00 00", asm.FIX_DATA_ABS32, 5, 0)
	e = x64SrcHex(e, "urdmsr rax, rbx", "f2 0f 38 f8 c3")
	e = x64SrcHex(e, "urdmsr r9, r10", "f2 45 0f 38 f8 ca")
	e = x64SrcHex(e, "urdmsr rax, -1", "c4 e7 7b f8 c0 ff ff ff ff")
	e = x64SrcHex(e, "uwrmsr rbx, rax", "f3 0f 38 f8 d8")
	e = x64SrcHex(e, "uwrmsr -1, r9", "c4 c7 7a f8 c1 ff ff ff ff")
	return e
}

// What clang rejects: operands of the wrong kind or size (a size the d / q in the name
// contradicts among them), 32-bit implicit registers, an imm8 or imm32 out of range, the wrong
// number of operands, PTWRITE's unsized memory; what GNU as rejects that clang takes: XABORT's
// immediate past an imm8 (clang keeps its low byte); what GNU as rejects that clang emits: a lock,
// repeat prefix or lock-elision hint; and what bnas does not take yet: a 32-bit address (UMONITOR
// r32, MOVDIR64B r32, m512) and MOVDIR64B's `zmmword ptr`, which GNU as rejects too.
func TestX64SysExtRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "xbegin")
	e = x64LineRejected(e, "xbegin 5")
	e = x64LineRejected(e, "xbegin x + 4@PLT")
	e = x64LineRejected(e, "xabort 256")
	e = x64LineRejected(e, "xabort -129")
	e = x64LineRejected(e, "xabort eax")
	e = x64LineRejected(e, "hreset 256")
	e = x64LineRejected(e, "hreset 1, eax")
	e = x64LineRejected(e, "xend rax")
	e = x64LineRejected(e, "invlpgb eax, edx")
	e = x64LineRejected(e, "incsspq eax")
	e = x64LineRejected(e, "rdsspd rax")
	e = x64LineRejected(e, "wrssd [rax], rax")
	e = x64LineRejected(e, "wrssq [rax], eax")
	e = x64LineRejected(e, "wrss [rax], rax")
	e = x64LineRejected(e, "rstorssp dword ptr [rax]")
	e = x64LineRejected(e, "umonitor eax")
	e = x64LineRejected(e, "umwait ax")
	e = x64LineRejected(e, "senduipi eax")
	e = x64LineRejected(e, "movdir64b eax, [ebx]")
	e = x64LineRejected(e, "movdir64b rax, xmmword ptr [rbx]")
	e = x64LineRejected(e, "movdir64b rax, zmmword ptr [rbx]")
	e = x64LineRejected(e, "movdiri [rax], ax")
	e = x64LineRejected(e, "ptwrite ax")
	e = x64LineRejected(e, "ptwrite word ptr [rax]")
	e = x64LineErrorHas(e, "ptwrite [rax]", "ambiguous operand size")
	e = x64LineRejected(e, "lkgs eax")
	e = x64LineRejected(e, "rdmsr rax")
	e = x64LineRejected(e, "rdmsr eax, 0x10")
	e = x64LineRejected(e, "rdmsr rax, 0x100000000")
	e = x64LineRejected(e, "wrmsrns rax, 0x10")
	e = x64LineRejected(e, "urdmsr eax, ebx")
	e = x64LineRejected(e, "urdmsr rax, [rbx]")
	e = x64LineRejected(e, "uwrmsr rax, 0x10")
	e = x64LineRejected(e, "lock xbegin x")
	e = x64LineRejected(e, "lock lkgs ax")
	e = x64LineRejected(e, "rep xend")
	e = x64LineRejected(e, "rep endbr64")
	e = x64LineRejected(e, "xacquire xtest")
	e = x64LineErrorHas(e, "rstorssp dword ptr [rax]", "takes a qword of memory")
	e = x64LineErrorHas(e, "invlpgb rax, ecx", "invlpgb takes no operands, or rax, edx")
	return e
}

// Key Locker's forms without XMM operands: ENCODEKEY128 / 256 with R8..R15, the wide forms with
// memory of any size, a `[rip + x]` operand; what clang rejects (64-bit or memory operands, a
// register for the handle) and what GNU as rejects that clang emits (a lock or repeat prefix).
func TestX64KeyLocker() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "encodekey128 eax, ebx", "f3 0f 38 fa c3")
	e = x64SrcHex(e, "encodekey128 r9d, r10d", "f3 45 0f 38 fa ca")
	e = x64SrcHex(e, "ENCODEKEY256 eax, ebx", "f3 0f 38 fb c3")
	e = x64SrcHex(e, "aesencwide128kl [rax]", "f3 0f 38 d8 00")
	e = x64SrcHex(e, "aesencwide128kl [r9 + r10*2 + 8]", "f3 43 0f 38 d8 44 51 08")
	e = x64SrcHex(e, "aesdecwide128kl qword ptr [rax]", "f3 0f 38 d8 08")
	e = x64SrcHex(e, "aesencwide256kl byte ptr [rax]", "f3 0f 38 d8 10")
	e = x64SrcHex(e, "aesdecwide256kl [rax]", "f3 0f 38 d8 18")
	e = x64TlsCase(e, "aesencwide128kl [rip + x]", "f3 0f 38 d8 05 00 00 00 00", x64.FIX_REL32_LEA, 5,
			0)
	e = x64LineRejected(e, "encodekey128 rax, rbx")
	e = x64LineRejected(e, "encodekey128 eax, [rbx]")
	e = x64LineRejected(e, "aesencwide128kl rax")
	e = x64LineRejected(e, "aesencwide128kl")
	e = x64LineRejected(e, "rep encodekey128 eax, ebx")
	e = x64LineRejected(e, "lock aesencwide128kl [rax]")
	return e
}

// PadLock, XSTORE under each repeat prefix (as written), the others' own F3 standing for a rep /
// repe / repz before them (after a segment or data16 prefix too, and for that statement alone);
// what GNU as rejects (repne before one with its own F3, as clang emits F3 F2; a lock or
// lock-elision hint) and what clang rejects (operands).
func TestX64Padlock() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "xstore", "0f a7 c0")
	e = x64SrcHex(e, "XSTORERNG", "0f a7 c0")
	e = x64SrcHex(e, "rep xstore", "f3 0f a7 c0")
	e = x64SrcHex(e, "repne xstorerng", "f2 0f a7 c0")
	e = x64SrcHex(e, "xcryptecb", "f3 0f a7 c8")
	e = x64SrcHex(e, "xcryptcbc", "f3 0f a7 d0")
	e = x64SrcHex(e, "xcryptctr", "f3 0f a7 d8")
	e = x64SrcHex(e, "xcryptcfb", "f3 0f a7 e0")
	e = x64SrcHex(e, "xcryptofb", "f3 0f a7 e8")
	e = x64SrcHex(e, "montmul", "f3 0f a6 c0")
	e = x64SrcHex(e, "xsha1", "f3 0f a6 c8")
	e = x64SrcHex(e, "xsha256", "f3 0f a6 d0")
	e = x64SrcHex(e, "rep xcryptecb", "f3 0f a7 c8")
	e = x64SrcHex(e, "repz montmul", "f3 0f a6 c0")
	e = x64SrcHex(e, "repe xsha256", "f3 0f a6 d0")
	e = x64SrcHex(e, "fs xstore", "64 0f a7 c0")
	e = x64SrcHex(e, "fs rep xcryptecb", "64 f3 0f a7 c8")
	e = x64SrcHex(e, "data16 rep xsha1", "66 f3 0f a6 c8")
	e = x64SrcHex(e, "rep xcryptecb ; xsha1", "f3 0f a7 c8 f3 0f a6 c8")
	e = x64LineErrorHas(e, "repne xcryptecb", "F3 is its own")
	e = x64LineRejected(e, "repnz montmul")
	e = x64LineRejected(e, "lock xstore")
	e = x64LineRejected(e, "xacquire xstore")
	e = x64LineRejected(e, "xstore rax")
	e = x64LineRejected(e, "xcryptecb rax")
	e = x64LineRejected(e, "rep xcryptecb rax")
	return e
}

// PREFETCHRST2 and AMD's lightweight profiling: each size, R8..R15, memory r/m32, the imm32's range
// and a symbol's; what clang rejects and what GNU as rejects that clang emits (a lock or repeat
// prefix).
func TestX64PrefetchrsAndLwp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "prefetchrst2 byte ptr [rax]", "0f 18 20")
	e = x64SrcHex(e, "prefetchrst2 [r9]", "41 0f 18 21")
	e = x64SrcHex(e, "llwpcb eax", "8f e9 78 12 c0")
	e = x64SrcHex(e, "llwpcb r9", "8f c9 f8 12 c1")
	e = x64SrcHex(e, "SLWPCB rax", "8f e9 f8 12 c8")
	e = x64SrcHex(e, "lwpins eax, ebx, 1", "8f ea 78 12 c3 01 00 00 00")
	e = x64SrcHex(e, "lwpins rax, dword ptr [rbx], 1", "8f ea f8 12 03 01 00 00 00")
	e = x64SrcHex(e, "N = 4\nlwpins r9, r10d, N", "8f ca b0 12 c2 04 00 00 00")
	e = x64SrcHex(e, "lwpval eax, ebx, 0xffffffff", "8f ea 78 12 cb ff ff ff ff")
	e = x64SrcHex(e, "lwpval rax, [r9], -1", "8f ca f8 12 09 ff ff ff ff")
	e = x64TlsCase(e, "lwpins eax, ebx, offset x", "8f ea 78 12 c3 00 00 00 00", asm.FIX_DATA_ABS32, 5,
			0)
	e = x64TlsCase(e, "lwpins eax, dword ptr [rip + x], 1", "8f ea 78 12 05 00 00 00 00 01 00 00 00",
			x64.FIX_REL32_LEA, 5, -4)
	e = x64LineRejected(e, "prefetchrst2 dword ptr [rax]")
	e = x64LineRejected(e, "llwpcb [rax]")
	e = x64LineRejected(e, "lwpins rax, rbx, 1")
	e = x64LineRejected(e, "lwpins eax, ebx, 0x100000000")
	e = x64LineRejected(e, "lwpins eax, ebx")
	e = x64LineRejected(e, "lock lwpins eax, ebx, 1")
	e = x64LineRejected(e, "rep llwpcb eax")
	return e
}
