package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sys"

// The x86-64 control, debug and segment registers as operands, as clang takes them: `mov` between
// one of CR0..CR15, DR0..DR15 and a 64-bit register, or between a segment register (es, cs, ss,
// ds, fs, gs) and a 16-, 32- or 64-bit register or a word of memory; and `push` / `pop` of fs or
// gs, 64 bits (as GNU as reads `push fs`; clang emits the 16-bit push), with `pushq` / `popq` and
// the 16-bit `pushw` / `popw` (GNU as's spellings).  A segment name before `:` is an operand's
// segment override, not the register.  No lock-elision hint goes before these moves (xrelease
// takes mov's 88 / 89 / C6 / C7 forms alone, as GNU as).

// The kinds of special register x64SpecialReg reads.
const (
	x64RegCr int = 1
	x64RegDr int = 2
	x64RegSeg int = 3
)

// x64SpecialReg returns the kind (x64RegCr, x64RegDr, x64RegSeg) and number of the control, debug
// or segment register name names (case-insensitively; a segment's number as sys.ES .. sys.GS; db0
// .. db15, clang's other names of DR0 .. DR15, in lower case only), or 0, 0 for none.
func x64SpecialReg(name *[]readonly char) (int, int) {
	var seg int = x64WordIndex(name, " es cs ss ds fs gs ")
	if seg >= 0 { return x64RegSeg, seg }
	if len(name) < 3 || len(name) > 4 { return 0, 0 }
	var kind int = 0
	if (name[0] == 'c' || name[0] == 'C') && (name[1] == 'r' || name[1] == 'R') { kind = x64RegCr }
	if (name[0] == 'd' || name[0] == 'D') && (name[1] == 'r' || name[1] == 'R') { kind = x64RegDr }
	if name[0] == 'd' && name[1] == 'b' { kind = x64RegDr }
	if kind == 0 { return 0, 0 }
	var n int = 0
	for i := 2; i < len(name); i++ {
		if name[i] < '0' || name[i] > '9' { return 0, 0 }
		n = n * 10 + cast(int, name[i]) - 48 // the digit's value ('0' is 48)
	}
	if n > 15 || (len(name) == 4 && name[2] == '0') { return 0, 0 }
	return kind, n
}

// x64SpecialRegAt reports the special register tok names (x64SpecialReg) when it stands as a whole
// operand — the token after it (from l) ends the operand, not a `:` of a segment override.
func x64SpecialRegAt(l Lexer, tok Token) (int, int) {
	if tok.Kind != TOK_IDENT { return 0, 0 }
	kind, n := x64SpecialReg(tok.Text)
	if kind == 0 { return 0, 0 }
	var after Token
	_, after = LexNext(l)
	if after.Kind != TOK_EOF && after.Kind != TOK_COMMA { return 0, 0 }
	return kind, n
}

// x64SysMov parses `mov` (l just after it) when an operand is a control, debug or segment register,
// and emits it; it reports whether it did.
func x64SysMov(p @Parser, l Lexer) bool {
	var tok Token
	l, tok = LexNext(l)
	kind, n := x64SpecialRegAt(l, tok)
	if kind != 0 {
		if p.X64Hle != 0 {
			x64HleError(p)
			return true
		}
		l, tok = LexNext(l)
		var src x64.Operand
		l, tok, src = expectX64CommaOp(p, l, tok)
		if p.HasError || !x64AtEOL(p, tok) || !x64TlsCallOk(p, src) { return true }
		x64EmitSeg(p)
		if kind == x64RegCr {
			sys.MovToCr(p.Asm, n, src)
		} else if kind == x64RegDr {
			sys.MovToDr(p.Asm, n, src)
		} else {
			sys.MovToSeg(p.Asm, n, src)
		}
		return true
	}
	// The register as the source: the line's last operand.
	var ahead Lexer = l
	var t Token = tok
	var last Token = tok
	var lastAt Lexer = l
	for t.Kind != TOK_EOF {
		if t.Kind == TOK_COMMA {
			lastAt, last = LexNext(ahead)
		}
		ahead, t = LexNext(ahead)
	}
	kind, n = x64SpecialRegAt(lastAt, last)
	if kind == 0 { return false }
	if p.X64Hle != 0 {
		x64HleError(p)
		return true
	}
	var dst x64.Operand
	l, tok, dst = parseX64Operand(p, l, tok)
	if p.HasError { return true }
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return true
	}
	l, tok = LexNext(l)
	l, tok = LexNext(l)
	if !x64AtEOL(p, tok) || !x64TlsCallOk(p, dst) { return true }
	x64EmitSeg(p)
	if kind == x64RegCr {
		sys.MovFromCr(p.Asm, dst, n)
	} else if kind == x64RegDr {
		sys.MovFromDr(p.Asm, dst, n)
	} else {
		sys.MovFromSeg(p.Asm, dst, n)
	}
	return true
}

// x64SysPushPop parses push / pop / pushq / popq / pushw / popw (mnem; l just after it) of a
// segment register and emits it, reporting whether it did (another operand is push / pop's own).
func x64SysPushPop(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var push bool = mnemIs(mnem, "push") || mnemIs(mnem, "pushq") || mnemIs(mnem, "pushw")
	var pop bool = mnemIs(mnem, "pop") || mnemIs(mnem, "popq") || mnemIs(mnem, "popw")
	if !push && !pop { return false }
	var tok Token
	l, tok = LexNext(l)
	kind, n := x64SpecialRegAt(l, tok)
	if kind != x64RegSeg {
		if mnemIs(mnem, "push") || mnemIs(mnem, "pop") { return false }
		setErr(p, "pushq / popq / pushw / popw take fs or gs")
		return true
	}
	l, tok = LexNext(l)
	if !x64AtEOL(p, tok) { return true }
	var size int = x64.SZ64
	if mnemIs(mnem, "pushw") || mnemIs(mnem, "popw") { size = x64.SZ16 }
	if push {
		sys.PushSeg(p.Asm, n, size)
	} else {
		sys.PopSeg(p.Asm, n, size)
	}
	return true
}
