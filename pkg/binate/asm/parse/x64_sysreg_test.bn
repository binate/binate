package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The control, debug and segment registers as operands (x64_sysreg.bn) against clang's bytes, and
// `push` / `pop` of fs / gs against GNU as's (the user's decision: clang's `push fs` is the 16-bit
// push).  (x64SrcHex and x64LineRejected are in x64_target_test.bn.)

// Each move, either way, upper case, a register 8..15 on either side, memory with a segment
// override; and a segment name before `:`, which stays an override.
func TestX64SpecialRegisterMoves() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov rax, cr0", "0f 20 c0")
	e = x64SrcHex(e, "mov cr0, rax", "0f 22 c0")
	e = x64SrcHex(e, "mov r9, cr8", "45 0f 20 c1")
	e = x64SrcHex(e, "mov cr8, r9", "45 0f 22 c1")
	e = x64SrcHex(e, "mov rax, cr15", "44 0f 20 f8")
	e = x64SrcHex(e, "mov RAX, CR3", "0f 20 d8")
	e = x64SrcHex(e, "mov rax, dr0", "0f 21 c0")
	e = x64SrcHex(e, "mov dr7, rax", "0f 23 f8")
	e = x64SrcHex(e, "mov r10, dr6", "41 0f 21 f2")
	e = x64SrcHex(e, "mov ax, ds", "8c d8")
	e = x64SrcHex(e, "mov ds, ax", "66 8e d8")
	e = x64SrcHex(e, "mov rax, fs", "48 8c e0")
	e = x64SrcHex(e, "mov eax, gs", "8c e8")
	e = x64SrcHex(e, "mov word ptr [rbx], ss", "8c 13")
	e = x64SrcHex(e, "mov es, word ptr [rbx]", "8e 03")
	e = x64SrcHex(e, "mov [rbx], ds", "8c 1b")
	e = x64SrcHex(e, "mov ds, [rbx]", "8e 1b")
	e = x64SrcHex(e, "mov fs, eax", "8e e0")
	e = x64SrcHex(e, "mov cs, ax", "66 8e c8")
	e = x64SrcHex(e, "mov ds, rax", "48 8e d8")
	e = x64SrcHex(e, "mov fs, word ptr [r9 + 8]", "41 8e 61 08")
	e = x64SrcHex(e, "mov r9w, cs", "41 8c c9")
	e = x64SrcHex(e, "mov fs, word ptr gs:[rax]", "65 8e 20")
	e = x64SrcHex(e, "mov eax, fs:[rbx]", "64 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr fs:0", "64 8b 04 25 00 00 00 00")
	return e
}

// push / pop of fs and gs at 64 bits (`push fs`, `pushq fs`) and 16 (`pushw fs`), as GNU as; other
// pushes and pops unchanged.
func TestX64SegmentPushPop() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "push fs", "0f a0")
	e = x64SrcHex(e, "pushq fs", "0f a0")
	e = x64SrcHex(e, "pushw fs", "66 0f a0")
	e = x64SrcHex(e, "pop fs", "0f a1")
	e = x64SrcHex(e, "push gs", "0f a8")
	e = x64SrcHex(e, "pop gs", "0f a9")
	e = x64SrcHex(e, "popw gs", "66 0f a9")
	e = x64SrcHex(e, "push rax", "50")
	e = x64SrcHex(e, "pop rbx", "5b")
	return e
}

// What clang rejects: a 32-bit register with a control or debug register, memory of another size
// with a segment register, two special registers, the segments 64-bit mode cannot push, GNU as's
// pushq / pushw of anything but a segment; and what bnas rejects as GNU as: a lock or a
// lock-elision hint before these moves.
func TestX64SpecialRegisterRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov eax, cr0")
	e = x64LineRejected(e, "mov cr8, eax")
	e = x64LineRejected(e, "mov ds, dword ptr [rax]")
	e = x64LineRejected(e, "mov ds, byte ptr [rax]")
	e = x64LineRejected(e, "mov qword ptr [rax], ds")
	e = x64LineRejected(e, "mov cr0, cr1")
	e = x64LineRejected(e, "mov ds, es")
	e = x64LineRejected(e, "push ds")
	e = x64LineRejected(e, "push cs")
	e = x64LineRejected(e, "pop ss")
	e = x64LineRejected(e, "pushw rax")
	e = x64LineRejected(e, "pushq rax")
	e = x64LineRejected(e, "lock mov cr0, rax")
	e = x64LineRejected(e, "xrelease mov ds, ax")
	e = x64LineRejected(e, "xrelease mov word ptr [rax], ds")
	return e
}

// db0 .. db15, clang's lower-case names of DR0 .. DR15 (a constant so named is the register, as
// clang reads it); `DB0` is a symbol to clang, as here.
func TestX64DebugRegisterAliases() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov rax, db0", "0f 21 c0")
	e = x64SrcHex(e, "mov db15, rax", "44 0f 23 f8")
	e = x64SrcHex(e, "db0 = 3\nmov rax, db0", "0f 21 c0")
	e = x64LineRejected(e, "push db0")
	return e
}
