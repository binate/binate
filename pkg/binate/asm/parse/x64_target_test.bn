package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// x86-64 jump / call targets and RIP-relative operands with addends, and lines with
// trailing text, against clang's encodings (`-target x86_64-linux-gnu`, `.intel_syntax
// noprefix`; clang picks a 2-byte jump where a nearby target allows, this assembler always
// the rel32 form, to the same target).  (newX64Parser is in x64_test.bn, lineRejected in
// parse_test.bn.)

// x64Source parses the multi-line src for x86-64 and resolves its fixups in place,
// returning the parser (its error set on failure).
func x64Source(src *[]readonly char) @Parser {
	p, a := newX64Parser()
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish()
	if !p.HasError && !a.HasError {
		x64.ResolveFixups(a)
		if !a.HasError { a.Finalize() }
	}
	return p
}

// x64SrcHex checks that src assembles to exactly the bytes hex (pairs of hex digits;
// spaces ignored) with no relocation.
func x64SrcHex(e @[]char, src *[]readonly char, hex *[]readonly char) @[]char {
	var p @Parser = x64Source(src)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if p.Asm.NumRelocs != 0 { return goldenFail(e, src, "left a relocation") }
	var s @asm.Section = p.Asm.Sections[0]
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		if !isHexDigit(hex[i]) { continue }
		if hi < 0 {
			hi = hexVal(hex[i])
			continue
		}
		if n >= s.Len || cast(int, s.Data[n]) != hi * 16 + hexVal(hex[i]) {
			return goldenFail(e, src, "wrong bytes")
		}
		n++
		hi = -1
	}
	if n != s.Len { return goldenFail(e, src, "wrong length") }
	return e
}

// x64SrcReloc checks that src assembles with exactly one relocation, against sym with
// addend (the fixup's: the object writers fold in the rel32's end-of-field bias).
func x64SrcReloc(e @[]char, src *[]readonly char, sym *[]readonly char, addend int) @[]char {
	var p @Parser = x64Source(src)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if p.Asm.NumRelocs != 1 { return goldenFail(e, src, "not exactly one relocation") }
	var r asm.Relocation = p.Asm.Relocs[0]
	if !charsEqual(p.Asm.Symbols[r.Symbol].Name, sym) || r.Addend != addend {
		return goldenFail(e, src, "relocation against the wrong symbol or addend")
	}
	return e
}

// A jump or call target is a symbol plus numbers, in any order (`lbl+2`, `4+lbl`,
// `(lbl+1)`, an alias, a constant in the sum), carried as the branch's addend.
func TestX64TargetAddends() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = "lbl: nop\nnop\nnop\nN = 4\nA = lbl + 2\n"
	e = x64SrcHex(e, buf.Concat(h, "call lbl+2"), "90 90 90 e8 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "call 4+lbl"), "90 90 90 e8 fc ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "call (lbl+1)"), "90 90 90 e8 f9 ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "call A"), "90 90 90 e8 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "call lbl+N"), "90 90 90 e8 fc ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "jmp lbl+2"), "90 90 90 e9 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "je lbl+2"), "90 90 90 0f 84 f9 ff ff ff")
	e = x64SrcReloc(e, ".global ext\ncall ext+8", "ext", 8)
	e = x64SrcReloc(e, ".global ext\ncall ext-4", "ext", -4)
	e = x64SrcReloc(e, ".global ext\njmp ext+8", "ext", 8)
	e = x64SrcReloc(e, ".global ext\njne ext+8", "ext", 8)
	return e
}

// A RIP-relative operand is `[rip + expr]`, expr a symbol plus numbers in any order, its
// addend carried into the load, store or address; a GOT-indirect one takes no addend.
func TestX64RipAddends() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = "lbl: nop\nnop\nnop\nN = 4\nA = lbl + 2\n"
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + lbl + 4]"), "90 90 90 48 8d 05 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + lbl - 1]"), "90 90 90 48 8d 05 f5 ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + 4 + lbl]"), "90 90 90 48 8d 05 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip - 4 + lbl]"), "90 90 90 48 8d 05 f2 ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + lbl - 4 + 8]"), "90 90 90 48 8d 05 fa ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + A]"), "90 90 90 48 8d 05 f8 ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "lea rax, [rip + lbl + N*2]"), "90 90 90 48 8d 05 fe ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "mov rax, [rip + lbl + 8]"), "90 90 90 48 8b 05 fe ff ff ff")
	e = x64SrcHex(e, buf.Concat(h, "mov [rip + lbl + 4], rax"), "90 90 90 48 89 05 fa ff ff ff")
	e = x64SrcReloc(e, ".global ext\nmov rax, [rip + ext + 4]", "ext", 4)
	e = x64SrcReloc(e, ".global ext\nlea rax, [rip + ext - 4]", "ext", -4)
	e = x64SrcReloc(e, ".global ext\nmov rax, qword ptr [rip + ext@GOTPCREL]", "ext", 0)
	var g @Parser = x64Source(".global ext\nmov rax, qword ptr [rip + ext@GOTPCREL + 4]")
	if !g.HasError { e = goldenFail(e, "[rip + ext@GOTPCREL + 4]", "accepted") }
	return e
}

// x64LineRejected checks that line, after `lbl:` and `N = 4`, is rejected and emits
// nothing — no bytes and no fixup.
func x64LineRejected(e @[]char, line *[]readonly char) @[]char {
	p, a := newX64Parser()
	p.ParseLine("lbl:")
	p.ParseLine("N = 4")
	var r testing.TestResult = lineRejected(p, line)
	if len(r) > 0 { return goldenFail(e, line, r) }
	if a.Sections[0].NumFixups != 0 { return goldenFail(e, line, "rejected, but left a fixup") }
	return e
}

// Text after an instruction's last operand is rejected with nothing emitted, after every
// instruction shape; and a jump or call target that is a number, `.` (which Intel syntax
// does not read as the current location), a 32-bit register, or a negated symbol (which
// clang reads as the symbol, ignoring the '-') is rejected.  (`ret 1`, RET's stack-popping
// form, is not supported: rejected, not read as `ret`.)
func TestX64TrailingTextRejected() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "nop junk")
	e = x64LineRejected(e, "ret junk")
	e = x64LineRejected(e, "ret 1")
	e = x64LineRejected(e, "syscall x")
	e = x64LineRejected(e, "int 3 4")
	e = x64LineRejected(e, "push rax rbx")
	e = x64LineRejected(e, "inc rax, rbx")
	e = x64LineRejected(e, "add rax, 1 2")
	e = x64LineRejected(e, "mov rax, rbx junk")
	e = x64LineRejected(e, "imul rax, rbx x")
	e = x64LineRejected(e, "imul rax, rbx, 3 x")
	e = x64LineRejected(e, "lea rax, [rip + lbl] x")
	e = x64LineRejected(e, "lea rax, [rip + lbl x]")
	e = x64LineRejected(e, "call lbl junk")
	e = x64LineRejected(e, "call lbl+4 x")
	e = x64LineRejected(e, "je lbl, x")
	e = x64LineRejected(e, "call rax rbx")
	e = x64LineRejected(e, "jmp rax junk")
	e = x64LineRejected(e, "jmp eax")
	e = x64LineRejected(e, "call N")
	e = x64LineRejected(e, "je 5")
	e = x64LineRejected(e, "call .")
	e = x64LineRejected(e, "jmp .+2")
	e = x64LineRejected(e, "call -lbl")
	e = x64LineRejected(e, "lea rax, [rbx + rip + lbl]")
	e = x64LineRejected(e, "lea rax, [4 rip + lbl]")
	e = x64LineRejected(e, "lea rax, [N rip + lbl]")
	e = x64LineRejected(e, "mov rcx, [rip + rax]")
	e = x64LineRejected(e, "je rax")
	e = x64LineRejected(e, "jmp rip")
	e = x64LineRejected(e, "call rip")
	e = x64LineRejected(e, "call lbl+4@PLT")
	e = x64LineRejected(e, "call lbl@GOT")
	return e
}

// A jump or call target may carry `@PLT` (clang's ELF spelling of a call through the
// PLT, which a branch to an undefined symbol takes anyway): a plain symbol only, not a
// numeric local label reference.
func TestX64TargetPlt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcReloc(e, ".global ext\ncall ext@PLT", "ext", 0)
	e = x64SrcReloc(e, ".global ext\njmp ext@plt", "ext", 0)
	e = x64SrcReloc(e, ".global ext\njne ext@PLT", "ext", 0)
	var p @Parser = x64Source("call 1f@PLT\n1: nop")
	if !p.HasError { e = goldenFail(e, "call 1f@PLT", "accepted") }
	return e
}
