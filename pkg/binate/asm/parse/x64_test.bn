// TestParseX64RipRelativePipeline exercises the RIP-relative shapes real x64
// programs need — address-of (lea), load (mov rd,[rip+sym]), and store
// (mov [rip+sym],rd) — through the full parse -> x64.ResolveFixups -> Finalize
// pipeline.  The three references are to undefined symbols, so each becomes an
// R_X86_64_PC32 relocation.  Regression guard for bnas assembling real x64 (the
// OP_RIPLABEL operand routed to LeaRipLabel / MovRipLabel / MovRipLabelStore).
func TestParseX64RipRelativePipeline() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	// Declare the referenced symbols so they exist in the symbol table as
	// undefined globals — a relocation's target must be present (else Finalize
	// errors "undefined symbol"), exactly as an external `.global` reference.
	p.ParseLine(".global msg")
	p.ParseLine(".global counter")
	p.ParseLine("lea rsi, [rip + msg]") // address-of -> LeaRipLabel
	p.ParseLine("mov rax, [rip + counter]") // load -> MovRipLabel
	p.ParseLine("add rax, 1")
	p.ParseLine("mov [rip + counter], rax") // store -> MovRipLabelStore
	p.ParseLine("syscall")
	if p.HasError { return fail(p.ErrorMsg) }
	x64.ResolveFixups(a)
	if !a.Finalize() || a.HasError {
		return fail("x64 rip-relative shapes failed to finalize")
	}
	// msg + counter(load) + counter(store) are undefined -> 3 relocations.
	if a.NumRelocs != 3 {
		return fail("expected 3 R_X86_64_PC32 relocations for the rip-relative refs")
	}
	return ""
}

// TestParseX64RipRelativeNeedsSymbol confirms a bare `[rip + disp]` with no
// symbol is rejected (a relocation needs a symbol target).
func TestParseX64RipRelativeNeedsSymbol() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	p.ParseLine("lea rsi, [rip + 8]")
	if !p.HasError {
		return fail("expected an error for symbol-less rip-relative operand")
	}
	return ""
}

// `mov rax, [rip + sym@GOTPCREL]` records a FIX_GOTPCREL fixup and emits a MOV
// (REX.W 0x8B — a GOT-indirect LOAD, not a LEA 0x8D), so the linker resolves it
// against the symbol's GOT slot (the __c_global / data-import path).
func TestParseX64GotPcRel() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	p.ParseLine(".global environ")
	p.ParseLine("mov rax, [rip + environ@GOTPCREL]")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return fail("expected one GOTPCREL fixup") }
	if s.Fixups[0].Kind != x64.FIX_GOTPCREL { return fail("the fixup should be FIX_GOTPCREL") }
	if !charsEqual(s.Fixups[0].Label, "environ") { return fail("the fixup should target environ") }
	// REX.W + MOV (0x48 0x8b) — a load through the GOT slot, not LEA (0x8d).
	if s.Data[0] != cast(uint8, 0x48) || s.Data[1] != cast(uint8, 0x8b) {
		return fail("expected REX.W + MOV (a GOT load), not a lea")
	}
	return ""
}

// A `@` suffix that is not GOTPCREL is rejected rather than silently ignored.
func TestParseX64GotPcRelBadSuffix() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	p.ParseLine("mov rax, [rip + environ@BOGUS]")
	if !p.HasError { return fail("expected an error for a non-GOTPCREL @ suffix") }
	return ""
}
