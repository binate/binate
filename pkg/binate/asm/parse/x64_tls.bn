package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The x86-64 thread-local operators, as clang takes them on ELF (Mach-O's writer rejects them):
// `sym@TPOFF` / `sym@DTPOFF`, the symbol's offset from the thread pointer / in its module's
// block, as the symbol term of a memory operand that is not RIP-relative (`[rax + x@TPOFF + 8]`,
// `x@TPOFF[rax]`, `fs:[x@TPOFF]`, `fs:x@TPOFF`, a bare `x@TPOFF`; x64_mem.bn) — the numbers
// beside it its addend (x64.MemSym) — or as a 4- or 8-byte datum (`.uint64 x@DTPOFF + 8`);
// `[rip + sym@GOTTPOFF]` (`x@gottpoff[rip]`), `@TLSGD`, `@TLSLD` and `@tlsdesc` (x64.RipTls),
// beside `@GOTPCREL` (x64.RipGotLabel) and Mach-O's `@TLVP` (x64.RipTlvp, only on `mov` into a
// 64-bit register), with no number beside them; and `call qword ptr [rax + sym@tlscall]`, the
// call through the descriptor (a MemSym of kind x64.FIX_TLSCALL, which only x64.CallMem takes).
// In an operand an operator follows its symbol's name (`8 + x@TPOFF`, not `x + 8@TPOFF` or
// `(x)@TPOFF`, which clang rejects).  The operators' names are case-insensitive.  clang also
// takes the RIP-relative ones on other operands and in data, the
// offsets in `[rip + ...]` and in 1- or 2-byte data (relocated as 4), an addend after a slot,
// `@tlscall` on any instruction and operand, relocating nonsense, and adds a subtracted symbol
// and drops an operator after the term (`x@TPOFF*2`) or a difference after a datum's (`x@TPOFF -
// .`): each is an error here.

// x64SpecGot and x64SpecTlvp are the kinds of the `@GOTPCREL` and `@TLVP` operators
// (x64OperatorKind), whose operands are x64.RipGotLabel's and x64.RipTlvp's.
const (
	x64SpecGot int = -1
	x64SpecTlvp int = -2
)

// x64OpTermStart reports whether tok (l just after it) begins an operator term: a name, then '@'.
func x64OpTermStart(l Lexer, tok Token) bool {
	if tok.Kind != TOK_IDENT { return false }
	var at Token
	l, at = LexNext(l)
	return at.Kind == TOK_AT
}

// x64OperatorKind returns the kind of the operator tok names after a memory operand's symbol and
// '@': x64.FIX_TPOFF32, x64.FIX_DTPOFF32 or x64.FIX_TLSCALL, or a RIP-relative one
// (x64RipOperatorKind) — x64SpecGot, x64SpecTlvp, x64.FIX_GOTTPOFF, FIX_TLSGD, FIX_TLSLD or
// FIX_TLSDESC; 0 for none.
func x64OperatorKind(tok Token) int {
	if tok.Kind != TOK_IDENT { return 0 }
	if mnemIs(tok.Text, "tpoff") { return x64.FIX_TPOFF32 }
	if mnemIs(tok.Text, "dtpoff") { return x64.FIX_DTPOFF32 }
	if mnemIs(tok.Text, "tlscall") { return x64.FIX_TLSCALL }
	if mnemIs(tok.Text, "gotpcrel") { return x64SpecGot }
	if mnemIs(tok.Text, "tlvp") { return x64SpecTlvp }
	if mnemIs(tok.Text, "gottpoff") { return x64.FIX_GOTTPOFF }
	if mnemIs(tok.Text, "tlsgd") { return x64.FIX_TLSGD }
	if mnemIs(tok.Text, "tlsld") { return x64.FIX_TLSLD }
	if mnemIs(tok.Text, "tlsdesc") { return x64.FIX_TLSDESC }
	return 0
}

// x64RipOperatorKind reports whether kind (x64OperatorKind) is an operator of `[rip + sym@...]`:
// GOTPCREL, GOTTPOFF, TLSGD, TLSLD, tlsdesc or TLVP.
func x64RipOperatorKind(kind int) bool {
	return kind == x64SpecGot || kind == x64SpecTlvp || kind == x64.FIX_GOTTPOFF ||
			kind == x64.FIX_TLSGD || kind == x64.FIX_TLSLD || kind == x64.FIX_TLSDESC
}

// parseX64OpTerm parses the operator term at tok (x64OpTermStart; l just after it), returning
// its symbol, its operator's kind (x64OperatorKind) and the addend of an alias it names.
func parseX64OpTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, int, int64) {
	var none @[]char
	var r ExprResult
	l, tok, r = parseTerminal(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid operand before '@'"))
		return l, tok, none, 0, 0
	}
	l, tok = LexNext(l) // '@'
	var kind int = x64OperatorKind(tok)
	if kind == 0 {
		setErr(p,
				"expected TPOFF, DTPOFF, tlscall, GOTPCREL, GOTTPOFF, TLSGD, TLSLD, tlsdesc or TLVP after "
						"'@' in a memory operand")
		return l, tok, none, 0, 0
	}
	if r.Pending || !isSymbolic(r) || r.Dot || hasNeg(r) {
		if kind == x64SpecGot {
			setErr(p, "@GOTPCREL takes a symbol")
		} else {
			setErr(p, "a thread-local operator takes a symbol")
		}
		return l, tok, none, 0, 0
	}
	// (clang takes none of the operators on a numeric local label reference.)
	if asm.IsGeneratedLabel(r.Sym) {
		setErr(p, "a numeric local label reference takes no '@' operator")
		return l, tok, none, 0, 0
	}
	l, tok = LexNext(l)
	return l, tok, r.Sym, kind, r.Val
}

// x64TlsCallError sets the error for a `sym@tlscall` term where it marks no call through a TLS
// descriptor.
func x64TlsCallError(p @Parser) {
	setErr(p,
			"@tlscall marks only the call through a TLS descriptor: call qword ptr [rax + "
					"sym@tlscall]")
}

// x64TlsCallOk reports whether operand op of an instruction other than CALL is not a
// `[... sym@tlscall]` one, else sets the error.
func x64TlsCallOk(p @Parser, op x64.Operand) bool {
	if op.Kind != x64.OP_MEM || op.Fix != x64.FIX_TLSCALL { return true }
	x64TlsCallError(p)
	return false
}

// parseX64TlsDatum finishes a 4- or 8-byte datum (size bytes) whose value r, a symbol plus a
// number, is followed by '@' at tok (l just after it): `sym@TPOFF` or `sym@DTPOFF` and an
// optional addend after it (added to any before it), emitted as the relocated datum.
func parseX64TlsDatum(p @Parser, l Lexer, tok Token, r ExprResult, size int) (Lexer, Token) {
	if r.Pending || !isSymbolic(r) || r.Dot || hasNeg(r) || asm.IsGeneratedLabel(r.Sym) {
		setErr(p, "a thread-local operator takes a symbol")
		return l, tok
	}
	l, tok = LexNext(l)
	var dtp bool = tok.Kind == TOK_IDENT && mnemIs(tok.Text, "dtpoff")
	if tok.Kind != TOK_IDENT || (!dtp && !mnemIs(tok.Text, "tpoff")) {
		setErr(p, "a datum takes the thread-local offsets @TPOFF and @DTPOFF")
		return l, tok
	}
	if size != 4 && size != 8 {
		setErr(p, "a thread-local offset datum is 4 or 8 bytes")
		return l, tok
	}
	var kind int = x64.FIX_TPOFF32
	if dtp { kind = x64.FIX_DTPOFF32 }
	if size == 8 && dtp { kind = x64.FIX_DTPOFF64 }
	if size == 8 && !dtp { kind = x64.FIX_TPOFF64 }
	l, tok = LexNext(l)
	var addend int64 = 0
	var ok bool = false
	l, tok, addend, ok = parseX64TlsAddend(p, l, tok)
	if !ok { return l, tok }
	p.Asm.AddFixup(r.Sym, kind, r.Val + addend, size)
	p.Asm.Zero(cast(int64, size))
	return l, tok
}

// parseX64TlsAddend parses the addend after a thread-local operator at tok (l just after it):
// none (0), or + or - and a number — a `-` read as a unary one (`x@TPOFF - 8 - 4` is x - 12), a
// `+` skipped (Intel operands take no unary `+`): the same value as clang's binary sign but beside
// | ^ & << >> outside parentheses, whose precedence against + and - Mach-O and ELF differ on, an
// error as for an expression with no operator.  The number is one defined before this line, as
// everywhere else a number is read.  ok is false with the error set.
func parseX64TlsAddend(p @Parser, l Lexer, tok Token) (Lexer, Token, int64, bool) {
	if tok.Kind != TOK_PLUS && tok.Kind != TOK_MINUS { return l, tok, 0, true }
	if tok.Kind == TOK_PLUS { l, tok = LexNext(l) }
	var v ExprResult
	var groups int = 0
	var first Token = tok
	if tok.Kind == TOK_MINUS { _, first = LexNext(l) }
	l, tok, v, groups = parseBinary(p, l, tok, 1, 0)
	if v.Ok && (ambiguousMix(groups) || (groups & (EG_BIT | EG_SHIFT)) != 0) {
		v = exprFail("ambiguous operator precedence (Mach-O and ELF differ); add parentheses")
	}
	if v.Ok && !v.Pending && (isSymbolic(v) || hasNeg(v)) { v = numberContextError(p, first, v) }
	if !v.Ok {
		setErr(p, exprErr(v, "invalid addend after the thread-local offset"))
		return l, tok, 0, false
	}
	return l, tok, v.Val, true
}
