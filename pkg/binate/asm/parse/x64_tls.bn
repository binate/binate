package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The x86-64 thread-local operators, as clang takes them on ELF (Mach-O's writer rejects them):
// `sym@TPOFF` / `sym@DTPOFF`, the symbol's offset from the thread pointer / in its module's
// block, as a term of a memory operand that is not RIP-relative (`[rax + x@TPOFF + 8]`,
// `fs:[x@TPOFF]`, `fs:x@TPOFF`) — added, one per operand, the numbers beside it its addend
// (x64.MemSym) — or as a 4- or 8-byte datum (`.uint64 x@DTPOFF + 8`); `[rip + sym@GOTTPOFF]`,
// `@TLSGD`, `@TLSLD` and `@tlsdesc` (x64.RipTls), beside `@GOTPCREL` (x64.RipGotLabel) and
// Mach-O's `@TLVP` (x64.RipTlvp, only on `mov` into a 64-bit register), with no addend; and
// `call qword ptr [rax + sym@tlscall]`, the call through the descriptor (a MemSym of
// kind x64.FIX_TLSCALL, which only x64.CallMem takes).  The operators' names are
// case-insensitive.  clang also takes the RIP-relative ones on other operands and in data, the
// offsets in `[rip + ...]` and in 1- or 2-byte data (relocated as 4), an addend after a slot,
// `@tlscall` on any instruction and operand, relocating nonsense, and adds a subtracted symbol
// and drops an operator after the term (`x@TPOFF*2`) or a difference after a datum's (`x@TPOFF -
// .`): each is an error here.

// x64SpecGot and x64SpecTlvp mark a `[rip + sym@GOTPCREL]` and a `[rip + sym@TLVP]` operand
// (parseX64RipSpec).
const (
	x64SpecGot int = -1
	x64SpecTlvp int = -2
)

// x64TlsTermStart reports whether tok (l just after it) begins a thread-local term: a name, then
// '@'.
func x64TlsTermStart(l Lexer, tok Token) bool {
	if tok.Kind != TOK_IDENT { return false }
	var at Token
	l, at = LexNext(l)
	return at.Kind == TOK_AT
}

// parseX64TlsTerm parses the thread-local term at tok (x64TlsTermStart; l just after it),
// returning its symbol, its fixup kind (x64.FIX_TPOFF32, x64.FIX_DTPOFF32, x64.FIX_TLSCALL) and
// the addend of an alias it names.
func parseX64TlsTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, int, int64) {
	var none @[]char
	var r ExprResult
	l, tok, r = parseTerminal(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid thread-local term"))
		return l, tok, none, 0, 0
	}
	if r.Pending || !isSymbolic(r) || r.Dot || hasNeg(r) || asm.IsGeneratedLabel(r.Sym) {
		setErr(p, "a thread-local operator takes a symbol")
		return l, tok, none, 0, 0
	}
	l, tok = LexNext(l) // '@'
	var kind int = 0
	if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "tpoff") { kind = x64.FIX_TPOFF32 }
	if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "dtpoff") { kind = x64.FIX_DTPOFF32 }
	if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "tlscall") { kind = x64.FIX_TLSCALL }
	if kind == 0 {
		if tok.Kind == TOK_IDENT && x64RipOperator(tok.Text) {
			setErr(p,
					"@GOTPCREL, @GOTTPOFF, @TLSGD, @TLSLD, @tlsdesc and @TLVP are RIP-relative: [rip + "
							"sym@GOTTPOFF]")
		} else {
			setErr(p,
					"expected TPOFF, DTPOFF or tlscall after '@' (a memory operand's thread-local "
							"term)")
		}
		return l, tok, none, 0, 0
	}
	l, tok = LexNext(l)
	return l, tok, r.Sym, kind, r.Val
}

// x64TlsTermError sets the error for a thread-local term subtracted (neg) or beside another
// (parseX64MemTerms).
func x64TlsTermError(p @Parser, neg bool) x64.Operand {
	if neg {
		setErr(p, "a thread-local symbol cannot be subtracted")
	} else {
		setErr(p, "a memory operand takes one thread-local term")
	}
	return x64.Imm(0)
}

// x64TlsCallError sets the error for a `sym@tlscall` term where it marks no call through a TLS
// descriptor.
func x64TlsCallError(p @Parser) {
	setErr(p,
			"@tlscall marks only the call through a TLS descriptor: call qword ptr [rax + "
					"sym@tlscall]")
}

// x64TlsCallOk reports whether operand op of an instruction other than CALL is not a
// `[... sym@tlscall]` one, else sets the error.
func x64TlsCallOk(p @Parser, op x64.Operand) bool {
	if op.Kind != x64.OP_MEM || op.Fix != x64.FIX_TLSCALL { return true }
	x64TlsCallError(p)
	return false
}

// parseX64TlsDatum finishes a 4- or 8-byte datum (size bytes) whose value r, a symbol plus a
// number, is followed by '@' at tok (l just after it): `sym@TPOFF` or `sym@DTPOFF` and an
// optional addend after it (added to any before it), emitted as the relocated datum.
func parseX64TlsDatum(p @Parser, l Lexer, tok Token, r ExprResult, size int) (Lexer, Token) {
	if r.Pending || !isSymbolic(r) || r.Dot || hasNeg(r) || asm.IsGeneratedLabel(r.Sym) {
		setErr(p, "a thread-local operator takes a symbol")
		return l, tok
	}
	l, tok = LexNext(l)
	var dtp bool = tok.Kind == TOK_IDENT && mnemIs(tok.Text, "dtpoff")
	if tok.Kind != TOK_IDENT || (!dtp && !mnemIs(tok.Text, "tpoff")) {
		setErr(p, "a datum takes the thread-local offsets @TPOFF and @DTPOFF")
		return l, tok
	}
	if size != 4 && size != 8 {
		setErr(p, "a thread-local offset datum is 4 or 8 bytes")
		return l, tok
	}
	var kind int = x64.FIX_TPOFF32
	if dtp { kind = x64.FIX_DTPOFF32 }
	if size == 8 && dtp { kind = x64.FIX_DTPOFF64 }
	if size == 8 && !dtp { kind = x64.FIX_TPOFF64 }
	l, tok = LexNext(l)
	var addend int64 = 0
	var ok bool = false
	l, tok, addend, ok = parseX64TlsAddend(p, l, tok)
	if !ok { return l, tok }
	p.Asm.AddFixup(r.Sym, kind, r.Val + addend, size)
	p.Asm.Zero(cast(int64, size))
	return l, tok
}

// parseX64TlsAddend parses the addend after a thread-local operator at tok (l just after it):
// none (0), or + or - and a number — a `-` read as a unary one (`x@TPOFF - 8 - 4` is x - 12), a
// `+` skipped (Intel operands take no unary `+`): the same value as clang's binary sign but beside
// | ^ & << >> outside parentheses, whose precedence against + and - Mach-O and ELF differ on, an
// error as for an expression with no operator.  The number is one defined before this line, as
// everywhere else a number is read.  ok is false with the error set.
func parseX64TlsAddend(p @Parser, l Lexer, tok Token) (Lexer, Token, int64, bool) {
	if tok.Kind != TOK_PLUS && tok.Kind != TOK_MINUS { return l, tok, 0, true }
	if tok.Kind == TOK_PLUS { l, tok = LexNext(l) }
	var v ExprResult
	var groups int = 0
	var first Token = tok
	if tok.Kind == TOK_MINUS { _, first = LexNext(l) }
	l, tok, v, groups = parseBinary(p, l, tok, 1, 0)
	if v.Ok && (ambiguousMix(groups) || (groups & (EG_BIT | EG_SHIFT)) != 0) {
		v = exprFail("ambiguous operator precedence (Mach-O and ELF differ); add parentheses")
	}
	if v.Ok && !v.Pending && (isSymbolic(v) || hasNeg(v)) { v = numberContextError(p, first, v) }
	if !v.Ok {
		setErr(p, exprErr(v, "invalid addend after the thread-local offset"))
		return l, tok, 0, false
	}
	return l, tok, v.Val, true
}

// x64RipOperator reports whether name is an operator of `[rip + sym@...]`: GOTPCREL, GOTTPOFF,
// TLSGD, TLSLD, tlsdesc or TLVP.
func x64RipOperator(name *[]readonly char) bool {
	return mnemIs(name, "gotpcrel") || mnemIs(name, "gottpoff") || mnemIs(name, "tlsgd") ||
			mnemIs(name, "tlsld") || mnemIs(name, "tlsdesc") || mnemIs(name, "tlvp")
}

// parseX64RipSpec parses the operator after the symbol of a `[rip + sym` operand and its '@' (l
// just after it; rr the symbol and its addend), returning x64SpecGot for `@GOTPCREL`,
// x64SpecTlvp for `@TLVP`, or the fixup kind of a thread-local `@GOTTPOFF`, `@TLSGD`, `@TLSLD` or
// `@tlsdesc`; each takes no addend, before or after it.
func parseX64RipSpec(p @Parser, l Lexer, rr ExprResult) (Lexer, Token, int) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || !x64RipOperator(tok.Text) {
		if tok.Kind == TOK_IDENT && (mnemIs(tok.Text, "tpoff") || mnemIs(tok.Text, "dtpoff")) {
			setErr(p, "@TPOFF and @DTPOFF are offsets, not RIP-relative: [base + sym@TPOFF]")
		} else if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "tlscall") {
			x64TlsCallError(p)
		} else {
			setErr(p, "expected GOTPCREL, GOTTPOFF, TLSGD, TLSLD, tlsdesc or TLVP after '@'")
		}
		return l, tok, 0
	}
	var spec int = x64SpecGot
	if mnemIs(tok.Text, "gottpoff") { spec = x64.FIX_GOTTPOFF }
	if mnemIs(tok.Text, "tlsgd") { spec = x64.FIX_TLSGD }
	if mnemIs(tok.Text, "tlsld") { spec = x64.FIX_TLSLD }
	if mnemIs(tok.Text, "tlsdesc") { spec = x64.FIX_TLSDESC }
	if mnemIs(tok.Text, "tlvp") { spec = x64SpecTlvp }
	// (clang takes none of them on a numeric local label reference.)
	if asm.IsGeneratedLabel(rr.Sym) {
		setErr(p, "a numeric local label reference takes no '@' operator")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	// A GOT slot, a thread-local slot or a descriptor plus an addend is nothing: clang emits the
	// non-relaxable GOTPCREL with one, drops it after @GOTTPOFF on a mov and keeps it after
	// @TLSGD; Mach-O has no form for one.
	if rr.Val != 0 || tok.Kind == TOK_PLUS || tok.Kind == TOK_MINUS {
		if spec == x64SpecGot {
			setErr(p, "a GOT-indirect operand takes no addend")
		} else if spec == x64SpecTlvp {
			setErr(p, "a thread-local variable reference (@TLVP) takes no addend")
		} else {
			setErr(p, "a thread-local slot or descriptor reference takes no addend")
		}
		return l, tok, 0
	}
	return l, tok, spec
}
