package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The x86-64 thread-local operators of a memory operand (x64_tls.bn) against clang's bytes and
// relocations (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`, llvm-objdump -dr):
// the relocated field a zero placeholder, its fixup's addend the relocation's less the -4 of a
// PC-relative one (which the ELF writer applies).  (x64LineRejected is in x64_target_test.bn,
// x64LineFails in x64_seg_test.bn.)

// x64TlsCase checks that the lines of src (one per '\n') assemble to exactly the bytes hex
// (pairs of hex digits, spaces ignored) with exactly one fixup, of kind kind against x at byte
// off with addend addend.
func x64TlsCase(e @[]char, src *[]readonly char, hex *[]readonly char, kind int, off int,
		addend int64) @[]char {
	p, a := newX64Parser()
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish() // (an alias's fixup is retargeted to its symbol here)
	if p.HasError || a.HasError { return goldenFail(e, src, "rejected") }
	var s @asm.Section = a.Sections[0]
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		if !isHexDigit(hex[i]) { continue }
		if hi < 0 {
			hi = hexVal(hex[i])
			continue
		}
		if n >= asm.HeldLen(s) || cast(int, s.Data[n]) != hi * 16 + hexVal(hex[i]) {
			return goldenFail(e, src, "wrong bytes")
		}
		n++
		hi = -1
	}
	if n != asm.HeldLen(s) { return goldenFail(e, src, "wrong length") }
	if s.NumFixups != 1 { return goldenFail(e, src, "not exactly one fixup") }
	var fix asm.Fixup = s.Fixups[0]
	if fix.Kind != kind || cast(int, fix.Offset) != off || fix.Addend != addend ||
			!charsEqual(fix.Label, "x") {
		return goldenFail(e, src, "wrong fixup")
	}
	return e
}

// `@TPOFF` / `@DTPOFF` is a term of an operand that is not RIP-relative — after a segment
// override or not, bracketed or bare, with a base, an index or neither, in any order — its
// displacement always 32 bits, the numbers beside it the addend, the operator in any case.
func TestX64TlsOffsets() testing.TestResult {
	var e @[]char = ""
	var tp int = x64.FIX_TPOFF32
	var dtp int = x64.FIX_DTPOFF32
	e = x64TlsCase(e, "mov eax, dword ptr fs:[x@TPOFF]", "64 8b 04 25 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "mov eax, dword ptr fs:x@TPOFF", "64 8b 04 25 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "mov eax, dword ptr fs:x@TPOFF + 4", "64 8b 04 25 00 00 00 00", tp, 4, 4)
	e = x64TlsCase(e, "mov eax, dword ptr [rax + x@TPOFF + 8]", "8b 80 00 00 00 00", tp, 2, 8)
	e = x64TlsCase(e, "mov eax, dword ptr [rax + 8 + x@TPOFF]", "8b 80 00 00 00 00", tp, 2, 8)
	e = x64TlsCase(e, "mov eax, dword ptr [rax + x@TPOFF - 8]", "8b 80 00 00 00 00", tp, 2, -8)
	e = x64TlsCase(e, "mov eax, dword ptr [rax + x@tpoff]", "8b 80 00 00 00 00", tp, 2, 0)
	e = x64TlsCase(e, "mov eax, dword ptr [rax + x@TPOFF + rbx]", "8b 84 18 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "mov eax, dword ptr [x@TPOFF + rax]", "8b 80 00 00 00 00", tp, 2, 0)
	e = x64TlsCase(e, "lea rax, [rbx + rcx*8 + x@DTPOFF]", "48 8d 84 cb 00 00 00 00", dtp, 4, 0)
	e = x64TlsCase(e, "mov eax, dword ptr fs:[x@dtpoff]", "64 8b 04 25 00 00 00 00", dtp, 4, 0)
	e = x64TlsCase(e, "mov eax, dword ptr [rcx*4 + x@TPOFF]", "8b 04 8d 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "mov eax, dword ptr [rsp + x@TPOFF]", "8b 84 24 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "add dword ptr fs:[x@TPOFF], 5", "64 83 04 25 00 00 00 00 05", tp, 4, 0)
	e = x64TlsCase(e, "inc dword ptr gs:[rax + x@TPOFF]", "65 ff 80 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "mov dword ptr fs:x@TPOFF, eax", "64 89 04 25 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "E = x\nmov eax, dword ptr [rax + E@TPOFF]", "8b 80 00 00 00 00", tp, 2, 0)
	return e
}

// `[rip + x@GOTTPOFF]`, `@TLSGD`, `@TLSLD` and `@tlsdesc` in any case are RIP-relative, in any
// instruction taking memory, an immediate after the field taken off the addend.
func TestX64TlsRipOperators() testing.TestResult {
	var e @[]char = ""
	var ie int = x64.FIX_GOTTPOFF
	e = x64TlsCase(e, "mov rax, qword ptr [rip + x@GOTTPOFF]", "48 8b 05 00 00 00 00", ie, 3, 0)
	e = x64TlsCase(e, "add rax, qword ptr [rip + x@gottpoff]", "48 03 05 00 00 00 00", ie, 3, 0)
	e = x64TlsCase(e, "mov r11, qword ptr [rip + x@GOTTPOFF]", "4c 8b 1d 00 00 00 00", ie, 3, 0)
	e = x64TlsCase(e, "cmp qword ptr [rip + x@GOTTPOFF], 5", "48 83 3d 00 00 00 00 05", ie, 3, -1)
	e = x64TlsCase(e, "lea rdi, [rip + x@TLSGD]", "48 8d 3d 00 00 00 00", x64.FIX_TLSGD, 3, 0)
	e = x64TlsCase(e, "lea rdi, [rip + x@tlsld]", "48 8d 3d 00 00 00 00", x64.FIX_TLSLD, 3, 0)
	e = x64TlsCase(e, "lea rax, [rip + x@tlsdesc]", "48 8d 05 00 00 00 00", x64.FIX_TLSDESC, 3, 0)
	e = x64TlsCase(e, "lea rax, [rip + x@TLSDESC]", "48 8d 05 00 00 00 00", x64.FIX_TLSDESC, 3, 0)
	e = x64TlsCase(e, "data16 lea rdi, [rip + x@TLSGD]", "66 48 8d 3d 00 00 00 00", x64.FIX_TLSGD, 4,
			0)
	e = x64TlsCase(e, "E = x\nlea rdi, [rip + E@TLSGD]", "48 8d 3d 00 00 00 00", x64.FIX_TLSGD, 3, 0)
	return e
}

// A thread-local operator clang relocates as nonsense, or misreads, is an error: a slot or
// descriptor operator off `[rip + ...]` or with an addend, an offset in `[rip + ...]`, a
// subtracted symbol, a second symbol, an operator after the term, `.`, a number, a numeric local
// label, an operator the position has none of, an addend past 32 bits.
func TestX64TlsRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov eax, dword ptr [rbx + x@TLSGD]")
	e = x64LineRejected(e, "mov rax, qword ptr fs:[x@GOTTPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [x@TLSLD]")
	e = x64LineRejected(e, "lea rax, [rbx + x@tlsdesc]")
	e = x64LineRejected(e, "mov eax, dword ptr [rip + x@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rip + x@DTPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax - x@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [-x@TPOFF]")
	e = x64LineRejected(e, "mov rax, qword ptr [rip - x@GOTTPOFF]")
	e = x64LineRejected(e, "mov rax, qword ptr [rip + x@GOTTPOFF + 4]")
	e = x64LineRejected(e, "mov rax, qword ptr [rip + x + 4@GOTTPOFF]")
	e = x64LineRejected(e, "lea rdi, [rip + x@TLSGD + 1]")
	e = x64LineRejected(e, "lea rdi, [rip + 1b@TLSGD]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@TPOFF*2]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@TPOFF + y@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@TPOFF + y]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + .@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + N@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@BOGUS]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@PLT]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@GOTPCREL]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@tlscall]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@TPOFF@TPOFF]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@TPOFF + 0x80000000]")
	e = x64LineRejected(e, "mov eax, dword ptr [rax + x@]")
	return e
}
