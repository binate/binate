package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64/virt"

// The x86-64 virtualization and trusted-execution instructions (pkg/binate/asm/x64/virt), as clang
// takes them: without operands (x64VirtZero; vmrun / vmload / vmsave / psmash with `rax` and
// skinit with `eax` written too, x64ImplicitRegs); vmxon / vmclear / vmptrld / vmptrst with their
// memory; vmread / vmwrite / invept / invvpid with two.  The encoders check the operands.

// x64VirtZero reports whether mnem names one without operands, emitting it when emit is set.
func x64VirtZero(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	var k int = x64WordIndex(mnem,
			" vmcall vmlaunch vmresume vmxoff vmfunc vmrun vmmcall vmload vmsave stgi clgi skinit encls "
					"enclu enclv tdcall seamret seamops seamcall pvalidate rmpadjust rmpupdate psmash rmpquery "
					"getsec ")
	if k < 0 { return false }
	if !emit { return true }
	switch k {
	case 0:  virt.Vmcall(a)
	case 1:  virt.Vmlaunch(a)
	case 2:  virt.Vmresume(a)
	case 3:  virt.Vmxoff(a)
	case 4:  virt.Vmfunc(a)
	case 5:  virt.Vmrun(a)
	case 6:  virt.Vmmcall(a)
	case 7:  virt.Vmload(a)
	case 8:  virt.Vmsave(a)
	case 9:  virt.Stgi(a)
	case 10: virt.Clgi(a)
	case 11: virt.Skinit(a)
	case 12: virt.Encls(a)
	case 13: virt.Enclu(a)
	case 14: virt.Enclv(a)
	case 15: virt.Tdcall(a)
	case 16: virt.Seamret(a)
	case 17: virt.Seamops(a)
	case 18: virt.Seamcall(a)
	case 19: virt.Pvalidate(a)
	case 20: virt.Rmpadjust(a)
	case 21: virt.Rmpupdate(a)
	case 22: virt.Psmash(a)
	case 23: virt.Rmpquery(a)
	default: virt.Getsec(a)
	}
	return true
}

// x64VirtInstruction parses and emits the virtualization instruction mnem (l just after it) when
// it names one with operands, and reports whether it did.
func x64VirtInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var one int = x64WordIndex(mnem, " vmxon vmclear vmptrld vmptrst ")
	var two int = x64WordIndex(mnem, " vmread vmwrite invept invvpid ")
	if one < 0 && two < 0 { return false }
	var n int = 1
	if two >= 0 { n = 2 }
	first, second, _, ok := parseX64SysOperands(p, l, n)
	if !ok { return true }
	var a @asm.Assembler = p.Asm
	switch one {
	case 0: virt.Vmxon(a, first)
	case 1: virt.Vmclear(a, first)
	case 2: virt.Vmptrld(a, first)
	case 3: virt.Vmptrst(a, first)
	}
	switch two {
	case 0: virt.Vmread(a, first, second)
	case 1: virt.Vmwrite(a, first, second)
	case 2: virt.Invept(a, first, second)
	case 3: virt.Invvpid(a, first, second)
	}
	return true
}
