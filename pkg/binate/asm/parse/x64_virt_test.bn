package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The virtualization and trusted-execution instructions (x64_virt.bn) against clang's bytes and
// relocations (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`); the encodings in
// full are package virt's tests, these the parsing.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64TlsCase in x64_tls_test.bn.)

// Without operands, in upper case too, the implicit registers of vmrun, vmload, vmsave, skinit and
// psmash written or not.
func TestX64VirtNoOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmcall", "0f 01 c1")
	e = x64SrcHex(e, "VMLAUNCH", "0f 01 c2")
	e = x64SrcHex(e, "vmresume", "0f 01 c3")
	e = x64SrcHex(e, "vmxoff", "0f 01 c4")
	e = x64SrcHex(e, "vmfunc", "0f 01 d4")
	e = x64SrcHex(e, "vmrun", "0f 01 d8")
	e = x64SrcHex(e, "vmrun rax", "0f 01 d8")
	e = x64SrcHex(e, "vmmcall", "0f 01 d9")
	e = x64SrcHex(e, "vmload rax", "0f 01 da")
	e = x64SrcHex(e, "vmsave", "0f 01 db")
	e = x64SrcHex(e, "stgi", "0f 01 dc")
	e = x64SrcHex(e, "clgi", "0f 01 dd")
	e = x64SrcHex(e, "skinit", "0f 01 de")
	e = x64SrcHex(e, "skinit eax", "0f 01 de")
	e = x64SrcHex(e, "encls", "0f 01 cf")
	e = x64SrcHex(e, "enclu", "0f 01 d7")
	e = x64SrcHex(e, "enclv", "0f 01 c0")
	e = x64SrcHex(e, "tdcall", "66 0f 01 cc")
	e = x64SrcHex(e, "seamret", "66 0f 01 cd")
	e = x64SrcHex(e, "seamops", "66 0f 01 ce")
	e = x64SrcHex(e, "seamcall", "66 0f 01 cf")
	e = x64SrcHex(e, "pvalidate", "f2 0f 01 ff")
	e = x64SrcHex(e, "rmpadjust", "f3 0f 01 fe")
	e = x64SrcHex(e, "rmpupdate", "f2 0f 01 fe")
	e = x64SrcHex(e, "psmash rax", "f3 0f 01 ff")
	e = x64SrcHex(e, "rmpquery", "f3 0f 01 fd")
	e = x64SrcHex(e, "getsec", "0f 37")
	return e
}

// The VMCS and invalidation instructions: memory of the written size and of none, R8..R15, a
// RIP-relative operand.
func TestX64VirtOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmxon qword ptr [rax]", "f3 0f c7 30")
	e = x64SrcHex(e, "vmxon [r9 + 8]", "f3 41 0f c7 71 08")
	e = x64SrcHex(e, "vmclear [rax]", "66 0f c7 30")
	e = x64SrcHex(e, "vmptrld qword ptr [rbx]", "0f c7 33")
	e = x64SrcHex(e, "vmptrst [r10]", "41 0f c7 3a")
	e = x64SrcHex(e, "vmread rax, rbx", "0f 78 d8")
	e = x64SrcHex(e, "vmread qword ptr [rax], rbx", "0f 78 18")
	e = x64SrcHex(e, "vmread r9, r10", "45 0f 78 d1")
	e = x64SrcHex(e, "vmwrite rax, rbx", "0f 79 c3")
	e = x64SrcHex(e, "vmwrite r9, [r10]", "45 0f 79 0a")
	e = x64SrcHex(e, "invept rax, xmmword ptr [rbx]", "66 0f 38 80 03")
	e = x64SrcHex(e, "invept r9, [r10]", "66 45 0f 38 80 0a")
	e = x64SrcHex(e, "invvpid r9, xmmword ptr [r10]", "66 45 0f 38 81 0a")
	e = x64TlsCase(e, "vmptrld [rip + x]", "0f c7 35 00 00 00 00", x64.FIX_REL32_LEA, 3, 0)
	return e
}

// What clang rejects: operands of the wrong kind or size, 32-bit implicit registers (clang:
// "instruction requires: Not 64-bit mode") and others' implicit registers, the wrong number of
// operands; and what bnas rejects as GNU as does: a lock, repeat prefix or lock-elision hint.
func TestX64VirtRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "vmrun eax")
	e = x64LineRejected(e, "vmload eax")
	e = x64LineRejected(e, "skinit rax")
	e = x64LineRejected(e, "psmash eax")
	e = x64LineRejected(e, "pvalidate rax, ecx, edx")
	e = x64LineRejected(e, "vmcall rax")
	e = x64LineRejected(e, "vmxon rax")
	e = x64LineRejected(e, "vmxon dword ptr [rax]")
	e = x64LineRejected(e, "vmclear")
	e = x64LineRejected(e, "vmread eax, ebx")
	e = x64LineRejected(e, "vmread rax, [rbx]")
	e = x64LineRejected(e, "vmwrite [rax], rbx")
	e = x64LineRejected(e, "vmwrite rax")
	e = x64LineRejected(e, "invept eax, [rbx]")
	e = x64LineRejected(e, "invept rax, qword ptr [rbx]")
	e = x64LineRejected(e, "invvpid rax, rbx")
	e = x64LineRejected(e, "lock vmcall")
	e = x64LineRejected(e, "rep vmrun")
	e = x64LineRejected(e, "xrelease vmxon [rax]")
	e = x64LineRejected(e, "getsec eax")
	e = x64LineRejected(e, "rep getsec")
	e = x64LineErrorHas(e, "vmrun eax", "vmrun takes no operands, or rax")
	e = x64LineErrorHas(e, "invlpga rax, edx", "invlpga takes no operands, or rax, ecx")
	return e
}
