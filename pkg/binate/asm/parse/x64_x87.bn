package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/x87"
import "pkg/binate/buf"

// The x87 instructions (pkg/binate/asm/x64/x87), as clang takes them in Intel syntax: those
// without operands (x64X87Zero); with a stack register, `st` or `st(i)` (i an integer 0..7:
// parseX64StReg), or memory whose size chooses the form (unsized, ambiguous where there are
// several); the operand clang implies where none is written — st(1) for fxch, fcom, fcomp, fucom,
// fucomp, the fcomi family and the popping arithmetic, `faddp st(1), st` and the like for a bare
// fadd, fsub, fmul or fdiv, ax for fnstsw / fstsw.  The popping arithmetic takes st(i), st, and
// faddp / fmulp st, st(i) too; fsubp st, st(i) (and fsubrp, fdivp, fdivrp) is an error, as GNU as
// has it (clang encodes it as fsubp st(i), st, the other operation).  A waiting form's FWAIT goes
// before its instruction's prefixes, a segment override and {rex} (x64X87Wait), as clang and GNU
// as place them, and before the prefixes written as instructions before it (x64PrefixInstruction),
// as GNU as places them (clang emits those first).  No AT&T-suffixed name (flds, faddl, ...) is
// one, as to clang.  The encoders check the operands.

// x64X87Zero reports whether mnem names an x87 instruction without operands, emitting it when emit
// is set.
func x64X87Zero(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	var k int = x64WordIndex(mnem,
			" f2xm1 fabs fchs fcos fpatan fprem fprem1 fptan frndint fscale fsin fsincos fsqrt "
					"fxtract fyl2x fyl2xp1 fnop fld1 fldl2t fldl2e fldpi fldlg2 fldln2 fldz fdecstp fincstp "
					"fnclex fninit fclex finit fwait wait fcompp fucompp ftst fxam ")
	if k < 0 { return false }
	if !emit { return true }
	switch k {
	case 0:      x87.F2xm1(a)
	case 1:      x87.Fabs(a)
	case 2:      x87.Fchs(a)
	case 3:      x87.Fcos(a)
	case 4:      x87.Fpatan(a)
	case 5:      x87.Fprem(a)
	case 6:      x87.Fprem1(a)
	case 7:      x87.Fptan(a)
	case 8:      x87.Frndint(a)
	case 9:      x87.Fscale(a)
	case 10:     x87.Fsin(a)
	case 11:     x87.Fsincos(a)
	case 12:     x87.Fsqrt(a)
	case 13:     x87.Fxtract(a)
	case 14:     x87.Fyl2x(a)
	case 15:     x87.Fyl2xp1(a)
	case 16:     x87.Fnop(a)
	case 17:     x87.Fld1(a)
	case 18:     x87.Fldl2t(a)
	case 19:     x87.Fldl2e(a)
	case 20:     x87.Fldpi(a)
	case 21:     x87.Fldlg2(a)
	case 22:     x87.Fldln2(a)
	case 23:     x87.Fldz(a)
	case 24:     x87.Fdecstp(a)
	case 25:     x87.Fincstp(a)
	case 26:     x87.Fnclex(a)
	case 27:     x87.Fninit(a)
	case 28:     x87.Fclex(a)
	case 29:     x87.Finit(a)
	case 30, 31: x87.Fwait(a)
	case 32:     x87.Fcompp(a)
	case 33:     x87.Fucompp(a)
	case 34:     x87.Ftst(a)
	default:     x87.Fxam(a)
	}
	return true
}

// parseX64StReg parses the rest of an x87 stack register after `st` (l just after it) — `(i)`, i
// an integer 0..7, or nothing, ST(0) — as clang reads them, and returns the token after it.
func parseX64StReg(p @Parser, l Lexer) (Lexer, Token, x64.Operand) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_LPAREN { return l, tok, x87.St(0) }
	var num Token
	l, num = LexNext(l)
	if num.Kind != TOK_INT {
		setErr(p, "expected stack index")
		return l, num, x64.Imm(0)
	}
	if num.Ival < 0 || num.Ival > 7 {
		setErr(p, "invalid stack index")
		return l, num, x64.Imm(0)
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_RPAREN {
		setErr(p, "expected ')'")
		return l, tok, x64.Imm(0)
	}
	l, tok = LexNext(l)
	return l, tok, x87.St(cast(int, num.Ival))
}

// x64X87Instruction parses and emits the x87 instruction mnem (l just after it) when it names one
// with operands (written or implied), and reports whether it did.
func x64X87Instruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var known *[]readonly char = " fld fst fstp fild fist fistp fisttp fbld fbstp fadd fmul fsub "
			"fsubr fdiv fdivr faddp fmulp fsubp fsubrp fdivp fdivrp fiadd fimul fisub fisubr fidiv "
			"fidivr ficom ficomp fcom fcomp fucom fucomp fxch fcomi fcomip fcompi fucomi fucomip "
			"fucompi ffree ffreep fcmovb fcmove fcmovbe fcmovu fcmovnb fcmovne fcmovnbe fcmovnu fldcw "
			"fnstcw fstcw fldenv fnstenv fstenv frstor fnsave fsave fnstsw fstsw "
	if x64WordIndex(mnem, known) < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	var first x64.Operand = x64.Imm(0)
	var second x64.Operand = x64.Imm(0)
	var n int = 0
	if tok.Kind != TOK_EOF {
		l, tok, first = parseX64Operand(p, l, tok)
		if p.HasError { return true }
		n = 1
		if tok.Kind == TOK_COMMA {
			l, tok, second = expectX64CommaOp(p, l, tok)
			if p.HasError { return true }
			n = 2
		}
	}
	if !x64AtEOL(p, tok) || !x64TlsCallOk(p, first) || !x64TlsCallOk(p, second) { return true }
	// (After a prefix written as an instruction, its FWAIT went before the prefix: Parser.X64Waited.)
	if x64WaitingForm(mnem) && !p.X64Waited { x64X87Wait(p.Asm) }
	x64EmitSeg(p)
	x64EmitX87(p, mnem, n, first, second)
	return true
}

// x64X87Wait emits the FWAIT of a waiting form with operands, ahead of the segment override and
// REX (`{rex}`, `rex64`: asm.Assembler.X64Rex, X64RexW, held back for it) of the no-wait
// instruction it is then, which x64EmitX87Control writes.
func x64X87Wait(a @asm.Assembler) {
	var rex bool = a.X64Rex
	var w bool = a.X64RexW
	a.X64Rex = false
	a.X64RexW = false
	x87.Fwait(a)
	a.X64Rex = rex
	a.X64RexW = w
}

// x64X87Count reports whether the x87 instruction mnem has n operands, one of the counts it takes
// (min..max), else sets the error.
func x64X87Count(p @Parser, mnem *[]readonly char, n int, min int, max int) bool {
	if n >= min && n <= max { return true }
	setErr(p, quotedName(mnem, " takes another number of operands"))
	return false
}

// x64X87Sized reports whether op, an operand of the x87 instruction mnem with several memory
// forms, is not memory of no size, else sets clang's error.
func x64X87Sized(p @Parser, mnem *[]readonly char, op x64.Operand) bool {
	if !x64Unsized(op) { return true }
	var msg @[]char = buf.Concat("ambiguous operand size for '", mnem)
	setErr(p, buf.Concat(msg, "' (write its size: word, dword, qword or tbyte ptr)"))
	return false
}

// x64EmitX87 emits the x87 instruction mnem (x64X87Instruction's list) with its n operands, first
// and second, filling in the operands clang implies where none are written.
func x64EmitX87(p @Parser, mnem *[]readonly char, n int, first x64.Operand, second x64.Operand) {
	var a @asm.Assembler = p.Asm
	var st1 x64.Operand = x87.St(1)
	var k int = x64WordIndex(mnem, " fld fst fstp fild fist fistp fisttp fbld fbstp ")
	if k >= 0 {
		if !x64X87Count(p, mnem, n, 1, 1) { return }
		if k < 7 && !x64X87Sized(p, mnem, first) { return }
		switch k {
		case 0:  x87.Fld(a, first)
		case 1:  x87.Fst(a, first)
		case 2:  x87.Fstp(a, first)
		case 3:  x87.Fild(a, first)
		case 4:  x87.Fist(a, first)
		case 5:  x87.Fistp(a, first)
		case 6:  x87.Fisttp(a, first)
		case 7:  x87.Fbld(a, first)
		default: x87.Fbstp(a, first)
		}
		return
	}
	k = x64WordIndex(mnem, " fadd fmul fsub fsubr fdiv fdivr ")
	if k >= 0 {
		// Bare, the popping form on st(1), st, as clang reads it.
		if n == 0 {
			x64EmitX87Pop(a, k, st1)
			return
		}
		if n == 1 {
			if !x64X87Sized(p, mnem, first) { return }
			second = first
			first = x87.St(0)
		} else if !x87.IsSt(first) || !x87.IsSt(second) {
			// (memory is the one operand: `fadd st, dword ptr [rax]` is clang's error)
			setErr(p, quotedName(mnem, " takes two stack registers, or one operand"))
			return
		}
		switch k {
		case 0:  x87.Fadd(a, first, second)
		case 1:  x87.Fmul(a, first, second)
		case 2:  x87.Fsub(a, first, second)
		case 3:  x87.Fsubr(a, first, second)
		case 4:  x87.Fdiv(a, first, second)
		default: x87.Fdivr(a, first, second)
		}
		return
	}
	k = x64WordIndex(mnem, " faddp fmulp fsubp fsubrp fdivp fdivrp ")
	if k >= 0 {
		var dst x64.Operand = st1
		if n >= 1 { dst = first }
		if n == 2 && !(x87.IsSt(second) && second.Reg == x87.ST0) {
			// st, st(i): the same operation only for the commutative add and mul.
			if k > 1 || !x87.IsSt(first) || first.Reg != x87.ST0 {
				setErr(p, quotedName(mnem, " takes its operands as st(i), st"))
				return
			}
			dst = second
		}
		x64EmitX87Pop(a, k, dst)
		return
	}
	k = x64WordIndex(mnem, " fiadd fimul fisub fisubr fidiv fidivr ficom ficomp ")
	if k >= 0 {
		if !x64X87Count(p, mnem, n, 1, 1) || !x64X87Sized(p, mnem, first) { return }
		switch k {
		case 0:  x87.Fiadd(a, first)
		case 1:  x87.Fimul(a, first)
		case 2:  x87.Fisub(a, first)
		case 3:  x87.Fisubr(a, first)
		case 4:  x87.Fidiv(a, first)
		case 5:  x87.Fidivr(a, first)
		case 6:  x87.Ficom(a, first)
		default: x87.Ficomp(a, first)
		}
		return
	}
	x64EmitX87Other(p, mnem, n, first, second)
}

// x64EmitX87Pop emits the popping arithmetic at position k of " faddp fmulp fsubp fsubrp fdivp
// fdivrp " with destination dst.
func x64EmitX87Pop(a @asm.Assembler, k int, dst x64.Operand) {
	switch k {
	case 0:  x87.Faddp(a, dst)
	case 1:  x87.Fmulp(a, dst)
	case 2:  x87.Fsubp(a, dst)
	case 3:  x87.Fsubrp(a, dst)
	case 4:  x87.Fdivp(a, dst)
	default: x87.Fdivrp(a, dst)
	}
}

// x64EmitX87Other emits the comparisons, the stack and control instructions of x64EmitX87's list.
func x64EmitX87Other(p @Parser, mnem *[]readonly char, n int, first x64.Operand,
		second x64.Operand) {
	var a @asm.Assembler = p.Asm
	var src x64.Operand = x87.St(1)
	if n >= 1 { src = first }
	var k int = x64WordIndex(mnem, " fcom fcomp fucom fucomp fxch ")
	if k >= 0 {
		if !x64X87Count(p, mnem, n, 0, 1) { return }
		if k < 2 && !x64X87Sized(p, mnem, src) { return }
		switch k {
		case 0:  x87.Fcom(a, src)
		case 1:  x87.Fcomp(a, src)
		case 2:  x87.Fucom(a, src)
		case 3:  x87.Fucomp(a, src)
		default: x87.Fxch(a, src)
		}
		return
	}
	k = x64WordIndex(mnem, " fcomi fcomip fcompi fucomi fucomip fucompi ")
	if k >= 0 {
		if n == 2 {
			// st, st(i)
			if !x87.IsSt(first) || first.Reg != x87.ST0 {
				setErr(p, quotedName(mnem, " takes its operands as st, st(i)"))
				return
			}
			src = second
		}
		switch k {
		case 0:    x87.Fcomi(a, src)
		case 1, 2: x87.Fcomip(a, src)
		case 3:    x87.Fucomi(a, src)
		default:   x87.Fucomip(a, src)
		}
		return
	}
	k = x64WordIndex(mnem, " fcmovb fcmove fcmovbe fcmovu fcmovnb fcmovne fcmovnbe fcmovnu ")
	if k >= 0 {
		if !x64X87Count(p, mnem, n, 2, 2) { return }
		if !x87.IsSt(first) || first.Reg != x87.ST0 {
			setErr(p, quotedName(mnem, " takes its operands as st, st(i)"))
			return
		}
		var cc int = x64.CC_B
		if k == 1 { cc = x64.CC_E }
		if k == 2 { cc = x64.CC_BE }
		if k == 3 { cc = x64.CC_P }
		if k == 4 { cc = x64.CC_AE }
		if k == 5 { cc = x64.CC_NE }
		if k == 6 { cc = x64.CC_A }
		if k == 7 { cc = x64.CC_NP }
		x87.Fcmov(a, cc, second)
		return
	}
	x64EmitX87Control(p, mnem, n, first)
}

// x64EmitX87Control emits ffree / ffreep and the control instructions of x64EmitX87's list.
func x64EmitX87Control(p @Parser, mnem *[]readonly char, n int, first x64.Operand) {
	var a @asm.Assembler = p.Asm
	// (fstsw, fstcw, fstenv and fsave are their no-wait forms here, after the FWAIT x64X87Wait
	// wrote.)
	if mnemIs(mnem, "fnstsw") || mnemIs(mnem, "fstsw") {
		if !x64X87Count(p, mnem, n, 0, 1) { return }
		var dst x64.Operand = x64.Reg(x64.RAX, x64.SZ16)
		if n == 1 { dst = first }
		x87.Fnstsw(a, dst)
		return
	}
	if !x64X87Count(p, mnem, n, 1, 1) { return }
	var k int = x64WordIndex(mnem,
			" ffree ffreep fldcw fnstcw fstcw fldenv fnstenv fstenv frstor fnsave fsave ")
	switch k {
	case 0:    x87.Ffree(a, first)
	case 1:    x87.Ffreep(a, first)
	case 2:    x87.Fldcw(a, first)
	case 3, 4: x87.Fnstcw(a, first)
	case 5:    x87.Fldenv(a, first)
	case 6, 7: x87.Fnstenv(a, first)
	case 8:    x87.Frstor(a, first)
	default:   x87.Fnsave(a, first)
	}
}
