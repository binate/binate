package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The x87 instructions (x64_x87.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`); the encodings in full are package
// x87's tests, these the parsing.  (x64SrcHex and x64LineRejected are in x64_target_test.bn,
// x64TlsCase in x64_tls_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// Without operands, in upper case too, the waiting forms, wait and fwait.
func TestX64X87NoOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "f2xm1", "d9 f0")
	e = x64SrcHex(e, "FABS", "d9 e1")
	e = x64SrcHex(e, "fsincos", "d9 fb")
	e = x64SrcHex(e, "fyl2xp1", "d9 f9")
	e = x64SrcHex(e, "fldpi", "d9 eb")
	e = x64SrcHex(e, "fldz", "d9 ee")
	e = x64SrcHex(e, "fnop", "d9 d0")
	e = x64SrcHex(e, "fdecstp", "d9 f6")
	e = x64SrcHex(e, "fnclex", "db e2")
	e = x64SrcHex(e, "fclex", "9b db e2")
	e = x64SrcHex(e, "fninit", "db e3")
	e = x64SrcHex(e, "finit", "9b db e3")
	e = x64SrcHex(e, "wait", "9b")
	e = x64SrcHex(e, "fwait", "9b")
	e = x64SrcHex(e, "fcompp", "de d9")
	e = x64SrcHex(e, "fucompp", "da e9")
	e = x64SrcHex(e, "ftst", "d9 e4")
	e = x64SrcHex(e, "fxam", "d9 e5")
	return e
}

// The operands clang implies where none are written: st(1), the popping form on st(1), st for a
// bare fadd .. fdiv, ax for fnstsw / fstsw.
func TestX64X87Implied() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fxch", "d9 c9")
	e = x64SrcHex(e, "fcom", "d8 d1")
	e = x64SrcHex(e, "fcomp", "d8 d9")
	e = x64SrcHex(e, "fucom", "dd e1")
	e = x64SrcHex(e, "fucomp", "dd e9")
	e = x64SrcHex(e, "fcomi", "db f1")
	e = x64SrcHex(e, "fcomip", "df f1")
	e = x64SrcHex(e, "fucomi", "db e9")
	e = x64SrcHex(e, "fucomip", "df e9")
	e = x64SrcHex(e, "faddp", "de c1")
	e = x64SrcHex(e, "fsubp", "de e9")
	e = x64SrcHex(e, "fsubrp", "de e1")
	e = x64SrcHex(e, "fmulp", "de c9")
	e = x64SrcHex(e, "fdivp", "de f9")
	e = x64SrcHex(e, "fdivrp", "de f1")
	e = x64SrcHex(e, "fadd", "de c1")
	e = x64SrcHex(e, "fsub", "de e9")
	e = x64SrcHex(e, "fmul", "de c9")
	e = x64SrcHex(e, "fdiv", "de f9")
	e = x64SrcHex(e, "fnstsw", "df e0")
	e = x64SrcHex(e, "fstsw", "9b df e0")
	return e
}

// The stack registers, each spelling: st, st(i), ST(i), st (i); the forms with them.
func TestX64X87Registers() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fld st(1)", "d9 c1")
	e = x64SrcHex(e, "fld st", "d9 c0")
	e = x64SrcHex(e, "fld ST(7)", "d9 c7")
	e = x64SrcHex(e, "fld st (1)", "d9 c1")
	e = x64SrcHex(e, "fst st(2)", "dd d2")
	e = x64SrcHex(e, "fstp st(3)", "dd db")
	e = x64SrcHex(e, "fxch st(1)", "d9 c9")
	e = x64SrcHex(e, "fucom st(2)", "dd e2")
	e = x64SrcHex(e, "fcom st(1)", "d8 d1")
	e = x64SrcHex(e, "fcomi st, st(1)", "db f1")
	e = x64SrcHex(e, "fcomi st(1)", "db f1")
	e = x64SrcHex(e, "fcompi st(1)", "df f1")
	e = x64SrcHex(e, "fucompi st(1)", "df e9")
	e = x64SrcHex(e, "fucomip st, st(3)", "df eb")
	e = x64SrcHex(e, "ffree st(1)", "dd c1")
	e = x64SrcHex(e, "ffreep st(1)", "df c1")
	e = x64SrcHex(e, "fcmovb st, st(1)", "da c1")
	e = x64SrcHex(e, "fcmove st, st(2)", "da ca")
	e = x64SrcHex(e, "fcmovbe st, st(3)", "da d3")
	e = x64SrcHex(e, "fcmovu st, st(4)", "da dc")
	e = x64SrcHex(e, "fcmovnb st, st(5)", "db c5")
	e = x64SrcHex(e, "fcmovne st, st(6)", "db ce")
	e = x64SrcHex(e, "fcmovnbe st, st(7)", "db d7")
	e = x64SrcHex(e, "fcmovnu st(0), st(1)", "db d9")
	e = x64SrcHex(e, "fadd st, st(1)", "d8 c1")
	e = x64SrcHex(e, "fadd st(1), st", "dc c1")
	e = x64SrcHex(e, "fadd st(1)", "d8 c1")
	e = x64SrcHex(e, "fadd st(0), st(0)", "d8 c0")
	e = x64SrcHex(e, "fsub st(1), st", "dc e9")
	e = x64SrcHex(e, "fsubr st(1), st", "dc e1")
	e = x64SrcHex(e, "fdiv st, st(1)", "d8 f1")
	e = x64SrcHex(e, "fdivr st(1), st", "dc f1")
	e = x64SrcHex(e, "faddp st(1), st", "de c1")
	e = x64SrcHex(e, "faddp st, st(1)", "de c1")
	e = x64SrcHex(e, "fmulp st, st(2)", "de ca")
	e = x64SrcHex(e, "faddp st(2), st(0)", "de c2")
	e = x64SrcHex(e, "fsubp st(2)", "de ea")
	e = x64SrcHex(e, "fsubp st", "de e8")
	e = x64SrcHex(e, "fdivrp st(1), st", "de f1")
	return e
}

// Memory of each size each instruction has, the single-size ones unsized, the environment and
// state at any size; an indexed address, a segment override, rip, a symbol, a GOT slot.
func TestX64X87Memory() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fld dword ptr [rax]", "d9 00")
	e = x64SrcHex(e, "fld qword ptr [rax]", "dd 00")
	e = x64SrcHex(e, "fld tbyte ptr [rax]", "db 28")
	e = x64SrcHex(e, "fld xword ptr [rax]", "db 28")
	e = x64SrcHex(e, "fstp tbyte ptr [rax]", "db 38")
	e = x64SrcHex(e, "fild word ptr [rax]", "df 00")
	e = x64SrcHex(e, "fild qword ptr [rax]", "df 28")
	e = x64SrcHex(e, "fistp qword ptr [rax]", "df 38")
	e = x64SrcHex(e, "fisttp qword ptr [rax]", "dd 08")
	e = x64SrcHex(e, "fbld [rax]", "df 20")
	e = x64SrcHex(e, "fbstp tbyte ptr [rax]", "df 30")
	e = x64SrcHex(e, "fadd qword ptr [rax]", "dc 00")
	e = x64SrcHex(e, "fsubr qword ptr [rax]", "dc 28")
	e = x64SrcHex(e, "fcomp qword ptr [rax]", "dc 18")
	e = x64SrcHex(e, "fiadd word ptr [rax]", "de 00")
	e = x64SrcHex(e, "fidivr word ptr [rax]", "de 38")
	e = x64SrcHex(e, "ficom dword ptr [rax]", "da 10")
	e = x64SrcHex(e, "fldcw [rax]", "d9 28")
	e = x64SrcHex(e, "fstcw word ptr [rax]", "9b d9 38")
	e = x64SrcHex(e, "fldenv qword ptr [rax]", "d9 20")
	e = x64SrcHex(e, "fstenv [rax]", "9b d9 30")
	e = x64SrcHex(e, "fnsave tbyte ptr [rax]", "dd 30")
	e = x64SrcHex(e, "fsave [rax]", "9b dd 30")
	e = x64SrcHex(e, "frstor dword ptr [rax]", "dd 20")
	e = x64SrcHex(e, "fnstsw ax", "df e0")
	e = x64SrcHex(e, "fnstsw [rax]", "dd 38")
	e = x64SrcHex(e, "fstsw ax", "9b df e0")
	e = x64SrcHex(e, "fstsw [rax]", "9b dd 38")
	e = x64SrcHex(e, "fld dword ptr [r9 + r10*4 + 8]", "43 d9 44 91 08")
	e = x64SrcHex(e, "fstp tbyte ptr fs:[rax]", "64 db 38")
	e = x64TlsCase(e, "fld qword ptr [rip + x]", "dd 05 00 00 00 00", x64.FIX_REL32_LEA, 2, 0)
	e = x64TlsCase(e, "fldcw word ptr [rip + x]", "d9 2d 00 00 00 00", x64.FIX_REL32_LEA, 2, 0)
	e = x64TlsCase(e, "fild word ptr [x]", "df 04 25 00 00 00 00", x64.FIX_ABS32S, 3, 0)
	e = x64TlsCase(e, "fld dword ptr [rip + x@GOTPCREL]", "d9 05 00 00 00 00", x64.FIX_GOTPCREL_PLAIN,
			2, 0)
	return e
}

// What clang rejects: a stack index past 7 or not an integer, `st1`; memory of a size the
// instruction has not, or unsized where it has several; operands of the wrong kind or number; the
// AT&T-suffixed names; fcmov without st first; and what bnas rejects as decided: fsubp st, st(i)
// (and fsubrp, fdivp, fdivrp; GNU as), the 287 relics (clang), a lock or repeat prefix (GNU as).
func TestX64X87Rejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "fld st(8)", "invalid stack index")
	e = x64LineErrorHas(e, "fld st(-1)", "expected stack index")
	e = x64LineErrorHas(e, "fld st(1+1)", "expected ')'")
	e = x64LineErrorHas(e, "fld st1", "ambiguous operand size")
	e = x64LineErrorHas(e, "fld [rax]", "ambiguous operand size")
	e = x64LineErrorHas(e, "fadd [rax]", "ambiguous operand size")
	e = x64LineErrorHas(e, "fiadd [rax]", "ambiguous operand size")
	e = x64LineRejected(e, "fld word ptr [rax]")
	e = x64LineRejected(e, "fst tbyte ptr [rax]")
	e = x64LineRejected(e, "fist qword ptr [rax]")
	e = x64LineRejected(e, "fbld qword ptr [rax]")
	e = x64LineRejected(e, "fldcw dword ptr [rax]")
	e = x64LineRejected(e, "fnstsw eax")
	e = x64LineRejected(e, "fnstsw byte ptr [rax]")
	e = x64LineRejected(e, "fld")
	e = x64LineRejected(e, "ffree")
	e = x64LineRejected(e, "fxch st(0), st(1)")
	e = x64LineRejected(e, "fcom st, st(1)")
	e = x64LineRejected(e, "fucomi st(1), st")
	e = x64LineRejected(e, "fadd st(1), st(2)")
	e = x64LineRejected(e, "fmulp st(1), st(1)")
	e = x64LineRejected(e, "fcmovb st(1)")
	e = x64LineRejected(e, "fcmovb st(1), st")
	e = x64LineRejected(e, "fld st(1), st(2)")
	e = x64LineRejected(e, "fld eax")
	e = x64LineRejected(e, "mov eax, st(1)")
	e = x64LineRejected(e, "flds [rax]")
	e = x64LineRejected(e, "faddl [rax]")
	e = x64LineRejected(e, "fstpt [rax]")
	e = x64LineErrorHas(e, "fsubp st, st(1)", "takes its operands as st(i), st")
	e = x64LineRejected(e, "fadd st, dword ptr [rax]")
	e = x64LineRejected(e, "fsub qword ptr [rax], st")
	e = x64LineRejected(e, "fsubrp st, st(1)")
	e = x64LineRejected(e, "fdivp st, st(1)")
	e = x64LineRejected(e, "fdivrp st, st(1)")
	e = x64LineRejected(e, "fdisi")
	e = x64LineRejected(e, "feni")
	e = x64LineRejected(e, "fsetpm")
	e = x64LineRejected(e, "lock fld st(1)")
	e = x64LineRejected(e, "rep fninit")
	return e
}

// A waiting form's FWAIT goes before its instruction's prefixes, as clang and GNU as place them: a
// segment override in the operand, a REX from {rex} (and the REX the operand needs); before a lone
// fwait {rex} is its own.  (A prefix written as an instruction: TestX64X87WaitPrefixInstructions.)
func TestX64X87WaitPrefixes() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fstcw word ptr fs:[rax]", "9b 64 d9 38")
	e = x64SrcHex(e, "fstsw word ptr gs:[rax]", "9b 65 dd 38")
	e = x64SrcHex(e, "fstenv fs:[rax]", "9b 64 d9 30")
	e = x64SrcHex(e, "fsave gs:[r8]", "9b 65 41 dd 30")
	e = x64SrcHex(e, "{rex} fstcw word ptr [rax]", "9b 40 d9 38")
	e = x64SrcHex(e, "{rex} fstcw word ptr [r8]", "9b 41 d9 38")
	e = x64SrcHex(e, "{rex} fsave [r9]", "9b 41 dd 31")
	e = x64SrcHex(e, "{rex} fstsw ax", "9b 40 df e0")
	e = x64SrcHex(e, "{rex} fclex", "9b 40 db e2")
	e = x64SrcHex(e, "{rex} finit", "9b 40 db e3")
	e = x64SrcHex(e, "{rex} fwait", "40 9b")
	e = x64LineErrorHas(e, "fstcw dword ptr [rax]", "word of memory")
	return e
}

// A prefix written as an instruction before a waiting form goes after its FWAIT, as GNU as places
// it, so it is the stored instruction's (clang emits it first, before the 9B: `fs fstcw word ptr
// [rax]` 64 9b d9 38 stores through DS); a REX `{rex}` or rex64 asks for comes after it.  The
// prefixes after the 9B stand in the order written (GNU as puts a segment's before 66).
func TestX64X87WaitPrefixInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fs fstcw word ptr [rax]", "9b 64 d9 38")
	e = x64SrcHex(e, "data16 fstenv [rax]", "9b 66 d9 30")
	e = x64SrcHex(e, "FS FSAVE [rax]", "9b 64 dd 30")
	e = x64SrcHex(e, "fs fstsw word ptr [rax]", "9b 64 dd 38")
	e = x64SrcHex(e, "fs fstsw ax", "9b 64 df e0")
	e = x64SrcHex(e, "fs fstsw", "9b 64 df e0")
	e = x64SrcHex(e, "data16 fstsw ax", "9b 66 df e0")
	e = x64SrcHex(e, "gs finit", "9b 65 db e3")
	e = x64SrcHex(e, "fs fclex", "9b 64 db e2")
	e = x64SrcHex(e, "fs data16 fstenv [rax]", "9b 64 66 d9 30")
	e = x64SrcHex(e, "data16 fs fstenv [rax]", "9b 66 64 d9 30")
	e = x64SrcHex(e, "data16 fstcw word ptr fs:[rax]", "9b 66 64 d9 38")
	e = x64SrcHex(e, "rex64 fs fstcw word ptr [rax]", "9b 64 48 d9 38")
	e = x64SrcHex(e, "fs rex64 fstcw word ptr [rax]", "9b 64 48 d9 38")
	e = x64SrcHex(e, "{rex} fs fstcw word ptr [rax]", "9b 64 40 d9 38")
	e = x64SrcHex(e, "fs {rex} fstcw word ptr [rax]", "9b 64 40 d9 38")
	e = x64SrcHex(e, "fs fwait", "64 9b")
	e = x64SrcHex(e, "fs fnstcw word ptr [rax]", "64 d9 38")
	e = x64SrcHex(e, "fs fstcw word ptr [rax]; fstcw word ptr [rbx]", "9b 64 d9 38 9b d9 3b")
	e = x64LineRejected(e, "fs fstcw eax")
	e = x64LineErrorHas(e, "FS FSTCW", "'FSTCW' takes another number of operands")
	e = x64LineRejected(e, "lock fstcw word ptr [rax]")
	e = x64LineRejected(e, "fs lock fstcw word ptr [rax]")
	e = x64LineRejected(e, "rep fstsw ax")
	e = x64LineRejected(e, "xacquire fs fstcw word ptr [rax]")
	e = x64TlsCase(e, "fs fstcw word ptr [rip + x]", "9b 64 d9 3d 00 00 00 00", x64.FIX_REL32_LEA, 4,
			0)
	return e
}
