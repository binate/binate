package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/ctrl"
import "pkg/binate/asm/x64/flags"
import "pkg/binate/asm/x64/sse"

// The x86-64 instructions written with no operands, as clang takes them in 64-bit mode: nop,
// syscall, ud2, int3; the sign extensions of the accumulator (cbw, cwde, cdqe, cwd, cdq, cqo);
// the flag instructions (clc, stc, cmc, cld, std, lahf, sahf, and pushf / popf with their q and w
// spellings — pushf is pushfq, as clang reads it; pushfd, the 32-bit form, has no 64-bit
// encoding); leave, hlt, pause, int1 (GNU as's; clang takes none) and iret / iretd / iretq (iret
// the 16-bit form in 64-bit mode, as clang reads it); sysret / sysretq, sysenter, sysexit /
// sysexitq; emms, femms; the system instructions without operands (x64SysZero, x64SysExtZero,
// x64VirtZero) and the x87 ones (x64X87Zero).

// x64ZeroOperand reports whether mnem names an instruction with no operands, emitting it when
// emit is set.
func x64ZeroOperand(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	if mnemIs(mnem, "nop") {
		if emit { x64.Nop(a) }
	} else if mnemIs(mnem, "syscall") {
		if emit { ctrl.Syscall(a) }
	} else if mnemIs(mnem, "ud2") {
		if emit { ctrl.Ud2(a) }
	} else if mnemIs(mnem, "int3") {
		if emit { ctrl.Int3(a) }
	} else if mnemIs(mnem, "cbw") {
		if emit { x64.Cbw(a) }
	} else if mnemIs(mnem, "cwde") {
		if emit { x64.Cwde(a) }
	} else if mnemIs(mnem, "cdqe") {
		if emit { x64.Cdqe(a) }
	} else if mnemIs(mnem, "cwd") {
		if emit { x64.Cwd(a) }
	} else if mnemIs(mnem, "cdq") {
		if emit { x64.Cdq(a) }
	} else if mnemIs(mnem, "cqo") {
		if emit { x64.Cqo(a) }
	} else if mnemIs(mnem, "clc") {
		if emit { flags.Clc(a) }
	} else if mnemIs(mnem, "stc") {
		if emit { flags.Stc(a) }
	} else if mnemIs(mnem, "cmc") {
		if emit { flags.Cmc(a) }
	} else if mnemIs(mnem, "cld") {
		if emit { flags.Cld(a) }
	} else if mnemIs(mnem, "std") {
		if emit { flags.Std(a) }
	} else if mnemIs(mnem, "lahf") {
		if emit { flags.Lahf(a) }
	} else if mnemIs(mnem, "sahf") {
		if emit { flags.Sahf(a) }
	} else if mnemIs(mnem, "pushf") || mnemIs(mnem, "pushfq") {
		if emit { flags.Pushf(a, x64.SZ64) }
	} else if mnemIs(mnem, "pushfw") {
		if emit { flags.Pushf(a, x64.SZ16) }
	} else if mnemIs(mnem, "popf") || mnemIs(mnem, "popfq") {
		if emit { flags.Popf(a, x64.SZ64) }
	} else if mnemIs(mnem, "popfw") {
		if emit { flags.Popf(a, x64.SZ16) }
	} else if mnemIs(mnem, "leave") {
		if emit { ctrl.Leave(a) }
	} else if mnemIs(mnem, "hlt") {
		if emit { ctrl.Hlt(a) }
	} else if mnemIs(mnem, "pause") {
		if emit { ctrl.Pause(a) }
	} else if mnemIs(mnem, "int1") {
		if emit { ctrl.Int1(a) }
	} else if mnemIs(mnem, "iret") {
		if emit { ctrl.Iret(a, x64.SZ16) }
	} else if mnemIs(mnem, "iretd") {
		if emit { ctrl.Iret(a, x64.SZ32) }
	} else if mnemIs(mnem, "iretq") {
		if emit { ctrl.Iret(a, x64.SZ64) }
	} else if mnemIs(mnem, "sysret") {
		if emit { ctrl.Sysret(a, x64.SZ32) }
	} else if mnemIs(mnem, "sysretq") {
		if emit { ctrl.Sysret(a, x64.SZ64) }
	} else if mnemIs(mnem, "sysenter") {
		if emit { ctrl.Sysenter(a) }
	} else if mnemIs(mnem, "sysexit") {
		if emit { ctrl.Sysexit(a, x64.SZ32) }
	} else if mnemIs(mnem, "sysexitq") {
		if emit { ctrl.Sysexit(a, x64.SZ64) }
	} else if mnemIs(mnem, "emms") {
		if emit { sse.Emms(a) }
	} else if mnemIs(mnem, "femms") {
		if emit { sse.Femms(a) }
	} else {
		return x64SysZero(a, mnem, emit) || x64SysExtZero(a, mnem, emit) || x64VirtZero(a, mnem, emit) ||
				x64X87Zero(a, mnem, emit)
	}
	return true
}
