package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The x86-64 instructions written with no operands, as clang takes them in 64-bit mode: nop,
// syscall, ud2, int3; the sign extensions of the accumulator (cbw, cwde, cdqe, cwd, cdq, cqo);
// the flag instructions (clc, stc, cmc, cld, std, lahf, sahf, and pushf / popf with their q and w
// spellings — pushf is pushfq, as clang reads it; pushfd, the 32-bit form, has no 64-bit
// encoding).

// x64ZeroOperand reports whether mnem names an instruction with no operands, emitting it when
// emit is set.
func x64ZeroOperand(a @asm.Assembler, mnem *[]readonly char, emit bool) bool {
	if mnemIs(mnem, "nop") {
		if emit { x64.Nop(a) }
	} else if mnemIs(mnem, "syscall") {
		if emit { x64.Syscall(a) }
	} else if mnemIs(mnem, "ud2") {
		if emit { x64.Ud2(a) }
	} else if mnemIs(mnem, "int3") {
		if emit { x64.Int3(a) }
	} else if mnemIs(mnem, "cbw") {
		if emit { x64.Cbw(a) }
	} else if mnemIs(mnem, "cwde") {
		if emit { x64.Cwde(a) }
	} else if mnemIs(mnem, "cdqe") {
		if emit { x64.Cdqe(a) }
	} else if mnemIs(mnem, "cwd") {
		if emit { x64.Cwd(a) }
	} else if mnemIs(mnem, "cdq") {
		if emit { x64.Cdq(a) }
	} else if mnemIs(mnem, "cqo") {
		if emit { x64.Cqo(a) }
	} else if mnemIs(mnem, "clc") {
		if emit { x64.Clc(a) }
	} else if mnemIs(mnem, "stc") {
		if emit { x64.Stc(a) }
	} else if mnemIs(mnem, "cmc") {
		if emit { x64.Cmc(a) }
	} else if mnemIs(mnem, "cld") {
		if emit { x64.Cld(a) }
	} else if mnemIs(mnem, "std") {
		if emit { x64.Std(a) }
	} else if mnemIs(mnem, "lahf") {
		if emit { x64.Lahf(a) }
	} else if mnemIs(mnem, "sahf") {
		if emit { x64.Sahf(a) }
	} else if mnemIs(mnem, "pushf") || mnemIs(mnem, "pushfq") {
		if emit { x64.Pushf(a, x64.SZ64) }
	} else if mnemIs(mnem, "pushfw") {
		if emit { x64.Pushf(a, x64.SZ16) }
	} else if mnemIs(mnem, "popf") || mnemIs(mnem, "popfq") {
		if emit { x64.Popf(a, x64.SZ64) }
	} else if mnemIs(mnem, "popfw") {
		if emit { x64.Popf(a, x64.SZ16) }
	} else {
		return false
	}
	return true
}
