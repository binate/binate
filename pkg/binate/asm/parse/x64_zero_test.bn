package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The instructions with no operands (x64_zero.bn), and adc / sbb / xchg, against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn.)

// Each instruction with no operands, its name in any case; pushf and popf are the 64-bit forms.
func TestX64ZeroOperand() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "nop", "90")
	e = x64SrcHex(e, "syscall", "0f 05")
	e = x64SrcHex(e, "ud2", "0f 0b")
	e = x64SrcHex(e, "int3", "cc")
	e = x64SrcHex(e, "cbw", "66 98")
	e = x64SrcHex(e, "cwde", "98")
	e = x64SrcHex(e, "CDQE", "48 98")
	e = x64SrcHex(e, "cwd", "66 99")
	e = x64SrcHex(e, "cdq", "99")
	e = x64SrcHex(e, "cqo", "48 99")
	e = x64SrcHex(e, "clc", "f8")
	e = x64SrcHex(e, "stc", "f9")
	e = x64SrcHex(e, "cmc", "f5")
	e = x64SrcHex(e, "cld", "fc")
	e = x64SrcHex(e, "std", "fd")
	e = x64SrcHex(e, "lahf", "9f")
	e = x64SrcHex(e, "sahf", "9e")
	e = x64SrcHex(e, "pushf", "9c")
	e = x64SrcHex(e, "pushfq", "9c")
	e = x64SrcHex(e, "pushfw", "66 9c")
	e = x64SrcHex(e, "popf", "9d")
	e = x64SrcHex(e, "PopFQ", "9d")
	e = x64SrcHex(e, "popfw", "66 9d")
	return e
}

// An operand after one is an error, and so are pushfd / popfd (no 64-bit-mode form).
func TestX64ZeroOperandRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "cbw al")
	e = x64LineRejected(e, "clc 1")
	e = x64LineRejected(e, "pushf rax")
	e = x64LineRejected(e, "pushfd")
	e = x64LineRejected(e, "popfd")
	return e
}

// adc / sbb take the ALU group's forms (the accumulator's included), xchg its own.
func TestX64AdcSbbXchg() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "adc rax, rbx", "48 11 d8")
	e = x64SrcHex(e, "adc rax, [rbx]", "48 13 03")
	e = x64SrcHex(e, "adc qword ptr [rbx], 5", "48 83 13 05")
	e = x64SrcHex(e, "adc al, 5", "14 05")
	e = x64SrcHex(e, "sbb eax, 300", "1d 2c 01 00 00")
	e = x64SrcHex(e, "sbb cl, 5", "80 d9 05")
	e = x64SrcHex(e, "add ax, 300", "66 05 2c 01")
	e = x64SrcHex(e, "test eax, 1", "a9 01 00 00 00")
	e = x64SrcHex(e, "xchg rax, rbx", "48 93")
	e = x64SrcHex(e, "xchg rbx, rcx", "48 87 d9")
	e = x64SrcHex(e, "xchg eax, eax", "87 c0")
	e = x64SrcHex(e, "xchg rax, [rbx]", "48 87 03")
	e = x64SrcHex(e, "xchg [rbx], cl", "86 0b")
	e = x64LineRejected(e, "xchg rax, 5")
	e = x64LineRejected(e, "xchg [rbx], [rcx]")
	e = x64LineRejected(e, "xchg rax, ecx")
	return e
}
