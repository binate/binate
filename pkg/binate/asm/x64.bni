// Package x64 provides x86-64 instruction encoding for the assembler.
// Instructions use Intel syntax (destination first). Register operands
// carry their size (8/16/32/64-bit), which determines the operand size
// prefix and REX.W requirements.  The SSE encoders are the sub-package
// pkg/binate/asm/x64/sse.
package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// 64-bit general-purpose registers
const (
	RAX int = iota
	RCX
	RDX
	RBX
	RSP
	RBP
	RSI
	RDI
	R8
	R9
	R10
	R11
	R12
	R13
	R14
	R15
)

// Operand sizes (in bits)
const SZ8 int = 8

const SZ16 int = 16

const SZ32 int = 32

const SZ64 int = 64

// Operand kinds
const (
	OP_REG int = iota // register (with size)
	OP_IMM            // immediate value
	OP_MEM            // [base + index*scale + disp]
	OP_LABEL          // label reference (for branches/calls)
	OP_RIPLABEL       // `[rip + label]` — RIP-relative access to a symbol
	// (the Label field carries the symbol, Imm its addend): a memory operand,
	// accepted wherever OP_MEM is (see "Operand kinds").
	OP_RIPGOTLABEL // `[rip + label@GOTPCREL]` — a GOT-indirect LOAD of an
	// external symbol's address (the Label field carries the symbol).  Mov
	// routes it to MovGotPcRel; other instructions reject it.
	OP_RIPTLVP // `[rip + label@TLVP]` — the address of a Mach-O thread-local
	// variable's descriptor (the Label field carries the variable): only a Mov
	// source into a 64-bit register (RipTlvp); other instructions reject it.
)

// Condition codes for Jcc/SETcc/CMOVcc
const (
	CC_O int = 0   // overflow
	CC_NO int = 1  // not overflow
	CC_B int = 2   // below (unsigned <) / carry
	CC_AE int = 3  // above or equal (unsigned >=) / not carry
	CC_E int = 4   // equal / zero
	CC_NE int = 5  // not equal / not zero
	CC_BE int = 6  // below or equal (unsigned <=)
	CC_A int = 7   // above (unsigned >)
	CC_S int = 8   // sign (negative)
	CC_NS int = 9  // not sign (positive)
	CC_P int = 10  // parity even
	CC_NP int = 11 // parity odd
	CC_L int = 12  // less (signed <)
	CC_GE int = 13 // greater or equal (signed >=)
	CC_LE int = 14 // less or equal (signed <=)
	CC_G int = 15  // greater (signed >)
)

// Condition code aliases
const CC_C int = 2 // carry (same as B)

const CC_NC int = 3 // not carry (same as AE)

const CC_Z int = 4 // zero (same as E)

const CC_NZ int = 5 // not zero (same as NE)

const CC_NAE int = 2 // not above or equal (same as B)

const CC_NB int = 3 // not below (same as AE)

const CC_NA int = 6 // not above (same as BE)

const CC_NBE int = 7 // not below or equal (same as A)

const CC_NGE int = 12 // not greater or equal (same as L)

const CC_NL int = 13 // not less (same as GE)

const CC_NG int = 14 // not greater (same as LE)

const CC_NLE int = 15 // not less or equal (same as G)

// InvertCC returns the condition that holds exactly when cc does not: cc ^ 1,
// pairing O/NO, B/AE, E/NE, BE/A, S/NS, P/NP, L/GE and LE/G.  So a Jcc on
// InvertCC(cc) to one target is the Jcc on cc to the other, with the
// fall-through swapped.  A cc outside CC_O..CC_G sets an assembler error and
// returns -1, which every encoder taking a condition also rejects.
func InvertCC(a @asm.Assembler, cc int) int

// Fixup kinds for x86-64
const (
	FIX_REL32 int = 300 // 32-bit PC-relative (JMP, Jcc, CALL)
	FIX_ABS64 int = 301 // 64-bit absolute address
	// FIX_REL32_LEA is the 32-bit PC-relative displacement of a
	// `[rip + sym]` memory operand (an OP_RIPLABEL, in any instruction
	// that takes one: `lea rax, [rip + sym]`, `add dword ptr [rip +
	// sym], 5`).  Its addend is the operand's less the size of any
	// immediate after the displacement, which the CPU measures from the
	// end of the instruction.  Same bit-level encoding as FIX_REL32, but
	// Mach-O requires X86_64_RELOC_SIGNED (or SIGNED_1 / _2 / _4) here
	// rather than X86_64_RELOC_BRANCH — ld classifies BRANCH as reaching
	// code symbols and miscomputes the displacement when a BRANCH reloc
	// points at a data symbol — e.g. the .data vtable emitted by
	// emitFuncValueVtables and referenced by OP_FUNC_VALUE's RIP-relative
	// LEA.
	FIX_REL32_LEA int = 302
	// FIX_GOTPCREL is the RIP-relative displacement of a `mov r64,
	// [rip + sym@GOTPCREL]` — a GOT-indirect LOAD of an external data
	// symbol's address (e.g. __c_global under PIE, where the datum lives
	// in another DSO and cannot be reached by a direct PC-relative ref).
	// ELF: R_X86_64_REX_GOTPCRELX (the linker-relaxable REX.W form);
	// Mach-O: X86_64_RELOC_GOT_LOAD.  PC-relative (addend -4), like REL32.
	FIX_GOTPCREL int = 303
	// The thread-local fixups (ELF only), never resolved at assembly time.  FIX_TPOFF32 and
	// FIX_DTPOFF32 are a symbol's 32-bit offset from the thread pointer (local-exec) and in its
	// module's thread-local block (local-dynamic), absolute (R_X86_64_TPOFF32 / DTPOFF32, the
	// addend as written): a MemSym operand's displacement.  FIX_GOTTPOFF, FIX_TLSGD, FIX_TLSLD
	// and FIX_TLSDESC are the RIP-relative displacement of a RipTls operand — `[rip +
	// sym@GOTTPOFF]` (initial-exec: the GOT slot holding the symbol's offset from the thread
	// pointer), `@TLSGD` / `@TLSLD` (general / local-dynamic: __tls_get_addr's argument for the
	// symbol / its module) and `@tlsdesc` (the symbol's TLS descriptor) — PC-relative like
	// FIX_REL32_LEA (R_X86_64_GOTTPOFF / TLSGD / TLSLD / GOTPC32_TLSDESC).
	FIX_TPOFF32 int = 304
	FIX_DTPOFF32 int = 305
	FIX_GOTTPOFF int = 306
	FIX_TLSGD int = 307
	FIX_TLSLD int = 308
	FIX_TLSDESC int = 309
	// FIX_TLSCALL marks the call through a TLS descriptor, `call qword ptr [rax +
	// sym@tlscall]` (CallMem with a MemSym of this kind), at its first byte, patching nothing
	// (R_X86_64_TLSDESC_CALL), so the linker can relax it with the `@tlsdesc` load before it.
	// FIX_TPOFF64 and FIX_DTPOFF64 are the 64-bit offsets of a datum (`.uint64 sym@TPOFF`,
	// `@DTPOFF`: R_X86_64_TPOFF64 / DTPOFF64), FIX_TPOFF32 and FIX_DTPOFF32 the 32-bit ones.
	FIX_TLSCALL int = 310
	FIX_TPOFF64 int = 311
	FIX_DTPOFF64 int = 312
	// FIX_TLVP is the RIP-relative displacement of an OP_RIPTLVP operand (Mach-O only): an
	// X86_64_RELOC_TLV against the variable, PC-relative like FIX_REL32_LEA, with no addend.
	FIX_TLVP int = 313
	// FIX_ABS32S is a sign-extended 32-bit field relocated against a symbol's address: the imm32
	// of a 64-bit operation (an ImmSym immediate: `mov rax, offset x`, `push offset x`) or a
	// MemSym operand's displacement (`mov rax, [x]`, `[rbx + x + 8]`): R_X86_64_32S on ELF; Mach-O
	// has no such relocation, and its writer reports one.  The other symbolic immediates are
	// relocated by the absolute data kinds of their field's size (asm.FIX_DATA_ABS8 / 16 / 32 / 64).
	FIX_ABS32S int = 314
)

// An operand for x86-64 instructions. The Mem operand encodes the
// full SIB addressing mode: [base + index*scale + disp].
type Operand struct {
	Kind  int
	Reg   int // register number (RAX..R15)
	Size  int // operand size in bits (8, 16, 32, 64)
	Imm   int64 // immediate value (int64 so a 64-bit imm survives on a 32-bit host)
	Base  int // base register for memory (-1 for none)
	Index int // index register for memory (-1 for none)
	Scale int // scale factor (1, 2, 4, 8)
	Disp  int // displacement
	Label @[]char // an OP_LABEL's target, a RIP-relative operand's symbol, a MemSym's symbol
	// Abs marks a memory operand with neither base nor index as the absolute address
	// [disp32] (MemAbs) or, with Addr64, a 64-bit one (MemAddr64); without it such an
	// operand is [rip + disp32] (MemDisp)
	Abs bool
	// Disp32 gives a memory operand with a base a 32-bit displacement even when the value
	// fits 8 bits or is 0 — clang's encoding of a displacement it reads as a symbol (the
	// text parser sets it for a constant a label difference decided)
	Disp32 bool
	// Addr64 marks an absolute memory operand whose address, in Imm, is any 64-bit value
	// (MemAddr64) — with a Label, that symbol's plus Imm — which only the moffs form of Mov and
	// MovAbs encodes; Mov rejects one marked Disp32
	Addr64 bool
	// Fix is the fixup kind of a symbolic operand: a MemSym's FIX_ABS32S, FIX_TPOFF32,
	// FIX_DTPOFF32 or FIX_TLSCALL against Label (Disp the addend), an ImmSym's 0, FIX_TPOFF32 or
	// FIX_DTPOFF32, a RipTls's FIX_GOTTPOFF, FIX_TLSGD, FIX_TLSLD or FIX_TLSDESC; 0 for any other
	// operand (a RipLabel's fixup is FIX_REL32_LEA)
	Fix int
}

// --- Operand constructors ---

// Reg creates a register operand with the given size.
func Reg(r int, size int) Operand

// Imm creates an immediate operand from a host-`int` value (widens
// into the int64 Imm field).
func Imm(val int) Operand

// Imm64 creates an immediate operand carrying a full 64-bit value —
// for MOV-imm64 and other encodings whose immediate can exceed 32
// bits, which the `int`-based Imm truncates on a 32-bit host.
func Imm64(val int64) Operand

// ImmSym creates a symbolic immediate, `offset name + addend` (kind 0) or a thread-local offset
// `offset name@TPOFF + addend` / `@DTPOFF` (kind FIX_TPOFF32 / FIX_DTPOFF32): Mov, the ALU group,
// Test, Push, Imul3Op and MovAbs take it in their full-width immediate field (never an imm8 short
// form), relocated against name — a 64-bit operation's sign-extended imm32 by FIX_ABS32S, a 32- /
// 16- / 8-bit one's field by asm.FIX_DATA_ABS32 / 16 / 8, MovAbs's imm64 by asm.FIX_DATA_ABS64; a
// thread-local offset only in an imm32 (FIX_TPOFF32 / FIX_DTPOFF32) or MovAbs's imm64 (FIX_TPOFF64
// / FIX_DTPOFF64).  Any other kind, or a thread-local offset in an 8- or 16-bit field, sets an
// assembler error and emits nothing, as does a symbol where another instruction takes an
// immediate (a shift count, a bit offset).  The name is copied.
func ImmSym(name *[]readonly char, addend int64, kind int) Operand

// Immediate ranges.  An encoder whose immediate is sized by the
// operation width (Add/Sub/And/Or/Xor/Cmp, Test, Mov, Imul3) accepts a
// value representable at that width as a signed or an unsigned number:
//   8-bit:   -128 .. 255
//   16-bit:  -32768 .. 65535
//   32-bit:  -2^31 .. 2^32-1
//   64-bit:  -2^31 .. 2^31-1 (the imm32 is sign-extended to 64 bits;
//            Mov to a 64-bit register takes any int64, see Mov)
// A 16-bit operation takes a 2-byte imm16; the short sign-extended
// imm8 form is chosen when the value at the operation width fits it
// (e.g. a 32-bit 0xFFFFFFF0 is -16).  A fixed imm8 field — a shift
// count, a bit offset, the INT vector, package sse's shuffle controls (Imm8Ok) —
// accepts -128..255 (a negative value is its two's-complement byte).  An immediate outside
// its range sets an assembler error (asm.Assembler.HasError) and the
// instruction emits no bytes.
//
// Operand kinds.  Every encoder that takes an Operand checks its
// operands' kinds before emitting anything: an operand kind or kind
// combination the instruction has no encoding for (e.g. mem, mem; an
// immediate, a label or a GOT-indirect operand where a register or memory
// operand is required; a register where an x87 memory form, or package
// sse's, needs memory) likewise sets an assembler error and emits
// nothing.  A memory operand is an OP_MEM or an OP_RIPLABEL `[rip +
// label]`, which every encoder taking a memory operand encodes with a
// FIX_REL32_LEA fixup against the label (R_X86_64_PC32 /
// X86_64_RELOC_SIGNED*).  The rel32
// counts from the end of the instruction, so when an immediate follows it
// (`add dword ptr [rip + x], 5`) the fixup's addend is the operand's less
// the immediate's size, as clang emits it.  An OP_RIPGOTLABEL is encoded
// only as a Mov source (via MovGotPcRel), and an OP_RIPTLVP only as a Mov
// source into a 64-bit register; every other encoder and operand position
// rejects them.  A MemDisp operand
// is an ordinary memory operand: `[rip + disp]` with a literal
// displacement and no fixup; a MemAbs operand is the absolute address
// `[disp32]`, and a MemIdx operand with no base (base -1) is `[index*scale
// + disp32]`.  A MemSym operand's displacement is always 32 bits, relocated
// by its fixup, and a RipTls operand is encoded as a RipLabel
// with its own fixup kind; any other kind, or a RipTls with an addend, sets
// an assembler error where the encoder reaches the operand.
//
// Operand sizes.  A register or memory operand's size is SZ8, SZ16, SZ32 or
// SZ64 (any other is an error), and the two register / memory operands of
// Mov, the ALU group (Add .. Cmp), Test, Xchg, Imul2, Imul3, Shld, Shrd, the
// bit tests (Bt .. Btc) and the bit scans and counts (Bsf .. Popcnt) have the
// same size (`Mov(Mem(RAX, 0, SZ64), Reg(RCX, SZ32))` is an error, as clang's
// `mov qword ptr [rax], ecx`); an immediate takes the operation width from the
// other operand.  Beyond that: Push / Pop take a 16- or 64-bit operand,
// Lea, Imul2 and Imul3 no 8-bit destination (Lea's memory operand is an
// address: its size is not read), Movzx / Movsx / Movsxd a widening size
// pair, the shifts a CL count (Reg(RCX, SZ8)) whatever the destination's
// size, and the RIP-label helpers LeaRipLabel / MovRipLabel /
// MovRipLabelStore / MovGotPcRel the register sizes each lists (a sized
// GOT-indirect Mov operand must match the register).  An OP_RIPLABEL whose
// Size is 0 (RipLabel's) takes the size of the register operand of Mov,
// the ALU group, Test, Xchg, Imul2, Imul3, Shld, Shrd, the bit tests or the
// bit scans and counts (whose operands share one size);
// where an instruction reads the memory operand's size with no register
// to take it from (an immediate, a shift count, Push / Pop and the
// one-operand group) or reads it as a different size (Movzx / Movsx /
// Movsxd), size 0 is an error.  Setcc, Lea and the x87 memory forms (and
// package sse's) ignore the operand's size (the instruction fixes the
// access width).  A memory operand is checked when the encoder reaches it, after the instruction's
// prefix and opcode bytes: its base and index are each RAX..R15 or none,
// RSP is no index (its SIB encoding means none), an indexed operand's scale
// is 1, 2, 4 or 8, its displacement is a signed 32-bit value, and it is no
// 64-bit address (MemAddr64, only the moffs form's); any other sets an
// assembler error, and the instruction's bytes are then incomplete (an assembly
// with an error produces no object).  Other register numbers
// are not checked.
//
// Condition codes and the fixed imm8 fields are range-checked as noted
// at each instruction.  A memory operand's R8..R15 base or index sets
// REX.B / REX.X in every encoder.

// Mem creates a memory operand: [base + disp].  A base of -1 (none) makes it
// MemDisp's [rip + disp].
func Mem(base int, disp int, size int) Operand

// MemIdx creates a memory operand: [base + index*scale + disp], with no base
// when base is -1 ([index*scale + disp32]) and no index when index is -1
// (the scale then unused).
func MemIdx(base int, index int, scale int, disp int, size int) Operand

// MemDisp creates a RIP-relative memory operand (base=-1, no index).
func MemDisp(disp int, size int) Operand

// MemAbs creates an absolute memory operand: [disp32] (no base or index), the
// displacement sign-extended to 64 bits.
func MemAbs(disp int, size int) Operand

// MemAddr64 creates an absolute memory operand at the 64-bit address addr (Addr64): one only
// the moffs form of Mov and MovAbs encodes, with AL / AX / EAX / RAX (`mov rax,
// [0x123456789]`); every other encoder rejects it.  With Label and Fix set it is a symbol's
// address (FIX_ABS32S) or thread-local offset (FIX_TPOFF32 / FIX_DTPOFF32) plus addr; marked
// Disp32 — an address clang reads as a symbol, which its MOV encodes as a disp32 — only MovAbs
// takes it.
func MemAddr64(addr int64, size int) Operand

// Label creates a label reference operand.
func Label(name *[]readonly char) Operand

// RipGotLabel creates a `[rip + name@GOTPCREL]` operand (OP_RIPGOTLABEL) — a
// GOT-indirect load of an external symbol's address.  As a Mov source it routes
// to MovGotPcRel; other instructions reject it.
func RipGotLabel(name *[]readonly char) Operand

// RipLabel creates a `[rip + name]` RIP-relative memory operand
// (OP_RIPLABEL), accepted wherever a memory operand is.  Its Size is 0,
// taking the size of the instruction's register operand; set Size where
// there is none (e.g. `add dword ptr [rip + x], 5`).
func RipLabel(name *[]readonly char) Operand

// RipLabelAddend creates a `[rip + name + addend]` operand (OP_RIPLABEL, the
// addend in Imm): RipLabel's operand, its fixup carrying the addend.
func RipLabelAddend(name *[]readonly char, addend int64) Operand

// MemSym creates a memory operand whose displacement is a symbol's address — `[base +
// index*scale + sym + addend]` (kind FIX_ABS32S) — or a thread-local symbol's offset, `sym@TPOFF`
// (FIX_TPOFF32) or `@DTPOFF` (FIX_DTPOFF32), with no base when base is -1 and no index when index
// is -1 (with neither, the absolute `[sym + addend]`): a 32-bit displacement relocated against
// sym, the addend its relocation's.  Kind FIX_TLSCALL makes CallMem's TLS descriptor call.  The
// name is copied.
func MemSym(base int, index int, scale int, sym *[]readonly char, kind int, addend int,
		size int) Operand

// RipTls creates a `[rip + sym@GOTTPOFF]` operand (OP_RIPLABEL, kind FIX_GOTTPOFF), or
// `@TLSGD`, `@TLSLD` or `@tlsdesc` (FIX_TLSGD, FIX_TLSLD, FIX_TLSDESC), accepted wherever a
// memory operand is, its Size RipLabel's: a reference to the thread-local symbol's GOT slot,
// __tls_get_addr argument or descriptor, which takes no addend.  The name is copied.
func RipTls(sym *[]readonly char, kind int) Operand

// RipTlvp creates a `[rip + name@TLVP]` operand (OP_RIPTLVP) — the address of the Mach-O
// thread-local variable name's descriptor — which only Mov takes, into a 64-bit register (`mov
// rax, qword ptr [rip + _x@TLVP]`), the form ld64 links and clang emits: ld64 rejects `add`, and
// links a 32-bit register, an addend and a `lea` into a program that crashes (a `lea` of a
// variable another image defines is pointed at a slot holding the descriptor's address).  The
// name is copied.
func RipTlvp(name *[]readonly char) Operand

// --- Data movement ---

// Mov emits MOV dst, src.  An immediate src must fit dst's width (see
// "Immediate ranges"): 8-bit -128..255, 16-bit -32768..65535, 32-bit
// -2^31..2^32-1, and a 64-bit memory destination -2^31..2^31-1.  A
// 64-bit register destination takes any int64 (the 10-byte imm64 form
// when it does not fit a sign-extended imm32).  An out-of-range
// immediate sets an assembler error and emits nothing.  An OP_RIPTLVP src
// (RipTlvp) needs a 64-bit register dst and a Size of 0 or SZ64.  AL / AX /
// EAX / RAX loaded from or stored to a MemAddr64 operand take the moffs form
// (A0 / A1 / A2 / A3 and the 8-byte address), as clang's; another register
// with one is an error (clang keeps the address's low 32 bits), and so is one
// marked Disp32 (clang's MOV encodes it as a disp32).
func Mov(a @asm.Assembler, dst Operand, src Operand)

// Push emits PUSH src: a 64-bit (or, with 0x66, 16-bit) register or
// memory operand, or an immediate.  An immediate is sign-extended to the
// pushed 64-bit word, so it must lie in -2^31..2^31-1.  An out-of-range
// immediate, an 8/32-bit operand or any other operand kind sets an
// assembler error and emits nothing.
func Push(a @asm.Assembler, src Operand)

// Pop emits POP dst: a 64-bit (or, with 0x66, 16-bit) register or memory
// operand.  Anything else sets an assembler error and emits nothing.
func Pop(a @asm.Assembler, dst Operand)

// Xchg emits XCHG dst, src: two registers of one size, or a register and a memory
// operand in either order (the register in ModR/M's reg field, the other in its
// r/m, as clang's).  Two 16-, 32- or 64-bit registers one of which is AX / EAX /
// RAX take the one-byte 0x90 + reg form, as clang's — but `xchg eax, eax` is 87
// C0 (0x90 would leave RAX's upper half), and `xchg rax, rax` is 0x90 alone.  Any
// other operands set an assembler error and emit nothing.
func Xchg(a @asm.Assembler, dst Operand, src Operand)

// Lea emits LEA dst, src (load effective address): dst a 16/32/64-bit
// register, src a memory operand (a RipLabel included).  Any other operand kinds
// (an OP_RIPTLVP included: see RipTlvp), or an 8-bit dst (there is no 8-bit
// LEA), set an assembler error and emit nothing.
func Lea(a @asm.Assembler, dst Operand, src Operand)

// LeaRipLabel emits `lea dst, [rip + rel32-to-label]` and adds a
// FIX_REL32_LEA fixup against the named label (relocated as
// R_X86_64_PC32 / X86_64_RELOC_SIGNED).  dst is a 16/32/64-bit register
// (0x66 / none / REX.W); anything else sets an assembler error and emits
// nothing.
func LeaRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char)

// MovRipLabel emits `mov dst, [rip + rel32-to-label]` and adds a
// FIX_REL32_LEA fixup — a direct RIP-relative LOAD of the dst-sized value at
// `label` (the R_X86_64_PC32 sibling of LeaRipLabel, which instead computes
// the address).  dst is an 8/16/32/64-bit register (0x8A / 0x66 0x8B / 0x8B /
// REX.W 0x8B); anything else sets an assembler error and emits nothing.  For
// a GOT-indirect load of an external symbol use MovGotPcRel.
func MovRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char)

// MovRipLabelStore emits `mov [rip + rel32-to-label], src` — a direct
// RIP-relative STORE of the src-sized register into `label` (the store sibling
// of MovRipLabel's load; 0x88 / 0x66 0x89 / 0x89 / REX.W 0x89).  Same
// FIX_REL32_LEA → R_X86_64_PC32 relocation.  src must be an 8/16/32/64-bit
// register; an immediate or any other src sets an assembler error and emits
// nothing (an immediate store is Mov with a RipLabel whose Size is set).
func MovRipLabelStore(a @asm.Assembler, src Operand, label *[]readonly char)

// MovGotPcRel emits `mov dst, [rip + label@GOTPCREL]` (REX.W + 0x8B) and adds
// a FIX_GOTPCREL fixup — a GOT-indirect LOAD that places label's real address
// (the GOT slot's contents) in dst.  It is a MOV, not a LEA: LEA would yield
// the GOT slot's address, not the symbol's.  Used to reach an external data
// symbol under PIE (e.g. __c_global).  dst must be a 64-bit register (the slot
// holds a 64-bit address); anything else sets an assembler error and emits
// nothing.
func MovGotPcRel(a @asm.Assembler, dst Operand, label *[]readonly char)

// --- Arithmetic ---
//
// For Add/Adc/Sub/Sbb/And/Or/Xor/Cmp/Test, an immediate src must fit the
// operation width (see "Immediate ranges"): 8-bit -128..255, 16-bit
// -32768..65535, 32-bit -2^31..2^32-1, 64-bit -2^31..2^31-1.  An
// out-of-range immediate sets an assembler error and emits nothing.  The
// encoding is clang's: for all but Test, the sign-extended imm8 form (0x83)
// where a number fits it — never for an 8-bit operation or a symbol — and
// otherwise, for AL / AX / EAX / RAX, the accumulator's own form with no ModR/M
// (`add al, 1` 04 01, `add eax, 300` 05 imm32), a symbolic immediate of AX /
// EAX / RAX keeping the general form (0x81) as clang's; Test's, below.

// Add emits ADD dst, src.  Immediate src: see the range note above.
func Add(a @asm.Assembler, dst Operand, src Operand)

// Adc emits ADC dst, src (add with carry).  Immediate src: see the range
// note above.
func Adc(a @asm.Assembler, dst Operand, src Operand)

// Sub emits SUB dst, src.  Immediate src: see the range note above.
func Sub(a @asm.Assembler, dst Operand, src Operand)

// Sbb emits SBB dst, src (subtract with borrow).  Immediate src: see the
// range note above.
func Sbb(a @asm.Assembler, dst Operand, src Operand)

// And emits AND dst, src.  Immediate src: see the range note above.
func And(a @asm.Assembler, dst Operand, src Operand)

// Or emits OR dst, src.  Immediate src: see the range note above.
func Or(a @asm.Assembler, dst Operand, src Operand)

// Xor emits XOR dst, src.  Immediate src: see the range note above.
func Xor(a @asm.Assembler, dst Operand, src Operand)

// Cmp emits CMP dst, src (sets flags, no result stored).  Immediate
// src: see the range note above.
func Cmp(a @asm.Assembler, dst Operand, src Operand)

// Test emits TEST dst, src (AND setting flags, no result stored): r/m,
// reg; reg, mem (encoded as mem, reg — TEST is commutative); or r/m, imm.
// TEST has no sign-extended imm8 form, so an immediate is always
// operation-width (imm8 / imm16 / imm32); its range is as noted above.  AL /
// AX / EAX / RAX always take the accumulator's form, A8 ib / A9, a symbol
// included, as clang's.
func Test(a @asm.Assembler, dst Operand, src Operand)

// Inc emits INC dst.
func Inc(a @asm.Assembler, dst Operand)

// Dec emits DEC dst.
func Dec(a @asm.Assembler, dst Operand)

// Neg emits NEG dst (two's complement negate).
func Neg(a @asm.Assembler, dst Operand)

// Not emits NOT dst (one's complement).
func Not(a @asm.Assembler, dst Operand)

// --- Shift ---

// Shl emits SHL dst, count (shift left; SAL is the same instruction).  dst
// is a register or memory operand; count is CL (Reg(RCX, SZ8)) or an imm8 in
// -128..255, a count of 1 taking the short by-1 form (0xD0 / 0xD1), as clang's.
// Any other count, or an out-of-range immediate, sets an assembler error and
// emits nothing.  Shr, Sar, Rol, Ror, Rcl and Rcr take the same operands.
func Shl(a @asm.Assembler, dst Operand, count Operand)

// Shr emits SHR dst, count (logical shift right).
func Shr(a @asm.Assembler, dst Operand, count Operand)

// Sar emits SAR dst, count (arithmetic shift right).
func Sar(a @asm.Assembler, dst Operand, count Operand)

// Rol emits ROL dst, count (rotate left).
func Rol(a @asm.Assembler, dst Operand, count Operand)

// Ror emits ROR dst, count (rotate right).
func Ror(a @asm.Assembler, dst Operand, count Operand)

// Rcl emits RCL dst, count (rotate left through the carry flag).
func Rcl(a @asm.Assembler, dst Operand, count Operand)

// Rcr emits RCR dst, count (rotate right through the carry flag).
func Rcr(a @asm.Assembler, dst Operand, count Operand)

// Shld emits SHLD dst, src, count (double-precision shift left: dst shifted
// left by count, the vacated low bits filled from src's high bits): dst a 16-,
// 32- or 64-bit register or memory operand, src a register of its size, count
// CL or an imm8 in -128..255.  Any other operands set an assembler error and
// emit nothing.
func Shld(a @asm.Assembler, dst Operand, src Operand, count Operand)

// Shrd emits SHRD dst, src, count (double-precision shift right: the vacated
// high bits filled from src's low bits), with Shld's operands.
func Shrd(a @asm.Assembler, dst Operand, src Operand, count Operand)

// --- Multiply ---

// Imul2 emits IMUL dst, src (two-operand signed multiply): dst a
// 16/32/64-bit register, src a register or memory operand.  Any other
// operand kinds, or an 8-bit dst (there is no 8-bit form), set an
// assembler error and emit nothing.
func Imul2(a @asm.Assembler, dst Operand, src Operand)

// Imul3 emits IMUL dst, src, imm (three-operand signed multiply): dst a
// register, src a register or memory operand.  The width is dst.Size;
// there is no 8-bit form.  imm must fit that width: 16-bit
// -32768..65535, 32-bit -2^31..2^32-1, 64-bit -2^31..2^31-1.  Other
// operand kinds, an 8-bit dst or an out-of-range imm sets an assembler
// error and emits nothing.
func Imul3(a @asm.Assembler, dst Operand, src Operand, imm int)

// Imul3Op is Imul3 with its immediate an operand: a number (Imm, Imm64) or a symbol (ImmSym).
func Imul3Op(a @asm.Assembler, dst Operand, src Operand, imm Operand)

// MovAbs emits `movabs dst, src` — REX.W B8+r io: 64-bit register dst from the 64-bit immediate
// src, a number (Imm64, any value) or a symbol (ImmSym, relocated by asm.FIX_DATA_ABS64, a
// thread-local offset by FIX_TPOFF64 / FIX_DTPOFF64); or the moffs form, A0 / A1 / A2 / A3: AL /
// AX / EAX / RAX loaded from or stored to a memory operand at an absolute address — a number
// (MemAbs, MemAddr64) or a symbol (a MemSym with neither base nor index, its FIX_ABS32S
// relocated by asm.FIX_DATA_ABS64, a thread-local offset by FIX_TPOFF64 / FIX_DTPOFF64) — as an
// 8-byte address, whatever its value.  Anything else sets an assembler error and emits nothing.
func MovAbs(a @asm.Assembler, dst Operand, src Operand)

// Idiv emits IDIV src (signed divide RDX:RAX by src).
func Idiv(a @asm.Assembler, src Operand)

// Div emits DIV src (unsigned divide RDX:RAX by src).
func Div(a @asm.Assembler, src Operand)

// Imul1 emits one-operand IMUL src (signed: RDX:RAX = RAX * src at 64 bits,
// EDX:EAX, DX:AX and AX = AL * src at 32, 16 and 8); the high register gets the
// signed multiply-high.
func Imul1(a @asm.Assembler, src Operand)

// Mul1 emits one-operand MUL src (unsigned, at each width as Imul1); the high
// register gets the unsigned multiply-high.
func Mul1(a @asm.Assembler, src Operand)

// Cqo emits CQO (sign-extend RAX into RDX:RAX).
func Cqo(a @asm.Assembler)

// Cdq emits CDQ (sign-extend EAX into EDX:EAX).
func Cdq(a @asm.Assembler)

// Cwd emits CWD (sign-extend AX into DX:AX).
func Cwd(a @asm.Assembler)

// Cbw emits CBW (sign-extend AL into AX).
func Cbw(a @asm.Assembler)

// Cwde emits CWDE (sign-extend AX into EAX).
func Cwde(a @asm.Assembler)

// Cdqe emits CDQE (sign-extend EAX into RAX).
func Cdqe(a @asm.Assembler)

// --- Flags ---

// Clc emits CLC (clear the carry flag).
func Clc(a @asm.Assembler)

// Stc emits STC (set the carry flag).
func Stc(a @asm.Assembler)

// Cmc emits CMC (complement the carry flag).
func Cmc(a @asm.Assembler)

// Cld emits CLD (clear the direction flag).
func Cld(a @asm.Assembler)

// Std emits STD (set the direction flag).
func Std(a @asm.Assembler)

// Lahf emits LAHF (load AH from the flags' low byte).
func Lahf(a @asm.Assembler)

// Sahf emits SAHF (store AH into the flags' low byte).
func Sahf(a @asm.Assembler)

// Pushf emits PUSHF of the flags register at size bits: SZ64 (`pushfq`, 0x9C) or
// SZ16 (`pushfw`, 0x66 0x9C); any other size sets an assembler error and emits
// nothing (64-bit mode has no 32-bit form).
func Pushf(a @asm.Assembler, size int)

// Popf emits POPF of the flags register at size bits, as Pushf (0x9D).
func Popf(a @asm.Assembler, size int)

// --- Branches ---

// Jmp emits JMP label (unconditional near jump).
func Jmp(a @asm.Assembler, label *[]readonly char)

// JmpAddend emits JMP label + addend.
func JmpAddend(a @asm.Assembler, label *[]readonly char, addend int64)

// JmpReg emits JMP reg (indirect jump).
func JmpReg(a @asm.Assembler, reg int)

// Jcc emits a conditional jump: Jcc label.  cc is a CC_* condition
// (0..15); any other value sets an assembler error and emits nothing.
func Jcc(a @asm.Assembler, cc int, label *[]readonly char)

// JccAddend emits Jcc label + addend (cc as for Jcc).
func JccAddend(a @asm.Assembler, cc int, label *[]readonly char, addend int64)

// Jumps to a resolved offset: the byte distance from the start of the jump to its
// target, encoded on the spot (rel8 when it fits a signed byte, else rel32) with no
// fixup; an offset beyond rel32's reach is an assembler error.

// JmpOffset emits JMP to offset: EB rel8, or E9 rel32.
func JmpOffset(a @asm.Assembler, offset int)

// JccOffset emits Jcc (cc as for Jcc) to offset: 70+cc rel8, or 0F 80+cc rel32.
func JccOffset(a @asm.Assembler, cc int, offset int)

// Call emits CALL label (near call).
func Call(a @asm.Assembler, label *[]readonly char)

// CallAddend emits CALL label + addend.
func CallAddend(a @asm.Assembler, label *[]readonly char, addend int64)

// CallReg emits CALL reg (indirect call).
func CallReg(a @asm.Assembler, reg int)

// CallMem emits CALL r/m64 (FF /2): a call to the 64-bit address read from memory operand mem
// (an OP_MEM or a `[rip + label]` but a RipTls, Size SZ64 or 0).  A MemSym of kind FIX_TLSCALL
// is the call through a TLS descriptor, `call qword ptr [rax + sym@tlscall]` (FF 10), with no
// index or displacement and RAX its base — where the `@tlsdesc` load leaves the descriptor and
// the linker's relaxation expects it.  Any other operand sets an assembler error and emits
// nothing (another size: clang's `call dword ptr [rax]` is a far call, FF /3).
func CallMem(a @asm.Assembler, mem Operand)

// JmpMem emits JMP r/m64 (FF /4), mem as for CallMem (but for FIX_TLSCALL, which marks only a
// call).
func JmpMem(a @asm.Assembler, mem Operand)

// Ret emits RET (return from call).
func Ret(a @asm.Assembler)

// RetImm emits `ret imm16` (C2 iw): return from call, then release imm bytes of stack.  imm is
// -32768..65535 (a negative value is its two's-complement word); any other sets an assembler
// error and emits nothing.
func RetImm(a @asm.Assembler, imm int)

// --- Conditional set / zero-extend ---

// Setcc emits `setCC dst8` — store 1 to the low byte of dst (a
// register, or one byte of memory) if the flags satisfy condition cc
// (one of CC_*), else 0.  Always 8-bit regardless of dst.Size.
// Typically followed by Movzx to lift the bool result into a wider
// register.  Any other dst, or a cc outside 0..15, sets an assembler
// error and emits nothing.
func Setcc(a @asm.Assembler, cc int, dst Operand)

// Movzx emits `movzx dst, src` — zero-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider register dst: a
// 16/32/64-bit dst for a byte source, a 32/64-bit dst for a word
// source.  src may be either a register or a memory operand.  Other
// operand kinds or sizes set an assembler error and emit nothing.
func Movzx(a @asm.Assembler, dst Operand, src Operand)

// Movsx emits `movsx dst, src` — sign-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider dst; operands as for
// Movzx.
func Movsx(a @asm.Assembler, dst Operand, src Operand)

// Movsxd emits `movsxd dst, src` — sign-extend a 32-bit register or
// memory source (src.Size=SZ32) into the 64-bit register dst.  REX.W +
// 0x63 /r.  Other operand kinds or sizes set an assembler error and
// emit nothing.
func Movsxd(a @asm.Assembler, dst Operand, src Operand)

// --- Bit instructions ---

// Bt emits BT dst, src (copy bit src of dst to the carry flag): dst a 16-,
// 32- or 64-bit register or memory operand, src a register of its size or an
// imm8 bit offset in -128..255.  Bts, Btr and Btc take the same operands.
// Anything else (an 8-bit form, a symbol as the offset) sets an assembler
// error and emits nothing.
func Bt(a @asm.Assembler, dst Operand, src Operand)

// Bts emits BTS dst, src (test and set the bit).
func Bts(a @asm.Assembler, dst Operand, src Operand)

// Btr emits BTR dst, src (test and clear the bit).
func Btr(a @asm.Assembler, dst Operand, src Operand)

// Btc emits BTC dst, src (test and complement the bit).
func Btc(a @asm.Assembler, dst Operand, src Operand)

// Bsf emits BSF dst, src (the index of src's lowest set bit): dst a 16-, 32-
// or 64-bit register, src a register or memory operand of its size.  Bsr,
// Lzcnt, Tzcnt and Popcnt take the same operands.  Anything else sets an
// assembler error and emits nothing.
func Bsf(a @asm.Assembler, dst Operand, src Operand)

// Bsr emits BSR dst, src (the index of src's highest set bit).
func Bsr(a @asm.Assembler, dst Operand, src Operand)

// Lzcnt emits LZCNT dst, src (src's leading zero bits).
func Lzcnt(a @asm.Assembler, dst Operand, src Operand)

// Tzcnt emits TZCNT dst, src (src's trailing zero bits).
func Tzcnt(a @asm.Assembler, dst Operand, src Operand)

// Popcnt emits POPCNT dst, src (src's set bits).
func Popcnt(a @asm.Assembler, dst Operand, src Operand)

// Bswap emits BSWAP dst (reverse dst's bytes): dst a 32- or 64-bit register
// (the 16-bit form is undefined, which clang rejects).  Anything else sets an
// assembler error and emits nothing.
func Bswap(a @asm.Assembler, dst Operand)

// --- System ---

// Nop emits NOP (single-byte 0x90).
func Nop(a @asm.Assembler)

// NopN emits one n-byte NOP, 1 <= n <= 9, in the form the Intel SDM recommends
// for that length (`nop`, `xchg ax,ax`, then `nopl`/`nopw` with growing
// addressing forms).  An n outside 1..9 sets an assembler error and emits
// nothing.
func NopN(a @asm.Assembler, n int)

// AlignNops pads the current section with executable NOPs (the fewest, each at
// most 9 bytes, via NopN) to the next multiple of alignment, and raises the
// section's alignment to it (as asm.Assembler.Align does).  Unlike zero fill,
// the padding is safe on an executed path — e.g. before a loop header entered
// by fall-through.  alignment must be a positive power of two; otherwise an
// assembler error is set and nothing is emitted.
func AlignNops(a @asm.Assembler, alignment int)

// Syscall emits SYSCALL (0F 05).
func Syscall(a @asm.Assembler)

// Int emits INT imm8 (software interrupt).  vec is an imm8 in -128..255;
// an out-of-range vec sets an assembler error and emits nothing.
func Int(a @asm.Assembler, vec int)

// Ud2 emits UD2 (0F 0B), the defined invalid opcode: it always traps (#UD).
func Ud2(a @asm.Assembler)

// Int3 emits INT3 (CC), the one-byte breakpoint trap (#BP) — not `INT 3`
// (CD 03), which Int emits.
func Int3(a @asm.Assembler)

// Rep_stosb/Rep_stosq: REP STOSB / REP STOSQ — fill RCX bytes/quadwords at [RDI]
// with AL/RAX (the string bulk-fill MemZero primitive).
func Rep_stosb(a @asm.Assembler)

func Rep_stosq(a @asm.Assembler)

// --- Prefixes written as instructions of their own ---

// The segment override prefixes (SegPrefix): es, cs, ss, ds, fs and gs.
const (
	SEG_ES int = 0x26
	SEG_CS int = 0x2E
	SEG_SS int = 0x36
	SEG_DS int = 0x3E
	SEG_FS int = 0x64
	SEG_GS int = 0x65
)

// SegPrefix emits the segment override prefix seg (SEG_*), which applies to the instruction
// after it: an operand's `fs:[...]` is SegPrefix then the instruction, its prefix first,
// before any 0x66 or REX, as clang emits it (`mov ax, word ptr fs:[rbx]` is 64 66 8B 03).
// Any other value sets an assembler error and emits nothing.
func SegPrefix(a @asm.Assembler, seg int)

// Data16 emits the operand-size prefix 0x66 alone (`data16`), as the general-dynamic
// sequence's padding writes it (`data16 lea rdi, [rip + x@TLSGD]`).
func Data16(a @asm.Assembler)

// Rex64 emits the REX.W prefix 0x48 alone (`rex64`), as in the general-dynamic sequence's
// `data16 data16 rex64 call __tls_get_addr@PLT`.
func Rex64(a @asm.Assembler)

// --- x87 load/store (multi-return overflow slots) ---
//
// The only x87 instructions the backend emits: a multi-return tuple with
// more than 2 float fields returns its 3rd/4th float in x87 ST0/ST1, which
// the native x64 pack/collect round-trips through memory.  `mem` must be a
// memory operand (OP_MEM or a RipLabel): a register would select the
// opcode's register form, a different instruction or none (D9 /0 is FLD
// st(i), D9 /3 has none), and any other kind has no encoding here; each sets
// an assembler error and emits nothing.

// Flds emits `flds mem` (D9 /0) — push a 32-bit float onto the x87 stack.
func Flds(a @asm.Assembler, mem Operand)

// Fldl emits `fldl mem` (DD /0) — push a 64-bit float onto the x87 stack.
func Fldl(a @asm.Assembler, mem Operand)

// Fstps emits `fstps mem` (D9 /3) — pop ST0, storing it as a 32-bit float.
func Fstps(a @asm.Assembler, mem Operand)

// Fstpl emits `fstpl mem` (DD /3) — pop ST0, storing it as a 64-bit float.
func Fstpl(a @asm.Assembler, mem Operand)

// --- For the sub-package pkg/binate/asm/x64/sse ---

// EmitRex emits the REX prefix of an instruction whose operand size is 64 bits (w: REX.W) and
// whose ModR/M reg, SIB index and r/m or base registers are r, x and b — bare register numbers,
// 0..15 (an XMM register's masked to its low 4 bits first), REX.R / X / B set for 8..15 — none
// when W is clear and all three are below 8.
func EmitRex(a @asm.Assembler, w bool, r int, x int, b int)

// EmitModRM emits the ModR/M byte, with any SIB byte and displacement, of register or memory
// operand rm (a `[rip + label]` and a MemSym with their fixups), regField its reg field, as
// every encoder here does, for an instruction with nothing after rm (a `[rip + label]`'s rel32
// counts from its own end); a memory operand it cannot encode sets an assembler error.
// EmitModRMImm is it for an instruction whose last field, after rm, is an immBytes-byte
// immediate: the rel32 counts past it, so the fixup's addend is less immBytes.
func EmitModRM(a @asm.Assembler, regField int, rm Operand)

func EmitModRMImm(a @asm.Assembler, regField int, rm Operand, immBytes int)

// IsMem reports whether op is a memory operand: an OP_MEM or a `[rip + label]` (OP_RIPLABEL).
func IsMem(op Operand) bool

// OperandError sets the assembler error "x64: <mnem>: <problem>", as every encoder here reports
// an operand it has no encoding for; KindsError's problem is "unsupported operand kinds".
func OperandError(a @asm.Assembler, mnem *[]readonly char, problem *[]readonly char)

func KindsError(a @asm.Assembler, mnem *[]readonly char)

// Imm8Ok reports whether v fits a fixed imm8 field (a shuffle control): -128..255, a negative
// value its two's-complement byte; else it sets the assembler error "x64: <mnem> <field> out of
// range".
func Imm8Ok(a @asm.Assembler, mnem *[]readonly char, field *[]readonly char, v int) bool

// --- Fixup resolution ---

// ResolveFixups resolves all same-section x86-64 fixups by patching
// instruction bytes. Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool
