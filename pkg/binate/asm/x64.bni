// Package x64 provides x86-64 instruction encoding for the assembler.
// Instructions use Intel syntax (destination first). Register operands
// carry their size (8/16/32/64-bit), which determines the operand size
// prefix and REX.W requirements.
package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// 64-bit general-purpose registers
const (
	RAX int = iota
	RCX
	RDX
	RBX
	RSP
	RBP
	RSI
	RDI
	R8
	R9
	R10
	R11
	R12
	R13
	R14
	R15
)

// 128-bit SSE/AVX registers (XMM0-XMM15).  Held in a disjoint namespace
// from GP regs (offset by 32) so callers can't pass a GP where an XMM
// is expected; the encoders mask with 0xf before emitting.  The offset
// must be a multiple of 16 so n & 0xf yields the bare reg number.
const (
	XMM0 int = iota + 32
	XMM1
	XMM2
	XMM3
	XMM4
	XMM5
	XMM6
	XMM7
	XMM8
	XMM9
	XMM10
	XMM11
	XMM12
	XMM13
	XMM14
	XMM15
)

// Operand sizes (in bits)
const SZ8 int = 8

const SZ16 int = 16

const SZ32 int = 32

const SZ64 int = 64

// Operand kinds
const (
	OP_REG int = iota // register (with size)
	OP_IMM            // immediate value
	OP_MEM            // [base + index*scale + disp]
	OP_LABEL          // label reference (for branches/calls)
	OP_RIPLABEL       // `[rip + label]` — RIP-relative access to a symbol
	// (the Label field carries the symbol).  Mov / Lea route it to
	// MovRipLabel / LeaRipLabel; other instructions reject it.
	OP_RIPGOTLABEL // `[rip + label@GOTPCREL]` — a GOT-indirect LOAD of an
	// external symbol's address (the Label field carries the symbol).  Mov
	// routes it to MovGotPcRel; other instructions reject it.
)

// Condition codes for Jcc/SETcc/CMOVcc
const (
	CC_O int = 0   // overflow
	CC_NO int = 1  // not overflow
	CC_B int = 2   // below (unsigned <) / carry
	CC_AE int = 3  // above or equal (unsigned >=) / not carry
	CC_E int = 4   // equal / zero
	CC_NE int = 5  // not equal / not zero
	CC_BE int = 6  // below or equal (unsigned <=)
	CC_A int = 7   // above (unsigned >)
	CC_S int = 8   // sign (negative)
	CC_NS int = 9  // not sign (positive)
	CC_P int = 10  // parity even
	CC_NP int = 11 // parity odd
	CC_L int = 12  // less (signed <)
	CC_GE int = 13 // greater or equal (signed >=)
	CC_LE int = 14 // less or equal (signed <=)
	CC_G int = 15  // greater (signed >)
)

// Condition code aliases
const CC_C int = 2 // carry (same as B)

const CC_NC int = 3 // not carry (same as AE)

const CC_Z int = 4 // zero (same as E)

const CC_NZ int = 5 // not zero (same as NE)

const CC_NAE int = 2 // not above or equal (same as B)

const CC_NB int = 3 // not below (same as AE)

const CC_NA int = 6 // not above (same as BE)

const CC_NBE int = 7 // not below or equal (same as A)

const CC_NGE int = 12 // not greater or equal (same as L)

const CC_NL int = 13 // not less (same as GE)

const CC_NG int = 14 // not greater (same as LE)

const CC_NLE int = 15 // not less or equal (same as G)

// Fixup kinds for x86-64
const (
	FIX_REL32 int = 300 // 32-bit PC-relative (JMP, Jcc, CALL)
	FIX_ABS64 int = 301 // 64-bit absolute address
	// FIX_REL32_LEA is a 32-bit PC-relative displacement for
	// `lea sym(%rip), %reg` and similar RIP-relative MOV/LEA loads
	// of a data-section symbol's address.  Same bit-level encoding
	// as FIX_REL32, but Mach-O requires X86_64_RELOC_SIGNED here
	// rather than X86_64_RELOC_BRANCH — ld classifies BRANCH as
	// reaching code symbols and miscomputes the displacement when
	// a BRANCH reloc points at a data symbol.  The .data vtable
	// emitted by emitFuncValueVtables / referenced by
	// OP_FUNC_VALUE's RIP-relative LEA hit this.
	FIX_REL32_LEA int = 302
	// FIX_GOTPCREL is the RIP-relative displacement of a `mov r64,
	// [rip + sym@GOTPCREL]` — a GOT-indirect LOAD of an external data
	// symbol's address (e.g. __c_global under PIE, where the datum lives
	// in another DSO and cannot be reached by a direct PC-relative ref).
	// ELF: R_X86_64_REX_GOTPCRELX (the linker-relaxable REX.W form);
	// Mach-O: X86_64_RELOC_GOT_LOAD.  PC-relative (addend -4), like REL32.
	FIX_GOTPCREL int = 303
)

// An operand for x86-64 instructions. The Mem operand encodes the
// full SIB addressing mode: [base + index*scale + disp].
type Operand struct {
	Kind  int
	Reg   int // register number (RAX..R15)
	Size  int // operand size in bits (8, 16, 32, 64)
	Imm   int64 // immediate value (int64 so a 64-bit imm survives on a 32-bit host)
	Base  int // base register for memory (-1 for none)
	Index int // index register for memory (-1 for none)
	Scale int // scale factor (1, 2, 4, 8)
	Disp  int // displacement
	Label @[]char // label name (for LABEL)
}

// --- Operand constructors ---

// Reg creates a register operand with the given size.
func Reg(r int, size int) Operand

// Imm creates an immediate operand from a host-`int` value (widens
// into the int64 Imm field).
func Imm(val int) Operand

// Imm64 creates an immediate operand carrying a full 64-bit value —
// for MOV-imm64 and other encodings whose immediate can exceed 32
// bits, which the `int`-based Imm truncates on a 32-bit host.
func Imm64(val int64) Operand

// Immediate ranges.  An encoder whose immediate is sized by the
// operation width (Add/Sub/And/Or/Xor/Cmp, Test, Mov, Imul3) accepts a
// value representable at that width as a signed or an unsigned number:
//   8-bit:   -128 .. 255
//   16-bit:  -32768 .. 65535
//   32-bit:  -2^31 .. 2^32-1
//   64-bit:  -2^31 .. 2^31-1 (the imm32 is sign-extended to 64 bits;
//            Mov to a 64-bit register takes any int64, see Mov)
// A 16-bit operation takes a 2-byte imm16; the short sign-extended
// imm8 form is chosen when the value at the operation width fits it
// (e.g. a 32-bit 0xFFFFFFF0 is -16).  A fixed imm8 field — a shift
// count, the INT vector, a shuffle control — accepts -128..255 (a
// negative value is its two's-complement byte).  An immediate outside
// its range sets an assembler error (asm.Assembler.HasError) and the
// instruction emits no bytes.
//
// Operand kinds.  Every encoder that takes an Operand checks its
// operands' kinds before emitting anything: an operand kind or kind
// combination the instruction has no encoding for (e.g. mem, mem; an
// immediate, a label or a RIP-label where a register or memory operand
// is required; a register where an SSE / x87 memory form needs memory)
// likewise sets an assembler error and emits nothing.  RIP-label
// operands are encoded, each with its fixup, only by Mov (an
// OP_RIPLABEL source via MovRipLabel, an OP_RIPLABEL destination with a
// register source via MovRipLabelStore, an OP_RIPGOTLABEL source via
// MovGotPcRel) and Lea (an OP_RIPLABEL source via LeaRipLabel); every
// other encoder and operand position rejects them.  A MemDisp operand
// is an ordinary memory operand: `[rip + disp]` with a literal
// displacement and no fixup.
//
// Operand sizes.  Only these encoders check operand sizes: Push / Pop
// (a 16- or 64-bit operand), Lea, Imul2 and Imul3 (no 8-bit
// destination), Movzx / Movsx / Movsxd (a widening size pair), the
// shifts (a register count must be CL, i.e. Reg(RCX, SZ8)), and the
// RIP-label helpers LeaRipLabel / MovRipLabel / MovRipLabelStore /
// MovGotPcRel (the register sizes each lists).  Apart from the Movzx /
// Movsx / Movsxd pair, operand sizes are not checked against each
// other: a two-operand instruction is encoded at its first operand's
// width (the memory operand's for Test reg, mem; the source
// register's for the RIP-label store MovRipLabelStore), so e.g.
// Mov(Mem(RAX, 0, SZ64), Reg(RCX, SZ32)) is the 64-bit store 48 89 08.
// Setcc and the SSE / x87 memory forms ignore the operand's size (the
// instruction fixes the access width).  Elsewhere, outside the checks
// above, a size other than SZ8 / SZ16 / SZ32 / SZ64 is not rejected
// either: it selects the 32-bit form (the 64-bit form for Mov reg,
// imm).  Register numbers and a memory operand's base, index and scale
// are not checked.
//
// Condition codes, the CMPPS / CMPPD predicate and the fixed imm8
// fields are range-checked as noted at each instruction.  A memory
// operand's R8..R15 base or index sets REX.B / REX.X in every encoder.

// Mem creates a memory operand: [base + disp].
func Mem(base int, disp int, size int) Operand

// MemIdx creates a memory operand: [base + index*scale + disp].
func MemIdx(base int, index int, scale int, disp int, size int) Operand

// MemDisp creates a RIP-relative memory operand (base=-1, no index).
func MemDisp(disp int, size int) Operand

// Label creates a label reference operand.
func Label(name *[]readonly char) Operand

// RipGotLabel creates a `[rip + name@GOTPCREL]` operand (OP_RIPGOTLABEL) — a
// GOT-indirect load of an external symbol's address.  As a Mov source it routes
// to MovGotPcRel; other instructions reject it.
func RipGotLabel(name *[]readonly char) Operand

// RipLabel creates a `[rip + name]` RIP-relative operand (OP_RIPLABEL).
// As a Mov / Lea source it routes to MovRipLabel / LeaRipLabel, and as a
// Mov destination to MovRipLabelStore; other instructions reject it.
func RipLabel(name *[]readonly char) Operand

// --- Data movement ---

// Mov emits MOV dst, src.  An immediate src must fit dst's width (see
// "Immediate ranges"): 8-bit -128..255, 16-bit -32768..65535, 32-bit
// -2^31..2^32-1, and a 64-bit memory destination -2^31..2^31-1.  A
// 64-bit register destination takes any int64 (the 10-byte imm64 form
// when it does not fit a sign-extended imm32).  An out-of-range
// immediate sets an assembler error and emits nothing.
func Mov(a @asm.Assembler, dst Operand, src Operand)

// Push emits PUSH src: a 64-bit (or, with 0x66, 16-bit) register or
// memory operand, or an immediate.  An immediate is sign-extended to the
// pushed 64-bit word, so it must lie in -2^31..2^31-1.  An out-of-range
// immediate, an 8/32-bit operand or any other operand kind sets an
// assembler error and emits nothing.
func Push(a @asm.Assembler, src Operand)

// Pop emits POP dst: a 64-bit (or, with 0x66, 16-bit) register or memory
// operand.  Anything else sets an assembler error and emits nothing.
func Pop(a @asm.Assembler, dst Operand)

// Lea emits LEA dst, src (load effective address): dst a 16/32/64-bit
// register, src a memory operand or a RipLabel.  Any other operand kinds,
// or an 8-bit dst (there is no 8-bit LEA), set an assembler error and emit
// nothing.
func Lea(a @asm.Assembler, dst Operand, src Operand)

// LeaRipLabel emits `lea dst, [rip + rel32-to-label]` and adds a
// FIX_REL32_LEA fixup against the named label (relocated as
// R_X86_64_PC32 / X86_64_RELOC_SIGNED).  dst is a 16/32/64-bit register
// (0x66 / none / REX.W); anything else sets an assembler error and emits
// nothing.
func LeaRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char)

// MovRipLabel emits `mov dst, [rip + rel32-to-label]` and adds a
// FIX_REL32_LEA fixup — a direct RIP-relative LOAD of the dst-sized value at
// `label` (the R_X86_64_PC32 sibling of LeaRipLabel, which instead computes
// the address).  dst is an 8/16/32/64-bit register (0x8A / 0x66 0x8B / 0x8B /
// REX.W 0x8B); anything else sets an assembler error and emits nothing.  For
// a GOT-indirect load of an external symbol use MovGotPcRel.
func MovRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char)

// MovRipLabelStore emits `mov [rip + rel32-to-label], src` — a direct
// RIP-relative STORE of the src-sized register into `label` (the store sibling
// of MovRipLabel's load; 0x88 / 0x66 0x89 / 0x89 / REX.W 0x89).  Same
// FIX_REL32_LEA → R_X86_64_PC32 relocation.  src must be an 8/16/32/64-bit
// register: there is no immediate form (its rel32 would not be the last
// field), so an immediate or any other src sets an assembler error and emits
// nothing.
func MovRipLabelStore(a @asm.Assembler, src Operand, label *[]readonly char)

// MovGotPcRel emits `mov dst, [rip + label@GOTPCREL]` (REX.W + 0x8B) and adds
// a FIX_GOTPCREL fixup — a GOT-indirect LOAD that places label's real address
// (the GOT slot's contents) in dst.  It is a MOV, not a LEA: LEA would yield
// the GOT slot's address, not the symbol's.  Used to reach an external data
// symbol under PIE (e.g. __c_global).  dst must be a 64-bit register (the slot
// holds a 64-bit address); anything else sets an assembler error and emits
// nothing.
func MovGotPcRel(a @asm.Assembler, dst Operand, label *[]readonly char)

// --- Arithmetic ---
//
// For Add/Sub/And/Or/Xor/Cmp/Test, an immediate src must fit the
// operation width (see "Immediate ranges"): 8-bit -128..255, 16-bit
// -32768..65535, 32-bit -2^31..2^32-1, 64-bit -2^31..2^31-1.  An
// out-of-range immediate sets an assembler error and emits nothing.

// Add emits ADD dst, src.  Immediate src: see the range note above.
func Add(a @asm.Assembler, dst Operand, src Operand)

// Sub emits SUB dst, src.  Immediate src: see the range note above.
func Sub(a @asm.Assembler, dst Operand, src Operand)

// And emits AND dst, src.  Immediate src: see the range note above.
func And(a @asm.Assembler, dst Operand, src Operand)

// Or emits OR dst, src.  Immediate src: see the range note above.
func Or(a @asm.Assembler, dst Operand, src Operand)

// Xor emits XOR dst, src.  Immediate src: see the range note above.
func Xor(a @asm.Assembler, dst Operand, src Operand)

// Cmp emits CMP dst, src (sets flags, no result stored).  Immediate
// src: see the range note above.
func Cmp(a @asm.Assembler, dst Operand, src Operand)

// Test emits TEST dst, src (AND setting flags, no result stored): r/m,
// reg; reg, mem (encoded as mem, reg — TEST is commutative); or r/m, imm.
// TEST has no sign-extended imm8 form, so an immediate is always
// operation-width (imm8 / imm16 / imm32); its range is as noted above.
func Test(a @asm.Assembler, dst Operand, src Operand)

// Inc emits INC dst.
func Inc(a @asm.Assembler, dst Operand)

// Dec emits DEC dst.
func Dec(a @asm.Assembler, dst Operand)

// Neg emits NEG dst (two's complement negate).
func Neg(a @asm.Assembler, dst Operand)

// Not emits NOT dst (one's complement).
func Not(a @asm.Assembler, dst Operand)

// --- Shift ---

// Shl emits SHL dst, count (shift left).  dst is a register or memory
// operand; count is CL (Reg(RCX, SZ8)) or an imm8 in -128..255.  Any
// other count, or an out-of-range immediate, sets an assembler error and
// emits nothing.  Shr and Sar take the same operands.
func Shl(a @asm.Assembler, dst Operand, count Operand)

// Shr emits SHR dst, count (logical shift right).
func Shr(a @asm.Assembler, dst Operand, count Operand)

// Sar emits SAR dst, count (arithmetic shift right).
func Sar(a @asm.Assembler, dst Operand, count Operand)

// --- Multiply ---

// Imul2 emits IMUL dst, src (two-operand signed multiply): dst a
// 16/32/64-bit register, src a register or memory operand.  Any other
// operand kinds, or an 8-bit dst (there is no 8-bit form), set an
// assembler error and emit nothing.
func Imul2(a @asm.Assembler, dst Operand, src Operand)

// Imul3 emits IMUL dst, src, imm (three-operand signed multiply): dst a
// register, src a register or memory operand.  The width is dst.Size;
// there is no 8-bit form.  imm must fit that width: 16-bit
// -32768..65535, 32-bit -2^31..2^32-1, 64-bit -2^31..2^31-1.  Other
// operand kinds, an 8-bit dst or an out-of-range imm sets an assembler
// error and emits nothing.
func Imul3(a @asm.Assembler, dst Operand, src Operand, imm int)

// Idiv emits IDIV src (signed divide RDX:RAX by src).
func Idiv(a @asm.Assembler, src Operand)

// Div emits DIV src (unsigned divide RDX:RAX by src).
func Div(a @asm.Assembler, src Operand)

// Imul1 emits one-operand IMUL src (RDX:RAX = RAX * src, signed); RDX gets the
// signed multiply-high.
func Imul1(a @asm.Assembler, src Operand)

// Mul1 emits one-operand MUL src (RDX:RAX = RAX * src, unsigned); RDX gets the
// unsigned multiply-high.
func Mul1(a @asm.Assembler, src Operand)

// Cqo emits CQO (sign-extend RAX into RDX:RAX).
func Cqo(a @asm.Assembler)

// Cdq emits CDQ (sign-extend EAX into EDX:EAX).
func Cdq(a @asm.Assembler)

// --- Branches ---

// Jmp emits JMP label (unconditional near jump).
func Jmp(a @asm.Assembler, label *[]readonly char)

// JmpReg emits JMP reg (indirect jump).
func JmpReg(a @asm.Assembler, reg int)

// Jcc emits a conditional jump: Jcc label.  cc is a CC_* condition
// (0..15); any other value sets an assembler error and emits nothing.
func Jcc(a @asm.Assembler, cc int, label *[]readonly char)

// Call emits CALL label (near call).
func Call(a @asm.Assembler, label *[]readonly char)

// CallReg emits CALL reg (indirect call).
func CallReg(a @asm.Assembler, reg int)

// Ret emits RET (return from call).
func Ret(a @asm.Assembler)

// --- Conditional set / zero-extend ---

// Setcc emits `setCC dst8` — store 1 to the low byte of dst (a
// register, or one byte of memory) if the flags satisfy condition cc
// (one of CC_*), else 0.  Always 8-bit regardless of dst.Size.
// Typically followed by Movzx to lift the bool result into a wider
// register.  Any other dst, or a cc outside 0..15, sets an assembler
// error and emits nothing.
func Setcc(a @asm.Assembler, cc int, dst Operand)

// Movzx emits `movzx dst, src` — zero-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider register dst: a
// 16/32/64-bit dst for a byte source, a 32/64-bit dst for a word
// source.  src may be either a register or a memory operand.  Other
// operand kinds or sizes set an assembler error and emit nothing.
func Movzx(a @asm.Assembler, dst Operand, src Operand)

// Movsx emits `movsx dst, src` — sign-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider dst; operands as for
// Movzx.
func Movsx(a @asm.Assembler, dst Operand, src Operand)

// Movsxd emits `movsxd dst, src` — sign-extend a 32-bit register or
// memory source (src.Size=SZ32) into the 64-bit register dst.  REX.W +
// 0x63 /r.  Other operand kinds or sizes set an assembler error and
// emit nothing.
func Movsxd(a @asm.Assembler, dst Operand, src Operand)

// --- System ---

// Nop emits NOP (single-byte 0x90).
func Nop(a @asm.Assembler)

// Syscall emits SYSCALL (0F 05).
func Syscall(a @asm.Assembler)

// Int emits INT imm8 (software interrupt).  vec is an imm8 in -128..255;
// an out-of-range vec sets an assembler error and emits nothing.
func Int(a @asm.Assembler, vec int)

// --- SSE2 scalar floating-point ---
//
// The float lowering strategy mirrors aarch64's: all SSA values
// (including floats) live in GP regs / spill slots; XMM regs only
// "light up" for the duration of one FP instruction, with the value
// MOVQ'd in from a GP scratch and back out.  No separate FP regalloc.
// XMM args take XMM register numbers (XMM0..XMM15); GP args take GP
// register numbers (RAX..R15).

// Movq_gp_to_xmm emits `movq xmm, gp` — load the full 64-bit value
// from a GP register into the low quadword of xmm (high quadword
// zeroed).  Used to bring a spilled float bit-pattern into an XMM
// scratch.  Encoding: 66 REX.W 0F 6E /r.
func Movq_gp_to_xmm(a @asm.Assembler, xmm int, gp int)

// Movq_xmm_to_gp emits `movq gp, xmm` — store the low quadword of
// xmm into a 64-bit GP register.  Mirror of Movq_gp_to_xmm.
// Encoding: 66 REX.W 0F 7E /r.
func Movq_xmm_to_gp(a @asm.Assembler, gp int, xmm int)

// Movd_gp_to_xmm emits `movd xmm, gp32` — load 32 bits from a GP
// register into the low dword of xmm (upper 96 bits zeroed).  Used
// for float32 transit.  Encoding: 66 0F 6E /r (no REX.W).
func Movd_gp_to_xmm(a @asm.Assembler, xmm int, gp int)

// Movd_xmm_to_gp emits `movd gp32, xmm` — store the low dword of
// xmm into a 32-bit GP register.  Encoding: 66 0F 7E /r.
func Movd_xmm_to_gp(a @asm.Assembler, gp int, xmm int)

// SSE memory forms (Movlps_*, Movups_*, Movss_* here; Movdqu_* / Movdqa_*
// below): `mem` must be a memory operand (OP_MEM).  A register would select
// the opcode's register form, a different instruction or none (0F 12 is
// MOVHLPS, 0F 13 has none), and a RipLabel or any other kind has no encoding
// here; each sets an assembler error and emits nothing.

// Movlps_load / Movlps_store move an 8-byte SSE eightbyte (packed 2xf32 or a
// lone f64) between an XMM low quadword and a memory image (SysV aggregate
// pass/return).  Encodings: 0F 12 /r (load), 0F 13 /r (store).
func Movlps_load(a @asm.Assembler, xmm int, mem Operand)

func Movlps_store(a @asm.Assembler, mem Operand, xmm int)

// Movups_load / Movups_store move a full (unaligned) 16-byte SSE register
// between an XMM and a memory image — two words per instruction, for aggregate
// copies.  Encodings: 0F 10 /r (load), 0F 11 /r (store); the address need not be
// 16-byte aligned.
func Movups_load(a @asm.Assembler, xmm int, mem Operand)

func Movups_store(a @asm.Assembler, mem Operand, xmm int)

// Movss_load / Movss_store move a 4-byte lone-f32 eightbyte between an XMM low
// dword and a memory image.  Encodings: F3 0F 10 /r (load), F3 0F 11 /r (store).
func Movss_load(a @asm.Assembler, xmm int, mem Operand)

func Movss_store(a @asm.Assembler, mem Operand, xmm int)

// Addsd emits `addsd xmm_dst, xmm_src` (double-precision scalar add).
// Encoding: F2 0F 58 /r.
func Addsd(a @asm.Assembler, dst int, src int)

// Subsd emits `subsd xmm_dst, xmm_src`.  Encoding: F2 0F 5C /r.
func Subsd(a @asm.Assembler, dst int, src int)

// Mulsd emits `mulsd xmm_dst, xmm_src`.  Encoding: F2 0F 59 /r.
func Mulsd(a @asm.Assembler, dst int, src int)

// Divsd emits `divsd xmm_dst, xmm_src`.  Encoding: F2 0F 5E /r.
func Divsd(a @asm.Assembler, dst int, src int)

// Addss / Subss / Mulss / Divss: single-precision (float32) scalar
// arithmetic — the double opcodes with the F3 prefix instead of F2.
func Addss(a @asm.Assembler, dst int, src int)

func Subss(a @asm.Assembler, dst int, src int)

func Mulss(a @asm.Assembler, dst int, src int)

func Divss(a @asm.Assembler, dst int, src int)

// Cvtsi2sd emits `cvtsi2sd xmm_dst, gp64` — convert a signed 64-bit
// integer to a double-precision float.  Encoding: F2 REX.W 0F 2A /r.
func Cvtsi2sd(a @asm.Assembler, xmm int, gp int)

// Cvttsd2si emits `cvttsd2si gp64, xmm_src` — convert a double to
// a signed 64-bit integer with truncation (round-toward-zero).
// Encoding: F2 REX.W 0F 2C /r.
func Cvttsd2si(a @asm.Assembler, gp int, xmm int)

// Cvtss2sd emits `cvtss2sd xmm_dst, xmm_src` — widen float32 (low
// dword) to float64.  Encoding: F3 0F 5A /r.
func Cvtss2sd(a @asm.Assembler, dst int, src int)

// Cvtsd2ss emits `cvtsd2ss xmm_dst, xmm_src` — narrow float64 to
// float32 (low dword).  Encoding: F2 0F 5A /r.
func Cvtsd2ss(a @asm.Assembler, dst int, src int)

// Movapd emits `movapd xmm_dst, xmm_src` — register-register move
// of a packed double (used here to copy whole 128 bits between XMM
// scratches; same bit-level effect as MOVSD for our usage).
// Encoding: 66 0F 28 /r.
func Movapd(a @asm.Assembler, dst int, src int)

// Ucomisd emits `ucomisd xmm_lhs, xmm_rhs` — unordered scalar-double
// compare.  Sets EFLAGS: CF=1 iff lhs < rhs OR unordered; ZF=1 iff
// lhs == rhs OR unordered; PF=1 iff unordered (NaN operand).
// Encoding: 66 0F 2E /r.
func Ucomisd(a @asm.Assembler, lhs int, rhs int)

// Ucomiss is the single-precision (float32) sibling of Ucomisd — same
// EFLAGS semantics, encoding 0F 2E /r (no mandatory prefix).
func Ucomiss(a @asm.Assembler, lhs int, rhs int)

// --- SSE2 packed integer + bitwise (reg-reg; dst is also first source) ---
// See x64_sse.bn.  All operate lane-wise on the full 128-bit XMM registers.

// Paddb/Paddw/Paddd/Paddq: packed integer add over 8/16/32/64-bit lanes.
func Paddb(a @asm.Assembler, dst int, src int)

func Paddw(a @asm.Assembler, dst int, src int)

func Paddd(a @asm.Assembler, dst int, src int)

func Paddq(a @asm.Assembler, dst int, src int)

// Psubb/Psubw/Psubd/Psubq: packed integer subtract over 8/16/32/64-bit lanes.
func Psubb(a @asm.Assembler, dst int, src int)

func Psubw(a @asm.Assembler, dst int, src int)

func Psubd(a @asm.Assembler, dst int, src int)

func Psubq(a @asm.Assembler, dst int, src int)

// Pmullw: packed 16-bit multiply (low halves).  Pmulld: packed 32-bit multiply
// (low halves; SSE4.1).
func Pmullw(a @asm.Assembler, dst int, src int)

func Pmulld(a @asm.Assembler, dst int, src int)

// Pand/Por/Pxor/Pandn: whole-register bitwise AND/OR/XOR/AND-NOT (dst = ~dst &
// src for Pandn).  Pxor(x, x) zeroes a register.
func Pand(a @asm.Assembler, dst int, src int)

func Por(a @asm.Assembler, dst int, src int)

func Pxor(a @asm.Assembler, dst int, src int)

func Pandn(a @asm.Assembler, dst int, src int)

// --- SSE/SSE2 packed floating-point (reg-reg; dst is also first source) ---
// See x64_sse_fp.bn.  …PS forms take no prefix (f32 lanes); …PD forms take 0x66
// (f64 lanes).

// Addps/Addpd/Subps/Subpd/Mulps/Mulpd/Divps/Divpd: packed FP arithmetic.
func Addps(a @asm.Assembler, dst int, src int)

func Addpd(a @asm.Assembler, dst int, src int)

func Subps(a @asm.Assembler, dst int, src int)

func Subpd(a @asm.Assembler, dst int, src int)

func Mulps(a @asm.Assembler, dst int, src int)

func Mulpd(a @asm.Assembler, dst int, src int)

func Divps(a @asm.Assembler, dst int, src int)

func Divpd(a @asm.Assembler, dst int, src int)

// Minps/Minpd/Maxps/Maxpd: packed FP min/max.  Sqrtps/Sqrtpd: packed FP sqrt
// (dst = sqrt(src)).
func Minps(a @asm.Assembler, dst int, src int)

func Minpd(a @asm.Assembler, dst int, src int)

func Maxps(a @asm.Assembler, dst int, src int)

func Maxpd(a @asm.Assembler, dst int, src int)

func Sqrtps(a @asm.Assembler, dst int, src int)

func Sqrtpd(a @asm.Assembler, dst int, src int)

// Packed-compare predicates (the imm8 of CMPPS/CMPPD).
const (
	CMPP_EQ int = iota // equal (ordered, non-signalling)
	CMPP_LT            // less-than (ordered, signalling)
	CMPP_LE            // less-or-equal (ordered, signalling)
	CMPP_UNORD         // unordered
	CMPP_NEQ           // not-equal (unordered, non-signalling)
	CMPP_NLT           // not-less-than (unordered, signalling)
	CMPP_NLE           // not-less-or-equal (unordered, signalling)
	CMPP_ORD           // ordered
)

// Cmpps/Cmppd: packed FP compare; `pred` (CMPP_*) selects the comparison and
// each lane becomes all-ones/all-zeros.  The legacy-SSE encoding reads only
// imm8[2:0], so a pred outside CMPP_EQ..CMPP_ORD (0..7) sets an assembler
// error and emits nothing.
func Cmpps(a @asm.Assembler, dst int, src int, pred int)

func Cmppd(a @asm.Assembler, dst int, src int, pred int)

// Andps/Andpd/Andnps/Andnpd/Orps/Orpd/Xorps/Xorpd: FP-domain bitwise (AND,
// AND-NOT = ~dst & src, OR, XOR).
func Andps(a @asm.Assembler, dst int, src int)

func Andpd(a @asm.Assembler, dst int, src int)

func Andnps(a @asm.Assembler, dst int, src int)

func Andnpd(a @asm.Assembler, dst int, src int)

func Orps(a @asm.Assembler, dst int, src int)

func Orpd(a @asm.Assembler, dst int, src int)

func Xorps(a @asm.Assembler, dst int, src int)

func Xorpd(a @asm.Assembler, dst int, src int)

// --- SSE2 packed 128-bit moves + string fill ---
// See x64_sse_mem.bn.

// Movdqu/Movdqa/Movaps: 128-bit register copy (unaligned int / aligned int /
// packed FP).
func Movdqu(a @asm.Assembler, dst int, src int)

func Movdqa(a @asm.Assembler, dst int, src int)

func Movaps(a @asm.Assembler, dst int, src int)

// Movdqu_load/Movdqu_store: unaligned 128-bit load/store to/from memory.  For
// these and Movdqa_*, `mem` must be a memory operand (see the SSE memory forms
// note above).
func Movdqu_load(a @asm.Assembler, xmm int, mem Operand)

func Movdqu_store(a @asm.Assembler, mem Operand, xmm int)

// Movdqa_load/Movdqa_store: 16-byte-aligned 128-bit load/store.
func Movdqa_load(a @asm.Assembler, xmm int, mem Operand)

func Movdqa_store(a @asm.Assembler, mem Operand, xmm int)

// Rep_stosb/Rep_stosq: REP STOSB / REP STOSQ — fill RCX bytes/quadwords at [RDI]
// with AL/RAX (the string bulk-fill MemZero primitive).
func Rep_stosb(a @asm.Assembler)

func Rep_stosq(a @asm.Assembler)

// --- SSE shuffle / broadcast / interleave ---
// See x64_sse_shuf.bn.

// Pshufd: shuffle/broadcast the 4 dwords per imm8 (imm8=0 broadcasts lane 0).
// For Pshufd/Shufps/Shufpd, imm8 is in -128..255; an out-of-range control
// sets an assembler error and emits nothing.
func Pshufd(a @asm.Assembler, dst int, src int, imm8 int)

// Shufps/Shufpd: packed FP shuffle per imm8.
func Shufps(a @asm.Assembler, dst int, src int, imm8 int)

func Shufpd(a @asm.Assembler, dst int, src int, imm8 int)

// Movddup: broadcast src's low f64 to both lanes.
func Movddup(a @asm.Assembler, dst int, src int)

// Punpckldq/Punpckhdq/Punpcklqdq/Punpckhqdq: interleave low/high dword/qword lanes.
func Punpckldq(a @asm.Assembler, dst int, src int)

func Punpckhdq(a @asm.Assembler, dst int, src int)

func Punpcklqdq(a @asm.Assembler, dst int, src int)

func Punpckhqdq(a @asm.Assembler, dst int, src int)

// Unpcklps/Unpckhps/Unpcklpd/Unpckhpd: interleave low/high f32/f64 lanes.
func Unpcklps(a @asm.Assembler, dst int, src int)

func Unpckhps(a @asm.Assembler, dst int, src int)

func Unpcklpd(a @asm.Assembler, dst int, src int)

func Unpckhpd(a @asm.Assembler, dst int, src int)

// Pshufb: arbitrary byte shuffle of dst per src's index bytes (SSSE3).
func Pshufb(a @asm.Assembler, dst int, src int)

// --- x87 load/store (multi-return overflow slots) ---
//
// The only x87 instructions the backend emits: a multi-return tuple with
// more than 2 float fields returns its 3rd/4th float in x87 ST0/ST1, which
// the native x64 pack/collect round-trips through memory.  `mem` must be a
// memory operand (OP_MEM): a register would select the opcode's register
// form, a different instruction or none (D9 /0 is FLD st(i), D9 /3 has
// none), and a RipLabel or any other kind has no encoding here; each sets an
// assembler error and emits nothing.

// Flds emits `flds mem` (D9 /0) — push a 32-bit float onto the x87 stack.
func Flds(a @asm.Assembler, mem Operand)

// Fldl emits `fldl mem` (DD /0) — push a 64-bit float onto the x87 stack.
func Fldl(a @asm.Assembler, mem Operand)

// Fstps emits `fstps mem` (D9 /3) — pop ST0, storing it as a 32-bit float.
func Fstps(a @asm.Assembler, mem Operand)

// Fstpl emits `fstpl mem` (DD /3) — pop ST0, storing it as a 64-bit float.
func Fstpl(a @asm.Assembler, mem Operand)

// --- Fixup resolution ---

// ResolveFixups resolves all same-section x86-64 fixups by patching
// instruction bytes. Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool
