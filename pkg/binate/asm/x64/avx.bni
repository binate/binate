// Package avx provides the x86-64 VEX-encoded vector instructions — AVX and its extensions —
// with AVX-512's EVEX-encoded forms of them and its mask instructions, and AMD's XOP-encoded ones,
// as an instruction table by mnemonic, as clang takes them in Intel syntax (Has, Emit, with x64
// operands): XMM registers (sse.Xmm, Xmm), YMM registers (Ymm), ZMM registers (Zmm), mask registers
// (K), memory (a 256-bit operand is x64.SZ256, a 512-bit one x64.SZ512; a gather's or a scatter's
// has a vector index, x64.MemVsib), general registers, immediates and EVEX's rounding operands
// (x64.Round).  Each form is a VEX prefix (pkg/binate/asm/x64/vex), XOP's 8F or an EVEX prefix
// (pkg/binate/asm/x64/evex), its opcode, ModR/M with the r/m operand (an EVEX form's displacement
// compressed, x64.EmitModRMN), then an imm8: a register in imm8[7:4] (with an imm4 in imm8[3:0],
// vpermil2ps's), or an immediate.  Where several forms fit the operands, the one encoded is a VEX
// or XOP one where one fits, as clang: the first, unless a later one holds every field of the
// two-byte prefix C5 where the first does not, as clang chooses (a commutative instruction's
// sources swapped, a move between registers in its store form), and the first after `{vex3}`
// (asm.Assembler.X64Vex 3); else, or after `{evex}` (X64Vex 4), the first EVEX one — which comes
// first for the instructions clang encodes as EVEX unless `{vex}` is written (vpdpbusd ..,
// vpmadd52luq / huq).
package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// 256-bit AVX registers (YMM0-YMM15), in a namespace of their own as the XMM registers are
// (sse.XMM0); the table takes them as x64.Reg(YMM0 + i, x64.SZ256).  The offset is a multiple of
// 16, and leaves 48..63 for XMM16..XMM31 (after XMM0..XMM15) and 112..127 for YMM16..YMM31.
const (
	YMM0 int = iota + 96
	YMM1
	YMM2
	YMM3
	YMM4
	YMM5
	YMM6
	YMM7
	YMM8
	YMM9
	YMM10
	YMM11
	YMM12
	YMM13
	YMM14
	YMM15
)

// Ymm returns YMMi (0..31) as the table takes it: x64.Reg(YMM0 + i, x64.SZ256) below 16,
// x64.Reg(YMM16 + i - 16, x64.SZ256) above; past 31 or below 0, a register no form takes.
func Ymm(i int) x64.Operand

// IsYmm reports whether op is a YMM register operand, YMM0..YMM15.
func IsYmm(op x64.Operand) bool

// AVX-512's registers, each set in a namespace of its own as the XMM and YMM registers are: XMM16
// .. XMM31 (XMMi at XMM16 + i - 16, after sse's XMM0 .. XMM15), YMM16 .. YMM31 (YMMi at YMM16 + i -
// 16), ZMM0 .. ZMM31 (ZMMi at ZMM0 + i) and the mask registers K0 .. K7 (ki at K0 + i).
const (
	XMM16 int = 48
	YMM16 int = 112
	ZMM0 int = 128
	K0 int = 160
)

// Xmm returns XMMi (0..31) as the table takes it: sse.Xmm(i) below 16, x64.Reg(XMM16 + i - 16,
// x64.SZ128) above; past 31 or below 0, a register no form takes.
func Xmm(i int) x64.Operand

// Zmm returns ZMMi (0..31) as the table takes it, x64.Reg(ZMM0 + i, x64.SZ512); past 31 or below 0,
// a register no form takes.
func Zmm(i int) x64.Operand

// K returns the mask register ki (0..7) as the table takes it, x64.Reg(K0 + i, x64.SZ64); past 7 or
// below 0, a register no form takes.
func K(i int) x64.Operand

// Has reports whether the table has mnem (in any case) — or it is a compare predicate's name
// (vcmpeqps .. vcmptrue_ussh: vcmpps, vcmppd, vcmpph, vcmpss, vcmpsd or vcmpsh with the predicate's
// number), a CLMUL one (vpclmullqlqdq .. vpclmulhqhqdq: vpclmulqdq with the halves' selector), an
// XOP compare's (vpcomltb .. vpcomtrueuq: vpcomb .. vpcomuq with the predicate's number) or an
// AVX-512 integer compare's (vpcmpltb .. vpcmpnleuq: vpcmpb .. vpcmpuq with the predicate's number;
// vpcmpeqb .. q are instructions of their own).
func Has(mnem *[]readonly char) bool

// Emit emits mnem with its operands ops, in Intel order: vector registers (sse.Xmm, Xmm, Ymm, Zmm),
// mask registers (K), general registers, memory, EVEX's rounding operands (x64.Round) and
// immediates, each an imm8 (-128..255) or a symbol (x64.ImmSym) — but vpermil2ps / pd's last, a
// number 0..15 (imm8[3:0]) — with EVEX's decorations (x64.Operand's Mask, Zero and Bcst): a write
// mask, and zeroing beside it, on the first operand, a broadcast on memory.  It reports whether the
// table has mnem (Has), emitting nothing and setting no error when it does not.  Operands no form
// of mnem fits set an assembler error and emit nothing (a memory operand's own checks run as it is
// encoded, x64.EmitModRM, x64.EmitModRMN or, with a vector index, x64.EmitModRMVsib; an immediate
// past 8 bits, or vpermil2ps's past 0..15, is an error), as do a compare predicate's name with
// other than three operands (and `{sae}` after them), memory of no size where only its size would
// choose the form (`vcvtpd2ps xmm0, [rax]`), memory with a vector index (x64.IsVsib) in any
// instruction but a gather or scatter, a gather whose destination, index and mask registers are not
// all different (the CPU faults on it), an EVEX gather or scatter without its write mask, an FP16
// complex multiply (vfmulcph .. vfcmaddcsh) whose destination is one of its sources (the CPU
// faults; as GNU as), zeroing without a write mask (as GNU as; clang drops the zeroing), an
// instruction with no EVEX form after `{evex}` (asm.Assembler.X64Vex 4), and, unless `{vex}`,
// `{vex2}` or `{vex3}` is written (X64Vex 2 or 3, which leave out the EVEX forms), vcvtneps2bf16,
// which clang encodes otherwise as AVX-512's EVEX form, not here yet.
func Emit(a @asm.Assembler, mnem *[]readonly char, ops *[]x64.Operand) bool
