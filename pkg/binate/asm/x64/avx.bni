// Package avx provides the x86-64 VEX-encoded vector instructions — AVX and its extensions — as
// an instruction table by mnemonic, as clang takes them in Intel syntax (Has, Emit, with x64
// operands): XMM registers (sse.Xmm), YMM registers (Ymm), memory (a 256-bit operand is x64.SZ256),
// general registers and immediates. Each form is a VEX prefix (pkg/binate/asm/x64/vex), its opcode,
// ModR/M with the r/m operand, then a register in imm8[7:4] or an imm8. Where several forms fit the
// operands, the one encoded is the first, as clang, unless a later one holds every field of the
// two-byte prefix C5 where the first does not, as clang chooses: a commutative instruction's
// sources swapped, a move between registers in its store form. After `{vex3}`
// (asm.Assembler.X64Vex3) it is the first.
package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// 256-bit AVX registers (YMM0-YMM15), in a namespace of their own as the XMM registers are
// (sse.XMM0); the table takes them as x64.Reg(YMM0 + i, x64.SZ256).  The offset is a multiple of
// 16, and leaves 48..63 for XMM16..XMM31 (after XMM0..XMM15) and 112..127 for YMM16..YMM31.
const (
	YMM0 int = iota + 96
	YMM1
	YMM2
	YMM3
	YMM4
	YMM5
	YMM6
	YMM7
	YMM8
	YMM9
	YMM10
	YMM11
	YMM12
	YMM13
	YMM14
	YMM15
)

// Ymm returns YMMi as the table takes it, x64.Reg(YMM0 + i, x64.SZ256); past 15 or below 0, a
// register no form takes.
func Ymm(i int) x64.Operand

// IsYmm reports whether op is a YMM register operand, YMM0..YMM15.
func IsYmm(op x64.Operand) bool

// Has reports whether the table has mnem (in any case) — or it is a compare predicate's name
// (vcmpeqps .. vcmptrue_ussd: vcmpps, vcmppd, vcmpss or vcmpsd with the predicate's number).
func Has(mnem *[]readonly char) bool

// Emit emits mnem with its operands ops, in Intel order: XMM registers (sse.Xmm), YMM registers
// (Ymm), general registers, memory and immediates, each an imm8 (-128..255) or a symbol
// (x64.ImmSym).  It reports whether the table has mnem (Has), emitting nothing and setting no
// error when it does not.  Operands no form of mnem fits set an assembler error and emit nothing
// (a memory operand's own checks run as it is encoded, x64.EmitModRM; an immediate past 8 bits is
// an error), as do a compare predicate's name with other than three operands, and memory of no
// size where only its size would choose the form (`vcvtpd2ps xmm0, [rax]`).
func Emit(a @asm.Assembler, mnem *[]readonly char, ops *[]x64.Operand) bool
