package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64/optab"

// The names that stand for an instruction of the table with a fixed immediate: the compare
// predicates' (vcmpeqps .. vcmptrue_ussh: vcmpps, vcmppd, vcmpph, vcmpss, vcmpsd or vcmpsh with the
// predicate's number), CLMUL's (vpclmullqlqdq .. vpclmulhqhqdq: vpclmulqdq with the halves'
// selector), XOP's compares' (vpcomltb .. vpcomtrueuq: vpcomb .. vpcomuq with the predicate's
// number) and AVX-512's integer compares' (vpcmpltb .. vpcmpnleuq: vpcmpb .. vpcmpuq with the
// predicate's number).

// predicates is the compare predicates' list, a predicate's position its number (0..31).
func predicates() *[]readonly char {
	return " eq lt le unord neq nlt nle ord eq_uq nge ngt false neq_oq ge gt true eq_os lt_oq le_oq "
			"unord_s neq_us nlt_uq nle_uq ord_s eq_us nge_uq ngt_uq false_os neq_os ge_oq gt_oq "
			"true_us "
}

// predicatesAlt is the predicates' second names, as clang takes them, a name's position its
// number (0..15; - where a number has none).
func predicatesAlt() *[]readonly char {
	return " eq_oq lt_os le_os unord_q neq_uq nlt_us nle_us ord_q - nge_us ngt_us false_oq - ge_os "
			"gt_os true_uq "
}

// wordAt returns the position in list (words between single spaces, a space first and last) of
// word, matched in any case, or -1.
func wordAt(list *[]readonly char, word *[]readonly char) int {
	var idx int = 0
	var start int = 1
	for i := 1; i < len(list); i++ {
		if list[i] != ' ' { continue }
		if i - start == len(word) {
			var k int = 0
			for k < len(word) && optab.Lower(word[k]) == list[start + k] { k++ }
			if k == len(word) { return idx }
		}
		idx++
		start = i + 1
	}
	return -1
}

// predAlias returns the instruction a compare predicate's name (vcmpeqps .. vcmptrue_ussh) stands
// for — vcmpps, vcmpss, vcmppd, vcmpsd, or FP16's vcmpph or vcmpsh — and its predicate's
// number, or "" and -1 for another name.
func predAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var n int = len(mnem)
	if n < 8 || optab.Lower(mnem[0]) != 'v' || optab.Lower(mnem[1]) != 'c' ||
			optab.Lower(mnem[2]) != 'm' || optab.Lower(mnem[3]) != 'p' {
		return "", -1
	}
	var s0 char = optab.Lower(mnem[n - 2])
	var s1 char = optab.Lower(mnem[n - 1])
	var base *[]readonly char = ""
	if s0 == 'p' && s1 == 's' { base = "vcmpps" }
	if s0 == 's' && s1 == 's' { base = "vcmpss" }
	if s0 == 'p' && s1 == 'd' { base = "vcmppd" }
	if s0 == 's' && s1 == 'd' { base = "vcmpsd" }
	if s0 == 'p' && s1 == 'h' { base = "vcmpph" }
	if s0 == 's' && s1 == 'h' { base = "vcmpsh" }
	if len(base) == 0 { return "", -1 }
	var pred *[]readonly char = mnem[4:n - 2]
	var num int = wordAt(predicates(), pred)
	if num < 0 && !(len(pred) == 1 && pred[0] == '-') { num = wordAt(predicatesAlt(), pred) }
	if num < 0 { return "", -1 }
	return base, num
}

// pclmulAlias returns vpclmulqdq and the selector a CLMUL name (vpclmullqlqdq, vpclmulhqlqdq,
// vpclmullqhqdq, vpclmulhqhqdq) stands for — bit 0 the first source's quadword, bit 4 the
// second's — or "" and -1 for another name.
func pclmulAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var num int = wordAt(" vpclmullqlqdq vpclmulhqlqdq vpclmullqhqdq vpclmulhqhqdq ", mnem)
	if num < 0 { return "", -1 }
	return "vpclmulqdq", (num & 1) | ((num & 2) << 3)
}

// vpcomAlias returns the instruction an XOP compare predicate's name (vpcomltb .. vpcomtrueuq)
// stands for — vpcomb, vpcomw, vpcomd, vpcomq or their unsigned vpcomub .. vpcomuq — and its
// predicate's number, or "" and -1 for another name.
func vpcomAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var n int = len(mnem)
	if n < 8 || optab.Lower(mnem[0]) != 'v' || optab.Lower(mnem[1]) != 'p' ||
			optab.Lower(mnem[2]) != 'c' || optab.Lower(mnem[3]) != 'o' || optab.Lower(mnem[4]) != 'm' {
		return "", -1
	}
	var suf int = 1
	if optab.Lower(mnem[n - 2]) == 'u' { suf = 2 }
	var size int = wordAt(" b w d q ", mnem[n - 1:n])
	if size < 0 { return "", -1 }
	var num int = wordAt(" lt le gt ge eq neq false true ", mnem[5:n - suf])
	if num < 0 { return "", -1 }
	if suf == 2 { return unsignedVpcom(size), num }
	return signedVpcom(size), num
}

// signedVpcom returns vpcomb, vpcomw, vpcomd or vpcomq for an element size of 0..3.
func signedVpcom(size int) *[]readonly char {
	if size == 0 { return "vpcomb" }
	if size == 1 { return "vpcomw" }
	if size == 2 { return "vpcomd" }
	return "vpcomq"
}

// unsignedVpcom returns vpcomub, vpcomuw, vpcomud or vpcomuq for an element size of 0..3.
func unsignedVpcom(size int) *[]readonly char {
	if size == 0 { return "vpcomub" }
	if size == 1 { return "vpcomuw" }
	if size == 2 { return "vpcomud" }
	return "vpcomuq"
}

// vpcmpAlias returns the instruction an AVX-512 integer compare predicate's name stands for —
// vpcmp<p><t>, p eq (0; with a signed type an instruction of its own, vpcmpeqb), lt (1), le (2),
// neq (4), nlt (5) or nle (6), t b, w, d, q or the unsigned ub, uw, ud, uq: vpcmp<t> — and its
// predicate's number, or "" and -1 for another name.
func vpcmpAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var n int = len(mnem)
	if n < 8 || optab.Lower(mnem[0]) != 'v' || optab.Lower(mnem[1]) != 'p' ||
			optab.Lower(mnem[2]) != 'c' || optab.Lower(mnem[3]) != 'm' || optab.Lower(mnem[4]) != 'p' {
		return "", -1
	}
	var suf int = 1
	if optab.Lower(mnem[n - 2]) == 'u' { suf = 2 }
	var size int = wordAt(" b w d q ", mnem[n - 1:n])
	if size < 0 { return "", -1 }
	var num int = wordAt(" eq lt le - neq nlt nle ", mnem[5:n - suf])
	if num < 0 || (num == 0 && suf == 1) { return "", -1 }
	if suf == 2 { return unsignedVpcmp(size), num }
	return signedVpcmp(size), num
}

// signedVpcmp returns vpcmpb, vpcmpw, vpcmpd or vpcmpq for an element size of 0..3.
func signedVpcmp(size int) *[]readonly char {
	if size == 0 { return "vpcmpb" }
	if size == 1 { return "vpcmpw" }
	if size == 2 { return "vpcmpd" }
	return "vpcmpq"
}

// unsignedVpcmp returns vpcmpub, vpcmpuw, vpcmpud or vpcmpuq for an element size of 0..3.
func unsignedVpcmp(size int) *[]readonly char {
	if size == 0 { return "vpcmpub" }
	if size == 1 { return "vpcmpuw" }
	if size == 2 { return "vpcmpud" }
	return "vpcmpuq"
}

// aliasOf returns the instruction of the table the name mnem stands for and its immediate
// (predAlias, pclmulAlias, vpcomAlias, vpcmpAlias), or "" and -1 for another name.
func aliasOf(mnem *[]readonly char) (*[]readonly char, int) {
	base, imm := predAlias(mnem)
	if imm >= 0 { return base, imm }
	base, imm = pclmulAlias(mnem)
	if imm >= 0 { return base, imm }
	base, imm = vpcmpAlias(mnem)
	if imm >= 0 { return base, imm }
	return vpcomAlias(mnem)
}
