package "pkg/binate/asm/x64/avx"

import "pkg/builtins/testing"

// The compare predicates' names (avx_alias.bn), against clang's numbers: the 32 predicates and
// the 14 second names, in any case, on each of vcmpps, vcmppd, vcmpss and vcmpsd; and names that
// are not.
func TestPredicates() testing.TestResult {
	var names *[]readonly char =
		" eq lt le unord neq nlt nle ord eq_uq nge ngt false neq_oq ge gt true eq_os lt_oq le_oq "
				"unord_s neq_us nlt_uq nle_uq ord_s eq_us nge_uq ngt_uq false_os neq_os ge_oq gt_oq "
				"true_us "
	var name [24]char
	var idx int = 0
	var start int = 1
	for i := 1; i < len(names); i++ {
		if names[i] != ' ' { continue }
		var n int = 0
		name[n] = 'v'
		name[n + 1] = 'c'
		name[n + 2] = 'm'
		name[n + 3] = 'p'
		n = 4
		for k := start; k < i; k++ {
			name[n] = names[k]
			n++
		}
		name[n] = 'p'
		name[n + 1] = 'd'
		base, num := predAlias(name[0:n + 2])
		if num != idx || len(base) != 6 || base[5] != 'd' { return fail("a predicate's number") }
		idx++
		start = i + 1
	}
	if idx != 32 { return fail("not 32 predicates") }
	_, a := predAlias("vcmpeq_oqps")
	_, b := predAlias("VCMPNGE_USSS")
	_, c := predAlias("vcmpfalse_oqsd")
	_, d := predAlias("vcmptrue_uqpd")
	_, f := predAlias("vcmpge_osps")
	if a != 0 || b != 9 || c != 11 || d != 15 || f != 13 { return fail("second names") }
	base, g := predAlias("vcmpGT_OQss")
	if g != 30 || base[4] != 's' || base[5] != 's' { return fail("vcmpGT_OQss") }
	_, h1 := predAlias("vcmp-ps")
	_, h2 := predAlias("vcmpeq_sps")
	_, h3 := predAlias("vcmpps")
	_, h4 := predAlias("vcmpeqpq")
	_, h5 := predAlias("cmpeqps")
	_, h6 := predAlias("vcmpeq_oqqps")
	if h1 >= 0 || h2 >= 0 || h3 >= 0 || h4 >= 0 || h5 >= 0 || h6 >= 0 { return fail("not names") }
	if !Has("vcmpunord_sss") || Has("vcmpunord_ss") { return fail("Has") }
	return ""
}

// CLMUL's names (pclmulAlias), against clang's selectors, in any case; and names that are not.
func TestPclmulNames() testing.TestResult {
	base, a := pclmulAlias("vpclmullqlqdq")
	_, b := pclmulAlias("VPCLMULHQLQDQ")
	_, c := pclmulAlias("vpclmullqhqdq")
	_, d := pclmulAlias("vpclmulhqhqdq")
	if a != 0x00 || b != 0x01 || c != 0x10 || d != 0x11 || !sameText(base, "vpclmulqdq") {
		return fail("selectors")
	}
	_, f := pclmulAlias("pclmullqlqdq")
	_, g := pclmulAlias("vpclmulxqlqdq")
	_, h := pclmulAlias("vpclmulqdq")
	if f >= 0 || g >= 0 || h >= 0 || !Has("vpclmulhqhqdq") { return fail("not names / Has") }
	return ""
}

// XOP's compare names (vpcomAlias), against clang's numbers, signed and unsigned, in any case; and
// names that are not.
func TestVpcomNames() testing.TestResult {
	base, a := vpcomAlias("vpcomltb")
	if a != 0 || !sameText(base, "vpcomb") { return fail("vpcomltb") }
	base, a = vpcomAlias("VPCOMTRUEUQ")
	if a != 7 || !sameText(base, "vpcomuq") { return fail("vpcomtrueuq") }
	base, a = vpcomAlias("vpcomneqw")
	if a != 5 || !sameText(base, "vpcomw") { return fail("vpcomneqw") }
	base, a = vpcomAlias("vpcomgeud")
	if a != 3 || !sameText(base, "vpcomud") { return fail("vpcomgeud") }
	_, b := vpcomAlias("vpcomneb")
	_, c := vpcomAlias("vpcomltx")
	_, d := vpcomAlias("vpcomub")
	_, f := vpcomAlias("vpcmpltb")
	if b >= 0 || c >= 0 || d >= 0 || f >= 0 || !Has("vpcomfalseuw") { return fail("not names / Has") }
	return ""
}

// AVX-512's integer compare names (vpcmpAlias), against clang's numbers, signed and unsigned, in
// any case; vpcmpeqb .. q (instructions of their own) and names that are not.
func TestVpcmpNames() testing.TestResult {
	base, a := vpcmpAlias("vpcmpltb")
	if a != 1 || !sameText(base, "vpcmpb") { return fail("vpcmpltb") }
	base, a = vpcmpAlias("VPCMPNLEUQ")
	if a != 6 || !sameText(base, "vpcmpuq") { return fail("vpcmpnleuq") }
	base, a = vpcmpAlias("vpcmpequw")
	if a != 0 || !sameText(base, "vpcmpuw") { return fail("vpcmpequw") }
	base, a = vpcmpAlias("vpcmpneqd")
	if a != 4 || !sameText(base, "vpcmpd") { return fail("vpcmpneqd") }
	_, b := vpcmpAlias("vpcmpeqd")
	_, c := vpcmpAlias("vpcmpgtub")
	_, d := vpcmpAlias("vpcmpfalseb")
	_, f := vpcmpAlias("vpcmpltx")
	if b >= 0 || c >= 0 || d >= 0 || f >= 0 || !Has("vpcmpnltuw") || Has("vpcmpgeb") {
		return fail("not names / Has")
	}
	return ""
}
