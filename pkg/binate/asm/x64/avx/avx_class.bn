package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/asm/x64/sse"

// The instruction table's operand classes (avx_table.bn): what an operand of each class may be,
// and where the encoding puts it.

// Xmm returns XMMi; see avx.bni.
func Xmm(i int) x64.Operand {
	if i >= 16 && i <= 31 { return x64.Reg(XMM16 + i - 16, x64.SZ128) }
	// Past 31 or below 0, a register no form takes (-1).
	if i < 0 || i > 31 { return x64.Reg(-1, x64.SZ128) }
	return sse.Xmm(i)
}

// Ymm returns YMMi; see avx.bni.
func Ymm(i int) x64.Operand {
	if i >= 16 && i <= 31 { return x64.Reg(YMM16 + i - 16, x64.SZ256) }
	// Past 31 or below 0, a register no form takes (-1).
	if i < 0 || i > 31 { return x64.Reg(-1, x64.SZ256) }
	return x64.Reg(YMM0 + i, x64.SZ256)
}

// Zmm returns ZMMi; see avx.bni.
func Zmm(i int) x64.Operand {
	// Past 31 or below 0, a register no form takes (-1).
	if i < 0 || i > 31 { return x64.Reg(-1, x64.SZ512) }
	return x64.Reg(ZMM0 + i, x64.SZ512)
}

// K returns the mask register ki; see avx.bni.
func K(i int) x64.Operand {
	// Past 7 or below 0, a register no form takes (-1).
	if i < 0 || i > 7 { return x64.Reg(-1, x64.SZ64) }
	return x64.Reg(K0 + i, x64.SZ64)
}

// IsYmm reports whether op is YMM0..YMM15; see avx.bni.
func IsYmm(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= YMM0 && op.Reg <= YMM15 && op.Size == x64.SZ256
}

// vecNum returns the number (0..31) of op as a vector register of size bits — a ZMM register at
// 512, a YMM one at 256, an XMM one at any other (a scalar's) — or -1.
func vecNum(op x64.Operand, size int) int {
	if op.Kind != x64.OP_REG { return -1 }
	var r int = op.Reg
	if size == x64.SZ512 {
		if op.Size == x64.SZ512 && r >= ZMM0 && r < ZMM0 + 32 { return r - ZMM0 }
		return -1
	}
	if size == x64.SZ256 {
		if op.Size != x64.SZ256 { return -1 }
		if r >= YMM0 && r <= YMM15 { return r - YMM0 }
		if r >= YMM16 && r < YMM16 + 16 { return r - YMM16 + 16 }
		return -1
	}
	if op.Size != x64.SZ128 { return -1 }
	if r >= sse.XMM0 && r <= sse.XMM15 { return r - sse.XMM0 }
	if r >= XMM16 && r < XMM16 + 16 { return r - XMM16 + 16 }
	return -1
}

// isVec reports whether op is a vector register of size bits (vecNum) that a form takes: in an
// EVEX form (evex) any of the 32, in a VEX one the first 16.
func isVec(op x64.Operand, size int, evex bool) bool {
	var n int = vecNum(op, size)
	return n >= 0 && (evex || n < 16)
}

// isMask reports whether op is a mask register, k0..k7.
func isMask(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= K0 && op.Reg < K0 + 8 && op.Size == x64.SZ64
}

// classOk reports whether op is of the table's operand class c (a token of a line, size its
// number, if any) in a VEX or XOP form, or an EVEX one (evex), which takes vector registers
// 16..31 too (isVec):
//   V  a vector register of size bits (XMM at 128, YMM at 256, ZMM at 512), in ModR/M's reg field
//   H  a vector register of size bits, in VEX.vvvv (EVEX.V'vvvv)
//   U  a vector register of size bits, in r/m
//   W  a vector register of size bits (an XMM one at a scalar's size), or memory of size bits or
//      of size 0, in r/m
//   X  W's register, or memory of size bits (and no other: its size chooses the form), in r/m
//   S  a vector register of size bits, in imm8[7:4]
//   C  an immediate, a number (not a symbol) whose two low bits are 00 or 11: a compare predicate
//      that holds with its sources swapped (eq, unord, neq, ord and their variants)
//   T  an immediate, a number (not a symbol), in imm8[3:0] beside an S register (0..15, the
//      encoder's to check: vpermil2ps's)
//   x  memory with an XMM index (VSIB, a gather's or a scatter's: x64.IsVsib; in a VEX form XMM0 ..
//      XMM15), of size bits (an element's) or of size 0, in r/m
//   y  memory with a YMM index, of size bits or of size 0, in r/m
//   z  memory with a ZMM index, of size bits or of size 0, in r/m
//   k  a mask register, in ModR/M's reg field
//   p  a mask register, in ModR/M's reg field less its low bit: the even one of the pair
//      vp2intersectd writes (clang encodes k1 as k0)
//   h  a mask register, in VEX.vvvv
//   u  a mask register, in r/m
//   w  a mask register, or memory of size bits or of size 0, in r/m
//   O  a rounding operand, `{rn-sae}` .. `{rz-sae}` (x64.Round 0..3): EVEX's rounding mode
//   N  the SAE operand, `{sae}` (x64.Round 4): EVEX's suppressing of exceptions
// and the general classes (optab.GpClassOk: G R E D Y J K L M A I).  The decorations an operand
// may carry are the line's to check (decorOk, avx_evex.bn).
func classOk(c char, size int, op x64.Operand, evex bool) bool {
	if c == 'V' || c == 'H' || c == 'U' || c == 'S' { return isVec(op, size, evex) }
	if c == 'W' { return isVec(op, size, evex) || optab.SizedMem(op, size) }
	if c == 'X' { return isVec(op, size, evex) || (x64.IsMem(op) && op.Size == size) }
	if c == 'x' || c == 'y' || c == 'z' {
		var vsib int = x64.SZ128
		if c == 'y' { vsib = x64.SZ256 }
		if c == 'z' { vsib = x64.SZ512 }
		return x64.IsVsib(op) && op.Vsib == vsib && (evex || op.Index < 16) &&
				(op.Size == 0 || op.Size == size)
	}
	if c == 'k' || c == 'p' || c == 'h' || c == 'u' { return isMask(op) }
	if c == 'w' { return isMask(op) || optab.SizedMem(op, size) }
	if c == 'O' { return op.Kind == x64.OP_ROUND && op.Imm >= 0 && op.Imm <= 3 }
	if c == 'N' { return op.Kind == x64.OP_ROUND && op.Imm == 4 }
	if c == 'T' { return op.Kind == x64.OP_IMM && len(op.Label) == 0 }
	if c == 'C' {
		return op.Kind == x64.OP_IMM && len(op.Label) == 0 && ((op.Imm & 3) == 0 || (op.Imm & 3) == 3)
	}
	return optab.GpClassOk(c, size, op)
}

// regNum returns the number a register operand has in an encoding's field: a vector register's
// (vecNum, 0..31) or a mask register's (0..7) from 0, a general register's as it is.
func regNum(op x64.Operand) int {
	var n int = vecNum(op, op.Size)
	if n >= 0 { return n }
	if isMask(op) { return op.Reg - K0 }
	return op.Reg
}

// rmOperand returns op, an r/m operand, as the encoding takes it: a register's number as the
// field holds it (regNum), any other operand as it is.
func rmOperand(op x64.Operand) x64.Operand {
	var b x64.Operand = op
	if op.Kind == x64.OP_REG { b.Reg = regNum(op) }
	return b
}
