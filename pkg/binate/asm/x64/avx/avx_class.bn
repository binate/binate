package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/asm/x64/sse"

// The instruction table's operand classes (avx_table.bn): what an operand of each class may be,
// and where the encoding puts it.

// Ymm returns YMMi; see avx.bni.
func Ymm(i int) x64.Operand {
	// Past 15 or below 0, a register no form takes (-1).
	if i < 0 || i > 15 { return x64.Reg(-1, x64.SZ256) }
	return x64.Reg(YMM0 + i, x64.SZ256)
}

// IsYmm reports whether op is YMM0..YMM15; see avx.bni.
func IsYmm(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= YMM0 && op.Reg <= YMM15 && op.Size == x64.SZ256
}

// isVec reports whether op is a vector register of size bits: YMM at 256, XMM at any other.
func isVec(op x64.Operand, size int) bool {
	if size == x64.SZ256 { return IsYmm(op) }
	return sse.IsXmm(op)
}

// classOk reports whether op is of the table's operand class c (a token of a line, size its
// number, if any):
//   V  a vector register of size bits (XMM at 128, YMM at 256), in ModR/M's reg field
//   H  a vector register of size bits, in VEX.vvvv
//   U  a vector register of size bits, in r/m
//   W  a YMM register at 256, else an XMM register, or memory of size bits or of size 0, in r/m
//   X  W's register, or memory of size bits (and no other: its size chooses the form), in r/m
//   S  a vector register of size bits, in imm8[7:4]
//   C  an immediate, a number (not a symbol) whose two low bits are 00 or 11: a compare predicate
//      that holds with its sources swapped (eq, unord, neq, ord and their variants)
// and the general classes (optab.GpClassOk: G R E D Y J K L M A I).
func classOk(c char, size int, op x64.Operand) bool {
	if c == 'V' || c == 'H' || c == 'U' || c == 'S' { return isVec(op, size) }
	if c == 'W' { return isVec(op, size) || optab.SizedMem(op, size) }
	if c == 'X' { return isVec(op, size) || (x64.IsMem(op) && op.Size == size) }
	if c == 'C' {
		return op.Kind == x64.OP_IMM && len(op.Label) == 0 && ((op.Imm & 3) == 0 || (op.Imm & 3) == 3)
	}
	return optab.GpClassOk(c, size, op)
}

// regNum returns the number a register operand has in an encoding's field: an XMM or YMM
// register's from 0, a general register's as it is.
func regNum(op x64.Operand) int {
	if sse.IsXmm(op) { return op.Reg - sse.XMM0 }
	if IsYmm(op) { return op.Reg - YMM0 }
	return op.Reg
}

// rmOperand returns op, an r/m operand, as the encoding takes it: a register's number as the
// field holds it (regNum), any other operand as it is.
func rmOperand(op x64.Operand) x64.Operand {
	var b x64.Operand = op
	if op.Kind == x64.OP_REG { b.Reg = regNum(op) }
	return b
}
