package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The operand classes (avx_class.bn): the registers; each vector class at 128 and 256 bits
// against XMM and YMM registers and memory of each size and none, and in an EVEX form against
// registers 16..31 and ZMM; the mask and rounding classes; C's predicates; a general class; and the
// numbers the fields hold.

func TestYmm() testing.TestResult {
	if !IsYmm(Ymm(0)) || !IsYmm(Ymm(15)) || IsYmm(Ymm(16)) || IsYmm(Ymm(-1)) || IsYmm(sse.Xmm(3)) ||
			IsYmm(x64.Reg(YMM0, x64.SZ128)) {
		return fail("IsYmm")
	}
	if Ymm(7).Reg != YMM7 || Ymm(7).Size != x64.SZ256 { return fail("Ymm") }
	return ""
}

func TestEvexRegisters() testing.TestResult {
	if Xmm(3).Reg != sse.XMM3 || Xmm(16).Reg != XMM16 || Xmm(31).Reg != XMM16 + 15 ||
			Xmm(31).Size != x64.SZ128 || Xmm(32).Reg != -1 || Xmm(-1).Reg != -1 {
		return fail("Xmm")
	}
	if Ymm(16).Reg != YMM16 || Ymm(31).Reg != YMM16 + 15 || Ymm(32).Reg != -1 || Ymm(-1).Reg != -1 {
		return fail("Ymm past 15")
	}
	if Zmm(0).Reg != ZMM0 || Zmm(31).Reg != ZMM0 + 31 || Zmm(31).Size != x64.SZ512 ||
			Zmm(32).Reg != -1 || Zmm(-1).Reg != -1 {
		return fail("Zmm")
	}
	if K(0).Reg != K0 || K(7).Reg != K0 + 7 || K(7).Size != x64.SZ64 || K(8).Reg != -1 ||
			K(-1).Reg != -1 {
		return fail("K")
	}
	return ""
}

func TestClassOk() testing.TestResult {
	var x x64.Operand = sse.Xmm(9)
	var y x64.Operand = Ymm(9)
	var m0 x64.Operand = x64.Mem(x64.RAX, 0, 0)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m128 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ128)
	var m256 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ256)
	if !classOk0('V', 128, x) || classOk0('V', 128, y) || !classOk0('H', 256, y) ||
			classOk0('H', 256, x) || !classOk0('U', 128, x) || classOk0('U', 128, m128) ||
			!classOk0('S', 256, y) {
		return fail("V / H / U / S")
	}
	if !classOk0('W', 128, x) || !classOk0('W', 128, m128) || !classOk0('W', 128, m0) ||
			classOk0('W', 128, m256) || classOk0('W', 128, y) || !classOk0('W', 32, x) ||
			!classOk0('W', 32, m32) || classOk0('W', 32, m128) || !classOk0('W', 256, y) ||
			!classOk0('W', 256, m256) || classOk0('W', 256, x) {
		return fail("W")
	}
	if !classOk0('X', 128, x) || !classOk0('X', 128, m128) || classOk0('X', 128, m0) ||
			!classOk0('X', 256, y) || !classOk0('X', 256, m256) || classOk0('X', 256, m0) {
		return fail("X")
	}
	if !classOk0('C', 0, x64.Imm(0)) || !classOk0('C', 0, x64.Imm(3)) ||
			!classOk0('C', 0, x64.Imm(4)) || !classOk0('C', 0, x64.Imm(31)) ||
			!classOk0('C', 0, x64.Imm(-1)) || classOk0('C', 0, x64.Imm(1)) || classOk0('C', 0, x64.Imm(2)) ||
			classOk0('C', 0, x64.Imm(6)) || classOk0('C', 0, x64.ImmSym("x", 0, 0)) || classOk0('C', 0, x) {
		return fail("C")
	}
	if !classOk0('M', 32, m32) || !classOk0('G', 0, x64.Reg(x64.R9, x64.SZ64)) || classOk0('Q', 0, x) {
		return fail("general / unknown classes")
	}
	return ""
}

// classOk0 is classOk in a VEX form.
func classOk0(c char, size int, op x64.Operand) bool { return classOk(c, size, op, false) }

func TestEvexClassOk() testing.TestResult {
	var m512 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ512)
	if classOk('V', 128, Xmm(16), false) || !classOk('V', 128, Xmm(16), true) ||
			classOk('H', 256, Ymm(31), false) || !classOk('H', 256, Ymm(31), true) ||
			!classOk('U', 512, Zmm(31), true) || classOk('U', 512, Ymm(1), true) ||
			classOk('U', 256, Zmm(1), true) || !classOk('W', 32, Xmm(20), true) ||
			classOk('W', 32, Ymm(20), true) || !classOk('W', 512, m512, true) ||
			!classOk('X', 512, m512, true) || classOk('V', 128, K(1), true) {
		return fail("vector classes in an EVEX form")
	}
	var m16 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ16)
	if !classOk('k', 0, K(0), false) || !classOk('h', 0, K(7), false) ||
			!classOk('u', 0, K(3), false) || classOk('k', 0, x64.Reg(x64.RAX, x64.SZ64), false) ||
			classOk('u', 0, sse.Xmm(1), false) || !classOk('w', 16, K(2), false) ||
			!classOk('w', 16, m16, false) || classOk('w', 16, x64.Mem(x64.RAX, 0, x64.SZ32), false) ||
			classOk('k', 0, m16, false) {
		return fail("mask classes")
	}
	if !classOk('O', 0, x64.Round(0), true) || !classOk('O', 0, x64.Round(3), true) ||
			classOk('O', 0, x64.Round(4), true) || !classOk('N', 0, x64.Round(4), true) ||
			classOk('N', 0, x64.Round(0), true) || classOk('O', 0, x64.Imm(0), true) ||
			classOk('I', 0, x64.Round(0), true) {
		return fail("rounding classes")
	}
	return ""
}

func TestFieldNumbers() testing.TestResult {
	if regNum(sse.Xmm(12)) != 12 || regNum(Ymm(13)) != 13 || regNum(x64.Reg(x64.R9, x64.SZ32)) != 9 {
		return fail("regNum")
	}
	if regNum(Xmm(16)) != 16 || regNum(Ymm(31)) != 31 || regNum(Zmm(5)) != 5 ||
			regNum(Zmm(29)) != 29 || regNum(K(3)) != 3 || regNum(x64.Reg(x64.R15, x64.SZ64)) != 15 ||
			rmOperand(Zmm(20)).Reg != 20 {
		return fail("regNum past 15")
	}
	var b x64.Operand = rmOperand(Ymm(10))
	var m x64.Operand = rmOperand(x64.Mem(x64.R10, 8, x64.SZ256))
	if b.Reg != 10 || m.Base != x64.R10 || m.Disp != 8 { return fail("rmOperand") }
	return ""
}
