package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The operand classes (avx_class.bn): YMM registers; each vector class at 128 and 256 bits
// against XMM and YMM registers and memory of each size and none; C's predicates; a general
// class; and the numbers the fields hold.

func TestYmm() testing.TestResult {
	if !IsYmm(Ymm(0)) || !IsYmm(Ymm(15)) || IsYmm(Ymm(16)) || IsYmm(Ymm(-1)) || IsYmm(sse.Xmm(3)) ||
			IsYmm(x64.Reg(YMM0, x64.SZ128)) {
		return fail("IsYmm")
	}
	if Ymm(7).Reg != YMM7 || Ymm(7).Size != x64.SZ256 { return fail("Ymm") }
	return ""
}

func TestClassOk() testing.TestResult {
	var x x64.Operand = sse.Xmm(9)
	var y x64.Operand = Ymm(9)
	var m0 x64.Operand = x64.Mem(x64.RAX, 0, 0)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m128 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ128)
	var m256 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ256)
	if !classOk('V', 128, x) || classOk('V', 128, y) || !classOk('H', 256, y) ||
			classOk('H', 256, x) || !classOk('U', 128, x) || classOk('U', 128, m128) ||
			!classOk('S', 256, y) {
		return fail("V / H / U / S")
	}
	if !classOk('W', 128, x) || !classOk('W', 128, m128) || !classOk('W', 128, m0) ||
			classOk('W', 128, m256) || classOk('W', 128, y) || !classOk('W', 32, x) ||
			!classOk('W', 32, m32) || classOk('W', 32, m128) || !classOk('W', 256, y) ||
			!classOk('W', 256, m256) || classOk('W', 256, x) {
		return fail("W")
	}
	if !classOk('X', 128, x) || !classOk('X', 128, m128) || classOk('X', 128, m0) ||
			!classOk('X', 256, y) || !classOk('X', 256, m256) || classOk('X', 256, m0) {
		return fail("X")
	}
	if !classOk('C', 0, x64.Imm(0)) || !classOk('C', 0, x64.Imm(3)) || !classOk('C', 0, x64.Imm(4)) ||
			!classOk('C', 0, x64.Imm(31)) || !classOk('C', 0, x64.Imm(-1)) || classOk('C', 0, x64.Imm(1)) ||
			classOk('C', 0, x64.Imm(2)) || classOk('C', 0, x64.Imm(6)) ||
			classOk('C', 0, x64.ImmSym("x", 0, 0)) || classOk('C', 0, x) {
		return fail("C")
	}
	if !classOk('M', 32, m32) || !classOk('G', 0, x64.Reg(x64.R9, x64.SZ64)) || classOk('Q', 0, x) {
		return fail("general / unknown classes")
	}
	return ""
}

func TestFieldNumbers() testing.TestResult {
	if regNum(sse.Xmm(12)) != 12 || regNum(Ymm(13)) != 13 || regNum(x64.Reg(x64.R9, x64.SZ32)) != 9 {
		return fail("regNum")
	}
	var b x64.Operand = rmOperand(Ymm(10))
	var m x64.Operand = rmOperand(x64.Mem(x64.R10, 8, x64.SZ256))
	if b.Reg != 10 || m.Base != x64.R10 || m.Disp != 8 { return fail("rmOperand") }
	return ""
}
