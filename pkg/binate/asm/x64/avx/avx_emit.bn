package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/evex"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/asm/x64/vex"
import "pkg/binate/buf"

// The table's encoder: a mnemonic's lines (avx_table.bn) are matched against the operands, and the
// one chosen is encoded: VEX or XOP prefix, opcode, ModR/M, then an imm8 — a register in
// imm8[7:4] (an imm4 in imm8[3:0] beside it) or an immediate — each operand where its class puts
// it (avx_class.bn); or an EVEX line's (avx_evex.bn).

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// Has reports whether the table has mnem; see avx.bni.
func Has(mnem *[]readonly char) bool {
	_, at := tableOf(mnem)
	if at >= 0 { return true }
	_, imm := aliasOf(mnem)
	return imm >= 0
}

// row is a line's fixed fields: its vector length (VEX.L, 0 or 1; EVEX's L'L, 0 .. 2), its implied
// prefix (vex.PP_*), its opcode map (vex.MAP_*, evex.MAP_5 or MAP_6, or AMD's vex.XOP_MAP*: xop,
// the prefix 8F), whether it is an EVEX form (evex), its W, its opcode, the opcode's extension in
// ModR/M's reg field (written ae/2; -1 for none), an EVEX form's decorations (whether it takes a
// write mask and zeroing, the size in bits of the element it broadcasts, and that of the element
// that scales its displacement where not its memory's: 0 for none), and the position of its first
// operand class (its newline for a line with none).
type row struct {
	l     int
	pp    int
	m     int
	xop   bool
	evex  bool
	w     bool
	op    int
	ext   int
	mask  bool
	zero  bool
	bcst  int
	scale int
	field int
}

// rowAt reads the fixed fields of the line at at: "<mnem> <l0 | l1 | e0 | e1 | e2> <- | 66 | f3 |
// f2> <0f | 38 | 3a | 05 | 06 | 08 | 09 | 0a> <w0 | w1> <opcode>", and an EVEX line's decorations
// after them (rowDecor).
func rowAt(t *[]readonly char, at int) row {
	var r row
	var i int = optab.TokenEnd(t, at) + 1
	r.evex = t[i] == 'e'
	r.l = cast(int, t[i + 1]) - cast(int, '0')
	i = optab.TokenEnd(t, i) + 1
	r.pp = vex.PP_NONE
	if t[i] == '6' { r.pp = vex.PP_66 }
	if t[i] == 'f' && t[i + 1] == '3' { r.pp = vex.PP_F3 }
	if t[i] == 'f' && t[i + 1] == '2' { r.pp = vex.PP_F2 }
	i = optab.TokenEnd(t, i) + 1
	r.m = vex.MAP_0F
	if t[i] == '3' && t[i + 1] == '8' { r.m = vex.MAP_0F38 }
	if t[i] == '3' && t[i + 1] == 'a' { r.m = vex.MAP_0F3A }
	if t[i] == '0' && t[i + 1] == '8' { r.m = vex.XOP_MAP8 }
	if t[i] == '0' && t[i + 1] == '9' { r.m = vex.XOP_MAP9 }
	if t[i] == '0' && t[i + 1] == 'a' { r.m = vex.XOP_MAPA }
	if t[i] == '0' && t[i + 1] == '5' { r.m = evex.MAP_5 }
	if t[i] == '0' && t[i + 1] == '6' { r.m = evex.MAP_6 }
	r.xop = r.m == vex.XOP_MAP8 || r.m == vex.XOP_MAP9 || r.m == vex.XOP_MAPA
	i = optab.TokenEnd(t, i) + 1
	r.w = t[i + 1] == '1'
	i = optab.TokenEnd(t, i) + 1
	var end int = optab.TokenEnd(t, i)
	r.op = optab.HexVal(t[i]) * 16 + optab.HexVal(t[i + 1])
	r.ext = -1
	if end - i == 4 && t[i + 2] == '/' { r.ext = optab.HexVal(t[i + 3]) }
	r.field = end
	if end < len(t) && t[end] == ' ' { r.field = end + 1 }
	if r.evex { r = rowDecor(t, r) }
	return r
}

// operandOk reports whether op, operand k, is of class tok of line r, its decorations among those
// the line takes (decorOk; a broadcast's memory is sized by its element there).
func operandOk(tok *[]readonly char, op x64.Operand, k int, r row) bool {
	if !decorOk(tok, op, k, r) { return false }
	return op.Bcst != 0 || classOk(tok[0], optab.TokenNum(tok), op, r.evex)
}

// rowMatches reports whether the operands ops match the operand classes of line r: one each.
func rowMatches(t *[]readonly char, r row, ops *[]x64.Operand) bool {
	var k int = 0
	var i int = r.field
	for i < len(t) && t[i] != '\n' {
		var end int = optab.TokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= len(ops) || !operandOk(tok, ops[k], k, r) { return false }
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return k == len(ops)
}

// unsizedFor returns the class, E or X, at which the operands ops would match the classes of line r
// but for memory of no size there (not broadcast), and the class's size, or 0 and 0: the operand is
// ambiguous.
func unsizedFor(t *[]readonly char, r row, ops *[]x64.Operand) (char, int) {
	var at char = 0
	var size int = 0
	var k int = 0
	var i int = r.field
	for i < len(t) && t[i] != '\n' {
		var end int = optab.TokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= len(ops) { return 0, 0 }
		var o x64.Operand = ops[k]
		if (tok[0] == 'E' || tok[0] == 'X') && x64.IsMem(o) && o.Size == 0 && o.Bcst == 0 &&
				decorOk(tok, o, k, r) {
			at = tok[0]
			size = optab.TokenNum(tok)
		} else if !operandOk(tok, o, k, r) {
			return 0, 0
		}
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	if k != len(ops) { return 0, 0 }
	return at, size
}

// vectorSizes returns the names of the memory sizes in mask (1 xmmword, 2 ymmword, 4 zmmword), as a
// message lists them.
func vectorSizes(mask int) *[]readonly char {
	if mask == 1 { return "xmmword" }
	if mask == 2 { return "ymmword" }
	if mask == 4 { return "zmmword" }
	if mask == 3 { return "xmmword or ymmword" }
	if mask == 5 { return "xmmword or zmmword" }
	if mask == 6 { return "ymmword or zmmword" }
	return "xmmword, ymmword or zmmword"
}

// form is how a line places the operands: ModR/M's reg field, VEX.vvvv, the r/m operand (if the
// line has one) and its size in bits (its class's, else its own), the register in imm8[7:4] (-1 for
// none) and the immediate in imm8[3:0] beside it (0 for none), the immediates, an EVEX form's
// rounding operand (if it has one), and W.
type form struct {
	reg      int
	v        int
	rm       x64.Operand
	hasRm    bool
	rmBits   int
	is4      int
	imm4     x64.Operand
	imm1     x64.Operand
	imm2     x64.Operand
	imms     int
	round    x64.Operand
	hasRound bool
	w        bool
}

// formOf places the operands ops by the classes of the line r of table part t.
func formOf(t *[]readonly char, r row, ops *[]x64.Operand) form {
	var f form
	f.reg = r.ext
	if f.reg < 0 { f.reg = 0 }
	f.rm = x64.Reg(0, x64.SZ64)
	f.is4 = -1
	f.w = r.w
	var k int = 0
	var i int = r.field
	for i < len(t) && t[i] != '\n' {
		var end int = optab.TokenEnd(t, i)
		var c char = t[i]
		var o x64.Operand = ops[k]
		if optab.GpRexW(c, o) { f.w = true }
		if c == 'I' || c == 'C' {
			if f.imms == 0 { f.imm1 = o } else { f.imm2 = o }
			f.imms++
		} else if c == 'V' || c == 'k' || optab.GpInReg(c) {
			f.reg = regNum(o)
		} else if c == 'H' || c == 'h' {
			f.v = regNum(o)
		} else if c == 'S' {
			f.is4 = regNum(o)
		} else if c == 'T' {
			f.imm4 = o
		} else if c == 'O' || c == 'N' {
			f.round = o
			f.hasRound = true
		} else {
			f.rm = rmOperand(o)
			f.hasRm = true
			f.rmBits = optab.TokenNum(t[i:end])
			if f.rmBits == 0 { f.rmBits = o.Size }
		}
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return f
}

// shortForm reports whether line r, placing the operands ops, holds every field of the two-byte
// VEX prefix: map 0F, W 0, and no register 8..15 or such a base or index in r/m (VEX.X, VEX.B).
func shortForm(t *[]readonly char, r row, ops *[]x64.Operand) bool {
	if r.m != vex.MAP_0F { return false }
	var f form = formOf(t, r, ops)
	if f.w { return false }
	if f.rm.Kind == x64.OP_REG { return f.rm.Reg < 8 }
	return f.rm.Base < 8 && f.rm.Index < 8
}

// evexByDefault reports whether mnem is one of the table's instructions clang encodes as EVEX
// unless `{vex}`, `{vex2}` or `{vex3}` is written (AVX-VNNI's, AVX-IFMA's, vcvtneps2bf16: each
// AVX-512 has the same name for).
func evexByDefault(mnem *[]readonly char) bool {
	return wordAt(" vcvtneps2bf16 vpdpbusd vpdpbusds vpdpwssd vpdpwssds vpmadd52huq vpmadd52luq ",
			mnem) >= 0
}

// Emit emits mnem with its operands; see avx.bni.
func Emit(a @asm.Assembler, mnem *[]readonly char, ops *[]x64.Operand) bool {
	t, at := tableOf(mnem)
	if at >= 0 && evexByDefault(mnem) && a.X64Vex != 2 && a.X64Vex != 3 {
		x64.OperandError(a, mnem,
				"takes {vex} here: clang encodes it as AVX-512's EVEX form, which this assembler does not "
						"have yet")
		return true
	}
	if at >= 0 {
		emitLines(a, mnem, mnem, t, at, ops)
		return true
	}
	base, imm := aliasOf(mnem)
	if imm < 0 { return false }
	var n int = len(ops)
	if n != 3 && (n != 4 || ops[3].Kind != x64.OP_ROUND) {
		x64.OperandError(a, mnem,
				"takes three operands (its name holds the immediate), and {sae} after them")
		return true
	}
	var all [5]x64.Operand
	for i := 0; i < n; i++ { all[i] = ops[i] }
	all[n] = x64.Imm(imm)
	t, at = tableOf(base)
	emitLines(a, mnem, base, t, at, all[0:n + 1])
	return true
}

// emitLines emits name's line (from at, in table part t) the operands ops choose, or sets an error
// naming mnem, the mnemonic as written: a VEX or XOP line where one fits — the first they match,
// unless a later one holds the two-byte prefix where it does not (shortForm) and `{vex3}` is not
// written — else the first EVEX line they match; only the VEX and XOP lines after `{vex}` ..
// `{vex3}` (asm.Assembler.X64Vex 2 or 3), only the EVEX ones after `{evex}` (4).
func emitLines(a @asm.Assembler, mnem *[]readonly char, name *[]readonly char, t *[]readonly char,
		at int, ops *[]x64.Operand) {
	if len(ops) > 0 && ops[0].Zero && ops[0].Mask == 0 {
		x64.OperandError(a, mnem, "takes zeroing {z} only beside a write mask {k1} .. {k7} (GNU as)")
		return
	}
	var first int = -1
	var short int = -1
	var efirst int = -1
	var evexes int = 0
	var unsized char = 0
	var sizes int = 0
	var gather bool = false
	for at < len(t) && optab.SameMnem(t, at, name) {
		var r row = rowAt(t, at)
		if r.evex { evexes++ }
		if (r.evex && (a.X64Vex == 2 || a.X64Vex == 3)) || (!r.evex && a.X64Vex == 4) {
			at = optab.NextLine(t, at)
			continue
		}
		if vsibRow(t, r.field) { gather = true }
		if rowMatches(t, r, ops) {
			if r.evex && efirst < 0 { efirst = at }
			if !r.evex && first < 0 { first = at }
			if !r.evex && short < 0 && shortForm(t, r, ops) { short = at }
		} else {
			u, size := unsizedFor(t, r, ops)
			if unsized == 0 { unsized = u }
			if u == 'X' { sizes = sizes | (size / 128) }
		}
		at = optab.NextLine(t, at)
	}
	if a.X64Vex == 4 && evexes == 0 {
		x64.OperandError(a, mnem, "has no EVEX form here (after {evex})")
	} else if first >= 0 {
		var pick int = first
		if short >= 0 && a.X64Vex != 3 { pick = short }
		encodeRow(a, mnem, t, rowAt(t, pick), ops)
	} else if efirst >= 0 {
		encodeEvex(a, mnem, t, rowAt(t, efirst), ops)
	} else if unsized == 'E' {
		x64.OperandError(a, mnem, "ambiguous operand size (write dword or qword ptr)")
	} else if unsized == 'X' {
		x64.OperandError(a, mnem,
				buf.Concat("ambiguous operand size (write ", buf.Concat(vectorSizes(sizes), " ptr)")))
	} else if !gather && hasVsib(ops) {
		x64.OperandError(a, mnem, "takes no memory operand with a vector index (VSIB: a gather's)")
	} else {
		x64.OperandError(a, mnem, "takes other operands")
	}
}

// vsibRow reports whether a line's classes (from field, its first) take memory with a vector
// index (x, y): a gather's.
func vsibRow(t *[]readonly char, field int) bool {
	var i int = field
	for i < len(t) && t[i] != '\n' {
		if t[i] == 'x' || t[i] == 'y' { return true }
		i = optab.TokenEnd(t, i)
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return false
}

// hasVsib reports whether one of the operands ops is memory with a vector index (x64.IsVsib).
func hasVsib(ops *[]x64.Operand) bool {
	for i := 0; i < len(ops); i++ {
		if x64.IsVsib(ops[i]) { return true }
	}
	return false
}

// encodeRow emits mnem by its line r: VEX or XOP prefix, opcode, then (when the line has an r/m
// operand) ModR/M and a register in imm8[7:4] (an imm4 in imm8[3:0] beside it) or up to two imm8,
// the operands ops placed by their classes.  A gather (a vector index: x64.IsVsib) takes three
// different registers.
func encodeRow(a @asm.Assembler, mnem *[]readonly char, t *[]readonly char, r row,
		ops *[]x64.Operand) {
	var f form = formOf(t, r, ops)
	if f.imms > 0 && !x64.ImmOk(a, mnem, f.imm1, x64.SZ8) { return }
	if f.imms > 1 && !x64.ImmOk(a, mnem, f.imm2, x64.SZ8) { return }
	if x64.IsVsib(f.rm) && (f.reg == f.v || f.reg == f.rm.Index || f.v == f.rm.Index) {
		// The CPU faults (#UD) on a gather with two of them alike; clang and GNU as warn.
		x64.OperandError(a, mnem, "takes destination, index and mask registers that all differ")
		return
	}
	if f.imm4.Imm < 0 || f.imm4.Imm > 15 {
		x64.OperandError(a, mnem, "takes an immediate of 0..15 last (imm8[3:0], beside a register)")
		return
	}
	if r.xop {
		vex.EmitXop(a, r.m, f.w, r.l, f.reg, f.v, f.rm)
	} else {
		vex.Emit(a, r.m, r.pp, f.w, r.l, f.reg, f.v, f.rm)
	}
	emit8(a, r.op)
	if !f.hasRm { return }
	if x64.IsVsib(f.rm) {
		x64.EmitModRMVsib(a, f.reg, f.rm)
		return
	}
	var trailing int = f.imms
	if f.is4 >= 0 { trailing++ }
	x64.EmitModRMImm(a, f.reg, f.rm, trailing)
	if f.is4 >= 0 { emit8(a, (f.is4 << 4) | cast(int, f.imm4.Imm)) }
	if f.imms > 0 { x64.EmitImm(a, mnem, f.imm1, x64.SZ8) }
	if f.imms > 1 { x64.EmitImm(a, mnem, f.imm2, x64.SZ8) }
}
