package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The encoder (avx_emit.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): which form it chooses — a commutative instruction's sources swapped
// and a move between registers in its store form where that gives the two-byte prefix, as clang,
// and not after {vex3}, nor for a predicate written as a symbol; the errors; [rip + x]'s addend
// past an is4 register or an imm8; a line's fields.

func TestChoice() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x0 x64.Operand = sse.Xmm(0)
	var x1 x64.Operand = sse.Xmm(1)
	var x8 x64.Operand = sse.Xmm(8)
	var x9 x64.Operand = sse.Xmm(9)
	if !emitCase("vaddps", 3, x0, x1, x8, none, "c5 b8 58 c1") {
		return fail("vaddps xmm0, xmm1, xmm8")
	}
	if !emitCase("vaddps", 3, Ymm(0), Ymm(8), Ymm(9), none, "c4 c1 3c 58 c1") {
		return fail("vaddps ymm0, ymm8, ymm9")
	}
	if !emitCase("vaddps", 3, x8, x1, x9, none, "c5 30 58 c1") {
		return fail("vaddps xmm8, xmm1, xmm9")
	}
	if !emitCase("vsubps", 3, x0, x1, x8, none, "c4 c1 70 5c c0") {
		return fail("vsubps xmm0, xmm1, xmm8")
	}
	if !emitCase("vcmpps", 4, x0, x1, x8, x64.Imm(0), "c5 b8 c2 c1 00") { return fail("vcmpps .., 0") }
	if !emitCase("vcmpps", 4, x0, x1, x8, x64.Imm(1), "c4 c1 70 c2 c0 01") {
		return fail("vcmpps .., 1")
	}
	if !emitCase("vcmpps", 4, Ymm(0), Ymm(1), Ymm(8), x64.Imm(7), "c5 bc c2 c1 07") {
		return fail("vcmpps ymm, 7")
	}
	if !emitCase("vcmpps", 4, x0, x1, x8, x64.Imm(-1), "c5 b8 c2 c1 ff") {
		return fail("vcmpps .., -1")
	}
	if !emitCase("vcmpss", 4, x0, x1, x8, x64.Imm(0), "c4 c1 72 c2 c0 00") {
		return fail("vcmpss .., 0")
	}
	if !emitCase("vcmpeqps", 3, x0, x1, x8, none, "c5 b8 c2 c1 00") { return fail("vcmpeqps") }
	if !emitCase("vcmpltps", 3, x0, x1, x8, none, "c4 c1 70 c2 c0 01") { return fail("vcmpltps") }
	if !emitCase("vmovaps", 2, x0, x8, none, none, "c5 78 29 c0") { return fail("vmovaps xmm0, xmm8") }
	if !emitCase("vmovaps", 2, x8, x0, none, none, "c5 78 28 c0") { return fail("vmovaps xmm8, xmm0") }
	if !emitCase("vmovaps", 2, x8, x9, none, none, "c4 41 78 28 c1") {
		return fail("vmovaps xmm8, xmm9")
	}
	if !emitCase("vmovaps", 2, Ymm(0), Ymm(8), none, none, "c5 7c 29 c0") {
		return fail("vmovaps ymm0, ymm8")
	}
	if !emitCase("vmovss", 3, x0, x1, x8, none, "c5 72 11 c0") {
		return fail("vmovss xmm0, xmm1, xmm8")
	}
	if !emitCase("vmovss", 3, x0, x8, x9, none, "c5 3a 11 c8") {
		return fail("vmovss xmm0, xmm8, xmm9")
	}
	if !emitCase("vmovss", 3, x8, x1, x9, none, "c4 41 72 10 c1") {
		return fail("vmovss xmm8, xmm1, xmm9")
	}
	// A predicate written as a symbol may be asymmetric: never swapped (clang swaps it).
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vcmpps", 4, x0, x1, x8, x64.ImmSym("x", 0, 0))
	if a.HasError || a.Sections[0].Len != 6 ||
			!checkBytes(a.Sections[0], 0, hexBytes("c4 c1 70 c2 c0")) ||
			!fixupIs(a, asm.FIX_DATA_ABS8, 5, 0) {
		return fail("vcmpps xmm0, xmm1, xmm8, offset x")
	}
	return ""
}

// After {vex3}: the first form, with the three-byte prefix; a VEX prefix marks the instruction.
func TestVex3() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x0 x64.Operand = sse.Xmm(0)
	var x1 x64.Operand = sse.Xmm(1)
	var x8 x64.Operand = sse.Xmm(8)
	var a @asm.Assembler = newAsm()
	a.X64Vex = 3
	_ = emitOps(a, "vaddps", 3, x0, x1, x8, none)
	if !emitsExactly(a, "c4 c1 70 58 c0") || !a.X64VexDone { return fail("{vex3} vaddps") }
	a = newAsm()
	a.X64Vex = 3
	_ = emitOps(a, "vmovaps", 2, x0, x8, none, none)
	if !emitsExactly(a, "c4 c1 78 28 c0") { return fail("{vex3} vmovaps xmm0, xmm8") }
	a = newAsm()
	a.X64Vex = 3
	_ = emitOps(a, "vcmpeqps", 3, x0, x1, x8, none)
	if !emitsExactly(a, "c4 c1 70 c2 c0 00") { return fail("{vex3} vcmpeqps") }
	a = newAsm()
	a.X64Vex = 3
	_ = emitOps(a, "vzeroupper", 0, none, none, none, none)
	if !emitsExactly(a, "c4 e1 78 77") { return fail("{vex3} vzeroupper") }
	return ""
}

// Errors name the mnemonic as written; memory of no size where its size picks the form is
// ambiguous, as clang says.
func TestEmitErrors() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x0 x64.Operand = sse.Xmm(0)
	var x1 x64.Operand = sse.Xmm(1)
	var m0 x64.Operand = x64.Mem(x64.RAX, 0, 0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "VCVTPD2PS", 2, x0, m0, none, none)
	if !rejected(a) ||
			!msgHasPrefix(a.ErrorMsg, "x64: VCVTPD2PS: ambiguous operand size (write xmmword or ymmword") {
		return fail("vcvtpd2ps xmm0, [rax]")
	}
	a = newAsm()
	_ = emitOps(a, "vcvtsi2ss", 3, x0, x1, m0, none)
	if !rejected(a) ||
			!msgHasPrefix(a.ErrorMsg, "x64: vcvtsi2ss: ambiguous operand size (write dword") {
		return fail("vcvtsi2ss xmm0, xmm1, [rax]")
	}
	a = newAsm()
	_ = emitOps(a, "vaddps", 3, x0, x1, Ymm(2), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vaddps: takes other operands") {
		return fail("vaddps xmm0, xmm1, ymm2")
	}
	a = newAsm()
	_ = emitOps(a, "vcmpeqps", 4, x0, x1, x0, x64.Imm(1))
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vcmpeqps: takes three operands") {
		return fail("vcmpeqps with an immediate")
	}
	a = newAsm()
	_ = emitOps(a, "vroundss", 4, x0, x1, x0, x64.Imm(256))
	if !rejected(a) { return fail("vroundss .., 256") }
	a = newAsm()
	if emitOps(a, "vaddpq", 3, x0, x1, x0, none) || a.HasError || Has("vaddpq") || !Has("VADDPS") {
		return fail("a name the table lacks")
	}
	return ""
}

// [rip + x]'s rel32 counts what follows it: an imm8, an is4 register.
func TestRip() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x0 x64.Operand = sse.Xmm(0)
	var x1 x64.Operand = sse.Xmm(1)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vaddps", 3, x0, x1, x64.RipLabel("x"), none)
	if !emitsExactly(a, "c5 f0 58 05 00 00 00 00") || !fixupIs(a, x64.FIX_REL32_LEA, 4, 0) {
		return fail("vaddps xmm0, xmm1, [rip + x]")
	}
	a = newAsm()
	_ = emitOps(a, "vcmpps", 4, x0, x1, x64.RipLabel("x"), x64.Imm(1))
	if !emitsExactly(a, "c5 f0 c2 05 00 00 00 00 01") || !fixupIs(a, x64.FIX_REL32_LEA, 4, -1) {
		return fail("vcmpps xmm0, xmm1, [rip + x], 1")
	}
	a = newAsm()
	_ = emitOps(a, "vblendvps", 4, x0, x1, x64.RipLabel("x"), sse.Xmm(2))
	if !emitsExactly(a, "c4 e3 71 4a 05 00 00 00 00 20") || !fixupIs(a, x64.FIX_REL32_LEA, 5, -1) {
		return fail("vblendvps xmm0, xmm1, [rip + x], xmm2")
	}
	return ""
}

// rowAt reads a line's fields: an opcode extension, and the field of a line with no classes.
func TestRowAt() testing.TestResult {
	var t *[]readonly char = "\nvzeroall l1 - 0f w0 77\nvldmxcsr l0 - 0f w0 ae/2 M32\n"
			"x l0 66 3a w1 0c V128\n"
	var r row = rowAt(t, 1)
	if r.l != 1 || r.pp != 0 || r.m != 1 || r.w || r.op != 0x77 || r.ext != -1 || t[r.field] != '\n' {
		return fail("vzeroall")
	}
	r = rowAt(t, 24)
	if r.l != 0 || r.op != 0xAE || r.ext != 2 || t[r.field] != 'M' { return fail("vldmxcsr") }
	r = rowAt(t, 53)
	if r.pp != 1 || r.m != 3 || !r.w || r.op != 0x0C || t[r.field] != 'V' { return fail("x") }
	return ""
}

// The instructions clang encodes as EVEX unless {vex}, {vex2} or {vex3} is written take one here
// (asm.Assembler.X64Vex), any of the three; the others need none.
func TestEvexByDefault() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vpdpbusd", 3, sse.Xmm(0), sse.Xmm(1), sse.Xmm(2), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vpdpbusd: takes {vex} here") {
		return fail("vpdpbusd without {vex}")
	}
	a = newAsm()
	a.X64Vex = 3
	_ = emitOps(a, "VPMADD52LUQ", 3, Ymm(0), Ymm(1), Ymm(2), none)
	if !emitsExactly(a, "c4 e2 f5 b4 c2") { return fail("{vex3} vpmadd52luq ymm0, ymm1, ymm2") }
	if !evexByDefault("vcvtneps2bf16") || evexByDefault("vpdpbssd") || evexByDefault("vpdpbus") {
		return fail("evexByDefault")
	}
	return ""
}
