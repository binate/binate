package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/evex"
import "pkg/binate/asm/x64/optab"

// The table's EVEX lines: their decorations, and their encoding (pkg/binate/asm/x64/evex).

// rowDecor returns r, an EVEX line of table part t, with the decorations it takes read from the
// token at r.field — `-` for none, else `k` (a write mask), `z` (zeroing) and `b` with an
// element's size in bits (a broadcast), in that order — and its field moved past it.
func rowDecor(t *[]readonly char, r row) row {
	var end int = optab.TokenEnd(t, r.field)
	for i := r.field; i < end; i++ {
		if t[i] == 'k' { r.mask = true }
		if t[i] == 'z' { r.zero = true }
		if t[i] == 'b' { r.bcst = optab.TokenNum(t[i:end]) }
	}
	r.field = end
	if end < len(t) && t[end] == ' ' { r.field = end + 1 }
	return r
}

// decorOk reports whether the decorations of op, operand k of line r, of class tok, are ones the
// line takes: none in a VEX or XOP line; in an EVEX one, a write mask and zeroing on the first
// operand where the line takes them, and a broadcast on memory of a W or X class where the line
// takes one — memory of the element's size or of size 0, as many elements as fill the class's
// size.
func decorOk(tok *[]readonly char, op x64.Operand, k int, r row) bool {
	if op.Mask == 0 && !op.Zero && op.Bcst == 0 { return true }
	if !r.evex { return false }
	if op.Mask != 0 && (k != 0 || !r.mask) { return false }
	if op.Zero && (k != 0 || !r.zero) { return false }
	if op.Bcst == 0 { return true }
	return r.bcst > 0 && (tok[0] == 'W' || tok[0] == 'X') && x64.IsMem(op) &&
			(op.Size == 0 || op.Size == r.bcst) && op.Bcst * r.bcst == optab.TokenNum(tok)
}

// encodeEvex emits mnem by its EVEX line r: the prefix — the write mask and zeroing of the first
// operand, the flag b for a broadcast or a rounding operand, the vector length or the rounding mode
// (0 for `{sae}`, as clang) — the opcode, ModR/M with the displacement compressed by the memory's
// size, or by its element's when broadcast (x64.EmitModRMN), and up to two imm8, the operands ops
// placed by their classes.
func encodeEvex(a @asm.Assembler, mnem *[]readonly char, t *[]readonly char, r row,
		ops *[]x64.Operand) {
	var f form = formOf(t, r, ops)
	if f.imms > 0 && !x64.ImmOk(a, mnem, f.imm1, x64.SZ8) { return }
	if f.imms > 1 && !x64.ImmOk(a, mnem, f.imm2, x64.SZ8) { return }
	var ll int = r.l
	var b bool = false
	if f.hasRound {
		b = true
		ll = 0
		if f.round.Imm < 4 { ll = cast(int, f.round.Imm) }
	}
	var n int = f.rmBits / 8
	if f.rm.Bcst != 0 {
		b = true
		n = r.bcst / 8
	}
	if n < 1 { n = 1 }
	// Nothing after a prefix the encoder refused (it emits none).
	a.X64EvexDone = false
	evex.Emit(a, r.m, r.pp, f.w, ll, f.reg, f.v, f.rm, ops[0].Mask, ops[0].Zero, b)
	if !a.X64EvexDone { return }
	emit8(a, r.op)
	x64.EmitModRMN(a, f.reg, f.rm, f.imms, n)
	if f.imms > 0 { x64.EmitImm(a, mnem, f.imm1, x64.SZ8) }
	if f.imms > 1 { x64.EmitImm(a, mnem, f.imm2, x64.SZ8) }
}
