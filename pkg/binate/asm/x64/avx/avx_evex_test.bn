package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The EVEX lines (avx_evex.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): a line's decorations; those an operand may carry; the choice of a VEX
// form where one fits, else EVEX, and after {evex} or {vex}; the prefix's fields — registers
// 16..31, a write mask and zeroing, a broadcast, a rounding mode and SAE — and the compressed
// displacement; [rip + x]'s addend past an imm8; the errors.

// maskOf returns op with write mask k (1..7) and zeroing when zero.
func maskOf(op x64.Operand, k int, zero bool) x64.Operand {
	var m x64.Operand = op
	m.Mask = k
	m.Zero = zero
	return m
}

// bcstOf returns memory [rax + disp] of size bits broadcast to n elements.
func bcstOf(disp int, size int, n int) x64.Operand {
	var m x64.Operand = x64.Mem(x64.RAX, disp, size)
	m.Bcst = n
	return m
}

// emit5 emits mnem with its five operands into a fresh assembler and reports whether it holds
// exactly hex.
func emit5(mnem *[]readonly char, o1 x64.Operand, o2 x64.Operand, o3 x64.Operand, o4 x64.Operand,
		o5 x64.Operand, hex *[]readonly char) bool {
	var ops [5]x64.Operand
	ops[0] = o1
	ops[1] = o2
	ops[2] = o3
	ops[3] = o4
	ops[4] = o5
	var a @asm.Assembler = newAsm()
	if !Emit(a, mnem, ops[0:5]) { return false }
	return emitsExactly(a, hex)
}

func TestRowDecor() testing.TestResult {
	var t *[]readonly char =
		"\nvaddps e2 - 0f w0 58 kzb32 V512 H512 W512\nvcmpps e2 - 0f w0 c2 k k H512 U512 N I\n"
				"vmovlps e0 - 0f w0 13 - M64 V128\nvaddsh e0 f3 05 w0 58 kz V128 H128 W16\n"
	var r row = rowAt(t, 1)
	if !r.evex || r.l != 2 || !r.mask || !r.zero || r.bcst != 32 || t[r.field] != 'V' {
		return fail("kzb32")
	}
	var at int = optab.NextLine(t, 1)
	r = rowAt(t, at)
	if !r.evex || !r.mask || r.zero || r.bcst != 0 || t[r.field] != 'k' { return fail("k") }
	at = optab.NextLine(t, at)
	r = rowAt(t, at)
	if !r.evex || r.l != 0 || r.mask || r.zero || r.bcst != 0 || t[r.field] != 'M' { return fail("-") }
	r = rowAt(t, optab.NextLine(t, at))
	if r.m != 5 || r.pp != 2 || !r.mask || !r.zero { return fail("map 5") }
	return ""
}

func TestDecorOk() testing.TestResult {
	var t *[]readonly char =
		"\nvaddps e2 - 0f w0 58 kzb32 V512 H512 W512\nvmovaps e2 - 0f w0 29 k M512 V512\n"
				"vaddps l0 - 0f w0 58 V128 H128 W128\n"
	var kzb row = rowAt(t, 1)
	var k row = rowAt(t, optab.NextLine(t, 1))
	var vex row = rowAt(t, optab.NextLine(t, optab.NextLine(t, 1)))
	var mk x64.Operand = maskOf(Zmm(0), 1, false)
	var mz x64.Operand = maskOf(Zmm(0), 1, true)
	if !decorOk("V512", mk, 0, kzb) || decorOk("V512", mk, 1, kzb) || !decorOk("V512", mz, 0, kzb) ||
			decorOk("M512", mz, 0, k) || !decorOk("M512", maskOf(x64.Mem(x64.RAX, 0, 0), 2, false), 0, k) ||
			decorOk("V128", maskOf(sse.Xmm(0), 1, false), 0, vex) || !decorOk("V128", sse.Xmm(0), 0, vex) {
		return fail("masks")
	}
	var zmm x64.Operand = Zmm(2)
	zmm.Bcst = 16
	if !decorOk("W512", bcstOf(0, 0, 16), 2, kzb) ||
			!decorOk("W512", bcstOf(0, x64.SZ32, 16), 2, kzb) ||
			decorOk("W512", bcstOf(0, x64.SZ64, 16), 2, kzb) || decorOk("W512", bcstOf(0, 0, 8), 2, kzb) ||
			decorOk("U512", bcstOf(0, 0, 16), 2, kzb) || decorOk("W512", zmm, 2, kzb) ||
			decorOk("M512", bcstOf(0, 0, 16), 0, k) {
		return fail("broadcasts")
	}
	return ""
}

// A VEX form where one fits, else EVEX: registers 16..31, ZMM, a decoration; {evex} chooses EVEX,
// {vex} leaves it out.
func TestEvexChoice() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x0 x64.Operand = sse.Xmm(0)
	var x1 x64.Operand = sse.Xmm(1)
	var x2 x64.Operand = sse.Xmm(2)
	if !emitCase("vaddps", 3, x0, x1, x2, none, "c5 f0 58 c2") { return fail("vaddps xmm0") }
	if !emitCase("vaddps", 3, Xmm(16), x1, x2, none, "62 e1 74 08 58 c2") { return fail("xmm16") }
	if !emitCase("vaddps", 3, Zmm(0), Zmm(1), Zmm(2), none, "62 f1 74 48 58 c2") { return fail("zmm") }
	if !emitCase("vaddps", 3, maskOf(x0, 1, false), x1, x2, none, "62 f1 74 09 58 c2") {
		return fail("xmm0 {k1}")
	}
	var a @asm.Assembler = newAsm()
	a.X64Vex = 4
	_ = emitOps(a, "vaddps", 3, x0, x1, x2, none)
	if !emitsExactly(a, "62 f1 74 08 58 c2") { return fail("{evex} vaddps xmm0") }
	a = newAsm()
	a.X64Vex = 2
	_ = emitOps(a, "vaddps", 3, Zmm(0), Zmm(1), Zmm(2), none)
	if !rejected(a) { return fail("{vex} vaddps zmm0") }
	a = newAsm()
	a.X64Vex = 4
	_ = emitOps(a, "vzeroupper", 0, none, none, none, none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vzeroupper: has no EVEX form") {
		return fail("{evex} vzeroupper")
	}
	return ""
}

// The prefix's fields and the compressed displacement.
func TestEvexEncode() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var z0 x64.Operand = Zmm(0)
	var z1 x64.Operand = Zmm(1)
	var z2 x64.Operand = Zmm(2)
	if !emitCase("vaddps", 4, maskOf(z0, 1, true), z1, z2, x64.Round(0), "62 f1 74 99 58 c2") {
		return fail("vaddps zmm0 {k1} {z}, zmm1, zmm2, {rn-sae}")
	}
	if !emitCase("vaddps", 4, z0, z1, z2, x64.Round(3), "62 f1 74 78 58 c2") {
		return fail("{rz-sae}")
	}
	if !emitCase("vminps", 4, z0, z1, z2, x64.Round(4), "62 f1 74 18 5d c2") { return fail("{sae}") }
	if !emitCase("vaddps", 3, z0, z1, bcstOf(0, 0, 16), none, "62 f1 74 58 58 00") {
		return fail("[rax]{1to16}")
	}
	if !emitCase("vaddps", 3, z0, z1, bcstOf(64, 0, 16), none, "62 f1 74 58 58 40 10") {
		return fail("[rax + 64]{1to16}")
	}
	if !emitCase("vaddps", 3, z0, z1, x64.Mem(x64.RAX, 64, x64.SZ512), none, "62 f1 74 48 58 40 01") {
		return fail("zmmword ptr [rax + 64]")
	}
	if !emitCase("vaddps", 3, z0, z1, x64.Mem(x64.RAX, 4, x64.SZ512), none,
			"62 f1 74 48 58 80 04 00 00 00") {
		return fail("zmmword ptr [rax + 4]")
	}
	if !emitCase("vaddps", 3, Zmm(31), Zmm(30), x64.Mem(x64.R15, 64, x64.SZ512), none,
			"62 41 0c 40 58 7f 01") {
		return fail("zmm31, zmm30, [r15 + 64]")
	}
	if !emitCase("vcmpps", 4, maskOf(K(1), 2, false), z0, z1, x64.Imm(1), "62 f1 7c 4a c2 c9 01") {
		return fail("vcmpps k1 {k2}")
	}
	if !emit5("vcmpps", K(1), z0, z1, x64.Round(4), x64.Imm(1), "62 f1 7c 18 c2 c9 01") {
		return fail("vcmpps k1, zmm0, zmm1, {sae}, 1")
	}
	if !emitCase("vcmpeqps", 4, K(1), z0, z1, x64.Round(4), "62 f1 7c 18 c2 c9 00") {
		return fail("vcmpeqps k1, zmm0, zmm1, {sae}")
	}
	if !emitCase("vcvtsi2sd", 4, sse.Xmm(0), sse.Xmm(1), x64.Round(0), x64.Reg(x64.RAX, x64.SZ64),
			"62 f1 f7 18 2a c0") {
		return fail("vcvtsi2sd xmm0, xmm1, {rn-sae}, rax")
	}
	if !emitCase("vextractps", 3, x64.Reg(x64.RAX, x64.SZ32), Xmm(16), x64.Imm(1), none,
			"62 e3 7d 08 17 c0 01") {
		return fail("vextractps eax, xmm16, 1")
	}
	if !emitCase("vmovaps", 2, maskOf(x64.Mem(x64.RAX, 0, x64.SZ512), 1, false), z0, none, none,
			"62 f1 7c 49 29 00") {
		return fail("vmovaps zmmword ptr [rax] {k1}, zmm0")
	}
	return ""
}

// [rip + x]'s rel32 counts an imm8 after it.
func TestEvexRip() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vaddps", 3, Zmm(0), Zmm(1), x64.RipLabel("x"), none)
	if !emitsExactly(a, "62 f1 74 48 58 05 00 00 00 00") || !fixupIs(a, x64.FIX_REL32_LEA, 6, 0) {
		return fail("vaddps zmm0, zmm1, [rip + x]")
	}
	a = newAsm()
	_ = emitOps(a, "vcmpps", 4, K(1), Zmm(0), x64.RipLabel("x"), x64.Imm(1))
	if !emitsExactly(a, "62 f1 7c 48 c2 0d 00 00 00 00 01") || !fixupIs(a, x64.FIX_REL32_LEA, 6, -1) {
		return fail("vcmpps k1, zmm0, [rip + x], 1")
	}
	return ""
}

// Zeroing without a write mask, a broadcast of a register, an immediate where the rounding mode
// stands (clang reads one so), a compare predicate's name with a fourth operand not {sae}, and a
// REX prefix: errors, emitting nothing.
func TestEvexErrors() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vaddps", 3, maskOf(Zmm(0), 0, true), Zmm(1), Zmm(2), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vaddps: takes zeroing {z} only beside") {
		return fail("vaddps zmm0 {z}")
	}
	var zb x64.Operand = Zmm(2)
	zb.Bcst = 16
	a = newAsm()
	_ = emitOps(a, "vaddps", 3, Zmm(0), Zmm(1), zb, none)
	if !rejected(a) { return fail("zmm2{1to16}") }
	a = newAsm()
	_ = emitOps(a, "vaddps", 4, Zmm(0), Zmm(1), Zmm(2), x64.Imm(1))
	if !rejected(a) { return fail("vaddps zmm0, zmm1, zmm2, 1") }
	a = newAsm()
	_ = emitOps(a, "vcmpeqps", 4, K(1), Zmm(0), Zmm(1), x64.Round(0))
	if !rejected(a) { return fail("vcmpeqps k1, zmm0, zmm1, {rn-sae}") }
	a = newAsm()
	a.X64Rex = true
	_ = emitOps(a, "vaddps", 3, Zmm(0), Zmm(1), Zmm(2), none)
	if !rejected(a) { return fail("{rex} vaddps zmm0") }
	return ""
}
