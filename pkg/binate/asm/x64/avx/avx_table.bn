package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64/optab"

// The instruction table, in parts by family (tablePart): each instruction's encoding forms, a line
// each, "<mnemonic> <l> <prefix> <map> <w> <opcode> <operand classes>" — the vector length l0
// (VEX.L 0: 128 bits, or a scalar's) or l1 (256 bits), or for an EVEX form e0, e1 or e2 (EVEX.L'L:
// 128, 256 or 512 bits); the implied prefix - (none), 66, f3 or f2 (VEX.pp); the map 0f, 38 (0F 38)
// or 3a (0F 3A), EVEX's 05 or 06 (maps 5 and 6), or AMD's XOP map 08, 09 or 0a (the prefix 8F for
// VEX's C4, its implied prefix -); w0 or w1 (VEX.W or EVEX.W, which a general operand's class may
// set too, optab.GpRexW); the opcode in hex, with /0 .. /7 after it for an extension in ModR/M's
// reg field; for an EVEX form, the decorations it takes, - for none, else k (a write mask), z
// (zeroing), then b with an element's size in bits (a broadcast: b32) or s with one (the
// displacement's scale, where not the memory's size: s32), in that order (rowDecor, avx_evex.bn);
// the operand classes in Intel order (classOk, avx_class.bn).  A mnemonic's lines stand together in
// one part, its VEX or XOP forms first, in order: the first VEX or XOP form the operands match is
// encoded, unless a later one gives the two-byte prefix where it does not (emitLines, avx_emit.bn),
// which is what a commutative instruction's line with its sources in each other's places (V U H
// after V H W) and a move's store form between registers are there for; else the first EVEX form
// they match.

// tablePart returns part i of the table (from 0), or "" past the last.
func tablePart(i int) *[]readonly char {
	if i == 0 { return tableArith() }
	if i == 1 { return tableMove() }
	if i == 2 { return tableInt() }
	if i == 3 { return tableIntLogic() }
	if i == 4 { return tableIntMove() }
	if i == 5 { return tableGather() }
	if i == 6 { return tableFma() }
	if i == 7 { return tableExt() }
	if i == 8 { return tableAmd() }
	if i == 9 { return tableMask() }
	if i == 10 { return tableEvexFp() }
	if i == 11 { return tableEvexInt() }
	if i == 12 { return tableEvexIntMove() }
	return ""
}

// tableOf returns the part of the table that has mnem and the position of its first line there
// (optab.LineOf), or "" and -1.
func tableOf(mnem *[]readonly char) (*[]readonly char, int) {
	for i := 0; len(tablePart(i)) > 0; i++ {
		var t *[]readonly char = tablePart(i)
		var at int = optab.LineOf(t, mnem)
		if at >= 0 { return t, at }
	}
	return "", -1
}

// tableArith returns AVX's floating-point arithmetic part, a form a line, each after a newline:
// the VEX forms of SSE .. SSE4.1's arithmetic, logic, compares, conversions, rounding and dot
// products, and SSE3's horizontal and alternating arithmetic.
func tableArith() *[]readonly char {
	return "\n"
			"vaddps l0 - 0f w0 58 V128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V128 U128 H128\n"
			"vaddps l1 - 0f w0 58 V256 H256 W256\n"
			"vaddps l1 - 0f w0 58 V256 U256 H256\n"
			"vaddps e0 - 0f w0 58 kzb32 V128 H128 W128\n"
			"vaddps e1 - 0f w0 58 kzb32 V256 H256 W256\n"
			"vaddps e2 - 0f w0 58 kzb32 V512 H512 W512\n"
			"vaddps e2 - 0f w0 58 kz V512 H512 U512 O\n"
			"vaddpd l0 66 0f w0 58 V128 H128 W128\n"
			"vaddpd l0 66 0f w0 58 V128 U128 H128\n"
			"vaddpd l1 66 0f w0 58 V256 H256 W256\n"
			"vaddpd l1 66 0f w0 58 V256 U256 H256\n"
			"vaddpd e0 66 0f w1 58 kzb64 V128 H128 W128\n"
			"vaddpd e1 66 0f w1 58 kzb64 V256 H256 W256\n"
			"vaddpd e2 66 0f w1 58 kzb64 V512 H512 W512\n"
			"vaddpd e2 66 0f w1 58 kz V512 H512 U512 O\n"
			"vaddss l0 f3 0f w0 58 V128 H128 W32\n"
			"vaddss e0 f3 0f w0 58 kz V128 H128 W32\n"
