			"vaddsd l0 f2 0f w0 58 V128 H128 W64\n"
			"vaddsd e0 f2 0f w1 58 kz V128 H128 W64\n"
			"vaddsd e0 f2 0f w1 58 kz V128 H128 U128 O\n"
			"vmulps l0 - 0f w0 59 V128 H128 W128\n"
			"vmulps l0 - 0f w0 59 V128 U128 H128\n"
			"vmulps l1 - 0f w0 59 V256 H256 W256\n"
			"vmulps l1 - 0f w0 59 V256 U256 H256\n"
			"vmulps e0 - 0f w0 59 kzb32 V128 H128 W128\n"
			"vmulps e1 - 0f w0 59 kzb32 V256 H256 W256\n"
