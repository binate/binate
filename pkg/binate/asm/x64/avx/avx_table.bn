package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64/optab"

// The instruction table, in parts by family (tablePart): each VEX instruction's encoding forms, a
// line each, "<mnemonic> <l> <prefix> <map> <w> <opcode> <operand classes>" — the vector length
// l0 (VEX.L 0: 128 bits, or a scalar's) or l1 (256 bits); the implied prefix - (none), 66, f3 or
// f2 (VEX.pp); the map 0f, 38 (0F 38) or 3a (0F 3A); w0 or w1 (VEX.W, which a general operand's
// class may set too, optab.GpRexW); the opcode in hex, with /0 .. /7 after it for an extension in
// ModR/M's reg field; the operand classes in Intel order (classOk, avx_class.bn).  A mnemonic's
// lines stand together in one part, in order: the first the operands match is encoded, unless a
// later one gives the two-byte prefix where it does not (emitLines, avx_emit.bn), which is what a
// commutative instruction's line with its sources in each other's places (V U H after V H W) and
// a move's store form between registers are there for.

// tablePart returns part i of the table (from 0), or "" past the last.
func tablePart(i int) *[]readonly char {
	if i == 0 { return tableArith() }
	if i == 1 { return tableMove() }
	if i == 2 { return tableInt() }
	if i == 3 { return tableIntLogic() }
	if i == 4 { return tableIntMove() }
	return ""
}

// tableOf returns the part of the table that has mnem and the position of its first line there
// (optab.LineOf), or "" and -1.
func tableOf(mnem *[]readonly char) (*[]readonly char, int) {
	for i := 0; len(tablePart(i)) > 0; i++ {
		var t *[]readonly char = tablePart(i)
		var at int = optab.LineOf(t, mnem)
		if at >= 0 { return t, at }
	}
	return "", -1
}

// tableArith returns AVX's floating-point arithmetic part, a form a line, each after a newline:
// the VEX forms of SSE .. SSE4.1's arithmetic, logic, compares, conversions, rounding and dot
// products, and SSE3's horizontal and alternating arithmetic.
func tableArith() *[]readonly char {
	return "\n"
			"vaddps l0 - 0f w0 58 V128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V128 U128 H128\n"
			"vaddps l1 - 0f w0 58 V256 H256 W256\n"
			"vaddps l1 - 0f w0 58 V256 U256 H256\n"
			"vaddpd l0 66 0f w0 58 V128 H128 W128\n"
			"vaddpd l0 66 0f w0 58 V128 U128 H128\n"
			"vaddpd l1 66 0f w0 58 V256 H256 W256\n"
			"vaddpd l1 66 0f w0 58 V256 U256 H256\n"
			"vaddss l0 f3 0f w0 58 V128 H128 W32\n"
			"vaddsd l0 f2 0f w0 58 V128 H128 W64\n"
			"vmulps l0 - 0f w0 59 V128 H128 W128\n"
			"vmulps l0 - 0f w0 59 V128 U128 H128\n"
			"vmulps l1 - 0f w0 59 V256 H256 W256\n"
			"vmulps l1 - 0f w0 59 V256 U256 H256\n"
			"vmulpd l0 66 0f w0 59 V128 H128 W128\n"
			"vmulpd l0 66 0f w0 59 V128 U128 H128\n"
			"vmulpd l1 66 0f w0 59 V256 H256 W256\n"
			"vmulpd l1 66 0f w0 59 V256 U256 H256\n"
			"vmulss l0 f3 0f w0 59 V128 H128 W32\n"
			"vmulsd l0 f2 0f w0 59 V128 H128 W64\n"
			"vsubps l0 - 0f w0 5c V128 H128 W128\n"
			"vsubps l1 - 0f w0 5c V256 H256 W256\n"
			"vsubpd l0 66 0f w0 5c V128 H128 W128\n"
			"vsubpd l1 66 0f w0 5c V256 H256 W256\n"
			"vsubss l0 f3 0f w0 5c V128 H128 W32\n"
			"vsubsd l0 f2 0f w0 5c V128 H128 W64\n"
			"vminps l0 - 0f w0 5d V128 H128 W128\n"
			"vminps l1 - 0f w0 5d V256 H256 W256\n"
			"vminpd l0 66 0f w0 5d V128 H128 W128\n"
			"vminpd l1 66 0f w0 5d V256 H256 W256\n"
			"vminss l0 f3 0f w0 5d V128 H128 W32\n"
			"vminsd l0 f2 0f w0 5d V128 H128 W64\n"
			"vdivps l0 - 0f w0 5e V128 H128 W128\n"
			"vdivps l1 - 0f w0 5e V256 H256 W256\n"
			"vdivpd l0 66 0f w0 5e V128 H128 W128\n"
			"vdivpd l1 66 0f w0 5e V256 H256 W256\n"
			"vdivss l0 f3 0f w0 5e V128 H128 W32\n"
			"vdivsd l0 f2 0f w0 5e V128 H128 W64\n"
			"vmaxps l0 - 0f w0 5f V128 H128 W128\n"
			"vmaxps l1 - 0f w0 5f V256 H256 W256\n"
			"vmaxpd l0 66 0f w0 5f V128 H128 W128\n"
			"vmaxpd l1 66 0f w0 5f V256 H256 W256\n"
			"vmaxss l0 f3 0f w0 5f V128 H128 W32\n"
			"vmaxsd l0 f2 0f w0 5f V128 H128 W64\n"
			"vsqrtps l0 - 0f w0 51 V128 W128\n"
			"vsqrtps l1 - 0f w0 51 V256 W256\n"
			"vsqrtpd l0 66 0f w0 51 V128 W128\n"
			"vsqrtpd l1 66 0f w0 51 V256 W256\n"
			"vsqrtss l0 f3 0f w0 51 V128 H128 W32\n"
			"vsqrtsd l0 f2 0f w0 51 V128 H128 W64\n"
			"vrcpps l0 - 0f w0 53 V128 W128\n"
			"vrcpps l1 - 0f w0 53 V256 W256\n"
			"vrcpss l0 f3 0f w0 53 V128 H128 W32\n"
			"vrsqrtps l0 - 0f w0 52 V128 W128\n"
			"vrsqrtps l1 - 0f w0 52 V256 W256\n"
			"vrsqrtss l0 f3 0f w0 52 V128 H128 W32\n"
			"vandps l0 - 0f w0 54 V128 H128 W128\n"
			"vandps l0 - 0f w0 54 V128 U128 H128\n"
			"vandps l1 - 0f w0 54 V256 H256 W256\n"
			"vandps l1 - 0f w0 54 V256 U256 H256\n"
			"vandpd l0 66 0f w0 54 V128 H128 W128\n"
			"vandpd l0 66 0f w0 54 V128 U128 H128\n"
			"vandpd l1 66 0f w0 54 V256 H256 W256\n"
			"vandpd l1 66 0f w0 54 V256 U256 H256\n"
			"vandnps l0 - 0f w0 55 V128 H128 W128\n"
			"vandnps l1 - 0f w0 55 V256 H256 W256\n"
			"vandnpd l0 66 0f w0 55 V128 H128 W128\n"
			"vandnpd l1 66 0f w0 55 V256 H256 W256\n"
			"vorps l0 - 0f w0 56 V128 H128 W128\n"
			"vorps l0 - 0f w0 56 V128 U128 H128\n"
			"vorps l1 - 0f w0 56 V256 H256 W256\n"
			"vorps l1 - 0f w0 56 V256 U256 H256\n"
			"vorpd l0 66 0f w0 56 V128 H128 W128\n"
			"vorpd l0 66 0f w0 56 V128 U128 H128\n"
			"vorpd l1 66 0f w0 56 V256 H256 W256\n"
			"vorpd l1 66 0f w0 56 V256 U256 H256\n"
			"vxorps l0 - 0f w0 57 V128 H128 W128\n"
			"vxorps l0 - 0f w0 57 V128 U128 H128\n"
			"vxorps l1 - 0f w0 57 V256 H256 W256\n"
			"vxorps l1 - 0f w0 57 V256 U256 H256\n"
			"vxorpd l0 66 0f w0 57 V128 H128 W128\n"
			"vxorpd l0 66 0f w0 57 V128 U128 H128\n"
			"vxorpd l1 66 0f w0 57 V256 H256 W256\n"
			"vxorpd l1 66 0f w0 57 V256 U256 H256\n"
			"vcmpps l0 - 0f w0 c2 V128 H128 W128 I\n"
			"vcmpps l0 - 0f w0 c2 V128 U128 H128 C\n"
			"vcmpps l1 - 0f w0 c2 V256 H256 W256 I\n"
			"vcmpps l1 - 0f w0 c2 V256 U256 H256 C\n"
			"vcmppd l0 66 0f w0 c2 V128 H128 W128 I\n"
			"vcmppd l0 66 0f w0 c2 V128 U128 H128 C\n"
			"vcmppd l1 66 0f w0 c2 V256 H256 W256 I\n"
			"vcmppd l1 66 0f w0 c2 V256 U256 H256 C\n"
			"vcmpss l0 f3 0f w0 c2 V128 H128 W32 I\n"
			"vcmpsd l0 f2 0f w0 c2 V128 H128 W64 I\n"
			"vcomiss l0 - 0f w0 2f V128 W32\n"
			"vcomisd l0 66 0f w0 2f V128 W64\n"
			"vucomiss l0 - 0f w0 2e V128 W32\n"
			"vucomisd l0 66 0f w0 2e V128 W64\n"
			"vcvtsi2ss l0 f3 0f w0 2a V128 H128 E\n"
			"vcvtsi2sd l0 f2 0f w0 2a V128 H128 E\n"
			"vcvtss2si l0 f3 0f w0 2d G W32\n"
			"vcvtsd2si l0 f2 0f w0 2d G W64\n"
			"vcvttss2si l0 f3 0f w0 2c G W32\n"
			"vcvttsd2si l0 f2 0f w0 2c G W64\n"
			"vcvtss2sd l0 f3 0f w0 5a V128 H128 W32\n"
			"vcvtsd2ss l0 f2 0f w0 5a V128 H128 W64\n"
			"vcvtps2pd l0 - 0f w0 5a V128 W64\n"
			"vcvtps2pd l1 - 0f w0 5a V256 W128\n"
			"vcvtpd2ps l0 66 0f w0 5a V128 X128\n"
			"vcvtpd2ps l1 66 0f w0 5a V128 X256\n"
			"vcvtdq2ps l0 - 0f w0 5b V128 W128\n"
			"vcvtdq2ps l1 - 0f w0 5b V256 W256\n"
			"vcvtps2dq l0 66 0f w0 5b V128 W128\n"
			"vcvtps2dq l1 66 0f w0 5b V256 W256\n"
			"vcvttps2dq l0 f3 0f w0 5b V128 W128\n"
			"vcvttps2dq l1 f3 0f w0 5b V256 W256\n"
			"vcvtdq2pd l0 f3 0f w0 e6 V128 W64\n"
			"vcvtdq2pd l1 f3 0f w0 e6 V256 W128\n"
			"vcvtpd2dq l0 f2 0f w0 e6 V128 X128\n"
			"vcvtpd2dq l1 f2 0f w0 e6 V128 X256\n"
			"vcvttpd2dq l0 66 0f w0 e6 V128 X128\n"
			"vcvttpd2dq l1 66 0f w0 e6 V128 X256\n"
			"vaddsubps l0 f2 0f w0 d0 V128 H128 W128\n"
			"vaddsubps l1 f2 0f w0 d0 V256 H256 W256\n"
			"vaddsubpd l0 66 0f w0 d0 V128 H128 W128\n"
			"vaddsubpd l1 66 0f w0 d0 V256 H256 W256\n"
			"vhaddps l0 f2 0f w0 7c V128 H128 W128\n"
			"vhaddps l1 f2 0f w0 7c V256 H256 W256\n"
			"vhaddpd l0 66 0f w0 7c V128 H128 W128\n"
			"vhaddpd l1 66 0f w0 7c V256 H256 W256\n"
			"vhsubps l0 f2 0f w0 7d V128 H128 W128\n"
			"vhsubps l1 f2 0f w0 7d V256 H256 W256\n"
			"vhsubpd l0 66 0f w0 7d V128 H128 W128\n"
			"vhsubpd l1 66 0f w0 7d V256 H256 W256\n"
			"vdpps l0 66 3a w0 40 V128 H128 W128 I\n"
			"vdpps l1 66 3a w0 40 V256 H256 W256 I\n"
			"vdppd l0 66 3a w0 41 V128 H128 W128 I\n"
			"vroundps l0 66 3a w0 08 V128 W128 I\n"
			"vroundps l1 66 3a w0 08 V256 W256 I\n"
			"vroundpd l0 66 3a w0 09 V128 W128 I\n"
			"vroundpd l1 66 3a w0 09 V256 W256 I\n"
			"vroundss l0 66 3a w0 0a V128 H128 W32 I\n"
			"vroundsd l0 66 3a w0 0b V128 H128 W64 I\n"
}
