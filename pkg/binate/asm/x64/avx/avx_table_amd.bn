package "pkg/binate/asm/x64/avx"

// tableAmd returns AMD's part, a form a line, each after a newline: FMA4's fused multiply-adds
// (VEX, the fourth register in imm8[7:4]: W 1 puts the third operand there, so the fourth can be
// memory) and XOP's vector instructions (the prefix 8F, maps 08 and 09): vfrcz, vpcmov, vpcom, the
// horizontal adds and subtracts, the multiply-accumulates, vpperm, the rotates and shifts; and
// vpermil2ps / pd, whose imm8 holds a register and an imm4.
func tableAmd() *[]readonly char {
	return "\n"
			"vfmaddpd l0 66 3a w1 69 V128 H128 S128 W128\n"
			"vfmaddpd l0 66 3a w0 69 V128 H128 M128 S128\n"
			"vfmaddpd l1 66 3a w1 69 V256 H256 S256 W256\n"
			"vfmaddpd l1 66 3a w0 69 V256 H256 M256 S256\n"
			"vfmaddps l0 66 3a w1 68 V128 H128 S128 W128\n"
			"vfmaddps l0 66 3a w0 68 V128 H128 M128 S128\n"
			"vfmaddps l1 66 3a w1 68 V256 H256 S256 W256\n"
			"vfmaddps l1 66 3a w0 68 V256 H256 M256 S256\n"
			"vfmaddsd l0 66 3a w1 6b V128 H128 S128 W64\n"
			"vfmaddsd l0 66 3a w0 6b V128 H128 M64 S128\n"
			"vfmaddss l0 66 3a w1 6a V128 H128 S128 W32\n"
			"vfmaddss l0 66 3a w0 6a V128 H128 M32 S128\n"
			"vfmaddsubpd l0 66 3a w1 5d V128 H128 S128 W128\n"
			"vfmaddsubpd l0 66 3a w0 5d V128 H128 M128 S128\n"
			"vfmaddsubpd l1 66 3a w1 5d V256 H256 S256 W256\n"
			"vfmaddsubpd l1 66 3a w0 5d V256 H256 M256 S256\n"
			"vfmaddsubps l0 66 3a w1 5c V128 H128 S128 W128\n"
			"vfmaddsubps l0 66 3a w0 5c V128 H128 M128 S128\n"
			"vfmaddsubps l1 66 3a w1 5c V256 H256 S256 W256\n"
			"vfmaddsubps l1 66 3a w0 5c V256 H256 M256 S256\n"
			"vfmsubaddpd l0 66 3a w1 5f V128 H128 S128 W128\n"
			"vfmsubaddpd l0 66 3a w0 5f V128 H128 M128 S128\n"
			"vfmsubaddpd l1 66 3a w1 5f V256 H256 S256 W256\n"
			"vfmsubaddpd l1 66 3a w0 5f V256 H256 M256 S256\n"
			"vfmsubaddps l0 66 3a w1 5e V128 H128 S128 W128\n"
			"vfmsubaddps l0 66 3a w0 5e V128 H128 M128 S128\n"
			"vfmsubaddps l1 66 3a w1 5e V256 H256 S256 W256\n"
			"vfmsubaddps l1 66 3a w0 5e V256 H256 M256 S256\n"
			"vfmsubpd l0 66 3a w1 6d V128 H128 S128 W128\n"
			"vfmsubpd l0 66 3a w0 6d V128 H128 M128 S128\n"
			"vfmsubpd l1 66 3a w1 6d V256 H256 S256 W256\n"
			"vfmsubpd l1 66 3a w0 6d V256 H256 M256 S256\n"
			"vfmsubps l0 66 3a w1 6c V128 H128 S128 W128\n"
			"vfmsubps l0 66 3a w0 6c V128 H128 M128 S128\n"
			"vfmsubps l1 66 3a w1 6c V256 H256 S256 W256\n"
			"vfmsubps l1 66 3a w0 6c V256 H256 M256 S256\n"
			"vfmsubsd l0 66 3a w1 6f V128 H128 S128 W64\n"
			"vfmsubsd l0 66 3a w0 6f V128 H128 M64 S128\n"
			"vfmsubss l0 66 3a w1 6e V128 H128 S128 W32\n"
			"vfmsubss l0 66 3a w0 6e V128 H128 M32 S128\n"
			"vfnmaddpd l0 66 3a w1 79 V128 H128 S128 W128\n"
			"vfnmaddpd l0 66 3a w0 79 V128 H128 M128 S128\n"
			"vfnmaddpd l1 66 3a w1 79 V256 H256 S256 W256\n"
			"vfnmaddpd l1 66 3a w0 79 V256 H256 M256 S256\n"
			"vfnmaddps l0 66 3a w1 78 V128 H128 S128 W128\n"
			"vfnmaddps l0 66 3a w0 78 V128 H128 M128 S128\n"
			"vfnmaddps l1 66 3a w1 78 V256 H256 S256 W256\n"
			"vfnmaddps l1 66 3a w0 78 V256 H256 M256 S256\n"
			"vfnmaddsd l0 66 3a w1 7b V128 H128 S128 W64\n"
			"vfnmaddsd l0 66 3a w0 7b V128 H128 M64 S128\n"
			"vfnmaddss l0 66 3a w1 7a V128 H128 S128 W32\n"
			"vfnmaddss l0 66 3a w0 7a V128 H128 M32 S128\n"
			"vfnmsubpd l0 66 3a w1 7d V128 H128 S128 W128\n"
			"vfnmsubpd l0 66 3a w0 7d V128 H128 M128 S128\n"
			"vfnmsubpd l1 66 3a w1 7d V256 H256 S256 W256\n"
			"vfnmsubpd l1 66 3a w0 7d V256 H256 M256 S256\n"
			"vfnmsubps l0 66 3a w1 7c V128 H128 S128 W128\n"
			"vfnmsubps l0 66 3a w0 7c V128 H128 M128 S128\n"
			"vfnmsubps l1 66 3a w1 7c V256 H256 S256 W256\n"
			"vfnmsubps l1 66 3a w0 7c V256 H256 M256 S256\n"
			"vfnmsubsd l0 66 3a w1 7f V128 H128 S128 W64\n"
			"vfnmsubsd l0 66 3a w0 7f V128 H128 M64 S128\n"
			"vfnmsubss l0 66 3a w1 7e V128 H128 S128 W32\n"
			"vfnmsubss l0 66 3a w0 7e V128 H128 M32 S128\n"
			"vfrczpd l0 - 09 w0 81 V128 W128\n"
			"vfrczpd l1 - 09 w0 81 V256 W256\n"
			"vfrczps l0 - 09 w0 80 V128 W128\n"
			"vfrczps l1 - 09 w0 80 V256 W256\n"
			"vfrczsd l0 - 09 w0 83 V128 W64\n"
			"vfrczss l0 - 09 w0 82 V128 W32\n"
			"vpcmov l0 - 08 w0 a2 V128 H128 W128 S128\n"
			"vpcmov l1 - 08 w0 a2 V256 H256 W256 S256\n"
			"vpcmov l0 - 08 w1 a2 V128 H128 S128 M128\n"
			"vpcmov l1 - 08 w1 a2 V256 H256 S256 M256\n"
			"vpcomb l0 - 08 w0 cc V128 H128 W128 I\n"
			"vpcomd l0 - 08 w0 ce V128 H128 W128 I\n"
			"vpcomq l0 - 08 w0 cf V128 H128 W128 I\n"
			"vpcomub l0 - 08 w0 ec V128 H128 W128 I\n"
			"vpcomud l0 - 08 w0 ee V128 H128 W128 I\n"
			"vpcomuq l0 - 08 w0 ef V128 H128 W128 I\n"
			"vpcomuw l0 - 08 w0 ed V128 H128 W128 I\n"
			"vpcomw l0 - 08 w0 cd V128 H128 W128 I\n"
			"vphaddbd l0 - 09 w0 c2 V128 W128\n"
			"vphaddbq l0 - 09 w0 c3 V128 W128\n"
			"vphaddbw l0 - 09 w0 c1 V128 W128\n"
			"vphadddq l0 - 09 w0 cb V128 W128\n"
			"vphaddubd l0 - 09 w0 d2 V128 W128\n"
			"vphaddubq l0 - 09 w0 d3 V128 W128\n"
			"vphaddubw l0 - 09 w0 d1 V128 W128\n"
			"vphaddudq l0 - 09 w0 db V128 W128\n"
			"vphadduwd l0 - 09 w0 d6 V128 W128\n"
			"vphadduwq l0 - 09 w0 d7 V128 W128\n"
			"vphaddwd l0 - 09 w0 c6 V128 W128\n"
			"vphaddwq l0 - 09 w0 c7 V128 W128\n"
			"vphsubbw l0 - 09 w0 e1 V128 W128\n"
			"vphsubdq l0 - 09 w0 e3 V128 W128\n"
			"vphsubwd l0 - 09 w0 e2 V128 W128\n"
			"vpmacsdd l0 - 08 w0 9e V128 H128 W128 S128\n"
			"vpmacsdqh l0 - 08 w0 9f V128 H128 W128 S128\n"
			"vpmacsdql l0 - 08 w0 97 V128 H128 W128 S128\n"
			"vpmacssdd l0 - 08 w0 8e V128 H128 W128 S128\n"
			"vpmacssdqh l0 - 08 w0 8f V128 H128 W128 S128\n"
			"vpmacssdql l0 - 08 w0 87 V128 H128 W128 S128\n"
			"vpmacsswd l0 - 08 w0 86 V128 H128 W128 S128\n"
			"vpmacssww l0 - 08 w0 85 V128 H128 W128 S128\n"
			"vpmacswd l0 - 08 w0 96 V128 H128 W128 S128\n"
			"vpmacsww l0 - 08 w0 95 V128 H128 W128 S128\n"
			"vpmadcsswd l0 - 08 w0 a6 V128 H128 W128 S128\n"
			"vpmadcswd l0 - 08 w0 b6 V128 H128 W128 S128\n"
			"vpperm l0 - 08 w0 a3 V128 H128 W128 S128\n"
			"vpperm l0 - 08 w1 a3 V128 H128 S128 M128\n"
			"vprotb l0 - 09 w0 90 V128 W128 H128\n"
			"vprotb l0 - 09 w1 90 V128 H128 M128\n"
			"vprotb l0 - 08 w0 c0 V128 W128 I\n"
			"vprotd l0 - 09 w0 92 V128 W128 H128\n"
			"vprotd l0 - 09 w1 92 V128 H128 M128\n"
			"vprotd l0 - 08 w0 c2 V128 W128 I\n"
			"vprotq l0 - 09 w0 93 V128 W128 H128\n"
			"vprotq l0 - 09 w1 93 V128 H128 M128\n"
			"vprotq l0 - 08 w0 c3 V128 W128 I\n"
			"vprotw l0 - 09 w0 91 V128 W128 H128\n"
			"vprotw l0 - 09 w1 91 V128 H128 M128\n"
			"vprotw l0 - 08 w0 c1 V128 W128 I\n"
			"vpshab l0 - 09 w0 98 V128 W128 H128\n"
			"vpshab l0 - 09 w1 98 V128 H128 M128\n"
			"vpshad l0 - 09 w0 9a V128 W128 H128\n"
			"vpshad l0 - 09 w1 9a V128 H128 M128\n"
			"vpshaq l0 - 09 w0 9b V128 W128 H128\n"
			"vpshaq l0 - 09 w1 9b V128 H128 M128\n"
			"vpshaw l0 - 09 w0 99 V128 W128 H128\n"
			"vpshaw l0 - 09 w1 99 V128 H128 M128\n"
			"vpshlb l0 - 09 w0 94 V128 W128 H128\n"
			"vpshlb l0 - 09 w1 94 V128 H128 M128\n"
			"vpshld l0 - 09 w0 96 V128 W128 H128\n"
			"vpshld l0 - 09 w1 96 V128 H128 M128\n"
			"vpshlq l0 - 09 w0 97 V128 W128 H128\n"
			"vpshlq l0 - 09 w1 97 V128 H128 M128\n"
			"vpshlw l0 - 09 w0 95 V128 W128 H128\n"
			"vpshlw l0 - 09 w1 95 V128 H128 M128\n"
			"vpermil2ps l0 66 3a w0 48 V128 H128 W128 S128 T\n"
			"vpermil2ps l0 66 3a w1 48 V128 H128 S128 M128 T\n"
			"vpermil2ps l1 66 3a w0 48 V256 H256 W256 S256 T\n"
			"vpermil2ps l1 66 3a w1 48 V256 H256 S256 M256 T\n"
			"vpermil2pd l0 66 3a w0 49 V128 H128 W128 S128 T\n"
			"vpermil2pd l0 66 3a w1 49 V128 H128 S128 M128 T\n"
			"vpermil2pd l1 66 3a w0 49 V256 H256 W256 S256 T\n"
			"vpermil2pd l1 66 3a w1 49 V256 H256 S256 M256 T\n"
}
