			"8f 49 10 95 0a") {
		return fail("vpshlw xmm9, xmmword ptr [r10], xmm13")
	}
	return ""
}

// emitFive emits mnem with its five operands o1 .. o5 into a fresh assembler (vpermil2ps's) and
// returns it.
func emitFive(mnem *[]readonly char, o1 x64.Operand, o2 x64.Operand, o3 x64.Operand, o4 x64.Operand,
		o5 x64.Operand) @asm.Assembler {
	var a @asm.Assembler = newAsm()
	var ops [5]x64.Operand
	ops[0] = o1
	ops[1] = o2
	ops[2] = o3
	ops[3] = o4
	ops[4] = o5
	_ = Emit(a, mnem, ops[0:5])
	return a
}

// vpermil2ps / pd's imm4 beside the register in imm8 (0..15, a number); FMA4's and XOP's W, which
// puts the third operand or the fourth in imm8[7:4] (FMA4 between registers W 1, XOP's W 0, as
// clang); the shifts' and rotates' W, which picks the operand in r/m.
func TestTableAmdOperands() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = emitFive("vpermil2ps", sse.Xmm(9), sse.Xmm(10), sse.Xmm(11), sse.Xmm(12),
			x64.Imm(15))
	if !emitsExactly(a, "c4 43 29 48 cb cf") {
		return fail("vpermil2ps xmm9, xmm10, xmm11, xmm12, 15")
	}
	a = emitFive("vpermil2pd", Ymm(9), Ymm(10), x64.Mem(x64.R10, 0, x64.SZ256), Ymm(12), x64.Imm(0))
	if !emitsExactly(a, "c4 43 2d 49 0a c0") { return fail("vpermil2pd ymm9, ymm10, [r10], ymm12, 0") }
	a = emitFive("vpermil2ps", sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), x64.Mem(x64.RAX, 0, 0), x64.Imm(2))
	if !emitsExactly(a, "c4 e3 e9 48 08 32") { return fail("vpermil2ps xmm1, xmm2, xmm3, [rax], 2") }
	a = emitFive("vpermil2ps", sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), sse.Xmm(4), x64.Imm(16))
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vpermil2ps: takes an immediate of 0..15 last") {
		return fail("vpermil2ps .., 16")
	}
	a = emitFive("vpermil2ps", sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), sse.Xmm(4), x64.Imm(-1))
	if !rejected(a) { return fail("vpermil2ps .., -1") }
	a = emitFive("vpermil2ps", sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), sse.Xmm(4), x64.ImmSym("x", 0, 0))
	if !rejected(a) { return fail("vpermil2ps .., offset x") }
	var m x64.Operand = x64.Mem(x64.RAX, 0, 0)
	if !emitCase("vfmaddps", 4, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), sse.Xmm(4), "c4 e3 e9 68 cc 30") {
		return fail("vfmaddps between registers: W 1")
	}
	if !emitCase("vfmaddps", 4, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), m, "c4 e3 e9 68 08 30") {
		return fail("vfmaddps .., [rax]")
	}
	if !emitCase("vfmaddps", 4, sse.Xmm(1), sse.Xmm(2), m, sse.Xmm(4), "c4 e3 69 68 08 40") {
		return fail("vfmaddps .., [rax], xmm4")
	}
	if !emitCase("vpcmov", 4, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), sse.Xmm(4), "8f e8 68 a2 cb 40") {
		return fail("vpcmov between registers: W 0")
	}
	if !emitCase("vpcmov", 4, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), m, "8f e8 e8 a2 08 30") {
		return fail("vpcmov .., [rax]")
	}
	if !emitCase("vprotb", 3, sse.Xmm(1), sse.Xmm(2), x64.Imm(3), none, "8f e8 78 c0 ca 03") {
		return fail("vprotb xmm1, xmm2, 3")
	}
	if !emitCase("vprotb", 3, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), none, "8f e9 60 90 ca") {
		return fail("vprotb xmm1, xmm2, xmm3")
	}
	if !emitCase("vprotb", 3, sse.Xmm(1), sse.Xmm(2), m, none, "8f e9 e8 90 08") {
		return fail("vprotb xmm1, xmm2, [rax]")
	}
	if !emitCase("vpshlb", 3, sse.Xmm(1), m, sse.Xmm(3), none, "8f e9 60 94 08") {
		return fail("vpshlb xmm1, [rax], xmm3")
	}
	return ""
}
