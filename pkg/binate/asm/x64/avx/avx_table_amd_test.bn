package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The AMD part of the table (avx_table_amd.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10; the XOP prefix 8F; FMA4's and XOP's choice of W
// between registers; vpermil2ps's imm4.
func TestTableAmdForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vfmaddpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 69 0a d0") {
		return fail("vfmaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 68 0a d0") {
		return fail("vfmaddps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ64),
			"c4 43 a1 6b 0a d0") {
		return fail("vfmaddsd xmm9, xmm11, xmm13, qword ptr [r10]")
	}
	if !emitCase("vfmaddss", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ32),
			"c4 43 a1 6a 0a d0") {
		return fail("vfmaddss xmm9, xmm11, xmm13, dword ptr [r10]")
	}
	if !emitCase("vfmaddsubpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13),
			x64.Mem(x64.R10, 0, x64.SZ128), "c4 43 a1 5d 0a d0") {
		return fail("vfmaddsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsubps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13),
			x64.Mem(x64.R10, 0, x64.SZ128), "c4 43 a1 5c 0a d0") {
		return fail("vfmaddsubps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubaddpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13),
			x64.Mem(x64.R10, 0, x64.SZ128), "c4 43 a1 5f 0a d0") {
		return fail("vfmsubaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubaddps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13),
			x64.Mem(x64.R10, 0, x64.SZ128), "c4 43 a1 5e 0a d0") {
		return fail("vfmsubaddps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 6d 0a d0") {
		return fail("vfmsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 6c 0a d0") {
		return fail("vfmsubps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubsd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ64),
			"c4 43 a1 6f 0a d0") {
		return fail("vfmsubsd xmm9, xmm11, xmm13, qword ptr [r10]")
	}
	if !emitCase("vfmsubss", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ32),
			"c4 43 a1 6e 0a d0") {
		return fail("vfmsubss xmm9, xmm11, xmm13, dword ptr [r10]")
	}
	if !emitCase("vfnmaddpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 79 0a d0") {
		return fail("vfnmaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfnmaddps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 78 0a d0") {
		return fail("vfnmaddps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfnmaddsd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ64),
			"c4 43 a1 7b 0a d0") {
		return fail("vfnmaddsd xmm9, xmm11, xmm13, qword ptr [r10]")
	}
	if !emitCase("vfnmaddss", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ32),
			"c4 43 a1 7a 0a d0") {
		return fail("vfnmaddss xmm9, xmm11, xmm13, dword ptr [r10]")
	}
	if !emitCase("vfnmsubpd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 7d 0a d0") {
		return fail("vfnmsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsubps", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ128),
			"c4 43 a1 7c 0a d0") {
		return fail("vfnmsubps xmm9, xmm11, xmm13, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsubsd", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ64),
			"c4 43 a1 7f 0a d0") {
		return fail("vfnmsubsd xmm9, xmm11, xmm13, qword ptr [r10]")
	}
	if !emitCase("vfnmsubss", 4, sse.Xmm(9), sse.Xmm(11), sse.Xmm(13), x64.Mem(x64.R10, 0, x64.SZ32),
			"c4 43 a1 7e 0a d0") {
		return fail("vfnmsubss xmm9, xmm11, xmm13, dword ptr [r10]")
	}
	if !emitCase("vfrczpd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 81 0a") {
		return fail("vfrczpd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vfrczps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 80 0a") {
		return fail("vfrczps xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vfrczsd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"8f 49 78 83 0a") {
		return fail("vfrczsd xmm9, qword ptr [r10]")
	}
	if !emitCase("vfrczss", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"8f 49 78 82 0a") {
		return fail("vfrczss xmm9, dword ptr [r10]")
	}
	if !emitCase("vpcmov", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 a2 0a f0") {
		return fail("vpcmov xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpcomb", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 cc 0a 01") {
		return fail("vpcomb xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 ce 0a 01") {
		return fail("vpcomd xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomq", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 cf 0a 01") {
		return fail("vpcomq xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomub", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 ec 0a 01") {
		return fail("vpcomub xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomud", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 ee 0a 01") {
		return fail("vpcomud xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomuq", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 ef 0a 01") {
		return fail("vpcomuq xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomuw", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 ed 0a 01") {
		return fail("vpcomuw xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcomw", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"8f 48 20 cd 0a 01") {
		return fail("vpcomw xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vphaddbd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 c2 0a") {
		return fail("vphaddbd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddbq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 c3 0a") {
		return fail("vphaddbq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddbw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 c1 0a") {
		return fail("vphaddbw xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphadddq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 cb 0a") {
		return fail("vphadddq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddubd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 d2 0a") {
		return fail("vphaddubd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddubq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 d3 0a") {
		return fail("vphaddubq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddubw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 d1 0a") {
		return fail("vphaddubw xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddudq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 db 0a") {
		return fail("vphaddudq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphadduwd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 d6 0a") {
		return fail("vphadduwd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphadduwq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 d7 0a") {
		return fail("vphadduwq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddwd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 c6 0a") {
		return fail("vphaddwd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphaddwq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 c7 0a") {
		return fail("vphaddwq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphsubbw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 e1 0a") {
		return fail("vphsubbw xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphsubdq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 e3 0a") {
		return fail("vphsubdq xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vphsubwd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"8f 49 78 e2 0a") {
		return fail("vphsubwd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpmacsdd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 9e 0a f0") {
		return fail("vpmacsdd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacsdqh", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 9f 0a f0") {
		return fail("vpmacsdqh xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacsdql", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 97 0a f0") {
		return fail("vpmacsdql xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacssdd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 8e 0a f0") {
		return fail("vpmacssdd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacssdqh", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 8f 0a f0") {
		return fail("vpmacssdqh xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacssdql", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 87 0a f0") {
		return fail("vpmacssdql xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacsswd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 86 0a f0") {
		return fail("vpmacsswd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacssww", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 85 0a f0") {
		return fail("vpmacssww xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacswd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 96 0a f0") {
		return fail("vpmacswd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmacsww", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 95 0a f0") {
		return fail("vpmacsww xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmadcsswd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 a6 0a f0") {
		return fail("vpmadcsswd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpmadcswd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 b6 0a f0") {
		return fail("vpmadcswd xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpperm", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"8f 48 20 a3 0a f0") {
		return fail("vpperm xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vprotb", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 90 0a") {
		return fail("vprotb xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vprotd", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 92 0a") {
		return fail("vprotd xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vprotq", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 93 0a") {
		return fail("vprotq xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vprotw", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 91 0a") {
		return fail("vprotw xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshab", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 98 0a") {
		return fail("vpshab xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshad", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 9a 0a") {
		return fail("vpshad xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshaq", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 9b 0a") {
		return fail("vpshaq xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshaw", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 99 0a") {
		return fail("vpshaw xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshlb", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 94 0a") {
		return fail("vpshlb xmm9, xmmword ptr [r10], xmm13")
	}
	if !emitCase("vpshld", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(13), none,
			"8f 49 10 96 0a") {
		return fail("vpshld xmm9, xmmword ptr [r10], xmm13")
