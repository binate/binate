package "pkg/binate/asm/x64/avx"

// tableEvexFp16 returns the part of AVX512-FP16's half-precision arithmetic (EVEX maps 5 and 6), a
// form a line, each after a newline: add / sub / mul / div / min / max / sqrt, the FMA instructions
// and the complex multiplies (vfmaddcph .., vfcmulcsh ..), getexp / getmant, the reciprocal and
// reciprocal square root, reduce / rndscale / scalef, compares into a mask (vcmpph, vcmpsh, with
// the predicates' names: predAlias) and vfpclassph / sh, and the ordered and unordered compares
// into the flags (vcomish, vucomish).
func tableEvexFp16() *[]readonly char {
	return "\n"
			"vaddph e0 - 05 w0 58 kzb16 V128 H128 W128\n"
			"vaddph e1 - 05 w0 58 kzb16 V256 H256 W256\n"
			"vaddph e2 - 05 w0 58 kzb16 V512 H512 W512\n"
