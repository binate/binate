package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The part of AVX512-FP16's arithmetic (avx_table_evex_fp16.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each, with registers 16..31
// and its decorations; vcmp's predicates' names for ph and sh.

func TestTableEvexFp16Forms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vaddph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 58 08") {
		return fail("vaddph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vaddsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 58 08") {
		return fail("vaddsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vcmpph", 4, K(1), Xmm(18), bcstOf(0, x64.SZ16, 8), x64.Imm(1),
			"62 f3 6c 10 c2 08 01") {
		return fail("vcmpph k1, xmm18, word ptr [rax]{1to8}, 1")
	}
	if !emitCase("vcomish", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none, "62 e5 7c 08 2f 48 20") {
		return fail("vcomish xmm17, [rax + 64]")
	}
	if !emitCase("vdivph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 5e 08") {
		return fail("vdivph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vdivsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 5e 08") {
		return fail("vdivsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfcmaddcph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e6 6f 10 56 08") {
		return fail("vfcmaddcph xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfcmaddcsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6f 85 57 08") {
		return fail("vfcmaddcsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfcmulcph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e6 6f 10 d6 08") {
		return fail("vfcmulcph xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfcmulcsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6f 85 d7 08") {
		return fail("vfcmulcsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 98 08") {
		return fail("vfmadd132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmadd132sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 99 08") {
		return fail("vfmadd132sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 a8 08") {
		return fail("vfmadd213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmadd213sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 a9 08") {
		return fail("vfmadd213sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 b8 08") {
		return fail("vfmadd231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmadd231sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 b9 08") {
		return fail("vfmadd231sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmaddcph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e6 6e 10 56 08") {
		return fail("vfmaddcph xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmaddcsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6e 85 57 08") {
		return fail("vfmaddcsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmaddsub132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 96 08") {
		return fail("vfmaddsub132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmaddsub213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 a6 08") {
		return fail("vfmaddsub213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmaddsub231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 b6 08") {
		return fail("vfmaddsub231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsub132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 9a 08") {
		return fail("vfmsub132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsub132sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 9b 08") {
		return fail("vfmsub132sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 aa 08") {
		return fail("vfmsub213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsub213sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 ab 08") {
		return fail("vfmsub213sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 ba 08") {
		return fail("vfmsub231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsub231sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 bb 08") {
		return fail("vfmsub231sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsubadd132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 97 08") {
		return fail("vfmsubadd132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsubadd213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 a7 08") {
		return fail("vfmsubadd213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmsubadd231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 b7 08") {
		return fail("vfmsubadd231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfmulcph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e6 6e 10 d6 08") {
		return fail("vfmulcph xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmulcsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6e 85 d7 08") {
		return fail("vfmulcsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 9c 08") {
		return fail("vfnmadd132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmadd132sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 9d 08") {
		return fail("vfnmadd132sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 ac 08") {
		return fail("vfnmadd213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmadd213sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 ad 08") {
		return fail("vfnmadd213sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 bc 08") {
		return fail("vfnmadd231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmadd231sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 bd 08") {
		return fail("vfnmadd231sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub132ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 9e 08") {
		return fail("vfnmsub132ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmsub132sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 9f 08") {
		return fail("vfnmsub132sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub213ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 ae 08") {
		return fail("vfnmsub213ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmsub213sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 af 08") {
		return fail("vfnmsub213sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub231ph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none,
			"62 e6 6d 10 be 08") {
		return fail("vfnmsub231ph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vfnmsub231sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 bf 08") {
		return fail("vfnmsub231sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfpclassph", 3, K(1), bcstOf(0, x64.SZ16, 8), x64.Imm(1), none,
			"62 f3 7c 18 66 08 01") {
		return fail("vfpclassph k1, word ptr [rax]{1to8}, 1")
	}
	if !emitCase("vgetexpph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e6 7d 18 42 08") {
		return fail("vgetexpph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vgetexpsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 43 08") {
		return fail("vgetexpsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vgetmantph", 3, Xmm(17), bcstOf(0, x64.SZ16, 8), x64.Imm(1), none,
			"62 e3 7c 18 26 08 01") {
		return fail("vgetmantph xmm17, word ptr [rax]{1to8}, 1")
	}
	if !emitCase("vgetmantsh", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6c 85 27 08 01") {
		return fail("vgetmantsh xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vmaxph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 5f 08") {
		return fail("vmaxph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vmaxsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 5f 08") {
		return fail("vmaxsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vminph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 5d 08") {
		return fail("vminph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vminsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 5d 08") {
		return fail("vminsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vmulph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 59 08") {
		return fail("vmulph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vmulsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 59 08") {
		return fail("vmulsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vrcpph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e6 7d 18 4c 08") {
		return fail("vrcpph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vrcpsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 4d 08") {
		return fail("vrcpsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vreduceph", 3, Xmm(17), bcstOf(0, x64.SZ16, 8), x64.Imm(1), none,
			"62 e3 7c 18 56 08 01") {
		return fail("vreduceph xmm17, word ptr [rax]{1to8}, 1")
	}
	if !emitCase("vreducesh", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 6c 85 57 08 01") {
		return fail("vreducesh xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vrndscaleph", 3, Xmm(17), bcstOf(0, x64.SZ16, 8), x64.Imm(1), none,
			"62 e3 7c 18 08 08 01") {
		return fail("vrndscaleph xmm17, word ptr [rax]{1to8}, 1")
	}
	if !emitCase("vrndscalesh", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6c 85 0a 08 01") {
		return fail("vrndscalesh xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vrsqrtph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e6 7d 18 4e 08") {
		return fail("vrsqrtph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vrsqrtsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 4f 08") {
		return fail("vrsqrtsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vscalefph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e6 6d 10 2c 08") {
		return fail("vscalefph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vscalefsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6d 85 2d 08") {
		return fail("vscalefsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vsqrtph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7c 18 51 08") {
		return fail("vsqrtph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vsqrtsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 51 08") {
		return fail("vsqrtsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vsubph", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ16, 8), none, "62 e5 6c 10 5c 08") {
		return fail("vsubph xmm17, xmm18, word ptr [rax]{1to8}")
	}
	if !emitCase("vsubsh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 5c 08") {
		return fail("vsubsh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vucomish", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none, "62 e5 7c 08 2e 48 20") {
		return fail("vucomish xmm17, [rax + 64]")
	}
	if !emitCase("vfpclasssh", 3, maskOf(K(1), 5, false), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none,
			"62 f3 7c 0d 67 08 01") {
		return fail("vfpclasssh k1 {k5}, [rax], 1")
	}
	if !emitCase("vcmpsh", 4, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 f3 6e 05 c2 08 01") {
		return fail("vcmpsh k1 {k5}, xmm18, [rax], 1")
	}
	return ""
}

func TestTableEvexFp16Predicates() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vcmpeqph", 3, K(1), Zmm(0), Zmm(1), none, "62 f3 7c 48 c2 c9 00") {
		return fail("vcmpeqph")
	}
	if !emitCase("vcmptrue_usph", 3, K(1), Ymm(0), Ymm(1), none, "62 f3 7c 28 c2 c9 1f") {
		return fail("vcmptrue_usph")
	}
	if !emitCase("vcmpneqsh", 3, maskOf(K(1), 2, false), Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ16), none,
			"62 f3 7e 0a c2 08 04") {
		return fail("vcmpneqsh k1 {k2}, xmm0, word ptr [rax]")
	}
	if !emitCase("vcmpeqph", 4, K(1), Zmm(0), Zmm(1), x64.Round(4), "62 f3 7c 18 c2 c9 00") {
		return fail("vcmpeqph k1, zmm0, zmm1, {sae}")
	}
	return ""
}

// A complex multiply whose destination is one of its sources faults: an error, as GNU as's.
func TestTableEvexFp16Distinct() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vfmulcph", 3, Xmm(1), Xmm(1), Xmm(2), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vfmulcph: takes a destination register") {
		return fail("vfmulcph xmm1, xmm1, xmm2")
	}
	a = newAsm()
	_ = emitOps(a, "vfmaddcsh", 3, Xmm(1), Xmm(2), Xmm(1), none)
	if !rejected(a) { return fail("vfmaddcsh xmm1, xmm2, xmm1") }
	a = newAsm()
	_ = emitOps(a, "VFCMULCPH", 3, Zmm(17), Zmm(17), x64.Mem(x64.RAX, 0, 0), none)
	if !rejected(a) { return fail("vfcmulcph zmm17, zmm17, [rax]") }
	if !emitCase("vfmulcph", 3, Xmm(1), Xmm(2), x64.Mem(x64.RAX, 0, 0), none, "62 f6 6e 08 d6 08") {
		return fail("vfmulcph xmm1, xmm2, [rax]")
	}
	if !emitCase("vfmaddcsh", 3, Xmm(1), Xmm(2), Xmm(3), none, "62 f6 6e 08 57 cb") {
		return fail("vfmaddcsh xmm1, xmm2, xmm3")
	}
	return ""
}
