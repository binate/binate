package "pkg/binate/asm/x64/avx"

// tableEvexFp16Cvt returns the part of AVX512-FP16's conversions and moves (EVEX maps 5 and 6), a
// form a line, each after a newline: half precision to and from single and double precision, signed
// and unsigned words, doublewords and quadwords and general registers, with or without truncation,
// and vmovsh and vmovw.
func tableEvexFp16Cvt() *[]readonly char {
	return "\n"
			"vcvtdq2ph e0 - 05 w0 5b kzb32 V128 X128\n"
			"vcvtdq2ph e1 - 05 w0 5b kzb32 V128 X256\n"
			"vcvtdq2ph e2 - 05 w0 5b kzb32 V256 W512\n"
			"vcvtdq2ph e2 - 05 w0 5b kz V256 U512 O\n"
			"vcvtpd2ph e0 66 05 w1 5a kzb64 V128 X128\n"
			"vcvtpd2ph e1 66 05 w1 5a kzb64 V128 X256\n"
			"vcvtpd2ph e2 66 05 w1 5a kzb64 V128 X512\n"
			"vcvtpd2ph e2 66 05 w1 5a kz V128 U512 O\n"
			"vcvtph2dq e0 66 05 w0 5b kzb16 V128 W64\n"
			"vcvtph2dq e1 66 05 w0 5b kzb16 V256 W128\n"
			"vcvtph2dq e2 66 05 w0 5b kzb16 V512 W256\n"
			"vcvtph2dq e2 66 05 w0 5b kz V512 U256 O\n"
			"vcvtph2pd e0 - 05 w0 5a kzb16 V128 W32\n"
			"vcvtph2pd e1 - 05 w0 5a kzb16 V256 W64\n"
			"vcvtph2pd e2 - 05 w0 5a kzb16 V512 W128\n"
			"vcvtph2pd e2 - 05 w0 5a kz V512 U128 N\n"
			"vcvtph2psx e0 66 06 w0 13 kzb16 V128 W64\n"
			"vcvtph2psx e1 66 06 w0 13 kzb16 V256 W128\n"
			"vcvtph2psx e2 66 06 w0 13 kzb16 V512 W256\n"
			"vcvtph2psx e2 66 06 w0 13 kz V512 U256 N\n"
			"vcvtph2qq e0 66 05 w0 7b kzb16 V128 W32\n"
			"vcvtph2qq e1 66 05 w0 7b kzb16 V256 W64\n"
			"vcvtph2qq e2 66 05 w0 7b kzb16 V512 W128\n"
			"vcvtph2qq e2 66 05 w0 7b kz V512 U128 O\n"
			"vcvtph2udq e0 - 05 w0 79 kzb16 V128 W64\n"
			"vcvtph2udq e1 - 05 w0 79 kzb16 V256 W128\n"
			"vcvtph2udq e2 - 05 w0 79 kzb16 V512 W256\n"
			"vcvtph2udq e2 - 05 w0 79 kz V512 U256 O\n"
			"vcvtph2uqq e0 66 05 w0 79 kzb16 V128 W32\n"
			"vcvtph2uqq e1 66 05 w0 79 kzb16 V256 W64\n"
			"vcvtph2uqq e2 66 05 w0 79 kzb16 V512 W128\n"
			"vcvtph2uqq e2 66 05 w0 79 kz V512 U128 O\n"
			"vcvtph2uw e0 - 05 w0 7d kzb16 V128 W128\n"
			"vcvtph2uw e1 - 05 w0 7d kzb16 V256 W256\n"
			"vcvtph2uw e2 - 05 w0 7d kzb16 V512 W512\n"
			"vcvtph2uw e2 - 05 w0 7d kz V512 U512 O\n"
			"vcvtph2w e0 66 05 w0 7d kzb16 V128 W128\n"
			"vcvtph2w e1 66 05 w0 7d kzb16 V256 W256\n"
			"vcvtph2w e2 66 05 w0 7d kzb16 V512 W512\n"
			"vcvtph2w e2 66 05 w0 7d kz V512 U512 O\n"
			"vcvtps2phx e0 66 05 w0 1d kzb32 V128 X128\n"
			"vcvtps2phx e1 66 05 w0 1d kzb32 V128 X256\n"
			"vcvtps2phx e2 66 05 w0 1d kzb32 V256 W512\n"
			"vcvtps2phx e2 66 05 w0 1d kz V256 U512 O\n"
			"vcvtqq2ph e0 - 05 w1 5b kzb64 V128 X128\n"
			"vcvtqq2ph e1 - 05 w1 5b kzb64 V128 X256\n"
			"vcvtqq2ph e2 - 05 w1 5b kzb64 V128 X512\n"
			"vcvtqq2ph e2 - 05 w1 5b kz V128 U512 O\n"
			"vcvtsd2sh e0 f2 05 w1 5a kz V128 H128 W64\n"
			"vcvtsd2sh e0 f2 05 w1 5a kz V128 H128 U128 O\n"
			"vcvtsh2sd e0 f3 05 w0 5a kz V128 H128 W16\n"
			"vcvtsh2sd e0 f3 05 w0 5a kz V128 H128 U128 N\n"
			"vcvtsh2si e0 f3 05 w0 2d - G W16\n"
			"vcvtsh2si e0 f3 05 w0 2d - G U128 O\n"
			"vcvtsh2ss e0 - 06 w0 13 kz V128 H128 W16\n"
			"vcvtsh2ss e0 - 06 w0 13 kz V128 H128 U128 N\n"
			"vcvtsh2usi e0 f3 05 w0 79 - G W16\n"
			"vcvtsh2usi e0 f3 05 w0 79 - G U128 O\n"
			"vcvtsi2sh e0 f3 05 w0 2a - V128 H128 E\n"
			"vcvtsi2sh e0 f3 05 w0 2a - V128 H128 O Y32\n"
			"vcvtsi2sh e0 f3 05 w0 2a - V128 H128 O Y\n"
			"vcvtss2sh e0 - 05 w0 1d kz V128 H128 W32\n"
			"vcvtss2sh e0 - 05 w0 1d kz V128 H128 U128 O\n"
			"vcvttph2dq e0 f3 05 w0 5b kzb16 V128 W64\n"
			"vcvttph2dq e1 f3 05 w0 5b kzb16 V256 W128\n"
			"vcvttph2dq e2 f3 05 w0 5b kzb16 V512 W256\n"
			"vcvttph2dq e2 f3 05 w0 5b kz V512 U256 N\n"
			"vcvttph2qq e0 66 05 w0 7a kzb16 V128 W32\n"
			"vcvttph2qq e1 66 05 w0 7a kzb16 V256 W64\n"
			"vcvttph2qq e2 66 05 w0 7a kzb16 V512 W128\n"
			"vcvttph2qq e2 66 05 w0 7a kz V512 U128 N\n"
			"vcvttph2udq e0 - 05 w0 78 kzb16 V128 W64\n"
			"vcvttph2udq e1 - 05 w0 78 kzb16 V256 W128\n"
			"vcvttph2udq e2 - 05 w0 78 kzb16 V512 W256\n"
			"vcvttph2udq e2 - 05 w0 78 kz V512 U256 N\n"
			"vcvttph2uqq e0 66 05 w0 78 kzb16 V128 W32\n"
			"vcvttph2uqq e1 66 05 w0 78 kzb16 V256 W64\n"
			"vcvttph2uqq e2 66 05 w0 78 kzb16 V512 W128\n"
			"vcvttph2uqq e2 66 05 w0 78 kz V512 U128 N\n"
			"vcvttph2uw e0 - 05 w0 7c kzb16 V128 W128\n"
			"vcvttph2uw e1 - 05 w0 7c kzb16 V256 W256\n"
			"vcvttph2uw e2 - 05 w0 7c kzb16 V512 W512\n"
			"vcvttph2uw e2 - 05 w0 7c kz V512 U512 N\n"
			"vcvttph2w e0 66 05 w0 7c kzb16 V128 W128\n"
			"vcvttph2w e1 66 05 w0 7c kzb16 V256 W256\n"
			"vcvttph2w e2 66 05 w0 7c kzb16 V512 W512\n"
			"vcvttph2w e2 66 05 w0 7c kz V512 U512 N\n"
			"vcvttsh2si e0 f3 05 w0 2c - G W16\n"
			"vcvttsh2si e0 f3 05 w0 2c - G U128 N\n"
			"vcvttsh2usi e0 f3 05 w0 78 - G W16\n"
			"vcvttsh2usi e0 f3 05 w0 78 - G U128 N\n"
			"vcvtudq2ph e0 f2 05 w0 7a kzb32 V128 X128\n"
			"vcvtudq2ph e1 f2 05 w0 7a kzb32 V128 X256\n"
			"vcvtudq2ph e2 f2 05 w0 7a kzb32 V256 W512\n"
			"vcvtudq2ph e2 f2 05 w0 7a kz V256 U512 O\n"
			"vcvtuqq2ph e0 f2 05 w1 7a kzb64 V128 X128\n"
			"vcvtuqq2ph e1 f2 05 w1 7a kzb64 V128 X256\n"
			"vcvtuqq2ph e2 f2 05 w1 7a kzb64 V128 X512\n"
			"vcvtuqq2ph e2 f2 05 w1 7a kz V128 U512 O\n"
			"vcvtusi2sh e0 f3 05 w0 7b - V128 H128 E\n"
			"vcvtusi2sh e0 f3 05 w0 7b - V128 H128 O Y32\n"
			"vcvtusi2sh e0 f3 05 w0 7b - V128 H128 O Y\n"
			"vcvtuw2ph e0 f2 05 w0 7d kzb16 V128 W128\n"
			"vcvtuw2ph e1 f2 05 w0 7d kzb16 V256 W256\n"
			"vcvtuw2ph e2 f2 05 w0 7d kzb16 V512 W512\n"
			"vcvtuw2ph e2 f2 05 w0 7d kz V512 U512 O\n"
			"vcvtw2ph e0 f3 05 w0 7d kzb16 V128 W128\n"
			"vcvtw2ph e1 f3 05 w0 7d kzb16 V256 W256\n"
			"vcvtw2ph e2 f3 05 w0 7d kzb16 V512 W512\n"
			"vcvtw2ph e2 f3 05 w0 7d kz V512 U512 O\n"
			"vmovsh e0 f3 05 w0 10 kz V128 M16\n"
			"vmovsh e0 f3 05 w0 11 k M16 V128\n"
			"vmovsh e0 f3 05 w0 10 kz V128 H128 U128\n"
			"vmovsh.s e0 f3 05 w0 11 kz U128 H128 V128\n"
			"vmovw e0 66 05 w0 6e - V128 K16\n"
			"vmovw e0 66 05 w1 6e - V128 Y\n"
			"vmovw e0 66 05 w0 7e - K16 V128\n"
			"vmovw e0 66 05 w1 7e - Y V128\n"
}
