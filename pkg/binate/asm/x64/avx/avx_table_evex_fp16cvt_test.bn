package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The part of AVX512-FP16's conversions and moves (avx_table_evex_fp16cvt.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each, with registers
// 16..31 and its decorations; vmovw's register and memory forms.

func TestTableEvexFp16CvtForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vcvtdq2ph", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e5 7c 18 5b 08") {
		return fail("vcvtdq2ph xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtpd2ph", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e5 fd 18 5a 08") {
		return fail("vcvtpd2ph xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtph2dq", 2, Xmm(17), bcstOf(0, x64.SZ16, 4), none, none, "62 e5 7d 18 5b 08") {
		return fail("vcvtph2dq xmm17, word ptr [rax]{1to4}")
	}
	if !emitCase("vcvtph2pd", 2, Xmm(17), bcstOf(0, x64.SZ16, 2), none, none, "62 e5 7c 18 5a 08") {
		return fail("vcvtph2pd xmm17, word ptr [rax]{1to2}")
	}
	if !emitCase("vcvtph2psx", 2, Xmm(17), bcstOf(0, x64.SZ16, 4), none, none, "62 e6 7d 18 13 08") {
		return fail("vcvtph2psx xmm17, word ptr [rax]{1to4}")
	}
	if !emitCase("vcvtph2qq", 2, Xmm(17), bcstOf(0, x64.SZ16, 2), none, none, "62 e5 7d 18 7b 08") {
		return fail("vcvtph2qq xmm17, word ptr [rax]{1to2}")
	}
	if !emitCase("vcvtph2udq", 2, Xmm(17), bcstOf(0, x64.SZ16, 4), none, none, "62 e5 7c 18 79 08") {
		return fail("vcvtph2udq xmm17, word ptr [rax]{1to4}")
	}
	if !emitCase("vcvtph2uqq", 2, Xmm(17), bcstOf(0, x64.SZ16, 2), none, none, "62 e5 7d 18 79 08") {
		return fail("vcvtph2uqq xmm17, word ptr [rax]{1to2}")
	}
	if !emitCase("vcvtph2uw", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7c 18 7d 08") {
		return fail("vcvtph2uw xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vcvtph2w", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7d 18 7d 08") {
		return fail("vcvtph2w xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vcvtps2phx", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e5 7d 18 1d 08") {
		return fail("vcvtps2phx xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtqq2ph", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e5 fc 18 5b 08") {
		return fail("vcvtqq2ph xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtsd2sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 ef 85 5a 08") {
		return fail("vcvtsd2sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vcvtsh2sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6e 85 5a 08") {
		return fail("vcvtsh2sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vcvtsh2si", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 75 7e 08 2d 48 20") {
		return fail("vcvtsh2si r9d, [rax + 64]")
	}
	if !emitCase("vcvtsh2ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e6 6c 85 13 08") {
		return fail("vcvtsh2ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vcvtsh2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 75 7e 08 79 48 20") {
		return fail("vcvtsh2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvtsi2sh", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, x64.SZ32), none,
			"62 e5 6e 00 2a 48 10") {
		return fail("vcvtsi2sh xmm17, xmm18, dword ptr [rax + 64]")
	}
	if !emitCase("vcvtss2sh", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e5 6c 85 1d 08") {
		return fail("vcvtss2sh xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vcvttph2dq", 2, Xmm(17), bcstOf(0, x64.SZ16, 4), none, none, "62 e5 7e 18 5b 08") {
		return fail("vcvttph2dq xmm17, word ptr [rax]{1to4}")
	}
	if !emitCase("vcvttph2qq", 2, Xmm(17), bcstOf(0, x64.SZ16, 2), none, none, "62 e5 7d 18 7a 08") {
		return fail("vcvttph2qq xmm17, word ptr [rax]{1to2}")
	}
	if !emitCase("vcvttph2udq", 2, Xmm(17), bcstOf(0, x64.SZ16, 4), none, none, "62 e5 7c 18 78 08") {
		return fail("vcvttph2udq xmm17, word ptr [rax]{1to4}")
	}
	if !emitCase("vcvttph2uqq", 2, Xmm(17), bcstOf(0, x64.SZ16, 2), none, none, "62 e5 7d 18 78 08") {
		return fail("vcvttph2uqq xmm17, word ptr [rax]{1to2}")
	}
	if !emitCase("vcvttph2uw", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7c 18 7c 08") {
		return fail("vcvttph2uw xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vcvttph2w", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7d 18 7c 08") {
		return fail("vcvttph2w xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vcvttsh2si", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 75 7e 08 2c 48 20") {
		return fail("vcvttsh2si r9d, [rax + 64]")
	}
	if !emitCase("vcvttsh2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 75 7e 08 78 48 20") {
		return fail("vcvttsh2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvtudq2ph", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e5 7f 18 7a 08") {
		return fail("vcvtudq2ph xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtuqq2ph", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e5 ff 18 7a 08") {
		return fail("vcvtuqq2ph xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtusi2sh", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, x64.SZ32), none,
			"62 e5 6e 00 7b 48 10") {
		return fail("vcvtusi2sh xmm17, xmm18, dword ptr [rax + 64]")
	}
	if !emitCase("vcvtuw2ph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7f 18 7d 08") {
		return fail("vcvtuw2ph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vcvtw2ph", 2, Xmm(17), bcstOf(0, x64.SZ16, 8), none, none, "62 e5 7e 18 7d 08") {
		return fail("vcvtw2ph xmm17, word ptr [rax]{1to8}")
	}
	if !emitCase("vmovsh", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e5 7e 8d 10 08") {
		return fail("vmovsh xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovsh.s", 3, maskOf(Xmm(17), 5, true), Xmm(18), Xmm(20), none,
			"62 a5 6e 85 11 e1") {
		return fail("vmovsh.s xmm17 {k5} {z}, xmm18, xmm20")
	}
	if !emitCase("vmovw", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none, "62 e5 7d 08 6e 48 20") {
		return fail("vmovw xmm17, [rax + 64]")
	}
	if !emitCase("vmovw", 2, sse.Xmm(0), x64.Reg(x64.RAX, x64.SZ32), none, none, "62 f5 7d 08 6e c0") {
		return fail("vmovw xmm0, eax")
	}
	if !emitCase("vmovw", 2, x64.Mem(x64.RAX, 64, x64.SZ16), sse.Xmm(0), none, none,
			"62 f5 7d 08 7e 40 20") {
		return fail("vmovw word ptr [rax + 64], xmm0")
	}
	if !emitCase("vmovw", 2, x64.Reg(x64.RAX, x64.SZ64), sse.Xmm(0), none, none, "62 f5 fd 08 7e c0") {
		return fail("vmovw rax, xmm0")
	}
	if !emitCase("vcvtsi2sh", 4, sse.Xmm(0), sse.Xmm(1), x64.Round(0), x64.Reg(x64.RAX, x64.SZ32),
			"62 f5 76 18 2a c0") {
		return fail("vcvtsi2sh xmm0, xmm1, {rn-sae}, eax")
	}
	if !emitCase("vcvtusi2sh", 4, sse.Xmm(0), sse.Xmm(1), x64.Round(0), x64.Reg(x64.RAX, x64.SZ64),
			"62 f5 f6 18 7b c0") {
		return fail("vcvtusi2sh xmm0, xmm1, {rn-sae}, rax")
	}
	return ""
}
