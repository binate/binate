package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The part of AVX-512's floating-point instructions with no VEX form (avx_table_evex_fp.bn) against
// clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each,
// with registers 16..31 and its decorations; compress / expand's displacement scaled by an element;
// zeroing refused on a store; memory of no size where only its size picks the form.

func TestTableEvexFpForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vblendmpd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 65 08") {
		return fail("vblendmpd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vblendmps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 65 08") {
		return fail("vblendmps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vbroadcastf32x2", 2, maskOf(Ymm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d ad 19 08") {
		return fail("vbroadcastf32x2 ymm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcastf32x4", 2, maskOf(Ymm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d ad 1a 08") {
		return fail("vbroadcastf32x4 ymm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcastf32x8", 2, maskOf(Zmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d cd 1b 08") {
		return fail("vbroadcastf32x8 zmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcastf64x2", 2, maskOf(Ymm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd ad 1a 08") {
		return fail("vbroadcastf64x2 ymm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcastf64x4", 2, maskOf(Zmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd cd 1b 08") {
		return fail("vbroadcastf64x4 zmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vcompresspd", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 fd 0d 8a 10") {
		return fail("vcompresspd [rax] {k5}, xmm18")
	}
	if !emitCase("vcompressps", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7d 0d 8a 10") {
		return fail("vcompressps [rax] {k5}, xmm18")
	}
	if !emitCase("vcvtpd2qq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fd 18 7b 08") {
		return fail("vcvtpd2qq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtpd2udq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fc 18 79 08") {
		return fail("vcvtpd2udq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtpd2uqq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fd 18 79 08") {
		return fail("vcvtpd2uqq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtps2qq", 2, Xmm(17), bcstOf(0, x64.SZ32, 2), none, none, "62 e1 7d 18 7b 08") {
		return fail("vcvtps2qq xmm17, dword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtps2udq", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e1 7c 18 79 08") {
		return fail("vcvtps2udq xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtps2uqq", 2, Xmm(17), bcstOf(0, x64.SZ32, 2), none, none, "62 e1 7d 18 79 08") {
		return fail("vcvtps2uqq xmm17, dword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtqq2pd", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fe 18 e6 08") {
		return fail("vcvtqq2pd xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtqq2ps", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fc 18 5b 08") {
		return fail("vcvtqq2ps xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtsd2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 71 7f 08 79 48 08") {
		return fail("vcvtsd2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvtss2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 71 7e 08 79 48 10") {
		return fail("vcvtss2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvttpd2qq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fd 18 7a 08") {
		return fail("vcvttpd2qq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvttpd2udq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fc 18 78 08") {
		return fail("vcvttpd2udq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvttpd2uqq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fd 18 78 08") {
		return fail("vcvttpd2uqq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvttps2qq", 2, Xmm(17), bcstOf(0, x64.SZ32, 2), none, none, "62 e1 7d 18 7a 08") {
		return fail("vcvttps2qq xmm17, dword ptr [rax]{1to2}")
	}
	if !emitCase("vcvttps2udq", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e1 7c 18 78 08") {
		return fail("vcvttps2udq xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvttps2uqq", 2, Xmm(17), bcstOf(0, x64.SZ32, 2), none, none, "62 e1 7d 18 78 08") {
		return fail("vcvttps2uqq xmm17, dword ptr [rax]{1to2}")
	}
	if !emitCase("vcvttsd2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 71 7f 08 78 48 08") {
		return fail("vcvttsd2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvttss2usi", 2, x64.Reg(x64.R9, x64.SZ32), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 71 7e 08 78 48 10") {
		return fail("vcvttss2usi r9d, [rax + 64]")
	}
	if !emitCase("vcvtudq2pd", 2, Xmm(17), bcstOf(0, x64.SZ32, 2), none, none, "62 e1 7e 18 7a 08") {
		return fail("vcvtudq2pd xmm17, dword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtudq2ps", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e1 7f 18 7a 08") {
		return fail("vcvtudq2ps xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtuqq2pd", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 fe 18 7a 08") {
		return fail("vcvtuqq2pd xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtuqq2ps", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e1 ff 18 7a 08") {
		return fail("vcvtuqq2ps xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vcvtusi2sd", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, x64.SZ32), none,
			"62 e1 6f 00 7b 48 10") {
		return fail("vcvtusi2sd xmm17, xmm18, dword ptr [rax + 64]")
	}
	if !emitCase("vcvtusi2ss", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, x64.SZ32), none,
			"62 e1 6e 00 7b 48 10") {
		return fail("vcvtusi2ss xmm17, xmm18, dword ptr [rax + 64]")
	}
	if !emitCase("vexpandpd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd 8d 88 08") {
		return fail("vexpandpd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vexpandps", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 88 08") {
		return fail("vexpandps xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vextractf32x4", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Ymm(18), x64.Imm(1),
			none, "62 e3 7d 2d 19 10 01") {
		return fail("vextractf32x4 [rax] {k5}, ymm18, 1")
	}
	if !emitCase("vextractf32x8", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Zmm(18), x64.Imm(1),
			none, "62 e3 7d 4d 1b 10 01") {
		return fail("vextractf32x8 [rax] {k5}, zmm18, 1")
	}
	if !emitCase("vextractf64x2", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Ymm(18), x64.Imm(1),
			none, "62 e3 fd 2d 19 10 01") {
		return fail("vextractf64x2 [rax] {k5}, ymm18, 1")
	}
	if !emitCase("vextractf64x4", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Zmm(18), x64.Imm(1),
			none, "62 e3 fd 4d 1b 10 01") {
		return fail("vextractf64x4 [rax] {k5}, zmm18, 1")
	}
	if !emitCase("vfixupimmpd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 54 08 01") {
		return fail("vfixupimmpd xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vfixupimmps", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 54 08 01") {
		return fail("vfixupimmps xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vfixupimmsd", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed 85 55 08 01") {
		return fail("vfixupimmsd xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vfixupimmss", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d 85 55 08 01") {
		return fail("vfixupimmss xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vfpclasspd", 3, K(1), bcstOf(0, x64.SZ64, 2), x64.Imm(1), none,
			"62 f3 fd 18 66 08 01") {
		return fail("vfpclasspd k1, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vfpclassps", 3, K(1), bcstOf(0, x64.SZ32, 4), x64.Imm(1), none,
			"62 f3 7d 18 66 08 01") {
		return fail("vfpclassps k1, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vfpclasssd", 3, maskOf(K(1), 5, false), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none,
			"62 f3 fd 0d 67 08 01") {
		return fail("vfpclasssd k1 {k5}, [rax], 1")
	}
	if !emitCase("vfpclassss", 3, maskOf(K(1), 5, false), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none,
			"62 f3 7d 0d 67 08 01") {
		return fail("vfpclassss k1 {k5}, [rax], 1")
	}
	if !emitCase("vgetexppd", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 42 08") {
		return fail("vgetexppd xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vgetexpps", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 42 08") {
		return fail("vgetexpps xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vgetexpsd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 43 08") {
		return fail("vgetexpsd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vgetexpss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 43 08") {
		return fail("vgetexpss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vgetmantpd", 3, Xmm(17), bcstOf(0, x64.SZ64, 2), x64.Imm(1), none,
			"62 e3 fd 18 26 08 01") {
		return fail("vgetmantpd xmm17, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vgetmantps", 3, Xmm(17), bcstOf(0, x64.SZ32, 4), x64.Imm(1), none,
			"62 e3 7d 18 26 08 01") {
		return fail("vgetmantps xmm17, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vgetmantsd", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed 85 27 08 01") {
		return fail("vgetmantsd xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vgetmantss", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d 85 27 08 01") {
		return fail("vgetmantss xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vinsertf32x4", 4, maskOf(Ymm(17), 5, true), Ymm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d a5 18 08 01") {
		return fail("vinsertf32x4 ymm17 {k5} {z}, ymm18, [rax], 1")
	}
	if !emitCase("vinsertf32x8", 4, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d c5 1a 08 01") {
		return fail("vinsertf32x8 zmm17 {k5} {z}, zmm18, [rax], 1")
	}
	if !emitCase("vinsertf64x2", 4, maskOf(Ymm(17), 5, true), Ymm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed a5 18 08 01") {
		return fail("vinsertf64x2 ymm17 {k5} {z}, ymm18, [rax], 1")
	}
	if !emitCase("vinsertf64x4", 4, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed c5 1a 08 01") {
		return fail("vinsertf64x4 zmm17 {k5} {z}, zmm18, [rax], 1")
	}
	if !emitCase("vpermi2pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 77 08") {
		return fail("vpermi2pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpermi2ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 77 08") {
		return fail("vpermi2ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpermt2pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 7f 08") {
		return fail("vpermt2pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpermt2ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 7f 08") {
		return fail("vpermt2ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vrangepd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 50 08 01") {
		return fail("vrangepd xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vrangeps", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 50 08 01") {
		return fail("vrangeps xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vrangesd", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 ed 85 51 08 01") {
		return fail("vrangesd xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vrangess", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 6d 85 51 08 01") {
		return fail("vrangess xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vrcp14pd", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 4c 08") {
		return fail("vrcp14pd xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vrcp14ps", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 4c 08") {
