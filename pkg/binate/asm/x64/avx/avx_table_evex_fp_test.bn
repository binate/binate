		return fail("vscalefsd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vscalefss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 2d 08") {
		return fail("vscalefss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vshuff32x4", 4, Ymm(17), Ymm(18), bcstOf(0, x64.SZ32, 8), x64.Imm(1),
			"62 e3 6d 30 23 08 01") {
		return fail("vshuff32x4 ymm17, ymm18, dword ptr [rax]{1to8}, 1")
	}
	if !emitCase("vshuff64x2", 4, Ymm(17), Ymm(18), bcstOf(0, x64.SZ64, 4), x64.Imm(1),
			"62 e3 ed 30 23 08 01") {
		return fail("vshuff64x2 ymm17, ymm18, qword ptr [rax]{1to4}, 1")
	}
	return ""
}

func TestTableEvexFpScale() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var k1 x64.Operand = maskOf(x64.Mem(x64.RAX, 64, 0), 1, false)
	if !emitCase("vcompressps", 2, k1, Zmm(0), none, none, "62 f2 7d 49 8a 40 10") {
		return fail("vcompressps [rax + 64] {k1}, zmm0")
	}
	if !emitCase("vcompresspd", 2, maskOf(x64.Mem(x64.RAX, 64, x64.SZ512), 1, false), Zmm(0), none,
			none, "62 f2 fd 49 8a 40 08") {
		return fail("vcompresspd zmmword ptr [rax + 64] {k1}, zmm0")
	}
	if !emitCase("vcompressps", 2, maskOf(x64.Mem(x64.RAX, 4, x64.SZ512), 1, false), Zmm(0), none,
			none, "62 f2 7d 49 8a 40 01") {
		return fail("vcompressps zmmword ptr [rax + 4] {k1}, zmm0")
	}
	if !emitCase("vexpandpd", 2, sse.Xmm(0), x64.Mem(x64.RAX, -8, 0), none, none,
			"62 f2 fd 08 88 40 ff") {
		return fail("vexpandpd xmm0, [rax - 8]")
	}
	return ""
}

func TestTableEvexFpRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vcompressps", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 1, true), Zmm(0), none, none)
	if !rejected(a) { return fail("vcompressps [rax] {k1} {z}, zmm0") }
	a = newAsm()
	_ = emitOps(a, "vcvtps2ph", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 1, true), Zmm(0), x64.Imm(1), none)
	if !rejected(a) { return fail("vcvtps2ph [rax] {k1} {z}, zmm0, 1") }
	a = newAsm()
	_ = emitOps(a, "vfpclassps", 3, K(1), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none)
	if !rejected(a) ||
			!msgHasPrefix(a.ErrorMsg,
					"x64: vfpclassps: ambiguous operand size (write xmmword, ymmword or zmmword") {
		return fail(buf.Concat("vfpclassps k1, [rax], 1: ", a.ErrorMsg))
	}
	return ""
}
