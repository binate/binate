package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The part of AVX-512's integer instructions with no VEX form but moves (avx_table_evex_int.bn)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of
// each, with registers 16..31 and its decorations; the compare predicates' names (vpcmpltub ..).

func TestTableEvexIntForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("valignd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 03 08 01") {
		return fail("valignd xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("valignq", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 03 08 01") {
		return fail("valignq xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vdbpsadbw", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 6d 85 42 08 01") {
		return fail("vdbpsadbw xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vpabsq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 1f 08") {
		return fail("vpabsq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpandd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 db 08") {
		return fail("vpandd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpandnd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 df 08") {
		return fail("vpandnd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpandnq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 df 08") {
		return fail("vpandnq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpandq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 db 08") {
		return fail("vpandq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpcmpb", 4, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 f3 6d 05 3f 08 01") {
		return fail("vpcmpb k1 {k5}, xmm18, [rax], 1")
	}
	if !emitCase("vpcmpd", 4, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 f3 6d 10 1f 08 01") {
		return fail("vpcmpd k1, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpcmpq", 4, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 f3 ed 10 1f 08 01") {
		return fail("vpcmpq k1, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vpcmpub", 4, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 f3 6d 05 3e 08 01") {
		return fail("vpcmpub k1 {k5}, xmm18, [rax], 1")
	}
	if !emitCase("vpcmpud", 4, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 f3 6d 10 1e 08 01") {
		return fail("vpcmpud k1, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpcmpuq", 4, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 f3 ed 10 1e 08 01") {
		return fail("vpcmpuq k1, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vpcmpuw", 4, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 f3 ed 05 3e 08 01") {
		return fail("vpcmpuw k1 {k5}, xmm18, [rax], 1")
	}
	if !emitCase("vpcmpw", 4, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 f3 ed 05 3f 08 01") {
		return fail("vpcmpw k1 {k5}, xmm18, [rax], 1")
	}
	if !emitCase("vpconflictd", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 c4 08") {
		return fail("vpconflictd xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpconflictq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 c4 08") {
		return fail("vpconflictq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vplzcntd", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 44 08") {
		return fail("vplzcntd xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vplzcntq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 44 08") {
		return fail("vplzcntq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmaxsq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 3d 08") {
		return fail("vpmaxsq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmaxuq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 3f 08") {
		return fail("vpmaxuq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpminsq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 39 08") {
		return fail("vpminsq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpminuq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 3b 08") {
		return fail("vpminuq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmullq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 40 08") {
		return fail("vpmullq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmultishiftqb", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 83 08") {
		return fail("vpmultishiftqb xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpopcntb", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 54 08") {
		return fail("vpopcntb xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpopcntd", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 55 08") {
		return fail("vpopcntd xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpopcntq", 2, Xmm(17), bcstOf(0, x64.SZ64, 2), none, none, "62 e2 fd 18 55 08") {
		return fail("vpopcntq xmm17, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpopcntw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd 8d 54 08") {
		return fail("vpopcntw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpord", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 eb 08") {
		return fail("vpord xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vporq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 eb 08") {
		return fail("vporq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vprold", 3, Xmm(17), bcstOf(0, x64.SZ32, 4), x64.Imm(1), none,
			"62 f1 75 10 72 08 01") {
		return fail("vprold xmm17, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vprolq", 3, Xmm(17), bcstOf(0, x64.SZ64, 2), x64.Imm(1), none,
			"62 f1 f5 10 72 08 01") {
		return fail("vprolq xmm17, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vprolvd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 15 08") {
		return fail("vprolvd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vprolvq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 15 08") {
		return fail("vprolvq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vprord", 3, Xmm(17), bcstOf(0, x64.SZ32, 4), x64.Imm(1), none,
			"62 f1 75 10 72 00 01") {
		return fail("vprord xmm17, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vprorq", 3, Xmm(17), bcstOf(0, x64.SZ64, 2), x64.Imm(1), none,
			"62 f1 f5 10 72 00 01") {
		return fail("vprorq xmm17, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vprorvd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 14 08") {
		return fail("vprorvd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vprorvq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 14 08") {
		return fail("vprorvq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpshldd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 71 08 01") {
		return fail("vpshldd xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpshldq", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 71 08 01") {
		return fail("vpshldq xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vpshldvd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 71 08") {
		return fail("vpshldvd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpshldvq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 71 08") {
		return fail("vpshldvq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpshldvw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 70 08") {
		return fail("vpshldvw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpshldw", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 ed 85 70 08 01") {
		return fail("vpshldw xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vpshrdd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 73 08 01") {
		return fail("vpshrdd xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpshrdq", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 73 08 01") {
		return fail("vpshrdq xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vpshrdvd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 73 08") {
		return fail("vpshrdvd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpshrdvq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 73 08") {
		return fail("vpshrdvq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpshrdvw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 72 08") {
		return fail("vpshrdvw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpshrdw", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 ed 85 72 08 01") {
		return fail("vpshrdw xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vpshufbitqmb", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f2 6d 05 8f 08") {
		return fail("vpshufbitqmb k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpsllvw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 12 08") {
		return fail("vpsllvw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsraq", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 ed 85 e2 08") {
		return fail("vpsraq xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsravq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 46 08") {
		return fail("vpsravq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpsravw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 11 08") {
		return fail("vpsravw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsrlvw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 10 08") {
		return fail("vpsrlvw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpternlogd", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), x64.Imm(1),
			"62 e3 6d 10 25 08 01") {
		return fail("vpternlogd xmm17, xmm18, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpternlogq", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 25 08 01") {
		return fail("vpternlogq xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vptestmb", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f2 6d 05 26 08") {
		return fail("vptestmb k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vptestmd", 3, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 f2 6d 10 27 08") {
		return fail("vptestmd k1, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vptestmq", 3, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 f2 ed 10 27 08") {
		return fail("vptestmq k1, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vptestmw", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f2 ed 05 26 08") {
		return fail("vptestmw k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vptestnmb", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f2 6e 05 26 08") {
		return fail("vptestnmb k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vptestnmd", 3, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 f2 6e 10 27 08") {
		return fail("vptestnmd k1, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vptestnmq", 3, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 f2 ee 10 27 08") {
		return fail("vptestnmq k1, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vptestnmw", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f2 ee 05 26 08") {
		return fail("vptestnmw k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpxord", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 ef 08") {
		return fail("vpxord xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpxorq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 ef 08") {
		return fail("vpxorq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	return ""
}

func TestTableEvexIntPredicates() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vpcmpltub", 3, K(1), Zmm(17), Zmm(18), none, "62 b3 75 40 3e ca 01") {
		return fail("vpcmpltub k1, zmm17, zmm18")
	}
	if !emitCase("vpcmpnleq", 3, maskOf(K(1), 2, false), Ymm(17), bcstOf(0, x64.SZ64, 4), none,
			"62 f3 f5 32 1f 08 06") {
		return fail("vpcmpnleq k1 {k2}, ymm17, qword ptr [rax]{1to4}")
	}
	if !emitCase("VPCMPNEQUD", 3, K(3), Xmm(1), Xmm(2), none, "62 f3 75 08 1e da 04") {
		return fail("vpcmpnequd k3, xmm1, xmm2")
	}
	if !emitCase("vpcmpequw", 3, K(1), Zmm(1), x64.Mem(x64.RAX, 64, x64.SZ512), none,
			"62 f3 f5 48 3e 48 01 00") {
		return fail("vpcmpequw k1, zmm1, zmmword ptr [rax + 64]")
	}
	if !emitCase("vpcmpled", 3, K(1), Xmm(17), Xmm(18), none, "62 b3 75 00 1f ca 02") {
		return fail("vpcmpled k1, xmm17, xmm18")
	}
	if !emitCase("vpcmpnltb", 3, K(7), Zmm(30), Zmm(31), none, "62 93 0d 40 3f ff 05") {
		return fail("vpcmpnltb k7, zmm30, zmm31")
	}
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vpcmpltd", 4, K(1), Zmm(1), Zmm(2), x64.Imm(3))
	var want *[]readonly char = "x64: vpcmpltd: takes three operands (its name holds the immediate)"
	if !rejected(a) || !sameText(a.ErrorMsg, want) {
		return fail(buf.Concat("vpcmpltd with an immediate: ", a.ErrorMsg))
	}
	a = newAsm()
	_ = emitOps(a, "vpcmpltd", 4, K(1), Zmm(1), Zmm(2), x64.Round(4))
	if !rejected(a) { return fail("vpcmpltd with {sae}") }
	return ""
}
