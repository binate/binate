package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The part of AVX-512's integer moves with no VEX form (avx_table_evex_intmove.bn) against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each, with
// registers 16..31 and its decorations; vp2intersect's destination pair (k1 is the pair k0 / k1, as
// clang encodes it); compress / expand's displacement scaled by an element.

func TestTableEvexIntMoveForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vbroadcasti32x2", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 59 08") {
		return fail("vbroadcasti32x2 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcasti32x4", 2, maskOf(Ymm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d ad 5a 08") {
		return fail("vbroadcasti32x4 ymm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcasti32x8", 2, maskOf(Zmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d cd 5b 08") {
		return fail("vbroadcasti32x8 zmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcasti64x2", 2, maskOf(Ymm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd ad 5a 08") {
		return fail("vbroadcasti64x2 ymm17 {k5} {z}, [rax]")
	}
	if !emitCase("vbroadcasti64x4", 2, maskOf(Zmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd cd 5b 08") {
		return fail("vbroadcasti64x4 zmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vextracti32x4", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Ymm(18), x64.Imm(1),
			none, "62 e3 7d 2d 39 10 01") {
		return fail("vextracti32x4 [rax] {k5}, ymm18, 1")
	}
	if !emitCase("vextracti32x8", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Zmm(18), x64.Imm(1),
			none, "62 e3 7d 4d 3b 10 01") {
		return fail("vextracti32x8 [rax] {k5}, zmm18, 1")
	}
	if !emitCase("vextracti64x2", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Ymm(18), x64.Imm(1),
			none, "62 e3 fd 2d 39 10 01") {
		return fail("vextracti64x2 [rax] {k5}, ymm18, 1")
	}
	if !emitCase("vextracti64x4", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Zmm(18), x64.Imm(1),
			none, "62 e3 fd 4d 3b 10 01") {
		return fail("vextracti64x4 [rax] {k5}, zmm18, 1")
	}
	if !emitCase("vinserti32x4", 4, maskOf(Ymm(17), 5, true), Ymm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d a5 38 08 01") {
		return fail("vinserti32x4 ymm17 {k5} {z}, ymm18, [rax], 1")
	}
	if !emitCase("vinserti32x8", 4, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 6d c5 3a 08 01") {
		return fail("vinserti32x8 zmm17 {k5} {z}, zmm18, [rax], 1")
	}
	if !emitCase("vinserti64x2", 4, maskOf(Ymm(17), 5, true), Ymm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed a5 38 08 01") {
		return fail("vinserti64x2 ymm17 {k5} {z}, ymm18, [rax], 1")
	}
	if !emitCase("vinserti64x4", 4, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0),
			x64.Imm(1), "62 e3 ed c5 3a 08 01") {
		return fail("vinserti64x4 zmm17 {k5} {z}, zmm18, [rax], 1")
	}
	if !emitCase("vmovdqa32", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 7d 8d 6f 08") {
		return fail("vmovdqa32 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqa32.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none,
			"62 a1 7d 8d 7f d1") {
		return fail("vmovdqa32.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vmovdqa64", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 fd 8d 6f 08") {
		return fail("vmovdqa64 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqa64.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none,
			"62 a1 fd 8d 7f d1") {
		return fail("vmovdqa64.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vmovdqu16", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 ff 8d 6f 08") {
		return fail("vmovdqu16 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqu16.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none,
			"62 a1 ff 8d 7f d1") {
		return fail("vmovdqu16.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vmovdqu32", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 7e 8d 6f 08") {
		return fail("vmovdqu32 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqu32.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none,
			"62 a1 7e 8d 7f d1") {
		return fail("vmovdqu32.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vmovdqu64", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 fe 8d 6f 08") {
		return fail("vmovdqu64 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqu64.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none,
			"62 a1 fe 8d 7f d1") {
		return fail("vmovdqu64.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vmovdqu8", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e1 7f 8d 6f 08") {
		return fail("vmovdqu8 xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vmovdqu8.s", 2, maskOf(Xmm(17), 5, true), Xmm(18), none, none, "62 a1 7f 8d 7f d1") {
		return fail("vmovdqu8.s xmm17 {k5} {z}, xmm18")
	}
	if !emitCase("vpblendmb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 66 08") {
		return fail("vpblendmb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpblendmd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 64 08") {
		return fail("vpblendmd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpblendmq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 64 08") {
		return fail("vpblendmq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpblendmw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 66 08") {
		return fail("vpblendmw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpbroadcastmb2q", 2, Xmm(17), K(2), none, none, "62 e2 fe 08 2a ca") {
		return fail("vpbroadcastmb2q xmm17, k2")
	}
	if !emitCase("vpbroadcastmw2d", 2, Xmm(17), K(2), none, none, "62 e2 7e 08 3a ca") {
		return fail("vpbroadcastmw2d xmm17, k2")
	}
	if !emitCase("vpcompressb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7d 0d 63 10") {
		return fail("vpcompressb [rax] {k5}, xmm18")
	}
	if !emitCase("vpcompressd", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7d 0d 8b 10") {
		return fail("vpcompressd [rax] {k5}, xmm18")
	}
	if !emitCase("vpcompressq", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 fd 0d 8b 10") {
		return fail("vpcompressq [rax] {k5}, xmm18")
	}
	if !emitCase("vpcompressw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 fd 0d 63 10") {
		return fail("vpcompressw [rax] {k5}, xmm18")
	}
	if !emitCase("vpermb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 8d 08") {
		return fail("vpermb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermi2b", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 75 08") {
		return fail("vpermi2b xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermi2d", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 76 08") {
		return fail("vpermi2d xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpermi2q", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 76 08") {
		return fail("vpermi2q xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpermi2w", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 75 08") {
		return fail("vpermi2w xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermt2b", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 7d 08") {
		return fail("vpermt2b xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermt2d", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 7e 08") {
		return fail("vpermt2d xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpermt2q", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 7e 08") {
		return fail("vpermt2q xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpermt2w", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 7d 08") {
		return fail("vpermt2w xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 8d 08") {
		return fail("vpermw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpexpandb", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 62 08") {
		return fail("vpexpandb xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpexpandd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 89 08") {
		return fail("vpexpandd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpexpandq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd 8d 89 08") {
		return fail("vpexpandq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpexpandw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd 8d 62 08") {
		return fail("vpexpandw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovb2m", 2, K(1), Xmm(18), none, none, "62 b2 7e 08 29 ca") {
		return fail("vpmovb2m k1, xmm18")
	}
	if !emitCase("vpmovd2m", 2, K(1), Xmm(18), none, none, "62 b2 7e 08 39 ca") {
		return fail("vpmovd2m k1, xmm18")
	}
	if !emitCase("vpmovdb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 31 10") {
		return fail("vpmovdb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovdw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 33 10") {
		return fail("vpmovdw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovm2b", 2, Xmm(17), K(2), none, none, "62 e2 7e 08 28 ca") {
		return fail("vpmovm2b xmm17, k2")
	}
	if !emitCase("vpmovm2d", 2, Xmm(17), K(2), none, none, "62 e2 7e 08 38 ca") {
		return fail("vpmovm2d xmm17, k2")
	}
	if !emitCase("vpmovm2q", 2, Xmm(17), K(2), none, none, "62 e2 fe 08 38 ca") {
		return fail("vpmovm2q xmm17, k2")
	}
	if !emitCase("vpmovm2w", 2, Xmm(17), K(2), none, none, "62 e2 fe 08 28 ca") {
		return fail("vpmovm2w xmm17, k2")
	}
	if !emitCase("vpmovq2m", 2, K(1), Xmm(18), none, none, "62 b2 fe 08 39 ca") {
		return fail("vpmovq2m k1, xmm18")
	}
	if !emitCase("vpmovqb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 32 10") {
		return fail("vpmovqb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovqd", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 35 10") {
		return fail("vpmovqd [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovqw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 34 10") {
		return fail("vpmovqw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovsdb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 21 10") {
		return fail("vpmovsdb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovsdw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 23 10") {
		return fail("vpmovsdw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovsqb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 22 10") {
		return fail("vpmovsqb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovsqd", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 25 10") {
		return fail("vpmovsqd [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovsqw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 24 10") {
		return fail("vpmovsqw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovswb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 20 10") {
		return fail("vpmovswb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovusdb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 11 10") {
		return fail("vpmovusdb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovusdw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 13 10") {
		return fail("vpmovusdw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovusqb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 12 10") {
		return fail("vpmovusqb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovusqd", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 15 10") {
		return fail("vpmovusqd [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovusqw", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 14 10") {
		return fail("vpmovusqw [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovuswb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 10 10") {
		return fail("vpmovuswb [rax] {k5}, xmm18")
	}
	if !emitCase("vpmovw2m", 2, K(1), Xmm(18), none, none, "62 b2 fe 08 29 ca") {
		return fail("vpmovw2m k1, xmm18")
	}
	if !emitCase("vpmovwb", 2, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), none, none,
			"62 e2 7e 0d 30 10") {
		return fail("vpmovwb [rax] {k5}, xmm18")
	}
	if !emitCase("vshufi32x4", 4, Ymm(17), Ymm(18), bcstOf(0, x64.SZ32, 8), x64.Imm(1),
			"62 e3 6d 30 43 08 01") {
		return fail("vshufi32x4 ymm17, ymm18, dword ptr [rax]{1to8}, 1")
	}
	if !emitCase("vshufi64x2", 4, Ymm(17), Ymm(18), bcstOf(0, x64.SZ64, 4), x64.Imm(1),
			"62 e3 ed 30 43 08 01") {
		return fail("vshufi64x2 ymm17, ymm18, qword ptr [rax]{1to4}, 1")
	}
	return ""
}

func TestTableEvexIntMovePairs() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vp2intersectd", 3, K(1), Xmm(18), Xmm(20), none, "62 b2 6f 00 68 c4") {
		return fail("vp2intersectd k1, xmm18, xmm20")
	}
	if !emitCase("vp2intersectd", 3, K(6), Ymm(18), x64.Mem(x64.RAX, 64, x64.SZ256), none,
			"62 f2 6f 20 68 70 02") {
		return fail("vp2intersectd k6, ymm18, ymmword ptr [rax + 64]")
	}
	if !emitCase("vp2intersectq", 3, K(3), Zmm(18), bcstOf(0, x64.SZ64, 8), none,
			"62 f2 ef 50 68 10") {
		return fail("vp2intersectq k3, zmm18, qword ptr [rax]{1to8}")
	}
	if !emitCase("vp2intersectq", 3, K(7), Zmm(31), Zmm(30), none, "62 92 87 40 68 f6") {
		return fail("vp2intersectq k7, zmm31, zmm30")
	}
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vp2intersectd", 3, maskOf(K(0), 1, false), Zmm(1), Zmm(2), none)
	if !rejected(a) { return fail("vp2intersectd k0 {k1}, zmm1, zmm2") }
	return ""
}

func TestTableEvexIntMoveScale() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vpcompressb", 2, maskOf(x64.Mem(x64.RAX, 64, 0), 1, false), Zmm(0), none, none,
			"62 f2 7d 49 63 40 40") {
		return fail("vpcompressb [rax + 64] {k1}, zmm0")
	}
	if !emitCase("vpcompressw", 2, maskOf(x64.Mem(x64.RAX, 64, x64.SZ512), 1, false), Zmm(0), none,
			none, "62 f2 fd 49 63 40 20") {
		return fail("vpcompressw zmmword ptr [rax + 64] {k1}, zmm0")
	}
	if !emitCase("vpexpandq", 2, maskOf(Zmm(0), 1, true), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 f2 fd c9 89 40 08") {
		return fail("vpexpandq zmm0 {k1} {z}, [rax + 64]")
	}
	return ""
}
