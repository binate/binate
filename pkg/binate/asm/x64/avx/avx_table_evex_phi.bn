package "pkg/binate/asm/x64/avx"

// tableEvexPhi returns the part of AVX-512's Xeon Phi instructions, a form a line, each after a
// newline: AVX512ER's exponential and 28-bit reciprocal and reciprocal square root, AVX512-4FMAPS's
// and 4VNNIW's multiply-adds over a block of four registers (written as its first, encoded as
// written), and AVX512PF's gather and scatter prefetches.
func tableEvexPhi() *[]readonly char {
	return "\n"
			"vexp2ps e2 66 38 w0 c8 kzb32 V512 W512\n"
			"vexp2ps e2 66 38 w0 c8 kz V512 U512 N\n"
			"vexp2pd e2 66 38 w1 c8 kzb64 V512 W512\n"
			"vexp2pd e2 66 38 w1 c8 kz V512 U512 N\n"
			"vrcp28ps e2 66 38 w0 ca kzb32 V512 W512\n"
			"vrcp28ps e2 66 38 w0 ca kz V512 U512 N\n"
			"vrcp28pd e2 66 38 w1 ca kzb64 V512 W512\n"
			"vrcp28pd e2 66 38 w1 ca kz V512 U512 N\n"
			"vrcp28ss e0 66 38 w0 cb kz V128 H128 W32\n"
			"vrcp28ss e0 66 38 w0 cb kz V128 H128 U128 N\n"
			"vrcp28sd e0 66 38 w1 cb kz V128 H128 W64\n"
			"vrcp28sd e0 66 38 w1 cb kz V128 H128 U128 N\n"
			"vrsqrt28ps e2 66 38 w0 cc kzb32 V512 W512\n"
			"vrsqrt28ps e2 66 38 w0 cc kz V512 U512 N\n"
			"vrsqrt28pd e2 66 38 w1 cc kzb64 V512 W512\n"
			"vrsqrt28pd e2 66 38 w1 cc kz V512 U512 N\n"
			"vrsqrt28ss e0 66 38 w0 cd kz V128 H128 W32\n"
			"vrsqrt28ss e0 66 38 w0 cd kz V128 H128 U128 N\n"
			"vrsqrt28sd e0 66 38 w1 cd kz V128 H128 W64\n"
			"vrsqrt28sd e0 66 38 w1 cd kz V128 H128 U128 N\n"
			"v4fmaddps e2 f2 38 w0 9a kz V512 H512 M128\n"
			"v4fmaddss e0 f2 38 w0 9b kz V128 H128 M128\n"
			"v4fnmaddps e2 f2 38 w0 aa kz V512 H512 M128\n"
			"v4fnmaddss e0 f2 38 w0 ab kz V128 H128 M128\n"
			"vp4dpwssd e2 f2 38 w0 52 kz V512 H512 M128\n"
			"vp4dpwssds e2 f2 38 w0 53 kz V512 H512 M128\n"
			"vgatherpf0dps e2 66 38 w0 c6/1 K z32\n"
			"vgatherpf0qps e2 66 38 w0 c7/1 K z32\n"
			"vgatherpf0dpd e2 66 38 w1 c6/1 K y64\n"
			"vgatherpf0qpd e2 66 38 w1 c7/1 K z64\n"
			"vgatherpf1dps e2 66 38 w0 c6/2 K z32\n"
			"vgatherpf1qps e2 66 38 w0 c7/2 K z32\n"
			"vgatherpf1dpd e2 66 38 w1 c6/2 K y64\n"
			"vgatherpf1qpd e2 66 38 w1 c7/2 K z64\n"
			"vscatterpf0dps e2 66 38 w0 c6/5 K z32\n"
			"vscatterpf0qps e2 66 38 w0 c7/5 K z32\n"
			"vscatterpf0dpd e2 66 38 w1 c6/5 K y64\n"
			"vscatterpf0qpd e2 66 38 w1 c7/5 K z64\n"
			"vscatterpf1dps e2 66 38 w0 c6/6 K z32\n"
			"vscatterpf1qps e2 66 38 w0 c7/6 K z32\n"
			"vscatterpf1dpd e2 66 38 w1 c6/6 K y64\n"
			"vscatterpf1qpd e2 66 38 w1 c7/6 K z64\n"
}
