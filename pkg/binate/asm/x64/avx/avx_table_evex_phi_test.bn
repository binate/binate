package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The part of Xeon Phi's instructions (avx_table_evex_phi.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`; GNU as's for AVX512PF's prefetches,
// which clang no longer has): a form of each, with registers 16..31 and its decorations; a
// prefetch's mask it needs.

func TestTableEvexPhiForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vexp2ps", 2, Zmm(17), bcstOf(0, x64.SZ32, 16), none, none, "62 e2 7d 58 c8 08") {
		return fail("vexp2ps zmm17, dword ptr [rax]{1to16}")
	}
	if !emitCase("vexp2pd", 2, Zmm(17), bcstOf(0, x64.SZ64, 8), none, none, "62 e2 fd 58 c8 08") {
		return fail("vexp2pd zmm17, qword ptr [rax]{1to8}")
	}
	if !emitCase("vrcp28ps", 2, Zmm(17), bcstOf(0, x64.SZ32, 16), none, none, "62 e2 7d 58 ca 08") {
		return fail("vrcp28ps zmm17, dword ptr [rax]{1to16}")
	}
	if !emitCase("vrcp28pd", 2, Zmm(17), bcstOf(0, x64.SZ64, 8), none, none, "62 e2 fd 58 ca 08") {
		return fail("vrcp28pd zmm17, qword ptr [rax]{1to8}")
	}
	if !emitCase("vrcp28ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 cb 08") {
		return fail("vrcp28ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vrcp28sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 cb 08") {
		return fail("vrcp28sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vrsqrt28ps", 2, Zmm(17), bcstOf(0, x64.SZ32, 16), none, none, "62 e2 7d 58 cc 08") {
		return fail("vrsqrt28ps zmm17, dword ptr [rax]{1to16}")
	}
	if !emitCase("vrsqrt28pd", 2, Zmm(17), bcstOf(0, x64.SZ64, 8), none, none, "62 e2 fd 58 cc 08") {
		return fail("vrsqrt28pd zmm17, qword ptr [rax]{1to8}")
	}
	if !emitCase("vrsqrt28ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 cd 08") {
		return fail("vrsqrt28ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vrsqrt28sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 cd 08") {
		return fail("vrsqrt28sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("v4fmaddps", 3, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f c5 9a 08") {
		return fail("v4fmaddps zmm17 {k5} {z}, zmm18, [rax]")
	}
	if !emitCase("v4fmaddss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f 85 9b 08") {
		return fail("v4fmaddss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("v4fnmaddps", 3, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f c5 aa 08") {
		return fail("v4fnmaddps zmm17 {k5} {z}, zmm18, [rax]")
	}
	if !emitCase("v4fnmaddss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f 85 ab 08") {
		return fail("v4fnmaddss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vp4dpwssd", 3, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f c5 52 08") {
		return fail("vp4dpwssd zmm17 {k5} {z}, zmm18, [rax]")
	}
	if !emitCase("vp4dpwssds", 3, maskOf(Zmm(17), 5, true), Zmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6f c5 53 08") {
		return fail("vp4dpwssds zmm17 {k5} {z}, zmm18, [rax]")
	}
	return ""
}

func TestTableEvexPhiPrefetches() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vgatherpf0dps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c6 0c 90") {
		return fail("vgatherpf0dps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf0dps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c6 4c d1 10") {
		return fail("vgatherpf0dps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf0dps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c6 0c 7d 04 00 00 00") {
		return fail("vgatherpf0dps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf0qps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c7 0c 90") {
		return fail("vgatherpf0qps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf0qps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c7 4c d1 10") {
		return fail("vgatherpf0qps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf0qps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c7 0c 7d 04 00 00 00") {
		return fail("vgatherpf0qps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf0dpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ256), 1, false),
			none, none, none, "62 f2 fd 49 c6 0c 90") {
		return fail("vgatherpf0dpd [rax + ymm2*4] {k1}")
	}
	if !emitCase("vgatherpf0dpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ256), 7, false), none, none, none,
			"62 d2 fd 47 c6 4c d1 08") {
		return fail("vgatherpf0dpd qword ptr [r9 + ymm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf0dpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ256), 2, false), none,
			none, none, "62 b2 fd 42 c6 0c 7d 04 00 00 00") {
		return fail("vgatherpf0dpd [ymm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf0qpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 fd 49 c7 0c 90") {
		return fail("vgatherpf0qpd [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf0qpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ512), 7, false), none, none, none,
			"62 d2 fd 47 c7 4c d1 08") {
		return fail("vgatherpf0qpd qword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf0qpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 fd 42 c7 0c 7d 04 00 00 00") {
		return fail("vgatherpf0qpd [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf1dps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c6 14 90") {
		return fail("vgatherpf1dps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf1dps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c6 54 d1 10") {
		return fail("vgatherpf1dps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf1dps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c6 14 7d 04 00 00 00") {
		return fail("vgatherpf1dps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf1qps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c7 14 90") {
		return fail("vgatherpf1qps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf1qps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c7 54 d1 10") {
		return fail("vgatherpf1qps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf1qps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c7 14 7d 04 00 00 00") {
		return fail("vgatherpf1qps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf1dpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ256), 1, false),
			none, none, none, "62 f2 fd 49 c6 14 90") {
		return fail("vgatherpf1dpd [rax + ymm2*4] {k1}")
	}
	if !emitCase("vgatherpf1dpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ256), 7, false), none, none, none,
			"62 d2 fd 47 c6 54 d1 08") {
		return fail("vgatherpf1dpd qword ptr [r9 + ymm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf1dpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ256), 2, false), none,
			none, none, "62 b2 fd 42 c6 14 7d 04 00 00 00") {
		return fail("vgatherpf1dpd [ymm31*2 + 4] {k2}")
	}
	if !emitCase("vgatherpf1qpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 fd 49 c7 14 90") {
		return fail("vgatherpf1qpd [rax + zmm2*4] {k1}")
	}
	if !emitCase("vgatherpf1qpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ512), 7, false), none, none, none,
			"62 d2 fd 47 c7 54 d1 08") {
		return fail("vgatherpf1qpd qword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vgatherpf1qpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 fd 42 c7 14 7d 04 00 00 00") {
		return fail("vgatherpf1qpd [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf0dps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c6 2c 90") {
		return fail("vscatterpf0dps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf0dps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c6 6c d1 10") {
		return fail("vscatterpf0dps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf0dps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c6 2c 7d 04 00 00 00") {
		return fail("vscatterpf0dps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf0qps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c7 2c 90") {
		return fail("vscatterpf0qps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf0qps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c7 6c d1 10") {
		return fail("vscatterpf0qps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf0qps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c7 2c 7d 04 00 00 00") {
		return fail("vscatterpf0qps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf0dpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ256), 1, false),
			none, none, none, "62 f2 fd 49 c6 2c 90") {
		return fail("vscatterpf0dpd [rax + ymm2*4] {k1}")
	}
	if !emitCase("vscatterpf0dpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ256), 7, false), none, none, none,
			"62 d2 fd 47 c6 6c d1 08") {
		return fail("vscatterpf0dpd qword ptr [r9 + ymm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf0dpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ256), 2, false), none,
			none, none, "62 b2 fd 42 c6 2c 7d 04 00 00 00") {
		return fail("vscatterpf0dpd [ymm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf0qpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 fd 49 c7 2c 90") {
		return fail("vscatterpf0qpd [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf0qpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ512), 7, false), none, none, none,
			"62 d2 fd 47 c7 6c d1 08") {
		return fail("vscatterpf0qpd qword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf0qpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 fd 42 c7 2c 7d 04 00 00 00") {
		return fail("vscatterpf0qpd [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf1dps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c6 34 90") {
		return fail("vscatterpf1dps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf1dps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c6 74 d1 10") {
		return fail("vscatterpf1dps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf1dps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c6 34 7d 04 00 00 00") {
		return fail("vscatterpf1dps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf1qps", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 7d 49 c7 34 90") {
		return fail("vscatterpf1qps [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf1qps", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ32, x64.SZ512), 7, false), none, none, none,
			"62 d2 7d 47 c7 74 d1 10") {
		return fail("vscatterpf1qps dword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf1qps", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 7d 42 c7 34 7d 04 00 00 00") {
		return fail("vscatterpf1qps [zmm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf1dpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ256), 1, false),
			none, none, none, "62 f2 fd 49 c6 34 90") {
		return fail("vscatterpf1dpd [rax + ymm2*4] {k1}")
	}
	if !emitCase("vscatterpf1dpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ256), 7, false), none, none, none,
			"62 d2 fd 47 c6 74 d1 08") {
		return fail("vscatterpf1dpd qword ptr [r9 + ymm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf1dpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ256), 2, false), none,
			none, none, "62 b2 fd 42 c6 34 7d 04 00 00 00") {
		return fail("vscatterpf1dpd [ymm31*2 + 4] {k2}")
	}
	if !emitCase("vscatterpf1qpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), 1, false),
			none, none, none, "62 f2 fd 49 c7 34 90") {
		return fail("vscatterpf1qpd [rax + zmm2*4] {k1}")
	}
	if !emitCase("vscatterpf1qpd", 1,
			maskOf(x64.MemVsib(x64.R9, 18, 8, 64, x64.SZ64, x64.SZ512), 7, false), none, none, none,
			"62 d2 fd 47 c7 74 d1 08") {
		return fail("vscatterpf1qpd qword ptr [r9 + zmm18*8 + 64] {k7}")
	}
	if !emitCase("vscatterpf1qpd", 1, maskOf(x64.MemVsib(-1, 31, 2, 4, 0, x64.SZ512), 2, false), none,
			none, none, "62 b2 fd 42 c7 34 7d 04 00 00 00") {
		return fail("vscatterpf1qpd [zmm31*2 + 4] {k2}")
	}
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vgatherpf0dps", 1, x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), none, none, none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vgatherpf0dps: takes a write mask") {
		return fail("vgatherpf0dps [rax + zmm2*4]")
	}
	a = newAsm()
	_ = emitOps(a, "vgatherpf0dpd", 1, maskOf(x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ512), 1, false),
			none, none, none)
	if !rejected(a) { return fail("vgatherpf0dpd [rax + zmm2*8] {k1}") }
	return ""
}
