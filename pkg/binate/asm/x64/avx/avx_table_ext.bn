package "pkg/binate/asm/x64/avx"

// tableExt returns the part of AVX's extensions, a form a line, each after a newline: F16C's
// conversions, VAES, VPCLMULQDQ, GFNI's VEX forms, SHA512, SM3, SM4, AVX-NE-CONVERT, AVX-VNNI-INT8,
// AVX-VNNI-INT16, and AVX-VNNI's, AVX-IFMA's and vcvtneps2bf16 (whose VEX forms clang encodes only
// after {vex}: evexByDefault).
func tableExt() *[]readonly char {
	return "\n"
			"vcvtph2ps l0 66 38 w0 13 V128 W64\n"
			"vcvtph2ps l1 66 38 w0 13 V256 W128\n"
			"vcvtph2ps e0 66 38 w0 13 kz V128 W64\n"
			"vcvtph2ps e1 66 38 w0 13 kz V256 W128\n"
			"vcvtph2ps e2 66 38 w0 13 kz V512 W256\n"
			"vcvtph2ps e2 66 38 w0 13 kz V512 U256 N\n"
			"vcvtps2ph l0 66 3a w0 1d W64 V128 I\n"
			"vcvtps2ph l1 66 3a w0 1d W128 V256 I\n"
			"vcvtps2ph e0 66 3a w0 1d kz W64 V128 I\n"
			"vcvtps2ph e1 66 3a w0 1d kz W128 V256 I\n"
			"vcvtps2ph e2 66 3a w0 1d kz W256 V512 I\n"
			"vcvtps2ph e2 66 3a w0 1d kz U256 V512 N I\n"
			"vaesenc l0 66 38 w0 dc V128 H128 W128\n"
			"vaesenc l1 66 38 w0 dc V256 H256 W256\n"
			"vaesenclast l0 66 38 w0 dd V128 H128 W128\n"
			"vaesenclast l1 66 38 w0 dd V256 H256 W256\n"
			"vaesdec l0 66 38 w0 de V128 H128 W128\n"
			"vaesdec l1 66 38 w0 de V256 H256 W256\n"
			"vaesdeclast l0 66 38 w0 df V128 H128 W128\n"
			"vaesdeclast l1 66 38 w0 df V256 H256 W256\n"
			"vaesimc l0 66 38 w0 db V128 W128\n"
			"vaeskeygenassist l0 66 3a w0 df V128 W128 I\n"
			"vpclmulqdq l0 66 3a w0 44 V128 H128 W128 I\n"
			"vpclmulqdq l1 66 3a w0 44 V256 H256 W256 I\n"
			"vgf2p8affineinvqb l0 66 3a w1 cf V128 H128 W128 I\n"
			"vgf2p8affineinvqb l1 66 3a w1 cf V256 H256 W256 I\n"
			"vgf2p8affineqb l0 66 3a w1 ce V128 H128 W128 I\n"
			"vgf2p8affineqb l1 66 3a w1 ce V256 H256 W256 I\n"
			"vgf2p8mulb l0 66 38 w0 cf V128 H128 W128\n"
			"vgf2p8mulb l1 66 38 w0 cf V256 H256 W256\n"
			"vsha512msg1 l1 f2 38 w0 cc V256 U128\n"
			"vsha512msg2 l1 f2 38 w0 cd V256 U256\n"
			"vsha512rnds2 l1 f2 38 w0 cb V256 H256 U128\n"
			"vsm3msg1 l0 - 38 w0 da V128 H128 W128\n"
			"vsm3msg2 l0 66 38 w0 da V128 H128 W128\n"
			"vsm3rnds2 l0 66 3a w0 de V128 H128 W128 I\n"
			"vsm4key4 l0 f3 38 w0 da V128 H128 W128\n"
			"vsm4key4 l1 f3 38 w0 da V256 H256 W256\n"
			"vsm4rnds4 l0 f2 38 w0 da V128 H128 W128\n"
			"vsm4rnds4 l1 f2 38 w0 da V256 H256 W256\n"
			"vbcstnebf162ps l0 f3 38 w0 b1 V128 M16\n"
			"vbcstnebf162ps l1 f3 38 w0 b1 V256 M16\n"
			"vbcstnesh2ps l0 66 38 w0 b1 V128 M16\n"
			"vbcstnesh2ps l1 66 38 w0 b1 V256 M16\n"
			"vcvtneebf162ps l0 f3 38 w0 b0 V128 M128\n"
			"vcvtneebf162ps l1 f3 38 w0 b0 V256 M256\n"
			"vcvtneeph2ps l0 66 38 w0 b0 V128 M128\n"
			"vcvtneeph2ps l1 66 38 w0 b0 V256 M256\n"
			"vcvtneobf162ps l0 f2 38 w0 b0 V128 M128\n"
			"vcvtneobf162ps l1 f2 38 w0 b0 V256 M256\n"
			"vcvtneoph2ps l0 - 38 w0 b0 V128 M128\n"
			"vcvtneoph2ps l1 - 38 w0 b0 V256 M256\n"
			"vpdpbssd l0 f2 38 w0 50 V128 H128 W128\n"
			"vpdpbssd l1 f2 38 w0 50 V256 H256 W256\n"
			"vpdpbssds l0 f2 38 w0 51 V128 H128 W128\n"
			"vpdpbssds l1 f2 38 w0 51 V256 H256 W256\n"
			"vpdpbsud l0 f3 38 w0 50 V128 H128 W128\n"
			"vpdpbsud l1 f3 38 w0 50 V256 H256 W256\n"
			"vpdpbsuds l0 f3 38 w0 51 V128 H128 W128\n"
			"vpdpbsuds l1 f3 38 w0 51 V256 H256 W256\n"
			"vpdpbuud l0 - 38 w0 50 V128 H128 W128\n"
			"vpdpbuud l1 - 38 w0 50 V256 H256 W256\n"
			"vpdpbuuds l0 - 38 w0 51 V128 H128 W128\n"
			"vpdpbuuds l1 - 38 w0 51 V256 H256 W256\n"
			"vpdpwsud l0 f3 38 w0 d2 V128 H128 W128\n"
			"vpdpwsud l1 f3 38 w0 d2 V256 H256 W256\n"
			"vpdpwsuds l0 f3 38 w0 d3 V128 H128 W128\n"
			"vpdpwsuds l1 f3 38 w0 d3 V256 H256 W256\n"
			"vpdpwusd l0 66 38 w0 d2 V128 H128 W128\n"
			"vpdpwusd l1 66 38 w0 d2 V256 H256 W256\n"
			"vpdpwusds l0 66 38 w0 d3 V128 H128 W128\n"
			"vpdpwusds l1 66 38 w0 d3 V256 H256 W256\n"
			"vpdpwuud l0 - 38 w0 d2 V128 H128 W128\n"
			"vpdpwuud l1 - 38 w0 d2 V256 H256 W256\n"
			"vpdpwuuds l0 - 38 w0 d3 V128 H128 W128\n"
			"vpdpwuuds l1 - 38 w0 d3 V256 H256 W256\n"
			"vcvtneps2bf16 l0 f3 38 w0 72 V128 X128\n"
			"vcvtneps2bf16 l1 f3 38 w0 72 V128 X256\n"
			"vpdpbusd l0 66 38 w0 50 V128 H128 W128\n"
			"vpdpbusd l1 66 38 w0 50 V256 H256 W256\n"
			"vpdpbusds l0 66 38 w0 51 V128 H128 W128\n"
			"vpdpbusds l1 66 38 w0 51 V256 H256 W256\n"
			"vpdpwssd l0 66 38 w0 52 V128 H128 W128\n"
			"vpdpwssd l1 66 38 w0 52 V256 H256 W256\n"
			"vpdpwssds l0 66 38 w0 53 V128 H128 W128\n"
			"vpdpwssds l1 66 38 w0 53 V256 H256 W256\n"
			"vpmadd52huq l0 66 38 w1 b5 V128 H128 W128\n"
			"vpmadd52huq l1 66 38 w1 b5 V256 H256 W256\n"
			"vpmadd52luq l0 66 38 w1 b4 V128 H128 W128\n"
			"vpmadd52luq l1 66 38 w1 b4 V256 H256 W256\n"
}
