package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The EVEX forms of VAES, VPCLMULQDQ, GFNI, SM4, AVX512-IFMA and AVX512-VNNI (avx_table_ext.bn)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of
// each, with registers 16..31 and its decorations.

func TestTableExtEvexForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vaesdec", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6d 00 de 48 04") {
		return fail("vaesdec xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vaesdeclast", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6d 00 df 48 04") {
		return fail("vaesdeclast xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vaesenc", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6d 00 dc 48 04") {
		return fail("vaesenc xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vaesenclast", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6d 00 dd 48 04") {
		return fail("vaesenclast xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vgf2p8affineinvqb", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 cf 08 01") {
		return fail("vgf2p8affineinvqb xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vgf2p8affineqb", 4, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), x64.Imm(1),
			"62 e3 ed 10 ce 08 01") {
		return fail("vgf2p8affineqb xmm17, xmm18, qword ptr [rax]{1to2}, 1")
	}
	if !emitCase("vgf2p8mulb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 cf 08") {
		return fail("vgf2p8mulb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpclmulqdq", 4, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), x64.Imm(1),
			"62 e3 6d 00 44 48 04 01") {
		return fail("vpclmulqdq xmm17, xmm18, [rax + 64], 1")
	}
	if !emitCase("vsm4key4", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6e 00 da 48 04") {
		return fail("vsm4key4 xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vsm4rnds4", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e2 6f 00 da 48 04") {
		return fail("vsm4rnds4 xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vpmadd52luq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 b4 08") {
		return fail("vpmadd52luq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmadd52huq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 b5 08") {
		return fail("vpmadd52huq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpdpbusd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 50 08") {
		return fail("vpdpbusd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpdpbusds", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 51 08") {
		return fail("vpdpbusds xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpdpwssd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 52 08") {
		return fail("vpdpwssd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpdpwssds", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 53 08") {
		return fail("vpdpwssds xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	return ""
}
