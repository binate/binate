package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The extensions' part of the table (avx_table_ext.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10; after {vex} (asm.Assembler.X64Vex), those clang
// encodes otherwise as EVEX.
func TestTableExtForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vcvtph2ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 13 0a") {
		return fail("vcvtph2ps xmm9, qword ptr [r10]")
	}
	if !emitCase("vcvtps2ph", 3, x64.Mem(x64.R10, 0, x64.SZ64), sse.Xmm(11), x64.Imm(1), none,
			"c4 43 79 1d 1a 01") {
		return fail("vcvtps2ph qword ptr [r10], xmm11, 1")
	}
	if !emitCase("vaesenc", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 dc 0a") {
		return fail("vaesenc xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vaesenclast", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 dd 0a") {
		return fail("vaesenclast xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vaesdec", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 de 0a") {
		return fail("vaesdec xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vaesdeclast", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 df 0a") {
		return fail("vaesdeclast xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vaesimc", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 db 0a") {
		return fail("vaesimc xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vaeskeygenassist", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 43 79 df 0a 01") {
		return fail("vaeskeygenassist xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpclmulqdq", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 44 0a 01") {
		return fail("vpclmulqdq xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vgf2p8affineinvqb", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128),
			x64.Imm(1), "c4 43 a1 cf 0a 01") {
		return fail("vgf2p8affineinvqb xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vgf2p8affineqb", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128),
			x64.Imm(1), "c4 43 a1 ce 0a 01") {
		return fail("vgf2p8affineqb xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vgf2p8mulb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 cf 0a") {
		return fail("vgf2p8mulb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vsha512msg1", 2, Ymm(10), sse.Xmm(11), none, none, "c4 42 7f cc d3") {
		return fail("vsha512msg1 ymm10, xmm11")
	}
	if !emitCase("vsha512msg2", 2, Ymm(10), Ymm(12), none, none, "c4 42 7f cd d4") {
		return fail("vsha512msg2 ymm10, ymm12")
	}
	if !emitCase("vsha512rnds2", 3, Ymm(10), Ymm(12), sse.Xmm(13), none, "c4 42 1f cb d5") {
		return fail("vsha512rnds2 ymm10, ymm12, xmm13")
	}
	if !emitCase("vsm3msg1", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 20 da 0a") {
		return fail("vsm3msg1 xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vsm3msg2", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 da 0a") {
		return fail("vsm3msg2 xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vsm3rnds2", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 de 0a 01") {
		return fail("vsm3rnds2 xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vsm4key4", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 22 da 0a") {
		return fail("vsm4key4 xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vsm4rnds4", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 23 da 0a") {
		return fail("vsm4rnds4 xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vbcstnebf162ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ16), none, none,
			"c4 42 7a b1 0a") {
		return fail("vbcstnebf162ps xmm9, word ptr [r10]")
	}
	if !emitCase("vbcstnesh2ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ16), none, none,
			"c4 42 79 b1 0a") {
		return fail("vbcstnesh2ps xmm9, word ptr [r10]")
	}
	if !emitCase("vcvtneebf162ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 7a b0 0a") {
		return fail("vcvtneebf162ps xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vcvtneeph2ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 b0 0a") {
		return fail("vcvtneeph2ps xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vcvtneobf162ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 7b b0 0a") {
		return fail("vcvtneobf162ps xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vcvtneoph2ps", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 78 b0 0a") {
		return fail("vcvtneoph2ps xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbssd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 23 50 0a") {
		return fail("vpdpbssd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbssds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 23 51 0a") {
		return fail("vpdpbssds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbsud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 22 50 0a") {
		return fail("vpdpbsud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbsuds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 22 51 0a") {
		return fail("vpdpbsuds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbuud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 20 50 0a") {
		return fail("vpdpbuud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpbuuds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 20 51 0a") {
		return fail("vpdpbuuds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwsud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 22 d2 0a") {
		return fail("vpdpwsud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwsuds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 22 d3 0a") {
		return fail("vpdpwsuds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwusd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 d2 0a") {
		return fail("vpdpwusd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwusds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 d3 0a") {
		return fail("vpdpwusds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwuud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 20 d2 0a") {
		return fail("vpdpwuud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpdpwuuds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 20 d3 0a") {
		return fail("vpdpwuuds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vcvtneps2bf16", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 7a 72 0a") {
		return fail("vcvtneps2bf16 xmm9, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpdpbusd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 50 0a") {
		return fail("vpdpbusd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpdpbusds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 51 0a") {
		return fail("vpdpbusds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpdpwssd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 52 0a") {
		return fail("vpdpwssd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpdpwssds", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 53 0a") {
		return fail("vpdpwssds xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpmadd52huq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 b5 0a") {
		return fail("vpmadd52huq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCaseVex("vpmadd52luq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 b4 0a") {
		return fail("vpmadd52luq xmm9, xmm11, xmmword ptr [r10]")
	}
	return ""
}
