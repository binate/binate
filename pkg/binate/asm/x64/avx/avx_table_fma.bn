package "pkg/binate/asm/x64/avx"

// tableFma returns FMA3's part, a form a line, each after a newline: the fused multiply-adds and
// -subtracts (vfmadd, vfmsub, vfnmadd, vfnmsub, vfmaddsub, vfmsubadd), each with its operands'
// order 132, 213 or 231, packed at 128 and 256 bits and scalar.
func tableFma() *[]readonly char {
	return "\n"
			"vfmadd132ps l0 66 38 w0 98 V128 H128 W128\n"
			"vfmadd132ps l1 66 38 w0 98 V256 H256 W256\n"
			"vfmadd132pd l0 66 38 w1 98 V128 H128 W128\n"
			"vfmadd132pd l1 66 38 w1 98 V256 H256 W256\n"
			"vfmadd132ss l0 66 38 w0 99 V128 H128 W32\n"
			"vfmadd132sd l0 66 38 w1 99 V128 H128 W64\n"
			"vfmadd213ps l0 66 38 w0 a8 V128 H128 W128\n"
			"vfmadd213ps l1 66 38 w0 a8 V256 H256 W256\n"
			"vfmadd213pd l0 66 38 w1 a8 V128 H128 W128\n"
			"vfmadd213pd l1 66 38 w1 a8 V256 H256 W256\n"
			"vfmadd213ss l0 66 38 w0 a9 V128 H128 W32\n"
			"vfmadd213sd l0 66 38 w1 a9 V128 H128 W64\n"
			"vfmadd231ps l0 66 38 w0 b8 V128 H128 W128\n"
			"vfmadd231ps l1 66 38 w0 b8 V256 H256 W256\n"
			"vfmadd231pd l0 66 38 w1 b8 V128 H128 W128\n"
			"vfmadd231pd l1 66 38 w1 b8 V256 H256 W256\n"
			"vfmadd231ss l0 66 38 w0 b9 V128 H128 W32\n"
			"vfmadd231sd l0 66 38 w1 b9 V128 H128 W64\n"
			"vfmsub132ps l0 66 38 w0 9a V128 H128 W128\n"
			"vfmsub132ps l1 66 38 w0 9a V256 H256 W256\n"
			"vfmsub132pd l0 66 38 w1 9a V128 H128 W128\n"
			"vfmsub132pd l1 66 38 w1 9a V256 H256 W256\n"
			"vfmsub132ss l0 66 38 w0 9b V128 H128 W32\n"
			"vfmsub132sd l0 66 38 w1 9b V128 H128 W64\n"
			"vfmsub213ps l0 66 38 w0 aa V128 H128 W128\n"
			"vfmsub213ps l1 66 38 w0 aa V256 H256 W256\n"
			"vfmsub213pd l0 66 38 w1 aa V128 H128 W128\n"
			"vfmsub213pd l1 66 38 w1 aa V256 H256 W256\n"
			"vfmsub213ss l0 66 38 w0 ab V128 H128 W32\n"
			"vfmsub213sd l0 66 38 w1 ab V128 H128 W64\n"
			"vfmsub231ps l0 66 38 w0 ba V128 H128 W128\n"
			"vfmsub231ps l1 66 38 w0 ba V256 H256 W256\n"
			"vfmsub231pd l0 66 38 w1 ba V128 H128 W128\n"
			"vfmsub231pd l1 66 38 w1 ba V256 H256 W256\n"
			"vfmsub231ss l0 66 38 w0 bb V128 H128 W32\n"
			"vfmsub231sd l0 66 38 w1 bb V128 H128 W64\n"
			"vfnmadd132ps l0 66 38 w0 9c V128 H128 W128\n"
			"vfnmadd132ps l1 66 38 w0 9c V256 H256 W256\n"
			"vfnmadd132pd l0 66 38 w1 9c V128 H128 W128\n"
			"vfnmadd132pd l1 66 38 w1 9c V256 H256 W256\n"
			"vfnmadd132ss l0 66 38 w0 9d V128 H128 W32\n"
			"vfnmadd132sd l0 66 38 w1 9d V128 H128 W64\n"
			"vfnmadd213ps l0 66 38 w0 ac V128 H128 W128\n"
			"vfnmadd213ps l1 66 38 w0 ac V256 H256 W256\n"
			"vfnmadd213pd l0 66 38 w1 ac V128 H128 W128\n"
			"vfnmadd213pd l1 66 38 w1 ac V256 H256 W256\n"
			"vfnmadd213ss l0 66 38 w0 ad V128 H128 W32\n"
			"vfnmadd213sd l0 66 38 w1 ad V128 H128 W64\n"
			"vfnmadd231ps l0 66 38 w0 bc V128 H128 W128\n"
			"vfnmadd231ps l1 66 38 w0 bc V256 H256 W256\n"
			"vfnmadd231pd l0 66 38 w1 bc V128 H128 W128\n"
			"vfnmadd231pd l1 66 38 w1 bc V256 H256 W256\n"
			"vfnmadd231ss l0 66 38 w0 bd V128 H128 W32\n"
			"vfnmadd231sd l0 66 38 w1 bd V128 H128 W64\n"
			"vfnmsub132ps l0 66 38 w0 9e V128 H128 W128\n"
			"vfnmsub132ps l1 66 38 w0 9e V256 H256 W256\n"
			"vfnmsub132pd l0 66 38 w1 9e V128 H128 W128\n"
			"vfnmsub132pd l1 66 38 w1 9e V256 H256 W256\n"
			"vfnmsub132ss l0 66 38 w0 9f V128 H128 W32\n"
			"vfnmsub132sd l0 66 38 w1 9f V128 H128 W64\n"
			"vfnmsub213ps l0 66 38 w0 ae V128 H128 W128\n"
			"vfnmsub213ps l1 66 38 w0 ae V256 H256 W256\n"
			"vfnmsub213pd l0 66 38 w1 ae V128 H128 W128\n"
			"vfnmsub213pd l1 66 38 w1 ae V256 H256 W256\n"
			"vfnmsub213ss l0 66 38 w0 af V128 H128 W32\n"
			"vfnmsub213sd l0 66 38 w1 af V128 H128 W64\n"
			"vfnmsub231ps l0 66 38 w0 be V128 H128 W128\n"
			"vfnmsub231ps l1 66 38 w0 be V256 H256 W256\n"
			"vfnmsub231pd l0 66 38 w1 be V128 H128 W128\n"
			"vfnmsub231pd l1 66 38 w1 be V256 H256 W256\n"
			"vfnmsub231ss l0 66 38 w0 bf V128 H128 W32\n"
			"vfnmsub231sd l0 66 38 w1 bf V128 H128 W64\n"
			"vfmaddsub132ps l0 66 38 w0 96 V128 H128 W128\n"
			"vfmaddsub132ps l1 66 38 w0 96 V256 H256 W256\n"
			"vfmaddsub132pd l0 66 38 w1 96 V128 H128 W128\n"
			"vfmaddsub132pd l1 66 38 w1 96 V256 H256 W256\n"
			"vfmaddsub213ps l0 66 38 w0 a6 V128 H128 W128\n"
			"vfmaddsub213ps l1 66 38 w0 a6 V256 H256 W256\n"
			"vfmaddsub213pd l0 66 38 w1 a6 V128 H128 W128\n"
			"vfmaddsub213pd l1 66 38 w1 a6 V256 H256 W256\n"
			"vfmaddsub231ps l0 66 38 w0 b6 V128 H128 W128\n"
			"vfmaddsub231ps l1 66 38 w0 b6 V256 H256 W256\n"
			"vfmaddsub231pd l0 66 38 w1 b6 V128 H128 W128\n"
			"vfmaddsub231pd l1 66 38 w1 b6 V256 H256 W256\n"
			"vfmsubadd132ps l0 66 38 w0 97 V128 H128 W128\n"
			"vfmsubadd132ps l1 66 38 w0 97 V256 H256 W256\n"
			"vfmsubadd132pd l0 66 38 w1 97 V128 H128 W128\n"
			"vfmsubadd132pd l1 66 38 w1 97 V256 H256 W256\n"
			"vfmsubadd213ps l0 66 38 w0 a7 V128 H128 W128\n"
			"vfmsubadd213ps l1 66 38 w0 a7 V256 H256 W256\n"
			"vfmsubadd213pd l0 66 38 w1 a7 V128 H128 W128\n"
			"vfmsubadd213pd l1 66 38 w1 a7 V256 H256 W256\n"
			"vfmsubadd231ps l0 66 38 w0 b7 V128 H128 W128\n"
			"vfmsubadd231ps l1 66 38 w0 b7 V256 H256 W256\n"
			"vfmsubadd231pd l0 66 38 w1 b7 V128 H128 W128\n"
			"vfmsubadd231pd l1 66 38 w1 b7 V256 H256 W256\n"
}
