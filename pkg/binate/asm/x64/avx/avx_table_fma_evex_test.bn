package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The EVEX forms of FMA, F16C and vpermps / vpermpd (avx_table_fma.bn, avx_table_ext.bn,
// avx_table_int_move.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): a form of each, with registers 16..31 and its decorations.

func TestTableFmaEvexForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vfmadd132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 98 08") {
		return fail("vfmadd132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmadd132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 98 08") {
		return fail("vfmadd132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmadd132sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 99 08") {
		return fail("vfmadd132sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd132ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 99 08") {
		return fail("vfmadd132ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 a8 08") {
		return fail("vfmadd213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmadd213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 a8 08") {
		return fail("vfmadd213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmadd213sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 a9 08") {
		return fail("vfmadd213sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd213ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 a9 08") {
		return fail("vfmadd213ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 b8 08") {
		return fail("vfmadd231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmadd231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 b8 08") {
		return fail("vfmadd231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmadd231sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 b9 08") {
		return fail("vfmadd231sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmadd231ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 b9 08") {
		return fail("vfmadd231ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmaddsub132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 96 08") {
		return fail("vfmaddsub132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmaddsub132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 96 08") {
		return fail("vfmaddsub132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmaddsub213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 a6 08") {
		return fail("vfmaddsub213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmaddsub213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 a6 08") {
		return fail("vfmaddsub213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmaddsub231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 b6 08") {
		return fail("vfmaddsub231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmaddsub231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 b6 08") {
		return fail("vfmaddsub231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsub132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 9a 08") {
		return fail("vfmsub132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsub132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 9a 08") {
		return fail("vfmsub132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsub132sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 9b 08") {
		return fail("vfmsub132sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub132ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 9b 08") {
		return fail("vfmsub132ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 aa 08") {
		return fail("vfmsub213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsub213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 aa 08") {
		return fail("vfmsub213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsub213sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 ab 08") {
		return fail("vfmsub213sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub213ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 ab 08") {
		return fail("vfmsub213ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 ba 08") {
		return fail("vfmsub231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsub231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 ba 08") {
		return fail("vfmsub231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsub231sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 bb 08") {
		return fail("vfmsub231sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsub231ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 bb 08") {
		return fail("vfmsub231ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfmsubadd132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 97 08") {
		return fail("vfmsubadd132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsubadd132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 97 08") {
		return fail("vfmsubadd132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsubadd213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 a7 08") {
		return fail("vfmsubadd213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsubadd213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 a7 08") {
		return fail("vfmsubadd213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfmsubadd231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 b7 08") {
		return fail("vfmsubadd231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfmsubadd231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 b7 08") {
		return fail("vfmsubadd231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmadd132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 9c 08") {
		return fail("vfnmadd132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmadd132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 9c 08") {
		return fail("vfnmadd132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmadd132sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 9d 08") {
		return fail("vfnmadd132sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd132ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 9d 08") {
		return fail("vfnmadd132ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 ac 08") {
		return fail("vfnmadd213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmadd213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 ac 08") {
		return fail("vfnmadd213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmadd213sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 ad 08") {
		return fail("vfnmadd213sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd213ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 ad 08") {
		return fail("vfnmadd213ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 bc 08") {
		return fail("vfnmadd231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmadd231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 bc 08") {
		return fail("vfnmadd231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmadd231sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 bd 08") {
		return fail("vfnmadd231sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmadd231ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 bd 08") {
		return fail("vfnmadd231ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub132pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 9e 08") {
		return fail("vfnmsub132pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmsub132ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 9e 08") {
		return fail("vfnmsub132ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmsub132sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 9f 08") {
		return fail("vfnmsub132sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub132ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 9f 08") {
		return fail("vfnmsub132ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub213pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 ae 08") {
		return fail("vfnmsub213pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmsub213ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 ae 08") {
		return fail("vfnmsub213ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmsub213sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 af 08") {
		return fail("vfnmsub213sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub213ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 af 08") {
		return fail("vfnmsub213ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub231pd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none,
			"62 e2 ed 10 be 08") {
		return fail("vfnmsub231pd xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vfnmsub231ps", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none,
			"62 e2 6d 10 be 08") {
		return fail("vfnmsub231ps xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vfnmsub231sd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 ed 85 bf 08") {
		return fail("vfnmsub231sd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vfnmsub231ss", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 bf 08") {
		return fail("vfnmsub231ss xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpermps", 3, Ymm(17), Ymm(18), bcstOf(0, x64.SZ32, 8), none, "62 e2 6d 30 16 08") {
		return fail("vpermps ymm17, ymm18, dword ptr [rax]{1to8}")
	}
	if !emitCase("vpermpd", 3, Ymm(17), Ymm(18), bcstOf(0, x64.SZ64, 4), none, "62 e2 ed 30 16 08") {
		return fail("vpermpd ymm17, ymm18, qword ptr [rax]{1to4}")
	}
	if !emitCase("vcvtph2ps", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 13 08") {
		return fail("vcvtph2ps xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vcvtps2ph", 3, maskOf(x64.Mem(x64.RAX, 0, 0), 5, false), Xmm(18), x64.Imm(1), none,
			"62 e3 7d 0d 1d 10 01") {
		return fail("vcvtps2ph [rax] {k5}, xmm18, 1")
	}
	return ""
}
