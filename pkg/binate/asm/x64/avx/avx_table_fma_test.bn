package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The FMA part of the table (avx_table_fma.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10.
func TestTableFmaForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vfmadd132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 98 0a") {
		return fail("vfmadd132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 98 0a") {
		return fail("vfmadd132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd132ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 99 0a") {
		return fail("vfmadd132ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmadd132sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 99 0a") {
		return fail("vfmadd132sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmadd213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 a8 0a") {
		return fail("vfmadd213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 a8 0a") {
		return fail("vfmadd213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd213ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 a9 0a") {
		return fail("vfmadd213ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmadd213sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 a9 0a") {
		return fail("vfmadd213sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmadd231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 b8 0a") {
		return fail("vfmadd231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 b8 0a") {
		return fail("vfmadd231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmadd231ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 b9 0a") {
		return fail("vfmadd231ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmadd231sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 b9 0a") {
		return fail("vfmadd231sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmsub132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 9a 0a") {
		return fail("vfmsub132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 9a 0a") {
		return fail("vfmsub132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub132ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 9b 0a") {
		return fail("vfmsub132ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmsub132sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 9b 0a") {
		return fail("vfmsub132sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmsub213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 aa 0a") {
		return fail("vfmsub213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 aa 0a") {
		return fail("vfmsub213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub213ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 ab 0a") {
		return fail("vfmsub213ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmsub213sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 ab 0a") {
		return fail("vfmsub213sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmsub231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 ba 0a") {
		return fail("vfmsub231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 ba 0a") {
		return fail("vfmsub231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsub231ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 bb 0a") {
		return fail("vfmsub231ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfmsub231sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 bb 0a") {
		return fail("vfmsub231sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmadd132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 9c 0a") {
		return fail("vfnmadd132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 9c 0a") {
		return fail("vfnmadd132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd132ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 9d 0a") {
		return fail("vfnmadd132ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmadd132sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 9d 0a") {
		return fail("vfnmadd132sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmadd213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 ac 0a") {
		return fail("vfnmadd213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 ac 0a") {
		return fail("vfnmadd213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd213ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 ad 0a") {
		return fail("vfnmadd213ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmadd213sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 ad 0a") {
		return fail("vfnmadd213sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmadd231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 bc 0a") {
		return fail("vfnmadd231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 bc 0a") {
		return fail("vfnmadd231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmadd231ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 bd 0a") {
		return fail("vfnmadd231ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmadd231sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 bd 0a") {
		return fail("vfnmadd231sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmsub132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 9e 0a") {
		return fail("vfnmsub132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 9e 0a") {
		return fail("vfnmsub132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub132ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 9f 0a") {
		return fail("vfnmsub132ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmsub132sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 9f 0a") {
		return fail("vfnmsub132sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmsub213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 ae 0a") {
		return fail("vfnmsub213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 ae 0a") {
		return fail("vfnmsub213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub213ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 af 0a") {
		return fail("vfnmsub213ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmsub213sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 af 0a") {
		return fail("vfnmsub213sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfnmsub231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 be 0a") {
		return fail("vfnmsub231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 be 0a") {
		return fail("vfnmsub231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfnmsub231ss", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), none,
			"c4 42 21 bf 0a") {
		return fail("vfnmsub231ss xmm9, xmm11, dword ptr [r10]")
	}
	if !emitCase("vfnmsub231sd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), none,
			"c4 42 a1 bf 0a") {
		return fail("vfnmsub231sd xmm9, xmm11, qword ptr [r10]")
	}
	if !emitCase("vfmaddsub132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 96 0a") {
		return fail("vfmaddsub132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsub132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 96 0a") {
		return fail("vfmaddsub132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsub213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 a6 0a") {
		return fail("vfmaddsub213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsub213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 a6 0a") {
		return fail("vfmaddsub213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsub231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 b6 0a") {
		return fail("vfmaddsub231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmaddsub231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 b6 0a") {
		return fail("vfmaddsub231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd132ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 97 0a") {
		return fail("vfmsubadd132ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd132pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 97 0a") {
		return fail("vfmsubadd132pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd213ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 a7 0a") {
		return fail("vfmsubadd213ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd213pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 a7 0a") {
		return fail("vfmsubadd213pd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd231ps", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 b7 0a") {
		return fail("vfmsubadd231ps xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vfmsubadd231pd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 b7 0a") {
		return fail("vfmsubadd231pd xmm9, xmm11, xmmword ptr [r10]")
	}
	return ""
}
