package "pkg/binate/asm/x64/avx"

// tableGather returns the part of the gathers and AVX-512's scatters, a form a line, each after a
// newline: a gather loads the destination's elements from memory with a vector index (x, y, z:
// VSIB), those the mask selects — a VEX gather's mask a vector register (H), an EVEX one's a mask
// register it needs (K) — and a scatter stores them.
func tableGather() *[]readonly char {
	return "\n"
			"vgatherdps l0 66 38 w0 92 V128 x32 H128\n"
			"vgatherdps l1 66 38 w0 92 V256 y32 H256\n"
			"vgatherdps e0 66 38 w0 92 K V128 x32\n"
			"vgatherdps e1 66 38 w0 92 K V256 y32\n"
			"vgatherdps e2 66 38 w0 92 K V512 z32\n"
			"vgatherdpd l0 66 38 w1 92 V128 x64 H128\n"
			"vgatherdpd l1 66 38 w1 92 V256 x64 H256\n"
			"vgatherdpd e0 66 38 w1 92 K V128 x64\n"
			"vgatherdpd e1 66 38 w1 92 K V256 x64\n"
			"vgatherdpd e2 66 38 w1 92 K V512 y64\n"
			"vgatherqps l0 66 38 w0 93 V128 x32 H128\n"
			"vgatherqps l1 66 38 w0 93 V128 y32 H128\n"
			"vgatherqps e0 66 38 w0 93 K V128 x32\n"
			"vgatherqps e1 66 38 w0 93 K V128 y32\n"
			"vgatherqps e2 66 38 w0 93 K V256 z32\n"
			"vgatherqpd l0 66 38 w1 93 V128 x64 H128\n"
			"vgatherqpd l1 66 38 w1 93 V256 y64 H256\n"
			"vgatherqpd e0 66 38 w1 93 K V128 x64\n"
			"vgatherqpd e1 66 38 w1 93 K V256 y64\n"
			"vgatherqpd e2 66 38 w1 93 K V512 z64\n"
			"vpgatherdd l0 66 38 w0 90 V128 x32 H128\n"
			"vpgatherdd l1 66 38 w0 90 V256 y32 H256\n"
			"vpgatherdd e0 66 38 w0 90 K V128 x32\n"
			"vpgatherdd e1 66 38 w0 90 K V256 y32\n"
			"vpgatherdd e2 66 38 w0 90 K V512 z32\n"
			"vpgatherdq l0 66 38 w1 90 V128 x64 H128\n"
			"vpgatherdq l1 66 38 w1 90 V256 x64 H256\n"
			"vpgatherdq e0 66 38 w1 90 K V128 x64\n"
			"vpgatherdq e1 66 38 w1 90 K V256 x64\n"
			"vpgatherdq e2 66 38 w1 90 K V512 y64\n"
			"vpgatherqd l0 66 38 w0 91 V128 x32 H128\n"
			"vpgatherqd l1 66 38 w0 91 V128 y32 H128\n"
			"vpgatherqd e0 66 38 w0 91 K V128 x32\n"
			"vpgatherqd e1 66 38 w0 91 K V128 y32\n"
			"vpgatherqd e2 66 38 w0 91 K V256 z32\n"
			"vpgatherqq l0 66 38 w1 91 V128 x64 H128\n"
			"vpgatherqq l1 66 38 w1 91 V256 y64 H256\n"
			"vpgatherqq e0 66 38 w1 91 K V128 x64\n"
			"vpgatherqq e1 66 38 w1 91 K V256 y64\n"
			"vpgatherqq e2 66 38 w1 91 K V512 z64\n"
			"vpscatterdd e0 66 38 w0 a0 K x32 V128\n"
			"vpscatterdd e1 66 38 w0 a0 K y32 V256\n"
			"vpscatterdd e2 66 38 w0 a0 K z32 V512\n"
			"vpscatterdq e0 66 38 w1 a0 K x64 V128\n"
			"vpscatterdq e1 66 38 w1 a0 K x64 V256\n"
			"vpscatterdq e2 66 38 w1 a0 K y64 V512\n"
			"vpscatterqd e0 66 38 w0 a1 K x32 V128\n"
			"vpscatterqd e1 66 38 w0 a1 K y32 V128\n"
			"vpscatterqd e2 66 38 w0 a1 K z32 V256\n"
			"vpscatterqq e0 66 38 w1 a1 K x64 V128\n"
			"vpscatterqq e1 66 38 w1 a1 K y64 V256\n"
			"vpscatterqq e2 66 38 w1 a1 K z64 V512\n"
			"vscatterdps e0 66 38 w0 a2 K x32 V128\n"
			"vscatterdps e1 66 38 w0 a2 K y32 V256\n"
			"vscatterdps e2 66 38 w0 a2 K z32 V512\n"
			"vscatterdpd e0 66 38 w1 a2 K x64 V128\n"
			"vscatterdpd e1 66 38 w1 a2 K x64 V256\n"
			"vscatterdpd e2 66 38 w1 a2 K y64 V512\n"
			"vscatterqps e0 66 38 w0 a3 K x32 V128\n"
			"vscatterqps e1 66 38 w0 a3 K y32 V128\n"
			"vscatterqps e2 66 38 w0 a3 K z32 V256\n"
			"vscatterqpd e0 66 38 w1 a3 K x64 V128\n"
			"vscatterqpd e1 66 38 w1 a3 K y64 V256\n"
			"vscatterqpd e2 66 38 w1 a3 K z64 V512\n"
}
