package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The EVEX gathers and scatters (avx_table_gather.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): forms of each, with registers and
// indexes 16..31; the write mask they need; a gather's destination its index, which faults.

func TestTableGatherEvexForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vgatherdps", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 7d 09 92 0c 90") {
		return fail("vgatherdps xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vgatherdps", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 7d 01 92 0c 90") {
		return fail("vgatherdps xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vgatherdps", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 7d 01 92 3c b0") {
		return fail("vgatherdps xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vgatherdpd", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 fd 09 92 0c 90") {
		return fail("vgatherdpd xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vgatherdpd", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 fd 01 92 0c 90") {
		return fail("vgatherdpd xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vgatherdpd", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 fd 01 92 3c b0") {
		return fail("vgatherdpd xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vgatherqps", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 7d 09 93 0c 90") {
		return fail("vgatherqps xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vgatherqps", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 7d 01 93 0c 90") {
		return fail("vgatherqps xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vgatherqps", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 7d 01 93 3c b0") {
		return fail("vgatherqps xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vgatherqpd", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 fd 09 93 0c 90") {
		return fail("vgatherqpd xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vgatherqpd", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 fd 01 93 0c 90") {
		return fail("vgatherqpd xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vgatherqpd", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 fd 01 93 3c b0") {
		return fail("vgatherqpd xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vpgatherdd", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 7d 09 90 0c 90") {
		return fail("vpgatherdd xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vpgatherdd", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 7d 01 90 0c 90") {
		return fail("vpgatherdd xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vpgatherdd", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 7d 01 90 3c b0") {
		return fail("vpgatherdd xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vpgatherdq", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 fd 09 90 0c 90") {
		return fail("vpgatherdq xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vpgatherdq", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 fd 01 90 0c 90") {
		return fail("vpgatherdq xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vpgatherdq", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 fd 01 90 3c b0") {
		return fail("vpgatherdq xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vpgatherqd", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 7d 09 91 0c 90") {
		return fail("vpgatherqd xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vpgatherqd", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 7d 01 91 0c 90") {
		return fail("vpgatherqd xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vpgatherqd", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 7d 01 91 3c b0") {
		return fail("vpgatherqd xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vpgatherqq", 2, maskOf(Xmm(1), 1, false),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), none, none, "62 f2 fd 09 91 0c 90") {
		return fail("vpgatherqq xmm1 {k1}, [rax + xmm2*4]")
	}
	if !emitCase("vpgatherqq", 2, maskOf(Xmm(17), 1, false),
			x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), none, none, "62 e2 fd 01 91 0c 90") {
		return fail("vpgatherqq xmm17 {k1}, [rax + xmm18*4]")
	}
	if !emitCase("vpgatherqq", 2, maskOf(Xmm(31), 1, false),
			x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), none, none, "62 22 fd 01 91 3c b0") {
		return fail("vpgatherqq xmm31 {k1}, [rax + xmm30*4]")
	}
	if !emitCase("vscatterdps", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 7d 09 a2 0c 90") {
		return fail("vscatterdps [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vscatterdps", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 7d 01 a2 0c 90") {
		return fail("vscatterdps [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vscatterdps", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 7d 01 a2 3c b0") {
		return fail("vscatterdps [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vscatterdpd", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 fd 09 a2 0c 90") {
		return fail("vscatterdpd [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vscatterdpd", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 fd 01 a2 0c 90") {
		return fail("vscatterdpd [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vscatterdpd", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 fd 01 a2 3c b0") {
		return fail("vscatterdpd [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vscatterqps", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 7d 09 a3 0c 90") {
		return fail("vscatterqps [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vscatterqps", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 7d 01 a3 0c 90") {
		return fail("vscatterqps [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vscatterqps", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 7d 01 a3 3c b0") {
		return fail("vscatterqps [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vscatterqpd", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 fd 09 a3 0c 90") {
		return fail("vscatterqpd [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vscatterqpd", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 fd 01 a3 0c 90") {
		return fail("vscatterqpd [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vscatterqpd", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 fd 01 a3 3c b0") {
		return fail("vscatterqpd [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vpscatterdd", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 7d 09 a0 0c 90") {
		return fail("vpscatterdd [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vpscatterdd", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 7d 01 a0 0c 90") {
		return fail("vpscatterdd [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vpscatterdd", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 7d 01 a0 3c b0") {
		return fail("vpscatterdd [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vpscatterdq", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 fd 09 a0 0c 90") {
		return fail("vpscatterdq [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vpscatterdq", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 fd 01 a0 0c 90") {
		return fail("vpscatterdq [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vpscatterdq", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 fd 01 a0 3c b0") {
		return fail("vpscatterdq [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vpscatterqd", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 7d 09 a1 0c 90") {
		return fail("vpscatterqd [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vpscatterqd", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 7d 01 a1 0c 90") {
		return fail("vpscatterqd [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vpscatterqd", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 7d 01 a1 3c b0") {
		return fail("vpscatterqd [rax + xmm30*4] {k1}, xmm31")
	}
	if !emitCase("vpscatterqq", 2, maskOf(x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(1), none, none, "62 f2 fd 09 a1 0c 90") {
		return fail("vpscatterqq [rax + xmm2*4] {k1}, xmm1")
	}
	if !emitCase("vpscatterqq", 2, maskOf(x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(17), none, none, "62 e2 fd 01 a1 0c 90") {
		return fail("vpscatterqq [rax + xmm18*4] {k1}, xmm17")
	}
	if !emitCase("vpscatterqq", 2, maskOf(x64.MemVsib(x64.RAX, 30, 4, 0, 0, x64.SZ128), 1, false),
			Xmm(31), none, none, "62 22 fd 01 a1 3c b0") {
		return fail("vpscatterqq [rax + xmm30*4] {k1}, xmm31")
	}
	return ""
}

func TestTableGatherEvexRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vgatherdps", 2, Zmm(1), x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), none, none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vgatherdps: takes a write mask") {
		return fail("vgatherdps zmm1, [rax + zmm2*4]")
	}
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 2, maskOf(Zmm(1), 1, false),
			x64.MemVsib(x64.RAX, 1, 4, 0, 0, x64.SZ512), none, none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: vgatherdps: takes a destination and an index") {
		return fail("vgatherdps zmm1 {k1}, [rax + zmm1*4]")
	}
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 2, maskOf(Zmm(1), 1, true),
			x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ512), none, none)
	if !rejected(a) { return fail("vgatherdps zmm1 {k1} {z}, [rax + zmm2*4]") }
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 17, 4, 0, 0, x64.SZ128),
			sse.Xmm(3), none)
	if !rejected(a) { return fail("vgatherdps xmm1, [rax + xmm17*4], xmm3 (VEX)") }
	if !emitCase("vscatterdps", 2, maskOf(x64.MemVsib(x64.RAX, 1, 4, 0, 0, x64.SZ512), 1, false),
			Zmm(1), none, none, "62 f2 7d 49 a2 0c 88") {
		return fail("vscatterdps [rax + zmm1*4] {k1}, zmm1")
	}
	return ""
}
