package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The gathers' part of the table (avx_table_gather.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each form with registers 8..15 in
// each field and an element's size written, and with none; and what clang and GNU as warn about or
// reject.

func TestTableGatherForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vgatherdps", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ128),
			sse.Xmm(12), none, "c4 02 19 92 4c 9a 08") {
		return fail("vgatherdps xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vgatherdps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 61 92 0c d0") {
		return fail("vgatherdps xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vgatherdps", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ256), Ymm(12),
			none, "c4 02 1d 92 4c 9a 08") {
		return fail("vgatherdps ymm9, dword ptr [r10 + ymm11*4 + 8], ymm12")
	}
	if !emitCase("vgatherdps", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), Ymm(3), none,
			"c4 e2 65 92 0c d0") {
		return fail("vgatherdps ymm1, [rax + ymm2*8], ymm3")
	}
	if !emitCase("vgatherdpd", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128),
			sse.Xmm(12), none, "c4 02 99 92 4c 9a 08") {
		return fail("vgatherdpd xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vgatherdpd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 e1 92 0c d0") {
		return fail("vgatherdpd xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vgatherdpd", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128), Ymm(12),
			none, "c4 02 9d 92 4c 9a 08") {
		return fail("vgatherdpd ymm9, qword ptr [r10 + xmm11*4 + 8], ymm12")
	}
	if !emitCase("vgatherdpd", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), Ymm(3), none,
			"c4 e2 e5 92 0c d0") {
		return fail("vgatherdpd ymm1, [rax + xmm2*8], ymm3")
	}
	if !emitCase("vgatherqps", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ128),
			sse.Xmm(12), none, "c4 02 19 93 4c 9a 08") {
		return fail("vgatherqps xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vgatherqps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 61 93 0c d0") {
		return fail("vgatherqps xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vgatherqps", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ256),
			sse.Xmm(12), none, "c4 02 1d 93 4c 9a 08") {
		return fail("vgatherqps xmm9, dword ptr [r10 + ymm11*4 + 8], xmm12")
	}
	if !emitCase("vgatherqps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), sse.Xmm(3),
			none, "c4 e2 65 93 0c d0") {
		return fail("vgatherqps xmm1, [rax + ymm2*8], xmm3")
	}
	if !emitCase("vgatherqpd", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128),
			sse.Xmm(12), none, "c4 02 99 93 4c 9a 08") {
		return fail("vgatherqpd xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vgatherqpd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 e1 93 0c d0") {
		return fail("vgatherqpd xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vgatherqpd", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ256), Ymm(12),
			none, "c4 02 9d 93 4c 9a 08") {
		return fail("vgatherqpd ymm9, qword ptr [r10 + ymm11*4 + 8], ymm12")
	}
	if !emitCase("vgatherqpd", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), Ymm(3), none,
			"c4 e2 e5 93 0c d0") {
		return fail("vgatherqpd ymm1, [rax + ymm2*8], ymm3")
	}
	if !emitCase("vpgatherdd", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ128),
			sse.Xmm(12), none, "c4 02 19 90 4c 9a 08") {
		return fail("vpgatherdd xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vpgatherdd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 61 90 0c d0") {
		return fail("vpgatherdd xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vpgatherdd", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ256), Ymm(12),
			none, "c4 02 1d 90 4c 9a 08") {
		return fail("vpgatherdd ymm9, dword ptr [r10 + ymm11*4 + 8], ymm12")
	}
	if !emitCase("vpgatherdd", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), Ymm(3), none,
			"c4 e2 65 90 0c d0") {
		return fail("vpgatherdd ymm1, [rax + ymm2*8], ymm3")
	}
	if !emitCase("vpgatherdq", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128),
			sse.Xmm(12), none, "c4 02 99 90 4c 9a 08") {
		return fail("vpgatherdq xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vpgatherdq", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 e1 90 0c d0") {
		return fail("vpgatherdq xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vpgatherdq", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128), Ymm(12),
			none, "c4 02 9d 90 4c 9a 08") {
		return fail("vpgatherdq ymm9, qword ptr [r10 + xmm11*4 + 8], ymm12")
	}
	if !emitCase("vpgatherdq", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), Ymm(3), none,
			"c4 e2 e5 90 0c d0") {
		return fail("vpgatherdq ymm1, [rax + xmm2*8], ymm3")
	}
	if !emitCase("vpgatherqd", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ128),
			sse.Xmm(12), none, "c4 02 19 91 4c 9a 08") {
		return fail("vpgatherqd xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vpgatherqd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 61 91 0c d0") {
		return fail("vpgatherqd xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vpgatherqd", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ32, x64.SZ256),
			sse.Xmm(12), none, "c4 02 1d 91 4c 9a 08") {
		return fail("vpgatherqd xmm9, dword ptr [r10 + ymm11*4 + 8], xmm12")
	}
	if !emitCase("vpgatherqd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), sse.Xmm(3),
			none, "c4 e2 65 91 0c d0") {
		return fail("vpgatherqd xmm1, [rax + ymm2*8], xmm3")
	}
	if !emitCase("vpgatherqq", 3, sse.Xmm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ128),
			sse.Xmm(12), none, "c4 02 99 91 4c 9a 08") {
		return fail("vpgatherqq xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12")
	}
	if !emitCase("vpgatherqq", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ128), sse.Xmm(3),
			none, "c4 e2 e1 91 0c d0") {
		return fail("vpgatherqq xmm1, [rax + xmm2*8], xmm3")
	}
	if !emitCase("vpgatherqq", 3, Ymm(9), x64.MemVsib(x64.R10, 11, 4, 8, x64.SZ64, x64.SZ256), Ymm(12),
			none, "c4 02 9d 91 4c 9a 08") {
		return fail("vpgatherqq ymm9, qword ptr [r10 + ymm11*4 + 8], ymm12")
	}
	if !emitCase("vpgatherqq", 3, Ymm(1), x64.MemVsib(x64.RAX, 2, 8, 0, 0, x64.SZ256), Ymm(3), none,
			"c4 e2 e5 91 0c d0") {
		return fail("vpgatherqq ymm1, [rax + ymm2*8], ymm3")
	}
	return ""
}

// Destination, index and mask registers alike (#UD: clang and GNU as warn); an element's size
// other than the form's, an index of the other width, ordinary memory; a vector index anywhere but
// a gather.
func TestTableGatherRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = emitOps(a, "vpgatherdd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128),
			sse.Xmm(1), none)
	if !rejected(a) ||
			!msgHasPrefix(a.ErrorMsg, "x64: vpgatherdd: takes destination, index and mask") {
		return fail("vpgatherdd xmm1, [rax + xmm2*4], xmm1")
	}
	a = newAsm()
	_ = emitOps(a, "vpgatherdd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 1, 4, 0, 0, x64.SZ128),
			sse.Xmm(3), none)
	if !rejected(a) { return fail("vpgatherdd xmm1, [rax + xmm1*4], xmm3") }
	a = newAsm()
	_ = emitOps(a, "vpgatherdd", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128),
			sse.Xmm(2), none)
	if !rejected(a) { return fail("vpgatherdd xmm1, [rax + xmm2*4], xmm2") }
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 4, 0, x64.SZ64, x64.SZ128),
			sse.Xmm(3), none)
	if !rejected(a) { return fail("vgatherdps xmm1, qword ptr [rax + xmm2*4], xmm3") }
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 3, sse.Xmm(1), x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ256),
			sse.Xmm(3), none)
	if !rejected(a) { return fail("vgatherdps xmm1, [rax + ymm2*4], xmm3") }
	a = newAsm()
	_ = emitOps(a, "vgatherdps", 3, sse.Xmm(1), x64.Mem(x64.RAX, 0, 0), sse.Xmm(3), none)
	if !rejected(a) { return fail("vgatherdps xmm1, [rax], xmm3") }
	a = newAsm()
	_ = emitOps(a, "vaddps", 3, sse.Xmm(1), sse.Xmm(2), x64.MemVsib(x64.RAX, 2, 4, 0, 0, x64.SZ128),
			none)
	if !rejected(a) { return fail("vaddps xmm1, xmm2, [rax + xmm2*4]") }
	return ""
}
