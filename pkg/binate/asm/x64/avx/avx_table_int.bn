package "pkg/binate/asm/x64/avx"

// tableInt returns AVX and AVX2's integer arithmetic part, a form a line, each after a newline: the
// VEX forms of SSE2 .. SSE4.1's add, subtract, multiply, multiply-add, average, absolute value,
// sign, minimum and maximum, sums of absolute differences and horizontal arithmetic, at 128 bits
// (AVX) and 256 (AVX2).
func tableInt() *[]readonly char {
	return "\n"
			"vmpsadbw l0 66 3a w0 42 V128 H128 W128 I\n"
			"vmpsadbw l1 66 3a w0 42 V256 H256 W256 I\n"
			"vpabsb l0 66 38 w0 1c V128 W128\n"
			"vpabsb l1 66 38 w0 1c V256 W256\n"
