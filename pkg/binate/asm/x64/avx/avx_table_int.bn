			"vpmaxub l1 66 0f w0 de V256 H256 W256\n"
			"vpmaxub l1 66 0f w0 de V256 U256 H256\n"
			"vpmaxud l0 66 38 w0 3f V128 H128 W128\n"
			"vpmaxud l1 66 38 w0 3f V256 H256 W256\n"
			"vpmaxuw l0 66 38 w0 3e V128 H128 W128\n"
			"vpmaxuw l1 66 38 w0 3e V256 H256 W256\n"
			"vpminsb l0 66 38 w0 38 V128 H128 W128\n"
			"vpminsb l1 66 38 w0 38 V256 H256 W256\n"
			"vpminsd l0 66 38 w0 39 V128 H128 W128\n"
