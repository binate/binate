			"vpminuw l1 66 38 w0 3a V256 H256 W256\n"
			"vpmuldq l0 66 38 w0 28 V128 H128 W128\n"
			"vpmuldq l1 66 38 w0 28 V256 H256 W256\n"
			"vpmulhrsw l0 66 38 w0 0b V128 H128 W128\n"
			"vpmulhrsw l1 66 38 w0 0b V256 H256 W256\n"
			"vpmulhuw l0 66 0f w0 e4 V128 H128 W128\n"
			"vpmulhuw l0 66 0f w0 e4 V128 U128 H128\n"
			"vpmulhuw l1 66 0f w0 e4 V256 H256 W256\n"
			"vpmulhuw l1 66 0f w0 e4 V256 U256 H256\n"
			"vpmulhw l0 66 0f w0 e5 V128 H128 W128\n"
			"vpmulhw l0 66 0f w0 e5 V128 U128 H128\n"
			"vpmulhw l1 66 0f w0 e5 V256 H256 W256\n"
			"vpmulhw l1 66 0f w0 e5 V256 U256 H256\n"
			"vpmulld l0 66 38 w0 40 V128 H128 W128\n"
			"vpmulld l1 66 38 w0 40 V256 H256 W256\n"
			"vpmullw l0 66 0f w0 d5 V128 H128 W128\n"
			"vpmullw l0 66 0f w0 d5 V128 U128 H128\n"
			"vpmullw l1 66 0f w0 d5 V256 H256 W256\n"
			"vpmullw l1 66 0f w0 d5 V256 U256 H256\n"
			"vpmuludq l0 66 0f w0 f4 V128 H128 W128\n"
			"vpmuludq l0 66 0f w0 f4 V128 U128 H128\n"
			"vpmuludq l1 66 0f w0 f4 V256 H256 W256\n"
			"vpmuludq l1 66 0f w0 f4 V256 U256 H256\n"
			"vpsadbw l0 66 0f w0 f6 V128 H128 W128\n"
			"vpsadbw l0 66 0f w0 f6 V128 U128 H128\n"
			"vpsadbw l1 66 0f w0 f6 V256 H256 W256\n"
			"vpsadbw l1 66 0f w0 f6 V256 U256 H256\n"
