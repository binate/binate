			"vphaddd l0 66 38 w0 02 V128 H128 W128\n"
			"vphaddd l1 66 38 w0 02 V256 H256 W256\n"
			"vphaddsw l0 66 38 w0 03 V128 H128 W128\n"
			"vphaddsw l1 66 38 w0 03 V256 H256 W256\n"
			"vphaddw l0 66 38 w0 01 V128 H128 W128\n"
			"vphaddw l1 66 38 w0 01 V256 H256 W256\n"
			"vphsubd l0 66 38 w0 06 V128 H128 W128\n"
			"vphsubd l1 66 38 w0 06 V256 H256 W256\n"
			"vphsubsw l0 66 38 w0 07 V128 H128 W128\n"
