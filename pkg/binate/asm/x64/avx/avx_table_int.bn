			"vpaddb l0 66 0f w0 fc V128 H128 W128\n"
			"vpaddb l0 66 0f w0 fc V128 U128 H128\n"
			"vpaddb l1 66 0f w0 fc V256 H256 W256\n"
			"vpaddb l1 66 0f w0 fc V256 U256 H256\n"
			"vpaddd l0 66 0f w0 fe V128 H128 W128\n"
			"vpaddd l0 66 0f w0 fe V128 U128 H128\n"
			"vpaddd l1 66 0f w0 fe V256 H256 W256\n"
			"vpaddd l1 66 0f w0 fe V256 U256 H256\n"
			"vpaddq l0 66 0f w0 d4 V128 H128 W128\n"
			"vpaddq l0 66 0f w0 d4 V128 U128 H128\n"
			"vpaddq l1 66 0f w0 d4 V256 H256 W256\n"
			"vpaddq l1 66 0f w0 d4 V256 U256 H256\n"
			"vpaddsb l0 66 0f w0 ec V128 H128 W128\n"
			"vpaddsb l0 66 0f w0 ec V128 U128 H128\n"
			"vpaddsb l1 66 0f w0 ec V256 H256 W256\n"
			"vpaddsb l1 66 0f w0 ec V256 U256 H256\n"
			"vpaddsw l0 66 0f w0 ed V128 H128 W128\n"
			"vpaddsw l0 66 0f w0 ed V128 U128 H128\n"
			"vpaddsw l1 66 0f w0 ed V256 H256 W256\n"
			"vpaddsw l1 66 0f w0 ed V256 U256 H256\n"
			"vpaddusb l0 66 0f w0 dc V128 H128 W128\n"
			"vpaddusb l0 66 0f w0 dc V128 U128 H128\n"
			"vpaddusb l1 66 0f w0 dc V256 H256 W256\n"
			"vpaddusb l1 66 0f w0 dc V256 U256 H256\n"
			"vpaddusw l0 66 0f w0 dd V128 H128 W128\n"
			"vpaddusw l0 66 0f w0 dd V128 U128 H128\n"
			"vpaddusw l1 66 0f w0 dd V256 H256 W256\n"
			"vpaddusw l1 66 0f w0 dd V256 U256 H256\n"
			"vpaddw l0 66 0f w0 fd V128 H128 W128\n"
			"vpaddw l0 66 0f w0 fd V128 U128 H128\n"
			"vpaddw l1 66 0f w0 fd V256 H256 W256\n"
			"vpaddw l1 66 0f w0 fd V256 U256 H256\n"
			"vpavgb l0 66 0f w0 e0 V128 H128 W128\n"
			"vpavgb l0 66 0f w0 e0 V128 U128 H128\n"
