package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The EVEX forms of the VEX table's integer instructions (avx_table_int.bn, avx_table_int_logic.bn,
// avx_table_int_move.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): a form of each, with registers 16..31 and its decorations.

func TestTableIntEvexForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vmovd", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none, "62 e1 7d 08 6e 48 10") {
		return fail("vmovd xmm17, [rax + 64]")
	}
	if !emitCase("vmovntdq", 2, x64.Mem(x64.RAX, 64, 0), Xmm(18), none, none, "62 e1 7d 08 e7 50 04") {
		return fail("vmovntdq [rax + 64], xmm18")
	}
	if !emitCase("vmovntdqa", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none,
			"62 e2 7d 08 2a 48 04") {
		return fail("vmovntdqa xmm17, [rax + 64]")
	}
	if !emitCase("vmovq", 2, Xmm(17), x64.Mem(x64.RAX, 64, 0), none, none, "62 e1 fe 08 7e 48 08") {
		return fail("vmovq xmm17, [rax + 64]")
	}
	if !emitCase("vmovq.s", 2, Xmm(17), Xmm(18), none, none, "62 a1 fd 08 d6 d1") {
		return fail("vmovq.s xmm17, xmm18")
	}
	if !emitCase("vpabsb", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 1c 08") {
		return fail("vpabsb xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpabsd", 2, Xmm(17), bcstOf(0, x64.SZ32, 4), none, none, "62 e2 7d 18 1e 08") {
		return fail("vpabsd xmm17, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpabsw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 1d 08") {
		return fail("vpabsw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpackssdw", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 6b 08") {
		return fail("vpackssdw xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpacksswb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 63 08") {
		return fail("vpacksswb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpackusdw", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 2b 08") {
		return fail("vpackusdw xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpackuswb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 67 08") {
		return fail("vpackuswb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 fc 08") {
		return fail("vpaddb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e1 6d 10 fe 08") {
		return fail("vpaddd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpaddq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 d4 08") {
		return fail("vpaddq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpaddsb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 ec 08") {
		return fail("vpaddsb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddsw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 ed 08") {
		return fail("vpaddsw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddusb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 dc 08") {
		return fail("vpaddusb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddusw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 dd 08") {
		return fail("vpaddusw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpaddw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 fd 08") {
		return fail("vpaddw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpalignr", 4, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), x64.Imm(1),
			"62 e3 6d 85 0f 08 01") {
		return fail("vpalignr xmm17 {k5} {z}, xmm18, [rax], 1")
	}
	if !emitCase("vpavgb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e0 08") {
		return fail("vpavgb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpavgw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e3 08") {
		return fail("vpavgw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpbroadcastb", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 78 08") {
		return fail("vpbroadcastb xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpbroadcastd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 58 08") {
		return fail("vpbroadcastd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpbroadcastq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 fd 8d 59 08") {
		return fail("vpbroadcastq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpbroadcastw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 79 08") {
		return fail("vpbroadcastw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpcmpeqb", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f1 6d 05 74 08") {
		return fail("vpcmpeqb k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpcmpeqd", 3, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 f1 6d 10 76 08") {
		return fail("vpcmpeqd k1, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpcmpeqq", 3, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 f2 ed 10 29 08") {
		return fail("vpcmpeqq k1, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpcmpeqw", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f1 6d 05 75 08") {
		return fail("vpcmpeqw k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpcmpgtb", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f1 6d 05 64 08") {
		return fail("vpcmpgtb k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpcmpgtd", 3, K(1), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 f1 6d 10 66 08") {
		return fail("vpcmpgtd k1, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpcmpgtq", 3, K(1), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 f2 ed 10 37 08") {
		return fail("vpcmpgtq k1, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpcmpgtw", 3, maskOf(K(1), 5, false), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 f1 6d 05 65 08") {
		return fail("vpcmpgtw k1 {k5}, xmm18, [rax]")
	}
	if !emitCase("vpermd", 3, Ymm(17), Ymm(18), bcstOf(0, x64.SZ32, 8), none, "62 e2 6d 30 36 08") {
		return fail("vpermd ymm17, ymm18, dword ptr [rax]{1to8}")
	}
	if !emitCase("vpermq", 3, Ymm(17), Ymm(18), bcstOf(0, x64.SZ64, 4), none, "62 e2 ed 30 36 08") {
		return fail("vpermq ymm17, ymm18, qword ptr [rax]{1to4}")
	}
	if !emitCase("vpmaddubsw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 04 08") {
		return fail("vpmaddubsw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmaddwd", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 f5 08") {
		return fail("vpmaddwd xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmaxsb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 3c 08") {
		return fail("vpmaxsb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmaxsd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 3d 08") {
		return fail("vpmaxsd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpmaxsw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 ee 08") {
		return fail("vpmaxsw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmaxub", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 de 08") {
		return fail("vpmaxub xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmaxud", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 3f 08") {
		return fail("vpmaxud xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpmaxuw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 3e 08") {
		return fail("vpmaxuw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpminsb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 38 08") {
		return fail("vpminsb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpminsd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 39 08") {
		return fail("vpminsd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpminsw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 ea 08") {
		return fail("vpminsw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpminub", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 da 08") {
		return fail("vpminub xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpminud", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 3b 08") {
		return fail("vpminud xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpminuw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 3a 08") {
		return fail("vpminuw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmovsxbd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 21 08") {
		return fail("vpmovsxbd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovsxbq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 22 08") {
		return fail("vpmovsxbq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovsxbw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 20 08") {
		return fail("vpmovsxbw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovsxdq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 25 08") {
		return fail("vpmovsxdq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovsxwd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 23 08") {
		return fail("vpmovsxwd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovsxwq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 24 08") {
		return fail("vpmovsxwq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxbd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 31 08") {
		return fail("vpmovzxbd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxbq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 32 08") {
		return fail("vpmovzxbq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxbw", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 30 08") {
		return fail("vpmovzxbw xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxdq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 35 08") {
		return fail("vpmovzxdq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxwd", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 33 08") {
		return fail("vpmovzxwd xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmovzxwq", 2, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), none, none,
			"62 e2 7d 8d 34 08") {
		return fail("vpmovzxwq xmm17 {k5} {z}, [rax]")
	}
	if !emitCase("vpmuldq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 28 08") {
		return fail("vpmuldq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpmulhrsw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 0b 08") {
		return fail("vpmulhrsw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmulhuw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e4 08") {
		return fail("vpmulhuw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmulhw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e5 08") {
		return fail("vpmulhw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmulld", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 40 08") {
		return fail("vpmulld xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpmullw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 d5 08") {
		return fail("vpmullw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpmuludq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e1 ed 10 f4 08") {
		return fail("vpmuludq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpsadbw", 3, Xmm(17), Xmm(18), x64.Mem(x64.RAX, 64, 0), none,
			"62 e1 6d 00 f6 48 04") {
		return fail("vpsadbw xmm17, xmm18, [rax + 64]")
	}
	if !emitCase("vpshufb", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e2 6d 85 00 08") {
		return fail("vpshufb xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpshufd", 3, Xmm(17), bcstOf(0, x64.SZ32, 4), x64.Imm(1), none,
			"62 e1 7d 18 70 08 01") {
		return fail("vpshufd xmm17, dword ptr [rax]{1to4}, 1")
	}
	if !emitCase("vpshufhw", 3, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none,
			"62 e1 7e 8d 70 08 01") {
		return fail("vpshufhw xmm17 {k5} {z}, [rax], 1")
	}
	if !emitCase("vpshuflw", 3, maskOf(Xmm(17), 5, true), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), none,
			"62 e1 7f 8d 70 08 01") {
		return fail("vpshuflw xmm17 {k5} {z}, [rax], 1")
	}
	if !emitCase("vpslld", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 f2 08") {
		return fail("vpslld xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpslldq", 3, Xmm(17), x64.Mem(x64.RAX, 64, 0), x64.Imm(1), none,
			"62 f1 75 00 73 78 04 01") {
		return fail("vpslldq xmm17, [rax + 64], 1")
	}
	if !emitCase("vpsllq", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 ed 85 f3 08") {
		return fail("vpsllq xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsllvd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 47 08") {
		return fail("vpsllvd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpsllvq", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ64, 2), none, "62 e2 ed 10 47 08") {
		return fail("vpsllvq xmm17, xmm18, qword ptr [rax]{1to2}")
	}
	if !emitCase("vpsllw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 f1 08") {
		return fail("vpsllw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsrad", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e2 08") {
		return fail("vpsrad xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsravd", 3, Xmm(17), Xmm(18), bcstOf(0, x64.SZ32, 4), none, "62 e2 6d 10 46 08") {
		return fail("vpsravd xmm17, xmm18, dword ptr [rax]{1to4}")
	}
	if !emitCase("vpsraw", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 e1 08") {
		return fail("vpsraw xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsrld", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 6d 85 d2 08") {
		return fail("vpsrld xmm17 {k5} {z}, xmm18, [rax]")
	}
	if !emitCase("vpsrldq", 3, Xmm(17), x64.Mem(x64.RAX, 64, 0), x64.Imm(1), none,
			"62 f1 75 00 73 58 04 01") {
		return fail("vpsrldq xmm17, [rax + 64], 1")
	}
	if !emitCase("vpsrlq", 3, maskOf(Xmm(17), 5, true), Xmm(18), x64.Mem(x64.RAX, 0, 0), none,
			"62 e1 ed 85 d3 08") {
