package "pkg/binate/asm/x64/avx"

// tableIntLogic returns AVX and AVX2's integer logic part, a form a line, each after a newline: the
// VEX forms of SSE2 .. SSE4.2's logic, compares (the string compares too), shifts by a count or an
// immediate, packs and unpacks, shuffles, vpalignr, blends and vptest; and AVX2's shifts by each
// element's own count and vpblendd.
func tableIntLogic() *[]readonly char {
	return "\n"
			"vpackssdw l0 66 0f w0 6b V128 H128 W128\n"
			"vpackssdw l1 66 0f w0 6b V256 H256 W256\n"
			"vpacksswb l0 66 0f w0 63 V128 H128 W128\n"
			"vpacksswb l1 66 0f w0 63 V256 H256 W256\n"
			"vpackusdw l0 66 38 w0 2b V128 H128 W128\n"
			"vpackusdw l1 66 38 w0 2b V256 H256 W256\n"
			"vpackuswb l0 66 0f w0 67 V128 H128 W128\n"
			"vpackuswb l1 66 0f w0 67 V256 H256 W256\n"
			"vpalignr l0 66 3a w0 0f V128 H128 W128 I\n"
			"vpalignr l1 66 3a w0 0f V256 H256 W256 I\n"
			"vpand l0 66 0f w0 db V128 H128 W128\n"
			"vpand l0 66 0f w0 db V128 U128 H128\n"
			"vpand l1 66 0f w0 db V256 H256 W256\n"
			"vpand l1 66 0f w0 db V256 U256 H256\n"
			"vpandn l0 66 0f w0 df V128 H128 W128\n"
			"vpandn l1 66 0f w0 df V256 H256 W256\n"
			"vpblendvb l0 66 3a w0 4c V128 H128 W128 S128\n"
			"vpblendvb l1 66 3a w0 4c V256 H256 W256 S256\n"
			"vpblendw l0 66 3a w0 0e V128 H128 W128 I\n"
			"vpblendw l1 66 3a w0 0e V256 H256 W256 I\n"
			"vpcmpeqb l0 66 0f w0 74 V128 H128 W128\n"
			"vpcmpeqb l0 66 0f w0 74 V128 U128 H128\n"
			"vpcmpeqb l1 66 0f w0 74 V256 H256 W256\n"
			"vpcmpeqb l1 66 0f w0 74 V256 U256 H256\n"
			"vpcmpeqd l0 66 0f w0 76 V128 H128 W128\n"
			"vpcmpeqd l0 66 0f w0 76 V128 U128 H128\n"
			"vpcmpeqd l1 66 0f w0 76 V256 H256 W256\n"
			"vpcmpeqd l1 66 0f w0 76 V256 U256 H256\n"
			"vpcmpeqq l0 66 38 w0 29 V128 H128 W128\n"
			"vpcmpeqq l1 66 38 w0 29 V256 H256 W256\n"
			"vpcmpeqw l0 66 0f w0 75 V128 H128 W128\n"
			"vpcmpeqw l0 66 0f w0 75 V128 U128 H128\n"
			"vpcmpeqw l1 66 0f w0 75 V256 H256 W256\n"
			"vpcmpeqw l1 66 0f w0 75 V256 U256 H256\n"
			"vpcmpgtb l0 66 0f w0 64 V128 H128 W128\n"
			"vpcmpgtb l1 66 0f w0 64 V256 H256 W256\n"
			"vpcmpgtd l0 66 0f w0 66 V128 H128 W128\n"
			"vpcmpgtd l1 66 0f w0 66 V256 H256 W256\n"
			"vpcmpgtq l0 66 38 w0 37 V128 H128 W128\n"
			"vpcmpgtq l1 66 38 w0 37 V256 H256 W256\n"
			"vpcmpgtw l0 66 0f w0 65 V128 H128 W128\n"
			"vpcmpgtw l1 66 0f w0 65 V256 H256 W256\n"
			"vpor l0 66 0f w0 eb V128 H128 W128\n"
			"vpor l0 66 0f w0 eb V128 U128 H128\n"
			"vpor l1 66 0f w0 eb V256 H256 W256\n"
			"vpor l1 66 0f w0 eb V256 U256 H256\n"
			"vpshufb l0 66 38 w0 00 V128 H128 W128\n"
			"vpshufb l1 66 38 w0 00 V256 H256 W256\n"
			"vpshufd l0 66 0f w0 70 V128 W128 I\n"
			"vpshufd l1 66 0f w0 70 V256 W256 I\n"
			"vpshufhw l0 f3 0f w0 70 V128 W128 I\n"
			"vpshufhw l1 f3 0f w0 70 V256 W256 I\n"
			"vpshuflw l0 f2 0f w0 70 V128 W128 I\n"
			"vpshuflw l1 f2 0f w0 70 V256 W256 I\n"
			"vpslld l0 66 0f w0 f2 V128 H128 W128\n"
			"vpslld l0 66 0f w0 72/6 H128 U128 I\n"
			"vpslld l1 66 0f w0 f2 V256 H256 W128\n"
			"vpslld l1 66 0f w0 72/6 H256 U256 I\n"
			"vpslldq l0 66 0f w0 73/7 H128 U128 I\n"
			"vpslldq l1 66 0f w0 73/7 H256 U256 I\n"
			"vpsllq l0 66 0f w0 f3 V128 H128 W128\n"
			"vpsllq l0 66 0f w0 73/6 H128 U128 I\n"
			"vpsllq l1 66 0f w0 f3 V256 H256 W128\n"
			"vpsllq l1 66 0f w0 73/6 H256 U256 I\n"
			"vpsllw l0 66 0f w0 f1 V128 H128 W128\n"
			"vpsllw l0 66 0f w0 71/6 H128 U128 I\n"
			"vpsllw l1 66 0f w0 f1 V256 H256 W128\n"
			"vpsllw l1 66 0f w0 71/6 H256 U256 I\n"
			"vpsrad l0 66 0f w0 e2 V128 H128 W128\n"
			"vpsrad l0 66 0f w0 72/4 H128 U128 I\n"
			"vpsrad l1 66 0f w0 e2 V256 H256 W128\n"
			"vpsrad l1 66 0f w0 72/4 H256 U256 I\n"
			"vpsraw l0 66 0f w0 e1 V128 H128 W128\n"
			"vpsraw l0 66 0f w0 71/4 H128 U128 I\n"
			"vpsraw l1 66 0f w0 e1 V256 H256 W128\n"
			"vpsraw l1 66 0f w0 71/4 H256 U256 I\n"
			"vpsrld l0 66 0f w0 d2 V128 H128 W128\n"
			"vpsrld l0 66 0f w0 72/2 H128 U128 I\n"
			"vpsrld l1 66 0f w0 d2 V256 H256 W128\n"
			"vpsrld l1 66 0f w0 72/2 H256 U256 I\n"
			"vpsrldq l0 66 0f w0 73/3 H128 U128 I\n"
			"vpsrldq l1 66 0f w0 73/3 H256 U256 I\n"
			"vpsrlq l0 66 0f w0 d3 V128 H128 W128\n"
			"vpsrlq l0 66 0f w0 73/2 H128 U128 I\n"
			"vpsrlq l1 66 0f w0 d3 V256 H256 W128\n"
			"vpsrlq l1 66 0f w0 73/2 H256 U256 I\n"
			"vpsrlw l0 66 0f w0 d1 V128 H128 W128\n"
			"vpsrlw l0 66 0f w0 71/2 H128 U128 I\n"
			"vpsrlw l1 66 0f w0 d1 V256 H256 W128\n"
			"vpsrlw l1 66 0f w0 71/2 H256 U256 I\n"
			"vptest l0 66 38 w0 17 V128 W128\n"
			"vptest l1 66 38 w0 17 V256 W256\n"
			"vpunpckhbw l0 66 0f w0 68 V128 H128 W128\n"
			"vpunpckhbw l1 66 0f w0 68 V256 H256 W256\n"
			"vpunpckhdq l0 66 0f w0 6a V128 H128 W128\n"
			"vpunpckhdq l1 66 0f w0 6a V256 H256 W256\n"
			"vpunpckhqdq l0 66 0f w0 6d V128 H128 W128\n"
			"vpunpckhqdq l1 66 0f w0 6d V256 H256 W256\n"
			"vpunpckhwd l0 66 0f w0 69 V128 H128 W128\n"
			"vpunpckhwd l1 66 0f w0 69 V256 H256 W256\n"
			"vpunpcklbw l0 66 0f w0 60 V128 H128 W128\n"
			"vpunpcklbw l1 66 0f w0 60 V256 H256 W256\n"
			"vpunpckldq l0 66 0f w0 62 V128 H128 W128\n"
			"vpunpckldq l1 66 0f w0 62 V256 H256 W256\n"
			"vpunpcklqdq l0 66 0f w0 6c V128 H128 W128\n"
			"vpunpcklqdq l1 66 0f w0 6c V256 H256 W256\n"
			"vpunpcklwd l0 66 0f w0 61 V128 H128 W128\n"
			"vpunpcklwd l1 66 0f w0 61 V256 H256 W256\n"
			"vpxor l0 66 0f w0 ef V128 H128 W128\n"
			"vpxor l0 66 0f w0 ef V128 U128 H128\n"
			"vpxor l1 66 0f w0 ef V256 H256 W256\n"
			"vpxor l1 66 0f w0 ef V256 U256 H256\n"
			"vpcmpestri l0 66 3a w0 61 V128 W128 I\n"
			"vpcmpestrm l0 66 3a w0 60 V128 W128 I\n"
			"vpcmpistri l0 66 3a w0 63 V128 W128 I\n"
			"vpcmpistrm l0 66 3a w0 62 V128 W128 I\n"
			"vpblendd l0 66 3a w0 02 V128 H128 W128 I\n"
			"vpblendd l1 66 3a w0 02 V256 H256 W256 I\n"
			"vpsllvd l0 66 38 w0 47 V128 H128 W128\n"
			"vpsllvd l1 66 38 w0 47 V256 H256 W256\n"
			"vpsllvq l0 66 38 w1 47 V128 H128 W128\n"
			"vpsllvq l1 66 38 w1 47 V256 H256 W256\n"
			"vpsravd l0 66 38 w0 46 V128 H128 W128\n"
			"vpsravd l1 66 38 w0 46 V256 H256 W256\n"
			"vpsrlvd l0 66 38 w0 45 V128 H128 W128\n"
			"vpsrlvd l1 66 38 w0 45 V256 H256 W256\n"
			"vpsrlvq l0 66 38 w1 45 V128 H128 W128\n"
			"vpsrlvq l1 66 38 w1 45 V256 H256 W256\n"
}
