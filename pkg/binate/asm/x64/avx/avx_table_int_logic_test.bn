package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The integer logic part of the table (avx_table_int_logic.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10.
func TestTableIntLogicForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vpackssdw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 6b 0a") {
		return fail("vpackssdw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpacksswb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 63 0a") {
		return fail("vpacksswb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpackusdw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 2b 0a") {
		return fail("vpackusdw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpackuswb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 67 0a") {
		return fail("vpackuswb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpalignr", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 0f 0a 01") {
		return fail("vpalignr xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpand", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 db 0a") {
		return fail("vpand xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpandn", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 df 0a") {
		return fail("vpandn xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpblendvb", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(15),
			"c4 43 21 4c 0a f0") {
		return fail("vpblendvb xmm9, xmm11, xmmword ptr [r10], xmm15")
	}
	if !emitCase("vpblendw", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 0e 0a 01") {
		return fail("vpblendw xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcmpeqb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 74 0a") {
		return fail("vpcmpeqb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpeqd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 76 0a") {
		return fail("vpcmpeqd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpeqq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 29 0a") {
		return fail("vpcmpeqq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpeqw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 75 0a") {
		return fail("vpcmpeqw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpgtb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 64 0a") {
		return fail("vpcmpgtb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpgtd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 66 0a") {
		return fail("vpcmpgtd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpgtq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 37 0a") {
		return fail("vpcmpgtq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpgtw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 65 0a") {
		return fail("vpcmpgtw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpor", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 eb 0a") {
		return fail("vpor xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpshufb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 00 0a") {
		return fail("vpshufb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpshufd", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 41 79 70 0a 01") {
		return fail("vpshufd xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpshufhw", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 41 7a 70 0a 01") {
		return fail("vpshufhw xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpshuflw", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 41 7b 70 0a 01") {
		return fail("vpshuflw xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpslld", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f2 0a") {
		return fail("vpslld xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpslldq", 3, sse.Xmm(9), sse.Xmm(11), x64.Imm(1), none, "c4 c1 31 73 fb 01") {
		return fail("vpslldq xmm9, xmm11, 1")
	}
	if !emitCase("vpsllq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f3 0a") {
		return fail("vpsllq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsllw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f1 0a") {
		return fail("vpsllw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrad", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e2 0a") {
		return fail("vpsrad xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsraw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e1 0a") {
		return fail("vpsraw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrld", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d2 0a") {
		return fail("vpsrld xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrldq", 3, sse.Xmm(9), sse.Xmm(11), x64.Imm(1), none, "c4 c1 31 73 db 01") {
		return fail("vpsrldq xmm9, xmm11, 1")
	}
	if !emitCase("vpsrlq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d3 0a") {
		return fail("vpsrlq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrlw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d1 0a") {
		return fail("vpsrlw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vptest", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 17 0a") {
		return fail("vptest xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpunpckhbw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 68 0a") {
		return fail("vpunpckhbw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpckhdq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 6a 0a") {
		return fail("vpunpckhdq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpckhqdq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 6d 0a") {
		return fail("vpunpckhqdq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpckhwd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 69 0a") {
		return fail("vpunpckhwd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpcklbw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 60 0a") {
		return fail("vpunpcklbw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpckldq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 62 0a") {
		return fail("vpunpckldq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpcklqdq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 6c 0a") {
		return fail("vpunpcklqdq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpunpcklwd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 61 0a") {
		return fail("vpunpcklwd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpxor", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 ef 0a") {
		return fail("vpxor xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpcmpestri", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 43 79 61 0a 01") {
		return fail("vpcmpestri xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcmpestrm", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 43 79 60 0a 01") {
		return fail("vpcmpestrm xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcmpistri", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 43 79 63 0a 01") {
		return fail("vpcmpistri xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpcmpistrm", 3, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1), none,
			"c4 43 79 62 0a 01") {
		return fail("vpcmpistrm xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("vpblendd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 02 0a 01") {
		return fail("vpblendd xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpsllvd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 47 0a") {
		return fail("vpsllvd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsllvq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 47 0a") {
		return fail("vpsllvq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsravd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 46 0a") {
		return fail("vpsravd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrlvd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 45 0a") {
		return fail("vpsrlvd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsrlvq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 45 0a") {
		return fail("vpsrlvq xmm9, xmm11, xmmword ptr [r10]")
	}
	return ""
}
