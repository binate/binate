			"vmovq l0 66 0f w1 6e V128 Y\n"
			"vmovq l0 66 0f w1 7e Y V128\n"
			"vmovq l0 66 0f w0 d6 M64 V128\n"
			"vmovq l0 66 0f w0 d6 U128 V128\n"
			"vmovq e0 f3 0f w1 7e - V128 W64\n"
			"vmovq e0 66 0f w1 6e - V128 Y\n"
			"vmovq e0 66 0f w1 7e - Y V128\n"
			"vmovq e0 66 0f w1 d6 - M64 V128\n"
			"vpinsrb l0 66 3a w0 20 V128 H128 J8 I\n"
			"vpinsrb e0 66 3a w0 20 - V128 H128 J8 I\n"
			"vpinsrd l0 66 3a w0 22 V128 H128 K32 I\n"
			"vpinsrd e0 66 3a w0 22 - V128 H128 K32 I\n"
			"vpinsrq l0 66 3a w1 22 V128 H128 L64 I\n"
			"vpinsrq e0 66 3a w1 22 - V128 H128 L64 I\n"
			"vpinsrw l0 66 0f w0 c4 V128 H128 J16 I\n"
			"vpinsrw e0 66 0f w0 c4 - V128 H128 J16 I\n"
			"vpextrb l0 66 3a w0 14 J8 V128 I\n"
			"vpextrb e0 66 3a w0 14 - J8 V128 I\n"
			"vpextrw l0 66 0f w0 c5 R U128 I\n"
			"vpextrw l0 66 3a w0 15 M16 V128 I\n"
			"vpextrw e0 66 0f w0 c5 - R U128 I\n"
			"vpextrw e0 66 3a w0 15 - M16 V128 I\n"
			"vpextrd l0 66 3a w0 16 K32 V128 I\n"
			"vpextrd e0 66 3a w0 16 - K32 V128 I\n"
			"vpextrq l0 66 3a w1 16 L64 V128 I\n"
			"vpextrq e0 66 3a w1 16 - L64 V128 I\n"
			"vbroadcasti128 l1 66 38 w0 5a V256 M128\n"
			"vpbroadcastb l0 66 38 w0 78 V128 W8\n"
			"vpbroadcastb l1 66 38 w0 78 V256 W8\n"
			"vpbroadcastb e0 66 38 w0 78 kz V128 W8\n"
			"vpbroadcastb e0 66 38 w0 7a kz V128 Y32\n"
			"vpbroadcastb e1 66 38 w0 78 kz V256 W8\n"
			"vpbroadcastb e1 66 38 w0 7a kz V256 Y32\n"
			"vpbroadcastb e2 66 38 w0 78 kz V512 W8\n"
			"vpbroadcastb e2 66 38 w0 7a kz V512 Y32\n"
			"vpbroadcastw l0 66 38 w0 79 V128 W16\n"
