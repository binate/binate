package "pkg/binate/asm/x64/avx"

// tableIntMove returns AVX and AVX2's integer moves part, a form a line, each after a newline: the
// VEX forms of SSE2 .. SSE4.1's moves (vmovdqa, vmovdqu, vmovd, vmovq, the non-temporal ones,
// vlddqu, vmaskmovdqu and the .s forms), element inserts and extracts, sign and zero extensions and
// vpmovmskb; and AVX2's broadcasts, 128-bit lane inserts, extracts and permutes, permutes across
// the lanes and masked moves.
func tableIntMove() *[]readonly char {
	return "\n"
			"vlddqu l0 f2 0f w0 f0 V128 M128\n"
			"vlddqu l1 f2 0f w0 f0 V256 M256\n"
			"vmovdqa l0 66 0f w0 6f V128 W128\n"
			"vmovdqa l1 66 0f w0 6f V256 W256\n"
			"vmovdqa l0 66 0f w0 7f M128 V128\n"
			"vmovdqa l0 66 0f w0 7f U128 V128\n"
			"vmovdqa l1 66 0f w0 7f M256 V256\n"
			"vmovdqa l1 66 0f w0 7f U256 V256\n"
			"vmovdqu l0 f3 0f w0 6f V128 W128\n"
			"vmovdqu l1 f3 0f w0 6f V256 W256\n"
			"vmovdqu l0 f3 0f w0 7f M128 V128\n"
			"vmovdqu l0 f3 0f w0 7f U128 V128\n"
			"vmovdqu l1 f3 0f w0 7f M256 V256\n"
			"vmovdqu l1 f3 0f w0 7f U256 V256\n"
			"vmovntdq l0 66 0f w0 e7 M128 V128\n"
			"vmovntdq l1 66 0f w0 e7 M256 V256\n"
			"vmovntdq e0 66 0f w0 e7 - M128 V128\n"
			"vmovntdq e1 66 0f w0 e7 - M256 V256\n"
			"vmovntdq e2 66 0f w0 e7 - M512 V512\n"
			"vmovntdqa l0 66 38 w0 2a V128 M128\n"
			"vmovntdqa l1 66 38 w0 2a V256 M256\n"
			"vmovntdqa e0 66 38 w0 2a - V128 M128\n"
			"vmovntdqa e1 66 38 w0 2a - V256 M256\n"
			"vmovntdqa e2 66 38 w0 2a - V512 M512\n"
			"vpmovmskb l0 66 0f w0 d7 R U128\n"
			"vpmovmskb l1 66 0f w0 d7 R U256\n"
			"vpmovsxbd l0 66 38 w0 21 V128 W32\n"
			"vpmovsxbd l1 66 38 w0 21 V256 W64\n"
			"vpmovsxbd e0 66 38 w0 21 kz V128 W32\n"
			"vpmovsxbd e1 66 38 w0 21 kz V256 W64\n"
			"vpmovsxbd e2 66 38 w0 21 kz V512 W128\n"
