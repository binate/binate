			"vpmovsxbq e0 66 38 w0 22 kz V128 W16\n"
			"vpmovsxbq e1 66 38 w0 22 kz V256 W32\n"
			"vpmovsxbq e2 66 38 w0 22 kz V512 W64\n"
			"vpmovsxbw l0 66 38 w0 20 V128 W64\n"
			"vpmovsxbw l1 66 38 w0 20 V256 W128\n"
			"vpmovsxbw e0 66 38 w0 20 kz V128 W64\n"
			"vpmovsxbw e1 66 38 w0 20 kz V256 W128\n"
			"vpmovsxbw e2 66 38 w0 20 kz V512 W256\n"
			"vpmovsxdq l0 66 38 w0 25 V128 W64\n"
