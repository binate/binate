package "pkg/binate/asm/x64/avx"

// tableIntMove returns AVX and AVX2's integer moves part, a form a line, each after a newline: the
// VEX forms of SSE2 .. SSE4.1's moves (vmovdqa, vmovdqu, vmovd, vmovq, the non-temporal ones,
// vlddqu, vmaskmovdqu and the .s forms), element inserts and extracts, sign and zero extensions and
// vpmovmskb; and AVX2's broadcasts, 128-bit lane inserts, extracts and permutes, permutes across
// the lanes and masked moves.
func tableIntMove() *[]readonly char {
	return "\n"
			"vlddqu l0 f2 0f w0 f0 V128 M128\n"
			"vlddqu l1 f2 0f w0 f0 V256 M256\n"
			"vmovdqa l0 66 0f w0 6f V128 W128\n"
			"vmovdqa l1 66 0f w0 6f V256 W256\n"
			"vmovdqa l0 66 0f w0 7f M128 V128\n"
			"vmovdqa l0 66 0f w0 7f U128 V128\n"
			"vmovdqa l1 66 0f w0 7f M256 V256\n"
			"vmovdqa l1 66 0f w0 7f U256 V256\n"
			"vmovdqu l0 f3 0f w0 6f V128 W128\n"
			"vmovdqu l1 f3 0f w0 6f V256 W256\n"
			"vmovdqu l0 f3 0f w0 7f M128 V128\n"
			"vmovdqu l0 f3 0f w0 7f U128 V128\n"
			"vmovdqu l1 f3 0f w0 7f M256 V256\n"
			"vmovdqu l1 f3 0f w0 7f U256 V256\n"
			"vmovntdq l0 66 0f w0 e7 M128 V128\n"
			"vmovntdq l1 66 0f w0 e7 M256 V256\n"
			"vmovntdqa l0 66 38 w0 2a V128 M128\n"
			"vmovntdqa l1 66 38 w0 2a V256 M256\n"
			"vpmovmskb l0 66 0f w0 d7 R U128\n"
			"vpmovmskb l1 66 0f w0 d7 R U256\n"
			"vpmovsxbd l0 66 38 w0 21 V128 W32\n"
			"vpmovsxbd l1 66 38 w0 21 V256 W64\n"
			"vpmovsxbq l0 66 38 w0 22 V128 W16\n"
			"vpmovsxbq l1 66 38 w0 22 V256 W32\n"
			"vpmovsxbw l0 66 38 w0 20 V128 W64\n"
			"vpmovsxbw l1 66 38 w0 20 V256 W128\n"
			"vpmovsxdq l0 66 38 w0 25 V128 W64\n"
			"vpmovsxdq l1 66 38 w0 25 V256 W128\n"
			"vpmovsxwd l0 66 38 w0 23 V128 W64\n"
			"vpmovsxwd l1 66 38 w0 23 V256 W128\n"
			"vpmovsxwq l0 66 38 w0 24 V128 W32\n"
			"vpmovsxwq l1 66 38 w0 24 V256 W64\n"
			"vpmovzxbd l0 66 38 w0 31 V128 W32\n"
			"vpmovzxbd l1 66 38 w0 31 V256 W64\n"
			"vpmovzxbq l0 66 38 w0 32 V128 W16\n"
			"vpmovzxbq l1 66 38 w0 32 V256 W32\n"
			"vpmovzxbw l0 66 38 w0 30 V128 W64\n"
			"vpmovzxbw l1 66 38 w0 30 V256 W128\n"
			"vpmovzxdq l0 66 38 w0 35 V128 W64\n"
			"vpmovzxdq l1 66 38 w0 35 V256 W128\n"
			"vpmovzxwd l0 66 38 w0 33 V128 W64\n"
			"vpmovzxwd l1 66 38 w0 33 V256 W128\n"
			"vpmovzxwq l0 66 38 w0 34 V128 W32\n"
			"vpmovzxwq l1 66 38 w0 34 V256 W64\n"
			"vmaskmovdqu l0 66 0f w0 f7 V128 U128\n"
			"vmovd l0 66 0f w0 6e V128 K32\n"
			"vmovd l0 66 0f w1 6e V128 Y\n"
			"vmovd l0 66 0f w0 7e K32 V128\n"
			"vmovd l0 66 0f w1 7e Y V128\n"
			"vmovq l0 f3 0f w0 7e V128 W64\n"
			"vmovq l0 66 0f w1 6e V128 Y\n"
			"vmovq l0 66 0f w1 7e Y V128\n"
			"vmovq l0 66 0f w0 d6 M64 V128\n"
			"vmovq l0 66 0f w0 d6 U128 V128\n"
			"vpinsrb l0 66 3a w0 20 V128 H128 J8 I\n"
			"vpinsrd l0 66 3a w0 22 V128 H128 K32 I\n"
			"vpinsrq l0 66 3a w1 22 V128 H128 L64 I\n"
			"vpinsrw l0 66 0f w0 c4 V128 H128 J16 I\n"
			"vpextrb l0 66 3a w0 14 J8 V128 I\n"
			"vpextrw l0 66 0f w0 c5 R U128 I\n"
			"vpextrw l0 66 3a w0 15 M16 V128 I\n"
			"vpextrd l0 66 3a w0 16 K32 V128 I\n"
			"vpextrq l0 66 3a w1 16 L64 V128 I\n"
			"vbroadcasti128 l1 66 38 w0 5a V256 M128\n"
			"vpbroadcastb l0 66 38 w0 78 V128 W8\n"
			"vpbroadcastb l1 66 38 w0 78 V256 W8\n"
			"vpbroadcastw l0 66 38 w0 79 V128 W16\n"
			"vpbroadcastw l1 66 38 w0 79 V256 W16\n"
			"vpbroadcastd l0 66 38 w0 58 V128 W32\n"
			"vpbroadcastd l1 66 38 w0 58 V256 W32\n"
			"vpbroadcastq l0 66 38 w0 59 V128 W64\n"
			"vpbroadcastq l1 66 38 w0 59 V256 W64\n"
			"vinserti128 l1 66 3a w0 38 V256 H256 W128 I\n"
			"vextracti128 l1 66 3a w0 39 W128 V256 I\n"
			"vperm2i128 l1 66 3a w0 46 V256 H256 W256 I\n"
			"vpermd l1 66 38 w0 36 V256 H256 W256\n"
			"vpermps l1 66 38 w0 16 V256 H256 W256\n"
			"vpermq l1 66 3a w1 00 V256 W256 I\n"
			"vpermpd l1 66 3a w1 01 V256 W256 I\n"
			"vpmaskmovd l0 66 38 w0 8c V128 H128 M128\n"
			"vpmaskmovd l1 66 38 w0 8c V256 H256 M256\n"
			"vpmaskmovd l0 66 38 w0 8e M128 H128 V128\n"
			"vpmaskmovd l1 66 38 w0 8e M256 H256 V256\n"
			"vpmaskmovq l0 66 38 w1 8c V128 H128 M128\n"
			"vpmaskmovq l1 66 38 w1 8c V256 H256 M256\n"
			"vpmaskmovq l0 66 38 w1 8e M128 H128 V128\n"
			"vpmaskmovq l1 66 38 w1 8e M256 H256 V256\n"
			"vmovdqa.s l0 66 0f w0 7f U128 V128\n"
			"vmovdqa.s l1 66 0f w0 7f U256 V256\n"
			"vmovdqu.s l0 f3 0f w0 7f U128 V128\n"
			"vmovdqu.s l1 f3 0f w0 7f U256 V256\n"
			"vmovq.s l0 66 0f w0 d6 U128 V128\n"
}
