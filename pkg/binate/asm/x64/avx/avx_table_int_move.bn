			"vpbroadcastq e2 66 38 w1 7c kz V512 Y\n"
			"vinserti128 l1 66 3a w0 38 V256 H256 W128 I\n"
			"vextracti128 l1 66 3a w0 39 W128 V256 I\n"
			"vperm2i128 l1 66 3a w0 46 V256 H256 W256 I\n"
			"vpermd l1 66 38 w0 36 V256 H256 W256\n"
			"vpermd e1 66 38 w0 36 kzb32 V256 H256 W256\n"
			"vpermd e2 66 38 w0 36 kzb32 V512 H512 W512\n"
			"vpermps l1 66 38 w0 16 V256 H256 W256\n"
			"vpermps e1 66 38 w0 16 kzb32 V256 H256 W256\n"
			"vpermps e2 66 38 w0 16 kzb32 V512 H512 W512\n"
			"vpermq l1 66 3a w1 00 V256 W256 I\n"
			"vpermq e1 66 38 w1 36 kzb64 V256 H256 W256\n"
			"vpermq e1 66 3a w1 00 kzb64 V256 W256 I\n"
			"vpermq e2 66 38 w1 36 kzb64 V512 H512 W512\n"
			"vpermq e2 66 3a w1 00 kzb64 V512 W512 I\n"
			"vpermpd l1 66 3a w1 01 V256 W256 I\n"
			"vpermpd e1 66 38 w1 16 kzb64 V256 H256 W256\n"
			"vpermpd e1 66 3a w1 01 kzb64 V256 W256 I\n"
			"vpermpd e2 66 38 w1 16 kzb64 V512 H512 W512\n"
			"vpermpd e2 66 3a w1 01 kzb64 V512 W512 I\n"
			"vpmaskmovd l0 66 38 w0 8c V128 H128 M128\n"
