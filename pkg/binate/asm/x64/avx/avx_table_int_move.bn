			"vpmovsxwd e0 66 38 w0 23 kz V128 W64\n"
			"vpmovsxwd e1 66 38 w0 23 kz V256 W128\n"
			"vpmovsxwd e2 66 38 w0 23 kz V512 W256\n"
			"vpmovsxwq l0 66 38 w0 24 V128 W32\n"
			"vpmovsxwq l1 66 38 w0 24 V256 W64\n"
			"vpmovsxwq e0 66 38 w0 24 kz V128 W32\n"
			"vpmovsxwq e1 66 38 w0 24 kz V256 W64\n"
			"vpmovsxwq e2 66 38 w0 24 kz V512 W128\n"
			"vpmovzxbd l0 66 38 w0 31 V128 W32\n"
