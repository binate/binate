			"vpmovzxbw e0 66 38 w0 30 kz V128 W64\n"
			"vpmovzxbw e1 66 38 w0 30 kz V256 W128\n"
			"vpmovzxbw e2 66 38 w0 30 kz V512 W256\n"
			"vpmovzxdq l0 66 38 w0 35 V128 W64\n"
			"vpmovzxdq l1 66 38 w0 35 V256 W128\n"
