package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The integer moves part of the table (avx_table_int_move.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10.
func TestTableIntMoveForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vlddqu", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 41 7b f0 0a") {
		return fail("vlddqu xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vmovdqa", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 41 79 6f 0a") {
		return fail("vmovdqa xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vmovdqu", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 41 7a 6f 0a") {
		return fail("vmovdqu xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vmovntdq", 2, x64.Mem(x64.R10, 0, x64.SZ128), sse.Xmm(11), none, none,
			"c4 41 79 e7 1a") {
		return fail("vmovntdq xmmword ptr [r10], xmm11")
	}
	if !emitCase("vmovntdqa", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 2a 0a") {
		return fail("vmovntdqa xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpmovmskb", 2, x64.Reg(x64.R9, x64.SZ32), sse.Xmm(11), none, none,
			"c4 41 79 d7 cb") {
		return fail("vpmovmskb r9d, xmm11")
	}
	if !emitCase("vpmovsxbd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"c4 42 79 21 0a") {
		return fail("vpmovsxbd xmm9, dword ptr [r10]")
	}
	if !emitCase("vpmovsxbq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ16), none, none,
			"c4 42 79 22 0a") {
		return fail("vpmovsxbq xmm9, word ptr [r10]")
	}
	if !emitCase("vpmovsxbw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 20 0a") {
		return fail("vpmovsxbw xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovsxdq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 25 0a") {
		return fail("vpmovsxdq xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovsxwd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 23 0a") {
		return fail("vpmovsxwd xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovsxwq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"c4 42 79 24 0a") {
		return fail("vpmovsxwq xmm9, dword ptr [r10]")
	}
	if !emitCase("vpmovzxbd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"c4 42 79 31 0a") {
		return fail("vpmovzxbd xmm9, dword ptr [r10]")
	}
	if !emitCase("vpmovzxbq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ16), none, none,
			"c4 42 79 32 0a") {
		return fail("vpmovzxbq xmm9, word ptr [r10]")
	}
	if !emitCase("vpmovzxbw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 30 0a") {
		return fail("vpmovzxbw xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovzxdq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 35 0a") {
		return fail("vpmovzxdq xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovzxwd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 33 0a") {
		return fail("vpmovzxwd xmm9, qword ptr [r10]")
	}
	if !emitCase("vpmovzxwq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"c4 42 79 34 0a") {
		return fail("vpmovzxwq xmm9, dword ptr [r10]")
	}
	if !emitCase("vmaskmovdqu", 2, sse.Xmm(9), sse.Xmm(11), none, none, "c4 41 79 f7 cb") {
		return fail("vmaskmovdqu xmm9, xmm11")
	}
	if !emitCase("vmovd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none, "c4 41 79 6e 0a") {
		return fail("vmovd xmm9, dword ptr [r10]")
	}
	if !emitCase("vmovq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none, "c4 41 7a 7e 0a") {
		return fail("vmovq xmm9, qword ptr [r10]")
	}
	if !emitCase("vpinsrb", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ8), x64.Imm(1),
			"c4 43 21 20 0a 01") {
		return fail("vpinsrb xmm9, xmm11, byte ptr [r10], 1")
	}
	if !emitCase("vpinsrd", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ32), x64.Imm(1),
			"c4 43 21 22 0a 01") {
		return fail("vpinsrd xmm9, xmm11, dword ptr [r10], 1")
	}
	if !emitCase("vpinsrq", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ64), x64.Imm(1),
			"c4 43 a1 22 0a 01") {
		return fail("vpinsrq xmm9, xmm11, qword ptr [r10], 1")
	}
	if !emitCase("vpinsrw", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ16), x64.Imm(1),
			"c4 41 21 c4 0a 01") {
		return fail("vpinsrw xmm9, xmm11, word ptr [r10], 1")
	}
	if !emitCase("vpextrb", 3, x64.Mem(x64.R10, 0, x64.SZ8), sse.Xmm(11), x64.Imm(1), none,
			"c4 43 79 14 1a 01") {
		return fail("vpextrb byte ptr [r10], xmm11, 1")
	}
	if !emitCase("vpextrw", 3, x64.Reg(x64.R9, x64.SZ32), sse.Xmm(11), x64.Imm(1), none,
			"c4 41 79 c5 cb 01") {
		return fail("vpextrw r9d, xmm11, 1")
	}
	if !emitCase("vpextrd", 3, x64.Mem(x64.R10, 0, x64.SZ32), sse.Xmm(11), x64.Imm(1), none,
			"c4 43 79 16 1a 01") {
		return fail("vpextrd dword ptr [r10], xmm11, 1")
	}
	if !emitCase("vpextrq", 3, x64.Mem(x64.R10, 0, x64.SZ64), sse.Xmm(11), x64.Imm(1), none,
			"c4 43 f9 16 1a 01") {
		return fail("vpextrq qword ptr [r10], xmm11, 1")
	}
	if !emitCase("vbroadcasti128", 2, Ymm(10), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 7d 5a 12") {
		return fail("vbroadcasti128 ymm10, xmmword ptr [r10]")
	}
	if !emitCase("vpbroadcastb", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ8), none, none,
			"c4 42 79 78 0a") {
		return fail("vpbroadcastb xmm9, byte ptr [r10]")
	}
	if !emitCase("vpbroadcastw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ16), none, none,
			"c4 42 79 79 0a") {
		return fail("vpbroadcastw xmm9, word ptr [r10]")
	}
	if !emitCase("vpbroadcastd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ32), none, none,
			"c4 42 79 58 0a") {
		return fail("vpbroadcastd xmm9, dword ptr [r10]")
	}
	if !emitCase("vpbroadcastq", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ64), none, none,
			"c4 42 79 59 0a") {
		return fail("vpbroadcastq xmm9, qword ptr [r10]")
	}
	if !emitCase("vinserti128", 4, Ymm(10), Ymm(12), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 1d 38 12 01") {
		return fail("vinserti128 ymm10, ymm12, xmmword ptr [r10], 1")
	}
	if !emitCase("vextracti128", 3, x64.Mem(x64.R10, 0, x64.SZ128), Ymm(12), x64.Imm(1), none,
			"c4 43 7d 39 22 01") {
		return fail("vextracti128 xmmword ptr [r10], ymm12, 1")
	}
	if !emitCase("vperm2i128", 4, Ymm(10), Ymm(12), x64.Mem(x64.R10, 0, x64.SZ256), x64.Imm(1),
			"c4 43 1d 46 12 01") {
		return fail("vperm2i128 ymm10, ymm12, ymmword ptr [r10], 1")
	}
	if !emitCase("vpermd", 3, Ymm(10), Ymm(12), x64.Mem(x64.R10, 0, x64.SZ256), none,
			"c4 42 1d 36 12") {
		return fail("vpermd ymm10, ymm12, ymmword ptr [r10]")
	}
	if !emitCase("vpermps", 3, Ymm(10), Ymm(12), x64.Mem(x64.R10, 0, x64.SZ256), none,
			"c4 42 1d 16 12") {
		return fail("vpermps ymm10, ymm12, ymmword ptr [r10]")
	}
	if !emitCase("vpermq", 3, Ymm(10), x64.Mem(x64.R10, 0, x64.SZ256), x64.Imm(1), none,
			"c4 43 fd 00 12 01") {
		return fail("vpermq ymm10, ymmword ptr [r10], 1")
	}
	if !emitCase("vpermpd", 3, Ymm(10), x64.Mem(x64.R10, 0, x64.SZ256), x64.Imm(1), none,
			"c4 43 fd 01 12 01") {
		return fail("vpermpd ymm10, ymmword ptr [r10], 1")
	}
	if !emitCase("vpmaskmovd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 8c 0a") {
		return fail("vpmaskmovd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaskmovq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 a1 8c 0a") {
		return fail("vpmaskmovq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vmovdqa.s", 2, sse.Xmm(9), sse.Xmm(11), none, none, "c4 41 79 7f d9") {
		return fail("vmovdqa.s xmm9, xmm11")
	}
	if !emitCase("vmovdqu.s", 2, sse.Xmm(9), sse.Xmm(11), none, none, "c4 41 7a 7f d9") {
		return fail("vmovdqu.s xmm9, xmm11")
	}
	if !emitCase("vmovq.s", 2, sse.Xmm(9), sse.Xmm(11), none, none, "c4 41 79 d6 d9") {
		return fail("vmovq.s xmm9, xmm11")
	}
	return ""
}
