package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The integer arithmetic part of the table (avx_table_int.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each mnemonic, registers
// 8..15 in each field, memory with a base of r10.
func TestTableIntForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("vmpsadbw", 4, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), x64.Imm(1),
			"c4 43 21 42 0a 01") {
		return fail("vmpsadbw xmm9, xmm11, xmmword ptr [r10], 1")
	}
	if !emitCase("vpabsb", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 1c 0a") {
		return fail("vpabsb xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpabsd", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 1e 0a") {
		return fail("vpabsd xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpabsw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 1d 0a") {
		return fail("vpabsw xmm9, xmmword ptr [r10]")
	}
	if !emitCase("vpaddb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 fc 0a") {
		return fail("vpaddb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 fe 0a") {
		return fail("vpaddd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d4 0a") {
		return fail("vpaddq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddsb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 ec 0a") {
		return fail("vpaddsb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 ed 0a") {
		return fail("vpaddsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddusb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 dc 0a") {
		return fail("vpaddusb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddusw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 dd 0a") {
		return fail("vpaddusw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpaddw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 fd 0a") {
		return fail("vpaddw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpavgb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e0 0a") {
		return fail("vpavgb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpavgw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e3 0a") {
		return fail("vpavgw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphaddd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 02 0a") {
		return fail("vphaddd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphaddsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 03 0a") {
		return fail("vphaddsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphaddw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 01 0a") {
		return fail("vphaddw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphsubd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 06 0a") {
		return fail("vphsubd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphsubsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 07 0a") {
		return fail("vphsubsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphsubw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 05 0a") {
		return fail("vphsubw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaddubsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 04 0a") {
		return fail("vpmaddubsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaddwd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f5 0a") {
		return fail("vpmaddwd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxsb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3c 0a") {
		return fail("vpmaxsb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxsd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3d 0a") {
		return fail("vpmaxsd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 ee 0a") {
		return fail("vpmaxsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxub", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 de 0a") {
		return fail("vpmaxub xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3f 0a") {
		return fail("vpmaxud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmaxuw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3e 0a") {
		return fail("vpmaxuw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminsb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 38 0a") {
		return fail("vpminsb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminsd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 39 0a") {
		return fail("vpminsd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 ea 0a") {
		return fail("vpminsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminub", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 da 0a") {
		return fail("vpminub xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminud", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3b 0a") {
		return fail("vpminud xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpminuw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 3a 0a") {
		return fail("vpminuw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmuldq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 28 0a") {
		return fail("vpmuldq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmulhrsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 0b 0a") {
		return fail("vpmulhrsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmulhuw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e4 0a") {
		return fail("vpmulhuw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmulhw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e5 0a") {
		return fail("vpmulhw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmulld", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 40 0a") {
		return fail("vpmulld xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmullw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d5 0a") {
		return fail("vpmullw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpmuludq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f4 0a") {
		return fail("vpmuludq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsadbw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f6 0a") {
		return fail("vpsadbw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsignb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 08 0a") {
		return fail("vpsignb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsignd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 0a 0a") {
		return fail("vpsignd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsignw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 42 21 09 0a") {
		return fail("vpsignw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f8 0a") {
		return fail("vpsubb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubd", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 fa 0a") {
		return fail("vpsubd xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubq", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 fb 0a") {
		return fail("vpsubq xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubsb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e8 0a") {
		return fail("vpsubsb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubsw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 e9 0a") {
		return fail("vpsubsw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubusb", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d8 0a") {
		return fail("vpsubusb xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubusw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 d9 0a") {
		return fail("vpsubusw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vpsubw", 3, sse.Xmm(9), sse.Xmm(11), x64.Mem(x64.R10, 0, x64.SZ128), none,
			"c4 41 21 f9 0a") {
		return fail("vpsubw xmm9, xmm11, xmmword ptr [r10]")
	}
	if !emitCase("vphminposuw", 2, sse.Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 79 41 0a") {
		return fail("vphminposuw xmm9, xmmword ptr [r10]")
	}
	return ""
}
