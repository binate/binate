package "pkg/binate/asm/x64/avx"

// tableMask returns the part of AVX-512's mask instructions, a form a line, each after a newline:
// the logic, arithmetic, shifts, tests and unpacking of the mask registers k0 .. k7 at 8, 16, 32
// and 64 bits (b, w, d, q), and kmov between them, general registers and memory — all
// VEX-encoded.
func tableMask() *[]readonly char {
	return "\n"
			"kaddb l1 66 0f w0 4a k h u\n"
			"kaddd l1 66 0f w1 4a k h u\n"
			"kaddq l1 - 0f w1 4a k h u\n"
			"kaddw l1 - 0f w0 4a k h u\n"
			"kandb l1 66 0f w0 41 k h u\n"
			"kandd l1 66 0f w1 41 k h u\n"
			"kandnb l1 66 0f w0 42 k h u\n"
			"kandnd l1 66 0f w1 42 k h u\n"
			"kandnq l1 - 0f w1 42 k h u\n"
			"kandnw l1 - 0f w0 42 k h u\n"
			"kandq l1 - 0f w1 41 k h u\n"
			"kandw l1 - 0f w0 41 k h u\n"
			"kmovb l0 66 0f w0 90 k w8\n"
			"kmovb l0 66 0f w0 92 k Y32\n"
			"kmovb l0 66 0f w0 93 G32 u\n"
			"kmovb l0 66 0f w0 91 M8 k\n"
			"kmovd l0 66 0f w1 90 k w32\n"
			"kmovd l0 f2 0f w0 92 k Y32\n"
			"kmovd l0 f2 0f w0 93 G32 u\n"
			"kmovd l0 66 0f w1 91 M32 k\n"
			"kmovq l0 - 0f w1 90 k w64\n"
			"kmovq l0 f2 0f w1 92 k Y\n"
			"kmovq l0 f2 0f w1 93 G64 u\n"
			"kmovq l0 - 0f w1 91 M64 k\n"
			"kmovw l0 - 0f w0 90 k w16\n"
			"kmovw l0 - 0f w0 92 k Y32\n"
			"kmovw l0 - 0f w0 93 G32 u\n"
			"kmovw l0 - 0f w0 91 M16 k\n"
			"knotb l0 66 0f w0 44 k u\n"
			"knotd l0 66 0f w1 44 k u\n"
			"knotq l0 - 0f w1 44 k u\n"
			"knotw l0 - 0f w0 44 k u\n"
			"korb l1 66 0f w0 45 k h u\n"
			"kord l1 66 0f w1 45 k h u\n"
			"korq l1 - 0f w1 45 k h u\n"
			"kortestb l0 66 0f w0 98 k u\n"
			"kortestd l0 66 0f w1 98 k u\n"
			"kortestq l0 - 0f w1 98 k u\n"
			"kortestw l0 - 0f w0 98 k u\n"
			"korw l1 - 0f w0 45 k h u\n"
			"kshiftlb l0 66 3a w0 32 k u I\n"
			"kshiftld l0 66 3a w0 33 k u I\n"
			"kshiftlq l0 66 3a w1 33 k u I\n"
			"kshiftlw l0 66 3a w1 32 k u I\n"
			"kshiftrb l0 66 3a w0 30 k u I\n"
			"kshiftrd l0 66 3a w0 31 k u I\n"
			"kshiftrq l0 66 3a w1 31 k u I\n"
			"kshiftrw l0 66 3a w1 30 k u I\n"
			"ktestb l0 66 0f w0 99 k u\n"
			"ktestd l0 66 0f w1 99 k u\n"
			"ktestq l0 - 0f w1 99 k u\n"
			"ktestw l0 - 0f w0 99 k u\n"
			"kunpckbw l1 66 0f w0 4b k h u\n"
			"kunpckdq l1 - 0f w1 4b k h u\n"
			"kunpckwd l1 - 0f w0 4b k h u\n"
			"kxnorb l1 66 0f w0 46 k h u\n"
			"kxnord l1 66 0f w1 46 k h u\n"
			"kxnorq l1 - 0f w1 46 k h u\n"
			"kxnorw l1 - 0f w0 46 k h u\n"
			"kxorb l1 66 0f w0 47 k h u\n"
			"kxord l1 66 0f w1 47 k h u\n"
			"kxorq l1 - 0f w1 47 k h u\n"
			"kxorw l1 - 0f w0 47 k h u\n"
}
