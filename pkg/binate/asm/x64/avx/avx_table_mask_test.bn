package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The mask instructions' part of the table (avx_table_mask.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): every form, with k7, k0 and k5, r12d,
// r9 and [r13 + 8] where it takes them.

func TestTableMaskForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("kaddb", 3, K(7), K(0), K(5), none, "c5 fd 4a fd") {
		return fail("kaddb k7, k0, k5")
	}
	if !emitCase("kaddd", 3, K(7), K(0), K(5), none, "c4 e1 fd 4a fd") {
		return fail("kaddd k7, k0, k5")
	}
	if !emitCase("kaddq", 3, K(7), K(0), K(5), none, "c4 e1 fc 4a fd") {
		return fail("kaddq k7, k0, k5")
	}
	if !emitCase("kaddw", 3, K(7), K(0), K(5), none, "c5 fc 4a fd") {
		return fail("kaddw k7, k0, k5")
	}
	if !emitCase("kandb", 3, K(7), K(0), K(5), none, "c5 fd 41 fd") {
		return fail("kandb k7, k0, k5")
	}
	if !emitCase("kandd", 3, K(7), K(0), K(5), none, "c4 e1 fd 41 fd") {
		return fail("kandd k7, k0, k5")
	}
	if !emitCase("kandnb", 3, K(7), K(0), K(5), none, "c5 fd 42 fd") {
		return fail("kandnb k7, k0, k5")
	}
	if !emitCase("kandnd", 3, K(7), K(0), K(5), none, "c4 e1 fd 42 fd") {
		return fail("kandnd k7, k0, k5")
	}
	if !emitCase("kandnq", 3, K(7), K(0), K(5), none, "c4 e1 fc 42 fd") {
		return fail("kandnq k7, k0, k5")
	}
	if !emitCase("kandnw", 3, K(7), K(0), K(5), none, "c5 fc 42 fd") {
		return fail("kandnw k7, k0, k5")
	}
	if !emitCase("kandq", 3, K(7), K(0), K(5), none, "c4 e1 fc 41 fd") {
		return fail("kandq k7, k0, k5")
	}
	if !emitCase("kandw", 3, K(7), K(0), K(5), none, "c5 fc 41 fd") {
		return fail("kandw k7, k0, k5")
	}
	if !emitCase("kmovb", 2, K(7), K(0), none, none, "c5 f9 90 f8") {
		return fail("kmovb k7, k0")
	}
	if !emitCase("kmovb", 2, K(7), x64.Reg(x64.R12, x64.SZ32), none, none, "c4 c1 79 92 fc") {
		return fail("kmovb k7, r12d")
	}
	if !emitCase("kmovb", 2, K(7), x64.Mem(x64.R13, 8, 0), none, none, "c4 c1 79 90 7d 08") {
		return fail("kmovb k7, [r13 + 8]")
	}
	if !emitCase("kmovb", 2, x64.Reg(x64.R12, x64.SZ32), K(0), none, none, "c5 79 93 e0") {
		return fail("kmovb r12d, k0")
	}
	if !emitCase("kmovb", 2, x64.Mem(x64.R13, 8, 0), K(0), none, none, "c4 c1 79 91 45 08") {
		return fail("kmovb [r13 + 8], k0")
	}
	if !emitCase("kmovd", 2, K(7), K(0), none, none, "c4 e1 f9 90 f8") {
		return fail("kmovd k7, k0")
	}
	if !emitCase("kmovd", 2, K(7), x64.Reg(x64.R12, x64.SZ32), none, none, "c4 c1 7b 92 fc") {
		return fail("kmovd k7, r12d")
	}
	if !emitCase("kmovd", 2, K(7), x64.Mem(x64.R13, 8, 0), none, none, "c4 c1 f9 90 7d 08") {
		return fail("kmovd k7, [r13 + 8]")
	}
	if !emitCase("kmovd", 2, x64.Reg(x64.R12, x64.SZ32), K(0), none, none, "c5 7b 93 e0") {
		return fail("kmovd r12d, k0")
	}
	if !emitCase("kmovd", 2, x64.Mem(x64.R13, 8, 0), K(0), none, none, "c4 c1 f9 91 45 08") {
		return fail("kmovd [r13 + 8], k0")
	}
	if !emitCase("kmovq", 2, K(7), K(0), none, none, "c4 e1 f8 90 f8") {
		return fail("kmovq k7, k0")
	}
	if !emitCase("kmovq", 2, K(7), x64.Reg(x64.R9, x64.SZ64), none, none, "c4 c1 fb 92 f9") {
		return fail("kmovq k7, r9")
	}
	if !emitCase("kmovq", 2, K(7), x64.Mem(x64.R13, 8, 0), none, none, "c4 c1 f8 90 7d 08") {
		return fail("kmovq k7, [r13 + 8]")
	}
	if !emitCase("kmovq", 2, x64.Reg(x64.R9, x64.SZ64), K(0), none, none, "c4 61 fb 93 c8") {
		return fail("kmovq r9, k0")
	}
	if !emitCase("kmovq", 2, x64.Mem(x64.R13, 8, 0), K(0), none, none, "c4 c1 f8 91 45 08") {
		return fail("kmovq [r13 + 8], k0")
	}
	if !emitCase("kmovw", 2, K(7), K(0), none, none, "c5 f8 90 f8") {
		return fail("kmovw k7, k0")
	}
	if !emitCase("kmovw", 2, K(7), x64.Reg(x64.R12, x64.SZ32), none, none, "c4 c1 78 92 fc") {
		return fail("kmovw k7, r12d")
	}
	if !emitCase("kmovw", 2, K(7), x64.Mem(x64.R13, 8, 0), none, none, "c4 c1 78 90 7d 08") {
		return fail("kmovw k7, [r13 + 8]")
	}
	if !emitCase("kmovw", 2, x64.Reg(x64.R12, x64.SZ32), K(0), none, none, "c5 78 93 e0") {
		return fail("kmovw r12d, k0")
	}
	if !emitCase("kmovw", 2, x64.Mem(x64.R13, 8, 0), K(0), none, none, "c4 c1 78 91 45 08") {
		return fail("kmovw [r13 + 8], k0")
	}
	if !emitCase("knotb", 2, K(7), K(0), none, none, "c5 f9 44 f8") {
		return fail("knotb k7, k0")
	}
	if !emitCase("knotd", 2, K(7), K(0), none, none, "c4 e1 f9 44 f8") {
		return fail("knotd k7, k0")
	}
	if !emitCase("knotq", 2, K(7), K(0), none, none, "c4 e1 f8 44 f8") {
		return fail("knotq k7, k0")
	}
	if !emitCase("knotw", 2, K(7), K(0), none, none, "c5 f8 44 f8") {
		return fail("knotw k7, k0")
	}
	if !emitCase("korb", 3, K(7), K(0), K(5), none, "c5 fd 45 fd") {
		return fail("korb k7, k0, k5")
	}
	if !emitCase("kord", 3, K(7), K(0), K(5), none, "c4 e1 fd 45 fd") {
		return fail("kord k7, k0, k5")
	}
	if !emitCase("korq", 3, K(7), K(0), K(5), none, "c4 e1 fc 45 fd") {
		return fail("korq k7, k0, k5")
	}
	if !emitCase("kortestb", 2, K(7), K(0), none, none, "c5 f9 98 f8") {
		return fail("kortestb k7, k0")
	}
	if !emitCase("kortestd", 2, K(7), K(0), none, none, "c4 e1 f9 98 f8") {
		return fail("kortestd k7, k0")
	}
	if !emitCase("kortestq", 2, K(7), K(0), none, none, "c4 e1 f8 98 f8") {
		return fail("kortestq k7, k0")
	}
	if !emitCase("kortestw", 2, K(7), K(0), none, none, "c5 f8 98 f8") {
		return fail("kortestw k7, k0")
	}
	if !emitCase("korw", 3, K(7), K(0), K(5), none, "c5 fc 45 fd") {
		return fail("korw k7, k0, k5")
	}
	if !emitCase("kshiftlb", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 79 32 f8 01") {
		return fail("kshiftlb k7, k0, 1")
	}
	if !emitCase("kshiftld", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 79 33 f8 01") {
		return fail("kshiftld k7, k0, 1")
	}
	if !emitCase("kshiftlq", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 f9 33 f8 01") {
		return fail("kshiftlq k7, k0, 1")
	}
	if !emitCase("kshiftlw", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 f9 32 f8 01") {
		return fail("kshiftlw k7, k0, 1")
	}
	if !emitCase("kshiftrb", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 79 30 f8 01") {
		return fail("kshiftrb k7, k0, 1")
	}
	if !emitCase("kshiftrd", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 79 31 f8 01") {
		return fail("kshiftrd k7, k0, 1")
	}
	if !emitCase("kshiftrq", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 f9 31 f8 01") {
		return fail("kshiftrq k7, k0, 1")
	}
	if !emitCase("kshiftrw", 3, K(7), K(0), x64.Imm(1), none, "c4 e3 f9 30 f8 01") {
		return fail("kshiftrw k7, k0, 1")
	}
	if !emitCase("ktestb", 2, K(7), K(0), none, none, "c5 f9 99 f8") {
		return fail("ktestb k7, k0")
	}
	if !emitCase("ktestd", 2, K(7), K(0), none, none, "c4 e1 f9 99 f8") {
		return fail("ktestd k7, k0")
	}
	if !emitCase("ktestq", 2, K(7), K(0), none, none, "c4 e1 f8 99 f8") {
		return fail("ktestq k7, k0")
	}
	if !emitCase("ktestw", 2, K(7), K(0), none, none, "c5 f8 99 f8") {
		return fail("ktestw k7, k0")
	}
	if !emitCase("kunpckbw", 3, K(7), K(0), K(5), none, "c5 fd 4b fd") {
		return fail("kunpckbw k7, k0, k5")
	}
	if !emitCase("kunpckdq", 3, K(7), K(0), K(5), none, "c4 e1 fc 4b fd") {
		return fail("kunpckdq k7, k0, k5")
	}
	if !emitCase("kunpckwd", 3, K(7), K(0), K(5), none, "c5 fc 4b fd") {
		return fail("kunpckwd k7, k0, k5")
	}
	if !emitCase("kxnorb", 3, K(7), K(0), K(5), none, "c5 fd 46 fd") {
		return fail("kxnorb k7, k0, k5")
	}
	if !emitCase("kxnord", 3, K(7), K(0), K(5), none, "c4 e1 fd 46 fd") {
		return fail("kxnord k7, k0, k5")
	}
	if !emitCase("kxnorq", 3, K(7), K(0), K(5), none, "c4 e1 fc 46 fd") {
		return fail("kxnorq k7, k0, k5")
	}
	if !emitCase("kxnorw", 3, K(7), K(0), K(5), none, "c5 fc 46 fd") {
		return fail("kxnorw k7, k0, k5")
	}
	if !emitCase("kxorb", 3, K(7), K(0), K(5), none, "c5 fd 47 fd") {
		return fail("kxorb k7, k0, k5")
	}
	if !emitCase("kxord", 3, K(7), K(0), K(5), none, "c4 e1 fd 47 fd") {
		return fail("kxord k7, k0, k5")
	}
	if !emitCase("kxorq", 3, K(7), K(0), K(5), none, "c4 e1 fc 47 fd") {
		return fail("kxorq k7, k0, k5")
	}
	if !emitCase("kxorw", 3, K(7), K(0), K(5), none, "c5 fc 47 fd") {
		return fail("kxorw k7, k0, k5")
	}
	return ""
}

// What the mask instructions take no form of: a vector register, a write mask (no EVEX form),
// memory where a mask register stands, a 16-bit general register, a 32-bit one in kmovq, an
// immediate past 8 bits.
func TestTableMaskRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var masked x64.Operand = K(2)
	masked.Mask = 1
	var a = newAsm()
	if emitOps(a, "knotw", 2, K(1), Xmm(0), none, none) && !rejected(a) {
		return fail("knotw k1, xmm0")
	}
	a = newAsm()
	if emitOps(a, "kmovw", 2, masked, K(3), none, none) && !rejected(a) {
		return fail("kmovw k2 {k1}, k3")
	}
	a = newAsm()
	if emitOps(a, "kandw", 3, K(1), K(2), x64.Mem(x64.RAX, 0, 0), none) && !rejected(a) {
		return fail("kandw k1, k2, [rax]")
	}
	a = newAsm()
	if emitOps(a, "kmovw", 2, K(1), x64.Reg(x64.RAX, x64.SZ16), none, none) && !rejected(a) {
		return fail("kmovw k1, ax")
	}
	a = newAsm()
	if emitOps(a, "kmovq", 2, K(1), x64.Reg(x64.RAX, x64.SZ32), none, none) && !rejected(a) {
		return fail("kmovq k1, eax")
	}
	a = newAsm()
	if emitOps(a, "kmovw", 2, K(1), x64.Mem(x64.RAX, 0, x64.SZ32), none, none) && !rejected(a) {
		return fail("kmovw k1, dword ptr [rax]")
	}
	a = newAsm()
	if emitOps(a, "kshiftlw", 3, K(1), K(2), x64.Imm(300), none) && !rejected(a) {
		return fail("kshiftlw k1, k2, 300")
	}
	return ""
}
