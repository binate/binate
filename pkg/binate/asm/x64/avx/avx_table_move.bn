			"vmovss e0 f3 0f w0 10 kz V128 H128 U128\n"
			"vmovsd l0 f2 0f w0 10 V128 M64\n"
			"vmovsd l0 f2 0f w0 11 M64 V128\n"
			"vmovsd l0 f2 0f w0 10 V128 H128 U128\n"
			"vmovsd l0 f2 0f w0 11 U128 H128 V128\n"
