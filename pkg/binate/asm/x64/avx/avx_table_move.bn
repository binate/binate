package "pkg/binate/asm/x64/avx"

// tableMove returns AVX's floating-point moves part, a form a line, each after a newline: the VEX
// forms of SSE .. SSE4.1's moves, shuffles, unpacks, blends, inserts and extracts; AVX's own
// broadcasts, 128-bit lane inserts, extracts and permutes, in-lane permutes, masked moves and
// tests, vzeroupper and vzeroall, vldmxcsr and vstmxcsr; and the .s forms (a move between
// registers in its store form).
func tableMove() *[]readonly char {
	return "\n"
			"vmovaps l0 - 0f w0 28 V128 W128\n"
			"vmovaps l1 - 0f w0 28 V256 W256\n"
			"vmovaps l0 - 0f w0 29 M128 V128\n"
			"vmovaps l0 - 0f w0 29 U128 V128\n"
			"vmovaps l1 - 0f w0 29 M256 V256\n"
			"vmovaps l1 - 0f w0 29 U256 V256\n"
			"vmovapd l0 66 0f w0 28 V128 W128\n"
			"vmovapd l1 66 0f w0 28 V256 W256\n"
			"vmovapd l0 66 0f w0 29 M128 V128\n"
			"vmovapd l0 66 0f w0 29 U128 V128\n"
			"vmovapd l1 66 0f w0 29 M256 V256\n"
			"vmovapd l1 66 0f w0 29 U256 V256\n"
			"vmovups l0 - 0f w0 10 V128 W128\n"
			"vmovups l1 - 0f w0 10 V256 W256\n"
			"vmovups l0 - 0f w0 11 M128 V128\n"
			"vmovups l0 - 0f w0 11 U128 V128\n"
			"vmovups l1 - 0f w0 11 M256 V256\n"
			"vmovups l1 - 0f w0 11 U256 V256\n"
			"vmovupd l0 66 0f w0 10 V128 W128\n"
			"vmovupd l1 66 0f w0 10 V256 W256\n"
			"vmovupd l0 66 0f w0 11 M128 V128\n"
			"vmovupd l0 66 0f w0 11 U128 V128\n"
			"vmovupd l1 66 0f w0 11 M256 V256\n"
			"vmovupd l1 66 0f w0 11 U256 V256\n"
			"vmovss l0 f3 0f w0 10 V128 M32\n"
			"vmovss l0 f3 0f w0 11 M32 V128\n"
			"vmovss l0 f3 0f w0 10 V128 H128 U128\n"
			"vmovss l0 f3 0f w0 11 U128 H128 V128\n"
			"vmovsd l0 f2 0f w0 10 V128 M64\n"
			"vmovsd l0 f2 0f w0 11 M64 V128\n"
			"vmovsd l0 f2 0f w0 10 V128 H128 U128\n"
			"vmovsd l0 f2 0f w0 11 U128 H128 V128\n"
			"vmovlps l0 - 0f w0 13 M64 V128\n"
			"vmovlps l0 - 0f w0 12 V128 H128 M64\n"
			"vmovhps l0 - 0f w0 17 M64 V128\n"
			"vmovhps l0 - 0f w0 16 V128 H128 M64\n"
			"vmovlpd l0 66 0f w0 13 M64 V128\n"
			"vmovlpd l0 66 0f w0 12 V128 H128 M64\n"
			"vmovhpd l0 66 0f w0 17 M64 V128\n"
			"vmovhpd l0 66 0f w0 16 V128 H128 M64\n"
			"vmovhlps l0 - 0f w0 12 V128 H128 U128\n"
			"vmovlhps l0 - 0f w0 16 V128 H128 U128\n"
			"vmovmskps l0 - 0f w0 50 R U128\n"
			"vmovmskps l1 - 0f w0 50 R U256\n"
			"vmovmskpd l0 66 0f w0 50 R U128\n"
			"vmovmskpd l1 66 0f w0 50 R U256\n"
			"vmovntps l0 - 0f w0 2b M128 V128\n"
			"vmovntps l1 - 0f w0 2b M256 V256\n"
			"vmovntpd l0 66 0f w0 2b M128 V128\n"
			"vmovntpd l1 66 0f w0 2b M256 V256\n"
			"vshufps l0 - 0f w0 c6 V128 H128 W128 I\n"
			"vshufps l1 - 0f w0 c6 V256 H256 W256 I\n"
			"vshufpd l0 66 0f w0 c6 V128 H128 W128 I\n"
			"vshufpd l1 66 0f w0 c6 V256 H256 W256 I\n"
			"vunpcklps l0 - 0f w0 14 V128 H128 W128\n"
			"vunpcklps l1 - 0f w0 14 V256 H256 W256\n"
			"vunpckhps l0 - 0f w0 15 V128 H128 W128\n"
			"vunpckhps l1 - 0f w0 15 V256 H256 W256\n"
			"vunpcklpd l0 66 0f w0 14 V128 H128 W128\n"
			"vunpcklpd l1 66 0f w0 14 V256 H256 W256\n"
			"vunpckhpd l0 66 0f w0 15 V128 H128 W128\n"
			"vunpckhpd l1 66 0f w0 15 V256 H256 W256\n"
			"vmovddup l0 f2 0f w0 12 V128 W64\n"
			"vmovddup l1 f2 0f w0 12 V256 W256\n"
			"vmovshdup l0 f3 0f w0 16 V128 W128\n"
			"vmovshdup l1 f3 0f w0 16 V256 W256\n"
			"vmovsldup l0 f3 0f w0 12 V128 W128\n"
			"vmovsldup l1 f3 0f w0 12 V256 W256\n"
			"vblendps l0 66 3a w0 0c V128 H128 W128 I\n"
			"vblendps l1 66 3a w0 0c V256 H256 W256 I\n"
			"vblendpd l0 66 3a w0 0d V128 H128 W128 I\n"
			"vblendpd l1 66 3a w0 0d V256 H256 W256 I\n"
			"vblendvps l0 66 3a w0 4a V128 H128 W128 S128\n"
			"vblendvps l1 66 3a w0 4a V256 H256 W256 S256\n"
			"vblendvpd l0 66 3a w0 4b V128 H128 W128 S128\n"
			"vblendvpd l1 66 3a w0 4b V256 H256 W256 S256\n"
			"vinsertps l0 66 3a w0 21 V128 H128 W32 I\n"
			"vextractps l0 66 3a w0 17 J32 V128 I\n"
			"vbroadcastss l0 66 38 w0 18 V128 W32\n"
			"vbroadcastss l1 66 38 w0 18 V256 W32\n"
			"vbroadcastsd l1 66 38 w0 19 V256 W64\n"
			"vbroadcastf128 l1 66 38 w0 1a V256 M128\n"
			"vinsertf128 l1 66 3a w0 18 V256 H256 W128 I\n"
			"vextractf128 l1 66 3a w0 19 W128 V256 I\n"
			"vperm2f128 l1 66 3a w0 06 V256 H256 W256 I\n"
			"vpermilps l0 66 38 w0 0c V128 H128 W128\n"
			"vpermilps l0 66 3a w0 04 V128 W128 I\n"
			"vpermilps l1 66 38 w0 0c V256 H256 W256\n"
			"vpermilps l1 66 3a w0 04 V256 W256 I\n"
			"vpermilpd l0 66 38 w0 0d V128 H128 W128\n"
			"vpermilpd l0 66 3a w0 05 V128 W128 I\n"
			"vpermilpd l1 66 38 w0 0d V256 H256 W256\n"
			"vpermilpd l1 66 3a w0 05 V256 W256 I\n"
			"vmaskmovps l0 66 38 w0 2c V128 H128 M128\n"
			"vmaskmovps l1 66 38 w0 2c V256 H256 M256\n"
			"vmaskmovps l0 66 38 w0 2e M128 H128 V128\n"
			"vmaskmovps l1 66 38 w0 2e M256 H256 V256\n"
			"vmaskmovpd l0 66 38 w0 2d V128 H128 M128\n"
			"vmaskmovpd l1 66 38 w0 2d V256 H256 M256\n"
			"vmaskmovpd l0 66 38 w0 2f M128 H128 V128\n"
			"vmaskmovpd l1 66 38 w0 2f M256 H256 V256\n"
			"vtestps l0 66 38 w0 0e V128 W128\n"
			"vtestps l1 66 38 w0 0e V256 W256\n"
			"vtestpd l0 66 38 w0 0f V128 W128\n"
			"vtestpd l1 66 38 w0 0f V256 W256\n"
			"vzeroupper l0 - 0f w0 77\n"
			"vzeroall l1 - 0f w0 77\n"
			"vldmxcsr l0 - 0f w0 ae/2 M32\n"
			"vstmxcsr l0 - 0f w0 ae/3 M32\n"
			"vmovaps.s l0 - 0f w0 29 U128 V128\n"
			"vmovaps.s l1 - 0f w0 29 U256 V256\n"
			"vmovapd.s l0 66 0f w0 29 U128 V128\n"
			"vmovapd.s l1 66 0f w0 29 U256 V256\n"
			"vmovups.s l0 - 0f w0 11 U128 V128\n"
			"vmovups.s l1 - 0f w0 11 U256 V256\n"
			"vmovupd.s l0 66 0f w0 11 U128 V128\n"
			"vmovupd.s l1 66 0f w0 11 U256 V256\n"
			"vmovss.s l0 f3 0f w0 11 U128 H128 V128\n"
			"vmovsd.s l0 f2 0f w0 11 U128 H128 V128\n"
}
