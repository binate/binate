			"vunpcklps e0 - 0f w0 14 kzb32 V128 H128 W128\n"
			"vunpcklps e1 - 0f w0 14 kzb32 V256 H256 W256\n"
			"vunpcklps e2 - 0f w0 14 kzb32 V512 H512 W512\n"
			"vunpckhps l0 - 0f w0 15 V128 H128 W128\n"
			"vunpckhps l1 - 0f w0 15 V256 H256 W256\n"
			"vunpckhps e0 - 0f w0 15 kzb32 V128 H128 W128\n"
			"vunpckhps e1 - 0f w0 15 kzb32 V256 H256 W256\n"
			"vunpckhps e2 - 0f w0 15 kzb32 V512 H512 W512\n"
			"vunpcklpd l0 66 0f w0 14 V128 H128 W128\n"
			"vunpcklpd l1 66 0f w0 14 V256 H256 W256\n"
			"vunpcklpd e0 66 0f w1 14 kzb64 V128 H128 W128\n"
			"vunpcklpd e1 66 0f w1 14 kzb64 V256 H256 W256\n"
			"vunpcklpd e2 66 0f w1 14 kzb64 V512 H512 W512\n"
			"vunpckhpd l0 66 0f w0 15 V128 H128 W128\n"
