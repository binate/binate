package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"
import "pkg/builtins/testing"

// The moves part of the table (avx_table_move.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`), registers 8..15 in each field: loads,
// stores and the .s forms, the masks, shuffles, blends with an is4 register, inserts and extracts,
// broadcasts, permutes, masked moves, tests, vzeroupper / vzeroall and the MXCSR.
func TestTableMoveForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x9 x64.Operand = sse.Xmm(9)
	var x10 x64.Operand = sse.Xmm(10)
	var x11 x64.Operand = sse.Xmm(11)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m64 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ64)
	var m128 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ128)
	var m256 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ256)
	if !emitCase("vmovaps", 2, x64.Mem(x64.R9, 0, x64.SZ256), Ymm(10), none, none, "c4 41 7c 29 11") {
		return fail("vmovaps ymmword ptr [r9], ymm10")
	}
	if !emitCase("vmovaps.s", 2, sse.Xmm(0), sse.Xmm(1), none, none, "c5 f8 29 c8") {
		return fail("vmovaps.s")
	}
	if !emitCase("vmovups", 2, x9, m128, none, none, "c5 78 10 08") { return fail("vmovups load") }
	if !emitCase("vmovss", 2, x9, m32, none, none, "c5 7a 10 08") { return fail("vmovss load") }
	if !emitCase("vmovss", 2, m32, x9, none, none, "c5 7a 11 08") { return fail("vmovss store") }
	if !emitCase("vmovsd.s", 3, sse.Xmm(0), sse.Xmm(1), sse.Xmm(2), none, "c5 f3 11 d0") {
		return fail("vmovsd.s")
	}
	if !emitCase("vmovlps", 3, x9, x10, m64, none, "c5 28 12 08") { return fail("vmovlps") }
	if !emitCase("vmovhps", 2, x64.Mem(x64.R10, 0, x64.SZ64), x9, none, none, "c4 41 78 17 0a") {
		return fail("vmovhps store")
	}
	if !emitCase("vmovhlps", 3, x9, x10, x11, none, "c4 41 28 12 cb") { return fail("vmovhlps") }
	if !emitCase("vmovmskps", 2, x64.Reg(x64.R9, x64.SZ32), Ymm(10), none, none, "c4 41 7c 50 ca") {
		return fail("vmovmskps r9d, ymm10")
	}
	if !emitCase("vmovmskpd", 2, x64.Reg(x64.RAX, x64.SZ64), sse.Xmm(1), none, none, "c5 f9 50 c1") {
		return fail("vmovmskpd rax")
	}
	if !emitCase("vmovntpd", 2, m256, Ymm(9), none, none, "c5 7d 2b 08") { return fail("vmovntpd") }
	if !emitCase("vshufps", 4, Ymm(9), Ymm(10), Ymm(11), x64.Imm(27), "c4 41 2c c6 cb 1b") {
		return fail("vshufps")
	}
	if !emitCase("vunpcklpd", 3, x9, x10, x11, none, "c4 41 29 14 cb") { return fail("vunpcklpd") }
	if !emitCase("vmovddup", 2, Ymm(9), Ymm(10), none, none, "c4 41 7f 12 ca") {
		return fail("vmovddup ymm")
	}
	if !emitCase("vmovddup", 2, x9, m64, none, none, "c5 7b 12 08") { return fail("vmovddup qword") }
	if !emitCase("vblendvps", 4, Ymm(9), Ymm(10), Ymm(11), Ymm(12), "c4 43 2d 4a cb c0") {
		return fail("vblendvps")
	}
	if !emitCase("vblendvpd", 4, sse.Xmm(1), sse.Xmm(2), x64.Mem(x64.R9, 0, x64.SZ128), sse.Xmm(15),
			"c4 c3 69 4b 09 f0") {
		return fail("vblendvpd .., xmm15")
	}
	if !emitCase("vinsertps", 4, x9, x10, m32, x64.Imm(16), "c4 63 29 21 08 10") {
		return fail("vinsertps")
	}
	if !emitCase("vextractps", 3, x64.Reg(x64.R9, x64.SZ32), x10, x64.Imm(3), none,
			"c4 43 79 17 d1 03") {
		return fail("vextractps r9d")
	}
	if !emitCase("vextractps", 3, x64.Mem(x64.R9, 0, x64.SZ32), x10, x64.Imm(3), none,
			"c4 43 79 17 11 03") {
		return fail("vextractps dword")
	}
	if !emitCase("vbroadcastss", 2, Ymm(9), x10, none, none, "c4 42 7d 18 ca") {
		return fail("vbroadcastss")
	}
	if !emitCase("vbroadcastss", 2, x9, m32, none, none, "c4 62 79 18 08") {
		return fail("vbroadcastss m32")
	}
	if !emitCase("vbroadcastsd", 2, Ymm(9), m64, none, none, "c4 62 7d 19 08") {
		return fail("vbroadcastsd")
	}
	if !emitCase("vbroadcastf128", 2, Ymm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, none,
			"c4 42 7d 1a 0a") {
		return fail("vbroadcastf128")
	}
	if !emitCase("vinsertf128", 4, Ymm(9), Ymm(10), x11, x64.Imm(1), "c4 43 2d 18 cb 01") {
		return fail("vinsertf128")
	}
	if !emitCase("vextractf128", 3, m128, Ymm(9), x64.Imm(1), none, "c4 63 7d 19 08 01") {
		return fail("vextractf128")
	}
	if !emitCase("vperm2f128", 4, Ymm(9), Ymm(10), Ymm(11), x64.Imm(0x31), "c4 43 2d 06 cb 31") {
		return fail("vperm2f128")
	}
	if !emitCase("vpermilps", 3, Ymm(9), m256, x64.Imm(0x1b), none, "c4 63 7d 04 08 1b") {
		return fail("vpermilps imm")
	}
	if !emitCase("vpermilpd", 3, x9, x10, x11, none, "c4 42 29 0d cb") { return fail("vpermilpd") }
	if !emitCase("vmaskmovps", 3, x9, x10, m128, none, "c4 62 29 2c 08") {
		return fail("vmaskmovps load")
	}
	if !emitCase("vmaskmovpd", 3, x64.Mem(x64.R9, 0, x64.SZ256), Ymm(10), Ymm(11), none,
			"c4 42 2d 2f 19") {
		return fail("vmaskmovpd store")
	}
	if !emitCase("vtestps", 2, Ymm(9), Ymm(10), none, none, "c4 42 7d 0e ca") {
		return fail("vtestps")
	}
	if !emitCase("vzeroupper", 0, none, none, none, none, "c5 f8 77") { return fail("vzeroupper") }
	if !emitCase("vzeroall", 0, none, none, none, none, "c5 fc 77") { return fail("vzeroall") }
	if !emitCase("vldmxcsr", 1, x64.Mem(x64.R9, 0, x64.SZ32), none, none, none, "c4 c1 78 ae 11") {
		return fail("vldmxcsr")
	}
	if !emitCase("vstmxcsr", 1, x64.Mem(x64.RAX, 0, 0), none, none, none, "c5 f8 ae 18") {
		return fail("vstmxcsr")
	}
	return ""
}
