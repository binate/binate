package "pkg/binate/asm/x64/avx"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/asm/x64/sse"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The arithmetic part of the table (avx_table.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`), registers 8..15 in each field; and the
// shape of every line of every part.

func TestTableArithForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var x9 x64.Operand = sse.Xmm(9)
	var x10 x64.Operand = sse.Xmm(10)
	var x11 x64.Operand = sse.Xmm(11)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m64 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ64)
	if !emitCase("vaddps", 3, x9, x10, x11, none, "c4 41 28 58 cb") { return fail("vaddps xmm") }
	if !emitCase("vaddps", 3, Ymm(9), Ymm(10), x64.Mem(x64.R11, 0, x64.SZ256), none,
			"c4 41 2c 58 0b") {
		return fail("vaddps ymm, ymmword ptr [r11]")
	}
	if !emitCase("vaddss", 3, x9, x10, m32, none, "c5 2a 58 08") { return fail("vaddss") }
	if !emitCase("vsqrtpd", 2, Ymm(9), Ymm(10), none, none, "c4 41 7d 51 ca") {
		return fail("vsqrtpd")
	}
	if !emitCase("vsqrtsd", 3, sse.Xmm(1), sse.Xmm(2), sse.Xmm(3), none, "c5 eb 51 cb") {
		return fail("vsqrtsd")
	}
	if !emitCase("vcvtsi2ss", 3, x9, x10, x64.Reg(x64.R11, x64.SZ64), none, "c4 41 aa 2a cb") {
		return fail("vcvtsi2ss xmm9, xmm10, r11")
	}
	if !emitCase("vcvtsi2sd", 3, x9, x10, m32, none, "c5 2b 2a 08") { return fail("vcvtsi2sd dword") }
	if !emitCase("vcvtss2si", 2, x64.Reg(x64.R9, x64.SZ64), x10, none, none, "c4 41 fa 2d ca") {
		return fail("vcvtss2si r9")
	}
	if !emitCase("vcvttsd2si", 2, x64.Reg(x64.RAX, x64.SZ32), m64, none, none, "c5 fb 2c 00") {
		return fail("vcvttsd2si eax")
	}
	if !emitCase("vcvtpd2ps", 2, x9, Ymm(10), none, none, "c4 41 7d 5a ca") {
		return fail("vcvtpd2ps ymm")
	}
	if !emitCase("vcvtpd2ps", 2, x9, x64.Mem(x64.RAX, 0, x64.SZ128), none, none, "c5 79 5a 08") {
		return fail("vcvtpd2ps xmmword")
	}
	if !emitCase("vcvtpd2ps", 2, x9, x64.Mem(x64.RAX, 0, x64.SZ256), none, none, "c5 7d 5a 08") {
		return fail("vcvtpd2ps ymmword")
	}
	if !emitCase("vcvtps2pd", 2, Ymm(9), x10, none, none, "c4 41 7c 5a ca") {
		return fail("vcvtps2pd")
	}
	if !emitCase("vroundss", 4, x9, x10, x11, x64.Imm(4), "c4 43 29 0a cb 04") {
		return fail("vroundss")
	}
	if !emitCase("vdpps", 4, Ymm(9), Ymm(10), Ymm(11), x64.Imm(255), "c4 43 2d 40 cb ff") {
		return fail("vdpps")
	}
	if !emitCase("vhaddpd", 3, Ymm(9), Ymm(10), Ymm(11), none, "c4 41 2d 7c cb") {
		return fail("vhaddpd")
	}
	if !emitCase("vcmptrue_usps", 3, Ymm(0), Ymm(1), Ymm(2), none, "c5 f4 c2 c2 1f") {
		return fail("vcmptrue_usps")
	}
	if !emitCase("vcmpge_ospd", 3, sse.Xmm(0), sse.Xmm(1), sse.Xmm(2), none, "c5 f1 c2 c2 0d") {
		return fail("vcmpge_ospd")
	}
	return ""
}

// lineShape returns "" when the table line from at to its newline (end) is "<mnemonic> <l> <prefix>
// <map> <w> <opcode> <operand classes>", one space between tokens, else what is wrong (a YMM index,
// y, makes a line l1 as a 256-bit class does).
func lineShape(t *[]readonly char, at int, end int) *[]readonly char {
	var tok int = 0
	var regs int = 0
	var vs int = 0
	var rms int = 0
	var is4s int = 0
	var imms int = 0
	var wide bool = false
	var l1 bool = false
	var i int = at
	for i < end {
		var e int = optab.TokenEnd(t, i)
		var w *[]readonly char = t[i:e]
		if len(w) == 0 { return "an empty token" }
		if tok == 0 && !mnemShape(w) { return "a mnemonic not in lower case" }
		if tok == 1 && !sameText(w, "l0") && !sameText(w, "l1") { return "a length not l0 or l1" }
		if tok == 1 { l1 = w[1] == '1' }
		if tok == 2 && !sameText(w, "-") && !sameText(w, "66") && !sameText(w, "f2") &&
				!sameText(w, "f3") {
			return "a prefix not -, 66, f2 or f3"
		}
		if tok == 3 && !sameText(w, "0f") && !sameText(w, "38") && !sameText(w, "3a") {
			return "a map not 0f, 38 or 3a"
		}
		if tok == 4 && !sameText(w, "w0") && !sameText(w, "w1") { return "a W not w0 or w1" }
		if tok == 5 && !opcodeShape(w) { return "an opcode not 2 hex digits, or them and /0 .. /7" }
		if tok == 5 && len(w) == 4 { regs++ }
		if tok >= 6 && !classShape(w) { return "an operand class not of classOk's" }
		if tok >= 6 && imms > 0 && w[0] != 'I' && w[0] != 'C' { return "a class after an immediate" }
		if tok >= 6 && (optab.TokenNum(w) == 256 || w[0] == 'y') { wide = true }
		if tok >= 6 && (w[0] == 'I' || w[0] == 'C') {
			imms++
		} else if tok >= 6 && (w[0] == 'V' || optab.GpInReg(w[0])) {
			regs++
		} else if tok >= 6 && w[0] == 'H' {
			vs++
		} else if tok >= 6 && w[0] == 'S' {
			is4s++
		} else if tok >= 6 {
			rms++
		}
		tok++
		i = e + 1
	}
	if tok < 6 || tok > 11 { return "not 0 to 5 operand classes" }
	if tok > 6 && (regs != 1 || rms != 1) {
		return "not one reg-field class or extension, one r/m class"
	}
	if vs > 1 || is4s > 1 || imms > 2 { return "two H or S classes, or three immediates" }
	if tok > 6 && wide != l1 { return "l1 without a 256-bit class, or one with l0" }
	return ""
}

// sameText reports whether a and b hold the same characters.
func sameText(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// opcodeShape reports whether w is an opcode as the table writes one: 2 hex digits, or them and
// /0 .. /7.
func opcodeShape(w *[]readonly char) bool {
	if len(w) != 2 && len(w) != 4 { return false }
	if optab.HexVal(w[0]) < 0 || optab.HexVal(w[1]) < 0 { return false }
	return len(w) == 2 || (w[2] == '/' && w[3] >= '0' && w[3] <= '7')
}

// mnemShape reports whether w is a mnemonic as the table writes one: lower-case letters, digits,
// '.' and '_'.
func mnemShape(w *[]readonly char) bool {
	for i := 0; i < len(w); i++ {
		var c char = w[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_') { return false }
	}
	return len(w) > 0
}

// classShape reports whether w is an operand class classOk knows, with a size it takes.
func classShape(w *[]readonly char) bool {
	var c char = w[0]
	var n int = optab.TokenNum(w)
	var digits bool = true
	for i := 1; i < len(w); i++ {
		if w[i] < '0' || w[i] > '9' { digits = false }
	}
	if !digits { return false }
	if c == 'V' || c == 'H' || c == 'U' || c == 'S' { return n == 128 || n == 256 }
	if c == 'W' || c == 'X' || c == 'M' {
		return n == 8 || n == 16 || n == 32 || n == 64 || n == 128 || n == 256
	}
	if c == 'J' || c == 'K' || c == 'L' { return n == 8 || n == 16 || n == 32 || n == 64 }
	if c == 'x' || c == 'y' { return n == 32 || n == 64 }
	if c == 'G' || c == 'R' || c == 'E' || c == 'D' || c == 'Y' || c == 'A' || c == 'I' || c == 'C' {
		return len(w) == 1
	}
	return false
}

// lineShape finds each fault: a line with one, its words' end the index of the newline after it.
func TestLineShapeFaults() testing.TestResult {
	var bad *[]readonly char = "\n"
			"Vaddps l0 - 0f w0 58 V128 H128 W128\n"
			"vaddps l2 - 0f w0 58 V128 H128 W128\n"
			"vaddps l0 67 0f w0 58 V128 H128 W128\n"
			"vaddps l0 - 0e w0 58 V128 H128 W128\n"
			"vaddps l0 - 0f w2 58 V128 H128 W128\n"
			"vaddps l0 - 0f w0 5g V128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V128 H128 W96\n"
			"vaddps l0 - 0f w0 58 V128 I H128\n"
			"vaddps l0 - 0f w0 58 V128 V128 W128\n"
			"vaddps l0 - 0f w0 58/1 V128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V128 H128\n"
			"vaddps l0 - 0f w0 58 V128 H128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V256 H256 W256\n"
			"vaddps l1 - 0f w0 58 V128 H128 W128\n"
			"vaddps l0 - 0f w0 58 V128 H128 W128 I I I\n"
	var why *[]readonly char = " a mnemonic not| a length not| a prefix not| a map not| a W not|"
			" an opcode not| an operand class| a class after| not one reg| not one reg| not one reg|"
			" two H| l1 without| l1 without| not 0 to 5|"
	var at int = 1
	var w int = 0
	for at < len(bad) {
		var end int = optab.NextLine(bad, at) - 1
		var we int = w
		for why[we] != '|' { we++ }
		var got *[]readonly char = lineShape(bad, at, end)
		var want *[]readonly char = why[w + 1:we]
		if len(got) < len(want) || !sameText(got[0:len(want)], want) {
			return fail(buf.Concat("lineShape: ", buf.Concat(bad[at:end], buf.Concat(": ", got))))
		}
		w = we + 1
		at = end + 1
	}
	if len(lineShape("\nvzeroall l1 - 0f w0 77\n", 1, 23)) != 0 {
		return fail("lineShape: a good line")
	}
	return ""
}

// Every line of every part has the table's shape (lineShape), and a mnemonic's lines stand
// together.
func TestTableShape() testing.TestResult {
	for i := 0; len(tablePart(i)) > 0; i++ {
		var t *[]readonly char = tablePart(i)
		if t[0] != '\n' || t[len(t) - 1] != '\n' { return fail("a part not between newlines") }
		var at int = 1
		for at < len(t) {
			var end int = optab.NextLine(t, at) - 1
			var shape *[]readonly char = lineShape(t, at, end)
			if len(shape) > 0 { return fail(buf.Concat(t[at:end], buf.Concat(": ", shape))) }
			var name *[]readonly char = t[at:optab.TokenEnd(t, at)]
			var first int = optab.LineOf(t, name)
			var j int = first
			for j < at && optab.SameMnem(t, j, name) { j = optab.NextLine(t, j) }
			if j != at { return fail(buf.Concat(name, ": lines apart")) }
			for p := 0; p < i; p++ {
				if optab.LineOf(tablePart(p), name) >= 0 { return fail(buf.Concat(name, ": in two parts")) }
			}
			at = end + 1
		}
	}
	return ""
}
