// Package ctrl provides the x86-64 control instructions beside the general-purpose ones of
// pkg/binate/asm/x64 (whose jumps, calls and near returns are there): ENTER and LEAVE; the loop
// instructions LOOP, LOOPE, LOOPNE, JRCXZ and JECXZ, each a rel8 (x64.FIX_REL8); the far return
// RETF; IRET; HLT and PAUSE; the traps INT, INT3, INT1 and UD2; and SYSCALL.
package "pkg/binate/asm/x64/ctrl"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// Enter emits ENTER size, level (C8 iw ib): make a stack frame of size bytes, nested level
// deep.  Each is an immediate (x64.Imm) — size -32768..65535 and level -128..255, a negative
// value its two's complement — or a symbol (x64.ImmSym, its field relocated by
// asm.FIX_DATA_ABS16 / ABS8, as clang's `enter offset x, 0`); any other sets an assembler error
// and emits nothing (clang keeps a number's low bits).
func Enter(a @asm.Assembler, size x64.Operand, level x64.Operand)

// Leave emits LEAVE (C9): RSP <- RBP, then pop RBP.
func Leave(a @asm.Assembler)

// Loop emits LOOP rel8 (E2) to label plus addend: RCX <- RCX - 1, then jump unless RCX is 0.  The
// rel8 is an x64.FIX_REL8 fixup, measured from the instruction's end; a target past -128..127
// bytes is an error when the fixups are resolved.
func Loop(a @asm.Assembler, label *[]readonly char, addend int64)

// Loope emits LOOPE (LOOPZ) rel8 (E1): as Loop, jumping only while ZF is also set.
func Loope(a @asm.Assembler, label *[]readonly char, addend int64)

// Loopne emits LOOPNE (LOOPNZ) rel8 (E0): as Loop, jumping only while ZF is also clear.
func Loopne(a @asm.Assembler, label *[]readonly char, addend int64)

// Jrcxz emits JRCXZ rel8 (E3): jump if RCX is 0.
func Jrcxz(a @asm.Assembler, label *[]readonly char, addend int64)

// Jecxz emits JECXZ rel8 (67 E3): jump if ECX is 0.
func Jecxz(a @asm.Assembler, label *[]readonly char, addend int64)

// Retf emits the far return RETF of operand size size: x64.SZ16 66 CB, SZ32 CB (`retf`), SZ64
// REX.W CB (`retfq`); any other size sets an assembler error and emits nothing.
func Retf(a @asm.Assembler, size int)

// RetfImm emits RETF imm16 (CA iw, sized as Retf): a far return that then releases imm bytes of
// stack.  imm is an immediate, -32768..65535 (a negative value its two's-complement word), or a
// symbol (as Enter's size); any other sets an assembler error and emits nothing.
func RetfImm(a @asm.Assembler, size int, imm x64.Operand)

// Iret emits the interrupt return IRET of operand size size: x64.SZ16 66 CF (clang's `iret` in
// 64-bit mode), SZ32 CF (`iretd`), SZ64 REX.W CF (`iretq`); any other size sets an assembler
// error and emits nothing.
func Iret(a @asm.Assembler, size int)

// Hlt emits HLT (F4).
func Hlt(a @asm.Assembler)

// Pause emits PAUSE (F3 90), the spin-wait hint.
func Pause(a @asm.Assembler)

// Int1 emits INT1 (F1), the one-byte debug trap (ICEBP): GNU as's `int1`, which clang does not
// take.
func Int1(a @asm.Assembler)

// Int emits INT imm8 (CD ib), the software interrupt vec: an immediate (x64.Imm) in -128..255 (a
// negative value its two's-complement byte) or a symbol (x64.ImmSym, its byte relocated by
// asm.FIX_DATA_ABS8, as clang's `int offset x`); any other sets an assembler error and emits
// nothing.
func Int(a @asm.Assembler, vec x64.Operand)

// Int3 emits INT3 (CC), the one-byte breakpoint trap (#BP) — not `INT 3` (CD 03), which Int
// emits.
func Int3(a @asm.Assembler)

// Ud2 emits UD2 (0F 0B), the defined invalid opcode: it always traps (#UD).
func Ud2(a @asm.Assembler)

// Syscall emits SYSCALL (0F 05), the fast system call.
func Syscall(a @asm.Assembler)
