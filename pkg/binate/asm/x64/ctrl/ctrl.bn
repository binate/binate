package "pkg/binate/asm/x64/ctrl"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The control instructions' encodings: each an opcode byte, after 66 at 16 bits and REX.W at 64
// where it takes an operand size, then any immediate or rel8.

// Enter emits ENTER size, level; see ctrl.bni.
func Enter(a @asm.Assembler, size int64, level int64) {
	if size < -32768 || size > 65535 {
		x64.OperandError(a, "enter", "frame size out of range (an imm16 accepts -32768..65535)")
		return
	}
	if level < -128 || level > 255 {
		x64.OperandError(a, "enter", "nesting level out of range (an imm8 accepts -128..255)")
		return
	}
	a.EmitInstrUint8(0xC8)
	a.EmitInstrUint16(cast(uint16, size & 0xFFFF))
	a.EmitInstrUint8(cast(uint8, level & 0xFF))
}

// Leave emits LEAVE; see ctrl.bni.
func Leave(a @asm.Assembler) { a.EmitInstrUint8(0xC9) }

// Loop emits LOOP rel8; see ctrl.bni.
func Loop(a @asm.Assembler, label *[]readonly char, addend int64) {
	emitRel8(a, false, 0xE2, label, addend)
}

// Loope emits LOOPE rel8; see ctrl.bni.
func Loope(a @asm.Assembler, label *[]readonly char, addend int64) {
	emitRel8(a, false, 0xE1, label, addend)
}

// Loopne emits LOOPNE rel8; see ctrl.bni.
func Loopne(a @asm.Assembler, label *[]readonly char, addend int64) {
	emitRel8(a, false, 0xE0, label, addend)
}

// Jrcxz emits JRCXZ rel8; see ctrl.bni.
func Jrcxz(a @asm.Assembler, label *[]readonly char, addend int64) {
	emitRel8(a, false, 0xE3, label, addend)
}

// Jecxz emits JECXZ rel8; see ctrl.bni.
func Jecxz(a @asm.Assembler, label *[]readonly char, addend int64) {
	emitRel8(a, true, 0xE3, label, addend)
}

// emitRel8 emits opcode op (after the address-size prefix 67 with addr32) and a rel8 to label
// plus addend, an x64.FIX_REL8 fixup.
func emitRel8(a @asm.Assembler, addr32 bool, op int, label *[]readonly char, addend int64) {
	if addr32 { a.EmitInstrUint8(0x67) }
	a.EmitInstrUint8(cast(uint8, op))
	a.AddFixup(label, x64.FIX_REL8, addend, 1)
	a.EmitInstrUint8(0)
}

// Retf emits RETF; see ctrl.bni.
func Retf(a @asm.Assembler, size int) {
	if emitSized(a, "retf", size) { a.EmitInstrUint8(0xCB) }
}

// RetfImm emits RETF imm16; see ctrl.bni.
func RetfImm(a @asm.Assembler, size int, imm int64) {
	if imm < -32768 || imm > 65535 {
		x64.OperandError(a, "retf", "immediate out of range (an imm16 accepts -32768..65535)")
		return
	}
	if !emitSized(a, "retf", size) { return }
	a.EmitInstrUint8(0xCA)
	a.EmitInstrUint16(cast(uint16, imm & 0xFFFF))
}

// Iret emits IRET; see ctrl.bni.
func Iret(a @asm.Assembler, size int) {
	if emitSized(a, "iret", size) { a.EmitInstrUint8(0xCF) }
}

// emitSized emits the prefix operand size size takes — 66 at x64.SZ16, nothing at SZ32, REX.W at
// SZ64 — and reports whether it is one of those; else it sets the error for mnem.
func emitSized(a @asm.Assembler, mnem *[]readonly char, size int) bool {
	if size != x64.SZ16 && size != x64.SZ32 && size != x64.SZ64 {
		x64.OperandError(a, mnem, "invalid operand size")
		return false
	}
	if size == x64.SZ16 { a.EmitInstrUint8(0x66) }
	if size == x64.SZ64 { a.EmitInstrUint8(0x48) }
	return true
}

// Hlt emits HLT; see ctrl.bni.
func Hlt(a @asm.Assembler) { a.EmitInstrUint8(0xF4) }

// Pause emits PAUSE; see ctrl.bni.
func Pause(a @asm.Assembler) {
	a.EmitInstrUint8(0xF3)
	a.EmitInstrUint8(0x90)
}

// Int1 emits INT1; see ctrl.bni.
func Int1(a @asm.Assembler) { a.EmitInstrUint8(0xF1) }
