package "pkg/binate/asm/x64/ctrl"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The control instructions against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`: enter, leave, retf, iret, hlt, pause, lbl: loop lbl, ...; int1 against
// GNU as's, as clang takes none).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// ctrlCase adds name to the failures e unless a holds exactly the bytes hex spells.
func ctrlCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// Each instruction, at each operand size it has, with its immediates at their limits.
func TestControlInstructions() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Enter(a, x64.Imm(16), x64.Imm(0))
	Enter(a, x64.Imm(65535), x64.Imm(255))
	Enter(a, x64.Imm(-1), x64.Imm(0))
	Enter(a, x64.Imm(-32768), x64.Imm(-128))
	e = ctrlCase(e, a, "enter", "c8 10 00 00 c8 ff ff ff c8 ff ff 00 c8 00 80 80")
	a = newAsm()
	Leave(a)
	Hlt(a)
	Pause(a)
	Int1(a)
	e = ctrlCase(e, a, "leave, hlt, pause, int1", "c9 f4 f3 90 f1")
	a = newAsm()
	Retf(a, x64.SZ16)
	Retf(a, x64.SZ32)
	Retf(a, x64.SZ64)
	RetfImm(a, x64.SZ32, x64.Imm(8))
	RetfImm(a, x64.SZ64, x64.Imm(8))
	RetfImm(a, x64.SZ32, x64.Imm(-1))
	e = ctrlCase(e, a, "retf", "66 cb cb 48 cb ca 08 00 48 ca 08 00 ca ff ff")
	a = newAsm()
	Iret(a, x64.SZ16)
	Iret(a, x64.SZ32)
	Iret(a, x64.SZ64)
	e = ctrlCase(e, a, "iret", "66 cf cf 48 cf")
	return e
}

// symCase adds name to the failures e unless a holds exactly the bytes hex spells and its fixups
// k are kinds[k] at offs[k], each against x or y with addend addends[k].
func symCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char, kinds @[]int,
		offs @[]int, addends @[]int) @[]char {
	if !emits(a, hex) || a.Sections[0].NumFixups != len(kinds) {
		return buf.Concat(buf.Concat(e, name), ": wrong bytes, fixups or an error; ")
	}
	for k := 0; k < len(kinds); k++ {
		var fix asm.Fixup = a.Sections[0].Fixups[k]
		if fix.Kind != kinds[k] || cast(int, fix.Offset) != offs[k] ||
				fix.Addend != cast(int64, addends[k]) {
			return buf.Concat(buf.Concat(e, name), ": wrong fixup; ")
		}
	}
	return e
}

// A symbol in ENTER's and RETF's immediates, its field relocated by the absolute data kind of its
// size, as clang's `enter offset x, offset y` (R_X86_64_16 at 1, R_X86_64_8 at 3) and `retfq offset
// x + 2` (R_X86_64_16 at 2, addend 2); a thread-local offset there is an error.
func TestControlSymbols() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Enter(a, x64.ImmSym("x", 0, 0), x64.ImmSym("y", 0, 0))
	e = symCase(e, a, "enter offset x, offset y", "c8 00 00 00",
			@[]int{asm.FIX_DATA_ABS16, asm.FIX_DATA_ABS8}, @[]int{1, 3}, @[]int{0, 0})
	a = newAsm()
	RetfImm(a, x64.SZ64, x64.ImmSym("x", 2, 0))
	e = symCase(e, a, "retfq offset x + 2", "48 ca 00 00", @[]int{asm.FIX_DATA_ABS16}, @[]int{2},
			@[]int{2})
	a = newAsm()
	Enter(a, x64.ImmSym("x", 0, x64.FIX_TPOFF32), x64.Imm(0))
	e = rejectCase(e, a, "enter offset x@TPOFF, 0")
	return e
}

// loopCase adds name to the failures e unless a, resolved, holds exactly the bytes hex spells.
func loopCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if !x64.ResolveFixups(a) { return buf.Concat(buf.Concat(e, name), ": not resolved; ") }
	return ctrlCase(e, a, name, hex)
}

// The loop instructions to a block label (`L`, inside the atom) before them and after, at the
// rel8's limits, -128 and 127.
func TestLoops() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	a.DefineLabel("Llbl")
	Loop(a, "Llbl", 0)
	Loope(a, "Llbl", 0)
	Loopne(a, "Llbl", 0)
	Jrcxz(a, "Llbl", 0)
	Jecxz(a, "Llbl", 0)
	e = loopCase(e, a, "back", "e2 fe e1 fc e0 fa e3 f8 67 e3 f5")
	a = newAsm()
	Loop(a, "Lfwd", 0)
	x64.Nop(a)
	a.DefineLabel("Lfwd")
	Loop(a, "Lfwd", 2)
	e = loopCase(e, a, "forward, with an addend", "e2 01 90 e2 00")
	a = newAsm()
	a.DefineLabel("Lfar")
	for i := 0; i < 126; i++ { x64.Nop(a) }
	Loop(a, "Lfar", 0)
	Loop(a, "Lend", 0)
	for i := 0; i < 127; i++ { x64.Nop(a) }
	a.DefineLabel("Lend")
	if !x64.ResolveFixups(a) || a.HasError { e = buf.Concat(e, "rel8 limits: not resolved; ") }
	if a.Sections[0].Data[127] != 0x80 || a.Sections[0].Data[129] != 0x7F {
		e = buf.Concat(e, "rel8 limits: wrong displacements; ")
	}
	return e
}

// A loop's target past the rel8's reach, on either side, is an error.
func TestLoopOutOfRange() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	a.DefineLabel("Lfar")
	for i := 0; i < 127; i++ { x64.Nop(a) }
	Loop(a, "Lfar", 0)
	if x64.ResolveFixups(a) || !a.HasError { e = buf.Concat(e, "back 129: resolved; ") }
	a = newAsm()
	Jrcxz(a, "Lend", 0)
	for i := 0; i < 128; i++ { x64.Nop(a) }
	a.DefineLabel("Lend")
	if x64.ResolveFixups(a) || !a.HasError { e = buf.Concat(e, "forward 128: resolved; ") }
	return e
}

// Immediates past their fields, sizes an instruction has no form of, and a lock prefix before
// one (x64.LockNext) are errors and emit nothing.
func TestControlRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Enter(a, x64.Imm(65536), x64.Imm(0))
	e = rejectCase(e, a, "enter 65536, 0")
	a = newAsm()
	Enter(a, x64.Imm(-32769), x64.Imm(0))
	e = rejectCase(e, a, "enter -32769, 0")
	a = newAsm()
	Enter(a, x64.Imm(16), x64.Imm(256))
	e = rejectCase(e, a, "enter 16, 256")
	a = newAsm()
	Enter(a, x64.Imm(16), x64.Imm(-129))
	e = rejectCase(e, a, "enter 16, -129")
	a = newAsm()
	RetfImm(a, x64.SZ32, x64.Imm(65536))
	e = rejectCase(e, a, "retf 65536")
	a = newAsm()
	Retf(a, x64.SZ8)
	e = rejectCase(e, a, "retf of a byte")
	a = newAsm()
	Iret(a, 0)
	e = rejectCase(e, a, "iret of no size")
	a = newAsm()
	x64.LockNext(a)
	Leave(a)
	e = rejectCase(e, a, "lock leave")
	return e
}

// machoLoopAsm returns a Mach-O assembler (SubsectionsViaSymbols as subsections) holding `_f: nop`,
// `Lt: nop`, `_g: loop Lt`, resolved.
func machoLoopAsm(subsections bool) @asm.Assembler {
	var a @asm.Assembler = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.SubsectionsViaSymbols = subsections
	a.DefineLabel("_f")
	x64.Nop(a)
	a.DefineLabel("Lt")
	x64.Nop(a)
	a.DefineLabel("_g")
	Loop(a, "Lt", 0)
	x64.ResolveFixups(a)
	return a
}

// ld64 drops a Mach-O 1-byte branch relocation's addend, so without SubsectionsViaSymbols a loop
// to a label in its section that would be relocated with one is patched in place: to a temporary
// past its atom's listed symbol (the writer would move the reference there, the offset its
// addend), or to a listed symbol plus an addend.  One that would carry none stays a relocation,
// as do all with SubsectionsViaSymbols.
func TestLoopMachoAddend() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = machoLoopAsm(false)
	if a.HasError || a.Sections[0].Data[3] != 0xFD || a.Sections[0].Fixups[0].Kind != -1 {
		e = buf.Concat(e, "a temporary past its atom's symbol: not patched in place; ")
	}
	a = machoLoopAsm(true)
	if a.HasError || a.Sections[0].Fixups[0].Kind != x64.FIX_REL8 {
		e = buf.Concat(e, "with SubsectionsViaSymbols: not left a relocation; ")
	}
	a = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.DefineLabel("_f")
	x64.Nop(a)
	a.DefineLabel("_g")
	Loop(a, "_h", 2)
	Loop(a, "_f", 0)
	a.DefineLabel("_h")
	x64.ResolveFixups(a)
	if a.HasError || a.Sections[0].Data[2] != 0x04 || a.Sections[0].Fixups[0].Kind != -1 ||
			a.Sections[0].Fixups[1].Kind != x64.FIX_REL8 {
		e = buf.Concat(e, "another atom's listed symbol plus 2 patched, plus 0 relocated: not so; ")
	}
	return e
}

// The addend the writer would give a Mach-O rel8 to an unlisted label is its offset from its
// atom's symbol plus the one written — from the section's start before any listed symbol — so a
// loop to a temporary there is patched in place, and one to a temporary at its atom symbol's
// offset, or whose written addend cancels its offset, stays a relocation (against that symbol,
// with none).
func TestLoopMachoAddendPrediction() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	x64.Nop(a)
	a.DefineLabel("Lt")
	x64.Nop(a)
	a.DefineLabel("_g")
	Loop(a, "Lt", 0)
	x64.ResolveFixups(a)
	if a.HasError || a.Sections[0].Data[3] != 0xFD || a.Sections[0].Fixups[0].Kind != -1 {
		e = buf.Concat(e, "a temporary before any listed symbol: not patched in place; ")
	}
	a = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.DefineLabel("_f")
	x64.Nop(a)
	a.DefineLabel("body")
	a.DefineLabel("Lt")
	x64.Nop(a)
	a.DefineLabel("_g")
	Loop(a, "Lt", 0)
	x64.ResolveFixups(a)
	if a.HasError || a.Sections[0].Fixups[0].Kind != x64.FIX_REL8 {
		e = buf.Concat(e, "a temporary at its atom symbol's offset: not left a relocation; ")
	}
	a = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.DefineLabel("mid")
	x64.Nop(a)
	a.DefineLabel("Lend")
	x64.Nop(a)
	a.DefineLabel("_g")
	Jrcxz(a, "Lend", -1)
	x64.ResolveFixups(a)
	if a.HasError || a.Sections[0].Fixups[0].Kind != x64.FIX_REL8 {
		e = buf.Concat(e, "a written addend cancelling the offset: not left a relocation; ")
	}
	return e
}
