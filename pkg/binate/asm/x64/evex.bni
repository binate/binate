// Package evex provides the x86-64 EVEX prefix encoder, AVX-512's: the four-byte prefix 62, which
// carries an instruction's implied prefix, opcode map, W, the top bits of its ModR/M reg field and
// r/m operand (registers 0..31), its second source register (0..31), its vector length or rounding
// mode, a broadcast / rounding / SAE flag, a write mask and zeroing.  The instructions are
// pkg/binate/asm/x64/avx's table.
package "pkg/binate/asm/x64/evex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The opcode maps an EVEX prefix selects beyond VEX's (vex.MAP_0F, MAP_0F38, MAP_0F3A): maps 5 and
// 6, AVX512-FP16's.
const (
	MAP_5 int = 5
	MAP_6 int = 6
)

// Emit emits the EVEX prefix of an instruction in opcode map m (vex.MAP_0F, vex.MAP_0F38,
// vex.MAP_0F3A, MAP_5 or MAP_6) whose implied prefix is pp (vex.PP_NONE, PP_66, PP_F3 or PP_F2),
// W bit w, vector length ll (0, 1, 2 for 128, 256, 512 bits; with b and a register r/m, the
// rounding mode 0..3), ModR/M reg field reg (a register 0..31: R and R' its bits 3 and 4; or an
// opcode extension), second source register v (0..31: vvvv and V'; 0 for an instruction without
// one, which encodes as the 1111 and 1 it needs), r/m operand rm (a register 0..31, X and B its
// bits 4 and 3; memory, X and B its index's and base's bit 3; memory with a vector index,
// x64.IsVsib, X and V' its index's bits 3 and 4, v then 0), write mask aaa (0..7, k0 none),
// zeroing z and flag b (a memory operand's broadcast; a register r/m's rounding or SAE).  It sets
// asm.Assembler.X64EvexDone.  Any field out of its range sets an assembler error and emits
// nothing, as an instruction after `{rex}` or `rex64` does (asm.Assembler.X64Rex, X64RexW).
func Emit(a @asm.Assembler, m int, pp int, w bool, ll int, reg int, v int, rm x64.Operand, aaa int,
		z bool, b bool)
