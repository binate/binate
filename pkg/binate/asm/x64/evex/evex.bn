package "pkg/binate/asm/x64/evex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"
import "pkg/binate/buf"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// bit returns bit n of r (0 or 1).
func bit(r int, n int) int { return (r >> n) & 1 }

// fieldsOk reports whether the fields are encodable, else sets the assembler error.
func fieldsOk(a @asm.Assembler, m int, pp int, ll int, reg int, v int, rm x64.Operand,
		aaa int) bool {
	var problem *[]readonly char = ""
	if a.X64Rex || a.X64RexW {
		problem = "the instruction takes no REX prefix ({rex} or rex64)"
	} else if m != vex.MAP_0F && m != vex.MAP_0F38 && m != vex.MAP_0F3A && m != MAP_5 && m != MAP_6 {
		problem = "the opcode map is 0F, 0F 38, 0F 3A, 5 or 6"
	} else if pp < vex.PP_NONE || pp > vex.PP_F2 {
		problem = "the implied prefix is none, 66, F3 or F2"
	} else if ll < 0 || ll > 3 {
		problem = "the vector length or rounding mode is 0..3"
	} else if reg < 0 || reg > 31 || v < 0 || v > 31 {
		problem = "a register field is 0..31"
	} else if aaa < 0 || aaa > 7 {
		problem = "the write mask is k0..k7"
	} else if rm.Kind == x64.OP_REG && (rm.Reg < 0 || rm.Reg > 31) {
		problem = "the r/m register is 0..31"
	} else if rm.Kind != x64.OP_REG && !x64.IsMem(rm) && !x64.IsVsib(rm) {
		problem = "the r/m operand is a register 0..31 or memory"
	} else if x64.IsVsib(rm) && (rm.Index < 0 || rm.Index > 31 || v != 0) {
		problem = "a vector index is 0..31, and leaves no second source register"
	} else {
		return true
	}
	a.SetError(buf.Concat("x64: EVEX: ", problem))
	return false
}

// Emit emits an EVEX prefix; see evex.bni.
func Emit(a @asm.Assembler, m int, pp int, w bool, ll int, reg int, v int, rm x64.Operand, aaa int,
		z bool, b bool) {
	if !fieldsOk(a, m, pp, ll, reg, v, rm, aaa) { return }
	a.X64EvexDone = true
	var x int = 0
	var bb int = 0
	var vhi int = bit(v, 4)
	if rm.Kind == x64.OP_REG {
		x = bit(rm.Reg, 4)
		bb = bit(rm.Reg, 3)
	} else {
		if rm.Index >= 0 { x = bit(rm.Index, 3) }
		if rm.Base >= 0 { bb = bit(rm.Base, 3) }
		if x64.IsVsib(rm) { vhi = bit(rm.Index, 4) }
	}
	emit8(a, 0x62)
	emit8(a,
			((1 - bit(reg, 3)) << 7) | ((1 - x) << 6) | ((1 - bb) << 5) | ((1 - bit(reg, 4)) << 4) | m)
	var wb int = 0
	if w { wb = 0x80 }
	emit8(a, wb | ((~v & 0xF) << 3) | 0x04 | pp)
	var zb int = 0
	if z { zb = 0x80 }
	var bf int = 0
	if b { bf = 0x10 }
	emit8(a, zb | (ll << 5) | bf | ((1 - vhi) << 3) | aaa)
}
