package "pkg/binate/asm/x64/evex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"
import "pkg/builtins/testing"

// The EVEX prefix against clang's (`clang --target=x86_64-linux-gnu -c`, Intel syntax):
// registers 16..31 in each field (R', X for a register r/m, V'), a write mask and zeroing, a
// broadcast, a rounding mode, the maps, and memory's X and B.

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// prefixIs reports whether a holds exactly the four bytes b0 .. b3 and no error.
func prefixIs(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int) bool {
	var s @asm.Section = a.Sections[0]
	if a.HasError || s.Len != 4 { return false }
	return cast(int, s.Data[0]) == b0 && cast(int, s.Data[1]) == b1 && cast(int, s.Data[2]) == b2 &&
			cast(int, s.Data[3]) == b3
}

func TestEmit() testing.TestResult {
	// vaddps zmm0, zmm1, zmm2: 62 f1 74 48
	var a @asm.Assembler = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 2, 0, 1, x64.Reg(2, x64.SZ64), 0, false, false)
	if !prefixIs(a, 0x62, 0xF1, 0x74, 0x48) || !a.X64EvexDone {
		return fail("vaddps zmm0, zmm1, zmm2")
	}
	// vaddps xmm16, xmm17, xmm18: 62 a1 74 00
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 0, 16, 17, x64.Reg(18, x64.SZ64), 0, false, false)
	if !prefixIs(a, 0x62, 0xA1, 0x74, 0x00) { return fail("vaddps xmm16, xmm17, xmm18") }
	// vaddps zmm31, zmm30, zmm29: 62 01 0c 40
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 2, 31, 30, x64.Reg(29, x64.SZ64), 0, false, false)
	if !prefixIs(a, 0x62, 0x01, 0x0C, 0x40) { return fail("vaddps zmm31, zmm30, zmm29") }
	// vaddps zmm0 {k1} {z}, zmm1, zmm2, {rz-sae}: 62 f1 74 f9
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 3, 0, 1, x64.Reg(2, x64.SZ64), 1, true, true)
	if !prefixIs(a, 0x62, 0xF1, 0x74, 0xF9) { return fail("{k1} {z}, {rz-sae}") }
	// vaddps zmm0, zmm1, dword ptr [rax]{1to16}: 62 f1 74 58
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 2, 0, 1, x64.Mem(x64.RAX, 0, 0), 0, false, true)
	if !prefixIs(a, 0x62, 0xF1, 0x74, 0x58) { return fail("{1to16}") }
	// vaddps zmm0, zmm1, [r8 + r9*4 + 64]: 62 91 74 48
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 2, 0, 1, x64.MemIdx(x64.R8, x64.R9, 4, 64, 0), 0, false,
			false)
	if !prefixIs(a, 0x62, 0x91, 0x74, 0x48) { return fail("[r8 + r9*4 + 64]") }
	// vcmpps k1 {k2}, zmm0, zmm1, 0: 62 f1 7c 4a; {evex} vaddps xmm0, xmm1, xmm8: 62 d1 74 08
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 2, 1, 0, x64.Reg(1, x64.SZ64), 2, false, false)
	if !prefixIs(a, 0x62, 0xF1, 0x7C, 0x4A) { return fail("vcmpps k1 {k2}") }
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 0, 0, 1, x64.Reg(8, x64.SZ64), 0, false, false)
	if !prefixIs(a, 0x62, 0xD1, 0x74, 0x08) { return fail("xmm8 in r/m") }
	// vcvtsi2sh xmm0, xmm1, rax: map 5, F3, W1: 62 f5 f6 08
	a = newAsm()
	Emit(a, MAP_5, vex.PP_F3, true, 0, 0, 1, x64.Reg(0, x64.SZ64), 0, false, false)
	if !prefixIs(a, 0x62, 0xF5, 0xF6, 0x08) { return fail("vcvtsi2sh xmm0, xmm1, rax") }
	return ""
}

// A vector index puts its bits 3 and 4 in X and V'; out-of-range fields, {rex}, emit nothing.
func TestEmitErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var m x64.Operand = x64.MemVsib(x64.RAX, 18, 4, 0, 0, x64.SZ512)
	Emit(a, vex.MAP_0F38, vex.PP_66, false, 2, 1, 0, m, 1, false, false)
	if !prefixIs(a, 0x62, 0xF2, 0x7D, 0x41) { return fail("[rax + zmm18*4]: V' 0") }
	a = newAsm()
	Emit(a, 4, vex.PP_NONE, false, 0, 0, 0, x64.Reg(0, x64.SZ64), 0, false, false)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("map 4") }
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 0, 32, 0, x64.Reg(0, x64.SZ64), 0, false, false)
	if !a.HasError { return fail("reg 32") }
	a = newAsm()
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 0, 0, 0, x64.Reg(0, x64.SZ64), 8, false, false)
	if !a.HasError { return fail("mask 8") }
	a = newAsm()
	a.X64Rex = true
	Emit(a, vex.MAP_0F, vex.PP_NONE, false, 0, 0, 0, x64.Reg(0, x64.SZ64), 0, false, false)
	if !a.HasError { return fail("{rex}") }
	return ""
}
