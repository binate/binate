// Package flags provides the x86-64 instructions on the flags register beside the instructions of
// pkg/binate/asm/x64: setting and clearing the carry and direction flags, moving the low byte to
// and from AH, and pushing and popping the whole register.  None takes a lock prefix: after
// x64.LockNext, each is an assembler error and writes nothing.
package "pkg/binate/asm/x64/flags"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// Clc emits CLC (F8): clear the carry flag.
func Clc(a @asm.Assembler)

// Stc emits STC (F9): set the carry flag.
func Stc(a @asm.Assembler)

// Cmc emits CMC (F5): complement the carry flag.
func Cmc(a @asm.Assembler)

// Cld emits CLD (FC): clear the direction flag.
func Cld(a @asm.Assembler)

// Std emits STD (FD): set the direction flag.
func Std(a @asm.Assembler)

// Lahf emits LAHF (9F): load AH from the flags' low byte.
func Lahf(a @asm.Assembler)

// Sahf emits SAHF (9E): store AH into the flags' low byte.
func Sahf(a @asm.Assembler)

// Pushf emits PUSHF of the flags register at size bits: x64.SZ64 (`pushfq`, 9C) or SZ16
// (`pushfw`, 66 9C); any other size sets an assembler error and emits nothing (64-bit mode has
// no 32-bit form).
func Pushf(a @asm.Assembler, size int)

// Popf emits POPF of the flags register at size bits, as Pushf (9D).
func Popf(a @asm.Assembler, size int)
