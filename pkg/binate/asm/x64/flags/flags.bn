package "pkg/binate/asm/x64/flags"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// Clc emits CLC (F8); see flags.bni.
func Clc(a @asm.Assembler) { emit8(a, 0xF8) }

// Stc emits STC (F9); see flags.bni.
func Stc(a @asm.Assembler) { emit8(a, 0xF9) }

// Cmc emits CMC (F5); see flags.bni.
func Cmc(a @asm.Assembler) { emit8(a, 0xF5) }

// Cld emits CLD (FC); see flags.bni.
func Cld(a @asm.Assembler) { emit8(a, 0xFC) }

// Std emits STD (FD); see flags.bni.
func Std(a @asm.Assembler) { emit8(a, 0xFD) }

// Lahf emits LAHF (9F); see flags.bni.
func Lahf(a @asm.Assembler) { emit8(a, 0x9F) }

// Sahf emits SAHF (9E); see flags.bni.
func Sahf(a @asm.Assembler) { emit8(a, 0x9E) }

// Pushf emits PUSHF at size bits (9C); see flags.bni.
func Pushf(a @asm.Assembler, size int) { emitStack(a, "pushf", 0x9C, size) }

// Popf emits POPF at size bits (9D); see flags.bni.
func Popf(a @asm.Assembler, size int) { emitStack(a, "popf", 0x9D, size) }

// emitStack emits the flags push or pop mnem, opcode op, at size bits: x64.SZ64, or SZ16 after
// the operand-size prefix; any other size is an error.
func emitStack(a @asm.Assembler, mnem *[]readonly char, op int, size int) {
	if size != x64.SZ64 && size != x64.SZ16 {
		x64.OperandError(a, mnem, "the flags are pushed and popped as 64 or 16 bits")
		return
	}
	if size == x64.SZ16 { emit8(a, 0x66) }
	emit8(a, op)
}
