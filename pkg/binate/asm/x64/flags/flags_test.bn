package "pkg/binate/asm/x64/flags"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The flags instructions against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// CLC F8, STC F9, CMC F5, CLD FC, STD FD, LAHF 9F, SAHF 9E; PUSHF / POPF 9C / 9D as 64 bits,
// 66 9C / 66 9D as 16.
func TestFlagsInstructions() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Clc(a)
	Stc(a)
	Cmc(a)
	Cld(a)
	Std(a)
	Lahf(a)
	Sahf(a)
	Pushf(a, x64.SZ64)
	Pushf(a, x64.SZ16)
	Popf(a, x64.SZ64)
	Popf(a, x64.SZ16)
	if !emits(a, "f8 f9 f5 fc fd 9f 9e 9c 66 9c 9d 66 9d") {
		return "the flags instructions are not clang's"
	}
	return ""
}

// 64-bit mode has no 32-bit (or 8-bit) PUSHF / POPF.
func TestFlagsStackRejects() testing.TestResult {
	var sizes @[]int = @[]int{x64.SZ32, x64.SZ8, 0}
	for i := 0; i < len(sizes); i++ {
		var a @asm.Assembler = newAsm()
		Pushf(a, sizes[i])
		Popf(a, sizes[i])
		if !a.HasError || asm.HeldLen(a.Sections[0]) != 0 {
			return "pushf / popf took a size with no 64-bit-mode form"
		}
	}
	return ""
}

// A lock (x64.LockNext) before them is an error, nothing written.
func TestFlagsLockRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	x64.LockNext(a)
	Pushf(a, x64.SZ16)
	if !a.HasError || asm.HeldLen(a.Sections[0]) != 0 { return "lock pushfw was taken" }
	return ""
}
