// Package gpext provides the x86-64 general-purpose instruction-set extensions beside the
// instructions of pkg/binate/asm/x64: BMI1 and BMI2 (VEX-encoded, pkg/binate/asm/x64/vex), AMD's
// TBM (XOP-encoded), ADX, MOVBE, CRC32, MOVRS, MOVNTI, the remote atomics (RAO-INT) and CMPccXADD.
//
// Their operands are x64 operands: registers (x64.Reg) of 32 or 64 bits, all of the instruction's
// operand size (16 bits too for MOVBE), and a memory operand (x64.IsMem — an OP_MEM, a `[rip +
// label]` or a `[rip + label@GOTPCREL]`, as clang a GOT slot's plain relocation) of that size or of
// size 0, which takes it (CRC32's source has a size of its own: see Crc32).  Any other operand
// sets an assembler error and emits nothing.  None takes a lock prefix (x64.LockNext).
package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// --- BMI1 and BMI2 (VEX.LZ, W the operand size) ---

// Andn emits ANDN dst, src1, src2 (VEX.0F38 F2 /r): dst <- ~src1 & src2.  dst and src1 are
// registers, src2 a register or memory.
func Andn(a @asm.Assembler, dst x64.Operand, src1 x64.Operand, src2 x64.Operand)

// Bextr emits BEXTR dst, src, ctl: dst <- the bit field of src that ctl selects, its start in
// ctl's bits 0-7 and its length in 8-15.  dst is a register, src a register or memory, and ctl a
// register (BMI1: VEX.0F38 F7 /r) or an immediate (TBM: XOP.0A 10 /r id): a number, at 32 bits
// -2^31..2^32 - 1 and at 64 sign-extended, -2^31..2^31 - 1, or a symbol (x64.ImmSym, its field
// relocated by asm.FIX_DATA_ABS32 at 32 bits and x64.FIX_ABS32S at 64, as clang's `offset sym`).
func Bextr(a @asm.Assembler, dst x64.Operand, src x64.Operand, ctl x64.Operand)

// Blsi emits BLSI dst, src (VEX.0F38 F3 /3): dst <- src's lowest set bit alone.  dst is a
// register, src a register or memory; so for Blsmsk and Blsr.
func Blsi(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blsmsk emits BLSMSK dst, src (VEX.0F38 F3 /2): dst <- src ^ (src - 1), the bits up to and
// including src's lowest set bit.
func Blsmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blsr emits BLSR dst, src (VEX.0F38 F3 /1): dst <- src & (src - 1), src's lowest set bit
// cleared.
func Blsr(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Bzhi emits BZHI dst, src, index (VEX.0F38 F5 /r): dst <- src with its bits at and above the
// position index's low byte holds cleared.  dst and index are registers, src a register or memory.
func Bzhi(a @asm.Assembler, dst x64.Operand, src x64.Operand, index x64.Operand)

// Mulx emits MULX hi, lo, src (VEX.F2.0F38 F6 /r): hi:lo <- EDX / RDX times src, unsigned,
// leaving the flags as they are.  hi and lo are registers, src a register or memory.
func Mulx(a @asm.Assembler, hi x64.Operand, lo x64.Operand, src x64.Operand)

// Pdep emits PDEP dst, src, mask (VEX.F2.0F38 F5 /r): dst <- src's low bits deposited, in order,
// at mask's set bits, the others 0.  dst and src are registers, mask a register or memory.
func Pdep(a @asm.Assembler, dst x64.Operand, src x64.Operand, mask x64.Operand)

// Pext emits PEXT dst, src, mask (VEX.F3.0F38 F5 /r): dst <- src's bits at mask's set bits,
// packed in order into dst's low bits, the others 0.  Its operands are Pdep's.
func Pext(a @asm.Assembler, dst x64.Operand, src x64.Operand, mask x64.Operand)

// Rorx emits RORX dst, src, count (VEX.F2.0F3A F0 /r ib): dst <- src rotated right by count
// (modulo the operand size), leaving the flags as they are.  dst is a register, src a register or
// memory, and count an immediate: a number -128..255 (a negative one its two's-complement byte)
// or a symbol (x64.ImmSym, its byte relocated by asm.FIX_DATA_ABS8).
func Rorx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand)

// Sarx emits SARX dst, src, count (VEX.F3.0F38 F7 /r): dst <- src shifted right arithmetically by
// count (modulo the operand size), leaving the flags as they are.  dst and count are registers,
// src a register or memory; so for Shlx and Shrx.
func Sarx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand)

// Shlx emits SHLX dst, src, count (VEX.66.0F38 F7 /r): dst <- src shifted left by count.
func Shlx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand)

// Shrx emits SHRX dst, src, count (VEX.F2.0F38 F7 /r): dst <- src shifted right logically by
// count.
func Shrx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand)

// --- TBM (XOP.LZ map 9, W the operand size; BEXTR's immediate form is Bextr) ---
//
// Each is dst, src: dst (XOP.vvvv) a register, src a register or memory.

// Blcfill emits BLCFILL (01 /1): dst <- src & (src + 1), src's trailing ones cleared.
func Blcfill(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blci emits BLCI (02 /6): dst <- src | ~(src + 1), every bit set but src's lowest clear one.
func Blci(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blcic emits BLCIC (01 /5): dst <- ~src & (src + 1), src's lowest clear bit alone.
func Blcic(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blcmsk emits BLCMSK (02 /1): dst <- src ^ (src + 1), the bits up to and including src's
// lowest clear bit.
func Blcmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blcs emits BLCS (01 /3): dst <- src | (src + 1), src's lowest clear bit set.
func Blcs(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blsfill emits BLSFILL (01 /2): dst <- src | (src - 1), the bits below src's lowest set bit set.
func Blsfill(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Blsic emits BLSIC (01 /6): dst <- ~src | (src - 1), every bit set but src's lowest set one.
func Blsic(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// T1mskc emits T1MSKC (01 /7): dst <- ~src | (src + 1), every bit set but src's trailing ones.
func T1mskc(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Tzmsk emits TZMSK (01 /4): dst <- ~src & (src - 1), the bits of src's trailing zeros set.
func Tzmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// --- ADX, MOVBE and CRC32 (legacy-encoded, 0F 38) ---

// Adcx emits ADCX dst, src (66 0F 38 F6 /r, REX.W at 64 bits): dst <- dst + src + CF, setting CF
// alone.  dst is a register, src a register or memory.
func Adcx(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Adox emits ADOX dst, src (F3 0F 38 F6 /r): dst <- dst + src + OF, setting OF alone.
func Adox(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Movbe emits MOVBE dst, src, a move with the bytes reversed between a register and memory, of
// 16 (66), 32 or 64 bits (REX.W): the load register <- memory (0F 38 F0 /r) or the store memory <-
// register (0F 38 F1 /r).  Register to register is APX's EVEX-encoded form, not this one's, an
// error as any other operand.
func Movbe(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Crc32 emits CRC32 dst, src (F2 0F 38 F0 /r for an 8-bit src, F1 /r otherwise): dst <- the
// CRC-32C of src accumulated into dst's low 32 bits (a 64-bit dst's high half cleared).  dst is a
// 32- or 64-bit register (REX.W), src a register or a memory operand with its size: 8, 16 (66) or
// 32 bits beside a 32-bit dst, 8 or 64 beside a 64-bit one.  An 8-bit SPL, BPL, SIL or DIL takes
// a REX prefix, as x64's byte operands do; AH..BH take none, so not beside a 64-bit dst or R8..R15.
func Crc32(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// --- Remote atomics (RAO-INT) and CMPccXADD ---

// Aadd emits AADD m, r (NP [REX.W] 0F 38 FC /r): mem <- mem + src, atomically, leaving the flags
// and src as they are; Aand AAND (66), Aor AOR (F2) and Axor AXOR (F3) the same with and, or and
// xor.  src is a 32- or 64-bit register, mem memory of its size.  They are atomic without a lock
// prefix and take none.
func Aadd(a @asm.Assembler, mem x64.Operand, src x64.Operand)

func Aand(a @asm.Assembler, mem x64.Operand, src x64.Operand)

func Aor(a @asm.Assembler, mem x64.Operand, src x64.Operand)

func Axor(a @asm.Assembler, mem x64.Operand, src x64.Operand)

// Cmpccxadd emits CMP<cc>XADD mem, src, addend (VEX.66.0F38 E0+cc /r): compare src with mem, as CMP
// sets the flags; mem <- mem + addend when condition cc (x64.CC_*, 0..15) holds; src <- mem's old
// value; atomically.  src and addend are 32- or 64-bit registers of one size (W), mem memory of it
// in r/m; src is ModR/M's reg field and addend VEX.vvvv.
func Cmpccxadd(a @asm.Assembler, cc int, mem x64.Operand, src x64.Operand, addend x64.Operand)

// Movrs emits MOVRS r, m (0F 38 8A /r at 8 bits, [66] [REX.W] 0F 38 8B /r at 16, 32 or 64): dst <-
// mem, with the read-shared hint.  dst is an 8-, 16-, 32- or 64-bit register (SPL..DIL with the
// REX they need; AH..BH without, so not beside R8..R15), mem memory of its size or of size 0.
func Movrs(a @asm.Assembler, dst x64.Operand, mem x64.Operand)

// Movnti emits MOVNTI m, r ([REX.W] 0F C3 /r): store src, a 32- or 64-bit register, to mem,
// memory of its size or of size 0, with a non-temporal hint.
func Movnti(a @asm.Assembler, mem x64.Operand, src x64.Operand)
