package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// isReg reports whether op is a general-purpose register, RAX..R15, of size bits.
func isReg(op x64.Operand, size int) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 && op.Size == size
}

// isRM reports whether op is a register of size bits, or memory of that size or of size 0.
func isRM(op x64.Operand, size int) bool {
	if x64.IsMem(op) { return op.Size == 0 || op.Size == size }
	return isReg(op, size)
}

// opSize returns the operand size register dst gives its instruction, 32 or 64 bits, or 0 when
// dst is no register of either.
func opSize(dst x64.Operand) int {
	if isReg(dst, x64.SZ32) || isReg(dst, x64.SZ64) { return dst.Size }
	return 0
}

// operandsError sets the error of instruction mnem, whose operands are 32- or 64-bit registers of
// one size and memory of it, for operands that are not.
func operandsError(a @asm.Assembler, mnem *[]readonly char) {
	x64.OperandError(a, mnem, "takes 32- or 64-bit registers of one size and memory of that size")
}

// emitVex emits the VEX-encoded instruction of opcode op in map m with implied prefix pp at
// operand size size: its ModR/M reg field reg, VEX.vvvv register v and r/m operand rm, before an
// immBytes-byte immediate.
func emitVex(a @asm.Assembler, m int, pp int, size int, op int, reg int, v int, rm x64.Operand,
		immBytes int) {
	vex.Emit(a, m, pp, size == x64.SZ64, 0, reg, v, rm)
	emit8(a, op)
	x64.EmitModRMImm(a, reg, rm, immBytes)
}
