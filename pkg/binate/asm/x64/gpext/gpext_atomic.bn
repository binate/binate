package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// The remote atomics (RAO-INT, legacy-encoded 0F 38 FC with the operation in the mandatory prefix)
// and CMPccXADD (VEX-encoded).

// emitRao emits the remote atomic mnem mem, src: 66 when p66, legacy prefix pfx (0 for none), then
// 0F 38 FC /r with src in ModR/M's reg field.
func emitRao(a @asm.Assembler, mnem *[]readonly char, p66 bool, pfx int, mem x64.Operand,
		src x64.Operand) {
	var size int = opSize(src)
	if size == 0 || !x64.IsMem(mem) || !isRM(mem, size) {
		x64.OperandError(a, mnem, "takes memory and a 32- or 64-bit register of its size")
		return
	}
	emit0F38(a, p66, pfx, size == x64.SZ64, false, 0xFC, src.Reg, mem)
}

// Aadd emits AADD m, r (NP 0F 38 FC /r); see gpext.bni.
func Aadd(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitRao(a, "aadd", false, 0, mem, src)
}

// Aand emits AAND m, r (66 0F 38 FC /r); see gpext.bni.
func Aand(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitRao(a, "aand", true, 0, mem, src)
}

// Aor emits AOR m, r (F2 0F 38 FC /r); see gpext.bni.
func Aor(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitRao(a, "aor", false, 0xF2, mem, src)
}

// Axor emits AXOR m, r (F3 0F 38 FC /r); see gpext.bni.
func Axor(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitRao(a, "axor", false, 0xF3, mem, src)
}

// Cmpccxadd emits CMP<cc>XADD m, r, r (VEX.66.0F38 E0+cc /r); see gpext.bni.
func Cmpccxadd(a @asm.Assembler, cc int, mem x64.Operand, src x64.Operand, addend x64.Operand) {
	var size int = opSize(src)
	if cc < 0 || cc > 15 || size == 0 || !isReg(addend, size) || !x64.IsMem(mem) || !isRM(mem, size) {
		x64.OperandError(a, "cmp<cc>xadd",
				"takes a condition 0..15, memory and two 32- or 64-bit registers of its size")
		return
	}
	emitVex(a, vex.MAP_0F38, vex.PP_66, size, 0xE0 + cc, src.Reg, addend.Reg, mem, 0)
}
