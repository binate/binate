package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The remote atomics and CMPccXADD against clang (see gpext_test.bn).

// AADD / AAND / AOR / AXOR at both sizes, the mandatory prefix before REX, R8..R15, memory of size
// 0, a `[rip + x]` operand.
func TestRemoteAtomics() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Aadd(a, x64.Mem(x64.RAX, 0, x64.SZ32), r32(x64.RBX))
	Aadd(a, x64.Mem(x64.RAX, 0, x64.SZ64), r64(x64.RBX))
	Aadd(a, x64.Mem(x64.RAX, 0, 0), r64(x64.RBX))
	Aadd(a, x64.Mem(x64.R9, 0, x64.SZ32), r32(x64.R10))
	Aand(a, x64.Mem(x64.RAX, 0, 0), r32(x64.RBX))
	Aand(a, x64.Mem(x64.RAX, 0, x64.SZ64), r64(x64.RBX))
	Aor(a, x64.Mem(x64.RAX, 0, 0), r32(x64.RBX))
	Axor(a, x64.Mem(x64.RAX, 0, 0), r32(x64.RBX))
	var e @[]char = gpCase("", a, "aadd .. axor",
			"0f38fc18 480f38fc18 480f38fc18 450f38fc11 660f38fc18 66480f38fc18 f20f38fc18 f30f38fc18")
	a = newAsm()
	Axor(a, x64.RipLabel("x"), r64(x64.RAX))
	e = fixCase(e, a, "axor qword ptr [rip + x], rax", "f3480f38fc0500000000", x64.FIX_REL32_LEA, 6, 0)
	a = newAsm()
	Aadd(a, x64.Mem(x64.RAX, 0, x64.SZ16), r16(x64.RBX))
	e = rejectCase(e, a, "aadd word ptr [rax], bx")
	a = newAsm()
	Aadd(a, r64(x64.RAX), r64(x64.RBX))
	e = rejectCase(e, a, "aadd rax, rbx")
	return e
}

// CMPccXADD: each condition, both sizes, registers 8..15 in reg, vvvv and the address, a `[rip +
// x]` operand.
func TestCmpccxadd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var m x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	for cc := 0; cc < 16; cc++ { Cmpccxadd(a, cc, m, r32(x64.RBX), r32(x64.RCX)) }
	var e @[]char = gpCase("", a, "cmp<cc>xadd",
			"c4e271e018 c4e271e118 c4e271e218 c4e271e318 c4e271e418 c4e271e518 c4e271e618 c4e271e718 "
					"c4e271e818 c4e271e918 c4e271ea18 c4e271eb18 c4e271ec18 c4e271ed18 c4e271ee18 c4e271ef18")
	a = newAsm()
	Cmpccxadd(a, 0, x64.Mem(x64.RAX, 0, x64.SZ64), r64(x64.RBX), r64(x64.RCX))
	Cmpccxadd(a, 5, x64.Mem(x64.R9, 0, x64.SZ64), r64(x64.R10), r64(x64.R11))
	Cmpccxadd(a, 6, x64.Mem(x64.RAX, 0, 0), r32(x64.RBX), r32(x64.RBX))
	e = gpCase(e, a, "cmpoxadd / cmpnzxadd / cmpbexadd", "c4e2f1e018 c442a1e511 c4e261e618")
	a = newAsm()
	Cmpccxadd(a, 4, x64.RipLabel("x"), r64(x64.RBX), r64(x64.RCX))
	e = fixCase(e, a, "cmpzxadd qword ptr [rip + x], rbx, rcx", "c4e2f1e41d00000000",
			x64.FIX_REL32_LEA, 5, 0)
	a = newAsm()
	Cmpccxadd(a, 6, x64.Mem(x64.RAX, 0, x64.SZ32), r32(x64.RBX), r64(x64.RCX))
	e = rejectCase(e, a, "cmpbexadd dword ptr [rax], ebx, rcx")
	a = newAsm()
	Cmpccxadd(a, 6, r32(x64.RBX), r32(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "cmpbexadd ebx, ebx, ecx")
	a = newAsm()
	Cmpccxadd(a, 16, x64.Mem(x64.RAX, 0, 0), r32(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "cmp<16>xadd")
	return e
}
