package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// The BMI1 and BMI2 instructions, VEX-encoded at length 0 with W the operand size.

// vexRVM emits instruction mnem dst, v, rm (ANDN, MULX, PDEP and PEXT's operand order: dst in
// the ModR/M reg field, v in VEX.vvvv and rm the r/m operand), opcode op in map 0F 38 with implied
// prefix pp.
func vexRVM(a @asm.Assembler, mnem *[]readonly char, pp int, op int, dst x64.Operand, v x64.Operand,
		rm x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isReg(v, size) || !isRM(rm, size) {
		operandsError(a, mnem)
		return
	}
	emitVex(a, vex.MAP_0F38, pp, size, op, dst.Reg, v.Reg, rm, 0)
}

// vexRMV emits instruction mnem dst, rm, v (BEXTR, BZHI, SARX, SHLX and SHRX's order), opcode op
// in map 0F 38 with implied prefix pp.
func vexRMV(a @asm.Assembler, mnem *[]readonly char, pp int, op int, dst x64.Operand,
		rm x64.Operand, v x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(rm, size) || !isReg(v, size) {
		operandsError(a, mnem)
		return
	}
	emitVex(a, vex.MAP_0F38, pp, size, op, dst.Reg, v.Reg, rm, 0)
}

// vexVM emits instruction mnem dst, rm (BLSI, BLSMSK and BLSR's: dst in VEX.vvvv and the opcode
// extension ext in the ModR/M reg field), opcode F3 in map 0F 38.
func vexVM(a @asm.Assembler, mnem *[]readonly char, ext int, dst x64.Operand, rm x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(rm, size) {
		operandsError(a, mnem)
		return
	}
	emitVex(a, vex.MAP_0F38, vex.PP_NONE, size, 0xF3, ext, dst.Reg, rm, 0)
}

// Andn emits ANDN dst, src1, src2; see gpext.bni.
func Andn(a @asm.Assembler, dst x64.Operand, src1 x64.Operand, src2 x64.Operand) {
	vexRVM(a, "andn", vex.PP_NONE, 0xF2, dst, src1, src2)
}

// Bextr emits BEXTR dst, src, ctl (BMI1 or TBM by ctl's kind); see gpext.bni.
func Bextr(a @asm.Assembler, dst x64.Operand, src x64.Operand, ctl x64.Operand) {
	if ctl.Kind == x64.OP_IMM {
		bextrImm(a, dst, src, ctl)
		return
	}
	vexRMV(a, "bextr", vex.PP_NONE, 0xF7, dst, src, ctl)
}

// Blsi emits BLSI dst, src; see gpext.bni.
func Blsi(a @asm.Assembler, dst x64.Operand, src x64.Operand) { vexVM(a, "blsi", 3, dst, src) }

// Blsmsk emits BLSMSK dst, src; see gpext.bni.
func Blsmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	vexVM(a, "blsmsk", 2, dst, src)
}

// Blsr emits BLSR dst, src; see gpext.bni.
func Blsr(a @asm.Assembler, dst x64.Operand, src x64.Operand) { vexVM(a, "blsr", 1, dst, src) }

// Bzhi emits BZHI dst, src, index; see gpext.bni.
func Bzhi(a @asm.Assembler, dst x64.Operand, src x64.Operand, index x64.Operand) {
	vexRMV(a, "bzhi", vex.PP_NONE, 0xF5, dst, src, index)
}

// Mulx emits MULX hi, lo, src; see gpext.bni.
func Mulx(a @asm.Assembler, hi x64.Operand, lo x64.Operand, src x64.Operand) {
	vexRVM(a, "mulx", vex.PP_F2, 0xF6, hi, lo, src)
}

// Pdep emits PDEP dst, src, mask; see gpext.bni.
func Pdep(a @asm.Assembler, dst x64.Operand, src x64.Operand, mask x64.Operand) {
	vexRVM(a, "pdep", vex.PP_F2, 0xF5, dst, src, mask)
}

// Pext emits PEXT dst, src, mask; see gpext.bni.
func Pext(a @asm.Assembler, dst x64.Operand, src x64.Operand, mask x64.Operand) {
	vexRVM(a, "pext", vex.PP_F3, 0xF5, dst, src, mask)
}

// Rorx emits RORX dst, src, count; see gpext.bni.
func Rorx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(src, size) || count.Kind != x64.OP_IMM {
		operandsError(a, "rorx")
		return
	}
	if !x64.ImmOk(a, "rorx", count, x64.SZ8) { return }
	emitVex(a, vex.MAP_0F3A, vex.PP_F2, size, 0xF0, dst.Reg, 0, src, 1)
	x64.EmitImm(a, "rorx", count, x64.SZ8)
}

// Sarx emits SARX dst, src, count; see gpext.bni.
func Sarx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand) {
	vexRMV(a, "sarx", vex.PP_F3, 0xF7, dst, src, count)
}

// Shlx emits SHLX dst, src, count; see gpext.bni.
func Shlx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand) {
	vexRMV(a, "shlx", vex.PP_66, 0xF7, dst, src, count)
}

// Shrx emits SHRX dst, src, count; see gpext.bni.
func Shrx(a @asm.Assembler, dst x64.Operand, src x64.Operand, count x64.Operand) {
	vexRMV(a, "shrx", vex.PP_F2, 0xF7, dst, src, count)
}
