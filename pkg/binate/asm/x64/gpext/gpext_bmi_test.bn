package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// BMI1 and BMI2 against clang (see gpext_test.bn), each at 32 and 64 bits, with registers 8..15 in
// every field (VEX.R, X, B and vvvv), a SIB, RSP, RBP and R12 / R13 bases, and memory of size 0.

// ANDN, BEXTR (register), BLSI, BLSMSK, BLSR and BZHI.
func TestBmi1() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "andn eax, ebx, ecx", "c4e260f2c1")
	a = newAsm()
	Andn(a, r64(x64.RAX), r64(x64.RBX), r64(x64.RCX))
	e = gpCase(e, a, "andn rax, rbx, rcx", "c4e2e0f2c1")
	a = newAsm()
	Andn(a, r64(x64.R8), r64(x64.R9), r64(x64.R10))
	e = gpCase(e, a, "andn r8, r9, r10", "c442b0f2c2")
	a = newAsm()
	Andn(a, r32(x64.R8), r32(x64.R9), r32(x64.R10))
	e = gpCase(e, a, "andn r8d, r9d, r10d", "c44230f2c2")
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.Mem(x64.RCX, 0, x64.SZ32))
	e = gpCase(e, a, "andn eax, ebx, dword ptr [rcx]", "c4e260f201")
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.Mem(x64.RCX, 0, 0))
	e = gpCase(e, a, "andn eax, ebx, [rcx]", "c4e260f201")
	a = newAsm()
	Andn(a, r64(x64.RAX), r64(x64.R15), x64.MemIdx(x64.R12, x64.R13, 8, 8, x64.SZ64))
	e = gpCase(e, a, "andn rax, r15, qword ptr [r12 + r13*8 + 8]", "c48280f244ec08")
	a = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "bextr eax, ebx, ecx", "c4e270f7c3")
	a = newAsm()
	Bextr(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), r64(x64.RCX))
	e = gpCase(e, a, "bextr rax, qword ptr [rbx], rcx", "c4e2f0f703")
	a = newAsm()
	Bextr(a, r64(x64.R8), r64(x64.R9), r64(x64.R10))
	e = gpCase(e, a, "bextr r8, r9, r10", "c442a8f7c1")
	a = newAsm()
	Bextr(a, r32(x64.R15), x64.Mem(x64.R14, 4, x64.SZ32), r32(x64.R13))
	e = gpCase(e, a, "bextr r15d, dword ptr [r14 + 4], r13d", "c44210f77e04")
	a = newAsm()
	Blsi(a, r32(x64.RAX), r32(x64.RBX))
	e = gpCase(e, a, "blsi eax, ebx", "c4e278f3db")
	a = newAsm()
	Blsi(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = gpCase(e, a, "blsi rax, qword ptr [rbx]", "c4e2f8f31b")
	a = newAsm()
	Blsmsk(a, r64(x64.R8), r64(x64.R9))
	e = gpCase(e, a, "blsmsk r8, r9", "c4c2b8f3d1")
	a = newAsm()
	Blsmsk(a, r32(x64.R15), x64.Mem(x64.RSP, 0, x64.SZ32))
	e = gpCase(e, a, "blsmsk r15d, dword ptr [rsp]", "c4e200f31424")
	a = newAsm()
	Blsr(a, r32(x64.R15), x64.Mem(x64.R14, 0, x64.SZ32))
	e = gpCase(e, a, "blsr r15d, dword ptr [r14]", "c4c200f30e")
	a = newAsm()
	Blsr(a, r64(x64.R15), r64(x64.R14))
	e = gpCase(e, a, "blsr r15, r14", "c4c280f3ce")
	a = newAsm()
	Bzhi(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "bzhi eax, ebx, ecx", "c4e270f5c3")
	a = newAsm()
	Bzhi(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), r64(x64.R8))
	e = gpCase(e, a, "bzhi rax, qword ptr [rbx], r8", "c4e2b8f503")
	a = newAsm()
	Bzhi(a, r32(x64.R9), r32(x64.R10), r32(x64.R11))
	e = gpCase(e, a, "bzhi r9d, r10d, r11d", "c44220f5ca")
	a = newAsm()
	Bzhi(a, r64(x64.R15), x64.Mem(x64.RBP, 0, x64.SZ64), r64(x64.R14))
	e = gpCase(e, a, "bzhi r15, qword ptr [rbp], r14", "c46288f57d00")
	return e
}

// MULX, PDEP, PEXT, RORX, SARX, SHLX and SHRX.
func TestBmi2() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mulx(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "mulx eax, ebx, ecx", "c4e263f6c1")
	a = newAsm()
	Mulx(a, r64(x64.RAX), r64(x64.RBX), x64.Mem(x64.RCX, 0, x64.SZ64))
	e = gpCase(e, a, "mulx rax, rbx, qword ptr [rcx]", "c4e2e3f601")
	a = newAsm()
	Mulx(a, r64(x64.R15), r64(x64.R14), r64(x64.R13))
	e = gpCase(e, a, "mulx r15, r14, r13", "c4428bf6fd")
	a = newAsm()
	Pdep(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "pdep eax, ebx, ecx", "c4e263f5c1")
	a = newAsm()
	Pdep(a, r64(x64.RAX), r64(x64.R8), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = gpCase(e, a, "pdep rax, r8, qword ptr [rbx]", "c4e2bbf503")
	a = newAsm()
	Pext(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "pext eax, ebx, ecx", "c4e262f5c1")
	a = newAsm()
	Pext(a, r64(x64.R12), r64(x64.R13), r64(x64.R14))
	e = gpCase(e, a, "pext r12, r13, r14", "c44292f5e6")
	a = newAsm()
	Pext(a, r64(x64.RSP), r64(x64.RBP), x64.Mem(x64.R12, 0, x64.SZ64))
	e = gpCase(e, a, "pext rsp, rbp, qword ptr [r12]", "c4c2d2f52424")
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(3))
	e = gpCase(e, a, "rorx eax, ebx, 3", "c4e37bf0c303")
	a = newAsm()
	Rorx(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), x64.Imm(63))
	e = gpCase(e, a, "rorx rax, qword ptr [rbx], 63", "c4e3fbf0033f")
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(255))
	e = gpCase(e, a, "rorx eax, ebx, 255", "c4e37bf0c3ff")
	a = newAsm()
	Rorx(a, r32(x64.R8), r32(x64.R9), x64.Imm(-1))
	e = gpCase(e, a, "rorx r8d, r9d, -1", "c4437bf0c1ff")
	a = newAsm()
	Rorx(a, r64(x64.R15), r64(x64.R14), x64.Imm(0x80))
	e = gpCase(e, a, "rorx r15, r14, 0x80", "c443fbf0fe80")
	a = newAsm()
	Sarx(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = gpCase(e, a, "sarx eax, ebx, ecx", "c4e272f7c3")
	a = newAsm()
	Sarx(a, r64(x64.R15), x64.Mem(x64.R13, 0, x64.SZ64), r64(x64.R14))
	e = gpCase(e, a, "sarx r15, qword ptr [r13], r14", "c4428af77d00")
	a = newAsm()
	Shlx(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), r64(x64.RCX))
	e = gpCase(e, a, "shlx rax, qword ptr [rbx], rcx", "c4e2f1f703")
	a = newAsm()
	Shrx(a, r32(x64.R8), r32(x64.R9), r32(x64.R10))
	e = gpCase(e, a, "shrx r8d, r9d, r10d", "c4422bf7c1")
	return e
}

// A `[rip + x]` operand's rel32 counts past RORX's imm8 (clang's x-0x5); a GOT slot's relocation
// is the plain GOTPCREL, as clang's; a symbolic count is an 8-bit absolute field.
func TestBmiSymbols() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.RipLabel("x"))
	e = fixCase(e, a, "andn eax, ebx, [rip + x]", "c4e260f20500000000", x64.FIX_REL32_LEA, 5, 0)
	a = newAsm()
	Shlx(a, r32(x64.RAX), x64.RipLabel("x"), r32(x64.R8))
	e = fixCase(e, a, "shlx eax, [rip + x], r8d", "c4e239f70500000000", x64.FIX_REL32_LEA, 5, 0)
	a = newAsm()
	Rorx(a, r32(x64.RAX), x64.RipLabel("x"), x64.Imm(1))
	e = fixCase(e, a, "rorx eax, [rip + x], 1", "c4e37bf0050000000001", x64.FIX_REL32_LEA, 5, -1)
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.RipGotLabel("x"))
	e = fixCase(e, a, "andn eax, ebx, [rip + x@GOTPCREL]", "c4e260f20500000000",
			x64.FIX_GOTPCREL_PLAIN, 5, 0)
	a = newAsm()
	Rorx(a, r32(x64.RAX), x64.RipGotLabel("x"), x64.Imm(3))
	e = fixCase(e, a, "rorx eax, [rip + x@GOTPCREL], 3", "c4e37bf0050000000003",
			x64.FIX_GOTPCREL_PLAIN, 5, -1)
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), x64.ImmSym("x", 0, 0))
	e = fixCase(e, a, "rorx eax, ebx, offset x", "c4e37bf0c300", asm.FIX_DATA_ABS8, 5, 0)
	return e
}

// Operands of the wrong kind or size, and counts out of an imm8's range.
func TestBmiRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Andn(a, r16(x64.RAX), r16(x64.RBX), r16(x64.RCX))
	e = rejectCase(e, a, "andn ax, bx, cx")
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), r64(x64.RCX))
	e = rejectCase(e, a, "andn eax, ebx, rcx")
	a = newAsm()
	Andn(a, r64(x64.RAX), r64(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "andn rax, rbx, ecx")
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(5))
	e = rejectCase(e, a, "andn eax, ebx, 5")
	a = newAsm()
	Andn(a, x64.Mem(x64.RAX, 0, x64.SZ32), r32(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "andn dword ptr [rax], ebx, ecx")
	a = newAsm()
	Andn(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32), r32(x64.RCX))
	e = rejectCase(e, a, "andn eax, dword ptr [rbx], ecx")
	a = newAsm()
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.Mem(x64.RCX, 0, x64.SZ64))
	e = rejectCase(e, a, "andn eax, ebx, qword ptr [rcx]")
	a = newAsm()
	Bextr(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), r32(x64.RCX))
	e = rejectCase(e, a, "bextr eax, qword ptr [rbx], ecx")
	a = newAsm()
	Blsi(a, r16(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "blsi ax, bx")
	a = newAsm()
	Blsr(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = rejectCase(e, a, "blsr eax, qword ptr [rbx]")
	a = newAsm()
	Mulx(a, r32(x64.RAX), r32(x64.RBX), x64.Mem(x64.RCX, 0, x64.SZ64))
	e = rejectCase(e, a, "mulx eax, ebx, qword ptr [rcx]")
	a = newAsm()
	Sarx(a, r64(x64.RAX), r64(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "sarx rax, rbx, ecx")
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), r32(x64.RCX))
	e = rejectCase(e, a, "rorx eax, ebx, ecx")
	a = newAsm()
	Rorx(a, r32(x64.RAX), x64.Imm(3), x64.Imm(3))
	e = rejectCase(e, a, "rorx eax, 3, 3")
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(256))
	e = rejectCase(e, a, "rorx eax, ebx, 256")
	a = newAsm()
	Rorx(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(-129))
	e = rejectCase(e, a, "rorx eax, ebx, -129")
	return e
}
