package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// ADX, MOVBE and CRC32: legacy-encoded instructions in the 0F 38 map, with mandatory prefixes.

// emit0F38 emits instruction 0F 38 op: 66 when p66, then legacy prefix pfx (0 for none), a REX
// (W when w, forced when force), the opcode, and the ModR/M of reg field reg and r/m operand rm.
func emit0F38(a @asm.Assembler, p66 bool, pfx int, w bool, force bool, op int, reg int,
		rm x64.Operand) {
	if p66 { emit8(a, 0x66) }
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, w, reg, rm, force)
	emit8(a, 0x0F)
	emit8(a, 0x38)
	emit8(a, op)
	x64.EmitModRM(a, reg, rm)
}

// emitAdx emits ADCX or ADOX (mnem) dst, src: prefix pfx, 0F 38 F6 /r.
func emitAdx(a @asm.Assembler, mnem *[]readonly char, pfx int, dst x64.Operand, src x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(src, size) {
		operandsError(a, mnem)
		return
	}
	emit0F38(a, false, pfx, size == x64.SZ64, false, 0xF6, dst.Reg, src)
}

// Adcx emits ADCX dst, src; see gpext.bni.
func Adcx(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitAdx(a, "adcx", 0x66, dst, src) }

// Adox emits ADOX dst, src; see gpext.bni.
func Adox(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitAdx(a, "adox", 0xF3, dst, src) }

// isMovbeReg reports whether op is a register MOVBE moves: 16, 32 or 64 bits.
func isMovbeReg(op x64.Operand) bool {
	return isReg(op, x64.SZ16) || isReg(op, x64.SZ32) || isReg(op, x64.SZ64)
}

// Movbe emits MOVBE dst, src; see gpext.bni.
func Movbe(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	if dst.Kind == x64.OP_REG && src.Kind == x64.OP_REG {
		x64.OperandError(a, "movbe", "register to register is APX's EVEX-encoded form, not supported")
		return
	}
	var reg x64.Operand = dst
	var mem x64.Operand = src
	var op int = 0xF0
	if x64.IsMem(dst) {
		reg = src
		mem = dst
		op = 0xF1
	}
	if !isMovbeReg(reg) || !x64.IsMem(mem) || (mem.Size != 0 && mem.Size != reg.Size) {
		x64.OperandError(a, "movbe", "takes a 16-, 32- or 64-bit register and memory of its size")
		return
	}
	emit0F38(a, reg.Size == x64.SZ16, 0, reg.Size == x64.SZ64, false, op, reg.Reg, mem)
}

// Crc32 emits CRC32 dst, src; see gpext.bni.
func Crc32(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	var size int = opSize(dst)
	var srcSize int = src.Size
	var ok bool = size != 0 &&
			(x64.IsMem(src) || (src.Kind == x64.OP_REG && src.Reg >= x64.RAX && src.Reg <= x64.R15))
	if ok && srcSize != x64.SZ8 {
		if size == x64.SZ32 {
			ok = srcSize == x64.SZ16 || srcSize == x64.SZ32
		} else {
			ok = srcSize == x64.SZ64
		}
	}
	if !ok {
		x64.OperandError(a, "crc32",
				"takes a 32-bit register and an 8-, 16- or 32-bit source, or a 64-bit register and an "
						"8- or 64-bit source (memory with its size)")
		return
	}
	var op int = 0xF1
	if srcSize == x64.SZ8 { op = 0xF0 }
	// SPL, BPL, SIL and DIL exist only beside a REX; without one, 4..7 are AH, CH, DH and BH.
	var force bool = src.Kind == x64.OP_REG && srcSize == x64.SZ8 && src.Reg >= 4 && src.Reg < 8
	emit0F38(a, srcSize == x64.SZ16, 0xF2, size == x64.SZ64, force, op, dst.Reg, src)
}
