package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// ADX, MOVBE and CRC32 against clang (see gpext_test.bn): the mandatory prefix before REX, 66
// before F2, REX for registers 8..15 and for SPL, BPL, SIL and DIL.

// ADCX and ADOX at 32 and 64 bits, from a register and from memory.
func TestAdx() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Adcx(a, r32(x64.RAX), r32(x64.RBX))
	e = gpCase(e, a, "adcx eax, ebx", "660f38f6c3")
	a = newAsm()
	Adcx(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = gpCase(e, a, "adcx rax, qword ptr [rbx]", "66480f38f603")
	a = newAsm()
	Adcx(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	e = gpCase(e, a, "adcx eax, [rbx]", "660f38f603")
	a = newAsm()
	Adcx(a, r32(x64.R15), x64.Mem(x64.R14, 0, x64.SZ32))
	e = gpCase(e, a, "adcx r15d, dword ptr [r14]", "66450f38f63e")
	a = newAsm()
	Adox(a, r64(x64.R8), r64(x64.R9))
	e = gpCase(e, a, "adox r8, r9", "f34d0f38f6c1")
	a = newAsm()
	Adox(a, r32(x64.RAX), x64.RipLabel("x"))
	e = fixCase(e, a, "adox eax, [rip + x]", "f30f38f60500000000", x64.FIX_REL32_LEA, 5, 0)
	a = newAsm()
	Adcx(a, r64(x64.RAX), x64.RipGotLabel("x"))
	e = fixCase(e, a, "adcx rax, [rip + x@GOTPCREL]", "66480f38f60500000000", x64.FIX_GOTPCREL_PLAIN,
			6, 0)
	return e
}

// MOVBE's loads and stores at 16, 32 and 64 bits, memory of size 0 and a SIB with REX.X and B.
func TestMovbe() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Movbe(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32))
	e = gpCase(e, a, "movbe eax, dword ptr [rbx]", "0f38f003")
	a = newAsm()
	Movbe(a, x64.Mem(x64.RBX, 0, x64.SZ64), r64(x64.RAX))
	e = gpCase(e, a, "movbe qword ptr [rbx], rax", "480f38f103")
	a = newAsm()
	Movbe(a, r16(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ16))
	e = gpCase(e, a, "movbe ax, word ptr [rbx]", "660f38f003")
	a = newAsm()
	Movbe(a, x64.Mem(x64.R9, 0, x64.SZ16), r16(x64.R8))
	e = gpCase(e, a, "movbe word ptr [r9], r8w", "66450f38f101")
	a = newAsm()
	Movbe(a, r64(x64.R8), x64.MemIdx(x64.R9, x64.R10, 1, 0, x64.SZ64))
	e = gpCase(e, a, "movbe r8, qword ptr [r9 + r10]", "4f0f38f00411")
	a = newAsm()
	Movbe(a, x64.Mem(x64.RBX, 0, 0), r32(x64.RAX))
	e = gpCase(e, a, "movbe [rbx], eax", "0f38f103")
	a = newAsm()
	Movbe(a, r16(x64.R15), x64.MemIdx(x64.R14, x64.R13, 2, 0x1000, x64.SZ16))
	e = gpCase(e, a, "movbe r15w, word ptr [r14 + r13*2 + 0x1000]", "66470f38f0bc6e00100000")
	return e
}

// CRC32 from each source size beside each destination size, registers and memory.
func TestCrc32() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Crc32(a, r32(x64.RAX), r8(x64.RBX))
	e = gpCase(e, a, "crc32 eax, bl", "f20f38f0c3")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r16(x64.RBX))
	e = gpCase(e, a, "crc32 eax, bx", "66f20f38f1c3")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r32(x64.RBX))
	e = gpCase(e, a, "crc32 eax, ebx", "f20f38f1c3")
	a = newAsm()
	Crc32(a, r64(x64.RAX), r8(x64.RBX))
	e = gpCase(e, a, "crc32 rax, bl", "f2480f38f0c3")
	a = newAsm()
	Crc32(a, r64(x64.RAX), r64(x64.RBX))
	e = gpCase(e, a, "crc32 rax, rbx", "f2480f38f1c3")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ8))
	e = gpCase(e, a, "crc32 eax, byte ptr [rbx]", "f20f38f003")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ16))
	e = gpCase(e, a, "crc32 eax, word ptr [rbx]", "66f20f38f103")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32))
	e = gpCase(e, a, "crc32 eax, dword ptr [rbx]", "f20f38f103")
	a = newAsm()
	Crc32(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = gpCase(e, a, "crc32 rax, qword ptr [rbx]", "f2480f38f103")
	a = newAsm()
	Crc32(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ8))
	e = gpCase(e, a, "crc32 rax, byte ptr [rbx]", "f2480f38f003")
	a = newAsm()
	Crc32(a, r32(x64.R8), r8(x64.RSI))
	e = gpCase(e, a, "crc32 r8d, sil", "f2440f38f0c6")
	a = newAsm()
	Crc32(a, r64(x64.R8), r64(x64.R9))
	e = gpCase(e, a, "crc32 r8, r9", "f24d0f38f1c1")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r8(x64.RSI))
	e = gpCase(e, a, "crc32 eax, sil", "f2400f38f0c6")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r8(x64.R8))
	e = gpCase(e, a, "crc32 eax, r8b", "f2410f38f0c0")
	a = newAsm()
	Crc32(a, r64(x64.RAX), r8(x64.RSP))
	e = gpCase(e, a, "crc32 rax, spl", "f2480f38f0c4")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r8(x64.RAX))
	e = gpCase(e, a, "crc32 eax, al", "f20f38f0c0")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r16(x64.R15))
	e = gpCase(e, a, "crc32 eax, r15w", "66f2410f38f1c7")
	a = newAsm()
	Crc32(a, r64(x64.R15), x64.MemIdx(x64.R14, x64.R13, 8, -8, x64.SZ64))
	e = gpCase(e, a, "crc32 r15, qword ptr [r14 + r13*8 - 8]", "f24f0f38f17ceef8")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.RipLabel("x"))
	e = rejectCase(e, a, "crc32 eax, [rip + x] (no size)")
	var rip x64.Operand = x64.RipLabel("x")
	rip.Size = x64.SZ8
	a = newAsm()
	Crc32(a, r32(x64.RAX), rip)
	e = fixCase(e, a, "crc32 eax, byte ptr [rip + x]", "f20f38f00500000000", x64.FIX_REL32_LEA, 5, 0)
	return e
}

// Operands of the wrong kind or size; MOVBE between registers (APX's EVEX form).
func TestLegacyRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Adcx(a, r16(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "adcx ax, bx")
	a = newAsm()
	Adcx(a, x64.Mem(x64.RBX, 0, x64.SZ32), r32(x64.RAX))
	e = rejectCase(e, a, "adcx dword ptr [rbx], eax")
	a = newAsm()
	Adcx(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32))
	e = rejectCase(e, a, "adcx rax, dword ptr [rbx]")
	a = newAsm()
	Adox(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = rejectCase(e, a, "adox eax, qword ptr [rbx]")
	a = newAsm()
	Movbe(a, r32(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "movbe eax, ebx")
	a = newAsm()
	Movbe(a, r8(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ8))
	e = rejectCase(e, a, "movbe al, byte ptr [rbx]")
	a = newAsm()
	Movbe(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32))
	e = rejectCase(e, a, "movbe rax, dword ptr [rbx]")
	a = newAsm()
	Movbe(a, x64.Mem(x64.RBX, 0, x64.SZ32), x64.Imm(5))
	e = rejectCase(e, a, "movbe dword ptr [rbx], 5")
	a = newAsm()
	Movbe(a, r32(x64.RAX), x64.Imm(5))
	e = rejectCase(e, a, "movbe eax, 5")
	a = newAsm()
	Movbe(a, x64.Mem(x64.RBX, 0, x64.SZ32), x64.Mem(x64.RCX, 0, x64.SZ32))
	e = rejectCase(e, a, "movbe dword ptr [rbx], dword ptr [rcx]")
	a = newAsm()
	Crc32(a, r16(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "crc32 ax, bx")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	e = rejectCase(e, a, "crc32 eax, [rbx]")
	a = newAsm()
	Crc32(a, r64(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "crc32 rax, ebx")
	a = newAsm()
	Crc32(a, r32(x64.RAX), r64(x64.RBX))
	e = rejectCase(e, a, "crc32 eax, rbx")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = rejectCase(e, a, "crc32 eax, qword ptr [rbx]")
	a = newAsm()
	Crc32(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ16))
	e = rejectCase(e, a, "crc32 rax, word ptr [rbx]")
	a = newAsm()
	Crc32(a, r64(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "crc32 rax, bx")
	a = newAsm()
	Crc32(a, r32(x64.RAX), x64.Imm(5))
	e = rejectCase(e, a, "crc32 eax, 5")
	a = newAsm()
	Crc32(a, x64.Mem(x64.RBX, 0, x64.SZ8), r8(x64.RAX))
	e = rejectCase(e, a, "crc32 byte ptr [rbx], al")
	return e
}

// MOVRS at each size, SPL..DIL's REX, R8..R15 in each field, memory of size 0; what clang rejects
// (a register source, a memory destination, memory of another size).
func TestMovrs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movrs(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ32))
	Movrs(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	Movrs(a, r16(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ16))
	Movrs(a, r8(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	Movrs(a, r8(x64.RSI), x64.Mem(x64.RBX, 0, 0))
	Movrs(a, r8(x64.R9), x64.Mem(x64.RBX, 0, 0))
	Movrs(a, r64(x64.R9), x64.Mem(x64.R10, 0, 0))
	var e @[]char = gpCase("", a, "movrs",
			"0f388b03 480f388b03 660f388b03 0f388a03 400f388a33 440f388a0b 4d0f388b0a")
	a = newAsm()
	Movrs(a, r32(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "movrs eax, ebx")
	a = newAsm()
	Movrs(a, x64.Mem(x64.RBX, 0, x64.SZ32), r32(x64.RAX))
	e = rejectCase(e, a, "movrs dword ptr [rbx], eax")
	a = newAsm()
	Movrs(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = rejectCase(e, a, "movrs eax, qword ptr [rbx]")
	return e
}

// The high-byte registers as CRC32's 8-bit source and MOVRS's 8-bit destination, against clang;
// beside a REX prefix (a 64-bit CRC32, an R8..R15 address) an error, as clang's.
func TestHighByteRegisters() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Crc32(a, r32(x64.RAX), x64.Reg(x64.AH, x64.SZ8))
	Movrs(a, x64.Reg(x64.AH, x64.SZ8), x64.Mem(x64.RBX, 0, 0))
	var e @[]char = gpCase("", a, "crc32 eax, ah / movrs ah, [rbx]", "f20f38f0c4 0f388a23")
	a = newAsm()
	Crc32(a, r64(x64.RAX), x64.Reg(x64.AH, x64.SZ8))
	if !a.HasError { e = buf.Concat(e, "crc32 rax, ah: no error; ") }
	a = newAsm()
	Movrs(a, x64.Reg(x64.BH, x64.SZ8), x64.Mem(x64.R8, 0, 0))
	if !a.HasError { e = buf.Concat(e, "movrs bh, [r8]: no error; ") }
	return e
}
