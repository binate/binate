package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// AMD's TBM instructions, XOP-encoded at length 0 with W the operand size.

// xopVM emits TBM instruction mnem dst, rm: opcode op in XOP map 9, dst in XOP.vvvv and the
// opcode extension ext in the ModR/M reg field.
func xopVM(a @asm.Assembler, mnem *[]readonly char, op int, ext int, dst x64.Operand,
		rm x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(rm, size) {
		operandsError(a, mnem)
		return
	}
	vex.EmitXop(a, vex.XOP_MAP9, size == x64.SZ64, 0, ext, dst.Reg, rm)
	emit8(a, op)
	x64.EmitModRM(a, ext, rm)
}

// bextrImm emits TBM's BEXTR dst, src, imm (XOP.0A 10 /r id); see Bextr.
func bextrImm(a @asm.Assembler, dst x64.Operand, src x64.Operand, imm x64.Operand) {
	var size int = opSize(dst)
	if size == 0 || !isRM(src, size) {
		operandsError(a, "bextr")
		return
	}
	if !x64.ImmOk(a, "bextr", imm, size) { return }
	vex.EmitXop(a, vex.XOP_MAPA, size == x64.SZ64, 0, dst.Reg, 0, src)
	emit8(a, 0x10)
	x64.EmitModRMImm(a, dst.Reg, src, 4)
	x64.EmitImm(a, "bextr", imm, size)
}

// Blcfill emits BLCFILL dst, src; see gpext.bni.
func Blcfill(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blcfill", 0x01, 1, dst, src)
}

// Blci emits BLCI dst, src; see gpext.bni.
func Blci(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blci", 0x02, 6, dst, src)
}

// Blcic emits BLCIC dst, src; see gpext.bni.
func Blcic(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blcic", 0x01, 5, dst, src)
}

// Blcmsk emits BLCMSK dst, src; see gpext.bni.
func Blcmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blcmsk", 0x02, 1, dst, src)
}

// Blcs emits BLCS dst, src; see gpext.bni.
func Blcs(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blcs", 0x01, 3, dst, src)
}

// Blsfill emits BLSFILL dst, src; see gpext.bni.
func Blsfill(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blsfill", 0x01, 2, dst, src)
}

// Blsic emits BLSIC dst, src; see gpext.bni.
func Blsic(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "blsic", 0x01, 6, dst, src)
}

// T1mskc emits T1MSKC dst, src; see gpext.bni.
func T1mskc(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "t1mskc", 0x01, 7, dst, src)
}

// Tzmsk emits TZMSK dst, src; see gpext.bni.
func Tzmsk(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	xopVM(a, "tzmsk", 0x01, 4, dst, src)
}
