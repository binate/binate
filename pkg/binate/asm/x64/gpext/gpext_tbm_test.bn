package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// TBM against clang (see gpext_test.bn).

// tbmFn is a TBM instruction's encoder, dst, src.
type tbmFn *func(@asm.Assembler, x64.Operand, x64.Operand)

// tbmCase adds name's failures to e: f's encodings of `name eax, ebx` (regs32), `name rax, qword
// ptr [rbx]` (mem64), `name r8, r9` (regs64) and `name r15d, dword ptr [r14 + r13*2]` (sib32)
// against clang's bytes.
func tbmCase(e @[]char, f tbmFn, name *[]readonly char, regs32 *[]readonly char,
		mem64 *[]readonly char, regs64 *[]readonly char, sib32 *[]readonly char) @[]char {
	var a @asm.Assembler = newAsm()
	f(a, r32(x64.RAX), r32(x64.RBX))
	e = gpCase(e, a, buf.Concat(name, " eax, ebx"), regs32)
	a = newAsm()
	f(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = gpCase(e, a, buf.Concat(name, " rax, qword ptr [rbx]"), mem64)
	a = newAsm()
	f(a, r64(x64.R8), r64(x64.R9))
	e = gpCase(e, a, buf.Concat(name, " r8, r9"), regs64)
	a = newAsm()
	f(a, r32(x64.R15), x64.MemIdx(x64.R14, x64.R13, 2, 0, x64.SZ32))
	e = gpCase(e, a, buf.Concat(name, " r15d, dword ptr [r14 + r13*2]"), sib32)
	return e
}

// The nine two-operand TBM instructions, each at both sizes, with registers 8..15 in every field.
func TestTbm() testing.TestResult {
	var e @[]char = ""
	e = tbmCase(e, Blcfill, "blcfill", "8fe97801cb", "8fe9f8010b", "8fc9b801c9", "8f8900010c6e")
	e = tbmCase(e, Blci, "blci", "8fe97802f3", "8fe9f80233", "8fc9b802f1", "8f890002346e")
	e = tbmCase(e, Blcic, "blcic", "8fe97801eb", "8fe9f8012b", "8fc9b801e9", "8f8900012c6e")
	e = tbmCase(e, Blcmsk, "blcmsk", "8fe97802cb", "8fe9f8020b", "8fc9b802c9", "8f8900020c6e")
	e = tbmCase(e, Blcs, "blcs", "8fe97801db", "8fe9f8011b", "8fc9b801d9", "8f8900011c6e")
	e = tbmCase(e, Blsfill, "blsfill", "8fe97801d3", "8fe9f80113", "8fc9b801d1", "8f890001146e")
	e = tbmCase(e, Blsic, "blsic", "8fe97801f3", "8fe9f80133", "8fc9b801f1", "8f890001346e")
	e = tbmCase(e, T1mskc, "t1mskc", "8fe97801fb", "8fe9f8013b", "8fc9b801f9", "8f8900013c6e")
	e = tbmCase(e, Tzmsk, "tzmsk", "8fe97801e3", "8fe9f80123", "8fc9b801e1", "8f890001246e")
	return e
}

// BEXTR with an immediate (TBM): the imm32's range at each size, a symbol's field and a `[rip +
// x]` operand's rel32 counting past the imm32 (clang's x-0x8).
func TestTbmBextr() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(0x1234))
	e = gpCase(e, a, "bextr eax, ebx, 0x1234", "8fea7810c334120000")
	a = newAsm()
	Bextr(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64), x64.Imm(0x12345678))
	e = gpCase(e, a, "bextr rax, qword ptr [rbx], 0x12345678", "8feaf8100378563412")
	a = newAsm()
	Bextr(a, r64(x64.R8), r64(x64.R9), x64.Imm(1))
	e = gpCase(e, a, "bextr r8, r9, 1", "8f4af810c101000000")
	a = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(-1))
	e = gpCase(e, a, "bextr eax, ebx, -1", "8fea7810c3ffffffff")
	a = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), x64.Imm64(0xffffffff))
	e = gpCase(e, a, "bextr eax, ebx, 0xffffffff", "8fea7810c3ffffffff")
	a = newAsm()
	Bextr(a, r64(x64.RAX), r64(x64.RBX), x64.Imm64(-0x80000000))
	e = gpCase(e, a, "bextr rax, rbx, -0x80000000", "8feaf810c300000080")
	a = newAsm()
	Bextr(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, 0), x64.Imm(5))
	e = gpCase(e, a, "bextr eax, [rbx], 5", "8fea78100305000000")
	a = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), x64.ImmSym("x", 0, 0))
	e = fixCase(e, a, "bextr eax, ebx, offset x", "8fea7810c300000000", asm.FIX_DATA_ABS32, 5, 0)
	a = newAsm()
	Bextr(a, r64(x64.RAX), r64(x64.RBX), x64.ImmSym("x", 4, 0))
	e = fixCase(e, a, "bextr rax, rbx, offset x + 4", "8feaf810c300000000", x64.FIX_ABS32S, 5, 4)
	a = newAsm()
	Bextr(a, r32(x64.RAX), x64.RipLabel("x"), x64.Imm(7))
	e = fixCase(e, a, "bextr eax, [rip + x], 7", "8fea7810050000000007000000", x64.FIX_REL32_LEA, 5,
			-4)
	a = newAsm()
	Bextr(a, r32(x64.RAX), x64.RipGotLabel("x"), x64.Imm(7))
	e = fixCase(e, a, "bextr eax, [rip + x@GOTPCREL], 7", "8fea7810050000000007000000",
			x64.FIX_GOTPCREL_PLAIN, 5, -4)
	a = newAsm()
	Blci(a, r32(x64.RAX), x64.RipLabel("x"))
	e = fixCase(e, a, "blci eax, [rip + x]", "8fe978023500000000", x64.FIX_REL32_LEA, 5, 0)
	return e
}

// Operands of the wrong kind or size, and immediates out of the imm32's range at each size.
func TestTbmRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Blci(a, r16(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "blci ax, bx")
	a = newAsm()
	Blci(a, r32(x64.RAX), r64(x64.RBX))
	e = rejectCase(e, a, "blci eax, rbx")
	a = newAsm()
	Tzmsk(a, r32(x64.RAX), x64.Imm(5))
	e = rejectCase(e, a, "tzmsk eax, 5")
	a = newAsm()
	Blcfill(a, x64.Mem(x64.RAX, 0, x64.SZ32), r32(x64.RBX))
	e = rejectCase(e, a, "blcfill dword ptr [rax], ebx")
	a = newAsm()
	Bextr(a, r32(x64.RAX), r32(x64.RBX), x64.Imm64(0x100000000))
	e = rejectCase(e, a, "bextr eax, ebx, 0x100000000")
	a = newAsm()
	Bextr(a, r64(x64.RAX), r64(x64.RBX), x64.Imm64(0xffffffff))
	e = rejectCase(e, a, "bextr rax, rbx, 0xffffffff")
	a = newAsm()
	Bextr(a, r64(x64.RAX), r32(x64.RBX), x64.Imm(1))
	e = rejectCase(e, a, "bextr rax, ebx, 1")
	return e
}
