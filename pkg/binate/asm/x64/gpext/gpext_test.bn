package "pkg/binate/asm/x64/gpext"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The general-purpose extensions against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`, `llvm-objdump -dr`).  A fixup's addend
// is the ELF R_X86_64_PC32 / GOTPCREL addend plus 4: the operand's addend less the size of any
// immediate after the rel32.

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// r8, r16, r32 and r64 return register r at 8, 16, 32 and 64 bits.
func r8(r int) x64.Operand { return x64.Reg(r, x64.SZ8) }

func r16(r int) x64.Operand { return x64.Reg(r, x64.SZ16) }

func r32(r int) x64.Operand { return x64.Reg(r, x64.SZ32) }

func r64(r int) x64.Operand { return x64.Reg(r, x64.SZ64) }

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// gpCase adds name to the failures e unless a holds exactly the bytes hex spells and no fixup.
func gpCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) && a.Sections[0].NumFixups == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// fixCase adds name to the failures e unless a holds exactly the bytes hex spells and one fixup,
// of kind kind at offset off against x with addend addend.
func fixCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char, kind int,
		off int, addend int64) @[]char {
	if emits(a, hex) && a.Sections[0].NumFixups == 1 {
		var fix asm.Fixup = a.Sections[0].Fixups[0]
		if fix.Kind == kind && cast(int, fix.Offset) == off && fix.Addend == addend &&
				len(fix.Label) == 1 && fix.Label[0] == 'x' {
			return e
		}
	}
	return buf.Concat(buf.Concat(e, name), ": wrong bytes, fixup or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// isReg, isRM and opSize: a register's size must match, memory's may be 0; only a 32- or 64-bit
// register sets the operand size.
func TestOperandShapes() testing.TestResult {
	if !isReg(r32(x64.R15), x64.SZ32) || isReg(r32(x64.RAX), x64.SZ64) ||
			isReg(x64.Reg(16, x64.SZ32), x64.SZ32) || isReg(x64.Imm(0), x64.SZ32) {
		return "isReg"
	}
	if !isRM(x64.Mem(x64.RAX, 0, 0), x64.SZ64) || !isRM(x64.Mem(x64.RAX, 0, x64.SZ64), x64.SZ64) ||
			isRM(x64.Mem(x64.RAX, 0, x64.SZ32), x64.SZ64) || !isRM(x64.RipLabel("x"), x64.SZ32) ||
			isRM(r16(x64.RAX), x64.SZ32) {
		return "isRM"
	}
	if opSize(r32(x64.RAX)) != x64.SZ32 || opSize(r64(x64.R9)) != x64.SZ64 ||
			opSize(r16(x64.RAX)) != 0 || opSize(x64.Mem(x64.RAX, 0, x64.SZ32)) != 0 {
		return "opSize"
	}
	return ""
}

// A lock prefix (x64.LockNext) before any of them is an error, nothing written: clang drops one
// before ANDN silently.
func TestLockRejected() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	x64.LockNext(a)
	Andn(a, r32(x64.RAX), r32(x64.RBX), x64.Mem(x64.RCX, 0, x64.SZ32))
	e = rejectCase(e, a, "lock andn")
	a = newAsm()
	x64.LockNext(a)
	Blcfill(a, r32(x64.RAX), x64.Mem(x64.RCX, 0, x64.SZ32))
	e = rejectCase(e, a, "lock blcfill")
	a = newAsm()
	x64.LockNext(a)
	Adcx(a, r32(x64.RAX), x64.Mem(x64.RCX, 0, x64.SZ32))
	e = rejectCase(e, a, "lock adcx")
	a = newAsm()
	x64.LockNext(a)
	Movbe(a, x64.Mem(x64.RCX, 0, x64.SZ64), r64(x64.RAX))
	e = rejectCase(e, a, "lock movbe")
	return e
}
