// Package optab provides what the x86-64 instruction tables (pkg/binate/asm/x64/sse's and
// pkg/binate/asm/x64/avx's) share: reading a table's text, a line per encoding form, each after a
// newline, its fields separated by single spaces (a part's lines of a mnemonic, a line's tokens and
// hex fields); and the operand classes of general registers, memory and immediates, which mean the
// same in every table.
package "pkg/binate/asm/x64/optab"

import "pkg/binate/asm/x64"

// Lower returns c in lower case.
func Lower(c char) char

// LineOf returns the position in table part t of the first line of mnem (just after its
// newline), matching it in any case, or -1.  A table's mnemonics are in lower case.
func LineOf(t *[]readonly char, mnem *[]readonly char) int

// SameMnem reports whether the line of table part t at at is mnem's (in any case).
func SameMnem(t *[]readonly char, at int, mnem *[]readonly char) bool

// NextLine returns the position of the line after the one at at.
func NextLine(t *[]readonly char, at int) int

// TokenEnd returns the end of the token of a line of t that starts at i: the next space or
// newline (or the end of t).
func TokenEnd(t *[]readonly char, i int) int

// TokenNum returns the number after a token's class letter (W128 gives 128), 0 for none.
func TokenNum(tok *[]readonly char) int

// HexVal returns the value of hex digit c (0-9, a-f), or -1.
func HexVal(c char) int

// IsGp reports whether op is a 32- or 64-bit general register.
func IsGp(op x64.Operand) bool

// SizedMem reports whether op is memory of size bits or of size 0.
func SizedMem(op x64.Operand, size int) bool

// GpClassOk reports whether op is of the general operand class c (a token of a line, size its
// number, if any):
//   G  a 32- or 64-bit general register (with a size, G32 or G64, only that one), in ModR/M's reg
//      field (REX.W at 64)
//   R  a 32- or 64-bit general register, in reg (without REX.W: a mask's or a lane's bits)
//   E  a 32- or 64-bit general register, or memory of 32 or 64 bits, in r/m (REX.W at 64)
//   D  a 32- or 64-bit general register (REX.W at 64), or memory of 32 bits or of size 0, in r/m
//   Y  a 64-bit general register (Y32: a 32-bit one), in r/m (REX.W at 64)
//   J  a 32- or 64-bit general register (without REX.W), or memory of size bits or of size 0, in
//      r/m
//   K  a 32-bit general register, or memory of size bits or of size 0, in r/m
//   L  a 64-bit general register, or memory of size bits or of size 0, in r/m (REX.W)
//   M  memory of size bits or of size 0, in r/m
//   A  memory of any size, in r/m (Key Locker's handle, as clang takes it)
//   I  an immediate, an imm8 after the operand
// and false for any other letter (a table's own classes).
func GpClassOk(c char, size int, op x64.Operand) bool

// GpInReg reports whether an operand of general class c goes in ModR/M's reg field: G and R.
func GpInReg(c char) bool

// GpRexW reports whether op, of general class c, sets REX.W (or VEX.W): L always, G, E, D and Y at
// 64 bits.
func GpRexW(c char, op x64.Operand) bool
