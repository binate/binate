package "pkg/binate/asm/x64/optab"

import "pkg/binate/asm/x64"

// The general operand classes the tables share: general registers, memory and immediates.

// IsGp reports whether op is a 32- or 64-bit general register; see optab.bni.
func IsGp(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 &&
			(op.Size == x64.SZ32 || op.Size == x64.SZ64)
}

// SizedMem reports whether op is memory of size bits or of size 0; see optab.bni.
func SizedMem(op x64.Operand, size int) bool {
	return x64.IsMem(op) && (op.Size == 0 || op.Size == size)
}

// GpClassOk reports whether op is of general class c; see optab.bni.
func GpClassOk(c char, size int, op x64.Operand) bool {
	if c == 'G' { return IsGp(op) && (size == 0 || op.Size == size) }
	if c == 'R' { return IsGp(op) }
	if c == 'E' { return IsGp(op) || (x64.IsMem(op) && (op.Size == x64.SZ32 || op.Size == x64.SZ64)) }
	if c == 'D' { return IsGp(op) || SizedMem(op, x64.SZ32) }
	if c == 'Y' && size == 0 { return IsGp(op) && op.Size == x64.SZ64 }
	if c == 'Y' { return IsGp(op) && op.Size == size }
	if c == 'J' { return IsGp(op) || SizedMem(op, size) }
	if c == 'K' { return (IsGp(op) && op.Size == x64.SZ32) || SizedMem(op, size) }
	if c == 'L' { return (IsGp(op) && op.Size == x64.SZ64) || SizedMem(op, size) }
	if c == 'M' { return SizedMem(op, size) }
	if c == 'A' { return x64.IsMem(op) }
	if c == 'I' { return op.Kind == x64.OP_IMM }
	return false
}

// GpInReg reports whether general class c goes in ModR/M's reg field; see optab.bni.
func GpInReg(c char) bool { return c == 'G' || c == 'R' }

// GpRexW reports whether op, of general class c, sets W; see optab.bni.
func GpRexW(c char, op x64.Operand) bool {
	if c == 'L' { return true }
	return (c == 'G' || c == 'E' || c == 'D' || c == 'Y') && op.Size == x64.SZ64
}
