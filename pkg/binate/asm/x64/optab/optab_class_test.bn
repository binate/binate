package "pkg/binate/asm/x64/optab"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The general operand classes (optab_class.bn): each class against registers of each size, memory
// of each size and none, and an immediate; where each goes, and which set W.

func TestGpClassOk() testing.TestResult {
	var eax x64.Operand = x64.Reg(x64.RAX, x64.SZ32)
	var rax x64.Operand = x64.Reg(x64.RAX, x64.SZ64)
	var ax x64.Operand = x64.Reg(x64.RAX, x64.SZ16)
	var m0 x64.Operand = x64.Mem(x64.RAX, 0, 0)
	var m16 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ16)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m64 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ64)
	var imm x64.Operand = x64.Imm(1)
	if !IsGp(eax) || !IsGp(rax) || IsGp(ax) || IsGp(m32) || IsGp(x64.Reg(x64.AH, x64.SZ8)) {
		return fail("IsGp")
	}
	if !SizedMem(m32, 32) || !SizedMem(m0, 32) || SizedMem(m64, 32) || SizedMem(eax, 32) {
		return fail("SizedMem")
	}
	if !GpClassOk('G', 0, eax) || !GpClassOk('R', 0, rax) || GpClassOk('G', 0, m32) {
		return fail("G / R")
	}
	if !GpClassOk('E', 0, rax) || !GpClassOk('E', 0, m32) || !GpClassOk('E', 0, m64) ||
			GpClassOk('E', 0, m0) || GpClassOk('E', 0, m16) {
		return fail("E")
	}
	if !GpClassOk('D', 0, eax) || !GpClassOk('D', 0, rax) || !GpClassOk('D', 0, m32) ||
			!GpClassOk('D', 0, m0) || GpClassOk('D', 0, m64) || GpClassOk('D', 0, ax) {
		return fail("D")
	}
	if !GpClassOk('Y', 0, rax) || GpClassOk('Y', 0, eax) || GpClassOk('Y', 0, m64) { return fail("Y") }
	if !GpClassOk('J', 16, eax) || !GpClassOk('J', 16, rax) || !GpClassOk('J', 16, m16) ||
			GpClassOk('J', 16, m32) {
		return fail("J")
	}
	if !GpClassOk('K', 32, eax) || GpClassOk('K', 32, rax) || !GpClassOk('K', 32, m32) ||
			GpClassOk('K', 32, m64) || !GpClassOk('K', 32, m0) {
		return fail("K")
	}
	if !GpClassOk('L', 64, rax) || GpClassOk('L', 64, eax) || !GpClassOk('L', 64, m64) ||
			GpClassOk('L', 64, m32) {
		return fail("L")
	}
	if !GpClassOk('M', 64, m64) || !GpClassOk('M', 64, m0) || GpClassOk('M', 64, m32) ||
			GpClassOk('M', 64, rax) {
		return fail("M")
	}
	if !GpClassOk('A', 0, m16) || !GpClassOk('A', 0, m0) || GpClassOk('A', 0, rax) { return fail("A") }
	if !GpClassOk('I', 0, imm) || GpClassOk('I', 0, eax) || GpClassOk('V', 0, eax) {
		return fail("I / not a general class")
	}
	return ""
}

func TestGpPlacement() testing.TestResult {
	var eax x64.Operand = x64.Reg(x64.RAX, x64.SZ32)
	var rax x64.Operand = x64.Reg(x64.RAX, x64.SZ64)
	if !GpInReg('G') || !GpInReg('R') || GpInReg('E') || GpInReg('I') { return fail("GpInReg") }
	if !GpRexW('G', rax) || GpRexW('G', eax) || GpRexW('R', rax) || !GpRexW('E', rax) ||
			!GpRexW('D', rax) || !GpRexW('Y', rax) || !GpRexW('L', eax) || GpRexW('J', rax) ||
			GpRexW('K', eax) {
		return fail("GpRexW")
	}
	return ""
}
