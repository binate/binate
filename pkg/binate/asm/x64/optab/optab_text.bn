package "pkg/binate/asm/x64/optab"

// Reading a table's text: its lines of a mnemonic, a line's tokens.

// Lower returns c in lower case; see optab.bni.
func Lower(c char) char {
	if c >= 'A' && c <= 'Z' { return c + ('a' - 'A') }
	return c
}

// LineOf returns the first line of mnem in t; see optab.bni.
func LineOf(t *[]readonly char, mnem *[]readonly char) int {
	var n int = len(mnem)
	if n == 0 { return -1 }
	for i := 0; i + n + 1 < len(t); i++ {
		if t[i] != '\n' || t[i + n + 1] != ' ' { continue }
		var k int = 0
		for k < n && Lower(mnem[k]) == t[i + 1 + k] { k++ }
		if k == n { return i + 1 }
	}
	return -1
}

// SameMnem reports whether the line at at is mnem's; see optab.bni.
func SameMnem(t *[]readonly char, at int, mnem *[]readonly char) bool {
	var n int = len(mnem)
	if at + n >= len(t) || t[at + n] != ' ' { return false }
	for k := 0; k < n; k++ {
		if Lower(mnem[k]) != t[at + k] { return false }
	}
	return true
}

// NextLine returns the line after at's; see optab.bni.
func NextLine(t *[]readonly char, at int) int {
	for at < len(t) && t[at] != '\n' { at++ }
	return at + 1
}

// TokenEnd returns the end of the token at i; see optab.bni.
func TokenEnd(t *[]readonly char, i int) int {
	for i < len(t) && t[i] != ' ' && t[i] != '\n' { i++ }
	return i
}

// TokenNum returns the number after a token's letter; see optab.bni.
func TokenNum(tok *[]readonly char) int {
	var v int = 0
	for i := 1; i < len(tok); i++ { v = v * 10 + cast(int, tok[i]) - cast(int, '0') }
	return v
}

// HexVal returns the value of hex digit c; see optab.bni.
func HexVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}
