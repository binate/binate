package "pkg/binate/asm/x64/optab"

import "pkg/builtins/testing"

// Reading a table's text (optab_text.bn) from a small part: a mnemonic's lines found in any case
// and only whole, tokens and their numbers, hex digits.

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// part is a table part of three lines, two of them addps'.
func part() *[]readonly char {
	return "\n"
			"addps - 0f 58 V W128\n"
			"addps - 0f 59 V W128\n"
			"addpd 66 0f 58 V W128\n"
}

func TestLineOf() testing.TestResult {
	var t *[]readonly char = part()
	if LineOf(t, "addps") != 1 || LineOf(t, "ADDPD") != 43 { return fail("LineOf: addps / ADDPD") }
	if LineOf(t, "add") != -1 || LineOf(t, "addpss") != -1 || LineOf(t, "") != -1 {
		return fail("LineOf: a prefix, a longer name, none")
	}
	if !SameMnem(t, 1, "AddPs") || SameMnem(t, 1, "addp") || SameMnem(t, 43, "addps") {
		return fail("SameMnem")
	}
	if NextLine(t, 1) != 22 || NextLine(t, 22) != 43 || NextLine(t, 43) != len(t) {
		return fail("NextLine")
	}
	if Lower('Q') != 'q' || Lower('q') != 'q' || Lower('5') != '5' { return fail("Lower") }
	return ""
}

func TestTokens() testing.TestResult {
	var t *[]readonly char = part()
	if TokenEnd(t, 1) != 6 || TokenEnd(t, 15) != 16 || TokenEnd(t, 17) != 21 ||
			TokenEnd(t, len(t)) != len(t) {
		return fail("TokenEnd")
	}
	if TokenNum("W128") != 128 || TokenNum("V") != 0 || TokenNum("M8") != 8 { return fail("TokenNum") }
	if HexVal('0') != 0 || HexVal('9') != 9 || HexVal('a') != 10 || HexVal('f') != 15 ||
			HexVal('g') != -1 || HexVal('A') != -1 {
		return fail("HexVal")
	}
	return ""
}
