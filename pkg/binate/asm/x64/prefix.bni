// Package prefix provides the x86-64 prefixes written as instructions of their own, beside the
// instructions of pkg/binate/asm/x64: a segment override (`fs`, and the `fs:` of an operand, which
// the text assembler emits as SegPrefix before its instruction), `data16`, `rex64`, `lock` and the
// lock-elision hints `xacquire` / `xrelease`, each its one byte where it is called.  (A lock the
// instruction's encoder places after its 0x66, as clang does, is x64.LockNext; the repeat prefixes
// are pkg/binate/asm/x64/strop's.)
package "pkg/binate/asm/x64/prefix"

import "pkg/binate/asm"

// The segment override prefixes (SegPrefix): es, cs, ss, ds, fs and gs.
const (
	SEG_ES int = 0x26
	SEG_CS int = 0x2E
	SEG_SS int = 0x36
	SEG_DS int = 0x3E
	SEG_FS int = 0x64
	SEG_GS int = 0x65
)

// SegPrefix emits the segment override prefix seg (SEG_*), which applies to the instruction
// after it: an operand's `fs:[...]` is SegPrefix then the instruction, its prefix first,
// before any 0x66 or REX, as clang emits it (`mov ax, word ptr fs:[rbx]` is 64 66 8B 03).
// Any other value sets an assembler error and emits nothing.
func SegPrefix(a @asm.Assembler, seg int)

// Data16 emits the operand-size prefix 0x66 alone (`data16`), as the general-dynamic
// sequence's padding writes it (`data16 lea rdi, [rip + x@TLSGD]`).
func Data16(a @asm.Assembler)

// Rex64 emits the REX.W prefix 0x48 alone (`rex64` with no instruction after it on its line: the
// text parser makes one before an instruction that instruction's REX.W, asm.Assembler.X64RexW).
func Rex64(a @asm.Assembler)

// Lock emits the lock prefix 0xF0, which makes the read-modify-write instruction after it atomic
// (`lock add qword ptr [rbx], 1`, `lock cmpxchg [rbx], rcx`), before any 0x66 the instruction
// has (x64.LockNext puts it after).  Which instructions may follow it is the text assembler's
// check, not this one's.
func Lock(a @asm.Assembler)

// Xacquire emits the hardware-lock-elision hint 0xF2 (`xacquire lock add [rbx], eax`).
func Xacquire(a @asm.Assembler)

// Xrelease emits the hardware-lock-elision hint 0xF3 (`xrelease lock add [rbx], eax`).
func Xrelease(a @asm.Assembler)
