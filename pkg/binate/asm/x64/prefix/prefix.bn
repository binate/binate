package "pkg/binate/asm/x64/prefix"

import "pkg/binate/asm"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// SegPrefix emits segment override prefix seg; see prefix.bni.
func SegPrefix(a @asm.Assembler, seg int) {
	if seg != SEG_ES && seg != SEG_CS && seg != SEG_SS && seg != SEG_DS && seg != SEG_FS &&
			seg != SEG_GS {
		a.SetError("x64: a segment override prefix is SEG_ES, SEG_CS, SEG_SS, SEG_DS, SEG_FS or SEG_GS")
		return
	}
	emit8(a, seg)
}

// Data16 emits the operand-size prefix 0x66; see prefix.bni.
func Data16(a @asm.Assembler) { emit8(a, 0x66) }

// Rex64 emits the REX.W prefix 0x48; see prefix.bni.
func Rex64(a @asm.Assembler) { emit8(a, 0x48) }

// Lock emits the lock prefix 0xF0; see prefix.bni.
func Lock(a @asm.Assembler) { emit8(a, 0xF0) }

// Xacquire emits the lock-elision hint 0xF2; see prefix.bni.
func Xacquire(a @asm.Assembler) { emit8(a, 0xF2) }

// Xrelease emits the lock-elision hint 0xF3; see prefix.bni.
func Xrelease(a @asm.Assembler) { emit8(a, 0xF3) }
