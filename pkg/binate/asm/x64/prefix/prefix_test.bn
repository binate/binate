package "pkg/binate/asm/x64/prefix"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The prefixes against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax
// noprefix`).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// Each prefix is one byte of its own: the six segment overrides (26 2E 36 3E 64 65), data16
// (66), rex64 (48), lock (F0), xacquire (F2) and xrelease (F3), as clang emits `es` .. `gs`,
// `data16`, `rex64`, `lock`, `xacquire` and `xrelease`.
func TestPrefixBytes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SegPrefix(a, SEG_ES)
	SegPrefix(a, SEG_CS)
	SegPrefix(a, SEG_SS)
	SegPrefix(a, SEG_DS)
	SegPrefix(a, SEG_FS)
	SegPrefix(a, SEG_GS)
	Data16(a)
	Rex64(a)
	Lock(a)
	Xacquire(a)
	Xrelease(a)
	if !emits(a, "26 2e 36 3e 64 65 66 48 f0 f2 f3") { return "a prefix is not clang's byte" }
	return ""
}

// A segment override goes before the instruction's own prefixes: `mov ax, word ptr fs:[rbx]`
// is 64 66 8B 03 and `mov r8w, word ptr fs:[r9]` 64 66 45 8B 01, as clang emits them.
func TestSegPrefixBeforeOperandSize() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SegPrefix(a, SEG_FS)
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ16), x64.Mem(x64.RBX, 0, x64.SZ16))
	SegPrefix(a, SEG_FS)
	x64.Mov(a, x64.Reg(x64.R8, x64.SZ16), x64.Mem(x64.R9, 0, x64.SZ16))
	if !emits(a, "64 66 8b 03 64 66 45 8b 01") { return "fs: is not before 0x66 and REX" }
	return ""
}

// A value that is no segment override prefix is an error that emits nothing: a segment
// register's number, another prefix byte.
func TestSegPrefixRejects() testing.TestResult {
	var bad @[]int = @[]int{0, 4, 5, 0x66, 0x48, 0xF0, -1}
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		SegPrefix(a, bad[i])
		if !a.HasError || a.Sections[0].Len != 0 {
			return "a value that is no segment override was taken"
		}
	}
	return ""
}
