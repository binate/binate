// Package sse provides the x86-64 SSE instruction encoders (SSE through SSE4.1, legacy encoding):
// scalar and packed floating-point arithmetic, conversions and compares, packed integer and
// bitwise operations, 128-bit and eightbyte moves between XMM registers and memory or GP
// registers, and shuffles — beside the general-purpose instructions of pkg/binate/asm/x64, whose
// memory operands (x64.Operand) and encoding support (x64.EmitRex, x64.EmitModRM) they use.
package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// 128-bit SSE/AVX registers (XMM0-XMM15).  Held in a disjoint namespace
// from GP regs (offset by 32) so callers can't pass a GP where an XMM
// is expected; the encoders mask with 0xf before emitting.  The offset
// must be a multiple of 16 so n & 0xf yields the bare reg number.
const (
	XMM0 int = iota + 32
	XMM1
	XMM2
	XMM3
	XMM4
	XMM5
	XMM6
	XMM7
	XMM8
	XMM9
	XMM10
	XMM11
	XMM12
	XMM13
	XMM14
	XMM15
)

// --- SSE2 scalar floating-point ---
//
// XMM operands take XMM register numbers (XMM0..XMM15); GP operands take GP
// register numbers (RAX..R15).

// Movq_gp_to_xmm emits `movq xmm, gp` — load the full 64-bit value
// from a GP register into the low quadword of xmm (high quadword
// zeroed).  Used to bring a spilled float bit-pattern into an XMM
// scratch.  Encoding: 66 REX.W 0F 6E /r.
func Movq_gp_to_xmm(a @asm.Assembler, xmm int, gp int)

// Movq_xmm_to_gp emits `movq gp, xmm` — store the low quadword of
// xmm into a 64-bit GP register.  Mirror of Movq_gp_to_xmm.
// Encoding: 66 REX.W 0F 7E /r.
func Movq_xmm_to_gp(a @asm.Assembler, gp int, xmm int)

// Movd_gp_to_xmm emits `movd xmm, gp32` — load 32 bits from a GP
// register into the low dword of xmm (upper 96 bits zeroed).  Used
// for float32 transit.  Encoding: 66 0F 6E /r (no REX.W).
func Movd_gp_to_xmm(a @asm.Assembler, xmm int, gp int)

// Movd_xmm_to_gp emits `movd gp32, xmm` — store the low dword of
// xmm into a 32-bit GP register.  Encoding: 66 0F 7E /r.
func Movd_xmm_to_gp(a @asm.Assembler, gp int, xmm int)

// SSE memory forms (Movlps_*, Movups_*, Movss_* here; Movdqu_* / Movdqa_*
// below): `mem` must be a memory operand (OP_MEM or a RipLabel).  A register
// would select the opcode's register form, a different instruction or none
// (0F 12 is MOVHLPS, 0F 13 has none), and any other kind has no encoding
// here; each sets an assembler error and emits nothing.

// Movlps_load / Movlps_store move an 8-byte SSE eightbyte (packed 2xf32 or a
// lone f64) between an XMM low quadword and a memory image (SysV aggregate
// pass/return).  Encodings: 0F 12 /r (load), 0F 13 /r (store).
func Movlps_load(a @asm.Assembler, xmm int, mem x64.Operand)

func Movlps_store(a @asm.Assembler, mem x64.Operand, xmm int)

// Movups_load / Movups_store move a full (unaligned) 16-byte SSE register
// between an XMM and a memory image — two words per instruction, for aggregate
// copies.  Encodings: 0F 10 /r (load), 0F 11 /r (store); the address need not be
// 16-byte aligned.
func Movups_load(a @asm.Assembler, xmm int, mem x64.Operand)

func Movups_store(a @asm.Assembler, mem x64.Operand, xmm int)

// Movss_load / Movss_store move a 4-byte lone-f32 eightbyte between an XMM low
// dword and a memory image.  Encodings: F3 0F 10 /r (load), F3 0F 11 /r (store).
func Movss_load(a @asm.Assembler, xmm int, mem x64.Operand)

func Movss_store(a @asm.Assembler, mem x64.Operand, xmm int)

// Addsd emits `addsd xmm_dst, xmm_src` (double-precision scalar add).
// Encoding: F2 0F 58 /r.
func Addsd(a @asm.Assembler, dst int, src int)

// Subsd emits `subsd xmm_dst, xmm_src`.  Encoding: F2 0F 5C /r.
func Subsd(a @asm.Assembler, dst int, src int)

// Mulsd emits `mulsd xmm_dst, xmm_src`.  Encoding: F2 0F 59 /r.
func Mulsd(a @asm.Assembler, dst int, src int)

// Divsd emits `divsd xmm_dst, xmm_src`.  Encoding: F2 0F 5E /r.
func Divsd(a @asm.Assembler, dst int, src int)

// Addss / Subss / Mulss / Divss: single-precision (float32) scalar
// arithmetic — the double opcodes with the F3 prefix instead of F2.
func Addss(a @asm.Assembler, dst int, src int)

func Subss(a @asm.Assembler, dst int, src int)

func Mulss(a @asm.Assembler, dst int, src int)

func Divss(a @asm.Assembler, dst int, src int)

// Cvtsi2sd emits `cvtsi2sd xmm_dst, gp64` — convert a signed 64-bit
// integer to a double-precision float.  Encoding: F2 REX.W 0F 2A /r.
func Cvtsi2sd(a @asm.Assembler, xmm int, gp int)

// Cvttsd2si emits `cvttsd2si gp64, xmm_src` — convert a double to
// a signed 64-bit integer with truncation (round-toward-zero).
// Encoding: F2 REX.W 0F 2C /r.
func Cvttsd2si(a @asm.Assembler, gp int, xmm int)

// Cvtss2sd emits `cvtss2sd xmm_dst, xmm_src` — widen float32 (low
// dword) to float64.  Encoding: F3 0F 5A /r.
func Cvtss2sd(a @asm.Assembler, dst int, src int)

// Cvtsd2ss emits `cvtsd2ss xmm_dst, xmm_src` — narrow float64 to
// float32 (low dword).  Encoding: F2 0F 5A /r.
func Cvtsd2ss(a @asm.Assembler, dst int, src int)

// Movapd emits `movapd xmm_dst, xmm_src` — register-register move
// of a packed double (used here to copy whole 128 bits between XMM
// scratches; same bit-level effect as MOVSD for our usage).
// Encoding: 66 0F 28 /r.
func Movapd(a @asm.Assembler, dst int, src int)

// Ucomisd emits `ucomisd xmm_lhs, xmm_rhs` — unordered scalar-double
// compare.  Sets EFLAGS: CF=1 iff lhs < rhs OR unordered; ZF=1 iff
// lhs == rhs OR unordered; PF=1 iff unordered (NaN operand).
// Encoding: 66 0F 2E /r.
func Ucomisd(a @asm.Assembler, lhs int, rhs int)

// Ucomiss is the single-precision (float32) sibling of Ucomisd — same
// EFLAGS semantics, encoding 0F 2E /r (no mandatory prefix).
func Ucomiss(a @asm.Assembler, lhs int, rhs int)

// --- SSE2 packed integer + bitwise (reg-reg; dst is also first source) ---
// All operate lane-wise on the full 128-bit XMM registers.

// Paddb/Paddw/Paddd/Paddq: packed integer add over 8/16/32/64-bit lanes.
func Paddb(a @asm.Assembler, dst int, src int)

func Paddw(a @asm.Assembler, dst int, src int)

func Paddd(a @asm.Assembler, dst int, src int)

func Paddq(a @asm.Assembler, dst int, src int)

// Psubb/Psubw/Psubd/Psubq: packed integer subtract over 8/16/32/64-bit lanes.
func Psubb(a @asm.Assembler, dst int, src int)

func Psubw(a @asm.Assembler, dst int, src int)

func Psubd(a @asm.Assembler, dst int, src int)

func Psubq(a @asm.Assembler, dst int, src int)

// Pmullw: packed 16-bit multiply (low halves).  Pmulld: packed 32-bit multiply
// (low halves; SSE4.1).
func Pmullw(a @asm.Assembler, dst int, src int)

func Pmulld(a @asm.Assembler, dst int, src int)

// Pand/Por/Pxor/Pandn: whole-register bitwise AND/OR/XOR/AND-NOT (dst = ~dst &
// src for Pandn).  Pxor(x, x) zeroes a register.
func Pand(a @asm.Assembler, dst int, src int)

func Por(a @asm.Assembler, dst int, src int)

func Pxor(a @asm.Assembler, dst int, src int)

func Pandn(a @asm.Assembler, dst int, src int)

// --- SSE/SSE2 packed floating-point (reg-reg; dst is also first source) ---
// …PS forms take no prefix (f32 lanes); …PD forms take 0x66
// (f64 lanes).

// Addps/Addpd/Subps/Subpd/Mulps/Mulpd/Divps/Divpd: packed FP arithmetic.
func Addps(a @asm.Assembler, dst int, src int)

func Addpd(a @asm.Assembler, dst int, src int)

func Subps(a @asm.Assembler, dst int, src int)

func Subpd(a @asm.Assembler, dst int, src int)

func Mulps(a @asm.Assembler, dst int, src int)

func Mulpd(a @asm.Assembler, dst int, src int)

func Divps(a @asm.Assembler, dst int, src int)

func Divpd(a @asm.Assembler, dst int, src int)

// Minps/Minpd/Maxps/Maxpd: packed FP min/max.  Sqrtps/Sqrtpd: packed FP sqrt
// (dst = sqrt(src)).
func Minps(a @asm.Assembler, dst int, src int)

func Minpd(a @asm.Assembler, dst int, src int)

func Maxps(a @asm.Assembler, dst int, src int)

func Maxpd(a @asm.Assembler, dst int, src int)

func Sqrtps(a @asm.Assembler, dst int, src int)

func Sqrtpd(a @asm.Assembler, dst int, src int)

// Packed-compare predicates (the imm8 of CMPPS/CMPPD).
const (
	CMPP_EQ int = iota // equal (ordered, non-signalling)
	CMPP_LT            // less-than (ordered, signalling)
	CMPP_LE            // less-or-equal (ordered, signalling)
	CMPP_UNORD         // unordered
	CMPP_NEQ           // not-equal (unordered, non-signalling)
	CMPP_NLT           // not-less-than (unordered, signalling)
	CMPP_NLE           // not-less-or-equal (unordered, signalling)
	CMPP_ORD           // ordered
)

// Cmpps/Cmppd: packed FP compare; `pred` (CMPP_*) selects the comparison and
// each lane becomes all-ones/all-zeros.  The legacy-SSE encoding reads only
// imm8[2:0], so a pred outside CMPP_EQ..CMPP_ORD (0..7) sets an assembler
// error and emits nothing.
func Cmpps(a @asm.Assembler, dst int, src int, pred int)

func Cmppd(a @asm.Assembler, dst int, src int, pred int)

// Andps/Andpd/Andnps/Andnpd/Orps/Orpd/Xorps/Xorpd: FP-domain bitwise (AND,
// AND-NOT = ~dst & src, OR, XOR).
func Andps(a @asm.Assembler, dst int, src int)

func Andpd(a @asm.Assembler, dst int, src int)

func Andnps(a @asm.Assembler, dst int, src int)

func Andnpd(a @asm.Assembler, dst int, src int)

func Orps(a @asm.Assembler, dst int, src int)

func Orpd(a @asm.Assembler, dst int, src int)

func Xorps(a @asm.Assembler, dst int, src int)

func Xorpd(a @asm.Assembler, dst int, src int)

// --- SSE2 packed 128-bit moves ---

// Movdqu/Movdqa/Movaps: 128-bit register copy (unaligned int / aligned int /
// packed FP).
func Movdqu(a @asm.Assembler, dst int, src int)

func Movdqa(a @asm.Assembler, dst int, src int)

func Movaps(a @asm.Assembler, dst int, src int)

// Movdqu_load/Movdqu_store: unaligned 128-bit load/store to/from memory.  For
// these and Movdqa_*, `mem` must be a memory operand (see the SSE memory forms
// note above).
func Movdqu_load(a @asm.Assembler, xmm int, mem x64.Operand)

func Movdqu_store(a @asm.Assembler, mem x64.Operand, xmm int)

// Movdqa_load/Movdqa_store: 16-byte-aligned 128-bit load/store.
func Movdqa_load(a @asm.Assembler, xmm int, mem x64.Operand)

func Movdqa_store(a @asm.Assembler, mem x64.Operand, xmm int)

// --- SSE shuffle / broadcast / interleave ---

// Pshufd: shuffle/broadcast the 4 dwords per imm8 (imm8=0 broadcasts lane 0).
// For Pshufd/Shufps/Shufpd, imm8 is in -128..255; an out-of-range control
// sets an assembler error and emits nothing.
func Pshufd(a @asm.Assembler, dst int, src int, imm8 int)

// Shufps/Shufpd: packed FP shuffle per imm8.
func Shufps(a @asm.Assembler, dst int, src int, imm8 int)

func Shufpd(a @asm.Assembler, dst int, src int, imm8 int)

// Movddup: broadcast src's low f64 to both lanes.
func Movddup(a @asm.Assembler, dst int, src int)

// Punpckldq/Punpckhdq/Punpcklqdq/Punpckhqdq: interleave low/high dword/qword lanes.
func Punpckldq(a @asm.Assembler, dst int, src int)

func Punpckhdq(a @asm.Assembler, dst int, src int)

func Punpcklqdq(a @asm.Assembler, dst int, src int)

func Punpckhqdq(a @asm.Assembler, dst int, src int)

// Unpcklps/Unpckhps/Unpcklpd/Unpckhpd: interleave low/high f32/f64 lanes.
func Unpcklps(a @asm.Assembler, dst int, src int)

func Unpckhps(a @asm.Assembler, dst int, src int)

func Unpcklpd(a @asm.Assembler, dst int, src int)

func Unpckhpd(a @asm.Assembler, dst int, src int)

// Pshufb: arbitrary byte shuffle of dst per src's index bytes (SSSE3).
func Pshufb(a @asm.Assembler, dst int, src int)
