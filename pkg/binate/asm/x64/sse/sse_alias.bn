package "pkg/binate/asm/x64/sse"

// The names that stand for an instruction of the table with a fixed immediate: the compare
// predicates' (cmpeqps .. cmpordsd, cmpps .. cmpsd with the predicate's number) and CLMUL's
// (pclmullqlqdq .. pclmulhqhqdq, pclmulqdq with the halves' selector).

// predicates is the compare predicates' list: the predicate cmp<pred>ps .. names is its number
// modulo 8 (clang's second spellings, eq_oq .. ord_q, follow the first eight).
func predicates() *[]readonly char {
	return " eq lt le unord neq nlt nle ord eq_oq lt_os le_os unord_q neq_uq nlt_us nle_us ord_q "
}

// predAlias returns the instruction a compare predicate's name (cmpeqps .. cmpordsd) stands for —
// cmpps, cmpss, cmppd or cmpsd — and its predicate's number, or "" and -1 for another name.
func predAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var n int = len(mnem)
	if n < 7 || lower(mnem[0]) != 'c' || lower(mnem[1]) != 'm' || lower(mnem[2]) != 'p' {
		return "", -1
	}
	var s0 char = lower(mnem[n - 2])
	var s1 char = lower(mnem[n - 1])
	var base *[]readonly char = ""
	if s0 == 'p' && s1 == 's' { base = "cmpps" }
	if s0 == 's' && s1 == 's' { base = "cmpss" }
	if s0 == 'p' && s1 == 'd' { base = "cmppd" }
	if s0 == 's' && s1 == 'd' { base = "cmpsd" }
	if len(base) == 0 { return "", -1 }
	var pred *[]readonly char = mnem[3:n - 2]
	var list *[]readonly char = predicates()
	var idx int = 0
	var start int = 1
	for i := 1; i < len(list); i++ {
		if list[i] != ' ' { continue }
		var word *[]readonly char = list[start:i]
		if len(word) == len(pred) {
			var k int = 0
			for k < len(pred) && lower(pred[k]) == word[k] { k++ }
			if k == len(pred) { return base, idx % 8 }
		}
		idx++
		start = i + 1
	}
	return "", -1
}

// pclmulAlias returns pclmulqdq and the selector a CLMUL name (pclmullqlqdq, pclmulhqlqdq,
// pclmullqhqdq, pclmulhqhqdq) stands for — bit 0 the first source's quadword, bit 4 the
// second's — or "" and -1 for another name.
func pclmulAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var names *[]readonly char = " pclmullqlqdq pclmulhqlqdq pclmullqhqdq pclmulhqhqdq "
	var n int = len(mnem)
	if n != 12 { return "", -1 }
	var k int = 0
	for i := 1; i + n < len(names); i = i + n + 1 {
		var j int = 0
		for j < n && lower(mnem[j]) == names[i + j] { j++ }
		if j == n {
			if k == 0 { return "pclmulqdq", 0x00 }
			if k == 1 { return "pclmulqdq", 0x01 }
			if k == 2 { return "pclmulqdq", 0x10 }
			return "pclmulqdq", 0x11
		}
		k++
	}
	return "", -1
}

// aliasOf returns the instruction of the table the name mnem stands for and its immediate
// (predAlias, pclmulAlias), or "" and -1 for another name.
func aliasOf(mnem *[]readonly char) (*[]readonly char, int) {
	base, imm := predAlias(mnem)
	if imm >= 0 { return base, imm }
	return pclmulAlias(mnem)
}
