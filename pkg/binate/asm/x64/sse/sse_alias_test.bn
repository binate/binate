package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The names with a fixed immediate (sse_alias.bn): CLMUL's selectors against clang's bytes, in any
// case; other names are not; and the alias takes two operands only.
func TestPclmulAlias() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("pclmullqlqdq", 2, Xmm(0), Xmm(1), none, "66 0f 3a 44 c1 00") { return fail("lqlq") }
	if !emitCase("pclmulhqlqdq", 2, Xmm(9), Xmm(9), none, "66 45 0f 3a 44 c9 01") {
		return fail("hqlq")
	}
	if !emitCase("PCLMULLQHQDQ", 2, Xmm(0), Xmm(1), none, "66 0f 3a 44 c1 10") { return fail("lqhq") }
	if !emitCase("pclmulhqhqdq", 2, Xmm(0), x64.Mem(x64.RAX, 0, 0), none, "66 0f 3a 44 00 11") {
		return fail("hqhq [rax]")
	}
	_, imm := aliasOf("pclmulqqdq")
	_, near := aliasOf("pclmulxqlqdq")
	if imm >= 0 || near >= 0 || !Has("pclmulhqhqdq") { return fail("aliasOf / Has") }
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "pclmullqlqdq", 3, Xmm(0), Xmm(1), x64.Imm(0))
	if !rejected(a) { return fail("pclmullqlqdq with an immediate: not rejected") }
	return ""
}

// The predicates' names: cmpps .. cmpsd with the predicate's number as the immediate, two operands
// only.
func TestPredicates() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("cmpeqps", 2, Xmm(0), Xmm(1), none, "0f c2 c1 00") { return fail("cmpeqps") }
	if !emitCase("cmpltss", 2, Xmm(0), Xmm(1), none, "f3 0f c2 c1 01") { return fail("cmpltss") }
	if !emitCase("CMPNEQPD", 2, Xmm(0), Xmm(1), none, "66 0f c2 c1 04") { return fail("cmpneqpd") }
	if !emitCase("cmpordsd", 2, Xmm(0), Xmm(1), none, "f2 0f c2 c1 07") { return fail("cmpordsd") }
	if !emitCase("cmpeq_oqps", 2, Xmm(0), Xmm(1), none, "0f c2 c1 00") { return fail("cmpeq_oqps") }
	if !emitCase("cmpunord_qss", 2, Xmm(0), Xmm(1), none, "f3 0f c2 c1 03") {
		return fail("cmpunord_qss")
	}
	if !emitCase("cmpord_qpd", 2, Xmm(9), Xmm(1), none, "66 44 0f c2 c9 07") {
		return fail("cmpord_qpd")
	}
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "cmpeqps", 3, Xmm(0), Xmm(1), x64.Imm(0))
	if !rejected(a) { return fail("cmpeqps with an immediate: not rejected") }
	// An error names the mnemonic as written.
	a = newAsm()
	_ = Emit(a, "cmpltsd", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ32), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: cmpltsd: takes other operands") {
		return fail("cmpltsd xmm0, dword ptr [rax]: not an error naming cmpltsd")
	}
	return ""
}
