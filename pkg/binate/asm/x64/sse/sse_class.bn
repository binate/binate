package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm/x64"

// The instruction table's operand classes (sse_table.bn): what an operand of each class may be,
// and where the encoding puts it.

// Xmm returns XMMi; see sse.bni.
func Xmm(i int) x64.Operand {
	// Past 15 or below 0, a register no encoder takes (-1).
	if i < 0 || i > 15 { return x64.Reg(-1, x64.SZ128) }
	return x64.Reg(XMM0 + i, x64.SZ128)
}

// IsXmm reports whether op is XMM0..XMM15; see sse.bni.
func IsXmm(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= XMM0 && op.Reg <= XMM15 && op.Size == x64.SZ128
}

// Mm returns MMi; see sse.bni.
func Mm(i int) x64.Operand {
	// Past 7 or below 0, a register no encoder takes (-1).
	if i < 0 || i > 7 { return x64.Reg(-1, x64.SZ64) }
	return x64.Reg(MM0 + i, x64.SZ64)
}

// IsMm reports whether op is MM0..MM7; see sse.bni.
func IsMm(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= MM0 && op.Reg <= MM7 && op.Size == x64.SZ64
}

// isGp reports whether op is a 32- or 64-bit general register.
func isGp(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 &&
			(op.Size == x64.SZ32 || op.Size == x64.SZ64)
}

// sizedMem reports whether op is memory of size bits or of size 0.
func sizedMem(op x64.Operand, size int) bool {
	return x64.IsMem(op) && (op.Size == 0 || op.Size == size)
}

// classOk reports whether op is of the table's operand class c (a token of a line, size its
// number, if any):
//   V  an XMM register, in ModR/M's reg field
//   U  an XMM register, in r/m
//   W  an XMM register, or memory of size bits or of size 0, in r/m
//   P  an MMX register, in reg
//   N  an MMX register, in r/m
//   Q  an MMX register, or memory of size bits or of size 0, in r/m
//   M  memory of size bits or of size 0, in r/m
//   A  memory of any size, in r/m (Key Locker's handle, as clang takes it)
//   G  a 32- or 64-bit general register, in reg (REX.W at 64)
//   R  a 32- or 64-bit general register, in reg (without REX.W: a mask's or a lane's bits)
//   E  a 32- or 64-bit general register, or memory of 32 or 64 bits, in r/m (REX.W at 64)
//   D  a 32- or 64-bit general register (REX.W at 64), or memory of 32 bits or of size 0, in r/m
//   Y  a 64-bit general register, in r/m (REX.W)
//   J  a 32- or 64-bit general register (without REX.W), or memory of size bits or of size 0, in
//      r/m
//   K  a 32-bit general register, or memory of size bits or of size 0, in r/m
//   L  a 64-bit general register, or memory of size bits or of size 0, in r/m (REX.W)
//   Z  XMM0, written as the implied operand it is (the variable blends'), encoded nowhere
//   I  an immediate, an imm8 after the operand (a line may end in two: SSE4a's)
func classOk(c char, size int, op x64.Operand) bool {
	if c == 'V' || c == 'U' { return IsXmm(op) }
	if c == 'W' { return IsXmm(op) || sizedMem(op, size) }
	if c == 'P' || c == 'N' { return IsMm(op) }
	if c == 'Q' { return IsMm(op) || sizedMem(op, size) }
	if c == 'M' { return sizedMem(op, size) }
	if c == 'A' { return x64.IsMem(op) }
	if c == 'G' || c == 'R' { return isGp(op) }
	if c == 'E' { return isGp(op) || (x64.IsMem(op) && (op.Size == x64.SZ32 || op.Size == x64.SZ64)) }
	if c == 'D' { return isGp(op) || sizedMem(op, x64.SZ32) }
	if c == 'Y' { return isGp(op) && op.Size == x64.SZ64 }
	if c == 'J' { return isGp(op) || sizedMem(op, size) }
	if c == 'K' { return (isGp(op) && op.Size == x64.SZ32) || sizedMem(op, size) }
	if c == 'L' { return (isGp(op) && op.Size == x64.SZ64) || sizedMem(op, size) }
	if c == 'Z' { return IsXmm(op) && op.Reg == XMM0 }
	if c == 'I' { return op.Kind == x64.OP_IMM }
	return false
}

// inReg reports whether an operand of class c goes in ModR/M's reg field (I goes after ModR/M, Z
// nowhere, any other in r/m).
func inReg(c char) bool { return c == 'V' || c == 'P' || c == 'G' || c == 'R' }

// regField returns the reg field of op, of class c (inReg): its register's number in the field.
func regField(c char, op x64.Operand) int {
	if c == 'V' { return op.Reg - XMM0 }
	if c == 'P' { return op.Reg - MM0 }
	return op.Reg
}

// rmOperand returns op, an r/m operand, as the encoding takes it: an XMM or MMX register's number
// as the field holds it, any other operand as it is.
func rmOperand(op x64.Operand) x64.Operand {
	var b x64.Operand = op
	if IsXmm(op) { b.Reg = op.Reg - XMM0 }
	if IsMm(op) { b.Reg = op.Reg - MM0 }
	return b
}

// rexW reports whether op, of class c, sets REX.W: Y and L always, G, E and D at 64 bits.
func rexW(c char, op x64.Operand) bool {
	if c == 'Y' || c == 'L' { return true }
	return (c == 'G' || c == 'E' || c == 'D') && op.Size == x64.SZ64
}
