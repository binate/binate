package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The operand classes (sse_class.bn): the register operands, what each class takes, where it goes,
// and which set REX.W.

func TestRegisterOperands() testing.TestResult {
	if !IsXmm(Xmm(0)) || !IsXmm(Xmm(15)) || IsXmm(Xmm(16)) || IsXmm(Mm(0)) { return fail("IsXmm") }
	if !IsMm(Mm(0)) || !IsMm(Mm(7)) || IsMm(Mm(8)) || IsMm(Mm(-1)) || IsMm(Xmm(0)) {
		return fail("IsMm")
	}
	if IsMm(x64.Reg(x64.RAX, x64.SZ64)) || IsMm(x64.Reg(MM0, x64.SZ32)) {
		return fail("IsMm: not MMX")
	}
	return ""
}

func TestClassOk() testing.TestResult {
	var eax x64.Operand = x64.Reg(x64.RAX, x64.SZ32)
	var rax x64.Operand = x64.Reg(x64.RAX, x64.SZ64)
	var ax x64.Operand = x64.Reg(x64.RAX, x64.SZ16)
	var m0 x64.Operand = x64.Mem(x64.RAX, 0, 0)
	var m16 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ16)
	var m32 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ32)
	var m64 x64.Operand = x64.Mem(x64.RAX, 0, x64.SZ64)
	if !classOk('P', 0, Mm(3)) || classOk('P', 0, Xmm(3)) || classOk('N', 0, m64) {
		return fail("P / N")
	}
	if !classOk('Q', 64, Mm(3)) || !classOk('Q', 64, m64) || !classOk('Q', 32, m0) ||
			classOk('Q', 32, m64) {
		return fail("Q")
	}
	if !classOk('D', 0, eax) || !classOk('D', 0, rax) || !classOk('D', 0, m32) ||
			!classOk('D', 0, m0) || classOk('D', 0, m64) || classOk('D', 0, ax) {
		return fail("D")
	}
	if !classOk('Y', 0, rax) || classOk('Y', 0, eax) || classOk('Y', 0, m64) { return fail("Y") }
	if !classOk('J', 16, eax) || !classOk('J', 16, rax) || !classOk('J', 16, m16) ||
			classOk('J', 16, m32) {
		return fail("J")
	}
	if !classOk('K', 32, eax) || classOk('K', 32, rax) || !classOk('K', 32, m32) ||
			classOk('K', 32, m64) || !classOk('K', 32, m0) {
		return fail("K")
	}
	if !classOk('L', 64, rax) || classOk('L', 64, eax) || !classOk('L', 64, m64) ||
			!classOk('L', 64, m0) {
		return fail("L")
	}
	if !classOk('Z', 0, Xmm(0)) || classOk('Z', 0, Xmm(1)) || classOk('Z', 0, Xmm(8)) ||
			classOk('Z', 0, m0) || inReg('Z') {
		return fail("Z")
	}
	if inReg('K') || inReg('L') { return fail("inReg: K / L") }
	if !classOk('A', 0, m64) || !classOk('A', 0, m0) || classOk('A', 0, rax) || inReg('A') ||
			rexW('A', m64) {
		return fail("A")
	}
	if !rexW('L', m64) || rexW('K', eax) { return fail("rexW: K / L") }
	if !inReg('V') || !inReg('P') || !inReg('R') || inReg('U') || inReg('N') || inReg('J') {
		return fail("inReg")
	}
	if regField('P', Mm(5)) != 5 || regField('V', Xmm(12)) != 12 { return fail("regField") }
	if rmOperand(Mm(6)).Reg != 6 || rmOperand(Xmm(14)).Reg != 14 || rmOperand(rax).Reg != x64.RAX {
		return fail("rmOperand")
	}
	if !rexW('Y', rax) || !rexW('D', rax) || rexW('D', eax) || rexW('J', rax) || rexW('R', rax) ||
			!rexW('E', m64) || rexW('Q', m64) {
		return fail("rexW")
	}
	return ""
}
