package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The table's encoder: a mnemonic's lines (sse_table.bn) are matched against the operands in turn,
// and the first that matches is encoded: [prefix] [REX] 0F [38 / 3A] opcode ModR/M [a 3DNow!
// suffix | imm8 [imm8]], each operand where its class puts it (sse_class.bn).

// lower returns c in lower case.
func lower(c char) char {
	if c >= 'A' && c <= 'Z' { return c + ('a' - 'A') }
	return c
}

// lineOf returns the position in table part t of the first line of mnem (just after its
// newline), matching it in any case, or -1.
func lineOf(t *[]readonly char, mnem *[]readonly char) int {
	var n int = len(mnem)
	if n == 0 { return -1 }
	for i := 0; i + n + 1 < len(t); i++ {
		if t[i] != '\n' || t[i + n + 1] != ' ' { continue }
		var k int = 0
		for k < n && lower(mnem[k]) == t[i + 1 + k] { k++ }
		if k == n { return i + 1 }
	}
	return -1
}

// Has reports whether the table has mnem; see sse.bni.
func Has(mnem *[]readonly char) bool {
	_, at := tableOf(mnem)
	if at >= 0 { return true }
	_, imm := aliasOf(mnem)
	return imm >= 0
}

// opList is an instruction's operands, n of them (0..4), in Intel order.
type opList struct {
	n  int
	o1 x64.Operand
	o2 x64.Operand
	o3 x64.Operand
	o4 x64.Operand
}

// opAt returns operand k (0..3) of ops.
func opAt(ops opList, k int) x64.Operand {
	if k == 0 { return ops.o1 }
	if k == 1 { return ops.o2 }
	if k == 2 { return ops.o3 }
	return ops.o4
}

// hexVal returns the value of hex digit c, or -1.
func hexVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// tokenEnd returns the end of the token of line text t that starts at i: the next space or
// newline.
func tokenEnd(t *[]readonly char, i int) int {
	for i < len(t) && t[i] != ' ' && t[i] != '\n' { i++ }
	return i
}

// tokenNum returns the number after a token's class letter (W128 → 128), 0 for none.
func tokenNum(tok *[]readonly char) int {
	var v int = 0
	for i := 1; i < len(tok); i++ { v = v * 10 + cast(int, tok[i]) - cast(int, '0') }
	return v
}

// rowMatches reports whether the operands ops match the operand classes of a line, from field
// (its first class): ops.n of them, one each.
func rowMatches(t *[]readonly char, field int, ops opList) bool {
	var k int = 0
	var i int = field
	for i < len(t) && t[i] != '\n' {
		var end int = tokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= ops.n || !classOk(tok[0], tokenNum(tok), opAt(ops, k)) { return false }
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return k == ops.n
}

// sameMnem reports whether the line of table t at at is mnem's (in any case).
func sameMnem(t *[]readonly char, at int, mnem *[]readonly char) bool {
	var n int = len(mnem)
	if at + n >= len(t) || t[at + n] != ' ' { return false }
	for k := 0; k < n; k++ {
		if lower(mnem[k]) != t[at + k] { return false }
	}
	return true
}

// nextLine returns the position of the line after the one at at.
func nextLine(t *[]readonly char, at int) int {
	for at < len(t) && t[at] != '\n' { at++ }
	return at + 1
}

// row is a line's fixed fields: its prefix byte (0 for none), its map's second escape byte (0 for
// 0F alone, 0x38 or 0x3A), its opcode, the opcode's extension in ModR/M's reg field (written 71/6;
// -1 for none), a 3DNow! opcode, the byte after the operand (ModR/M, SIB, displacement; written
// 0f.9e; -1 for none), and the position of its first operand class.
type row struct {
	pfx   int
	esc   int
	op    int
	ext   int
	suf   int
	field int
}

// rowAt reads the fixed fields of the line at at.
func rowAt(t *[]readonly char, at int) row {
	var r row
	var i int = tokenEnd(t, at) + 1
	var end int = tokenEnd(t, i)
	if end - i == 2 { r.pfx = hexVal(t[i]) * 16 + hexVal(t[i + 1]) }
	i = end + 1
	end = tokenEnd(t, i)
	if t[i] == '3' { r.esc = hexVal(t[i]) * 16 + hexVal(t[i + 1]) }
	i = end + 1
	end = tokenEnd(t, i)
	r.op = hexVal(t[i]) * 16 + hexVal(t[i + 1])
	r.ext = -1
	r.suf = -1
	if end - i == 4 && t[i + 2] == '/' { r.ext = hexVal(t[i + 3]) }
	if end - i == 5 && t[i + 2] == '.' { r.suf = hexVal(t[i + 3]) * 16 + hexVal(t[i + 4]) }
	r.field = end + 1
	return r
}

// unsizedForE reports whether the operands ops would match a line's classes (from field, its
// first) but that its E class stands at memory of no size: the operand is ambiguous, dword or
// qword.
func unsizedForE(t *[]readonly char, field int, ops opList) bool {
	var unsized bool = false
	var k int = 0
	var i int = field
	for i < len(t) && t[i] != '\n' {
		var end int = tokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= ops.n { return false }
		var o x64.Operand = opAt(ops, k)
		if tok[0] == 'E' && x64.IsMem(o) && o.Size == 0 {
			unsized = true
		} else if !classOk(tok[0], tokenNum(tok), o) {
			return false
		}
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return unsized && k == ops.n
}

// Emit emits mnem with its n operands; see sse.bni.
func Emit(a @asm.Assembler, mnem *[]readonly char, n int, op1 x64.Operand, op2 x64.Operand,
		op3 x64.Operand) bool {
	if n > 3 {
		if !Has(mnem) { return false }
		x64.OperandError(a, mnem, "Emit takes up to three operands (Emit4 four)")
		return true
	}
	return Emit4(a, mnem, n, op1, op2, op3, x64.Imm(0))
}

// Emit4 emits mnem with its n operands; see sse.bni.
func Emit4(a @asm.Assembler, mnem *[]readonly char, n int, op1 x64.Operand, op2 x64.Operand,
		op3 x64.Operand, op4 x64.Operand) bool {
	var ops opList
	ops.n = n
	ops.o1 = op1
	ops.o2 = op2
	ops.o3 = op3
	ops.o4 = op4
	t, at := tableOf(mnem)
	if at >= 0 {
		emitLines(a, mnem, mnem, t, at, ops)
		return true
	}
	base, imm := aliasOf(mnem)
	if imm < 0 { return false }
	if n != 2 {
		x64.OperandError(a, mnem, "takes two operands (its name holds the immediate)")
		return true
	}
	t, at = tableOf(base)
	ops.n = 3
	ops.o3 = x64.Imm(imm)
	emitLines(a, mnem, base, t, at, ops)
	return true
}

// emitLines emits the first of name's lines (from at, in table part t) the operands ops match, or
// sets an error naming mnem, the mnemonic as written.
func emitLines(a @asm.Assembler, mnem *[]readonly char, name *[]readonly char, t *[]readonly char,
		at int, ops opList) {
	var ambiguous bool = false
	for at < len(t) && sameMnem(t, at, name) {
		var r row = rowAt(t, at)
		if rowMatches(t, r.field, ops) {
			encodeRow(a, mnem, t, r, ops)
			return
		}
		if unsizedForE(t, r.field, ops) { ambiguous = true }
		at = nextLine(t, at)
	}
	if ambiguous {
		x64.OperandError(a, mnem, "ambiguous operand size (write dword or qword ptr)")
	} else {
		x64.OperandError(a, mnem, "takes other operands")
	}
}

// encodeRow emits mnem by its line r: [pfx] [REX] 0F [esc] op ModR/M [suffix | imm8 [imm8]], the
// operands ops placed by their classes, r's extension (unless -1) in ModR/M's reg field.
func encodeRow(a @asm.Assembler, mnem *[]readonly char, t *[]readonly char, r row, ops opList) {
	var reg int = r.ext
	var rm x64.Operand = x64.Imm(0)
	var imm1 x64.Operand = x64.Imm(0)
	var imm2 x64.Operand = x64.Imm(0)
	var imms int = 0
	var w bool = false
	var k int = 0
	var i int = r.field
	for i < len(t) && t[i] != '\n' {
		var c char = t[i]
		var o x64.Operand = opAt(ops, k)
		if rexW(c, o) { w = true }
		if c == 'I' {
			if imms == 0 { imm1 = o } else { imm2 = o }
			imms++
		} else if inReg(c) {
			reg = regField(c, o)
		} else if c != 'Z' {
			rm = rmOperand(o)
		}
		k++
		i = tokenEnd(t, i)
		if i < len(t) && t[i] == ' ' { i++ }
	}
	if imms > 0 && !x64.ImmOk(a, mnem, imm1, x64.SZ8) { return }
	if imms > 1 && !x64.ImmOk(a, mnem, imm2, x64.SZ8) { return }
	if r.pfx != 0 { emit8(a, r.pfx) }
	x64.EmitRexRM(a, w, reg, rm, false)
	emit8(a, 0x0F)
	if r.esc != 0 { emit8(a, r.esc) }
	emit8(a, r.op)
	if r.suf >= 0 {
		x64.EmitModRMImm(a, reg, rm, 1)
		emit8(a, r.suf)
	} else if imms > 0 {
		x64.EmitModRMImm(a, reg, rm, imms)
		x64.EmitImm(a, mnem, imm1, x64.SZ8)
		if imms > 1 { x64.EmitImm(a, mnem, imm2, x64.SZ8) }
	} else {
		x64.EmitModRM(a, reg, rm)
	}
}
