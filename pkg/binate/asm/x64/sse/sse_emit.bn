package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The table's encoder: a mnemonic's lines (sse_table.bn) are matched against the operands in turn,
// and the first that matches is encoded: [prefix] [REX] 0F [38 / 3A] opcode ModR/M [imm8].

// Xmm returns XMMi; see sse.bni.
func Xmm(i int) x64.Operand {
	// Past 15 or below 0, a register no encoder takes (-1).
	if i < 0 || i > 15 { return x64.Reg(-1, x64.SZ128) }
	return x64.Reg(XMM0 + i, x64.SZ128)
}

// IsXmm reports whether op is XMM0..XMM15; see sse.bni.
func IsXmm(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= XMM0 && op.Reg <= XMM15 && op.Size == x64.SZ128
}

// lower returns c in lower case.
func lower(c char) char {
	if c >= 'A' && c <= 'Z' { return c + ('a' - 'A') }
	return c
}

// lineOf returns the position in table part t of the first line of mnem (just after its
// newline), matching it in any case, or -1.
func lineOf(t *[]readonly char, mnem *[]readonly char) int {
	var n int = len(mnem)
	if n == 0 { return -1 }
	for i := 0; i + n + 1 < len(t); i++ {
		if t[i] != '\n' || t[i + n + 1] != ' ' { continue }
		var k int = 0
		for k < n && lower(mnem[k]) == t[i + 1 + k] { k++ }
		if k == n { return i + 1 }
	}
	return -1
}

// predicates is the compare predicates' list: the predicate cmp<pred>ps .. names is its number
// modulo 8 (clang's second spellings, eq_oq .. ord_q, follow the first eight).
func predicates() *[]readonly char {
	return " eq lt le unord neq nlt nle ord eq_oq lt_os le_os unord_q neq_uq nlt_us nle_us ord_q "
}

// predAlias returns the instruction a compare predicate's name (cmpeqps .. cmpordsd) stands for —
// cmpps, cmpss, cmppd or cmpsd — and its predicate's number, or "" and -1 for another name.
func predAlias(mnem *[]readonly char) (*[]readonly char, int) {
	var n int = len(mnem)
	if n < 7 || lower(mnem[0]) != 'c' || lower(mnem[1]) != 'm' || lower(mnem[2]) != 'p' {
		return "", -1
	}
	var s0 char = lower(mnem[n - 2])
	var s1 char = lower(mnem[n - 1])
	var base *[]readonly char = ""
	if s0 == 'p' && s1 == 's' { base = "cmpps" }
	if s0 == 's' && s1 == 's' { base = "cmpss" }
	if s0 == 'p' && s1 == 'd' { base = "cmppd" }
	if s0 == 's' && s1 == 'd' { base = "cmpsd" }
	if len(base) == 0 { return "", -1 }
	var pred *[]readonly char = mnem[3:n - 2]
	var list *[]readonly char = predicates()
	var idx int = 0
	var start int = 1
	for i := 1; i < len(list); i++ {
		if list[i] != ' ' { continue }
		var word *[]readonly char = list[start:i]
		if len(word) == len(pred) {
			var k int = 0
			for k < len(pred) && lower(pred[k]) == word[k] { k++ }
			if k == len(pred) { return base, idx % 8 }
		}
		idx++
		start = i + 1
	}
	return "", -1
}

// Has reports whether the table has mnem; see sse.bni.
func Has(mnem *[]readonly char) bool {
	_, at := tableOf(mnem)
	if at >= 0 { return true }
	_, pred := predAlias(mnem)
	return pred >= 0
}

// opAt returns operand k (0..2) of op1, op2 and op3.
func opAt(k int, op1 x64.Operand, op2 x64.Operand, op3 x64.Operand) x64.Operand {
	if k == 0 { return op1 }
	if k == 1 { return op2 }
	return op3
}

// isGp reports whether op is a 32- or 64-bit general register.
func isGp(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 &&
			(op.Size == x64.SZ32 || op.Size == x64.SZ64)
}

// sizedMem reports whether op is memory of size bits or of size 0.
func sizedMem(op x64.Operand, size int) bool {
	return x64.IsMem(op) && (op.Size == 0 || op.Size == size)
}

// classOk reports whether op is of the table's operand class c (a token of a line, size its
// number, if any):
//   V  an XMM register, in ModR/M's reg field
//   U  an XMM register, in r/m
//   W  an XMM register, or memory of size bits or of size 0, in r/m
//   M  memory of size bits or of size 0, in r/m
//   G  a 32- or 64-bit general register, in reg (REX.W at 64)
//   R  a 32- or 64-bit general register, in reg (without REX.W: an XMM mask's low bits)
//   E  a 32- or 64-bit general register, or memory of 32 or 64 bits, in r/m (REX.W at 64)
//   I  an immediate, the trailing imm8
func classOk(c char, size int, op x64.Operand) bool {
	if c == 'V' || c == 'U' { return IsXmm(op) }
	if c == 'W' { return IsXmm(op) || sizedMem(op, size) }
	if c == 'M' { return sizedMem(op, size) }
	if c == 'G' || c == 'R' { return isGp(op) }
	if c == 'E' { return isGp(op) || (x64.IsMem(op) && (op.Size == x64.SZ32 || op.Size == x64.SZ64)) }
	if c == 'I' { return op.Kind == x64.OP_IMM }
	return false
}

// hexVal returns the value of hex digit c, or -1.
func hexVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// tokenEnd returns the end of the token of line text t that starts at i: the next space or
// newline.
func tokenEnd(t *[]readonly char, i int) int {
	for i < len(t) && t[i] != ' ' && t[i] != '\n' { i++ }
	return i
}

// tokenNum returns the number after a token's class letter (W128 → 128), 0 for none.
func tokenNum(tok *[]readonly char) int {
	var v int = 0
	for i := 1; i < len(tok); i++ { v = v * 10 + cast(int, tok[i]) - cast(int, '0') }
	return v
}

// rowMatches reports whether the operands match the operand classes of a line, from field (its
// first class): n of them, one each.
func rowMatches(t *[]readonly char, field int, n int, op1 x64.Operand, op2 x64.Operand,
		op3 x64.Operand) bool {
	var k int = 0
	var i int = field
	for i < len(t) && t[i] != '\n' {
		var end int = tokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= n || !classOk(tok[0], tokenNum(tok), opAt(k, op1, op2, op3)) { return false }
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return k == n
}

// sameMnem reports whether the line of table t at at is mnem's (in any case).
func sameMnem(t *[]readonly char, at int, mnem *[]readonly char) bool {
	var n int = len(mnem)
	if at + n >= len(t) || t[at + n] != ' ' { return false }
	for k := 0; k < n; k++ {
		if lower(mnem[k]) != t[at + k] { return false }
	}
	return true
}

// nextLine returns the position of the line after the one at at.
func nextLine(t *[]readonly char, at int) int {
	for at < len(t) && t[at] != '\n' { at++ }
	return at + 1
}

// rowAt reads the fixed fields of the line at at: its prefix byte (0 for none), its map's second
// escape byte (0 for 0F alone, 0x38 or 0x3A), its opcode, and the position of its first operand
// class.
func rowAt(t *[]readonly char, at int) (int, int, int, int) {
	var i int = tokenEnd(t, at) + 1
	var end int = tokenEnd(t, i)
	var pfx int = 0
	if end - i == 2 { pfx = hexVal(t[i]) * 16 + hexVal(t[i + 1]) }
	i = end + 1
	end = tokenEnd(t, i)
	var esc int = 0
	if t[i] == '3' { esc = hexVal(t[i]) * 16 + hexVal(t[i + 1]) }
	i = end + 1
	end = tokenEnd(t, i)
	var op int = hexVal(t[i]) * 16 + hexVal(t[i + 1])
	return pfx, esc, op, end + 1
}

// unsizedForE reports whether the n operands would match a line's classes (from field, its first)
// but that its E class stands at memory of no size: the operand is ambiguous, dword or qword.
func unsizedForE(t *[]readonly char, field int, n int, op1 x64.Operand, op2 x64.Operand,
		op3 x64.Operand) bool {
	var unsized bool = false
	var k int = 0
	var i int = field
	for i < len(t) && t[i] != '\n' {
		var end int = tokenEnd(t, i)
		var tok *[]readonly char = t[i:end]
		if k >= n { return false }
		var o x64.Operand = opAt(k, op1, op2, op3)
		if tok[0] == 'E' && x64.IsMem(o) && o.Size == 0 {
			unsized = true
		} else if !classOk(tok[0], tokenNum(tok), o) {
			return false
		}
		k++
		i = end
		if i < len(t) && t[i] == ' ' { i++ }
	}
	return unsized && k == n
}

// bare returns op with an XMM register's number as the encoding fields hold it (0..15), any other
// operand as it is.
func bare(op x64.Operand) x64.Operand {
	if !IsXmm(op) { return op }
	var b x64.Operand = op
	b.Reg = op.Reg - XMM0
	return b
}

// Emit emits mnem with its n operands; see sse.bni.
func Emit(a @asm.Assembler, mnem *[]readonly char, n int, op1 x64.Operand, op2 x64.Operand,
		op3 x64.Operand) bool {
	t, at := tableOf(mnem)
	if at >= 0 {
		emitLines(a, mnem, mnem, t, at, n, op1, op2, op3)
		return true
	}
	base, pred := predAlias(mnem)
	if pred < 0 { return false }
	if n != 2 {
		x64.OperandError(a, mnem, "takes two operands (its name holds the predicate)")
		return true
	}
	t, at = tableOf(base)
	emitLines(a, mnem, base, t, at, 3, op1, op2, x64.Imm(pred))
	return true
}

// emitLines emits the first of name's lines (from at, in table part t) the n operands match, or
// sets an error naming mnem, the mnemonic as written.
func emitLines(a @asm.Assembler, mnem *[]readonly char, name *[]readonly char, t *[]readonly char,
		at int, n int, op1 x64.Operand, op2 x64.Operand, op3 x64.Operand) {
	var ambiguous bool = false
	for at < len(t) && sameMnem(t, at, name) {
		pfx, esc, op, field := rowAt(t, at)
		if rowMatches(t, field, n, op1, op2, op3) {
			encodeRow(a, mnem, t, field, pfx, esc, op, op1, op2, op3)
			return
		}
		if unsizedForE(t, field, n, op1, op2, op3) { ambiguous = true }
		at = nextLine(t, at)
	}
	if ambiguous {
		x64.OperandError(a, mnem, "ambiguous operand size (write dword or qword ptr)")
	} else {
		x64.OperandError(a, mnem, "takes other operands")
	}
}

// encodeRow emits mnem by its line (from field, the line's first operand class): [pfx] [REX] 0F
// [esc] op ModR/M [imm8], the operands placed by their classes.
func encodeRow(a @asm.Assembler, mnem *[]readonly char, t *[]readonly char, field int, pfx int,
		esc int, op int, op1 x64.Operand, op2 x64.Operand, op3 x64.Operand) {
	var reg int = 0
	var rm x64.Operand = x64.Imm(0)
	var imm x64.Operand = x64.Imm(0)
	var hasImm bool = false
	var w bool = false
	var k int = 0
	var i int = field
	for i < len(t) && t[i] != '\n' {
		var c char = t[i]
		var o x64.Operand = opAt(k, op1, op2, op3)
		if c == 'V' { reg = o.Reg - XMM0 }
		if c == 'G' || c == 'R' { reg = o.Reg }
		if c == 'G' && o.Size == x64.SZ64 { w = true }
		if c == 'U' || c == 'W' || c == 'M' { rm = bare(o) }
		if c == 'E' { rm = o }
		if c == 'E' && o.Size == x64.SZ64 { w = true }
		if c == 'I' {
			imm = o
			hasImm = true
		}
		k++
		i = tokenEnd(t, i)
		if i < len(t) && t[i] == ' ' { i++ }
	}
	if hasImm && !x64.ImmOk(a, mnem, imm, x64.SZ8) { return }
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, w, reg, rm, false)
	emit8(a, 0x0F)
	if esc != 0 { emit8(a, esc) }
	emit8(a, op)
	if hasImm {
		x64.EmitModRMImm(a, reg, rm, 1)
		x64.EmitImm(a, mnem, imm, x64.SZ8)
	} else {
		x64.EmitModRM(a, reg, rm)
	}
}
