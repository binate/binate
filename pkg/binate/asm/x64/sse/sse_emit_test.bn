package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The table's encoder (sse_emit.bn): the names it has, the compare predicates' names, the operands
// no encoding fits.

// Has: the table's names in any case, the predicates' names; others not.
func TestHas() testing.TestResult {
	if !Has("addps") || !Has("MOVAPS.S") || !Has("cmpeqps") || !Has("CMPORDSD") ||
			!Has("cmpeq_oqps") || !Has("CMPNLE_USSD") {
		return fail("Has: a name")
	}
	if Has("cmptrueps") || Has("cmpeq_uqps") || Has("cmplt_oqps") || Has("cmpeq_ps") || Has("mov") ||
			Has("addp") || Has("") || Has("cmpps.s") {
		return fail("Has: not a name")
	}
	if IsXmm(Xmm(16)) || IsXmm(Xmm(-1)) || !IsXmm(Xmm(15)) || IsXmm(x64.Reg(x64.RAX, x64.SZ128)) {
		return fail("IsXmm")
	}
	return ""
}

// The predicates' names: cmpps .. cmpsd with the predicate's number as the immediate, two operands
// only.
func TestPredicates() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	if !emitCase("cmpeqps", 2, Xmm(0), Xmm(1), none, "0f c2 c1 00") { return fail("cmpeqps") }
	if !emitCase("cmpltss", 2, Xmm(0), Xmm(1), none, "f3 0f c2 c1 01") { return fail("cmpltss") }
	if !emitCase("CMPNEQPD", 2, Xmm(0), Xmm(1), none, "66 0f c2 c1 04") { return fail("cmpneqpd") }
	if !emitCase("cmpordsd", 2, Xmm(0), Xmm(1), none, "f2 0f c2 c1 07") { return fail("cmpordsd") }
	if !emitCase("cmpeq_oqps", 2, Xmm(0), Xmm(1), none, "0f c2 c1 00") { return fail("cmpeq_oqps") }
	if !emitCase("cmpunord_qss", 2, Xmm(0), Xmm(1), none, "f3 0f c2 c1 03") {
		return fail("cmpunord_qss")
	}
	if !emitCase("cmpord_qpd", 2, Xmm(9), Xmm(1), none, "66 44 0f c2 c9 07") {
		return fail("cmpord_qpd")
	}
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "cmpeqps", 3, Xmm(0), Xmm(1), x64.Imm(0))
	if !rejected(a) { return fail("cmpeqps with an immediate: not rejected") }
	// An error names the mnemonic as written.
	a = newAsm()
	_ = Emit(a, "cmpltsd", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ32), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: cmpltsd: takes other operands") {
		return fail("cmpltsd xmm0, dword ptr [rax]: not an error naming cmpltsd")
	}
	return ""
}

// Operands no encoding fits: memory of another size, a register where memory goes and the other
// way, an XMM register past 15, an immediate past 8 bits; cvtsi2ss's unsized memory (ambiguous);
// a name not the table's.
func TestEmitRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "addps", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ64), none)
	if !rejected(a) { return fail("addps xmm0, qword ptr: not rejected") }
	a = newAsm()
	_ = Emit(a, "movlps", 2, Xmm(0), Xmm(1), none)
	if !rejected(a) { return fail("movlps xmm0, xmm1: not rejected") }
	a = newAsm()
	_ = Emit(a, "movhlps", 2, Xmm(0), x64.Mem(x64.RAX, 0, 0), none)
	if !rejected(a) { return fail("movhlps xmm0, [rax]: not rejected") }
	a = newAsm()
	_ = Emit(a, "movaps.s", 2, Xmm(0), x64.Mem(x64.RAX, 0, 0), none)
	if !rejected(a) { return fail("movaps.s xmm0, [rax]: not rejected") }
	a = newAsm()
	_ = Emit(a, "addps", 2, Xmm(16), Xmm(1), none)
	if !rejected(a) { return fail("addps <xmm16>, xmm1: not rejected") }
	a = newAsm()
	_ = Emit(a, "shufps", 3, Xmm(0), Xmm(1), x64.Imm(256))
	if !rejected(a) { return fail("shufps xmm0, xmm1, 256: not rejected") }
	a = newAsm()
	_ = Emit(a, "cvtsi2ss", 2, Xmm(0), x64.Mem(x64.RAX, 0, 0), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: cvtsi2ss: ambiguous operand size") {
		return fail("cvtsi2ss xmm0, [rax]: not the ambiguous size")
	}
	// Unsized memory is ambiguous only where the other operands fit.
	a = newAsm()
	_ = Emit(a, "cvtsi2ss", 2, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(x64.RAX, 0, 0), none)
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: cvtsi2ss: takes other operands") {
		return fail("cvtsi2ss eax, [rax]: not other operands")
	}
	a = newAsm()
	_ = Emit(a, "cvtsi2sd", 3, Xmm(0), x64.Mem(x64.RAX, 0, 0), x64.Imm(1))
	if !rejected(a) || !msgHasPrefix(a.ErrorMsg, "x64: cvtsi2sd: takes other operands") {
		return fail("cvtsi2sd xmm0, [rax], 1: not other operands")
	}
	a = newAsm()
	_ = Emit(a, "addps", 3, Xmm(0), Xmm(1), Xmm(2))
	if !rejected(a) { return fail("addps xmm0, xmm1, xmm2: not rejected") }
	a = newAsm()
	_ = Emit(a, "movmskps", 2, x64.Reg(x64.RAX, x64.SZ16), Xmm(1), none)
	if !rejected(a) { return fail("movmskps ax, xmm1: not rejected") }
	a = newAsm()
	if Emit(a, "paddz", 2, Xmm(0), Xmm(1), none) || a.HasError { return fail("paddz: a name") }
	return ""
}
