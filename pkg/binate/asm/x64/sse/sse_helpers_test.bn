package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The test helpers of package sse, as pkg/binate/asm/x64's.

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// checkBytes reports whether section s holds the bytes expected at off (and
// any after them).
func checkBytes(s @asm.Section, off int, expected @[]int) bool {
	for i := 0; i < len(expected); i++ {
		if cast(int, s.Data[off + i]) != expected[i] {
			return false
		}
	}
	return true
}

// hexNibble returns the value of hex digit c (0-9, a-f, A-F), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return -1
}

// hexBytes parses objdump-style hex byte pairs (e.g. "66 81 e1 34 12";
// non-hex characters are ignored) into the byte values they spell.
func hexBytes(h *[]readonly char) @[]int {
	var digits int = 0
	for i := 0; i < len(h); i++ {
		if hexNibble(h[i]) >= 0 { digits++ }
	}
	var out @[]int = make_slice(int, digits / 2)
	var k int = 0
	var hi int = -1
	for i := 0; i < len(h); i++ {
		var v int = hexNibble(h[i])
		if v >= 0 {
			if hi < 0 {
				hi = v
			} else {
				out[k] = hi * 16 + v
				k++
				hi = -1
			}
		}
	}
	return out
}

// emitsExactly reports whether the assembler recorded no error and its
// section holds exactly the bytes spelled by hex (see hexBytes) — no
// fewer and, unlike checkBytes, no more.
func emitsExactly(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var s @asm.Section = a.Sections[0]
	var want @[]int = hexBytes(hex)
	if s.Len != cast(int64, len(want)) { return false }
	return checkBytes(s, 0, want)
}

// rejected reports whether the assembler recorded an error and emitted
// no bytes — how an encoder reports an unencodable operand.
func rejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0
}

// rejectedNoFixup reports whether the assembler rejected the instruction
// (rejected) and recorded no fixup for it.
func rejectedNoFixup(a @asm.Assembler) bool {
	return rejected(a) && a.Sections[0].NumFixups == 0
}

// msgHasPrefix reports whether msg begins with p.
func msgHasPrefix(msg *[]readonly char, p *[]readonly char) bool {
	if len(msg) < len(p) { return false }
	for i := 0; i < len(p); i++ {
		if msg[i] != p[i] { return false }
	}
	return true
}

// fixupIs reports whether the assembler holds exactly one fixup, of kind kind against x with the
// given addend, at byte off.
func fixupIs(a @asm.Assembler, kind int, off int, addend int64) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return false }
	var fix asm.Fixup = s.Fixups[0]
	if fix.Kind != kind || cast(int, fix.Offset) != off || fix.Addend != addend { return false }
	return len(fix.Label) == 1 && fix.Label[0] == 'x'
}
