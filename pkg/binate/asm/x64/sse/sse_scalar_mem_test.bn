package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the SSE memory forms: the eightbyte memory-image moves in
// sse_scalar.bn (MOVLPS / MOVSS, the SysV aggregate pass/return movers; byte
// sequences cross-checked against `as -arch x86_64`: MOVLPS store 0F 13, load
// 0F 12; MOVSS store F3 0F 11, load F3 0F 10), and every memory form's
// operand kinds, error text, `[rip + x]` and thread-local operands.

// exp3 / exp4 build a fixed-length expected-byte slice.
func exp3(b0 int, b1 int, b2 int) @[]int {
	var e @[]int = make_slice(int, 3)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	return e
}

func exp4(b0 int, b1 int, b2 int, b3 int) @[]int {
	var e @[]int = make_slice(int, 4)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	return e
}

// MOVLPS XMM0, [RAX] = 0F 12 00 (load low quadword).
func TestMovlpsLoad() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM0, x64.Mem(x64.RAX, 0, x64.SZ64))
	if !checkBytes(a.Sections[0], 0, exp3(0x0F, 0x12, 0x00)) {
		return fail("MOVLPS XMM0, [RAX] encoding wrong")
	}
	return ""
}

// MOVLPS [RAX], XMM0 = 0F 13 00 (store low quadword).
func TestMovlpsStore() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_store(a, x64.Mem(x64.RAX, 0, x64.SZ64), XMM0)
	if !checkBytes(a.Sections[0], 0, exp3(0x0F, 0x13, 0x00)) {
		return fail("MOVLPS [RAX], XMM0 encoding wrong")
	}
	return ""
}

// MOVLPS [R15], XMM15 = 45 0F 13 3F — REX.R (XMM15) + REX.B (R15); ModR/M
// mod=00 reg=111 rm=111.
func TestMovlpsStoreHigh() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_store(a, x64.Mem(x64.R15, 0, x64.SZ64), XMM15)
	if !checkBytes(a.Sections[0], 0, exp4(0x45, 0x0F, 0x13, 0x3F)) {
		return fail("MOVLPS [R15], XMM15 encoding wrong")
	}
	return ""
}

// MOVLPS XMM1, [RBX+8] = 0F 12 4B 08 — mod=01 disp8, reg=001 (XMM1), rm=011 (RBX).
func TestMovlpsLoadDisp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM1, x64.Mem(x64.RBX, 8, x64.SZ64))
	if !checkBytes(a.Sections[0], 0, exp4(0x0F, 0x12, 0x4B, 0x08)) {
		return fail("MOVLPS XMM1, [RBX+8] encoding wrong")
	}
	return ""
}

// MOVSS XMM0, [RAX] = F3 0F 10 00 (load low dword).
func TestMovssLoad() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_load(a, XMM0, x64.Mem(x64.RAX, 0, x64.SZ32))
	if !checkBytes(a.Sections[0], 0, exp4(0xF3, 0x0F, 0x10, 0x00)) {
		return fail("MOVSS XMM0, [RAX] encoding wrong")
	}
	return ""
}

// MOVSS [RAX], XMM0 = F3 0F 11 00 (store low dword).
func TestMovssStore() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_store(a, x64.Mem(x64.RAX, 0, x64.SZ32), XMM0)
	if !checkBytes(a.Sections[0], 0, exp4(0xF3, 0x0F, 0x11, 0x00)) {
		return fail("MOVSS [RAX], XMM0 encoding wrong")
	}
	return ""
}

// The SSE memory forms take a memory operand only (an OP_MEM or a RIP-label): the register
// (mod=11) form of their opcodes is a different instruction or none (0F 12 is MOVHLPS, 0F 13 is
// undefined), and an immediate, a label or a GOT-indirect operand has no encoding.

// memFormAccepting returns the instruction, as "<mnemonic> <form>", of the first SSE
// memory-form encoder that does not reject op (rejectedNoFixup), or "" when every one of them
// rejects it.
func memFormAccepting(op x64.Operand) *[]readonly char {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movlps xmm1, op" }
	a = newAsm()
	Movlps_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movlps op, xmm1" }
	a = newAsm()
	Movups_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movups xmm1, op" }
	a = newAsm()
	Movups_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movups op, xmm1" }
	a = newAsm()
	Movss_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movss xmm1, op" }
	a = newAsm()
	Movss_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movss op, xmm1" }
	a = newAsm()
	Movdqu_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movdqu xmm1, op" }
	a = newAsm()
	Movdqu_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movdqu op, xmm1" }
	a = newAsm()
	Movdqa_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movdqa xmm1, op" }
	a = newAsm()
	Movdqa_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movdqa op, xmm1" }
	return ""
}

func TestMemFormsRejectNonMem() testing.TestResult {
	var bad *[]readonly char = memFormAccepting(x64.Reg(x64.RCX, x64.SZ64))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = rcx must be rejected")) }
	bad = memFormAccepting(x64.Reg(x64.R9, x64.SZ32))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = r9d must be rejected")) }
	bad = memFormAccepting(x64.Imm(8))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = 8 must be rejected")) }
	bad = memFormAccepting(x64.Label("x"))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = label x must be rejected")) }
	bad = memFormAccepting(x64.RipGotLabel("x"))
	if len(bad) != 0 {
		return fail(buf.Concat(bad, ": op = [rip + x@GOTPCREL] must be rejected"))
	}
	return ""
}

// The error names the instruction and the problem.
func TestSseOperandErrorMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_load(a, XMM0, x64.RipGotLabel("x"))
	if !msgHasPrefix(a.ErrorMsg, "x64: movss: unsupported operand kinds") {
		return fail("movss xmm0, [rip + x@GOTPCREL]: unexpected error message")
	}
	return ""
}

// A `[rip + x]` operand of an SSE memory form: `movss xmm1, dword ptr [rip + x]` F3 0F 10 0D
// and `movups xmmword ptr [rip + x], xmm9` 44 0F 11 0D, the rel32 x's FIX_REL32_LEA, as clang
// emits them.
func TestSseRipLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_load(a, XMM1, x64.RipLabel("x"))
	if !emitsExactly(a, "f3 0f 10 0d 00 00 00 00") || !fixupIs(a, x64.FIX_REL32_LEA, 4, 0) {
		return fail("movss xmm1, dword ptr [rip + x]")
	}
	a = newAsm()
	Movups_store(a, x64.RipLabel("x"), XMM9)
	if !emitsExactly(a, "44 0f 11 0d 00 00 00 00") || !fixupIs(a, x64.FIX_REL32_LEA, 4, 0) {
		return fail("movups xmmword ptr [rip + x], xmm9")
	}
	return ""
}

// A thread-local offset in an SSE memory form: `movss xmm0, dword ptr [rax + x@TPOFF]` F3 0F 10 80,
// its disp32 relocated (FIX_TPOFF32).
func TestSseMemSym() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_load(a, XMM0, x64.MemSym(x64.RAX, -1, 1, "x", x64.FIX_TPOFF32, 0, x64.SZ32))
	if !emitsExactly(a, "f3 0f 10 80 00 00 00 00") || !fixupIs(a, x64.FIX_TPOFF32, 4, 0) {
		return fail("movss xmm0, dword ptr [rax + x@TPOFF]")
	}
	return ""
}
