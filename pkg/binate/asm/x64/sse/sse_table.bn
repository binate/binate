package "pkg/binate/asm/x64/sse"

// The instruction table, in parts by family (tablePart): each SSE instruction's encoding forms, a
// line each, "<mnemonic> <prefix> <map> <opcode> <operand classes>" — the prefix - (none), 66, f2
// or f3; the map 0f (0F), 38 (0F 38) or 3a (0F 3A); the opcode in hex, with /0 .. /7 after it for
// an extension in ModR/M's reg field; the operand classes in Intel order (classOk, sse_class.bn).
// A mnemonic's lines stand together in one part, tried in order.

// tablePart returns part i of the table (from 0), or "" past the last.
func tablePart(i int) *[]readonly char {
	if i == 0 { return tableFp() }
	if i == 1 { return tableInt() }
	if i == 2 { return tableSse4() }
	return ""
}

// tableOf returns the part of the table that has mnem and the position of its first line there
// (lineOf), or "" and -1.
func tableOf(mnem *[]readonly char) (*[]readonly char, int) {
	for i := 0; len(tablePart(i)) > 0; i++ {
		var t *[]readonly char = tablePart(i)
		var at int = lineOf(t, mnem)
		if at >= 0 { return t, at }
	}
	return "", -1
}

// tableFp returns the SSE and SSE2 floating-point instructions' part, a form a line, each after a
// newline: arithmetic, logic, compares, conversions, moves, shuffles.
func tableFp() *[]readonly char {
	return "\n"
			"addps - 0f 58 V W128\n"
			"addpd 66 0f 58 V W128\n"
			"addss f3 0f 58 V W32\n"
			"addsd f2 0f 58 V W64\n"
			"mulps - 0f 59 V W128\n"
			"mulpd 66 0f 59 V W128\n"
			"mulss f3 0f 59 V W32\n"
			"mulsd f2 0f 59 V W64\n"
			"subps - 0f 5c V W128\n"
			"subpd 66 0f 5c V W128\n"
			"subss f3 0f 5c V W32\n"
			"subsd f2 0f 5c V W64\n"
			"minps - 0f 5d V W128\n"
			"minpd 66 0f 5d V W128\n"
			"minss f3 0f 5d V W32\n"
			"minsd f2 0f 5d V W64\n"
			"divps - 0f 5e V W128\n"
			"divpd 66 0f 5e V W128\n"
			"divss f3 0f 5e V W32\n"
			"divsd f2 0f 5e V W64\n"
			"maxps - 0f 5f V W128\n"
			"maxpd 66 0f 5f V W128\n"
			"maxss f3 0f 5f V W32\n"
			"maxsd f2 0f 5f V W64\n"
			"sqrtps - 0f 51 V W128\n"
			"sqrtpd 66 0f 51 V W128\n"
			"sqrtss f3 0f 51 V W32\n"
			"sqrtsd f2 0f 51 V W64\n"
			"rcpps - 0f 53 V W128\n"
			"rcpss f3 0f 53 V W32\n"
			"rsqrtps - 0f 52 V W128\n"
			"rsqrtss f3 0f 52 V W32\n"
			"andps - 0f 54 V W128\n"
			"andpd 66 0f 54 V W128\n"
			"andnps - 0f 55 V W128\n"
			"andnpd 66 0f 55 V W128\n"
			"orps - 0f 56 V W128\n"
			"orpd 66 0f 56 V W128\n"
			"xorps - 0f 57 V W128\n"
			"xorpd 66 0f 57 V W128\n"
			"cmpps - 0f c2 V W128 I\n"
			"cmppd 66 0f c2 V W128 I\n"
			"cmpss f3 0f c2 V W32 I\n"
			"cmpsd f2 0f c2 V W64 I\n"
			"comiss - 0f 2f V W32\n"
			"comisd 66 0f 2f V W64\n"
			"ucomiss - 0f 2e V W32\n"
			"ucomisd 66 0f 2e V W64\n"
			"cvtsi2ss f3 0f 2a V E\n"
			"cvtsi2sd f2 0f 2a V E\n"
			"cvtss2si f3 0f 2d G W32\n"
			"cvtsd2si f2 0f 2d G W64\n"
			"cvttss2si f3 0f 2c G W32\n"
			"cvttsd2si f2 0f 2c G W64\n"
			"cvtss2sd f3 0f 5a V W32\n"
			"cvtsd2ss f2 0f 5a V W64\n"
			"cvtps2pd - 0f 5a V W64\n"
			"cvtpd2ps 66 0f 5a V W128\n"
			"cvtdq2ps - 0f 5b V W128\n"
			"cvtps2dq 66 0f 5b V W128\n"
			"cvttps2dq f3 0f 5b V W128\n"
			"cvtdq2pd f3 0f e6 V W64\n"
			"cvtpd2dq f2 0f e6 V W128\n"
			"cvttpd2dq 66 0f e6 V W128\n"
			"movaps - 0f 28 V W128\n"
			"movaps - 0f 29 M128 V\n"
			"movaps.s - 0f 29 U V\n"
			"movapd 66 0f 28 V W128\n"
			"movapd 66 0f 29 M128 V\n"
			"movapd.s 66 0f 29 U V\n"
			"movups - 0f 10 V W128\n"
			"movups - 0f 11 M128 V\n"
			"movups.s - 0f 11 U V\n"
			"movupd 66 0f 10 V W128\n"
			"movupd 66 0f 11 M128 V\n"
			"movupd.s 66 0f 11 U V\n"
			"movss f3 0f 10 V W32\n"
			"movss f3 0f 11 M32 V\n"
			"movss.s f3 0f 11 U V\n"
			"movsd f2 0f 10 V W64\n"
			"movsd f2 0f 11 M64 V\n"
			"movsd.s f2 0f 11 U V\n"
			"movlps - 0f 12 V M64\n"
			"movlps - 0f 13 M64 V\n"
			"movhps - 0f 16 V M64\n"
			"movhps - 0f 17 M64 V\n"
			"movlpd 66 0f 12 V M64\n"
			"movlpd 66 0f 13 M64 V\n"
			"movhpd 66 0f 16 V M64\n"
			"movhpd 66 0f 17 M64 V\n"
			"movhlps - 0f 12 V U\n"
			"movlhps - 0f 16 V U\n"
			"movmskps - 0f 50 R U\n"
			"movmskpd 66 0f 50 R U\n"
			"movntps - 0f 2b M128 V\n"
			"movntpd 66 0f 2b M128 V\n"
			"shufps - 0f c6 V W128 I\n"
			"shufpd 66 0f c6 V W128 I\n"
			"unpcklps - 0f 14 V W128\n"
			"unpckhps - 0f 15 V W128\n"
			"unpcklpd 66 0f 14 V W128\n"
			"unpckhpd 66 0f 15 V W128\n"
}
