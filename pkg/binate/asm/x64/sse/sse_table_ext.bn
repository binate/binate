package "pkg/binate/asm/x64/sse"

// tableExt returns the extensions' part of the table (sse_table.bn), a form a line, each after a
// newline: AES, CLMUL (pclmulqdq; its named selectors are aliases, sse_alias.bn), SHA, GFNI's
// legacy forms, Key Locker's with XMM operands (their handle's memory of any size, as clang takes
// it), AMD's SSE4a, and AMD's 3DNow! (0F 0F, its opcode the byte after the operand: ModR/M, SIB,
// displacement).
func tableExt() *[]readonly char {
	return "\n"
			"aesenc 66 38 dc V W128\n"
			"aesenclast 66 38 dd V W128\n"
			"aesdec 66 38 de V W128\n"
			"aesdeclast 66 38 df V W128\n"
			"aesimc 66 38 db V W128\n"
			"aeskeygenassist 66 3a df V W128 I\n"
			"pclmulqdq 66 3a 44 V W128 I\n"
			"sha1rnds4 - 3a cc V W128 I\n"
			"sha1nexte - 38 c8 V W128\n"
			"sha1msg1 - 38 c9 V W128\n"
			"sha1msg2 - 38 ca V W128\n"
			"sha256rnds2 - 38 cb V W128\n"
			"sha256rnds2 - 38 cb V W128 Z\n"
			"sha256msg1 - 38 cc V W128\n"
			"sha256msg2 - 38 cd V W128\n"
			"gf2p8affineqb 66 3a ce V W128 I\n"
			"gf2p8affineinvqb 66 3a cf V W128 I\n"
			"gf2p8mulb 66 38 cf V W128\n"
			"aesenc128kl f3 38 dc V A\n"
			"aesdec128kl f3 38 dd V A\n"
			"aesenc256kl f3 38 de V A\n"
			"aesdec256kl f3 38 df V A\n"
			"loadiwkey f3 38 dc V U\n"
			"extrq 66 0f 79 V U\n"
			"extrq 66 0f 78/0 U I I\n"
			"insertq f2 0f 79 V U\n"
			"insertq f2 0f 78 V U I I\n"
			"movntss f3 0f 2b M32 V\n"
			"movntsd f2 0f 2b M64 V\n"
			"pavgusb - 0f 0f.bf P Q64\n"
			"pf2id - 0f 0f.1d P Q64\n"
			"pf2iw - 0f 0f.1c P Q64\n"
			"pfacc - 0f 0f.ae P Q64\n"
			"pfadd - 0f 0f.9e P Q64\n"
			"pfcmpeq - 0f 0f.b0 P Q64\n"
			"pfcmpge - 0f 0f.90 P Q64\n"
			"pfcmpgt - 0f 0f.a0 P Q64\n"
			"pfmax - 0f 0f.a4 P Q64\n"
			"pfmin - 0f 0f.94 P Q64\n"
			"pfmul - 0f 0f.b4 P Q64\n"
			"pfnacc - 0f 0f.8a P Q64\n"
			"pfpnacc - 0f 0f.8e P Q64\n"
			"pfrcp - 0f 0f.96 P Q64\n"
			"pfrcpit1 - 0f 0f.a6 P Q64\n"
			"pfrcpit2 - 0f 0f.b6 P Q64\n"
			"pfrsqit1 - 0f 0f.a7 P Q64\n"
			"pfrsqrt - 0f 0f.97 P Q64\n"
			"pfsub - 0f 0f.9a P Q64\n"
			"pfsubr - 0f 0f.aa P Q64\n"
			"pi2fd - 0f 0f.0d P Q64\n"
			"pi2fw - 0f 0f.0c P Q64\n"
			"pmulhrw - 0f 0f.b7 P Q64\n"
			"pswapd - 0f 0f.bb P Q64\n"
}
