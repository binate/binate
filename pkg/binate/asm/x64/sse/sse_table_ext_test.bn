package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The extensions' part of the table (sse_table_ext.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): registers 8..15 and MM7 in each field,
// AES, CLMUL, SHA (sha256rnds2 with its xmm0 written), GFNI, Key Locker (any memory size), SSE4a
// with its two immediates, and 3DNow!'s opcode after ModR/M.

func TestTableExtForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var one x64.Operand = x64.Imm(1)
	if !emitCase("aesenc", 2, Xmm(9), Xmm(9), none, "66 45 0f 38 dc c9") { return fail("aesenc") }
	if !emitCase("aeskeygenassist", 3, Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), one,
			"66 45 0f 3a df 0a 01") {
		return fail("aeskeygenassist")
	}
	if !emitCase("pclmulqdq", 3, Xmm(9), Xmm(9), one, "66 45 0f 3a 44 c9 01") {
		return fail("pclmulqdq")
	}
	if !emitCase("sha1rnds4", 3, Xmm(9), Xmm(9), one, "45 0f 3a cc c9 01") { return fail("sha1rnds4") }
	if !emitCase("sha256rnds2", 3, Xmm(9), Xmm(9), Xmm(0), "45 0f 38 cb c9") {
		return fail("sha256rnds2")
	}
	if !emitCase("gf2p8affineqb", 3, Xmm(9), Xmm(9), one, "66 45 0f 3a ce c9 01") {
		return fail("gf2p8affineqb")
	}
	if !emitCase("aesenc128kl", 2, Xmm(9), x64.Mem(x64.RAX, 0, 0), none, "f3 44 0f 38 dc 08") {
		return fail("aesenc128kl [rax]")
	}
	if !emitCase("aesdec256kl", 2, Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, "f3 45 0f 38 df 0a") {
		return fail("aesdec256kl xmmword ptr [r10]")
	}
	if !emitCase("loadiwkey", 2, Xmm(9), Xmm(9), none, "f3 45 0f 38 dc c9") {
		return fail("loadiwkey")
	}
	if !emitCase("movntsd", 2, x64.Mem(x64.RAX, 0, x64.SZ64), Xmm(9), none, "f2 44 0f 2b 08") {
		return fail("movntsd")
	}
	if !emitCase("pfadd", 2, Mm(7), Mm(7), none, "0f 0f ff 9e") { return fail("pfadd mm7, mm7") }
	if !emitCase("pswapd", 2, Mm(7), x64.Mem(x64.RAX, 0, x64.SZ64), none, "0f 0f 38 bb") {
		return fail("pswapd")
	}
	return ""
}

// SSE4a's two immediates (Emit4), and 3DNow!'s opcode after a `[rip + x]`'s rel32, which counts it
// as GNU as does (clang leaves it out: its rel32 addresses the byte after the target).
func TestTableExtImmediates() testing.TestResult {
	var a @asm.Assembler = newAsm()
	_ = Emit4(a, "extrq", 3, Xmm(9), x64.Imm(1), x64.Imm(2), x64.Imm(0))
	if !emitsExactly(a, "66 41 0f 78 c1 01 02") { return fail("extrq xmm9, 1, 2") }
	a = newAsm()
	_ = Emit4(a, "insertq", 4, Xmm(9), Xmm(9), x64.Imm(1), x64.Imm(2))
	if !emitsExactly(a, "f2 45 0f 78 c9 01 02") { return fail("insertq xmm9, xmm9, 1, 2") }
	a = newAsm()
	_ = Emit4(a, "insertq", 4, Xmm(0), Xmm(1), x64.Imm(1), x64.Imm(256))
	if !rejected(a) { return fail("insertq ..., 256: not rejected") }
	a = newAsm()
	_ = Emit4(a, "insertq", 4, Xmm(0), x64.Mem(x64.RAX, 0, 0), x64.Imm(1), x64.Imm(2))
	if !rejected(a) { return fail("insertq xmm0, [rax], 1, 2: not rejected") }
	a = newAsm()
	_ = Emit4(a, "extrq", 3, x64.Mem(x64.RAX, 0, 0), x64.Imm(1), x64.Imm(2), x64.Imm(0))
	if !rejected(a) { return fail("extrq [rax], 1, 2: not rejected") }
	a = newAsm()
	_ = Emit(a, "insertq", 4, Xmm(0), Xmm(1), x64.Imm(1))
	if !rejected(a) { return fail("Emit with 4 operands: not rejected") }
	a = newAsm()
	_ = Emit(a, "pfadd", 2, Mm(7), x64.RipLabel("x"), x64.Imm(0))
	if !emitsExactly(a, "0f 0f 3d 00 00 00 00 9e") || !fixupIs(a, x64.FIX_REL32_LEA, 3, -1) {
		return fail("pfadd mm7, [rip + x]")
	}
	return ""
}
