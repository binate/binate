package "pkg/binate/asm/x64/sse"

// tableInt returns the SSE2 packed-integer and MMX instructions' part of the table (sse_table.bn),
// a form a line, each after a newline: the packed integer arithmetic, compares, logic, packs and
// unpacks, shifts and shuffles with XMM operands (66) and MMX ones (no prefix); pextrw, pinsrw,
// pmovmskb; movd, movq, movdqa, movdqu with their stores and `.s` forms, movntdq, movntq,
// maskmovdqu, maskmovq, movq2dq and movdq2q; the MMX conversions of SSE and SSE2.
func tableInt() *[]readonly char {
	return "\n"
			"packsswb 66 0f 63 V W128\n"
			"packsswb - 0f 63 P Q64\n"
			"packssdw 66 0f 6b V W128\n"
			"packssdw - 0f 6b P Q64\n"
			"packuswb 66 0f 67 V W128\n"
			"packuswb - 0f 67 P Q64\n"
			"paddb 66 0f fc V W128\n"
			"paddb - 0f fc P Q64\n"
			"paddw 66 0f fd V W128\n"
			"paddw - 0f fd P Q64\n"
			"paddd 66 0f fe V W128\n"
			"paddd - 0f fe P Q64\n"
			"paddq 66 0f d4 V W128\n"
			"paddq - 0f d4 P Q64\n"
			"paddsb 66 0f ec V W128\n"
			"paddsb - 0f ec P Q64\n"
			"paddsw 66 0f ed V W128\n"
			"paddsw - 0f ed P Q64\n"
			"paddusb 66 0f dc V W128\n"
			"paddusb - 0f dc P Q64\n"
			"paddusw 66 0f dd V W128\n"
			"paddusw - 0f dd P Q64\n"
			"pand 66 0f db V W128\n"
			"pand - 0f db P Q64\n"
			"pandn 66 0f df V W128\n"
			"pandn - 0f df P Q64\n"
			"pavgb 66 0f e0 V W128\n"
			"pavgb - 0f e0 P Q64\n"
			"pavgw 66 0f e3 V W128\n"
			"pavgw - 0f e3 P Q64\n"
			"pcmpeqb 66 0f 74 V W128\n"
			"pcmpeqb - 0f 74 P Q64\n"
			"pcmpeqw 66 0f 75 V W128\n"
			"pcmpeqw - 0f 75 P Q64\n"
			"pcmpeqd 66 0f 76 V W128\n"
			"pcmpeqd - 0f 76 P Q64\n"
			"pcmpgtb 66 0f 64 V W128\n"
			"pcmpgtb - 0f 64 P Q64\n"
			"pcmpgtw 66 0f 65 V W128\n"
			"pcmpgtw - 0f 65 P Q64\n"
			"pcmpgtd 66 0f 66 V W128\n"
			"pcmpgtd - 0f 66 P Q64\n"
			"pmaddwd 66 0f f5 V W128\n"
			"pmaddwd - 0f f5 P Q64\n"
			"pmaxsw 66 0f ee V W128\n"
			"pmaxsw - 0f ee P Q64\n"
			"pmaxub 66 0f de V W128\n"
			"pmaxub - 0f de P Q64\n"
			"pminsw 66 0f ea V W128\n"
			"pminsw - 0f ea P Q64\n"
			"pminub 66 0f da V W128\n"
			"pminub - 0f da P Q64\n"
			"pmulhuw 66 0f e4 V W128\n"
			"pmulhuw - 0f e4 P Q64\n"
			"pmulhw 66 0f e5 V W128\n"
			"pmulhw - 0f e5 P Q64\n"
			"pmullw 66 0f d5 V W128\n"
			"pmullw - 0f d5 P Q64\n"
			"pmuludq 66 0f f4 V W128\n"
			"pmuludq - 0f f4 P Q64\n"
			"por 66 0f eb V W128\n"
			"por - 0f eb P Q64\n"
			"psadbw 66 0f f6 V W128\n"
			"psadbw - 0f f6 P Q64\n"
			"psubb 66 0f f8 V W128\n"
			"psubb - 0f f8 P Q64\n"
			"psubw 66 0f f9 V W128\n"
			"psubw - 0f f9 P Q64\n"
			"psubd 66 0f fa V W128\n"
			"psubd - 0f fa P Q64\n"
			"psubq 66 0f fb V W128\n"
			"psubq - 0f fb P Q64\n"
			"psubsb 66 0f e8 V W128\n"
			"psubsb - 0f e8 P Q64\n"
			"psubsw 66 0f e9 V W128\n"
			"psubsw - 0f e9 P Q64\n"
			"psubusb 66 0f d8 V W128\n"
			"psubusb - 0f d8 P Q64\n"
			"psubusw 66 0f d9 V W128\n"
			"psubusw - 0f d9 P Q64\n"
			"punpckhbw 66 0f 68 V W128\n"
			"punpckhbw - 0f 68 P Q64\n"
			"punpckhwd 66 0f 69 V W128\n"
			"punpckhwd - 0f 69 P Q64\n"
			"punpckhdq 66 0f 6a V W128\n"
			"punpckhdq - 0f 6a P Q64\n"
			"pxor 66 0f ef V W128\n"
			"pxor - 0f ef P Q64\n"
			"punpcklbw 66 0f 60 V W128\n"
			"punpcklbw - 0f 60 P Q32\n"
			"punpcklwd 66 0f 61 V W128\n"
			"punpcklwd - 0f 61 P Q32\n"
			"punpckldq 66 0f 62 V W128\n"
			"punpckldq - 0f 62 P Q32\n"
			"punpcklqdq 66 0f 6c V W128\n"
			"punpckhqdq 66 0f 6d V W128\n"
			"psllw 66 0f f1 V W128\n"
			"psllw - 0f f1 P Q64\n"
			"psllw 66 0f 71/6 U I\n"
			"psllw - 0f 71/6 N I\n"
			"pslld 66 0f f2 V W128\n"
			"pslld - 0f f2 P Q64\n"
			"pslld 66 0f 72/6 U I\n"
			"pslld - 0f 72/6 N I\n"
			"psllq 66 0f f3 V W128\n"
			"psllq - 0f f3 P Q64\n"
			"psllq 66 0f 73/6 U I\n"
			"psllq - 0f 73/6 N I\n"
			"psraw 66 0f e1 V W128\n"
			"psraw - 0f e1 P Q64\n"
			"psraw 66 0f 71/4 U I\n"
			"psraw - 0f 71/4 N I\n"
			"psrad 66 0f e2 V W128\n"
			"psrad - 0f e2 P Q64\n"
			"psrad 66 0f 72/4 U I\n"
			"psrad - 0f 72/4 N I\n"
			"psrlw 66 0f d1 V W128\n"
			"psrlw - 0f d1 P Q64\n"
			"psrlw 66 0f 71/2 U I\n"
			"psrlw - 0f 71/2 N I\n"
			"psrld 66 0f d2 V W128\n"
			"psrld - 0f d2 P Q64\n"
			"psrld 66 0f 72/2 U I\n"
			"psrld - 0f 72/2 N I\n"
			"psrlq 66 0f d3 V W128\n"
			"psrlq - 0f d3 P Q64\n"
			"psrlq 66 0f 73/2 U I\n"
			"psrlq - 0f 73/2 N I\n"
			"pslldq 66 0f 73/7 U I\n"
			"psrldq 66 0f 73/3 U I\n"
			"pshufd 66 0f 70 V W128 I\n"
			"pshufhw f3 0f 70 V W128 I\n"
			"pshuflw f2 0f 70 V W128 I\n"
			"pshufw - 0f 70 P Q64 I\n"
			"pextrw 66 0f c5 R U I\n"
			"pextrw - 0f c5 R N I\n"
			"pextrw 66 3a 15 M16 V I\n"
			"pinsrw 66 0f c4 V J16 I\n"
			"pinsrw - 0f c4 P J16 I\n"
			"pmovmskb 66 0f d7 R U\n"
			"pmovmskb - 0f d7 R N\n"
			"movd 66 0f 6e V D\n"
			"movd 66 0f 7e D V\n"
			"movd - 0f 6e P D\n"
			"movd - 0f 7e D P\n"
			"movq f3 0f 7e V W64\n"
			"movq 66 0f d6 M64 V\n"
			"movq 66 0f 6e V Y\n"
			"movq 66 0f 7e Y V\n"
			"movq - 0f 6f P Q64\n"
			"movq - 0f 7f M64 P\n"
			"movq - 0f 6e P Y\n"
			"movq - 0f 7e Y P\n"
			"movq.s 66 0f d6 U V\n"
			"movq.s - 0f 7f N P\n"
			"movdqa 66 0f 6f V W128\n"
			"movdqa 66 0f 7f M128 V\n"
			"movdqa.s 66 0f 7f U V\n"
			"movdqu f3 0f 6f V W128\n"
			"movdqu f3 0f 7f M128 V\n"
			"movdqu.s f3 0f 7f U V\n"
			"movntdq 66 0f e7 M128 V\n"
			"movntq - 0f e7 M64 P\n"
			"maskmovdqu 66 0f f7 V U\n"
			"maskmovq - 0f f7 P N\n"
			"movq2dq f3 0f d6 V N\n"
			"movdq2q f2 0f d6 P U\n"
			"cvtpi2ps - 0f 2a V Q64\n"
			"cvtps2pi - 0f 2d P W64\n"
			"cvttps2pi - 0f 2c P W64\n"
			"cvtpi2pd 66 0f 2a V Q64\n"
			"cvtpd2pi 66 0f 2d P W128\n"
			"cvttpd2pi 66 0f 2c P W128\n"
}
