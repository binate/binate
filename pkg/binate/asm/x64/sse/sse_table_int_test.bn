package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The packed-integer and MMX part of the instruction table (sse_table_int.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): registers 8..15 and MM7 in each
// field, each operand class, an opcode extension, the moves' general-register forms.

func TestTableIntForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var r9 x64.Operand = x64.Reg(x64.R9, x64.SZ64)
	var r9d x64.Operand = x64.Reg(x64.R9, x64.SZ32)
	var one x64.Operand = x64.Imm(1)
	if !emitCase("paddb", 2, Xmm(9), Xmm(9), none, "66 45 0f fc c9") {
		return fail("paddb xmm9, xmm9")
	}
	if !emitCase("PADDB", 2, Mm(7), Mm(7), none, "0f fc ff") { return fail("paddb mm7, mm7") }
	if !emitCase("punpcklbw", 2, Mm(7), x64.Mem(x64.RAX, 0, x64.SZ32), none, "0f 60 38") {
		return fail("punpcklbw mm7, dword ptr [rax]")
	}
	if !emitCase("psllw", 2, Xmm(9), one, none, "66 41 0f 71 f1 01") { return fail("psllw xmm9, 1") }
	if !emitCase("psrlq", 2, Mm(7), one, none, "0f 73 d7 01") { return fail("psrlq mm7, 1") }
	if !emitCase("pslldq", 2, Xmm(9), one, none, "66 41 0f 73 f9 01") { return fail("pslldq xmm9, 1") }
	if !emitCase("pshufw", 3, Mm(7), Mm(7), one, "0f 70 ff 01") { return fail("pshufw mm7, mm7, 1") }
	if !emitCase("pextrw", 3, r9d, Xmm(9), one, "66 45 0f c5 c9 01") {
		return fail("pextrw r9d, xmm9, 1")
	}
	if !emitCase("pextrw", 3, r9, Mm(7), one, "44 0f c5 cf 01") { return fail("pextrw r9, mm7, 1") }
	if !emitCase("pextrw", 3, x64.Mem(x64.RAX, 0, x64.SZ16), Xmm(9), one, "66 44 0f 3a 15 08 01") {
		return fail("pextrw word ptr [rax], xmm9, 1")
	}
	if !emitCase("pinsrw", 3, Xmm(9), r9, one, "66 45 0f c4 c9 01") {
		return fail("pinsrw xmm9, r9, 1")
	}
	if !emitCase("pinsrw", 3, Mm(7), x64.Mem(x64.RAX, 0, x64.SZ16), one, "0f c4 38 01") {
		return fail("pinsrw mm7, word ptr [rax], 1")
	}
	if !emitCase("pmovmskb", 2, r9d, Mm(7), none, "44 0f d7 cf") { return fail("pmovmskb r9d, mm7") }
	if !emitCase("pmovmskb", 2, r9, Xmm(9), none, "66 45 0f d7 c9") {
		return fail("pmovmskb r9, xmm9")
	}
	if !emitCase("movd", 2, Xmm(9), r9d, none, "66 45 0f 6e c9") { return fail("movd xmm9, r9d") }
	if !emitCase("movd", 2, Xmm(9), r9, none, "66 4d 0f 6e c9") { return fail("movd xmm9, r9") }
	if !emitCase("movd", 2, r9, Mm(7), none, "49 0f 7e f9") { return fail("movd r9, mm7") }
	if !emitCase("movd", 2, x64.Mem(x64.RAX, 0, x64.SZ32), Xmm(9), none, "66 44 0f 7e 08") {
		return fail("movd dword ptr [rax], xmm9")
	}
	return ""
}

// movq's forms, the stores and the `.s` forms, and the MMX conversions.
func TestTableIntMoves() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var r9 x64.Operand = x64.Reg(x64.R9, x64.SZ64)
	if !emitCase("movq", 2, Xmm(9), Xmm(9), none, "f3 45 0f 7e c9") { return fail("movq xmm9, xmm9") }
	if !emitCase("movq", 2, Xmm(9), r9, none, "66 4d 0f 6e c9") { return fail("movq xmm9, r9") }
	if !emitCase("movq", 2, r9, Xmm(9), none, "66 4d 0f 7e c9") { return fail("movq r9, xmm9") }
	if !emitCase("movq", 2, Mm(7), Mm(7), none, "0f 6f ff") { return fail("movq mm7, mm7") }
	if !emitCase("movq", 2, Mm(7), r9, none, "49 0f 6e f9") { return fail("movq mm7, r9") }
	if !emitCase("movq", 2, r9, Mm(7), none, "49 0f 7e f9") { return fail("movq r9, mm7") }
	if !emitCase("movq", 2, x64.Mem(x64.RAX, 0, x64.SZ64), Xmm(9), none, "66 44 0f d6 08") {
		return fail("movq qword ptr [rax], xmm9")
	}
	if !emitCase("movq", 2, x64.Mem(x64.RAX, 0, 0), Mm(7), none, "0f 7f 38") {
		return fail("movq [rax], mm7")
	}
	if !emitCase("movq.s", 2, Xmm(9), Xmm(9), none, "66 45 0f d6 c9") {
		return fail("movq.s xmm9, xmm9")
	}
	if !emitCase("movq.s", 2, Mm(7), Mm(7), none, "0f 7f ff") { return fail("movq.s mm7, mm7") }
	if !emitCase("movdqa", 2, x64.Mem(x64.R10, 0, x64.SZ128), Xmm(9), none, "66 45 0f 7f 0a") {
		return fail("movdqa xmmword ptr [r10], xmm9")
	}
	if !emitCase("movdqu.s", 2, Xmm(9), Xmm(9), none, "f3 45 0f 7f c9") {
		return fail("movdqu.s xmm9, xmm9")
	}
	if !emitCase("movntq", 2, x64.Mem(x64.RAX, 0, x64.SZ64), Mm(7), none, "0f e7 38") {
		return fail("movntq qword ptr [rax], mm7")
	}
	if !emitCase("maskmovdqu", 2, Xmm(9), Xmm(9), none, "66 45 0f f7 c9") { return fail("maskmovdqu") }
	if !emitCase("movq2dq", 2, Xmm(9), Mm(7), none, "f3 44 0f d6 cf") {
		return fail("movq2dq xmm9, mm7")
	}
	if !emitCase("movdq2q", 2, Mm(7), Xmm(9), none, "f2 41 0f d6 f9") {
		return fail("movdq2q mm7, xmm9")
	}
	if !emitCase("cvtps2pi", 2, Mm(7), x64.Mem(x64.RAX, 0, x64.SZ64), none, "0f 2d 38") {
		return fail("cvtps2pi mm7, qword ptr [rax]")
	}
	if !emitCase("cvtpi2pd", 2, Xmm(9), Mm(7), none, "66 44 0f 2a cf") {
		return fail("cvtpi2pd xmm9, mm7")
	}
	if !emitCase("cvttpd2pi", 2, Mm(7), Xmm(9), none, "66 41 0f 2c f9") {
		return fail("cvttpd2pi mm7, xmm9")
	}
	return ""
}

// What clang rejects: punpcklbw's 64-bit memory with MMX, movd's 64-bit memory, movq's 32-bit
// register, pinsrw's 32-bit memory, pextrw's MMX store, the 128-bit shifts and unpacks with MMX
// operands, an MMX register past 7.
func TestTableIntRejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "punpcklbw", 2, Mm(0), x64.Mem(x64.RAX, 0, x64.SZ64), none)
	if !rejected(a) { return fail("punpcklbw mm0, qword ptr [rax]: not rejected") }
	a = newAsm()
	_ = Emit(a, "movd", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ64), none)
	if !rejected(a) { return fail("movd xmm0, qword ptr [rax]: not rejected") }
	a = newAsm()
	_ = Emit(a, "movq", 2, Xmm(0), x64.Reg(x64.RAX, x64.SZ32), none)
	if !rejected(a) { return fail("movq xmm0, eax: not rejected") }
	a = newAsm()
	_ = Emit(a, "pinsrw", 3, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ32), x64.Imm(1))
	if !rejected(a) { return fail("pinsrw xmm0, dword ptr [rax], 1: not rejected") }
	a = newAsm()
	_ = Emit(a, "pextrw", 3, x64.Mem(x64.RAX, 0, x64.SZ16), Mm(0), x64.Imm(1))
	if !rejected(a) { return fail("pextrw word ptr [rax], mm0, 1: not rejected") }
	a = newAsm()
	_ = Emit(a, "pslldq", 2, Mm(0), x64.Imm(1), none)
	if !rejected(a) { return fail("pslldq mm0, 1: not rejected") }
	a = newAsm()
	_ = Emit(a, "punpcklqdq", 2, Mm(0), Mm(1), none)
	if !rejected(a) { return fail("punpcklqdq mm0, mm1: not rejected") }
	a = newAsm()
	_ = Emit(a, "paddb", 2, Mm(8), Mm(1), none)
	if !rejected(a) { return fail("paddb <mm8>, mm1: not rejected") }
	a = newAsm()
	_ = Emit(a, "paddb", 2, Mm(0), Xmm(1), none)
	if !rejected(a) { return fail("paddb mm0, xmm1: not rejected") }
	return ""
}
