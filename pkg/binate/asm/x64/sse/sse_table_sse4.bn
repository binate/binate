package "pkg/binate/asm/x64/sse"

// tableSse4 returns the SSE3, SSSE3, SSE4.1 and SSE4.2 instructions' part of the table
// (sse_table.bn), a form a line, each after a newline: SSE3's horizontal and alternating
// arithmetic, lddqu and the duplicating moves; SSSE3's with XMM operands (66) and MMX ones (no
// prefix); SSE4.1's blends (the variable ones with or without their xmm0 written), rounding, dot
// products, the extracts and inserts, the sign and zero extensions, ptest, movntdqa and the integer
// operations it adds; SSE4.2's string compares and pcmpgtq.
func tableSse4() *[]readonly char {
	return "\n"
			"addsubpd 66 0f d0 V W128\n"
			"addsubps f2 0f d0 V W128\n"
			"haddpd 66 0f 7c V W128\n"
			"haddps f2 0f 7c V W128\n"
			"hsubpd 66 0f 7d V W128\n"
			"hsubps f2 0f 7d V W128\n"
			"lddqu f2 0f f0 V M128\n"
			"movddup f2 0f 12 V W64\n"
			"movshdup f3 0f 16 V W128\n"
			"movsldup f3 0f 12 V W128\n"
			"pshufb 66 38 00 V W128\n"
			"pshufb - 38 00 P Q64\n"
			"phaddw 66 38 01 V W128\n"
			"phaddw - 38 01 P Q64\n"
			"phaddd 66 38 02 V W128\n"
			"phaddd - 38 02 P Q64\n"
			"phaddsw 66 38 03 V W128\n"
			"phaddsw - 38 03 P Q64\n"
			"pmaddubsw 66 38 04 V W128\n"
			"pmaddubsw - 38 04 P Q64\n"
			"phsubw 66 38 05 V W128\n"
			"phsubw - 38 05 P Q64\n"
			"phsubd 66 38 06 V W128\n"
			"phsubd - 38 06 P Q64\n"
			"phsubsw 66 38 07 V W128\n"
			"phsubsw - 38 07 P Q64\n"
			"psignb 66 38 08 V W128\n"
			"psignb - 38 08 P Q64\n"
			"psignw 66 38 09 V W128\n"
			"psignw - 38 09 P Q64\n"
			"psignd 66 38 0a V W128\n"
			"psignd - 38 0a P Q64\n"
			"pmulhrsw 66 38 0b V W128\n"
			"pmulhrsw - 38 0b P Q64\n"
			"pabsb 66 38 1c V W128\n"
			"pabsb - 38 1c P Q64\n"
			"pabsw 66 38 1d V W128\n"
			"pabsw - 38 1d P Q64\n"
			"pabsd 66 38 1e V W128\n"
			"pabsd - 38 1e P Q64\n"
			"palignr 66 3a 0f V W128 I\n"
			"palignr - 3a 0f P Q64 I\n"
			"pblendvb 66 38 10 V W128\n"
			"pblendvb 66 38 10 V W128 Z\n"
			"blendvps 66 38 14 V W128\n"
			"blendvps 66 38 14 V W128 Z\n"
			"blendvpd 66 38 15 V W128\n"
			"blendvpd 66 38 15 V W128 Z\n"
			"ptest 66 38 17 V W128\n"
			"pmovsxbw 66 38 20 V W64\n"
			"pmovsxbd 66 38 21 V W32\n"
			"pmovsxbq 66 38 22 V W16\n"
			"pmovsxwd 66 38 23 V W64\n"
			"pmovsxwq 66 38 24 V W32\n"
			"pmovsxdq 66 38 25 V W64\n"
			"pmovzxbw 66 38 30 V W64\n"
			"pmovzxbd 66 38 31 V W32\n"
			"pmovzxbq 66 38 32 V W16\n"
			"pmovzxwd 66 38 33 V W64\n"
			"pmovzxwq 66 38 34 V W32\n"
			"pmovzxdq 66 38 35 V W64\n"
			"pmuldq 66 38 28 V W128\n"
			"pcmpeqq 66 38 29 V W128\n"
			"packusdw 66 38 2b V W128\n"
			"pcmpgtq 66 38 37 V W128\n"
			"pminsb 66 38 38 V W128\n"
			"pminsd 66 38 39 V W128\n"
			"pminuw 66 38 3a V W128\n"
			"pminud 66 38 3b V W128\n"
			"pmaxsb 66 38 3c V W128\n"
			"pmaxsd 66 38 3d V W128\n"
			"pmaxuw 66 38 3e V W128\n"
			"pmaxud 66 38 3f V W128\n"
			"pmulld 66 38 40 V W128\n"
			"phminposuw 66 38 41 V W128\n"
			"movntdqa 66 38 2a V M128\n"
			"roundps 66 3a 08 V W128 I\n"
			"roundpd 66 3a 09 V W128 I\n"
			"roundss 66 3a 0a V W32 I\n"
			"roundsd 66 3a 0b V W64 I\n"
			"blendps 66 3a 0c V W128 I\n"
			"blendpd 66 3a 0d V W128 I\n"
			"pblendw 66 3a 0e V W128 I\n"
			"insertps 66 3a 21 V W32 I\n"
			"dpps 66 3a 40 V W128 I\n"
			"dppd 66 3a 41 V W128 I\n"
			"mpsadbw 66 3a 42 V W128 I\n"
			"pcmpestrm 66 3a 60 V W128 I\n"
			"pcmpestri 66 3a 61 V W128 I\n"
			"pcmpistrm 66 3a 62 V W128 I\n"
			"pcmpistri 66 3a 63 V W128 I\n"
			"pextrb 66 3a 14 J8 V I\n"
			"pextrd 66 3a 16 K32 V I\n"
			"pextrq 66 3a 16 L64 V I\n"
			"extractps 66 3a 17 J32 V I\n"
			"pinsrb 66 3a 20 V J8 I\n"
			"pinsrd 66 3a 22 V K32 I\n"
			"pinsrq 66 3a 22 V L64 I\n"
}
