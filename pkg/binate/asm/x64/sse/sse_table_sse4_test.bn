package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The SSE3 .. SSE4.2 part of the instruction table (sse_table_sse4.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): registers 8..15 and MM7 in
// each field, the 0F 38 and 0F 3A maps, the classes K, L and Z, the sign / zero extensions'
// memory sizes.

func TestTableSse4Forms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var one x64.Operand = x64.Imm(1)
	var r9 x64.Operand = x64.Reg(x64.R9, x64.SZ64)
	var r9d x64.Operand = x64.Reg(x64.R9, x64.SZ32)
	if !emitCase("lddqu", 2, Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, "f2 45 0f f0 0a") {
		return fail("lddqu")
	}
	if !emitCase("movddup", 2, Xmm(9), Xmm(9), none, "f2 45 0f 12 c9") { return fail("movddup") }
	if !emitCase("pshufb", 2, Xmm(9), Xmm(9), none, "66 45 0f 38 00 c9") {
		return fail("pshufb xmm9, xmm9")
	}
	if !emitCase("pshufb", 2, Mm(7), Mm(7), none, "0f 38 00 ff") { return fail("pshufb mm7, mm7") }
	if !emitCase("palignr", 3, Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), one, "66 45 0f 3a 0f 0a 01") {
		return fail("palignr xmm9, xmmword ptr [r10], 1")
	}
	if !emitCase("palignr", 3, Mm(7), Mm(7), one, "0f 3a 0f ff 01") {
		return fail("palignr mm7, mm7, 1")
	}
	if !emitCase("blendvps", 2, Xmm(9), Xmm(9), none, "66 45 0f 38 14 c9") { return fail("blendvps") }
	if !emitCase("blendvps", 3, Xmm(9), Xmm(9), Xmm(0), "66 45 0f 38 14 c9") {
		return fail("blendvps xmm9, xmm9, xmm0")
	}
	if !emitCase("extractps", 3, r9, Xmm(9), one, "66 45 0f 3a 17 c9 01") {
		return fail("extractps r9")
	}
	if !emitCase("movntdqa", 2, Xmm(9), x64.Mem(x64.R10, 0, x64.SZ128), none, "66 45 0f 38 2a 0a") {
		return fail("movntdqa")
	}
	if !emitCase("pextrb", 3, r9, Xmm(9), one, "66 45 0f 3a 14 c9 01") { return fail("pextrb r9") }
	if !emitCase("pextrd", 3, r9d, Xmm(9), one, "66 45 0f 3a 16 c9 01") { return fail("pextrd r9d") }
	if !emitCase("pextrq", 3, r9, Xmm(9), one, "66 4d 0f 3a 16 c9 01") { return fail("pextrq r9") }
	if !emitCase("pextrq", 3, x64.Mem(x64.RAX, 0, x64.SZ64), Xmm(9), one, "66 4c 0f 3a 16 08 01") {
		return fail("pextrq qword ptr [rax]")
	}
	if !emitCase("pinsrb", 3, Xmm(9), x64.Mem(x64.RAX, 0, x64.SZ8), one, "66 44 0f 3a 20 08 01") {
		return fail("pinsrb byte ptr [rax]")
	}
	if !emitCase("pinsrd", 3, Xmm(9), r9d, one, "66 45 0f 3a 22 c9 01") { return fail("pinsrd r9d") }
	if !emitCase("pinsrq", 3, Xmm(9), r9, one, "66 4d 0f 3a 22 c9 01") { return fail("pinsrq r9") }
	if !emitCase("pmovzxbq", 2, Xmm(9), x64.Mem(x64.RAX, 0, x64.SZ16), none, "66 44 0f 38 32 08") {
		return fail("pmovzxbq word ptr [rax]")
	}
	if !emitCase("roundsd", 3, Xmm(9), x64.Mem(x64.RAX, 0, x64.SZ64), one, "66 44 0f 3a 0b 08 01") {
		return fail("roundsd qword ptr [rax]")
	}
	return ""
}

// What clang rejects: pextrd / pinsrd with a 64-bit register and pextrq / pinsrq with a 32-bit
// one, a variable blend's third operand other than xmm0, pmovzxbq's memory past 16 bits, the
// SSE4 instructions with MMX operands.
func TestTableSse4Rejects() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var one x64.Operand = x64.Imm(1)
	var rax x64.Operand = x64.Reg(x64.RAX, x64.SZ64)
	var eax x64.Operand = x64.Reg(x64.RAX, x64.SZ32)
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "pextrd", 3, rax, Xmm(0), one)
	if !rejected(a) { return fail("pextrd rax: not rejected") }
	a = newAsm()
	_ = Emit(a, "pinsrd", 3, Xmm(0), rax, one)
	if !rejected(a) { return fail("pinsrd rax: not rejected") }
	a = newAsm()
	_ = Emit(a, "pextrq", 3, eax, Xmm(0), one)
	if !rejected(a) { return fail("pextrq eax: not rejected") }
	a = newAsm()
	_ = Emit(a, "blendvps", 3, Xmm(0), Xmm(1), Xmm(2))
	if !rejected(a) { return fail("blendvps xmm0, xmm1, xmm2: not rejected") }
	a = newAsm()
	_ = Emit(a, "pmovzxbq", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ32), none)
	if !rejected(a) { return fail("pmovzxbq dword ptr: not rejected") }
	a = newAsm()
	_ = Emit(a, "pmulld", 2, Mm(0), Mm(1), none)
	if !rejected(a) { return fail("pmulld mm0, mm1: not rejected") }
	return ""
}
