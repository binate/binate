package "pkg/binate/asm/x64/sse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/optab"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The floating-point part of the instruction table (sse_table.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a form of each operand class, the
// prefixes, R8..R15 in each field, the loads, stores and `.s` forms.

// emitCase emits mnem with its operands into a fresh assembler and reports whether it holds
// exactly hex.
func emitCase(mnem *[]readonly char, n int, op1 x64.Operand, op2 x64.Operand, op3 x64.Operand,
		hex *[]readonly char) bool {
	var a @asm.Assembler = newAsm()
	if !Emit(a, mnem, n, op1, op2, op3) { return false }
	return emitsExactly(a, hex)
}

func TestTableFpForms() testing.TestResult {
	var none x64.Operand = x64.Imm(0)
	var r9 x64.Operand = x64.Reg(x64.R9, x64.SZ64)
	if !emitCase("addps", 2, Xmm(0), Xmm(1), none, "0f 58 c1") { return fail("addps xmm0, xmm1") }
	if !emitCase("ADDPD", 2, Xmm(9), x64.MemIdx(x64.R9, x64.RCX, 4, 8, x64.SZ128), none,
			"66 45 0f 58 4c 89 08") {
		return fail("addpd xmm9, xmmword ptr [r9 + rcx*4 + 8]")
	}
	if !emitCase("cvtsi2sd", 2, Xmm(9), r9, none, "f2 4d 0f 2a c9") {
		return fail("cvtsi2sd xmm9, r9")
	}
	if !emitCase("cvtsi2ss", 2, Xmm(0), x64.Mem(x64.RAX, 0, x64.SZ32), none, "f3 0f 2a 00") {
		return fail("cvtsi2ss xmm0, dword ptr [rax]")
	}
	if !emitCase("cvtsi2sd", 2, Xmm(0), x64.Mem(x64.R8, 0, x64.SZ64), none, "f2 49 0f 2a 00") {
		return fail("cvtsi2sd xmm0, qword ptr [r8]")
	}
	if !emitCase("cvtsd2si", 2, r9, Xmm(9), none, "f2 4d 0f 2d c9") {
		return fail("cvtsd2si r9, xmm9")
	}
	if !emitCase("comisd", 2, Xmm(0), x64.Mem(x64.RAX, 0, 0), none, "66 0f 2f 00") {
		return fail("comisd xmm0, [rax]")
	}
	if !emitCase("movmskps", 2, x64.Reg(x64.RAX, x64.SZ64), Xmm(1), none, "0f 50 c1") {
		return fail("movmskps rax, xmm1")
	}
	if !emitCase("movmskpd", 2, x64.Reg(x64.R9, x64.SZ32), Xmm(9), none, "66 45 0f 50 c9") {
		return fail("movmskpd r9d, xmm9")
	}
	if !emitCase("movaps", 2, x64.Mem(x64.RAX, 0, x64.SZ128), Xmm(0), none, "0f 29 00") {
		return fail("movaps xmmword ptr [rax], xmm0")
	}
	if !emitCase("movaps.s", 2, Xmm(9), Xmm(9), none, "45 0f 29 c9") {
		return fail("movaps.s xmm9, xmm9")
	}
	if !emitCase("movss", 2, x64.Mem(x64.R10, 0, x64.SZ32), Xmm(9), none, "f3 45 0f 11 0a") {
		return fail("movss dword ptr [r10], xmm9")
	}
	if !emitCase("movlpd", 2, x64.Mem(x64.RAX, 0, x64.SZ64), Xmm(0), none, "66 0f 13 00") {
		return fail("movlpd qword ptr [rax], xmm0")
	}
	if !emitCase("movhlps", 2, Xmm(9), Xmm(9), none, "45 0f 12 c9") {
		return fail("movhlps xmm9, xmm9")
	}
	if !emitCase("movntpd", 2, x64.Mem(x64.R10, 0, x64.SZ128), Xmm(9), none, "66 45 0f 2b 0a") {
		return fail("movntpd xmmword ptr [r10], xmm9")
	}
	if !emitCase("shufps", 3, Xmm(9), Xmm(9), x64.Imm(5), "45 0f c6 c9 05") {
		return fail("shufps xmm9, xmm9, 5")
	}
	return ""
}

// lineShape returns "" when the table line from at to its newline (end) is "<mnemonic> <prefix>
// <map> <opcode> <operand classes>", one space between tokens, else what is wrong.
func lineShape(t *[]readonly char, at int, end int) *[]readonly char {
	var tok int = 0
	var regs int = 0
	var rms int = 0
	var imms int = 0
	var zs int = 0
	var suf bool = false
	var i int = at
	for i < end {
		var e int = optab.TokenEnd(t, i)
		var w *[]readonly char = t[i:e]
		if len(w) == 0 { return "an empty token" }
		if tok == 0 && !mnemShape(w) { return "a mnemonic not in lower case" }
		if tok == 1 && !(len(w) == 1 && w[0] == '-') && !(len(w) == 2 && w[0] == '6' && w[1] == '6') &&
				!(len(w) == 2 && w[0] == 'f' && (w[1] == '2' || w[1] == '3')) {
			return "a prefix not -, 66, f2 or f3"
		}
		if tok == 2 &&
				!(len(w) == 2 &&
						((w[0] == '0' && w[1] == 'f') || (w[0] == '3' && (w[1] == '8' || w[1] == 'a')))) {
			return "a map not 0f, 38 or 3a"
		}
		if tok == 3 && !opcodeShape(w) {
			return "an opcode not 2 hex digits, or them and /0 .. /7 or .hh"
		}
		if tok == 3 && len(w) == 4 { regs++ }
		if tok == 3 && len(w) == 5 { suf = true }
		if tok >= 4 && !classShape(w) { return "an operand class not of classOk's" }
		if tok >= 4 && imms > 0 && w[0] != 'I' { return "a class after the immediate" }
		if tok >= 4 && w[0] == 'I' && (suf || imms > 1) {
			return "a third immediate, or one beside a suffix"
		}
		if tok >= 4 && zs > 0 { return "a class after Z" }
		if tok >= 4 && w[0] == 'Z' && (regs == 0 || rms == 0) {
			return "Z before the reg and r/m classes"
		}
		if tok >= 4 && w[0] == 'Z' { zs++ }
		if tok >= 4 && w[0] == 'I' {
			imms++
		} else if tok >= 4 && inReg(w[0]) {
			regs++
		} else if tok >= 4 && w[0] != 'Z' {
			rms++
		}
		tok++
		i = e + 1
	}
	if tok < 5 || tok > 8 { return "not 1 to 4 operand classes" }
	if suf && !suffixShape(t[optab.TokenEnd(t, at):end]) {
		return "a 3DNow! suffix outside `- 0f 0f.hh P Q64`"
	}
	if regs != 1 { return "not one of an opcode extension and a reg-field class" }
	if rms != 1 { return "not one r/m class" }
	return ""
}

// lineShape finds each fault: a line with one, its words' end the index of the newline after it.
func TestLineShapeFaults() testing.TestResult {
	var bad *[]readonly char = "\n"
			"Addps - 0f 58 V W128\n"
			"addps 67 0f 58 V W128\n"
			"addps - 0e 58 V W128\n"
			"addps - 0f 5g V W128\n"
			"psllw - 0f 71/8 U I\n"
			"addps - 0f 58 V X\n"
			"addps - 0f 58 V W24\n"
			"addps - 0f 58  V W128\n"
			"addps - 0f 58\n"
			"addps - 0f 58 U W128\n"
			"psllw - 0f 71/6 V U\n"
			"addps - 0f 58 V I\n"
			"addps - 0f 58 V U W128\n"
			"addps - 0f 58 V I U\n"
			"pblendvb 66 38 10 V Z W128\n"
			"pblendvb 66 38 10 V W128 Z I\n"
			"pextrd 66 3a 16 K64 V I\n"
			"pfadd - 0f 0f.9e P Q64 I\n"
			"insertq f2 0f 78 V U W128 I I\n"
			"pfadd - 0f 0f.9g P Q64\n"
			"pfadd 66 0f 0f.9e P Q64\n"
			"pfadd - 38 0f.9e P Q64\n"
			"pfadd - 0f 0f.9e V W128\n"
	// Each line's fault, each after a space and before a '|'.
	var why *[]readonly char = " a mnemonic not in| a prefix not| a map not| an opcode not|"
			" an opcode not| an operand class not| an operand class not| an empty token|"
			" not 1 to 4| not one of| not one of| not one r/m| not one r/m| a class after|"
			" Z before| a class after Z| an operand class not| a third immediate| not 1 to 4|"
			" an opcode not| a 3DNow! suffix| a 3DNow! suffix| a 3DNow! suffix|"
	var at int = 1
	var w int = 0
	for at < len(bad) {
		var end int = optab.NextLine(bad, at) - 1
		var we int = w
		for why[we] != '|' { we++ }
		var got *[]readonly char = lineShape(bad, at, end)
		var want *[]readonly char = why[w + 1:we]
		if len(got) < len(want) || !sameText(got[0:len(want)], want) {
			return fail(buf.Concat("lineShape: ", buf.Concat(bad[at:end], buf.Concat(": ", got))))
		}
		w = we + 1
		at = end + 1
	}
	if len(lineShape("\nmovq.s 66 0f d6 U V\n", 1, 20)) != 0 { return fail("lineShape: a good line") }
	return ""
}

// sameText reports whether a and b hold the same characters.
func sameText(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// suffixShape reports whether rest, a line after its mnemonic, is 3DNow!'s ` - 0f 0f.hh P Q64`.
func suffixShape(rest *[]readonly char) bool {
	return len(rest) == 17 && sameText(rest[0:9], " - 0f 0f.") && sameText(rest[11:17], " P Q64")
}

// opcodeShape reports whether w is an opcode as the table writes one: 2 hex digits, or them and
// /0 .. /7, or them and .hh (3DNow!'s opcode after the operand).
func opcodeShape(w *[]readonly char) bool {
	if len(w) != 2 && len(w) != 4 && len(w) != 5 { return false }
	if optab.HexVal(w[0]) < 0 || optab.HexVal(w[1]) < 0 { return false }
	if len(w) == 5 { return w[2] == '.' && optab.HexVal(w[3]) >= 0 && optab.HexVal(w[4]) >= 0 }
	return len(w) == 2 || (w[2] == '/' && w[3] >= '0' && w[3] <= '7')
}

// mnemShape reports whether w is a mnemonic as the table writes one: lower-case letters, digits,
// '.' and '_'.
func mnemShape(w *[]readonly char) bool {
	for k := 0; k < len(w); k++ {
		var c char = w[k]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_') { return false }
	}
	return true
}

// classShape reports whether w is an operand class of the table (classOk): V, U, P, N, G, R, E, D,
// Y, Z, A or I, W, M, Q or J with a size of 8, 16, 32, 64 or 128, K32 or L64.
func classShape(w *[]readonly char) bool {
	var c char = w[0]
	if len(w) == 1 {
		return c == 'V' || c == 'U' || c == 'P' || c == 'N' || c == 'G' || c == 'R' || c == 'E' ||
				c == 'D' || c == 'Y' || c == 'Z' || c == 'A' || c == 'I'
	}
	if c != 'W' && c != 'M' && c != 'Q' && c != 'J' && c != 'K' && c != 'L' { return false }
	var n int = optab.TokenNum(w)
	// (K's register is 32 bits and L's 64: their memory is the same size.)
	if c == 'K' { return n == 32 }
	if c == 'L' { return n == 64 }
	return n == 8 || n == 16 || n == 32 || n == 64 || n == 128
}

// prevLine returns the position of the line before the one at at (at > 1).
func prevLine(t *[]readonly char, at int) int {
	var i int = at - 2
	for i > 0 && t[i] != '\n' { i-- }
	return i + 1
}

// Every line of every part is well formed, each part starts and ends with a newline, and a
// mnemonic's lines stand together in one part (lineOf finds only the first).
func TestTableShape() testing.TestResult {
	for p := 0; len(tablePart(p)) > 0; p++ {
		var t *[]readonly char = tablePart(p)
		if t[0] != '\n' || t[len(t) - 1] != '\n' { return fail("a part not between newlines") }
		var at int = 1
		for at < len(t) {
			var end int = optab.NextLine(t, at) - 1
			var why *[]readonly char = lineShape(t, at, end)
			if len(why) > 0 { return fail(buf.Concat(why, buf.Concat(": ", t[at:end]))) }
			// The mnemonic's first line, wherever it is, starts this run of its lines, and no
			// other part has it.
			var name *[]readonly char = t[at:optab.TokenEnd(t, at)]
			var first int = optab.LineOf(t, name)
			var back int = at
			for back > 1 && optab.SameMnem(t, prevLine(t, back), name) { back = prevLine(t, back) }
			if first != back { return fail(buf.Concat("lines apart: ", name)) }
			for q := 0; len(tablePart(q)) > 0; q++ {
				if q != p && optab.LineOf(tablePart(q), name) >= 0 {
					return fail(buf.Concat("in two parts: ", name))
				}
			}
			at = end + 1
		}
	}
	return ""
}

// A `[rip + x]` operand's rel32, its addend less a trailing imm8's byte.
func TestTableFpRip() testing.TestResult {
	var a @asm.Assembler = newAsm()
	_ = Emit(a, "addps", 2, Xmm(0), x64.RipLabel("x"), x64.Imm(0))
	if !emitsExactly(a, "0f 58 05 00 00 00 00") || !fixupIs(a, x64.FIX_REL32_LEA, 3, 0) {
		return fail("addps xmm0, [rip + x]")
	}
	a = newAsm()
	_ = Emit(a, "shufps", 3, Xmm(0), x64.RipLabel("x"), x64.Imm(1))
	if !emitsExactly(a, "0f c6 05 00 00 00 00 01") || !fixupIs(a, x64.FIX_REL32_LEA, 3, -1) {
		return fail("shufps xmm0, [rip + x], 1")
	}
	return ""
}
