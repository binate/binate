// Package strop provides the x86-64 string instructions — MOVS, CMPS, SCAS, LODS, STOS, INS and
// OUTS — and the repeat prefixes REP (F3) and REPNE (F2), beside the general-purpose instructions
// of pkg/binate/asm/x64, whose operand sizes (x64.SZ8 .. x64.SZ64) they take.  Each instruction
// works on the element at [rsi] (in DS, or the segment of an override before it) and / or [rdi]
// (always in ES), then steps RSI / RDI by the element's size, down when the direction flag is
// set; a repeat prefix runs it RCX times.
package "pkg/binate/asm/x64/strop"

import "pkg/binate/asm"

// Movs emits MOVS of an element of size bits (x64.SZ8, SZ16, SZ32 or SZ64), [rdi] <- [rsi]:
// MOVSB A4, MOVSW 66 A5, MOVSD A5, MOVSQ REX.W A5.  Any other size sets an assembler error and
// emits nothing.
func Movs(a @asm.Assembler, size int)

// Cmps emits CMPS (compare [rsi] with [rdi], setting the flags): A6, or A7 at 16, 32 and 64 bits,
// sized as Movs.
func Cmps(a @asm.Assembler, size int)

// Scas emits SCAS (compare the accumulator AL / AX / EAX / RAX with [rdi]): AE / AF, sized as
// Movs.
func Scas(a @asm.Assembler, size int)

// Lods emits LODS (the accumulator <- [rsi]): AC / AD, sized as Movs.
func Lods(a @asm.Assembler, size int)

// Stos emits STOS ([rdi] <- the accumulator): AA / AB, sized as Movs.  Rep, then Stos of SZ8,
// fills RCX bytes with AL.
func Stos(a @asm.Assembler, size int)

// Ins emits INS ([rdi] <- I/O port DX): 6C / 6D, of x64.SZ8, SZ16 or SZ32 (there is no 64-bit
// form); any other size sets an assembler error and emits nothing.
func Ins(a @asm.Assembler, size int)

// Outs emits OUTS (I/O port DX <- [rsi]): 6E / 6F, sized as Ins.
func Outs(a @asm.Assembler, size int)

// Rep emits the repeat prefix F3 (rep, repe, repz): the string instruction after it runs RCX
// times, CMPS and SCAS while the elements are equal.  (F3 before RET is REP RET, before NOP
// PAUSE, before BSF / BSR TZCNT / LZCNT.)
func Rep(a @asm.Assembler)

// Repne emits the repeat prefix F2 (repne, repnz): as Rep, CMPS and SCAS while the elements
// differ.
func Repne(a @asm.Assembler)
