package "pkg/binate/asm/x64/strop"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// A string instruction is one opcode byte: the 8-bit form's op8, the wider forms' op8 + 1 after
// 66 at 16 bits and REX.W at 64.  It takes no lock prefix (x64.LockNext), so one written before it
// is an assembler error (asm.Assembler.X64Lock).

// Movs emits MOVS; see strop.bni.
func Movs(a @asm.Assembler, size int) { emitString(a, "movs", size, 0xA4, true) }

// Cmps emits CMPS; see strop.bni.
func Cmps(a @asm.Assembler, size int) { emitString(a, "cmps", size, 0xA6, true) }

// Scas emits SCAS; see strop.bni.
func Scas(a @asm.Assembler, size int) { emitString(a, "scas", size, 0xAE, true) }

// Lods emits LODS; see strop.bni.
func Lods(a @asm.Assembler, size int) { emitString(a, "lods", size, 0xAC, true) }

// Stos emits STOS; see strop.bni.
func Stos(a @asm.Assembler, size int) { emitString(a, "stos", size, 0xAA, true) }

// Ins emits INS; see strop.bni.
func Ins(a @asm.Assembler, size int) { emitString(a, "ins", size, 0x6C, false) }

// Outs emits OUTS; see strop.bni.
func Outs(a @asm.Assembler, size int) { emitString(a, "outs", size, 0x6E, false) }

// Rep emits the repeat prefix F3; see strop.bni.
func Rep(a @asm.Assembler) { a.EmitInstrUint8(0xF3) }

// Repne emits the repeat prefix F2; see strop.bni.
func Repne(a @asm.Assembler) { a.EmitInstrUint8(0xF2) }

// emitString emits the string instruction mnem of an element of size bits: op8 for a byte, else
// 66 (16 bits) or REX.W (64 bits, which wide allows) and op8 + 1.  Any other size sets an assembler
// error and emits nothing.
func emitString(a @asm.Assembler, mnem *[]readonly char, size int, op8 int, wide bool) {
	if size != x64.SZ8 && size != x64.SZ16 && size != x64.SZ32 && (size != x64.SZ64 || !wide) {
		x64.OperandError(a, mnem, "invalid operand size")
		return
	}
	if size == x64.SZ8 {
		a.EmitInstrUint8(cast(uint8, op8))
		return
	}
	if size == x64.SZ16 { a.EmitInstrUint8(0x66) }
	if size == x64.SZ64 { a.EmitInstrUint8(0x48) }
	a.EmitInstrUint8(cast(uint8, op8 + 1))
}

// Xlat emits XLAT (D7); see strop.bni.
func Xlat(a @asm.Assembler) { a.EmitInstrUint8(0xD7) }
