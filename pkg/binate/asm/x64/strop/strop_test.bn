package "pkg/binate/asm/x64/strop"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The string instructions and repeat prefixes against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`: movsb .. movsq, insb .. insd, rep).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells ("f3 48
// ab").
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// strCase adds name to the failures e unless a holds exactly the bytes hex spells.
func strCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// Each instruction at each of its sizes, byte to quadword (ins / outs to dword).
func TestStringInstructions() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Movs(a, x64.SZ8)
	Movs(a, x64.SZ16)
	Movs(a, x64.SZ32)
	Movs(a, x64.SZ64)
	e = strCase(e, a, "movs", "a4 66 a5 a5 48 a5")
	a = newAsm()
	Cmps(a, x64.SZ8)
	Cmps(a, x64.SZ16)
	Cmps(a, x64.SZ32)
	Cmps(a, x64.SZ64)
	e = strCase(e, a, "cmps", "a6 66 a7 a7 48 a7")
	a = newAsm()
	Scas(a, x64.SZ8)
	Scas(a, x64.SZ16)
	Scas(a, x64.SZ32)
	Scas(a, x64.SZ64)
	e = strCase(e, a, "scas", "ae 66 af af 48 af")
	a = newAsm()
	Lods(a, x64.SZ8)
	Lods(a, x64.SZ16)
	Lods(a, x64.SZ32)
	Lods(a, x64.SZ64)
	e = strCase(e, a, "lods", "ac 66 ad ad 48 ad")
	a = newAsm()
	Stos(a, x64.SZ8)
	Stos(a, x64.SZ16)
	Stos(a, x64.SZ32)
	Stos(a, x64.SZ64)
	e = strCase(e, a, "stos", "aa 66 ab ab 48 ab")
	a = newAsm()
	Ins(a, x64.SZ8)
	Ins(a, x64.SZ16)
	Ins(a, x64.SZ32)
	e = strCase(e, a, "ins", "6c 66 6d 6d")
	a = newAsm()
	Outs(a, x64.SZ8)
	Outs(a, x64.SZ16)
	Outs(a, x64.SZ32)
	e = strCase(e, a, "outs", "6e 66 6f 6f")
	return e
}

// The repeat prefixes, alone and before a string instruction: rep stosb, rep stosq, repne scasb.
func TestRepeatPrefixes() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Rep(a)
	Repne(a)
	e = strCase(e, a, "rep, repne", "f3 f2")
	a = newAsm()
	Rep(a)
	Stos(a, x64.SZ8)
	e = strCase(e, a, "rep stosb", "f3 aa")
	a = newAsm()
	Rep(a)
	Stos(a, x64.SZ64)
	e = strCase(e, a, "rep stosq", "f3 48 ab")
	a = newAsm()
	Repne(a)
	Scas(a, x64.SZ8)
	e = strCase(e, a, "repne scasb", "f2 ae")
	return e
}

// A size an instruction has no form of (ins / outs of a quadword, none, 128 bits), and a lock
// prefix before one (x64.LockNext), are errors and emit nothing.
func TestStringRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Ins(a, x64.SZ64)
	e = rejectCase(e, a, "insq")
	a = newAsm()
	Outs(a, x64.SZ64)
	e = rejectCase(e, a, "outsq")
	a = newAsm()
	Movs(a, 0)
	e = rejectCase(e, a, "movs of no size")
	a = newAsm()
	Stos(a, x64.SZ128)
	e = rejectCase(e, a, "stos of 128 bits")
	a = newAsm()
	x64.LockNext(a)
	Movs(a, x64.SZ8)
	e = rejectCase(e, a, "lock movsb")
	return e
}

// XLAT is D7, as clang's `xlatb`; after x64.LockNext it is an error, nothing written.
func TestXlat() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Xlat(a)
	e = strCase(e, a, "xlatb", "d7")
	a = newAsm()
	x64.LockNext(a)
	Xlat(a)
	if !a.HasError || a.Sections[0].Len != 0 { e = buf.Concat(e, "lock xlatb: not rejected; ") }
	return e
}
