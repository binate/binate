// Package sys provides the x86-64 system instructions beside the instructions of
// pkg/binate/asm/x64, whose operands (x64.Operand) and encoding support (x64.EmitRexRM,
// x64.EmitModRM) they use: the model-specific, performance and time-stamp counters and CPUID;
// the fences, prefetches and cache-line instructions; interrupt and access-check flags; port I/O;
// the control, debug and segment registers; the descriptor tables, LDT, task register and machine
// status word; TLB and cache invalidation; MONITOR / MWAIT; the extended control register and the
// XSAVE / FXSAVE state; random numbers; the FS / GS bases; protection keys; and UD0 / UD1.
//
// Register operands are x64 registers (x64.Reg) of the sizes each lists; a memory operand is
// x64.IsMem's (an OP_MEM, a `[rip + label]` or a GOT slot), of the size each lists or of size 0.
// Any other operand sets an assembler error and emits nothing.  None takes a lock prefix (after
// x64.LockNext each is an assembler error and writes nothing).
package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The segment registers, numbered as an instruction's ModR/M reg field encodes them.
const (
	ES int = 0
	CS int = 1
	SS int = 2
	DS int = 3
	FS int = 4
	GS int = 5
)

// --- No operands ---

// Rdmsr emits RDMSR (0F 32): EDX:EAX <- the model-specific register ECX names.
func Rdmsr(a @asm.Assembler)

// Wrmsr emits WRMSR (0F 30): the model-specific register ECX names <- EDX:EAX.
func Wrmsr(a @asm.Assembler)

// Rdpmc emits RDPMC (0F 33): EDX:EAX <- the performance counter ECX names.
func Rdpmc(a @asm.Assembler)

// Rdtsc emits RDTSC (0F 31): EDX:EAX <- the time-stamp counter.
func Rdtsc(a @asm.Assembler)

// Rdtscp emits RDTSCP (0F 01 F9): RDTSC, and ECX <- TSC_AUX.
func Rdtscp(a @asm.Assembler)

// Cpuid emits CPUID (0F A2).
func Cpuid(a @asm.Assembler)

// Lfence emits LFENCE (0F AE E8), Mfence MFENCE (0F AE F0) and Sfence SFENCE (0F AE F8).
func Lfence(a @asm.Assembler)

func Mfence(a @asm.Assembler)

func Sfence(a @asm.Assembler)

// Cli emits CLI (FA) and Sti STI (FB): clear and set the interrupt flag.
func Cli(a @asm.Assembler)

func Sti(a @asm.Assembler)

// Clac emits CLAC (0F 01 CA) and Stac STAC (0F 01 CB): clear and set the alignment-check flag
// (SMAP).
func Clac(a @asm.Assembler)

func Stac(a @asm.Assembler)

// Clts emits CLTS (0F 06): clear CR0's task-switched flag.
func Clts(a @asm.Assembler)

// Swapgs emits SWAPGS (0F 01 F8): exchange the GS base with the KernelGSbase MSR.
func Swapgs(a @asm.Assembler)

// Invd emits INVD (0F 08), Wbinvd WBINVD (0F 09) and Wbnoinvd WBNOINVD (F3 0F 09): invalidate
// the caches, after writing them back (WBINVD), or writing them back and keeping them (WBNOINVD).
func Invd(a @asm.Assembler)

func Wbinvd(a @asm.Assembler)

func Wbnoinvd(a @asm.Assembler)

// Invlpga emits INVLPGA (0F 01 DF): invalidate the TLB entry for RAX's address in the ASID ECX.
func Invlpga(a @asm.Assembler)

// Monitor emits MONITOR (0F 01 C8) and Mwait MWAIT (0F 01 C9): arm address monitoring at RAX, and
// wait for a write to it; Monitorx (0F 01 FA) and Mwaitx (0F 01 FB) are AMD's forms.
func Monitor(a @asm.Assembler)

func Mwait(a @asm.Assembler)

func Monitorx(a @asm.Assembler)

func Mwaitx(a @asm.Assembler)

// Xgetbv emits XGETBV (0F 01 D0): EDX:EAX <- the extended control register ECX names; Xsetbv
// (0F 01 D1) the reverse.
func Xgetbv(a @asm.Assembler)

func Xsetbv(a @asm.Assembler)

// Rdpkru emits RDPKRU (0F 01 EE): EAX <- PKRU; Wrpkru (0F 01 EF) the reverse.
func Rdpkru(a @asm.Assembler)

func Wrpkru(a @asm.Assembler)

// Clzero emits CLZERO (0F 01 FC): zero the cache line at RAX.
func Clzero(a @asm.Assembler)

// Rsm emits RSM (0F AA): resume from system management mode.
func Rsm(a @asm.Assembler)

// --- Control, debug and segment registers ---

// MovFromCr emits MOV r64, CRn (0F 20 /r): dst a 64-bit register, cr 0..15 (REX.R for 8..15).
// MovToCr emits MOV CRn, r64 (0F 22 /r).  MovFromDr / MovToDr are the same for DRn (0F 21 / 0F 23).
func MovFromCr(a @asm.Assembler, dst x64.Operand, cr int)

func MovToCr(a @asm.Assembler, cr int, src x64.Operand)

func MovFromDr(a @asm.Assembler, dst x64.Operand, dr int)

func MovToDr(a @asm.Assembler, dr int, src x64.Operand)

// MovFromSeg emits MOV r/m, Sreg (8C /r): dst a 16-, 32- or 64-bit register (REX.W at 64, no 66 at
// 16, as clang) or a word of memory; seg ES..GS.  MovToSeg emits MOV Sreg, r/m (8E /r): src a 16-
// (66), 32- or 64-bit (REX.W) register or a word of memory, as clang.
func MovFromSeg(a @asm.Assembler, dst x64.Operand, seg int)

func MovToSeg(a @asm.Assembler, seg int, src x64.Operand)

// PushSeg emits PUSH FS / GS (0F A0 / 0F A8) of size bits, x64.SZ64 or SZ16 (66); PopSeg POP
// (0F A1 / 0F A9).  Any other segment (no 64-bit form) or size sets an assembler error.
func PushSeg(a @asm.Assembler, seg int, size int)

func PopSeg(a @asm.Assembler, seg int, size int)

// Lfs emits LFS r, m (0F B4 /r): load FS and dst from the far pointer at mem; dst a 16- (66),
// 32- or 64-bit (REX.W) register, mem memory of any size (m16:16, m16:32 or m16:64, by dst's size).
// Lgs emits LGS (0F B5 /r) and Lss LSS (0F B2 /r), with the same operands.  (LDS and LES have no
// 64-bit-mode form.)
func Lfs(a @asm.Assembler, dst x64.Operand, mem x64.Operand)

func Lgs(a @asm.Assembler, dst x64.Operand, mem x64.Operand)

func Lss(a @asm.Assembler, dst x64.Operand, mem x64.Operand)

// --- Descriptor tables, LDT, task register, machine status word ---

// Lgdt emits LGDT mem (0F 01 /2), Lidt LIDT (/3), Sgdt SGDT (/0) and Sidt SIDT (/1): the
// descriptor-table register from or to memory, of any size.
func Lgdt(a @asm.Assembler, mem x64.Operand)

func Lidt(a @asm.Assembler, mem x64.Operand)

func Sgdt(a @asm.Assembler, mem x64.Operand)

func Sidt(a @asm.Assembler, mem x64.Operand)

// Lldt emits LLDT r/m16 (0F 00 /2), Ltr LTR (/3), Verr VERR (/4), Verw VERW (/5) and Lmsw LMSW
// (0F 01 /6): src a 16-bit register or a word of memory.
func Lldt(a @asm.Assembler, src x64.Operand)

func Ltr(a @asm.Assembler, src x64.Operand)

func Verr(a @asm.Assembler, src x64.Operand)

func Verw(a @asm.Assembler, src x64.Operand)

func Lmsw(a @asm.Assembler, src x64.Operand)

// Sldt emits SLDT r/m (0F 00 /0), Str STR (/1) and Smsw SMSW (0F 01 /4): dst a 16- (66), 32- or
// 64-bit (REX.W) register, or a word of memory.
func Sldt(a @asm.Assembler, dst x64.Operand)

func Str(a @asm.Assembler, dst x64.Operand)

func Smsw(a @asm.Assembler, dst x64.Operand)

// Lar emits LAR r, r/m (0F 02 /r): dst a 16- (66), 32- or 64-bit (REX.W) register <- src's
// access rights; src a register of any of those sizes (its number is what the field holds) or a
// word of memory.  Lsl emits LSL (0F 03 /r), the segment limit, with the same operands.
func Lar(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Lsl(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// --- TLB, caches, prefetches ---

// Invlpg emits INVLPG mem (0F 01 /7): invalidate the TLB entry for mem's page; mem a byte.
func Invlpg(a @asm.Assembler, mem x64.Operand)

// Invpcid emits INVPCID r64, m128 (66 0F 38 82 /r): invalidation type reg, descriptor at mem.
func Invpcid(a @asm.Assembler, reg x64.Operand, mem x64.Operand)

// The prefetches of the byte at mem: Prefetcht0 (0F 18 /1), Prefetcht1 (/2), Prefetcht2 (/3),
// Prefetchnta (/0), and of code Prefetchit0 (/7) and Prefetchit1 (/6); Prefetch (0F 0D /0),
// Prefetchw (/1) and Prefetchwt1 (/2).
func Prefetcht0(a @asm.Assembler, mem x64.Operand)

func Prefetcht1(a @asm.Assembler, mem x64.Operand)

func Prefetcht2(a @asm.Assembler, mem x64.Operand)

func Prefetchnta(a @asm.Assembler, mem x64.Operand)

func Prefetchit0(a @asm.Assembler, mem x64.Operand)

func Prefetchit1(a @asm.Assembler, mem x64.Operand)

func Prefetch(a @asm.Assembler, mem x64.Operand)

func Prefetchw(a @asm.Assembler, mem x64.Operand)

func Prefetchwt1(a @asm.Assembler, mem x64.Operand)

// The cache-line instructions on the line holding the byte at mem: Clflush (0F AE /7),
// Clflushopt (66 0F AE /7), Clwb (66 0F AE /6) and Cldemote (0F 1C /0).
func Clflush(a @asm.Assembler, mem x64.Operand)

func Clflushopt(a @asm.Assembler, mem x64.Operand)

func Clwb(a @asm.Assembler, mem x64.Operand)

func Cldemote(a @asm.Assembler, mem x64.Operand)

// --- Processor state ---

// The state saves and restores at mem, of any size, REX.W (the 64 forms: `xsave64`, ..) when w64:
// Xsave (0F AE /4), Xrstor (/5), Xsaveopt (/6), Xsavec (0F C7 /4), Xsaves (/5), Xrstors (/3),
// Fxsave (0F AE /0) and Fxrstor (/1).
func Xsave(a @asm.Assembler, mem x64.Operand, w64 bool)

func Xrstor(a @asm.Assembler, mem x64.Operand, w64 bool)

func Xsaveopt(a @asm.Assembler, mem x64.Operand, w64 bool)

func Xsavec(a @asm.Assembler, mem x64.Operand, w64 bool)

func Xsaves(a @asm.Assembler, mem x64.Operand, w64 bool)

func Xrstors(a @asm.Assembler, mem x64.Operand, w64 bool)

func Fxsave(a @asm.Assembler, mem x64.Operand, w64 bool)

func Fxrstor(a @asm.Assembler, mem x64.Operand, w64 bool)

// Ldmxcsr emits LDMXCSR mem (0F AE /2) and Stmxcsr STMXCSR (/3): MXCSR from or to a dword.
func Ldmxcsr(a @asm.Assembler, mem x64.Operand)

func Stmxcsr(a @asm.Assembler, mem x64.Operand)

// --- Register forms ---

// Rdrand emits RDRAND r (0F C7 /6) and Rdseed RDSEED (/7): dst a 16- (66), 32- or 64-bit (REX.W)
// register.
func Rdrand(a @asm.Assembler, dst x64.Operand)

func Rdseed(a @asm.Assembler, dst x64.Operand)

// Rdfsbase emits RDFSBASE r (F3 0F AE /0), Rdgsbase (/1), Wrfsbase (/2) and Wrgsbase (/3): reg a
// 32- or 64-bit (REX.W) register.
func Rdfsbase(a @asm.Assembler, reg x64.Operand)

func Rdgsbase(a @asm.Assembler, reg x64.Operand)

func Wrfsbase(a @asm.Assembler, reg x64.Operand)

func Wrgsbase(a @asm.Assembler, reg x64.Operand)

// Rdpid emits RDPID r64 (F3 0F C7 /7): dst <- TSC_AUX.
func Rdpid(a @asm.Assembler, dst x64.Operand)

// Ud1 emits UD1 r, r/m (0F B9 /r) and Ud0 UD0 (0F FF /r, GNU as's spelling; clang has none): the
// defined invalid opcodes, which always trap (#UD); reg a 16- (66), 32- or 64-bit (REX.W) register
// and rm a register or memory of its size.
func Ud1(a @asm.Assembler, reg x64.Operand, rm x64.Operand)

func Ud0(a @asm.Assembler, reg x64.Operand, rm x64.Operand)

// --- Port I/O ---

// In emits IN acc, port: acc AL, AX (66) or EAX; port an imm8 (E4 / E5 ib: a number -128..255 or a
// symbol, x64.ImmSym, its byte relocated by asm.FIX_DATA_ABS8) or DX (EC / ED).  Out emits OUT
// port, acc (E6 / E7 ib, EE / EF) with the same operands.
func In(a @asm.Assembler, acc x64.Operand, port x64.Operand)

func Out(a @asm.Assembler, port x64.Operand, acc x64.Operand)
