package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// emit0F emits the two-byte opcode 0F op.
func emit0F(a @asm.Assembler, op int) {
	emit8(a, 0x0F)
	emit8(a, op)
}

// emit0F01 emits the three-byte opcode 0F 01 op (op a ModR/M byte of the register form).
func emit0F01(a @asm.Assembler, op int) {
	emit0F(a, 0x01)
	emit8(a, op)
}

// isGpr reports whether op is a general-purpose register, RAX..R15, of size bits.
func isGpr(op x64.Operand, size int) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 && op.Size == size
}

// isGprSized reports whether op is a 16-, 32- or 64-bit general-purpose register.
func isGprSized(op x64.Operand) bool {
	return isGpr(op, x64.SZ16) || isGpr(op, x64.SZ32) || isGpr(op, x64.SZ64)
}

// isMemOf reports whether op is memory of size bits or of size 0; a size of -1 takes any.
func isMemOf(op x64.Operand, size int) bool {
	return x64.IsMem(op) && (size < 0 || op.Size == 0 || op.Size == size)
}

// emitSized emits the operand-size prefix and REX of an instruction of size bits (66 at 16, REX.W
// at 64) whose ModR/M reg field is reg and r/m operand rm.
func emitSized(a @asm.Assembler, size int, reg int, rm x64.Operand) {
	if size == x64.SZ16 { emit8(a, 0x66) }
	x64.EmitRexRM(a, size == x64.SZ64, reg, rm, false)
}

// Rdmsr emits RDMSR (0F 32); see sys.bni.
func Rdmsr(a @asm.Assembler) { emit0F(a, 0x32) }

// Wrmsr emits WRMSR (0F 30); see sys.bni.
func Wrmsr(a @asm.Assembler) { emit0F(a, 0x30) }

// Rdpmc emits RDPMC (0F 33); see sys.bni.
func Rdpmc(a @asm.Assembler) { emit0F(a, 0x33) }

// Rdtsc emits RDTSC (0F 31); see sys.bni.
func Rdtsc(a @asm.Assembler) { emit0F(a, 0x31) }

// Rdtscp emits RDTSCP (0F 01 F9); see sys.bni.
func Rdtscp(a @asm.Assembler) { emit0F01(a, 0xF9) }

// Cpuid emits CPUID (0F A2); see sys.bni.
func Cpuid(a @asm.Assembler) { emit0F(a, 0xA2) }

// Lfence emits LFENCE (0F AE E8); see sys.bni.
func Lfence(a @asm.Assembler) {
	emit0F(a, 0xAE)
	emit8(a, 0xE8)
}

// Mfence emits MFENCE (0F AE F0); see sys.bni.
func Mfence(a @asm.Assembler) {
	emit0F(a, 0xAE)
	emit8(a, 0xF0)
}

// Sfence emits SFENCE (0F AE F8); see sys.bni.
func Sfence(a @asm.Assembler) {
	emit0F(a, 0xAE)
	emit8(a, 0xF8)
}

// Cli emits CLI (FA); see sys.bni.
func Cli(a @asm.Assembler) { emit8(a, 0xFA) }

// Sti emits STI (FB); see sys.bni.
func Sti(a @asm.Assembler) { emit8(a, 0xFB) }

// Clac emits CLAC (0F 01 CA); see sys.bni.
func Clac(a @asm.Assembler) { emit0F01(a, 0xCA) }

// Stac emits STAC (0F 01 CB); see sys.bni.
func Stac(a @asm.Assembler) { emit0F01(a, 0xCB) }

// Clts emits CLTS (0F 06); see sys.bni.
func Clts(a @asm.Assembler) { emit0F(a, 0x06) }

// Swapgs emits SWAPGS (0F 01 F8); see sys.bni.
func Swapgs(a @asm.Assembler) { emit0F01(a, 0xF8) }

// Invd emits INVD (0F 08); see sys.bni.
func Invd(a @asm.Assembler) { emit0F(a, 0x08) }

// Wbinvd emits WBINVD (0F 09); see sys.bni.
func Wbinvd(a @asm.Assembler) { emit0F(a, 0x09) }

// Wbnoinvd emits WBNOINVD (F3 0F 09); see sys.bni.
func Wbnoinvd(a @asm.Assembler) {
	emit8(a, 0xF3)
	emit0F(a, 0x09)
}

// Invlpga emits INVLPGA (0F 01 DF); see sys.bni.
func Invlpga(a @asm.Assembler) { emit0F01(a, 0xDF) }

// Monitor emits MONITOR (0F 01 C8); see sys.bni.
func Monitor(a @asm.Assembler) { emit0F01(a, 0xC8) }

// Mwait emits MWAIT (0F 01 C9); see sys.bni.
func Mwait(a @asm.Assembler) { emit0F01(a, 0xC9) }

// Monitorx emits MONITORX (0F 01 FA); see sys.bni.
func Monitorx(a @asm.Assembler) { emit0F01(a, 0xFA) }

// Mwaitx emits MWAITX (0F 01 FB); see sys.bni.
func Mwaitx(a @asm.Assembler) { emit0F01(a, 0xFB) }

// Xgetbv emits XGETBV (0F 01 D0); see sys.bni.
func Xgetbv(a @asm.Assembler) { emit0F01(a, 0xD0) }

// Xsetbv emits XSETBV (0F 01 D1); see sys.bni.
func Xsetbv(a @asm.Assembler) { emit0F01(a, 0xD1) }

// Rdpkru emits RDPKRU (0F 01 EE); see sys.bni.
func Rdpkru(a @asm.Assembler) { emit0F01(a, 0xEE) }

// Wrpkru emits WRPKRU (0F 01 EF); see sys.bni.
func Wrpkru(a @asm.Assembler) { emit0F01(a, 0xEF) }

// Clzero emits CLZERO (0F 01 FC); see sys.bni.
func Clzero(a @asm.Assembler) { emit0F01(a, 0xFC) }

// Rsm emits RSM (0F AA); see sys.bni.
func Rsm(a @asm.Assembler) { emit0F(a, 0xAA) }
