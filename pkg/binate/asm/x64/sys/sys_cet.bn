package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// Control-flow enforcement: the branch-target markers and the shadow-stack instructions.

// emitF3Op emits F3 0F op1 op2: a mandatory-F3 instruction of a fixed three-byte opcode.
func emitF3Op(a @asm.Assembler, op1 int, op2 int) {
	emit8(a, 0xF3)
	emit0F(a, op1)
	emit8(a, op2)
}

// Endbr64 emits ENDBR64 (F3 0F 1E FA); see sys.bni.
func Endbr64(a @asm.Assembler) { emitF3Op(a, 0x1E, 0xFA) }

// Endbr32 emits ENDBR32 (F3 0F 1E FB); see sys.bni.
func Endbr32(a @asm.Assembler) { emitF3Op(a, 0x1E, 0xFB) }

// Incssp emits INCSSPD / INCSSPQ (F3 [REX.W] 0F AE /5); see sys.bni.
func Incssp(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "incssp", 0xF3, 0xAE, 5, reg, 6, true)
}

// Rdssp emits RDSSPD / RDSSPQ (F3 [REX.W] 0F 1E /1); see sys.bni.
func Rdssp(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "rdssp", 0xF3, 0x1E, 1, reg, 6, true)
}

// Saveprevssp emits SAVEPREVSSP (F3 0F 01 EA); see sys.bni.
func Saveprevssp(a @asm.Assembler) { emitF3Op(a, 0x01, 0xEA) }

// Setssbsy emits SETSSBSY (F3 0F 01 E8); see sys.bni.
func Setssbsy(a @asm.Assembler) { emitF3Op(a, 0x01, 0xE8) }

// Rstorssp emits RSTORSSP m64 (F3 0F 01 /5); see sys.bni.
func Rstorssp(a @asm.Assembler, mem x64.Operand) {
	emitMem(a, "rstorssp", 0xF3, false, 0x01, 5, mem, x64.SZ64)
}

// Clrssbsy emits CLRSSBSY m64 (F3 0F AE /6); see sys.bni.
func Clrssbsy(a @asm.Assembler, mem x64.Operand) {
	emitMem(a, "clrssbsy", 0xF3, false, 0xAE, 6, mem, x64.SZ64)
}

// emitStore38 emits mnem mem, src: legacy prefix pfx (0 for none), REX (W at 64 bits), 0F 38 op
// /r, src a 32- or 64-bit register in ModR/M's reg field and mem memory of its size in r/m.
func emitStore38(a @asm.Assembler, mnem *[]readonly char, pfx int, op int, mem x64.Operand,
		src x64.Operand) {
	if (!isGpr(src, x64.SZ32) && !isGpr(src, x64.SZ64)) || !isMemOf(mem, src.Size) {
		x64.OperandError(a, mnem, "takes memory and a 32- or 64-bit register of its size")
		return
	}
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, src.Size == x64.SZ64, src.Reg, mem, false)
	emit0F(a, 0x38)
	emit8(a, op)
	x64.EmitModRM(a, src.Reg, mem)
}

// Wrss emits WRSSD / WRSSQ m, r ([REX.W] 0F 38 F6 /r); see sys.bni.
func Wrss(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitStore38(a, "wrss", 0, 0xF6, mem, src)
}

// Wruss emits WRUSSD / WRUSSQ m, r (66 [REX.W] 0F 38 F5 /r); see sys.bni.
func Wruss(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitStore38(a, "wruss", 0x66, 0xF5, mem, src)
}
