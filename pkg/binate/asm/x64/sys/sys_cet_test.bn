package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// Control-flow enforcement against clang (see sys_test.bn); RSTORSSP and CLRSSBSY's qword against
// GNU as (the SDM's m64; clang takes a dword).

// Each instruction, at both register sizes, R8..R15 in each field.
func TestShadowStack() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Endbr64(a)
	Endbr32(a)
	Incssp(a, r32(x64.RAX))
	Incssp(a, r64(x64.RAX))
	Incssp(a, r32(x64.R9))
	Rdssp(a, r32(x64.RAX))
	Rdssp(a, r64(x64.RAX))
	Rdssp(a, r64(x64.R9))
	Saveprevssp(a)
	Setssbsy(a)
	var e @[]char = sysCase("", a, "endbr .. setssbsy",
			"f30f1efa f30f1efb f30faee8 f3480faee8 f3410faee9 f30f1ec8 f3480f1ec8 f3490f1ec9 f30f01ea "
					"f30f01e8")
	a = newAsm()
	Rstorssp(a, mem(x64.RAX, 0))
	Rstorssp(a, mem(x64.RAX, x64.SZ64))
	Clrssbsy(a, mem(x64.RAX, 0))
	Clrssbsy(a, mem(x64.RAX, x64.SZ64))
	Wrss(a, mem(x64.RAX, x64.SZ32), r32(x64.RAX))
	Wrss(a, mem(x64.RAX, 0), r64(x64.RAX))
	Wrss(a, mem(x64.R9, 0), r64(x64.R10))
	Wruss(a, mem(x64.RAX, 0), r32(x64.RAX))
	Wruss(a, mem(x64.RAX, x64.SZ64), r64(x64.RAX))
	e = sysCase(e, a, "rstorssp .. wruss",
			"f30f0128 f30f0128 f30fae30 f30fae30 0f38f600 480f38f600 4d0f38f611 660f38f500 66480f38f500")
	a = newAsm()
	Rstorssp(a, mem(x64.RAX, x64.SZ32))
	e = rejectCase(e, a, "rstorssp dword ptr [rax]")
	a = newAsm()
	Clrssbsy(a, mem(x64.RAX, x64.SZ32))
	e = rejectCase(e, a, "clrssbsy dword ptr [rax]")
	a = newAsm()
	Incssp(a, r16(x64.RAX))
	e = rejectCase(e, a, "incssp ax")
	a = newAsm()
	Wrss(a, mem(x64.RAX, x64.SZ64), r32(x64.RAX))
	e = rejectCase(e, a, "wrssd qword ptr [rax], eax")
	a = newAsm()
	Wrss(a, r64(x64.RBX), r64(x64.RAX))
	e = rejectCase(e, a, "wrssq rbx, rax")
	return e
}
