package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The cryptographic extensions without XMM operands: Key Locker's key-handle instructions and VIA
// PadLock's.

// emitEncodekey emits ENCODEKEY128 or ENCODEKEY256 (mnem): F3 [REX] 0F 38 op /r, dst in ModR/M's
// reg field and src in r/m, both 32-bit registers.
func emitEncodekey(a @asm.Assembler, mnem *[]readonly char, op int, dst x64.Operand,
		src x64.Operand) {
	if !isGpr(dst, x64.SZ32) || !isGpr(src, x64.SZ32) {
		x64.OperandError(a, mnem, "takes two 32-bit registers")
		return
	}
	emit8(a, 0xF3)
	x64.EmitRexRM(a, false, dst.Reg, src, false)
	emit0F(a, 0x38)
	emit8(a, op)
	x64.EmitModRM(a, dst.Reg, src)
}

// Encodekey128 emits ENCODEKEY128 r32, r32 (F3 0F 38 FA /r); see sys.bni.
func Encodekey128(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitEncodekey(a, "encodekey128", 0xFA, dst, src)
}

// Encodekey256 emits ENCODEKEY256 r32, r32 (F3 0F 38 FB /r); see sys.bni.
func Encodekey256(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitEncodekey(a, "encodekey256", 0xFB, dst, src)
}

// emitWideKl emits the wide Key Locker instruction mnem: F3 [REX] 0F 38 D8 /ext, mem memory of any
// size.
func emitWideKl(a @asm.Assembler, mnem *[]readonly char, ext int, mem x64.Operand) {
	if !isMemOf(mem, -1) {
		x64.OperandError(a, mnem, "takes a memory operand")
		return
	}
	emit8(a, 0xF3)
	x64.EmitRexRM(a, false, ext, mem, false)
	emit0F(a, 0x38)
	emit8(a, 0xD8)
	x64.EmitModRM(a, ext, mem)
}

// Aesencwide128kl emits AESENCWIDE128KL m384 (F3 0F 38 D8 /0); see sys.bni.
func Aesencwide128kl(a @asm.Assembler, mem x64.Operand) { emitWideKl(a, "aesencwide128kl", 0, mem) }

// Aesdecwide128kl emits AESDECWIDE128KL m384 (F3 0F 38 D8 /1); see sys.bni.
func Aesdecwide128kl(a @asm.Assembler, mem x64.Operand) { emitWideKl(a, "aesdecwide128kl", 1, mem) }

// Aesencwide256kl emits AESENCWIDE256KL m512 (F3 0F 38 D8 /2); see sys.bni.
func Aesencwide256kl(a @asm.Assembler, mem x64.Operand) { emitWideKl(a, "aesencwide256kl", 2, mem) }

// Aesdecwide256kl emits AESDECWIDE256KL m512 (F3 0F 38 D8 /3); see sys.bni.
func Aesdecwide256kl(a @asm.Assembler, mem x64.Operand) { emitWideKl(a, "aesdecwide256kl", 3, mem) }

// emitPadlock emits the PadLock instruction 0F op op2, after F3 when f3.
func emitPadlock(a @asm.Assembler, f3 bool, op int, op2 int) {
	if f3 { emit8(a, 0xF3) }
	emit0F(a, op)
	emit8(a, op2)
}

// Xstore emits XSTORE (0F A7 C0); see sys.bni.
func Xstore(a @asm.Assembler) { emitPadlock(a, false, 0xA7, 0xC0) }

// Xcryptecb emits XCRYPTECB (F3 0F A7 C8); see sys.bni.
func Xcryptecb(a @asm.Assembler) { emitPadlock(a, true, 0xA7, 0xC8) }

// Xcryptcbc emits XCRYPTCBC (F3 0F A7 D0); see sys.bni.
func Xcryptcbc(a @asm.Assembler) { emitPadlock(a, true, 0xA7, 0xD0) }

// Xcryptctr emits XCRYPTCTR (F3 0F A7 D8); see sys.bni.
func Xcryptctr(a @asm.Assembler) { emitPadlock(a, true, 0xA7, 0xD8) }

// Xcryptcfb emits XCRYPTCFB (F3 0F A7 E0); see sys.bni.
func Xcryptcfb(a @asm.Assembler) { emitPadlock(a, true, 0xA7, 0xE0) }

// Xcryptofb emits XCRYPTOFB (F3 0F A7 E8); see sys.bni.
func Xcryptofb(a @asm.Assembler) { emitPadlock(a, true, 0xA7, 0xE8) }

// Montmul emits MONTMUL (F3 0F A6 C0); see sys.bni.
func Montmul(a @asm.Assembler) { emitPadlock(a, true, 0xA6, 0xC0) }

// Xsha1 emits XSHA1 (F3 0F A6 C8); see sys.bni.
func Xsha1(a @asm.Assembler) { emitPadlock(a, true, 0xA6, 0xC8) }

// Xsha256 emits XSHA256 (F3 0F A6 D0); see sys.bni.
func Xsha256(a @asm.Assembler) { emitPadlock(a, true, 0xA6, 0xD0) }
