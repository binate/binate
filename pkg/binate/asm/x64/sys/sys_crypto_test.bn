package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// Key Locker's handle forms and PadLock against clang (see sys_test.bn).

// ENCODEKEY128 / 256 with R8..R15 in each field; the wide forms with memory of any size and an
// indexed address; what clang rejects (64-bit or memory operands, a register for the handle).
func TestKeyLocker() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Encodekey128(a, r32(x64.RAX), r32(x64.RBX))
	Encodekey128(a, r32(x64.R9), r32(x64.R10))
	Encodekey256(a, r32(x64.RAX), r32(x64.RBX))
	Aesencwide128kl(a, mem(x64.RAX, 0))
	Aesdecwide128kl(a, mem(x64.RAX, x64.SZ64))
	Aesencwide256kl(a, mem(x64.RAX, x64.SZ8))
	Aesdecwide256kl(a, mem(x64.RAX, 0))
	Aesencwide128kl(a, x64.MemIdx(x64.R9, x64.R10, 2, 8, 0))
	var e @[]char = sysCase("", a, "encodekey .. aesdecwide256kl",
			"f30f38fac3 f3450f38faca f30f38fbc3 f30f38d800 f30f38d808 f30f38d810 f30f38d818 "
					"f3430f38d8445108")
	a = newAsm()
	Encodekey128(a, r64(x64.RAX), r64(x64.RBX))
	e = rejectCase(e, a, "encodekey128 rax, rbx")
	a = newAsm()
	Encodekey128(a, r32(x64.RAX), mem(x64.RBX, 0))
	e = rejectCase(e, a, "encodekey128 eax, [rbx]")
	a = newAsm()
	Aesencwide128kl(a, r64(x64.RAX))
	e = rejectCase(e, a, "aesencwide128kl rax")
	return e
}

// Each PadLock instruction, its F3 its own but XSTORE's.
func TestPadlock() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Xstore(a)
	Xcryptecb(a)
	Xcryptcbc(a)
	Xcryptctr(a)
	Xcryptcfb(a)
	Xcryptofb(a)
	Montmul(a)
	Xsha1(a)
	Xsha256(a)
	return sysCase("", a, "xstore .. xsha256",
			"0fa7c0 f30fa7c8 f30fa7d0 f30fa7d8 f30fa7e0 f30fa7e8 f30fa6c0 f30fa6c8 f30fa6d0")
}
