package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// User wait, direct stores and enqueue, user interrupts and the other system extensions.

// Umonitor emits UMONITOR r64 (F3 0F AE /6); see sys.bni.
func Umonitor(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "umonitor", 0xF3, 0xAE, 6, reg, 4, false)
}

// Umwait emits UMWAIT r32 (F2 0F AE /6); see sys.bni.
func Umwait(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "umwait", 0xF2, 0xAE, 6, reg, 6, false)
}

// Tpause emits TPAUSE r32 (66 0F AE /6); see sys.bni.
func Tpause(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "tpause", 0x66, 0xAE, 6, reg, 6, false)
}

// Movdiri emits MOVDIRI m, r ([REX.W] 0F 38 F9 /r); see sys.bni.
func Movdiri(a @asm.Assembler, mem x64.Operand, src x64.Operand) {
	emitStore38(a, "movdiri", 0, 0xF9, mem, src)
}

// emitStore64B emits MOVDIR64B, ENQCMD or ENQCMDS (mnem; prefix pfx, 0F 38 F8 /r): dst a 64-bit
// register, mem memory of size 0.
func emitStore64B(a @asm.Assembler, mnem *[]readonly char, pfx int, dst x64.Operand,
		mem x64.Operand) {
	if !isGpr(dst, x64.SZ64) || !isMemOf(mem, 0) {
		x64.OperandError(a, mnem, "takes a 64-bit register and memory without a size")
		return
	}
	emit8(a, pfx)
	x64.EmitRexRM(a, false, dst.Reg, mem, false)
	emit0F(a, 0x38)
	emit8(a, 0xF8)
	x64.EmitModRM(a, dst.Reg, mem)
}

// Movdir64b emits MOVDIR64B r64, m512 (66 0F 38 F8 /r); see sys.bni.
func Movdir64b(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitStore64B(a, "movdir64b", 0x66, dst, mem)
}

// Enqcmd emits ENQCMD r64, m512 (F2 0F 38 F8 /r); see sys.bni.
func Enqcmd(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitStore64B(a, "enqcmd", 0xF2, dst, mem)
}

// Enqcmds emits ENQCMDS r64, m512 (F3 0F 38 F8 /r); see sys.bni.
func Enqcmds(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitStore64B(a, "enqcmds", 0xF3, dst, mem)
}

// Serialize emits SERIALIZE (0F 01 E8); see sys.bni.
func Serialize(a @asm.Assembler) { emit0F01(a, 0xE8) }

// Hreset emits HRESET imm8 (F3 0F 3A F0 C0 ib); see sys.bni.
func Hreset(a @asm.Assembler, imm x64.Operand) {
	if !x64.ImmOk(a, "hreset", imm, x64.SZ8) { return }
	emitF3Op(a, 0x3A, 0xF0)
	emit8(a, 0xC0)
	x64.EmitImm(a, "hreset", imm, x64.SZ8)
}

// Uiret emits UIRET (F3 0F 01 EC); see sys.bni.
func Uiret(a @asm.Assembler) { emitF3Op(a, 0x01, 0xEC) }

// Testui emits TESTUI (F3 0F 01 ED); see sys.bni.
func Testui(a @asm.Assembler) { emitF3Op(a, 0x01, 0xED) }

// Clui emits CLUI (F3 0F 01 EE); see sys.bni.
func Clui(a @asm.Assembler) { emitF3Op(a, 0x01, 0xEE) }

// Stui emits STUI (F3 0F 01 EF); see sys.bni.
func Stui(a @asm.Assembler) { emitF3Op(a, 0x01, 0xEF) }

// Senduipi emits SENDUIPI r64 (F3 0F C7 /6); see sys.bni.
func Senduipi(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "senduipi", 0xF3, 0xC7, 6, reg, 4, false)
}

// Ptwrite emits PTWRITE r/m (F3 [REX.W] 0F AE /4); see sys.bni.
func Ptwrite(a @asm.Assembler, src x64.Operand) {
	var size int = 0
	if isGpr(src, x64.SZ32) || isGpr(src, x64.SZ64) { size = src.Size }
	if x64.IsMem(src) && (src.Size == x64.SZ32 || src.Size == x64.SZ64) { size = src.Size }
	if size == 0 {
		x64.OperandError(a, "ptwrite", "takes a 32- or 64-bit register or memory of either size")
		return
	}
	emit8(a, 0xF3)
	x64.EmitRexRM(a, size == x64.SZ64, 4, src, false)
	emit0F(a, 0xAE)
	x64.EmitModRM(a, 4, src)
}

// Lkgs emits LKGS r/m16 (F2 0F 00 /6); see sys.bni.
func Lkgs(a @asm.Assembler, src x64.Operand) {
	if !isGpr(src, x64.SZ16) && !isMemOf(src, x64.SZ16) {
		x64.OperandError(a, "lkgs", "takes a 16-bit register or a word of memory")
		return
	}
	emit8(a, 0xF2)
	x64.EmitRexRM(a, false, 6, src, false)
	emit0F(a, 0x00)
	x64.EmitModRM(a, 6, src)
}

// Pconfig emits PCONFIG (0F 01 C5); see sys.bni.
func Pconfig(a @asm.Assembler) { emit0F01(a, 0xC5) }

// Rdpru emits RDPRU (0F 01 FD); see sys.bni.
func Rdpru(a @asm.Assembler) { emit0F01(a, 0xFD) }

// Invlpgb emits INVLPGB (0F 01 FE); see sys.bni.
func Invlpgb(a @asm.Assembler) { emit0F01(a, 0xFE) }

// Tlbsync emits TLBSYNC (0F 01 FF); see sys.bni.
func Tlbsync(a @asm.Assembler) { emit0F01(a, 0xFF) }

// Pbndkb emits PBNDKB (0F 01 C7); see sys.bni.
func Pbndkb(a @asm.Assembler) { emit0F01(a, 0xC7) }

// Erets emits ERETS (F2 0F 01 CA); see sys.bni.
func Erets(a @asm.Assembler) {
	emit8(a, 0xF2)
	emit0F01(a, 0xCA)
}

// Eretu emits ERETU (F3 0F 01 CA); see sys.bni.
func Eretu(a @asm.Assembler) { emitF3Op(a, 0x01, 0xCA) }
