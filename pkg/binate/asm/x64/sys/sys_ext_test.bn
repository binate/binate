package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The other system extensions against clang (see sys_test.bn).

// User wait, direct stores and enqueue: registers 8..15, UMWAIT / TPAUSE's 64-bit register (the
// same encoding, as clang takes it).
func TestUserWaitAndStores() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Umonitor(a, r64(x64.RAX))
	Umonitor(a, r64(x64.R9))
	Umwait(a, r32(x64.RAX))
	Umwait(a, r32(x64.R9))
	Umwait(a, r64(x64.RAX))
	Tpause(a, r32(x64.RBX))
	Tpause(a, r32(x64.R10))
	Tpause(a, r64(x64.RAX))
	var e @[]char = sysCase("", a, "umonitor / umwait / tpause",
			"f30faef0 f3410faef1 f20faef0 f2410faef1 f20faef0 660faef3 66410faef2 660faef0")
	a = newAsm()
	Movdiri(a, mem(x64.RAX, 0), r32(x64.RAX))
	Movdiri(a, mem(x64.RAX, x64.SZ64), r64(x64.RAX))
	Movdiri(a, mem(x64.R9, 0), r32(x64.R10))
	Movdir64b(a, r64(x64.RAX), mem(x64.RBX, 0))
	Movdir64b(a, r64(x64.R9), mem(x64.R10, 0))
	Enqcmd(a, r64(x64.RAX), mem(x64.RBX, 0))
	Enqcmds(a, r64(x64.R9), mem(x64.R10, 0))
	e = sysCase(e, a, "movdiri .. enqcmds",
			"0f38f900 480f38f900 450f38f911 660f38f803 66450f38f80a f20f38f803 f3450f38f80a")
	a = newAsm()
	Umonitor(a, r32(x64.RAX))
	e = rejectCase(e, a, "umonitor eax (a 32-bit address)")
	a = newAsm()
	Movdir64b(a, r64(x64.RAX), mem(x64.RBX, x64.SZ128))
	e = rejectCase(e, a, "movdir64b rax, xmmword ptr [rbx]")
	a = newAsm()
	Movdiri(a, mem(x64.RAX, x64.SZ64), r32(x64.RAX))
	e = rejectCase(e, a, "movdiri qword ptr [rax], eax")
	return e
}

// SERIALIZE, HRESET's imm8, user interrupts, PTWRITE (a register or sized memory), LKGS and the
// instructions without operands.
func TestOtherExtensions() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Serialize(a)
	Hreset(a, x64.Imm(1))
	Hreset(a, x64.Imm(255))
	Hreset(a, x64.Imm(-128))
	Uiret(a)
	Testui(a)
	Clui(a)
	Stui(a)
	Senduipi(a, r64(x64.RAX))
	Senduipi(a, r64(x64.R9))
	var e @[]char = sysCase("", a, "serialize .. senduipi",
			"0f01e8 f30f3af0c001 f30f3af0c0ff f30f3af0c080 f30f01ec f30f01ed f30f01ee f30f01ef f30fc7f0 "
					"f3410fc7f1")
	a = newAsm()
	Ptwrite(a, r32(x64.RAX))
	Ptwrite(a, r64(x64.RAX))
	Ptwrite(a, r64(x64.R9))
	Ptwrite(a, mem(x64.RAX, x64.SZ32))
	Ptwrite(a, mem(x64.RAX, x64.SZ64))
	Lkgs(a, r16(x64.RAX))
	Lkgs(a, mem(x64.RAX, x64.SZ16))
	Lkgs(a, r16(x64.R9))
	e = sysCase(e, a, "ptwrite / lkgs",
			"f30faee0 f3480faee0 f3490faee1 f30fae20 f3480fae20 f20f00f0 f20f0030 f2410f00f1")
	a = newAsm()
	Pconfig(a)
	Rdpru(a)
	Invlpgb(a)
	Tlbsync(a)
	Pbndkb(a)
	Erets(a)
	Eretu(a)
	e = sysCase(e, a, "pconfig .. eretu", "0f01c5 0f01fd 0f01fe 0f01ff 0f01c7 f20f01ca f30f01ca")
	a = newAsm()
	Hreset(a, x64.Imm(256))
	e = rejectCase(e, a, "hreset 256")
	a = newAsm()
	Senduipi(a, r32(x64.RAX))
	e = rejectCase(e, a, "senduipi eax")
	a = newAsm()
	Ptwrite(a, mem(x64.RAX, 0))
	e = rejectCase(e, a, "ptwrite [rax] (no size)")
	a = newAsm()
	Ptwrite(a, mem(x64.RAX, x64.SZ16))
	e = rejectCase(e, a, "ptwrite word ptr [rax]")
	a = newAsm()
	Lkgs(a, r32(x64.RAX))
	e = rejectCase(e, a, "lkgs eax")
	return e
}
