package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// AMD's lightweight profiling: XOP-encoded, opcode 12 in maps 9 and 10.

// emitLwpcb emits LLWPCB or SLWPCB (mnem): XOP.map9.W 12 /ext, reg a 32- or 64-bit register in
// r/m.
func emitLwpcb(a @asm.Assembler, mnem *[]readonly char, ext int, reg x64.Operand) {
	if !isGpr(reg, x64.SZ32) && !isGpr(reg, x64.SZ64) {
		x64.OperandError(a, mnem, "takes a 32- or 64-bit register")
		return
	}
	vex.EmitXop(a, vex.XOP_MAP9, reg.Size == x64.SZ64, 0, ext, 0, reg)
	emit8(a, 0x12)
	x64.EmitModRM(a, ext, reg)
}

// Llwpcb emits LLWPCB reg (XOP.map9 12 /0); see sys.bni.
func Llwpcb(a @asm.Assembler, reg x64.Operand) { emitLwpcb(a, "llwpcb", 0, reg) }

// Slwpcb emits SLWPCB reg (XOP.map9 12 /1); see sys.bni.
func Slwpcb(a @asm.Assembler, reg x64.Operand) { emitLwpcb(a, "slwpcb", 1, reg) }

// emitLwpRecord emits LWPINS or LWPVAL (mnem): XOP.mapA.W 12 /ext id, dst in VEX.vvvv, src (r/m32)
// in r/m and imm the imm32.
func emitLwpRecord(a @asm.Assembler, mnem *[]readonly char, ext int, dst x64.Operand,
		src x64.Operand, imm x64.Operand) {
	var srcOk bool = isGpr(src, x64.SZ32) ||
			(x64.IsMem(src) && (src.Size == 0 || src.Size == x64.SZ32))
	if (!isGpr(dst, x64.SZ32) && !isGpr(dst, x64.SZ64)) || !srcOk || imm.Kind != x64.OP_IMM {
		x64.OperandError(a, mnem,
				"takes a 32- or 64-bit register, a 32-bit register or dword of memory, and an immediate")
		return
	}
	if !x64.ImmOk(a, mnem, imm, x64.SZ32) { return }
	vex.EmitXop(a, vex.XOP_MAPA, dst.Size == x64.SZ64, 0, ext, dst.Reg, src)
	emit8(a, 0x12)
	x64.EmitModRMImm(a, ext, src, 4)
	x64.EmitImm(a, mnem, imm, x64.SZ32)
}

// Lwpins emits LWPINS dst, src, imm32 (XOP.mapA 12 /0 id); see sys.bni.
func Lwpins(a @asm.Assembler, dst x64.Operand, src x64.Operand, imm x64.Operand) {
	emitLwpRecord(a, "lwpins", 0, dst, src, imm)
}

// Lwpval emits LWPVAL dst, src, imm32 (XOP.mapA 12 /1 id); see sys.bni.
func Lwpval(a @asm.Assembler, dst x64.Operand, src x64.Operand, imm x64.Operand) {
	emitLwpRecord(a, "lwpval", 1, dst, src, imm)
}
