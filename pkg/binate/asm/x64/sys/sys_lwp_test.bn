package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// AMD's lightweight profiling against clang (see sys_test.bn).

// LLWPCB / SLWPCB at both sizes and with R8..R15; LWPINS / LWPVAL at both sizes, with a register or
// memory r/m32, R8..R15 in vvvv and r/m, the imm32's range and a symbol's; what clang rejects.
func TestLwp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Llwpcb(a, r32(x64.RAX))
	Llwpcb(a, r64(x64.RAX))
	Llwpcb(a, r64(x64.R9))
	Slwpcb(a, r64(x64.RAX))
	Slwpcb(a, r32(x64.R9))
	var e @[]char = sysCase("", a, "llwpcb / slwpcb",
			"8fe97812c0 8fe9f812c0 8fc9f812c1 8fe9f812c8 8fc97812c9")
	a = newAsm()
	Lwpins(a, r32(x64.RAX), r32(x64.RBX), x64.Imm(1))
	Lwpins(a, r32(x64.RAX), mem(x64.RBX, x64.SZ32), x64.Imm(1))
	Lwpins(a, r64(x64.RAX), r32(x64.RBX), x64.Imm(0x12345678))
	Lwpins(a, r64(x64.R9), r32(x64.R10), x64.Imm(1))
	Lwpval(a, r32(x64.RAX), r32(x64.RBX), x64.Imm64(0xFFFFFFFF))
	Lwpval(a, r64(x64.RAX), mem(x64.R9, 0), x64.Imm(-1))
	e = sysCase(e, a, "lwpins / lwpval",
			"8fea7812c301000000 8fea78120301000000 8feaf812c378563412 8fcab012c201000000 8fea7812cbffffffff "
					"8fcaf81209ffffffff")
	a = newAsm()
	Lwpins(a, r32(x64.RAX), r32(x64.RBX), x64.ImmSym("x", 0, 0))
	e = sysCase(e, a, "lwpins eax, ebx, offset x", "8fea7812c300000000")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != asm.FIX_DATA_ABS32 ||
			a.Sections[0].Fixups[0].Offset != 5 {
		e = buf.Concat(e, "lwpins eax, ebx, offset x: not its imm32's fixup; ")
	}
	a = newAsm()
	Lwpins(a, r64(x64.RAX), r64(x64.RBX), x64.Imm(1))
	e = rejectCase(e, a, "lwpins rax, rbx, 1")
	a = newAsm()
	Lwpins(a, r32(x64.RAX), mem(x64.RBX, x64.SZ64), x64.Imm(1))
	e = rejectCase(e, a, "lwpins eax, qword ptr [rbx], 1")
	a = newAsm()
	Lwpins(a, r32(x64.RAX), r32(x64.RBX), x64.Imm64(0x100000000))
	e = rejectCase(e, a, "lwpins eax, ebx, 0x100000000")
	a = newAsm()
	Llwpcb(a, mem(x64.RAX, 0))
	e = rejectCase(e, a, "llwpcb [rax]")
	a = newAsm()
	Slwpcb(a, r16(x64.RAX))
	e = rejectCase(e, a, "slwpcb ax")
	return e
}
