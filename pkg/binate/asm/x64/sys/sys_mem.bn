// Fxrstor emits FXRSTOR / FXRSTOR64 mem (0F AE /1); see sys.bni.
func Fxrstor(a @asm.Assembler, mem x64.Operand, w64 bool) {
	emitMem(a, wide(w64, "fxrstor", "fxrstor64"), 0, w64, 0xAE, 1, mem, -1)
}

// wide returns name64 when w64 is set, else name: a state save or restore's mnemonic.
func wide(w64 bool, name *[]readonly char, name64 *[]readonly char) *[]readonly char {
	if w64 { return name64 }
	return name
}

