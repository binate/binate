// Xsave emits XSAVE / XSAVE64 mem (0F AE /4); see sys.bni.
func Xsave(a @asm.Assembler, mem x64.Operand, w64 bool) {
	emitMem(a, wide(w64, "xsave", "xsave64"), 0, w64, 0xAE, 4, mem, -1)
}

