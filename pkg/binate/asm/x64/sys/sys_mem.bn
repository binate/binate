package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The system instructions with a memory operand: [pfx] [REX] 0F op /ext.

// sizeText returns how an instruction's memory operand of size bits (-1: any) is described in its
// error.
func sizeText(size int) *[]readonly char {
	if size == x64.SZ8 { return "takes a byte of memory" }
	if size == x64.SZ16 { return "takes a word of memory" }
	if size == x64.SZ32 { return "takes a dword of memory" }
	if size == x64.SZ128 { return "takes an xmmword of memory" }
	return "takes a memory operand"
}

// emitMem emits mnem mem: legacy prefix pfx (0 for none), a REX (W when w64), 0F op and the ModR/M
// of opcode extension ext and mem, memory of size bits or of size 0 (size -1: any size) — else
// sets mnem's error and emits nothing.
func emitMem(a @asm.Assembler, mnem *[]readonly char, pfx int, w64 bool, op int, ext int,
		mem x64.Operand, size int) {
	if !isMemOf(mem, size) {
		x64.OperandError(a, mnem, sizeText(size))
		return
	}
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, w64, ext, mem, false)
	emit0F(a, op)
	x64.EmitModRM(a, ext, mem)
}

// Lgdt emits LGDT mem (0F 01 /2); see sys.bni.
func Lgdt(a @asm.Assembler, mem x64.Operand) { emitMem(a, "lgdt", 0, false, 0x01, 2, mem, -1) }

// Lidt emits LIDT mem (0F 01 /3); see sys.bni.
func Lidt(a @asm.Assembler, mem x64.Operand) { emitMem(a, "lidt", 0, false, 0x01, 3, mem, -1) }

// Sgdt emits SGDT mem (0F 01 /0); see sys.bni.
func Sgdt(a @asm.Assembler, mem x64.Operand) { emitMem(a, "sgdt", 0, false, 0x01, 0, mem, -1) }

// Sidt emits SIDT mem (0F 01 /1); see sys.bni.
func Sidt(a @asm.Assembler, mem x64.Operand) { emitMem(a, "sidt", 0, false, 0x01, 1, mem, -1) }

// Invlpg emits INVLPG mem (0F 01 /7); see sys.bni.
func Invlpg(a @asm.Assembler, mem x64.Operand) {
	emitMem(a, "invlpg", 0, false, 0x01, 7, mem, x64.SZ8)
}

// Invpcid emits INVPCID r64, m128 (66 0F 38 82 /r); see sys.bni.
func Invpcid(a @asm.Assembler, reg x64.Operand, mem x64.Operand) {
	if !isGpr(reg, x64.SZ64) || !isMemOf(mem, x64.SZ128) {
		x64.OperandError(a, "invpcid", "takes a 64-bit register and an xmmword of memory")
		return
	}
	emit8(a, 0x66)
	x64.EmitRexRM(a, false, reg.Reg, mem, false)
	emit0F(a, 0x38)
	emit8(a, 0x82)
	x64.EmitModRM(a, reg.Reg, mem)
}

// Prefetcht0 emits PREFETCHT0 mem (0F 18 /1); see sys.bni.
func Prefetcht0(a @asm.Assembler, mem x64.Operand) {
	emitMem(a, "prefetcht0", 0, false, 0x18, 1, mem, x64.SZ8)
}

