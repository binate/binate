package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The memory forms against clang (see sys_test.bn): each opcode and extension, REX.X / REX.B,
// REX.W for the 64 forms, the sizes each takes.

// The descriptor tables (any size), INVLPG and INVPCID.
func TestDescriptorTables() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Lgdt(a, mem(x64.RAX, 0))
	Lidt(a, mem(x64.RAX, 0))
	Sgdt(a, mem(x64.RAX, 0))
	Sidt(a, mem(x64.RAX, 0))
	Lgdt(a, mem(x64.RAX, x64.SZ48))
	Lgdt(a, mem(x64.RAX, x64.SZ80))
	Sgdt(a, mem(x64.RAX, x64.SZ8))
	Invlpg(a, mem(x64.RAX, x64.SZ8))
	var e @[]char = sysCase("", a, "lgdt .. invlpg",
			"0f0110 0f0118 0f0100 0f0108 0f0110 0f0110 0f0100 0f0138")
	a = newAsm()
	Invpcid(a, r64(x64.RAX), mem(x64.RBX, x64.SZ128))
	Invpcid(a, r64(x64.R9), mem(x64.R10, 0))
	e = sysCase(e, a, "invpcid", "660f388203 66450f38820a")
	a = newAsm()
	Lgdt(a, x64.RipGotLabel("x"))
	e = sysCase(e, a, "lgdt [rip + x@GOTPCREL]", "0f011500000000")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != x64.FIX_GOTPCREL_PLAIN ||
			a.Sections[0].Fixups[0].Offset != 3 {
		e = buf.Concat(e, "lgdt [rip + x@GOTPCREL]: not its plain GOT fixup; ")
	}
	return e
}

// The prefetches and the cache-line instructions, on a byte (or memory of size 0).
func TestPrefetchAndCache() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Prefetcht0(a, mem(x64.RAX, x64.SZ8))
	Prefetcht1(a, mem(x64.RAX, 0))
	Prefetcht2(a, mem(x64.RAX, 0))
	Prefetchnta(a, mem(x64.RAX, 0))
	Prefetchw(a, mem(x64.RAX, 0))
	Prefetchwt1(a, mem(x64.RAX, 0))
	Prefetch(a, mem(x64.RAX, 0))
	Prefetchit0(a, mem(x64.RAX, 0))
	Prefetchit1(a, x64.Mem(x64.RBX, 8, 0))
	var e @[]char = sysCase("", a, "prefetches",
			"0f1808 0f1810 0f1818 0f1800 0f0d08 0f0d10 0f0d00 0f1838 0f187308")
	a = newAsm()
	Clflush(a, mem(x64.RAX, x64.SZ8))
	Clflushopt(a, x64.MemIdx(x64.R9, x64.R10, 4, 8, x64.SZ8))
	Clwb(a, mem(x64.RAX, 0))
	Cldemote(a, mem(x64.RAX, 0))
	e = sysCase(e, a, "cache lines", "0fae38 66430fae7c9108 660fae30 0f1c00")
	a = newAsm()
	var rip x64.Operand = x64.RipLabel("x")
	Prefetcht0(a, rip)
	e = sysCase(e, a, "prefetcht0 [rip + x]", "0f180d00000000")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != x64.FIX_REL32_LEA {
		e = buf.Concat(e, "prefetcht0 [rip + x]: not its rel32 fixup; ")
	}
	return e
}

// The state saves and restores, plain and 64 (REX.W), with R8..R15 bases; LDMXCSR / STMXCSR on a
// dword.
func TestProcessorState() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var m x64.Operand = mem(x64.RAX, 0)
	Xsave(a, m, false)
	Xsave(a, m, true)
	Xrstor(a, m, false)
	Xrstor(a, m, true)
	Xsaveopt(a, m, false)
	Xsaveopt(a, m, true)
	Xsavec(a, m, false)
	Xsavec(a, m, true)
	Xsaves(a, m, false)
	Xsaves(a, m, true)
	Xrstors(a, m, false)
	Xrstors(a, m, true)
	Fxsave(a, m, false)
	Fxsave(a, m, true)
	Fxrstor(a, m, false)
	Fxrstor(a, m, true)
	var e @[]char = sysCase("", a, "xsave .. fxrstor",
			"0fae20 480fae20 0fae28 480fae28 0fae30 480fae30 0fc720 480fc720 0fc728 480fc728 0fc718 "
					"480fc718 0fae00 480fae00 0fae08 480fae08")
	a = newAsm()
	Xsave(a, mem(x64.R9, x64.SZ64), false)
	Fxsave(a, x64.Mem(x64.R9, 8, 0), false)
	Fxsave(a, mem(x64.R9, 0), true)
	Ldmxcsr(a, mem(x64.RAX, x64.SZ32))
	Stmxcsr(a, mem(x64.RAX, 0))
	e = sysCase(e, a, "R9 bases, mxcsr", "410fae21 410fae4108 490fae01 0fae10 0fae18")
	return e
}

// A register where memory is wanted, memory of a size the instruction does not take, and a 32-bit
// register for INVPCID are errors, with nothing emitted.
func TestMemoryRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Lgdt(a, r64(x64.RAX))
	e = rejectCase(e, a, "lgdt rax")
	a = newAsm()
	Invlpg(a, mem(x64.RAX, x64.SZ64))
	e = rejectCase(e, a, "invlpg qword ptr [rax]")
	a = newAsm()
	Prefetcht0(a, mem(x64.RAX, x64.SZ64))
	e = rejectCase(e, a, "prefetcht0 qword ptr [rax]")
	a = newAsm()
	Clflush(a, mem(x64.RAX, x64.SZ64))
	e = rejectCase(e, a, "clflush qword ptr [rax]")
	a = newAsm()
	Stmxcsr(a, mem(x64.RAX, x64.SZ64))
	e = rejectCase(e, a, "stmxcsr qword ptr [rax]")
	a = newAsm()
	Invpcid(a, r32(x64.RAX), mem(x64.RBX, x64.SZ128))
	e = rejectCase(e, a, "invpcid eax, xmmword ptr [rbx]")
	a = newAsm()
	Invpcid(a, r64(x64.RAX), mem(x64.RBX, x64.SZ64))
	e = rejectCase(e, a, "invpcid rax, qword ptr [rbx]")
	a = newAsm()
	Xsave(a, x64.Imm(0), false)
	e = rejectCase(e, a, "xsave 0")
	return e
}

// A 64 form's error names it: `xsave64`, not `xsave`.
func TestWideFormErrorName() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Xsave(a, r64(x64.RAX), true)
	if !hasPrefix(a.ErrorMsg, "x64: xsave64:") {
		return "xsave64 rax: the error does not name xsave64"
	}
	return ""
}

// hasPrefix reports whether s starts with p.
func hasPrefix(s *[]readonly char, p *[]readonly char) bool {
	if len(s) < len(p) { return false }
	for i := 0; i < len(p); i++ {
		if s[i] != p[i] { return false }
	}
	return true
}
