package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/vex"

// MSR access beyond RDMSR / WRMSR: WRMSRNS and the MSR lists, the forms with an immediate MSR
// number (VEX map 7), and the user MSRs.

// Wrmsrns emits WRMSRNS (0F 01 C6); see sys.bni.
func Wrmsrns(a @asm.Assembler) { emit0F01(a, 0xC6) }

// Rdmsrlist emits RDMSRLIST (F2 0F 01 C6); see sys.bni.
func Rdmsrlist(a @asm.Assembler) {
	emit8(a, 0xF2)
	emit0F01(a, 0xC6)
}

// Wrmsrlist emits WRMSRLIST (F3 0F 01 C6); see sys.bni.
func Wrmsrlist(a @asm.Assembler) { emitF3Op(a, 0x01, 0xC6) }

// emitMsrImm emits mnem with an immediate MSR number: VEX.pp.M7.W0 op /0 id, reg the 64-bit
// register in r/m and msr the imm32 (-2^31..2^32-1, or a symbol).
func emitMsrImm(a @asm.Assembler, mnem *[]readonly char, pp int, op int, reg x64.Operand,
		msr x64.Operand) {
	if !isGpr(reg, x64.SZ64) || msr.Kind != x64.OP_IMM {
		x64.OperandError(a, mnem, "takes a 64-bit register and an immediate MSR number")
		return
	}
	if !x64.ImmOk(a, mnem, msr, x64.SZ32) { return }
	vex.Emit(a, vex.MAP_7, pp, false, 0, 0, 0, reg)
	emit8(a, op)
	x64.EmitModRMImm(a, 0, reg, 4)
	x64.EmitImm(a, mnem, msr, x64.SZ32)
}

// emitMsrReg emits mnem with the MSR number in a register: pfx 0F 38 F8 /r, reg and rm 64-bit
// registers in ModR/M's reg and r/m fields.
func emitMsrReg(a @asm.Assembler, mnem *[]readonly char, pfx int, reg x64.Operand, rm x64.Operand) {
	if !isGpr(reg, x64.SZ64) || !isGpr(rm, x64.SZ64) {
		x64.OperandError(a, mnem, "takes two 64-bit registers, or a register and an immediate")
		return
	}
	emit8(a, pfx)
	x64.EmitRexRM(a, false, reg.Reg, rm, false)
	emit0F(a, 0x38)
	emit8(a, 0xF8)
	x64.EmitModRM(a, reg.Reg, rm)
}

// RdmsrImm emits RDMSR r64, imm32 (VEX.F2.M7.W0 F6 /0 id); see sys.bni.
func RdmsrImm(a @asm.Assembler, dst x64.Operand, msr x64.Operand) {
	emitMsrImm(a, "rdmsr", vex.PP_F2, 0xF6, dst, msr)
}

// WrmsrnsImm emits WRMSRNS imm32, r64 (VEX.F3.M7.W0 F6 /0 id); see sys.bni.
func WrmsrnsImm(a @asm.Assembler, msr x64.Operand, src x64.Operand) {
	emitMsrImm(a, "wrmsrns", vex.PP_F3, 0xF6, src, msr)
}

// Urdmsr emits URDMSR r64, r64 / imm32; see sys.bni.
func Urdmsr(a @asm.Assembler, dst x64.Operand, msr x64.Operand) {
	if msr.Kind == x64.OP_IMM {
		emitMsrImm(a, "urdmsr", vex.PP_F2, 0xF8, dst, msr)
		return
	}
	emitMsrReg(a, "urdmsr", 0xF2, dst, msr)
}

// Uwrmsr emits UWRMSR r64, r64 / imm32, r64; see sys.bni.
func Uwrmsr(a @asm.Assembler, msr x64.Operand, src x64.Operand) {
	if msr.Kind == x64.OP_IMM {
		emitMsrImm(a, "uwrmsr", vex.PP_F3, 0xF8, src, msr)
		return
	}
	emitMsrReg(a, "uwrmsr", 0xF3, msr, src)
}
