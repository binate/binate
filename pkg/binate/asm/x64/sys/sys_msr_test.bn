package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The MSR instructions against clang (see sys_test.bn); an MSR number from 0x80000000 up, which
// clang takes only written negative, against its negative spelling's bytes.

// WRMSRNS and the MSR lists; RDMSR / WRMSRNS with an immediate MSR (VEX map 7, REX.B as VEX.B);
// URDMSR / UWRMSR with a register or an immediate.
func TestMsrInstructions() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Wrmsrns(a)
	Rdmsrlist(a)
	Wrmsrlist(a)
	RdmsrImm(a, r64(x64.RAX), x64.Imm(0x10))
	RdmsrImm(a, r64(x64.R9), x64.Imm(0x10))
	WrmsrnsImm(a, x64.Imm(0x10), r64(x64.RAX))
	WrmsrnsImm(a, x64.Imm(0x10), r64(x64.R9))
	RdmsrImm(a, r64(x64.RAX), x64.Imm64(0xC0000080))
	var e @[]char = sysCase("", a, "wrmsrns .. rdmsr imm",
			"0f01c6 f20f01c6 f30f01c6 c4e77bf6c010000000 c4c77bf6c110000000 c4e77af6c010000000 "
					"c4c77af6c110000000 c4e77bf6c0800000c0")
	a = newAsm()
	Urdmsr(a, r64(x64.RAX), r64(x64.RBX))
	Urdmsr(a, r64(x64.R9), r64(x64.R10))
	Urdmsr(a, r64(x64.RAX), x64.Imm(0x12345678))
	Urdmsr(a, r64(x64.RAX), x64.Imm(-1))
	Uwrmsr(a, r64(x64.RBX), r64(x64.RAX))
	Uwrmsr(a, x64.Imm(0x1234), r64(x64.RAX))
	Uwrmsr(a, x64.Imm(-1), r64(x64.R9))
	e = sysCase(e, a, "urdmsr / uwrmsr",
			"f20f38f8c3 f2450f38f8ca c4e77bf8c078563412 c4e77bf8c0ffffffff f30f38f8d8 c4e77af8c034120000 "
					"c4c77af8c1ffffffff")
	a = newAsm()
	RdmsrImm(a, r64(x64.RAX), x64.ImmSym("x", 0, 0))
	e = sysCase(e, a, "rdmsr rax, offset x", "c4e77bf6c000000000")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != asm.FIX_DATA_ABS32 ||
			a.Sections[0].Fixups[0].Offset != 5 {
		e = buf.Concat(e, "rdmsr rax, offset x: not its imm32's fixup; ")
	}
	a = newAsm()
	RdmsrImm(a, r32(x64.RAX), x64.Imm(0x10))
	e = rejectCase(e, a, "rdmsr eax, 0x10")
	a = newAsm()
	RdmsrImm(a, r64(x64.RAX), x64.Imm64(0x100000000))
	e = rejectCase(e, a, "rdmsr rax, 0x100000000")
	a = newAsm()
	RdmsrImm(a, r64(x64.RAX), r64(x64.RBX))
	e = rejectCase(e, a, "rdmsr rax, rbx")
	a = newAsm()
	Urdmsr(a, r32(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "urdmsr eax, ebx")
	return e
}
