package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The system instructions on registers: the control, debug and segment register moves, the LDT,
// task register and machine status word forms, LAR / LSL, the register-only forms and port I/O.

// emitCrDr emits MOV between control or debug register n (0..15) and 64-bit register r: 0F op
// with n in ModR/M's reg field and r in r/m — else sets mnem's error and emits nothing.
func emitCrDr(a @asm.Assembler, mnem *[]readonly char, op int, n int, r x64.Operand) {
	if n < 0 || n > 15 || !isGpr(r, x64.SZ64) {
		x64.OperandError(a, mnem, "moves a control or debug register (0..15) and a 64-bit register")
		return
	}
	x64.EmitRexRM(a, false, n, r, false)
	emit0F(a, op)
	x64.EmitModRM(a, n, r)
}

// MovFromCr emits MOV r64, CRn (0F 20 /r); see sys.bni.
func MovFromCr(a @asm.Assembler, dst x64.Operand, cr int) { emitCrDr(a, "mov", 0x20, cr, dst) }

// MovToCr emits MOV CRn, r64 (0F 22 /r); see sys.bni.
func MovToCr(a @asm.Assembler, cr int, src x64.Operand) { emitCrDr(a, "mov", 0x22, cr, src) }

// MovFromDr emits MOV r64, DRn (0F 21 /r); see sys.bni.
func MovFromDr(a @asm.Assembler, dst x64.Operand, dr int) { emitCrDr(a, "mov", 0x21, dr, dst) }

// MovToDr emits MOV DRn, r64 (0F 23 /r); see sys.bni.
func MovToDr(a @asm.Assembler, dr int, src x64.Operand) { emitCrDr(a, "mov", 0x23, dr, src) }

// segRmOk reports whether seg is a segment register and rm a 16-, 32- or 64-bit register or a word
// of memory, else sets the error of a segment register move.
func segRmOk(a @asm.Assembler, seg int, rm x64.Operand) bool {
	if seg >= ES && seg <= GS && (isGprSized(rm) || isMemOf(rm, x64.SZ16)) { return true }
	x64.OperandError(a, "mov",
			"moves a segment register and a 16-, 32- or 64-bit register or a word of memory")
	return false
}

// MovFromSeg emits MOV r/m, Sreg (8C /r); see sys.bni.
func MovFromSeg(a @asm.Assembler, dst x64.Operand, seg int) {
	if !segRmOk(a, seg, dst) { return }
	x64.EmitRexRM(a, isGpr(dst, x64.SZ64), seg, dst, false)
	emit8(a, 0x8C)
	x64.EmitModRM(a, seg, dst)
}

// MovToSeg emits MOV Sreg, r/m (8E /r); see sys.bni.
func MovToSeg(a @asm.Assembler, seg int, src x64.Operand) {
	if !segRmOk(a, seg, src) { return }
	if isGpr(src, x64.SZ16) { emit8(a, 0x66) }
	x64.EmitRexRM(a, isGpr(src, x64.SZ64), seg, src, false)
	emit8(a, 0x8E)
	x64.EmitModRM(a, seg, src)
}

// emitSegStack emits the push or pop (op FS's: 0F A0 / 0F A1; GS's is 8 past) of seg at size bits.
func emitSegStack(a @asm.Assembler, mnem *[]readonly char, op int, seg int, size int) {
	if (seg != FS && seg != GS) || (size != x64.SZ64 && size != x64.SZ16) {
		x64.OperandError(a, mnem, "takes FS or GS (the others have no 64-bit-mode form), 64 or 16 bits")
		return
	}
	if size == x64.SZ16 { emit8(a, 0x66) }
	if seg == GS { op = op + 8 }
	emit0F(a, op)
}

// PushSeg emits PUSH FS / GS (0F A0 / 0F A8); see sys.bni.
func PushSeg(a @asm.Assembler, seg int, size int) { emitSegStack(a, "push", 0xA0, seg, size) }

// PopSeg emits POP FS / GS (0F A1 / 0F A9); see sys.bni.
func PopSeg(a @asm.Assembler, seg int, size int) { emitSegStack(a, "pop", 0xA1, seg, size) }

// emitFarLoad emits LFS, LGS or LSS (mnem, 0F op /r): dst a 16-, 32- or 64-bit register, mem
// memory of any size.
func emitFarLoad(a @asm.Assembler, mnem *[]readonly char, op int, dst x64.Operand,
		mem x64.Operand) {
	if !isGprSized(dst) || !isMemOf(mem, -1) {
		x64.OperandError(a, mnem, "takes a 16-, 32- or 64-bit register and a far pointer in memory")
		return
	}
	emitSized(a, dst.Size, dst.Reg, mem)
	emit0F(a, op)
	x64.EmitModRM(a, dst.Reg, mem)
}

// Lfs emits LFS r, m (0F B4 /r); see sys.bni.
func Lfs(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitFarLoad(a, "lfs", 0xB4, dst, mem)
}

// Lgs emits LGS r, m (0F B5 /r); see sys.bni.
func Lgs(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitFarLoad(a, "lgs", 0xB5, dst, mem)
}

// Lss emits LSS r, m (0F B2 /r); see sys.bni.
func Lss(a @asm.Assembler, dst x64.Operand, mem x64.Operand) {
	emitFarLoad(a, "lss", 0xB2, dst, mem)
}

// emitWord emits mnem src, src a 16-bit register or a word of memory: [REX] 0F op /ext.
func emitWord(a @asm.Assembler, mnem *[]readonly char, op int, ext int, src x64.Operand) {
	if !isGpr(src, x64.SZ16) && !isMemOf(src, x64.SZ16) {
		x64.OperandError(a, mnem, "takes a 16-bit register or a word of memory")
		return
	}
	x64.EmitRexRM(a, false, ext, src, false)
	emit0F(a, op)
	x64.EmitModRM(a, ext, src)
}

// Lldt emits LLDT r/m16 (0F 00 /2); see sys.bni.
func Lldt(a @asm.Assembler, src x64.Operand) { emitWord(a, "lldt", 0x00, 2, src) }

// Ltr emits LTR r/m16 (0F 00 /3); see sys.bni.
func Ltr(a @asm.Assembler, src x64.Operand) { emitWord(a, "ltr", 0x00, 3, src) }

// Verr emits VERR r/m16 (0F 00 /4); see sys.bni.
func Verr(a @asm.Assembler, src x64.Operand) { emitWord(a, "verr", 0x00, 4, src) }

// Verw emits VERW r/m16 (0F 00 /5); see sys.bni.
func Verw(a @asm.Assembler, src x64.Operand) { emitWord(a, "verw", 0x00, 5, src) }

// Lmsw emits LMSW r/m16 (0F 01 /6); see sys.bni.
func Lmsw(a @asm.Assembler, src x64.Operand) { emitWord(a, "lmsw", 0x01, 6, src) }

// emitStore emits mnem dst, dst a 16- (66), 32- or 64-bit (REX.W) register or a word of memory:
// 0F op /ext.
func emitStore(a @asm.Assembler, mnem *[]readonly char, op int, ext int, dst x64.Operand) {
	if !isGprSized(dst) && !isMemOf(dst, x64.SZ16) {
		x64.OperandError(a, mnem, "takes a 16-, 32- or 64-bit register or a word of memory")
		return
	}
	var size int = 0
	if dst.Kind == x64.OP_REG { size = dst.Size }
	emitSized(a, size, ext, dst)
	emit0F(a, op)
	x64.EmitModRM(a, ext, dst)
}

// Sldt emits SLDT r/m (0F 00 /0); see sys.bni.
func Sldt(a @asm.Assembler, dst x64.Operand) { emitStore(a, "sldt", 0x00, 0, dst) }

// Str emits STR r/m (0F 00 /1); see sys.bni.
func Str(a @asm.Assembler, dst x64.Operand) { emitStore(a, "str", 0x00, 1, dst) }

// Smsw emits SMSW r/m (0F 01 /4); see sys.bni.
func Smsw(a @asm.Assembler, dst x64.Operand) { emitStore(a, "smsw", 0x01, 4, dst) }

// emitSelector emits LAR or LSL (mnem, 0F op /r): dst a 16-, 32- or 64-bit register, src a
// register of any of those sizes or a word of memory.
func emitSelector(a @asm.Assembler, mnem *[]readonly char, op int, dst x64.Operand,
		src x64.Operand) {
	if !isGprSized(dst) || (!isGprSized(src) && !isMemOf(src, x64.SZ16)) {
		x64.OperandError(a, mnem,
				"takes a 16-, 32- or 64-bit register and a register or a word of memory")
		return
	}
	emitSized(a, dst.Size, dst.Reg, src)
	emit0F(a, op)
	x64.EmitModRM(a, dst.Reg, src)
}

// Lar emits LAR r, r/m (0F 02 /r); see sys.bni.
func Lar(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitSelector(a, "lar", 0x02, dst, src)
}

// Lsl emits LSL r, r/m (0F 03 /r); see sys.bni.
func Lsl(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitSelector(a, "lsl", 0x03, dst, src)
}

// emitRegOnly emits mnem r: legacy prefix pfx (0 for none), 0F op /ext with r in r/m, r a register
// of a size sizes allows (bit 0: 16, bit 1: 32, bit 2: 64), REX.W at 64 when w64; else the error.
func emitRegOnly(a @asm.Assembler, mnem *[]readonly char, pfx int, op int, ext int, r x64.Operand,
		sizes int, w64 bool) {
	var ok bool = (isGpr(r, x64.SZ16) && (sizes & 1) != 0) ||
			(isGpr(r, x64.SZ32) && (sizes & 2) != 0) || (isGpr(r, x64.SZ64) && (sizes & 4) != 0)
	if !ok {
		x64.OperandError(a, mnem, "takes a register of another size")
		return
	}
	if r.Size == x64.SZ16 { emit8(a, 0x66) }
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, w64 && r.Size == x64.SZ64, ext, r, false)
	emit0F(a, op)
	x64.EmitModRM(a, ext, r)
}

// Rdrand emits RDRAND r (0F C7 /6); see sys.bni.
func Rdrand(a @asm.Assembler, dst x64.Operand) {
	emitRegOnly(a, "rdrand", 0, 0xC7, 6, dst, 7, true)
}

// Rdseed emits RDSEED r (0F C7 /7); see sys.bni.
func Rdseed(a @asm.Assembler, dst x64.Operand) {
	emitRegOnly(a, "rdseed", 0, 0xC7, 7, dst, 7, true)
}

// Rdfsbase emits RDFSBASE r (F3 0F AE /0); see sys.bni.
func Rdfsbase(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "rdfsbase", 0xF3, 0xAE, 0, reg, 6, true)
}

// Rdgsbase emits RDGSBASE r (F3 0F AE /1); see sys.bni.
func Rdgsbase(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "rdgsbase", 0xF3, 0xAE, 1, reg, 6, true)
}

// Wrfsbase emits WRFSBASE r (F3 0F AE /2); see sys.bni.
func Wrfsbase(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "wrfsbase", 0xF3, 0xAE, 2, reg, 6, true)
}

// Wrgsbase emits WRGSBASE r (F3 0F AE /3); see sys.bni.
func Wrgsbase(a @asm.Assembler, reg x64.Operand) {
	emitRegOnly(a, "wrgsbase", 0xF3, 0xAE, 3, reg, 6, true)
}

// Rdpid emits RDPID r64 (F3 0F C7 /7); see sys.bni.
func Rdpid(a @asm.Assembler, dst x64.Operand) {
	emitRegOnly(a, "rdpid", 0xF3, 0xC7, 7, dst, 4, false)
}

// emitUd emits UD0 or UD1 (mnem, 0F op /r): reg a 16-, 32- or 64-bit register, rm a register or
// memory of its size (memory of size 0 takes it).
func emitUd(a @asm.Assembler, mnem *[]readonly char, op int, reg x64.Operand, rm x64.Operand) {
	if !isGprSized(reg) || (!isGpr(rm, reg.Size) && !isMemOf(rm, reg.Size)) {
		x64.OperandError(a, mnem,
				"takes a 16-, 32- or 64-bit register and a register or memory of its size")
		return
	}
	emitSized(a, reg.Size, reg.Reg, rm)
	emit0F(a, op)
	x64.EmitModRM(a, reg.Reg, rm)
}

// Ud1 emits UD1 r, r/m (0F B9 /r); see sys.bni.
func Ud1(a @asm.Assembler, reg x64.Operand, rm x64.Operand) { emitUd(a, "ud1", 0xB9, reg, rm) }

// Ud0 emits UD0 r, r/m (0F FF /r); see sys.bni.
func Ud0(a @asm.Assembler, reg x64.Operand, rm x64.Operand) { emitUd(a, "ud0", 0xFF, reg, rm) }

// accSize returns the size of accumulator acc, AL, AX or EAX, or 0 when acc is none of them.
func accSize(acc x64.Operand) int {
	if acc.Kind != x64.OP_REG || acc.Reg != x64.RAX { return 0 }
	if acc.Size == x64.SZ8 || acc.Size == x64.SZ16 || acc.Size == x64.SZ32 { return acc.Size }
	return 0
}

// emitPort emits IN or OUT (mnem): op the imm8 form's opcode for AL (E4 / E6; the one after it for
// AX and EAX, 8 past them the DX forms), acc AL, AX or EAX, port an imm8 or DX.
func emitPort(a @asm.Assembler, mnem *[]readonly char, op int, acc x64.Operand, port x64.Operand) {
	var size int = accSize(acc)
	var dx bool = port.Kind == x64.OP_REG && port.Reg == x64.RDX && port.Size == x64.SZ16
	if size == 0 || (!dx && port.Kind != x64.OP_IMM) {
		x64.OperandError(a, mnem, "takes AL, AX or EAX and a port, an imm8 or DX")
		return
	}
	if !dx && !x64.ImmOk(a, mnem, port, x64.SZ8) { return }
	if size == x64.SZ16 { emit8(a, 0x66) }
	if size != x64.SZ8 { op = op + 1 }
	if dx {
		emit8(a, op + 8)
		return
	}
	emit8(a, op)
	x64.EmitImm(a, mnem, port, x64.SZ8)
}

// In emits IN acc, port (E4 / E5 ib, EC / ED); see sys.bni.
func In(a @asm.Assembler, acc x64.Operand, port x64.Operand) { emitPort(a, "in", 0xE4, acc, port) }

// Out emits OUT port, acc (E6 / E7 ib, EE / EF); see sys.bni.
func Out(a @asm.Assembler, port x64.Operand, acc x64.Operand) {
	emitPort(a, "out", 0xE6, acc, port)
}
