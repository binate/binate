package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The register forms and port I/O against clang (see sys_test.bn); PUSH / POP FS / GS and UD0
// against GNU as (clang's `push fs` is the 16-bit push, and clang has no `ud0`).

// The control and debug register moves, REX.R for CR8..CR15 / DR8..DR15 and REX.B for R8..R15.
func TestControlDebugMoves() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovFromCr(a, r64(x64.RAX), 0)
	MovToCr(a, 0, r64(x64.RAX))
	MovFromCr(a, r64(x64.RAX), 2)
	MovFromCr(a, r64(x64.RAX), 3)
	MovToCr(a, 4, r64(x64.RBX))
	MovFromCr(a, r64(x64.R9), 8)
	MovToCr(a, 8, r64(x64.R9))
	MovFromCr(a, r64(x64.RAX), 15)
	var e @[]char = sysCase("", a, "cr",
			"0f20c0 0f22c0 0f20d0 0f20d8 0f22e3 450f20c1 450f22c1 440f20f8")
	a = newAsm()
	MovFromDr(a, r64(x64.RAX), 0)
	MovToDr(a, 7, r64(x64.RAX))
	MovFromDr(a, r64(x64.RAX), 8)
	MovFromDr(a, r64(x64.R10), 6)
	MovToDr(a, 6, r64(x64.R9))
	e = sysCase(e, a, "dr", "0f21c0 0f23f8 440f21c0 410f21f2 410f23f1")
	a = newAsm()
	MovFromCr(a, r32(x64.RAX), 0)
	e = rejectCase(e, a, "mov eax, cr0")
	a = newAsm()
	MovToDr(a, 16, r64(x64.RAX))
	e = rejectCase(e, a, "mov dr16, rax")
	return e
}

// The segment register moves, the prefixes clang gives each size (66 only into a segment
// register), memory a word; PUSH / POP FS / GS at 64 and 16 bits.
func TestSegmentRegisters() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovFromSeg(a, r16(x64.RAX), DS)
	MovToSeg(a, DS, r16(x64.RAX))
	MovFromSeg(a, r64(x64.RAX), FS)
	MovFromSeg(a, r32(x64.RAX), GS)
	MovFromSeg(a, mem(x64.RBX, x64.SZ16), SS)
	MovToSeg(a, ES, mem(x64.RBX, x64.SZ16))
	MovToSeg(a, FS, r32(x64.RAX))
	MovToSeg(a, CS, r16(x64.RAX))
	MovToSeg(a, DS, r64(x64.RAX))
	var e @[]char = sysCase("", a, "mov sreg", "8cd8 668ed8 488ce0 8ce8 8c13 8e03 8ee0 668ec8 488ed8")
	a = newAsm()
	MovToSeg(a, FS, x64.Mem(x64.R9, 8, x64.SZ16))
	MovFromSeg(a, mem(x64.R9, 0), GS)
	MovFromSeg(a, r16(x64.R9), CS)
	MovFromSeg(a, r64(x64.R9), SS)
	MovToSeg(a, SS, r32(x64.R9))
	e = sysCase(e, a, "mov sreg, r8..r15", "418e6108 418c29 418cc9 498cd1 418ed1")
	a = newAsm()
	PushSeg(a, FS, x64.SZ64)
	PushSeg(a, FS, x64.SZ16)
	PopSeg(a, FS, x64.SZ64)
	PushSeg(a, GS, x64.SZ64)
	PopSeg(a, GS, x64.SZ64)
	PopSeg(a, GS, x64.SZ16)
	e = sysCase(e, a, "push / pop fs / gs", "0fa0 660fa0 0fa1 0fa8 0fa9 660fa9")
	a = newAsm()
	MovToSeg(a, DS, mem(x64.RAX, x64.SZ32))
	e = rejectCase(e, a, "mov ds, dword ptr [rax]")
	a = newAsm()
	MovToSeg(a, 6, r16(x64.RAX))
	e = rejectCase(e, a, "mov sreg 6, ax")
	a = newAsm()
	MovFromSeg(a, x64.Reg(x64.RAX, x64.SZ8), DS)
	e = rejectCase(e, a, "mov al, ds")
	a = newAsm()
	PushSeg(a, DS, x64.SZ64)
	e = rejectCase(e, a, "push ds")
	a = newAsm()
	PopSeg(a, FS, x64.SZ32)
	e = rejectCase(e, a, "pop fs at 32 bits")
	return e
}

// LLDT / LTR / VERR / VERW / LMSW (a word), SLDT / STR / SMSW (a register of any size, or a word),
// LAR / LSL (a source register of any size).
func TestSelectorsAndWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var w x64.Operand = mem(x64.RAX, x64.SZ16)
	Lldt(a, r16(x64.RAX))
	Lldt(a, w)
	Ltr(a, r16(x64.RAX))
	Ltr(a, w)
	Verr(a, r16(x64.RAX))
	Verw(a, w)
	Lmsw(a, r16(x64.RAX))
	Lmsw(a, w)
	var e @[]char = sysCase("", a, "lldt .. lmsw",
			"0f00d0 0f0010 0f00d8 0f0018 0f00e0 0f0028 0f01f0 0f0130")
	a = newAsm()
	Sldt(a, r16(x64.RAX))
	Sldt(a, r32(x64.RAX))
	Sldt(a, r64(x64.RAX))
	Sldt(a, w)
	Str(a, r16(x64.RAX))
	Str(a, r64(x64.RAX))
	Str(a, w)
	Smsw(a, r16(x64.RAX))
	Smsw(a, r32(x64.RAX))
	Smsw(a, r64(x64.RAX))
	Smsw(a, w)
	Sldt(a, r16(x64.R9))
	Str(a, r64(x64.R9))
	Smsw(a, r64(x64.R9))
	e = sysCase(e, a, "sldt / str / smsw",
			"660f00c0 0f00c0 480f00c0 0f0000 660f00c8 480f00c8 0f0008 660f01e0 0f01e0 480f01e0 0f0120 "
					"66410f00c1 490f00c9 490f01e1")
	a = newAsm()
	Lar(a, r32(x64.RAX), r16(x64.RBX))
	Lar(a, r64(x64.RAX), mem(x64.RBX, x64.SZ16))
	Lar(a, r16(x64.RAX), r16(x64.RBX))
	Lsl(a, r32(x64.RAX), r16(x64.RBX))
	Lsl(a, r64(x64.RAX), r64(x64.RBX))
	Lar(a, r16(x64.RAX), r64(x64.RBX))
	Lar(a, r64(x64.R9), r16(x64.R10))
	Lar(a, r16(x64.R9), r16(x64.R10))
	Lsl(a, r32(x64.R9), r16(x64.R10))
	Lsl(a, r16(x64.RAX), mem(x64.RBX, 0))
	e = sysCase(e, a, "lar / lsl",
			"0f02c3 480f0203 660f02c3 0f03c3 480f03c3 660f02c3 4d0f02ca 66450f02ca 450f03ca 660f0303")
	a = newAsm()
	Lldt(a, r32(x64.RAX))
	e = rejectCase(e, a, "lldt eax")
	a = newAsm()
	Verw(a, r64(x64.RAX))
	e = rejectCase(e, a, "verw rax")
	a = newAsm()
	Sldt(a, mem(x64.RAX, x64.SZ32))
	e = rejectCase(e, a, "sldt dword ptr [rax]")
	a = newAsm()
	Lar(a, r32(x64.RAX), mem(x64.RBX, x64.SZ32))
	e = rejectCase(e, a, "lar eax, dword ptr [rbx]")
	a = newAsm()
	Lar(a, x64.Reg(x64.RAX, x64.SZ8), x64.Reg(x64.RBX, x64.SZ8))
	e = rejectCase(e, a, "lar al, bl")
	return e
}

// RDRAND / RDSEED (16, 32, 64 bits), the FS / GS bases (32, 64), RDPID (64), UD1 / UD0.
func TestRegisterForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Rdrand(a, r16(x64.RAX))
	Rdrand(a, r32(x64.RAX))
	Rdrand(a, r64(x64.RAX))
	Rdseed(a, r32(x64.RAX))
	Rdseed(a, r64(x64.R9))
	var e @[]char = sysCase("", a, "rdrand / rdseed", "660fc7f0 0fc7f0 480fc7f0 0fc7f8 490fc7f9")
	a = newAsm()
	Rdfsbase(a, r32(x64.RAX))
	Rdfsbase(a, r64(x64.RAX))
	Rdgsbase(a, r64(x64.RAX))
	Wrfsbase(a, r64(x64.RAX))
	Wrgsbase(a, r32(x64.RAX))
	Rdpid(a, r64(x64.RAX))
	Rdpid(a, r64(x64.R9))
	e = sysCase(e, a, "fs / gs bases, rdpid",
			"f30faec0 f3480faec0 f3480faec8 f3480faed0 f30faed8 f30fc7f8 f3410fc7f9")
	a = newAsm()
	Ud1(a, r32(x64.RAX), r32(x64.RBX))
	Ud1(a, r64(x64.RAX), mem(x64.RBX, x64.SZ64))
	Ud1(a, r16(x64.RAX), r16(x64.RBX))
	Ud1(a, r64(x64.R9), r64(x64.R10))
	Ud1(a, r32(x64.RAX), mem(x64.RBX, 0))
	Ud0(a, r32(x64.RAX), r32(x64.RBX))
	Ud0(a, r64(x64.RAX), r64(x64.RBX))
	Ud0(a, r16(x64.RAX), r16(x64.RBX))
	Ud0(a, r32(x64.RAX), mem(x64.RBX, x64.SZ32))
	e = sysCase(e, a, "ud1 / ud0",
			"0fb9c3 480fb903 660fb9c3 4d0fb9ca 0fb903 0fffc3 480fffc3 660fffc3 0fff03")
	a = newAsm()
	Rdrand(a, mem(x64.RAX, x64.SZ16))
	e = rejectCase(e, a, "rdrand word ptr [rax]")
	a = newAsm()
	Rdfsbase(a, r16(x64.RAX))
	e = rejectCase(e, a, "rdfsbase ax")
	a = newAsm()
	Rdpid(a, r32(x64.RAX))
	e = rejectCase(e, a, "rdpid eax")
	a = newAsm()
	Ud1(a, r32(x64.RAX), r16(x64.RBX))
	e = rejectCase(e, a, "ud1 eax, bx")
	a = newAsm()
	Ud1(a, r32(x64.RAX), mem(x64.RBX, x64.SZ16))
	e = rejectCase(e, a, "ud1 eax, word ptr [rbx]")
	return e
}

// IN / OUT with an imm8 port (its range, a symbol's byte) and DX, at 8, 16 and 32 bits.
func TestPortIo() testing.TestResult {
	var al x64.Operand = x64.Reg(x64.RAX, x64.SZ8)
	var dx x64.Operand = r16(x64.RDX)
	var a @asm.Assembler = newAsm()
	In(a, al, x64.Imm(0x60))
	In(a, r16(x64.RAX), x64.Imm(0x60))
	In(a, r32(x64.RAX), x64.Imm(0x60))
	In(a, al, dx)
	In(a, r16(x64.RAX), dx)
	In(a, r32(x64.RAX), dx)
	Out(a, x64.Imm(0x60), al)
	Out(a, x64.Imm(0x60), r16(x64.RAX))
	Out(a, x64.Imm(0x60), r32(x64.RAX))
	Out(a, dx, al)
	Out(a, dx, r16(x64.RAX))
	Out(a, dx, r32(x64.RAX))
	In(a, al, x64.Imm(-1))
	In(a, r32(x64.RAX), x64.Imm(255))
	var e @[]char = sysCase("", a, "in / out",
			"e460 66e560 e560 ec 66ed ed e660 66e760 e760 ee 66ef ef e4ff e5ff")
	a = newAsm()
	In(a, al, x64.ImmSym("x", 0, 0))
	e = sysCase(e, a, "in al, offset x", "e400")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != asm.FIX_DATA_ABS8 {
		e = buf.Concat(e, "in al, offset x: not its byte's fixup; ")
	}
	a = newAsm()
	In(a, al, x64.Imm(256))
	e = rejectCase(e, a, "in al, 256")
	a = newAsm()
	In(a, al, x64.Imm(-129))
	e = rejectCase(e, a, "in al, -129")
	a = newAsm()
	In(a, r64(x64.RAX), dx)
	e = rejectCase(e, a, "in rax, dx")
	a = newAsm()
	In(a, al, r16(x64.RCX))
	e = rejectCase(e, a, "in al, cx")
	a = newAsm()
	Out(a, dx, r16(x64.RBX))
	e = rejectCase(e, a, "out dx, bx")
	return e
}

// LFS / LGS / LSS: the register's size (66, REX.W) and number (REX.R), memory of any size.
func TestFarPointerLoads() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Lfs(a, r32(x64.RAX), mem(x64.RAX, 0))
	Lfs(a, r16(x64.RAX), mem(x64.RAX, x64.SZ32))
	Lfs(a, r64(x64.RAX), mem(x64.RAX, x64.SZ80))
	Lgs(a, r64(x64.R9), mem(x64.R10, x64.SZ80))
	Lss(a, r64(x64.RAX), mem(x64.RAX, x64.SZ80))
	Lss(a, r16(x64.RAX), x64.Mem(x64.R9, 8, 0))
	Lfs(a, r32(x64.RAX), mem(x64.RAX, x64.SZ8))
	var e @[]char = sysCase("", a, "lfs / lgs / lss",
			"0fb400 660fb400 480fb400 4d0fb50a 480fb200 66410fb24108 0fb400")
	a = newAsm()
	Lfs(a, r32(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "lfs eax, ebx")
	a = newAsm()
	Lss(a, x64.Reg(x64.RAX, x64.SZ8), mem(x64.RAX, 0))
	e = rejectCase(e, a, "lss al, [rax]")
	return e
}
