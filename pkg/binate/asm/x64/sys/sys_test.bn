package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The system instructions against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`, `llvm-objdump -dr`).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// r16, r32 and r64 return register r at 16, 32 and 64 bits.
func r16(r int) x64.Operand { return x64.Reg(r, x64.SZ16) }

func r32(r int) x64.Operand { return x64.Reg(r, x64.SZ32) }

func r64(r int) x64.Operand { return x64.Reg(r, x64.SZ64) }

// mem returns [base] of size bits.
func mem(base int, size int) x64.Operand { return x64.Mem(base, 0, size) }

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// sysCase adds name to the failures e unless a holds exactly the bytes hex spells.
func sysCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// Every instruction without operands.
func TestNoOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Rdmsr(a)
	Wrmsr(a)
	Rdpmc(a)
	Rdtsc(a)
	Rdtscp(a)
	Cpuid(a)
	Lfence(a)
	Mfence(a)
	Sfence(a)
	Cli(a)
	Sti(a)
	Clac(a)
	Stac(a)
	Clts(a)
	Swapgs(a)
	Invd(a)
	Wbinvd(a)
	Wbnoinvd(a)
	Invlpga(a)
	Monitor(a)
	Mwait(a)
	Monitorx(a)
	Mwaitx(a)
	Xgetbv(a)
	Xsetbv(a)
	Rdpkru(a)
	Wrpkru(a)
	Clzero(a)
	Rsm(a)
	var e @[]char = sysCase("", a, "no operands",
			"0f32 0f30 0f33 0f31 0f01f9 0fa2 0faee8 0faef0 0faef8 fa fb 0f01ca 0f01cb 0f06 0f01f8 0f08 "
					"0f09 f30f09 0f01df 0f01c8 0f01c9 0f01fa 0f01fb 0f01d0 0f01d1 0f01ee 0f01ef 0f01fc 0faa")
	return e
}

// A lock (x64.LockNext) before one is an error, nothing written.
func TestLockRejected() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	x64.LockNext(a)
	Cpuid(a)
	e = rejectCase(e, a, "lock cpuid")
	a = newAsm()
	x64.LockNext(a)
	Lgdt(a, mem(x64.RAX, 0))
	e = rejectCase(e, a, "lock lgdt")
	return e
}
