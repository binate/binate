package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// Transactional memory: XBEGIN's rel32 to the abort handler, XABORT's imm8, and the instructions
// without operands.

// Xbegin emits XBEGIN rel32 (C7 F8 cd); see sys.bni.
func Xbegin(a @asm.Assembler, label *[]readonly char, addend int64, plt bool) {
	emit8(a, 0xC7)
	emit8(a, 0xF8)
	var kind int = x64.FIX_REL32_PC
	if plt { kind = x64.FIX_REL32 }
	a.AddFixup(label, kind, addend, 4)
	a.EmitInstrUint32(0)
}

// Xabort emits XABORT imm8 (C6 F8 ib); see sys.bni.
func Xabort(a @asm.Assembler, imm x64.Operand) {
	if !x64.ImmOk(a, "xabort", imm, x64.SZ8) { return }
	emit8(a, 0xC6)
	emit8(a, 0xF8)
	x64.EmitImm(a, "xabort", imm, x64.SZ8)
}

// Xend emits XEND (0F 01 D5); see sys.bni.
func Xend(a @asm.Assembler) { emit0F01(a, 0xD5) }

// Xtest emits XTEST (0F 01 D6); see sys.bni.
func Xtest(a @asm.Assembler) { emit0F01(a, 0xD6) }

// Xsusldtrk emits XSUSLDTRK (F2 0F 01 E8); see sys.bni.
func Xsusldtrk(a @asm.Assembler) {
	emit8(a, 0xF2)
	emit0F01(a, 0xE8)
}

// Xresldtrk emits XRESLDTRK (F2 0F 01 E9); see sys.bni.
func Xresldtrk(a @asm.Assembler) {
	emit8(a, 0xF2)
	emit0F01(a, 0xE9)
}
