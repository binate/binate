package "pkg/binate/asm/x64/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Transactional memory against clang (see sys_test.bn).

// XBEGIN's rel32: its FIX_REL32_PC fixup (FIX_REL32 with plt), a block label after it resolved
// in place with an addend; XABORT's imm8 range and a symbol's byte; the instructions without
// operands.
func TestTransactions() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Xbegin(a, "x", 4, false)
	e = sysCase(e, a, "xbegin x + 4", "c7f8 00000000")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != x64.FIX_REL32_PC ||
			a.Sections[0].Fixups[0].Offset != 2 || a.Sections[0].Fixups[0].Addend != 4 {
		e = buf.Concat(e, "xbegin x + 4: not its FIX_REL32_PC fixup; ")
	}
	a = newAsm()
	Xbegin(a, "x", 0, true)
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != x64.FIX_REL32 {
		e = buf.Concat(e, "xbegin x@PLT: not a FIX_REL32 fixup; ")
	}
	a = newAsm()
	Xbegin(a, "Lfwd", 2, false)
	a.DefineLabel("Lfwd")
	if !x64.ResolveFixups(a) || a.HasError { e = buf.Concat(e, "xbegin Lfwd + 2: not resolved; ") }
	e = sysCase(e, a, "xbegin Lfwd + 2", "c7f8 02000000")
	a = newAsm()
	Xabort(a, x64.Imm(5))
	Xabort(a, x64.Imm(255))
	Xabort(a, x64.Imm(-1))
	Xend(a)
	Xtest(a)
	Xsusldtrk(a)
	Xresldtrk(a)
	e = sysCase(e, a, "xabort .. xresldtrk", "c6f805 c6f8ff c6f8ff 0f01d5 0f01d6 f20f01e8 f20f01e9")
	a = newAsm()
	Xabort(a, x64.ImmSym("x", 0, 0))
	e = sysCase(e, a, "xabort offset x", "c6f800")
	if a.Sections[0].NumFixups != 1 || a.Sections[0].Fixups[0].Kind != asm.FIX_DATA_ABS8 {
		e = buf.Concat(e, "xabort offset x: not its byte's fixup; ")
	}
	a = newAsm()
	Xabort(a, x64.Imm(256))
	e = rejectCase(e, a, "xabort 256")
	a = newAsm()
	Xabort(a, r64(x64.RAX))
	e = rejectCase(e, a, "xabort rax")
	return e
}
