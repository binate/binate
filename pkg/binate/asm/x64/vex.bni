// Package vex provides the x86-64 VEX and XOP prefix encoders.  A VEX prefix carries, in place of
// the legacy 66 / F3 / F2 prefix, REX and the 0F / 0F 38 / 0F 3A escape, an instruction's implied
// prefix, its REX.W / R / X / B bits, its opcode map, a second source register (vvvv) and a vector
// length.  AMD's XOP prefix has the three-byte VEX layout, introduced by 8F, for AMD's own opcode
// maps.  The VEX-encoded general-purpose instructions (BMI1 / BMI2) and AMD's XOP-encoded TBM are
// in pkg/binate/asm/x64/gpext.
package "pkg/binate/asm/x64/vex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The opcode maps a VEX prefix selects (its m-mmmm field): those of the legacy escapes 0F, 0F 38
// and 0F 3A, and map 7 (the MSR instructions with an immediate MSR number).
const (
	MAP_0F int = 1
	MAP_0F38 int = 2
	MAP_0F3A int = 3
	MAP_7 int = 7
)

// The opcode maps an XOP prefix selects (its m-mmmm field): AMD's maps 8, 9 and 10 (0A).
const (
	XOP_MAP8 int = 8
	XOP_MAP9 int = 9
	XOP_MAPA int = 10
)

// The legacy prefix a VEX prefix implies (its pp field): none, 66, F3 or F2.
const (
	PP_NONE int = 0
	PP_66 int = 1
	PP_F3 int = 2
	PP_F2 int = 3
)

// Emit emits the VEX prefix of an instruction in opcode map m (MAP_0F, MAP_0F38, MAP_0F3A or
// MAP_7) whose implied prefix is pp (PP_NONE, PP_66, PP_F3 or PP_F2), W bit w, vector length l (0
// for 128 bits or a scalar or general-purpose instruction's, 1 for 256), ModR/M reg field reg (a
// register, or an opcode extension), second source register v (VEX.vvvv; 0 for an instruction
// without one, which encodes as the 1111 it needs) and r/m operand rm: an x64 register
// (x64.OP_REG) or memory operand (x64.IsMem).  reg and v are bare register numbers, 0..15; REX.R
// comes from reg, X from a memory operand's index and B from its base or rm's register.  It is the
// two-byte form C5 when that holds every field (map 0F, W 0, no X or B), else the three-byte form
// C4, as clang chooses.  Any other map, pp, l, reg, v or rm sets an assembler error and emits
// nothing, as an instruction after `{rex}` does (asm.Assembler.X64Rex: it takes no REX prefix).
func Emit(a @asm.Assembler, m int, pp int, w bool, l int, reg int, v int, rm x64.Operand)

// EmitXop emits the XOP prefix 8F of an instruction in AMD's opcode map m (XOP_MAP8, XOP_MAP9 or
// XOP_MAPA), its other fields as Emit's three-byte form; pp is 00, the one value an XOP
// instruction has.  Any other map, l, reg, v or rm sets an assembler error and emits nothing.
func EmitXop(a @asm.Assembler, m int, w bool, l int, reg int, v int, rm x64.Operand)
