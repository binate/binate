package "pkg/binate/asm/x64/vex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// extBit returns 1 for a register 8..15, whose fourth bit a prefix carries, else 0.
func extBit(r int) int {
	if r >= 8 { return 1 }
	return 0
}

// rmBits returns rm's X and B bits: a memory operand's index and base, a register's number.
func rmBits(rm x64.Operand) (int, int) {
	if rm.Kind == x64.OP_REG { return 0, extBit(rm.Reg) }
	if rm.Kind != x64.OP_MEM { return 0, 0 }
	var x int = 0
	var b int = 0
	if rm.Index >= 0 { x = extBit(rm.Index) }
	if rm.Base >= 0 { b = extBit(rm.Base) }
	return x, b
}

// fieldsOk reports whether l, reg, v and rm are encodable — l 0 or 1, reg and v 0..15, rm a
// register 0..15 or a memory operand — else sets the assembler error naming prefix.
func fieldsOk(a @asm.Assembler, prefix *[]readonly char, l int, reg int, v int,
		rm x64.Operand) bool {
	var problem *[]readonly char = ""
	if a.X64Rex || a.X64RexW {
		problem = ": the instruction takes no REX prefix ({rex} or rex64)"
	} else if l != 0 && l != 1 {
		problem = ": the vector length is 0 or 1"
	} else if reg < 0 || reg > 15 || v < 0 || v > 15 {
		problem = ": a register field is 0..15"
	} else if !x64.IsMem(rm) && (rm.Kind != x64.OP_REG || rm.Reg < 0 || rm.Reg > 15) {
		problem = ": the r/m operand is a register 0..15 or memory"
	} else {
		return true
	}
	a.SetError(buf.Concat(buf.Concat("x64: ", prefix), problem))
	return false
}

// emitThree emits the three-byte layout of a VEX or XOP prefix: lead (C4 or 8F); inverted R, X
// and B with map m; W, inverted vvvv, L and pp.
func emitThree(a @asm.Assembler, lead int, m int, pp int, w bool, l int, reg int, v int,
		rm x64.Operand) {
	x, b := rmBits(rm)
	emit8(a, lead)
	emit8(a, ((1 - extBit(reg)) << 7) | ((1 - x) << 6) | ((1 - b) << 5) | m)
	var wl int = 0
	if w { wl = 0x80 }
	emit8(a, wl | ((~v & 0xF) << 3) | (l << 2) | pp)
}

// Emit emits a VEX prefix; see vex.bni.
func Emit(a @asm.Assembler, m int, pp int, w bool, l int, reg int, v int, rm x64.Operand) {
	if m != MAP_0F && m != MAP_0F38 && m != MAP_0F3A && m != MAP_7 {
		a.SetError("x64: VEX: the opcode map is 0F, 0F 38, 0F 3A or 7")
		return
	}
	if pp < PP_NONE || pp > PP_F2 {
		a.SetError("x64: VEX: the implied prefix is none, 66, F3 or F2")
		return
	}
	if !fieldsOk(a, "VEX", l, reg, v, rm) { return }
	a.X64VexDone = true
	x, b := rmBits(rm)
	if m == MAP_0F && !w && x == 0 && b == 0 && !a.X64Vex3 {
		emit8(a, 0xC5)
		emit8(a, ((1 - extBit(reg)) << 7) | ((~v & 0xF) << 3) | (l << 2) | pp)
		return
	}
	emitThree(a, 0xC4, m, pp, w, l, reg, v, rm)
}

// EmitXop emits an XOP prefix; see vex.bni.
func EmitXop(a @asm.Assembler, m int, w bool, l int, reg int, v int, rm x64.Operand) {
	if m != XOP_MAP8 && m != XOP_MAP9 && m != XOP_MAPA {
		a.SetError("x64: XOP: the opcode map is 8, 9 or 0A")
		return
	}
	if !fieldsOk(a, "XOP", l, reg, v, rm) { return }
	emitThree(a, 0x8F, m, PP_NONE, w, l, reg, v, rm)
}
