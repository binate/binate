package "pkg/binate/asm/x64/vex"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The VEX and XOP prefixes against clang's (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`), each followed by its instruction's opcode and ModR/M as the test
// emits them.

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// vexCase adds name to the failures e unless a holds exactly the bytes hex spells.
func vexCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// op emits an instruction's opcode and register-direct or memory ModR/M after its prefix.
func op(a @asm.Assembler, opcode int, reg int, rm x64.Operand) {
	a.EmitInstrUint8(cast(uint8, opcode))
	x64.EmitModRM(a, reg, rm)
}

// The two-byte form where it holds the fields — map 0F, W 0, no X or B, any R, vvvv, L and pp,
// a RIP-relative operand's — and the three-byte form for W, X, B and the other maps.
func TestEmitVex() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 1, x64.Reg(2, x64.SZ128))
	op(a, 0x58, 0, x64.Reg(2, x64.SZ128))
	e = vexCase(e, a, "vaddps xmm0, xmm1, xmm2", "c5 f0 58 c2")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 8, 1, x64.Reg(2, x64.SZ128))
	op(a, 0x58, 8, x64.Reg(2, x64.SZ128))
	e = vexCase(e, a, "vaddps xmm8, xmm1, xmm2", "c5 70 58 c2")
	a = newAsm()
	Emit(a, MAP_0F, PP_66, false, 1, 0, 1, x64.Reg(2, x64.SZ128))
	op(a, 0xFE, 0, x64.Reg(2, x64.SZ128))
	e = vexCase(e, a, "vpaddd ymm0, ymm1, ymm2", "c5 f5 fe c2")
	a = newAsm()
	Emit(a, MAP_0F, PP_66, true, 0, 0, 0, x64.Reg(x64.RCX, x64.SZ64))
	op(a, 0x6E, 0, x64.Reg(x64.RCX, x64.SZ64))
	e = vexCase(e, a, "vmovq xmm0, rcx", "c4 e1 f9 6e c1")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 1, x64.Reg(10, x64.SZ128))
	op(a, 0x5C, 0, x64.Reg(10, x64.SZ128))
	e = vexCase(e, a, "vsubps xmm0, xmm1, xmm10", "c4 c1 70 5c c2")
	a = newAsm()
	var idx x64.Operand = x64.MemIdx(x64.RAX, x64.R9, 1, 0, x64.SZ128)
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 1, idx)
	op(a, 0x58, 0, idx)
	e = vexCase(e, a, "vaddps xmm0, xmm1, [rax + r9]", "c4 a1 70 58 04 08")
	a = newAsm()
	var wide x64.Operand = x64.MemIdx(x64.R13, x64.R12, 8, 8, 256)
	Emit(a, MAP_0F, PP_NONE, false, 1, 15, 14, wide)
	op(a, 0x5C, 15, wide)
	e = vexCase(e, a, "vsubps ymm15, ymm14, [r13 + r12*8 + 8]", "c4 01 0c 5c 7c e5 08")
	a = newAsm()
	Emit(a, MAP_0F38, PP_NONE, false, 0, x64.RAX, x64.RBX, x64.Reg(x64.RCX, x64.SZ32))
	op(a, 0xF2, x64.RAX, x64.Reg(x64.RCX, x64.SZ32))
	e = vexCase(e, a, "andn eax, ebx, ecx", "c4 e2 60 f2 c1")
	a = newAsm()
	var sib x64.Operand = x64.MemIdx(x64.R12, x64.R13, 8, 8, x64.SZ64)
	Emit(a, MAP_0F38, PP_NONE, true, 0, x64.RAX, x64.R15, sib)
	op(a, 0xF2, x64.RAX, sib)
	e = vexCase(e, a, "andn rax, r15, [r12 + r13*8 + 8]", "c4 82 80 f2 44 ec 08")
	a = newAsm()
	Emit(a, MAP_0F38, PP_F3, false, 0, x64.RAX, x64.RCX, x64.Reg(x64.RBX, x64.SZ32))
	op(a, 0xF7, x64.RAX, x64.Reg(x64.RBX, x64.SZ32))
	e = vexCase(e, a, "sarx eax, ebx, ecx", "c4 e2 72 f7 c3")
	a = newAsm()
	var m x64.Operand = x64.Mem(x64.RBX, 0, x64.SZ64)
	Emit(a, MAP_0F3A, PP_F2, true, 0, x64.RAX, 0, m)
	op(a, 0xF0, x64.RAX, m)
	e = vexCase(e, a, "rorx rax, [rbx], (63)", "c4 e3 fb f0 03")
	a = newAsm()
	Emit(a, MAP_7, PP_F2, false, 0, 0, 0, x64.Reg(x64.R9, x64.SZ64))
	op(a, 0xF6, 0, x64.Reg(x64.R9, x64.SZ64))
	e = vexCase(e, a, "rdmsr r9, (imm32): map 7", "c4 c7 7b f6 c1")
	return e
}

// A RIP-relative operand has no X or B: the two-byte form, its rel32 relocated.
func TestEmitVexRip() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var rip x64.Operand = x64.RipLabel("x")
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 1, rip)
	op(a, 0x58, 0, rip)
	if !emits(a, "c5 f0 58 05 00 00 00 00") || a.Sections[0].NumFixups != 1 {
		return "vaddps xmm0, xmm1, [rip + x]: not clang's bytes and fixup"
	}
	return ""
}

// XOP's three-byte layout, its maps 9 and 0A, with R, X, B, W and vvvv.
func TestEmitXop() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	EmitXop(a, XOP_MAP9, false, 0, 1, x64.RAX, x64.Reg(x64.RBX, x64.SZ32))
	op(a, 0x01, 1, x64.Reg(x64.RBX, x64.SZ32))
	e = vexCase(e, a, "blcfill eax, ebx", "8f e9 78 01 cb")
	a = newAsm()
	var sib x64.Operand = x64.MemIdx(x64.R14, x64.R13, 2, 0, x64.SZ32)
	EmitXop(a, XOP_MAP9, false, 0, 1, x64.R15, sib)
	op(a, 0x01, 1, sib)
	e = vexCase(e, a, "blcfill r15d, [r14 + r13*2]", "8f 89 00 01 0c 6e")
	a = newAsm()
	EmitXop(a, XOP_MAPA, true, 0, x64.R8, 0, x64.Reg(x64.R9, x64.SZ64))
	op(a, 0x10, x64.R8, x64.Reg(x64.R9, x64.SZ64))
	e = vexCase(e, a, "bextr r8, r9, (1)", "8f 4a f8 10 c1")
	a = newAsm()
	EmitXop(a, XOP_MAP8, false, 1, 0, 0, x64.Reg(1, 256))
	e = vexCase(e, a, "map 8, L 1", "8f e8 7c")
	return e
}

// Each field out of its range, and an r/m operand that is neither a register 0..15 nor memory,
// is an error, with nothing emitted.
func TestEmitRejects() testing.TestResult {
	var e @[]char = ""
	var r x64.Operand = x64.Reg(x64.RCX, x64.SZ32)
	var a @asm.Assembler = newAsm()
	Emit(a, 0, PP_NONE, false, 0, 0, 0, r)
	e = rejectCase(e, a, "VEX map 0")
	a = newAsm()
	Emit(a, 4, PP_NONE, false, 0, 0, 0, r)
	e = rejectCase(e, a, "VEX map 4")
	a = newAsm()
	Emit(a, 8, PP_NONE, false, 0, 0, 0, r)
	e = rejectCase(e, a, "VEX map 8")
	a = newAsm()
	Emit(a, XOP_MAP9, PP_NONE, false, 0, 0, 0, r)
	e = rejectCase(e, a, "VEX map 9")
	a = newAsm()
	Emit(a, MAP_0F, 4, false, 0, 0, 0, r)
	e = rejectCase(e, a, "pp 4")
	a = newAsm()
	Emit(a, MAP_0F, -1, false, 0, 0, 0, r)
	e = rejectCase(e, a, "pp -1")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 2, 0, 0, r)
	e = rejectCase(e, a, "L 2")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 16, 0, r)
	e = rejectCase(e, a, "reg 16")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, -1, r)
	e = rejectCase(e, a, "vvvv -1")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 16, r)
	e = rejectCase(e, a, "vvvv 16")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 0, x64.Imm(1))
	e = rejectCase(e, a, "an immediate r/m")
	a = newAsm()
	Emit(a, MAP_0F, PP_NONE, false, 0, 0, 0, x64.Reg(16, x64.SZ64))
	e = rejectCase(e, a, "r/m register 16")
	a = newAsm()
	EmitXop(a, 7, false, 0, 0, 0, r)
	e = rejectCase(e, a, "XOP map 7")
	a = newAsm()
	EmitXop(a, 11, false, 0, 0, 0, r)
	e = rejectCase(e, a, "XOP map 11")
	a = newAsm()
	EmitXop(a, MAP_0F38, false, 0, 0, 0, r)
	e = rejectCase(e, a, "XOP map 2")
	a = newAsm()
	EmitXop(a, XOP_MAP9, false, -1, 0, 0, r)
	e = rejectCase(e, a, "XOP L -1")
	a = newAsm()
	EmitXop(a, XOP_MAP9, false, 0, -1, 0, r)
	e = rejectCase(e, a, "XOP reg -1")
	a = newAsm()
	EmitXop(a, XOP_MAP9, false, 0, 0, 0, x64.Imm(0))
	e = rejectCase(e, a, "XOP immediate r/m")
	return e
}

// An instruction after `{rex}` (asm.Assembler.X64Rex) takes no VEX or XOP prefix (clang:
// "unsupported instruction").
func TestRexPending() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.X64Rex = true
	Emit(a, MAP_0F38, PP_NONE, false, 0, 0, 0, x64.Reg(x64.RCX, x64.SZ32))
	var e @[]char = rejectCase("", a, "{rex} vex")
	a = newAsm()
	a.X64Rex = true
	EmitXop(a, XOP_MAP9, false, 0, 0, 0, x64.Reg(x64.RCX, x64.SZ32))
	return rejectCase(e, a, "{rex} xop")
}
