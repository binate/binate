// Package virt provides the x86-64 virtualization and trusted-execution instructions beside the
// instructions of pkg/binate/asm/x64, whose operands (x64.Operand) and encoding support
// (x64.EmitRexRM, x64.EmitModRM) they use: Intel's VMX and SMX, AMD's SVM, SGX, TDX and AMD's
// SEV-SNP.
//
// Register operands are 64-bit registers (x64.Reg); a memory operand is x64.IsMem's, of the size
// each lists or of size 0.  Any other operand sets an assembler error and emits nothing.  None
// takes a lock prefix (after x64.LockNext each is an assembler error and writes nothing).
package "pkg/binate/asm/x64/virt"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// --- VMX ---

// Vmcall emits VMCALL (0F 01 C1), Vmlaunch VMLAUNCH (0F 01 C2), Vmresume VMRESUME (0F 01 C3),
// Vmxoff VMXOFF (0F 01 C4) and Vmfunc VMFUNC (0F 01 D4).
func Vmcall(a @asm.Assembler)

func Vmlaunch(a @asm.Assembler)

func Vmresume(a @asm.Assembler)

func Vmxoff(a @asm.Assembler)

func Vmfunc(a @asm.Assembler)

// Vmxon emits VMXON mem (F3 0F C7 /6), Vmclear VMCLEAR (66 0F C7 /6), Vmptrld VMPTRLD (0F C7 /6)
// and Vmptrst VMPTRST (0F C7 /7): the physical address of a VMCS or VMXON region at mem, a qword.
func Vmxon(a @asm.Assembler, mem x64.Operand)

func Vmclear(a @asm.Assembler, mem x64.Operand)

func Vmptrld(a @asm.Assembler, mem x64.Operand)

func Vmptrst(a @asm.Assembler, mem x64.Operand)

// Vmread emits VMREAD r/m64, r64 (0F 78 /r): dst, a 64-bit register or a qword of memory, <- the
// VMCS field the 64-bit register src names.  Vmwrite emits VMWRITE r64, r/m64 (0F 79 /r): the
// field the register dst names <- src, a 64-bit register or a qword of memory.
func Vmread(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Vmwrite(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Invept emits INVEPT r64, m128 (66 0F 38 80 /r) and Invvpid INVVPID (66 0F 38 81 /r): the
// invalidation type in the 64-bit register reg, the descriptor at mem, an xmmword.
func Invept(a @asm.Assembler, reg x64.Operand, mem x64.Operand)

func Invvpid(a @asm.Assembler, reg x64.Operand, mem x64.Operand)

// --- SVM ---

// Vmrun emits VMRUN (0F 01 D8), Vmmcall VMMCALL (D9), Vmload VMLOAD (DA), Vmsave VMSAVE (DB), Stgi
// STGI (DC), Clgi CLGI (DD) and Skinit SKINIT (DE), each 0F 01 and the byte named.
func Vmrun(a @asm.Assembler)

func Vmmcall(a @asm.Assembler)

func Vmload(a @asm.Assembler)

func Vmsave(a @asm.Assembler)

func Stgi(a @asm.Assembler)

func Clgi(a @asm.Assembler)

func Skinit(a @asm.Assembler)

// --- SMX ---

// Getsec emits GETSEC (0F 37): the safer-mode function EAX selects.
func Getsec(a @asm.Assembler)

// --- SGX, TDX, SEV-SNP ---

// Encls emits ENCLS (0F 01 CF), Enclu ENCLU (0F 01 D7) and Enclv ENCLV (0F 01 C0).
func Encls(a @asm.Assembler)

func Enclu(a @asm.Assembler)

func Enclv(a @asm.Assembler)

// Tdcall emits TDCALL (66 0F 01 CC), Seamret SEAMRET (66 0F 01 CD), Seamops SEAMOPS (66 0F 01 CE)
// and Seamcall SEAMCALL (66 0F 01 CF).
func Tdcall(a @asm.Assembler)

func Seamret(a @asm.Assembler)

func Seamops(a @asm.Assembler)

func Seamcall(a @asm.Assembler)

// Pvalidate emits PVALIDATE (F2 0F 01 FF), Rmpadjust RMPADJUST (F3 0F 01 FE), Rmpupdate RMPUPDATE
// (F2 0F 01 FE), Psmash PSMASH (F3 0F 01 FF) and Rmpquery RMPQUERY (F3 0F 01 FD).
func Pvalidate(a @asm.Assembler)

func Rmpadjust(a @asm.Assembler)

func Rmpupdate(a @asm.Assembler)

func Psmash(a @asm.Assembler)

func Rmpquery(a @asm.Assembler)
