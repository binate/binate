package "pkg/binate/asm/x64/virt"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// emit8 emits byte v of an instruction, as x64's encoders do.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// emit0F01 emits [pfx] 0F 01 op: legacy prefix pfx (0 for none), then the opcode's last byte op.
func emit0F01(a @asm.Assembler, pfx int, op int) {
	if pfx != 0 { emit8(a, pfx) }
	emit8(a, 0x0F)
	emit8(a, 0x01)
	emit8(a, op)
}

// isReg64 reports whether op is a 64-bit general-purpose register.
func isReg64(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= x64.RAX && op.Reg <= x64.R15 && op.Size == x64.SZ64
}

// isMemOf reports whether op is memory of size bits or of size 0.
func isMemOf(op x64.Operand, size int) bool {
	return x64.IsMem(op) && (op.Size == 0 || op.Size == size)
}

// emitVmcs emits mnem mem, a qword of memory: [pfx] [REX] 0F C7 /ext.
func emitVmcs(a @asm.Assembler, mnem *[]readonly char, pfx int, ext int, mem x64.Operand) {
	if !isMemOf(mem, x64.SZ64) {
		x64.OperandError(a, mnem, "takes a qword of memory")
		return
	}
	if pfx != 0 { emit8(a, pfx) }
	x64.EmitRexRM(a, false, ext, mem, false)
	emit8(a, 0x0F)
	emit8(a, 0xC7)
	x64.EmitModRM(a, ext, mem)
}

// emitVmField emits VMREAD or VMWRITE (mnem, 0F op /r): reg, a 64-bit register, in ModR/M's reg
// field and rm, a 64-bit register or a qword of memory, in r/m.
func emitVmField(a @asm.Assembler, mnem *[]readonly char, op int, reg x64.Operand, rm x64.Operand) {
	if !isReg64(reg) || (!isReg64(rm) && !isMemOf(rm, x64.SZ64)) {
		x64.OperandError(a, mnem, "takes a 64-bit register and a 64-bit register or a qword of memory")
		return
	}
	x64.EmitRexRM(a, false, reg.Reg, rm, false)
	emit8(a, 0x0F)
	emit8(a, op)
	x64.EmitModRM(a, reg.Reg, rm)
}

// emitInvalidate emits INVEPT or INVVPID (mnem, 66 0F 38 op /r): reg a 64-bit register, mem an
// xmmword.
func emitInvalidate(a @asm.Assembler, mnem *[]readonly char, op int, reg x64.Operand,
		mem x64.Operand) {
	if !isReg64(reg) || !isMemOf(mem, x64.SZ128) {
		x64.OperandError(a, mnem, "takes a 64-bit register and an xmmword of memory")
		return
	}
	emit8(a, 0x66)
	x64.EmitRexRM(a, false, reg.Reg, mem, false)
	emit8(a, 0x0F)
	emit8(a, 0x38)
	emit8(a, op)
	x64.EmitModRM(a, reg.Reg, mem)
}

// Vmcall emits VMCALL; see virt.bni.
func Vmcall(a @asm.Assembler) { emit0F01(a, 0, 0xC1) }

// Vmlaunch emits VMLAUNCH; see virt.bni.
func Vmlaunch(a @asm.Assembler) { emit0F01(a, 0, 0xC2) }

// Vmresume emits VMRESUME; see virt.bni.
func Vmresume(a @asm.Assembler) { emit0F01(a, 0, 0xC3) }

// Vmxoff emits VMXOFF; see virt.bni.
func Vmxoff(a @asm.Assembler) { emit0F01(a, 0, 0xC4) }

// Vmfunc emits VMFUNC; see virt.bni.
func Vmfunc(a @asm.Assembler) { emit0F01(a, 0, 0xD4) }

// Vmxon emits VMXON; see virt.bni.
func Vmxon(a @asm.Assembler, mem x64.Operand) { emitVmcs(a, "vmxon", 0xF3, 6, mem) }

// Vmclear emits VMCLEAR; see virt.bni.
func Vmclear(a @asm.Assembler, mem x64.Operand) { emitVmcs(a, "vmclear", 0x66, 6, mem) }

// Vmptrld emits VMPTRLD; see virt.bni.
func Vmptrld(a @asm.Assembler, mem x64.Operand) { emitVmcs(a, "vmptrld", 0, 6, mem) }

// Vmptrst emits VMPTRST; see virt.bni.
func Vmptrst(a @asm.Assembler, mem x64.Operand) { emitVmcs(a, "vmptrst", 0, 7, mem) }

// Vmread emits VMREAD; see virt.bni.
func Vmread(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitVmField(a, "vmread", 0x78, src, dst)
}

// Vmwrite emits VMWRITE; see virt.bni.
func Vmwrite(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitVmField(a, "vmwrite", 0x79, dst, src)
}

// Invept emits INVEPT; see virt.bni.
func Invept(a @asm.Assembler, reg x64.Operand, mem x64.Operand) {
	emitInvalidate(a, "invept", 0x80, reg, mem)
}

// Invvpid emits INVVPID; see virt.bni.
func Invvpid(a @asm.Assembler, reg x64.Operand, mem x64.Operand) {
	emitInvalidate(a, "invvpid", 0x81, reg, mem)
}

// Vmrun emits VMRUN; see virt.bni.
func Vmrun(a @asm.Assembler) { emit0F01(a, 0, 0xD8) }

// Vmmcall emits VMMCALL; see virt.bni.
func Vmmcall(a @asm.Assembler) { emit0F01(a, 0, 0xD9) }

// Vmload emits VMLOAD; see virt.bni.
func Vmload(a @asm.Assembler) { emit0F01(a, 0, 0xDA) }

// Vmsave emits VMSAVE; see virt.bni.
func Vmsave(a @asm.Assembler) { emit0F01(a, 0, 0xDB) }

// Stgi emits STGI; see virt.bni.
func Stgi(a @asm.Assembler) { emit0F01(a, 0, 0xDC) }

// Clgi emits CLGI; see virt.bni.
func Clgi(a @asm.Assembler) { emit0F01(a, 0, 0xDD) }

// Skinit emits SKINIT; see virt.bni.
func Skinit(a @asm.Assembler) { emit0F01(a, 0, 0xDE) }

// Getsec emits GETSEC (0F 37); see virt.bni.
func Getsec(a @asm.Assembler) {
	emit8(a, 0x0F)
	emit8(a, 0x37)
}

// Encls emits ENCLS; see virt.bni.
func Encls(a @asm.Assembler) { emit0F01(a, 0, 0xCF) }

// Enclu emits ENCLU; see virt.bni.
func Enclu(a @asm.Assembler) { emit0F01(a, 0, 0xD7) }

// Enclv emits ENCLV; see virt.bni.
func Enclv(a @asm.Assembler) { emit0F01(a, 0, 0xC0) }

// Tdcall emits TDCALL; see virt.bni.
func Tdcall(a @asm.Assembler) { emit0F01(a, 0x66, 0xCC) }

// Seamret emits SEAMRET; see virt.bni.
func Seamret(a @asm.Assembler) { emit0F01(a, 0x66, 0xCD) }

// Seamops emits SEAMOPS; see virt.bni.
func Seamops(a @asm.Assembler) { emit0F01(a, 0x66, 0xCE) }

// Seamcall emits SEAMCALL; see virt.bni.
func Seamcall(a @asm.Assembler) { emit0F01(a, 0x66, 0xCF) }

// Pvalidate emits PVALIDATE; see virt.bni.
func Pvalidate(a @asm.Assembler) { emit0F01(a, 0xF2, 0xFF) }

// Rmpadjust emits RMPADJUST; see virt.bni.
func Rmpadjust(a @asm.Assembler) { emit0F01(a, 0xF3, 0xFE) }

// Rmpupdate emits RMPUPDATE; see virt.bni.
func Rmpupdate(a @asm.Assembler) { emit0F01(a, 0xF2, 0xFE) }

// Psmash emits PSMASH; see virt.bni.
func Psmash(a @asm.Assembler) { emit0F01(a, 0xF3, 0xFF) }

// Rmpquery emits RMPQUERY; see virt.bni.
func Rmpquery(a @asm.Assembler) { emit0F01(a, 0xF3, 0xFD) }
