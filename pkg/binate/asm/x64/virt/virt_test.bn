package "pkg/binate/asm/x64/virt"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The virtualization and trusted-execution instructions against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// r32 and r64 return register r at 32 and 64 bits.
func r32(r int) x64.Operand { return x64.Reg(r, x64.SZ32) }

func r64(r int) x64.Operand { return x64.Reg(r, x64.SZ64) }

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// virtCase adds name to the failures e unless a holds exactly the bytes hex spells.
func virtCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// rejectCase adds name to the failures e unless a holds an error and no bytes.
func rejectCase(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError && a.Sections[0].Len == 0 { return e }
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}

// Every instruction without operands.
func TestNoOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmcall(a)
	Vmlaunch(a)
	Vmresume(a)
	Vmxoff(a)
	Vmfunc(a)
	Vmrun(a)
	Vmmcall(a)
	Vmload(a)
	Vmsave(a)
	Stgi(a)
	Clgi(a)
	Skinit(a)
	Encls(a)
	Enclu(a)
	Enclv(a)
	Tdcall(a)
	Seamret(a)
	Seamops(a)
	Seamcall(a)
	Pvalidate(a)
	Rmpadjust(a)
	Rmpupdate(a)
	Psmash(a)
	Rmpquery(a)
	return virtCase("", a, "no operands",
			"0f01c1 0f01c2 0f01c3 0f01c4 0f01d4 0f01d8 0f01d9 0f01da 0f01db 0f01dc 0f01dd 0f01de 0f01cf "
					"0f01d7 0f01c0 660f01cc 660f01cd 660f01ce 660f01cf f20f01ff f30f01fe f20f01fe f30f01ff "
					"f30f01fd")
}

// The VMCS pointer instructions (a qword), VMREAD / VMWRITE (registers 8..15 in either field, a
// SIB), INVEPT / INVVPID (an xmmword).
func TestOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmxon(a, x64.Mem(x64.RAX, 0, x64.SZ64))
	Vmclear(a, x64.Mem(x64.RAX, 0, 0))
	Vmptrld(a, x64.Mem(x64.RAX, 0, 0))
	Vmptrst(a, x64.Mem(x64.RAX, 0, x64.SZ64))
	var e @[]char = virtCase("", a, "vmcs pointers", "f30fc730 660fc730 0fc730 0fc738")
	a = newAsm()
	Vmread(a, r64(x64.RAX), r64(x64.RBX))
	Vmread(a, x64.Mem(x64.RAX, 0, x64.SZ64), r64(x64.RBX))
	Vmread(a, r64(x64.R9), r64(x64.R10))
	Vmread(a, x64.MemIdx(x64.R9, x64.R10, 8, 0, x64.SZ64), r64(x64.R11))
	Vmwrite(a, r64(x64.RAX), r64(x64.RBX))
	Vmwrite(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	Vmwrite(a, r64(x64.R9), x64.Mem(x64.R10, 0, 0))
	e = virtCase(e, a, "vmread / vmwrite", "0f78d8 0f7818 450f78d1 470f781cd1 0f79c3 0f7903 450f790a")
	a = newAsm()
	Invept(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ128))
	Invvpid(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	Invvpid(a, r64(x64.R9), x64.Mem(x64.R10, 0, x64.SZ128))
	e = virtCase(e, a, "invept / invvpid", "660f388003 660f388103 66450f38810a")
	a = newAsm()
	Vmxon(a, x64.RipLabel("x"))
	e = virtCase(e, a, "vmxon [rip + x]", "f30fc73500000000")
	return e
}

// Memory of another size, 32-bit registers, a register where memory is wanted, and a lock before
// one are errors with nothing emitted.
func TestRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Vmxon(a, x64.Mem(x64.RAX, 0, x64.SZ32))
	e = rejectCase(e, a, "vmxon dword ptr [rax]")
	a = newAsm()
	Vmptrst(a, r64(x64.RAX))
	e = rejectCase(e, a, "vmptrst rax")
	a = newAsm()
	Vmread(a, r32(x64.RAX), r32(x64.RBX))
	e = rejectCase(e, a, "vmread eax, ebx")
	a = newAsm()
	Vmread(a, x64.Mem(x64.RAX, 0, x64.SZ32), r64(x64.RBX))
	e = rejectCase(e, a, "vmread dword ptr [rax], rbx")
	a = newAsm()
	Invept(a, r32(x64.RAX), x64.Mem(x64.RBX, 0, 0))
	e = rejectCase(e, a, "invept eax, [rbx]")
	a = newAsm()
	Invept(a, r64(x64.RAX), x64.Mem(x64.RBX, 0, x64.SZ64))
	e = rejectCase(e, a, "invept rax, qword ptr [rbx]")
	a = newAsm()
	x64.LockNext(a)
	Vmcall(a)
	e = rejectCase(e, a, "lock vmcall")
	return e
}

// GETSEC, against clang.
func TestGetsec() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Getsec(a)
	return virtCase("", a, "getsec", "0f37")
}
