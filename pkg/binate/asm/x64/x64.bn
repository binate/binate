package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- x86-64 encoding helpers ---

// emit8 emits a single byte to the assembler's current section.
func emit8(a @asm.Assembler, v int) {
	a.EmitUint8(cast(uint8, v & 0xFF))
}

// emit32le emits a 32-bit little-endian value to the current section.
func emit32le(a @asm.Assembler, v int) {
	a.EmitUint32(cast(uint32, v))
}

// regLo3 returns the low 3 bits of a register number.
func regLo3(r int) int { return r & 7 }

// regHi returns 1 if the register needs the REX extension bit.
func regHi(r int) int {
	if r >= 8 { return 1 }
	return 0
}

// needsRex returns true if a REX prefix is required.
func needsRex(w bool, r int, x int, b int) bool {
	return w || r >= 8 || x >= 8 || b >= 8
}

// emitRex emits a REX prefix if needed.
// w: 64-bit operand size, r: ModR/M reg field extension,
// x: SIB index extension, b: ModR/M r/m or SIB base extension.
func emitRex(a @asm.Assembler, w bool, r int, x int, b int) {
	emitRexF(a, w, r, x, b, false)
}

// emitRexF is emitRex with an extra `force` flag: it emits the REX prefix
// whenever it is normally needed OR force is set.  A caller sets force for an
// 8-bit-operand instruction whose byte-accessed register is RSP/RBP/RSI/RDI
// (byteRegHazard) — those low bytes SPL/BPL/SIL/DIL exist ONLY with a REX
// present; without it, ModR/M reg/rm codes 4..7 in an 8-bit context select the
// legacy AH/CH/DH/BH high-byte registers instead, silently reading/writing the
// wrong register.  (Setcc handles the same hazard inline.)
func emitRexF(a @asm.Assembler, w bool, r int, x int, b int, force bool) {
	if !needsRex(w, r, x, b) && !force { return }
	var rex int = 0x40
	if w { rex = rex | 0x08 }
	if regHi(r) != 0 { rex = rex | 0x04 }
	if regHi(x) != 0 { rex = rex | 0x02 }
	if regHi(b) != 0 { rex = rex | 0x01 }
	emit8(a, rex)
}

// byteRegHazard reports whether reg accessed as an 8-bit value requires a
// forced REX prefix: RSP/RBP/RSI/RDI (codes 4..7).  See emitRexF.
func byteRegHazard(reg int) bool { return reg >= 4 && reg < 8 }

// emitRexRM is emitRexF for an instruction whose ModR/M r/m operand is rm: it
// takes REX.B from rm's register (a register operand) or from its base (a
// memory operand), and REX.X from a memory operand's SIB index, so an R8..R15
// base or index is never silently read as RAX..RDI.  reg is the ModR/M reg
// field (a register, or 0 when the field is an opcode extension); w and force
// are as for emitRexF.
func emitRexRM(a @asm.Assembler, w bool, reg int, rm Operand, force bool) {
	var x int = 0
	var b int = 0
	if rm.Kind == OP_REG {
		b = rm.Reg
	} else if rm.Kind == OP_MEM {
		if rm.Base >= 0 { b = rm.Base }
		if rm.Index >= 0 { x = rm.Index }
	}
	emitRexF(a, w, reg, x, b, force)
}

// scaleEnc encodes the scale factor for SIB (0=1, 1=2, 2=4, 3=8).
func scaleEnc(s int) int {
	if s <= 1 { return 0 }
	if s == 2 { return 1 }
	if s == 4 { return 2 }
	return 3
}

// memOperandOk reports whether memory operand rm is encodable — its base and index each
// RAX..R15 or none (-1), the index not RSP (whose SIB encoding means no index), an indexed
// operand's scale 1, 2, 4 or 8, the displacement a signed 32-bit value — else records an
// assembler error.
func memOperandOk(a @asm.Assembler, rm Operand) bool {
	if rm.Base < -1 || rm.Base > R15 || rm.Index < -1 || rm.Index > R15 {
		a.SetError("x64: a memory operand's base or index is not RAX..R15")
		return false
	}
	if rm.Index == RSP {
		a.SetError("x64: RSP cannot be a memory operand's index")
		return false
	}
	if rm.Index >= 0 && rm.Scale != 1 && rm.Scale != 2 && rm.Scale != 4 && rm.Scale != 8 {
		a.SetError("x64: a memory operand's scale must be 1, 2, 4 or 8")
		return false
	}
	if rm.Disp < -2147483648 || rm.Disp > 2147483647 {
		a.SetError("x64: a memory operand's displacement must be a signed 32-bit value")
		return false
	}
	return true
}

// fitsI8 returns true if a value fits in a signed 8-bit immediate.
func fitsI8(v int) bool { return v >= -128 && v <= 127 }

// emitModRM emits the ModR/M byte and optional SIB + displacement
// for a register or memory operand. regField is the /r or opcode
// extension (3 bits). rm is the register or memory operand.
func emitModRM(a @asm.Assembler, regField int, rm Operand) { emitModRMImm(a, regField, rm, 0) }

// emitModRMImm is emitModRM for an instruction whose last field, after rm's
// displacement, is an immBytes-byte immediate.  A `[rip + label]` operand's
// displacement counts from the end of the instruction, past the immediate,
// so its fixup's addend is reduced by immBytes (emitRipModRM).
func emitModRMImm(a @asm.Assembler, regField int, rm Operand, immBytes int) {
	if rm.Kind == OP_RIPLABEL {
		emitRipModRM(a, regField, rm, immBytes)
		return
	}
	if rm.Kind == OP_REG {
		// mod=11, reg=regField, rm=reg
		var modrm int = 0xC0 | (regLo3(regField) << 3) | regLo3(rm.Reg)
		emit8(a, modrm)
		return
	}
	// Memory operand
	var base int = rm.Base
	var index int = rm.Index
	var disp int = rm.Disp
	if !memOperandOk(a, rm) { return }

	if base < 0 && index < 0 {
		if rm.Abs {
			// Absolute: mod=00, rm=100 and a SIB of no index and no base (101), then
			// disp32 (mod=00 rm=101 alone is RIP-relative).
			emit8(a, (regLo3(regField) << 3) | 4)
			emit8(a, 0x25)
			emit32le(a, disp)
			return
		}
		// RIP-relative: mod=00, rm=101, no SIB
		emit8(a, (regLo3(regField) << 3) | 5)
		emit32le(a, disp)
		return
	}
	if base < 0 {
		// An index with no base: mod=00, rm=100 and a SIB whose base field 101 means
		// none, then disp32.
		emit8(a, (regLo3(regField) << 3) | 4)
		emit8(a, (scaleEnc(rm.Scale) << 6) | (regLo3(index) << 3) | 5)
		emit32le(a, disp)
		return
	}

	// Determine if we need a SIB byte
	var needSib bool = false
	if index >= 0 { needSib = true }
	// RSP/R12 as base always needs SIB (rm=100 encodes SIB escape)
	if base >= 0 && regLo3(base) == 4 { needSib = true }

	// Determine mod field from displacement
	var mod int = 0
	if disp == 0 {
		// RBP/R13 as base with disp=0 needs mod=01 disp8=0
		// (mod=00 rm=101 means RIP-relative, not [rbp])
		if base >= 0 && regLo3(base) == 5 {
			mod = 1
		} else {
			mod = 0
		}
	} else if fitsI8(disp) {
		mod = 1
	} else {
		mod = 2
	}

	if needSib {
		// ModR/M: mod | reg | 100 (SIB follows)
		emit8(a, (mod << 6) | (regLo3(regField) << 3) | 4)
		// SIB: scale | index | base
		var sibIndex int = 4 // 100 = no index
		var sibScale int = 0 // unused without an index; 00 as clang emits it
		if index >= 0 {
			sibIndex = regLo3(index)
			sibScale = scaleEnc(rm.Scale)
		}
		var sibBase int = regLo3(base)
		emit8(a, (sibScale << 6) | (sibIndex << 3) | sibBase)
	} else {
		// ModR/M: mod | reg | base
		emit8(a, (mod << 6) | (regLo3(regField) << 3) | regLo3(base))
	}

	// Displacement
	if mod == 1 {
		emit8(a, disp)
	} else if mod == 2 {
		emit32le(a, disp)
	}
}

// opSize returns the operation size of the two-operand instruction mnem whose dst is a register
// or memory operand: dst's size, which must be SZ8, SZ16, SZ32 or SZ64 and, for a register or
// memory src, src's too (clang: "invalid operand for instruction" — `mov qword ptr [rax], ecx`,
// `add rax, ecx`); an immediate takes dst's.  An unsized `[rip + label]` operand (ripUnsized)
// takes the size of a register on the other side.  Else it sets the error and returns 0.
func opSize(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand) int {
	var size int = dst.Size
	if ripUnsized(dst) && src.Kind == OP_REG { size = src.Size }
	if !gpSizeOK(size) {
		setOperandError(a, mnem, "invalid operand size")
		return 0
	}
	if isRM(src) && src.Size != size && !(ripUnsized(src) && dst.Kind == OP_REG) {
		setOperandError(a, mnem, "operand sizes differ")
		return 0
	}
	return size
}

// emitSizePrefix emits a 0x66 operand-size override for 16-bit.
func emitSizePrefix(a @asm.Assembler, size int) {
	if size == SZ16 { emit8(a, 0x66) }
}

// rexW returns true if REX.W is needed for this operand size.
func rexW(size int) bool { return size == SZ64 }

// isRM reports whether op can be a ModR/M r/m operand: a register or a memory
// operand (isMem).  An immediate, a label or a GOT-indirect operand is not.
func isRM(op Operand) bool { return op.Kind == OP_REG || isMem(op) }

// isMem reports whether op is a memory operand: an OP_MEM address, or a
// `[rip + label]` (OP_RIPLABEL), which emitModRM encodes with its fixup.
func isMem(op Operand) bool { return op.Kind == OP_MEM || op.Kind == OP_RIPLABEL }

// setOperandError records the assembler error "x64: <mnem>: <problem>" for an
// instruction whose operands it cannot encode.  An encoder that rejects an
// operand's kind or size does so before emitting anything, so such a rejected
// instruction emits no bytes (a memory operand's own checks run as it is
// encoded: memOperandOk).
func setOperandError(a @asm.Assembler, mnem *[]readonly char, problem *[]readonly char) {
	var head @[]char = buf.Concat("x64: ", mnem)
	var withSep @[]char = buf.Concat(head, ": ")
	a.SetError(buf.Concat(withSep, problem))
}

// setKindsError records an assembler error for instruction mnem given an
// operand combination it has no encoding for (see setOperandError).
func setKindsError(a @asm.Assembler, mnem *[]readonly char) {
	setOperandError(a, mnem, "unsupported operand kinds")
}

// condOK reports whether cc is a condition code (CC_O..CC_G, 0..15), the
// 4-bit field of the Jcc / SETcc opcodes, else records an assembler error
// naming mnem.
func condOK(a @asm.Assembler, mnem *[]readonly char, cc int) bool {
	if cc >= CC_O && cc <= CC_G { return true }
	setOperandError(a, mnem, "condition code out of range (accepts CC_O..CC_G, 0..15)")
	return false
}

// aluMnemonic names the ALU operation whose 0x80/0x81/0x83 opcode
// extension is immExt, for error messages.
func aluMnemonic(immExt int) *[]readonly char {
	if immExt == 0 { return "add" }
	if immExt == 1 { return "or" }
	if immExt == 4 { return "and" }
	if immExt == 5 { return "sub" }
	if immExt == 6 { return "xor" }
	if immExt == 7 { return "cmp" }
	return "alu"
}

// emitALU emits a standard ALU instruction (ADD, SUB, AND, OR, XOR,
// CMP). These share the same encoding pattern with different opcode
// bases. opcodeReg is the reg-reg base (e.g., 0x01 for ADD r/m, r).
// immExt is the /r extension for the 0x80/0x81/0x83 immediate forms.
// The forms are r/m, reg; reg, mem; and r/m, imm.  Any other operand
// combination, or an immediate src that does not fit the operation width
// (immFits), sets an assembler error and emits nothing.
func emitALU(a @asm.Assembler, dst Operand, src Operand, opcodeReg int, immExt int) {
	var regSrc bool = src.Kind == OP_REG && isRM(dst)
	var memSrc bool = isMem(src) && dst.Kind == OP_REG
	var immSrc bool = src.Kind == OP_IMM && isRM(dst)
	if !regSrc && !memSrc && !immSrc {
		setKindsError(a, aluMnemonic(immExt))
		return
	}
	var size int = opSize(a, aluMnemonic(immExt), dst, src)
	if size == 0 { return }
	if immSrc && !immFits(src.Imm, size) {
		setImmRangeError(a, aluMnemonic(immExt), size)
		return
	}
	emitSizePrefix(a, size)

	if regSrc {
		// r/m, reg: opcode+1 for word/dword/qword.  Force REX for an SZ8 byte
		// register RSP/RBP/RSI/RDI so its low byte, not AH/CH/DH/BH, is used
		// (a memory operand's base is addressing, not a byte access).
		var f8 bool = size == SZ8 &&
				(byteRegHazard(src.Reg) || (dst.Kind == OP_REG && byteRegHazard(dst.Reg)))
		emitRexRM(a, rexW(size), src.Reg, dst, f8)
		if size == SZ8 {
			emit8(a, opcodeReg - 1) // byte form is opcodeReg-1
		} else {
			emit8(a, opcodeReg)
		}
		emitModRM(a, src.Reg, dst)
		return
	}
	if memSrc {
		// reg, [mem]: opcode+2/+3
		var f8 bool = size == SZ8 && byteRegHazard(dst.Reg)
		emitRexRM(a, rexW(size), dst.Reg, src, f8)
		if size == SZ8 {
			emit8(a, opcodeReg + 1) // byte form
		} else {
			emit8(a, opcodeReg + 2) // word/dword/qword r, r/m
		}
		emitModRM(a, dst.Reg, src)
		return
	}
	// r/m, imm (the remaining validated form).
	var f8 bool = size == SZ8 && dst.Kind == OP_REG && byteRegHazard(dst.Reg)
	emitRexRM(a, rexW(size), 0, dst, f8)
	// The imm8 choice is made on the value at the operation width, so
	// e.g. a 32-bit 0xFFFFFFF0 (-16) takes the short 0x83 form.
	var w int64 = immAtWidth(src.Imm, size)
	if size == SZ8 {
		emit8(a, 0x80)
		emitModRMImm(a, immExt, dst, 1)
		emitImmW(a, w, size)
	} else if immFitsI8(w) {
		emit8(a, 0x83) // sign-extended imm8
		emitModRMImm(a, immExt, dst, 1)
		emit8(a, cast(int, w))
	} else {
		emit8(a, 0x81) // imm16 (SZ16) / imm32
		emitModRMImm(a, immExt, dst, immBytes(size))
		emitImmW(a, w, size)
	}
}
