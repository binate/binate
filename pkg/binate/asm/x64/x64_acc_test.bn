package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// ADC / SBB, the accumulator's short forms of the ALU group and TEST, and the accumulator's sign
// extensions, against clang's bytes (`clang --target=x86_64-linux-gnu -c`, Intel syntax).
// (symCase is in x64_immsym_test.bn.)

// aluCase appends to e a failure named what unless a holds exactly hex.
func aluCase(e @[]char, a @asm.Assembler, what @[]char, hex *[]readonly char) @[]char {
	if emitsExactly(a, hex) || len(e) > 0 { return e }
	return fail(what)
}

// ADC (11 /r, 13 /r, 83 /2, 81 /2, 80 /2, 15, 14) and SBB (19 /r, 1B /r, 83 /3, 81 /3, 80 /3, 1D,
// 1C) in each form.
func TestAdcSbb() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Adc(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "adc rax, rbx", "48 11 d8")
	a = newAsm()
	Adc(a, Reg(RAX, SZ64), Mem(RBX, 0, SZ64))
	e = aluCase(e, a, "adc rax, [rbx]", "48 13 03")
	a = newAsm()
	Adc(a, Mem(RBX, 0, SZ64), Reg(RAX, SZ64))
	e = aluCase(e, a, "adc [rbx], rax", "48 11 03")
	a = newAsm()
	Adc(a, Reg(RAX, SZ64), Imm(5))
	e = aluCase(e, a, "adc rax, 5", "48 83 d0 05")
	a = newAsm()
	Adc(a, Reg(RAX, SZ64), Imm(300))
	e = aluCase(e, a, "adc rax, 300", "48 15 2c 01 00 00")
	a = newAsm()
	Adc(a, Reg(RAX, SZ8), Imm(5))
	e = aluCase(e, a, "adc al, 5", "14 05")
	a = newAsm()
	Adc(a, Mem(RBX, 0, SZ64), Imm(5))
	e = aluCase(e, a, "adc qword ptr [rbx], 5", "48 83 13 05")
	a = newAsm()
	Adc(a, Reg(RCX, SZ64), Imm(300))
	e = aluCase(e, a, "adc rcx, 300", "48 81 d1 2c 01 00 00")
	a = newAsm()
	Adc(a, Reg(RCX, SZ8), Imm(5))
	e = aluCase(e, a, "adc cl, 5", "80 d1 05")
	a = newAsm()
	Sbb(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "sbb rax, rbx", "48 19 d8")
	a = newAsm()
	Sbb(a, Reg(RAX, SZ64), Mem(RBX, 0, SZ64))
	e = aluCase(e, a, "sbb rax, [rbx]", "48 1b 03")
	a = newAsm()
	Sbb(a, Reg(RCX, SZ64), Imm(5))
	e = aluCase(e, a, "sbb rcx, 5", "48 83 d9 05")
	a = newAsm()
	Sbb(a, Reg(RCX, SZ64), Imm(300))
	e = aluCase(e, a, "sbb rcx, 300", "48 81 d9 2c 01 00 00")
	a = newAsm()
	Sbb(a, Reg(RAX, SZ32), Imm(300))
	e = aluCase(e, a, "sbb eax, 300", "1d 2c 01 00 00")
	a = newAsm()
	Sbb(a, Reg(RCX, SZ8), Imm(5))
	e = aluCase(e, a, "sbb cl, 5", "80 d9 05")
	a = newAsm()
	Sbb(a, Reg(RAX, SZ8), Imm(-1))
	e = aluCase(e, a, "sbb al, -1", "1c ff")
	return e
}

// AL's short form always (`add al, 1` 04 01, `cmp al, 1` 3C 01, `and al, 0x80` 24 80); AX / EAX /
// RAX's where the imm8 form cannot hold the number (`add eax, 300` 05, `add ax, 300` 66 05,
// `add rax, -300` 48 05, `xor eax, 0x80` 35), the imm8 form where it can (`add eax, 1` 83 C0 01,
// `or ax, -1` 66 83 C8 FF); another register never (`sbb cl, 5` 80 D9 05).
func TestAccumulatorForms() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Add(a, Reg(RAX, SZ8), Imm(1))
	e = aluCase(e, a, "add al, 1", "04 01")
	a = newAsm()
	Cmp(a, Reg(RAX, SZ8), Imm(1))
	e = aluCase(e, a, "cmp al, 1", "3c 01")
	a = newAsm()
	And(a, Reg(RAX, SZ8), Imm(0x80))
	e = aluCase(e, a, "and al, 0x80", "24 80")
	a = newAsm()
	Add(a, Reg(RAX, SZ16), Imm(1))
	e = aluCase(e, a, "add ax, 1", "66 83 c0 01")
	a = newAsm()
	Add(a, Reg(RAX, SZ16), Imm(300))
	e = aluCase(e, a, "add ax, 300", "66 05 2c 01")
	a = newAsm()
	Cmp(a, Reg(RAX, SZ16), Imm(0x1234))
	e = aluCase(e, a, "cmp ax, 0x1234", "66 3d 34 12")
	a = newAsm()
	Or(a, Reg(RAX, SZ16), Imm(-1))
	e = aluCase(e, a, "or ax, -1", "66 83 c8 ff")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(1))
	e = aluCase(e, a, "add eax, 1", "83 c0 01")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(300))
	e = aluCase(e, a, "add eax, 300", "05 2c 01 00 00")
	a = newAsm()
	Xor(a, Reg(RAX, SZ32), Imm(0x80))
	e = aluCase(e, a, "xor eax, 0x80", "35 80 00 00 00")
	a = newAsm()
	Add(a, Reg(RAX, SZ64), Imm(300))
	e = aluCase(e, a, "add rax, 300", "48 05 2c 01 00 00")
	a = newAsm()
	Sub(a, Reg(RAX, SZ64), Imm(-300))
	e = aluCase(e, a, "sub rax, -300", "48 2d d4 fe ff ff")
	a = newAsm()
	Add(a, Reg(R8, SZ64), Imm(300))
	e = aluCase(e, a, "add r8, 300", "49 81 c0 2c 01 00 00")
	return e
}

// The imm8 form's edge, on the value at the operation width: 127 and -128 take it, 128 and -129
// the accumulator's (`add eax, 128` 05, `add eax, -129` 05 7F FF FF FF); 0xFFFFFF80 at 32 bits and
// 0xFF80 at 16 are -128 (83 C0 80, 66 83 C0 80), 0xFFFFFF7F -129 (05); AL never takes it.
func TestAccumulatorImm8Edge() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Add(a, Reg(RAX, SZ8), Imm(127))
	e = aluCase(e, a, "add al, 127", "04 7f")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(127))
	e = aluCase(e, a, "add eax, 127", "83 c0 7f")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(128))
	e = aluCase(e, a, "add eax, 128", "05 80 00 00 00")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(-128))
	e = aluCase(e, a, "add eax, -128", "83 c0 80")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm(-129))
	e = aluCase(e, a, "add eax, -129", "05 7f ff ff ff")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm64(0xFFFFFF80))
	e = aluCase(e, a, "add eax, 0xFFFFFF80", "83 c0 80")
	a = newAsm()
	Add(a, Reg(RAX, SZ16), Imm(0xFF80))
	e = aluCase(e, a, "add ax, 0xFF80", "66 83 c0 80")
	a = newAsm()
	Add(a, Reg(RAX, SZ32), Imm64(0xFFFFFF7F))
	e = aluCase(e, a, "add eax, 0xFFFFFF7F", "05 7f ff ff ff")
	return e
}

// TEST's short forms: A8 ib for AL, A9 for AX / EAX / RAX whatever the value; another register
// keeps F6 / F7 /0.
func TestTestAccumulatorForms() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RAX, SZ8), Imm(1))
	e = aluCase(e, a, "test al, 1", "a8 01")
	a = newAsm()
	Test(a, Reg(RAX, SZ16), Imm(1))
	e = aluCase(e, a, "test ax, 1", "66 a9 01 00")
	a = newAsm()
	Test(a, Reg(RAX, SZ32), Imm(1))
	e = aluCase(e, a, "test eax, 1", "a9 01 00 00 00")
	a = newAsm()
	Test(a, Reg(RAX, SZ64), Imm(-1))
	e = aluCase(e, a, "test rax, -1", "48 a9 ff ff ff ff")
	a = newAsm()
	Test(a, Reg(RCX, SZ8), Imm(1))
	e = aluCase(e, a, "test cl, 1", "f6 c1 01")
	a = newAsm()
	Test(a, Reg(RCX, SZ32), Imm(0x12345))
	e = aluCase(e, a, "test ecx, 0x12345", "f7 c1 45 23 01 00")
	return e
}

// A symbol keeps the ALU group's general form past 8 bits (`add eax, offset x` 81 C0, `add ax` 66
// 81 C0) but takes AL's short one (`add al, offset x` 04) and TEST's (`test eax, offset x` A9,
// `test rax` 48 A9), as clang's.
func TestAccumulatorSymbols() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Add(a, Reg(RAX, SZ8), ImmSym("x", 0, 0))
	e = symCase(e, a, "add al, offset x", "04 00", asm.FIX_DATA_ABS8, 1, 0)
	a = newAsm()
	Add(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "add eax, offset x", "81 c0 00 00 00 00", asm.FIX_DATA_ABS32, 2, 0)
	a = newAsm()
	Add(a, Reg(RAX, SZ16), ImmSym("x", 0, 0))
	e = symCase(e, a, "add ax, offset x", "66 81 c0 00 00", asm.FIX_DATA_ABS16, 3, 0)
	a = newAsm()
	Adc(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "adc rax, offset x", "48 81 d0 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Test(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "test rax, offset x", "48 a9 00 00 00 00", FIX_ABS32S, 2, 0)
	a = newAsm()
	Test(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "test eax, offset x", "a9 00 00 00 00", asm.FIX_DATA_ABS32, 1, 0)
	a = newAsm()
	Test(a, Reg(RAX, SZ8), ImmSym("x", 0, 0))
	e = symCase(e, a, "test al, offset x", "a8 00", asm.FIX_DATA_ABS8, 1, 0)
	return e
}

// The accumulator's sign extensions: CBW 66 98, CWDE 98, CDQE 48 98, CWD 66 99, CDQ 99, CQO 48 99.
func TestAccumulatorExtensions() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cbw(a)
	Cwde(a)
	Cdqe(a)
	Cwd(a)
	Cdq(a)
	Cqo(a)
	if !emitsExactly(a, "66 98 98 48 98 66 99 99 48 99") {
		return fail("the accumulator's sign extensions are not clang's")
	}
	return ""
}
