package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- ALU instructions ---
// Standard ALU ops share encoding patterns. The opcode base and /r
// extension differ per operation:
//   ADD: reg base 0x01, /r=0
//   OR:  reg base 0x09, /r=1
//   AND: reg base 0x21, /r=4
//   SUB: reg base 0x29, /r=5
//   XOR: reg base 0x31, /r=6
//   CMP: reg base 0x39, /r=7

// Add emits `add dst, src` (dst <- dst + src), updating flags.
func Add(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x01, 0)
}

// Or emits `or dst, src` (dst <- dst | src), updating flags.
func Or(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x09, 1)
}

// And emits `and dst, src` (dst <- dst & src), updating flags.
func And(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x21, 4)
}

// Sub emits `sub dst, src` (dst <- dst - src), updating flags.
func Sub(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x29, 5)
}

// Xor emits `xor dst, src` (dst <- dst ^ src), updating flags.
func Xor(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x31, 6)
}

// Cmp emits `cmp dst, src`, updating flags as if `dst - src` had been
// computed but discarding the result.
func Cmp(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x39, 7)
}

// TEST: like AND but only sets flags (no result stored).
// Encoding: r/m,reg = 0x85 (word) / 0x84 (byte)
//           r/m,imm = 0xF7 /0 iw/id (word) / 0xF6 /0 ib (byte) — there is
//           no sign-extended imm8 form, so the immediate is always
//           operation-width.
// TEST is commutative, so reg, mem is encoded as the r/m,reg form with
// the operands swapped (as clang does).  Any other operand combination,
// or an immediate that does not fit the operation width (immFits), sets
// an assembler error and emits nothing.
func Test(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind == OP_REG && src.Kind == OP_MEM {
		Test(a, src, dst)
		return
	}
	var regSrc bool = src.Kind == OP_REG && isRM(dst)
	var immSrc bool = src.Kind == OP_IMM && isRM(dst)
	if !regSrc && !immSrc {
		setKindsError(a, "test")
		return
	}
	var size int = operandSize(dst, src)
	if immSrc && !immFits(src.Imm, size) {
		setImmRangeError(a, "test", size)
		return
	}
	emitSizePrefix(a, size)
	if regSrc {
		var f8 bool = size == SZ8 &&
				(byteRegHazard(src.Reg) || (dst.Kind == OP_REG && byteRegHazard(dst.Reg)))
		emitRexRM(a, rexW(size), src.Reg, dst, f8)
		if size == SZ8 {
			emit8(a, 0x84)
		} else {
			emit8(a, 0x85)
		}
		emitModRM(a, src.Reg, dst)
		return
	}
	var f8i bool = size == SZ8 && dst.Kind == OP_REG && byteRegHazard(dst.Reg)
	emitRexRM(a, rexW(size), 0, dst, f8i)
	if size == SZ8 {
		emit8(a, 0xF6)
	} else {
		emit8(a, 0xF7)
	}
	emitModRM(a, 0, dst)
	emitImmW(a, immAtWidth(src.Imm, size), size)
}

// --- Unary operations (INC, DEC, NEG, NOT) ---
// These use 0xF7 /ext (word) or 0xF6 /ext (byte):
//   NOT: /2, NEG: /3
// INC/DEC use 0xFF /0 (INC) / 0xFF /1 (DEC) for word,
//   0xFE /0 / 0xFE /1 for byte.

// emitUnaryRM emits a one-operand group instruction on the register or memory
// operand rm: opcode op8 for an 8-bit operand, else opW, with the opcode
// extension ext in the ModR/M reg field.  INC/DEC (FE/FF /0,/1), NOT/NEG
// (F6/F7 /2,/3) and MUL/IMUL/DIV/IDIV (F6/F7 /4../7) all share this shape.  A
// non-r/m operand sets an assembler error (naming mnem) and emits nothing.
func emitUnaryRM(a @asm.Assembler, mnem *[]readonly char, rm Operand, op8 int, opW int, ext int) {
	if !isRM(rm) {
		setKindsError(a, mnem)
		return
	}
	var size int = rm.Size
	emitSizePrefix(a, size)
	var f8 bool = size == SZ8 && rm.Kind == OP_REG && byteRegHazard(rm.Reg)
	emitRexRM(a, rexW(size), 0, rm, f8)
	if size == SZ8 {
		emit8(a, op8)
	} else {
		emit8(a, opW)
	}
	emitModRM(a, ext, rm)
}

// Inc emits `inc dst` (dst <- dst + 1), updating flags except CF.
func Inc(a @asm.Assembler, dst Operand) {
	emitUnaryRM(a, "inc", dst, 0xFE, 0xFF, 0)
}

// Dec emits `dec dst` (dst <- dst - 1), updating flags.
func Dec(a @asm.Assembler, dst Operand) {
	emitUnaryRM(a, "dec", dst, 0xFE, 0xFF, 1)
}

// Neg emits `neg dst` (dst <- 0 - dst), updating flags.
func Neg(a @asm.Assembler, dst Operand) {
	emitUnaryRM(a, "neg", dst, 0xF6, 0xF7, 3)
}

// Not emits `not dst` (dst <- ~dst). Does NOT update flags
// (unlike most ALU ops on x86).
func Not(a @asm.Assembler, dst Operand) {
	emitUnaryRM(a, "not", dst, 0xF6, 0xF7, 2)
}

// --- Shift instructions ---
// SHL/SHR/SAR: 0xD3 /ext for reg,CL; 0xC1 /ext for reg,imm8
//   SHL: /4, SHR: /5, SAR: /7

// emitShift emits a shift instruction (SHL/SHR/SAR). ext selects the
// opcode extension (/4, /5, /7). count is either CL (Reg(RCX, SZ8)) or
// an imm8 in -128..255, the range clang accepts (the CPU masks the count
// to 5 or 6 bits).  A non-r/m dst, any other count, or an out-of-range
// immediate count sets an assembler error and emits nothing.
func emitShift(a @asm.Assembler, mnem *[]readonly char, dst Operand, count Operand, ext int) {
	var byCL bool = count.Kind == OP_REG && count.Reg == RCX && count.Size == SZ8
	var byImm bool = count.Kind == OP_IMM
	if !isRM(dst) {
		setKindsError(a, mnem)
		return
	}
	if !byCL && !byImm {
		setOperandError(a, mnem, "count must be cl or an imm8")
		return
	}
	if byImm && !immFits(count.Imm, SZ8) {
		setImm8RangeError(a, mnem, "count")
		return
	}
	var size int = dst.Size
	emitSizePrefix(a, size)
	var f8 bool = size == SZ8 && dst.Kind == OP_REG && byteRegHazard(dst.Reg)
	emitRexRM(a, rexW(size), 0, dst, f8)
	if byCL {
		// Shift by CL: 0xD2 (byte) / 0xD3 (word/dword/qword)
		if size == SZ8 {
			emit8(a, 0xD2)
		} else {
			emit8(a, 0xD3)
		}
		emitModRM(a, ext, dst)
	} else if count.Imm == 1 {
		// Shift by 1: 0xD0 (byte) / 0xD1 (word)
		if size == SZ8 {
			emit8(a, 0xD0)
		} else {
			emit8(a, 0xD1)
		}
		emitModRM(a, ext, dst)
	} else {
		// Shift by imm8: 0xC0 (byte) / 0xC1 (word)
		if size == SZ8 {
			emit8(a, 0xC0)
		} else {
			emit8(a, 0xC1)
		}
		emitModRM(a, ext, dst)
		emit8(a, cast(int, count.Imm))
	}
}

// Shl emits `shl dst, count` — logical shift left. count is either an
// immediate or `cl` (encoded by emitShift via Operand kind).
func Shl(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "shl", dst, count, 4)
}

// Shr emits `shr dst, count` — logical (unsigned) shift right.
func Shr(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "shr", dst, count, 5)
}

// Sar emits `sar dst, count` — arithmetic (sign-preserving) shift right.
func Sar(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "sar", dst, count, 7)
}

// --- Multiply / Divide ---

// IMUL r, r/m: 0F AF /r (two-operand signed multiply).  dst must be a
// register and src a register or memory operand, and there is no 8-bit
// form; anything else sets an assembler error and emits nothing.
func Imul2(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, "imul")
		return
	}
	var size int = dst.Size
	if size == SZ8 {
		a.SetError("x64: imul r, r/m has no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	emitRexRM(a, rexW(size), dst.Reg, src, false)
	emit8(a, 0x0F)
	emit8(a, 0xAF)
	emitModRM(a, dst.Reg, src)
}

// IMUL r, r/m, imm: 0x6B /r ib (sign-extended imm8) or 0x69 /r iw/id
// (operation-width imm16 / imm32).  dst must be a register and src a
// register or memory operand.  Any other operand kinds, an 8-bit dst
// (there is no 8-bit form) or an immediate that does not fit the
// operation width (immFits) sets an assembler error and emits nothing.
func Imul3(a @asm.Assembler, dst Operand, src Operand, imm int) {
	if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, "imul")
		return
	}
	var size int = dst.Size
	if size == SZ8 {
		a.SetError("x64: imul r, r/m, imm has no 8-bit form")
		return
	}
	if !immFits(cast(int64, imm), size) {
		setImmRangeError(a, "imul", size)
		return
	}
	var w int64 = immAtWidth(cast(int64, imm), size)
	emitSizePrefix(a, size)
	emitRexRM(a, rexW(size), dst.Reg, src, false)
	if immFitsI8(w) {
		emit8(a, 0x6B)
		emitModRM(a, dst.Reg, src)
		emit8(a, cast(int, w))
	} else {
		emit8(a, 0x69)
		emitModRM(a, dst.Reg, src)
		emitImmW(a, w, size)
	}
}

// IDIV r/m: 0xF7 /7 (signed divide RDX:RAX by r/m)
func Idiv(a @asm.Assembler, src Operand) {
	emitUnaryRM(a, "idiv", src, 0xF6, 0xF7, 7)
}

// DIV r/m: 0xF7 /6 (unsigned divide)
func Div(a @asm.Assembler, src Operand) {
	emitUnaryRM(a, "div", src, 0xF6, 0xF7, 6)
}

// Imul1: one-operand IMUL — RDX:RAX = RAX * src (signed).  0xF7 /5.  The high
// half of the 128-bit product lands in RDX (the signed multiply-high used by
// constant-divisor magic-number division).  Cross-checked against the
// assembler: `imul rcx` = 48 F7 E9, `imul r9` = 49 F7 E9.
func Imul1(a @asm.Assembler, src Operand) {
	emitUnaryRM(a, "imul", src, 0xF6, 0xF7, 5)
}

// Mul1: one-operand MUL — RDX:RAX = RAX * src (unsigned).  0xF7 /4.  RDX gets
// the unsigned multiply-high.  `mul rcx` = 48 F7 E1.
func Mul1(a @asm.Assembler, src Operand) {
	emitUnaryRM(a, "mul", src, 0xF6, 0xF7, 4)
}

// CQO: sign-extend RAX into RDX:RAX (REX.W + 0x99)
func Cqo(a @asm.Assembler) {
	emit8(a, 0x48) // REX.W
	emit8(a, 0x99)
}

// CDQ: sign-extend EAX into EDX:EAX (0x99, no REX.W)
func Cdq(a @asm.Assembler) {
	emit8(a, 0x99)
}
