package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_arith.bn — ALU (Add/Sub/Or/And/Xor/Cmp/Test),
// unary ops (Inc/Dec/Neg/Not), shifts (Shl/Shr/Sar), and
// multiply/divide (Imul2/Imul3/Idiv/Div/Cqo/Cdq).
// Data-movement encoders (MOV/LEA/PUSH/POP/SETcc/MOVZX/MOVSX/
// MOVSXD/LeaRipLabel) are tested in x64_data_test.bn alongside
// their production-code split in x64_data.bn.

// --- ADD tests ---

func TestAddRegReg64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, RCX = REX.W 01 C8
	Add(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0x01
	expected[2] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, RCX encoding wrong")
	}
	return ""
}

func TestAddRegImm8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, 1 = REX.W 83 C0 01 (sign-extended imm8)
	Add(a, Reg(RAX, SZ64), Imm(1))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x83
	expected[2] = 0xC0
	expected[3] = 0x01
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, 1 encoding wrong")
	}
	return ""
}

func TestAddRegImm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, 256 = REX.W 81 C0 00010000
	Add(a, Reg(RAX, SZ64), Imm(256))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48
	expected[1] = 0x81
	expected[2] = 0xC0
	expected[3] = 0x00
	expected[4] = 0x01
	expected[5] = 0x00
	expected[6] = 0x00
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, 256 encoding wrong")
	}
	return ""
}

// --- SUB / XOR / CMP ---

func TestSubRegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SUB EAX, ECX = 29 C8
	Sub(a, Reg(RAX, SZ32), Reg(RCX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x29
	expected[1] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("SUB EAX, ECX encoding wrong")
	}
	return ""
}

func TestXorRegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// XOR EAX, EAX = 31 C0 (common zero-register idiom)
	Xor(a, Reg(RAX, SZ32), Reg(RAX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x31
	expected[1] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("XOR EAX, EAX encoding wrong")
	}
	return ""
}

func TestCmpRegImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CMP RAX, 0 = REX.W 83 F8 00
	Cmp(a, Reg(RAX, SZ64), Imm(0))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x83
	expected[2] = 0xF8
	expected[3] = 0x00
	if !checkBytes(s, 0, expected) {
		return fail("CMP RAX, 0 encoding wrong")
	}
	return ""
}

// --- Unary ops ---

func TestIncReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// INC RAX = REX.W FF C0
	Inc(a, Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0xFF
	expected[2] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("INC RAX encoding wrong")
	}
	return ""
}

func TestNegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// NEG EAX = F7 D8 (no REX for 32-bit)
	Neg(a, Reg(RAX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0xF7
	expected[1] = 0xD8
	if !checkBytes(s, 0, expected) {
		return fail("NEG EAX encoding wrong")
	}
	return ""
}

// --- Shift ---

func TestShlImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SHL RAX, 4 = REX.W C1 E0 04
	Shl(a, Reg(RAX, SZ64), Imm(4))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0xC1
	expected[2] = 0xE0
	expected[3] = 0x04
	if !checkBytes(s, 0, expected) {
		return fail("SHL RAX, 4 encoding wrong")
	}
	return ""
}

// --- IMUL ---

func TestImul2() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// IMUL RAX, RCX = REX.W 0F AF C1
	Imul2(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x0F
	expected[2] = 0xAF
	expected[3] = 0xC1
	if !checkBytes(s, 0, expected) {
		return fail("IMUL RAX, RCX encoding wrong")
	}
	return ""
}

func TestImul3() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// IMUL RAX, RCX, 10 = REX.W 6B C1 0A
	Imul3(a, Reg(RAX, SZ64), Reg(RCX, SZ64), 10)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x6B
	expected[2] = 0xC1
	expected[3] = 0x0A
	if !checkBytes(s, 0, expected) {
		return fail("IMUL RAX, RCX, 10 encoding wrong")
	}
	return ""
}

// One-operand IMUL/MUL (RDX:RAX = RAX * src). Cross-checked against the
// assembler: imul rcx = 48 F7 E9, mul rcx = 48 F7 E1.
func TestImul1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Imul1(a, Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0xF7
	expected[2] = 0xE9
	if !checkBytes(s, 0, expected) {
		return fail("IMUL RCX encoding wrong")
	}
	return ""
}

func TestMul1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mul1(a, Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0xF7
	expected[2] = 0xE1
	if !checkBytes(s, 0, expected) {
		return fail("MUL RCX encoding wrong")
	}
	return ""
}

// --- CQO / CDQ ---

func TestCqo() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CQO = 48 99
	Cqo(a)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x48
	expected[1] = 0x99
	if !checkBytes(s, 0, expected) {
		return fail("CQO encoding wrong")
	}
	return ""
}

// --- Byte-register REX hazard (ALU / TEST) ---
// Like the MOV case (x64_data_test.bn), an 8-bit ALU or TEST op whose
// byte-accessed register operand is RSP/RBP/RSI/RDI (codes 4-7) MUST
// carry a REX prefix so its low byte, not AH/CH/DH/BH, is used.  The
// backend reaches this via SZ8 And/Or on scratch registers when folding
// a boolean into a byte result.

// AND SIL, AL: SIL (RSI=6) is the byte destination (r/m) — 40 20 C6.
func TestAndByteSilForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RSI, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → SIL, not DH
	expected[1] = 0x20 // AND r/m8, r8 (byte form = 0x21-1)
	expected[2] = 0xC6 // mod=11 reg=000(AL) rm=110(SIL)
	if !checkBytes(s, 0, expected) {
		return fail("AND SIL, AL must force REX (else DH)")
	}
	return ""
}

// TEST DIL, AL: DIL (RDI=7) is a byte operand — 40 84 C7.
func TestTestByteDilForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RDI, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → DIL, not BH
	expected[1] = 0x84 // TEST r/m8, r8
	expected[2] = 0xC7 // mod=11 reg=000(AL) rm=111(DIL)
	if !checkBytes(s, 0, expected) {
		return fail("TEST DIL, AL must force REX (else BH)")
	}
	return ""
}

// NEG BPL: BPL (RBP=5) is the byte operand of a unary op — 40 F6 DD.
func TestNegByteBplForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Neg(a, Reg(RBP, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → BPL, not CH
	expected[1] = 0xF6 // F6 /3 (byte NEG)
	expected[2] = 0xDD // mod=11 reg=011(/3) rm=101(BPL)
	if !checkBytes(s, 0, expected) {
		return fail("NEG BPL must force REX (else CH)")
	}
	return ""
}

// AND CL, AL: neither operand is a byte-hazard register (RCX=1, RAX=0),
// so NO REX is emitted — a negative control the force must not trip.
func TestAndByteNoHazardNoRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x20 // AND r/m8, r8 — no REX
	expected[1] = 0xC1 // mod=11 reg=000(AL) rm=001(CL)
	if !checkBytes(s, 0, expected) {
		return fail("AND CL, AL must NOT force REX")
	}
	return ""
}

// --- Immediate range and width (ALU / TEST / IMUL3) ---
// Expected bytes are clang's (`clang -target x86_64-apple-macos -c`,
// Intel syntax, disassembled with objdump).  Register destinations avoid
// RAX, for which clang prefers the accumulator short forms.

// A 16-bit immediate that does not fit the sign-extended imm8 takes the
// 2-byte imm16 of the 0x66-prefixed form; an imm32 there would leave two
// stray bytes that decode as the next instruction.
func TestAluImm16Forms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ16), Imm(0x1234))
	if !emitsExactly(a, "66 81 e1 34 12") { return fail("and cx, 0x1234") }
	a = newAsm()
	Add(a, Mem(RAX, 0, SZ16), Imm(0x1234))
	if !emitsExactly(a, "66 81 00 34 12") { return fail("add word ptr [rax], 0x1234") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(0x80))
	if !emitsExactly(a, "66 81 e1 80 00") { return fail("and cx, 0x80") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(-32768))
	if !emitsExactly(a, "66 81 e1 00 80") { return fail("and cx, -32768") }
	a = newAsm()
	Add(a, Mem(R12, 0, SZ16), Imm(0x1234))
	if !emitsExactly(a, "66 41 81 04 24 34 12") { return fail("add word ptr [r12], 0x1234") }
	return ""
}

// The imm8 choice is made on the value at the operation width,
// sign-interpreted: 0xFFFFFFF0 at 32 bits is -16 and 0xFFF0 at 16 bits
// is -16, so both take the short "83 /n ib" form, as clang does.
func TestAluImm8ChoiceAtWidth() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ32), Imm64(0xFFFFFFF0))
	if !emitsExactly(a, "83 e1 f0") { return fail("and ecx, 0xfffffff0") }
	a = newAsm()
	Cmp(a, Reg(RCX, SZ32), Imm64(0xFFFFFFFF))
	if !emitsExactly(a, "83 f9 ff") { return fail("cmp ecx, 0xffffffff") }
	a = newAsm()
	Add(a, Mem(RAX, 0, SZ32), Imm64(0xFFFFFFFF))
	if !emitsExactly(a, "83 00 ff") { return fail("add dword ptr [rax], 0xffffffff") }
	a = newAsm()
	Sub(a, Mem(R12, 0, SZ32), Imm64(0xFFFFFFF0))
	if !emitsExactly(a, "41 83 2c 24 f0") { return fail("sub dword ptr [r12], 0xfffffff0") }
	a = newAsm()
	Or(a, Reg(R9, SZ32), Imm64(0xFFFFFFFF))
	if !emitsExactly(a, "41 83 c9 ff") { return fail("or r9d, 0xffffffff") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(0xFFF0))
	if !emitsExactly(a, "66 83 e1 f0") { return fail("and cx, 0xfff0") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(0xFFFF))
	if !emitsExactly(a, "66 83 e1 ff") { return fail("and cx, 0xffff") }
	a = newAsm()
	Xor(a, Reg(RSI, SZ16), Imm(0xFF80))
	if !emitsExactly(a, "66 83 f6 80") { return fail("xor si, 0xff80") }
	return ""
}

// In-range 64/32/8-bit immediates, at the edges of the imm8 and imm32 ranges:
// a 32/64-bit operation takes the sign-extended imm8 form (83 /n ib) when the
// value at the operation width fits it, else 81 /n imm32; an 8-bit operation
// takes 80 /n ib (matching clang).  (16-bit forms: TestAluImm16Forms.)
func TestAluImmInRangeForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ64), Imm(0x7FFFFFFF))
	if !emitsExactly(a, "48 81 e1 ff ff ff 7f") { return fail("and rcx, 0x7fffffff") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm64(-2147483647 - 1))
	if !emitsExactly(a, "48 81 e1 00 00 00 80") { return fail("and rcx, -0x80000000") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm(-128))
	if !emitsExactly(a, "48 83 e1 80") { return fail("and rcx, -128") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm(127))
	if !emitsExactly(a, "48 83 e1 7f") { return fail("and rcx, 127") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm(0x80))
	if !emitsExactly(a, "48 81 e1 80 00 00 00") { return fail("and rcx, 0x80") }
	a = newAsm()
	Add(a, Mem(RAX, 8, SZ64), Imm(0x7FFFFFFF))
	if !emitsExactly(a, "48 81 40 08 ff ff ff 7f") { return fail("add qword ptr [rax+8], 0x7fffffff") }
	a = newAsm()
	Add(a, Mem(RAX, 0, SZ64), Imm(-1))
	if !emitsExactly(a, "48 83 00 ff") { return fail("add qword ptr [rax], -1") }
	a = newAsm()
	And(a, Reg(RCX, SZ32), Imm64(0x80000000))
	if !emitsExactly(a, "81 e1 00 00 00 80") { return fail("and ecx, 0x80000000") }
	a = newAsm()
	And(a, Reg(RCX, SZ32), Imm64(0xFFFFFF7F))
	if !emitsExactly(a, "81 e1 7f ff ff ff") { return fail("and ecx, 0xffffff7f") }
	a = newAsm()
	And(a, Reg(RCX, SZ8), Imm(255))
	if !emitsExactly(a, "80 e1 ff") { return fail("and cl, 255") }
	a = newAsm()
	And(a, Reg(RCX, SZ8), Imm(-128))
	if !emitsExactly(a, "80 e1 80") { return fail("and cl, -128") }
	return ""
}

// TEST has no sign-extended imm8 form: the immediate is always
// operation-width, imm16 for a 16-bit TEST.
func TestTestImmWidths() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RCX, SZ16), Imm(0x1234))
	if !emitsExactly(a, "66 f7 c1 34 12") { return fail("test cx, 0x1234") }
	a = newAsm()
	Test(a, Mem(RAX, 0, SZ16), Imm(0x1234))
	if !emitsExactly(a, "66 f7 00 34 12") { return fail("test word ptr [rax], 0x1234") }
	a = newAsm()
	Test(a, Reg(RCX, SZ16), Imm(0xFFFF))
	if !emitsExactly(a, "66 f7 c1 ff ff") { return fail("test cx, 0xffff") }
	a = newAsm()
	Test(a, Reg(RCX, SZ32), Imm64(0xFFFFFFFF))
	if !emitsExactly(a, "f7 c1 ff ff ff ff") { return fail("test ecx, 0xffffffff") }
	a = newAsm()
	Test(a, Reg(RCX, SZ64), Imm(-1))
	if !emitsExactly(a, "48 f7 c1 ff ff ff ff") { return fail("test rcx, -1") }
	a = newAsm()
	Test(a, Reg(RCX, SZ64), Imm(0x7FFFFFFF))
	if !emitsExactly(a, "48 f7 c1 ff ff ff 7f") { return fail("test rcx, 0x7fffffff") }
	a = newAsm()
	Test(a, Reg(RCX, SZ8), Imm(255))
	if !emitsExactly(a, "f6 c1 ff") { return fail("test cl, 255") }
	a = newAsm()
	Test(a, Reg(RSI, SZ8), Imm(255))
	if !emitsExactly(a, "40 f6 c6 ff") { return fail("test sil, 255") }
	return ""
}

// An immediate that does not fit the operation width is rejected: an
// assembler error and no bytes.  For a 64-bit op, 0x80000000 would be
// sign-extended to a different value and 0x100000000 truncated.
func TestAluImmOutOfRangeRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("and rcx, 0x80000000 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm64(0x100000000))
	if !rejected(a) { return fail("and rcx, 0x100000000 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ64), Imm64(-2147483647 - 2))
	if !rejected(a) { return fail("and rcx, -2^31-1 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ32), Imm64(0x100000000))
	if !rejected(a) { return fail("and ecx, 0x100000000 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ32), Imm64(-2147483647 - 2))
	if !rejected(a) { return fail("and ecx, -2^31-1 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(0x10000))
	if !rejected(a) { return fail("and cx, 0x10000 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ16), Imm(-32769))
	if !rejected(a) { return fail("and cx, -32769 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ8), Imm(256))
	if !rejected(a) { return fail("and cl, 256 must be rejected") }
	a = newAsm()
	And(a, Reg(RCX, SZ8), Imm(-129))
	if !rejected(a) { return fail("and cl, -129 must be rejected") }
	a = newAsm()
	Add(a, Mem(RAX, 8, SZ16), Imm(0x10000))
	if !rejected(a) { return fail("add word ptr [rax+8], 0x10000 must be rejected") }
	// Every ALU wrapper shares the check.
	a = newAsm()
	Add(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("add rcx, 0x80000000 must be rejected") }
	a = newAsm()
	Or(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("or rcx, 0x80000000 must be rejected") }
	a = newAsm()
	Sub(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("sub rcx, 0x80000000 must be rejected") }
	a = newAsm()
	Xor(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("xor rcx, 0x80000000 must be rejected") }
	a = newAsm()
	Cmp(a, Mem(RAX, 0, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("cmp qword ptr [rax], 0x80000000 must be rejected") }
	return ""
}

func TestTestImmOutOfRangeRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !rejected(a) { return fail("test rcx, 0x80000000 must be rejected") }
	a = newAsm()
	Test(a, Reg(RCX, SZ32), Imm64(0x100000000))
	if !rejected(a) { return fail("test ecx, 0x100000000 must be rejected") }
	a = newAsm()
	Test(a, Mem(RAX, 0, SZ16), Imm(0x10000))
	if !rejected(a) { return fail("test word ptr [rax], 0x10000 must be rejected") }
	a = newAsm()
	Test(a, Reg(RCX, SZ8), Imm(256))
	if !rejected(a) { return fail("test cl, 256 must be rejected") }
	return ""
}

// hostIntHolds reports whether v survives a round trip through the host
// `int` (Imul3's immediate type).  A 32-bit host cannot even pass a value
// outside int32, so cases built on such values apply only to 64-bit hosts.
func hostIntHolds(v int64) bool { return cast(int64, cast(int, v)) == v }

func TestImul3ImmWidths() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Imul3(a, Reg(RCX, SZ16), Reg(RDX, SZ16), 0x1234)
	if !emitsExactly(a, "66 69 ca 34 12") { return fail("imul cx, dx, 0x1234") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ16), Reg(RDX, SZ16), 0xFFFF)
	if !emitsExactly(a, "66 6b ca ff") { return fail("imul cx, dx, 0xffff") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ16), Mem(RAX, 8, SZ16), 0xFFFF)
	if !emitsExactly(a, "66 6b 48 08 ff") { return fail("imul cx, word ptr [rax+8], 0xffff") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), Reg(RDX, SZ64), 0x7FFFFFFF)
	if !emitsExactly(a, "48 69 ca ff ff ff 7f") { return fail("imul rcx, rdx, 0x7fffffff") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), Reg(RDX, SZ64), -2147483647 - 1)
	if !emitsExactly(a, "48 69 ca 00 00 00 80") { return fail("imul rcx, rdx, -0x80000000") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), Reg(RDX, SZ64), -2)
	if !emitsExactly(a, "48 6b ca fe") { return fail("imul rcx, rdx, -2") }
	var v32 int64 = 0xFFFFFFF0
	if hostIntHolds(v32) {
		a = newAsm()
		Imul3(a, Reg(RCX, SZ32), Reg(RDX, SZ32), cast(int, v32))
		if !emitsExactly(a, "6b ca f0") { return fail("imul ecx, edx, 0xfffffff0") }
	}
	return ""
}

func TestImul3ImmOutOfRangeRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Imul3(a, Reg(RCX, SZ16), Reg(RDX, SZ16), 0x10000)
	if !rejected(a) { return fail("imul cx, dx, 0x10000 must be rejected") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ16), Reg(RDX, SZ16), -32769)
	if !rejected(a) { return fail("imul cx, dx, -32769 must be rejected") }
	// IMUL r, r/m, imm has no 8-bit form.
	a = newAsm()
	Imul3(a, Reg(RCX, SZ8), Reg(RDX, SZ8), 3)
	if !rejected(a) { return fail("imul cl, dl, 3 must be rejected (no 8-bit form)") }
	var v64 int64 = 0x80000000
	if hostIntHolds(v64) {
		a = newAsm()
		Imul3(a, Reg(RCX, SZ64), Reg(RDX, SZ64), cast(int, v64))
		if !rejected(a) { return fail("imul rcx, rdx, 0x80000000 must be rejected") }
	}
	var v32 int64 = 0x100000000
	if hostIntHolds(v32) {
		a = newAsm()
		Imul3(a, Reg(RCX, SZ32), Reg(RDX, SZ32), cast(int, v32))
		if !rejected(a) { return fail("imul ecx, edx, 0x100000000 must be rejected") }
	}
	return ""
}
