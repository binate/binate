package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_arith.bn — ALU (Add/Sub/Or/And/Xor/Cmp/Test),
// unary ops (Inc/Dec/Neg/Not), shifts (Shl/Shr/Sar), and
// multiply/divide (Imul2/Imul3/Idiv/Div/Cqo/Cdq).
// Data-movement encoders (MOV/LEA/PUSH/POP/SETcc/MOVZX/MOVSX/
// MOVSXD/LeaRipLabel) are tested in x64_data_test.bn alongside
// their production-code split in x64_data.bn.

// --- ADD tests ---

func TestAddRegReg64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, RCX = REX.W 01 C8
	Add(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0x01
	expected[2] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, RCX encoding wrong")
	}
	return ""
}

func TestAddRegImm8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, 1 = REX.W 83 C0 01 (sign-extended imm8)
	Add(a, Reg(RAX, SZ64), Imm(1))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x83
	expected[2] = 0xC0
	expected[3] = 0x01
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, 1 encoding wrong")
	}
	return ""
}

func TestAddRegImm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD RAX, 256 = REX.W 81 C0 00010000
	Add(a, Reg(RAX, SZ64), Imm(256))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48
	expected[1] = 0x81
	expected[2] = 0xC0
	expected[3] = 0x00
	expected[4] = 0x01
	expected[5] = 0x00
	expected[6] = 0x00
	if !checkBytes(s, 0, expected) {
		return fail("ADD RAX, 256 encoding wrong")
	}
	return ""
}

// --- SUB / XOR / CMP ---

func TestSubRegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SUB EAX, ECX = 29 C8
	Sub(a, Reg(RAX, SZ32), Reg(RCX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x29
	expected[1] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("SUB EAX, ECX encoding wrong")
	}
	return ""
}

func TestXorRegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// XOR EAX, EAX = 31 C0 (common zero-register idiom)
	Xor(a, Reg(RAX, SZ32), Reg(RAX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x31
	expected[1] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("XOR EAX, EAX encoding wrong")
	}
	return ""
}

func TestCmpRegImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CMP RAX, 0 = REX.W 83 F8 00
	Cmp(a, Reg(RAX, SZ64), Imm(0))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x83
	expected[2] = 0xF8
	expected[3] = 0x00
	if !checkBytes(s, 0, expected) {
		return fail("CMP RAX, 0 encoding wrong")
	}
	return ""
}

// --- Unary ops ---

func TestIncReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// INC RAX = REX.W FF C0
	Inc(a, Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0xFF
	expected[2] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("INC RAX encoding wrong")
	}
	return ""
}

func TestNegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// NEG EAX = F7 D8 (no REX for 32-bit)
	Neg(a, Reg(RAX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0xF7
	expected[1] = 0xD8
	if !checkBytes(s, 0, expected) {
		return fail("NEG EAX encoding wrong")
	}
	return ""
}

// --- Shift ---

func TestShlImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SHL RAX, 4 = REX.W C1 E0 04
	Shl(a, Reg(RAX, SZ64), Imm(4))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0xC1
	expected[2] = 0xE0
	expected[3] = 0x04
	if !checkBytes(s, 0, expected) {
		return fail("SHL RAX, 4 encoding wrong")
	}
	return ""
}

// --- IMUL ---

func TestImul2() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// IMUL RAX, RCX = REX.W 0F AF C1
	Imul2(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x0F
	expected[2] = 0xAF
	expected[3] = 0xC1
	if !checkBytes(s, 0, expected) {
		return fail("IMUL RAX, RCX encoding wrong")
	}
	return ""
}

func TestImul3() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// IMUL RAX, RCX, 10 = REX.W 6B C1 0A
	Imul3(a, Reg(RAX, SZ64), Reg(RCX, SZ64), 10)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x6B
	expected[2] = 0xC1
	expected[3] = 0x0A
	if !checkBytes(s, 0, expected) {
		return fail("IMUL RAX, RCX, 10 encoding wrong")
	}
	return ""
}

// --- CQO / CDQ ---

func TestCqo() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CQO = 48 99
	Cqo(a)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x48
	expected[1] = 0x99
	if !checkBytes(s, 0, expected) {
		return fail("CQO encoding wrong")
	}
	return ""
}

// --- Byte-register REX hazard (ALU / TEST) ---
// Like the MOV case (x64_data_test.bn), an 8-bit ALU or TEST op whose
// byte-accessed register operand is RSP/RBP/RSI/RDI (codes 4-7) MUST
// carry a REX prefix so its low byte, not AH/CH/DH/BH, is used.  The
// backend reaches this via SZ8 And/Or on scratch registers when folding
// a boolean into a byte result.

// AND SIL, AL: SIL (RSI=6) is the byte destination (r/m) — 40 20 C6.
func TestAndByteSilForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RSI, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → SIL, not DH
	expected[1] = 0x20 // AND r/m8, r8 (byte form = 0x21-1)
	expected[2] = 0xC6 // mod=11 reg=000(AL) rm=110(SIL)
	if !checkBytes(s, 0, expected) {
		return fail("AND SIL, AL must force REX (else DH)")
	}
	return ""
}

// TEST DIL, AL: DIL (RDI=7) is a byte operand — 40 84 C7.
func TestTestByteDilForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RDI, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → DIL, not BH
	expected[1] = 0x84 // TEST r/m8, r8
	expected[2] = 0xC7 // mod=11 reg=000(AL) rm=111(DIL)
	if !checkBytes(s, 0, expected) {
		return fail("TEST DIL, AL must force REX (else BH)")
	}
	return ""
}

// NEG BPL: BPL (RBP=5) is the byte operand of a unary op — 40 F6 DD.
func TestNegByteBplForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Neg(a, Reg(RBP, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x40 // forced REX → BPL, not CH
	expected[1] = 0xF6 // F6 /3 (byte NEG)
	expected[2] = 0xDD // mod=11 reg=011(/3) rm=101(BPL)
	if !checkBytes(s, 0, expected) {
		return fail("NEG BPL must force REX (else CH)")
	}
	return ""
}

// AND CL, AL: neither operand is a byte-hazard register (RCX=1, RAX=0),
// so NO REX is emitted — a negative control the force must not trip.
func TestAndByteNoHazardNoRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ8), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x20 // AND r/m8, r8 — no REX
	expected[1] = 0xC1 // mod=11 reg=000(AL) rm=001(CL)
	if !checkBytes(s, 0, expected) {
		return fail("AND CL, AL must NOT force REX")
	}
	return ""
}
