package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- Atomic read-modify-write instructions ---
// XADD r/m, r: 0F C0 (byte) / 0F C1; CMPXCHG r/m, r: 0F B0 (byte) / 0F B1 — the register in
// ModR/M's reg field.  CMPXCHG8B m64: 0F C7 /1; CMPXCHG16B m128: REX.W 0F C7 /1.  Atomic with a
// lock prefix (Lock before them, or LockNext to have it after a 0x66).

// Xadd emits `xadd dst, src`; see x64.bni.
func Xadd(a @asm.Assembler, dst Operand, src Operand) { emitRMReg0F(a, "xadd", dst, src, 0xC0) }

// Cmpxchg emits `cmpxchg dst, src`; see x64.bni.
func Cmpxchg(a @asm.Assembler, dst Operand, src Operand) {
	emitRMReg0F(a, "cmpxchg", dst, src, 0xB0)
}

// emitRMReg0F emits the two-byte-opcode mnem, 0F op8 for bytes or 0F op8+1 for words, dwords and
// qwords: dst a register or memory operand, src a register of its size (in ModR/M's reg field).
// Anything else sets an assembler error and emits nothing.
func emitRMReg0F(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand, op8 int) {
	if !isRM(dst) || src.Kind != OP_REG {
		setKindsError(a, mnem)
		return
	}
	var size int = opSize(a, mnem, dst, src)
	if size == 0 { return }
	emitSizePrefix(a, size)
	var f8 bool = size == SZ8 &&
			(byteRegHazard(src.Reg) || (dst.Kind == OP_REG && byteRegHazard(dst.Reg)))
	emitRexRM(a, rexW(size), src.Reg, dst, f8)
	emit8(a, 0x0F)
	if size == SZ8 {
		emit8(a, op8)
	} else {
		emit8(a, op8 + 1)
	}
	emitModRM(a, src.Reg, dst)
}

// Cmpxchg8b emits `cmpxchg8b mem` (0F C7 /1); see x64.bni.
func Cmpxchg8b(a @asm.Assembler, mem Operand) { emitCmpxchgWide(a, "cmpxchg8b", mem, SZ64) }

// Cmpxchg16b emits `cmpxchg16b mem` (REX.W 0F C7 /1); see x64.bni.
func Cmpxchg16b(a @asm.Assembler, mem Operand) { emitCmpxchgWide(a, "cmpxchg16b", mem, SZ128) }

// emitCmpxchgWide emits CMPXCHG8B (size SZ64) or CMPXCHG16B (size SZ128, with REX.W) of the memory
// operand mem, unsized or of that size.  Anything else sets an assembler error and emits nothing.
func emitCmpxchgWide(a @asm.Assembler, mnem *[]readonly char, mem Operand, size int) {
	if !isMem(mem) {
		setOperandError(a, mnem, "the operand is memory")
		return
	}
	if mem.Size != 0 && mem.Size != size {
		setOperandError(a, mnem, "invalid operand size")
		return
	}
	emitSizePrefix(a, size) // (no 0x66 at these sizes: a lock prefix, LockNext's)
	emitRexRM(a, size == SZ128, 0, mem, false)
	emit8(a, 0x0F)
	emit8(a, 0xC7)
	emitModRM(a, 1, mem)
}
