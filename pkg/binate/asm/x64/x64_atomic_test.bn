package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The atomic read-modify-write instructions and the lock prefixes (x64_atomic.bn, x64_prefix.bn)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, Intel syntax).  (aluCase is in
// x64_acc_test.bn, ripFixupAt in x64_rip_imm_test.bn.)

// XADD 0F C0 / C1 and CMPXCHG 0F B0 / B1, the register in the reg field, at each width, to a
// register or memory.
func TestXaddCmpxchg() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Xadd(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "xadd rax, rbx", "48 0f c1 d8")
	a = newAsm()
	Xadd(a, Mem(RBX, 0, SZ32), Reg(RAX, SZ32))
	e = aluCase(e, a, "xadd [rbx], eax", "0f c1 03")
	a = newAsm()
	Xadd(a, Mem(RBX, 0, SZ8), Reg(RCX, SZ8))
	e = aluCase(e, a, "xadd byte ptr [rbx], cl", "0f c0 0b")
	a = newAsm()
	Xadd(a, Reg(RAX, SZ16), Reg(RBX, SZ16))
	e = aluCase(e, a, "xadd ax, bx", "66 0f c1 d8")
	a = newAsm()
	Xadd(a, Reg(R8, SZ64), Reg(R9, SZ64))
	e = aluCase(e, a, "xadd r8, r9", "4d 0f c1 c8")
	a = newAsm()
	Cmpxchg(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "cmpxchg rax, rbx", "48 0f b1 d8")
	a = newAsm()
	Cmpxchg(a, Mem(RBX, 0, SZ32), Reg(RCX, SZ32))
	e = aluCase(e, a, "cmpxchg [rbx], ecx", "0f b1 0b")
	a = newAsm()
	Cmpxchg(a, Mem(RBX, 0, SZ8), Reg(RDX, SZ8))
	e = aluCase(e, a, "cmpxchg byte ptr [rbx], dl", "0f b0 13")
	a = newAsm()
	Cmpxchg(a, Reg(RCX, SZ16), Reg(RDX, SZ16))
	e = aluCase(e, a, "cmpxchg cx, dx", "66 0f b1 d1")
	return e
}

// CMPXCHG8B 0F C7 /1 and CMPXCHG16B REX.W 0F C7 /1, unsized or of their size; R8 as the base with
// REX.B; a `[rip + x]` operand with its fixup.  The prefixes: LOCK F0, XACQUIRE F2, XRELEASE F3.
func TestCmpxchgWideAndPrefixes() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Cmpxchg8b(a, Mem(RBX, 0, 0))
	e = aluCase(e, a, "cmpxchg8b [rbx]", "0f c7 0b")
	a = newAsm()
	Cmpxchg8b(a, Mem(RBX, 0, SZ64))
	e = aluCase(e, a, "cmpxchg8b qword ptr [rbx]", "0f c7 0b")
	a = newAsm()
	Cmpxchg8b(a, Mem(R8, 0, 0))
	e = aluCase(e, a, "cmpxchg8b [r8]", "41 0f c7 08")
	a = newAsm()
	Cmpxchg16b(a, Mem(RBX, 0, 0))
	e = aluCase(e, a, "cmpxchg16b [rbx]", "48 0f c7 0b")
	a = newAsm()
	Cmpxchg16b(a, Mem(RBX, 0, SZ128))
	e = aluCase(e, a, "cmpxchg16b xmmword ptr [rbx]", "48 0f c7 0b")
	a = newAsm()
	Cmpxchg16b(a, RipLabel("x"))
	if !emitsExactly(a, "48 0f c7 0d 00 00 00 00") || !ripFixupAt(a, 4, 0) {
		return fail("cmpxchg16b [rip + x]")
	}
	a = newAsm()
	Lock(a)
	Xacquire(a)
	Xrelease(a)
	e = aluCase(e, a, "lock / xacquire / xrelease", "f0 f2 f3")
	return e
}

// An encoder that takes no lock prefix after LockNext is an error and writes nothing: the
// assembly fails rather than lock a later instruction.
func TestLockNextNoLockPrefix() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LockNext(a)
	Setcc(a, CC_E, Mem(RBX, 0, SZ8))
	if !rejected(a) { return "LockNext, sete byte ptr [rbx]: not rejected" }
	Add(a, Mem(RBX, 0, SZ32), Reg(RAX, SZ32))
	if !a.HasError || !msgHasPrefix(a.ErrorMsg, "x64: the instruction after LockNext takes no lock") {
		return "LockNext, sete byte ptr [rbx], add [rbx], eax: no error, or another"
	}
	a = newAsm()
	LockNext(a)
	Bswap(a, Reg(RAX, SZ64))
	if !rejected(a) { return "LockNext, bswap rax: not rejected" }
	return ""
}

// LockNext's 0xF0 comes after the instruction's 0x66, before REX, as clang's (`lock xadd word ptr
// [rbx], ax` 66 F0 0F C1 03), and goes with the next instruction only.
func TestLockNext() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	LockNext(a)
	Xadd(a, Mem(RBX, 0, SZ16), Reg(RAX, SZ16))
	e = aluCase(e, a, "lock xadd word ptr [rbx], ax", "66 f0 0f c1 03")
	a = newAsm()
	LockNext(a)
	Cmpxchg16b(a, Mem(RBX, 0, 0))
	Inc(a, Mem(RBX, 0, SZ64))
	e = aluCase(e, a, "lock cmpxchg16b [rbx]; inc qword ptr [rbx]", "f0 48 0f c7 0b 48 ff 03")
	a = newAsm()
	LockNext(a)
	Add(a, Mem(RBX, 0, SZ64), Imm(1))
	e = aluCase(e, a, "lock add qword ptr [rbx], 1", "f0 48 83 03 01")
	return e
}

// A register for CMPXCHG8B / 16B, the other's size, an immediate or a second memory operand for
// XADD / CMPXCHG, and registers of two sizes are errors, with nothing emitted.
func TestAtomicRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cmpxchg8b(a, Reg(RAX, SZ64))
	if !rejected(a) { return fail("cmpxchg8b rax") }
	a = newAsm()
	Cmpxchg8b(a, Mem(RBX, 0, SZ128))
	if !rejected(a) { return fail("cmpxchg8b xmmword ptr [rbx]") }
	a = newAsm()
	Cmpxchg16b(a, Mem(RBX, 0, SZ64))
	if !rejected(a) { return fail("cmpxchg16b qword ptr [rbx]") }
	a = newAsm()
	Xadd(a, Reg(RAX, SZ64), Imm(5))
	if !rejected(a) { return fail("xadd rax, 5") }
	a = newAsm()
	Xadd(a, Reg(RAX, SZ64), Reg(RBX, SZ32))
	if !rejected(a) { return fail("xadd rax, ebx") }
	a = newAsm()
	Cmpxchg(a, Mem(RBX, 0, SZ64), Mem(RCX, 0, SZ64))
	if !rejected(a) { return fail("cmpxchg [rbx], [rcx]") }
	return ""
}
