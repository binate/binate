package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- Bit instructions ---
// BT / BTS / BTR / BTC r/m, reg: 0F A3 / AB / B3 / BB /r; r/m, imm8: 0F BA /4 / /5 / /6 / /7 ib.
// BSF / BSR r, r/m: 0F BC / BD /r; LZCNT / TZCNT / POPCNT r, r/m: F3 0F BD / BC / B8 /r (the F3
// after an operand-size prefix, before REX).  BSWAP r32 / r64: 0F C8+r.  None has an 8-bit form.

// Bt emits `bt dst, src`; see x64.bni.
func Bt(a @asm.Assembler, dst Operand, src Operand) { emitBitTest(a, "bt", dst, src, 0xA3, 4) }

// Bts emits `bts dst, src`; see x64.bni.
func Bts(a @asm.Assembler, dst Operand, src Operand) { emitBitTest(a, "bts", dst, src, 0xAB, 5) }

// Btr emits `btr dst, src`; see x64.bni.
func Btr(a @asm.Assembler, dst Operand, src Operand) { emitBitTest(a, "btr", dst, src, 0xB3, 6) }

// Btc emits `btc dst, src`; see x64.bni.
func Btc(a @asm.Assembler, dst Operand, src Operand) { emitBitTest(a, "btc", dst, src, 0xBB, 7) }

// emitBitTest emits the bit test mnem: dst a 16-, 32- or 64-bit register or memory operand, and
// src a register of its size (0F op /r, the register in ModR/M's reg field) or an imm8 in
// -128..255 (0F BA /ext ib).  Anything else sets an assembler error and emits nothing.
func emitBitTest(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand, op int,
		ext int) {
	if !isRM(dst) || (src.Kind != OP_REG && src.Kind != OP_IMM) {
		setKindsError(a, mnem)
		return
	}
	if src.Kind == OP_IMM && isImmSym(src) {
		setOperandError(a, mnem, "a bit offset is a number, not a symbol")
		return
	}
	if src.Kind == OP_IMM && !immFits(src.Imm, SZ8) {
		setImm8RangeError(a, mnem, "bit offset")
		return
	}
	var size int = opSize(a, mnem, dst, src)
	if size == 0 { return }
	if size == SZ8 {
		setOperandError(a, mnem, "there is no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	if src.Kind == OP_REG {
		emitRexRM(a, rexW(size), src.Reg, dst, false)
		emit8(a, 0x0F)
		emit8(a, op)
		emitModRM(a, src.Reg, dst)
		return
	}
	emitRexRM(a, rexW(size), 0, dst, false)
	emit8(a, 0x0F)
	emit8(a, 0xBA)
	emitModRMImm(a, ext, dst, 1)
	emit8(a, cast(int, src.Imm))
}

// Bsf emits `bsf dst, src` (0F BC); see x64.bni.
func Bsf(a @asm.Assembler, dst Operand, src Operand) {
	emitBitScan(a, "bsf", dst, src, false, 0xBC)
}

// Bsr emits `bsr dst, src` (0F BD); see x64.bni.
func Bsr(a @asm.Assembler, dst Operand, src Operand) {
	emitBitScan(a, "bsr", dst, src, false, 0xBD)
}

// Lzcnt emits `lzcnt dst, src` (F3 0F BD); see x64.bni.
func Lzcnt(a @asm.Assembler, dst Operand, src Operand) {
	emitBitScan(a, "lzcnt", dst, src, true, 0xBD)
}

// Tzcnt emits `tzcnt dst, src` (F3 0F BC); see x64.bni.
func Tzcnt(a @asm.Assembler, dst Operand, src Operand) {
	emitBitScan(a, "tzcnt", dst, src, true, 0xBC)
}

// Popcnt emits `popcnt dst, src` (F3 0F B8); see x64.bni.
func Popcnt(a @asm.Assembler, dst Operand, src Operand) {
	emitBitScan(a, "popcnt", dst, src, true, 0xB8)
}

// emitBitScan emits the bit scan or count mnem, 0F op /r — with an F3 prefix (rep) for LZCNT,
// TZCNT and POPCNT, after any operand-size prefix and before REX: dst a 16-, 32- or 64-bit
// register, src a register or memory operand of its size.  Anything else sets an assembler error
// and emits nothing.
func emitBitScan(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand, rep bool,
		op int) {
	if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, mnem)
		return
	}
	var size int = opSize(a, mnem, dst, src)
	if size == 0 { return }
	if size == SZ8 {
		setOperandError(a, mnem, "there is no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	if rep { emit8(a, 0xF3) }
	emitRexRM(a, rexW(size), dst.Reg, src, false)
	emit8(a, 0x0F)
	emit8(a, op)
	emitModRM(a, dst.Reg, src)
}

// Bswap emits `bswap dst` (0F C8+r); see x64.bni.
func Bswap(a @asm.Assembler, dst Operand) {
	if dst.Kind != OP_REG || (dst.Size != SZ32 && dst.Size != SZ64) {
		setOperandError(a, "bswap", "the operand is a 32- or 64-bit register")
		return
	}
	emitRex(a, rexW(dst.Size), 0, 0, dst.Reg)
	emit8(a, 0x0F)
	emit8(a, 0xC8 + regLo3(dst.Reg))
}
