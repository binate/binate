package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The bit instructions (x64_bits.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// Intel syntax).  (aluCase is in x64_acc_test.bn, ripFixupAt in x64_rip_imm_test.bn.)

// BT / BTS / BTR / BTC with a register (0F A3 / AB / B3 / BB, the register in the reg field) or
// an imm8 (0F BA /4 .. /7, -1 being 255), at 16, 32 and 64 bits, to a register or memory.
func TestBitTests() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Bt(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "bt rax, rbx", "48 0f a3 d8")
	a = newAsm()
	Bt(a, Reg(RAX, SZ32), Reg(RBX, SZ32))
	e = aluCase(e, a, "bt eax, ebx", "0f a3 d8")
	a = newAsm()
	Bt(a, Reg(RAX, SZ16), Reg(RBX, SZ16))
	e = aluCase(e, a, "bt ax, bx", "66 0f a3 d8")
	a = newAsm()
	Bt(a, Mem(RBX, 0, SZ64), Reg(RAX, SZ64))
	e = aluCase(e, a, "bt qword ptr [rbx], rax", "48 0f a3 03")
	a = newAsm()
	Bt(a, Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "bt rax, 3", "48 0f ba e0 03")
	a = newAsm()
	Bt(a, Reg(RAX, SZ32), Imm(31))
	e = aluCase(e, a, "bt eax, 31", "0f ba e0 1f")
	a = newAsm()
	Bt(a, Reg(RAX, SZ16), Imm(15))
	e = aluCase(e, a, "bt ax, 15", "66 0f ba e0 0f")
	a = newAsm()
	Bt(a, Mem(RBX, 0, SZ64), Imm(70))
	e = aluCase(e, a, "bt qword ptr [rbx], 70", "48 0f ba 23 46")
	a = newAsm()
	Bt(a, Reg(RAX, SZ64), Imm(-1))
	e = aluCase(e, a, "bt rax, -1", "48 0f ba e0 ff")
	a = newAsm()
	Bts(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "bts rax, rbx", "48 0f ab d8")
	a = newAsm()
	Bts(a, Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "bts rax, 3", "48 0f ba e8 03")
	a = newAsm()
	Btr(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "btr rax, rbx", "48 0f b3 d8")
	a = newAsm()
	Btr(a, Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "btr rax, 3", "48 0f ba f0 03")
	a = newAsm()
	Btc(a, Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "btc rax, 3", "48 0f ba f8 03")
	a = newAsm()
	Btc(a, Mem(RBX, 0, SZ32), Reg(RCX, SZ32))
	e = aluCase(e, a, "btc dword ptr [rbx], ecx", "0f bb 0b")
	a = newAsm()
	Btc(a, Reg(R8, SZ64), Reg(R9, SZ64))
	e = aluCase(e, a, "btc r8, r9", "4d 0f bb c8")
	a = newAsm()
	var m Operand = RipLabel("x")
	m.Size = SZ64
	Bt(a, m, Imm(3))
	if !emitsExactly(a, "48 0f ba 25 00 00 00 00 03") || !ripFixupAt(a, 4, -1) {
		return fail("bt qword ptr [rip + x], 3")
	}
	return e
}

// BSF / BSR (0F BC / BD) and LZCNT / TZCNT / POPCNT (F3 0F BD / BC / B8: the F3 after 66, before
// REX), a register from a register or memory, at 16, 32 and 64 bits.
func TestBitScans() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Bsf(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "bsf rax, rbx", "48 0f bc c3")
	a = newAsm()
	Bsr(a, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	e = aluCase(e, a, "bsr eax, [rbx]", "0f bd 03")
	a = newAsm()
	Bsf(a, Reg(RAX, SZ16), Reg(RBX, SZ16))
	e = aluCase(e, a, "bsf ax, bx", "66 0f bc c3")
	a = newAsm()
	Bsr(a, Reg(R8, SZ64), Reg(R9, SZ64))
	e = aluCase(e, a, "bsr r8, r9", "4d 0f bd c1")
	a = newAsm()
	Lzcnt(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "lzcnt rax, rbx", "f3 48 0f bd c3")
	a = newAsm()
	Lzcnt(a, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	e = aluCase(e, a, "lzcnt eax, [rbx]", "f3 0f bd 03")
	a = newAsm()
	Lzcnt(a, Reg(RAX, SZ16), Reg(RBX, SZ16))
	e = aluCase(e, a, "lzcnt ax, bx", "66 f3 0f bd c3")
	a = newAsm()
	Tzcnt(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "tzcnt rax, rbx", "f3 48 0f bc c3")
	a = newAsm()
	Tzcnt(a, Reg(R8, SZ32), Reg(R9, SZ32))
	e = aluCase(e, a, "tzcnt r8d, r9d", "f3 45 0f bc c1")
	a = newAsm()
	Popcnt(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	e = aluCase(e, a, "popcnt rax, rbx", "f3 48 0f b8 c3")
	a = newAsm()
	Popcnt(a, Reg(RAX, SZ16), Mem(RBX, 0, SZ16))
	e = aluCase(e, a, "popcnt ax, word ptr [rbx]", "66 f3 0f b8 03")
	return e
}

// BSWAP: 0F C8+r, REX.W for 64 bits, REX.B for R8-R15.
func TestBswap() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Bswap(a, Reg(RAX, SZ32))
	e = aluCase(e, a, "bswap eax", "0f c8")
	a = newAsm()
	Bswap(a, Reg(RAX, SZ64))
	e = aluCase(e, a, "bswap rax", "48 0f c8")
	a = newAsm()
	Bswap(a, Reg(R8, SZ64))
	e = aluCase(e, a, "bswap r8", "49 0f c8")
	a = newAsm()
	Bswap(a, Reg(R8, SZ32))
	e = aluCase(e, a, "bswap r8d", "41 0f c8")
	a = newAsm()
	Bswap(a, Reg(RDI, SZ32))
	e = aluCase(e, a, "bswap edi", "0f cf")
	return e
}

// No 8-bit form, an offset past an imm8 or a symbol as one, registers of two sizes, a memory
// destination for a scan, and a 16-bit or memory BSWAP are errors, with nothing emitted.
func TestBitRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bt(a, Reg(RAX, SZ8), Reg(RBX, SZ8))
	if !rejected(a) { return fail("bt al, bl") }
	a = newAsm()
	Bt(a, Reg(RAX, SZ64), Imm(256))
	if !rejected(a) { return fail("bt rax, 256") }
	a = newAsm()
	Bts(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	if !rejected(a) { return fail("bts rax, offset x") }
	a = newAsm()
	Btr(a, Reg(RAX, SZ64), Reg(RCX, SZ8))
	if !rejected(a) { return fail("btr rax, cl") }
	a = newAsm()
	Bsf(a, Reg(RAX, SZ8), Reg(RBX, SZ8))
	if !rejected(a) { return fail("bsf al, bl") }
	a = newAsm()
	Popcnt(a, Mem(RBX, 0, SZ64), Reg(RAX, SZ64))
	if !rejected(a) { return fail("popcnt [rbx], rax") }
	a = newAsm()
	Lzcnt(a, Reg(RAX, SZ64), Reg(RBX, SZ32))
	if !rejected(a) { return fail("lzcnt rax, ebx") }
	a = newAsm()
	Bswap(a, Reg(RAX, SZ16))
	if !rejected(a) { return fail("bswap ax") }
	a = newAsm()
	Bswap(a, Mem(RBX, 0, SZ64))
	if !rejected(a) { return fail("bswap [rbx]") }
	return ""
}
