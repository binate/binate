package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- Branches ---

// JMP rel32: E9 cd (near jump, 32-bit displacement)
func Jmp(a @asm.Assembler, label *[]readonly char) { JmpAddend(a, label, 0) }

// JmpAddend emits JMP rel32 to label + addend.
func JmpAddend(a @asm.Assembler, label *[]readonly char, addend int64) {
	emit8(a, 0xE9)
	a.AddFixup(label, FIX_REL32, addend, 4)
	emit32le(a, 0) // placeholder
}

// JMP r/m64: FF /4
func JmpReg(a @asm.Assembler, reg int) {
	if regHi(reg) != 0 {
		emit8(a, 0x41) // REX.B
	}
	emit8(a, 0xFF)
	emit8(a, 0xE0 + regLo3(reg)) // mod=11, /4, rm=reg
}

// Jcc rel32: 0F 80+cc cd (conditional near jump).  cc is a CC_* condition
// (0..15); any other value sets an assembler error and emits nothing.
func Jcc(a @asm.Assembler, cc int, label *[]readonly char) { JccAddend(a, cc, label, 0) }

// JccAddend emits Jcc rel32 to label + addend (cc as for Jcc).
func JccAddend(a @asm.Assembler, cc int, label *[]readonly char, addend int64) {
	if !condOK(a, "jcc", cc) { return }
	emit8(a, 0x0F)
	emit8(a, 0x80 + cc)
	a.AddFixup(label, FIX_REL32, addend, 4)
	emit32le(a, 0) // placeholder
}

// CALL rel32: E8 cd
func Call(a @asm.Assembler, label *[]readonly char) { CallAddend(a, label, 0) }

// CallAddend emits CALL rel32 to label + addend.
func CallAddend(a @asm.Assembler, label *[]readonly char, addend int64) {
	emit8(a, 0xE8)
	a.AddFixup(label, FIX_REL32, addend, 4)
	emit32le(a, 0) // placeholder
}

// CALL r/m64: FF /2
func CallReg(a @asm.Assembler, reg int) {
	if regHi(reg) != 0 {
		emit8(a, 0x41) // REX.B
	}
	emit8(a, 0xFF)
	emit8(a, 0xD0 + regLo3(reg)) // mod=11, /2, rm=reg
}

// CallMem emits CALL r/m64 (FF /2) through memory operand mem; see x64.bni.
func CallMem(a @asm.Assembler, mem Operand) {
	if mem.Kind == OP_MEM && mem.Fix == FIX_TLSCALL {
		callTlsDesc(a, mem)
		return
	}
	jumpMem(a, "call", 2, mem)
}

// JmpMem emits JMP r/m64 (FF /4) through memory operand mem; see x64.bni.
func JmpMem(a @asm.Assembler, mem Operand) { jumpMem(a, "jmp", 4, mem) }

// jumpMem emits FF /ext (CALL's /2, JMP's /4) through memory operand mem, 64-bit or unsized,
// for instruction mnem.
func jumpMem(a @asm.Assembler, mnem *[]readonly char, ext int, mem Operand) {
	if !isMem(mem) {
		setKindsError(a, mnem)
		return
	}
	if mem.Size != 0 && mem.Size != SZ64 {
		setOperandError(a, mnem, "an indirect call or jump reads a 64-bit address")
		return
	}
	if mem.Kind == OP_RIPLABEL && mem.Fix != 0 {
		setOperandError(a, mnem, "no call or jump goes through a thread-local slot or descriptor")
		return
	}
	if mem.Kind == OP_MEM && !memOperandOk(a, mem) { return }
	emitRexRM(a, false, 0, mem, false)
	emit8(a, 0xFF)
	emitModRM(a, ext, mem)
}

// callTlsDesc emits the TLS descriptor call `call qword ptr [rax + sym@tlscall]` (FF 10), its
// FIX_TLSCALL fixup at its first byte, for the MemSym mem of that kind; see CallMem.
func callTlsDesc(a @asm.Assembler, mem Operand) {
	if mem.Base != RAX || mem.Index >= 0 || mem.Disp != 0 || len(mem.Label) == 0 ||
			(mem.Size != 0 && mem.Size != SZ64) {
		setOperandError(a, "call", "a TLS descriptor call is call qword ptr [rax + sym@tlscall]")
		return
	}
	a.AddFixup(mem.Label, FIX_TLSCALL, 0, 2)
	emit8(a, 0xFF)
	emit8(a, 0x10) // mod=00, /2, rm=RAX
}

// RET: C3
func Ret(a @asm.Assembler) {
	emit8(a, 0xC3)
}

// RetImm emits `ret imm16` (C2 iw): return, then release imm bytes of stack.  imm is a
// 16-bit immediate, -32768..65535 (a negative value is its two's-complement word, as clang
// reads `ret -1`); any other sets an assembler error and emits nothing.  (clang keeps the
// low 16 bits of a wider value; `ret 65536` is `ret 0` there.)
func RetImm(a @asm.Assembler, imm int) {
	if !immFits(cast(int64, imm), SZ16) {
		a.SetError("x64: ret immediate out of range (an imm16 accepts -32768..65535)")
		return
	}
	emit8(a, 0xC2)
	emit16le(a, imm)
}
