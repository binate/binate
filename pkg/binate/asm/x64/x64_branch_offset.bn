package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// Jumps to an already-known target: offset is the byte distance from the start of the
// jump instruction to its target (negative for a backward jump).  The displacement is
// encoded on the spot — in the 2-byte rel8 form when it fits a signed byte, else in the
// rel32 form — so, unlike the label forms, no fixup is recorded and nothing is left for
// Finalize to resolve.  An offset beyond rel32's reach is reported on the assembler.

// rel8Fits reports whether a 2-byte rel8 jump at offset reaches its target.
func rel8Fits(offset int) bool {
	return fitsI8(offset - 2)
}

// rel32Fits reports whether a size-byte rel32 jump at offset reaches its target, and
// reports an error on the assembler when it does not.
func rel32Fits(a @asm.Assembler, mnem *[]readonly char, offset int, size int) bool {
	var disp int = offset - size
	if disp >= -2147483648 && disp <= 2147483647 { return true }
	setOperandError(a, mnem, "jump offset beyond rel32 reach")
	return false
}

// JmpOffset emits JMP to offset: EB rel8, or E9 rel32.
func JmpOffset(a @asm.Assembler, offset int) {
	if rel8Fits(offset) {
		emit8(a, 0xEB)
		emit8(a, offset - 2)
		return
	}
	if !rel32Fits(a, "jmp", offset, 5) { return }
	emit8(a, 0xE9)
	emit32le(a, offset - 5)
}

// JccOffset emits Jcc to offset: 70+cc rel8, or 0F 80+cc rel32.  cc is a CC_* condition
// (0..15); any other value sets an assembler error and emits nothing.
func JccOffset(a @asm.Assembler, cc int, offset int) {
	if !condOK(a, "jcc", cc) { return }
	if rel8Fits(offset) {
		emit8(a, 0x70 + cc)
		emit8(a, offset - 2)
		return
	}
	if !rel32Fits(a, "jcc", offset, 6) { return }
	emit8(a, 0x0F)
	emit8(a, 0x80 + cc)
	emit32le(a, offset - 6)
}
