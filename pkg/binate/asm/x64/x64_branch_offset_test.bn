package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Goldens (from clang) for the jumps to a resolved offset: rel8 when the displacement
// fits a signed byte, rel32 otherwise; none records a fixup.

func TestJumpOffsetGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	JmpOffset(a, -3)
	JccOffset(a, CC_NE, -5)
	JccOffset(a, CC_NS, 3)
	JmpOffset(a, -200)
	JccOffset(a, CC_NS, -205)
	JmpOffset(a, 305)
	JmpOffset(a, 129)
	JmpOffset(a, -126)
	// jmp -3; jne -5; jns +3; jmp -200 (rel32); jns -205 (rel32); jmp +305 (rel32);
	// jmp +129 and jmp -126, the farthest rel8 jumps each way.
	var want @[]int = hexBytes("ebfb75f97901e933ffffff0f892dffffffe92c010000eb7feb80")
	if a.HasError || a.Sections[0].NumFixups != 0 || a.Sections[0].Len != len(want) ||
			!checkBytes(a.Sections[0], 0, want) {
		return fail("offset jump encoding wrong")
	}
	return ""
}

// One byte past rel8's reach takes rel32; an out-of-range condition fails loud.
func TestJumpOffsetRel8Edges() testing.TestResult {
	var a @asm.Assembler = newAsm()
	JmpOffset(a, 130)
	JccOffset(a, CC_E, -127)
	var want @[]int = hexBytes("e97d0000000f847bffffff")
	if a.HasError || !checkBytes(a.Sections[0], 0, want) || a.Sections[0].Len != len(want) {
		return fail("a jump just past rel8 reach must take rel32")
	}
	var b @asm.Assembler = newAsm()
	JccOffset(b, 16, -4)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("Jcc with cc 16 should error") }
	return ""
}
