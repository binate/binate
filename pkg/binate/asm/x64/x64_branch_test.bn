package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// --- JMP ---

func TestJmpLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// JMP label = E9 + rel32 placeholder
	Jmp(a, "target")
	var s @asm.Section = a.Sections[0]
	if readByte(s, 0) != 0xE9 { return fail("JMP opcode wrong") }
	if s.Len != 5 { return fail("JMP length wrong") }
	return ""
}

func TestJmpReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// JMP RAX = FF E0
	JmpReg(a, RAX)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0xFF
	expected[1] = 0xE0
	if !checkBytes(s, 0, expected) {
		return fail("JMP RAX encoding wrong")
	}
	return ""
}

// --- Jcc ---

func TestJeLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// JE label = 0F 84 + rel32 placeholder
	Jcc(a, CC_E, "target")
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x0F
	expected[1] = 0x84
	if !checkBytes(s, 0, expected) {
		return fail("JE opcode wrong")
	}
	if s.Len != 6 { return fail("JE length wrong") }
	return ""
}

func TestJneLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// JNE label = 0F 85 + rel32
	Jcc(a, CC_NE, "target")
	if readByte(a.Sections[0], 1) != 0x85 {
		return fail("JNE cc byte wrong")
	}
	return ""
}

// --- CALL / RET ---

func TestCallLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CALL label = E8 + rel32
	Call(a, "target")
	if readByte(a.Sections[0], 0) != 0xE8 {
		return fail("CALL opcode wrong")
	}
	if a.Sections[0].Len != 5 {
		return fail("CALL length wrong")
	}
	return ""
}

func TestCallReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CALL RAX = FF D0
	CallReg(a, RAX)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0xFF
	expected[1] = 0xD0
	if !checkBytes(s, 0, expected) {
		return fail("CALL RAX encoding wrong")
	}
	return ""
}

func TestRet() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// RET = C3
	Ret(a)
	if readByte(a.Sections[0], 0) != 0xC3 {
		return fail("RET encoding wrong")
	}
	return ""
}

// RET imm16 is C2 iw, the immediate a 16-bit word, as clang encodes `ret 8`, `ret 0`, `ret
// 65535`, `ret -1` and `ret -32768`; outside -32768..65535 it is rejected with no bytes.
func TestRetImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	RetImm(a, 8)
	if !emitsExactly(a, "c2 08 00") { return fail("ret 8") }
	a = newAsm()
	RetImm(a, 0)
	if !emitsExactly(a, "c2 00 00") { return fail("ret 0") }
	a = newAsm()
	RetImm(a, 65535)
	if !emitsExactly(a, "c2 ff ff") { return fail("ret 65535") }
	a = newAsm()
	RetImm(a, -1)
	if !emitsExactly(a, "c2 ff ff") { return fail("ret -1") }
	a = newAsm()
	RetImm(a, -32768)
	if !emitsExactly(a, "c2 00 80") { return fail("ret -32768") }
	a = newAsm()
	RetImm(a, 65536)
	if !rejected(a) { return fail("ret 65536 must be rejected") }
	a = newAsm()
	RetImm(a, -32769)
	if !rejected(a) { return fail("ret -32769 must be rejected") }
	return ""
}

// --- Fixup resolution ---

// A JMP to an `L`-prefixed (block-label) target resolves in-section: block
// labels stay within the function's atom, so the rel32 displacement is fixed
// in the .o. (A jump/call to a non-`L` atom-start symbol is left as a
// relocation instead — see TestCallToDefinedNonLSymbolIsReloc.)
func TestJmpForwardFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// JMP Lblock ; fixup at offset 1 (the rel32), Lblock at offset 7
	// JMP = E9 rel32 (5 bytes), then NOP NOP, then Lblock:
	// rel32 = Lblock - (fixup + 4) = 7 - (1+4) = 2
	Jmp(a, "Lblock")
	Nop(a) // offset 5
	Nop(a) // offset 6
	a.DefineLabel("Lblock")
	Nop(a) // offset 7

	var ok bool = ResolveFixups(a)
	if !ok { return fail("fixup resolution failed") }
	var s @asm.Section = a.Sections[0]
	// rel32 at offset 1 should be 2
	if s.Data[1] != 2 || s.Data[2] != 0 {
		return fail("JMP forward fixup wrong")
	}
	return ""
}

func TestCallBackwardFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// Lblock: NOP ; offset 0
	// CALL Lblock ; offset 1, fixup at offset 2
	// rel32 = 0 - (2+4) = -6.  The `L` prefix makes it a block label, so it
	// resolves in-section.
	a.DefineLabel("Lblock")
	Nop(a) // offset 0
	Call(a, "Lblock") // offset 1

	var ok bool = ResolveFixups(a)
	if !ok { return fail("fixup resolution failed") }
	var s @asm.Section = a.Sections[0]
	// rel32 at offset 2: -6 = 0xFFFFFFFA
	if s.Data[2] != 0xFA || s.Data[3] != 0xFF {
		return fail("CALL backward fixup wrong")
	}
	return ""
}

// A CALL/JMP to a DEFINED same-section non-`L` symbol must become a
// relocation, NOT an in-section rel32: every non-`L` symbol starts an atom,
// and clang on x86-64 keeps a reference across atoms a relocation with or
// without MH_SUBSECTIONS_VIA_SYMBOLS (under which the linker may
// reorder/coalesce/dead-strip each atom, so only a relocation against the
// symbol survives).
func TestCallToDefinedNonLSymbolIsReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Call(a, "callee") // offset 0: CALL callee (atom-start target)
	Ret(a)
	a.DefineLabel("callee") // defined, same section, non-`L`
	Ret(a)

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	if a.NumRelocs != 1 { return fail("expected 1 relocation for a non-L atom-start target") }
	return ""
}

// jmpWithAddend assembles `jmp Lblock + addend; Lblock:` — the rel32 at offset 1
// then equals the addend exactly (Lblock is at 5, the end of the JMP) — and
// resolves it, reporting whether resolution succeeded.
func jmpWithAddend(addend int64) (@asm.Assembler, bool) {
	var a @asm.Assembler = newAsm()
	Jmp(a, "Lblock")
	a.DefineLabel("Lblock")
	a.Sections[0].Fixups[0].Addend = addend
	var ok bool = ResolveFixups(a)
	return a, ok
}

// A fixed displacement that does not fit rel32 is an error naming the symbol,
// and the fixup is left unresolved rather than patched with a truncated value.
func TestRel32OutOfRangeIsError() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = jmpWithAddend(2147483647)
	if !ok || a.HasError { return fail("rel32 = 2^31-1 should resolve") }
	if a.Sections[0].Data[4] != 0x7F { return fail("rel32 = 2^31-1 patched wrong") }
	a, ok = jmpWithAddend(-2147483648)
	if !ok || a.HasError { return fail("rel32 = -2^31 should resolve") }
	a, ok = jmpWithAddend(2147483648)
	if ok || !a.HasError { return fail("rel32 = 2^31 accepted") }
	if !msgHasPrefix(a.ErrorMsg, "x64: reference to 'Lblock' is out of rel32 range") {
		return fail(a.ErrorMsg)
	}
	if a.Sections[0].Fixups[0].Kind != FIX_REL32 { return fail("out-of-range fixup marked resolved") }
	a, ok = jmpWithAddend(-2147483649)
	if ok || !a.HasError { return fail("rel32 = -2^31-1 accepted") }
	return ""
}

// CALL / JMP through memory, as clang encodes them: `call qword ptr [rax]` FF 10; `[r12 + 8]` 41
// FF 54 24 08; `[rbx + rcx*8 + 16]` FF 54 CB 10; `[r13]` 41 FF 55 00; `[0x1000]` FF 14 25;
// `jmp qword ptr [rax]` FF 20; `jmp [r9 + 8]` 41 FF 61 08; `jmp [rax*8 + 0x100]` FF 24 C5; and
// `call qword ptr [rip + x + 8]` FF 15, its fixup FIX_REL32_LEA x+8.
func TestCallJmpMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CallMem(a, Mem(RAX, 0, SZ64))
	CallMem(a, Mem(R12, 8, 0))
	CallMem(a, MemIdx(RBX, RCX, 8, 16, SZ64))
	CallMem(a, Mem(R13, 0, SZ64))
	CallMem(a, MemAbs(0x1000, SZ64))
	JmpMem(a, Mem(RAX, 0, SZ64))
	JmpMem(a, Mem(R9, 8, 0))
	JmpMem(a, MemIdx(-1, RAX, 8, 0x100, 0))
	if !emitsExactly(a,
			"ff 10 41 ff 54 24 08 ff 54 cb 10 41 ff 55 00 ff 14 25 00 10 00 00 ff 20 41 ff 61 08 "
					"ff 24 c5 00 01 00 00") {
		return fail("a CALL / JMP through memory is not clang's bytes")
	}
	a = newAsm()
	CallMem(a, RipLabelAddend("x", 8))
	var s @asm.Section = a.Sections[0]
	if !emitsExactly(a, "ff 15 00 00 00 00") || s.NumFixups != 1 ||
			s.Fixups[0].Kind != FIX_REL32_LEA || s.Fixups[0].Offset != 2 || s.Fixups[0].Addend != 8 {
		return fail("call qword ptr [rip + x + 8]")
	}
	return ""
}

// The call through a TLS descriptor, `call qword ptr [rax + x@tlscall]`, is FF 10 with a
// FIX_TLSCALL fixup at its first byte; unsized too.
func TestCallTlsDesc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Nop(a)
	CallMem(a, MemSym(RAX, -1, 1, "x", FIX_TLSCALL, 0, SZ64))
	CallMem(a, MemSym(RAX, -1, 1, "x", FIX_TLSCALL, 0, 0))
	var s @asm.Section = a.Sections[0]
	if !emitsExactly(a, "90 ff 10 ff 10") || s.NumFixups != 2 || s.Fixups[0].Kind != FIX_TLSCALL ||
			s.Fixups[0].Offset != 1 || s.Fixups[0].Addend != 0 || s.Fixups[1].Offset != 3 {
		return fail("call qword ptr [rax + x@tlscall]")
	}
	return ""
}

// What CALL / JMP through memory has no encoding for is an error that emits nothing: a size but
// 64 bits (clang reads `call dword ptr [rax]` as a far call), a register or immediate, a GOT
// operand, a thread-local slot, an RSP index; a TLS descriptor call on any base but RAX or none,
// with an index or a displacement, with no symbol, or with JMP; and FIX_TLSCALL in any other
// instruction.
func TestCallJmpMemRejects() testing.TestResult {
	var bad @[]Operand = make_slice(Operand, 13)
	bad[0] = Mem(RAX, 0, SZ32)
	bad[1] = Mem(RAX, 0, SZ16)
	bad[2] = Mem(RAX, 0, SZ8)
	bad[3] = Reg(RAX, SZ64)
	bad[4] = Imm(5)
	bad[5] = RipGotLabel("x")
	bad[6] = MemSym(R8, -1, 1, "x", FIX_TLSCALL, 0, SZ64)
	bad[7] = MemSym(RAX, RCX, 1, "x", FIX_TLSCALL, 0, SZ64)
	bad[8] = MemSym(RAX, -1, 1, "x", FIX_TLSCALL, 8, SZ64)
	bad[9] = MemSym(-1, -1, 1, "x", FIX_TLSCALL, 0, SZ64)
	bad[10] = MemSym(RAX, -1, 1, "", FIX_TLSCALL, 0, SZ64)
	bad[11] = RipTls("x", FIX_GOTTPOFF)
	bad[12] = MemIdx(RAX, RSP, 1, 0, SZ64)
	for i := 0; i < len(bad); i++ {
		var c @asm.Assembler = newAsm()
		CallMem(c, bad[i])
		if !rejected(c) { return fail("a CALL through memory with no encoding was taken") }
		var j @asm.Assembler = newAsm()
		JmpMem(j, bad[i])
		if !rejected(j) { return fail("a JMP through memory with no encoding was taken") }
	}
	var t @asm.Assembler = newAsm()
	JmpMem(t, MemSym(RAX, -1, 1, "x", FIX_TLSCALL, 0, SZ64))
	if !rejected(t) { return fail("jmp qword ptr [rax + x@tlscall] was taken") }
	var m @asm.Assembler = newAsm()
	Mov(m, Reg(RAX, SZ64), MemSym(RAX, -1, 1, "x", FIX_TLSCALL, 0, SZ64))
	if !m.HasError { return fail("mov rax, qword ptr [rax + x@tlscall] was taken") }
	return ""
}
