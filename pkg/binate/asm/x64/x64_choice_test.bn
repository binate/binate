package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The encoding choices against clang's bytes (`clang --target=x86_64-linux-gnu -c`, Intel syntax):
// MovS (`mov.s`), a Disp8 memory operand (`{disp8}`), a forced REX (`{rex}`, asm.Assembler.X64Rex).

// MovS at each size, with SPL..DIL's REX, R8..R15 and AH; two registers of one size only.
func TestMovS() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovS(a, Reg(RAX, SZ32), Reg(RBX, SZ32))
	MovS(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	MovS(a, Reg(RAX, SZ8), Reg(RBX, SZ8))
	MovS(a, Reg(RAX, SZ16), Reg(RBX, SZ16))
	MovS(a, Reg(R9, SZ64), Reg(R10, SZ64))
	MovS(a, Reg(RSI, SZ8), Reg(RAX, SZ8))
	MovS(a, Reg(AH, SZ8), Reg(RAX, SZ8))
	if !emitsExactly(a, "8bc3 488bc3 8ac3 668bc3 4d8bca 408af0 8ae0") { return fail("mov.s") }
	a = newAsm()
	MovS(a, Reg(RAX, SZ32), Reg(RBX, SZ16))
	if !rejected(a) { return fail("mov.s eax, bx: not rejected") }
	a = newAsm()
	MovS(a, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	if !rejected(a) { return fail("mov.s eax, [rbx]: not rejected") }
	a = newAsm()
	MovS(a, Reg(AH, SZ8), Reg(RSI, SZ8))
	if !a.HasError { return fail("mov.s ah, sil: no error") }
	return ""
}

// dispMem returns Mem(base, disp, size) with Disp8 set.
func dispMem(base int, disp int, size int) Operand {
	var op Operand = Mem(base, disp, size)
	op.Disp8 = true
	return op
}

// Disp8: a base with no displacement takes a disp8 of 0 (RBP / R13 as ever, RSP / R12 with their
// SIB, an index), one past 8 bits 32; Disp32 overrides it.
func TestDisp8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ32), dispMem(RBX, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), dispMem(RBP, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), dispMem(RBX, 8, SZ32))
	Mov(a, Reg(RAX, SZ32), dispMem(RBX, 0x100, SZ32))
	Mov(a, Reg(RAX, SZ32), dispMem(RSP, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), dispMem(R13, 0, SZ32))
	var idx Operand = MemIdx(RBX, RCX, 4, 0, SZ32)
	idx.Disp8 = true
	Mov(a, Reg(RAX, SZ32), idx)
	var both Operand = dispMem(RBX, 0, SZ32)
	both.Disp32 = true
	Mov(a, Reg(RAX, SZ32), both)
	if !emitsExactly(a, "8b4300 8b4500 8b4308 8b8300010000 8b442400 418b4500 8b448b00 8b8300000000") {
		return fail("disp8")
	}
	return ""
}

// X64Rex: emitRexF takes it as a forced REX (40, or with W 48 alone), the opcode-only forms get
// one too, and AH..BH beside it are an error.
func TestForcedRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.X64Rex = true
	Mov(a, Reg(RAX, SZ32), Reg(RBX, SZ32))
	a.X64Rex = true
	Mov(a, Reg(RAX, SZ64), Reg(RBX, SZ64))
	a.X64Rex = true
	Push(a, Reg(RBX, SZ64))
	a.X64Rex = true
	Nop(a)
	if !emitsExactly(a, "4089d8 4889d8 4053 4090") { return fail("{rex}") }
	a = newAsm()
	a.X64Rex = true
	Mov(a, Reg(AH, SZ8), Reg(RAX, SZ8))
	if !a.HasError { return fail("{rex} mov ah, al: no error") }
	return ""
}

// X64Disp (`{disp8}` / `{disp32}` for an instruction's every ModR/M memory operand): 8 gives a base
// with no displacement a disp8, 32 any base a disp32; an index without a base, and a register
// operand, are as ever.
func TestStatementDisp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.X64Disp = 8
	Mov(a, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), Mem(RBX, 0x100, SZ32))
	Mov(a, Reg(RAX, SZ32), Reg(RBX, SZ32))
	a.X64Disp = 32
	Mov(a, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), Mem(RSP, 8, SZ32))
	Mov(a, Reg(RAX, SZ32), MemIdx(-1, RCX, 4, 0, SZ32))
	if !emitsExactly(a, "8b4300 8b8300010000 89d8 8b8300000000 8b842408000000 8b048d00000000") {
		return fail("X64Disp")
	}
	return ""
}
