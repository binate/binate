package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- CMOVcc ---
// 0F 40+cc /r: a 16-, 32- or 64-bit register loaded from a register or memory operand of its size
// when the flags satisfy cc.  There is no 8-bit form.

// Cmovcc emits `cmov<cc> dst, src`; see x64.bni.
func Cmovcc(a @asm.Assembler, cc int, dst Operand, src Operand) {
	if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, "cmovcc")
		return
	}
	if !condOK(a, "cmovcc", cc) { return }
	var size int = opSize(a, "cmovcc", dst, src)
	if size == 0 { return }
	if size == SZ8 {
		setOperandError(a, "cmovcc", "there is no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	emitRexRM(a, rexW(size), dst.Reg, src, false)
	emit8(a, 0x0F)
	emit8(a, 0x40 + cc)
	emitModRM(a, dst.Reg, src)
}
