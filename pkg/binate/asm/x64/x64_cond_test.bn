package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// CMOVcc (x64_cond.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`, Intel syntax).
// (aluCase is in x64_acc_test.bn, ripFixupAt in x64_rip_imm_test.bn.)

// 0F 40+cc /r for each condition (rax from rbx); at 32 bits from memory and at 16 from a register;
// a `[rip + x]` source with its PC-relative fixup.
func TestCmovcc() testing.TestResult {
	var e @[]char = ""
	var ops @[]int = @[]int{0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b,
			0x4c, 0x4d, 0x4e, 0x4f}
	for cc := 0; cc < 16; cc++ {
		var a @asm.Assembler = newAsm()
		Cmovcc(a, cc, Reg(RAX, SZ64), Reg(RBX, SZ64))
		var s @asm.Section = a.Sections[0]
		if a.HasError || asm.HeldLen(s) != 4 || s.Data[0] != 0x48 || s.Data[1] != 0x0f ||
				cast(int, s.Data[2]) != ops[cc] || s.Data[3] != 0xc3 {
			return fail("cmov<cc> rax, rbx: not 48 0F 40+cc C3")
		}
	}
	var a @asm.Assembler = newAsm()
	Cmovcc(a, CC_E, Reg(RAX, SZ32), Mem(RBX, 0, SZ32))
	e = aluCase(e, a, "cmove eax, [rbx]", "0f 44 03")
	a = newAsm()
	Cmovcc(a, CC_E, Reg(RAX, SZ16), Reg(RBX, SZ16))
	e = aluCase(e, a, "cmovz ax, bx", "66 0f 44 c3")
	a = newAsm()
	var m Operand = RipLabel("x")
	m.Size = SZ64
	Cmovcc(a, CC_NE, Reg(R8, SZ64), m)
	if !emitsExactly(a, "4c 0f 45 05 00 00 00 00") || !ripFixupAt(a, 4, 0) {
		return fail("cmovne r8, qword ptr [rip + x]")
	}
	return e
}

// No 8-bit form, a memory destination, an immediate source, registers of two sizes, and a
// condition outside 0..15 are errors, with nothing emitted.
func TestCmovccRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cmovcc(a, CC_NE, Reg(RAX, SZ8), Reg(RBX, SZ8))
	if !rejected(a) { return fail("cmovne al, bl") }
	a = newAsm()
	Cmovcc(a, CC_NE, Mem(RBX, 0, SZ64), Reg(RAX, SZ64))
	if !rejected(a) { return fail("cmovne [rbx], rax") }
	a = newAsm()
	Cmovcc(a, CC_NE, Reg(RAX, SZ64), Imm(5))
	if !rejected(a) { return fail("cmovne rax, 5") }
	a = newAsm()
	Cmovcc(a, CC_NE, Reg(RAX, SZ64), Reg(RBX, SZ32))
	if !rejected(a) { return fail("cmovne rax, ebx") }
	a = newAsm()
	Cmovcc(a, 16, Reg(RAX, SZ64), Reg(RBX, SZ64))
	if !rejected(a) { return fail("cmov with cc 16") }
	a = newAsm()
	Cmovcc(a, -1, Reg(RAX, SZ64), Reg(RBX, SZ64))
	if !rejected(a) { return fail("cmov with cc -1") }
	return ""
}
