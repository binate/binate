package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// ============================================================
// Data movement: MOV / LEA / PUSH / POP / SETcc / MOVZX /
//                MOVSX / MOVSXD
// ============================================================
//
// Split out of x64_arith.bn to keep that file under the file-
// length soft cap.  The pure-ALU / unary / shift / multiply /
// divide encoders stay in x64_arith.bn; everything that just
// moves data (or computes effective addresses) lives here, except
// the `[rip + label]` forms, which are in x64_rip.bn.

// --- MOV ---
// MOV has many forms:
//   reg, reg:  0x89 (r/m, r) or 0x8B (r, r/m)
//   reg, imm:  0xB0+rb ib (8-bit), 0xB8+rw iw (16-bit), 0xB8+rd id
//              (32-bit); 64-bit: REX.W 0xC7 /0 id (sign-extended imm32)
//              or REX.W 0xB8+rd io (imm64)
//   mem, reg:  0x89 (r/m, r)
//   reg, mem:  0x8B (r, r/m)
//   mem, imm:  0xC6 /0 ib (8-bit), 0xC7 /0 iw/id (16/32-bit; a 64-bit
//              store sign-extends the imm32)
// Every immediate form except the 64-bit register one (whose imm64 holds any
// value) takes an operation-width immediate: one that does not fit it
// (immFits) sets an assembler error and emits nothing, as does any other
// operand combination (e.g. mem, mem).

func Mov(a @asm.Assembler, dst Operand, src Operand) {
	// `mov dst, [rip + label]` — direct RIP-relative load of label's contents.
	if src.Kind == OP_RIPLABEL {
		MovRipLabel(a, dst, src.Label)
		return
	}
	// `mov dst, [rip + label@GOTPCREL]` — GOT-indirect load of an external symbol's
	// address (the linker keeps this a mov and points it at the GOT slot).
	if src.Kind == OP_RIPGOTLABEL {
		MovGotPcRel(a, dst, src.Label)
		return
	}
	// `mov [rip + label], src` — direct RIP-relative store into label's word.
	if dst.Kind == OP_RIPLABEL {
		MovRipLabelStore(a, src, dst.Label)
		return
	}
	var regSrc bool = src.Kind == OP_REG && isRM(dst)
	var memSrc bool = src.Kind == OP_MEM && dst.Kind == OP_REG
	var immSrc bool = src.Kind == OP_IMM && isRM(dst)
	if !regSrc && !memSrc && !immSrc {
		setKindsError(a, "mov")
		return
	}
	var size int = operandSize(dst, src)
	var wideReg bool = dst.Kind == OP_REG && size == SZ64
	if immSrc && !wideReg && !immFits(src.Imm, size) {
		setImmRangeError(a, "mov", size)
		return
	}
	emitSizePrefix(a, size)

	if regSrc {
		// MOV r/m, r
		// SZ8: the byte-accessed registers are src.Reg (r) and, for a reg-reg
		// form, dst.Reg (r/m).  Force REX so RSP/RBP/RSI/RDI select SPL/BPL/
		// SIL/DIL rather than the legacy AH/CH/DH/BH.  (A memory r/m base is
		// addressing, not a byte access, so it does not force REX here.)
		var force8 bool = size == SZ8 &&
				(byteRegHazard(src.Reg) || (dst.Kind == OP_REG && byteRegHazard(dst.Reg)))
		emitRexRM(a, rexW(size), src.Reg, dst, force8)
		if size == SZ8 {
			emit8(a, 0x88)
		} else {
			emit8(a, 0x89)
		}
		emitModRM(a, src.Reg, dst)
		return
	}
	if memSrc {
		// MOV r, r/m
		// SZ8: dst.Reg is the byte-accessed register (src is memory); force REX
		// for RSP/RBP/RSI/RDI so its low byte, not AH/CH/DH/BH, is written.
		var force8 bool = size == SZ8 && byteRegHazard(dst.Reg)
		emitRexRM(a, rexW(size), dst.Reg, src, force8)
		if size == SZ8 {
			emit8(a, 0x8A)
		} else {
			emit8(a, 0x8B)
		}
		emitModRM(a, dst.Reg, src)
		return
	}
	if dst.Kind == OP_REG {
		// MOV reg, imm.
		if size == SZ8 {
			// dst.Reg is written as a byte; force REX for RSP/RBP/RSI/RDI.
			emitRexF(a, false, 0, 0, dst.Reg, byteRegHazard(dst.Reg))
			emit8(a, 0xB0 + regLo3(dst.Reg))
			emitImmW(a, immAtWidth(src.Imm, size), size)
			return
		}
		if size == SZ16 || size == SZ32 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB8 + regLo3(dst.Reg))
			emitImmW(a, immAtWidth(src.Imm, size), size)
			return
		}
		// SZ64 has two encodings:
		//   - imm32-sign-extended `0xC7 /0 imm32` with REX.W: 7 bytes,
		//     used when src.Imm fits in a signed 32-bit (REX.W
		//     sign-extends the imm32 to 64 bits).
		//   - imm64 `0xB8+rd imm64` with REX.W: 10 bytes, used when
		//     src.Imm doesn't fit signed i32, so a wide constant is
		//     never truncated to 32 bits.
		if src.Imm >= -2147483648 && src.Imm <= 2147483647 {
			emitRex(a, true, 0, 0, dst.Reg)
			emit8(a, 0xC7)
			// ModRM: mod=11 (reg-direct), reg=/0, rm=dst.
			emit8(a, 0xC0 + regLo3(dst.Reg))
			emit32le(a, cast(int, src.Imm))
			return
		}
		emitRex(a, true, 0, 0, dst.Reg)
		emit8(a, 0xB8 + regLo3(dst.Reg))
		// imm64: little-endian 8 bytes.
		a.EmitUint64(cast(uint64, src.Imm))
		return
	}
	// MOV r/m, imm with a memory destination: 0xC6 /0 ib (byte) or 0xC7 /0 iw/id.
	emitRexRM(a, rexW(size), 0, dst, false)
	if size == SZ8 {
		emit8(a, 0xC6)
	} else {
		emit8(a, 0xC7)
	}
	emitModRM(a, 0, dst)
	emitImmW(a, immAtWidth(src.Imm, size), size)
}

// --- LEA ---
// LEA r, m: 0x8D r, r/m (always uses word form)

// Lea emits `lea dst, src`: dst is a 16/32/64-bit register and src a memory
// operand (or a `[rip + label]`, routed to LeaRipLabel).  Any other operand
// kinds, or an 8-bit dst (there is no 8-bit LEA), sets an assembler error and
// emits nothing.
func Lea(a @asm.Assembler, dst Operand, src Operand) {
	// `lea dst, [rip + label]` — compute label's address (RIP-relative).
	if src.Kind == OP_RIPLABEL {
		LeaRipLabel(a, dst, src.Label)
		return
	}
	if dst.Kind != OP_REG || src.Kind != OP_MEM {
		setKindsError(a, "lea")
		return
	}
	var size int = dst.Size
	if size == SZ8 {
		setOperandError(a, "lea", "no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	emitRexRM(a, rexW(size), dst.Reg, src, false)
	emit8(a, 0x8D)
	emitModRM(a, dst.Reg, src)
}

// --- PUSH / POP ---
// PUSH reg: 0x50+rd (64-bit without REX.W; 16-bit with 0x66)
// POP reg:  0x58+rd
// PUSH mem: 0xFF /6;  POP mem: 0x8F /0
// PUSH imm: 0x68 imm32 or 0x6A imm8, both sign-extended to the pushed
//           64-bit word; an immediate outside -2^31..2^31-1 sets an
//           assembler error and emits nothing.
// A register or memory operand is 64-bit, or 16-bit with the 0x66 prefix;
// 8- and 32-bit operands have no encoding in 64-bit mode.  Those, and any
// other operand kind, set an assembler error and emit nothing.

// pushPopSizeOK reports whether op has a PUSH / POP operand size (16 or 64
// bits), else records an assembler error naming mnem.
func pushPopSizeOK(a @asm.Assembler, mnem *[]readonly char, op Operand) bool {
	if op.Size == SZ64 || op.Size == SZ16 { return true }
	setOperandError(a, mnem, "operand must be 16- or 64-bit")
	return false
}

// Push emits `push src` — decrement rsp by the operand size and store src (a
// 64/16-bit register or memory operand, or a sign-extended immediate) at [rsp].
func Push(a @asm.Assembler, src Operand) {
	if src.Kind == OP_REG {
		if !pushPopSizeOK(a, "push", src) { return }
		emitSizePrefix(a, src.Size)
		if regHi(src.Reg) != 0 {
			emit8(a, 0x41) // REX.B
		}
		emit8(a, 0x50 + regLo3(src.Reg))
	} else if src.Kind == OP_MEM {
		if !pushPopSizeOK(a, "push", src) { return }
		emitSizePrefix(a, src.Size)
		emitRexRM(a, false, 0, src, false)
		emit8(a, 0xFF)
		emitModRM(a, 6, src)
	} else if src.Kind == OP_IMM {
		if !immFits(src.Imm, SZ64) {
			setImmRangeError(a, "push", SZ64)
			return
		}
		if immFitsI8(src.Imm) {
			emit8(a, 0x6A)
			emit8(a, cast(int, src.Imm))
		} else {
			emit8(a, 0x68)
			emit32le(a, cast(int, src.Imm))
		}
	} else {
		setKindsError(a, "push")
	}
}

// Pop emits `pop dst` — copy the word at [rsp] into dst (a 64/16-bit
// register or memory operand) and then increment rsp by the operand size.
func Pop(a @asm.Assembler, dst Operand) {
	if !isRM(dst) {
		setKindsError(a, "pop")
		return
	}
	if !pushPopSizeOK(a, "pop", dst) { return }
	emitSizePrefix(a, dst.Size)
	if dst.Kind == OP_MEM {
		emitRexRM(a, false, 0, dst, false)
		emit8(a, 0x8F)
		emitModRM(a, 0, dst)
		return
	}
	if regHi(dst.Reg) != 0 {
		emit8(a, 0x41) // REX.B
	}
	emit8(a, 0x58 + regLo3(dst.Reg))
}

// --- SETcc / MOVZX / MOVSX / MOVSXD ---

// Setcc emits `setCC dst8` — write 1 to the low byte of dst if the
// flags satisfy condition cc, else 0.  Always operates on the
// 8-bit-low-byte view (AL, CL, R10B, ...).  Encoded as 0F 9{cc} /0,
// with a REX prefix when dst.Reg is RSP/RBP/RSI/RDI/R8..R15 to
// disambiguate from the legacy AH/CH/DH/BH high-byte registers.
// The cc argument is one of the CC_* constants.
//
// dst is a register or a memory operand; its size doesn't matter (the
// encoding is 8-bit-fixed, and a memory dst gets one byte written).
// Caller typically follows with MOVZX r64, dst8 to zero-extend the bool
// result into a full register.  Any other dst, or a cc outside the CC_*
// range (0..15), sets an assembler error and emits nothing.
func Setcc(a @asm.Assembler, cc int, dst Operand) {
	if !isRM(dst) {
		setKindsError(a, "setcc")
		return
	}
	if !condOK(a, "setcc", cc) { return }
	if dst.Kind == OP_MEM {
		emitRexRM(a, false, 0, dst, false)
		emit8(a, 0x0F)
		emit8(a, 0x90 + cc)
		emitModRM(a, 0, dst)
		return
	}
	// REX prefix discipline for 8-bit operands:
	//   - regs 0-3 (AL/CL/DL/BL): no REX needed (default low byte).
	//   - regs 4-7 (RSP/RBP/RSI/RDI): low byte is SPL/BPL/SIL/DIL,
	//     which requires an explicit REX (= 0x40) to disambiguate
	//     from the legacy AH/CH/DH/BH high-byte regs (without REX,
	//     ModRM rm=100..111 in 8-bit context selects AH..BH).
	//   - regs 8-15: needs REX.B (= 0x41).  emitRex's normal path.
	if dst.Reg >= 4 && dst.Reg < 8 {
		emit8(a, 0x40)
	} else {
		emitRex(a, false, 0, 0, dst.Reg)
	}
	emit8(a, 0x0F)
	emit8(a, 0x90 + cc)
	// ModRM: mod=11 (reg-direct), reg=/0 (000), rm=dst low 3 bits.
	emit8(a, 0xC0 + regLo3(dst.Reg))
}

// extendOperandsOK reports whether dst/src are a valid MOVZX / MOVSX /
// MOVSXD pair — a register dst and a register or memory src, whose sizes the
// caller has checked (sizesOK) — else records an assembler error naming mnem.
func extendOperandsOK(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand,
		sizesOK bool) bool {
	if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, mnem)
		return false
	}
	if !sizesOK {
		setOperandError(a, mnem, "unsupported operand sizes")
		return false
	}
	return true
}

// widenSizesOK reports whether a MOVZX / MOVSX pair widens: an 8-bit source
// into a 16/32/64-bit destination, or a 16-bit source into a 32/64-bit one.
func widenSizesOK(dst Operand, src Operand) bool {
	if dst.Size == SZ16 { return src.Size == SZ8 }
	return (dst.Size == SZ32 || dst.Size == SZ64) && (src.Size == SZ8 || src.Size == SZ16)
}

// Movzx emits `movzx dst, src` — zero-extend src into the wider
// register dst.  src is either an 8-bit / 16-bit register or an
// 8-bit / 16-bit memory operand; dst is the wider register (size
// from dst.Size: SZ16 for an 8-bit src, else SZ32 or SZ64).  Other
// operand kinds or sizes set an assembler error and emit nothing.
//
// Encoding: (0x66 for a 16-bit dst) (REX.W?) + 0F B6 /r (byte src) or
// 0F B7 /r (word src).  src.Size picks the byte vs word form.
func Movzx(a @asm.Assembler, dst Operand, src Operand) {
	if !extendOperandsOK(a, "movzx", dst, src, widenSizesOK(dst, src)) { return }
	emitSizePrefix(a, dst.Size)
	// A byte-SOURCE register RSP/RBP/RSI/RDI needs a forced REX so its low byte
	// SIL/DIL/SPL/BPL is read, not the legacy AH/CH/DH/BH.  (dst is the wide
	// result register — not a byte access.)
	var force8 bool = src.Kind == OP_REG && src.Size == SZ8 && byteRegHazard(src.Reg)
	emitRexRM(a, rexW(dst.Size), dst.Reg, src, force8)
	emit8(a, 0x0F)
	if src.Size == SZ16 {
		emit8(a, 0xB7)
	} else {
		emit8(a, 0xB6)
	}
	emitModRM(a, dst.Reg, src)
}

// Movsx emits `movsx dst, src` — sign-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider register dst (SZ16 for
// a byte src, else SZ32 or SZ64).  Used by emitScalarLoad for signed
// sub-word loads.  src is either an 8/16-bit register or an 8/16-bit
// memory operand.  Other operand kinds or sizes set an assembler error
// and emit nothing.
//
// Encoding: (0x66 for a 16-bit dst) (REX.W?) + 0F BE /r (byte src) or
// 0F BF /r (word src).
func Movsx(a @asm.Assembler, dst Operand, src Operand) {
	if !extendOperandsOK(a, "movsx", dst, src, widenSizesOK(dst, src)) { return }
	emitSizePrefix(a, dst.Size)
	// A byte-SOURCE register RSP/RBP/RSI/RDI needs a forced REX so its low byte
	// SIL/DIL/SPL/BPL is read, not the legacy AH/CH/DH/BH.  (dst is the wide
	// result register — not a byte access.)
	var force8 bool = src.Kind == OP_REG && src.Size == SZ8 && byteRegHazard(src.Reg)
	emitRexRM(a, rexW(dst.Size), dst.Reg, src, force8)
	emit8(a, 0x0F)
	if src.Size == SZ16 {
		emit8(a, 0xBF)
	} else {
		emit8(a, 0xBE)
	}
	emitModRM(a, dst.Reg, src)
}

// Movsxd emits `movsxd dst, src` — sign-extend a 32-bit source into
// the 64-bit dst.  Encoding: REX.W + 0x63 /r.  dst must be a 64-bit
// register and src a 32-bit register or 32-bit memory operand; anything
// else sets an assembler error and emits nothing.
func Movsxd(a @asm.Assembler, dst Operand, src Operand) {
	var sizesOK bool = dst.Size == SZ64 && src.Size == SZ32
	if !extendOperandsOK(a, "movsxd", dst, src, sizesOK) { return }
	emitRexRM(a, true, dst.Reg, src, false)
	emit8(a, 0x63)
	emitModRM(a, dst.Reg, src)
}
