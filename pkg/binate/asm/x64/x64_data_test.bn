package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_data.bn — data-movement encoders (MOV, LEA, PUSH,
// POP, SETcc, MOVZX, MOVSX, MOVSXD, LeaRipLabel).  Split out of
// x64_arith_test.bn alongside the production split.

// --- MOV tests ---

func TestMovRegReg64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV RAX, RCX = REX.W 89 C8 (mov r/m64, r64)
	// REX.W=0x48, 0x89, ModRM=11|001|000 = 0xC8
	Mov(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0x89
	expected[2] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, RCX encoding wrong")
	}
	return ""
}

func TestMovRegReg32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV EAX, ECX = 89 C8 (no REX needed for 32-bit)
	Mov(a, Reg(RAX, SZ32), Reg(RCX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x89
	expected[1] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOV EAX, ECX encoding wrong")
	}
	return ""
}

func TestMovRegImm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV EAX, 42 = B8 2A000000
	Mov(a, Reg(RAX, SZ32), Imm(42))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0xB8
	expected[1] = 42
	expected[2] = 0
	expected[3] = 0
	expected[4] = 0
	if !checkBytes(s, 0, expected) {
		return fail("MOV EAX, 42 encoding wrong")
	}
	return ""
}

// MOV r64, imm where the immediate fits signed i32 uses the
// imm32-sign-extended form: REX.W + 0xC7 /0 + imm32 = 7 bytes
// (more compact than the 10-byte imm64 form).  Pre-fix this
// emitted `REX.W 0xB8+rd imm32` = 6 bytes, which is an invalid
// encoding — `0xB8+rd` with REX.W is the MOVABS form and expects
// an 8-byte imm64, so the 6-byte sequence would misalign the
// instruction stream.
func TestMovRegImm64SmallUsesC7Imm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), Imm(42))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48 // REX.W
	expected[1] = 0xC7 // MOV r/m64, imm32
	expected[2] = 0xC0 // ModRM: mod=11, reg=/0, rm=000 (RAX)
	expected[3] = 42
	expected[4] = 0
	expected[5] = 0
	expected[6] = 0
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, 42 should use C7 /0 imm32 encoding")
	}
	return ""
}

// MOV r64, imm where the immediate exceeds signed i32 range MUST
// use the imm64 (MOVABS) form: REX.W + 0xB8+rd + imm64 = 10 bytes.
// The value is passed via Imm64 — the int-based Imm would truncate
// it to 32 bits on a 32-bit host (where `int` is i32), producing a
// wrong constant for any value > INT32_MAX or < INT32_MIN.
func TestMovRegImm64WideUsesMovabsImm64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(R10, SZ64), Imm64(5000000000))
	var s @asm.Section = a.Sections[0]
	// 5000000000 = 0x12A05F200 — needs all 64 bits.
	// Expected: 49 BA 00 F2 05 2A 01 00 00 00
	if s.Len != 10 {
		return fail("MOVABS r64, imm64 should be 10 bytes")
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = s.Data
	if data[0] != cast(uint8, 0x49) {
		return fail("byte 0 should be REX.WB = 0x49")
	}
	if data[1] != cast(uint8, 0xBA) {
		return fail("byte 1 should be 0xB8+rd = 0xBA (R10)")
	}
	// Spot-check the imm64 low byte and high byte for endianness.
	if data[2] != cast(uint8, 0x00) {
		return fail("byte 2 (imm64[0]) should be 0x00")
	}
	if data[9] != cast(uint8, 0x00) {
		return fail("byte 9 (imm64[7]) should be 0x00")
	}
	return ""
}

func TestMovR8Reg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV R8, RAX = REX.WB 89 C0
	// REX = 0x49 (W=1, B=1), 0x89, ModRM = 11|000|000 = 0xC0
	Mov(a, Reg(R8, SZ64), Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x49
	expected[1] = 0x89
	expected[2] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("MOV R8, RAX encoding wrong")
	}
	return ""
}

func TestMovMemReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV [RBP-8], RAX = REX.W 89 45 F8
	// REX.W=0x48, 0x89, ModRM=01|000|101=0x45, disp8=0xF8(-8)
	Mov(a, Mem(RBP, -8, SZ64), Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x89
	expected[2] = 0x45
	expected[3] = 0xF8
	if !checkBytes(s, 0, expected) {
		return fail("MOV [RBP-8], RAX encoding wrong")
	}
	return ""
}

func TestMovRegMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV RAX, [RBP-8] = REX.W 8B 45 F8
	Mov(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x8B
	expected[2] = 0x45
	expected[3] = 0xF8
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, [RBP-8] encoding wrong")
	}
	return ""
}

// --- PUSH / POP ---

func TestPushReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// PUSH RBP = 55
	Push(a, Reg(RBP, SZ64))
	if readByte(a.Sections[0], 0) != 0x55 {
		return fail("PUSH RBP encoding wrong")
	}
	return ""
}

func TestPopReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// POP RBP = 5D
	Pop(a, Reg(RBP, SZ64))
	if readByte(a.Sections[0], 0) != 0x5D {
		return fail("POP RBP encoding wrong")
	}
	return ""
}

func TestPushR8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// PUSH R8 = 41 50 (REX.B + 50)
	Push(a, Reg(R8, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x41
	expected[1] = 0x50
	if !checkBytes(s, 0, expected) {
		return fail("PUSH R8 encoding wrong")
	}
	return ""
}

// --- LEA ---

func TestLeaRbpOff() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LEA RAX, [RBP-16] = REX.W 8D 45 F0
	Lea(a, Reg(RAX, SZ64), Mem(RBP, -16, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x8D
	expected[2] = 0x45
	expected[3] = 0xF0
	if !checkBytes(s, 0, expected) {
		return fail("LEA RAX, [RBP-16] encoding wrong")
	}
	return ""
}

// --- SETcc / MOVZX / MOVSX / MOVSXD ---

// SETE AL: AL is regs 0-3 (RAX=0), so no REX prefix.  Encoded as
// 0F 94 C0 — 3 bytes.
func TestSetccALEqual() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setcc(a, CC_E, Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x0F
	expected[1] = 0x94 // 0x90 + CC_E (=4)
	expected[2] = 0xC0 // ModRM mod=11 reg=/0 rm=000
	if !checkBytes(s, 0, expected) {
		return fail("SETE AL encoding wrong")
	}
	return ""
}

// SETE SIL: regs 4-7 (RSI=6) require an explicit REX (= 0x40) to
// disambiguate the low byte (SIL) from the legacy AH/CH/DH/BH
// high-byte regs.  Without REX, ModRM rm=110 would decode as DH.
// Pin this branch — pre-fix Setcc skipped the REX, silently
// generating SET DH instead of SET SIL.
func TestSetccSilEqualForcesRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setcc(a, CC_E, Reg(RSI, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x40 // explicit REX, forces SIL not DH
	expected[1] = 0x0F
	expected[2] = 0x94
	expected[3] = 0xC6 // ModRM mod=11 reg=/0 rm=110 (RSI low 3)
	if !checkBytes(s, 0, expected) {
		return fail("SETE SIL should emit explicit REX 0x40")
	}
	return ""
}

// SETcc r10b for CC_NE: REX.B (0x41) + 0F 95 /0 + ModRM 11_000_010 (=0xC2).
func TestSetccR10NotEqual() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setcc(a, CC_NE, Reg(R10, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x41 // REX.B (R10 is in the upper-8)
	expected[1] = 0x0F
	expected[2] = 0x95 // 0x90 + CC_NE (=5)
	expected[3] = 0xC2 // ModRM mod=11 reg=/0 rm=010 (R10 low 3)
	if !checkBytes(s, 0, expected) {
		return fail("SETNE R10B encoding wrong")
	}
	return ""
}

// MOVZX r64, al: REX.W (0x48) + 0F B6 + ModRM 11_dst3_src3.
// MOVZX RAX, AL = 48 0F B6 C0.
func TestMovzxRaxAl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Reg(RAX, SZ64), Reg(RAX, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x0F
	expected[2] = 0xB6
	expected[3] = 0xC0 // mod=11 reg=000 rm=000
	if !checkBytes(s, 0, expected) {
		return fail("MOVZX RAX, AL encoding wrong")
	}
	return ""
}

// MOVZX r64, r10b: REX.WB (0x49) + 0F B6 + ModRM 11_000_010 (=0xC2).
func TestMovzxRaxR10b() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Reg(RAX, SZ64), Reg(R10, SZ8))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x49
	expected[1] = 0x0F
	expected[2] = 0xB6
	expected[3] = 0xC2 // mod=11 reg=000 (RAX) rm=010 (R10 low 3)
	if !checkBytes(s, 0, expected) {
		return fail("MOVZX RAX, R10B encoding wrong")
	}
	return ""
}

// MOVZX r64, byte ptr [rbp - 8]: REX.W + 0F B6 + ModRM 11_dst3_rm3
// for mem with disp8.  Pin the opcode pair (0F B6) and verify a
// REX.W is present.
func TestMovzxRegMem8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ8))
	var s @asm.Section = a.Sections[0]
	// Expected: 48 0F B6 45 F8 (REX.W, MOVZX-B, ModRM mod=01 reg=000
	// rm=101, disp8 = -8).
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0x48
	expected[1] = 0x0F
	expected[2] = 0xB6
	expected[3] = 0x45
	expected[4] = 0xF8
	if !checkBytes(s, 0, expected) {
		return fail("MOVZX RAX, byte ptr [rbp-8] encoding wrong")
	}
	return ""
}

// MOVZX r64, word ptr [rbp - 8]: word-form opcode is 0F B7 (not B6).
func TestMovzxRegMem16UsesB7() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ16))
	var s @asm.Section = a.Sections[0]
	if s.Len < 3 {
		return fail("MOVZX should emit at least 3 bytes")
	}
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xB7) {
		return fail("MOVZX with SZ16 src should emit 0F B7 (not B6)")
	}
	return ""
}

// MOVSX r64, byte ptr [rbp - 8]: opcode 0F BE.
func TestMovsxRegMem8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movsx(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ8))
	var s @asm.Section = a.Sections[0]
	if s.Len < 3 {
		return fail("MOVSX should emit at least 3 bytes")
	}
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xBE) {
		return fail("MOVSX byte src should be 0F BE")
	}
	return ""
}

// MOVSX r64, word ptr [rbp - 8]: word-form opcode is 0F BF.
func TestMovsxRegMem16UsesBF() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movsx(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ16))
	var s @asm.Section = a.Sections[0]
	if s.Len < 3 {
		return fail("MOVSX should emit at least 3 bytes")
	}
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xBF) {
		return fail("MOVSX word src should be 0F BF (not BE)")
	}
	return ""
}

// MOVSXD r64, dword ptr [rbp - 8]: REX.W + 0x63 + ModRM.
func TestMovsxdRegMem32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movsxd(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ32))
	var s @asm.Section = a.Sections[0]
	if s.Len < 2 {
		return fail("MOVSXD should emit at least 2 bytes")
	}
	if s.Data[0] != cast(uint8, 0x48) {
		return fail("MOVSXD should emit REX.W")
	}
	if s.Data[1] != cast(uint8, 0x63) {
		return fail("MOVSXD opcode should be 0x63")
	}
	return ""
}

// --- LeaRipLabel ---

// LEA rd, [rip + label]: REX.W + 0x8D + ModRM(mod=00 reg=dst3 rm=101)
// + 4-byte zero placeholder (resolved by ResolveFixups).
// For RAX: 48 8D 05 00 00 00 00 (7 bytes).
func TestLeaRipLabelRax() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LeaRipLabel(a, Reg(RAX, SZ64), "Lstr_0")
	var s @asm.Section = a.Sections[0]
	if s.Len != 7 {
		return fail("LeaRipLabel RAX should emit 7 bytes")
	}
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48 // REX.W
	expected[1] = 0x8D // LEA opcode
	expected[2] = 0x05 // ModRM mod=00 reg=000 rm=101
	expected[3] = 0
	expected[4] = 0
	expected[5] = 0
	expected[6] = 0
	if !checkBytes(s, 0, expected) {
		return fail("LEA RAX, [rip+Lstr_0] encoding wrong")
	}
	return ""
}

// LEA r10, [rip + label]: REX.WR (0x4C) + 0x8D + ModRM(mod=00
// reg=010 rm=101 = 0x15) + 4 zero bytes.
func TestLeaRipLabelR10() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LeaRipLabel(a, Reg(R10, SZ64), "Lstr_0")
	var s @asm.Section = a.Sections[0]
	if s.Len != 7 {
		return fail("LeaRipLabel R10 should emit 7 bytes")
	}
	if s.Data[0] != cast(uint8, 0x4C) {
		return fail("byte 0 should be REX.WR (0x4C) for R10 dst")
	}
	if s.Data[1] != cast(uint8, 0x8D) {
		return fail("byte 1 should be LEA opcode (0x8D)")
	}
	if s.Data[2] != cast(uint8, 0x15) {
		return fail("byte 2 should be ModRM (reg=010, rm=101)")
	}
	return ""
}

// LeaRipLabel MUST register its fixup as FIX_REL32_LEA — distinct
// from FIX_REL32 (CALL/JMP) so the Mach-O writer emits
// X86_64_RELOC_SIGNED rather than X86_64_RELOC_BRANCH.  Pinning the
// fixup kind here documents the invariant: ld silently miscomputes
// the displacement when a BRANCH reloc points at a data symbol,
// which previously bit OP_FUNC_VALUE construction (RIP-rel LEA of
// the __vt.<...> vtable in .data) and any other cross-section LEA
// targeting a data-section symbol.  A regression that flipped the
// kind back to FIX_REL32 would compile clean here, link clean, run
// to a wild jump on the first cross-section LEA.
func TestLeaRipLabelUsesFixRel32Lea() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LeaRipLabel(a, Reg(RAX, SZ64), "some_data_label")
	var s @asm.Section = a.Sections[0]
	if s.NumFixups < 1 {
		return fail("LeaRipLabel must register a fixup")
	}
	var fix asm.Fixup = s.Fixups[0]
	if fix.Kind != FIX_REL32_LEA {
		return fail(
				"LeaRipLabel must use FIX_REL32_LEA (not FIX_REL32) "
						"so Mach-O emits X86_64_RELOC_SIGNED for data-symbol LEAs")
	}
	return ""
}

// A RIP-relative data LEA must become a RELOCATION even when its target is
// a SAME-SECTION `L`-prefixed string label.  Under MH_SUBSECTIONS_VIA_SYMBOLS
// the string lives in its own atom that ld may move independently of the
// code, so a baked-in displacement is wrong — the reference must be
// relocated, mirroring aarch64's always-relocated ADRP+ADD.  (Resolving it
// in-section corrupted every string constant under subsections.)  Only an
// intra-function BRANCH to an `L` block label stays in-section.
func TestLeaRipToSameSectionStringIsReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LeaRipLabel(a, Reg(RAX, SZ64), "Lstr_x")
	a.DefineLabel("Lstr_x") // same section, `L`-prefixed
	var ok bool = ResolveFixups(a)
	if !ok { return fail("ResolveFixups failed") }
	a.Finalize()
	if a.NumRelocs != 1 {
		return fail("same-section LEA to a data label must relocate, not resolve in-section")
	}
	return ""
}
