package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// The support EVEX's encodings (pkg/binate/asm/x64/avx) take: its rounding operand and its
// compressed displacement.

// Round returns an EVEX rounding operand; see x64.bni.
func Round(mode int) Operand {
	var op Operand
	op.Kind = OP_ROUND
	op.Imm = cast(int64, mode)
	op.Base = -1
	op.Index = -1
	return op
}

// EmitModRMN emits rm's ModR/M and what follows with EVEX's compressed displacement; see x64.bni.
func EmitModRMN(a @asm.Assembler, regField int, rm Operand, immBytes int, n int) {
	if n < 1 {
		a.SetError("x64: EmitModRMN: the displacement's scale is 1 or more")
		return
	}
	if rm.Kind != OP_MEM {
		emitModRMImm(a, regField, rm, immBytes)
		return
	}
	if rm.Vsib != 0 {
		a.SetError("x64: a memory operand with a vector index (VSIB) is a gather's (EmitModRMVsib)")
		return
	}
	emitMemModRM(a, regField, rm, n)
}
