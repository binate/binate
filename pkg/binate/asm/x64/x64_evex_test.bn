package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// EVEX's support (x64_evex.bn): the rounding operand, and the compressed displacement as clang
// encodes a ZMM operand's (n 64) and a dword broadcast's (n 4): a multiple of n that fits 8 bits
// once divided, else 32 bits; RBP's 0; a register or [rip + x] as ever.

func TestRound() testing.TestResult {
	var r Operand = Round(3)
	if r.Kind != OP_ROUND || r.Imm != 3 || Round(4).Imm != 4 || IsMem(r) { return fail("Round") }
	return ""
}

func TestEmitModRMN() testing.TestResult {
	var a @asm.Assembler = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 64, 0), 0, 64)
	if !emitsExactly(a, "40 01") { return fail("[rax + 64], n 64") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 128, 0), 0, 64)
	if !emitsExactly(a, "40 02") { return fail("[rax + 128], n 64") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 32, 0), 0, 64)
	if !emitsExactly(a, "80 20 00 00 00") { return fail("[rax + 32], n 64: not a multiple") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 63, 0), 0, 64)
	if !emitsExactly(a, "80 3f 00 00 00") { return fail("[rax + 63], n 64") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, -8192, 0), 0, 64)
	if !emitsExactly(a, "40 80") { return fail("[rax - 8192], n 64") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 8192, 0), 0, 64)
	if !emitsExactly(a, "80 00 20 00 00") { return fail("[rax + 8192], n 64: past 8 bits") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 64, 0), 0, 4)
	if !emitsExactly(a, "40 10") { return fail("[rax + 64], n 4") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RBP, 0, 0), 0, 64)
	if !emitsExactly(a, "45 00") { return fail("[rbp], n 64") }
	a = newAsm()
	EmitModRMN(a, 0, MemIdx(R8, R9, 4, 64, 0), 0, 64)
	if !emitsExactly(a, "44 88 01") { return fail("[r8 + r9*4 + 64], n 64") }
	a = newAsm()
	EmitModRMN(a, 2, Reg(RCX, SZ64), 0, 64)
	if !emitsExactly(a, "d1") { return fail("a register") }
	a = newAsm()
	EmitModRMN(a, 0, MemVsib(RAX, 2, 4, 0, 0, SZ128), 0, 4)
	if !a.HasError { return fail("a vector index") }
	a = newAsm()
	EmitModRMN(a, 0, Mem(RAX, 64, 0), 0, 0)
	if !a.HasError { return fail("n 0") }
	return ""
}
