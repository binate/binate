package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// The encoding support pkg/binate/asm/x64/sse builds its instructions with; see x64.bni.

// EmitRex emits a REX prefix; see x64.bni.
func EmitRex(a @asm.Assembler, w bool, r int, x int, b int) { emitRex(a, w, r, x, b) }

// EmitModRM emits register or memory operand rm's ModR/M and what follows it; see x64.bni.
func EmitModRM(a @asm.Assembler, regField int, rm Operand) { emitModRM(a, regField, rm) }

// EmitModRMImm is EmitModRM before an immBytes-byte immediate; see x64.bni.
func EmitModRMImm(a @asm.Assembler, regField int, rm Operand, immBytes int) {
	emitModRMImm(a, regField, rm, immBytes)
}

// IsMem reports whether op is a memory operand; see x64.bni.
func IsMem(op Operand) bool { return isMem(op) }

// OperandError sets an operand error for mnem; see x64.bni.
func OperandError(a @asm.Assembler, mnem *[]readonly char, problem *[]readonly char) {
	setOperandError(a, mnem, problem)
}

// KindsError sets the unsupported-operand-kinds error for mnem; see x64.bni.
func KindsError(a @asm.Assembler, mnem *[]readonly char) { setKindsError(a, mnem) }

// Imm8Ok reports whether v fits a fixed imm8 field, else sets its error; see x64.bni.
func Imm8Ok(a @asm.Assembler, mnem *[]readonly char, field *[]readonly char, v int) bool {
	if immFits(cast(int64, v), SZ8) { return true }
	setImm8RangeError(a, mnem, field)
	return false
}
