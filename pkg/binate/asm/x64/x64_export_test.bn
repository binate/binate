package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The encoding support pkg/binate/asm/x64/sse uses: a REX from registers past 7 (none when all are
// clear: `EmitRex(false, 0, 0, 0)`; W and R: 4C; X and B: 43), a register's ModR/M (`/1, rdx` CA)
// and a memory operand's (`/2, [r12 + 8]` 54 24 08), a `[rip + x]` before a 1-byte immediate (`/7`
// 3D, its addend -1), IsMem, the imm8 range, and the errors' text.
func TestExportedEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	EmitRex(a, false, 0, 0, 0)
	EmitRex(a, true, 9, 0, 0)
	EmitRex(a, false, 0, 10, 8)
	EmitModRM(a, 1, Reg(RDX, SZ64))
	EmitModRM(a, 2, Mem(R12, 8, SZ64))
	if !emitsExactly(a, "4c 43 ca 54 24 08") { return fail("EmitRex / EmitModRM") }
	a = newAsm()
	EmitModRMImm(a, 7, RipLabel("x"), 1)
	if !emitsExactly(a, "3d 00 00 00 00") || a.Sections[0].NumFixups != 1 ||
			a.Sections[0].Fixups[0].Addend != -1 {
		return fail("EmitModRMImm")
	}
	if !IsMem(Mem(RAX, 0, 0)) || !IsMem(RipLabel("x")) || IsMem(Reg(RAX, SZ64)) || IsMem(Imm(1)) ||
			IsMem(RipGotLabel("x")) {
		return fail("IsMem")
	}
	a = newAsm()
	OperandError(a, "movx", "no such form")
	if !msgHasPrefix(a.ErrorMsg, "x64: movx: no such form") { return fail("OperandError") }
	a = newAsm()
	KindsError(a, "movx")
	if !msgHasPrefix(a.ErrorMsg, "x64: movx: unsupported operand kinds") { return fail("KindsError") }
	a = newAsm()
	if !Imm8Ok(a, "pshufx", "control", 255) || !Imm8Ok(a, "pshufx", "control", -128) || a.HasError {
		return fail("Imm8Ok: an imm8 in range was refused")
	}
	if Imm8Ok(a, "pshufx", "control", 256) ||
			!msgHasPrefix(a.ErrorMsg, "x64: pshufx control out of range") {
		return fail("Imm8Ok: 256")
	}
	a = newAsm()
	if Imm8Ok(a, "pshufx", "control", -129) || !a.HasError { return fail("Imm8Ok: -129") }
	return ""
}
