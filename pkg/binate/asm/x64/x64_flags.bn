package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- Flags instructions ---

// CLC: 0xF8
func Clc(a @asm.Assembler) { emit8(a, 0xF8) }

// STC: 0xF9
func Stc(a @asm.Assembler) { emit8(a, 0xF9) }

// CMC: 0xF5
func Cmc(a @asm.Assembler) { emit8(a, 0xF5) }

// CLD: 0xFC
func Cld(a @asm.Assembler) { emit8(a, 0xFC) }

// STD: 0xFD
func Std(a @asm.Assembler) { emit8(a, 0xFD) }

// LAHF: 0x9F
func Lahf(a @asm.Assembler) { emit8(a, 0x9F) }

// SAHF: 0x9E
func Sahf(a @asm.Assembler) { emit8(a, 0x9E) }

// Pushf emits PUSHF (0x9C) at size bits, 0x66 first for SZ16; see x64.bni.
func Pushf(a @asm.Assembler, size int) { emitFlagsStack(a, "pushf", 0x9C, size) }

// Popf emits POPF (0x9D) at size bits, 0x66 first for SZ16; see x64.bni.
func Popf(a @asm.Assembler, size int) { emitFlagsStack(a, "popf", 0x9D, size) }

// emitFlagsStack emits the flags push or pop mnem, opcode op, at size bits: SZ64, or SZ16 with
// the operand-size prefix; any other size is an error.
func emitFlagsStack(a @asm.Assembler, mnem *[]readonly char, op int, size int) {
	if size != SZ64 && size != SZ16 {
		setOperandError(a, mnem, "the flags are pushed and popped as 64 or 16 bits")
		return
	}
	emitSizePrefix(a, size)
	emit8(a, op)
}
