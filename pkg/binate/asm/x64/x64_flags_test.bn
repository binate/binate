package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The flags instructions against clang's bytes: CLC F8, STC F9, CMC F5, CLD FC, STD FD, LAHF 9F,
// SAHF 9E; PUSHF / POPF 9C / 9D as 64 bits, 66 9C / 66 9D as 16.
func TestFlagsInstructions() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Clc(a)
	Stc(a)
	Cmc(a)
	Cld(a)
	Std(a)
	Lahf(a)
	Sahf(a)
	Pushf(a, SZ64)
	Pushf(a, SZ16)
	Popf(a, SZ64)
	Popf(a, SZ16)
	if !emitsExactly(a, "f8 f9 f5 fc fd 9f 9e 9c 66 9c 9d 66 9d") {
		return fail("the flags instructions are not clang's")
	}
	return ""
}

// 64-bit mode has no 32-bit (or 8-bit) PUSHF / POPF.
func TestFlagsStackRejects() testing.TestResult {
	var sizes @[]int = @[]int{SZ32, SZ8, 0}
	for i := 0; i < len(sizes); i++ {
		var a @asm.Assembler = newAsm()
		Pushf(a, sizes[i])
		Popf(a, sizes[i])
		if !a.HasError || asm.HeldLen(a.Sections[0]) != 0 {
			return fail("pushf / popf took a size with no 64-bit-mode form")
		}
	}
	return ""
}
