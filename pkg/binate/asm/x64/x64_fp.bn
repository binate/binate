package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// ============================================================
// SSE2 scalar floating-point instruction encoders.
// ============================================================
//
// XMM registers (XMM0..XMM15) live in a disjoint namespace from GP
// regs (offset by 32) so an XMM accidentally passed where a GP is
// expected — or vice versa — surfaces immediately rather than
// silently encoding the wrong register.  Each encoder masks the
// XMM operand with 0xf before emitting, so the REX bit comes out
// right (R/B = 1 iff bare reg ≥ 8, i.e. XMM8..XMM15).
//
// The SSE encoders below use reg-reg ModR/M (mod=11); the scalar float
// lowering keeps values in GP spill slots and MOVQs them through an XMM
// scratch, so it never addresses memory directly from a scalar SSE op.
// The x87 encoders at the end of the file are the one exception: they
// take a memory operand, because LLVM returns the 3rd/4th float of a
// first-class-aggregate multi-return in x87 ST0/ST1 and the native x64
// pack/collect must round-trip those slots through memory (see the x64
// multi-return pack/collect in pkg/binate/native/x64).

// xmmIdx returns the bare 0..15 register number for an XMM-namespace
// value (XMM0..XMM15 = 32..47).  Accepts either form and returns the
// low 4 bits, so passing a GP register (0..15) by mistake doesn't
// produce a wrong-but-plausible encoding — the type system already
// forbids that mix, and the mask keeps the bits within range.
func xmmIdx(r int) int { return r & 0xf }

// emitSSEReg emits a generic SSE reg-reg instruction:
//
//   [prefix66?] [F2/F3?] [REX?] 0F <op2> [<op3>?] /r
//
// `pfx` is the legacy size/SSE prefix (0x66, 0xF2, 0xF3, or 0 for none).
// `w` selects REX.W (CVTSI2SD/CVTTSD2SI need it when the GP side is 64-bit).
// `op2` is the byte after 0x0F; `op3` is -1 for two-byte opcodes or a
// trailing byte (used by no current encoder, but reserved).
// `regField` is the reg-field of ModR/M (sets REX.R); `rmField` is the
// r/m field (sets REX.B).
func emitSSEReg(a @asm.Assembler, pfx int, w bool, op2 int, op3 int,
		regField int, rmField int) {
	if pfx != 0 { emit8(a, pfx) }
	emitRex(a, w, regField, 0, rmField)
	emit8(a, 0x0F)
	emit8(a, op2)
	if op3 >= 0 { emit8(a, op3) }
	emit8(a, 0xC0 | ((regField & 7) << 3) | (rmField & 7))
}

// --- MOVQ / MOVD between GP and XMM ---

// MOVQ xmm, r/m64: 66 REX.W 0F 6E /r.  reg=xmm, r/m=gp.
func Movq_gp_to_xmm(a @asm.Assembler, xmm int, gp int) {
	emitSSEReg(a, 0x66, true, 0x6E, -1, xmmIdx(xmm), gp)
}

// MOVQ r/m64, xmm: 66 REX.W 0F 7E /r.  reg=xmm, r/m=gp.
func Movq_xmm_to_gp(a @asm.Assembler, gp int, xmm int) {
	emitSSEReg(a, 0x66, true, 0x7E, -1, xmmIdx(xmm), gp)
}

// MOVD xmm, r/m32: 66 0F 6E /r (no REX.W).  Same opcode as MOVQ but
// without REX.W; the operand is the low dword.
func Movd_gp_to_xmm(a @asm.Assembler, xmm int, gp int) {
	emitSSEReg(a, 0x66, false, 0x6E, -1, xmmIdx(xmm), gp)
}

// MOVD r/m32, xmm: 66 0F 7E /r.
func Movd_xmm_to_gp(a @asm.Assembler, gp int, xmm int) {
	emitSSEReg(a, 0x66, false, 0x7E, -1, xmmIdx(xmm), gp)
}

// --- SSE eightbyte memory-image moves (SysV aggregate pass/return) ---
//
// The native x64 backend places/extracts each SSE eightbyte of a <=16-byte
// float aggregate directly to/from its data-region image in memory (the
// XMM<->stack round-trip a SysV eightbyte arg/return needs), rather than through
// a GP register.  MOVLPS moves the low 8 bytes of an XMM to/from m64 in one
// instruction and so carries ANY 8-byte SSE eightbyte — a packed 2xf32 OR a
// lone f64 — bit-for-bit (see plan-hfa-crossbackend.md, decision Q1); MOVSS
// carries a 4-byte lone-f32 eightbyte (e.g. the tail eightbyte of a 12-byte
// aggregate, where reading 8 bytes would over-run the struct).  Byte sequences
// cross-checked against `as -arch x86_64` (MOVLPS store 0F 13, load 0F 12;
// MOVSS store F3 0F 11, load F3 0F 10).

// emitSSEMem emits an SSE instruction with a MEMORY r/m operand:
//
//   [pfx?] [REX?] 0F <op2> /r <mem>
//
// `xmm` is the reg-field (sets REX.R); `mem` supplies the r/m (base/index set
// REX.X/REX.B).  Parallels emitSSEReg but with a memory operand via emitModRM.
// The r/m MUST be memory: the register form of 0F 12 / 0F 13 is a DIFFERENT
// instruction (MOVHLPS / MOVLHPS), so callers pass only Mem/MemDisp operands.
func emitSSEMem(a @asm.Assembler, pfx int, w bool, op2 int, xmm int,
		mem Operand) {
	if pfx != 0 { emit8(a, pfx) }
	var bReg int = 0
	if mem.Base >= 0 { bReg = mem.Base }
	var xReg int = 0
	if mem.Index >= 0 { xReg = mem.Index }
	emitRex(a, w, xmmIdx(xmm), xReg, bReg)
	emit8(a, 0x0F)
	emit8(a, op2)
	emitModRM(a, xmmIdx(xmm), mem)
}

// Movlps_load xmm, m64: 0F 12 /r — load the low 8 bytes of an SSE eightbyte
// (2xf32 or f64) from memory into xmm's low quadword.
func Movlps_load(a @asm.Assembler, xmm int, mem Operand) {
	emitSSEMem(a, 0, false, 0x12, xmm, mem)
}

// Movlps_store m64, xmm: 0F 13 /r — store xmm's low quadword (an 8-byte SSE
// eightbyte) to memory.
func Movlps_store(a @asm.Assembler, mem Operand, xmm int) {
	emitSSEMem(a, 0, false, 0x13, xmm, mem)
}

// Movss_load xmm, m32: F3 0F 10 /r — load a 4-byte lone-f32 eightbyte from
// memory into xmm's low dword.
func Movss_load(a @asm.Assembler, xmm int, mem Operand) {
	emitSSEMem(a, 0xF3, false, 0x10, xmm, mem)
}

// Movss_store m32, xmm: F3 0F 11 /r — store xmm's low dword (a 4-byte lone-f32
// eightbyte) to memory.
func Movss_store(a @asm.Assembler, mem Operand, xmm int) {
	emitSSEMem(a, 0xF3, false, 0x11, xmm, mem)
}

// --- Scalar double arithmetic ---

// ADDSD xmm, xmm/m64: F2 0F 58 /r.
func Addsd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x58, -1, xmmIdx(dst), xmmIdx(src))
}

// SUBSD xmm, xmm/m64: F2 0F 5C /r.
func Subsd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x5C, -1, xmmIdx(dst), xmmIdx(src))
}

// MULSD xmm, xmm/m64: F2 0F 59 /r.
func Mulsd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x59, -1, xmmIdx(dst), xmmIdx(src))
}

// DIVSD xmm, xmm/m64: F2 0F 5E /r.
func Divsd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x5E, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Scalar single (float32) arithmetic ---
//
// Same opcodes as the double forms with the F3 prefix instead of F2, so
// they round at single precision.  Used for float32 arithmetic, which must
// not be computed in double on the f32 bit pattern.

// ADDSS xmm, xmm/m32: F3 0F 58 /r.
func Addss(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x58, -1, xmmIdx(dst), xmmIdx(src))
}

// SUBSS xmm, xmm/m32: F3 0F 5C /r.
func Subss(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x5C, -1, xmmIdx(dst), xmmIdx(src))
}

// MULSS xmm, xmm/m32: F3 0F 59 /r.
func Mulss(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x59, -1, xmmIdx(dst), xmmIdx(src))
}

// DIVSS xmm, xmm/m32: F3 0F 5E /r.
func Divss(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x5E, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Conversions ---

// CVTSI2SD xmm, r/m64: F2 REX.W 0F 2A /r.  REX.W=1 forces the 64-bit
// integer form (without REX.W the source is r/m32).
func Cvtsi2sd(a @asm.Assembler, xmm int, gp int) {
	emitSSEReg(a, 0xF2, true, 0x2A, -1, xmmIdx(xmm), gp)
}

// CVTTSD2SI r64, xmm/m64: F2 REX.W 0F 2C /r (truncating form).
// REX.W=1 selects the 64-bit dst (CVTTSD2SI r32 would drop REX.W).
func Cvttsd2si(a @asm.Assembler, gp int, xmm int) {
	emitSSEReg(a, 0xF2, true, 0x2C, -1, gp, xmmIdx(xmm))
}

// CVTSS2SD xmm, xmm/m32: F3 0F 5A /r — widen float32 to float64.
func Cvtss2sd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x5A, -1, xmmIdx(dst), xmmIdx(src))
}

// CVTSD2SS xmm, xmm/m64: F2 0F 5A /r — narrow float64 to float32.
func Cvtsd2ss(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x5A, -1, xmmIdx(dst), xmmIdx(src))
}

// MOVAPD xmm, xmm/m128: 66 0F 28 /r — packed-double move (used here
// purely as an XMM-to-XMM copy of all 128 bits).
func Movapd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x28, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Scalar double compare ---

// UCOMISD xmm1, xmm2/m64: 66 0F 2E /r — unordered scalar-double
// compare.  Sets EFLAGS: CF=1 iff xmm1 < xmm2 OR unordered;
// ZF=1 iff xmm1 == xmm2 OR unordered; PF=1 iff unordered.  Caller
// reads the flags with SETcc + a parity gate to enforce Binate's
// ordered float-compare semantics (every compare returns false
// for NaN, including !=) — see pkg/binate/native/x64/x64_float.bn::
// emitFloatCompare.
func Ucomisd(a @asm.Assembler, lhs int, rhs int) {
	emitSSEReg(a, 0x66, false, 0x2E, -1, xmmIdx(lhs), xmmIdx(rhs))
}

// UCOMISS xmm, xmm/m32: 0F 2E /r (no mandatory prefix) — the single-
// precision sibling of UCOMISD, for float32 comparison.
func Ucomiss(a @asm.Assembler, lhs int, rhs int) {
	emitSSEReg(a, 0, false, 0x2E, -1, xmmIdx(lhs), xmmIdx(rhs))
}

// --- x87 floating-point load/store (multi-return overflow slots) ---
//
// These four are the ONLY x87 instructions the backend emits.  A
// first-class-aggregate multi-return with more than 2 float fields is
// returned by LLVM with the 3rd/4th float in x87 ST0/ST1 (XMM0/XMM1 hold
// the first two); the native x64 pack/collect uses FLD to push a float
// from the tuple image onto the x87 stack (callee side) and FSTP to pop
// ST0 back to the result slot (caller side).  The 32-bit (s) vs 64-bit
// (l) form is selected by the opcode (D9 vs DD), not REX.W, so emitX87Mem
// passes w=false; the /digit selects load (0) vs store-and-pop (3).  Byte
// sequences cross-checked against `clang -S` of the matching .ll.

// emitX87Mem emits a single-opcode x87 instruction with a memory operand:
// [REX?] <opcode> /ext <mem>.  REX appears only when the base/index reg is
// R8..R15 (REX.B / REX.X); ext is 0 or 3 so REX.R never sets.
func emitX87Mem(a @asm.Assembler, opcode int, ext int, mem Operand) {
	var bReg int = 0
	if mem.Base >= 0 { bReg = mem.Base }
	var xReg int = 0
	if mem.Index >= 0 { xReg = mem.Index }
	emitRex(a, false, 0, xReg, bReg)
	emit8(a, opcode)
	emitModRM(a, ext, mem)
}

// FLDS m32: D9 /0 — push a 32-bit float from memory onto the x87 stack (ST0).
func Flds(a @asm.Assembler, mem Operand) { emitX87Mem(a, 0xD9, 0, mem) }

// FLDL m64: DD /0 — push a 64-bit float from memory onto the x87 stack (ST0).
func Fldl(a @asm.Assembler, mem Operand) { emitX87Mem(a, 0xDD, 0, mem) }

// FSTPS m32: D9 /3 — pop ST0, storing it to memory as a 32-bit float.
func Fstps(a @asm.Assembler, mem Operand) { emitX87Mem(a, 0xD9, 3, mem) }

// FSTPL m64: DD /3 — pop ST0, storing it to memory as a 64-bit float.
func Fstpl(a @asm.Assembler, mem Operand) { emitX87Mem(a, 0xDD, 3, mem) }
