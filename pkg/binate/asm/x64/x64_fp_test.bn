package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_fp.bn — SSE2 scalar floating-point encoders.
// Byte sequences hand-verified against Intel SDM Vol. 2.

// --- MOVQ / MOVD ---

func TestMovqGpToXmm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVQ XMM0, RAX = 66 REX.W 0F 6E C0
	Movq_gp_to_xmm(a, XMM0, RAX)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0x66
	expected[1] = 0x48
	expected[2] = 0x0F
	expected[3] = 0x6E
	expected[4] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("MOVQ XMM0, RAX encoding wrong")
	}
	return ""
}

func TestMovqGpToXmmHigh() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVQ XMM15, R15 = 66 REX.WRB 0F 6E FF
	// REX = 0x48 | 0x04 (R) | 0x01 (B) = 0x4D
	Movq_gp_to_xmm(a, XMM15, R15)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0x66
	expected[1] = 0x4D
	expected[2] = 0x0F
	expected[3] = 0x6E
	expected[4] = 0xFF
	if !checkBytes(s, 0, expected) {
		return fail("MOVQ XMM15, R15 encoding wrong")
	}
	return ""
}

func TestMovqXmmToGp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVQ RAX, XMM0 = 66 REX.W 0F 7E C0
	Movq_xmm_to_gp(a, RAX, XMM0)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0x66
	expected[1] = 0x48
	expected[2] = 0x0F
	expected[3] = 0x7E
	expected[4] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("MOVQ RAX, XMM0 encoding wrong")
	}
	return ""
}

func TestMovdGpToXmm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVD XMM1, EAX = 66 0F 6E C8 (no REX.W — 32-bit form)
	// ModR/M: mod=11, reg=XMM1(=1), rm=EAX(=0) → 11 001 000 = 0xC8
	Movd_gp_to_xmm(a, XMM1, RAX)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x66
	expected[1] = 0x0F
	expected[2] = 0x6E
	expected[3] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOVD XMM1, EAX encoding wrong")
	}
	return ""
}

func TestMovdXmmToGp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVD EAX, XMM1 = 66 0F 7E C8 (no REX.W — store low dword)
	// ModR/M: mod=11, reg=XMM1(=1), rm=EAX(=0) → 11 001 000 = 0xC8
	Movd_xmm_to_gp(a, RAX, XMM1)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x66
	expected[1] = 0x0F
	expected[2] = 0x7E
	expected[3] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOVD EAX, XMM1 encoding wrong")
	}
	return ""
}

func TestMovqXmmToGpHigh() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVQ R15, XMM15 = 66 REX.WRB 0F 7E FF — verifies the reg/rm
	// ordering is xmm=reg-field (REX.R) / gp=rm-field (REX.B), so
	// the GP-side REX.B still picks up the high GP when GP is the
	// human-readable destination.
	Movq_xmm_to_gp(a, R15, XMM15)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0x66
	expected[1] = 0x4D
	expected[2] = 0x0F
	expected[3] = 0x7E
	expected[4] = 0xFF
	if !checkBytes(s, 0, expected) {
		return fail("MOVQ R15, XMM15 encoding wrong")
	}
	return ""
}

