	Addss(a, XMM0, XMM1)
	var e @[]int = make_slice(int, 4)
	e[0] = 0xF3
	e[1] = 0x0F
	e[2] = 0x58
	e[3] = 0xC1
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("ADDSS XMM0, XMM1 encoding wrong")
	}
	return ""
}

