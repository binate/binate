func TestCvtsi2sd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CVTSI2SD XMM0, RAX = F2 REX.W 0F 2A C0
	Cvtsi2sd(a, XMM0, RAX)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0xF2
	expected[1] = 0x48
	expected[2] = 0x0F
	expected[3] = 0x2A
	expected[4] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("CVTSI2SD XMM0, RAX encoding wrong")
	}
	return ""
}

