func TestAddsd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADDSD XMM0, XMM1 = F2 0F 58 C1
	Addsd(a, XMM0, XMM1)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0xF2
	expected[1] = 0x0F
	expected[2] = 0x58
	expected[3] = 0xC1
	if !checkBytes(s, 0, expected) {
		return fail("ADDSD XMM0, XMM1 encoding wrong")
	}
	return ""
}

