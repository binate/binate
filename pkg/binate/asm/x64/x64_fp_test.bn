func TestAddsdHighReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADDSD XMM8, XMM9 = F2 REX.RB 0F 58 C1
	// REX = 0x40 | 0x04 (R for XMM8 dst) | 0x01 (B for XMM9 src) = 0x45
	Addsd(a, XMM8, XMM9)
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0xF2
	expected[1] = 0x45
	expected[2] = 0x0F
	expected[3] = 0x58
	expected[4] = 0xC1
	if !checkBytes(s, 0, expected) {
		return fail("ADDSD XMM8, XMM9 encoding wrong")
	}
	return ""
}

