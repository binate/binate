package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// (newAsm() / checkBytes() / Reg / SZ64 / RAX / R10 live in the sibling
// x64_data_test.bn / x64_test.bn — same package.)

// MovGotPcRel emits `mov rd, [rip + sym@GOTPCREL]` — REX.W + 0x8B + ModRM(mod=00
// reg=dst3 rm=101) + rel32 placeholder — with a FIX_GOTPCREL fixup.  Same shape
// as LeaRipLabel but the MOV opcode (0x8B) rather than LEA (0x8D).  For RAX:
// 48 8B 05 00 00 00 00 (7 bytes).
func TestMovGotPcRelRax() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovGotPcRel(a, Reg(RAX, SZ64), "environ")
	var s @asm.Section = a.Sections[0]
	if s.Len != 7 {
		return fail("MovGotPcRel RAX should emit 7 bytes")
	}
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48 // REX.W
	expected[1] = 0x8B // MOV r, r/m (a LOAD) — NOT 0x8D (LEA)
	expected[2] = 0x05 // ModRM mod=00 reg=000 rm=101 (RIP-relative)
	expected[3] = 0
	expected[4] = 0
	expected[5] = 0
	expected[6] = 0
	if !checkBytes(s, 0, expected) {
		return fail("mov RAX, [rip+environ@GOTPCREL] encoding wrong")
	}
	return ""
}

// The extended-register REX is right: mov r10, [rip + sym@GOTPCREL] is
// REX.WR (0x4C) + 0x8B + ModRM(reg=010 rm=101 = 0x15).
func TestMovGotPcRelR10() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovGotPcRel(a, Reg(R10, SZ64), "environ")
	var s @asm.Section = a.Sections[0]
	if s.Len != 7 { return fail("MovGotPcRel R10 should emit 7 bytes") }
	if s.Data[0] != cast(uint8, 0x4C) {
		return fail("byte 0 should be REX.WR (0x4C) for R10 dst")
	}
	if s.Data[1] != cast(uint8, 0x8B) {
		return fail("byte 1 should be MOV opcode (0x8B)")
	}
	if s.Data[2] != cast(uint8, 0x15) {
		return fail("byte 2 should be ModRM (reg=010, rm=101)")
	}
	return ""
}

// Load-bearing (the indirection footgun): a LEA (0x8D) would put the GOT
// slot's OWN address in the register, not the symbol's address.  MovGotPcRel
// must emit MOV (0x8B, a load through the slot).
func TestMovGotPcRelIsLoadNotLea() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovGotPcRel(a, Reg(RAX, SZ64), "environ")
	var s @asm.Section = a.Sections[0]
	if s.Data[1] != cast(uint8, 0x8B) {
		return fail("MovGotPcRel must emit MOV (0x8B, a load), not LEA (0x8D)")
	}
	return ""
}

// MovGotPcRel must register FIX_GOTPCREL so the writers emit the GOT-load reloc
// (ELF R_X86_64_REX_GOTPCRELX / Mach-O X86_64_RELOC_GOT_LOAD) against the
// external symbol — a plain FIX_REL32/REL32_LEA would reference the datum
// directly, which a PIE link rejects for a cross-DSO symbol.
func TestMovGotPcRelUsesFixGotPcRel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovGotPcRel(a, Reg(RAX, SZ64), "environ")
	var s @asm.Section = a.Sections[0]
	if s.NumFixups < 1 { return fail("MovGotPcRel must register a fixup") }
	if s.Fixups[0].Kind != FIX_GOTPCREL {
		return fail("MovGotPcRel must use FIX_GOTPCREL")
	}
	return ""
}
