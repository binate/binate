package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The high-byte registers AH, CH, DH and BH against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, Intel syntax): in each encoder taking an 8-bit register, with no
// REX prefix; beside one an error, as clang's "can't encode 'ah'"; and register numbers no
// encoding field takes, AH..BH at another size among them, rejected.

// hbCase appends name to e when a does not hold exactly hex's bytes.
func hbCase(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emitsExactly(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), "; ")
}

// hbError appends name to e when a recorded no error.
func hbError(e @[]char, a @asm.Assembler, name *[]readonly char) @[]char {
	if a.HasError { return e }
	return buf.Concat(buf.Concat(e, name), ": no error; ")
}

// h8 returns the 8-bit register operand of r (RAX..R15 or AH..BH).
func h8(r int) Operand { return Reg(r, SZ8) }

// The moves and extensions, with registers, an immediate, memory with an index, and RIP-relative
// and absolute memory.
func TestHighByteMoves() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, h8(AH), h8(RAX))
	Mov(a, h8(RAX), h8(AH))
	Mov(a, h8(BH), h8(CH))
	Mov(a, h8(DH), Imm(5))
	Mov(a, h8(AH), Mem(RAX, 0, SZ8))
	Mov(a, MemIdx(RBX, RCX, 2, 8, SZ8), h8(DH))
	Movzx(a, Reg(RAX, SZ32), h8(AH))
	Movzx(a, Reg(RAX, SZ16), h8(BH))
	Movzx(a, Reg(RSI, SZ32), h8(CH))
	Movsx(a, Reg(RCX, SZ32), h8(DH))
	Mov(a, h8(AH), MemAbs(0x1000, SZ8))
	var e @[]char = hbCase("", a, "mov / movzx / movsx",
			"88c4 88e0 88ef b605 8a20 88744b08 0fb6c4 660fb6c7 0fb6f5 0fbece 8a242500100000")
	a = newAsm()
	Mov(a, h8(AH), RipLabel("x"))
	e = hbCase(e, a, "mov ah, byte ptr [rip + x]", "8a2500000000")
	return e
}

// The ALU group and TEST, with registers, immediates and memory on either side.
func TestHighByteArithmetic() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, h8(AH), h8(RAX))
	Add(a, h8(AH), Imm(1))
	Add(a, h8(AH), Mem(RAX, 0, SZ8))
	Add(a, Mem(RAX, 0, SZ8), h8(AH))
	Adc(a, h8(BH), h8(CH))
	Sub(a, h8(DH), h8(AH))
	And(a, h8(AH), Imm(0x7F))
	Or(a, h8(CH), h8(BH))
	Xor(a, h8(AH), h8(AH))
	Cmp(a, h8(AH), Imm(5))
	Cmp(a, h8(AH), h8(RDX))
	Test(a, h8(AH), Imm(1))
	Test(a, h8(AH), h8(RAX))
	Test(a, Mem(RAX, 0, SZ8), h8(AH))
	return hbCase("", a, "add .. test",
			"00c4 80c401 0220 0020 10ef 28e6 80e47f 08fd 30e4 80fc05 38d4 f6c401 84c4 8420")
}

// The one-operand group, shifts and rotates, SETcc, XCHG, CMPXCHG and XADD.
func TestHighByteOthers() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Inc(a, h8(AH))
	Dec(a, h8(BH))
	Neg(a, h8(CH))
	Not(a, h8(DH))
	Mul1(a, h8(AH))
	Imul1(a, h8(BH))
	Div(a, h8(CH))
	Idiv(a, h8(DH))
	var e @[]char = hbCase("", a, "inc .. idiv", "fec4 fecf f6dd f6d6 f6e4 f6ef f6f5 f6fe")
	a = newAsm()
	Shl(a, h8(AH), Imm(1))
	Shr(a, h8(AH), h8(RCX))
	Sar(a, h8(BH), Imm(3))
	Rol(a, h8(CH), Imm(1))
	Ror(a, h8(DH), h8(RCX))
	Rcl(a, h8(AH), Imm(2))
	Rcr(a, h8(AH), Imm(1))
	Setcc(a, CC_E, h8(AH))
	Setcc(a, CC_NE, h8(BH))
	e = hbCase(e, a, "shl .. setne", "d0e4 d2ec c0ff03 d0c5 d2ce c0d402 d0dc 0f94c4 0f95c7")
	a = newAsm()
	Xchg(a, h8(AH), h8(RAX))
	Xchg(a, h8(RAX), h8(AH))
	Xchg(a, Mem(RAX, 0, SZ8), h8(AH))
	Xchg(a, h8(AH), h8(AH))
	Cmpxchg(a, Mem(RAX, 0, SZ8), h8(AH))
	Xadd(a, Mem(RAX, 0, SZ8), h8(BH))
	e = hbCase(e, a, "xchg .. xadd", "86e0 86c4 8620 86e4 0fb020 0fc038")
	if !IsHighByte(h8(AH)) || !IsHighByte(h8(BH)) || IsHighByte(h8(RSP)) || IsHighByte(Reg(AH, SZ32)) {
		e = buf.Concat(e, "IsHighByte; ")
	}
	return e
}

// AH..BH beside a REX prefix: R8..R15 (in either field or a memory operand's base or index),
// SPL..DIL, a 64-bit operand.
func TestHighByteBesideRex() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, h8(AH), h8(R8))
	e = hbError(e, a, "mov ah, r8b")
	a = newAsm()
	Mov(a, h8(R9), h8(BH))
	e = hbError(e, a, "mov r9b, bh")
	a = newAsm()
	Mov(a, h8(AH), h8(RSI))
	e = hbError(e, a, "mov ah, sil")
	a = newAsm()
	Mov(a, h8(RSP), h8(AH))
	e = hbError(e, a, "mov spl, ah")
	a = newAsm()
	Mov(a, h8(AH), Mem(R8, 0, SZ8))
	e = hbError(e, a, "mov ah, byte ptr [r8]")
	a = newAsm()
	Mov(a, h8(AH), MemIdx(RAX, R9, 1, 0, SZ8))
	e = hbError(e, a, "mov ah, byte ptr [rax + r9]")
	a = newAsm()
	Movzx(a, Reg(RAX, SZ64), h8(AH))
	e = hbError(e, a, "movzx rax, ah")
	a = newAsm()
	Movzx(a, Reg(R8, SZ32), h8(AH))
	e = hbError(e, a, "movzx r8d, ah")
	a = newAsm()
	Xchg(a, h8(AH), h8(RSI))
	e = hbError(e, a, "xchg ah, sil")
	a = newAsm()
	Add(a, h8(R9), h8(AH))
	e = hbError(e, a, "add r9b, ah")
	a = newAsm()
	Test(a, h8(DH), h8(R8))
	e = hbError(e, a, "test dh, r8b")
	return e
}

// Register numbers no encoding field takes — AH..BH at 16, 32 or 64 bits (Reg makes them none),
// numbers past R15, negative ones — in each encoder family, and in JmpReg / CallReg AH..BH too.
func TestRegisterNumbersRejected() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ32), Reg(AH, SZ32))
	e = hbError(e, a, "mov eax, <ah at 32>")
	a = newAsm()
	Add(a, Reg(AH, SZ16), Imm(1))
	e = hbError(e, a, "add <ah at 16>, 1")
	a = newAsm()
	Push(a, Reg(AH, SZ64))
	e = hbError(e, a, "push <ah at 64>")
	a = newAsm()
	Pop(a, Reg(99, SZ64))
	e = hbError(e, a, "pop <99>")
	a = newAsm()
	Inc(a, Reg(16, SZ32))
	e = hbError(e, a, "inc <16>")
	a = newAsm()
	Mov(a, Reg(-2, SZ64), Imm(1))
	e = hbError(e, a, "mov <-2>, 1")
	a = newAsm()
	MovAbs(a, Reg(99, SZ64), Imm64(1))
	e = hbError(e, a, "movabs <99>, 1")
	a = newAsm()
	Setcc(a, CC_E, Reg(99, SZ8))
	e = hbError(e, a, "sete <99>")
	a = newAsm()
	Shl(a, Reg(99, SZ32), Imm(1))
	e = hbError(e, a, "shl <99>, 1")
	a = newAsm()
	Bswap(a, Reg(99, SZ32))
	e = hbError(e, a, "bswap <99>")
	a = newAsm()
	Movzx(a, Reg(99, SZ32), h8(RAX))
	e = hbError(e, a, "movzx <99>, al")
	a = newAsm()
	Imul2(a, Reg(99, SZ32), Reg(RAX, SZ32))
	e = hbError(e, a, "imul <99>, eax")
	a = newAsm()
	Cmovcc(a, CC_E, Reg(RAX, SZ32), Reg(99, SZ32))
	e = hbError(e, a, "cmove eax, <99>")
	a = newAsm()
	Lea(a, Reg(99, SZ64), Mem(RAX, 0, 0))
	e = hbError(e, a, "lea <99>, [rax]")
	a = newAsm()
	Bt(a, Reg(99, SZ32), Imm(1))
	e = hbError(e, a, "bt <99>, 1")
	a = newAsm()
	Bsf(a, Reg(RAX, SZ32), Reg(99, SZ32))
	e = hbError(e, a, "bsf eax, <99>")
	a = newAsm()
	Xchg(a, Reg(99, SZ32), Reg(RAX, SZ32))
	e = hbError(e, a, "xchg <99>, eax")
	a = newAsm()
	Test(a, Reg(99, SZ32), Imm(1))
	e = hbError(e, a, "test <99>, 1")
	a = newAsm()
	JmpReg(a, AH)
	if !rejected(a) { e = buf.Concat(e, "jmp ah: not rejected; ") }
	a = newAsm()
	CallReg(a, 99)
	if !rejected(a) { e = buf.Concat(e, "call <99>: not rejected; ") }
	a = newAsm()
	JmpReg(a, R15)
	CallReg(a, RAX)
	e = hbCase(e, a, "jmp r15 / call rax", "41ffe7 ffd0")
	return e
}

// The checks run before an encoder emits anything: AH at another size set on an operand built as
// 8-bit (not through Reg), a bad register beside a 16-bit operand's 0x66; and a memory operand's
// AH base is that operand's error, not a REX conflict.
func TestRegisterChecksEmitNothing() testing.TestResult {
	var e @[]char = ""
	var op Operand = Reg(AH, SZ8)
	op.Size = SZ32
	var a @asm.Assembler = newAsm()
	Mov(a, op, Imm(1))
	if !rejected(a) { e = buf.Concat(e, "mov <ah at 32>, 1: not rejected; ") }
	a = newAsm()
	Add(a, Reg(RAX, SZ32), op)
	if !rejected(a) { e = buf.Concat(e, "add eax, <ah at 32>: not rejected; ") }
	a = newAsm()
	Push(a, Reg(99, SZ16))
	if !rejected(a) { e = buf.Concat(e, "push <99 at 16>: not rejected; ") }
	a = newAsm()
	Pop(a, Reg(AH, SZ16))
	if !rejected(a) { e = buf.Concat(e, "pop <ah at 16>: not rejected; ") }
	a = newAsm()
	Shl(a, op, Imm(1))
	if !rejected(a) { e = buf.Concat(e, "shl <ah at 32>, 1: not rejected; ") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), Mem(AH, 0, SZ64))
	if !a.HasError || !hbHas(a.ErrorMsg, "base or index") {
		e = buf.Concat(e, "mov rax, qword ptr [<ah>]: not the base's error; ")
	}
	return e
}

// hbHas reports whether s holds sub.
func hbHas(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		var j int = 0
		for j < len(sub) && s[i + j] == sub[j] { j++ }
		if j == len(sub) { return true }
	}
	return false
}
