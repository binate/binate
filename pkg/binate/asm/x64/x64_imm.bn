package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Immediate range checking and width-aware immediate encoding, shared by the
// encoders whose immediate field is sized by the operation width: the ALU ops
// (emitALU), TEST, MOV, IMUL r, r/m, imm and PUSH.
//
// An immediate is accepted when it is representable at the operation width as
// either a signed or an unsigned number: -128..255 for 8 bits, -32768..65535
// for 16 bits, -2^31..2^32-1 for 32 bits.  A 64-bit operation carries an imm32
// that the CPU sign-extends to 64 bits, so there only -2^31..2^31-1 denotes the
// intended value; a wider constant must be materialized in a register first
// (MOV r64, imm64).  An encoder given an out-of-range immediate reports it via
// setImmRangeError and emits nothing, rather than silently truncating it.

// immFits reports whether v is an encodable immediate for an operation of the
// given width (SZ8 / SZ16 / SZ32 / SZ64).
func immFits(v int64, size int) bool {
	if size == SZ8 { return v >= -128 && v <= 255 }
	if size == SZ16 { return v >= -32768 && v <= 65535 }
	if size == SZ64 { return v >= -2147483648 && v <= 2147483647 }
	return v >= -2147483648 && v <= 4294967295
}

// immAtWidth returns the value the CPU sees for immediate v in an operation of
// the given width: v truncated to that width and read back as a signed number
// (v must satisfy immFits).  Choosing the sign-extended imm8 form on this value
// rather than on v itself is what lets e.g. a 32-bit `and ecx, 0xFFFFFFF0`
// (-16 at 32 bits) take the 3-byte "83 /4 ib" form.
func immAtWidth(v int64, size int) int64 {
	if size == SZ8 {
		var b int64 = v & 0xFF
		if b >= 0x80 { b = b - 0x100 }
		return b
	}
	if size == SZ16 {
		var h int64 = v & 0xFFFF
		if h >= 0x8000 { h = h - 0x10000 }
		return h
	}
	if size == SZ64 { return v }
	var d int64 = v & 0xFFFFFFFF
	if d >= 0x80000000 { d = d - 0x100000000 }
	return d
}

// immFitsI8 reports whether a width-normalized immediate (immAtWidth) fits the
// sign-extended imm8 field of the short forms ("83 /n ib", "6B /r ib", "6A ib").
func immFitsI8(w int64) bool { return w >= -128 && w <= 127 }

// emitImmW emits a width-normalized immediate (immAtWidth) into the
// operation-width immediate field: imm8 for SZ8, imm16 for SZ16 (the 0x66-
// prefixed forms take a 2-byte immediate), imm32 otherwise (sign-extended by
// the CPU for a 64-bit operation).
func emitImmW(a @asm.Assembler, w int64, size int) {
	if size == SZ8 {
		emit8(a, cast(int, w))
	} else if size == SZ16 {
		a.EmitUint16(cast(uint16, w & 0xFFFF))
	} else {
		emit32le(a, cast(int, w))
	}
}

// immRangeText describes the accepted immediate range for an operation of the
// given width, for setImmRangeError.
func immRangeText(size int) *[]readonly char {
	if size == SZ8 {
		return " immediate out of range for an 8-bit operation (accepts -128..255)"
	}
	if size == SZ16 {
		return " immediate out of range for a 16-bit operation (accepts -32768..65535)"
	}
	if size == SZ64 {
		return " immediate out of range for a 64-bit operation (the sign-extended imm32 "
				"accepts -2^31..2^31-1; materialize a wider value in a register)"
	}
	return " immediate out of range for a 32-bit operation (accepts -2^31..2^32-1)"
}

// setImmRangeError records an assembler error for instruction mnem given an
// immediate that does not fit an operation of the given width.
func setImmRangeError(a @asm.Assembler, mnem *[]readonly char, size int) {
	var what @[]char = buf.Concat("x64: ", mnem)
	a.SetError(buf.Concat(what, immRangeText(size)))
}

// Some immediates are a fixed imm8 regardless of the operation width: a shift
// count, an INT vector, a shuffle control.  Like clang, these accept -128..255
// (immFits at SZ8; a negative value is its two's-complement byte).

// setImm8RangeError records the assembler error "x64: <mnem> <field> out of
// range" for a fixed imm8 field outside -128..255.
func setImm8RangeError(a @asm.Assembler, mnem *[]readonly char, field *[]readonly char) {
	var head @[]char = buf.Concat("x64: ", mnem)
	var withSep @[]char = buf.Concat(head, " ")
	var named @[]char = buf.Concat(withSep, field)
	a.SetError(buf.Concat(named, " out of range (an imm8 accepts -128..255)"))
}
