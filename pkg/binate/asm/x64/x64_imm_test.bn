package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_imm.bn — the per-width immediate range, the width-view
// used for the imm8 choice, the width-sized immediate field, and the
// out-of-range error messages — plus the fixed imm8 fields shared by
// encoders in several files (shift count, INT vector, shuffle control)
// and the CMPPS / CMPPD predicate.  Width-sized immediates are tested at
// the encoder level alongside each encoder.

func TestImmFitsBounds() testing.TestResult {
	if !immFits(-128, SZ8) || !immFits(255, SZ8) { return fail("SZ8 bounds -128/255 must fit") }
	if immFits(-129, SZ8) || immFits(256, SZ8) { return fail("SZ8 -129/256 must not fit") }
	if !immFits(-32768, SZ16) || !immFits(65535, SZ16) {
		return fail("SZ16 bounds -32768/65535 must fit")
	}
	if immFits(-32769, SZ16) || immFits(65536, SZ16) {
		return fail("SZ16 -32769/65536 must not fit")
	}
	if !immFits(-2147483647 - 1, SZ32) || !immFits(0xFFFFFFFF, SZ32) {
		return fail("SZ32 bounds -2^31/2^32-1 must fit")
	}
	if immFits(-2147483647 - 2, SZ32) || immFits(0x100000000, SZ32) {
		return fail("SZ32 -2^31-1/2^32 must not fit")
	}
	if !immFits(-2147483647 - 1, SZ64) || !immFits(0x7FFFFFFF, SZ64) {
		return fail("SZ64 bounds -2^31/2^31-1 must fit")
	}
	// A 64-bit operation sign-extends its imm32: 0x80000000 would become
	// 0xFFFFFFFF80000000, so it is out of range, as is anything wider.
	if immFits(-2147483647 - 2, SZ64) || immFits(0x80000000, SZ64) {
		return fail("SZ64 -2^31-1/2^31 must not fit")
	}
	if immFits(0x100000000, SZ64) { return fail("SZ64 2^32 must not fit") }
	return ""
}

func TestImmAtWidth() testing.TestResult {
	if immAtWidth(255, SZ8) != -1 { return fail("255 at 8 bits is -1") }
	if immAtWidth(-128, SZ8) != -128 { return fail("-128 at 8 bits is -128") }
	if immAtWidth(0x7F, SZ8) != 127 { return fail("0x7F at 8 bits is 127") }
	if immAtWidth(0xFFFF, SZ16) != -1 { return fail("0xFFFF at 16 bits is -1") }
	if immAtWidth(0xFF80, SZ16) != -128 { return fail("0xFF80 at 16 bits is -128") }
	if immAtWidth(0x8000, SZ16) != -32768 { return fail("0x8000 at 16 bits is -32768") }
	if immAtWidth(0x1234, SZ16) != 0x1234 { return fail("0x1234 at 16 bits is 0x1234") }
	if immAtWidth(0xFFFFFFF0, SZ32) != -16 { return fail("0xFFFFFFF0 at 32 bits is -16") }
	if immAtWidth(0x80000000, SZ32) != -2147483647 - 1 {
		return fail("0x80000000 at 32 bits is -2^31")
	}
	if immAtWidth(-5, SZ32) != -5 { return fail("-5 at 32 bits is -5") }
	if immAtWidth(0x7FFFFFFF, SZ64) != 0x7FFFFFFF { return fail("0x7FFFFFFF at 64 bits") }
	if immAtWidth(-2147483647 - 1, SZ64) != -2147483647 - 1 { return fail("-2^31 at 64 bits") }
	return ""
}

func TestImmFitsI8() testing.TestResult {
	if !immFitsI8(-128) || !immFitsI8(127) { return fail("-128/127 fit imm8") }
	if immFitsI8(-129) || immFitsI8(128) { return fail("-129/128 do not fit imm8") }
	return ""
}

// emitImmW writes exactly the operation-width field: 1, 2 or 4 bytes.
func TestEmitImmWWidths() testing.TestResult {
	var a @asm.Assembler = newAsm()
	emitImmW(a, -1, SZ8)
	if !emitsExactly(a, "ff") { return fail("SZ8 -1 should emit ff") }
	a = newAsm()
	emitImmW(a, 0x1234, SZ16)
	if !emitsExactly(a, "34 12") { return fail("SZ16 0x1234 should emit 34 12") }
	a = newAsm()
	emitImmW(a, -2, SZ16)
	if !emitsExactly(a, "fe ff") { return fail("SZ16 -2 should emit fe ff") }
	a = newAsm()
	emitImmW(a, -16, SZ32)
	if !emitsExactly(a, "f0 ff ff ff") { return fail("SZ32 -16 should emit f0 ff ff ff") }
	a = newAsm()
	emitImmW(a, 0x7FFFFFFF, SZ64)
	if !emitsExactly(a, "ff ff ff 7f") { return fail("SZ64 imm32 should emit ff ff ff 7f") }
	return ""
}

// msgHasPrefix reports whether msg begins with p.
func msgHasPrefix(msg *[]readonly char, p *[]readonly char) bool {
	if len(msg) < len(p) { return false }
	for i := 0; i < len(p); i++ {
		if msg[i] != p[i] { return false }
	}
	return true
}

// The error names the instruction and the operation width it was checked
// against.
func TestImmRangeErrorMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, Reg(RCX, SZ64), Imm64(0x80000000))
	if !msgHasPrefix(a.ErrorMsg, "x64: and immediate out of range for a 64-bit operation") {
		return fail("and SZ64 0x80000000: unexpected error message")
	}
	a = newAsm()
	Cmp(a, Reg(RCX, SZ16), Imm(0x10000))
	if !msgHasPrefix(a.ErrorMsg, "x64: cmp immediate out of range for a 16-bit operation") {
		return fail("cmp SZ16 0x10000: unexpected error message")
	}
	a = newAsm()
	Push(a, Imm64(0x100000000))
	if !msgHasPrefix(a.ErrorMsg, "x64: push immediate out of range for a 64-bit operation") {
		return fail("push 0x100000000: unexpected error message")
	}
	return ""
}

// --- Fixed imm8 fields (shift count, INT vector, shuffle control) and the
// CMPPS / CMPPD predicate ---
// An imm8 accepts -128..255 like clang (a negative value is its
// two's-complement byte); a value outside is rejected instead of
// truncated to its low byte.  Expected bytes are clang's.

func TestShiftCountImm8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shl(a, Reg(RCX, SZ64), Imm(255))
	if !emitsExactly(a, "48 c1 e1 ff") { return fail("shl rcx, 255") }
	a = newAsm()
	Shl(a, Reg(RCX, SZ64), Imm(-128))
	if !emitsExactly(a, "48 c1 e1 80") { return fail("shl rcx, -128") }
	a = newAsm()
	Shl(a, Reg(RCX, SZ32), Imm(64))
	if !emitsExactly(a, "c1 e1 40") { return fail("shl ecx, 64") }
	a = newAsm()
	Shl(a, Reg(RCX, SZ64), Imm(1))
	if !emitsExactly(a, "48 d1 e1") { return fail("shl rcx, 1") }
	a = newAsm()
	Shl(a, Reg(RCX, SZ8), Reg(RCX, SZ8))
	if !emitsExactly(a, "d2 e1") { return fail("shl cl, cl") }
	a = newAsm()
	Shl(a, Reg(RCX, SZ64), Imm(256))
	if !rejected(a) { return fail("shl rcx, 256 must be rejected") }
	a = newAsm()
	Shr(a, Reg(RCX, SZ32), Imm(-129))
	if !rejected(a) { return fail("shr ecx, -129 must be rejected") }
	a = newAsm()
	Sar(a, Mem(RAX, 0, SZ64), Imm64(0x100000001))
	if !rejected(a) { return fail("sar qword ptr [rax], 0x100000001 must be rejected") }
	return ""
}

func TestIntVectorImm8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Int(a, 255)
	if !emitsExactly(a, "cd ff") { return fail("int 255") }
	a = newAsm()
	Int(a, -1)
	if !emitsExactly(a, "cd ff") { return fail("int -1") }
	a = newAsm()
	Int(a, 256)
	if !rejected(a) { return fail("int 256 must be rejected") }
	a = newAsm()
	Int(a, -129)
	if !rejected(a) { return fail("int -129 must be rejected") }
	return ""
}

func TestShuffleControlImm8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Pshufd(a, XMM0, XMM1, 255)
	if !emitsExactly(a, "66 0f 70 c1 ff") { return fail("pshufd xmm0, xmm1, 255") }
	a = newAsm()
	Pshufd(a, XMM0, XMM1, -128)
	if !emitsExactly(a, "66 0f 70 c1 80") { return fail("pshufd xmm0, xmm1, -128") }
	a = newAsm()
	Shufps(a, XMM0, XMM1, -1)
	if !emitsExactly(a, "0f c6 c1 ff") { return fail("shufps xmm0, xmm1, -1") }
	a = newAsm()
	Shufpd(a, XMM0, XMM1, 255)
	if !emitsExactly(a, "66 0f c6 c1 ff") { return fail("shufpd xmm0, xmm1, 255") }
	a = newAsm()
	Pshufd(a, XMM0, XMM1, 256)
	if !rejected(a) { return fail("pshufd xmm0, xmm1, 256 must be rejected") }
	a = newAsm()
	Shufps(a, XMM0, XMM1, -129)
	if !rejected(a) { return fail("shufps xmm0, xmm1, -129 must be rejected") }
	a = newAsm()
	Shufpd(a, XMM0, XMM1, 0x1FF)
	if !rejected(a) { return fail("shufpd xmm0, xmm1, 0x1ff must be rejected") }
	return ""
}

// Legacy-SSE CMPPS / CMPPD read only imm8[2:0]; the predicate must be one
// of the eight CMPP_* values.
func TestCmppPredicateRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cmpps(a, XMM0, XMM1, CMPP_ORD)
	if !emitsExactly(a, "0f c2 c1 07") { return fail("cmpps xmm0, xmm1, 7") }
	a = newAsm()
	Cmppd(a, XMM0, XMM1, CMPP_EQ)
	if !emitsExactly(a, "66 0f c2 c1 00") { return fail("cmppd xmm0, xmm1, 0") }
	a = newAsm()
	Cmpps(a, XMM0, XMM1, 8)
	if !rejected(a) { return fail("cmpps predicate 8 must be rejected") }
	a = newAsm()
	Cmppd(a, XMM0, XMM1, -1)
	if !rejected(a) { return fail("cmppd predicate -1 must be rejected") }
	a = newAsm()
	Cmpps(a, XMM0, XMM1, 0x100)
	if !rejected(a) { return fail("cmpps predicate 0x100 must be rejected") }
	return ""
}

func TestImm8ErrorMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shl(a, Reg(RCX, SZ64), Imm(256))
	if !msgHasPrefix(a.ErrorMsg, "x64: shl count out of range") {
		return fail("shl rcx, 256: unexpected error message")
	}
	a = newAsm()
	Int(a, 256)
	if !msgHasPrefix(a.ErrorMsg, "x64: int vector out of range") {
		return fail("int 256: unexpected error message")
	}
	return ""
}
