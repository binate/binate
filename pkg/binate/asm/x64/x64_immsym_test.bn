package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Symbolic immediates (ImmSym, MovAbs, Imul3Op) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): the full-width field, its placeholder
// 0, and its fixup.

// symFixupAt reports whether the assembler holds a fixup k of kind kind against x at byte off with
// the given addend, and n fixups in all.
func symFixupAt(a @asm.Assembler, n int, k int, kind int, off int, addend int64) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != n { return false }
	var fix asm.Fixup = s.Fixups[k]
	if fix.Kind != kind || cast(int, fix.Offset) != off || fix.Addend != addend { return false }
	return len(fix.Label) == 1 && fix.Label[0] == 'x'
}

// symCase checks that a holds exactly the bytes hex with one fixup of kind kind against x at off
// with the given addend, else returns what.
func symCase(e @[]char, a @asm.Assembler, what @[]char, hex *[]readonly char, kind int, off int,
		addend int64) @[]char {
	if emitsExactly(a, hex) && symFixupAt(a, 1, 0, kind, off, addend) { return e }
	if len(e) > 0 { return e }
	return fail(what)
}

// `offset x` in each operation width: MOV r64 C7 /0 (FIX_ABS32S), r32 B8+r (asm.FIX_DATA_ABS32),
// r16 66 B8+r (ABS16), r8 B0+r (ABS8), with an addend; MovAbs B8+r io (ABS64); a memory
// destination's C7 / C6.
func TestImmSymMov() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov rax, offset x", "48 c7 c0 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov eax, offset x", "b8 00 00 00 00", asm.FIX_DATA_ABS32, 1, 0)
	a = newAsm()
	Mov(a, Reg(RCX, SZ32), ImmSym("x", 8, 0))
	e = symCase(e, a, "mov ecx, offset x + 8", "b9 00 00 00 00", asm.FIX_DATA_ABS32, 1, 8)
	a = newAsm()
	Mov(a, Reg(R9, SZ32), ImmSym("x", -4, 0))
	e = symCase(e, a, "mov r9d, offset x - 4", "41 b9 00 00 00 00", asm.FIX_DATA_ABS32, 2, -4)
	a = newAsm()
	Mov(a, Reg(RAX, SZ16), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov ax, offset x", "66 b8 00 00", asm.FIX_DATA_ABS16, 2, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ8), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov al, offset x", "b0 00", asm.FIX_DATA_ABS8, 1, 0)
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), ImmSym("x", 8, 0))
	e = symCase(e, a, "movabs rax, offset x + 8", "48 b8 00 00 00 00 00 00 00 00", asm.FIX_DATA_ABS64,
			2, 8)
	a = newAsm()
	Mov(a, Mem(RBX, 0, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov dword ptr [rbx], offset x", "c7 03 00 00 00 00", asm.FIX_DATA_ABS32, 2, 0)
	a = newAsm()
	Mov(a, Mem(RBX, 0, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov qword ptr [rbx], offset x", "48 c7 03 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Mov(a, Mem(RBX, 0, SZ16), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov word ptr [rbx], offset x", "66 c7 03 00 00", asm.FIX_DATA_ABS16, 3, 0)
	a = newAsm()
	Mov(a, Mem(RBX, 0, SZ8), ImmSym("x", 0, 0))
	e = symCase(e, a, "mov byte ptr [rbx], offset x", "c6 03 00", asm.FIX_DATA_ABS8, 2, 0)
	a = newAsm()
	MovAbs(a, Reg(R9, SZ64), Imm64(0x123456789))
	if !emitsExactly(a, "49 b9 89 67 45 23 01 00 00 00") { e = fail("movabs r9, 0x123456789") }
	return e
}

// The ALU group, TEST, PUSH and IMUL take a symbol in their operation-width field, never the imm8
// short forms: `add rax, offset x` 48 81 C0 (FIX_ABS32S), `add eax, offset x` 81 C0 (ABS32),
// `cmp rax` 48 81 F8, `test eax` A9 (the accumulator's form, as clang's), `push offset x` 68,
// `imul rax, rbx, offset x` 48 69 C3, `imul eax, ebx` 69 C3, `add qword ptr [rbx]` 48 81 03.
func TestImmSymArith() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Add(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "add rax, offset x", "48 81 c0 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Add(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "add eax, offset x", "81 c0 00 00 00 00", asm.FIX_DATA_ABS32, 2, 0)
	a = newAsm()
	Cmp(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "cmp rax, offset x", "48 81 f8 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Test(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "test eax, offset x", "a9 00 00 00 00", asm.FIX_DATA_ABS32, 1, 0)
	a = newAsm()
	Push(a, ImmSym("x", 0, 0))
	e = symCase(e, a, "push offset x", "68 00 00 00 00", FIX_ABS32S, 1, 0)
	a = newAsm()
	Imul3Op(a, Reg(RAX, SZ64), Reg(RBX, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "imul rax, rbx, offset x", "48 69 c3 00 00 00 00", FIX_ABS32S, 3, 0)
	a = newAsm()
	Imul3Op(a, Reg(RAX, SZ32), Reg(RBX, SZ32), ImmSym("x", 0, 0))
	e = symCase(e, a, "imul eax, ebx, offset x", "69 c3 00 00 00 00", asm.FIX_DATA_ABS32, 2, 0)
	a = newAsm()
	Add(a, Mem(RBX, 0, SZ64), ImmSym("x", 0, 0))
	e = symCase(e, a, "add qword ptr [rbx], offset x", "48 81 03 00 00 00 00", FIX_ABS32S, 3, 0)
	// A [rip + y] destination's rel32 counts past the imm32 that follows it (clang's y-8 and x).
	a = newAsm()
	var y Operand = RipLabel("y")
	y.Size = SZ64
	Mov(a, y, ImmSym("x", 0, 0))
	var s @asm.Section = a.Sections[0]
	if !emitsExactly(a, "48 c7 05 00 00 00 00 00 00 00 00") || s.NumFixups != 2 ||
			s.Fixups[0].Kind != FIX_REL32_LEA || s.Fixups[0].Addend != -4 ||
			!symFixupAt(a, 2, 1, FIX_ABS32S, 7, 0) {
		e = fail("mov qword ptr [rip + y], offset x")
	}
	return e
}

// A thread-local offset in an imm32 of a 32- or 64-bit operation (FIX_TPOFF32 / FIX_DTPOFF32) and
// in MovAbs's imm64 (FIX_TPOFF64 / FIX_DTPOFF64), as clang emits them.
func TestImmSymTls() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), ImmSym("x", 8, FIX_TPOFF32))
	e = symCase(e, a, "mov rax, offset x@TPOFF + 8", "48 c7 c0 00 00 00 00", FIX_TPOFF32, 3, 8)
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), ImmSym("x", 0, FIX_TPOFF32))
	e = symCase(e, a, "mov eax, offset x@TPOFF", "b8 00 00 00 00", FIX_TPOFF32, 1, 0)
	a = newAsm()
	Add(a, Reg(RAX, SZ64), ImmSym("x", 0, FIX_DTPOFF32))
	e = symCase(e, a, "add rax, offset x@DTPOFF", "48 81 c0 00 00 00 00", FIX_DTPOFF32, 3, 0)
	a = newAsm()
	Push(a, ImmSym("x", 0, FIX_TPOFF32))
	e = symCase(e, a, "push offset x@TPOFF", "68 00 00 00 00", FIX_TPOFF32, 1, 0)
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), ImmSym("x", 0, FIX_TPOFF32))
	e = symCase(e, a, "movabs rax, offset x@TPOFF", "48 b8 00 00 00 00 00 00 00 00", FIX_TPOFF64, 2, 0)
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), ImmSym("x", 0, FIX_DTPOFF32))
	e = symCase(e, a, "movabs rax, offset x@DTPOFF", "48 b8 00 00 00 00 00 00 00 00", FIX_DTPOFF64, 2,
			0)
	return e
}

// A symbolic immediate with no encoding is an error that emits nothing: a thread-local offset in
// an 8- or 16-bit field (clang relocates `mov ax, offset x@TPOFF` with TPOFF32), a kind ImmSym has
// not, no symbol, a symbol as a shift count; MovAbs into another destination or from memory.
func TestImmSymRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ16), ImmSym("x", 0, FIX_TPOFF32))
	if !rejected(a) { return fail("mov ax, offset x@TPOFF") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ8), ImmSym("x", 0, FIX_DTPOFF32))
	if !rejected(a) { return fail("mov al, offset x@DTPOFF") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), ImmSym("x", 0, FIX_GOTTPOFF))
	if !rejected(a) { return fail("mov rax, offset x@GOTTPOFF") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), ImmSym("", 0, FIX_TPOFF32))
	if !rejected(a) { return fail("a thread-local offset immediate with no symbol") }
	a = newAsm()
	Shl(a, Reg(RAX, SZ64), ImmSym("x", 0, 0))
	if !rejected(a) { return fail("shl rax, offset x") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ32), ImmSym("x", 0, 0))
	if !rejected(a) { return fail("movabs eax, offset x") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), Mem(RBX, 0, SZ64))
	if !rejected(a) { return fail("movabs rax, [rbx]") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), ImmSym("x", 0, FIX_TLSGD))
	if !rejected(a) { return fail("movabs rax, offset x@TLSGD") }
	return ""
}
