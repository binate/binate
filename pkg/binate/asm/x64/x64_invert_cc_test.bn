package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// TestInvertCCPairs checks each condition against the one x86 defines as its
// inverse, both ways, and that InvertCC emits nothing.
func TestInvertCCPairs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var pairs @[]int = make_slice(int, 16)
	pairs[0] = CC_O
	pairs[1] = CC_NO
	pairs[2] = CC_B
	pairs[3] = CC_AE
	pairs[4] = CC_E
	pairs[5] = CC_NE
	pairs[6] = CC_BE
	pairs[7] = CC_A
	pairs[8] = CC_S
	pairs[9] = CC_NS
	pairs[10] = CC_P
	pairs[11] = CC_NP
	pairs[12] = CC_L
	pairs[13] = CC_GE
	pairs[14] = CC_LE
	pairs[15] = CC_G
	for i := 0; i < 16; i = i + 2 {
		if InvertCC(a, pairs[i]) != pairs[i + 1] || InvertCC(a, pairs[i + 1]) != pairs[i] {
			return fail("InvertCC does not pair a condition with its inverse")
		}
	}
	if a.HasError || a.Sections[0].Len != 0 {
		return fail("InvertCC of a valid condition should neither error nor emit")
	}
	return ""
}

// TestInvertCCRejectsOutOfRange checks that a code outside CC_O..CC_G is an
// error returning -1, and that a Jcc given that -1 emits nothing.
func TestInvertCCRejectsOutOfRange() testing.TestResult {
	var bad @[]int = make_slice(int, 2)
	bad[0] = -1
	bad[1] = 16
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		if InvertCC(a, bad[i]) != -1 || !a.HasError {
			return fail("InvertCC of an out-of-range code should error and return -1")
		}
	}
	var b @asm.Assembler = newAsm()
	Jcc(b, InvertCC(b, 16), "target")
	if !b.HasError || b.Sections[0].Len != 0 || b.Sections[0].NumFixups != 0 {
		return fail("Jcc on InvertCC's -1 should emit nothing")
	}
	return ""
}
