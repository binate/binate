package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Memory operands with no base, as clang encodes them (`clang -target x86_64-linux-gnu -c`,
// Intel syntax): the absolute [disp32] (MemAbs: a SIB of no base and no index) and an index
// alone ([index*scale + disp32], a SIB of no base), beside MemDisp's [rip + disp32].
func TestMemNoBase() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), MemAbs(8, SZ64))
	if !emitsExactly(a, "48 8b 04 25 08 00 00 00") { return fail("mov rax, [8]") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemAbs(-1, SZ64))
	if !emitsExactly(a, "48 8b 04 25 ff ff ff ff") { return fail("mov rax, [-1]") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(-1, RCX, 2, 8, SZ64))
	if !emitsExactly(a, "48 8b 04 4d 08 00 00 00") { return fail("mov rax, [rcx*2 + 8]") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(-1, RBX, 2, 0, SZ64))
	if !emitsExactly(a, "48 8b 04 5d 00 00 00 00") { return fail("mov rax, [rbx*2]") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(-1, R15, 8, 0, SZ64))
	if !emitsExactly(a, "4a 8b 04 fd 00 00 00 00") { return fail("mov rax, [r15*8]") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemDisp(8, SZ64))
	if !emitsExactly(a, "48 8b 05 08 00 00 00") { return fail("mov rax, [rip + 8]") }
	return ""
}

// A memory operand the ModR/M and SIB bytes cannot express is an assembler error, not some
// other operand: RSP as the index (its SIB index field means none), a scale other than 1,
// 2, 4 or 8 with an index, and a base or index outside RAX..R15.
func TestMemOperandRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, RSP, 1, 0, SZ64))
	if !a.HasError { return fail("rsp as the index must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(-1, RSP, 2, 0, SZ64))
	if !a.HasError { return fail("rsp as an index with no base must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, RCX, 3, 0, SZ64))
	if !a.HasError { return fail("scale 3 must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, RCX, 0, 0, SZ64))
	if !a.HasError { return fail("scale 0 with an index must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, RCX, 16, 0, SZ64))
	if !a.HasError { return fail("scale 16 must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), Mem(16, 0, SZ64))
	if !a.HasError { return fail("base 16 must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, 16, 1, 0, SZ64))
	if !a.HasError { return fail("index 16 must be rejected") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), Mem(-2, 0, SZ64))
	if !a.HasError { return fail("base -2 must be rejected") }
	if sizeof(int) == 8 {
		// (A displacement beyond 32 bits exists only where int is 64 bits.)
		var big int64 = 0x80000000
		a = newAsm()
		Mov(a, Reg(RAX, SZ64), Mem(RBX, cast(int, big), SZ64))
		if !a.HasError { return fail("displacement 0x80000000 must be rejected") }
		a = newAsm()
		Mov(a, Reg(RAX, SZ64), MemAbs(cast(int, -big - 1), SZ64))
		if !a.HasError { return fail("displacement -2^31 - 1 must be rejected") }
	}
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RBX, R12, 8, 0, SZ64))
	if !emitsExactly(a, "4a 8b 04 e3") { return fail("r12 as the index is encodable") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), Mem(RBX, -2147483648, SZ64))
	if !emitsExactly(a, "48 8b 83 00 00 00 80") { return fail("displacement -2^31 is encodable") }
	return ""
}

// With no index the SIB scale bits are 00 whatever the operand's scale, as clang emits
// them (an R12 or RSP base takes a SIB).
func TestMemSibScaleWithoutIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(R12, -1, 8, 0, SZ64))
	if !emitsExactly(a, "49 8b 04 24") { return fail("mov rax, [r12] with an unused scale 8") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemIdx(RSP, -1, 3, 8, SZ64))
	if !emitsExactly(a, "48 8b 44 24 08") { return fail("mov rax, [rsp + 8] with an unused scale 3") }
	return ""
}
