package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for a symbol's address as a memory operand's displacement, MemSym of kind FIX_ABS32S
// (x64.bn's memSymOk and emitDisp32).  Expected bytes are clang's (`clang
// --target=x86_64-linux-gnu -c`, Intel syntax); the relocated field is a zero placeholder.
// (tlsFixupAt is in x64_tls_test.bn.)

// absCase appends to e a failure named what unless a holds exactly hex and one FIX_ABS32S fixup
// against x at off with addend addend.
func absCase(e @[]char, a @asm.Assembler, what @[]char, hex *[]readonly char, off int,
		addend int64) @[]char {
	if emitsExactly(a, hex) && tlsFixupAt(a, FIX_ABS32S, off, addend) { return e }
	if len(e) > 0 { return e }
	return fail(what)
}

// The displacement is always 32 bits: `mov rax, [x]` the absolute 48 8B 04 25, `[x + 8]` with
// addend 8; `[rbx + x]` 48 8B 83; `[x + rcx*4]` 48 8B 04 8D; `[rbx + rcx*4 + x]` 48 8B 84 8B;
// `[rbp + x]` 48 8B 85 and `[rsp + x]` 48 8B 84 24; `lea rax, [x]` 48 8D 04 25.
func TestMemSymAddress() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [x]", "48 8b 04 25 00 00 00 00", 4, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_ABS32S, 8, SZ64))
	e = absCase(e, a, "mov rax, [x + 8]", "48 8b 04 25 00 00 00 00", 4, 8)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(RBX, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [rbx + x]", "48 8b 83 00 00 00 00", 3, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(-1, RCX, 4, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [x + rcx*4]", "48 8b 04 8d 00 00 00 00", 4, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(RBX, RCX, 4, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [rbx + rcx*4 + x]", "48 8b 84 8b 00 00 00 00", 4, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(RBP, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [rbp + x]", "48 8b 85 00 00 00 00", 3, 0)
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(RSP, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "mov rax, [rsp + x]", "48 8b 84 24 00 00 00 00", 4, 0)
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, 0))
	e = absCase(e, a, "lea rax, [x]", "48 8d 04 25 00 00 00 00", 4, 0)
	return e
}

// Every memory position takes it: `mov qword ptr [x], 5` 48 C7 04 25 + 0 + imm32; `mov byte ptr
// [x], 1` C6 04 25; `push qword ptr [x]` FF 34 25; `jmp` / `call qword ptr [x]` FF 24 25 /
// FF 14 25; `inc qword ptr [x]` 48 FF 04 25; `shl qword ptr [x], 1` 48 D1 24 25; `imul rax, [x],
// 3` 48 6B 04 25 + 0 + 03.
func TestMemSymAddressPositions() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64), Imm(5))
	e = absCase(e, a, "mov qword ptr [x], 5", "48 c7 04 25 00 00 00 00 05 00 00 00", 4, 0)
	a = newAsm()
	Mov(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ8), Imm(1))
	e = absCase(e, a, "mov byte ptr [x], 1", "c6 04 25 00 00 00 00 01", 3, 0)
	a = newAsm()
	Push(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "push qword ptr [x]", "ff 34 25 00 00 00 00", 3, 0)
	a = newAsm()
	JmpMem(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "jmp qword ptr [x]", "ff 24 25 00 00 00 00", 3, 0)
	a = newAsm()
	CallMem(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "call qword ptr [x]", "ff 14 25 00 00 00 00", 3, 0)
	a = newAsm()
	Inc(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64))
	e = absCase(e, a, "inc qword ptr [x]", "48 ff 04 25 00 00 00 00", 4, 0)
	a = newAsm()
	Shl(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64), Imm(1))
	e = absCase(e, a, "shl qword ptr [x], 1", "48 d1 24 25 00 00 00 00", 4, 0)
	a = newAsm()
	Imul3(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64), 3)
	e = absCase(e, a, "imul rax, [x], 3", "48 6b 04 25 00 00 00 00 03", 4, 0)
	return e
}

// With neither base nor index the operand must be the absolute one (a RIP-relative symbol is a
// RipLabel), and a symbol's kind must be one a memory operand takes.
func TestMemSymAddressRejects() testing.TestResult {
	var bad @[]Operand = make_slice(Operand, 3)
	bad[0] = MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ64)
	bad[0].Abs = false
	bad[1] = MemSym(RBX, -1, 1, "x", asm.FIX_DATA_ABS32, 0, SZ64)
	bad[2] = MemSym(RBX, -1, 1, "", FIX_ABS32S, 0, SZ64)
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		Mov(a, Reg(RAX, SZ64), bad[i])
		if !a.HasError { return fail("a symbolic memory operand with no encoding was taken") }
	}
	return ""
}
