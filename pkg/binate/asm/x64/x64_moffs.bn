package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- The moffs form of MOV ---
// A0 (AL from moffs8), A1 (AX / EAX / RAX from moffs), A2 / A3 (stored to moffs), with 0x66 or
// REX.W for the width: the accumulator and an 8-byte absolute address, which no ModR/M form can
// hold past a sign-extended 32 bits.

// emitMoffs emits mnem's moffs form for dst, src: AL / AX / EAX / RAX loaded from (A0 / A1) or
// stored to (A2 / A3) an absolute memory operand — MemAbs, MemAddr64, or a MemSym with neither
// base nor index (its FIX_ABS32S relocated by asm.FIX_DATA_ABS64, a thread-local offset by
// FIX_TPOFF64 / FIX_DTPOFF64; a MemAddr64 with a symbol likewise, its addend in Imm) — else it
// sets the error.
func emitMoffs(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand) {
	var store bool = isMem(dst)
	var reg Operand = dst
	var mem Operand = src
	if store {
		reg = src
		mem = dst
	}
	if reg.Kind != OP_REG || reg.Reg != RAX || mem.Kind != OP_MEM || !mem.Abs || mem.Base >= 0 ||
			mem.Index >= 0 {
		setOperandError(a, mnem, "the moffs form takes AL / AX / EAX / RAX and an absolute address")
		return
	}
	var size int = reg.Size
	if !gpSizeOK(size) || (mem.Size != 0 && mem.Size != size) {
		setOperandError(a, mnem, "operand sizes differ")
		return
	}
	var kind int = 0
	if len(mem.Label) > 0 {
		if mem.Fix == FIX_ABS32S { kind = asm.FIX_DATA_ABS64 }
		if mem.Fix == FIX_TPOFF32 { kind = FIX_TPOFF64 }
		if mem.Fix == FIX_DTPOFF32 { kind = FIX_DTPOFF64 }
	}
	if (len(mem.Label) > 0 || mem.Fix != 0) && kind == 0 {
		setOperandError(a, mnem,
				"a moffs address's symbol is its address (FIX_ABS32S) or a thread-local offset "
						"(FIX_TPOFF32, FIX_DTPOFF32)")
		return
	}
	emitSizePrefix(a, size)
	if size == SZ64 { emit8(a, 0x48) } // REX.W
	var op int = 0xA0
	if size != SZ8 { op = op + 1 }
	if store { op = op + 2 }
	emit8(a, op)
	var addr int64 = cast(int64, mem.Disp)
	if mem.Addr64 { addr = mem.Imm }
	if kind != 0 {
		a.AddFixup(mem.Label, kind, addr, 8)
		emit64le(a, 0) // placeholder; the linker writes the address
		return
	}
	emit64le(a, addr)
}
