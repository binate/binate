package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The moffs form of MOV and MOVABS (x64_moffs.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, Intel syntax).  (aluCase is in x64_acc_test.bn, symCase in
// x64_immsym_test.bn.)

// MOV with a 64-bit address: AL A0, AX 66 A1, EAX A1, RAX 48 A1 (`mov rax, [0x123456789]` 48 A1
// 89 67 45 23 01 00 00 00), stored A2 / A3.
func TestMovMoffs() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), MemAddr64(0x123456789, SZ64))
	e = aluCase(e, a, "mov rax, [0x123456789]", "48 a1 89 67 45 23 01 00 00 00")
	a = newAsm()
	Mov(a, MemAddr64(0x123456789, SZ64), Reg(RAX, SZ64))
	e = aluCase(e, a, "mov [0x123456789], rax", "48 a3 89 67 45 23 01 00 00 00")
	a = newAsm()
	Mov(a, Reg(RAX, SZ8), MemAddr64(0x123456789, SZ8))
	e = aluCase(e, a, "mov al, [0x123456789]", "a0 89 67 45 23 01 00 00 00")
	a = newAsm()
	Mov(a, MemAddr64(0x123456789, SZ8), Reg(RAX, SZ8))
	e = aluCase(e, a, "mov [0x123456789], al", "a2 89 67 45 23 01 00 00 00")
	a = newAsm()
	Mov(a, Reg(RAX, SZ16), MemAddr64(0x123456789, SZ16))
	e = aluCase(e, a, "mov ax, [0x123456789]", "66 a1 89 67 45 23 01 00 00 00")
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), MemAddr64(0x80000000, SZ32))
	e = aluCase(e, a, "mov eax, [0x80000000]", "a1 00 00 00 80 00 00 00 00")
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemAddr64(-0x80000001, SZ64))
	e = aluCase(e, a, "mov rax, [-0x80000001]", "48 a1 ff ff ff 7f ff ff ff ff")
	return e
}

// MOVABS with memory is always the moffs form: a number (`movabs al, [0x10]` A0 + 8 bytes,
// `movabs rax, [-1]` 48 A1 FF x 8, `movabs [0x10], rax` 48 A3), a symbol (R_X86_64_64, its addend
// the relocation's), a thread-local offset (TPOFF64).
func TestMovAbsMoffs() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	MovAbs(a, Reg(RAX, SZ8), MemAbs(0x10, SZ8))
	e = aluCase(e, a, "movabs al, [0x10]", "a0 10 00 00 00 00 00 00 00")
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), MemAbs(-1, SZ64))
	e = aluCase(e, a, "movabs rax, [-1]", "48 a1 ff ff ff ff ff ff ff ff")
	a = newAsm()
	MovAbs(a, MemAbs(0x10, SZ64), Reg(RAX, SZ64))
	e = aluCase(e, a, "movabs [0x10], rax", "48 a3 10 00 00 00 00 00 00 00")
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ32), MemAddr64(0x123456789, SZ32))
	e = aluCase(e, a, "movabs eax, [0x123456789]", "a1 89 67 45 23 01 00 00 00")
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_ABS32S, 8, SZ64))
	e = symCase(e, a, "movabs rax, [x + 8]", "48 a1 00 00 00 00 00 00 00 00", asm.FIX_DATA_ABS64, 2, 8)
	a = newAsm()
	MovAbs(a, MemSym(-1, -1, 1, "x", FIX_ABS32S, 0, SZ32), Reg(RAX, SZ32))
	e = symCase(e, a, "movabs [x], eax", "a3 00 00 00 00 00 00 00 00", asm.FIX_DATA_ABS64, 1, 0)
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_TPOFF32, 0, SZ64))
	e = symCase(e, a, "movabs rax, [x@TPOFF]", "48 a1 00 00 00 00 00 00 00 00", FIX_TPOFF64, 2, 0)
	return e
}

// The moffs form takes only the accumulator, an absolute address and one size; a 64-bit address
// in any other instruction or with another register is an error (clang keeps its low 32 bits).
func TestMoffsRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RBX, SZ64), MemAddr64(0x123456789, SZ64))
	if !a.HasError { return fail("mov rbx, [0x123456789]") }
	a = newAsm()
	Add(a, Reg(RAX, SZ64), MemAddr64(0x123456789, SZ64))
	if !a.HasError { return fail("add rax, [0x123456789]") }
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), MemAddr64(0x123456789, SZ64))
	if !a.HasError { return fail("lea rax, [0x123456789]") }
	a = newAsm()
	MovAbs(a, Reg(RBX, SZ64), MemAbs(0x10, SZ64))
	if !a.HasError { return fail("movabs rbx, [0x10]") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), Mem(RBX, 0, SZ64))
	if !a.HasError { return fail("movabs rax, [rbx]") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), RipLabel("x"))
	if !a.HasError { return fail("movabs rax, [rip + x]") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), MemAbs(0x10, SZ8))
	if !a.HasError { return fail("movabs rax, byte ptr [0x10]") }
	a = newAsm()
	MovAbs(a, Reg(RAX, SZ64), MemSym(-1, -1, 1, "x", FIX_TLSCALL, 0, SZ64))
	if !a.HasError { return fail("movabs rax, [x@tlscall]") }
	return ""
}
