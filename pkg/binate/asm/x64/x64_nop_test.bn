package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// nopWant returns the Intel SDM's recommended n-byte NOP, 1 <= n <= 9.
func nopWant(n int) @[]int {
	var w @[]int = make_slice(int, n)
	if n == 1 {
		w[0] = 0x90
		return w
	}
	var i int = 0
	if n == 2 || n == 6 || n == 9 {
		w[0] = 0x66
		i = 1
	}
	if n == 2 {
		w[1] = 0x90
		return w
	}
	w[i] = 0x0F
	w[i + 1] = 0x1F
	if n == 3 {
		return w // ModRM 00, the rest already 0
	} else if n == 4 {
		w[i + 2] = 0x40
	} else if n == 5 || n == 6 {
		w[i + 2] = 0x44
	} else if n == 7 {
		w[i + 2] = 0x80
	} else {
		w[i + 2] = 0x84
	}
	return w
}

func TestNopNEncodings() testing.TestResult {
	for n := 1; n <= 9; n++ {
		var a @asm.Assembler = newAsm()
		NopN(a, n)
		var s @asm.Section = a.Sections[0]
		if s.Len != n { return fail("NopN: wrong length") }
		if !checkBytes(s, 0, nopWant(n)) { return fail("NopN: wrong bytes") }
		if a.HasError { return fail("NopN: unexpected error") }
	}
	return ""
}

func TestNopNOutOfRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	NopN(a, 0)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("NopN(0) must error and emit nothing") }
	var b @asm.Assembler = newAsm()
	NopN(b, 10)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("NopN(10) must error and emit nothing") }
	return ""
}

// From offset 3, aligning to 16 takes 13 bytes: a 9-byte then a 4-byte NOP.
func TestAlignNopsPads() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Nop(a)
	Nop(a)
	Nop(a)
	AlignNops(a, 16)
	var s @asm.Section = a.Sections[0]
	if s.Len != 16 { return fail("AlignNops: wrong padded length") }
	if !checkBytes(s, 3, nopWant(9)) { return fail("AlignNops: first NOP wrong") }
	if !checkBytes(s, 12, nopWant(4)) { return fail("AlignNops: second NOP wrong") }
	if s.Align != 16 { return fail("AlignNops: section alignment not raised") }
	return ""
}

func TestAlignNopsAlreadyAligned() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AlignNops(a, 16)
	if a.Sections[0].Len != 0 { return fail("AlignNops at 0: must emit nothing") }
	if a.Sections[0].Align != 16 { return fail("AlignNops at 0: section alignment not raised") }
	return ""
}

func TestAlignNopsBadAlignment() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Nop(a)
	AlignNops(a, 12)
	if !a.HasError || a.Sections[0].Len != 1 {
		return fail("AlignNops(12) must error and emit nothing")
	}
	var b @asm.Assembler = newAsm()
	AlignNops(b, 0)
	if !b.HasError { return fail("AlignNops(0) must error") }
	return ""
}
