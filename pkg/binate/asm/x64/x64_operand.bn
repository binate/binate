package "pkg/binate/asm/x64"

import "pkg/binate/buf"

// --- Operand constructors ---

func Reg(r int, size int) Operand {
	var op Operand
	op.Kind = OP_REG
	op.Reg = r
	op.Size = size
	op.Base = -1
	op.Index = -1
	return op
}

// Imm returns an immediate-value Operand. Encoders pick the shortest
// suitable encoding (a sign-extended imm8, else the operation-width
// imm8 / imm16 / imm32, or the imm64 movabs form for Mov to a 64-bit
// register) based on the receiving instruction and the value's range;
// a value that does not fit the receiving instruction sets an assembler
// error (see x64_imm.bn).
func Imm(val int) Operand {
	var op Operand
	op.Kind = OP_IMM
	op.Imm = cast(int64, val)
	op.Base = -1
	op.Index = -1
	return op
}

// Imm64 returns an immediate-value Operand carrying a full 64-bit
// value.  The `int`-based Imm truncates a 64-bit immediate when the
// assembler is hosted on a 32-bit machine; Imm64 preserves it.
func Imm64(val int64) Operand {
	var op Operand
	op.Kind = OP_IMM
	op.Imm = val
	op.Base = -1
	op.Index = -1
	return op
}

// Mem returns a memory operand `[base + disp]` with the given access
// size in bytes. base is a register index (R_RAX..R_R15); disp is a
// signed byte/dword displacement.
func Mem(base int, disp int, size int) Operand {
	var op Operand
	op.Kind = OP_MEM
	op.Base = base
	op.Index = -1
	op.Scale = 1
	op.Disp = disp
	op.Size = size
	return op
}

// MemIdx returns a memory operand `[base + index*scale + disp]` (SIB
// addressing). scale must be 1, 2, 4, or 8.
func MemIdx(base int, index int, scale int, disp int, size int) Operand {
	var op Operand
	op.Kind = OP_MEM
	op.Base = base
	op.Index = index
	op.Scale = scale
	op.Disp = disp
	op.Size = size
	return op
}

// MemDisp returns a memory operand `[disp]` with no base or index, which
// x86-64 encodes RIP-relative (mod/rm = 00/101).
func MemDisp(disp int, size int) Operand {
	var op Operand
	op.Kind = OP_MEM
	op.Base = -1
	op.Index = -1
	op.Disp = disp
	op.Size = size
	return op
}

// MemAbs returns the absolute memory operand `[disp32]`; see x64.bni.
func MemAbs(disp int, size int) Operand {
	var op Operand = MemDisp(disp, size)
	op.Abs = true
	return op
}

// Label returns a symbolic-target Operand referring to `name`. The
// name is copied; the input slice does not need to outlive the Operand.
// Used as the target of jumps / calls; resolved by the assembler's
// fixup machinery.
func Label(name *[]readonly char) Operand {
	var op Operand
	op.Kind = OP_LABEL
	op.Label = buf.CopyStr(name)
	op.Base = -1
	op.Index = -1
	return op
}

// RipLabel returns a `[rip + name]` RIP-relative memory Operand (OP_RIPLABEL),
// which every encoder taking a memory operand accepts (see x64.bni).  Its Size
// is 0, which takes the size of a register operand of the instruction; set
// Size where there is none (e.g. `add dword ptr [rip + x], 5`).  The name is
// copied.
func RipLabel(name *[]readonly char) Operand { return RipLabelAddend(name, 0) }

// RipLabelAddend returns a `[rip + name + addend]` RIP-relative Operand (OP_RIPLABEL,
// the addend in Imm — int64, as a fixup's is), otherwise as RipLabel's.  The name is copied.
func RipLabelAddend(name *[]readonly char, addend int64) Operand {
	var op Operand
	op.Kind = OP_RIPLABEL
	op.Label = buf.CopyStr(name)
	op.Base = -1
	op.Index = -1
	op.Imm = addend
	return op
}

// RipGotLabel returns a `[rip + name@GOTPCREL]` Operand (OP_RIPGOTLABEL): a
// GOT-indirect load of an external symbol's address.  As a Mov source it routes to
// MovGotPcRel; other instructions reject it.  The name is copied.
func RipGotLabel(name *[]readonly char) Operand {
	var op Operand
	op.Kind = OP_RIPGOTLABEL
	op.Label = buf.CopyStr(name)
	op.Base = -1
	op.Index = -1
	return op
}
