package "pkg/binate/asm/x64"

import "pkg/builtins/testing"

// Tests for x64_operand.bn — the Operand constructors.  (fail is in x64_test.bn.)

func TestRegOperand() testing.TestResult {
	var op Operand = Reg(RAX, SZ64)
	if op.Kind != OP_REG || op.Reg != RAX || op.Size != SZ64 {
		return fail("Reg(RAX, SZ64) wrong")
	}
	return ""
}

func TestImmOperand() testing.TestResult {
	var op Operand = Imm(42)
	if op.Kind != OP_IMM || op.Imm != 42 {
		return fail("Imm(42) wrong")
	}
	return ""
}

func TestMemOperand() testing.TestResult {
	var op Operand = Mem(RBP, -8, SZ64)
	if op.Kind != OP_MEM || op.Base != RBP || op.Disp != -8 {
		return fail("Mem(RBP, -8) wrong")
	}
	return ""
}

func TestMemIdxDispAbsOperands() testing.TestResult {
	var op Operand = MemIdx(RAX, RCX, 4, 8, SZ32)
	if op.Kind != OP_MEM || op.Base != RAX || op.Index != RCX || op.Scale != 4 || op.Disp != 8 ||
			op.Size != SZ32 {
		return fail("MemIdx(RAX, RCX, 4, 8, SZ32) wrong")
	}
	op = MemDisp(16, SZ64)
	if op.Kind != OP_MEM || op.Base != -1 || op.Index != -1 || op.Disp != 16 || op.Abs {
		return fail("MemDisp(16, SZ64) wrong")
	}
	op = MemAbs(16, SZ64)
	if op.Kind != OP_MEM || op.Base != -1 || op.Index != -1 || op.Disp != 16 || !op.Abs {
		return fail("MemAbs(16, SZ64) wrong")
	}
	return ""
}

func TestImm64Operand() testing.TestResult {
	var op Operand = Imm64(0x123456789)
	if op.Kind != OP_IMM || op.Imm != 0x123456789 { return fail("Imm64(0x123456789) wrong") }
	return ""
}

// The label operands copy the name; a RIP-label is unsized, its addend in Imm.
func TestLabelOperands() testing.TestResult {
	var op Operand = Label("f")
	if op.Kind != OP_LABEL || len(op.Label) != 1 || op.Label[0] != 'f' {
		return fail("Label(f) wrong")
	}
	op = RipLabel("x")
	if op.Kind != OP_RIPLABEL || op.Label[0] != 'x' || op.Imm != 0 || op.Size != 0 || op.Base != -1 {
		return fail("RipLabel(x) wrong")
	}
	op = RipLabelAddend("x", -12)
	if op.Kind != OP_RIPLABEL || op.Imm != -12 || op.Size != 0 {
		return fail("RipLabelAddend(x, -12) wrong")
	}
	op = RipGotLabel("e")
	if op.Kind != OP_RIPGOTLABEL || op.Label[0] != 'e' { return fail("RipGotLabel(e) wrong") }
	return ""
}
