package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Operand-kind validation: an encoder given an operand kind (or kind
// combination) it has no encoding for rejects it — an assembler error and no
// bytes — rather than emitting a partial instruction, a stray prefix byte or a
// different instruction.  Also covers the operand sizes the PUSH / POP, LEA,
// IMUL and MOVZX / MOVSX / MOVSXD encoders check, and the TEST reg, mem;
// 16-bit and memory PUSH / POP; SETcc to memory; and 16-bit-destination
// MOVZX / MOVSX forms.  Expected bytes are clang's (`clang -target
// x86_64-apple-macos -c`, Intel syntax, disassembled with objdump).

func TestAluKindsRejected() testing.TestResult {
	// mem, mem: no ALU form, so not even a 16-bit pair's 0x66 prefix is emitted.
	var a @asm.Assembler = newAsm()
	Add(a, Mem(RAX, 0, SZ16), Mem(RCX, 0, SZ16))
	if !rejected(a) { return fail("add word ptr [rax], word ptr [rcx] must be rejected") }
	a = newAsm()
	Add(a, Imm(5), Imm(3))
	if !rejected(a) { return fail("add 5, 3 must be rejected") }
	a = newAsm()
	Sub(a, Imm(5), Reg(RCX, SZ64))
	if !rejected(a) { return fail("sub 5, rcx must be rejected") }
	a = newAsm()
	Cmp(a, Reg(RCX, SZ64), Label("L"))
	if !rejected(a) { return fail("cmp rcx, L must be rejected") }
	a = newAsm()
	Xor(a, Label("L"), Imm(1))
	if !rejected(a) { return fail("xor L, 1 must be rejected") }
	return ""
}

func TestTestKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Imm(1), Reg(RCX, SZ64))
	if !rejected(a) { return fail("test 1, rcx must be rejected") }
	a = newAsm()
	Test(a, Mem(RAX, 0, SZ64), Mem(RCX, 0, SZ64))
	if !rejected(a) { return fail("test [rax], [rcx] must be rejected") }
	a = newAsm()
	Test(a, Reg(RCX, SZ64), Label("L"))
	if !rejected(a) { return fail("test rcx, L must be rejected") }
	return ""
}

// TEST is commutative: reg, mem encodes as the mem, reg form.
func TestTestRegMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Reg(RCX, SZ64), Mem(RAX, 8, SZ64))
	if !emitsExactly(a, "48 85 48 08") { return fail("test rcx, qword ptr [rax + 8]") }
	a = newAsm()
	Test(a, Reg(RCX, SZ16), Mem(R12, 0, SZ16))
	if !emitsExactly(a, "66 41 85 0c 24") { return fail("test cx, word ptr [r12]") }
	return ""
}

func TestMovKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Mem(RAX, 0, SZ64), Mem(RCX, 0, SZ64))
	if !rejected(a) { return fail("mov [rax], [rcx] must be rejected") }
	a = newAsm()
	Mov(a, Imm(5), Imm(3))
	if !rejected(a) { return fail("mov 5, 3 must be rejected") }
	a = newAsm()
	Mov(a, Imm(5), Reg(RCX, SZ64))
	if !rejected(a) { return fail("mov 5, rcx must be rejected") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ64), Label("L"))
	if !rejected(a) { return fail("mov rcx, L must be rejected") }
	return ""
}

// IMUL takes a register destination and a register or memory source, and
// has no 8-bit form.  A memory dst is rejected: the ModR/M reg field that
// holds the destination can only name a register.
func TestImulKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Imul3(a, Mem(RAX, 0, SZ64), Reg(RCX, SZ64), 3)
	if !rejected(a) { return fail("imul [rax], rcx, 3 must be rejected") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), Imm(4), 3)
	if !rejected(a) { return fail("imul rcx, 4, 3 must be rejected") }
	a = newAsm()
	Imul2(a, Mem(RAX, 0, SZ64), Reg(RCX, SZ64))
	if !rejected(a) { return fail("imul [rax], rcx must be rejected") }
	a = newAsm()
	Imul2(a, Reg(RCX, SZ64), Imm(3))
	if !rejected(a) { return fail("imul rcx, 3 (two-operand) must be rejected") }
	a = newAsm()
	Imul2(a, Reg(RCX, SZ8), Reg(RDX, SZ8))
	if !rejected(a) { return fail("imul cl, dl must be rejected (no 8-bit form)") }
	return ""
}

// The one-operand group takes a register or memory operand only.
func TestUnaryKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Inc(a, Imm(1))
	if !rejected(a) { return fail("inc 1 must be rejected") }
	a = newAsm()
	Dec(a, Label("L"))
	if !rejected(a) { return fail("dec L must be rejected") }
	a = newAsm()
	Neg(a, Imm(1))
	if !rejected(a) { return fail("neg 1 must be rejected") }
	a = newAsm()
	Not(a, Imm(1))
	if !rejected(a) { return fail("not 1 must be rejected") }
	a = newAsm()
	Idiv(a, Imm(3))
	if !rejected(a) { return fail("idiv 3 must be rejected") }
	a = newAsm()
	Div(a, Imm(3))
	if !rejected(a) { return fail("div 3 must be rejected") }
	a = newAsm()
	Imul1(a, Imm(3))
	if !rejected(a) { return fail("imul 3 (one-operand) must be rejected") }
	a = newAsm()
	Mul1(a, Label("L"))
	if !rejected(a) { return fail("mul L must be rejected") }
	return ""
}

// A shift count is CL or an imm8; the destination is a register or memory.
func TestShiftKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shl(a, Reg(RAX, SZ64), Reg(RDX, SZ8))
	if !rejected(a) { return fail("shl rax, dl must be rejected (count is cl)") }
	a = newAsm()
	Shl(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	if !rejected(a) { return fail("shl rax, rcx must be rejected (count is cl)") }
	a = newAsm()
	Shr(a, Reg(RAX, SZ64), Mem(RCX, 0, SZ8))
	if !rejected(a) { return fail("shr rax, byte ptr [rcx] must be rejected") }
	a = newAsm()
	Sar(a, Imm(1), Imm(1))
	if !rejected(a) { return fail("sar 1, 1 must be rejected") }
	return ""
}

func TestLeaKindsRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Lea(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	if !rejected(a) { return fail("lea rax, rcx must be rejected") }
	a = newAsm()
	Lea(a, Mem(RAX, 0, SZ64), Mem(RCX, 0, SZ64))
	if !rejected(a) { return fail("lea [rax], [rcx] must be rejected") }
	a = newAsm()
	Lea(a, Reg(RAX, SZ8), Mem(RCX, 0, SZ8))
	if !rejected(a) { return fail("lea al, [rcx] must be rejected (no 8-bit LEA)") }
	return ""
}

// PUSH / POP: 64-bit or (with 0x66) 16-bit registers and memory, plus
// PUSH imm.  8- and 32-bit operands have no encoding in 64-bit mode.
func TestPushPopForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Push(a, Reg(RCX, SZ16))
	if !emitsExactly(a, "66 51") { return fail("push cx") }
	a = newAsm()
	Push(a, Reg(R9, SZ16))
	if !emitsExactly(a, "66 41 51") { return fail("push r9w") }
	a = newAsm()
	Pop(a, Reg(RCX, SZ16))
	if !emitsExactly(a, "66 59") { return fail("pop cx") }
	a = newAsm()
	Pop(a, Reg(R9, SZ16))
	if !emitsExactly(a, "66 41 59") { return fail("pop r9w") }
	a = newAsm()
	Push(a, Mem(RAX, 8, SZ64))
	if !emitsExactly(a, "ff 70 08") { return fail("push qword ptr [rax + 8]") }
	a = newAsm()
	Push(a, Mem(R12, 0, SZ64))
	if !emitsExactly(a, "41 ff 34 24") { return fail("push qword ptr [r12]") }
	a = newAsm()
	Push(a, MemIdx(RAX, R9, 8, 0, SZ64))
	if !emitsExactly(a, "42 ff 34 c8") { return fail("push qword ptr [rax + 8*r9]") }
	a = newAsm()
	Push(a, Mem(RAX, 8, SZ16))
	if !emitsExactly(a, "66 ff 70 08") { return fail("push word ptr [rax + 8]") }
	a = newAsm()
	Pop(a, Mem(RAX, 8, SZ64))
	if !emitsExactly(a, "8f 40 08") { return fail("pop qword ptr [rax + 8]") }
	a = newAsm()
	Pop(a, Mem(R13, 0, SZ64))
	if !emitsExactly(a, "41 8f 45 00") { return fail("pop qword ptr [r13]") }
	a = newAsm()
	Pop(a, MemIdx(RAX, R9, 8, 0, SZ16))
	if !emitsExactly(a, "66 42 8f 04 c8") { return fail("pop word ptr [rax + 8*r9]") }
	return ""
}

func TestPushPopRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Push(a, Reg(RCX, SZ32))
	if !rejected(a) { return fail("push ecx must be rejected") }
	a = newAsm()
	Push(a, Reg(RCX, SZ8))
	if !rejected(a) { return fail("push cl must be rejected") }
	a = newAsm()
	Push(a, Mem(RAX, 0, SZ32))
	if !rejected(a) { return fail("push dword ptr [rax] must be rejected") }
	a = newAsm()
	Push(a, Label("L"))
	if !rejected(a) { return fail("push L must be rejected") }
	a = newAsm()
	Pop(a, Reg(RCX, SZ32))
	if !rejected(a) { return fail("pop ecx must be rejected") }
	a = newAsm()
	Pop(a, Imm(1))
	if !rejected(a) { return fail("pop 1 must be rejected") }
	a = newAsm()
	Pop(a, Mem(RAX, 0, SZ8))
	if !rejected(a) { return fail("pop byte ptr [rax] must be rejected") }
	return ""
}

// SETcc writes one byte to a register or a memory operand.
func TestSetccMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setcc(a, CC_E, Mem(RAX, 0, SZ8))
	if !emitsExactly(a, "0f 94 00") { return fail("sete byte ptr [rax]") }
	a = newAsm()
	Setcc(a, CC_NE, Mem(R12, 0, SZ8))
	if !emitsExactly(a, "41 0f 95 04 24") { return fail("setne byte ptr [r12]") }
	a = newAsm()
	Setcc(a, CC_G, MemIdx(RAX, R9, 8, 0, SZ8))
	if !emitsExactly(a, "42 0f 9f 04 c8") { return fail("setg byte ptr [rax + 8*r9]") }
	return ""
}

// The condition code is the 4-bit field of the Jcc / SETcc opcode; a value
// outside CC_O..CC_G is rejected rather than masked into another condition.
func TestCondCodeRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setcc(a, CC_E, Imm(0))
	if !rejected(a) { return fail("sete 0 must be rejected") }
	a = newAsm()
	Setcc(a, 16, Reg(RAX, SZ8))
	if !rejected(a) { return fail("setcc with cc 16 must be rejected") }
	a = newAsm()
	Setcc(a, -1, Mem(RAX, 0, SZ8))
	if !rejected(a) { return fail("setcc with cc -1 must be rejected") }
	a = newAsm()
	Jcc(a, 16, "L")
	if !rejected(a) { return fail("jcc with cc 16 must be rejected") }
	if a.Sections[0].NumFixups != 0 { return fail("a rejected jcc must add no fixup") }
	a = newAsm()
	Jcc(a, CC_G, "L")
	if !emitsExactly(a, "0f 8f 00 00 00 00") { return fail("jg L") }
	return ""
}

// MOVZX / MOVSX widen an 8-bit source into a 16/32/64-bit register or a
// 16-bit source into a 32/64-bit one; a 16-bit destination takes 0x66.
func TestMovzxMovsx16BitDst() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Reg(RCX, SZ16), Mem(RAX, 8, SZ8))
	if !emitsExactly(a, "66 0f b6 48 08") { return fail("movzx cx, byte ptr [rax + 8]") }
	a = newAsm()
	Movzx(a, Reg(RCX, SZ16), Reg(RSI, SZ8))
	if !emitsExactly(a, "66 40 0f b6 ce") { return fail("movzx cx, sil") }
	a = newAsm()
	Movsx(a, Reg(R9, SZ16), Mem(R12, 0, SZ8))
	if !emitsExactly(a, "66 45 0f be 0c 24") { return fail("movsx r9w, byte ptr [r12]") }
	a = newAsm()
	Movsx(a, Reg(RCX, SZ16), Reg(RAX, SZ8))
	if !emitsExactly(a, "66 0f be c8") { return fail("movsx cx, al") }
	return ""
}

func TestExtendRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movzx(a, Mem(RAX, 0, SZ64), Reg(RCX, SZ8))
	if !rejected(a) { return fail("movzx [rax], cl must be rejected") }
	a = newAsm()
	Movzx(a, Reg(RAX, SZ64), Imm(1))
	if !rejected(a) { return fail("movzx rax, 1 must be rejected") }
	a = newAsm()
	Movzx(a, Reg(RAX, SZ64), Reg(RCX, SZ32))
	if !rejected(a) { return fail("movzx rax, ecx must be rejected") }
	a = newAsm()
	Movzx(a, Reg(RAX, SZ16), Reg(RCX, SZ16))
	if !rejected(a) { return fail("movzx ax, cx must be rejected") }
	a = newAsm()
	Movsx(a, Reg(RAX, SZ8), Reg(RCX, SZ8))
	if !rejected(a) { return fail("movsx al, cl must be rejected") }
	a = newAsm()
	Movsxd(a, Reg(RAX, SZ32), Reg(RCX, SZ32))
	if !rejected(a) { return fail("movsxd eax, ecx must be rejected (the REX.W form only)") }
	a = newAsm()
	Movsxd(a, Reg(RAX, SZ64), Reg(RCX, SZ16))
	if !rejected(a) { return fail("movsxd rax, cx must be rejected") }
	a = newAsm()
	Movsxd(a, Imm(0), Reg(RCX, SZ32))
	if !rejected(a) { return fail("movsxd 0, ecx must be rejected") }
	return ""
}

// The SSE and x87 memory forms take an OP_MEM operand only: the register
// (mod=11) form of their opcodes is a different instruction or none (0F 12 is
// MOVHLPS, 0F 13 is undefined, D9 /0 is FLD st(i)), and an immediate, a label
// or a RIP-label would encode as `[rip + 0]` with no fixup.

// rejectedNoFixup reports whether the assembler rejected the instruction
// (rejected) and recorded no fixup for it.
func rejectedNoFixup(a @asm.Assembler) bool {
	return rejected(a) && a.Sections[0].NumFixups == 0
}

// memFormAccepting returns the instruction, as "<mnemonic> <form>", of the first
// SSE / x87 memory-form encoder that does not reject op (rejectedNoFixup), or
// "" when every one of them rejects it.
func memFormAccepting(op Operand) *[]readonly char {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movlps xmm1, op" }
	a = newAsm()
	Movlps_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movlps op, xmm1" }
	a = newAsm()
	Movups_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movups xmm1, op" }
	a = newAsm()
	Movups_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movups op, xmm1" }
	a = newAsm()
	Movss_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movss xmm1, op" }
	a = newAsm()
	Movss_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movss op, xmm1" }
	a = newAsm()
	Movdqu_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movdqu xmm1, op" }
	a = newAsm()
	Movdqu_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movdqu op, xmm1" }
	a = newAsm()
	Movdqa_load(a, XMM1, op)
	if !rejectedNoFixup(a) { return "movdqa xmm1, op" }
	a = newAsm()
	Movdqa_store(a, op, XMM1)
	if !rejectedNoFixup(a) { return "movdqa op, xmm1" }
	a = newAsm()
	Flds(a, op)
	if !rejectedNoFixup(a) { return "flds op" }
	a = newAsm()
	Fldl(a, op)
	if !rejectedNoFixup(a) { return "fldl op" }
	a = newAsm()
	Fstps(a, op)
	if !rejectedNoFixup(a) { return "fstps op" }
	a = newAsm()
	Fstpl(a, op)
	if !rejectedNoFixup(a) { return "fstpl op" }
	return ""
}

func TestMemFormsRejectNonMem() testing.TestResult {
	var bad *[]readonly char = memFormAccepting(Reg(RCX, SZ64))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = rcx must be rejected")) }
	bad = memFormAccepting(Reg(R9, SZ32))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = r9d must be rejected")) }
	bad = memFormAccepting(Imm(8))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = 8 must be rejected")) }
	bad = memFormAccepting(Label("x"))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = label x must be rejected")) }
	bad = memFormAccepting(RipLabel("x"))
	if len(bad) != 0 { return fail(buf.Concat(bad, ": op = [rip + x] must be rejected")) }
	bad = memFormAccepting(RipGotLabel("x"))
	if len(bad) != 0 {
		return fail(buf.Concat(bad, ": op = [rip + x@GOTPCREL] must be rejected"))
	}
	return ""
}

// The error names the instruction and the problem.
func TestOperandErrorMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, Mem(RAX, 0, SZ16), Mem(RCX, 0, SZ16))
	if !msgHasPrefix(a.ErrorMsg, "x64: add: unsupported operand kinds") {
		return fail("add mem, mem: unexpected error message")
	}
	a = newAsm()
	Shl(a, Reg(RAX, SZ64), Reg(RDX, SZ8))
	if !msgHasPrefix(a.ErrorMsg, "x64: shl: count must be cl or an imm8") {
		return fail("shl rax, dl: unexpected error message")
	}
	a = newAsm()
	Movss_load(a, XMM0, RipLabel("x"))
	if !msgHasPrefix(a.ErrorMsg, "x64: movss: unsupported operand kinds") {
		return fail("movss xmm0, [rip + x]: unexpected error message")
	}
	a = newAsm()
	Fstpl(a, Reg(RAX, SZ64))
	if !msgHasPrefix(a.ErrorMsg, "x64: fstpl: unsupported operand kinds") {
		return fail("fstpl rax: unexpected error message")
	}
	return ""
}
