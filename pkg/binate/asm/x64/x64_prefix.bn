package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// The prefixes written as instructions of their own: a segment override (`fs`, and the
// `fs:` of an operand, which the text assembler emits as SegPrefix before its instruction),
// `data16`, `rex64`, `lock` and the lock-elision hints `xacquire` / `xrelease`.

// SegPrefix emits segment override prefix seg; see x64.bni.
func SegPrefix(a @asm.Assembler, seg int) {
	if seg != SEG_ES && seg != SEG_CS && seg != SEG_SS && seg != SEG_DS && seg != SEG_FS &&
			seg != SEG_GS {
		a.SetError("x64: a segment override prefix is SEG_ES, SEG_CS, SEG_SS, SEG_DS, SEG_FS or SEG_GS")
		return
	}
	emit8(a, seg)
}

// Data16 emits the operand-size prefix 0x66; see x64.bni.
func Data16(a @asm.Assembler) { emit8(a, 0x66) }

// Rex64 emits the REX.W prefix 0x48; see x64.bni.
func Rex64(a @asm.Assembler) { emit8(a, 0x48) }

// Lock emits the lock prefix 0xF0; see x64.bni.
func Lock(a @asm.Assembler) { emit8(a, 0xF0) }

// LockNext makes the next instruction emitted take the lock prefix; see x64.bni.
func LockNext(a @asm.Assembler) { a.X64Lock = true }

// Xacquire emits the lock-elision hint 0xF2; see x64.bni.
func Xacquire(a @asm.Assembler) { emit8(a, 0xF2) }

// Xrelease emits the lock-elision hint 0xF3; see x64.bni.
func Xrelease(a @asm.Assembler) { emit8(a, 0xF3) }
