package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Each prefix is one byte of its own: the six segment overrides (26 2E 36 3E 64 65), data16
// (66) and rex64 (48), as clang emits `es` .. `gs`, `data16` and `rex64`.
func TestPrefixBytes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SegPrefix(a, SEG_ES)
	SegPrefix(a, SEG_CS)
	SegPrefix(a, SEG_SS)
	SegPrefix(a, SEG_DS)
	SegPrefix(a, SEG_FS)
	SegPrefix(a, SEG_GS)
	Data16(a)
	Rex64(a)
	if !emitsExactly(a, "26 2e 36 3e 64 65 66 48") { return fail("a prefix is not clang's byte") }
	return ""
}

// A segment override goes before the instruction's own prefixes: `mov ax, word ptr fs:[rbx]`
// is 64 66 8B 03 and `mov r8w, word ptr fs:[r9]` 64 66 45 8B 01, as clang emits them.
func TestSegPrefixBeforeOperandSize() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SegPrefix(a, SEG_FS)
	Mov(a, Reg(RAX, SZ16), Mem(RBX, 0, SZ16))
	SegPrefix(a, SEG_FS)
	Mov(a, Reg(R8, SZ16), Mem(R9, 0, SZ16))
	if !emitsExactly(a, "64 66 8b 03 64 66 45 8b 01") { return fail("fs: before 0x66 and REX") }
	return ""
}

// A value that is no segment override prefix is an error that emits nothing: a segment
// register's number, another prefix byte.
func TestSegPrefixRejects() testing.TestResult {
	var bad @[]int = @[]int{0, 4, 5, 0x66, 0x48, 0xF0, -1}
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		SegPrefix(a, bad[i])
		if !rejected(a) { return fail("a value that is no segment override was taken") }
	}
	return ""
}
