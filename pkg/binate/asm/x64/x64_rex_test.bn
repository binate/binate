package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// REX.B / REX.X for a memory r/m operand (emitRexRM): an R8..R15 base sets
// REX.B and an R8..R15 SIB index sets REX.X in every encoder.  Without them
// `[r12]` decodes as `[rsp]`, `[r13 + 256]` as `[rbp + 256]`, `[r8 - 8]` as
// `[rax - 8]` and `[rax + 8*r9]` as `[rax + 8*rcx]`.  Expected bytes are
// clang's (`clang -target x86_64-apple-macos -c`, Intel syntax, disassembled
// with objdump).

// ALU (emitALU) memory forms: the immediate form and the register forms.
func TestRexAluMemIndexAndBase() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, MemIdx(RAX, R9, 8, 0, SZ8), Imm(0))
	if !emitsExactly(a, "42 80 04 c8 00") { return fail("add byte ptr [rax + 8*r9], 0") }
	a = newAsm()
	Add(a, MemIdx(RAX, R9, 8, 0, SZ64), Imm(1))
	if !emitsExactly(a, "4a 83 04 c8 01") { return fail("add qword ptr [rax + 8*r9], 1") }
	a = newAsm()
	Add(a, MemIdx(R12, R9, 8, 0, SZ64), Imm(0x1234))
	if !emitsExactly(a, "4b 81 04 cc 34 12 00 00") {
		return fail("add qword ptr [r12 + 8*r9], 0x1234")
	}
	a = newAsm()
	Cmp(a, MemIdx(R12, R9, 8, 0, SZ64), Imm(-1))
	if !emitsExactly(a, "4b 83 3c cc ff") { return fail("cmp qword ptr [r12 + 8*r9], -1") }
	a = newAsm()
	Add(a, MemIdx(RAX, R9, 8, 0, SZ64), Reg(RCX, SZ64))
	if !emitsExactly(a, "4a 01 0c c8") { return fail("add qword ptr [rax + 8*r9], rcx") }
	return ""
}

// TEST: the immediate and register forms both take REX.B / REX.X from the
// memory operand, and reg, mem is the swapped r/m, reg form.
func TestRexTestMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Test(a, Mem(R12, 0, SZ64), Imm(1))
	if !emitsExactly(a, "49 f7 04 24 01 00 00 00") { return fail("test qword ptr [r12], 1") }
	a = newAsm()
	Test(a, Mem(R13, 256, SZ32), Imm(1))
	if !emitsExactly(a, "41 f7 85 00 01 00 00 01 00 00 00") {
		return fail("test dword ptr [r13 + 256], 1")
	}
	a = newAsm()
	Test(a, MemIdx(RAX, R9, 8, 0, SZ64), Imm(1))
	if !emitsExactly(a, "4a f7 04 c8 01 00 00 00") { return fail("test qword ptr [rax + 8*r9], 1") }
	a = newAsm()
	Test(a, Mem(R12, 0, SZ64), Reg(RCX, SZ64))
	if !emitsExactly(a, "49 85 0c 24") { return fail("test qword ptr [r12], rcx") }
	a = newAsm()
	Test(a, MemIdx(RAX, R9, 8, 0, SZ64), Reg(RCX, SZ64))
	if !emitsExactly(a, "4a 85 0c c8") { return fail("test qword ptr [rax + 8*r9], rcx") }
	a = newAsm()
	Test(a, Mem(R12, 0, SZ8), Reg(RSI, SZ8))
	if !emitsExactly(a, "41 84 34 24") { return fail("test byte ptr [r12], sil") }
	a = newAsm()
	Test(a, Reg(RSI, SZ8), MemIdx(RAX, R9, 8, 0, SZ8))
	if !emitsExactly(a, "42 84 34 c8") { return fail("test sil, byte ptr [rax + 8*r9]") }
	return ""
}

func TestRexImulMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Imul3(a, Reg(RCX, SZ64), Mem(R12, 0, SZ64), 3)
	if !emitsExactly(a, "49 6b 0c 24 03") { return fail("imul rcx, qword ptr [r12], 3") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), MemIdx(RAX, R9, 8, 0, SZ64), 3)
	if !emitsExactly(a, "4a 6b 0c c8 03") { return fail("imul rcx, qword ptr [rax + 8*r9], 3") }
	a = newAsm()
	Imul3(a, Reg(RCX, SZ64), MemIdx(RAX, R9, 8, 0, SZ64), 0x1234)
	if !emitsExactly(a, "4a 69 0c c8 34 12 00 00") {
		return fail("imul rcx, qword ptr [rax + 8*r9], 0x1234")
	}
	a = newAsm()
	Imul3(a, Reg(R9, SZ32), Mem(R13, 0, SZ32), 0x1234)
	if !emitsExactly(a, "45 69 4d 00 34 12 00 00") { return fail("imul r9d, dword ptr [r13], 0x1234") }
	a = newAsm()
	Imul2(a, Reg(RCX, SZ64), MemIdx(RAX, R9, 8, 0, SZ64))
	if !emitsExactly(a, "4a 0f af 0c c8") { return fail("imul rcx, qword ptr [rax + 8*r9]") }
	a = newAsm()
	Imul2(a, Reg(R10, SZ64), Mem(R12, 0, SZ64))
	if !emitsExactly(a, "4d 0f af 14 24") { return fail("imul r10, qword ptr [r12]") }
	return ""
}

// The one-operand group (INC/DEC/NEG/NOT, MUL/IMUL/DIV/IDIV).
func TestRexUnaryMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Inc(a, Mem(R12, 0, SZ64))
	if !emitsExactly(a, "49 ff 04 24") { return fail("inc qword ptr [r12]") }
	a = newAsm()
	Inc(a, Mem(R12, 0, SZ8))
	if !emitsExactly(a, "41 fe 04 24") { return fail("inc byte ptr [r12]") }
	a = newAsm()
	Dec(a, Mem(R13, 0, SZ32))
	if !emitsExactly(a, "41 ff 4d 00") { return fail("dec dword ptr [r13]") }
	a = newAsm()
	Neg(a, MemIdx(RAX, R9, 8, 0, SZ64))
	if !emitsExactly(a, "4a f7 1c c8") { return fail("neg qword ptr [rax + 8*r9]") }
	a = newAsm()
	Not(a, Mem(R12, 0, SZ64))
	if !emitsExactly(a, "49 f7 14 24") { return fail("not qword ptr [r12]") }
	a = newAsm()
	Idiv(a, Mem(R12, 0, SZ64))
	if !emitsExactly(a, "49 f7 3c 24") { return fail("idiv qword ptr [r12]") }
	a = newAsm()
	Div(a, MemIdx(RAX, R9, 8, 0, SZ64))
	if !emitsExactly(a, "4a f7 34 c8") { return fail("div qword ptr [rax + 8*r9]") }
	a = newAsm()
	Imul1(a, Mem(R12, 0, SZ64))
	if !emitsExactly(a, "49 f7 2c 24") { return fail("imul qword ptr [r12]") }
	a = newAsm()
	Mul1(a, Mem(R13, 0, SZ64))
	if !emitsExactly(a, "49 f7 65 00") { return fail("mul qword ptr [r13]") }
	return ""
}

func TestRexShiftMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shl(a, Mem(R12, 0, SZ64), Imm(3))
	if !emitsExactly(a, "49 c1 24 24 03") { return fail("shl qword ptr [r12], 3") }
	a = newAsm()
	Shl(a, Mem(R12, 0, SZ64), Imm(1))
	if !emitsExactly(a, "49 d1 24 24") { return fail("shl qword ptr [r12], 1") }
	a = newAsm()
	Shl(a, Mem(R12, 0, SZ64), Reg(RCX, SZ8))
	if !emitsExactly(a, "49 d3 24 24") { return fail("shl qword ptr [r12], cl") }
	a = newAsm()
	Shl(a, Mem(R8, -8, SZ64), Reg(RCX, SZ8))
	if !emitsExactly(a, "49 d3 60 f8") { return fail("shl qword ptr [r8 - 8], cl") }
	a = newAsm()
	Sar(a, MemIdx(RAX, R9, 8, 0, SZ32), Imm(5))
	if !emitsExactly(a, "42 c1 3c c8 05") { return fail("sar dword ptr [rax + 8*r9], 5") }
	return ""
}

// MOV / LEA / MOVZX / MOVSXD take REX.B / REX.X from the memory operand
// through the shared emitRexRM path.
func TestRexMovLeaExtendMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, MemIdx(RAX, R9, 8, 0, SZ64), Imm(1))
	if !emitsExactly(a, "4a c7 04 c8 01 00 00 00") { return fail("mov qword ptr [rax + 8*r9], 1") }
	a = newAsm()
	Mov(a, Mem(R8, -8, SZ32), Reg(RCX, SZ32))
	if !emitsExactly(a, "41 89 48 f8") { return fail("mov dword ptr [r8 - 8], ecx") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ64), MemIdx(R12, R9, 8, 0, SZ64))
	if !emitsExactly(a, "4b 8b 0c cc") { return fail("mov rcx, qword ptr [r12 + 8*r9]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ32), MemIdx(RAX, R9, 8, 0, SZ32))
	if !emitsExactly(a, "42 8d 0c c8") { return fail("lea ecx, [rax + 8*r9]") }
	a = newAsm()
	Movzx(a, Reg(RCX, SZ64), MemIdx(RAX, R9, 8, 0, SZ8))
	if !emitsExactly(a, "4a 0f b6 0c c8") { return fail("movzx rcx, byte ptr [rax + 8*r9]") }
	a = newAsm()
	Movsxd(a, Reg(RCX, SZ64), MemIdx(R12, R9, 8, 0, SZ32))
	if !emitsExactly(a, "4b 63 0c cc") { return fail("movsxd rcx, dword ptr [r12 + 8*r9]") }
	return ""
}
