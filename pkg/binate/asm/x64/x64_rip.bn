package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- RIP-relative `[rip + label]` forms ---
//
// A `[rip + label]` operand (OP_RIPLABEL) is a memory operand like any other:
// every encoder that takes one emits ModR/M mod=00 rm=101 (RIP-relative in
// 64-bit mode) and a rel32 placeholder with a FIX_REL32_LEA fixup against the
// label (R_X86_64_PC32 on ELF, X86_64_RELOC_SIGNED* on Mach-O).  The rel32
// counts from the end of the instruction, so when an immediate follows it the
// fixup's addend is reduced by the immediate's size: `cmp byte ptr [rip + x],
// 1` refers to x with addend -1, which the ELF relocation carries as x - 5
// (the rel32 field's own 4 bytes included) and Mach-O inline as -1 (choosing
// X86_64_RELOC_SIGNED_1), as clang emits them.

// gpSizeOK reports whether size is a general-purpose operand size (8, 16, 32
// or 64 bits).
func gpSizeOK(size int) bool {
	return size == SZ8 || size == SZ16 || size == SZ32 || size == SZ64
}

// ripUnsized reports whether op is a `[rip + label]` operand with no size (0),
// which takes the size of a register operand of its instruction (opSize).
func ripUnsized(op Operand) bool { return op.Kind == OP_RIPLABEL && op.Size == 0 }

// emitRipModRM emits the ModR/M byte (mod=00, reg=regField, rm=101) and the
// rel32 placeholder of the `[rip + label]` operand rm, with its fixup: label +
// rm.Imm, less the immBytes of immediate that follow the rel32.
func emitRipModRM(a @asm.Assembler, regField int, rm Operand, immBytes int) {
	emit8(a, (regLo3(regField) << 3) | 5)
	a.AddFixup(rm.Label, FIX_REL32_LEA, rm.Imm - cast(int64, immBytes), 4)
	emit32le(a, 0) // placeholder; ResolveFixups or the linker patches it
}

// emitRipOpcode emits everything of a `[rip + rel32]` instruction up to its
// rel32: the operand-size prefix (0x66) for a 16-bit r, then REX (W for a
// 64-bit r, R for R8..R15, and forced for an 8-bit RSP/RBP/RSI/RDI so it is
// SPL/BPL/SIL/DIL rather than AH/CH/DH/BH), then opcode op8 for an 8-bit r or
// opW otherwise, then ModR/M mod=00 reg=r rm=101.
func emitRipOpcode(a @asm.Assembler, r Operand, op8 int, opW int) {
	var size int = r.Size
	emitSizePrefix(a, size)
	emitRexF(a, rexW(size), r.Reg, 0, 0, size == SZ8 && byteRegHazard(r.Reg))
	if size == SZ8 {
		emit8(a, op8)
	} else {
		emit8(a, opW)
	}
	emit8(a, (regLo3(r.Reg) << 3) + 0x05)
}

// MovRipLabel emits `mov dst, [rip + rel32]` — a direct RIP-relative LOAD of the
// dst-sized value at `label`: Mov with a RipLabel source.  MOV loads `label`'s
// contents, LEA (LeaRipLabel) computes `label`'s address.  For a GOT-indirect
// load of an EXTERNAL symbol use MovGotPcRel instead.  A dst that is not an
// 8/16/32/64-bit register sets an assembler error and emits nothing.
func MovRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	Mov(a, dst, RipLabel(label))
}

// MovRipLabelStore emits `mov [rip + rel32], src` — a direct RIP-relative STORE
// of the src-sized register into `label`: Mov with a RipLabel destination.  A
// src that is not an 8/16/32/64-bit register sets an assembler error and emits
// nothing (an immediate store needs a sized operand: Mov with a RipLabel whose
// Size is set).
func MovRipLabelStore(a @asm.Assembler, src Operand, label *[]readonly char) {
	if src.Kind != OP_REG {
		setOperandError(a, "mov", "a [rip + label] store needs a register source")
		return
	}
	Mov(a, RipLabel(label), src)
}

// LeaRipLabel emits `lea dst, [rip + rel32]` — `label`'s address: Lea with a
// RipLabel source.  The rel32 is resolved by ResolveFixups (same-section) or
// carried into the object as an R_X86_64_PC32 / X86_64_RELOC_SIGNED relocation
// (cross-section / extern).  Used by the native amd64 backend for
// OP_CONST_STRING and global-var addresses — the symmetric of arm64's ADRP+ADD
// pair.  A dst that is not a 16/32/64-bit register (there is no 8-bit LEA)
// sets an assembler error and emits nothing.
func LeaRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	Lea(a, dst, RipLabel(label))
}

// MovGotPcRel emits `mov dst, [rip + label@GOTPCREL]` — REX.W + 0x8B +
// ModRM(mod=00, reg=dst3, rm=101 → RIP-relative) + rel32 — plus a FIX_GOTPCREL
// fixup.  Identical shape to LeaRipLabel but with the MOV opcode (0x8B, r <- r/m)
// instead of LEA (0x8D): the MOV LOADS the GOT slot's contents (label's real
// address) into dst, whereas a LEA would compute the slot's own address.  The
// FIX_GOTPCREL becomes R_X86_64_REX_GOTPCRELX (ELF) / X86_64_RELOC_GOT_LOAD
// (Mach-O) against an external, verbatim (unmangled) symbol.  The slot holds a
// 64-bit address and the ELF relocation names the REX.W form, so a dst that is
// not a 64-bit register sets an assembler error and emits nothing.
func MovGotPcRel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	if dst.Kind != OP_REG {
		setOperandError(a, "mov", "a [rip + label@GOTPCREL] load needs a register destination")
		return
	}
	if dst.Size != SZ64 {
		setOperandError(a, "mov", "a [rip + label@GOTPCREL] load needs a 64-bit register")
		return
	}
	emitRipOpcode(a, dst, 0x8B, 0x8B)
	a.AddFixup(label, FIX_GOTPCREL, 0, 4)
	emit32le(a, 0) // placeholder; the linker patches the rel32 to the GOT slot
}
