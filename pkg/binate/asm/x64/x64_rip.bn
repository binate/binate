package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- RIP-relative `[rip + label]` forms ---
//
// Each emits its prefixes, opcode and a ModR/M byte of mod=00 rm=101 (RIP-
// relative in 64-bit mode), then a rel32 placeholder with a fixup against the
// label.  The rel32 is the instruction's last field, so the PC-relative
// relocation's implicit -4 lands on the end of the instruction.  The forms
// with a trailing immediate (e.g. `mov [rip + label], imm`, `add [rip +
// label], imm`) would need a relocation addend that accounts for the
// immediate's bytes and are not implemented; Mov and Lea route an OP_RIPLABEL
// operand here, and every other encoder rejects it.

// gpSizeOK reports whether size is a general-purpose operand size (8, 16, 32
// or 64 bits).
func gpSizeOK(size int) bool {
	return size == SZ8 || size == SZ16 || size == SZ32 || size == SZ64
}

// emitRipOpcode emits everything of a `[rip + rel32]` instruction up to its
// rel32: the operand-size prefix (0x66) for a 16-bit r, then REX (W for a
// 64-bit r, R for R8..R15, and forced for an 8-bit RSP/RBP/RSI/RDI so it is
// SPL/BPL/SIL/DIL rather than AH/CH/DH/BH), then opcode op8 for an 8-bit r or
// opW otherwise, then ModR/M mod=00 reg=r rm=101.
func emitRipOpcode(a @asm.Assembler, r Operand, op8 int, opW int) {
	var size int = r.Size
	emitSizePrefix(a, size)
	emitRexF(a, rexW(size), r.Reg, 0, 0, size == SZ8 && byteRegHazard(r.Reg))
	if size == SZ8 {
		emit8(a, op8)
	} else {
		emit8(a, opW)
	}
	emit8(a, (regLo3(r.Reg) << 3) + 0x05)
}

// MovRipLabel emits `mov dst, [rip + rel32]` — a direct RIP-relative LOAD of the
// dst-sized value at `label`.  Identical encoding shape to LeaRipLabel but with
// the MOV opcode (0x8A byte / 0x8B word, r <- r/m) instead of LEA (0x8D): MOV
// loads `label`'s contents, LEA computes `label`'s address.  Same FIX_REL32_LEA
// → R_X86_64_PC32 relocation (X86_64_RELOC_SIGNED on Mach-O), so a data-section
// symbol is reached correctly.  For a GOT-indirect load of an EXTERNAL symbol use
// MovGotPcRel instead.  A dst that is not an 8/16/32/64-bit register sets an
// assembler error and emits nothing.
func MovRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	if dst.Kind != OP_REG {
		setOperandError(a, "mov", "a [rip + label] load needs a register destination")
		return
	}
	if !gpSizeOK(dst.Size) {
		setOperandError(a, "mov", "unsupported register size")
		return
	}
	emitRipOpcode(a, dst, 0x8A, 0x8B)
	a.AddFixup(label, FIX_REL32_LEA, 0, 4)
	emit32le(a, 0) // placeholder; ResolveFixups patches it
}

// MovRipLabelStore emits `mov [rip + rel32], src` — a direct RIP-relative STORE
// of the src-sized register into `label`.  Opcode 0x88 (byte) / 0x89 (word)
// (mov r/m, r): the reg field is the SOURCE register, rm=101 selects RIP-
// relative.  Store sibling of MovRipLabel; same FIX_REL32_LEA → R_X86_64_PC32
// relocation.  A src that is not an 8/16/32/64-bit register (an immediate
// included: see the note above) sets an assembler error and emits nothing.
func MovRipLabelStore(a @asm.Assembler, src Operand, label *[]readonly char) {
	if src.Kind != OP_REG {
		setOperandError(a, "mov", "a [rip + label] store needs a register source")
		return
	}
	if !gpSizeOK(src.Size) {
		setOperandError(a, "mov", "unsupported register size")
		return
	}
	emitRipOpcode(a, src, 0x88, 0x89)
	a.AddFixup(label, FIX_REL32_LEA, 0, 4)
	emit32le(a, 0) // placeholder; ResolveFixups patches it
}

// LeaRipLabel emits `lea dst, [rip + rel32]` where the rel32 is
// resolved by ResolveFixups (same-section) or carried into the
// ELF as an R_X86_64_PC32 relocation (cross-section / extern).
// Used by the native amd64 backend for OP_CONST_STRING and global-
// var addresses — the symmetric of arm64's ADRP+ADD pair.
//
// Encoding: (0x66 / REX.W for a 16 / 64-bit dst) + 0x8D + ModRM (mod=00,
// reg=dst3, rm=101) + rel32.  The rm=101 form in mod=00 selects RIP-relative
// addressing in 64-bit mode (the legacy [disp32] absolute addressing isn't
// available without an explicit SIB byte).  A dst that is not a 16/32/64-bit
// register (there is no 8-bit LEA) sets an assembler error and emits nothing.
func LeaRipLabel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	if dst.Kind != OP_REG {
		setOperandError(a, "lea", "a [rip + label] address needs a register destination")
		return
	}
	if dst.Size == SZ8 || !gpSizeOK(dst.Size) {
		setOperandError(a, "lea", "unsupported register size")
		return
	}
	emitRipOpcode(a, dst, 0x8D, 0x8D)
	// FIX_REL32_LEA — distinct from FIX_REL32 so the Mach-O writer
	// emits X86_64_RELOC_SIGNED rather than X86_64_RELOC_BRANCH.
	// ld classifies BRANCH as reaching code symbols and silently
	// miscomputes the displacement when a BRANCH reloc points at a
	// data-section symbol; LEA-RIP-rel must use SIGNED.
	a.AddFixup(label, FIX_REL32_LEA, 0, 4)
	emit32le(a, 0) // placeholder; ResolveFixups patches it
}

// MovGotPcRel emits `mov dst, [rip + label@GOTPCREL]` — REX.W + 0x8B +
// ModRM(mod=00, reg=dst3, rm=101 → RIP-relative) + rel32 — plus a FIX_GOTPCREL
// fixup.  Identical shape to LeaRipLabel but with the MOV opcode (0x8B, r <- r/m)
// instead of LEA (0x8D): the MOV LOADS the GOT slot's contents (label's real
// address) into dst, whereas a LEA would compute the slot's own address.  The
// FIX_GOTPCREL becomes R_X86_64_REX_GOTPCRELX (ELF) / X86_64_RELOC_GOT_LOAD
// (Mach-O) against an external, verbatim (unmangled) symbol.  The slot holds a
// 64-bit address and the ELF relocation names the REX.W form, so a dst that is
// not a 64-bit register sets an assembler error and emits nothing.
func MovGotPcRel(a @asm.Assembler, dst Operand, label *[]readonly char) {
	if dst.Kind != OP_REG {
		setOperandError(a, "mov", "a [rip + label@GOTPCREL] load needs a register destination")
		return
	}
	if dst.Size != SZ64 {
		setOperandError(a, "mov", "a [rip + label@GOTPCREL] load needs a 64-bit register")
		return
	}
	emitRipOpcode(a, dst, 0x8B, 0x8B)
	a.AddFixup(label, FIX_GOTPCREL, 0, 4)
	emit32le(a, 0) // placeholder; the linker patches the rel32 to the GOT slot
}
