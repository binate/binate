package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// `[rip + label]` operands in every encoder that takes a memory operand, against clang's bytes
// and relocations (`clang -c -target x86_64-linux-gnu`, Intel syntax, `llvm-objdump -dr`).  The
// fixup's addend is the ELF R_X86_64_PC32 addend plus 4: the operand's addend less the size of
// any immediate after the rel32 (clang's `x-0x5` for `add dword ptr [rip + x], 5` is a fixup
// addend of -1).

// ripFixupAt reports whether the assembler holds exactly one FIX_REL32_LEA fixup, at byte off of
// the instruction, against x with the given addend.
func ripFixupAt(a @asm.Assembler, off int, addend int64) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return false }
	var fix asm.Fixup = s.Fixups[0]
	if fix.Kind != FIX_REL32_LEA || cast(int, fix.Offset) != off || fix.Addend != addend {
		return false
	}
	return len(fix.Label) == 1 && fix.Label[0] == 'x'
}

// ripSized returns `[rip + x + addend]` with the given size.
func ripSized(addend int64, size int) Operand {
	var op Operand = RipLabelAddend("x", addend)
	op.Size = size
	return op
}

// ripCase returns e with what, the name of an encoding, appended unless a emitted exactly hex
// with its rel32 fixup at off and the given addend.
func ripCase(e @[]char, a @asm.Assembler, what *[]readonly char, hex *[]readonly char, off int,
		addend int64) @[]char {
	if emitsExactly(a, hex) && ripFixupAt(a, off, addend) { return e }
	if len(e) > 0 { e = buf.Concat(e, "; ") }
	return buf.Concat(e, what)
}

// The ALU group's immediate forms: the addend drops by the imm8 (0x80, 0x83), imm16 (0x66
// 0x81) or imm32 (0x81) that follows the rel32; the register forms keep it.
func TestRipLabelALU() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Add(a, ripSized(0, SZ32), Imm(5))
	e = ripCase(e, a, "add dword ptr [rip + x], 5", "83 05 00 00 00 00 05", 2, -1)
	a = newAsm()
	Add(a, ripSized(0, SZ32), Imm(500))
	e = ripCase(e, a, "add dword ptr [rip + x], 500", "81 05 00 00 00 00 f4 01 00 00", 2, -4)
	a = newAsm()
	Add(a, ripSized(0, SZ16), Imm(300))
	e = ripCase(e, a, "add word ptr [rip + x], 300", "66 81 05 00 00 00 00 2c 01", 3, -2)
	a = newAsm()
	Add(a, ripSized(0, SZ8), Imm(1))
	e = ripCase(e, a, "add byte ptr [rip + x], 1", "80 05 00 00 00 00 01", 2, -1)
	a = newAsm()
	Add(a, ripSized(8, SZ64), Imm(500))
	e = ripCase(e, a, "add qword ptr [rip + x + 8], 500", "48 81 05 00 00 00 00 f4 01 00 00", 3, 4)
	a = newAsm()
	Cmp(a, ripSized(8, SZ8), Imm(1))
	e = ripCase(e, a, "cmp byte ptr [rip + x + 8], 1", "80 3d 00 00 00 00 01", 2, 7)
	a = newAsm()
	Add(a, Reg(RCX, SZ64), RipLabel("x"))
	e = ripCase(e, a, "add rcx, qword ptr [rip + x]", "48 03 0d 00 00 00 00", 3, 0)
	a = newAsm()
	Add(a, RipLabel("x"), Reg(R9, SZ64))
	e = ripCase(e, a, "add qword ptr [rip + x], r9", "4c 01 0d 00 00 00 00", 3, 0)
	a = newAsm()
	Xor(a, Reg(RSI, SZ8), RipLabel("x"))
	e = ripCase(e, a, "xor sil, byte ptr [rip + x]", "40 32 35 00 00 00 00", 3, 0)
	a = newAsm()
	Or(a, RipLabel("x"), Reg(RDI, SZ8))
	e = ripCase(e, a, "or byte ptr [rip + x], dil", "40 08 3d 00 00 00 00", 3, 0)
	if len(e) > 0 { return fail(e) }
	return ""
}

// MOV's immediate stores (C6 ib, 66 C7 iw, C7 id, REX.W C7 id) and loads / stores of a register.
func TestRipLabelMov() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Mov(a, ripSized(0, SZ32), Imm(5))
	e = ripCase(e, a, "mov dword ptr [rip + x], 5", "c7 05 00 00 00 00 05 00 00 00", 2, -4)
	a = newAsm()
	Mov(a, ripSized(0, SZ8), Imm(5))
	e = ripCase(e, a, "mov byte ptr [rip + x], 5", "c6 05 00 00 00 00 05", 2, -1)
	a = newAsm()
	Mov(a, ripSized(0, SZ16), Imm(5))
	e = ripCase(e, a, "mov word ptr [rip + x], 5", "66 c7 05 00 00 00 00 05 00", 3, -2)
	a = newAsm()
	Mov(a, ripSized(0, SZ64), Imm(-1))
	e = ripCase(e, a, "mov qword ptr [rip + x], -1", "48 c7 05 00 00 00 00 ff ff ff ff", 3, -4)
	a = newAsm()
	Mov(a, Reg(R10, SZ64), RipLabelAddend("x", -3))
	e = ripCase(e, a, "mov r10, qword ptr [rip + x - 3]", "4c 8b 15 00 00 00 00", 3, -3)
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), RipLabelAddend("x", 16))
	e = ripCase(e, a, "lea rax, [rip + x + 16]", "48 8d 05 00 00 00 00", 3, 16)
	if len(e) > 0 { return fail(e) }
	return ""
}

// TEST (F6 ib / F7 id, and its register form either way round), the one-operand group, the
// shifts (C1 ib drops the addend by 1, D1 and D3 by none) and IMUL's three forms.
func TestRipLabelArith() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Test(a, ripSized(0, SZ8), Imm(1))
	e = ripCase(e, a, "test byte ptr [rip + x], 1", "f6 05 00 00 00 00 01", 2, -1)
	a = newAsm()
	Test(a, ripSized(0, SZ32), Imm(256))
	e = ripCase(e, a, "test dword ptr [rip + x], 256", "f7 05 00 00 00 00 00 01 00 00", 2, -4)
	a = newAsm()
	Test(a, RipLabel("x"), Reg(RAX, SZ64))
	e = ripCase(e, a, "test qword ptr [rip + x], rax", "48 85 05 00 00 00 00", 3, 0)
	a = newAsm()
	Test(a, Reg(RAX, SZ64), RipLabel("x"))
	e = ripCase(e, a, "test rax, qword ptr [rip + x]", "48 85 05 00 00 00 00", 3, 0)
	a = newAsm()
	Inc(a, ripSized(0, SZ32))
	e = ripCase(e, a, "inc dword ptr [rip + x]", "ff 05 00 00 00 00", 2, 0)
	a = newAsm()
	Neg(a, ripSized(0, SZ64))
	e = ripCase(e, a, "neg qword ptr [rip + x]", "48 f7 1d 00 00 00 00", 3, 0)
	a = newAsm()
	Idiv(a, ripSized(0, SZ64))
	e = ripCase(e, a, "idiv qword ptr [rip + x]", "48 f7 3d 00 00 00 00", 3, 0)
	a = newAsm()
	Shl(a, ripSized(0, SZ32), Imm(3))
	e = ripCase(e, a, "shl dword ptr [rip + x], 3", "c1 25 00 00 00 00 03", 2, -1)
	a = newAsm()
	Shl(a, ripSized(0, SZ32), Imm(1))
	e = ripCase(e, a, "shl dword ptr [rip + x], 1", "d1 25 00 00 00 00", 2, 0)
	a = newAsm()
	Sar(a, ripSized(0, SZ64), Reg(RCX, SZ8))
	e = ripCase(e, a, "sar qword ptr [rip + x], cl", "48 d3 3d 00 00 00 00", 3, 0)
	a = newAsm()
	Imul2(a, Reg(RCX, SZ32), RipLabel("x"))
	e = ripCase(e, a, "imul ecx, dword ptr [rip + x]", "0f af 0d 00 00 00 00", 3, 0)
	a = newAsm()
	Imul3(a, Reg(RCX, SZ32), RipLabel("x"), 10)
	e = ripCase(e, a, "imul ecx, dword ptr [rip + x], 10", "6b 0d 00 00 00 00 0a", 2, -1)
	a = newAsm()
	Imul3(a, Reg(RCX, SZ32), RipLabel("x"), 1000)
	e = ripCase(e, a, "imul ecx, dword ptr [rip + x], 1000", "69 0d 00 00 00 00 e8 03 00 00", 2, -4)
	a = newAsm()
	Imul3(a, Reg(RCX, SZ16), RipLabel("x"), 1000)
	e = ripCase(e, a, "imul cx, word ptr [rip + x], 1000", "66 69 0d 00 00 00 00 e8 03", 3, -2)
	if len(e) > 0 { return fail(e) }
	return ""
}

// PUSH / POP, SETcc, the widening moves, and the SSE and x87 memory forms.
func TestRipLabelDataAndFP() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Push(a, ripSized(0, SZ64))
	e = ripCase(e, a, "push qword ptr [rip + x]", "ff 35 00 00 00 00", 2, 0)
	a = newAsm()
	Push(a, ripSized(0, SZ16))
	e = ripCase(e, a, "push word ptr [rip + x]", "66 ff 35 00 00 00 00", 3, 0)
	a = newAsm()
	Pop(a, ripSized(0, SZ64))
	e = ripCase(e, a, "pop qword ptr [rip + x]", "8f 05 00 00 00 00", 2, 0)
	a = newAsm()
	Setcc(a, CC_E, RipLabel("x"))
	e = ripCase(e, a, "sete byte ptr [rip + x]", "0f 94 05 00 00 00 00", 3, 0)
	a = newAsm()
	Movzx(a, Reg(RAX, SZ32), ripSized(0, SZ8))
	e = ripCase(e, a, "movzx eax, byte ptr [rip + x]", "0f b6 05 00 00 00 00", 3, 0)
	a = newAsm()
	Movsx(a, Reg(RAX, SZ64), ripSized(0, SZ16))
	e = ripCase(e, a, "movsx rax, word ptr [rip + x]", "48 0f bf 05 00 00 00 00", 4, 0)
	a = newAsm()
	Movsxd(a, Reg(RAX, SZ64), ripSized(0, SZ32))
	e = ripCase(e, a, "movsxd rax, dword ptr [rip + x]", "48 63 05 00 00 00 00", 3, 0)
	a = newAsm()
	Movss_load(a, XMM1, RipLabel("x"))
	e = ripCase(e, a, "movss xmm1, dword ptr [rip + x]", "f3 0f 10 0d 00 00 00 00", 4, 0)
	a = newAsm()
	Movups_store(a, RipLabel("x"), XMM9)
	e = ripCase(e, a, "movups xmmword ptr [rip + x], xmm9", "44 0f 11 0d 00 00 00 00", 4, 0)
	a = newAsm()
	Fldl(a, RipLabel("x"))
	e = ripCase(e, a, "fld qword ptr [rip + x]", "dd 05 00 00 00 00", 2, 0)
	a = newAsm()
	Fstps(a, RipLabel("x"))
	e = ripCase(e, a, "fstp dword ptr [rip + x]", "d9 1d 00 00 00 00", 2, 0)
	if len(e) > 0 { return fail(e) }
	return ""
}

// An unsized `[rip + label]` takes its instruction's register size; with no register to take
// one from, or beside a register of another size, it is rejected with no bytes and no fixup.
func TestRipLabelUnsizedRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, RipLabel("x"), Imm(5))
	if !rejected(a) || a.Sections[0].NumFixups != 0 { return fail("add [rip + x], 5") }
	a = newAsm()
	Mov(a, RipLabel("x"), Imm(5))
	if !rejected(a) || a.Sections[0].NumFixups != 0 { return fail("mov [rip + x], 5") }
	a = newAsm()
	Inc(a, RipLabel("x"))
	if !rejected(a) { return fail("inc [rip + x]") }
	a = newAsm()
	Shl(a, RipLabel("x"), Imm(3))
	if !rejected(a) { return fail("shl [rip + x], 3") }
	a = newAsm()
	Push(a, RipLabel("x"))
	if !rejected(a) { return fail("push [rip + x]") }
	a = newAsm()
	Movzx(a, Reg(RAX, SZ32), RipLabel("x"))
	if !rejected(a) { return fail("movzx eax, [rip + x]") }
	a = newAsm()
	Mov(a, ripSized(0, SZ32), Reg(RCX, SZ64))
	if !rejected(a) { return fail("mov dword ptr [rip + x], rcx") }
	a = newAsm()
	Add(a, Reg(RCX, SZ64), ripSized(0, SZ32))
	if !rejected(a) { return fail("add rcx, dword ptr [rip + x]") }
	return ""
}
