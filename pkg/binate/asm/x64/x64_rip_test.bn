package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_rip.bn — the `[rip + label]` MOV load / store, LEA and GOT
// load forms.  Expected bytes are clang's (`clang -target x86_64-apple-macos
// -c`, Intel syntax, disassembled with objdump); the rel32 is a zero
// placeholder in both.

// ripFixupAtEnd reports whether the assembler holds exactly one fixup, of the
// given kind, on the instruction's trailing 4-byte rel32 field.
func ripFixupAtEnd(a @asm.Assembler, kind int) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return false }
	var fix asm.Fixup = s.Fixups[0]
	return fix.Kind == kind && cast(int, fix.Offset) == s.Len - 4
}

// A load takes the destination register's size: 0x8A for a byte register,
// 0x8B otherwise, 0x66 for 16 bits, REX.W only for 64 bits, and a forced REX
// for SIL/DIL/SPL/BPL.
func TestMovRipLabelLoadSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RCX, SZ64), RipLabel("x"))
	if !emitsExactly(a, "48 8b 0d 00 00 00 00") { return fail("mov rcx, qword ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov rcx, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ32), RipLabel("x"))
	if !emitsExactly(a, "8b 0d 00 00 00 00") { return fail("mov ecx, dword ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov ecx, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(R9, SZ32), RipLabel("x"))
	if !emitsExactly(a, "44 8b 0d 00 00 00 00") { return fail("mov r9d, dword ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 8b 0d 00 00 00 00") { return fail("mov cx, word ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(R9, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 44 8b 0d 00 00 00 00") { return fail("mov r9w, word ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov r9w, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ8), RipLabel("x"))
	if !emitsExactly(a, "8a 0d 00 00 00 00") { return fail("mov cl, byte ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(RSI, SZ8), RipLabel("x"))
	if !emitsExactly(a, "40 8a 35 00 00 00 00") { return fail("mov sil, byte ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(R9, SZ8), RipLabel("x"))
	if !emitsExactly(a, "44 8a 0d 00 00 00 00") { return fail("mov r9b, byte ptr [rip + x]") }
	return ""
}

// A store takes the source register's size (0x88 byte / 0x89 word), so a
// 32-bit store writes 4 bytes, not 8.
func TestMovRipLabelStoreSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, RipLabel("x"), Reg(R9, SZ64))
	if !emitsExactly(a, "4c 89 0d 00 00 00 00") { return fail("mov qword ptr [rip + x], r9") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov [rip + x], r9: fixup") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ32))
	if !emitsExactly(a, "89 0d 00 00 00 00") { return fail("mov dword ptr [rip + x], ecx") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(R10, SZ32))
	if !emitsExactly(a, "44 89 15 00 00 00 00") { return fail("mov dword ptr [rip + x], r10d") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ16))
	if !emitsExactly(a, "66 89 0d 00 00 00 00") { return fail("mov word ptr [rip + x], cx") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RDI, SZ8))
	if !emitsExactly(a, "40 88 3d 00 00 00 00") { return fail("mov byte ptr [rip + x], dil") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ8))
	if !emitsExactly(a, "88 0d 00 00 00 00") { return fail("mov byte ptr [rip + x], cl") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(R11, SZ8))
	if !emitsExactly(a, "44 88 1d 00 00 00 00") { return fail("mov byte ptr [rip + x], r11b") }
	return ""
}

func TestLeaRipLabelSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Lea(a, Reg(RCX, SZ64), RipLabel("x"))
	if !emitsExactly(a, "48 8d 0d 00 00 00 00") { return fail("lea rcx, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ32), RipLabel("x"))
	if !emitsExactly(a, "8d 0d 00 00 00 00") { return fail("lea ecx, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(R9, SZ32), RipLabel("x"))
	if !emitsExactly(a, "44 8d 0d 00 00 00 00") { return fail("lea r9d, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 8d 0d 00 00 00 00") { return fail("lea cx, [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("lea cx, [rip + x]: fixup") }
	return ""
}

// Forms the RIP-label helpers cannot encode are rejected with no bytes and no
// fixup, rather than silently dropped or widened.
func TestRipLabelRejected() testing.TestResult {
	// No `mov [rip + label], imm` form: the rel32 would not be the last field.
	var a @asm.Assembler = newAsm()
	Mov(a, RipLabel("x"), Imm(5))
	if !rejected(a) { return fail("mov [rip + x], 5 must be rejected") }
	a = newAsm()
	Mov(a, RipLabel("x"), Imm64(0x100000000))
	if !rejected(a) { return fail("mov [rip + x], 0x100000000 must be rejected") }
	a = newAsm()
	Mov(a, RipLabel("x"), Mem(RAX, 0, SZ64))
	if !rejected(a) { return fail("mov [rip + x], [rax] must be rejected") }
	a = newAsm()
	Mov(a, Mem(RAX, 0, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("mov [rax], [rip + x] must be rejected") }
	a = newAsm()
	Mov(a, RipLabel("x"), RipLabel("y"))
	if !rejected(a) { return fail("mov [rip + x], [rip + y] must be rejected") }
	a = newAsm()
	Lea(a, Mem(RAX, 0, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("lea [rax], [rip + x] must be rejected") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ8), RipLabel("x"))
	if !rejected(a) { return fail("lea cl, [rip + x] must be rejected (no 8-bit LEA)") }
	a = newAsm()
	MovRipLabel(a, Reg(RCX, 0), "x")
	if !rejected(a) { return fail("MovRipLabel with a size-0 register must be rejected") }
	if a.Sections[0].NumFixups != 0 { return fail("a rejected RIP load must add no fixup") }
	return ""
}

// The GOT slot holds a 64-bit address and R_X86_64_REX_GOTPCRELX names the
// REX.W form, so only a 64-bit register destination is accepted.
func TestMovGotPcRelRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RCX, SZ32), RipGotLabel("environ"))
	if !rejected(a) { return fail("mov ecx, [rip + environ@GOTPCREL] must be rejected") }
	a = newAsm()
	Mov(a, Mem(RAX, 0, SZ64), RipGotLabel("environ"))
	if !rejected(a) { return fail("mov [rax], [rip + environ@GOTPCREL] must be rejected") }
	a = newAsm()
	MovGotPcRel(a, Imm(0), "environ")
	if !rejected(a) { return fail("MovGotPcRel to an immediate must be rejected") }
	a = newAsm()
	Mov(a, RipGotLabel("environ"), Reg(RCX, SZ64))
	if !rejected(a) { return fail("mov [rip + environ@GOTPCREL], rcx must be rejected") }
	return ""
}

// Encoders other than Mov / Lea have no `[rip + label]` form; they reject the
// operand instead of encoding it as `[rip + 0]` with no fixup.
func TestRipLabelOperandRejectedElsewhere() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, RipLabel("x"), Imm(1))
	if !rejected(a) { return fail("add [rip + x], 1 must be rejected") }
	a = newAsm()
	Add(a, Reg(RCX, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("add rcx, [rip + x] must be rejected") }
	a = newAsm()
	Add(a, Reg(RAX, SZ64), RipGotLabel("e"))
	if !rejected(a) { return fail("add rax, [rip + e@GOTPCREL] must be rejected") }
	a = newAsm()
	Test(a, RipLabel("x"), Imm(1))
	if !rejected(a) { return fail("test [rip + x], 1 must be rejected") }
	a = newAsm()
	Inc(a, RipLabel("x"))
	if !rejected(a) { return fail("inc [rip + x] must be rejected") }
	a = newAsm()
	Shl(a, RipLabel("x"), Imm(1))
	if !rejected(a) { return fail("shl [rip + x], 1 must be rejected") }
	a = newAsm()
	Imul2(a, Reg(RCX, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("imul rcx, [rip + x] must be rejected") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ64), RipGotLabel("e"))
	if !rejected(a) { return fail("lea rcx, [rip + e@GOTPCREL] must be rejected") }
	return ""
}
