package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_rip.bn — the `[rip + label]` MOV load / store, LEA and GOT
// load forms (the other encoders' are in x64_rip_imm_test.bn).  Expected
// bytes are clang's (`clang -target x86_64-apple-macos -c`, Intel syntax,
// disassembled with objdump); the rel32 is a zero placeholder in both.

// ripFixupAtEnd reports whether the assembler holds exactly one fixup, of the
// given kind, on the instruction's trailing 4-byte rel32 field.
func ripFixupAtEnd(a @asm.Assembler, kind int) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return false }
	var fix asm.Fixup = s.Fixups[0]
	return fix.Kind == kind && cast(int64, fix.Offset) == s.Len - 4
}

// A load takes the destination register's size: 0x8A for a byte register,
// 0x8B otherwise, 0x66 for 16 bits, REX.W only for 64 bits, and a forced REX
// for SIL/DIL/SPL/BPL.
func TestMovRipLabelLoadSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RCX, SZ64), RipLabel("x"))
	if !emitsExactly(a, "48 8b 0d 00 00 00 00") { return fail("mov rcx, qword ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov rcx, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ32), RipLabel("x"))
	if !emitsExactly(a, "8b 0d 00 00 00 00") { return fail("mov ecx, dword ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov ecx, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(R9, SZ32), RipLabel("x"))
	if !emitsExactly(a, "44 8b 0d 00 00 00 00") { return fail("mov r9d, dword ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 8b 0d 00 00 00 00") { return fail("mov cx, word ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(R9, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 44 8b 0d 00 00 00 00") { return fail("mov r9w, word ptr [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov r9w, [rip + x]: fixup") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ8), RipLabel("x"))
	if !emitsExactly(a, "8a 0d 00 00 00 00") { return fail("mov cl, byte ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(RSI, SZ8), RipLabel("x"))
	if !emitsExactly(a, "40 8a 35 00 00 00 00") { return fail("mov sil, byte ptr [rip + x]") }
	a = newAsm()
	Mov(a, Reg(R9, SZ8), RipLabel("x"))
	if !emitsExactly(a, "44 8a 0d 00 00 00 00") { return fail("mov r9b, byte ptr [rip + x]") }
	return ""
}

// A store takes the source register's size (0x88 byte / 0x89 word), so a
// 32-bit store writes 4 bytes, not 8.
func TestMovRipLabelStoreSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, RipLabel("x"), Reg(R9, SZ64))
	if !emitsExactly(a, "4c 89 0d 00 00 00 00") { return fail("mov qword ptr [rip + x], r9") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("mov [rip + x], r9: fixup") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ32))
	if !emitsExactly(a, "89 0d 00 00 00 00") { return fail("mov dword ptr [rip + x], ecx") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(R10, SZ32))
	if !emitsExactly(a, "44 89 15 00 00 00 00") { return fail("mov dword ptr [rip + x], r10d") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ16))
	if !emitsExactly(a, "66 89 0d 00 00 00 00") { return fail("mov word ptr [rip + x], cx") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RDI, SZ8))
	if !emitsExactly(a, "40 88 3d 00 00 00 00") { return fail("mov byte ptr [rip + x], dil") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(RCX, SZ8))
	if !emitsExactly(a, "88 0d 00 00 00 00") { return fail("mov byte ptr [rip + x], cl") }
	a = newAsm()
	Mov(a, RipLabel("x"), Reg(R11, SZ8))
	if !emitsExactly(a, "44 88 1d 00 00 00 00") { return fail("mov byte ptr [rip + x], r11b") }
	return ""
}

func TestLeaRipLabelSizes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Lea(a, Reg(RCX, SZ64), RipLabel("x"))
	if !emitsExactly(a, "48 8d 0d 00 00 00 00") { return fail("lea rcx, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ32), RipLabel("x"))
	if !emitsExactly(a, "8d 0d 00 00 00 00") { return fail("lea ecx, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(R9, SZ32), RipLabel("x"))
	if !emitsExactly(a, "44 8d 0d 00 00 00 00") { return fail("lea r9d, [rip + x]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ16), RipLabel("x"))
	if !emitsExactly(a, "66 8d 0d 00 00 00 00") { return fail("lea cx, [rip + x]") }
	if !ripFixupAtEnd(a, FIX_REL32_LEA) { return fail("lea cx, [rip + x]: fixup") }
	return ""
}

// Forms the RIP-label helpers cannot encode are rejected with no bytes and no
// fixup, rather than silently dropped or widened.
func TestRipLabelRejected() testing.TestResult {
	// A sized `[rip + label]` takes an immediate that fits its width only.
	var a @asm.Assembler = newAsm()
	var q Operand = RipLabel("x")
	q.Size = SZ64
	Mov(a, q, Imm64(0x100000000))
	if !rejected(a) { return fail("mov qword ptr [rip + x], 0x100000000 must be rejected") }
	a = newAsm()
	MovRipLabelStore(a, Imm(5), "x")
	if !rejected(a) { return fail("MovRipLabelStore of an immediate must be rejected") }
	a = newAsm()
	Mov(a, RipLabel("x"), Mem(RAX, 0, SZ64))
	if !rejected(a) { return fail("mov [rip + x], [rax] must be rejected") }
	a = newAsm()
	Mov(a, Mem(RAX, 0, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("mov [rax], [rip + x] must be rejected") }
	a = newAsm()
	Mov(a, RipLabel("x"), RipLabel("y"))
	if !rejected(a) { return fail("mov [rip + x], [rip + y] must be rejected") }
	a = newAsm()
	Lea(a, Mem(RAX, 0, SZ64), RipLabel("x"))
	if !rejected(a) { return fail("lea [rax], [rip + x] must be rejected") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ8), RipLabel("x"))
	if !rejected(a) { return fail("lea cl, [rip + x] must be rejected (no 8-bit LEA)") }
	a = newAsm()
	MovRipLabel(a, Reg(RCX, 0), "x")
	if !rejected(a) { return fail("MovRipLabel with a size-0 register must be rejected") }
	if a.Sections[0].NumFixups != 0 { return fail("a rejected RIP load must add no fixup") }
	return ""
}

// MovGotPcRel loads a 64-bit register only (the slot holds a 64-bit address, and its fixup is the
// REX.W load's); Mov from a slot into memory has no form, and a slot with an addend (past it) is
// an error in every encoder.
func TestMovGotPcRelRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovGotPcRel(a, Reg(RCX, SZ32), "environ")
	if !rejected(a) { return fail("MovGotPcRel to ecx must be rejected") }
	a = newAsm()
	Mov(a, Mem(RAX, 0, SZ64), RipGotLabel("environ"))
	if !rejected(a) { return fail("mov [rax], [rip + environ@GOTPCREL] must be rejected") }
	a = newAsm()
	MovGotPcRel(a, Imm(0), "environ")
	if !rejected(a) { return fail("MovGotPcRel to an immediate must be rejected") }
	var off Operand = RipGotLabel("environ")
	off.Imm = 8
	a = newAsm()
	Mov(a, Reg(RCX, SZ64), off)
	if !rejected(a) { return fail("mov rcx, [rip + environ@GOTPCREL + 8] must be rejected") }
	a = newAsm()
	Add(a, Reg(RCX, SZ64), off)
	if !a.HasError || a.Sections[0].NumFixups != 0 {
		return fail("add rcx, [rip + environ@GOTPCREL + 8] must be rejected")
	}
	return ""
}

// gotIs reports whether a holds exactly the bytes hex spells and one fixup, of kind at off with
// addend, against e.
func gotIs(a @asm.Assembler, hex *[]readonly char, kind int, off int, addend int64) bool {
	if !emitsExactly(a, hex) || a.Sections[0].NumFixups != 1 { return false }
	var fix asm.Fixup = a.Sections[0].Fixups[0]
	return fix.Kind == kind && cast(int, fix.Offset) == off && fix.Addend == addend &&
			len(fix.Label) == 1 && fix.Label[0] == 'e'
}

// gotSized returns `[rip + e@GOTPCREL]` of size bits.
func gotSized(size int) Operand {
	var op Operand = RipGotLabel("e")
	op.Size = size
	return op
}

// A `[rip + label@GOTPCREL]` operand is a memory operand to every encoder, its fixup by what a
// linker may rewrite, as clang marks it: a 32- or 64-bit register loaded or operated on from it
// (MOV, the ALU group, TEST) and CALL / JMP relaxable — FIX_REX_GOTPCRELX with a
// REX prefix, FIX_GOTPCRELX without — and any other FIX_GOTPCREL_PLAIN, an immediate after it
// taken off the addend.
func TestRipGotLabelOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, Reg(RAX, SZ64), RipGotLabel("e"))
	if !gotIs(a, "48 03 05 00 00 00 00", FIX_REX_GOTPCRELX, 3, 0) { return fail("add rax, [e]") }
	a = newAsm()
	Mov(a, Reg(RCX, SZ32), RipGotLabel("e"))
	if !gotIs(a, "8b 0d 00 00 00 00", FIX_GOTPCRELX, 2, 0) { return fail("mov ecx, [e]") }
	a = newAsm()
	Mov(a, Reg(R9, SZ32), RipGotLabel("e"))
	if !gotIs(a, "44 8b 0d 00 00 00 00", FIX_REX_GOTPCRELX, 3, 0) { return fail("mov r9d, [e]") }
	a = newAsm()
	Test(a, gotSized(SZ32), Reg(RCX, SZ32))
	if !gotIs(a, "85 0d 00 00 00 00", FIX_GOTPCRELX, 2, 0) { return fail("test [e], ecx") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ64), RipGotLabel("e"))
	if !gotIs(a, "48 8d 0d 00 00 00 00", FIX_GOTPCREL_PLAIN, 3, 0) { return fail("lea rcx, [e]") }
	a = newAsm()
	Lea(a, Reg(RCX, SZ32), RipGotLabel("e"))
	if !gotIs(a, "8d 0d 00 00 00 00", FIX_GOTPCREL_PLAIN, 2, 0) { return fail("lea ecx, [e]") }
	a = newAsm()
	CallMem(a, RipGotLabel("e"))
	if !gotIs(a, "ff 15 00 00 00 00", FIX_GOTPCRELX, 2, 0) { return fail("call [e]") }
	a = newAsm()
	JmpMem(a, RipGotLabel("e"))
	if !gotIs(a, "ff 25 00 00 00 00", FIX_GOTPCRELX, 2, 0) { return fail("jmp [e]") }
	a = newAsm()
	JmpMem(a, gotSized(SZ48))
	if !gotIs(a, "ff 2d 00 00 00 00", FIX_GOTPCREL_PLAIN, 2, 0) { return fail("jmp fword [e]") }
	a = newAsm()
	Mov(a, RipGotLabel("e"), Reg(RCX, SZ64))
	if !gotIs(a, "48 89 0d 00 00 00 00", FIX_GOTPCREL_PLAIN, 3, 0) { return fail("mov [e], rcx") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ16), RipGotLabel("e"))
	if !gotIs(a, "66 8b 05 00 00 00 00", FIX_GOTPCREL_PLAIN, 3, 0) { return fail("mov ax, [e]") }
	a = newAsm()
	Inc(a, gotSized(SZ64))
	if !gotIs(a, "48 ff 05 00 00 00 00", FIX_GOTPCREL_PLAIN, 3, 0) { return fail("inc [e]") }
	a = newAsm()
	Imul2(a, Reg(RCX, SZ64), RipGotLabel("e"))
	if !gotIs(a, "48 0f af 0d 00 00 00 00", FIX_GOTPCREL_PLAIN, 4, 0) { return fail("imul rcx, [e]") }
	a = newAsm()
	Cmp(a, gotSized(SZ32), Imm(1000))
	if !gotIs(a, "81 3d 00 00 00 00 e8 03 00 00", FIX_GOTPCREL_PLAIN, 2, -4) {
		return fail("cmp dword [e], 1000")
	}
	return ""
}

// A `[rip + x@TLVP]` operand (RipTlvp) is a MOV source into a 64-bit register: `mov rax, qword
// ptr [rip + x@TLVP]` 48 8B 05, `mov r9, …` 4C 8B 0D, each rel32 x's FIX_TLVP with no addend, as
// clang emits them.
func TestTlvp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), RipTlvp("x"))
	if !emitsExactly(a, "48 8b 05 00 00 00 00") || !ripFixupAtEnd(a, FIX_TLVP) {
		return fail("mov rax, qword ptr [rip + x@TLVP]")
	}
	a = newAsm()
	var sized Operand = RipTlvp("x")
	sized.Size = SZ64
	Mov(a, Reg(R9, SZ64), sized)
	if !emitsExactly(a, "4c 8b 0d 00 00 00 00") || !ripFixupAtEnd(a, FIX_TLVP) {
		return fail("mov r9, qword ptr [rip + x@TLVP]")
	}
	if a.Sections[0].Fixups[0].Addend != 0 { return fail("a TLVP fixup has an addend") }
	return ""
}

// What ld64 does not link into a working program is an error that emits nothing: a 32-bit
// register, a `lea` (both link, and the program crashes), a store, a dword-sized operand, and
// any other instruction (it rejects `add`).
func TestTlvpRejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ32), RipTlvp("x"))
	if !rejected(a) { return fail("mov eax, [rip + x@TLVP]") }
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), RipTlvp("x"))
	if !rejected(a) { return fail("lea rax, [rip + x@TLVP]") }
	a = newAsm()
	Mov(a, RipTlvp("x"), Reg(RAX, SZ64))
	if !rejected(a) { return fail("mov [rip + x@TLVP], rax") }
	a = newAsm()
	var dword Operand = RipTlvp("x")
	dword.Size = SZ32
	Mov(a, Reg(RAX, SZ64), dword)
	if !rejected(a) { return fail("mov rax, dword ptr [rip + x@TLVP]") }
	a = newAsm()
	Add(a, Reg(RAX, SZ64), RipTlvp("x"))
	if !rejected(a) { return fail("add rax, [rip + x@TLVP]") }
	a = newAsm()
	Push(a, RipTlvp("x"))
	if !rejected(a) { return fail("push [rip + x@TLVP]") }
	a = newAsm()
	CallMem(a, RipTlvp("x"))
	if !rejected(a) { return fail("call [rip + x@TLVP]") }
	return ""
}
