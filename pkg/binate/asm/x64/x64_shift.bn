package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- Shift and rotate instructions ---
// The group: 0xD0 / 0xD1 /ext by 1, 0xD2 / 0xD3 /ext by CL, 0xC0 / 0xC1 /ext ib by an imm8 (the
// byte form first): ROL /0, ROR /1, RCL /2, RCR /3, SHL (SAL) /4, SHR /5, SAR /7.  SHLD / SHRD:
// 0F A4 / 0F AC /r ib by an imm8, 0F A5 / 0F AD /r by CL.

// emitShift emits a shift or rotate of the group. ext selects the
// opcode extension (/0../7). count is either CL (Reg(RCX, SZ8)) or
// an imm8 in -128..255, the range clang accepts (the CPU masks the count
// to 5 or 6 bits).  A non-r/m dst, any other count, or an out-of-range
// immediate count sets an assembler error and emits nothing.
func emitShift(a @asm.Assembler, mnem *[]readonly char, dst Operand, count Operand, ext int) {
	var byCL bool = count.Kind == OP_REG && count.Reg == RCX && count.Size == SZ8
	var byImm bool = count.Kind == OP_IMM
	if !isRM(dst) {
		setKindsError(a, mnem)
		return
	}
	if !byCL && !byImm {
		setOperandError(a, mnem, "count must be cl or an imm8")
		return
	}
	if byImm && isImmSym(count) {
		setOperandError(a, mnem, "a shift count is a number, not a symbol")
		return
	}
	if byImm && !immFits(count.Imm, SZ8) {
		setImm8RangeError(a, mnem, "count")
		return
	}
	var size int = dst.Size
	if !gpSizeOK(size) {
		setOperandError(a, mnem, "invalid operand size")
		return
	}
	emitSizePrefix(a, size)
	var f8 bool = size == SZ8 && dst.Kind == OP_REG && byteRegHazard(dst.Reg)
	emitRexRM(a, rexW(size), 0, dst, f8)
	if byCL {
		// Shift by CL: 0xD2 (byte) / 0xD3 (word/dword/qword)
		if size == SZ8 {
			emit8(a, 0xD2)
		} else {
			emit8(a, 0xD3)
		}
		emitModRM(a, ext, dst)
	} else if count.Imm == 1 {
		// Shift by 1: 0xD0 (byte) / 0xD1 (word/dword/qword)
		if size == SZ8 {
			emit8(a, 0xD0)
		} else {
			emit8(a, 0xD1)
		}
		emitModRM(a, ext, dst)
	} else {
		// Shift by imm8: 0xC0 (byte) / 0xC1 (word/dword/qword)
		if size == SZ8 {
			emit8(a, 0xC0)
		} else {
			emit8(a, 0xC1)
		}
		emitModRMImm(a, ext, dst, 1)
		emit8(a, cast(int, count.Imm))
	}
}

// Shl emits `shl dst, count` — logical shift left. count is either an
// immediate or `cl` (encoded by emitShift via Operand kind).
func Shl(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "shl", dst, count, 4)
}

// Shr emits `shr dst, count` — logical (unsigned) shift right.
func Shr(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "shr", dst, count, 5)
}

// Sar emits `sar dst, count` — arithmetic (sign-preserving) shift right.
func Sar(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "sar", dst, count, 7)
}

// Rol emits `rol dst, count` — rotate left.
func Rol(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "rol", dst, count, 0)
}

// Ror emits `ror dst, count` — rotate right.
func Ror(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "ror", dst, count, 1)
}

// Rcl emits `rcl dst, count` — rotate left through the carry flag.
func Rcl(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "rcl", dst, count, 2)
}

// Rcr emits `rcr dst, count` — rotate right through the carry flag.
func Rcr(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, "rcr", dst, count, 3)
}

// Shld emits `shld dst, src, count` (0F A4 / 0F A5); see x64.bni.
func Shld(a @asm.Assembler, dst Operand, src Operand, count Operand) {
	emitDoubleShift(a, "shld", dst, src, count, 0xA4)
}

// Shrd emits `shrd dst, src, count` (0F AC / 0F AD); see x64.bni.
func Shrd(a @asm.Assembler, dst Operand, src Operand, count Operand) {
	emitDoubleShift(a, "shrd", dst, src, count, 0xAC)
}

// emitDoubleShift emits the double shift mnem, opcode 0F op (by an imm8) or 0F op+1 (by CL): dst a
// 16-, 32- or 64-bit register or memory operand, src a register of its size (in ModR/M's reg
// field), count CL or an imm8 in -128..255, as emitShift's.  Anything else sets an assembler error
// and emits nothing.
func emitDoubleShift(a @asm.Assembler, mnem *[]readonly char, dst Operand, src Operand,
		count Operand, op int) {
	if !isRM(dst) || src.Kind != OP_REG {
		setKindsError(a, mnem)
		return
	}
	var byCL bool = count.Kind == OP_REG && count.Reg == RCX && count.Size == SZ8
	if !byCL && count.Kind != OP_IMM {
		setOperandError(a, mnem, "count must be cl or an imm8")
		return
	}
	if !byCL && isImmSym(count) {
		setOperandError(a, mnem, "a shift count is a number, not a symbol")
		return
	}
	if !byCL && !immFits(count.Imm, SZ8) {
		setImm8RangeError(a, mnem, "count")
		return
	}
	var size int = opSize(a, mnem, dst, src)
	if size == 0 { return }
	if size == SZ8 {
		setOperandError(a, mnem, "there is no 8-bit form")
		return
	}
	emitSizePrefix(a, size)
	emitRexRM(a, rexW(size), src.Reg, dst, false)
	emit8(a, 0x0F)
	if byCL {
		emit8(a, op + 1)
		emitModRM(a, src.Reg, dst)
		return
	}
	emit8(a, op)
	emitModRMImm(a, src.Reg, dst, 1)
	emit8(a, cast(int, count.Imm))
}
