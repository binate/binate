package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The shifts, rotates and SHLD / SHRD (x64_shift.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, Intel syntax).  (aluCase is in x64_acc_test.bn, ripFixupAt in
// x64_rip_imm_test.bn.)

func TestShlImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SHL RAX, 4 = REX.W C1 E0 04
	Shl(a, Reg(RAX, SZ64), Imm(4))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0xC1
	expected[2] = 0xE0
	expected[3] = 0x04
	if !checkBytes(s, 0, expected) {
		return fail("SHL RAX, 4 encoding wrong")
	}
	return ""
}

// A `[rip + x]` destination's fixup counts past the count's imm8 (clang's x-5, a fixup addend of
// -1; by 1 or CL, x-4, addend 0): `rol qword ptr [rip + x], 3` 48 C1 05, `shld ..., rax, 3` 48 0F
// A4 05, `shrd ..., rax, cl` 48 0F AD 05.
func TestShiftRipDestination() testing.TestResult {
	var m Operand = RipLabel("x")
	m.Size = SZ64
	var a @asm.Assembler = newAsm()
	Rol(a, m, Imm(3))
	if !emitsExactly(a, "48 c1 05 00 00 00 00 03") || !ripFixupAt(a, 3, -1) {
		return fail("rol qword ptr [rip + x], 3")
	}
	a = newAsm()
	Rol(a, m, Imm(1))
	if !emitsExactly(a, "48 d1 05 00 00 00 00") || !ripFixupAt(a, 3, 0) {
		return fail("rol qword ptr [rip + x], 1")
	}
	a = newAsm()
	Shld(a, m, Reg(RAX, SZ64), Imm(3))
	if !emitsExactly(a, "48 0f a4 05 00 00 00 00 03") || !ripFixupAt(a, 4, -1) {
		return fail("shld qword ptr [rip + x], rax, 3")
	}
	a = newAsm()
	Shrd(a, m, Reg(RAX, SZ64), Reg(RCX, SZ8))
	if !emitsExactly(a, "48 0f ad 05 00 00 00 00") || !ripFixupAt(a, 4, 0) {
		return fail("shrd qword ptr [rip + x], rax, cl")
	}
	return ""
}

// The rotates take the shift group's forms: by 1 D0 / D1, by an imm8 C0 / C1 (-1 is 255), by CL
// D2 / D3; ROL /0, ROR /1, RCL /2, RCR /3; SPL and R8B with their REX.
func TestRotates() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Rol(a, Reg(RAX, SZ64), Imm(1))
	e = aluCase(e, a, "rol rax, 1", "48 d1 c0")
	a = newAsm()
	Rol(a, Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "rol rax, 3", "48 c1 c0 03")
	a = newAsm()
	Rol(a, Reg(RAX, SZ64), Reg(RCX, SZ8))
	e = aluCase(e, a, "rol rax, cl", "48 d3 c0")
	a = newAsm()
	Rol(a, Reg(RAX, SZ64), Imm(-1))
	e = aluCase(e, a, "rol rax, -1", "48 c1 c0 ff")
	a = newAsm()
	Ror(a, Reg(RAX, SZ32), Imm(1))
	e = aluCase(e, a, "ror eax, 1", "d1 c8")
	a = newAsm()
	Rcl(a, Reg(RCX, SZ16), Imm(3))
	e = aluCase(e, a, "rcl cx, 3", "66 c1 d1 03")
	a = newAsm()
	Rcr(a, Reg(RBX, SZ8), Reg(RCX, SZ8))
	e = aluCase(e, a, "rcr bl, cl", "d2 db")
	a = newAsm()
	Rol(a, Mem(RBX, 0, SZ8), Imm(7))
	e = aluCase(e, a, "rol byte ptr [rbx], 7", "c0 03 07")
	a = newAsm()
	Rol(a, Reg(RSP, SZ8), Imm(1))
	e = aluCase(e, a, "rol spl, 1", "40 d0 c4")
	a = newAsm()
	Rol(a, Reg(R8, SZ8), Reg(RCX, SZ8))
	e = aluCase(e, a, "rol r8b, cl", "41 d2 c0")
	return e
}

// SHLD 0F A4 /r ib and 0F A5 /r (by CL), SHRD 0F AC / 0F AD: the source register in ModR/M's reg
// field, at 16, 32 and 64 bits, to a register or memory.
func TestDoubleShifts() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Shld(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Imm(3))
	e = aluCase(e, a, "shld rax, rbx, 3", "48 0f a4 d8 03")
	a = newAsm()
	Shld(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Reg(RCX, SZ8))
	e = aluCase(e, a, "shld rax, rbx, cl", "48 0f a5 d8")
	a = newAsm()
	Shld(a, Mem(RBX, 0, SZ64), Reg(RAX, SZ64), Imm(3))
	e = aluCase(e, a, "shld [rbx], rax, 3", "48 0f a4 03 03")
	a = newAsm()
	Shld(a, Reg(RAX, SZ16), Reg(RBX, SZ16), Imm(3))
	e = aluCase(e, a, "shld ax, bx, 3", "66 0f a4 d8 03")
	a = newAsm()
	Shld(a, Reg(RAX, SZ32), Reg(RBX, SZ32), Reg(RCX, SZ8))
	e = aluCase(e, a, "shld eax, ebx, cl", "0f a5 d8")
	a = newAsm()
	Shrd(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Imm(3))
	e = aluCase(e, a, "shrd rax, rbx, 3", "48 0f ac d8 03")
	a = newAsm()
	Shrd(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Reg(RCX, SZ8))
	e = aluCase(e, a, "shrd rax, rbx, cl", "48 0f ad d8")
	a = newAsm()
	Shrd(a, Mem(RBX, 0, SZ64), Reg(RCX, SZ64), Imm(1))
	e = aluCase(e, a, "shrd qword ptr [rbx], rcx, 1", "48 0f ac 0b 01")
	return e
}

// A count past an imm8, another register, an 8-bit or mismatched SHLD / SHRD, or an immediate
// source is an error, as in clang, and nothing is emitted.
func TestShiftRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Rol(a, Reg(RAX, SZ64), Imm(256))
	if !rejected(a) { return fail("rol rax, 256") }
	a = newAsm()
	Ror(a, Reg(RAX, SZ64), Reg(RAX, SZ8))
	if !rejected(a) { return fail("ror rax, al") }
	a = newAsm()
	Rcl(a, Reg(RAX, SZ64), Reg(RCX, SZ32))
	if !rejected(a) { return fail("rcl rax, ecx") }
	a = newAsm()
	Shld(a, Reg(RAX, SZ8), Reg(RBX, SZ8), Imm(3))
	if !rejected(a) { return fail("shld al, bl, 3") }
	a = newAsm()
	Shld(a, Reg(RAX, SZ64), Reg(RBX, SZ32), Imm(3))
	if !rejected(a) { return fail("shld rax, ebx, 3") }
	a = newAsm()
	Shrd(a, Reg(RAX, SZ64), Imm(3), Imm(3))
	if !rejected(a) { return fail("shrd rax, 3, 3") }
	a = newAsm()
	Shrd(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Reg(RCX, SZ16))
	if !rejected(a) { return fail("shrd rax, rbx, cx") }
	a = newAsm()
	Shrd(a, Reg(RAX, SZ64), Reg(RBX, SZ64), Imm(300))
	if !rejected(a) { return fail("shrd rax, rbx, 300") }
	return ""
}
