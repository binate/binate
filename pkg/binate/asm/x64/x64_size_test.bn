package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Operand sizes (opSize, and the one-operand encoders' check): register / memory operands of
// different sizes (`Mov(Mem(RAX, 0, SZ64), Reg(RCX, SZ32))`, clang's rejected `mov qword ptr
// [rax], ecx`), and a size other than SZ8 / SZ16 / SZ32 / SZ64, are errors that emit nothing;
// LEA's memory operand, an address, may have any size.
func TestOperandSizeRejects() testing.TestResult {
	for i := 0; i < 10; i++ {
		var a @asm.Assembler = newAsm()
		if i == 0 { Mov(a, Mem(RAX, 0, SZ64), Reg(RCX, SZ32)) }
		if i == 1 { Mov(a, Reg(RCX, SZ32), Mem(RAX, 0, SZ64)) }
		if i == 2 { Add(a, Reg(RAX, SZ64), Reg(RCX, SZ32)) }
		if i == 3 { Test(a, Reg(RAX, SZ32), Mem(RAX, 0, SZ8)) }
		if i == 4 { Imul2(a, Reg(RAX, SZ32), Mem(RAX, 0, SZ64)) }
		if i == 5 { Imul3(a, Reg(RAX, SZ64), Reg(RCX, SZ32), 3) }
		if i == 6 { Mov(a, Mem(RAX, 0, 0), Imm(1)) }
		if i == 7 { Inc(a, Mem(RAX, 0, 24)) }
		if i == 8 { Shl(a, Mem(RAX, 0, 0), Imm(1)) }
		if i == 9 { Lea(a, Reg(RAX, 0), Mem(RBX, 0, SZ64)) }
		if !a.HasError || a.Sections[0].Len != 0 {
			return fail(buf.Concat("a bad operand size was encoded, case ", strconv.Itoa(i)))
		}
	}
	var b @asm.Assembler = newAsm()
	Mov(b, Mem(RAX, 0, SZ32), Reg(RCX, SZ32))
	Lea(b, Reg(RAX, SZ64), Mem(RBX, 0, 0))
	if b.HasError || b.Sections[0].Len != 5 { return fail("matching sizes were rejected") }
	return ""
}
