package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// SSE2 packed (SIMD) integer and bitwise instruction encoders.
//
// These operate on the full 128-bit XMM registers, lane-wise.  All are the
// reg-reg form ([66] REX 0F <op> /r, mod=11) built via emitSSEReg (see
// x64_fp.bn); `dst` is both the first source and the destination (x86
// two-operand form), `src` is the second source.  Packed loads/stores and
// broadcasts live alongside; memory operands go through MOVDQU/MOVDQA.  Byte
// sequences were cross-checked against clang-emitted machine code.

// --- Packed integer add / subtract (byte / word / dword / qword lanes) ---

// Paddb: PADDB xmm_dst, xmm_src — 66 0F FC /r (16 lane-wise 8-bit adds).
func Paddb(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xFC, -1, xmmIdx(dst), xmmIdx(src))
}

// Paddw: PADDW — 66 0F FD /r (8 lane-wise 16-bit adds).
func Paddw(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xFD, -1, xmmIdx(dst), xmmIdx(src))
}

// Paddd: PADDD — 66 0F FE /r (4 lane-wise 32-bit adds).
func Paddd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xFE, -1, xmmIdx(dst), xmmIdx(src))
}

// Paddq: PADDQ — 66 0F D4 /r (2 lane-wise 64-bit adds).
func Paddq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xD4, -1, xmmIdx(dst), xmmIdx(src))
}

// Psubb: PSUBB — 66 0F F8 /r.
func Psubb(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xF8, -1, xmmIdx(dst), xmmIdx(src))
}

// Psubw: PSUBW — 66 0F F9 /r.
func Psubw(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xF9, -1, xmmIdx(dst), xmmIdx(src))
}

// Psubd: PSUBD — 66 0F FA /r.
func Psubd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xFA, -1, xmmIdx(dst), xmmIdx(src))
}

// Psubq: PSUBQ — 66 0F FB /r.
func Psubq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xFB, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Packed integer multiply ---

// Pmullw: PMULLW — 66 0F D5 /r (8 lane-wise 16-bit multiplies, low halves).
func Pmullw(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xD5, -1, xmmIdx(dst), xmmIdx(src))
}

// Pmulld: PMULLD — 66 0F 38 40 /r (4 lane-wise 32-bit multiplies, low halves;
// SSE4.1, a three-byte opcode).
func Pmulld(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x38, 0x40, xmmIdx(dst), xmmIdx(src))
}

// --- Packed bitwise (whole-register, 128-bit) ---

// Pand: PAND — 66 0F DB /r (bitwise AND).
func Pand(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xDB, -1, xmmIdx(dst), xmmIdx(src))
}

// Por: POR — 66 0F EB /r (bitwise OR).
func Por(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xEB, -1, xmmIdx(dst), xmmIdx(src))
}

// Pxor: PXOR — 66 0F EF /r (bitwise XOR; `Pxor(x, x)` is the canonical
// zero-a-register idiom).
func Pxor(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xEF, -1, xmmIdx(dst), xmmIdx(src))
}

// Pandn: PANDN — 66 0F DF /r (bitwise AND-NOT: dst = ~dst & src).
func Pandn(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0xDF, -1, xmmIdx(dst), xmmIdx(src))
}
