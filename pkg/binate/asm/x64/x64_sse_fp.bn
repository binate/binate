package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// SSE/SSE2 packed floating-point instruction encoders (reg-reg form).
//
// Single-precision (…PS) variants take no legacy prefix; double-precision (…PD)
// variants take the 0x66 prefix.  All are built via emitSSEReg (see x64_fp.bn);
// `dst` is both first source and destination, `src` the second source.  CMPPS/
// CMPPD carry a trailing imm8 predicate (CMPP_* below).  Byte sequences were
// cross-checked against clang.

// --- Packed FP add / subtract / multiply / divide ---

// Addps: ADDPS — 0F 58 /r (4 lane-wise f32 adds).
func Addps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x58, -1, xmmIdx(dst), xmmIdx(src))
}

// Addpd: ADDPD — 66 0F 58 /r (2 lane-wise f64 adds).
func Addpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x58, -1, xmmIdx(dst), xmmIdx(src))
}

// Subps: SUBPS — 0F 5C /r.
func Subps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x5C, -1, xmmIdx(dst), xmmIdx(src))
}

// Subpd: SUBPD — 66 0F 5C /r.
func Subpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x5C, -1, xmmIdx(dst), xmmIdx(src))
}

// Mulps: MULPS — 0F 59 /r.
func Mulps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x59, -1, xmmIdx(dst), xmmIdx(src))
}

// Mulpd: MULPD — 66 0F 59 /r.
func Mulpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x59, -1, xmmIdx(dst), xmmIdx(src))
}

// Divps: DIVPS — 0F 5E /r.
func Divps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x5E, -1, xmmIdx(dst), xmmIdx(src))
}

// Divpd: DIVPD — 66 0F 5E /r.
func Divpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x5E, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Packed FP min / max / sqrt ---

// Minps: MINPS — 0F 5D /r.
func Minps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x5D, -1, xmmIdx(dst), xmmIdx(src))
}

// Minpd: MINPD — 66 0F 5D /r.
func Minpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x5D, -1, xmmIdx(dst), xmmIdx(src))
}

// Maxps: MAXPS — 0F 5F /r.
func Maxps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x5F, -1, xmmIdx(dst), xmmIdx(src))
}

// Maxpd: MAXPD — 66 0F 5F /r.
func Maxpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x5F, -1, xmmIdx(dst), xmmIdx(src))
}

// Sqrtps: SQRTPS — 0F 51 /r (dst = sqrt(src), lane-wise f32).
func Sqrtps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x51, -1, xmmIdx(dst), xmmIdx(src))
}

// Sqrtpd: SQRTPD — 66 0F 51 /r.
func Sqrtpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x51, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Packed FP compare (imm8 predicate) ---

// Cmpps: CMPPS — 0F C2 /r ib.  `pred` (CMPP_*) selects the comparison; each lane
// becomes all-ones (true) or all-zeros (false).
func Cmpps(a @asm.Assembler, dst int, src int, pred int) {
	emitSSEReg(a, 0, false, 0xC2, -1, xmmIdx(dst), xmmIdx(src))
	emit8(a, pred & 0xff)
}

// Cmppd: CMPPD — 66 0F C2 /r ib.
func Cmppd(a @asm.Assembler, dst int, src int, pred int) {
	emitSSEReg(a, 0x66, false, 0xC2, -1, xmmIdx(dst), xmmIdx(src))
	emit8(a, pred & 0xff)
}

// --- Packed FP-domain bitwise ---
// Same bit operation as PAND/POR/PXOR but in the FP domain, avoiding the
// domain-crossing forwarding penalty when the operands are FP values.

// Andps: ANDPS — 0F 54 /r.
func Andps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x54, -1, xmmIdx(dst), xmmIdx(src))
}

// Andpd: ANDPD — 66 0F 54 /r.
func Andpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x54, -1, xmmIdx(dst), xmmIdx(src))
}

// Andnps: ANDNPS — 0F 55 /r (dst = ~dst & src).
func Andnps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x55, -1, xmmIdx(dst), xmmIdx(src))
}

// Andnpd: ANDNPD — 66 0F 55 /r.
func Andnpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x55, -1, xmmIdx(dst), xmmIdx(src))
}

// Orps: ORPS — 0F 56 /r.
func Orps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x56, -1, xmmIdx(dst), xmmIdx(src))
}

// Orpd: ORPD — 66 0F 56 /r.
func Orpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x56, -1, xmmIdx(dst), xmmIdx(src))
}

// Xorps: XORPS — 0F 57 /r.
func Xorps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x57, -1, xmmIdx(dst), xmmIdx(src))
}

// Xorpd: XORPD — 66 0F 57 /r.
func Xorpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x57, -1, xmmIdx(dst), xmmIdx(src))
}
