package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the SSE packed floating-point encoders in
// x64_sse_fp.bn.  Expected bytes from clang.  expect4/expect5 are shared with
// x64_sse_test.bn (same package); expect3 covers the no-prefix …PS forms.

// expect3 checks a 3-byte instruction at offset 0.
func expect3(a @asm.Assembler, b0 int, b1 int, b2 int) bool {
	var e @[]int = make_slice(int, 3)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	return checkBytes(a.Sections[0], 0, e)
}

func TestPackedFpArith() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Addps(a, XMM0, XMM1)
	if !expect3(a, 0x0F, 0x58, 0xC1) { return fail("ADDPS wrong") }
	var b @asm.Assembler = newAsm()
	Addpd(b, XMM2, XMM3)
	if !expect4(b, 0x66, 0x0F, 0x58, 0xD3) { return fail("ADDPD wrong") }
	var c @asm.Assembler = newAsm()
	Subps(c, XMM4, XMM5)
	if !expect3(c, 0x0F, 0x5C, 0xE5) { return fail("SUBPS wrong") }
	var d @asm.Assembler = newAsm()
	Subpd(d, XMM6, XMM7)
	if !expect4(d, 0x66, 0x0F, 0x5C, 0xF7) { return fail("SUBPD wrong") }
	var e @asm.Assembler = newAsm()
	Mulps(e, XMM0, XMM1)
	if !expect3(e, 0x0F, 0x59, 0xC1) { return fail("MULPS wrong") }
	var f @asm.Assembler = newAsm()
	Mulpd(f, XMM2, XMM3)
	if !expect4(f, 0x66, 0x0F, 0x59, 0xD3) { return fail("MULPD wrong") }
	var g @asm.Assembler = newAsm()
	Divps(g, XMM4, XMM5)
	if !expect3(g, 0x0F, 0x5E, 0xE5) { return fail("DIVPS wrong") }
	var h @asm.Assembler = newAsm()
	Divpd(h, XMM6, XMM7)
	if !expect4(h, 0x66, 0x0F, 0x5E, 0xF7) { return fail("DIVPD wrong") }
	return ""
}

func TestPackedFpMinMaxSqrt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Minps(a, XMM0, XMM1)
	if !expect3(a, 0x0F, 0x5D, 0xC1) { return fail("MINPS wrong") }
	var b @asm.Assembler = newAsm()
	Minpd(b, XMM2, XMM3)
	if !expect4(b, 0x66, 0x0F, 0x5D, 0xD3) { return fail("MINPD wrong") }
	var c @asm.Assembler = newAsm()
	Maxps(c, XMM4, XMM5)
	if !expect3(c, 0x0F, 0x5F, 0xE5) { return fail("MAXPS wrong") }
	var d @asm.Assembler = newAsm()
	Maxpd(d, XMM6, XMM7)
	if !expect4(d, 0x66, 0x0F, 0x5F, 0xF7) { return fail("MAXPD wrong") }
	var e @asm.Assembler = newAsm()
	Sqrtps(e, XMM1, XMM2)
	if !expect3(e, 0x0F, 0x51, 0xCA) { return fail("SQRTPS wrong") }
	var f @asm.Assembler = newAsm()
	Sqrtpd(f, XMM3, XMM4)
	if !expect4(f, 0x66, 0x0F, 0x51, 0xDC) { return fail("SQRTPD wrong") }
	return ""
}

func TestPackedFpCompare() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cmpps(a, XMM1, XMM2, CMPP_EQ)
	if !expect4(a, 0x0F, 0xC2, 0xCA, 0x00) { return fail("CMPPS eq wrong") }
	var b @asm.Assembler = newAsm()
	Cmpps(b, XMM1, XMM2, CMPP_LT)
	if !expect4(b, 0x0F, 0xC2, 0xCA, 0x01) { return fail("CMPPS lt wrong") }
	var c @asm.Assembler = newAsm()
	Cmppd(c, XMM3, XMM4, CMPP_LE)
	if !expect5(c, 0x66, 0x0F, 0xC2, 0xDC, 0x02) { return fail("CMPPD le wrong") }
	return ""
}

func TestPackedFpBitwise() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Andps(a, XMM0, XMM1)
	if !expect3(a, 0x0F, 0x54, 0xC1) { return fail("ANDPS wrong") }
	var b @asm.Assembler = newAsm()
	Andpd(b, XMM2, XMM3)
	if !expect4(b, 0x66, 0x0F, 0x54, 0xD3) { return fail("ANDPD wrong") }
	var c @asm.Assembler = newAsm()
	Andnps(c, XMM4, XMM5)
	if !expect3(c, 0x0F, 0x55, 0xE5) { return fail("ANDNPS wrong") }
	var d @asm.Assembler = newAsm()
	Andnpd(d, XMM6, XMM7)
	if !expect4(d, 0x66, 0x0F, 0x55, 0xF7) { return fail("ANDNPD wrong") }
	var e @asm.Assembler = newAsm()
	Orps(e, XMM4, XMM5)
	if !expect3(e, 0x0F, 0x56, 0xE5) { return fail("ORPS wrong") }
	var f @asm.Assembler = newAsm()
	Orpd(f, XMM6, XMM7)
	if !expect4(f, 0x66, 0x0F, 0x56, 0xF7) { return fail("ORPD wrong") }
	var g @asm.Assembler = newAsm()
	Xorps(g, XMM0, XMM1)
	if !expect3(g, 0x0F, 0x57, 0xC1) { return fail("XORPS wrong") }
	var h @asm.Assembler = newAsm()
	Xorpd(h, XMM2, XMM3)
	if !expect4(h, 0x66, 0x0F, 0x57, 0xD3) { return fail("XORPD wrong") }
	return ""
}

// A high-register packed-FP case (REX.R+B) and the remaining CMPP_* predicates,
// to pin the shared REX path and the full predicate range.
func TestPackedFpHighRegAndPreds() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mulpd(a, XMM10, XMM12) // REX.R+B → 66 45 0F 59 D4
	if !expect5(a, 0x66, 0x45, 0x0F, 0x59, 0xD4) { return fail("MULPD high-reg wrong") }
	var b @asm.Assembler = newAsm()
	Cmpps(b, XMM1, XMM2, CMPP_NEQ) // pred 4
	if !expect4(b, 0x0F, 0xC2, 0xCA, 0x04) { return fail("CMPPS neq wrong") }
	var c @asm.Assembler = newAsm()
	Cmppd(c, XMM3, XMM4, CMPP_ORD) // pred 7
	if !expect5(c, 0x66, 0x0F, 0xC2, 0xDC, 0x07) { return fail("CMPPD ord wrong") }
	return ""
}
