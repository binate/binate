package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// SSE2 packed 128-bit moves + the string-fill primitive.
//
// MOVDQU/MOVDQA move a whole 128-bit XMM register: reg-reg, or to/from memory
// (unaligned MOVDQU vs 16-byte-aligned MOVDQA).  MOVAPS copies a packed FP
// register.  REP STOSB/STOSQ are the string bulk-fill used for MemZero.  Byte
// sequences were cross-checked against clang.

// --- MOVDQU / MOVDQA / MOVAPS (reg-reg) ---

// Movdqu: MOVDQU xmm_dst, xmm_src — F3 0F 6F /r (register copy).
func Movdqu(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF3, false, 0x6F, -1, xmmIdx(dst), xmmIdx(src))
}

// Movdqa: MOVDQA xmm_dst, xmm_src — 66 0F 6F /r (register copy).
func Movdqa(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x6F, -1, xmmIdx(dst), xmmIdx(src))
}

// Movaps: MOVAPS xmm_dst, xmm_src — 0F 28 /r (packed-FP register copy).
func Movaps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x28, -1, xmmIdx(dst), xmmIdx(src))
}

// --- MOVDQU / MOVDQA (memory) ---

// Movdqu_load: MOVDQU xmm, m128 — F3 0F 6F /r (unaligned 128-bit load).
func Movdqu_load(a @asm.Assembler, xmm int, mem Operand) {
	emitSSEMem(a, 0xF3, false, 0x6F, xmm, mem)
}

// Movdqu_store: MOVDQU m128, xmm — F3 0F 7F /r (unaligned 128-bit store).
func Movdqu_store(a @asm.Assembler, mem Operand, xmm int) {
	emitSSEMem(a, 0xF3, false, 0x7F, xmm, mem)
}

// Movdqa_load: MOVDQA xmm, m128 — 66 0F 6F /r (16-byte-aligned load).
func Movdqa_load(a @asm.Assembler, xmm int, mem Operand) {
	emitSSEMem(a, 0x66, false, 0x6F, xmm, mem)
}

// Movdqa_store: MOVDQA m128, xmm — 66 0F 7F /r (16-byte-aligned store).
func Movdqa_store(a @asm.Assembler, mem Operand, xmm int) {
	emitSSEMem(a, 0x66, false, 0x7F, xmm, mem)
}

// --- String bulk fill (MemZero primitive) ---

// Rep_stosb: REP STOSB — F3 AA.  Stores AL to [RDI] and increments RDI, RCX
// times (fill RCX bytes with AL).
func Rep_stosb(a @asm.Assembler) {
	emit8(a, 0xF3)
	emit8(a, 0xAA)
}

// Rep_stosq: REP STOSQ — F3 REX.W AB.  Stores RAX to [RDI] and advances by 8,
// RCX times (fill RCX quadwords) — the wide MemZero fill.
func Rep_stosq(a @asm.Assembler) {
	emit8(a, 0xF3)
	emit8(a, 0x48)
	emit8(a, 0xAB)
}
