package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the SSE2 packed moves + string fill in
// x64_sse_mem.bn.  Expected bytes from clang.  expect3/4/5 are shared with the
// sibling SSE test files; expect2 (for REP STOSB) is local.

// expect2 checks a 2-byte instruction at offset 0.
func expect2(a @asm.Assembler, b0 int, b1 int) bool {
	var e @[]int = make_slice(int, 2)
	e[0] = b0
	e[1] = b1
	return checkBytes(a.Sections[0], 0, e)
}

func TestMovdqRegReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movdqu(a, XMM0, XMM1)
	if !expect4(a, 0xF3, 0x0F, 0x6F, 0xC1) { return fail("MOVDQU reg wrong") }
	var b @asm.Assembler = newAsm()
	Movdqa(b, XMM0, XMM1)
	if !expect4(b, 0x66, 0x0F, 0x6F, 0xC1) { return fail("MOVDQA reg wrong") }
	var c @asm.Assembler = newAsm()
	Movaps(c, XMM0, XMM1)
	if !expect3(c, 0x0F, 0x28, 0xC1) { return fail("MOVAPS reg wrong") }
	return ""
}

func TestMovdqMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movdqu_load(a, XMM0, Mem(RAX, 0, SZ64))
	if !expect4(a, 0xF3, 0x0F, 0x6F, 0x00) { return fail("MOVDQU load wrong") }
	var b @asm.Assembler = newAsm()
	Movdqu_store(b, Mem(RAX, 0, SZ64), XMM0)
	if !expect4(b, 0xF3, 0x0F, 0x7F, 0x00) { return fail("MOVDQU store wrong") }
	var c @asm.Assembler = newAsm()
	Movdqa_load(c, XMM0, Mem(RAX, 0, SZ64))
	if !expect4(c, 0x66, 0x0F, 0x6F, 0x00) { return fail("MOVDQA load wrong") }
	var d @asm.Assembler = newAsm()
	Movdqa_store(d, Mem(RAX, 0, SZ64), XMM0)
	if !expect4(d, 0x66, 0x0F, 0x7F, 0x00) { return fail("MOVDQA store wrong") }
	var e @asm.Assembler = newAsm()
	Movdqu_load(e, XMM3, Mem(RCX, 16, SZ64)) // disp8 → f3 0f 6f 59 10
	if !expect5(e, 0xF3, 0x0F, 0x6F, 0x59, 0x10) { return fail("MOVDQU disp load wrong") }
	return ""
}

func TestRepStos() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Rep_stosb(a)
	if !expect2(a, 0xF3, 0xAA) { return fail("REP STOSB wrong") }
	var b @asm.Assembler = newAsm()
	Rep_stosq(b)
	if !expect3(b, 0xF3, 0x48, 0xAB) { return fail("REP STOSQ wrong") }
	return ""
}

// expect6/expect7/expect8 check 6/7/8-byte instructions at offset 0.
func expect6(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int, b4 int, b5 int) bool {
	var e @[]int = make_slice(int, 6)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	e[4] = b4
	e[5] = b5
	return checkBytes(a.Sections[0], 0, e)
}

func expect7(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int, b4 int, b5 int, b6 int) bool {
	var e @[]int = make_slice(int, 7)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	e[4] = b4
	e[5] = b5
	e[6] = b6
	return checkBytes(a.Sections[0], 0, e)
}

func expect8(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int, b4 int, b5 int, b6 int,
		b7 int) bool {
	var e @[]int = make_slice(int, 8)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	e[4] = b4
	e[5] = b5
	e[6] = b6
	e[7] = b7
	return checkBytes(a.Sections[0], 0, e)
}

// Exercise the emitModRM/emitRex branches on the SSE memory path: disp32, SIB,
// the RBP/R12/R13 special-case bases, XMM8+ on the memory path (REX.R), a high
// base register (REX.B), and a store.  All cross-checked against clang.
func TestMovdqMemAddressing() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movdqu_load(a, XMM0, Mem(RAX, 0x1000, SZ64)) // disp32
	if !expect8(a, 0xF3, 0x0F, 0x6F, 0x80, 0x00, 0x10, 0x00, 0x00) {
		return fail("MOVDQU [rax+0x1000] wrong")
	}
	var b @asm.Assembler = newAsm()
	Movdqu_load(b, XMM0, MemIdx(RAX, RBX, 4, 0, SZ64)) // SIB base+index*4
	if !expect5(b, 0xF3, 0x0F, 0x6F, 0x04, 0x98) {
		return fail("MOVDQU [rax+rbx*4] wrong")
	}
	var c @asm.Assembler = newAsm()
	Movdqu_load(c, XMM0, Mem(RBP, 0, SZ64)) // RBP → mod=01 disp8=0
	if !expect5(c, 0xF3, 0x0F, 0x6F, 0x45, 0x00) {
		return fail("MOVDQU [rbp] wrong")
	}
	var d @asm.Assembler = newAsm()
	Movdqu_load(d, XMM0, Mem(R12, 0, SZ64)) // R12 → SIB escape + REX.B
	if !expect6(d, 0xF3, 0x41, 0x0F, 0x6F, 0x04, 0x24) {
		return fail("MOVDQU [r12] wrong")
	}
	var e @asm.Assembler = newAsm()
	Movdqu_load(e, XMM0, Mem(R13, 0, SZ64)) // R13 → mod=01 disp8=0 + REX.B
	if !expect6(e, 0xF3, 0x41, 0x0F, 0x6F, 0x45, 0x00) {
		return fail("MOVDQU [r13] wrong")
	}
	var f @asm.Assembler = newAsm()
	Movdqu_load(f, XMM8, Mem(RAX, 0, SZ64)) // XMM8 dst on mem path → REX.R
	if !expect5(f, 0xF3, 0x44, 0x0F, 0x6F, 0x00) {
		return fail("MOVDQU xmm8,[rax] wrong")
	}
	var g @asm.Assembler = newAsm()
	Movdqu_load(g, XMM0, Mem(R8, 0, SZ64)) // high base → REX.B
	if !expect5(g, 0xF3, 0x41, 0x0F, 0x6F, 0x00) {
		return fail("MOVDQU [r8] wrong")
	}
	var h @asm.Assembler = newAsm()
	Movdqu_store(h, Mem(R12, 0x40, SZ64), XMM3) // store, R12 base + disp8
	if !expect7(h, 0xF3, 0x41, 0x0F, 0x7F, 0x5C, 0x24, 0x40) {
		return fail("MOVDQU [r12+0x40],xmm3 wrong")
	}
	return ""
}
