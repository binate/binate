package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// SSE/SSE2 shuffle, broadcast, and interleave encoders (reg-reg).
//
// These build vectors from lanes: PSHUFD/SHUFPS/SHUFPD select lanes via an imm8;
// MOVDDUP broadcasts the low f64; the PUNPCK*/UNPCK* pairs interleave low/high
// lanes; PSHUFB does an arbitrary byte permute (SSSE3).  All are reg-reg via
// emitSSEReg; imm8 forms append the control byte.  Cross-checked against clang.

// The shuffle control of PSHUFD/SHUFPS/SHUFPD is an imm8 (-128..255, see
// setImm8RangeError); an out-of-range control sets an assembler error and the
// instruction emits nothing.

// Pshufd: PSHUFD xmm_dst, xmm_src, imm8 — 66 0F 70 /r ib.  imm8 picks each of
// the 4 result dwords from src (imm8=0x00 broadcasts lane 0; 0x1B reverses).
func Pshufd(a @asm.Assembler, dst int, src int, imm8 int) {
	if !immFits(cast(int64, imm8), SZ8) {
		setImm8RangeError(a, "pshufd", "control")
		return
	}
	emitSSEReg(a, 0x66, false, 0x70, -1, xmmIdx(dst), xmmIdx(src))
	emit8(a, imm8 & 0xff)
}

// Shufps: SHUFPS xmm_dst, xmm_src, imm8 — 0F C6 /r ib (result low 2 lanes from
// dst, high 2 from src, per imm8).
func Shufps(a @asm.Assembler, dst int, src int, imm8 int) {
	if !immFits(cast(int64, imm8), SZ8) {
		setImm8RangeError(a, "shufps", "control")
		return
	}
	emitSSEReg(a, 0, false, 0xC6, -1, xmmIdx(dst), xmmIdx(src))
	emit8(a, imm8 & 0xff)
}

// Shufpd: SHUFPD xmm_dst, xmm_src, imm8 — 66 0F C6 /r ib.
func Shufpd(a @asm.Assembler, dst int, src int, imm8 int) {
	if !immFits(cast(int64, imm8), SZ8) {
		setImm8RangeError(a, "shufpd", "control")
		return
	}
	emitSSEReg(a, 0x66, false, 0xC6, -1, xmmIdx(dst), xmmIdx(src))
	emit8(a, imm8 & 0xff)
}

// Movddup: MOVDDUP xmm_dst, xmm_src — F2 0F 12 /r (broadcast src's low f64 to
// both lanes; SSE3).
func Movddup(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0xF2, false, 0x12, -1, xmmIdx(dst), xmmIdx(src))
}

// --- Interleave (unpack) low / high lanes ---

// Punpckldq: PUNPCKLDQ — 66 0F 62 /r (interleave low dwords).
func Punpckldq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x62, -1, xmmIdx(dst), xmmIdx(src))
}

// Punpckhdq: PUNPCKHDQ — 66 0F 6A /r (interleave high dwords).
func Punpckhdq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x6A, -1, xmmIdx(dst), xmmIdx(src))
}

// Punpcklqdq: PUNPCKLQDQ — 66 0F 6C /r (interleave low qwords).
func Punpcklqdq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x6C, -1, xmmIdx(dst), xmmIdx(src))
}

// Punpckhqdq: PUNPCKHQDQ — 66 0F 6D /r (interleave high qwords).
func Punpckhqdq(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x6D, -1, xmmIdx(dst), xmmIdx(src))
}

// Unpcklps: UNPCKLPS — 0F 14 /r (interleave low f32 lanes).
func Unpcklps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x14, -1, xmmIdx(dst), xmmIdx(src))
}

// Unpckhps: UNPCKHPS — 0F 15 /r (interleave high f32 lanes).
func Unpckhps(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0, false, 0x15, -1, xmmIdx(dst), xmmIdx(src))
}

// Unpcklpd: UNPCKLPD — 66 0F 14 /r (interleave low f64 lanes).
func Unpcklpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x14, -1, xmmIdx(dst), xmmIdx(src))
}

// Unpckhpd: UNPCKHPD — 66 0F 15 /r (interleave high f64 lanes).
func Unpckhpd(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x15, -1, xmmIdx(dst), xmmIdx(src))
}

// Pshufb: PSHUFB xmm_dst, xmm_src — 66 0F 38 00 /r (arbitrary byte shuffle of
// dst per the index bytes in src; SSSE3, a three-byte opcode).
func Pshufb(a @asm.Assembler, dst int, src int) {
	emitSSEReg(a, 0x66, false, 0x38, 0x00, xmmIdx(dst), xmmIdx(src))
}
