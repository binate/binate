package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the SSE shuffle/broadcast/interleave encoders in
// x64_sse_shuf.bn.  Expected bytes from clang; expect3/4/5 shared with the
// sibling SSE test files.

func TestShuffles() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Pshufd(a, XMM1, XMM2, 0x00) // broadcast lane 0
	if !expect5(a, 0x66, 0x0F, 0x70, 0xCA, 0x00) { return fail("PSHUFD 0 wrong") }
	var b @asm.Assembler = newAsm()
	Pshufd(b, XMM1, XMM2, 0x1B) // reverse
	if !expect5(b, 0x66, 0x0F, 0x70, 0xCA, 0x1B) { return fail("PSHUFD 1b wrong") }
	var c @asm.Assembler = newAsm()
	Shufps(c, XMM1, XMM2, 0x00)
	if !expect4(c, 0x0F, 0xC6, 0xCA, 0x00) { return fail("SHUFPS wrong") }
	var d @asm.Assembler = newAsm()
	Shufpd(d, XMM3, XMM4, 0x01)
	if !expect5(d, 0x66, 0x0F, 0xC6, 0xDC, 0x01) { return fail("SHUFPD wrong") }
	var e @asm.Assembler = newAsm()
	Movddup(e, XMM1, XMM2)
	if !expect4(e, 0xF2, 0x0F, 0x12, 0xCA) { return fail("MOVDDUP wrong") }
	return ""
}

func TestUnpackInteger() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Punpckldq(a, XMM0, XMM1)
	if !expect4(a, 0x66, 0x0F, 0x62, 0xC1) { return fail("PUNPCKLDQ wrong") }
	var b @asm.Assembler = newAsm()
	Punpckhdq(b, XMM0, XMM1)
	if !expect4(b, 0x66, 0x0F, 0x6A, 0xC1) { return fail("PUNPCKHDQ wrong") }
	var c @asm.Assembler = newAsm()
	Punpcklqdq(c, XMM0, XMM1)
	if !expect4(c, 0x66, 0x0F, 0x6C, 0xC1) { return fail("PUNPCKLQDQ wrong") }
	var d @asm.Assembler = newAsm()
	Punpckhqdq(d, XMM0, XMM1)
	if !expect4(d, 0x66, 0x0F, 0x6D, 0xC1) { return fail("PUNPCKHQDQ wrong") }
	return ""
}

func TestUnpackFp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Unpcklps(a, XMM0, XMM1)
	if !expect3(a, 0x0F, 0x14, 0xC1) { return fail("UNPCKLPS wrong") }
	var b @asm.Assembler = newAsm()
	Unpckhps(b, XMM0, XMM1)
	if !expect3(b, 0x0F, 0x15, 0xC1) { return fail("UNPCKHPS wrong") }
	var c @asm.Assembler = newAsm()
	Unpcklpd(c, XMM0, XMM1)
	if !expect4(c, 0x66, 0x0F, 0x14, 0xC1) { return fail("UNPCKLPD wrong") }
	var d @asm.Assembler = newAsm()
	Unpckhpd(d, XMM0, XMM1)
	if !expect4(d, 0x66, 0x0F, 0x15, 0xC1) { return fail("UNPCKHPD wrong") }
	return ""
}

func TestPshufb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Pshufb(a, XMM0, XMM1) // three-byte 66 0F 38 00
	if !expect5(a, 0x66, 0x0F, 0x38, 0x00, 0xC1) { return fail("PSHUFB wrong") }
	return ""
}
