package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the SSE2 packed integer + bitwise encoders in
// x64_sse.bn.  Expected bytes were produced by assembling each mnemonic with
// clang and reading the __text section, so the encoders are pinned to the real
// ISA.  Distinct dst/src (and XMM8+ REX) cases catch ModR/M and REX bugs.

// expect4 checks a 4-byte instruction at offset 0.
func expect4(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int) bool {
	var e @[]int = make_slice(int, 4)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	return checkBytes(a.Sections[0], 0, e)
}

// expect5 checks a 5-byte instruction at offset 0.
func expect5(a @asm.Assembler, b0 int, b1 int, b2 int, b3 int, b4 int) bool {
	var e @[]int = make_slice(int, 5)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	e[4] = b4
	return checkBytes(a.Sections[0], 0, e)
}

func TestPackedAdd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Paddb(a, XMM0, XMM1)
	if !expect4(a, 0x66, 0x0F, 0xFC, 0xC1) { return fail("PADDB wrong") }
	var b @asm.Assembler = newAsm()
	Paddw(b, XMM2, XMM3)
	if !expect4(b, 0x66, 0x0F, 0xFD, 0xD3) { return fail("PADDW wrong") }
	var c @asm.Assembler = newAsm()
	Paddd(c, XMM4, XMM5)
	if !expect4(c, 0x66, 0x0F, 0xFE, 0xE5) { return fail("PADDD wrong") }
	var d @asm.Assembler = newAsm()
	Paddq(d, XMM6, XMM7)
	if !expect4(d, 0x66, 0x0F, 0xD4, 0xF7) { return fail("PADDQ wrong") }
	return ""
}

func TestPackedSub() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Psubb(a, XMM0, XMM1)
	if !expect4(a, 0x66, 0x0F, 0xF8, 0xC1) { return fail("PSUBB wrong") }
	var b @asm.Assembler = newAsm()
	Psubw(b, XMM2, XMM3)
	if !expect4(b, 0x66, 0x0F, 0xF9, 0xD3) { return fail("PSUBW wrong") }
	var c @asm.Assembler = newAsm()
	Psubd(c, XMM4, XMM5)
	if !expect4(c, 0x66, 0x0F, 0xFA, 0xE5) { return fail("PSUBD wrong") }
	var d @asm.Assembler = newAsm()
	Psubq(d, XMM6, XMM7)
	if !expect4(d, 0x66, 0x0F, 0xFB, 0xF7) { return fail("PSUBQ wrong") }
	return ""
}

func TestPackedMul() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Pmullw(a, XMM1, XMM2)
	if !expect4(a, 0x66, 0x0F, 0xD5, 0xCA) { return fail("PMULLW wrong") }
	var b @asm.Assembler = newAsm()
	Pmulld(b, XMM3, XMM4) // three-byte opcode 0F 38 40
	if !expect5(b, 0x66, 0x0F, 0x38, 0x40, 0xDC) { return fail("PMULLD wrong") }
	return ""
}

func TestPackedBitwise() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Pand(a, XMM1, XMM2)
	if !expect4(a, 0x66, 0x0F, 0xDB, 0xCA) { return fail("PAND wrong") }
	var b @asm.Assembler = newAsm()
	Por(b, XMM3, XMM4)
	if !expect4(b, 0x66, 0x0F, 0xEB, 0xDC) { return fail("POR wrong") }
	var c @asm.Assembler = newAsm()
	Pxor(c, XMM5, XMM6)
	if !expect4(c, 0x66, 0x0F, 0xEF, 0xEE) { return fail("PXOR wrong") }
	var d @asm.Assembler = newAsm()
	Pandn(d, XMM7, XMM8) // REX.B for XMM8 src → 66 41 0F DF F8
	if !expect5(d, 0x66, 0x41, 0x0F, 0xDF, 0xF8) { return fail("PANDN wrong") }
	return ""
}

// REX.R / REX.B / both, to pin the high-register prefix.
func TestPackedRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Paddd(a, XMM8, XMM1) // REX.R → 66 44 0F FE C1
	if !expect5(a, 0x66, 0x44, 0x0F, 0xFE, 0xC1) { return fail("PADDD REX.R wrong") }
	var b @asm.Assembler = newAsm()
	Paddd(b, XMM0, XMM9) // REX.B → 66 41 0F FE C1
	if !expect5(b, 0x66, 0x41, 0x0F, 0xFE, 0xC1) { return fail("PADDD REX.B wrong") }
	var c @asm.Assembler = newAsm()
	Pxor(c, XMM10, XMM11) // REX.R+B → 66 45 0F EF D3
	if !expect5(c, 0x66, 0x45, 0x0F, 0xEF, 0xD3) { return fail("PXOR REX.RB wrong") }
	return ""
}
