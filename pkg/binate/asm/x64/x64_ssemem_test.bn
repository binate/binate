package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for the SSE eightbyte memory-image moves in x64_fp.bn
// (MOVLPS / MOVSS, the SysV aggregate pass/return movers).  Byte sequences
// cross-checked against `as -arch x86_64`: MOVLPS store 0F 13, load 0F 12;
// MOVSS store F3 0F 11, load F3 0F 10.

// exp3 / exp4 build a fixed-length expected-byte slice.
func exp3(b0 int, b1 int, b2 int) @[]int {
	var e @[]int = make_slice(int, 3)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	return e
}

func exp4(b0 int, b1 int, b2 int, b3 int) @[]int {
	var e @[]int = make_slice(int, 4)
	e[0] = b0
	e[1] = b1
	e[2] = b2
	e[3] = b3
	return e
}

// MOVLPS XMM0, [RAX] = 0F 12 00 (load low quadword).
func TestMovlpsLoad() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM0, Mem(RAX, 0, SZ64))
	if !checkBytes(a.Sections[0], 0, exp3(0x0F, 0x12, 0x00)) {
		return fail("MOVLPS XMM0, [RAX] encoding wrong")
	}
	return ""
}

// MOVLPS [RAX], XMM0 = 0F 13 00 (store low quadword).
func TestMovlpsStore() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_store(a, Mem(RAX, 0, SZ64), XMM0)
	if !checkBytes(a.Sections[0], 0, exp3(0x0F, 0x13, 0x00)) {
		return fail("MOVLPS [RAX], XMM0 encoding wrong")
	}
	return ""
}

// MOVLPS [R15], XMM15 = 45 0F 13 3F — REX.R (XMM15) + REX.B (R15); ModR/M
// mod=00 reg=111 rm=111.
func TestMovlpsStoreHigh() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_store(a, Mem(R15, 0, SZ64), XMM15)
	if !checkBytes(a.Sections[0], 0, exp4(0x45, 0x0F, 0x13, 0x3F)) {
		return fail("MOVLPS [R15], XMM15 encoding wrong")
	}
	return ""
}

// MOVLPS XMM1, [RBX+8] = 0F 12 4B 08 — mod=01 disp8, reg=001 (XMM1), rm=011 (RBX).
func TestMovlpsLoadDisp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movlps_load(a, XMM1, Mem(RBX, 8, SZ64))
	if !checkBytes(a.Sections[0], 0, exp4(0x0F, 0x12, 0x4B, 0x08)) {
		return fail("MOVLPS XMM1, [RBX+8] encoding wrong")
	}
	return ""
}

// MOVSS XMM0, [RAX] = F3 0F 10 00 (load low dword).
func TestMovssLoad() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_load(a, XMM0, Mem(RAX, 0, SZ32))
	if !checkBytes(a.Sections[0], 0, exp4(0xF3, 0x0F, 0x10, 0x00)) {
		return fail("MOVSS XMM0, [RAX] encoding wrong")
	}
	return ""
}

// MOVSS [RAX], XMM0 = F3 0F 11 00 (store low dword).
func TestMovssStore() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Movss_store(a, Mem(RAX, 0, SZ32), XMM0)
	if !checkBytes(a.Sections[0], 0, exp4(0xF3, 0x0F, 0x11, 0x00)) {
		return fail("MOVSS [RAX], XMM0 encoding wrong")
	}
	return ""
}
