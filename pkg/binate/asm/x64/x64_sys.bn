package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- NOPs ---

// NOP: 0x90
func Nop(a @asm.Assembler) {
	emit8(a, 0x90)
}

// NopN: one n-byte NOP (1 <= n <= 9), the Intel SDM's recommended form for n
// (Vol. 2B, NOP, "Recommended Multi-Byte Sequence"):
//   1: 90                          6: 66 0F 1F 44 00 00
//   2: 66 90                       7: 0F 1F 80 00 00 00 00
//   3: 0F 1F 00                    8: 0F 1F 84 00 00 00 00 00
//   4: 0F 1F 40 00                 9: 66 0F 1F 84 00 00 00 00 00
//   5: 0F 1F 44 00 00
func NopN(a @asm.Assembler, n int) {
	if n < 1 || n > 9 {
		a.SetError("x64: nop length out of range (1..9)")
		return
	}
	if n == 1 {
		emit8(a, 0x90)
		return
	}
	if n == 2 || n == 6 || n == 9 {
		emit8(a, 0x66) // operand-size prefix: the 16-bit form of the next NOP
	}
	if n == 2 {
		emit8(a, 0x90)
		return
	}
	emit8(a, 0x0F)
	emit8(a, 0x1F)
	var zeros int
	if n == 3 {
		emit8(a, 0x00) // ModRM [rax]
		return
	} else if n == 4 {
		emit8(a, 0x40) // ModRM [rax+disp8]
		zeros = 1
	} else if n == 5 || n == 6 {
		emit8(a, 0x44) // ModRM [SIB+disp8], SIB [rax+rax*1]
		zeros = 2
	} else if n == 7 {
		emit8(a, 0x80) // ModRM [rax+disp32]
		zeros = 4
	} else {
		emit8(a, 0x84) // ModRM [SIB+disp32], SIB [rax+rax*1]
		zeros = 5
	}
	for i := 0; i < zeros; i++ {
		emit8(a, 0x00)
	}
}

// AlignNops pads with the fewest NOPs (each at most 9 bytes) to the next
// multiple of alignment, then raises the section's alignment to it.
func AlignNops(a @asm.Assembler, alignment int) {
	if alignment <= 0 || (alignment & (alignment - 1)) != 0 {
		a.SetError("x64: alignment must be a positive power of two")
		return
	}
	var pad int = cast(int, a.CurrentOffset() % cast(uint64, alignment))
	if pad != 0 {
		pad = alignment - pad
	}
	for pad > 0 {
		var n int = pad
		if n > 9 {
			n = 9
		}
		NopN(a, n)
		pad = pad - n
	}
	a.Align(alignment)
}

// --- Fixup resolution ---

// writeI32 writes a little-endian 32-bit integer to a byte slice.
func writeI32(data *[]uint8, off int, val int) {
	data[off] = cast(uint8, val & 0xFF)
	data[off + 1] = cast(uint8, (val >> 8) & 0xFF)
	data[off + 2] = cast(uint8, (val >> 16) & 0xFF)
	data[off + 3] = cast(uint8, (val >> 24) & 0xFF)
}

// patchRel32 patches a 32-bit PC-relative displacement.
// The fixup offset points to the start of the 4-byte displacement
// field, and the displacement is computed from the field's end
// (fixup_addr + 4).  On x86-64 the CPU measures it from the end of the
// instruction, which is the field's end unless an immediate follows it;
// such an instruction's fixup addend is already reduced by the
// immediate's size (emitModRMImm), so targetOff accounts for it.
func patchRel32(data *[]uint8, fixOff int, targetOff int64) bool {
	// rel32 = target - (fixup + 4)
	var rel int64 = targetOff - cast(int64, fixOff + 4)
	// Check 32-bit signed range
	if rel < -2147483648 || rel > 2147483647 {
		return false
	}
	writeI32(data, fixOff, cast(int, rel))
	return true
}

// machoRel8InPlace reports whether a Mach-O rel8 (FIX_REL8) to sym, in the fixup's own section,
// plus addend is patched in place rather than relocated, its displacement not otherwise fixed:
// ld64 drops a 1-byte branch relocation's addend (lld keeps it), so one that would carry an
// addend — written, or an unlisted label's offset from its atom's symbol, where the writer moves
// the reference (asm.MachoListed) — is fixed here when the linker keeps the section whole (no
// SubsectionsViaSymbols).  Any other is relocated, the writer rejecting an addend.
func machoRel8InPlace(a @asm.Assembler, sym asm.Symbol, addend int64, starts @[]int) bool {
	if a.ObjFormat != asm.OBJ_MACHO || a.SubsectionsViaSymbols { return false }
	if !asm.MachoListed(sym) {
		var base int64 = 0
		var c int = a.AtomOf(starts, sym)
		if c >= 0 { base = cast(int64, a.Symbols[c].Offset) }
		addend = addend + cast(int64, sym.Offset) - base
	}
	return addend != 0
}

// ResolveFixups resolves all same-section x86-64 fixups by patching
// instruction bytes. Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool {
	var ok bool = true
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		// bnlint:allow managed-to-raw-assign - sec is a live @asm.Section; Data outlives the read
		var data *[]uint8 = sec.Data
		var starts @[]int
		if a.ObjFormat != asm.OBJ_ELF { starts = a.AtomStarts(si) }
		for fi := 0; fi < sec.NumFixups; fi++ {
			var fix asm.Fixup = sec.Fixups[fi]
			// Both FIX_REL32 (CALL/JMP/Jcc) and FIX_REL32_LEA
			// (LEA-RIP-rel) use the same intra-section rel32 patch
			// shape — only the cross-section Mach-O reloc type
			// differs (BRANCH vs SIGNED) — and FIX_REL8 (LOOP, JRCXZ)
			// its 1-byte form.  Patch each kind here.
			if fix.Kind != FIX_REL32 && fix.Kind != FIX_REL32_LEA && fix.Kind != FIX_REL8 {
				continue
			}
			// Look up the target symbol
			// bnlint:allow managed-to-raw-assign - fix is a live fixup; Label outlives the read
			var symName *[]readonly char = fix.Label
			var symIdx int = a.LookupSymbol(symName)
			if symIdx < 0 { continue }
			var sym asm.Symbol = a.Symbols[symIdx]
			// Skip external or cross-section symbols
			if sym.Section < 0 || sym.Section != si { continue }
			// A branch (FIX_REL32) or RIP-relative reference (FIX_REL32_LEA) to a
			// symbol in the same section is patched in place only when its
			// displacement is fixed at assembly time (asm.Assembler.DisplacementFixed:
			// within one Mach-O atom, to a local symbol on ELF); anything else — a
			// call to another function, a reference the linker may separate from its
			// target — is left for Finalize to relocate.
			var fixupAddr int = cast(int, fix.Offset)
			if !a.DisplacementFixed(sym, fixupAddr, starts, false) &&
					!(fix.Kind == FIX_REL8 && machoRel8InPlace(a, sym, fix.Addend, starts)) {
				continue
			}

			var targetAddr int64 = cast(int64, sym.Offset) + fix.Addend

			if fix.Kind == FIX_REL8 {
				// rel8 = target - (fixup + 1)
				var rel8 int64 = targetAddr - cast(int64, fixupAddr + 1)
				if rel8 < -128 || rel8 > 127 {
					a.SetError(
							buf.Concat(buf.Concat("x64: reference to '", asm.LabelForMessage(symName)),
									"' is out of rel8 range"))
					ok = false
					continue
				}
				data[fixupAddr] = cast(uint8, rel8 & 0xFF)
				a.MarkFixupResolved(si, fi)
				continue
			}
			if !patchRel32(data, fixupAddr, targetAddr) {
				a.SetError(
						buf.Concat(buf.Concat("x64: reference to '", asm.LabelForMessage(symName)),
								"' is out of rel32 range"))
				ok = false
				continue
			}
			a.MarkFixupResolved(si, fi)
		}
	}
	return ok
}
