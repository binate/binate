package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- System instructions ---

// NOP: 0x90
func Nop(a @asm.Assembler) {
	emit8(a, 0x90)
}

// SYSCALL: 0F 05
func Syscall(a @asm.Assembler) {
	emit8(a, 0x0F)
	emit8(a, 0x05)
}

// INT imm8: CD ib
func Int(a @asm.Assembler, vec int) {
	emit8(a, 0xCD)
	emit8(a, vec)
}

// --- Fixup resolution ---

// readI32 reads a little-endian 32-bit signed integer from a byte slice.
func readI32(data *[]uint8, off int) int {
	var b0 int = cast(int, data[off])
	var b1 int = cast(int, data[off + 1])
	var b2 int = cast(int, data[off + 2])
	var b3 int = cast(int, data[off + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// writeI32 writes a little-endian 32-bit integer to a byte slice.
func writeI32(data *[]uint8, off int, val int) {
	data[off] = cast(uint8, val & 0xFF)
	data[off + 1] = cast(uint8, (val >> 8) & 0xFF)
	data[off + 2] = cast(uint8, (val >> 16) & 0xFF)
	data[off + 3] = cast(uint8, (val >> 24) & 0xFF)
}

// patchRel32 patches a 32-bit PC-relative displacement.
// The fixup offset points to the start of the 4-byte displacement
// field. On x86-64, the displacement is relative to the end of the
// instruction (i.e., fixup_addr + 4).
func patchRel32(data *[]uint8, fixOff int, targetOff int) bool {
	// rel32 = target - (fixup + 4)
	var rel int = targetOff - (fixOff + 4)
	// Check 32-bit signed range
	if rel < -2147483648 || rel > 2147483647 {
		return false
	}
	writeI32(data, fixOff, rel)
	return true
}

// isAtomStartSymbol reports whether name begins a linker atom under
// MH_SUBSECTIONS_VIA_SYMBOLS — i.e. it is NOT a `L`-prefixed local label.
// ld starts a new atom at every defined symbol except `L`-prefixed ones
// (block labels, string/refcount temporaries), so a CALL/JMP/Jcc/LEA
// whose target is atom-starting may cross an atom boundary the linker can
// relocate independently and must go through a relocation, not an
// assembly-time displacement.  Mirrors aarch64's helper of the same name.
func isAtomStartSymbol(name *[]readonly char) bool {
	return len(name) == 0 || name[0] != 'L'
}

// ResolveFixups resolves all same-section x86-64 fixups by patching
// instruction bytes. Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool {
	var ok bool = true
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		var data *[]uint8 = sec.Data
		for fi := 0; fi < sec.NumFixups; fi++ {
			var fix asm.Fixup = sec.Fixups[fi]
			// Both FIX_REL32 (CALL/JMP/Jcc) and FIX_REL32_LEA
			// (LEA-RIP-rel) use the same intra-section rel32 patch
			// shape — only the cross-section Mach-O reloc type
			// differs (BRANCH vs SIGNED).  Patch either kind here.
			if fix.Kind != FIX_REL32 && fix.Kind != FIX_REL32_LEA {
				continue
			}
			// Look up the target symbol
			var symName *[]readonly char = fix.Label
			var symIdx int = a.LookupSymbol(symName)
			if symIdx < 0 { continue }
			var sym asm.Symbol = a.Symbols[symIdx]
			// Skip external or cross-section symbols
			if sym.Section < 0 || sym.Section != si { continue }
			// Under MH_SUBSECTIONS_VIA_SYMBOLS ld may relocate each atom
			// independently (coalesce/reorder/dead-strip), so any reference
			// that crosses an atom boundary must go through a relocation, not
			// a baked-in displacement.  The ONLY intra-atom reference is a
			// branch (FIX_REL32) to an `L`-prefixed block label — it stays
			// within the function's own atom, so resolve it here.  Everything
			// else is inter-atom and is left for Finalize to relocate:
			//   - a branch to a non-`L` (atom-start) symbol — an inter-function
			//     call/jump;
			//   - ANY RIP-relative data reference (FIX_REL32_LEA) — the target
			//     (string / global) lives in a different atom than the code,
			//     even an `L`-prefixed `Lstr_*` string label.  This mirrors
			//     aarch64, whose ADRP+ADD data references are ALWAYS relocated.
			//     Resolving an `Lstr_*` LEA in-section bakes a stale
			//     displacement once ld moves the string's atom, corrupting
			//     every string constant under subsections.
			if fix.Kind == FIX_REL32_LEA || isAtomStartSymbol(sym.Name) { continue }

			var targetAddr int = cast(int, sym.Offset) + fix.Addend
			var fixupAddr int = cast(int, fix.Offset)

			if !patchRel32(data, fixupAddr, targetAddr) {
				ok = false
			}
			a.MarkFixupResolved(si, fi)
		}
	}
	return ok
}
