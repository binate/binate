package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- System instructions ---

// NOP: 0x90
func Nop(a @asm.Assembler) {
	emit8(a, 0x90)
}

// SYSCALL: 0F 05
func Syscall(a @asm.Assembler) {
	emit8(a, 0x0F)
	emit8(a, 0x05)
}

// INT imm8: CD ib.  vec is an imm8 (-128..255, see setImm8RangeError); an
// out-of-range vec sets an assembler error and emits nothing.
func Int(a @asm.Assembler, vec int) {
	if !immFits(cast(int64, vec), SZ8) {
		setImm8RangeError(a, "int", "vector")
		return
	}
	emit8(a, 0xCD)
	emit8(a, vec)
}

// --- Fixup resolution ---

// writeI32 writes a little-endian 32-bit integer to a byte slice.
func writeI32(data *[]uint8, off int, val int) {
	data[off] = cast(uint8, val & 0xFF)
	data[off + 1] = cast(uint8, (val >> 8) & 0xFF)
	data[off + 2] = cast(uint8, (val >> 16) & 0xFF)
	data[off + 3] = cast(uint8, (val >> 24) & 0xFF)
}

// patchRel32 patches a 32-bit PC-relative displacement.
// The fixup offset points to the start of the 4-byte displacement
// field. On x86-64, the displacement is relative to the end of the
// instruction (i.e., fixup_addr + 4).
func patchRel32(data *[]uint8, fixOff int, targetOff int) bool {
	// rel32 = target - (fixup + 4)
	var rel int = targetOff - (fixOff + 4)
	// Check 32-bit signed range
	if rel < -2147483648 || rel > 2147483647 {
		return false
	}
	writeI32(data, fixOff, rel)
	return true
}

// ResolveFixups resolves all same-section x86-64 fixups by patching
// instruction bytes. Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool {
	var ok bool = true
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		// bnlint:allow managed-to-raw-assign - sec is a live @asm.Section; Data outlives the read
		var data *[]uint8 = sec.Data
		var starts @[]int
		if a.ObjFormat != asm.OBJ_ELF { starts = a.AtomStarts(si) }
		for fi := 0; fi < sec.NumFixups; fi++ {
			var fix asm.Fixup = sec.Fixups[fi]
			// Both FIX_REL32 (CALL/JMP/Jcc) and FIX_REL32_LEA
			// (LEA-RIP-rel) use the same intra-section rel32 patch
			// shape — only the cross-section Mach-O reloc type
			// differs (BRANCH vs SIGNED).  Patch either kind here.
			if fix.Kind != FIX_REL32 && fix.Kind != FIX_REL32_LEA {
				continue
			}
			// Look up the target symbol
			// bnlint:allow managed-to-raw-assign - fix is a live fixup; Label outlives the read
			var symName *[]readonly char = fix.Label
			var symIdx int = a.LookupSymbol(symName)
			if symIdx < 0 { continue }
			var sym asm.Symbol = a.Symbols[symIdx]
			// Skip external or cross-section symbols
			if sym.Section < 0 || sym.Section != si { continue }
			// A branch (FIX_REL32) or RIP-relative reference (FIX_REL32_LEA) to a
			// symbol in the same section is patched in place only when its
			// displacement is fixed at assembly time (asm.Assembler.DisplacementFixed:
			// within one Mach-O atom, to a local symbol on ELF); anything else — a
			// call to another function, a reference the linker may separate from its
			// target — is left for Finalize to relocate.
			var fixupAddr int = cast(int, fix.Offset)
			if !a.DisplacementFixed(sym, fixupAddr, starts) { continue }

			var targetAddr int = cast(int, sym.Offset) + fix.Addend

			if !patchRel32(data, fixupAddr, targetAddr) {
				a.SetError(buf.Concat(buf.Concat("x64: reference to '", symName), "' is out of rel32 range"))
				ok = false
				continue
			}
			a.MarkFixupResolved(si, fi)
		}
	}
	return ok
}
