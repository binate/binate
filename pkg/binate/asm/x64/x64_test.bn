package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// readByte reads a single byte from section data.
func readByte(s @asm.Section, off int) int {
	return cast(int, s.Data[off])
}

// readBytes returns a slice of bytes from the section for comparison.
// Returns the bytes as a hex-comparable string for error messages.
func checkBytes(s @asm.Section, off int, expected @[]int) bool {
	for i := 0; i < len(expected); i++ {
		if cast(int, s.Data[off + i]) != expected[i] {
			return false
		}
	}
	return true
}

// hexNibble returns the value of hex digit c (0-9, a-f, A-F), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return -1
}

// hexBytes parses objdump-style hex byte pairs (e.g. "66 81 e1 34 12";
// non-hex characters are ignored) into the byte values they spell.
func hexBytes(h *[]readonly char) @[]int {
	var digits int = 0
	for i := 0; i < len(h); i++ {
		if hexNibble(h[i]) >= 0 { digits++ }
	}
	var out @[]int = make_slice(int, digits / 2)
	var k int = 0
	var hi int = -1
	for i := 0; i < len(h); i++ {
		var v int = hexNibble(h[i])
		if v >= 0 {
			if hi < 0 {
				hi = v
			} else {
				out[k] = hi * 16 + v
				k++
				hi = -1
			}
		}
	}
	return out
}

// emitsExactly reports whether the assembler recorded no error and its
// section holds exactly the bytes spelled by hex (see hexBytes) — no
// fewer and, unlike checkBytes, no more.
func emitsExactly(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var s @asm.Section = a.Sections[0]
	var want @[]int = hexBytes(hex)
	if s.Len != len(want) { return false }
	return checkBytes(s, 0, want)
}

// rejected reports whether the assembler recorded an error and emitted
// no bytes — how an encoder reports an unencodable operand.
func rejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0
}

// --- Register constants ---

func TestRegisterConstants() testing.TestResult {
	if RAX != 0 || RCX != 1 || RDX != 2 || RBX != 3 {
		return fail("RAX-RBX wrong")
	}
	if RSP != 4 || RBP != 5 || RSI != 6 || RDI != 7 {
		return fail("RSP-RDI wrong")
	}
	if R8 != 8 || R15 != 15 {
		return fail("R8-R15 wrong")
	}
	return ""
}

// --- Condition code constants ---

func TestConditionCodes() testing.TestResult {
	if CC_E != 4 || CC_NE != 5 || CC_L != 12 || CC_G != 15 {
		return fail("condition codes wrong")
	}
	if CC_Z != CC_E || CC_NZ != CC_NE {
		return fail("aliases wrong")
	}
	return ""
}

// An instruction marks its section as holding instructions (Section.HasInstructions), even a
// section made without SF_EXEC; data does not.
func TestInstructionMarksSection() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.EmitUint8(1)
	if a.Sections[0].HasInstructions { return fail("data marked the section") }
	Ret(a)
	if a.HasError { return fail(a.ErrorMsg) }
	if !a.Sections[0].HasInstructions { return fail("the section is not marked") }
	return ""
}
