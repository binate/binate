package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for the thread-local operands, MemSym and RipTls (x64.bn's emitDisp32, x64_rip.bn's
// ripTlsOk).  Expected bytes are clang's (`clang --target=x86_64-linux-gnu -c`, Intel syntax);
// the relocated field is a zero placeholder.

// tlsFixupAt reports whether the assembler holds exactly one fixup, of kind kind against x with
// the given addend, at byte off.
func tlsFixupAt(a @asm.Assembler, kind int, off int, addend int64) bool {
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return false }
	var fix asm.Fixup = s.Fixups[0]
	if fix.Kind != kind || cast(int, fix.Offset) != off || fix.Addend != addend { return false }
	return len(fix.Label) == 1 && fix.Label[0] == 'x'
}

// A MemSym displacement is always 32 bits, its fixup the addend: `mov eax, dword ptr [rax +
// x@TPOFF + 8]` 8B 80 + 0; `[x@TPOFF]` the absolute 8B 04 25; `lea rax, [rbx + rcx*8 +
// x@DTPOFF]` 48 8D 84 CB; `[rcx*4 + x@TPOFF]` 8B 04 8D; `[rsp + x@TPOFF]` 8B 84 24; `[rbp +
// x@TPOFF]` 8B 85; `mov rax, qword ptr [r12 + x@TPOFF - 4]` 49 8B 84 24; `mov r9d, dword ptr
// [r13 + r14*2 + x@DTPOFF]` 47 8B 8C 75.
func TestMemSymForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ32), MemSym(RAX, -1, 1, "x", FIX_TPOFF32, 8, SZ32))
	if !emitsExactly(a, "8b 80 00 00 00 00") || !tlsFixupAt(a, FIX_TPOFF32, 2, 8) {
		return fail("mov eax, dword ptr [rax + x@TPOFF + 8]")
	}
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), MemSym(-1, -1, 1, "x", FIX_TPOFF32, 0, SZ32))
	if !emitsExactly(a, "8b 04 25 00 00 00 00") || !tlsFixupAt(a, FIX_TPOFF32, 3, 0) {
		return fail("mov eax, dword ptr [x@TPOFF]")
	}
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), MemSym(RBX, RCX, 8, "x", FIX_DTPOFF32, 0, 0))
	if !emitsExactly(a, "48 8d 84 cb 00 00 00 00") || !tlsFixupAt(a, FIX_DTPOFF32, 4, 0) {
		return fail("lea rax, [rbx + rcx*8 + x@DTPOFF]")
	}
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), MemSym(-1, RCX, 4, "x", FIX_TPOFF32, 0, SZ32))
	if !emitsExactly(a, "8b 04 8d 00 00 00 00") || !tlsFixupAt(a, FIX_TPOFF32, 3, 0) {
		return fail("mov eax, dword ptr [rcx*4 + x@TPOFF]")
	}
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), MemSym(RSP, -1, 1, "x", FIX_TPOFF32, 0, SZ32))
	Mov(a, Reg(RAX, SZ32), MemSym(RBP, -1, 1, "x", FIX_TPOFF32, 0, SZ32))
	if !emitsExactly(a, "8b 84 24 00 00 00 00 8b 85 00 00 00 00") {
		return fail("mov eax, dword ptr [rsp + x@TPOFF] / [rbp + x@TPOFF]")
	}
	a = newAsm()
	Mov(a, Reg(RAX, SZ64), MemSym(R12, -1, 1, "x", FIX_TPOFF32, -4, SZ64))
	if !emitsExactly(a, "49 8b 84 24 00 00 00 00") || !tlsFixupAt(a, FIX_TPOFF32, 4, -4) {
		return fail("mov rax, qword ptr [r12 + x@TPOFF - 4]")
	}
	a = newAsm()
	Mov(a, Reg(R9, SZ32), MemSym(R13, R14, 2, "x", FIX_DTPOFF32, 0, SZ32))
	if !emitsExactly(a, "47 8b 8c 75 00 00 00 00") || !tlsFixupAt(a, FIX_DTPOFF32, 4, 0) {
		return fail("mov r9d, dword ptr [r13 + r14*2 + x@DTPOFF]")
	}
	return ""
}

// An immediate after a MemSym displacement leaves its addend alone (the offset is absolute):
// `add dword ptr [x@TPOFF], 5` 83 04 25 + 0 + 05; `mov dword ptr [rax + x@TPOFF], 5` C7 80;
// and `mov byte ptr [rax + x@TPOFF], 5` C6 80.
func TestMemSymBesideImmediate() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, MemSym(-1, -1, 1, "x", FIX_TPOFF32, 0, SZ32), Imm(5))
	if !emitsExactly(a, "83 04 25 00 00 00 00 05") || !tlsFixupAt(a, FIX_TPOFF32, 3, 0) {
		return fail("add dword ptr [x@TPOFF], 5")
	}
	a = newAsm()
	Mov(a, MemSym(RAX, -1, 1, "x", FIX_TPOFF32, 0, SZ32), Imm(5))
	if !emitsExactly(a, "c7 80 00 00 00 00 05 00 00 00") || !tlsFixupAt(a, FIX_TPOFF32, 2, 0) {
		return fail("mov dword ptr [rax + x@TPOFF], 5")
	}
	a = newAsm()
	Mov(a, MemSym(RAX, -1, 1, "x", FIX_TPOFF32, 0, SZ8), Imm(5))
	if !emitsExactly(a, "c6 80 00 00 00 00 05") { return fail("mov byte ptr [rax + x@TPOFF], 5") }
	return ""
}

// A RipTls operand is a RIP-relative one with its own fixup kind: `mov rax, qword ptr [rip +
// x@GOTTPOFF]` 48 8B 05; `add rax, …` 48 03 05; `mov r11, …` 4C 8B 1D; `lea rdi, [rip +
// x@TLSGD]` / `@TLSLD` 48 8D 3D; `lea rax, [rip + x@tlsdesc]` 48 8D 05; and `cmp qword ptr [rip
// + x@GOTTPOFF], 5` 48 83 3D + 0 + 05, its addend -1 for the immediate (clang's x-0x5).
func TestRipTlsForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), RipTls("x", FIX_GOTTPOFF))
	if !emitsExactly(a, "48 8b 05 00 00 00 00") || !tlsFixupAt(a, FIX_GOTTPOFF, 3, 0) {
		return fail("mov rax, qword ptr [rip + x@GOTTPOFF]")
	}
	a = newAsm()
	Add(a, Reg(RAX, SZ64), RipTls("x", FIX_GOTTPOFF))
	if !emitsExactly(a, "48 03 05 00 00 00 00") { return fail("add rax, [rip + x@GOTTPOFF]") }
	a = newAsm()
	Mov(a, Reg(R11, SZ64), RipTls("x", FIX_GOTTPOFF))
	if !emitsExactly(a, "4c 8b 1d 00 00 00 00") { return fail("mov r11, [rip + x@GOTTPOFF]") }
	a = newAsm()
	Lea(a, Reg(RDI, SZ64), RipTls("x", FIX_TLSGD))
	if !emitsExactly(a, "48 8d 3d 00 00 00 00") || !tlsFixupAt(a, FIX_TLSGD, 3, 0) {
		return fail("lea rdi, [rip + x@TLSGD]")
	}
	a = newAsm()
	Lea(a, Reg(RDI, SZ64), RipTls("x", FIX_TLSLD))
	if !emitsExactly(a, "48 8d 3d 00 00 00 00") || !tlsFixupAt(a, FIX_TLSLD, 3, 0) {
		return fail("lea rdi, [rip + x@TLSLD]")
	}
	a = newAsm()
	Lea(a, Reg(RAX, SZ64), RipTls("x", FIX_TLSDESC))
	if !emitsExactly(a, "48 8d 05 00 00 00 00") || !tlsFixupAt(a, FIX_TLSDESC, 3, 0) {
		return fail("lea rax, [rip + x@tlsdesc]")
	}
	a = newAsm()
	var slot Operand = RipTls("x", FIX_GOTTPOFF)
	slot.Size = SZ64
	Cmp(a, slot, Imm(5))
	if !emitsExactly(a, "48 83 3d 00 00 00 00 05") || !tlsFixupAt(a, FIX_GOTTPOFF, 3, -1) {
		return fail("cmp qword ptr [rip + x@GOTTPOFF], 5")
	}
	return ""
}

// A thread-local operand with a kind it has no encoding for, or a RipTls with an addend, is an
// error: a MemSym of a RIP-relative kind or of none, a RipTls of an absolute kind or of none (not
// a plain `[rip + x]`), a symbolic OP_MEM with no base or index that is not absolute (MemDisp's
// RIP-relative form).
func TestTlsOperandRejects() testing.TestResult {
	var bad @[]Operand = make_slice(Operand, 7)
	bad[0] = MemSym(RAX, -1, 1, "x", FIX_GOTTPOFF, 0, SZ64)
	bad[1] = MemSym(RAX, -1, 1, "x", 0, 0, SZ64)
	bad[2] = RipTls("x", FIX_TPOFF32)
	bad[3] = RipTls("x", FIX_REL32_LEA)
	bad[4] = RipTls("x", FIX_TLSGD)
	bad[4].Imm = 4
	bad[5] = MemSym(-1, -1, 1, "x", FIX_TPOFF32, 0, SZ64)
	bad[5].Abs = false
	bad[6] = RipTls("x", 0)
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		Mov(a, Reg(RAX, SZ64), bad[i])
		if !a.HasError { return fail("a thread-local operand with no encoding was taken") }
	}
	return ""
}
