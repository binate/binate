package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// Memory operands with a vector index (VSIB): a gather's or a scatter's.

// IsVsib reports whether op is a memory operand with a vector index; see x64.bni.
func IsVsib(op Operand) bool { return op.Kind == OP_MEM && op.Vsib != 0 }

// MemVsib creates a memory operand with a vector index; see x64.bni.
func MemVsib(base int, index int, scale int, disp int, size int, vsib int) Operand {
	var op Operand = MemIdx(base, index, scale, disp, size)
	op.Vsib = vsib
	return op
}

// EmitModRMVsib emits a vector index's memory operand's ModR/M, SIB and displacement; see x64.bni.
// (Its index is never none, so the SIB always follows ModR/M; it is never `[rip + label]`, whose
// rel32 would count past what follows.)
func EmitModRMVsib(a @asm.Assembler, regField int, rm Operand) {
	emitModRMVsibN(a, regField, rm, 1)
}

// emitModRMVsibN is EmitModRMVsib with the displacement compressed by n (EmitModRMN's).
func emitModRMVsibN(a @asm.Assembler, regField int, rm Operand, n int) {
	if !IsVsib(rm) || rm.Index < 0 || rm.Index > 31 ||
			(rm.Vsib != SZ128 && rm.Vsib != SZ256 && rm.Vsib != SZ512) {
		a.SetError("x64: EmitModRMVsib takes a memory operand with an XMM, YMM or ZMM index (VSIB)")
		return
	}
	emitMemModRM(a, regField, rm, n)
}
