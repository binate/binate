package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Memory operands with a vector index (x64_vsib.bn) as clang encodes a gather's (`clang -target
// x86_64-linux-gnu -c`, Intel syntax; the ModR/M byte on, reg field 1): a SIB always, index 4
// (XMM4) a register, no base, RSP / RBP bases, displacements; and every other encoder's refusal.

func TestEmitModRMVsib() testing.TestResult {
	var a @asm.Assembler = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RAX, 2, 4, 0, 0, SZ128))
	if !emitsExactly(a, "0c 90") { return fail("[rax + xmm2*4]") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(-1, 2, 4, 16, 0, SZ128))
	if !emitsExactly(a, "0c 95 10 00 00 00") { return fail("[xmm2*4 + 16]") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RAX, 4, 4, 0, 0, SZ256))
	if !emitsExactly(a, "0c a0") { return fail("[rax + ymm4*4]: index 4 is a register") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RSP, 2, 4, 0, 0, SZ128))
	if !emitsExactly(a, "0c 94") { return fail("[rsp + xmm2*4]") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RBP, 2, 4, 0, 0, SZ128))
	if !emitsExactly(a, "4c 95 00") { return fail("[rbp + xmm2*4]") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RAX, 2, 4, 128, 0, SZ128))
	if !emitsExactly(a, "8c 90 80 00 00 00") { return fail("[rax + xmm2*4 + 128]") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(R12, 12, 8, 0, 0, SZ128))
	if !emitsExactly(a, "0c e4") { return fail("[r12 + xmm12*8]") }
	return ""
}

// A vector index is IsVsib's, not IsMem's; EmitModRM refuses it, EmitModRMVsib any other operand.
func TestVsibOnly() testing.TestResult {
	var v Operand = MemVsib(RAX, 2, 4, 0, 0, SZ128)
	if IsMem(v) || !IsVsib(v) || IsVsib(Mem(RAX, 0, 0)) || !IsMem(Mem(RAX, 0, 0)) {
		return fail("IsVsib")
	}
	var a @asm.Assembler = newAsm()
	EmitModRM(a, 1, v)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("EmitModRM with a vector index") }
	a = newAsm()
	Mov(a, Reg(RAX, SZ32), v)
	if !a.HasError { return fail("mov eax, [rax + xmm2*4]") }
	a = newAsm()
	EmitModRMVsib(a, 1, Mem(RAX, 0, 0))
	if !a.HasError { return fail("EmitModRMVsib with a general index") }
	a = newAsm()
	EmitModRMVsib(a, 1, MemVsib(RAX, 2, 4, 0, 0, SZ64))
	if !a.HasError { return fail("EmitModRMVsib with a 64-bit vector index") }
	return ""
}
