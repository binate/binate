package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for x64_x87.bn — the x87 load / store encoders.
// Byte sequences hand-verified against Intel SDM Vol. 2.

// --- x87 load/store (multi-return overflow slots) ---
//
// Byte sequences cross-checked against `clang -S` for x86_64 (the exact
// instructions LLVM emits to place / read the 3rd/4th float of a
// first-class-aggregate multi-return in ST0/ST1).

// FLDL [RSP-8] = DD /0 with a disp8 SIB (RSP base forces SIB): DD 44 24 F8.
func TestFldl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fldl(a, Mem(RSP, -8, SZ64))
	var e @[]int = make_slice(int, 4)
	e[0] = 0xDD
	e[1] = 0x44
	e[2] = 0x24
	e[3] = 0xF8
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("FLDL [RSP-8] encoding wrong")
	}
	return ""
}

// FLDS [RSP-4] = D9 /0: D9 44 24 FC.
func TestFlds() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Flds(a, Mem(RSP, -4, SZ32))
	var e @[]int = make_slice(int, 4)
	e[0] = 0xD9
	e[1] = 0x44
	e[2] = 0x24
	e[3] = 0xFC
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("FLDS [RSP-4] encoding wrong")
	}
	return ""
}

// FSTPL [RSP] = DD /3 with disp0 (RSP base, mod=00 → SIB, no disp): DD 1C 24.
func TestFstplNoDisp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fstpl(a, Mem(RSP, 0, SZ64))
	var e @[]int = make_slice(int, 3)
	e[0] = 0xDD
	e[1] = 0x1C
	e[2] = 0x24
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("FSTPL [RSP] encoding wrong")
	}
	return ""
}

// FSTPL [RSP+8] = DD /3 with disp8: DD 5C 24 08.
func TestFstplDisp8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fstpl(a, Mem(RSP, 8, SZ64))
	var e @[]int = make_slice(int, 4)
	e[0] = 0xDD
	e[1] = 0x5C
	e[2] = 0x24
	e[3] = 0x08
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("FSTPL [RSP+8] encoding wrong")
	}
	return ""
}

// FSTPS [RSP] = D9 /3: D9 1C 24.
func TestFstps() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fstps(a, Mem(RSP, 0, SZ32))
	var e @[]int = make_slice(int, 3)
	e[0] = 0xD9
	e[1] = 0x1C
	e[2] = 0x24
	if !checkBytes(a.Sections[0], 0, e) {
		return fail("FSTPS [RSP] encoding wrong")
	}
	return ""
}
