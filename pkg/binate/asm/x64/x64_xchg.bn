package "pkg/binate/asm/x64"

import "pkg/binate/asm"

// --- XCHG ---
// 0x86 /r (byte) / 0x87 /r (word, dword, qword): the register operand in ModR/M's reg field,
// the other in its r/m — dst's register when both are registers, as clang encodes them; and
// 0x90 + reg, the one-byte form of a 16-, 32- or 64-bit exchange with AX / EAX / RAX.

// Xchg emits `xchg dst, src`; see x64.bni.
func Xchg(a @asm.Assembler, dst Operand, src Operand) {
	var reg Operand = dst
	var rm Operand = src
	if isMem(dst) && src.Kind == OP_REG {
		reg = src
		rm = dst
	} else if dst.Kind != OP_REG || !isRM(src) {
		setKindsError(a, "xchg")
		return
	}
	var size int = opSize(a, "xchg", dst, src)
	if size == 0 { return }
	emitSizePrefix(a, size)
	if rm.Kind == OP_REG && size != SZ8 && (reg.Reg == RAX || rm.Reg == RAX) {
		var other int = rm.Reg
		if rm.Reg == RAX { other = reg.Reg }
		// `xchg rax, rax` is the one-byte NOP, as clang's; `xchg eax, eax` must zero RAX's upper
		// half, which 0x90 does not, so it takes 87 C0 below.
		if other == RAX && size == SZ64 {
			emit8(a, 0x90)
			return
		}
		if other != RAX || size == SZ16 {
			emitRexRM(a, rexW(size), 0, Reg(other, size), false)
			emit8(a, 0x90 + regLo3(other))
			return
		}
	}
	var f8 bool = size == SZ8 &&
			(byteRegHazard(reg.Reg) || (rm.Kind == OP_REG && byteRegHazard(rm.Reg)))
	emitRexRM(a, rexW(size), reg.Reg, rm, f8)
	if size == SZ8 {
		emit8(a, 0x86)
	} else {
		emit8(a, 0x87)
	}
	emitModRM(a, reg.Reg, rm)
}
