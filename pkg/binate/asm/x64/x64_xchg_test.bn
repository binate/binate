package "pkg/binate/asm/x64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// XCHG against clang's bytes (`clang --target=x86_64-linux-gnu -c`, Intel syntax).

// xchgCase appends to e a failure named what unless Xchg(dst, src) emits exactly hex.
func xchgCase(e @[]char, what @[]char, dst Operand, src Operand, hex *[]readonly char) @[]char {
	var a @asm.Assembler = newAsm()
	Xchg(a, dst, src)
	if emitsExactly(a, hex) || len(e) > 0 { return e }
	return fail(what)
}

// Two registers: dst in ModR/M's reg field (`xchg rbx, rcx` 48 87 D9); with AX / EAX / RAX the
// one-byte 0x90 + reg form (`xchg rax, rbx` 48 93, either order; `xchg r8d, eax` 41 90), but
// `xchg eax, eax` 87 C0 and `xchg rax, rax` 90; a byte pair never short (`xchg al, cl` 86 C1),
// SPL with REX (40 86 E0); a register and memory in either order 87 /r.
func TestXchgForms() testing.TestResult {
	var e @[]char = ""
	e = xchgCase(e, "xchg rbx, rcx", Reg(RBX, SZ64), Reg(RCX, SZ64), "48 87 d9")
	e = xchgCase(e, "xchg rcx, rbx", Reg(RCX, SZ64), Reg(RBX, SZ64), "48 87 cb")
	e = xchgCase(e, "xchg ebx, ecx", Reg(RBX, SZ32), Reg(RCX, SZ32), "87 d9")
	e = xchgCase(e, "xchg bx, cx", Reg(RBX, SZ16), Reg(RCX, SZ16), "66 87 d9")
	e = xchgCase(e, "xchg r9, r10", Reg(R9, SZ64), Reg(R10, SZ64), "4d 87 ca")
	e = xchgCase(e, "xchg rax, rbx", Reg(RAX, SZ64), Reg(RBX, SZ64), "48 93")
	e = xchgCase(e, "xchg rbx, rax", Reg(RBX, SZ64), Reg(RAX, SZ64), "48 93")
	e = xchgCase(e, "xchg eax, ecx", Reg(RAX, SZ32), Reg(RCX, SZ32), "91")
	e = xchgCase(e, "xchg ax, cx", Reg(RAX, SZ16), Reg(RCX, SZ16), "66 91")
	e = xchgCase(e, "xchg r8, rax", Reg(R8, SZ64), Reg(RAX, SZ64), "49 90")
	e = xchgCase(e, "xchg r8d, eax", Reg(R8, SZ32), Reg(RAX, SZ32), "41 90")
	e = xchgCase(e, "xchg eax, r8d", Reg(RAX, SZ32), Reg(R8, SZ32), "41 90")
	e = xchgCase(e, "xchg ax, r8w", Reg(RAX, SZ16), Reg(R8, SZ16), "66 41 90")
	e = xchgCase(e, "xchg eax, eax", Reg(RAX, SZ32), Reg(RAX, SZ32), "87 c0")
	e = xchgCase(e, "xchg rax, rax", Reg(RAX, SZ64), Reg(RAX, SZ64), "90")
	e = xchgCase(e, "xchg ax, ax", Reg(RAX, SZ16), Reg(RAX, SZ16), "66 90")
	e = xchgCase(e, "xchg al, al", Reg(RAX, SZ8), Reg(RAX, SZ8), "86 c0")
	e = xchgCase(e, "xchg al, cl", Reg(RAX, SZ8), Reg(RCX, SZ8), "86 c1")
	e = xchgCase(e, "xchg bl, cl", Reg(RBX, SZ8), Reg(RCX, SZ8), "86 d9")
	e = xchgCase(e, "xchg spl, al", Reg(RSP, SZ8), Reg(RAX, SZ8), "40 86 e0")
	e = xchgCase(e, "xchg rax, [rbx]", Reg(RAX, SZ64), Mem(RBX, 0, SZ64), "48 87 03")
	e = xchgCase(e, "xchg [rbx], rax", Mem(RBX, 0, SZ64), Reg(RAX, SZ64), "48 87 03")
	e = xchgCase(e, "xchg al, [rbx]", Reg(RAX, SZ8), Mem(RBX, 0, SZ8), "86 03")
	e = xchgCase(e, "xchg [rbx], cl", Mem(RBX, 0, SZ8), Reg(RCX, SZ8), "86 0b")
	e = xchgCase(e, "xchg word ptr [rbx], ax", Mem(RBX, 0, SZ16), Reg(RAX, SZ16), "66 87 03")
	return e
}

// An immediate, two memory operands and registers of two sizes are errors.
func TestXchgRejects() testing.TestResult {
	var bad @[]Operand = make_slice(Operand, 6)
	bad[0] = Reg(RAX, SZ64)
	bad[1] = Imm(5)
	bad[2] = Mem(RBX, 0, SZ64)
	bad[3] = Mem(RCX, 0, SZ64)
	bad[4] = Reg(RAX, SZ64)
	bad[5] = Reg(RCX, SZ32)
	for i := 0; i < len(bad); i = i + 2 {
		var a @asm.Assembler = newAsm()
		Xchg(a, bad[i], bad[i + 1])
		if !a.HasError || asm.HeldLen(a.Sections[0]) != 0 {
			return fail("xchg took operands it has no encoding for")
		}
	}
	return ""
}
