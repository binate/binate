// Package x87 provides the x86-64 x87 floating-point instructions beside the general-purpose ones
// of pkg/binate/asm/x64, whose memory operands (x64.Operand) and encoding support (x64.EmitRexRM,
// x64.EmitModRM) they use: every x87 instruction clang takes in 64-bit mode — the loads and
// stores, the arithmetic and comparisons, the transcendental and constant instructions, the stack
// and control instructions — and FWAIT.
//
// A stack register is St(i), ST(0)..ST(7).  A memory operand is x64.IsMem's (an OP_MEM, a `[rip +
// label]` or a GOT slot); its size chooses among an instruction's memory forms (x64.SZ16 a word,
// SZ32 a dword, SZ64 a qword, SZ80 a tbyte), so an instruction with several needs one, one with a
// single size takes it or size 0, and the environment and state saves and restores (Fldenv ..
// Fsave) take any.  Any other operand sets an assembler error and emits nothing.  None takes a
// lock prefix (after x64.LockNext each is an assembler error and writes nothing).  The waiting
// forms (Fclex, Finit, Fstcw, Fstenv, Fsave, Fstsw) are FWAIT (9B) and the no-wait form; a prefix
// of the instruction goes after the 9B, so they keep `{rex}` (asm.Assembler.X64Rex) for the no-wait
// form, and a caller with a segment override writes Fwait, the override and the no-wait form
// (Fnstcw ..), as the text parser does.
package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The stack registers ST(0)..ST(7), numbered apart from x64's general registers (as the XMM
// registers are, package sse), so the general-purpose encoders reject them.
const (
	ST0 int = iota + 64
	ST1
	ST2
	ST3
	ST4
	ST5
	ST6
	ST7
)

// St returns the stack register operand ST(i), x64.Reg(ST0 + i, x64.SZ80), for i 0..7 (with any
// other i, a register no encoder takes).
func St(i int) x64.Operand

// IsSt reports whether op is a stack register operand, ST(0)..ST(7).
func IsSt(op x64.Operand) bool

// --- Loads and stores ---

// Fld emits FLD src, pushing it: ST(i) (D9 C0+i), m32 (D9 /0), m64 (DD /0) or m80 (DB /5).
func Fld(a @asm.Assembler, src x64.Operand)

// Fst emits FST dst, storing ST(0): ST(i) (DD D0+i), m32 (D9 /2) or m64 (DD /2).  Fstp emits FSTP
// dst and pops: ST(i) (DD D8+i), m32 (D9 /3), m64 (DD /3) or m80 (DB /7).
func Fst(a @asm.Assembler, dst x64.Operand)

func Fstp(a @asm.Assembler, dst x64.Operand)

// Fild emits FILD src, pushing an integer: m16 (DF /0), m32 (DB /0) or m64 (DF /5).  Fist emits
// FIST dst, storing ST(0) as an integer: m16 (DF /2) or m32 (DB /2); Fistp FISTP, popping: m16
// (DF /3), m32 (DB /3) or m64 (DF /7); Fisttp FISTTP, truncating and popping: m16 (DF /1), m32
// (DB /1) or m64 (DD /1).
func Fild(a @asm.Assembler, src x64.Operand)

func Fist(a @asm.Assembler, dst x64.Operand)

func Fistp(a @asm.Assembler, dst x64.Operand)

func Fisttp(a @asm.Assembler, dst x64.Operand)

// Fbld emits FBLD m80 (DF /4), pushing a packed BCD integer, and Fbstp FBSTP m80 (DF /6), storing
// one and popping.
func Fbld(a @asm.Assembler, src x64.Operand)

func Fbstp(a @asm.Assembler, dst x64.Operand)

// Flds emits FLD m32 (D9 /0), Fldl FLD m64 (DD /0), Fstps FSTP m32 (D9 /3) and Fstpl FSTP m64
// (DD /3) whatever the memory operand's size (the name fixes the access width): the native x64
// backend returns the 3rd and 4th float of a multi-return tuple with more than 2 float fields in
// ST(0) / ST(1) through them.
func Flds(a @asm.Assembler, mem x64.Operand)

func Fldl(a @asm.Assembler, mem x64.Operand)

func Fstps(a @asm.Assembler, mem x64.Operand)

func Fstpl(a @asm.Assembler, mem x64.Operand)

// --- Arithmetic ---

// Fadd emits FADD dst, src: dst ST(0) and src ST(i) (D8 C0+i) or m32 (D8 /0) or m64 (DC /0), or
// dst ST(i) and src ST(0) (DC C0+i).  Fmul FMUL (C8+i, /1), Fsub FSUB (E0+i, /4), Fsubr FSUBR
// (E8+i, /5), Fdiv FDIV (F0+i, /6) and Fdivr FDIVR (F8+i, /7) likewise; in the DC form with dst
// ST(i), Intel's encoding crosses each pair: FSUB is DC E8+i, FSUBR DC E0+i, FDIV DC F8+i, FDIVR
// DC F0+i.
func Fadd(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Fmul(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Fsub(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Fsubr(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Fdiv(a @asm.Assembler, dst x64.Operand, src x64.Operand)

func Fdivr(a @asm.Assembler, dst x64.Operand, src x64.Operand)

// Faddp emits FADDP ST(i), ST(0) (DE C0+i), dst ST(i), and pops; Fmulp FMULP (DE C8+i), Fsubp FSUBP
// (DE E8+i), Fsubrp FSUBRP (DE E0+i), Fdivp FDIVP (DE F8+i) and Fdivrp FDIVRP (DE F0+i) likewise.
func Faddp(a @asm.Assembler, dst x64.Operand)

func Fmulp(a @asm.Assembler, dst x64.Operand)

func Fsubp(a @asm.Assembler, dst x64.Operand)

func Fsubrp(a @asm.Assembler, dst x64.Operand)

func Fdivp(a @asm.Assembler, dst x64.Operand)

func Fdivrp(a @asm.Assembler, dst x64.Operand)

// Fiadd emits FIADD src, adding an integer to ST(0): m16 (DE /0) or m32 (DA /0).  Fimul FIMUL (/1),
// Fisub FISUB (/4), Fisubr FISUBR (/5), Fidiv FIDIV (/6) and Fidivr FIDIVR (/7) likewise, as are
// Ficom FICOM (/2) and Ficomp FICOMP (/3), comparing ST(0) with it.
func Fiadd(a @asm.Assembler, src x64.Operand)

func Fimul(a @asm.Assembler, src x64.Operand)

func Fisub(a @asm.Assembler, src x64.Operand)

func Fisubr(a @asm.Assembler, src x64.Operand)

func Fidiv(a @asm.Assembler, src x64.Operand)

func Fidivr(a @asm.Assembler, src x64.Operand)

func Ficom(a @asm.Assembler, src x64.Operand)

func Ficomp(a @asm.Assembler, src x64.Operand)

// --- Comparisons ---

// Fcom emits FCOM src, comparing ST(0) with it: ST(i) (D8 D0+i), m32 (D8 /2) or m64 (DC /2); Fcomp
// FCOMP, popping: ST(i) (D8 D8+i), m32 (D8 /3) or m64 (DC /3).
func Fcom(a @asm.Assembler, src x64.Operand)

func Fcomp(a @asm.Assembler, src x64.Operand)

// Fucom emits FUCOM ST(i) (DD E0+i) and Fucomp FUCOMP ST(i) (DD E8+i), unordered.  Fcomi emits
// FCOMI ST(0), ST(i) (DB F0+i), setting EFLAGS, Fcomip FCOMIP (DF F0+i), popping, Fucomi FUCOMI
// (DB E8+i) and Fucomip FUCOMIP (DF E8+i), unordered: src is ST(i).
func Fucom(a @asm.Assembler, src x64.Operand)

func Fucomp(a @asm.Assembler, src x64.Operand)

func Fcomi(a @asm.Assembler, src x64.Operand)

func Fcomip(a @asm.Assembler, src x64.Operand)

func Fucomi(a @asm.Assembler, src x64.Operand)

func Fucomip(a @asm.Assembler, src x64.Operand)

// Fcompp emits FCOMPP (DE D9) and Fucompp FUCOMPP (DA E9), comparing ST(0) with ST(1) and popping
// both; Ftst FTST (D9 E4), comparing ST(0) with 0.0; Fxam FXAM (D9 E5), classifying ST(0).
func Fcompp(a @asm.Assembler)

func Fucompp(a @asm.Assembler)

func Ftst(a @asm.Assembler)

func Fxam(a @asm.Assembler)

// --- The stack ---

// Fxch emits FXCH ST(i) (D9 C8+i), exchanging it with ST(0); Ffree FFREE ST(i) (DD C0+i), tagging
// it empty; Ffreep FFREEP ST(i) (DF C0+i), and popping.
func Fxch(a @asm.Assembler, src x64.Operand)

func Ffree(a @asm.Assembler, src x64.Operand)

func Ffreep(a @asm.Assembler, src x64.Operand)

// Fdecstp emits FDECSTP (D9 F6) and Fincstp FINCSTP (D9 F7), turning the stack.
func Fdecstp(a @asm.Assembler)

func Fincstp(a @asm.Assembler)

// Fcmov emits FCMOVcc ST(0), ST(i), moving src, ST(i), to ST(0) when condition cc holds: x64.CC_B
// (DA C0+i), CC_E (DA C8+i), CC_BE (DA D0+i), CC_P (DA D8+i, `fcmovu`), CC_AE (DB C0+i, `fcmovnb`),
// CC_NE (DB C8+i), CC_A (DB D0+i, `fcmovnbe`) or CC_NP (DB D8+i, `fcmovnu`); any other condition
// sets an assembler error and emits nothing.
func Fcmov(a @asm.Assembler, cc int, src x64.Operand)

// --- Without operands: functions of ST(0) and ST(1), constants ---

// F2xm1 emits F2XM1 (D9 F0), Fabs FABS (D9 E1), Fchs FCHS (D9 E0), Fcos FCOS (D9 FF), Fpatan FPATAN
// (D9 F3), Fprem FPREM (D9 F8), Fprem1 FPREM1 (D9 F5), Fptan FPTAN (D9 F2), Frndint FRNDINT (D9
// FC), Fscale FSCALE (D9 FD), Fsin FSIN (D9 FE), Fsincos FSINCOS (D9 FB), Fsqrt FSQRT (D9 FA),
// Fxtract FXTRACT (D9 F4), Fyl2x FYL2X (D9 F1), Fyl2xp1 FYL2XP1 (D9 F9) and Fnop FNOP (D9 D0).
func F2xm1(a @asm.Assembler)

func Fabs(a @asm.Assembler)

func Fchs(a @asm.Assembler)

func Fcos(a @asm.Assembler)

func Fpatan(a @asm.Assembler)

func Fprem(a @asm.Assembler)

func Fprem1(a @asm.Assembler)

func Fptan(a @asm.Assembler)

func Frndint(a @asm.Assembler)

func Fscale(a @asm.Assembler)

func Fsin(a @asm.Assembler)

func Fsincos(a @asm.Assembler)

func Fsqrt(a @asm.Assembler)

func Fxtract(a @asm.Assembler)

func Fyl2x(a @asm.Assembler)

func Fyl2xp1(a @asm.Assembler)

func Fnop(a @asm.Assembler)

// Fld1 emits FLD1 (D9 E8), pushing +1.0; Fldl2t FLDL2T (D9 E9), log2(10); Fldl2e FLDL2E (D9 EA),
// log2(e); Fldpi FLDPI (D9 EB); Fldlg2 FLDLG2 (D9 EC), log10(2); Fldln2 FLDLN2 (D9 ED), ln(2);
// Fldz FLDZ (D9 EE), +0.0.
func Fld1(a @asm.Assembler)

func Fldl2t(a @asm.Assembler)

func Fldl2e(a @asm.Assembler)

func Fldpi(a @asm.Assembler)

func Fldlg2(a @asm.Assembler)

func Fldln2(a @asm.Assembler)

func Fldz(a @asm.Assembler)

// --- Control ---

// Fldcw emits FLDCW m16 (D9 /5), loading the control word; Fnstcw FNSTCW m16 (D9 /7), storing it;
// Fstcw FSTCW m16 (9B D9 /7).
func Fldcw(a @asm.Assembler, src x64.Operand)

func Fnstcw(a @asm.Assembler, dst x64.Operand)

func Fstcw(a @asm.Assembler, dst x64.Operand)

// Fldenv emits FLDENV m (D9 /4), loading the environment; Fnstenv FNSTENV m (D9 /6), storing it;
// Fstenv FSTENV m (9B D9 /6); Frstor FRSTOR m (DD /4), loading the whole state; Fnsave FNSAVE m (DD
// /6), storing it; Fsave FSAVE m (9B DD /6).  The memory operand may have any size (the instruction
// fixes the area's).
func Fldenv(a @asm.Assembler, src x64.Operand)

func Fnstenv(a @asm.Assembler, dst x64.Operand)

func Fstenv(a @asm.Assembler, dst x64.Operand)

func Frstor(a @asm.Assembler, src x64.Operand)

func Fnsave(a @asm.Assembler, dst x64.Operand)

func Fsave(a @asm.Assembler, dst x64.Operand)

// Fnstsw emits FNSTSW dst, storing the status word: AX (DF E0, dst x64.Reg(x64.RAX, x64.SZ16)) or
// m16 (DD /7); Fstsw FSTSW dst (9B and the same).
func Fnstsw(a @asm.Assembler, dst x64.Operand)

func Fstsw(a @asm.Assembler, dst x64.Operand)

// Fnclex emits FNCLEX (DB E2), clearing the exceptions, and Fclex FCLEX (9B DB E2); Fninit FNINIT
// (DB E3), initializing the unit, and Finit FINIT (9B DB E3); Fwait FWAIT (9B), WAIT.
func Fnclex(a @asm.Assembler)

func Fclex(a @asm.Assembler)

func Fninit(a @asm.Assembler)

func Finit(a @asm.Assembler)

func Fwait(a @asm.Assembler)
