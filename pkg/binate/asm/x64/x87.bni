// Package x87 provides the x86-64 x87 floating-point instructions beside the general-purpose ones
// of pkg/binate/asm/x64, whose memory operands (x64.Operand) and encoding support (x64.EmitRexRM,
// x64.EmitModRM) they use: the loads and stores through which the native x64 backend returns the
// 3rd and 4th float of a multi-return tuple with more than 2 float fields in ST0 / ST1.
//
// Each takes a memory operand (x64.IsMem: an OP_MEM, a `[rip + label]` or a GOT slot); a register
// would select the opcode's register form, a different instruction or none (D9 /0 is FLD st(i),
// D9 /3 has none), and any other kind has no encoding here: either sets an assembler error and
// emits nothing.  The operand's size is not read (the opcode fixes the access width).
package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// Flds emits `flds mem` (D9 /0) — push a 32-bit float onto the x87 stack.
func Flds(a @asm.Assembler, mem x64.Operand)

// Fldl emits `fldl mem` (DD /0) — push a 64-bit float onto the x87 stack.
func Fldl(a @asm.Assembler, mem x64.Operand)

// Fstps emits `fstps mem` (D9 /3) — pop ST0, storing it as a 32-bit float.
func Fstps(a @asm.Assembler, mem x64.Operand)

// Fstpl emits `fstpl mem` (DD /3) — pop ST0, storing it as a 64-bit float.
func Fstpl(a @asm.Assembler, mem x64.Operand)
