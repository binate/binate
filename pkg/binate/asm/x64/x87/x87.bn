package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The 32-bit (s) or 64-bit (l) form is the opcode's choice (D9 or DD), not REX.W, so emitX87Mem
// passes W clear; the /digit selects the load (0) or the store and pop (3).  Byte sequences
// cross-checked against `clang -S` of the matching .ll.

// emitX87Mem emits a single-opcode x87 instruction with a memory operand: [REX?] <opcode> /ext
// <mem>.  REX appears only when the base or index register is R8..R15 (REX.B / REX.X); ext is 0
// or 3, so REX.R never sets.  mem must be a memory operand (x64.IsMem); any other kind sets an
// assembler error naming mnem and emits nothing.
func emitX87Mem(a @asm.Assembler, mnem *[]readonly char, opcode int, ext int, mem x64.Operand) {
	if !x64.IsMem(mem) {
		x64.KindsError(a, mnem)
		return
	}
	x64.EmitRexRM(a, false, 0, mem, false)
	a.EmitInstrUint8(cast(uint8, opcode))
	x64.EmitModRM(a, ext, mem)
}

// Flds emits FLDS m32 (D9 /0); see x87.bni.
func Flds(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "flds", 0xD9, 0, mem) }

// Fldl emits FLDL m64 (DD /0); see x87.bni.
func Fldl(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fldl", 0xDD, 0, mem) }

// Fstps emits FSTPS m32 (D9 /3); see x87.bni.
func Fstps(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fstps", 0xD9, 3, mem) }

// Fstpl emits FSTPL m64 (DD /3); see x87.bni.
func Fstpl(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fstpl", 0xDD, 3, mem) }
