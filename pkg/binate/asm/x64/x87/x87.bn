package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The operands and the encodings the x87 instructions share: a stack register in the second byte
// of a two-byte opcode (base + i), a memory operand as opcode /ext, a memory form chosen by size.

// emit8 emits byte v of an instruction.
func emit8(a @asm.Assembler, v int) { a.EmitInstrUint8(cast(uint8, v & 0xFF)) }

// emit2 emits the two-byte instruction op1 op2.
func emit2(a @asm.Assembler, op1 int, op2 int) {
	emit8(a, op1)
	emit8(a, op2)
}

// emitWait emits the FWAIT (9B) of a waiting form; a REX `{rex}` or `rex64` asks for
// (asm.Assembler.X64Rex, X64RexW) goes with the no-wait instruction after it, as GNU as places
// them (clang also `{rex}`'s), not before the 9B.
func emitWait(a @asm.Assembler) {
	var rex bool = a.X64Rex
	var w bool = a.X64RexW
	a.X64Rex = false
	a.X64RexW = false
	emit8(a, 0x9B)
	a.X64Rex = rex
	a.X64RexW = w
}

// St returns ST(i); see x87.bni.
func St(i int) x64.Operand {
	// Past 7 or below 0, a register no encoder takes (-1), not one of x64's.
	if i < 0 || i > 7 { return x64.Reg(-1, x64.SZ80) }
	return x64.Reg(ST0 + i, x64.SZ80)
}

// IsSt reports whether op is ST(0)..ST(7); see x87.bni.
func IsSt(op x64.Operand) bool {
	return op.Kind == x64.OP_REG && op.Reg >= ST0 && op.Reg <= ST7 && op.Size == x64.SZ80
}

// isSt0 reports whether op is ST(0).
func isSt0(op x64.Operand) bool { return IsSt(op) && op.Reg == ST0 }

// emitSt emits opcode, then base plus i for op, ST(i).
func emitSt(a @asm.Assembler, opcode int, base int, op x64.Operand) {
	emit2(a, opcode, base + op.Reg - ST0)
}

// emitMem emits opcode /ext with the memory operand mem: [REX] opcode ModR/M (ext is 0..7, so
// REX.R never sets; REX.B / REX.X come from mem's base and index).
func emitMem(a @asm.Assembler, opcode int, ext int, mem x64.Operand) {
	x64.EmitRexRM(a, false, ext, mem, false)
	emit8(a, opcode)
	x64.EmitModRM(a, ext, mem)
}

// sizedForm returns the memory form (opcode << 8 | ext) of mnem whose size is mem's — f16, f32,
// f64 or f80, -1 for none of that size — or -1 with mnem's error set when mem is no memory or of
// no size it has (size 0 included: which form would be ambiguous).
func sizedForm(a @asm.Assembler, mnem *[]readonly char, mem x64.Operand, f16 int, f32 int, f64 int,
		f80 int) int {
	var f int = -1
	if x64.IsMem(mem) {
		if mem.Size == x64.SZ16 { f = f16 }
		if mem.Size == x64.SZ32 { f = f32 }
		if mem.Size == x64.SZ64 { f = f64 }
		if mem.Size == x64.SZ80 { f = f80 }
	}
	if f < 0 {
		x64.OperandError(a, mnem, "takes memory of one of its sizes (word, dword, qword or tbyte ptr)")
	}
	return f
}

// emitSized emits the memory form of mnem sizedForm chooses, if any.
func emitSized(a @asm.Assembler, mnem *[]readonly char, mem x64.Operand, f16 int, f32 int, f64 int,
		f80 int) {
	var f int = sizedForm(a, mnem, mem, f16, f32, f64, f80)
	if f >= 0 { emitMem(a, f >> 8, f & 7, mem) }
}

// memOk reports whether mem is memory of size bits or of size 0 (size -1: any), else sets mnem's
// error.
func memOk(a @asm.Assembler, mnem *[]readonly char, mem x64.Operand, size int) bool {
	if x64.IsMem(mem) && (size < 0 || mem.Size == 0 || mem.Size == size) { return true }
	if size == x64.SZ16 {
		x64.OperandError(a, mnem, "takes a word of memory")
	} else if size == x64.SZ80 {
		x64.OperandError(a, mnem, "takes a tbyte of memory")
	} else {
		x64.OperandError(a, mnem, "takes a memory operand")
	}
	return false
}

// stOk reports whether op is a stack register, ST(i), else sets mnem's error.
func stOk(a @asm.Assembler, mnem *[]readonly char, op x64.Operand) bool {
	if IsSt(op) { return true }
	x64.OperandError(a, mnem, "takes a stack register, st(i)")
	return false
}

// emitX87Mem emits a single-opcode x87 instruction with a memory operand of any size: [REX] opcode
// /ext mem; any other kind of operand sets an assembler error naming mnem and emits nothing.
func emitX87Mem(a @asm.Assembler, mnem *[]readonly char, opcode int, ext int, mem x64.Operand) {
	if !x64.IsMem(mem) {
		x64.KindsError(a, mnem)
		return
	}
	emitMem(a, opcode, ext, mem)
}

// Flds emits FLDS m32 (D9 /0); see x87.bni.
func Flds(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "flds", 0xD9, 0, mem) }

// Fldl emits FLDL m64 (DD /0); see x87.bni.
func Fldl(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fldl", 0xDD, 0, mem) }

// Fstps emits FSTPS m32 (D9 /3); see x87.bni.
func Fstps(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fstps", 0xD9, 3, mem) }

// Fstpl emits FSTPL m64 (DD /3); see x87.bni.
func Fstpl(a @asm.Assembler, mem x64.Operand) { emitX87Mem(a, "fstpl", 0xDD, 3, mem) }
