package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The arithmetic and the comparisons.  An operation is its /ext digit: add 0, mul 1, com 2, comp
// 3, sub 4, subr 5, div 6, divr 7; ST(0) op ST(i) is D8 C0 + ext * 8 + i, and ST(i) op ST(0)
// (DC, and DE popping) crosses sub / subr and div / divr (crossed).

// crossed returns the /ext digit of operation ext in the DC and DE forms: sub and subr, div and
// divr exchanged.
func crossed(ext int) int {
	if ext >= 4 { return ext ^ 1 }
	return ext
}

// emitArith emits mnem dst, src for operation ext: ST(0), ST(i) (D8), ST(i), ST(0) (DC), or ST(0)
// and memory (m32 D8 /ext, m64 DC /ext).
func emitArith(a @asm.Assembler, mnem *[]readonly char, ext int, dst x64.Operand, src x64.Operand) {
	if isSt0(dst) && IsSt(src) {
		emitSt(a, 0xD8, 0xC0 + ext * 8, src)
	} else if IsSt(dst) && isSt0(src) {
		emitSt(a, 0xDC, 0xC0 + crossed(ext) * 8, dst)
	} else if isSt0(dst) && x64.IsMem(src) {
		emitSized(a, mnem, src, -1, 0xD800 | ext, 0xDC00 | ext, -1)
	} else {
		x64.OperandError(a, mnem, "takes st(0) and st(i), st(i) and st(0), or st(0) and memory")
	}
}

// Fadd emits FADD dst, src; see x87.bni.
func Fadd(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitArith(a, "fadd", 0, dst, src) }

// Fmul emits FMUL dst, src; see x87.bni.
func Fmul(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitArith(a, "fmul", 1, dst, src) }

// Fsub emits FSUB dst, src; see x87.bni.
func Fsub(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitArith(a, "fsub", 4, dst, src) }

// Fsubr emits FSUBR dst, src; see x87.bni.
func Fsubr(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitArith(a, "fsubr", 5, dst, src)
}

// Fdiv emits FDIV dst, src; see x87.bni.
func Fdiv(a @asm.Assembler, dst x64.Operand, src x64.Operand) { emitArith(a, "fdiv", 6, dst, src) }

// Fdivr emits FDIVR dst, src; see x87.bni.
func Fdivr(a @asm.Assembler, dst x64.Operand, src x64.Operand) {
	emitArith(a, "fdivr", 7, dst, src)
}

// emitArithPop emits mnem ST(i), ST(0) for operation ext, popping: DE C0 + crossed(ext) * 8 + i.
func emitArithPop(a @asm.Assembler, mnem *[]readonly char, ext int, dst x64.Operand) {
	if stOk(a, mnem, dst) { emitSt(a, 0xDE, 0xC0 + crossed(ext) * 8, dst) }
}

// Faddp emits FADDP ST(i), ST(0) (DE C0+i); see x87.bni.
func Faddp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "faddp", 0, dst) }

// Fmulp emits FMULP ST(i), ST(0) (DE C8+i); see x87.bni.
func Fmulp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "fmulp", 1, dst) }

// Fsubp emits FSUBP ST(i), ST(0) (DE E8+i); see x87.bni.
func Fsubp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "fsubp", 4, dst) }

// Fsubrp emits FSUBRP ST(i), ST(0) (DE E0+i); see x87.bni.
func Fsubrp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "fsubrp", 5, dst) }

// Fdivp emits FDIVP ST(i), ST(0) (DE F8+i); see x87.bni.
func Fdivp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "fdivp", 6, dst) }

// Fdivrp emits FDIVRP ST(i), ST(0) (DE F0+i); see x87.bni.
func Fdivrp(a @asm.Assembler, dst x64.Operand) { emitArithPop(a, "fdivrp", 7, dst) }

// emitIntArith emits the integer operation mnem, ext: m16 (DE /ext) or m32 (DA /ext).
func emitIntArith(a @asm.Assembler, mnem *[]readonly char, ext int, src x64.Operand) {
	emitSized(a, mnem, src, 0xDE00 | ext, 0xDA00 | ext, -1, -1)
}

// Fiadd emits FIADD src; see x87.bni.
func Fiadd(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fiadd", 0, src) }

// Fimul emits FIMUL src; see x87.bni.
func Fimul(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fimul", 1, src) }

// Ficom emits FICOM src; see x87.bni.
func Ficom(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "ficom", 2, src) }

// Ficomp emits FICOMP src; see x87.bni.
func Ficomp(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "ficomp", 3, src) }

// Fisub emits FISUB src; see x87.bni.
func Fisub(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fisub", 4, src) }

// Fisubr emits FISUBR src; see x87.bni.
func Fisubr(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fisubr", 5, src) }

// Fidiv emits FIDIV src; see x87.bni.
func Fidiv(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fidiv", 6, src) }

// Fidivr emits FIDIVR src; see x87.bni.
func Fidivr(a @asm.Assembler, src x64.Operand) { emitIntArith(a, "fidivr", 7, src) }

// emitCom emits FCOM (ext 2) or FCOMP (3) src: ST(i) (D8 C0 + ext * 8 + i), m32 or m64.
func emitCom(a @asm.Assembler, mnem *[]readonly char, ext int, src x64.Operand) {
	if IsSt(src) {
		emitSt(a, 0xD8, 0xC0 + ext * 8, src)
		return
	}
	emitSized(a, mnem, src, -1, 0xD800 | ext, 0xDC00 | ext, -1)
}

// Fcom emits FCOM src; see x87.bni.
func Fcom(a @asm.Assembler, src x64.Operand) { emitCom(a, "fcom", 2, src) }

// Fcomp emits FCOMP src; see x87.bni.
func Fcomp(a @asm.Assembler, src x64.Operand) { emitCom(a, "fcomp", 3, src) }

// emitStForm emits mnem ST(i): opcode, then base + i.
func emitStForm(a @asm.Assembler, mnem *[]readonly char, opcode int, base int, src x64.Operand) {
	if stOk(a, mnem, src) { emitSt(a, opcode, base, src) }
}

// Fucom emits FUCOM ST(i) (DD E0+i); see x87.bni.
func Fucom(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fucom", 0xDD, 0xE0, src) }

// Fucomp emits FUCOMP ST(i) (DD E8+i); see x87.bni.
func Fucomp(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fucomp", 0xDD, 0xE8, src) }

// Fcomi emits FCOMI ST(0), ST(i) (DB F0+i); see x87.bni.
func Fcomi(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fcomi", 0xDB, 0xF0, src) }

// Fcomip emits FCOMIP ST(0), ST(i) (DF F0+i); see x87.bni.
func Fcomip(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fcomip", 0xDF, 0xF0, src) }

// Fucomi emits FUCOMI ST(0), ST(i) (DB E8+i); see x87.bni.
func Fucomi(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fucomi", 0xDB, 0xE8, src) }

// Fucomip emits FUCOMIP ST(0), ST(i) (DF E8+i); see x87.bni.
func Fucomip(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fucomip", 0xDF, 0xE8, src) }

// Fcompp emits FCOMPP (DE D9); see x87.bni.
func Fcompp(a @asm.Assembler) { emit2(a, 0xDE, 0xD9) }

// Fucompp emits FUCOMPP (DA E9); see x87.bni.
func Fucompp(a @asm.Assembler) { emit2(a, 0xDA, 0xE9) }

// Ftst emits FTST (D9 E4); see x87.bni.
func Ftst(a @asm.Assembler) { emit2(a, 0xD9, 0xE4) }

// Fxam emits FXAM (D9 E5); see x87.bni.
func Fxam(a @asm.Assembler) { emit2(a, 0xD9, 0xE5) }
