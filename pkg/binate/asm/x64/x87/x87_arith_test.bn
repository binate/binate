package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The arithmetic and comparisons against clang (see x87_test.bn).

// Each operation in each form: st(0), st(i); st(i), st(0) (the crossed DC pairs); st(0) and memory
// of both sizes; popping.
func TestArithmetic() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fadd(a, St(0), St(1))
	Fadd(a, St(1), St(0))
	Fadd(a, St(0), St(0))
	Fsub(a, St(0), St(1))
	Fsub(a, St(1), St(0))
	Fsubr(a, St(0), St(1))
	Fsubr(a, St(1), St(0))
	Fmul(a, St(0), St(1))
	Fmul(a, St(1), St(0))
	Fdiv(a, St(0), St(1))
	Fdiv(a, St(1), St(0))
	Fdivr(a, St(0), St(1))
	Fdivr(a, St(1), St(0))
	var e @[]char = x87Case("", a, "fadd .. fdivr st",
			"d8c1 dcc1 d8c0 d8e1 dce9 d8e9 dce1 d8c9 dcc9 d8f1 dcf9 d8f9 dcf1")
	a = newAsm()
	Fadd(a, St(0), mem(x64.SZ32))
	Fadd(a, St(0), mem(x64.SZ64))
	Fmul(a, St(0), mem(x64.SZ32))
	Fsub(a, St(0), mem(x64.SZ32))
	Fsubr(a, St(0), mem(x64.SZ64))
	Fdiv(a, St(0), mem(x64.SZ32))
	Fdivr(a, St(0), mem(x64.SZ64))
	e = x87Case(e, a, "fadd .. fdivr memory", "d800 dc00 d808 d820 dc28 d830 dc38")
	a = newAsm()
	Faddp(a, St(1))
	Fmulp(a, St(1))
	Fsubp(a, St(1))
	Fsubp(a, St(2))
	Fsubrp(a, St(1))
	Fdivp(a, St(1))
	Fdivrp(a, St(1))
	Faddp(a, St(0))
	e = x87Case(e, a, "faddp .. fdivrp", "dec1 dec9 dee9 deea dee1 def9 def1 dec0")
	a = newAsm()
	Fiadd(a, mem(x64.SZ16))
	Fiadd(a, mem(x64.SZ32))
	Fimul(a, mem(x64.SZ16))
	Ficom(a, mem(x64.SZ32))
	Ficomp(a, mem(x64.SZ16))
	Fisub(a, mem(x64.SZ32))
	Fisubr(a, mem(x64.SZ16))
	Fidiv(a, mem(x64.SZ32))
	Fidivr(a, mem(x64.SZ16))
	e = x87Case(e, a, "fiadd .. fidivr", "de00 da00 de08 da10 de18 da20 de28 da30 de38")
	a = newAsm()
	Fadd(a, St(1), St(2))
	if !rejected(a) { e = x87Bad(e, "fadd st(1), st(2)") }
	a = newAsm()
	Fadd(a, St(0), mem(x64.SZ80))
	if !rejected(a) { e = x87Bad(e, "fadd tbyte ptr") }
	a = newAsm()
	Fiadd(a, mem(x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fiadd qword ptr") }
	a = newAsm()
	Faddp(a, mem(x64.SZ32))
	if !rejected(a) { e = x87Bad(e, "faddp dword ptr") }
	return e
}

// The comparisons: st(i) and memory, the unordered and EFLAGS forms, those without operands.
func TestComparisons() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fcom(a, St(1))
	Fcomp(a, St(1))
	Fcom(a, mem(x64.SZ32))
	Fcomp(a, mem(x64.SZ64))
	Fucom(a, St(2))
	Fucomp(a, St(2))
	Fcomi(a, St(1))
	Fcomip(a, St(2))
	Fucomi(a, St(3))
	Fucomip(a, St(3))
	Fcompp(a)
	Fucompp(a)
	Ftst(a)
	Fxam(a)
	var e @[]char = x87Case("", a, "fcom .. fxam",
			"d8d1 d8d9 d810 dc18 dde2 ddea dbf1 dff2 dbeb dfeb ded9 dae9 d9e4 d9e5")
	a = newAsm()
	Fucom(a, mem(x64.SZ32))
	if !rejected(a) { e = x87Bad(e, "fucom dword ptr") }
	a = newAsm()
	Fcomi(a, mem(x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fcomi qword ptr") }
	return e
}
