package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The control word, environment, state and status word, each in its waiting form (FWAIT, 9B,
// first) too.

// emitCtrl emits mnem mem, opcode /ext, after FWAIT when wait: mem memory of size bits or of size
// 0 (size -1: any).
func emitCtrl(a @asm.Assembler, mnem *[]readonly char, wait bool, opcode int, ext int,
		mem x64.Operand, size int) {
	if !memOk(a, mnem, mem, size) { return }
	if wait { emitWait(a) }
	emitMem(a, opcode, ext, mem)
}

// Fldcw emits FLDCW m16 (D9 /5); see x87.bni.
func Fldcw(a @asm.Assembler, src x64.Operand) {
	emitCtrl(a, "fldcw", false, 0xD9, 5, src, x64.SZ16)
}

// Fnstcw emits FNSTCW m16 (D9 /7); see x87.bni.
func Fnstcw(a @asm.Assembler, dst x64.Operand) {
	emitCtrl(a, "fnstcw", false, 0xD9, 7, dst, x64.SZ16)
}

// Fstcw emits FSTCW m16 (9B D9 /7); see x87.bni.
func Fstcw(a @asm.Assembler, dst x64.Operand) { emitCtrl(a, "fstcw", true, 0xD9, 7, dst, x64.SZ16) }

// Fldenv emits FLDENV m (D9 /4); see x87.bni.
func Fldenv(a @asm.Assembler, src x64.Operand) { emitCtrl(a, "fldenv", false, 0xD9, 4, src, -1) }

// Fnstenv emits FNSTENV m (D9 /6); see x87.bni.
func Fnstenv(a @asm.Assembler, dst x64.Operand) { emitCtrl(a, "fnstenv", false, 0xD9, 6, dst, -1) }

// Fstenv emits FSTENV m (9B D9 /6); see x87.bni.
func Fstenv(a @asm.Assembler, dst x64.Operand) { emitCtrl(a, "fstenv", true, 0xD9, 6, dst, -1) }

// Frstor emits FRSTOR m (DD /4); see x87.bni.
func Frstor(a @asm.Assembler, src x64.Operand) { emitCtrl(a, "frstor", false, 0xDD, 4, src, -1) }

// Fnsave emits FNSAVE m (DD /6); see x87.bni.
func Fnsave(a @asm.Assembler, dst x64.Operand) { emitCtrl(a, "fnsave", false, 0xDD, 6, dst, -1) }

// Fsave emits FSAVE m (9B DD /6); see x87.bni.
func Fsave(a @asm.Assembler, dst x64.Operand) { emitCtrl(a, "fsave", true, 0xDD, 6, dst, -1) }

// emitStsw emits FNSTSW (or, wait, FSTSW) dst: AX (DF E0) or m16 (DD /7).
func emitStsw(a @asm.Assembler, mnem *[]readonly char, wait bool, dst x64.Operand) {
	if dst.Kind == x64.OP_REG && dst.Reg == x64.RAX && dst.Size == x64.SZ16 {
		if wait { emitWait(a) }
		emit2(a, 0xDF, 0xE0)
		return
	}
	if x64.IsMem(dst) && (dst.Size == 0 || dst.Size == x64.SZ16) {
		if wait { emitWait(a) }
		emitMem(a, 0xDD, 7, dst)
		return
	}
	x64.OperandError(a, mnem, "takes ax or a word of memory")
}

// Fnstsw emits FNSTSW dst; see x87.bni.
func Fnstsw(a @asm.Assembler, dst x64.Operand) { emitStsw(a, "fnstsw", false, dst) }

// Fstsw emits FSTSW dst; see x87.bni.
func Fstsw(a @asm.Assembler, dst x64.Operand) { emitStsw(a, "fstsw", true, dst) }
