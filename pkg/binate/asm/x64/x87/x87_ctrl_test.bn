package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The control word, environment, state and status word against clang (see x87_test.bn).

// Each instruction, waiting and not; the control and status words a word or unsized, the
// environment and state any size; the status word into ax.
func TestControl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fldcw(a, mem(x64.SZ16))
	Fldcw(a, mem(0))
	Fnstcw(a, mem(0))
	Fstcw(a, mem(x64.SZ16))
	Fldenv(a, mem(x64.SZ64))
	Fnstenv(a, mem(0))
	Fstenv(a, mem(0))
	Frstor(a, mem(x64.SZ32))
	Fnsave(a, mem(x64.SZ80))
	Fsave(a, mem(0))
	Fnstsw(a, x64.Reg(x64.RAX, x64.SZ16))
	Fnstsw(a, mem(0))
	Fstsw(a, x64.Reg(x64.RAX, x64.SZ16))
	Fstsw(a, mem(x64.SZ16))
	var e @[]char = x87Case("", a, "fldcw .. fstsw",
			"d928 d928 d938 9bd938 d920 d930 9bd930 dd20 dd30 9bdd30 dfe0 dd38 9bdfe0 9bdd38")
	a = newAsm()
	Fldcw(a, mem(x64.SZ32))
	if !rejected(a) { e = x87Bad(e, "fldcw dword ptr") }
	a = newAsm()
	Fstcw(a, mem(x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fstcw qword ptr") }
	a = newAsm()
	Fnstsw(a, x64.Reg(x64.RAX, x64.SZ32))
	if !rejected(a) { e = x87Bad(e, "fnstsw eax") }
	a = newAsm()
	Fstsw(a, mem(x64.SZ8))
	if !rejected(a) { e = x87Bad(e, "fstsw byte ptr") }
	a = newAsm()
	Fsave(a, St(1))
	if !rejected(a) { e = x87Bad(e, "fsave st(1)") }
	return e
}

// The waiting forms keep a REX `{rex}` asks for (asm.Assembler.X64Rex) for the no-wait instruction,
// after the 9B, as clang and GNU as place it.
func TestWaitKeepsRex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.X64Rex = true
	Fstcw(a, mem(x64.SZ16))
	a.X64Rex = true
	Fclex(a)
	a.X64Rex = true
	Fstsw(a, x64.Reg(x64.RAX, x64.SZ16))
	return x87Case("", a, "{rex} fstcw / fclex / fstsw ax", "9b40d938 9b40dbe2 9b40dfe0")
}
