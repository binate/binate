package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The loads and stores: of floating-point values (a stack register or memory), integers and packed
// BCD.

// Fld emits FLD src; see x87.bni.
func Fld(a @asm.Assembler, src x64.Operand) {
	if IsSt(src) {
		emitSt(a, 0xD9, 0xC0, src)
		return
	}
	emitSized(a, "fld", src, -1, 0xD900, 0xDD00, 0xDB05)
}

// Fst emits FST dst; see x87.bni.
func Fst(a @asm.Assembler, dst x64.Operand) {
	if IsSt(dst) {
		emitSt(a, 0xDD, 0xD0, dst)
		return
	}
	emitSized(a, "fst", dst, -1, 0xD902, 0xDD02, -1)
}

// Fstp emits FSTP dst; see x87.bni.
func Fstp(a @asm.Assembler, dst x64.Operand) {
	if IsSt(dst) {
		emitSt(a, 0xDD, 0xD8, dst)
		return
	}
	emitSized(a, "fstp", dst, -1, 0xD903, 0xDD03, 0xDB07)
}

// Fild emits FILD src; see x87.bni.
func Fild(a @asm.Assembler, src x64.Operand) {
	emitSized(a, "fild", src, 0xDF00, 0xDB00, 0xDF05, -1)
}

// Fist emits FIST dst; see x87.bni.
func Fist(a @asm.Assembler, dst x64.Operand) { emitSized(a, "fist", dst, 0xDF02, 0xDB02, -1, -1) }

// Fistp emits FISTP dst; see x87.bni.
func Fistp(a @asm.Assembler, dst x64.Operand) {
	emitSized(a, "fistp", dst, 0xDF03, 0xDB03, 0xDF07, -1)
}

// Fisttp emits FISTTP dst; see x87.bni.
func Fisttp(a @asm.Assembler, dst x64.Operand) {
	emitSized(a, "fisttp", dst, 0xDF01, 0xDB01, 0xDD01, -1)
}

// Fbld emits FBLD m80 (DF /4); see x87.bni.
func Fbld(a @asm.Assembler, src x64.Operand) {
	if memOk(a, "fbld", src, x64.SZ80) { emitMem(a, 0xDF, 4, src) }
}

// Fbstp emits FBSTP m80 (DF /6); see x87.bni.
func Fbstp(a @asm.Assembler, dst x64.Operand) {
	if memOk(a, "fbstp", dst, x64.SZ80) { emitMem(a, 0xDF, 6, dst) }
}
