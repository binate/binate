package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The loads and stores against clang (see x87_test.bn).

// mem returns [rax] of size bits.
func mem(size int) x64.Operand { return x64.Mem(x64.RAX, 0, size) }

// Each form: a stack register, and memory of each size; R8..R15 in the address.
func TestLoadsAndStores() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fld(a, St(1))
	Fld(a, St(0))
	Fld(a, mem(x64.SZ32))
	Fld(a, mem(x64.SZ64))
	Fld(a, mem(x64.SZ80))
	Fst(a, St(2))
	Fst(a, mem(x64.SZ32))
	Fst(a, mem(x64.SZ64))
	Fstp(a, St(3))
	Fstp(a, mem(x64.SZ32))
	Fstp(a, mem(x64.SZ64))
	Fstp(a, mem(x64.SZ80))
	var e @[]char = x87Case("", a, "fld .. fstp",
			"d9c1 d9c0 d900 dd00 db28 ddd2 d910 dd10 dddb d918 dd18 db38")
	a = newAsm()
	Fild(a, mem(x64.SZ16))
	Fild(a, mem(x64.SZ32))
	Fild(a, mem(x64.SZ64))
	Fist(a, mem(x64.SZ16))
	Fist(a, mem(x64.SZ32))
	Fistp(a, mem(x64.SZ16))
	Fistp(a, mem(x64.SZ32))
	Fistp(a, mem(x64.SZ64))
	Fisttp(a, mem(x64.SZ16))
	Fisttp(a, mem(x64.SZ32))
	Fisttp(a, mem(x64.SZ64))
	Fbld(a, mem(x64.SZ80))
	Fbld(a, mem(0))
	Fbstp(a, mem(x64.SZ80))
	Fld(a, x64.MemIdx(x64.R9, x64.R10, 4, 8, x64.SZ32))
	e = x87Case(e, a, "fild .. fbstp",
			"df00 db00 df28 df10 db10 df18 db18 df38 df08 db08 dd08 df20 df20 df30 43d9449108")
	return e
}

// Memory of a size the instruction has not, or of none where it has several; a register or an
// immediate.
func TestLoadRejects() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Fld(a, mem(x64.SZ16))
	if !rejected(a) { e = x87Bad(e, "fld word ptr") }
	a = newAsm()
	Fld(a, mem(0))
	if !rejected(a) { e = x87Bad(e, "fld [rax]") }
	a = newAsm()
	Fst(a, mem(x64.SZ80))
	if !rejected(a) { e = x87Bad(e, "fst tbyte ptr") }
	a = newAsm()
	Fist(a, mem(x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fist qword ptr") }
	a = newAsm()
	Fild(a, St(1))
	if !rejected(a) { e = x87Bad(e, "fild st(1)") }
	a = newAsm()
	Fbld(a, mem(x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fbld qword ptr") }
	a = newAsm()
	Fld(a, x64.Reg(x64.RAX, x64.SZ64))
	if !rejected(a) { e = x87Bad(e, "fld rax") }
	a = newAsm()
	Fld(a, St(8))
	if !rejected(a) { e = x87Bad(e, "fld st(8)") }
	return e
}
