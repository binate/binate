package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The stack and control instructions, the conditional moves, and those without operands.

// Fxch emits FXCH ST(i) (D9 C8+i); see x87.bni.
func Fxch(a @asm.Assembler, src x64.Operand) { emitStForm(a, "fxch", 0xD9, 0xC8, src) }

// Ffree emits FFREE ST(i) (DD C0+i); see x87.bni.
func Ffree(a @asm.Assembler, src x64.Operand) { emitStForm(a, "ffree", 0xDD, 0xC0, src) }

// Ffreep emits FFREEP ST(i) (DF C0+i); see x87.bni.
func Ffreep(a @asm.Assembler, src x64.Operand) { emitStForm(a, "ffreep", 0xDF, 0xC0, src) }

// Fcmov emits FCMOVcc ST(0), ST(i); see x87.bni.
func Fcmov(a @asm.Assembler, cc int, src x64.Operand) {
	var form int = -1
	if cc == x64.CC_B { form = 0xDAC0 }
	if cc == x64.CC_E { form = 0xDAC8 }
	if cc == x64.CC_BE { form = 0xDAD0 }
	if cc == x64.CC_P { form = 0xDAD8 }
	if cc == x64.CC_AE { form = 0xDBC0 }
	if cc == x64.CC_NE { form = 0xDBC8 }
	if cc == x64.CC_A { form = 0xDBD0 }
	if cc == x64.CC_NP { form = 0xDBD8 }
	if form < 0 {
		x64.OperandError(a, "fcmov", "the condition is b, e, be, u, nb, ne, nbe or nu")
		return
	}
	if stOk(a, "fcmov", src) { emitSt(a, form >> 8, form & 0xFF, src) }
}

// F2xm1 emits F2XM1 (D9 F0); see x87.bni.
func F2xm1(a @asm.Assembler) { emit2(a, 0xD9, 0xF0) }

// Fabs emits FABS (D9 E1); see x87.bni.
func Fabs(a @asm.Assembler) { emit2(a, 0xD9, 0xE1) }

