func Fninit(a @asm.Assembler) { emit2(a, 0xDB, 0xE3) }

// Fclex emits FCLEX (9B DB E2); see x87.bni.
func Fclex(a @asm.Assembler) {
	emitWait(a)
	emit2(a, 0xDB, 0xE2)
}

// Finit emits FINIT (9B DB E3); see x87.bni.
func Finit(a @asm.Assembler) {
	emitWait(a)
	emit2(a, 0xDB, 0xE3)
}

// Fwait emits FWAIT (9B); see x87.bni.
func Fwait(a @asm.Assembler) { emit8(a, 0x9B) }
