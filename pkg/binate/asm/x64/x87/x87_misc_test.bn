package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The stack instructions, the conditional moves and those without operands against clang (see
// x87_test.bn).

// FXCH, FFREE, FFREEP, FDECSTP, FINCSTP, each FCMOVcc; a condition FCMOV lacks.
func TestStack() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fxch(a, St(1))
	Fxch(a, St(0))
	Fxch(a, St(7))
	Ffree(a, St(1))
	Ffreep(a, St(1))
	Fdecstp(a)
	Fincstp(a)
	Fcmov(a, x64.CC_B, St(1))
	Fcmov(a, x64.CC_E, St(2))
	Fcmov(a, x64.CC_BE, St(3))
	Fcmov(a, x64.CC_P, St(4))
	Fcmov(a, x64.CC_AE, St(5))
	Fcmov(a, x64.CC_NE, St(6))
	Fcmov(a, x64.CC_A, St(7))
	Fcmov(a, x64.CC_NP, St(1))
	var e @[]char = x87Case("", a, "fxch .. fcmovnu",
			"d9c9 d9c8 d9cf ddc1 dfc1 d9f6 d9f7 dac1 daca dad3 dadc dbc5 dbce dbd7 dbd9")
	a = newAsm()
	Fcmov(a, x64.CC_L, St(1))
	if !rejected(a) { e = x87Bad(e, "fcmovl") }
	a = newAsm()
	Fxch(a, mem(x64.SZ80))
	if !rejected(a) { e = x87Bad(e, "fxch tbyte ptr") }
	return e
}

// Each instruction without operands.
func TestNoOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	F2xm1(a)
	Fabs(a)
	Fchs(a)
	Fcos(a)
	Fpatan(a)
	Fprem(a)
	Fprem1(a)
	Fptan(a)
	Frndint(a)
	Fscale(a)
	Fsin(a)
	Fsincos(a)
	Fsqrt(a)
	Fxtract(a)
	Fyl2x(a)
	Fyl2xp1(a)
	Fnop(a)
	var e @[]char = x87Case("", a, "f2xm1 .. fnop",
			"d9f0 d9e1 d9e0 d9ff d9f3 d9f8 d9f5 d9f2 d9fc d9fd d9fe d9fb d9fa d9f4 d9f1 d9f9 d9d0")
	a = newAsm()
	Fld1(a)
	Fldl2t(a)
	Fldl2e(a)
	Fldpi(a)
	Fldlg2(a)
	Fldln2(a)
	Fldz(a)
	Fnclex(a)
	Fclex(a)
	Fninit(a)
	Finit(a)
	Fwait(a)
	return x87Case(e, a, "fld1 .. fwait",
			"d9e8 d9e9 d9ea d9eb d9ec d9ed d9ee dbe2 9bdbe2 dbe3 9bdbe3 9b")
}

// St past 7 or below 0 is no register any encoder takes (not one of x64's general registers).
func TestStRange() testing.TestResult {
	var e @[]char = ""
	if IsSt(St(-64)) || IsSt(St(8)) || !IsSt(St(7)) { e = x87Bad(e, "IsSt(St(-64 / 8 / 7))") }
	var a @asm.Assembler = newAsm()
	x64.Mov(a, St(-64), x64.Imm(1))
	if !rejected(a) { e = x87Bad(e, "mov <st(-64)>, 1") }
	a = newAsm()
	Fld(a, St(-1))
	if !rejected(a) { e = x87Bad(e, "fld <st(-1)>") }
	return e
}
