package "pkg/binate/asm/x64/x87"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The x87 loads and stores against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): the exact instructions LLVM emits to place or read the 3rd / 4th
// float of a first-class-aggregate multi-return in ST0 / ST1, and their other memory forms.

func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// hexNibble returns the value of hex digit c (0-9, a-f), or -1.
func hexNibble(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	return -1
}

// emits reports whether a holds no error and its section exactly the bytes hex spells.
func emits(a @asm.Assembler, hex *[]readonly char) bool {
	if a.HasError { return false }
	var held int = asm.HeldLen(a.Sections[0])
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		var v int = hexNibble(hex[i])
		if v < 0 { continue }
		if hi < 0 {
			hi = v
			continue
		}
		if n >= held || cast(int, a.Sections[0].Data[n]) != hi * 16 + v { return false }
		n++
		hi = -1
	}
	return n == held
}

// x87Case adds name to the failures e unless a holds exactly the bytes hex spells.
func x87Case(e @[]char, a @asm.Assembler, name *[]readonly char, hex *[]readonly char) @[]char {
	if emits(a, hex) { return e }
	return buf.Concat(buf.Concat(e, name), ": wrong bytes or an error; ")
}

// Each instruction with an RSP base (SIB, disp8 or none), an R8 base (REX.B) and an R9 index
// (REX.X).
func TestX87Forms() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Fldl(a, x64.Mem(x64.RSP, -8, x64.SZ64))
	e = x87Case(e, a, "fld qword ptr [rsp - 8]", "dd 44 24 f8")
	a = newAsm()
	Flds(a, x64.Mem(x64.RSP, -4, x64.SZ32))
	e = x87Case(e, a, "fld dword ptr [rsp - 4]", "d9 44 24 fc")
	a = newAsm()
	Fstpl(a, x64.Mem(x64.RSP, 0, x64.SZ64))
	e = x87Case(e, a, "fstp qword ptr [rsp]", "dd 1c 24")
	a = newAsm()
	Fstpl(a, x64.Mem(x64.RSP, 8, x64.SZ64))
	e = x87Case(e, a, "fstp qword ptr [rsp + 8]", "dd 5c 24 08")
	a = newAsm()
	Fstps(a, x64.Mem(x64.RSP, 0, x64.SZ32))
	e = x87Case(e, a, "fstp dword ptr [rsp]", "d9 1c 24")
	a = newAsm()
	Fldl(a, x64.Mem(x64.R8, 0, x64.SZ64))
	e = x87Case(e, a, "fld qword ptr [r8]", "41 dd 00")
	a = newAsm()
	Fstps(a, x64.MemIdx(x64.RAX, x64.R9, 2, 0, x64.SZ32))
	e = x87Case(e, a, "fstp dword ptr [rax + r9*2]", "42 d9 1c 48")
	return e
}

// ripFixup reports whether a holds one fixup, the rel32 (FIX_REL32_LEA) of a `[rip + x]` operand
// at byte 2, its addend 0.
func ripFixup(a @asm.Assembler) bool {
	if a.Sections[0].NumFixups != 1 { return false }
	var fix asm.Fixup = a.Sections[0].Fixups[0]
	return fix.Kind == x64.FIX_REL32_LEA && fix.Offset == 2 && fix.Addend == 0 &&
			len(fix.Label) == 1 && fix.Label[0] == 'x'
}

// A `[rip + x]` operand: its rel32's FIX_REL32_LEA fixup after the opcode and ModR/M.
func TestX87Rip() testing.TestResult {
	var e @[]char = ""
	var a @asm.Assembler = newAsm()
	Fldl(a, x64.RipLabel("x"))
	e = x87Case(e, a, "fld qword ptr [rip + x]", "dd 05 00 00 00 00")
	if !ripFixup(a) { e = buf.Concat(e, "fld qword ptr [rip + x]: not its rel32 fixup; ") }
	a = newAsm()
	Fstps(a, x64.RipLabel("x"))
	e = x87Case(e, a, "fstp dword ptr [rip + x]", "d9 1d 00 00 00 00")
	if !ripFixup(a) { e = buf.Concat(e, "fstp dword ptr [rip + x]: not its rel32 fixup; ") }
	return e
}

// memFormAccepting returns the name of the first encoder that does not reject op (an error, no
// bytes and no fixup), or "" when every one of them rejects it.
func memFormAccepting(op x64.Operand) *[]readonly char {
	var a @asm.Assembler = newAsm()
	Flds(a, op)
	if !rejected(a) { return "flds" }
	a = newAsm()
	Fldl(a, op)
	if !rejected(a) { return "fldl" }
	a = newAsm()
	Fstps(a, op)
	if !rejected(a) { return "fstps" }
	a = newAsm()
	Fstpl(a, op)
	if !rejected(a) { return "fstpl" }
	return ""
}

// rejected reports whether a holds an error and no bytes or fixups.
func rejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0 && a.Sections[0].NumFixups == 0
}

// A register, an immediate or a label is no memory operand: an error, with nothing emitted, that
// names the instruction.
func TestX87RejectsNonMemory() testing.TestResult {
	var e @[]char = ""
	var bad *[]readonly char = memFormAccepting(x64.Reg(x64.RCX, x64.SZ64))
	if len(bad) != 0 { e = buf.Concat(buf.Concat(e, bad), " rcx; ") }
	bad = memFormAccepting(x64.Reg(x64.R9, x64.SZ32))
	if len(bad) != 0 { e = buf.Concat(buf.Concat(e, bad), " r9d; ") }
	bad = memFormAccepting(x64.Imm(8))
	if len(bad) != 0 { e = buf.Concat(buf.Concat(e, bad), " 8; ") }
	bad = memFormAccepting(x64.Label("x"))
	if len(bad) != 0 { e = buf.Concat(buf.Concat(e, bad), " label x; ") }
	var a @asm.Assembler = newAsm()
	Fstpl(a, x64.Reg(x64.RAX, x64.SZ64))
	if !hasPrefix(a.ErrorMsg, "x64: fstpl: unsupported operand kinds") {
		e = buf.Concat(e, "fstpl rax: not the error naming fstpl; ")
	}
	return e
}

// hasPrefix reports whether s starts with p.
func hasPrefix(s *[]readonly char, p *[]readonly char) bool {
	if len(s) < len(p) { return false }
	for i := 0; i < len(p); i++ {
		if s[i] != p[i] { return false }
	}
	return true
}

// x87Bad adds name, an operand an encoder should have rejected (an error and nothing emitted), to
// the failures e.
func x87Bad(e *[]readonly char, name *[]readonly char) @[]char {
	return buf.Concat(buf.Concat(e, name), ": not rejected; ")
}
