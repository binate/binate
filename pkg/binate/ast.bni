// Package ast defines the abstract syntax tree node types for Binate source code.
// Nodes use tagged-union structs: each struct has a Kind field selecting which
// other fields are meaningful. See the per-type documentation for field usage.
package "pkg/binate/ast"

import "pkg/binate/token"

// ============================================================
// Expression kinds
// ============================================================

const (
	EXPR_IDENT int = iota
	EXPR_INT_LIT
	EXPR_FLOAT_LIT
	EXPR_STRING_LIT
	EXPR_CHAR_LIT
	EXPR_BOOL_LIT
	EXPR_NIL_LIT
	EXPR_BINARY
	EXPR_UNARY
	EXPR_CALL
	// EXPR_INSTANTIATE_OR_INDEX covers the `name[...]` syntactic
	// form — ambiguous between value indexing and generic
	// instantiation until the type checker resolves the head.
	// `arr[i]`, `m[k]`, and `f[T]` all parse to this kind; the
	// checker disambiguates based on whether the head resolves to
	// a generic decl (instantiation) or a value of slice / array
	// type (indexing).  Slicing (`x[lo:hi]`) is unambiguous and
	// stays EXPR_SLICE.  Per `plan-generics.md` Slice 1.
	EXPR_INSTANTIATE_OR_INDEX
	EXPR_SLICE
	EXPR_SELECTOR
	EXPR_COMPOSITE
	EXPR_BUILTIN
	EXPR_FUNC_LIT  // func(...) <results> { ... } in expression position
	// EXPR_TYPE wraps a TypeExpr (in TypeRef) appearing in value
	// (expression) position.  Produced by the parser for a generic
	// instantiation type argument whose form has no expression
	// spelling — `f[@T]`, `f[@[]T]`, `f[*[]T]` — so the bracket
	// element can't go through parseExpr like a bare name or `*T`
	// does.  Only valid as a generic-instantiation type arg; the
	// type checker / IR-gen read TypeRef directly.
	EXPR_TYPE
	NUM_EXPR_KINDS
)

// ============================================================
// Statement kinds
// ============================================================

const (
	STMT_BLOCK int = iota
	STMT_EXPR
	STMT_ASSIGN
	STMT_SHORT_VAR
	STMT_INC_DEC
	STMT_RETURN
	STMT_BREAK
	STMT_CONTINUE
	STMT_IF
	STMT_FOR
	STMT_SWITCH
	STMT_EMPTY
	STMT_DECL
	NUM_STMT_KINDS
)

// ============================================================
// Declaration kinds
// ============================================================

const (
	DECL_FUNC int = iota
	DECL_VAR
	DECL_CONST
	DECL_TYPE
	DECL_GROUP
	DECL_INTERFACE
	DECL_IMPL
	NUM_DECL_KINDS
)

// ============================================================
// Type expression kinds
// ============================================================

const (
	TEXPR_NAMED int = iota
	TEXPR_POINTER
	TEXPR_MANAGED
	TEXPR_MANAGED_SLICE
	TEXPR_SLICE
	TEXPR_ARRAY
	TEXPR_STRUCT
	TEXPR_PAREN
	TEXPR_CONST
	TEXPR_FUNC_VALUE          // *func(args) ret — raw function value
	TEXPR_MANAGED_FUNC_VALUE  // @func(args) ret — managed function value
	TEXPR_SELF                // `Self` — receiver type within interface
	                          // method signatures.  Substituted at impl-
	                          // collection time; rejected by parser
	                          // context-check downstream if used outside
	                          // an interface decl.
	TEXPR_TYPE_PARAM          // Generic type parameter reference.  Not
	                          // produced by the parser (type-param refs
	                          // parse as TEXPR_NAMED with Name="T"); the
	                          // type-checker rewrites to this kind once
	                          // it sees a name resolving to a type-param
	                          // symbol in scope.  Per
	                          // `plan-generics.md` Slice 1 + Slice 2.
	TEXPR_INSTANTIATE         // Generic type instantiation: `Name[T1,
	                          // T2, ...]` in type position.  Base
	                          // carries the head (a TEXPR_NAMED, possibly
	                          // package-qualified); TypeArgs carries
	                          // each bracketed type expression.  Per
	                          // `plan-generics.md` Slice 5.
	NUM_TEXPR_KINDS
)

// ============================================================
// Node types — tagged unions
// ============================================================

// Expr represents any expression node.
//
// Kind          Fields used
// ------------- ---------------------------------------------------
// IDENT         Name
// INT_LIT       Name (raw literal text)
// FLOAT_LIT     Name (raw literal text)
// STRING_LIT    Name (raw text including quotes)
// CHAR_LIT      Name (raw text including quotes)
// BOOL_LIT      BoolVal
// NIL_LIT       (none)
// BINARY        X, Op, Y
// UNARY         Op, X
// CALL          X (callee), Args, Spread (final arg is `expr...`)
// INSTANTIATE_OR_INDEX
//               X (head), Args (one or more bracketed exprs;
//               single-element form is ambiguous between value
//               indexing and single-type-arg generic
//               instantiation — type checker disambiguates)
// SLICE         X, Y (hi), Z (lo)
// SELECTOR      X, Name (field name)
// COMPOSITE     TypeRef, Elems
// BUILTIN       Op (MAKE/BOX/CAST/BIT_CAST/LEN), TypeRef, Args
type Expr struct {
	Kind    int
	Pos     token.Pos
	Name    @[]char
	BoolVal bool
	Op      int
	X       @Expr
	Y       @Expr
	Z       @Expr
	Args    @[]@Expr
	TypeRef @TypeExpr
	Elems   @[]@Element

	// EXPR_FUNC_LIT carries the literal's signature and body via a
	// synthetic Decl: DeclRef.Params / DeclRef.Results / DeclRef.Body.
	// The Decl's Name is filled in by IR-gen with a synthetic name
	// (e.g. `__funclit_<n>`); the parser leaves it empty.
	DeclRef @Decl

	// ResolvedTypeID is set by the type checker to an index into
	// the Checker's type registry. 0 means not yet resolved.
	ResolvedTypeID int

	// CFixedArgs is meaningful only for the `__c_call` builtin
	// (Op == token.C_CALL): the count of fixed (named) arguments in
	// Args.  The call is variadic iff CFixedArgs < len(Args), in which
	// case Args[CFixedArgs:] are the variadic args (after the `...`
	// marker).  See explorations/plan-c-call.md.
	CFixedArgs int

	// Spread is meaningful only for a call (EXPR_CALL): true iff the FINAL
	// argument was written `expr...` — a slice spread into the callee's variadic
	// parameter (func.variadic.spread).  Distinct from CFixedArgs (that is the
	// separate `__c_call` C-varargs mechanism).  The spread operand is the last
	// element of Args.
	Spread bool

	// StrParts is set only for an EXPR_STRING_LIT built from adjacent string
	// literals (`"a" "b"`, possibly across lines): the individual source literals
	// in order, each with its position.  Name still holds the merged literal that
	// the compiler consumes; StrParts lets a source-preserving tool (bnfmt) re-emit
	// the author's split — boundaries and line breaks — verbatim.  nil for a plain
	// single-literal string.
	StrParts @[]@StrPart
}

// StrPart is one source string literal within an adjacent-literal run (Expr.
// StrParts): Lit is the raw literal text including its quotes, Pos its position.
type StrPart struct {
	Lit @[]char
	Pos token.Pos
}

// Stmt represents any statement node.
//
// Kind          Fields used
// ------------- ---------------------------------------------------
// BLOCK         Stmts
// EXPR          X
// ASSIGN        Exprs (LHS), Op, Exprs2 (RHS)
// SHORT_VAR     Exprs (name idents), Exprs2 (RHS)
// INC_DEC       X, Op (INC or DEC)
// RETURN        Exprs (results)
// BREAK         (none)
// CONTINUE      (none)
// IF            X (cond), Body, Else
// FOR           Init, X (cond), Post, Body
//               ForKey, ForVal, X (iter) — for-in variant
// SWITCH        X (tag), Cases
// EMPTY         (none)
// DECL          DeclRef
type Stmt struct {
	Kind    int
	Pos     token.Pos
	End     token.Pos
	Stmts   @[]@Stmt
	Exprs   @[]@Expr
	Exprs2  @[]@Expr
	X       @Expr
	Op      int
	Body    @Stmt
	Else    @Stmt
	Init    @Stmt
	Post    @Stmt
	ForKey  @Expr
	ForVal  @Expr
	Cases   @[]@CaseClause
	DeclRef @Decl
}

// Decl represents any declaration node.
//
// Kind          Fields used
// ------------- ---------------------------------------------------
// FUNC          Name, Recv (nil for free functions, non-nil for methods),
//               TypeParams (nil unless generic), Params, Results,
//               Body (nil in .bni)
// VAR           Name, TypeRef (may be nil), Value (may be nil)
// CONST         Name, TypeRef (may be nil), Value (may be nil)
// TYPE          Name, TypeRef (definition), TypeParams (nil unless
//               generic struct decl, per plan-generics.md Slice 5),
//               IsAlias, IsForward
//
//               Forward declaration form (`type S` with no body):
//               TypeRef == nil, IsAlias == false, IsForward == true.
//               Declares S as a type whose layout lives elsewhere
//               (the impl file's `type S struct { ... }`).  Callers
//               can hold `*S` / `@S` handles but cannot access fields
//               or take SizeOf.  See plan-type-decls.md.
// GROUP         Decls
// INTERFACE     Name, Decls (each is a method-signature DECL_FUNC with
//               no Recv, no Body — the interface's method set)
// IMPL          TypeRef (receiver type expression, e.g. *T, @T, *readonly T,
//               or T), Interfaces (list of TEXPR_NAMED entries naming the
//               interfaces this impl satisfies). No Body — `impl` is a
//               pure connection between a type and the interfaces it
//               satisfies. Methods are declared Go-style outside the
//               impl block.
type Decl struct {
	Kind       int
	Pos        token.Pos
	End        token.Pos
	Name       @[]char
	Recv       @ParamDecl
	// TypeParams is the generic type-parameter list on a DECL_FUNC.
	// nil / empty for non-generic functions.  Per
	// `plan-generics.md` Slice 1.
	TypeParams @[]@TypeParam
	Params     @[]@ParamDecl
	Results    @[]@TypeExpr
	Body       @Stmt
	TypeRef    @TypeExpr
	Value      @Expr
	IsAlias    bool
	// IsForward marks a DECL_TYPE as a forward declaration:
	// `type S` with no body, no `=`, no underlying type.  Only
	// meaningful in .bni files.  The actual layout lives in a
	// `.bn`-side `type S struct { ... }`.  See plan-type-decls.md.
	IsForward  bool
	Decls      @[]@Decl
	Interfaces @[]@TypeExpr
	// Captures is populated by the type-checker for synthetic
	// function-literal Decls (those reached via Expr.DeclRef on
	// an EXPR_FUNC_LIT).  Each entry names an identifier from an
	// enclosing function/block scope that the literal's body
	// references.  Empty / nil for top-level Decls and for
	// non-capturing literals.  Consumed by IR-gen (B.2..B.4 of
	// plan-function-values-phase-2.md) to lay out the closure
	// struct + dtor + per-shape call shim.
	Captures   @[]@Capture
	// Exported marks a DECL_FUNC or DECL_VAR whose name is declared in
	// the package's .bni interface — i.e. part of the package's exported
	// surface.  Exports are the .bni surface, NOT identifier
	// capitalization.  Set by the loader's .bni-merge pass
	// (markBniExportedFuncs / markBniExportedVars) and carried onto the
	// lowered ir.Func / ir.Global; the reflect descriptor reads it to emit
	// a func-value table entry per exported function and a GlobalInfo entry
	// per exported global.
	Exported   bool
	// FromBNI marks a declaration that originated in the package's .bni
	// interface file (set by the loader when it prepends .bni decls into
	// the merged compilation unit).  false for decls parsed from a .bn.
	// collectTypeDecl uses it to tell a benign .bni decl reprocessed via
	// the merge prepend (FromBNI == true, matching what buildScopeFromFile
	// already registered) apart from a genuine .bn redeclaration of an
	// already-full type (FromBNI == false), which is rejected.  See
	// plan-type-redecl.md.
	FromBNI    bool
	// Annotations holds the `#[...]` entries that immediately precede
	// this declaration (e.g. `#[build(arch == "arm32")]`).  Empty for
	// un-annotated declarations.  The loader's build-constraint gate
	// (pkg/binate/buildcfg) reads `build` entries to include/exclude
	// the declaration for the active target.
	Annotations @[]@Annotation
}

// Capture is a single entry in Decl.Captures — one captured
// identifier from an enclosing scope.  See
// `plan-function-values-phase-2.md` §"Capture analysis
// (type-checker)" for the recording rules.
type Capture struct {
	// Pos is the literal's body position (used for diagnostics —
	// e.g. linter messages about raw-pointer captures).  The
	// individual use-site positions are not preserved; first-use
	// wins for layout order.
	Pos  token.Pos
	// Name is the captured identifier as it appears in source.
	Name @[]char
	// Kind is one of CAP_VAL / CAP_RAW_PTR / CAP_MANAGED — the
	// refcount class IR-gen uses to drive RefInc-on-capture +
	// RefDec-in-dtor.  Derived from the captured type, not from
	// how the closure body uses the name.
	Kind int
	// ResolvedTypeID indexes Checker.ExprTypes for the captured
	// type — same side-table the type-checker uses for
	// Expr.ResolvedTypeID.  IR-gen reads it back via the module's
	// Checker, `m.Checker.ExprType(id)`.
	ResolvedTypeID int
}

// Capture kinds.  CAP_VAL covers value types (int / bool / struct
// / array / raw slice / raw function value / etc.) which are
// plain copies with no refcount.  CAP_RAW_PTR is a raw pointer,
// also a plain copy — lifetime is the user's responsibility.
// CAP_MANAGED is anything with managed-owner semantics (managed
// pointer, managed-slice, managed function value, managed
// interface value) — IR-gen emits RefInc on capture and RefDec
// at closure destruction.
const (
	CAP_VAL int = iota
	CAP_RAW_PTR
	CAP_MANAGED
)

// TypeExpr represents a type expression.
//
// Kind            Fields used
// --------------- ---------------------------------------------------
// NAMED           Name, Pkg (empty if unqualified)
// POINTER         Base
// MANAGED         Base
// MANAGED_SLICE   Base (element type)
// SLICE           Base (element type)
// ARRAY           Base (element type), Len
// STRUCT          Fields
// PAREN           Base
// CONST           Base (the type this const modifies)
type TypeExpr struct {
	Kind   int
	Pos    token.Pos
	End    token.Pos
	Name   @[]char
	Pkg    @[]char
	Base   @TypeExpr
	Len    @Expr
	Fields @[]@FieldDecl

	// ARRAY: the resolved length, stamped by the type checker
	// (resolveTypeExpr in pkg/binate/types) once `Len` folds to a known
	// non-negative value.  LenKnown gates it.  IR-gen reads this in
	// preference to re-folding `Len` against its own const table: that
	// table is populated by passes that can lag a use site (a global /
	// type-alias dim resolved before the const is registered, an imported
	// `.bni` field dim resolved before the imported const), so re-folding
	// there yields a garbage size (parseIntLit on the dim's ident text) and
	// silently disagrees with the checker's layout.  The checker is the
	// single source of truth for array layout (a language-level contract all
	// backends share); trusting its value keeps IR-gen in lockstep.
	LenVal   int
	LenKnown bool

	// ARRAY: the `[...]T` inferred-length form (a composite-literal head whose
	// length is the element count).  Len is nil; checkCompositeLit folds the
	// length from the literal's elements and stamps it on LenVal/LenKnown.  Used
	// ONLY as a composite-literal head — resolveTypeExpr rejects `[...]` in any
	// other type position.
	LenInferred bool

	// FUNC_VALUE / MANAGED_FUNC_VALUE: parameter and return-type lists.
	// Function-value types in source are written `*func(T1, T2) ret`
	// or `@func(T1, T2) ret` — parameters are anonymous (types only).
	ParamTypes  @[]@TypeExpr
	ResultTypes @[]@TypeExpr
	// VariadicParams marks a variadic function-value type `*func(...T)` /
	// `@func(...T)`: the LAST ParamTypes entry is the variadic element type `T`
	// (func.variadic.identity).  ParamTypes is flat with no per-entry struct, so
	// the marker lives here as a single bool by the last-entry convention.
	VariadicParams bool

	// TEXPR_INSTANTIATE: the bracketed type arguments of `Name[T1,
	// T2, ...]` in type position.  Base holds the head (TEXPR_NAMED,
	// possibly package-qualified).  Per plan-generics.md Slice 5.
	TypeArgs @[]@TypeExpr
}

// ============================================================
// Helper types
// ============================================================

// Element is a key-value pair in a composite literal (Key is nil for positional).
type Element struct {
	Key   @Expr
	Value @Expr

	// KeyVal is the checker-folded array-literal index for a KEYED element
	// (`[N]T{k: v}`), stamped by checkArrayLit once `Key` folds to a validated,
	// in-bounds index; KeyKnown gates it.  IR-gen (genArrayLit) reads this in
	// preference to re-folding `Key` against its own const table (evalConstExpr):
	// the two folders can disagree on a constant key (the same divergence class
	// as TypeExpr.LenVal — checker `evalConstIntValue` vs IR-gen `evalConstExpr`),
	// which would place an element at an index the checker never bound-checked
	// against N → an out-of-bounds store.  The checker is the single source of
	// truth for element placement.  Unset for struct-literal elements (Key is a
	// field name) and for unkeyed array elements (running index).
	KeyVal   int
	KeyKnown bool
}

// ParamDecl is a function parameter declaration.
type ParamDecl struct {
	Pos  token.Pos
	Name @[]char
	Type @TypeExpr
	// Variadic marks a variadic parameter `name ...T` (func.variadic.decl).
	// Only the final parameter may be variadic, and at most one.  Type holds the
	// ELEMENT type `T` exactly as written; the checker/IR-gen derive the in-body
	// raw-slice type `*[]T` from it (the parser does not synthesize `*[]T`).
	Variadic bool
}

// TypeParam is one entry in a generic decl's type-parameter list:
// the parameter name `T` and the constraint type expression `any`
// (or a named interface for constrained generics).  Per
// `plan-generics.md` Slice 1, only `any` constraints are accepted
// for now; the constraint is still parsed as a TypeExpr so the
// AST shape is stable for Slice 3's constraint work.
type TypeParam struct {
	Pos        token.Pos
	Name       @[]char
	Constraint @TypeExpr
}

// FieldDecl is a struct field declaration.
type FieldDecl struct {
	Pos  token.Pos
	Name @[]char
	Type @TypeExpr
}

// CaseClause is a single case in a switch statement.
type CaseClause struct {
	Pos  token.Pos
	Exprs @[]@Expr
	Body  @[]@Stmt
}

// ImportSpec is a single import declaration.
type ImportSpec struct {
	Pos   token.Pos
	Alias @[]char
	Path  @[]char
	// Annotations holds the `#[...]` entries on this import's declaration
	// (e.g. `#[build(is(os, "linux"))] import "pkg/x"`).  A grouped import
	// shares its declaration's annotations across every spec.  Empty for
	// un-annotated imports.  The loader's build-constraint gate reads a
	// `build` entry to include or exclude the import (and thus whether the
	// dependency is followed).
	Annotations @[]@Annotation
}

// Annotation is one `#[name(args)]` entry parsed from an annotation
// block.  Name is the (possibly dotted) annotation name — e.g. `build`,
// `tool.lint` — with its segments joined by `.`.  Args holds the
// parenthesized argument expressions, empty when the entry has no
// `(...)`.  `#[build(arch == "arm32")]` yields one Annotation with Name
// `build` and a single Args expression.  See explorations/grammar.ebnf
// §6 (Annotations) and explorations/plan-build-constraints.md.
type Annotation struct {
	Pos  token.Pos
	Name @[]char
	Args @[]@Expr
}

// File represents a parsed source file.
type File struct {
	Pos     token.Pos
	PkgName @[]char
	Imports @[]@ImportSpec
	Decls   @[]@Decl
	// Annotations holds the `#[...]` entries on the package clause
	// (e.g. `#[build(os == "linux")] package "x"`).  Empty when the
	// clause is un-annotated.  The loader's build-constraint gate reads
	// a `build` entry to include or exclude the whole file.
	Annotations @[]@Annotation
	// Comments holds the file's comments in source order, populated only when
	// the file was parsed via a comment-collecting parser
	// (parser.NewCollecting / NewInterfaceCollecting) -- empty on the
	// compiler path.  Consumed by tooling (a formatter / doc generator) that
	// interleaves comments with the AST by position.
	Comments @[]@token.Comment
}

// ============================================================
// Formatting helpers
// ============================================================

// ExprKindName returns the string name of an expression kind constant.
func ExprKindName(kind int) *[]readonly char

// StmtKindName returns the string name of a statement kind constant.
func StmtKindName(kind int) *[]readonly char

// DeclKindName returns the string name of a declaration kind constant.
func DeclKindName(kind int) *[]readonly char

// TypeExprKindName returns the string name of a type expression kind constant.
func TypeExprKindName(kind int) *[]readonly char
