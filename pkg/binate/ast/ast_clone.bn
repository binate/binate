package "pkg/binate/ast"

// Deep copies of AST subtrees.  A generic declaration is checked, and its code
// generated, once per instantiation; each works on its own clone, so the
// annotations the type checker leaves on nodes — resolved types, constant ids,
// array lengths and literal keys, a function literal's captures — belong to one
// instantiation.  A clone shares no node with the original.  It copies every
// field the parser and loader set, and starts with the checker's annotations
// cleared: Expr / Decl ResolvedTypeID, Decl ConstID, TypeExpr LenVal /
// LenKnown, Element KeyVal / KeyKnown and Decl Captures.  Each node is copied
// whole first, so a field added to a node is copied with it; a field that holds
// nodes must be cloned here too (TestCloneNodeFieldsPinned fails when a node
// type's fields change, and TestCloneSharesNoNode checks the fields it walks).
// Text (names, literals) is shared: nothing modifies it in place.

// CloneDecl returns a deep copy of the declaration d (nil for nil).
func CloneDecl(d @Decl) @Decl {
	if d == nil {
		return nil
	}
	var c @Decl = make(Decl)
	*c = *d
	c.Recv = cloneParamDecl(d.Recv)
	c.TypeParams = cloneTypeParams(d.TypeParams)
	c.Params = cloneParamDecls(d.Params)
	c.Results = cloneTypeExprs(d.Results)
	c.Body = CloneStmt(d.Body)
	c.TypeRef = CloneTypeExpr(d.TypeRef)
	c.Value = CloneExpr(d.Value)
	c.Decls = cloneDecls(d.Decls)
	c.Interfaces = cloneTypeExprs(d.Interfaces)
	c.Annotations = cloneAnnotations(d.Annotations)
	var noCaptures @[]@Capture
	c.Captures = noCaptures
	c.ResolvedTypeID = 0
	c.ConstID = 0
	return c
}

// CloneFuncSignature returns a copy of the function declaration d (nil for
// nil) whose receiver, type parameters, parameters and results are cloned as
// CloneDecl clones them, for resolving the signature alone; the body is not
// copied (the copy's Body is nil).
func CloneFuncSignature(d @Decl) @Decl {
	if d == nil {
		return nil
	}
	var c @Decl = make(Decl)
	*c = *d
	c.Recv = cloneParamDecl(d.Recv)
	c.TypeParams = cloneTypeParams(d.TypeParams)
	c.Params = cloneParamDecls(d.Params)
	c.Results = cloneTypeExprs(d.Results)
	c.Body = nil
	c.TypeRef = CloneTypeExpr(d.TypeRef)
	c.Value = CloneExpr(d.Value)
	c.Decls = cloneDecls(d.Decls)
	c.Interfaces = cloneTypeExprs(d.Interfaces)
	c.Annotations = cloneAnnotations(d.Annotations)
	var noCaptures @[]@Capture
	c.Captures = noCaptures
	c.ResolvedTypeID = 0
	c.ConstID = 0
	return c
}

// CloneStmt returns a deep copy of the statement s (nil for nil).
func CloneStmt(s @Stmt) @Stmt {
	if s == nil {
		return nil
	}
	var c @Stmt = make(Stmt)
	*c = *s
	c.Stmts = cloneStmts(s.Stmts)
	c.Exprs = cloneExprs(s.Exprs)
	c.Exprs2 = cloneExprs(s.Exprs2)
	c.X = CloneExpr(s.X)
	c.Body = CloneStmt(s.Body)
	c.Else = CloneStmt(s.Else)
	c.Init = CloneStmt(s.Init)
	c.Post = CloneStmt(s.Post)
	c.ForKey = CloneExpr(s.ForKey)
	c.ForVal = CloneExpr(s.ForVal)
	c.Cases = cloneCaseClauses(s.Cases)
	c.DeclRef = CloneDecl(s.DeclRef)
	return c
}

// CloneExpr returns a deep copy of the expression e (nil for nil); a function
// literal's declaration (DeclRef) is cloned with it.
func CloneExpr(e @Expr) @Expr {
	if e == nil {
		return nil
	}
	var c @Expr = make(Expr)
	*c = *e
	c.X = CloneExpr(e.X)
	c.Y = CloneExpr(e.Y)
	c.Z = CloneExpr(e.Z)
	c.Args = cloneExprs(e.Args)
	c.TypeRef = CloneTypeExpr(e.TypeRef)
	c.Elems = cloneElements(e.Elems)
	c.DeclRef = CloneDecl(e.DeclRef)
	c.StrParts = cloneStrParts(e.StrParts)
	c.ResolvedTypeID = 0
	c.ImplicitAddr = false
	c.LitAddressed = false
	c.BorrowTemp = false
	return c
}

// CloneTypeExpr returns a deep copy of the type expression t (nil for nil).
func CloneTypeExpr(t @TypeExpr) @TypeExpr {
	if t == nil {
		return nil
	}
	var c @TypeExpr = make(TypeExpr)
	*c = *t
	c.Base = CloneTypeExpr(t.Base)
	c.Len = CloneExpr(t.Len)
	c.Fields = cloneFieldDecls(t.Fields)
	c.ParamTypes = cloneTypeExprs(t.ParamTypes)
	c.ResultTypes = cloneTypeExprs(t.ResultTypes)
	c.TypeArgs = cloneTypeExprs(t.TypeArgs)
	c.LenVal = 0
	c.LenKnown = false
	return c
}

// cloneDecls clones each declaration of ds.
func cloneDecls(ds *[]@Decl) @[]@Decl {
	var out @[]@Decl
	if len(ds) == 0 {
		return out
	}
	out = make_slice(@Decl, len(ds))
	for i := 0; i < len(ds); i++ {
		out[i] = CloneDecl(ds[i])
	}
	return out
}

// cloneStmts clones each statement of ss.
func cloneStmts(ss *[]@Stmt) @[]@Stmt {
	var out @[]@Stmt
	if len(ss) == 0 {
		return out
	}
	out = make_slice(@Stmt, len(ss))
	for i := 0; i < len(ss); i++ {
		out[i] = CloneStmt(ss[i])
	}
	return out
}

// cloneExprs clones each expression of es.
func cloneExprs(es *[]@Expr) @[]@Expr {
	var out @[]@Expr
	if len(es) == 0 {
		return out
	}
	out = make_slice(@Expr, len(es))
	for i := 0; i < len(es); i++ {
		out[i] = CloneExpr(es[i])
	}
	return out
}

// cloneTypeExprs clones each type expression of ts.
func cloneTypeExprs(ts *[]@TypeExpr) @[]@TypeExpr {
	var out @[]@TypeExpr
	if len(ts) == 0 {
		return out
	}
	out = make_slice(@TypeExpr, len(ts))
	for i := 0; i < len(ts); i++ {
		out[i] = CloneTypeExpr(ts[i])
	}
	return out
}

// cloneElements clones each composite-literal element of es; a clone's
// checker-folded key (KeyVal / KeyKnown) is cleared.
func cloneElements(es *[]@Element) @[]@Element {
	var out @[]@Element
	if len(es) == 0 {
		return out
	}
	out = make_slice(@Element, len(es))
	for i := 0; i < len(es); i++ {
		var c @Element = nil
		if es[i] != nil {
			c = make(Element)
			*c = *es[i]
			c.Key = CloneExpr(es[i].Key)
			c.Value = CloneExpr(es[i].Value)
			c.KeyVal = 0
			c.KeyKnown = false
		}
		out[i] = c
	}
	return out
}

// cloneStrParts copies each adjacent-string-literal part of ps.
func cloneStrParts(ps *[]@StrPart) @[]@StrPart {
	var out @[]@StrPart
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@StrPart, len(ps))
	for i := 0; i < len(ps); i++ {
		var c @StrPart = nil
		if ps[i] != nil {
			c = make(StrPart)
			*c = *ps[i]
		}
		out[i] = c
	}
	return out
}

// cloneParamDecl clones the parameter p (nil for nil).
func cloneParamDecl(p @ParamDecl) @ParamDecl {
	if p == nil {
		return nil
	}
	var c @ParamDecl = make(ParamDecl)
	*c = *p
	c.Type = CloneTypeExpr(p.Type)
	return c
}

// cloneParamDecls clones each parameter of ps.
func cloneParamDecls(ps *[]@ParamDecl) @[]@ParamDecl {
	var out @[]@ParamDecl
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@ParamDecl, len(ps))
	for i := 0; i < len(ps); i++ {
		out[i] = cloneParamDecl(ps[i])
	}
	return out
}

// cloneTypeParams clones each type parameter of ps.
func cloneTypeParams(ps *[]@TypeParam) @[]@TypeParam {
	var out @[]@TypeParam
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@TypeParam, len(ps))
	for i := 0; i < len(ps); i++ {
		var c @TypeParam = nil
		if ps[i] != nil {
			c = make(TypeParam)
			*c = *ps[i]
			c.Constraint = CloneTypeExpr(ps[i].Constraint)
		}
		out[i] = c
	}
	return out
}

// cloneFieldDecls clones each struct field of fs.
func cloneFieldDecls(fs *[]@FieldDecl) @[]@FieldDecl {
	var out @[]@FieldDecl
	if len(fs) == 0 {
		return out
	}
	out = make_slice(@FieldDecl, len(fs))
	for i := 0; i < len(fs); i++ {
		var c @FieldDecl = nil
		if fs[i] != nil {
			c = make(FieldDecl)
			*c = *fs[i]
			c.Type = CloneTypeExpr(fs[i].Type)
		}
		out[i] = c
	}
	return out
}

// cloneCaseClauses clones each switch clause of cs.
func cloneCaseClauses(cs *[]@CaseClause) @[]@CaseClause {
	var out @[]@CaseClause
	if len(cs) == 0 {
		return out
	}
	out = make_slice(@CaseClause, len(cs))
	for i := 0; i < len(cs); i++ {
		var c @CaseClause = nil
		if cs[i] != nil {
			c = make(CaseClause)
			*c = *cs[i]
			c.Exprs = cloneExprs(cs[i].Exprs)
			c.Body = cloneStmts(cs[i].Body)
			c.Types = cloneTypeExprs(cs[i].Types)
		}
		out[i] = c
	}
	return out
}

// cloneAnnotations clones each annotation of as.
func cloneAnnotations(as *[]@Annotation) @[]@Annotation {
	var out @[]@Annotation
	if len(as) == 0 {
		return out
	}
	out = make_slice(@Annotation, len(as))
	for i := 0; i < len(as); i++ {
		var c @Annotation = nil
		if as[i] != nil {
			c = make(Annotation)
			*c = *as[i]
			c.Args = cloneExprs(as[i].Args)
		}
		out[i] = c
	}
	return out
}
