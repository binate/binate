package "pkg/binate/ast"

// Deep copies of AST subtrees, and the clearing of the type checker's
// annotations in place.  A generic declaration is checked, and its code
// generated, once per instantiation; each works on its own clone, so the
// annotations the type checker leaves on nodes — resolved types, constant ids,
// array lengths and literal keys, a function literal's captures — belong to one
// instantiation.  A clone shares no node with the original.  It copies every
// field the parser and loader set, and starts with the checker's annotations
// cleared: Expr / Decl ResolvedTypeID, Expr / TypeExpr DenotedTypeID, Decl
// ConstID, TypeExpr LenVal / LenKnown, Element KeyVal / KeyKnown, Decl Captures
// and Expr ImplicitAddr / LitAddressed / BorrowTemp / FieldSel /
// PredeclaredPanic.  ClearCheckerAnnotations clears the same annotations of the
// same nodes in place — and Expr ViaConstraint, which a clone keeps — for a
// declaration checked again: one walk does both, copying each node when `fresh`
// and reusing it otherwise.
// Each node is copied whole first, so a field added to a node is copied with
// it; a field that holds nodes must be walked here too
// (TestCloneNodeFieldsPinned fails when a node type's fields change, and
// TestCloneSharesNoNode checks the fields it walks).
// Text (names, literals) is shared: nothing modifies it in place.

// CloneDecl returns a deep copy of the declaration d (nil for nil).
func CloneDecl(d @Decl) @Decl {
	return copyDecl(d, true)
}

// ClearCheckerAnnotations clears, in place, the type checker's annotations of
// the declaration d and of every node it holds — the ones a clone starts
// without, and ViaConstraint — so that checking d again reads its syntax
// afresh; the nodes themselves are kept, as is the rewrite the check makes of
// an unsafe_index call.
func ClearCheckerAnnotations(d @Decl) {
	_ = copyDecl(d, false)
}

// copyDecl returns d (nil for nil) with the checker's annotations cleared: a
// deep copy when fresh, else d itself, its nodes cleared in place.
func copyDecl(d @Decl, fresh bool) @Decl {
	if d == nil {
		return nil
	}
	var c @Decl = d
	if fresh {
		c = make(Decl)
		*c = *d
	}
	c.Recv = copyParamDecl(d.Recv, fresh)
	c.TypeParams = copyTypeParams(d.TypeParams, fresh)
	c.Params = copyParamDecls(d.Params, fresh)
	c.Results = copyTypeExprs(d.Results, fresh)
	c.Body = copyStmt(d.Body, fresh)
	c.TypeRef = copyTypeExpr(d.TypeRef, fresh)
	c.Value = copyExpr(d.Value, fresh)
	c.Decls = copyDecls(d.Decls, fresh)
	c.Interfaces = copyTypeExprs(d.Interfaces, fresh)
	c.Annotations = copyAnnotations(d.Annotations, fresh)
	clearDeclAnnotations(c)
	return c
}

// clearDeclAnnotations clears the checker's annotations of the declaration
// node d itself.
func clearDeclAnnotations(d @Decl) {
	var noCaptures @[]@Capture
	d.Captures = noCaptures
	d.ResolvedTypeID = 0
	d.ConstID = 0
}

// CloneFuncSignature returns a copy of the function declaration d (nil for
// nil) whose receiver, type parameters, parameters and results are cloned as
// CloneDecl clones them, for resolving the signature alone; the body is not
// copied (the copy's Body is nil).
func CloneFuncSignature(d @Decl) @Decl {
	if d == nil {
		return nil
	}
	var c @Decl = make(Decl)
	*c = *d
	c.Recv = copyParamDecl(d.Recv, true)
	c.TypeParams = copyTypeParams(d.TypeParams, true)
	c.Params = copyParamDecls(d.Params, true)
	c.Results = copyTypeExprs(d.Results, true)
	c.Body = nil
	c.TypeRef = copyTypeExpr(d.TypeRef, true)
	c.Value = copyExpr(d.Value, true)
	c.Decls = copyDecls(d.Decls, true)
	c.Interfaces = copyTypeExprs(d.Interfaces, true)
	c.Annotations = copyAnnotations(d.Annotations, true)
	clearDeclAnnotations(c)
	return c
}

// CloneStmt returns a deep copy of the statement s (nil for nil).
func CloneStmt(s @Stmt) @Stmt {
	return copyStmt(s, true)
}

// copyStmt is copyDecl for the statement s.
func copyStmt(s @Stmt, fresh bool) @Stmt {
	if s == nil {
		return nil
	}
	var c @Stmt = s
	if fresh {
		c = make(Stmt)
		*c = *s
	}
	c.Stmts = copyStmts(s.Stmts, fresh)
	c.Exprs = copyExprs(s.Exprs, fresh)
	c.Exprs2 = copyExprs(s.Exprs2, fresh)
	c.X = copyExpr(s.X, fresh)
	c.Body = copyStmt(s.Body, fresh)
	c.Else = copyStmt(s.Else, fresh)
	c.Init = copyStmt(s.Init, fresh)
	c.Post = copyStmt(s.Post, fresh)
	c.ForKey = copyExpr(s.ForKey, fresh)
	c.ForVal = copyExpr(s.ForVal, fresh)
	c.Cases = copyCaseClauses(s.Cases, fresh)
	c.DeclRef = copyDecl(s.DeclRef, fresh)
	return c
}

// CloneExpr returns a deep copy of the expression e (nil for nil); a function
// literal's declaration (DeclRef) is cloned with it.
func CloneExpr(e @Expr) @Expr {
	return copyExpr(e, true)
}

// copyExpr is copyDecl for the expression e.
func copyExpr(e @Expr, fresh bool) @Expr {
	if e == nil {
		return nil
	}
	var c @Expr = e
	if fresh {
		c = make(Expr)
		*c = *e
		c.StrParts = cloneStrParts(e.StrParts)
	}
	c.X = copyExpr(e.X, fresh)
	c.Y = copyExpr(e.Y, fresh)
	c.Z = copyExpr(e.Z, fresh)
	c.Args = copyExprs(e.Args, fresh)
	c.TypeRef = copyTypeExpr(e.TypeRef, fresh)
	c.Elems = copyElements(e.Elems, fresh)
	c.DeclRef = copyDecl(e.DeclRef, fresh)
	c.ResolvedTypeID = 0
	c.ImplicitAddr = false
	c.LitAddressed = false
	c.BorrowTemp = false
	c.FieldSel = false
	c.PredeclaredPanic = false
	c.DenotedTypeID = 0
	// An instance's check, on a clone, keeps the generic body's decision; a
	// declaration checked again on its own syntax decides again.
	if !fresh {
		c.ViaConstraint = false
	}
	return c
}

// CloneTypeExpr returns a deep copy of the type expression t (nil for nil).
func CloneTypeExpr(t @TypeExpr) @TypeExpr {
	return copyTypeExpr(t, true)
}

// copyTypeExpr is copyDecl for the type expression t.
func copyTypeExpr(t @TypeExpr, fresh bool) @TypeExpr {
	if t == nil {
		return nil
	}
	var c @TypeExpr = t
	if fresh {
		c = make(TypeExpr)
		*c = *t
	}
	c.Base = copyTypeExpr(t.Base, fresh)
	c.Len = copyExpr(t.Len, fresh)
	c.Fields = copyFieldDecls(t.Fields, fresh)
	c.ParamTypes = copyTypeExprs(t.ParamTypes, fresh)
	c.ResultTypes = copyTypeExprs(t.ResultTypes, fresh)
	c.TypeArgs = copyTypeExprs(t.TypeArgs, fresh)
	c.LenVal = 0
	c.LenKnown = false
	c.DenotedTypeID = 0
	return c
}

// copyDecls copies (or clears in place, as copyDecl) each declaration of ds.
func copyDecls(ds *[]@Decl, fresh bool) @[]@Decl {
	var out @[]@Decl
	if len(ds) == 0 {
		return out
	}
	out = make_slice(@Decl, len(ds))
	for i := 0; i < len(ds); i++ {
		out[i] = copyDecl(ds[i], fresh)
	}
	return out
}

// copyStmts copies (or clears in place) each statement of ss.
func copyStmts(ss *[]@Stmt, fresh bool) @[]@Stmt {
	var out @[]@Stmt
	if len(ss) == 0 {
		return out
	}
	out = make_slice(@Stmt, len(ss))
	for i := 0; i < len(ss); i++ {
		out[i] = copyStmt(ss[i], fresh)
	}
	return out
}

// copyExprs copies (or clears in place) each expression of es.
func copyExprs(es *[]@Expr, fresh bool) @[]@Expr {
	var out @[]@Expr
	if len(es) == 0 {
		return out
	}
	out = make_slice(@Expr, len(es))
	for i := 0; i < len(es); i++ {
		out[i] = copyExpr(es[i], fresh)
	}
	return out
}

// copyTypeExprs copies (or clears in place) each type expression of ts.
func copyTypeExprs(ts *[]@TypeExpr, fresh bool) @[]@TypeExpr {
	var out @[]@TypeExpr
	if len(ts) == 0 {
		return out
	}
	out = make_slice(@TypeExpr, len(ts))
	for i := 0; i < len(ts); i++ {
		out[i] = copyTypeExpr(ts[i], fresh)
	}
	return out
}

// copyElements copies (or clears in place) each composite-literal element of
// es; the checker-folded key (KeyVal / KeyKnown) is cleared.
func copyElements(es *[]@Element, fresh bool) @[]@Element {
	var out @[]@Element
	if len(es) == 0 {
		return out
	}
	out = make_slice(@Element, len(es))
	for i := 0; i < len(es); i++ {
		var c @Element = es[i]
		if c != nil {
			if fresh {
				c = make(Element)
				*c = *es[i]
			}
			c.Key = copyExpr(es[i].Key, fresh)
			c.Value = copyExpr(es[i].Value, fresh)
			c.KeyVal = 0
			c.KeyKnown = false
		}
		out[i] = c
	}
	return out
}

// cloneStrParts copies each adjacent-string-literal part of ps.
func cloneStrParts(ps *[]@StrPart) @[]@StrPart {
	var out @[]@StrPart
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@StrPart, len(ps))
	for i := 0; i < len(ps); i++ {
		var c @StrPart = nil
		if ps[i] != nil {
			c = make(StrPart)
			*c = *ps[i]
		}
		out[i] = c
	}
	return out
}

// copyParamDecl copies (or clears in place) the parameter p (nil for nil).
func copyParamDecl(p @ParamDecl, fresh bool) @ParamDecl {
	if p == nil {
		return nil
	}
	var c @ParamDecl = p
	if fresh {
		c = make(ParamDecl)
		*c = *p
	}
	c.Type = copyTypeExpr(p.Type, fresh)
	return c
}

// copyParamDecls copies (or clears in place) each parameter of ps.
func copyParamDecls(ps *[]@ParamDecl, fresh bool) @[]@ParamDecl {
	var out @[]@ParamDecl
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@ParamDecl, len(ps))
	for i := 0; i < len(ps); i++ {
		out[i] = copyParamDecl(ps[i], fresh)
	}
	return out
}

// copyTypeParams copies (or clears in place) each type parameter of ps.
func copyTypeParams(ps *[]@TypeParam, fresh bool) @[]@TypeParam {
	var out @[]@TypeParam
	if len(ps) == 0 {
		return out
	}
	out = make_slice(@TypeParam, len(ps))
	for i := 0; i < len(ps); i++ {
		var c @TypeParam = ps[i]
		if c != nil {
			if fresh {
				c = make(TypeParam)
				*c = *ps[i]
			}
			c.Constraint = copyTypeExpr(ps[i].Constraint, fresh)
		}
		out[i] = c
	}
	return out
}

// copyFieldDecls copies (or clears in place) each struct field of fs.
func copyFieldDecls(fs *[]@FieldDecl, fresh bool) @[]@FieldDecl {
	var out @[]@FieldDecl
	if len(fs) == 0 {
		return out
	}
	out = make_slice(@FieldDecl, len(fs))
	for i := 0; i < len(fs); i++ {
		var c @FieldDecl = fs[i]
		if c != nil {
			if fresh {
				c = make(FieldDecl)
				*c = *fs[i]
			}
			c.Type = copyTypeExpr(fs[i].Type, fresh)
		}
		out[i] = c
	}
	return out
}

// copyCaseClauses copies (or clears in place) each switch clause of cs.
func copyCaseClauses(cs *[]@CaseClause, fresh bool) @[]@CaseClause {
	var out @[]@CaseClause
	if len(cs) == 0 {
		return out
	}
	out = make_slice(@CaseClause, len(cs))
	for i := 0; i < len(cs); i++ {
		var c @CaseClause = cs[i]
		if c != nil {
			if fresh {
				c = make(CaseClause)
				*c = *cs[i]
			}
			c.Exprs = copyExprs(cs[i].Exprs, fresh)
			c.Body = copyStmts(cs[i].Body, fresh)
			c.Types = copyTypeExprs(cs[i].Types, fresh)
		}
		out[i] = c
	}
	return out
}

// copyAnnotations copies (or clears in place) each annotation of as.
func copyAnnotations(as *[]@Annotation, fresh bool) @[]@Annotation {
	var out @[]@Annotation
	if len(as) == 0 {
		return out
	}
	out = make_slice(@Annotation, len(as))
	for i := 0; i < len(as); i++ {
		var c @Annotation = as[i]
		if c != nil {
			if fresh {
				c = make(Annotation)
				*c = *as[i]
			}
			c.Args = copyExprs(as[i].Args, fresh)
		}
		out[i] = c
	}
	return out
}
