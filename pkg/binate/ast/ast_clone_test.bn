package "pkg/binate/ast"

import "pkg/builtins/reflect"
import "pkg/builtins/testing"

// Tests for ast_clone.bn: a clone copies the parser's fields, shares no node
// with the original, and starts with the checker's annotations cleared.
// TestCloneSharesNoNode (pkg/binate/parser) checks a parsed program covering
// every node kind; TestCloneNodeFieldsPinned fails when a node type gains or
// loses a field, so the clone and that check are updated with it.

// identExpr builds an EXPR_IDENT carrying a checker-resolved type id.
func identExpr(name *[]readonly char, typeID int) @Expr {
	var e @Expr = make(Expr)
	e.Kind = EXPR_IDENT
	e.Name = namedTE(name).Name
	e.ResolvedTypeID = typeID
	return e
}

// A cloned expression copies its fields and children, clears the type checker's
// annotations (ResolvedTypeID, ImplicitAddr, LitAddressed, BorrowTemp), and leaves the
// original untouched.
// Unchecked is kept: it marks the index node the checker rewrites an
// unsafe_index call into, and the clone keeps the rewritten node.
func TestCloneExprResetsAnnotations() testing.TestResult {
	var bin @Expr = make(Expr)
	bin.Kind = EXPR_BINARY
	bin.Op = 7
	bin.X = identExpr("a", 3)
	bin.Y = identExpr("b", 4)
	bin.ResolvedTypeID = 5
	bin.ImplicitAddr = true
	bin.Unchecked = true
	bin.LitAddressed = true
	bin.BorrowTemp = true
	bin.Parenthesized = true
	var c @Expr = CloneExpr(bin)
	if same(c, bin) || same(c.X, bin.X) || same(c.Y, bin.Y) {
		return "a clone must not share a node with the original"
	}
	if c.Kind != EXPR_BINARY || c.Op != 7 || !c.Parenthesized || c.X.Name[0] != 'a' ||
			c.Y.Name[0] != 'b' {
		return "a clone must copy the parser's fields"
	}
	if c.ResolvedTypeID != 0 || c.X.ResolvedTypeID != 0 || c.Y.ResolvedTypeID != 0 {
		return "a clone must clear ResolvedTypeID"
	}
	if c.ImplicitAddr { return "a clone must clear ImplicitAddr" }
	if !c.Unchecked { return "a clone must keep Unchecked" }
	if c.LitAddressed { return "a clone must clear LitAddressed" }
	if c.BorrowTemp { return "a clone must clear BorrowTemp" }
	if bin.ResolvedTypeID != 5 || bin.X.ResolvedTypeID != 3 || !bin.ImplicitAddr {
		return "cloning must not modify the original"
	}
	return ""
}

// A function literal's declaration is cloned with it; its captures and the
// annotations in its body are cleared.
func TestCloneFuncLitDecl() testing.TestResult {
	var lit @Expr = make(Expr)
	lit.Kind = EXPR_FUNC_LIT
	var d @Decl = make(Decl)
	d.Kind = DECL_FUNC
	d.ResolvedTypeID = 9
	var caps @[]@Capture = make_slice(@Capture, 1)
	caps[0] = make(Capture)
	caps[0].Name = namedTE("x").Name
	d.Captures = caps
	var body @Stmt = make(Stmt)
	body.Kind = STMT_RETURN
	var rs @[]@Expr = make_slice(@Expr, 1)
	rs[0] = identExpr("x", 2)
	body.Exprs = rs
	d.Body = body
	lit.DeclRef = d
	var c @Expr = CloneExpr(lit)
	if same(c.DeclRef, d) || same(c.DeclRef.Body, body) || same(c.DeclRef.Body.Exprs[0], rs[0]) {
		return "a function literal's declaration and body must be cloned"
	}
	if len(c.DeclRef.Captures) != 0 || c.DeclRef.ResolvedTypeID != 0 ||
			c.DeclRef.Body.Exprs[0].ResolvedTypeID != 0 {
		return "a cloned function literal must start without captures or resolved types"
	}
	if len(d.Captures) != 1 {
		return "cloning must not modify the original's captures"
	}
	return ""
}

// A cloned array type clears its checker-stamped length; a cloned keyed element
// clears its checker-folded key; a cloned constant declaration clears ConstID.
func TestCloneClearsLengthsKeysAndConstIDs() testing.TestResult {
	var arr @TypeExpr = make(TypeExpr)
	arr.Kind = TEXPR_ARRAY
	arr.Base = namedTE("int")
	arr.Len = identExpr("N", 1)
	arr.LenVal = 8
	arr.LenKnown = true
	var lit @Expr = make(Expr)
	lit.Kind = EXPR_COMPOSITE
	lit.TypeRef = arr
	var elems @[]@Element = make_slice(@Element, 1)
	elems[0] = make(Element)
	elems[0].Key = identExpr("K", 1)
	elems[0].Value = identExpr("v", 1)
	elems[0].KeyVal = 3
	elems[0].KeyKnown = true
	lit.Elems = elems
	var c @Expr = CloneExpr(lit)
	if same(c.TypeRef, arr) || same(c.TypeRef.Base, arr.Base) || same(c.TypeRef.Len, arr.Len) ||
			same(c.Elems[0], elems[0]) || same(c.Elems[0].Key, elems[0].Key) {
		return "a cloned composite literal must not share a node with the original"
	}
	if c.TypeRef.LenKnown || c.TypeRef.LenVal != 0 || c.Elems[0].KeyKnown || c.Elems[0].KeyVal != 0 {
		return "a clone must clear LenVal / LenKnown and KeyVal / KeyKnown"
	}
	if !arr.LenKnown || !elems[0].KeyKnown {
		return "cloning must not modify the original"
	}
	var d @Decl = make(Decl)
	d.Kind = DECL_CONST
	d.ConstID = 4
	d.Value = identExpr("K", 1)
	var cd @Decl = CloneDecl(d)
	if cd.ConstID != 0 || same(cd.Value, d.Value) || d.ConstID != 4 {
		return "a cloned constant declaration must clear ConstID and clone its value"
	}
	return ""
}

// A signature clone copies the receiver, parameters and results and leaves the
// body out.
func TestCloneFuncSignature() testing.TestResult {
	var d @Decl = make(Decl)
	d.Kind = DECL_FUNC
	var ps @[]@ParamDecl = make_slice(@ParamDecl, 1)
	ps[0] = make(ParamDecl)
	ps[0].Type = namedTE("int")
	d.Params = ps
	var rs @[]@TypeExpr = make_slice(@TypeExpr, 1)
	rs[0] = namedTE("bool")
	d.Results = rs
	d.Body = make(Stmt)
	d.ResolvedTypeID = 3
	var c @Decl = CloneFuncSignature(d)
	if same(c, d) || same(c.Params[0], ps[0]) || same(c.Params[0].Type, ps[0].Type) ||
			same(c.Results[0], rs[0]) {
		return "a signature clone must not share the signature's nodes"
	}
	if c.Body != nil || c.ResolvedTypeID != 0 || d.Body == nil {
		return "a signature clone must leave the body out and clear ResolvedTypeID"
	}
	if CloneFuncSignature(nil) != nil {
		return "a signature clone of nil must be nil"
	}
	return ""
}

// Cloning nil gives nil.
func TestCloneNil() testing.TestResult {
	if CloneDecl(nil) != nil || CloneStmt(nil) != nil || CloneExpr(nil) != nil ||
			CloneTypeExpr(nil) != nil {
		return "cloning nil must give nil"
	}
	return ""
}

// fieldNames returns the names of the fields of the struct boxed in x,
// space-separated, in declaration order.
func fieldNames(x *any) @[]char {
	var ti *reflect.TypeInfo = reflect.TypeOf(x)
	var n int = 0
	for i := 0; i < len(ti.Fields); i++ {
		n = n + len(ti.Fields[i].Name) + 1
	}
	var out @[]char = make_slice(char, n)
	var k int = 0
	for i := 0; i < len(ti.Fields); i++ {
		for j := 0; j < len(ti.Fields[i].Name); j++ {
			out[k] = ti.Fields[i].Name[j]
			k++
		}
		out[k] = ' '
		k++
	}
	return out
}

// sameText reports whether a and b hold the same characters.
func sameText(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// The fields of every node type the clone copies are pinned: when one changes,
// update ast_clone.bn (clone a field that holds nodes, clear one the type
// checker annotates) and the walk in pkg/binate/parser's TestCloneSharesNoNode,
// then this list.
func TestCloneNodeFieldsPinned() testing.TestResult {
	var e Expr
	var sp StrPart
	var st Stmt
	var d Decl
	var te TypeExpr
	var el Element
	var pd ParamDecl
	var tp TypeParam
	var fd FieldDecl
	var cc CaseClause
	var an Annotation
	var got @[]@[]char = make_slice(@[]char, 11)
	got[0] = fieldNames(&e)
	got[1] = fieldNames(&sp)
	got[2] = fieldNames(&st)
	got[3] = fieldNames(&d)
	got[4] = fieldNames(&te)
	got[5] = fieldNames(&el)
	got[6] = fieldNames(&pd)
	got[7] = fieldNames(&tp)
	got[8] = fieldNames(&fd)
	got[9] = fieldNames(&cc)
	got[10] = fieldNames(&an)
	var want @[]*[]readonly char = make_slice(*[]readonly char, 11)
	want[0] = "Kind Pos Name BoolVal Op X Y Z Args TypeRef Elems DeclRef ResolvedTypeID CFixedArgs "
			"CVariadic Spread Unchecked StrParts Parenthesized ImplicitAddr LitAddressed BorrowTemp "
	want[1] = "Lit Pos "
	want[2] = "Kind Pos End Stmts Exprs Exprs2 X Op Body Else Init Post ForKey ForVal Cases DeclRef "
			"Binder "
	want[3] = "Kind Pos End Name Recv TypeParams Params Results Body TypeRef Value IsAlias IsForward "
			"Decls Interfaces Captures ResolvedTypeID ConstID Exported FromBNI Annotations "
	want[4] = "Kind Pos End Name Pkg Base Len Fields LenVal LenKnown LenInferred ParamTypes "
			"ResultTypes VariadicParams TypeArgs "
	want[5] = "Key Value KeyVal KeyKnown "
	want[6] = "Pos Name Type Variadic "
	want[7] = "Pos Name Constraint "
	want[8] = "Pos Name Type "
	want[9] = "Pos Exprs Body Types "
	want[10] = "Pos Name Args "
	for i := 0; i < len(want); i++ {
		if !sameText(got[i], want[i]) {
			return "an AST node type's fields changed: update the clone, the no-sharing walk, and this list"
		}
	}
	return ""
}
