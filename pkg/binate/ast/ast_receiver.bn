package "pkg/binate/ast"

// Receiver binders of a method or impl on a generic type (`func (p *Pair[K, V])`,
// `impl *Pair[_, V] : I[V]`): each bracketed name binds the type parameter at its
// position.  A blank `_` binder binds its position without naming it, yet a type
// checker or IR generator resolves the receiver type `*Pair[_, V]` by looking each
// binder up by name — and several `_` positions cannot be told apart by name.
// ReceiverBinderName gives every position a distinct name to bind it under, and
// WithNamedBlankBinders rewrites a receiver type to use those names.

// isBlankIdent reports whether name is the blank identifier `_`.
func isBlankIdent(name *[]readonly char) bool {
	return len(name) == 1 && name[0] == '_'
}

// isBlankBinder reports whether the receiver bracket entry arg is a blank `_`.
func isBlankBinder(arg @TypeExpr) bool {
	return arg != nil && arg.Kind == TEXPR_NAMED && len(arg.Pkg) == 0 && isBlankIdent(arg.Name)
}

// ReceiverBinderName returns the name the receiver binder `binder`, at position
// index of the receiver's brackets, is bound under: its own name, or — for a
// blank `_` — `_#<index>`.  `#` cannot appear in an identifier, so each blank
// position binds independently and no source reference can name it.
func ReceiverBinderName(binder @TypeExpr, index int) @[]char {
	if !isBlankBinder(binder) {
		return binder.Name
	}
	var digits int = 1
	for v := index; v >= 10; v = v / 10 {
		digits++
	}
	var out @[]char = make_slice(char, 2 + digits)
	out[0] = '_'
	out[1] = '#'
	var v int = index
	for i := len(out) - 1; i >= 2; i-- {
		out[i] = '0' + cast(char, v % 10)
		v = v / 10
	}
	return out
}

// WithNamedBlankBinders returns the receiver type te (`*Pair[_, V]`) with each
// blank `_` binder of its generic instantiation replaced by its
// ReceiverBinderName, so resolving the receiver by binder lookup reaches each
// blank position's own parameter.  The nodes from te down to the instantiation
// are copied (te is not modified); te itself is returned when it names no
// generic instantiation or has no blank binder.
func WithNamedBlankBinders(te @TypeExpr) @TypeExpr {
	if te == nil {
		return te
	}
	if te.Kind == TEXPR_POINTER || te.Kind == TEXPR_MANAGED || te.Kind == TEXPR_CONST ||
			te.Kind == TEXPR_PAREN {
		var base @TypeExpr = WithNamedBlankBinders(te.Base)
		if base == te.Base {
			return te
		}
		var w @TypeExpr = copyTypeExprNode(te)
		w.Base = base
		return w
	}
	if te.Kind != TEXPR_INSTANTIATE {
		return te
	}
	var anyBlank bool = false
	for i := 0; i < len(te.TypeArgs); i++ {
		if isBlankBinder(te.TypeArgs[i]) {
			anyBlank = true
		}
	}
	if !anyBlank {
		return te
	}
	var args @[]@TypeExpr = make_slice(@TypeExpr, len(te.TypeArgs))
	for i := 0; i < len(te.TypeArgs); i++ {
		args[i] = te.TypeArgs[i]
		if isBlankBinder(te.TypeArgs[i]) {
			var named @TypeExpr = copyTypeExprNode(te.TypeArgs[i])
			named.Name = ReceiverBinderName(te.TypeArgs[i], i)
			args[i] = named
		}
	}
	var inst @TypeExpr = copyTypeExprNode(te)
	inst.TypeArgs = args
	return inst
}

// copyTypeExprNode returns a new node carrying te's kind, position, name and
// children — every field a receiver's wrapper, instantiation or binder node
// uses.
func copyTypeExprNode(te @TypeExpr) @TypeExpr {
	var n @TypeExpr = make(TypeExpr)
	n.Kind = te.Kind
	n.Pos = te.Pos
	n.End = te.End
	n.Name = te.Name
	n.Pkg = te.Pkg
	n.Base = te.Base
	n.TypeArgs = te.TypeArgs
	return n
}
