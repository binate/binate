package "pkg/binate/ast"

import "pkg/builtins/testing"

// namedTE builds a TEXPR_NAMED node.
func namedTE(name *[]readonly char) @TypeExpr {
	var te @TypeExpr = make(TypeExpr)
	te.Kind = TEXPR_NAMED
	var n @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		n[i] = name[i]
	}
	te.Name = n
	return te
}

// ptrToInstTE builds the receiver `*Head[args...]`.
func ptrToInstTE(head *[]readonly char, args @[]@TypeExpr) @TypeExpr {
	var inst @TypeExpr = make(TypeExpr)
	inst.Kind = TEXPR_INSTANTIATE
	inst.Base = namedTE(head)
	inst.TypeArgs = args
	var ptr @TypeExpr = make(TypeExpr)
	ptr.Kind = TEXPR_POINTER
	ptr.Base = inst
	return ptr
}

func TestReceiverBinderName() testing.TestResult {
	var r testing.TestResult
	r = check_streq(ReceiverBinderName(namedTE("K"), 0), "K", "named binder keeps its name")
	if len(r) > 0 { return r }
	r = check_streq(ReceiverBinderName(namedTE("_"), 0), "_#0", "blank at 0")
	if len(r) > 0 { return r }
	r = check_streq(ReceiverBinderName(namedTE("_"), 7), "_#7", "blank at 7")
	if len(r) > 0 { return r }
	r = check_streq(ReceiverBinderName(namedTE("_"), 12), "_#12", "blank at 12")
	if len(r) > 0 { return r }
	return check_streq(ReceiverBinderName(namedTE("_"), 100), "_#100", "blank at 100")
}

func TestWithNamedBlankBindersRenamesEachBlank() testing.TestResult {
	var args @[]@TypeExpr = make_slice(@TypeExpr, 3)
	args[0] = namedTE("_")
	args[1] = namedTE("V")
	args[2] = namedTE("_")
	var recv @TypeExpr = ptrToInstTE("Triple", args)
	var got @TypeExpr = WithNamedBlankBinders(recv)
	if got == recv {
		return "a receiver with blank binders must be copied"
	}
	if got.Kind != TEXPR_POINTER || got.Base == nil || got.Base.Kind != TEXPR_INSTANTIATE {
		return "the wrapper and instantiation shape must be kept"
	}
	if got.Base.Base != recv.Base.Base {
		return "the instantiation head must be kept"
	}
	var ga @[]@TypeExpr = got.Base.TypeArgs
	if len(ga) != 3 {
		return "all three binders must be kept"
	}
	var r testing.TestResult
	r = check_streq(ga[0].Name, "_#0", "first blank")
	if len(r) > 0 { return r }
	r = check_streq(ga[1].Name, "V", "named binder")
	if len(r) > 0 { return r }
	r = check_streq(ga[2].Name, "_#2", "second blank")
	if len(r) > 0 { return r }
	if ga[1] != args[1] {
		return "a named binder node must be shared, not copied"
	}
	// The input is not modified.
	r = check_streq(recv.Base.TypeArgs[0].Name, "_", "input first blank unchanged")
	if len(r) > 0 { return r }
	return check_streq(recv.Base.TypeArgs[2].Name, "_", "input second blank unchanged")
}

func TestWithNamedBlankBindersNoBlankIsIdentity() testing.TestResult {
	var args @[]@TypeExpr = make_slice(@TypeExpr, 2)
	args[0] = namedTE("K")
	args[1] = namedTE("V")
	var recv @TypeExpr = ptrToInstTE("Pair", args)
	if WithNamedBlankBinders(recv) != recv {
		return "a receiver without blank binders must be returned as is"
	}
	var plain @TypeExpr = namedTE("T")
	if WithNamedBlankBinders(plain) != plain {
		return "a non-generic receiver must be returned as is"
	}
	return ""
}

func TestWithNamedBlankBindersQualifiedBlankIsNotABinder() testing.TestResult {
	// `pkg._` is a (malformed) qualified name, not a blank binder.
	var args @[]@TypeExpr = make_slice(@TypeExpr, 1)
	args[0] = namedTE("_")
	args[0].Pkg = namedTE("p").Name
	var recv @TypeExpr = ptrToInstTE("Box", args)
	if WithNamedBlankBinders(recv) != recv {
		return "a package-qualified `_` must not be renamed"
	}
	return ""
}
