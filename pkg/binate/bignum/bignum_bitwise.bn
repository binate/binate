package "pkg/binate/bignum"

// Bitwise operators and shifts on constants.  Each value is read as its
// two's-complement representation extended infinitely to the left (a
// non-negative value has infinitely many leading 0 bits, a negative one
// infinitely many leading 1 bits), so every result is an exact integer that
// depends on no width; a result outside the union range [-2^63, 2^64-1] is
// reported with ok=false, like any other constant operation.

// twos returns a's infinite two's-complement representation within the union
// range: its value mod 2^64 (lo) and whether it is negative (neg) — the sign
// bit, which extends infinitely to the left.  A negative value in range,
// -2^63..-1, has lo in [2^63, 2^64-1].
func twos(a Num) (uint64, bool) {
	if !a.IsNegative() {
		return a.Magnitude, false
	}
	return cast(uint64, 0) - a.Magnitude, true
}

// fromTwos converts an infinite two's-complement value (lo, neg) back to a
// Num.  ok=false when it lies outside the union range: a negative value below
// -2^63, i.e. lo < 2^63.
func fromTwos(lo uint64, neg bool) (Num, bool) {
	if !neg {
		return makeNum(lo, false)
	}
	if lo < (cast(uint64, 1) << cast(uint64, 63)) {
		var zero Num
		return zero, false
	}
	return makeNum(cast(uint64, 0) - lo, true)
}

// And returns the bitwise AND of a and b on their infinitely sign-extended
// two's-complement representations.  Always in range for in-range operands.
func (a Num) And(b Num) (Num, bool) {
	var alo uint64
	var aneg bool
	var blo uint64
	var bneg bool
	alo, aneg = twos(a)
	blo, bneg = twos(b)
	return fromTwos(alo & blo, aneg && bneg)
}

// Or returns the bitwise OR of a and b on their infinitely sign-extended
// two's-complement representations.  Always in range for in-range operands.
func (a Num) Or(b Num) (Num, bool) {
	var alo uint64
	var aneg bool
	var blo uint64
	var bneg bool
	alo, aneg = twos(a)
	blo, bneg = twos(b)
	return fromTwos(alo | blo, aneg || bneg)
}

// Xor returns the bitwise XOR of a and b on their infinitely sign-extended
// two's-complement representations.  ok=false when the result leaves the union
// range — exactly when one operand is negative and the other is >= 2^63.
func (a Num) Xor(b Num) (Num, bool) {
	var alo uint64
	var aneg bool
	var blo uint64
	var bneg bool
	alo, aneg = twos(a)
	blo, bneg = twos(b)
	return fromTwos(alo ^ blo, aneg != bneg)
}

// Not returns the bitwise complement of a on its infinitely sign-extended
// two's-complement representation, i.e. -a - 1.  ok=false when the result
// leaves the union range — exactly when a >= 2^63.
func (a Num) Not() (Num, bool) {
	var lo uint64
	var neg bool
	lo, neg = twos(a)
	return fromTwos(~lo, !neg)
}

// Shl returns a << b (b is the non-negative shift count): a·2^b exactly, for a
// negative a too.  Like multiplication, it OVERFLOWS (ok=false) when the true
// value leaves the union range — a constant shift is value-producing, not a
// modular width-64 shift.
func (a Num) Shl(b Num) (Num, bool) {
	if a.Magnitude == 0 {
		return Zero(), true
	}
	var n uint64 = b.Magnitude
	if n >= cast(uint64, 64) {
		// a != 0, so |a << n| >= 2^64 — out of range.
		var zero Num
		return zero, false
	}
	if n == 0 {
		return a, true
	}
	if a.Sign {
		// -m·2^n is in range iff m·2^n <= 2^63, i.e. m <= 2^(63-n).
		if a.Magnitude > (cast(uint64, 1) << (cast(uint64, 63) - n)) {
			var zero Num
			return zero, false
		}
		return makeNum(a.Magnitude << n, true)
	}
	// Overflow iff a has a set bit at position >= 64 - n, i.e.
	// a.Magnitude >= 2^(64-n).
	var threshold uint64 = cast(uint64, 1) << (cast(uint64, 64) - n)
	if a.Magnitude >= threshold {
		var zero Num
		return zero, false
	}
	var r Num
	var ok bool
	r, ok = makeNum(a.Magnitude << n, false)
	return r, ok
}

// Shr returns a >> b (b is the non-negative shift count): floor(a / 2^b), an
// arithmetic shift of the infinitely sign-extended representation — a logical
// shift of the magnitude for a non-negative a, and sign-filling for a negative
// one.  Never overflows; a count >= 64 yields 0 for a non-negative a and -1 for
// a negative one.
func (a Num) Shr(b Num) (Num, bool) {
	if a.Magnitude == 0 {
		return Zero(), true
	}
	var n uint64 = b.Magnitude
	if !a.Sign {
		if n >= cast(uint64, 64) {
			return Zero(), true
		}
		var r Num
		var ok bool
		r, ok = makeNum(a.Magnitude >> n, false)
		return r, ok
	}
	if n >= cast(uint64, 64) {
		return makeNum(cast(uint64, 1), true)
	}
	if n == 0 {
		return a, true
	}
	var lo uint64
	lo, _ = twos(a)
	var fill uint64 = (cast(uint64, 0) - cast(uint64, 1)) << (cast(uint64, 64) - n)
	return fromTwos((lo >> n) | fill, true)
}
