package "pkg/binate/bignum"

import "pkg/builtins/testing"

// Tests for bignum_bitwise.bn: the bitwise operators and shifts on the
// infinitely sign-extended two's-complement value.

func TestAndOrXorSmall() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 0xF0))
	var b Num = FromUint64(cast(uint64, 0x3C))
	var r Num
	var ok bool
	r, ok = a.And(b)
	if !ok || r.Magnitude != cast(uint64, 0x30) || r.Sign {
		return fail("0xF0 & 0x3C != 0x30")
	}
	r, ok = a.Or(b)
	if !ok || r.Magnitude != cast(uint64, 0xFC) || r.Sign {
		return fail("0xF0 | 0x3C != 0xFC")
	}
	r, ok = a.Xor(b)
	if !ok || r.Magnitude != cast(uint64, 0xCC) || r.Sign {
		return fail("0xF0 ^ 0x3C != 0xCC")
	}
	return ""
}

// Bitwise of non-negative operands can set bit 63 (value >= 2^63) — the
// result stays non-negative and representable (it is the magnitude, not
// a wrapped host int).
func TestOrHighBit() testing.TestResult {
	var m Num = FromUint64(cast(uint64, 1) << 63)
	var one Num = FromUint64(cast(uint64, 1))
	var r Num
	var ok bool
	r, ok = m.Or(one)
	if !ok || r.Sign || r.Magnitude != ((cast(uint64, 1) << 63) | 1) {
		return fail("2^63 | 1 should be 2^63+1, non-negative")
	}
	return ""
}

func TestShlSmall() testing.TestResult {
	var a Num = FromInt(3)
	var n Num = FromInt(4)
	var r Num
	var ok bool
	r, ok = a.Shl(n)
	if !ok || r.Magnitude != cast(uint64, 48) || r.Sign {
		return fail("3 << 4 != 48")
	}
	return ""
}

// 2^62 << 1 == 2^63 fits the magnitude (it is >= 2^63 but <= 2^64-1).
func TestShlToHighBit() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 62)
	var one Num = FromInt(1)
	var r Num
	var ok bool
	r, ok = a.Shl(one)
	if !ok || r.Sign || r.Magnitude != (cast(uint64, 1) << 63) {
		return fail("2^62 << 1 should be 2^63")
	}
	return ""
}

// A left shift whose true value exceeds 2^64-1 overflows.
func TestShlOverflow() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 62)
	var three Num = FromInt(3)
	var ok bool
	_, ok = a.Shl(three) // 2^65
	if ok { return fail("2^62 << 3 == 2^65 should overflow") }
	return ""
}

// A shift count >= 64 overflows a non-zero value, but leaves zero as zero.
func TestShlCountAtLeast64() testing.TestResult {
	var a Num = FromInt(1)
	var n Num = FromInt(64)
	var ok bool
	_, ok = a.Shl(n)
	if ok { return fail("1 << 64 should overflow") }
	var z Num = Zero()
	var r Num
	r, ok = z.Shl(n)
	if !ok || !r.IsZero() { return fail("0 << 64 should be 0") }
	return ""
}

func TestShrSmall() testing.TestResult {
	var a Num = FromInt(48)
	var n Num = FromInt(4)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || r.Magnitude != cast(uint64, 3) || r.Sign {
		return fail("48 >> 4 != 3")
	}
	return ""
}

// A logical right shift of a magnitude with bit 63 set keeps it non-negative.
func TestShrHighBit() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 63) // 2^63
	var n Num = FromInt(60)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || r.Sign || r.Magnitude != cast(uint64, 8) {
		return fail("2^63 >> 60 should be 8 (logical)")
	}
	return ""
}

// A right shift never overflows; a count >= 64 yields zero.
func TestShrCountAtLeast64() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 63)
	var n Num = FromInt(100)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || !r.IsZero() { return fail("2^63 >> 100 should be 0") }
	return ""
}

// ---- Negative operands: infinitely sign-extended two's complement ----

// numIs reports whether n is the value v (as an int64) with ok set.
func numIs(n Num, ok bool, v int64) bool {
	return ok && n.Equals(FromInt64(v))
}

// ~x is -x - 1, for either sign.
func TestNotIsMinusXMinusOne() testing.TestResult {
	var r Num
	var ok bool
	r, ok = FromInt(1).Not()
	if !numIs(r, ok, cast(int64, -2)) { return fail("~1 must be -2") }
	r, ok = FromInt(-1).Not()
	if !numIs(r, ok, cast(int64, 0)) { return fail("~(-1) must be 0") }
	r, ok = FromInt(0).Not()
	if !numIs(r, ok, cast(int64, -1)) { return fail("~0 must be -1") }
	var big Num = FromUint64(cast(uint64, 1) << cast(uint64, 63))
	_, ok = big.Not()
	if ok { return fail("~2^63 is -2^63-1, outside the union range") }
	r, ok = FromInt64(cast(int64, 0) - cast(int64, 9223372036854775807) - cast(int64, 1)).Not()
	if !numIs(r, ok, cast(int64, 9223372036854775807)) { return fail("~(-2^63) must be 2^63-1") }
	return ""
}

// &, |, ^ with a negative operand combine the sign-extended representations.
func TestBitwiseNegativeOperands() testing.TestResult {
	var m2 Num = FromInt(-2)
	var r Num
	var ok bool
	r, ok = m2.Or(FromInt(1))
	if !numIs(r, ok, cast(int64, -1)) { return fail("(0 - 2) | 1 must be -1") }
	r, ok = m2.And(FromInt(255))
	if !numIs(r, ok, cast(int64, 254)) { return fail("(0 - 2) & 0xFF must be 254") }
	r, ok = m2.Xor(FromInt(3))
	if !numIs(r, ok, cast(int64, -3)) { return fail("(0 - 2) ^ 3 must be -3") }
	r, ok = FromInt(-16).And(FromInt(-4))
	if !numIs(r, ok, cast(int64, -16)) { return fail("-16 & -4 must be -16") }
	r, ok = FromInt(-16).Xor(FromInt(-4))
	if !numIs(r, ok, cast(int64, 12)) { return fail("-16 ^ -4 must be 12") }
	var max Num = FromUint64(cast(uint64, 0) - cast(uint64, 1))
	r, ok = max.And(m2)
	if !ok || !r.Equals(FromUint64(cast(uint64, 0) - cast(uint64, 2))) {
		return fail("0xFFFFFFFFFFFFFFFF & ~1 must be 2^64-2")
	}
	r, ok = max.Or(m2)
	if !numIs(r, ok, cast(int64, -1)) { return fail("0xFFFFFFFFFFFFFFFF | -2 must be -1") }
	_, ok = max.Xor(FromInt(-1))
	if ok { return fail("0xFFFFFFFFFFFFFFFF ^ -1 is -2^64, outside the union range") }
	return ""
}

// A negative value shifts exactly: left is x·2^k (range-checked), right is
// floor(x / 2^k), filling with the sign.
func TestShiftNegativeValues() testing.TestResult {
	var r Num
	var ok bool
	r, ok = FromInt(-1).Shl(FromInt(3))
	if !numIs(r, ok, cast(int64, -8)) { return fail("(0 - 1) << 3 must be -8") }
	r, ok = FromInt(-1).Shl(FromInt(63))
	if !numIs(r, ok, cast(int64, 0) - cast(int64, 9223372036854775807) - cast(int64, 1)) {
		return fail("(0 - 1) << 63 must be -2^63")
	}
	_, ok = FromInt(-2).Shl(FromInt(63))
	if ok { return fail("(0 - 2) << 63 is -2^64, outside the union range") }
	_, ok = FromInt(-1).Shl(FromInt(64))
	if ok { return fail("(0 - 1) << 64 is outside the union range") }
	r, ok = FromInt(-16).Shr(FromInt(2))
	if !numIs(r, ok, cast(int64, -4)) { return fail("(0 - 16) >> 2 must be -4") }
	r, ok = FromInt(-15).Shr(FromInt(2))
	if !numIs(r, ok, cast(int64, -4)) { return fail("(0 - 15) >> 2 must be floor(-3.75) = -4") }
	r, ok = FromInt(-16).Shr(FromInt(1000))
	if !numIs(r, ok, cast(int64, -1)) { return fail("(0 - 16) >> 1000 must be -1") }
	return ""
}

// A zero with its Sign set is still zero: ~0 is -1 and 0 | x is x, never the
// -2^64 that reading the sign bit alone would give.
func TestBitwiseSignedZero() testing.TestResult {
	var z Num
	z.Magnitude = cast(uint64, 0)
	z.Sign = true
	var r Num
	var ok bool
	r, ok = z.Not()
	if !ok || !r.Sign || r.Magnitude != cast(uint64, 1) {
		return fail("~(-0) should be -1")
	}
	r, ok = z.Or(FromUint64(cast(uint64, 5)))
	if !ok || r.Sign || r.Magnitude != cast(uint64, 5) {
		return fail("(-0) | 5 should be 5")
	}
	return ""
}
