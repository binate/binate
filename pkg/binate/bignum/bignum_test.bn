package "pkg/binate/bignum"

import "pkg/builtins/testing"

// Tests for pkg/binate/bignum.  Each test exercises one piece of the
// public surface so a regression in any of (parsing, arithmetic,
// fit-check, comparison, conversion) surfaces in isolation.

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// Parsing
// ============================================================

func TestParseDecimalSmall() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("42")
	if !ok { return fail("ParseLiteral(\"42\") returned overflow") }
	if n.Magnitude != cast(uint64, 42) {
		return fail("magnitude wrong")
	}
	if n.Sign { return fail("sign should be false") }
	return ""
}

func TestParseHexSmall() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("0xFF")
	if !ok { return fail("ParseLiteral(\"0xFF\") returned overflow") }
	if n.Magnitude != cast(uint64, 255) {
		return fail("magnitude wrong")
	}
	return ""
}

func TestParseOctalSmall() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("0o17")
	if !ok { return fail("ParseLiteral(\"0o17\") returned overflow") }
	if n.Magnitude != cast(uint64, 15) {
		return fail("magnitude wrong")
	}
	return ""
}

func TestParseBinarySmall() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("0b1010")
	if !ok { return fail("ParseLiteral(\"0b1010\") returned overflow") }
	if n.Magnitude != cast(uint64, 10) {
		return fail("magnitude wrong")
	}
	return ""
}

// Boundary: int64-max (= 2^63 - 1) as decimal.  Bootstrap should
// handle decimal up to int64-max with no trouble.
func TestParseInt64Max() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("9223372036854775807")
	if !ok { return fail("int64-max should parse") }
	var expected uint64 = (cast(uint64, 1) << 63) - 1
	if n.Magnitude != expected {
		return fail("int64-max magnitude wrong")
	}
	return ""
}

// Boundary: int64-max + 1 = 2^63 as decimal.  Still fits uint64.
func TestParseAboveInt64Max() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("9223372036854775808")
	if !ok { return fail("2^63 should parse (fits uint64)") }
	var expected uint64 = cast(uint64, 1) << 63
	if n.Magnitude != expected {
		return fail("2^63 magnitude wrong")
	}
	return ""
}

// uint64-max as hex.  All-ones bit pattern; the literal should
// parse successfully.
func TestParseUint64MaxHex() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("0xFFFFFFFFFFFFFFFF")
	if !ok { return fail("uint64-max hex should parse") }
	var maxU uint64 = (cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1)
	if n.Magnitude != maxU {
		return fail("uint64-max magnitude wrong")
	}
	return ""
}

// Just past uint64-max.  Should reject with ok=false.
func TestParseOverflowHex() testing.TestResult {
	var n Num
	var ok bool
	n, ok = ParseLiteral("0x10000000000000000")
	if ok { return fail("0x10000000000000000 should overflow") }
	if n.Magnitude != 0 { return fail("overflow result should be zero-magnitude") }
	return ""
}

// Decimal 18446744073709551616 = 2^64.  Overflow.
func TestParseOverflowDec() testing.TestResult {
	var ok bool
	_, ok = ParseLiteral("18446744073709551616")
	if ok { return fail("2^64 decimal should overflow") }
	return ""
}

// ============================================================
// Construction + zero canonicalization
// ============================================================

func TestZeroCanonical() testing.TestResult {
	var z Num = Zero()
	if !z.IsZero() { return fail("Zero() should be zero") }
	if z.Sign { return fail("Zero() sign should be false") }
	if z.IsNegative() { return fail("Zero() should not be negative") }
	return ""
}

func TestFromIntPositive() testing.TestResult {
	var n Num = FromInt(42)
	if n.Magnitude != cast(uint64, 42) || n.Sign {
		return fail("FromInt(42) wrong")
	}
	return ""
}

func TestFromIntNegative() testing.TestResult {
	var n Num = FromInt(-7)
	if n.Magnitude != cast(uint64, 7) || !n.Sign {
		return fail("FromInt(-7) wrong")
	}
	if !n.IsNegative() { return fail("should be negative") }
	return ""
}

// ============================================================
// Comparison
// ============================================================

func TestEqualsZero() testing.TestResult {
	var a Num = Zero()
	var b Num
	b.Magnitude = 0
	b.Sign = true // zero with non-canonical sign still equals zero
	if !a.Equals(b) { return fail("zero variants should equal") }
	return ""
}

func TestCmpSignedOrder() testing.TestResult {
	var neg5 Num = FromInt(-5)
	var zero Num = Zero()
	var pos5 Num = FromInt(5)
	if neg5.Cmp(zero) != -1 { return fail("-5 < 0") }
	if zero.Cmp(pos5) != -1 { return fail("0 < 5") }
	if neg5.Cmp(pos5) != -1 { return fail("-5 < 5") }
	if pos5.Cmp(neg5) != 1 { return fail("5 > -5") }
	if pos5.Cmp(pos5) != 0 { return fail("5 == 5") }
	return ""
}

// ============================================================
// Arithmetic — basic cases
// ============================================================

func TestAddSmall() testing.TestResult {
	var a Num = FromInt(3)
	var b Num = FromInt(4)
	var sum Num
	var ok bool
	sum, ok = a.Add(b)
	if !ok || sum.Magnitude != cast(uint64, 7) || sum.Sign {
		return fail("3+4 != 7")
	}
	return ""
}

// 1000 - 1000 — exercises the "different sign cancellation" path
// via Add(a, -b).  This is the user's canonical const-expr example.
func TestSubCancellation() testing.TestResult {
	var a Num = FromInt(1000)
	var b Num = FromInt(1000)
	var diff Num
	var ok bool
	diff, ok = a.Sub(b)
	if !ok { return fail("1000 - 1000 should be representable") }
	if !diff.IsZero() { return fail("1000 - 1000 != 0") }
	return ""
}

func TestSubGoesNegative() testing.TestResult {
	var a Num = FromInt(3)
	var b Num = FromInt(10)
	var diff Num
	var ok bool
	diff, ok = a.Sub(b)
	if !ok { return fail("3 - 10 should be representable") }
	if diff.Magnitude != cast(uint64, 7) || !diff.Sign {
		return fail("3 - 10 != -7")
	}
	return ""
}

func TestMulSmall() testing.TestResult {
	var a Num = FromInt(6)
	var b Num = FromInt(7)
	var prod Num
	var ok bool
	prod, ok = a.Mul(b)
	if !ok || prod.Magnitude != cast(uint64, 42) || prod.Sign {
		return fail("6*7 != 42")
	}
	return ""
}

func TestMulNegativeNegative() testing.TestResult {
	var a Num = FromInt(-3)
	var b Num = FromInt(-4)
	var prod Num
	var ok bool
	prod, ok = a.Mul(b)
	if !ok || prod.Magnitude != cast(uint64, 12) || prod.Sign {
		return fail("(-3)*(-4) != 12")
	}
	return ""
}

func TestDivSmall() testing.TestResult {
	var a Num = FromInt(20)
	var b Num = FromInt(3)
	var q Num
	var ok bool
	q, ok = a.Div(b)
	if !ok || q.Magnitude != cast(uint64, 6) || q.Sign {
		return fail("20 / 3 != 6")
	}
	return ""
}

func TestDivNegativeDivisor() testing.TestResult {
	// 20 / -3 = -6 (truncated toward zero).
	var a Num = FromInt(20)
	var b Num = FromInt(-3)
	var q Num
	var ok bool
	q, ok = a.Div(b)
	if !ok || q.Magnitude != cast(uint64, 6) || !q.Sign {
		return fail("20 / -3 != -6")
	}
	return ""
}

func TestDivNegativeDividend() testing.TestResult {
	// -20 / 3 = -6.
	var a Num = FromInt(-20)
	var b Num = FromInt(3)
	var q Num
	var ok bool
	q, ok = a.Div(b)
	if !ok || q.Magnitude != cast(uint64, 6) || !q.Sign {
		return fail("-20 / 3 != -6")
	}
	return ""
}

func TestDivByZero() testing.TestResult {
	var a Num = FromInt(42)
	var b Num = FromInt(0)
	var ok bool
	_, ok = a.Div(b)
	if ok { return fail("div by zero must return ok=false") }
	return ""
}

func TestModSmall() testing.TestResult {
	var a Num = FromInt(20)
	var b Num = FromInt(3)
	var m Num
	var ok bool
	m, ok = a.Mod(b)
	if !ok || m.Magnitude != cast(uint64, 2) || m.Sign {
		return fail("20 % 3 != 2")
	}
	return ""
}

// Go semantics: remainder has the sign of the dividend.
func TestModNegativeDividend() testing.TestResult {
	var a Num = FromInt(-20)
	var b Num = FromInt(3)
	var m Num
	var ok bool
	m, ok = a.Mod(b)
	if !ok || m.Magnitude != cast(uint64, 2) || !m.Sign {
		return fail("-20 % 3 != -2")
	}
	return ""
}

func TestModByZero() testing.TestResult {
	var a Num = FromInt(42)
	var b Num = FromInt(0)
	var ok bool
	_, ok = a.Mod(b)
	if ok { return fail("mod by zero must return ok=false") }
	return ""
}

// ============================================================
// Arithmetic — overflow rejection
// ============================================================

// Adding 1 to uint64-max overflows.  This is the example from the
// spec: 0xFFFFFFFFFFFFFFFF + 1 is rejected (no silent wrap).
func TestAddUint64MaxPlus1() testing.TestResult {
	var maxU Num = FromUint64((cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1))
	var one Num = FromInt(1)
	var ok bool
	_, ok = maxU.Add(one)
	if ok { return fail("uint64-max + 1 should overflow") }
	return ""
}

// Negative side: -2^63 - 1 overflows (below int64-min).
func TestNegOverflow() testing.TestResult {
	// Construct -2^63 by negating 2^63.
	var twoTo63 Num = FromUint64(cast(uint64, 1) << 63)
	var minInt64 Num
	var ok bool
	minInt64, ok = twoTo63.Neg()
	if !ok { return fail("-(2^63) should be representable") }
	// Now subtract 1.
	var one Num = FromInt(1)
	_, ok = minInt64.Sub(one)
	if ok { return fail("int64-min - 1 should overflow") }
	return ""
}

// Multiplying uint64-max by 2 overflows.
func TestMulOverflow() testing.TestResult {
	var maxU Num = FromUint64((cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1))
	var two Num = FromInt(2)
	var ok bool
	_, ok = maxU.Mul(two)
	if ok { return fail("uint64-max * 2 should overflow") }
	return ""
}

// Negating a uint64 magnitude above 2^63 overflows (the negation
// would land below int64-min).
func TestNegBeyondInt64Min() testing.TestResult {
	// 2^63 + 1
	var v Num = FromUint64((cast(uint64, 1) << 63) + 1)
	var ok bool
	_, ok = v.Neg()
	if ok { return fail("negating uint64 > 2^63 should overflow") }
	return ""
}

// ============================================================
// Bitwise
// ============================================================

func TestAndOrXorSmall() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 0xF0))
	var b Num = FromUint64(cast(uint64, 0x3C))
	var r Num
	var ok bool
	r, ok = a.And(b)
	if !ok || r.Magnitude != cast(uint64, 0x30) || r.Sign {
		return fail("0xF0 & 0x3C != 0x30")
	}
	r, ok = a.Or(b)
	if !ok || r.Magnitude != cast(uint64, 0xFC) || r.Sign {
		return fail("0xF0 | 0x3C != 0xFC")
	}
	r, ok = a.Xor(b)
	if !ok || r.Magnitude != cast(uint64, 0xCC) || r.Sign {
		return fail("0xF0 ^ 0x3C != 0xCC")
	}
	return ""
}

// Bitwise of non-negative operands can set bit 63 (value >= 2^63) — the
// result stays non-negative and representable (it is the magnitude, not
// a wrapped host int).
func TestOrHighBit() testing.TestResult {
	var m Num = FromUint64(cast(uint64, 1) << 63)
	var one Num = FromUint64(cast(uint64, 1))
	var r Num
	var ok bool
	r, ok = m.Or(one)
	if !ok || r.Sign || r.Magnitude != ((cast(uint64, 1) << 63) | 1) {
		return fail("2^63 | 1 should be 2^63+1, non-negative")
	}
	return ""
}

func TestShlSmall() testing.TestResult {
	var a Num = FromInt(3)
	var n Num = FromInt(4)
	var r Num
	var ok bool
	r, ok = a.Shl(n)
	if !ok || r.Magnitude != cast(uint64, 48) || r.Sign {
		return fail("3 << 4 != 48")
	}
	return ""
}

// 2^62 << 1 == 2^63 fits the magnitude (it is >= 2^63 but <= 2^64-1).
func TestShlToHighBit() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 62)
	var one Num = FromInt(1)
	var r Num
	var ok bool
	r, ok = a.Shl(one)
	if !ok || r.Sign || r.Magnitude != (cast(uint64, 1) << 63) {
		return fail("2^62 << 1 should be 2^63")
	}
	return ""
}

// A left shift whose true value exceeds 2^64-1 overflows.
func TestShlOverflow() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 62)
	var three Num = FromInt(3)
	var ok bool
	_, ok = a.Shl(three) // 2^65
	if ok { return fail("2^62 << 3 == 2^65 should overflow") }
	return ""
}

// A shift count >= 64 overflows a non-zero value, but leaves zero as zero.
func TestShlCountAtLeast64() testing.TestResult {
	var a Num = FromInt(1)
	var n Num = FromInt(64)
	var ok bool
	_, ok = a.Shl(n)
	if ok { return fail("1 << 64 should overflow") }
	var z Num = Zero()
	var r Num
	r, ok = z.Shl(n)
	if !ok || !r.IsZero() { return fail("0 << 64 should be 0") }
	return ""
}

func TestShrSmall() testing.TestResult {
	var a Num = FromInt(48)
	var n Num = FromInt(4)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || r.Magnitude != cast(uint64, 3) || r.Sign {
		return fail("48 >> 4 != 3")
	}
	return ""
}

// A logical right shift of a magnitude with bit 63 set keeps it non-negative.
func TestShrHighBit() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 63) // 2^63
	var n Num = FromInt(60)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || r.Sign || r.Magnitude != cast(uint64, 8) {
		return fail("2^63 >> 60 should be 8 (logical)")
	}
	return ""
}

// A right shift never overflows; a count >= 64 yields zero.
func TestShrCountAtLeast64() testing.TestResult {
	var a Num = FromUint64(cast(uint64, 1) << 63)
	var n Num = FromInt(100)
	var r Num
	var ok bool
	r, ok = a.Shr(n)
	if !ok || !r.IsZero() { return fail("2^63 >> 100 should be 0") }
	return ""
}

// ============================================================
// Fit checks
// ============================================================

func TestFitsSignedSmall() testing.TestResult {
	var n Num = FromInt(100)
	if !n.FitsSigned(8) { return fail("100 fits int8") }
	if !n.FitsSigned(16) { return fail("100 fits int16") }
	if !n.FitsSigned(32) { return fail("100 fits int32") }
	if !n.FitsSigned(64) { return fail("100 fits int64") }
	return ""
}

func TestFitsSignedRejectOverflow() testing.TestResult {
	var n Num = FromInt(256)
	if n.FitsSigned(8) { return fail("256 should not fit int8") }
	if !n.FitsSigned(16) { return fail("256 fits int16") }
	return ""
}

func TestFitsSignedNegativeBoundary() testing.TestResult {
	var n Num = FromInt(-128)
	if !n.FitsSigned(8) { return fail("-128 fits int8 (min)") }
	var nLess Num = FromInt(-129)
	if nLess.FitsSigned(8) { return fail("-129 should not fit int8") }
	return ""
}

func TestFitsUnsignedRejectsNegative() testing.TestResult {
	var n Num = FromInt(-1)
	if n.FitsUnsigned(8) { return fail("-1 should not fit uint8") }
	if n.FitsUnsigned(64) { return fail("-1 should not fit uint64") }
	return ""
}

func TestFitsUnsignedMax() testing.TestResult {
	var maxU64 Num = FromUint64((cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1))
	if !maxU64.FitsUnsigned(64) { return fail("uint64-max fits uint64") }
	if maxU64.FitsUnsigned(32) { return fail("uint64-max should not fit uint32") }
	if maxU64.FitsSigned(64) { return fail("uint64-max should not fit int64") }
	return ""
}

// uint8 boundary at 256.  This is the canonical "uint8 = 256
// overflows" case that today's checker doesn't catch.
func TestFitsUnsignedUint8Boundary() testing.TestResult {
	var n255 Num = FromInt(255)
	if !n255.FitsUnsigned(8) { return fail("255 fits uint8") }
	var n256 Num = FromInt(256)
	if n256.FitsUnsigned(8) { return fail("256 should not fit uint8") }
	return ""
}

// ============================================================
// Conversion
// ============================================================

func TestToIntPositive() testing.TestResult {
	var n Num = FromInt(42)
	if n.ToInt() != 42 { return fail("ToInt() wrong for 42") }
	return ""
}

func TestToIntNegative() testing.TestResult {
	var n Num = FromInt(-100)
	if n.ToInt() != -100 { return fail("ToInt() wrong for -100") }
	return ""
}

func TestToUint64() testing.TestResult {
	var n Num = FromUint64(cast(uint64, 999))
	if n.ToUint64() != cast(uint64, 999) {
		return fail("ToUint64() wrong")
	}
	return ""
}
