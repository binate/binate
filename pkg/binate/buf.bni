// Package buf provides the CopyStr / Concat raw-slice copy utilities and GrowCap, a byte
// buffer's growth.
package "pkg/binate/buf"

// CopyStr copies a raw slice into a new managed slice.
func CopyStr(s *[]readonly char) @[]char

// Concat returns a fresh managed-slice containing a followed by b.
func Concat(a *[]readonly char, b *[]readonly char) @[]char

// GrowCap returns the capacity to grow a buffer of capacity have to so it holds need bytes:
// have (1 when it is 0) doubled until it does, capped at the host's largest int.
func GrowCap(have int, need int) int
