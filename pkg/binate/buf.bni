// Package buf provides growable byte buffers for building strings: CharBuf (a
// value type — each Write returns the updated buffer) and Builder (a managed
// reference mutated in place, an in-cone copy of pkg/std/strings.Builder; see
// builder.bn).  Both grow geometrically backed by @[]char.  Also the
// CopyStr / Concat slice-copy utilities.
package "pkg/binate/buf"

// CharBuf is a growable character buffer. Data holds the backing managed slice;
// Len tracks how many bytes have been written (may be less than len(Data)).
type CharBuf struct {
	Data @[]char
	Len  int
}

// New creates a CharBuf with initial capacity.
func New() CharBuf

// CopyStr copies a raw slice into a new managed slice.
func CopyStr(s *[]readonly char) @[]char

// ============================================================
// Methods on CharBuf
// ============================================================

// WriteByte appends a single character. Returns the (possibly grown)
// CharBuf — chain calls or assign back: `b = b.WriteByte('x')`.
func (b CharBuf) WriteByte(c char) CharBuf

// WriteStr appends a raw character slice.
func (b CharBuf) WriteStr(s *[]readonly char) CharBuf

// WriteInt appends the decimal string representation of n.
func (b CharBuf) WriteInt(n int) CharBuf

// WriteInt64 appends the decimal string representation of a
// fixed-width int64 n (full 64-bit range even on a 32-bit host).
func (b CharBuf) WriteInt64(n int64) CharBuf

// WriteHexByte appends v as two uppercase hex digits (e.g., 0xFF → "FF").
func (b CharBuf) WriteHexByte(v int) CharBuf

// Bytes returns the written portion as a managed subslice of the backing.
func (b CharBuf) Bytes() @[]char

// Len returns the number of bytes written.
func (b CharBuf) Len() int

// Freeze copies the written bytes into a new, exactly-sized managed slice.
func (b CharBuf) Freeze() @[]char

// ============================================================
// Free-function aliases (to be removed as callers migrate to methods)
// ============================================================
func Concat(a *[]readonly char, b *[]readonly char) @[]char

// ============================================================
// Builder — in-cone, BUILDER-compilable copy of pkg/std/strings.Builder.
// See builder.bn for why it duplicates the stdlib Builder and how the
// eventual `buf.Builder` → `strings.Builder` swap works.
// ============================================================

// Builder accumulates bytes into a backing it owns and grows exponentially.
// Its methods take a *Builder and mutate in place.  Obtain one from
// NewBuilder; read the accumulated bytes with String.
type Builder struct {
	buf @[]char
	n   int
}

// NewBuilder returns a new, empty Builder ready to accumulate bytes.
func NewBuilder() @Builder

// Write appends p's bytes to the Builder.  Unlike the stdlib Builder's
// io.Writer Write it returns void (the cone has no interface values).
func (b *Builder) Write(p *[]readonly char)

// WriteByte appends a single byte.
func (b *Builder) WriteByte(c char)

// Grow ensures at least n more bytes fit before the next reallocation; an n
// that already fits, or is negative, is a no-op.
func (b *Builder) Grow(n int)

// Len returns the number of bytes accumulated so far.
func (b *Builder) Len() int

// Cap returns the capacity of the backing — always >= Len.
func (b *Builder) Cap() int

// Reset discards the accumulated bytes and releases the backing.
func (b *Builder) Reset()

// String returns the accumulated bytes as an immutable string sharing the
// Builder's backing — no copy.
func (b *Builder) String() @[]readonly char

// WriteInt / WriteInt64 / WriteHexByte are the in-cone counterparts of the
// pkg/binate/stringutils free functions: integer and hex formatting the
// Builder itself omits.

// WriteInt appends the base-10 representation of n to b.
func WriteInt(b *Builder, n int)

// WriteInt64 appends the base-10 representation of a fixed-width int64 n.
func WriteInt64(b *Builder, n int64)

// WriteHexByte appends v's low 8 bits as two uppercase hex digits.
func WriteHexByte(b *Builder, v int)
