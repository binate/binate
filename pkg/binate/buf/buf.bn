package "pkg/binate/buf"

// CopyStr copies a raw slice into a new managed slice. The returned slice
// is independent of the input — safe to store in data structures.
func CopyStr(s *[]readonly char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}

// Concat returns a fresh managed-slice containing a followed by b.
// One-shot allocate-and-copy; useful when building short strings
// from two known fragments (paths, log messages) without spinning
// up a full Builder.  For long chains, a Builder + Write loop is
// cheaper.
func Concat(a *[]readonly char, b *[]readonly char) @[]char {
	var lenA int = len(a)
	var lenB int = len(b)
	var s @[]char = make_slice(char, lenA + lenB)
	for i := 0; i < lenA; i++ { s[i] = a[i] }
	for i := 0; i < lenB; i++ { s[lenA + i] = b[i] }
	return s
}

// GrowCap returns a buffer's new capacity; see buf.bni.  The cap keeps the doubling from
// wrapping past the host's int, after which it would never reach need.
func GrowCap(have int, need int) int {
	var limit int = cast(int, ~cast(uint, 0) >> 1)
	var n int = have
	if n < 1 { n = 1 }
	for n < need {
		if n > limit / 2 { return limit }
		n = n * 2
	}
	return n
}
