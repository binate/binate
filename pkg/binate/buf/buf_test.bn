package "pkg/binate/buf"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

func charsEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func TestCopyStr() testing.TestResult {
	var s @[]char = CopyStr("copy")
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]readonly char = s
	if len(raw) != 4 { return fail("expected len 4") }
	if !charsEq(raw, "copy") { return fail("expected copy") }
	return ""
}

// Concat returns a fresh managed-slice with both inputs concatenated.
func TestConcat() testing.TestResult {
	var got @[]char = Concat("foo", "bar")
	if len(got) != 6 { return fail("expected len 6") }
	if !charsEq(got, "foobar") { return fail("expected foobar") }
	return ""
}

// Concat with an empty left arg returns just the right arg's bytes.
func TestConcatEmptyLeft() testing.TestResult {
	var got @[]char = Concat("", "right")
	if !charsEq(got, "right") { return fail("expected right") }
	return ""
}

// Concat with an empty right arg returns just the left arg's bytes
// (same as CopyStr — the degenerate case bootstrap-era callers
// often used).
func TestConcatEmptyRight() testing.TestResult {
	var got @[]char = Concat("left", "")
	if !charsEq(got, "left") { return fail("expected left") }
	return ""
}

// Both empty inputs → an empty result.
func TestConcatBothEmpty() testing.TestResult {
	var got @[]char = Concat("", "")
	if len(got) != 0 { return fail("expected empty") }
	return ""
}

// Concat allocates fresh storage — the result's bytes survive
// after the inputs go out of scope (here, all inputs are string
// literals so they're permanent, but the test pins that the
// returned slice is its own owned allocation).
func TestConcatAllocatesFresh() testing.TestResult {
	var a @[]char = Concat("a", "b")
	var b @[]char = Concat("a", "b")
	if !charsEq(a, "ab") || !charsEq(b, "ab") {
		return fail("both should be 'ab'")
	}
	return ""
}
