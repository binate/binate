package "pkg/binate/buf"

import "pkg/std/strconv"

// Builder is an in-cone, BUILDER-compilable copy of pkg/std/strings.Builder —
// same struct layout and method set, an accumulating exponentially-grown byte
// buffer.  It exists so cmd/bnc's build cone, which cannot yet import
// pkg/std/strings (the current BUILDER can't carry that package's interface
// machinery), has a string builder.  Once a BUILDER release ships the
// stdlib Builder, swapping `buf.Builder` → `strings.Builder` (and
// `buf.WriteInt` → `stringutils.WriteInt`) is a mechanical import-and-rename.
//
// Two differences are forced by the cone constraint: Write / WriteByte return
// void (the stdlib Builder returns an `@errors.Error` for io.Writer, but the
// cone has no interface values), and there is no io.Writer / io.ByteWriter
// impl.  Every call site discards those returns, so the swap stays clean.

// NewBuilder returns a new, empty Builder.  The zero Builder (nil backing,
// n == 0) is already usable — the first append allocates.
func NewBuilder() @Builder {
	return make(Builder)
}

// ensureCap makes room for `needed` more bytes, growing the backing at
// 2*cap + needed (exponential, so repeated appends stay amortized O(1)) when
// it must allocate.  A no-op when the space is already there.
func ensureCap(b *Builder, needed int) {
	var cap int = len(b.buf)
	if b.n + needed <= cap {
		return
	}
	var newCap int = 2 * cap + needed
	var nb @[]char = make_slice(char, newCap)
	for i := 0; i < b.n; i++ {
		nb[i] = b.buf[i]
	}
	b.buf = nb
}

// Write appends p's bytes.  It never fails; the stdlib Builder returns an
// `(int, @errors.Error)` here, but the cone copy returns void (call sites
// discard the result regardless).
func (b *Builder) Write(p *[]readonly char) {
	var m int = len(p)
	ensureCap(b, m)
	for i := 0; i < m; i++ {
		b.buf[b.n + i] = p[i]
	}
	b.n = b.n + m
}

// WriteByte appends one byte.
func (b *Builder) WriteByte(c char) {
	ensureCap(b, 1)
	b.buf[b.n] = c
	b.n = b.n + 1
}

// Grow ensures n more bytes fit without a reallocation, growing exponentially
// when it must allocate.  A negative (or already-fitting) n is a no-op.
func (b *Builder) Grow(n int) {
	if n <= 0 {
		return
	}
	ensureCap(b, n)
}

// Len returns the number of bytes accumulated so far.
func (b *Builder) Len() int {
	return b.n
}

// Cap returns the capacity of the backing (>= Len).
func (b *Builder) Cap() int {
	return len(b.buf)
}

// Reset returns the Builder to empty and releases its backing.
func (b *Builder) Reset() {
	var empty @[]char
	b.buf = empty
	b.n = 0
}

// String returns the accumulated bytes as an immutable, backing-sharing
// string.  Empty when nothing has been written.
func (b *Builder) String() @[]readonly char {
	if b.n == 0 {
		var empty @[]readonly char
		return empty
	}
	return b.buf[0:b.n]
}

// WriteInt appends the base-10 representation of n to b — the in-cone
// counterpart of stringutils.WriteInt.
func WriteInt(b *Builder, n int) {
	var tmp [20]char
	var end int = strconv.AppendInt(tmp[0:20], 0, cast(int64, n), 10)
	b.Write(tmp[0:end])
}

// WriteInt64 appends the base-10 representation of a fixed-width int64 n —
// the full 64-bit range even on a 32-bit host.
func WriteInt64(b *Builder, n int64) {
	var tmp [20]char
	var end int = strconv.AppendInt(tmp[0:20], 0, n, 10)
	b.Write(tmp[0:end])
}

// WriteHexByte appends v's low 8 bits as two uppercase hex digits (e.g.
// 0xFF → "FF").
func WriteHexByte(b *Builder, v int) {
	var tmp [2]char
	tmp[0] = hexDigit((v >> 4) & 0xF)
	tmp[1] = hexDigit(v & 0xF)
	b.Write(tmp[0:2])
}

// hexDigit returns the uppercase hex digit ('0'..'9', 'A'..'F') for d in
// 0..15.
func hexDigit(d int) char {
	if d < 10 {
		return cast(char, cast(int, '0') + d)
	}
	return cast(char, cast(int, 'A') + d - 10)
}
