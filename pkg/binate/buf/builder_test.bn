package "pkg/binate/buf"

import "pkg/builtins/testing"

// Tests for Builder + WriteInt/WriteInt64/WriteHexByte (builder.bn).
// `fail` and `charsEq` are shared from buf_test.bn (same package).

func TestBuilderWriteAndString() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("ab")
	b.WriteByte('c')
	b.Write("de")
	if b.Len() != 5 { return fail("expected len 5") }
	if !charsEq(b.String(), "abcde") { return fail("expected abcde") }
	return ""
}

func TestBuilderEmpty() testing.TestResult {
	var b @Builder = NewBuilder()
	if b.Len() != 0 { return fail("fresh Builder should be empty") }
	if b.Cap() != 0 { return fail("fresh Builder should have zero cap") }
	if !charsEq(b.String(), "") { return fail("fresh String should be empty") }
	return ""
}

// All 256 byte values round-trip (Builder stores raw bytes, not text).
func TestBuilderByteFidelity() testing.TestResult {
	var b @Builder = NewBuilder()
	for i := 0; i < 256; i++ {
		b.WriteByte(cast(char, i))
	}
	if b.Len() != 256 { return fail("expected len 256") }
	var s @[]readonly char = b.String()
	for i := 0; i < 256; i++ {
		if cast(int, s[i]) != i { return fail("byte fidelity broken") }
	}
	return ""
}

// Force several reallocations; content stays intact.
func TestBuilderGrowsAndSurvives() testing.TestResult {
	var b @Builder = NewBuilder()
	for i := 0; i < 100; i++ {
		b.Write("xyz")
	}
	if b.Len() != 300 { return fail("expected len 300") }
	if b.Cap() < 300 { return fail("cap should have grown") }
	var s @[]readonly char = b.String()
	for i := 0; i < 300; i++ {
		var want char = 'x'
		if i % 3 == 1 { want = 'y' }
		if i % 3 == 2 { want = 'z' }
		if s[i] != want { return fail("content corrupted across growth") }
	}
	return ""
}

func TestBuilderGrowHint() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Grow(64)
	if b.Cap() < 64 { return fail("Grow(64) should reserve >= 64") }
	if b.Len() != 0 { return fail("Grow should not change Len") }
	b.Grow(-5)  // negative is a no-op
	b.Write("hi")
	if !charsEq(b.String(), "hi") { return fail("expected hi") }
	return ""
}

// Reset empties the Builder for reuse; a previously-returned String keeps its
// own reference to the old backing.
func TestBuilderReset() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("first")
	var saved @[]readonly char = b.String()
	b.Reset()
	if b.Len() != 0 { return fail("Reset should empty the Builder") }
	b.Write("second")
	if !charsEq(b.String(), "second") { return fail("expected second after reuse") }
	if !charsEq(saved, "first") { return fail("saved String should survive Reset") }
	return ""
}

func TestBuilderWriteInt() testing.TestResult {
	var b @Builder = NewBuilder()
	WriteInt(b, 0)
	WriteInt(b, 42)
	WriteInt(b, -7)
	if !charsEq(b.String(), "042-7") { return fail("expected 042-7") }
	return ""
}

func TestBuilderWriteInt64() testing.TestResult {
	var b @Builder = NewBuilder()
	WriteInt64(b, cast(int64, -9223372036854775807) - cast(int64, 1))
	if !charsEq(b.String(), "-9223372036854775808") {
		return fail("expected int64-min")
	}
	b = NewBuilder()
	WriteInt64(b, cast(int64, 9223372036854775807))
	if !charsEq(b.String(), "9223372036854775807") {
		return fail("expected int64-max")
	}
	return ""
}

func TestBuilderWriteHexByte() testing.TestResult {
	var b @Builder = NewBuilder()
	WriteHexByte(b, 0)
	WriteHexByte(b, 255)
	WriteHexByte(b, 171)
	if !charsEq(b.String(), "00FFAB") { return fail("expected 00FFAB") }
	// Low-8-bits contract: 256 masks to 00, -1's low byte is FF.
	b = NewBuilder()
	WriteHexByte(b, 256)
	WriteHexByte(b, -1)
	if !charsEq(b.String(), "00FF") { return fail("expected 00FF") }
	return ""
}

// Builder interleaves Write with the formatting free-functions
// (WriteHexByte / WriteInt) in a single chain.
func TestBuilderMixedFormatting() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("hex=")
	WriteHexByte(b, 255)
	b.Write(" int=")
	WriteInt(b, -42)
	if !charsEq(b.String(), "hex=FF int=-42") {
		return fail("expected 'hex=FF int=-42'")
	}
	return ""
}
