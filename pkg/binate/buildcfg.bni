// Package buildcfg evaluates `#[build(...)]` build constraints against the
// active build configuration, deciding whether an annotated file or
// declaration is compiled for the current target.  It is the shared engine
// behind the loader's whole-file and per-declaration gates (and, later, a
// config-aware bnlint).  The minimal predicate vocabulary is `arch` and
// `os`; more predicates are added over time.  See
// explorations/plan-build-constraints.md.
package "pkg/binate/buildcfg"

import "pkg/binate/ast"

// BuildConfig describes the active build configuration that build
// constraints (`#[build(...)]`) are evaluated against.  The minimal
// vocabulary carries only the target architecture and operating system;
// further predicates (triple, backend, libc, pointer width, version, ...)
// are added later.  See explorations/plan-build-constraints.md.
// The fields are borrowed raw slices: callers set them to static
// strings (string literals / compile-time-constant target names), which
// outlive the config, so no ownership is needed.
type BuildConfig struct {
	// Arch is the target architecture: "x64", "aarch64", or "arm32"
	// (the canonical names the assembler's `.arch` directive uses; see
	// pkg/binate/asm/parse).
	Arch *[]readonly char
	// OS is the target operating system: "linux", "darwin", or
	// "baremetal".
	OS *[]readonly char
	// Version is the COMPILING compiler's own version string (`version.Version`,
	// e.g. "0.0.11pre3") — target-independent — against which the ordered
	// `at_least(version, "X.Y.Z")` / `at_most(...)` and exact `is(version, ...)`
	// predicates compare.  The `pre[N]` suffix is stripped for comparison
	// (X.Y.Zpre[N] == X.Y.Z).  Set from pkg/binate/version by mkConfig; a test
	// may set it directly to a synthetic version.
	Version *[]readonly char
}

// DeclIncluded reports whether a declaration (or file) carrying the given
// annotations is compiled for cfg.  It ANDs every `build` annotation's
// condition; dotted/namespaced annotation names (e.g. `tool.lint`) are
// ignored (those belong to other tools); a `c_export("name")` annotation is
// recognized and always-included (it adds a C symbol, it is not a drop
// predicate) with only its argument FORM validated here; an unknown
// unqualified name, or a malformed / unknown-predicate condition, is a hard
// error.  Returns (included, errMsg, hasErr); when hasErr is true the build
// MUST abort — a silent skip would drop the declaration's symbols and surface
// later as a confusing "undefined" error far from the cause.
func DeclIncluded(cfg @BuildConfig, annotations @[]@ast.Annotation) (bool, @[]char, bool)

// HasCExport reports whether any of the given annotations is a `c_export`.
// The loader uses this to reject `#[c_export]` on a non-function declaration
// (or an import): DeclIncluded validates the annotation's argument form but is
// not given the decl kind, so the "attaches to a top-level func" rule is
// enforced at the loader's gate.  See explorations/plan-ffi-export-detailed.md.
func HasCExport(annotations @[]@ast.Annotation) bool

// HostConfig returns the BuildConfig for the host this tool was *built* for,
// from the `pkg/builtins/build` constants compiled into the tool (buildcfg
// imports build).  So a bare bnc/bni reflects its own build host without
// reading any build.bni at runtime — "the building tool provides the values".
func HostConfig() @BuildConfig

// ConfigForTarget returns the BuildConfig for a --target key: ConfigForTargetKey
// for an explicit key, else HostConfig() for the empty / "host" key.  This is
// the single entry point tools use to set the loader's gating config.
func ConfigForTarget(key *[]readonly char) @BuildConfig

// ConfigForTargetKey maps an explicit `bnc --target` key to its BuildConfig
// (canonical arch/os tags), for tools that need to gate by target without
// reading `pkg/builtins/build` — notably a `--target`-aware bnlint, and
// (later) bnc/bni once `build.bni` itself is build-gated.  Returns
// (cfg, true) for a recognized concrete key; (nil, false) for an unknown key
// AND for the host keys (""/"host"), which name no fixed triple — the host
// config is resolved separately (via ResolveBuildConfig or host detection).
// The recognized key set mirrors cmd/bnc's applyTarget: x86_64-linux,
// x86_64-darwin, aarch64-linux, arm32-linux, arm32-baremetal.
func ConfigForTargetKey(key *[]readonly char) (@BuildConfig, bool)

// EvalBuildExpr evaluates one build-constraint expression against cfg,
// returning (result, errMsg, hasErr).  A clause is a predicate call
// `<pred>(key, "tag")`:
//   - `is(key, "tag")` — exact membership: `is(arch, …)` (tags x64/aarch64/arm32
//     + the assembler aliases x86_64/arm64/arm), `is(os, …)`
//     (linux/darwin/baremetal), `is(version, "X.Y.Z")` (exact version equality,
//     pre-stripped).
//   - `at_least(version, "X.Y.Z")` / `at_most(version, "X.Y.Z")` — ordered
//     version comparison against the compiling compiler's version (cfg.Version),
//     with the `pre[N]` suffix stripped (X.Y.Zpre[N] == X.Y.Z).  Ordered
//     predicates apply only to the `version` key.
// Clauses combine with `&&`, `||`, and `!` (so `<` / `>` / `!=` come from
// negating the above).  Anything else — an unknown predicate/key/tag, a
// non-predicate call, a bare identifier, a malformed version, or a comparison
// operator — is a hard error.
func EvalBuildExpr(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool)
