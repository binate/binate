// Package buildcfg evaluates `#[build(...)]` build constraints against the
// active build configuration, deciding whether an annotated file or
// declaration is compiled for the current target.  It is the shared engine
// behind the loader's whole-file and per-declaration gates (and, later, a
// config-aware bnlint).  The minimal predicate vocabulary is `arch` and
// `os`; more predicates are added over time.  See
// explorations/plan-build-constraints.md.
package "pkg/binate/buildcfg"

import "pkg/binate/ast"

// BuildConfig describes the active build configuration that build
// constraints (`#[build(...)]`) are evaluated against.  The minimal
// vocabulary carries only the target architecture and operating system;
// further predicates (triple, backend, libc, pointer width, version, ...)
// are added later.  See explorations/plan-build-constraints.md.
// The fields are borrowed raw slices: callers set them to static
// strings (string literals / compile-time-constant target names), which
// outlive the config, so no ownership is needed.
type BuildConfig struct {
	// Arch is the target architecture: "x64", "aarch64", or "arm32"
	// (the canonical names the assembler's `.arch` directive uses; see
	// pkg/binate/asm/parse).
	Arch *[]readonly char
	// OS is the target operating system: "linux", "darwin", or
	// "baremetal".
	OS *[]readonly char
}

// DeclIncluded reports whether a declaration (or file) carrying the given
// annotations is compiled for cfg.  It ANDs every `build` annotation's
// condition; dotted/namespaced annotation names (e.g. `tool.lint`) are
// ignored (those belong to other tools); an unknown unqualified name, or a
// malformed / unknown-predicate condition, is a hard error.  Returns
// (included, errMsg, hasErr); when hasErr is true the build MUST abort — a
// silent skip would drop the declaration's symbols and surface later as a
// confusing "undefined" error far from the cause.
func DeclIncluded(cfg @BuildConfig, annotations @[]@ast.Annotation) (bool, @[]char, bool)

// ConfigFromBuild builds a BuildConfig from a parsed `pkg/builtins/build`
// interface file, reading its `Arch` and `OS` constant initializers
// (`ARCH_X64`/`ARCH_AARCH64`/`ARCH_ARM32`, `OS_LINUX`/`OS_DARWIN`/
// `OS_BAREMETAL`) and mapping them to canonical tags.  Returns nil when
// either constant is absent or unrecognized — so callers leave gating
// inactive rather than mis-gating.
func ConfigFromBuild(bni @ast.File) @BuildConfig

// ConfigForTargetKey maps an explicit `bnc --target` key to its BuildConfig
// (canonical arch/os tags), for tools that need to gate by target without
// reading `pkg/builtins/build` — notably a `--target`-aware bnlint, and
// (later) bnc/bni once `build.bni` itself is build-gated.  Returns
// (cfg, true) for a recognized concrete key; (nil, false) for an unknown key
// AND for the host keys (""/"host"), which name no fixed triple — the host
// config is resolved separately (via ResolveBuildConfig or host detection).
// The recognized key set mirrors cmd/bnc's applyTarget: x86_64-linux,
// x86_64-darwin, aarch64-linux, arm32-linux, arm32-baremetal.
func ConfigForTargetKey(key *[]readonly char) (@BuildConfig, bool)

// EvalBuildExpr evaluates one build-constraint expression against cfg,
// returning (result, errMsg, hasErr).  A clause is `is(predicate, "tag")`
// — a membership test: true when the target's `predicate` matches `tag`.
// The predicates are `arch` (tags x64/aarch64/arm32, plus the assembler's
// aliases x86_64/arm64/arm) and `os` (tags linux/darwin/baremetal).
// Clauses combine with `&&`, `||`, and `!`.  Anything else — an unknown
// predicate or tag, a non-`is` call, a bare identifier, or a comparison
// operator — is a hard error.
func EvalBuildExpr(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool)
