package "pkg/binate/buildcfg"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"

// DeclIncluded — see buildcfg.bni for the contract.
func DeclIncluded(cfg @BuildConfig,
		annotations @[]@ast.Annotation) (bool, @[]char, bool) {
	for i := 0; i < len(annotations); i++ {
		var a @ast.Annotation = annotations[i]
		if isNamespaced(a.Name) {
			continue
		}
		if !streq(a.Name, "build") {
			return false, unknownAnnotationErr(a.Name), true
		}
		if len(a.Args) != 1 {
			return false,
				"build constraint: build(...) takes exactly one expression",
				true
		}
		var v bool
		var verr @[]char
		var vhas bool
		v, verr, vhas = EvalBuildExpr(cfg, a.Args[0])
		if vhas {
			return false, verr, true
		}
		if !v {
			return false, "", false
		}
	}
	return true, "", false
}

// ConfigFromBuild — see buildcfg.bni for the contract.
func ConfigFromBuild(bni @ast.File) @BuildConfig {
	if bni == nil {
		return nil
	}
	var arch *[]readonly char = archFromConst(constInit(bni, "Arch"))
	var os *[]readonly char = osFromConst(constInit(bni, "OS"))
	if len(arch) == 0 || len(os) == 0 {
		return nil
	}
	var cfg @BuildConfig = make(BuildConfig)
	cfg.Arch = arch
	cfg.OS = os
	return cfg
}

// archFromConst maps a `pkg/builtins/build` Arch enum constant
// (ARCH_X64 / ARCH_AARCH64 / ARCH_ARM32) to its canonical tag, or "".
func archFromConst(v @[]char) *[]readonly char {
	if streq(v, "ARCH_X64") {
		return "x64"
	}
	if streq(v, "ARCH_AARCH64") {
		return "aarch64"
	}
	if streq(v, "ARCH_ARM32") {
		return "arm32"
	}
	return ""
}

// osFromConst maps a `pkg/builtins/build` OS enum constant
// (OS_LINUX / OS_DARWIN / OS_BAREMETAL) to its canonical tag, or "".
func osFromConst(v @[]char) *[]readonly char {
	if streq(v, "OS_LINUX") {
		return "linux"
	}
	if streq(v, "OS_DARWIN") {
		return "darwin"
	}
	if streq(v, "OS_BAREMETAL") {
		return "baremetal"
	}
	return ""
}

// constInit returns the initializer identifier of the top-level const named
// `name` in bni — e.g. "ARCH_AARCH64" for `const Arch ArchType = ARCH_AARCH64`
// — or "" if absent or not a plain identifier initializer.
func constInit(bni @ast.File, name *[]readonly char) @[]char {
	var decls @[]@ast.Decl = bni.Decls
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_CONST && streq(d.Name, name) {
			if d.Value != nil && d.Value.Kind == ast.EXPR_IDENT {
				return d.Value.Name
			}
		}
	}
	return ""
}

// EvalBuildExpr — see buildcfg.bni for the contract.
func EvalBuildExpr(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool) {
	if e == nil {
		return false, "build constraint: empty expression", true
	}
	if e.Kind == ast.EXPR_BINARY {
		if e.Op == cast(int, token.LAND) {
			var l bool
			var lerr @[]char
			var lhas bool
			l, lerr, lhas = EvalBuildExpr(cfg, e.X)
			if lhas {
				return false, lerr, true
			}
			if !l {
				return false, "", false
			}
			return EvalBuildExpr(cfg, e.Y)
		}
		if e.Op == cast(int, token.LOR) {
			var l bool
			var lerr @[]char
			var lhas bool
			l, lerr, lhas = EvalBuildExpr(cfg, e.X)
			if lhas {
				return false, lerr, true
			}
			if l {
				return true, "", false
			}
			return EvalBuildExpr(cfg, e.Y)
		}
		return false,
			"build constraint: use is(predicate, \"tag\") rather than a "
			"comparison; only && / || / ! combine clauses",
			true
	}
	if e.Kind == ast.EXPR_UNARY {
		if e.Op == cast(int, token.NOT) {
			var v bool
			var verr @[]char
			var vhas bool
			v, verr, vhas = EvalBuildExpr(cfg, e.X)
			if vhas {
				return false, verr, true
			}
			return !v, "", false
		}
		return false,
			"build constraint: unary operator not supported (only ! is allowed)",
			true
	}
	if e.Kind == ast.EXPR_CALL {
		return evalCall(cfg, e)
	}
	if e.Kind == ast.EXPR_IDENT {
		return false, bareErr(e.Name), true
	}
	return false, "build constraint: malformed expression", true
}

// evalCall evaluates an `is(predicate, "tag")` call.  `is` is the only
// recognized predicate function for now; ordered matchers (at_least /
// at_most / ...) for versions are added when ordered predicates land.
func evalCall(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool) {
	if e.X == nil || e.X.Kind != ast.EXPR_IDENT || !streq(e.X.Name, "is") {
		return false,
			"build constraint: unknown function; use is(predicate, \"tag\")",
			true
	}
	if len(e.Args) != 2 {
		return false,
			"build constraint: is() takes two arguments: is(predicate, \"tag\")",
			true
	}
	if e.Args[0] == nil || e.Args[0].Kind != ast.EXPR_IDENT {
		return false,
			"build constraint: first argument to is() must be a predicate name (arch or os)",
			true
	}
	if e.Args[1] == nil || e.Args[1].Kind != ast.EXPR_STRING_LIT {
		return false,
			"build constraint: second argument to is() must be a quoted tag",
			true
	}
	return evalIs(cfg, e.Args[0].Name, e.Args[1].Name)
}

// evalIs tests whether the active config's value for predicate `pred`
// matches the quoted `tag` (alias-aware), returning (result, errMsg,
// hasErr).  An unknown predicate or an unknown tag is a hard error.
func evalIs(cfg @BuildConfig, pred @[]char, tag @[]char) (bool, @[]char, bool) {
	var matches bool
	var known bool
	if streq(pred, "arch") {
		matches, known = archMatches(tag, cfg.Arch)
	} else if streq(pred, "os") {
		matches, known = osMatches(tag, cfg.OS)
	} else {
		return false, unknownPredicateErr(pred), true
	}
	if !known {
		return false, unknownTagErr(pred, tag), true
	}
	return matches, "", false
}

// archMatches resolves a quoted arch tag — a canonical name or one of the
// assembler's aliases (arm64=aarch64, x86_64=x64, arm=arm32) — to its
// canonical arch and reports (matches, known): matches is whether the tag's
// canonical arch equals cfgArch; known is whether the tag names a
// recognized arch at all.
func archMatches(tag @[]char, cfgArch *[]readonly char) (bool, bool) {
	var canon *[]readonly char = ""
	if eqLitInner(tag, "x64") || eqLitInner(tag, "x86_64") {
		canon = "x64"
	} else if eqLitInner(tag, "aarch64") || eqLitInner(tag, "arm64") {
		canon = "aarch64"
	} else if eqLitInner(tag, "arm32") || eqLitInner(tag, "arm") {
		canon = "arm32"
	}
	if len(canon) == 0 {
		return false, false
	}
	return streq(canon, cfgArch), true
}

// osMatches is archMatches' OS counterpart.  No OS aliases are defined yet.
func osMatches(tag @[]char, cfgOS *[]readonly char) (bool, bool) {
	var canon *[]readonly char = ""
	if eqLitInner(tag, "linux") {
		canon = "linux"
	} else if eqLitInner(tag, "darwin") {
		canon = "darwin"
	} else if eqLitInner(tag, "baremetal") {
		canon = "baremetal"
	}
	if len(canon) == 0 {
		return false, false
	}
	return streq(canon, cfgOS), true
}

// eqLitInner reports whether the interior of the quoted string literal lit
// (`"..."` form, including the surrounding quotes) equals want.  Comparing
// the interior directly avoids materializing a sub-slice.
func eqLitInner(lit @[]char, want *[]readonly char) bool {
	if len(lit) < 2 {
		return false
	}
	var n int = len(lit) - 2
	if n != len(want) {
		return false
	}
	for i := 0; i < n; i++ {
		if lit[1 + i] != want[i] {
			return false
		}
	}
	return true
}

// streq reports whether two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// isNamespaced reports whether an annotation name is dotted (e.g.
// `tool.lint`), which marks it as belonging to another tool / namespace
// that the compiler ignores.
func isNamespaced(name @[]char) bool {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			return true
		}
	}
	return false
}

// unknownAnnotationErr builds the diagnostic for an unrecognized
// unqualified annotation name.
func unknownAnnotationErr(name @[]char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("unknown annotation `")
	cb.Write(name)
	cb.Write("` (unqualified annotation names must be recognized; ")
	cb.Write("namespace tool/compiler metadata under tool.* or compiler.*)")
	return buf.CopyStr(cb.String())
}

// unknownPredicateErr builds the diagnostic for an unknown build predicate.
func unknownPredicateErr(pred @[]char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("build constraint: unknown predicate `")
	cb.Write(pred)
	cb.Write("` (known predicates: arch, os)")
	return buf.CopyStr(cb.String())
}

// unknownTagErr builds the diagnostic for an unrecognized predicate tag.
func unknownTagErr(pred @[]char, tag @[]char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("build constraint: ")
	cb.Write(tag)
	cb.Write(" is not a known ")
	cb.Write(pred)
	cb.Write(" tag")
	return buf.CopyStr(cb.String())
}

// bareErr builds the diagnostic for a bare identifier used where a clause is
// expected.
func bareErr(name @[]char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("build constraint: bare `")
	cb.Write(name)
	cb.Write("` is not a clause; use is(predicate, \"tag\") ")
	cb.Write("(e.g. is(arch, \"x64\"))")
	return buf.CopyStr(cb.String())
}
