package "pkg/binate/buildcfg"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/version"
import "pkg/builtins/build"
import "pkg/std/strings"

// DeclIncluded — see buildcfg.bni for the contract.
func DeclIncluded(cfg @BuildConfig, annotations @[]@ast.Annotation) (bool, @[]char, bool) {
	for i := 0; i < len(annotations); i++ {
		var a @ast.Annotation = annotations[i]
		if isNamespaced(a.Name) {
			continue
		}
		if streq(a.Name, "c_export") {
			// c_export attaches an additional unmangled C symbol to a function
			// (see plan-ffi-export-detailed.md); it is always build-included —
			// never a drop predicate.  Only the argument FORM is checked here
			// (each a single string literal naming the C symbol); the "attaches
			// to a top-level func" requirement needs the decl kind and is
			// enforced by the loader.
			var cerr @[]char
			var chas bool
			cerr, chas = validateCExportArgs(a)
			if chas {
				return false, cerr, true
			}
			continue
		}
		if !streq(a.Name, "build") {
			return false, unknownAnnotationErr(a.Name), true
		}
		if len(a.Args) != 1 {
			return false, "build constraint: build(...) takes exactly one expression", true
		}
		var v bool
		var verr @[]char
		var vhas bool
		v, verr, vhas = EvalBuildExpr(cfg, a.Args[0])
		if vhas {
			return false, verr, true
		}
		if !v {
			return false, "", false
		}
	}
	return true, "", false
}

// HostConfig — see buildcfg.bni for the contract.
func HostConfig() @BuildConfig {
	var arch *[]readonly char = ""
	switch build.Arch {
	case build.ARCH_X64:
		arch = "x64"
	case build.ARCH_AARCH64:
		arch = "aarch64"
	case build.ARCH_ARM32:
		arch = "arm32"
	}
	var os *[]readonly char = ""
	switch build.OS {
	case build.OS_LINUX:
		os = "linux"
	case build.OS_DARWIN:
		os = "darwin"
	case build.OS_BAREMETAL:
		os = "baremetal"
	}
	return mkConfig(arch, os)
}

// ConfigForTarget — see buildcfg.bni for the contract.
func ConfigForTarget(key *[]readonly char) @BuildConfig {
	var cfg @BuildConfig
	var ok bool
	cfg, ok = ConfigForTargetKey(key)
	if ok {
		return cfg
	}
	return HostConfig()
}

// ConfigForTargetKey — see buildcfg.bni for the contract.
func ConfigForTargetKey(key *[]readonly char) (@BuildConfig, bool) {
	if streq(key, "x86_64-linux") {
		return mkConfig("x64", "linux"), true
	}
	if streq(key, "x86_64-darwin") {
		return mkConfig("x64", "darwin"), true
	}
	if streq(key, "aarch64-linux") {
		return mkConfig("aarch64", "linux"), true
	}
	if streq(key, "arm32-linux") {
		return mkConfig("arm32", "linux"), true
	}
	if streq(key, "arm32-baremetal") {
		return mkConfig("arm32", "baremetal"), true
	}
	return nil, false
}

// mkConfig builds a BuildConfig from canonical arch/os tags (static strings,
// borrowed per the BuildConfig field contract).
func mkConfig(arch *[]readonly char, os *[]readonly char) @BuildConfig {
	var cfg @BuildConfig = make(BuildConfig)
	cfg.Arch = arch
	cfg.OS = os
	// Version is target-independent — it's the COMPILING compiler's own version
	// (an immortal string literal, safe to borrow like arch/os).  Same for every
	// target; the ordered/exact version predicates compare against it.
	cfg.Version = version.Version
	// Default the entry point by target, POSITIVELY enumerating each known target
	// (no `else` fallthrough to "main"): a baremetal image's entry is crt0's
	// `_start`; a libc host's is the C runtime's `main`.  A future hosted-but-non-
	// libc OS is deliberately left with an unset Entrypoint, so its startup
	// is(entrypoint, ...) gates all fail and it gets NO Args definition — a loud
	// link error prompting it to pick an entry — rather than silently inheriting
	// this `main` entry.  The --library driver path overrides this to "init".
	if streq(os, "baremetal") {
		cfg.Entrypoint = "start"
	} else if streq(os, "linux") || streq(os, "darwin") {
		cfg.Entrypoint = "main"
	}
	return cfg
}

// EvalBuildExpr — see buildcfg.bni for the contract.
func EvalBuildExpr(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool) {
	if e == nil {
		return false, "build constraint: empty expression", true
	}
	if e.Kind == ast.EXPR_BINARY {
		if e.Op == cast(int, token.LAND) {
			var l bool
			var lerr @[]char
			var lhas bool
			l, lerr, lhas = EvalBuildExpr(cfg, e.X)
			if lhas {
				return false, lerr, true
			}
			if !l {
				return false, "", false
			}
			return EvalBuildExpr(cfg, e.Y)
		}
		if e.Op == cast(int, token.LOR) {
			var l bool
			var lerr @[]char
			var lhas bool
			l, lerr, lhas = EvalBuildExpr(cfg, e.X)
			if lhas {
				return false, lerr, true
			}
			if l {
				return true, "", false
			}
			return EvalBuildExpr(cfg, e.Y)
		}
		return false,
			"build constraint: use is(predicate, \"tag\") rather than a "
					"comparison; only && / || / ! combine clauses",
			true
	}
	if e.Kind == ast.EXPR_UNARY {
		if e.Op == cast(int, token.NOT) {
			var v bool
			var verr @[]char
			var vhas bool
			v, verr, vhas = EvalBuildExpr(cfg, e.X)
			if vhas {
				return false, verr, true
			}
			return !v, "", false
		}
		return false, "build constraint: unary operator not supported (only ! is allowed)", true
	}
	if e.Kind == ast.EXPR_CALL {
		return evalCall(cfg, e)
	}
	if e.Kind == ast.EXPR_IDENT {
		return false, bareErr(e.Name), true
	}
	return false, "build constraint: malformed expression", true
}

// evalCall evaluates a predicate call `<fn>(key, "tag")`.  Recognized fns: `is`
// (exact membership — arch/os/version), and the ordered version matchers
// `at_least` / `at_most`.  Validates the call shape (a known fn, two args: a key
// ident + a quoted tag) then dispatches.  A split tag literal (adjacent
// concatenation) is passed through as a flag so the version parser can reject it.
func evalCall(cfg @BuildConfig, e @ast.Expr) (bool, @[]char, bool) {
	if e.X == nil || e.X.Kind != ast.EXPR_IDENT {
		return false, unknownFuncErr(), true
	}
	var fn @[]char = e.X.Name
	var isCmp bool = streq(fn, "at_least") || streq(fn, "at_most")
	if !streq(fn, "is") && !isCmp {
		return false, unknownFuncErr(), true
	}
	if len(e.Args) != 2 {
		return false, "build constraint: a predicate takes two arguments: <pred>(key, \"tag\")", true
	}
	if e.Args[0] == nil || e.Args[0].Kind != ast.EXPR_IDENT {
		return false,
			"build constraint: first argument must be a predicate key "
					"(arch, os, entrypoint, or version)",
			true
	}
	if e.Args[1] == nil || e.Args[1].Kind != ast.EXPR_STRING_LIT {
		return false, "build constraint: second argument must be a quoted tag", true
	}
	var tagSplit bool = len(e.Args[1].StrParts) > 0
	if isCmp {
		return evalVersionCmp(cfg, fn, e.Args[0].Name, e.Args[1].Name, tagSplit)
	}
	return evalIs(cfg, e.Args[0].Name, e.Args[1].Name, tagSplit)
}

// evalIs tests whether the active config's value for predicate `pred`
// matches the quoted `tag` (alias-aware), returning (result, errMsg,
// hasErr).  An unknown predicate or an unknown tag is a hard error.  For the
// `version` key it is EXACT version equality (pre-stripped) — `tagSplit` (an
// adjacent-concatenation tag) is forwarded so the version path can reject it.
func evalIs(cfg @BuildConfig, pred @[]char, tag @[]char, tagSplit bool) (bool, @[]char, bool) {
	var matches bool
	var known bool
	if streq(pred, "arch") {
		matches, known = archMatches(tag, cfg.Arch)
	} else if streq(pred, "os") {
		matches, known = osMatches(tag, cfg.OS)
	} else if streq(pred, "entrypoint") {
		matches, known = entrypointMatches(tag, cfg.Entrypoint)
	} else if streq(pred, "version") {
		return evalVersionCmp(cfg, "is", pred, tag, tagSplit)
	} else {
		return false, unknownPredicateErr(pred), true
	}
	if !known {
		return false, unknownTagErr(pred, tag), true
	}
	return matches, "", false
}

// archMatches resolves a quoted arch tag — a canonical name or one of the
// assembler's aliases (arm64=aarch64, x86_64=x64, arm=arm32) — to its
// canonical arch and reports (matches, known): matches is whether the tag's
// canonical arch equals cfgArch; known is whether the tag names a
// recognized arch at all.
func archMatches(tag @[]char, cfgArch *[]readonly char) (bool, bool) {
	var canon *[]readonly char = ""
	if eqLitInner(tag, "x64") || eqLitInner(tag, "x86_64") {
		canon = "x64"
	} else if eqLitInner(tag, "aarch64") || eqLitInner(tag, "arm64") {
		canon = "aarch64"
	} else if eqLitInner(tag, "arm32") || eqLitInner(tag, "arm") {
		canon = "arm32"
	}
	if len(canon) == 0 {
		return false, false
	}
	return streq(canon, cfgArch), true
}

// osMatches is archMatches' OS counterpart.  No OS aliases are defined yet.
func osMatches(tag @[]char, cfgOS *[]readonly char) (bool, bool) {
	var canon *[]readonly char = ""
	if eqLitInner(tag, "linux") {
		canon = "linux"
	} else if eqLitInner(tag, "darwin") {
		canon = "darwin"
	} else if eqLitInner(tag, "baremetal") {
		canon = "baremetal"
	}
	if len(canon) == 0 {
		return false, false
	}
	return streq(canon, cfgOS), true
}

// entrypointMatches is osMatches' entrypoint counterpart: the recognized values
// are "main" (hosted program), "start" (baremetal image), and "init" (--library).
// An unrecognized tag is an unknown-tag error (a typo like is(entrypoint,
// "mian") is caught, not silently false).
func entrypointMatches(tag @[]char, cfgEntrypoint *[]readonly char) (bool, bool) {
	var canon *[]readonly char = ""
	if eqLitInner(tag, "main") {
		canon = "main"
	} else if eqLitInner(tag, "start") {
		canon = "start"
	} else if eqLitInner(tag, "init") {
		canon = "init"
	}
	if len(canon) == 0 {
		return false, false
	}
	return streq(canon, cfgEntrypoint), true
}

// eqLitInner reports whether the interior of the quoted string literal lit
// (`"..."` form, including the surrounding quotes) equals want.  Comparing
// the interior directly avoids materializing a sub-slice.
func eqLitInner(lit @[]char, want *[]readonly char) bool {
	if len(lit) < 2 {
		return false
	}
	var n int = len(lit) - 2
	if n != len(want) {
		return false
	}
	for i := 0; i < n; i++ {
		if lit[1 + i] != want[i] {
			return false
		}
	}
	return true
}

// streq reports whether two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// validateCExportArgs checks a `c_export(...)` annotation's argument FORM: at
// least one argument, each a single string literal (the C symbol name).  An
// adjacent-concatenation literal (`"a" "b"`) is rejected so the exported name
// is unambiguous.  The name VALUE is left permissive (any string; a malformed
// or duplicate C symbol surfaces at link time).  Returns (errMsg, hasErr).
func validateCExportArgs(a @ast.Annotation) (@[]char, bool) {
	if len(a.Args) == 0 {
		return "c_export requires at least one string-literal C name", true
	}
	for i := 0; i < len(a.Args); i++ {
		var arg @ast.Expr = a.Args[i]
		if arg == nil || arg.Kind != ast.EXPR_STRING_LIT {
			return "c_export argument must be a string literal", true
		}
		if len(arg.StrParts) > 0 {
			return "c_export name must be a single string literal, not adjacent concatenation", true
		}
	}
	return "", false
}

// HasCExport reports whether any of the given annotations is a `c_export`.
// The loader uses this to reject `#[c_export]` on a non-function declaration:
// DeclIncluded validates the argument form but is not given the decl kind, so
// the "attaches to a top-level func" rule is enforced at the loader's gate.
func HasCExport(annotations @[]@ast.Annotation) bool {
	for i := 0; i < len(annotations); i++ {
		if streq(annotations[i].Name, "c_export") {
			return true
		}
	}
	return false
}

// isNamespaced reports whether an annotation name is dotted (e.g.
// `tool.lint`), which marks it as belonging to another tool / namespace
// that the compiler ignores.
func isNamespaced(name @[]char) bool {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			return true
		}
	}
	return false
}

// unknownAnnotationErr builds the diagnostic for an unrecognized
// unqualified annotation name.
func unknownAnnotationErr(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unknown annotation `")
	cb.Write(name)
	cb.Write("` (unqualified annotation names must be recognized; ")
	cb.Write("namespace tool/compiler metadata under tool.* or compiler.*)")
	return buf.CopyStr(cb.String())
}

// unknownPredicateErr builds the diagnostic for an unknown build predicate key.
func unknownPredicateErr(pred @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("build constraint: unknown predicate `")
	cb.Write(pred)
	cb.Write("` (known predicates: arch, os, entrypoint, version)")
	return buf.CopyStr(cb.String())
}

// unknownFuncErr builds the diagnostic for an unrecognized predicate function.
func unknownFuncErr() @[]char {
	return buf.CopyStr(
			"build constraint: unknown function; use is / at_least / at_most (key, \"tag\")")
}

// unknownTagErr builds the diagnostic for an unrecognized predicate tag.
func unknownTagErr(pred @[]char, tag @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("build constraint: ")
	cb.Write(tag)
	cb.Write(" is not a known ")
	cb.Write(pred)
	cb.Write(" tag")
	return buf.CopyStr(cb.String())
}

// bareErr builds the diagnostic for a bare identifier used where a clause is
// expected.
func bareErr(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("build constraint: bare `")
	cb.Write(name)
	cb.Write("` is not a clause; use is(predicate, \"tag\") ")
	cb.Write("(e.g. is(arch, \"x64\"))")
	return buf.CopyStr(cb.String())
}
