package "pkg/binate/buildcfg"

import "pkg/builtins/testing"

// Tests for the `entrypoint` predicate — is(entrypoint, "main"|"start"|"init"),
// which gates pkg/builtins/startup's hosted `_entry` (args_main.bn) by the
// build's entry point.
// The `cfgOf` / `declAnnots` helpers live in buildcfg_test.bn (same package).

// includedEp evaluates a build annotation against a config with the given
// entrypoint (arch/os fixed to a hosted default), returning (included, hasErr).
func includedEp(annotSrc *[]readonly char, ep *[]readonly char) (bool, bool) {
	var cfg @BuildConfig = cfgOf("x64", "linux")
	cfg.Entrypoint = ep
	var inc bool
	var hasErr bool
	inc, _, hasErr = DeclIncluded(cfg, declAnnots(annotSrc))
	return inc, hasErr
}

func TestEntrypointMatch() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedEp("#[build(is(entrypoint, \"main\"))]", "main")
	if err { return "is(entrypoint, main) errored" }
	if !inc { return "is(entrypoint, main) should include a main config" }
	inc, err = includedEp("#[build(is(entrypoint, \"main\"))]", "init")
	if err { return "is(entrypoint, main) on an init config errored" }
	if inc { return "is(entrypoint, main) should exclude an init config" }
	inc, err = includedEp("#[build(is(entrypoint, \"start\"))]", "start")
	if err || !inc { return "is(entrypoint, start) should include a start config" }
	inc, err = includedEp("#[build(is(entrypoint, \"init\"))]", "init")
	if err || !inc { return "is(entrypoint, init) should include an init config" }
	return ""
}

func TestEntrypointNegation() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedEp("#[build(!is(entrypoint, \"main\"))]", "start")
	if err || !inc { return "!is(entrypoint, main) should include a start config" }
	inc, err = includedEp("#[build(!is(entrypoint, \"main\"))]", "main")
	if err || inc { return "!is(entrypoint, main) should exclude a main config" }
	return ""
}

func TestEntrypointUnknownTag() testing.TestResult {
	// A misspelled value is a hard error, not silently false (mirrors os/arch).
	var err bool
	_, err = includedEp("#[build(is(entrypoint, \"mian\"))]", "main")
	if !err { return "is(entrypoint, <unknown>) should be an unknown-tag error" }
	return ""
}

// A disjunction gate `at_most(version, "0.0.11") || is(entrypoint, "start")`
// includes a newer baremetal (start) build via the OR's right arm and excludes a
// newer hosted (main) build.
func TestEntrypointBaremetalSeedGate() testing.TestResult {
	var src *[]readonly char = "#[build(at_most(version, \"0.0.11\") || is(entrypoint, \"start\"))]"
	var cfg @BuildConfig = cfgOf("arm32", "baremetal")
	cfg.Version = "0.0.12-pre1"
	cfg.Entrypoint = "start"
	var inc bool
	var err bool
	inc, _, err = DeclIncluded(cfg, declAnnots(src))
	if err { return "baremetal seed gate errored" }
	if !inc { return "a newer baremetal (start) build should be included" }
	cfg = cfgOf("x64", "linux")
	cfg.Version = "0.0.12-pre1"
	cfg.Entrypoint = "main"
	inc, _, err = DeclIncluded(cfg, declAnnots(src))
	if err { return "baremetal seed gate on a main build errored" }
	if inc { return "a newer main build must be excluded from the baremetal seed gate" }
	return ""
}

// The BUILDER-safety property (why the entrypoint gate needs no BUILDER re-pin):
// in at_least(version, X) && is(entrypoint, ...), a FALSE at_least short-circuits
// the &&, so is(entrypoint, ...) is never evaluated — a compiler predating the
// `entrypoint` predicate handles the gate without erroring on the unknown key.
// The right arm uses a BOGUS tag that WOULD error if reached, so a false-negative
// (no short-circuit) surfaces as an error rather than a silent pass.
func TestEntrypointShortCircuitProtectsOlderCompiler() testing.TestResult {
	var cfg @BuildConfig = cfgOf("x64", "linux")
	cfg.Version = "0.0.11"
	cfg.Entrypoint = "main"
	var inc bool
	var err bool
	inc, _, err = DeclIncluded(cfg,
			declAnnots("#[build(at_least(version, \"0.0.12\") && is(entrypoint, \"bogus\"))]"))
	if err {
		return "a false at_least must short-circuit && before evaluating is(entrypoint,...)"
	}
	if inc {
		return "gate should be false (version below the threshold)"
	}
	return ""
}

// mkConfig defaults Entrypoint by OS: baremetal → "start", hosted → "main".
func TestEntrypointDefaultByTarget() testing.TestResult {
	var cfg @BuildConfig
	var ok bool
	cfg, ok = ConfigForTargetKey("arm32-baremetal")
	if !ok || !streq(cfg.Entrypoint, "start") {
		return "arm32-baremetal should default Entrypoint to start"
	}
	cfg, ok = ConfigForTargetKey("x86_64-linux")
	if !ok || !streq(cfg.Entrypoint, "main") {
		return "x86_64-linux should default Entrypoint to main"
	}
	return ""
}
