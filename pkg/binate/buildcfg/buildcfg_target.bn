// The target description a build config implies: its layout, arch and float ABI.
package "pkg/binate/buildcfg"

import "pkg/binate/types"

// TargetFor returns the target description cfg's arch and OS imply.  x64 and aarch64
// are LP64: 8-byte pointers and int.  arm32 is ILP32 with an 8-byte maximum
// alignment: AAPCS (the ARM EABI of both arm-linux-gnueabihf and bare-metal
// arm-none-eabi) aligns the 8-byte types (Binate int64 / uint64 / float64) to 8
// although pointers and int are 4, so a cap of 4 would undersize every struct with
// an 8-byte member against the platform's layout (os's `struct stat64`, 104 bytes,
// would read back as 96, and the kernel's write would overrun it).  arm32 linux is
// hard-float (gnueabihf: floats in the VFP registers); every other target keeps the
// default float ABI.  bnc and bnlint set it for the target they build or check for,
// their host included: the types package's default is only the host's sizes, with no
// arch or float ABI.
func TargetFor(cfg @BuildConfig) types.TargetInfo {
	var t types.TargetInfo
	t.MaxAlign = 8
	if streq(cfg.Arch, "x64") || streq(cfg.Arch, "aarch64") {
		t.PointerSize = 8
		t.IntSize = 8
		t.Arch = types.ARCH_X64
		if streq(cfg.Arch, "aarch64") { t.Arch = types.ARCH_AA64 }
		return t
	}
	if !streq(cfg.Arch, "arm32") {
		panic("internal error: a build config names an arch with no target description")
	}
	t.PointerSize = 4
	t.IntSize = 4
	t.Arch = types.ARCH_ARM32
	if streq(cfg.OS, "linux") { t.FloatABI = types.FLOAT_ABI_HARD }
	return t
}
