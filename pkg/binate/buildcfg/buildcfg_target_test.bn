package "pkg/binate/buildcfg"

import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/builtins/testing"

// checkKeyTarget checks the target description TargetFor gives the --target key.
func checkKeyTarget(key *[]readonly char, size int, arch int, floatABI int) testing.TestResult {
	cfg, ok := ConfigForTargetKey(key)
	if !ok { return mkFail(key, "unknown key") }
	var t types.TargetInfo = TargetFor(cfg)
	if t.PointerSize != size || t.IntSize != size || t.MaxAlign != 8 {
		return mkFail(key, "wrong layout")
	}
	if t.Arch != arch { return mkFail(key, "wrong arch") }
	if t.FloatABI != floatABI { return mkFail(key, "wrong float ABI") }
	if t.BigEndian { return mkFail(key, "must be little-endian") }
	return ""
}

func TestTargetForKeys() testing.TestResult {
	var r testing.TestResult = checkKeyTarget("x86_64-linux", 8, types.ARCH_X64,
			types.FLOAT_ABI_DEFAULT)
	if len(r) > 0 { return r }
	r = checkKeyTarget("x86_64-darwin", 8, types.ARCH_X64, types.FLOAT_ABI_DEFAULT)
	if len(r) > 0 { return r }
	r = checkKeyTarget("aarch64-linux", 8, types.ARCH_AA64, types.FLOAT_ABI_DEFAULT)
	if len(r) > 0 { return r }
	r = checkKeyTarget("aarch64-darwin", 8, types.ARCH_AA64, types.FLOAT_ABI_DEFAULT)
	if len(r) > 0 { return r }
	r = checkKeyTarget("arm32-linux", 4, types.ARCH_ARM32, types.FLOAT_ABI_HARD)
	if len(r) > 0 { return r }
	return checkKeyTarget("arm32-baremetal", 4, types.ARCH_ARM32, types.FLOAT_ABI_DEFAULT)
}

// The host's description has the host's own sizes, arch and float ABI (hard on an
// arm32 linux host).
func TestTargetForHost() testing.TestResult {
	var t types.TargetInfo = TargetFor(HostConfig())
	if t.PointerSize != cast(int, sizeof(*uint8)) || t.IntSize != cast(int, sizeof(int)) {
		return "the host's layout must be its own sizes"
	}
	var arch int = types.ARCH_AA64
	if build.Arch == build.ARCH_X64 { arch = types.ARCH_X64 }
	if build.Arch == build.ARCH_ARM32 { arch = types.ARCH_ARM32 }
	if t.Arch != arch { return "the host's arch is wrong" }
	var floatABI int = types.FLOAT_ABI_DEFAULT
	if build.Arch == build.ARCH_ARM32 && build.OS == build.OS_LINUX { floatABI = types.FLOAT_ABI_HARD }
	if t.FloatABI != floatABI { return "the host's float ABI is wrong" }
	return ""
}
