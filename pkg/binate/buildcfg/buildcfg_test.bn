package "pkg/binate/buildcfg"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Keeps the parser's borrowed source buffer alive across a parse.
var srcBuf @[]uint8

// cfgOf builds a BuildConfig for the given arch/os.
func cfgOf(arch *[]readonly char, os *[]readonly char) @BuildConfig {
	var c @BuildConfig = make(BuildConfig)
	c.Arch = arch
	c.OS = os
	return c
}

// declAnnots parses `package "t"\n<annotSrc>\nfunc f() {}` and returns the
// function declaration's annotations.  annotSrc is an annotation block such
// as `#[build(is(arch, "aarch64"))]`, or empty for the un-annotated case.
func declAnnots(annotSrc *[]readonly char) @[]@ast.Annotation {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"t\"\n")
	cb.Write(annotSrc)
	cb.Write("\nfunc f() {}")
	var src @[]readonly char = cb.String()
	srcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		srcBuf[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(srcBuf, "test.bn").ParseFile()
	return f.Decls[0].Annotations
}

// included evaluates DeclIncluded for an annotation block under a config and
// returns (included, hasErr).
func included(annotSrc *[]readonly char, arch *[]readonly char, os *[]readonly char) (bool, bool) {
	var inc bool
	var hasErr bool
	inc, _, hasErr = DeclIncluded(cfgOf(arch, os), declAnnots(annotSrc))
	return inc, hasErr
}

func chk(name *[]readonly char, gotInc bool, gotErr bool, wantInc bool,
		wantErr bool) testing.TestResult {
	if gotErr != wantErr {
		return mkFail(name, "hasErr mismatch")
	}
	if !wantErr && gotInc != wantInc {
		return mkFail(name, "included mismatch")
	}
	return ""
}

func mkFail(name *[]readonly char, detail *[]readonly char) testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(name)
	cb.Write(": ")
	cb.Write(detail)
	return buf.CopyStr(cb.String())
}

// A matching is() keeps the declaration; a non-match drops it; both without
// error.
func TestIsArchMatch() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(arch, \"aarch64\"))]", "aarch64", "linux")
	var r testing.TestResult = chk("TestIsArchMatch/match", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(is(arch, \"x64\"))]", "aarch64", "linux")
	return chk("TestIsArchMatch/nomatch", inc, err, false, false)
}

// Assembler aliases resolve to the same arch: arm64=aarch64, x86_64=x64,
// arm=arm32.
func TestIsArchAliases() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(arch, \"arm64\"))]", "aarch64", "linux")
	var r testing.TestResult = chk("TestIsArchAliases/arm64", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(is(arch, \"x86_64\"))]", "x64", "linux")
	r = chk("TestIsArchAliases/x86_64", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(is(arch, \"arm\"))]", "arm32", "linux")
	return chk("TestIsArchAliases/arm", inc, err, true, false)
}

// `!` negates a clause.
func TestIsNot() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(!is(arch, \"x64\"))]", "aarch64", "linux")
	return chk("TestIsNot", inc, err, true, false)
}

// `||` keeps the declaration when either clause holds.
func TestIsOrOs() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(os, \"linux\") || is(os, \"darwin\"))]", "aarch64", "linux")
	return chk("TestIsOrOs", inc, err, true, false)
}

// `&&` requires both clauses.
func TestIsAnd() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(arch, \"aarch64\") && is(os, \"linux\"))]", "aarch64", "linux")
	var r testing.TestResult = chk("TestIsAnd/both", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(is(arch, \"aarch64\") && is(os, \"darwin\"))]", "aarch64", "linux")
	return chk("TestIsAnd/one", inc, err, false, false)
}

// Multiple `build` entries in one block are ANDed.
func TestIsMultipleAnded() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included(
			"#[build(is(arch, \"aarch64\")), build(is(os, \"linux\"))]", "aarch64", "linux")
	var r testing.TestResult = chk("TestIsMultipleAnded/both", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = included(
			"#[build(is(arch, \"aarch64\")), build(is(os, \"linux\"))]", "aarch64", "darwin")
	return chk("TestIsMultipleAnded/one", inc, err, false, false)
}

// An unknown predicate is a hard error, not a silent skip.
func TestIsUnknownPredicate() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(cpu, \"x64\"))]", "aarch64", "linux")
	return chk("TestIsUnknownPredicate", inc, err, false, true)
}

// An unknown tag is a hard error (catches typos like "armv7").
func TestIsUnknownTag() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(arch, \"armv7\"))]", "aarch64", "linux")
	return chk("TestIsUnknownTag", inc, err, false, true)
}

// A comparison operator instead of is() is a hard error (migration help).
func TestComparisonRejected() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(arch == \"aarch64\")]", "aarch64", "linux")
	return chk("TestComparisonRejected", inc, err, false, true)
}

// A bare predicate (no is() call) is a hard error.
func TestBareIdentRejected() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(arch)]", "aarch64", "linux")
	return chk("TestBareIdentRejected", inc, err, false, true)
}

// is() with the wrong arity / argument shapes is a hard error.
func TestIsBadShape() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[build(is(arch))]", "aarch64", "linux")
	var r testing.TestResult = chk("TestIsBadShape/arity", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(is(\"arch\", \"x64\"))]", "aarch64", "linux")
	r = chk("TestIsBadShape/firstNotIdent", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = included("#[build(at_least(version, \"1.2\"))]", "aarch64", "linux")
	return chk("TestIsBadShape/unknownFn", inc, err, false, true)
}

// An unknown unqualified annotation name is a hard error.
func TestUnknownAnnotation() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[foo(is(arch, \"x64\"))]", "aarch64", "linux")
	return chk("TestUnknownAnnotation", inc, err, false, true)
}

// A namespaced (dotted) annotation is ignored, not an error, and does not
// exclude the declaration.
func TestNamespacedIgnored() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("#[tool.lint(off)]", "aarch64", "linux")
	return chk("TestNamespacedIgnored", inc, err, true, false)
}

// A declaration with no annotations is always included.
func TestNoAnnotations() testing.TestResult {
	var inc bool
	var err bool
	inc, err = included("", "aarch64", "linux")
	return chk("TestNoAnnotations", inc, err, true, false)
}

// ConfigForTarget: an explicit key maps via ConfigForTargetKey.
func TestConfigForTargetExplicit() testing.TestResult {
	var cfg @BuildConfig = ConfigForTarget("arm32-linux")
	if cfg == nil {
		return mkFail("ConfigForTarget/arm32-linux", "nil config")
	}
	if !streq(cfg.Arch, "arm32") || !streq(cfg.OS, "linux") {
		return mkFail("ConfigForTarget/arm32-linux", "wrong arch/os")
	}
	return ""
}

// ConfigForTarget("") / HostConfig() yield this tool's build host — a valid,
// non-empty arch/os (the exact value depends on the build host, so we only
// assert it is populated).
func TestConfigForTargetHost() testing.TestResult {
	var cfg @BuildConfig = ConfigForTarget("")
	if cfg == nil {
		return mkFail("ConfigForTarget/host", "nil config")
	}
	if len(cfg.Arch) == 0 || len(cfg.OS) == 0 {
		return mkFail("ConfigForTarget/host", "empty host arch/os")
	}
	return ""
}

// chkKey asserts ConfigForTargetKey(key) yields (wantArch, wantOS), ok=true.
func chkKey(key *[]readonly char, wantArch *[]readonly char,
		wantOS *[]readonly char) testing.TestResult {
	var cfg @BuildConfig
	var ok bool
	cfg, ok = ConfigForTargetKey(key)
	if !ok {
		return mkFail(key, "expected ok")
	}
	if cfg == nil {
		return mkFail(key, "expected non-nil cfg")
	}
	if !streq(cfg.Arch, wantArch) {
		return mkFail(key, "wrong arch")
	}
	if !streq(cfg.OS, wantOS) {
		return mkFail(key, "wrong os")
	}
	return ""
}

// Each concrete --target key maps to its canonical arch/os.
func TestConfigForTargetKeyKnown() testing.TestResult {
	var r testing.TestResult = chkKey("x86_64-linux", "x64", "linux")
	if len(r) != 0 { return r }
	r = chkKey("x86_64-darwin", "x64", "darwin")
	if len(r) != 0 { return r }
	r = chkKey("aarch64-linux", "aarch64", "linux")
	if len(r) != 0 { return r }
	r = chkKey("arm32-linux", "arm32", "linux")
	if len(r) != 0 { return r }
	r = chkKey("arm32-baremetal", "arm32", "baremetal")
	if len(r) != 0 { return r }
	return ""
}

// Host keys and unknown keys yield (nil, false): the host names no fixed
// triple (its config is resolved via build.bni / host detection), and an
// unknown key is the caller's error to report.
func TestConfigForTargetKeyHostAndUnknown() testing.TestResult {
	var cfg @BuildConfig
	var ok bool
	cfg, ok = ConfigForTargetKey("host")
	if ok || cfg != nil {
		return mkFail("host", "expected (nil, false)")
	}
	cfg, ok = ConfigForTargetKey("")
	if ok || cfg != nil {
		return mkFail("empty", "expected (nil, false)")
	}
	cfg, ok = ConfigForTargetKey("nonsense-triple")
	if ok || cfg != nil {
		return mkFail("nonsense", "expected (nil, false)")
	}
	return ""
}
