// Version-predicate evaluation for `#[build(...)]`: the ordered
// `at_least(version, "X.Y.Z")` / `at_most(...)` and the exact `is(version, …)`
// comparisons against the compiling compiler's version (cfg.Version), plus the
// strict `X.Y.Z[pre[N]]` parser they share.  Split from buildcfg.bn to keep that
// file under the length limit; evalCall/evalIs (there) dispatch into here.
package "pkg/binate/buildcfg"

import "pkg/binate/buf"
import "pkg/std/strings"

// evalVersionCmp compares the compiling compiler's version (cfg.Version) against
// the version named by the quoted literal `tag`, per `fn` (`at_least` = ≥,
// `at_most` = ≤, `is` = exact).  Only the `version` key is ordered/exact-
// comparable, so a non-`version` key is a hard error (this catches
// `at_least(arch, …)`).  The tag must be a single well-formed `X.Y.Z[pre[N]]`
// literal — a split (adjacent-concatenation) literal or a malformed version is a
// hard error.  Both sides are pre-stripped before the numeric compare.
func evalVersionCmp(cfg @BuildConfig, fn @[]char, pred @[]char, tag @[]char,
		tagSplit bool) (bool, @[]char, bool) {
	if !streq(pred, "version") {
		return false, orderedNonVersionErr(fn, pred), true
	}
	if tagSplit {
		return false,
			"build constraint: version tag must be a single string literal, not adjacent concatenation", true
	}
	// The tag is the quoted literal `"X.Y.Z"`; parse its interior (strip quotes).
	var lMaj int
	var lMin int
	var lPat int
	var lok bool
	lMaj, lMin, lPat, lok = parseVersion(tag, 1, len(tag) - 1)
	if !lok {
		return false, malformedVersionErr(tag), true
	}
	var cMaj int
	var cMin int
	var cPat int
	var cok bool
	cMaj, cMin, cPat, cok = parseVersion(cfg.Version, 0, len(cfg.Version))
	if !cok {
		// version.Version is project-owned and should always parse; fail loud
		// rather than silently defaulting to 0.0.0.
		return false, "build constraint: the compiler's own version is malformed (internal error)", true
	}
	var cmp int = compareVersions(cMaj, cMin, cPat, lMaj, lMin, lPat)
	if streq(fn, "at_least") {
		return cmp >= 0, "", false
	}
	if streq(fn, "at_most") {
		return cmp <= 0, "", false
	}
	// fn == "is": exact equality.
	return cmp == 0, "", false
}

// parseVersion parses s[start:end) as a strict version `X.Y.Z[-pre[N]]`,
// returning (major, minor, patch, ok).  Exactly three dot-separated digit-runs,
// optionally followed by the hyphenated `-pre` and optional digits, and nothing
// else — a 4th component, an unknown tag (`-rc1`, `beta`), a NON-hyphenated
// `preN`, a missing component, or a non-digit component all yield ok=false (no
// best-effort parse).  The `-pre[N]` suffix is accepted but discarded (a
// prerelease of X.Y.Z compares equal to X.Y.Z).  A leading `bnc-` is tolerated
// and skipped (defensive; `version.Version` has none, but a stray prefixed
// literal must not silently mis-parse).
func parseVersion(s *[]readonly char, start int, end int) (int, int, int, bool) {
	var i int = start
	if end - i >= 4 && s[i] == 'b' && s[i + 1] == 'n' && s[i + 2] == 'c' && s[i + 3] == '-' {
		i = i + 4
	}
	var major int
	var minor int
	var patch int
	var ok bool
	major, i, ok = parseDigits(s, i, end)
	if !ok {
		return 0, 0, 0, false
	}
	if i >= end || s[i] != '.' {
		return 0, 0, 0, false
	}
	i = i + 1
	minor, i, ok = parseDigits(s, i, end)
	if !ok {
		return 0, 0, 0, false
	}
	if i >= end || s[i] != '.' {
		return 0, 0, 0, false
	}
	i = i + 1
	patch, i, ok = parseDigits(s, i, end)
	if !ok {
		return 0, 0, 0, false
	}
	if i == end {
		return major, minor, patch, true
	}
	// The only permitted suffix is the hyphenated `-pre`, optionally followed by
	// digits — a prerelease `X.Y.Z-preN` (the untagged working tree between
	// releases starts at `-pre1`; a bare `-pre` with no number is the
	// lowest-ordered prerelease and is still accepted).  All prerelease spellings
	// compare equal to the X.Y.Z release (the suffix is discarded).  A
	// non-hyphenated `preN` is NOT accepted — the canonical version format is
	// hyphenated (version-sync enforces it).
	if end - i < 4 || s[i] != '-' || s[i + 1] != 'p' || s[i + 2] != 'r' || s[i + 3] != 'e' {
		return 0, 0, 0, false
	}
	i = i + 4
	for i < end {
		if s[i] < '0' || s[i] > '9' {
			return 0, 0, 0, false
		}
		i = i + 1
	}
	return major, minor, patch, true
}

// parseDigits reads a run of one-or-more ASCII digits from s starting at i (up to
// end), returning (value, nextIndex, ok).  ok is false if there is no digit at i
// (so an empty component is rejected).
func parseDigits(s *[]readonly char, i int, end int) (int, int, bool) {
	if i >= end || s[i] < '0' || s[i] > '9' {
		return 0, i, false
	}
	var v int = 0
	for i < end && s[i] >= '0' && s[i] <= '9' {
		v = v * 10 + (cast(int, s[i]) - cast(int, '0'))
		i = i + 1
	}
	return v, i, true
}

// compareVersions returns -1 / 0 / 1 for a <=> b, comparing (major, minor, patch)
// NUMERICALLY (so 0.0.11 > 0.0.9, not lexically).
func compareVersions(aMaj int, aMin int, aPat int, bMaj int, bMin int, bPat int) int {
	if aMaj != bMaj {
		if aMaj < bMaj {
			return -1
		}
		return 1
	}
	if aMin != bMin {
		if aMin < bMin {
			return -1
		}
		return 1
	}
	if aPat != bPat {
		if aPat < bPat {
			return -1
		}
		return 1
	}
	return 0
}

// orderedNonVersionErr builds the diagnostic for an ordered predicate
// (`at_least` / `at_most`) applied to a non-`version` key (arch/os aren't
// ordered).
func orderedNonVersionErr(fn @[]char, pred @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("build constraint: `")
	cb.Write(fn)
	cb.Write("` applies only to the version key, not `")
	cb.Write(pred)
	cb.Write("`")
	return buf.CopyStr(cb.String())
}

// malformedVersionErr builds the diagnostic for a version tag that is not a
// well-formed `X.Y.Z[pre[N]]`.  `tag` is the quoted literal.
func malformedVersionErr(tag @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("build constraint: ")
	cb.Write(tag)
	cb.Write(" is not a valid version (expected X.Y.Z or X.Y.Zpre[N])")
	return buf.CopyStr(cb.String())
}
