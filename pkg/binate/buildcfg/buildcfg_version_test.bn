package "pkg/binate/buildcfg"

import "pkg/builtins/testing"

// Tests for the version predicate — at_least / at_most (ordered) + is(version, …)
// (exact) — over the compiling compiler's version (cfg.Version).  The `cfgOf` /
// `declAnnots` / `chk` helpers live in buildcfg_test.bn (same package).

// includedVer evaluates DeclIncluded for an annotation block against a config
// whose compiler Version is `ver` (arch/os are irrelevant to version
// predicates), returning (included, hasErr).
func includedVer(annotSrc *[]readonly char, ver *[]readonly char) (bool, bool) {
	var cfg @BuildConfig = cfgOf("x64", "linux")
	cfg.Version = ver
	var inc bool
	var hasErr bool
	inc, _, hasErr = DeclIncluded(cfg, declAnnots(annotSrc))
	return inc, hasErr
}

// at_least is version ≥ threshold; the `-pre[N]` suffix is stripped, so
// `0.0.11-pre3` counts as `0.0.11`.
func TestAtLeast() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"0.0.11\"))]", "0.0.11-pre3")
	var r testing.TestResult = chk("TestAtLeast/eq-prestripped", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.12\"))]", "0.0.11-pre3")
	r = chk("TestAtLeast/below", inc, err, false, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.10\"))]", "0.0.11-pre3")
	return chk("TestAtLeast/above", inc, err, true, false)
}

// at_most is version ≤ threshold.
func TestAtMost() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_most(version, \"0.0.11\"))]", "0.0.11")
	var r testing.TestResult = chk("TestAtMost/eq", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_most(version, \"0.0.10\"))]", "0.0.11")
	return chk("TestAtMost/above", inc, err, false, false)
}

// is(version, …) is exact equality, pre-stripped.
func TestIsVersion() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(is(version, \"0.0.11\"))]", "0.0.11-pre3")
	var r testing.TestResult = chk("TestIsVersion/eq-prestripped", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(is(version, \"0.0.12\"))]", "0.0.11")
	return chk("TestIsVersion/ne", inc, err, false, false)
}

// `!` yields the strict/inverse relations: !at_least = <, !at_most = >,
// !is(version, …) = ≠.
func TestVersionNegation() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(!at_least(version, \"0.0.12\"))]", "0.0.11")
	var r testing.TestResult = chk("TestVersionNegation/lt", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(!at_most(version, \"0.0.10\"))]", "0.0.11")
	r = chk("TestVersionNegation/gt", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(!is(version, \"0.0.12\"))]", "0.0.11")
	return chk("TestVersionNegation/ne", inc, err, true, false)
}

// Comparison is NUMERIC, not lexical: `0.0.11` ≥ `0.0.9` (false lexically, since
// "11" < "9"), and multi-digit components compare numerically.
func TestVersionNumericNotLexical() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"0.0.9\"))]", "0.0.11")
	var r testing.TestResult = chk("TestVersionNumericNotLexical/patch", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.99\"))]", "0.0.100")
	return chk("TestVersionNumericNotLexical/multidigit", inc, err, true, false)
}

// A leading `bnc-` on the literal is tolerated (defensive strip).
func TestVersionBncPrefix() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"bnc-0.0.11\"))]", "0.0.11")
	return chk("TestVersionBncPrefix", inc, err, true, false)
}

// A bare `-pre` (no number) is valid and strips to the release; a NON-hyphenated
// `preN` is malformed (the canonical prerelease is hyphenated); `-pre` + a
// non-digit is malformed.
func TestVersionPreSuffix() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(is(version, \"0.0.11\"))]", "0.0.11-pre")
	var r testing.TestResult = chk("TestVersionPreSuffix/bare-hyphen", inc, err, true, false)
	if len(r) != 0 {
		return r
	}
	// Non-hyphenated `preN` is NOT a valid prerelease spelling any more.
	inc, err = includedVer("#[build(at_least(version, \"0.0.11pre3\"))]", "0.0.11")
	r = chk("TestVersionPreSuffix/nonhyphen", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.11-prex\"))]", "0.0.11")
	return chk("TestVersionPreSuffix/nondigit", inc, err, false, true)
}

// A malformed version literal is a hard error: too few / too many components, a
// non-digit component, or an unknown suffix.
func TestVersionMalformedLiteral() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"0.0\"))]", "0.0.11")
	var r testing.TestResult = chk("TestVersionMalformedLiteral/twocomp", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.11.4\"))]", "0.0.11")
	r = chk("TestVersionMalformedLiteral/fourcomp", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"0.0.11beta\"))]", "0.0.11")
	r = chk("TestVersionMalformedLiteral/unknownsuffix", inc, err, false, true)
	if len(r) != 0 {
		return r
	}
	inc, err = includedVer("#[build(at_least(version, \"1.2.x\"))]", "0.0.11")
	return chk("TestVersionMalformedLiteral/nondigit", inc, err, false, true)
}

// A split (adjacent-concatenation) version literal is a hard error.
func TestVersionSplitLiteral() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"0.0\" \".11\"))]", "0.0.11")
	return chk("TestVersionSplitLiteral", inc, err, false, true)
}

// An ordered predicate on a non-version key is a hard error (arch/os aren't
// ordered).
func TestOrderedNonVersionKey() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(arch, \"x64\"))]", "0.0.11")
	return chk("TestOrderedNonVersionKey", inc, err, false, true)
}

// An unknown predicate function is a hard error.
func TestUnknownVersionFunc() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(foo(version, \"0.0.11\"))]", "0.0.11")
	return chk("TestUnknownVersionFunc", inc, err, false, true)
}

// A malformed COMPILER version (cfg.Version) is a hard error rather than a
// silent 0.0.0 default.
func TestMalformedCompilerVersion() testing.TestResult {
	var inc bool
	var err bool
	inc, err = includedVer("#[build(at_least(version, \"0.0.11\"))]", "garbage")
	return chk("TestMalformedCompilerVersion", inc, err, false, true)
}
