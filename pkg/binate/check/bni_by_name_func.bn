package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The by-name walk's call that defines a `.bni`'s function (defineBniFunc, and
// bniFuncOnDemand's definition of one read before its turn): marked as being defined,
// it first resolves what its parameters' and results' types read, in order
// (check_by_name_reads.bn, classified by pushBniReadFrom), so that a chain of functions
// whose signatures call the next (`func F0() [len(F1())]int8`, ...) of any length is
// defined with no recursion.  pushBniReadFrom also classifies what a `.bni`'s type's
// array lengths read (stepBniType) and what a `.bni`'s method's signature reads
// (bni_by_name_method.bn).

// stepBniFunc runs the `.bni` function's call k to its next call or its end.
func stepBniFunc(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if !startBniFunc(c, k) {
			byNameReturn(k)
			return
		}
		k.pc = byNameLoopConsts
	}
	if stepBniReadsAhead(c, k) { return }
	finishBniFunc(c, k)
	byNameReturn(k)
}

// stepBniReadsAhead starts, from the running `.bni` call k, the call for its next read
// to be resolved ahead (pushBniReadFrom), and reports whether it did; at a read made
// in its place, the rest are left too.
func stepBniReadsAhead(c @Checker, k @byNameCall) bool {
	for k.i < k.reads.count() {
		var at int = k.i
		k.i = k.i + 1
		var next int = pushBniReadFrom(c, k, at)
		if next == byNameReadPushed { return true }
		if next == byNameReadStop { k.i = k.reads.count() }
	}
	return false
}

// startBniFunc starts the `.bni` function's call k: one made for another declaration
// defines k.name only when it is a function of the `.bni` not defined yet, in its
// declaration's context, as bniFuncOnDemand defines one; then, as defineBniFunc, unless
// it is being defined or inside a build that waits already, it marks the function as
// being defined, enters its resolution and a demand frame, finds what its signature
// reads (k.reads) -- unless it is generic or an instance is being built -- and reports
// whether it does.
func startBniFunc(c @Checker, k @byNameCall) bool {
	var bb @BniBuild = c.BniBuild
	if k.onDemand {
		if bb == nil || !scopeReaches(c.Scope, bb.TempScope) { return false }
		var d @ast.Decl = findBniFuncDecl(c.BniDecls, k.name)
		if d == nil || c.Scope.Lookup(k.name) != nil { return false }
		k.bniSaved = enterBniDecl(c, d)
		k.d = d
		k.s = bb.Scope
	}
	if nameInList(bb.FuncsDefining, k.d.Name) || skipDemand(c) {
		if k.onDemand { leaveBniDecl(c, k.bniSaved) }
		return false
	}
	k.bb = bb
	bb.FuncsDefining = slices.Append[@[]char](bb.FuncsDefining, k.d.Name)
	enterBniDeclResolution(c, k.d.Name)
	k.framed = enterDemandFrame(c)
	if !buildingInstances(c) && len(k.d.TypeParams) == 0 {
		for i := 0; i < len(k.d.Params); i++ {
			collectTypeExprReads(c, k.d.Params[i].Type, &k.reads)
		}
		for i := 0; i < len(k.d.Results); i++ {
			collectTypeExprReads(c, k.d.Results[i], &k.reads)
		}
	}
	return true
}

// finishBniFunc defines the `.bni` function of the call k from its signature, what it
// reads resolved, as defineBniFunc does -- undone when it read a layout not built yet,
// inside an instance's build -- and leaves the context a call made for another
// declaration entered.
func finishBniFunc(c @Checker, k @byNameCall) {
	var bb @BniBuild = k.bb
	var d @ast.Decl = k.d
	var ft @types.Type = resolveFuncDeclType(c, d)
	bb.FuncsDefining = bb.FuncsDefining[:len(bb.FuncsDefining) - 1]
	var waited bool = leaveBniDeclResolution(c)
	if leaveDemandFrame(c, k.framed) {
		ast.ClearCheckerAnnotations(d)
		if k.onDemand { leaveBniDecl(c, k.bniSaved) }
		return
	}
	defineFunc(k.s, d.Name, ft)
	var bound @Symbol = bb.TempScope.LookupLocal(d.Name)
	if bound == nil || bound.Kind != types.SYM_PKG {
		defineFunc(bb.TempScope, d.Name, ft)
	}
	if len(d.TypeParams) > 0 {
		recordGenericHome(c, d)
	}
	if waited { flushLayoutWaits(c) }
	if k.onDemand { leaveBniDecl(c, k.bniSaved) }
}

// pushBniReadFrom starts, from the running `.bni` call k, the call that resolves its
// read at ahead, and reports what follows (as pushReadFrom does for a batch): a pending
// alias named (pushAliasReadFrom); a method called on a receiver whose type the walk
// can name (pushBniMethodReadFrom); a `.bni` type whose layout is read, or which a
// composite literal is of or holds, not being resolved -- one being resolved is a cycle
// a layout read reports, and needs nothing for a literal; a `.bni` constant read,
// unless resolved already, or left to the read that names it while it is being
// resolved; a `.bni` variable or function read, not defined yet, unless being defined.
// A stop, any other alias, a type being resolved whose layout is read, and any other
// name read as a value but `iota`, `true` and `false`, are left where they are read,
// with the reads after them.
func pushBniReadFrom(c @Checker, k @byNameCall, at int) int {
	var name @[]char = k.reads.names[at]
	var kind int = k.reads.kinds[at]
	if len(name) == 0 { return byNameReadStop }
	if kind == readAlias { return pushAliasReadFrom(c, k, name) }
	if isMethodRead(kind) { return pushBniMethodReadFrom(c, k, k.reads.owners[at], name, kind) }
	var bb @BniBuild = c.BniBuild
	if bb == nil || pendingAliasIdx(c, name) >= 0 { return byNameReadStop }
	if kind == readLayout || kind == readLiteral {
		var td @ast.Decl = findBniTypeDecl(c.BniDecls, name)
		if td == nil { return byNameReadNext }
		if declInList(bb.TypesResolving, td) {
			if kind == readLiteral { return byNameReadNext }
			return byNameReadStop
		}
		_ = byNameCallFrom(k, byNameBniType, name)
		return byNameReadPushed
	}
	if nameInList(k.names, name) {
		if nameInList(c.ConstResolved, name) { return byNameReadNext }
		if nameInList(c.ConstResolving, name) { return byNameReadStop }
		_ = byNameCallFrom(k, byNameBniConst, name)
		return byNameReadPushed
	}
	var vd @ast.Decl = findBniVarDecl(c.BniDecls, name)
	var fd @ast.Decl = findBniFuncDecl(c.BniDecls, name)
	if vd != nil || fd != nil && len(fd.TypeParams) == 0 {
		if c.Scope.Lookup(name) != nil { return byNameReadNext }
		if vd != nil && nameInList(bb.VarsDefining, name) ||
				vd == nil && nameInList(bb.FuncsDefining, name) {
			return byNameReadStop
		}
		var proc int = byNameBniFunc
		if vd != nil { proc = byNameBniVar }
		var r @byNameCall = byNameCallFrom(k, proc, name)
		r.onDemand = true
		return byNameReadPushed
	}
	if types.CharEq(name, "iota") || types.CharEq(name, "true") || types.CharEq(name, "false") {
		return byNameReadNext
	}
	return byNameReadStop
}
