package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for bni_by_name_func.bn: a `.bni`'s functions, and what its types' array
// lengths read, resolved ahead from the by-name walk.

// A `.bni` constant reading the length of the result of the first of a long chain of
// functions, each returning an array as long as the next one's result, is resolved
// after the whole chain.
func TestDeepBniFuncChain() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc("package \"pkg/q\"\nconst Z int = len(F0())\n", "func F", "() [len(F", "())]int8",
					byNameLevels, "() [3]int8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 3)
}

// So is a `.bni` constant reading the size of a type over the first of a long chain of
// types, each an array as long as the next's size.
func TestDeepBniSizeofChain() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc(
					"package \"pkg/q\"\nconst Z uint = sizeof(X)\ntype X struct { a [sizeof(T0)]uint8 }\n",
					"type T", " [sizeof(T", ")]uint8", byNameLevels, " uint8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 1)
}

// `.bni` functions whose signatures call each other leave the first undefined where
// the second's signature names it, and types whose lengths read each other's size are a
// cycle, reported where the second reads the first -- as without the walk.
func TestBniFuncAndSizeofCycles() testing.TestResult {
	c, _ := loadChainBni("package \"pkg/q\"\nfunc F() [len(G())]int\nfunc G() [len(F())]int\n")
	if !errAtLine(c, 3, "undefined: F") { return fail("F is undefined in G's signature") }
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c, _ = loadChainBni(
			"package \"pkg/q\"\ntype X [sizeof(T0)]uint8\ntype T0 [sizeof(T1)]uint8\n"
					"type T1 [sizeof(T0)]uint8\n")
	if !errAtLine(c, 4, "cyclic type definition involving `T0`") {
		return fail("the cycle is reported where T1 reads T0")
	}
	return errCount(c, 1)
}

// A `.bni` type being resolved, read for its layout, is a cycle its read reports, and
// the reads after it stay in place: T, resolved on the walk where X reads its size,
// reads itself, which is reported, and F, after it, is not defined ahead -- so F's
// signature's read of T is not reported as well, as without the walk.
func TestBniStopsAtResolvingType() testing.TestResult {
	c, _ := loadChainBni(
			"package \"pkg/q\"\ntype X [sizeof(T)]uint8\ntype T [sizeof(T) + len(F())]uint8\n"
					"func F() [sizeof(T)]int\n")
	if !errAtLine(c, 3, "cyclic type definition involving `T`") {
		return fail("T's read of itself is reported")
	}
	return errCount(c, 1)
}

// A `.bni` type's composite literal of a type being resolved needs nothing of it, so a
// long chain of types whose lengths each read one, beside the size of the next, is
// resolved with no recursion.
func TestDeepBniSizeofChainWithLiterals() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc(
					"package \"pkg/q\"\nconst Z uint = sizeof(X)\ntype X struct { a [sizeof(A0)]uint8 }\n",
					"type A", " struct { a [len([1]X{}) + sizeof(A", ")]uint8 }", byNameBatchLevels,
					" struct { a [1]uint8 }\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", byNameBatchLevels + 1)
}
