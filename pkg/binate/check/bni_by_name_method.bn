package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/vec"
import "pkg/stdx/slices"

// The by-name walk's call that defines a method of a `.bni` (defineBniMethod), made
// where a selection reads it (bniMethodOnDemand) or where a declaration's resolution
// calls it on a receiver whose type it can name (pushBniMethodReadFrom): marked as
// being defined, it resolves what its receiver's and signature's types read ahead, so
// that a chain of `.bni` methods whose signatures each call the next (`func (s S0) M()
// [len(S1{}.M())]int8`, ...) is defined with no recursion.

// byNameBniMethodDefined is the method the last `.bni` method call not made for another
// declaration defined, or nil (defineBniMethod).
var byNameBniMethodDefined @types.Method

// stepBniMethod runs the `.bni` method's call k to its next call or its end.
func stepBniMethod(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if !startBniMethod(c, k) {
			byNameReturn(k)
			return
		}
		k.pc = byNameLoopReads
	}
	if stepBniReadsAhead(c, k) { return }
	finishBniMethod(c, k)
	byNameReturn(k)
}

// startBniMethod starts the `.bni` method's call k: one made for another declaration
// defines k.d, of the type k.recv, only when it is not defined yet nor being defined,
// in its own declaration's context, as bniMethodOnDemand defines one; then, unless
// inside a build that waits already, it marks the method as being defined, enters its
// resolution and a demand frame, finds what its receiver's and signature's types read
// (k.reads) -- unless an instance is being built, or its receiver is two pointer levels
// down (receiverPointerLevels), which keeps it from being kept, so its reads are made
// in place as each read defines it again -- and reports whether it does.
func startBniMethod(c @Checker, k @byNameCall) bool {
	var bb @BniBuild = c.BniBuild
	var d @ast.Decl = k.d
	if k.onDemand {
		if bb == nil || bniMethodDefined(bb, k.recv, d.Name) != nil || declInList(bb.MethodsDefining, d) {
			return false
		}
		k.bniSaved = enterBniDecl(c, d)
	}
	if skipDemand(c) {
		if k.onDemand { leaveBniDecl(c, k.bniSaved) }
		return false
	}
	bb.MethodsDefining = slices.Append[@ast.Decl](bb.MethodsDefining, d)
	enterBniDeclResolution(c, bniMethodKey(d))
	k.framed = enterDemandFrame(c)
	if !buildingInstances(c) && receiverPointerLevels(d.Recv.Type) <= 1 {
		collectTypeExprReads(c, d.Recv.Type, &k.reads)
		for i := 0; i < len(d.Params); i++ {
			collectTypeExprReads(c, d.Params[i].Type, &k.reads)
		}
		for i := 0; i < len(d.Results); i++ {
			collectTypeExprReads(c, d.Results[i], &k.reads)
		}
	}
	return true
}

// finishBniMethod defines the `.bni` method of the call k from its receiver and
// signature, what they read resolved, as collecting it does (collectMethodDecl): not
// kept when it read a layout not built yet, inside an instance's build, nor for a
// receiver the package's own check rejects too; the layout waits are flushed once one
// is defined, when a read has waited for it.
func finishBniMethod(c @Checker, k @byNameCall) {
	var bb @BniBuild = c.BniBuild
	var d @ast.Decl = k.d
	var recvType @types.Type = resolveTypeExpr(c, d.Recv.Type)
	var ft @types.Type = resolveFuncDeclType(c, d)
	bb.MethodsDefining = bb.MethodsDefining[:len(bb.MethodsDefining) - 1]
	var waited bool = leaveBniDeclResolution(c)
	var m @types.Method
	if leaveDemandFrame(c, k.framed) {
		ast.ClearCheckerAnnotations(d)
	} else if !isErrType(recvType) && declaredReceiverKindOK(recvType) {
		var params @[]@types.Param = prependRecvParam(d.Recv.Name, recvType, ft.Params)
		m = MakeMethod(d.Name, recvType, types.MakeFuncType(params, ft.Results))
		bb.Methods = slices.Append[@types.Method](bb.Methods, m)
		bb.MethodOwners = slices.Append[@types.Type](bb.MethodOwners, k.recv)
		if waited { flushLayoutWaits(c) }
	}
	if k.onDemand {
		leaveBniDecl(c, k.bniSaved)
	} else {
		byNameBniMethodDefined = m
	}
}

// pushBniMethodReadFrom starts, from the running `.bni` call k, the call that defines
// the `.bni`'s method name of the receiver read through owner (as kind says:
// methodReadRecv) ahead, and reports what follows, as pushBniReadFrom does: one not
// defined yet is defined as bniMethodOnDemand defines one, and one defined needs
// nothing.  A name the receiver's type has a field of -- which the selection calls
// instead (spec expr.member) --, a method being defined, one the `.bni` does not
// declare on the type, one whose receiver is two pointer levels down (never kept, so
// defined again where each read is made), and a receiver whose type is no type of the
// `.bni` -- an instance, an interface ... -- are left where they are read, with the
// reads after them.
func pushBniMethodReadFrom(c @Checker, k @byNameCall, owner *[]readonly char, name @[]char,
		kind int) int {
	var bb @BniBuild = c.BniBuild
	var named @types.Type = methodReadRecv(c, owner, kind)
	if bb == nil || named == nil { return byNameReadStop }
	var sym @Symbol = bb.Scope.LookupLocal(named.Name)
	if sym == nil || !same(sym.Type, named) { return byNameReadStop }
	var td @ast.Decl = bniTypeDeclOf(c, named)
	if td != nil && td.TypeRef != nil &&
			fieldPath(c, td.TypeRef, name, false, vec.New[@ast.Decl](), 0) {
		return byNameReadStop
	}
	if named.LookupMethod(name) != nil || bniMethodDefined(bb, named, name) != nil {
		return byNameReadNext
	}
	var d @ast.Decl = findBniMethodDecl(c.BniDecls, named.Name, name)
	if d == nil || declInList(bb.MethodsDefining, d) || receiverPointerLevels(d.Recv.Type) > 1 {
		return byNameReadStop
	}
	var r @byNameCall = byNameCallFrom(k, byNameBniMethod, name)
	r.d = d
	r.recv = named
	r.onDemand = true
	return byNameReadPushed
}
