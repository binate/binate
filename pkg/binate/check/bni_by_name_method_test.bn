package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for bni_by_name_method.bn: chains of a `.bni`'s methods, each defined after the
// one its signature calls, walked with no recursion.

// bniMethodChainSrc returns a `.bni` of the package pkg/q whose constant Z is the length
// of M's result on the first of a long chain of types, each M's result an array as long
// as the next type's M's result, called on a receiver of the kind recv
// (methodWalkChainSrc's).
func bniMethodChainSrc(recv int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"pkg/q\"\nconst Z int = len(")
	writeBniRecv(b, recv, 0)
	b.Write(".M())\n")
	for i := 0; i <= byNameBatchLevels; i++ {
		var n @[]char = strconv.Itoa(i)
		b.Write("type S")
		b.Write(n)
		b.Write(" struct {}\n")
		if recv == recvVar {
			writeLink(b, "var V", i, " S", i, "")
		} else if recv == recvCall {
			writeLink(b, "func Mk", i, "() S", i, "")
		}
		b.Write("func (s S")
		b.Write(n)
		b.Write(") M() ")
		if i == byNameBatchLevels {
			b.Write("[3]int8\n")
		} else {
			b.Write("[len(")
			writeBniRecv(b, recv, i + 1)
			b.Write(".M())]int8\n")
		}
	}
	return buf.CopyStr(b.String())
}

// writeBniRecv writes a receiver of the `.bni`'s type S<i>, of the kind recv.
func writeBniRecv(b @strings.Builder, recv int, i int) {
	var n @[]char = strconv.Itoa(i)
	if recv == recvLiteral {
		b.Write("S")
		b.Write(n)
		b.Write("{}")
	} else if recv == recvVar {
		b.Write("V")
		b.Write(n)
	} else {
		b.Write("Mk")
		b.Write(n)
		b.Write("()")
	}
}

// A `.bni` constant reading the length of M's result on the first of a long chain of
// types, each M's result as long as the next's, is resolved after the whole chain: M
// called on a composite literal of each type.
func TestDeepBniMethodChain() testing.TestResult {
	c, pkgScope := loadChainBni(bniMethodChainSrc(recvLiteral))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 3)
}

// So is one calling M on variables of the types.
func TestDeepBniMethodChainOnVars() testing.TestResult {
	c, pkgScope := loadChainBni(bniMethodChainSrc(recvVar))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 3)
}

// So is one calling M on the results of functions returning the types.
func TestDeepBniMethodChainOnCalls() testing.TestResult {
	c, pkgScope := loadChainBni(bniMethodChainSrc(recvCall))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 3)
}

// A field of the name a selection calls takes precedence over a `.bni` method of that
// name (spec expr.member), so no method is defined for it ahead: a method whose
// signature reads the type calling the field, resolved on the walk where X reads its
// size, is no cycle.
func TestBniMethodReadCallsField() testing.TestResult {
	c, _ := loadChainBni(
			"package \"pkg/q\"\ntype X [sizeof(T)]uint8\ntype T struct { a [len(S{}.M())]int8 }\n"
					"type S struct { M *func() [3]int8 }\nfunc (s S) M() [sizeof(T)]int8\n")
	return errCount(c, 0)
}

// A `.bni` method two pointer levels down is never kept, so each read defines it
// again: none is read ahead, and a chain of them, each signature reading the next
// twice, is checked in linear time, as without the walk (defined ahead, each read
// would define the rest of the chain again).
func TestBniMethodOnPointerToPointerReadInPlace() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"pkg/q\"\nfunc F() [len(S0{}.M())]int8\n")
	for i := 0; i < 24; i++ {
		var n @[]char = strconv.Itoa(i)
		var next @[]char = strconv.Itoa(i + 1)
		b.Write("type S")
		b.Write(n)
		b.Write(" struct {}\nfunc (s **S")
		b.Write(n)
		b.Write(") M() [len(S")
		b.Write(next)
		b.Write("{}.M()) + len(S")
		b.Write(next)
		b.Write("{}.M())]int8\n")
	}
	b.Write("type S24 struct {}\nfunc (s **S24) M() [3]int8\n")
	c, _ := loadChainBni(buf.CopyStr(b.String()))
	if !errAtLine(c, 2, "undefined: M") { return fail("F's read of M is reported") }
	return ""
}
