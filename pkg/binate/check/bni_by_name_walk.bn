package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The calls of the by-name walk (check_by_name_walk.bn) that resolve a `.bni`'s
// declarations before their turn: a type (resolveBniTypeByName) resolves the constants
// its array lengths name and the types it holds by value, a constant
// (resolveBniConstByName) the constants, variables and types its initializer names, a
// variable (defineBniVarByName) the constants and variables its array lengths name, a
// function (bni_by_name_func.bn) or a method (bni_by_name_method.bn) what its signature
// reads -- each of those resolving what it names in turn.

// stepBniType runs the type's call k (resolveBniTypeByName) to its next call or its
// end.  A type being resolved further up (TypesResolving) holds itself by value, and
// is left to its own call.
func stepBniType(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		var d @ast.Decl = findBniTypeDecl(c.BniDecls, k.name)
		if d == nil || d.TypeRef == nil || len(d.TypeParams) > 0 || declInList(c.BniTypesResolved, d) {
			byNameReturn(k)
			return
		}
		var bb @BniBuild = c.BniBuild
		if declInList(bb.TypesResolving, d) {
			byNameReturn(k)
			return
		}
		k.d = d
		k.bb = bb
		bb.TypesResolving = slices.Append[@ast.Decl](bb.TypesResolving, d)
		k.deps = collectTypeExprConstDeps(d.TypeRef, k.deps)
		k.pc = byNameLoopConsts
	}
	if k.pc == byNameLoopConsts {
		for k.i < len(k.deps) {
			var dep @[]char = k.deps[k.i]
			k.i = k.i + 1
			if nameInList(k.names, dep) {
				_ = byNameCallFrom(k, byNameBniConst, dep)
				return
			}
		}
		k.tdeps = collectTypeExprNames(k.d.TypeRef, k.tdeps)
		k.i = 0
		k.pc = byNameLoopTypes
	}
	if k.pc == byNameLoopTypes {
		if k.i < len(k.tdeps) {
			var dep @[]char = k.tdeps[k.i]
			k.i = k.i + 1
			_ = byNameCallFrom(k, byNameBniType, dep)
			return
		}
		// Then what its array lengths read, in their order, where its resolution
		// reads them (check_by_name_reads.bn, pushBniReadFrom).
		if !buildingInstances(c) {
			collectTypeExprReads(c, k.d.TypeRef, &k.reads)
		}
		k.i = 0
		k.pc = byNameLoopReads
	}
	if stepBniReadsAhead(c, k) { return }
	k.bb.TypesResolving = k.bb.TypesResolving[:len(k.bb.TypesResolving) - 1]
	resolveBniTypeDecl(c, k.s, k.d)
	byNameReturn(k)
}

// stepBniConst runs the constant's call k (resolveBniConstByName) to its next call or
// its end.
func stepBniConst(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		ok, repeated := startBniConst(c, k)
		if !ok {
			byNameReturn(k)
			return
		}
		k.pc = byNameAfterRepeated
		if repeated >= 0 {
			// A bare member repeats member e's initializer, so its one dependency
			// is member e.
			_ = byNameCallFrom(k, byNameBniConst, k.d.Decls[repeated].Name)
			return
		}
	}
	if k.pc == byNameAfterRepeated {
		k.deps = collectConstDeps(k.init, k.deps)
		k.pc = byNameLoopConsts
	}
	if k.pc == byNameLoopConsts {
		if k.i < len(k.deps) {
			var dep @[]char = k.deps[k.i]
			k.i = k.i + 1
			if nameInList(k.names, dep) {
				_ = byNameCallFrom(k, byNameBniConst, dep)
			} else {
				// A `.bni` variable the initializer names (`len(Arr)`): defined
				// first, with what its array length names.
				_ = byNameCallFrom(k, byNameBniVar, dep)
			}
			return
		}
		// So is a `.bni` type it holds by value (`sizeof(S)`, `len(Row{})`), or
		// its declared type, declared later, whose layout its value needs.
		k.tdeps = collectExprTypeNames(k.init, k.tdeps)
		k.tdeps = collectTypeExprNames(bniConstTypeRef(k.d, k.member), k.tdeps)
		k.i = 0
		k.pc = byNameLoopTypes
	}
	if k.i < len(k.tdeps) {
		var dep @[]char = k.tdeps[k.i]
		k.i = k.i + 1
		_ = byNameCallFrom(k, byNameBniType, dep)
		return
	}
	finishBniConst(c, k)
	byNameReturn(k)
}

// startBniConst starts the constant's call k: it reports whether the constant is to be
// resolved -- not resolved already, nor no constant of the `.bni`'s; one being
// resolved further up is a cycle, reported once, unless the build that read it waits
// for it (bniDeclReadWaits); none is resolved inside a build that waits already -- and
// if so marks it as being resolved and finds its initializer (k.init).  For a bare
// const-group member, which repeats an earlier member's initializer, it returns that
// member's index, resolved first (else -1).
func startBniConst(c @Checker, k @byNameCall) (bool, int) {
	if nameInList(c.ConstResolved, k.name) { return false, -1 }
	var d @ast.Decl = findConstDecl(k.names, k.cdecls, k.name)
	if d == nil { return false, -1 }
	if nameInList(c.ConstResolving, k.name) {
		if bniDeclReadWaits(c, k.name) { return false, -1 }
		errConstCycle(c, constDeclOf(d, k.name).Pos, k.name)
		c.ConstResolved = slices.Append[@[]char](c.ConstResolved, k.name)
		return false, -1
	}
	if skipDemand(c) { return false, -1 }
	c.ConstResolving = slices.Append[@[]char](c.ConstResolving, k.name)
	enterBniDeclResolution(c, k.name)
	k.framed = enterDemandFrame(c)
	k.d = d
	k.init = d.Value
	if d.Kind == ast.DECL_GROUP {
		k.member = constGroupMemberIndex(d, k.name)
		var e int = constGroupExplicit(d, k.member)
		var noExpr @ast.Expr
		k.init = noExpr
		if e == k.member {
			k.init = d.Decls[k.member].Value
		} else if e >= 0 {
			return true, e
		}
	}
	return true, -1
}

// finishBniConst defines the constant of the call k, what its initializer names
// resolved, in k.s -- unless that read a layout not built yet, inside an instance's
// build (leaveDemandFrame): the definition is undone, to be made when it is next read
// -- and flushes the layout waits when a read has waited for it.
func finishBniConst(c @Checker, k @byNameCall) {
	var d @ast.Decl = k.d
	if k.member >= 0 {
		defineBniGroupMember(c, k.s, d, k.member)
	} else {
		var typ @types.Type = nil
		if d.TypeRef != nil {
			typ = resolveTypeExpr(c, d.TypeRef)
		}
		defineBniConst(c, k.s, d, typ, d.Value)
	}
	c.ConstResolving = c.ConstResolving[:len(c.ConstResolving) - 1]
	var waited bool = leaveBniDeclResolution(c)
	if leaveDemandFrame(c, k.framed) {
		k.s.Undefine(k.name)
		c.Scope.Undefine(k.name)
		ast.ClearCheckerAnnotations(constDeclOf(d, k.name))
		return
	}
	c.ConstResolved = slices.Append[@[]char](c.ConstResolved, k.name)
	if waited { flushLayoutWaits(c) }
}

// stepBniVar runs the variable's call k (defineBniVarByName, or defineBniVarDecl from
// byNameByDecl) to its next call or its end.  A variable a length in the chain of
// variables ending at it names (bniVarVisiting) is not defined again, nor is one
// defined already; none is defined inside a build that waits already.
func stepBniVar(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if bniVarVisiting(k) || k.s.LookupLocal(k.name) != nil {
			byNameReturn(k)
			return
		}
		var d @ast.Decl = findBniVarDecl(c.BniDecls, k.name)
		if d == nil {
			byNameReturn(k)
			return
		}
		k.d = d
		k.pc = byNameByDecl
	}
	if k.pc == byNameByDecl {
		if skipDemand(c) {
			byNameReturn(k)
			return
		}
		var bb @BniBuild = c.BniBuild
		k.bb = bb
		bb.VarsDefining = slices.Append[@[]char](bb.VarsDefining, k.d.Name)
		enterBniDeclResolution(c, k.d.Name)
		k.framed = enterDemandFrame(c)
		k.deps = collectTypeExprConstDeps(k.d.TypeRef, k.deps)
		k.pc = byNameLoopConsts
	}
	if k.i < len(k.deps) {
		var dep @[]char = k.deps[k.i]
		k.i = k.i + 1
		if nameInList(k.names, dep) {
			_ = byNameCallFrom(k, byNameBniConst, dep)
		} else {
			var v @byNameCall = byNameCallFrom(k, byNameBniVar, dep)
			v.chain = k.chain
		}
		return
	}
	finishBniVar(c, k)
	byNameReturn(k)
}

// bniVarVisiting reports whether the variable's call k, running, names a variable of
// the chain of variables whose array lengths named the next, ending at k: one of them
// names itself (`var A [len(A)]int`), so it is no constant, rejected as such.
func bniVarVisiting(k @byNameCall) bool {
	for j := k.chain; j < byNameDepth - 1; j++ {
		if types.CharEq(byNameCalls.Get(j).d.Name, k.name) { return true }
	}
	return false
}

// finishBniVar defines the variable of the call k, what its array lengths name
// defined, in k.s and the build scope c.Scope -- unless that read a layout not built
// yet, inside an instance's build: the definition is undone -- with the error type
// when a read of it while it was defined reported a cycle (bniVarOnDemand), and
// flushes the layout waits when a read has waited for it.
func finishBniVar(c @Checker, k @byNameCall) {
	var d @ast.Decl = k.d
	var bb @BniBuild = k.bb
	var vtyp @types.Type = resolveTypeExpr(c, d.TypeRef)
	bb.VarsDefining = bb.VarsDefining[:len(bb.VarsDefining) - 1]
	var waited bool = leaveBniDeclResolution(c)
	if leaveDemandFrame(c, k.framed) {
		ast.ClearCheckerAnnotations(d)
		return
	}
	if nameInList(bb.VarsCycled, d.Name) {
		vtyp = types.TypError()
	}
	if vtyp == nil { return }
	defineVar(k.s, d.Name, vtyp)
	defineVar(c.Scope, d.Name, vtyp)
	if waited { flushLayoutWaits(c) }
}
