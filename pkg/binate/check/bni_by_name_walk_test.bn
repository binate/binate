package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for bni_by_name_walk.bn: chains of a `.bni`'s declarations -- constants,
// variables, types -- each resolved by name after what it names, walked with no
// recursion.

// loadChainBni returns a new checker that has loaded src, a `.bni` of the package
// pkg/q, and the package's scope.
func loadChainBni(src *[]readonly char) (@Checker, @Scope) {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(src)
	c.LoadPackageInterface("pkg/q", f)
	return c, lookupPackage(c, "pkg/q")
}

// A `.bni` constant naming the first of a long chain of constants, each declared
// before the one it names, is resolved after the whole chain.
func TestDeepBniConstChain() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc("package \"pkg/q\"\n", "const C", " int = C", " + 1", byNameLevels, " int = 0\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("C0"), "C0", byNameLevels)
}

// A `.bni` variable whose array length is the length of the first of a long chain of
// variables, each declared before the one it names, is defined after the whole chain,
// with the last one's length.
func TestDeepBniVarChain() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc("package \"pkg/q\"\n", "var A", " [len(A", ")]int8", byNameLevels, " [3]int8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	var sym @Symbol = pkgScope.Lookup("A0")
	if sym == nil || sym.Type == nil || sym.Type.Kind != types.TYP_ARRAY || sym.Type.ArrayLen != 3 {
		return fail("A0 is a [3]int8")
	}
	return ""
}

// A `.bni` constant reading the size of a type whose array length is the next
// constant of a long chain alternating constants and types, each declared before what
// it names, is resolved after the whole chain (of byNameLevels / 3 * 2 of each, a
// chain longer than the constants' alone).
func TestDeepBniConstSizeofChain() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"pkg/q\"\n")
	for i := 0; i < byNameLevels / 3 * 2; i++ {
		writeLink(b, "const C", i, " uint = sizeof(T", i, ")")
		writeLink(b, "type T", i, " [C", i + 1, "]uint8")
	}
	b.Write("const C")
	b.Write(strconv.Itoa(byNameLevels / 3 * 2))
	b.Write(" uint = 1\n")
	c, pkgScope := loadChainBni(buf.CopyStr(b.String()))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("C0"), "C0", 1)
}

// byNameStructLevels is how long the test's chain of structs is: shorter than the
// constants' chains, as an importer's checks of a `.bni`'s chain of structs are
// quadratic in its length (each struct's by-value cycle check walks to the chain's
// end: checkBniValueEmbedding).
const byNameStructLevels int = 3000

// A `.bni` type reading the size of the first of a long chain of structs declared
// after it, each holding the next by value, resolves the chain, each struct after the
// next, and is reported where it reads it: the struct nests too deeply.  (The importer
// does not check the `.bni`'s declarations for depth -- its own package does -- so the
// chain stays whole, and is released a link at a time.)
func TestDeepBniStructChainNestsTooDeeply() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc("package \"pkg/q\"\ntype X struct { a [sizeof(T0)]uint8 }\n", "type T",
					" struct { n T", " }", byNameStructLevels, " struct { v int64 }\n"))
	var r testing.TestResult = ""
	if !errAtLine(c, 2, "type T0 nests too deeply: more than 1024 levels of types") {
		r = fail("the read of T0 is reported")
	}
	if pkgScope != nil { cutStructChain(pkgScope, byNameStructLevels) }
	return r
}

// cutStructChain lets go of the fields of the structs T0 .. T<n - 1> in s, first to
// last, each holding the next by value: the scope holds the next, so none is freed
// here, and none of their destructions nests in another's.
func cutStructChain(s @Scope, n int) {
	var noFields @[]@types.Field
	for i := 0; i < n; i++ {
		var sym @Symbol = s.Lookup(buf.Concat("T", strconv.Itoa(i)))
		if sym != nil && sym.Type != nil && sym.Type.Underlying != nil {
			sym.Type.Underlying.Fields = noFields
		}
	}
}
