package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/containers/table"

// bniDeclIndex indexes the declarations of the `.bni` being built (Checker.BniDecls),
// into groups, by name -- each name's first `type`, and its first `var` with a declared
// type, in the order of the file -- so a declaration is found by name in time
// independent of how many there are.  It holds the list it indexes (of), and a lookup
// builds it again when Checker.BniDecls is another list.
type bniDeclIndex struct {
	of    @[]@ast.Decl
	types @table.Table[*[]readonly char, @ast.Decl, ScopeNameHasher, ScopeNameEq]
	vars  @table.Table[*[]readonly char, @ast.Decl, ScopeNameHasher, ScopeNameEq]
}

// bniDeclIndexOf returns the index of c.BniDecls, building it when c's index is of another
// list, or c has none.
func bniDeclIndexOf(c @Checker) @bniDeclIndex {
	var x @bniDeclIndex = c.BniDeclIndex
	if x != nil && same(x.of, c.BniDecls) { return x }
	x = make(bniDeclIndex)
	x.of = c.BniDecls
	x.types = table.NewTable[*[]readonly char, @ast.Decl, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	x.vars = table.NewTable[*[]readonly char, @ast.Decl, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	indexBniDecls(x, c.BniDecls)
	c.BniDeclIndex = x
	return x
}

// indexBniDecls adds decls, into groups, to x, keeping each name's first.
func indexBniDecls(x @bniDeclIndex, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP { indexBniDecls(x, d.Decls) }
		if d.Kind == ast.DECL_TYPE && !x.types.Has(d.Name) { x.types.Put(d.Name, d) }
		if d.Kind == ast.DECL_VAR && d.TypeRef != nil && !x.vars.Has(d.Name) {
			x.vars.Put(d.Name, d)
		}
	}
}

// bniTypeDeclNamed returns the `.bni` declaration `type name ...` being built, or nil.
func bniTypeDeclNamed(c @Checker, name *[]readonly char) @ast.Decl {
	d, found := bniDeclIndexOf(c).types.Get(name)
	if !found { return nil }
	return d
}

// bniVarDeclNamed returns the `.bni` declaration `var name T` being built, or nil.
func bniVarDeclNamed(c @Checker, name *[]readonly char) @ast.Decl {
	d, found := bniDeclIndexOf(c).vars.Get(name)
	if !found { return nil }
	return d
}

// bniTypeResolved reports whether the `.bni` type declaration d was resolved before its
// turn (Checker.BniTypesResolved).
func bniTypeResolved(c @Checker, d @ast.Decl) bool {
	return c.BniTypesResolved != nil && c.BniTypesResolved.has(d)
}

// noteBniTypeResolved records that the `.bni` type declaration d is resolved.
func noteBniTypeResolved(c @Checker, d @ast.Decl) {
	if c.BniTypesResolved == nil { c.BniTypesResolved = newDeclSet() }
	c.BniTypesResolved.push(d)
}
