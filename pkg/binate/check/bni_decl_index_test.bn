package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// bniTestDecl returns a declaration of kind kind named name, with a declared type when
// typed.
func bniTestDecl(kind int, name *[]readonly char, typed bool) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = kind
	d.Name = buf.CopyStr(name)
	if typed { d.TypeRef = make(ast.TypeExpr) }
	return d
}

// A name finds its first type and its first typed variable, into groups and in order; a
// variable with no declared type is passed over; another list is indexed afresh.
func TestBniDeclIndex() testing.TestResult {
	var c @Checker = NewChecker()
	var t1 @ast.Decl = bniTestDecl(ast.DECL_TYPE, "T", false)
	var t2 @ast.Decl = bniTestDecl(ast.DECL_TYPE, "T", false)
	var untyped @ast.Decl = bniTestDecl(ast.DECL_VAR, "V", false)
	var v1 @ast.Decl = bniTestDecl(ast.DECL_VAR, "V", true)
	var v2 @ast.Decl = bniTestDecl(ast.DECL_VAR, "V", true)
	var group @ast.Decl = make(ast.Decl)
	group.Kind = ast.DECL_GROUP
	group.Decls = @[]@ast.Decl{untyped, t1, v1}
	c.BniDecls = @[]@ast.Decl{group, t2, v2}
	if !same(bniTypeDeclNamed(c, "T"), t1) || !same(bniVarDeclNamed(c, "V"), v1) {
		return fail("the group's T and typed V first")
	}
	if bniTypeDeclNamed(c, "V") != nil || bniVarDeclNamed(c, "T") != nil ||
			bniTypeDeclNamed(c, "U") != nil {
		return fail("no type V, no variable T, no U")
	}
	c.BniDecls = @[]@ast.Decl{t2}
	if !same(bniTypeDeclNamed(c, "T"), t2) || bniVarDeclNamed(c, "V") != nil {
		return fail("T alone in another list")
	}
	return ""
}

// The resolved `.bni` types are none until one is noted.
func TestBniTypeResolved() testing.TestResult {
	var c @Checker = NewChecker()
	var d @ast.Decl = make(ast.Decl)
	if bniTypeResolved(c, d) { return fail("none resolved at first") }
	noteBniTypeResolved(c, d)
	if !bniTypeResolved(c, d) || bniTypeResolved(c, make(ast.Decl)) { return fail("d alone resolved") }
	return ""
}
