package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for bni_member_read.bn: an importer building a package's scope from its
// `.bni` reads the members an array length or a constant reads — a field, a
// method, an interface's method, a composite literal's field — of the `.bni`'s
// types, declared before or after it, as a `.bn` does.

// bniConstIs3 is an importer's declarations that check cleanly when q's constant
// S is 3.
var bniConstIs3 *[]readonly char = "var a [q.S]int\nvar b [3]int = a\n"

// bniTypeNIs3 is an importer's declarations that check cleanly when q's type N's
// field a is a `[3]uint8`.
var bniTypeNIs3 *[]readonly char = "var n q.N\nvar b [3]uint8 = n.a\n"

// bniMemberCases reports "" when, for each declarations bnis[i] of package
// pkg/q's `.bni`, an importer whose declarations are mains[i] checks cleanly.
func bniMemberCases(bnis @[]*[]readonly char, mains @[]*[]readonly char) testing.TestResult {
	for i := 0; i < len(bnis); i++ {
		var c @Checker = checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", bnis[i]),
				buf.Concat(importQ, mains[i]))
		var r testing.TestResult = expectNoErrors(c)
		if len(r) > 0 { return buf.Concat(bnis[i], r) }
	}
	return ""
}

// A method of a `.bni` type — of a type declared later, through a pointer
// receiver, of a generic type's instance, one built before the method's
// declaration — is read where the `.bni`'s declarations resolve, with its
// signature's lengths, and is not put on the type, whose methods the package's
// own check collects.
func TestBniMemberReadMethod() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 7)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bnis[0] = "type T struct { x int }\nfunc (t T) M() [3]int\nvar V T\nconst S = len(V.M())\n"
	bnis[1] = "const S = len(V.M())\nvar V *T\ntype T struct { x int }\nfunc (t *T) M() [3]int\n"
	bnis[2] = "type T struct { x int }\nfunc (t *T) M() [3]int\nvar V T\nconst S = len(V.M())\n"
	bnis[3] = "type N struct { a [len(V.M())]uint8 }\nvar V T\ntype T struct { x int }\n"
			"func (t T) M() [3]int\n"
	bnis[4] = "type T struct { x int }\nfunc (t T) M() [K]int\nvar V T\nconst S = len(V.M())\n"
			"const K = 3\n"
	bnis[5] = "type Box[T any] struct { v T }\nfunc (b Box[T]) Get() [3]T { var r [3]T; return r }\n"
			"var B Box[int]\nconst S = len(B.Get())\n"
	bnis[6] = "const S = len(B.Get())\nvar B Box[int]\ntype Box[T any] struct { v T }\n"
			"func (b Box[T]) Get() [3]T { var r [3]T; return r }\n"
	for i := 0; i < len(mains); i++ {
		mains[i] = bniConstIs3
	}
	mains[3] = bniTypeNIs3
	var r testing.TestResult = bniMemberCases(bnis, mains)
	if len(r) > 0 { return r }
	var c @Checker = checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", bnis[0]), importQ)
	var t @Symbol = lookupPackage(c, "pkg/q").Lookup("T")
	if t == nil || t.Type.LookupMethod("M") != nil {
		return fail("the method read is not put on T")
	}
	return ""
}

// A field of a `.bni` type declared later is read once the type is resolved —
// a function value's call, through a variable's pointer, a type naming another,
// a named pointer type (a constant's, and a type's whose length is resolved
// before the types), a field's pointer — and so is one of a type declared
// first, and an element.
func TestBniMemberReadField() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 9)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 9)
	bnis[0] = "type N struct { a [len(V.fn())]uint8 }\nvar V T\ntype T struct { fn *func() [3]int }\n"
	bnis[1] = "const S = len(V.a)\nvar V T\ntype T struct { a [3]int }\n"
	bnis[2] = "type T struct { a [3]int }\nvar V T\nconst S = len(V.a)\n"
	bnis[3] = "var V *T\ntype T struct { a [3]int }\nconst S = len(V.a)\n"
	bnis[4] = "type T U\ntype U struct { a [3]int }\nvar V T\nconst S = len(V.a)\n"
	bnis[5] = "type T @U\nvar V T\nconst S = len(V.a)\ntype U struct { a [3]int }\n"
	bnis[6] = "const S = len(V.b.a)\nvar V T\ntype T struct { b *U }\ntype U struct { a [3]int }\n"
	bnis[7] = "var A [2][3]int\nconst S = len(A[0])\n"
	bnis[8] = "type N struct { a [len(V.a)]uint8 }\nvar V T\ntype T @U\ntype U struct { a [3]int }\n"
	for i := 0; i < len(mains); i++ {
		mains[i] = bniConstIs3
	}
	mains[0] = bniTypeNIs3
	mains[8] = bniTypeNIs3
	return bniMemberCases(bnis, mains)
}

// A method of a `.bni` interface declared later is read once the interface is
// given its methods — one it inherits from a parent declared later too — and
// so is one of an interface declared first.
func TestBniMemberReadIface() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 4)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 4)
	bnis[0] = "type N struct { a [len(I0.M())]uint8 }\nvar I0 *I\ninterface I { M() [3]int }\n"
	bnis[1] = "const S = len(I0.M())\nvar I0 *I\ninterface I { M() [3]int }\n"
	bnis[2] = "interface I { M() [3]int }\nvar I0 *I\nconst S = len(I0.M())\n"
	bnis[3] = "interface I : P { N() int }\nvar I0 *I\nconst S = len(I0.M())\n"
			"interface P { M() [3]int }\n"
	for i := 0; i < len(mains); i++ {
		mains[i] = bniConstIs3
	}
	mains[0] = bniTypeNIs3
	return bniMemberCases(bnis, mains)
}

// A composite literal of a `.bni` type declared later — a call's argument, a
// field read from it — forms a value of the type, resolved first.
func TestBniMemberReadLiteral() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 3)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 3)
	bnis[0] = "type N struct { a [len(f(T{}))]uint8 }\nfunc f(t T) [3]int\ntype T struct { x int }\n"
	bnis[1] = "type N struct { a [len(T{}.a)]uint8 }\ntype T struct { a [3]int }\n"
	bnis[2] = "const S = len(T{}.a)\ntype T struct { a [3]int }\n"
	mains[0] = bniTypeNIs3
	mains[1] = bniTypeNIs3
	mains[2] = bniConstIs3
	return bniMemberCases(bnis, mains)
}

// A member a `.bni` type declared later declares neither as a field nor as a
// method is undefined, and one read from a type or an interface while it is
// resolved is a cycle, as in a `.bn`.
func TestBniMemberReadErrors() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype N struct { a [len(V.nosuch)]uint8 }\nvar V T\n"
					"type T struct { x int }\n",
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectOneErrAt(c, 2, 26, "undefined: nosuch")
	if len(r) > 0 { return buf.Concat("absent: ", r) }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype T struct { a [len(V.b)]int; b [3]int }\nvar V T\n",
			buf.Concat(importQ, "var z int\n"))
	r = expectOneErrAt(c, 2, 26, "cyclic type definition involving `T`")
	if len(r) > 0 { return buf.Concat("field: ", r) }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ninterface I { M() [len(I0.M())]int }\nvar I0 *I\n",
			buf.Concat(importQ, "var z int\n"))
	r = expectOneErrAt(c, 2, 27, "cyclic type definition involving `I`")
	if len(r) > 0 { return buf.Concat("interface: ", r) }
	return ""
}

// An instance of a `.bni`'s generic type built for its layout while a
// declaration is resolved — a method's signature, a type, a function's, a
// variable's — whose generic's method's signature reads that declaration, is
// no cycle: it takes the methods once they are selected or every declaration
// is resolved, which an importer's declaration then selects.  A copied
// signature building an instance whose layout selects a method of the first
// one not copied yet waits for it, the copy made once every declaration is
// resolved or where a constant selects one.
func TestBniMemberReadGenericInstance() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 7)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bnis[0] = "const S = len(V.M())\nvar V T\ntype T struct { x int }\n"
			"func (t T) M() [sizeof(Box[int64])]int\ntype Box[X any] struct { a [2]X }\n"
			"func (b Box[X]) Get() [len(V.M())]X { var r [len(V.M())]X; return r }\n"
	mains[0] = "var a [q.S]int\nvar b [16]int = a\n"
	bnis[1] = "func (b Box[X]) Get() [sizeof(Z)]X { var r [sizeof(Z)]X; return r }\n"
			"type Box[X any] struct { a [2]X }\ntype Z struct { c [sizeof(Box[int64])]int }\n"
	mains[1] = "var z q.Z\nvar b [16]int = z.c\n"
	bnis[2] = "func (b Box[X]) Get() [len(F())]X { var r [len(F())]X; return r }\n"
			"type Box[X any] struct { a [2]X }\nfunc F() [sizeof(Box[int64])]int\n"
	mains[2] = "var a [len(q.F())]int\nvar b [16]int = a\n"
	bnis[3] = "func (b Box[X]) Get() [len(V)]X { var r [len(V)]X; return r }\n"
			"type Box[X any] struct { a [2]X }\nvar V [sizeof(Box[int64])]int\n"
	mains[3] = "var a [len(q.V)]int\nvar b [16]int = a\n"
	bnis[4] = "var B Box[int64]\ntype Box[X any] struct { a [2]X }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	mains[4] = "var a [len(q.B.Get())]int\nvar b [3]int = a\n"
	bnis[5] = "type Box[X any] struct { a [2]X }\nfunc (b Box[X]) H() W[X] { var w W[X]; return w }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"type W[X any] struct { a [len(V.Get())]X }\nvar V Box[int64]\n"
	mains[5] = "var a [len(q.V.H().a)]int\nvar b [3]int = a\n"
	bnis[6] = "type Box[X any] struct { a [2]X }\nfunc (b Box[X]) H() W[X] { var w W[X]; return w }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"type W[X any] struct { a [len(V.Get())]X }\nvar V Box[int64]\nconst S = len(V.H().a)\n"
	mains[6] = "var a [q.S]int\nvar b [3]int = a\n"
	return bniMemberCases(bnis, mains)
}
