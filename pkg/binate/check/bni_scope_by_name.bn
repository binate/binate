package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Declarations of a `.bni` resolved before their turn, by name, because a
// constant's initializer or an array length names them (resolveBniConstByName,
// bni_scope_const.bn, and lookupDeclOnDemand): its variables, its functions and
// its types, with the walks that find the names an initializer or a type
// expression needs.

// defineBniVarDecl defines the `.bni` variable d — an extern declaration `var X T`
// of the file being built, top-level or in a var group — in the package scope s
// (importers resolve `pkg.X`) and in the build scope c.Scope (a constant's
// `len(X)` reads it there).  What its type's array lengths name is defined
// first: a constant (constNames / constDecls, from listBniConsts) or another
// `.bni` variable, so the variable may be declared before them.  visiting holds
// the variables being defined further up, so a length naming its own variable
// (`var A [len(A)]int`) is not a constant (and is rejected as such) instead of
// recursing.  As a constant is (resolveBniConstByName), one defined inside an
// instance's build whose type reads a layout not built yet is not defined, nor
// is one inside a build that waits already; a read of it while it is defined
// waits, or is a type cycle, after which it has the error type
// (bniVarOnDemand).
func defineBniVarDecl(c @Checker, s @Scope, d @ast.Decl, constNames @[]@[]char,
		constDecls @[]@ast.Decl, visiting @[]@[]char) {
	if skipDemand(c) { return }
	var bb @BniBuild = c.BniBuild
	bb.VarsDefining = slices.Append[@[]char](bb.VarsDefining, d.Name)
	enterBniDeclResolution(c, d.Name)
	var framed bool = enterDemandFrame(c)
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	var deps @[]@[]char
	deps = collectTypeExprConstDeps(d.TypeRef, deps)
	for i := 0; i < len(deps); i++ {
		if nameInList(constNames, deps[i]) {
			resolveBniConstByName(c, s, deps[i], constNames, constDecls)
		} else {
			defineBniVarByName(c, s, deps[i], constNames, constDecls, inner)
		}
	}
	var vtyp @types.Type = resolveTypeExpr(c, d.TypeRef)
	bb.VarsDefining = bb.VarsDefining[:len(bb.VarsDefining) - 1]
	var waited bool = leaveBniDeclResolution(c)
	if leaveDemandFrame(c, framed) {
		ast.ClearCheckerAnnotations(d)
		return
	}
	if nameInList(bb.VarsCycled, d.Name) {
		vtyp = types.TypError()
	}
	if vtyp == nil { return }
	defineVar(s, d.Name, vtyp)
	defineVar(c.Scope, d.Name, vtyp)
	if waited { flushLayoutWaits(c) }
}

// bniVarOnDemand defines the `.bni`'s variable name (defineBniVarByName), read
// where the `.bni`'s declarations are in scope before it is defined — by an
// array length of a declaration resolved first, or an instance's build — and
// returns its symbol, or nil.  One read while it is being defined, by a build
// its definition started, waits for it (bniDeclReadWaits); otherwise its type
// depends on itself, which is reported once, as the batch reports it, and the
// variable has the error type, so nothing more is reported about it.
func bniVarOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var bb @BniBuild = c.BniBuild
	if bb == nil || !scopeReaches(c.Scope, bb.TempScope) {
		return nil
	}
	var d @ast.Decl = findBniVarDecl(c.BniDecls, name)
	if d == nil {
		return nil
	}
	if nameInList(bb.VarsDefining, name) {
		if bniDeclReadWaits(c, name) {
			return nil
		}
		if !nameInList(bb.VarsCycled, name) {
			reportVarTypeCycle(c, d)
			bb.VarsCycled = slices.Append[@[]char](bb.VarsCycled, buf.CopyStr(name))
		}
		defineVar(bb.TempScope, d.Name, types.TypError())
		return bb.TempScope.LookupLocal(name)
	}
	var saved bniDeclContext = enterBniDecl(c, d)
	var noVisiting @[]@[]char
	defineBniVarByName(c, bb.Scope, name, bb.ConstNames, bb.ConstDecls, noVisiting)
	leaveBniDecl(c, saved)
	return c.Scope.Lookup(name)
}

// defineBniFunc defines the `.bni`'s function d — not a method, generic or not
// — from its signature (resolveFuncDeclType), in the package scope s (importers
// resolve `pkg.F`) and in the scope the declarations resolve in (an array
// length's `len(F())` calls it there) — unless an import is bound there by its
// name, whose clash is reported (checkImportDeclCollisions) and through which
// a qualified name still resolves — marked as being defined meanwhile.  As a
// constant is (resolveBniConstByName), one defined inside an instance's build
// whose signature reads a layout not built yet is not defined, none inside a
// build that waits already, and none again while it is being defined; the
// layout waits are flushed once it is, when a read has waited for it.
func defineBniFunc(c @Checker, s @Scope, d @ast.Decl) {
	var bb @BniBuild = c.BniBuild
	if nameInList(bb.FuncsDefining, d.Name) || skipDemand(c) {
		return
	}
	bb.FuncsDefining = slices.Append[@[]char](bb.FuncsDefining, d.Name)
	enterBniDeclResolution(c, d.Name)
	var framed bool = enterDemandFrame(c)
	var ft @types.Type = resolveFuncDeclType(c, d)
	bb.FuncsDefining = bb.FuncsDefining[:len(bb.FuncsDefining) - 1]
	var waited bool = leaveBniDeclResolution(c)
	if leaveDemandFrame(c, framed) {
		ast.ClearCheckerAnnotations(d)
		return
	}
	defineFunc(s, d.Name, ft)
	var bound @Symbol = bb.TempScope.LookupLocal(d.Name)
	if bound == nil || bound.Kind != types.SYM_PKG {
		defineFunc(bb.TempScope, d.Name, ft)
	}
	if len(d.TypeParams) > 0 {
		recordGenericHome(c, d)
	}
	if waited { flushLayoutWaits(c) }
}

// bniFuncOnDemand defines the `.bni`'s function name (defineBniFunc), named
// where the `.bni`'s declarations are in scope before its turn — an array
// length's `len(f())` — and returns its symbol, or nil.  One named while its own
// signature is being resolved is not defined again: a build its definition
// started waits for it (bniDeclReadWaits), and otherwise the name is undefined.
func bniFuncOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var bb @BniBuild = c.BniBuild
	if bb == nil || !scopeReaches(c.Scope, bb.TempScope) {
		return nil
	}
	var d @ast.Decl = findBniFuncDecl(c.BniDecls, name)
	if d == nil {
		return nil
	}
	if nameInList(bb.FuncsDefining, name) {
		_ = bniDeclReadWaits(c, name)
		return nil
	}
	var saved bniDeclContext = enterBniDecl(c, d)
	defineBniFunc(c, bb.Scope, d)
	leaveBniDecl(c, saved)
	return c.Scope.Lookup(name)
}

// bniCallTyped reports whether the call e, an operand of `len` in a `.bni`
// array length or constant, is typed: its function is named — a `.bni`
// function (defineBniFunc), a generic one's instance, a variable, or another
// package's function.  A method's call is not: the `.bni`'s methods are not on
// its types while its declarations are resolved, and the length is left to the
// declaring package's check.
func bniCallTyped(c @Checker, e @ast.Expr) bool {
	if e.Kind != ast.EXPR_CALL || e.X == nil {
		return false
	}
	var f @ast.Expr = e.X
	if f.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && f.X != nil {
		f = f.X
	}
	if f.Kind == ast.EXPR_IDENT {
		return true
	}
	if f.Kind != ast.EXPR_SELECTOR || f.X == nil || f.X.Kind != ast.EXPR_IDENT {
		return false
	}
	var pkg @Symbol = c.Scope.Lookup(f.X.Name)
	return pkg != nil && pkg.Kind == types.SYM_PKG
}

// findBniFuncDecl returns the `.bni` declaration of the function name — not a
// method — among decls, or nil.
func findBniFuncDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_FUNC && d.Recv == nil && types.CharEq(d.Name, name) {
			return d
		}
	}
	return nil
}

// defineBniVarByName defines the `.bni` variable name (defineBniVarDecl) when a
// constant's initializer or another variable's array length names it before its
// own declaration is reached.  A no-op when name is no such variable, is being
// defined (visiting), or is defined already.
func defineBniVarByName(c @Checker, s @Scope, name *[]readonly char, constNames @[]@[]char,
		constDecls @[]@ast.Decl, visiting @[]@[]char) {
	if nameInList(visiting, name) || s.LookupLocal(name) != nil { return }
	var d @ast.Decl = findBniVarDecl(c.BniDecls, name)
	if d == nil { return }
	defineBniVarDecl(c, s, d, constNames, constDecls, visiting)
}

// findBniVarDecl returns the `.bni` declaration `var name T` among decls (into
// groups), or nil.
func findBniVarDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var inner @ast.Decl = findBniVarDecl(d.Decls, name)
			if inner != nil { return inner }
		}
		if d.Kind == ast.DECL_VAR && d.TypeRef != nil && types.CharEq(d.Name, name) {
			return d
		}
	}
	return nil
}

// resolveBniTypeByName resolves the `.bni` type declaration name of the file
// being built before its turn (resolveBniTypeDecl), after what its layout
// needs: the `.bni` constants its array lengths name (names / cdecls, from
// listBniConsts) and the later types it holds by value (BniTypesResolved
// records it).  A no-op when name is a generic type — each instance is built
// where it is named, and what it reads is resolved on demand then
// (bni_scope_demand.bn), or waited for while it is resolved — is no such type,
// is resolved already, or is being resolved further up (visiting: a type that
// holds itself by value).  It counts as being resolved while what it needs is
// (TypesResolving): a declaration resolved on the way that reads its layout —
// an alias `type A = [sizeof(X)]uint8` that `type X struct { b A }` holds —
// waits for it, or closes a cycle, which is reported as one (prepareBniType).
func resolveBniTypeByName(c @Checker, s @Scope, name *[]readonly char, names @[]@[]char,
		cdecls @[]@ast.Decl, visiting @[]@[]char) {
	if nameInList(visiting, name) { return }
	var d @ast.Decl = findBniTypeDecl(c.BniDecls, name)
	if d == nil || d.TypeRef == nil || len(d.TypeParams) > 0 || declInList(c.BniTypesResolved, d) {
		return
	}
	var bb @BniBuild = c.BniBuild
	if declInList(bb.TypesResolving, d) {
		return
	}
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	bb.TypesResolving = slices.Append[@ast.Decl](bb.TypesResolving, d)
	var cdeps @[]@[]char
	cdeps = collectTypeExprConstDeps(d.TypeRef, cdeps)
	for i := 0; i < len(cdeps); i++ {
		if nameInList(names, cdeps[i]) {
			resolveBniConstByName(c, s, cdeps[i], names, cdecls)
		}
	}
	var tdeps @[]@[]char
	tdeps = collectTypeExprNames(d.TypeRef, tdeps)
	for i := 0; i < len(tdeps); i++ {
		resolveBniTypeByName(c, s, tdeps[i], names, cdecls, inner)
	}
	bb.TypesResolving = bb.TypesResolving[:len(bb.TypesResolving) - 1]
	resolveBniTypeDecl(c, s, d)
}

// findBniTypeDecl returns the `.bni` declaration `type name ...` among decls
// (into groups), or nil.
func findBniTypeDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var inner @ast.Decl = findBniTypeDecl(d.Decls, name)
			if inner != nil { return inner }
		}
		if d.Kind == ast.DECL_TYPE && types.CharEq(d.Name, name) {
			return d
		}
	}
	return nil
}

// collectExprTypeNames appends the unqualified type names the type expressions
// in e hold by value (collectTypeExprNames) — a builtin's type operand
// (`sizeof(S)`), a composite literal's type — through its operands.
func collectExprTypeNames(e @ast.Expr, names @[]@[]char) @[]@[]char {
	if e == nil { return names }
	names = collectTypeExprNames(e.TypeRef, names)
	names = collectExprTypeNames(e.X, names)
	names = collectExprTypeNames(e.Y, names)
	for i := 0; i < len(e.Args); i++ {
		names = collectExprTypeNames(e.Args[i], names)
	}
	for i := 0; i < len(e.Elems); i++ {
		if e.Elems[i] != nil { names = collectExprTypeNames(e.Elems[i].Value, names) }
	}
	return names
}

// collectTypeExprNames appends the unqualified type names te holds by value,
// whose layouts its layout needs: through element and field types, not behind
// a pointer, a slice or a function value, nor through type arguments — an
// instance may hold its argument through a pointer, and the layout it does hold
// is readied, on demand, where it is read (prepareBniType).
func collectTypeExprNames(te @ast.TypeExpr, names @[]@[]char) @[]@[]char {
	if te == nil { return names }
	if te.Kind == ast.TEXPR_POINTER || te.Kind == ast.TEXPR_MANAGED || te.Kind == ast.TEXPR_SLICE ||
			te.Kind == ast.TEXPR_MANAGED_SLICE || te.Kind == ast.TEXPR_FUNC_VALUE ||
			te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		return names
	}
	if te.Kind == ast.TEXPR_NAMED && len(te.Pkg) == 0 {
		names = slices.Append[@[]char](names, te.Name)
	}
	names = collectTypeExprNames(te.Base, names)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { names = collectTypeExprNames(te.Fields[i].Type, names) }
	}
	return names
}

// collectTypeExprConstDeps appends the names the array lengths in te name
// (collectConstDeps of each length: constants and `len` operands), through
// element, field, parameter, result and type-argument types.
func collectTypeExprConstDeps(te @ast.TypeExpr, deps @[]@[]char) @[]@[]char {
	if te == nil { return deps }
	deps = collectConstDeps(te.Len, deps)
	deps = collectTypeExprConstDeps(te.Base, deps)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { deps = collectTypeExprConstDeps(te.Fields[i].Type, deps) }
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		deps = collectTypeExprConstDeps(te.ParamTypes[i], deps)
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		deps = collectTypeExprConstDeps(te.ResultTypes[i], deps)
	}
	for i := 0; i < len(te.TypeArgs); i++ {
		deps = collectTypeExprConstDeps(te.TypeArgs[i], deps)
	}
	return deps
}
