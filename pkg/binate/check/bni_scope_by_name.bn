package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Declarations of a `.bni` resolved before their turn, by name, because a
// constant's initializer or an array length names them (resolveBniConstByName,
// bni_scope_const.bn): its variables, and its types, with the walks that find
// the names an initializer or a type expression needs.

// defineBniVarDecl defines the `.bni` variable d — an extern declaration `var X T`
// of the file being built, top-level or in a var group — in the package scope s
// (importers resolve `pkg.X`) and in the build scope c.Scope (a constant's
// `len(X)` reads it there).  What its type's array lengths name is defined
// first: a constant (constNames / constDecls, from listBniConsts) or another
// `.bni` variable, so the variable may be declared before them.  visiting holds
// the variables being defined further up, so a length naming its own variable
// (`var A [len(A)]int`) is not a constant (and is rejected as such) instead of
// recursing.  As a constant is (resolveBniConstByName), one defined inside an
// instance's build whose type reads a layout not built yet is not defined, nor
// is one inside a build that waits already.
func defineBniVarDecl(c @Checker, s @Scope, d @ast.Decl, constNames @[]@[]char,
		constDecls @[]@ast.Decl, visiting @[]@[]char) {
	if skipDemand(c) { return }
	var framed bool = enterDemandFrame(c)
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	var deps @[]@[]char
	deps = collectTypeExprConstDeps(d.TypeRef, deps)
	for i := 0; i < len(deps); i++ {
		if nameInList(constNames, deps[i]) {
			resolveBniConstByName(c, s, deps[i], constNames, constDecls)
		} else {
			defineBniVarByName(c, s, deps[i], constNames, constDecls, inner)
		}
	}
	var vtyp @types.Type = resolveTypeExpr(c, d.TypeRef)
	if leaveDemandFrame(c, framed) {
		ast.ClearCheckerAnnotations(d)
		return
	}
	if vtyp == nil { return }
	defineVar(s, d.Name, vtyp)
	defineVar(c.Scope, d.Name, vtyp)
}

// defineBniVarByName defines the `.bni` variable name (defineBniVarDecl) when a
// constant's initializer or another variable's array length names it before its
// own declaration is reached.  A no-op when name is no such variable, is being
// defined (visiting), or is defined already.
func defineBniVarByName(c @Checker, s @Scope, name *[]readonly char, constNames @[]@[]char,
		constDecls @[]@ast.Decl, visiting @[]@[]char) {
	if nameInList(visiting, name) || s.LookupLocal(name) != nil { return }
	var d @ast.Decl = findBniVarDecl(c.BniDecls, name)
	if d == nil { return }
	defineBniVarDecl(c, s, d, constNames, constDecls, visiting)
}

// findBniVarDecl returns the `.bni` declaration `var name T` among decls (into
// groups), or nil.
func findBniVarDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var inner @ast.Decl = findBniVarDecl(d.Decls, name)
			if inner != nil { return inner }
		}
		if d.Kind == ast.DECL_VAR && d.TypeRef != nil && types.CharEq(d.Name, name) {
			return d
		}
	}
	return nil
}

// resolveBniTypeByName resolves the `.bni` type declaration name of the file
// being built before its turn (resolveBniTypeDecl), after what its layout
// needs: the `.bni` constants its array lengths name (names / cdecls, from
// listBniConsts) and the later types it holds by value (BniTypesResolved
// records it).  A generic type is not resolved — each instance is built where
// it is named — but the later types it holds by value are, for its instances'
// layouts.  A no-op when name is no such type, is resolved already, or is being
// resolved further up (visiting: a type that holds itself by value).
func resolveBniTypeByName(c @Checker, s @Scope, name *[]readonly char, names @[]@[]char,
		cdecls @[]@ast.Decl, visiting @[]@[]char) {
	if nameInList(visiting, name) { return }
	var d @ast.Decl = findBniTypeDecl(c.BniDecls, name)
	if d == nil || d.TypeRef == nil || declInList(c.BniTypesResolved, d) { return }
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	var cdeps @[]@[]char
	cdeps = collectTypeExprConstDeps(d.TypeRef, cdeps)
	for i := 0; i < len(cdeps); i++ {
		if nameInList(names, cdeps[i]) {
			resolveBniConstByName(c, s, cdeps[i], names, cdecls)
		}
	}
	var tdeps @[]@[]char
	tdeps = collectTypeExprNames(d.TypeRef, tdeps)
	for i := 0; i < len(tdeps); i++ {
		resolveBniTypeByName(c, s, tdeps[i], names, cdecls, inner)
	}
	if len(d.TypeParams) > 0 { return }
	resolveBniTypeDecl(c, s, d)
}

// findBniTypeDecl returns the `.bni` declaration `type name ...` among decls
// (into groups), or nil.
func findBniTypeDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var inner @ast.Decl = findBniTypeDecl(d.Decls, name)
			if inner != nil { return inner }
		}
		if d.Kind == ast.DECL_TYPE && types.CharEq(d.Name, name) {
			return d
		}
	}
	return nil
}

// collectExprTypeNames appends the unqualified type names the type expressions
// in e hold by value (collectTypeExprNames) — a builtin's type operand
// (`sizeof(S)`), a composite literal's type — through its operands.
func collectExprTypeNames(e @ast.Expr, names @[]@[]char) @[]@[]char {
	if e == nil { return names }
	names = collectTypeExprNames(e.TypeRef, names)
	names = collectExprTypeNames(e.X, names)
	names = collectExprTypeNames(e.Y, names)
	for i := 0; i < len(e.Args); i++ {
		names = collectExprTypeNames(e.Args[i], names)
	}
	for i := 0; i < len(e.Elems); i++ {
		if e.Elems[i] != nil { names = collectExprTypeNames(e.Elems[i].Value, names) }
	}
	return names
}

// collectTypeExprNames appends the unqualified type names te holds by value,
// whose layouts its layout needs: through element, field and type-argument
// types, not behind a pointer, a slice or a function value.
func collectTypeExprNames(te @ast.TypeExpr, names @[]@[]char) @[]@[]char {
	if te == nil { return names }
	if te.Kind == ast.TEXPR_POINTER || te.Kind == ast.TEXPR_MANAGED || te.Kind == ast.TEXPR_SLICE ||
			te.Kind == ast.TEXPR_MANAGED_SLICE || te.Kind == ast.TEXPR_FUNC_VALUE ||
			te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		return names
	}
	if te.Kind == ast.TEXPR_NAMED && len(te.Pkg) == 0 {
		names = slices.Append[@[]char](names, te.Name)
	}
	names = collectTypeExprNames(te.Base, names)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { names = collectTypeExprNames(te.Fields[i].Type, names) }
	}
	for i := 0; i < len(te.TypeArgs); i++ {
		names = collectTypeExprNames(te.TypeArgs[i], names)
	}
	return names
}

// collectTypeExprConstDeps appends the names the array lengths in te name
// (collectConstDeps of each length: constants and `len` operands), through
// element, field, parameter, result and type-argument types.
func collectTypeExprConstDeps(te @ast.TypeExpr, deps @[]@[]char) @[]@[]char {
	if te == nil { return deps }
	deps = collectConstDeps(te.Len, deps)
	deps = collectTypeExprConstDeps(te.Base, deps)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { deps = collectTypeExprConstDeps(te.Fields[i].Type, deps) }
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		deps = collectTypeExprConstDeps(te.ParamTypes[i], deps)
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		deps = collectTypeExprConstDeps(te.ResultTypes[i], deps)
	}
	for i := 0; i < len(te.TypeArgs); i++ {
		deps = collectTypeExprConstDeps(te.TypeArgs[i], deps)
	}
	return deps
}
