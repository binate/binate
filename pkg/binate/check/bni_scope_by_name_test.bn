package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for bni_scope_by_name.bn: the `.bni` types a constant's initializer names,
// resolved before it (resolveBniTypeByName).

// A `.bni` constant whose value is the size, alignment or length of a type the
// `.bni` declares after it has that type's layout: the type is resolved first,
// after the constants its array lengths name and the types it holds by value —
// those of a generic type's definition, for its instance — and so is a later
// declared type of the constant's own; a pointer's size needs no layout, and an
// opaque type behind one is fine.
func TestBniConstOfLaterTypeLayout() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"pkg/q\"\n"
					"const Z uint = sizeof(S)\nconst A uint = alignof(S)\nconst Z2 uint = sizeof([2]S)\n"
					"const R int = len(Row{})\nconst V uint = sizeof(W)\nconst G uint = sizeof(Box[int8])\n"
					"const K Kind = 3\nconst P uint = sizeof(*Opq)\n"
					"type S struct { x int64; y T }\ntype T struct { z int64 }\ntype Row [8]int16\n"
					"type W struct { a [N]int8; b int64 }\nconst N int = 4\n"
					"type Box[U any] struct { s S; u U }\ntype Kind int16\ntype Opq\n")
	c.LoadPackageInterface("pkg/q", f)
	var pkgScope @Scope = lookupPackage(c, "pkg/q")
	if pkgScope == nil { return fail("pkg/q scope missing") }
	var names @[]*[]readonly char = make_slice(*[]readonly char, 8)
	var want @[]int = make_slice(int, 8)
	names[0] = "Z"
	want[0] = 16
	names[1] = "A"
	want[1] = 8
	names[2] = "Z2"
	want[2] = 32
	names[3] = "R"
	want[3] = 8
	names[4] = "V"
	want[4] = 16
	names[5] = "G"
	want[5] = 24
	names[6] = "K"
	want[6] = 3
	names[7] = "P"
	want[7] = 8
	for i := 0; i < len(names); i++ {
		var sym @Symbol = pkgScope.Lookup(names[i])
		if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
			return buf.Concat(names[i], " has no value")
		}
		if !sym.CVal.N.Equals(bignum.FromInt(want[i])) {
			return buf.Concat(names[i], " has another value")
		}
	}
	return ""
}

// A type that holds itself by value — through an element, a field, a readonly
// element or an alias — is reported once, as a package's check reports it, its
// cycle broken before a `.bni` constant of its size is resolved, with no crash
// in either order and no length reported as no constant; and an opaque type's
// size in an array length is reported once, not also as a length that is no
// constant.
func TestBniConstOfLayoutlessType() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 6)
	srcs[0] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]A\n"
	srcs[1] = "package \"pkg/q\"\ntype A struct { b B }\ntype B struct { a A }\n"
			"const Z uint = sizeof(A)\n"
	srcs[2] = "package \"pkg/q\"\ntype S\ntype R struct { a [sizeof(S)]int8 }\nconst Z uint = 1\n"
	srcs[3] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]readonly A\n"
	srcs[4] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = A\n"
	srcs[5] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = [1]readonly A\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = NewChecker()
		c.LoadPackageInterface("pkg/q", mkBniFile(srcs[i]))
		var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
		if sym == nil { return buf.Concat(srcs[i], ": Z missing") }
		if i != 2 && errorsContaining(c, "recursive type") != 1 {
			return buf.Concat(srcs[i], ": the cycle should be reported once")
		}
		if errorsContaining(c, "array length must be a constant integer") != 0 {
			return buf.Concat(srcs[i], ": a length reported as no constant")
		}
	}
	return ""
}

// A `.bni` constant of the size of a type holding another many times over, which
// holds another in turn, is found walking each type once, not once per way to
// reach it: forty structs, each holding the next twice (once in an empty array),
// would take 2^40 steps.
func TestBniConstOfSharedHeldTypes() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"pkg/q\"\nconst Z uint = sizeof(T0)\n")
	for i := 0; i < 40; i++ {
		sb.Write("type T")
		stringutils.WriteInt(sb, i)
		sb.Write(" struct { a T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write("; b [0]T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write(" }\n")
	}
	sb.Write("type T40 struct { x int64 }\n")
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/q", mkBniFile(buf.CopyStr(sb.String())))
	var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
	if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
		return fail("Z should be a constant")
	}
	if !sym.CVal.N.Equals(bignum.FromInt(8)) { return fail("Z should be T40's size, 8") }
	return ""
}

// A `.bni` variable or function an array length names before its declaration
// — in a type, or in an instance's build — is defined first, and a function
// declared first is in scope there too: a call's type is the result's.
func TestBniVarOrFuncNamedEarly() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 5)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 5)
	bnis[0] = "package \"pkg/q\"\ntype Bx[T any] struct { a [len(V)]uint8; t T }\n"
			"type U struct { p *Bx[int64] }\n"
			"var V [4]int\n"
	mains[0] = "var u q.U\nvar b [4]uint8 = u.p.a\n"
	bnis[1] = "package \"pkg/q\"\ntype N struct { a [len(V)]uint8 }\nvar V [4]int\n"
	mains[1] = "var n q.N\nvar b [4]uint8 = n.a\n"
	bnis[2] = "package \"pkg/q\"\nfunc f() [6]int\ntype N struct { a [len(f())]uint8 }\n"
	mains[2] = "var n q.N\nvar b [6]uint8 = n.a\n"
	bnis[3] = "package \"pkg/q\"\ntype N struct { a [len(f())]uint8 }\nfunc f() [6]int\n"
	mains[3] = mains[2]
	bnis[4] = "package \"pkg/q\"\ntype Bx[T any] struct { a [len(f())]uint8; t T }\n"
			"type U struct { p *Bx[int64] }\n"
			"func f() [6]int\n"
	mains[4] = "var u q.U\nvar b [6]uint8 = u.p.a\n"
	for i := 0; i < len(bnis); i++ {
		var r testing.TestResult = expectNoErrors(
				checkSrcImporting("pkg/q", bnis[i], buf.Concat(importQ, mains[i])))
		if len(r) > 0 { return r }
	}
	return ""
}

// A constant whose initializer calls a `.bni` function is a constant to an
// importer — a generic function's too, whose result's length is a constant
// declared after it.
func TestBniConstCallsFunc() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst S = len(f())\n"
					"func f() [6]int\n",
			buf.Concat(importQ, "var a [q.S]int\nvar b [6]int = a\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nfunc g[T any]() [K]int { var r [K]int; return r }\nconst S = len(g[int]())\n"
					"const K = 3\n",
			buf.Concat(importQ, "var a [q.S]int\nvar b [3]int = a\n"))
	return expectNoErrors(c)
}

// A variable read while it is defined, by an instance's build its type started,
// waits for it; read in its own type, or in another variable's its type names,
// its type depends on itself, which is reported once, as in a `.bn`.
func TestBniVarReadWhileDefined() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Bx[T any] struct { a [len(V)]uint8; t T }\n"
					"var V [sizeof(W[int64])]uint8\ntype W[T any] struct { v T; p *Bx[T] }\n",
			buf.Concat(importQ, "var x q.Bx[int64]\nvar b [16]uint8 = x.a\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q", "package \"pkg/q\"\nvar V [len(V)]uint8\n",
			buf.Concat(importQ, "var z int\n"))
	r = expectOneErrAt(c, 2, 1, "variable type cycle involving `V`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q", "package \"pkg/q\"\nvar A [len(B)]int\nvar B [len(A)]int\n",
			buf.Concat(importQ, "var z int\n"))
	return expectOneErrAt(c, 2, 1, "variable type cycle involving `A`")
}

// A function named in its own signature is undefined there, as in a `.bn`; one
// whose signature reads the layout of a type being resolved, defined by an
// instance's build, waits with the build.
func TestBniFuncSignatureOnDemand() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q", "package \"pkg/q\"\nfunc f() [len(f())]int\n",
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectOneErrAt(c, 2, 15, "undefined: f")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Bx[T any] struct { a [len(g())]uint8; t T }\n"
					"type N struct { v int64; p *Bx[int64] }\nfunc g() [sizeof(N)]int\n",
			buf.Concat(importQ, "var x q.Bx[int64]\nvar b [16]uint8 = x.a\n"))
	return expectNoErrors(c)
}

// A type argument is not taken as held by value: a constant of the size of a
// type holding an instance that holds its argument through a pointer is no
// cycle with the argument's array length naming the constant -- resolved after
// the types or, named by an earlier type, before them -- and one held by value
// still has its layout.
func TestBniConstThroughTypeArgument() testing.TestResult {
	var decls *[]readonly char = "const S = sizeof(N)\ntype N struct { b Box2[M] }\n"
			"type M struct { a [S]uint8 }\ntype Box2[T any] struct { p *T }\n"
	var c @Checker = checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", decls),
			buf.Concat(importQ, "var m q.M\nvar b [8]uint8 = m.a\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			buf.Concat("package \"pkg/q\"\ntype P struct { a [S]uint8 }\n", decls),
			buf.Concat(importQ, "var m q.M\nvar b [8]uint8 = m.a\n"))
	r = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst G = sizeof(Box3[M])\ntype Box3[T any] struct { t T }\n"
					"type M struct { a [3]int64 }\n",
			buf.Concat(importQ, "var a [q.G]uint8\nvar b [24]uint8 = a\n"))
	return expectNoErrors(c)
}

// A constant whose initializer calls a method of a `.bni` type — a generic
// type's too — is no error to an importer: the call is left unchecked, its
// length to the declaring package's check (bniCallTyped).
func TestBniConstCallsMethod() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype T struct { x int }\nfunc (t T) M() [3]int\nvar V T\n"
					"const S = len(V.M())\n",
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Box[T any] struct { v T }\n"
					"func (b Box[T]) Get() [3]T { var r [3]T; return r }\nvar B Box[int]\n"
					"const S = len(B.Get())\n",
			buf.Concat(importQ, "var z int\n"))
	return expectNoErrors(c)
}

// A `.bni` function named as an import is not bound over the import where the
// `.bni`'s declarations resolve: a qualified name still selects from the package.
func TestBniFuncNamedAsImport() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/r", mkBniFile("package \"pkg/r\"\nfunc F() [2]int\n"))
	c.LoadPackageInterface("pkg/q",
			mkBniFile("package \"pkg/q\"\nimport \"pkg/r\"\nfunc r() int\nconst S = len(r.F())\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("S")
	if sym == nil || !sym.HasCVal || sym.CStat != constval.OK ||
			!sym.CVal.N.Equals(bignum.FromInt(2)) {
		return fail("S should be 2")
	}
	return ""
}
