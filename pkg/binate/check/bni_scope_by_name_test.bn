package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for bni_scope_by_name.bn: the `.bni` types a constant's initializer names,
// resolved before it (resolveBniTypeByName).

// A `.bni` constant whose value is the size, alignment or length of a type the
// `.bni` declares after it has that type's layout: the type is resolved first,
// after the constants its array lengths name and the types it holds by value —
// those of a generic type's definition, for its instance — and so is a later
// declared type of the constant's own; a pointer's size needs no layout, and an
// opaque type behind one is fine.
func TestBniConstOfLaterTypeLayout() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"pkg/q\"\n"
					"const Z uint = sizeof(S)\nconst A uint = alignof(S)\nconst Z2 uint = sizeof([2]S)\n"
					"const R int = len(Row{})\nconst V uint = sizeof(W)\nconst G uint = sizeof(Box[int8])\n"
					"const K Kind = 3\nconst P uint = sizeof(*Opq)\n"
					"type S struct { x int64; y T }\ntype T struct { z int64 }\ntype Row [8]int16\n"
					"type W struct { a [N]int8; b int64 }\nconst N int = 4\n"
					"type Box[U any] struct { s S; u U }\ntype Kind int16\ntype Opq\n")
	c.LoadPackageInterface("pkg/q", f)
	var pkgScope @Scope = lookupPackage(c, "pkg/q")
	if pkgScope == nil { return fail("pkg/q scope missing") }
	var names @[]*[]readonly char = make_slice(*[]readonly char, 8)
	var want @[]int = make_slice(int, 8)
	names[0] = "Z"
	want[0] = 16
	names[1] = "A"
	want[1] = 8
	names[2] = "Z2"
	want[2] = 32
	names[3] = "R"
	want[3] = 8
	names[4] = "V"
	want[4] = 16
	names[5] = "G"
	want[5] = 24
	names[6] = "K"
	want[6] = 3
	names[7] = "P"
	want[7] = 8
	for i := 0; i < len(names); i++ {
		var sym @Symbol = pkgScope.Lookup(names[i])
		if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
			return buf.Concat(names[i], " has no value")
		}
		if !sym.CVal.N.Equals(bignum.FromInt(want[i])) {
			return buf.Concat(names[i], " has another value")
		}
	}
	return ""
}

// A type that holds itself by value — through an element, a field, a readonly
// element or an alias — has no layout: a `.bni` constant of its size is no
// constant, with no crash in either order; and an opaque type's size in an array
// length is reported once, not also as a length that is no constant.
func TestBniConstOfLayoutlessType() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 6)
	srcs[0] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]A\n"
	srcs[1] = "package \"pkg/q\"\ntype A struct { b B }\ntype B struct { a A }\n"
			"const Z uint = sizeof(A)\n"
	srcs[2] = "package \"pkg/q\"\ntype S\ntype R struct { a [sizeof(S)]int8 }\nconst Z uint = 1\n"
	srcs[3] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]readonly A\n"
	srcs[4] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = A\n"
	srcs[5] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = [1]readonly A\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = NewChecker()
		c.LoadPackageInterface("pkg/q", mkBniFile(srcs[i]))
		var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
		if sym == nil { return buf.Concat(srcs[i], ": Z missing") }
		if i != 2 && sym.HasCVal && sym.CStat == constval.OK {
			return buf.Concat(srcs[i], ": Z should be no constant")
		}
		if errorsContaining(c, "array length must be a constant integer") != 0 {
			return buf.Concat(srcs[i], ": a length reported as no constant")
		}
	}
	return ""
}

// A `.bni` constant of the size of a type holding another many times over, which
// holds another in turn, is found walking each type once, not once per way to
// reach it: forty structs, each holding the next twice (once in an empty array),
// would take 2^40 steps.
func TestBniConstOfSharedHeldTypes() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"pkg/q\"\nconst Z uint = sizeof(T0)\n")
	for i := 0; i < 40; i++ {
		sb.Write("type T")
		stringutils.WriteInt(sb, i)
		sb.Write(" struct { a T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write("; b [0]T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write(" }\n")
	}
	sb.Write("type T40 struct { x int64 }\n")
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/q", mkBniFile(buf.CopyStr(sb.String())))
	var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
	if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
		return fail("Z should be a constant")
	}
	if !sym.CVal.N.Equals(bignum.FromInt(8)) { return fail("Z should be T40's size, 8") }
	return ""
}
