package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/constval"
import "pkg/builtins/testing"

// Tests for bni_scope_const.bn (defineBniConst): .bni const declarations and
// transitive cross-package const folding.  mkBniFile lives in bni_scope_test.bn
// (same package).

// A .bni-declared const must appear in scope as SYM_CONST.
func TestLoadPackageInterfaceConstDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\nconst MAX int = 10\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("MAX")
	if sym == nil { return fail("MAX not in foo's scope") }
	if sym.Kind != types.SYM_CONST {
		return fail("MAX should be SYM_CONST")
	}
	return ""
}

// A TRANSITIVE .bni const (`const SZ int = a.VAL`, where this .bni imports
// pkg/a) folds to the cross-package value (7) and is value-BEARING — the single
// shared checker has pkg/a's scope loaded, so the selector resolves.  This is
// the checker half of the lockstep that makes a transitive const usable as an
// array dim / shift count (IR-gen reads the stamp this fold attaches; see
// conformance 806).  Drives the real load order (pkg/a before pkg/b), not a
// pre-seeded const table.
func TestLoadPackageInterfaceTransitiveConstFolds() testing.TestResult {
	var c @Checker = NewChecker()
	var fa @ast.File = mkBniFile("package \"pkg/a\"\nconst VAL int = 7\n")
	c.LoadPackageInterface("pkg/a", fa)
	var fb @ast.File = mkBniFile("package \"pkg/b\"\nimport \"pkg/a\"\nconst SZ int = a.VAL\n")
	c.LoadPackageInterface("pkg/b", fb)

	var pkgScope @Scope = lookupPackage(c, "pkg/b")
	if pkgScope == nil { return fail("pkg/b scope missing") }
	var sym @Symbol = pkgScope.Lookup("SZ")
	if sym == nil { return fail("SZ not in pkg/b's scope") }
	if sym.Kind != types.SYM_CONST { return fail("SZ should be SYM_CONST") }
	if !sym.HasCVal || sym.CStat != constval.OK {
		return fail("SZ should be value-bearing (transitive a.VAL folded)")
	}
	if !sym.CVal.N.Equals(bignum.FromInt(7)) { return fail("SZ should fold to 7") }
	return ""
}

// A bare .bni group member whose initializer has iota in a type expression is
// evaluated on its own copy: the explicit member's array type keeps its own length
// (IR-gen reads it), and each member's value is its own.
func TestLoadPackageInterfaceIotaInTypeKeepsExplicitLength() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"const (\n\tF0 float64 = cast(float64, sizeof([iota + 1]int8))\n\tF1\n\tF2\n)\n"
					"const (\n\tS0 = sizeof([iota + 1]int8)\n\tS1\n\tS2\n)\n")
	c.LoadPackageInterface("foo", f)
	var te @ast.TypeExpr = f.Decls[0].Decls[0].Value.Args[0].TypeRef
	if !te.LenKnown || te.LenVal != 1 { return fail("F0's array length stays its own") }
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var names @[]*[]readonly char = @[]*[]readonly char{"S0", "S1", "S2"}
	for k := 0; k < 3; k++ {
		var sym @Symbol = pkgScope.Lookup(names[k])
		if sym == nil || !sym.HasCVal || sym.CStat != constval.OK { return fail("S members fold") }
		if !sym.CVal.N.Equals(bignum.FromInt(k + 1)) { return fail("each S member is its own size") }
	}
	return ""
}

// A .bni type invalid only at a bare member's iota is an error at the member, not
// in the explicit member's initializer.
func TestLoadPackageInterfaceBareTypeErrorAtMember() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\nconst (\n\tA = sizeof([2 - iota]int8)\n\tB\n\tC\n\tD\n)\n")
	c.LoadPackageInterface("foo", f)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 { return fail("exactly one error") }
	if errs[0].Pos.Line != 6 { return fail("the error is at the bare member") }
	return ""
}

// One whose type has no layout in the `.bni` (an opaque export) is no constant,
// which an importer's array length reports, not an array of length 0.
func TestBniConstOfOpaqueTypeLayout() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nimport \"pkg/q\"\nvar a [q.Z]int8\n"
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst Z uint = sizeof(S)\ntype S\n", src)
	return expectOneErr(c, "array length must be a constant integer")
}
