package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for bni_scope_const.bn (defineBniConst): .bni const declarations and
// transitive cross-package const folding.  mkBniFile lives in bni_scope_test.bn
// (same package).

// A .bni-declared const must appear in scope as SYM_CONST.
func TestLoadPackageInterfaceConstDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\nconst MAX int = 10\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("MAX")
	if sym == nil { return fail("MAX not in foo's scope") }
	if sym.Kind != types.SYM_CONST {
		return fail("MAX should be SYM_CONST")
	}
	return ""
}

// A TRANSITIVE .bni const (`const SZ int = a.VAL`, where this .bni imports
// pkg/a) folds to the cross-package value (7) and is value-BEARING — the single
// shared checker has pkg/a's scope loaded, so the selector resolves.  This is
// the checker half of the lockstep that makes a transitive const usable as an
// array dim / shift count (IR-gen reads the stamp this fold attaches; see
// conformance 806).  Drives the real load order (pkg/a before pkg/b), not a
// pre-seeded const table.
func TestLoadPackageInterfaceTransitiveConstFolds() testing.TestResult {
	var c @Checker = NewChecker()
	var fa @ast.File = mkBniFile("package \"pkg/a\"\nconst VAL int = 7\n")
	c.LoadPackageInterface("pkg/a", fa)
	var fb @ast.File = mkBniFile("package \"pkg/b\"\nimport \"pkg/a\"\nconst SZ int = a.VAL\n")
	c.LoadPackageInterface("pkg/b", fb)

	var pkgScope @Scope = lookupPackage(c, "pkg/b")
	if pkgScope == nil { return fail("pkg/b scope missing") }
	var sym @Symbol = pkgScope.Lookup("SZ")
	if sym == nil { return fail("SZ not in pkg/b's scope") }
	if sym.Kind != types.SYM_CONST { return fail("SZ should be SYM_CONST") }
	if !sym.HasCVal || sym.CStat != constval.OK {
		return fail("SZ should be value-bearing (transitive a.VAL folded)")
	}
	if !sym.CVal.N.Equals(bignum.FromInt(7)) { return fail("SZ should fold to 7") }
	return ""
}

// A bare .bni group member whose initializer has iota in a type expression is
// evaluated on its own copy: the explicit member's array type keeps its own length
// (IR-gen reads it), and each member's value is its own.
func TestLoadPackageInterfaceIotaInTypeKeepsExplicitLength() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"const (\n\tF0 float64 = cast(float64, sizeof([iota + 1]int8))\n\tF1\n\tF2\n)\n"
					"const (\n\tS0 = sizeof([iota + 1]int8)\n\tS1\n\tS2\n)\n")
	c.LoadPackageInterface("foo", f)
	var te @ast.TypeExpr = f.Decls[0].Decls[0].Value.Args[0].TypeRef
	if !te.LenKnown || te.LenVal != 1 { return fail("F0's array length stays its own") }
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var names @[]*[]readonly char = @[]*[]readonly char{"S0", "S1", "S2"}
	for k := 0; k < 3; k++ {
		var sym @Symbol = pkgScope.Lookup(names[k])
		if sym == nil || !sym.HasCVal || sym.CStat != constval.OK { return fail("S members fold") }
		if !sym.CVal.N.Equals(bignum.FromInt(k + 1)) { return fail("each S member is its own size") }
	}
	return ""
}

// A .bni type invalid only at a bare member's iota is an error at the member, not
// in the explicit member's initializer.
func TestLoadPackageInterfaceBareTypeErrorAtMember() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\nconst (\n\tA = sizeof([2 - iota]int8)\n\tB\n\tC\n\tD\n)\n")
	c.LoadPackageInterface("foo", f)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 { return fail("exactly one error") }
	if errs[0].Pos.Line != 6 { return fail("the error is at the bare member") }
	return ""
}

// A `.bni` constant whose value is the size, alignment or length of a type the
// `.bni` declares after it has that type's layout: the type is resolved first,
// after the constants its array lengths name and the types it holds by value —
// those of a generic type's definition, for its instance — and so is a later
// declared type of the constant's own; a pointer's size needs no layout, and an
// opaque type behind one is fine.
func TestBniConstOfLaterTypeLayout() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"pkg/q\"\n"
					"const Z uint = sizeof(S)\nconst A uint = alignof(S)\nconst Z2 uint = sizeof([2]S)\n"
					"const R int = len(Row{})\nconst V uint = sizeof(W)\nconst G uint = sizeof(Box[int8])\n"
					"const K Kind = 3\nconst P uint = sizeof(*Opq)\n"
					"type S struct { x int64; y T }\ntype T struct { z int64 }\ntype Row [8]int16\n"
					"type W struct { a [N]int8; b int64 }\nconst N int = 4\n"
					"type Box[U any] struct { s S; u U }\ntype Kind int16\ntype Opq\n")
	c.LoadPackageInterface("pkg/q", f)
	var pkgScope @Scope = lookupPackage(c, "pkg/q")
	if pkgScope == nil { return fail("pkg/q scope missing") }
	var names @[]*[]readonly char = make_slice(*[]readonly char, 8)
	var want @[]int = make_slice(int, 8)
	names[0] = "Z"
	want[0] = 16
	names[1] = "A"
	want[1] = 8
	names[2] = "Z2"
	want[2] = 32
	names[3] = "R"
	want[3] = 8
	names[4] = "V"
	want[4] = 16
	names[5] = "G"
	want[5] = 24
	names[6] = "K"
	want[6] = 3
	names[7] = "P"
	want[7] = 8
	for i := 0; i < len(names); i++ {
		var sym @Symbol = pkgScope.Lookup(names[i])
		if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
			return buf.Concat(names[i], " has no value")
		}
		if !sym.CVal.N.Equals(bignum.FromInt(want[i])) {
			return buf.Concat(names[i], " has another value")
		}
	}
	return ""
}

// One whose type has no layout in the `.bni` (an opaque export) is no constant,
// which an importer's array length reports, not an array of length 0.
func TestBniConstOfOpaqueTypeLayout() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nimport \"pkg/q\"\nvar a [q.Z]int8\n"
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst Z uint = sizeof(S)\ntype S\n", src)
	return expectOneErr(c, "array length must be a constant integer")
}

// A type that holds itself by value — through an element, a field, a readonly
// element or an alias — has no layout: a `.bni` constant of its size is no
// constant, with no crash in either order; and an opaque type's size in an array
// length is reported once, not also as a length that is no constant.
func TestBniConstOfLayoutlessType() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 6)
	srcs[0] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]A\n"
	srcs[1] = "package \"pkg/q\"\ntype A struct { b B }\ntype B struct { a A }\n"
			"const Z uint = sizeof(A)\n"
	srcs[2] = "package \"pkg/q\"\ntype S\ntype R struct { a [sizeof(S)]int8 }\nconst Z uint = 1\n"
	srcs[3] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]readonly A\n"
	srcs[4] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = A\n"
	srcs[5] = "package \"pkg/q\"\nconst Z uint = sizeof(A)\ntype A [2]B\ntype B = [1]readonly A\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = NewChecker()
		c.LoadPackageInterface("pkg/q", mkBniFile(srcs[i]))
		var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
		if sym == nil { return buf.Concat(srcs[i], ": Z missing") }
		if i != 2 && sym.HasCVal && sym.CStat == constval.OK {
			return buf.Concat(srcs[i], ": Z should be no constant")
		}
		if errorsContaining(c, "array length must be a constant integer") != 0 {
			return buf.Concat(srcs[i], ": a length reported as no constant")
		}
	}
	return ""
}

// A `.bni` constant of the size of a type holding another many times over, which
// holds another in turn, is found walking each type once, not once per way to
// reach it: forty structs, each holding the next twice (once in an empty array),
// would take 2^40 steps.
func TestBniConstOfSharedHeldTypes() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"pkg/q\"\nconst Z uint = sizeof(T0)\n")
	for i := 0; i < 40; i++ {
		sb.Write("type T")
		stringutils.WriteInt(sb, i)
		sb.Write(" struct { a T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write("; b [0]T")
		stringutils.WriteInt(sb, i + 1)
		sb.Write(" }\n")
	}
	sb.Write("type T40 struct { x int64 }\n")
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/q", mkBniFile(buf.CopyStr(sb.String())))
	var sym @Symbol = lookupPackage(c, "pkg/q").Lookup("Z")
	if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
		return fail("Z should be a constant")
	}
	if !sym.CVal.N.Equals(bignum.FromInt(8)) { return fail("Z should be T40's size, 8") }
	return ""
}
