package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// resolveBniDecls resolves the declarations decls of the `.bni` whose package
// scope is s (buildScopeFromFile's pass 2), whose constants are constNames /
// constDecls (listBniConsts), in the batch's order (collectDecls,
// finishDeclBatch): its types, interfaces, functions and variables first, in
// their order — a constant they name is resolved when it is named
// (resolveBniConstByName) — then, once each type holding itself by value is
// reported in declaration order (checkBniValueEmbedding), its constants.  So a
// constant may take the layout of any of its types, and a cycle is reported as
// a `.bn`'s.
func resolveBniDecls(c @Checker, s @Scope, decls @[]@ast.Decl, constNames @[]@[]char,
		constDecls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				resolveBniDecl(c, s, d.Decls[j], constNames, constDecls)
			}
		} else {
			resolveBniDecl(c, s, d, constNames, constDecls)
		}
	}
	checkBniValueEmbedding(c, s, decls)
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_CONST {
			resolveBniConstByName(c, s, d.Name, constNames, constDecls)
		}
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				if d.Decls[j].Kind == ast.DECL_CONST {
					resolveBniConstByName(c, s, d.Decls[j].Name, constNames, constDecls)
				}
			}
		}
	}
}

// resolveBniDecl resolves the `.bni` declaration d — a top-level one or a group
// member — that is no constant (resolveBniDecls).
func resolveBniDecl(c @Checker, s @Scope, d @ast.Decl, constNames @[]@[]char,
		constDecls @[]@ast.Decl) {
	// Skip generic decls — they're stashed in
	// c.GenericDecls / GenericTypeDecls / GenericIfaceDecls
	// in Pass 1 (struct/iface) or here below (funcs).  Their
	// signatures / bodies can't be resolved at decl-load time
	// because the type-params are unbound.
	if (d.Kind == ast.DECL_TYPE || d.Kind == ast.DECL_INTERFACE) && len(d.TypeParams) > 0 {
		return
	}
	if d.Kind == ast.DECL_FUNC {
		// A method (DECL_FUNC with a receiver) belongs to its receiver
		// type's method set, not the package value-namespace.  Registering
		// it as a package-scope func would shadow a same-named free
		// function — e.g. a `func (f *File) Stat()` method clobbering a free
		// `func Stat(...)`, which then fails .bni↔.bn signature matching
		// (the free .bn func gets compared against the method's signature).
		// collectDeclNames skips methods for the same reason.
		if d.Recv != nil && receiverBaseInstantiation(d.Recv.Type) != nil {
			// Generic-receiver method on an imported generic type: no
			// consumer-scope placeholder exists to attach it to (unlike a
			// local generic type's), so stash it (with its defining package)
			// for resolution with concrete args at each instantiation site —
			// see copyPlaceholderMethods.  Its body rides the decl, as a
			// generic function's does.
			recordGenericMethod(c, d)
		} else if d.Recv == nil {
			defineBniFunc(c, s, d)
		}
	}
	// A `.bni` `var X T` — top-level or a group member (`var ( X int; Y int )`)
	// — is an extern declaration (storage defined in the package's `.bn`).  It
	// must carry an explicit type — there is no initializer to infer from.
	// Defined as SYM_VAR so importers resolve `pkg.X` and the defining package
	// can cross-check its `.bn` definition against this declaration
	// (checkBniVarMatch).
	if d.Kind == ast.DECL_VAR && d.TypeRef != nil {
		var noVisiting @[]@[]char
		defineBniVarDecl(c, s, d, constNames, constDecls, noVisiting)
	}
	if d.Kind == ast.DECL_TYPE && !declInList(c.BniTypesResolved, d) {
		resolveBniTypeDecl(c, s, d)
	}
	if d.Kind == ast.DECL_INTERFACE {
		resolveInterfaceDeclInScope(c, s, d)
	}
}

// checkBniValueEmbedding reports each of the `.bni`'s types decls declare that
// holds itself by value, in declaration order, and breaks the cycle
// (checkTypeByValueCycle) — as checkDecls does a package's, before its
// constants, which then read layouts with no cycle.  One already reported, as
// a layout read while the types were resolved found it (prepareBniType), is
// broken already.
func checkBniValueEmbedding(c @Checker, s @Scope, decls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			checkBniValueEmbedding(c, s, d.Decls)
			continue
		}
		if d.Kind != ast.DECL_TYPE || d.IsAlias || d.IsForward || len(d.TypeParams) > 0 ||
				isBlank(d.Name) {
			continue
		}
		var sym @Symbol = s.LookupLocal(d.Name)
		if sym == nil || sym.Type == nil || sym.Type.Kind != types.TYP_NAMED {
			continue
		}
		if sym.Type.Underlying != nil {
			checkTypeByValueCycle(c, sym.Type, d)
		}
	}
}
