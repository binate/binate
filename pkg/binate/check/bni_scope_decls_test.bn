package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for bni_scope_decls.bn: a `.bni`'s declarations resolved in the batch's
// order, so a cycle is reported as a `.bn`'s — once, and where the `.bn`
// reports it.

// A type holding itself by value is reported in declaration order before the
// constants are resolved (checkBniValueEmbedding) — at C, though a later
// constant takes C's size — and, when an instance's build reads a constant
// while the types are resolved, where that read's walk finds it — at D — with
// no length that is no constant reported beside it.
func TestBniDeclsValueCycleReportedOnce() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype C struct { d D }\ntype D struct { c C }\nconst S = sizeof(C)\n",
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectOneErrAt(c, 2, 1, "recursive type")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Bx[T any] struct { a [S]uint8; t T }\ntype C struct { d D }\n"
					"type D struct { c C }\ntype N struct { v int64; p *Bx[int64] }\n"
					"const S = sizeof(N) + sizeof(C)\n",
			buf.Concat(importQ, "var n q.N\n"))
	return expectOneErrAt(c, 4, 1, "recursive type")
}

// A constant whose initializer takes the size of a type that names it — in a
// pointer's array length, or an instance's — is a cycle of the type, reported
// once, at the size: no constant cycle or length that is no constant beside it.
func TestBniDeclsConstTypeCycleReportedOnce() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst S = sizeof(X)\ntype X struct { v int64; p *([S]uint8) }\n",
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectOneErrAt(c, 2, 18, "cyclic type definition involving `X`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/lib", buf.Concat(bniLibBx, "const S = sizeof(Bx[int64])\n"),
			buf.Concat(importLib, "var z int\n"))
	return expectOneErrAt(c, 3, 20, "cyclic type definition involving `Bx`")
}

// An alias whose array length takes the size of the type holding it is a cycle
// of that type, reported once at the size, when the type is resolved first — by
// an instance's build or in its turn — and a recursive alias when the alias is.
func TestBniDeclsAliasCycleReportedOnce() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type N struct { v int64; next *Box[X] }\ntype X struct { b A }\ntype A = [sizeof(X)]uint8\n"),
			buf.Concat(importQ, "var z int\n"))
	var r testing.TestResult = expectOneErrAt(c, 5, 18, "cyclic type definition involving `X`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type U struct { p *Box[B] }\ntype A = [sizeof(B)]uint8\n"
							"type B struct { a A }\n"), buf.Concat(importQ, "var z int\n"))
	r = expectOneErrAt(c, 4, 18, "cyclic type definition involving `B`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype B struct { a A }\n"
					"type A = [sizeof(B)]uint8\n",
			buf.Concat(importQ, "var z int\n"))
	r = expectOneErrAt(c, 3, 18, "cyclic type definition involving `B`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype A = [sizeof(B)]uint8\n"
					"type B struct { a A }\n",
			buf.Concat(importQ, "var z int\n"))
	return expectOneErrAt(c, 3, 19, "invalid recursive type alias A")
}
