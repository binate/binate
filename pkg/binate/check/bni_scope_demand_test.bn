package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for bni_scope_demand.bn: a `.bni` type or constant an instance's build
// reads before the `.bni`'s order reaches it.  Each importer assigns an array
// whose length a build read to one of the length it should have, which is an
// error for any other length.

// bniQBox opens package pkg/q's `.bni` with a generic type whose length is its
// argument's size.
var bniQBox *[]readonly char = "package \"pkg/q\"\ntype Box[T any] struct { a [sizeof(T)]uint8 }\n"

// bniLibBx opens package pkg/lib's `.bni` with a generic type whose length is
// its constant S.
var bniLibBx *[]readonly char = "package \"pkg/lib\"\ntype Bx[T any] struct { a [S]uint8; t T }\n"

// importQ opens an importer of pkg/q.
var importQ *[]readonly char = "package \"main\"\nimport \"pkg/q\"\n"

// importLib opens an importer of pkg/lib.
var importLib *[]readonly char = "package \"main\"\nimport \"pkg/lib\"\n"

// libXAndA is an importer's check that Bx[int64]'s array and the alias A are
// 16 bytes long.
var libXAndA *[]readonly char = "var x lib.Bx[int64]\nvar b [16]uint8 = x.a\nvar y lib.A\n"
		"var z [16]uint8 = y\n"

// An instance's `sizeof` of a type the `.bni` declares after the type that
// names the instance resolves it first.
func TestBniInstanceReadsLaterType() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox, "type N struct { v int64; p *Box[M] }\ntype M struct { a [3]int64 }\n"),
			buf.Concat(importQ, "var n q.N\nvar b [24]uint8 = n.p.a\n"))
	return expectNoErrors(c)
}

// One of the type being resolved, which names the instance through a pointer,
// waits for it; so does a constant's size of the instance.
func TestBniInstanceReadsTypeBeingResolved() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox, "type N struct { v int64; next *Box[N] }\nconst Z = sizeof(Box[N])\n"),
			buf.Concat(importQ, "var n q.N\nvar b [16]uint8 = n.next.a\nvar z [q.Z]uint8 = b\n"))
	return expectNoErrors(c)
}

// One of a slice of the type being resolved reaches the type softly: it is no
// opaque type, and the slice has its layout.
func TestBniInstanceReadsTypeBeingResolvedSoftly() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox, "type N struct { v int64; next *Box[*[]N] }\n"),
			buf.Concat(importQ, "var n q.N\nvar b [16]uint8 = n.next.a\n"))
	return expectNoErrors(c)
}

// A type resolved on demand that reads the layout of the type being resolved
// waits with the instance, and is resolved again when it is built again.
func TestBniInstanceReadsTypeReadingOneBeingResolved() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type N struct { v int64; p *Box[X] }\ntype X struct { a [sizeof(N)]uint8 }\n"),
			buf.Concat(importQ, "var n q.N\nvar b [16]uint8 = n.p.a\nvar x q.X\nvar e [16]uint8 = x.a\n"))
	return expectNoErrors(c)
}

// An instance's array length naming a constant the `.bni` declares after the
// type that names the instance defines it first.
func TestBniInstanceReadsLaterConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			buf.Concat(bniLibBx, "type U struct { p *Bx[int64] }\nconst S = 5\n"),
			buf.Concat(importLib, "var u lib.U\nvar b [5]uint8 = u.p.a\n"))
	return expectNoErrors(c)
}

// One naming the constant being resolved, whose value builds the instance
// through a pointer, waits for it.
func TestBniInstanceReadsConstBeingResolved() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			buf.Concat(bniLibBx, "const S = sizeof(W[int64])\ntype W[T any] struct { v T; p *Bx[T] }\n"),
			buf.Concat(importLib, "var x lib.Bx[int64]\nvar b [16]uint8 = x.a\nvar s [lib.S]uint8 = b\n"))
	return expectNoErrors(c)
}

// A constant defined on demand whose value reads the layout of the type being
// resolved waits with the instance, and is defined again when it is built
// again.
func TestBniInstanceReadsConstReadingTypeBeingResolved() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			buf.Concat(bniLibBx, "type U struct { p *Bx[int64] }\nconst S = sizeof(U)\n"),
			buf.Concat(importLib, "var u lib.U\nvar b [8]uint8 = u.p.a\nvar s [lib.S]uint8 = b\n"))
	return expectNoErrors(c)
}

// So does a variable or an alias the constant's initializer names, defined on
// the way: neither keeps the length it could not read.
func TestBniInstanceReadsConstThroughVarOrAlias() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			buf.Concat(bniLibBx,
					"type N struct { v int64; p *Bx[int64] }\nconst S = len(V)\nvar V [sizeof(N)]uint8\n"),
			buf.Concat(importLib,
					"var x lib.Bx[int64]\nvar b [16]uint8 = x.a\nvar s [lib.S]uint8 = b\n"
							"var v [16]uint8 = lib.V\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/lib",
			buf.Concat(bniLibBx,
					"type N struct { v int64; p *Bx[int64] }\nconst S = sizeof(A)\ntype A = [sizeof(N)]uint8\n"),
			buf.Concat(importLib, libXAndA))
	return expectNoErrors(c)
}

// So does an alias named before its declaration, resolved on demand by the
// build (check_pending_alias.bn).
func TestBniInstanceReadsPendingAlias() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			"package \"pkg/lib\"\ntype Bx[T any] struct { a [sizeof(A)]uint8; t T }\n"
					"type N struct { v int64; p *Bx[int64] }\ntype A = [sizeof(N)]uint8\n",
			buf.Concat(importLib, libXAndA))
	return expectNoErrors(c)
}

// A constant defined on demand by the build whose initializer names the
// constant being resolved waits for it too, rather than reporting a cycle.
func TestBniInstanceReadsConstNamingOneBeingResolved() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			"package \"pkg/lib\"\ntype Bx[T any] struct { a [S2]uint8; t T }\n"
					"const S = sizeof(W[int64])\ntype W[T any] struct { v T; p *Bx[T] }\n"
					"const S2 = S + 1\n",
			buf.Concat(importLib, "var x lib.Bx[int64]\nvar b [17]uint8 = x.a\n"))
	return expectNoErrors(c)
}

// A flush made while a type is still being resolved — once a constant its
// declaration names, whose value an instance's build waited for, is defined —
// leaves the instance that waits for the type waiting: no cycle is reported.
func TestBniInstanceWaitsThroughFlush() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type N struct { next *Box[N]; a [K]uint8 }\nconst K = sizeof(W2[int64])\n"
							"type W2[T any] struct { v T; p *Bx2[T] }\n"
							"type Bx2[T any] struct { a [K]uint8; t T }\n"),
			buf.Concat(importQ,
					"var n q.N\nvar b [24]uint8 = n.next.a\nvar x q.Bx2[int64]\nvar k [16]uint8 = x.a\n"))
	return expectNoErrors(c)
}

// A constant declared later is defined first where an array length names it
// outside an instance too: in a type, and in the signature of a generic
// function a constant's initializer instantiates, or of a generic method.
func TestBniDeclReadsLaterConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype N struct { a [S]uint8 }\nconst S = 5\n",
			buf.Concat(importQ, "var n q.N\nvar b [5]uint8 = n.a\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nfunc f[T any]() [K]int { var r [K]int; return r }\n"
					"const S = len(f[int]())\nconst K = 3\n",
			buf.Concat(importQ, "var b [3]int = q.f[int]()\n"))
	r = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype H[T any] struct { v T }\n"
					"func (h *H[T]) m() [S]int { var r [S]int; return r }\n"
					"type U struct { p *H[int64] }\nconst S = 3\n",
			buf.Concat(importQ, "var h q.H[int64]\nvar b [3]int = h.m()\n"))
	return expectNoErrors(c)
}

// A type that holds by value the instance whose length is its size is a cycle,
// reported once, as is one through a type resolved on demand that holds the
// type resolving it; a type holding itself by value is reported, not laid out —
// also when its size is read inside a build that waits, which is done again;
// an opaque type's size is still reported as one.
func TestBniInstanceReadsTypeCycle() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox, "type N struct { v int64; b Box[N] }\n"), buf.Concat(importQ, "var n q.N\n"))
	var r testing.TestResult = expectOneErr(c, "cyclic type definition involving `N`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type N struct { v int64; p *Box[M] }\ntype M struct { b [sizeof(X)]uint8 }\n"
							"type X struct { m M }\n"), buf.Concat(importQ, "var n q.N\n"))
	r = expectOneErr(c, "cyclic type definition involving `M`")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox,
					"type N struct { v int64; p *Box[A] }\ntype A struct { b B }\ntype B struct { a A }\n"),
			buf.Concat(importQ, "var n q.N\n"))
	r = expectOneErr(c, "recursive type")
	if len(r) > 0 { return r }
	r = expectBniHeldCycleOnce(buf.CopyStr("pkg/q"),
			buf.Concat(bniQBox,
					"type C struct { c C }\ntype N struct { v int64; p *Box[X] }\n"
							"type X struct { a [sizeof(N)]uint8; b [sizeof(C)]uint8 }\n"),
			buf.Concat(importQ, "var x q.X\n"))
	if len(r) > 0 { return r }
	r = expectBniHeldCycleOnce(buf.CopyStr("pkg/lib"),
			buf.Concat(bniLibBx,
					"type C struct { d D }\ntype D struct { c C }\ntype N struct { v int64; p *Bx[int64] }\n"
							"const S = len(V)\nvar V [sizeof(N) + sizeof(C)]uint8\n"),
			buf.Concat(importLib, "var x lib.Bx[int64]\n"))
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q",
			buf.Concat(bniQBox, "type N struct { v int64; p *Box[O] }\ntype O\n"),
			buf.Concat(importQ, "var n q.N\n"))
	return expectOneErr(c, "cannot take sizeof/alignof of an opaque type")
}

// expectBniHeldCycleOnce checks that importing package pkg, of the `.bni` bni,
// into main reports one "recursive type" error.
func expectBniHeldCycleOnce(pkg @[]char, bni *[]readonly char,
		main *[]readonly char) testing.TestResult {
	return expectOneErr(checkSrcImporting(pkg, bni, main), "recursive type")
}
