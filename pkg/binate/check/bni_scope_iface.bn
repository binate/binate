package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// Interface declarations of a `.bni`: Pass 1 of the interface-scope build
// pre-registers each (non-generic, non-alias) interface with an empty method
// set, Pass 2 fills its methods (resolveInterfaceDeclInScope), and Pass 3
// resolves the extension clauses (resolveBniInterfaceParents).

// resolveInterfaceDeclInScope populates the methods of an interface
// pre-registered by Pass 1 (its parents are resolved in Pass 3), or registers
// the alias for an alias-form `interface X = Y` declaration.  Mirrors
// collectInterfaceDecl in check_interface.bn but writes into the bni's package
// scope `s` alongside the temp checker scope `c.Scope`.
func resolveInterfaceDeclInScope(c @Checker, s @Scope, d @ast.Decl) {
	if d.IsAlias {
		if d.TypeRef == nil || !beginAliasDecl(c, d) { return }
		var target @types.Type = resolveTypeExprAllowInterface(c, d.TypeRef)
		if target != nil && target.Kind == types.TYP_INTERFACE {
			defineInterface(s, d.Name, target)
			defineInterface(c.Scope, d.Name, target)
		}
		endAliasDecl(c, d)
		return
	}
	var sym @Symbol = s.Lookup(d.Name)
	if sym == nil || sym.Kind != types.SYM_INTERFACE { return }
	var iface @types.Type = sym.Type
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC { continue }
		// `Self` is valid in method arg/result types only.
		// Mirrors the AllowSelf gate in check_interface.bn so
		// .bni-declared interfaces (e.g., pkg/builtins/lang's Comparable
		// with `Compare(other Self) int`) resolve cleanly.
		var prevAllowSelf bool = c.AllowSelf
		c.AllowSelf = true
		var ft @types.Type = resolveFuncDeclType(c, m)
		c.AllowSelf = prevAllowSelf
		var method @types.Method = MakeMethod(m.Name, iface, ft)
		iface.AddMethod(method)
	}
	// The extension clause is resolved in Pass 3, once every interface of the
	// file has its methods.
}

// resolveBniInterfaceParents resolves every interface's extension clause in
// the `.bni` file f — after Pass 2 has given each its methods, so a parent may
// be declared after its child and the method-conflict check walks the parents'
// methods.
func resolveBniInterfaceParents(c @Checker, s @Scope, f @ast.File) {
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if d.Kind != ast.DECL_INTERFACE || d.IsAlias || len(d.TypeParams) > 0 { continue }
		if isBlank(d.Name) {
			checkBlankBniInterface(c, d)
			continue
		}
		var sym @Symbol = s.Lookup(d.Name)
		if sym == nil || sym.Kind != types.SYM_INTERFACE { continue }
		resolveInterfaceExtension(c, d, sym.Type)
	}
}

// checkBlankBniInterface checks a blank `interface _ { … }` declared in a .bni:
// it binds and exports nothing, but its method signatures and extension clause
// are still checked — against a fresh interface type, after every name the
// .bni declares is in scope.  (A package with a .bn also checks its .bni's
// blank interfaces through the merged file; a .bni-only package is checked only
// here.)
func checkBlankBniInterface(c @Checker, d @ast.Decl) {
	var iface @types.Type = types.MakeInterfaceType(buf.CopyStr(c.curPkgPath), d.Name)
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC { continue }
		var prevAllowSelf bool = c.AllowSelf
		c.AllowSelf = true
		var ft @types.Type = resolveFuncDeclType(c, m)
		c.AllowSelf = prevAllowSelf
		iface.AddMethod(MakeMethod(m.Name, iface, ft))
	}
	resolveInterfaceExtension(c, d, iface)
}
