package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for bni_scope_iface.bn: a `.bni` interface's extension clause is
// resolved after every interface of the file has its methods.

// A parent declared after its child is recorded, and the child's full method
// set includes the parent's.
func TestLoadPackageInterfaceForwardParent() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"interface A : B { a() int }\n"
					"interface B { b() int }\n")
	c.LoadPackageInterface("foo", f)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("package scope for foo not found") }
	var sym @Symbol = pkgScope.Lookup("A")
	if sym == nil || sym.Kind != types.SYM_INTERFACE { return fail("A should be an interface") }
	if len(sym.Type.Parents) != 1 || !types.CharEq(sym.Type.Parents[0].Name, "B") {
		return fail("A's parent should be B")
	}
	if len(sym.Type.Parents[0].Methods) != 1 { return fail("B should have its method") }
	return ""
}

// An extension cycle is reported (and its back-edge dropped) instead of
// looping.
func TestLoadPackageInterfaceExtensionCycle() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"interface A : B { a() int }\n"
					"interface B : A { b() int }\n")
	c.LoadPackageInterface("foo", f)
	return expectErrSub(c, "interface extension cycle")
}
