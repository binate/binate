package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// A package's interface (.bni) must make sense without its .bn: a package can
// ship as its interface plus a compiled library (§16.5.1).  So a .bni
// declaration resolves as a program that has only the interface sees it
// (pkg.bni.self-contained) — the interface's own names, its imports and the
// universe, not the .bn's private declarations.  The .bni's file scope sees the
// package scope only through its ParentNames filter (buildFileScopes); a generic
// type, found by name in the generic stash rather than through a scope, is held
// to the same view here.

// inBniView reports whether c resolves names in the package interface's view:
// its scope is, or is inside, the .bni's file scope or the scope the interface
// was built in (Scope.InterfaceView).
func inBniView(c @Checker) bool {
	var s @Scope = c.Scope
	for s != nil {
		if s.InterfaceView { return true }
		s = s.Parent
	}
	return false
}

// bniViewNames returns the names the package interface bni declares, for its
// file scope's ParentNames: its scope iface's symbols, less the members an
// `expose` injected (HomePkg set: an expose extends only the surface, not the
// package's own scope — pkg.expose.surface), and the generic types it declares,
// which iface does not bind (they are found by name, lookupGenericHead) — so
// that a bare use of one reaches the package scope's placeholder and is reported
// as a generic type used without type arguments.  A generic interface has no
// package-scope binding to reach, so a bare use of one is undefined, in a .bni as
// in a .bn.
func bniViewNames(iface @Scope, bni @ast.File) @Scope {
	var names @Scope = NewScope(nil)
	for i := 0; i < len(iface.Syms); i++ {
		if len(iface.Syms[i].HomePkg) == 0 { names.Define(iface.Syms[i]) }
	}
	defineGenericTypeNames(names, bni.Decls)
	return names
}

// defineGenericTypeNames defines in names a placeholder for each generic type
// declaration of decls, groups included.
func defineGenericTypeNames(names @Scope, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			defineGenericTypeNames(names, d.Decls)
			continue
		}
		if d.Kind == ast.DECL_TYPE && len(d.TypeParams) > 0 {
			var sym @Symbol = make(Symbol)
			sym.Name = buf.CopyStr(d.Name)
			sym.Kind = types.SYM_TYPE
			names.Define(sym)
		}
	}
}

// hiddenFromBniView reports whether the generic declaration d, found by an
// unqualified name, is one the package interface cannot see: c resolves in the
// interface's view and d is declared only in a .bn.
func hiddenFromBniView(c @Checker, d @ast.Decl) bool {
	return d != nil && inBniView(c) && !declaredInBni(d)
}

// declaredInBni reports whether d was parsed from a package interface (.bni).
func declaredInBni(d @ast.Decl) bool {
	var f @[]char = d.Pos.File
	return len(f) >= 4 && types.CharEq(f[len(f) - 4:], ".bni")
}

// lookupGenericHead returns the generic type or interface declaration an
// instantiation's head names in package pkg (empty for the current package),
// and whether it is an interface, or nil.  In the package interface's view an
// unqualified head names only a generic the interface itself declares.
func lookupGenericHead(c @Checker, pkg *[]readonly char, name *[]readonly char) (@ast.Decl, bool) {
	var none @ast.Decl
	var d @ast.Decl = lookupGenericTypeDeclPkg(c, pkg, name)
	var isIface bool = false
	if d == nil {
		d = lookupGenericIfaceDeclPkg(c, pkg, name)
		isIface = d != nil
	}
	if len(pkg) == 0 && hiddenFromBniView(c, d) { return none, false }
	return d, isIface
}
