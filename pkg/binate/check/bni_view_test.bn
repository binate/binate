package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for bni_view.bn and Scope.ParentNames.  checkBniMethodPkgIn /
// bniMethodErr live in check_bni_methods_test.bn.

// A scope with ParentNames sees in its parent only the names ParentNames
// declares; others resolve in the outermost scope (the universe), not in a scope
// between it and the parent, and its own names always.
func TestScopeParentNamesFilters() testing.TestResult {
	var outer @Scope = NewScope(nil)
	defineType(outer, "int", types.TypInt())
	var session @Scope = NewScope(outer)
	defineType(session, "prompt", types.TypBool())
	var pkg @Scope = NewScope(session)
	defineType(pkg, "T", types.TypBool())
	defineType(pkg, "hidden", types.TypBool())
	var names @Scope = NewScope(nil)
	defineType(names, "T", types.TypBool())
	var s @Scope = NewScope(pkg)
	s.ParentNames = names
	defineType(s, "own", types.TypBool())
	if s.Lookup("T") == nil || !same(s.Lookup("T"), pkg.LookupLocal("T")) {
		return fail("T is the interface's: it resolves to the package's symbol")
	}
	if s.Lookup("hidden") != nil { return fail("hidden is not the interface's") }
	if s.Lookup("prompt") != nil { return fail("prompt is outside the package") }
	if s.Lookup("int") == nil { return fail("the universe stays visible") }
	if s.Lookup("own") == nil { return fail("the scope's own names stay visible") }
	return ""
}

// A .bni method naming a type only the .bn declares is rejected — in a
// parameter, as the receiver, and in a method the .bn does not define (extern,
// collected with the package's own methods).
func TestBniViewHidesPrivateTypes() testing.TestResult {
	var bni *[]readonly char = "package \"q\"\ntype T struct { v int }\n"
	var bn *[]readonly char = "package \"q\"\ntype hidden struct { x int }\n"
	var r testing.TestResult = bniMethodErr(buf.Concat(bni, "func (t @T) Use(p @hidden)\n"),
			buf.Concat(bn, "func (t @T) Use(p @hidden) { }\n"), "undefined: hidden")
	if len(r) > 0 { return r }
	r = bniMethodErr(buf.Concat(bni, "func (h @hidden) M()\n"),
			buf.Concat(bn, "func (h @hidden) M() { }\n"), "undefined: hidden")
	if len(r) > 0 { return r }
	return errsIn(
			checkBniMethodPkgIn(NewChecker(), buf.Concat(bni, "func (t @T) Ext(p @hidden) int\n"), bn, true),
			"undefined: hidden")
}

// A .bni method naming a generic type only the .bn declares is rejected; one
// the .bni declares resolves.
func TestBniViewGenericHead() testing.TestResult {
	var bni *[]readonly char = "package \"q\"\ntype T struct { v int }\n"
	var r testing.TestResult = bniMethodErr(buf.Concat(bni, "func (t @T) Get() @priv[int]\n"),
			"package \"q\"\ntype priv[E any] struct { v E }\nfunc (t @T) Get() @priv[int] { return nil }\n",
			"undefined: priv")
	if len(r) > 0 { return r }
	var c @Checker = checkBniMethodPkg(
			buf.Concat(bni, "type Box[E any] struct { v E }\nfunc (t @T) Get() @Box[int]\n"),
			"package \"q\"\nfunc (t @T) Get() @Box[int] { return nil }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A bare use of a generic type the .bni declares is reported as one used without
// type arguments, not as an undefined name.
func TestBniViewBareGeneric() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(NewChecker(),
					"package \"q\"\ntype T struct { v int }\ntype Box[E any] struct { v E }\n"
							"func (t @T) G(b @Box) int\n",
					"package \"q\"\n", true), "generic type used without type arguments")
}

// A .bni method of a generic type only the .bn declares is rejected once, as an
// undefined name.
func TestBniViewGenericReceiverHidden() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(NewChecker(), "package \"q\"\nfunc (b @priv[E]) Get() int { return 0 }\n",
					"package \"q\"\ntype priv[E any] struct { v E }\n", true), "undefined: priv")
}

// In a REPL session the package scope sits on the session's scope; a .bni method
// naming a type declared only at the prompt is rejected, not bound to it.
func TestBniViewSkipsSessionScope() testing.TestResult {
	var c @Checker = NewChecker()
	c.Scope = NewScope(c.Scope)
	defineType(c.Scope, "hidden", types.TypBool())
	return errsIn(
			checkBniMethodPkgIn(c, "package \"q\"\ntype T struct { v int }\nfunc (t @T) Use() @hidden\n",
					"package \"q\"\n", true), "undefined: hidden")
}

// checkerExposingP returns a checker with package pkg/p (type X) loaded, for a
// package interface that exposes it.
func checkerExposingP() @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"pkg/p\"\ntype X struct { v int }\n"))
	return c
}

// An expose extends only the interface's surface: a .bni method naming an
// exposed member bare is rejected.
func TestBniViewHidesExposedNames() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(checkerExposingP(),
					"package \"q\"\nexpose \"pkg/p\"\ntype T struct { v int }\nfunc (t @T) Get() @X\n",
					"package \"q\"\n", true), "undefined: X")
}

// checkerWithLib returns a checker with package pkg/lib checked from bnSrc (its
// one .bn) and, unless bniSrc is empty, its interface bniSrc, merged as the
// loader merges them (mergeBniLikeLoader).
func checkerWithLib(bniSrc *[]readonly char, bnSrc *[]readonly char) @Checker {
	var c @Checker = NewChecker()
	var b @[]uint8 = make_slice(uint8, len(bnSrc))
	for i := 0; i < len(bnSrc); i++ { b[i] = cast(uint8, bnSrc[i]) }
	var p @parser.Parser = parser.New(b, "lib.bn")
	var bn @ast.File = p.ParseFile()
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = bn
	var bni @ast.File
	if len(bniSrc) > 0 {
		bni = mkBniFile(bniSrc)
		bn.Decls = mergeBniLikeLoader(bni, bn)
		c.LoadPackageInterface("pkg/lib", bni)
	}
	c.CheckPackage("pkg/lib", bn, files, bni)
	return c
}

// mergeBniLikeLoader returns bn's declarations after the .bni's the loader
// prepends to them: its types, constants, interfaces, impls and groups other
// than var groups, and its bodiless and generic functions bn does not define.
func mergeBniLikeLoader(bni @ast.File, bn @ast.File) @[]@ast.Decl {
	var ds @[]@ast.Decl = make_slice(@ast.Decl, 0)
	for i := 0; i < len(bni.Decls); i++ {
		var d @ast.Decl = bni.Decls[i]
		var isVarGroup bool = d.Kind == ast.DECL_GROUP && len(d.Decls) > 0 &&
				d.Decls[0].Kind == ast.DECL_VAR
		if d.Kind == ast.DECL_TYPE || d.Kind == ast.DECL_CONST || d.Kind == ast.DECL_INTERFACE ||
				d.Kind == ast.DECL_IMPL || d.Kind == ast.DECL_GROUP && !isVarGroup ||
				d.Kind == ast.DECL_FUNC && (d.Body == nil || isGenericDefinition(d)) && !bnDefinesFunc(bn, d) {
			ds = slices.Append[@ast.Decl](ds, d)
		}
	}
	for i := 0; i < len(bn.Decls); i++ { ds = slices.Append[@ast.Decl](ds, bn.Decls[i]) }
	return ds
}

// The .bn of package q, naming pkg/lib's Box once.
var libBoxUser *[]readonly char = "package \"q\"\nimport \"pkg/lib\"\n"
		"func F() int { return 0 }\nfunc use(b @lib.Box[int]) int { return 0 }\n"

// Another package's generic type is reachable by its qualified name only when
// it is part of that package's surface: declared in its .bni, or anywhere in a
// package with no .bni (pkg.export).
func TestQualifiedGenericHeadExportedOnly() testing.TestResult {
	var boxDecl *[]readonly char = "type Box[E any] struct { v E }\n"
	var r testing.TestResult = errsIn(
			checkBniMethodPkgIn(
					checkerWithLib("package \"pkg/lib\"\nfunc G() int\n",
							buf.Concat("package \"pkg/lib\"\nfunc G() int { return 1 }\n", boxDecl)),
					"package \"q\"\nfunc F() int\n", libBoxUser, false), "undefined: Box")
	if len(r) > 0 { return r }
	var c @Checker = checkBniMethodPkgIn(
			checkerWithLib(buf.Concat("package \"pkg/lib\"\n", boxDecl), "package \"pkg/lib\"\n"),
			"package \"q\"\nfunc F() int\n", libBoxUser, false)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	c = checkBniMethodPkgIn(checkerWithLib("", buf.Concat("package \"pkg/lib\"\n", boxDecl)),
			"package \"q\"\nfunc F() int\n", libBoxUser, false)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}
