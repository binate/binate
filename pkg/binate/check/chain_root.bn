package "pkg/binate/check"

import "pkg/binate/types"

// The members of a generic type only its package's .bn declares -- a method or
// a parameterized impl -- are package-private (pkg.export): only that .bn can
// call or bind them, and an importer, which reads the package's .bni alone,
// has no such member.  So an instance has them, and they are checked for it
// (gen.mono.check), only when a chain of instantiations rooted in the generic's
// own package names it.  The package a chain is rooted in
// (namingContext.ChainRoot) is carried through the builds and checks of the
// instances the chain names, and an instance's check state is per root as well
// as per lender class (InstCheckState.ChainRoot), the root kept only when it is
// the instance's generic's own package (chainRootFor): a chain rooted in a
// package names that package's generics with type arguments of its own only
// until it enters another package's generic, whose package cannot import the
// root's.

// chainRootAt returns the package the chain a naming here belongs to is rooted
// in, for a naming written where site is (namingContext.Site): site, when it is
// a .bn of a package with a .bni -- its code is private to the package, so
// checked only in the package's own chains; otherwise the root of the build or
// instance check the naming is made in; outside any, the current package.
func chainRootAt(c @Checker, site @[]char) @[]char {
	if len(site) > 0 && packageHasInterface(c, site) { return site }
	var st @InstanceState = instanceState(c)
	if st.Building { return st.BuildChainRoot }
	if st.Current != nil { return st.Current.ChainRoot }
	return c.curPkgPath
}

// chainRootHere returns the package the chain a naming here belongs to is
// rooted in (namingHere).
func chainRootHere(c @Checker) @[]char {
	return namingHere(c).ChainRoot
}

// chainRootFor returns the root (InstCheckState.ChainRoot) of an instance of a
// generic declared in pkg, named in a chain rooted in root: root when it is
// pkg, otherwise none.
func chainRootFor(root @[]char, pkg *[]readonly char) @[]char {
	var none @[]char
	if len(root) == 0 || !types.CharEq(root, pkg) { return none }
	return root
}

// memberInChain reports whether an instance whose chain is rooted in root has a
// member of its generic private to package priv (empty: a public one): a public
// one always, a private one only in its package's own chains.
func memberInChain(priv *[]readonly char, root *[]readonly char) bool {
	return len(priv) == 0 || types.CharEq(priv, root)
}
