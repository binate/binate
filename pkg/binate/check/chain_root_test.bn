package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for chain_root.bn: a generic type's members only its package's .bn
// declares are an instance's, and checked for it, only in a chain rooted in that
// package.

// rootLibBni and rootLibBn are pkg/lib: generics W1..W5, whose .bn adds a
// method (W1, W4, W5), a method's signature (W2) or an impl (W3) invalid for an
// int64 argument; F, whose body names W4[U]; H5, whose field names W5[int64];
// and Mine, whose body is the test's.
var rootLibBni *[]readonly char = "package \"pkg/lib\"\ninterface Sz[A any] { sz() int }\n"
		"type W1[U any] struct { u U }\nfunc (w *W1[U]) Pub() int { return 1 }\n"
		"type W2[U any] struct { u U }\nfunc (w *W2[U]) Pub() int { return 2 }\n"
		"type W3[U any] struct { u U }\nfunc (w *W3[U]) Pub() int { return 3 }\n"
		"type W4[U any] struct { u U }\nfunc (w *W4[U]) Pub() int { return 4 }\n"
		"func F[U any]() int {\n\tvar w W4[U]\n\treturn w.Pub()\n}\n"
		"type W5[U any] struct { u U }\n"
		"func Mine() int\n"

// rootLibMembers are the members only pkg/lib's .bn declares.
var rootLibMembers *[]readonly char = "package \"pkg/lib\"\n"
		"func (w *W1[U]) priv() int {\n\tvar a [sizeof(U) - 9]uint8\n\treturn len(a)\n}\n"
		"func (w *W2[U]) privSig(a [sizeof(U) - 9]uint8) int { return len(a) }\n"
		"func (w *W3[U]) sz() int { return 3 }\nimpl *W3[U] : Sz[[sizeof(U) - 9]uint8]\n"
		"func (w *W4[U]) priv() int {\n\tvar a [sizeof(U) - 9]uint8\n\treturn len(a)\n}\n"
		"func (w *W5[U]) priv() int {\n\tvar a [sizeof(U) - 9]uint8\n\treturn len(a)\n}\n"

// rootLibUses names W1..W3 with int64 and calls F[int64], as package q's or
// pkg/lib's code (qual the package qualifier, if any).
func rootLibUses(qual *[]readonly char) @[]char {
	var s @[]char = buf.Concat("\tvar a ", qual)
	s = buf.Concat(s, "W1[int64]\n\tvar b ")
	s = buf.Concat(s, qual)
	s = buf.Concat(s, "W2[int64]\n\tvar c ")
	s = buf.Concat(s, qual)
	s = buf.Concat(s, "W3[int64]\n\treturn a.Pub() + b.Pub() + c.Pub() + ")
	s = buf.Concat(s, qual)
	return buf.Concat(s, "F[int64]()\n")
}

// Another package's instances of pkg/lib's generics -- named directly, through
// F's body -- do not have the members only lib's .bn declares, and those are not
// checked for them.
func TestChainRootOtherPackageHasNoPrivateMembers() testing.TestResult {
	var c @Checker = checkerWithLib(rootLibBni,
			buf.Concat(rootLibMembers, "func Mine() int { return 0 }\n"))
	if len(c.CheckerErrors()) > 0 { return fail(buf.Concat("lib: ", c.CheckerErrors()[0].Msg)) }
	var q @[]char = buf.Concat("package \"q\"\nimport \"pkg/lib\"\nfunc U() int {\n",
			rootLibUses("lib."))
	return expectNoErrors(
			checkBniMethodPkgIn(c, "package \"q\"\nfunc U() int\n", buf.Concat(q, "}\n"), false))
}

// The instances pkg/lib's own code names -- in its .bn, directly or through F's
// body, or in its .bni -- have them, and each is checked for them, once.
func TestChainRootOwnPackageChecksPrivateMembers() testing.TestResult {
	var bni @[]char = buf.Concat(rootLibBni, "type H5 struct { w W5[int64] }\n")
	var mine @[]char = buf.Concat("func Mine() int {\n", rootLibUses(""))
	var c @Checker = checkerWithLib(bni, buf.Concat(rootLibMembers, buf.Concat(mine, "}\n")))
	var want @[]*[]readonly char = make_slice(*[]readonly char, 5)
	want[0] = "in W1[int64].priv,"
	want[1] = "in W2[int64],"
	want[2] = "in the impl for W3[int64],"
	want[3] = "in W4[int64].priv,"
	want[4] = "in W5[int64].priv,"
	for i := 0; i < len(want); i++ {
		if errorsContaining(c, want[i]) != 1 {
			var msg @[]char = buf.Concat("expected one error ", want[i])
			return fail(buf.Concat(msg, buf.Concat(" got ", strconv.Itoa(errorsContaining(c, want[i])))))
		}
	}
	if len(c.CheckerErrors()) != len(want) {
		return fail(buf.Concat("expected 5 errors; got ", strconv.Itoa(len(c.CheckerErrors()))))
	}
	return ""
}

// chainRootFor keeps a chain's root for an instance of a generic its package
// declares, and drops it for one declared elsewhere.
func TestChainRootForKeepsOwnPackage() testing.TestResult {
	if !streq(chainRootFor(buf.CopyStr("pkg/lib"), "pkg/lib"), "pkg/lib") {
		return fail("the own package's root was dropped")
	}
	if len(chainRootFor(buf.CopyStr("q"), "pkg/lib")) != 0 {
		return fail("another package's root was kept")
	}
	var none @[]char
	if len(chainRootFor(none, "pkg/lib")) != 0 { return fail("no root became one") }
	return ""
}

// memberInChain puts a public member in every chain, and a private one only in
// its package's.
func TestMemberInChain() testing.TestResult {
	if !memberInChain("", "q") { return fail("a public member was left out") }
	if !memberInChain("pkg/lib", "pkg/lib") {
		return fail("a private member was left out of its package's chain")
	}
	if memberInChain("pkg/lib", "q") || memberInChain("pkg/lib", "") {
		return fail("a private member was in another chain")
	}
	return ""
}
