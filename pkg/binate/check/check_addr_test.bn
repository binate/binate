package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// ============================================================
// Addressability Tests (address-of `&` operand validation)
// ============================================================

// A plain variable has storage — `&x` is addressable.
func TestAddrOfVarOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() {\nvar x int = 0\nvar p *int = &x\n_ = p\n}\n")
	return expectNoErrors(c)
}

// A struct FIELD selector is addressable — `&pt.x` has the field's storage.
func TestAddrOfFieldOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype P struct { x int }\n"
					"func f() {\nvar pt P\nvar p *int = &pt.x\n_ = p\n}\n")
	return expectNoErrors(c)
}

// An index expression is addressable — `&a[0]` points into the array.
func TestAddrOfIndexOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() {\nvar a [3]int\nvar p *int = &a[0]\n_ = p\n}\n")
	return expectNoErrors(c)
}

// A dereference is addressable — `&*q` round-trips to q's pointee storage.
func TestAddrOfDerefOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() {\nvar x int = 0\nvar q *int = &x\n"
					"var p *int = &*q\n_ = p\n}\n")
	return expectNoErrors(c)
}

// A composite literal IS addressable — it has a backing alloca, so
// `&P{...}` is valid (the isLiteralExprKind counterpoint: a composite
// literal is NOT a storage-less literal).
func TestAddrOfCompositeLitOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype P struct { x int }\n"
					"func f() {\nvar p *P = &P{x: 0}\n_ = p\n}\n")
	return expectNoErrors(c)
}

// `&5` — a literal has no storage (isLiteralExprKind).
func TestAddrOfLiteralRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() {\nvar p *int = &5\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of a literal")
}

// `&func() {}` — a func literal is a storage-less literal too
// (isLiteralExprKind includes EXPR_FUNC_LIT), so its address is rejected
// with the same "literal" diagnostic — unlike a composite literal.
func TestAddrOfFuncLitRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() {\nvar p *int = &func() {}\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of a literal")
}

// `&C` — a constant is a compile-time value with no storage.
func TestAddrOfConstRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nconst C int = 5\n"
					"func f() {\nvar p *int = &C\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of constant")
}

// `&g` — a named function is not an addressable lvalue.
func TestAddrOfFuncRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f() {\nvar p *int = &g\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of function")
}

// `&t.m` — a bound method value is a computed value, not storage
// (selectorIsMethodValue distinguishes it from a struct field).
func TestAddrOfMethodValueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype T int\nfunc (t T) m() {}\n"
					"func f() {\nvar t T\nvar p *int = &t.m\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of a method value")
}

// `&g()` — a call result is a value with no storage; the generic
// "non-addressable value" diagnostic covers it.
func TestAddrOfCallResultRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() int { return 0 }\n"
					"func f() {\nvar p *int = &g()\n_ = p\n}\n")
	return expectErrSub(c, "cannot take the address of a non-addressable value")
}

// An implicit value-borrow of a NON-addressable source — a call result, a field
// or element of a value with no storage — is marked BorrowTemp (IR-gen borrows a
// temporary holding its value), in a var initializer and in an argument; an
// addressable source (a variable, its field, a slice element, a field through a
// pointer result) is not.
func TestCheckMarksBorrowTemp() testing.TestResult {
	var inits @[]@ast.Expr = mainVarInits(
			"package \"test\"\n"
					"interface G { get() int }\n"
					"type V struct { n int }\n"
					"func (v V) get() int { return v.n }\n"
					"impl V : G\n"
					"type H struct { v V }\n"
					"func mkV() V { var v V; return v }\n"
					"func mkH() H { var h H; return h }\n"
					"func mkHp() @H { return make(H) }\n"
					"func mkA() [2]V { var a [2]V; return a }\n"
					"func mkS() @[]V { return make_slice(V, 1) }\n"
					"func take(g *G) int { return g.get() }\n"
					"func main() {\n"
					"  var h H\n"
					"  var a *G = mkV()\n"
					"  var b *G = mkH().v\n"
					"  var c *G = mkA()[1]\n"
					"  var d *G = h\n"
					"  var e *G = h.v\n"
					"  var f *G = mkS()[0]\n"
					"  var g *G = mkHp().v\n"
					"  var t int = take(mkH().v)\n"
					"  var u int = take(h.v)\n"
					"  _ = a; _ = b; _ = c; _ = d; _ = e; _ = f; _ = g; _ = t; _ = u\n"
					"}\n")
	if len(inits) != 9 { return "expected 9 var initializers" }
	var want *[]readonly bool = *[]readonly bool{true, true, true, false, false, false, false, true,
			false}
	for i := 0; i < len(inits); i++ {
		// The last two borrow in an argument: the source is the call's argument.
		var src @ast.Expr = inits[i]
		if i >= 7 { src = inits[i].Args[0] }
		if src.BorrowTemp != want[i] {
			if want[i] { return "a non-addressable value-borrow source is not marked BorrowTemp" }
			return "an addressable value-borrow source is marked BorrowTemp"
		}
	}
	return ""
}
