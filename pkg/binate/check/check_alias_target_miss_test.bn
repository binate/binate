package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests of the constraint misses an instantiation written in a generic alias's
// target finds: each is reported at the alias's use, as written there
// (check_generic_alias.bn), naming the instance the use is in, and at the use's
// level (bindAliasTarget): a declaration's own check reports a miss the target
// writes with concrete arguments as the declaration's, which its instances do not
// report again.

// aliasMissPrelude declares K, whose V must be a Tag of U's size; KT, an alias of K
// over @T, which is a Tag[[8]uint8] alone; and the generic G.
var aliasMissPrelude *[]readonly char = "package \"test\"\ninterface Tag[X any] { tag() int }\n"
		"type K[V Tag[[sizeof(U)]uint8], U any] struct { v V }\ntype KT[U any] = K[@T, U]\n"
		"type T struct { n int }\nfunc (t @T) tag() int { return t.n }\nimpl @T : Tag[[8]uint8]\n"
		"type G[U any] struct { u U }\n"

// m's signature writes KT[U], whose target misses for G[int16] alone: the miss names
// G[int16], as K[@T, U] written there would.
func TestAliasTargetMissInMethodSignatureNamesInstance() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"func (g *G[U]) m(k *KT[U]) int { return 0 }\nvar g2 G[int16]\n")
	return errsIn(checkSrc(src),
			"type argument @T does not satisfy constraint Tag[[2]uint8] (in G[int16], instantiated at ")
}

// D's field writes KP2[X], whose target writes KT[int16], a miss whatever X is, and
// K[@T, X], a miss for D[int32] alone: D[int32]'s names D[int32], and KT[int16]'s is
// reported at KP2's declaration (line 10), and not again for D[int32].
func TestAliasTargetInstanceMissKeptAndNamed() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type Pair[A any, B any] struct { a A; b B }\ntype KP2[B any] = Pair[KT[int16], K[@T, B]]\n"
					"type D[X any] struct { k KP2[X] }\nvar d D[int32]\n")
	var c @Checker = checkSrc(src)
	if !anyErrContains(c,
			"type argument @T does not satisfy constraint Tag[[4]uint8] (in D[int32], ") {
		return fail("expected D[int32]'s miss of Tag[[4]uint8], naming D[int32]")
	}
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 { return fail("expected KP2's miss and D[int32]'s, each once") }
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == 10 &&
				streq(errs[i].Msg, "type argument @T does not satisfy constraint Tag[[2]uint8]") {
			return ""
		}
	}
	return fail("expected KT[int16]'s miss of Tag[[2]uint8] at KP2's declaration")
}

// I's method signature writes KS[Self, U], whose target misses for I[int16] alone:
// the miss names I[int16], as K[@T, U] written there would, though the target is
// resolved with an abstract argument, `Self`.
func TestAliasTargetWithSelfMissNamesInstance() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type KS[S any, U any] = K[@T, U]\ninterface I[U any] { m(x *KS[Self, U]) int }\n"
					"type R struct { n int }\nfunc (r *R) m(x *K[@T, int16]) int { return 0 }\n"
					"impl *R : I[int16]\n")
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c, "type argument @T does not satisfy constraint Tag[[2]uint8] (in I[int16], ") {
		return fail("expected I[int16]'s miss named, and R's method's")
	}
	return ""
}

// D's field writes KP[int16, X], whose target writes K twice: K[@T, int16], a miss
// whatever X is, and K[@T, X], a miss of Tag[[4]uint8] for D[int32].  They are two
// misses at the field (line 11), D[int32]'s naming D[int32].
func TestAliasTargetTwoMissesOfOneGeneric() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude, "type Pair[A any, B any] struct { a A; b B }\n"
			"type KP[A any, B any] = Pair[K[@T, A], K[@T, B]]\n"
			"type D[X any] struct { k KP[int16, X] }\nvar d D[int32]\n")
	return expectTwoFieldMisses(checkSrc(src), 11)
}

// KP4's target writes KT2 twice, and KT2's target writes K once: D's K[@T, int16]
// and D[int32]'s K[@T, int32] are written at one place in KT2's target but at two in
// KP4's, so they are two misses at the field (line 12).
func TestAliasTargetTwoMissesThroughNestedAlias() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type Pair[A any, B any] struct { a A; b B }\ntype KT2[A any, B any] = K[@T, A]\n"
					"type KP4[A any, B any] = Pair[KT2[A, B], KT2[B, A]]\n"
					"type D[X any] struct { k KP4[int16, X] }\nvar d D[int32]\n")
	return expectTwoFieldMisses(checkSrc(src), 12)
}

// expectTwoFieldMisses expects c's errors to be two, at D's field on line: K[@T,
// int16]'s miss of Tag[[2]uint8], naming no instance, and D[int32]'s of
// Tag[[4]uint8], naming D[int32].
func expectTwoFieldMisses(c @Checker, line int) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	var plain bool
	var named bool
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line != line { return fail(buf.Concat("not at D's field: ", errs[i].Msg)) }
		plain = plain || streq(errs[i].Msg, "type argument @T does not satisfy constraint Tag[[2]uint8]")
		named = named ||
				charsHaveSub(errs[i].Msg,
						"type argument @T does not satisfy constraint Tag[[4]uint8] (in D[int32], ")
	}
	if len(errs) != 2 || !plain || !named {
		return fail("expected K[@T, int16]'s miss and D[int32]'s, at D's field")
	}
	return ""
}

// D's field writes BP3[Y, int, bool], whose target writes Bar3 twice, each missing
// for Y with one text: the declaration's two misses are one diagnostic, which stands
// for both, so neither instance's miss there is reported, nor the diagnostic twice.
func TestAliasTargetMissesOfOneTextStandForBoth() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude, "type Pair[A any, B any] struct { a A; b B }\n"
			"type Bar3[V Tag[[8]uint8], W any] struct { v V; w W }\n"
			"type BP3[A any, B any, C any] = Pair[Bar3[A, B], Bar3[A, C]]\n"
			"type D[Y any] struct { f BP3[Y, int, bool] }\nvar d D[int32]\nvar e D[int64]\n")
	return expectOneFieldMiss(checkSrc(src), 12)
}

// The same through the alias's own constraint: BP5's target writes BA twice.
func TestAliasOwnMissesOfOneTextStandForBoth() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type Pair[A any, B any] struct { a A; b B }\ntype BA[A Tag[[8]uint8], B any] = Pair[A, B]\n"
					"type BP5[A any, B any, C any] = Pair[BA[A, B], BA[A, C]]\n"
					"type D[Y any] struct { f BP5[Y, int, bool] }\nvar d D[int32]\nvar e D[int64]\n")
	return expectOneFieldMiss(checkSrc(src), 12)
}

// expectOneFieldMiss expects c's errors on line, D's field, to be one: D's miss of
// Tag[[8]uint8] for Y.
func expectOneFieldMiss(c @Checker, line int) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	var n int
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line != line {
			continue
		}
		if !streq(errs[i].Msg, "type argument Y does not satisfy constraint Tag[[8]uint8]") {
			return fail(buf.Concat("at D's field: ", errs[i].Msg))
		}
		n = n + 1
	}
	if n != 1 { return fail("expected D's miss at its field once") }
	return ""
}

// D's field writes KT[int16], whose target misses whatever D's argument is: the miss
// is D's declaration's, reported once naming no instance, though G[int32]'s method
// signature forms D[int32] before D's own check, and D[int32]'s build resolves the
// target again.
func TestAliasTargetMissOfDeclarationReportedOnce() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"var g G[int32]\nfunc (g *G[U]) m(d *D[U]) int { return 0 }\n"
					"type D[X any] struct { k KT[int16]; x X }\n")
	return expectDeclarationMissOnce(checkSrc(src))
}

// The same through an alias of KT.
func TestAliasTargetMissOfDeclarationThroughNestedAlias() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type KT2[U any] = KT[U]\nvar g G[int32]\nfunc (g *G[U]) m(d *D[U]) int { return 0 }\n"
					"type D[X any] struct { k KT2[int16]; x X }\n")
	return expectDeclarationMissOnce(checkSrc(src))
}

// The same with K and KT another package's: one of a .bni alone, loaded and checked
// as the drivers do (the loader makes the .bni its merged file).
func TestImportedAliasTargetMissOfDeclarationReportedOnce() testing.TestResult {
	var c @Checker = NewChecker()
	var lib @ast.File = mkBniFile("package \"pkg/lib\"\ninterface Tag[X any] { tag() int }\n"
			"type K[V Tag[[sizeof(U)]uint8], U any] struct { v V }\ntype KT[U any] = K[@T, U]\n"
			"type T struct { n int }\nfunc (t @T) tag() int\nimpl @T : Tag[[8]uint8]\n")
	c.LoadPackageInterface("pkg/lib", lib)
	c.CheckPackage("pkg/lib", lib, make_slice(@ast.File, 0), lib)
	var p @parser.Parser = parser.New(
			toBytes("package \"test\"\nimport \"pkg/lib\"\ntype G[U any] struct { u U }\nvar g G[int32]\n"
					"func (g *G[U]) m(d *D[U]) int { return 0 }\n"
					"type D[X any] struct { k lib.KT[int16]; x X }\n"),
			"test.bn")
	c.Check(mustParse(p))
	return expectDeclarationMissOnce(c)
}

// expectDeclarationMissOnce expects c's errors to be one: D's miss of Tag[[2]uint8],
// naming no instance.
func expectDeclarationMissOnce(c @Checker) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 1 ||
			!streq(errs[0].Msg, "type argument @T does not satisfy constraint Tag[[2]uint8]") {
		return fail(buf.Concat("expected D's miss once, naming no instance; ", allErrorMsgs(c)))
	}
	return ""
}

// D[int32], formed by G[int32]'s method signature before D's own check, finds both
// misses its field's alias target writes; D's check then finds KT[int16]'s, whatever
// X is, which stands for D[int32]'s, while K[@T, X]'s stays D[int32]'s.
func TestAliasTargetDeclarationMissStandsForInstances() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type Pair[A any, B any] struct { a A; b B }\ntype KP3[A any, B any] = Pair[KT[A], K[@T, B]]\n"
					"var g G[int32]\nfunc (g *G[U]) m(d *D[U]) int { return 0 }\n"
					"type D[X any] struct { k KP3[int16, X] }\n")
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 2 || anyErrContains(c, "Tag[[2]uint8] (in ") ||
			!anyErrContains(c, "type argument @T does not satisfy constraint Tag[[4]uint8] (in D[int32], ") {
		return fail("expected D's miss of Tag[[2]uint8], naming no instance, and D[int32]'s other")
	}
	return ""
}

// m's KP[int16, int32] misses Tag[[2]uint8] through K[@T, int16] before E's own check
// reaches E's field, which writes K[@T, int16] too: that miss is reported at m, and
// E[int32] does not report it again, as it would not with
// `Pair[K[@T, int16], K[@T, int32]]` written in m.
func TestAliasTargetMissAtPlainSiteNotRepeatedByInstance() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"type Pair[A any, B any] struct { a A; b B }\ntype KP[A any, B any] = Pair[K[@T, A], K[@T, B]]\n"
					"type S struct { n int }\nfunc (s @S) m(p *KP[int16, int32]) int { return 0 }\n"
					"type E[X any] struct { p *Pair[K[@T, int16], K[@T, X]] }\nvar e E[int32]\n")
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 3 || anyErrContains(c, "Tag[[2]uint8] (in ") ||
			!anyErrContains(c, "type argument @T does not satisfy constraint Tag[[4]uint8] (in E[int32], ") {
		return fail("expected m's two misses and E[int32]'s miss of Tag[[4]uint8]")
	}
	return ""
}

// J's method writes KT[U]: J[Self, int32]'s miss through it, found at the level of
// its use with its type arguments, does not stand for J[R, int8]'s at the same
// place, which is reported too.
func TestAliasTargetInSelfOnlyInstanceMissKeepsOthers() testing.TestResult {
	var src @[]char = buf.Concat(aliasMissPrelude,
			"interface J[S any, U any] { n(k *KT[U]) int }\ninterface I[U any] { m(j *J[Self, U]) int }\n"
					"type R struct { n int }\nfunc use(i *I[int32]) {}\nfunc use2(j *J[R, int8]) {}\n")
	return expectTwoInstanceMisses(checkSrc(src),
			"type argument @T does not satisfy constraint Tag[[1]uint8] (in J[R, int8], ")
}
