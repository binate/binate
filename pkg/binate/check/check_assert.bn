package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// Type-assertion checking (spec §11.12 `iface.assert`).  `x.(K T)` recovers a
// concrete type or an interface value from an interface-value operand at run
// time; the checker types the expression and returns the recovered type.

// checkTypeAssert types an EXPR_TYPE_ASSERT.  The operand must be an interface
// value (`*I`/`@I`); the target is a mandatory recovery kind (`*`/`@`/value)
// over a nameable type, with an optional element `readonly`.  Returns the
// recovered type: `*T` (borrow), `@T` (retain), `*J`/`@J` (interface value), or
// `T` (value copy) — under an outer `readonly` when a type parameter's argument
// carries one (iface.assert.typeparam).
func checkTypeAssert(c @Checker, e @ast.Expr) @types.Type {
	var opType @types.Type = checkExpr(c, e.X)
	if isErrType(opType) {
		return types.TypError()
	}
	var opKind int = ComparabilityKind(opType)
	if opKind != types.TYP_INTERFACE_VALUE && opKind != types.TYP_INTERFACE_VALUE_MANAGED {
		addCheckError(c, e.Pos, "type assertion operand must be an interface value")
		return types.TypError()
	}
	return assertTargetType(c, opKind, e.TypeRef, e.Pos)
}

// isValueRecoverable reports whether `t` may be recovered BY VALUE by a bare-name
// type-assertion target `x.(T)` — a SCALAR (int / bool / float, seen through named
// scalars by IsScalar), a value AGGREGATE (struct / array), or any other NAMED
// type.  A scalar recovers by a plain load; a struct / array by a RETAINING
// field-wise copy (IR-gen RefInc's its managed fields).  A named type over a
// pointer, slice, function value or interface value (`type H @Node`, `type NS
// @[]int`, `type F @func() int`, `type X @J`) is boxed as a value — the box points
// at the H — so `.(H)` loads the H out, retaining a managed one.  Interfaces (which
// recover via `*J` / `@J`) and opaque named types (no representation to copy) are
// excluded.
func isValueRecoverable(t @types.Type) bool {
	if t == nil {
		return false
	}
	if t.IsScalar() {
		return true
	}
	var p @types.Type = types.StripWrappers(t)
	if p == nil {
		return false
	}
	var n @types.Type = types.ResolveAliasAndConst(t)
	if n != nil && n.Kind == types.TYP_NAMED {
		// StripWrappers stops at an opaque named type (it has no Underlying).
		return p.Kind != types.TYP_NAMED && p.Kind != types.TYP_INTERFACE
	}
	return p.Kind == types.TYP_STRUCT || p.Kind == types.TYP_ARRAY
}

// isNameableAssertBase reports whether t — an assertion target's base, resolved
// from a type name — is a type the name can stand for as a target: not, under
// any alias or `readonly` wrapper, a pointer, slice, array, anonymous struct,
// function or interface value.  A named type over any of those (`type H @Node`)
// is nameable; only an alias exposes the unnamed type itself.
func isNameableAssertBase(t @types.Type) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else {
			t = t.Elem
		}
	}
	if t == nil { return false }
	if t.Kind == types.TYP_STRUCT { return len(t.Name) > 0 }
	return t.Kind != types.TYP_POINTER && t.Kind != types.TYP_MANAGED_PTR &&
			t.Kind != types.TYP_SLICE && t.Kind != types.TYP_MANAGED_SLICE && t.Kind != types.TYP_ARRAY &&
			t.Kind != types.TYP_FUNC && t.Kind != types.TYP_FUNC_VALUE &&
			t.Kind != types.TYP_MANAGED_FUNC_VALUE && t.Kind != types.TYP_INTERFACE_VALUE &&
			t.Kind != types.TYP_INTERFACE_VALUE_MANAGED
}

// assertTargetType validates a type-assertion / type-switch-case AssertTarget
// `target` (a `*`/`@`/value recovery-kind wrapper over a nameable type, with an
// optional element `readonly`) against an interface-value operand whose
// comparability-kind is `opKind` (TYP_INTERFACE_VALUE for a raw `*I`,
// TYP_INTERFACE_VALUE_MANAGED for a managed `@I`).  Returns the recovered type —
// `*T`/`@T` (concrete pointer), `*J`/`@J` (interface value), or `T` (value copy)
// — or TypVoid on a target error.  The operand's own interface-value check is
// the caller's; this is shared by checkTypeAssert (single `x.(*T)`) and
// checkTypeSwitchStmt (each `case` target — parseAssertTarget builds the same
// TypeExpr shape for both), so satisfaction ("does T actually implement the
// scrutinee interface") is deliberately NOT checked here — that is a runtime
// decision (§11.12).
func assertTargetType(c @Checker, opKind int, target @ast.TypeExpr, pos token.Pos) @types.Type {
	if target == nil {
		addCheckError(c, pos, "type assertion requires a target type")
		return types.TypError()
	}
	// A bare target naming a type parameter, in an instance's check, recovers as
	// its type argument says (iface.assert.typeparam).
	var arg @types.Type = boundTypeArg(c, target)
	if arg != nil {
		return assertTypeArgTarget(c, opKind, arg, pos)
	}
	// The recovery kind is the OUTER wrapper — `*T` = TEXPR_POINTER, `@T` =
	// TEXPR_MANAGED, a bare name = value copy.  An element `readonly` is a
	// TEXPR_CONST nested one level in (on the base), per parseAssertTarget.
	var recoveryKind int = target.Kind
	// Slice target `*[]T` / `@[]T` (§11.12 `iface.assert.slice`): the leading
	// `*`/`@` is the slice's raw/managed marker, not a recovery-kind wrapper, so
	// resolve the WHOLE target to a TYP_SLICE / TYP_MANAGED_SLICE (element-
	// `readonly` preserved by resolveTypeExpr) and recover it BY VALUE.  Unlike a
	// concrete `@T` (which needs a managed operand `@I` to share a reference,
	// checked below), a slice `@[]T` is legal from a RAW `*I`: recovery loads the
	// slice header and RefInc-acquires the still-live backing — a NEW reference,
	// not a share of the box's (a raw box owns none).  Name-less `@any` boxing is
	// unsupported, so a slice target only ever matches a raw-`*any` box anyway.
	// §5.1: raw-vs-managed and element-`readonly` are DISTINCT identities, so no
	// canonicalization here — the resolved type is the exact match key.
	if recoveryKind == ast.TEXPR_SLICE || recoveryKind == ast.TEXPR_MANAGED_SLICE {
		return resolveTypeExpr(c, target)
	}
	var inner @ast.TypeExpr = target
	if recoveryKind == ast.TEXPR_POINTER || recoveryKind == ast.TEXPR_MANAGED {
		inner = target.Base
	}
	var isReadonly bool = false
	if inner != nil && inner.Kind == ast.TEXPR_CONST {
		isReadonly = true
		inner = inner.Base
	}

	// Resolve the base named type.  Interfaces are allowed HERE: an interface
	// target `x.(*J)` recovers an interface value of J (via the runtime
	// satisfaction lookup), handled below.
	var baseT @types.Type = resolveTypeExprAllowInterface(c, inner)
	if baseT == nil || baseT.Kind == types.TYP_VOID || isErrType(baseT) {
		return types.TypError()
	}
	// A target naming a type parameter is checked for each instance, as the
	// assertion its instance spells (iface.assert.typeparam, gen.mono.check); in
	// the generic body it is the type written.
	if baseT.Kind == types.TYP_TYPE_PARAM {
		return deferredAssertTarget(recoveryKind, baseT, isReadonly)
	}
	// The parser admits only a type NAME here, but an alias names its target type,
	// not a new one: `type NP = @Node; x.(*NP)` spells the non-nameable target
	// `*(@Node)` (§11.12 iface.assert: a func / array / struct / pointer target is
	// a compile error; a slice is spelled `*[]T` / `@[]T`).  Left through, such a
	// target recovers the box's cell as the wrong type — `*(@Node)` matches a plain
	// `@Node` box, whose identity the pointers peel down to — so reject it.
	if !isNameableAssertBase(baseT) {
		var bound @types.Type = boundTypeArg(c, inner)
		if bound != nil && isReadonly && recoveryKind != ast.TEXPR_POINTER &&
				recoveryKind != ast.TEXPR_MANAGED {
			// `x.(readonly T)` with T bound to a handle (`*Thing`, `@Thing`, an
			// interface value or a slice): the target `readonly *Thing` recovers as
			// a bare T bound to it would.
			return assertTypeArgTarget(c, opKind, types.MakeReadonlyType(bound), pos)
		}
		if bound != nil {
			// A written kind or readonly over a type argument: the target is the
			// type argument so written.
			errTypeArgAssertTarget(c, pos, deferredAssertTarget(recoveryKind, baseT, isReadonly))
			return types.TypError()
		}
		addCheckError(c, pos,
				"type-assertion target must be a named type (a concrete type, an "
						"interface, or `any`) or a `*[]T` / `@[]T` slice; this name is an "
						"alias of a pointer, slice, array, struct, function or interface-"
						"value type, which cannot be asserted")
		return types.TypError()
	}
	return assertRecovered(c, opKind, recoveryKind, baseT, isReadonly, pos)
}

// assertRecovered checks the assertion of a nameable base type baseT, with an
// element readonly when isReadonly, recovered by recoveryKind (TEXPR_POINTER for
// `*`, TEXPR_MANAGED for `@`, any other kind by value) from an interface-value
// operand of comparability-kind opKind, and returns the recovered type (see
// assertTargetType).
func assertRecovered(c @Checker, opKind int, recoveryKind int, baseT @types.Type, isReadonly bool,
		pos token.Pos) @types.Type {
	// Value recovery `x.(T)` copies the pointee out by value — a distinct lowering
	// from the `*`/`@` pointer-recovery forms.  The box's data slot holds the
	// value's ADDRESS; recovery LOADs it.  A SCALAR (int / bool / float — incl.
	// char, the sized ints/uints, AND named scalars like `type Money int`) is a
	// plain no-refcount load; a value STRUCT / ARRAY is a RETAINING field-wise copy
	// (IR-gen RefInc's its managed fields so the recovered value co-owns); any other
	// named type is a load that retains a managed one.  An interface or an opaque
	// type is not value-recoverable here (interfaces recover via `*J` / `@J`).
	if recoveryKind != ast.TEXPR_POINTER && recoveryKind != ast.TEXPR_MANAGED {
		if !isValueRecoverable(baseT) {
			addCheckError(c, pos,
					"value-recovery type assertion is only supported for scalar, "
							"struct / array and named types; interfaces recover via "
							"`*T` / `@T`, and an opaque type is not value-recoverable")
			return types.TypError()
		}
		// A type opaque HERE — including another package's opaque export, whose
		// layout co-compilation fills in — cannot be copied out by value either.
		if embedsOpaqueByValue(c, baseT) {
			addCheckError(c, pos,
					"cannot use an opaque type by value"
							" (its layout is not available here; hold it via *T or @T)")
			return types.TypError()
		}
		if isReadonly {
			// `x.(readonly T)`: the copy recovered into a read-only location — a
			// recovered value's outer readonly is freely choosable
			// (iface.assert.kind).
			return types.MakeReadonlyType(baseT)
		}
		return baseT
	}

	// §11.12 `iface.assert.kind`: `@T` retains a reference, so it is legal only
	// from a managed operand `@I`; a raw `*I` has no reference to share.  This
	// governs interface targets too (`@J` needs `@I`).
	if recoveryKind == ast.TEXPR_MANAGED && opKind == types.TYP_INTERFACE_VALUE {
		addCheckError(c, pos, "cannot recover @T from a raw interface value *I (no reference to share)")
		return types.TypError()
	}

	// Interface target `x.(*J)` / `x.(@J)`: the recovered value is an interface
	// value of J (assembled at run time from the satisfaction lookup), NOT a
	// concrete pointer.  An interface value has no inner readonly slot (§11.12
	// iface.value.no-readonly-slot), so an element `readonly` is meaningless and
	// rejected.  `recoveryKind` is TEXPR_POINTER or TEXPR_MANAGED here (value
	// recovery was rejected above).
	if baseT.Kind == types.TYP_INTERFACE {
		if isReadonly {
			addCheckError(c, pos,
					"readonly is not allowed on an interface-value "
							"assertion target (an interface value has no inner readonly slot)")
			return types.TypError()
		}
		if recoveryKind == ast.TEXPR_POINTER {
			return types.MakeInterfaceValueType(baseT)
		}
		return types.MakeManagedInterfaceValueType(baseT)
	}

	// Element type with element `readonly` applied (add-only — a concrete base
	// is never itself readonly, so there is nothing to drop; §11.12
	// readonly.lattice-element).
	var elemT @types.Type = baseT
	if isReadonly {
		elemT = types.MakeReadonlyType(baseT)
	}
	if recoveryKind == ast.TEXPR_POINTER {
		return types.MakePointerType(elemT)
	}
	if recoveryKind == ast.TEXPR_MANAGED {
		return types.MakeManagedPtrType(elemT)
	}
	// Value recovery `x.(T)` yields a value T (a field-wise copy of the pointee).
	return elemT
}

// boundTypeArg returns the type argument a bare assertion target te names — a
// type parameter or receiver binder bound to its argument while an instance is
// checked (Symbol.IsTypeArg) — or nil.
func boundTypeArg(c @Checker, te @ast.TypeExpr) @types.Type {
	if te == nil || te.Kind != ast.TEXPR_NAMED || len(te.Pkg) > 0 {
		return nil
	}
	var sym @Symbol = c.Scope.Lookup(te.Name)
	if sym == nil || !sym.IsTypeArg {
		return nil
	}
	return sym.Type
}

// assertTypeArgTarget checks the bare assertion target naming a type parameter
// bound to arg, from an interface-value operand of comparability-kind opKind
// (iface.assert.typeparam): the target recovers a value of type arg, so an
// outermost `*` / `@` of arg — a raw or managed pointer or interface value — is
// the recovery kind and the rest the target, a slice is a slice target, and any
// other arg is recovered by value.  Aliases and an outermost `readonly` are read
// through first: a recovered value's outer `readonly` is freely choosable
// (iface.assert.kind), so `readonly *Thing` recovers as `*Thing`, and the
// recovered value keeps the `readonly` — its type is arg.
func assertTypeArgTarget(c @Checker, opKind int, arg @types.Type, pos token.Pos) @types.Type {
	var t @types.Type = types.ResolveAliasAndConst(arg)
	if t == nil || isErrType(t) {
		return types.TypError()
	}
	var recovered @types.Type = assertTypeArgShape(c, opKind, arg, t, pos)
	if isErrType(recovered) || !outerReadonly(arg) {
		return recovered
	}
	return types.MakeReadonlyType(recovered)
}

// outerReadonly reports whether t's chain of aliases and readonly wrappers holds
// a readonly — the outermost readonly ResolveAliasAndConst peels.  A named type
// stops the chain: its readonly is part of the type it names.
func outerReadonly(t @types.Type) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_READONLY { return true }
		t = t.Target
	}
	return false
}

// assertTypeArgShape checks the assertion of a type argument arg whose aliases
// and outermost readonly peel to t (see assertTypeArgTarget) and returns the
// recovered type, without arg's outer readonly.
func assertTypeArgShape(c @Checker, opKind int, arg @types.Type, t @types.Type,
		pos token.Pos) @types.Type {
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		return t
	}
	var recoveryKind int = ast.TEXPR_NAMED
	var base @types.Type = t
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_INTERFACE_VALUE {
		recoveryKind = ast.TEXPR_POINTER
		base = t.Elem
	} else if t.Kind == types.TYP_MANAGED_PTR || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		recoveryKind = ast.TEXPR_MANAGED
		base = t.Elem
	}
	var isReadonly bool = false
	if base != nil && base.Kind == types.TYP_READONLY {
		isReadonly = true
		base = base.Elem
	}
	if base == nil || !isNameableAssertBase(base) {
		errTypeArgAssertTarget(c, pos, arg)
		return types.TypError()
	}
	return assertRecovered(c, opKind, recoveryKind, base, isReadonly, pos)
}

// deferredAssertTarget returns the type an assertion target written over the
// type t recovers before its instance is checked: `*T` / `@T` (with an element
// readonly when isReadonly) for a `*` / `@` recovery kind, else T (readonly T
// when isReadonly, an outer readonly an instance reads through).
func deferredAssertTarget(recoveryKind int, t @types.Type, isReadonly bool) @types.Type {
	var elemT @types.Type = t
	if isReadonly {
		elemT = types.MakeReadonlyType(t)
	}
	if recoveryKind == ast.TEXPR_POINTER {
		return types.MakePointerType(elemT)
	}
	if recoveryKind == ast.TEXPR_MANAGED {
		return types.MakeManagedPtrType(elemT)
	}
	return elemT
}

// errTypeArgAssertTarget reports an assertion target that a type argument
// makes illegal (iface.assert.typeparam): t, the type the target names for the
// instance, is not one that can be asserted.
func errTypeArgAssertTarget(c @Checker, pos token.Pos, t @types.Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type-assertion target names a type parameter whose type argument makes it `")
	cb.Write(t.TypeName())
	cb.Write(
			"`, which is not an assertion target (a concrete type, an interface or `any`, or a "
					"`*[]T` / `@[]T` slice)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}
