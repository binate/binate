package "pkg/binate/check"

import "pkg/builtins/testing"

// Real type-assertion typing (check_assert.bn / Slice 4, spec §11.12).
// Concrete targets only; interface targets are interim-rejected (Slice 5).
// Each source declares an interface I with an impl on *T, plus a raw operand
// `rv *I` and a managed operand `mv @I`.

// ASSERT_PREAMBLE is the shared interface + impl + operand declarations; each
// test appends its assertion body inside `f`.
func assertCheck(body *[]readonly char) @Checker {
	var src @[]char = "package \"test\"\n"
			"interface I { foo() }\n"
			"interface J {\n\tfoo()\n\tbar()\n}\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"func (t *T) bar() { }\n"
			"impl *T : I\n"
			"impl *T : J\n"
			"func f(rv *I, mv @I) {\n"
	src = concatAssert(src, body)
	src = concatAssert(src, "\n}\n")
	return checkSrc(src)
}

// concatAssert joins two source fragments (a tiny local helper to avoid pulling
// in a Builder for these short two-part sources).
func concatAssert(a *[]readonly char, b *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(a) + len(b))
	for i := 0; i < len(a); i++ { out[i] = a[i] }
	for i := 0; i < len(b); i++ { out[len(a) + i] = b[i] }
	return out
}

// `*T` borrow from a raw `*I` — legal, yields `*T`.
func TestAssertBorrowFromRaw() testing.TestResult {
	return expectNoErrors(assertCheck("var p *T = rv.(*T); _ = p"))
}

// `*T` borrow from a managed `@I` — legal (borrow from anything), yields `*T`.
func TestAssertBorrowFromManaged() testing.TestResult {
	return expectNoErrors(assertCheck("var p *T = mv.(*T); _ = p"))
}

// `@T` retain from a managed `@I` — legal, yields `@T`.
func TestAssertRetainFromManaged() testing.TestResult {
	return expectNoErrors(assertCheck("var p @T = mv.(@T); _ = p"))
}

// Value recovery of a STRUCT `x.(T)` IS supported — the load is a borrow and the
// destination (here `var p T`) copy-acquires the struct's managed fields, so it is
// refcount-balanced (see conformance 1092).
func TestAssertValueRecoveryStructAccepted() testing.TestResult {
	return expectNoErrors(assertCheck("var p T = rv.(T); _ = p"))
}

// Value recovery of a named type over a POINTER (`type Handle *int`) is accepted:
// a named pointer is boxed as a value (the box points at a Handle), so `.(Handle)`
// loads the Handle out.
func TestAssertValueRecoveryNamedPointerAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface I { foo() }\ntype Handle *int\n"
							"func f(rv *I) { var p Handle = rv.(Handle); _ = p }\n"))
}

// Value recovery of a NAMED MANAGED pointer (`type MH @int`) is accepted the same
// way; IR-gen retains the loaded `@int` (the destination owns a reference).
func TestAssertValueRecoveryManagedNamedAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface I { foo() }\ntype MH @int\n"
							"func f(rv *I) { var p MH = rv.(MH); _ = p }\n"))
}

// Value recovery of a named type over a SLICE, a function value or an interface
// value (`type NS @[]int`, `type F @func() int`, `type X @J`) is accepted: each is
// boxed as a value of its own type, so `.(NS)` loads the NS out.
func TestAssertValueRecoveryNamedSliceFuncIfaceAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface I { foo() }\ninterface J { g() }\n"
							"type NS @[]int\ntype F @func() int\ntype X @J\n"
							"func f(rv *I) { var a NS = rv.(NS); var b F = rv.(F); var c X = rv.(X)\n"
							"_ = a; _ = b; _ = c }\n"))
}

// Value recovery of a SCALAR `x.(int)` IS supported — a plain no-refcount load of
// the pointee (from either a raw `*I` or managed `@I` operand: a scalar copy shares
// no reference), yielding the value type `int`.
func TestAssertValueRecoveryScalar() testing.TestResult {
	return expectNoErrors(assertCheck("var p int = rv.(int); _ = p"))
}

// `readonly` on a value-recovery target recovers the copy into a read-only
// location: a recovered value's outer readonly is freely choosable.
func TestAssertValueRecoveryReadonlyAccepted() testing.TestResult {
	return expectNoErrors(assertCheck("var p readonly int = rv.(readonly int); var q int = p; _ = q"))
}

// Asserting a NON-interface operand is an error.
func TestAssertNonInterfaceOperand() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype T struct { x int }\n"
					"func g(n int) { var p *T = n.(*T); _ = p }\n")
	return expectErrSub(c, "operand must be an interface value")
}

// `@T` retain from a raw `*I` is rejected — no reference to share.
func TestAssertManagedFromRawRejected() testing.TestResult {
	var c @Checker = assertCheck("var p @T = rv.(@T); _ = p")
	return expectErrSub(c, "cannot recover @T from a raw interface value")
}

// An INTERFACE target `x.(*J)` recovers an interface value of J (borrow from a
// raw `*I`).  Typed as `*J` (an interface value, NOT pointer-to-interface): if
// it mis-typed as a pointer, the `var p *J` assignment would reject it.
func TestAssertInterfaceTargetBorrow() testing.TestResult {
	return expectNoErrors(assertCheck("var p *J = rv.(*J); _ = p"))
}

// `@J` interface-target recovery (retain from a managed `@I`).
func TestAssertInterfaceTargetRetain() testing.TestResult {
	return expectNoErrors(assertCheck("var p @J = mv.(@J); _ = p"))
}

// `@J` from a raw `*I` is rejected — same ownership rule as `@T` (no ref to share).
func TestAssertInterfaceManagedFromRawRejected() testing.TestResult {
	var c @Checker = assertCheck("var p @J = rv.(@J); _ = p")
	return expectErrSub(c, "cannot recover @T from a raw interface value")
}

// A SLICE target `*[]char` (§11.12 iface.assert.slice) recovers a slice VALUE;
// legal, yields the raw slice type.
func TestAssertSliceRawTarget() testing.TestResult {
	return expectNoErrors(assertCheck("var p *[]char = rv.(*[]char); _ = p"))
}

// A managed slice `@[]char` is legal from a RAW operand `*I` — UNLIKE a concrete
// `@T` (which needs `@I`): slice recovery acquires a NEW reference on the backing,
// not a share of the box's, so the `@T`-needs-`@I` rule is bypassed for slices.
func TestAssertManagedSliceFromRaw() testing.TestResult {
	return expectNoErrors(assertCheck("var p @[]char = rv.(@[]char); _ = p"))
}

// Element-`readonly` is PRESERVED in the recovered slice type: `:=` infers p's
// type from the assertion, so writing a recovered `*[]readonly char` element is
// rejected — proving the element stayed readonly through the assertion (not just
// via a readonly-declared var).
func TestAssertSliceReadonlyPreserved() testing.TestResult {
	var c @Checker = assertCheck("p := rv.(*[]readonly char)\n\tp[0] = 'x'")
	return expectErrSub(c, "const-typed location")
}

// An element `readonly` on an interface target is rejected — an interface value
// has no inner readonly slot (§11.12 iface.value.no-readonly-slot).
func TestAssertInterfaceReadonlyRejected() testing.TestResult {
	var c @Checker = assertCheck("var p *readonly J = rv.(*readonly J); _ = p")
	return expectErrSub(c, "readonly is not allowed on an interface-value assertion target")
}
