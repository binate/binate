package "pkg/binate/check"

import "pkg/builtins/testing"

// Assertions and conversions through a type parameter are checked for each
// instance (iface.assert.typeparam, conv.typeparam).

// typeParamAssertSrc declares the generics the tests instantiate.
func typeParamAssertSrc(main *[]readonly char) @[]char {
	var head *[]readonly char = "package \"test\"\n"
			"type Thing struct { n int }\n"
			"type Celsius int\n"
			"interface Getter { Get() int }\n"
			"impl *Thing : Getter\n"
			"func (t *Thing) Get() int { return t.n }\n"
			"func as[T any](x @any) T { return x.(T) }\n"
			"func asP[T any](x *any) *T { return x.(*T) }\n"
			"func asM[T any](x @any) @T { return x.(@T) }\n"
			"func ro[T any](x @any) T { return x.(readonly T) }\n"
			"func bits[T any](x uint32) T { return bit_cast(T, x) }\n"
			"func asGetter[T any](x T) *Getter { return unsafe_cast(*Getter, x) }\n"
	return concatAssert(head, main)
}

// In the generic body an assertion naming a type parameter, and a bit_cast or
// unsafe_cast through one, are deferred: with no instance, nothing is reported.
func TestTypeParamAssertionsDeferredInGeneric() testing.TestResult {
	return expectNoErrors(checkSrc(typeParamAssertSrc("func main() {}\n")))
}

// A bare target recovers as its type argument says: `@Thing` by reference,
// `Celsius` by value, `*Getter` as an interface value; a written `*` applies to
// the argument.
func TestTypeParamAssertionInstancesAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					typeParamAssertSrc(
							"func main() {\n"
									" var t @Thing = make(Thing); var a @any = t\n"
									" var r1 @Thing = as[@Thing](a); var r2 Celsius = as[Celsius](a)\n"
									" var r3 @Getter = as[@Getter](a); var w Thing; var p *any = &w\n"
									" var r4 *Thing = asP[Thing](p)\n"
									" _ = r1; _ = r2; _ = r3; _ = r4\n"
									"}\n")))
}

// An instance whose type argument makes the target illegal is rejected.
func TestTypeParamAssertionIllegalInstance() testing.TestResult {
	var r testing.TestResult = expectErrSub(
			checkSrc(
					typeParamAssertSrc(
							"func main() { var t @Thing = make(Thing); var a @any = t; var r [2]int = as[[2]int](a); "
									"_ = r }\n")), "makes it `[2]int`")
	if len(r) > 0 { return r }
	r = expectErrSub(
			checkSrc(
					typeParamAssertSrc(
							"func main() { var t @Thing = make(Thing); var a @any = t; var r @(@Thing) = asM[@Thing]("
									"a); _ = r }\n")), "makes it `@@Thing`, which is not an assertion target")
	if len(r) > 0 { return r }
	return expectErrSub(
			checkSrc(
					typeParamAssertSrc(
							"func main() { var t @Thing = make(Thing); var a @any = t; var r *Thing = ro[*Thing](a); "
									"_ = r }\n")), "makes it `readonly *Thing`")
}

// A bit_cast through a type parameter is checked with each instance's sizes; an
// unsafe_cast to an interface value with each instance's operand.
func TestTypeParamConversionsPerInstance() testing.TestResult {
	var r testing.TestResult = expectNoErrors(
			checkSrc(
					typeParamAssertSrc(
							"func main() { var f float32 = bits[float32](0); var t Thing\n"
									" var g *Getter = asGetter[*Thing](&t); _ = f; _ = g }\n")))
	if len(r) > 0 { return r }
	r = expectErrSub(
			checkSrc(typeParamAssertSrc("func main() { var i int64 = bits[int64](0); _ = i }\n")),
			"the same size (in bits[int64]")
	if len(r) > 0 { return r }
	return expectErrSub(
			checkSrc(typeParamAssertSrc("func main() { var g *Getter = asGetter[int](1); _ = g }\n")),
			"needs a pointer operand (`*T` or `@T`); box a value first (in asGetter[int]")
}
