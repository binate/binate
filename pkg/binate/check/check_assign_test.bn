package "pkg/binate/check"

import "pkg/builtins/testing"

// Assignment / short-variable-declaration checking (check_assign.bn).  The
// comma-ok type-assertion cases live in check_assert_commaok_test.bn.

// A multi-return function-VALUE call destructures across targets exactly like
// a free-function call: hasExpandableResults admits `*func`/`@func`, not just
// TYP_FUNC.  Pre-fix `a, b := fv()` was rejected with "assignment count
// mismatch" (plan-cr2-1 Defect 4).
func TestCheckFuncValueMultiReturnShortVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func mr() (int, int) { return 1, 2 }\n"
			"func f() { var fv @func() (int, int) = mr\n"
			"\ta, b := fv()\n"
			"\t_ = a; _ = b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncValueMultiReturnAssign() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func mr() (int, int) { return 1, 2 }\n"
			"func f() { var fv @func() (int, int) = mr\n"
			"\tvar a int = 0\n\tvar b int = 0\n"
			"\ta, b = fv()\n"
			"\t_ = a; _ = b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckAssign() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var x int = 0; x = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckShortVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { x := 42; var y int = x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A name repeated on the left of one `:=` — the parallel form or the
// multi-return form — or as both of a range loop's variables is one error per
// repeat (decl.shortvar.duplicate, stmt.for.in.duplicate).
func TestCheckRepeatedBindingRejected() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 3)
	srcs[0] = "package \"test\"\nfunc f() int {\n\ta, a := 1, 2\n\treturn a\n}\n"
	srcs[1] = "package \"test\"\nfunc two() (int, int) { return 1, 2 }\n"
			"func f() int {\n\tq, q := two()\n\treturn q\n}\n"
	srcs[2] = "package \"test\"\nfunc f(xs *[]int) int {\n\tvar t int = 0\n"
			"\tfor i, i in xs {\n\t\tt = t + i\n\t}\n\treturn t\n}\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if len(c.CheckerErrors()) != 1 {
			return fail("a name bound twice by one statement must be one error")
		}
	}
	return ""
}

// `_` binds nothing, so it may repeat on the left of `:=` and as both range
// variables.
func TestCheckRepeatedBlankBindingAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc two() (int, int) { return 1, 2 }\n"
					"func f(xs *[]int) int {\n\t_, _ := two()\n\t_, _ := 3, 4\n"
					"\tvar n int = 0\n\tfor _, _ in xs {\n\t\tn = n + 1\n\t}\n\treturn n\n}\n")
	return expectNoErrors(c)
}
