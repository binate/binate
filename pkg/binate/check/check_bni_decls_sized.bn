package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"

// A package interface's declarations are judged as its importers see them
// (pkg.bni.self-contained): a function, method or variable the `.bni` declares
// and the `.bn` defines is carried in the package's merged declarations only as
// the `.bn`'s definition, judged in the `.bn`'s view, where the package's own
// opaque exports are not opaque.  So the `.bni`'s declaration is held to the
// opaque rules and the size limit too, in the `.bni`'s view — the error lands
// where the signature importers use is written, not at each importer's call.

// checkBniDeclsSized holds the package interface bni's non-generic function,
// method and variable declarations to the opaque rules and the size limit in its
// own view (requireFuncDeclSized, requireSizedType).  A generic one is judged at
// its declaration with its own parts (requireGenericFuncSigKept,
// requireGenericMethodSigKept); one the `.bn` does not define is in the merged
// declarations already, and judged again here to the same errors.
func checkBniDeclsSized(c @Checker, bni @ast.File) {
	if bni == nil { return }
	var savedScope @Scope = c.Scope
	var s @Scope = scopeForFileOrNil(c, filePathOf(bni))
	if s != nil {
		c.Scope = s
	} else {
		c.Scope = NewScope(c.PackageScope)
		c.Scope.InterfaceView = true
	}
	checkBniDeclListSized(c, bni.Decls)
	c.Scope = savedScope
}

// checkBniDeclListSized is checkBniDeclsSized over decls, groups included.
func checkBniDeclListSized(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d == nil { continue }
		if d.Kind == ast.DECL_GROUP {
			checkBniDeclListSized(c, d.Decls)
		} else if d.Kind == ast.DECL_FUNC && len(d.TypeParams) == 0 &&
				(d.Recv == nil || receiverBaseInstantiation(d.Recv.Type) == nil) {
			requireFuncDeclSized(c, d)
		} else if d.Kind == ast.DECL_VAR && d.TypeRef != nil {
			requireSizedType(c, resolveTypeExpr(c, d.TypeRef), d.Pos)
		}
	}
}

// requireFuncDeclSized holds the non-generic function or method declaration
// d's receiver, parameters and results to the opaque rules and the size limit
// (requireSizedType), and its results together to the size limit.  A value
// receiver is a parameter: a method of `Opaque` (or of `type O Opaque`) would
// take an opaque value.  A pointer or handle receiver points to the method's own
// type, which its declaration checks.
func requireFuncDeclSized(c @Checker, d @ast.Decl) {
	if d.Recv != nil {
		var rt @types.Type = resolveTypeExpr(c, d.Recv.Type)
		if !isPointerOrHandle(rt) {
			requireSizedType(c, rt, d.Pos)
		}
	}
	for j := 0; j < len(d.Params); j++ {
		requireSizedType(c, resolveTypeExpr(c, d.Params[j].Type), d.Pos)
	}
	var rs @[]@types.Type = make_slice(@types.Type, len(d.Results))
	for j := 0; j < len(d.Results); j++ {
		rs[j] = resolveTypeExpr(c, d.Results[j])
		requireSizedType(c, rs[j], d.Pos)
	}
	requireFittingResults(c, rs, d.Pos)
}
