package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for check_bni_decls_sized.bn: a package interface's declarations are
// judged as its importers see them.

// q's .bni declares functions, methods and variables over its opaque export Op
// that its .bn defines: each one that uses Op by value (a value receiver, a
// variable in a group) or points to two of them is rejected at the .bni, though
// the .bn's definition sees Op's layout; a pointer to Op is fine.
func TestCheckBniDeclsJudgedInBniView() testing.TestResult {
	var c @Checker = checkBniMethodPkgIn(NewChecker(),
			"package \"q\"\ntype Op\ntype T struct { n int }\nfunc Get() Op\nfunc Ptr() *Op\n"
					"func Run(cb *func(Op) int) int\nfunc (t *T) Take(o Op) int\nvar V *([2]Op)\n"
					"func (o Op) X() int\nvar (\n\tA Op\n)\n",
			"package \"q\"\ntype Op struct { v int }\nfunc Get() Op {\n\tvar o Op\n\treturn o\n}\n"
					"func Ptr() *Op { return nil }\nfunc Run(cb *func(Op) int) int { return 0 }\n"
					"func (t *T) Take(o Op) int { return o.v }\nvar V *([2]Op)\n"
					"func (o Op) X() int { return o.v }\nvar A Op\n",
			false)
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if !types.CharEq(errs[i].Pos.File, "test.bni") || errs[i].Pos.Line == 5 {
			return fail(errs[i].Msg)
		}
	}
	if len(errs) != 6 { return fail("expected Get, Run, Take, V, X and A rejected at the .bni") }
	return ""
}
