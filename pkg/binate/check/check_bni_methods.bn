package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/std/vec"

// checkBniMethodDecls checks the package's `.bni` method declarations
// (pkg.bni.consistency) and generic definitions (pkg.bni.generic.once).  The
// loader pairs a `.bni` method with the `.bn` method of its name and receiver
// base name and leaves the `.bni` one out of the merged file, so nothing else
// checks that declaration: this reports one the `.bni` declares twice, one with
// type parameters of its own or a receiver that is not a type of this package,
// and one whose receiver or signature differs from the `.bn` method — an
// importer reads the `.bni` signature, so it would misread the method.  A
// declaration the loader prepended to merged (the `.bn` does not define it) is
// collected as the package's own, which checks it.  Each is resolved in the
// `.bni`'s file scope, as a program that has only the interface sees it
// (bni_view.bn).  A generic function or method of a generic type is defined in
// the `.bni` or the `.bn`, never both (pkg.bni.generic.once): one the loader
// left out of merged — the `.bn` defines one of its name too — is reported.
// Runs after pass 1, so the `.bn` methods are on their types' method sets.
func checkBniMethodDecls(c @Checker, bni @ast.File, merged @ast.File) {
	if bni == nil || merged == nil || same(bni, merged) { return }
	var inMerged @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	for i := 0; i < len(merged.Decls); i++ { inMerged.Push(merged.Decls[i]) }
	var seen @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	var seenBase @vec.Vec[@types.Type] = vec.New[@types.Type]()
	for i := 0; i < len(bni.Decls); i++ {
		var d @ast.Decl = bni.Decls[i]
		if d.Kind != ast.DECL_FUNC { continue }
		if isGenericDefinition(d) {
			if !declInVec(inMerged, d) { reportGenericDefinedTwice(c, d) }
			continue
		}
		if d.Recv == nil { continue }
		var defined bool = !declInVec(inMerged, d)
		if defined && len(d.TypeParams) > 0 {
			addCheckError(c, d.Pos, "methods cannot have type parameters")
			continue
		}
		if isBlank(d.Name) { continue }
		if fileScopedActive(c) { c.Scope = scopeForFile(c, d.Pos.File) }
		var base @types.Type
		if defined {
			base = resolveMethodReceiver(c, d)
		} else {
			base = methodBaseTypeForDecl(c, d)
		}
		if base != nil && !bniMethodRedeclared(c, seen, seenBase, inMerged, d, base) {
			seen.Push(d)
			seenBase.Push(base)
			if defined { checkBniMethodMatch(c, d, base) }
		}
		c.Scope = c.PackageScope
	}
}

// isGenericDefinition reports whether the function declaration d is generic —
// a free function with type parameters, or a method of a generic type — so that
// a `.bni` carries its body (pkg.bni.generic).  A method with type parameters of
// its own is not: methods cannot have them, which is reported instead.
func isGenericDefinition(d @ast.Decl) bool {
	if d.Recv == nil { return len(d.TypeParams) > 0 }
	return len(d.TypeParams) == 0 && receiverBaseInstantiation(d.Recv.Type) != nil
}

// reportGenericDefinedTwice reports the `.bni` generic d, which the `.bn`
// defines too.
func reportGenericDefinedTwice(c @Checker, d @ast.Decl) {
	var cb @strings.Builder = strings.NewBuilder()
	if d.Recv == nil {
		cb.Write("generic function ")
		cb.Write(d.Name)
	} else {
		// The receiver's generic type as written, another package's included.
		var inst @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
		cb.Write("method ")
		cb.Write(d.Name)
		cb.Write(" of generic type ")
		if inst != nil && inst.Base != nil {
			if len(inst.Base.Pkg) > 0 {
				cb.Write(inst.Base.Pkg)
				cb.Write(".")
			}
			cb.Write(inst.Base.Name)
		}
	}
	cb.Write(" is defined in both the .bni and the .bn")
	addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
}

// bniMethodRedeclared reports, at d, a method an earlier `.bni` declaration in
// seen (on the base type at the same index of seenBase) already declares on
// base, and says whether there was one.  When both declarations are in the
// merged file, collecting the package's own methods reports the second, so this
// does not report it again.
func bniMethodRedeclared(c @Checker, seen @vec.Vec[@ast.Decl], seenBase @vec.Vec[@types.Type],
		inMerged @vec.Vec[@ast.Decl], d @ast.Decl, base @types.Type) bool {
	for j := 0; j < seen.Len(); j++ {
		var e @ast.Decl = seen.Get(j)
		if !types.CharEq(e.Name, d.Name) || !same(seenBase.Get(j), base) { continue }
		if !declInVec(inMerged, d) || !declInVec(inMerged, e) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("method ")
			cb.Write(d.Name)
			cb.Write(" redeclared on type ")
			cb.Write(base.TypeName())
			cb.Write(" in the package interface")
			addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		}
		return true
	}
	return false
}

// checkBniMethodMatch reports a `.bni` method declaration d whose receiver or
// signature differs from the `.bn` method of its name on base.
func checkBniMethodMatch(c @Checker, d @ast.Decl, base @types.Type) {
	var m @types.Method = base.LookupMethod(d.Name)
	// The loader paired d with a `.bn` method of its name on base, so m is
	// missing only when that method failed to register, which collecting it
	// reported.
	if m == nil { return }
	var label @[]char = buf.Concat(buf.Concat(base.TypeName(), "."), d.Name)
	var recvType @types.Type = resolveTypeExpr(c, d.Recv.Type)
	if isErrType(recvType) { return }
	if !sigTypeIdenticalStrict(recvType, m.RecvType) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(label)
		cb.Write(": receiver mismatch: .bni has ")
		cb.Write(recvType.QualifiedTypeName())
		cb.Write(" but .bn has ")
		cb.Write(m.RecvType.QualifiedTypeName())
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		return
	}
	// m.FuncType carries the receiver as its first parameter.
	checkBniSigMatch(c, d.Pos, label, resolveFuncDeclType(c, d), m.FuncType, 1)
}
