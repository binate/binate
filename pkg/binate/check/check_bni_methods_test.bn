package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for check_bni_methods.bn.  mkBniFile / charsHaveSub live in
// bni_scope_test.bn.

// checkBniMethodPkg checks package q from bniSrc (q.bni) and bnSrc (its one
// .bn), the .bni's method declarations left out of the merged file as the loader
// leaves out one the .bn defines.
func checkBniMethodPkg(bniSrc *[]readonly char, bnSrc *[]readonly char) @Checker {
	return checkBniMethodPkgIn(NewChecker(), bniSrc, bnSrc, false)
}

// checkBniMethodPkgIn is checkBniMethodPkg on c, which may have other packages
// loaded; with extern set, the .bni's types, its bodiless methods and its
// methods of generic types are prepended to the merged file, as the loader
// prepends them.
func checkBniMethodPkgIn(c @Checker, bniSrc *[]readonly char, bnSrc *[]readonly char,
		extern bool) @Checker {
	var bni @ast.File = mkBniFile(bniSrc)
	var b @[]uint8 = make_slice(uint8, len(bnSrc))
	for i := 0; i < len(bnSrc); i++ { b[i] = cast(uint8, bnSrc[i]) }
	var p @parser.Parser = parser.New(b, "q.bn")
	var bn @ast.File = p.ParseFile()
	if extern {
		var ds @[]@ast.Decl = make_slice(@ast.Decl, 0)
		for i := 0; i < len(bni.Decls); i++ {
			var d @ast.Decl = bni.Decls[i]
			if d.Kind == ast.DECL_TYPE ||
					d.Kind == ast.DECL_FUNC && d.Recv != nil &&
							(d.Body == nil || receiverBaseInstantiation(d.Recv.Type) != nil) {
				ds = slices.Append[@ast.Decl](ds, d)
			}
		}
		for i := 0; i < len(bn.Decls); i++ { ds = slices.Append[@ast.Decl](ds, bn.Decls[i]) }
		bn.Decls = ds
	}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = bn
	c.LoadPackageInterface("q", bni)
	c.CheckPackage("q", bn, files, bni)
	return c
}

// errsIn expects c to report exactly one error, containing want.
func errsIn(c @Checker, want *[]readonly char) testing.TestResult {
	if len(c.CheckerErrors()) != 1 { return fail("expected exactly one error") }
	if !charsHaveSub(c.CheckerErrors()[0].Msg, want) { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// checkerWithR returns a checker with package pkg/r (types T and U) loaded.
func checkerWithR() @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/r",
			mkBniFile("package \"pkg/r\"\ntype T struct { v int }\ntype U struct { x int }\n"))
	return c
}

// bniMethodErr runs checkBniMethodPkg and expects exactly one error, containing
// want.
func bniMethodErr(bniSrc *[]readonly char, bnSrc *[]readonly char,
		want *[]readonly char) testing.TestResult {
	return errsIn(checkBniMethodPkg(bniSrc, bnSrc), want)
}

// The .bn type and method every case below declares.
var bniMethodBn *[]readonly char = "package \"q\"\n"
		"func (t @T) Get() int { return t.v }\n"

// A .bni method declaration matching the .bn's definition is accepted.
func TestBniMethodMatches() testing.TestResult {
	var c @Checker = checkBniMethodPkg(
			"package \"q\"\ntype T struct { v int }\nfunc (t @T) Get() int\n", bniMethodBn)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A method the .bni declares twice is reported once, at the second.
func TestBniMethodRedeclared() testing.TestResult {
	return bniMethodErr(
			"package \"q\"\ntype T struct { v int }\nfunc (t @T) Get() int\nfunc (t @T) Get() int\n",
			bniMethodBn, "method Get redeclared on type T in the package interface")
}

// A .bni declaration whose receiver, parameter count or type, result count or
// type, or variadic-ness differs from the .bn's definition is reported.
func TestBniMethodMismatch() testing.TestResult {
	var r testing.TestResult = bniMethodErr(
			"package \"q\"\ntype T struct { v int }\nfunc (t *T) Get() int\n", bniMethodBn,
			"T.Get: receiver mismatch")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) Get(x int) int\n",
			bniMethodBn, "T.Get: .bn has 0 parameters but .bni declares 1")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) Get() (int, bool)\n",
			bniMethodBn, "T.Get: .bn has 1 return values but .bni declares 2")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) Get() bool\n", bniMethodBn,
			"T.Get: return type 0 mismatch: .bni has bool but .bn has int")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) F(xs ...int)\n",
			"package \"q\"\nfunc (t @T) F(xs *[]int) { }\n",
			"T.F: .bni and .bn disagree on variadic parameter")
	if len(r) > 0 { return r }
	return bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) Set(v int)\n",
			"package \"q\"\nfunc (t @T) Set(v bool) { }\n", "T.Set: parameter 0 type mismatch")
}

// A .bni method with type parameters of its own is rejected, as the .bn's would
// be; one the .bn so declares is reported there alone, not again as missing.
func TestBniMethodTypeParams() testing.TestResult {
	var r testing.TestResult = bniMethodErr(
			"package \"q\"\ntype T struct { v int }\nfunc (t @T) Get[U any]() int { return 0 }\n",
			bniMethodBn, "methods cannot have type parameters")
	if len(r) > 0 { return r }
	return bniMethodErr("package \"q\"\ntype T struct { v int }\nfunc (t @T) Get() int\n",
			"package \"q\"\nfunc (t @T) Get[U any]() int { return t.v }\n",
			"methods cannot have type parameters")
}

// A .bni method on another package's type is rejected even though the loader
// pairs it, by its receiver's base name, with the .bn's method.
func TestBniMethodForeignReceiver() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(checkerWithR(),
					"package \"q\"\nimport \"pkg/r\"\ntype T struct { v int }\nfunc (t @r.T) Get() int\n",
					bniMethodBn, false), "cannot define methods on types from other packages")
}

// A .bni method's signature resolves under the .bni's own imports.
func TestBniMethodUsesBniImports() testing.TestResult {
	var c @Checker = checkBniMethodPkgIn(checkerWithR(),
			"package \"q\"\nimport rr \"pkg/r\"\ntype T struct { v int }\nfunc (t @T) Use(u @rr.U) int\n",
			"package \"q\"\nimport \"pkg/r\"\n"
					"func (t @T) Use(u @r.U) int { return u.x }\n",
			false)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A method the .bni declares twice and the .bn does not define is in the merged
// file both times, so collecting it reports the second; this check does not
// report it again.
func TestBniMethodExternRedeclaredOnce() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(NewChecker(),
					"package \"q\"\ntype T struct { v int }\nfunc (t @T) Ext() int\nfunc (t @T) Ext() int\n",
					bniMethodBn, true), "method Ext redeclared on type T")
}
