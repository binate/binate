package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"

// checkBniSignatureMatch checks that a .bn function definition matches
// its .bni declaration's signature (parameter and return types).
//
// REPL bypass: when c.AllowRedef is set (CheckDeclInScope sets it),
// the check returns silently — re-typing a func at the prompt
// is a redefinition, not a .bni-vs-.bn mismatch, and the
// "X: .bni declares N" wording would be misleading.
func checkBniSignatureMatch(c @Checker, d @ast.Decl, bnType @types.Type) {
	if c.AllowRedef { return }
	// The `.bni` symbol lives in the package scope; under file-scoped imports
	// c.Scope is the decl's file scope, so look in the package scope.
	var existing @Symbol = pkgScopeLookupLocal(c, d.Name)
	if existing == nil { return }
	if existing.Kind != types.SYM_FUNC { return }
	var bniType @types.Type = existing.Type
	if bniType == nil || bniType.Kind != types.TYP_FUNC { return }
	checkBniSigMatch(c, d.Pos, d.Name, bniType, bnType, 0)
}

// checkBniSigMatch reports, at pos, where the signature bniType that the
// package interface declares for label differs from bnType, the .bn
// definition's: the parameter count and types, the result count and types, and
// variadic-ness.  bnType's parameters are compared from index bnFirst — 1 for a
// method, whose function type carries the receiver as its first parameter.
func checkBniSigMatch(c @Checker, pos token.Pos, label *[]readonly char, bniType @types.Type,
		bnType @types.Type, bnFirst int) {
	// Compare parameter count
	var bniParams int = len(bniType.Params)
	var bnParams int = len(bnType.Params) - bnFirst
	if bniParams != bnParams {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(label)
		cb.Write(": .bn has ")
		stringutils.WriteInt(cb, bnParams)
		cb.Write(" parameters but .bni declares ")
		stringutils.WriteInt(cb, bniParams)
		addCheckError(c, pos, buf.CopyStr(cb.String()))
		return
	}

	// Compare parameter types.  A type already reported (an undefined name, say)
	// is not compared again.
	for i := 0; i < bniParams; i++ {
		var bniParam @types.Type = bniType.Params[i].Type
		var bnParam @types.Type = bnType.Params[i + bnFirst].Type
		if isErrType(bniParam) || isErrType(bnParam) { continue }
		if !sigTypeIdenticalStrict(bniParam, bnParam) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(label)
			cb.Write(": parameter ")
			stringutils.WriteInt(cb, i)
			cb.Write(" type mismatch: .bni has ")
			cb.Write(bniParam.QualifiedTypeName())
			cb.Write(" but .bn has ")
			cb.Write(bnParam.QualifiedTypeName())
			addCheckError(c, pos, buf.CopyStr(cb.String()))
		}
	}

	// Compare result count
	var bniResults int = len(bniType.Results)
	var bnResults int = len(bnType.Results)
	if bniResults != bnResults {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(label)
		cb.Write(": .bn has ")
		stringutils.WriteInt(cb, bnResults)
		cb.Write(" return values but .bni declares ")
		stringutils.WriteInt(cb, bniResults)
		addCheckError(c, pos, buf.CopyStr(cb.String()))
		return
	}

	// Compare result types
	for i := 0; i < bniResults; i++ {
		if isErrType(bniType.Results[i]) || isErrType(bnType.Results[i]) { continue }
		if !sigTypeIdenticalStrict(bniType.Results[i], bnType.Results[i]) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(label)
			cb.Write(": return type ")
			stringutils.WriteInt(cb, i)
			cb.Write(" mismatch: .bni has ")
			cb.Write(bniType.Results[i].QualifiedTypeName())
			cb.Write(" but .bn has ")
			cb.Write(bnType.Results[i].QualifiedTypeName())
			addCheckError(c, pos, buf.CopyStr(cb.String()))
		}
	}

	// Compare variadic-ness: a `.bni` `f(xs ...int)` and a `.bn` `f(xs *[]int)`
	// are different signatures (func.variadic.identity).  Param counts already
	// match, so this is purely the last param's variadic flag.
	if types.FuncIsVariadic(bniType) != types.FuncIsVariadic(bnType) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(label)
		cb.Write(": .bni and .bn disagree on variadic parameter")
		addCheckError(c, pos, buf.CopyStr(cb.String()))
	}
}
