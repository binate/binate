package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_bni_sig.bn.  checkBniMethodPkg / bniMethodErr live in
// check_bni_methods_test.bn.

// A .bn function that differs from its .bni declaration is reported with the
// difference: the parameter count, a parameter type, the result count, a result
// type, or variadic-ness.
func TestBniFuncSigMismatch() testing.TestResult {
	var bn *[]readonly char = "package \"q\"\nfunc F(a int) int { return a }\n"
	var r testing.TestResult = bniMethodErr("package \"q\"\nfunc F() int\n", bn,
			"F: .bn has 1 parameters but .bni declares 0")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\nfunc F(a bool) int\n", bn,
			"F: parameter 0 type mismatch: .bni has bool but .bn has int")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\nfunc F(a int)\n", bn,
			"F: .bn has 1 return values but .bni declares 0")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\nfunc F(a int) bool\n", bn,
			"F: return type 0 mismatch: .bni has bool but .bn has int")
	if len(r) > 0 { return r }
	return bniMethodErr("package \"q\"\nfunc G(xs ...int)\n", "package \"q\"\nfunc G(xs *[]int) { }\n",
			"G: .bni and .bn disagree on variadic parameter")
}

// A parameter or result type already reported (an undefined name) is not also
// reported as a mismatch — on a function or a method, in the .bni or the .bn.
func TestBniSigSkipsErrorTypes() testing.TestResult {
	var r testing.TestResult = bniMethodErr("package \"q\"\nfunc F(a @Undef) int\n",
			"package \"q\"\nfunc F(a int) int { return a }\n", "undefined: Undef")
	if len(r) > 0 { return r }
	r = bniMethodErr("package \"q\"\nfunc R() @Undef\n", "package \"q\"\nfunc R() int { return 0 }\n",
			"undefined: Undef")
	if len(r) > 0 { return r }
	var bniT *[]readonly char = "package \"q\"\ntype T struct { v int }\n"
	r = bniMethodErr(buf.Concat(bniT, "func (t @T) Use(u @Undef) int\n"),
			"package \"q\"\nfunc (t @T) Use(u int) int { return u }\n", "undefined: Undef")
	if len(r) > 0 { return r }
	return bniMethodErr(buf.Concat(bniT, "func (t @T) Use(u int) int\n"),
			"package \"q\"\nfunc (t @T) Use(u @Undef) int { return 0 }\n", "undefined: Undef")
}
