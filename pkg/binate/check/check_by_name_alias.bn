package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// The by-name walk's call that resolves a pending alias named before its declaration is
// reached (resolvePendingAliasNamed, check_pending_alias.bn): marked as being resolved,
// it first resolves what its target reads, in the order its resolution reads it
// (check_by_name_reads.bn) -- the pending aliases its target names, each the same way,
// and in a batch the constants and the types whose layouts the target's array lengths
// read -- so that a chain of aliases (`type A0 = A1`, `type A1 = A2`, ...) of any length
// is resolved with no recursion.  One named while it is being resolved is left to the
// read that names it, which reports the alias recursive, as it would have.

// stepAlias runs the pending alias's call k to its next call or its end.
func stepAlias(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if !startAlias(c, k) {
			byNameReturn(k)
			return
		}
		k.pc = byNameLoopConsts
	}
	for k.i < k.reads.count() {
		var at int = k.i
		k.i = k.i + 1
		var next int = pushReadFrom(c, k, at, true)
		if next == byNameReadPushed { return }
		if next == byNameReadStop { k.i = k.reads.count() }
	}
	finishAlias(c, k)
	byNameReturn(k)
}

// startAlias starts the pending alias's call k: it reports whether the alias k.name is
// to be resolved -- one of the batch's pending aliases, neither resolved nor being
// resolved, named in its own package where the name still reaches its own binding (its
// placeholder; for an interface alias, nothing) -- and if so enters its declaration's
// scope and a demand frame, as resolvePendingAliasNamed resolves it, marks it as being
// resolved, and finds what its target reads (k.reads), unless an instance is being
// built.
func startAlias(c @Checker, k @byNameCall) bool {
	var i int = pendingAliasIdx(c, k.name)
	if i < 0 { return false }
	var reg @PendingAliases = c.PendingAliases
	if reg.States[i] != ALIAS_PENDING || !types.CharEq(c.curPkgPath, reg.PkgPath) { return false }
	var bound @Symbol = c.Scope.Lookup(k.name)
	if reg.Decls[i].Kind == ast.DECL_TYPE {
		if bound == nil || bound.Type != reg.Placeholders[i] { return false }
	} else if bound != nil {
		return false
	}
	var d @ast.Decl = reg.Decls[i]
	k.d = d
	k.alias = i
	k.reg = reg
	k.scope = c.Scope
	c.Scope = reg.Scope
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, d.Pos.File)
	}
	k.ds = reg.BniScope
	if k.ds == nil {
		k.ds = declScope(c)
	}
	k.prev = k.ds.LookupLocal(d.Name)
	if reg.BniScope != nil {
		k.bniPrev = saveBniBinding(reg.BniScope, reg.Scope, d.Name)
	}
	k.framed = enterDemandFrame(c)
	reg.States[i] = ALIAS_RESOLVING
	if !buildingInstances(c) {
		collectTypeExprReads(c, d.TypeRef, &k.reads)
	}
	return true
}

// finishAlias resolves the alias of the call k, what its target reads resolved, as
// resolvePendingAliasNamed resolves it -- in the `.bni`'s scope for a `.bni`'s -- and
// undoes it when that read a layout not built yet, inside an instance's build
// (leaveDemandFrame): its name is bound as before, and the alias is pending again.  So
// is one whose declaration did not begin resolving its target (beginAliasDecl).
func finishAlias(c @Checker, k @byNameCall) {
	var reg @PendingAliases = k.reg
	var d @ast.Decl = k.d
	if reg.BniScope != nil {
		if d.Kind == ast.DECL_TYPE {
			resolveTypeDeclInScope(c, reg.BniScope, d)
		} else {
			resolveInterfaceDeclInScope(c, reg.BniScope, d)
		}
	} else if d.Kind == ast.DECL_TYPE {
		collectTypeDecl(c, d)
	} else {
		collectInterfaceDecl(c, d)
	}
	if reg.States[k.alias] == ALIAS_RESOLVING {
		reg.States[k.alias] = ALIAS_PENDING
	}
	if leaveDemandFrame(c, k.framed) {
		if reg.BniScope != nil {
			restoreBniBinding(c, reg.BniScope, reg.Scope, d.Name, k.bniPrev)
		} else {
			restoreBinding(k.ds, d.Name, k.prev)
		}
		reg.States[k.alias] = ALIAS_PENDING
		ast.ClearCheckerAnnotations(d)
	}
	c.Scope = k.scope
}
