package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_by_name_alias.bn: chains of aliases, each resolved after the alias
// its target names, walked with no recursion.

// A type reading the size of the first of a long chain of aliases, each naming the
// next, has the size of what the last one denotes.
func TestDeepAliasChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\nconst Z = sizeof(X)\ntype X struct { a [sizeof(A0)]uint8 }\n",
					"type A", " = A", "", byNameLevels, " = int64\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 8)
}

// So is a chain reached in its turn, each alias named by the one before it.
func TestDeepAliasChainInTurn() testing.TestResult {
	return errCount(
			checkSrc(
					linkChainSrc("package \"main\"\n", "type A", " = A", "", byNameLevels,
							" = int64\nvar v A0\n")), 0)
}

// So is a chain of interface aliases.
func TestDeepIfaceAliasChain() testing.TestResult {
	return errCount(
			checkSrc(
					linkChainSrc("package \"main\"\n", "interface J", " = J", "", byNameLevels,
							" { M() }\nfunc use(x *J0) { x.M() }\n")), 0)
}

// So is a `.bni`'s chain of aliases, whose first a type reads the size of.
func TestDeepBniAliasChain() testing.TestResult {
	c, pkgScope := loadChainBni(
			linkChainSrc(
					"package \"pkg/q\"\nconst Z uint = sizeof(X)\ntype X struct { a [sizeof(A0)]uint8 }\n",
					"type A", " = A", "", byNameLevels, " = int64\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if pkgScope == nil { return fail("pkg/q scope missing") }
	return constIs(pkgScope.Lookup("Z"), "Z", 8)
}

// A long chain whose last alias names the first is a recursive alias, reported once,
// where the last names it.
func TestDeepAliasChainCycle() testing.TestResult {
	var c @Checker = checkSrc(
			linkChainSrc("package \"main\"\n", "type A", " = A", "", byNameLevels, " = A0\n"))
	if !errAtLine(c, byNameLevels + 2, "invalid recursive type alias A0") {
		return fail("the recursive alias is reported where the last names A0")
	}
	return errCount(c, 1)
}

// An alias being resolved, named again in a read made ahead, is left to that read,
// which reports it recursive, and the reads after it stay in place: A's recursion is
// reported before K's cycle, as without the walk.
func TestAliasBeingResolvedStopsReads() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype A = [sizeof(T)]uint8\ntype T [sizeof(*A) + K]uint8\n"
					"const K = sizeof(T)\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 || errs[0].Pos.Line != 3 || errs[1].Pos.Line != 4 {
		return fail("A's recursion is reported before K's cycle")
	}
	if !streq(errs[0].Msg, "invalid recursive type alias A") { return fail("A is reported recursive") }
	return ""
}
