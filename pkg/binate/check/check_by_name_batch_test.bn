package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_by_name_batch.bn: chains of a batch's type declarations whose array
// lengths read the next type's layout, directly or through a constant, each collected
// after the next, walked with no recursion.

// byNameBatchLevels is how long the tests' chains are: past where a type's collection
// recursed, through the read its array length makes, into the next type's collection
// and ran out of stack (some 400 types through constants, some 900 directly).
const byNameBatchLevels int = 4000

// sizeofConstChainSrc returns a program declaring head, after the package clause, then
// n types T0 .. T<n - 1>, each an array as long as the constant after it, the size of
// the next type -- `type T<i> [C<i + 1>]uint8`, `const C<i + 1> = sizeof(T<i + 1>)` --
// then `type T<n><last>`.
func sizeofConstChainSrc(head *[]readonly char, n int, last *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	b.Write(head)
	for i := 0; i < n; i++ {
		writeLink(b, "type T", i, " [C", i + 1, "]uint8")
		writeLink(b, "const C", i + 1, " = sizeof(T", i + 1, ")")
	}
	b.Write("type T")
	b.Write(strconv.Itoa(n))
	b.Write(last)
	return buf.CopyStr(b.String())
}

// A type reading the size of the first of a long chain of types, each an array as long
// as the next's size, is collected after the whole chain.
func TestDeepSizeofChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\nconst Z = sizeof(X)\ntype X struct { a [sizeof(T0)]uint8 }\n",
					"type T", " [sizeof(T", ")]uint8", byNameBatchLevels, " uint8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 1)
}

// So is the first of a long chain of types each an array as long as a constant, the
// size of the next type.
func TestDeepConstSizeofTypeChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			sizeofConstChainSrc("const Z = sizeof(T0)\n", byNameBatchLevels, " uint8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 1)
}

// So is the first of a long chain of structs, each holding a type as long as the next
// struct's size: the struct whose layout is read is collected with the types it holds.
func TestDeepSizeofStructFieldChain() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nconst Z = sizeof(S0)\n")
	for i := 0; i < byNameBatchLevels; i++ {
		writeLink(b, "type S", i, " struct { t T", i, " }")
		writeLink(b, "type T", i, " [sizeof(S", i + 1, ")]uint8")
	}
	b.Write("type S")
	b.Write(strconv.Itoa(byNameBatchLevels))
	b.Write(" struct { v uint8 }\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(b.String()))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 1)
}

// A long chain of types each as long as the next's size, whose last reads the first's
// size, is a cycle, reported once, where the last reads it.
func TestDeepSizeofChainCycle() testing.TestResult {
	var c @Checker = checkSrc(
			linkChainSrc("package \"main\"\ntype X struct { a [sizeof(T0)]uint8 }\n", "type T", " [sizeof(T",
					")]uint8", byNameBatchLevels, " [sizeof(T0)]uint8\n"))
	if !errAtLine(c, byNameBatchLevels + 3, "cyclic type definition involving `T0`") {
		return fail("the cycle is reported where the last type reads T0")
	}
	return errCount(c, 1)
}

// So is a long chain alternating types and constants whose last type's length is a
// constant, before the chain, reading the first type's size: reported where that
// constant reads it.
func TestDeepConstSizeofTypeChainCycle() testing.TestResult {
	var c @Checker = checkSrc(
			sizeofConstChainSrc("const C0 = sizeof(T0)\n", byNameBatchLevels, " [C0]uint8\n"))
	if !errAtLine(c, 2, "cyclic type definition involving `T0`") {
		return fail("the cycle is reported where C0 reads T0")
	}
	return errCount(c, 1)
}

// A type's array lengths' reads are resolved in the order its collection evaluates
// them: here V's, whose own read of U closes a cycle, before C's, as U is reached
// first through V and reported for reading V.
func TestByNameBatchReadsInOrder() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype T struct {\n\ta [sizeof(V)]uint8\n\tb [C]uint8\n}\n"
					"const C = sizeof(U)\ntype V [sizeof(U)]uint8\ntype U [sizeof(V)]uint8\n")
	if !errAtLine(c, 8, "cyclic type definition involving `V`") {
		return fail("the cycle is reported where U reads V")
	}
	return errCount(c, 1)
}

// So are their errors reported: V's before C's.
func TestByNameBatchErrorsInOrder() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype T struct {\n\ta [sizeof(V)]uint8\n\tb [C]uint8\n}\n"
					"const C = undefinedY\ntype V [undefinedX]uint8\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) < 2 || errs[0].Pos.Line != 7 || errs[1].Pos.Line != 6 {
		return fail("V's error is reported before C's")
	}
	return ""
}

// An alias's array lengths are read where its target is resolved, the alias marked as
// being resolved: a type reading it back is a recursive alias.
func TestByNameBatchAliasReadsInPlace() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\ntype A = [sizeof(T)]uint8\ntype T [sizeof(A)]uint8\n")
	if !errAtLine(c, 3, "invalid recursive type alias A") {
		return fail("the alias read back is reported")
	}
	return errCount(c, 1)
}

// A named type's arguments are not read in advance: they are resolved only where it
// names a generic, and Foo names none.
func TestByNameBatchTypeArgsNotRead() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\ntype T Foo[[C]int]\nconst C = sizeof(T)\n")
	if !errAtLine(c, 2, "undefined: Foo") {
		return fail("Foo is reported undefined")
	}
	return errCount(c, 1)
}

// A type collected with the types a read layout holds by value is marked as being
// walked, as the read's walk marks it: P's read of W, which holds P, is reported for W.
func TestByNameBatchPartReadsWalkedType() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype X [sizeof(W)]uint8\ntype W struct { p P }\n"
					"type P [sizeof(W)]uint8\n")
	if !errAtLine(c, 4, "cyclic type definition involving `W`") {
		return fail("P's read of W is reported for W")
	}
	return errCount(c, 1)
}

// An operand's array lengths are read before the types it holds: C before U, here a
// composite literal's and a `sizeof` operand's, so the cycle C reaches through P is
// reported for P.
func TestByNameBatchOperandLengthsFirst() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 2)
	srcs[0] = buf.CopyStr(
			"package \"main\"\ntype T [len([C]U{})]uint8\nconst C = sizeof(P)\n"
					"type U [sizeof(Q)]uint8\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	srcs[1] = buf.CopyStr(
			"package \"main\"\ntype T [sizeof([C]U)]uint8\nconst C = sizeof(P)\n"
					"type U [sizeof(Q)]uint8\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if !errAtLine(c, 6, "cyclic type definition involving `P`") {
			return fail(buf.Concat("the cycle is reported for P, case ", strconv.Itoa(i)))
		}
		var r testing.TestResult = errCount(c, 1)
		if len(r) > 0 { return r }
	}
	return ""
}

// The types a read layout holds are collected in the order its walk reaches them,
// through an instance's argument and an alias's target too: P, reached first, closes
// the cycle and is reported.
func TestByNameBatchPartsInWalkOrder() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 2)
	srcs[0] = buf.CopyStr(
			"package \"main\"\ntype T [sizeof(S)]uint8\ntype S struct { a Box[P]; b Q }\n"
					"type Box[X any] struct { x X }\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	srcs[1] = buf.CopyStr(
			"package \"main\"\ntype T [sizeof(S)]uint8\ntype S struct { a AP; b Q }\n"
					"type AP = P\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if !errAtLine(c, 6, "cyclic type definition involving `P`") {
			return fail(buf.Concat("the cycle is reported for P, case ", strconv.Itoa(i)))
		}
		var r testing.TestResult = errCount(c, 1)
		if len(r) > 0 { return r }
	}
	return ""
}

// The types a read layout holds are those of its type as resolved: none past a type
// argument of a name that is not generic, nor an array whose length is invalid.
func TestByNameBatchPartsAsResolved() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype T [sizeof(S)]uint8\ntype S struct { a U[int] }\n"
					"type U [sizeof(T)]uint8\n")
	if !errAtLine(c, 3, "undefined: U") { return fail("U[int] is reported") }
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"main\"\ntype T [sizeof(R)]uint8\ntype R [undefinedC]P\ntype P [sizeof(T)]uint8\n")
	if !errAtLine(c, 3, "undefined: undefinedC") { return fail("undefinedC is reported") }
	return errCount(c, 1)
}

// A read the walk does not resolve ahead -- of an alias not resolved yet, a variable, a
// function -- is made in its place, and so are the reads after it, in their order: Q,
// reached first through that read, collects P, whose read of Q closes the cycle and is
// reported, as without the walk.
func TestByNameBatchStopsAtReadsInPlace() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 3)
	srcs[0] = buf.CopyStr(
			"package \"main\"\ntype T struct { a AQ; b [C]uint8 }\ntype AQ = [sizeof(Q)]uint8\n"
					"const C = sizeof(P)\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	srcs[1] = buf.CopyStr(
			"package \"main\"\ntype T struct { a [len(v)]uint8; b [C]uint8 }\n"
					"var v [sizeof(Q)]int\nconst C = sizeof(P)\n"
					"type P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	srcs[2] = buf.CopyStr(
			"package \"main\"\ntype T struct { a [len(f())]uint8; b [C]uint8 }\n"
					"func f() [sizeof(Q)]int { var r [sizeof(Q)]int\n return r }\nconst C = sizeof(P)\n"
					"type P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		var line int = 5
		if i == 2 { line = 6 }
		if !errAtLine(c, line, "cyclic type definition involving `Q`") {
			return fail(buf.Concat("the cycle is reported for Q, case ", strconv.Itoa(i)))
		}
		var r testing.TestResult = errCount(c, 1)
		if len(r) > 0 { return r }
	}
	return ""
}

// So are reads the walk's scans do not model, whose resolution is made where they are
// evaluated -- a method's, an instance's, an alias's behind a pointer, a generic
// function's, a function literal's, a field's instance -- and a constant's too.
func TestByNameBatchStopsAtUnmodeledReads() testing.TestResult {
	var tail *[]readonly char = "const C = sizeof(P)\ntype P [sizeof(Q)]uint8\n"
			"type Q [sizeof(P)]uint8\n"
	var fields @[]@[]char = make_slice(@[]char, 6)
	var decls @[]@[]char = make_slice(@[]char, 6)
	fields[0] = buf.CopyStr("[len(S{}.M())]uint8")
	decls[0] = buf.CopyStr(
			"type S struct{}\nfunc (s S) M() [sizeof(Q)]int { var r [sizeof(Q)]int\n return r }\n")
	fields[1] = buf.CopyStr("[sizeof(Box2[Q])]uint8")
	decls[1] = buf.CopyStr("type Box2[X any] struct { x X }\n")
	fields[2] = buf.CopyStr("[sizeof(*AQ)]uint8")
	decls[2] = buf.CopyStr("type AQ = [sizeof(Q)]uint8\n")
	fields[3] = buf.CopyStr("[len(g[Q]())]uint8")
	decls[3] = buf.CopyStr("func g[X any]() [sizeof(X)]int { var r [sizeof(X)]int\n return r }\n")
	fields[4] = buf.CopyStr("[len(func() [sizeof(Q)]int { var r [sizeof(Q)]int; return r }())]uint8")
	decls[4] = buf.CopyStr("")
	fields[5] = buf.CopyStr("Box2[[sizeof(Q)]uint8]")
	decls[5] = buf.CopyStr("type Box2[X any] struct { x X }\n")
	for i := 0; i < len(fields); i++ {
		var src @[]char = buf.Concat("package \"main\"\ntype T struct { a ", fields[i])
		src = buf.Concat(src, "; b [C]uint8 }\n")
		src = buf.Concat(buf.Concat(src, tail), decls[i])
		var c @Checker = checkSrc(src)
		if !errAtLine(c, 4, "cyclic type definition involving `Q`") {
			return fail(buf.Concat("the cycle is reported for Q, case ", strconv.Itoa(i)))
		}
		var r testing.TestResult = errCount(c, 1)
		if len(r) > 0 { return r }
	}
	var k @Checker = checkSrc(
			"package \"main\"\ntype T [K]uint8\nconst K = sizeof(Box2[Q]) + sizeof(P)\n"
					"type Box2[X any] struct { x X }\ntype P [sizeof(Q)]uint8\ntype Q [sizeof(P)]uint8\n")
	if !errAtLine(k, 5, "cyclic type definition involving `Q`") {
		return fail("the constant's cycle is reported for Q")
	}
	return errCount(k, 1)
}

// An alias read for its layout, a composite literal's keys of a type not written as an
// array, and a type named as a value are read in their place too: Q, reached first
// through A's target or K, is reported for P's read of it; U's read of T, made where the
// invalid length names it, is never made.
func TestByNameBatchStopsAtAliasesKeysAndTypeValues() testing.TestResult {
	var tail *[]readonly char = "const C = sizeof(P)\ntype P [sizeof(Q)]uint8\n"
			"type Q [sizeof(P)]uint8\n"
	var c @Checker = checkSrc(
			buf.Concat(
					"package \"main\"\ntype A = [1]Q\ntype T struct { a [sizeof(A)]uint8; b [C]uint8 }\n", tail))
	if !errAtLine(c, 5, "cyclic type definition involving `Q`") {
		return fail("the cycle through A is reported for Q")
	}
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			buf.Concat(
					"package \"main\"\ntype Arr [5]int\ntype T struct { a [len(Arr{K: 1})]uint8; b [C]uint8 }\n"
							"const K = sizeof(Q) - sizeof(Q)\n",
					tail))
	if !errAtLine(c, 6, "cyclic type definition involving `Q`") {
		return fail("the cycle through K is reported for Q")
	}
	r = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc("package \"main\"\ntype T struct { a [U]uint8 }\ntype U [sizeof(T)]uint8\n")
	if !errAtLine(c, 2, "array length must be a constant integer") {
		return fail("the length naming U is reported")
	}
	return errCount(c, 1)
}

// A name read as a value that is not a constant of the batch -- undefined, or a generic
// -- is read in its place, and the reads after it too: its error stops the length's
// evaluation before K, so K's read of T is never made.
func TestByNameBatchStopsAtOtherValueNames() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\ntype T [undefinedX + K]uint8\nconst K = sizeof(T)\n")
	if !errAtLine(c, 2, "undefined: undefinedX") { return fail("undefinedX is reported") }
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"main\"\ntype T [len(Box) + K]uint8\nconst K = sizeof(T)\n"
					"type Box[X any] struct { x X }\n")
	if !errAtLine(c, 2, "array length must be a constant integer") {
		return fail("len(Box) is reported")
	}
	return errCount(c, 1)
}

// A type being collected, read for its layout, is a cycle its read reports, and the
// reads after it stay in place: T's read of itself, or of U, which holds T, is reported,
// and K's cycle after it -- or not at all, when the failing read stops the length.
func TestByNameBatchStopsAtCollectingType() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\ntype T [sizeof(T) + K]uint8\nconst K = sizeof(T)\n")
	if !errAtLine(c, 2, "cyclic type definition involving `T`") {
		return fail("T's read of itself is reported")
	}
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"main\"\ntype T struct { a [sizeof(U)]uint8; b [K]uint8 }\ntype U struct { t T }\n"
					"const K = sizeof(T)\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 || errs[0].Pos.Line != 2 || errs[1].Pos.Line != 4 {
		return fail("T's read of U is reported before K's cycle")
	}
	return ""
}

// errLines returns the lines c reported its errors at, in order, separated by spaces.
func errLines(c @Checker) @[]char {
	var errs @[]CheckError = c.CheckerErrors()
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(errs); i++ {
		if i > 0 { b.Write(" ") }
		b.Write(strconv.Itoa(errs[i].Pos.Line))
	}
	return buf.CopyStr(b.String())
}

// A layout read of a type being walked for the types it holds by value is a cycle its
// read reports, as one of a type being collected is; and a type that finds such a cycle
// among the types it holds stops the reads of the call that read it -- and of that
// call's reader, when that call is itself among the reader's parts.  Each cycle is
// reported before K's, read after it, as without the walk.
func TestByNameBatchStopsThroughParts() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype Z [sizeof(T)]uint8\ntype T struct { u U }\ntype U [sizeof(P) + K]uint8\n"
					"type P struct { t T }\nconst K = sizeof(W)\ntype W [Q]uint8\nconst Q = sizeof(W)\n")
	var got @[]char = errLines(c)
	if !streq(got, "4 8") { return fail(buf.Concat("a walked type: errors at lines ", got)) }
	c = checkSrc(
			"package \"main\"\ntype T struct { a [sizeof(R)]uint8; b [K]uint8 }\n"
					"type R struct { u U; w W }\ntype U struct { t T }\ntype W [Q]uint8\nconst Q = sizeof(W)\n"
					"const K = sizeof(T)\n")
	got = errLines(c)
	if !streq(got, "2 6 7") {
		return fail(buf.Concat("a stop through two types' parts: errors at lines ", got))
	}
	return ""
}

// literalChainSrc returns a package whose constant Z is the size of X, a struct as long
// as the first of a long chain of structs, each as long as a composite literal's length
// plus the next's size: of X itself, while X is being collected (direct), or of a struct
// of its own that holds X.
func literalChainSrc(direct bool) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nconst Z = sizeof(X)\ntype X struct { a [sizeof(A0)]uint8 }\n")
	for i := 0; i < byNameBatchLevels; i++ {
		b.Write("type A")
		b.Write(strconv.Itoa(i))
		b.Write(" struct { a [len([1]")
		if direct {
			b.Write("X")
		} else {
			b.Write("B")
			b.Write(strconv.Itoa(i))
		}
		b.Write("{}) + sizeof(A")
		b.Write(strconv.Itoa(i + 1))
		b.Write(")]uint8 }\n")
		if !direct {
			b.Write("type B")
			b.Write(strconv.Itoa(i))
			b.Write(" struct { x X }\n")
		}
	}
	b.Write("type A")
	b.Write(strconv.Itoa(byNameBatchLevels))
	b.Write(" struct { a [1]uint8 }\n")
	return buf.CopyStr(b.String())
}

// A composite literal of a type being collected does not read its layout, nor one of a
// type holding it, so a long chain of types whose lengths each read one, beside the size
// of the next, is collected with no recursion.
func TestDeepSizeofChainWithLiterals() testing.TestResult {
	var c @Checker = checkSrcResolved(literalChainSrc(true))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	r = constIs(c.Scope.Lookup("Z"), "Z", byNameBatchLevels + 1)
	if len(r) > 0 { return r }
	c = checkSrcResolved(literalChainSrc(false))
	r = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", byNameBatchLevels + 1)
}
