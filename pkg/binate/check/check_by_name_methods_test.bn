package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_by_name_methods.bn: chains of methods of a batch, each defined after
// the one its signature calls, walked with no recursion.

// The receivers a method chain calls the next method on (methodWalkChainSrc).
const (
	recvLiteral int = iota // a composite literal of the type: S1{}
	recvVar                // a variable of it: v1
	recvCall               // the result of a function returning one: mk1()
)

// writeRecv writes a receiver of the type S<i>, of the kind recv.
func writeRecv(b @strings.Builder, recv int, i int) {
	var n @[]char = strconv.Itoa(i)
	if recv == recvLiteral {
		b.Write("S")
		b.Write(n)
		b.Write("{}")
	} else if recv == recvVar {
		b.Write("v")
		b.Write(n)
	} else {
		b.Write("mk")
		b.Write(n)
		b.Write("()")
	}
}

// methodWalkChainSrc returns a package whose constant Z is the length of M's result on
// the first of a long chain of types, each M's result an array as long as the next
// type's M's result, called on a receiver of the kind recv.
func methodWalkChainSrc(recv int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nconst Z = len(")
	writeRecv(b, recv, 0)
	b.Write(".M())\n")
	for i := 0; i <= byNameBatchLevels; i++ {
		var n @[]char = strconv.Itoa(i)
		b.Write("type S")
		b.Write(n)
		b.Write(" struct {}\n")
		if recv == recvVar {
			writeLink(b, "var v", i, " S", i, "")
		} else if recv == recvCall {
			b.Write("func mk")
			b.Write(n)
			b.Write("() S")
			b.Write(n)
			b.Write(" { var s S")
			b.Write(n)
			b.Write("; return s }\n")
		}
		b.Write("func (s S")
		b.Write(n)
		b.Write(") M() ")
		if i == byNameBatchLevels {
			b.Write("[3]int8")
		} else {
			b.Write("[len(")
			writeRecv(b, recv, i + 1)
			b.Write(".M())]int8")
		}
		b.Write(" { var r [3]int8; return r }\n")
	}
	return buf.CopyStr(b.String())
}

// A constant reading the length of M's result on the first of a long chain of types,
// each M's result as long as the next's, is resolved after the whole chain: M called on
// a composite literal of each type, a variable of it, or the result of a function.
func TestDeepBatchMethodChain() testing.TestResult {
	var c @Checker = checkSrcResolved(methodWalkChainSrc(recvLiteral))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// So is one calling M on variables of the types.
func TestDeepBatchMethodChainOnVars() testing.TestResult {
	var c @Checker = checkSrcResolved(methodWalkChainSrc(recvVar))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// So is one calling M on the results of functions returning the types.
func TestDeepBatchMethodChainOnCalls() testing.TestResult {
	var c @Checker = checkSrcResolved(methodWalkChainSrc(recvCall))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// A field of the name a selection calls takes precedence over a method of that name
// (spec expr.member), so no method is defined for it ahead: a method whose signature
// reads the declaration calling the field is no cycle -- here M on a composite literal,
// read where a variable's type reads Z.
func TestBatchMethodReadCallsField() testing.TestResult {
	var c @Checker = checkSrcResolved(
			"package \"main\"\nvar a [Z]int8\nconst Z = len(S{}.M())\ntype S struct { M *func() [3]int8 }\n"
					"func (s S) M() [Z]int8 { var r [Z]int8; return r }\n")
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// So is M on a pointer to a type declared after the read.
func TestBatchMethodReadCallsFieldOnPointer() testing.TestResult {
	return errCount(
			checkSrc(
					"package \"main\"\nvar a [Z]int8\nvar p *S\nconst Z = len(p.M())\n"
							"func (s S) M() [Z]int8 { var r [Z]int8; return r }\n"
							"type S struct { M *func() [3]int8 }\n"), 0)
}

// So is M on a function's result, read where a type's field's length reads it.
func TestBatchMethodReadCallsFieldOnCall() testing.TestResult {
	return errCount(
			checkSrc(
					"package \"main\"\ntype T struct { a [len(mk().M())]int8 }\n"
							"func mk() S { var s S; return s }\n"
							"type S struct { M *func() [3]int8 }\n"
							"func (s S) M() [sizeof(T)]int8 { var r [sizeof(T)]int8; return r }\n"), 0)
}

// A method whose receiver collection rejects -- an alias -- has nothing of its
// signature read ahead: the receiver is reported before what the signature reads, as
// without the walk.
func TestBatchMethodBadReceiverReadsNothingAhead() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype S struct {}\ntype A = S\n"
					"func (s A) M() [K]int8 { var r [3]int8; return r }\n"
					"const K = Undef\n")
	var got @[]char = errLines(c)
	if !streq(got, "4 5 4") { return fail(buf.Concat("errors at lines ", got)) }
	return ""
}
