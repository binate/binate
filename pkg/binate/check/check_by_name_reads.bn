package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// What a declaration's resolution reads, in the order it reads it, as far as the scans
// here model that: the by-name walk resolves those reads ahead of the declaration
// (check_by_name_batch.bn), and leaves the rest -- from the first read the scans do not
// model, a stop -- to be made where they are evaluated.

// The kinds of a read (byNameReads).
const (
	readValue int = iota // a name read as a value: a constant, a variable ...
	readLayout           // a type whose layout is read
	readAlias            // a pending alias named, resolved where it is named
	readLiteral          // a type a composite literal is of, or holds: collected, its layout not read
	readMethodOfType     // a method called on a composite literal of the type owner
	readMethodOfValue    // a method called on the variable or constant owner
	readMethodOfCall     // a method called on the result of a call of the function owner
)

// isMethodRead reports whether a read of the kind kind is a method's.
func isMethodRead(kind int) bool {
	return kind == readMethodOfType || kind == readMethodOfValue || kind == readMethodOfCall
}

// A byNameReads is a declaration's reads, in order: each a name (none for a stop), what
// kind of read it is (kinds) and, for a method's, the name its receiver is read through
// (owners: none for any other).
type byNameReads struct {
	names  @[]@[]char
	kinds  @[]int
	owners @[]@[]char
}

// add appends the read of name, of the kind kind.
func (r *byNameReads) add(name @[]char, kind int) {
	var none @[]char
	r.addOf(none, name, kind)
}

// addOf appends the read of name, of the kind kind, through owner (a method's read; none
// for any other).
func (r *byNameReads) addOf(owner @[]char, name @[]char, kind int) {
	r.names = slices.Append[@[]char](r.names, name)
	r.kinds = slices.Append[int](r.kinds, kind)
	r.owners = slices.Append[@[]char](r.owners, owner)
}

// stop appends a stop: a read whose resolution the scans do not model, made where it
// is evaluated, so that the reads after it are made there too.
func (r *byNameReads) stop() {
	var none @[]char
	r.add(none, readValue)
}

// count returns how many reads r holds.
func (r *byNameReads) count() int {
	return len(r.names)
}

// collectTypeExprReads appends to r what resolving te reads, where it reads it and in
// that order (collectExprReads of each array length, before its element), through
// element, field, parameter and result types, up to a part whose resolution it does
// not model -- a named type with type arguments or an instantiation (an instance is
// built, or a generic named, where it is resolved) -- where it appends a stop.  A
// pending alias it names, resolved where it is named, is a read of its own (readAlias).
// An inferred length is not read.
func collectTypeExprReads(c @Checker, te @ast.TypeExpr, r *byNameReads) {
	if te == nil { return }
	if te.Kind == ast.TEXPR_INSTANTIATE || te.Kind == ast.TEXPR_NAMED && len(te.TypeArgs) > 0 {
		r.stop()
		return
	}
	if te.Kind == ast.TEXPR_NAMED {
		if len(te.Pkg) == 0 && pendingAliasNamed(c, te.Name) { r.add(te.Name, readAlias) }
		return
	}
	if te.Kind == ast.TEXPR_ARRAY && !te.LenInferred {
		collectExprReads(c, te.Len, r)
	}
	collectTypeExprReads(c, te.Base, r)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { collectTypeExprReads(c, te.Fields[i].Type, r) }
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		collectTypeExprReads(c, te.ParamTypes[i], r)
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		collectTypeExprReads(c, te.ResultTypes[i], r)
	}
}

// collectExprReads appends to r what the expression e reads where it is evaluated, in
// that order: the names it names, as values, through literals and unary and binary
// operators; a builtin's type operand, resolved (collectTypeExprReads), and for
// `sizeof`, `alignof` and `bit_cast`, which read its layout, the types it holds by
// value (addValueNames), then its arguments; a call of a function by name, the name
// (its signature resolved) then its arguments; a method call on a receiver whose type
// the walk can name (collectMethodRecvReads), the receiver's reads, the method (defined
// ahead) then its arguments; a composite literal's type, resolved, and the types it
// holds by value, collected -- not their layouts read (readLiteral: a literal of a type
// being collected collects nothing of it, collectLiteralTypes) -- then its elements (an
// array type's keys too).  Any other expression (a selector, an index, a function
// literal ...), or a key of a composite literal that is not of an array type written as
// one, is a stop: what it reads is read where it is evaluated.
func collectExprReads(c @Checker, e @ast.Expr, r *byNameReads) {
	if e == nil { return }
	if e.Kind == ast.EXPR_IDENT {
		r.add(e.Name, readValue)
		return
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_FLOAT_LIT || e.Kind == ast.EXPR_STRING_LIT ||
			e.Kind == ast.EXPR_CHAR_LIT || e.Kind == ast.EXPR_BOOL_LIT || e.Kind == ast.EXPR_NIL_LIT {
		return
	}
	if e.Kind == ast.EXPR_UNARY {
		collectExprReads(c, e.X, r)
		return
	}
	if e.Kind == ast.EXPR_BINARY {
		collectExprReads(c, e.X, r)
		collectExprReads(c, e.Y, r)
		return
	}
	if e.Kind == ast.EXPR_BUILTIN {
		collectTypeExprReads(c, e.TypeRef, r)
		if e.Op == cast(int, token.SIZEOF) || e.Op == cast(int, token.ALIGNOF) ||
				e.Op == cast(int, token.BIT_CAST) {
			addValueNames(e.TypeRef, readLayout, r)
		}
		for i := 0; i < len(e.Args); i++ {
			collectExprReads(c, e.Args[i], r)
		}
		return
	}
	if e.Kind == ast.EXPR_CALL && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		r.add(e.X.Name, readValue)
		for i := 0; i < len(e.Args); i++ {
			collectExprReads(c, e.Args[i], r)
		}
		return
	}
	if e.Kind == ast.EXPR_CALL && e.X != nil && e.X.Kind == ast.EXPR_SELECTOR {
		if !collectMethodRecvReads(c, e.X, r) {
			r.stop()
			return
		}
		for i := 0; i < len(e.Args); i++ {
			collectExprReads(c, e.Args[i], r)
		}
		return
	}
	if e.Kind != ast.EXPR_COMPOSITE {
		r.stop()
		return
	}
	collectTypeExprReads(c, e.TypeRef, r)
	addValueNames(e.TypeRef, readLiteral, r)
	var array bool = e.TypeRef != nil && e.TypeRef.Kind == ast.TEXPR_ARRAY
	for i := 0; i < len(e.Elems); i++ {
		if e.Elems[i] != nil {
			if e.Elems[i].Key != nil && !array {
				r.stop()
				return
			}
			collectExprReads(c, e.Elems[i].Key, r)
			collectExprReads(c, e.Elems[i].Value, r)
		}
	}
}

// addValueNames appends to r, as reads of the kind kind (readLayout or readLiteral),
// the unqualified type names te holds by value -- through array, readonly and
// parenthesized elements and struct fields, not behind a pointer, a slice or a function
// value -- short of an instance: such a read reaches what an instance holds through its
// type as resolved (appendLayoutParts).
func addValueNames(te @ast.TypeExpr, kind int, r *byNameReads) {
	if te == nil || te.Kind == ast.TEXPR_INSTANTIATE { return }
	if te.Kind == ast.TEXPR_NAMED && len(te.TypeArgs) > 0 { return }
	if te.Kind == ast.TEXPR_POINTER || te.Kind == ast.TEXPR_MANAGED || te.Kind == ast.TEXPR_SLICE ||
			te.Kind == ast.TEXPR_MANAGED_SLICE || te.Kind == ast.TEXPR_FUNC_VALUE ||
			te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		return
	}
	if te.Kind == ast.TEXPR_NAMED && len(te.Pkg) == 0 {
		r.add(te.Name, kind)
	}
	addValueNames(te.Base, kind, r)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { addValueNames(te.Fields[i].Type, kind, r) }
	}
}

// collectMethodRecvReads appends to r what the receiver of the method selection sel
// reads, then the method's read, and reports whether it did: on a composite literal of
// a type named in the package (`T{}`, `(&T{})`), a name, or a call of a function by
// name -- a receiver whose type the walk can name once the reads before it are resolved
// (pushMethodReadFrom).  Any other receiver (a selector, an index ...) is read where it
// is evaluated.
func collectMethodRecvReads(c @Checker, sel @ast.Expr, r *byNameReads) bool {
	var x @ast.Expr = sel.X
	var addressed bool = x != nil && x.Kind == ast.EXPR_UNARY && x.Op == cast(int, token.AMP)
	if addressed { x = x.X }
	if x == nil { return false }
	if x.Kind == ast.EXPR_COMPOSITE {
		var te @ast.TypeExpr = x.TypeRef
		if te == nil || te.Kind != ast.TEXPR_NAMED || len(te.Pkg) > 0 || len(te.TypeArgs) > 0 {
			return false
		}
		collectExprReads(c, x, r)
		r.addOf(te.Name, sel.Name, readMethodOfType)
		return true
	}
	if addressed { return false }
	if x.Kind == ast.EXPR_IDENT {
		r.add(x.Name, readValue)
		r.addOf(x.Name, sel.Name, readMethodOfValue)
		return true
	}
	if x.Kind == ast.EXPR_CALL && x.X != nil && x.X.Kind == ast.EXPR_IDENT {
		collectExprReads(c, x, r)
		r.addOf(x.X.Name, sel.Name, readMethodOfCall)
		return true
	}
	return false
}
