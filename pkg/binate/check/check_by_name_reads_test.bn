package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_by_name_reads.bn: the reads an expression's evaluation makes, in
// order, as far as the scans model them.

// exprReads returns the reads of the expression src, each written as its name, `@` and
// its name for a layout read, `{` and its name for a composite literal's type, `=` and
// its name for a pending alias, its receiver's owner -- with `{}` after a type's, `()`
// after a function's -- `.` and its name for a method's, or `|` for a stop, separated by
// spaces.
func exprReads(src *[]readonly char) @[]char {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var e @ast.Expr = mustParseExpr(p)
	var r byNameReads
	collectExprReads(NewChecker(), e, &r)
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < r.count(); i++ {
		if i > 0 { b.Write(" ") }
		if len(r.names[i]) == 0 {
			b.Write("|")
		} else {
			if r.kinds[i] == readLayout { b.Write("@") }
			if r.kinds[i] == readLiteral { b.Write("{") }
			if r.kinds[i] == readAlias { b.Write("=") }
			if isMethodRead(r.kinds[i]) {
				b.Write(r.owners[i])
				if r.kinds[i] == readMethodOfType { b.Write("{}") }
				if r.kinds[i] == readMethodOfCall { b.Write("()") }
				b.Write(".")
			}
			b.Write(r.names[i])
		}
	}
	return buf.CopyStr(b.String())
}

// The reads of each expression are its names, in the order they are evaluated, the
// types whose layouts it reads, or its composite literals are of, after what their
// array lengths read, the methods it calls after what their receivers read, and a stop
// where
// it reaches an expression the scans do not model.
func TestExprReads() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 15)
	var want @[]@[]char = make_slice(@[]char, 15)
	srcs[0] = buf.CopyStr("A + -B * 2")
	want[0] = buf.CopyStr("A B")
	srcs[1] = buf.CopyStr("sizeof(T) + C")
	want[1] = buf.CopyStr("@T C")
	srcs[2] = buf.CopyStr("sizeof([C]U)")
	want[2] = buf.CopyStr("C @U")
	srcs[3] = buf.CopyStr("len([N]T{K: V})")
	want[3] = buf.CopyStr("N {T K V")
	srcs[4] = buf.CopyStr("len(Row{K: 1})")
	want[4] = buf.CopyStr("{Row |")
	srcs[5] = buf.CopyStr("len(f(K)) + C")
	want[5] = buf.CopyStr("f K C")
	srcs[6] = buf.CopyStr("cast(N, 2)")
	want[6] = buf.CopyStr("")
	srcs[7] = buf.CopyStr("sizeof(*P)")
	want[7] = buf.CopyStr("")
	srcs[8] = buf.CopyStr("sizeof(Box[Q]) + C")
	want[8] = buf.CopyStr("| C")
	srcs[9] = buf.CopyStr("alignof(S) + len(s.f)")
	want[9] = buf.CopyStr("@S |")
	srcs[10] = buf.CopyStr("len(s.f()) + C")
	want[10] = buf.CopyStr("s s.f C")
	srcs[11] = buf.CopyStr("len(S{}.M(K)) + C")
	want[11] = buf.CopyStr("{S S{}.M K C")
	srcs[12] = buf.CopyStr("len(f(A).M()) + len((&S{}).M())")
	want[12] = buf.CopyStr("f A f().M {S S{}.M")
	srcs[13] = buf.CopyStr("len(a.b.M()) + C")
	want[13] = buf.CopyStr("| C")
	srcs[14] = buf.CopyStr("len(Box[int]{}.M()) + C")
	want[14] = buf.CopyStr("| C")
	for i := 0; i < len(srcs); i++ {
		var got @[]char = exprReads(srcs[i])
		if !streq(got, want[i]) {
			return fail(buf.Concat(buf.Concat(srcs[i], " reads "), got))
		}
	}
	return ""
}
