package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The by-name walk's calls that resolve a variable of the batch with a declared type
// (resolveBatchVarType) and define a function of the batch (defineBatchFunc): marked as
// being resolved, each first resolves what its type -- a variable's, a function's
// parameters' and results' -- reads, in order (check_by_name_reads.bn), so that a chain
// of them (`var A0 [len(A1)]int8`, `func f0() [len(f1())]int8`, ...) of any length is
// resolved with no recursion.  One made for another declaration (onDemand) defines its
// variable or function as one read on demand is (batchVarOnDemand, batchFuncOnDemand):
// one being resolved, already defined, or otherwise not to be defined on demand is
// left to the read that names it.

// byNameVarType is the type the last variable's call made for resolveBatchVarType
// resolved, and byNameFuncWaited whether the last function's call made for
// defineBatchFunc had a read wait (leaveDeclResolution); each is read by the caller
// once its walk is done.
var byNameVarType @types.Type

// byNameFuncWaited: see byNameVarType.
var byNameFuncWaited bool

// stepBatchVar runs the variable's call k to its next call or its end.
func stepBatchVar(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if !startBatchVar(c, k) {
			byNameReturn(k)
			return
		}
		k.pc = byNameLoopConsts
	}
	if stepReadsAhead(c, k) { return }
	finishBatchVar(c, k)
	byNameReturn(k)
}

// stepReadsAhead starts, from the running call k, the call for its next read to be
// resolved ahead (pushReadFrom), and reports whether it did; at a read made in its
// place, the rest are left too.
func stepReadsAhead(c @Checker, k @byNameCall) bool {
	for k.i < k.reads.count() {
		var at int = k.i
		k.i = k.i + 1
		var next int = pushReadFrom(c, k, k.reads.names[at], k.reads.kinds[at], true)
		if next == byNameReadPushed { return true }
		if next == byNameReadStop { k.i = k.reads.count() }
	}
	return false
}

// startBatchVar starts the variable's call k: one made for another declaration
// defines k.name on demand only when it is a variable of the batch with a declared
// type, not defined, nor being resolved, typed or checked -- in its own declaration's
// context, as batchVarOnDemand defines one (defineVarOnDemand) -- and reports whether
// it does.  The variable is marked as being resolved (VarsResolving), and what its type
// reads is found (k.reads), unless an instance is being built.
func startBatchVar(c @Checker, k @byNameCall) bool {
	var b @DeclBatch = c.Batch
	if k.onDemand {
		if b == nil || !b.VarsOpen { return false }
		var d @ast.Decl = findDeclIn(b.Vars, k.name)
		if d == nil || d.TypeRef == nil || declInList(b.VarsResolving, d) ||
				declInList(b.VarsHeadTyping, d) || declInList(b.VarsChecking, d) || varBeingTyped(b, d) {
			return false
		}
		k.saved = enterPackageDecl(c, d)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil && !isUniverseSymbol(c, sym) || skipDemand(c) {
			leavePackageDecl(c, k.saved)
			return false
		}
		k.d = d
		k.ds = declScope(c)
		k.prev = k.ds.LookupLocal(d.Name)
		enterDeclResolution(c, d)
		k.framed = enterDemandFrame(c)
	}
	b.VarsResolving = slices.Append[@ast.Decl](b.VarsResolving, k.d)
	if !buildingInstances(c) {
		collectTypeExprReads(c, k.d.TypeRef, &k.reads)
	}
	return true
}

// finishBatchVar resolves the type of the variable of the call k, what it reads
// resolved -- the error type when its type cycle was reported -- and, for one made for
// another declaration, defines the variable with it as defineVarOnDemand does: undone
// when that read a layout not built yet, inside an instance's build.
func finishBatchVar(c @Checker, k @byNameCall) {
	var b @DeclBatch = c.Batch
	var d @ast.Decl = k.d
	var t @types.Type = resolveTypeExpr(c, d.TypeRef)
	b.VarsResolving = b.VarsResolving[:len(b.VarsResolving) - 1]
	if declInList(b.VarsCycled, d) {
		t = types.TypError()
	}
	if !k.onDemand {
		byNameVarType = t
		return
	}
	if !prepareLayout(c, t, d.Pos) {
		t = types.TypError()
	}
	defineVar(c.Scope, d.Name, t)
	var waited bool = leaveDeclResolution(c)
	if leaveDemandFrame(c, k.framed) {
		restoreBinding(k.ds, d.Name, k.prev)
		var kept @[]@ast.Decl
		for i := 0; i < len(b.VarsDefined); i++ {
			if !same(b.VarsDefined[i], d) {
				kept = slices.Append[@ast.Decl](kept, b.VarsDefined[i])
			}
		}
		b.VarsDefined = kept
		ast.ClearCheckerAnnotations(d)
		leavePackageDecl(c, k.saved)
		return
	}
	b.VarsDefined = slices.Append[@ast.Decl](b.VarsDefined, d)
	if waited {
		flushLayoutWaits(c)
	}
	leavePackageDecl(c, k.saved)
}

// stepBatchFunc runs the function's call k to its next call or its end.
func stepBatchFunc(c @Checker, k @byNameCall) {
	if k.pc == byNameStart {
		if !startBatchFunc(c, k) {
			byNameReturn(k)
			return
		}
		k.pc = byNameLoopConsts
	}
	if stepReadsAhead(c, k) { return }
	finishBatchFunc(c, k)
	byNameReturn(k)
}

// startBatchFunc starts the function's call k: one made for another declaration
// defines k.name on demand only when it is a function of the batch, not generic, not
// defined -- on demand or in its turn: its name bound -- nor being defined, in its own
// declaration's context and a demand frame, as batchFuncOnDemand defines one -- and
// reports whether it does.  The function is marked
// as being defined (FuncsDefining, enterDeclResolution), and what its parameters' and
// results' types read is found (k.reads), unless it is generic or an instance is being
// built.
func startBatchFunc(c @Checker, k @byNameCall) bool {
	var b @DeclBatch = c.Batch
	if k.onDemand {
		if b == nil || !b.Collecting { return false }
		var d @ast.Decl = findDeclIn(b.Funcs, k.name)
		if d == nil || len(d.TypeParams) > 0 || declInList(b.FuncsDefined, d) ||
				declInList(b.FuncsDefining, d) || skipDemand(c) {
			return false
		}
		k.saved = enterPackageDecl(c, d)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil && !isUniverseSymbol(c, sym) {
			leavePackageDecl(c, k.saved)
			return false
		}
		k.d = d
		k.ds = declScope(c)
		k.prev = k.ds.LookupLocal(d.Name)
		k.framed = enterDemandFrame(c)
	}
	b.FuncsDefining = slices.Append[@ast.Decl](b.FuncsDefining, k.d)
	enterDeclResolution(c, k.d)
	if !buildingInstances(c) && len(k.d.TypeParams) == 0 {
		for i := 0; i < len(k.d.Params); i++ {
			collectTypeExprReads(c, k.d.Params[i].Type, &k.reads)
		}
		for i := 0; i < len(k.d.Results); i++ {
			collectTypeExprReads(c, k.d.Results[i], &k.reads)
		}
	}
	return true
}

// finishBatchFunc defines the function of the call k (collectFuncDecl), what its
// signature reads resolved, and, for one made for another declaration, keeps the
// definition as batchFuncOnDemand does: undone when it read a layout not built yet,
// inside an instance's build.
func finishBatchFunc(c @Checker, k @byNameCall) {
	var b @DeclBatch = c.Batch
	var d @ast.Decl = k.d
	collectFuncDecl(c, d)
	b.FuncsDefining = b.FuncsDefining[:len(b.FuncsDefining) - 1]
	var waited bool = leaveDeclResolution(c)
	if !k.onDemand {
		byNameFuncWaited = waited
		return
	}
	if leaveDemandFrame(c, k.framed) {
		restoreBinding(k.ds, d.Name, k.prev)
		ast.ClearCheckerAnnotations(d)
		leavePackageDecl(c, k.saved)
		return
	}
	leavePackageDecl(c, k.saved)
	b.FuncsDefined = slices.Append[@ast.Decl](b.FuncsDefined, d)
	if waited {
		flushLayoutWaits(c)
	}
}
