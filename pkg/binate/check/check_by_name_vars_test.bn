package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_by_name_vars.bn: chains of variables and functions of a batch, each
// resolved after the one its type reads, walked with no recursion.

// A constant reading the length of the first of a long chain of variables, each an
// array as long as the next, is resolved after the whole chain.
func TestDeepBatchVarChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\nconst Z = len(A0)\n", "var A", " [len(A", ")]int8", byNameLevels,
					" [3]int8\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// So is one reading the length of the result of the first of a long chain of
// functions, each returning an array as long as the next one's result.
func TestDeepBatchFuncChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\nconst Z = len(f0())\n", "func f", "() [len(f",
					"())]int8 { var r [3]int8; return r }", byNameLevels,
					"() [3]int8 { var r [3]int8; return r }\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("Z"), "Z", 3)
}

// Variables whose types read each other are a variable type cycle, reported at the
// first, and functions whose signatures call each other leave the first undefined
// where the second's signature names it -- as without the walk.
func TestBatchVarAndFuncCycles() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\nvar A [len(B)]int\nvar B [len(A)]int\n")
	if !errAtLine(c, 2, "variable type cycle involving `A`") {
		return fail("the variable cycle is reported at A")
	}
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"main\"\nfunc f() [len(g())]int { var r [len(g())]int; return r }\n"
					"func g() [len(f())]int { var r [len(f())]int; return r }\n")
	if !errAtLine(c, 3, "undefined: f") { return fail("f is undefined in g's signature") }
	return errCount(c, 1)
}

// A variable or function read in its own type, while it is being resolved, is left to
// that read, and the reads after it too: K, after the failing self-read, is never read,
// so T's cycle through it is not reported -- as without the walk.
func TestBatchSelfReadStopsReads() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\ntype T [len(A)]uint8\nvar A [len(A) + K]int\nconst K = sizeof(T)\n")
	if !errAtLine(c, 3, "variable type cycle involving `A`") { return fail("A's cycle is reported") }
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"main\"\ntype T [len(f())]uint8\n"
					"func f() [len(f()) + K]int { var r [3]int; return r }\nconst K = sizeof(T)\n")
	if !errAtLine(c, 3, "undefined: f") { return fail("f is undefined in its own signature") }
	return errCount(c, 1)
}
