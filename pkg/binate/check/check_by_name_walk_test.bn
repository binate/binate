package "pkg/binate/check"

import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_by_name_walk.bn: chains of constants, each resolved by name after
// the one it names, walked with no recursion.  (A `.bni`'s declarations are tested in
// bni_by_name_walk_test.bn.)

// byNameLevels is how long the tests' chains are: past where a resolution recursing
// along a chain of constants ran out of stack.
const byNameLevels int = 6000

// writeLink writes the declaration line `<pre><i><mid><j><post>` to b.
func writeLink(b @strings.Builder, pre *[]readonly char, i int, mid *[]readonly char, j int,
		post *[]readonly char) {
	b.Write(pre)
	b.Write(strconv.Itoa(i))
	b.Write(mid)
	b.Write(strconv.Itoa(j))
	b.Write(post)
	b.Write("\n")
}

// linkChainSrc returns the source head, then the n declaration lines
// `<pre><i><mid><i + 1><post>`, i from 0, then `<pre><n><last>`.
func linkChainSrc(head *[]readonly char, pre *[]readonly char, mid *[]readonly char,
		post *[]readonly char, n int, last *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(head)
	for i := 0; i < n; i++ {
		writeLink(b, pre, i, mid, i + 1, post)
	}
	b.Write(pre)
	b.Write(strconv.Itoa(n))
	b.Write(last)
	return buf.CopyStr(b.String())
}

// constIs returns a failure unless sym, the symbol of name, is a constant of the
// value v.
func constIs(sym @Symbol, name *[]readonly char, v int) testing.TestResult {
	if sym == nil || !sym.HasCVal || sym.CStat != constval.OK {
		return fail(buf.Concat(name, " has no value"))
	}
	if !sym.CVal.N.Equals(bignum.FromInt(v)) {
		return fail(buf.Concat(name, " has another value"))
	}
	return ""
}

// A constant naming the first of a long chain of constants, each declared before the
// one it names, is resolved after the whole chain.
func TestDeepConstChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\n", "const C", " = C", " + 1", byNameLevels, " = 0\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("C0"), "C0", byNameLevels)
}

// So is one in a const group, each member naming the next.
func TestDeepConstGroupChain() testing.TestResult {
	var c @Checker = checkSrcResolved(
			linkChainSrc("package \"main\"\nconst (\n", "\tG", " = G", " + 1", byNameLevels, " = 0\n)\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	return constIs(c.Scope.Lookup("G0"), "G0", byNameLevels)
}

// A long chain whose last constant names the first is a cycle, reported once, at the
// first: the constant whose resolution found itself being resolved.
func TestDeepConstCycleAtChainEnd() testing.TestResult {
	var c @Checker = checkSrc(
			linkChainSrc("package \"main\"\n", "const C", " = C", " + 1", byNameLevels, " = C0\n"))
	if !errAtLine(c, 2, "constant definition cycle involving `C0`") {
		return fail("the cycle is reported at C0")
	}
	return errCount(c, 1)
}
