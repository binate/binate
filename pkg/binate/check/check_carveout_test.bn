package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the stdlib-carve-out gate:
// AllowUniverseRecv flag set automatically for `package
// "pkg/builtins/lang"`; resolveMethodReceiver accepts universe primitives
// only under that flag; AddMethod / LookupMethod /
// ReceiverBaseNamed handle primitive receivers correctly.
//
// Test isolation note: methods declared on universe primitives
// hang on the singleton @types.Type record (TypInt() etc.) and
// persist for the lifetime of the test process.  Tests that
// add canonical-named methods (Compare, Hash, String, Inc) use
// names different from each other to avoid AddMethod
// duplicate-name failures.  Each test calls
// clearPrimitiveMethodSets at the top so its assertions don't
// see leakage from prior tests.

// clearPrimitiveMethodSets resets the method set on every
// universe primitive so a test can start from a known state.
// Test-only — not exposed in the .bni.
func clearPrimitiveMethodSets() {
	clearMethods(types.TypInt())
	clearMethods(types.TypInt8())
	clearMethods(types.TypInt16())
	clearMethods(types.TypInt32())
	clearMethods(types.TypInt64())
	clearMethods(types.TypUint())
	clearMethods(types.TypUint8())
	clearMethods(types.TypUint16())
	clearMethods(types.TypUint32())
	clearMethods(types.TypUint64())
	clearMethods(types.TypFloat32())
	clearMethods(types.TypFloat64())
	clearMethods(types.TypBool())
}

// clearMethods drops the method set on a single Type.  Helper
// for clearPrimitiveMethodSets.
func clearMethods(t @types.Type) {
	if t == nil { return }
	var empty @[]@types.Method
	t.Methods = empty
}

// ============================================================
// Carve-out gate
// ============================================================

// In the carve-out package, methods on `int` are accepted.
func TestCarveOutAcceptsMethodOnInt() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("func (a int) AcceptsTest() bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets() // cleanup, even on test failure
	if len(c.CheckerErrors()) > 0 {
		return fail("expected no errors in carve-out package")
	}
	return ""
}

// Same source in a regular package is rejected.
func TestNonCarveOutRejectsMethodOnInt() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func (a int) Foo() bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets()
	return expectError(c)
}

// In the carve-out package, methods on `bool` are accepted.
func TestCarveOutAcceptsMethodOnBool() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("func (b bool) AcceptsBoolTest() int { return 0 }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets()
	return expectNoErrors(c)
}

// In the carve-out package, methods on `float64` are accepted.
func TestCarveOutAcceptsMethodOnFloat64() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("func (x float64) AcceptsFloatTest() bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets()
	return expectNoErrors(c)
}

// Method registers on the primitive's singleton, reachable via
// LookupMethod after the carve-out package is checked.
func TestCarveOutMethodLandsOnPrimitive() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("func (a int) RegistersOnInt() bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) > 0 {
		clearPrimitiveMethodSets()
		return fail("expected no errors")
	}
	var m @types.Method = types.TypInt().LookupMethod("RegistersOnInt")
	clearPrimitiveMethodSets()
	if m == nil {
		return fail("expected RegistersOnInt to register on TypInt")
	}
	return ""
}

// Aliases / user-defined named types still work normally —
// the carve-out is purely additive.
func TestCarveOutNamedTypeStillWorks() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("type Counter struct { n int }\n")
	cb.Write("func (c *Counter) Inc() { c.n = c.n + 1 }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets()
	return expectNoErrors(c)
}

// Aliases on primitives still rejected — the carve-out is for
// the primitive itself, not for transparent renamings.
func TestCarveOutRejectsMethodOnAlias() testing.TestResult {
	clearPrimitiveMethodSets()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/builtins/lang\"\n")
	cb.Write("type Counter = int\n")
	cb.Write("func (c Counter) Foo() bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	clearPrimitiveMethodSets()
	return expectError(c)
}

// AddMethod accepts primitive types directly (covers the gate
// at the @types.Type API level).
func TestAddMethodAcceptsPrimitive() testing.TestResult {
	clearPrimitiveMethodSets()
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var ft @types.Type = types.MakeFuncType(noParams, noResults)
	var m @types.Method = MakeMethod("AddMethodPrimTest", types.TypInt(), ft)
	if !types.TypInt().AddMethod(m) {
		clearPrimitiveMethodSets()
		return fail("AddMethod should accept TypInt receiver")
	}
	if types.TypInt().LookupMethod("AddMethodPrimTest") == nil {
		clearPrimitiveMethodSets()
		return fail("LookupMethod should find the just-added method")
	}
	clearPrimitiveMethodSets()
	return ""
}

// AddMethod still rejects un-method-bearing kinds (slices,
// arrays, etc.).
func TestAddMethodRejectsSlice() testing.TestResult {
	var slc @types.Type = types.MakeSliceType(types.TypInt())
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var ft @types.Type = types.MakeFuncType(noParams, noResults)
	var m @types.Method = MakeMethod("Bad", slc, ft)
	if slc.AddMethod(m) {
		return fail("AddMethod should reject slice receivers")
	}
	return ""
}

// ReceiverBaseNamed returns the primitive itself for a bare
// primitive receiver (not nil), so impl validation can find
// the receiver's method set.
func TestReceiverBaseNamedOnPrimitive() testing.TestResult {
	if types.TypInt().ReceiverBaseNamed() != types.TypInt() {
		return fail("expected ReceiverBaseNamed(int) == TypInt()")
	}
	if types.TypBool().ReceiverBaseNamed() != types.TypBool() {
		return fail("expected ReceiverBaseNamed(bool) == TypBool()")
	}
	return ""
}
