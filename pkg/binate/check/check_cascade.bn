package "pkg/binate/check"

import "pkg/binate/types"

// One mistake, one error.  An expression whose error is already reported is
// typed TypError, and a context that would report its operand's type — an
// index or selector base, an operator's operand, a condition, a builtin's
// argument, an assignment's source or target — skips a TypError operand
// rather than report a second error derived from the first.

// isErrType reports whether t is the error type: the type of an expression
// whose error is already reported.
func isErrType(t @types.Type) bool {
	return t != nil && t.Kind == types.TYP_ERROR
}

// sigHasErrType reports whether a signature's parameters (a variadic one's
// element included) or results include the error type: a mistake in the
// signature, already reported, which makes the function value's type that
// error.
func sigHasErrType(params @[]@types.Param, results @[]@types.Type) bool {
	for i := 0; i < len(params); i++ {
		var pt @types.Type = params[i].Type
		if isErrType(pt) || (params[i].IsVariadic && pt != nil && isErrType(pt.Elem)) {
			return true
		}
	}
	for i := 0; i < len(results); i++ {
		if isErrType(results[i]) {
			return true
		}
	}
	return false
}
