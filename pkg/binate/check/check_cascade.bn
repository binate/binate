package "pkg/binate/check"

import "pkg/binate/types"

// One mistake, one error.  An expression whose error is already reported is
// typed TypError, and a context that would report its operand's type — an
// index or selector base, an operator's operand, a condition, a builtin's
// argument, an assignment's source or target — skips a TypError operand
// rather than report a second error derived from the first.

// isErrType reports whether t is the error type: the type of an expression
// whose error is already reported.
func isErrType(t @types.Type) bool {
	return t != nil && t.Kind == types.TYP_ERROR
}

// sigHasErrType reports whether a signature's parameters (a variadic one's
// element included) or results include the error type: a mistake in the
// signature, already reported, which makes the function value's type that
// error.
func sigHasErrType(params @[]@types.Param, results @[]@types.Type) bool {
	for i := 0; i < len(params); i++ {
		var pt @types.Type = params[i].Type
		if isErrType(pt) || (params[i].IsVariadic && pt != nil && isErrType(pt.Elem)) {
			return true
		}
	}
	for i := 0; i < len(results); i++ {
		if isErrType(results[i]) {
			return true
		}
	}
	return false
}

// holdsErrTypeByValue reports whether t holds the error type by value — as a
// field or an element, at any depth: its layout is not a type's, an error for it
// being reported (a struct whose field's array length is invalid).
func holdsErrTypeByValue(t @types.Type) bool {
	var v typeVisits
	return holdsErrTypeByValueIn(t, &v)
}

// holdsErrTypeByValueIn is holdsErrTypeByValue, entering each type it walks
// through once (typeVisits) — a named type, an alias, a readonly type, an array
// or a struct — so that a type holding itself by value through any of them
// (`type A [2]A`, `type A [2]readonly A`, `type A [2]B` with `type B = A`) is
// walked to its end.
func holdsErrTypeByValueIn(t @types.Type, v *typeVisits) bool {
	if t == nil {
		return false
	}
	if t.Kind == types.TYP_ERROR {
		return true
	}
	if t.Kind == types.TYP_STRUCT {
		if !v.enter(t) {
			return false
		}
		for i := 0; i < len(t.Fields); i++ {
			if holdsErrTypeByValueIn(t.Fields[i].Type, v) {
				return true
			}
		}
		return false
	}
	var inner @types.Type = nil
	if t.Kind == types.TYP_NAMED {
		inner = t.Underlying
	} else if t.Kind == types.TYP_ALIAS {
		inner = t.Target
	} else if t.Kind == types.TYP_READONLY || t.Kind == types.TYP_ARRAY {
		inner = t.Elem
	} else {
		return false
	}
	return v.enter(t) && holdsErrTypeByValueIn(inner, v)
}
