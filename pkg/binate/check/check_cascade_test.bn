package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_cascade.bn: one mistake, one error.

// cascadeProbeSrc wraps body in a function with a few typed locals and a
// two-result function to misuse.
func cascadeProbeSrc(body *[]readonly char) @[]char {
	var head *[]readonly char = "package \"test\"\ntype S struct {\n\tf int\n}\n"
			"func two() (int, int) { return 1, 2 }\n"
			"func vv(xs ...int) {}\n"
			"func f() {\n\tvar i int = 0\n\tvar a [2]int\n\tvar s S\n\t_ = i\n\t_ = a\n\t_ = s\n\t"
	return buf.Concat(buf.Concat(head, body), "\n}\n")
}

// Each body makes ONE mistake — an undefined name `u`, or the two-result
// call `two()` used as a value — in a different context, and must yield
// exactly one error: the context does not report a second one derived from
// the first.
func TestCheckOneMistakeOneError() testing.TestResult {
	var bodies @[]@[]char = make_slice(@[]char, 38)
	bodies[0] = "var x int = u[0]\n\t_ = x"
	bodies[1] = "var x int = a[u]\n\t_ = x"
	bodies[2] = "var y *[]int = u[0:1]\n\t_ = y"
	bodies[3] = "var y *[]int = a[u:1]\n\t_ = y"
	bodies[4] = "var x int = u.f\n\t_ = x"
	bodies[5] = "u.M()"
	bodies[6] = "var x int = -u\n\t_ = x"
	bodies[7] = "var b bool = !u\n\t_ = b"
	bodies[8] = "var x int = *u\n\t_ = x"
	bodies[9] = "var q *int = &u\n\t_ = q"
	bodies[10] = "var x int = u + 1\n\t_ = x"
	bodies[11] = "var b bool = u < 1\n\t_ = b"
	bodies[12] = "for v in u {\n\t\t_ = v\n\t}"
	bodies[13] = "if u {\n\t}"
	bodies[14] = "u++"
	bodies[15] = "i = u"
	bodies[16] = "var x int = len(u)\n\t_ = x"
	bodies[17] = "var y @[]int = make_slice(int, u)\n\t_ = y"
	bodies[18] = "var x int = unsafe_index(u, 0)\n\t_ = x"
	bodies[19] = "var x int = unsafe_div(u, 2)\n\t_ = x"
	bodies[20] = "var bx @int = box(u)\n\t_ = bx"
	bodies[21] = "var x int = u.(int)\n\t_ = x"
	bodies[22] = "u[0] = 1"
	bodies[23] = "u.f = 1"
	bodies[24] = "var t S = S{f: u}\n\t_ = t"
	bodies[25] = "switch t := u.(type) {\n\tcase int:\n\t\t_ = t\n\t}"
	bodies[26] = "x := u\n\tvar y int = x + 1\n\t_ = y"
	bodies[27] = "var x int = two()[0]\n\t_ = x"
	bodies[28] = "var x int = two().f\n\t_ = x"
	bodies[29] = "var x int = -two()\n\t_ = x"
	bodies[30] = "for v in two() {\n\t\t_ = v\n\t}"
	bodies[31] = "var x int = len(two())\n\t_ = x"
	bodies[32] = "u()"
	bodies[33] = "var b bool = same(u, i)\n\t_ = b"
	bodies[34] = "var arr [sizeof(U)]int\n\t_ = arr"
	bodies[35] = "var p *U\n\tp.x = 1"
	bodies[36] = "var fl @func() int = func() U {\n\t\treturn 0\n\t}\n\t_ = fl"
	bodies[37] = "vv(u...)"
	for k := 0; k < len(bodies); k++ {
		var c @Checker = checkSrc(cascadeProbeSrc(bodies[k]))
		if len(c.CheckerErrors()) != 1 {
			return fail(buf.Concat("one mistake must be one error: ", bodies[k]))
		}
	}
	return ""
}

// A const initialized from a mistake reports the mistake, not a second
// "requires a scalar type, got `<error>`".
func TestCheckConstFromMistakeOneError() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nconst k = u\n")
	if len(c.CheckerErrors()) != 1 {
		return fail("a const from an undefined name must be one error")
	}
	return expectErrSub(c, "undefined: u")
}

// A mistake does not hide a second, genuine error: assigning to a const is
// still reported, and a failed comma-ok assertion's `ok` is still a bool.
func TestCheckMistakeKeepsGenuineErrors() testing.TestResult {
	var c @Checker = checkSrc(cascadeProbeSrc("const C = 1\n\tC = u"))
	var r testing.TestResult = expectErrSub(c, "cannot assign to const C")
	if len(r) > 0 { return r }
	c = checkSrc(cascadeProbeSrc("var i *any\n\tv, ok := i.(*U)\n\tvar q int = ok\n\t_ = v\n\t_ = q"))
	return expectErrSub(c, "cannot assign bool to int")
}
