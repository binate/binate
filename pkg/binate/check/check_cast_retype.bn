package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Container retypes (§8.5 conv.cast.aggregate-retype): which element
// conversions `cast` (isAggregateLeafRetype) and `unsafe_cast`
// (isUnsafeAggregateLeafRetype) reinterpret in place across a raw slice, a
// managed-slice or an array.

// isUnsafeAggregateLeafRetype reports whether ps -> pd (both peeled) retypes a
// container — a raw slice, managed-slice or array of one length — over an
// element conversion unsafe_cast accepts in place: same-size elements whose
// conversion is bit-preserving once element-level readonly is ignored (a
// readonly drop, an integer of the same size, named <-> underlying, bool ->
// integer), or the partial integer / bool -> bool direction (§8.5's `int8 ->
// bool`) — or whose elements are containers retyped so in turn.  A
// value-changing element conversion (`int32 -> float32`) is not one: that is
// bit_cast's.
func isUnsafeAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	var noPairs @[]@types.Type
	return unsafeRetypeIn(ps, pd, noPairs, noPairs)
}

// unsafeRetypeIn is isUnsafeAggregateLeafRetype's walk.  inS / inD hold the
// (source, destination) container pairs already being compared: a pair reached
// again through its own elements — distinct recursive types such as `type T1
// @[]T1` and `type T2 @[]T2` — is a retype all the way down (every level is the
// same container over the same question), and comparing it again would recurse
// forever.
func unsafeRetypeIn(ps @types.Type, pd @types.Type, inS @[]@types.Type, inD @[]@types.Type) bool {
	if ps.Kind != pd.Kind {
		return false
	}
	for i := 0; i < len(inS); i++ {
		if same(inS[i], ps) && same(inD[i], pd) { return true }
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return false
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return false
	}
	var se @types.Type = types.StripWrappers(ps.Elem)
	var de @types.Type = types.StripWrappers(pd.Elem)
	if se == nil || de == nil || se.SizeOf() != de.SizeOf() {
		return false
	}
	if se.Identical(de) {
		return true
	}
	// A nested container (`[2][4]int8 -> [2][4]bool`): its elements are retyped
	// in place the same way.
	if unsafeRetypeIn(se, de, slices.Append[@types.Type](inS, ps),
			slices.Append[@types.Type](inD, pd)) {
		return true
	}
	if se.Kind == types.TYP_STRUCT && de.Kind == types.TYP_STRUCT {
		return sameStructFields(se, de)
	}
	if de.IsBool() {
		return se.IsInteger() || se.IsBool()
	}
	return de.IsInteger() && (se.IsInteger() || se.IsBool())
}

// isAggregateLeafRetype reports whether ps -> pd (both peeled) is a slice/array
// element retype to a same-size, bit-preserving element.  Codegen relabels the
// whole container with NO per-element loop, so the element conversion MUST be
// bit-preserving for the retype to be correct.
func isAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	if ps.Kind != pd.Kind {
		return false
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return false
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return false
	}
	if ps.Elem == nil || pd.Elem == nil {
		return false
	}
	// A slice's elements are behind its shared handle; an array's are part of the
	// copied value.
	return bitPreservingElem(ps.Elem, pd.Elem, ps.Kind != types.TYP_ARRAY)
}

// bitPreservingElem reports whether an element retype from se to de is a same-size
// bit-preserving reinterpret: identical elements, or same-size integers
// (int8<->uint8, int32<->uint32), either one adding element-level readonly.
// Excludes int<->float (value change), ->bool (partial), a readonly drop, and
// managed elements (refcount).  shared reports whether the elements are behind
// the container's shared handle (a slice) rather than copied (an array).
func bitPreservingElem(se @types.Type, de @types.Type, shared bool) bool {
	// Dropping element-level readonly — INCLUDING one hidden behind an alias /
	// named wrapper (DropsConstStrict peels aliases) — is unsafe_cast's job.
	// Adding it is a widening, as an assignment's is, under the same rule for
	// readonly added below a shared handle (§8.3 conv.readonly): `@[]readonly
	// uint8` from `@[]int8` is fine, `@[]*readonly T` from `@[]*T` is not.
	if DropsConstStrict(se, de) {
		return false
	}
	if shared && addsReadonlyBehindBorrow(se, de) {
		return false
	}
	if !shared && addsReadonlyBelowHandle(se, de) {
		return false
	}
	if se.Identical(de) {
		return true
	}
	var ps @types.Type = types.StripWrappers(se)
	var pd @types.Type = types.StripWrappers(de)
	if ps == nil || pd == nil {
		return false
	}
	return ps.IsInteger() && pd.IsInteger() && ps.SizeOf() == pd.SizeOf()
}

// sameStructFields reports whether two structs have the same field layout (same
// field names + types, in order) — the "same underlying" relationship for two
// distinct NAMED structs, which `Identical` treats nominally (by the struct's own
// name).  It deliberately ignores the structs' own names.
func sameStructFields(a @types.Type, b @types.Type) bool {
	if len(a.Fields) != len(b.Fields) {
		return false
	}
	for i := 0; i < len(a.Fields); i++ {
		if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) {
			return false
		}
		if a.Fields[i].Type == nil || b.Fields[i].Type == nil {
			return false
		}
		if !a.Fields[i].Type.Identical(b.Fields[i].Type) {
			return false
		}
	}
	return true
}
