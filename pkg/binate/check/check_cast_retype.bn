package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Container retypes (§8.5 conv.cast.aggregate-retype): which element
// conversions `cast` (isAggregateLeafRetype) and `unsafe_cast`
// (isUnsafeAggregateLeafRetype) reinterpret in place across a raw slice, a
// managed-slice or an array.

// isUnsafeAggregateLeafRetype reports whether ps -> pd (both peeled) retypes a
// container — a raw slice, managed-slice or array of one length — over an
// element conversion unsafe_cast accepts in place: same-size elements whose
// conversion is bit-preserving once element-level readonly is ignored (a
// readonly drop, an integer of the same size, named <-> underlying, bool ->
// integer), or the partial integer / bool -> bool direction (§8.5's `int8 ->
// bool`) — or whose elements are containers retyped so in turn.  A
// value-changing element conversion (`int32 -> float32`) is not one: that is
// bit_cast's.
func isUnsafeAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	var noPairs @[]@types.Type
	return unsafeRetypeIn(ps, pd, noPairs, noPairs)
}

// unsafeRetypeIn is isUnsafeAggregateLeafRetype's walk.  inS / inD hold the
// (source, destination) container pairs already being compared: a pair reached
// again through its own elements — distinct recursive types such as `type T1
// @[]T1` and `type T2 @[]T2` — is a retype all the way down (every level is the
// same container over the same question), and comparing it again would recurse
// forever.
func unsafeRetypeIn(ps @types.Type, pd @types.Type, inS @[]@types.Type, inD @[]@types.Type) bool {
	if ps.Kind != pd.Kind {
		return false
	}
	for i := 0; i < len(inS); i++ {
		if same(inS[i], ps) && same(inD[i], pd) { return true }
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return false
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return false
	}
	var se @types.Type = types.StripWrappers(ps.Elem)
	var de @types.Type = types.StripWrappers(pd.Elem)
	if se == nil || de == nil || se.SizeOf() != de.SizeOf() {
		return false
	}
	if se.Identical(de) {
		return true
	}
	// A nested container (`[2][4]int8 -> [2][4]bool`): its elements are retyped
	// in place the same way.
	if unsafeRetypeIn(se, de, slices.Append[@types.Type](inS, ps),
			slices.Append[@types.Type](inD, pd)) {
		return true
	}
	if se.Kind == types.TYP_STRUCT && de.Kind == types.TYP_STRUCT {
		return sameStructFields(se, de)
	}
	if de.IsBool() {
		return se.IsInteger() || se.IsBool()
	}
	return de.IsInteger() && (se.IsInteger() || se.IsBool())
}

// isAggregateLeafRetype reports whether ps -> pd (both peeled) is a slice/array
// element retype to a same-size, bit-preserving element — or to a container
// whose elements are retyped so in turn (the retype nests: `[2][4]int8 ->
// [2][4]uint8`).  Codegen relabels the whole container with NO per-element loop,
// so the element conversion MUST be bit-preserving for the retype to be correct.
func isAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	var noPairs @[]@types.Type
	return aggregateLeafRetypeIn(ps, pd, 0, true, false, noPairs, noPairs)
}

// aggregateLeafRetypeIn is isAggregateLeafRetype's walk, for containers ps / pd at
// readonly level `level` (addsReadonlyAt's levels: guarded reports whether every
// level from 1 up to this one is readonly in the destination, slotRO whether this
// level's slot is), so a nested container's elements are held to the readonly
// rules of their depth, not their own container's alone.  inS / inD hold the
// (source, destination) container pairs already being compared, as for
// unsafeRetypeIn: a pair reached again through its own elements (distinct
// recursive types, `type T1 @[]T1` and `type T2 @[]T2`) is a retype all the way
// down.
func aggregateLeafRetypeIn(ps @types.Type, pd @types.Type, level int, guarded bool, slotRO bool,
		inS @[]@types.Type, inD @[]@types.Type) bool {
	if ps.Kind != pd.Kind {
		return false
	}
	for i := 0; i < len(inS); i++ {
		if same(inS[i], ps) && same(inD[i], pd) { return true }
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return false
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return false
	}
	if ps.Elem == nil || pd.Elem == nil {
		return false
	}
	// A slice's elements are behind its handle, one level down, in slots of their
	// own; an array's share its storage, on its level and in its slot — a
	// `[N]readonly T` slot can still be overwritten as a whole value, so readonly
	// elements do not guard the level below them (addsReadonlyAt).
	var elemLevel int = level
	var elemGuarded bool = guarded
	var elemSlotRO bool = slotRO
	if ps.Kind != types.TYP_ARRAY {
		elemLevel = level + 1
		elemGuarded = level == 0 || (guarded && slotRO)
		elemSlotRO = isReadonlySlot(pd.Elem)
	}
	return bitPreservingElemIn(ps.Elem, pd.Elem, elemLevel, elemGuarded, elemSlotRO,
			slices.Append[@types.Type](inS, ps), slices.Append[@types.Type](inD, pd))
}

// bitPreservingElem reports whether an element retype from se to de is total and
// bit-preserving (§8.5 conv.cast.aggregate-retype, the leaf rule): elements
// identical once named / alias wrappers are peeled (a named type and its
// underlying, two named types sharing one), two structs of one layout, same-size
// integers (int8<->uint8, int32<->uint32), or bool to a 1-byte integer (behind a
// shared handle, only to a readonly element) — any of them adding element-level
// readonly.  Excludes int<->float (value change), an
// integer to bool (partial: most integers are no valid bool), and a readonly
// drop.  shared reports whether the elements are behind the container's shared
// handle (a slice) rather than copied (an array).
func bitPreservingElem(se @types.Type, de @types.Type, shared bool) bool {
	var noPairs @[]@types.Type
	var level int = 0
	if shared { level = 1 }
	return bitPreservingElemIn(se, de, level, true, isReadonlySlot(de), noPairs, noPairs)
}

// bitPreservingElemIn is bitPreservingElem for elements at readonly level `level`
// (guarded and slotRO — the readonly-ness of the slot the elements are in — as for
// addsReadonlyAt), inside aggregateLeafRetypeIn's walk: inS / inD are its pairs,
// threaded to an element that is itself a container.
func bitPreservingElemIn(se @types.Type, de @types.Type, level int, guarded bool, slotRO bool,
		inS @[]@types.Type, inD @[]@types.Type) bool {
	// The readonly checks compare each element's slotView: readonly at every level
	// as an assignment through a location of that type sees it.
	se = slotView(se)
	de = slotView(de)
	if !elemReadonlyKept(se, de, level, guarded, slotRO) {
		return false
	}
	if se.Identical(de) {
		return true
	}
	var ps @types.Type = types.StripWrappers(se)
	var pd @types.Type = types.StripWrappers(de)
	if ps == nil || pd == nil {
		return false
	}
	// Two structs of one layout (sameStructFields compares the fields by the
	// readonly-blind Identical).  A field sits in its element's slot, so each
	// field pair is held to the element's readonly rules at the element's level —
	// and a readonly added below a slice's handle is guarded by the ELEMENT's
	// slot, not the field's own: a struct is overwritten as a whole value however
	// readonly its fields are (§8.3).  The checks' own walk treats an anonymous
	// struct the same way, but stops at a named one.
	if isSameFieldsStructPair(ps, pd) {
		for i := 0; i < len(ps.Fields); i++ {
			if !elemReadonlyKept(ps.Fields[i].Type, pd.Fields[i].Type, level, guarded, slotRO) {
				return false
			}
		}
		return true
	}
	// A nested container (`[2][4]int8 -> [2][4]uint8`, `@[]@[]int8 -> @[]@[]uint8`):
	// its elements are retyped in place the same way — the retype nests (§8.5).  The
	// readonly rules were checked above on the whole element types.
	if aggregateLeafRetypeIn(ps, pd, level, guarded, slotRO, inS, inD) {
		return true
	}
	// A bool is 0 or 1, a valid value of every 1-byte integer.  But below a shared
	// handle (level 1 and down) the new view shares the backing, so what it writes
	// the source reads back through the reverse conversion, which is partial (most
	// bytes are no valid bool): there the destination element's slot must be
	// readonly — for an array's element, the array's slot, as the array can be
	// overwritten whole.
	if ps.IsBool() && pd.IsInteger() && pd.SizeOf() == 1 {
		return level == 0 || slotRO
	}
	return ps.IsInteger() && pd.IsInteger() && ps.SizeOf() == pd.SizeOf()
}

// elemReadonlyKept reports whether retyping a container element (or a field of
// one) from se to de, at readonly level `level` (guarded and slotRO as for
// addsReadonlyAt), keeps the readonly rules.  Dropping element-level readonly is
// unsafe_cast's job.  Adding it is a widening, as an assignment's is, under the
// same rule for readonly added below a shared handle (§8.3 conv.readonly):
// `@[]readonly uint8` from `@[]int8` is fine, `@[]*readonly T` from `@[]*T` is
// not.  A slice's element is one level below its handle, an array's is part of
// the copied value.
func elemReadonlyKept(se @types.Type, de @types.Type, level int, guarded bool, slotRO bool) bool {
	if DropsConstStrict(se, de) {
		return false
	}
	return !addsReadonlyAt(se, de, level, guarded, slotRO)
}

// slotView returns the type the readonly checks compare for a location of type
// t: t with its alias and named-distinct wrappers peeled (peelNamedKeepReadonly),
// so a readonly a named type hides one level in or deeper is seen (`type RP
// *readonly int` reads as `*readonly int`, as a dereference does) — with the
// outermost readonly the location itself has (isReadonlySlot), which a named type
// over a readonly type (`type RI readonly int8`) gives its locations too.
func slotView(t @types.Type) @types.Type {
	var p @types.Type = peelNamedKeepReadonly(t)
	if p != nil && p.Kind == types.TYP_READONLY {
		p = p.Elem
	}
	if isReadonlySlot(t) {
		return types.MakeReadonlyType(p)
	}
	return p
}

// peelNamedKeepReadonly peels alias and named-distinct wrappers off t's top level
// — through a readonly, which it keeps — so the readonly checks see a readonly a
// named type hides: `type RP *readonly int` peels to `*readonly int`, `readonly
// N` (N a named int) to `readonly int`.
func peelNamedKeepReadonly(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else if t.Kind == types.TYP_READONLY {
			return types.MakeReadonlyType(peelNamedKeepReadonly(t.Elem))
		} else {
			return t
		}
	}
	return t
}

// sameStructFields reports whether two structs have the same field layout (same
// field names + types, in order) — the "same underlying" relationship for two
// distinct NAMED structs, which `Identical` treats nominally (by the struct's own
// name).  It deliberately ignores the structs' own names.
func sameStructFields(a @types.Type, b @types.Type) bool {
	if len(a.Fields) != len(b.Fields) {
		return false
	}
	for i := 0; i < len(a.Fields); i++ {
		if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) {
			return false
		}
		if a.Fields[i].Type == nil || b.Fields[i].Type == nil {
			return false
		}
		if !a.Fields[i].Type.Identical(b.Fields[i].Type) {
			return false
		}
	}
	return true
}
