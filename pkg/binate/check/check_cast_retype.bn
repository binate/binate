package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/vec"

// Container retypes (§8.5 conv.cast.aggregate-retype): which element
// conversions `cast` (isAggregateLeafRetype) and `unsafe_cast`
// (isUnsafeAggregateLeafRetype) reinterpret in place across a raw slice, a
// managed-slice or an array.

// isUnsafeAggregateLeafRetype reports whether ps -> pd (both peeled) retypes a
// container — a raw slice, managed-slice or array of one length — over an
// element conversion unsafe_cast accepts in place: same-size elements whose
// conversion is bit-preserving once element-level readonly is ignored (a
// readonly drop, an integer of the same size, named <-> underlying, bool ->
// integer), or the partial integer / bool -> bool direction (§8.5's `int8 ->
// bool`) — or whose elements are containers retyped so in turn.  A
// value-changing element conversion (`int32 -> float32`) is not one: that is
// bit_cast's.
func isUnsafeAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	// Down the chain of containers, each holding the next as its element: a level
	// decides (unsafeRetypeLevel), or goes on to its elements, keeping them to try its
	// own element conversion with (unsafeRetypeElems) if the chain below fails.  A
	// pair met again through its own elements -- distinct recursive types such as
	// `type T1 @[]T1` and `type T2 @[]T2` -- is a retype all the way down.
	var path retypePath
	var elemS @vec.Vec[@types.Type] = vec.New[@types.Type]()
	var elemD @vec.Vec[@types.Type] = vec.New[@types.Type]()
	for {
		if path.metAgain(ps, pd) { return true }
		decided, retype, se, de := unsafeRetypeLevel(ps, pd)
		if decided {
			if retype { return true }
			break
		}
		elemS.Push(se)
		elemD.Push(de)
		ps = se
		pd = de
	}
	for i := elemS.Len() - 1; i >= 0; i-- {
		if unsafeRetypeElems(elemS.Get(i), elemD.Get(i)) { return true }
	}
	return false
}

// A retypePath is the chain of container pairs a retype walk is inside: the pairs in
// order (srcs, dsts), and the types on each side (srcIn, dstIn), so a pair is looked
// for among the pairs only when its two types are each on the chain already.  The zero
// value is empty.
type retypePath struct {
	srcs  @vec.Vec[@types.Type]
	dsts  @vec.Vec[@types.Type]
	srcIn typeVisits
	dstIn typeVisits
}

// metAgain reports whether the container pair ps, pd is on p, and puts it on p if not.
func (p *retypePath) metAgain(ps @types.Type, pd @types.Type) bool {
	var newSrc bool = p.srcIn.enter(ps)
	var newDst bool = p.dstIn.enter(pd)
	if p.srcs == nil {
		p.srcs = vec.New[@types.Type]()
		p.dsts = vec.New[@types.Type]()
	}
	if !newSrc && !newDst {
		for i := 0; i < p.srcs.Len(); i++ {
			if same(p.srcs.Get(i), ps) && same(p.dsts.Get(i), pd) { return true }
		}
	}
	p.srcs.Push(ps)
	p.dsts.Push(pd)
	return false
}

// unsafeRetypeLevel decides the container pair ps -> pd where it can by itself
// (decided; retype its answer): not the same kind of container, or of another length,
// or over elements of other sizes, is no retype; identical elements are one.
// Otherwise it returns the two elements (se, de), whose containers go on.
func unsafeRetypeLevel(ps @types.Type, pd @types.Type) (bool, bool, @types.Type, @types.Type) {
	var none @types.Type
	if ps.Kind != pd.Kind {
		return true, false, none, none
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return true, false, none, none
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return true, false, none, none
	}
	var se @types.Type = types.StripWrappers(ps.Elem)
	var de @types.Type = types.StripWrappers(pd.Elem)
	if se == nil || de == nil {
		return true, false, none, none
	}
	var ss int64
	var sok bool
	ss, sok = se.SizeIfFits()
	var ds int64
	var dok bool
	ds, dok = de.SizeIfFits()
	if !sok || !dok || ss != ds {
		return true, false, none, none
	}
	if se.Identical(de) {
		return true, true, none, none
	}
	return false, false, se, de
}

// unsafeRetypeElems reports whether the same-size elements se -> de convert in place,
// as unsafe_cast accepts, when they are not containers retyped so in turn: the same
// fields (sameStructFields), an integer or bool to bool, or an integer or bool to an
// integer.
func unsafeRetypeElems(se @types.Type, de @types.Type) bool {
	if se.Kind == types.TYP_STRUCT && de.Kind == types.TYP_STRUCT {
		return sameStructFields(se, de)
	}
	if de.IsBool() {
		return se.IsInteger() || se.IsBool()
	}
	return de.IsInteger() && (se.IsInteger() || se.IsBool())
}

// isAggregateLeafRetype reports whether ps -> pd (both peeled) is a slice/array
// element retype to a same-size, bit-preserving element — or to a container
// whose elements are retyped so in turn (the retype nests: `[2][4]int8 ->
// [2][4]uint8`).  Codegen relabels the whole container with NO per-element loop,
// so the element conversion MUST be bit-preserving for the retype to be correct.
func isAggregateLeafRetype(ps @types.Type, pd @types.Type) bool {
	return leafRetypeWalk(ps, pd, 0, true, false, true)
}

// bitPreservingElem reports whether an element retype from se to de is total and
// bit-preserving (§8.5 conv.cast.aggregate-retype, the leaf rule): elements
// identical once named / alias wrappers are peeled (a named type and its
// underlying, two named types sharing one), two structs of one layout, same-size
// integers (int8<->uint8, int32<->uint32), or bool to a 1-byte integer (behind a
// shared handle, only to a readonly element) — any of them adding element-level
// readonly.  Excludes int<->float (value change), an
// integer to bool (partial: most integers are no valid bool), and a readonly
// drop.  shared reports whether the elements are behind the container's shared
// handle (a slice) rather than copied (an array).
func bitPreservingElem(se @types.Type, de @types.Type, shared bool) bool {
	var level int = 0
	if shared { level = 1 }
	return leafRetypeWalk(se, de, level, true, isReadonlySlot(de), false)
}

// leafRetypeWalk is isAggregateLeafRetype's and bitPreservingElem's walk, from the pair
// a -> b -- containers when container, else their elements -- at readonly level
// `level` (addsReadonlyAt's levels: guarded reports whether every level from 1 up to
// this one is readonly in the destination, slotRO whether this level's slot is), so a
// nested container's elements are held to the readonly rules of their depth, not
// their own container's alone.  It goes down the chain of containers, each holding
// the next as its element: a container pair decides (leafRetypeContainer) or goes on
// to its elements; an element pair decides (leafRetypeElemDecides) or is itself a
// container pair, which goes on, keeping the elements to try a scalar retype with
// (leafRetypeScalar) if the chain below fails.  A pair reached again through its own
// elements (distinct recursive types, `type T1 @[]T1` and `type T2 @[]T2`) is a
// retype all the way down.
func leafRetypeWalk(a @types.Type, b @types.Type, level int, guarded bool, slotRO bool,
		container bool) bool {
	var path retypePath
	var tried @vec.Vec[leafRetypeLevel] = vec.New[leafRetypeLevel]()
	var answer bool = false
	for {
		if container {
			if path.metAgain(a, b) {
				answer = true
				break
			}
			var ok bool
			ok, level, guarded, slotRO = leafRetypeContainer(a, b, level, guarded, slotRO)
			if !ok { break }
			a = a.Elem
			b = b.Elem
			container = false
			continue
		}
		decided, retype, ps, pd := leafRetypeElemDecides(a, b, level, guarded, slotRO)
		if decided {
			answer = retype
			break
		}
		var t leafRetypeLevel
		t.ps = ps
		t.pd = pd
		t.level = level
		t.slotRO = slotRO
		tried.Push(t)
		a = ps
		b = pd
		container = true
	}
	for i := tried.Len() - 1; !answer && i >= 0; i-- {
		var t leafRetypeLevel = tried.Get(i)
		answer = leafRetypeScalar(t.ps, t.pd, t.level, t.slotRO)
	}
	return answer
}

// leafRetypeLevel is an element pair of leafRetypeWalk's chain that is a container
// pair, peeled (ps, pd), with its readonly level and slot, to try a scalar retype with
// if the containers' elements fail.
type leafRetypeLevel struct {
	ps     @types.Type
	pd     @types.Type
	level  int
	slotRO bool
}

// leafRetypeContainer reports whether the container pair ps -> pd can be retyped as a
// whole -- the same kind of container, of one length, over elements -- and returns the
// readonly level, guard and slot of its elements: a slice's elements are behind its
// handle, one level down, in slots of their own; an array's share its storage, on its
// level and in its slot -- a `[N]readonly T` slot can still be overwritten as a whole
// value, so readonly elements do not guard the level below them (addsReadonlyAt).
func leafRetypeContainer(ps @types.Type, pd @types.Type, level int, guarded bool,
		slotRO bool) (bool, int, bool, bool) {
	if ps.Kind != pd.Kind {
		return false, level, guarded, slotRO
	}
	if ps.Kind != types.TYP_SLICE && ps.Kind != types.TYP_MANAGED_SLICE && ps.Kind != types.TYP_ARRAY {
		return false, level, guarded, slotRO
	}
	if ps.Kind == types.TYP_ARRAY && ps.ArrayLen != pd.ArrayLen {
		return false, level, guarded, slotRO
	}
	if ps.Elem == nil || pd.Elem == nil {
		return false, level, guarded, slotRO
	}
	if ps.Kind == types.TYP_ARRAY {
		return true, level, guarded, slotRO
	}
	return true, level + 1, level == 0 || (guarded && slotRO), isReadonlySlot(pd.Elem)
}

// leafRetypeElemDecides decides the element pair se -> de where it can by itself
// (decided; retype its answer): one that breaks the readonly rules is no retype --
// compared as each element's slotView, readonly at every level as an assignment
// through a location of that type sees it -- and identical elements are one; so are
// two structs of one layout (sameStructFields compares the fields by the
// readonly-blind Identical), each field pair held to the element's readonly rules at
// the element's level -- a readonly added below a slice's handle is guarded by the
// ELEMENT's slot, not the field's own: a struct is overwritten as a whole value however
// readonly its fields are (§8.3).  Otherwise it returns the elements peeled (ps, pd):
// a nested container (`[2][4]int8 -> [2][4]uint8`, `@[]@[]int8 -> @[]@[]uint8`) whose
// elements are retyped in place the same way -- the retype nests (§8.5); the readonly
// rules were checked here on the whole element types.
func leafRetypeElemDecides(se @types.Type, de @types.Type, level int, guarded bool,
		slotRO bool) (bool, bool, @types.Type, @types.Type) {
	var none @types.Type
	se = slotView(se)
	de = slotView(de)
	if !elemReadonlyKept(se, de, level, guarded, slotRO) {
		return true, false, none, none
	}
	if se.Identical(de) {
		return true, true, none, none
	}
	var ps @types.Type = types.StripWrappers(se)
	var pd @types.Type = types.StripWrappers(de)
	if ps == nil || pd == nil {
		return true, false, none, none
	}
	if isSameFieldsStructPair(ps, pd) {
		for i := 0; i < len(ps.Fields); i++ {
			if !elemReadonlyKept(ps.Fields[i].Type, pd.Fields[i].Type, level, guarded, slotRO) {
				return true, false, none, none
			}
		}
		return true, true, none, none
	}
	return false, false, ps, pd
}

// leafRetypeScalar reports whether the peeled elements ps -> pd retype bit for bit as
// scalars: same-size integers, or a bool to a 1-byte integer.  A bool is 0 or 1, a
// valid value of every 1-byte integer.  But below a shared handle (level 1 and down)
// the new view shares the backing, so what it writes the source reads back through
// the reverse conversion, which is partial (most bytes are no valid bool): there the
// destination element's slot must be readonly -- for an array's element, the array's
// slot, as the array can be overwritten whole.
func leafRetypeScalar(ps @types.Type, pd @types.Type, level int, slotRO bool) bool {
	if ps.IsBool() && pd.IsInteger() && pd.Size() == 1 {
		return level == 0 || slotRO
	}
	return ps.IsInteger() && pd.IsInteger() && ps.Size() == pd.Size()
}

// elemReadonlyKept reports whether retyping a container element (or a field of
// one) from se to de, at readonly level `level` (guarded and slotRO as for
// addsReadonlyAt), keeps the readonly rules.  Dropping element-level readonly is
// unsafe_cast's job.  Adding it is a widening, as an assignment's is, under the
// same rule for readonly added below a shared handle (§8.3 conv.readonly):
// `@[]readonly uint8` from `@[]int8` is fine, `@[]*readonly T` from `@[]*T` is
// not.  A slice's element is one level below its handle, an array's is part of
// the copied value.
func elemReadonlyKept(se @types.Type, de @types.Type, level int, guarded bool, slotRO bool) bool {
	if DropsConstStrict(se, de) {
		return false
	}
	return !addsReadonlyAt(se, de, level, guarded, slotRO)
}

// slotView returns the type the readonly checks compare for a location of type
// t: t with its alias and named-distinct wrappers peeled (peelNamedKeepReadonly),
// so a readonly a named type hides one level in or deeper is seen (`type RP
// *readonly int` reads as `*readonly int`, as a dereference does) — with the
// outermost readonly the location itself has (isReadonlySlot), which a named type
// over a readonly type (`type RI readonly int8`) gives its locations too.
func slotView(t @types.Type) @types.Type {
	var p @types.Type = peelNamedKeepReadonly(t)
	if p != nil && p.Kind == types.TYP_READONLY {
		p = p.Elem
	}
	if isReadonlySlot(t) {
		return types.MakeReadonlyType(p)
	}
	return p
}

// peelNamedKeepReadonly peels alias and named-distinct wrappers off t's top level
// — through a readonly, which it keeps — so the readonly checks see a readonly a
// named type hides: `type RP *readonly int` peels to `*readonly int`, `readonly
// N` (N a named int) to `readonly int`.  The readonly wrappers peeled through are put
// back around what is left, innermost first.
func peelNamedKeepReadonly(t @types.Type) @types.Type {
	var readonlys int = 0
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else if t.Kind == types.TYP_READONLY {
			readonlys = readonlys + 1
			t = t.Elem
		} else {
			break
		}
	}
	for i := 0; i < readonlys; i++ {
		t = types.MakeReadonlyType(t)
	}
	return t
}

// sameStructFields reports whether two structs have the same field layout (same
// field names + types, in order) — the "same underlying" relationship for two
// distinct NAMED structs, which `Identical` treats nominally (by the struct's own
// name).  It deliberately ignores the structs' own names.
func sameStructFields(a @types.Type, b @types.Type) bool {
	if len(a.Fields) != len(b.Fields) {
		return false
	}
	for i := 0; i < len(a.Fields); i++ {
		if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) {
			return false
		}
		if a.Fields[i].Type == nil || b.Fields[i].Type == nil {
			return false
		}
		if !a.Fields[i].Type.Identical(b.Fields[i].Type) {
			return false
		}
	}
	return true
}
