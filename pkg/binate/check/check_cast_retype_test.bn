package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"

import "pkg/builtins/testing"

// Predicate tests for the container-retype helpers (check_cast_retype.bn).

// bitPreservingElem: same-size integers reinterpret bit-for-bit; int<->float and
// different-size conversions do not.
func TestCastGateBitPreservingElem() testing.TestResult {
	if !bitPreservingElem(types.TypInt8(), types.TypUint8(), true) {
		return fail("int8<->uint8 (same size) should be bit-preserving")
	}
	if bitPreservingElem(types.TypInt8(), types.TypInt32(), true) {
		return fail("int8->int32 (different size) should NOT be bit-preserving")
	}
	if bitPreservingElem(types.TypInt32(), types.TypFloat32(), true) {
		return fail("int32->float32 (value conversion) should NOT be bit-preserving")
	}
	return ""
}

// bitPreservingElem: adding element-level readonly is a widening (where the
// shared-handle rule allows it); dropping it is not a cast.
func TestCastGateBitPreservingElemReadonly() testing.TestResult {
	var ro8 @types.Type = types.MakeReadonlyType(types.TypUint8())
	if !bitPreservingElem(types.TypInt8(), ro8, true) {
		return fail("int8 -> readonly uint8 adds readonly: a widening")
	}
	if bitPreservingElem(types.MakeReadonlyType(types.TypInt8()), types.TypUint8(), true) {
		return fail("readonly int8 -> uint8 drops readonly: unsafe_cast's")
	}
	var p @types.Type = types.MakePointerType(types.TypInt8())
	var rp @types.Type = types.MakePointerType(types.MakeReadonlyType(types.TypInt8()))
	if bitPreservingElem(p, rp, true) {
		return fail("*int8 -> *readonly int8 behind a slice adds readonly below its handle")
	}
	if !bitPreservingElem(p, rp, false) {
		return fail("*int8 -> *readonly int8 in a copied array is one level in")
	}
	return ""
}

// isAggregateLeafRetype: a slice/array element retype qualifies only when the
// element is same-size and bit-preserving.
func TestCastGateAggregateLeafRetype() testing.TestResult {
	if !isAggregateLeafRetype(types.MakeManagedSliceType(types.TypInt8()),
			types.MakeManagedSliceType(types.TypUint8())) {
		return fail("@[]int8 -> @[]uint8 should be a leaf retype")
	}
	if isAggregateLeafRetype(types.MakeManagedSliceType(types.TypInt32()),
			types.MakeManagedSliceType(types.TypInt64())) {
		return fail("@[]int32 -> @[]int64 should NOT be a leaf retype (element size)")
	}
	if isAggregateLeafRetype(types.MakeManagedSliceType(types.TypInt32()),
			types.MakeManagedSliceType(types.TypFloat32())) {
		return fail("@[]int32 -> @[]float32 should NOT be a leaf retype (value-changing)")
	}
	if !isAggregateLeafRetype(types.MakeSliceType(types.TypInt8()),
			types.MakeSliceType(types.TypUint8())) {
		return fail("*[]int8 -> *[]uint8 should be a leaf retype")
	}
	if isAggregateLeafRetype(types.TypInt(), types.TypInt()) {
		return fail("int -> int is not an aggregate leaf retype")
	}
	// A slice and an array of the same element are different container kinds.
	if isAggregateLeafRetype(types.MakeManagedSliceType(types.TypInt8()),
			types.MakeArrayType(types.TypInt8(), 4)) {
		return fail("@[]int8 -> [4]int8 is not a leaf retype (different container kind)")
	}
	return ""
}

// The leaf rule's element conversions beyond same-size integers: bool to a
// 1-byte integer, a named type and its underlying (or two named types sharing
// one), two structs of one layout — managed elements and fields included, since
// the two sides manage the same words alike — any of them adding element-level
// readonly where an assignment could.  Below a slice's handle a field's added
// readonly is guarded by a readonly element slot, as an anonymous struct's is.
// A named type over a readonly type (`RI`) gives its locations no readonly of
// their own, so retyping from it drops nothing.
func TestCastRetypeLeafRuleAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type P struct { x int32; y int32 }\ntype Q struct { x int32; y int32 }\n"
							"type C float64\ntype F float64\ntype RP *readonly int8\n"
							"type P2 struct { p *int }\ntype Q2 struct { p *readonly int }\n"
							"type MB bool\ntype MU uint8\ntype N struct { v int }\ntype H @N\n"
							"type PM struct { n @N }\ntype QM struct { n @N }\n"
							"type PC struct { p *char }\ntype QC struct { p *readonly char }\n"
							"type FV *func(int) int\ntype RI readonly int8\n"
							"func f(b [3]bool, mb @[]bool, rb *[]bool, c [2]C, p [2]P, mp @[]P,\n"
							"    rp [2]RP, p2 [2]P2, nb [2]MB, h [2]H, mh @[]H, pm @[]PM, pc @[]PC,\n"
							"    fv [2]FV, i8 @[]int8, ri [2]RI) {\n"
							"  var b1 [3]uint8 = cast([3]uint8, b); _ = b1\n"
							"  var b2 [3]int8 = cast([3]int8, b); _ = b2\n"
							"  var b3 @[]readonly uint8 = cast(@[]readonly uint8, mb); _ = b3\n"
							"  var b4 *[]readonly int8 = cast(*[]readonly int8, rb); _ = b4\n"
							"  var b5 @[]readonly uint8 = cast(@[]readonly uint8, mb); _ = b5\n"
							"  var b6 [2]uint8 = cast([2]uint8, nb); _ = b6\n"
							"  var b7 [3]MU = cast([3]MU, b); _ = b7\n"
							"  var c1 [2]float64 = cast([2]float64, c); _ = c1\n"
							"  var c2 [2]C = cast([2]C, c1); _ = c2\n"
							"  var c3 [2]F = cast([2]F, c); _ = c3\n"
							"  var p1 [2]Q = cast([2]Q, p); _ = p1\n"
							"  var p3 [2]struct { x int32; y int32 } = cast([2]struct { x int32; y int32 }, p)\n"
							"  _ = p3\n"
							"  var p4 @[]readonly Q = cast(@[]readonly Q, mp); _ = p4\n"
							"  var p5 @[]Q = cast(@[]Q, mp); _ = p5\n"
							"  var r1 [2]*readonly int8 = cast([2]*readonly int8, rp); _ = r1\n"
							"  var q2 [2]Q2 = cast([2]Q2, p2); _ = q2\n"
							"  var h1 [2]@N = cast([2]@N, h); _ = h1\n"
							"  var h2 @[]@N = cast(@[]@N, mh); _ = h2\n"
							"  var m1 @[]QM = cast(@[]QM, pm); _ = m1\n"
							"  var g1 @[]readonly QC = cast(@[]readonly QC, pc); _ = g1\n"
							"  var g2 @[]readonly struct { p *readonly char } =\n"
							"      cast(@[]readonly struct { p *readonly char }, pc); _ = g2\n"
							"  var v1 [2]*func(int) int = cast([2]*func(int) int, fv); _ = v1\n"
							"  var i1 @[]RI = cast(@[]RI, i8); _ = i1\n"
							"  var i2 @[]uint8 = cast(@[]uint8, i1); _ = i2\n"
							"  var i3 [2]int8 = cast([2]int8, ri); _ = i3\n"
							"}\n"))
}

// rejectsRetype checks one function body against decls and reports a failure
// unless the checker rejects each of its n casts with a message containing
// needle.
func rejectsRetype(decls *[]readonly char, body *[]readonly char, needle *[]readonly char,
		n int) testing.TestResult {
	var src @[]char = buf.Concat(buf.Concat("package \"test\"\n", decls), body)
	var errs @[]types.CheckError = checkSrc(src).CheckerErrors()
	var hits int = 0
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, needle) { hits++ }
	}
	if hits == n && len(errs) == n { return "" }
	if len(errs) == 0 { return fail(buf.Concat("expected an error for: ", body)) }
	return fail(buf.Concat(buf.Concat(errs[0].Msg, " -- for: "), body))
}

// What the leaf rule leaves to bit_cast or explicit construction: a
// value-changing element conversion (an integer <-> a float, directly or through
// a named type), a size change, a pointer to a different pointee, a managed <->
// raw element.
func TestCastRetypeLeafRuleRejectedValueChange() testing.TestResult {
	var bc *[]readonly char = "cast does not support this conversion"
	var r testing.TestResult = rejectsRetype("",
			"func f(a [2]int32) { var x [2]float32 = cast([2]float32, a); _ = x }\n", bc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("", "func f(a [2]float32) { var x [2]int32 = cast([2]int32, a); _ = x }\n", bc,
			1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type C int64\n",
			"func f(a [2]C) { var x [2]float64 = cast([2]float64, a); _ = x }\n", bc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("", "func f(a [2]bool) { var x [2]int16 = cast([2]int16, a); _ = x }\n", bc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("", "func f(a @[]bool) { var x @[]float32 = cast(@[]float32, a); _ = x }\n", bc,
			1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type C float64\n",
			"func f(a [2]*C) { var x [2]*float64 = cast([2]*float64, a); _ = x }\n", bc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type P struct { v int }\ntype Q struct { v int }\n",
			"func f(a @[]*P, b [2]@P) {\n"
					"  var x @[]*Q = cast(@[]*Q, a); _ = x\n  var y [2]@Q = cast([2]@Q, b); _ = y\n}\n",
			bc, 2)
	if len(r) > 0 { return r }
	r = rejectsRetype("type P struct { p @int }\ntype Q struct { p *int }\n",
			"func f(a [2]P) { var x [2]Q = cast([2]Q, a); _ = x }\n", bc, 1)
	if len(r) > 0 { return r }
	return rejectsRetype("type N struct { v int }\ntype H @N\n",
			"func f(a [2]H) { var x [2]*N = cast([2]*N, a); _ = x }\n", bc, 1)
}

// What the leaf rule leaves to unsafe_cast, which the message names: a partial
// element conversion (an integer to bool), and a readonly drop or unguarded add —
// on the element, on a field of a same-layout struct (whose own readonly guards
// nothing: the element slot is what is overwritten), or hidden behind a named
// element type.
func TestCastRetypeLeafRuleRejectedUnsafe() testing.TestResult {
	var uc *[]readonly char = "use unsafe_cast"
	var r testing.TestResult = rejectsRetype("",
			"func f(a [3]int8) { var x [3]bool = cast([3]bool, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("", "func f(a @[]readonly bool) { var x @[]uint8 = cast(@[]uint8, a); _ = x }\n",
			uc, 1)
	if len(r) > 0 { return r }
	// A slice's bool -> byte retype to a writable element: the new handle could
	// store a byte other than 0 / 1 that the bool handle then reads.
	r = rejectsRetype("type MB bool\n",
			"func f(a @[]bool, b *[]bool, c @[]MB) {\n"
					"  var x @[]uint8 = cast(@[]uint8, a); _ = x\n"
					"  var y *[]int8 = cast(*[]int8, b); _ = y\n"
					"  var z @[]uint8 = cast(@[]uint8, c); _ = z\n}\n",
			uc, 3)
	if len(r) > 0 { return r }
	r = rejectsRetype("type P struct { p *int }\ntype Q struct { p *readonly int }\n",
			"func f(a @[]P) { var x @[]Q = cast(@[]Q, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type P struct { p *char }\ntype Q struct { p readonly *readonly char }\n",
			"func f(a @[]P, b *[]P) {\n"
					"  var x @[]Q = cast(@[]Q, a); _ = x\n  var y *[]Q = cast(*[]Q, b); _ = y\n}\n",
			uc, 2)
	if len(r) > 0 { return r }
	r = rejectsRetype("type P struct { p *readonly int }\ntype Q struct { p *int }\n",
			"func f(a [2]P) { var x [2]Q = cast([2]Q, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type RP *readonly int8\n",
			"func f(a [2]RP) { var x [2]*int8 = cast([2]*int8, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	r = rejectsRetype("type RP *readonly int8\n",
			"func f(a @[]*int8) { var x @[]RP = cast(@[]RP, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	// A named destination over a readonly type: its locations are writable (an
	// assignment sees through aliases only), so a readonly source slot retyped to
	// it is a drop.
	r = rejectsRetype(
			"type RI readonly int8\ntype Q struct { v int }\ntype RQ readonly Q\n"
					"type RP2 readonly *int\n",
			"func f(a @[]readonly int8, b @[]readonly Q, c @[]readonly *int) {\n"
					"  var x @[]RI = cast(@[]RI, a); _ = x\n"
					"  var y @[]RQ = cast(@[]RQ, b); _ = y\n"
					"  var z @[]RP2 = cast(@[]RP2, c); _ = z\n}\n",
			uc, 3)
	if len(r) > 0 { return r }
	// A named destination over a readonly type: its locations stay writable, so
	// its readonly guards nothing below the slice's handle.
	r = rejectsRetype(
			"type RP readonly *readonly int\ntype P struct { p *int }\n"
					"type Q struct { p *readonly int }\ntype RQ readonly Q\n",
			"func f(a @[]*int, b @[]P) {\n"
					"  var x @[]RP = cast(@[]RP, a); _ = x\n"
					"  var y @[]RQ = cast(@[]RQ, b); _ = y\n}\n",
			uc, 2)
	if len(r) > 0 { return r }
	r = rejectsRetype("type C float64\n",
			"func f(a @[]readonly C) { var x @[]float64 = cast(@[]float64, a); _ = x }\n", uc, 1)
	if len(r) > 0 { return r }
	return rejectsRetype("",
			"func f(a [2]*func(*readonly int)) {\n"
					"  var x [2]*func(*int) = cast([2]*func(*int), a); _ = x\n}\n",
			uc, 1)
}
