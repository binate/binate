package "pkg/binate/check"

import "pkg/binate/bignum"
import "pkg/binate/constval"
import "pkg/binate/types"
import "pkg/std/vec"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"

// checkCastSafeSet gates `cast` to its SAFE set (spec §8.5).  A cast outside the
// set is a compile error naming the correct alternative (unsafe_cast / bit_cast /
// a type assertion / explicit construction).  The safe set is the union of:
//   (1) everything ASSIGNABLE (cast ⊇ assignability) — incl. interface WIDENING,
//       the single-named-side composite crossing, and the managed->raw borrow;
//   (2) numeric SCALAR conversions — int/float, and bool->numeric (a defined
//       widening), but NOT numeric->bool: an integer need not be a valid bool
//       (unsafe_cast asserts that it is), and a float has no representation in
//       common with bool (its conversion is `f != 0.0`);
//   (3) named <-> underlying for ANY type — two named types sharing one
//       underlying, or a named type and its underlying (a same-layout retype);
//   (4) aggregate leaf-wise retype — a slice/array element retyped to a same-size,
//       bit-preserving element (e.g. @[]int8 -> @[]uint8).
// Constant operands are fit-checked (conv.cast.const-not-laundered).
func checkCastSafeSet(c @Checker, pos token.Pos, argExpr @ast.Expr, src @types.Type,
		dst @types.Type) {
	if src == nil || dst == nil {
		return // a prior error produced the nil; don't pile on
	}
	// A cast involving an abstract type PARAMETER (a generic body: `cast(T, x)`)
	// cannot be checked at definition time — T could instantiate to a type for
	// which the cast is valid (e.g. `@any`, widening).  Defer to instantiation +
	// IR-gen (which fails loud on an outlawed shape reached via a type parameter).
	if isTypeParamType(src) || isTypeParamType(dst) {
		return
	}
	// A CONSTANT operand to an integer target must fit, and is not laundered
	// (conv.cast.const-not-laundered): recordConst reports it on the cast.
	if castSafeSetAllows(c, src, dst) {
		noteLiteralView(c, argExpr, src, dst)
		return
	}
	var ps @types.Type = types.StripWrappers(src)
	var pd @types.Type = types.StripWrappers(dst)
	if ps == nil || pd == nil {
		return
	}
	if ps.IsFloat() && pd.IsBool() {
		addCheckError(c, pos, floatToBoolMsg("cast"))
		return
	}
	if ps.IsScalar() && pd.IsScalar() {
		addCheckError(c, pos,
				"cast cannot convert a numeric value to bool (a value outside"
						" {0, 1} is not a valid bool); use unsafe_cast(bool, x)")
		return
	}
	// A REPL declaration may cast to an interface an impl not yet declared
	// would make its type implement (noteMissingImpl).
	if noteMissingImpl(c, pos, src, dst) {
		return
	}
	addCastRejectError(c, pos, src, dst, ps, pd)
}

// castSafeSetAllows reports whether `cast` accepts src -> dst (see
// checkCastSafeSet for the set).
func castSafeSetAllows(c @Checker, src @types.Type, dst @types.Type) bool {
	// (1) Everything assignable is a safe cast.
	if AssignableTo(src, c, dst) {
		return true
	}
	var ps @types.Type = types.StripWrappers(src)
	var pd @types.Type = types.StripWrappers(dst)
	if ps == nil || pd == nil {
		return false
	}
	// (2) Numeric scalar conversions: int<->int, int<->float, float<->float,
	// float->int, bool->numeric (defined), but not numeric->bool.
	if ps.IsScalar() && pd.IsScalar() {
		return !(pd.IsBool() && !ps.IsBool())
	}
	// (3) Named <-> underlying: a named type and its underlying, or two named types
	// sharing one underlying (§8.5, any type — a same-layout retype).  Both peel to
	// one base for a named->underlying chain; two distinct same-field named structs
	// need a structural field compare (Identical is nominal on named structs).
	// `Identical` is CONST-TRANSPARENT, so guard the readonly — a readonly DROP
	// (`*readonly int` -> `*int`) or an unsafe ADD below a shared handle
	// (`@[]*char` -> `@[]*readonly char`) is "identical modulo const" but is the
	// unverifiable unsafe_cast case, NOT a same-layout retype.  The peeled types are
	// compared, so a named type cannot launder readonly onto or off its underlying.
	// Two structs' fields are compared the same way.
	if ps.Identical(pd) && !dropsConst(ps, pd) && !addsReadonlyBelowHandle(ps, pd) {
		return true
	}
	if isSameFieldsStructPair(ps, pd) && !structFieldsDropReadonly(ps, pd) &&
			!structFieldsAddReadonly(ps, pd) {
		return true
	}
	// (4) Aggregate leaf-wise retype.
	return isAggregateLeafRetype(ps, pd)
}

// checkUnsafeCastSet gates a non-interface `unsafe_cast` to its set (spec §8.7
// conv.unsafe-cast): everything `cast` accepts, plus the unverifiable
// conversions the programmer asserts — dropping element-level readonly
// (`*readonly T -> *T`, `@[]readonly T -> @[]T`; a string literal adopted as a
// char slice or array and its readonly dropped), a raw pointer to a managed
// pointer (`*T -> @T`), the invariant-breaking scalar direction integer -> bool
// (`int8 -> bool`), and a container retyped over such an element conversion
// (`@[]int8 -> @[]bool`, `@[]readonly int8 -> @[]uint8`).  (Interface narrowing
// and widening are checked by the caller.)
// Anything else is a compile error: IR-gen has no lowering for it — the raw
// slice and function-value forms `*[]T -> @[]T` / `*func -> @func` in
// particular are under-determined constructions, not reinterpretations (§8.4).
func checkUnsafeCastSet(c @Checker, pos token.Pos, src @types.Type, dst @types.Type) {
	if src == nil || dst == nil {
		return // a prior error produced the nil; don't pile on
	}
	// As for cast: a conversion through an abstract type parameter is deferred
	// to instantiation.
	if isTypeParamType(src) || isTypeParamType(dst) {
		return
	}
	if castSafeSetAllows(c, src, dst) {
		return
	}
	var ps @types.Type = types.StripWrappers(src)
	var pd @types.Type = types.StripWrappers(dst)
	if ps == nil || pd == nil {
		return
	}
	// A readonly drop, or an add below a shared handle: the same type modulo
	// readonly (Identical is const-transparent), or two structs with the same
	// fields modulo readonly.
	if ps.Identical(pd) || isSameFieldsStructPair(ps, pd) {
		return
	}
	// A managed -> raw borrow that also drops element-level readonly (`@readonly T
	// -> *T`, `@[]readonly T -> *[]T`), or adds it unsafely: cast's borrow
	// composed with the readonly change above.
	if isBorrowDroppingReadonly(ps, pd) || isBorrowAddingReadonly(ps, pd) {
		return
	}
	// The invariant-breaking scalar direction, integer -> bool: an assertion that
	// the integer is 0 or 1.  Float -> bool is not one (floatToBoolMsg).
	if ps.IsInteger() && pd.IsBool() {
		return
	}
	// Raw pointer -> managed pointer to the same pointee (modulo readonly).
	if ps.Kind == types.TYP_POINTER && pd.Kind == types.TYP_MANAGED_PTR && ps.Elem != nil &&
			pd.Elem != nil && ps.Elem.Identical(pd.Elem) {
		return
	}
	// A container retype whose element conversion cast refuses only for being
	// unverifiable (§8.5 conv.cast.aggregate-retype sends it here).
	if isUnsafeAggregateLeafRetype(ps, pd) {
		return
	}
	// A string literal adopted as a char slice or array with element-level
	// readonly (a cast), its readonly then dropped.
	if isUntypedString(src) {
		var ro @types.Type = readonlyElemForm(pd)
		if ro != nil && AssignableTo(src, c, ro) {
			return
		}
	}
	addUnsafeCastRejectError(c, pos, ps, pd)
}

// readonlyElemForm returns the char-slice or char-array type t with its element
// made readonly (`*[]char` -> `*[]readonly char`), or nil for any other type.
func readonlyElemForm(t @types.Type) @types.Type {
	if t == nil || t.Elem == nil { return nil }
	// Peel only readonly: a distinct named element (`type MyC char`) keeps its
	// identity, so `*[]MyC` gets `*[]readonly MyC` — which a string literal is not
	// assignable to — rather than `*[]readonly uint8`.
	var e @types.Type = t.Elem
	for e != nil && e.Kind == types.TYP_READONLY { e = e.Elem }
	if e == nil { return nil }
	var ro @types.Type = types.MakeReadonlyType(e)
	if t.Kind == types.TYP_SLICE { return types.MakeSliceType(ro) }
	if t.Kind == types.TYP_MANAGED_SLICE { return types.MakeManagedSliceType(ro) }
	if t.Kind == types.TYP_ARRAY { return types.MakeArrayType(ro, t.ArrayLen) }
	return nil
}

// addUnsafeCastRejectError reports an unsafe_cast outside its set, naming the
// right alternative for the (peeled) shape.
func addUnsafeCastRejectError(c @Checker, pos token.Pos, ps @types.Type, pd @types.Type) {
	if ps.Kind == types.TYP_NIL {
		addCheckError(c, pos, nilConversionMsg("unsafe_cast"))
		return
	}
	if ps.IsFloat() && pd.IsBool() {
		addCheckError(c, pos, floatToBoolMsg("unsafe_cast"))
		return
	}
	if ps.Kind == types.TYP_SLICE && pd.Kind == types.TYP_MANAGED_SLICE {
		addCheckError(c, pos,
				"unsafe_cast cannot convert a raw slice to a managed-slice: a managed-slice"
						" carries words the raw slice lacks (§8.4); construct one (allocate + copy)")
		return
	}
	if ps.Kind == types.TYP_FUNC_VALUE && pd.Kind == types.TYP_MANAGED_FUNC_VALUE {
		addCheckError(c, pos,
				"unsafe_cast cannot convert a raw function value to a managed one: a managed"
						" function value owns what the raw one only borrows (§8.4); construct it"
						" from the function")
		return
	}
	if (isPointerKind(ps) && pd.IsInteger()) || (ps.IsInteger() && isPointerKind(pd)) {
		addCheckError(c, pos,
				"unsafe_cast cannot convert between a pointer and an integer; use bit_cast"
						" (a same-size reinterpret, §8.6)")
		return
	}
	addCheckError(c, pos,
			"unsafe_cast does not support this conversion; use bit_cast for a same-size"
					" reinterpret (§8.6) or construct the value explicitly")
}

// floatToBoolMsg is the error for a `cast` or `unsafe_cast` (op) of a float to
// bool.  Neither converts one: unsafe_cast asserts things about a representation,
// and a float has none in common with bool (`1.0` is not the byte 1), so the
// conversion is the comparison `f != 0.0`.
func floatToBoolMsg(op *[]readonly char) @[]char {
	return buf.Concat(op,
			" cannot convert a float to bool (a float shares no representation"
					" with bool); write x != 0.0")
}

// addCastRejectError reports a cast outside the safe set, naming the correct
// alternative for the (src, dst) shape.  ps / pd are the peeled forms.
func addCastRejectError(c @Checker, pos token.Pos, src @types.Type, dst @types.Type, ps @types.Type,
		pd @types.Type) {
	// Dropping element-level readonly is the unverifiable const_cast-like op — also
	// when it rides on a managed -> raw borrow or a struct's field.  Named only for
	// a conversion that changes nothing BUT readonly (unsafe_cast's territory); one
	// that also changes a type gets the message for that change, below.
	var onlyReadonly bool = ps.Identical(pd)
	if (onlyReadonly && dropsConst(ps, pd)) || isBorrowDroppingReadonly(ps, pd) ||
			structFieldsDropReadonly(ps, pd) {
		addCheckError(c, pos,
				"cast cannot drop element-level readonly (another handle may rely on"
						" the readonly view); use unsafe_cast (§8.7)")
		return
	}
	// Adding readonly below a shared handle leaves the source handle writing
	// through what this one may store as readonly (§8.3).
	if (onlyReadonly && addsReadonlyBelowHandle(ps, pd)) || isBorrowAddingReadonly(ps, pd) ||
			structFieldsAddReadonly(ps, pd) {
		addCheckError(c, pos,
				"cast cannot add readonly below a shared handle unless every level between"
						" is readonly too (the source handle would read as writable what this one"
						" stores as readonly); use unsafe_cast (§8.7)")
		return
	}
	if ps.Kind == types.TYP_NIL {
		addCheckError(c, pos, nilConversionMsg("cast"))
		return
	}
	// Raw pointer -> managed pointer invents a reference count.
	if ps.Kind == types.TYP_POINTER && pd.Kind == types.TYP_MANAGED_PTR {
		addCheckError(c, pos,
				"cast cannot convert a raw pointer to a managed pointer; use"
						" unsafe_cast(@T, p) (asserts a management header) or bit_cast")
		return
	}
	// An interface-value OPERAND is a narrowing (recover a concrete type).
	if isInterfaceValueType(ps) {
		addCheckError(c, pos,
				"cast cannot recover a concrete type from an interface value; use a"
						" type assertion `x.(T)` (checked) or unsafe_cast (unchecked)")
		return
	}
	// An interface-value TARGET that assignability rejected: the operand does not
	// satisfy the interface (or a raw pointer cannot widen to a managed interface).
	if isInterfaceValueType(pd) {
		addCheckError(c, pos,
				"cast cannot widen this operand to the target interface value (it does"
						" not satisfy the interface, or a raw `*T` cannot widen to a"
						" managed `@I` — box / convert to `@T` first)")
		return
	}
	// Pointer <-> integer is a same-size reinterpret.
	if (isPointerKind(ps) && pd.IsInteger()) || (ps.IsInteger() && isPointerKind(pd)) {
		addCheckError(c, pos,
				"cast cannot convert between a pointer and an integer; use bit_cast"
						" (a same-size reinterpret, §8.6)")
		return
	}
	// A container retype over an element conversion cast does not perform in
	// place but unsafe_cast does: a readonly drop or unguarded add, a partial
	// direction (`int8 -> bool`), a nested container.
	if isUnsafeAggregateLeafRetype(ps, pd) {
		addCheckError(c, pos,
				"cast does not retype this container over its element conversion (§8.5);"
						" use unsafe_cast (§8.7)")
		return
	}
	// Anything else (aggregate reinterpret, array -> managed-slice, ...).
	addCheckError(c, pos,
			"cast does not support this conversion; use bit_cast for a same-size"
					" reinterpret (§8.6), a type assertion `x.(T)`, or construct the"
					" value explicitly (allocate + copy)")
}

// nilConversionMsg is the rejection of a conversion builtin applied to nil
// where the target is not nillable: nil converts only to a pointer or a function
// value, or a named type over one — not to a slice, an interface value (which is
// left unset instead) or a value type (type.nil.literal).
func nilConversionMsg(builtin *[]readonly char) @[]char {
	return buf.Concat(builtin,
			" cannot convert nil to this type: nil converts only to a pointer or function"
					" value; a slice, an interface value or a value type is not nillable")
}

// isPointerKind reports whether t (already peeled) is a raw or managed pointer.
func isPointerKind(t @types.Type) bool {
	return t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR)
}

// isTypeParamType reports whether t is, or contains, an abstract generic type
// parameter — anywhere an instance's type could differ: an element, a field, a
// pointee, an interface, a function's parameter or result, a generic
// instantiation's type argument, an array's length (`[sizeof(T)]int8`).  A cast
// touching one cannot be gated until the type is instantiated (`cast(T, x)`,
// but also `cast(@[]T, x)`, `cast(@P[T], x)`, `cast(*func(T) int, f)`); it is
// checked on each instance instead (gen.mono.check).
func isTypeParamType(t @types.Type) bool {
	var visited @vec.Vec[@types.Type] = vec.New[@types.Type]()
	return containsTypeParam(t, visited)
}

// containsTypeParam is isTypeParamType's walk.  visited holds the named types
// and structs already reached.  One reached again — round a cycle (`type Node
// struct { next @Node }`, `type P *P`, `type Tree @[]Tree`), or by a second path,
// as a generic instantiation's type argument and its field of that type are —
// has been or is being walked, so it contributes nothing new; walking it again
// would recurse forever round a cycle, and take time exponential in the nesting
// of a type that reaches one type by two paths.
func containsTypeParam(t @types.Type, visited @vec.Vec[@types.Type]) bool {
	// Peel the wrappers as StripWrappers does, recording each named type.  A
	// generic instantiation's type arguments are looked at before its named
	// wrapper is peeled: a type parameter may appear there and in none of its
	// fields (`P[T]` with `type P[T any] struct { n int }`).
	var p @types.Type = t
	for p != nil {
		if p.Kind == types.TYP_ALIAS {
			p = p.Target
		} else if p.Kind == types.TYP_READONLY {
			p = p.Elem
		} else if p.Kind == types.TYP_NAMED && p.Underlying != nil {
			if !markVisited(visited, p) { return false }
			if instArgsContainTypeParam(p, visited) { return true }
			p = p.Underlying
		} else {
			break
		}
	}
	if p == nil {
		return false
	}
	// A generic interface's instantiation, or a named instantiation whose
	// underlying is not built yet, carries its type arguments here.
	if p.Kind == types.TYP_TYPE_PARAM || instArgsContainTypeParam(p, visited) {
		return true
	}
	if p.Kind == types.TYP_ARRAY && p.ArrayLenDependent {
		return true
	}
	// An interface value's interface (`@G[T]`) is its Elem, as a pointer's
	// pointee is.
	if p.Elem != nil &&
			(p.Kind == types.TYP_POINTER || p.Kind == types.TYP_MANAGED_PTR || p.Kind == types.TYP_SLICE ||
					p.Kind == types.TYP_MANAGED_SLICE || p.Kind == types.TYP_ARRAY ||
					p.Kind == types.TYP_INTERFACE_VALUE || p.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		return containsTypeParam(p.Elem, visited)
	}
	if p.Kind == types.TYP_STRUCT {
		if !markVisited(visited, p) { return false }
		for i := 0; i < len(p.Fields); i++ {
			if containsTypeParam(p.Fields[i].Type, visited) {
				return true
			}
		}
		return false
	}
	if p.Kind == types.TYP_FUNC || p.Kind == types.TYP_FUNC_VALUE ||
			p.Kind == types.TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(p.Params); i++ {
			if containsTypeParam(p.Params[i].Type, visited) {
				return true
			}
		}
		for i := 0; i < len(p.Results); i++ {
			if containsTypeParam(p.Results[i], visited) {
				return true
			}
		}
	}
	return false
}

// markVisited records t in visited and reports whether it was not there yet.
func markVisited(visited @vec.Vec[@types.Type], t @types.Type) bool {
	for i := 0; i < visited.Len(); i++ {
		if same(visited.Get(i), t) { return false }
	}
	visited.Push(t)
	return true
}

// instArgsContainTypeParam reports whether one of t's generic-instantiation type
// arguments contains a type parameter (containsTypeParam, under visited).
func instArgsContainTypeParam(t @types.Type, visited @vec.Vec[@types.Type]) bool {
	for i := 0; i < len(t.InstArgs); i++ {
		if containsTypeParam(t.InstArgs[i], visited) {
			return true
		}
	}
	return false
}

// checkUnsafeCastBoolConst rejects `unsafe_cast(bool, k)` of a constant k other
// than 0 or 1 (§8.7): unsafe_cast to bool asserts its operand is 0 or 1, and a
// bool whose byte is anything else is undefined to use (§21.6), so a constant
// that cannot satisfy the assertion is a compile-time error.  (`k != 0` is the
// defined integer-to-bool conversion.)
func checkUnsafeCastBoolConst(c @Checker, e @ast.Expr, typ @types.Type) {
	var pd @types.Type = types.StripWrappers(typ)
	if pd == nil || !pd.IsBool() || len(e.Args) != 1 { return }
	var v constval.Value
	var st int
	v, st = c.ConstValue(e.Args[0])
	if st != constval.OK || v.IsBool { return }
	if v.N.IsZero() || v.N.Equals(bignum.FromInt(1)) { return }
	addCheckError(c, e.Pos,
			"unsafe_cast to bool of a constant other than 0 or 1 (a bool holds only 0 or 1)")
}
