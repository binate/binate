package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Predicate tests for the cast safe-set gate helpers (check_cast_safe.bn).  The
// gate itself (checkCastSafeSet) is exercised end-to-end by the TestCheckCast*
// checker tests in check_builtin_test.bn (accept/reject per category).

func TestCastGateIsPointerKind() testing.TestResult {
	if !isPointerKind(types.MakePointerType(types.TypInt())) {
		return fail("*int should be a pointer kind")
	}
	if !isPointerKind(types.MakeManagedPtrType(types.TypInt())) {
		return fail("@int should be a pointer kind")
	}
	if isPointerKind(types.TypInt()) {
		return fail("int should not be a pointer kind")
	}
	return ""
}

// A cast to or from a recursive type — a struct that reaches itself through a
// pointer field, a named type whose underlying names it through a pointer or
// slice — is checked without walking the type forever: the type-parameter scan
// stops at a struct or named type it is already inside, and an unsafe_cast
// between two distinct recursive slice types is a retype all the way down.
func TestCheckCastRecursiveTypeTerminates() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Node struct { v int; next @Node; kids @[]@Node }\n"
							"type Ring struct { prev *Ring; next *Ring }\n"
							"type P *P\ntype Tree @[]Tree\ntype Tree2 @[]Tree2\n"
							"func f(n @Node, r *Ring) @Node {\n"
							"  var q *Ring = cast(*Ring, r); _ = q; return cast(@Node, n)\n"
							"}\n"
							"func g(p *P, t @[]Tree, t2 Tree2) {\n"
							"  var x P = cast(P, p); _ = x\n"
							"  var y Tree = cast(Tree, t); _ = y\n"
							"  var z Tree = unsafe_cast(Tree, t2); _ = z\n"
							"  var w @[]Tree2 = unsafe_cast(@[]Tree2, y); _ = w\n"
							"}\n"))
}

// A cast whose type involves a type parameter only indirectly — a generic
// instantiation's type argument (a struct's, nested, or an interface's), a
// function value's parameter, an array's length — is deferred to the instance,
// not checked at the definition; so are unsafe_cast's interface forms.
func TestCheckCastGenericInstArgDeferred() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type P[T any] struct { n int }\n"
							"interface G[T any] { Get() int }\n"
							"func g[T any](x @P[int]) @P[T] { return cast(@P[T], x) }\n"
							"func g2[T any](x @P[@[]int]) @P[@[]T] { return cast(@P[@[]T], x) }\n"
							"func h[T any](x @G[T]) @G[int] { return cast(@G[int], x) }\n"
							"func u[T any](x @P[int]) @P[T] { return unsafe_cast(@P[T], x) }\n"
							"type V struct { n int }\nfunc (v @V) Get() int { return v.n }\n"
							"impl @V : G[int]\n"
							"func hu[T any](x @G[T]) @G[int] { return unsafe_cast(@G[int], x) }\n"
							"func hr[T any](y @G[int]) @G[T] { return unsafe_cast(@G[T], y) }\n"
							"func w[T any](v @V) @G[T] { return unsafe_cast(@G[T], v) }\n"
							"func fv[T any](f *func(int) int) *func(T) int { return cast(*func(T) int, f) }\n"
							"func sz[T any](x [8]uint8) {\n"
							"  var y [sizeof(T)]int8 = cast([sizeof(T)]int8, x); _ = y\n}\n"))
}

// bit_cast of the untyped nil is rejected whatever the target — also in a
// generic body, ahead of the type-parameter deferral — and a cast or unsafe_cast
// of nil to a type nil does not convert to names nil; cast(T, nil) to a pointer
// is accepted.
func TestCheckCastBitCastNil() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Node struct { v int }\ninterface I { f() int }\n"
					"func g[T any]() T { return bit_cast(T, nil) }\n"
					"func f() {\n"
					"  var p *int = bit_cast(*int, nil); _ = p\n"
					"  var n int = bit_cast(int, nil); _ = n\n"
					"  var m @Node = bit_cast(@Node, nil); _ = m\n"
					"  var fv *func() int = bit_cast(*func() int, nil); _ = fv\n"
					"  var i @I = cast(@I, nil); _ = i\n"
					"  var s @[]int = cast(@[]int, nil); _ = s\n"
					"  var k int = cast(int, nil); _ = k\n"
					"  var ui @I = unsafe_cast(@I, nil); _ = ui\n"
					"  var un int = unsafe_cast(int, nil); _ = un\n"
					"  var q *int = cast(*int, nil); _ = q\n"
					"}\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 10 {
		return fail(buf.Concat("expected 10 errors, got ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < 5; i++ {
		if !charsHaveSub(errs[i].Msg, "bit_cast cannot reinterpret nil") { return fail(errs[i].Msg) }
	}
	for i := 5; i < 8; i++ {
		if !charsHaveSub(errs[i].Msg, "cast cannot convert nil to this type") { return fail(errs[i].Msg) }
	}
	for i := 8; i < 10; i++ {
		if !charsHaveSub(errs[i].Msg, "unsafe_cast cannot convert nil to this type") {
			return fail(errs[i].Msg)
		}
	}
	return ""
}
