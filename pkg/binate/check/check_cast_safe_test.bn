package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Predicate tests for the cast safe-set gate helpers (check_cast_safe.bn).  The
// gate itself (checkCastSafeSet) is exercised end-to-end by the TestCheckCast*
// checker tests in check_builtin_test.bn (accept/reject per category).

func TestCastGateIsPointerKind() testing.TestResult {
	if !isPointerKind(types.MakePointerType(types.TypInt())) {
		return fail("*int should be a pointer kind")
	}
	if !isPointerKind(types.MakeManagedPtrType(types.TypInt())) {
		return fail("@int should be a pointer kind")
	}
	if isPointerKind(types.TypInt()) {
		return fail("int should not be a pointer kind")
	}
	return ""
}

// A cast to or from a recursive type — a struct that reaches itself through a
// pointer field, a named type whose underlying names it through a pointer or
// slice — is checked without walking the type forever: the type-parameter scan
// stops at a struct or named type it is already inside, and an unsafe_cast
// between two distinct recursive slice types is a retype all the way down.
func TestCheckCastRecursiveTypeTerminates() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Node struct { v int; next @Node; kids @[]@Node }\n"
							"type Ring struct { prev *Ring; next *Ring }\n"
							"type P *P\ntype Tree @[]Tree\ntype Tree2 @[]Tree2\n"
							"func f(n @Node, r *Ring) @Node {\n"
							"  var q *Ring = cast(*Ring, r); _ = q; return cast(@Node, n)\n"
							"}\n"
							"func g(p *P, t @[]Tree, t2 Tree2) {\n"
							"  var x P = cast(P, p); _ = x\n"
							"  var y Tree = cast(Tree, t); _ = y\n"
							"  var z Tree = unsafe_cast(Tree, t2); _ = z\n"
							"  var w @[]Tree2 = unsafe_cast(@[]Tree2, y); _ = w\n"
							"}\n"))
}
