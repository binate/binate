package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/constval"
import "pkg/binate/token"

// Constant-declaration checking: forward-registration placeholder typing,
// single- and grouped-const type checking (including iota), and the
// untyped-int literal-value carrier.  The collection/driver passes and
// the var/type decl kinds live in check_decl.bn; function- and
// method-decl checking lives in check_decl_func.bn.

// untypedConstPlaceholder returns the pass-1 forward-registration type
// for an untyped single const (`const X = <lit>`), inferred from the
// initializer's literal kind so a reference checked before the const
// resolves.  A non-literal initializer (`const X = Y`) gets a
// conservative untyped-int placeholder — checkExpr-ing the value during
// collection would emit a spurious `undefined` for a reference-valued
// const.  checkConstDecl attaches the real type + value in pass 2.
func untypedConstPlaceholder(e @ast.Expr) @types.Type {
	if e == nil { return types.TypUntypedInt() }
	if e.Kind == ast.EXPR_INT_LIT {
		// Carry the literal value on the placeholder so an expression
		// like `N + 1` (forward ref) folds to N+1, not 1: without
		// HasLitVal, foldIntArith falls to commonType, which inherits the
		// LitVal of the OTHER operand (the literal) — the same trap the
		// bare iota-group member placeholder sidesteps via
		// makeUntypedIntWithLit.
		return makeUntypedIntWithLit(parseIntLiteral(e.Name))
	}
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypUntypedFloat() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypUntypedBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	return types.TypUntypedInt()
}

// checkConstDecl type-checks a constant declaration and defines its symbol
// with the initializer's value (recordConst).  A bare member of a const group
// with no preceding initializer takes the iota value.  A const-group member
// checked outside its group is checked at its own iota (c.IotaDecls).
func checkConstDecl(c @Checker, d @ast.Decl) {
	for i := 0; i < len(c.IotaDecls); i++ {
		if same(c.IotaDecls[i], d) {
			var savedIota int = c.Iota
			c.Iota = c.Iotas[i]
			checkConstDeclAtIota(c, d)
			c.Iota = savedIota
			return
		}
	}
	checkConstDeclAtIota(c, d)
}

// checkConstDeclAtIota is checkConstDecl at the current c.Iota.
func checkConstDeclAtIota(c @Checker, d @ast.Decl) {
	if d.Value == nil {
		if c.Iota >= 0 {
			var iv constval.Value
			iv.N = bignum.FromInt(c.Iota)
			if d.TypeRef != nil {
				var typ @types.Type = resolveTypeExpr(c, d.TypeRef)
				if typ != nil && typ.IsInteger() {
					iv.Typ = typ
					defineConstValue(c.Scope, d.Name, typ, iv, constval.OK)
					recordDeclConst(c, d, iv, constval.OK)
				} else {
					defineConst(c.Scope, d.Name, typ)
					recordDeclConst(c, d, iv, constval.NOT_CONST)
				}
			} else {
				defineConstValue(c.Scope, d.Name, makeUntypedIntWithLit(c.Iota), iv, constval.OK)
				recordDeclConst(c, d, iv, constval.OK)
			}
			return
		}
		// Not an iota-group member: a const must carry a value (there
		// is no value-less / extern const — group inheritance counts).
		errConstMissingValue(c, d.Pos, d.Name)
		return
	}
	var valType @types.Type = checkExpr(c, d.Value)
	var v constval.Value
	var st int
	v, st = constOf(c, d.Value)
	defineCheckedConst(c, d, valType, v, st, d)
}

// defineCheckedConst defines the constant d, whose initializer has type
// valType and value v with status st, checking the initializer against d's
// declared type.  A typed constant takes its declared type (an untyped value
// must fit it); an untyped one keeps the untyped type carrying its value.
// The value is recorded for IR-gen on decl (recordDeclConst) — d itself, or,
// for a bare group member checked through a synthesized d, the member — and,
// when decl is d, on d's initializer too (attachConstLitVal), which a bare
// member re-using another member's initializer does not own.  A bare member's
// errors are reported at the member, not at the initializer it shares.
func defineCheckedConst(c @Checker, d @ast.Decl, valType @types.Type, v constval.Value, st int,
		decl @ast.Decl) {
	var errPos token.Pos = d.Value.Pos
	if decl != d {
		errPos = decl.Pos
	}
	// The initializer must be constant (decl.const).  A bare group member
	// repeats its explicit member's initializer, checked there.
	if decl == d && !checkConstInitConstant(c, d.Name, d.Value, nil) {
		st = constval.POISONED
	}
	var declType @types.Type = nil
	if d.TypeRef != nil {
		declType = resolveTypeExpr(c, d.TypeRef)
		if !AssignableTo(valType, c, declType) {
			errCannotAssign(c, errPos, valType, declType)
			if st == constval.OK {
				st = constval.POISONED
			}
		}
		// const is scalar-only: a non-scalar immutable value is a
		// `var X readonly T = ...`, not a const.  Still define it
		// (with declType) so downstream references don't cascade.
		if !declType.IsScalar() {
			errNonScalarConst(c, errPos, d.Name, declType)
		} else {
			// A constant is a value of its type, so a scalar type opaque to
			// this package (another package's opaque export, directly or
			// under a named type) is rejected as for a value-typed variable.
			// A scalar type is fully resolved, even this early.
			requireSizedType(c, declType, errPos)
		}
	} else if !valType.IsScalar() {
		errNonScalarConst(c, errPos, d.Name, valType)
	}
	var symType @types.Type = declType
	if symType == nil {
		symType = valType
	}
	if st == constval.OK && declType != nil {
		if v.IsBool {
			v.Typ = declType
		} else if !declType.IsInteger() || (v.Typ == nil && !constval.Fits(v.N, declType)) {
			st = constval.POISONED
		} else {
			v.Typ = declType
		}
	}
	defineConstValue(c.Scope, d.Name, symType, v, st)
	recordDeclConst(c, decl, v, st)
	if decl == d && st == constval.OK {
		if v.IsBool {
			attachConstBoolVal(c, d.Value, v.B)
		} else {
			attachConstLitVal(c, d.Value, v)
		}
	}
}

// attachConstLitVal records the integer constant v as a HasLitVal carrier on
// e's registered ExprType, so IR-gen's genConst reads the value the checker
// computed — scope-free, via Checker.ExprType — rather than folding the
// initializer again.  Each expr has a unique ExprType id (registerExprType
// never dedups), so overwriting the entry only affects this initializer.
func attachConstLitVal(c @Checker, e @ast.Expr, v constval.Value) {
	if e == nil || e.ResolvedTypeID <= 0 || e.ResolvedTypeID >= c.NumExprTypes {
		return
	}
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.HasLitVal = true
	t.IsConstStamp = true
	t.LitMag = v.N.Magnitude
	t.LitSign = v.N.Sign
	t.ConstType = v.Typ
	c.ExprTypes[e.ResolvedTypeID] = t
}

// attachConstBoolVal records the folded boolean value v as a HasBoolVal carrier
// on e's registered ExprType — the bool analogue of attachConstLitVal.
func attachConstBoolVal(c @Checker, e @ast.Expr, v bool) {
	if e == nil || e.ResolvedTypeID <= 0 || e.ResolvedTypeID >= c.NumExprTypes {
		return
	}
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_BOOL
	t.Name = types.TypBool().Name
	t.HasBoolVal = true
	t.BoolVal = v
	t.IsConstStamp = true
	c.ExprTypes[e.ResolvedTypeID] = t
}

// makeUntypedIntWithLit returns a fresh TYP_UNTYPED_INT Type
// carrying `v` as HasLitVal / LitMag / LitSign, so fold paths
// (foldIntArith / foldIntBitwise) can compute correct results when
// this const is referenced as a binop operand.
func makeUntypedIntWithLit(v int) @types.Type {
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.HasLitVal = true
	if v < 0 {
		t.LitSign = true
		t.LitMag = cast(uint64, 0) - cast(uint64, v)
	} else {
		t.LitSign = false
		t.LitMag = cast(uint64, v)
	}
	return t
}

// checkGroupDecl type-checks a grouped declaration block.  A const group's
// members are checked in order, except those already resolved before pass 2
// (finishTopLevelConsts, batchConstOnDemand).
func checkGroupDecl(c @Checker, d @ast.Decl) {
	if !isConstGroup(d) {
		checkDecls(c, d.Decls)
		return
	}
	for i := 0; i < len(d.Decls); i++ {
		var inner @ast.Decl = d.Decls[i]
		if inner.Kind != ast.DECL_CONST {
			var singleDecl @[]@ast.Decl = make_slice(@ast.Decl, 1)
			singleDecl[0] = inner
			checkDecls(c, singleDecl)
		} else if c.ReplDeclMode || !constMemberResolved(c, inner) {
			checkConstGroupMember(c, d, i)
		}
	}
}

// checkConstGroupMember checks member k of the const group g at its iota.  A
// bare member repeats the previous explicit member's type and initializer
// (spec §9.1 decl.const), so it is range-checked at that type: `const ( B0
// uint8 = 1<<iota; …; B8 )` rejects B8 (=256) like the explicit `const B8
// uint8 = 256` does.  An explicit member without a type is untyped, and so are
// the bare members that repeat it.  A bare member with no explicit member
// before it is iota itself.  The explicit member must be checked first (the
// bare member reads its initializer's checked type).
func checkConstGroupMember(c @Checker, g @ast.Decl, k int) {
	var member @ast.Decl = g.Decls[k]
	var savedIota int = c.Iota
	c.Iota = constGroupIota(g, k)
	var e int = constGroupExplicit(g, k)
	if e == k || e < 0 {
		checkConstDecl(c, member)
	} else {
		var ex @ast.Decl = g.Decls[e]
		var rep @ast.Decl = make(ast.Decl)
		rep.Kind = ast.DECL_CONST
		rep.Name = member.Name
		rep.Value = ex.Value
		rep.TypeRef = ex.TypeRef
		rep.Pos = member.Pos
		checkBareGroupMember(c, rep, member, constGroupIota(g, e))
	}
	c.Iota = savedIota
}

// isConstGroup reports whether the grouped declaration d declares consts.
func isConstGroup(d @ast.Decl) bool {
	for i := 0; i < len(d.Decls); i++ {
		if d.Decls[i].Kind == ast.DECL_CONST {
			return true
		}
	}
	return false
}

// constGroupIota returns the iota of member k of the const group g: the number
// of const members before it.
func constGroupIota(g @ast.Decl, k int) int {
	var n int = 0
	for i := 0; i < k; i++ {
		if g.Decls[i].Kind == ast.DECL_CONST {
			n++
		}
	}
	return n
}

// constGroupExplicit returns the index of the const group g's last member at
// or before k with an initializer — the one member k has or repeats — or -1.
func constGroupExplicit(g @ast.Decl, k int) int {
	for i := k; i >= 0; i-- {
		if g.Decls[i].Kind == ast.DECL_CONST && g.Decls[i].Value != nil {
			return i
		}
	}
	return -1
}

// bareMemberOwnError reports whether evaluation error st, at node at, of a bare
// const-group member repeating initializer e is the member's own — not the
// error the explicit member's evaluation of e (at explicitIota) has: the same
// failure at the same node, which does not depend on iota and is reported for
// the explicit member.
func bareMemberOwnError(c @Checker, e @ast.Expr, explicitIota int, st int, at @ast.Expr) bool {
	var savedIota int = c.Iota
	c.Iota = explicitIota
	var ev constval.Value
	var est int
	var eat @ast.Expr
	ev, est, eat = evalConst(c, e)
	c.Iota = savedIota
	_ = ev
	return est != st || eat != at
}

// checkBareGroupMember defines a bare const-group member, which repeats the
// previous member's initializer (rep.Value) at the current iota: the
// initializer is evaluated again, not checked again, so the explicit member
// keeps its own recorded value and stamp.  An evaluation error is reported at
// the bare member.
func checkBareGroupMember(c @Checker, rep @ast.Decl, member @ast.Decl, explicitIota int) {
	var v constval.Value
	var st int
	var at @ast.Expr
	v, st, at = evalConst(c, rep.Value)
	if isConstErr(st) {
		if bareMemberOwnError(c, rep.Value, explicitIota, st, at) {
			reportConstErr(c, rep.Pos, st)
		}
		st = constval.POISONED
	}
	if st != constval.OK && st != constval.NOT_CONST {
		// POISONED (reported) or DEPENDENT: define the value-less member at its
		// declared type without checking the initializer against it again.
		var t @types.Type = nil
		if rep.TypeRef != nil {
			t = resolveTypeExpr(c, rep.TypeRef)
		}
		if t == nil {
			t = types.TypUntypedInt()
		}
		defineConstValue(c.Scope, rep.Name, t, v, st)
		recordDeclConst(c, member, v, st)
		return
	}
	var valType @types.Type = c.ExprType(rep.Value.ResolvedTypeID)
	if st == constval.OK {
		if v.IsBool {
			valType = types.TypUntypedBool()
			if v.Typ != nil {
				valType = v.Typ
			}
		} else if v.Typ == nil {
			valType = untypedIntOfNum(v.N)
		} else {
			valType = v.Typ
		}
	}
	defineCheckedConst(c, rep, valType, v, st, member)
}
