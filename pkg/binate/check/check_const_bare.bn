package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/token"

// Bare const-group members: a member without an initializer repeats the previous
// explicit member's initializer at its own iota (spec §9.1 decl.const).  The
// explicit member's nodes record what its check found at its iota — types, values,
// the length stamped on an array type expression (TypeExpr.LenVal), the index on a
// keyed element (Element.KeyVal) — so a bare member that would find something else
// at its iota is evaluated on its own checked copy (RepeatedInit), never on the
// explicit member's nodes.

// bareMemberOwnError reports whether evaluation error st, at node at, of a bare
// const-group member repeating initializer e is the member's own — not the
// error the explicit member's evaluation of e (at explicitIota) has: the same
// failure at the same node, which does not depend on iota and is reported for
// the explicit member.  at is a node of e.
func bareMemberOwnError(c @Checker, e @ast.Expr, explicitIota int, st int, at @ast.Expr) bool {
	var savedIota int = c.Iota
	c.Iota = explicitIota
	var ev constval.Value
	var est int
	var eat @ast.Expr
	ev, est, eat = evalConst(c, e)
	c.Iota = savedIota
	_ = ev
	return est != st || eat != at
}

// checkBareGroupMember defines a bare const-group member, which repeats the
// previous member's initializer (rep.Value) at the current iota: the
// initializer is evaluated again, not checked again, so the explicit member
// keeps its own recorded value and stamp.  An evaluation error is reported at
// the bare member.  The member gets its own copy of the initializer, checked at
// this iota and recorded for it (RepeatedInit), when its values there differ from
// what the explicit member's nodes record: when iota shapes a type in it
// (iotaShapesType) — the copy is checked first and is what is evaluated; and when
// the value is not an integer constant (NOT_CONST: a float) and mentions iota —
// IR-gen re-lowers its expression, and the values its nodes take depend on the
// iota.  The copy is checked before the member's name is defined, as the explicit
// member's initializer is; and its errors are the member's own (claimErrors) — the
// evaluation stops at the first operand that is not an integer constant, so an
// error past it shows only there.
func checkBareGroupMember(c @Checker, rep @ast.Decl, member @ast.Decl, explicitIota int) {
	var init @ast.Expr = rep.Value
	var own @ast.Expr = nil
	var v constval.Value
	var st int
	var at @ast.Expr
	if iotaShapesType(rep.Value) {
		var m errorMark = markErrors(c)
		own = ast.CloneExpr(rep.Value)
		_ = checkExpr(c, own)
		v, st, at = evalConst(c, own)
		claimErrors(c, m, own, rep.Pos)
		init = own
	} else {
		v, st, at = evalConst(c, init)
	}
	if isConstErr(st) {
		if bareMemberOwnError(c, rep.Value, explicitIota, st, counterpart(rep.Value, init, at)) {
			reportConstErr(c, rep.Pos, st)
		}
		st = constval.POISONED
	}
	if st != constval.OK && st != constval.NOT_CONST {
		// POISONED (reported) or DEPENDENT: define the value-less member at its
		// declared type without checking the initializer against it again.
		var t @types.Type = nil
		if rep.TypeRef != nil {
			t = resolveTypeExpr(c, rep.TypeRef)
		}
		if t == nil {
			t = types.TypUntypedInt()
		}
		defineConstValue(c.Scope, rep.Name, t, v, st)
		recordDeclConst(c, member, v, st)
		return
	}
	if own == nil && st == constval.NOT_CONST && mentionsIota(rep.Value) {
		var m errorMark = markErrors(c)
		own = ast.CloneExpr(rep.Value)
		_ = checkExpr(c, own)
		claimErrors(c, m, own, rep.Pos)
	}
	var valType @types.Type = c.ExprType(init.ResolvedTypeID)
	if st == constval.OK {
		if v.IsBool {
			valType = types.TypUntypedBool()
			if v.Typ != nil {
				valType = v.Typ
			}
		} else if v.Typ == nil {
			valType = untypedIntOfNum(v.N)
		} else {
			valType = v.Typ
		}
	}
	defineCheckedConst(c, rep, valType, v, st, member)
	if own != nil { recordRepeatedInit(c, member, own) }
}

// counterpart returns the node of e that is n's counterpart in cp, a copy of e
// (ast.CloneExpr), among the operands the constant evaluator visits; n itself
// when cp is e, and nil when n is not in cp.
func counterpart(e @ast.Expr, cp @ast.Expr, n @ast.Expr) @ast.Expr {
	if e == nil || cp == nil { return nil }
	if same(cp, n) { return e }
	var r @ast.Expr = counterpart(e.X, cp.X, n)
	if r == nil { r = counterpart(e.Y, cp.Y, n) }
	for i := 0; r == nil && i < len(e.Args) && i < len(cp.Args); i++ {
		r = counterpart(e.Args[i], cp.Args[i], n)
	}
	return r
}

// errorMark records how many errors, tentative errors and missing names the
// checker holds, for claimErrors.
type errorMark struct {
	nErr  int
	nTent int
	nMiss int
}

// markErrors returns the checker's current errorMark.
func markErrors(c @Checker) errorMark {
	var m errorMark
	m.nErr = len(c.Errors)
	m.nTent = len(c.TentativeErrors)
	m.nMiss = len(c.TentativeMissing)
	return m
}

// claimErrors makes the errors reported since m at a node of cp — a bare member's
// copy of its initializer, which keeps the source positions of the explicit
// member's — the bare member's own, reported at its position pos.  An error the
// explicit member reported already (the same message at the same node) is dropped,
// and so is the same error reported again; one reported elsewhere (in a declaration
// checked on the way) stays where it is.  A name found missing since m was found
// missing for the explicit member too.
func claimErrors(c @Checker, m errorMark, cp @ast.Expr, pos token.Pos) {
	c.TentativeMissing = c.TentativeMissing[:m.nMiss]
	c.Errors = claimedErrors(c.Errors, c.DedupFrom, m.nErr, cp, pos)
	c.TentativeErrors = claimedErrors(c.TentativeErrors, 0, m.nTent, cp, pos)
}

// claimedErrors returns errs with its entries from start on claimed for a bare
// member (claimErrors), compared for duplicates from index from.
func claimedErrors(errs @[]types.CheckError, from int, start int, cp @ast.Expr,
		pos token.Pos) @[]types.CheckError {
	var out @[]types.CheckError = errs[:start]
	for i := start; i < len(errs); i++ {
		var e types.CheckError = errs[i]
		if hasCheckError(out, from, e) { continue }
		if exprHasNodeAt(cp, e.Pos) { e.Pos = pos }
		out = appendUniqueCheckError(out, from, e)
	}
	return out
}

// hasCheckError reports whether errs[from:] holds an error equal to e.
func hasCheckError(errs *[]types.CheckError, from int, e types.CheckError) bool {
	for i := from; i < len(errs); i++ {
		if checkErrorsEqual(errs[i], e) { return true }
	}
	return false
}

// exprHasNodeAt reports whether a node of expression e — a subexpression, or a type
// expression in it — is at position p.
func exprHasNodeAt(e @ast.Expr, p token.Pos) bool {
	if e == nil { return false }
	if samePos(e.Pos, p) { return true }
	if exprHasNodeAt(e.X, p) || exprHasNodeAt(e.Y, p) || exprHasNodeAt(e.Z, p) { return true }
	for i := 0; i < len(e.Args); i++ {
		if exprHasNodeAt(e.Args[i], p) { return true }
	}
	for i := 0; i < len(e.Elems); i++ {
		if exprHasNodeAt(e.Elems[i].Key, p) || exprHasNodeAt(e.Elems[i].Value, p) { return true }
	}
	return typeHasNodeAt(e.TypeRef, p)
}

// typeHasNodeAt reports whether a node of type expression t is at position p.
func typeHasNodeAt(t @ast.TypeExpr, p token.Pos) bool {
	if t == nil { return false }
	if samePos(t.Pos, p) || exprHasNodeAt(t.Len, p) || typeHasNodeAt(t.Base, p) { return true }
	for i := 0; i < len(t.Fields); i++ {
		if samePos(t.Fields[i].Pos, p) || typeHasNodeAt(t.Fields[i].Type, p) { return true }
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		if typeHasNodeAt(t.ParamTypes[i], p) { return true }
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		if typeHasNodeAt(t.ResultTypes[i], p) { return true }
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		if typeHasNodeAt(t.TypeArgs[i], p) { return true }
	}
	return false
}

// samePos reports whether positions a and b are the same.
func samePos(a token.Pos, b token.Pos) bool {
	return a.Line == b.Line && a.Col == b.Col && types.CharEq(a.File, b.File)
}

// mentionsIota reports whether the identifier iota occurs in expression e,
// including in a type expression in it (an array length).
func mentionsIota(e @ast.Expr) bool {
	return iotaIn(e, false)
}

// iotaShapesType reports whether iota occurs in expression e where it shapes a
// type, which the checker records on the nodes: in a type expression (an array
// length, `sizeof([iota + 1]T)`) or in a composite literal (its type, or an
// element, which an inferred length or an index depends on — `[...]T{iota: v}`).
func iotaShapesType(e @ast.Expr) bool {
	return iotaIn(e, true)
}

// iotaIn reports whether iota occurs in e: anywhere, or only (shaping) where it
// shapes a type.
func iotaIn(e @ast.Expr, shaping bool) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return !shaping && types.CharEq(e.Name, "iota") }
	if iotaIn(e.X, shaping) || iotaIn(e.Y, shaping) || iotaIn(e.Z, shaping) { return true }
	for i := 0; i < len(e.Args); i++ {
		if iotaIn(e.Args[i], shaping) { return true }
	}
	for i := 0; i < len(e.Elems); i++ {
		if mentionsIota(e.Elems[i].Key) || mentionsIota(e.Elems[i].Value) { return true }
	}
	return typeMentionsIota(e.TypeRef)
}

// typeMentionsIota reports whether iota occurs in type expression t.
func typeMentionsIota(t @ast.TypeExpr) bool {
	if t == nil { return false }
	if mentionsIota(t.Len) || typeMentionsIota(t.Base) { return true }
	for i := 0; i < len(t.Fields); i++ {
		if typeMentionsIota(t.Fields[i].Type) { return true }
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		if typeMentionsIota(t.ParamTypes[i]) { return true }
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		if typeMentionsIota(t.ResultTypes[i]) { return true }
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		if typeMentionsIota(t.TypeArgs[i]) { return true }
	}
	return false
}
