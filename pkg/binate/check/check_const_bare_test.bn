package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_const_bare.bn: a bare const-group member's own checked copy of
// its initializer (RepeatedInit), and where its errors are reported.

// checkBareSrc type-checks the file src.
func checkBareSrc(src *[]readonly char) (@Checker, @ast.File) {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	return c, file
}

// onlyErrorAt returns "" when errs is one error, msg at line, and a failure otherwise.
func onlyErrorAt(errs *[]types.CheckError, line int, msg *[]readonly char) testing.TestResult {
	if len(errs) != 1 { return fail("exactly one error") }
	if errs[0].Pos.Line != line { return fail("the error is on the expected line") }
	if !types.CharEq(errs[0].Msg, msg) { return fail("the error has the expected message") }
	return ""
}

// Each bare member of a const group whose initializer mentions iota has its own copy
// of that initializer, checked at its iota (RepeatedInit) — the explicit member keeps
// its original, checked at its own; an initializer without iota is shared, no copy.
func TestRepeatedInitPerMember() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const (\n\tA float64 = cast(float64, iota - 5)\n\tB\n\tC\n)\n"
			"const (\n\tP = 2\n\tQ\n)\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 { return fail("the groups check cleanly") }
	var g @ast.Decl = file.Decls[0]
	var a @ast.Decl = g.Decls[0]
	if c.RepeatedInit(a) != nil { return fail("an explicit member has no copy") }
	var want @[]int = @[]int{-5, -4, -3}
	for k := 0; k < 3; k++ {
		var init @ast.Expr = a.Value
		if k > 0 {
			init = c.RepeatedInit(g.Decls[k])
			if init == nil || init == a.Value { return fail("a bare member has its own copy") }
		}
		var diff @types.Type = c.ExprType(init.Args[0].ResolvedTypeID)
		if diff == nil || !diff.HasLitVal { return fail("the copy is checked") }
		var mag int = cast(int, diff.LitMag)
		if diff.LitSign { mag = 0 - mag }
		if mag != want[k] { return fail("each member's iota - 5 is its own value") }
	}
	if c.RepeatedInit(file.Decls[1].Decls[1]) != nil {
		return fail("an initializer without iota is not copied")
	}
	return ""
}

// A bare member whose initializer has iota in a type expression is evaluated on
// its own copy, checked at its iota: each member's array type has its own length,
// the explicit member's stays its own, and `len` of an array literal is each
// member's.
func TestRepeatedInitIotaInType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const (\n\tA float64 = cast(float64, sizeof([iota + 1]int8))\n\tB\n\tC\n)\n"
			"const (\n\tL int = len([iota + 2]int8{})\n\tM\n)\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 { return fail("the groups check cleanly") }
	var g @ast.Decl = file.Decls[0]
	var a @ast.Decl = g.Decls[0]
	for k := 0; k < 3; k++ {
		var init @ast.Expr = a.Value
		if k > 0 {
			init = c.RepeatedInit(g.Decls[k])
			if init == nil || init == a.Value { return fail("a bare member has its own copy") }
		}
		var te @ast.TypeExpr = init.Args[0].TypeRef
		if !te.LenKnown || te.LenVal != k + 1 { return fail("each member's array length is its own") }
	}
	var lg @ast.Decl = file.Decls[1]
	for k := 0; k < 2; k++ {
		var v constval.Value
		var st int
		var have bool
		v, st, have = c.DeclConst(lg.Decls[k])
		if !have || st != constval.OK || v.N.ToInt() != k + 2 {
			return fail("each member's len is its own")
		}
	}
	return ""
}

// A bare member whose initializer has iota in a composite literal's element is
// evaluated on its own copy: `len` of `[...]int8{iota: 1}` is each member's, and the
// explicit member's element keeps its own index.
func TestRepeatedInitIotaInLiteralElement() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(
			"package \"test\"\nconst (\n\tK0 int = len([...]int8{iota: 1})\n\tK1\n\tK2\n)\n")
	if len(c.CheckerErrors()) != 0 { return fail("the group checks cleanly") }
	var g @ast.Decl = file.Decls[0]
	for k := 0; k < 3; k++ {
		var v constval.Value
		var st int
		var have bool
		v, st, have = c.DeclConst(g.Decls[k])
		if !have || st != constval.OK || v.N.ToInt() != k + 1 {
			return fail("each member's len is its own")
		}
	}
	var el @ast.Element = g.Decls[0].Value.Args[0].Elems[0]
	if !el.KeyKnown || el.KeyVal != 0 { return fail("the explicit member's index stays its own") }
	return ""
}

// A type that is invalid only at a bare member's iota is an error at the member,
// reported once — not also in the explicit member's initializer, and once for two
// such types.
func TestBareMemberTypeErrorAtMember() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(
			"package \"test\"\nconst (\n\tA = sizeof([2 - iota]int8)\n\tB\n\tC\n\tD\n)\n")
	var r testing.TestResult = onlyErrorAt(c.CheckerErrors(), 6, "array length must be non-negative")
	if len(r) != 0 { return r }
	c, file = checkBareSrc(
			"package \"test\"\nconst (\n\tA = sizeof([2 - iota]int8) + sizeof([2 - iota]int16)\n"
					"\tB\n\tC\n\tD\n)\n")
	_ = file
	return onlyErrorAt(c.CheckerErrors(), 6, "array length must be non-negative")
}

// An error in another declaration checked on the way — a generic type instantiated
// at a bare member's iota — stays at that declaration.
func TestBareMemberErrorElsewhereStays() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(
			"package \"test\"\ntype Box[T any] struct {\n\tpad [4 - sizeof(T)]int8\n}\n"
					"const (\n\tA = sizeof(Box[[iota + 1]int8])\n\tB\n\tC\n\tD\n\tE\n)\n")
	_ = file
	return onlyErrorAt(c.CheckerErrors(), 3, "array length is too large")
}

// A bare member evaluated on its copy reports its own evaluation error once, at the
// member, and not one the explicit member has at the same node.
func TestBareMemberCopyEvalError() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(
			"package \"test\"\nconst (\n\tA = sizeof([iota + 1]int8) / (1 - iota)\n\tB\n)\n")
	var r testing.TestResult = onlyErrorAt(c.CheckerErrors(), 4,
			"division by zero in constant expression")
	if len(r) != 0 { return r }
	c, file = checkBareSrc("package \"test\"\nconst (\n\tA = sizeof([iota + 1]int8) / 0\n\tB\n)\n")
	_ = file
	return onlyErrorAt(c.CheckerErrors(), 3, "division by zero in constant expression")
}
