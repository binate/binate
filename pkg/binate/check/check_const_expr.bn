package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"

// Constant expressions (spec decl.const: a constant's value is computed at
// compile time).  A const initializer is checked like any expression, and the
// constant evaluator (constval) folds only integer and boolean values — a
// floating-point constant is not folded — so neither decides whether an
// initializer is constant; the structural check here does.

// nonConstantOperand returns the first operand of the constant initializer e
// that is not constant, or nil when e is a constant expression: its operands
// are literals, `iota`, constants (this package's or another's), `sizeof` /
// `alignof`, `len` of a string literal or of an array, combined by unary and
// binary operators and by the builtins the constant evaluator folds (`cast`,
// `bit_cast`, `unsafe_cast`, and `unsafe_shl` / `unsafe_shr` / `unsafe_div` /
// `unsafe_rem`).  Names resolve in the current scope, then in pkg (a `.bni`
// scope being built, whose variables only it holds; nil otherwise).  A name
// that resolves to nothing (already reported as undefined) counts as constant.
func nonConstantOperand(c @Checker, e @ast.Expr, pkg @Scope) @ast.Expr {
	if e == nil {
		return nil
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_FLOAT_LIT || e.Kind == ast.EXPR_STRING_LIT ||
			e.Kind == ast.EXPR_CHAR_LIT || e.Kind == ast.EXPR_BOOL_LIT || e.Kind == ast.EXPR_NIL_LIT {
		return nil
	}
	if e.Kind == ast.EXPR_IDENT {
		if types.CharEq(e.Name, "iota") && c.Iota >= 0 {
			return nil
		}
		var sym @Symbol = c.Scope.Lookup(e.Name)
		if sym == nil && pkg != nil {
			sym = pkg.Lookup(e.Name)
		}
		if sym == nil || sym.Kind == types.SYM_CONST {
			return nil
		}
		return e
	}
	if e.Kind == ast.EXPR_SELECTOR {
		var qsym @Symbol = resolveQualifiedSym(c, e)
		if qsym != nil && qsym.Kind == types.SYM_CONST {
			return nil
		}
		return e
	}
	if e.Kind == ast.EXPR_UNARY {
		if isConstantUnaryOp(e.Op) {
			return nonConstantOperand(c, e.X, pkg)
		}
		return e
	}
	if e.Kind == ast.EXPR_BINARY {
		var x @ast.Expr = nonConstantOperand(c, e.X, pkg)
		if x != nil {
			return x
		}
		return nonConstantOperand(c, e.Y, pkg)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		if isOpTok(e.Op, token.SIZEOF) || isOpTok(e.Op, token.ALIGNOF) {
			return nil
		}
		if isOpTok(e.Op, token.LEN) && len(e.Args) == 1 {
			if lenIsConstant(c, e.Args[0], pkg) {
				return nil
			}
			return e
		}
		if (isOpTok(e.Op, token.CAST) || isOpTok(e.Op, token.BIT_CAST) ||
				isOpTok(e.Op, token.UNSAFE_CAST)) && len(e.Args) == 1 {
			return nonConstantOperand(c, e.Args[0], pkg)
		}
		if (isOpTok(e.Op, token.UNSAFE_SHL) || isOpTok(e.Op, token.UNSAFE_SHR) ||
				isOpTok(e.Op, token.UNSAFE_DIV) || isOpTok(e.Op, token.UNSAFE_REM)) && len(e.Args) == 2 {
			var a @ast.Expr = nonConstantOperand(c, e.Args[0], pkg)
			if a != nil {
				return a
			}
			return nonConstantOperand(c, e.Args[1], pkg)
		}
	}
	return e
}

// isConstantUnaryOp reports whether the unary operator op maps constants to
// a constant (not `*` or `&`).
func isConstantUnaryOp(op int) bool {
	return isOpTok(op, token.PLUS) || isOpTok(op, token.MINUS) || isOpTok(op, token.NOT) ||
			isOpTok(op, token.TILDE)
}

// isOpTok reports whether the expression operator op is the token t.
func isOpTok(op int, t token.Type) bool {
	return op == cast(int, t)
}

// lenIsConstant reports whether `len(arg)` is a constant: arg is a string
// literal or has an array type (builtin.len); pkg as for nonConstantOperand.
// A `.bni` constant's initializer is not checked, so arg's type is found from
// the variable it names: in scope, in another package, or declared later in
// the `.bni`.  An arg whose type cannot be found, or is in error, names
// nothing (reported as undefined) and counts as constant.
func lenIsConstant(c @Checker, arg @ast.Expr, pkg @Scope) bool {
	if arg.Kind == ast.EXPR_STRING_LIT {
		return true
	}
	var t @types.Type = c.ExprType(arg.ResolvedTypeID)
	if t == nil && arg.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(arg.Name)
		if sym == nil && pkg != nil {
			sym = pkg.Lookup(arg.Name)
		}
		if sym != nil {
			t = sym.Type
		} else {
			t = bniVarDeclType(c, c.BniDecls, arg.Name)
		}
	}
	if t == nil && arg.Kind == ast.EXPR_SELECTOR {
		var qsym @Symbol = resolveQualifiedSym(c, arg)
		if qsym == nil {
			return true
		}
		t = qsym.Type
	}
	if t == nil || t.Kind == types.TYP_ERROR || t.Kind == types.TYP_VOID {
		return true
	}
	var p @types.Type = types.StripWrappers(t)
	return p != nil && p.Kind == types.TYP_ARRAY
}

// bniVarDeclType returns the declared type of the variable name among the
// `.bni` declarations decls (groups included), or nil.  Only its kind is read:
// an array length it names may not be resolved yet.
func bniVarDeclType(c @Checker, decls *[]@ast.Decl, name *[]readonly char) @types.Type {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var t @types.Type = bniVarDeclType(c, d.Decls, name)
			if t != nil {
				return t
			}
		}
		if d.Kind == ast.DECL_VAR && d.TypeRef != nil && types.CharEq(d.Name, name) {
			return resolveTypeExpr(c, d.TypeRef)
		}
	}
	return nil
}

// checkConstInitConstant reports an error when the initializer e of the
// constant name is not a constant expression, at its first operand that is
// not constant; reports whether it is constant.  pkg as for nonConstantOperand.
func checkConstInitConstant(c @Checker, name *[]readonly char, e @ast.Expr, pkg @Scope) bool {
	var bad @ast.Expr = nonConstantOperand(c, e, pkg)
	if bad == nil {
		return true
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("the initializer of constant `")
	cb.Write(name)
	cb.Write("` is not a constant expression")
	addCheckError(c, bad.Pos, buf.CopyStr(cb.String()))
	return false
}
