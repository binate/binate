package "pkg/binate/check"

import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_const_expr.bn: a constant's initializer must be a constant
// expression.

// errorsContaining counts c's errors whose message contains sub.
func errorsContaining(c @Checker, sub *[]readonly char) int {
	var n int = 0
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		var m @[]char = errs[i].Msg
		for j := 0; j + len(sub) <= len(m); j++ {
			if streq(m[j:j + len(sub)], sub) {
				n++
				break
			}
		}
	}
	return n
}

// constInFunc wraps body in a function of a package with a variable v, an
// array variable arr, a slice s, a function f and a constant K.
func constInFunc(body *[]readonly char) @Checker {
	var src @[]char = catStrs(
			"package \"test\"\n"
					"var gv int = 1\n"
					"const K = 4\n"
					"func f() int { return 2 }\n"
					"func g() int {\n"
					"var v int = 3\n"
					"var arr [5]int32\n"
					"var s @[]int = make_slice(int, 3)\n"
					"var fl float64 = 2.5\n"
					"_, _, _, _ = v, arr, s, fl\n",
			body)
	return checkSrc(catStrs(src, "return 0\n}\n"))
}

// catStrs returns a followed by b.
func catStrs(a *[]readonly char, b *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(a) + len(b))
	for i := 0; i < len(a); i++ {
		out[i] = a[i]
	}
	for i := 0; i < len(b); i++ {
		out[len(a) + i] = b[i]
	}
	return out
}

// A variable, a package variable, a call, `len` of a slice, a float variable, a
// dereference and an address are not constant.
func TestConstInitNotConstantRejected() testing.TestResult {
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bodies[0] = "const C = v\n"
	bodies[1] = "const C = gv + 1\n"
	bodies[2] = "const C = f()\n"
	bodies[3] = "const C = len(s)\n"
	bodies[4] = "const C = fl * 2.0\n"
	bodies[5] = "var p *int = &v\nconst C = *p\n"
	bodies[6] = "const C = K + v\n"
	for i := 0; i < len(bodies); i++ {
		var c @Checker = constInFunc(bodies[i])
		if errorsContaining(c, "is not a constant expression") != 1 {
			return fail(catStrs("expected the not-constant error for: ", bodies[i]))
		}
	}
	return ""
}

// Literals, iota, constants, sizeof / alignof, len of an array or string, and
// casts and operators over them are constant.
func TestConstInitConstantAccepted() testing.TestResult {
	var body *[]readonly char = "const A = 1 + 2*K\n"
			"const B float64 = 1.5 * 2.0\n"
			"const C = -A + ~0\n"
			"const D = sizeof(int32) + alignof(int64)\n"
			"const E = len(arr) + len(\"abc\")\n"
			"const F = cast(int8, 3) + bit_cast(int8, cast(uint8, 250))\n"
			"const G = unsafe_shl(1, 3)\n"
			"const H = A > 3 && !(B < 1.0)\n"
			"const (\n\tI = iota * 2\n\tJ\n)\n"
			"_, _, _, _, _, _, _, _, _, _ = A, B, C, D, E, F, G, H, I, J\n"
	return expectNoErrors(constInFunc(body))
}

// A `.bni` constant initialized from a `.bni` variable is not constant.
func TestBniConstInitNotConstantRejected() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q", "package \"pkg/q\"\nvar V int\nconst C = V\n",
			"package \"test\"\nimport \"pkg/q\"\nfunc g() int { return q.C }\n")
	if errorsContaining(c, "is not a constant expression") == 0 {
		return "expected the not-constant error for the .bni constant"
	}
	return ""
}

// A `.bni` constant may take len of a `.bni` array variable declared after it,
// or of another package's array variable.
func TestBniConstLenOfLaterOrImportedArray() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"pkg/a\"\nvar Arr [4]int\n"))
	c.LoadPackageInterface("pkg/b",
			mkBniFile(
					"package \"pkg/b\"\nimport \"pkg/a\"\n"
							"const LFwd = len(Later)\nvar Later [6]int\nconst LA = len(a.Arr)\n"))
	var p @parser.Parser = parser.New(
			toBytes("package \"test\"\nimport \"pkg/b\"\n"
					"func g() int { return b.LFwd + b.LA }\n"), "test.bn")
	c.Check(mustParse(p))
	return expectNoErrors(c)
}

// A `.bni` constant that is len of an array composite literal is a constant to an
// importer, whose evaluation of it is unchecked: the length is read from the
// literal's type (spelled, or a named array type) or folded from its elements'
// positions (`[...]T`, keyed elements included).  The `[5]` / `[2]` / `[3]`
// declarations hold only if each value is exact.
func TestBniConstLenOfArrayLiteral() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Row [2]int16\nconst P int = len([...]int8{1, 2, 4: 9})\n"
					"const R = len(Row{})\nconst S int = len([3]int8{})\n",
			"package \"test\"\nimport \"pkg/q\"\n"
					"var a [5]int8 = [q.P]int8{}\nvar b [2]int8 = [q.R]int8{}\nvar d [3]int8 = [q.S]int8{}\n")
	return expectNoErrors(c)
}

// `len` of an array composite literal in an array length — which nothing checks
// but len — checks the literal: a bad element or an opaque element type is
// reported (and the type still gets the literal's length).
func TestLenOfArrayLiteralInTypeChecksLiteral() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\ntype A [len([3]int8{\"x\"})]int8\n")
	if errorsContaining(c, "cannot") == 0 {
		return "expected the bad element in the array-length literal to be reported"
	}
	c = checkSrc("package \"test\"\ntype Opaque\ntype A [len([3]Opaque{})]int8\n")
	if errorsContaining(c, "opaque") == 0 {
		return "expected the opaque element type in the array-length literal to be reported"
	}
	return ""
}

// `len` of an array literal is a constant in the declaring package too: through a
// forward reference to a later constant, and with an iota-valued key.  The `[2]` /
// `[4]` declarations hold only if each value is exact.
func TestLenOfArrayLiteralSamePackage() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\nvar g [P]int8\nvar h [2]int8 = g\n"
							"const P = len([N]int8{})\nconst N = 2\n"
							"const (\n\tI0 = iota\n\tI1\n\tI2\n\tI3\n)\n"
							"var a [len([...]int8{I3: 1})]int8\nvar b [4]int8 = a\n"))
}

// A `.bni` constant's array literal may name a later `.bni` constant in a key or
// a length: it is resolved first (collectConstDeps descends into the literal).
func TestBniConstLenOfArrayLiteralLaterConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nconst P int = len([...]int8{K: 1})\nconst Q int = len([M]int8{})\n"
					"const K = 4\nconst M = 3\n",
			"package \"test\"\nimport \"pkg/q\"\nvar a [5]int8 = [q.P]int8{}\nvar b [3]int8 = [q.Q]int8{}\n")
	return expectNoErrors(c)
}

// An importer evaluates a `.bni` constant before the `.bni`'s functions and later
// types are in its scope, so an array literal there may call a `.bni` function,
// name a type declared after it, or key a named array type with a later constant:
// its length comes from its type, and the declaring package checks the rest.
func TestBniConstLenOfArrayLiteralLaterDecls() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\nfunc F() int\nconst P int = len([3]int{F(), 1, 2})\n"
					"const Q int = len([2]S{S{x: 1}})\ntype S struct { x int }\n"
					"type Row [8]int16\nconst R int = len(Row{K: 1})\nconst K = 4\n",
			"package \"test\"\nimport \"pkg/q\"\nvar a [3]int8 = [q.P]int8{}\nvar r [8]int8 = [q.R]int8{}\n"
					"var b [2]int8 = [q.Q]int8{}\n"
					"func g() int { return q.F() }\n")
	return expectNoErrors(c)
}
