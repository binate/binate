package "pkg/binate/check"

import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_const_expr.bn: a constant's initializer must be a constant
// expression.

// errorsContaining counts c's errors whose message contains sub.
func errorsContaining(c @Checker, sub *[]readonly char) int {
	var n int = 0
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		var m @[]char = errs[i].Msg
		for j := 0; j + len(sub) <= len(m); j++ {
			if streq(m[j:j + len(sub)], sub) {
				n++
				break
			}
		}
	}
	return n
}

// constInFunc wraps body in a function of a package with a variable v, an
// array variable arr, a slice s, a function f and a constant K.
func constInFunc(body *[]readonly char) @Checker {
	var src @[]char = catStrs(
			"package \"test\"\n"
					"var gv int = 1\n"
					"const K = 4\n"
					"func f() int { return 2 }\n"
					"func g() int {\n"
					"var v int = 3\n"
					"var arr [5]int32\n"
					"var s @[]int = make_slice(int, 3)\n"
					"var fl float64 = 2.5\n"
					"_, _, _, _ = v, arr, s, fl\n",
			body)
	return checkSrc(catStrs(src, "return 0\n}\n"))
}

// catStrs returns a followed by b.
func catStrs(a *[]readonly char, b *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(a) + len(b))
	for i := 0; i < len(a); i++ {
		out[i] = a[i]
	}
	for i := 0; i < len(b); i++ {
		out[len(a) + i] = b[i]
	}
	return out
}

// A variable, a package variable, a call, `len` of a slice, a float variable, a
// dereference and an address are not constant.
func TestConstInitNotConstantRejected() testing.TestResult {
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bodies[0] = "const C = v\n"
	bodies[1] = "const C = gv + 1\n"
	bodies[2] = "const C = f()\n"
	bodies[3] = "const C = len(s)\n"
	bodies[4] = "const C = fl * 2.0\n"
	bodies[5] = "var p *int = &v\nconst C = *p\n"
	bodies[6] = "const C = K + v\n"
	for i := 0; i < len(bodies); i++ {
		var c @Checker = constInFunc(bodies[i])
		if errorsContaining(c, "is not a constant expression") != 1 {
			return fail(catStrs("expected the not-constant error for: ", bodies[i]))
		}
	}
	return ""
}

// Literals, iota, constants, sizeof / alignof, len of an array or string, and
// casts and operators over them are constant.
func TestConstInitConstantAccepted() testing.TestResult {
	var body *[]readonly char = "const A = 1 + 2*K\n"
			"const B float64 = 1.5 * 2.0\n"
			"const C = -A + ~0\n"
			"const D = sizeof(int32) + alignof(int64)\n"
			"const E = len(arr) + len(\"abc\")\n"
			"const F = cast(int8, 3) + bit_cast(int8, cast(uint8, 250))\n"
			"const G = unsafe_shl(1, 3)\n"
			"const H = A > 3 && !(B < 1.0)\n"
			"const (\n\tI = iota * 2\n\tJ\n)\n"
			"_, _, _, _, _, _, _, _, _, _ = A, B, C, D, E, F, G, H, I, J\n"
	return expectNoErrors(constInFunc(body))
}

// A `.bni` constant initialized from a `.bni` variable is not constant.
func TestBniConstInitNotConstantRejected() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q", "package \"pkg/q\"\nvar V int\nconst C = V\n",
			"package \"test\"\nimport \"pkg/q\"\nfunc g() int { return q.C }\n")
	if errorsContaining(c, "is not a constant expression") == 0 {
		return "expected the not-constant error for the .bni constant"
	}
	return ""
}

// A `.bni` constant may take len of a `.bni` array variable declared after it,
// or of another package's array variable.
func TestBniConstLenOfLaterOrImportedArray() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"pkg/a\"\nvar Arr [4]int\n"))
	c.LoadPackageInterface("pkg/b",
			mkBniFile(
					"package \"pkg/b\"\nimport \"pkg/a\"\n"
							"const LFwd = len(Later)\nvar Later [6]int\nconst LA = len(a.Arr)\n"))
	var p @parser.Parser = parser.New(
			toBytes("package \"test\"\nimport \"pkg/b\"\n"
					"func g() int { return b.LFwd + b.LA }\n"), "test.bn")
	c.Check(p.ParseFile())
	return expectNoErrors(c)
}
