package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/containers/table"

// The constants of the batch, or of a `.bni` build, by name (ConstIndex), so a
// constant is found in time independent of how many there are.

// constIndexIn returns the index of names when it is the constants of c's batch or
// `.bni` build -- built the first time, and again when the list is not the one it was
// built over -- or nil for another list.
func constIndexIn(
		c @Checker, names @[]@[]char) @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] {
	var b @DeclBatch = c.Batch
	if b != nil && same(names, b.ConstNames) {
		if b.ConstIndex == nil || !same(b.ConstIndexFor, names) {
			b.ConstIndex = indexConstNames(names)
			b.ConstIndexFor = names
		}
		return b.ConstIndex
	}
	var bb @BniBuild = c.BniBuild
	if bb != nil && same(names, bb.ConstNames) {
		if bb.ConstIndex == nil || !same(bb.ConstIndexFor, names) {
			bb.ConstIndex = indexConstNames(names)
			bb.ConstIndexFor = names
		}
		return bb.ConstIndex
	}
	var none @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq]
	return none
}

// indexConstNames returns the first index in names of each name.  Its keys borrow the
// names.
func indexConstNames(
		names @[]@[]char) @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] {
	var idx @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] = table.NewTable[
			*[]readonly char, int, ScopeNameHasher, ScopeNameEq](ScopeNameHasher{}, ScopeNameEq{})
	for i := 0; i < len(names); i++ {
		_, _ = idx.GetOrPut(names[i], i)
	}
	return idx
}

// findConstDecl returns the decl registered for top-level const `name` -- for a
// const-group member, its group -- or nil if `name` is not a local top-level const
// (a builtin, an imported const, or a non-const): the first of names, through its
// index when it is the batch's or the `.bni` build's (constIndexIn).
func findConstDecl(c @Checker, names @[]@[]char, cdecls @[]@ast.Decl,
		name *[]readonly char) @ast.Decl {
	var idx @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] = constIndexIn(c, names)
	if idx != nil {
		i, found := idx.Get(name)
		if !found { return nil }
		return cdecls[i]
	}
	for i := 0; i < len(names); i++ {
		if types.CharEq(names[i], name) { return cdecls[i] }
	}
	return nil
}

// constListed reports whether name is one of names, through its index when it is the
// batch's or the `.bni` build's constants (constIndexIn).
func constListed(c @Checker, names @[]@[]char, name *[]readonly char) bool {
	var idx @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] = constIndexIn(c, names)
	if idx != nil { return idx.Has(name) }
	return nameInList(names, name)
}
