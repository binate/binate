package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_const_index.bn.

// A constant of the batch is found by name -- the first of a name -- through the batch's
// index, built on the first lookup; a copy of the list is walked, leaving the index as it
// is; a name not listed is not found.
func TestConstIndex() testing.TestResult {
	var c @Checker = NewChecker()
	var noDecls @[]@ast.Decl
	c.Batch = newDeclBatch("main", noDecls)
	var names @[]@[]char = make_slice(@[]char, 3)
	var cdecls @[]@ast.Decl = make_slice(@ast.Decl, 3)
	names[0] = buf.CopyStr("a")
	names[1] = buf.CopyStr("b")
	names[2] = buf.CopyStr("a")
	for i := 0; i < 3; i++ { cdecls[i] = make(ast.Decl) }
	c.Batch.ConstNames = names
	c.Batch.ConstDecls = cdecls
	if findConstDecl(c, names, cdecls, "a") != cdecls[0] { return "the first a" }
	if c.Batch.ConstIndex == nil { return "the batch's index, built on the first lookup" }
	if !constListed(c, names, "b") || constListed(c, names, "z") { return "b listed, z not" }
	var other @[]@[]char = make_slice(@[]char, 3)
	for i := 0; i < 3; i++ { other[i] = names[i] }
	if findConstDecl(c, other, cdecls, "a") != cdecls[0] ||
			findConstDecl(c, other, cdecls, "z") != nil {
		return "the first a in a copy, walked; no z"
	}
	if !same(c.Batch.ConstIndexFor, names) { return "the batch's index left as it was" }
	return ""
}

// The constants of a `.bni` build are found through the build's index, not the batch's,
// when both are set; and an index built before the batch's list was set is built again
// over it.
func TestConstIndexOwners() testing.TestResult {
	var c @Checker = NewChecker()
	var noDecls @[]@ast.Decl
	c.Batch = newDeclBatch("main", noDecls)
	if constListed(c, c.Batch.ConstNames, "a") { return "no a in the empty list" }
	if c.Batch.ConstIndex == nil { return "an index over the empty list" }
	var names @[]@[]char = make_slice(@[]char, 1)
	var cdecls @[]@ast.Decl = make_slice(@ast.Decl, 1)
	names[0] = buf.CopyStr("a")
	cdecls[0] = make(ast.Decl)
	c.Batch.ConstNames = names
	c.Batch.ConstDecls = cdecls
	if !constListed(c, names, "a") { return "a, once the list is set" }
	var bniNames @[]@[]char = make_slice(@[]char, 1)
	var bniDecls @[]@ast.Decl = make_slice(@ast.Decl, 1)
	bniNames[0] = buf.CopyStr("b")
	bniDecls[0] = make(ast.Decl)
	c.BniBuild = make(BniBuild)
	c.BniBuild.ConstNames = bniNames
	c.BniBuild.ConstDecls = bniDecls
	if findConstDecl(c, bniNames, bniDecls, "b") != bniDecls[0] { return "b, the build's" }
	if c.BniBuild.ConstIndex == nil || !same(c.BniBuild.ConstIndexFor, bniNames) {
		return "the build's own index"
	}
	if !same(c.Batch.ConstIndexFor, names) || constListed(c, names, "b") {
		return "the batch's index left as it was"
	}
	return ""
}
