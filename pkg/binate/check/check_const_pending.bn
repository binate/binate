package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// A constant of the batch resolved while a variable's type is found may read
// that variable's placeholder (check_var_placeholder.bn): `const K = len(V)`,
// resolved on demand by V's own array length `[len(f(K))]`, which needs only
// f's result type.  K is then resolved without V's type: without a value when
// its value needs it, and with the errors V's type would show unreported.  Its
// resolution is kept while the placeholder stands, so that an array length
// whose value needs it is a variable type cycle (notePoisonedConst), and is
// undone once no placeholder it read stands, to be resolved again when next
// read (resolveDeclOnDemand) or resolved by name (resolveConstByName), as
// finishTopLevelConsts resolves each constant.  So is a constant whose
// resolution read such a constant.  The reads in a constant's resolution are
// its own, not those of a variable's check around it (judgeFreeReads).  A
// variable checked meanwhile whose initializer, outside the array lengths in
// it, read such a constant is checked again then too: its type does not depend
// on the constant's value (spec decl.var.type-acyclic), but its initializer is
// compiled with the values its check recorded.

// pendingConst is a constant of the batch resolved while placeholders that its
// resolution read, itself or through another such constant, stood (vars), with
// what undoing its resolution needs: the scope it is bound in, its binding
// before (held), and its declaration (a group member's own).
type pendingConst struct {
	sym   @Symbol
	name  @[]char
	scope @Scope
	held  @Symbol
	decl  @ast.Decl
	vars  @[]@ast.Decl
}

// notePendingRead logs a read of sym when it is a pending constant
// (PendingReads), with the array length depth it is read at (PendingReadLens).
func notePendingRead(c @Checker, sym @Symbol) {
	if pendingConstIndex(c, sym) >= 0 {
		var b @DeclBatch = c.Batch
		b.PendingReads = slices.Append[@Symbol](b.PendingReads, sym)
		b.PendingReadLens = slices.Append[int](b.PendingReadLens, b.LenDepth)
	}
}

// takeConstReads returns the variables whose placeholders a constant's
// resolution, begun at m, read — itself or through a pending constant — and
// marks those reads its own, judged (a depth of -1).
func takeConstReads(c @Checker, m placeholderMark) @[]@ast.Decl {
	var vars @[]@ast.Decl
	var b @DeclBatch = c.Batch
	if b == nil {
		return vars
	}
	for i := m.reads; i < len(b.PlaceholderReads); i++ {
		if b.ReadLens[i] >= 0 {
			vars = appendDeclOnce(vars, b.PlaceholderReads[i])
			b.ReadLens[i] = -1
		}
	}
	for i := m.pending; i < len(b.PendingReads); i++ {
		if b.PendingReadLens[i] >= 0 {
			var j int = pendingConstIndex(c, b.PendingReads[i])
			if j >= 0 {
				var p @[]@ast.Decl = b.PendingConsts[j].vars
				for k := 0; k < len(p); k++ {
					vars = appendDeclOnce(vars, p[k])
				}
			}
			b.PendingReadLens[i] = -1
		}
	}
	return vars
}

// notePendingConst records the batch's constant name, just resolved in scope ds
// from the binding held, with declaration d, as pending when its resolution,
// begun at m, read a placeholder or a pending constant (takeConstReads), or it
// is a bare group member and repeats, the member whose initializer it repeats,
// is pending: its evaluation reuses what that member's check recorded.
func notePendingConst(c @Checker, name *[]readonly char, ds @Scope, held @Symbol, d @ast.Decl,
		m placeholderMark, repeats @Symbol) {
	var vars @[]@ast.Decl = takeConstReads(c, m)
	var b @DeclBatch = c.Batch
	var r int = pendingConstIndex(c, repeats)
	if r >= 0 {
		var rv @[]@ast.Decl = b.PendingConsts[r].vars
		for i := 0; i < len(rv); i++ {
			vars = appendDeclOnce(vars, rv[i])
		}
	}
	if len(vars) == 0 {
		return
	}
	var p pendingConst
	p.sym = ds.LookupLocal(name)
	p.name = buf.CopyStr(name)
	p.scope = ds
	p.held = held
	p.decl = d
	p.vars = vars
	b.PendingConsts = slices.Append[pendingConst](b.PendingConsts, p)
}

// pendingConstIndex returns the index of the pending constant sym in
// PendingConsts, or -1.
func pendingConstIndex(c @Checker, sym @Symbol) int {
	var b @DeclBatch = c.Batch
	if b == nil || sym == nil || sym.Kind != types.SYM_CONST {
		return -1
	}
	for i := 0; i < len(b.PendingConsts); i++ {
		if same(b.PendingConsts[i].sym, sym) {
			return i
		}
	}
	return -1
}

// pendingConstNamed returns the index of the pending constant name in
// PendingConsts, or -1.
func pendingConstNamed(c @Checker, name *[]readonly char) int {
	var b @DeclBatch = c.Batch
	if b == nil {
		return -1
	}
	for i := 0; i < len(b.PendingConsts); i++ {
		if types.CharEq(b.PendingConsts[i].name, name) {
			return i
		}
	}
	return -1
}

// releasePendingConst is releasePendingAt of the pending constant sym.
func releasePendingConst(c @Checker, sym @Symbol) bool {
	return releasePendingAt(c, pendingConstIndex(c, sym))
}

// releasePendingAt undoes the resolution of the pending constant at index i of
// PendingConsts (none when i is -1) once no placeholder its resolution read
// stands — its binding, its record as resolved, what its check recorded on its
// syntax — to be resolved again, and reports whether it did.
func releasePendingAt(c @Checker, i int) bool {
	if i < 0 {
		return false
	}
	var b @DeclBatch = c.Batch
	var p pendingConst = b.PendingConsts[i]
	for j := 0; j < len(p.vars); j++ {
		if same(placeholderOf(c, p.scope.LookupLocal(p.vars[j].Name)), p.vars[j]) {
			return false
		}
	}
	restoreBinding(p.scope, p.name, p.held)
	var resolved @[]@[]char
	for j := 0; j < len(c.ConstResolved); j++ {
		if !types.CharEq(c.ConstResolved[j], p.name) {
			resolved = slices.Append[@[]char](resolved, c.ConstResolved[j])
		}
	}
	c.ConstResolved = resolved
	var members @[]@ast.Decl
	for j := 0; j < len(c.ConstMembersResolved); j++ {
		if !same(c.ConstMembersResolved[j], p.decl) {
			members = slices.Append[@ast.Decl](members, c.ConstMembersResolved[j])
		}
	}
	c.ConstMembersResolved = members
	ast.ClearCheckerAnnotations(p.decl)
	var rest @[]pendingConst
	for j := 0; j < len(b.PendingConsts); j++ {
		if j != i {
			rest = slices.Append[pendingConst](rest, b.PendingConsts[j])
		}
	}
	b.PendingConsts = rest
	return true
}

// noteStaleVarCheck records the batch's variable d, whose check began at m, to
// be checked again once the pending constants are resolved again (VarsStale)
// when its check read one at its own array length depth: in its initializer
// outside the array lengths in it, code that is compiled.
func noteStaleVarCheck(c @Checker, d @ast.Decl, m varCheckMark) {
	var b @DeclBatch = c.Batch
	for i := m.pending; i < len(b.PendingReads); i++ {
		if b.PendingReadLens[i] == m.depth {
			b.VarsStale = appendDeclOnce(b.VarsStale, d)
			b.PendingReadLens[i] = -1
		}
	}
}

// recheckStaleVars checks again each variable on VarsStale, its annotations
// cleared, now that the constants it read are resolved again — not one whose
// type cycle is reported, nor one checked again after collection already
// (recheckDeferredVars), whose check read them resolved again.
func recheckStaleVars(c @Checker) {
	var b @DeclBatch = c.Batch
	for i := 0; i < len(b.VarsStale); i++ {
		var d @ast.Decl = b.VarsStale[i]
		if declInList(b.VarsCycled, d) || declInList(b.VarsDeferred, d) {
			continue
		}
		var saved declContext = enterPackageDecl(c, d)
		ast.ClearCheckerAnnotations(d)
		var m varCheckMark = beginVarCheck(c, d)
		checkVarDecl(c, d)
		finalizeUntypedNonConst(c)
		var waited bool = endVarCheck(c, d, m)
		leavePackageDecl(c, saved)
		if waited {
			flushLayoutWaits(c)
		}
	}
}

// appendDeclOnce appends d to ds unless ds holds it.
func appendDeclOnce(ds @[]@ast.Decl, d @ast.Decl) @[]@ast.Decl {
	if declInList(ds, d) {
		return ds
	}
	return slices.Append[@ast.Decl](ds, d)
}
