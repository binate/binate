package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_const_pending.bn: a constant resolved while a variable's type
// is found, whose resolution reads that variable's placeholder, is resolved
// again once the variable has its type, and a variable whose initializer read
// it meanwhile is checked again.

// pendingSrc returns the package of the declarations rest, after f, whose
// result type alone is an array length's operand's type in `[len(f(K))]`, and
// S, whose field a is a `[3]int`.
func pendingSrc(rest *[]readonly char) @[]char {
	return buf.Concat(
			"package \"test\"\nfunc f(x int) [3]int { var a [3]int; return a }\n"
					"type S struct { a [3]int; k int }\n",
			rest)
}

// constNamedIs reports "" when the top-level constant name among file's
// declarations (a group's members included) has the integer value want.
func constNamedIs(c @Checker, file @ast.File, name *[]readonly char, want int) testing.TestResult {
	for i := 0; i < len(file.Decls); i++ {
		var ds @[]@ast.Decl
		if file.Decls[i].Kind == ast.DECL_GROUP {
			ds = file.Decls[i].Decls
		} else {
			ds = make_slice(@ast.Decl, 1)
			ds[0] = file.Decls[i]
		}
		for j := 0; j < len(ds); j++ {
			if ds[j].Kind == ast.DECL_CONST && types.CharEq(ds[j].Name, name) {
				var v constval.Value
				var st int
				var have bool
				v, st, have = c.DeclConst(ds[j])
				if !have || st != constval.OK || v.N.ToInt() != want {
					return fail(buf.Concat(name, ": not the expected value"))
				}
				return ""
			}
		}
	}
	return fail(buf.Concat(name, ": not declared"))
}

// varArrayLenIs reports "" when file declares the variable name with an array
// type of length want.
func varArrayLenIs(c @Checker, file @ast.File, name *[]readonly char,
		want int64) testing.TestResult {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_VAR && types.CharEq(d.Name, name) {
			var t @types.Type = types.StripWrappers(c.ExprType(d.ResolvedTypeID))
			if t == nil || t.Kind != types.TYP_ARRAY || t.ArrayLen != want {
				return fail(buf.Concat(name, ": not an array of the expected length"))
			}
			return ""
		}
	}
	return fail(buf.Concat(name, ": not declared"))
}

// A constant read by a variable's array length where the length needs no value
// of it — a call's argument, a function literal's body called there — reads the
// variable's placeholder, and is resolved again once the variable has its type:
// so is a constant reading it, a group's bare member repeating its initializer,
// and another length reading it — a variable's, a type's collected after — has
// its value.
func TestPendingConstResolvedAgain() testing.TestResult {
	var srcs [4]*[]readonly char
	srcs[0] = "var V [len(f(K))]int\nconst K = len(V)\nvar Z [K]int\nconst L = K + 1\ntype T [K]int\n"
			"var Y T\n"
	srcs[1] = "var V [len(func() [3]int { var a [3]int; _ = K; return a }())]int\nconst K = len(V)\n"
			"var Z [K]int\nconst L = K + 1\n"
	srcs[2] = "var V [len(f(L))]int\nconst K = len(V)\nconst L = K + 1\nvar Z [K]int\n"
	srcs[3] = "var V [len(f(L))]int\nconst (\n\tK = len(V)\n\tJ\n)\nconst L = J + 1\nvar Z [J]int\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker
		var file @ast.File
		c, file = checkBareSrc(pendingSrc(srcs[i]))
		if len(c.CheckerErrors()) != 0 {
			return fail(buf.Concat("checks cleanly: ", srcs[i]))
		}
		var r testing.TestResult = constNamedIs(c, file, "K", 3)
		if len(r) == 0 {
			r = constNamedIs(c, file, "L", 4)
		}
		if len(r) == 0 && i == 3 {
			r = constNamedIs(c, file, "J", 3)
		}
		if len(r) == 0 {
			r = varArrayLenIs(c, file, "Z", 3)
		}
		if len(r) == 0 && i == 0 {
			r = varArrayLenIs(c, file, "Y", 3)
		}
		if len(r) > 0 { return r }
	}
	return ""
}

// Resolved again, the constant's check reports what the placeholder hid: V is a
// `[5]int`, which g's parameter rejects.
func TestPendingConstReportsHiddenError() testing.TestResult {
	var c @Checker = checkSrc(
			pendingSrc(
					"func g(x [3]int) [4]int { var a [4]int; return a }\n"
							"var V [len(f(K)) + 2]int\nconst K = len(g(V))\n"))
	return expectOneErrAt(c, 6, 17, "cannot assign [5]int to [3]int")
}

// A variable checked while the constant is pending, by the array length of the
// variable whose placeholder the constant read, whose initializer reads the
// constant outside its array lengths — W's type needs no value of K — is checked
// again once K is resolved again: its initializer records K's value, and its
// errors that need that value are reported.  So is one that reads K resolved
// before its check.
func TestPendingConstVarCheckedAgain() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(
			pendingSrc("var V [len(W)]int\nvar W = S{k: K}.a\nconst K = len(V)\nvar Z [K]int\n"))
	if len(c.CheckerErrors()) != 0 {
		return fail("V's type needs only W's, which needs no value of K")
	}
	var r testing.TestResult = constNamedIs(c, file, "K", 3)
	if len(r) == 0 {
		r = varArrayLenIs(c, file, "Z", 3)
	}
	if len(r) > 0 { return r }
	var k @ast.Expr = file.Decls[3].Value.X.Elems[0].Value
	var v constval.Value
	var st int
	v, st = c.ConstValue(k)
	if st != constval.OK || v.N.ToInt() != 3 { return fail("W's initializer records K's value") }
	c = checkSrc(pendingSrc("var V [len(W)]int\nvar W = S{k: 10 / (K - 3)}.a\nconst K = len(V)\n"))
	r = expectOneErrAt(c, 5, 17, "division by zero in constant expression")
	if len(r) > 0 { return r }
	c, file = checkBareSrc(
			pendingSrc("var V [len(f(K)) + len(W)]int\nvar W = S{k: K}.a\nconst K = len(V)\n"))
	if len(c.CheckerErrors()) != 0 { return fail("K is read resolved before W's check") }
	return constNamedIs(c, file, "K", 6)
}
