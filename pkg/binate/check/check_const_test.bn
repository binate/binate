package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for constant-declaration checking in check_const.bn: single and
// grouped consts (iota), scalar-only enforcement, and a bare group member
// inheriting the preceding member's type (with the inherited-width fit-check).
// Forward-reference / dependency-ordered resolution tests live in
// check_const_resolve_test.bn.

func TestCheckConstDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckConstGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst (\n\tA int = iota\n\tB\n\tC\n)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// const is scalar-only: bool and float consts are accepted (int is
// covered by TestCheckConstDecl).  Guards that the scalar-only rule
// doesn't reject the legitimate non-int scalar families.
func TestCheckConstBoolFloatOK() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst B bool = true\nconst F float64 = 1.5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A string-typed const is rejected — const requires a scalar type; a
// string immutable value is a `var X readonly *[]readonly char = ...`.
func TestCheckRejectConstString() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X *[]readonly char = \"hi\"\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A struct-typed const is rejected for the same reason (non-scalar).
func TestCheckRejectConstStruct() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Pt struct { x int }\n"
					"const P Pt = Pt{x: 1}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// A value-less standalone const is rejected — every const carries a
// value (only iota-group members may omit it).
func TestCheckRejectConstNoValue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X int\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A bare const-group member inherits the preceding member's TYPE and is
// range-checked at that INHERITED width.  In `const ( A uint8 = 128 <<
// iota; B )`, the bare B repeats `128 << iota` re-evaluated at iota=1 =
// 256, which overflows the inherited uint8 — so it must be REJECTED, just
// as the explicit `const B uint8 = 256` is.  Without checkGroupDecl
// threading prevTypeRef onto the synthesized repeat decl, B would be
// typed untyped-int, skip the fit-check, and silently truncate to 0 at
// IR-gen (the bare-member-drops-inherited-type miscompile, conf
// regression const-group-bare-inherited-overflow).
func TestConstGroupBareMemberInheritsTypeRejectsOverflow() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const (\n"
			"\tA uint8 = 128 << iota\n"
			"\tB\n"
			")\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Positive control for the inherited-type range check: a bare member
// whose repeated value still FITS the inherited type is accepted.  In
// `const ( A uint8 = 1 << iota; B )`, B = 1<<1 = 2 fits uint8 — the
// inheritance must not over-reject in-range bare members.
func TestConstGroupBareMemberInheritsTypeAcceptsInRange() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const (\n"
			"\tA uint8 = 1 << iota\n"
			"\tB\n"
			")\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Each bare member of a const group whose initializer mentions iota has its own copy
// of that initializer, checked at its iota (RepeatedInit) — the explicit member keeps
// its original, checked at its own; an initializer without iota is shared, no copy.
func TestRepeatedInitPerMember() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const (\n\tA float64 = cast(float64, iota - 5)\n\tB\n\tC\n)\n"
			"const (\n\tP = 2\n\tQ\n)\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 { return fail("the groups check cleanly") }
	var g @ast.Decl = file.Decls[0]
	var a @ast.Decl = g.Decls[0]
	if c.RepeatedInit(a) != nil { return fail("an explicit member has no copy") }
	var want @[]int = @[]int{-5, -4, -3}
	for k := 0; k < 3; k++ {
		var init @ast.Expr = a.Value
		if k > 0 {
			init = c.RepeatedInit(g.Decls[k])
			if init == nil || init == a.Value { return fail("a bare member has its own copy") }
		}
		var diff @types.Type = c.ExprType(init.Args[0].ResolvedTypeID)
		if diff == nil || !diff.HasLitVal { return fail("the copy is checked") }
		var mag int = cast(int, diff.LitMag)
		if diff.LitSign { mag = 0 - mag }
		if mag != want[k] { return fail("each member's iota - 5 is its own value") }
	}
	if c.RepeatedInit(file.Decls[1].Decls[1]) != nil {
		return fail("an initializer without iota is not copied")
	}
	return ""
}
