package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// A type argument's constraint check of an instantiation (judgeInstantiation) is
// latched per view (constraintsCheckedIn) and made in a layout frame of its own
// (layoutFrame.Check): it is no part of a layout, so when it reads one not built
// yet, it waits -- its reports dropped (layoutFrameBlocked) -- and not the instance
// whose build it is made in, which may be the very instance it reads; it is made
// once the instances being built are (deferConstraintCheck).  A check named where
// the resolution waits (resolutionWaits) is not made: that resolution is done
// again, and names it again -- the instance it names may be formed from a length
// the resolution could not read, `[0]uint8` for `[sizeof(Q[T])]uint8`, which the
// one done again forms with the real one.  A check whose report a provisional
// build holds is not latched, given out or not (check_held.bn).

// judgeInstantiation checks the type arguments of the instantiation entry, of the
// generic d with args, against their constraints at pos from view in the naming
// context n (checkInstantiationConstraints), latched for view -- unless the
// resolution naming it waits.  It is latched only when its report reaches the
// user: not under TentativeMode (a REPL declaration that may park, its reports
// then discarded), nor while a provisional build holds it -- latched then when the
// build is given out (holdLatch).
func judgeInstantiation(c @Checker, entry @GenericInstantiation, d @ast.Decl, args @[]@types.Type,
		pos token.Pos, view ImplView, n namingContext) {
	if resolutionWaits(c) {
		return
	}
	var latch bool = !c.Repl.TentativeMode && holding(c) == nil
	if latch {
		markConstraintsChecked(entry, view)
	} else if !c.Repl.TentativeMode {
		holdLatch(c, entry, view)
	}
	var framed bool = enterCheckFrame(c)
	checkInstantiationConstraints(c, d, args, pos, view, n)
	if leaveCheckFrame(c, framed) && !deferConstraintCheck(c, entry, d, args, pos, view, n) && latch {
		// A frame is opened only inside an instantiation in progress, which
		// deferUntilBuilt takes it for; were it not, the latch would strand the
		// check, which a later use makes instead.
		unmarkConstraintsChecked(entry, view)
	}
}

// enterCheckFrame starts a constraint check as a layout frame of its own
// (layoutFrame.Check), until leaveCheckFrame, and reports whether it did: with no
// frame around it -- nothing being built -- nothing it reads makes it wait.  It
// names no instance of its own: its errors name what the frames around it do.
func enterCheckFrame(c @Checker) bool {
	if c.Instances == nil || len(c.Instances.Populating) == 0 {
		return false
	}
	var f layoutFrame
	f.Check = true
	c.Instances.Populating = slices.Append[layoutFrame](c.Instances.Populating, f)
	return true
}

// leaveCheckFrame ends the check enterCheckFrame started (framed: it did) and
// reports whether it waited for a layout not built yet.
func leaveCheckFrame(c @Checker, framed bool) bool {
	if !framed {
		return false
	}
	var st @InstanceState = c.Instances
	var waited bool = st.Populating[len(st.Populating) - 1].Blocked
	st.Populating = st.Populating[:len(st.Populating) - 1]
	return waited
}

// deferConstraintCheck records the constraint check of the instantiation entry,
// of d with args, at pos from view in the naming context n, which waited for a
// layout not built yet, to be made once the outermost instantiation in progress
// completes (deferUntilBuilt), as it would be made where it is recorded, naming
// the instance worked on then (newPendingCheck); reports whether one is in
// progress -- a frame is entered only within one.
func deferConstraintCheck(c @Checker, entry @GenericInstantiation, d @ast.Decl, args @[]@types.Type,
		pos token.Pos, view ImplView, n namingContext) bool {
	var later pendingCheck
	later.Kind = pendingConstraints
	later.Check = newPendingCheck(c, d, args, pos, view, true)
	later.Check.Naming = n
	later.Entry = entry
	return deferUntilBuilt(c, later)
}

// makeDeferredConstraintCheck makes the check p, deferred (deferConstraintCheck),
// as it would have been made where it was recorded.
func makeDeferredConstraintCheck(c @Checker, p @PendingConstraintCheck) {
	pushInstanceNaming(c, p.Work, p.WorkDecl)
	var savedLevel int = setMissLevel(c, p.DeclLevel)
	checkInstantiationConstraints(c, p.Decl, p.Args, p.Pos, p.View, p.Naming)
	c.Generics.MissLevel = savedLevel
	popInstanceNaming(c)
}
