package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_constraint_judge.bn: a constraint check made where a layout is
// not built yet.

// X[int8], built for Y's field, forms K[int8, *N, int8], whose constraint check
// reads X[int8]'s size while X[int8] is built: the check is made once X[int8] is,
// and X's misses are reported -- as without the size (K's A bounded by
// Sz[[4]uint8]), and with no cycle, which a check made while X[int8] waits for K
// would find.
func TestConstraintCheckWaitingForLayoutReported() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface Eq { eq() int }\ninterface Hk[T any] { hk() int }\n"
				"interface Sz[T any] { sz() int }\ntype G2[A Eq] struct { a A }\ntype N struct { v int }\n"
				"func (n *N) eq() int { return 1 }\nimpl *N : Eq\ntype Y[T any] struct { x X[int8]; t T }\n"
				"type X[T any] struct { k K[T, *N, T]; t T }\n"
				"type K[A Sz[[sizeof(X[int8])]uint8], V Eq, B Hk[G2[V]]] struct { a A }\n"
	var c @Checker = checkSrc(src)
	if !anyErrContains(c, "type argument T does not satisfy constraint Sz[[2]uint8]") {
		return fail("X's Sz miss must be reported")
	}
	if !anyErrContains(c, "type argument T does not satisfy constraint Hk[G2[*N]]") {
		return fail("X's Hk miss must be reported")
	}
	if anyErrContains(c, "cyclic") {
		return fail("a constraint check is no part of a layout")
	}
	return ""
}

// The program of TestConstraintCheckWaitingForLayoutReported with K's A bounded by
// Sz[[4]uint8]: no layout waits, and the same misses are reported.
func TestConstraintCheckWithoutWaitReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ninterface Hk[T any] { hk() int }\n"
					"interface Sz[T any] { sz() int }\ntype G2[A Eq] struct { a A }\ntype N struct { v int }\n"
					"func (n *N) eq() int { return 1 }\nimpl *N : Eq\ntype Y[T any] struct { x X[int8]; t T }\n"
					"type X[T any] struct { k K[T, *N, T]; t T }\n"
					"type K[A Sz[[4]uint8], V Eq, B Hk[G2[V]]] struct { a A }\n")
	if !anyErrContains(c, "type argument T does not satisfy constraint Sz[[4]uint8]") ||
			!anyErrContains(c, "type argument T does not satisfy constraint Hk[G2[*N]]") {
		return fail("X's misses must be reported")
	}
	return ""
}

// X[int64]'s first build waits for Q[int64]'s layout and forms KA's instantiation
// with B as [0]uint8; that check is not made, and the build done again forms
// KA[*Box[Q[int64]], [sizeof(Q[int64])]uint8], which is valid.
func TestConstraintCheckFromUnreadLengthNotMade() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
							"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"type Q[T any] struct { v T; p *X[T] }\n"
							"type X[T any] struct { k KA[*Box[Q[T]], [sizeof(Q[T])]uint8]; t T }\n"
							"type KA[A Eq[B], B any] = *A\nfunc f() bool { var q Q[int64]; return q.p == nil }\n"))
}

// X[int64]'s field names KA[*Box[X[int64]], X[int64]], whose check reads
// X[int64]'s own size: the check waits, not X[int64], which is built, and the
// check made then passes -- no cycle.
func TestConstraintCheckReadingItsInstanceWaits() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
							"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"type Q[T any] struct { v T; p *X[T] }\n"
							"type X[T any] struct { a [sizeof(Q[T])]uint8; k KA[*Box[X[T]], X[T]]; t T }\n"
							"type KA[A Eq[[sizeof(B)]uint8], B any] = *A\n"
							"func f() bool { var q Q[int64]; return q.p == nil }\n"))
}

// Other[*Box[Q[int64]], [0]uint8], first named by X[int64]'s build that waits for
// Q[int64]'s layout, is not checked there; f names it, and the miss is reported
// there alone, not at X's field, which names it only from the length not read.
func TestOwnCheckOfInstanceNamedWaitingNotHeld() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
					"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
					"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
					"type Other[A Eq[B], B any] struct { a A }\n"
					"type Q[T any] struct { v T; p *X[T] }\n"
					"type X[T any] struct { a *Other[*Box[Q[T]], [sizeof(Q[T])]uint8]; t T }\n"
					"func f() bool { var q Q[int64]; var o *Other[*Box[Q[int64]], [0]uint8]; "
					"return q.p == nil && o == nil }\n")
	var misses int = countErrsContaining(c, "does not satisfy constraint Eq[[0]uint8]")
	if misses != 1 || anyErrContains(c, "(in X[int64]") {
		return fail("only f's naming of Other[*Box[Q[int64]], [0]uint8] misses")
	}
	return ""
}
