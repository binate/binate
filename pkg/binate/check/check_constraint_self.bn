package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// A type parameter's constraint may not name that type parameter
// (gen.constraint.self): `func f[T Eq[T]]` is written with `Self` in the
// interface instead (`interface Eq { Same(o Self) bool }`, iface.self).

// constraintNamesOwnParam reports whether the type parameter tp's constraint
// names tp itself, reporting it at tp when it does.
func constraintNamesOwnParam(c @Checker, tp @ast.TypeParam) bool {
	if isBlank(tp.Name) || !typeExprNames(tp.Constraint, tp.Name) {
		return false
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write("the constraint of type parameter ")
	b.Write(tp.Name)
	b.Write(" names ")
	b.Write(tp.Name)
	b.Write(" itself (an interface's methods take or return the type satisfying it as `Self`)")
	addCheckError(c, tp.Pos, buf.CopyStr(b.String()))
	return true
}

// typeExprNames reports whether the unqualified type name occurs in the type
// expression t: as t, or in its type arguments, element, fields, function types
// or array length.
func typeExprNames(t @ast.TypeExpr, name *[]readonly char) bool {
	if t == nil {
		return false
	}
	if t.Kind == ast.TEXPR_NAMED && len(t.Pkg) == 0 && types.CharEq(t.Name, name) {
		return true
	}
	if typeExprNames(t.Base, name) || exprNamesType(t.Len, name) {
		return true
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		if typeExprNames(t.TypeArgs[i], name) {
			return true
		}
	}
	for i := 0; i < len(t.Fields); i++ {
		if t.Fields[i] != nil && typeExprNames(t.Fields[i].Type, name) {
			return true
		}
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		if typeExprNames(t.ParamTypes[i], name) {
			return true
		}
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		if typeExprNames(t.ResultTypes[i], name) {
			return true
		}
	}
	return false
}

// exprNamesType reports whether a type written in the expression e — an array
// length's sizeof, alignof or cast operand — names the type name.
func exprNamesType(e @ast.Expr, name *[]readonly char) bool {
	if e == nil {
		return false
	}
	if typeExprNames(e.TypeRef, name) {
		return true
	}
	if exprNamesType(e.X, name) || exprNamesType(e.Y, name) || exprNamesType(e.Z, name) {
		return true
	}
	for i := 0; i < len(e.Args); i++ {
		if exprNamesType(e.Args[i], name) {
			return true
		}
	}
	return false
}
