package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_constraint_self.bn: a type parameter's constraint may not name
// the parameter itself.

// A constraint naming its own parameter is rejected once, at the parameter — in
// a generic function, type and interface, whatever instantiates them — and the
// parameter is unconstrained; a constraint naming an earlier parameter is fine.
func TestConstraintNamesOwnParamRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Eq[T any] { Same(o T) bool }\n"
					"func f[T Eq[T]](x T) T { return x }\n"
					"type Box[T Eq[T]] struct { v T }\n"
					"interface G[T Eq[T]] { get() T }\n"
					"func g[K any, T Eq[K]](x T) T { return x }\n"
					"func h() int { var b Box[int]; return f[int](b.v) }\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 3 ||
			errorsContaining(c, "the constraint of type parameter T names T itself") != 3 {
		var msg @[]char = buf.CopyStr("expected three self-constraint errors:")
		for i := 0; i < len(errs); i++ {
			msg = buf.Concat(msg, " | ")
			msg = buf.Concat(msg, errs[i].Msg)
		}
		return fail(msg)
	}
	return ""
}

// A type parameter is in scope in every constraint of its list, a later one's
// too, shadowing a package type of its name: W's and g's `Eq[U]` are Eq of
// their own U — at the declaration, in the method's binders and at an
// instantiation alike.
func TestTypeParamScopeWholeList() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"interface Eq[X any] { Same(o X) bool }\n"
							"type U struct { v int }\n"
							"type P struct { v int }\n"
							"func (p P) Same(o int) bool { return p.v == o }\n"
							"impl P : Eq[int]\n"
							"type W[T Eq[U], U any] struct { t T; u U }\n"
							"func (w *W[A, B]) Check(o B) bool { return w.t.Same(o) }\n"
							"func g[T Eq[U], U any](x T, y U) bool { return x.Same(y) }\n"
							"func f() bool { var w W[P, int]; var p P; return w.Check(3) && g[P, int](p, 3) }\n"))
}

// A constraint naming its own parameter names the parameter even where the
// package declares a type of that name.
func TestConstraintNamesOwnParamOverPackageType() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Eq[X any] { Same(o X) bool }\n"
					"type T struct { v int }\n"
					"func f[T Eq[T]](x T) T { return x }\n")
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "the constraint of type parameter T names T itself") != 1 {
		return fail("expected the self-constraint error")
	}
	return ""
}
