package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/std/strings"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Top-level declaration checking, pass 1: collecting declarations (duplicate
// and reserved names, value embedding, scalar type decls, type-name
// pre-registration).  Pass 2 is in check_decl_pass2.bn; function- and
// method-decl-specific machinery — `.bni` signature matching, method-receiver
// collection, function-body checking, and control-flow termination analysis —
// lives in check_decl_func.bn.

// ============================================================
// Declaration Collection (Pass 1)
// ============================================================

// checkDuplicateDecls reports the names declared more than once among a
// package's declarations decls, group members included: a const, var, func,
// type or interface named twice — in one group, in two groups, or in a group
// and outside one — is reported at the later declaration (spec
// decl.var.redeclare).  It does NOT flag .bni→.bn matches (those are in the
// scope from LoadPackageInterface, not in decls).  Two type declarations of
// one name are checked by checkTypeRedeclaration instead (a `.bni` forward
// `type T` and the `.bn`'s definition are both in decls), and methods
// (DECL_FUNC with Recv != nil) by AddMethod, in their type's method set.
func checkDuplicateDecls(c @Checker, decls *[]@ast.Decl) {
	var named @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	collectNamedDecls(decls, named)
	for i := 0; i < named.Len(); i++ {
		var d @ast.Decl = named.Get(i)
		for j := 0; j < i; j++ {
			var e @ast.Decl = named.Get(j)
			if d.Kind == ast.DECL_TYPE && e.Kind == ast.DECL_TYPE { continue }
			if types.CharEq(e.Name, d.Name) {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write(d.Name)
				cb.Write(" redeclared in this block")
				addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
				break
			}
		}
	}
}

// collectNamedDecls pushes onto out the declarations of decls, and of the
// groups among them, whose names checkDuplicateDecls compares: each named
// one except a blank name (which binds nothing, so several `var _ = ...` are
// never a redeclaration) and a method.
func collectNamedDecls(decls *[]@ast.Decl, out @vec.Vec[@ast.Decl]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			collectNamedDecls(d.Decls, out)
			continue
		}
		if len(d.Name) == 0 || isBlank(d.Name) {
			continue
		}
		if d.Kind == ast.DECL_FUNC && d.Recv != nil {
			continue
		}
		out.Push(d)
	}
}

// checkReservedDeclNames rejects user declarations whose name is reserved
// for compiler-synthesized symbols (see mangle.IsReservedIdentifier): a
// `__`-prefixed name, or one carrying the `__bn_inst__` instantiation
// marker.  Without this, such a name would mangle to the same linker
// symbol as a compiler helper (`__entry`, a closure thunk, a generic
// instantiation), a silent duplicate-symbol miscompilation.  It also
// rejects a method or an interface method named `_`: a method exists to be
// called by name (or to fill an interface's method set), which a blank name
// cannot be.  Iterates one decl level only (groups are reached via
// collectDeclsBody's recursion, like checkDuplicateDecls).  Groups carry no
// name; impls have an empty name — both are skipped by the length guard /
// kind skip.
func checkReservedDeclNames(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var name @[]char = decls[i].Name
		if len(name) == 0 { continue }
		if decls[i].Kind == ast.DECL_GROUP { continue }
		if decls[i].Kind == ast.DECL_FUNC && decls[i].Recv != nil && isBlank(name) {
			addCheckError(c, decls[i].Pos, "a method cannot be named _")
		}
		if decls[i].Kind == ast.DECL_INTERFACE && !decls[i].IsAlias {
			for j := 0; j < len(decls[i].Decls); j++ {
				var m @ast.Decl = decls[i].Decls[j]
				if m != nil && isBlank(m.Name) {
					addCheckError(c, m.Pos, "an interface method cannot be named _")
				}
			}
		}
		if mangle.IsReservedIdentifier(name) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(name)
			cb.Write(": reserved identifier (names beginning with \"__\" or ")
			cb.Write("containing \"__bn_inst__\" are reserved for the compiler)")
			addCheckError(c, decls[i].Pos, buf.CopyStr(cb.String()))
		}
	}
}

// collectDecls runs pass 1: registers type names and top-level const
// placeholders, then collects type/func/var symbols.
//
// preRegisterTypeNames runs once here (it already recurses into groups, and
// re-running it would double-append generic type decls).  On the batch path
// the declarations form a DeclBatch (check_decl_batch.bn): top-level consts are
// resolved in dependency order once the rest is collected (finishDeclBatch,
// which the caller runs after checkValueEmbedding), or when first read — a
// struct field array dimension reads its folded value regardless of source
// order.  The REPL path (TentativeMode) keeps its park/retry resolution;
// collectDeclsBody registers const placeholders for it instead.
func collectDecls(c @Checker, decls *[]@ast.Decl) {
	// Enforce the no-full-redeclaration rule on the source decl list before
	// resolution (see check_type_redecl.bn).
	checkTypeRedeclaration(c, decls)
	preRegisterTypeNames(c, decls)
	preRegisterInterfaces(c, decls)
	var savedAliases @PendingAliases = beginPendingAliases(c, decls, nil)
	if !c.ReplDeclMode {
		c.Batch = newDeclBatch(decls)
		// A top-level const's declared type may be a named distinct
		// scalar (`const C Rate = 0.5` over `type Rate float64`).  A const
		// read during collection is resolved then and needs that type's
		// underlying to validate the const is scalar and the value
		// assignable, but collectDeclsBody — which sets underlyings — may
		// not have reached it.  Fill in the underlyings that can't depend on
		// a const (named types whose chain ends at a builtin scalar) here
		// first.
		resolveBuiltinScalarTypeDecls(c, decls)
		beginTopLevelConsts(c, decls)
	}
	// Defer generic-instantiation constraint checks across the batch collection so
	// they see the package's COMPLETE impl set regardless of source order — a
	// `func F() @Box[Item]` may precede `impl Item : Sizer` (see
	// Checker.CollectingDecls).  The REPL keeps its inline/park behavior.
	var savedCollecting bool = c.CollectingDecls
	if !c.ReplDeclMode {
		c.CollectingDecls = true
	}
	var conflictMark int = len(c.DeferredIfaceConflictDecls)
	checkDuplicateDecls(c, decls)
	if c.Batch != nil {
		c.Batch.Collecting = true
	}
	collectDeclsBody(c, decls)
	if c.Batch != nil {
		c.Batch.Collecting = false
	}
	endPendingAliases(c, savedAliases)
	resolvePendingIfaceParents(c)
	runDeferredIfaceConflicts(c, conflictMark)
	c.CollectingDecls = savedCollecting
	// Now that every generic-receiver method is attached to its placeholder,
	// re-sync any generic-struct instantiation that was cached method-less
	// because it was forced (by a var/field/param/receiver type) earlier in this
	// pass, before its method decls were reached.  Runs before pass 2 (body
	// check) so an intra-body `.Method()` call resolves.
	backfillInstantiationMethods(c)
	// Fire the constraint checks deferred above, now that collectDeclsBody has
	// recorded every impl (order-independent — see recheckDeferredConstraints).
	if !c.ReplDeclMode {
		recheckDeferredConstraints(c)
	}
	if !c.ReplDeclMode {
		// Record the dependency order of top-level var initializers so IR-gen
		// emits them in an order where each initializer's package-var
		// dependencies run first (rather than filename-then-source order).
		// The REPL initializes one var at a time — no batch to order.
		resolveTopLevelVarOrder(c, decls)
	}
}

// checkValueEmbedding rejects an opaque type embedded BY VALUE in a struct
// value field or a by-value function parameter / return.  It runs AFTER
// collectDecls, when forward references are filled in place — so a TYP_NAMED
// placeholder is now either concrete or a genuine opaque type.  Checking
// these sites inline during collection would race forward-reference
// resolution: a `type Whence int` used before its decl is a not-yet-resolved
// placeholder (nil-Underlying TYP_NAMED), byte-identical to an opaque type.
// Var decls are checked in pass 2 by checkVarDecl (also post-collection).
//
// Generic decls are skipped — a type-parameter field/param isn't opaque, and
// re-resolving a generic signature here (its type-param scope is no longer
// installed) would spuriously fail — except that a generic struct is checked
// for holding itself by value (checkGenericStructValueCycle).  A
// concrete-opaque field in a generic decl
// (`type Box[T any] struct { v Opaque }`) is still caught: it is reached when
// the generic is INSTANTIATED and used by value (requireSizedType recurses the
// instantiated struct via embedsOpaqueByValue), and a pointer to such an
// instantiation is rejected too (pointeeEmbedsOpaque) — an unused generic is
// benign.  Re-resolving each type expression is side-effect-free
// (resolveTypeExpr reads the scope / builds throwaway Type values) and there
// are no methods on generic types in the tree, so receiver/param resolution
// needs no type-param scope.
func checkValueEmbedding(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		// File-scoped imports: field/param/result types may be qualified, so
		// resolve under this decl's file scope (see checkPackageImpl).
		if fileScopedActive(c) {
			c.Scope = scopeForFile(c, d.Pos.File)
		}
		if d.Kind == ast.DECL_GROUP {
			checkValueEmbedding(c, d.Decls)
			continue
		}
		if len(d.TypeParams) > 0 {
			checkGenericStructValueCycle(c, d)
			continue
		}
		// A method on a generic type binds the type's parameters; its param /
		// result types reference those binders, which are not in scope here, so
		// resolving them for the sizing check would spuriously report `undefined:
		// T`. Its sizing is enforced per concrete instantiation, exactly as a
		// generic function's is — skip it here.
		if d.Kind == ast.DECL_FUNC && d.Recv != nil && receiverBaseInstantiation(d.Recv.Type) != nil {
			continue
		}
		// Reject a type whose underlying STRUCT or ARRAY contains itself BY VALUE
		// (`type C struct { self C }`, `type C [2]C`, or through a named-distinct
		// wrapper `type C struct { d D }; type D C`).  Runs here (post-collection)
		// rather than in collectTypeDecl so EVERY named type's underlying is filled —
		// a wrapper cycle is then visible regardless of decl order.  Must precede the
		// requireSizedType walk below (and IR-gen's size/destruction/ABI walks), which
		// recurse through by-value fields/elements and would otherwise stack-overflow;
		// checkTypeByValueCycle poisons the offending field/element so those walks
		// terminate.  Runs for every type decl (an array/struct underlying may be
		// reached only through a named-distinct wrapper decl).
		if d.Kind == ast.DECL_TYPE {
			var tsym @Symbol = c.Scope.Lookup(d.Name)
			if tsym != nil {
				checkTypeByValueCycle(c, tsym.Type, d)
			}
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			for j := 0; j < len(d.TypeRef.Fields); j++ {
				requireSizedType(c, resolveTypeExpr(c, d.TypeRef.Fields[j].Type), d.Pos)
			}
		}
		if d.Kind == ast.DECL_FUNC {
			for j := 0; j < len(d.Params); j++ {
				requireSizedType(c, resolveTypeExpr(c, d.Params[j].Type), d.Pos)
			}
			for j := 0; j < len(d.Results); j++ {
				requireSizedType(c, resolveTypeExpr(c, d.Results[j]), d.Pos)
			}
		}
	}
}

// collectDeclsBody is the per-level collection loop (also the target of the
// grouped-decl recursion).  Const names are forward-registered here only on
// the REPL path; on the batch path beginTopLevelConsts (run once in
// collectDecls) already registered them.
func collectDeclsBody(c @Checker, decls *[]@ast.Decl) {
	// Check for duplicate declarations.  In the multi-file CheckPackage path
	// `decls` is the whole merged list, so this catches cross-file
	// duplicates (it ran package-wide before file-scoping too).
	checkReservedDeclNames(c, decls)

	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		// File-scoped imports: resolve this decl's qualifiers against only
		// its own file's imports.  Package symbols still land in
		// c.PackageScope (the file scope delegates defines upward).
		if fileScopedActive(c) {
			c.Scope = scopeForFile(c, d.Pos.File)
		}
		if d.Kind == ast.DECL_FUNC {
			if d.Recv != nil {
				collectMethodDecl(c, d)
			} else {
				var ft @types.Type = resolveFuncDeclType(c, d)
				// Check .bni → .bn signature match: if the function was already
				// declared (from .bni), verify the .bn definition matches.
				checkBniSignatureMatch(c, d, ft)
				defineFunc(c.Scope, d.Name, ft)
				d.ResolvedTypeID = registerExprType(c, ft)
			}
		}
		if d.Kind == ast.DECL_TYPE {
			collectBatchTypeDecl(c, d)
		}
		if d.Kind == ast.DECL_VAR {
			// A blank var binds no name; don't enter `_` into scope (its
			// initializer is still checked/run for side effects — see
			// checkVarDecl / buildInitBody).
			if d.TypeRef != nil && !isBlank(d.Name) {
				var typ @types.Type = resolveTypeExpr(c, d.TypeRef)
				capturePendingIfSized(c, typ)
				// If a `.bni` declared this var (extern), verify the `.bn`
				// definition's type agrees — an importer reads the type
				// from the `.bni`, so a mismatch would misread the storage.
				// (One defined on demand is in scope as that definition.)
				if !varDefinedOnDemand(c, d) {
					checkBniVarMatch(c, d, typ)
				}
				defineVar(c.Scope, d.Name, typ)
			}
		}
		if d.Kind == ast.DECL_CONST && d.Value != nil {
			if c.ReplDeclMode {
				registerOneConstPlaceholder(c, d)
			}
		}
		if d.Kind == ast.DECL_GROUP {
			if c.ReplDeclMode {
				for j := 0; j < len(d.Decls); j++ {
					if d.Decls[j].Kind == ast.DECL_CONST {
						registerGroupConstPlaceholder(c, d.Decls[j])
					}
				}
			}
			collectDeclsBody(c, d.Decls)
		}
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceDecl(c, d)
		}
		if d.Kind == ast.DECL_IMPL {
			collectImplDecl(c, d)
		}
	}
}

// preRegisterTypeNames creates placeholder named types for all type
// declarations (enables forward refs).  Only the package scope is consulted
// for an existing symbol: a package-level type may shadow a predeclared one
// (`type int16 int8`), and a reference to that name anywhere in the package,
// before its declaration included, must reach the package's type, not the
// universe's.  Generic struct decls
// (DECL_TYPE with non-empty TypeParams) register a placeholder
// alongside their AST entry in c.GenericTypeDecls so use sites
// can find the source decl when instantiating.
func preRegisterTypeNames(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		// A blank `type _ …` binds no name (collectTypeDecl still checks its type).
		if d.Kind == ast.DECL_TYPE && isBlank(d.Name) {
			checkTypeParamNamesDistinct(c, d)
			continue
		}
		if d.Kind == ast.DECL_TYPE {
			if pkgScopeLookupLocal(c, d.Name) == nil {
				var placeholder @types.Type = types.MakeNamedType(d.Name)
				placeholder.Pkg = buf.CopyStr(c.curPkgPath)
				defineType(c.Scope, d.Name, placeholder)
			}
			if len(d.TypeParams) > 0 {
				checkTypeParamNamesDistinct(c, d)
				if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
					checkStructFieldNamesDistinct(c, d.TypeRef)
				}
				c.GenericTypeDecls = slices.Append[@ast.Decl](
						c.GenericTypeDecls, d)
				// Key on the FULL package path (matching bni_scope's stash),
				// so same-final-segment packages' generic structs stay
				// distinct; same-package unqualified lookups go through
				// lookupGenericTypeDeclPkg's curPkgPath fallback.
				c.GenericTypeDeclPkgs = slices.Append[@[]char](
						c.GenericTypeDeclPkgs, buf.CopyStr(c.curPkgPath))
				// Record this generic's defining-file import scope so its
				// body's qualified field types resolve against THIS file's
				// imports at the instantiation site (see populateInstantiated*).
				c.GenericTypeDeclScopes = slices.Append[@Scope](
						c.GenericTypeDeclScopes, scopeForFile(c, d.Pos.File))
			}
		}
		if d.Kind == ast.DECL_GROUP {
			preRegisterTypeNames(c, d.Decls)
		}
	}
}
