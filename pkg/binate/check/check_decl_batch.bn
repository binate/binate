package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Package-level declarations resolved on demand (spec decl.order.forward).
// collectDecls collects a package's type, function and variable declarations;
// its top-level constants are resolved afterwards (finishDeclBatch, once
// checkValueEmbedding has broken any type that holds itself by value), so a
// constant may take the layout of any of the package's types (`sizeof`,
// `alignof`) or the type of any of its variables (`len`).  A declaration needed
// before its turn is resolved when it is first read: a constant that an array
// length reads during collection (batchConstOnDemand); the types whose layout a
// `sizeof` / `alignof` takes during collection (prepareLayout,
// check_decl_layout.bn); and a variable whose type is inferred from its
// initializer, which pass 2 would otherwise define only when it reaches it
// (batchVarOnDemand); and a function or method an array length calls
// (batchFuncOnDemand, batchMethodOnDemand).

// DeclBatch is the package-level declaration batch collectDecls is checking.
type DeclBatch struct {
	// ConstNames / ConstDecls list the top-level constants — a group member
	// with its group — and Blanks the blank `const _ = …` declarations.
	ConstNames @[]@[]char
	ConstDecls @[]@ast.Decl
	Blanks     @[]@ast.Decl
	// ConstCycleMembers lists the constants on a definition cycle already
	// reported.
	ConstCycleMembers @[]@[]char
	// DeclStarts lists the declarations being resolved — constants,
	// variables, functions and methods — innermost last, and DeclReadWaited is
	// true once a read of one has waited for it, until the outermost is
	// resolved (check_layout_wait_decl.bn).
	DeclStarts     @[]declStart
	DeclReadWaited bool
	// ConstsOpen is true while a constant may be unresolved: from the start
	// of collection to the end of finishDeclBatch.
	ConstsOpen bool
	// Types lists the non-generic named type declarations (not forward
	// ones); Collecting is true while collectDeclsBody runs, when a type may
	// not be collected yet.  TypesCollecting are the ones being collected,
	// TypesCollected the ones collected on demand (before their turn),
	// TypesWalking the ones whose by-value types are being prepared, and
	// TypesPrepared the ones collected with every type they hold by value.
	Types           @vec.Vec[@ast.Decl]
	Collecting      bool
	TypesCollecting @[]@ast.Decl
	TypesCollected  @vec.Vec[@ast.Decl]
	TypesWalking    @[]@ast.Decl
	TypesPrepared   @vec.Vec[@ast.Decl]
	// IfacesCollecting lists the interface declarations being collected, and
	// IfacesCollected the ones collected — in their turn or on demand, before
	// it (check_member_read.bn).
	IfacesCollecting @[]@ast.Decl
	IfacesCollected  @vec.Vec[@ast.Decl]
	// Vars lists the non-blank variable declarations; VarsChecking the ones
	// with an inferred type whose declaration is being checked (VarsCheckingLens
	// the array length depth each one's check began at), VarsChecked
	// the ones checked, VarsResolving the ones whose declared type is being
	// resolved, VarsHeadTyping the ones whose type is being taken from their
	// initializer's head, and VarsDefined the ones with a declared type
	// defined on demand, before collection reached them.  VarsOpen is true
	// from the start of collection: a variable may be defined on demand.
	Vars             @vec.Vec[@ast.Decl]
	VarsOpen         bool
	VarsChecking     @[]@ast.Decl
	VarsCheckingLens @[]int
	VarsChecked      @vec.Vec[@ast.Decl]
	VarsResolving    @[]@ast.Decl
	VarsHeadTyping   @[]@ast.Decl
	VarsDefined      @[]@ast.Decl
	// Placeholders lists the placeholders the variables named while their
	// type was being found were defined with, PlaceholderReads logs the
	// variables of those read (ReadLens the array length depth of each read,
	// LenDepth the number of array lengths being evaluated), PoisonedBy those
	// that left an array length's operand in error, VarsCycled the variables
	// whose type cycle is reported (CycleErrors counting its errors), and
	// SilentPoisons counts the array lengths left without a value by another
	// declaration's error (check_var_placeholder.bn).  InitVarNames lists the
	// variables the initialization order visited, and InitVarDeps the names
	// each one's initializer reads (resolveTopLevelVarOrder).
	Placeholders     @[]varPlaceholder
	PlaceholderReads @[]@ast.Decl
	ReadLens         @[]int
	LenDepth         int
	PoisonedBy       @[]@ast.Decl
	VarsCycled       @[]@ast.Decl
	CycleErrors      int
	SilentPoisons    int
	InitVarNames     @[]@[]char
	InitVarDeps      @[]@[]@[]char
	// VarsDeferred lists the variables with an inferred type whose check
	// while types were collected had errors, checked again after collection.
	VarsDeferred @[]@ast.Decl
	// Funcs lists the package-level functions (not methods); FuncsDefined the
	// ones defined on demand, before collection reached them, and
	// FuncsDefining the ones being defined so (batchFuncOnDemand).
	Funcs         @vec.Vec[@ast.Decl]
	FuncsDefined  @[]@ast.Decl
	FuncsDefining @[]@ast.Decl
	// Methods lists the methods; MethodsCollected the ones collection reached,
	// MethodsDefined the ones defined on demand before it did, with MethodsUndo
	// the method sets' state before each, and MethodsDefining the ones being
	// defined (batchMethodOnDemand, check_decl_batch_method.bn).
	Methods          @vec.Vec[@ast.Decl]
	MethodsCollected @vec.Vec[@ast.Decl]
	MethodsDefined   @[]@ast.Decl
	MethodsUndo      @[]@DeclRollback
	MethodsDefining  @[]@ast.Decl
	// Pkg is the path of the package whose declarations these are.
	Pkg @[]char
}

// newDeclBatch returns the batch of the package-level declarations decls of
// the package pkg.
func newDeclBatch(pkg *[]readonly char, decls *[]@ast.Decl) @DeclBatch {
	var b @DeclBatch = make(DeclBatch)
	b.Pkg = buf.CopyStr(pkg)
	b.Types = vec.New[@ast.Decl]()
	b.TypesPrepared = vec.New[@ast.Decl]()
	b.TypesCollected = vec.New[@ast.Decl]()
	b.IfacesCollected = vec.New[@ast.Decl]()
	b.Vars = vec.New[@ast.Decl]()
	b.VarsChecked = vec.New[@ast.Decl]()
	b.Funcs = vec.New[@ast.Decl]()
	b.Methods = vec.New[@ast.Decl]()
	b.MethodsCollected = vec.New[@ast.Decl]()
	listBatchDecls(b, decls)
	return b
}

// listBatchDecls records decls' type, variable, function and method
// declarations in b, groups included.
func listBatchDecls(b @DeclBatch, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			listBatchDecls(b, d.Decls)
			continue
		}
		if isBlank(d.Name) {
			continue
		}
		if d.Kind == ast.DECL_TYPE && len(d.TypeParams) == 0 && !d.IsForward {
			b.Types.Push(d)
		}
		if d.Kind == ast.DECL_VAR {
			b.Vars.Push(d)
		}
		if d.Kind == ast.DECL_FUNC && d.Recv == nil {
			b.Funcs.Push(d)
		}
		if d.Kind == ast.DECL_FUNC && d.Recv != nil {
			b.Methods.Push(d)
		}
	}
}

// finishDeclBatch checks again the variables deferred during collection
// (recheckDeferredVars), then resolves the batch's top-level constants that
// nothing has read yet — now that every type, function and variable
// declaration is collected and no type holds itself by value — and closes
// constant resolution.
func finishDeclBatch(c @Checker) {
	if c.Batch == nil {
		return
	}
	recheckDeferredVars(c)
	finishTopLevelConsts(c)
	c.Batch.ConstsOpen = false
}

// lookupDeclOnDemand looks name up in the current scope, first resolving the
// batch's constant, variable or function name if it is not resolved yet.  A name
// found only in the universe may be such a variable or function — `var y = panic`
// read before `var panic = say` is defined — which shadows the predeclared binding
// in the whole package.  A read of a placeholder is counted
// (notePlaceholderRead).
func lookupDeclOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var sym @Symbol = resolveDeclOnDemand(c, name)
	notePlaceholderRead(c, sym)
	return sym
}

// resolveDeclOnDemand is lookupDeclOnDemand's lookup.
func resolveDeclOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var sym @Symbol = c.Scope.Lookup(name)
	if sym == nil {
		var v @Symbol = batchVarOnDemand(c, name)
		if v != nil { return v }
		return batchFuncOnDemand(c, name)
	}
	if c.Batch != nil && c.Batch.VarsOpen && isUniverseSymbol(c, sym) {
		var v @Symbol = batchVarOnDemand(c, name)
		if v != nil { return v }
		var f @Symbol = batchFuncOnDemand(c, name)
		if f != nil { return f }
	}
	if sym.Kind == types.SYM_CONST && !sym.HasCVal && batchConstOnDemand(c, name) {
		return c.Scope.Lookup(name)
	}
	return sym
}

// batchConstOnDemand resolves the batch's top-level constant name if it is not
// resolved yet: a constant read before finishDeclBatch reaches it, by an array
// length during collection or by a declaration checked on demand.  Reports
// whether it resolved it now.  A constant read while it is being resolved is a
// cycle, which resolveConstByName reports.
func batchConstOnDemand(c @Checker, name *[]readonly char) bool {
	var b @DeclBatch = c.Batch
	if b == nil || !b.ConstsOpen || nameInList(c.ConstResolved, name) ||
			!nameInList(b.ConstNames, name) {
		return false
	}
	var saved declContext = enterPackageDecl(c, findConstDecl(b.ConstNames, b.ConstDecls, name))
	resolveConstByName(c, buf.CopyStr(name), b.ConstNames, b.ConstDecls)
	leavePackageDecl(c, saved)
	return true
}

// batchFuncOnDemand defines the batch's function name, generic or not, which
// collection has not reached yet, and returns its symbol (nil when name is no
// such function): a declaration collected before it may call it — an array
// length `[len(f())]T` or `[len(g[int]())]T`, whose length is its operand's
// type's (builtin.len).
// Collection then leaves it as defined.  One named while its own signature is
// being resolved is not defined again: its use reports it undefined, or waits
// when inside a build that signature started (declReadWaits).  A
// definition that reads a layout not built yet, inside an instance's build
// (enterDemandFrame), is undone, to be made again when the function is next
// named or collection reaches it; none is made inside a build that waits
// already (skipDemand).
func batchFuncOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var b @DeclBatch = c.Batch
	if b == nil || !b.Collecting {
		return nil
	}
	var d @ast.Decl = findDeclIn(b.Funcs, name)
	if d == nil || declInList(b.FuncsDefined, d) {
		return nil
	}
	if declInList(b.FuncsDefining, d) {
		_ = declReadWaits(c, d)
		return nil
	}
	if skipDemand(c) {
		return nil
	}
	var saved declContext = enterPackageDecl(c, d)
	var ds @Scope = declScope(c)
	var prev @Symbol = ds.LookupLocal(d.Name)
	var framed bool = enterDemandFrame(c)
	var readWaited bool = defineBatchFunc(c, d)
	if leaveDemandFrame(c, framed) {
		restoreBinding(ds, d.Name, prev)
		ast.ClearCheckerAnnotations(d)
		leavePackageDecl(c, saved)
		return nil
	}
	leavePackageDecl(c, saved)
	b.FuncsDefined = slices.Append[@ast.Decl](b.FuncsDefined, d)
	if readWaited {
		flushLayoutWaits(c)
	}
	return c.Scope.Lookup(name)
}

// defineBatchFunc defines the batch's function d (collectFuncDecl) — on demand or
// when collection reaches it — marked as being defined meanwhile, so a use of it
// in its own signature is declined (batchFuncOnDemand), and reports whether a
// read waited for a declaration being resolved (leaveDeclResolution): the
// caller then flushes the layout waits, once the definition is kept.
func defineBatchFunc(c @Checker, d @ast.Decl) bool {
	var b @DeclBatch = c.Batch
	b.FuncsDefining = slices.Append[@ast.Decl](b.FuncsDefining, d)
	enterDeclResolution(c, d)
	collectFuncDecl(c, d)
	b.FuncsDefining = b.FuncsDefining[:len(b.FuncsDefining) - 1]
	return leaveDeclResolution(c)
}

// declContext is the checker state that belongs to the declaration or
// function body being checked; checking another package-level declaration on
// demand saves it (enterPackageDecl) and restores it (leavePackageDecl).
type declContext struct {
	scope      @Scope
	funcRet    @[]@types.Type
	iota       int
	inLoop     bool
	inSwitch   bool
	inDefer    bool
	captures   @[]@CaptureFrame
	untyped    @vec.Vec[@ast.Expr]
	expectedFV @types.Type
	borrowPos  int
	bareMember bool
	bareIota   int
}

// enterPackageDecl saves the checker's declaration state and sets it up for
// checking the package-level declaration d: d's file scope, outside any
// function, loop, constant group or function literal.
func enterPackageDecl(c @Checker, d @ast.Decl) declContext {
	var s declContext
	s.scope = c.Scope
	s.funcRet = c.FuncRet
	s.iota = c.Iota
	s.inLoop = c.InLoop
	s.inSwitch = c.InSwitch
	s.inDefer = c.InDefer
	s.captures = c.CaptureStack
	s.untyped = c.UntypedNonConst
	s.expectedFV = c.ExpectedFVType
	s.borrowPos = c.BorrowPosKind
	s.bareMember = c.InGroupBareMember
	s.bareIota = c.BareExplicitIota
	c.Scope = c.PackageScope
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, d.Pos.File)
	}
	var noRet @[]@types.Type
	c.FuncRet = noRet
	c.Iota = -1
	c.InLoop = false
	c.InSwitch = false
	c.InDefer = false
	var noCaptures @[]@CaptureFrame
	c.CaptureStack = noCaptures
	c.UntypedNonConst = nil
	c.ExpectedFVType = nil
	c.BorrowPosKind = POS_STORING
	c.InGroupBareMember = false
	c.BareExplicitIota = 0
	return s
}

// leavePackageDecl restores the declaration state enterPackageDecl saved.
func leavePackageDecl(c @Checker, s declContext) {
	c.Scope = s.scope
	c.FuncRet = s.funcRet
	c.Iota = s.iota
	c.InLoop = s.inLoop
	c.InSwitch = s.inSwitch
	c.InDefer = s.inDefer
	c.CaptureStack = s.captures
	c.UntypedNonConst = s.untyped
	c.ExpectedFVType = s.expectedFV
	c.BorrowPosKind = s.borrowPos
	c.InGroupBareMember = s.bareMember
	c.BareExplicitIota = s.bareIota
}

// findDeclIn returns the declaration named name in ds, or nil.
func findDeclIn(ds @vec.Vec[@ast.Decl], name *[]readonly char) @ast.Decl {
	for i := 0; i < ds.Len(); i++ {
		if types.CharEq(ds.Get(i).Name, name) {
			return ds.Get(i)
		}
	}
	return nil
}

// declInVec reports whether d is in ds.
func declInVec(ds @vec.Vec[@ast.Decl], d @ast.Decl) bool {
	for i := 0; i < ds.Len(); i++ {
		if same(ds.Get(i), d) {
			return true
		}
	}
	return false
}

// declInList reports whether d is in ds.
func declInList(ds *[]@ast.Decl, d @ast.Decl) bool {
	for i := 0; i < len(ds); i++ {
		if same(ds[i], d) {
			return true
		}
	}
	return false
}
