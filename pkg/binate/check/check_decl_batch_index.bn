package "pkg/binate/check"

import "pkg/binate/ast"

// The batch's declarations by name: each list of a kind holds, in an index of it, the
// first declaration of each name, so a declaration is found by name in time
// independent of how many there are.

// batchTypeDecl returns the first of b's type declarations (b.Types) named name, or
// nil.
func batchTypeDecl(b @DeclBatch, name *[]readonly char) @ast.Decl {
	i, found := b.TypeIndex.Get(name)
	if !found { return nil }
	return b.Types.Get(i)
}

// batchVarDecl returns the first of b's variable declarations (b.Vars) named name, or
// nil.
func batchVarDecl(b @DeclBatch, name *[]readonly char) @ast.Decl {
	i, found := b.VarIndex.Get(name)
	if !found { return nil }
	return b.Vars.Get(i)
}

// batchFuncDecl returns the first of b's function declarations (b.Funcs) named name,
// or nil.
func batchFuncDecl(b @DeclBatch, name *[]readonly char) @ast.Decl {
	i, found := b.FuncIndex.Get(name)
	if !found { return nil }
	return b.Funcs.Get(i)
}
