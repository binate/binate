package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_decl_batch_index.bn.

// batchIndexDecl returns a declaration of kind named name.
func batchIndexDecl(kind int, name *[]readonly char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = kind
	d.Name = buf.CopyStr(name)
	return d
}

// A batch finds the first declaration of a name among its types, variables and
// functions, a group's members included, and none of a name it does not declare.
func TestBatchDeclsByName() testing.TestResult {
	var group @ast.Decl = batchIndexDecl(ast.DECL_GROUP, "")
	group.Decls = make_slice(@ast.Decl, 2)
	group.Decls[0] = batchIndexDecl(ast.DECL_VAR, "v")
	group.Decls[1] = batchIndexDecl(ast.DECL_VAR, "v")
	var decls @[]@ast.Decl = make_slice(@ast.Decl, 4)
	decls[0] = batchIndexDecl(ast.DECL_TYPE, "T")
	decls[1] = group
	decls[2] = batchIndexDecl(ast.DECL_FUNC, "f")
	decls[3] = batchIndexDecl(ast.DECL_FUNC, "f")
	var b @DeclBatch = newDeclBatch("main", decls)
	if !same(batchTypeDecl(b, "T"), decls[0]) { return fail("the type T") }
	if !same(batchVarDecl(b, "v"), group.Decls[0]) { return fail("the first var v") }
	if !same(batchFuncDecl(b, "f"), decls[2]) { return fail("the first func f") }
	if batchVarDecl(b, "T") != nil || batchFuncDecl(b, "v") != nil || batchTypeDecl(b, "f") != nil {
		return fail("a name of another kind is no declaration of this one")
	}
	return ""
}
