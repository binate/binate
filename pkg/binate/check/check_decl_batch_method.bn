package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Methods attached on demand while a package's declarations are collected
// (spec decl.order.forward).  Collection attaches a method to its receiver's
// type when it reaches the method's declaration, in source order, and gives an
// instance of a generic type the generic's methods when the instance is built
// and again once collection is done (backfillInstantiationMethods).  A
// declaration collected before that may already select the method — an array
// length `[len(s.mk())]T`, whose length is its operand's type's (builtin.len) —
// so a method looked up then and not found is attached first
// (batchMethodOnDemand, from lookupVisibleMethod).

// collectBatchMethodDecl collects the method d when collection reaches it,
// unless it was defined on demand before.  It is recorded as collected before
// the layout waits its definition left are flushed: a build the flush makes may
// select d through an instance whose copy of the generic's methods is being made
// (`interface J[T any] { k() [len(hv.m())]uint8 }`, read again by m's copied
// signature through `type W[T any] struct { j *J[T] }`), and that read waits for
// the copy (methodCopyReadWaits) — taken for a method collection has not reached,
// d would be defined on demand a second time, "method m redeclared".
func collectBatchMethodDecl(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	if b == nil {
		collectMethodDecl(c, d)
		return
	}
	var flush bool = !declInList(b.MethodsDefined, d) && defineBatchMethod(c, d)
	b.MethodsCollected.Push(d)
	if flush {
		flushLayoutWaits(c)
	}
}

// defineBatchMethod defines the batch's method d (collectMethodDecl) — on
// demand or when collection reaches it — marked as being defined meanwhile, so
// a selection of it in its own signature is declined (batchMethodOnDemand), and
// reports whether a read waited for a declaration being resolved
// (leaveDeclResolution): the caller then flushes the layout waits, once the
// definition is kept.
func defineBatchMethod(c @Checker, d @ast.Decl) bool {
	var b @DeclBatch = c.Batch
	b.MethodsDefining = slices.Append[@ast.Decl](b.MethodsDefining, d)
	enterDeclResolution(c, d)
	collectMethodDecl(c, d)
	b.MethodsDefining = b.MethodsDefining[:len(b.MethodsDefining) - 1]
	return leaveDeclResolution(c)
}

// batchMethodOnDemand returns the method name of the named type named,
// attached now because the batch's declarations are being collected, or nil.
// An instance of one of the batch's generic types first takes the methods its
// generic has so far; failing that, the batch's method name of named (of its
// generic, for an instance) is defined, when collection has not reached it.
// Collection then leaves it as defined.  One selected while its own signature
// is being resolved is not defined again: its use reports it undefined, or
// waits when inside a build that signature started (batchMethodDeclFor).  A
// definition that reads a layout not built yet, inside an instance's build
// (enterDemandFrame), is taken back with what it defined on demand
// (undoBatchMethods), to be made again when the method is next selected or
// collection reaches it; none is made inside a build that waits already
// (skipDemand).
func batchMethodOnDemand(c @Checker, named @types.Type, name *[]readonly char) @types.Method {
	var b @DeclBatch = c.Batch
	if b == nil || !b.Collecting || named == nil || named.Kind != types.TYP_NAMED ||
			!types.CharEq(c.curPkgPath, b.Pkg) {
		return nil
	}
	var gd @ast.Decl = batchGenericOf(c, named)
	if gd != nil {
		attachInstanceMethods(c, named)
		var m @types.Method = named.LookupMethod(name)
		if m != nil { return m }
	}
	var d @ast.Decl = batchMethodDeclFor(c, named, gd, name)
	if d == nil || skipDemand(c) {
		return nil
	}
	// Recorded once defined: a check deferred while it is being defined (its
	// signature reads a variable) takes back only what it defined itself.
	var saved declContext = enterPackageDecl(c, d)
	var undo @DeclRollback = snapshotDecl(c, d)
	var defined int = len(b.MethodsDefined)
	var generics @[]@GenericMethodEntry = c.GenericMethods
	var framed bool = enterDemandFrame(c)
	var readWaited bool = defineBatchMethod(c, d)
	var waited bool = leaveDemandFrame(c, framed)
	leavePackageDecl(c, saved)
	b.MethodsDefined = slices.Append[@ast.Decl](b.MethodsDefined, d)
	b.MethodsUndo = slices.Append[@DeclRollback](b.MethodsUndo, undo)
	if gd != nil {
		attachInstanceMethods(c, named)
	}
	if waited {
		undoBatchMethods(c, defined, generics)
		ast.ClearCheckerAnnotations(d)
		return nil
	}
	if readWaited {
		flushLayoutWaits(c)
	}
	return named.LookupMethod(name)
}

// batchGenericOf returns the generic type declaration of the package being
// collected that named is an instance of, or nil.
func batchGenericOf(c @Checker, named @types.Type) @ast.Decl {
	if named.InstDecl == nil {
		return nil
	}
	var gd @ast.Decl = bit_cast(@ast.Decl, named.InstDecl)
	if !same(lookupGenericTypeDeclPkg(c, "", gd.Name), gd) {
		return nil
	}
	return gd
}

// batchMethodDeclFor returns the batch's first method declaration name of named
// — of the generic type gd, for an instance of it — when collection has not
// reached it and it is not being defined, or nil; one being defined, selected
// inside a build its definition started, makes that build wait for it
// (declReadWaits).  Receivers are looked up in
// the package scope (methodBaseTypeForDecl looks in c.Scope), whatever scope
// the selection is checked in: a generic function's type parameters, a
// function literal's body.
func batchMethodDeclFor(c @Checker, named @types.Type, gd @ast.Decl,
		name *[]readonly char) @ast.Decl {
	var b @DeclBatch = c.Batch
	var found @ast.Decl
	var savedScope @Scope = c.Scope
	c.Scope = c.PackageScope
	for i := 0; i < b.Methods.Len(); i++ {
		var d @ast.Decl = b.Methods.Get(i)
		if types.CharEq(d.Name, name) && methodDeclOf(c, d, named, gd) {
			found = d
			break
		}
	}
	c.Scope = savedScope
	if found == nil || declInVec(b.MethodsCollected, found) || declInList(b.MethodsDefined, found) {
		return nil
	}
	if declInList(b.MethodsDefining, found) {
		_ = declReadWaits(c, found)
		return nil
	}
	return found
}

// methodDeclOf reports whether the method declaration d is one of named's
// methods — of the generic type gd, when named is an instance of it.
func methodDeclOf(c @Checker, d @ast.Decl, named @types.Type, gd @ast.Decl) bool {
	var inst @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
	if gd != nil {
		return inst != nil && inst.Base != nil && types.CharEq(inst.Base.Name, gd.Name)
	}
	return inst == nil && same(methodBaseTypeForDecl(c, d), named)
}

// attachInstanceMethods gives the instance named the methods its generic has
// now (copyPlaceholderMethods) — on demand during collection
// (batchMethodOnDemand) and the back-fill (backfillMethodOnDemand) — unless the
// back-fill at the end of collection would not give them
// (backfillInstantiationMethods): its members are deferred, its layout is
// blocked, or it belongs to an infinite family, which that back-fill reports.
// Nor while they are being copied onto it: a copied
// signature selecting one not copied yet reports it undefined, and a build the
// copy started that selects one waits for them (methodCopyReadWaits).
func attachInstanceMethods(c @Checker, named @types.Type) {
	if containsTypePtr(instanceState(c).MethodsCopying, named) {
		return
	}
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry == nil || !same(entry.Result, named) {
			continue
		}
		if entry.MembersDeferred || entry.LayoutBlocked ||
				!typeArgsAbstract(entry.TypeArgs) && genericExpanding(c, entry.Decl) {
			return
		}
		copyPlaceholderMethods(c, entry.Decl, entry.TypeArgs, entry.Result)
		return
	}
}

// undoBatchMethods takes back the methods defined on demand from the n-th on,
// latest first, so that collection defines them again: a check deferred while
// types are collected (batchVarOnDemand) drops their errors with its own.  A
// generic type's method is dropped from the instances that took it, which take
// their generic's methods again when next looked up or back-filled, and the
// generics' methods return to generics, as they were before that check.
func undoBatchMethods(c @Checker, n int, generics @[]@GenericMethodEntry) {
	var b @DeclBatch = c.Batch
	var generic bool = false
	for i := len(b.MethodsUndo) - 1; i >= n; i-- {
		var r @DeclRollback = b.MethodsUndo[i]
		restoreMethod(r)
		if len(r.GenericRecv) > 0 {
			generic = true
			dropInstanceMethod(c, r.GenericRecvPkg, r.GenericRecv, r.Method)
		}
	}
	if generic {
		c.GenericMethods = generics
		bumpGenericGen(c)
	}
	b.MethodsDefined = b.MethodsDefined[:n]
	b.MethodsUndo = b.MethodsUndo[:n]
}
