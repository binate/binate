package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_decl_batch_method.bn: a method selected while the package's
// declarations are collected, before collection has attached it, is attached
// then.  A length is pinned by passing an array where one exact length is
// required.

// An array length calling a method declared later is resolved: a value or a
// pointer receiver, through a managed pointer, as a method expression, in a
// variable's type and in a type's.
func TestBatchArrayLengthCallsLaterMethod() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var s S\n"
					"type S struct { n int }\n"
					"var g [len(s.mk())]int\n"
					"var h [len(s.pk())]int\n"
					"var k [len(S.mk(s))]int\n"
					"var ps @S\n"
					"type T [len(ps.mk())]int\n"
					"var t T\n"
					"func (r S) mk() [3]int { var a [3]int; return a }\n"
					"func (r *S) pk() [4]int { var a [4]int; return a }\n"
					"func use3(a [3]int) int { return 0 }\n"
					"func use4(a [4]int) int { return 0 }\n"
					"func f() int { return use3(g) + use4(h) + use3(k) + use3(t) }\n")
	return expectNoErrors(c)
}

// An inferred-type variable read while types are collected, whose initializer
// calls a method declared later, is checked then.
func TestArrayLenOfInferredVarCallsLaterMethod() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = s.mk()\n"
			"var s S\n"
			"type S struct { n int }\n"
			"func (r S) mk() [3]int32 { var a [3]int32; return a }\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) + cast(int, tbl[1]) }\n"
	return expectNoErrors(checkSrc(src))
}

// An instance of a generic type built before collection reaches the generic's
// methods takes a method when it is selected: one declared later, or one
// collected after the instance was built.
func TestBatchArrayLengthCallsGenericMethod() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Box[E any] struct { v E }\n"
					"var bx Box[int]\n"
					"func (b Box[E]) two() [2]E { var a [2]E; return a }\n"
					"var g [len(bx.two())]int\n"
					"var h [len(bx.six())]int\n"
					"func (b Box[E]) six() [6]E { var a [6]E; return a }\n"
					"func use2(a [2]int) int { return 0 }\n"
					"func use6(a [6]int) int { return 0 }\n"
					"func f() int { return use2(g) + use6(h) }\n")
	return expectNoErrors(c)
}

// So does one read through an inferred-type variable.
func TestArrayLenOfInferredVarCallsLaterGenericMethod() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = bx.mk()\n"
			"var bx Box[int32]\n"
			"type Box[E any] struct { v E }\n"
			"func (b Box[E]) mk() [3]E { var a [3]E; return a }\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) + cast(int, tbl[1]) }\n"
	return expectNoErrors(checkSrc(src))
}

// A method whose own signature's array length selects it is not defined again
// while its signature is being resolved: the selection reports it undefined,
// once.
func TestBatchArrayLengthCallsItsOwnMethod() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var s S\n"
					"type S struct { n int }\n"
					"var g [len(s.self())]int\n"
					"func (r S) self() [len(s.self())]int { var a [1]int; return a }\n")
	if errorsContaining(c, "undefined: self") != 1 {
		return fail("expected the one undefined error")
	}
	return ""
}

// A method declared twice, selected before collection reaches either, is
// reported redeclared once: the first is defined on demand, and the second is
// the duplicate.
func TestBatchLaterMethodRedeclared() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var s S\n"
					"type S struct { n int }\n"
					"var g [len(s.mk())]int\n"
					"func (r S) mk() [3]int { var a [3]int; return a }\n"
					"func (r S) mk() [3]int { var a [3]int; return a }\n"
					"func use3(a [3]int) int { return 0 }\n"
					"func f() int { return use3(g) }\n")
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "method mk redeclared on type S") != 1 {
		return fail("expected exactly the redeclared error")
	}
	return ""
}

// A cycle through the signature of a method defined on demand — tbl's
// initializer calls s.mk, whose result's length reads tbl — is an error.
func TestBatchCycleThroughMethodSignature() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var g [len(tbl)]int\n"
					"var tbl = s.mk()\n"
					"var s S\n"
					"type S struct { n int }\n"
					"func (r S) mk() [len(tbl)]int { var a [0]int; return a }\n")
	if len(c.CheckerErrors()) == 0 { return fail("the cycle through mk's signature must be an error") }
	return ""
}

// An error in the signature of a method defined on demand, in a check deferred
// while types are collected, is reported once, and the method is not reported
// redeclared: it is taken back, and collection defines it again
// (undoBatchMethods).
func TestBatchOnDemandMethodSignatureErrorReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type B [len(tbl)]uint8\n"
					"var tbl = s.mk(1, 2)\n"
					"var s S\n"
					"type S struct { n int }\n"
					"func (r S) mk(a int, a int) [3]int { var x [3]int; return x }\n")
	if errorsContaining(c, "duplicate parameter name") != 1 || errorsContaining(c, "redeclared") != 0 {
		return fail("expected the duplicate parameter error once, and no redeclared error")
	}
	return ""
}

// So is one in the signature of a generic type's method.
func TestBatchOnDemandGenericMethodSignatureErrorReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type B [len(tbl)]uint8\n"
					"var tbl = bx.mk(1, 2)\n"
					"var bx Box[int]\n"
					"type Box[E any] struct { v E }\n"
					"func (b Box[E]) mk(a int, a int) [3]E { var x [3]E; return x }\n")
	if errorsContaining(c, "duplicate parameter name") != 1 || errorsContaining(c, "redeclared") != 0 {
		return fail("expected the duplicate parameter error once, and no redeclared error")
	}
	return ""
}

// A method whose signature reads a variable whose check is deferred while the
// method is being defined is taken back only by a check deferred around its
// definition: it is defined once, and the errors are each reported once.
func TestBatchMethodSignatureReadsDeferredVar() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "package \"test\"\n"
			"var s S\n"
			"type S struct { n int }\n"
			"var g [len(s.x())]int\n"
			"func (r S) x() [len(a)]int { var z [3]int; return z }\n"
			"var a = undefinedA\n"
			"var h [len(c2)]int\n"
			"var c2 = undefinedC\n"
	srcs[1] = "package \"test\"\n"
			"var s S\n"
			"type S struct { n int }\n"
			"type B [len(o)]int\n"
			"var o = pair(s.x(), zz)\n"
			"func pair(p [3]int, q int) [3]int { return p }\n"
			"func (r S) x() [len(a)]int { var z [3]int; return z }\n"
			"var a = undefinedA\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if errorsContaining(c, "undefined: undefinedA") != 1 || errorsContaining(c, "redeclared") != 0 {
			return fail(catStrs("expected undefinedA reported once and no redeclared error for: ", srcs[i]))
		}
	}
	return ""
}

// A generic type's method whose signature selects a method its instance lacks,
// copied onto that instance, reports the selection undefined rather than
// copying again: another method of the generic, or itself.
func TestBatchCopiedGenericMethodSelectsMissing() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "package \"test\"\n"
			"type Box[E any] struct { v E }\n"
			"var bx Box[int]\n"
			"func (b Box[E]) f() [len(bx.g())]int { var a [1]int; return a }\n"
			"var k [len(bx.f())]int\n"
	srcs[1] = "package \"test\"\n"
			"type Box[E any] struct { v E }\n"
			"var bx Box[int]\n"
			"func (b Box[E]) f() [len(bx.f())]int { var a [1]int; return a }\n"
			"var k [len(bx.f())]int\n"
	if errorsContaining(checkSrc(srcs[0]), "undefined: g") == 0 {
		return fail("expected g reported undefined")
	}
	if errorsContaining(checkSrc(srcs[1]), "undefined: f") == 0 {
		return fail("expected f reported undefined")
	}
	return ""
}

// A method declared later is found from a selection checked under a nested
// scope too: a method's signature, a generic function's (its type parameters'
// scope), and a function literal's body run for an inferred-type variable.
func TestBatchLaterMethodFromNestedScope() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type T struct { n int }\n"
					"func (t T) f() [len(s.h1())]int { var a [2]int; return a }\n"
					"func g[X any]() [len(s.h2())]int { var a [3]int; return a }\n"
					"type B [len(tbl)]uint8\n"
					"var tbl = func() [4]int { return s.h3() }()\n"
					"var s S\n"
					"type S struct { n int }\n"
					"func (r S) h1() [2]int { var a [2]int; return a }\n"
					"func (r S) h2() [3]int { var a [3]int; return a }\n"
					"func (r S) h3() [4]int { var a [4]int; return a }\n"
					"func use(a [2]int, b [3]int, d [4]uint8) int { return 0 }\n"
					"func h() int { var t T; var b B; return use(t.f(), g[int](), b) }\n")
	return expectNoErrors(c)
}
