package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for check_decl_batch.bn: package-level constants resolved after the
// package's other declarations (or when first read), and variables with an
// inferred type checked when first named.  A constant's value is pinned by
// passing an array of that length where one exact length is required.

// A package-level constant takes the size of a struct declared after it.
func TestConstSizeofLaterStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const S = sizeof(P)\n"
			"type P struct { a int32; b int32 }\n"
			"func use(a [8]uint8) int { return 0 }\n"
			"func f() int { var b [S]uint8; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// The constant's value is the size, not a placeholder: a length other than 8
// is rejected.
func TestConstSizeofLaterStructValue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const S = sizeof(P)\n"
			"type P struct { a int32; b int32 }\n"
			"func use(a [4]uint8) int { return 0 }\n"
			"func f() int { var b [S]uint8; return use(b) }\n"
	return expectError(checkSrc(src))
}

// A package-level constant takes len of a variable whose type is inferred
// from its initializer, declared after it.
func TestConstLenInferredVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const L = len(v)\n"
			"var v = [3]int32{1, 2, 3}\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b [L]uint8; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// Checking a declaration on demand starts it at package level and restores the
// state of what was being checked.
func TestEnterLeavePackageDeclRestores() testing.TestResult {
	var c @Checker = NewChecker()
	var d @ast.Decl = make(ast.Decl)
	c.InLoop = true
	c.InDefer = true
	c.Iota = 3
	c.InGroupBareMember = true
	var saved declContext = enterPackageDecl(c, d)
	if c.InLoop || c.InDefer || c.Iota != -1 || c.InGroupBareMember {
		return "enterPackageDecl must start the declaration at package level"
	}
	leavePackageDecl(c, saved)
	if !c.InLoop || !c.InDefer || c.Iota != 3 || !c.InGroupBareMember {
		return "leavePackageDecl must restore the saved state"
	}
	return ""
}

// A package-level constant initializer reading a variable (declared before or
// after it), calling a function, taking len of a slice or reading a float
// variable is not constant.
func TestPackageConstInitNotConstantRejected() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "package \"test\"\nconst C = v\nvar v = 3\n"
	srcs[1] = "package \"test\"\nconst C = f()\nfunc f() int { return 1 }\n"
	srcs[2] = "package \"test\"\nvar s @[]int = make_slice(int, 3)\nconst C = len(s)\n"
	srcs[3] = "package \"test\"\nvar fl = 2.5\nconst C = fl * 2.0\n"
	for i := 0; i < len(srcs); i++ {
		if errorsContaining(checkSrc(srcs[i]), "is not a constant expression") != 1 {
			return fail(catStrs("expected the not-constant error for: ", srcs[i]))
		}
	}
	return ""
}

// An array length instantiating a generic function declared later is
// resolved too.
func TestBatchArrayLengthCallsLaterGenericFunc() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var g [len(gf[int]())]int\n"
			"func gf[T any]() [2]T { var a [2]T; return a }\n"
			"func use2(a [2]int) int { return 0 }\n"
			"func h() int { return use2(g) }\n"
	return expectNoErrors(checkSrc(src))
}

// An array length calling a function declared later in the package is
// resolved: the function is defined on demand (batchFuncOnDemand), in a
// variable's type and in a type's — exactly one length fits each use.
func TestBatchArrayLengthCallsLaterFunc() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var g [len(f())]int\n"
					"type T [len(f2())]int\n"
					"var t T\n"
					"func f() [3]int { var a [3]int; return a }\n"
					"func f2() [4]int { var a [4]int; return a }\n"
					"func use3(a [3]int) int { return 0 }\n"
					"func use4(a [4]int) int { return 0 }\n"
					"func h() int { return use3(g) + use4(t) }\n")
	return expectNoErrors(c)
}

// A function whose own signature's array length calls it is not defined while
// its signature is being resolved: the call reports it undefined.
func TestBatchArrayLengthCallsItsOwnFunc() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var g [len(f())]int\n"
					"func f() [len(f())]int { var a [1]int; return a }\n")
	return expectErrSub(c, "undefined: f")
}

// A cycle through the signature of a function defined on demand — tbl's
// initializer calls mk, whose result's length reads tbl — is an error, not a
// length of zero.
func TestBatchCycleThroughFuncSignature() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var g [len(tbl)]int\n"
					"var tbl = mk()\n"
					"func mk() [len(tbl)]int { var a [0]int; return a }\n")
	if len(c.CheckerErrors()) == 0 { return fail("the cycle through mk's signature must be an error") }
	return ""
}

// An error in the signature of a function defined on demand, in a check
// deferred while types are collected, is reported: collection defines the
// function again.
func TestBatchOnDemandFuncSignatureErrorReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type B [len(tbl)]uint8\n"
					"var tbl = mk(1, 2)\n"
					"func mk(a int, a int) [3]int { var r [3]int; return r }\n")
	return expectErrSub(c, "duplicate parameter name")
}

// A constrained generic function instantiated while types are collected, whose
// type argument's impl is declared later, satisfies its constraint: the check
// waits for every impl (recheckDeferredConstraints).
func TestBatchArrayLengthConstrainedGenericLaterImpl() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type T [len(gf[S]())]int\n"
					"func gf[X Sizer]() [2]X { var a [2]X; return a }\n"
					"type S struct { n int }\n"
					"func (s S) Size() int { return 1 }\n"
					"impl S : Sizer\n")
	return expectNoErrors(c)
}

// A type argument with no such impl is still reported, at its use.
func TestBatchArrayLengthConstrainedGenericMissReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type T [len(gf[S]())]int\n"
					"func gf[X Sizer]() [2]X { var a [2]X; return a }\n"
					"type S struct { n int }\n")
	return expectErrSub(c, "does not satisfy constraint Sizer")
}

// A function declared later under a predeclared name shadows it for an array
// length read before it, as a variable of the name does.
func TestBatchArrayLengthCallsShadowingFunc() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"var g [len(panic())]int\n"
					"func panic() [2]int { var a [2]int; return a }\n"
					"func use2(a [2]int) int { return 0 }\n"
					"func h() int { return use2(g) }\n")
	return expectNoErrors(c)
}

// A generic function instantiated while types are collected with a type
// argument declared later has the argument collected first: it is a type formed
// there, judged by its layout, not taken for an opaque one.
func TestBatchArrayLengthGenericLaterTypeArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func gf[X any]() [2]X { var a [2]X; return a }\n"
					"type T [len(gf[S]())]int\n"
					"type S struct { n int }\n"
					"type U [len(gf[@[]S]())]int\n")
	return expectNoErrors(c)
}
