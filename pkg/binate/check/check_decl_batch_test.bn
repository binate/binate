package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for check_decl_batch.bn: package-level constants resolved after the
// package's other declarations (or when first read), and variables with an
// inferred type checked when first named.  A constant's value is pinned by
// passing an array of that length where one exact length is required.

// A package-level constant takes the size of a struct declared after it.
func TestConstSizeofLaterStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const S = sizeof(P)\n"
			"type P struct { a int32; b int32 }\n"
			"func use(a [8]uint8) int { return 0 }\n"
			"func f() int { var b [S]uint8; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// The constant's value is the size, not a placeholder: a length other than 8
// is rejected.
func TestConstSizeofLaterStructValue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const S = sizeof(P)\n"
			"type P struct { a int32; b int32 }\n"
			"func use(a [4]uint8) int { return 0 }\n"
			"func f() int { var b [S]uint8; return use(b) }\n"
	return expectError(checkSrc(src))
}

// A package-level constant takes len of a variable whose type is inferred
// from its initializer, declared after it.
func TestConstLenInferredVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"const L = len(v)\n"
			"var v = [3]int32{1, 2, 3}\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b [L]uint8; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// A function body names an inferred-type variable declared after it, and a
// variable's initializer names one declared after it.
func TestInferredVarForwardRef() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int { return v + w }\n"
			"var v = w + 1\n"
			"var w = 41\n"
	return expectNoErrors(checkSrc(src))
}

// Two inferred-type variables naming each other are one error: the
// initialization cycle, not an undefined name as well.
func TestInferredVarCycleOneError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a = b\n"
			"var b = a\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "initialization cycle") != 1 {
		return "expected exactly the initialization-cycle error"
	}
	return ""
}

// Checking a declaration on demand starts it at package level and restores the
// state of what was being checked.
func TestEnterLeavePackageDeclRestores() testing.TestResult {
	var c @Checker = NewChecker()
	var d @ast.Decl = make(ast.Decl)
	c.InLoop = true
	c.InFunc = true
	c.Iota = 3
	c.InGroupBareMember = true
	var saved declContext = enterPackageDecl(c, d)
	if c.InLoop || c.InFunc || c.Iota != -1 || c.InGroupBareMember {
		return "enterPackageDecl must start the declaration at package level"
	}
	leavePackageDecl(c, saved)
	if !c.InLoop || !c.InFunc || c.Iota != 3 || !c.InGroupBareMember {
		return "leavePackageDecl must restore the saved state"
	}
	return ""
}

// A variable initialized with a function literal whose body names a variable
// initialized from the first has the literal's type: its body is not run at
// initialization, so there is no cycle.
func TestInferredVarFuncLitNamedBack() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a = func() int { return b() }\n"
			"var b = a\n"
	return expectNoErrors(checkSrc(src))
}

// A cycle through a declared-type variable defined on demand is the cycle
// error alone: the variable is not mistaken for a `.bni` declaration.
func TestDeclaredVarCycleNoBniMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T [len(v)]int\n"
			"var v T\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cyclic type definition involving `T`") != 1 ||
			errorsContaining(c, ".bni") != 0 {
		return "expected the cyclic-type error and no .bni mismatch"
	}
	return ""
}

// A package-level constant initializer reading a variable (declared before or
// after it), calling a function, taking len of a slice or reading a float
// variable is not constant.
func TestPackageConstInitNotConstantRejected() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "package \"test\"\nconst C = v\nvar v = 3\n"
	srcs[1] = "package \"test\"\nconst C = f()\nfunc f() int { return 1 }\n"
	srcs[2] = "package \"test\"\nvar s @[]int = make_slice(int, 3)\nconst C = len(s)\n"
	srcs[3] = "package \"test\"\nvar fl = 2.5\nconst C = fl * 2.0\n"
	for i := 0; i < len(srcs); i++ {
		if errorsContaining(checkSrc(srcs[i]), "is not a constant expression") != 1 {
			return fail(catStrs("expected the not-constant error for: ", srcs[i]))
		}
	}
	return ""
}

// An array length may read len of an inferred-type variable whose initializer
// needs only what is collected (a composite literal of a builtin element).
func TestArrayLenOfInferredVarDuringCollection() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = [3]int32{1, 2, 3}\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// When that initializer needs a declaration not collected yet (a function
// declared later), the one error says to declare the variable's type.
func TestArrayLenOfInferredVarNeedsLaterDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = mk()\n"
			"func mk() [3]int32 { var a [3]int32; return a }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "declare its type") != 1 {
		return "expected exactly the declare-its-type error"
	}
	return ""
}

// An initializer's own error, found by that check, is reported — not replaced
// by the declare-its-type error.
func TestArrayLenOfInferredVarOwnError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T2 [len(H)]int\n"
			"var H = [3]int{1, 2, true}\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cannot assign") == 0 || errorsContaining(c, "declare its type") != 0 {
		return "expected the initializer's own error, not the declare-its-type error"
	}
	return ""
}

// A variable deferred that way has its real type afterwards: using it reports
// nothing more.
func TestArrayLenOfInferredVarLaterUseClean() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = mk()\n"
			"func mk() [3]int32 { var a [3]int32; return a }\n"
			"func f() int32 { return tbl[1] + cast(int32, len(tbl)) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "declare its type") != 1 {
		return "expected exactly the declare-its-type error"
	}
	return ""
}
