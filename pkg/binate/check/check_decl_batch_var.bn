package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Package variables resolved on demand while a package's declarations are
// collected (check_decl_batch.bn), and the checks deferred for them.

// batchVarOnDemand defines the batch's package variable name, which is not
// defined yet, and returns its symbol (nil when name is no such variable): one
// with a declared type that collection has not reached, or one whose type is
// inferred from its initializer — defined with the type its initializer spells
// at its head, or else checked now rather than when pass 2 reaches it.  One
// named while its own type is being found takes the type its initializer spells
// at its head, or a placeholder (check_var_placeholder.bn).  One whose
// definition read a layout not built yet, inside an instance's build, is left
// undefined (defineVarOnDemand), and none is defined inside a build that waits
// already (skipDemand).
func batchVarOnDemand(c @Checker, name *[]readonly char) @Symbol {
	var b @DeclBatch = c.Batch
	if b == nil || !b.VarsOpen {
		return nil
	}
	var d @ast.Decl = findDeclIn(b.Vars, name)
	if d == nil {
		return nil
	}
	var saved declContext = enterPackageDecl(c, d)
	if d.TypeRef != nil && declInList(b.VarsResolving, d) {
		// Named in its own type (an array length): a placeholder, defined on
		// demand as far as collection is concerned.
		definePlaceholder(c, d)
		b.VarsDefined = slices.Append[@ast.Decl](b.VarsDefined, d)
	} else if declInList(b.VarsHeadTyping, d) && !declInList(b.VarsChecking, d) {
		// Named while the type its initializer spells at its head is found on
		// demand — in the head itself (`var u = [len(u)]int{}`), or in the check
		// of a variable whose type the head needs (`var u = [len(w)]int{}` with
		// `var w = mk(u).arr`): its type depends on itself.  (Inside a build
		// that waits, it is judged when the build is done again.)
		if !layoutFrameBlocked(c) {
			errVarTypeCycle(c, d)
		}
		definePlaceholder(c, d)
	} else if declInList(b.VarsChecking, d) {
		// Named from its own initializer.  When the initializer spells its type
		// at its head (a function literal's signature, known before its body),
		// that is its type; otherwise it has a placeholder, and a cycle of
		// reads is the initialization order's.  While types are collected the
		// cycle may run through a function's signature defined on demand (`var
		// t = mk()`, `func mk() [len(t)]int`), which that does not see, so the
		// check reading the variable early is deferred for it (errVarCycle).
		var ht @types.Type = varHeadType(c, d)
		if ht != nil {
			defineVar(c.Scope, d.Name, ht)
		} else {
			if b.Collecting {
				errVarCycle(c, d.Pos, d.Name)
			}
			definePlaceholder(c, d)
		}
	} else if skipDemand(c) || defineVarOnDemand(c, d) {
		leavePackageDecl(c, saved)
		return nil
	}
	leavePackageDecl(c, saved)
	return c.Scope.Lookup(name)
}

// defineVarOnDemand defines the batch's variable d on demand — its declared type
// resolved; or the type its initializer spells at its head (varHeadType), its
// type before its operands are checked, which pass 2 checks; or else its
// declaration checked — in a layout frame of its own (enterDemandFrame), and
// reports whether that read a layout not built yet, inside an instance's build:
// d is then undone — its binding, its record as defined or checked, what its
// check recorded on its syntax — to be defined again when next read or when
// collection reaches it.
func defineVarOnDemand(c @Checker, d @ast.Decl) bool {
	var b @DeclBatch = c.Batch
	var ds @Scope = declScope(c)
	var prev @Symbol = ds.LookupLocal(d.Name)
	var framed bool = enterDemandFrame(c)
	var deferred bool = false
	var ht @types.Type = nil
	if d.TypeRef == nil && !declInList(b.VarsCycled, d) {
		ht = varHeadType(c, d)
		if declInList(b.VarsCycled, d) {
			ht = nil
		}
	}
	if d.TypeRef != nil || ht != nil {
		var vt @types.Type = ht
		if d.TypeRef != nil {
			vt = resolveBatchVarType(c, d)
		}
		if !prepareLayout(c, vt, d.Pos) {
			vt = types.TypError()
		}
		defineVar(c.Scope, d.Name, vt)
	} else if declInList(b.VarsCycled, d) {
		// Its head's type cycle reported, it has the error type.
		defineVar(c.Scope, d.Name, types.TypError())
	} else {
		var before checkMark = markChecks(c)
		var cycled int = len(b.VarsCycled)
		var cycleErrs int = b.CycleErrors
		var funcs int = len(b.FuncsDefined)
		var methods int = len(b.MethodsDefined)
		var generics @[]@GenericMethodEntry = c.GenericMethods
		checkBatchVarDecl(c, d)
		finalizeUntypedNonConst(c)
		if b.Collecting && ownChecksSince(c, before, cycleErrs) {
			// Checked while types are collected (an array length reads it), the
			// initializer sees only the declarations collected so far, and its
			// errors may just name the others as undefined or opaque: it is
			// checked again once collection is done (recheckDeferredVars).  The
			// functions and methods it defined on demand are left to collection,
			// which reports their own errors, dropped here with the rest.  (Its
			// only errors other variables' type cycles, it is done.)
			dropChecksSince(c, before)
			// A variable type cycle found meanwhile is not collection's to
			// report again: it stands.
			for i := cycled; i < len(b.VarsCycled); i++ {
				reportVarTypeCycle(c, b.VarsCycled[i])
			}
			b.FuncsDefined = b.FuncsDefined[:funcs]
			undoBatchMethods(c, methods, generics)
			deferred = true
		}
	}
	if leaveDemandFrame(c, framed) {
		restoreBinding(ds, d.Name, prev)
		var kept @[]@ast.Decl
		for i := 0; i < len(b.VarsDefined); i++ {
			if !same(b.VarsDefined[i], d) {
				kept = slices.Append[@ast.Decl](kept, b.VarsDefined[i])
			}
		}
		b.VarsDefined = kept
		if d.TypeRef == nil && b.VarsChecked.Len() > 0 &&
				same(b.VarsChecked.Get(b.VarsChecked.Len() - 1), d) {
			_, _ = b.VarsChecked.Pop()
		}
		ast.ClearCheckerAnnotations(d)
		return true
	}
	if d.TypeRef != nil {
		b.VarsDefined = slices.Append[@ast.Decl](b.VarsDefined, d)
	}
	if deferred {
		defineVar(c.Scope, d.Name, types.TypError())
		b.VarsDeferred = slices.Append[@ast.Decl](b.VarsDeferred, d)
	}
	return false
}

// recheckDeferredVars checks again, now that collection is done, each variable
// whose check while types were collected had errors.  If it now checks
// cleanly, those errors came from declarations not collected yet: the one error
// is that its type was needed too early (errVarNeededDuringCollection) —
// unless its type depends on itself (its type cycle is reported, or it is a
// cycle of reads alone), or an array length in it was left without a value by
// another declaration's error.  Otherwise its own errors stand.
func recheckDeferredVars(c @Checker) {
	var b @DeclBatch = c.Batch
	for i := 0; i < len(b.VarsDeferred); i++ {
		var d @ast.Decl = b.VarsDeferred[i]
		var saved declContext = enterPackageDecl(c, d)
		var before checkMark = markChecks(c)
		var poisons int = b.SilentPoisons
		// As it is checked again, its type is the one its initializer spells at
		// its head, or else its definition while deferred, the error type,
		// stands in for it as a placeholder: an array length in its initializer
		// naming it is then a type cycle (placeholderPoisoned), and so is its
		// initializer reading it elsewhere (endVarCheck), unless only reads
		// make the cycle, which is the initialization order's.
		recordPlaceholder(c, d)
		var ht @types.Type = varHeadType(c, d)
		if ht != nil {
			defineVar(c.Scope, d.Name, ht)
		}
		var m varCheckMark = beginVarCheck(b, d)
		checkVarDecl(c, d)
		finalizeUntypedNonConst(c)
		var selfRead bool = freeReadOf(b, d, m)
		endVarCheck(c, d, m)
		if declInList(b.VarsCycled, d) {
			defineDeclVar(c, d, types.TypError())
		} else if !checksSince(c, before) && b.SilentPoisons == poisons && !selfRead {
			errVarNeededDuringCollection(c, d)
		}
		leavePackageDecl(c, saved)
	}
}

// checkMark counts what checking has reported so far: the errors — in
// TentativeMode the captured errors and missing names, a missing name being
// an error deferred to its declaration (a REPL declaration batch).
type checkMark struct {
	Errs    int
	Missing int
}

// markChecks returns the current checkMark.
func markChecks(c @Checker) checkMark {
	var m checkMark
	if c.TentativeMode {
		m.Errs = len(c.TentativeErrors)
		m.Missing = len(c.TentativeMissing)
	} else {
		m.Errs = len(c.Errors)
	}
	return m
}

// checksSince reports whether checking has reported anything since m.
func checksSince(c @Checker, m checkMark) bool {
	var now checkMark = markChecks(c)
	return now.Errs > m.Errs || now.Missing > m.Missing
}

// dropChecksSince discards what checking has reported since m.
func dropChecksSince(c @Checker, m checkMark) {
	if c.TentativeMode {
		c.TentativeErrors = c.TentativeErrors[:m.Errs]
		c.TentativeMissing = c.TentativeMissing[:m.Missing]
	} else {
		c.Errors = c.Errors[:m.Errs]
	}
}

// errVarNeededDuringCollection reports that the type of the variable d, which
// is inferred from its initializer, is needed while the package's types are
// collected, before the declarations its initializer uses are.
func errVarNeededDuringCollection(c @Checker, d @ast.Decl) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("the type of `")
	cb.Write(d.Name)
	cb.Write("` is needed while the package's types are collected (an array length reads it), but ")
	cb.Write("its initializer uses declarations not collected yet: declare its type")
	addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
}

// funcLitDefaultType returns the type a variable initialized with the function
// literal e has when nothing hints its form — a managed function value of the
// literal's signature (checkFuncLit) — or the error type when e is not a
// function literal.
func funcLitDefaultType(c @Checker, e @ast.Expr) @types.Type {
	if e == nil || e.Kind != ast.EXPR_FUNC_LIT || e.DeclRef == nil {
		return types.TypError()
	}
	var ft @types.Type = resolveFuncDeclType(c, e.DeclRef)
	if ft == nil {
		return types.TypError()
	}
	return types.MakeManagedFuncValueType(ft.Params, ft.Results)
}

// varDefinedOnDemand reports whether the declared-type variable d was defined
// on demand, before collection reached it.
func varDefinedOnDemand(c @Checker, d @ast.Decl) bool {
	return c.Batch != nil && declInList(c.Batch.VarsDefined, d)
}

// checkBatchVarDecl checks the package variable declaration d; one whose type
// is inferred from its initializer is checked once — on demand, or when pass 2
// reaches it — and the placeholders its initializer read are judged then
// (endVarCheck).  One whose type cycle is reported has the error type, so
// nothing more is reported about it.
func checkBatchVarDecl(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	if b == nil || d.TypeRef != nil || isBlank(d.Name) {
		checkVarDecl(c, d)
	} else if !declInVec(b.VarsChecked, d) && !declInList(b.VarsChecking, d) {
		var m varCheckMark = beginVarCheck(b, d)
		checkVarDecl(c, d)
		endVarCheck(c, d, m)
		b.VarsChecked.Push(d)
	}
	if b != nil && declInList(b.VarsCycled, d) {
		defineDeclVar(c, d, types.TypError())
	}
}
