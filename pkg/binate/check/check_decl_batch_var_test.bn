package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_decl_batch_var.bn: package variables checked or defined
// when first named, and the checks deferred for them.

// A function body names an inferred-type variable declared after it, and a
// variable's initializer names one declared after it.
func TestInferredVarForwardRef() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int { return v + w }\n"
			"var v = w + 1\n"
			"var w = 41\n"
	return expectNoErrors(checkSrc(src))
}

// Two inferred-type variables naming each other are one error: the
// initialization cycle, not an undefined name as well.
func TestInferredVarCycleOneError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a = b\n"
			"var b = a\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "initialization cycle") != 1 {
		return "expected exactly the initialization-cycle error"
	}
	return ""
}

// A variable initialized with a function literal whose body names a variable
// initialized from the first has the literal's type: its body is not run at
// initialization, so there is no cycle.
func TestInferredVarFuncLitNamedBack() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a = func() int { return b() }\n"
			"var b = a\n"
	return expectNoErrors(checkSrc(src))
}

// A cycle through a declared-type variable defined on demand is the cycle
// error alone: the variable is not mistaken for a `.bni` declaration.
func TestDeclaredVarCycleNoBniMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T [len(v)]int\n"
			"var v T\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cyclic type definition involving `T`") != 1 ||
			errorsContaining(c, ".bni") != 0 {
		return "expected the cyclic-type error and no .bni mismatch"
	}
	return ""
}

// An array length may read len of an inferred-type variable whose initializer
// needs only what is collected (a composite literal of a builtin element).
func TestArrayLenOfInferredVarDuringCollection() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = [3]int32{1, 2, 3}\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// When that initializer spells no type at its head and needs a declaration not
// collected yet that is not resolved on demand (an impl declared later, which
// converting s to *I takes), the one error says to declare the variable's type.
func TestArrayLenOfInferredVarNeedsLaterDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = *pickp(&s)\n"
			"var arr0 [3]int32\n"
			"func pickp(i *I) *([3]int32) { return &arr0 }\n"
			"interface I { M() }\n"
			"var s S\n"
			"type S struct { n int }\n"
			"func (r S) M() {}\n"
			"impl S : I\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "declare its type") != 1 {
		return "expected exactly the declare-its-type error"
	}
	return ""
}

// An initializer's own error, found by that check, is reported — not replaced
// by the declare-its-type error.
func TestArrayLenOfInferredVarOwnError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T2 [len(H)]int\n"
			"var H = [3]int{1, 2, true}\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cannot assign") == 0 || errorsContaining(c, "declare its type") != 0 {
		return "expected the initializer's own error, not the declare-its-type error"
	}
	return ""
}

// A variable deferred that way has its real type afterwards: using it reports
// nothing more.
func TestArrayLenOfInferredVarLaterUseClean() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = *pickp(&s)\n"
			"var arr0 [3]int32\n"
			"func pickp(i *I) *([3]int32) { return &arr0 }\n"
			"interface I { M() }\n"
			"var s S\n"
			"type S struct { n int }\n"
			"func (r S) M() {}\n"
			"impl S : I\n"
			"func f() int32 { return tbl[1] + cast(int32, len(tbl)) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "declare its type") != 1 {
		return "expected exactly the declare-its-type error"
	}
	return ""
}

// An inferred-type variable read while types are collected, whose initializer
// calls a function declared later, is checked then: the function is defined on
// demand (batchFuncOnDemand).
func TestArrayLenOfInferredVarCallsLaterFunc() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = mk()\n"
			"func mk() [3]int32 { var a [3]int32; return a }\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// So is one whose initializer instantiates a generic function declared later.
func TestArrayLenOfInferredVarCallsLaterGenericFunc() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = mk[int32]()\n"
			"func mk[T any]() [3]T { var a [3]T; return a }\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// A variable read while the package's types are collected, whose check is
// deferred, keeps the errors of the constants that check resolved — through a
// function's result and through a method's.
func TestDeferredVarKeepsConstErrors() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "type B [len(tbl)]uint8\nvar tbl = mk().arr\nfunc mk() S { var s S; return s }\n"
			"type S struct { arr [N]int }\nconst N = undefinedThing\n"
	srcs[1] = "type B [len(tbl)]uint8\nvar tbl = v.mk().arr\ntype R struct { n int }\nvar v R\n"
			"func (r R) mk() S { var s S; return s }\ntype S struct { arr [N]int }\n"
			"const N = undefinedThing\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(buf.Concat("package \"test\"\n", srcs[i]))
		if errorsContaining(c, "undefined: undefinedThing") != 1 {
			return buf.Concat(srcs[i], "expected the constant's own error, once")
		}
	}
	// A variable whose check depends on such a deferred one (t1 on t2) is not
	// told to declare its type for the constant's error.
	var outer *[]readonly char = "package \"test\"\ntype B [len(t1)]uint8\nvar t1 = t2\n"
			"var t2 = mk().arr\nfunc mk() S { var s S; return s }\n"
			"type S struct { arr [N]int }\nconst N = undefinedThing\n"
	var c2 @Checker = checkSrc(outer)
	if errorsContaining(c2, "undefined: undefinedThing") != 1 ||
			errorsContaining(c2, "type of `t1`") != 0 {
		return "expected the constant's error, and nothing told to t1"
	}
	return ""
}
