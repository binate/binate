package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Collection of methods (and, via the shared helpers, parameterized-receiver
// impls) declared on a generic type — `func (it *Cursor[T]) …` /
// `impl *Cursor[T] : Iterator[T]` — where the receiver's `[T]` binds the type's
// parameters as fresh names (gen.method.generic-recv, gen.impl.generic-recv).
// The concrete-receiver method path stays in check_decl_func.bn; the concrete
// impl path in check_impl.bn.

// receiverBaseInstantiation peels the pointer / managed / const / paren
// wrappers off a receiver type expression and returns the underlying
// TEXPR_INSTANTIATE (`Cursor[T]`) if that is the base, or nil otherwise.
// A non-nil result marks a method / impl declared on a generic type.
func receiverBaseInstantiation(te @ast.TypeExpr) @ast.TypeExpr {
	var base @ast.TypeExpr = te
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER || base.Kind == ast.TEXPR_MANAGED ||
				base.Kind == ast.TEXPR_CONST || base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	if base != nil && base.Kind == ast.TEXPR_INSTANTIATE {
		return base
	}
	return nil
}

// resolveGenericReceiverDecl validates that a method / impl receiver `te` is a
// generic-type instantiation whose bracket arguments are plain binder names of
// the right arity, and returns the generic type's declaration + its placeholder
// named type (which carries the abstract method set).  Emits an error at d.Pos
// and returns ok = false on any problem.  Does not modify scope.
func resolveGenericReceiverDecl(c @Checker, d @ast.Decl,
		te @ast.TypeExpr) (@ast.Decl, @types.Type, bool) {
	var inst @ast.TypeExpr = receiverBaseInstantiation(te)
	var head @ast.TypeExpr = inst.Base
	if head == nil || head.Kind != ast.TEXPR_NAMED {
		addCheckError(c, d.Pos, "receiver must be a named generic type in this package")
		return nil, nil, false
	}
	if len(head.Pkg) > 0 {
		addCheckError(c, d.Pos, "cannot define methods or impls on types from other packages")
		return nil, nil, false
	}
	var genDecl @ast.Decl = lookupGenericTypeDeclPkg(c, "", head.Name)
	if genDecl == nil {
		addCheckError(c, d.Pos, "receiver is not a generic type defined in this package")
		return nil, nil, false
	}
	var sym @Symbol = pkgScopeLookupLocal(c, head.Name)
	if sym == nil || sym.Kind != types.SYM_TYPE || sym.Type == nil ||
			sym.Type.Kind != types.TYP_NAMED {
		addCheckError(c, d.Pos, "receiver is not a named type defined in this package")
		return nil, nil, false
	}
	if len(inst.TypeArgs) != len(genDecl.TypeParams) {
		addCheckError(c, d.Pos, "receiver binds the wrong number of type parameters for its type")
		return nil, nil, false
	}
	// Each bracket argument must be a plain identifier that does not already name
	// a type (a name resolving to a type would be a specific-instantiation
	// receiver, which is forbidden — gen.no-conditional-impls), and the names must
	// be fresh: no two positions may bind the same name.  A blank `_` binds its
	// position without naming it, so any number of positions may be `_`.
	for i := 0; i < len(inst.TypeArgs); i++ {
		var arg @ast.TypeExpr = inst.TypeArgs[i]
		if arg == nil || arg.Kind != ast.TEXPR_NAMED || len(arg.Pkg) > 0 {
			addCheckError(c, d.Pos, "receiver type parameter must be a plain binding name")
			return nil, nil, false
		}
		if isBlank(arg.Name) {
			continue
		}
		for j := 0; j < i; j++ {
			if types.CharEq(inst.TypeArgs[j].Name, arg.Name) {
				var db @strings.Builder = strings.NewBuilder()
				db.Write("receiver binds type parameter name ")
				db.Write(arg.Name)
				db.Write(" more than once")
				addCheckError(c, d.Pos, buf.CopyStr(db.String()))
				return nil, nil, false
			}
		}
		var existing @Symbol = c.Scope.Lookup(arg.Name)
		if existing != nil && existing.Kind == types.SYM_TYPE {
			addCheckError(c, d.Pos,
					"methods / impls on a specific instantiation are not allowed (use a binding name)")
			return nil, nil, false
		}
	}
	return genDecl, sym.Type, true
}

// installReceiverBinders installs inst's binder names as TYP_TYPE_PARAM into the
// current scope and returns them.  Each binder's owner is genDecl and its index
// is its position, so it is Identical (by (owner, index)) to the type's own
// parameter and to the same binder installed for a sibling method / impl — the
// property that makes abstract impl-coverage match.  Constraints are inherited
// from genDecl (never restated on the method / impl).  Each binder is defined
// under its ast.ReceiverBinderName — for a blank `_`, a name no source reference
// can spell — so the receiver type must be resolved from
// ast.WithNamedBlankBinders(receiver).  The caller pushes/pops the scope.
func installReceiverBinders(c @Checker, inst @ast.TypeExpr, genDecl @ast.Decl) @[]@types.Type {
	var binders @[]@types.Type = make_slice(@types.Type, len(inst.TypeArgs))
	for i := 0; i < len(inst.TypeArgs); i++ {
		binders[i] = MakeTypeParamType(inst.TypeArgs[i].Name, bit_cast(*uint8, genDecl), i, nil)
	}
	resolveReceiverBinderConstraints(c, genDecl, binders)
	for i := 0; i < len(inst.TypeArgs); i++ {
		defineType(c.Scope, ast.ReceiverBinderName(inst.TypeArgs[i], i), binders[i])
	}
	return binders
}

// resolveReceiverBinderConstraints sets each binder's constraint from genDecl's
// type parameter at the same position.  A constraint may refer to another of the
// type's parameters (`type W[X any, C Cont[X]]`), and it is written in the type's
// DECLARED parameter names in the type's defining file — not in the receiver's
// binder names, which may rename (`*W[A, D]`), reorder, or blank (`*W[_, D]`)
// them.  So it resolves in a scope over the defining file's scope that binds each
// declared name to the binder at that position.
func resolveReceiverBinderConstraints(c @Checker, genDecl @ast.Decl, binders @[]@types.Type) {
	var savedScope @Scope = c.Scope
	var defScope @Scope = lookupGenericDeclScope(c, genDecl)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for j := 0; j < len(genDecl.TypeParams) && j < len(binders); j++ {
		if isBlank(genDecl.TypeParams[j].Name) {
			continue
		}
		defineType(c.Scope, genDecl.TypeParams[j].Name, binders[j])
	}
	for j := 0; j < len(genDecl.TypeParams) && j < len(binders); j++ {
		binders[j].TpConstraint = resolveTypeParamConstraint(c, genDecl.TypeParams[j])
	}
	c.Scope = savedScope
}

// collectGenericMethodDecl registers a method declared on a generic type, e.g.
// `func (it *Cursor[T]) Next() (T, bool)`.  The abstract method is attached to
// the type's placeholder named type, with the binders recorded on its
// FuncType.TypeParams so the body pass (checkFuncDecl) can put `T` back in scope;
// each concrete instantiation substitutes these methods later.
func collectGenericMethodDecl(c @Checker, d @ast.Decl) {
	var genDecl @ast.Decl
	var placeholder @types.Type
	var ok bool
	genDecl, placeholder, ok = resolveGenericReceiverDecl(c, d, d.Recv.Type)
	if !ok {
		return
	}
	var inst @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
	pushScope(c)
	var binders @[]@types.Type = installReceiverBinders(c, inst, genDecl)
	var recvType @types.Type = resolveTypeExpr(c, ast.WithNamedBlankBinders(d.Recv.Type))
	var ft @types.Type = resolveFuncDeclType(c, d)
	var combined @[]@types.Param = prependRecvParam(d.Recv.Name, recvType, ft.Params)
	var methodFuncType @types.Type = types.MakeFuncType(combined, ft.Results)
	methodFuncType.TypeParams = binders
	popScope(c)

	var m @types.Method = MakeMethod(d.Name, recvType, methodFuncType)
	if c.AllowRedef {
		placeholder.SetOrAppendMethod(m)
		return
	}
	if !placeholder.AddMethod(m) {
		var rb @strings.Builder = strings.NewBuilder()
		rb.Write("method ")
		rb.Write(d.Name)
		rb.Write(" redeclared on type ")
		rb.Write(placeholder.TypeName())
		addCheckError(c, d.Pos, buf.CopyStr(rb.String()))
	}
}

// collectGenericImplDecl registers a parameterized-receiver impl, e.g.
// `impl *Cursor[T] : Iterator[T]`.  The receiver's `[T]` binds the type's
// parameters (inheriting their constraints); the interface refs are resolved
// under those binders (so `Iterator[T]` refers to the same abstract `T`).  The
// recorded Impl carries the generic type's placeholder so the satisfaction pass
// checks coverage against the abstract method set (RecvType's base is the empty
// instantiation shell).
func collectGenericImplDecl(c @Checker, d @ast.Decl) {
	var genDecl @ast.Decl
	var placeholder @types.Type
	var ok bool
	genDecl, placeholder, ok = resolveGenericReceiverDecl(c, d, d.TypeRef)
	if !ok {
		return
	}
	var inst @ast.TypeExpr = receiverBaseInstantiation(d.TypeRef)
	pushScope(c)
	// The impl path needs only the binder side effect (defining `T` in scope so
	// the receiver and interface refs resolve); the returned binders are unused.
	_ = installReceiverBinders(c, inst, genDecl)
	var recv @types.Type = resolveTypeExpr(c, ast.WithNamedBlankBinders(d.TypeRef))
	var ifaces @[]@types.Type
	for i := 0; i < len(d.Interfaces); i++ {
		var t @types.Type = resolveImplInterfaceRef(c, d.Interfaces[i])
		if t != nil {
			ifaces = slices.Append[@types.Type](ifaces, t)
		}
	}
	popScope(c)

	var rec @Impl = make(Impl)
	rec.Pos = d.Pos
	rec.RecvType = recv
	rec.Interfaces = ifaces
	rec.CarveOut = c.AllowUniverseRecv
	rec.Placeholder = placeholder
	c.Impls = slices.Append[@Impl](c.Impls, rec)
}
