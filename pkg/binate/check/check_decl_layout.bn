package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Layouts needed during collection (see check_decl_batch.bn): a `sizeof` /
// `alignof` read while collectDeclsBody runs — in an array length, or in a
// constant an array length reads — needs the layout of types collection may
// not have reached yet.

// prepareLayout readies the layout of the type t for a `sizeof` / `alignof` at
// pos (or a variable's type read during collection) while collection runs: the
// package's type declarations t holds by value — through struct fields, array
// elements, alias and readonly wrappers and the underlying types of named types
// and instances, not through pointers or function values — are collected first
// where collection has not reached them, and checked for holding themselves by
// value; a slice's element is collected too (the opaque rule looks at it), but
// never reported as a cycle.  It walks the type as resolved, not as written: an
// instance's `[sizeof(T)]uint8` reaches its argument, and a name in a generic's
// declaration is the generic's, never a type of the package being checked that
// happens to share it.  A type whose own collection reads its layout (`type A
// [sizeof(A)]uint8`, or through a constant: `type A [S]uint8; const S =
// sizeof(A)`) is a cycle, reported at pos; prepareLayout then returns false.
func prepareLayout(c @Checker, t @types.Type, pos token.Pos) bool {
	if c.Batch == nil || !c.Batch.Collecting {
		return true
	}
	var seen typeVisits
	return prepareLayoutIn(c, t, pos, &seen, false)
}

// prepareLayoutIn is prepareLayout's walk over the parts t holds by value — or,
// when soft (t is reached through a slice's element), that the opaque rule
// looks at, where a type still being collected is no cycle.
func prepareLayoutIn(c @Checker, t @types.Type, pos token.Pos, seen *typeVisits, soft bool) bool {
	if t == nil || !seen.enter(t) {
		return true
	}
	if t.Kind == types.TYP_NAMED {
		var d @ast.Decl = batchTypeDeclOf(c, t)
		if d == nil {
			return prepareLayoutIn(c, t.Underlying, pos, seen, soft)
		}
		return prepareBatchType(c, d, pos, soft)
	}
	if t.Kind == types.TYP_ALIAS {
		return prepareLayoutIn(c, t.Target, pos, seen, soft)
	}
	if t.Kind == types.TYP_ARRAY || t.Kind == types.TYP_READONLY {
		return prepareLayoutIn(c, t.Elem, pos, seen, soft)
	}
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		return prepareLayoutIn(c, t.Elem, pos, seen, true)
	}
	if t.Kind == types.TYP_STRUCT {
		var ok bool = true
		for i := 0; i < len(t.Fields); i++ {
			ok = prepareLayoutIn(c, t.Fields[i].Type, pos, seen, soft) && ok
		}
		return ok
	}
	return true
}

// prepareBatchType collects the batch's type declaration d, if collection has
// not reached it, then the types it holds by value, and checks that it does not
// hold itself by value.  Reached softly (prepareLayoutIn), a type still being
// collected is no cycle, and d is prepared again when reached by value.
func prepareBatchType(c @Checker, d @ast.Decl, pos token.Pos, soft bool) bool {
	var b @DeclBatch = c.Batch
	if declInVec(b.TypesPrepared, d) || declInList(b.TypesWalking, d) {
		return true
	}
	if declInList(b.TypesCollecting, d) {
		if soft {
			return true
		}
		errCyclicType(c, pos, buf.CopyStr(d.Name))
		return false
	}
	var saved declContext = enterPackageDecl(c, d)
	var sym @Symbol = c.Scope.Lookup(d.Name)
	if sym != nil && sym.Type != nil && sym.Type.Kind == types.TYP_NAMED &&
			sym.Type.Underlying == nil {
		collectBatchTypeDecl(c, d)
		b.TypesCollected.Push(d)
	}
	b.TypesWalking = slices.Append[@ast.Decl](b.TypesWalking, d)
	sym = c.Scope.Lookup(d.Name)
	var ok bool = true
	if sym != nil && sym.Type != nil {
		var seen typeVisits
		ok = prepareLayoutIn(c, sym.Type.Underlying, pos, &seen, soft)
	}
	b.TypesWalking = b.TypesWalking[:len(b.TypesWalking) - 1]
	if sym != nil {
		checkTypeByValueCycle(c, sym.Type, d)
	}
	leavePackageDecl(c, saved)
	if !soft {
		b.TypesPrepared.Push(d)
	}
	return ok
}

// batchTypeDeclOf returns the declaration, among the batch's type declarations
// (an alias's names no type of its own), of the named type t, or nil when t is
// none of them: an instance, or a type the package scope does not hold under
// its name — another package's — is rejected before the declarations are
// searched.
func batchTypeDeclOf(c @Checker, t @types.Type) @ast.Decl {
	var none @ast.Decl
	if t.InstDecl != nil {
		return none
	}
	var sym @Symbol = c.PackageScope.LookupLocal(t.Name)
	if sym == nil || !same(sym.Type, t) {
		return none
	}
	var d @ast.Decl = findDeclIn(c.Batch.Types, t.Name)
	if d == nil || d.IsAlias {
		return none
	}
	return d
}

// collectBatchTypeDecl collects the type declaration d — nothing to do when
// it was collected on demand already — marking it as being collected while it
// is, so a `sizeof` / `alignof` of it that its own collection reads is reported
// as a cycle (prepareLayout).
func collectBatchTypeDecl(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	if b == nil || isBlank(d.Name) {
		collectTypeDecl(c, d)
		return
	}
	if declInList(b.TypesCollecting, d) || declInVec(b.TypesCollected, d) {
		return
	}
	b.TypesCollecting = slices.Append[@ast.Decl](b.TypesCollecting, d)
	collectTypeDecl(c, d)
	b.TypesCollecting = b.TypesCollecting[:len(b.TypesCollecting) - 1]
}
