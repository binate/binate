package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// batchTypeDeclOf returns the declaration, among the batch's type declarations
// (an alias's names no type of its own), of the named type t, or nil when t is
// none of them: an instance, or a type the package scope does not hold under
// its name — another package's — is rejected before the declarations are
// searched.
func batchTypeDeclOf(c @Checker, t @types.Type) @ast.Decl {
	var none @ast.Decl
	if t.InstDecl != nil || c.PackageScope == nil {
		return none
	}
	var sym @Symbol = c.PackageScope.LookupLocal(t.Name)
	if sym == nil || !same(sym.Type, t) {
		return none
	}
	var d @ast.Decl = findDeclIn(c.Batch.Types, t.Name)
	if d == nil || d.IsAlias {
		return none
	}
	return d
}

// collectBatchTypeDecl collects the type declaration d — nothing to do when
// it was collected on demand already — marking it as being collected while it
// is, so a `sizeof` / `alignof` of it that its own collection reads is reported
// as a cycle (prepareLayout).
func collectBatchTypeDecl(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	if b == nil || isBlank(d.Name) {
		collectTypeDecl(c, d)
		return
	}
	if b.TypesCollecting.has(d) || b.TypesCollected.has(d) {
		return
	}
	b.TypesCollecting.push(d)
	collectTypeDecl(c, d)
	b.TypesCollecting.pop()
	flushLayoutWaits(c)
}
