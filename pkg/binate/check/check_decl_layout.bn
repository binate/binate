package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Layouts needed during collection (see check_decl_batch.bn): a `sizeof` /
// `alignof` read while collectDeclsBody runs — in an array length, or in a
// constant an array length reads — needs the layout of types collection may
// not have reached yet.

// prepareLayout readies the layout of the type te for a `sizeof` / `alignof`
// at pos while collection runs: the package's type declarations te holds by
// value — through struct fields, array elements, alias targets, instance type
// arguments and generic struct fields, not through pointers, slices or
// function values — are collected first where collection has not reached
// them, and checked for holding themselves by value.  A type whose own
// collection reads its layout (`type A [sizeof(A)]uint8`, or through a
// constant: `type A [S]uint8; const S = sizeof(A)`) is a cycle, reported at
// pos; prepareLayout then returns false.
func prepareLayout(c @Checker, te @ast.TypeExpr, pos token.Pos) bool {
	if c.Batch == nil || !c.Batch.Collecting {
		return true
	}
	var noParams @[]@ast.TypeParam
	return prepareLayoutIn(c, te, pos, noParams)
}

// prepareLayoutIn is prepareLayout's walk over the type expression te, inside
// a generic declaration whose type parameters are params (whose names are not
// the package's types).
func prepareLayoutIn(c @Checker, te @ast.TypeExpr, pos token.Pos, params *[]@ast.TypeParam) bool {
	if te == nil {
		return true
	}
	if te.Kind == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 || namesTypeParam(params, te.Name) {
			return true
		}
		return prepareBatchType(c, te.Name, pos)
	}
	if te.Kind == ast.TEXPR_INSTANTIATE {
		var ok bool = true
		for i := 0; i < len(te.TypeArgs); i++ {
			ok = prepareLayoutIn(c, te.TypeArgs[i], pos, params) && ok
		}
		if te.Base != nil && te.Base.Kind == ast.TEXPR_NAMED && len(te.Base.Pkg) == 0 {
			ok = prepareGenericFields(c, te.Base.Name, pos) && ok
		}
		return ok
	}
	if te.Kind == ast.TEXPR_STRUCT {
		var ok bool = true
		for i := 0; i < len(te.Fields); i++ {
			ok = prepareLayoutIn(c, te.Fields[i].Type, pos, params) && ok
		}
		return ok
	}
	if te.Kind == ast.TEXPR_ARRAY || te.Kind == ast.TEXPR_PAREN || te.Kind == ast.TEXPR_CONST {
		return prepareLayoutIn(c, te.Base, pos, params)
	}
	// A pointer, slice or function value has the same layout whatever it
	// refers to.
	return true
}

// prepareBatchType collects the batch's type declaration name, if collection
// has not reached it, then the types it holds by value, and checks that it
// does not hold itself by value.
func prepareBatchType(c @Checker, name *[]readonly char, pos token.Pos) bool {
	var b @DeclBatch = c.Batch
	var d @ast.Decl = findDeclIn(b.Types, name)
	if d == nil || declInVec(b.TypesPrepared, d) || declInList(b.TypesWalking, d) {
		return true
	}
	if declInList(b.TypesCollecting, d) {
		errCyclicType(c, pos, buf.CopyStr(name))
		return false
	}
	var saved declContext = enterPackageDecl(c, d)
	var sym @Symbol = c.Scope.Lookup(d.Name)
	if !d.IsAlias && sym != nil && sym.Type != nil && sym.Type.Kind == types.TYP_NAMED &&
			sym.Type.Underlying == nil {
		collectBatchTypeDecl(c, d)
		b.TypesCollected.Push(d)
	}
	b.TypesWalking = slices.Append[@ast.Decl](b.TypesWalking, d)
	var noParams @[]@ast.TypeParam
	var ok bool = prepareLayoutIn(c, d.TypeRef, pos, noParams)
	b.TypesWalking = b.TypesWalking[:len(b.TypesWalking) - 1]
	sym = c.Scope.Lookup(d.Name)
	if !d.IsAlias && sym != nil {
		checkTypeByValueCycle(c, sym.Type, d)
	}
	leavePackageDecl(c, saved)
	b.TypesPrepared.Push(d)
	return ok
}

// prepareGenericFields prepares, once, the types the fields of the generic
// struct declaration name hold by value.
func prepareGenericFields(c @Checker, name *[]readonly char, pos token.Pos) bool {
	var b @DeclBatch = c.Batch
	var noPkg *[]readonly char
	var g @ast.Decl = lookupGenericTypeDeclPkg(c, noPkg, name)
	if g == nil || g.TypeRef == nil || declInList(b.GenericsPrepared, g) {
		return true
	}
	b.GenericsPrepared = slices.Append[@ast.Decl](b.GenericsPrepared, g)
	var saved declContext = enterPackageDecl(c, g)
	var ok bool = prepareLayoutIn(c, g.TypeRef, pos, g.TypeParams)
	leavePackageDecl(c, saved)
	return ok
}

// namesTypeParam reports whether name is one of params' names.
func namesTypeParam(params *[]@ast.TypeParam, name *[]readonly char) bool {
	for i := 0; i < len(params); i++ {
		if params[i] != nil && types.CharEq(params[i].Name, name) {
			return true
		}
	}
	return false
}

// collectBatchTypeDecl collects the type declaration d — nothing to do when
// it was collected on demand already — marking it as being collected while it
// is, so a `sizeof` / `alignof` of it that its own collection reads is reported
// as a cycle (prepareLayout).
func collectBatchTypeDecl(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	if b == nil || isBlank(d.Name) {
		collectTypeDecl(c, d)
		return
	}
	if declInList(b.TypesCollecting, d) || declInVec(b.TypesCollected, d) {
		return
	}
	b.TypesCollecting = slices.Append[@ast.Decl](b.TypesCollecting, d)
	collectTypeDecl(c, d)
	b.TypesCollecting = b.TypesCollecting[:len(b.TypesCollecting) - 1]
}
