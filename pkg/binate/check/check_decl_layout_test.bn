package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_decl_layout.bn: the layout of a type read during collection
// (a `sizeof` in an array length, or in a constant one reads), with the types
// it holds by value collected first, and layout cycles reported.

// A type whose array length reads its own size through a constant is one
// error: a cyclic type definition.
func TestLayoutCycleThroughConst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type A [S]uint8\n"
			"const S = sizeof(A)\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `A`") != 1 {
		return "expected exactly the cyclic-type error for A"
	}
	return ""
}

// A type whose array length reads its own size directly is a cyclic type
// definition too.
func TestLayoutSelfSizedArray() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type X [sizeof(X)]uint8\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cyclic type definition involving `X`") != 1 {
		return "expected the cyclic-type error for X"
	}
	return ""
}

// A type may read the size of a pointer to itself: a pointer's layout does not
// depend on what it points to.
func TestLayoutThroughPointerIsNotCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N struct { next *N; pad [sizeof(*N)]uint8 }\n"
	return expectNoErrors(checkSrc(src))
}

// An array length reads the size of a generic instantiation over a type
// declared after it; the instantiation holds that type by value.
func TestLayoutGenericInstanceOfLaterType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Sized [sizeof(Box[Pt])]uint8\n"
			"type Box[T any] struct { v T; n int32 }\n"
			"type Pt struct { x int32; y int32 }\n"
			"func use(a [12]uint8) int { return 0 }\n"
			"func f() int { var s Sized; return use(s) }\n"
	return expectNoErrors(checkSrc(src))
}

// A constant takes the size of a struct holding, by value, a struct declared
// after both.
func TestLayoutNestedLaterStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Sized [S]uint8\n"
			"const S = sizeof(Outer)\n"
			"type Outer struct { i Inner; k uint8 }\n"
			"type Inner struct { p int32; q int32 }\n"
			"func use(a [12]uint8) int { return 0 }\n"
			"func f() int { var s Sized; return use(s) }\n"
	return expectNoErrors(checkSrc(src))
}

// Taking the size of types that hold each other by value reports the
// recursive type and does not loop.
func TestLayoutByValueCycleReported() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Sized [sizeof(A)]uint8\n"
			"type A struct { b B }\n"
			"type B struct { a A }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "recursive type") == 0 {
		return "expected a recursive-type error"
	}
	return ""
}

// Two fields holding the same generic instantiation, which holds the struct by
// value, are each reported and cut: the second field's reach through the
// instantiation the first field's walk entered is found too, so taking the size
// reports the recursive type rather than recursing without end.
func TestLayoutByValueCycleThroughRepeatedInstance() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"type C struct { a Box[C]; b Box[C] }\n"
			"const S = sizeof(C)\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "recursive type") == 0 {
		return "expected a recursive-type error"
	}
	return ""
}

// A generic struct's type parameter may share a package type's name: the
// generic's fields name the parameter, not the package type, so reading the
// package type's layout from inside its own collection is no cycle.
func TestLayoutGenericParamShadowsPackageType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T struct { a [sizeof(Box[int])]uint8 }\n"
			"type Box[T any] struct { v T }\n"
	return expectNoErrors(checkSrc(src))
}

// A struct type repeated through twenty nesting levels -- each level four fields
// of the level below -- is checked in time linear in the levels: its by-value
// walks (opaque embedding, a by-value cycle through the declaration, type-param
// layout) enter each type once.  Walked as a tree they would visit 4^20 types and
// this test would not finish.
func TestCheckRepeatedStructDag() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\ntype L0 struct { x int8 }\n")
	for n := 1; n <= 20; n++ {
		var prev @[]char = levelName(n - 1)
		b.Write("type ")
		b.Write(levelName(n))
		b.Write(" struct { f0 ")
		b.Write(prev)
		b.Write("; f1 ")
		b.Write(prev)
		b.Write("; f2 ")
		b.Write(prev)
		b.Write("; f3 ")
		b.Write(prev)
		b.Write(" }\n")
	}
	b.Write("func f() int { var v L20; var w L19 = v.f3; _ = w; ")
	b.Write("const S = sizeof(L20); return cast(int, S) }\n")
	return expectNoErrors(checkSrc(b.String()))
}

// levelName returns "L<n>".
func levelName(n int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('L')
	if n >= 10 { b.WriteByte(cast(char, cast(int, '0') + n / 10)) }
	b.WriteByte(cast(char, cast(int, '0') + n % 10))
	return buf.CopyStr(b.String())
}
