package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// declNameFirsts holds, for each name among the declarations added to it in turn, the
// first declaration of the name and the first that declares no type, so whether an
// earlier declaration clashes with one is found in time independent of how many
// there are: two type declarations of one name are not a clash here (a `.bni`
// forward `type T` and the `.bn`'s definition, which checkTypeRedeclaration judges),
// any other two are.  Its keys borrow the declarations' names.
type declNameFirsts struct {
	index      @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq]
	first      @vec.Vec[@ast.Decl]
	firstValue @vec.Vec[@ast.Decl]
}

// newDeclNameFirsts returns an empty declNameFirsts.
func newDeclNameFirsts() @declNameFirsts {
	var s @declNameFirsts = make(declNameFirsts)
	s.index = table.NewTable[*[]readonly char, int, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	s.first = vec.New[@ast.Decl]()
	s.firstValue = vec.New[@ast.Decl]()
	return s
}

// earlier returns the first declaration added that clashes with d -- for a type
// declaration, the first of its name that declares no type; for any other, the first
// of its name -- or nil.
func (s @declNameFirsts) earlier(d @ast.Decl) @ast.Decl {
	i, found := s.index.Get(d.Name)
	if !found { return nil }
	if d.Kind == ast.DECL_TYPE { return s.firstValue.Get(i) }
	return s.first.Get(i)
}

// add adds d, the first of its name if none was added before, and the first of its
// name that declares no type if it declares none.
func (s @declNameFirsts) add(d @ast.Decl) {
	i, found := s.index.Get(d.Name)
	if !found {
		i = s.first.Len()
		s.index.Put(d.Name, i)
		s.first.Push(d)
		var none @ast.Decl
		s.firstValue.Push(none)
	}
	if d.Kind != ast.DECL_TYPE && s.firstValue.Get(i) == nil { s.firstValue.Set(i, d) }
}
