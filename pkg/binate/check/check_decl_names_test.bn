package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_decl_names.bn.

// namesDecl returns a declaration of kind named name.
func namesDecl(kind int, name *[]readonly char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = kind
	d.Name = buf.CopyStr(name)
	return d
}

// Two type declarations of a name do not clash; a type and a variable of it do, in
// either order, with the first that does; two functions of a name do.
func TestDeclNameFirsts() testing.TestResult {
	var s @declNameFirsts = newDeclNameFirsts()
	var t1 @ast.Decl = namesDecl(ast.DECL_TYPE, "T")
	var t2 @ast.Decl = namesDecl(ast.DECL_TYPE, "T")
	var v @ast.Decl = namesDecl(ast.DECL_VAR, "T")
	var t3 @ast.Decl = namesDecl(ast.DECL_TYPE, "T")
	s.add(t1)
	if s.earlier(t2) != nil { return fail("two types of a name do not clash") }
	s.add(t2)
	if !same(s.earlier(v), t1) { return fail("a var clashes with the first type of its name") }
	s.add(v)
	if !same(s.earlier(t3), v) { return fail("a type clashes with the var of its name") }
	var f1 @ast.Decl = namesDecl(ast.DECL_FUNC, "f")
	if s.earlier(f1) != nil { return fail("a new name clashes with none") }
	s.add(f1)
	if !same(s.earlier(namesDecl(ast.DECL_FUNC, "f")), f1) { return fail("two funcs of a name clash") }
	return ""
}
