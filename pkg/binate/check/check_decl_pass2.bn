package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"

// Top-level declaration checking, pass 2: type-checking each declaration —
// function bodies, variable initializers, const values, and groups — after
// pass 1 (check_decl.bn) has collected them.

// ============================================================
// Declaration Checking (Pass 2)
// ============================================================

// checkDecls runs pass 2: type-checks function bodies, variable initializers, and const values.
func checkDecls(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		// File-scoped imports (see collectDeclsBody): check each decl's body
		// under its own file's import scope.
		if fileScopedActive(c) {
			c.Scope = scopeForFile(c, d.Pos.File)
		}
		if d.Kind == ast.DECL_FUNC {
			checkFuncDecl(c, d)
		}
		if d.Kind == ast.DECL_VAR {
			checkBatchVarDecl(c, d)
		}
		if d.Kind == ast.DECL_CONST {
			// Batch path: top-level consts with a value were already
			// resolved in dependency order before pass 2
			// (finishTopLevelConsts); re-checking here would double any
			// error.  A value-less const (`const X` with no initializer,
			// not an iota member) is NOT swept, so it must still be checked
			// here to report the missing value.  Outside a batch
			// (ReplDeclMode) all consts resolve here.
			if c.ReplDeclMode || d.Value == nil {
				checkConstDecl(c, d)
			}
		}
		if d.Kind == ast.DECL_GROUP {
			// A top-level const group's members were resolved before pass
			// 2, like a single const (see finishTopLevelConsts), and are not
			// checked again; outside a batch (ReplDeclMode) they resolve
			// here.
			checkGroupDecl(c, d)
		}
		// The declaration is fully checked, so an untyped non-constant integer
		// expression still untyped sits where no type is required: default it.
		finalizeUntypedNonConst(c)
	}
}

// defineDeclVar enters variable declaration d into scope with type t and records
// t on the declaration (Decl.ResolvedTypeID), so a later pass reads the type the
// checker resolved rather than re-deriving it from how the source spells it.
func defineDeclVar(c @Checker, d @ast.Decl, t @types.Type) {
	defineVar(c.Scope, d.Name, t)
	d.ResolvedTypeID = registerExprType(c, t)
}

// checkVarDecl type-checks a variable declaration, validating initializer assignability.
// Blank-identifier declarations (`var _ T`, `var _ T = expr`, `var _ = expr`)
// check the type and the initializer (which still runs) but do NOT enter any
// name into scope.
func checkVarDecl(c @Checker, d @ast.Decl) {
	if isBlank(d.Name) {
		if d.TypeRef != nil {
			var declType @types.Type = resolveTypeExpr(c, d.TypeRef)
			requireSizedType(c, declType, d.Pos)
			// Nothing is bound, but the declared type is recorded as for a named
			// variable (defineDeclVar), for bnlint.
			d.ResolvedTypeID = registerExprType(c, declType)
			if d.Value != nil {
				var valType @types.Type
				var okInit bool
				valType, okInit = checkBorrowingArg(c, d.Value, declType)
				if !okInit {
					errCannotAssign(c, d.Value.Pos, valType, declType)
				}
			}
		} else if d.Value != nil {
			checkExpr(c, d.Value)
		}
		return
	}
	if d.TypeRef != nil && d.Value != nil {
		var declType @types.Type = resolveTypeExpr(c, d.TypeRef)
		requireSizedType(c, declType, d.Pos)
		// B.3b: when the destination is a function-value type,
		// pass it down as a hint so checkFuncLit can resolve a
		// matching literal as @func / *func per the destination
		// rather than always returning the raw form.
		var valType @types.Type
		var okInit bool
		valType, okInit = checkBorrowingArg(c, d.Value, declType)
		if !okInit && !stringLitInitFitsArray(d.Value, valType, declType) {
			errCannotAssign(c, d.Value.Pos, valType, declType)
		}
		defineDeclVar(c, d, declType)
	} else if d.TypeRef != nil {
		var declType @types.Type = resolveTypeExpr(c, d.TypeRef)
		// A value-typed variable needs the type's layout; reject opaque.
		// checkVarDecl runs in pass 2 (post-collection), so a forward ref
		// is resolved here — no race (`var p *Opaque` / `@Opaque` are fine).
		requireSizedType(c, declType, d.Pos)
		defineDeclVar(c, d, declType)
	} else if d.Value != nil {
		// A local declaration arrives with BorrowPosKind already BORROWING
		// (checkStmt's declaration arm).
		// TODO: whether a package-level initializer is a borrowing position too
		// is the claude-todo.md entry "A package-level `var g *any = 42` borrows
		// a temporary of the init function".
		var rawType @types.Type = checkExpr(c, d.Value)
		var valType @types.Type = defaultType(rawType)
		if rejectNilInference(c, d.Value.Pos, rawType) {
			valType = types.TypError()
		}
		// Fit-check an untyped-int literal against its default type, mirroring
		// the explicit `var x T = e` path — `var x = 0xFFFFFFFFFFFFFFFF` must be
		// rejected, not silently wrapped to int -1 (const.default.int-width).
		checkDefaultIntFits(c, d.Value.Pos, rawType, valType)
		// An inferred var binds a value of valType; reject inferring an opaque
		// (or opaque-embedding) value the composite-literal gate doesn't see —
		// e.g. `var x = *opaquePtr` (deref load) or `var x = genRetOpaque()`.
		// Pass 2, so no forward-ref race.
		requireSizedType(c, valType, d.Pos)
		defineDeclVar(c, d, valType)
	}
}

// checkBniVarMatch verifies a `.bn` `var X T` definition agrees with a
// `.bni` `var X T2` extern declaration: the types must be identical, or
// an importer — which reads X's type from the `.bni` — would misread the
// `.bn`-defined storage.  Mirrors checkBniSignatureMatch for funcs; the
// `.bni` symbol was pre-loaded into the package scope (CheckPackage),
// so a SYM_VAR already in scope under this name came from the `.bni`.
func checkBniVarMatch(c @Checker, d @ast.Decl, bnType @types.Type) {
	if c.AllowRedef { return }
	// The `.bni` symbol lives in the package scope; under file-scoped imports
	// c.Scope is the current decl's file scope, so look in the package scope
	// (pkgScopeLookupLocal falls back to c.Scope on the single-file/REPL path).
	var existing @Symbol = pkgScopeLookupLocal(c, d.Name)
	if existing == nil { return }
	if existing.Kind != types.SYM_VAR { return }
	var bniType @types.Type = existing.Type
	if bniType == nil || bnType == nil { return }
	if !bniType.Identical(bnType) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(d.Name)
		cb.Write(": .bn defines var of type ")
		cb.Write(bnType.TypeName())
		cb.Write(" but .bni declares ")
		cb.Write(bniType.TypeName())
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
	}
}

// checkBniVarsDefined reports each `.bni` `var` that none of the package's `.bn`
// files defines.  A `.bni` `var X T` only declares X; its storage and initial
// value are the implementation's to provide (§9.2 decl.var.extern, §16.5) — an
// initializer written on the `.bni` declaration does not change that — so without
// a `.bn` definition an importer reading X has nothing to read (an IR-gen panic or
// a link failure).  Only the package's own compile sees its `.bn` files.  A
// package loaded with none is not checked, since its implementation may be
// outside this compile: the loader reads an interpreter's injected or
// compiled-in package from its `.bni` alone (Loader.InterfaceOnly).
func checkBniVarsDefined(c @Checker, bni @ast.File, files @[]@ast.File) {
	if bni == nil || len(files) == 0 {
		return
	}
	reportUndefinedBniVars(c, bni.Decls, files)
}

// reportUndefinedBniVars walks a `.bni`'s top-level declarations (into groups).
func reportUndefinedBniVars(c @Checker, decls *[]@ast.Decl, files @[]@ast.File) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			reportUndefinedBniVars(c, d.Decls, files)
			continue
		}
		if d.Kind != ast.DECL_VAR || len(d.Name) == 0 || isBlank(d.Name) || bnDefinesVar(files, d.Name) {
			continue
		}
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("var ")
		cb.Write(d.Name)
		cb.Write(" is declared in the .bni but not defined in the package's .bn files")
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
	}
}

// bnDefinesVar reports whether some file declares a top-level `var name`.
func bnDefinesVar(files @[]@ast.File, name *[]readonly char) bool {
	for i := 0; i < len(files); i++ {
		if files[i] != nil && declsDefineVar(files[i].Decls, name) {
			return true
		}
	}
	return false
}

// declsDefineVar reports whether decls (into groups) declare `var name`.
func declsDefineVar(decls *[]@ast.Decl, name *[]readonly char) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP && declsDefineVar(d.Decls, name) {
			return true
		}
		if d.Kind == ast.DECL_VAR && types.CharEq(d.Name, name) {
			return true
		}
	}
	return false
}
