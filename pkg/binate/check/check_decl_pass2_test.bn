package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for declaration checking pass 2 (check_decl_pass2.bn): variable
// declarations and their initializers.

func TestCheckVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x @[]readonly char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
