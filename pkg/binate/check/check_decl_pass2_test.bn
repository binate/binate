package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for declaration checking pass 2 (check_decl_pass2.bn): variable
// declarations and their initializers.

func TestCheckVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x @[]readonly char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A `.bni` variable whose type depends on itself is the error type once the
// cycle is reported, and is no mismatch with its `.bn` definition
// (checkBniVarMatch).
func TestCheckBniVarMatchSkipsTypeCycle() testing.TestResult {
	var c @Checker = NewChecker()
	_, _ = checkBniPkgFiles(c, "package \"q\"\nvar A [len(B)]int\nvar B [len(A)]int\n",
			"package \"q\"\nvar A [3]int\nvar B [3]int\n", false)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) == 0 { return fail("expected the type cycle reported") }
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "defines var of type") { return fail(errs[i].Msg) }
	}
	return ""
}

// So is a `.bn` variable or function whose array length a cycle poisoned: the
// `.bni` declaration's array is the error type too, not one of length 0
// (evalArrayLen), and is not compared.
func TestCheckBniMatchSkipsPoisonedLength() testing.TestResult {
	var bni *[]readonly char =
		"package \"q\"\nvar V [sizeof(Box[int64])]int\nfunc f() [sizeof(Box[int64])]int\n"
				"type Box[T any] struct { a [len(V)]uint8; b [len(f())]uint8; t T }\n"
	var c @Checker = NewChecker()
	_, _ = checkBniPkgFiles(c, bni,
			"package \"q\"\nvar V [sizeof(Box[int64])]int\n"
					"func f() [sizeof(Box[int64])]int { var r [sizeof(Box[int64])]int; return r }\n",
			false)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) == 0 { return fail("expected the cycle reported") }
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "mismatch") || charsHaveSub(errs[i].Msg, "defines var of type") {
			return fail(errs[i].Msg)
		}
	}
	return ""
}
