package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/table"
import "pkg/std/vec"

// declSet is a list of declarations, in the order added, with an index of them by
// identity, so a declaration is looked for in time independent of how many there are:
// the declarations a batch is collecting, walking or has prepared on demand
// (DeclBatch) number as many as a chain of declarations each holding the next is long.
// A declaration may be in it more than once; the index counts them.
type declSet struct {
	decls @vec.Vec[@ast.Decl]
	index @table.Table[@ast.Decl, int, instanceDeclHasher, instanceDeclEq]
}

// newDeclSet returns an empty declSet.
func newDeclSet() @declSet {
	var s @declSet = make(declSet)
	s.decls = vec.New[@ast.Decl]()
	s.index = table.NewTable[@ast.Decl, int, instanceDeclHasher, instanceDeclEq](
			instanceDeclHasher{}, instanceDeclEq{})
	return s
}

// has reports whether d is in s.
func (s @declSet) has(d @ast.Decl) bool {
	return s.index.Has(d)
}

// push adds d to the end of s.
func (s @declSet) push(d @ast.Decl) {
	s.decls.Push(d)
	n, _ := s.index.Get(d)
	s.index.Put(d, n + 1)
}

// pop takes the declaration last added off s.
func (s @declSet) pop() {
	d, _ := s.decls.Pop()
	n, _ := s.index.Get(d)
	if n <= 1 {
		_ = s.index.Remove(d)
	} else {
		s.index.Put(d, n - 1)
	}
}

// count returns how many declarations s holds.
func (s @declSet) count() int {
	return s.decls.Len()
}
