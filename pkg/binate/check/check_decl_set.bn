package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// declSet is a list of declarations, in the order added, with an index of them by
// identity, so a declaration is looked for in time independent of how many there are:
// the declarations a batch is collecting, walking, resolving, checking or defining on
// demand (DeclBatch) number as many as a chain of declarations each reading the next
// is long, and those it has checked, deferred or found in a cycle as many as it has.
// A declaration may be in it more than once; the index counts them.
type declSet struct {
	decls @vec.Vec[@ast.Decl]
	index @table.Table[@ast.Decl, int, instanceDeclHasher, instanceDeclEq]
}

// newDeclSet returns an empty declSet.
func newDeclSet() @declSet {
	var s @declSet = make(declSet)
	s.decls = vec.New[@ast.Decl]()
	s.index = table.NewTable[@ast.Decl, int, instanceDeclHasher, instanceDeclEq](
			instanceDeclHasher{}, instanceDeclEq{})
	return s
}

// has reports whether d is in s.
func (s @declSet) has(d @ast.Decl) bool {
	return s.index.Has(d)
}

// push adds d to the end of s.
func (s @declSet) push(d @ast.Decl) {
	s.decls.Push(d)
	n, _ := s.index.Get(d)
	s.index.Put(d, n + 1)
}

// pop takes the declaration last added off s; an empty s is an internal error.
func (s @declSet) pop() {
	d, popped := s.decls.Pop()
	if !popped { panic("internal error: a declaration popped from an empty set") }
	n, _ := s.index.Get(d)
	if n <= 1 {
		_ = s.index.Remove(d)
	} else {
		s.index.Put(d, n - 1)
	}
}

// count returns how many declarations s holds.
func (s @declSet) count() int {
	return s.decls.Len()
}

// truncate takes the entries after the first n off s.
func (s @declSet) truncate(n int) {
	for s.decls.Len() > n { s.pop() }
}

// at returns s's entry at position i, counting from the first added.
func (s @declSet) at(i int) @ast.Decl {
	return s.decls.Get(i)
}

// items returns a view of s's entries, in order.
func (s @declSet) items() @[]@ast.Decl {
	return s.decls.Items()
}

// removeAll takes every entry of d off s, keeping the others in order.
func (s @declSet) removeAll(d @ast.Decl) {
	if !s.index.Has(d) { return }
	var kept @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	for i := 0; i < s.decls.Len(); i++ {
		if !same(s.decls.Get(i), d) { kept.Push(s.decls.Get(i)) }
	}
	_ = s.index.Remove(d)
	s.decls = kept
}

// lastIndex returns the position of d's last entry in s, or -1: -1 from the index when
// d is not in s, else by a search from the top down.
func (s @declSet) lastIndex(d @ast.Decl) int {
	if !s.index.Has(d) { return -1 }
	for i := s.decls.Len() - 1; i >= 0; i-- {
		if same(s.decls.Get(i), d) { return i }
	}
	return -1
}
