package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// A declSet finds the declarations in it by identity, counts one added twice, and
// forgets one popped as often as it was added.
func TestDeclSet() testing.TestResult {
	var s @declSet = newDeclSet()
	var a @ast.Decl = make(ast.Decl)
	var b @ast.Decl = make(ast.Decl)
	if s.has(a) || s.count() != 0 { return fail("a new set is empty") }
	s.push(a)
	s.push(b)
	s.push(a)
	if !s.has(a) || !s.has(b) || s.count() != 3 { return fail("both are in the set, a twice") }
	s.pop()
	if !s.has(a) { return fail("a is still in the set once") }
	s.pop()
	if s.has(b) || !s.has(a) { return fail("b popped, a still in") }
	s.pop()
	if s.has(a) || s.count() != 0 { return fail("the set is empty again") }
	if s.has(make(ast.Decl)) { return fail("a declaration never added is not in the set") }
	return ""
}

// removeAll takes every entry of a declaration, keeping the rest in order; lastIndex finds
// a declaration's last entry; truncate drops the entries after a mark; items views them.
func TestDeclSetRemoveTruncate() testing.TestResult {
	var s @declSet = newDeclSet()
	var a @ast.Decl = make(ast.Decl)
	var b @ast.Decl = make(ast.Decl)
	var d @ast.Decl = make(ast.Decl)
	s.push(a)
	s.push(b)
	s.push(a)
	s.push(d)
	if s.lastIndex(a) != 2 || s.lastIndex(b) != 1 || s.lastIndex(make(ast.Decl)) != -1 {
		return fail("a last at 2, b at 1, a stranger nowhere")
	}
	s.removeAll(a)
	if s.has(a) || s.count() != 2 || !same(s.items()[0], b) || !same(s.items()[1], d) {
		return fail("b, d once every a is removed")
	}
	s.push(a)
	s.truncate(1)
	if s.count() != 1 || s.has(d) || s.has(a) || !s.has(b) {
		return fail("b alone after truncating to 1")
	}
	return ""
}
