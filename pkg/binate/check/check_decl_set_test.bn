package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// A declSet finds the declarations in it by identity, counts one added twice, and
// forgets one popped as often as it was added.
func TestDeclSet() testing.TestResult {
	var s @declSet = newDeclSet()
	var a @ast.Decl = make(ast.Decl)
	var b @ast.Decl = make(ast.Decl)
	if s.has(a) || s.count() != 0 { return fail("a new set is empty") }
	s.push(a)
	s.push(b)
	s.push(a)
	if !s.has(a) || !s.has(b) || s.count() != 3 { return fail("both are in the set, a twice") }
	s.pop()
	if !s.has(a) { return fail("a is still in the set once") }
	s.pop()
	if s.has(b) || !s.has(a) { return fail("b popped, a still in") }
	s.pop()
	if s.has(a) || s.count() != 0 { return fail("the set is empty again") }
	if s.has(make(ast.Decl)) { return fail("a declaration never added is not in the set") }
	return ""
}
