package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for checkDefaultIntFits: the `:=`, `var x = e`, and `box(e)`
// default-type inference paths fit-check an untyped-int literal against its
// chosen default type (const.default.int-width, §6.2), rejecting an
// out-of-range literal rather than silently wrapping it.  The boundary-ACCEPT
// cases (INT64_MAX, INT_MIN) pin the FitsSigned(64) edge against a future
// too-tight bound, on a 64-bit target (checkSrcLP64): on a 32-bit one these exceed
// `int`.

// checkSrcLP64 type-checks src with the target's `int` / `uint` 64 bits wide (and
// pointers 8 bytes), restoring the target afterwards.
func checkSrcLP64(src *[]readonly char) @Checker {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
	var c @Checker = checkSrc(src)
	types.SetTarget(old)
	return c
}

// anyErrContains reports whether any of the checker's errors contains needle.
func anyErrContains(c @Checker, needle *[]readonly char) bool {
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if msgContains(errs[i].Msg, needle) { return true }
	}
	return false
}

func TestShortVarOversizedIntRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"func main() { x := 0xFFFFFFFFFFFFFFFF; _ = x }\n")
	if !anyErrContains(c, "cannot assign untyped int to int") {
		return fail("expected fit-check rejection for := oversized literal")
	}
	return ""
}

func TestVarInferOversizedIntRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"func main() { var x = 0xFFFFFFFFFFFFFFFF; _ = x }\n")
	if !anyErrContains(c, "cannot assign untyped int to int") {
		return fail("expected fit-check rejection for var-infer oversized literal")
	}
	return ""
}

func TestBoxOversizedIntRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"func main() { var p @int = box(0xFFFFFFFFFFFFFFFF); _ = p }\n")
	if !anyErrContains(c, "cannot assign untyped int to int") {
		return fail("expected fit-check rejection for box oversized literal")
	}
	return ""
}

func TestShortVarInt64MaxAccepted() testing.TestResult {
	// 0x7FFFFFFFFFFFFFFF = INT64_MAX -- the just-fits boundary; must NOT be
	// rejected against a 64-bit target's default int.
	var c @Checker = checkSrcLP64(
			"package \"main\"\n"
					"func main() { x := 0x7FFFFFFFFFFFFFFF; _ = x }\n")
	return expectNoErrors(c)
}

func TestShortVarIntMinAccepted() testing.TestResult {
	// -0x8000000000000000 = INT_MIN -- the asymmetric two's-complement minimum;
	// FitsSigned(64) accepts it (magnitude 2^63), so it must NOT be rejected.
	var c @Checker = checkSrcLP64(
			"package \"main\"\n"
					"func main() { x := -0x8000000000000000; _ = x }\n")
	return expectNoErrors(c)
}
