package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Checker tests for defer statements (§14.13): deferred blocks, stmt.defer.block
// (no `return`, no `break` / `continue` leaving the deferred block), and the REPL
// prompt's top level.

// A deferred block of statements is accepted, at the top of a function body and
// in a loop body — where it runs at the end of every iteration.
func TestCheckDeferBlockOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f(n int) { defer { g(); g() }; for i := 0; i < n; i++ { defer { g() } } }\n")
	return expectNoErrors(c)
}

// A defer in an `if` or a nested block is accepted.
func TestCheckDeferNestedBlockOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f(cond bool) { if cond { defer { g() } }; { { defer { g() } } } }\n")
	return expectNoErrors(c)
}

// A defer inside a deferred block is accepted.
func TestCheckDeferInDeferOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\nfunc f() { defer { defer { g() }; g() } }\n")
	return expectNoErrors(c)
}

// A deferred block sees the names in scope at the defer statement, not a
// variable declared after it.
func TestCheckDeferSeesEarlierNamesOnly() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { defer { x = 1 }; var x int = 0; _ = x }\n")
	return expectErrSub(c, "undefined")
}

// stmt.defer.block: a `return` in a deferred block is rejected.
func TestCheckDeferReturnRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f() { defer { return } }\n")
	return expectErrSub(c, "a deferred block may not return")
}

// stmt.defer.block: a `break` / `continue` leaving the deferred block is rejected,
// though the defer is in a loop.
func TestCheckDeferBreakRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { for i := 0; i < 3; i++ { defer { break } } }\n")
	return expectErrSub(c, "break may not leave a deferred block")
}

func TestCheckDeferContinueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { for i := 0; i < 3; i++ { defer { continue } } }\n")
	return expectErrSub(c, "continue may not leave a deferred block")
}

// A `break` in a deferred block with no loop or switch around it at all is an
// ordinary misplaced break.
func TestCheckDeferBreakNoLoop() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f() { defer { break } }\n")
	return expectErrSub(c, "break outside loop or switch")
}

// A `break` / `continue` targeting a loop inside the deferred block, and a
// `return` in a function literal in it, are accepted.
func TestCheckDeferInnerTargetsOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { defer { for i := 0; i < 3; i++ { "
					"if i == 1 { continue }; break }; var h @func() int = func() int { return 1 }; "
					"_ = h } }\n")
	return expectNoErrors(c)
}

// stmt.defer: a defer at the REPL prompt's top level has no enclosing block to
// wait for and is rejected.
func TestCheckDeferImmediateModeRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc g() {}\n")
	var pst @parser.Parser = parser.New(toBytes("defer { g() }"), "<repl>")
	var ss @[]@ast.Stmt = pst.ParseStmtList()
	c.CheckStmtListInScope(ss)
	return expectErrSub(c, "defer at the prompt's top level would run at once")
}

// A defer in a block typed at the prompt is accepted: it runs at that block's
// exit.
func TestCheckDeferImmediateModeNestedOK() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc g() {}\n")
	var pst @parser.Parser = parser.New(toBytes("if true { defer { var y int = 1; _ = y } }"),
			"<repl>")
	var ss @[]@ast.Stmt = pst.ParseStmtList()
	c.CheckStmtListInScope(ss)
	return expectNoErrors(c)
}
