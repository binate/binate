package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Checking a generic type instantiation's constraints, deferring those checks
// during batch collection, and replaying them once the package's interfaces
// have their parents.
//
// A generic instantiation is constraint-checked the moment a signature naming it
// is resolved.  During collection the package's interfaces do not have their
// parents yet (resolvePendingIfaceParents resolves the extension clauses once
// collection is done), so an instantiation whose type argument satisfies the
// constraint through an impl of a child interface would be wrongly rejected —
// top-level decls are order-independent.  collectDecls therefore sets
// Checker.CollectingDecls, which makes instantiateGenericDeclWithArgs resolve
// instantiations non-user-facing (built and cached for identity, the check
// skipped and left unlatched) and record the deferred check here.
// recheckDeferredConstraints then replays each recorded check after that.
//
// Recording the exact deferred (decl, args, pos) — rather than re-walking the decl
// list by kind and re-resolving "the type expressions that can name a generic" —
// is what makes the replay COMPLETE.  Enumerating by decl kind repeatedly missed
// use-site shapes (a type alias or named-distinct wrapper over an instantiation,
// an interface extension parent or alias target, a generic-receiver method
// signature); the pending list captures whatever was actually deferred, so nothing
// is dropped.

// setMissLevel makes the constraint misses reported until it is restored found
// with no instance's type arguments bound when declLevel, with them otherwise
// (missDeclLevel), and returns what restores it.
func setMissLevel(c @Checker, declLevel bool) int {
	var saved int = c.Generics.MissLevel
	c.Generics.MissLevel = 2
	if declLevel { c.Generics.MissLevel = 1 }
	return saved
}

// collectionDefersChecks reports whether what a user-facing instantiation checks
// where it is named waits for the replay at the end of the collection
// (recheckDeferredConstraints): while a package's `.bni` surface is built
// (BuildingIfaceScope) or its declarations are collected (CollectingDecls), the
// package's interfaces do not have their parents yet, so a check would wrongly
// reject a type argument satisfying the constraint through an impl of a child
// interface.
func collectionDefersChecks(c @Checker) bool {
	return c.BuildingIfaceScope || c.CollectingDecls
}

// listDefersConstraints reports whether the constraint check of an instantiation
// waits for the end of the resolution of a type-parameter list's constraints
// (resolveTypeParamConstraints), where a parameter later in the list has no bound
// yet (gen.typeparams.scope) -- that check only: the instantiation is user-facing
// in every other way.
func listDefersConstraints(c @Checker) bool {
	return c.Generics.ConstraintListDepth > 0 && !collectionDefersChecks(c)
}

// resolveTypeParamConstraints sets the constraint of each of params from the
// parameter of tps at its position (resolveTypeParamConstraint), in a scope that
// binds every parameter of the list.  A constraint may name a later parameter
// (gen.typeparams.scope), whose bound is set only at its own turn, so the
// constraint checks of the instantiations the constraints form wait until every
// parameter has its bound, then are made -- or, while a batch's declarations are
// collected or a `.bni` surface is built, left for its replay.
func resolveTypeParamConstraints(c @Checker, params *[]@types.Type, tps *[]@ast.TypeParam) {
	var fromChecks int = len(c.PendingChecks)
	var fromFuncChecks int = len(c.PendingFuncChecks)
	c.Generics.ConstraintListDepth = c.Generics.ConstraintListDepth + 1
	for i := 0; i < len(tps) && i < len(params); i++ {
		params[i].TpConstraint = resolveTypeParamConstraint(c, tps[i])
	}
	c.Generics.ConstraintListDepth = c.Generics.ConstraintListDepth - 1
	if c.Generics.ConstraintListDepth == 0 && !collectionDefersChecks(c) {
		replayPendingChecks(c, fromChecks, fromFuncChecks)
	}
}

// recordPendingConstraintCheck notes that the checks a user-facing use of
// instantiation (d, args) at usePos makes were deferred -- only its constraint
// check when constraintOnly (listDefersConstraints) -- and replayPendingChecks
// makes them.  Called from instantiateGenericDeclWithArgs on every user-facing
// resolution while they wait, except one whose type arguments mention `Self`,
// which is queued with its interface instead (deferSelfConstraintCheck).
func recordPendingConstraintCheck(c @Checker, d @ast.Decl, args @[]@types.Type, usePos token.Pos,
		view ImplView, constraintOnly bool) {
	var p @PendingConstraintCheck = make(PendingConstraintCheck)
	p.Decl = d
	p.Args = args
	p.Pos = usePos
	p.View = view
	p.Naming = namingAt(c, view)
	p.ConstraintOnly = constraintOnly
	p.DeclLevel = missDeclLevel(c)
	var nw @InstWork
	var nd @ast.Decl
	nw, nd = currentInstanceNaming(c)
	p.Work = nw
	p.WorkDecl = nd
	c.PendingChecks = slices.Append[@PendingConstraintCheck](c.PendingChecks, p)
}

// recheckDeferredConstraints replays every constraint check deferred during the
// batch collection, now that collectDeclsBody has recorded every impl.  Each entry
// fires at most once per view (CheckedViews latches, and identical diagnostics dedup
// by position/message), reporting a genuine miss at the recorded use site against
// the complete impl set.  Mirrors the firing instantiateGenericDeclWithArgs does
// for a first user-facing use, including the interface-method sizing check.  Runs
// once at the end of collectDecls, then clears the list for the next package.
func recheckDeferredConstraints(c @Checker) {
	replayPendingChecks(c, 0, 0)
}

// replayPendingChecks makes the constraint checks recorded from position
// fromChecks of Checker.PendingChecks and fromFuncChecks of PendingFuncChecks on
// (recheckDeferredConstraints, resolveTypeParamConstraints), then drops them.
func replayPendingChecks(c @Checker, fromChecks int, fromFuncChecks int) {
	for i := fromChecks; i < len(c.PendingChecks); i++ {
		var p @PendingConstraintCheck = c.PendingChecks[i]
		if p == nil {
			continue
		}
		if !p.ConstraintOnly && p.Decl != nil && p.Decl.Kind == ast.DECL_TYPE && p.Decl.IsAlias {
			requireAliasArgsKept(c, p.Decl, p.Args, p.Pos, p.View)
		}
		var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, p.Decl, p.Args)
		if entry == nil {
			// A generic alias's instantiations are kept apart from the generic-
			// instantiation cache (AliasInstantiations), so look there too: without
			// it the alias's own constraint is never checked at a collection-time site.
			entry = lookupAliasInstantiation(c, p.Decl, p.Args)
		}
		// Each deferred use judges the parts that come from the arguments where
		// it is written, as instantiateGenericDeclWithArgs's arms do.
		if !p.ConstraintOnly && entry != nil && entry.Result != nil &&
				entry.Result.Kind == types.TYP_INTERFACE {
			requireIfaceInstanceArgsKept(c, entry.Result, p.Pos, p.View)
		}
		if entry == nil || constraintsCheckedIn(entry, p.View) {
			continue
		}
		// Latch only when the diagnostics reach the user: not under TentativeMode
		// (a REPL declaration that may park), whose diagnostics are discarded if it
		// parks (see instantiateGenericDeclWithArgs's cache-hit arm), nor in a layout
		// frame that waits for a layout (layoutFrameBlocked), whose diagnostics are
		// dropped and whose resolution is done again -- which the check itself can
		// make it, reading a layout not built yet.  A later real use must still
		// report them.
		var latched bool = !c.Repl.TentativeMode && !layoutFrameBlocked(c)
		if latched {
			markConstraintsChecked(entry, p.View)
		}
		pushInstanceNaming(c, p.Work, p.WorkDecl)
		var savedLevel int = setMissLevel(c, p.DeclLevel)
		checkInstantiationConstraints(c, p.Decl, p.Args, p.Pos, p.View, p.Naming)
		c.Generics.MissLevel = savedLevel
		popInstanceNaming(c)
		if latched && layoutFrameBlocked(c) {
			unmarkConstraintsChecked(entry, p.View)
		}
		// A use while a list's constraints are resolved sized its instance if it
		// built it user-facing (buildInstance); one it found built otherwise is
		// sized here.
		if entry.Result != nil && entry.Result.Kind == types.TYP_INTERFACE &&
				(!p.ConstraintOnly || !entry.BuildUserFacing) {
			requireInstantiatedIfaceMethodsSized(c, entry.Result, p.Pos)
		}
	}
	c.PendingChecks = c.PendingChecks[:fromChecks]
	for i := fromFuncChecks; i < len(c.PendingFuncChecks); i++ {
		var p @PendingFuncConstraintCheck = c.PendingFuncChecks[i]
		if !typeSatisfiesConstraint(c, p.Arg, p.Constraint, p.View) {
			pushInstanceNaming(c, p.Work, p.WorkDecl)
			var savedLevel int = setMissLevel(c, p.DeclLevel)
			reportConstraintMiss(c, p.Pos, p.Arg, p.Constraint, p.View, p.Decl, p.Index)
			c.Generics.MissLevel = savedLevel
			popInstanceNaming(c)
		}
	}
	c.PendingFuncChecks = c.PendingFuncChecks[:fromFuncChecks]
}

// PendingFuncConstraintCheck is the deferred check that a generic-function
// instantiation's type argument Arg, written at Pos, satisfies its type
// parameter's Constraint (substituted) through the impls of View; Decl is the
// generic function and Index its type parameter.  Work is the instance of the
// generic WorkDecl being worked on when it was recorded, if any
// (currentInstanceNaming), which its miss names.
type PendingFuncConstraintCheck struct {
	Arg        @types.Type
	Constraint @types.Type
	View       ImplView
	Pos        token.Pos
	Decl       @ast.Decl
	Index      int
	Work       @InstWork
	WorkDecl   @ast.Decl
	DeclLevel  bool
}

// deferFuncConstraintCheck records a generic-function instantiation's
// constraint check, deferred while the batch's declarations are collected or a
// type-parameter list's constraints are resolved (instantiateGenericFunc), for
// replayPendingChecks.
func deferFuncConstraintCheck(c @Checker, arg @types.Type, constraint @types.Type, view ImplView,
		pos token.Pos, d @ast.Decl, index int) {
	var p @PendingFuncConstraintCheck = make(PendingFuncConstraintCheck)
	p.Arg = arg
	p.Constraint = constraint
	p.View = view
	p.Pos = pos
	p.Decl = d
	p.Index = index
	p.DeclLevel = missDeclLevel(c)
	var nw @InstWork
	var nd @ast.Decl
	nw, nd = currentInstanceNaming(c)
	p.Work = nw
	p.WorkDecl = nd
	c.PendingFuncChecks = slices.Append[@PendingFuncConstraintCheck](c.PendingFuncChecks, p)
}

// PendingConstraintCheck records one generic instantiation whose type-parameter
// constraint check was DEFERRED -- during batch collection or a .bni surface's
// build, so it would see the package's COMPLETE impl set; while a type-parameter
// list's constraints are resolved, until each parameter has its bound; or, for
// type arguments mentioning `Self`, until its interface's parents are known --
// together with the source position of the user-facing use that requested it.
// replayPendingChecks replays these, firing each check at the site the user
// wrote.  Recording the exact deferred (decl,
// args, pos) — rather than re-walking decls by kind — keeps the re-fire COMPLETE:
// no use-site shape (type alias, named-distinct wrapper, interface extension
// parent or alias target, generic-receiver method signature, …) can be missed.
type PendingConstraintCheck struct {
	Decl @ast.Decl
	Args @[]@types.Type
	Pos  token.Pos
	// View is the use site's view, whose impls the type arguments may satisfy
	// their constraints through.
	View ImplView
	// SelfBound is the interface bounding a `Self` among the type arguments
	// (Checker.SelfBound when the check was queued); nil for the others.
	SelfBound @types.Type
	// Naming is the use site's naming context, in whose lender class the
	// instances the constraint names are named (namingHere).
	Naming namingContext
	// ConstraintOnly is set for a check deferred while a type-parameter list's
	// constraints are resolved (listDefersConstraints): the use made its other
	// checks where it is named, and the replay makes only the constraint check.
	ConstraintOnly bool
	// Work is the instance of the generic WorkDecl being built when the check was
	// recorded, if any (currentInstanceNaming), which the errors the replay finds
	// in WorkDecl name; DeclLevel whether no instance's type arguments were bound
	// then (missDeclLevel).
	Work      @InstWork
	WorkDecl  @ast.Decl
	DeclLevel bool
}

// checkInstantiationConstraints verifies each concrete type-argument of a
// generic struct/interface instantiation satisfies its type-parameter's
// constraint -- the type-instantiation analogue of the check
// instantiateGenericFunc performs for generic functions.  Without it
// `type Box[T lang.Orderable] struct{...}` instantiated as `Box[NoOrder]`
// (no `impl NoOrder : Orderable`) would be accepted, contrary to
// gen.satisfy (spec §12.4).
//
// Constraints are resolved under the generic decl's DEFINING-file scope and
// package (its imports / same-package interface names) with the type-params
// bound to their concrete args, so a constraint naming an earlier param
// (`[X any, T Container[X]]`) resolves to the concrete `Container[arg]`.
// Mirrors populateInstantiatedType's scope setup.  Generic type-param
// constraints are not resolved at decl time (the body is resolved lazily at
// instantiation), so this is their first resolution -- no double-reporting.
//
// usePos anchors the diagnostic at the instantiation site (the `Name[args]`
// expression), matching the function path's use-site anchoring -- not at the
// generic decl, which would be unhelpful and (because identical errors dedup
// on position) could collapse distinct bad use-sites to one message.
//
// view is the instantiation site's: a type argument satisfies its constraint
// through an impl visible there (gen.satisfy), not in the generic's package.
// So is the naming context n (namingHere), in whose lender class the instances
// the constraint names are named.
func checkInstantiationConstraints(c @Checker, d @ast.Decl, argTypes @[]@types.Type,
		usePos token.Pos, view ImplView, n namingContext) {
	if len(d.TypeParams) == 0 { return }
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	// A constraint is no part of a type being formed, so an alias it reaches is
	// no alias cycle (instantiateGenericAlias), whatever alias's target names
	// this instantiation.
	var savedAliasResolving @[]@GenericInstantiation = c.Generics.AliasResolving
	var noAliases @[]@GenericInstantiation
	c.Generics.AliasResolving = noAliases
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams) && i < len(argTypes); i++ {
		if isBlank(d.TypeParams[i].Name) {
			continue
		}
		defineType(c.Scope, d.TypeParams[i].Name, argTypes[i])
	}
	for i := 0; i < len(d.TypeParams) && i < len(argTypes); i++ {
		// Resolve a copy of the constraint: resolved under these arguments, it
		// must not record on the declaration every instantiation shares.  It is
		// resolved as an instance (bindInstance): the instantiations it makes from
		// the arguments are checked where the arguments are written, by this check.
		var tp @ast.TypeParam = make(ast.TypeParam)
		*tp = *d.TypeParams[i]
		tp.Constraint = ast.CloneTypeExpr(d.TypeParams[i].Constraint)
		var savedBound instanceBinding = bindInstanceAt(c, d, argTypes, n)
		var constraint @types.Type = resolveTypeParamConstraint(c, tp)
		unbindInstance(c, savedBound)
		if isErrType(argTypes[i]) || !constraintJudged(constraint) { continue }
		if !typeSatisfiesConstraint(c, argTypes[i], constraint, view) {
			reportConstraintMiss(c, usePos, argTypes[i], constraint, view, d, i)
		}
	}
	c.Generics.AliasResolving = savedAliasResolving
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
}
