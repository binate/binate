// `func (w Wrap[K]) m(b Bar[Item])` (generic-receiver method) with impl after.
func TestConstraintDeferredGenericRecvMethodImplAfterAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Bar[T Sizer] struct { v T }\n"
					"type Item struct { n int }\n"
					"type Wrap[K any] struct { x int }\n"
					"func (w Wrap[K]) m(b Bar[Item]) {}\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

// A generic ALIAS's own constraint, stricter than its target's, at a site resolved
// only during collection (an interface method signature): its instantiations are
// kept apart from the generic-instantiation cache, so the replay must find them
// there too.
func TestConstraintDeferredGenericAliasOwnConstraintMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T any] struct { v T }\n"
					"type SBox[T Sizer] = Box[T]\n"
					"type Bad struct { n int }\n"
					"interface I { m(b SBox[Bad]) }\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("a generic alias's own constraint miss in an interface signature must be rejected")
	}
	return ""
}

// The same generic-alias instantiation with its type argument's impl declared AFTER.
func TestConstraintDeferredGenericAliasOwnConstraintImplAfterAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T any] struct { v T }\n"
					"type SBox[T Sizer] = Box[T]\n"
					"type Item struct { n int }\n"
					"interface I { m(b SBox[Item]) }\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

// ============================================================
// A constraint may name a later parameter of its list (gen.typeparams.scope):
// the checks of the instantiations it forms wait until every parameter has its
// bound (resolveTypeParamConstraints).
// ============================================================

// T's `Hk[G2[V]]` needs V to satisfy G2's Eq, which V's bound gives -- in a type,
// an interface and an alias, whose own constraints are resolved after the
// declarations are collected.
func TestConstraintNamesLaterParamAccepted() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Eq { eq() int }\ninterface Hk[T any] { hk() int }\n"
							"type G2[A Eq] struct { a A }\n"
							"type K4[T Hk[G2[V]], V Eq] struct { v V }\n"
							"interface K6[T Hk[G2[V]], V Eq] { m() int }\n"
							"type K7[T Hk[G2[V]], V Eq] = G2[V]\n"))
}

// A later parameter whose bound does not give the constraint is still reported,
// once.
func TestConstraintNamesLaterParamMissReported() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ninterface Eq { eq() int }\ninterface Hk[T any] { hk() int }\n"
							"type G2[A Eq] struct { a A }\n"
							"type K8[T Hk[G2[V]], V any] struct { v V }\n"),
			"type argument V does not satisfy constraint Eq")
}

// A list defers only the constraint checks: an interface instance first built in
// a constraint is sized where it is named, though its build waits for a layout
// (X[int8]'s, through Big's method) and is redone.
func TestConstraintListKeepsIfaceSizing() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Hk[T any] { hk() int }\n"
					"interface Big[T any] { m(x [2]T, y [sizeof(X[int8])]uint8) int }\n"
					"type Y[T any] struct { x X[int8]; t T }\n"
					"type X[T any] struct { k K[T, T]; t T }\n"
					"type K[A any, B Hk[*Big[[0x4000000000000000]uint8]]] struct { a A }\n")
	if !anyErrContains(c, "type is too large") {
		return fail("the size of Big[[0x4000000000000000]uint8]'s method must be reported")
	}
	return ""
}

// An interface instance named twice in one list is sized once.
func TestConstraintListSizesInstanceOnce() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ninterface Hk[T any] { hk() int }\n"
							"interface Big[T any] { m(x [2]T) int }\n"
							"type K[A Hk[*Big[[0x4000000000000000]uint8]], "
							"B Hk[*Big[[0x4000000000000000]uint8]]] struct { a A }\n"), "type is too large")
}

// A list's replay whose check reads a layout not built yet (X[int8]'s, being
// built), blocking the generic's frame, is made again with the generic's
// resolution: K's own miss (A, bounded by any, for G4's Sz) is reported.
func TestConstraintListReplayInBlockedFrameReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Hk[T any] { hk() int }\ninterface Sz[T any] { sz() int }\n"
					"type Y[T any] struct { x X[int8]; t T }\n"
					"type X[T any] struct { k K[T, T]; t T }\n"
					"type K[A any, B Hk[G4[A]]] struct { a A }\n"
					"type G4[T Sz[[sizeof(X[int8])]uint8]] struct { t T }\n")
	if !anyErrContains(c, "type argument A does not satisfy constraint Sz") {
		return fail("K's own constraint miss must be reported")
	}
	return ""
}
