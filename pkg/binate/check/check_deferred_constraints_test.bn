// A generic-receiver method whose signature names a bad CONCRETE instantiation
// (`func (w Wrap[K]) m(b Bar[Bad])`).
func TestConstraintDeferredGenericRecvMethodMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Bar[T Sizer] struct { v T }\n"
					"type Bad struct { n int }\n"
					"type Wrap[K any] struct { x int }\n"
					"func (w Wrap[K]) m(b Bar[Bad]) {}\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("generic-receiver method naming a bad concrete instantiation must be rejected")
	}
	return ""
}

// The accept direction of the same shapes: with a VALID `impl Item : Sizer`
// declared AFTER the use, each shape is accepted (constraint checking is
// order-independent), not just the reject direction.

// `type W Box[Item]` with impl after.
func TestConstraintDeferredNamedDistinctImplAfterAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Item struct { n int }\n"
					"type W Box[Item]\n"
					"func use(w @W) {}\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

// `type A = Box[Item]` with impl after.
func TestConstraintDeferredAliasImplAfterAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Item struct { n int }\n"
					"type A = Box[Item]\n"
					"func use(a @A) {}\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

