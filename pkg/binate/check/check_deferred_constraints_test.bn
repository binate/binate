func TestConstraintDeferredIfaceAliasTargetMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"interface Holder[T Sizer] { get() T }\n"
					"type Bad struct { n int }\n"
					"interface BadAlias = Holder[Bad]\n")
