package "pkg/binate/check"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_deferred_constraints.bn: constraint checks deferred during
// batch collection (Checker.CollectingDecls) and replayed by
// recheckDeferredConstraints once every impl is recorded, so a generic
// instantiated on a type is accepted (or a genuine miss rejected) regardless of
// whether the type's impl is declared before or after the use site.

// ============================================================
// Constraint checking is order-independent: a generic instantiated on a type is
// accepted whether that type's `impl` is declared before OR after the use site
// (the check is deferred until every impl is collected — see
// Checker.CollectingDecls / recheckDeferredConstraints).
// ============================================================

// A `func Make() @Box[Item]` that PRECEDES `impl Item : Sizer` is accepted.
func TestConstraintCheckFuncBeforeImplAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Item struct { n int }\n"
					"func Make() @Box[Item] { var b @Box[Item] = make(Box[Item]); return b }\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

// The same order-independence for an interface method returning a generic on an
// own-impl'd type: `Get() @Box[Item]` in an interface declared BEFORE
// `impl Item : Sizer` is accepted.  (A naive "collect impls before signatures"
// reorder breaks exactly this case — impls must be collected before BOTH free
// functions and interface method signatures, which the deferral guarantees.)
func TestConstraintCheckIfaceMethodBeforeImplAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Item struct { n int }\n"
					"interface Holder { Get() @Box[Item] }\n"
					"func (i Item) Size() int { return i.n }\n"
					"impl Item : Sizer\n")
	var c @Checker = checkSrc(cb.String())
	return expectNoErrors(c)
}

// Deferring the check must NOT swallow a genuine miss: Bad has no `impl : Sizer`
// anywhere, so `@Box[Bad]` is still rejected even though the func precedes the
// (absent) impl.
func TestConstraintCheckDeferredStillRejectsGenuineMiss() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Bad struct { n int }\n"
					"func Make() @Box[Bad] { var b @Box[Bad] = make(Box[Bad]); return b }\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("genuine constraint miss must still be reported when the impl is absent")
	}
	return ""
}

// The deferred check is replayed at EVERY deferred use site, not a hand-enumerated
// subset — so a genuine miss behind any type-expression shape is still caught.
// These pin the shapes an earlier enumeration-based replay dropped.

// A named-distinct wrapper over a bad instantiation (`type W Box[Bad]`).
func TestConstraintDeferredNamedDistinctMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Bad struct { n int }\n"
					"type W Box[Bad]\n"
					"func use(w @W) {}\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("named-distinct wrapper over a bad instantiation must be rejected")
	}
	return ""
}

// An alias over a bad instantiation (`type A = Box[Bad]`).
func TestConstraintDeferredAliasMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"type Box[T Sizer] struct { v T }\n"
					"type Bad struct { n int }\n"
					"type A = Box[Bad]\n"
					"func use(a @A) {}\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("alias over a bad instantiation must be rejected")
	}
	return ""
}

// A bad generic-interface instantiation as an interface EXTENSION parent.
func TestConstraintDeferredIfaceExtensionParentMissRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Sizer { Size() int }\n"
					"interface Holder[T Sizer] { get() T }\n"
					"type Bad struct { n int }\n"
					"interface BadHolder : Holder[Bad] {}\n")
	var c @Checker = checkSrc(cb.String())
	if !anyErrContains(c, "does not satisfy constraint") {
		return fail("bad generic-interface extension parent must be rejected")
	}
	return ""
}

