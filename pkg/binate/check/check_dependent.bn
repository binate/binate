package "pkg/binate/check"

import "pkg/binate/types"

// Array lengths that depend on a type parameter, in a generic declaration
// checked with its type parameters abstract (spec gen.mono.check).  Such a
// length has a placeholder value there (types.Type.ArrayLenDependent): what
// depends on it — array identity and assignability, a literal's element count
// and index bounds, whether a type argument satisfies its constraint — is
// checked for each instantiation, where the length is known, and deferred in the
// abstract check.

// containsDependentArray reports whether t is, or is built from, an array whose
// length depends on a type parameter: through pointers, slices, arrays,
// `readonly`, function types and anonymous structs (not through a named type,
// which is compared by name).
func containsDependentArray(t @types.Type) bool {
	var v typeVisits
	return containsDependentArrayIn(t, &v, false)
}

// holdsDependentLength reports whether t holds an array whose length depends on a
// type parameter: as containsDependentArray, and also in a generic instance's type
// arguments and an interface value's interface -- which identity compares
// (identicalUpToDependentLengths).
func holdsDependentLength(t @types.Type) bool {
	var v typeVisits
	return containsDependentArrayIn(t, &v, true)
}

// containsDependentArrayIn is containsDependentArray -- holdsDependentLength when
// throughInstances -- taking each part from the type work list (typeWalk) and, once
// it has taken lateVisitFrom, entering each type with parts once (typeVisits).
func containsDependentArrayIn(t @types.Type, v *typeVisits, throughInstances bool) bool {
	var base int = typeWalkBase()
	var steps int = 1
	var found bool = dependentArrayStep(t, v, steps, throughInstances)
	for !found && typeWalkMore(base) {
		steps = steps + 1
		found = dependentArrayStep(typeWalkPop(), v, steps, throughInstances)
	}
	typeWalkEnd(base)
	return found
}

// dependentArrayStep reports whether part t of a type containsDependentArrayIn walks,
// the steps-th it takes, is an array whose length depends on a type parameter, and
// pushes t's parts -- with throughInstances, a generic instance's type arguments and
// an interface value's interface too.
func dependentArrayStep(t @types.Type, v *typeVisits, steps int, throughInstances bool) bool {
	var u @types.Type = t.ResolveAlias()
	if u == nil { return false }
	if u.Kind == types.TYP_ARRAY && u.ArrayLenDependent { return true }
	if u.Kind == types.TYP_ARRAY || u.Kind == types.TYP_POINTER || u.Kind == types.TYP_MANAGED_PTR ||
			u.Kind == types.TYP_SLICE || u.Kind == types.TYP_MANAGED_SLICE || u.Kind == types.TYP_READONLY {
		if steps <= lateVisitFrom || v.enter(u) { typeWalkPush(u.Elem) }
	} else if u.Kind == types.TYP_STRUCT && len(u.Name) == 0 {
		if steps <= lateVisitFrom || v.enter(u) { pushFieldTypes(u) }
	} else if u.Kind == types.TYP_FUNC || u.Kind == types.TYP_FUNC_VALUE ||
			u.Kind == types.TYP_MANAGED_FUNC_VALUE {
		if steps <= lateVisitFrom || v.enter(u) { pushSignatureTypes(u) }
	} else if throughInstances &&
			(u.Kind == types.TYP_INTERFACE_VALUE || u.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		if steps <= lateVisitFrom || v.enter(u) { typeWalkPush(u.Elem) }
	} else if throughInstances && (u.Kind == types.TYP_NAMED || u.Kind == types.TYP_INTERFACE) &&
			u.InstDecl != nil {
		if steps <= lateVisitFrom || v.enter(u) { pushInstArgs(u) }
	}
	return false
}

// identicalUpToDependentLengths reports whether a and b are identical where an
// array length that depends on a type parameter (in either) matches any length:
// the instantiations' checks decide whether the lengths agree.  Instances of one
// generic, interfaces included, are compared by their type arguments.  It
// compares the pairs of their parts in turn from the work list (typeWalk), each
// pair pushed as its two types.
func identicalUpToDependentLengths(a @types.Type, b @types.Type) bool {
	var base int = typeWalkBase()
	pushTypePair(a, b)
	var alike bool = true
	for alike && typeWalkMore(base) {
		var x @types.Type = typeWalkPop()
		var y @types.Type = typeWalkPop()
		alike = dependentAlikeStep(x, y)
	}
	typeWalkEnd(base)
	return alike
}

// pushTypePair pushes the pair a, b for a walk over pairs to compare: b, then a, so
// that a comes off first.
func pushTypePair(a @types.Type, b @types.Type) {
	typeWalkPush(b)
	typeWalkPush(a)
}

// dependentAlikeStep reports whether a and b can be identical up to dependent array
// lengths as far as their own kind, length, field names and signature shape go,
// pushing the pairs of their parts to compare, last first; a type with no parts it
// compares is compared whole (Identical), and a type is alike itself.
func dependentAlikeStep(a @types.Type, b @types.Type) bool {
	if same(a, b) { return true }
	a = a.ResolveAlias()
	b = b.ResolveAlias()
	if a == nil || b == nil {
		return a == nil && b == nil
	}
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == types.TYP_ARRAY {
		if !a.ArrayLenDependent && !b.ArrayLenDependent && a.ArrayLen != b.ArrayLen {
			return false
		}
		pushTypePair(a.Elem, b.Elem)
		return true
	}
	if a.Kind == types.TYP_POINTER || a.Kind == types.TYP_MANAGED_PTR || a.Kind == types.TYP_SLICE ||
			a.Kind == types.TYP_MANAGED_SLICE || a.Kind == types.TYP_READONLY {
		pushTypePair(a.Elem, b.Elem)
		return true
	}
	if a.Kind == types.TYP_STRUCT && len(a.Name) == 0 && len(b.Name) == 0 {
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) {
				return false
			}
		}
		for i := len(a.Fields) - 1; i >= 0; i-- {
			pushTypePair(a.Fields[i].Type, b.Fields[i].Type)
		}
		return true
	}
	if a.Kind == types.TYP_FUNC || a.Kind == types.TYP_FUNC_VALUE ||
			a.Kind == types.TYP_MANAGED_FUNC_VALUE {
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if a.Params[i].IsVariadic != b.Params[i].IsVariadic {
				return false
			}
		}
		for i := len(a.Results) - 1; i >= 0; i-- {
			pushTypePair(a.Results[i], b.Results[i])
		}
		for i := len(a.Params) - 1; i >= 0; i-- {
			pushTypePair(a.Params[i].Type, b.Params[i].Type)
		}
		return true
	}
	if a.Kind == types.TYP_INTERFACE_VALUE || a.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		pushTypePair(a.Elem, b.Elem)
		return true
	}
	if (a.Kind == types.TYP_NAMED || a.Kind == types.TYP_INTERFACE) && a.InstDecl != nil &&
			same(a.InstDecl, b.InstDecl) && len(a.InstArgs) == len(b.InstArgs) {
		for i := len(a.InstArgs) - 1; i >= 0; i-- {
			pushTypePair(a.InstArgs[i], b.InstArgs[i])
		}
		return true
	}
	return a.Identical(b)
}

// constraintMissDeferred reports whether the type argument t's miss of its
// constraint iface is left to the instantiations (spec gen.mono.check): t
// satisfies iface when every array length that depends on a type parameter, in
// either, matches any length.  Only a check made with type parameters abstract
// -- a generic's own -- has such lengths; each concrete instantiation is judged
// where it is formed, with the lengths known.
func constraintMissDeferred(c @Checker, t @types.Type, iface @types.Type, view ImplView) bool {
	return typeSatisfiesConstraintIn(c, t, iface, view, true)
}

// assignableDeferringDependent reports whether src is assignable to dst only up
// to array lengths that depend on a type parameter — which each
// instantiation's check decides (identicalDeferringDependent).
func assignableDeferringDependent(src @types.Type, dst @types.Type) bool {
	return identicalDeferringDependent(src, dst)
}

// identicalDeferringDependent reports whether a and b are identical only up to
// array lengths that depend on a type parameter, in either -- in an instance's
// type arguments too (`*G1[[sizeof(U)]uint8]` and `*G1[[8]uint8]`): each
// instantiation's check decides whether the lengths agree.
func identicalDeferringDependent(a @types.Type, b @types.Type) bool {
	return (holdsDependentLength(a) || holdsDependentLength(b)) && identicalUpToDependentLengths(a, b)
}
