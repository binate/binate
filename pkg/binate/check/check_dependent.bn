package "pkg/binate/check"

import "pkg/binate/types"

// Array lengths that depend on a type parameter, in a generic declaration
// checked with its type parameters abstract (spec gen.mono.check).  Such a
// length has a placeholder value there (types.Type.ArrayLenDependent): what
// depends on it — array identity and assignability, a literal's element count
// and index bounds — is checked for each instantiation, where the length is
// known, and deferred in the abstract check.

// containsDependentArray reports whether t is, or is built from, an array whose
// length depends on a type parameter: through pointers, slices, arrays,
// `readonly`, function types and anonymous structs (not through a named type,
// which is compared by name).
func containsDependentArray(t @types.Type) bool {
	return containsDependentArrayDepth(t, 0)
}

// containsDependentArrayDepth is containsDependentArray to a bounded depth.
func containsDependentArrayDepth(t @types.Type, depth int) bool {
	t = t.ResolveAlias()
	if t == nil || depth > 64 {
		return false
	}
	if t.Kind == types.TYP_ARRAY && t.ArrayLenDependent {
		return true
	}
	if t.Kind == types.TYP_ARRAY || t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR ||
			t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_READONLY {
		return containsDependentArrayDepth(t.Elem, depth + 1)
	}
	if t.Kind == types.TYP_STRUCT && len(t.Name) == 0 {
		for i := 0; i < len(t.Fields); i++ {
			if containsDependentArrayDepth(t.Fields[i].Type, depth + 1) {
				return true
			}
		}
		return false
	}
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(t.Params); i++ {
			if containsDependentArrayDepth(t.Params[i].Type, depth + 1) {
				return true
			}
		}
		for i := 0; i < len(t.Results); i++ {
			if containsDependentArrayDepth(t.Results[i], depth + 1) {
				return true
			}
		}
	}
	return false
}

// identicalUpToDependentLengths reports whether a and b are identical where an
// array length that depends on a type parameter (in either) matches any length:
// the instantiations' checks decide whether the lengths agree.
func identicalUpToDependentLengths(a @types.Type, b @types.Type) bool {
	return identicalUpToDependentDepth(a, b, 0)
}

// identicalUpToDependentDepth is identicalUpToDependentLengths to a bounded
// depth.
func identicalUpToDependentDepth(a @types.Type, b @types.Type, depth int) bool {
	a = a.ResolveAlias()
	b = b.ResolveAlias()
	if a == nil || b == nil || depth > 64 {
		return a == nil && b == nil
	}
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == types.TYP_ARRAY {
		if !a.ArrayLenDependent && !b.ArrayLenDependent && a.ArrayLen != b.ArrayLen {
			return false
		}
		return identicalUpToDependentDepth(a.Elem, b.Elem, depth + 1)
	}
	if a.Kind == types.TYP_POINTER || a.Kind == types.TYP_MANAGED_PTR || a.Kind == types.TYP_SLICE ||
			a.Kind == types.TYP_MANAGED_SLICE || a.Kind == types.TYP_READONLY {
		return identicalUpToDependentDepth(a.Elem, b.Elem, depth + 1)
	}
	if a.Kind == types.TYP_STRUCT && len(a.Name) == 0 && len(b.Name) == 0 {
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) ||
					!identicalUpToDependentDepth(a.Fields[i].Type, b.Fields[i].Type, depth + 1) {
				return false
			}
		}
		return true
	}
	if a.Kind == types.TYP_FUNC || a.Kind == types.TYP_FUNC_VALUE ||
			a.Kind == types.TYP_MANAGED_FUNC_VALUE {
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if a.Params[i].IsVariadic != b.Params[i].IsVariadic ||
					!identicalUpToDependentDepth(a.Params[i].Type, b.Params[i].Type, depth + 1) {
				return false
			}
		}
		for i := 0; i < len(a.Results); i++ {
			if !identicalUpToDependentDepth(a.Results[i], b.Results[i], depth + 1) {
				return false
			}
		}
		return true
	}
	return a.Identical(b)
}

// assignableDeferringDependent reports whether src is assignable to dst only up
// to array lengths that depend on a type parameter — which each
// instantiation's check decides.
func assignableDeferringDependent(src @types.Type, dst @types.Type) bool {
	return (containsDependentArray(src) || containsDependentArray(dst)) &&
			identicalUpToDependentLengths(src, dst)
}

// intInList reports whether n is in list.
func intInList(list *[]int, n int) bool {
	for i := 0; i < len(list); i++ {
		if list[i] == n {
			return true
		}
	}
	return false
}
