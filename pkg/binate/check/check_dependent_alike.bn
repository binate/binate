package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/std/vec"

// Type identity up to the array lengths that depend on a type parameter (spec
// gen.mono.check): in a generic's own check such a length is a placeholder, and
// whether it agrees with another length is decided for each instantiation.  The
// comparison is Identical's -- an alias and a `readonly` are not part of a type's
// identity, except in an instance's type arguments, which its name spells -- or,
// from identicalStrictUpToDependentLengths, IdenticalStrict's (readonly
// significant throughout); instances of one generic, interfaces included, are
// compared by their type arguments.

// An alikePair is a pair of types the comparison has still to compare: strictly
// (readonly significant) or not.
type alikePair struct {
	a      @types.Type
	b      @types.Type
	strict bool
}

// alikeStack holds the pairs a comparison has still to compare, kept from one to
// the next; a comparison leaves it as it found it.
var alikeStack @vec.Vec[alikePair]

// identicalUpToDependentLengths reports whether a and b are identical, as
// Identical, where an array length that depends on a type parameter (in either)
// matches any length: the instantiations' checks decide whether the lengths agree.
func identicalUpToDependentLengths(a @types.Type, b @types.Type) bool {
	return alikeWalk(a, b, false)
}

// identicalStrictUpToDependentLengths is identicalUpToDependentLengths with readonly
// significant, as IdenticalStrict.
func identicalStrictUpToDependentLengths(a @types.Type, b @types.Type) bool {
	return alikeWalk(a, b, true)
}

// alikeWalk compares a and b -- strictly when strict -- part by part from
// alikeStack: a pair's parts are pushed last first, so they are compared in the
// order they appear, and the first mismatch ends the walk.
func alikeWalk(a @types.Type, b @types.Type, strict bool) bool {
	if alikeStack == nil { alikeStack = vec.New[alikePair]() }
	var base int = alikeStack.Len()
	var ok bool = dependentAlikeStep(a, b, strict)
	for ok && alikeStack.Len() > base {
		p, _ := alikeStack.Pop()
		ok = dependentAlikeStep(p.a, p.b, p.strict)
	}
	for alikeStack.Len() > base {
		_, _ = alikeStack.Pop()
	}
	return ok
}

// pushAlike adds the pair (a, b) for alikeWalk to compare, strictly when strict.
func pushAlike(a @types.Type, b @types.Type, strict bool) {
	var p alikePair
	p.a = a
	p.b = b
	p.strict = strict
	alikeStack.Push(p)
}

// dependentAlikeStep reports whether a and b can be identical up to dependent array
// lengths -- strictly when strict -- as far as their own kind, length, field names
// and signature shape go, pushing the pairs of their parts; a type with no parts it
// compares is compared whole (Identical, or IdenticalStrict), and a type is alike
// itself.
func dependentAlikeStep(a @types.Type, b @types.Type, strict bool) bool {
	if same(a, b) { return true }
	if strict {
		a = a.ResolveAlias()
		b = b.ResolveAlias()
	} else {
		a = types.ResolveAliasAndConst(a)
		b = types.ResolveAliasAndConst(b)
	}
	if a == nil || b == nil {
		return a == nil && b == nil
	}
	if same(a, b) { return true }
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == types.TYP_ARRAY {
		if !a.ArrayLenDependent && !b.ArrayLenDependent && a.ArrayLen != b.ArrayLen {
			return false
		}
		pushAlike(a.Elem, b.Elem, strict)
		return true
	}
	if a.Kind == types.TYP_POINTER || a.Kind == types.TYP_MANAGED_PTR || a.Kind == types.TYP_SLICE ||
			a.Kind == types.TYP_MANAGED_SLICE || a.Kind == types.TYP_READONLY ||
			a.Kind == types.TYP_INTERFACE_VALUE || a.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		pushAlike(a.Elem, b.Elem, strict)
		return true
	}
	if a.Kind == types.TYP_STRUCT && len(a.Name) == 0 && len(b.Name) == 0 {
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !types.CharEq(a.Fields[i].Name, b.Fields[i].Name) {
				return false
			}
		}
		for i := len(a.Fields) - 1; i >= 0; i-- {
			pushAlike(a.Fields[i].Type, b.Fields[i].Type, strict)
		}
		return true
	}
	if a.Kind == types.TYP_FUNC || a.Kind == types.TYP_FUNC_VALUE ||
			a.Kind == types.TYP_MANAGED_FUNC_VALUE {
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if a.Params[i].IsVariadic != b.Params[i].IsVariadic {
				return false
			}
		}
		for i := len(a.Results) - 1; i >= 0; i-- {
			pushAlike(a.Results[i], b.Results[i], strict)
		}
		for i := len(a.Params) - 1; i >= 0; i-- {
			pushAlike(a.Params[i].Type, b.Params[i].Type, strict)
		}
		return true
	}
	if (a.Kind == types.TYP_NAMED || a.Kind == types.TYP_INTERFACE) && a.InstDecl != nil &&
			same(a.InstDecl, b.InstDecl) && len(a.InstArgs) == len(b.InstArgs) {
		for i := len(a.InstArgs) - 1; i >= 0; i-- {
			pushAlike(a.InstArgs[i], b.InstArgs[i], true)
		}
		return true
	}
	if strict { return a.IdenticalStrict(b) }
	return a.Identical(b)
}
