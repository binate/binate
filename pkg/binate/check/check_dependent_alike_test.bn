package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for check_dependent_alike.bn: identity up to the array lengths that depend on
// a type parameter.

// A `readonly` is not part of the identity outside an instance's type arguments,
// as for Identical, and is in the strict comparison, as for IdenticalStrict.
func TestAlikeReadonly() testing.TestResult {
	var dep @types.Type = types.MakePointerType(
			types.MakeReadonlyType(dependentArray(types.TypUint8())))
	var fixed @types.Type = types.MakePointerType(types.MakeArrayType(types.TypUint8(), 4))
	if !identicalUpToDependentLengths(dep, fixed) {
		return fail("*readonly [dep]uint8 is *[4]uint8 up to readonly and the length")
	}
	if identicalStrictUpToDependentLengths(dep, fixed) {
		return fail("readonly is significant in the strict comparison")
	}
	var strictDep @types.Type = types.MakePointerType(dependentArray(types.TypUint8()))
	if !identicalStrictUpToDependentLengths(strictDep, fixed) {
		return fail("*[dep]uint8 is *[4]uint8 up to the length, strictly")
	}
	return ""
}

// A generic's own check defers adding readonly, a function value's signature and a
// managed -> raw borrow, each holding a dependent length.
func TestDependentIdentityBesideAssignabilityDeferred() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type G1[A any] struct { a A }\n"
			"func take8(q *G1[[8]uint8]) int { return len(q.a) }\n"
			"func r1[U any](q *G1[[8]uint8]) int {\n"
			"\tvar p *readonly G1[[sizeof(U)]uint8] = q\n\treturn len(p.a)\n}\n"
			"func s1[U any](q *G1[[8]uint8], p *readonly G1[[sizeof(U)]uint8]) bool { return same(q, p) }\n"
			"func v1[U any]() int { var fv *func(*G1[[sizeof(U)]uint8]) int = take8; return 1 }\n"
			"func v4[U any](a *func(G1[[8]uint8]) int) int {\n"
			"\tvar fv *func(G1[[sizeof(U)]uint8]) int = a\n\treturn 4\n}\n"
			"func d1[U any](q @G1[[8]uint8]) int { var p *G1[[sizeof(U)]uint8] = q; return len(p.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// What differs whatever lengths the type parameters give is still the
// declaration's error: readonly in an instance's type argument, and a readonly
// dropped.
func TestDependentIdentityReadonlyStillRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type G1[A any] struct { a A }\n"
			"func k1[U any](q *G1[readonly [8]uint8]) int {\n"
			"\tvar p *G1[[sizeof(U)]uint8] = q\n\treturn len(p.a)\n}\n"
			"func k2[U any](q *readonly G1[[8]uint8]) int {\n"
			"\tvar p *G1[[sizeof(U)]uint8] = q\n\treturn len(p.a)\n}\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c, "cannot assign *G1[readonly [8]uint8] to *G1[[0]uint8]") ||
			!anyErrContains(c, "cannot assign *readonly G1[[8]uint8] to *G1[[0]uint8]") {
		return "expected both declarations' errors"
	}
	return ""
}
