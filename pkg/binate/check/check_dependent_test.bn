package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_dependent.bn: array lengths that depend on a type parameter
// are compared, and a literal's count and bounds checked, by each
// instantiation, not by the abstract check.

// dependentArray returns an array of elem whose length depends on a type
// parameter.
func dependentArray(elem @types.Type) @types.Type {
	var t @types.Type = types.MakeArrayType(elem, 0)
	t.ArrayLenDependent = true
	return t
}

// A dependent array is found through pointers and function types, not in a
// concrete array.
func TestContainsDependentArray() testing.TestResult {
	var dep @types.Type = dependentArray(types.TypUint8())
	if !containsDependentArray(dep) || !containsDependentArray(types.MakePointerType(dep)) {
		return "expected a dependent array and a pointer to one to contain one"
	}
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	ps[0] = make(types.Param)
	ps[0].Type = dep
	var noResults @[]@types.Type
	if !containsDependentArray(types.MakeFuncValueType(ps, noResults)) {
		return "expected a function type with a dependent parameter to contain one"
	}
	if containsDependentArray(types.MakeArrayType(types.TypUint8(), 4)) {
		return "a concrete array contains no dependent array"
	}
	return ""
}

// A dependent length matches any length; element types and concrete lengths
// must still agree.
func TestIdenticalUpToDependentLengths() testing.TestResult {
	var dep @types.Type = dependentArray(types.TypUint8())
	if !identicalUpToDependentLengths(dep, types.MakeArrayType(types.TypUint8(), 4)) {
		return "a dependent length should match a concrete one"
	}
	if identicalUpToDependentLengths(dep, types.MakeArrayType(types.TypInt8(), 4)) {
		return "the element types must still agree"
	}
	if identicalUpToDependentLengths(types.MakeArrayType(types.TypUint8(), 4),
			types.MakeArrayType(types.TypUint8(), 5)) {
		return "two concrete lengths must still agree"
	}
	if types.MakeArrayType(types.TypUint8(), 0).Identical(dep) {
		return "a dependent array must not be identical to a concrete one"
	}
	return ""
}

// In an abstract body, assigning between a dependent and a concrete array, and a
// literal's count against a dependent length, are left to the instantiations;
// a duplicate literal index is still an error.
func TestAbstractBodyDefersDependentLengths() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() int {\n"
			"var a [4]uint8\n"
			"var b [sizeof(T)]uint8 = a\n"
			"var l [sizeof(T)]uint8 = [sizeof(T)]uint8{1, 2, 3}\n"
			"return len(b) + len(l)\n"
			"}\n"
	if len(checkSrc(src).CheckerErrors()) != 0 {
		return "expected no errors in the abstract body"
	}
	var dup *[]readonly char = "package \"test\"\n"
			"func g[T any]() int {\n"
			"var l [sizeof(T)]uint8 = [sizeof(T)]uint8{0: 1, 0: 2}\n"
			"return len(l)\n"
			"}\n"
	if errorsContaining(checkSrc(dup), "duplicate index") != 1 {
		return "expected the duplicate-index error"
	}
	return ""
}

// A dependent array at the bottom of a pointer chain deepLevels deep matches any length
// there, and nothing but an array does.
func TestDeepIdenticalUpToDependentLengths() testing.TestResult {
	var dep @types.Type = ptrChain(deepLevels, dependentArray(types.TypUint8()))
	var fixed @types.Type = ptrChain(deepLevels, types.MakeArrayType(types.TypUint8(), 4))
	var other @types.Type = ptrChain(deepLevels, types.TypInt())
	var matches bool = identicalUpToDependentLengths(dep, fixed)
	var differs bool = !identicalUpToDependentLengths(dep, other)
	dropLinks(&dep, deepLevels)
	dropLinks(&fixed, deepLevels)
	dropLinks(&other, deepLevels)
	if !matches { return fail("a dependent array under a deep chain matches a fixed one") }
	if !differs { return fail("a dependent array under a deep chain does not match an int") }
	return ""
}

// Two distinct types sharing their parts, with 2^64 paths through them, are compared
// pair by pair only down to the pairs of one type.
func TestIdenticalUpToDependentLengthsSharedParts() testing.TestResult {
	a, b := sharedParts(64)
	if !identicalUpToDependentLengths(a, b) { return fail("types sharing their parts are identical") }
	return ""
}

// dependentConstraintPrelude declares Eq, *N implementing Eq[[8]uint8], and inner,
// whose constraint's length depends on its other type parameter.
func dependentConstraintPrelude() *[]readonly char {
	return "package \"test\"\n"
			"interface Eq[T any] { eq(o T) int }\n"
			"type N struct { v int }\n"
			"func (n *N) eq(o [8]uint8) int { return n.v }\n"
			"impl *N : Eq[[8]uint8]\n"
			"func inner[T Eq[[sizeof(U)]uint8], U any](t T) int { return 1 }\n"
			"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
}

// A generic's own check leaves a constraint judgment that depends on a length
// depending on a type parameter to the instantiations: through an impl, a type
// parameter's bound, a parameterized impl and an ancestor, in a call, a field, a
// generic interface's method and an alias's target -- and an impl whose receiver
// is an alias of an instance.
func TestDependentConstraintMissDeferredAtDeclaration() testing.TestResult {
	var src @[]readonly char = buf.Concat(dependentConstraintPrelude(),
			"func fwd[U any](n *N) int { return inner[*N, U](n) }\n"
					"type W[U any] struct { g *G[*N, U] }\n"
					"interface Hh[U any] { take(k *G[*N, U]) int }\n"
					"type GA[U any] = G[*N, U]\n"
					"func fwd2[V Eq[[8]uint8]](v V) int { return inner[V, int64](v) }\n"
					"func f6[V Eq[[8]uint8], U any](v V) int { return inner[V, U](v) }\n"
					"type Box[K any] struct { k K }\n"
					"func (b *Box[K]) eq(o [8]uint8) int { return 0 }\n"
					"impl *Box[K] : Eq[[8]uint8]\n"
					"func gb[U any](b *Box[U]) int { return inner[*Box[U], U](b) }\n"
					"interface J8 : Eq[[8]uint8] {}\n"
					"type N8 struct { v int }\n"
					"func (n *N8) eq(o [8]uint8) int { return 0 }\n"
					"impl *N8 : J8\n"
					"func gj[U any](n *N8) int { return inner[*N8, U](n) }\n"
					"type R[A any] struct { a A }\n"
					"func (r *R[A]) eq(o [8]uint8) int { return 0 }\n"
					"type R8 = R[[8]uint8]\nimpl *R8 : Eq[[8]uint8]\n"
					"func gr[U any](r *R[[sizeof(U)]uint8]) int {\n"
					"\treturn inner[*R[[sizeof(U)]uint8], int64](r)\n}\n")
	return expectNoErrors(checkSrc(src))
}

// Each instance judges it with the lengths known: fwd[int32]'s call misses
// Eq[[4]uint8], named for the instance; fwd[int64]'s satisfies Eq[[8]uint8].
func TestDependentConstraintMissJudgedInInstance() testing.TestResult {
	var src @[]readonly char = buf.Concat(dependentConstraintPrelude(),
			"func fwd[U any](n *N) int { return inner[*N, U](n) }\n"
					"func f() int { var n N; return fwd[int64](&n) + fwd[int32](&n) }\n")
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			!anyErrContains(c, "does not satisfy constraint Eq[[4]uint8] (in fwd[int32], instantiated at") {
		return "expected fwd[int32]'s miss, alone"
	}
	return ""
}

// A miss that holds whatever lengths the type parameters give is still the
// declaration's: an element type that differs, and a type parameter with no
// bound.
func TestDependentConstraintStillRejectedAtDeclaration() testing.TestResult {
	var src @[]readonly char = buf.Concat(dependentConstraintPrelude(),
			"func inner16[T Eq[[sizeof(U)]uint16], U any](t T) int { return 1 }\n"
					"func e16[U any](n *N) int { return inner16[*N, U](n) }\n"
					"func e7[V any, U any](v V) int { return inner[V, U](v) }\n")
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c, "type argument *N does not satisfy constraint Eq[[0]uint16]") ||
			!anyErrContains(c, "type argument V does not satisfy constraint Eq[[0]uint8]") {
		return "expected both declarations' misses"
	}
	return ""
}
