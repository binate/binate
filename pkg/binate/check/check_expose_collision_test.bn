package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for check_expose_collision.bn.  mkBniFile is shared from bni_scope_test.bn.
// checkExposeCollisions is normally invoked from checkPackageImpl under the
// checkBodies gate; here it is called directly once the package scopes are built.

// TestExposeCollisionVsOwn: a name exposed from P that ALSO names this package's
// own declaration is reported.
func TestExposeCollisionVsOwn() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Foo()\n"))
	var aBni @ast.File = mkBniFile("package \"a\"\nexpose \"pkg/p\"\nfunc Foo()\n")
	c.LoadPackageInterface("pkg/a", aBni)
	checkExposeCollisions(c, aBni)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected a collision: A exposes Foo (from pkg/p) and declares its own Foo")
	}
	return ""
}

// TestExposeCollisionTwoExposes: the same name surfaced by two exposes is reported.
func TestExposeCollisionTwoExposes() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Foo()\n"))
	c.LoadPackageInterface("pkg/q", mkBniFile("package \"q\"\nfunc Foo()\n"))
	var aBni @ast.File = mkBniFile("package \"a\"\nexpose \"pkg/p\"\nexpose \"pkg/q\"\n")
	c.LoadPackageInterface("pkg/a", aBni)
	checkExposeCollisions(c, aBni)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected a collision: pkg/p and pkg/q both expose Foo")
	}
	return ""
}

// TestExposeNoCollision: distinct exposed names produce no error.
func TestExposeNoCollision() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Foo()\n"))
	c.LoadPackageInterface("pkg/q", mkBniFile("package \"q\"\nfunc Bar()\n"))
	var aBni @ast.File = mkBniFile("package \"a\"\nexpose \"pkg/p\"\nexpose \"pkg/q\"\n")
	c.LoadPackageInterface("pkg/a", aBni)
	checkExposeCollisions(c, aBni)
	if len(c.CheckerErrors()) != 0 {
		return fail("no collision expected: pkg/p exposes Foo, pkg/q exposes Bar")
	}
	return ""
}

// checkAggregator checks package q, whose .bni exposes pkg/p (const N, func
// MakePoint) and declares F, and whose .bn is bn.
func checkAggregator(bn *[]readonly char) @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p",
			mkBniFile("package \"pkg/p\"\nconst N int = 3\nfunc MakePoint(x int, y int) int\n"))
	return checkBniMethodPkgIn(c, "package \"q\"\nexpose \"pkg/p\"\nfunc F() int\n", bn, false)
}

// TestExposedNamesNotInOwnScope: expose extends only the surface, so the
// aggregator's .bn does not see an exposed const or func bare.
func TestExposedNamesNotInOwnScope() testing.TestResult {
	var r testing.TestResult = errsIn(
			checkAggregator("package \"q\"\nconst m int = N * 2\nfunc F() int { return m }\n"),
			"undefined: N")
	if len(r) > 0 { return r }
	return errsIn(checkAggregator("package \"q\"\nfunc F() int { return MakePoint(4, 5) }\n"),
			"undefined: MakePoint")
}

// TestExposeNoCollisionWithPrivateName: a name only the aggregator's .bn
// declares is private and does not collide with an exposed one — nor is it
// matched against the exposed one's signature; the .bn uses the exposed package
// through an ordinary import.
func TestExposeNoCollisionWithPrivateName() testing.TestResult {
	var c @Checker = checkAggregator(
			"package \"q\"\nimport \"pkg/p\"\n"
					"func MakePoint(z int) int { return z * 2 }\n"
					"func F() int { return MakePoint(1) + p.MakePoint(3, 4) + p.N }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}
