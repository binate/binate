package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/bignum"
import "pkg/binate/token"

// Constant folding for arithmetic and bitwise binary ops on
// untyped-int literals.  Both folders run before the regular
// commonType resolution in checkBinaryOp / checkArithOp, so the
// resulting untyped-int Type carries the folded value through to
// the AssignableTo fit-check at the assignment site.  Per
// claude-notes.md § "Integer literal value range and constant-
// expression arithmetic — DECIDED 2026-05-15".

// foldIntArith performs constant folding for `+ - * / %` on two
// integer operands when both carry HasLitVal.  The folded value
// becomes the new untyped-int literal — `var x uint8 = 1000 -
// 1000` accepts (final 0 fits) and `var x uint8 = 200 + 100`
// rejects (final 300 doesn't).  An overflow at the union-range
// boundary (`[-2^63, 2^64-1]`) is reported as a type-check error
// and the result loses HasLitVal so downstream falls back to
// today's kind-only check.  Division by zero is similarly
// reported.  / truncates toward zero; % takes the sign of the
// dividend (Go semantics).
func foldIntArith(c @Checker, pos token.Pos, op int, lt @types.Type, rt @types.Type) @types.Type {
	if lt == nil || rt == nil { return commonType(c, pos, lt, rt) }
	if lt.Kind != types.TYP_UNTYPED_INT || rt.Kind != types.TYP_UNTYPED_INT {
		return commonType(c, pos, lt, rt)
	}
	if !lt.HasLitVal || !rt.HasLitVal {
		return commonType(c, pos, lt, rt)
	}
	var a bignum.Num
	a.Magnitude = lt.LitMag
	a.Sign = lt.LitSign
	var b bignum.Num
	b.Magnitude = rt.LitMag
	b.Sign = rt.LitSign
	var r bignum.Num
	var ok bool
	var divKind bool = false
	if op == cast(int, token.PLUS) {
		r, ok = a.Add(b)
	} else if op == cast(int, token.MINUS) {
		r, ok = a.Sub(b)
	} else if op == cast(int, token.STAR) {
		r, ok = a.Mul(b)
	} else if op == cast(int, token.SLASH) {
		r, ok = a.Div(b)
		divKind = true
	} else if op == cast(int, token.PERCENT) {
		r, ok = a.Mod(b)
		divKind = true
	} else {
		return types.TypUntypedInt()
	}
	if !ok {
		if divKind && b.Magnitude == 0 {
			addCheckError(c, pos, "division by zero in constant expression")
		} else {
			addCheckError(c, pos, "constant expression overflows representable range")
		}
		return types.TypUntypedInt()
	}
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.HasLitVal = true
	t.LitMag = r.Magnitude
	t.LitSign = r.Sign
	return t
}

// foldIntBitwise performs constant folding for `& | ^ << >>` on two untyped
// integer operands that both carry literal values.  Each value is read as its
// two's-complement representation extended infinitely to the left (spec §6.4
// const.expr.bitwise), so every result — including one with a negative operand
// — is an exact integer that depends on no width, and the assignment site's
// fit check sees it: `(0 - 2) | 1` is -1, which a `uint8` rejects.  A result
// outside the union range is reported like any other constant overflow.  A
// negative shift count is not folded (checkShiftCountNonNegative reports it for
// `<<` / `>>`).
func foldIntBitwise(c @Checker, pos token.Pos, op int, lt @types.Type, rt @types.Type) @types.Type {
	if lt == nil || rt == nil { return commonType(c, pos, lt, rt) }
	if lt.Kind != types.TYP_UNTYPED_INT || rt.Kind != types.TYP_UNTYPED_INT {
		return commonType(c, pos, lt, rt)
	}
	if !lt.HasLitVal || !rt.HasLitVal {
		return commonType(c, pos, lt, rt)
	}
	var a bignum.Num
	a.Magnitude = lt.LitMag
	a.Sign = lt.LitSign
	var b bignum.Num
	b.Magnitude = rt.LitMag
	b.Sign = rt.LitSign
	var r bignum.Num
	var ok bool
	if op == cast(int, token.AMP) {
		r, ok = a.And(b)
	} else if op == cast(int, token.PIPE) {
		r, ok = a.Or(b)
	} else if op == cast(int, token.CARET) {
		r, ok = a.Xor(b)
	} else if op == cast(int, token.SHL) || op == cast(int, token.SHR) {
		if b.Sign {
			return types.TypUntypedInt()
		}
		if op == cast(int, token.SHL) {
			r, ok = a.Shl(b)
		} else {
			r, ok = a.Shr(b)
		}
	} else {
		return types.TypUntypedInt()
	}
	if !ok {
		addCheckError(c, pos, "constant expression overflows representable range")
		return types.TypUntypedInt()
	}
	return untypedIntOfNum(r)
}

// untypedIntOfNum returns a fresh untyped-int type carrying the constant n.
func untypedIntOfNum(n bignum.Num) @types.Type {
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.HasLitVal = true
	t.LitMag = n.Magnitude
	t.LitSign = n.Sign
	return t
}
