package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/bignum"
import "pkg/binate/constval"
import "pkg/binate/token"

// Typing stamps for untyped integer constants.  An untyped constant's type
// carries its value (HasLitVal / LitMag / LitSign) so the assignment site's
// fit check (AssignableTo) sees it: `var x uint8 = 1000 - 1000` accepts (0
// fits) and `var x uint8 = 200 + 100` rejects (300 does not).  The value is
// computed with constval's operators, exactly as recordConst computes the
// expression's recorded value; an operation that fails leaves the untyped
// type without a value, and recordConst reports the error.

// foldIntArith types `+ - * / %` on two operands, folding two untyped
// constants that carry values; otherwise the usual untyped-operand coercion
// (commonType) applies.
func foldIntArith(c @Checker, pos token.Pos, op int, lt @types.Type, rt @types.Type) @types.Type {
	return foldUntyped(c, pos, op, lt, rt)
}

// foldIntBitwise types `& | ^ << >>` on two operands like foldIntArith: two
// untyped constants fold exactly (spec §6.4 const.expr.bitwise,
// const.expr.shift).
func foldIntBitwise(c @Checker, pos token.Pos, op int, lt @types.Type, rt @types.Type) @types.Type {
	return foldUntyped(c, pos, op, lt, rt)
}

// foldUntyped is foldIntArith / foldIntBitwise.
func foldUntyped(c @Checker, pos token.Pos, op int, lt @types.Type, rt @types.Type) @types.Type {
	if lt == nil || rt == nil {
		return commonType(c, pos, lt, rt)
	}
	if lt.Kind != types.TYP_UNTYPED_INT || rt.Kind != types.TYP_UNTYPED_INT {
		return commonType(c, pos, lt, rt)
	}
	if lt.NonConst || rt.NonConst {
		return commonType(c, pos, lt, rt)
	}
	if !lt.HasLitVal || !rt.HasLitVal {
		// An untyped constant whose value is not known here gives a result
		// whose value is not known either — not the other operand's, which
		// commonType's result carries (IR-gen folds a value-carrying untyped
		// type to that value).
		return types.TypUntypedInt()
	}
	var r constval.Value
	var st int
	r, st = constval.Binary(op, litValue(lt), litValue(rt))
	return untypedStamp(r, st)
}

// litValue returns the untyped integer constant an untyped-int type carries.
func litValue(t @types.Type) constval.Value {
	var v constval.Value
	v.N.Magnitude = t.LitMag
	v.N.Sign = t.LitSign
	return v
}

// untypedStamp returns the type of an untyped integer constant with value v
// and status st: an untyped int carrying v, or without a value when st is not
// OK.
func untypedStamp(v constval.Value, st int) @types.Type {
	if st != constval.OK || v.IsBool || v.Typ != nil {
		return types.TypUntypedInt()
	}
	return untypedIntOfNum(v.N)
}

// untypedIntOfNum returns a fresh untyped-int type carrying the constant n.
func untypedIntOfNum(n bignum.Num) @types.Type {
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.HasLitVal = true
	t.LitMag = n.Magnitude
	t.LitSign = n.Sign
	return t
}
