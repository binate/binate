package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"

// Type checking for index-shaped expressions: instantiate-or-index (`f[T]` /
// `x[i]`), index, and slice.

// checkInstantiateOrIndex dispatches an EXPR_INSTANTIATE_OR_INDEX
// node.  When the head resolves to a generic function, treats the
// brackets as generic instantiation; otherwise falls back to value
// indexing.
//
// Cross-package generic instantiation (Slice 7) — e.X may also be
// EXPR_SELECTOR `pkg.Name`; look up Name in the imported package's
// scope.
func checkInstantiateOrIndex(c @Checker, e @ast.Expr) @types.Type {
	// Generic-instantiation interpretation, available only when the
	// head is a bare identifier or a package-qualified selector
	// resolving to a generic FUNC symbol.
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.X.Name)
		if sym != nil && sym.Kind == types.SYM_FUNC && sym.Type != nil && len(sym.Type.TypeParams) > 0 {
			return instantiateGenericFunc(c, e, sym.Type)
		}
	}
	if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR && e.X.X != nil && e.X.X.Kind == ast.EXPR_IDENT {
		var pkgSym @Symbol = c.Scope.Lookup(e.X.X.Name)
		if pkgSym != nil && pkgSym.Kind == types.SYM_PKG {
			var pkgScope @Scope = lookupPackage(c, pkgSym.PkgPath)
			if pkgScope != nil {
				var sym @Symbol = pkgScope.Lookup(e.X.Name)
				if sym != nil && sym.Kind == types.SYM_FUNC && sym.Type != nil && len(sym.Type.TypeParams) > 0 {
					return instantiateGenericFunc(c, e, sym.Type)
				}
			}
		}
	}
	if len(e.Args) != 1 {
		addCheckError(c, e.Pos, "generic instantiation requires a generic function head")
		return types.TypError()
	}
	return checkIndexExpr(c, e)
}

// checkIndexExpr type-checks an index expression (slice, array, pointer, or string indexing).
// e.X is the collection; e.Args[0] is the index.
func checkIndexExpr(c @Checker, e @ast.Expr) @types.Type {
	if e.Unchecked { return checkUncheckedIndex(c, e) }
	var xt @types.Type = checkExpr(c, e.X)
	// A string literal is untyped; indexing it (`"abc"[i]`) reads a byte, so adopt
	// its natural [N]readonly char array — the array arm below then yields a readonly
	// char element, matching how a string literal indexed as an array behaved before
	// it was made untyped.
	if isUntypedString(xt) {
		xt = types.UntypedStringNaturalArray(xt)
	}
	var idx @ast.Expr = e.Args[0]
	var idxType @types.Type = checkExpr(c, idx)
	if !idxType.IsInteger() && !isErrType(idxType) {
		addCheckError(c, idx.Pos, "index must be integer")
	}
	if isErrType(xt) {
		return types.TypError()
	}

	// Whether any `readonly` wrapper is crossed reaching the collection.  For an
	// ARRAY this is object-const (the array is a read-only VALUE, so its elements
	// are read-only too — like a readonly struct's fields); for a slice/pointer the
	// outer readonly is HANDLE-const and does NOT ride to the elements (element
	// readonly-ness is carried by the element type itself, `*[]readonly T`).
	var baseConst bool
	_, baseConst = peelFieldAccessBase(xt)
	// StripWrappers sees through alias / readonly / named-distinct wrappers
	// to the concrete underlying, so indexing works on a named slice/array/
	// pointer type (`type Buf @[]int; b[0]`) as well as the bare composite.
	xt = types.StripWrappers(xt)
	if xt == nil {
		return types.TypVoid()
	}
	if xt.Kind == types.TYP_SLICE || xt.Kind == types.TYP_MANAGED_SLICE ||
			xt.Kind == types.TYP_ARRAY || xt.Kind == types.TYP_POINTER {
		// Indexing MATERIALIZES the element as a value, so an opaque (or
		// cross-package opaque-export) element is rejected here (bug 211).  Such
		// a collection can rarely be formed in the first place, but a provider
		// could hand one back, so gate the read.  requireSizedType no-ops on a
		// sized element.
		requireSizedType(c, xt.Elem, e.Pos)
		// A readonly ARRAY's element is read-only: `var r readonly [3]int; r[i] =
		// v` is rejected (the IsReadonly assignment-target guard fires on the
		// element type).  Slices/pointers keep the bare element type (handle-const).
		if xt.Kind == types.TYP_ARRAY && baseConst {
			return types.MakeReadonlyType(xt.Elem)
		}
		return xt.Elem
	}
	addCheckError(c, e.X.Pos, "cannot index this type")
	return types.TypError()
}

// checkSliceExpr type-checks a slice expression (x[lo:hi]).
func checkSliceExpr(c @Checker, e @ast.Expr) @types.Type {
	var xt @types.Type = checkExpr(c, e.X)
	// A string literal is untyped; slicing it (`"abc"[:]`) yields a *[]readonly char
	// subslice, so adopt its natural [N]readonly char array — the TYP_ARRAY arm below
	// then produces the raw slice, matching pre-untyped behavior.
	if isUntypedString(xt) {
		xt = types.UntypedStringNaturalArray(xt)
	}
	// Z = lo, Y = hi in the AST
	if e.Z != nil {
		var lt @types.Type = checkExpr(c, e.Z)
		if !lt.IsInteger() && !isErrType(lt) {
			addCheckError(c, e.Z.Pos, "slice index must be integer")
		}
	}
	if e.Y != nil {
		var ht @types.Type = checkExpr(c, e.Y)
		if !ht.IsInteger() && !isErrType(ht) {
			addCheckError(c, e.Y.Pos, "slice index must be integer")
		}
	}
	if isErrType(xt) {
		return types.TypError()
	}

	// StripWrappers sees through alias / readonly / named-distinct wrappers
	// to the concrete underlying.  A SLICE's outer readonly-ness (a property of
	// the storage handle) does not ride along to the fresh subslice value — only
	// element readonly-ness does, and that is carried by the underlying slice's
	// Elem.  An ARRAY reached through readonly is a read-only value whose elements
	// are read-only (checkIndexExpr's object-const), so its subslice views them as
	// readonly: `r[:]` of a `readonly [3]int` is a `*[]readonly int`, else the
	// subslice would write the array the readonly view protects.
	var baseConst bool
	_, baseConst = peelFieldAccessBase(xt)
	xt = types.StripWrappers(xt)
	if xt == nil {
		return types.TypVoid()
	}
	if xt.Kind == types.TYP_SLICE || xt.Kind == types.TYP_MANAGED_SLICE {
		return xt
	}
	if xt.Kind == types.TYP_ARRAY && baseConst {
		return types.MakeSliceType(types.MakeReadonlyType(xt.Elem))
	}
	if xt.Kind == types.TYP_ARRAY {
		return types.MakeSliceType(xt.Elem)
	}
	addCheckError(c, e.X.Pos, "cannot slice this type")
	return types.TypError()
}

// lowerUnsafeIndex rewrites the call `unsafe_index(c, i)` e, in place, into the
// index node `c[i]` marked Unchecked.  It is exactly `c[i]` without the bounds
// check (builtin.unsafe-index), so every rule and lowering of an index applies to
// it — addressable as `c[i]` is (a store, `++`, `&`, a field or method base, an
// indexed or sliced array element), its element read-only as `c[i]`'s — and only
// IR-gen's bounds and nil guards consult the mark.  Its type is checked under
// unsafe_index's own rule (checkUncheckedIndex), at every check of the node: the
// first, a generic instance's clone (which keeps the mark), a REPL retry.
func lowerUnsafeIndex(e @ast.Expr) {
	var idx @[]@ast.Expr = make_slice(@ast.Expr, 1)
	idx[0] = e.Args[1]
	e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
	e.Op = 0
	e.X = e.Args[0]
	e.Args = idx
	e.Unchecked = true
}

// checkUncheckedIndex checks the index node of an `unsafe_index(c, i)`
// (lowerUnsafeIndex) under that builtin's rule (builtin.unsafe-index): the
// collection a slice, managed-slice, array or raw pointer with only an alias
// peeled — never a named-distinct or read-only-wrapped one, which `c[i]` would
// accept — and the index an integer; the element is materialized as `c[i]`'s is,
// so it must be sized.  The result is the element type.
func checkUncheckedIndex(c @Checker, e @ast.Expr) @types.Type {
	var collType @types.Type = checkExpr(c, e.X)
	var idxType @types.Type = checkExpr(c, e.Args[0])
	if !idxType.IsInteger() && !isErrType(idxType) {
		addCheckError(c, e.Args[0].Pos, "unsafe_index index must be integer")
		return types.TypError()
	}
	if isErrType(collType) {
		return types.TypError()
	}
	collType = collType.ResolveAlias()
	if collType == nil { return types.TypVoid() }
	if collType.Kind == types.TYP_SLICE || collType.Kind == types.TYP_MANAGED_SLICE ||
			collType.Kind == types.TYP_ARRAY || collType.Kind == types.TYP_POINTER {
		requireSizedType(c, collType.Elem, e.Pos)
		return collType.Elem
	}
	addCheckError(c, e.X.Pos, "unsafe_index collection must be slice, array, or pointer")
	return types.TypError()
}
