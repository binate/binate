package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Type-checker tests for index-shaped expressions (instantiate-or-index,
// index, slice).  Matches check_expr_index.bn.

// ============================================================
// Index expressions — checkInstantiateOrIndex / checkIndexExpr
// ============================================================

// Single-arg `[i]` form goes through checkIndexExpr.  s is a raw
// slice; s[0] is well-typed at int.
func TestCheckSliceIndex() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[0] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Indexing a non-indexable type rejects.
func TestCheckIndexNonIndexable() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var n int; var x int = n[0] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-integer index rejects — checkIndexExpr's
// `idxType.IsInteger()` gate.
func TestCheckIndexNonIntegerIndex() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[true] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Multi-arg bracketed form `name[T1, T2]` is the syntactic shape
// of a generic instantiation; Slice 1's checkInstantiateOrIndex
// rejects with "generic instantiation not yet supported."
func TestCheckMultiArgInstantiateRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[0, 1] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Slice expressions — checkSliceExpr
// ============================================================

// Basic two-bound slice on a *[]int — preserves slice type.
func TestCheckSliceExprTwoBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var t *[]int = s[1:3] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Open lower bound (`s[:hi]`).
func TestCheckSliceExprOpenLo() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var t *[]int = s[:2] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Array-to-slice via slice expression: `arr[1:3]` on a `[4]int`
// is a `*[]int`.
func TestCheckSliceExprArrayToSlice() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var arr [4]int; var s *[]int = arr[1:3] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Slicing a non-sliceable type (a plain int) rejects.
func TestCheckSliceExprNotSliceable() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var n int; var s *[]int = n[0:1] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-integer hi-bound rejects.
func TestCheckSliceExprNonIntegerBound() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var s *[]int; var t *[]int = s[0:true] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Slicing through an OUTER `readonly` modifier is allowed: the result
// is a fresh subslice whose type is the underlying slice (`*[]int`),
// not readonly-wrapped — so `var t *[]int = s[1:3]` type-checks.
// checkSliceExpr unwraps TYP_READONLY exactly as checkIndexExpr does.
func TestCheckSliceExprReadonlyOuter() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var s readonly *[]int; var t *[]int = s[1:3] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A readonly ARRAY's elements are read-only, so its subslice views them as
// readonly: binding it to a writable `*[]int` is rejected, `*[]readonly int`
// accepted — directly, through a readonly pointer, and through a readonly
// struct's array field.
func TestCheckSliceExprReadonlyArray() testing.TestResult {
	if !rejectsSliceBinding("func f() { var r readonly [3]int; var w *[]int = r[:] }\n") {
		return fail("a readonly array's subslice must not bind to *[]int")
	}
	if !rejectsSliceBinding("func f(p *(readonly [2]int)) { var w *[]int = (*p)[:] }\n") {
		return fail("a subslice through *(readonly [2]int) must not bind to *[]int")
	}
	var named *[]readonly char = "type Row [3]int\n"
			"func f() { var r readonly Row; var w *[]int = r[1:] }\n"
	if !rejectsSliceBinding(named) {
		return fail("a readonly named array's subslice must not bind to *[]int")
	}
	if !rejectsSliceBinding("func f() { var r readonly [2][2]int; var w *[]int = r[0][:] }\n") {
		return fail("an inner array of a readonly array must not slice to *[]int")
	}
	var ok *[]readonly char = "package \"test\"\n"
			"type S struct { a [2]int }\n"
			"func f(s readonly S) { var r readonly [3]int; var w *[]readonly int = r[1:]\n"
			"\tvar v *[]readonly int = s.a[:] }\n"
	return expectNoErrors(checkSrc(ok))
}

// rejectsSliceBinding reports whether the function declarations in decls fail to
// check with exactly one "cannot assign *[]readonly int to *[]int" error — a
// readonly array's subslice bound to a writable slice.
func rejectsSliceBinding(decls *[]readonly char) bool {
	var src @[]char = buf.Concat("package \"test\"\n", decls)
	var errs @[]types.CheckError = checkSrc(src).CheckerErrors()
	return len(errs) == 1 && msgContains(errs[0].Msg, "cannot assign *[]readonly int to *[]int")
}
