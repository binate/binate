package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Unary-expression checking (-, !, ~, *, &)
// ============================================================

// checkUnaryExpr type-checks a unary expression (-, !, ~, *, &).
func checkUnaryExpr(c @Checker, e @ast.Expr) @types.Type {
	var xt @types.Type = checkExpr(c, e.X)
	if isErrType(xt) {
		return types.TypError()
	}
	if e.Op == cast(int, token.PLUS) {
		// Unary + is a numeric identity: it requires a numeric operand and
		// yields it unchanged (including any carried untyped-literal value, so
		// `var x int8 = +5` fit-checks exactly like `5`).
		if !xt.IsNumeric() {
			addCheckError(c, e.Pos, "unary + requires numeric operand")
		}
		return xt
	}
	if e.Op == cast(int, token.MINUS) {
		if !xt.IsNumeric() {
			addCheckError(c, e.Pos, "unary - requires numeric operand")
		}
		// Propagate the literal value through unary minus so that
		// `var x int8 = -128` accepts and `var x int8 = -129`
		// rejects in the AssignableTo fit-check.
		if xt != nil && xt.Kind == types.TYP_UNTYPED_INT && xt.HasLitVal {
			var r constval.Value
			var st int
			r, st = constval.Unary(e.Op, litValue(xt))
			return untypedStamp(r, st)
		}
		return xt
	}
	if e.Op == cast(int, token.NOT) {
		if !xt.IsBool() {
			addCheckError(c, e.Pos, "unary ! requires bool operand")
		}
		return types.TypUntypedBool()
	}
	if e.Op == cast(int, token.TILDE) {
		if !xt.IsInteger() {
			addCheckError(c, e.Pos, "unary ~ requires integer operand")
		}
		// Fold `~` of an untyped constant exactly: ~x is -x - 1, the complement of
		// the infinitely sign-extended two's-complement value (spec §6.4
		// const.expr.bitwise) — so `~0` is -1 in the fit check and the
		// negative-shift-count gate.  A result outside the union range (`~x` for
		// x >= 2^63) is a constant overflow.
		if xt != nil && xt.Kind == types.TYP_UNTYPED_INT && xt.HasLitVal {
			var r constval.Value
			var st int
			r, st = constval.Unary(e.Op, litValue(xt))
			return untypedStamp(r, st)
		}
		return xt
	}
	if e.Op == cast(int, token.STAR) {
		// Dereference.  Peel named-distinct / alias / readonly wrappers first
		// (StripWrappers) so a named-distinct pointer (`type P *int`) derefs
		// to its pointee — named-distinct is transparent for the pointer
		// operations, exactly as index/field access already peel.  Un-peeled,
		// PointerElem returns nil for a TYP_NAMED pointer and `*p` was wrongly
		// rejected as "cannot dereference non-pointer".
		var elem @types.Type = types.StripWrappers(xt).PointerElem()
		if elem == nil {
			addCheckError(c, e.Pos, "cannot dereference non-pointer")
			return types.TypError()
		}
		// Reading `*p` MATERIALIZES the pointee as a value, so an opaque (or
		// cross-package opaque-export) pointee is rejected here — the escape
		// hatch is to hold `*Opaque` / `@Opaque` and pass it around, never to
		// deref it to a value whose layout is unavailable.  Bug 211 / 846.
		requireSizedType(c, elem, e.Pos)
		return elem
	}
	if e.Op == cast(int, token.AMP) {
		// Address-of.  The operand must be an addressable lvalue — it must
		// have storage.  `isAddressable` is the single gate; `reportCannotAddr`
		// picks the most specific diagnostic.  A pointer type is still
		// returned so the use site doesn't cascade a second error.
		if !isAddressable(c, e.X) {
			reportCannotAddr(c, e)
		} else {
			noteAddressedLiteral(c, e.X)
		}
		return types.MakePointerType(xt)
	}
	addCheckError(c, e.Pos, "invalid unary operator")
	return types.TypError()
}
