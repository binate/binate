package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// A field takes precedence over a same-named method (expr.member): a call's
// selector that reads a function-value field is marked FieldSel, and a method
// call's selector is not.
func TestCheckCallOfFieldOverSameNamedMethod() testing.TestResult {
	var sels @[]@ast.Expr = mainCallSelectors(
			"package \"test\"\n"
					"type T struct { f @func(int, int) }\n"
					"func (t *T) f(n int) {}\n"
					"func (t *T) g() {}\n"
					"func main() {\n"
					"  var t @T = make(T)\n"
					"  t.f(1, 2)\n"
					"  t.g()\n"
					"}\n")
	if len(sels) != 2 { return "expected 2 call statements" }
	if !sels[0].FieldSel { return "a call of the field must mark its selector FieldSel" }
	if sels[1].FieldSel { return "a method call's selector reads no field" }
	return ""
}

// The field's parameters are what a call of it binds: the same-named method's
// arity does not apply.
func TestCheckCallOfFieldTakesFieldArity() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type T struct { f @func(int, int) }\n"
					"func (t *T) f(n int) {}\n"
					"func main() {\n"
					"  var t @T = make(T)\n"
					"  t.f(1)\n"
					"}\n")
	return expectErrSub(c, "wrong number of arguments")
}

// A non-function field hides a same-named method: calling it is an error.
func TestCheckFieldHidesSameNamedMethod() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type T struct { n int }\n"
					"func (t *T) n() int { return 1 }\n"
					"func main() {\n"
					"  var t @T = make(T)\n"
					"  _ = t.n()\n"
					"}\n")
	return expectErrSub(c, "cannot call non-function")
}

// A generic body's call through a type parameter's constraint stays a call of
// the type argument's method in each instance, even where that type's struct
// has a field of the name (gen.mono.constraint-call): the instance checks
// without error.
func TestCheckConstraintCallOverSameNamedField() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Fer { f(n int) }\n"
					"type S struct { f int }\n"
					"func (s @S) f(n int) {}\n"
					"impl @S : Fer\n"
					"func G[T Fer](t T) { t.f(1) }\n"
					"func main() {\n"
					"  var s @S = make(S)\n"
					"  G[@S](s)\n"
					"}\n")
	return expectNoErrors(c)
}
