package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// A generic function's instances: each is formed once, the first time it is named
// (funcInstance), its signature resolved for its type arguments from its own copy
// of the declaration's signature, and its body's check queued in the class it is
// named in, as again in each class it is named in later.

// FuncInstance is the generic function Decl instantiated with the concrete type
// arguments Args; Sig is its signature for them, State its body's check (that of
// its first lender class: instStateFor).  SigWaited is set while Sig was
// resolved reading a layout not built yet (resolveFuncInstanceSig).  Held is
// what its signature's resolution and body check hold while it is provisional
// (check_held.bn).  Unnamed is set while it is not named, first formed where no
// program names anything: it has no State then, and its Held drops what it holds
// (check_unnamed.bn).
type FuncInstance struct {
	Decl      @ast.Decl
	Args      @[]@types.Type
	Sig       @types.Type
	State     @InstCheckState
	SigWaited bool
	Held      @heldReports
	Unnamed   bool
}

// funcInstance returns the instance of the generic function declaration d for
// the concrete type arguments args, creating it on first use — resolving its
// signature in d's home and queuing its body check, named at site — and queuing
// the check again when it needs it (needsInstanceCheck), or resolving its
// signature again when that waited for a layout; nil when d has no recorded
// home.  Where nothing is named, nothing is queued, and an instance first formed
// there is named when it is next formed elsewhere, its signature resolved again
// (check_unnamed.bn).
func funcInstance(c @Checker, d @ast.Decl, args *[]@types.Type, site token.Pos) @FuncInstance {
	var home @GenericHome = genericHomeOf(c, d)
	if home == nil {
		return nil
	}
	var st @InstanceState = instanceState(c)
	var key funcInstKey
	key.decl = d
	key.args = args
	fi, found := st.FuncIndex.Get(key)
	if found {
		var naming bool = judgesConstraints(c) && !(fi.Unnamed && resolutionWaits(c))
		var named bool = naming && fi.Unnamed
		if named { nameFuncInstance(c, fi, home, site) }
		var s @InstCheckState = instStateFor(c, fi.State, site, args)
		if naming {
			var redone bool = heldNamed(c, fi.Held)
			if !redone && needsInstanceCheck(c, s) {
				enqueueFuncWork(c, d, args, site, s)
			}
			noteInstanceNamed(c, s, site)
		}
		// Done again in the class it is named in now, as the first naming's would
		// have been in its.
		if fi.SigWaited || named {
			if s == nil { s = firstInstState(c, args, site, home.Pkg) }
			var redo @InstWork = newInstWork(c, d.Name, args, site)
			redo.Decl = d
			redo.State = s
			redo.Lenders = s.Lenders
			redo.ChainRoot = s.ChainRoot
			redo.VRoot = s.VRoot
			resolveFuncInstanceSig(c, fi, home, redo)
		}
		return fi
	}
	var inst @FuncInstance = make(FuncInstance)
	inst.Decl = d
	inst.Args = copyTypeList(args)
	var s @InstCheckState = firstInstState(c, args, site, home.Pkg)
	inst.Unnamed = !judgesConstraints(c)
	if !inst.Unnamed { inst.State = s }
	st.Funcs.Push(inst)
	var ikey funcInstKey
	ikey.decl = d
	// bnlint:allow managed-to-raw-assign - inst owns its Args while it is in the index
	ikey.args = inst.Args
	st.FuncIndex.Put(ikey, inst)
	inst.Held = newInstanceHeld(c, d, args)
	var savedHold @heldReports = beginHolding(c, inst.Held)
	var w @InstWork = enqueueFuncWork(c, d, args, site, s)
	endHolding(c, savedHold)
	resolveFuncInstanceSig(c, inst, home, w)
	if !inst.Unnamed { noteInstanceNamed(c, inst.State, site) }
	return inst
}

// resolveFuncInstanceSig resolves the signature of the function instance inst
// (resolveInstanceSignature), the instances it derives named from the instance's
// work w, in w's class: their chain starts where it is named.  A resolution that reads a
// layout not built yet, inside an instance's build (enterDemandFrame), waits
// with that build, and is done again when inst is next named (SigWaited), as
// one not made inside a build that waits already (skipDemand).
func resolveFuncInstanceSig(c @Checker, inst @FuncInstance, home @GenericHome, w @InstWork) {
	if skipDemand(c) {
		inst.SigWaited = true
		return
	}
	var st @InstanceState = instanceState(c)
	var savedCur @InstWork = st.Current
	var savedBuilding bool = st.Building
	var savedBuildLenders @[]@[]char = st.BuildLenders
	var savedBuildRoot @[]char = st.BuildChainRoot
	var savedBuildVRoot @[]char = st.BuildVRoot
	var savedSite siteState = clearSite(c)
	st.Current = w
	st.Building = true
	st.BuildLenders = w.Lenders
	st.BuildChainRoot = w.ChainRoot
	st.BuildVRoot = w.VRoot
	var callerHold @heldReports = holding(c)
	var framed bool = enterDemandFrame(c)
	pushInstanceNaming(c, w, inst.Decl)
	// Held as the instance's, while provisional or unnamed, or as the build it is
	// named in (beginInstanceHolding).
	var savedHold @heldReports = beginInstanceHolding(c, inst.Held, callerHold)
	var savedAbstract bool = enterConcrete(c)
	inst.Sig = resolveInstanceSignature(c, home, inst.Decl, inst.Args)
	leaveConcrete(c, savedAbstract)
	endHolding(c, savedHold)
	popInstanceNaming(c)
	inst.SigWaited = leaveDemandFrame(c, framed)
	st.Current = savedCur
	st.Building = savedBuilding
	st.BuildLenders = savedBuildLenders
	st.BuildChainRoot = savedBuildRoot
	st.BuildVRoot = savedBuildVRoot
	restoreSite(c, savedSite)
}

// resolveInstanceSignature resolves the signature of the generic function
// declaration d from a copy of it, in its home with each type parameter bound
// to its argument.
func resolveInstanceSignature(c @Checker, home @GenericHome, d @ast.Decl,
		args *[]@types.Type) @types.Type {
	var sig @ast.Decl = ast.CloneFuncSignature(d)
	var noParams @[]@ast.TypeParam
	sig.TypeParams = noParams
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = home.Pkg
	c.Scope = NewScope(home.Scope)
	for i := 0; i < len(d.TypeParams) && i < len(args); i++ {
		if !isBlank(d.TypeParams[i].Name) {
			defineType(c.Scope, d.TypeParams[i].Name, args[i])
		}
	}
	var savedDeriving bool = c.Generics.DerivingInstanceSig
	c.Generics.DerivingInstanceSig = true
	var ft @types.Type = resolveFuncDeclType(c, sig)
	c.Generics.DerivingInstanceSig = savedDeriving
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	return ft
}
