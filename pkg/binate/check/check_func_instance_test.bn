package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_func_instance.bn: a generic function's instance is formed, and
// its body checked, for the instances the program names -- not for one whose type
// arguments hold a length that depends on a type parameter, nor for one formed
// only where no program names anything.

// f[[sizeof(Y)]uint8, int32] in g's body depends on Y: with g never instantiated it
// is not named, though f's K[@T, W] misses for W = int32 whatever X is -- in f's
// signature or its body.  With g[int8] named, f[[1]uint8, int32] is, via it.
func TestDependentArgFuncInstanceNotNamed() testing.TestResult {
	var g *[]readonly char = "func g[Y any](y Y) int { return f[[sizeof(Y)]uint8, int32](nil) }\n"
	var f *[]readonly char = "func f[X any, W any](x *X) int { var k *K[@T, W]; _ = k; return 0 }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat(aliasMissPrelude, buf.Concat(f, g))))
	if len(r) > 0 { return r }
	r = expectNoErrors(checkSrc(
			buf.Concat(aliasMissPrelude, "func f[X any, W any](x *X, k *K[@T, W]) int { return 0 }\n"
					"func g[Y any](y Y) int { return f[[sizeof(Y)]uint8, int32](nil, nil) }\n")))
	if len(r) > 0 { return r }
	return expectOneError(
			checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, buf.Concat(f, g)),
					"func k() int { return g[int8](1) }\n")),
			"Tag[[4]uint8] (in f[[1]uint8, int32], instantiated at test.bn:11:24 via g[int8])")
}

// f[Y, int32]'s signature, substituted in g's body, forms M[int32], which no program
// names with g never instantiated; with g[int8] named, f[int8, int32] names it.
func TestAbstractFuncInstanceSignatureNamesNothing() testing.TestResult {
	var decls @[]char = buf.Concat(aliasMissPrelude, "type M[U any] struct { k *K[@T, U] }\n"
			"func f[X any, W any](x *X, m *M[W]) int { return 0 }\n"
			"func g[Y any](y Y) int { return f[Y, int32](nil, nil) }\n")
	var r testing.TestResult = expectNoErrors(checkSrc(decls))
	if len(r) > 0 { return r }
	return expectOneError(checkSrc(buf.Concat(decls, "func h() int { return g[int8](1) }\n")),
			"Tag[[4]uint8] (in M[int32], instantiated at test.bn:12:24 via g[int8])")
}

// gf[@T, int32], called in an array length of H[X, int32]'s structure only, is not
// named: neither its signature nor its body, where K[@T, int32] misses, is judged;
// called where the program names it, before or after, it is.
func TestFuncInstanceFormedThroughAbstractNotNamed() testing.TestResult {
	var gfs @[]@[]char = @[]@[]char{
			"func gf[V Tag[[8]uint8], U any](k *K[V, U]) [3]uint8 { var r [3]uint8; return r }\n",
			"func gf[V Tag[[8]uint8], U any](p *U) [3]uint8 { var k *K[V, U]; _ = k; "
					"var r [3]uint8; return r }\n"}
	var h *[]readonly char = "type H[V any, W any] struct { a [len(gf[@T, W](nil))]uint8; v V }\n"
			"func f[X any](h *H[X, int32]) int { return 0 }\n"
	var g *[]readonly char = "func g() int { var r [3]uint8 = gf[@T, int32](nil); return len(r) }\n"
	for i := 0; i < len(gfs); i++ {
		var decls @[]char = buf.Concat(aliasMissPrelude, buf.Concat(gfs[i], h))
		var r testing.TestResult = expectNoErrors(checkSrc(decls))
		if len(r) > 0 { return r }
		r = expectOneError(checkSrc(buf.Concat(decls, g)),
				"Tag[[4]uint8] (in gf[@T, int32], instantiated at test.bn:12:35)")
		if len(r) > 0 { return r }
		r = expectOneError(checkSrc(buf.Concat(aliasMissPrelude, buf.Concat(gfs[i], buf.Concat(g, h)))),
				"Tag[[4]uint8] (in gf[@T, int32], instantiated at test.bn:10:35)")
		if len(r) > 0 { return r }
	}
	return ""
}

// gf's body does not check, so no instance's body is; gf[@T, int32], formed only in
// H[X, int32]'s structure, misses in its signature, which is judged once a call the
// program names forms it: its miss is reported beside the body's error.
func TestFuncInstanceSignatureJudgedWhenNamed() testing.TestResult {
	var decls @[]char = buf.Concat(aliasMissPrelude,
			"func gf[V Tag[[8]uint8], U any](k *K[V, U]) [3]uint8 { var x int = 1.5; _ = x; "
					"var r [3]uint8; return r }\n"
					"type H[V any, W any] struct { a [len(gf[@T, W](nil))]uint8; v V }\n"
					"func f[X any](h *H[X, int32]) int { return 0 }\n")
	var c @Checker = checkSrc(decls)
	if len(c.CheckerErrors()) != 1 {
		return fail(buf.Concat("expected gf's body error alone; ", allErrorMsgs(c)))
	}
	c = checkSrc(
			buf.Concat(decls, "func g() int { var r [3]uint8 = gf[@T, int32](nil); return len(r) }\n"))
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c, "Tag[[4]uint8] (in gf[@T, int32], instantiated at test.bn:12:35)") {
		return fail(buf.Concat("expected gf's body error and gf[@T, int32]'s miss; ", allErrorMsgs(c)))
	}
	return ""
}
