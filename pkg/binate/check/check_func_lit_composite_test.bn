package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// A function literal in a composite-literal field / element takes the field /
// element type as its destination (func.lit.inferred-default): a raw `*func`
// slot pins it to the raw form, and a named function-value slot gives it the
// named type.

// firstFuncLitKind checks src, which must type-check cleanly, and returns the
// kind of its first function literal's resolved type (-1 with a failure result
// otherwise).
func firstFuncLitKind(src *[]readonly char) (int, testing.TestResult) {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(src)
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return -1, r }
	var lit @ast.Expr = findFirstFuncLitExpr(file)
	if lit == nil { return -1, fail("literal Expr not found") }
	var t @types.Type = c.ExprType(lit.ResolvedTypeID)
	if t == nil { return -1, fail("literal type unresolved") }
	return t.Kind, ""
}

func TestCheckFuncLitHintPropagatesThroughKeyedStructField() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"type H struct { g *func(int) int }\n"
					"func main() {\n"
					"  var n int = 1\n"
					"  var h H = H{g: func(x int) int { return x + n }}\n"
					"  _ = h\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_FUNC_VALUE { return fail("expected TYP_FUNC_VALUE for a *func field") }
	return ""
}

func TestCheckFuncLitHintPropagatesThroughPositionalStructField() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"type H struct { g *func(int) int }\n"
					"func main() {\n"
					"  var n int = 1\n"
					"  var h H = H{func(x int) int { return x + n }}\n"
					"  _ = h\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_FUNC_VALUE { return fail("expected TYP_FUNC_VALUE for a *func field") }
	return ""
}

func TestCheckFuncLitHintPropagatesThroughNamedArrayElem() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"type MFn @func(int) int\n"
					"func main() {\n"
					"  var a [3]MFn = [3]MFn{2: func(x int) int { return x }}\n"
					"  _ = a\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_NAMED { return fail("expected the named MFn for a keyed MFn element") }
	return ""
}

func TestCheckFuncLitHintPropagatesThroughSliceElem() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"type RF = *func(int) int\n"
					"func main() {\n"
					"  var n int = 1\n"
					"  var s @[]RF = @[]RF{func(x int) int { return x + n }}\n"
					"  _ = s\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_FUNC_VALUE { return fail("expected TYP_FUNC_VALUE for a *func element") }
	return ""
}

// An extra positional value has no field to hint it: the literal is checked
// with no destination and the over-count is reported.
func TestCheckFuncLitPositionalOverCountRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type H struct { g *func(int) int }\n"
					"func main() {\n"
					"  var h H = H{func(x int) int { return x }, func(x int) int { return x }}\n"
					"  _ = h\n"
					"}\n")
	return expectErrSub(c, "too many values in struct literal")
}
