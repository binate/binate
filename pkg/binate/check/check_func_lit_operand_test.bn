package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// A function literal that is an operand -- of a `bit_cast` or a `box` -- is not itself a
// destination, so it takes the managed `@func` default even inside an expression whose
// destination is a raw or named function value (func.lit.inferred-default).
// (firstFuncLitKind is in check_func_lit_composite_test.bn.)

// A `bit_cast` operand keeps the default: the literal is `@func`, though the
// `bit_cast`'s own destination is a `*func`.
func TestCheckFuncLitBitCastOperandIsDefault() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"func main() {\n"
					"  var p *func() int = bit_cast(*func() int, func() int { return 1 })\n"
					"  _ = p\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_MANAGED_FUNC_VALUE {
		return fail("a bit_cast operand took the *func destination")
	}
	return ""
}

// A `box` operand keeps the default: the literal is `@func`, so `*box(lit)` is an
// `@func`, which is not assignable to a named `*func` type.
func TestCheckFuncLitBoxOperandIsDefault() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Fn *func() int\n"
					"func main() {\n"
					"  var f Fn = *box(func() int { return 1 })\n"
					"  _ = f\n"
					"}\n")
	return expectError(c)
}

// The same literal as the destination itself still takes it.
func TestCheckFuncLitDestinationStillTakesNamedType() testing.TestResult {
	var k int
	var r testing.TestResult
	k, r = firstFuncLitKind(
			"package \"test\"\n"
					"type Fn *func() int\n"
					"func main() {\n"
					"  var f Fn = func() int { return 1 }\n"
					"  _ = f\n"
					"}\n")
	if len(r) != 0 { return r }
	if k != types.TYP_NAMED { return fail("a literal destination did not take the named type") }
	return ""
}
