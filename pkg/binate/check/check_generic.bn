package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Generic-FUNCTION instantiation and constraint checking.  When
// `name[args...]` resolves to a generic function symbol, substitute
// the type-args into its
// signature (substituteTypeParams) and check each arg against its
// constraint (typeSatisfiesConstraint).  Generic TYPE instantiation
// (`Name[args]` -> @types.Type) lives in check_generic_type.bn.

// instantiateGenericFunc substitutes e.Args (parsed as Expr nodes
// with type-arg meaning — see typeArgFromExpr) into a generic
// FUNC type's Params and Results.  Returns the instantiated FUNC
// type or TypVoid() on error.
func instantiateGenericFunc(c @Checker, e @ast.Expr, ft @types.Type) @types.Type {
	if len(e.Args) != len(ft.TypeParams) {
		addCheckError(c, e.Pos, "wrong number of type arguments to generic function")
		return types.TypError()
	}
	// Pass 1: resolve every type argument.  Done before the
	// constraint checks so a constraint that names another type
	// parameter (`use[X any, T Container[X]]`) is substituted against
	// the FULL resolved arg list in pass 2.  (The constraint type
	// expression can only name an EARLIER-declared type param — a
	// forward reference `use[T Container[X], X any]` is already
	// rejected at decl time by installTypeParamScope's in-order
	// scoping, before instantiation.)
	var argTypes @[]@types.Type
	var formed bool = true
	for i := 0; i < len(e.Args); i++ {
		var t @types.Type = typeArgFromExpr(c, e.Args[i])
		if t == nil { t = types.TypVoid() }
		// While the batch's declarations are collected (an array length
		// instantiates it) the argument's types may not be collected yet: they
		// are first (prepareLayout), so it is judged by its layout below, not
		// taken for an opaque type.
		_ = prepareLayout(c, t, e.Args[i].Pos)
		// A type argument is a type formed here, held to the rules on forming a
		// type and to the target's size limit whether or not the instance lays it
		// out (type.opaque.pointer-to-embedding, type.layout.max-size).
		if requireFormedArg(c, t, e.Args[i].Pos) {
			_ = requireFitting(c, t, e.Args[i].Pos)
		} else {
			formed = false
		}
		argTypes = slices.Append[@types.Type](argTypes, t)
	}
	// Pass 2: constraint satisfaction.
	// nil TpConstraint = `any` = no check.  Otherwise the type-arg
	// must satisfy the constraint interface, taken for the type arguments
	// (a type-param-parameterized `Container[X]` is the concrete
	// `Container[int]`): with concrete arguments, resolved for them from the
	// generic's declaration (instanceConstraint), so a length that depends on a
	// type parameter gets its value; otherwise the arguments are substituted
	// into the abstract constraint.
	var concrete bool = !typeArgsAbstract(argTypes)
	for i := 0; i < len(e.Args); i++ {
		// An argument already reported as erroneous is not checked against the
		// constraint, which would report it again.
		var tparam @types.Type = ft.TypeParams[i]
		if tparam != nil && tparam.TpConstraint != nil && !isErrType(argTypes[i]) {
			var constraint @types.Type = nil
			var resolved bool = false
			if concrete {
				constraint, resolved = instanceConstraint(c, genericFuncDecl(ft), i, argTypes)
			}
			if !resolved {
				constraint = substituteTypeParams(c, tparam.TpConstraint, argTypes)
			}
			if !constraintJudged(constraint) {
				continue
			}
			var view ImplView = implViewAt(c, e.Pos)
			if c.CollectingDecls {
				// While the batch's declarations are collected (an array length
				// instantiates it) the impls are not all recorded: the check is
				// made once they are (recheckDeferredConstraints).
				deferFuncConstraintCheck(c, argTypes[i], constraint, view, e.Args[i].Pos)
			} else if !typeSatisfiesConstraint(c, argTypes[i], constraint, view) {
				reportConstraintMiss(c, e.Args[i].Pos, argTypes[i], constraint, view)
			}
		}
	}
	// With concrete type arguments the signature is the instance's, resolved
	// for them from the generic's declaration (a length that depends on a type
	// parameter gets its value); otherwise the arguments are substituted into
	// the abstract signature.
	var sig @types.Type = nil
	if !typeListMentionsTypeParam(argTypes) {
		var inst @FuncInstance = funcInstance(c, genericFuncDecl(ft), argTypes, e.Pos)
		if inst != nil {
			sig = inst.Sig
		}
	}
	if sig == nil {
		sig = substituteFuncSig(c, ft, argTypes)
	}
	// Reject an instantiation that forms an opaque VALUE: a param or result
	// that, with the type arguments, embeds an opaque type by value —
	// `id[Opaque]` (param / return T) or `mk[Opaque]` (return T).  The call would
	// pass or form an opaque value; `mk[Opaque]()` otherwise silently
	// monomorphizes to an i64-returning function (colliding with `mk[int]`).  A
	// type-param used only behind `*T` / `@T` stays legal.  Runs at the call site
	// (pass 2), so the args are resolved — no forward-ref false-positive.  An
	// argument already reported as ill-formed is not reported again through
	// the signature.
	if formed { requireCallSigKept(c, ft, argTypes, sig, e.Pos) }
	return types.MakeFuncType(sig.Params, sig.Results)
}

// constraintRecvMatches reports whether the type argument t matches recv, the
// receiver of a parameterized impl's instance (gen.satisfy): t is recv, as a
// plain impl's receiver must be the type argument — or t is the value type whose
// raw pointer recv is (`W[int]` through `impl *W[K]`: gen.impl.generic-recv's
// `impl *Cursor[T] : Iterator[T]` asserts that `Cursor[T]` satisfies it).  A
// pointer, raw or managed, satisfies through no other receiver shape (`@W[int]`
// through `impl W[K]` or `impl *W[K]`, `*W[int]` through `impl W[K]`).
func constraintRecvMatches(t @types.Type, recv @types.Type) bool {
	if t.Identical(recv) { return true }
	var tKind int
	var rKind int
	_, tKind, _ = receiverShape(t)
	_, rKind, _ = receiverShape(recv)
	return tKind == 0 && rKind == 1 && receiverAssignable(t, recv)
}

// typeSatisfiesConstraint reports whether `t` has an `impl t : I`
// declaration visible from view (implVisible), OR an `impl t : J` where J extends I
// (interface inheritance — `impl int : Orderable` satisfies a
// `Comparable` constraint because Orderable extends Comparable).
// Walks c.Impls; matches via Identical on the receiver type and
// (Pkg, Name) on the interface, with isDescendantInterface
// covering the transitive case.
//
// Identical-only receiver matching keeps things simple: `f[int]`
// matches `impl int : I`, not `impl *int : I`.  Receiver-kind
// smoothing (matching `f[Foo]` against `impl *Foo : I`) is not
// done.  A parameterized impl's substituted receiver is matched by
// constraintRecvMatches.
func typeSatisfiesConstraint(c @Checker, t @types.Type, iface @types.Type, view ImplView) bool {
	if t == nil || iface == nil { return false }
	if iface.Kind != types.TYP_INTERFACE { return false }
	// A forwarded type parameter satisfies `iface` when its own
	// declared bound is (or extends) `iface`: inside `outer[T
	// Orderable]`, the call `inner[T]` (callee `inner[T Orderable]`)
	// must accept T because T's bound IS Orderable.  The receiver
	// here is a type param, not a concrete type, so no `impl` record
	// can apply — consult TpConstraint instead.
	if t.Kind == types.TYP_TYPE_PARAM {
		return boundSatisfiesConstraint(t.TpConstraint, iface)
	}
	// `Self` in an interface's method signature is bounded by that interface
	// alone (spec iface.self.constraint): the implementing types are not known.
	if t.Kind == types.TYP_SELF {
		return boundSatisfiesConstraint(c.SelfBound, iface)
	}
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil || !implVisible(rec, view) { continue }
		// Generic blanket impl (`impl Wrap[K] : Hasher[K]`): its recorded
		// receiver is the parameterized `Wrap[K]`, which is never Identical
		// to a concrete instantiation `Wrap[int]`.  Substitute the impl's
		// binders with the instantiation's args and check concretely — the
		// same path the assignment/construction site uses.  Without this a
		// generic policy type never satisfies a generic interface constraint
		// (`bucketOf[int, Wrap[int]]` would be rejected even though every
		// `Wrap[τ]` implements `Hasher[τ]`).
		if rec.Placeholder != nil {
			if genericImplSatisfiesConstraint(c, rec, t, iface) { return true }
			continue
		}
		if !t.Identical(rec.RecvType) { continue }
		if implCoversInterface(rec, iface) { return true }
		// Walk the impl's interface list looking for any entry
		// whose chain of parents reaches `iface`.
		// isDescendantInterface already implements the transitive check.
		for j := 0; j < len(rec.Interfaces); j++ {
			var entry @types.Type = rec.Interfaces[j]
			if entry == nil { continue }
			if isDescendantInterface(entry, iface) {
				return true
			}
		}
	}
	return false
}

// constraintJudged reports whether an instantiation's constraint, taken for its
// type arguments, is judged: not one whose resolution reported its error (a type
// argument of it is the error type), which would only add "does not satisfy
// constraint I[<error>]".
func constraintJudged(constraint @types.Type) bool {
	if constraint == nil {
		return false
	}
	var v typeVisits
	return !mentionsTypeWhere(constraint, isErrType, &v)
}

// reportConstraintMiss emits a "T does not satisfy I" error
// pointing at the offending type-arg site, whose view is view.
func reportConstraintMiss(c @Checker, pos token.Pos, t @types.Type, iface @types.Type,
		view ImplView) {
	// A REPL declaration may use a type argument an impl not yet declared
	// would make satisfy the constraint (noteMissingImplOf).
	var named @types.Type = peelAliasReadonly(t)
	if named != nil && named.Kind == types.TYP_NAMED && noteMissingImplOf(c, pos, named, iface) {
		return
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type argument ")
	cb.Write(t.TypeName())
	cb.Write(" does not satisfy constraint ")
	cb.Write(iface.TypeName())
	cb.Write(constraintImplNote(c, t, iface, view))
	cb.Write(selfBoundNote(c, t, iface))
	cb.Write(sameNameBoundNote(t, iface))
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// typeArgFromExpr interprets an Expr-shape parse node as a type
// expression.  The parser parses `f[int, *Point]`'s bracketed
// args as Exprs (the syntactic shape is ambiguous with value
// indexing), so we convert here.
//
// Accepts: EXPR_IDENT (unqualified named-type lookup), EXPR_SELECTOR
// (a bare package-qualified named type `pkg.T`), and EXPR_UNARY(STAR, X)
// (a raw pointer, or a raw interface value when X names an interface).
// EXPR_TYPE carries a fully-parsed TypeExpr for
// a type argument with no expression spelling (`@T`, `@[]T`, `*[]T`,
// `readonly T`, `*(@[]T)`, `*func(T) R`, …) — the parser reads those with
// parseType (see parseBracketTypeArg) and we resolve the TypeExpr directly
// here.
//
// A bare interface name is not a type (iface.value.spelling): as a type
// argument it is rejected here, at the argument, and `*I` is the raw interface
// value of I (type.iface.value-spelling), as resolveTypeExpr builds it.
func typeArgFromExpr(c @Checker, e @ast.Expr) @types.Type {
	var t @types.Type = typeArgOrInterfaceFromExpr(c, e)
	if t != nil && t.Kind == types.TYP_INTERFACE {
		var head @ast.Expr = typeArgHead(e)
		errInterfaceNotAType(c, head.Pos, head.Name)
		return types.TypError()
	}
	return t
}

// typeArgHead returns the expression naming a type argument's type: the
// identifier or selector itself, or an instantiation's head.
func typeArgHead(e @ast.Expr) @ast.Expr {
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil {
		return typeArgHead(e.X)
	}
	return e
}

// typeArgOrInterfaceFromExpr is typeArgFromExpr, except that an interface name
// (or a generic interface's instantiation) yields its TYP_INTERFACE: the
// operand of `*`, where it names the interface value's interface.  It records
// the type as the one e names (stampExpr).
func typeArgOrInterfaceFromExpr(c @Checker, e @ast.Expr) @types.Type {
	var t @types.Type = typeArgOrInterfaceFromExprUnstamped(c, e)
	stampExpr(c, e, t)
	return t
}

// typeArgOrInterfaceFromExprUnstamped is typeArgOrInterfaceFromExpr without the
// record of e itself (the types within e are recorded).
func typeArgOrInterfaceFromExprUnstamped(c @Checker, e @ast.Expr) @types.Type {
	if e == nil { return types.TypVoid() }
	if e.Kind == ast.EXPR_TYPE {
		if e.TypeRef == nil { return types.TypVoid() }
		return resolveTypeExpr(c, e.TypeRef)
	}
	if e.Kind == ast.EXPR_IDENT {
		return resolveTypeName(c, e.Name, e.Pos)
	}
	// A bare package-qualified named type (`pkg.T`) parses as an EXPR_SELECTOR
	// (the bracketed args are Exprs, and `pkg.T` with no `@`/`*`/`[]` qualifier
	// is not routed through parseType, so it is not an EXPR_TYPE).  Resolve the
	// package member and require it to be a type — the qualified analogue of the
	// EXPR_IDENT case above.  (`pkg.T[..]` is an EXPR_INSTANTIATE_OR_INDEX, handled
	// below; only the un-instantiated qualified type reaches here.)
	if e.Kind == ast.EXPR_SELECTOR {
		var qsym @Symbol = resolveQualifiedSym(c, e)
		if qsym == nil {
			errNoMember(c, e.Pos, e.Name)
			return types.TypError()
		}
		if qsym.IsGeneric {
			// An exposed generic's marker (`fwd.Box`) is not a type, as in a type
			// expression (resolveNamedTypeExpr).
			addCheckError(c, e.Pos, "generic type used without type arguments")
			return types.TypError()
		}
		if qsym.Kind != types.SYM_TYPE && qsym.Kind != types.SYM_INTERFACE {
			errNotAType(c, e.Pos, e.Name)
			return types.TypError()
		}
		return qsym.Type
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @types.Type = typeArgOrInterfaceFromExpr(c, e.X)
		if isErrType(inner) { return types.TypError() }
		if inner != nil && inner.Kind == types.TYP_INTERFACE {
			return types.MakeInterfaceValueType(inner)
		}
		return types.MakePointerType(inner)
	}
	// A generic instantiation as a type argument (`Foo[int]`, `pkg.Foo[int]`):
	// resolve the head's generic decl and the arg types, then instantiate —
	// mirroring resolveTypeInstantiation, but from the expression form the parser
	// produces for a type argument (the head is e.X, the type args are e.Args).
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil {
		var headName @[]char
		var declPkg @[]char
		var ok bool = false
		if e.X.Kind == ast.EXPR_IDENT {
			headName = e.X.Name
			ok = true
		} else if e.X.Kind == ast.EXPR_SELECTOR && e.X.X != nil && e.X.X.Kind == ast.EXPR_IDENT {
			// Same expose home-remap as resolveTypeInstantiation, so `fwd.Gen[X]`
			// used as an explicit type ARGUMENT to a generic call reaches the
			// exposed home decl instead of resolving `undefined`.
			declPkg = resolveQualifiedGenericDeclPkg(c, e.X.X.Name, e.X.Name)
			headName = e.X.Name
			ok = true
		}
		if ok {
			var d @ast.Decl
			var isIface bool
			d, isIface = lookupGenericHead(c, declPkg, headName)
			if d == nil {
				errUndefined(c, e.Pos, headName)
				return types.TypError()
			}
			if len(e.Args) != len(d.TypeParams) {
				addCheckError(c, e.Pos, "wrong number of type arguments to generic type")
				return types.TypError()
			}
			var argTypes @[]@types.Type
			var argErr bool = false
			for i := 0; i < len(e.Args); i++ {
				var at @types.Type = typeArgFromExpr(c, e.Args[i])
				if at == nil { at = types.TypVoid() }
				if isErrType(at) { argErr = true }
				argTypes = slices.Append[@types.Type](argTypes, at)
			}
			// An instance of an argument whose error is already reported is that
			// error, so its uses report nothing more.
			if argErr { return types.TypError() }
			return instantiateGenericDeclWithArgs(c, d, isIface, argTypes, e.Pos, true)
		}
	}
	addCheckError(c, e.Pos,
			"unsupported type-argument form (use a named type, pkg.T, *T, @T, @[]T, or *[]T)")
	return types.TypError()
}
