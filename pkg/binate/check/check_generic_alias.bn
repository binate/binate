package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Generic type declarations that do not define a type of their own: a generic
// alias, and one with no underlying type, which is rejected.  An alias names a
// type; it does not define one, so an instantiation of a generic alias is its
// target with the type arguments substituted (gen.instantiate.alias): with
// `type L[T any] = Box[T]`, `L[int]` is `Box[int]` — identical to it, with its
// methods and its impls.  The instances the target names are attributed to the
// use — the outermost one, for a target that names another alias: an error in
// one is reported as instantiated there, and one in an infinite family is
// reported there.  A constraint miss keeps where its instantiation is written in
// each target (attributedVia), so two in a target are two misses at the use.
// Instantiated with its own type parameters (its declaration's
// check), the alias is its target as written, whose instances keep their
// positions there.

// instantiateGenericAlias returns the instantiation of the generic alias d with
// argTypes: d's target, resolved under d's defining package and file with each
// type parameter bound to its argument.  The copy of d it is resolved from is
// made once per argument list and kept (AliasInstantiations) for IR-gen, which
// resolves the target from it (TypeInstanceClones); the target itself is
// resolved again at each use, so the instantiation it names is made — and its
// constraints checked — as if written there.  An alias whose target reaches the
// same instantiation again with no defined type in between (AliasResolving) is
// recursive, and an error.  Its constraints are checked when constrain, from
// view.
func instantiateGenericAlias(c @Checker, d @ast.Decl, argTypes @[]@types.Type, usePos token.Pos,
		userFacing bool, constrain bool, view ImplView) @types.Type {
	var entry @GenericInstantiation = lookupAliasInstantiation(c, d, argTypes)
	if entry == nil {
		if c.Generics.InstDepth >= MAX_BUILD_NESTING {
			errBuildNestedTooDeeply(c, d.Pos)
			return types.TypError()
		}
		entry = make(GenericInstantiation)
		entry.Decl = d
		entry.TypeArgs = argTypes
		entry.Clone = ast.CloneDecl(d)
		addAliasInstantiation(c, entry)
	}
	for i := 0; i < len(c.Generics.AliasResolving); i++ {
		if same(c.Generics.AliasResolving[i], entry) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("invalid recursive type alias ")
			cb.Write(d.Name)
			addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
			return types.TypError()
		}
	}
	var at token.Pos = attributedPos(c, usePos)
	var via @[]token.Pos = attributedVia(c, usePos)
	if constrain && !constraintsCheckedIn(entry, view) {
		// As for a cached instantiation (judgeInstantiation).
		judgeInstantiation(c, entry, d, argTypes, at, via, view, namingAt(c, view))
	} else if constrain {
		noteDeclarationMisses(c, entry, view, at, via)
	}
	// The target's judgments are made in the use's view (aliasViewHere).
	var useView ImplView = implViewAt(c, usePos)
	c.Generics.AliasResolving = slices.Append[@GenericInstantiation](c.Generics.AliasResolving, entry)
	// Bound before the scope moves to the alias's: the target is as if written at
	// the use, whose lender class and view root its instances are named in
	// (bindAliasTarget).
	var savedBound instanceBinding = bindAliasTarget(c, d, argTypes)
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams); i++ {
		if !isBlank(d.TypeParams[i].Name) { defineType(c.Scope, d.TypeParams[i].Name, argTypes[i]) }
	}
	var savedUse aliasUse = enterAliasTarget(c, at, via, useView, !argsAreOwnParams(d, argTypes))
	c.Generics.InstDepth = c.Generics.InstDepth + 1
	// The errors in the target name a concrete instantiation (check_instance_naming.bn).
	var naming @InstWork
	if !typeArgsAbstract(argTypes) { naming = newInstWork(c, d.Name, argTypes, at) }
	// Held as at the use too (check_held.bn), though a naming of no instance
	// holds nothing.
	var held @heldReports = holding(c)
	pushInstanceNaming(c, naming, d)
	// Arguments abstract only through `Self` -- an interface instance's method
	// signature naming the alias -- are the use's: what the target reports at the
	// use names the instance being worked on there.
	if naming == nil && !argsMentionTypeParam(argTypes) { markNamingAtUse(c) }
	holdAs(c, held)
	var target @types.Type = resolveTypeExpr(c, entry.Clone.TypeRef)
	popInstanceNaming(c)
	c.Generics.InstDepth = c.Generics.InstDepth - 1
	leaveAliasTarget(c, savedUse)
	unbindInstance(c, savedBound)
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	c.Generics.AliasResolving = c.Generics.AliasResolving[:len(c.Generics.AliasResolving) - 1]
	if target == nil { target = types.TypError() }
	entry.Result = target
	if c.Generics.InstDepth == 0 { flushPendingChecks(c) }
	// The target is as if written at the use, its type arguments too: judge the
	// parts no walk of the type holding the use reaches (requireAliasArgsKept).
	if userFacing { requireAliasArgsKept(c, d, argTypes, at, view) }
	// And the arguments it never mentions are held to the size limit at every use
	// but a probe -- in an instance's structure, or a signature derived for one, too.
	if !c.Generics.Speculative { requireAliasArgsFit(c, d, argTypes, at) }
	return target
}

// argsMentionTypeParam reports whether args mention a type parameter, or an array
// length that depends on one -- what makes them abstract (typeArgsAbstract) other
// than `Self`.
func argsMentionTypeParam(args *[]@types.Type) bool {
	for i := 0; i < len(args); i++ {
		var v typeVisits
		if mentionsTypeWhere(args[i], isTypeParamOrDependent, &v) { return true }
	}
	return false
}

// isTypeParamOrDependent reports whether t is a type parameter or an array whose
// length depends on one.
func isTypeParamOrDependent(t @types.Type) bool {
	return t.Kind == types.TYP_TYPE_PARAM || t.Kind == types.TYP_ARRAY && t.ArrayLenDependent
}

// attributedPos returns the position an instance named at pos is attributed
// to: the use of the generic alias whose target pos is written in, if it is
// resolved in that target's scope (instantiateGenericAlias).  What the
// instances the target names are built from is resolved in their declarations'
// scopes, and keeps its positions.
func attributedPos(c @Checker, pos token.Pos) token.Pos {
	var st @InstanceState = instanceState(c)
	if st.AliasScope != nil && same(st.AliasScope, c.Scope) { return st.AliasUse }
	return pos
}

// attributedVia returns where an instance named at pos is written in the generic
// alias targets it is attributed through (attributedPos), outermost first: where
// the use it is attributed to is written in the targets around it, then pos --
// none when it is not attributed.
func attributedVia(c @Checker, pos token.Pos) @[]token.Pos {
	var st @InstanceState = instanceState(c)
	if st.AliasScope == nil || !same(st.AliasScope, c.Scope) {
		var none @[]token.Pos
		return none
	}
	return slices.Append[token.Pos](st.AliasVia, pos)
}

// An aliasUse is InstanceState's AliasScope, AliasUse, AliasVia and AliasView,
// saved.
type aliasUse struct {
	Scope @Scope
	Use   token.Pos
	Via   @[]token.Pos
	View  ImplView
}

// enterAliasTarget attributes the instances named in the current scope, a
// generic alias's target's, to at, written at via in the targets around it — or,
// when attribute is false, none — and makes view, the use's, the view of the
// judgments the target makes (aliasViewHere), until leaveAliasTarget with the
// returned state.
func enterAliasTarget(c @Checker, at token.Pos, via @[]token.Pos, view ImplView,
		attribute bool) aliasUse {
	var st @InstanceState = instanceState(c)
	var saved aliasUse
	saved.Scope = st.AliasScope
	saved.Use = st.AliasUse
	saved.Via = st.AliasVia
	saved.View = st.AliasView
	var none @Scope
	st.AliasScope = none
	if attribute { st.AliasScope = c.Scope }
	st.AliasUse = at
	st.AliasVia = via
	st.AliasView = view
	return saved
}

// leaveAliasTarget restores what enterAliasTarget changed.
func leaveAliasTarget(c @Checker, saved aliasUse) {
	var st @InstanceState = instanceState(c)
	st.AliasScope = saved.Scope
	st.AliasUse = saved.Use
	st.AliasVia = saved.Via
	st.AliasView = saved.View
}

// aliasViewHere reports whether the judgments made here are those of a generic
// alias's target resolved for a use with its type arguments bound, its
// resolution the innermost naming (aliasNamings): they are made in the use's view
// (InstanceState.AliasView).  A build nested in the target has its own.
func aliasViewHere(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	return st.Bound > 0 && aliasNamings(c) > 0
}

// lookupAliasInstantiation returns the AliasInstantiations entry of the generic
// alias d with args (matched as lookupCachedInstantiationEntry matches), or nil.
func lookupAliasInstantiation(c @Checker, d @ast.Decl, args @[]@types.Type) @GenericInstantiation {
	var entries @[]@GenericInstantiation = declAliasInstantiations(c, d)
	for i := 0; i < len(entries); i++ {
		var entry @GenericInstantiation = entries[i]
		if len(entry.TypeArgs) != len(args) { continue }
		var match bool = true
		for j := 0; j < len(args); j++ {
			if !entry.TypeArgs[j].IdenticalStrict(args[j]) { match = false }
		}
		if match { return entry }
	}
	return nil
}

// errGenericTypeNeedsDefinition reports the generic type declaration d, which
// has no underlying type (`type L[T any]`).  A use instantiates a generic type
// from its definition, which an importer of an opaque one never has, so an
// opaque type is non-generic: declare `type H` and define it as a distinct type
// over an instantiation (`type H L[int]`).
func errGenericTypeNeedsDefinition(c @Checker, d @ast.Decl) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("a generic type needs its definition: declare ")
	cb.Write(d.Name)
	cb.Write(" with its underlying type (an opaque type is non-generic)")
	addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
}
