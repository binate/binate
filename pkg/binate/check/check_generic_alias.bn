package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Generic type declarations that do not define a type of their own: a generic
// alias, and one with no underlying type, which is rejected.  An alias names a
// type; it does not define one, so an instantiation of a generic alias is its
// target with the type arguments substituted (gen.instantiate.alias): with
// `type L[T any] = Box[T]`, `L[int]` is `Box[int]` — identical to it, with its
// methods and its impls.  The instances the target names are attributed to the
// use — the outermost one, for a target that names another alias: an error in
// one is reported as instantiated there, and one in an infinite family is
// reported there.  Instantiated with its own type parameters (its declaration's
// check), the alias is its target as written, whose instances keep their
// positions there.

// instantiateGenericAlias returns the instantiation of the generic alias d with
// argTypes: d's target, resolved under d's defining package and file with each
// type parameter bound to its argument.  The copy of d it is resolved from is
// made once per argument list and kept (AliasInstantiations) for IR-gen, which
// resolves the target from it (TypeInstanceClones); the target itself is
// resolved again at each use, so the instantiation it names is made — and its
// constraints checked — as if written there.  An alias whose target reaches the
// same instantiation again with no defined type in between (AliasResolving) is
// recursive, and an error.
func instantiateGenericAlias(c @Checker, d @ast.Decl, argTypes @[]@types.Type, usePos token.Pos,
		userFacing bool) @types.Type {
	var entry @GenericInstantiation = lookupAliasInstantiation(c, d, argTypes)
	if entry == nil {
		if c.GenericInstDepth >= 128 {
			addCheckError(c, d.Pos,
					"generic instantiation nested too deeply (cyclic or unbounded type argument?)")
			return types.TypError()
		}
		entry = make(GenericInstantiation)
		entry.Decl = d
		entry.TypeArgs = argTypes
		entry.Clone = ast.CloneDecl(d)
		c.AliasInstantiations = slices.Append[@GenericInstantiation](c.AliasInstantiations, entry)
	}
	for i := 0; i < len(c.AliasResolving); i++ {
		if same(c.AliasResolving[i], entry) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("invalid recursive type alias ")
			cb.Write(d.Name)
			addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
			return types.TypError()
		}
	}
	var at token.Pos = attributedPos(c, usePos)
	var view ImplView = implViewAt(c, usePos)
	if userFacing && !constraintsCheckedIn(entry, view) {
		// As for a cached instantiation: latch only when the diagnostics reach
		// the user, not under a REPL forward-reference probe (TentativeMode).
		if !c.TentativeMode { markConstraintsChecked(entry, view) }
		checkInstantiationConstraints(c, d, argTypes, at, view, namingAt(c, view))
	}
	c.AliasResolving = slices.Append[@GenericInstantiation](c.AliasResolving, entry)
	// Bound before the scope moves to the alias's: the target is as if written at
	// the use, whose lender class its instances are named in (bindInstance).
	var savedBound instanceBinding = bindInstance(c, d, argTypes)
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams); i++ {
		if !isBlank(d.TypeParams[i].Name) { defineType(c.Scope, d.TypeParams[i].Name, argTypes[i]) }
	}
	var savedUse aliasUse = enterAliasTarget(c, at, !argsAreOwnParams(d, argTypes))
	c.GenericInstDepth = c.GenericInstDepth + 1
	var target @types.Type = resolveTypeExpr(c, entry.Clone.TypeRef)
	c.GenericInstDepth = c.GenericInstDepth - 1
	leaveAliasTarget(c, savedUse)
	unbindInstance(c, savedBound)
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	c.AliasResolving = c.AliasResolving[:len(c.AliasResolving) - 1]
	if target == nil { target = types.TypError() }
	entry.Result = target
	if c.GenericInstDepth == 0 { flushPendingChecks(c) }
	// The target is as if written at the use, its type arguments too: judge the
	// parts no walk of the type holding the use reaches (requireAliasArgsKept).
	if userFacing { requireAliasArgsKept(c, d, argTypes, at, view) }
	return target
}

// attributedPos returns the position an instance named at pos is attributed
// to: the use of the generic alias whose target pos is written in, if it is
// resolved in that target's scope (instantiateGenericAlias).  What the
// instances the target names are built from is resolved in their declarations'
// scopes, and keeps its positions.
func attributedPos(c @Checker, pos token.Pos) token.Pos {
	var st @InstanceState = instanceState(c)
	if st.AliasScope != nil && same(st.AliasScope, c.Scope) { return st.AliasUse }
	return pos
}

// An aliasUse is InstanceState's AliasScope and AliasUse, saved.
type aliasUse struct {
	Scope @Scope
	Use   token.Pos
}

// enterAliasTarget attributes the instances named in the current scope, a
// generic alias's target's, to at — or, when attribute is false, none — until
// leaveAliasTarget with the returned state.
func enterAliasTarget(c @Checker, at token.Pos, attribute bool) aliasUse {
	var st @InstanceState = instanceState(c)
	var saved aliasUse
	saved.Scope = st.AliasScope
	saved.Use = st.AliasUse
	var none @Scope
	st.AliasScope = none
	if attribute { st.AliasScope = c.Scope }
	st.AliasUse = at
	return saved
}

// leaveAliasTarget restores what enterAliasTarget changed.
func leaveAliasTarget(c @Checker, saved aliasUse) {
	var st @InstanceState = instanceState(c)
	st.AliasScope = saved.Scope
	st.AliasUse = saved.Use
}

// lookupAliasInstantiation returns the AliasInstantiations entry of the generic
// alias d with args (matched as lookupCachedInstantiationEntry matches), or nil.
func lookupAliasInstantiation(c @Checker, d @ast.Decl, args @[]@types.Type) @GenericInstantiation {
	for i := 0; i < len(c.AliasInstantiations); i++ {
		var entry @GenericInstantiation = c.AliasInstantiations[i]
		if !same(entry.Decl, d) || len(entry.TypeArgs) != len(args) { continue }
		var match bool = true
		for j := 0; j < len(args); j++ {
			if !entry.TypeArgs[j].IdenticalStrict(args[j]) { match = false }
		}
		if match { return entry }
	}
	return nil
}

// errGenericTypeNeedsDefinition reports the generic type declaration d, which
// has no underlying type (`type L[T any]`).  A use instantiates a generic type
// from its definition, which an importer of an opaque one never has, so an
// opaque type is non-generic: declare `type H` and define it as a distinct type
// over an instantiation (`type H L[int]`).
func errGenericTypeNeedsDefinition(c @Checker, d @ast.Decl) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("a generic type needs its definition: declare ")
	cb.Write(d.Name)
	cb.Write(" with its underlying type (an opaque type is non-generic)")
	addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
}
