package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for check_generic_alias.bn: generic aliases and generic declarations
// with no underlying type.

// A generic alias instance is its target: assignable both ways, through a
// pointer, with the target's methods, whether the target is another generic's
// instance (its parameters fixed or reordered), a managed slice or another alias.
func TestGenericAliasIsItsTarget() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Box[T any] struct { v T }\n"
							"func (b *Box[T]) Get() T { return b.v }\n"
							"type Pair[A any, B any] struct { a A; b B }\n"
							"type L[T any] = Box[T]\n"
							"type LL[T any] = L[T]\n"
							"type IP[B any] = Pair[int, B]\n"
							"type Flip[A any, B any] = Pair[B, A]\n"
							"type Sl[T any] = @[]T\n"
							"func f() int {\n"
							"  var x L[int] = Box[int]{v: 1}; var y Box[int] = x; var p *LL[int] = &y\n"
							"  var ip IP[bool] = Pair[int, bool]{a: 2}; var fl Flip[int, bool] = Pair[bool, int]{b: 3}\n"
							"  var s Sl[int] = make_slice(int, 1); var t @[]int = s\n"
							"  return p.Get() + ip.a + fl.b + len(t)\n"
							"}\n"))
}

// An alias that reaches itself with no defined type in between is an invalid
// recursive alias; a defined generic type may refer to itself through one.
func TestGenericAliasRecursion() testing.TestResult {
	var bad @[]@[]char = @[]@[]char{
			"package \"test\"\ntype R[T any] = @[]R[T]\nvar r R[int]\n",
			"package \"test\"\ntype A[T any] = B[T]\ntype B[T any] = A[T]\nvar a A[int]\n",
			"package \"test\"\ntype S[T any] = struct { n @S[T] }\nvar s S[int]\n"}
	for i := 0; i < len(bad); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(bad[i]), "invalid recursive type alias")
		if len(r) > 0 { return r }
	}
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Node[T any] struct { v T; next @NodeRef[T] }\n"
							"type NodeRef[T any] = Node[T]\n"
							"func f() int {\n"
							"  var n @Node[int] = make(NodeRef[int]); n.next = make(Node[int]); return n.v\n"
							"}\n"))
}

// A generic alias is no method or impl receiver.
func TestGenericAliasReceiverRejected() testing.TestResult {
	var bad @[]@[]char = @[]@[]char{
			"package \"test\"\ntype Box[T any] struct { v T }\ntype L[T any] = Box[T]\n"
					"func (l *L[T]) Get() T { return l.v }\n",
			"package \"test\"\ntype Box[T any] struct { v T }\ntype L[T any] = Box[T]\n"
					"interface E {}\nimpl *L[T] : E\n"}
	for i := 0; i < len(bad); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(bad[i]), "receiver may not be a generic alias")
		if len(r) > 0 { return r }
	}
	return ""
}

// A generic type declaration with no underlying type is rejected, alone or in a
// group.
func TestGenericTypeNeedsDefinition() testing.TestResult {
	var bad @[]@[]char = @[]@[]char{
			"package \"test\"\ntype L[T any]\n", "package \"test\"\ntype (\n  M[T any]\n)\n"}
	for i := 0; i < len(bad); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(bad[i]), "a generic type needs its definition")
		if len(r) > 0 { return r }
	}
	return ""
}

// The instances a generic alias's target names are attributed to the alias's
// use: an error in one's method is reported as instantiated there, and an
// instance in an infinite family is reported there, not in the target.
func TestGenericAliasInstancesAtUse() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Box[T any] struct { v T }\n"
					"func (b *Box[T]) S() int { var a [sizeof(T) - 2]uint8; return len(a) }\n"
					"type A[T any] = Box[T]\n"
					"var b A[int8]\n")
	if errorsContaining(c, "(in Box[int8].S, instantiated at test.bn:5:8)") != 1 {
		return fail("Box[int8]'s error is not reported as instantiated at the alias's use")
	}
	c = checkSrc(
			"package \"test\"\n"
					"type L[T any] struct { v T }\n"
					"func (l *L[T]) Wrap() L[[1]T] { var r L[[1]T]; return r }\n"
					"type A[T any] = L[T]\n"
					"var b A[int]\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 || errs[0].Pos.Line != 5 || errs[0].Pos.Col != 8 ||
			!msgContains(errs[0].Msg, "names infinitely many instantiations") {
		return fail("L[int] is not reported at the alias's use")
	}
	return ""
}

// Checked with its own type parameters, a generic alias's declaration is its
// target as written: an error in an instance there stays where that instance is
// written, each at its own position.
func TestGenericAliasDeclErrorsStayInTarget() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Eq { Same() bool }\n"
					"type B1[T Eq] struct { v T }\n"
					"type B2[T Eq] struct { v T }\n"
					"type P[T any] = struct { a B1[T]; b B2[T] }\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 2 || errs[0].Pos.Line != 5 || errs[1].Pos.Line != 5 ||
			errs[0].Pos.Col + errs[1].Pos.Col != 30 + 39 || errs[0].Pos.Col == errs[1].Pos.Col {
		return fail("expected B1[T] and B2[T] rejected where P's target writes them")
	}
	return ""
}
