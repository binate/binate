package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// Method back-fill for generic-type instantiations, split out of
// check_generic_type.bn for file-length hygiene.  A generic type instantiated
// (as a var/field/param/receiver type) DURING pass-1 collection is cached before
// some — or all — of its method decls are attached to its placeholder, so the
// cached instantiation can be method-less or only partially populated.
// backfillInstantiationMethods re-syncs every such instantiation at the end of
// collectDecls, once all generic-receiver methods are recorded; copyPlaceholderMethods
// resolves the methods for one instantiation (and is also the populate-time path,
// from populateInstantiatedStruct).

// GenericMethodEntry records a method declared on a generic type (Decl), with
// the package that declares it (Pkg) and the scope its signature resolves in
// (Scope: its file's imports and its package's declarations).  Checked and
// BodyErrs are as for GenericHome.
type GenericMethodEntry struct {
	Decl     @ast.Decl
	Pkg      @[]char
	Scope    @Scope
	Checked  bool
	BodyErrs bool
}

// recordGenericMethod records the generic-receiver method declaration d, in the
// current package and scope; a later declaration of the same method (the REPL
// redefining it) replaces the earlier one.  The list is replaced, not changed
// in place, so a REPL declaration's rollback snapshot keeps the earlier one.
func recordGenericMethod(c @Checker, d @ast.Decl) {
	var entry @GenericMethodEntry = make(GenericMethodEntry)
	entry.Decl = d
	entry.Pkg = buf.CopyStr(c.curPkgPath)
	entry.Scope = c.Scope
	var base @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
	for i := 0; i < len(c.GenericMethods); i++ {
		var old @GenericMethodEntry = c.GenericMethods[i]
		var oldBase @ast.TypeExpr = receiverBaseInstantiation(old.Decl.Recv.Type)
		if types.CharEq(old.Pkg, entry.Pkg) && types.CharEq(old.Decl.Name, d.Name) && base != nil &&
				oldBase != nil && types.CharEq(oldBase.Base.Name, base.Base.Name) {
			c.GenericMethods = replaceGenericMethod(c.GenericMethods, i, entry)
			return
		}
	}
	c.GenericMethods = slices.Append[@GenericMethodEntry](c.GenericMethods, entry)
}

// replaceGenericMethod returns a copy of methods with entry at index i.
func replaceGenericMethod(methods *[]@GenericMethodEntry, i int,
		entry @GenericMethodEntry) @[]@GenericMethodEntry {
	var out @[]@GenericMethodEntry = make_slice(@GenericMethodEntry, len(methods))
	for k := 0; k < len(methods); k++ {
		out[k] = methods[k]
	}
	out[i] = entry
	return out
}

// copyPlaceholderMethods attaches the generic type `d`'s methods onto an
// instantiation `named`, each resolved from its declaration with the
// instantiation's arguments (so a length that depends on a type parameter gets
// the instantiation's value).  It back-fills only the methods MISSING from
// `named`, so it is idempotent and safe to call both when an instantiation is
// first populated and again from the post-collection back-fill.  The re-sync
// matters because an instantiation forced by a top-level
// var/field/param/receiver type is cached DURING pass-1 collection, possibly
// before some of its method decls are recorded: a method decl BEFORE the
// forcing site is copied at populate time, one AFTER is added later — so `named`
// can be PARTIALLY populated, which is why the guard is "copy the missing ones",
// NOT "skip if any are present".  Without this a `.Method()` on such an
// instantiation would be spuriously rejected as undefined.
//
// Each signature resolves under a fresh scope over the method's own recorded
// scope (its file's imports + its package's types) with only the method's
// RECEIVER BINDERS bound — the names in scope in the method.  The binders may
// rename the type's params (`func (p @Pair[A, B]) First() A` on `type Pair[K,
// V]`), and the type's own param names are NOT in scope: `func (b *Box[U]) Get()
// K` on `type Box[K any]` names the package type K, not the type argument.  So
// the signature must not resolve under the populate scope, which binds the
// type's param names.  The checker requires one plain binder per type
// parameter, so the binders cover every position.
func copyPlaceholderMethods(c @Checker, d @ast.Decl, args @[]@types.Type, named @types.Type) {
	if named == nil || named.Kind != types.TYP_NAMED {
		return
	}
	var definingPkg @[]char = genericTypeDeclPkg(c, d)
	for i := 0; i < len(c.GenericMethods); i++ {
		var entry @GenericMethodEntry = c.GenericMethods[i]
		if !types.CharEq(entry.Pkg, definingPkg) {
			continue
		}
		var mdecl @ast.Decl = entry.Decl
		var inst @ast.TypeExpr = receiverBaseInstantiation(mdecl.Recv.Type)
		if inst == nil || inst.Base == nil || !types.CharEq(inst.Base.Name, d.Name) {
			continue
		}
		if named.LookupMethod(mdecl.Name) != nil {
			continue
		}
		// Resolve under the defining package too, so the unqualified generic head
		// of the receiver (`*Box[U]`) binds to the defining package's decl, as in
		// populateInstantiatedStruct.
		var savedScope @Scope = c.Scope
		var savedPkgPath @[]char = c.curPkgPath
		c.curPkgPath = definingPkg
		c.Scope = NewScope(entry.Scope)
		for j := 0; j < len(inst.TypeArgs) && j < len(args); j++ {
			var binder @ast.TypeExpr = inst.TypeArgs[j]
			if binder != nil && binder.Kind == ast.TEXPR_NAMED {
				defineType(c.Scope, ast.ReceiverBinderName(binder, j), args[j])
			}
		}
		// Resolve a copy of the signature: resolution under this instantiation's
		// type arguments records on the AST (a length depending on a binder), which
		// must not be stamped on the method declaration every instantiation shares.
		var msig @ast.Decl = ast.CloneFuncSignature(mdecl)
		var savedDeriving bool = c.DerivingInstanceSig
		c.DerivingInstanceSig = true
		var recvType @types.Type = resolveTypeExpr(c, ast.WithNamedBlankBinders(msig.Recv.Type))
		var ft @types.Type = resolveFuncDeclType(c, msig)
		c.DerivingInstanceSig = savedDeriving
		c.Scope = savedScope
		c.curPkgPath = savedPkgPath
		var combined @[]@types.Param = prependRecvParam(mdecl.Recv.Name, recvType, ft.Params)
		var methodFuncType @types.Type = types.MakeFuncType(combined, ft.Results)
		named.AddMethod(MakeMethod(mdecl.Name, recvType, methodFuncType))
	}
}

// backfillInstantiationMethods re-syncs every generic-struct instantiation that
// was cached method-less because it was forced (by a var/field/param/receiver
// type) before the generic type's method decls were collected.  Run once at the
// end of collectDecls, when every generic-receiver method is attached to its
// placeholder.  This closes the population-ordering hazard for both concrete
// instantiations (`Box[int]` used as a global-var/field/param type before the
// method decl) and the abstract self-shell (`Box[T]` built during the first
// method's receiver resolution, before any method is on the placeholder — which
// is what lets a method body call a sibling method or itself).  At the REPL the
// instances the copied signatures derive are not queued for checking
// (backfillQueueSkipped).
func backfillInstantiationMethods(c @Checker) {
	var st @InstanceState = instanceState(c)
	var saved bool = st.Backfilling
	st.Backfilling = true
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry == nil {
			continue
		}
		copyPlaceholderMethods(c, entry.Decl, entry.TypeArgs, entry.Result)
	}
	st.Backfilling = saved
}

// GenericInstantiation caches one resolved `Name[T1, T2, ...]`
// type-instantiation against its source AST decl + type-arg list,
// so subsequent references hit a stable @types.Type instance.
type GenericInstantiation struct {
	Decl     @ast.Decl
	TypeArgs @[]@types.Type
	Result   @types.Type
	// ConstraintsChecked records whether this (decl, args) has had its
	// type-parameter constraints checked-and-reported at a USER-FACING
	// instantiation site.  Constraint diagnostics are a property of what the
	// user wrote, so they fire once, at the first user-facing encounter — not
	// during an internal SPECULATIVE re-instantiation (substituteTypeParams
	// walking an impl-match probe), which only needs the type's identity.  A
	// speculative instantiation may populate the cache first with this false;
	// the first later user-facing use then does the check (see
	// instantiateGenericDeclWithArgs).
	ConstraintsChecked bool
	// InstState is the check of a concrete struct instance's method bodies and
	// parameterized impls (gen.mono.check); nil for an interface or an
	// instantiation whose arguments name type parameters.
	InstState @InstCheckState
	// Clone is the copy of Decl this instantiation's members were resolved
	// from with its type arguments bound (InstanceBody), nil until populated.
	Clone @ast.Decl
}

// dropInstanceMethod removes method name from every instantiation of the
// generic type baseName declared in pkg, so backfillInstantiationMethods derives
// it again from the generic-receiver method recorded then — or leaves it out,
// when none is.
func dropInstanceMethod(c @Checker, pkg *[]readonly char, baseName *[]readonly char,
		name *[]readonly char) {
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry == nil || entry.Result == nil || entry.Result.Kind != types.TYP_NAMED ||
				!types.CharEq(entry.Decl.Name, baseName) ||
				!types.CharEq(genericTypeDeclPkg(c, entry.Decl), pkg) {
			continue
		}
		removeMethodNamed(entry.Result, name)
	}
}

// removeMethodNamed removes method name from named type t's method set.
func removeMethodNamed(t @types.Type, name *[]readonly char) {
	var kept @[]@types.Method
	for i := 0; i < len(t.Methods); i++ {
		if !types.CharEq(t.Methods[i].Name, name) {
			kept = slices.Append[@types.Method](kept, t.Methods[i])
		}
	}
	t.Methods = kept
}
