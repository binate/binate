package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the method-population back-fill (check_generic_backfill.bn): a
// generic instantiation forced by a var/field/param/receiver type before (some
// of) its methods are collected must still expose the full method set after
// collection.  Shared helpers (checkSrc / expectNoErrors) live in types_test.bn.

// An instantiation used as a global-var type BEFORE its method decl is collected
// still resolves the method: the post-collection back-fill re-syncs the
// method-less-cached instantiation (the population-ordering hazard — without the
// back-fill `g.Get()` is spuriously `undefined`).
func TestCheckGenericInstMethodOrderingBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func use() int {\n"
			"g.v = 1\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic type's method body may call a SIBLING method on its receiver: the
// abstract self-shell `Box[T]` exposes the type's own method set (after the
// back-fill), so `b.Get()` inside another method resolves.
func TestCheckGenericTypeMethodSiblingCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func (b *Box[T]) Twice() T { return b.Get() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// An instantiation forced (as a var type) BETWEEN two method decls is cached
// partially populated — only the earlier method (Get).  The back-fill must add
// the later one (Set) too, or `g.Set(...)` is spuriously `undefined`.  Exercises
// copyPlaceholderMethods's back-fill-missing (not skip-if-any) behavior.
func TestCheckGenericInstMethodInterleavedBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Set(x T) { b.v = x }\n"
			"func use() int {\n"
			"g.Set(3)\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// replInstMethodParams returns the parameter count (receiver included) of method
// name on the type of session variable v, or -1 when the type has no such method.
func replInstMethodParams(c @Checker, v *[]readonly char, name *[]readonly char) int {
	var m @types.Method = c.Scope.Lookup(v).Type.LookupMethod(name)
	if m == nil { return -1 }
	return len(m.FuncType.Params)
}

// A generic method redefined at the prompt is re-derived on the instances made
// before it: an existing instance takes the new signature, not the old one.
func TestReplGenericMethodRedefinitionReachesInstances() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "func (c *Cur[T]) Get() T { return c.v }")
	replCheckDecl(c, "var cc Cur[int]")
	if replInstMethodParams(c, "cc", "Get") != 1 { return fail("Get must be on Cur[int]") }
	replCheckDecl(c, "func (c *Cur[T]) Get(k int) int { return k }")
	if len(c.CheckerErrors()) != 0 { return fail("the redefinition must check") }
	if replInstMethodParams(c, "cc", "Get") != 2 {
		return fail("Cur[int] must take the redefined Get")
	}
	replCheckStmts(c, "_ = cc.Get()")
	if len(c.CheckerErrors()) == 0 { return fail("a call of the old shape must be rejected") }
	return ""
}

// A generic method that parks, or fails to check and is undone, is not left on
// the instances made before it; one it redefined is back on them.
func TestReplUndoneGenericMethodLeavesInstances() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "var bx Box[int]")
	replCheckDecl(c, "func (b *Box[T]) Get() T { zz(); return b.v }")
	if !c.IsPendingDecl("Box.Get") { return fail("Get must park") }
	if replInstMethodParams(c, "bx", "Get") != -1 {
		return fail("a parked Get must not be on Box[int]")
	}
	replCheckDeclUndo(c, "func (b *Box[T]) Put(x T) { b.v = x + true }")
	if len(c.CheckerErrors()) == 0 { return fail("Put must fail to check") }
	if replInstMethodParams(c, "bx", "Put") != -1 {
		return fail("an undone Put must not be on Box[int]")
	}
	replCheckDecl(c, "func (b *Box[T]) Set(x T) { b.v = x }")
	var before int = len(c.CheckerErrors())
	replCheckDeclUndo(c, "func (b *Box[T]) Set() { b.v = 1 + true }")
	if len(c.CheckerErrors()) == before { return fail("the Set redefinition must fail to check") }
	if replInstMethodParams(c, "bx", "Set") != 2 {
		return fail("the earlier Set must be back on Box[int]")
	}
	return ""
}
