package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// A generic type's bare name is not a type: an instantiation always writes its type
// arguments (gen.instantiate).  Every position a type is named rejects it with that
// message, rather than accepting it (a declaration, a pointer, an alias) or calling it
// opaque (a by-value use).  (checkSrc is in types_test.bn, expectErrSub in
// check_builtin_test.bn.)

// bareGenericSrc is a package declaring `type Box[T any]` and then body.
func bareGenericSrc(body *[]readonly char) @[]readonly char {
	return buf.Concat("package \"test\"\ntype Box[T any] struct { v T }\n", body)
}

func TestCheckBareGenericTypeRejected() testing.TestResult {
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 9)
	bodies[0] = "type X Box\n"
	bodies[1] = "type A [2]Box\n"
	bodies[2] = "type S struct { b Box }\n"
	bodies[3] = "func f(b Box) {}\n"
	bodies[4] = "type P *Box\n"
	bodies[5] = "type M @Box\n"
	bodies[6] = "type Q = Box\n"
	bodies[7] = "func g() { var c = Box{v: 1}; _ = c }\n"
	bodies[8] = "func h() { _ = cast(*Box, nil) }\n"
	for i := 0; i < len(bodies); i++ {
		var c @Checker = checkSrc(bareGenericSrc(bodies[i]))
		var r testing.TestResult = expectErrSub(c, "generic type used without type arguments")
		if len(r) != 0 { return buf.Concat(bodies[i], r) }
	}
	return ""
}

// Its instantiations, a self-reference through one, and a type parameter are types.
func TestCheckGenericInstantiationsAccepted() testing.TestResult {
	var src @[]readonly char = bareGenericSrc(
			"type N[T any] struct { next *N[T] }\n"
					"func g() { var b Box[int]; _ = b; var p *Box[int]; _ = p }\n"
					"func k[Box any](x Box) Box { return x }\n")
	return expectNoErrors(checkSrc(src))
}

// A type parameter named like a generic type of the package, bound to an argument with
// no underlying yet -- an instantiation in progress, a type collected later -- is that
// argument, not the generic's bare name.
func TestCheckTypeParamNamedLikeGeneric() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 3)
	srcs[0] =
		"package \"test\"\ntype Node[T any] struct { v T }\ntype Ref[Node any] struct { p @Node }\n"
				"type Tree[T any] struct { v T; up Ref[Tree[T]] }\nfunc f() { var t Tree[int]; _ = t }\n"
	srcs[1] =
		"package \"test\"\ntype Node[T any] struct { v T }\ntype Ref[Node any] struct { p @Node }\n"
				"type A struct { r Ref[B] }\ntype B struct { x int }\n"
	srcs[2] =
		"package \"test\"\ntype Node[T any] struct { v T }\ntype Ref[Node any] struct { p @Node }\n"
				"type RA[Node any] = Ref[Node]\ntype A struct { r RA[B] }\ntype B struct { x int }\n"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(srcs[i]))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A method or an impl on a generic's bare name gets that one error, not another for
// its receiver.
func TestCheckBareGenericReceiverOneError() testing.TestResult {
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bodies[0] = "func (b *Box) M() {}\n"
	bodies[1] = "interface Getter { Get() int }\nimpl *Box : Getter\n"
	for i := 0; i < len(bodies); i++ {
		var c @Checker = checkSrc(bareGenericSrc(bodies[i]))
		var r testing.TestResult = expectErrSub(c, "generic type used without type arguments")
		if len(r) != 0 { return buf.Concat(bodies[i], r) }
		if len(c.CheckerErrors()) != 1 { return buf.Concat(bodies[i], ": more than one error") }
	}
	return ""
}

// genericFuncSrc is a package declaring `func gen[T any](x T) T` and then body.
func genericFuncSrc(body *[]readonly char) @[]readonly char {
	return buf.Concat("package \"test\"\nfunc gen[T any](x T) T { return x }\n", body)
}

// A generic function's bare name is no value either: its value is an instance's
// (gen.instantiate).  Each read of it is that one error — not an internal error in
// IR-gen (an inferred-type variable, `_ =`), nor a mismatch with the type its type
// parameters spell (`cannot assign func(T)T to @func(int)int`), nor an error in a use
// of what it was read into.
func TestCheckBareGenericFuncValueRejected() testing.TestResult {
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bodies[0] = "func f() { var g = gen; _ = g }\n"
	bodies[1] = "var g = gen\n"
	bodies[2] = "func f() { g := gen; _ = g }\n"
	bodies[3] = "func f() { _ = gen }\n"
	bodies[4] = "func f() { var g @func(int) int = gen; _ = g }\n"
	bodies[5] = "func take(h @func(int) int) {}\nfunc f() { take(gen) }\n"
	bodies[6] = "func f() int { var g = gen; return g(4) }\n"
	for i := 0; i < len(bodies); i++ {
		var c @Checker = checkSrc(genericFuncSrc(bodies[i]))
		if len(c.CheckerErrors()) != 1 ||
				errorsContaining(c, "generic function `gen` used without type arguments") != 1 {
			return buf.Concat(bodies[i], "expected exactly the generic-function error")
		}
	}
	return ""
}

// So is a generic function of another package, named qualified.
func TestCheckBareQualifiedGenericFuncValueRejected() testing.TestResult {
	var c @Checker = checkUserOfLib("func Id[T any](x T) T { return x }\n",
			"func F() int {\n\tvar g = lib.Id\n\t_ = g\n\treturn 0\n}\n")
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "generic function `Id` used without type arguments") != 1 {
		return "expected exactly the generic-function error"
	}
	return ""
}

// A call of it without type arguments is the call's one error, named plainly or
// qualified.
func TestCheckGenericFuncCallWithoutTypeArgs() testing.TestResult {
	var c @Checker = checkSrc(genericFuncSrc("func f() int { return gen(5) }\n"))
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "generic function requires type arguments") != 1 {
		return "gen(5): expected exactly the call's error"
	}
	c = checkUserOfLib("func Id[T any](x T) T { return x }\n",
			"func F() int {\n\treturn lib.Id(3)\n}\n")
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "generic function requires type arguments") != 1 {
		return "lib.Id(3): expected exactly the call's error"
	}
	return ""
}

// Its address is a function's: none, reported as for a function.
func TestCheckGenericFuncAddrIsFuncs() testing.TestResult {
	var c @Checker = checkSrc(genericFuncSrc("func f() { var p = &gen; _ = p }\n"))
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cannot take the address of function `gen`") != 1 {
		return "expected exactly the function-address error"
	}
	return ""
}

// Its instances are values, called or not, and a local named like it is the local.
func TestCheckGenericFuncInstanceIsValue() testing.TestResult {
	var body *[]readonly char =
		"func f() int { var g @func(int) int = gen[int]; return g(1) + gen[int](2) }\n"
				"func h(gen int) int { return gen }\n"
				"func k() int { var gen = func(x int) int { return x }; return gen(3) }\n"
	return expectNoErrors(checkSrc(genericFuncSrc(body)))
}
