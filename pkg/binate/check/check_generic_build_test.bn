package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_generic_build.bn: an abstract instance of an infinite family
// built while another instance is waits for its methods until code uses it, and
// the budget of instances one instantiation builds.
// boxFamily is shared from check_generic_expand_test.bn.

// A generic in an infinite family that the program never instantiates names no
// instance: it is accepted, and so is code using its abstract instances' methods.
func TestExpandFamilyUninstantiatedOk() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					buf.Concat(boxFamily,
							"func (b *Box[V]) Twice() Box[Opt[Opt[V]]] {\n\tvar r Box[Opt[V]] = b.Wrap()\n"
									"\treturn r.Wrap()\n}\n")))
}

// An abstract instance of the family that waits for its methods gets them when
// code uses it, so a misuse in the generic's own body is still reported.
func TestExpandFamilyAbstractMisuseRejected() testing.TestResult {
	return errsIn(
			checkSrc(
					buf.Concat(boxFamily,
							"func (b *Box[V]) Bad() int {\n\tvar r Box[Opt[V]] = b.Wrap()\n\treturn r.Wrap()\n}\n")),
			"cannot assign Box[Opt[Opt[V]]] to int")
}

// A family that grows through array-length arithmetic, which the expansion check
// does not decide, and branches, is stopped where it is built: N[int]'s build
// goes past MAX_INSTANCES_PER_BUILD.
func TestExpandBuildBudget() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type N[T any] struct { x T; a *N[[sizeof(T) + 1]uint8]; b *N[[sizeof(T) + 1]uint16] }\n"
					"func f() {\n\tvar n N[int]\n\t_ = n\n}\n")
	if !anyErrContains(c, "generic instantiation N[int] builds more than 4096 instances") {
		return fail("expected N[int]'s build stopped")
	}
	return ""
}

// structChainSrc returns a package declaring S1[T] … Sn[T], each with a pointer
// to the next, and f, whose body is body.
func structChainSrc(n int, body *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	for i := 1; i <= n; i++ {
		b.Write("type S")
		b.Write(strconv.Itoa(i))
		b.Write("[T any] struct { v T")
		if i < n {
			b.Write("; next *S")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T]")
		}
		b.Write(" }\n")
	}
	b.Write("func f() {\n")
	b.Write(body)
	b.Write("}\n")
	return b.String()
}

// A chain of 100 distinct generics, each naming the next: each generic's own
// declaration builds the rest of the chain over its own parameter, against a
// budget of its own, so no build goes past MAX_INSTANCES_PER_BUILD — whether or
// not the program names an instance (S1[int] names 99 more along a 100-long
// chain).
func TestBuildBudgetChainOfGenerics() testing.TestResult {
	if len(checkSrc(structChainSrc(100, "")).CheckerErrors()) != 0 {
		return fail("expected the chain accepted with no instance named")
	}
	if len(checkSrc(structChainSrc(100, "\tvar a S1[int]\n\t_ = a\n")).CheckerErrors()) != 0 {
		return fail("expected the chain accepted with S1[int] named")
	}
	return ""
}

// A method looked up through a type parameter's constraint finds an inherited
// method of the constraint's ancestor, whose abstract instance waited for its
// methods.
func TestExpandInheritedMethodThroughConstraint() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\n"
							"interface Base[T any] { Val() int; Up() @Base[Opt[T]] }\n"
							"interface I[T any] : Base[T] {}\n"
							"func F[V any, X I[V]](x X) int { return x.Val() }\n"))
}
