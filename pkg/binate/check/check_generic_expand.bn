package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Generic families that grow without end (spec gen.mono.instances).  The
// instantiations a program names must be finite; a generic whose declaration
// names instances of a generic with type arguments that grow each time around —
// `type L[T any] struct { next *L[[1]T] }`, `func (b *Box[V]) Wrap() Box[Opt[V]]`
// — names infinitely many from any instance, so naming one with concrete type
// arguments is an error, and a generic struct whose fields alone do so is
// rejected at its declaration.  Building an instance instantiates what its fields
// and its methods' and interfaces' signatures name, so the family is found before
// any of it is built: from the declarations' text, as a graph over the generics'
// type parameters.  An edge goes from a parameter of the declaring generic to a
// parameter of a generic it writes an instance of, whose argument at that
// position mentions the first — growing when the parameter is nested inside a
// type constructor there, not the argument itself.  A parameter on a cycle that
// grows belongs to an infinite family (expanding).  Bodies and impls need no
// such check: an instance's body is checked through the drain, whose chains stop
// at MAX_INSTANCE_DEPTH, depth-first, at the first that grows too deep.

// An expandEdge goes from the node From to the node To; Grows when the
// parameter is nested inside a type constructor in the argument, Field when the
// edge is written in what is built with an instance — a generic's structure (its
// fields, its underlying type, an alias's target) or an interface's parents —
// rather than a method's signature.
type expandEdge struct {
	From  int
	To    int
	Grows bool
	Field bool
}

// An expandGraph is the expansion graph over Decls, the generic declarations
// reachable from the one it was built for; Base[i] is the node of Decls[i]'s
// first type parameter, N the number of nodes.
type expandGraph struct {
	Decls @[]@ast.Decl
	Base  @[]int
	N     int
	Edges @[]expandEdge
}

// An expandVerdict records whether a parameter of the generic Decl lies on a
// cycle that grows (Expanding), and on one of structure edges alone — a generic
// struct's fields, an interface's parents (FieldsExpanding).
type expandVerdict struct {
	Decl            @ast.Decl
	Expanding       bool
	FieldsExpanding bool
}

// genericExpanding reports whether the generic declaration d belongs to an
// infinite family (expandVerdictOf).
func genericExpanding(c @Checker, d @ast.Decl) bool {
	return expandVerdictOf(c, d).Expanding
}

// genericFieldsExpanding reports whether the generic declaration d's
// structure alone belongs to an infinite family (expandVerdictOf).
func genericFieldsExpanding(c @Checker, d @ast.Decl) bool {
	return expandVerdictOf(c, d).FieldsExpanding
}

// expandVerdictOf returns d's verdict, building the graph of the generics
// reachable from d once and recording the verdict of each (InstanceState.Expand)
// until a generic declaration or method is added, replaced or undone
// (Checker.GenericGen) — a generic may be instantiated while its own methods are
// still being collected, and redefined at the REPL.
func expandVerdictOf(c @Checker, d @ast.Decl) expandVerdict {
	var st @InstanceState = instanceState(c)
	if st.ExpandGen != c.GenericGen {
		var none @[]expandVerdict
		st.Expand = none
		st.ExpandGen = c.GenericGen
	}
	for i := 0; i < len(st.Expand); i++ {
		if same(st.Expand[i].Decl, d) { return st.Expand[i] }
	}
	var g expandGraph
	expandAddDecl(&g, d)
	for i := 0; i < len(g.Decls); i++ {
		expandWalkDecl(c, &g, i)
	}
	var all @[]bool = expandCycleNodes(&g, false)
	var fields @[]bool = expandCycleNodes(&g, true)
	var mine expandVerdict
	for i := 0; i < len(g.Decls); i++ {
		var v expandVerdict
		v.Decl = g.Decls[i]
		for k := 0; k < len(g.Decls[i].TypeParams); k++ {
			if all[g.Base[i] + k] { v.Expanding = true }
			if fields[g.Base[i] + k] { v.FieldsExpanding = true }
		}
		if i == 0 { mine = v }
		st.Expand = slices.Append[expandVerdict](st.Expand, v)
	}
	return mine
}

// bumpGenericGen records a change to the generic declarations or methods
// (Checker.GenericGen).
func bumpGenericGen(c @Checker) {
	c.GenericGen = c.GenericGen + 1
}

// expandAddDecl returns d's index among g's declarations, adding it with a node
// for each of its type parameters when it is new.
func expandAddDecl(g *expandGraph, d @ast.Decl) int {
	for i := 0; i < len(g.Decls); i++ {
		if same(g.Decls[i], d) { return i }
	}
	g.Decls = slices.Append[@ast.Decl](g.Decls, d)
	g.Base = slices.Append[int](g.Base, g.N)
	g.N = g.N + len(d.TypeParams)
	return len(g.Decls) - 1
}

// An expandSite is where a part of g.Decls[Index] is written: the names of its
// type parameters there (a method's receiver binders), whether its edges are
// structure edges, and the scope and package its names resolve in.
type expandSite struct {
	Index  int
	Params @[]@[]char
	Field  bool
	Scope  @Scope
	Pkg    @[]char
}

// expandWalkDecl adds the edges g.Decls[i] writes: a generic interface's method
// signatures and parents, a generic alias's target, and a generic type's
// underlying type and its methods' signatures.
func expandWalkDecl(c @Checker, g *expandGraph, i int) {
	var d @ast.Decl = g.Decls[i]
	var s expandSite
	s.Index = i
	s.Params = expandParamNames(d)
	s.Scope = lookupGenericDeclScope(c, d)
	if d.Kind == ast.DECL_INTERFACE {
		s.Pkg = genericIfaceDeclPkg(c, d)
		for k := 0; k < len(d.Decls); k++ {
			expandWalkSignature(c, g, &s, d.Decls[k])
		}
		// Its parents are built with the instance, as a type's structure is.
		s.Field = true
		for k := 0; k < len(d.Interfaces); k++ {
			expandWalkType(c, g, &s, d.Interfaces[k])
		}
		return
	}
	s.Pkg = genericTypeDeclPkg(c, d)
	s.Field = true
	expandWalkType(c, g, &s, d.TypeRef)
	if d.IsAlias { return }
	for k := 0; k < len(c.GenericMethods); k++ {
		var entry @GenericMethodEntry = c.GenericMethods[k]
		var inst @ast.TypeExpr = receiverBaseInstantiation(entry.Decl.Recv.Type)
		if inst == nil || inst.Base == nil || !types.CharEq(inst.Base.Name, d.Name) ||
				!same(lookupMethodGenericDecl(c, entry), d) {
			continue
		}
		var m expandSite
		m.Index = i
		m.Scope = entry.Scope
		m.Pkg = entry.Pkg
		for j := 0; j < len(inst.TypeArgs); j++ {
			m.Params = slices.Append[@[]char](m.Params, ast.ReceiverBinderName(inst.TypeArgs[j], j))
		}
		expandWalkSignature(c, g, &m, entry.Decl)
	}
}

// expandParamNames returns the names of d's type parameters.
func expandParamNames(d @ast.Decl) @[]@[]char {
	var names @[]@[]char
	for k := 0; k < len(d.TypeParams); k++ {
		names = slices.Append[@[]char](names, d.TypeParams[k].Name)
	}
	return names
}

// expandWalkSignature adds the edges the function declaration f's parameters
// and results write, at s.
func expandWalkSignature(c @Checker, g *expandGraph, s *expandSite, f @ast.Decl) {
	if f == nil || f.Kind != ast.DECL_FUNC { return }
	for k := 0; k < len(f.Params); k++ {
		if f.Params[k] != nil { expandWalkType(c, g, s, f.Params[k].Type) }
	}
	for k := 0; k < len(f.Results); k++ {
		expandWalkType(c, g, s, f.Results[k])
	}
}

// expandWalkType adds the edges the type te, written at s, writes: for each
// instance of a generic it writes (at any depth, an array length's type operands
// included — building the length builds them), from each of s's type parameters
// to each position whose argument it flows into (expandArgFlow).
func expandWalkType(c @Checker, g *expandGraph, s *expandSite, te @ast.TypeExpr) {
	if te == nil { return }
	if te.Kind == ast.TEXPR_INSTANTIATE {
		var h @ast.Decl = expandHeadIn(c, s.Scope, s.Pkg, te)
		if h != nil {
			var hi int = expandAddDecl(g, h)
			for j := 0; j < len(te.TypeArgs) && j < len(h.TypeParams); j++ {
				for p := 0; p < len(s.Params); p++ {
					var none *aliasFrame
					var fl int = expandArgFlow(c, s, te.TypeArgs[j], s.Params[p], none, 0)
					if fl == flowNone { continue }
					var e expandEdge
					e.From = g.Base[s.Index] + p
					e.To = g.Base[hi] + j
					e.Grows = fl == flowGrows
					e.Field = s.Field
					g.Edges = slices.Append[expandEdge](g.Edges, e)
				}
			}
		}
		for j := 0; j < len(te.TypeArgs); j++ {
			expandWalkType(c, g, s, te.TypeArgs[j])
		}
		return
	}
	expandWalkType(c, g, s, te.Base)
	if te.Kind == ast.TEXPR_ARRAY { expandWalkExpr(c, g, s, te.Len) }
	for k := 0; k < len(te.Fields); k++ {
		if te.Fields[k] != nil { expandWalkType(c, g, s, te.Fields[k].Type) }
	}
	for k := 0; k < len(te.ParamTypes); k++ {
		expandWalkType(c, g, s, te.ParamTypes[k])
	}
	for k := 0; k < len(te.ResultTypes); k++ {
		expandWalkType(c, g, s, te.ResultTypes[k])
	}
}

// expandWalkExpr adds the edges the types written inside the expression e — an
// array length's sizeof, alignof or cast operand — write, at s.
func expandWalkExpr(c @Checker, g *expandGraph, s *expandSite, e @ast.Expr) {
	if e == nil { return }
	expandWalkType(c, g, s, e.TypeRef)
	expandWalkExpr(c, g, s, e.X)
	expandWalkExpr(c, g, s, e.Y)
	expandWalkExpr(c, g, s, e.Z)
	for k := 0; k < len(e.Args); k++ {
		expandWalkExpr(c, g, s, e.Args[k])
	}
	for k := 0; k < len(e.Elems); k++ {
		if e.Elems[k] != nil {
			expandWalkExpr(c, g, s, e.Elems[k].Key)
			expandWalkExpr(c, g, s, e.Elems[k].Value)
		}
	}
}

// expandHeadIn returns the generic declaration the instance te instantiates,
// resolving its head as resolveTypeInstantiation does, in scope and package
// pkg; nil when it names none.
func expandHeadIn(c @Checker, scope @Scope, pkg @[]char, te @ast.TypeExpr) @ast.Decl {
	var none @ast.Decl
	var head @ast.TypeExpr = te.Base
	if head == nil || head.Kind != ast.TEXPR_NAMED { return none }
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	if scope != nil { c.Scope = scope }
	c.curPkgPath = pkg
	var declPkg @[]char
	if len(head.Pkg) > 0 { declPkg = resolveQualifiedGenericDeclPkg(c, head.Pkg, head.Name) }
	var d @ast.Decl
	d, _ = lookupGenericHead(c, declPkg, head.Name)
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	return d
}
