package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"

// How a generic's type parameter flows into a type argument it writes, for the
// expansion graph (check_generic_expand.bn): not at all, as the argument itself,
// or nested inside a type constructor — the argument grows each time around a
// cycle.  A parameter mentioned only in an array length (`[sizeof(T)]uint8`)
// does not flow: whether such a length grows around a cycle depends on its
// arithmetic and element size (`[sizeof(T)]uint8` is a fixed point,
// `[sizeof(T) + 1]uint8` grows), which the text does not decide, so such a
// family is bounded where it is built instead (MAX_INSTANCES_PER_BUILD).  A
// generic alias is expanded by substitution, so an argument written
// through one flows as the alias's target uses it: `Id[T]` with
// `type Id[U any] = U` is T itself, `Const[[1]T]` with `type Const[U any] = int`
// does not mention T at all.

// The flows of a type parameter into a type (expandArgFlow).
const (
	// flowNone: the type does not mention the parameter.
	flowNone int = iota
	// flowSame: the type is the parameter itself.
	flowSame
	// flowGrows: the parameter is nested inside a type constructor in the type.
	flowGrows
)

// An aliasFrame binds the type parameters of a generic alias being expanded
// (Names) to the type arguments of its instance (Args), which are written in the
// frame Outer (nil: where the instance is written); the alias's target resolves
// its names in Scope and Pkg.
type aliasFrame struct {
	Names @[]@[]char
	Args  @[]@ast.TypeExpr
	Outer *aliasFrame
	Scope @Scope
	Pkg   @[]char
}

// expandArgFlow returns how the type parameter name, of the generic whose part
// written at s is being walked, flows into the type te — written at s when f is
// nil, else in the target of the generic alias f binds.  Parentheses and
// `readonly` pass the flow through; an alias's instance flows as its target with
// its parameters bound to its arguments.  A chain of aliases deeper than any real
// one counts as growing.
func expandArgFlow(c @Checker, s *expandSite, te @ast.TypeExpr, name *[]readonly char,
		f *aliasFrame, depth int) int {
	if te == nil { return flowNone }
	if depth > 64 { return flowGrows }
	if te.Kind == ast.TEXPR_PAREN || te.Kind == ast.TEXPR_CONST {
		return expandArgFlow(c, s, te.Base, name, f, depth + 1)
	}
	if te.Kind == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 { return flowNone }
		if f == nil {
			if types.CharEq(te.Name, name) { return flowSame }
			return flowNone
		}
		for k := 0; k < len(f.Names) && k < len(f.Args); k++ {
			if types.CharEq(te.Name, f.Names[k]) {
				return expandArgFlow(c, s, f.Args[k], name, f.Outer, depth + 1)
			}
		}
		return flowNone
	}
	if te.Kind == ast.TEXPR_INSTANTIATE {
		var scope @Scope = s.Scope
		var pkg @[]char = s.Pkg
		if f != nil {
			scope = f.Scope
			pkg = f.Pkg
		}
		var a @ast.Decl = expandHeadIn(c, scope, pkg, te)
		if a != nil && a.Kind == ast.DECL_TYPE && a.IsAlias {
			var fr aliasFrame
			fr.Names = expandParamNames(a)
			fr.Args = te.TypeArgs
			fr.Outer = f
			fr.Scope = lookupGenericDeclScope(c, a)
			fr.Pkg = genericTypeDeclPkg(c, a)
			return expandArgFlow(c, s, a.TypeRef, name, &fr, depth + 1)
		}
	}
	if expandPartsFlow(c, s, te, name, f, depth) { return flowGrows }
	return flowNone
}

// expandPartsFlow reports whether the parameter name flows into a part of te —
// an element or pointee, a type argument, a field, a parameter or result, but
// not an array length — at all (expandArgFlow).
func expandPartsFlow(c @Checker, s *expandSite, te @ast.TypeExpr, name *[]readonly char,
		f *aliasFrame, depth int) bool {
	if expandArgFlow(c, s, te.Base, name, f, depth + 1) != flowNone { return true }
	for k := 0; k < len(te.TypeArgs); k++ {
		if expandArgFlow(c, s, te.TypeArgs[k], name, f, depth + 1) != flowNone { return true }
	}
	for k := 0; k < len(te.Fields); k++ {
		if te.Fields[k] != nil && expandArgFlow(c, s, te.Fields[k].Type, name, f, depth + 1) != flowNone {
			return true
		}
	}
	for k := 0; k < len(te.ParamTypes); k++ {
		if expandArgFlow(c, s, te.ParamTypes[k], name, f, depth + 1) != flowNone { return true }
	}
	for k := 0; k < len(te.ResultTypes); k++ {
		if expandArgFlow(c, s, te.ResultTypes[k], name, f, depth + 1) != flowNone { return true }
	}
	return false
}
