package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_generic_expand_flow.bn: how a type parameter flows into a type
// argument, generic aliases expanded by substitution.

// An argument written through aliases flows as their targets use it: an alias of
// an identity alias is the parameter itself, an alias that drops its parameter
// or selects another argument passes nothing on — none of these grow.
func TestExpandFlowThroughAliases() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Id[U any] = U\ntype Id2[U any] = Id[U]\n"
							"type Const[U any] = int\ntype First[A any, B any] = A\n"
							"type N[T any] struct { a *N[Id2[T]]; b *N[Const[[1]T]]; c *N[First[int, [1]T]]; v T }\n"
							"func f() int {\n\tvar n N[int]\n\treturn n.v\n}\n"))
}

// A parameter mentioned only in an array length does not flow: whether the
// length grows depends on its arithmetic, so a fixed point — Box[int]'s Raw
// returns a *Box[[8]uint8], whose Raw returns the same — is fine.
func TestExpandLengthMentionDoesNotGrow() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Box[T any] struct { x T; next *Box[[sizeof(T)]uint8] }\n"
							"func (b *Box[T]) Raw() *Box[[sizeof(T)]uint8] { return b.next }\n"
							"func f() int {\n\tvar b Box[int]\n\t_ = b\n\treturn 0\n}\n"))
}

// An instance written inside an array length is built with it, so it is an edge
// like any other: N's fields name ever-growing instances that way.
func TestExpandInstanceInsideLength() testing.TestResult {
	return errsIn(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\ntype Res[T any] struct { r T }\n"
							"type N[T any] struct { a [sizeof(*N[Opt[T]])]uint8; b [sizeof(*N[Res[T]])]uint8 }\n"),
			"the fields of generic type N name instances with ever-growing type arguments")
}
