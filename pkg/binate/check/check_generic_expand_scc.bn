package "pkg/binate/check"

import "pkg/binate/ast"

// The cycles of an expansion graph that grow (check_generic_expand.bn): its
// strongly connected components, each holding a growing edge between two of its
// nodes, put every one of their nodes on such a cycle.

// An sccWalk is Tarjan's walk of an expansion graph's components over the edges
// it considers: the visit order and low link of each node (Order -1 before it is
// visited), the nodes on the stack, and each node's component.
type sccWalk struct {
	First   @[]int
	NextE   @[]int
	Order   @[]int
	Low     @[]int
	OnStack @[]bool
	Stack   @[]int
	Top     int
	Seen    int
	Comp    @[]int
	NComp   int
}

// expandCycleNodes reports, for each node of g, whether it lies on a cycle that
// grows — of structure edges alone when fieldsOnly.
func expandCycleNodes(g *expandGraph, fieldsOnly bool) @[]bool {
	var w sccWalk
	w.First = make_slice(int, g.N)
	w.Order = make_slice(int, g.N)
	w.Low = make_slice(int, g.N)
	w.OnStack = make_slice(bool, g.N)
	w.Stack = make_slice(int, g.N)
	w.Comp = make_slice(int, g.N)
	w.NextE = make_slice(int, len(g.Edges))
	for n := 0; n < g.N; n++ {
		w.First[n] = -1
		w.Order[n] = -1
	}
	for k := 0; k < len(g.Edges); k++ {
		w.NextE[k] = -1
		if !fieldsOnly || g.Edges[k].Field {
			w.NextE[k] = w.First[g.Edges[k].From]
			w.First[g.Edges[k].From] = k
		}
	}
	for n := 0; n < g.N; n++ {
		if w.Order[n] < 0 { expandSccVisit(g, &w, n) }
	}
	var grows @[]bool = make_slice(bool, w.NComp)
	for k := 0; k < len(g.Edges); k++ {
		var e expandEdge = g.Edges[k]
		if e.Grows && (!fieldsOnly || e.Field) && w.Comp[e.From] == w.Comp[e.To] {
			grows[w.Comp[e.From]] = true
		}
	}
	var on @[]bool = make_slice(bool, g.N)
	for n := 0; n < g.N; n++ {
		on[n] = grows[w.Comp[n]]
	}
	return on
}

// expandSccVisit visits node n and what it reaches, assigning each finished component.
func expandSccVisit(g *expandGraph, w *sccWalk, n int) {
	w.Order[n] = w.Seen
	w.Low[n] = w.Seen
	w.Seen = w.Seen + 1
	w.Stack[w.Top] = n
	w.Top = w.Top + 1
	w.OnStack[n] = true
	var k int = w.First[n]
	for k >= 0 {
		var m int = g.Edges[k].To
		if w.Order[m] < 0 {
			expandSccVisit(g, w, m)
			if w.Low[m] < w.Low[n] { w.Low[n] = w.Low[m] }
		} else if w.OnStack[m] && w.Order[m] < w.Low[n] {
			w.Low[n] = w.Order[m]
		}
		k = w.NextE[k]
	}
	if w.Low[n] != w.Order[n] { return }
	for {
		w.Top = w.Top - 1
		var m int = w.Stack[w.Top]
		w.OnStack[m] = false
		w.Comp[m] = w.NComp
		if m == n { break }
	}
	w.NComp = w.NComp + 1
}

// lookupMethodGenericDecl returns the generic type declaration the method
// entry is declared on, or nil.
func lookupMethodGenericDecl(c @Checker, entry @GenericMethodEntry) @ast.Decl {
	var none @ast.Decl
	var inst @ast.TypeExpr = receiverBaseInstantiation(entry.Decl.Recv.Type)
	if inst == nil || inst.Base == nil { return none }
	return lookupGenericTypeDeclPkg(c, entry.Pkg, inst.Base.Name)
}
