package "pkg/binate/check"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for check_generic_expand_scc.bn: the nodes of an expansion graph on a
// cycle that grows.

// expandTestGraph returns a graph of n nodes and no declarations.
func expandTestGraph(n int) expandGraph {
	var g expandGraph
	g.N = n
	return g
}

// expandTestEdge adds the edge from → to to g.
func expandTestEdge(g *expandGraph, from int, to int, grows bool, field bool) {
	var e expandEdge
	e.From = from
	e.To = to
	e.Grows = grows
	e.Field = field
	g.Edges = slices.Append[expandEdge](g.Edges, e)
}

// A cycle 0 → 1 → 0 with one growing edge puts both nodes on a growing cycle;
// node 2, which only reaches it, and node 3, on a cycle that does not grow, are
// not on one.
func TestExpandCycleNodesGrowing() testing.TestResult {
	var g expandGraph = expandTestGraph(4)
	expandTestEdge(&g, 0, 1, true, false)
	expandTestEdge(&g, 1, 0, false, false)
	expandTestEdge(&g, 2, 0, true, false)
	expandTestEdge(&g, 3, 3, false, false)
	var on @[]bool = expandCycleNodes(&g, false)
	if !on[0] || !on[1] { return fail("0 and 1 lie on a growing cycle") }
	if on[2] || on[3] { return fail("2 and 3 do not") }
	return ""
}

// Over structure edges alone, a cycle closed by a signature edge is no cycle.
func TestExpandCycleNodesFieldsOnly() testing.TestResult {
	var g expandGraph = expandTestGraph(2)
	expandTestEdge(&g, 0, 1, true, true)
	expandTestEdge(&g, 1, 0, false, false)
	if !expandCycleNodes(&g, false)[0] { return fail("over all edges, 0 lies on a growing cycle") }
	if expandCycleNodes(&g, true)[0] { return fail("over structure edges alone, it does not") }
	return ""
}
