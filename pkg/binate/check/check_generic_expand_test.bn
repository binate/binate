package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_generic_expand.bn and check_generic_build.bn: infinite
// generic families found from the declarations.

// boxFamily declares Box[T], whose Wrap returns Box[Opt[T]] and whose Pair
// returns Box[Res[T]]: an infinite family that branches.
var boxFamily *[]readonly char = "package \"test\"\ntype Opt[T any] struct { v T }\n"
		"type Res[T any] struct { r T }\ntype Box[T any] struct { x T }\n"
		"func (b *Box[V]) Wrap() Box[Opt[V]] {\n\tvar r Box[Opt[V]]\n\tr.x.v = b.x\n\treturn r\n}\n"
		"func (b *Box[V]) Pair() Box[Res[V]] {\n\tvar r Box[Res[V]]\n\treturn r\n}\n"

// Naming an instance of a generic in an infinite family is an error there.
func TestExpandFamilyInstantiatedRejected() testing.TestResult {
	var c @Checker = checkSrc(buf.Concat(boxFamily, "func f() {\n\tvar b Box[int]\n\t_ = b\n}\n"))
	if len(c.CheckerErrors()) != 1 ||
			!anyErrContains(c, "generic instantiation Box[int] names infinitely many instantiations") {
		return fail("expected exactly Box[int] reported")
	}
	return ""
}

// A generic struct whose fields alone name ever-growing instances — here two
// ways — is rejected at its declaration, instantiated or not.
func TestExpandFieldsRejectedAtDeclaration() testing.TestResult {
	return errsIn(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\ntype Res[T any] struct { r T }\n"
							"type T2[X any] struct { a *T2[Opt[X]]; b *T2[Res[X]] }\n"),
			"the fields of generic type T2 name instances with ever-growing type arguments")
}

// An argument that is an alias of its parameter does not grow: S[Id[T]] is S[T].
func TestExpandIdentityAliasDoesNotGrow() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Id[T any] = T\ntype S[T any] struct { next *S[Id[T]]; v T }\n"
							"func f() int {\n\tvar s S[int]\n\treturn s.v\n}\n"))
}

// A generic interface whose methods name ever-growing instances is in an
// infinite family too: accepted uninstantiated, rejected where an instance of it
// is named.
func TestExpandInterfaceFamily() testing.TestResult {
	var decl *[]readonly char = "package \"test\"\ntype Opt[T any] struct { v T }\n"
			"type Res[T any] struct { r T }\ninterface I[T any] { a() @I[Opt[T]]; b() @I[Res[T]] }\n"
	var e testing.TestResult = expectNoErrors(checkSrc(decl))
	if len(e) > 0 { return e }
	return errsIn(checkSrc(buf.Concat(decl, "var i @I[int]\n")),
			"generic instantiation I[int] names infinitely many instantiations")
}

// At the REPL a generic's method may be redefined, and whether the generic is in
// an infinite family is decided again: Wrap redefined to grow makes naming a new
// instance of Box an error, and redefined back, a fine one again.
func TestExpandVerdictFollowsRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Opt[T any] struct { v T }")
	replCheckDecl(c, "type Box[T any] struct { x T }")
	replCheckDecl(c, "func (b *Box[V]) Wrap() Box[V] { return *b }")
	replCheckStmts(c, "var a Box[int]\n_ = a")
	if len(c.CheckerErrors()) != 0 { return fail("a Wrap that does not grow names a finite set") }
	replCheckDecl(c, "func (b *Box[V]) Wrap() Box[Opt[V]] { var r Box[Opt[V]]; return r }")
	replCheckStmts(c, "var d Box[bool]\n_ = d")
	var msg *[]readonly char = "generic instantiation Box[bool] names infinitely many instantiations"
	if errorsContaining(c, msg) == 0 {
		return fail("a Wrap redefined to grow makes Box[bool] an error")
	}
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func (b *Box[V]) Wrap() Box[V] { return *b }")
	replCheckStmts(c, "var e Box[uint8]\n_ = e")
	if len(c.CheckerErrors()) != before { return fail("a Wrap redefined back makes Box[uint8] fine") }
	return ""
}

// An interface's ancestors in an infinite family are complete when code looks
// a method up through it: J's Val is I's, whose abstract instance waits for its
// methods.
func TestExpandInheritedMethodOfWaitingParent() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\n"
							"interface I[T any] { Val() int; Up() @I[Opt[T]] }\ninterface J[T any] : I[T] {}\n"
							"func F[T any](j @J[T]) int { return j.Val() }\n"))
}
