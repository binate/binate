package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// A generic declaration's own parts — the types it writes, with its type
// parameters, which no opaque type can stand for — are held at the declaration
// to the opaque rules a non-generic declaration's are (checkValueEmbedding), in
// the view where it is written: they are decided once, for every instance
// (gen.mono.check).  An instance then judges only the parts that come from its
// type arguments, where they are written (instanceStructure,
// requireIfaceInstanceArgsKept, requireAliasArgsKept, requireCallSigKept).  The
// size limit is judged where an instance is used (requireSizedType,
// requireCallSigKept), where its layout is known.

// requireGenericPartsKept holds the generic type, alias or interface
// declaration d's own parts to the opaque rules, as its abstract instance inst
// (checkGenericDeclAbstract) spells them out: a struct's fields, another
// definition's underlying type, an alias's target, an interface's own methods.
// A definition that is itself opaque (a distinct type over an opaque one) is
// used through a pointer, as a non-generic one is.
func requireGenericPartsKept(c @Checker, d @ast.Decl, inst @types.Type) {
	if inst == nil { return }
	if d.Kind == ast.DECL_INTERFACE {
		requireMethodSignaturesKept(c, inst, d.Pos)
		return
	}
	if d.IsAlias {
		if !isOpaqueValueType(c, inst) { requireOpaqueRules(c, inst, d.Pos) }
		return
	}
	var u @types.Type = inst.Underlying
	if u == nil { return }
	if d.TypeRef.Kind == ast.TEXPR_STRUCT && u.Kind == types.TYP_STRUCT {
		for i := 0; i < len(u.Fields); i++ {
			requireOpaqueRules(c, u.Fields[i].Type, d.Pos)
		}
	} else if !isOpaqueValueType(c, u) {
		requireOpaqueRules(c, u, d.Pos)
	}
}

// requireGenericFuncSigKept holds the generic function declaration d's
// parameters and results, with its type parameters, to the opaque rules, as a
// non-generic function declaration's are.
func requireGenericFuncSigKept(c @Checker, d @ast.Decl) {
	var ft @types.Type
	if isBlank(d.Name) {
		ft = c.ExprType(d.ResolvedTypeID)
	} else {
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil { ft = sym.Type }
	}
	if ft == nil || ft.Kind != types.TYP_FUNC { return }
	for i := 0; i < len(ft.Params); i++ {
		requireOpaqueRules(c, ft.Params[i].Type, d.Pos)
	}
	for i := 0; i < len(ft.Results); i++ {
		requireOpaqueRules(c, ft.Results[i], d.Pos)
	}
}

// requireOpaqueRules reports, at pos, the first opaque rule t breaks where it is
// written (opaqueRulesKept, in viewHere).
func requireOpaqueRules(c @Checker, t @types.Type, pos token.Pos) {
	var w opaqueWalk
	var none *opaqueFrame
	_ = opaqueRulesKept(c, t, pos, &w, viewHere, none)
}
