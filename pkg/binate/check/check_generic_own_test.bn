package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_generic_own.bn: a generic declaration's own parts are held to
// the opaque rules at the declaration.

// Each generic declaration whose own parts break the opaque rules is rejected
// where it is written, whether or not it is instantiated: a by-value field, a
// pointer to an opaque embedding, another definition, an alias, an interface
// method and a function parameter.
func TestCheckGenericOwnPartsRejected() testing.TestResult {
	var decls *[]readonly char = "type S[T any] struct { v Opaque; t T }\n"
			"type P[T any] struct { p *([2]Opaque); t *T }\n"
			"type A[T any] [2]Opaque\n"
			"type L[T any] = *func(Opaque) T\n"
			"interface I[T any] { m(o Opaque) T }\n"
			"func F[T any](p *func(Opaque)) T { var t T\n\treturn t\n}\n"
	var errs @[]types.CheckError = checkSrc(
			buf.Concat("package \"test\"\ntype Opaque\n", decls)).CheckerErrors()
	if len(errs) != 6 {
		return fail(buf.Concat("expected 6 errors, one per declaration; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// A generic's own part that breaks a rule on forming a type is reported at the
// declaration, not again at each instance of it or call of it written elsewhere.
func TestCheckGenericOwnPartsReportedOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque\n"
			"type P[T any] struct { p *([2]Opaque); t *T }\n"
			"interface I[T any] { m(o Opaque) T }\n"
			"func F[T any](p *func(Opaque)) int { return 0 }\n"
			"type X *P[int]\ntype Y *P[bool]\n"
			"func g(a *I[int], b @I[bool]) int {\n"
			"\treturn F[int](nil) + F[bool](nil)\n}\n"
	var errs @[]types.CheckError = checkSrc(src).CheckerErrors()
	if len(errs) != 3 {
		return fail(buf.Concat("expected 3 errors, one per generic; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// A type parameter is not opaque: a generic's parts that hold one by value, or
// point to a type embedding one, are fine.
func TestCheckGenericOwnPartsOk() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opaque\n"
							"type S[T any] struct { v T; a [2]T; p *([2]T); o *Opaque }\n"
							"type A[T any] [2]T\ntype L[T any] = *func(T) [2]T\n"
							"interface I[T any] { m(t T, p *([2]T)) [2]T }\n"
							"func F[T any](t T, f *func([2]T)) [2]T { var a [2]T\n\ta[0] = t\n\treturn a\n}\n"))
}

// Nor is it reported again in an instance's body: a generic function whose body
// holds an instance of each generic is instantiated without a further report.
func TestCheckGenericOwnPartsNotAgainInBodies() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque\n"
			"type P[T any] struct { p *([2]Opaque); t *T }\n"
			"interface I[T any] { m(o Opaque) T }\n"
			"func F[T any]() int {\n\tvar x @I[T]\n\tvar y *P[T]\n\t_ = x\n\t_ = y\n\treturn 0\n}\n"
			"func g() int { return F[int]() + F[bool]() }\n"
	var errs @[]types.CheckError = checkSrc(src).CheckerErrors()
	if len(errs) != 2 {
		return fail(buf.Concat("expected 2 errors, one per generic; got ", strconv.Itoa(len(errs))))
	}
	return ""
}
