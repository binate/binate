package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Body population for a generic instantiation: fills the pre-created,
// cache-registered @types.Type (interface or named type) with the generic decl's body,
// each type-param substituted for its concrete arg.  Split out of
// check_generic_type.bn for file-length hygiene; both run under the generic's
// DEFINING package + a per-decl type-param scope (see instantiateGenericDeclWithArgs,
// which creates and registers the shell first so recursive references resolve back).

// resolveGenericTypeDeclAbstract resolves the generic struct or interface
// declaration d itself — the declaration every instantiation shares — once,
// with its type parameters abstract.  That records on it what does not depend
// on the type arguments, which IR-gen reads when it builds an instantiation
// from it: a known array length (a constant of the declaring package, a `len`
// of an array) and the type of a `len` operand in a length that does depend on
// a type parameter.  A length that depends on a type parameter is not
// recorded.  Each instantiation is resolved from its own clone
// (populateInstantiatedStruct / populateInstantiatedInterface).
func resolveGenericTypeDeclAbstract(c @Checker, d @ast.Decl, isIface bool) {
	for i := 0; i < len(c.GenericDeclsResolved); i++ {
		if same(c.GenericDeclsResolved[i], d) {
			return
		}
	}
	c.GenericDeclsResolved = slices.Append[@ast.Decl](c.GenericDeclsResolved, d)
	// The declaration is resolved as written, with its type parameters abstract,
	// so its uses of impls are checked in its own view, even when an instance being
	// resolved reaches it first.
	var st @InstanceState = instanceState(c)
	var savedBound int = st.Bound
	st.Bound = 0
	// `Self` in a generic interface's signatures is judged at the interface's
	// instantiation with its own type parameters (populateInstantiatedInterface),
	// which bounds it by that instance, not here, with no interface type.
	var savedSelfBound @types.Type = c.SelfBound
	c.SelfBound = nil
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	if isIface {
		c.curPkgPath = genericIfaceDeclPkg(c, d)
		installTypeParamScope(c, d)
		var prevAllowSelf bool = c.AllowSelf
		c.AllowSelf = true
		for i := 0; i < len(d.Decls); i++ {
			if d.Decls[i] != nil && d.Decls[i].Kind == ast.DECL_FUNC {
				resolveFuncDeclType(c, d.Decls[i])
			}
		}
		c.AllowSelf = prevAllowSelf
	} else {
		c.curPkgPath = genericTypeDeclPkg(c, d)
		installTypeParamScope(c, d)
		if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			resolveStructType(c, d.TypeRef)
		} else if d.TypeRef != nil && !d.IsAlias {
			_ = resolveTypeExpr(c, d.TypeRef)
		}
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	st.Bound = savedBound
	c.SelfBound = savedSelfBound
}

// populateInstantiatedInterface fills the pre-created (and already
// cache-registered) instantiated TYP_INTERFACE `iface` with its methods
// (unless withMethods is false: completeIfaceInstanceMethods adds them later)
// AND parent interfaces, each TYP_TYPE_PARAM substituted for the
// matching type-arg.  The method signatures and parents resolved are those
// of `body`, this instantiation's own clone of the generic `d`; `d` names the
// generic.  Resolves in the instance's scope (enterIfaceInstance) so the
// method-signature and parent resolution see T bound to its concrete
// @types.Type.  `iface` is created and
// registered by instantiateGenericDeclWithArgs first so a recursive
// `interface N[T] : N[T]` resolves its parent back to this in-progress
// iface (and the self-extension guard rejects it) instead of looping.
//
// Generic interface decls are deferred at collectInterfaceDecl (no
// stable TYP_INTERFACE at decl time), so this is the sole place a
// generic interface's extension clause is resolved — hence the
// resolveInterfaceExtension call here rather than at decl time.
// Without it an instantiated `WideBox[int]` would have empty
// Parents, so isDescendantInterface would report it as extending
// nothing — wrongly rejecting a valid `@WideBox[int]` → `@Box[int]`
// upcast / constraint-satisfaction.
// `userFacing` gates the method-size diagnostics: a SPECULATIVE instantiation
// (substituteTypeParams probing an impl-match) still builds the methods, but
// must not REPORT that a substituted param/result is too large — that diagnostic
// is a property of what the user wrote, so a use-site-less probe would leak it
// as a false positive on otherwise-valid code.  The first user-facing use
// re-checks the sizes via requireInstantiatedIfaceMethodsSized (recorded on the
// cache entry), so a real misuse is still caught.  The opaque rules are judged
// where the instance is written, not here (requireIfaceInstanceArgsKept).
func populateInstantiatedInterface(c @Checker, d @ast.Decl, body @ast.Decl, args @[]@types.Type,
		iface @types.Type, userFacing bool, withMethods bool) {
	var saved ifaceInstanceScope = enterIfaceInstance(c, d, args)
	if withMethods { resolveIfaceInstanceMethods(c, body, iface, userFacing) }
	// Resolve the extension clause with the type-param scope still
	// active so a parent `Box[T]` substitutes to `Box[int]`; this
	// fills iface.Parents (and runs the same validation /
	// method-conflict checks as the non-generic path — the conflict checks
	// once the methods are resolved).
	resolveInterfaceParents(c, body, iface, withMethods)
	// The `Self` checks queued above can run now that iface's parents are
	// known, unless a declaration batch is being collected or a .bni surface
	// built: their impls are not all recorded yet, nor the parents of the
	// interfaces iface's parents extend, and collectDecls runs the checks at its
	// end.
	if !c.CollectingDecls && !c.BuildingIfaceScope {
		recheckSelfConstraints(c, iface)
	}
	leaveIfaceInstance(c, saved)
}

// completeIfaceInstanceMethods resolves the methods of the interface instance
// iface (of d with args, from its clone body), whose parents were resolved
// without them (populateInstantiatedInterface), and checks them against its
// parents' (checkInterfaceMethodConflicts) — later, when a declaration batch is
// being collected or a .bni surface built, as resolveInterfaceExtension does.
func completeIfaceInstanceMethods(c @Checker, d @ast.Decl, body @ast.Decl, args @[]@types.Type,
		iface @types.Type, userFacing bool) {
	var saved ifaceInstanceScope = enterIfaceInstance(c, d, args)
	resolveIfaceInstanceMethods(c, body, iface, userFacing)
	if c.CollectingDecls || c.BuildingIfaceScope {
		c.DeferredIfaceConflictDecls = slices.Append[@ast.Decl](c.DeferredIfaceConflictDecls, body)
		c.DeferredIfaceConflictTypes = slices.Append[@types.Type](c.DeferredIfaceConflictTypes, iface)
	} else {
		checkInterfaceMethodConflicts(c, body, iface)
	}
	leaveIfaceInstance(c, saved)
}

// An ifaceInstanceScope is what enterIfaceInstance changes, for
// leaveIfaceInstance to restore.
type ifaceInstanceScope struct {
	Bound   instanceBinding
	Scope   @Scope
	PkgPath @[]char
}

// enterIfaceInstance enters the resolution of the generic interface d's
// instance with args: bound as an instance (bindInstance), under the generic's
// DEFINING-file scope (its imports) and package, with its type parameters bound
// to args — not the use-site scope.  An UNQUALIFIED same-package generic
// reference in a method signature — a sibling `@Iterator[T]` in `Iterable[T]`, a
// `@Box[T]` result — resolves via the generic-decl lookups' curPkgPath fallback,
// which must name the interface's OWN package, not the consumer's: otherwise,
// when a DIFFERENT package's `impl @Foo : iface.Iterable[int]` instantiates this
// interface to check satisfaction, the sibling name resolves in the impl-site
// package and is reported `undefined`.
func enterIfaceInstance(c @Checker, d @ast.Decl, args @[]@types.Type) ifaceInstanceScope {
	var saved ifaceInstanceScope
	saved.Bound = bindInstance(c, d, args)
	saved.Scope = c.Scope
	saved.PkgPath = c.curPkgPath
	c.curPkgPath = genericIfaceDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams); i++ {
		if isBlank(d.TypeParams[i].Name) {
			continue
		}
		defineType(c.Scope, d.TypeParams[i].Name, args[i])
	}
	return saved
}

// leaveIfaceInstance restores what enterIfaceInstance changed.
func leaveIfaceInstance(c @Checker, saved ifaceInstanceScope) {
	c.Scope = saved.Scope
	c.curPkgPath = saved.PkgPath
	unbindInstance(c, saved.Bound)
}

// resolveIfaceInstanceMethods adds the methods of the interface instance iface
// from its clone body, in the instance's scope (enterIfaceInstance) — the same
// per-method pattern as collectInterfaceDecl: each method is a stub DECL_FUNC
// whose FuncType resolves with the type parameters bound.
func resolveIfaceInstanceMethods(c @Checker, body @ast.Decl, iface @types.Type, userFacing bool) {
	var prevAllowSelf bool = c.AllowSelf
	var prevSelfBound @types.Type = c.SelfBound
	c.AllowSelf = true
	c.SelfBound = iface
	for i := 0; i < len(body.Decls); i++ {
		var m @ast.Decl = body.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC { continue }
		var ft @types.Type = resolveFuncDeclType(c, m)
		// Reject a method whose (substituted) param / result is too large for
		// the target.  Only at a user-facing instantiation (see userFacing
		// above); a speculative probe re-checks later via
		// requireInstantiatedIfaceMethodsSized.  Checked once the instances the
		// signature names are built (requireMethodSized).  The opaque rules are
		// judged where the instance is written (requireIfaceInstanceArgsKept).
		if userFacing { requireMethodSized(c, ft, m.Pos) }
		var method @types.Method = MakeMethod(m.Name, iface, ft)
		iface.AddMethod(method)
	}
	c.AllowSelf = prevAllowSelf
	c.SelfBound = prevSelfBound
}

// requireInstantiatedIfaceMethodsSized re-runs the method-size check on an
// already-populated instantiated interface at a user-facing use.
// populateInstantiatedInterface SKIPS it when it runs speculatively (a
// use-site-less impl-match probe), which would otherwise leak the diagnostic as
// a false positive on valid code; this recovers it even when a probe populated
// the cache first.  Anchored at the use pos — the speculative populate has no
// user-written site of its own — and driven off the built iface.Methods rather
// than re-walking the decl, since that is what the cache holds.  (The opaque
// rules on the parts that come from its type arguments are judged at each use,
// requireIfaceInstanceArgsKept.)
func requireInstantiatedIfaceMethodsSized(c @Checker, iface @types.Type, usePos token.Pos) {
	for i := 0; i < len(iface.Methods); i++ {
		var ft @types.Type = iface.Methods[i].FuncType
		if ft != nil { requireMethodSized(c, ft, usePos) }
	}
}

// populateInstantiatedType fills the pre-created (and already
// cache-registered) instantiated TYP_NAMED `named` with the generic
// decl's underlying type — a struct body, or any other type (`type
// Pair[T any] [2]T`, gen.instantiate.type) — each TYP_TYPE_PARAM
// substituted for the matching type-arg.  The types resolved are those of
// `body`, this instantiation's own clone of the generic `d`; `d` names the
// generic.  Pushes a per-decl
// type-param scope so the field-type resolution sees T bound to its concrete
// @types.Type.  `named` is created
// and registered by instantiateGenericDeclWithArgs first, so a
// recursive field `next @Node[T]` (behind a managed pointer, hence
// size-stable) resolves back to this in-progress `named` instead of
// looping; its Underlying is nil during field resolution and filled in
// below.
func populateInstantiatedType(c @Checker, d @ast.Decl, body @ast.Decl, args @[]@types.Type,
		named @types.Type, deriveMethods bool) {
	var savedBound instanceBinding = bindInstance(c, d, args)
	// Resolve the body under the generic's DEFINING-file scope (its imports),
	// so a qualified field type `dep.Thing` binds to the generic's own `dep`,
	// not the consumer's — otherwise the wrong struct (wrong layout) is used.
	var savedScope @Scope = c.Scope
	// Also resolve under the generic's DEFINING package: generic struct decls
	// are keyed by full package path, and an UNQUALIFIED same-package generic
	// field head (`@Node[T]` self-ref, `@Pair[T]`) resolves via
	// lookupGenericTypeDeclPkg's curPkgPath fallback — which must name the
	// generic's own package, not the consumer instantiating it.
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	// Install type-params keyed on names (resolveTypeExpr's
	// TEXPR_NAMED branch finds them by scope lookup).  Each
	// type-param's @types.Type is the substituted concrete arg —
	// not a TYP_TYPE_PARAM placeholder; substitution happens
	// in-line during field resolution.  A blank `_` parameter names nothing.
	for i := 0; i < len(d.TypeParams); i++ {
		var nm @[]char = d.TypeParams[i].Name
		if isBlank(nm) {
			continue
		}
		defineType(c.Scope, nm, args[i])
	}
	if body.TypeRef != nil && body.TypeRef.Kind == ast.TEXPR_STRUCT {
		var underlying @types.Type = resolveStructType(c, body.TypeRef)
		underlying.Name = named.Name
		named.Underlying = underlying
		// An instantiation that holds itself by value (`x Bad[T]` in `Bad[T]`,
		// directly or through other types) has no finite layout; the check of
		// non-generic declarations (checkValueEmbedding) skips generic ones, so
		// each instantiation is checked here, which also poisons the offending
		// field so the walks over its layout terminate.
		checkTypeByValueCycle(c, named, d)
	} else if body.TypeRef != nil && !body.IsAlias {
		// Any other underlying type: the instantiation is a named type over it,
		// the type arguments substituted, as a non-generic `type N U` is.  One
		// that is itself (`type A[T any] A[T]`) has no underlying.
		named.Underlying = resolveTypeExpr(c, body.TypeRef)
		if namedTypeDefIsCyclic(named) {
			errCyclicType(c, d.Pos, d.Name)
			named.Underlying = nil
		} else {
			checkTypeByValueCycle(c, named, d)
		}
	}
	// Substitute the generic type's methods onto this instantiation, unless it
	// waits for them (deriveMethods false: buildInstanceMembers).  A type
	// instantiated (by a var/field/param/receiver type) BEFORE its method decls
	// are collected caches method-less; backfillInstantiationMethods re-syncs it
	// once collection completes (see copyPlaceholderMethods).
	if deriveMethods { copyPlaceholderMethods(c, d, args, named) }
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	unbindInstance(c, savedBound)
}

// checkGenericDeclAbstract checks the generic type, alias or interface
// declaration d at its declaration, whether or not the program instantiates
// it: it builds d's instantiation with its own type parameters, whose
// population resolves d's body and reports what does not resolve — a type's
// underlying, an alias's target (instantiateGenericAlias, which also reports a
// recursive alias), an interface's method signatures and parents.  A type's
// population also checks it for holding itself by value (spec
// type.named.value-acyclic, populateInstantiatedType): such a cycle cannot
// depend on the type arguments — one through a type argument passes through a
// distinct type rejected at its own declaration — so the abstract
// instantiation finds every one.  Then d's own parts are held to the opaque
// rules, in the view where d is written (requireGenericPartsKept).
func checkGenericDeclAbstract(c @Checker, d @ast.Decl) {
	var isIface bool = d.Kind == ast.DECL_INTERFACE
	if isIface && d.IsAlias { return }
	if !isIface && (d.Kind != ast.DECL_TYPE || d.TypeRef == nil) { return }
	if !d.IsAlias && genericFieldsExpanding(c, d) { errFieldsExpanding(c, d) }
	pushScope(c)
	var params @[]@types.Type = installTypeParamScope(c, d)
	var inst @types.Type = instantiateGenericDeclWithArgs(c, d, isIface, params, d.Pos, false)
	stampFromAbstractCopy(c, d, isIface, params)
	popScope(c)
	requireGenericPartsKept(c, d, inst)
}
