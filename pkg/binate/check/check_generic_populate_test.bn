package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_generic_populate.bn — populateInstantiatedType /
// populateInstantiatedInterface fill an instantiated generic's body with each
// type-param substituted for its concrete arg.  Shared helpers (checkSrc /
// expectNoErrors) live in types_test.bn.

// populateInstantiatedType substitutes the type args into the struct's fields:
// `Pair[int, bool]`'s `first` is int and `second` is bool, so the field reads
// type-check at their concrete types.
func TestPopulateInstantiatedStructFields() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair[A any, B any] struct { first A; second B }\n"
			"func main() {\n"
			"	var p Pair[int, bool]\n"
			"	var x int = p.first\n"
			"	var y bool = p.second\n"
			"	_ = x\n"
			"	_ = y\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A field read at the WRONG concrete type is rejected — proves the substitution
// really happened (first is int in Pair[int, bool], not assignable to a bool).
func TestPopulateInstantiatedStructFieldTypeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair[A any, B any] struct { first A; second B }\n"
			"func main() { var p Pair[int, bool]; var b bool = p.first; _ = 0 }\n"
	var c @Checker = checkSrc(src)
	if !anyErrContains(c, "cannot assign") {
		return fail("Pair[int,bool].first is int, not assignable to bool")
	}
	return ""
}

// populateInstantiatedInterface substitutes the type args into the method
// signatures: `Getter[int]`'s `get()` returns int, so calling it through a
// @Getter[int] value yields an int.
func TestPopulateInstantiatedInterfaceMethods() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Getter[T any] { get() T }\n"
			"func useg(g @Getter[int]) int { return g.get() }\n"
			"func main() { _ = 0 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The substituted method result is really int, not the type-param T: returning
// g.get() (int) where a bool is expected is rejected.
func TestPopulateInstantiatedInterfaceMethodResultTypeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Getter[T any] { get() T }\n"
			"func useg(g @Getter[int]) bool { return g.get() }\n"
			"func main() { _ = 0 }\n"
	var c @Checker = checkSrc(src)
	if !anyErrContains(c, "cannot") {
		return fail("Getter[int].get() returns int, not assignable to a bool result")
	}
	return ""
}

// The opaque-by-value method-size check must NOT fire from a SPECULATIVE
// interface instantiation.  Checking `Consumer[Wrap[Op]]` (Op opaque) probes
// `Wrap[Op] : Marker`, which walks Wrap's OTHER impl `Sink[K]` and instantiates
// `Sink[Op]` internally — but the user never uses `Sink[Op]`, so the fact that
// its `put(t Op)` would take Op by value is not a diagnostic about this program.
// A leak here is a false positive on valid code (the pre-decouple bug).
func TestSpeculativeIfaceInstNoOpaqueByValueLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Op\n"
			"interface Marker { m() }\n"
			"interface Sink[T any] { put(t T) }\n"
			"type Wrap[K any] struct { x int }\n"
			"func (w Wrap[K]) put(t K) {}\n"
			"func (w Wrap[K]) m() {}\n"
			"impl Wrap[K] : Sink[K]\n"
			"impl Wrap[K] : Marker\n"
			"type Consumer[X Marker] struct { c X }\n"
			"func useit(cc Consumer[Wrap[Op]]) {}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Soundness (direct): a USER-FACING `@Sink[Op]` — Op opaque, `put(t Op)` takes
// Op by value — is still rejected.  This is the miss-path (userFacing=true), so
// the check fires at the method decl as before the decouple.
func TestUserFacingIfaceInstOpaqueByValueRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Op\n"
			"interface Sink[T any] { put(t T) }\n"
			"func direct(s @Sink[Op]) {}\n"
			"func main() { _ = 0 }\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "cannot use an opaque type by value")
}

// Soundness (cache-first): a SPECULATIVE `Sink[Op]` populates the cache first
// (via the `Consumer[Wrap[Op]]` probe), THEN the user writes a real `@Sink[Op]`.
// The deferred re-check (requireInstantiatedIfaceMethodsSized) must still reject
// it at the use site, so a probe populating the cache first cannot swallow a
// genuine opaque-by-value misuse.
func TestSpeculativeThenUserFacingIfaceInstOpaqueRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Op\n"
			"interface Marker { m() }\n"
			"interface Sink[T any] { put(t T) }\n"
			"type Wrap[K any] struct { x int }\n"
			"func (w Wrap[K]) put(t K) {}\n"
			"func (w Wrap[K]) m() {}\n"
			"impl Wrap[K] : Sink[K]\n"
			"impl Wrap[K] : Marker\n"
			"type Consumer[X Marker] struct { c X }\n"
			"func probe(cc Consumer[Wrap[Op]]) {}\n"
			"func direct(s @Sink[Op]) {}\n"
			"func main() { _ = 0 }\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "cannot use an opaque type by value")
}

// An instantiation of a generic type over any other underlying type is a named
// type over that underlying, the type args substituted (gen.instantiate.type):
// `Pair[int32]` indexes as a `[2]int32`, `Ptr[int]` dereferences to an int, a
// `List[bool]` element is a bool — and the wrong element type is rejected.
func TestPopulateInstantiatedNonStruct() testing.TestResult {
	var r testing.TestResult = expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Pair[T any] [2]T\ntype Ptr[T any] *T\ntype List[T any] @[]T\n"
							"type Tree[T any] @[]Tree[T]\n"
							"func main() {\n"
							"	var p Pair[int32]\n	var a int32 = p[1]\n"
							"	var x int = 1\n	var q Ptr[int] = &x\n	var b int = *q\n"
							"	var l List[bool] = make_slice(bool, 1)\n	var c bool = l[0]\n"
							"	var t Tree[int] = make_slice(Tree[int], 1)\n	var d int = len(t[0])\n"
							"	_ = a\n	_ = b\n	_ = c\n	_ = d\n"
							"}\n"))
	if len(r) > 0 { return r }
	var c @Checker = checkSrc(
			"package \"test\"\ntype Pair[T any] [2]T\n"
					"func main() { var p Pair[int32]; var b bool = p[0]; _ = b }\n")
	if !anyErrContains(c, "cannot assign") {
		return fail("Pair[int32]'s element is int32, not assignable to bool")
	}
	return ""
}

// A generic type whose underlying type is itself, directly, has no underlying.
func TestPopulateInstantiatedNonStructCyclic() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype A[T any] A[T]\n"
					"func main() { var a A[int]; _ = a }\n")
	if len(c.Errors) == 0 { return fail("type A[T any] A[T] has no underlying type") }
	return ""
}
