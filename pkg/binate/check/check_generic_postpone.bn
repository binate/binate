package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Abstract instances built when code uses them.  An instance whose type
// arguments mention a type parameter (an abstract instance) is needed only by
// code that reads its structure: each generic's own declaration is checked by
// itself (checkGenericDeclAbstract).  Building each one where it is named
// builds, for a chain of distinct generics each naming the next through a
// pointer (`type S1[T any] struct { next *S2[T] }`, …), a copy of the rest of
// the chain for every generic's own parameters — instances quadratic in the
// chain's length, built one inside another — and, where each names the next
// twice (`type A1[T any] struct { a *A2[*T]; b *A2[@T] }`, …), instances
// exponential in it.  So an abstract struct instance named as the element of a
// pointer type while another instance is built, or a signature derived for one
// (postponingHere), is postponed: registered with its
// identity, its structure and methods built when code uses it (ensureMembers:
// a value of its type, or a pointer or slice to it; an assignment to or from
// it; an impl or interface check), when it is named again where it would not
// be postponed, or when a walk of the types a declaration or use forms enters
// it (buildIfPostponed).  An instance held by value, or named as a slice's
// element (whose structure the opaque rule reads), in a function type, an
// array length or a type argument, is built where it is named, so the parts an
// instance holds by value are always built.

// postponingHere reports whether an abstract struct instance named here would
// be postponed: as the element of a pointer type (InstanceState Indirect), while
// another instance is built or a signature derived for one.
func postponingHere(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	return st.Indirect > 0 && (c.GenericInstDepth > 0 || c.DerivingInstanceSig)
}

// postponeHere reports whether the new instance of the generic d with the type
// arguments args is postponed: a struct (or other non-interface) instance whose
// arguments mention a type parameter, not d's own (the declaration's own check
// builds that one), named where an instance is postponed (postponingHere).
func postponeHere(c @Checker, d @ast.Decl, isIface bool, args *[]@types.Type) bool {
	return !isIface && typeListMentionsTypeParam(args) && !argsAreOwnParams(d, args) &&
			postponingHere(c)
}

// enterIndirect starts the resolution (or substitution) of a pointer type's
// element; leaveIndirect ends it.
func enterIndirect(c @Checker) {
	var st @InstanceState = instanceState(c)
	st.Indirect = st.Indirect + 1
}

// leaveIndirect ends what enterIndirect started.
func leaveIndirect(c @Checker) {
	var st @InstanceState = instanceState(c)
	st.Indirect = st.Indirect - 1
}

// enterByValue starts the resolution (or substitution) of a type whose parts
// may be laid out or read where it is formed — a function type, an array
// length, an anonymous struct, a type argument, an instance's own structure —
// so no instance named there is postponed, and returns what leaveByValue
// restores.
func enterByValue(c @Checker) int {
	var st @InstanceState = instanceState(c)
	var saved int = st.Indirect
	st.Indirect = 0
	return saved
}

// leaveByValue ends what enterByValue started.
func leaveByValue(c @Checker, saved int) {
	var st @InstanceState = instanceState(c)
	st.Indirect = saved
}

// postponeInstance postpones the build of the new instance entry, named at at,
// user-facing or not in view, after checking its type arguments against their
// constraints where it is named (checkNewInstanceConstraints).
func postponeInstance(c @Checker, entry @GenericInstantiation, at token.Pos, userFacing bool,
		view ImplView) {
	if userFacing { checkNewInstanceConstraints(c, entry, at, view) }
	entry.Postponed = true
	entry.BuildUserFacing = userFacing
	entry.BuildView = view
	var st @InstanceState = instanceState(c)
	st.Postponed = slices.Append[@GenericInstantiation](st.Postponed, entry)
}

// buildPostponedBase builds the instance t stands for — through aliases,
// `readonly` and named types (peelFieldAccessBase) — if it is postponed.
func buildPostponedBase(c @Checker, t @types.Type) {
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	buildIfPostponed(c, base)
}

// buildIfPostponed builds the instance t, if it is postponed.
func buildIfPostponed(c @Checker, t @types.Type) {
	var entry @GenericInstantiation = postponedEntryOf(c, t)
	if entry != nil { buildPostponed(c, entry) }
}

// postponedEntryOf returns the entry of the instance t when it is postponed,
// else nil.
func postponedEntryOf(c @Checker, t @types.Type) @GenericInstantiation {
	var none @GenericInstantiation
	if c == nil || c.Instances == nil || len(c.Instances.Postponed) == 0 || t == nil ||
			t.Kind != types.TYP_NAMED || t.InstDecl == nil || t.Underlying != nil {
		return none
	}
	var st @InstanceState = c.Instances
	for i := 0; i < len(st.Postponed); i++ {
		if same(st.Postponed[i].Result, t) { return st.Postponed[i] }
	}
	return none
}

// buildPostponed builds the postponed instance entry now, as an instance first
// named here, unless that nests too deeply or spends the build budget: then its
// structure is the error type, the error reported.
func buildPostponed(c @Checker, entry @GenericInstantiation) {
	var st @InstanceState = instanceState(c)
	for i := 0; i < len(st.Postponed); i++ {
		if same(st.Postponed[i], entry) {
			st.Postponed = withoutEntry(st.Postponed, i)
			break
		}
	}
	entry.Postponed = false
	if c.GenericInstDepth >= MAX_BUILD_NESTING {
		errBuildNestedTooDeeply(c, entry.Decl.Pos)
		entry.Result.Underlying = types.TypError()
		return
	}
	if buildBudgetSpent(c, entry.Decl, entry.TypeArgs, entry.NamedAt) {
		entry.Result.Underlying = types.TypError()
		return
	}
	var noWork @InstWork
	buildNewInstance(c, entry, false, entry.NamedAt, entry.BuildUserFacing, entry.BuildView, noWork,
			false)
}
