package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for abstract instances built when code uses them
// (check_generic_postpone.bn).

// branchChainSrc returns a package declaring A1[T] … An[T], each with two
// pointers to the next, over *T and over @T, and f, whose body is body.
func branchChainSrc(n int, body *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	for i := 1; i <= n; i++ {
		b.Write("type A")
		b.Write(strconv.Itoa(i))
		b.Write("[T any] struct { v T")
		if i < n {
			var next @[]char = strconv.Itoa(i + 1)
			b.Write("; a *A")
			b.Write(next)
			b.Write("[*T]; b *A")
			b.Write(next)
			b.Write("[@T]")
		}
		b.Write(" }\n")
	}
	b.Write("func f() {\n")
	b.Write(body)
	b.Write("}\n")
	return b.String()
}

// methodChainSrc returns a package declaring S1[T] … Sn[T], each with a method
// returning a pointer to the next.
func methodChainSrc(n int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	for i := 1; i <= n; i++ {
		var name @[]char = strconv.Itoa(i)
		b.Write("type S")
		b.Write(name)
		b.Write("[T any] struct { v T }\n")
		if i < n {
			b.Write("func (s *S")
			b.Write(name)
			b.Write("[T]) N() *S")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T] { return nil }\n")
		}
	}
	return b.String()
}

// postponedNamed returns how many instances of the generic name are postponed.
func postponedNamed(c @Checker, name *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var e @GenericInstantiation = c.GenericInstantiations[i]
		if e.Postponed && types.CharEq(e.Decl.Name, name) { n = n + 1 }
	}
	return n
}

// A chain of 300 distinct generics each naming the next through a pointer, and
// one of 40 each naming the next twice: the instances each generic's own
// declaration names behind its pointers are not built, so none is built inside
// another and their count does not grow along the chain.
func TestPostponedChainsAccepted() testing.TestResult {
	if len(checkSrc(structChainSrc(300, true, "")).CheckerErrors()) != 0 {
		return fail("expected a chain of 300 generics accepted")
	}
	if len(checkSrc(branchChainSrc(40, "")).CheckerErrors()) != 0 {
		return fail("expected a branching chain of 40 generics accepted")
	}
	return ""
}

// A chain of 300 distinct generics each naming the next in a method's result,
// S1[U] named in a generic function's body: building S1[U] derives its
// methods' signatures from their declarations (resolveFuncDeclType), and the
// instance each names behind a pointer is postponed too, so the chain is not
// built one instance inside another.
func TestPostponedMethodChainAccepted() testing.TestResult {
	var src @[]readonly char = buf.Concat(methodChainSrc(300),
			"func g[U any]() {\n\tvar s S1[U]\n\t_ = s\n}\n")
	if len(checkSrc(src).CheckerErrors()) != 0 {
		return fail("expected a chain of 300 generics through methods accepted")
	}
	return ""
}

// S2[T] and S3[T], one and two pointers down from S1[T], wait unbuilt until a
// method body reads a field through both, and a field missing there is still
// reported.  The declarations' opaque checks build neither: a pointee's own
// parts were judged at its generic's declaration (pointeeEmbedsOpaque).
func TestPostponedBuiltWhenUsed() testing.TestResult {
	var c @Checker = checkSrc(structChainSrc(3, true, ""))
	if postponedNamed(c, "S2") != 1 || postponedNamed(c, "S3") != 1 {
		return fail("expected S2[T] and S3[T], behind S1[T]'s and S2[T]'s pointers, postponed")
	}
	var src @[]readonly char = buf.Concat(structChainSrc(3, true, ""),
			"func (s *S1[T]) F() T { return s.next.next.v }\n")
	if len(checkSrc(src).CheckerErrors()) != 0 {
		return fail("expected S1's method to build the instances it reads through")
	}
	c = checkSrc(
			buf.Concat(structChainSrc(3, true, ""), "func (s *S1[T]) F() T { return s.next.zz }\n"))
	if errorsContaining(c, "zz") != 1 {
		return fail("expected the field S2[T] lacks reported")
	}
	return ""
}

// An instance first named behind a pointer is built where it is named again by
// value — the parts an instance holds by value are always built — and a cycle
// by value through it is still reported.  F's body builds B2[T] (reading a.p.p),
// whose field q names C[T] behind a pointer and r again by value.
func TestPostponedNamedByValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype A[T any] struct { p *B[T] }\ntype B[T any] struct { p *B2[T] }\n"
					"type B2[T any] struct { q *C[T]; r C[T] }\ntype C[T any] struct { x T }\n"
					"func (a *A[T]) F() { _ = a.p.p }\n")
	if len(c.CheckerErrors()) != 0 || postponedNamed(c, "C") != 0 {
		return fail("expected C[T], held by value, built")
	}
	c = checkSrc(
			"package \"test\"\n"
					"type A[T any] struct { p *B[T]; v B[T] }\ntype B[T any] struct { a A[T] }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("expected A and B, each holding the other by value, rejected")
	}
	return ""
}

// A field read through a named pointer type builds the instance it points to:
// List[T] holds Ref[T] by value, whose underlying *Node[T] names Node[T]
// behind a pointer.
func TestPostponedThroughNamedPointer() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Node[T any] struct { v T; next Ref[T] }\n"
							"type Ref[T any] *Node[T]\ntype List[T any] struct { head Ref[T]; n int }\n"
							"func First[T any](l *List[T]) T { return l.head.v }\n"))
}

// namedPointerChainSrc returns a package declaring Opaque and R1[T] … Rn[T],
// each but the last a pointer to the next with the argument arg (`*T` gives
// `type R1[T any] *R2[*T]`), the last a struct holding a T and the fields
// extra.
func namedPointerChainSrc(n int, arg *[]readonly char, extra *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\ntype Opaque\n")
	for i := 1; i < n; i++ {
		b.Write("type R")
		b.Write(strconv.Itoa(i))
		b.Write("[T any] *R")
		b.Write(strconv.Itoa(i + 1))
		b.Write("[")
		b.Write(arg)
		b.Write("]\n")
	}
	b.Write("type R")
	b.Write(strconv.Itoa(n))
	b.Write("[T any] struct { v T")
	b.Write(extra)
	b.Write(" }\n")
	return b.String()
}

// A chain of 300 distinct generics each a pointer to the next: each
// declaration's opaque check stops at the instance it points to, whose own
// parts its generic's declaration judges, so R300[*T], which only R299 names,
// is never built.
func TestPostponedNamedPointerChainAccepted() testing.TestResult {
	var c @Checker = checkSrc(namedPointerChainSrc(300, "*T", ""))
	if len(c.CheckerErrors()) != 0 {
		return fail("expected a chain of 300 named pointer generics accepted")
	}
	if postponedNamed(c, "R300") != 1 {
		return fail("expected R300[*T], behind R299's pointer, postponed")
	}
	if len(checkSrc(namedPointerChainSrc(300, "T", "")).CheckerErrors()) != 0 {
		return fail("expected a chain of 300 named pointer generics over T accepted")
	}
	return ""
}

// Through a chain of named pointer generics, an opaque type argument held by
// value at the end is still reported, and a generic's own opaque field is
// reported at its declaration only, not again at each pointer to it.
func TestPointeeThroughNamedPointerChain() testing.TestResult {
	var c @Checker = checkSrc(
			buf.Concat(namedPointerChainSrc(3, "T", ""), "func f(p R1[Opaque]) {}\n"))
	if errorsContaining(c, "embeds an opaque type by value") == 0 {
		return fail("expected R1[Opaque], pointing to R3[Opaque], reported")
	}
	c = checkSrc(buf.Concat(namedPointerChainSrc(3, "T", "; o Opaque"), "type X R1[int]\n"))
	if len(c.CheckerErrors()) != 1 {
		return fail(
				buf.Concat("expected R3's opaque field reported once; got ",
						strconv.Itoa(len(c.CheckerErrors()))))
	}
	return ""
}
