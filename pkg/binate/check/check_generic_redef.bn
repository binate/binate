package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// A generic function redefined at the REPL prompt (c.AllowRedef) with the same
// signature replaces the one it redefines: the instances the program has of
// that one are emitted again from the new declaration, so that their callers
// run the new body, and the new declaration is checked for each of them.  (One
// with another signature shadows it instead: the old instances' callers keep
// them, and the new declaration is instantiated, and checked, only where it is
// used.)

// replacedGenericFunc returns the generic function declaration that d, a
// function declared at the prompt whose type is ft, replaces — the one its name
// is bound to before d is, with the same signature — or nil.
func replacedGenericFunc(c @Checker, d @ast.Decl, ft @types.Type) @ast.Decl {
	if !c.AllowRedef || len(d.TypeParams) == 0 {
		return nil
	}
	var sym @Symbol = declScope(c).LookupLocal(d.Name)
	if sym == nil || sym.Kind != types.SYM_FUNC {
		return nil
	}
	var prev @ast.Decl = genericFuncDecl(sym.Type)
	if prev == nil || same(prev, d) || !c.SameFuncSignature(sym.Type, ft) {
		return nil
	}
	return prev
}

// instantiateReplaced names generic function d, whose body has just been
// checked with its type parameters abstract, at the type arguments of each
// concrete instance of the declaration it replaces whose body checked: those
// instances' bodies are checked from d too (and an error in one rejects d).
func instantiateReplaced(c @Checker, d @ast.Decl) {
	var home @GenericHome = genericHomeOf(c, d)
	if home == nil || home.Replaces == nil || home.BodyErrs {
		return
	}
	var st @InstanceState = instanceState(c)
	var n int = st.Funcs.Len()
	for i := 0; i < n; i++ {
		var fi @FuncInstance = st.Funcs.Get(i)
		if same(fi.Decl, home.Replaces) && fi.State != nil && fi.State.OK &&
				!typeListMentionsTypeParam(fi.Args) {
			_ = funcInstance(c, d, fi.Args, d.Pos)
		}
	}
}

// SameFuncSignature reports whether a function or method redefined at the
// prompt keeps its signature (see check.bni).
func (c @Checker) SameFuncSignature(oldType @types.Type, newType @types.Type) bool {
	if oldType == nil || newType == nil || len(oldType.TypeParams) != len(newType.TypeParams) {
		return false
	}
	for i := 0; i < len(newType.TypeParams); i++ {
		var oc @types.Type = oldType.TypeParams[i].TpConstraint
		var nc @types.Type = newType.TypeParams[i].TpConstraint
		if (oc == nil) != (nc == nil) ||
				(oc != nil && !substituteTypeParams(c, oc, newType.TypeParams).Identical(nc)) {
			return false
		}
	}
	if len(newType.TypeParams) == 0 {
		return oldType.Identical(newType)
	}
	return substituteTypeParams(c, oldType, newType.TypeParams).Identical(newType)
}
