package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for check_generic_redef.bn: a generic function redefined at the REPL
// prompt.  sessionChecker / replCheckDecl live in check_pending_test.bn,
// toBytes in types_test.bn.

// replDeclChecked parses and checks one declaration at the prompt, returning it.
func replDeclChecked(c @Checker, src *[]readonly char) @ast.Decl {
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
	return d
}

// A redefinition is checked for each instance of the definition it replaces.
func TestReplGenericFuncRedefinitionChecksInstances() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f[T any](x T) T { return x }")
	replCheckDecl(c, "func g() int { return f[int](1) }")
	replCheckDecl(c, "func h() bool { return f[bool](true) }")
	var d @ast.Decl = replDeclChecked(c, "func f[T any](x T) T { var z T; return z }")
	if len(c.CheckerErrors()) != 0 { return fail("the redefinition must check") }
	if len(c.InstanceBodies(d)) != 2 { return fail("f must be checked for f[int] and f[bool]") }
	return ""
}

// A redefinition keeps the signature when its type parameters, renamed or not,
// stand where the old ones did; not when a parameter or a constraint differs.
func TestSameFuncSignatureGeneric() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f[T any](x T) T { return x }")
	var t1 @Symbol = c.Scope.Lookup("f")
	replCheckDecl(c, "func f[U any](y U) U { return y }")
	var t2 @Symbol = c.Scope.Lookup("f")
	if !c.SameFuncSignature(t1.Type, t2.Type) {
		return fail("renamed type parameters keep the signature")
	}
	replCheckDecl(c, "func f[U any](y U, k int) U { return y }")
	var t3 @Symbol = c.Scope.Lookup("f")
	if c.SameFuncSignature(t2.Type, t3.Type) {
		return fail("an added parameter changes the signature")
	}
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "func f[U Sizer](y U, k int) U { return y }")
	var t4 @Symbol = c.Scope.Lookup("f")
	if len(c.CheckerErrors()) != 0 { return fail("the constrained redefinition must check") }
	if c.SameFuncSignature(t3.Type, t4.Type) {
		return fail("another constraint changes the signature")
	}
	return ""
}

// A redefinition with another signature — another constraint, or another
// number of type parameters — shadows the generic function: it is not checked
// for the instances of the one it redefines, so it is accepted though they
// would not satisfy it.
func TestReplGenericFuncShadowNotCheckedAtOldInstances() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "func f[T any](x T) T { return x }")
	replCheckDecl(c, "func g() int { return f[int](1) }")
	var d @ast.Decl = replDeclChecked(c, "func f[T Sizer](x T) int { return x.Size() }")
	if len(c.CheckerErrors()) != 0 { return fail("a constraint change must be accepted") }
	if len(c.InstanceBodies(d)) != 0 { return fail("f must not be checked for f[int]") }
	replCheckDecl(c, "func f[K any, V any](k K, v V) V { return v }")
	if len(c.CheckerErrors()) != 0 || c.IsDeclPending() {
		return fail("a type-parameter count change must be accepted")
	}
	return ""
}

// A constraint naming another of the function's type parameters is compared
// with the type parameters matched by position too.
func TestSameFuncSignatureConstraintOnTypeParam() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Eq[T any] { Same(o T) bool }")
	replCheckDecl(c, "func f1[K any, T Eq[K]](k K, x T) T { return x }")
	replCheckDecl(c, "func f2[A any, B Eq[A]](a A, y B) B { return y }")
	replCheckDecl(c, "func f3[A any, B Eq[int]](a A, y B) B { return y }")
	if len(c.CheckerErrors()) != 0 || c.IsDeclPending() { return fail("f1, f2 and f3 must check") }
	var t1 @Symbol = c.Scope.Lookup("f1")
	var t2 @Symbol = c.Scope.Lookup("f2")
	var t3 @Symbol = c.Scope.Lookup("f3")
	if t1 == nil || t2 == nil || t3 == nil { return fail("f1, f2 and f3 must be declared") }
	if !c.SameFuncSignature(t1.Type, t2.Type) {
		return fail("Eq[K] and Eq[A], each on the first type parameter, are the same constraint")
	}
	if c.SameFuncSignature(t2.Type, t3.Type) { return fail("Eq[A] and Eq[int] differ") }
	return ""
}
