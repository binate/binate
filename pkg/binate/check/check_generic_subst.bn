package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/stdx/slices"

// Substituting type arguments for a generic's type parameters in a type
// (substituteTypeParams) and in a generic function's signature
// (substituteFuncSig).

// substituteTypeParams walks t and replaces TYP_TYPE_PARAM nodes
// with the args[TpIndex] entry.  Composite types (pointer, slice,
// array, interface-value, etc.) are rebuilt with the substituted
// element type.  An instantiated generic struct/interface whose own
// type-arguments mention a type parameter (`Vec[T]`, or the
// interface inside `@Container[T]`) is re-instantiated for the
// substituted arguments (`Vec[int]` / `@Container[int]`) via the
// shared cache, so it becomes the same canonical @types.Type a direct
// mention produces.  Other kinds are returned unchanged.
//
// Assumes every TYP_TYPE_PARAM encountered is owned by the
// generic decl being instantiated — i.e., its TpIndex is a valid
// index into args.  This is true for FUNC types produced by
// resolveFuncDeclType, which only introduces TYP_TYPE_PARAMs from
// its own AST decl.
//
// c is used only to re-instantiate (the InstDecl branch); it may be
// nil when t is known to contain no instantiated generic types
// (e.g. the direct unit tests on the composite-kind walk).  The walk
// is check_subst_walk.bn's (substitute).
func substituteTypeParams(c @Checker, t @types.Type, args @[]@types.Type) @types.Type {
	var s substSpec
	s.args = args
	return substitute(c, t, &s)
}

// substituteFuncSig substitutes args for the type parameters of the generic
// function type ft in its parameters and results.
func substituteFuncSig(c @Checker, ft @types.Type, args @[]@types.Type) @types.Type {
	var newParams @[]@types.Param
	for i := 0; i < len(ft.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = ft.Params[i].Name
		p.Type = substituteTypeParams(c, ft.Params[i].Type, args)
		// Carry variadic-ness through instantiation.  IsVariadic rides the @Param
		// wrapper, not inside .Type, so substituteTypeParams (which rebuilds .Type)
		// does NOT preserve it — a variadic `func f[T](xs ...T)` would instantiate
		// to a fixed-`*[]T` func without this copy.
		p.IsVariadic = ft.Params[i].IsVariadic
		newParams = slices.Append[@types.Param](newParams, p)
	}
	var newResults @[]@types.Type
	for i := 0; i < len(ft.Results); i++ {
		newResults = slices.Append[@types.Type](newResults, substituteTypeParams(c, ft.Results[i], args))
	}
	return types.MakeFuncType(newParams, newResults)
}

// substByValue is enterByValue for substituteTypeParams, whose c may be nil
// (then 0, and nothing to restore).
func substByValue(c @Checker) int {
	if c == nil { return 0 }
	return enterByValue(c)
}
