package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Substituting type arguments for a generic's type parameters in a type
// (substituteTypeParams) and in a generic function's signature
// (substituteFuncSig).

// substituteTypeParams walks t and replaces TYP_TYPE_PARAM nodes
// with the args[TpIndex] entry.  Composite types (pointer, slice,
// array, interface-value, etc.) are rebuilt with the substituted
// element type.  An instantiated generic struct/interface whose own
// type-arguments mention a type parameter (`Vec[T]`, or the
// interface inside `@Container[T]`) is re-instantiated for the
// substituted arguments (`Vec[int]` / `@Container[int]`) via the
// shared cache, so it becomes the same canonical @types.Type a direct
// mention produces.  Other kinds are returned unchanged.
//
// Assumes every TYP_TYPE_PARAM encountered is owned by the
// generic decl being instantiated — i.e., its TpIndex is a valid
// index into args.  This is true for FUNC types produced by
// resolveFuncDeclType, which only introduces TYP_TYPE_PARAMs from
// its own AST decl.
//
// c is used only to re-instantiate (the InstDecl branch); it may be
// nil when t is known to contain no instantiated generic types
// (e.g. the direct unit tests on the composite-kind walk).
func substituteTypeParams(c @Checker, t @types.Type, args @[]@types.Type) @types.Type {
	if t == nil { return nil }
	if t.Kind == types.TYP_TYPE_PARAM {
		if t.TpIndex >= 0 && t.TpIndex < len(args) {
			return args[t.TpIndex]
		}
		return t
	}
	if t.InstDecl != nil {
		var newArgs @[]@types.Type
		var changed bool = false
		for i := 0; i < len(t.InstArgs); i++ {
			var na @types.Type = substituteTypeParams(c, t.InstArgs[i], args)
			if !na.Identical(t.InstArgs[i]) { changed = true }
			newArgs = slices.Append[@types.Type](newArgs, na)
		}
		if !changed { return t }
		var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
		// Re-instantiation during type-param substitution is INTERNAL (an
		// impl-match probe / signature substitution), not a `Name[args]` the user
		// wrote — so userFacing is false: it builds the type's identity but does
		// NOT report a constraint miss (which would blame the generic's decl, a
		// site the user never wrote).  Any real miss is caught at the user-facing
		// site that drove this substitution (the decl-body use, or the concrete
		// instantiation the user wrote).
		return instantiateGenericDeclWithArgs(c, d, t.Kind == types.TYP_INTERFACE, newArgs, d.Pos, false)
	}
	// A `readonly` wrapper (`x readonly T`, `s *[]readonly T`) is rebuilt around
	// its substituted element like any composite; left as is, the `T` under it
	// stays abstract and no argument is assignable to the parameter.
	if t.Kind == types.TYP_READONLY {
		return types.MakeReadonlyType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_POINTER {
		return types.MakePointerType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_SLICE {
		return types.MakeSliceType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		return types.MakeManagedSliceType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_ARRAY {
		// A length that depends on a type parameter stays dependent: its value
		// is known only where the array type is resolved for an instantiation.
		var at @types.Type = types.MakeArrayType(substituteTypeParams(c, t.Elem, args), t.ArrayLen)
		at.ArrayLenDependent = t.ArrayLenDependent
		return at
	}
	// An anonymous struct type (`s struct { a T }`) is rebuilt from its substituted
	// fields.  A named struct's fields cannot mention a type parameter unless the
	// struct is generic, which the InstDecl case above re-instantiates.
	if t.Kind == types.TYP_STRUCT && len(t.Name) == 0 {
		var newFields @[]@types.Field
		for i := 0; i < len(t.Fields); i++ {
			var f @types.Field = make(types.Field)
			f.Name = t.Fields[i].Name
			f.Type = substituteTypeParams(c, t.Fields[i].Type, args)
			newFields = slices.Append[@types.Field](newFields, f)
		}
		return types.MakeStructType("", newFields)
	}
	if t.Kind == types.TYP_INTERFACE_VALUE {
		return types.MakeInterfaceValueType(substituteTypeParams(c, t.Elem, args))
	}
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return types.MakeManagedInterfaceValueType(
				substituteTypeParams(c, t.Elem, args))
	}
	// Function types AND function-VALUE types (`*func(T)` / `@func(T)`) all carry
	// their signature in Params/Results, so a type-param mentioned there must be
	// substituted the same way — recurse into each and rebuild with the matching
	// constructor.  Without the TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE cases a
	// `*func(T)` field/param of a generic decl falls through unchanged, leaving T
	// unresolved (`<unknown>`) at every instantiation.
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		var newParams @[]@types.Param
		for i := 0; i < len(t.Params); i++ {
			var p @types.Param = make(types.Param)
			p.Name = t.Params[i].Name
			p.Type = substituteTypeParams(c, t.Params[i].Type, args)
			p.IsVariadic = t.Params[i].IsVariadic
			newParams = slices.Append[@types.Param](newParams, p)
		}
		var newResults @[]@types.Type
		for i := 0; i < len(t.Results); i++ {
			newResults = slices.Append[@types.Type](newResults, substituteTypeParams(c, t.Results[i], args))
		}
		if t.Kind == types.TYP_FUNC_VALUE {
			return types.MakeFuncValueType(newParams, newResults)
		}
		if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
			return types.MakeManagedFuncValueType(newParams, newResults)
		}
		return types.MakeFuncType(newParams, newResults)
	}
	return t
}

// substituteFuncSig substitutes args for the type parameters of the generic
// function type ft in its parameters and results.
func substituteFuncSig(c @Checker, ft @types.Type, args @[]@types.Type) @types.Type {
	var newParams @[]@types.Param
	for i := 0; i < len(ft.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = ft.Params[i].Name
		p.Type = substituteTypeParams(c, ft.Params[i].Type, args)
		// Carry variadic-ness through instantiation.  IsVariadic rides the @Param
		// wrapper, not inside .Type, so substituteTypeParams (which rebuilds .Type)
		// does NOT preserve it — a variadic `func f[T](xs ...T)` would instantiate
		// to a fixed-`*[]T` func without this copy.
		p.IsVariadic = ft.Params[i].IsVariadic
		newParams = slices.Append[@types.Param](newParams, p)
	}
	var newResults @[]@types.Type
	for i := 0; i < len(ft.Results); i++ {
		newResults = slices.Append[@types.Type](newResults, substituteTypeParams(c, ft.Results[i], args))
	}
	return types.MakeFuncType(newParams, newResults)
}
