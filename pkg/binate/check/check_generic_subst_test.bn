package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// substituteTypeParams — direct unit tests on each composite kind
// ============================================================
//
// End-to-end source paths only exercise TYP_TYPE_PARAM directly
// and TYP_POINTER via `*T`.  Managed pointer / slice / managed-
// slice / array don't have ergonomic source forms reachable from
// instantiateGenericFunc (you can't write `id[@int]` etc. today),
// so we exercise the substitution walk by building @types.Type trees
// directly.

// Helper: build a TYP_TYPE_PARAM with index 0 and a dummy owner.
// Owner identity doesn't matter for substituteTypeParams — it
// indexes purely by TpIndex.
func mkTpZero() @types.Type {
	var owner *uint8 = nil
	return MakeTypeParamType("T", owner, 0, nil)
}

func TestSubstituteTypeParamsBare() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var result @types.Type = substituteTypeParams(nil, mkTpZero(), args)
	if result != types.TypInt() {
		return fail("substituteTypeParams should return TypInt() for T→int")
	}
	return ""
}

func TestSubstituteTypeParamsPointer() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakePointerType(mkTpZero())
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_POINTER {
		return fail("expected TYP_POINTER result")
	}
	if result.Elem != types.TypInt() {
		return fail("expected *int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsManagedPtr() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakeManagedPtrType(mkTpZero())
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_MANAGED_PTR {
		return fail("expected TYP_MANAGED_PTR result")
	}
	if result.Elem != types.TypInt() {
		return fail("expected @int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsSlice() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakeSliceType(mkTpZero())
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_SLICE {
		return fail("expected TYP_SLICE result")
	}
	if result.Elem != types.TypInt() {
		return fail("expected *[]int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsManagedSlice() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakeManagedSliceType(mkTpZero())
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_MANAGED_SLICE {
		return fail("expected TYP_MANAGED_SLICE result")
	}
	if result.Elem != types.TypInt() {
		return fail("expected @[]int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsArray() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakeArrayType(mkTpZero(), 4)
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_ARRAY {
		return fail("expected TYP_ARRAY result")
	}
	if result.Elem != types.TypInt() {
		return fail("expected [4]int element after T→int")
	}
	if result.ArrayLen != 4 {
		return fail("expected ArrayLen preserved")
	}
	return ""
}

// `*[]readonly T`: the walk goes through the `readonly` wrapper, so T is
// substituted under it (`*[]readonly int`), not left abstract.
func TestSubstituteTypeParamsReadonly() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = types.MakeSliceType(types.MakeReadonlyType(mkTpZero()))
	var result @types.Type = substituteTypeParams(nil, t, args)
	if result == nil || result.Kind != types.TYP_SLICE || result.Elem == nil ||
			result.Elem.Kind != types.TYP_READONLY {
		return fail("expected *[]readonly <elem> result")
	}
	if result.Elem.Elem != types.TypInt() {
		return fail("expected *[]readonly int after T→int")
	}
	return ""
}

// An anonymous struct type is rebuilt with its fields substituted, names kept.
func TestSubstituteTypeParamsAnonStruct() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = mkTpZero()
	fields[1] = make(types.Field)
	fields[1].Name = "b"
	fields[1].Type = types.TypBool()
	var result @types.Type = substituteTypeParams(nil, types.MakeStructType("", fields), args)
	if result == nil || result.Kind != types.TYP_STRUCT || len(result.Fields) != 2 {
		return fail("expected a two-field TYP_STRUCT result")
	}
	if result.Fields[0].Type != types.TypInt() || !types.CharEq(result.Fields[0].Name, "a") {
		return fail("expected field a int after T→int")
	}
	if result.Fields[1].Type != types.TypBool() || !types.CharEq(result.Fields[1].Name, "b") {
		return fail("expected field b bool unchanged")
	}
	return ""
}

// Pass-through: substitution on a non-composite, non-TYP_TYPE_PARAM
// type returns the input unchanged.
func TestSubstituteTypeParamsPassThrough() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	if substituteTypeParams(nil, types.TypBool(), args) != types.TypBool() {
		return fail("expected TypBool() pass-through")
	}
	return ""
}
