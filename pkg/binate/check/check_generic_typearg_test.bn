package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Type arguments that name an interface: `*I` is the raw interface value of I
// (type.iface.value-spelling), and a bare interface name is not a type
// (iface.value.spelling).

// `id[*Getter](g)` binds T to the interface value `*Getter`, the type of g.
func TestCheckGenericTypeArgStarInterfaceIsValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var g *Getter; var h *Getter = id[*Getter](g); _ = h }\n")
	return expectNoErrors(c)
}

// `*G[int]` names the interface value of the generic interface instance.
func TestCheckGenericTypeArgStarGenericInterfaceIsValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface G[T any] { Get() T }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var g *G[int]; var h *G[int] = id[*G[int]](g); _ = h }\n")
	return expectNoErrors(c)
}

// `**Getter` is a raw pointer to the interface value, as `**Getter` is in a
// variable's type.
func TestCheckGenericTypeArgPointerToInterfaceValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var g *Getter; var pg **Getter = &g\n"
					" var r **Getter = id[**Getter](pg); _ = r }\n")
	return expectNoErrors(c)
}

// expectOneErrAt checks that c reported exactly one error, at line:col, whose
// message contains needle.
func expectOneErrAt(c @Checker, line int, col int, needle *[]readonly char) testing.TestResult {
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		if len(errs) == 0 { return fail("expected one error, got none") }
		return fail(errs[1].Msg)
	}
	if !charsHaveSub(errs[0].Msg, needle) { return fail(errs[0].Msg) }
	if errs[0].Pos.Line != line || errs[0].Pos.Col != col {
		return fail("error not at the type argument")
	}
	return ""
}

// A bare interface name as a type argument is rejected at the argument, not
// inside the generic it instantiates.
func TestCheckGenericTypeArgBareInterfaceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var g *Getter; var h *Getter = id[Getter](g) }\n")
	return expectOneErrAt(c, 4, 49, "interface name `Getter` is not a type expression")
}

// So is a bare generic interface instance.
func TestCheckGenericTypeArgBareGenericInterfaceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface G[T any] { Get() T }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var g *G[int]; var h *G[int] = id[G[int]](g) }\n")
	return expectOneErrAt(c, 4, 49, "interface name `G` is not a type expression")
}

// expectOneErr checks that c reported exactly one error, whose message contains
// needle.
func expectOneErr(c @Checker, needle *[]readonly char) testing.TestResult {
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		if len(errs) == 0 { return fail("expected one error, got none") }
		return fail(errs[1].Msg)
	}
	if !charsHaveSub(errs[0].Msg, needle) { return fail(errs[0].Msg) }
	return ""
}

// A bare interface type argument for a constrained parameter is reported once,
// not again as a constraint miss.
func TestCheckGenericTypeArgBareInterfaceConstrainedOneError() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"interface Str { S() int }\n"
					"func f[T Str](x T) int { return 0 }\n"
					"func main() { var g *Getter; var n int = f[Getter](g); _ = n }\n")
	return expectOneErr(c, "interface name `Getter` is not a type expression")
}

// `*any` is the universe interface's raw value; bare `any` is not a type.
func TestCheckGenericTypeArgAny() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var a *any; var b *any = id[*any](a); _ = b }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var a *any; var b *any = id[any](a) }\n")
	return expectOneErr(c, "interface name `any` is not a type expression")
}

// An interface value nested in a type argument (`Box[*Getter]`) is the same
// type as in a declaration; a bare interface there is rejected.
func TestCheckGenericTypeArgNestedInterface() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"type Box[T any] struct { v T }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var b Box[*Getter]; var r Box[*Getter] = id[Box[*Getter]](b); _ = r }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"type Box[T any] struct { v T }\n"
					"func id[T any](x T) T { return x }\n"
					"func main() { var b Box[*Getter]; _ = id[Box[Getter]](b) }\n")
	return expectOneErr(c, "interface name `Getter` is not a type expression")
}

// A method expression on a generic type instance binds its type argument the
// same way: `Box[*Getter].Val` takes a `@Box[*Getter]`.
func TestCheckGenericMethodExprInterfaceTypeArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Getter { Get() int }\n"
					"type Box[T any] struct { v T }\n"
					"func (b @Box[T]) Val() T { return b.v }\n"
					"func main() { var f *func(@Box[*Getter]) *Getter = Box[*Getter].Val; _ = f }\n")
	return expectNoErrors(c)
}

// A generic interface's instance is not a type in any type position: a type
// argument spelled as a type, a variable's type, or a type alias.
func TestCheckGenericBareInterfaceInstanceRejected() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{
			"func main() { var s *[]*G[int]; _ = id[*[]G[int]](s) }\n",
			"func main() { var x G[int]; _ = x }\n", "type A = G[int]\n"}
	for i := 0; i < len(srcs); i++ {
		var src @[]char = buf.Concat(
				"package \"test\"\n"
						"interface G[T any] { Get() T }\n"
						"func id[T any](x T) T { return x }\n",
				srcs[i])
		var r testing.TestResult = expectOneErr(checkSrc(src),
				"interface name `G` is not a type expression")
		if len(r) > 0 { return r }
	}
	return ""
}
