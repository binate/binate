package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// A resolution that waits for a layout not built yet -- its layout frame blocked
// (resolutionWaits) -- goes on with the length it could not read as 0, and is
// done again once the layout is built; the instances it names meanwhile may be
// formed from that length -- `Other[[0]uint8]` for `Other[[sizeof(N)]uint8]` --
// and built, they would report errors the program does not have (a division by
// that size) and be checked.  So an instance or generic function instance first
// named there is provisional (provisionalHere): it is built as any is, but what
// its build reports and the checks it queues are held (heldReports), and given
// out when it is named where the resolution is kept -- as the resolution done
// again names each instance it really names (heldNamed).  One formed from the
// length not read is never named so, and what its build found is never
// reported.  A provisional instance first named in the build of another, kept
// (not waiting itself), is a child of it, given out with it: a build done again
// names the instance, not what its build named.  What is resolved meanwhile on
// its own -- a generic's declaration resolved abstractly, a declaration resolved
// on demand: an entry of InstanceState.Naming naming no instance -- is not held
// (pushInstanceNaming), unless a provisional build's own work, its abstract
// instances, method copies, satisfaction probes and function signatures, holds
// again.  A check deferred from a provisional build is held as made there
// (holdAs), and one deferred from a resolution that waits is not made: the
// resolution done again defers its own (the records' Waited).  No constraint
// check is latched (constraintsCheckedIn) while a provisional build holds its
// report: given out or not, a later use makes it again.  Giving out is undone with the
// reports it made when they are dropped (unreleaseSince); the errors it gives out
// are the provisional build's, not of the check they are given out in
// (CheckError.Released, ownErrorsSince).

// A heldReports is what the build of a provisional instance reported (Errors)
// and the checks it queued (Work), with the provisional instances it named
// (Children); Released once given out.
type heldReports struct {
	Errors   @[]CheckError
	Work     @[]@InstWork
	Children @[]@heldReports
	Released bool
}

// holding returns what the provisional build being made holds, unless given
// out, or nil.
func holding(c @Checker) @heldReports {
	var none @heldReports
	if c.Instances == nil {
		return none
	}
	return unreleased(c.Instances.Holding)
}

// resolutionWaits reports whether the resolution being made waits for a layout
// not built yet, to be done again: the innermost layout frame that is not a
// declaration resolved on demand, or one inside it that waited, is blocked -- as
// skipDemand decides.  A resolution made on demand in a frame that waits, and
// kept, does not.
func resolutionWaits(c @Checker) bool {
	if c.Instances == nil {
		return false
	}
	var st @InstanceState = c.Instances
	for i := len(st.Populating) - 1; i >= 0; i-- {
		var f layoutFrame = st.Populating[i]
		if f.Demand {
			if f.Blocked { return true }
		} else if f.Abstract {
			return f.Blocked
		} else {
			return f.Inst != nil && f.Inst.LayoutBlocked
		}
	}
	return false
}

// provisionalHere returns what the build of an instance first named here holds
// when that makes it provisional -- the resolution naming it waits, or a
// provisional build, kept, is being made, whose child it is then -- or nil.
func provisionalHere(c @Checker) @heldReports {
	var none @heldReports
	if resolutionWaits(c) {
		return make(heldReports)
	}
	var cur @heldReports = holding(c)
	if cur == nil {
		return none
	}
	var h @heldReports = make(heldReports)
	addHeldChild(cur, h)
	return h
}

// addHeldChild makes h a child of parent, once.
func addHeldChild(parent @heldReports, h @heldReports) {
	if same(parent, h) {
		return
	}
	for i := 0; i < len(parent.Children); i++ {
		if same(parent.Children[i], h) { return }
	}
	parent.Children = slices.Append[@heldReports](parent.Children, h)
}

// unreleased returns h when it holds what is not given out yet, else nil.
func unreleased(h @heldReports) @heldReports {
	var none @heldReports
	if h == nil || h.Released {
		return none
	}
	return h
}

// beginHolding makes what h holds, unless nil or given out, what the build being
// made holds, until endHolding with the returned value.
func beginHolding(c @Checker, h @heldReports) @heldReports {
	var st @InstanceState = instanceState(c)
	var saved @heldReports = st.Holding
	if unreleased(h) != nil { st.Holding = h }
	return saved
}

// endHolding ends what beginHolding began.
func endHolding(c @Checker, saved @heldReports) {
	instanceState(c).Holding = saved
}

// instanceHeld returns what the provisional build of the instance t holds, or
// nil.
func instanceHeld(c @Checker, t @types.Type) @heldReports {
	var none @heldReports
	if t == nil || t.InstDecl == nil {
		return none
	}
	var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, d, t.InstArgs)
	if entry == nil {
		return none
	}
	return unreleased(entry.Held)
}

// holdReport holds the error e, being reported, while a provisional build is
// being made, and reports whether it did.
func holdReport(c @Checker, e CheckError) bool {
	var h @heldReports = holding(c)
	if h == nil {
		return false
	}
	h.Errors = appendUniqueCheckError(h.Errors, 0, e)
	return true
}

// holdWork holds the check w, being queued, while a provisional build is being
// made, and reports whether it did: it is queued when the build is given out,
// unless queued meanwhile (needsInstanceCheck).
func holdWork(st @InstanceState, w @InstWork) bool {
	if st.Holding == nil {
		return false
	}
	if w.State != nil { w.State.Queued = false }
	st.Holding.Work = slices.Append[@InstWork](st.Holding.Work, w)
	return true
}

// heldNamed records that the instance whose provisional build holds h, if any,
// is named here, and reports whether the naming is in a resolution that waits,
// to be done again: the caller then queues nothing for it.  Named in a
// provisional build, kept, h is a child of it; elsewhere what h holds is given
// out (releaseHeld).
func heldNamed(c @Checker, h @heldReports) bool {
	if unreleased(h) == nil {
		return false
	}
	if resolutionWaits(c) {
		return true
	}
	var cur @heldReports = holding(c)
	if cur != nil {
		addHeldChild(cur, h)
		return false
	}
	releaseHeld(c, h)
	return false
}

// releaseHeld gives out what h holds: its errors are reported, its checks
// queued unless queued meanwhile, and what its children hold given out --
// recorded, to be undone with the reports (unreleaseSince).
func releaseHeld(c @Checker, h @heldReports) {
	var run @heldRelease = make(heldRelease)
	releaseInto(c, h, run)
}

// A heldRelease is what one release (releaseHeld) gave out so far: the text of
// each constraint miss (Misses).
type heldRelease struct {
	Misses @[]@[]char
}

// releaseInto gives out what h holds within the release run: a constraint miss
// with the text of one the run gave out already is the same instantiation's,
// named again in the same build -- a check latched outside a provisional build
// (constraintsCheckedIn) is not in one -- and is given out once.
func releaseInto(c @Checker, h @heldReports, run @heldRelease) {
	if h.Released {
		return
	}
	h.Released = true
	var log @InstanceState = instanceState(c)
	log.Releases = slices.Append[@heldReports](log.Releases, h)
	// A child was first named before the build named it again: its miss, from the
	// first site, goes first.
	for i := 0; i < len(h.Children); i++ {
		releaseInto(c, h.Children[i], run)
	}
	for i := 0; i < len(h.Errors); i++ {
		var e CheckError = h.Errors[i]
		if e.MissDecl != nil && missGivenOut(run, e.Msg) {
			continue
		}
		e.Released = true
		appendReportedError(c, e)
	}
	var st @InstanceState = instanceState(c)
	for i := 0; i < len(h.Work); i++ {
		var w @InstWork = h.Work[i]
		if w.State == nil || needsInstanceCheck(c, w.State) {
			if w.State != nil { w.State.Queued = true }
			pushInstWork(st, w)
		}
	}
}

// missGivenOut reports whether the release run gave out a constraint miss with
// the text msg, and records it given out otherwise.
func missGivenOut(run @heldRelease, msg @[]char) bool {
	for i := 0; i < len(run.Misses); i++ {
		if types.CharEq(run.Misses[i], msg) { return true }
	}
	run.Misses = slices.Append[@[]char](run.Misses, msg)
	return false
}

// heldOr returns h, unless nil or given out, else other.
func heldOr(h @heldReports, other @heldReports) @heldReports {
	if unreleased(h) != nil {
		return h
	}
	return other
}

// ownErrorsSince reports whether errs holds, from from on, an error that is not
// a provisional build's given out (CheckError.Released): one the check that
// began at from reported itself.
func ownErrorsSince(errs @[]CheckError, from int) bool {
	return ownErrorCount(errs, from) > 0
}

// ownErrorCount counts the errors errs holds from from on that are not a
// provisional build's given out (CheckError.Released).
func ownErrorCount(errs @[]CheckError, from int) int {
	var n int = 0
	for i := from; i < len(errs); i++ {
		if !errs[i].Released { n = n + 1 }
	}
	return n
}

// releasesMark returns the count of what was given out so far (releaseHeld),
// for unreleaseSince.
func releasesMark(c @Checker) int {
	if c.Instances == nil {
		return 0
	}
	return len(c.Instances.Releases)
}

// unreleaseSince undoes what was given out since mark (releasesMark), whose
// reports are dropped: it is given out again when named again.  The checks it
// queued stay queued.
func unreleaseSince(c @Checker, mark int) {
	if c.Instances == nil {
		return
	}
	var st @InstanceState = c.Instances
	for i := mark; i < len(st.Releases); i++ {
		st.Releases[i].Released = false
	}
	st.Releases = st.Releases[:mark]
}

// holdAs makes what h holds -- nothing, for nil or given out -- what the build
// being made holds: a deferred check made later is held as where it was
// recorded.  endHolding restores the holding before it.
func holdAs(c @Checker, h @heldReports) {
	instanceState(c).Holding = unreleased(h)
}

// unreleaseParked undoes what was given out since the tentative check of the REPL
// declarations being parked began (InstanceState.TentativeFrom): their
// reports are dropped.
func unreleaseParked(c @Checker) {
	unreleaseSince(c, instanceState(c).TentativeFrom)
}
