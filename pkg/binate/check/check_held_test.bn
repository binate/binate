package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_held.bn: what the build of an instance first named while a
// layout frame waits reports is held, and given out when the program names it
// where nothing waits.

// Box[N]'s build waits for N's layout and names Other[[0]uint8]: its q would
// divide by 0, but what its check finds is never given out.
func TestWaitingBuildHoldsInstanceErrors() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Other[T any] struct { x T }\n"
							"func (o *Other[T]) q() int { return 32 / cast(int, sizeof(T)) }\n"
							"type Box[T any] struct { a *Other[[sizeof(T)]uint8]; t int }\n"
							"type N struct { v int64; p *Box[N] }\n"))
}

// Box's declaration, resolved abstractly, waits for N's layout and names
// Other[[0]uint8]: held as in a build that waits.
func TestWaitingAbstractResolutionHoldsInstanceErrors() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Other[T any] struct { x T }\n"
							"func (o *Other[T]) q() int { return 32 / cast(int, sizeof(T)) }\n"
							"type Box[T any] struct { a *Other[[sizeof(N)]uint8]; t T }\n"
							"type N struct { v int64; p *Box[int] }\n"))
}

// Box[N]'s build names gf[[0]uint8], a generic function instance, whose body
// would divide by 0: its body check is held.
func TestWaitingBuildHoldsFunctionInstanceCheck() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"func gf[T any]() [2]int { var a [2]int; a[0] = 32 / cast(int, sizeof(T)); return a }\n"
							"type Box[T any] struct { a *([len(gf[[sizeof(T)]uint8]())]uint8); t int }\n"
							"type N struct { v int64; p *Box[N] }\n"))
}

// X[int64, int32]'s build waits for Q[int64]'s layout and names I[int64, int32]:
// named again when the build is done again, it gives out the miss its build held,
// J[*Box[int64], int32]'s, found in the provisional build of J it named.
func TestHeldInstanceNamedAgainReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
					"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
					"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
					"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
					"type I[T any, U any] struct { j J[*Box[T], U]; t T }\n"
					"type Q[T any] struct { v T; p *X[T, int32] }\n"
					"type X[T any, U any] struct { a [sizeof(Q[T])]uint8; i I[T, U] }\n"
					"func f() bool { var q Q[int64]; return q.p == nil }\n")
	if !anyErrContains(c, "type argument *Box[int64] does not satisfy constraint Eq[[4]uint8]") {
		return fail("J[*Box[int64], int32]'s miss must be reported")
	}
	return ""
}

// J[*Box[int64], int32], named twice in X[int64, int32]'s build that waits, holds
// its miss from the first naming, and gives it out when the build done again
// names it.
func TestHeldInstanceNamedTwiceReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
					"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
					"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
					"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
					"type Q[T any] struct { v T; p *X[T, int32] }\n"
					"type X[T any, U any] struct { a [sizeof(Q[T])]uint8; j1 J[*Box[T], U]; j2 J[*Box[T], U] }\n"
					"func f() bool { var q Q[int64]; return q.p == nil }\n")
	if !anyErrContains(c, "type argument *Box[int64] does not satisfy constraint Eq[[4]uint8]") {
		return fail("J[*Box[int64], int32]'s miss must be reported")
	}
	return ""
}

// Sub[[8]uint8], first built by a satisfaction probe in X[int64]'s build that
// waits, is built as any instance: Box[int64] satisfies Base through it.
func TestProvisionalInterfaceInstanceUsable() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Base { b() int }\n"
							"interface Sub[T any] : Base { eq(o T) int }\ntype Box[K any] struct { k K }\n"
							"impl *Box[K] : Sub[[sizeof(K)]uint8]\n"
							"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"func (b *Box[K]) b() int { return 7 }\ntype J[A Base] struct { a A }\n"
							"type Q[T any] struct { v T; p *X[T] }\n"
							"type X[T any] struct { a [sizeof(Q[T])]uint8; j1 J[*Box[T]]; j2 J[*Box[T]] }\n"
							"func f() int { var q Q[int64]; _ = q; var bx Box[int64]; var e *Base = &bx; "
							"return e.b() }\n"))
}

// Giving out what a build holds reports its errors and gives out its children's,
// once.
func TestReleaseHeldGivesOutChildren() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n")
	var parent @heldReports = make(heldReports)
	var child @heldReports = make(heldReports)
	var e CheckError
	e.Pos = testPos(1, 1)
	e.Msg = "parent's"
	parent.Errors = appendUniqueCheckError(parent.Errors, 0, e)
	e.Pos = testPos(2, 1)
	e.Msg = "child's"
	child.Errors = appendUniqueCheckError(child.Errors, 0, e)
	addHeldChild(parent, child)
	addHeldChild(parent, child)
	if heldNamed(c, parent) {
		return fail("a naming where nothing waits is no provisional one")
	}
	if !parent.Released || !child.Released {
		return fail("the parent and its child must be given out")
	}
	if countErrsContaining(c, "parent's") != 1 || countErrsContaining(c, "child's") != 1 {
		return fail("each held error is reported once")
	}
	releaseHeld(c, parent)
	if countErrsContaining(c, "child's") != 1 {
		return fail("a build given out is given out once")
	}
	return ""
}

// Box's declaration, resolved abstractly, waits for N's layout and names G[T],
// whose resolution, kept, resolves S on demand: R[int64], named there, is not
// provisional, and its error is reported.
func TestKeptResolutionInWaitingBuildReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype R[T any] struct { y [sizeof(T) - 9]uint8 }\n"
					"type G[T any] struct { a [S]uint8; t T }\ntype Pair[A any, B any] struct { a A; b *B }\n"
					"type Box[T any] struct { o *Pair[[sizeof(N)]uint8, G[T]]; t T }\n"
					"type N struct { v int64; p *Box[int] }\nconst S = sizeof(*R[int64])\n")
	if !anyErrContains(c, "array length is too large (in R[int64]") {
		return fail("R[int64]'s error must be reported")
	}
	return ""
}

// gv's check names R[int64], provisional, which gives out its error: R[int64]'s,
// not gv's, which is not set aside to be checked again.
func TestGivenOutErrorNotTheChecksOwn() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype R[T any] struct { arr [3]uint8; y [sizeof(T) - 9]uint8 }\n"
					"type Pair[A any, B any] struct { a A; b *B }\n"
					"type Box[T any, V any] struct { o *Pair[[sizeof(T)]uint8, R[V]]; t int }\n"
					"type N struct { v int64; p *Box[N, int64]; w [len(gv)]uint8 }\n"
					"var gv = R[int64]{}.arr\n")
	if !anyErrContains(c, "array length is too large (in R[int64]") {
		return fail("R[int64]'s error must be reported")
	}
	if anyErrContains(c, "is needed while the package's types are collected") {
		return fail("gv is checked again cleanly once R[int64]'s error is reported")
	}
	return ""
}

// W[N] is provisional and its own build waits: Other[[0]uint8], named then, is
// no child of it, and is not given out with it.
func TestWaitingProvisionalBuildHoldsItsNames() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Other[T any] struct { x T }\n"
							"func (o *Other[T]) q() int { return 32 / cast(int, sizeof(T)) }\n"
							"type W[T any] struct { a *Other[[sizeof(T)]uint8]; t int }\n"
							"type Pair[A any, B any] struct { a A; b *B }\n"
							"type Box[T any] struct { o *Pair[[sizeof(T)]uint8, W[T]]; t int }\n"
							"type N struct { v int64; p *Box[N] }\n"))
}

// Other[[0]uint8]'s field names J, whose constraint check waits for the
// collection: recorded in Other[[0]uint8]'s provisional build, it is held as
// made there, and never given out.  (B's length is 16, sizeof(N) under LP64,
// written to depend on T so that Other's own check leaves it to its instances.)
func TestDeferredCheckOfProvisionalBuildHeld() testing.TestResult {
	return expectNoErrors(
			checkSrcLP64(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type EqBox[K any] struct { k K }\nimpl *EqBox[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
							"type Other[T any] struct { j *J[*EqBox[T], [sizeof(T) + 16 - sizeof(T)]uint8] }\n"
							"type Box[T any] struct { a *Other[[sizeof(T)]uint8]; t int }\n"
							"type N struct { v int64; p *Box[N] }\n"))
}

// The same check recorded in an abstract provisional build, Other[[0]uint8, T]
// (named by Box[T]'s field), which names no instance: it is held as made there
// when replayed, named first, as a naming of no instance holds nothing.
func TestReplayedCheckOfAbstractProvisionalBuildHeld() testing.TestResult {
	return expectNoErrors(
			checkSrcLP64(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type EqBox[K any] struct { k K }\nimpl *EqBox[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
							"type Other[A any, T any] struct {\n"
							"\tj *J[*EqBox[A], [sizeof(A) + 16 - sizeof(A)]uint8]\n\tt T\n}\n"
							"type Box[T any] struct { a Other[[sizeof(N)]uint8, T]; t T }\n"
							"type N struct { v int64; p *Box[int] }\n"))
}

// A generic alias's target is held as at its use: in the provisional
// I3[[0]uint8, [16]uint8], GA2[Self, U, X]'s arguments are abstract, and its
// target names R[[0]uint8], whose length divides by 0 -- never given out.
func TestAliasTargetInProvisionalBuildHeld() testing.TestResult {
	return expectNoErrors(
			checkSrcLP64(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
							"type R[T any] struct { y [32 / sizeof(T)]uint8 }\n"
							"type P2[A any, B any] struct { a *A; b *B }\n"
							"type GA2[T Eq[[sizeof(U)]uint8], U any, X any] = P2[G[T, X], R[U]]\n"
							"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *GA2[Self, U, X]) int }\n"
							"type Box[T any] struct { a *I3[[sizeof(N)]uint8, [16]uint8]; t T }\n"
							"type N struct { v int64; p *Box[int] }\n"))
}

// A check that waits for a layout in such a target is held as where it was
// recorded when made: in the provisional I3[[0]uint8, Q[int64]], GA3's target
// KK[*EqBox[[0]uint8], Q[int64]] reads sizeof(Q[int64]) while it is built, and its
// check, made once Q[int64] is, would miss Eq[[16]uint8] -- never given out.
func TestDeferredCheckInProvisionalAliasTargetHeld() testing.TestResult {
	return expectNoErrors(
			checkSrcLP64(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type EqBox[K any] struct { k K }\nimpl *EqBox[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"type KK[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
							"type GA3[T Eq[[sizeof(U)]uint8], U any, X any] = KK[*EqBox[U], X]\n"
							"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *GA3[Self, U, X]) int }\n"
							"type Q[T any] struct { v T; p *X[T, int32] }\n"
							"type X[T any, U any] struct {\n"
							"\ta [sizeof(Q[T])]uint8\n\ti *I3[[sizeof(Q[T])]uint8, Q[T]]\n}\n"
							"func f() int { var q Q[int64]; return len(q.p.a) }\n"))
}

// What was given out since a mark is held again when its reports are dropped.
func TestUnreleaseSinceHoldsAgain() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n")
	var h @heldReports = make(heldReports)
	var mark int = releasesMark(c)
	releaseHeld(c, h)
	if !h.Released || releasesMark(c) != mark + 1 {
		return fail("a release is recorded")
	}
	unreleaseSince(c, mark)
	if h.Released || releasesMark(c) != mark {
		return fail("a release since the mark is undone")
	}
	return ""
}

// Box[N]'s build waits for N's layout and names J's instantiation from the length
// it could not read: its constraint check, deferred while N is collected, would
// miss (Eq[[0]uint8]) and is never given out; the build done again defers its
// own, which misses for real (Eq[[8]uint8]).
func TestDeferredCheckInWaitingResolutionNotGivenOut() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
					"type EqBox[K any] struct { k K }\nimpl *EqBox[K] : Eq[[sizeof(K) + 1]uint8]\n"
					"func (b *EqBox[K]) eq(o [sizeof(K) + 1]uint8) int { return len(o) }\n"
					"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
					"type Box[T any] struct { a *J[*EqBox[[sizeof(T)]uint8], "
					"[sizeof(T) + 8 - sizeof(T)]uint8]; t int }\n"
					"type N struct { v int64; p *Box[N] }\n")
	if !anyErrContains(c, "does not satisfy constraint Eq[[8]uint8] (in Box[N]") {
		return fail("Box[N]'s real miss must be reported")
	}
	if anyErrContains(c, "Eq[[0]uint8]") {
		return fail("the check deferred where Box[N]'s build waited is never given out")
	}
	return ""
}

// I[int64, int32], provisional, names J[*Box[int64], int32] twice: the miss is
// held at each site, as no check is latched in a provisional build, and given
// out once.
func TestHeldMissGivenOutOnce() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\ntype Box[K any] struct { k K }\n"
					"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
					"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
					"type J[A Eq[[sizeof(B)]uint8], B any] struct { a A }\n"
					"type I[T any, U any] struct { j J[*Box[T], U]; j2 J[*Box[T], U]; t T }\n"
					"type Q[T any] struct { v T; p *X[T, int32] }\n"
					"type X[T any, U any] struct { a [sizeof(Q[T])]uint8; i I[T, U] }\n"
					"func f() bool { var q Q[int64]; return q.p == nil }\n")
	var misses int = countErrsContaining(c,
			"type argument *Box[int64] does not satisfy constraint Eq[[4]uint8]")
	if misses != 1 {
		return fail("J[*Box[int64], int32]'s miss must be reported once")
	}
	return ""
}
