package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Interface extension (embedding) — parent resolution, validation,
// and full-method-set walking.
//
// Interfaces may extend one or more other interfaces with the
// syntax `interface X : P1, P2 { ... }`.  The new interface's
// method set is the recursive concatenation of each parent's full
// method set plus the interface's own methods.  Every interface of a
// package is defined before any extension clause is resolved, so a parent
// may be declared after its child (decl.order.forward).  The ancestor
// closure is kept acyclic by resolveInterfaceExtension, which rejects a
// parent that would close a cycle — direct self-extension
// (`interface A : A`), a cycle through other interfaces (`A : B` +
// `B : A`), or one across instantiations — before adding the edge.
// Two remaining validation steps live here:
//   - duplicate parents listed in the same `:` clause
//   - same-name methods with different signatures across the
//     ancestor closure (or between an ancestor and the interface
//     itself).

// resolveInterfaceExtension resolves each parent named in
// d.Interfaces, validates it (must be an interface; no duplicates),
// stashes it on iface.Parents, and checks for method-name conflicts
// across the resulting ancestor closure.  Errors are added to c;
// the function fills iface.Parents with whatever resolved cleanly
// so downstream impl checks still see something usable.
func resolveInterfaceExtension(c @Checker, d @ast.Decl, iface @types.Type) {
	resolveInterfaceParents(c, d, iface, true)
}

// resolveInterfaceParents is resolveInterfaceExtension, checking the method
// conflicts only when checkConflicts: an interface instance whose methods wait
// (completeIfaceInstanceMethods) has them checked when they are resolved.
func resolveInterfaceParents(c @Checker, d @ast.Decl, iface @types.Type, checkConflicts bool) {
	if d == nil || iface == nil {
		return
	}
	if len(d.Interfaces) == 0 {
		return
	}

	var parents @[]@types.Type
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var p @types.Type = resolveTypeExprAllowInterface(c, ref)
		if p == nil || isErrType(p) {
			// resolveTypeExprAllowInterface has already reported what is wrong
			// with it ("undefined", or an instance not built: expansionBlocked).
			continue
		}
		if p.Kind != types.TYP_INTERFACE {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(
					"interface extension target must be an interface, got ")
			cb.Write(p.TypeName())
			addCheckError(c, ref.Pos, buf.CopyStr(cb.String()))
			continue
		}
		if p == iface {
			// Self-extension (`interface A : A`) — the smallest cycle.
			// Interfaces are compared by identity (the Type object).
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("interface `")
			cb.Write(d.Name)
			cb.Write("` cannot extend itself")
			addCheckError(c, ref.Pos, buf.CopyStr(cb.String()))
			continue
		}
		if containsTypePtr(c.Generics.IfacePopulating, p) {
			// p is an instantiated generic interface whose own extension
			// clause is still being resolved further up the stack — i.e.
			// an inheritance cycle across distinct instantiations
			// (`interface P[T] : Q[T]` + `interface Q[T] : P[T]`).  Drop
			// the back-edge so the Parents graph stays acyclic (the
			// ancestor-closure walks would otherwise loop), and report it.
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("interface extension cycle: `")
			cb.Write(d.Name)
			cb.Write("` (instantiated) transitively extends itself via `")
			cb.Write(p.Name)
			cb.Write("`")
			addCheckError(c, ref.Pos, buf.CopyStr(cb.String()))
			continue
		}
		if ifaceReaches(p, iface) {
			// p already (transitively) extends iface, so the edge
			// iface → p would close a cycle (`interface A : B` + `interface
			// B : A`, in either declaration order).  Drop it so the Parents
			// graph stays acyclic — the ancestor-closure walks, this check
			// included, rely on that — and report it.  Every edge is checked
			// as it is added, so the graph is acyclic in any resolution order.
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("interface extension cycle: `")
			cb.Write(d.Name)
			cb.Write("` transitively extends itself via `")
			cb.Write(p.Name)
			cb.Write("`")
			addCheckError(c, ref.Pos, buf.CopyStr(cb.String()))
			continue
		}
		// Two parents whose type arguments hold a length that depends on a type
		// parameter are one placeholder instance here (`Tag[[sizeof(U)]uint8]`,
		// `Tag[[sizeof(X)]uint8]`): whether they are the same is for each
		// instance, which resolves them with the lengths (spec gen.mono.check).
		// Nor are two whose type arguments hold an error already reported
		// (`Tag[Undef2], Tag[Undef3]`) a repeat.
		var pv typeVisits
		if containsTypePtr(parents, p) &&
				(holdsDependentLength(p) || mentionsTypeWhere(p, isErrType, &pv)) {
			continue
		}
		if containsTypePtr(parents, p) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("duplicate parent interface `")
			cb.Write(p.Name)
			cb.Write("` in interface ")
			cb.Write(d.Name)
			addCheckError(c, ref.Pos, buf.CopyStr(cb.String()))
			continue
		}
		parents = slices.Append[@types.Type](parents, p)
	}
	iface.Parents = parents

	if !checkConflicts { return }
	if c.CollectingDecls || c.BuildingIfaceScope {
		c.DeferredIfaceConflictDecls = slices.Append[@ast.Decl](c.DeferredIfaceConflictDecls, d)
		c.DeferredIfaceConflictTypes = slices.Append[@types.Type](c.DeferredIfaceConflictTypes, iface)
		return
	}
	checkInterfaceMethodConflicts(c, d, iface)
}

// ifaceReaches reports whether target is from itself or one of from's
// ancestors, by identity — the Parents graph is kept acyclic, so the walk
// terminates.  It takes the ancestors from the work list (typeWalk), each one's
// parents after it, in order.
func ifaceReaches(from @types.Type, target @types.Type) bool {
	var base int = typeWalkBase()
	typeWalkPush(from)
	var found bool = false
	for !found && typeWalkMore(base) {
		var t @types.Type = typeWalkPop()
		if t == target {
			found = true
		} else if t != nil {
			pushParentTypes(t)
		}
	}
	typeWalkEnd(base)
	return found
}

// runDeferredIfaceConflicts runs the method-conflict checks queued since
// position mark (see Checker.DeferredIfaceConflictDecls) — once the batch's
// parent edges all exist — and drops them from the queue.
func runDeferredIfaceConflicts(c @Checker, mark int) {
	for i := mark; i < len(c.DeferredIfaceConflictDecls); i++ {
		checkInterfaceMethodConflicts(c, c.DeferredIfaceConflictDecls[i], c.DeferredIfaceConflictTypes[i])
	}
	c.DeferredIfaceConflictDecls = c.DeferredIfaceConflictDecls[0:mark]
	c.DeferredIfaceConflictTypes = c.DeferredIfaceConflictTypes[0:mark]
}

// containsTypePtr reports whether ts contains the same Type
// pointer as t (identity, not structural equality).
func containsTypePtr(ts @[]@types.Type, t @types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if ts[i] == t {
			return true
		}
	}
	return false
}

// checkInterfaceMethodConflicts walks the ancestor closure plus own
// methods of iface and reports same-name methods with non-matching
// signatures.  Same-name same-signature is allowed (diamond
// inheritance through a common ancestor is harmless).
func checkInterfaceMethodConflicts(c @Checker, d @ast.Decl, iface @types.Type) {
	// Its parents' methods, should one wait for them (ensureMembers).
	for i := 0; i < len(iface.Parents); i++ {
		ensureMembers(c, iface.Parents[i])
	}
	var seen @[]@types.Method
	for i := 0; i < len(iface.Parents); i++ {
		seen = mergeIfaceMethods(c, d.Pos, iface, seen, iface.Parents[i])
	}
	for i := 0; i < len(iface.Methods); i++ {
		seen = appendIfaceMethodWithConflictCheck(c, d.Pos, iface, seen, iface.Methods[i])
	}
}

// mergeIfaceMethods walks parent's full method set (its
// ancestors', then its own) and merges each method into `seen`,
// reporting any same-name signature mismatch through c.  It takes the
// interfaces from a work list (ifaceFrames), each one's parents before its
// own methods; an interface reached by two paths is walked once per path.
func mergeIfaceMethods(c @Checker, pos token.Pos, iface @types.Type, seen @[]@types.Method,
		parent @types.Type) @[]@types.Method {
	var base int = ifaceFramesBase()
	pushIfaceFrame(parent, false)
	for ifaceFrames.Len() > base {
		f, _ := ifaceFrames.Pop()
		var t @types.Type = f.t
		if t == nil || t.Kind != types.TYP_INTERFACE { continue }
		if !f.leave {
			pushIfaceParents(t)
			continue
		}
		for i := 0; i < len(t.Methods); i++ {
			seen = appendIfaceMethodWithConflictCheck(c, pos, iface, seen, t.Methods[i])
		}
	}
	return seen
}

// An ifaceFrame is an interface for a walk of interfaces' parents to look at: on
// entering it (leave false) its parents are pushed, to be walked before it; on
// leaving it (leave true) its own methods are taken.
type ifaceFrame struct {
	t     @types.Type
	leave bool
}

// ifaceFrames holds the frames the interface walks have still to look at, the next
// one last, kept from one walk to the next; a walk starts at its base and leaves the
// list as it found it.
var ifaceFrames @vec.Vec[ifaceFrame]

// ifaceFramesBase returns where a walk starts on ifaceFrames.
func ifaceFramesBase() int {
	if ifaceFrames == nil { ifaceFrames = vec.New[ifaceFrame]() }
	return ifaceFrames.Len()
}

// pushIfaceFrame pushes t for an interface walk to enter, or (leave) to leave.
func pushIfaceFrame(t @types.Type, leave bool) {
	var f ifaceFrame
	f.t = t
	f.leave = leave
	ifaceFrames.Push(f)
}

// pushIfaceParents pushes, on entering the interface t, the frame to leave it and then
// its parents, last first, so they are walked first, in order.
func pushIfaceParents(t @types.Type) {
	pushIfaceFrame(t, true)
	for i := len(t.Parents) - 1; i >= 0; i-- {
		pushIfaceFrame(t.Parents[i], false)
	}
}

// appendIfaceMethodWithConflictCheck adds m to seen if no entry
// with the same name exists; otherwise verifies the existing
// entry's signature matches m's and emits an error if not.
func appendIfaceMethodWithConflictCheck(c @Checker, pos token.Pos, iface @types.Type,
		seen @[]@types.Method, m @types.Method) @[]@types.Method {
	if m == nil { return seen }
	for i := 0; i < len(seen); i++ {
		if types.CharEq(seen[i].Name, m.Name) {
			// Signatures that differ only in a length that depends on a type
			// parameter are compared by each instance (spec gen.mono.check).
			var alike bool = seen[i].FuncType.Identical(m.FuncType) ||
					identicalDeferringDependent(seen[i].FuncType, m.FuncType)
			if !alike || !signaturesMatchStrict(seen[i].FuncType, m.FuncType) {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("conflicting signatures for method `")
				cb.Write(m.Name)
				cb.Write("` in interface ")
				cb.Write(iface.Name)
				cb.Write(" (inherited from multiple parents)")
				addCheckError(c, pos, buf.CopyStr(cb.String()))
			}
			return seen
		}
	}
	return slices.Append[@types.Method](seen, m)
}

// ifaceFullMethods returns the deduped method set for iface in
// the order:
//   for each parent (declaration order):
//     parent's full methods (its parents' first, then its own)
//   own methods
// Methods seen earlier in the walk take precedence (same-name
// duplicates from later positions are skipped).  This matches the
// vtable layout `[any-block][P1 full vtable][P2 full vtable][own]`.
// Signature
// conflicts are caught at decl time by
// checkInterfaceMethodConflicts; here we just dedup.  The walk takes the
// interfaces from a work list (ifaceFrames), each one's parents before its own
// methods, which it appends to the set unless their names are in it -- the order
// merging each parent's own set in turn gives; a parent that is no interface
// gives its methods as they are.
func ifaceFullMethods(iface @types.Type) @[]@types.Method {
	if iface == nil || iface.Kind != types.TYP_INTERFACE {
		return iface.Methods
	}
	var out @[]@types.Method
	var base int = ifaceFramesBase()
	pushIfaceParents(iface)
	for ifaceFrames.Len() > base {
		f, _ := ifaceFrames.Pop()
		var t @types.Type = f.t
		if t == nil { continue }
		if t.Kind != types.TYP_INTERFACE || f.leave {
			out = appendUniqueMethods(out, t.Methods)
		} else {
			pushIfaceParents(t)
		}
	}
	return out
}

// appendUniqueMethods appends each method in src to dst, skipping
// entries whose Name already appears in dst.
func appendUniqueMethods(dst @[]@types.Method, src @[]@types.Method) @[]@types.Method {
	for i := 0; i < len(src); i++ {
		var m @types.Method = src[i]
		if m == nil { continue }
		var found bool = false
		for j := 0; j < len(dst); j++ {
			if types.CharEq(dst[j].Name, m.Name) {
				found = true
				break
			}
		}
		if !found {
			dst = slices.Append[@types.Method](dst, m)
		}
	}
	return dst
}
