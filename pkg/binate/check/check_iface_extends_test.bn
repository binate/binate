package "pkg/binate/check"

import "pkg/binate/token"
import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for interface extension parent resolution and method-set
// propagation (check_iface_extends.bn).

// ============================================================
// Successful extension
// ============================================================

func TestInterfaceExtendSingleParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Closer { Close() }\n")
	cb.Write("interface RC : Closer { Read() int }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestInterfaceExtendMultiParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Reader { Read() int }\n")
	cb.Write("interface Writer { Write() int }\n")
	cb.Write("interface RW : Reader, Writer {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// A parent — plain or generic — may be declared after the interface
// that extends it (decl.order.forward).
func TestInterfaceExtendForwardParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A : B, G[int] { a() }\n")
	cb.Write("interface B { b() }\n")
	cb.Write("interface G[T any] { g() T }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestInterfaceExtendDeep() testing.TestResult {
	// A : Top, B : A, C : B  — three-deep chain, validates clean.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Top { Top() }\n")
	cb.Write("interface A : Top { A() }\n")
	cb.Write("interface B : A { B() }\n")
	cb.Write("interface C : B { C() }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestInterfaceExtendDiamondHarmless() testing.TestResult {
	// D extends both B and C, both of which extend Top.  Top's
	// methods reach D via two paths; the dedup must not flag this.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Top { Top() }\n")
	cb.Write("interface B : Top { B() }\n")
	cb.Write("interface C : Top { C() }\n")
	cb.Write("interface D : B, C {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// ============================================================
// Parents stored on the Type
// ============================================================

func TestInterfaceExtendParentsRecorded() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface P { foo() }\n")
	cb.Write("interface Q { bar() }\n")
	cb.Write("interface X : P, Q {}\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) != 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("X")
	if sym == nil { return "X not in scope" }
	if sym.Type == nil || sym.Type.Kind != types.TYP_INTERFACE {
		return "X is not TYP_INTERFACE"
	}
	if len(sym.Type.Parents) != 2 {
		return "expected 2 parents on X"
	}
	if !types.CharEq(sym.Type.Parents[0].Name, "P") {
		return "expected parent[0] = P"
	}
	if !types.CharEq(sym.Type.Parents[1].Name, "Q") {
		return "expected parent[1] = Q"
	}
	return ""
}

// ifaceFullMethods returns inherited methods, then own ones, each
// interface's parents before it, deduped by name.
func TestInterfaceFullMethodsOrder() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A { a() }\n")
	cb.Write("interface B { b() }\n")
	cb.Write("interface X : A, B { x() }\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) != 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("X")
	if sym == nil { return "X not in scope" }
	var ms @[]@types.Method = ifaceFullMethods(sym.Type)
	if len(ms) != 3 {
		return "expected 3 methods (a, b, x)"
	}
	if !types.CharEq(ms[0].Name, "a") {
		return "expected ms[0] = a"
	}
	if !types.CharEq(ms[1].Name, "b") {
		return "expected ms[1] = b"
	}
	if !types.CharEq(ms[2].Name, "x") {
		return "expected ms[2] = x"
	}
	return ""
}

// ============================================================
// Failure cases
// ============================================================

func TestInterfaceExtendCycleRejected() testing.TestResult {
	// `A : B` + `B : A` — a cycle through another interface, reported
	// (and the back-edge dropped) rather than looping.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A : B { a() }\n")
	cb.Write("interface B : A { b() }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectErrSub(c, "interface extension cycle")
}

func TestInterfaceExtendForwardConflictRejected() testing.TestResult {
	// The parent P is declared after X, and its `foo` conflicts with
	// X's own: the conflict check sees P's methods.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface X : P { foo() }\n")
	cb.Write("interface P { foo() int }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectErrSub(c, "conflicting signatures")
}

func TestInterfaceExtendSelfRejected() testing.TestResult {
	// `interface A : A {}` — A is in scope when its own parents are
	// resolved (pre-defined for self-referential method types), so
	// resolveInterfaceExtension rejects the self-cycle explicitly.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A : A {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// A self-referential interface METHOD — one whose result type is the
// interface itself — must typecheck: the interface symbol is in scope
// while its own method signatures resolve.  In a `.bn`, a checker that
// binds the symbol too late fires "undefined: Node" on `next() @Node` (the
// `.bni` path is unaffected: bni_scope pre-registers interface symbols).
func TestInterfaceSelfReferentialMethod() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Node {\n")
	cb.Write("\tval() int\n")
	cb.Write("\tnext() @Node\n")
	cb.Write("}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestInterfaceExtendNonInterfaceRejected() testing.TestResult {
	// Parent is a struct, not an interface — must error.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type S struct { x int }\n")
	cb.Write("interface A : S {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

func TestInterfaceExtendDuplicateParentRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface P { foo() }\n")
	cb.Write("interface A : P, P {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

func TestInterfaceExtendSignatureConflictRejected() testing.TestResult {
	// Two parents declare same-name method with different signatures.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface P { foo() }\n")
	cb.Write("interface Q { foo() int }\n")
	cb.Write("interface X : P, Q {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Same-name same-signature across parents is harmless.
func TestInterfaceExtendSameSignatureAcrossParentsAllowed() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Top { foo() int }\n")
	cb.Write("interface A : Top {}\n")
	cb.Write("interface B : Top {}\n")
	cb.Write("interface X : A, B {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// A's own foo() int conflicts with C's foo() bool, inherited through B : C —
// with A declared before B, so A's clause resolves before B's: the conflict
// check runs once every parent edge exists.
func TestInterfaceExtendForwardGrandparentConflictRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A : B { foo() int }\n")
	cb.Write("interface B : C {}\n")
	cb.Write("interface C { foo() bool }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectErrSub(c, "conflicting signatures")
}

// An instantiation populated while the package's declarations are collected
// (G[int] in f's signature) is conflict-checked against its whole ancestor
// closure (P : Q), whose edges are resolved later.
func TestInterfaceExtendInstantiatedConflictRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Q { foo() bool }\n")
	cb.Write("interface P : Q {}\n")
	cb.Write("interface G[T any] : P { foo() T }\n")
	cb.Write("func f(x *G[int]) {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectErrSub(c, "conflicting signatures")
}

// ifaceParentWalks returns, in a checker of its own, how many methods the interface
// walks find on iface (ifaceFullMethods, mergeIfaceMethods), and how many errors the
// merge reported.
func ifaceParentWalks(iface @types.Type) (int, int, int) {
	var c @Checker = checkSrc("package \"main\"\n")
	var pos token.Pos
	var none @[]@types.Method
	var full int = len(ifaceFullMethods(iface))
	var merged int = len(mergeIfaceMethods(c, pos, iface, none, iface))
	return full, merged, len(c.CheckerErrors())
}

// A chain of interfaces deepLevels deep, each the next's parent, has the one method the
// last declares, found by both interface walks.
func TestDeepIfaceParentWalks() testing.TestResult {
	var iface @types.Type = ifaceChain(deepLevels, types.TypInt())
	full, merged, errs := ifaceParentWalks(iface)
	for i := 1; i < deepLevels; i++ {
		iface = iface.Parents[0]
	}
	if full != 1 { return fail("ifaceFullMethods finds the one method at the chain's end") }
	if merged != 1 { return fail("mergeIfaceMethods merges the one method at the chain's end") }
	if errs != 0 { return fail("the merge reports no conflict") }
	return ""
}

// Through a diamond -- X : B, C with B and C both extending A -- ifaceFullMethods
// takes each interface's parents before its own methods, each name's first
// occurrence: A's a, B's shared and b, C's c (its `shared` skipped), then X's x.
func TestInterfaceFullMethodsDiamondOrder() testing.TestResult {
	var c @Checker = checkSrcResolved(
			"package \"test\"\n"
					"interface A { a() }\n"
					"interface B : A { shared(); b() }\n"
					"interface C : A { c(); shared() }\n"
					"interface X : B, C { x() }\n")
	if len(c.CheckerErrors()) != 0 { return "unexpected errors" }
	var sym @Symbol = c.Scope.Lookup("X")
	if sym == nil { return "X not in scope" }
	var ms @[]@types.Method = ifaceFullMethods(sym.Type)
	var want @[]*[]readonly char = make_slice(*[]readonly char, 5)
	want[0] = "a"
	want[1] = "shared"
	want[2] = "b"
	want[3] = "c"
	want[4] = "x"
	if len(ms) != len(want) { return "expected 5 methods (a, shared, b, c, x)" }
	for i := 0; i < len(want); i++ {
		if !types.CharEq(ms[i].Name, want[i]) { return "expected a, shared, b, c, x in that order" }
	}
	return ""
}

// ifaceAncestorWalks returns, in a checker of its own, what the ancestor walks answer
// on the chain iface over the interface bottom: whether bottom is reached, whether
// iface descends from an interface outside the chain, how many impl keys its parents
// give, and whether an ancestor has a key none has.
func ifaceAncestorWalks(iface @types.Type, bottom @types.Type) (bool, bool, int, bool) {
	var c @Checker = checkSrc("package \"main\"\n")
	var none @[]@[]char
	var reaches bool = ifaceReaches(iface, bottom)
	var descends bool = isDescendantInterface(iface, types.MakeInterfaceType("main", "Other"))
	var keys int = len(appendParentKeys(c, none, "T", iface))
	return reaches, descends, keys, ifaceHasAncestorKey(c, iface, "Nope")
}

// The ancestor walks go to the end of a chain of interfaces deepLevels deep, each the
// next's parent: its last is reached; no interface outside it is an ancestor; its
// parents, all named I, give one impl key; no ancestor has a key none of them has.
func TestDeepIfaceAncestorWalks() testing.TestResult {
	var iface @types.Type = ifaceChain(deepLevels, types.TypInt())
	var bottom @types.Type = iface
	for i := 1; i < deepLevels; i++ {
		bottom = bottom.Parents[0]
	}
	reaches, descends, keys, hasKey := ifaceAncestorWalks(iface, bottom)
	bottom = nil
	for i := 1; i < deepLevels; i++ {
		iface = iface.Parents[0]
	}
	if !reaches { return fail("the chain's last interface is reached") }
	if descends { return fail("an interface outside the chain is no ancestor") }
	if keys != 1 { return fail("the parents, all named I, give one impl key") }
	if hasKey { return fail("no ancestor has a key none has") }
	return ""
}
