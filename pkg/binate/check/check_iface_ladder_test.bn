package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests of the walks over an interface's ancestors on a ladder of diamonds --
// `I<k> : A<k>, B<k>`, A<k> and B<k> over I<k+1>, each with a method of its own --
// ladderHeight high: walked as a tree, 2^ladderHeight paths, each walk enters each
// interface once.

// ladderHeight is how high the tests' ladders of diamonds are.
const ladderHeight int = 48

// writeLadder writes a ladder of diamonds n high to b, its bottom I<n> with a method m
// of [4]int: top down, or bottom up.
func writeLadder(b @strings.Builder, n int, bottomUp bool) {
	if bottomUp { writeLadderBottom(b, n) }
	for j := 0; j < n; j++ {
		var k int = j
		if bottomUp { k = n - 1 - j }
		var ks @[]char = strconv.Itoa(k)
		var next @[]char = strconv.Itoa(k + 1)
		b.Write("interface I")
		b.Write(ks)
		b.Write(" : A")
		b.Write(ks)
		b.Write(", B")
		b.Write(ks)
		b.Write(" {\n}\ninterface A")
		b.Write(ks)
		b.Write(" : I")
		b.Write(next)
		b.Write(" {\n\ta")
		b.Write(ks)
		b.Write("() int\n}\ninterface B")
		b.Write(ks)
		b.Write(" : I")
		b.Write(next)
		b.Write(" {\n\tb")
		b.Write(ks)
		b.Write("() int\n}\n")
	}
	if !bottomUp { writeLadderBottom(b, n) }
}

// writeLadderBottom writes the bottom of a ladder n high, I<n>, to b.
func writeLadderBottom(b @strings.Builder, n int) {
	b.Write("interface I")
	b.Write(strconv.Itoa(n))
	b.Write(" {\n\tm() [4]int\n}\n")
}

// ladderProgram returns a program declaring a ladder n high (writeLadder), a type T
// implementing its top, and a function using it: upcasts of an *I0 to an *A0, to the
// bottom and to an unrelated U, and calls of the bottom's method and of one none has.
// The upcast to U is on the program's last line but five, the call of nope on its
// last line but one.
func ladderProgram(n int, bottomUp bool) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	writeLadder(b, n, bottomUp)
	b.Write("type T struct {\n\tx int\n}\nfunc (t *T) m() [4]int {\n\tvar r [4]int\n\treturn r\n}\n")
	for k := 0; k < n; k++ {
		b.Write("func (t *T) a")
		b.Write(strconv.Itoa(k))
		b.Write("() int {\n\treturn 1\n}\nfunc (t *T) b")
		b.Write(strconv.Itoa(k))
		b.Write("() int {\n\treturn 2\n}\n")
	}
	b.Write("impl *T : I0\ninterface U {\n\tu() int\n}\n")
	b.Write("func f(t *T) int {\n\tvar i *I0 = t\n\tvar a *A0 = i\n\tvar bot *I")
	b.Write(strconv.Itoa(n))
	b.Write(" = i\n\tvar u *U = i\n\t_ = a\n\t_ = bot\n\t_ = u\n")
	b.Write("\treturn len(i.m()) + i.nope()\n}\n")
	return buf.CopyStr(b.String())
}

// lineCount returns how many lines src has.
func lineCount(src *[]readonly char) int {
	var lines int = 0
	for i := 0; i < len(src); i++ {
		if src[i] == '\n' { lines = lines + 1 }
	}
	return lines
}

// ladderUsesReported returns a failure unless c, which checked ladderProgram's src,
// reported the upcast to U and the call of nope and nothing else.
func ladderUsesReported(c @Checker, src *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	var lines int = lineCount(src)
	if len(errs) != 2 { return errCount(c, 2) }
	if errs[0].Pos.Line != lines - 5 || errs[1].Pos.Line != lines - 1 {
		return fail(buf.Concat("the upcast to U and the call of nope are the errors: ", errs[0].Msg))
	}
	return ""
}

// A ladder declared top down is checked an interface at a time in each walk over an
// interface's ancestors: its method sets, the impl's, the upcasts -- a miss included
// -- and the method calls, a miss included.
func TestIfaceLadderOfDiamonds() testing.TestResult {
	var src @[]char = ladderProgram(ladderHeight, false)
	return ladderUsesReported(checkSrc(src), src)
}

// A ladder declared bottom up, so each extension clause is resolved after its parents'
// -- the parent-cycle check (ifaceReaches) walks each parent's ancestors -- is checked
// the same way.
func TestIfaceLadderOfDiamondsBottomUp() testing.TestResult {
	var src @[]char = ladderProgram(ladderHeight, true)
	return ladderUsesReported(checkSrc(src), src)
}

// A method of the bottom read through the top while the package's declarations are
// collected, before the ladder is (readyIfaceParents), readies each interface once.
func TestIfaceLadderReadWhileCollecting() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nvar V *I0\ntype S struct {\n\tf [len(V.m())]int\n}\n")
	writeLadder(b, ladderHeight, false)
	return expectNoErrors(checkSrc(buf.CopyStr(b.String())))
}

// The same read in a `.bni`, while its declarations are resolved (readyBniIface).
func TestIfaceLadderBniRead() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"foo\"\nvar V *I0\ntype S struct {\n\tf [len(V.m())]int\n}\n")
	writeLadder(b, ladderHeight, false)
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(buf.CopyStr(b.String()))
	c.LoadPackageInterface("foo", f)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// The keys of a ladder's ancestors (appendParentKeys) are each ancestor's once, and a
// key is looked for among them (ifaceHasAncestorKey) an interface at a time.
func TestIfaceLadderParentKeys() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	writeLadder(b, ladderHeight, false)
	var c @Checker = checkSrcResolved(buf.CopyStr(b.String()))
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var topSym @Symbol = c.Scope.Lookup("I0")
	var bottomSym @Symbol = c.Scope.Lookup(buf.Concat("I", strconv.Itoa(ladderHeight)))
	if topSym == nil || bottomSym == nil { return fail("the ladder's top and bottom are declared") }
	var top @types.Type = topSym.Type
	var bottom @types.Type = bottomSym.Type
	var none @[]@[]char
	var keys @[]@[]char = appendParentKeys(c, none, "T", top)
	if len(keys) != 3 * ladderHeight { return fail("each of the ladder's ancestors has one key") }
	if ifaceHasAncestorKey(c, top, "None") { return fail("no ancestor is None") }
	if !ifaceHasAncestorKey(c, top, ifaceKey(c, bottom)) { return fail("the bottom is an ancestor") }
	return ""
}
