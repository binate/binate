package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/vec"

// An interface instance is checked when it is instantiated — its method
// signatures against the size limit (requireMethodSized), the parts of them
// that come from its type arguments against the opaque rules
// (requireIfaceInstanceArgsKept) — and so is a generic alias's use
// (requireAliasArgsKept); a type they reach may be an instance still being
// built: `type N[T any] struct { next *Get[N[T]] }` instantiates Get[N[T]]
// while it resolves N[T]'s fields, before N[T] has its underlying type — and a
// named type with none counts as opaque, so `get() N[T]` would be reported as
// an opaque value.  So while any instantiation is in progress
// (Checker.GenericInstDepth) the checks wait, with the scope and package they
// would have run in, until the outermost one completes, when every instance it
// made is built.

// The kinds of pendingCheck.
const (
	// pendingSizing is an interface method signature's size check
	// (sizeMethodSignature of Ft).
	pendingSizing int = iota
	// pendingIfaceArgs is an interface instance's argument check
	// (requireIfaceInstanceArgsKept of Inst, in View).
	pendingIfaceArgs
	// pendingAliasArgs is a generic alias use's check (requireAliasArgsKept of
	// Decl with Args, in View).
	pendingAliasArgs
)

// A pendingCheck is one deferred check of kind Kind (pendingSizing,
// pendingIfaceArgs, pendingAliasArgs), reported at Pos, made in Scope and
// PkgPath.
type pendingCheck struct {
	Kind    int
	Ft      @types.Type
	Inst    @types.Type
	Decl    @ast.Decl
	Args    @[]@types.Type
	View    ImplView
	Pos     token.Pos
	Scope   @Scope
	PkgPath @[]char
}

// deferUntilBuilt records p, with the scope and package it is made in, to be
// made once the outermost instantiation in progress completes
// (flushPendingChecks), and reports whether one is in progress (otherwise the
// caller makes the check now).
func deferUntilBuilt(c @Checker, p pendingCheck) bool {
	if c.GenericInstDepth == 0 { return false }
	p.Scope = c.Scope
	p.PkgPath = c.curPkgPath
	var st @InstanceState = instanceState(c)
	if st.PendingChecks == nil { st.PendingChecks = vec.New[pendingCheck]() }
	st.PendingChecks.Push(p)
	return true
}

// requireMethodSized holds the instantiated interface method signature ft's
// parameters and results, and its results together, to the size limit,
// reporting at pos, once the instances they name are built (deferUntilBuilt).
func requireMethodSized(c @Checker, ft @types.Type, pos token.Pos) {
	var p pendingCheck
	p.Kind = pendingSizing
	p.Ft = ft
	p.Pos = pos
	if !deferUntilBuilt(c, p) { sizeMethodSignature(c, ft, pos) }
}

// sizeMethodSignature is requireMethodSized's check, made now.
func sizeMethodSignature(c @Checker, ft @types.Type, pos token.Pos) {
	for j := 0; j < len(ft.Params); j++ {
		_ = requireFitting(c, ft.Params[j].Type, pos)
	}
	for j := 0; j < len(ft.Results); j++ {
		_ = requireFitting(c, ft.Results[j], pos)
	}
	requireFittingResults(c, ft.Results, pos)
}

// flushPendingChecks makes the checks deferred while instantiations were in
// progress (deferUntilBuilt), each in the scope and package it was deferred in;
// the caller has just completed the outermost instantiation.  The list is
// detached first: a check that instantiates further completes that
// instantiation, and flushes what it defers, itself.
func flushPendingChecks(c @Checker) {
	var st @InstanceState = instanceState(c)
	var pend @vec.Vec[pendingCheck] = st.PendingChecks
	if pend == nil { return }
	var none @vec.Vec[pendingCheck]
	st.PendingChecks = none
	for i := 0; i < pend.Len(); i++ {
		var p pendingCheck = pend.Get(i)
		var savedScope @Scope = c.Scope
		var savedPkgPath @[]char = c.curPkgPath
		c.Scope = p.Scope
		c.curPkgPath = p.PkgPath
		if p.Kind == pendingSizing {
			sizeMethodSignature(c, p.Ft, p.Pos)
		} else if p.Kind == pendingIfaceArgs {
			requireIfaceInstanceArgsKept(c, p.Inst, p.Pos, p.View)
		} else {
			requireAliasArgsKept(c, p.Decl, p.Args, p.Pos, p.View)
		}
		c.Scope = savedScope
		c.curPkgPath = savedPkgPath
	}
}
