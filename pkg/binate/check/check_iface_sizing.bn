package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"
import "pkg/std/vec"

// An interface instance's method signatures are sized (requireSizedType) when
// it is instantiated, and a type in them may be an instance still being built:
// `type N[T any] struct { next *Get[N[T]] }` instantiates Get[N[T]] while it
// resolves N[T]'s fields, before N[T] has its underlying type — and a named type
// with none counts as opaque, so `get() N[T]` would be reported as an opaque
// value.  So while any instantiation is in progress (Checker.GenericInstDepth)
// the checks wait, with the scope and package they would have run in, until the
// outermost one completes, when every instance it made is built.

// A pendingSizing is one interface method signature's deferred size check: Ft's
// parameters and results, reported at Pos, judged in Scope and PkgPath.
type pendingSizing struct {
	Ft      @types.Type
	Pos     token.Pos
	Scope   @Scope
	PkgPath @[]char
}

// requireMethodSized holds the instantiated interface method signature ft to
// requireSizedType, each parameter and result, and its results together to the
// size limit, reporting at pos: now, or once the outermost instantiation in
// progress completes (flushPendingSizing).
func requireMethodSized(c @Checker, ft @types.Type, pos token.Pos) {
	if c.GenericInstDepth == 0 {
		sizeMethodSignature(c, ft, pos)
		return
	}
	var p pendingSizing
	p.Ft = ft
	p.Pos = pos
	p.Scope = c.Scope
	p.PkgPath = c.curPkgPath
	var st @InstanceState = instanceState(c)
	if st.PendingSizing == nil { st.PendingSizing = vec.New[pendingSizing]() }
	st.PendingSizing.Push(p)
}

// sizeMethodSignature is requireMethodSized's check, made now.
func sizeMethodSignature(c @Checker, ft @types.Type, pos token.Pos) {
	for j := 0; j < len(ft.Params); j++ {
		requireSizedType(c, ft.Params[j].Type, pos)
	}
	for j := 0; j < len(ft.Results); j++ {
		requireSizedType(c, ft.Results[j], pos)
	}
	requireFittingResults(c, ft.Results, pos)
}

// flushPendingSizing makes the size checks deferred while instantiations were
// in progress (requireMethodSized), each in the scope and package it was
// deferred in; the caller has just completed the outermost instantiation.  The
// list is detached first: a check that instantiates further completes that
// instantiation, and flushes what it defers, itself.
func flushPendingSizing(c @Checker) {
	var st @InstanceState = instanceState(c)
	var pend @vec.Vec[pendingSizing] = st.PendingSizing
	if pend == nil { return }
	var none @vec.Vec[pendingSizing]
	st.PendingSizing = none
	for i := 0; i < pend.Len(); i++ {
		var p pendingSizing = pend.Get(i)
		var savedScope @Scope = c.Scope
		var savedPkgPath @[]char = c.curPkgPath
		c.Scope = p.Scope
		c.curPkgPath = p.PkgPath
		sizeMethodSignature(c, p.Ft, p.Pos)
		c.Scope = savedScope
		c.curPkgPath = savedPkgPath
	}
}
