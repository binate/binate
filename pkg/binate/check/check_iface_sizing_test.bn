package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_iface_sizing.bn: an interface instance's method signatures are
// sized once the instances they name are built.

// A generic struct holding an interface over itself is fine: Get[N[T]] is
// instantiated while N[T]'s fields resolve, and its `get() N[T]` is sized once
// N[T] is built — also through a function's local, another generic, a generic
// function and a generic alias.
func TestCheckIfaceSizingAfterInstanceBuilt() testing.TestResult {
	var lib *[]readonly char = "package \"test\"\ninterface Get[T any] { get() T }\n"
			"type N[T any] struct { v T; next *Get[N[T]] }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(lib))
	if len(r) != 0 { return r }
	return expectNoErrors(
			checkSrc(
					buf.Concat(lib,
							"func f() { var x *Get[N[int]]\n\t_ = x\n}\n"
									"type S[T any] struct { g *Get[N[T]] }\n"
									"func G[T any](x *Get[N[T]]) int { return 1 }\n"
									"type L[T any] = *Get[N[T]]\nvar l L[bool]\n")))
}

// An instance that does embed an opaque type by value is still reported once
// built: Get[N[Fwd]]'s `get()` returns N[Fwd], which holds Fwd by value.
func TestCheckIfaceSizingOpaqueRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ninterface Get[T any] { get() T }\n"
							"type N[T any] struct { v T; next *Get[N[T]] }\ntype Fwd\n"
							"func f(g *Get[N[Fwd]]) {}\n"), "cannot use an opaque type by value")
}

// A check deferred while an instance is built still runs once it is: Get[Fwd],
// first instantiated in a function body, is reported at its `get` method.
func TestCheckIfaceSizingDeferredCheckRuns() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] {\n\tget() T\n}\n"
					"func f() {\n\tvar g *Get[Fwd]\n\t_ = g\n}\n").CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == 4 && charsHaveSub(errs[i].Msg, "cannot use an opaque type by value") {
			return ""
		}
	}
	return fail("Get[Fwd]'s get, at line 4, should be reported")
}
