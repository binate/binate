package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_iface_sizing.bn: an interface instance's method signatures are
// sized once the instances they name are built.

// A generic struct holding an interface over itself is fine: Get[N[T]] is
// instantiated while N[T]'s fields resolve, and its `get() N[T]` is sized once
// N[T] is built — also through a function's local, another generic, a generic
// function and a generic alias.
func TestCheckIfaceSizingAfterInstanceBuilt() testing.TestResult {
	var lib *[]readonly char = "package \"test\"\ninterface Get[T any] { get() T }\n"
			"type N[T any] struct { v T; next *Get[N[T]] }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(lib))
	if len(r) != 0 { return r }
	return expectNoErrors(
			checkSrc(
					buf.Concat(lib, "func f() { var x *Get[N[int]]\n\t_ = x\n}\n"
							"type S[T any] struct { g *Get[N[T]] }\n"
							"func G[T any](x *Get[N[T]]) int { return 1 }\n"
							"type L[T any] = *Get[N[T]]\nvar l L[bool]\n")))
}

// An instance that does embed an opaque type by value is still reported once
// built: Get[N[Fwd]]'s `get()` returns N[Fwd], which holds Fwd by value.
func TestCheckIfaceSizingOpaqueRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ninterface Get[T any] { get() T }\n"
							"type N[T any] struct { v T; next *Get[N[T]] }\ntype Fwd\n"
							"func f(g *Get[N[Fwd]]) {}\n"),
			"cannot use an opaque type by value")
}

// A check deferred while an instance is built still runs once it is: Get[Fwd],
// first instantiated in a function body, is reported where it is written.
func TestCheckIfaceSizingDeferredCheckRuns() testing.TestResult {
	var errs @[]CheckError = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] {\n\tget() T\n}\n"
					"func f() {\n\tvar g *Get[Fwd]\n\t_ = g\n}\n").CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == 7 && charsHaveSub(errs[i].Msg, "cannot use an opaque type by value") {
			return ""
		}
	}
	return fail("Get[Fwd], written at line 7, should be reported there")
}

// A generic alias's use is checked once the instances it reaches are built:
// S[T]'s field writes L[S[T]], *Get[S[T]], while S[T] is being built.
func TestCheckIfaceSizingAliasDeferred() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Get[T any] { get() T }\ntype L[T any] = *Get[T]\n"
							"type S[T any] struct { v T; l L[S[T]] }\nvar s S[int]\n"))
}

// An interface method's size limit is checked once the instances it reaches are
// built: Big[uint8], first instantiated in a function body, has a parameter
// that points to an array too large for every target.
func TestCheckIfaceSizingDeferredSizeRuns() testing.TestResult {
	var errs @[]CheckError = checkSrcLP64(
			"package \"test\"\ninterface Big[T any] {\n\tm(p *([1 << 30][1 << 30][1 << 30]T))\n}\n"
					"func f() {\n\tvar b *Big[uint8]\n\t_ = b\n}\n").CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == 3 && charsHaveSub(errs[i].Msg, "type is too large") { return "" }
	}
	return fail("Big[uint8]'s m, at line 3, should be reported too large")
}

// deepAliasChain is how long TestDeepGenericAliasChainReported's chain of generic
// aliases is: nearly twice as many links as a unit-test binary's stack holds when each
// link's checks are made by a flush inside the last link's (about 220), and short of
// the time checking a longer one takes (the instantiation caches are searched
// linearly).
const deepAliasChain int = 400

// genericAliasChainSrc returns a program declaring the generic aliases G0[T] = G1[T],
// ..., G<n-1>[T] = *T, and a variable of type G0[int].
func genericAliasChainSrc(n int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for i := 0; i < n; i++ {
		b.Write("type G")
		b.Write(strconv.Itoa(i))
		b.Write("[T any] = ")
		if i + 1 < n {
			b.Write("G")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T]\n")
		} else {
			b.Write("*T\n")
		}
	}
	b.Write("var x int\nvar p G0[int] = &x\n")
	return buf.CopyStr(b.String())
}

// A chain of generic aliases is a chain of instantiations, each named by the check of
// the one before (requireAliasArgsKept), which is made once the one before is built:
// one MAX_BUILD_NESTING long is accepted, and a longer one is reported as nesting too
// deeply, not followed a flush per link until the stack runs out.
func TestDeepGenericAliasChainReported() testing.TestResult {
	var ok @Checker = checkSrc(genericAliasChainSrc(MAX_BUILD_NESTING))
	if len(ok.CheckerErrors()) != 0 {
		return fail(buf.Concat("at the bound: ", ok.CheckerErrors()[0].Msg))
	}
	var c @Checker = checkSrc(genericAliasChainSrc(deepAliasChain))
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 { return fail("past the bound: no error") }
	for i := 0; i < len(errs); i++ {
		if !streq(errs[i].Msg,
				"generic instantiation nested too deeply (cyclic or unbounded type argument?)") {
			return fail(buf.Concat("past the bound: ", errs[i].Msg))
		}
	}
	return ""
}
