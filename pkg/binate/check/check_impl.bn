package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Impl-declaration type-checking. Parse + collect are handled
// elsewhere; this file adds the
// satisfaction check (does the receiver type actually implement
// every interface method, with compatible signatures and receiver
// kinds?). Codegen (vtables, dispatch through interface values)
// is further out.

// collectImplDecl resolves the receiver type and the interface names,
// records the impl on the checker, and reports basic structural
// errors (interface name doesn't resolve to an interface, receiver
// type fails to resolve): collectImplRecv, then collectImplIfaces.
func collectImplDecl(c @Checker, d @ast.Decl) {
	collectImplIfaces(c, d, collectImplRecv(c, d))
}

// An implCollection is an impl declaration being collected: its record (Rec, nil
// when it is not one), with its receiver resolved, and for a parameterized
// receiver the scope binding the type's parameters (Binders), in which its
// interface list is resolved.
type implCollection struct {
	Rec     @Impl
	Binders @Scope
}

// collectImplRecv records the impl declaration d with its receiver resolved and
// its interface list not yet (collectImplIfaces).  A batch records every impl's
// receiver first (collectBatchImpls): an interface list may name an instance,
// whose view root depends on the receivers of the package's private impls
// (normalizeViewRoot).
func collectImplRecv(c @Checker, d @ast.Decl) implCollection {
	var ic implCollection
	if d == nil || d.Kind != ast.DECL_IMPL {
		return ic
	}

	// A parameterized-receiver impl (`impl *Cursor[T] : Iterator[T]`) binds the
	// type's parameters; handle it separately (gen.impl.generic-recv).
	if receiverBaseInstantiation(d.TypeRef) != nil {
		return collectGenericImplRecv(c, d)
	}

	var recv @types.Type = resolveTypeExpr(c, d.TypeRef)
	if recv == nil { recv = types.TypVoid() }

	var rec @Impl = make(Impl)
	rec.Pos = d.Pos
	rec.RecvType = recv
	// Stamp the DEFINING package's carve-out status now (pass 1 runs under
	// this package's AllowUniverseRecv); the satisfaction pass runs under a
	// possibly-different package's flag, so it must read this, not the live one.
	rec.CarveOut = c.AllowUniverseRecv
	rec.Pkg = buf.CopyStr(c.curPkgPath)
	rec.InBni = declaredInBni(d)
	rec.PrivatePkg = privateImplPkg(c, d)
	recordImpl(c, rec)
	ic.Rec = rec
	return ic
}

// collectImplIfaces resolves the interface list of the impl declaration d, whose
// receiver collectImplRecv recorded as ic, onto its record.
func collectImplIfaces(c @Checker, d @ast.Decl, ic implCollection) {
	if ic.Rec == nil { return }
	var saved @Scope = c.Scope
	if ic.Binders != nil { c.Scope = ic.Binders }
	for i := 0; i < len(d.Interfaces); i++ {
		var t @types.Type = resolveImplInterfaceRef(c, d.Interfaces[i])
		if t != nil {
			ic.Rec.Interfaces = slices.Append[@types.Type](ic.Rec.Interfaces, t)
		}
	}
	c.Scope = saved
}

// resolveImplInterfaceRef resolves a name in the interface-list
// position of an `impl T : ...` clause. The name must denote a
// declared interface (TYP_INTERFACE); anything else is an error.
// Returns nil on error.
func resolveImplInterfaceRef(c @Checker, te @ast.TypeExpr) @types.Type {
	if te == nil { return nil }
	var t @types.Type = resolveTypeExprAllowInterface(c, te)
	if t == nil || t.Kind == types.TYP_VOID || isErrType(t) {
		return nil
	}
	if t.Kind != types.TYP_INTERFACE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected interface name in impl, got ")
		cb.Write(t.TypeName())
		addCheckError(c, te.Pos, buf.CopyStr(cb.String()))
		return nil
	}
	return t
}

// checkAllImplsSatisfaction validates that every collected impl
// actually satisfies the interfaces it claims. For each interface
// method M, the receiver type must have a same-named method with a
// compatible signature (params after the receiver, plus results)
// and a receiver kind reachable from the impl's receiver via the
// existing safe-direction smoothing rules (receiverAssignable), except
// that an impl on a value cannot use a pointer-receiver method
// (receiverTakesAddress).
//
// Runs once per
// type-check pass, after collectDecls has populated c.Impls and
// every named type's method set.
func checkAllImplsSatisfaction(c @Checker) {
	for i := 0; i < len(c.Impls); i++ {
		checkImplSatisfaction(c, c.Impls[i])
	}
}

// checkImplSatisfaction validates a single Impl record (checkImplCoverage)
// and records when that reports an error (Impl.AbstractErrs) — once reported,
// a repeated check's error is dropped as a duplicate, so it is not cleared.
func checkImplSatisfaction(c @Checker, rec @Impl) {
	var before int = len(c.Errors)
	var beforeTentative int = len(c.Repl.TentativeErrors)
	checkImplCoverage(c, rec)
	if rec != nil &&
			(ownErrorsSince(c.Errors, before) || ownErrorsSince(c.Repl.TentativeErrors, beforeTentative)) {
		rec.AbstractErrs = true
	}
}

// checkImplCoverage walks each declared interface of the Impl record rec and
// each of its methods, looking for a matching impl method on the receiver's
// underlying named type.  Reports per-method errors so a multi-missing-method
// impl produces a useful error list instead of failing on the first one.
func checkImplCoverage(c @Checker, rec @Impl) {
	if rec == nil { return }
	var recv @types.Type = rec.RecvType
	// A receiver type already reported (a generic's bare name) is not reported again.
	if recv == nil || isErrType(recv) { return }
	var named @types.Type = recv.ReceiverBaseNamed()
	if named == nil {
		addCheckError(c, rec.Pos, "impl receiver must be (a wrapper around) a named type")
		return
	}
	if !declaredReceiverKindOK(recv) {
		reportReceiverKind(c, rec.Pos, "impl")
		return
	}
	// `Self` is the impl's receiver type (implSelf).  A parameterized-receiver
	// impl checks coverage against the generic type's abstract method set, which
	// lives on its placeholder named type (RecvType's base is the empty
	// instantiation shell — see Impl.Placeholder); its `Self` is the receiver
	// over that shell, the instantiation over the impl's parameters (`*IdS[T]`),
	// which the methods' signatures name.
	var self @types.Type = implSelf(recv)
	if rec.Placeholder != nil {
		named = rec.Placeholder
	}
	// Carve-out gate (§11.10 iface.canonical.carveout): exactly one
	// package, pkg/builtins/lang, may declare impls on the universe
	// primitives (int / float / bool); "no other package may".  A
	// primitive impl whose interface HAS methods is already blocked
	// indirectly (the method-declaration pass's AllowUniverseRecv gate
	// rejects the `func (x int) m()` needed to satisfy it), but an impl
	// of an empty interface reaches no method-declaration check, so gate
	// it here -- mirroring resolveMethodReceiver's AllowUniverseRecv.  Use
	// the impl's OWN stamped CarveOut (its defining package), not the live
	// c.AllowUniverseRecv: c.Impls accumulates across packages, so lang's
	// own primitive impls reach this loop while a NON-lang package is being
	// checked, and the live flag would wrongly reject them.
	if isUniversePrimitive(named) && !rec.CarveOut {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("cannot impl an interface on primitive type ")
		cb.Write(named.TypeName())
		cb.Write(" outside pkg/builtins/lang")
		addCheckError(c, rec.Pos, buf.CopyStr(cb.String()))
		return
	}
	reportRepeatedImplIfaces(c, rec.Pos, recv, rec.Interfaces, true)
	for i := 0; i < len(rec.Interfaces); i++ {
		var iface @types.Type = rec.Interfaces[i]
		if iface == nil { continue }
		checkImplCoversInterface(c, rec, recv, named, self, iface)
	}
}

// reportRepeatedImplIfaces reports, at pos, each interface the impl for recv lists
// again after an identical one (spec iface.impl.unique) -- not one whose type
// arguments hold an error already reported (`Tag[Undef2], Tag[Undef3]` are both
// `Tag[<error>]`).  With deferDependent --
// a parameterized impl's own check -- a repeat that holds an array length that
// depends on its binders is left to each instance (checkInstanceImpls), whose list
// has the lengths (`Tag[[sizeof(K)]uint8], Tag[[8]uint8]` is a repeat for K =
// int64 only).
func reportRepeatedImplIfaces(c @Checker, pos token.Pos, recv @types.Type, ifaces @[]@types.Type,
		deferDependent bool) {
	for i := 1; i < len(ifaces); i++ {
		var v typeVisits
		if ifaces[i] == nil || mentionsTypeWhere(ifaces[i], isErrType, &v) ||
				deferDependent && holdsDependentLength(ifaces[i]) {
			continue
		}
		for j := 0; j < i; j++ {
			if ifaces[j] != nil && ifaces[j].Identical(ifaces[i]) {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("interface ")
				cb.Write(ifaces[i].TypeName())
				cb.Write(" is listed twice in the impl for ")
				cb.Write(recv.TypeName())
				addCheckError(c, pos, buf.CopyStr(cb.String()))
				break
			}
		}
	}
}

// checkImplCoversInterface runs the per-interface satisfaction loop:
// for every method declared on the interface (including methods
// inherited from extended parents),
// the receiver's named type must register a matching method, its signature
// the interface method's with `Self` the type self (implSelf of recv).
func checkImplCoversInterface(c @Checker, rec @Impl, recv @types.Type, named @types.Type,
		self @types.Type, iface @types.Type) {
	ensureMembers(c, iface)
	ensureMembers(c, named)
	var methods @[]@types.Method = ifaceFullMethods(iface)
	for i := 0; i < len(methods); i++ {
		var im @types.Method = methods[i]
		var rm @types.Method = lookupImplMethod(rec, named, im.Name)
		if rm == nil {
			// A REPL impl may name a method not yet declared
			// (noteMissingMethod).
			if !noteMissingMethod(c, rec.Pos, named, im.Name) {
				emitMissingMethodError(c, rec.Pos, named, iface, im)
			}
			continue
		}
		noteMethodUse(c, named, im.Name)
		if !methodSigSatisfies(c, rm.FuncType, im.FuncType, self) {
			emitMethodSigMismatchError(c, rec.Pos, named, iface, im, self)
			continue
		}
		// Receiver-kind compatibility: at dispatch through the
		// interface value, the impl's R-shaped data is passed as
		// rm's declared receiver. Enforce safe-direction smoothing.
		// An impl on a value has no value whose address a call could
		// take, so it cannot use a pointer-receiver method.
		if rm.FuncType != nil && len(rm.FuncType.Params) > 0 {
			var rmRecv @types.Type = rm.FuncType.Params[0].Type
			if !receiverAssignable(recv, rmRecv) {
				emitMethodReceiverMismatchError(c, rec.Pos, named, iface, im, rmRecv)
			} else if receiverTakesAddress(recv, rmRecv) {
				emitValueImplPointerMethodError(c, rec.Pos, named, iface, im)
			}
		}
	}
}

// methodSigSatisfies checks that an impl method's func type matches
// the interface method's func type, ignoring the impl method's
// leading receiver parameter. Both must have the same number of
// non-receiver parameters and results, and each pair must be
// Identical *after* substituting the interface side's `Self` with
// self, the type `Self` stands for in the impl (implSelf).
func methodSigSatisfies(c @Checker, implFt @types.Type, ifaceFt @types.Type,
		self @types.Type) bool {
	if implFt == nil || ifaceFt == nil { return false }
	// Impl has receiver as Params[0]; interface has no receiver.
	var implParams int = len(implFt.Params) - 1
	if implParams < 0 { return false }
	if implParams != len(ifaceFt.Params) { return false }
	if len(implFt.Results) != len(ifaceFt.Results) { return false }
	for i := 0; i < implParams; i++ {
		var expected @types.Type = substituteSelf(c, ifaceFt.Params[i].Type, self)
		if !sigTypeIdenticalStrict(implFt.Params[i + 1].Type, expected) {
			return false
		}
	}
	for i := 0; i < len(implFt.Results); i++ {
		var expected @types.Type = substituteSelf(c, ifaceFt.Results[i], self)
		if !sigTypeIdenticalStrict(implFt.Results[i], expected) {
			return false
		}
	}
	// A variadic impl method satisfies only a variadic interface method, and a
	// fixed one only a fixed one (func.variadic.identity; iface.impl.coverage).
	// funcIsVariadic reads the LAST param — for the impl that is the last user
	// param (the receiver at Params[0] is never variadic), so this compares the
	// two methods' user-facing variadic-ness directly.
	if types.FuncIsVariadic(implFt) != types.FuncIsVariadic(ifaceFt) {
		return false
	}
	return true
}

// emitMissingMethodError reports that the receiver's named type has
// no method matching the named interface method.
func emitMissingMethodError(c @Checker, pos token.Pos, named @types.Type, iface @types.Type,
		im @types.Method) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (missing method `")
	cb.Write(im.Name)
	cb.Write("`)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// emitMethodSigMismatchError reports that the receiver's same-named
// method has the wrong parameter or result types.
func emitMethodSigMismatchError(c @Checker, pos token.Pos, named @types.Type, iface @types.Type,
		im @types.Method, self @types.Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (method `")
	cb.Write(im.Name)
	cb.Write("` has wrong signature")
	// Name what `Self` stands for in the impl when the interface method uses it:
	// the receiver type (`*P` under `impl *P`), not always the named type.
	if self != nil && types.MentionsSelf(im.FuncType) {
		cb.Write("; `Self` is ")
		cb.Write(self.TypeName())
	}
	cb.Write(")")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// emitMethodReceiverMismatchError reports that the receiver's
// matching method has a receiver kind unreachable from the impl's
// declared receiver via safe-direction smoothing.
func emitMethodReceiverMismatchError(c @Checker, pos token.Pos, named @types.Type,
		iface @types.Type, im @types.Method, rmRecv @types.Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (method `")
	cb.Write(im.Name)
	cb.Write(
			"` receiver kind incompatible with impl receiver)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// receiverTakesAddress reports whether a receiver of type src passes as a
// method's receiver of type dst only by taking its address: src a value (`P`,
// `readonly P`), dst a raw pointer (`*P`, `*readonly P`).
func receiverTakesAddress(src @types.Type, dst @types.Type) bool {
	var srcKind int
	var dstKind int
	_, srcKind, _ = receiverShape(src)
	_, dstKind, _ = receiverShape(dst)
	return srcKind == 0 && dstKind == 1
}

// emitValueImplPointerMethodError reports that an impl on a value receiver
// names a method with a pointer receiver for the interface method im
// (iface.impl.coverage).
func emitValueImplPointerMethodError(c @Checker, pos token.Pos, named @types.Type,
		iface @types.Type, im @types.Method) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (method `")
	cb.Write(im.Name)
	cb.Write("` has a pointer receiver, which an impl on a value receiver cannot use)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// Impl records a single `impl T : I1, I2, ...` declaration. The
// receiver type captures the receiver-kind nuance (TYP_POINTER vs
// TYP_MANAGED_PTR vs the bare type, plus const) so that downstream
// satisfaction checks and codegen can route correctly. Each
// interface entry is a TYP_INTERFACE.
//
// CarveOut records whether the DEFINING package was the universe-impl
// carve-out (pkg/builtins/lang) -- stamped at collection time from
// c.AllowUniverseRecv.  c.Impls accumulates across every package, so the
// satisfaction pass (which runs under the CURRENTLY-checked package's
// AllowUniverseRecv) must consult this per-impl flag, not the live one, to
// decide whether an `impl <primitive> : I` is legal (§11.10 carve-out).
type Impl struct {
	Pos        token.Pos
	RecvType   @types.Type
	Interfaces @[]@types.Type
	CarveOut   bool
	// Pkg is the impl's defining package: its impls may bind a method private to
	// it (lookupImplMethod), whatever package the satisfaction pass runs under.
	Pkg @[]char
	// InBni records that the impl is declared in its package's .bni, which, like
	// the rest of the .bni, binds only methods the .bni declares.
	InBni bool
	// PrivatePkg names the package whose .bn alone may use the impl, when it is
	// private to that .bn (privateImplPkg); empty otherwise.
	PrivatePkg @[]char
	// Placeholder is set for a parameterized-receiver impl
	// (`impl *Cursor[T] : Iterator[T]`): the generic type's placeholder named
	// type, which carries the abstract method set. The satisfaction pass looks
	// methods up here (RecvType's ReceiverBaseNamed is the empty instantiation
	// shell). nil for a concrete-receiver impl.
	Placeholder @types.Type
	// AbstractErrs records that checkImplSatisfaction reported an error for
	// this impl; a parameterized impl is then not checked again per instance.
	AbstractErrs bool
	// Decl and Scope are, for a parameterized-receiver impl, its declaration and
	// the scope it was collected in, from which it is resolved again for each
	// instance of its type (resolveImplForArgs); nil otherwise.
	Decl  @ast.Decl
	Scope @Scope
}
