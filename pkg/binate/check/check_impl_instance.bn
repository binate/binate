package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// An impl on a generic type (`impl *Box[K] : Eq[[sizeof(K)]uint8]`) is recorded
// once, its binders abstract (collectGenericImplDecl).  For one of the type's
// instances its receiver and interface list are resolved again from the impl's
// declaration with the binders bound to the instance's type arguments, so that a
// length depending on a binder has the instance's value: substituting the
// arguments into the abstract types (substituteTypeParams) would keep the
// length's placeholder, and the impl would not match the interface instance it
// names for the instance (`Eq[[8]uint8]` for Box[int64]).

// ImplInstance is the impl Impl on a generic type, resolved for one instance of
// the type: its receiver Recv and its interface list Ifaces.  Resolving is set
// while the resolution is in progress.
type ImplInstance struct {
	Impl      @Impl
	Recv      @types.Type
	Ifaces    @[]@types.Type
	Resolving bool
}

// resolveImplForArgs resolves the receiver and the interface list of rec, an
// impl on a generic type, for the type's instance with type arguments args: from
// a copy of rec's declaration, in the scope rec was collected in, with its
// binders bound to args, as the instance's members are resolved (bindInstance,
// before the scope moves to the impl's: the instances the resolution names are
// named in the lender class of the use that asks for it).  It returns them and
// the copy, whose annotations are the instance's.
func resolveImplForArgs(c @Checker, rec @Impl,
		args @[]@types.Type) (@types.Type, @[]@types.Type, @ast.Decl) {
	var d @ast.Decl = ast.CloneDecl(rec.Decl)
	var recvExpr @ast.TypeExpr = d.TypeRef
	var inst @ast.TypeExpr = receiverBaseInstantiation(recvExpr)
	var genDecl @ast.Decl = bit_cast(@ast.Decl, rec.RecvType.ReceiverBaseNamed().InstDecl)
	var savedBound instanceBinding = bindInstance(c, genDecl, args)
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = rec.Pkg
	c.Scope = NewScope(rec.Scope)
	for i := 0; inst != nil && i < len(inst.TypeArgs) && i < len(args); i++ {
		defineType(c.Scope, ast.ReceiverBinderName(inst.TypeArgs[i], i), args[i])
	}
	var recv @types.Type = resolveReceiverWithBinders(c, recvExpr)
	var ifaces @[]@types.Type
	for i := 0; i < len(d.Interfaces); i++ {
		var t @types.Type = resolveImplInterfaceRef(c, d.Interfaces[i])
		if t != nil {
			ifaces = slices.Append[@types.Type](ifaces, t)
		}
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	unbindInstance(c, savedBound)
	return recv, ifaces, d
}

// implInstance returns rec, an impl on a generic type, resolved for the type's
// instance base (resolveImplForArgs) and kept on the instance's cache entry; nil
// when base has no entry, while the same resolution is in progress, or when the
// resolution read a layout not built yet (it is done again at the next use).  It
// is resolved for identity, as a satisfaction probe needs: what the resolution
// reports in the impl's declaration is dropped (dropImplErrorsSince), and the
// constraints of the instantiations it forms are not checked
// (DerivingInstanceSig).  The instance's own check resolves the impl again and
// reports (checkInstanceImpls).
func implInstance(c @Checker, rec @Impl, base @types.Type) @ImplInstance {
	var none @ImplInstance
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c,
			bit_cast(@ast.Decl, base.InstDecl), base.InstArgs)
	if entry == nil {
		return none
	}
	for i := 0; i < len(entry.Impls); i++ {
		if same(entry.Impls[i].Impl, rec) {
			if entry.Impls[i].Resolving { return none }
			return entry.Impls[i]
		}
	}
	var ii @ImplInstance = make(ImplInstance)
	ii.Impl = rec
	ii.Resolving = true
	entry.Impls = slices.Append[@ImplInstance](entry.Impls, ii)
	var mark checkMark = markChecks(c)
	var savedDeriving bool = c.Generics.DerivingInstanceSig
	c.Generics.DerivingInstanceSig = true
	var framed bool = enterDemandFrame(c)
	var recv @types.Type
	var ifaces @[]@types.Type
	recv, ifaces, _ = resolveImplForArgs(c, rec, base.InstArgs)
	ii.Recv = recv
	ii.Ifaces = ifaces
	var waited bool = leaveDemandFrame(c, framed)
	c.Generics.DerivingInstanceSig = savedDeriving
	dropImplErrorsSince(c, mark, rec.Decl)
	ii.Resolving = false
	if waited {
		dropImplInstance(entry, rec)
		return none
	}
	return ii
}

// dropImplErrorsSince drops the errors reported since mark at a position in the
// impl declaration d (inImplDecl): the impl's own for the instance, which the
// instance's impl check reports again.  What the instances the resolution built
// reported in their own declarations stays: they are cached as built, and do not
// report it again.
func dropImplErrorsSince(c @Checker, mark checkMark, d @ast.Decl) {
	if c.Repl.TentativeMode {
		c.Repl.TentativeErrors = errorsOutside(c.Repl.TentativeErrors, mark.Errs, d)
	} else {
		c.Errors = errorsOutside(c.Errors, mark.Errs, d)
	}
}

// errorsOutside returns errs with those from position from on that lie in the
// impl declaration d removed.
func errorsOutside(errs @[]types.CheckError, from int, d @ast.Decl) @[]types.CheckError {
	var n int = from
	for i := from; i < len(errs); i++ {
		if !inImplDecl(errs[i].Pos, d) {
			errs[n] = errs[i]
			n = n + 1
		}
	}
	return errs[:n]
}

// inImplDecl reports whether pos lies in the impl declaration d: from its
// `impl` to the end of its last interface.
func inImplDecl(pos token.Pos, d @ast.Decl) bool {
	if len(d.Interfaces) == 0 || !types.CharEq(pos.File, d.Pos.File) {
		return false
	}
	var end token.Pos = d.Interfaces[len(d.Interfaces) - 1].End
	return !posBefore(pos, d.Pos) && !posBefore(end, pos)
}

// posBefore reports whether a comes before b in their file.
func posBefore(a token.Pos, b token.Pos) bool {
	return a.Line < b.Line || a.Line == b.Line && a.Col < b.Col
}

// dropImplInstance removes rec's resolution from the instance entry's.
func dropImplInstance(entry @GenericInstantiation, rec @Impl) {
	var kept @[]@ImplInstance
	for i := 0; i < len(entry.Impls); i++ {
		if !same(entry.Impls[i].Impl, rec) {
			kept = slices.Append[@ImplInstance](kept, entry.Impls[i])
		}
	}
	entry.Impls = kept
}
