package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_impl_instance.bn: an impl on a generic type resolved for one
// instance of the type, a length that depends on a binder taking its value.

// The impl makes *Box[int64] an Eq[[8]uint8]: an interface value is built from
// it, and the instance's impl check finds its method covering Eq[[8]uint8].
func TestImplInstanceDependentLength() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type Box[K any] struct { k K }\n"
							"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"func f(b *Box[int64]) int { var e *Eq[[8]uint8] = b; return e.eq([8]uint8{}) }\n"))
}

// *Box[int32] is an Eq[[4]uint8], not an Eq[[8]uint8].
func TestImplInstanceDependentLengthMiss() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type Box[K any] struct { k K }\n"
							"impl *Box[K] : Eq[[sizeof(K)]uint8]\n"
							"func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }\n"
							"func f(b *Box[int32]) int { var e *Eq[[8]uint8] = b; return 0 }\n"),
			"cannot assign *Box[int32] to *Eq[[8]uint8]")
}

// What fails only in the impl's list resolved for an instance is reported for
// that instance: 320 does not fit uint8 at Box[int64].
func TestImplInstanceListErrorReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
					"type Box[K any] struct { k K }\n"
					"impl *Box[K] : Eq[[len([...]uint8{cast(uint8, sizeof(K) * 40)})]uint8]\n"
					"func (b *Box[K]) eq(o [1]uint8) int { return 1 }\n"
					"func f(b *Box[int64]) int { var e *Eq[[1]uint8] = b; return e.eq([1]uint8{}) }\n")
	if !anyErrContains(c, "(in the impl for Box[int64]") {
		return fail("the impl's list resolved for Box[int64] must report its error")
	}
	return ""
}
