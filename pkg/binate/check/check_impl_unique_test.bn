package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for a repeated interface in an impl's list (spec iface.impl.unique),
// reportRepeatedImplIfaces in check_impl.bn.

// An interface listed twice is an error, also through an alias; two different
// instances of one generic interface are not a repeat.
func TestImplRepeatedInterface() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Tag[T any] { tag() int }\n"
					"interface Named { name() int }\n"
					"interface NA = Named\n"
					"type C struct { v int }\n"
					"func (c *C) tag() int { return c.v }\n"
					"func (c *C) name() int { return c.v }\n"
					"impl *C : Tag[int], Tag[int64], Named, NA\n")
	if len(c.CheckerErrors()) != 1 ||
			!anyErrContains(c, "interface Named is listed twice in the impl for *C") {
		return "expected Named's repeat, alone"
	}
	return ""
}

// An entry whose type argument is an error already reported is no repeat, in an
// impl's list or an interface's parents: `Tag[Undef2], Tag[Undef3]` are both
// `Tag[<error>]`.
func TestImplRepeatedInterfaceErrorArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface Tag[T any] { tag() int }\n"
					"type D struct { v int }\n"
					"func (d *D) tag() int { return d.v }\n"
					"impl *D : Tag[Undef2], Tag[Undef3]\n"
					"interface X : Tag[Undef4], Tag[Undef5] {}\n")
	if len(c.CheckerErrors()) != 4 || anyErrContains(c, "listed twice") ||
			anyErrContains(c, "duplicate parent") {
		return "expected the four undefined names, alone"
	}
	return ""
}

// A parameterized impl's list is judged for each instance: Tag[K], Tag[int] repeats
// for Box[int] only, and a repeat through a length that depends on K only where
// the lengths agree.
func TestImplRepeatedInterfacePerInstance() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\n"
			"interface Tag[T any] { tag() int }\n"
			"type Box[K any] struct { k K }\n"
			"func (b *Box[K]) tag() int { return 1 }\n"
			"impl *Box[K] : Tag[K], Tag[int]\n"
			"type Box2[K any] struct { k K }\n"
			"func (b *Box2[K]) tag() int { return 2 }\n"
			"impl *Box2[K] : Tag[[sizeof(K)]uint8], Tag[[8]uint8]\n"
	var r testing.TestResult = expectNoErrors(checkSrc(decls))
	if len(r) > 0 { return r }
	var c @Checker = checkSrcLP64(
			buf.Concat(decls,
					"func f() int { var b Box[int]; var b2 Box2[int64]; var b3 Box[int64]; var b4 Box2[int32];\n"
							"\t_ = b; _ = b2; _ = b3; _ = b4; return 0 }\n"))
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c,
					"interface Tag[int] is listed twice in the impl for *Box[int] (in the impl for Box[int]") ||
			!anyErrContains(c, "interface Tag[[8]uint8] is listed twice in the impl for *Box2[int64]") {
		return "expected Box[int]'s and Box2[int64]'s repeats, alone"
	}
	return ""
}
