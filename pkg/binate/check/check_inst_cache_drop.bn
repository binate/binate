package "pkg/binate/check"

import "pkg/std/vec"
import "pkg/stdx/slices"

// Dropping what an undone REPL declaration's check cached.  A parked
// declaration is retried as the same declaration, so the instances its check
// built would otherwise be reused as they were built -- their signatures and
// fields resolved, and checked, while names were still missing, with the
// errors that followed discarded -- and its own abstract resolution skipped: the
// retry would check none of it, and accept, for one, a generic interface whose
// method signatures break a constraint.  A failed retry, which stays parked to
// be retried again, would leave the same.  So undoing a declaration (undoDecl)
// drops every instance its check cached: of generic types, of generic aliases
// and of generic functions (a function instance's signature holds the type
// instances it derives), and the generic declarations it resolved abstractly.

// instCacheMark records how many instances the checker has cached -- of generic
// types and aliases (GenericInstantiations, AliasInstantiations), of generic
// functions (InstanceState.Funcs), abstract ones (InstanceState.Abstracts) --
// and how many generic declarations it has resolved abstractly
// (GenericDeclsResolved).
type instCacheMark struct {
	Insts     int
	Aliases   int
	Funcs     int
	Abstracts int
	Resolved  int
}

// markInstCaches returns the current instCacheMark.
func markInstCaches(c @Checker) instCacheMark {
	var st @InstanceState = instanceState(c)
	var m instCacheMark
	m.Insts = len(c.GenericInstantiations)
	m.Aliases = len(c.AliasInstantiations)
	m.Funcs = st.Funcs.Len()
	m.Abstracts = len(st.Abstracts)
	m.Resolved = len(c.GenericDeclsResolved)
	return m
}

// dropInstCaches drops the instances cached, and the generic declarations
// resolved abstractly, since m.  The check states of the instances that stay
// refer to those of the dropped ones without owning them (InstCheckState's
// Namers and Deps), so those edges are removed first.
func dropInstCaches(c @Checker, m instCacheMark) {
	var st @InstanceState = instanceState(c)
	var dropped @vec.Vec[*InstCheckState] = vec.New[*InstCheckState]()
	for i := m.Insts; i < len(c.GenericInstantiations); i++ {
		noteDroppedState(dropped, c.GenericInstantiations[i].InstState)
	}
	for i := m.Aliases; i < len(c.AliasInstantiations); i++ {
		noteDroppedState(dropped, c.AliasInstantiations[i].InstState)
	}
	for i := m.Funcs; i < st.Funcs.Len(); i++ {
		noteDroppedState(dropped, st.Funcs.Get(i).State)
	}
	if dropped.Len() > 0 {
		for i := 0; i < m.Insts && i < len(c.GenericInstantiations); i++ {
			forgetDroppedStates(c.GenericInstantiations[i].InstState, dropped)
		}
		for i := 0; i < m.Aliases && i < len(c.AliasInstantiations); i++ {
			forgetDroppedStates(c.AliasInstantiations[i].InstState, dropped)
		}
		for i := 0; i < m.Funcs && i < st.Funcs.Len(); i++ {
			forgetDroppedStates(st.Funcs.Get(i).State, dropped)
		}
	}
	if len(c.GenericInstantiations) > m.Insts {
		c.GenericInstantiations = c.GenericInstantiations[:m.Insts]
	}
	var waiting @[]@GenericInstantiation
	for i := 0; i < len(st.Deferred); i++ {
		if instantiationKept(c, st.Deferred[i]) {
			waiting = slices.Append[@GenericInstantiation](waiting, st.Deferred[i])
		}
	}
	st.Deferred = waiting
	var postponed @[]@GenericInstantiation
	for i := 0; i < len(st.Postponed); i++ {
		if instantiationKept(c, st.Postponed[i]) {
			postponed = slices.Append[@GenericInstantiation](postponed, st.Postponed[i])
		}
	}
	st.Postponed = postponed
	if len(c.AliasInstantiations) > m.Aliases {
		c.AliasInstantiations = c.AliasInstantiations[:m.Aliases]
	}
	for st.Funcs.Len() > m.Funcs {
		_, _ = st.Funcs.Pop()
	}
	if len(st.Abstracts) > m.Abstracts {
		st.Abstracts = st.Abstracts[:m.Abstracts]
	}
	if len(c.GenericDeclsResolved) > m.Resolved {
		c.GenericDeclsResolved = c.GenericDeclsResolved[:m.Resolved]
	}
}

// instantiationKept reports whether entry is still among c's instantiations.
func instantiationKept(c @Checker, entry @GenericInstantiation) bool {
	for i := 0; i < len(c.GenericInstantiations); i++ {
		if same(c.GenericInstantiations[i], entry) { return true }
	}
	return false
}

// noteDroppedState adds the states of the instance whose first state is first,
// in each lender class, to the states being dropped.
func noteDroppedState(dropped @vec.Vec[*InstCheckState], first @InstCheckState) {
	var s @InstCheckState = first
	for s != nil {
		dropped.Push(s)
		s = s.Next
	}
}

// forgetDroppedStates removes the states being dropped from the Namers and Deps
// of the states of the instance whose first state is first, in each lender
// class.
func forgetDroppedStates(first @InstCheckState, dropped @vec.Vec[*InstCheckState]) {
	var s @InstCheckState = first
	for s != nil {
		s.Namers = withoutStates(s.Namers, dropped)
		s.Deps = withoutStates(s.Deps, dropped)
		s = s.Next
	}
}

// withoutStates returns the states of list that are not among dropped.
func withoutStates(list @[]*InstCheckState, dropped @vec.Vec[*InstCheckState]) @[]*InstCheckState {
	var out @vec.Vec[*InstCheckState] = vec.New[*InstCheckState]()
	for i := 0; i < len(list); i++ {
		if !stateAmong(list[i], dropped) {
			out.Push(list[i])
		}
	}
	return out.Items()
}

// stateAmong reports whether s is one of states.
func stateAmong(s *InstCheckState, states @vec.Vec[*InstCheckState]) bool {
	for i := 0; i < states.Len(); i++ {
		if same(states.Get(i), s) {
			return true
		}
	}
	return false
}
