package "pkg/binate/check"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for dropInstCaches.

// stateIn reports whether s is one of list.
func stateIn(s *InstCheckState, list *[]*InstCheckState) bool {
	for i := 0; i < len(list); i++ {
		if same(list[i], s) { return true }
	}
	return false
}

// Dropping the instances cached since a mark truncates each list to it and
// removes the edges the instances that stay have to the dropped ones' check
// states, keeping those between the ones that stay.
func TestDropInstCachesForgetsDroppedStates() testing.TestResult {
	var c @Checker = NewChecker()
	var st @InstanceState = instanceState(c)
	var kept @GenericInstantiation = make(GenericInstantiation)
	kept.InstState = make(InstCheckState)
	var keptFn @FuncInstance = make(FuncInstance)
	keptFn.State = make(InstCheckState)
	c.GenericInstantiations = slices.Append[@GenericInstantiation](c.GenericInstantiations, kept)
	st.Funcs.Push(keptFn)
	var m instCacheMark = markInstCaches(c)
	var gone @GenericInstantiation = make(GenericInstantiation)
	gone.InstState = make(InstCheckState)
	var goneFn @FuncInstance = make(FuncInstance)
	goneFn.State = make(InstCheckState)
	c.GenericInstantiations = slices.Append[@GenericInstantiation](c.GenericInstantiations, gone)
	st.Funcs.Push(goneFn)
	addDep(kept.InstState, keptFn.State)
	addDep(kept.InstState, gone.InstState)
	addNamer(keptFn.State, goneFn.State)
	addNamer(keptFn.State, kept.InstState)
	dropInstCaches(c, m)
	if len(c.GenericInstantiations) != 1 || st.Funcs.Len() != 1 {
		return fail("the instances cached since the mark must be dropped")
	}
	var k *InstCheckState = keptFn.State
	var g *InstCheckState = gone.InstState
	if !stateIn(k, kept.InstState.Deps) || stateIn(g, kept.InstState.Deps) {
		return fail("Deps must keep the edge to a kept state and lose the one to a dropped state")
	}
	var ki *InstCheckState = kept.InstState
	var gf *InstCheckState = goneFn.State
	if !stateIn(ki, keptFn.State.Namers) || stateIn(gf, keptFn.State.Namers) {
		return fail("Namers must keep the edge to a kept state and lose the one to a dropped state")
	}
	return ""
}

// Dropping the instances cached since a mark drops the postponed ones among
// them from InstanceState.Postponed, keeping those cached before it.
func TestDropInstCachesForgetsPostponed() testing.TestResult {
	var c @Checker = NewChecker()
	var st @InstanceState = instanceState(c)
	var kept @GenericInstantiation = make(GenericInstantiation)
	kept.Postponed = true
	c.GenericInstantiations = slices.Append[@GenericInstantiation](c.GenericInstantiations, kept)
	st.Postponed = slices.Append[@GenericInstantiation](st.Postponed, kept)
	var m instCacheMark = markInstCaches(c)
	var gone @GenericInstantiation = make(GenericInstantiation)
	gone.Postponed = true
	c.GenericInstantiations = slices.Append[@GenericInstantiation](c.GenericInstantiations, gone)
	st.Postponed = slices.Append[@GenericInstantiation](st.Postponed, gone)
	dropInstCaches(c, m)
	if len(st.Postponed) != 1 || !same(st.Postponed[0], kept) {
		return fail("only the postponed instance cached before the mark must stay postponed")
	}
	return ""
}
