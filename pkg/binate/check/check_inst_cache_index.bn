package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// The instantiation caches, Generics.Instantiations and AliasInstantiations, are
// built through a vec, each list being the vec's live view, and are indexed by
// declaration, so a program making n instantiations neither copies the list n times
// nor searches all of it n times.  The lists are read as lists everywhere; a list
// replaced from outside the builder (a REPL rollback truncates it) has its builder
// and index made again from it at the next use.

// instCacheIndex is the builder of one instantiation cache list and its index:
// Items holds the list's entries, ByDecl each declaration's, in the list's order.
type instCacheIndex struct {
	Items  @vec.Vec[@GenericInstantiation]
	ByDecl @table.Table[@ast.Decl, @vec.Vec[@GenericInstantiation], instanceDeclHasher, instanceDeclEq]
}

// syncedCacheIndex returns ix -- or, when it is not the builder of list (none was
// made yet, or the list was replaced), one made again from list.
func syncedCacheIndex(ix @instCacheIndex, list @[]@GenericInstantiation) @instCacheIndex {
	if ix != nil && same(list, ix.Items.Items()) { return ix }
	var out @instCacheIndex = make(instCacheIndex)
	out.Items = vec.New[@GenericInstantiation]()
	out.ByDecl = table.NewTable[@ast.Decl, @vec.Vec[@GenericInstantiation], instanceDeclHasher,
			instanceDeclEq](instanceDeclHasher{}, instanceDeclEq{})
	for i := 0; i < len(list); i++ { pushCacheEntry(out, list[i]) }
	return out
}

// pushCacheEntry appends e to ix's list and to its declaration's entries.
func pushCacheEntry(ix @instCacheIndex, e @GenericInstantiation) {
	ix.Items.Push(e)
	if e == nil || e.Decl == nil { return }
	var es @vec.Vec[@GenericInstantiation]
	var have bool
	es, have = ix.ByDecl.Get(e.Decl)
	if !have {
		es = vec.New[@GenericInstantiation]()
		ix.ByDecl.Put(e.Decl, es)
	}
	es.Push(e)
}

// addInstantiation appends e to Generics.Instantiations.
func addInstantiation(c @Checker, e @GenericInstantiation) {
	c.Generics.InstsIndex = syncedCacheIndex(c.Generics.InstsIndex, c.Generics.Instantiations)
	pushCacheEntry(c.Generics.InstsIndex, e)
	c.Generics.Instantiations = c.Generics.InstsIndex.Items.Items()
}

// addAliasInstantiation appends e to Generics.AliasInstantiations.
func addAliasInstantiation(c @Checker, e @GenericInstantiation) {
	c.Generics.AliasInstsIndex = syncedCacheIndex(c.Generics.AliasInstsIndex,
			c.Generics.AliasInstantiations)
	pushCacheEntry(c.Generics.AliasInstsIndex, e)
	c.Generics.AliasInstantiations = c.Generics.AliasInstsIndex.Items.Items()
}

// declInstantiations returns the entries of Generics.Instantiations of declaration
// d, in the list's order.
func declInstantiations(c @Checker, d @ast.Decl) @[]@GenericInstantiation {
	c.Generics.InstsIndex = syncedCacheIndex(c.Generics.InstsIndex, c.Generics.Instantiations)
	return declEntries(c.Generics.InstsIndex, d)
}

// declAliasInstantiations returns the entries of Generics.AliasInstantiations of
// declaration d, in the list's order.
func declAliasInstantiations(c @Checker, d @ast.Decl) @[]@GenericInstantiation {
	c.Generics.AliasInstsIndex = syncedCacheIndex(c.Generics.AliasInstsIndex,
			c.Generics.AliasInstantiations)
	return declEntries(c.Generics.AliasInstsIndex, d)
}

// declEntries returns ix's entries of declaration d.
func declEntries(ix @instCacheIndex, d @ast.Decl) @[]@GenericInstantiation {
	var none @[]@GenericInstantiation
	if d == nil { return none }
	var es @vec.Vec[@GenericInstantiation]
	var have bool
	es, have = ix.ByDecl.Get(d)
	if !have { return none }
	return es.Items()
}
