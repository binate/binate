package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the instantiation caches' builder and index (check_inst_cache_index.bn).

// cacheEntry returns a cache entry of declaration d.
func cacheEntry(d @ast.Decl) @GenericInstantiation {
	var e @GenericInstantiation = make(GenericInstantiation)
	e.Decl = d
	return e
}

// Each declaration's entries are found in the list's order, the list holding them
// all; a list truncated from outside (a REPL rollback) is indexed again from what is
// left, and appending goes on from there.  The alias cache is its own.
func TestInstCacheIndexByDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var d1 @ast.Decl = make(ast.Decl)
	var d2 @ast.Decl = make(ast.Decl)
	var a @GenericInstantiation = cacheEntry(d1)
	var b @GenericInstantiation = cacheEntry(d2)
	var e @GenericInstantiation = cacheEntry(d1)
	addInstantiation(c, a)
	addInstantiation(c, b)
	addInstantiation(c, e)
	if len(c.Generics.Instantiations) != 3 || !same(c.Generics.Instantiations[2], e) {
		return fail("the list holds every entry, in order")
	}
	var of1 @[]@GenericInstantiation = declInstantiations(c, d1)
	if len(of1) != 2 || !same(of1[0], a) || !same(of1[1], e) {
		return fail("d1's entries, in order")
	}
	if len(declAliasInstantiations(c, d1)) != 0 { return fail("the alias cache is its own") }
	c.Generics.Instantiations = c.Generics.Instantiations[:1]
	if len(declInstantiations(c, d1)) != 1 || len(declInstantiations(c, d2)) != 0 {
		return fail("a truncated list is indexed again")
	}
	addInstantiation(c, b)
	if len(c.Generics.Instantiations) != 2 || len(declInstantiations(c, d2)) != 1 {
		return fail("appending goes on from the truncated list")
	}
	addAliasInstantiation(c, e)
	if len(declAliasInstantiations(c, d1)) != 1 || len(c.Generics.AliasInstantiations) != 1 {
		return fail("the alias cache holds its entry")
	}
	return ""
}
