package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// Each instantiation's body checked (spec gen.mono.check): a generic function
// instance, and each method of a generic struct instance, has its body checked
// with its type parameters bound to the concrete type arguments — on its own
// copy of the declaration, so what the check records on the AST belongs to that
// instance — which decides what depends on a type parameter (a length or size
// computed from it, and the array identity, literal counts and sizes that
// depend on those).  Instances are queued as they are named (enqueueFuncWork,
// enqueueTypeWork) and checked when the package's own checking is done
// (drainInstances); an instance named inside another's body is queued in turn,
// so the chain from an instantiation the program writes is followed to its end,
// and an instance whose shortest chain is longer than MAX_INSTANCE_DEPTH is
// reported (gen.mono.instances, check_instance_drain.bn).  A generic whose
// abstract body check reported an error, or whose body this compilation did not
// check (an interface-only import), is not checked per instance.

// MAX_INSTANCE_DEPTH bounds the shortest chain of instances to an instance, each
// named from the previous one, from one the program writes (spec §21.4: at
// least 128).
const MAX_INSTANCE_DEPTH int = 128

// InstWork is one instance to check: a generic function Decl with its type
// arguments, or the methods of the generic struct TypeDecl instantiated with
// them.  Site is where it was named, Label its name for messages (`F[int64]`),
// Parent the instance that named it on the shortest chain to it found so far
// (nil for one the program writes), Depth the length of that chain (both
// lowered when a shorter chain turns up: relaxInstanceDepths), State the
// instance's check, Lenders its state's lender class
// (check_instance_lenders.bn), ChainRoot its state's chain root
// (chain_root.bn), VRoot its state's view root (impl_view_root.bn), and
// DepFailed set when its check named an instance whose check failed.
type InstWork struct {
	Decl      @ast.Decl
	TypeDecl  @ast.Decl
	Args      @[]@types.Type
	Site      token.Pos
	Label     @[]char
	Parent    @InstWork
	Depth     int
	State     @InstCheckState
	Lenders   @[]@[]char
	ChainRoot @[]char
	VRoot     @[]char
	DepFailed bool
	// SizedRecvs holds the receiver types of a struct instance's methods already
	// held to the opaque rules (requireMethodInstanceSized): each is sized once
	// per instance, not at every method.
	SizedRecvs @[]@types.Type
	// Requeued is set on an existing instance checked again for a method or
	// impl a REPL declaration adds to its generic (requeueTypeInstances), and on
	// the instances the check of one of its existing bodies names: those bodies
	// are existing code, so the names they use are not the declaration's
	// (recordingUses).  The body of the method the declaration adds is its own
	// (InstanceState.BodyIsNew).
	Requeued bool
}

// enqueueFuncWork queues the body check of the generic function d's instance
// for the concrete type arguments args, named at site, whose check state is s;
// returns the queued work.
func enqueueFuncWork(c @Checker, d @ast.Decl, args *[]@types.Type, site token.Pos,
		s @InstCheckState) @InstWork {
	var w @InstWork = newInstWork(c, d.Name, args, site)
	w.Decl = d
	w.State = s
	w.Lenders = s.Lenders
	w.ChainRoot = s.ChainRoot
	w.VRoot = s.VRoot
	s.Queued = true
	pushInstWork(instanceState(c), w)
	return w
}

// enqueueTypeWork queues the method body and impl checks of the generic struct
// d's instance for the concrete type arguments args, named at site, whose check
// state is s; returns the queued work.
func enqueueTypeWork(c @Checker, d @ast.Decl, args *[]@types.Type, site token.Pos,
		s @InstCheckState) @InstWork {
	var w @InstWork = newInstWork(c, d.Name, args, site)
	w.TypeDecl = d
	w.State = s
	w.Lenders = s.Lenders
	w.ChainRoot = s.ChainRoot
	w.VRoot = s.VRoot
	s.Queued = true
	pushInstWork(instanceState(c), w)
	return w
}

// pushInstWork pushes w on st's stack of instances to check -- or holds it while
// a provisional build is being made (holdWork).
func pushInstWork(st @InstanceState, w @InstWork) {
	if holdWork(st, w) {
		return
	}
	st.Top += 1
	if st.Top <= st.Queue.Len() {
		st.Queue.Set(st.Top - 1, w)
	} else {
		st.Queue.Push(w)
	}
}

// popInstWork pops the instance on top of st's stack of instances to check.
func popInstWork(st @InstanceState) @InstWork {
	st.Top -= 1
	return st.Queue.Get(st.Top)
}

// newInstWork returns an instance record named name[args] at site, chained to
// the instance whose body is being checked, if any.
func newInstWork(c @Checker, name *[]readonly char, args *[]@types.Type, site token.Pos) @InstWork {
	var w @InstWork = make(InstWork)
	w.Args = copyTypeList(args)
	w.Site = site
	w.Label = instanceLabel(name, args)
	w.Parent = instanceState(c).Current
	w.Depth = 1
	if w.Parent != nil {
		w.Depth = w.Parent.Depth + 1
		w.Requeued = w.Parent.Requeued && !instanceState(c).BodyIsNew
	}
	return w
}

// checkInstanceWork checks the instance w — a function's body, or each method
// body and parameterized impl of a struct instance — and records the outcome
// in its state.  A failure is also recorded for each instance whose check named
// w (failInstanceChain): naming one of them again checks it again.
func checkInstanceWork(c @Checker, w @InstWork) {
	var st @InstanceState = instanceState(c)
	var failed bool
	resetInstanceDeps(st, w.State)
	if w.Decl != nil {
		failed = checkFuncInstance(c, w)
	} else {
		failed = checkTypeInstance(c, w)
	}
	if w.DepFailed {
		failed = true
	}
	noteInstanceChecked(st, w.State, !failed)
	if failed {
		failInstanceChain(st, w.State)
	}
}

// checkFuncInstance checks the body of the generic function instance w, unless
// the generic's abstract body check failed or did not run -- its signature alone
// is judged again then (rejudgeInstanceSignature); reports whether it found an
// error.
func checkFuncInstance(c @Checker, w @InstWork) bool {
	var home @GenericHome = genericHomeOf(c, w.Decl)
	if home == nil {
		return false
	}
	if !home.Checked || home.BodyErrs {
		return rejudgeInstanceSignature(c, w, w.Decl, home.Scope, home.Pkg, w.Label)
	}
	return checkInstanceBody(c, w, w.Decl, home.Scope, home.Pkg, w.Label)
}

// checkTypeInstance checks each method body of the generic struct instance w
// whose abstract check passed, and its parameterized impls -- one only its
// package's .bn declares only in that package's chains (memberInChain); reports
// whether it found an error.
func checkTypeInstance(c @Checker, w @InstWork) bool {
	// An instance of a generic in an infinite family built before its methods
	// were all collected, or of one whose build went past the budget, was
	// reported where it was named (backfillInstantiationMethods,
	// buildBudgetSpent); its methods are not its own to check.
	if genericExpanding(c, w.TypeDecl) || overBudget(c, w.TypeDecl) { return true }
	queueFieldInstances(c, w)
	var failed bool = rejudgeTypeStructure(c, w)
	var pkg @[]char = genericTypeDeclPkg(c, w.TypeDecl)
	for i := 0; i < len(c.Generics.Methods); i++ {
		var entry @GenericMethodEntry = c.Generics.Methods[i]
		var base @ast.TypeExpr = receiverBaseInstantiation(entry.Decl.Recv.Type)
		if !types.CharEq(entry.Pkg, pkg) || base == nil || base.Base == nil ||
				!types.CharEq(base.Base.Name, w.TypeDecl.Name) ||
				!memberInChain(privateGenericMethodPkg(c, pkg, entry.Decl), w.ChainRoot) {
			continue
		}
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(w.Label)
		cb.Write(".")
		cb.Write(entry.Decl.Name)
		var label @[]char = buf.CopyStr(cb.String())
		if entry.Checked && !entry.BodyErrs {
			if checkInstanceBody(c, w, entry.Decl, entry.Scope, entry.Pkg, label) { failed = true }
		} else if rejudgeInstanceSignature(c, w, entry.Decl, entry.Scope, entry.Pkg, label) {
			failed = true
		}
	}
	if checkInstanceImpls(c, w) {
		failed = true
	}
	return failed
}

// checkInstanceBody checks the body of the generic function or method d for the
// instance w, on a copy of d, in d's home scope with d's type parameters (a
// method's receiver binders) bound to w's type arguments, and the opaque
// exports of w's lender class visible (lentHere).  Errors it reports name the
// instance as label (contextualizeInstanceErrors).  Reports whether the check
// found an error.
func checkInstanceBody(c @Checker, w @InstWork, d @ast.Decl, home @Scope, pkg @[]char,
		label *[]readonly char) bool {
	if d.Body == nil {
		return false
	}
	var clone @ast.Decl = ast.CloneDecl(d)
	var noParams @[]@ast.TypeParam
	clone.TypeParams = noParams
	var saved instanceCheckScope = enterInstanceCheck(c, w, d, home, pkg)
	var before int = len(c.Errors)
	var absorbed int = c.ErrorsAbsorbed
	var ft @types.Type = instanceCheckSignature(c, w, d, clone)
	if ft != nil {
		checkFuncBody(c, clone, ft)
		finalizeUntypedNonConst(c)
	}
	// An error a nested build named, or merged into one reported already, fails
	// the instance too (Checker.ErrorsAbsorbed).
	var failed bool = contextualizeInstanceErrors(c, before, w, label) || c.ErrorsAbsorbed > absorbed
	if !failed && ft != nil {
		keepInstanceBody(c, d, w.Args, clone)
	}
	leaveInstanceCheck(c, saved)
	return failed
}

// An instanceCheckScope is what enterInstanceCheck changes, for
// leaveInstanceCheck to restore.
type instanceCheckScope struct {
	Decl      declContext
	PkgPath   @[]char
	Current   @InstWork
	Lenders   @[]@[]char
	Building  bool
	Site      siteState
	BodyIsNew bool
}

// enterInstanceCheck enters the check of the generic function or method d for
// the instance w: in d's home scope, home, of package pkg, with d's type
// parameters (a method's receiver binders) bound to w's type arguments and the
// opaque exports of w's lender class visible (lentHere).
func enterInstanceCheck(c @Checker, w @InstWork, d @ast.Decl, home @Scope,
		pkg @[]char) instanceCheckScope {
	var saved instanceCheckScope
	saved.Decl = enterPackageDecl(c, d)
	saved.PkgPath = c.curPkgPath
	var st @InstanceState = instanceState(c)
	saved.Current = st.Current
	saved.Lenders = st.BodyLenders
	saved.Building = st.Building
	saved.Site = clearSite(c)
	saved.BodyIsNew = st.BodyIsNew
	st.BodyIsNew = declInList(st.NewBodies, d)
	st.Current = w
	st.BodyLenders = w.Lenders
	st.Building = false
	st.Bound = st.Bound + 1
	st.Concrete = st.Concrete + 1
	st.BodyDepth = st.BodyDepth + 1
	c.curPkgPath = pkg
	c.Scope = NewScope(home)
	bindInstanceArgs(c, d, w.Args)
	return saved
}

// leaveInstanceCheck ends what enterInstanceCheck began, restoring saved.
func leaveInstanceCheck(c @Checker, saved instanceCheckScope) {
	var st @InstanceState = instanceState(c)
	st.Current = saved.Current
	st.BodyIsNew = saved.BodyIsNew
	st.BodyLenders = saved.Lenders
	st.Building = saved.Building
	restoreSite(c, saved.Site)
	st.Bound = st.Bound - 1
	st.Concrete = st.Concrete - 1
	st.BodyDepth = st.BodyDepth - 1
	c.curPkgPath = saved.PkgPath
	leavePackageDecl(c, saved.Decl)
}

// instanceCheckSignature resolves the signature of clone, a copy of the generic
// function or method d, for the instance w being checked (enterInstanceCheck),
// as derived for it, and holds a method's receiver to the opaque rules.
func instanceCheckSignature(c @Checker, w @InstWork, d @ast.Decl, clone @ast.Decl) @types.Type {
	var savedDeriving bool = c.Generics.DerivingInstanceSig
	c.Generics.DerivingInstanceSig = true
	var ft @types.Type = instanceFuncType(c, clone)
	c.Generics.DerivingInstanceSig = savedDeriving
	if ft != nil && d.Recv != nil {
		var abs @types.Type
		var owner *uint8
		abs, owner = abstractMethodOf(c, w, d.Name)
		requireMethodInstanceSized(c, w, abs, owner, ft, d.Pos)
	}
	return ft
}

// bindInstanceArgs defines, in the current scope, the names d binds to its type
// arguments — a generic function's type parameters, or a method's receiver
// binders — as the concrete types args.
func bindInstanceArgs(c @Checker, d @ast.Decl, args *[]@types.Type) {
	if d.Recv == nil {
		for i := 0; i < len(d.TypeParams) && i < len(args); i++ {
			if !isBlank(d.TypeParams[i].Name) {
				defineTypeArg(c.Scope, d.TypeParams[i].Name, args[i])
			}
		}
		return
	}
	var inst @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
	if inst == nil {
		return
	}
	for j := 0; j < len(inst.TypeArgs) && j < len(args); j++ {
		var binder @ast.TypeExpr = inst.TypeArgs[j]
		if binder != nil && binder.Kind == ast.TEXPR_NAMED {
			defineTypeArg(c.Scope, ast.ReceiverBinderName(binder, j), args[j])
		}
	}
}

// instanceFuncType resolves the function type of the copy d of a generic
// function or method, its type arguments bound (a method's receiver first).
func instanceFuncType(c @Checker, d @ast.Decl) @types.Type {
	var ft @types.Type = resolveFuncDeclType(c, d)
	if ft == nil || d.Recv == nil {
		return ft
	}
	var recvType @types.Type = resolveReceiverWithBinders(c, d.Recv.Type)
	var combined @[]@types.Param = prependRecvParam(d.Recv.Name, recvType, ft.Params)
	return types.MakeFuncType(combined, ft.Results)
}
