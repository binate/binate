package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_instance_body.bn: each instance's body is checked with its
// type arguments bound, its errors named for the instance.

// An error only one instance has is reported for it, named; the valid instance
// reports nothing.
func TestInstanceBodyErrorNamed() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() int { var a [4]uint8; var b [sizeof(T)]uint8 = a; return len(b) }\n"
			"func h() int { return g[int32]() + g[int64]() }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "(in g[int64], instantiated at") != 1 {
		return "expected one error, named for g[int64]"
	}
	return ""
}

// The same error at the same position in two instances is reported once, naming
// both instances in the order they are checked.
func TestInstanceBodyErrorOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() uint8 { return cast(uint8, sizeof(T) * 100) }\n"
			"func h() uint8 { return g[int32]() + g[int64]() }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "does not fit") != 1 {
		return "expected the overflow reported once"
	}
	if errorsContaining(c,
			"(in g[int32], instantiated at test.bn:3:26; in g[int64], instantiated at test.bn:3:39)") != 1 {
		return "expected the one error to name g[int32] and then g[int64]"
	}
	return ""
}

// A generic whose abstract body has an error is not checked per instance: its
// error is reported once, not again for each instance.
func TestInstanceBodySkippedAfterAbstractError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() int { return undefinedName }\n"
			"func h() int { return g[int32]() + g[int64]() }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "undefined: undefinedName") != 1 || errorsContaining(c, "(in g[") != 0 {
		return "expected the abstract error once and no instance errors"
	}
	return ""
}

// Polymorphic recursion is reported, bounded, at the program's instantiation.
func TestInstanceDepthBounded() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func d[T any](n int) int { if n == 0 { return 0 }; return d[@T](n - 1) }\n"
			"func h() int { return d[int](3) }\n"
	if errorsContaining(checkSrc(src), "d[int] names d[@int]") != 1 {
		return "expected the nested-too-deeply error naming d[int] and d[@int]"
	}
	return ""
}

// An instance label names the generic and its type arguments.
func TestInstanceLabel() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 2)
	args[0] = types.TypInt()
	args[1] = types.TypBool()
	if !streq(instanceLabel("Pair", args), "Pair[int, bool]") {
		return "expected Pair[int, bool]"
	}
	return ""
}

// In a REPL group, a member that parks drops the errors its check reported, an
// instance it names included: its instance is not added to an earlier member's error
// at the same position, which stays as that member reported it.
func TestReplParkedMemberAddsNoInstanceToEarlierError() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1 }")
	replCheckDecl(c, "func h() int8 { return cast(int8, z) }")
	replCheckDecl(c, "func g[T any]() uint8 { return cast(uint8, sizeof(T) * 100) }")
	replCheckDecl(c, "var (\n\ta uint8 = g[int32]()\n\tb uint8 = g[int64]() + cast(uint8, h())\n)")
	if errorsContaining(c, "in g[int32]") != 1 { return "a's error names g[int32]" }
	if errorsContaining(c, "in g[int64]") != 0 { return "b parked: no error names g[int64]" }
	return ""
}
