package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for chains of instances, each naming the next (spec gen.mono.instances):
// one that grows without bound is reported — through fields or signatures where
// an instance of it is named (check_generic_expand.bn), through bodies once it
// passes MAX_INSTANCE_DEPTH.

// A struct instance's method signatures name instances from it: Box[int]'s Wrap
// returns Box[Opt[int]], whose Wrap returns Box[Opt[Opt[int]]], and so on — an
// infinite family, reported at the instantiation the program writes.
func TestCheckInstanceChainThroughMethodResult() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opt[T any] struct { v T }\ntype Box[T any] struct { x T }\n"
					"func (b *Box[V]) Wrap() Box[Opt[V]] {\n\tvar r Box[Opt[V]]\n\tr.x.v = b.x\n\treturn r\n}\n"
					"func f() int {\n\tvar b Box[int]\n\t_ = b\n\treturn 0\n}\n")
	if !anyErrContains(c, "generic instantiation Box[int] names infinitely many instantiations") {
		return fail("expected Box[int] reported")
	}
	return ""
}

// A type parameter nested deep in type arguments is still mentioned: an instance
// over Opt[Opt[…[T]]] seventy deep is not concrete.
func TestMentionsTypeParamDeep() testing.TestResult {
	var owner int = 0
	var t @types.Type = MakeTypeParamType("T", bit_cast(*uint8, &owner), 0, nil)
	var c @types.Type = types.TypInt()
	for i := 0; i < 70; i++ {
		var argT @[]@types.Type = make_slice(@types.Type, 1)
		argT[0] = t
		t = types.MakeNamedType("main.Opt[T]")
		t.InstArgs = argT
		var argC @[]@types.Type = make_slice(@types.Type, 1)
		argC[0] = c
		c = types.MakeNamedType("main.Opt[int]")
		c.InstArgs = argC
	}
	if !mentionsTypeParam(t) { return fail("Opt^70[T] mentions T") }
	if mentionsTypeParam(c) { return fail("Opt^70[int] mentions no type parameter") }
	return ""
}
