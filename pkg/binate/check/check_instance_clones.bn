package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/vec"

// The checked copies of instance bodies (gen.mono.check), kept for IR-gen.
// Each instance of a generic function, and each method of a generic type's
// instance, is checked on its own copy of the declaration with the type
// arguments bound, so the copy's annotations (expression types, constants,
// array lengths, a function literal's type) are the instance's; IR-gen emits
// the instance from that copy rather than from the shared declaration, whose
// annotations are the abstract body's.

// keepInstanceBody records clone as the checked copy of d's body for the type
// arguments args, replacing the copy of an earlier check of the same instance
// (a REPL re-check).
func keepInstanceBody(c @Checker, d @ast.Decl, args *[]@types.Type, clone @ast.Decl) {
	var st @InstanceState = instanceState(c)
	var b @InstanceBody = make(InstanceBody)
	b.Decl = d
	b.Args = copyTypeList(args)
	b.Clone = clone
	var bodies @vec.Vec[@InstanceBody]
	var have bool
	bodies, have = st.Bodies.Get(d)
	if !have {
		bodies = vec.New[@InstanceBody]()
		st.Bodies.Put(d, bodies)
	}
	for i := 0; i < bodies.Len(); i++ {
		if typeListsIdentical(bodies.Get(i).Args, args) {
			bodies.Set(i, b)
			return
		}
	}
	bodies.Push(b)
}

// InstanceBodies returns the checked copies of the body of the generic function
// or generic-type method d, one per instance checked.
func (c @Checker) InstanceBodies(d @ast.Decl) @[]@InstanceBody {
	var none @[]@InstanceBody
	if c.Instances == nil {
		return none
	}
	var bodies @vec.Vec[@InstanceBody]
	var have bool
	bodies, have = c.Instances.Bodies.Get(d)
	if !have {
		return none
	}
	return bodies.Items()
}

// TypeInstanceClones returns, for each concrete instantiation of the generic
// struct or interface declaration d, the copy of d its members were resolved
// from with its type arguments bound.
func (c @Checker) TypeInstanceClones(d @ast.Decl) @[]@InstanceBody {
	var n int = 0
	for i := 0; i < len(c.GenericInstantiations); i++ {
		if typeInstanceCloneOf(c.GenericInstantiations[i], d) {
			n = n + 1
		}
	}
	var out @[]@InstanceBody = make_slice(@InstanceBody, n)
	n = 0
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var e @GenericInstantiation = c.GenericInstantiations[i]
		if typeInstanceCloneOf(e, d) {
			var b @InstanceBody = make(InstanceBody)
			b.Decl = d
			b.Args = e.TypeArgs
			b.Clone = e.Clone
			out[n] = b
			n = n + 1
		}
	}
	return out
}

// typeInstanceCloneOf reports whether e is a concrete instantiation of d with a
// resolved copy.
func typeInstanceCloneOf(e @GenericInstantiation, d @ast.Decl) bool {
	return e != nil && same(e.Decl, d) && e.Clone != nil && !typeListMentionsTypeParam(e.TypeArgs)
}

// instanceDeclHasher / instanceDeclEq key InstanceState.Bodies by a
// declaration's identity.
type instanceDeclHasher struct {}

impl instanceDeclHasher : hash.Hasher[@ast.Decl]

// Hash hashes a declaration's address.
func (h instanceDeclHasher) Hash(k @ast.Decl) uint {
	var p uint = bit_cast(uint, bit_cast(*uint8, k))
	return p ^ (p >> 7)
}

// instanceDeclEq is the identity equality paired with instanceDeclHasher.
type instanceDeclEq struct {}

impl instanceDeclEq : cmp.Eq[@ast.Decl]

// Equal reports whether a and b are the same declaration.
func (e instanceDeclEq) Equal(a @ast.Decl, b @ast.Decl) bool {
	return same(a, b)
}
