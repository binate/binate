package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// declNamedIn returns the top-level declaration of file named name, or nil.
func declNamedIn(file @ast.File, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(file.Decls); i++ {
		if types.CharEq(file.Decls[i].Name, name) { return file.Decls[i] }
	}
	return nil
}

// Each instance whose check passed keeps its own checked copy of the body.
func TestInstanceBodiesOnePerInstance() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(
			"package \"test\"\n"
					"func g[T any]() int { var a [sizeof(T)]uint8; return len(a) }\n"
					"func main() { var x int = g[int16]() + g[int64](); _ = x }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var g @ast.Decl = declNamedIn(file, "g")
	var bodies @[]@InstanceBody = c.InstanceBodies(g)
	if len(bodies) != 2 { return "expected two instance bodies" }
	if same(bodies[0].Clone, g) || same(bodies[1].Clone, g) || same(bodies[0].Clone, bodies[1].Clone) {
		return "expected a distinct copy per instance"
	}
	if bodies[0].Args[0].IdenticalStrict(bodies[1].Args[0]) {
		return "expected the two instances' arguments"
	}
	return ""
}

// An instance whose check failed keeps no copy: the program is rejected.
func TestInstanceBodiesFailedNotKept() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(
			"package \"test\"\n"
					"func h[T any]() int { var a [4 - sizeof(T)]uint8; return len(a) }\n"
					"func main() { var x int = h[int16]() + h[int64](); _ = x }\n")
	if len(c.CheckerErrors()) == 0 { return "expected h[int64]'s negative length rejected" }
	var bodies @[]@InstanceBody = c.InstanceBodies(declNamedIn(file, "h"))
	if len(bodies) != 1 { return "expected only h[int16]'s copy" }
	return ""
}

// A generic struct's concrete instantiations each have the copy their fields
// were resolved from; an instantiation over a type parameter has none.
func TestTypeInstanceClones() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(
			"package \"test\"\n"
					"type Box[T any] struct { b [sizeof(T)]uint8 }\n"
					"func f[T any](x @Box[T]) int { return 0 }\n"
					"func main() { var x Box[int32]; var y Box[int8]; _ = x; _ = y }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var d @ast.Decl = declNamedIn(file, "Box")
	var clones @[]@InstanceBody = c.TypeInstanceClones(d)
	if len(clones) != 2 { return "expected Box[int32] and Box[int8] only" }
	if same(clones[0].Clone, d) || same(clones[0].Clone, clones[1].Clone) {
		return "expected a distinct copy per instantiation"
	}
	return ""
}
