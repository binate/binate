package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"

// How an error found in an instance's check names the instance: the instance's
// label (`F[int64]`) and where the chain naming it starts, merged with the same
// error other instances reported (contextualizeInstanceErrors).

// contextualizeInstanceErrors names the instance w, as label, in each error
// reported since before (`… (in F[int64], instantiated at main.bn:12:5)`).  An
// error another instance already reported at the same position names w too, after
// the instances before it (`… (in F[int32], instantiated at main.bn:12:5; in
// F[int64], instantiated at main.bn:13:5)`), and one the generic's own declaration
// check reported, which covers every instance, is dropped, as is one whose earlier
// report lies below InstanceState.EditFloor (a REPL declaration's, kept whatever the
// declaration being checked does).  An error a provisional build gave out
// (CheckError.Released) is that build's, and kept as it is.
// Reports whether any error was reported since before, dropped or not, other
// than those.
func contextualizeInstanceErrors(c @Checker, before int, w @InstWork, label *[]readonly char) bool {
	if len(c.Errors) <= before {
		return false
	}
	var own bool = ownErrorsSince(c.Errors, before)
	var fresh @[]CheckError = make_slice(CheckError, len(c.Errors) - before)
	for i := before; i < len(c.Errors); i++ {
		fresh[i - before] = c.Errors[i]
	}
	c.Errors = c.Errors[:before]
	var context @[]char = instanceContext(w, label)
	for i := 0; i < len(fresh); i++ {
		// An error a nested instance's build named keeps its own context
		// (check_instance_naming.bn).
		if fresh[i].Named || fresh[i].Released {
			c.Errors = appendUniqueCheckError(c.Errors, c.DedupFrom, fresh[i])
			continue
		}
		var k int = instanceErrorAt(c, fresh[i])
		if k >= 0 {
			if k >= instanceState(c).EditFloor && len(c.Errors[k].Msg) > len(fresh[i].Msg) {
				c.Errors[k].Msg = addInstanceContext(c.Errors[k].Msg, context)
			}
			continue
		}
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(fresh[i].Msg)
		cb.Write(context)
		var e CheckError = fresh[i]
		e.Msg = buf.CopyStr(cb.String())
		e.Named = true
		c.Errors = appendUniqueCheckError(c.Errors, c.DedupFrom, e)
	}
	return own
}

// instanceErrorAt returns the index in c.Errors of the error with e's position and
// message already reported -- naming the instances that made it (`<message> (in
// …)`), or plain, by the generic's own declaration check -- since c.DedupFrom, so a
// REPL prompt repeating an earlier prompt's mistake still reports it; or -1.
func instanceErrorAt(c @Checker, e CheckError) int {
	for i := c.DedupFrom; i < len(c.Errors); i++ {
		var o CheckError = c.Errors[i]
		if !types.CharEq(o.Pos.File, e.Pos.File) || o.Pos.Line != e.Pos.Line || o.Pos.Col != e.Pos.Col ||
				len(o.Msg) < len(e.Msg) || !types.CharEq(o.Msg[:len(e.Msg)], e.Msg) {
			continue
		}
		if len(o.Msg) == len(e.Msg) || hasPrefixAt(o.Msg, len(e.Msg), " (in ") {
			return i
		}
	}
	return -1
}

// addInstanceContext adds the instance a context (` (in F[int64], instantiated at
// …)`, instanceContext) names to msg, an error naming instances already: `… (in
// F[int32], …; in F[int64], …)`.  An instance msg names already is not added again.
func addInstanceContext(msg *[]readonly char, context *[]readonly char) @[]char {
	var entry *[]readonly char = context[2:len(context) - 1]
	for i := 0; i + len(entry) <= len(msg); i++ {
		if types.CharEq(msg[i:i + len(entry)], entry) { return buf.CopyStr(msg) }
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(msg[:len(msg) - 1])
	cb.Write("; ")
	cb.Write(context[2:])
	return buf.CopyStr(cb.String())
}

// hasPrefixAt reports whether s holds prefix at offset at.
func hasPrefixAt(s *[]readonly char, at int, prefix *[]readonly char) bool {
	return at + len(prefix) <= len(s) && types.CharEq(s[at:at + len(prefix)], prefix)
}

// instanceContext returns ` (in F[int64], instantiated at file:line:col)` for
// the instance w, named label — the site of the chain's first instance, which
// the program writes, and that instance when it is not w.
func instanceContext(w @InstWork, label *[]readonly char) @[]char {
	var root @InstWork = w
	for root.Parent != nil {
		root = root.Parent
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(" (in ")
	cb.Write(label)
	cb.Write(", instantiated at ")
	cb.Write(posString(root.Site))
	if !same(root, w) {
		cb.Write(" via ")
		cb.Write(root.Label)
	}
	cb.Write(")")
	return buf.CopyStr(cb.String())
}

// instanceLabel returns `name[A, B]` for type arguments args.
func instanceLabel(name *[]readonly char, args *[]@types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(name)
	cb.Write("[")
	for i := 0; i < len(args); i++ {
		if i > 0 {
			cb.Write(", ")
		}
		cb.Write(args[i].TypeName())
	}
	cb.Write("]")
	return buf.CopyStr(cb.String())
}

// posString returns `file:line:col` for pos.
func posString(pos token.Pos) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(pos.File)
	cb.Write(":")
	cb.Write(strconv.Itoa(pos.Line))
	cb.Write(":")
	cb.Write(strconv.Itoa(pos.Col))
	return buf.CopyStr(cb.String())
}
