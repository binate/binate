package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for the drain's chain bound (check_instance_drain.bn): it is on the
// shortest chain to an instance from one the program writes, whichever chain
// names the instance first (spec gen.mono.instances).

// chainSrc returns a package in which f1[T] … f100[T] each name the next and
// f100 names S1[T]; S1[T] … S40[T] each name the next through a method's
// result, and, with hChain, S40[T]'s method body names h1[T], where h1[T] …
// h100[T] each name the next; g[T] names S1[T] and k[T] names nothing; and
// main's body is body.
func chainSrc(hChain bool, body *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	for i := 1; i <= 40; i++ {
		b.Write("type S")
		b.Write(strconv.Itoa(i))
		b.Write("[T any] struct { v T }\n")
		if i < 40 {
			b.Write("func (s *S")
			b.Write(strconv.Itoa(i))
			b.Write("[T]) N() *S")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T] { return nil }\n")
		} else if hChain {
			b.Write("func (s *S40[T]) H() int { return h1[T]() }\n")
		}
	}
	for i := 1; i <= 100; i++ {
		b.Write("func f")
		b.Write(strconv.Itoa(i))
		if i < 100 {
			b.Write("[T any]() int { return f")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T]() }\n")
		} else {
			b.Write("[T any]() int { var s S1[T]; _ = s; return 0 }\n")
		}
		b.Write("func h")
		b.Write(strconv.Itoa(i))
		if i < 100 {
			b.Write("[T any]() int { return h")
			b.Write(strconv.Itoa(i + 1))
			b.Write("[T]() }\n")
		} else {
			b.Write("[T any]() int { return 0 }\n")
		}
	}
	b.Write("func g[T any]() int { var s S1[T]; _ = s; return 0 }\n")
	b.Write("func k[T any]() int { return 0 }\n")
	b.Write("func main() {\n")
	b.Write(body)
	b.Write("}\n")
	return b.String()
}

// S29[int] is 129 levels down when f1[int] names it first, through f1 … f100
// and S1 … S28, but 30 through g[int]: accepted whichever main names first.
func TestInstanceChainShortestCounts() testing.TestResult {
	if len(checkSrc(chainSrc(false, "\tf1[int]()\n\tg[int]()\n")).CheckerErrors()) != 0 {
		return "expected f1[int] then g[int] accepted: g[int] reaches S1[int] at depth 2"
	}
	if len(checkSrc(chainSrc(false, "\tg[int]()\n\tf1[int]()\n")).CheckerErrors()) != 0 {
		return "expected g[int] then f1[int] accepted"
	}
	return ""
}

// Through f1[int] alone the shortest chain to S29[int] is 129 levels: rejected,
// from f1[int].
func TestInstanceChainTooLongReported() testing.TestResult {
	var c @Checker = checkSrc(chainSrc(false, "\tf1[int]()\n"))
	if errorsContaining(c, "nested too deeply") != 1 ||
			errorsContaining(c, "f1[int] names f2[int], and so on through 128 levels") != 1 {
		return "expected the chain from f1[int] reported once"
	}
	return ""
}

// S40[int] is built 40 levels down from S1[int] before main writes it itself,
// which makes its chain one level: h1[int] … h100[int], named from it, fit.
func TestInstanceChainRootedWhereWritten() testing.TestResult {
	var c @Checker = checkSrc(chainSrc(true, "\tvar s S1[int]\n\t_ = s\n\tvar t S40[int]\n\t_ = t\n"))
	if len(c.CheckerErrors()) != 0 {
		return "expected S40[int], written in main, to start its own chain"
	}
	return ""
}

// g[int] shortens the chains of the instances f1[int] set aside, and 300 more
// instances follow it: when the search for a shorter chain ends
// (endSpentSearch), the chains are measured again before any is reported, and
// those set aside that now fit are checked.
func TestInstanceChainShortenedBeforeStackEmpties() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("\tf1[int]()\n\tg[int]()\n")
	for i := 1; i <= 300; i++ {
		b.Write("\tk[[")
		b.Write(strconv.Itoa(i))
		b.Write("]int]()\n")
	}
	if len(checkSrc(chainSrc(false, b.String())).CheckerErrors()) != 0 {
		return "expected the instances set aside requeued once g[int] reaches S1[int]"
	}
	return ""
}

// The search for a shorter chain is bounded (MAX_CHAIN_SEARCH): with 300
// instances named between f1[int] and g[int], the chain from f1[int] is reported
// before g[int] is checked.
func TestInstanceChainSearchEnds() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("\tf1[int]()\n")
	for i := 1; i <= 300; i++ {
		b.Write("\tk[[")
		b.Write(strconv.Itoa(i))
		b.Write("]int]()\n")
	}
	b.Write("\tg[int]()\n")
	var c @Checker = checkSrc(chainSrc(false, b.String()))
	if errorsContaining(c, "f1[int] names f2[int], and so on through 128 levels") != 1 {
		return "expected the chain from f1[int] reported once the search ends"
	}
	return ""
}

// The links of chains a REPL declaration's check records go with it when it
// parks: a parked declaration names no instance of the program, and dropping it
// can drop the records of the instances it named.  checkOrPark is called
// directly, as CheckDeclInScope calls it, since the drain that ends a prompt
// drops every link anyway; the links matter between the groups one
// RetryPendingDecls retries.
func TestReplParkedDeclDropsChainLinks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func g[T any]() int { return 0 }")
	var p @parser.Parser = parser.New(toBytes("func h() int { return g[int64]() + k() }"), "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	var mark int = instanceState(c).Edges.Len()
	c.AllowRedef = true
	c.ReplDeclMode = true
	checkOrPark(c, d)
	if !c.IsPendingDecl("h") || instanceState(c).Edges.Len() != mark {
		return "h must park on k, leaving no link of a chain"
	}
	return ""
}
