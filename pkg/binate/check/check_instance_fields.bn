package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// The struct instances a struct instance's fields refer to.  IR-gen emits an
// instance's methods where they are used, and a method of an instance can use
// a method of one of its fields' instances (`p.b.Get()`) without naming that
// instance's type, so the check of a struct instance queues the checks of its
// fields' instances: one created only while a signature was resolved, or a
// method copied into an existing instance, is checked that way.

// queueFieldInstances queues, from the check of the struct instance w, the
// check of each concrete struct instance its fields' types refer to that needs
// one (needsInstanceCheck) — named from w, so its failure fails w, and a chain
// through fields is bounded like one through a body.
func queueFieldInstances(c @Checker, w @InstWork) {
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, w.TypeDecl, w.Args)
	if entry == nil || entry.Result == nil || entry.Result.Underlying == nil {
		return
	}
	var wk @instanceWalk = make(instanceWalk)
	var fields @[]@types.Field = entry.Result.Underlying.Fields
	for i := 0; i < len(fields); i++ {
		collectTypeInstances(c, wk, fields[i].Type)
	}
	var found @[]@GenericInstantiation = wk.Found
	var st @InstanceState = instanceState(c)
	var savedCur @InstWork = st.Current
	st.Current = w
	for i := 0; i < len(found); i++ {
		var s @InstCheckState = found[i].InstState
		if needsInstanceCheck(c, s) {
			enqueueTypeWork(c, found[i].Decl, found[i].TypeArgs, w.Site, s)
		}
		noteInstanceNamed(c, s)
	}
	st.Current = savedCur
}

// instanceWalk collects the instantiation entries of the concrete struct
// instances a type refers to (Found), with the interface types already walked
// (Ifaces), which can refer to themselves.
type instanceWalk struct {
	Found  @[]@GenericInstantiation
	Ifaces @[]@types.Type
}

// collectTypeInstances adds to wk the concrete struct instances t is or refers
// to — through pointers, slices, arrays, function types, anonymous structs,
// interfaces' method signatures and parents, readonly and aliases, but not into
// another named struct type, whose fields are its own.  It ends: a named type
// stops it, each interface is walked once, and the rest are finite trees.
func collectTypeInstances(c @Checker, wk @instanceWalk, t @types.Type) {
	if t == nil {
		return
	}
	if t.Kind == types.TYP_NAMED && t.InstDecl != nil {
		var e @GenericInstantiation = instantiationEntryOf(c, t)
		if e != nil && e.InstState != nil {
			wk.Found = slices.Append[@GenericInstantiation](wk.Found, e)
		}
		return
	}
	if t.Kind == types.TYP_NAMED {
		return
	}
	if t.Kind == types.TYP_ALIAS {
		collectTypeInstances(c, wk, t.Target)
		return
	}
	if t.Kind == types.TYP_INTERFACE {
		collectInterfaceInstances(c, wk, t)
		return
	}
	collectTypeInstances(c, wk, t.Elem)
	for i := 0; i < len(t.Fields); i++ {
		collectTypeInstances(c, wk, t.Fields[i].Type)
	}
	for i := 0; i < len(t.Params); i++ {
		collectTypeInstances(c, wk, t.Params[i].Type)
	}
	for i := 0; i < len(t.Results); i++ {
		collectTypeInstances(c, wk, t.Results[i])
	}
}

// collectInterfaceInstances adds to wk the concrete struct instances the
// interface t's method signatures and parent interfaces refer to, once per
// interface.
func collectInterfaceInstances(c @Checker, wk @instanceWalk, t @types.Type) {
	for i := 0; i < len(wk.Ifaces); i++ {
		if same(wk.Ifaces[i], t) {
			return
		}
	}
	wk.Ifaces = slices.Append[@types.Type](wk.Ifaces, t)
	for i := 0; i < len(t.Methods); i++ {
		collectTypeInstances(c, wk, t.Methods[i].FuncType)
	}
	for i := 0; i < len(t.Parents); i++ {
		collectTypeInstances(c, wk, t.Parents[i])
	}
}

// instantiationEntryOf returns the instantiation entry whose type is named:
// the cached type itself, found by identity, else by its type arguments.
func instantiationEntryOf(c @Checker, named @types.Type) @GenericInstantiation {
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry != nil && same(entry.Result, named) {
			return entry
		}
	}
	return lookupCachedInstantiationEntry(c, bit_cast(@ast.Decl, named.InstDecl), named.InstArgs)
}
