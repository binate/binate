package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// The struct instances a struct instance's fields refer to.  IR-gen emits an
// instance's methods where they are used, and a method of an instance can use
// a method of one of its fields' instances (`p.b.Get()`) without naming that
// instance's type, so the check of a struct instance queues the checks of its
// fields' instances: one created only while a signature was resolved, or a
// method copied into an existing instance, is checked that way.

// queueFieldInstances queues, from the check of the struct instance w, the
// check of each concrete struct instance its fields' types refer to that needs
// one (needsInstanceCheck) — named from w, so its failure fails w, and a chain
// through fields is bounded like one through a body, and lent what w is lent,
// as written where w's generic is (declSitePkg).
func queueFieldInstances(c @Checker, w @InstWork) {
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, w.TypeDecl, w.Args)
	if entry == nil || entry.Result == nil || entry.Result.Underlying == nil {
		return
	}
	var wk @instanceWalk = make(instanceWalk)
	var fields @[]@types.Field = entry.Result.Underlying.Fields
	for i := 0; i < len(fields); i++ {
		collectTypeInstances(c, wk, fields[i].Type)
	}
	var found @[]@GenericInstantiation = wk.Found
	var st @InstanceState = instanceState(c)
	var savedCur @InstWork = st.Current
	var savedSite siteState = setSite(c, declSitePkg(c, w.TypeDecl))
	st.Current = w
	for i := 0; i < len(found); i++ {
		var s @InstCheckState = instStateFor(c, found[i].InstState, w.Site)
		if needsInstanceCheck(c, s) {
			enqueueTypeWork(c, found[i].Decl, found[i].TypeArgs, w.Site, s)
		}
		noteInstanceNamed(c, s, w.Site)
	}
	st.Current = savedCur
	restoreSite(c, savedSite)
}

// instanceWalk collects the instantiation entries of the concrete struct
// instances a type refers to (Found), with the interface types already walked
// (ifaces), which can refer to themselves.
type instanceWalk struct {
	Found  @[]@GenericInstantiation
	ifaces typeVisits
}

// collectTypeInstances adds to wk the concrete struct instances t is or refers
// to — through pointers, slices, arrays, function types, anonymous structs,
// interfaces' method signatures and parents, readonly and aliases, but not into
// another named struct type, whose fields are its own.  It ends: a named type
// stops it, each interface is walked once, and the rest are finite trees.  It
// takes t's parts in turn from the work list (typeWalk), in the order a walk
// recursing on them takes: the element, fields, parameters, then results.
func collectTypeInstances(c @Checker, wk @instanceWalk, t @types.Type) {
	var base int = typeWalkBase()
	typeInstancesStep(c, wk, t)
	for typeWalkMore(base) {
		typeInstancesStep(c, wk, typeWalkPop())
	}
}

// typeInstancesStep adds t to wk when it is a concrete struct instance, and pushes the
// parts collectTypeInstances looks at in it, last first.
func typeInstancesStep(c @Checker, wk @instanceWalk, t @types.Type) {
	if t == nil {
		return
	}
	if t.Kind == types.TYP_NAMED && t.InstDecl != nil {
		var e @GenericInstantiation = instantiationEntryOf(c, t)
		if e != nil && e.InstState != nil {
			wk.Found = slices.Append[@GenericInstantiation](wk.Found, e)
		}
		return
	}
	if t.Kind == types.TYP_NAMED {
		return
	}
	if t.Kind == types.TYP_ALIAS {
		typeWalkPush(t.Target)
		return
	}
	if t.Kind == types.TYP_INTERFACE {
		pushInterfaceParts(wk, t)
		return
	}
	pushSignatureTypes(t)
	pushFieldTypes(t)
	typeWalkPush(t.Elem)
}

// pushInterfaceParts pushes, the first time wk meets the interface t, its method
// signatures and parent interfaces, last first: the methods are looked at first.
func pushInterfaceParts(wk @instanceWalk, t @types.Type) {
	if !wk.ifaces.enter(t) {
		return
	}
	for i := len(t.Parents) - 1; i >= 0; i-- {
		typeWalkPush(t.Parents[i])
	}
	for i := len(t.Methods) - 1; i >= 0; i-- {
		typeWalkPush(t.Methods[i].FuncType)
	}
}

// collectInterfaceInstances adds to wk the concrete struct instances the
// interface t's method signatures and parent interfaces refer to, once per
// interface.
func collectInterfaceInstances(c @Checker, wk @instanceWalk, t @types.Type) {
	var base int = typeWalkBase()
	pushInterfaceParts(wk, t)
	for typeWalkMore(base) {
		typeInstancesStep(c, wk, typeWalkPop())
	}
}

// noteInterfaceInstances queues, for the generic interface instance iface
// named at site, the check of each concrete struct instance its method
// signatures and parents refer to that needs one, noting each named
// (noteInstanceNamed) when the program names the interface there: a call
// through the interface can use their methods without naming them.
func noteInterfaceInstances(c @Checker, iface @types.Type, site token.Pos, userFacing bool) {
	var wk @instanceWalk = make(instanceWalk)
	collectInterfaceInstances(c, wk, iface)
	for i := 0; i < len(wk.Found); i++ {
		var e @GenericInstantiation = wk.Found[i]
		var s @InstCheckState = instStateFor(c, e.InstState, site)
		if needsInstanceCheck(c, s) {
			enqueueTypeWork(c, e.Decl, e.TypeArgs, site, s)
		}
		if namedByProgram(c, userFacing) {
			noteInstanceNamed(c, s, site)
		}
	}
}

// ifaceClassNew reports whether the concrete generic interface instance entry
// is named here in a lender class (lenderClass) it was not named in before, and
// records it.
func ifaceClassNew(c @Checker, entry @GenericInstantiation) bool {
	if typeListMentionsTypeParam(entry.TypeArgs) { return false }
	var class @[]@[]char = lenderClass(c, entry.IfaceOwners)
	for i := 0; i < len(entry.IfaceClasses); i++ {
		if sameLenders(entry.IfaceClasses[i], class) { return false }
	}
	entry.IfaceClasses = slices.Append[@[]@[]char](entry.IfaceClasses, class)
	return true
}

// instantiationEntryOf returns the instantiation entry whose type is named:
// the cached type itself, found by identity, else by its type arguments.
func instantiationEntryOf(c @Checker, named @types.Type) @GenericInstantiation {
	for i := 0; i < len(c.Generics.Instantiations); i++ {
		var entry @GenericInstantiation = c.Generics.Instantiations[i]
		if entry != nil && same(entry.Result, named) {
			return entry
		}
	}
	return lookupCachedInstantiationEntry(c, bit_cast(@ast.Decl, named.InstDecl), named.InstArgs)
}
