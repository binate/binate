package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_instance_fields.bn: a struct instance's fields' instances
// are checked, including one created only while a signature was resolved.

// An instance first created while a function instance's signature is resolved,
// and one its field refers to, are checked though nothing names them again.
func TestSignatureDerivedInstancesChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }\n"
			"type Pair[T any] struct { b *Box[T] }\n"
			"func (p *Pair[T]) PGet() int { return p.b.Get() }\n"
			"func mk[T any]() *Pair[T] { return nil }\n"
			"func h() int { return mk[int64]().PGet() }\n"
	if errorsContaining(checkSrc(src), "(in Box[int64].Get") != 1 {
		return "expected Box[int64].Get rejected"
	}
	return ""
}

// At the REPL a method copied into an existing instance derives instances
// that are not queued; one reached only through a field of an instance its
// check names again is checked from that instance's check — through a struct
// field, an interface field's method signature, or a function-value field.
func replFieldReachChecked(fieldType *[]readonly char, call *[]readonly char) bool {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Inner[T any] struct { v T }")
	replCheckDecl(c,
			"func (i *Inner[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	replCheckDecl(c, "interface Mk[T any] { Make() *Inner[T] }")
	replCheckDecl(c, buf.Concat(buf.Concat("type Pair[T any] struct { f ", fieldType), " }"))
	replCheckDecl(c, buf.Concat(buf.Concat("func (p *Pair[T]) PGet() int { return ", call), " }"))
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "var bx Box[int64]")
	if len(c.CheckerErrors()) != 0 {
		return false
	}
	replCheckDecl(c, "func (b *Box[T]) Get() *Pair[T] { return nil }")
	return errorsContaining(c, "(in Inner[int64].Bad") == 1
}

// An instance reached only through a struct field is checked.
func TestReplStructFieldInstanceChecked() testing.TestResult {
	if !replFieldReachChecked("*Inner[T]", "p.f.Bad()") {
		return "expected Inner[int64].Bad rejected, reached through a struct field"
	}
	return ""
}

// An instance reached only through an interface field's method signature is
// checked.
func TestReplInterfaceFieldInstanceChecked() testing.TestResult {
	if !replFieldReachChecked("*Mk[T]", "p.f.Make().Bad()") {
		return "expected Inner[int64].Bad rejected, reached through an interface field"
	}
	return ""
}

// An instance reached only through a function-value field is checked.
func TestReplFuncValueFieldInstanceChecked() testing.TestResult {
	if !replFieldReachChecked("*func() *Inner[T]", "p.f().Bad()") {
		return "expected Inner[int64].Bad rejected, reached through a function-value field"
	}
	return ""
}

// Self-referring and mutually referring fields are each checked once.
func TestRecursiveFieldInstancesCheckedOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node[T any] struct { next @Node[T]; o *Other[T] }\n"
			"type Other[T any] struct { back *Node[T] }\n"
			"func (o *Other[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }\n"
			"func h() int { var n Node[int64]; return n.o.Bad() }\n"
	if errorsContaining(checkSrc(src), "(in Other[int64].Bad") != 1 {
		return "expected Other[int64].Bad rejected once"
	}
	return ""
}

// An interface field that refers to itself is walked once.
func TestSelfReferringInterfaceFieldWalked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface N[T any] { Next() *N[T]; Prev() *N[T]; Val() *Box[T] }\n"
			"type Box[T any] struct { v T }\n"
			"type Holder[T any] struct { n *N[T] }\n"
			"func h() int { var x Holder[int64]; return cast(int, x.n.Val().v) }\n"
	if len(checkSrc(src).CheckerErrors()) != 0 {
		return "expected the program accepted"
	}
	return ""
}

// boxSrc is a program naming one instance, Box[int].
var boxSrc *[]readonly char = "package \"main\"\ntype Box[T any] struct { v T }\nvar b Box[int]\n"

// boxInstance returns the instantiation entry of Box[int] in c, which checked boxSrc.
func boxInstance(c @Checker) @GenericInstantiation {
	for i := 0; i < len(c.Generics.Instantiations); i++ {
		var e @GenericInstantiation = c.Generics.Instantiations[i]
		if e != nil && e.Result != nil && e.InstState != nil { return e }
	}
	var none @GenericInstantiation
	return none
}

// instancesFound returns how many instances collectTypeInstances finds in t, its
// visited set released before it returns.
func instancesFound(c @Checker, t @types.Type) int {
	var wk @instanceWalk = make(instanceWalk)
	collectTypeInstances(c, wk, t)
	return len(wk.Found)
}

// ifaceChain returns n interfaces, each the next's child (its only parent the next),
// the last with one method returning a pointer to leaf.
func ifaceChain(n int, leaf @types.Type) @types.Type {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(leaf)
	var m @types.Method = make(types.Method)
	m.Name = "Get"
	var none @[]@types.Param
	m.FuncType = types.MakeFuncType(none, results)
	var t @types.Type = types.MakeInterfaceType("main", "I")
	t.Methods = make_slice(@types.Method, 1)
	t.Methods[0] = m
	for i := 1; i < n; i++ {
		var child @types.Type = types.MakeInterfaceType("main", "I")
		child.Parents = make_slice(@types.Type, 1)
		child.Parents[0] = t
		t = child
	}
	return t
}

// A struct instance at the bottom of a chain of pointers deepLevels deep, or named by a
// method of the last of a chain of interfaces each the next's parent, is found.
func TestDeepTypeInstances() testing.TestResult {
	var c @Checker = checkSrc(boxSrc)
	var e @GenericInstantiation = boxInstance(c)
	if e == nil { return fail("Box[int] is instantiated") }
	var p @types.Type = ptrChain(deepLevels, e.Result)
	var viaPointers int = instancesFound(c, p)
	dropLinks(&p, deepLevels)
	var t @types.Type = ifaceChain(deepLevels, e.Result)
	var viaParents int = instancesFound(c, t)
	for i := 1; i < deepLevels; i++ {
		t = t.Parents[0]
	}
	if viaPointers != 1 { return fail("the instance under a deep pointer chain is found") }
	if viaParents != 1 { return fail("the instance named under a deep interface chain is found") }
	return ""
}
