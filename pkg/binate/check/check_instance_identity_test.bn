package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the identity of generic instances (instArgsIdentical in
// types_identical.bn): an instance's name spells a type parameter by its bare
// name, so two instances over different generics' same-named parameters share
// a name but are distinct.

// Named and interface instances whose names agree are identical only when their
// type arguments are: the same parameter (owner and position) or not.
func TestIdenticalInstancesOverTypeParams() testing.TestResult {
	var declN int = 0
	var declS int = 0
	var tN @types.Type = MakeTypeParamType("T", bit_cast(*uint8, &declN), 0, nil)
	var tS @types.Type = MakeTypeParamType("T", bit_cast(*uint8, &declS), 0, nil)
	var tNagain @types.Type = MakeTypeParamType("T", bit_cast(*uint8, &declN), 0, nil)
	var named @[]@types.Type = make_slice(@types.Type, 3)
	var ifaces @[]@types.Type = make_slice(@types.Type, 3)
	var params @[]@types.Type = @[]@types.Type{tN, tS, tNagain}
	for i := 0; i < 3; i++ {
		var args @[]@types.Type = make_slice(@types.Type, 1)
		args[0] = params[i]
		named[i] = types.MakeNamedType("main.N[T]")
		named[i].InstArgs = args
		ifaces[i] = types.MakeInterfaceType("main", "Get[T]")
		ifaces[i].InstArgs = args
	}
	if named[0].Identical(named[1]) { return fail("N[T] over two owners' T must NOT be identical") }
	if !named[0].Identical(named[2]) { return fail("N[T] over the same T must be identical") }
	if ifaces[0].Identical(ifaces[1]) {
		return fail("Get[T] over two owners' T must NOT be identical")
	}
	if !ifaces[0].IdenticalStrict(ifaces[2]) {
		return fail("Get[T] over the same T must be identical")
	}
	return ""
}

// A generic over an instance of another generic whose parameter has the same
// name reads that instance in its own parameter: `x.get().v` in G[T] over
// `@Get[N[T]]` is G's T, though N's own declaration wrote `Get[N[T]]` first.
func TestCheckInstanceOverSameNamedParam() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface Get[T any] { get() T }\n"
							"type N[T any] struct { v T; next @Get[N[T]] }\n"
							"type S[T any] struct { g @Get[N[T]] }\n"
							"func G[T any](x @Get[N[T]]) T { return x.get().v }\n"
							"func H[T any](s *S[T]) T { return s.g.get().v }\n"))
}

// One generic's parameters are told apart by position, not by name: a method
// binding M's parameters as `M[V, K]` names M's first parameter V, so the
// field `ov Opt[V]`, over M's second, is not its `Opt[V]`.
func TestCheckInstanceBinderPositionDistinct() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\n"
							"type M[K any, V any] struct { ov Opt[V] }\n"
							"func (m *M[V, K]) wrong() Opt[V] { return m.ov }\n"), "cannot assign")
}

// Whether an impl covers an interface instance follows instance identity too:
// M[K, V] implements Sink[Opt[V]] over its second parameter, so a method binding
// `M[V, K]` cannot hand itself out as a Sink[Opt[V]] over its first.
func TestCheckImplCoversInstanceByArgs() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ntype Opt[T any] struct { v T }\n"
							"interface Sink[T any] { put(x T) }\n"
							"type M[K any, V any] struct { got int }\nimpl M[K, V] : Sink[Opt[V]]\n"
							"func (m *M[K, V]) put(x Opt[V]) { m.got++ }\n"
							"func (m *M[V, K]) bad() *Sink[Opt[V]] { return m }\n"), "cannot assign")
}
