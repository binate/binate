package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// checkInstanceImpls checks, for the struct instance w, each parameterized impl
// of its generic (`impl *Wrap[K] : Sized[K]`) with w's type arguments: the
// instance's methods must cover the interface instance's, whose signatures now
// have their dependent lengths' values (an [8]uint8 parameter does not cover an
// [2]uint8 one).  An impl whose abstract check reported an error is not checked
// again per instance.  The instances the check names are named from w, so a
// chain through an impl's interface list (`impl *W[K] : Marker[W[@K]]`) is
// bounded, and reported, like one through a body.  Reports whether the check
// found an error.
func checkInstanceImpls(c @Checker, w @InstWork) bool {
	var st @InstanceState = instanceState(c)
	var failed bool = false
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil || rec.Placeholder == nil || rec.RecvType == nil || rec.AbstractErrs {
			continue
		}
		var shell @types.Type = rec.RecvType.ReceiverBaseNamed()
		if shell == nil || shell.InstDecl == nil ||
				!same(bit_cast(@ast.Decl, shell.InstDecl), w.TypeDecl) {
			continue
		}
		var before int = len(c.Errors)
		var savedCur @InstWork = st.Current
		st.Current = w
		var savedDeriving bool = c.DerivingInstanceSig
		c.DerivingInstanceSig = true
		var recv @types.Type = substituteTypeParams(c, rec.RecvType, w.Args)
		var named @types.Type = recv.ReceiverBaseNamed()
		for k := 0; k < len(rec.Interfaces) && named != nil; k++ {
			if rec.Interfaces[k] != nil {
				var iface @types.Type = substituteTypeParams(c, rec.Interfaces[k], w.Args)
				checkImplCoversInterface(c, rec, recv, named, named, iface)
			}
		}
		c.DerivingInstanceSig = savedDeriving
		st.Current = savedCur
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("the impl for ")
		cb.Write(w.Label)
		if contextualizeInstanceErrors(c, before, w, buf.CopyStr(cb.String())) {
			failed = true
		}
	}
	return failed
}
