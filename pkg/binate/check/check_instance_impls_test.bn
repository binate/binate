package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_instance_impls.bn: a parameterized impl is checked for each
// instance of its type, with the type arguments bound.

// An instance whose method does not cover the interface instance's is
// rejected, named for the impl and the instance.
func TestInstanceImplCoverageChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Sized[T any] { Put(x [sizeof(T)]uint8) int }\n"
			"type Wrap[K any] struct { k K }\n"
			"impl *Wrap[K] : Sized[K]\n"
			"func (w *Wrap[K]) Put(x [sizeof(K) + 6]uint8) int { return len(x) }\n"
			"func h() int { var a Wrap[int16]; var b Wrap[int64]; return cast(int, a.k) + cast(int, b.k) }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "(in the impl for Wrap[int16]") != 1 ||
			errorsContaining(c, "(in the impl for Wrap[int64]") != 1 {
		return "expected the impl rejected for each instance"
	}
	return ""
}

// An impl whose method covers each instance's interface instance is accepted.
func TestInstanceImplCoverageAccepted() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Sized[T any] { Put(x [sizeof(T)]uint8) int }\n"
			"type Wrap[K any] struct { k K }\n"
			"impl *Wrap[K] : Sized[K]\n"
			"func (w *Wrap[K]) Put(x [sizeof(K)]uint8) int { return len(x) }\n"
			"func h() int { var a Wrap[int16]; var b Wrap[int64]; return cast(int, a.k) + cast(int, b.k) }\n"
	if len(checkSrc(src).CheckerErrors()) != 0 {
		return "expected a covering impl accepted for each instance"
	}
	return ""
}

// A chain of instances named through an impl's interface list is bounded and
// reported like one through a body.
func TestInstanceImplRecursionBounded() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Marker[X any] { Id() int }\n"
			"type W[K any] struct { k K }\n"
			"impl *W[K] : Marker[W[@K]]\n"
			"func (w *W[K]) Id() int { return 1 }\n"
			"func h() int { var w W[int]; return w.Id() }\n"
	if errorsContaining(checkSrc(src), "nested too deeply") != 1 {
		return "expected the nested-too-deeply error once"
	}
	return ""
}

// An impl whose abstract check failed is not checked again per instance.
func TestInstanceImplSkippedAfterAbstractError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Getter[T any] { Get() T }\n"
			"type Wrap[K any] struct { k K }\n"
			"impl *Wrap[K] : Getter[K]\n"
			"func h() int { var a Wrap[int8]; var b Wrap[int16]; return cast(int, a.k) + cast(int, b.k) }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "missing method") != 1 || errorsContaining(c, "(in the impl for") != 0 {
		return "expected the missing method reported once, for the abstract impl"
	}
	return ""
}

// An impl's abstract failure stays recorded when a later pass over the impls
// finds the same error again (dropped as a duplicate).
func TestImplAbstractErrsLatched() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Getter[T any] { Get() T }\n"
			"type Wrap[K any] struct { k K }\n"
			"impl *Wrap[K] : Getter[K]\n"
	var c @Checker = checkSrc(src)
	checkAllImplsSatisfaction(c)
	if len(c.Impls) != 1 || !c.Impls[0].AbstractErrs {
		return "expected the impl's abstract failure still recorded"
	}
	return ""
}
