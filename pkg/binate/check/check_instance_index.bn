package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/cmp"
import "pkg/std/hash"

// The index of a package's generic function instances (InstanceState.FuncIndex):
// funcInstance finds the instance of a declaration for type arguments by hashing
// them, where scanning every instance made a package naming n instances do n^2
// comparisons.

// funcInstKey keys an instance by its generic declaration and its type arguments,
// which the instance owns (FuncInstance.Args) while it is in the index.  The table
// hashes a stored key again as it grows, so a key's hash must not change while it is
// stored: it reads only what a type keeps from when it is made (its kind, names,
// widths and elements), never a placeholder's underlying, which may be filled later.
type funcInstKey struct {
	decl @ast.Decl
	args *[]@types.Type
}

// funcInstKeyHasher hashes a key's declaration by address and its arguments by
// instTypeHash.
type funcInstKeyHasher struct {}

impl funcInstKeyHasher : hash.Hasher[funcInstKey]

// Hash hashes k.
func (h funcInstKeyHasher) Hash(k funcInstKey) uint {
	var dh instanceDeclHasher
	var x uint = dh.Hash(k.decl)
	for i := 0; i < len(k.args); i++ {
		x = mixInstHash(x, instTypeHash(k.args[i]))
	}
	return x
}

// funcInstKeyEq is the equality paired with funcInstKeyHasher: the same declaration and
// identical arguments (typeListsIdentical).
type funcInstKeyEq struct {}

impl funcInstKeyEq : cmp.Eq[funcInstKey]

// Equal reports whether a and b name the same instance.
func (e funcInstKeyEq) Equal(a funcInstKey, b funcInstKey) bool {
	return same(a.decl, b.decl) && typeListsIdentical(a.args, b.args)
}

// instTypeHash hashes t so that the types IdenticalStrict calls identical hash alike (a
// distinct pair may share a hash; funcInstKeyEq decides): t's kind after its aliases,
// mixed with the name its identity is decided by (an integer type's, a named type's
// identity name, a named struct's, an interface's package and name), a float's width,
// an array's length, and the element types of the composites IdenticalStrict compares
// element by element.  Other kinds hash by kind alone.
func instTypeHash(t @types.Type) uint {
	if t == nil { return 0 }
	t = t.ResolveAlias()
	if t == nil { return 0 }
	var h uint = cast(uint, t.Kind) + 1
	if t.Kind == types.TYP_READONLY || t.Kind == types.TYP_POINTER ||
			t.Kind == types.TYP_MANAGED_PTR || t.Kind == types.TYP_SLICE ||
			t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_INTERFACE_VALUE ||
			t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return mixInstHash(h, instTypeHash(t.Elem))
	}
	if t.Kind == types.TYP_ARRAY {
		return mixInstHash(mixInstHash(h, cast(uint, t.ArrayLen)), instTypeHash(t.Elem))
	}
	if t.Kind == types.TYP_INT || t.Kind == types.TYP_STRUCT {
		return mixInstHash(h, charsInstHash(t.Name))
	}
	if t.Kind == types.TYP_NAMED {
		return mixInstHash(h, charsInstHash(types.NamedIdentityName(t)))
	}
	if t.Kind == types.TYP_INTERFACE {
		return mixInstHash(mixInstHash(h, charsInstHash(t.Pkg)), charsInstHash(t.Name))
	}
	if t.Kind == types.TYP_FLOAT {
		return mixInstHash(h, cast(uint, t.Width))
	}
	return h
}

// mixInstHash combines a hash h with x.
func mixInstHash(h uint, x uint) uint {
	return (h ^ x) * 16777619 + (h >> 13)
}

// charsInstHash hashes the characters of s (FNV-1a).
func charsInstHash(s *[]readonly char) uint {
	var h uint = 2166136261
	for i := 0; i < len(s); i++ {
		h = (h ^ cast(uint, s[i])) * 16777619
	}
	return h
}
