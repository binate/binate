package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_instance_index.bn: instances are found by a hash of their type
// arguments that follows IdenticalStrict.

// Types built apart that IdenticalStrict calls identical hash alike; the hash still
// tells apart what identity does in the common cases (a readonly element, an array's
// length, two integer types).
func TestInstTypeHashFollowsIdentity() testing.TestResult {
	var p1 @types.Type = types.MakePointerType(types.MakeSliceType(types.TypInt32()))
	var p2 @types.Type = types.MakePointerType(types.MakeSliceType(types.TypInt32()))
	if !p1.IdenticalStrict(p2) || instTypeHash(p1) != instTypeHash(p2) {
		return "two *[]int32 types are identical and hash alike"
	}
	var a3 @types.Type = types.MakeArrayType(types.TypInt8(), 3)
	if instTypeHash(a3) != instTypeHash(types.MakeArrayType(types.TypInt8(), 3)) {
		return "two [3]int8 types hash alike"
	}
	if instTypeHash(a3) == instTypeHash(types.MakeArrayType(types.TypInt8(), 4)) {
		return "[3]int8 and [4]int8 hash apart"
	}
	if instTypeHash(types.MakePointerType(types.MakeReadonlyType(types.TypInt8()))) ==
			instTypeHash(types.MakePointerType(types.TypInt8())) {
		return "*readonly int8 and *int8 hash apart"
	}
	if instTypeHash(types.TypInt32()) == instTypeHash(types.TypInt64()) {
		return "int32 and int64 hash apart"
	}
	return ""
}

// A package naming g[int32] twice and g[int64] once has two instances of g, each in
// the index once.
func TestFuncInstanceIndexOneInstancePerArgs() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() int { return 1 }\n"
			"func h() int { return g[int32]() + g[int32]() + g[int64]() }\n"
	var c @Checker = checkSrc(src)
	var st @InstanceState = instanceState(c)
	if st.Funcs.Len() != 2 || st.FuncIndex.Len() != 2 {
		return "expected two instances of g, both indexed"
	}
	return ""
}
