package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Whose opaque exports an instance's body sees.  A body is checked where its
// generic is written (checkInstanceBody), and a type in it counts as opaque only
// if it is opaque both there and where the instance is instantiated
// (type.opaque.pointer-to-embedding): an opaque export a type argument carries
// (Type.OpaqueExportPkg) is visible in the body when the package that owns it
// named the instance in its .bn.  So each check of an instance has a lender
// class (InstCheckState.Lenders): the packages, among those whose exports its
// type arguments carry (Owners), whose exports are visible where it is named —
// the package it is written in, outside a .bni, and those lent to what it is
// named for (lenderClass).  An instance named in several classes is checked
// once for each: the state its record holds is the first class's, and the
// others are chained from it (Next).

// exportOwners returns the packages whose opaque exports the types args carry,
// at any depth — through elements, pointees, fields, signatures, an interface's
// methods and parents, type arguments, and a named type's structure — each
// once, in the order found.  A named type with no structure yet — one still
// being resolved, or an instance still being built — may carry its own
// package's exports once it has one, so its package counts as well.
func exportOwners(c @Checker, args *[]@types.Type) @[]@[]char {
	var ow ownerWalk
	for i := 0; i < len(args); i++ {
		collectExportOwners(c, &ow, args[i])
	}
	return ow.owners
}

// ownerWalk holds the owners exportOwners has found, and the named and
// interface types it has entered, each once: they can refer to themselves.
type ownerWalk struct {
	owners  @[]@[]char
	entered typeVisits
}

// collectExportOwners adds to ow the owners of the opaque exports t carries, taking t's
// parts in turn from the work list (typeWalk) in the order a walk recursing on them
// takes: type arguments, fields, parameters, results, an interface's methods and
// parents, then the element, an alias's target and a named type's underlying type.
func collectExportOwners(c @Checker, ow *ownerWalk, t @types.Type) {
	var base int = typeWalkBase()
	exportOwnersStep(c, ow, t)
	for typeWalkMore(base) {
		exportOwnersStep(c, ow, typeWalkPop())
	}
}

// exportOwnersStep adds to ow the owners of the exports t itself carries, and pushes
// its parts, last first, for collectExportOwners to look at.
func exportOwnersStep(c @Checker, ow *ownerWalk, t @types.Type) {
	if t == nil { return }
	if (t.Kind == types.TYP_NAMED || t.Kind == types.TYP_INTERFACE) && !ow.entered.enter(t) { return }
	if len(t.OpaqueExportPkg) > 0 { addExportOwner(ow, t.OpaqueExportPkg) }
	if t.Kind == types.TYP_NAMED && t.Underlying == nil {
		if t.InstDecl != nil {
			addExportOwner(ow, genericTypeDeclPkg(c, bit_cast(@ast.Decl, t.InstDecl)))
		} else if len(t.Pkg) > 0 {
			addExportOwner(ow, t.Pkg)
		}
	}
	if t.Underlying != nil { typeWalkPush(t.Underlying) }
	if t.Target != nil { typeWalkPush(t.Target) }
	if t.Elem != nil { typeWalkPush(t.Elem) }
	if t.Kind == types.TYP_INTERFACE {
		pushParentTypes(t)
		for i := len(t.Methods) - 1; i >= 0; i-- {
			typeWalkPush(t.Methods[i].FuncType)
		}
	}
	pushSignatureTypes(t)
	pushFieldTypes(t)
	pushInstArgs(t)
}

// addExportOwner adds pkg to ow's owners, once.
func addExportOwner(ow *ownerWalk, pkg @[]char) {
	if len(pkg) == 0 || lends(ow.owners, pkg) { return }
	ow.owners = slices.Append[@[]char](ow.owners, pkg)
}

// lends reports whether the packages class hold pkg.
func lends(class *[]@[]char, pkg *[]readonly char) bool {
	for i := 0; i < len(class); i++ {
		if types.CharEq(class[i], pkg) { return true }
	}
	return false
}

// lenderClass returns the lender class of an instance whose type arguments
// carry the exports of owners, named here: each owner whose exports are visible
// where it is named — the package it is written in, unless in a .bni (the
// current package, or InstanceState.SitePkg when SiteSet), and those lent to
// what it is named for: while an instance is resolved with its type arguments
// bound (InstanceState.Building), the naming it is resolved for (BuildLenders);
// otherwise the instance being checked, if any.  It also returns the root,
// for an instance of a generic declared in pkg, of the chain that names it here
// (chainRootFor).
func lenderClass(c @Checker, owners *[]@[]char, pkg *[]readonly char) (@[]@[]char, @[]char) {
	var n namingContext = namingHere(c)
	return lenderClassAt(owners, n), chainRootFor(n.ChainRoot, pkg)
}

// A namingContext is where an instance is named, for its lender class: the
// package whose exports are visible where it is written (Site, empty in a
// .bni), and the packages lent to what it is named for (Lent); and the package
// the chain it is named in is rooted in (ChainRoot: chain_root.bn).
type namingContext struct {
	Site      @[]char
	Lent      @[]@[]char
	ChainRoot @[]char
}

// namingHere returns the naming context here (lenderClass).
func namingHere(c @Checker) namingContext {
	var st @InstanceState = instanceState(c)
	var n namingContext
	if st.SiteSet {
		n.Site = st.SitePkg
	} else if !inBniView(c) {
		n.Site = c.curPkgPath
	}
	if st.Building {
		n.Lent = st.BuildLenders
	} else if st.Current != nil {
		n.Lent = st.Current.Lenders
	}
	n.ChainRoot = chainRootAt(c, n.Site)
	return n
}

// namingAt returns the naming context here of a use in the view v: none of its
// package's exports are visible where it is written when v is a .bni's, which
// is no site of the package's .bn (chainRootAt).
func namingAt(c @Checker, v ImplView) namingContext {
	var n namingContext = namingHere(c)
	if v.Bni {
		var none @[]char
		n.Site = none
		n.ChainRoot = chainRootAt(c, none)
	}
	return n
}

// lenderClassAt returns the lender class, in the naming context n, of an
// instance whose type arguments carry the exports of owners.
func lenderClassAt(owners *[]@[]char, n namingContext) @[]@[]char {
	var class @[]@[]char
	for i := 0; i < len(owners); i++ {
		if len(n.Site) > 0 && types.CharEq(owners[i], n.Site) || lends(n.Lent, owners[i]) {
			class = slices.Append[@[]char](class, owners[i])
		}
	}
	return class
}

// declSitePkg returns the package whose exports are visible where the generic
// type d is declared: its package, unless it is declared in a .bni.
func declSitePkg(c @Checker, d @ast.Decl) @[]char {
	var none @[]char
	var s @Scope = lookupGenericDeclScope(c, d)
	for s != nil {
		if s.InterfaceView { return none }
		s = s.Parent
	}
	return genericTypeDeclPkg(c, d)
}

// setSite makes pkg the package lenderClass counts as where instances are
// written (none, when empty), until restoreSite with the returned state.
func setSite(c @Checker, pkg @[]char) siteState {
	var st @InstanceState = instanceState(c)
	var saved siteState
	saved.Set = st.SiteSet
	saved.Pkg = st.SitePkg
	st.SiteSet = true
	st.SitePkg = pkg
	return saved
}

// clearSite makes lenderClass count the current package as where instances
// are written again, until restoreSite with the returned state.
func clearSite(c @Checker) siteState {
	var st @InstanceState = instanceState(c)
	var saved siteState
	saved.Set = st.SiteSet
	saved.Pkg = st.SitePkg
	var none @[]char
	st.SiteSet = false
	st.SitePkg = none
	return saved
}

// restoreSite restores what setSite or clearSite changed.
func restoreSite(c @Checker, saved siteState) {
	var st @InstanceState = instanceState(c)
	st.SiteSet = saved.Set
	st.SitePkg = saved.Pkg
}

// A siteState is InstanceState's SiteSet and SitePkg, saved.
type siteState struct {
	Set bool
	Pkg @[]char
}

// firstInstState returns a new instance's check state, for the type arguments
// args of a generic declared in pkg, first named at site here (in its lender
// class and chain root: lenderClass).
func firstInstState(c @Checker, args *[]@types.Type, site token.Pos, pkg @[]char) @InstCheckState {
	var s @InstCheckState = newInstCheckState(c, site)
	s.Owners = exportOwners(c, args)
	s.GenericPkg = pkg
	lenders, root := lenderClass(c, s.Owners, pkg)
	s.Lenders = lenders
	s.ChainRoot = root
	return s
}

// instStateFor returns the check state, among those of the instance whose first
// is first, of the lender class and chain root it is named in here
// (lenderClass), creating it,
// first named at site, when there is none.
func instStateFor(c @Checker, first @InstCheckState, site token.Pos) @InstCheckState {
	if first == nil { return nil }
	class, root := lenderClass(c, first.Owners, first.GenericPkg)
	var s @InstCheckState = first
	for {
		if sameLenders(s.Lenders, class) && types.CharEq(s.ChainRoot, root) { return s }
		if s.Next == nil { break }
		s = s.Next
	}
	var v @InstCheckState = newInstCheckState(c, site)
	v.Owners = first.Owners
	v.GenericPkg = first.GenericPkg
	v.Lenders = class
	v.ChainRoot = root
	s.Next = v
	return v
}

// someStateOK reports whether the instance whose first state is first passed
// its last check in some lender class.
func someStateOK(first @InstCheckState) bool {
	var s @InstCheckState = first
	for s != nil {
		if s.OK { return true }
		s = s.Next
	}
	return false
}

// sameLenders reports whether the lender classes a and b, each drawn in order
// from one instance's Owners, are the same.
func sameLenders(a *[]@[]char, b *[]@[]char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if !types.CharEq(a[i], b[i]) { return false }
	}
	return true
}

// lentHere reports whether pkg's opaque exports are visible here because an
// instance's body is being checked whose lender class holds pkg.
func lentHere(c @Checker, pkg *[]readonly char) bool {
	if c.Instances == nil { return false }
	var st @InstanceState = c.Instances
	return st.BodyDepth > 0 && lends(st.BodyLenders, pkg)
}
