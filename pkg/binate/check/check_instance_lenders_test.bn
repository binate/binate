package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_instance_lenders.bn: a type in an instance's body counts as
// opaque only if it is opaque both where its generic is written and where the
// instance is instantiated.

// lendLibBni and lendLibBn are pkg/lib: an opaque export Box; a generic G whose
// body holds a T by value and a pointer to [2]T, and F, which calls G; a generic
// S whose method takes a T, an alias L of a pointer to it, and a generic Outer
// whose field is an Inner, whose method takes a T; an interface Getter whose
// method returns a *S[T], and a generic H constrained by it; and Mine, which
// lib's .bn, where Box is not opaque, writes with G[Box].
var lendLibBni *[]readonly char = "package \"pkg/lib\"\ntype Box\n"
		"func G[T any](p *T) int {\n\tvar x T = *p\n\tvar y *([2]T)\n\t_ = x\n\t_ = y\n\treturn 1\n}\n"
		"func F[T any](p *T) int { return G[T](p) }\n"
		"type S[T any] struct { p *T }\nfunc (s *S[T]) m(x T) int { return 3 }\n"
		"type L[T any] = *S[T]\n"
		"type Inner[T any] struct { p *T }\nfunc (s *Inner[T]) m(x T) int { return 4 }\n"
		"type Outer[T any] struct { inner Inner[T] }\n"
		"interface Getter[T any] { Get() *S[T] }\ntype H[U any, T Getter[U]] struct { p *T }\n"
		"func Mine() int\n"

var lendLibBn *[]readonly char = "package \"pkg/lib\"\ntype Box struct { n int }\n"
		"func Mine() int {\n\tvar b Box\n\treturn G[Box](&b)\n}\n"

// checkLendUser checks package q, whose .bni declares an opaque export Op and
// whose .bn (after importing pkg/lib) defines it and declares decls, against
// lendLibBni / lendLibBn.
func checkLendUser(decls *[]readonly char) @Checker {
	return checkBniMethodPkgIn(checkerWithLib(lendLibBni, lendLibBn),
			"package \"q\"\ntype Op\nfunc F() int\n",
			buf.Concat(buf.Concat("package \"q\"\nimport \"pkg/lib\"\ntype Op struct { a int }\n", decls),
					"func F() int { return 0 }\n"), false)
}

// q's .bn may instantiate lib's generics with its own opaque export: q sees Op's
// definition, so the instances' bodies and method signatures — named directly,
// from another instance's body, through an alias or through a field — may use it
// by value.
func TestCheckLentOwnExportInBodies() testing.TestResult {
	return expectNoErrors(
			checkLendUser(
					"func U() int {\n\tvar o Op\n\tvar s lib.S[Op]\n\tvar l lib.L[Op]\n"
							"\tvar w lib.Outer[Op]\n\t_ = s\n\t_ = l\n\t_ = w\n"
							"\treturn lib.G[Op](&o) + lib.F[Op](&o)\n}\n"))
}

// An export is lent only by the package that owns it: lib's own G[Box] is fine
// in lib, but q, which sees lib.Box as opaque, may not instantiate G with it —
// reported for q's instance only.
func TestCheckLentOnlyByOwner() testing.TestResult {
	var c @Checker = checkLendUser("func U() int {\n\tvar b *lib.Box\n\treturn lib.G[lib.Box](b)\n}\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 4 {
		return fail(buf.Concat("expected 4 errors in q's G[Box]; got ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, "(in G[Box], instantiated at q.bn:") {
			return fail(errs[i].Msg)
		}
	}
	return ""
}

// An importer's view of an opaque export reaches a function value's signature in
// an instance's body: in q, a body's *func(T) over lib.Box takes an opaque value.
func TestCheckLentImporterExportInBodySignature() testing.TestResult {
	var c @Checker = checkLendUser(
			"func gt[T any]() int {\n\tvar f *func(T)\n\t_ = f\n\treturn 2\n}\n"
					"func U() int { return gt[lib.Box]() }\n")
	if len(c.CheckerErrors()) != 1 || !anyErrContains(c, "(in gt[Box],") {
		return fail("expected exactly the error on gt[Box]'s function value")
	}
	return ""
}

// An instance method's signature judges the parts that come from its type
// arguments, an interface instance's included: S[Fwd].m takes a *Get[Fwd],
// whose method returns an opaque value.
func TestCheckMethodInstanceIfaceArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] { get() T }\n"
					"type S[T any] struct { v *T }\nfunc (s *S[T]) m(g *Get[T]) {}\n"
					"func f() {\n\tvar s S[Fwd]\n\t_ = s\n}\n")
	if len(c.CheckerErrors()) != 1 || !anyErrContains(c, "(in S[Fwd].m,") {
		return fail("expected exactly the error on S[Fwd].m's parameter")
	}
	return ""
}

// A generic type's method's own parts that mention a type parameter are judged
// at its declaration, whether or not the type is instantiated, and not again for
// each instance.
func TestCheckMethodOwnPartsAtDeclaration() testing.TestResult {
	var decl *[]readonly char = "package \"test\"\ntype Fwd\ntype S[T any] struct { v *T }\n"
			"func (s *S[T]) n(x struct { a T; b Fwd }) {}\n"
	var c @Checker = checkSrc(decl)
	if len(c.CheckerErrors()) != 1 || anyErrContains(c, "(in ") {
		return fail("expected the error at n's declaration, with no instance")
	}
	c = checkSrc(
			buf.Concat(decl, "func f() {\n\tvar a S[int]\n\tvar b S[bool]\n\t_ = a\n\t_ = b\n}\n"))
	if len(c.CheckerErrors()) != 1 || anyErrContains(c, "(in ") {
		return fail("the declaration's error should be the only one, not repeated for each instance")
	}
	return ""
}

// An instance a generic in q's .bn writes is written where q's exports are not
// opaque, whatever the generic is instantiated with: a struct's field, a
// generic function's parameter and a generic alias's target over lib.S[Op] —
// whose m takes an Op — are fine, the struct's also when it is never
// instantiated.
func TestCheckLentWhereWrittenInGeneric() testing.TestResult {
	return expectNoErrors(
			checkLendUser(
					"type W[T any] struct { b lib.S[Op]; t *T }\n"
							"type N[T any] struct { b lib.S[Op]; t *T }\n"
							"func H[T any](b *lib.S[Op], t T) int { return 0 }\n"
							"type A[T any] = *lib.S[Op]\n"
							"func U() int {\n\tvar w W[int]\n\tvar a A[int]\n\t_ = w\n\t_ = a\n"
							"\treturn H[int](nil, 1)\n}\n"))
}

// A type argument whose structure is not resolved yet when the instance is first
// named carries its package's exports all the same: B, resolved after A names
// lib.S[B], holds an Op, and so does W, which names lib.S[W] in its own fields.
func TestCheckLentArgResolvedLater() testing.TestResult {
	return expectNoErrors(
			checkLendUser(
					"type A struct { b lib.S[B] }\ntype B struct { o Op }\n"
							"type W struct { b lib.S[W]; o Op }\n"
							"func U() int {\n\tvar a A\n\tvar w W\n\t_ = a\n\t_ = w\n\treturn 0\n}\n"))
}

// An instance a .bni names is named where its package's exports are opaque: q's
// .bni function returning a *lib.S[Op] instantiates S[Op], whose m takes an Op —
// though q's .bn, which defines the function, names it where Op is not opaque.
func TestCheckLentNotInBniSignature() testing.TestResult {
	var c @Checker = checkBniMethodPkgIn(checkerWithLib(lendLibBni, lendLibBn),
			"package \"q\"\nimport \"pkg/lib\"\ntype Op\nfunc Get() *lib.S[Op]\n",
			"package \"q\"\nimport \"pkg/lib\"\ntype Op struct { a int }\n"
					"func Get() *lib.S[Op] { return nil }\n",
			false)
	if !anyErrContains(c, "(in S[Op].m, instantiated at test.bni:") {
		return fail("expected S[Op].m rejected, as named in q's .bni")
	}
	return ""
}

// A constraint is resolved where its generic is written, but names its instances
// for the use it checks: H[Op, Op]'s Getter[Op] — whose Get returns a *S[Op],
// whose m takes an Op — is named where q's .bn writes H[Op, Op].
func TestCheckLentConstraintNaming() testing.TestResult {
	return expectNoErrors(
			checkLendUser(
					"func (o Op) Get() *lib.S[Op] { return nil }\nimpl Op : lib.Getter[Op]\n"
							"func U() int {\n\tvar h lib.H[Op, Op]\n\t_ = h\n\treturn 0\n}\n"))
}
