package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Which instances the program names, at the REPL.  An instance named by a REPL
// input that checked is named by the program (InstCheckState.Live), and so is
// each instance the check of one so named names, or a struct instance's
// fields refer to (Deps).  When a later input adds a method or impl to a
// generic struct, each instance of it the program names is checked again
// (requeueTypeInstances): every instance whose methods IR-gen can emit from
// the program's code, and none that only a rejected or undone input named.

// pushNamed records s as named by the REPL input being checked.
func pushNamed(st @InstanceState, s @InstCheckState) {
	st.NamedTop++
	if st.NamedTop <= st.Named.Len() {
		st.Named.Set(st.NamedTop - 1, s)
	} else {
		st.Named.Push(s)
	}
}

// namedFloor starts tracking the instances a REPL input names, returning where
// its records start (commitNamed).
func namedFloor(c @Checker) int {
	var st @InstanceState = instanceState(c)
	st.TrackNamed = true
	return st.NamedTop
}

// commitNamed ends a REPL input's records, from floor on: when the input
// checked (ok), each instance it named is named by the program (Live) — and
// recorded in r, when not nil, so undoing the input (RollbackDecl) takes that
// back.
func commitNamed(c @Checker, floor int, ok bool, r @DeclRollback) {
	var st @InstanceState = instanceState(c)
	for i := floor; ok && i < st.NamedTop; i++ {
		var s @InstCheckState = st.Named.Get(i)
		s.Live++
		if r != nil {
			r.Committed = slices.Append[@InstCheckState](r.Committed, s)
		}
	}
	st.NamedTop = floor
}

// requeueTypeInstances queues again each concrete instance of the generic
// struct d that the program names (markProgramInstances) and is not queued: a
// REPL declaration has added a method to d or a parameterized impl of it,
// which the instance's check covers.  Every instance the program does not
// name — of d, or one whose check named one of d's, perhaps through others —
// is left as never checked (forgetUnreachedChecks), so it is checked against
// the methods as they are now when an input names it.
func requeueTypeInstances(c @Checker, d @ast.Decl) {
	var stamp int = markProgramInstances(c)
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		var s @InstCheckState = entry.InstState
		if s != nil && !s.Queued && s.Reach == stamp && same(entry.Decl, d) {
			s.OK = false
			enqueueTypeWork(c, entry.Decl, entry.TypeArgs, s.Site, s)
		}
	}
	forgetUnreachedChecks(c, stamp)
}

// forgetUnreachedChecks leaves each instance not marked with stamp, and not
// queued, as never checked.
func forgetUnreachedChecks(c @Checker, stamp int) {
	var st @InstanceState = instanceState(c)
	for i := 0; i < st.Funcs.Len(); i++ {
		forgetCheck(st.Funcs.Get(i).State, stamp)
	}
	for i := 0; i < len(c.GenericInstantiations); i++ {
		forgetCheck(c.GenericInstantiations[i].InstState, stamp)
	}
}

// forgetCheck leaves the instance whose state is s as never checked unless it
// is marked with stamp or queued — with no Deps: an input or a reached
// instance's check can reach it again only by naming it, which queues its
// check, which records them again.
func forgetCheck(s @InstCheckState, stamp int) {
	if s == nil || s.Queued || s.Reach == stamp {
		return
	}
	s.OK = false
	s.Epoch = -1
	var none @[]*InstCheckState
	s.Deps = none
}

// markProgramInstances marks, with a new stamp it returns, each instance the
// program names: one a REPL input that checked names (Live), one the input
// being checked has named so far (Named), and each one the check of a marked
// instance names (Deps).
func markProgramInstances(c @Checker) int {
	var st @InstanceState = instanceState(c)
	st.ReachStamp++
	var stamp int = st.ReachStamp
	for i := 0; i < st.NamedTop; i++ {
		markReach(st.Named.Get(i), stamp)
	}
	for i := 0; i < st.Funcs.Len(); i++ {
		var fs @InstCheckState = st.Funcs.Get(i).State
		if fs != nil && fs.Live > 0 {
			markReach(fs, stamp)
		}
	}
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var ts @InstCheckState = c.GenericInstantiations[i].InstState
		if ts != nil && ts.Live > 0 {
			markReach(ts, stamp)
		}
	}
	return stamp
}

// markReach marks the instance whose state is s, and each one it depends on,
// with stamp.
func markReach(s *InstCheckState, stamp int) {
	if s == nil || s.Reach == stamp {
		return
	}
	s.Reach = stamp
	for i := 0; i < len(s.Deps); i++ {
		markReach(s.Deps[i], stamp)
	}
}

// requeueForNewMethods queues again the instances of each generic struct one
// of decls, checked at the REPL, is a method of.
func requeueForNewMethods(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d == nil || d.Kind != ast.DECL_FUNC || d.Recv == nil {
			continue
		}
		var base @ast.TypeExpr = receiverBaseInstantiation(d.Recv.Type)
		if base == nil || base.Base == nil {
			continue
		}
		var td @ast.Decl = currentGenericTypeDecl(c, base.Base.Name)
		if td != nil {
			requeueTypeInstances(c, td)
		}
	}
}

// currentGenericTypeDecl returns the declaration of the generic type name in
// the current package — the latest recorded — or nil.
func currentGenericTypeDecl(c @Checker, name *[]readonly char) @ast.Decl {
	for i := len(c.GenericTypeDecls) - 1; i >= 0; i-- {
		var d @ast.Decl = c.GenericTypeDecls[i]
		if types.CharEq(d.Name, name) && types.CharEq(genericTypeDeclPkg(c, d), c.curPkgPath) {
			return d
		}
	}
	return nil
}

// requeueForNewImpls queues again, for each parameterized impl recorded at
// the REPL from c.Impls[from] on, the instances of its receiver's generic
// struct.
func requeueForNewImpls(c @Checker, from int) {
	for i := from; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil || rec.Placeholder == nil || rec.RecvType == nil {
			continue
		}
		var shell @types.Type = rec.RecvType.ReceiverBaseNamed()
		if shell == nil || shell.InstDecl == nil {
			continue
		}
		requeueTypeInstances(c, bit_cast(@ast.Decl, shell.InstDecl))
	}
}

// addDep records that the check of the instance whose state is from named the
// instance whose state is to, once.
func addDep(from @InstCheckState, to @InstCheckState) {
	if from == nil || to == nil || same(from, to) {
		return
	}
	var raw *InstCheckState = to
	for i := 0; i < len(from.Deps); i++ {
		if same(from.Deps[i], raw) {
			return
		}
	}
	from.Deps = slices.Append[*InstCheckState](from.Deps, raw)
}

// depsRecord is a check state's Deps before a REPL input's check replaced
// them (resetInstanceDeps), restored if the input is undone (undoDeps).
type depsRecord struct {
	State *InstCheckState
	Deps  @[]*InstCheckState
}

// resetInstanceDeps clears the Deps of the instance whose state is s, before
// its check records them again; at the REPL (TrackNamed) the old ones are
// kept (InstanceState.DepsJournal), since the input the check is for may be
// undone, with a method the check covered.
func resetInstanceDeps(st @InstanceState, s @InstCheckState) {
	if s == nil {
		return
	}
	if st.TrackNamed {
		var rec @depsRecord = make(depsRecord)
		rec.State = s
		rec.Deps = s.Deps
		st.DepsJournalLen++
		if st.DepsJournalLen <= st.DepsJournal.Len() {
			st.DepsJournal.Set(st.DepsJournalLen - 1, rec)
		} else {
			st.DepsJournal.Push(rec)
		}
	}
	var none @[]*InstCheckState
	s.Deps = none
}

// undoDeps undoes the checks recorded since the journal held mark records,
// latest first, for an undone input: each instance they checked counts as
// never checked, with the Deps it had before, so it is checked again when
// next named.
func undoDeps(st @InstanceState, mark int) {
	for st.DepsJournalLen > mark {
		var rec @depsRecord = popDepsRecord(st)
		rec.State.Deps = rec.Deps
		rec.State.OK = false
		rec.State.Epoch = -1
	}
}

// popDepsRecord pops the latest record of st's DepsJournal.
func popDepsRecord(st @InstanceState) @depsRecord {
	st.DepsJournalLen--
	return st.DepsJournal.Get(st.DepsJournalLen)
}

// clearDepsJournal empties st's DepsJournal at the start of a REPL input: an
// earlier input can no longer be undone.
func clearDepsJournal(st @InstanceState) {
	var none @depsRecord
	for i := 0; i < st.DepsJournalLen; i++ {
		st.DepsJournal.Set(i, none)
	}
	st.DepsJournalLen = 0
}
