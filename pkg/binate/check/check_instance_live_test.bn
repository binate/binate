package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for check_instance_live.bn: a method typed at the REPL is checked for
// each instance of its type the program names — named by an input that
// checked, by the loaded main file, or through an instance so named (its
// check, or its fields) — and for none only a rejected or undone input named.

// A method typed after a rejected prompt named a failing instance of its type
// is not checked for that instance, which the program does not name.
func TestReplRejectedInstanceNotRequeued() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	replCheckDeclUndo(c, "var bx Box[int64]")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func (b *Box[T]) Good() int { return 1 }")
	if before != 1 || len(c.CheckerErrors()) != before {
		return "expected only the rejected prompt's error"
	}
	return ""
}

// An instance named only by a declaration that checked but was then undone
// (as when IR-gen does not lower it) is not checked for a later method.
func TestReplRolledBackInstanceNotRequeued() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	var p @parser.Parser = parser.New(toBytes("var bx Box[int64]"), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	var r @DeclRollback = c.SnapshotDecl(d)
	c.CheckDeclInScope(d)
	c.RollbackDecl(r)
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if len(c.CheckerErrors()) != 0 {
		return "expected Bad accepted: no instance of Box is named"
	}
	return ""
}

// A method typed after an instance of its generic type exists is checked for
// that instance.
func TestReplMethodCheckedForEarlierInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "var bx Box[int64]")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected Bad rejected for Box[int64]"
	}
	return ""
}

// An instance the loaded main file names is checked for a method typed later.
func TestReplMainFileInstanceCheckedForLaterMethod() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Box[T any] struct { v T }\n"
			"var bx Box[int64]\n"
	var p @parser.Parser = parser.New(toBytes(src), "main.bn")
	var c @Checker = NewChecker()
	c.CheckMainPersistent(p.ParseFile())
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected Bad rejected for the main file's Box[int64]"
	}
	return ""
}

// An instance reached through one a later input names — checked earlier, for
// an input that was rejected — is checked for a method typed after that.
func TestReplLiveThroughCheckedInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Wrap[K any] struct { k K }")
	replCheckDecl(c, "func mk[T any]() int { var w Wrap[T]; w.k = w.k; return 0 }")
	replCheckDeclUndo(c, "func a() int { var y int = \"s\"; return y + mk[int64]() }")
	replCheckDecl(c, "func h() int { return mk[int64]() }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c,
			"func (w *Wrap[K]) Bad() int { var a [2]uint8; var z [sizeof(K)]uint8 = a; return len(z) }")
	if before == 0 || errorsContaining(c, "(in Wrap[int64].Bad") != 1 {
		return "expected Bad rejected for Wrap[int64], reached through mk[int64]"
	}
	return ""
}

// An instance a named instance's field refers to is checked for a method typed
// later: emitting the named instance's methods emits the field instance's.
func TestReplLiveThroughFieldInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() int { return 1 }")
	replCheckDecl(c, "type Pair[T any] struct { b *Box[T] }")
	replCheckDecl(c, "func (p *Pair[T]) PGet() int { return p.b.Get() }")
	replCheckDeclUndo(c, "var bad Pair[int64] = 5")
	replCheckDecl(c, "func h(p *Pair[int64]) int { return p.PGet() }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if before == 0 || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected Bad rejected for Box[int64], a field of Pair[int64]"
	}
	return ""
}

// An instance checked for a rejected input, not reached when a method is typed
// later, is checked for that method when a later input names it.
func TestReplUnreachedInstanceCheckedWhenNamedLater() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() int { return 1 }")
	replCheckDeclUndo(c, "func a() int { var y int = \"s\"; var bx Box[int64]; return y + bx.Get() }")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func g() int { var bx Box[int64]; return bx.Get() }")
	if len(c.CheckerErrors()) == before || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected g rejected for Box[int64].Bad"
	}
	return ""
}

// An instance a generic interface instance's method returns is checked for a
// method typed later where an input names the interface instance.
func TestReplInterfaceInstanceReachesStructInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() int { return 1 }")
	replCheckDecl(c, "interface Getter[T any] { Get() *Box[T] }")
	replCheckDeclUndo(c, "var bad @Getter[int64] = 5")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func h(g @Getter[int64]) int { return g.Get().Get() }")
	if len(c.CheckerErrors()) == before || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected h rejected for Box[int64].Bad"
	}
	return ""
}

// A method undone with its input takes back what re-checking for it recorded:
// a later method is not checked for an instance only the undone one reached.
func TestReplRolledBackMethodDepsRestored() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "var bx Box[int64]")
	replCheckDecl(c, "type Other[T any] struct { v T }")
	replCheckDeclUndo(c,
			"func (b *Box[T]) Bad() int { var o Other[T]; o.v = o.v; "
					"var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c,
			"func (o *Other[T]) M() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if before == 0 || len(c.CheckerErrors()) != before {
		return "expected M accepted: no committed code reaches Other[int64]"
	}
	return ""
}

// An instance checked for a rejected statement prompt — which nothing undoes —
// whose check named an instance of a type a method is later added to is
// checked again, with what it names, when a later input names it.
func TestReplStatementRejectedDependentRechecked() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() int { return 1 }")
	replCheckDecl(c, "func mk[T any]() *Box[T] { return nil }")
	replCheckStmts(c, "_ = mk[int64](); nosuch()")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "_ = mk[int64]().Get()")
	if len(c.CheckerErrors()) == before || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected the prompt rejected for Box[int64].Bad, reached through mk[int64]"
	}
	return ""
}

// The same through a struct instance's field.
func TestReplStatementRejectedFieldDependentRechecked() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() int { return 1 }")
	replCheckDecl(c, "type Pair[T any] struct { b *Box[T] }")
	replCheckDecl(c, "func (p *Pair[T]) PGet() int { return p.b.Get() }")
	replCheckStmts(c, "var p Pair[int64]; nosuch()")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func h(p *Pair[int64]) int { return p.PGet() }")
	if len(c.CheckerErrors()) == before || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected h rejected for Box[int64].Bad, a field of Pair[int64]"
	}
	return ""
}

// An instance whose check is forgotten when a method is added keeps no edges:
// an input that names it and adds a method does not reach, through what its
// forgotten check named, an instance only a rejected input named.
func TestReplForgottenInstanceDepsCleared() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "type P[T any] struct { v T }")
	replCheckDecl(c, "func (p *P[T]) m() int { var b Box[T]; b.v = b.v; return 0 }")
	replCheckStmts(c, "var p P[int64]; nosuch()")
	replCheckDecl(c, "func (p *P[T]) m() int { return 0 }")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var q P[int64]; q.v = q.v; "
					"var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	if len(c.CheckerErrors()) != before {
		return "expected Bad accepted: nothing the program names reaches Box[int64]"
	}
	return ""
}

// When a chain grows too deep, the instances left unchecked fail the
// instances that named them: a later input naming one of those checks it, and
// what it names, again.
func TestReplOverflowFailsNamersOfDropped() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	replCheckDecl(c, "func mk[T any]() int { var b Box[T]; return b.Bad() }")
	replCheckDecl(c, "func rec[T any]() int { return rec[*T]() }")
	replCheckStmts(c, "_ = mk[int64](); _ = rec[int64](); var b Box[int64]; b.v = b.v")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func h() int { return mk[int64]() }")
	if len(c.CheckerErrors()) == before || errorsContaining(c, "(in Box[int64].Bad") != 1 {
		return "expected h rejected for Box[int64].Bad, left unchecked by the overflow"
	}
	return ""
}
