package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_instance_naming.bn: an error found while an instance is worked
// on names it as it is reported, and an instance's constraint miss the generic's
// own check reported is not reported again.

// An error only W[int64]'s build finds, in W's declaration, names W[int64].
func TestInstanceBuildErrorNamesInstance() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype W[K any] struct { a [16 / (sizeof(K) - 8)]uint8 }\n"
					"func f() int { var w W[int64]; return len(w.a) }\n")
	return expectOneErr(c, "(in W[int64], instantiated at ")
}

// An error only g[int64]'s signature has names g[int64].
func TestInstanceSignatureErrorNamesInstance() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g[K any](a [16 / (sizeof(K) - 8)]uint8) int { return len(a) }\n"
					"func f() int { var a [2]uint8; return g[int64](a) }\n")
	return expectOneErr(c, "(in g[int64], instantiated at ")
}

// An error only a method's signature copied onto W[int64] has names W[int64].
func TestMethodSignatureErrorNamesInstance() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype W[K any] struct { b [4]uint8 }\n"
					"func (w *W[K]) m(a [16 / (sizeof(K) - 8)]uint8) int { return 0 }\n"
					"func f() int { var w W[int64]; _ = w; return 0 }\n")
	return expectOneErr(c, "division by zero in constant expression (in W[int64], instantiated at ")
}

// An error only GA[int64]'s target has names GA[int64].
func TestAliasTargetErrorNamesInstance() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype GA[K any] = [16 / (sizeof(K) - 8)]uint8\n"
					"func f() int { var w GA[int64]; return len(w) }\n")
	return expectOneErr(c, "(in GA[int64], instantiated at ")
}

// W2's own check reports `*M` missing G's constraint, spelled with W2's U; W2[int64]'s
// build finds the same miss, spelled with int64, and does not report it again.
func TestInstanceMissNotRepeated() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
							"type G[T Eq[U], U any] struct { t T }\n"
							"type M struct { v int }\n"
							"type W2[U any] struct { g *G[*M, U] }\n"
							"func f() int { var w W2[int64]; _ = w; return 0 }\n"),
			"type argument *M does not satisfy constraint Eq[U]")
}

// Y[V]'s field forms the abstract W[V, int32] while W[*N, S] is being built (S
// holds a Y[int32]): its miss names no instance, W[*N, S] least of all.
func TestNestedAbstractErrorNotNamed() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
					"type W[K Eq, J any] struct { g *G[K]; a [sizeof(J)]uint8 }\n"
					"type N struct { v int }\nfunc (n *N) eq() int { return 1 }\nimpl *N : Eq\n"
					"type T1 struct { w W[*N, S] }\ntype S struct { y Y[int32] }\n"
					"type Y[V any] struct { w W[V, int32] }\n")
	if anyErrContains(c, "(in W[*N, S]") {
		return fail("no error is W[*N, S]'s")
	}
	if !anyErrContains(c, "type argument V does not satisfy constraint Eq") {
		return fail("Y's miss must be reported")
	}
	return ""
}

// A miss an abstract instance reports (W[V]'s, formed in Y's declaration) is a
// declaration's: Y[int32]'s and W[int32]'s at the same positions repeat it.
func TestAbstractInstanceMissCoversConcrete() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
					"type W[K Eq] struct { g *G[K]; k K }\n"
					"type Q struct { y Y[int32] }\nfunc (q *Q) eq() int { return 1 }\nimpl *Q : Eq\n"
					"type Y[V any] struct { w W[V] }\n")
	if !anyErrContains(c, "type argument V does not satisfy constraint Eq") {
		return fail("Y's miss must be reported")
	}
	if anyErrContains(c, "type argument int32") {
		return fail("int32's misses repeat V's")
	}
	return ""
}

// declEnd reaches past a declaration's End to its last member's.
func TestDeclEndReachesMembers() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Pos = testPos(3, 1)
	d.End = testPos(3, 20)
	var m @ast.Decl = make(ast.Decl)
	m.End = testPos(6, 9)
	d.Decls = @[]@ast.Decl{m}
	var end token.Pos = declEnd(d)
	if end.Line != 6 || end.Col != 9 {
		return fail("declEnd must reach the last member's end")
	}
	if !inDecl(testPos(5, 2), d) || inDecl(testPos(7, 1), d) {
		return fail("inDecl must cover the declaration through its last member")
	}
	return ""
}

// testPos returns a position in file t.bn.
func testPos(line int, col int) token.Pos {
	var p token.Pos
	p.File = "t.bn"
	p.Line = line
	p.Col = col
	return p
}

// V's declaration forms Bad[[sizeof(T)]uint8], abstract though no type parameter
// is among its arguments (the length's placeholder): it names no instance, and
// Bad's error is reported once.
func TestPlaceholderInstanceNotNamed() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ntype V[T any] struct { p *Bad[[sizeof(T)]uint8] }\n"
							"type NotAnIface struct { x int }\ninterface Bad[T any] : NotAnIface { m() T }\n"
							"func f() int { var v V[int64]; _ = v; return 0 }\n"),
			"interface extension target must be an interface, got NotAnIface")
}

// Bad[int], built before Bad's own check, finds Bad's error first; the
// declaration's report stands for it, once, naming no instance.
func TestDeclarationErrorSupersedesInstances() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype T1 struct { p *Bad[int] }\n"
					"type NotAnIface struct { x int }\ninterface Bad[T any] : NotAnIface { m() T }\n")
	var r testing.TestResult = expectOneErr(c, "got NotAnIface")
	if len(r) > 0 { return r }
	if anyErrContains(c, "(in Bad[int]") {
		return fail("the declaration's error names no instance")
	}
	return ""
}

// A method's signature copied onto W[int64] while declarations are collected
// names W[int64].
func TestMethodCopiedDuringCollectionNamesInstance() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ntype T1 struct { w W[int64] }\ntype W[K any] struct { k K }\n"
							"func (w *W[K]) m(a [16 / (sizeof(K) - 8)]uint8) int { return 0 }\n"),
			"division by zero in constant expression (in W[int64], instantiated at ")
}

// W's own check reports K missing G's constraint; W[int32] (formed while
// declarations are collected, its check replayed after) and W[int64] (formed in a
// body) find the same miss, and neither reports it again.
func TestReplayedInstanceMissNotRepeated() testing.TestResult {
	return expectOneErr(
			checkSrc(
					"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
							"type W[K any] struct { g *G[K]; k K }\ntype T1 struct { w W[int32] }\n"
							"func f() int { var w W[int64]; _ = w; return 0 }\n"),
			"type argument K does not satisfy constraint Eq")
}

// Cmp's own check reports T missing G's constraint; Cmp[int32], built while
// H[int32, X]'s recorded check is replayed, and Cmp[int64] find the same miss
// and do not report it again, whichever comes first.
func TestReplayLevelNotInheritedByNestedMiss() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
					"interface Cmp[T any] { cmp(g *G[T]) int }\n"
					"type H[V any, U Cmp[V]] struct { u U }\ntype X struct { x int }\n"
					"type T0 struct { c *Cmp[int64] }\ntype T1 struct { h *H[int32, X] }\n")
	if countErrsContaining(c, "type argument T does not satisfy constraint Eq") != 1 {
		return fail("Cmp's miss must be reported once")
	}
	if anyErrContains(c, "type argument int32") || anyErrContains(c, "type argument int64") {
		return fail("Cmp[int32]'s and Cmp[int64]'s misses repeat Cmp's")
	}
	return ""
}

// countErrsContaining counts the errors c reported whose message contains needle.
func countErrsContaining(c @Checker, needle *[]readonly char) int {
	var errs @[]types.CheckError = c.CheckerErrors()
	var n int = 0
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, needle) { n = n + 1 }
	}
	return n
}

// A miss in a generic alias's target, reported by the alias's own check and by X's
// through it, is the declaration's: X[int32]'s and X[int64]'s are not reported
// again.
func TestAliasDeclarationMissNotRepeated() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
					"type A[U any] = *G[[sizeof(U) - 4]uint8]\ntype X[T any] struct { a A[T] }\n"
					"type T1 struct { x X[int32] }\n"
					"func f() int { var x X[int64]; _ = x; return 0 }\n")
	if !anyErrContains(c, "type argument [0]uint8 does not satisfy constraint Eq") {
		return fail("the declarations' miss must be reported")
	}
	if anyErrContains(c, "[4]uint8") {
		return fail("X[int64]'s miss repeats the declaration's")
	}
	return ""
}
