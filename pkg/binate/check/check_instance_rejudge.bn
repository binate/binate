package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// What an instance's build judged, judged again in each class of its checks.  An
// instance is built once, in the view of the naming that builds it (bindInstance:
// its view root, impl_view_root.bn), and the judgments the build makes -- the
// constraints of the instantiations its structure forms -- are latched by view
// (implViewKey).  A class of its checks resolves its structure again, from a new
// copy of the generic's declaration with the type arguments bound, in the class's
// view, the result discarded (rejudgeTypeStructure): in the class the build ran in
// the latches make that a no-op, and in another each judgment is made in that
// class's view.  An interface instance's method signatures and parents are
// resolved again the same way (rejudgeIfaceStructure).  A generic function
// instance's signature, and a method's, are resolved again with its body for each
// class (checkInstanceBody), and alone when the body is not checked
// (rejudgeInstanceSignature).  Views differ between two classes only by their view
// roots, so this is done only when an impl private to some package's .bn could
// serve the instance (privateImplMayServe) -- asked when the class is checked: a
// package's .bni may name an instance before the impls of its .bn are collected.

// rejudgeTypeStructure judges the structure of the struct instance w (a generic
// struct's fields, or another generic type's underlying type) again in w's class
// -- its instances named in w's lender class, chain and view root -- as its last
// build did, in a derivation or not (GenericInstantiation.BuildDerived); reports
// whether that found an error.
func rejudgeTypeStructure(c @Checker, w @InstWork) bool {
	var d @ast.Decl = w.TypeDecl
	if d.TypeRef == nil || d.IsAlias || !privateImplMayServe(c, w.Args) { return false }
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, d, w.Args)
	if entry == nil || entry.Result == nil || entry.Result.Underlying == nil { return false }
	var body @ast.Decl = ast.CloneDecl(d)
	var before int = len(c.Errors)
	var absorbed int = c.ErrorsAbsorbed
	var saved rejudgeScope = enterRejudge(c, w, entry)
	if body.TypeRef.Kind == ast.TEXPR_STRUCT {
		_ = resolveStructType(c, body.TypeRef)
	} else {
		_ = resolveTypeExpr(c, body.TypeRef)
	}
	leaveRejudge(c, saved)
	return contextualizeInstanceErrors(c, before, w, w.Label) || c.ErrorsAbsorbed > absorbed
}

// rejudgeIfaceStructure judges the method signatures and parents of the
// interface instance w again in w's class, as rejudgeTypeStructure does a struct
// instance's structure: resolved from a new copy of the generic's declaration and
// discarded, so the instance stays as its build made it, with `Self` bounded by
// the instance itself, whose parents are known -- the `Self` checks the
// resolution queues are made before it ends (recheckSelfConstraints).  Reports
// whether that found an error.
func rejudgeIfaceStructure(c @Checker, w @InstWork) bool {
	var d @ast.Decl = w.TypeDecl
	if !privateImplMayServe(c, w.Args) { return false }
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, d, w.Args)
	if entry == nil || entry.Result == nil || entry.MembersDeferred { return false }
	var body @ast.Decl = ast.CloneDecl(d)
	var before int = len(c.Errors)
	var absorbed int = c.ErrorsAbsorbed
	var saved rejudgeScope = enterRejudge(c, w, entry)
	var savedAllowSelf bool = c.AllowSelf
	var savedSelfBound @types.Type = c.SelfBound
	c.AllowSelf = true
	c.SelfBound = entry.Result
	for i := 0; i < len(body.Decls); i++ {
		var m @ast.Decl = body.Decls[i]
		if m != nil && m.Kind == ast.DECL_FUNC { _ = resolveFuncDeclType(c, m) }
	}
	c.AllowSelf = savedAllowSelf
	c.SelfBound = savedSelfBound
	for i := 0; i < len(body.Interfaces); i++ {
		if body.Interfaces[i] != nil { _ = resolveTypeExprAllowInterface(c, body.Interfaces[i]) }
	}
	if !c.CollectingDecls && !c.BuildingIfaceScope { recheckSelfConstraints(c, entry.Result) }
	leaveRejudge(c, saved)
	return contextualizeInstanceErrors(c, before, w, w.Label) || c.ErrorsAbsorbed > absorbed
}

// A rejudgeScope is what enterRejudge changes, for leaveRejudge to restore.
type rejudgeScope struct {
	Current  @InstWork
	Deriving bool
	Spec     bool
	Indirect int
	Bound    instanceBinding
	Scope    @Scope
	PkgPath  @[]char
}

// enterRejudge enters the resolution of the instance w, whose instantiation
// entry is entry, in w's class, as its last build resolved it: with w the
// instance worked on, in a derivation when the build was, and its type arguments
// bound in the generic's declaring scope and package.
func enterRejudge(c @Checker, w @InstWork, entry @GenericInstantiation) rejudgeScope {
	var d @ast.Decl = w.TypeDecl
	var st @InstanceState = instanceState(c)
	var saved rejudgeScope
	saved.Current = st.Current
	st.Current = w
	saved.Deriving = c.Generics.DerivingInstanceSig
	c.Generics.DerivingInstanceSig = entry.BuildDerived
	saved.Spec = c.Generics.Speculative
	c.Generics.Speculative = false
	saved.Indirect = enterByValue(c)
	pushInstanceNaming(c, w, d)
	saved.Bound = bindInstanceIn(c, w.Args, true, w.Lenders, w.ChainRoot, w.VRoot)
	saved.Scope = c.Scope
	saved.PkgPath = c.curPkgPath
	c.curPkgPath = c.GenericDeclPkg(d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams) && i < len(w.Args); i++ {
		if !isBlank(d.TypeParams[i].Name) { defineType(c.Scope, d.TypeParams[i].Name, w.Args[i]) }
	}
	return saved
}

// leaveRejudge ends what enterRejudge began, restoring saved.
func leaveRejudge(c @Checker, saved rejudgeScope) {
	c.Scope = saved.Scope
	c.curPkgPath = saved.PkgPath
	unbindInstance(c, saved.Bound)
	popInstanceNaming(c)
	leaveByValue(c, saved.Indirect)
	c.Generics.Speculative = saved.Spec
	c.Generics.DerivingInstanceSig = saved.Deriving
	instanceState(c).Current = saved.Current
}

// rejudgeInstanceSignature judges the signature of the generic function or method
// d, whose body is not checked for the instance w (its abstract check failed or
// did not run), again in w's class, as checkInstanceBody does with a body; label
// names the instance in the errors.  Reports whether that found an error.
func rejudgeInstanceSignature(c @Checker, w @InstWork, d @ast.Decl, home @Scope, pkg @[]char,
		label *[]readonly char) bool {
	if !privateImplMayServe(c, w.Args) { return false }
	var clone @ast.Decl = ast.CloneFuncSignature(d)
	var noParams @[]@ast.TypeParam
	clone.TypeParams = noParams
	var saved instanceCheckScope = enterInstanceCheck(c, w, d, home, pkg)
	var before int = len(c.Errors)
	var absorbed int = c.ErrorsAbsorbed
	_ = instanceCheckSignature(c, w, d, clone)
	var failed bool = contextualizeInstanceErrors(c, before, w, label) || c.ErrorsAbsorbed > absorbed
	leaveInstanceCheck(c, saved)
	return failed
}
