package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_instance_rejudge.bn, with pkg/lib's Tag, W, HW and T
// (impl_view_root_test.bn).

// A struct instance first built in a derivation -- MkHW's signature, named in
// lib's .bn -- has its fields judged again as derived in q's class of its checks.
func TestRejudgeStructureDerived() testing.TestResult {
	var c @Checker = checkViewUser(
			"func MkHW[V Tag[[sizeof(U)]uint8], U any]() *HW[V, U] { return nil }\n",
			"func mk() int {\n\tvar p *HW[@T, int64] = MkHW[@T, int64]()\n\treturn 0\n}\n",
			"func F() int {\n\tvar p *lib.HW[@lib.T, int64] = lib.MkHW[@lib.T, int64]()\n\treturn 0\n}\n")
	if errorsContaining(c,
			"does not satisfy constraint Tag[[4]uint8]: the matching impl is private") != 1 {
		return fail(allErrorMsgs(c))
	}
	return ""
}

// A generic function whose body has an error is not checked per instance, but its
// signature is judged again in each class: Bad's parameter forms W[@T, int32].
func TestRejudgeSignatureWithoutBody() testing.TestResult {
	var c @Checker = checkViewUser(
			"func Bad[V Tag[[sizeof(U)]uint8], U any](p *W[V, int32]) int { return undefinedName }\n",
			"func bad() int { return Bad[@T, int64](nil) }\n",
			"func F() int { return lib.Bad[@lib.T, int64](nil) }\n")
	if errorsContaining(c, "undefined: undefinedName") != 1 {
		return fail(buf.Concat("expected the body's error once; ", allErrorMsgs(c)))
	}
	if errorsContaining(c, "the matching impl is private to package pkg/lib (in Bad[@T, int64]") != 1 {
		return fail(buf.Concat("expected the signature's miss once; ", allErrorMsgs(c)))
	}
	return ""
}

// allErrorMsgs returns c's errors, one per line.
func allErrorMsgs(c @Checker) @[]char {
	var all @[]char = buf.CopyStr("errors:")
	for i := 0; i < len(c.CheckerErrors()); i++ {
		all = buf.Concat(buf.Concat(all, "\n"), c.CheckerErrors()[i].Msg)
	}
	return all
}
