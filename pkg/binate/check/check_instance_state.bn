package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Whether an instance still needs its check.  Each instance — a FuncInstance,
// or a concrete instantiation of a generic struct — has an InstCheckState,
// shared with the InstWork that queues it.  An instance is queued when it is
// first named, and queued again when named again if its check has not run (it
// was dropped with a REPL declaration that parked, or left on the stack when a
// chain grew too deep) or failed in an earlier drain.  So a REPL prompt that
// repeats a rejected one is rejected again, and an instance a declaration
// names is checked with that declaration, not with whichever prompt comes next.
// An instance's check is only as good as those of the instances it names, so a
// failure fails each instance that named it (failInstanceChain).  Which
// instances a REPL program names, checked again when a later input adds a
// method, is check_instance_live.bn's.

// InstCheckState is the check of one instance: Queued while it waits on the
// stack or is being checked; OK when its last check reported no error; Epoch
// the InstanceState.Epoch of that check (-1 before any); Site where the chain
// that first named it starts; Live how many REPL inputs that checked name it;
// Namers the instances whose check named it while it was queued or in the
// drain that checked it (the one its chain's parent among them); Deps the
// instances its last check named, and for a struct instance those its fields
// refer to; Reach the last markProgramInstances stamp that reached it.  Owners
// are the packages whose opaque exports the instance's type arguments carry,
// Lenders those of them whose exports its body sees (its lender class), and
// Next the state of the instance's next lender class, if any
// (check_instance_lenders.bn).
// Namers and Deps refer to other states without owning them: the states live
// as long as their instances' records (FuncInstance, GenericInstantiation) --
// a record dropped with an undone REPL declaration takes the edges to its
// states with it (dropInstCaches) -- and the edges can form cycles.
type InstCheckState struct {
	Queued  bool
	OK      bool
	Epoch   int
	Site    token.Pos
	Live    int
	Namers  @[]*InstCheckState
	Deps    @[]*InstCheckState
	Reach   int
	Owners  @[]@[]char
	Lenders @[]@[]char
	Next    @InstCheckState
}

// newInstCheckState returns the check state of an instance first named at
// site, by the instance being checked if any: the site is its chain's.
func newInstCheckState(c @Checker, site token.Pos) @InstCheckState {
	var s @InstCheckState = make(InstCheckState)
	s.Epoch = -1
	s.Site = site
	var root @InstWork = instanceState(c).Current
	for root != nil && root.Parent != nil {
		root = root.Parent
	}
	if root != nil {
		s.Site = root.Site
	}
	return s
}

// noteInstanceNamed records that the instance whose state is s was named: for
// the REPL input being checked (InstanceState.Named, when tracked), and for
// the instance whose check named it, if any — which, at the REPL, depends on s
// (Deps); s, queued or checked in this drain, remembers it (failInstanceChain),
// and s having failed in this drain fails it.
func noteInstanceNamed(c @Checker, s @InstCheckState) {
	var st @InstanceState = instanceState(c)
	if st.TrackNamed {
		pushNamed(st, s)
	}
	var cur @InstWork = st.Current
	if cur == nil || same(cur.State, s) {
		return
	}
	if st.TrackNamed {
		addDep(cur.State, s)
	}
	if s.Queued || s.Epoch == st.Epoch {
		addNamer(s, cur.State)
	}
	if !s.Queued && !s.OK && s.Epoch == st.Epoch {
		cur.DepFailed = true
	}
}

// addNamer records the instance whose state is n as one whose check named the
// instance whose state is s, once.
func addNamer(s @InstCheckState, n @InstCheckState) {
	if n == nil || same(n, s) {
		return
	}
	var raw *InstCheckState = n
	for i := 0; i < len(s.Namers); i++ {
		if same(s.Namers[i], raw) {
			return
		}
	}
	s.Namers = slices.Append[*InstCheckState](s.Namers, raw)
}

// failInstanceChain records a failure for each instance whose check named the
// failed instance whose state is s (Namers), and for those that named them in
// turn.
func failInstanceChain(st @InstanceState, s *InstCheckState) {
	if s == nil {
		return
	}
	for i := 0; i < len(s.Namers); i++ {
		failNamer(st, s.Namers[i])
	}
}

// failNamer records a failure for the instance n, which named a failed one,
// and for what named it — unless n already failed in this drain, or is queued:
// its check, still to come, names the failed one again (DepFailed).
func failNamer(st @InstanceState, n *InstCheckState) {
	if n == nil || n.Queued || (!n.OK && n.Epoch == st.Epoch) {
		return
	}
	n.OK = false
	n.Epoch = st.Epoch
	failInstanceChain(st, n)
}

// needsInstanceCheck reports whether the instance whose check state is s is
// to be queued when named: it is not queued, and its check has not run or
// failed in an earlier drain.
func needsInstanceCheck(c @Checker, s @InstCheckState) bool {
	if s == nil || s.Queued || s.OK {
		return false
	}
	return s.Epoch != instanceState(c).Epoch
}

// noteInstanceChecked records the outcome of the check of the instance whose
// state is s: it passed when ok.
func noteInstanceChecked(st @InstanceState, s @InstCheckState, ok bool) {
	if s == nil {
		return
	}
	s.Queued = false
	s.OK = ok
	s.Epoch = st.Epoch
}

// discardInstWork drops the instances queued above floor on st's stack
// unchecked; each is queued again when next named.
func discardInstWork(st @InstanceState, floor int) {
	for i := floor; i < st.Top; i++ {
		var s @InstCheckState = st.Queue.Get(i).State
		if s != nil {
			s.Queued = false
			s.Epoch = -1
		}
	}
	st.Top = floor
}

// A bniWork is an instance check the .bni of the package Pkg queued as it was
// loaded (keepBniWork).
type bniWork struct {
	Pkg  @[]char
	Work @InstWork
}

// keepBniWork keeps, for the package path's own check (requeueBniWork), the
// instance checks queued above floor while its .bni was loaded, which are then
// dropped: an instance a .bni names is named where its package's exports are
// opaque, a lender class the package's .bn may never name it in.
func keepBniWork(c @Checker, path @[]char, floor int) {
	var st @InstanceState = instanceState(c)
	if st.Top <= floor { return }
	if st.BniWork == nil { st.BniWork = vec.New[bniWork]() }
	for i := floor; i < st.Top; i++ {
		var b bniWork
		b.Pkg = path
		b.Work = st.Queue.Get(i)
		st.BniWork.Push(b)
	}
}

// requeueBniWork queues again, in the package path's own check, each instance
// check its .bni queued as it was loaded (keepBniWork) that still needs one
// (needsInstanceCheck).
func requeueBniWork(c @Checker, path *[]readonly char) {
	var st @InstanceState = instanceState(c)
	if st.BniWork == nil { return }
	var rest @vec.Vec[bniWork] = vec.New[bniWork]()
	for i := 0; i < st.BniWork.Len(); i++ {
		var b bniWork = st.BniWork.Get(i)
		if !types.CharEq(b.Pkg, path) {
			rest.Push(b)
		} else if needsInstanceCheck(c, b.Work.State) {
			b.Work.State.Queued = true
			pushInstWork(st, b.Work)
		}
	}
	st.BniWork = rest
}

// reverseInstWork reverses st's stack above floor, so the instances one body
// named, pushed in the order it names them, are popped in that order.
func reverseInstWork(st @InstanceState, floor int) {
	var i int = floor
	var j int = st.Top - 1
	for i < j {
		var w @InstWork = st.Queue.Get(i)
		st.Queue.Set(i, st.Queue.Get(j))
		st.Queue.Set(j, w)
		i++
		j--
	}
}

// finishInstanceDrain ends a drain of st's stack down to floor: what an
// overflow left above floor is dropped unchecked, failing what named it
// (failDiscardedNamers), and the drain's checks are an epoch of their own.
func finishInstanceDrain(st @InstanceState, floor int) {
	failDiscardedNamers(st, floor)
	st.Epoch++
	discardInstWork(st, floor)
	st.Overflowed = false
}

// failDiscardedNamers records, when an overflow ends the drain, a failure for
// each instance whose check named one left on st's stack above floor: that one
// is dropped unchecked, so they are checked again when next named.
func failDiscardedNamers(st @InstanceState, floor int) {
	if !st.Overflowed {
		return
	}
	for i := floor; i < st.Top; i++ {
		var s @InstCheckState = st.Queue.Get(i).State
		if s != nil {
			failInstanceChain(st, s)
		}
	}
}

// drainTentativeInstances checks the instances queued above floor while REPL
// declarations are checked tentatively (checkDeclsTentative), as part of
// their check: an instance's errors join theirs in c.TentativeErrors.
func drainTentativeInstances(c @Checker, floor int) {
	var mark int = len(c.Errors)
	c.TentativeMode = false
	drainInstancesAbove(c, floor)
	c.TentativeMode = true
	for i := mark; i < len(c.Errors); i++ {
		c.TentativeErrors = slices.Append[types.CheckError](c.TentativeErrors, c.Errors[i])
	}
	c.Errors = c.Errors[:mark]
}

// queueStructInstance gives the new instantiation entry, named at site, a
// check state when it is a concrete struct instance — its method bodies and
// parameterized impls are checked for its type arguments (gen.mono.check) —
// and queues that check, unless the instance is derived for a method a REPL
// input copies into an existing instance (backfillQueueSkipped), noting it
// named (noteInstanceNamed) when the program names it there (namedByProgram).
// For a concrete interface instance it records the lender class it is named
// in (ifaceClassNew): its population names its methods' struct instances in it.
func queueStructInstance(c @Checker, entry @GenericInstantiation, isIface bool, site token.Pos,
		userFacing bool) {
	if typeListMentionsTypeParam(entry.TypeArgs) {
		return
	}
	if isIface {
		entry.IfaceOwners = exportOwners(c, entry.TypeArgs)
		_ = ifaceClassNew(c, entry)
		return
	}
	entry.InstState = firstInstState(c, entry.TypeArgs, site)
	if backfillQueueSkipped(c) {
		return
	}
	enqueueTypeWork(c, entry.Decl, entry.TypeArgs, site, entry.InstState)
	if namedByProgram(c, userFacing) {
		noteInstanceNamed(c, entry.InstState)
	}
}

// requeueStructInstance queues again, named at site, the check of the cached
// instantiation entry, in the lender class it is named in (instStateFor), when
// it needs it (needsInstanceCheck) — unless named
// for a method a REPL input copies into an existing instance
// (backfillQueueSkipped) — and notes it named (noteInstanceNamed) when the
// program names it there (namedByProgram).  For a generic interface instance it
// does so for the struct instances its methods refer to
// (noteInterfaceInstances): at the REPL, each time; in a compilation, when it
// is named in a lender class it was not named in before (ifaceClassNew) — those
// of its first were queued when it was populated.
func requeueStructInstance(c @Checker, entry @GenericInstantiation, site token.Pos,
		userFacing bool) {
	if backfillQueueSkipped(c) {
		return
	}
	if entry.InstState == nil {
		if entry.Result != nil && entry.Result.Kind == types.TYP_INTERFACE &&
				(instanceState(c).TrackNamed || ifaceClassNew(c, entry)) {
			noteInterfaceInstances(c, entry.Result, site, userFacing)
		}
		return
	}
	var s @InstCheckState = instStateFor(c, entry.InstState, site)
	if needsInstanceCheck(c, s) {
		enqueueTypeWork(c, entry.Decl, entry.TypeArgs, site, s)
	}
	if namedByProgram(c, userFacing) {
		noteInstanceNamed(c, s)
	}
}

// backfillQueueSkipped reports whether an instance named here is left
// unqueued: it is derived while a REPL input's new method is copied into the
// existing instances (InstanceState.Backfilling), one of which may be named
// only by a rejected input; the instances a named instance's methods derive
// are named again by its own check.  This is so whenever the checker is a REPL
// session's (TrackNamed), a package imported mid-session included; a
// compilation queues them like any other.
func backfillQueueSkipped(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	return st.Backfilling && st.TrackNamed
}

// namedByProgram reports whether an instantiation resolved here is one the
// program names, for the REPL's records (noteInstanceNamed): a user-facing one
// (not a speculative probe or a signature derived for an instance), or one in
// an instance's check — the instances an instance names are part of the
// program with it.
func namedByProgram(c @Checker, userFacing bool) bool {
	return userFacing || instanceState(c).Current != nil
}
