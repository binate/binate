package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/parser"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for check_instance_state.bn: an instance a later REPL prompt names is
// checked again after its check failed or was dropped; an instance a
// declaration names is checked with that declaration, when it resolves; an
// instance is checked again when a later prompt adds a method its check
// covers; and the stack of instances to check is popped in the order named.

// badGenericSrc declares g, whose instances fail unless sizeof(T) is 2: its body
// assigns a [2]uint8 to a [sizeof(T)]uint8.
func badGenericSrc() *[]readonly char {
	return "func g[T any]() int { var a [2]uint8; var b [sizeof(T)]uint8 = a; return len(b) }"
}

// A prompt repeating a rejected one is rejected again.
func TestReplInstanceRejectedAgain() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, badGenericSrc())
	replCheckStmts(c, "_ = g[int64]()")
	replCheckStmts(c, "_ = g[int64]()")
	if errorsContaining(c, "(in g[int64]") != 2 {
		return "expected each prompt naming g[int64] rejected"
	}
	return ""
}

// An instance's error with the message and position an earlier prompt's
// instance reported is still reported at its own prompt.
func TestReplInstanceErrorRepeatedAcrossPrompts() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, badGenericSrc())
	replCheckStmts(c, "_ = g[int32]()")
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "_ = g[uint32]()")
	if before != 1 || errorsContaining(c, "(in g[uint32]") != 1 {
		return "expected g[uint32] rejected at its own prompt"
	}
	return ""
}

// A prompt repeating one rejected for an instance its instance names — further
// down the chain — is rejected again.
func TestReplChainFailureRejectedAgain() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, badGenericSrc())
	replCheckDecl(c, "func h[T any]() int { return g[@T]() }")
	replCheckStmts(c, "_ = h[int]()")
	replCheckStmts(c, "_ = h[int]()")
	if errorsContaining(c, "(in g[@int]") != 2 {
		return "expected each prompt naming h[int] rejected for g[@int]"
	}
	return ""
}

// An instance named by an earlier prompt reached only through a second chain
// fails that chain too: a later prompt naming it is rejected again.
func TestReplSecondNamerFails() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, badGenericSrc())
	replCheckDecl(c, "func h[T any]() int { return g[T]() }")
	replCheckStmts(c, "_ = g[int64]() + h[int64]()")
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "_ = h[int64]()")
	if before == 0 || len(c.CheckerErrors()) == before {
		return "expected h[int64] rejected: it names the failing g[int64]"
	}
	return ""
}

// A failure reaches an instance that named, after its check passed in the
// same drain, one that then fails through another: with mutual recursion, a
// later prompt naming it is rejected too.
func TestReplMutualRecursionFailureReachesNamer() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func g[T any]() int { var a [2]uint8; var b [sizeof(T)]uint8 = a; return len(b) }\n"
			"func f[T any]() int { return q[T]() + g[T]() }\n"
			"func q[T any]() int { return f[T]() }\n"
	var p @parser.Parser = parser.New(toBytes(src), "main.bn")
	var c @Checker = NewChecker()
	c.CheckMainPersistent(p.ParseFile())
	replCheckStmts(c, "_ = f[int64]()")
	replCheckStmts(c, "_ = q[int64]()")
	if errorsContaining(c, "(in g[int64]") != 2 {
		return "expected each prompt rejected for g[int64]"
	}
	return ""
}

// A new method copied into an instance only a rejected prompt named does not
// check the instances its signature derives for that instance.
func TestReplBackfillDerivedInstanceNotChecked() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c,
			"func (b *Box[T]) Bad() int { var a [2]uint8; var z [sizeof(T)]uint8 = a; return len(z) }")
	replCheckDecl(c, "type Wrap[K any] struct { k K }")
	replCheckDeclUndo(c, "var w Wrap[int16] = 5")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "func (w *Wrap[K]) Get() *Box[K] { return nil }")
	if before == 0 || len(c.CheckerErrors()) != before {
		return "expected Get accepted: no program names Box[int16]"
	}
	return ""
}

// A chain that grows too deep is reported at each prompt that names it.
func TestReplDepthErrorRepeated() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func d[T any](n int) int { if n == 0 { return 0 }; return d[@T](n - 1) }")
	replCheckStmts(c, "_ = d[int](3)")
	replCheckStmts(c, "_ = d[int](3)")
	if errorsContaining(c, "nested too deeply") != 2 {
		return "expected the depth error at each prompt"
	}
	return ""
}

// An instance a parked declaration names is checked when the declaration is
// retried, as part of its check: the retry fails with the instance's error,
// and the next prompt is not rejected for it.
func TestReplRetriedDeclChecksItsInstances() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, badGenericSrc())
	replCheckDecl(c, "func h() int { return g[int64]() + k() }")
	if !c.IsPendingDecl("h") || len(c.CheckerErrors()) != 0 {
		return "h must park on k, with no error"
	}
	replCheckDecl(c, "func k() int { return 1 }")
	var out @[]@types.RetriedDecl = c.RetryPendingDecls()
	var failed bool = false
	for i := 0; i < len(out); i++ {
		for j := 0; j < len(out[i].Errs); j++ {
			if !out[i].Resolved && msgContains(out[i].Errs[j].Msg, "(in g[int64]") {
				failed = true
			}
		}
	}
	if !failed {
		return "h's retry must fail with g[int64]'s error"
	}
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "_ = 1")
	if len(c.CheckerErrors()) != before {
		return "the next prompt must not be rejected for h's instance"
	}
	return ""
}

// A generic method whose body parks is not checked for an instance named
// later: its unbound name is not reported against that prompt.
func TestReplParkedMethodNotCheckedPerInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() T { zz(); return b.v }")
	replCheckDecl(c, "var bx Box[int]")
	if len(c.CheckerErrors()) != 0 {
		return "a parked method's body must not be checked for a later instance"
	}
	return ""
}

// The instances one declaration names are checked, and their errors listed,
// in the order it names them.
func TestInstanceSiblingsInSourceOrder() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any]() int { var a [2]uint8; var b [sizeof(T)]uint8 = a; return len(b) }\n"
			"func h() int { return g[int32]() + g[int64]() }\n"
	var errs @[]types.CheckError = checkSrc(src).CheckerErrors()
	if len(errs) != 2 || !msgContains(errs[0].Msg, "(in g[int32]") ||
			!msgContains(errs[1].Msg, "(in g[int64]") {
		return "expected g[int32]'s error, then g[int64]'s"
	}
	return ""
}

// discardInstWork drops the stack above a floor, marking what it drops as not
// queued and never checked; reverseInstWork reverses the stack above a floor.
func TestInstWorkDiscardAndReverse() testing.TestResult {
	var c @Checker = NewChecker()
	var st @InstanceState = instanceState(c)
	for i := 0; i < 3; i++ {
		var w @InstWork = make(InstWork)
		w.Depth = i
		w.State = newInstCheckState(c, w.Site)
		w.State.Queued = true
		w.State.Epoch = 5
		pushInstWork(st, w)
	}
	reverseInstWork(st, 1)
	if st.Queue.Get(0).Depth != 0 || st.Queue.Get(1).Depth != 2 || st.Queue.Get(2).Depth != 1 {
		return "reverseInstWork must reverse only above its floor"
	}
	var dropped @InstCheckState = st.Queue.Get(2).State
	discardInstWork(st, 1)
	if st.Top != 1 || dropped.Queued || dropped.Epoch != -1 || !st.Queue.Get(0).State.Queued {
		return "discardInstWork must drop, unqueued and unchecked, only above its floor"
	}
	return ""
}

// An instance first named inside an instance's check has its chain's site.
func TestInstCheckStateChainSite() testing.TestResult {
	var c @Checker = NewChecker()
	var root @InstWork = make(InstWork)
	root.Site.Line = 7
	var child @InstWork = make(InstWork)
	child.Parent = root
	child.Site.Line = 12
	instanceState(c).Current = child
	var inner token.Pos
	inner.Line = 30
	if newInstCheckState(c, inner).Site.Line != 7 {
		return "expected the chain root's site"
	}
	return ""
}

// Loading a package interface leaves no instance queued: those it names are
// checked where they are named by the program.
func TestLoadPackageInterfaceQueuesNothing() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("foo",
			mkBniFile("package \"foo\"\ntype Box[T any] struct { v T }\n"
					"func F(b Box[int]) int\n"))
	if instanceState(c).Top != 0 {
		return "expected no instance queued"
	}
	return ""
}
