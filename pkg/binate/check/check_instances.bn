package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/vec"

// Instances of generic functions (spec gen.mono, gen.mono.check).  A generic
// function's declaration is checked once with its type parameters abstract;
// each instantiation the program names with concrete type arguments is a
// FuncInstance, whose signature is resolved from its own copy of the
// declaration's signature, in the scope the generic is declared in, with the
// type parameters bound to the arguments — so a length that depends on a type
// parameter (`[sizeof(T)]uint8`) has its value for that instantiation, where
// substituting the arguments into the abstract signature would keep the
// abstract placeholder.

// GenericHome records where the generic function Decl is declared: the scope
// its signature and body resolve in (its file's imports and its package's
// declarations) and its package path.  Checked is set once its body has been
// checked with its type parameters abstract, BodyErrs if that check reported
// an error (its instances are then not checked).
type GenericHome struct {
	Decl     @ast.Decl
	Scope    @Scope
	Pkg      @[]char
	Checked  bool
	BodyErrs bool
}

// FuncInstance is the generic function Decl instantiated with the concrete type
// arguments Args; Sig is its signature for them, State its body's check.
type FuncInstance struct {
	Decl  @ast.Decl
	Args  @[]@types.Type
	Sig   @types.Type
	State @InstCheckState
}

// InstanceState holds the generic functions' homes and their instances, and
// the instances whose bodies are still to be checked: a stack (Queue[:Top]),
// so the instances one body names are checked before its siblings and a chain
// that grows without bound reaches MAX_INSTANCE_DEPTH before its fan-out
// multiplies (Overflowed then stops the check).  Current is the instance being
// checked; Epoch counts the drains of the stack (drainInstancesAbove).  At the
// REPL (TrackNamed), Named[:NamedTop] records the instances the input being
// checked names (commitNamed), and Snapshot is the driver's snapshot of the
// declaration being checked (SnapshotDecl).
type InstanceState struct {
	Homes      @vec.Vec[@GenericHome]
	Funcs      @vec.Vec[@FuncInstance]
	Queue      @vec.Vec[@InstWork]
	Top        int
	Overflowed bool
	Current    @InstWork
	Epoch      int
	Named      @vec.Vec[@InstCheckState]
	NamedTop   int
	TrackNamed bool
	Snapshot   @DeclRollback
}

// instanceState returns c's instance state, creating it on first use.
func instanceState(c @Checker) @InstanceState {
	if c.Instances == nil {
		var st @InstanceState = make(InstanceState)
		st.Homes = vec.New[@GenericHome]()
		st.Funcs = vec.New[@FuncInstance]()
		st.Queue = vec.New[@InstWork]()
		st.Named = vec.New[@InstCheckState]()
		c.Instances = st
	}
	return c.Instances
}

// recordGenericHome records the current scope and package as the home of the
// generic function declaration d (a later record for d replaces an earlier one,
// as when the REPL redefines it).
func recordGenericHome(c @Checker, d @ast.Decl) {
	var st @InstanceState = instanceState(c)
	var h @GenericHome = make(GenericHome)
	h.Decl = d
	h.Scope = c.Scope
	h.Pkg = buf.CopyStr(c.curPkgPath)
	for i := 0; i < st.Homes.Len(); i++ {
		if same(st.Homes.Get(i).Decl, d) {
			h.Checked = st.Homes.Get(i).Checked
			h.BodyErrs = st.Homes.Get(i).BodyErrs
			st.Homes.Set(i, h)
			return
		}
	}
	st.Homes.Push(h)
}

// genericHomeOf returns the home of the generic function declaration d, or nil.
func genericHomeOf(c @Checker, d @ast.Decl) @GenericHome {
	if c.Instances == nil {
		return nil
	}
	for i := 0; i < c.Instances.Homes.Len(); i++ {
		if same(c.Instances.Homes.Get(i).Decl, d) {
			return c.Instances.Homes.Get(i)
		}
	}
	return nil
}

// genericFuncDecl returns the declaration of the generic function whose type is
// ft (the owner of its type parameters), or nil.
func genericFuncDecl(ft @types.Type) @ast.Decl {
	if ft == nil || len(ft.TypeParams) == 0 || ft.TypeParams[0] == nil ||
			ft.TypeParams[0].TpOwner == nil {
		return nil
	}
	return bit_cast(@ast.Decl, ft.TypeParams[0].TpOwner)
}

// funcInstance returns the instance of the generic function declaration d for
// the concrete type arguments args, creating it on first use — resolving its
// signature in d's home and queuing its body check, named at site — and queuing
// the check again when it needs it (needsInstanceCheck); nil when d has no
// recorded home.
func funcInstance(c @Checker, d @ast.Decl, args *[]@types.Type, site token.Pos) @FuncInstance {
	var home @GenericHome = genericHomeOf(c, d)
	if home == nil {
		return nil
	}
	var st @InstanceState = instanceState(c)
	for i := 0; i < st.Funcs.Len(); i++ {
		var fi @FuncInstance = st.Funcs.Get(i)
		if same(fi.Decl, d) && typeListsIdentical(fi.Args, args) {
			if needsInstanceCheck(c, fi.State) {
				enqueueFuncWork(c, d, args, site, fi.State)
			}
			noteInstanceNamed(c, fi.State)
			return fi
		}
	}
	var inst @FuncInstance = make(FuncInstance)
	inst.Decl = d
	inst.Args = copyTypeList(args)
	inst.Sig = resolveInstanceSignature(c, home, d, args)
	inst.State = newInstCheckState(c, site)
	st.Funcs.Push(inst)
	enqueueFuncWork(c, d, args, site, inst.State)
	noteInstanceNamed(c, inst.State)
	return inst
}

// resolveInstanceSignature resolves the signature of the generic function
// declaration d from a copy of it, in its home with each type parameter bound
// to its argument.
func resolveInstanceSignature(c @Checker, home @GenericHome, d @ast.Decl,
		args *[]@types.Type) @types.Type {
	var sig @ast.Decl = ast.CloneFuncSignature(d)
	var noParams @[]@ast.TypeParam
	sig.TypeParams = noParams
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = home.Pkg
	c.Scope = NewScope(home.Scope)
	for i := 0; i < len(d.TypeParams) && i < len(args); i++ {
		if !isBlank(d.TypeParams[i].Name) {
			defineType(c.Scope, d.TypeParams[i].Name, args[i])
		}
	}
	var savedDeriving bool = c.DerivingInstanceSig
	c.DerivingInstanceSig = true
	var ft @types.Type = resolveFuncDeclType(c, sig)
	c.DerivingInstanceSig = savedDeriving
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	return ft
}

// checkErrorCount counts what the check has found wrong so far: the errors
// reported, and under TentativeMode those captured and the names used that
// nothing binds (a REPL declaration's body that parks on one is not clean).
func checkErrorCount(c @Checker) int {
	return len(c.Errors) + len(c.TentativeErrors) + len(c.TentativeMissing)
}

// noteGenericBodyChecked records that the body of d — a generic function, or a
// method of a generic type — was checked with its type parameters abstract, and
// whether that check reported an error.
func noteGenericBodyChecked(c @Checker, d @ast.Decl, hadErrs bool) {
	if d.Recv == nil {
		var home @GenericHome = genericHomeOf(c, d)
		if home != nil {
			home.Checked = true
			home.BodyErrs = hadErrs
		}
		return
	}
	for i := 0; i < len(c.GenericMethods); i++ {
		if same(c.GenericMethods[i].Decl, d) {
			c.GenericMethods[i].Checked = true
			c.GenericMethods[i].BodyErrs = hadErrs
			return
		}
	}
}

// typeListsIdentical reports whether a and b hold strictly identical types,
// position by position.
func typeListsIdentical(a *[]@types.Type, b *[]@types.Type) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if !a[i].IdenticalStrict(b[i]) {
			return false
		}
	}
	return true
}

// copyTypeList returns a managed copy of ts.
func copyTypeList(ts *[]@types.Type) @[]@types.Type {
	var out @[]@types.Type = make_slice(@types.Type, len(ts))
	for i := 0; i < len(ts); i++ {
		out[i] = ts[i]
	}
	return out
}

// typeListMentionsTypeParam reports whether a type parameter (or Self) occurs
// in any of ts.
func typeListMentionsTypeParam(ts *[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if mentionsTypeParam(ts[i], 0) {
			return true
		}
	}
	return false
}
