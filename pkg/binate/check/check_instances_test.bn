package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_instances.bn: a generic function's instances, one per distinct
// type-argument list, with signatures resolved for their arguments.

// One instance per distinct type-argument list; repeated calls share it.
func TestFuncInstancePerTypeArguments() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func F[T any](x T) T { return x }\n"
			"func g() int64 { return F[int64](1) + F[int64](2) + cast(int64, F[int32](3)) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 0 {
		return "expected no errors"
	}
	if c.Instances == nil || c.Instances.Funcs.Len() != 2 {
		return "expected exactly two instances of F"
	}
	return ""
}

// An instance's signature takes the dependent length's value for its type
// arguments.
func TestFuncInstanceDependentSignature() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func F[T any](x [sizeof(T)]uint8) int { return len(x) }\n"
			"func g() int { var a [4]uint8; return F[int64](a) }\n"
	if errorsContaining(checkSrc(src), "to [8]uint8") != 1 {
		return "expected [4]uint8 rejected for F[int64]'s [8]uint8 parameter"
	}
	return ""
}

// A type parameter inside a function type counts as a type parameter.
func TestTypeListMentionsTypeParam() testing.TestResult {
	var tp @types.Type = MakeTypeParamType("T", nil, 0, nil)
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	ps[0] = make(types.Param)
	ps[0].Type = tp
	var noResults @[]@types.Type
	var list @[]@types.Type = make_slice(@types.Type, 1)
	list[0] = types.MakeFuncValueType(ps, noResults)
	if !typeListMentionsTypeParam(list) {
		return "expected the type parameter inside a function type to be found"
	}
	list[0] = types.TypInt()
	if typeListMentionsTypeParam(list) {
		return "int mentions no type parameter"
	}
	return ""
}
