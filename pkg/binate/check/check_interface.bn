package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Interface-declaration type-checking. Phase 1 scope (per the user
// ratification): definitions work — parser accepts and type-checker
// validates. No usage yet (no `*Iface` / `@Iface` type expressions,
// no `impl T : Iface` decls, no method dispatch).

// collectInterfaceDecl validates an interface declaration and defines
// the interface symbol in scope.
//
// Validation:
//   - Method names must be unique within the interface.
//   - Each method must have no receiver (parser enforces this — the
//     parseInterfaceMethod path doesn't read a receiver — but we
//     guard defensively here).
//   - Each method's parameter and result types must resolve.
//   - Interface name must not duplicate an existing top-level decl
//     (caught by checkDuplicateDecls).
func collectInterfaceDecl(c @Checker, d @ast.Decl) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}

	// Generic interface decls: the
	// method set references unbound T at decl time, so there's no
	// stable TYP_INTERFACE to register here.  Stash the AST and
	// defer building until a use site (`Name[T1, T2]`) instantiates
	// it — same pattern as generic struct decls in Slice 5b.
	// IR-gen for instantiated interfaces (vtable layout, dispatch)
	// is Slice 6c territory; until that lands, declaring a value
	// of a generic-interface-value type would fail at IR-gen time.
	if len(d.TypeParams) > 0 {
		stashGenericIfaceDecl(c, d)
		return
	}

	// Slice 2.4: interface alias form (`interface X = Y`).
	// Resolve the target to its TYP_INTERFACE and register the
	// alias name as another SYM_INTERFACE pointing at the same
	// Type. Nominal-equivalent: MyStringer and Stringer refer
	// to the same interface, share the same method set, and any
	// `impl T : MyStringer` is indistinguishable from
	// `impl T : Stringer` at satisfaction-check time.
	if d.IsAlias {
		if !beginAliasDecl(c, d) { return }
		collectInterfaceAlias(c, d)
		endAliasDecl(c, d)
		return
	}

	// The interface symbol is defined before any declaration of the batch is
	// collected (preRegisterInterfaces), so a self-referential method — one
	// whose parameter or result type is this very interface (`Unwrap()
	// @Error`, `next() @Node`) — or a reference from a declaration earlier in
	// the package resolves against it.  Methods are added to `iface` in place
	// below, so the installed symbol (the same Type object) sees the full
	// method set.
	var iface @types.Type = pendingIfaceType(c, d)
	if iface == nil {
		// collectInterfaceDecl is reached only through collectDecls, whose
		// preRegisterInterfaces registered every non-generic, non-alias
		// interface of the batch.
		panic("internal error: interface declaration was not pre-registered")
	}

	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC {
			addCheckError(c, d.Pos, "interface method must be a function signature")
			continue
		}
		if m.Recv != nil {
			addCheckError(c, m.Pos, "interface method may not declare a receiver")
		}
		if m.Body != nil {
			addCheckError(c, m.Pos, "interface method may not have a body")
		}

		// Build the method's func type (no receiver — receiver is the
		// interface value, supplied at dispatch time).  `Self` is
		// valid in method arg/result types only — set AllowSelf
		// across this single call and restore after.  Other
		// surrounding work in this function (alias-target
		// resolution, extension-parent resolution) runs with
		// AllowSelf=false so `Self` is rejected in those slots.
		var prevAllowSelf bool = c.AllowSelf
		c.AllowSelf = true
		var ft @types.Type = resolveFuncDeclType(c, m)
		c.AllowSelf = prevAllowSelf

		// A method named `_` is rejected (checkReservedDeclNames); its signature
		// is still checked above, but it joins no method set.
		if isBlank(m.Name) {
			continue
		}
		var method @types.Method = MakeMethod(m.Name, iface, ft)
		if !iface.AddMethod(method) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("duplicate method `")
			cb.Write(m.Name)
			cb.Write("` in interface ")
			cb.Write(d.Name)
			addCheckError(c, m.Pos, buf.CopyStr(cb.String()))
		}
	}
	// Parent interfaces are resolved, validated and conflict-checked once the
	// whole batch is collected (resolvePendingIfaceParents).
}

// defineInterface adds an interface symbol to the scope.
func defineInterface(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_INTERFACE
	s.Define(sym)
}

// stashGenericIfaceDecl records the generic interface decl d for use sites to
// instantiate, once (preRegisterInterfaces and collectInterfaceDecl both reach
// it).  It is keyed on the current package's FULL path (matching the imported
// stash in bni_scope and the generic-struct stash), so the instantiated
// interface's nominal identity is by defining package, not short name — bare
// same-package lookups go through lookupGenericIfaceDeclPkg's curPkgPath
// fallback.  The defining file's import scope is recorded in lockstep, so the
// method param/result types resolve against THIS file's imports at the
// instantiation site (see populateInstantiatedInterface).
func stashGenericIfaceDecl(c @Checker, d @ast.Decl) {
	// Validate before the already-stashed early return: a generic interface
	// declared in the package's own .bni was stashed when that .bni was loaded
	// (bni_scope), so the package's check reaches here only as a repeat.
	// Diagnostics are deduplicated by (position, message).
	checkTypeParamNamesDistinct(c, d)
	// A blank generic interface binds no name, so nothing can instantiate it.
	if isBlank(d.Name) { return }
	for i := 0; i < len(c.GenericIfaceDecls); i++ {
		if same(c.GenericIfaceDecls[i], d) { return }
	}
	c.GenericIfaceDecls = slices.Append[@ast.Decl](c.GenericIfaceDecls, d)
	c.GenericIfaceDeclPkgs = slices.Append[@[]char](c.GenericIfaceDeclPkgs, buf.CopyStr(c.curPkgPath))
	c.GenericIfaceDeclScopes = slices.Append[@Scope](c.GenericIfaceDeclScopes,
			scopeForFile(c, d.Pos.File))
}

// preRegisterInterfaces defines every non-generic, non-alias interface of the
// declaration batch — a fresh interface Type, recorded as pending — and stashes
// every generic one, before any declaration is collected, so an interface may
// be named (as a parent, or in a signature) before its declaration
// (decl.order.forward).  Alias forms (`interface X = Y`) are defined in order
// by collectInterfaceDecl.
func preRegisterInterfaces(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			preRegisterInterfaces(c, d.Decls)
			continue
		}
		if d.Kind != ast.DECL_INTERFACE || d.IsAlias { continue }
		if len(d.TypeParams) > 0 {
			stashGenericIfaceDecl(c, d)
			continue
		}
		var iface @types.Type = types.MakeInterfaceType(buf.CopyStr(c.curPkgPath), d.Name)
		defineInterface(c.Scope, d.Name, iface)
		addPendingIface(c, d, iface)
	}
}

// addPendingIface records d's interface Type for resolvePendingIfaceParents.
func addPendingIface(c @Checker, d @ast.Decl, iface @types.Type) {
	c.PendingIfaceDecls = slices.Append[@ast.Decl](c.PendingIfaceDecls, d)
	c.PendingIfaceTypes = slices.Append[@types.Type](c.PendingIfaceTypes, iface)
}

// pendingIfaceType returns the interface Type preRegisterInterfaces defined
// for d, or nil.
func pendingIfaceType(c @Checker, d @ast.Decl) @types.Type {
	for i := 0; i < len(c.PendingIfaceDecls); i++ {
		if same(c.PendingIfaceDecls[i], d) { return c.PendingIfaceTypes[i] }
	}
	return nil
}

// resolvePendingIfaceParents resolves, validates and conflict-checks the
// extension clause of every pending interface — after the whole batch is
// collected, so every parent (declared before or after its child) exists with
// its methods — and clears the pending set.  Each decl's parents resolve
// against its own file's imports.
func resolvePendingIfaceParents(c @Checker) {
	var savedScope @Scope = c.Scope
	var decls @[]@ast.Decl = c.PendingIfaceDecls
	var ifaces @[]@types.Type = c.PendingIfaceTypes
	var noDecls @[]@ast.Decl
	var noTypes @[]@types.Type
	c.PendingIfaceDecls = noDecls
	c.PendingIfaceTypes = noTypes
	for i := 0; i < len(decls); i++ {
		if fileScopedActive(c) {
			c.Scope = scopeForFile(c, decls[i].Pos.File)
		}
		resolveInterfaceExtension(c, decls[i], ifaces[i])
	}
	c.Scope = savedScope
}

// collectInterfaceAlias defines the interface alias d (`interface X = Y`) as
// another name for its target interface.
func collectInterfaceAlias(c @Checker, d @ast.Decl) {
	if d.TypeRef == nil {
		addCheckError(c, d.Pos, "interface alias missing target")
		return
	}
	var target @types.Type = resolveTypeExprAllowInterface(c, d.TypeRef)
	if target == nil || target.Kind != types.TYP_INTERFACE {
		addCheckError(c, d.TypeRef.Pos, "interface alias target must be an interface")
		return
	}
	defineInterface(c.Scope, d.Name, target)
}
