package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_layout_prepare.bn: a layout read during collection, walked with no
// recursion, and reported where the type it reads nests too deeply.  (Its cycles are
// tested in check_decl_layout_test.bn.)

// layoutReadSrc returns a program of the declarations head, after the package clause,
// then n struct declarations prefix0 .. prefix(n-1), each holding the next by value,
// and `type <prefix>n struct { v int64 }`: prefix0 nests n + 2 levels, and is
// declared on the line after head's last.
func layoutReadSrc(head *[]readonly char, prefix *[]readonly char, n int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	b.Write(head)
	for i := 0; i < n; i++ {
		writeChainDecl(b, prefix, i)
	}
	b.Write("type ")
	b.Write(prefix)
	b.Write(strconv.Itoa(n))
	b.Write(" struct { v int64 }\n")
	return buf.CopyStr(b.String())
}

// errAtLine returns whether c reported msg at line.
func errAtLine(c @Checker, line int, msg *[]readonly char) bool {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == line && streq(errs[i].Msg, msg) { return true }
	}
	return false
}

// errCount returns a failure unless c reported n errors.
func errCount(c @Checker, n int) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == n { return "" }
	var msg @[]char = buf.Concat(strconv.Itoa(n), " errors expected, got ")
	msg = buf.Concat(msg, strconv.Itoa(len(errs)))
	if len(errs) > 0 { msg = buf.Concat(buf.Concat(msg, ", the first: "), errs[0].Msg) }
	return fail(msg)
}

// layoutField returns a field called name, of type t.
func layoutField(name @[]char, t @types.Type) @types.Field {
	var f @types.Field = make(types.Field)
	f.Name = name
	f.Type = t
	return f
}

// A type at the limit is read with no error.
func TestDeepLayoutReadAtLimit() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc("type X struct { a [sizeof(T0)]uint8 }\n", "T", maxTypeDepth - 2))
	return errCount(c, 0)
}

// A read of a type one level past the limit is reported where it is read, and the
// type at its declaration.
func TestDeepLayoutReadPastLimit() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc("type X struct { a [sizeof(T0)]uint8 }\n", "T", maxTypeDepth - 1))
	if !errAtLine(c, 2, "type T0 nests too deeply: more than 1024 levels of types") {
		return fail("the read of T0 is reported where it is read")
	}
	if !errAtLine(c, 3, "type T0 nests too deeply: more than 1024 levels of types") {
		return fail("T0 is reported at its declaration")
	}
	return errCount(c, 2)
}

// A read that reaches a declaration prepared by an earlier read finds it too deep by
// the height that read found: Z's read of Y stops at T0, prepared for X's read.
func TestDeepLayoutReadOfPreparedType() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type X struct { a [sizeof(T0)]uint8 }\n"
							"type Y struct { t T0 }\n"
							"type Z struct { a [sizeof(Y)]uint8 }\n",
					"T", maxTypeDepth - 1))
	if !errAtLine(c, 4, "type Y nests too deeply: more than 1024 levels of types") {
		return fail("the read of Y is reported where it is read")
	}
	return ""
}

// A type written where it is read, past the limit, is reported there: two arrays over
// a type nesting 1023 levels.
func TestDeepLayoutReadInlinePastLimit() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc("type X struct { a [sizeof([1][1]T0)]uint8 }\n", "T", maxTypeDepth - 3))
	if !errAtLine(c, 2, "type nests too deeply: more than 1024 levels of types") {
		return fail("the read is reported where it is read")
	}
	return errCount(c, 1)
}

// A read of an instance past the limit names the instance: G[T0] holds T0, 1024 levels.
func TestDeepLayoutReadOfInstancePastLimit() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type G[T any] struct { v T }\n"
							"type Z struct { a [sizeof(G[T0])]uint8 }\n",
					"T", maxTypeDepth - 2))
	if !errAtLine(c, 3, "type G[T0] nests too deeply: more than 1024 levels of types") {
		var errs @[]CheckError = c.CheckerErrors()
		if len(errs) == 0 { return fail("the read of G[T0] is reported where it is read") }
		return fail(buf.Concat("the read of G[T0] is reported, naming it: ", errs[0].Msg))
	}
	return ""
}

// A type held through a slice adds nothing to the height of the type holding it: A
// holds B through a slice, and B, in a cycle with A, holds a chain C0 of 1023 levels,
// so B is 1024 levels high, A two, and neither nests too deeply.
func TestDeepLayoutReadThroughSliceNotTooDeep() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type X struct { a [sizeof(A)]uint8 }\n"
							"type A struct { s @[]B }\n"
							"type B struct { a A; c C0 }\n",
					"C", maxTypeDepth - 3))
	return errCount(c, 0)
}

// A read reaching, through a slice, a type higher than the limit is reported where it
// is read, naming that type: the walks that read A's layout go down a slice's element.
func TestDeepLayoutReadThroughSlicePastLimit() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type X struct { a [sizeof(A)]uint8 }\n"
							"type A struct { s @[]B0 }\n",
					"B", maxTypeDepth - 1))
	if !errAtLine(c, 2, "type B0 nests too deeply: more than 1024 levels of types") {
		return fail("the read of A is reported where it is read")
	}
	return ""
}

// A read past the limit inside an instance build that waits (Box[P], built while N is
// collected, waits for Q's read of N's layout) changes nothing the build done again
// would not: the chain is reported where the declarations' check cuts it, at T77, and
// the read once, when the build is done again.
func TestDeepLayoutReadInBlockedBuild() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
							"type P struct { a T0; b Q }\n"
							"type N struct { p *Box[P]; v int64 }\n"
							"type Q struct { x [sizeof(N)]uint8 }\n",
					"T", 1100))
	if !errAtLine(c, 6 + 77, "type T77 nests too deeply: more than 1024 levels of types") {
		return fail("T77 is reported where the chain passes the limit")
	}
	return errCount(c, 2)
}

// A declaration prepared by a read made while another declaration is being walked
// keeps no height, and a later read walks it again: E's read of G, made while X's read
// walks D, finds D, which holds the chain C0, as no height; Y's read of G, after D's
// walk is done, finds G holding the chain, and is reported.
func TestDeepLayoutReadAfterReadInsideWalk() testing.TestResult {
	var c @Checker = checkSrc(
			layoutReadSrc(
					"type X struct { a [sizeof(D)]uint8 }\n"
							"type D struct { s @[]E; c C0 }\n"
							"type E struct { a [sizeof(G)]uint8 }\n"
							"type G struct { d D }\n"
							"type Y struct { a [sizeof(G)]uint8 }\n",
					"C", 1100))
	if !errAtLine(c, 6, "type G nests too deeply: more than 1024 levels of types") {
		return fail("Y's read of G is reported")
	}
	return ""
}

// A by-value cycle met by a walk inside an instance build that waits is reported: the
// build, done again, checks it, not leaving a cycle broken whose report was dropped.
func TestValueCycleInWaitingBuild() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
					"type P struct { q Q; r R }\n"
					"type R struct { p P }\n"
					"type N struct { p *Box[P]; v int64 }\n"
					"type Q struct { x [sizeof(N)]uint8 }\n")
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if hasPrefixAt(errs[i].Msg, 0, "recursive type: ") { return "" }
	}
	return fail("the cycle between P and R is reported")
}

// layoutTestChain returns a struct type n levels high: a struct holding a struct, ...,
// holding an empty struct.
func layoutTestChain(n int) @types.Type {
	var b @types.Type = types.MakeStructType("L", make_slice(@types.Field, 0))
	for i := 1; i < n; i++ {
		var fields @[]@types.Field = make_slice(@types.Field, 1)
		fields[0] = layoutField("f", b)
		b = types.MakeStructType("B", fields)
	}
	return b
}

// layoutHeight returns the height a prepareLayout walk finds for t.
func layoutHeight(t @types.Type) int {
	var c @Checker = checkSrc("package \"main\"\n")
	var pos token.Pos
	var m @prepareMachine = newPrepareMachine(pos)
	_ = runPrepareMachine(c, m, t)
	return m.height
}

// A walk counts a type it reaches again at its height: A holds the chain B both as a
// field and inside C, whose height is B's and one more, so A's is two more than B's.
func TestLayoutWalkHeightOfTypeReachedAgain() testing.TestResult {
	var b @types.Type = layoutTestChain(6)
	var cf @[]@types.Field = make_slice(@types.Field, 1)
	cf[0] = layoutField("z", b)
	var af @[]@types.Field = make_slice(@types.Field, 2)
	af[0] = layoutField("x", b)
	af[1] = layoutField("y", types.MakeStructType("C", cf))
	var h int = layoutHeight(types.MakeStructType("A", af))
	if h != 8 { return fail(buf.Concat("A's height is 8, not ", strconv.Itoa(h))) }
	return ""
}

// A slice's element adds nothing to the slice's height.
func TestLayoutWalkHeightStopsAtSlice() testing.TestResult {
	var sf @[]@types.Field = make_slice(@types.Field, 1)
	sf[0] = layoutField("s", types.MakeManagedSliceType(layoutTestChain(6)))
	var h int = layoutHeight(types.MakeStructType("S", sf))
	if h != 2 { return fail(buf.Concat("S's height is 2, not ", strconv.Itoa(h))) }
	return ""
}
