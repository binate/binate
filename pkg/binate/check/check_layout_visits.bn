package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/table"

// layoutVisits records the types a prepareLayout walk has reached, and the height of
// each it is done with (prepareFrame).
type layoutVisits struct {
	entered typeVisits
	heights typeHeights
}

// enter reports whether t is new to v, and records it.
func (v @layoutVisits) enter(t @types.Type) bool {
	return v.entered.enter(t)
}

// typeHeights maps the types a walk is done with to their heights: as typeVisits does
// for the types it enters, it looks through the first typeVisitsScanned one by one and
// past them looks a type up in index, so a walk finishing n types takes time linear in
// n.  The zero value is empty.
type typeHeights struct {
	done    @[]@types.Type
	heights @[]int
	n       int
	index   @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
}

// get returns the height recorded for t, and whether there is one.
func (v *typeHeights) get(t @types.Type) (int, bool) {
	if v.index != nil {
		h, found := v.index.Get(t)
		return h, found
	}
	for i := 0; i < v.n; i++ {
		if same(v.done[i], t) { return v.heights[i], true }
	}
	return 0, false
}

// put records h as t's height, in place of any recorded before.
func (v *typeHeights) put(t @types.Type, h int) {
	if v.index != nil {
		v.index.Put(t, h)
		return
	}
	for i := 0; i < v.n; i++ {
		if same(v.done[i], t) {
			v.heights[i] = h
			return
		}
	}
	if v.n == len(v.done) {
		var grownDone @[]@types.Type = make_slice(@types.Type, 2 * v.n + 4)
		var grownHeights @[]int = make_slice(int, 2 * v.n + 4)
		for i := 0; i < v.n; i++ {
			grownDone[i] = v.done[i]
			grownHeights[i] = v.heights[i]
		}
		v.done = grownDone
		v.heights = grownHeights
	}
	v.done[v.n] = t
	v.heights[v.n] = h
	v.n = v.n + 1
	if v.n > typeVisitsScanned {
		v.index = newTypeDepthTable()
		for i := 0; i < v.n; i++ {
			v.index.Put(v.done[i], v.heights[i])
		}
	}
}
