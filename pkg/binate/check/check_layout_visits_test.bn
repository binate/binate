package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// A type reached softly is new again when it is reached by value; one reached by value
// is not new when it is reached softly.
func TestLayoutVisitsEnter() testing.TestResult {
	var v @layoutVisits = make(layoutVisits)
	var a @types.Type = types.MakeStructType("A", make_slice(@types.Field, 0))
	var b @types.Type = types.MakeStructType("B", make_slice(@types.Field, 0))
	if !v.enter(a, true) || v.enter(a, true) { return fail("a is new softly once") }
	if !v.enter(a, false) || v.enter(a, false) { return fail("a is new by value once") }
	if !v.enter(b, false) || v.enter(b, true) { return fail("b, reached by value, is not new softly") }
	return ""
}

// typeHeights finds each type's height, the last put, by node, before and past
// typeVisitsScanned types, and none for a type never put.
func TestTypeHeights() testing.TestResult {
	var v typeHeights
	var ts @[]@types.Type = make_slice(@types.Type, 100)
	for i := 0; i < len(ts); i++ {
		ts[i] = types.MakeStructType("T", make_slice(@types.Field, 0))
		v.put(ts[i], i)
		if (i < typeVisitsScanned) != (v.index == nil) {
			return fail("the index is made once there are more than typeVisitsScanned types")
		}
		if i == 3 { v.put(ts[1], 50) }
	}
	v.put(ts[2], 70)
	for i := 0; i < len(ts); i++ {
		var want int = i
		if i == 1 { want = 50 }
		if i == 2 { want = 70 }
		h, found := v.get(ts[i])
		if !found || h != want { return fail("each type's last height is found") }
	}
	_, found := v.get(types.MakeStructType("T", make_slice(@types.Field, 0)))
	if found { return fail("a type never put has no height") }
	return ""
}
