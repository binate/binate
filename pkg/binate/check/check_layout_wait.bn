package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Instances whose build reads the layout of a type not built yet.  Building an
// instance resolves its structure and its methods' signatures, which may take
// the size of a type argument (`[sizeof(T)]uint8`, builtin.sizeof).  The type
// argument may still be being built — a type declaration the package is
// collecting, or an instance being built — when it names the instance through a
// pointer, a slice or a function value: `type N struct { v int64; next *Box[N] }`
// builds Box[N] while N is collected, `type N[T any] struct { v T; next
// *Box[N[T]] }` while N[T] is built.  Its layout does not depend on the
// instance, so the instance waits: its build is undone, and done again once
// what it read is built (flushLayoutWaits).  When a round of builds again
// builds none — each still reads a layout not built, which depends on itself
// (`type N struct { v int64; b Box[N] }`) — the last build reports the cycle.

// A build may also resolve one of the package's own declarations on demand,
// before collection reaches it (check_decl_batch.bn) — a type whose layout it
// reads, or a constant, variable, function or method an array length names —
// or a generic function instance's signature, and that resolution may read a
// layout not built yet: `type N struct { v int64; p *Box[X] }` builds Box[X],
// whose `[sizeof(T)]uint8` collects X, whose `[sizeof(N)]uint8` reads N while N
// is collected.  The resolution is a frame of its own (enterDemandFrame) that
// waits with the build below it.  It is undone — its binding, and what its
// check recorded on its syntax (ast.ClearCheckerAnnotations) — and done again,
// on demand or when collection reaches it, once that layout is built.  Kept, X
// would hold an array length never read, which IR-gen, folding sizeof(N)
// itself, would not agree with.  What a frame that waits goes on to report is
// dropped (layoutFrameBlocked): read from what could not be built — `[len(v) -
// 1]uint8` of a `[0]uint8` — it may be false, and what stands is reported when
// the frame is done again.  Nor is anything more resolved on demand inside a
// build that waits (skipDemand), which would only be undone with it.

// A layoutFrame is one entry of InstanceState.Populating: the build of the
// instance Inst; with Inst nil, a resolution no `sizeof` in which makes anything
// wait; Demand, one of the package's declarations resolved on demand; or
// Abstract, a generic's declaration resolved with its type parameters abstract
// (check_layout_wait_abstract.bn).  The last two are Blocked once a layout
// their resolution read was not built yet.
type layoutFrame struct {
	Inst     @GenericInstantiation
	Demand   bool
	Abstract bool
	Blocked  bool
}

// buildInstance builds the members of the instance entry (buildInstanceMembers),
// the innermost instance being built (enterLayoutFrame), recording how, so a
// build that read a layout not built yet can be done again; such a build is
// undone, and the instance waits (InstanceState.LayoutWaiting).
func buildInstance(c @Checker, entry @GenericInstantiation, isIface bool, usePos token.Pos,
		userFacing bool, view ImplView, work @InstWork) {
	entry.BuildUserFacing = userFacing
	entry.BuildView = view
	buildInstanceMembers(c, entry, isIface, usePos, userFacing, view, work)
	if entry.LayoutBlocked {
		undoInstanceBuild(c, entry)
	}
}

// undoInstanceBuild empties the instance entry, whose build read a layout not
// built yet, and makes it wait to be built again.
func undoInstanceBuild(c @Checker, entry @GenericInstantiation) {
	var st @InstanceState = instanceState(c)
	var t @types.Type = entry.Result
	var noMethods @[]@types.Method
	t.Methods = noMethods
	if t.Kind == types.TYP_INTERFACE {
		var noParents @[]@types.Type
		t.Parents = noParents
	} else {
		t.Underlying = nil
	}
	st.LayoutWaiting = slices.Append[@GenericInstantiation](st.LayoutWaiting, entry)
}

// enterLayoutFrame starts the resolution of the instance entry, from the point
// its instantiation is in progress until it is built, as the innermost
// (InstanceState.Populating) — or, entry nil, a resolution no `sizeof` in which
// makes an instance wait (waitForLayoutHere): a waiting instance's members
// completed — until leaveLayoutFrame.
func enterLayoutFrame(c @Checker, entry @GenericInstantiation) {
	var st @InstanceState = instanceState(c)
	var f layoutFrame
	f.Inst = entry
	st.Populating = slices.Append[layoutFrame](st.Populating, f)
}

// leaveLayoutFrame ends what enterLayoutFrame started.
func leaveLayoutFrame(c @Checker) {
	var st @InstanceState = instanceState(c)
	st.Populating = st.Populating[:len(st.Populating) - 1]
}

// enterDemandFrame starts the resolution of one of the package's declarations
// on demand as a layout frame (layoutFrame.Demand), until leaveDemandFrame, and
// reports whether it did: with no frame around it — nothing being built —
// nothing the resolution reads makes it wait.
func enterDemandFrame(c @Checker) bool {
	if c.Instances == nil || len(c.Instances.Populating) == 0 {
		return false
	}
	var f layoutFrame
	f.Demand = true
	c.Instances.Populating = slices.Append[layoutFrame](c.Instances.Populating, f)
	return true
}

// leaveDemandFrame ends the resolution enterDemandFrame started (framed: it did)
// and reports whether it waited for a layout not built yet.  The caller then
// undoes it: the read that asked for it, in the build that waits too, finds it
// unresolved, and what that read reports is dropped (layoutFrameBlocked).
func leaveDemandFrame(c @Checker, framed bool) bool {
	if !framed {
		return false
	}
	var st @InstanceState = c.Instances
	var waited bool = st.Populating[len(st.Populating) - 1].Blocked
	st.Populating = st.Populating[:len(st.Populating) - 1]
	return waited
}

// layoutFrameBlocked reports whether the innermost layout frame waits for a
// layout not built yet — a declaration resolved on demand, a generic's
// declaration resolved abstractly, or an instance's build — so that it is
// undone: what it reports meanwhile is dropped.
func layoutFrameBlocked(c @Checker) bool {
	if c.Instances == nil || len(c.Instances.Populating) == 0 {
		return false
	}
	var f layoutFrame = c.Instances.Populating[len(c.Instances.Populating) - 1]
	if f.Demand || f.Abstract {
		return f.Blocked
	}
	return f.Inst != nil && f.Inst.LayoutBlocked
}

// skipDemand reports whether a declaration asked for on demand is left
// unresolved: the innermost instance being built, or generic declaration being
// resolved abstractly, already waits for a layout, and is undone with whatever
// reads the declaration.  It makes those reads wait with it
// (waitForLayoutHere), as the resolution would have.
func skipDemand(c @Checker) bool {
	if c.Instances == nil || c.Instances.LayoutNoWait {
		return false
	}
	var st @InstanceState = c.Instances
	var i int = len(st.Populating) - 1
	for i >= 0 && st.Populating[i].Demand {
		i--
	}
	if i < 0 {
		return false
	}
	var f layoutFrame = st.Populating[i]
	if f.Abstract && !f.Blocked || !f.Abstract && (f.Inst == nil || !f.Inst.LayoutBlocked) {
		return false
	}
	return waitForLayoutHere(c)
}

// restoreBinding returns name in the scope s to its binding prev, or to unbound
// when prev is nil: a declaration resolved on demand that waited is undone.
func restoreBinding(s @Scope, name *[]readonly char, prev @Symbol) {
	if prev != nil {
		s.Define(prev)
	} else {
		s.Undefine(name)
	}
}

// waitForLayoutHere makes the innermost instance being built, or generic
// declaration being resolved abstractly, wait for a layout it reads that is not
// built yet, with the declarations resolved on demand inside it, and reports
// whether it does — not when a resolution in which nothing waits is innermost,
// nor on the last build (InstanceState.LayoutNoWait): the caller then reports
// the cycle.
func waitForLayoutHere(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	if st.LayoutNoWait {
		return false
	}
	var i int = len(st.Populating) - 1
	for i >= 0 && st.Populating[i].Demand {
		i--
	}
	if i < 0 {
		return false
	}
	if st.Populating[i].Abstract {
		st.Populating[i].Blocked = true
	} else if st.Populating[i].Inst != nil {
		st.Populating[i].Inst.LayoutBlocked = true
	} else {
		return false
	}
	for j := i + 1; j < len(st.Populating); j++ {
		st.Populating[j].Blocked = true
	}
	return true
}

// layoutNotBuilt handles a `sizeof` / `alignof` at pos of the type t when t
// holds by value an instance not built yet (instanceNotBuiltIn): the instance
// being built waits (waitForLayoutHere), or — t's layout depends on itself —
// the cycle is reported, naming t, or for a type with no name of its own (an
// array, a struct) the instance it holds; an instance by its generic, so the
// cycle in a generic's declaration is one error, whatever instances it is found
// in.  It reports whether t was such a type, whose layout is then not read.
func layoutNotBuilt(c @Checker, t @types.Type, pos token.Pos) bool {
	var seen typeVisits
	var inst @types.Type = instanceNotBuiltOf(c, t, &seen)
	if inst == nil {
		return false
	}
	if !waitForLayoutHere(c) {
		var named @types.Type = t
		if t.Kind == types.TYP_ARRAY || t.Kind == types.TYP_READONLY || t.Kind == types.TYP_STRUCT {
			named = inst
		}
		var name @[]char = named.TypeName()
		if named.Kind == types.TYP_NAMED && named.InstDecl != nil {
			var d @ast.Decl = bit_cast(@ast.Decl, named.InstDecl)
			name = d.Name
		}
		errCyclicType(c, pos, name)
	}
	return true
}

// instanceNotBuiltIn reports whether t holds by value an instance not built
// yet (instanceInProgress).
func instanceNotBuiltIn(c @Checker, t @types.Type, seen *typeVisits) bool {
	return instanceNotBuiltOf(c, t, seen) != nil
}

// instanceNotBuiltOf returns an instance not built yet (instanceInProgress)
// that t holds by value, or nil.
func instanceNotBuiltOf(c @Checker, t @types.Type, seen *typeVisits) @types.Type {
	if t == nil || !seen.enter(t) {
		return nil
	}
	if t.Kind == types.TYP_NAMED {
		if t.Underlying == nil {
			if instanceInProgress(c, t) {
				return t
			}
			return nil
		}
		return instanceNotBuiltOf(c, t.Underlying, seen)
	}
	if t.Kind == types.TYP_ALIAS {
		return instanceNotBuiltOf(c, t.Target, seen)
	}
	if t.Kind == types.TYP_ARRAY || t.Kind == types.TYP_READONLY {
		return instanceNotBuiltOf(c, t.Elem, seen)
	}
	if t.Kind == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			var inst @types.Type = instanceNotBuiltOf(c, t.Fields[i].Type, seen)
			if inst != nil {
				return inst
			}
		}
	}
	return nil
}

// instanceInProgress reports whether the named type t is an instance being
// built or waiting to be built again.
func instanceInProgress(c @Checker, t @types.Type) bool {
	if t.InstDecl == nil || c.Instances == nil {
		return false
	}
	var st @InstanceState = c.Instances
	for i := 0; i < len(st.Populating); i++ {
		if st.Populating[i].Inst != nil && same(st.Populating[i].Inst.Result, t) {
			return true
		}
	}
	for i := 0; i < len(st.LayoutWaiting); i++ {
		if same(st.LayoutWaiting[i].Result, t) {
			return true
		}
	}
	for i := 0; i < len(st.LayoutRound); i++ {
		if st.LayoutRound[i].LayoutBlocked && same(st.LayoutRound[i].Result, t) {
			return true
		}
	}
	return false
}

// typeInProgress reports whether t is a named type with no underlying type yet
// because it is being built — a type declaration the package is collecting, or
// an instance being built or waiting to be — not because it is opaque.
func typeInProgress(c @Checker, t @types.Type) bool {
	if c == nil {
		return false
	}
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	if base == nil || base.Kind != types.TYP_NAMED || base.Underlying != nil {
		return false
	}
	if instanceInProgress(c, base) {
		return true
	}
	if c.Batch == nil || !c.Batch.Collecting {
		return false
	}
	var d @ast.Decl = batchTypeDeclOf(c, base)
	return d != nil && declInList(c.Batch.TypesCollecting, d)
}

// batchDeclCollecting reports whether a type or an interface declaration of
// the package's batch is being collected, or one of its declarations resolved
// once a read has waited for one, which an instance may wait for — its layout,
// a method it has not added yet (check_member_read.bn), or the declaration
// (check_layout_wait_decl.bn).
func batchDeclCollecting(c @Checker) bool {
	return c.Batch != nil &&
			(len(c.Batch.TypesCollecting) > 0 || len(c.Batch.IfacesCollecting) > 0 || c.Batch.DeclReadWaited)
}

// flushLayoutWaits builds again the instances waiting for a layout, and
// resolves again the generic declarations waiting for one
// (resolveAbstractAgain), once no instance is being built
// (InstanceState.BuildDepth) — once an instance is built, a type or an
// interface declaration of the package's batch is collected, or one of its
// declarations a read waited for is defined — round by round, as one's build
// may wait for another's; until an entry of a round is built again it still
// counts as waiting (InstanceState.LayoutRound).  A round that builds or
// resolves none ends it while a type or an interface declaration is still
// collected, or a declaration a read waited for is still resolved — perhaps a
// read in that round, of one whose resolution is around the flush
// (batchDeclCollecting): what waits for one is built when it is done.  Otherwise
// it is followed by a last build of each, which waits for nothing and reports
// the cycles.  The checks deferred while instances were built
// (flushPendingChecks) are made after.
func flushLayoutWaits(c @Checker) {
	if c.Instances == nil {
		return
	}
	var st @InstanceState = c.Instances
	if st.LayoutFlushing || !layoutWaitsPending(st) || st.BuildDepth > 0 {
		return
	}
	st.LayoutFlushing = true
	var none @[]@GenericInstantiation
	for layoutWaitsPending(st) {
		var waiting @[]@GenericInstantiation = st.LayoutWaiting
		st.LayoutWaiting = none
		st.LayoutRound = waiting
		var built bool = resolveAbstractAgain(c)
		for i := 0; i < len(waiting); i++ {
			rebuildInstance(c, waiting[i])
			if !waiting[i].LayoutBlocked {
				built = true
			}
		}
		if !built && batchDeclCollecting(c) {
			break
		}
		if !built {
			var last @[]@GenericInstantiation = st.LayoutWaiting
			st.LayoutWaiting = none
			st.LayoutRound = last
			st.LayoutNoWait = true
			_ = resolveAbstractAgain(c)
			for i := 0; i < len(last); i++ {
				rebuildInstance(c, last[i])
			}
			st.LayoutNoWait = false
		}
	}
	st.LayoutRound = none
	st.LayoutFlushing = false
	if c.GenericInstDepth == 0 {
		flushPendingChecks(c)
	}
}

// rebuildInstance builds the waiting instance entry again, from a new copy of
// its generic's declaration, as it was built the first time (buildInstance).
func rebuildInstance(c @Checker, entry @GenericInstantiation) {
	var st @InstanceState = instanceState(c)
	entry.LayoutBlocked = false
	entry.Clone = ast.CloneDecl(entry.Decl)
	var isIface bool = entry.Result.Kind == types.TYP_INTERFACE
	var savedAliasResolving @[]@GenericInstantiation = c.AliasResolving
	var noAliases @[]@GenericInstantiation
	c.AliasResolving = noAliases
	c.GenericInstDepth = c.GenericInstDepth + 1
	st.BuildDepth = st.BuildDepth + 1
	var savedIndirect int = enterByValue(c)
	var noWork @InstWork
	enterLayoutFrame(c, entry)
	buildInstance(c, entry, isIface, entry.NamedAt, entry.BuildUserFacing, entry.BuildView, noWork)
	leaveLayoutFrame(c)
	leaveByValue(c, savedIndirect)
	st.BuildDepth = st.BuildDepth - 1
	c.GenericInstDepth = c.GenericInstDepth - 1
	c.AliasResolving = savedAliasResolving
}
