package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// A generic's own declaration is resolved once with its type parameters
// abstract, when its first instance is built (resolveGenericTypeDeclAbstract),
// and that resolution may read the layout of a concrete type not built yet:
// `type Box[T any] struct { a [sizeof(N)]uint8; t T }` with `type N struct { v
// int64; p *Box[int] }` resolves Box's declaration while N is collected, and a
// method read from an interface being collected (`[len(i.n())]uint8`) is not
// there yet either.  Neither that type nor the instance whose build reaches the
// declaration depends on the resolution, so it waits as an instance's build
// does (check_layout_wait.bn): it is a layout frame of its own
// (layoutFrame.Abstract), undone — what it recorded on the declaration's syntax,
// which IR-gen reads — and done again with the instances waiting for a layout
// (flushLayoutWaits).  One that still waits on the last round reports the
// cycle: `type N struct { v int64; b Box[int] }`.

// An abstractWait is a generic declaration (an interface's when IsIface) whose
// resolution with its type parameters abstract read a layout not built yet,
// waiting to be done again (InstanceState.AbstractWaits).
type abstractWait struct {
	Decl    @ast.Decl
	IsIface bool
}

// enterAbstractFrame starts the resolution of a generic declaration with its
// type parameters abstract as the innermost layout frame (layoutFrame.Abstract),
// until leaveAbstractFrame.
func enterAbstractFrame(c @Checker) {
	var st @InstanceState = instanceState(c)
	var f layoutFrame
	f.Abstract = true
	st.Populating = slices.Append[layoutFrame](st.Populating, f)
}

// leaveAbstractFrame ends what enterAbstractFrame started and reports whether
// the resolution waited for a layout not built yet.
func leaveAbstractFrame(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	var waited bool = st.Populating[len(st.Populating) - 1].Blocked
	st.Populating = st.Populating[:len(st.Populating) - 1]
	return waited
}

// waitAbstractResolution undoes the resolution of the generic declaration d
// (an interface's when isIface) with its type parameters abstract, which read a
// layout not built yet — what it recorded on the syntax it resolved — and makes
// d wait to be resolved again (InstanceState.AbstractWaits).
func waitAbstractResolution(c @Checker, d @ast.Decl, isIface bool) {
	if isIface {
		for i := 0; i < len(d.Decls); i++ {
			if d.Decls[i] != nil && d.Decls[i].Kind == ast.DECL_FUNC {
				ast.ClearCheckerAnnotations(d.Decls[i])
			}
		}
	} else {
		ast.ClearTypeExprAnnotations(d.TypeRef)
	}
	var st @InstanceState = instanceState(c)
	var w abstractWait
	w.Decl = d
	w.IsIface = isIface
	st.AbstractWaits = slices.Append[abstractWait](st.AbstractWaits, w)
}

// resolveAbstractAgain resolves again each generic declaration waiting to be
// resolved with its type parameters abstract, as within an instance's build
// (rebuildInstance); one that still reads a layout not built yet waits again.
// It reports whether one no longer waits.
func resolveAbstractAgain(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	var waiting @[]abstractWait = st.AbstractWaits
	var none @[]abstractWait
	st.AbstractWaits = none
	var done bool = false
	for i := 0; i < len(waiting); i++ {
		var savedAliasResolving @[]@GenericInstantiation = c.AliasResolving
		var noAliases @[]@GenericInstantiation
		c.AliasResolving = noAliases
		c.GenericInstDepth = c.GenericInstDepth + 1
		st.BuildDepth = st.BuildDepth + 1
		var savedIndirect int = enterByValue(c)
		if resolveGenericTypeDeclAbstractNow(c, waiting[i].Decl, waiting[i].IsIface) {
			done = true
		}
		leaveByValue(c, savedIndirect)
		st.BuildDepth = st.BuildDepth - 1
		c.GenericInstDepth = c.GenericInstDepth - 1
		c.AliasResolving = savedAliasResolving
	}
	return done
}

// layoutWaitsPending reports whether an instance or a generic declaration waits
// for a layout (InstanceState.LayoutWaiting, AbstractWaits).
func layoutWaitsPending(st @InstanceState) bool {
	return len(st.LayoutWaiting) > 0 || len(st.AbstractWaits) > 0
}
