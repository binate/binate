package "pkg/binate/check"

import "pkg/builtins/testing"

import "pkg/binate/ast"

// Tests for check_layout_wait_abstract.bn: a generic's own declaration,
// resolved with its type parameters abstract, waits for a layout not built yet.

// A generic's declaration that takes the size of a concrete type still being
// built — a type declaration being collected, or an instance being built — which
// names an instance of the generic only through a pointer, waits for that type:
// the declaration is resolved when its first instance is built, inside that
// type's collection or build.
func TestLayoutWaitAbstractDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(N)]uint8; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
			"type Bx[T any] struct { a [sizeof(W[int64])]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var w W[int64]; var b Box[int]; return use(b.a) + use(w.p.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// A declaration resolved again records what IR-gen reads on its syntax: the
// array length, and no error from the resolution that waited, which read the
// size as not known (`sizeof(N) - 15`).
func TestLayoutWaitAbstractDeclRecords() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(N) - 15]uint8; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
			"func use(a [1]uint8) int { return 0 }\n"
			"func f() int { var b Box[int]; return use(b.a) }\n"
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(src)
	if len(c.CheckerErrors()) != 0 {
		return fail("the program checks cleanly")
	}
	var te @ast.TypeExpr = file.Decls[0].TypeRef.Fields[0].Type
	if !te.LenKnown || te.LenVal != 1 {
		return fail("the generic's declaration records its array length")
	}
	return ""
}

// What a resolution that waits reads from what could not be built — a length of
// 0 — reports no error: `len(v) - 1` is not negative, nor `32 / len(v)` a
// division by zero, once the length is read.
func TestLayoutWaitAbstractDeclNoFalseError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [len(v) - 1]uint8; d [32 / len(v)]uint8; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
			"var v [sizeof(N)]uint8\n"
			"func use(a [15]uint8, d [2]uint8) int { return 0 }\n"
			"func f() int { var b Box[int]; return use(b.a, b.d) }\n"
	return expectNoErrors(checkSrc(src))
}

// What the resolution reads waits with it: a type declared later, collected on
// demand, that reads the size of the type being collected, and a method of an
// interface being collected.
func TestLayoutWaitAbstractDeclReads() testing.TestResult {
	var demand *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(X)]uint8; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
			"type X struct { b [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[int]; var x X; return use(b.a) + use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(demand))
	if len(r) > 0 {
		return r
	}
	var member *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [len(i.n())]uint8; t *T }\n"
			"interface I { m() *Box[int]; n() [4]uint8 }\n"
			"var i *I\n"
			"func use(a [4]uint8) int { return 0 }\n"
			"func f() int { var b Box[int]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(member))
}

// Through a chain of constants each reading the one before: each is resolved
// once in the declaration's resolution that waits, not again for each read
// (which would take time exponential in the chain's length).
func TestLayoutWaitAbstractDeclConstChain() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [C20]uint8; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
			"const C0 = sizeof(N)\n"
			"const C1 = C0 + 0\n"
			"const C2 = C1 + 0\n"
			"const C3 = C2 + 0\n"
			"const C4 = C3 + 0\n"
			"const C5 = C4 + 0\n"
			"const C6 = C5 + 0\n"
			"const C7 = C6 + 0\n"
			"const C8 = C7 + 0\n"
			"const C9 = C8 + 0\n"
			"const C10 = C9 + 0\n"
			"const C11 = C10 + 0\n"
			"const C12 = C11 + 0\n"
			"const C13 = C12 + 0\n"
			"const C14 = C13 + 0\n"
			"const C15 = C14 + 0\n"
			"const C16 = C15 + 0\n"
			"const C17 = C16 + 0\n"
			"const C18 = C17 + 0\n"
			"const C19 = C18 + 0\n"
			"const C20 = C19 + 0\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[int]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// A generic interface's declaration waits the same way; the method's result
// is pinned by assigning it where an array of N's size is required.
func TestLayoutWaitAbstractIface() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface G[T any] { m() [sizeof(N)]uint8; k() T }\n"
			"type N struct { v int64; p *G[int] }\n"
			"func f(g *G[int]) int { var r [sizeof(N)]uint8 = g.m(); return len(r) }\n"
	return expectNoErrors(checkSrc(src))
}

// A type that holds, by value, an instance of a generic whose declaration takes
// the type's size has a layout that depends on itself: the declaration waits
// for nothing on its last resolution, which reports the cycle, once.
func TestLayoutWaitAbstractDeclCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(N)]uint8; t T }\n"
			"type N struct { v int64; b Box[int] }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `N`") != 1 {
		return "expected exactly the cyclic-type error for N"
	}
	return ""
}
