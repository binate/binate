package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/stdx/slices"

// A constant's initializer may build an instance whose build, or whose
// generic's declaration resolved abstractly (check_layout_wait_abstract.bn),
// reads that same constant: `const S = sizeof(W[int64])` with `type W[T any]
// struct { v T; p *Bx[T] }` and `type Bx[T any] struct { a [S]uint8; t T }`
// builds W[int64], which names Bx[int64] through a pointer, and Bx's declaration
// and Bx[int64]'s build read S while S is resolved.  W holds Bx[int64] only
// through a pointer, so S does not depend on what reads it, and the read waits
// as one of a layout not built yet does (waitForLayoutHere) when the innermost
// layout frame was entered after S's resolution started: that frame is done
// again once S is resolved.  Once a read has waited, each constant's resolution
// ends with a flush of the layout waits, whose last round, which reports cycles,
// does not run until the outermost constant is resolved (batchDeclCollecting).
// A read with no such frame in between closes a cycle of constants: `const A =
// B + 1; const B = A + 1`.

// A constStart is a constant of the package's batch being resolved
// (DeclBatch.ConstStarts), with the number of layout frames open
// (InstanceState.Populating) when its resolution started.
type constStart struct {
	Name   @[]char
	Frames int
}

// enterConstResolution records that the batch's constant name starts being
// resolved, until leaveConstResolution.
func enterConstResolution(c @Checker, name @[]char) {
	var s constStart
	s.Name = name
	if c.Instances != nil {
		s.Frames = len(c.Instances.Populating)
	}
	c.Batch.ConstStarts = slices.Append[constStart](c.Batch.ConstStarts, s)
}

// leaveConstResolution ends what enterConstResolution started and reports
// whether a read has waited for a constant being resolved (constReadWaits) since
// the outermost started: the layout waits are then flushed once the constant is
// resolved.
func leaveConstResolution(c @Checker) bool {
	var b @DeclBatch = c.Batch
	b.ConstStarts = b.ConstStarts[:len(b.ConstStarts) - 1]
	var waited bool = b.ConstReadWaited
	if len(b.ConstStarts) == 0 {
		b.ConstReadWaited = false
	}
	return waited
}

// constReadWaits makes the innermost layout frame wait for the constant name,
// read while it is being resolved, when that frame — an instance's build or a
// generic's declaration resolved abstractly — was entered after name's
// resolution started (waitForLayoutHere), and reports whether it does
// (DeclBatch.ConstReadWaited).
func constReadWaits(c @Checker, name *[]readonly char) bool {
	if c.Instances == nil {
		return false
	}
	var starts @[]constStart = c.Batch.ConstStarts
	var from int = -1
	for i := 0; i < len(starts); i++ {
		if types.CharEq(starts[i].Name, name) {
			from = starts[i].Frames
		}
	}
	if from < 0 {
		return false
	}
	var st @InstanceState = c.Instances
	var i int = len(st.Populating) - 1
	for i >= 0 && st.Populating[i].Demand {
		i--
	}
	if i < from || !waitForLayoutHere(c) {
		return false
	}
	c.Batch.ConstReadWaited = true
	return true
}
