package "pkg/binate/check"

import "pkg/builtins/testing"

import "pkg/binate/ast"

// Tests for check_layout_wait_decl.bn's constant form: a constant read, while it
// is resolved, by an instance's build or a generic's declaration its resolution
// started.

// A generic's declaration, and its instance's build, that read a constant whose
// initializer builds an instance naming the generic only through a pointer wait
// for the constant.
func TestLayoutWaitConst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var w W[int64]; var b Bx[int]; return use(b.a) + use(w.p.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// The declaration that waited is resolved again once the constant is resolved,
// with nothing else naming it after, and records its array length.
func TestLayoutWaitConstRecords() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [S - 15]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(src)
	if len(c.CheckerErrors()) != 0 {
		return fail("the program checks cleanly")
	}
	var te @ast.TypeExpr = file.Decls[0].TypeRef.Fields[0].Type
	if !te.LenKnown || te.LenVal != 1 {
		return fail("the generic's declaration records its array length")
	}
	return ""
}

// Once the constant is resolved, what waited for it is built again before a
// later constant takes its size, whether that constant is resolved after it or
// reads it first.
func TestLayoutWaitConstThenSized() testing.TestResult {
	var after *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"const U = S + sizeof(Bx[int64])\n"
			"func use(a [40]uint8) int { return 0 }\n"
			"func f() int { var u [U]uint8; return use(u) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(after))
	if len(r) > 0 {
		return r
	}
	var first *[]readonly char = "package \"test\"\n"
			"const U = S + sizeof(Bx[int64])\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [40]uint8) int { return 0 }\n"
			"func f() int { var u [U]uint8; return use(u) }\n"
	return expectNoErrors(checkSrc(first))
}

// Once the constant is resolved, what waited for it is built again before a
// declaration reads a field of it: a constant or a variable that read the
// constant first, or a constant resolved after it.
func TestLayoutWaitConstThenRead() testing.TestResult {
	var constFirst *[]readonly char = "package \"test\"\n"
			"const U = cast(int, S) + len(W[int64]{}.p.a)\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { var u [U]uint8; return use(u) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(constFirst))
	if len(r) > 0 {
		return r
	}
	var varFirst *[]readonly char = "package \"test\"\n"
			"var Q2 [S + len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	r = expectNoErrors(checkSrc(varFirst))
	if len(r) > 0 {
		return r
	}
	var after *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"const U = len(W[int64]{}.p.a)\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var u [U]uint8; return use(u) }\n"
	return expectNoErrors(checkSrc(after))
}

// The read waits through another constant, a const group's bare member and a
// generic interface's declaration.
func TestLayoutWaitConstReads() testing.TestResult {
	var chain *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [U]uint8; t T }\n"
			"const U = S + 1\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [17]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(chain))
	if len(r) > 0 {
		return r
	}
	var group *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [S2]uint8; t T }\n"
			"const (\n"
			"\tS = sizeof(W[int64])\n"
			"\tS2\n"
			")\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(b.a) }\n"
	r = expectNoErrors(checkSrc(group))
	if len(r) > 0 {
		return r
	}
	var iface *[]readonly char = "package \"test\"\n"
			"interface G[T any] { m() [S]uint8; k() T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *G[T] }\n"
			"func use(a [S]uint8) int { return 0 }\n"
			"func f(g *G[int]) int { return use(g.m()) }\n"
	return expectNoErrors(checkSrc(iface))
}

// The constant resolved on demand — by a type collected, or inside an
// instance's build — waits the same way.
func TestLayoutWaitConstOnDemand() testing.TestResult {
	var collected *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; a [S]uint8 }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var n N; var b Bx[int]; return use(n.a) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(collected))
	if len(r) > 0 {
		return r
	}
	var inBuild *[]readonly char = "package \"test\"\n"
			"type N struct { b Box[int] }\n"
			"type Box[T any] struct { a [S]uint8; t T }\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; p *Box[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var n N; var w W[int64]; return use(n.b.a) + use(w.p.a) }\n"
	return expectNoErrors(checkSrc(inBuild))
}

// A constant whose value needs the layout that reads it is a cycle, reported
// once: W holds Bx by value, the constant takes the size of the generic's own
// instance, or of an array of it (named by its generic).
func TestLayoutWaitConstCycle() testing.TestResult {
	var byValue *[]readonly char = "package \"test\"\n"
			"const S = sizeof(W[int64])\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
			"type Bx[T any] struct { a [S]uint8; t T }\n"
	var c @Checker = checkSrc(byValue)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W"
	}
	var own *[]readonly char = "package \"test\"\n"
			"const S = sizeof(Box[int])\n"
			"type Box[T any] struct { a [S]uint8; t T }\n"
	c = checkSrc(own)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box"
	}
	var arr *[]readonly char = "package \"test\"\n"
			"const S = sizeof([2]Box[int])\n"
			"type Box[T any] struct { a [S]uint8; t T }\n"
	c = checkSrc(arr)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box, through an array"
	}
	return ""
}

// A generic whose layout depends on itself, sized by a constant nothing reads
// back, is reported once: the cycle is reported when the instance is built,
// not again where the constant takes its size.
func TestLayoutWaitConstOwnCycleOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Cyc[T any] struct { v T; a [sizeof(Cyc[T])]uint8 }\n"
			"const S = sizeof(Cyc[int8])\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Cyc`") != 1 {
		return "expected exactly the cyclic-type error for Cyc"
	}
	return ""
}

// Constants that read each other, resolved inside an instance's build, are a
// cycle of constants: no frame that could wait was entered after the first's
// resolution started.
func TestLayoutWaitConstCycleInBuild() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N struct { b Box[int] }\n"
			"type Box[T any] struct { a [A]uint8; t T }\n"
			"const A = B + 1\n"
			"const B = A + 1\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "constant definition cycle involving `A`") != 1 {
		return "expected exactly the constant-cycle error for A"
	}
	return ""
}
