package "pkg/binate/check"

import "pkg/builtins/testing"

import "pkg/binate/buf"

// Tests for the copy of a generic type's methods onto an instance
// (copyPlaceholderMethods), whose copied signature builds an instance that
// selects one of the instance's methods not copied yet
// (check_layout_wait_decl.bn).

// A generic's declaration that selects a method of an instance, whose copied
// signature builds an instance naming the generic only through a pointer, waits
// for the instance's methods to be copied: in the back-fill once collection is
// done, when the instance is built during collection, and when the method
// selected is copied after another whose signature builds the instance.  An
// instance the back-fill has not reached, selected while it copies another's,
// takes its methods then.
func TestLayoutWaitMethodCopy() testing.TestResult {
	var backfilled *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(hv.m()) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(backfilled))
	if len(r) > 0 {
		return r
	}
	var collected *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"var hz H[int64]\n"
			"var hv H[int64]\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(hz.m()) + use(b.a) }\n"
	r = expectNoErrors(checkSrc(collected))
	if len(r) > 0 {
		return r
	}
	var later *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) n() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h *H[T]) m() [8]uint8 { var r [8]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [8]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(hv.m()) + use(b.a) }\n"
	r = expectNoErrors(checkSrc(later))
	if len(r) > 0 {
		return r
	}
	var other *[]readonly char = "package \"test\"\n"
			"var hw H[int32]\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int32]; return use(hv.m()) + use(hw.m()) + use(b.a) }\n"
	return expectNoErrors(checkSrc(other))
}

// Once the methods are copied, what waited for them is built again before a
// field of it is read: in a function body after the back-fill, or by a
// declaration collection reaches after the instance is built.
func TestLayoutWaitMethodCopyThenRead() testing.TestResult {
	var backfilled *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var w W[int64]; return use(w.p.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(backfilled))
	if len(r) > 0 {
		return r
	}
	var collected *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"var hz H[int64]\n"
			"var hv H[int64]\n"
			"var Q2 [len(W[int64]{}.p.a)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	return expectNoErrors(checkSrc(collected))
}

// A copied signature that needs the layout that selects the method is a cycle,
// reported once: W holds Bx by value, copied in the back-fill or during
// collection.
func TestLayoutWaitMethodCopyCycle() testing.TestResult {
	var backfilled *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	var c @Checker = checkSrc(backfilled)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W, copied in the back-fill"
	}
	var collected *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"var hz H[int64]\n"
			"var hv H[int64]\n"
	c = checkSrc(collected)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W, copied during collection"
	}
	return ""
}

// A name the instance's generic has no method by, selected while its methods
// are copied, is reported undefined, and nothing waits for it: no layout the
// copied signature needs is left unbuilt, reported as a cycle.
func TestLayoutWaitMethodCopyUndefined() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.q())]uint8; t T }\n"
			"var hv H[int64]\n"
			"type H[T any] struct { z T }\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "undefined: q") != 1 {
		return "expected exactly the undefined error for q"
	}
	return ""
}

// A method copied while a layout its signature reads is still built is not kept
// with the length it could not read: the build that waits copies it again.  Q's
// length reads a field of W[int64], whose build names Bx[int64], whose build
// selects hv.m(), whose signature takes the size of W[int64]; so do a struct
// field's length and a function's result type.
func TestLayoutWaitMethodCopyNotKept() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type H[T any] struct { z T }\n"
			"var hv H[int64]\n"
			"func (h *H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
	var varLen *[]readonly char = "var Q [len(W[int64]{}.p.a)]uint8\n"
			"func f() int { var b Bx[int64]; return use(hv.m()) + use(Q) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat(decls, varLen)))
	if len(r) > 0 {
		return r
	}
	var fieldLen *[]readonly char = "type Z struct { q [len(W[int64]{}.p.a)]uint8 }\n"
			"func f() int { var z Z; return use(hv.m()) + use(z.q) }\n"
	r = expectNoErrors(checkSrc(buf.Concat(decls, fieldLen)))
	if len(r) > 0 {
		return r
	}
	var resultLen *[]readonly char = "func g() [len(W[int64]{}.p.a)]uint8 { return [16]uint8{} }\n"
			"func f() int { return use(hv.m()) + use(g()) }\n"
	return expectNoErrors(checkSrc(buf.Concat(decls, resultLen)))
}

// A method after one not kept is not copied while the build waits either, and
// a method whose copied signature selects the one not kept gets it once that is
// copied again: on demand during collection, from the instance's own build
// inside a build that waits, in a function body, and in the back-fill.  A real
// cycle found that way is reported once.
func TestLayoutWaitMethodCopySiblings() testing.TestResult {
	var r testing.TestResult
	var onDemand *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type H[T any] struct { z T }\n"
			"var hv H[int64]\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h H[T]) k() [len(H[T]{}.m()) + 1]uint8 { var r [len(H[T]{}.m()) + 1]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"var Q [len(W[int64]{}.p.a)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func use17(a [17]uint8) int { return 0 }\n"
			"func f() int { return use(hv.m()) + use17(hv.k()) + use(Q) }\n"
	r = expectNoErrors(checkSrc(onDemand))
	if len(r) > 0 {
		return r
	}
	var built *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(H[T]{}.m())]uint8; t T }\n"
			"type H[T any] struct { z T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h H[T]) k() [len(H[T]{}.m()) + 1]uint8 { var r [len(H[T]{}.m()) + 1]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"var q [len(W[int32]{}.p.a)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func use17(a [17]uint8) int { return 0 }\n"
			"func f() int { var h H[int32]; return use(q) + use(h.m()) + use17(h.k()) }\n"
	r = expectNoErrors(checkSrc(built))
	if len(r) > 0 {
		return r
	}
	var inBody *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(H[T]{}.m())]uint8; t T }\n"
			"type H[T any] struct { z T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h H[T]) k() [len(H[T]{}.m()) + 1]uint8 { var r [len(H[T]{}.m()) + 1]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func use17(a [17]uint8) int { return 0 }\n"
			"func f() int {\n"
			"\tvar q [len(W[int32]{}.p.a)]uint8\n"
			"\tvar h H[int32]\n"
			"\treturn use(q) + use(h.m()) + use17(h.k())\n"
			"}\n"
	r = expectNoErrors(checkSrc(inBody))
	if len(r) > 0 {
		return r
	}
	var backfilled *[]readonly char = "package \"test\"\n"
			"type H2[T any] struct { z T }\n"
			"type H[T any] struct { z T }\n"
			"var hv2 H2[int64]\n"
			"var hv H[int64]\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func (h *H2[T]) n() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h *H[T]) m2() [len(H[T]{}.m()) + 1]uint8 { var r [len(H[T]{}.m()) + 1]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func use17(a [17]uint8) int { return 0 }\n"
			"func f() int {\n"
			"\tvar b Bx[int64]\n"
			"\treturn use(hv.m()) + use(hv2.n()) + use(b.a) + use17(hv.m2())\n"
			"}\n"
	r = expectNoErrors(checkSrc(backfilled))
	if len(r) > 0 {
		return r
	}
	var cycle *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(H[T]{}.m())]uint8; t T }\n"
			"type H[T any] struct { z T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"func (h H[T]) k() [len(H[T]{}.m()) + 1]uint8 { var r [len(H[T]{}.m()) + 1]uint8; return r }\n"
			"type W[T any] struct { v T; p Bx[T] }\n"
			"var q [len(W[int32]{}.p.a)]uint8\n"
	var c @Checker = checkSrc(cycle)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W"
	}
	return ""
}
