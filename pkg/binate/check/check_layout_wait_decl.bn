package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// One of the package's declarations being resolved — a constant's value, a
// variable's type, a function's or a method's signature — may build an instance
// whose build, or whose generic's declaration resolved abstractly
// (check_layout_wait_abstract.bn), reads that same declaration: `const S =
// sizeof(W[int64])` with `type W[T any] struct { v T; p *Bx[T] }` and `type Bx[T
// any] struct { a [S]uint8; t T }` builds W[int64], which names Bx[int64]
// through a pointer, and Bx's declaration and Bx[int64]'s build read S while S
// is resolved; so do `var Q [sizeof(W[int64])]uint8` with `[len(Q)]uint8`, `func
// g() [sizeof(W[int64])]uint8` with `[len(g())]uint8`, and a method the same
// way.  W holds Bx[int64] only through a pointer, so the declaration does not
// depend on what reads it, and the read waits as one of a layout not built yet
// does (waitForLayoutHere) when the innermost layout frame was entered after the
// declaration's resolution started: that frame is done again once the
// declaration is defined.  Once a read has waited, each declaration's
// resolution ends with a flush of the layout waits once it is defined, whose
// last round, which reports cycles, does not run until the outermost is
// resolved (batchDeclCollecting).  A read with no such frame in between closes
// a cycle of the declarations themselves: `const A = B + 1; const B = A + 1`, or
// a variable named in its own type.
//
// Copying a generic type's methods onto an instance (copyPlaceholderMethods) is
// resolved the same way, collection done or not: `func (h *H[T]) m()
// [sizeof(W[T])]uint8` copied onto H[int64] builds W[int64], and Bx[int64]'s
// build, or Bx's declaration, reads `hv.m()` (`var hv H[int64]`) while m is not
// on H[int64] yet.  A selection of one of the generic's methods the instance
// does not have yet, while its methods are copied, waits when the innermost
// layout frame was entered after the copy started (methodCopyReadWaits), and the
// copy ends with a flush once a read has waited.

// A declStart is a declaration of the package's batch being resolved
// (DeclBatch.DeclStarts) — a constant, a const group member, a variable, a
// function or a method — or, Inst set and Decl nil, the copy of a generic
// type's methods onto its instance Inst, with the number of layout frames open
// (InstanceState.Populating) when it started.
type declStart struct {
	Decl   @ast.Decl
	Inst   @types.Type
	Frames int
}

// enterDeclResolution records that the batch's declaration d starts being
// resolved, until leaveDeclResolution.
func enterDeclResolution(c @Checker, d @ast.Decl) {
	var s declStart
	s.Decl = d
	pushDeclStart(c, s)
}

// enterBatchMethodCopy records, inside a batch, that the methods of named's
// generic start being copied onto named, until leaveBatchDeclResolution.
func enterBatchMethodCopy(c @Checker, named @types.Type) {
	if c.Batch == nil {
		return
	}
	var s declStart
	s.Inst = named
	pushDeclStart(c, s)
}

// pushDeclStart records s, started with the layout frames open now.
func pushDeclStart(c @Checker, s declStart) {
	if c.Instances != nil {
		s.Frames = len(c.Instances.Populating)
	}
	c.Batch.DeclStarts = slices.Append[declStart](c.Batch.DeclStarts, s)
}

// leaveDeclResolution ends what enterDeclResolution or enterBatchMethodCopy
// started and reports whether a read has waited for a declaration being
// resolved or methods being copied (declReadWaits, methodCopyReadWaits) since
// the outermost started: the layout waits are then flushed once the
// declaration is defined, or the methods are copied.
func leaveDeclResolution(c @Checker) bool {
	var b @DeclBatch = c.Batch
	b.DeclStarts = b.DeclStarts[:len(b.DeclStarts) - 1]
	var waited bool = b.DeclReadWaited
	if len(b.DeclStarts) == 0 {
		b.DeclReadWaited = false
	}
	return waited
}

// enterBatchDeclResolution is enterDeclResolution, inside a batch.
func enterBatchDeclResolution(c @Checker, d @ast.Decl) {
	if c.Batch != nil {
		enterDeclResolution(c, d)
	}
}

// leaveBatchDeclResolution ends what enterBatchDeclResolution or
// enterBatchMethodCopy started, and flushes the layout waits when a read has
// waited for a declaration being resolved (leaveDeclResolution): the
// declaration is defined, or the methods are copied.
func leaveBatchDeclResolution(c @Checker) {
	if c.Batch != nil && leaveDeclResolution(c) {
		flushLayoutWaits(c)
	}
}

// declReadWaits makes the innermost layout frame wait for the batch's
// declaration d, read while it is being resolved, when that frame — an
// instance's build or a generic's declaration resolved abstractly — was entered
// after d's resolution started (waitForLayoutHere), and reports whether it does
// (DeclBatch.DeclReadWaited).
func declReadWaits(c @Checker, d @ast.Decl) bool {
	var noInst @types.Type
	return startReadWaits(c, d, noInst)
}

// methodCopyReadWaits makes the innermost layout frame wait for the methods of
// named's generic being copied onto named, when the generic's method name, not
// on named yet, is selected inside a frame entered after the copy started, and
// reports whether it does — as declReadWaits.  A name the generic has no method
// by is reported undefined at once.
func methodCopyReadWaits(c @Checker, named @types.Type, name *[]readonly char) bool {
	if named.InstDecl == nil || c.Instances == nil ||
			!containsTypePtr(c.Instances.MethodsCopying, named) {
		return false
	}
	var gd @ast.Decl = bit_cast(@ast.Decl, named.InstDecl)
	if !genericDeclaresMethod(c, gd, name) {
		return false
	}
	var noDecl @ast.Decl
	return startReadWaits(c, noDecl, named)
}

// startReadWaits is declReadWaits for the resolution of d, or the copy of
// methods onto inst, that started.
func startReadWaits(c @Checker, d @ast.Decl, inst @types.Type) bool {
	if c.Instances == nil || c.Batch == nil {
		return false
	}
	var starts @[]declStart = c.Batch.DeclStarts
	var from int = -1
	for i := 0; i < len(starts); i++ {
		if same(starts[i].Decl, d) && same(starts[i].Inst, inst) {
			from = starts[i].Frames
		}
	}
	if from < 0 || !framesWaitFrom(c, from) {
		return false
	}
	c.Batch.DeclReadWaited = true
	return true
}

// framesWaitFrom makes the innermost layout frame that is no declaration
// resolved on demand wait (waitForLayoutHere), when it is frame from or a later
// one — entered after a resolution that started with from frames open — and
// reports whether it does.
func framesWaitFrom(c @Checker, from int) bool {
	if c.Instances == nil {
		return false
	}
	var st @InstanceState = c.Instances
	var i int = len(st.Populating) - 1
	for i >= 0 && st.Populating[i].Demand {
		i--
	}
	return i >= from && waitForLayoutHere(c)
}
