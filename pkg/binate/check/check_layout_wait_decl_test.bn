package "pkg/binate/check"

import "pkg/builtins/testing"

import "pkg/binate/ast"
import "pkg/binate/buf"

// Tests for check_layout_wait_decl.bn: a variable, a function or a method read,
// while its type or signature is resolved, by an instance's build or a generic's
// declaration that resolution started.  The constant's form is
// check_layout_wait_const_test.bn's.

// A generic's declaration that reads a variable whose declared type builds an
// instance naming the generic only through a pointer waits for the variable,
// whether collection reaches the variable or the declaration first.
func TestLayoutWaitVar() testing.TestResult {
	var after *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var w W[int64]; var b Bx[int]; return use(Q) + use(b.a) + use(w.p.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(after))
	if len(r) > 0 {
		return r
	}
	var first *[]readonly char = "package \"test\"\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(Q) + use(b.a) }\n"
	return expectNoErrors(checkSrc(first))
}

// The declaration that waited is resolved again once the variable is defined,
// and records its array length.
func TestLayoutWaitVarRecords() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q) - 15]uint8; t T }\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
	var c @Checker
	var file @ast.File
	c, file = checkBareSrc(src)
	if len(c.CheckerErrors()) != 0 {
		return fail("the program checks cleanly")
	}
	var te @ast.TypeExpr = file.Decls[0].TypeRef.Fields[0].Type
	if !te.LenKnown || te.LenVal != 1 {
		return fail("the generic's declaration records its array length")
	}
	return ""
}

// A variable whose type is inferred waits the same way: its initializer spells
// its type at its head (a composite literal, a function literal) or is checked
// (a call of a function whose signature builds the instance).
func TestLayoutWaitVarInferred() testing.TestResult {
	var composite *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q = [sizeof(W[int64])]uint8{}\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(Q) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(composite))
	if len(r) > 0 {
		return r
	}
	var literal *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q())]uint8; t T }\n"
			"var Q = func() [sizeof(W[int64])]uint8 { var z [sizeof(W[int64])]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(Q()) + use(b.a) }\n"
	r = expectNoErrors(checkSrc(literal))
	if len(r) > 0 {
		return r
	}
	var called *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q = mk()\n"
			"func mk() [sizeof(W[int64])]uint8 { var z [sizeof(W[int64])]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(Q) + use(b.a) }\n"
	return expectNoErrors(checkSrc(called))
}

// Once the variable is defined, what waited for it is built again before a
// declaration reads a field of it: one that read the variable first — the
// variable's type declared, spelled at its initializer's head, or checked — or
// one collection reaches after the variable.  (Taking the instance's size
// instead would build it before the variable is read: an array length's
// `sizeof` operands are resolved before the length is evaluated.)
func TestLayoutWaitVarThenRead() testing.TestResult {
	var declared *[]readonly char = "package \"test\"\n"
			"var Q2 [len(Q) + len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(declared))
	if len(r) > 0 {
		return r
	}
	var head *[]readonly char = "package \"test\"\n"
			"var Q2 [len(Q) + len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q = [sizeof(W[int64])]uint8{}\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	r = expectNoErrors(checkSrc(head))
	if len(r) > 0 {
		return r
	}
	var checked *[]readonly char = "package \"test\"\n"
			"var Q2 [len(Q) + len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q = [1][sizeof(W[int64])]uint8{}[0]\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	r = expectNoErrors(checkSrc(checked))
	if len(r) > 0 {
		return r
	}
	var collected *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"var Q2 [len(W[int64]{}.p.a)]uint8\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	return expectNoErrors(checkSrc(collected))
}

// A function, generic or not, and a method whose signature builds the instance
// are waited for the same way.
func TestLayoutWaitFuncs() testing.TestResult {
	var plain *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(g())]uint8; t T }\n"
			"func g() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(g()) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(plain))
	if len(r) > 0 {
		return r
	}
	var generic *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(g[int]())]uint8; t T }\n"
			"func g[U any]() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(g[int8]()) + use(b.a) }\n"
	r = expectNoErrors(checkSrc(generic))
	if len(r) > 0 {
		return r
	}
	var method *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type H struct { z int }\n"
			"var hv H\n"
			"func (h *H) m() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(hv.m()) + use(b.a) }\n"
	return expectNoErrors(checkSrc(method))
}

// Once a function or a method is defined, what waited for it is built again
// before a declaration reads a field of it: one that read the function or the
// method first, or one collection reaches after it.
func TestLayoutWaitFuncThenRead() testing.TestResult {
	var fnFirst *[]readonly char = "package \"test\"\n"
			"func h() [len(g()) + len(W[int64]{}.p.a)]uint8 { var z [32]uint8; return z }\n"
			"type Bx[T any] struct { a [len(g())]uint8; t T }\n"
			"func g() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(h()) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(fnFirst))
	if len(r) > 0 {
		return r
	}
	var fnCollected *[]readonly char = "package \"test\"\n"
			"func g() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"var Q2 [len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [len(g())]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	r = expectNoErrors(checkSrc(fnCollected))
	if len(r) > 0 {
		return r
	}
	var methodFirst *[]readonly char = "package \"test\"\n"
			"func k() [len(hv.m()) + len(W[int64]{}.p.a)]uint8 { var z [32]uint8; return z }\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type H struct { z int }\n"
			"var hv H\n"
			"func (h *H) m() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { return use(k()) }\n"
	r = expectNoErrors(checkSrc(methodFirst))
	if len(r) > 0 {
		return r
	}
	var methodCollected *[]readonly char = "package \"test\"\n"
			"type H struct { z int }\n"
			"var hv H\n"
			"func (h *H) m() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"var Q2 [len(W[int64]{}.p.a)]uint8\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { return use(Q2) }\n"
	return expectNoErrors(checkSrc(methodCollected))
}

// A variable whose type needs the layout that reads it is a cycle, reported
// once: W holds Bx by value (the variable's type declared or inferred), or the
// variable takes the size of the generic's own instance.
func TestLayoutWaitVarCycle() testing.TestResult {
	var declared *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q [sizeof(W[int64])]uint8\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	var c @Checker = checkSrc(declared)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W"
	}
	var inferred *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q = [sizeof(W[int64])]uint8{}\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	c = checkSrc(inferred)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `W`") != 1 {
		return "expected exactly the cyclic-type error for W, the type inferred"
	}
	var own *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [len(Q)]uint8; t T }\n"
			"var Q [sizeof(Box[int])]uint8\n"
	c = checkSrc(own)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box"
	}
	return ""
}

// A function or a method whose signature needs the layout that reads it is a
// cycle, not an undefined name.
func TestLayoutWaitFuncCycle() testing.TestResult {
	var fn *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(g())]uint8; t T }\n"
			"func g() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	var c @Checker = checkSrc(fn)
	if errorsContaining(c, "cyclic type definition involving `W`") != 1 ||
			errorsContaining(c, "undefined") != 0 {
		return "expected the cyclic-type error for W, the function"
	}
	var method *[]readonly char = "package \"test\"\n"
			"type Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"type H struct { z int }\n"
			"var hv H\n"
			"func (h *H) m() [sizeof(W[int64])]uint8 { var z [16]uint8; return z }\n"
			"type W[T any] struct { v T; b Bx[T] }\n"
	c = checkSrc(method)
	if errorsContaining(c, "cyclic type definition involving `W`") != 1 ||
			errorsContaining(c, "undefined") != 0 {
		return "expected the cyclic-type error for W, the method"
	}
	return ""
}

// A read that first waits inside a flush of the layout waits — one that a type
// collected on demand during the declaration's resolution ends with — still
// waits until the declaration is defined, whichever operand of the length comes
// first: a variable, a function and a constant.
func TestLayoutWaitDeclReadInFlush() testing.TestResult {
	var variable *[]readonly char = "package \"test\"\n"
			"var Q [sizeof(T1)]uint8\n"
			"type T1 struct { v int64; p *Bx[int] }\n"
			"type Bx[T any] struct { a [sizeof(T1) + len(Q)]uint8; t T }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(variable))
	if len(r) > 0 {
		return r
	}
	var fn *[]readonly char = "package \"test\"\n"
			"func g() [sizeof(T1)]uint8 { var z [16]uint8; return z }\n"
			"type T1 struct { v int64; p *Bx[int] }\n"
			"type Bx[T any] struct { a [sizeof(T1) + len(g())]uint8; t T }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(b.a) }\n"
	r = expectNoErrors(checkSrc(fn))
	if len(r) > 0 {
		return r
	}
	var constant *[]readonly char = "package \"test\"\n"
			"var Z [S]uint8\n"
			"const S = sizeof(T1)\n"
			"type T1 struct { v int64; p *Bx[int] }\n"
			"type Bx[T any] struct { a [sizeof(T1) + S]uint8; t T }\n"
			"func use(a [32]uint8) int { return 0 }\n"
			"func f() int { var b Bx[int]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(constant))
}

// Variables named in each other's types, resolved inside an instance's build,
// are a variable type cycle: no frame that could wait was entered after the
// first's resolution started.
func TestLayoutWaitVarCycleInBuild() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N struct { b Box[int] }\n"
			"type Box[T any] struct { a [len(A)]uint8; t T }\n"
			"var A [len(B)]uint8\n"
			"var B [len(A)]uint8\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 || errorsContaining(c, "variable type cycle involving `A`") != 1 {
		return "expected exactly the variable type cycle error for A"
	}
	return ""
}

// A constant whose value is the length of a generic instance's field, whose
// length is that constant, is a cycle, reported once, in either order: the
// instance's build reads the constant while the constant's resolution started
// the build.
func TestConstCycleThroughGenericField() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "type Bx[T any] struct { a [S]uint8; t T }\nvar gv Bx[int64]\nconst S = len(gv.a)\n"
	srcs[1] = "const S = len(gv.a)\ntype Bx[T any] struct { a [S]uint8; t T }\nvar gv Bx[int64]\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(buf.Concat("package \"test\"\n", srcs[i]))
		var r testing.TestResult = expectOneErr(c, "cyclic type definition involving `Bx`")
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}
