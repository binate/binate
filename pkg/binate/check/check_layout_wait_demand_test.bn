package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_layout_wait.bn's declarations resolved on demand inside an
// instance's build: N, collected first, holds *Box[X], so Box[X] is built
// while N is collected, and its `[sizeof(T)]uint8` collects X, whose length
// reads N's size — directly, or through a type, an alias, a constant, a
// variable, a function or a method declared later.  X waits with Box[X], and both get the length
// sizeof(N), 16, pinned by passing the arrays where [16]uint8 is required.

// A type collected on demand whose length takes the size directly, through
// another type it collects on demand, or through an alias declared later.
func TestLayoutWaitDemandType() testing.TestResult {
	var direct *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(direct))
	if len(r) > 0 {
		return r
	}
	var nested *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [sizeof(Z)]uint8 }\n"
			"type Z struct { c [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	r = expectNoErrors(checkSrc(nested))
	if len(r) > 0 {
		return r
	}
	var alias *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b A }\n"
			"type A = [sizeof(N)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	return expectNoErrors(checkSrc(alias))
}

// Through a constant that reads another constant taking the size, and through a
// constant group's bare member repeating an initializer that takes it.
func TestLayoutWaitDemandConst() testing.TestResult {
	var chain *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [T2]uint8 }\n"
			"const T2 = S + 0\n"
			"const S = sizeof(N)\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(chain))
	if len(r) > 0 {
		return r
	}
	var group *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [B]uint8 }\n"
			"const (\n"
			"\tA = sizeof(N) + iota * 0\n"
			"\tB\n"
			")\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	return expectNoErrors(checkSrc(group))
}

// Through a variable of a declared type that takes the size, and one whose type
// is inferred from such a variable.
func TestLayoutWaitDemandVar() testing.TestResult {
	var declared *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(v)]uint8 }\n"
			"var v [sizeof(N)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(declared))
	if len(r) > 0 {
		return r
	}
	var inferred *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(v)]uint8 }\n"
			"var v = w\n"
			"var w [sizeof(N)]uint8\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	return expectNoErrors(checkSrc(inferred))
}

// Through a function's result and a generic function instance's, whose
// signature takes the size.
func TestLayoutWaitDemandFunc() testing.TestResult {
	var plain *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(mk())]uint8 }\n"
			"func mk() [sizeof(N)]uint8 { var r [sizeof(N)]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) + use(mk()) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(plain))
	if len(r) > 0 {
		return r
	}
	var generic *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(mk[int]())]uint8 }\n"
			"func mk[E any]() [sizeof(N)]uint8 { var r [sizeof(N)]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) + use(mk[int]()) }\n"
	return expectNoErrors(checkSrc(generic))
}

// Through a method's result, of a named type and of a generic type's instance.
func TestLayoutWaitDemandMethod() testing.TestResult {
	var named *[]readonly char = "package \"test\"\n"
			"type Y struct { k int }\n"
			"var y Y\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(y.mk())]uint8 }\n"
			"func (s Y) mk() [sizeof(N)]uint8 { var r [sizeof(N)]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) + use(y.mk()) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(named))
	if len(r) > 0 {
		return r
	}
	var generic *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"var bx Bx[uint8]\n"
			"type Bx[E any] struct { e E }\n"
			"type X struct { b [len(bx.mk())]uint8 }\n"
			"func (q Bx[E]) mk() [sizeof(N)]E { var r [sizeof(N)]E; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) + use(bx.mk()) }\n"
	return expectNoErrors(checkSrc(generic))
}

// Through a chain of constants each reading the one before: each is resolved
// once in the build that waits, not again for each read (which would take time
// exponential in the chain's length).
func TestLayoutWaitDemandConstChain() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [C16]uint8 }\n"
			"const C0 = sizeof(N)\n"
			"const C1 = C0 + 0\n"
			"const C2 = C1 + 0\n"
			"const C3 = C2 + 0\n"
			"const C4 = C3 + 0\n"
			"const C5 = C4 + 0\n"
			"const C6 = C5 + 0\n"
			"const C7 = C6 + 0\n"
			"const C8 = C7 + 0\n"
			"const C9 = C8 + 0\n"
			"const C10 = C9 + 0\n"
			"const C11 = C10 + 0\n"
			"const C12 = C11 + 0\n"
			"const C13 = C12 + 0\n"
			"const C14 = C13 + 0\n"
			"const C15 = C14 + 0\n"
			"const C16 = C15 + 0\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[X]; var x X; return use(b.a) + use(x.b) }\n"
	return expectNoErrors(checkSrc(src))
}

// What a declaration that waits reads from what could not be built — a length
// of 0 — reports no error: `len(v) - 1` is not negative, nor `32 / len(v)` a
// division by zero, once the length is read; nor in a generic function
// instance's result, read by an instance's build.
func TestLayoutWaitDemandNoFalseError() testing.TestResult {
	var neg *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [len(v) - 1]uint8; d [32 / len(v)]uint8 }\n"
			"var v [sizeof(N)]uint8\n"
			"func use(a [15]uint8, d [2]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b, x.d) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(neg))
	if len(r) > 0 {
		return r
	}
	var inst *[]readonly char = "package \"test\"\n"
			"type B3[T any] struct { a [len(g[T]()) - 1]uint8 }\n"
			"func g[T any]() [sizeof(T)]uint8 { var r [sizeof(T)]uint8; return r }\n"
			"type N struct { v int64; p *B3[N] }\n"
			"func use(a [15]uint8) int { return 0 }\n"
			"func f() int { var b B3[N]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(inst))
}

// A type collected on demand whose length takes the size of a type that holds
// it by value has a layout that depends on itself: the cycle is reported, once,
// not hidden behind a length never read.
func TestLayoutWaitDemandCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N struct { v int64; p *Box[X]; x X }\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type X struct { b [sizeof(N)]uint8 }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `X`") != 1 {
		return "expected exactly the cyclic-type error for X"
	}
	return ""
}
