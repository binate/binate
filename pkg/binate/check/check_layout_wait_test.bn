package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_layout_wait.bn: an instance whose build reads the layout of a
// type not built yet waits for it.

// An instance's `sizeof` of a type being collected, which names the instance
// through a pointer, a slice or a function value, waits for that type.
func TestLayoutWaitsForTypeCollected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type NP struct { v int64; next *Box[NP] }\n"
			"type NS struct { v int64; s @[]Box[NS] }\n"
			"type NF struct { f *func(Box[NF]) int; v int64 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var b Box[NP]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// So does one of an instance being built — named by its generic's own
// declaration, checked with its type parameters abstract, and by an instance
// of it — and an interface instance whose method takes the size.
func TestLayoutWaitsForInstanceBuilt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type G[T any] struct { v T; next *Box[G[T]] }\n"
			"interface Sz[T any] { m(x [sizeof(T)]uint8) int }\n"
			"type H[T any] struct { v T; s *Sz[H[T]] }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var h H[int64]; var b Box[G[int64]]; return use(b.a) }\n"
	return expectNoErrors(checkSrc(src))
}

// A type that holds the instance by value has a layout that depends on itself:
// the instance waits for nothing on its last build, which reports the cycle,
// once.
func TestLayoutWaitCycleReported() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N struct { v int64; b Box[N] }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `N`") != 1 {
		return "expected exactly the cyclic-type error for N"
	}
	return ""
}

// A generic whose structure takes the size of its own instance has a layout that
// depends on itself: one error, naming the generic, for its abstract instance
// and every instance of it.
func TestLayoutWaitGenericSelfSizeOneError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { x T; a [sizeof(Box[T])]uint8 }\n"
			"type U struct { b Box[int32] }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box"
	}
	return ""
}

// One waiting instance's build may read another's layout: until the other is
// built again it still waits, so the order the types are declared in does not
// matter (Box[N] waits for N, whose Box[O] waits for O, whose slice of N is a
// slice's size).
func TestLayoutWaitsForAnotherWaiting() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type O struct { a [sizeof(@[]N)]uint8 }\n"
			"type N struct { p *Box[N]; x Box[O] }\n"
	return expectNoErrors(checkSrc(src))
}

// A type collected while another is (O reads N's size, collecting N on demand)
// gets the instances waiting for it built once it is, before the other reads
// their layout.
func TestLayoutWaitInsideOuterCollection() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type O struct { x [sizeof(N)]uint8; y [sizeof(Box[N])]uint8 }\n"
			"type N struct { v int64; p *Box[N] }\n"
	return expectNoErrors(checkSrc(src))
}

// Two types each holding, by value, an instance whose layout is the other's
// size are a cycle, reported as one, not as an opaque type.
func TestLayoutWaitMutualCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type A struct { v int64; p *Box[B]; x Box[B] }\n"
			"type B struct { w int32; q *Box[A]; y Box[A] }\n"
	var c @Checker = checkSrc(src)
	if errorsContaining(c, "cyclic type definition") == 0 || errorsContaining(c, "opaque") != 0 {
		return "expected the cycle reported as one"
	}
	return ""
}

// An instance's `sizeof` of a type that holds the type being collected by value,
// after reaching it through a slice's element, waits for it too: the soft reach
// does not stand for the field's (prepareLayoutIn), so the length is the whole
// size.
func TestLayoutWaitsForTypeReachedSoftlyFirst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N struct { v int64; next *Box[M] }\n"
			"type M struct { s *[]N; n N }\n"
			"func f() int { var b Box[M]; var c [sizeof(M)]uint8 = b.a; return len(c) }\n"
	return expectNoErrors(checkSrc(src))
}
