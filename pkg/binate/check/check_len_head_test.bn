package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_len_head.bn: an array length's `len` operand with a head is typed by
// it while the batch's declarations are resolved, and checked in full once they all
// have their types; one with no head that reads a placeholder is that variable's type
// cycle.

// lenHeadSrc returns a package declaring decls after `pick`, `f` and `g4`, functions
// whose one result is an array.
func lenHeadSrc(decls *[]readonly char) @[]char {
	return buf.Concat(
			"package \"test\"\nfunc pick(f @func() int) [3]int { var r [3]int; return r }\n"
					"func f(x int) [3]int { var r [3]int; return r }\n"
					"func g4(x [4]int) [4]int { return x }\n",
			decls)
}

// lenHeadExpect checks decls (lenHeadSrc), expecting no error and the package variable
// name to be an array of length want.
func lenHeadExpect(decls *[]readonly char, name *[]readonly char, want int64) testing.TestResult {
	c, _ := checkSrcKeepingScope(lenHeadSrc(decls))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var sym @Symbol = c.PackageScope.LookupLocal(name)
	if sym == nil || !isArrayType(sym.Type) || types.StripWrappers(sym.Type).ArrayLen != want {
		return fail(buf.Concat("the length of ", name))
	}
	return ""
}

// A variable read before its turn, whose head's length reads it only in a literal
// that length does not need.
func TestLenHeadReadBeforeTurn() testing.TestResult {
	var decls *[]readonly char = "var z = u\nvar u = [len(pick(func() int { return len(u) }))]int{}\n"
	var r testing.TestResult = lenHeadExpect(decls, "u", 3)
	if len(r) > 0 { return r }
	return lenHeadExpect(decls, "z", 3)
}

// Two variables, one's length reading the other, the other's reading the first only in
// a literal: both are arrays of 3, in either order.
func TestLenHeadMutualEitherOrder() testing.TestResult {
	var r testing.TestResult = lenHeadExpect(
			"var u = [len(w)]int{}\nvar w = [len(pick(func() int { return len(u) }))]int{}\n", "u", 3)
	if len(r) > 0 { return r }
	return lenHeadExpect(
			"var w = [len(pick(func() int { return len(u) }))]int{}\nvar u = [len(w)]int{}\n", "u", 3)
}

// What the length does not need is checked once the variable has its type, and its
// errors are reported -- read before its turn or not.
func TestLenHeadOperandCheckedLater() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"type S struct { arr [3]int }\nfunc wrap(x [3]int) S { var s S; return s }\n"
					"var u = wrap([len(pick(func() int { var t bool = u[0]; _ = t; return 0 }))]int{}).arr\n"))
	var r testing.TestResult = expectOneErr(c, "cannot assign int to bool")
	if len(r) > 0 { return r }
	c = checkSrc(lenHeadSrc(
			"var z = u\nvar u = [len(pick(func() int { var t bool = u[0]; _ = t; return 0 }))]int{}\n"))
	return expectOneErr(c, "cannot assign int to bool")
}

// A call's argument and a cast's operand are checked against the variable's type.
func TestLenHeadArgumentCheckedLater() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc("var V [len(g4(V)) + 1]int\n"))
	var r testing.TestResult = expectOneErr(c, "cannot assign [5]int to [4]int")
	if len(r) > 0 { return r }
	c = checkSrc(lenHeadSrc("var V [len(cast([4]int, V)) + 1]int\n"))
	return expectOneErr(c, "cast does not support this conversion")
}

// A bit_cast's operand is checked once its type is known, the same size.
func TestLenHeadBitCastOperand() testing.TestResult {
	var r testing.TestResult = lenHeadExpect("const K = len(bit_cast([3]int, V))\nvar V [K]int\n", "V",
			3)
	if len(r) > 0 { return r }
	r = lenHeadExpect("var V [len(bit_cast([5]int, V))]int\n", "V", 5)
	if len(r) > 0 { return r }
	return lenHeadExpect("var V = [len(bit_cast([5]int, V))]int{}\n", "V", 5)
}

// A variable read in a literal of another's length, whose type it then takes.
func TestLenHeadReadInLiteral() testing.TestResult {
	var r testing.TestResult = lenHeadExpect(
			"var X [len(pick(func() int { return V }))]int\nvar V = X[0] + 1\n", "X", 3)
	if len(r) > 0 { return r }
	r = lenHeadExpect(
			"var b [len(pick(func() int { return len(a) }))]int\nvar a = [len(b)]int{len(a)}\n", "a", 3)
	if len(r) > 0 { return r }
	r = lenHeadExpect("type T [len(u)]uint8\nvar u = [len(f(N))]int{}\nconst N = len(u)\n", "u", 3)
	if len(r) > 0 { return r }
	r = lenHeadExpect("var V = [len(f(K))]int{}\nconst K = len(V)\n", "V", 3)
	if len(r) > 0 { return r }
	return expectNoErrors(checkSrc(lenHeadSrc(
			"type G struct { a [len(pick(func() int { return len(V.a) })) + 1]int }\nvar V G\n")))
}

// A function's result type alone gives the length of its call, while the function's
// signature is being defined or not yet; what it reads there is checked later.
func TestLenHeadResultTypeOperand() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"var Z [len(V)]int\nvar V = mk()\n"
					"func mk() [len(pick(func() int { var t bool = V[0]; _ = t; return 0 }))]int "
					"{ var r [3]int; return r }\n"))
	var r testing.TestResult = expectOneErr(c, "cannot assign int to bool")
	if len(r) > 0 { return r }
	r = lenHeadExpect(
			"func fy(y [len(V)]int) [3]int { var r [3]int; return r }\n"
					"var V [len(fy([3]int{}))]int\n",
			"V", 3)
	if len(r) > 0 { return r }
	return lenHeadExpect(
			"var V = [len(fy([3]int{}))]int{}\n"
					"func fy(y [len(V)]int) [3]int { var r [3]int; return r }\n",
			"V", 3)
}

// A literal of the type being collected, in its own length: checked once the type has
// its underlying.
func TestLenHeadLiteralOfTypeBeingCollected() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"func f2(x T) [3]int { var r [3]int; return r }\ntype T [len(f2(T{true}))]int\n"))
	return expectOneErr(c, "cannot assign untyped bool to int")
}

// An operand with no head depends on each variable it names, a function literal's body
// included: reading the placeholder of the variable whose type is found is its cycle.
func TestLenHeadHeadlessReadIsCycle() testing.TestResult {
	var h *[]readonly char = "type S struct { arr [3]int }\n"
			"func h(f @func() int) S { var s S; return s }\n"
	var c @Checker = checkSrc(lenHeadSrc(
			buf.Concat(h, "var u [len(h(func() int { return len(u) }).arr)]int\n")))
	var r testing.TestResult = expectOneErr(c, "variable type cycle involving `u`")
	if len(r) > 0 { return r }
	c = checkSrc(lenHeadSrc(
			buf.Concat(h, "var u [len(h(func() int { var t bool = u[0]; _ = t; return 0 }).arr)]int\n")))
	return expectOneErr(c, "variable type cycle involving `u`")
}

// An operand checked later is checked at its constant group member's iota: B's cast
// overflows only at iota 1.  A bare member's copy of its initializer is checked at
// once, its errors reported at the member.
func TestLenHeadConstGroupIota() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"const (\n\tA = 0\n\tB = sizeof([len(f(cast(int, cast(uint8, 255 + iota))))]int)\n)\n"))
	var r testing.TestResult = expectOneErr(c, "constant does not fit the cast target type")
	if len(r) > 0 { return r }
	c = checkSrc("package \"test\"\nconst (\n\tA = sizeof([len([2 - iota]int{1, 2})]int)\n\tB\n)\n")
	if !errAtLine(c, 4, "too many elements in array literal") {
		return fail("B's error is reported at B")
	}
	r = expectNoErrors(checkSrc(lenHeadSrc("const (\n\tA = sizeof([len(f(iota))]int)\n\tB\n)\n")))
	if len(r) > 0 { return r }
	c = checkSrc(lenHeadSrc(
			"func gb(b bool) [3]int { var r [3]int; return r }\nconst (\n\tA = sizeof([len(gb(iota))]int)\n"
					")\n"))
	return expectOneErr(c, "cannot assign untyped int to bool")
}

// The operands are checked by a package's check and in a REPL session, as by a
// program's.
func TestLenHeadCheckedInPackageAndSession() testing.TestResult {
	var src @[]char = lenHeadSrc(
			"var u = [len(pick(func() int { var t bool = 1; _ = t; return 0 }))]int{}\n")
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = mustParse(p)
	var c @Checker = NewChecker()
	c.CheckPackage("test", file, make_slice(@ast.File, 0), nil)
	var r testing.TestResult = expectOneErr(c, "cannot assign untyped int to bool")
	if len(r) > 0 { return r }
	c = sessionChecker()
	replCheckDecl(c, "func pick(f @func() int) [3]int { var r [3]int; return r }")
	replCheckDecl(c, "var u = [len(pick(func() int { var t bool = 1; _ = t; return 0 }))]int{}")
	if !anyErrContains(c, "cannot assign untyped int to bool") {
		return fail("the session's operand is checked")
	}
	return ""
}

// A generic function's result type resolved alone is guarded per instance: mk[A0]'s,
// read while mk[A1]'s is resolved, is another; a variable's head reaching the same
// one again is checked as one with no head, its cycle reported as before.
func TestLenHeadResultAloneByInstance() testing.TestResult {
	var decls *[]readonly char = "var V [len(mk[A1]())]uint8\ntype A1 [len(W)]uint8\n"
			"var W = mk[A0]()\ntype A0 [3]uint8\n"
			"func mk[T any]() [sizeof(T)]uint8 { var r [sizeof(T)]uint8; return r }\n"
	var r testing.TestResult = lenHeadExpect(decls, "V", 3)
	if len(r) > 0 { return r }
	r = lenHeadExpect(decls, "W", 3)
	if len(r) > 0 { return r }
	r = lenHeadExpect(
			"var V [len(mk[A1](func() int { return 0 }))]uint8\ntype A1 [len(W)]uint8\n"
					"var W = mk[A0](func() int { return len(V) })\ntype A0 [3]uint8\n"
					"func mk[T any](f @func() int) [sizeof(T)]uint8 { var r [sizeof(T)]uint8; return r }\n",
			"W", 3)
	if len(r) > 0 { return r }
	var c @Checker = checkSrc(lenHeadSrc(
			"var Z [len(mk[int]())]int\nvar W = mk[int]()\n"
					"func mk[T any]() [len(W)]T { var x [len(W)]T; return x }\n"))
	return expectOneErr(c, "variable type cycle involving `W`")
}

// A head-less operand depends on what it names outside the array lengths in it: a read
// inside a length within it, whose head does not need it, is not its cycle.
func TestLenHeadNestedLengthNotJudged() testing.TestResult {
	var h *[]readonly char = "type S struct { arr [3]int }\n"
			"func h(f @func() int) S { var s S; return s }\nfunc g3(x [3]int) [3]int { return x }\n"
	var r testing.TestResult = lenHeadExpect(
			buf.Concat(h, "var u [len(h(func() int { var a [len(pick(func() int { return len(u) }))]int; "
					"return len(a) }).arr)]int\n"),
			"u", 3)
	if len(r) > 0 { return r }
	return lenHeadExpect(
			buf.Concat(h, "var u [len(h(func() int { var a [len(g3(cast([3]int, u)))]int; return len(a) })"
					".arr)]int\n"),
			"u", 3)
}

// A head that is no array is no constant length, reported once; what its operand
// reads is not judged.
func TestLenHeadNonArrayHead() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"func mkS(f @func() int) *[]int { var s *[]int; return s }\n"
					"var u [len(mkS(func() int { return len(u) }))]int\n"))
	return expectOneErr(c, "array length must be a constant integer")
}

// A length in a function literal's body, in a package variable's initializer, is
// checked once the variable has its type, in its block as it was there: an error in
// its literal is reported, read before its turn or not; a local declared after it is
// not seen, nor shadows the package's variable, while one declared before it is.
func TestLenHeadInFuncLitBody() testing.TestResult {
	var hs *[]readonly char = "type S struct { f int; k int }\n"
			"func hs(f @func() int) S { var s S; return s }\n"
	var x *[]readonly char = "var x = hs(func() int { var a [len(pick(func() int { "
			"var t bool = x; _ = t; return 0 }))]int; return len(a) }).f\n"
	var r testing.TestResult = expectOneErr(checkSrc(lenHeadSrc(buf.Concat(hs, x))),
			"cannot assign int to bool")
	if len(r) > 0 { return r }
	r = expectOneErr(checkSrc(lenHeadSrc(buf.Concat(buf.Concat(hs, "var z = x\n"), x))),
			"cannot assign int to bool")
	if len(r) > 0 { return r }
	r = expectOneErr(checkSrc(lenHeadSrc(buf.Concat(hs,
			"var x = hs(func() int { var a [len(pick(func() int { return w }))]int; w := 1; _ = w; "
					"return len(a) }).f\n"))),
			"undefined: w")
	if len(r) > 0 { return r }
	r = expectNoErrors(checkSrc(lenHeadSrc(buf.Concat(hs,
			"var x = hs(func() int { var a [len(pick(func() int { return y }))]int; y := true; _ = y; "
					"return len(a) }).f\nvar y int = 1\n"))))
	if len(r) > 0 { return r }
	return expectNoErrors(
			checkSrc(lenHeadSrc(buf.Concat(hs,
					"var x = hs(func() int { w := 2; var a [len(pick(func() int { return w }))]int; "
							"return len(a) + w }).f\n"))))
}

// A length in a generic alias's target, resolved from a function literal's body, is
// resolved in the alias's own package's scope, not the literal's: checked at once,
// as anywhere outside a literal, Box names the alias's package's.
func TestLenHeadAliasTargetFromFuncLit() testing.TestResult {
	var bni *[]readonly char = "package \"pkg/q\"\ntype Box[T any] struct { V T }\n"
			"func Pick(f @func() int) [3]int\n"
			"type A[T any] = [len(Pick(func() int { var b Box[T]; _ = b; return 0 }))]T\n"
	var c @Checker = checkSrcImporting("pkg/q", bni,
			buf.Concat(importQ, "type S struct { f int }\nfunc hs(f @func() int) S { var s S; return s }\n"
					"var x = hs(func() int { var a q.A[int]; return len(a) }).f\n"))
	return expectNoErrors(c)
}

// The captures a function literal's operand checked later adds to the literals
// around it are judged too: together too large for the target.
func TestLenHeadLaterCapturesJudged() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"type S struct { f int }\nfunc hs(f @func() int) S { var s S; return s }\n"
					"var x = hs(func() int {\n\tvar w1 [1 << 59]int64\n\tvar w2 [1 << 59]int64\n"
					"\treturn hs(func() int {\n"
					"\t\tvar a [len(pick(func() int { return cast(int, w1[0]) }))]int\n"
					"\t\tvar b [len(pick(func() int { return cast(int, w2[0]) }))]int\n"
					"\t\treturn len(a) + len(b)\n\t}).f\n}).f\n"))
	return expectOneErr(c, "the captures are too large together")
}

// A local declared again after the operand, in error, is not what the operand reads.
func TestLenHeadFrozenBeforeRedeclaration() testing.TestResult {
	var c @Checker = checkSrc(lenHeadSrc(
			"type S struct { f int }\nfunc hs(f @func() int) S { var s S; return s }\n"
					"var x = hs(func() int { w := 1; var a [len(pick(func() int { return w }))]int; "
					"var w bool; _ = w; return len(a) }).f\n"))
	return expectOneErr(c, "redeclared")
}
