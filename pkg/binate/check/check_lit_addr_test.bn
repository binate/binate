package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// mainVarInits checks src and returns the initializers of main's local `var`
// declarations, in order.
func mainVarInits(src *[]readonly char) @[]@ast.Expr {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	var inits @[]@ast.Expr = make_slice(@ast.Expr, 0)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC || !streq(d.Name, "main") || d.Body == nil { continue }
		for j := 0; j < len(d.Body.Stmts); j++ {
			var st @ast.Stmt = d.Body.Stmts[j]
			if st.Kind != ast.STMT_DECL || st.DeclRef == nil || st.DeclRef.Value == nil { continue }
			var grown @[]@ast.Expr = make_slice(@ast.Expr, len(inits) + 1)
			for k := 0; k < len(inits); k++ { grown[k] = inits[k] }
			grown[len(inits)] = st.DeclRef.Value
			inits = grown
		}
	}
	return inits
}

// firstComposite returns the first composite literal in e, searching its
// operand (X) chain, or nil.
func firstComposite(e @ast.Expr) @ast.Expr {
	for e != nil {
		if e.Kind == ast.EXPR_COMPOSITE { return e }
		e = e.X
	}
	return nil
}

// A composite literal is marked addressed exactly when its storage is: by `&`
// of it or of a field, a pointer-receiver method value or call, sub-slicing it
// (or an array field of it), or a value-borrow into a raw interface — not by a
// read or a value-receiver call.
func TestCheckMarksAddressedLiteral() testing.TestResult {
	var inits @[]@ast.Expr = mainVarInits(
			"package \"test\"\n"
					"type P struct { n int; a [2]int }\n"
					"func (p *P) bump() int { p.n = p.n + 1; return p.n }\n"
					"func (p P) get() int { return p.n }\n"
					"interface B { bump() int }\n"
					"impl *P : B\n"
					"func main() {\n"
					"  var a *P = &P{n: 1}\n"
					"  var b *int = &P{n: 2}.n\n"
					"  var c *func() int = P{n: 3}.bump\n"
					"  var d int = P{n: 4}.bump()\n"
					"  var e *[]int = P{n: 5}.a[:]\n"
					"  var f *B = P{n: 6}\n"
					"  var g int = P{n: 7}.n\n"
					"  var h int = P{n: 8}.get()\n"
					"  var i *[]int = [2]int{1, 2}[:]\n"
					"  _ = a; _ = b; _ = c; _ = d; _ = e; _ = f; _ = g; _ = h; _ = i\n"
					"}\n")
	if len(inits) != 9 { return "expected 9 var initializers" }
	var want *[]readonly bool = *[]readonly bool{true, true, true, true, true, true, false, false,
			true}
	for i := 0; i < len(inits); i++ {
		var lit @ast.Expr = firstComposite(inits[i])
		if lit == nil { return "an initializer has no composite literal" }
		if lit.LitAddressed != want[i] {
			if want[i] { return "an addressed composite literal is not marked" }
			return "a composite literal only read is marked addressed"
		}
	}
	return ""
}
