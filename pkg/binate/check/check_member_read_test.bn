package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_member_read.bn: a member read from a type not built yet, in an
// array length, pinned by passing the array where its length is required.

// A field of a type declared later, reached through a pointer — directly, and
// through a pointer field of it — and a method of an interface declared later.
func TestMemberReadDeclaredLater() testing.TestResult {
	var field *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.c)]uint8 }\n"
			"var p *Z\n"
			"type Z struct { c [16]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(field))
	if len(r) > 0 {
		return r
	}
	var chained *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.q.c)]uint8 }\n"
			"var p *Z\n"
			"type Z struct { q *Y }\n"
			"type Y struct { c [16]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	r = expectNoErrors(checkSrc(chained))
	if len(r) > 0 {
		return r
	}
	var iface *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(i.m())]uint8 }\n"
			"var i *I\n"
			"interface I { m() [16]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	return expectNoErrors(checkSrc(iface))
}

// A field takes precedence over a method of the same name in a type declared
// later; a method read from such a type does not collect it, so a `sizeof` in it
// of the type reading the method is no cycle.
func TestMemberReadFieldOrMethod() testing.TestResult {
	var field *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.f)]uint8 }\n"
			"var p *Z\n"
			"type Z struct { f [16]uint8 }\n"
			"func (z *Z) f() [4]uint8 { var r [4]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func run() int { var x X; return use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(field))
	if len(r) > 0 {
		return r
	}
	var method *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.mk())]uint8 }\n"
			"var p *Z\n"
			"type Z struct { d [sizeof(X)]uint8 }\n"
			"func (z *Z) mk() [16]uint8 { var r [16]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; var z Z; return use(x.b) + use(z.d) }\n"
	return expectNoErrors(checkSrc(method))
}

// Inside an instance's build, a field and a method of an instance that waits
// (W[Q], whose `[sizeof(T)]uint8` reads N while N is collected), and a method of
// an interface being collected, or collected on demand, reading N's size.
func TestMemberReadWaits() testing.TestResult {
	var field *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type W[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type X struct { b [len(w.a)]uint8 }\n"
			"var w W[Q]\n"
			"type Q struct { c [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; var b Box[X]; return use(x.b) + use(b.a) + use(w.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(field))
	if len(r) > 0 {
		return r
	}
	var method *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type W[T any] struct { a [sizeof(T)]uint8 }\n"
			"func (w W[T]) mk() [sizeof(T)]uint8 { var r [sizeof(T)]uint8; return r }\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type X struct { b [len(w.mk())]uint8 }\n"
			"var w W[Q]\n"
			"type Q struct { c [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; var b Box[X]; return use(x.b) + use(b.a) + use(w.mk()) }\n"
	r = expectNoErrors(checkSrc(method))
	if len(r) > 0 {
		return r
	}
	var collecting *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"interface I { m() [sizeof(N)]uint8 }\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type X struct { b [len(i.m())]uint8 }\n"
			"var i *I\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; var b Box[X]; return use(x.b) + use(b.a) }\n"
	r = expectNoErrors(checkSrc(collecting))
	if len(r) > 0 {
		return r
	}
	var later *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type X struct { b [len(i.m())]uint8 }\n"
			"var i *I\n"
			"interface I { m() [sizeof(N)]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; var b Box[X]; return use(x.b) + use(b.a) }\n"
	return expectNoErrors(checkSrc(later))
}

// A member read from a type being collected, outside any instance's build, is
// a cycle; a member that does not exist on an instance that waited is
// undefined once the instance is built, not a cycle.
func TestMemberReadCycle() testing.TestResult {
	var self *[]readonly char = "package \"test\"\n"
			"type B struct { b [2]int; a [len(u.b)]int }\n"
			"var u = B{}\n"
	var c @Checker = checkSrc(self)
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `B`") != 1 {
		return "expected exactly the cyclic-type error for B"
	}
	var missing *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type W[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N struct { v int64; p *Box[X] }\n"
			"type X struct { b [len(w.nosuch)]uint8 }\n"
			"var w W[Q]\n"
			"type Q struct { c [sizeof(N)]uint8 }\n"
	c = checkSrc(missing)
	if errorsContaining(c, "undefined: nosuch") == 0 || errorsContaining(c, "cyclic") != 0 {
		return "expected `undefined: nosuch` and no cycle"
	}
	return ""
}

// A method read from a type declared later collects nothing when the type has
// no field of that name — an embedded field, which promotes nothing, or an
// alias of an array type, through a type name — so a `sizeof` in it of the type
// reading the method is no cycle; a field reached through a type name collects
// the declarations it is defined through.
func TestMemberReadFieldPath() testing.TestResult {
	var embedded *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.mk())]uint8 }\n"
			"var p *Z\n"
			"type Z struct { E; d [sizeof(X)]uint8 }\n"
			"type E struct { k int64 }\n"
			"func (z *Z) mk() [16]uint8 { var r [16]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(embedded))
	if len(r) > 0 {
		return r
	}
	var alias *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.mk())]uint8 }\n"
			"var p *Z\n"
			"type Z W\n"
			"type W = [sizeof(X)]uint8\n"
			"func (z *Z) mk() [16]uint8 { var r [16]uint8; return r }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	r = expectNoErrors(checkSrc(alias))
	if len(r) > 0 {
		return r
	}
	var named *[]readonly char = "package \"test\"\n"
			"type X struct { b [len(p.c)]uint8 }\n"
			"var p *Z\n"
			"type Z W\n"
			"type W struct { c [16]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var x X; return use(x.b) }\n"
	return expectNoErrors(checkSrc(named))
}

// An instance that waited only for another instance is built again as soon as
// no instance is being built, while a type or an interface declaration is still
// collected, so a later `sizeof` of it there reads its layout.
func TestMemberReadFlushWhileCollecting() testing.TestResult {
	var strct *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N[T any] struct { v T; next *Box[N[T]] }\n"
			"type S struct { m N[int64]; k [sizeof(Box[N[int64]])]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f() int { var s S; var b Box[N[int64]]; return use(s.k) + use(b.a) }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(strct))
	if len(r) > 0 {
		return r
	}
	var iface *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { a [sizeof(T)]uint8 }\n"
			"type N[T any] struct { v T; next *Box[N[T]] }\n"
			"interface I { m() N[int64]; k() [sizeof(Box[N[int64]])]uint8 }\n"
			"func use(a [16]uint8) int { return 0 }\n"
			"func f(i *I) int { var b Box[N[int64]]; return use(i.k()) + use(b.a) }\n"
	return expectNoErrors(checkSrc(iface))
}
