package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for a generic's method copied onto an instance on demand
// (copyMethodOnDemand) — one a copied signature selects before its copy, one
// selected on an instance whose build waits or of a `.bni`'s generic while its
// declarations are resolved — and for the methods such an instance keeps while
// its build is done again (undoInstanceBuild).

// methodCopyCases reports "" when each bnDecls[i] checks cleanly in a `.bn`
// followed by bnUse, and an importer whose declarations are bniUse checks
// cleanly against pkg/q's `.bni` declarations bniDecls[i].
func methodCopyCases(bnDecls @[]*[]readonly char, bniDecls @[]*[]readonly char,
		bnUse *[]readonly char, bniUse *[]readonly char) testing.TestResult {
	for i := 0; i < len(bnDecls); i++ {
		var bn @[]char = buf.Concat(buf.Concat("package \"main\"\n", bnDecls[i]), bnUse)
		var r testing.TestResult = expectNoErrors(checkSrc(bn))
		if len(r) > 0 { return buf.Concat(bn, r) }
		var bni @[]char = buf.Concat("package \"pkg/q\"\n", bniDecls[i])
		r = expectNoErrors(checkSrcImporting("pkg/q", bni, buf.Concat(importQ, bniUse)))
		if len(r) > 0 { return buf.Concat(bni, r) }
	}
	return ""
}

// A copied signature that selects a method of the instance copied after it —
// one more down a chain, and one whose signature reads the instance's size —
// checks cleanly in a `.bn`, which records each method after those its
// signature selects, and in a `.bni` an importer builds, which copies that one
// then, as an importer's instance of the `.bni`'s generic does.  One selecting
// itself, or the method whose copy selects it, is undefined.
func TestMethodCopyDemandDuringCopy() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 3)
	decls[0] = "type Box[X any] struct { a [2]X }\nvar B Box[int]\nconst S = len(B.A())\n"
			"func (b Box[X]) A() [len(B.C())]X { var r [len(B.C())]X; return r }\n"
			"func (b Box[X]) C() [3]X { var r [3]X; return r }\n"
	decls[1] = "type Box[X any] struct { a [2]X }\nvar B Box[int]\nconst S = len(B.A())\n"
			"func (b Box[X]) A() [len(B.C())]X { var r [len(B.C())]X; return r }\n"
			"func (b Box[X]) C() [len(B.D())]X { var r [len(B.D())]X; return r }\n"
			"func (b Box[X]) D() [3]X { var r [3]X; return r }\n"
	decls[2] = "type Box[X any] struct { a [2]X }\nvar B Box[int]\nconst S = len(B.A())\n"
			"func (b Box[X]) A() [len(B.C())]X { var r [len(B.C())]X; return r }\n"
			"func (b Box[X]) C() [sizeof(Box[X]) / sizeof(X) + 1]X {\n"
			"\tvar r [sizeof(Box[X]) / sizeof(X) + 1]X\n\treturn r\n}\n"
	var r testing.TestResult = methodCopyCases(decls, decls, "var a [S]int\nvar b [3]int = a\n",
			bniConstIs3)
	if len(r) > 0 { return r }
	var self *[]readonly char = "type Box[X any] struct { a [2]X }\nvar B Box[int]\n"
			"func (b Box[X]) A() [len(B.A())]X { var r [2]X; return r }\nconst S = len(B.A())\n"
	r = expectOneErrAt(checkSrc(buf.Concat("package \"main\"\n", self)), 4, 28, "undefined: A")
	if len(r) > 0 { return buf.Concat("self, .bn: ", r) }
	r = expectOneErrAt(
			checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", self),
					buf.Concat(importQ, "var z int\n")), 4, 28, "undefined: A")
	if len(r) > 0 { return buf.Concat("self, .bni: ", r) }
	var back *[]readonly char =
		"type Box[X any] struct { a [2]X }\nvar B Box[int]\nconst S = len(B.A())\n"
				"func (b Box[X]) A() [len(B.C())]X { var r [len(B.C())]X; return r }\n"
				"func (b Box[X]) C() [len(B.A())]X { var r [len(B.A())]X; return r }\n"
	r = expectOneErrAt(checkSrc(buf.Concat("package \"main\"\n", back)), 6, 28, "undefined: A")
	if len(r) > 0 { return buf.Concat("back, .bn: ", r) }
	r = expectOneErrAt(
			checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", back),
					buf.Concat(importQ, "var z int\n")), 6, 28, "undefined: A")
	if len(r) > 0 { return buf.Concat("back, .bni: ", r) }
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Box[X any] struct { a [2]X }\n"
					"func (b Box[X]) A() [len(Box[X]{}.C())]X { var r [len(Box[X]{}.C())]X; return r }\n"
					"func (b Box[X]) C() [3]X { var r [3]X; return r }\n",
			buf.Concat(importQ,
					"var M q.Box[uint8]\nconst T = len(M.A())\nvar a [T]int\nvar b [3]int = a\n"))
	r = expectNoErrors(c)
	if len(r) > 0 { return buf.Concat("imported: ", r) }
	return ""
}

// A method selected on an instance whose build waits for the declaration that
// selects it — the instance's layout reads a constant the method's result
// gives — is copied onto it and stays through the builds done again: declared
// after the selection or before it, selected through another method, and one
// whose copy starts a build that waits for the constant too (Q[int]), in a
// `.bn` and in a `.bni` an importer builds.  One whose signature reads that
// layout is a cycle, reported once.
func TestMethodCopyDemandWaitingInstance() testing.TestResult {
	var bnDecls @[]*[]readonly char = make_slice(*[]readonly char, 4)
	var bniDecls @[]*[]readonly char = make_slice(*[]readonly char, 4)
	bnDecls[3] =
		"const S = len(F())\nfunc F() [len(B.Get(nil))]int { var r [len(B.Get(nil))]int; return r }\n"
				"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\ntype Q[X any] struct { a [S]X }\n"
				"func (b Box[X]) Get(p *Q[X]) [3]X { var r [3]X; return r }\n"
	bniDecls[3] = "const S = len(F())\nfunc F() [len(B.Get(nil))]int\n"
			"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\ntype Q[X any] struct { a [S]X }\n"
			"func (b Box[X]) Get(p *Q[X]) [3]X { var r [3]X; return r }\n"
	bnDecls[0] =
		"const S = len(F())\nfunc F() [len(B.Get())]int { var r [len(B.Get())]int; return r }\n"
				"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
				"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	bniDecls[0] = "const S = len(F())\nfunc F() [len(B.Get())]int\n"
			"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	bnDecls[1] = "const S = len(F())\ntype Box[X any] struct { a [S - 1]X }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"func F() [len(B.Get())]int { var r [len(B.Get())]int; return r }\nvar B Box[int]\n"
	bniDecls[1] = "const S = len(F())\ntype Box[X any] struct { a [S - 1]X }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"func F() [len(B.Get())]int\nvar B Box[int]\n"
	bnDecls[2] = "const S = len(V)\nvar V [len(B.H())]int\ntype Box[X any] struct { a [S - 1]X }\n"
			"var B Box[int]\nfunc (b Box[X]) H() [len(B.Get())]X { var r [len(B.Get())]X; return r }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	bniDecls[2] = bnDecls[2]
	var r testing.TestResult = methodCopyCases(bnDecls, bniDecls,
			"var a [S]int\nvar b [3]int = a\nvar c [2]int = B.a\n",
			"var a [q.S]int\nvar b [3]int = a\nvar c [2]int = q.B.a\n")
	if len(r) > 0 { return r }
	var cycle *[]readonly char = "const S = len(V)\nvar V [len(B.Get())]int\n"
			"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
			"func (b Box[X]) Get() [sizeof(Box[X])]X { var r [sizeof(Box[X])]X; return r }\n"
	var c @Checker = checkSrc(buf.Concat("package \"main\"\n", cycle))
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box in a .bn"
	}
	c = checkSrcImporting("pkg/q", buf.Concat("package \"pkg/q\"\n", cycle),
			buf.Concat(importQ, "var z int\n"))
	if len(c.CheckerErrors()) != 1 ||
			errorsContaining(c, "cyclic type definition involving `Box`") != 1 {
		return "expected exactly the cyclic-type error for Box in a .bni"
	}
	return ""
}

// An instance that takes its generic's methods later takes only the method
// selected on it: another, whose signature reads the layout its build waits for
// or the constant being resolved, is copied once the instance is built, or once
// a `.bni`'s declarations are resolved — in a `.bn` and in a `.bni` an importer
// builds, and in either order in a `.bn` when the layout waits for a type being
// collected.  So does a waiting instance of an imported generic.
func TestMethodCopyDemandSelectedOnly() testing.TestResult {
	var bnDecls @[]*[]readonly char = make_slice(*[]readonly char, 2)
	var bniDecls @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bnDecls[0] =
		"const S = len(F())\nfunc F() [len(B.Get())]int { var r [len(B.Get())]int; return r }\n"
				"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
				"func (b Box[X]) O() [sizeof(Box[X]) / sizeof(X)]uint8 {\n"
				"\tvar r [sizeof(Box[X]) / sizeof(X)]uint8\n\treturn r\n}\n"
				"func (b Box[X]) P() [S + 1]X { var r [S + 1]X; return r }\n"
				"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	bniDecls[0] = "const S = len(F())\nfunc F() [len(B.Get())]int\n"
			"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
			"func (b Box[X]) O() [sizeof(Box[X]) / sizeof(X)]uint8 {\n"
			"\tvar r [sizeof(Box[X]) / sizeof(X)]uint8\n\treturn r\n}\n"
			"func (b Box[X]) P() [S + 1]X { var r [S + 1]X; return r }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
	bnDecls[1] = "const S = len(V)\nvar V [len(B.Get())]int\n"
			"func (b Box[X]) O() [sizeof(Box[X]) / sizeof(X)]uint8 {\n"
			"\tvar r [sizeof(Box[X]) / sizeof(X)]uint8\n\treturn r\n}\n"
			"type Box[X any] struct { a [S - 1]X }\nvar B Box[int]\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"func (b Box[X]) P() [S + 1]X { var r [S + 1]X; return r }\n"
	bniDecls[1] = bnDecls[1]
	var r testing.TestResult = methodCopyCases(bnDecls, bniDecls,
			"var a [S]int\nvar b [3]int = a\nvar o [2]uint8 = B.O()\nvar p [4]int = B.P()\n",
			"var a [q.S]int\nvar b [3]int = a\nvar o [2]uint8 = q.B.O()\nvar p [4]int = q.B.P()\n")
	if len(r) > 0 { return r }
	var szBn @[]*[]readonly char = make_slice(*[]readonly char, 1)
	var szBni @[]*[]readonly char = make_slice(*[]readonly char, 1)
	szBn[0] = "type Box[X any] struct { a [2]X }\nvar B Box[int]\n"
			"func F() [len(B.Get())]int { var r [len(B.Get())]int; return r }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\nconst S = len(F())\n"
			"func (b Box[X]) Sz() [S]X { var r [S]X; return r }\n"
	szBni[0] = "type Box[X any] struct { a [2]X }\nvar B Box[int]\nfunc F() [len(B.Get())]int\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\nconst S = len(F())\n"
			"func (b Box[X]) Sz() [S]X { var r [S]X; return r }\n"
	r = methodCopyCases(szBn, szBni, "var a [S]int\nvar b [3]int = a\nvar z [3]int = B.Sz()\n",
			"var a [q.S]int\nvar b [3]int = a\nvar z [3]int = q.B.Sz()\n")
	if len(r) > 0 { return r }
	var collected @[]*[]readonly char = make_slice(*[]readonly char, 2)
	collected[0] = "package \"main\"\ntype Box[X any] struct { t [sizeof(X)]uint8 }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"func (b Box[X]) O() [sizeof(Box[X]) / sizeof(X)]uint8 {\n"
			"\tvar r [sizeof(Box[X]) / sizeof(X)]uint8\n\treturn r\n}\n"
			"type N struct { v int64; arr [len(B.Get())]int; p *Box[N] }\nvar B Box[N]\n"
			"var n N\nvar a [3]int = n.arr\nvar o [1]uint8 = B.O()\n"
	collected[1] = "package \"main\"\ntype Box[X any] struct { t [sizeof(X)]uint8 }\n"
			"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n"
			"type N struct { v int64; arr [len(B.Get())]int; p *Box[N] }\nvar B Box[N]\n"
			"func (b Box[X]) O() [sizeof(Box[X]) / sizeof(X)]uint8 {\n"
			"\tvar r [sizeof(Box[X]) / sizeof(X)]uint8\n\treturn r\n}\n"
			"var n N\nvar a [3]int = n.arr\nvar o [1]uint8 = B.O()\n"
	for i := 0; i < len(collected); i++ {
		r = expectNoErrors(checkSrc(collected[i]))
		if len(r) > 0 { return buf.Concat(collected[i], r) }
	}
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ntype Box[X any] struct { t [sizeof(X)]uint8 }\n"
					"func (b Box[X]) Get() [3]X { var r [3]X; return r }\n",
			buf.Concat(importQ,
					"type N struct { v int64; arr [len(B.Get())]int; p *q.Box[N] }\n"
							"var B q.Box[N]\nvar n N\nvar a [3]int = n.arr\n"))
	r = expectNoErrors(c)
	if len(r) > 0 { return buf.Concat("imported: ", r) }
	return ""
}

// A cycle among a generic's methods' signatures is reported once, where the
// generic's declaration finds it, however many instances copy them: a
// concrete instance's copy, declared after the methods or built in a body,
// does not find it again where its copies begin.
func TestMethodCopyDemandCycleOnce() testing.TestResult {
	var pair *[]readonly char = "package \"main\"\ntype Box[X any] struct { a [2]X }\n"
			"func (b Box[X]) A() [len(Box[X]{}.C())]X { var r [len(Box[X]{}.C())]X; return r }\n"
			"func (b Box[X]) C() [len(Box[X]{}.A())]X { var r [2]X; return r }\n"
	var r testing.TestResult = expectOneErrAt(checkSrc(buf.Concat(pair, "var G Box[uint8]\n")), 4, 34,
			"undefined: A")
	if len(r) > 0 { return buf.Concat("var: ", r) }
	r = expectOneErrAt(
			checkSrc(buf.Concat(pair, "func f() int { var x Box[uint8]; return len(x.a) }\n")), 4, 34,
			"undefined: A")
	if len(r) > 0 { return buf.Concat("body: ", r) }
	var three *[]readonly char = "package \"main\"\ntype Box[X any] struct { a [2]X }\n"
			"func (b Box[X]) A() [len(Box[X]{}.C())]X { var r [len(Box[X]{}.C())]X; return r }\n"
			"func (b Box[X]) C() [len(Box[X]{}.D())]X { var r [2]X; return r }\n"
			"func (b Box[X]) D() [len(Box[X]{}.A())]X { var r [2]X; return r }\n"
			"var G Box[uint8]\nvar H Box[int16]\n"
	r = expectOneErrAt(checkSrc(three), 5, 34, "undefined: A")
	if len(r) > 0 { return buf.Concat("three: ", r) }
	return ""
}

// An on-demand copy onto an instance that takes its methods later is made as a
// copy in progress: a build the copy starts that selects the method again waits
// for it, and is built again once it is copied — `func (h H[T]) m()
// [sizeof(W[T])]uint8`, where W[T] holds a Bx[T] whose layout selects m, or a
// sibling n that selects m, on the same instance of H — in a `.bni` an importer
// builds, in two declaration orders, as in a `.bn`.
func TestMethodCopyDemandLaterWaits() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 3)
	decls[0] = "type H[T any] struct { x T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\ntype Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\nconst K = len(hv.m())\n"
	decls[1] = "const K = len(hv.m())\ntype H[T any] struct { x T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\ntype Bx[T any] struct { a [len(hv.m())]uint8; t T }\n"
			"var hv H[int64]\n"
	decls[2] = "type H[T any] struct { x T }\nvar hv H[int64]\n"
			"type Bx[T any] struct { a [len(hv.n())]uint8; t T }\n"
			"func (h H[T]) m() [sizeof(W[T])]uint8 { var r [sizeof(W[T])]uint8; return r }\n"
			"type W[T any] struct { v T; p *Bx[T] }\n"
			"func (h H[T]) n() [len(hv.m()) + 1]uint8 { var r [len(hv.m()) + 1]uint8; return r }\n"
			"const K = len(hv.m())\n"
	return methodCopyCases(decls, decls, "var a [K]uint8 = hv.m()\n",
			"var a [q.K]uint8\nvar b [len(a)]uint8 = a\n")
}
