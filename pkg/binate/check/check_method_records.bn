package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/containers/vec"

// What a method selector selects, as the check selected it: the selector of a
// method call (`x.M(...)`), of a method value (`x.M`) and of a method
// expression (`T.M`, `Box[int].M`) records the method of the named type it
// resolved to, in the expression records (check_type_stamps.bn), which
// Checker.ExprMethod reads.  In an instance's copy of a generic body, a call
// through a type parameter's constraint records the type argument's method; in
// the generic body, which selects the constraint's method, it records none.  A
// call through an interface value and a field of a function value record none.

// stampExprMethod records m as the method the selector e selects (nothing for a
// nil e or m), replacing the record of an earlier check of e.
func stampExprMethod(c @Checker, e @ast.Expr, m @types.Method) {
	if e == nil || m == nil {
		return
	}
	var tab @vec.Vec[exprStamp] = stampTablesOf(c).Exprs
	var node *ast.Expr = e
	var id int = e.DenotedTypeID
	if id > 0 && id < tab.Len() && same(tab.Get(id).Node, node) {
		var s exprStamp = tab.Get(id)
		s.Method = m
		tab.Set(id, s)
		return
	}
	var s exprStamp
	s.Node = node
	s.Method = m
	e.DenotedTypeID = tab.Len()
	tab.Push(s)
}

// ExprMethod returns the method the selector e selects (see check.bni).
func (c @Checker) ExprMethod(e *ast.Expr) @types.Method {
	if e == nil || c.Stamps == nil {
		return nil
	}
	var tab @vec.Vec[exprStamp] = c.Stamps.Exprs
	var id int = e.DenotedTypeID
	if id <= 0 || id >= tab.Len() || !same(tab.Get(id).Node, e) {
		return nil
	}
	return tab.Get(id).Method
}
