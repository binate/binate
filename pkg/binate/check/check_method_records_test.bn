package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the checker's records of the methods selectors select
// (check_method_records.bn).

// selectorOf returns the n-th (from 0) selector named name whose operand is the
// identifier x -- or, for an empty x, an operand that is no identifier -- that
// the walk w found, or nil.
func selectorOf(w @stampWalk, x *[]readonly char, name *[]readonly char, n int) @ast.Expr {
	var left int = n
	for i := 0; i < w.Names.Len(); i++ {
		var e @ast.Expr = w.Names.Get(i)
		if e.Kind != ast.EXPR_SELECTOR || e.X == nil || !charSliceEq(e.Name, name) { continue }
		if (len(x) == 0) != (e.X.Kind != ast.EXPR_IDENT) { continue }
		if len(x) > 0 && !charSliceEq(e.X.Name, x) { continue }
		if left == 0 { return e }
		left -= 1
	}
	return nil
}

// methodRecordProblem returns what is wrong with the record of the n-th
// selector of x named name the walk found (selectorOf) -- it should be a method
// of that name of the named type recv (any, for an empty recv) -- or "" for
// nothing.
func methodRecordProblem(w @stampWalk, x *[]readonly char, name *[]readonly char, n int,
		recv *[]readonly char) @[]char {
	var what @[]char = buf.Concat(buf.Concat(x, "."), buf.Concat(name, ": "))
	var e @ast.Expr = selectorOf(w, x, name, n)
	if e == nil { return buf.Concat(what, "not found; ") }
	var m @types.Method = w.C.ExprMethod(e)
	if m == nil { return buf.Concat(what, "no record; ") }
	if !charSliceEq(m.Name, name) { return buf.Concat(what, "another method; ") }
	if len(recv) == 0 { return "" }
	var base @types.Type = m.RecvType.ReceiverBaseNamed()
	if base == nil || !charSliceEq(base.Name, recv) {
		return buf.Concat(what, "another type's method; ")
	}
	return ""
}

// A method call, a method value and a method expression record the method they
// select -- on a generic type's instance, the instance's -- and so does a call
// through a type parameter's constraint in the instance's copy of the generic
// body, of the type argument's method; a field of a method's name and a call
// through an interface value record none.
func TestMethodRecords() testing.TestResult {
	var w @stampWalk
	var msg @[]char
	w, msg = checkedNameWalk(
			"package \"main\"\n"
					"type P struct { v int }\n"
					"func (p *P) Get() int { return p.v }\n"
					"func (p *P) Do() int { return 1 }\n"
					"type Box[T any] struct { v T }\n"
					"func (b *Box[T]) Val() T { return b.v }\n"
					"interface Doer { Do() int }\n"
					"impl *P : Doer\n"
					"func run[T Doer](t T) int { return t.Do() }\n"
					"type F struct { Get *func() int }\n"
					"func main() {\n"
					"\tvar p P\n"
					"\t_ = p.Get()\n"
					"\tvar f *func() int = p.Get\n"
					"\tvar g *func(*P) int = P.Get\n"
					"\tvar b Box[int]\n"
					"\t_ = b.Val()\n"
					"\tvar h *func(*Box[int]) int = Box[int].Val\n"
					"\t_ = run[*P](&p)\n"
					"\tvar d *Doer = &p\n"
					"\t_ = d.Do()\n"
					"\tvar fv F\n"
					"\t_ = fv.Get\n"
					"\t_ = f\n\t_ = g\n\t_ = h\n"
					"}\n")
	if len(msg) > 0 { return msg }
	var p @[]char = methodRecordProblem(w, "p", "Get", 0, "P")
	p = buf.Concat(p, methodRecordProblem(w, "p", "Get", 1, "P"))
	p = buf.Concat(p, methodRecordProblem(w, "P", "Get", 0, "P"))
	var get @types.Method = w.C.ExprMethod(selectorOf(w, "p", "Get", 0))
	if !same(w.C.ExprMethod(selectorOf(w, "p", "Get", 1)), get) ||
			!same(w.C.ExprMethod(selectorOf(w, "P", "Get", 0)), get) {
		p = buf.Concat(p, "Get: the call, the value and the expression must record one method; ")
	}
	p = buf.Concat(p, methodRecordProblem(w, "b", "Val", 0, ""))
	p = buf.Concat(p, methodRecordProblem(w, "", "Val", 0, ""))
	var val @types.Method = w.C.ExprMethod(selectorOf(w, "b", "Val", 0))
	if val != nil &&
			(val.FuncType == nil || len(val.FuncType.Results) != 1 ||
					!val.FuncType.Results[0].Identical(types.TypInt())) {
		p = buf.Concat(p, "b.Val: not the instance's method; ")
	}
	p = buf.Concat(p, methodRecordProblem(w, "t", "Do", 1, "P"))
	if w.C.ExprMethod(selectorOf(w, "t", "Do", 0)) != nil {
		p = buf.Concat(p, "t.Do: the generic body selects no method; ")
	}
	if w.C.ExprMethod(selectorOf(w, "d", "Do", 0)) != nil {
		p = buf.Concat(p, "d.Do: an interface call records no method; ")
	}
	if w.C.ExprMethod(selectorOf(w, "fv", "Get", 0)) != nil {
		p = buf.Concat(p, "fv.Get: a field records no method; ")
	}
	return p
}
