package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// ============================================================
// Method calls
//
// These tests exercise tryMethodCall and the receiver-smoothing rules
// in receiverShape / receiverAssignable.
// ============================================================

func TestCheckMethodCallPointerOnPointer() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct { x int }\n"
					"func (p *Point) X() int { return p.x }\n"
					"func main() {\n"
					"  var pp *Point = nil\n"
					"  var v int = pp.X()\n"
					"  _ = v\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckMethodCallValueOnValue() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Counter struct { n int }\n"
