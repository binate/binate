// Two methods on different types with the same name resolve by receiver type.
func TestCheckMethodCallDispatchByType() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type A struct { v int }\n"
					"type B struct { v bool }\n"
					"func (a *A) Get() int { return a.v }\n"
					"func (b *B) Get() bool { return b.v }\n"
					"func main() {\n"
					"  var pa *A = nil\n"
					"  var pb *B = nil\n"
					"  var x int = pa.Get()\n"
					"  var y bool = pb.Get()\n"
					"  _ = x; _ = y\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// ============================================================
// Pointer-to-iface-value smoothing.  `p.Foo()` for `p` of kind
// `**I`, `*@I`, `@(*I)`, or `@(@I)` peels one pointer layer and
// looks up the method on the iv.
// ============================================================

func TestCheckMethodCallSmoothPtrRawIvRaw() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { Foo() int }\n"
					"type T struct { x int }\n"
					"func (t *T) Foo() int { return t.x }\n"
					"impl *T : I\n"
					"func use(p **I) int { return p.Foo() }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckMethodCallSmoothPtrRawIvMgd() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
