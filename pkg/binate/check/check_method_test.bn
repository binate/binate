// Method name not on the iface — even after smoothing, the
// method must exist in the iface's method set.
func TestCheckMethodCallSmoothPtrUnknownMethodRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { Foo() int }\n"
					"type T struct { x int }\n"
					"func (t *T) Foo() int { return t.x }\n"
					"impl *T : I\n"
					"func use(p **I) int { return p.Nope() }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// OBJECT-const receiver model.  `readonly @Box` is a
// const POINTER to a MUTABLE object, so it dispatches to any method (the
// readonly is on the handle, not the pointee).
func TestCheckMethodCallReadonlyManagedPtrAllowed() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func (b *Box) setV(x int) { b.v = x }\n"
					"func use(p @Box) {\n"
					"  var rp readonly @Box = p\n"
					"  rp.setV(9)\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// A method call through an ALIAS-typed receiver (`type AB = @Box`) must
// dispatch.  ReceiverBaseNamed peels pointer/managed/readonly but NOT
// TYP_ALIAS, so the named-base lookup is done off the alias-peeled `resolved`
// (not raw recvType) — else an alias receiver resolves to nil ("cannot call
// non-function").  This is the alias sibling of the readonly receiver peel.
func TestCheckMethodCallAliasReceiverAllowed() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func (b *Box) getV() int { return b.v }\n"
					"type AB = @Box\n"
					"func use(p @Box) {\n"
					"  var x AB = p\n"
					"  _ = x.getV()\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// `@(readonly Box)` is a mutable pointer to a CONST object, so calling a
// method whose receiver is `*Box` (which could mutate the object) is rejected.
func TestCheckMethodCallConstObjectRejectsMutableReceiver() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func (b *Box) setV(x int) { b.v = x }\n"
					"func use(p @Box) {\n"
					"  var op @(readonly Box) = p\n"
					"  op.setV(9)\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// A `@(readonly Box)` const object CAN call a method whose receiver is itself
// const-pointee (`*readonly Box`) — that method promises not to mutate.
func TestCheckMethodCallConstObjectAllowsConstReceiver() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func (b *readonly Box) peek() int { return b.v }\n"
					"func use(p @Box) int {\n"
					"  var op @(readonly Box) = p\n"
					"  return op.peek()\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// A `readonly @Iface` receiver dispatches through the interface method set:
// tryMethodCall resolves the receiver with resolveAliasAndConst (not
// ResolveAlias), which peels the IR-transparent `readonly` wrapper so the
// interface-value arm is reached.  Pre-fix this rejected with "cannot access
// field on this type", which ruled out ALL interface use of a readonly value
// (claude-todo readonly CRITICAL Symptom 2).
func TestCheckMethodCallReadonlyIfaceDispatch() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Getter { get() int }\n"
					"type Impl struct { v int }\n"
					"func (im *Impl) get() int { return im.v }\n"
					"impl *Impl : Getter\n"
					"func use(r @Getter) int {\n"
					"  var rr readonly @Getter = r\n"
					"  return rr.get()\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Constructing a `readonly @Iface` from a CONCRETE impl must type-check:
// AssignableTo peels the readonly wrapper before the interface-value kind test,
// so the iface-wrap arm is reached instead of falling to `return false`.
// Pre-fix this rejected ("cannot assign @Impl to readonly @Getter").  This is
// the construction-site sibling of the dispatch-site peel (which handled an
// iface-value source; this is the concrete source).
func TestCheckMethodCallConcreteToReadonlyIfaceConstruct() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Getter { get() int }\n"
					"type Impl struct { v int }\n"
					"func (im *Impl) get() int { return im.v }\n"
					"impl *Impl : Getter\n"
					"func use(im @Impl) int {\n"
					"  var iv readonly @Getter = im\n"
					"  return iv.get()\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// mainCallSelectors checks src and returns, in order, the selectors of the
// method calls that are whole statements of func main's body.
func mainCallSelectors(src *[]readonly char) @[]@ast.Expr {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	var sels @[]@ast.Expr = make_slice(@ast.Expr, 0)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC || !streq(d.Name, "main") || d.Body == nil { continue }
		for j := 0; j < len(d.Body.Stmts); j++ {
			var st @ast.Stmt = d.Body.Stmts[j]
			if st.Kind != ast.STMT_EXPR || st.X == nil || st.X.Kind != ast.EXPR_CALL { continue }
			if st.X.X == nil || st.X.X.Kind != ast.EXPR_SELECTOR { continue }
			var grown @[]@ast.Expr = make_slice(@ast.Expr, len(sels) + 1)
			for k := 0; k < len(sels); k++ { grown[k] = sels[k] }
			grown[len(sels)] = st.X.X
			sels = grown
		}
	}
	return sels
}

// A method call records an implicit `&` on its selector exactly when a VALUE
// receiver is passed to a `*T` method: `v.bump()`, `arr[1].bump()`, `h.p.bump()`
// — not a value method on a value, nor a `*T` method on a pointer.
func TestCheckMethodCallRecordsImplicitAddr() testing.TestResult {
	var sels @[]@ast.Expr = mainCallSelectors(
			"package \"test\"\n"
					"type P struct { n int }\n"
					"func (p *P) bump() { p.n = p.n + 1 }\n"
					"func (p P) get() int { return p.n }\n"
					"type H struct { p P }\n"
					"func main() {\n"
					"  var v P\n"
					"  var arr [2]P\n"
					"  var h H\n"
					"  var pp *P = &v\n"
					"  v.bump()\n"
					"  arr[1].bump()\n"
					"  h.p.bump()\n"
					"  v.get()\n"
					"  pp.bump()\n"
					"}\n")
	if len(sels) != 5 { return "expected 5 method-call statements" }
	if !sels[0].ImplicitAddr || !sels[1].ImplicitAddr || !sels[2].ImplicitAddr {
		return "a value receiver of a *T method must record the implicit &"
	}
	if sels[3].ImplicitAddr { return "a value method on a value takes no address" }
	if sels[4].ImplicitAddr { return "a *T method on a pointer takes no address" }
	return ""
}

// mainVarInitSelectors checks src and returns, in order, the selector
// initializers of the `var` declarations that are whole statements of func
// main's body.
func mainVarInitSelectors(src *[]readonly char) @[]@ast.Expr {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	var sels @[]@ast.Expr = make_slice(@ast.Expr, 0)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC || !streq(d.Name, "main") || d.Body == nil { continue }
		for j := 0; j < len(d.Body.Stmts); j++ {
			var st @ast.Stmt = d.Body.Stmts[j]
			if st.Kind != ast.STMT_DECL || st.DeclRef == nil { continue }
			var v @ast.Expr = st.DeclRef.Value
			if v == nil || v.Kind != ast.EXPR_SELECTOR { continue }
			var grown @[]@ast.Expr = make_slice(@ast.Expr, len(sels) + 1)
			for k := 0; k < len(sels); k++ { grown[k] = sels[k] }
			grown[len(sels)] = v
			sels = grown
		}
	}
	return sels
}

// A method VALUE records an implicit `&` on its selector exactly when an
// ADDRESSABLE value receiver is bound to a `*T` method (it captures `&x`):
// `v.bump`, `arr[1].bump`, `h.p.bump` — not a non-addressable call result, not
// a value method, nor a `*T` method on a pointer.
func TestCheckMethodValueRecordsImplicitAddr() testing.TestResult {
	var sels @[]@ast.Expr = mainVarInitSelectors(
			"package \"test\"\n"
					"type P struct { n int }\n"
					"func (p *P) bump() { p.n = p.n + 1 }\n"
					"func (p P) get() int { return p.n }\n"
					"type H struct { p P }\n"
					"func mk() P { var p P; return p }\n"
					"func main() {\n"
					"  var v P\n"
					"  var arr [2]P\n"
					"  var h H\n"
					"  var pp *P = &v\n"
					"  var f1 *func() = v.bump\n"
					"  var f2 *func() = arr[1].bump\n"
					"  var f3 *func() = h.p.bump\n"
					"  var f4 *func() = mk().bump\n"
					"  var f5 *func() int = v.get\n"
					"  var f6 *func() = pp.bump\n"
					"  f1(); f2(); f3(); f4(); _ = f5(); f6()\n"
					"}\n")
	if len(sels) != 6 { return "expected 6 method-value initializers" }
	if !sels[0].ImplicitAddr || !sels[1].ImplicitAddr || !sels[2].ImplicitAddr {
		return "an addressable value receiver of a *T method value must record the implicit &"
	}
	if sels[3].ImplicitAddr { return "a non-addressable receiver has no address to capture" }
	if sels[4].ImplicitAddr { return "a value method value takes no address" }
	if sels[5].ImplicitAddr { return "a *T method value on a pointer takes no address" }
	return ""
}
