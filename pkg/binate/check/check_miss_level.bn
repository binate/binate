package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// A type argument's constraint miss, at its level.  A miss found with no
// instance's concrete type arguments bound is a declaration's (missDeclLevel):
// reported naming no instance, it stands for the misses the instances find at its
// site (repeatsDeclarationMiss, foldInstanceMiss).  Found in an abstract instance
// another declaration forms, it stands only for those of an instance that
// specializes that one: W[V]'s miss for W[int32]'s, but neither H[X, int32]'s for
// H[int8, int16]'s, J[Self, int32]'s for J[R, int8]'s nor H[*X, int32]'s for
// H[int16, int32]'s.  So a miss keeps the type arguments bound when it is found
// (CheckError.MissArgs), and an instance's must specialize them (missArgsCover).

// addConstraintMiss reports msg at pos, written at via in the generic alias
// targets pos is the use of (CheckError.MissVia), a type argument's miss of the
// constraint of the type parameter index of the generic d (reportConstraintMiss).
func addConstraintMiss(c @Checker, pos token.Pos, via @[]token.Pos, msg @[]char, d @ast.Decl,
		index int) {
	var e CheckError
	e.Pos = pos
	e.Msg = msg
	e.MissDecl = bit_cast(*uint8, d)
	e.MissParam = index
	e.MissVia = via
	e.DeclLevel = missDeclLevel(c)
	e.MissArgs = missArgs(c)
	reportCheckError(c, e, true)
}

// missDeclLevel reports whether a constraint miss reported now is found with no
// instance's concrete type arguments bound -- a declaration's own, as written or
// through an abstract instance: InstanceState.Concrete, or, for a check replayed
// after it was recorded, what it was when recorded (Generics.MissLevel).
func missDeclLevel(c @Checker) bool {
	if c.Generics.MissLevel != 0 {
		return c.Generics.MissLevel == 1
	}
	return c.Instances == nil || c.Instances.Concrete == 0
}

// missArgs returns the type arguments a constraint miss found now is found with:
// for a check replayed after it was recorded, those bound when it was recorded
// (Generics.MissArgs), else those bound (Generics.BoundArgs).
func missArgs(c @Checker) @[]@types.Type {
	if c.Generics.MissLevel != 0 { return c.Generics.MissArgs }
	return c.Generics.BoundArgs
}

// missArgsCover reports whether a declaration's miss found with the type
// arguments decl stands for an instance's found with inst at the same site: inst
// specializes each of decl (argSpecializes).  One found with none -- outside any
// instantiation -- stands for every instance's, as does one found with another
// generic's (a different count).
func missArgsCover(decl *[]@types.Type, inst *[]@types.Type) bool {
	if len(decl) == 0 || len(decl) != len(inst) { return true }
	for i := 0; i < len(decl); i++ {
		if !argSpecializes(decl[i], inst[i]) { return false }
	}
	return true
}

// argSpecializes reports whether the type inst is d with each of its type
// parameters and `Self` replaced by a type and each of its dependent array lengths
// by a length: identical where d depends on neither, of d's shape around the parts
// that do.  A part it does not compare -- a struct or function type that depends
// on a type parameter -- specializes nothing, so a miss found with it stands for
// none.
func argSpecializes(d @types.Type, inst @types.Type) bool {
	if d == nil || inst == nil { return true }
	var k int = d.Kind
	if k == types.TYP_TYPE_PARAM || k == types.TYP_SELF { return true }
	if !mentionsTypeParam(d) && !holdsDependentLength(d) { return d.IdenticalStrict(inst) }
	if k != inst.Kind { return false }
	if k == types.TYP_ARRAY {
		if !d.ArrayLenDependent && d.ArrayLen != inst.ArrayLen { return false }
		return argSpecializes(d.Elem, inst.Elem)
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_SLICE ||
			k == types.TYP_MANAGED_SLICE || k == types.TYP_READONLY || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		return argSpecializes(d.Elem, inst.Elem)
	}
	if d.InstDecl == nil || d.InstDecl != inst.InstDecl || len(d.InstArgs) != len(inst.InstArgs) {
		return false
	}
	for i := 0; i < len(d.InstArgs); i++ {
		if !argSpecializes(d.InstArgs[i], inst.InstArgs[i]) { return false }
	}
	return true
}

// A savedMissLevel is Generics' MissLevel and MissArgs, saved (setMissLevel).
type savedMissLevel struct {
	Level int
	Args  @[]@types.Type
}

// setMissLevel makes the constraint misses reported until restoreMissLevel found
// with no instance's type arguments bound when declLevel, with them otherwise
// (missDeclLevel), and with the type arguments args (missArgs), and returns what
// restores it.
func setMissLevel(c @Checker, declLevel bool, args @[]@types.Type) savedMissLevel {
	var saved savedMissLevel
	saved.Level = c.Generics.MissLevel
	saved.Args = c.Generics.MissArgs
	c.Generics.MissLevel = 2
	if declLevel { c.Generics.MissLevel = 1 }
	c.Generics.MissArgs = args
	return saved
}

// restoreMissLevel ends what setMissLevel began, restoring saved.
func restoreMissLevel(c @Checker, saved savedMissLevel) {
	c.Generics.MissLevel = saved.Level
	c.Generics.MissArgs = saved.Args
}

// enterConcrete marks what is resolved until leaveConcrete as an instance's with
// the concrete type arguments args (InstanceState.Concrete, Generics.BoundArgs),
// for an instance resolved without a binding (bindInstanceIn), and returns the
// type arguments bound before.
func enterConcrete(c @Checker, args @[]@types.Type) @[]@types.Type {
	var st @InstanceState = instanceState(c)
	st.Concrete = st.Concrete + 1
	var saved @[]@types.Type = c.Generics.BoundArgs
	c.Generics.BoundArgs = args
	return saved
}

// leaveConcrete ends what enterConcrete began, restoring saved.
func leaveConcrete(c @Checker, saved @[]@types.Type) {
	var st @InstanceState = instanceState(c)
	st.Concrete = st.Concrete - 1
	c.Generics.BoundArgs = saved
}
