package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/token"

// A type argument's constraint miss, at its level.  A miss found with no
// instance's concrete type arguments bound is a declaration's (missDeclLevel):
// reported naming no instance, it stands for the misses the instances find at its
// site (repeatsDeclarationMiss, foldInstanceMiss), as W[V]'s does for W[int32]'s.
// An abstract instance -- a type parameter or `Self` among its type arguments --
// is named by no program (spec gen.mono.instances), so what its structure forms
// judges no constraint (judgesConstraints): its generic's own check judges what
// the generic writes, the lengths its type parameters give deferred, and each
// instance the program names judges it again with them known (gen.mono.check).
// So H[X, int32], formed in a function f[X] that is never instantiated, is not
// rejected for H's field `*K[@T, W]` that misses for W = int32, nor does a miss of
// J[Self, int32], formed in I[int32]'s method signature, stand by its site for
// J[R, int8]'s.

// addConstraintMiss reports msg at pos, written at via in the generic alias
// targets pos is the use of (CheckError.MissVia), a type argument's miss of the
// constraint of the type parameter index of the generic d (reportConstraintMiss).
func addConstraintMiss(c @Checker, pos token.Pos, via @[]token.Pos, msg @[]char, d @ast.Decl,
		index int) {
	var e CheckError
	e.Pos = pos
	e.Msg = msg
	e.MissDecl = bit_cast(*uint8, d)
	e.MissParam = index
	e.MissVia = via
	e.DeclLevel = missDeclLevel(c)
	reportCheckError(c, e, true)
}

// missDeclLevel reports whether a constraint miss reported now is found with no
// instance's concrete type arguments bound -- a declaration's own:
// InstanceState.Concrete, or, for a check replayed after it was recorded, what it
// was when recorded (Generics.MissLevel).
func missDeclLevel(c @Checker) bool {
	if c.Generics.MissLevel != 0 {
		return c.Generics.MissLevel == 1
	}
	return c.Instances == nil || c.Instances.Concrete == 0
}

// judgesConstraints reports whether the instantiations formed now are judged
// against their constraints: not in what an abstract instance's structure forms
// (Generics.AbstractBound), nor in the build of an instance no program names
// (holdingUnnamed), which no program names either (spec gen.mono.instances).
func judgesConstraints(c @Checker) bool {
	return !c.Generics.AbstractBound && !holdingUnnamed(c)
}

// setMissLevel makes the constraint misses reported until it is restored found
// with no instance's type arguments bound when declLevel, with them otherwise
// (missDeclLevel), and returns what restores it.
func setMissLevel(c @Checker, declLevel bool) int {
	var saved int = c.Generics.MissLevel
	c.Generics.MissLevel = 2
	if declLevel { c.Generics.MissLevel = 1 }
	return saved
}

// enterConcrete marks what is resolved until leaveConcrete as an instance's with
// concrete type arguments (InstanceState.Concrete), for an instance resolved
// without a binding (bindInstanceIn), whose structure judges constraints
// (judgesConstraints), and returns what leaveConcrete restores.
func enterConcrete(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	st.Concrete = st.Concrete + 1
	var saved bool = c.Generics.AbstractBound
	c.Generics.AbstractBound = false
	return saved
}

// leaveConcrete ends what enterConcrete began, restoring saved.
func leaveConcrete(c @Checker, saved bool) {
	var st @InstanceState = instanceState(c)
	st.Concrete = st.Concrete - 1
	c.Generics.AbstractBound = saved
}
