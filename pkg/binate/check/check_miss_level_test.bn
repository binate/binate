package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_miss_level.bn: a declaration's constraint miss, found in an
// abstract instance, stands for the misses of the instances that specialize it
// and no others.

// missShapes are, after aliasMissPrelude, H (whose K[@T, W] misses for W of 2 and 4
// bytes) and a declaration forming an abstract instance of H with W int32.
var missShapes @[]@[]char = @[]@[]char{
		"func f[X any](x X) int { var h H[X, int32]; return 0 }\n",
		"type F[X any] struct { h H[[2][sizeof(X)]uint8, int32] }\n"}

// The abstract instance's miss of Tag[[4]uint8] does not stand for H[int8, int16]'s
// miss of Tag[[2]uint8] at the same place, H[int8, int16] not specializing it,
// whichever comes first.
func TestAbstractInstanceMissCoversOnlyItsSpecializations() testing.TestResult {
	var h *[]readonly char = "type H[V any, W any] struct { k *K[@T, W]; v V }\n"
	var h8 *[]readonly char = "var h8 H[int8, int16]\n"
	for i := 0; i < len(missShapes); i++ {
		var r testing.TestResult = expectTwoInstanceMisses(
				checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, h), buf.Concat(missShapes[i], h8))),
				"type argument @T does not satisfy constraint Tag[[2]uint8] (in H[int8, int16], ")
		if len(r) > 0 { return r }
		r = expectTwoInstanceMisses(
				checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, h), buf.Concat(h8, missShapes[i]))),
				"type argument @T does not satisfy constraint Tag[[2]uint8] (in H[int8, int16], ")
		if len(r) > 0 { return r }
	}
	return ""
}

// Y's field forms W[V, int32], whose G[V] misses Eq at W's field: that miss stands
// for W[int32, int32]'s there, which Y[int32] forms, as W[int32, int32]
// specializes W[V, int32].
func TestAbstractInstanceMissCoversItsSpecialization() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq { eq() int }\ntype G[T Eq] struct { t T }\n"
					"type W[K Eq, J any] struct { g *G[K]; a [sizeof(J)]uint8 }\n"
					"type S struct { y Y[int32] }\ntype Y[V any] struct { w W[V, int32] }\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 || anyErrContains(c, "type argument int32") ||
			!anyErrIs(c, "type argument V does not satisfy constraint Eq") {
		return fail(buf.Concat("expected V's misses alone; ", allErrorMsgs(c)))
	}
	return ""
}

// H[*X, int32], formed in f, misses Tag[[N]uint8] at H's field for a pointer's
// size N; H[int16, int32]'s miss of Tag[[2]uint8] there is reported too, int16 not
// being a pointer, whichever is checked first.
func TestStructuredAbstractInstanceMissCoversOnlyItsSpecializations() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\ninterface Tag[X any] { tag() int }\n"
			"type K[V Tag[[sizeof(U)]uint8], U any] struct { v V }\ntype T struct { n int }\n"
			"func (t @T) tag() int { return t.n }\nimpl @T : Tag[[1]uint8]\n"
			"type H[V any, W any] struct { k *K[@T, V]; w W }\n"
	var f *[]readonly char = "func f[X any](x X) int { var h H[*X, int32]; return 0 }\n"
	var h16 *[]readonly char = "var h16 H[int16, int32]\n"
	var other *[]readonly char = "type argument @T does not satisfy constraint Tag[[2]uint8] (in H[int"
			"16, int32], "
	var srcs @[]@[]char = @[]@[]char{buf.Concat(decls, buf.Concat(f, h16)),
			buf.Concat(decls, buf.Concat(h16, f))}
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if len(c.CheckerErrors()) != 2 || !anyErrContains(c, other) {
			return fail(buf.Concat("expected H[*X, int32]'s miss and H[int16, int32]'s; ", allErrorMsgs(c)))
		}
	}
	return ""
}

// I[int32]'s method signature forms J[Self, int32], abstract only through `Self`,
// whose method's K[@T, int32] misses Tag[[4]uint8]: J[R, int8]'s miss of
// Tag[[1]uint8] at the same place is reported too, whichever is formed first; and
// the same with G2[Self, int32], a struct, as the parameter's type.
func TestSelfInstanceMissCoversOnlyItsSpecializations() testing.TestResult {
	var decls *[]readonly char = "interface J[S any, U any] { n(k *K[@T, U]) int }\n"
			"interface I[U any] { m(j *J[Self, U]) int }\ntype R struct { n int }\n"
	var j8 *[]readonly char = "type J8 struct { j *J[R, int8] }\n"
	var i32 *[]readonly char = "type I32 struct { i *I[int32] }\n"
	var srcs @[]@[]char = @[]@[]char{
			buf.Concat(buf.Concat(aliasMissPrelude, decls), buf.Concat(i32, j8)),
			buf.Concat(buf.Concat(aliasMissPrelude, decls), buf.Concat(j8, i32))}
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectTwoInstanceMisses(checkSrc(srcs[i]),
				"type argument @T does not satisfy constraint Tag[[1]uint8] (in J[R, int8], ")
		if len(r) > 0 { return r }
	}
	return expectTwoInstanceMisses(
			checkSrc(buf.Concat(aliasMissPrelude,
					"type G2[S any, U any] struct { k *K[@T, U] }\ninterface I[U any] { m(g G2[Self, U]) int }\n"
							"type R struct { n int }\ntype I32 struct { i *I[int32] }\n"
							"type G8 struct { g *G2[R, int8] }\n")),
			"type argument @T does not satisfy constraint Tag[[1]uint8] (in G2[R, int8], ")
}

// expectTwoInstanceMisses expects c's errors to be two: a miss of Tag[[4]uint8],
// naming no instance, and other.
func expectTwoInstanceMisses(c @Checker, other *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 || !anyErrContains(c, other) ||
			!anyErrIs(c, "type argument @T does not satisfy constraint Tag[[4]uint8]") {
		return fail(
				buf.Concat("expected the abstract instance's miss and the other's; ", allErrorMsgs(c)))
	}
	return ""
}

// anyErrIs reports whether one of c's errors is msg.
func anyErrIs(c @Checker, msg *[]readonly char) bool {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if streq(errs[i].Msg, msg) { return true }
	}
	return false
}
