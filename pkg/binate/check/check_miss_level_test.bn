package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_miss_level.bn: what an abstract instance's structure forms --
// one with a type parameter or `Self` among its type arguments -- is judged against
// no constraint, which no program names; each instance named judges its own.

// missShapes are, after aliasMissPrelude, H (whose K[@T, W] misses for W of 2 and 4
// bytes) and a declaration forming an abstract instance of H with W int32.
var missShapes @[]@[]char = @[]@[]char{
		"func f[X any](x X) int { var h H[X, int32]; _ = h; return 0 }\n",
		"func f[X any](h *H[X, int32]) int { return 0 }\n",
		"func f[X any](x X) int { var h H[*X, int32]; _ = h; return 0 }\n",
		"type F[X any] struct { h H[[2][sizeof(X)]uint8, int32] }\n"}

// An abstract instance of H with W int32 is not rejected for K[@T, W], which misses
// for W = int32 whatever its other argument: no instance of it is named, f and F
// never being instantiated.  Beside H[int8, int16], whose miss of Tag[[2]uint8]
// there is reported alone, whichever comes first.
func TestAbstractInstanceJudgesNoConstraint() testing.TestResult {
	var h *[]readonly char = "type H[V any, W any] struct { k *K[@T, W]; v V }\n"
	var h8 *[]readonly char = "var h8 H[int8, int16]\n"
	var miss *[]readonly char = "type argument @T does not satisfy constraint Tag[[2]uint8] "
			"(in H[int8, int16], "
	for i := 0; i < len(missShapes); i++ {
		var decls @[]char = buf.Concat(aliasMissPrelude, h)
		var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat(decls, missShapes[i])))
		if len(r) > 0 { return r }
		r = expectOneError(checkSrc(buf.Concat(decls, buf.Concat(missShapes[i], h8))), miss)
		if len(r) > 0 { return r }
		r = expectOneError(checkSrc(buf.Concat(decls, buf.Concat(h8, missShapes[i]))), miss)
		if len(r) > 0 { return r }
	}
	return ""
}

// gf's call in an array length of H's field is judged against nothing in the
// abstract H[X, int32] f's signature forms: f alone is accepted, and beside
// H[int8, int16], whose call misses Tag[[2]uint8], that miss is reported alone,
// whichever comes first.  The same through `Self`: J[Self, int32], which I[int32]'s
// method signature forms, beside J[R, int8], whose call misses Tag[[1]uint8].
func TestAbstractInstanceJudgesNoCallConstraint() testing.TestResult {
	var gf *[]readonly char = "func gf[V Tag[[sizeof(U)]uint8], U any]() [3]uint8 "
			"{ var r [3]uint8; return r }\n"
	var h *[]readonly char = "type H[V any, W any] struct { a [len(gf[@T, W]())]uint8; v V }\n"
	var f *[]readonly char = "func f[X any](h *H[X, int32]) int { return 0 }\n"
	var h8 *[]readonly char = "var h8 H[int8, int16]\n"
	var miss *[]readonly char = "type argument @T does not satisfy constraint Tag[[2]uint8] "
			"(in H[int8, int16], "
	var decls @[]char = buf.Concat(aliasMissPrelude, buf.Concat(gf, h))
	var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat(decls, f)))
	if len(r) > 0 { return r }
	r = expectOneError(checkSrc(buf.Concat(decls, buf.Concat(f, h8))), miss)
	if len(r) > 0 { return r }
	r = expectOneError(checkSrc(buf.Concat(decls, buf.Concat(h8, f))), miss)
	if len(r) > 0 { return r }
	var ij *[]readonly char = "interface J[S any, U any] { n(a *([len(gf[@T, U]())]uint8)) int }\n"
			"interface I[U any] { m(j *J[Self, U]) int }\ntype R struct { n int }\n"
	var i32 *[]readonly char = "func use(i *I[int32]) {}\n"
	var j8 *[]readonly char = "func use2(j *J[R, int8]) {}\n"
	var jmiss *[]readonly char = "type argument @T does not satisfy constraint Tag[[1]uint8] "
			"(in J[R, int8], "
	decls = buf.Concat(aliasMissPrelude, buf.Concat(gf, ij))
	r = expectOneError(checkSrc(buf.Concat(decls, buf.Concat(i32, j8))), jmiss)
	if len(r) > 0 { return r }
	return expectOneError(checkSrc(buf.Concat(decls, buf.Concat(j8, i32))), jmiss)
}

// f[int8] names H[int8, int32], which f's body forms: its miss is reported, naming
// it, where the abstract H[X, int32] in f's own check reports none.
func TestInstanceNamedThroughAbstractOneJudged() testing.TestResult {
	return expectOneError(
			checkSrc(buf.Concat(aliasMissPrelude, "type H[V any, W any] struct { k *K[@T, W]; v V }\n"
					"func f[X any](x X) int { var h H[X, int32]; _ = h; return 0 }\n"
					"func g() int { return f[int8](1) }\n")),
			"type argument @T does not satisfy constraint Tag[[4]uint8] (in H[int8, int32], ")
}

// f's X is a Tag[[4]uint8], which H[X, int64] does not make a Tag[[8]uint8] for
// every X; but @B, the one X the program gives f, is both, so H[@B, int64], the one
// instance of H named, is well-formed, and the program with it.
func TestAbstractInstanceDoesNotRejectWhatItsInstancesAccept() testing.TestResult {
	return expectNoErrors(checkSrc(
			buf.Concat(aliasMissPrelude, "type B struct { n int }\nfunc (b @B) tag() int { return b.n }\n"
					"impl @B : Tag[[4]uint8]\nimpl @B : Tag[[8]uint8]\n"
					"type H[V Tag[[4]uint8], W any] struct { k *K[V, W] }\n"
					"func f[X Tag[[4]uint8]](x X) int { var h H[X, int64]; _ = h; return 0 }\n"
					"func g() int { return f[@B](make(B)) }\n")))
}

// I[int32]'s method signature forms J[Self, int32], abstract through `Self`, whose
// method's K[@T, int32] misses Tag[[4]uint8]: no program names it, and J[R, int8]'s
// miss of Tag[[1]uint8] at the same place is reported alone, whichever is formed
// first; the same with G2[Self, int32], a struct, as the parameter's type.
func TestSelfInstanceJudgesNoConstraint() testing.TestResult {
	var decls *[]readonly char = "interface J[S any, U any] { n(k *K[@T, U]) int }\n"
			"interface I[U any] { m(j *J[Self, U]) int }\ntype R struct { n int }\n"
	var j8 *[]readonly char = "type J8 struct { j *J[R, int8] }\n"
	var i32 *[]readonly char = "type I32 struct { i *I[int32] }\n"
	var miss *[]readonly char = "type argument @T does not satisfy constraint Tag[[1]uint8] "
			"(in J[R, int8], "
	var r testing.TestResult = expectNoErrors(
			checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, decls), i32)))
	if len(r) > 0 { return r }
	r = expectOneError(checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, decls), buf.Concat(i32, j8))),
			miss)
	if len(r) > 0 { return r }
	r = expectOneError(checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, decls), buf.Concat(j8, i32))),
			miss)
	if len(r) > 0 { return r }
	return expectOneError(
			checkSrc(buf.Concat(aliasMissPrelude, "type G2[S any, U any] struct { k *K[@T, U] }\n"
					"interface I[U any] { m(g G2[Self, U]) int }\n"
					"type R struct { n int }\ntype I32 struct { i *I[int32] }\n"
					"type G8 struct { g *G2[R, int8] }\n")),
			"type argument @T does not satisfy constraint Tag[[1]uint8] (in G2[R, int8], ")
}

// A method of G2 whose signature misses for G2[S, int32] is accepted whether it is
// declared before or after the abstract instance G2[Self, int32] or G2[X, int32]
// is formed -- in an interface's method signature, a function's signature or a
// function's body: none is named.
func TestAbstractInstanceMethodJudgedInNoOrder() testing.TestResult {
	var self *[]readonly char = "interface I[U any] { m(g G2[Self, U]) int }\n"
			"func use(i *I[int32]) {}\n"
	var sig *[]readonly char = "func f[X any](g *G2[X, int32]) int { return 0 }\n"
	var body *[]readonly char = "func f[X any](x X) int { var g G2[X, int32]; _ = g; return 0 }\n"
	var forms @[]@[]char = @[]@[]char{buf.CopyStr(self), buf.CopyStr(sig), buf.CopyStr(body)}
	var g2 *[]readonly char = "type G2[S any, U any] struct { s S; u U }\n"
	var m *[]readonly char = "func (g *G2[S, U]) n(k *K[@T, U]) int { return 0 }\n"
	for i := 0; i < len(forms); i++ {
		var decls @[]char = buf.Concat(aliasMissPrelude, g2)
		var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat(decls, buf.Concat(forms[i], m))))
		if len(r) > 0 { return r }
		r = expectNoErrors(checkSrc(buf.Concat(decls, buf.Concat(m, forms[i]))))
		if len(r) > 0 { return r }
	}
	return ""
}

// expectOneError expects c's errors to be one, containing want.
func expectOneError(c @Checker, want *[]readonly char) testing.TestResult {
	if len(c.CheckerErrors()) != 1 || !anyErrContains(c, want) {
		var got @[]char = buf.Concat("; ", allErrorMsgs(c))
		return fail(buf.Concat(buf.Concat("expected one error, with ", want), got))
	}
	return ""
}

// anyErrIs reports whether one of c's errors is msg.
func anyErrIs(c @Checker, msg *[]readonly char) bool {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if streq(errs[i].Msg, msg) { return true }
	}
	return false
}
