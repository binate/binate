package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// A list of names that also says in time independent of its length whether it holds a
// name: the constants being resolved (Checker.ConstResolving, a stack) and resolved
// (ConstResolved).

// nameList is names in order, with how many times it holds each (counts).
type nameList struct {
	items  @vec.Vec[@[]char]
	counts @table.Table[*[]readonly char, nameCount, ScopeNameHasher, ScopeNameEq]
}

// nameCount is how many times a nameList holds a name, and the name its key borrows:
// every write of the count passes this name as the key (a table's Put keeps the key it
// is given), so the key outlives any one entry of the name.
type nameCount struct {
	n    int
	name @[]char
}

// newNameList returns an empty nameList.
func newNameList() @nameList {
	var l @nameList = make(nameList)
	l.items = vec.New[@[]char]()
	l.counts = table.NewTable[*[]readonly char, nameCount, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	return l
}

// has reports whether l holds name.
func (l @nameList) has(name *[]readonly char) bool {
	return l.counts.Has(name)
}

// push appends name to l.
func (l @nameList) push(name @[]char) {
	l.items.Push(name)
	v, found := l.counts.Get(name)
	if !found { v.name = name }
	v.n = v.n + 1
	l.counts.Put(v.name, v)
}

// pop removes l's last name; an empty l is an internal error.
func (l @nameList) pop() {
	name, popped := l.items.Pop()
	if !popped { panic("internal error: a name popped from an empty list") }
	v, _ := l.counts.Get(name)
	if v.n > 1 {
		v.n = v.n - 1
		l.counts.Put(v.name, v)
	} else {
		_ = l.counts.Remove(name)
	}
}

// removeAll removes every entry of name from l, keeping the others in order.
func (l @nameList) removeAll(name *[]readonly char) {
	if !l.counts.Has(name) { return }
	var kept @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < l.items.Len(); i++ {
		var x @[]char = l.items.Get(i)
		if !types.CharEq(x, name) { kept.Push(x) }
	}
	_ = l.counts.Remove(name)
	l.items = kept
}

// count returns how many entries l holds.
func (l @nameList) count() int {
	return l.items.Len()
}

// at returns l's i-th entry.
func (l @nameList) at(i int) @[]char {
	return l.items.Get(i)
}
