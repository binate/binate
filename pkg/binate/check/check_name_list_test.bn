package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_name_list.bn.

// A nameList holds its names in order and counts repeats: a name stays held until its
// last entry is popped, and removeAll takes every entry of it, keeping the rest in order.
func TestNameList() testing.TestResult {
	var l @nameList = newNameList()
	l.push(buf.CopyStr("a"))
	l.push(buf.CopyStr("b"))
	l.push(buf.CopyStr("a"))
	if !l.has("a") || !l.has("b") || l.has("c") || l.count() != 3 { return "a, b, a" }
	l.pop()
	if !l.has("a") || l.count() != 2 { return "one a left after a pop" }
	l.push(buf.CopyStr("c"))
	l.push(buf.CopyStr("a"))
	l.removeAll("a")
	if l.has("a") || l.count() != 2 || !types.CharEq(l.at(0), "b") || !types.CharEq(l.at(1), "c") {
		return "b, c once every a is removed"
	}
	l.pop()
	l.pop()
	if l.has("b") || l.count() != 0 { return "empty" }
	return ""
}
