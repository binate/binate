package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/containers/vec"

// What a value name resolves to, as the check resolved it: each identifier, and
// each package-qualified selector `pkg.X`, that names a value records the
// symbol it resolved to, in the expression records (check_type_stamps.bn),
// which Checker.ExprSymbol reads -- the names an expression reads, and the
// function a `_func_handle` or `__c_entry` operand names -- and so does the
// package name of such a selector, with the import's symbol.  The head of a
// generic function's instantiation (`G[T]`, `pkg.G[T]`), which names no value
// without its type arguments, records the generic function (stampGenericHead).
// `__Package`, which no scope declares, records the accessor of the package it
// names (packageAccessorSymbol): bare, the package whose code is checked;
// `pkg.__Package`, the import's.  A declaration may have more than one symbol
// over a check (a typed package variable is defined when declarations are
// collected and again when it is checked), so its uses' records need not hold
// the same one; each gives the same kind, level and package.  A symbol says
// where it is declared: the scope it is first defined in stamps its level and
// package on it (Scope.Define), a package's scopes being marked as such
// (markPackageScope) and the universe's as the universe's.  An instance's copy
// of a generic body records its own symbols, which its check resolved in the
// generic's declaring package.

// SCOPE_PACKAGE is the Level of a scope at a package's top level.
const SCOPE_PACKAGE int = 1

// SCOPE_UNIVERSE is the Level of the universe scope.
const SCOPE_UNIVERSE int = 2

// markPackageScope marks s as a scope at the top level of package pkg.
func markPackageScope(s @Scope, pkg *[]readonly char) {
	s.Level = SCOPE_PACKAGE
	s.Pkg = buf.CopyStr(pkg)
}

// stampExprSymbol records sym as the value the identifier or package-qualified
// selector e resolved to (nothing for a nil e or sym), replacing the record of an
// earlier check of e.
func stampExprSymbol(c @Checker, e @ast.Expr, sym @Symbol) {
	if e == nil || sym == nil {
		return
	}
	var tab @vec.Vec[exprStamp] = stampTablesOf(c).Exprs
	var node *ast.Expr = e
	var id int = e.DenotedTypeID
	if id > 0 && id < tab.Len() && same(tab.Get(id).Node, node) {
		var s exprStamp = tab.Get(id)
		s.Sym = sym
		tab.Set(id, s)
		return
	}
	var s exprStamp
	s.Node = node
	s.Sym = sym
	e.DenotedTypeID = tab.Len()
	tab.Push(s)
}

// stampGenericHead records the generic function g as the one the head e of an
// instantiation names (`g`, `pkg.G`), and, for a package-qualified head, the
// import as its package name's symbol.
func stampGenericHead(c @Checker, e @ast.Expr, g @Symbol) {
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var psym @Symbol = c.Scope.Lookup(e.X.Name)
		if psym != nil && psym.Kind == types.SYM_PKG { stampExprSymbol(c, e.X, psym) }
	}
	stampExprSymbol(c, e, g)
}

// packageAccessorSymbol returns a symbol for the `__Package` accessor of package
// pkg, of type typ (packageAccessorType).  The compiler synthesizes the accessor
// for every package and no scope declares it, so its references record this
// symbol: a function of pkg's top level.
func packageAccessorSymbol(pkg *[]readonly char, typ @types.Type) @Symbol {
	var sym @Symbol = make(Symbol)
	sym.Name = buf.CopyStr("__Package")
	sym.Type = typ
	sym.Kind = types.SYM_FUNC
	sym.Level = SCOPE_PACKAGE
	sym.ScopePkg = buf.CopyStr(pkg)
	return sym
}

// ExprSymbol returns the symbol the identifier or package-qualified selector e
// resolved to as a value name, or the generic function it names as the head of
// an instantiation, as this checker resolved it, or nil when it recorded none
// for e (e names a type or a package, or is not checked).
func (c @Checker) ExprSymbol(e *ast.Expr) @Symbol {
	if e == nil || c.Stamps == nil {
		return nil
	}
	var tab @vec.Vec[exprStamp] = c.Stamps.Exprs
	var id int = e.DenotedTypeID
	if id <= 0 || id >= tab.Len() || !same(tab.Get(id).Node, e) {
		return nil
	}
	return tab.Get(id).Sym
}

// IsPackageLevel reports whether s is declared at a package's top level (an
// import included), not in a function or a block, nor predeclared.
func (s @Symbol) IsPackageLevel() bool {
	return s.Level == SCOPE_PACKAGE
}

// IsPredeclared reports whether s is a binding of the universe scope.
func (s @Symbol) IsPredeclared() bool {
	return s.Level == SCOPE_UNIVERSE
}

// DeclPkg returns the package that declares the package-level symbol s -- for
// one another package exposes, its home -- and "" for any other symbol.
func (s @Symbol) DeclPkg() @[]char {
	var none @[]char
	if s.Level != SCOPE_PACKAGE {
		return none
	}
	if len(s.HomePkg) > 0 {
		return s.HomePkg
	}
	return s.ScopePkg
}
