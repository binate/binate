package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the checker's records of what value names resolve to
// (check_name_records.bn).

// nameWalkOf returns a walk of file's declarations and their instance copies,
// as c checked them (stampWalk; its Names are the identifiers and selectors).
func nameWalkOf(c @Checker, file @ast.File) @stampWalk {
	var w @stampWalk = newStampWalk(c)
	walkStampFile(w, file)
	return w
}

// nameAt returns the n-th (from 0) identifier or selector named name that the
// walk w found, or nil.
func nameAt(w @stampWalk, name *[]readonly char, n int) @ast.Expr {
	var left int = n
	for i := 0; i < w.Names.Len(); i++ {
		var e @ast.Expr = w.Names.Get(i)
		if charSliceEq(e.Name, name) {
			if left == 0 { return e }
			left -= 1
		}
	}
	return nil
}

// nameProblem returns what is wrong with the record of the n-th name the walk
// found (nameAt) -- it should be a symbol of kind kind at level level
// (Scope.Level: 0 for a local), declared in package pkg ("" unless at a
// package's top level) -- or "" for nothing.
func nameProblem(w @stampWalk, name *[]readonly char, n int, kind int, level int,
		pkg *[]readonly char) @[]char {
	var e @ast.Expr = nameAt(w, name, n)
	var what @[]char = buf.Concat(name, ": ")
	if e == nil { return buf.Concat(what, "not found") }
	var sym @Symbol = w.C.ExprSymbol(e)
	if sym == nil { return buf.Concat(what, "no record") }
	if sym.Kind != kind { return buf.Concat(what, "the wrong kind") }
	if sym.IsPackageLevel() != (level == SCOPE_PACKAGE) ||
			sym.IsPredeclared() != (level == SCOPE_UNIVERSE) {
		return buf.Concat(what, "the wrong level")
	}
	if !charSliceEq(sym.DeclPkg(), pkg) {
		return buf.Concat(what, buf.Concat("declared in ", sym.DeclPkg()))
	}
	return ""
}

// checkedNameWalk checks src, which must check cleanly, and returns a walk of it.
func checkedNameWalk(src *[]readonly char) (@stampWalk, @[]char) {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(src)
	if len(c.Errors) > 0 {
		return nil, buf.Concat("the program must check: ", c.Errors[0].Msg)
	}
	return nameWalkOf(c, file), ""
}

// A package's variables, constants and functions are recorded as declared at its
// top level, in it; parameters and a function's variables and constants as
// local; `panic` as predeclared.
func TestNameRecordsLevels() testing.TestResult {
	var w @stampWalk
	var msg @[]char
	w, msg = checkedNameWalk(
			"package \"main\"\n"
					"var G int = 1\n"
					"const K = 2\n"
					"func F() int { return 3 }\n"
					"func use(p int) int {\n"
					"\tconst lk = 4\n"
					"\tvar x int = G + K + p + lk + F()\n"
					"\tif x < 0 { panic(\"negative\") }\n"
					"\treturn x\n"
					"}\n"
					"func main() { _ = use(0) }\n")
	if len(msg) > 0 { return msg }
	var p @[]char = nameProblem(w, "G", 0, types.SYM_VAR, SCOPE_PACKAGE, "main")
	p = buf.Concat(p, nameProblem(w, "K", 0, types.SYM_CONST, SCOPE_PACKAGE, "main"))
	p = buf.Concat(p, nameProblem(w, "F", 0, types.SYM_FUNC, SCOPE_PACKAGE, "main"))
	p = buf.Concat(p, nameProblem(w, "p", 0, types.SYM_VAR, 0, ""))
	p = buf.Concat(p, nameProblem(w, "lk", 0, types.SYM_CONST, 0, ""))
	p = buf.Concat(p, nameProblem(w, "x", 0, types.SYM_VAR, 0, ""))
	p = buf.Concat(p, nameProblem(w, "panic", 0, types.SYM_FUNC, SCOPE_UNIVERSE, ""))
	p = buf.Concat(p, nameProblem(w, "use", 0, types.SYM_FUNC, SCOPE_PACKAGE, "main"))
	return p
}

// A local that shadows a package variable is recorded as the local, and the
// package variable where the local is not in scope.
func TestNameRecordsShadowing() testing.TestResult {
	var w @stampWalk
	var msg @[]char
	w, msg = checkedNameWalk(
			"package \"main\"\n"
					"var G int = 1\n"
					"func main() {\n\tvar G int = 2\n\t_ = G\n}\n"
					"func g() int { return G }\n")
	if len(msg) > 0 { return msg }
	var p @[]char = nameProblem(w, "G", 0, types.SYM_VAR, 0, "")
	return buf.Concat(p, nameProblem(w, "G", 1, types.SYM_VAR, SCOPE_PACKAGE, "main"))
}

// A package variable whose type is its initializer's, which a function reads
// before its declaration is checked -- so it is defined on demand -- is recorded
// as declared at the top level.
func TestNameRecordsOnDemand() testing.TestResult {
	var w @stampWalk
	var msg @[]char
	w, msg = checkedNameWalk("package \"main\"\nfunc main() { _ = Later }\nvar Later = 1\n")
	if len(msg) > 0 { return msg }
	return nameProblem(w, "Later", 0, types.SYM_VAR, SCOPE_PACKAGE, "main")
}

// nameLibBni / nameLibBn are package pkg/lib: a variable, a function, a constant,
// and a generic function whose body reads the package's W.
var nameLibBni *[]readonly char =
	"package \"pkg/lib\"\nvar V int\nvar W int\nfunc F() int\nconst C = 3\n"
			"func Get[T any](x T) int { return W }\n"

var nameLibBn *[]readonly char = "package \"pkg/lib\"\nvar V int = 1\nvar W int = 5\n"
		"func F() int { return 2 }\n"

// checkNameUser checks package q's one .bn, src, in c, and returns it.
func checkNameUser(c @Checker, src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(toBytes(src), "q.bn")
	var bn @ast.File = mustParse(p)
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = bn
	var noBni @ast.File
	c.CheckPackage("q", bn, files, noBni)
	return bn
}

// `lib.X` is recorded as lib's X, and the package name as q's import of lib.  A
// generic body's names are recorded in its instance's copy as its own package's:
// Get[int]'s W is lib's, though q declares a W too.
func TestNameRecordsImported() testing.TestResult {
	var c @Checker
	var bni @ast.File
	c, bni, _ = checkerWithLibFiles(nameLibBni, nameLibBn)
	var q @ast.File = checkNameUser(c, "package \"q\"\nimport \"pkg/lib\"\nvar W int = 7\n"
			"func U() int { return lib.V + lib.F() + lib.C + lib.Get[int](0) + W }\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	var w @stampWalk = nameWalkOf(c, q)
	var p @[]char = nameProblem(w, "V", 0, types.SYM_VAR, SCOPE_PACKAGE, "pkg/lib")
	p = buf.Concat(p, nameProblem(w, "F", 0, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
	p = buf.Concat(p, nameProblem(w, "C", 0, types.SYM_CONST, SCOPE_PACKAGE, "pkg/lib"))
	p = buf.Concat(p, nameProblem(w, "W", 0, types.SYM_VAR, SCOPE_PACKAGE, "q"))
	p = buf.Concat(p, nameProblem(w, "lib", 0, types.SYM_PKG, SCOPE_PACKAGE, "q"))
	var cw @stampWalk = newStampWalk(c)
	for i := 0; i < len(bni.Decls); i++ { walkStampCopies(cw, bni.Decls[i]) }
	return buf.Concat(p, nameProblem(cw, "W", 0, types.SYM_VAR, SCOPE_PACKAGE, "pkg/lib"))
}

// A member another package exposes is recorded as declared in its home.
func TestNameRecordsExposedHome() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"pkg/p\"\nvar PV int\n"))
	c.LoadPackageInterface("pkg/fwd", mkBniFile("package \"pkg/fwd\"\nexpose \"pkg/p\"\n"))
	var q @ast.File = checkNameUser(c,
			"package \"q\"\nimport \"pkg/fwd\"\nfunc U() int { return fwd.PV }\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	return nameProblem(nameWalkOf(c, q), "PV", 0, types.SYM_VAR, SCOPE_PACKAGE, "pkg/p")
}

// A function a `_func_handle` or a `__c_entry` operand names is recorded, also
// through a package.
func TestNameRecordsFuncOperands() testing.TestResult {
	var c @Checker
	c, _, _ = checkerWithLibFiles(nameLibBni, nameLibBn)
	var q @ast.File = checkNameUser(c, "package \"q\"\nimport \"pkg/lib\"\n"
			"func cb(a int32) int32 { return a }\n"
			"func U() *uint8 {\n\tvar h *uint8 = _func_handle(lib.F)\n\t_ = h\n\treturn __c_entry(cb)\n}\n"
			"func Own() *uint8 { return _func_handle(cb) }\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	var w @stampWalk = nameWalkOf(c, q)
	var p @[]char = nameProblem(w, "F", 0, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib")
	p = buf.Concat(p, nameProblem(w, "cb", 0, types.SYM_FUNC, SCOPE_PACKAGE, "q"))
	return buf.Concat(p, nameProblem(w, "cb", 1, types.SYM_FUNC, SCOPE_PACKAGE, "q"))
}

// Every identifier the check types as an expression (ResolvedTypeID) and every
// package-qualified selector, an instantiation's head included, has a record.  A
// field or method selector has none, nor does a name a type position names or a
// `:=` binds (stmt.shortvar.rebind: it always binds).
func TestNameRecordsCoverValues() testing.TestResult {
	var c @Checker
	c, _, _ = checkerWithLibFiles(nameLibBni, nameLibBn)
	var q @ast.File = checkNameUser(c, "package \"q\"\n"
			"import \"pkg/lib\"\n"
			"const N int = 2\n"
			"type P struct { a int; f *func(int) int }\n"
			"func (p *P) Get(x int) int { return p.a + x }\n"
			"var g P\n"
			"func twice(v int) int { return v * N }\n"
			"func Pick[T any](x T, y T) T { return x }\n"
			"func run(items *[]int) int {\n"
			"\tvar total int = lib.V + lib.F() + lib.C\n"
			"\tfor i, v in items { total += i * v }\n"
			"\tvar arr [N]int = [N]int{N - 1: total}\n"
			"\tvar lit P = P{a: arr[0], f: twice}\n"
			"\tvar fl *func(int) int = func(k int) int { return k + total }\n"
			"\tswitch total {\n\tcase N:\n\t\ttotal = lit.f(total)\n"
			"\tdefault:\n\t\ttotal = fl(total)\n\t}\n"
			"\tvar m *func(*P, int) int = P.Get\n"
			"\ta, b := g.Get(total), Pick[int](total, N)\n"
			"\tvar h *uint8 = _func_handle(twice)\n"
			"\t_ = h\n"
			"\tdefer { _ = twice(a) }\n"
			"\tb += lib.Get[int](b)\n"
			"\treturn m(&g, a) + b\n"
			"}\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	var w @stampWalk = nameWalkOf(c, q)
	var out @[]char
	var selectors int
	for i := 0; i < w.Names.Len(); i++ {
		var e @ast.Expr = w.Names.Get(i)
		var sym @Symbol = w.C.ExprSymbol(e)
		if e.Kind == ast.EXPR_IDENT {
			var named bool = w.C.ExprDenotedType(e) != nil || nameBound(w, e) || isBlank(e.Name)
			if e.ResolvedTypeID > 0 && !named && sym == nil {
				out = buf.Concat(out, buf.Concat(e.Name, ": no record; "))
			} else if named && sym != nil {
				out = buf.Concat(out, buf.Concat(e.Name, ": a record on no value name; "))
			}
			continue
		}
		var qualified bool = e.X != nil && e.X.Kind == ast.EXPR_IDENT && fileImportsAs(w.File, e.X.Name)
		if qualified { selectors += 1 }
		if qualified && sym == nil {
			out = buf.Concat(out, buf.Concat(e.Name, ": no record; "))
		} else if !qualified && sym != nil {
			out = buf.Concat(out, buf.Concat(e.Name, ": a record on a member selector; "))
		}
	}
	if selectors != 4 { out = buf.Concat(out, "the walk must meet lib.V, lib.F, lib.C and lib.Get; ") }
	return out
}

// nameGenLibBni is package pkg/lib's interface: two generic functions, Outer's
// body instantiating Inner.
var nameGenLibBni *[]readonly char = "package \"pkg/lib\"\nfunc Inner[T any](x T) T { return x }\n"
		"func Outer[T any](x T) T { return Inner[T](x) }\n"

// The head of a generic function's instantiation is recorded as the generic
// function -- its own package's, another's (and that package's name as the
// import), or one another package exposes, in its home -- and a variable of the
// generic's name indexed as the variable.  In an instance's copy of a generic
// body, a head is recorded as the generic of the body's own package: Outer[int]'s
// Inner is lib's, though q declares an Inner too.
func TestNameRecordsGenericHeads() testing.TestResult {
	var c @Checker
	var bni @ast.File
	c, bni, _ = checkerWithLibFiles(nameGenLibBni, "package \"pkg/lib\"\n")
	c.LoadPackageInterface("pkg/fwd", mkBniFile("package \"pkg/fwd\"\nexpose \"pkg/lib\"\n"))
	var q @ast.File = checkNameUser(c, "package \"q\"\nimport \"pkg/lib\"\nimport \"pkg/fwd\"\n"
			"func Inner[T any](x T) T { return x }\n"
			"func one(v int) int { return v }\n"
			"func U() int { return Inner[int](1) + lib.Outer[int](2) + fwd.Outer[int](3) }\n"
			"func V() int {\n\tvar Inner [1]*func(int) int\n\tInner[0] = one\n\treturn Inner[0](4)\n}\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	var w @stampWalk = nameWalkOf(c, q)
	var p @[]char = nameProblem(w, "Inner", 0, types.SYM_FUNC, SCOPE_PACKAGE, "q")
	p = buf.Concat(p, nameProblem(w, "Outer", 0, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
	p = buf.Concat(p, nameProblem(w, "lib", 0, types.SYM_PKG, SCOPE_PACKAGE, "q"))
	p = buf.Concat(p, nameProblem(w, "Outer", 1, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
	p = buf.Concat(p, nameProblem(w, "fwd", 0, types.SYM_PKG, SCOPE_PACKAGE, "q"))
	p = buf.Concat(p, nameProblem(w, "Inner", 1, types.SYM_VAR, 0, ""))
	p = buf.Concat(p, nameProblem(w, "Inner", 2, types.SYM_VAR, 0, ""))
	var cw @stampWalk = newStampWalk(c)
	for i := 0; i < len(bni.Decls); i++ { walkStampCopies(cw, bni.Decls[i]) }
	return buf.Concat(p, nameProblem(cw, "Inner", 0, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
}

// nameAccLibBni is package pkg/lib's interface: a generic function whose body
// reads the name of its package.
var nameAccLibBni *[]readonly char = "package \"pkg/lib\"\n"
		"func Name[T any](x T) *[]readonly char { return __Package().Name }\n"

// `__Package` is recorded as the accessor of the package it names: bare, the
// package whose code it is in -- q, or in an instance's copy of a generic body,
// the generic's package -- and qualified (also as a `_func_handle` operand), the
// import's.
func TestNameRecordsPackageAccessor() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/builtins/reflect",
			mkBniFile("package \"pkg/builtins/reflect\"\ntype Package struct { Name *[]readonly char }\n"))
	var bni @ast.File = mkBniFile(nameAccLibBni)
	var bn @ast.File = mustParse(parser.New(toBytes("package \"pkg/lib\"\n"), "lib.bn"))
	bn.Decls = mergeBniLikeLoader(bni, bn)
	c.LoadPackageInterface("pkg/lib", bni)
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = bn
	c.CheckPackage("pkg/lib", bn, files, bni)
	var q @ast.File = checkNameUser(c, "package \"q\"\nimport \"pkg/lib\"\n"
			"func U() *[]readonly char { return lib.Name[int](1) }\n"
			"func V() *[]readonly char { return __Package().Name }\n"
			"func W() *[]readonly char { return lib.__Package().Name }\n"
			"func X() *uint8 { return _func_handle(lib.__Package) }\n")
	if len(c.Errors) > 0 { return buf.Concat("the program must check: ", c.Errors[0].Msg) }
	var w @stampWalk = nameWalkOf(c, q)
	var p @[]char = nameProblem(w, "__Package", 0, types.SYM_FUNC, SCOPE_PACKAGE, "q")
	p = buf.Concat(p, nameProblem(w, "__Package", 1, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
	p = buf.Concat(p, nameProblem(w, "__Package", 2, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
	var cw @stampWalk = newStampWalk(c)
	for i := 0; i < len(bni.Decls); i++ { walkStampCopies(cw, bni.Decls[i]) }
	return buf.Concat(p, nameProblem(cw, "__Package", 0, types.SYM_FUNC, SCOPE_PACKAGE, "pkg/lib"))
}

// nameBound reports whether the walk w met e as a name a `:=` binds.
func nameBound(w @stampWalk, e @ast.Expr) bool {
	for i := 0; i < w.Bound.Len(); i++ {
		if same(w.Bound.Get(i), e) { return true }
	}
	return false
}
