package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"

// Opaque-type predicates and the value-embedding gate.  An opaque type is a
// forward-declared `type T` with no body (TYP_NAMED, Underlying == nil) whose
// layout is unknown (supplied externally in C/asm).  It may be held behind a
// pointer / handle (`*T` / `@T`), but a VALUE of it can never be formed —
// Size/AlignOf would fabricate ptrSize and silently miscompile.  These gates
// give a clean use-site diagnostic instead.

// isOpaqueType reports whether t bottoms out at an opaque type.  It peels alias
// / readonly / named-distinct wrappers via peelFieldAccessBase, so a distinct
// type over an opaque base (`type A Opaque`) is opaque too — matching how field
// access treats the same type.  A generic type parameter is TYP_TYPE_PARAM (not
// TYP_NAMED), so it is correctly NOT opaque here.
//
// The whole-program build loads every dependency's .bn, so a cross-package
// opaque export's body is filled at importer use sites (not opaque there); the
// gate fires for pure opaque types — no full definition anywhere — which is the
// case that matters.
func isOpaqueType(t @types.Type) bool {
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	return base != nil && base.Kind == types.TYP_NAMED && base.Underlying == nil
}

// isCrossPkgOpaqueExport reports whether t bottoms out at an OPAQUE-EXPORT type
// (a `.bni` forward decl whose layout was filled from its own package's `.bn` —
// OpaqueExportPkg set; see Type.OpaqueExportPkg) that is opaque here
// (opaqueExportHiddenHere): viewed from a DIFFERENT package than the one that
// owns it, or from that package's own `.bni`.  Such a type has a non-nil
// Underlying (so isOpaqueType misses it under co-compilation) but is opaque to
// THIS package: a value of it can no more be formed here than a pure opaque
// type can.  Peels alias / readonly / transparent-named wrappers — but NOT
// pointers (a `*Box` / `@Box` handle to it is the legal escape hatch), matching
// isOpaqueType's peel.  Same-package use (OpaqueExportPkg == curPkgPath) outside
// the package's `.bni` is not opaque — the provider forms its own values.
func isCrossPkgOpaqueExport(c @Checker, t @types.Type) bool {
	var g chainGuard = newChainGuard(t)
	for t != nil {
		if t.Kind == types.TYP_NAMED && opaqueExportHiddenHere(c, t) {
			return true
		}
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return false
		}
		if t != nil && chainCloses(&g, t) { return false }
	}
	return false
}

// opaqueExportHiddenHere reports whether t, if an opaque export (OpaqueExportPkg
// set), is opaque here: viewed from a package other than its own, or from its
// own package's `.bni` — which importers read, so it sees the type as they do
// (pkg.bni.self-contained) — and, in an instance's body, not lent to it by
// where the instance is instantiated (lentHere).
func opaqueExportHiddenHere(c @Checker, t @types.Type) bool {
	if len(t.OpaqueExportPkg) == 0 { return false }
	return (!types.CharEq(t.OpaqueExportPkg, c.curPkgPath) || inBniView(c)) &&
			!lentHere(c, t.OpaqueExportPkg)
}

// isOpaqueValueType reports whether forming a VALUE of t is forbidden because t
// is opaque to the current package — either a pure opaque type (nil Underlying)
// or a cross-package opaque export (filled layout, but the .bni surface is
// opaque here).  The single predicate the by-value gates key off.
func isOpaqueValueType(c @Checker, t @types.Type) bool {
	return isOpaqueType(t) || isCrossPkgOpaqueExport(c, t)
}

// The views an opaque walk judges a type in (opaqueInView).  A type is judged
// as the place where it is written sees it; inside an instance's structure, the
// parts its generic's own declaration writes were judged there, and only the
// parts that come from its type arguments are judged again.
const (
	// viewHere counts a type with no definition anywhere and an opaque export
	// hidden where the walk runs (opaqueExportHiddenHere).
	viewHere int = iota
	// viewPure counts only a type with no definition anywhere: an instance
	// with no abstract structure is walked substituted this way, its generic's
	// own parts not told from its arguments (substitutedView).
	viewPure
	// viewNone counts no type: the parts of an instance's structure that its
	// generic's declaration writes (instanceStructure).
	viewNone
)

// opaqueInView is isOpaqueValueType in view (viewHere, viewPure, viewNone).
func opaqueInView(c @Checker, t @types.Type, view int) bool {
	if view == viewNone { return false }
	return isOpaqueType(t) && !typeInProgress(c, t) || view == viewHere && isCrossPkgOpaqueExport(c, t)
}

// embedsOpaqueByValue reports whether using t BY VALUE requires an opaque
// type's (unknown) layout: t itself is opaque, or t aggregates an opaque value
// — an array element, a struct field, or a slice element.  A raw/managed slice
// of a bare opaque element (`*[]Opaque` / `@[]Opaque`) is included: indexing
// needs the element stride, which is unknown, so the slice type is ill-formed.
// Pointers / handles (`*T` / `@T`) stop the recursion — their layout is known
// regardless of the pointee — so `*Opaque`, `[N]@Opaque`, `struct { p *Opaque }`,
// and `@[]@Opaque` (a slice of pointers) are all fine.
func embedsOpaqueByValue(c @Checker, t @types.Type) bool {
	var none *opaqueFrame
	return embedsOpaqueByValueFramed(c, t, viewHere, none)
}

// embedsOpaqueByValueFramed is embedsOpaqueByValue in view (opaqueInView), inside
// the instance structure frame f (bindFrame), if any.
func embedsOpaqueByValueFramed(c @Checker, t @types.Type, view int, f *opaqueFrame) bool {
	// Outside any frame, an opaque-free type embeds no opaque type in any view, and
	// the walk would change nothing (no postponed instance in it to build).
	if f == nil && isOpaqueFree(c, t) { return false }
	var seen typeVisits
	return embedsOpaqueByValueSeen(c, t, &seen, view, f)
}

// embedsOpaqueByValueSeen is the worker.  `seen` holds the peeled struct, array
// and slice types already entered (typeVisits): one entered before embeds no
// opaque this walk has not already reported, whether it was walked to the end or
// is on the current path — a slice element can lead back to a recursive managed
// type (`struct { kids @[]Node }`, `type S @[]S`), a cycle.  It walks resolved
// @types.Type fields / elements (alias / named-distinct peeled), not AST, taking
// them in turn from the work list (typeWalk) in the order a walk recursing on them
// takes; a type parameter the frame f binds is its argument (bindFrame), walked in a
// walk of its own in f's argument view, with no frame (so it binds nothing further).
func embedsOpaqueByValueSeen(c @Checker, t @types.Type, seen *typeVisits, view int,
		f *opaqueFrame) bool {
	var base int = typeWalkBase()
	var found bool = embedsOpaqueStep(c, t, seen, view, f)
	for !found && typeWalkMore(base) {
		found = embedsOpaqueStep(c, typeWalkPop(), seen, view, f)
	}
	typeWalkEnd(base)
	return found
}

// embedsOpaqueStep reports whether t is opaque in view, or is a type parameter f binds
// to an argument that embeds an opaque type; otherwise it pushes what t holds by
// value, last first, for embedsOpaqueByValueSeen to look at.
func embedsOpaqueStep(c @Checker, t @types.Type, seen *typeVisits, view int, f *opaqueFrame) bool {
	var bound @types.Type = bindFrameType(t, f)
	if bound != nil { return embedsOpaqueByValueSeen(c, bound, seen, f.argView, nil) }
	buildPostponedBase(c, t)
	if opaqueInView(c, t, view) {
		return true
	}
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	if base == nil {
		return false
	}
	if base.Kind == types.TYP_TYPE_PARAM && f != nil {
		bound = bindFrameType(base, f)
		if bound != nil { return embedsOpaqueByValueSeen(c, bound, seen, f.argView, nil) }
	}
	var k int = base.Kind
	if (k == types.TYP_STRUCT || k == types.TYP_ARRAY || k == types.TYP_SLICE ||
			k == types.TYP_MANAGED_SLICE) && !seen.enter(base) {
		return false
	}
	if k == types.TYP_ARRAY || k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
		typeWalkPush(base.Elem)
	} else if k == types.TYP_STRUCT {
		pushFieldTypes(base)
	}
	return false
}

// requireSizedType reports an error if t embeds an opaque type by value in a
// context that needs its layout — a value-typed variable, a struct value field,
// an array element, a slice element, or a by-value function parameter or
// return.  An opaque type can only be held behind a pointer or handle (`*T` /
// `@T`), never embedded by value.  It also reports a type too large for the
// target, or a pointee / element / field type it spells out that is (spec
// type.layout.max-size).  MUST be called only after type collection (when a
// forward-referenced placeholder is filled and only genuine opaques remain
// nil-Underlying) — see checkValueEmbedding.
// A check that meets a type not collected yet is made again once it is
// (check_opaque_recheck.bn).
func requireSizedType(c @Checker, t @types.Type, pos token.Pos) {
	var met int = pendingTypesMet(c)
	var w opaqueWalk
	var none *opaqueFrame
	// A type too large for the target (spec type.layout.max-size), or one it spells
	// out inline (a pointee, an element, a field, a function type's parameter or
	// result).
	if opaqueRulesKept(c, t, pos, &w, viewHere, none) { _ = requireFitting(c, t, pos) }
	_ = deferIfPending(c, met, deferredCheck(deferSized, t, pos))
}

// requireValueSized reports, at pos, a value of type t used there — read, copied,
// dereferenced, indexed or ranged over — that holds an opaque type by value, or
// whose type is too large for the target: the rules a value keeps.  The rules on
// forming a type (a pointer to a type embedding an opaque type by value, a
// function signature that breaks the opaque rules) and on the size of the types it
// spells out are checked where the type is written — a declaration, a composite
// literal, a builtin's operand, a call's signature — so a local of such a type is
// reported once, at its declaration, not again at each use.
func requireValueSized(c @Checker, t @types.Type, pos token.Pos) {
	if embedsOpaqueByValue(c, t) {
		addCheckError(c, pos,
				"cannot use an opaque type by value"
						" (its layout is not available here; hold it via *T or @T)")
		return
	}
	_ = requireFittingType(c, t, pos)
}

// requireFormedType reports the first rule on forming a type (formationRulesKept)
// that t, written at pos, breaks, and whether it keeps them: for a builtin's type
// operand (`make`, `make_slice`, `sizeof`, `alignof`, a `bit_cast` or `__c_call`
// result), whose use of an opaque type by value the builtin reports in its own
// words.
// A check that meets a type not collected yet is made again once it is
// (check_opaque_recheck.bn).
func requireFormedType(c @Checker, t @types.Type, pos token.Pos) bool {
	var met int = pendingTypesMet(c)
	var w opaqueWalk
	var none *opaqueFrame
	var kept bool = formationRulesKept(c, t, pos, &w, viewHere, none)
	_ = deferIfPending(c, met, deferredCheck(deferFormed, t, pos))
	return kept
}

// nestedPointerEmbedsOpaque reports whether a pointer or handle among t's
// parts — an array or slice element, a struct field, a pointee, at any depth —
// points to a type that embeds an opaque type by value (pointeeEmbedsOpaque,
// which judges t itself): `[2]*([2]Op)` and `struct { p *([2]Op) }` are as
// ill-formed as `*([2]Op)`.  The walk covers the structure t spells out,
// peeling aliases and readonly; it stops at a named type, whose own
// declaration is checked, except a generic instance, whose structure (the
// generic's with this use's arguments) no declaration checked as a whole: its
// generic's own parts were judged at its declaration, so only the parts that
// come from its arguments count (instanceStructure).  A function type is not
// entered: its parameters and results are each checked whole
// (rulesSigsStep).  view gives the view (opaqueInView).
func nestedPointerEmbedsOpaque(c @Checker, t @types.Type, view int, f *opaqueFrame) bool {
	var w opaqueWalk
	return partsPointToOpaqueEmbedding(c, t, &w, view, f)
}

// opaqueWalk holds the types nestedPointerEmbedsOpaque has entered, a set for
// each view (opaqueInView): one entered before was walked to the end in that
// view, or is on the current path (a recursive instance), so it adds nothing —
// and aliases sharing one struct type are walked once, not once per path to it
// (which is exponential in their depth).
type opaqueWalk struct {
	hereView typeVisits
	pureView typeVisits
	noneView typeVisits
	// checkedHere, checkedPure and checkedNone hold the parameter and result
	// types a signature walk has checked (signaturePartKept), in each view: a
	// type checked once is not checked again -- it kept the rules, or broke one
	// already reported.
	checkedHere typeVisits
	checkedPure typeVisits
	checkedNone typeVisits
	// brokeHere, brokePure and brokeNone hold the parts the argument walk found to
	// break a rule (check_opaque_args_walk.bn), in each view.  A pointee walk takes
	// an argument's breaking a rule only as leave to go on, and its own answer can be
	// false, so the walk goes on past such a part and can reach it again: then it
	// gives that answer, not the "adds nothing" of a part entered before.
	brokeHere typeVisits
	brokePure typeVisits
	brokeNone typeVisits
}

// enter reports whether t is new to view's part of the walk, and records it.
func (w *opaqueWalk) enter(t @types.Type, view int) bool {
	if view == viewHere { return w.hereView.enter(t) }
	if view == viewPure { return w.pureView.enter(t) }
	return w.noneView.enter(t)
}

// markBroke records that t breaks a rule in view (opaqueWalk.brokeHere).
func (w *opaqueWalk) markBroke(t @types.Type, view int) {
	if view == viewHere {
		_ = w.brokeHere.enter(t)
	} else if view == viewPure {
		_ = w.brokePure.enter(t)
	} else {
		_ = w.brokeNone.enter(t)
	}
}

// broke reports whether t was found to break a rule in view (markBroke).
func (w *opaqueWalk) broke(t @types.Type, view int) bool {
	if view == viewHere { return w.brokeHere.has(t) }
	if view == viewPure { return w.brokePure.has(t) }
	return w.brokeNone.has(t)
}

// checkOnce reports whether t's rules are yet to be checked in view, and
// records that they now are.
func (w *opaqueWalk) checkOnce(t @types.Type, view int) bool {
	if view == viewHere { return w.checkedHere.enter(t) }
	if view == viewPure { return w.checkedPure.enter(t) }
	return w.checkedNone.enter(t)
}
