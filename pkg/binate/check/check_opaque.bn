package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"
import "pkg/stdx/slices"

// Opaque-type predicates and the value-embedding gate.  An opaque type is a
// forward-declared `type T` with no body (TYP_NAMED, Underlying == nil) whose
// layout is unknown (supplied externally in C/asm).  It may be held behind a
// pointer / handle (`*T` / `@T`), but a VALUE of it can never be formed —
// SizeOf/AlignOf would fabricate ptrSize and silently miscompile.  These gates
// give a clean use-site diagnostic instead.

// isOpaqueType reports whether t bottoms out at an opaque type.  It peels alias
// / readonly / named-distinct wrappers via peelFieldAccessBase, so a distinct
// type over an opaque base (`type A Opaque`) is opaque too — matching how field
// access treats the same type.  A generic type parameter is TYP_TYPE_PARAM (not
// TYP_NAMED), so it is correctly NOT opaque here.
//
// The whole-program build loads every dependency's .bn, so a cross-package
// opaque export's body is filled at importer use sites (not opaque there); the
// gate fires for pure opaque types — no full definition anywhere — which is the
// case that matters.
func isOpaqueType(t @types.Type) bool {
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	return base != nil && base.Kind == types.TYP_NAMED && base.Underlying == nil
}

// isCrossPkgOpaqueExport reports whether t bottoms out at an OPAQUE-EXPORT type
// (a `.bni` forward decl whose layout was filled from its own package's `.bn` —
// OpaqueExportPkg set; see Type.OpaqueExportPkg / bug 211) viewed from a
// DIFFERENT package than the one that owns it.  Such a type has a non-nil
// Underlying (so isOpaqueType misses it under co-compilation) but is opaque to
// THIS package: a value of it can no more be formed here than a pure opaque
// type can.  Peels alias / readonly / transparent-named wrappers — but NOT
// pointers (a `*Box` / `@Box` handle to it is the legal escape hatch), matching
// isOpaqueType's peel.  Same-package use (OpaqueExportPkg == curPkgPath) is not
// opaque — the provider forms its own values.
func isCrossPkgOpaqueExport(c @Checker, t @types.Type) bool {
	var depth int = 0
	for t != nil && depth < 1024 {
		depth = depth + 1
		if t.Kind == types.TYP_NAMED && len(t.OpaqueExportPkg) > 0 &&
				!types.CharEq(t.OpaqueExportPkg, c.curPkgPath) {
			return true
		}
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return false
		}
	}
	return false
}

// isOpaqueValueType reports whether forming a VALUE of t is forbidden because t
// is opaque to the current package — either a pure opaque type (nil Underlying)
// or a cross-package opaque export (filled layout, but the .bni surface is
// opaque here).  The single predicate the by-value gates key off.
func isOpaqueValueType(c @Checker, t @types.Type) bool {
	return isOpaqueType(t) || isCrossPkgOpaqueExport(c, t)
}

// opaqueInView is isOpaqueValueType with the cross-package opaque exports
// counted only when exports is set: inside a generic instance only a type with
// no definition anywhere counts (nestedPointerEmbedsOpaque).
func opaqueInView(c @Checker, t @types.Type, exports bool) bool {
	return isOpaqueType(t) || exports && isCrossPkgOpaqueExport(c, t)
}

// embedsOpaqueByValue reports whether using t BY VALUE requires an opaque
// type's (unknown) layout: t itself is opaque, or t aggregates an opaque value
// — an array element, a struct field, or a slice element.  A raw/managed slice
// of a bare opaque element (`*[]Opaque` / `@[]Opaque`) is included: indexing
// needs the element stride, which is unknown, so the slice type is ill-formed.
// Pointers / handles (`*T` / `@T`) stop the recursion — their layout is known
// regardless of the pointee — so `*Opaque`, `[N]@Opaque`, `struct { p *Opaque }`,
// and `@[]@Opaque` (a slice of pointers) are all fine.
func embedsOpaqueByValue(c @Checker, t @types.Type) bool {
	return embedsOpaqueByValueIn(c, t, true)
}

// embedsOpaqueByValueIn is embedsOpaqueByValue in exports' view (opaqueInView).
func embedsOpaqueByValueIn(c @Checker, t @types.Type, exports bool) bool {
	var seen typeVisits
	return embedsOpaqueByValueSeen(c, t, &seen, exports)
}

// embedsOpaqueByValueSeen is the worker.  `seen` holds the peeled struct, array
// and slice types already entered (typeVisits): one entered before embeds no
// opaque this walk has not already reported, whether it was walked to the end or
// is on the current path — recursing into a slice element can revisit a recursive
// managed type (`struct { kids @[]Node }`, `type S @[]S`), a cycle.  Recurses
// over resolved @types.Type fields / elements (alias / named-distinct peeled),
// not AST.
func embedsOpaqueByValueSeen(c @Checker, t @types.Type, seen *typeVisits, exports bool) bool {
	if opaqueInView(c, t, exports) {
		return true
	}
	var base @types.Type
	base, _ = peelFieldAccessBase(t)
	if base == nil {
		return false
	}
	var k int = base.Kind
	if (k == types.TYP_STRUCT || k == types.TYP_ARRAY || k == types.TYP_SLICE ||
			k == types.TYP_MANAGED_SLICE) && !seen.enter(base) {
		return false
	}
	if base.Kind == types.TYP_ARRAY {
		return embedsOpaqueByValueSeen(c, base.Elem, seen, exports)
	}
	if base.Kind == types.TYP_STRUCT {
		for i := 0; i < len(base.Fields); i++ {
			if embedsOpaqueByValueSeen(c, base.Fields[i].Type, seen, exports) {
				return true
			}
		}
		return false
	}
	if base.Kind == types.TYP_SLICE || base.Kind == types.TYP_MANAGED_SLICE {
		return embedsOpaqueByValueSeen(c, base.Elem, seen, exports)
	}
	return false
}

// requireSizedType reports an error if t embeds an opaque type by value in a
// context that needs its layout — a value-typed variable, a struct value field,
// an array element, a slice element, or a by-value function parameter or
// return.  An opaque type can only be held behind a pointer or handle (`*T` /
// `@T`), never embedded by value.  MUST be called only after type collection
// (when a forward-referenced placeholder is filled and only genuine opaques
// remain nil-Underlying) — see checkValueEmbedding.
func requireSizedType(c @Checker, t @types.Type, pos token.Pos) {
	if embedsOpaqueByValue(c, t) {
		addCheckError(c, pos,
				"cannot use an opaque type by value"
						" (its layout is not available here; hold it via *T or @T)")
		return
	}
	// A pointer / handle whose ULTIMATE pointee embeds an opaque type by value
	// but is not itself bare opaque (`*Box[Opaque]`, `**Box[Opaque]`,
	// `@(*struct { o Opaque })`) is ill-formed: that pointee can never be a
	// value (every field access is rejected) and merely forming the type
	// instantiates / lays out a struct IR-gen would fabricate.  Bare `*Opaque`
	// / `@Opaque` — the escape hatch — stay legal (the pointee IS bare opaque).
	// This closes the pointer-to-opaque-embedding residual so IR-gen never sees
	// an opaque arg.
	if pointeeEmbedsOpaque(c, t) || nestedPointerEmbedsOpaque(c, t) {
		addCheckError(c, pos,
				"cannot form a pointer to a type that embeds an opaque type by"
						" value (it can never be a value; hold the opaque directly via"
						" *Opaque / @Opaque)")
	}
}

// nestedPointerEmbedsOpaque reports whether a pointer or handle among t's
// parts — an array or slice element, a struct field, a pointee, at any depth —
// points to a type that embeds an opaque type by value (pointeeEmbedsOpaque,
// which judges t itself): `[2]*([2]Op)` and `struct { p *([2]Op) }` are as
// ill-formed as `*([2]Op)`.  The walk covers the structure t spells out,
// peeling aliases and readonly; it stops at a named type, whose own
// declaration is checked, except a generic instance, whose structure (the
// generic's with this use's arguments) no declaration checked.  Inside an
// instance only a type with no definition anywhere counts as opaque: a
// package's opaque export is opaque only from other packages, and an
// instance's parts come from its generic's package as well as from its
// arguments.  A function type is not entered.
func nestedPointerEmbedsOpaque(c @Checker, t @types.Type) bool {
	var w opaqueWalk
	return partsPointToOpaqueEmbedding(c, t, &w, true)
}

// opaqueWalk holds the types nestedPointerEmbedsOpaque has entered, a set for
// each view (exports counted or not): one entered before was walked to the end
// in that view, or is on the current path (a recursive instance), so it adds
// nothing — and aliases sharing one struct type are walked once, not once per
// path to it (which is exponential in their depth).
type opaqueWalk struct {
	exportView typeVisits
	pureView   typeVisits
}

// enter reports whether t is new to exports' view of the walk, and records it.
func (w *opaqueWalk) enter(t @types.Type, exports bool) bool {
	if exports { return w.exportView.enter(t) }
	return w.pureView.enter(t)
}

// pointsToOpaqueEmbedding reports whether t, or one of its parts, is a pointer
// or handle to a type that embeds an opaque type by value, in exports' view.
func pointsToOpaqueEmbedding(c @Checker, t @types.Type, w *opaqueWalk, exports bool) bool {
	return pointeeEmbedsOpaqueIn(c, t, exports) || partsPointToOpaqueEmbedding(c, t, w, exports)
}

// partsPointToOpaqueEmbedding is pointsToOpaqueEmbedding for t's parts only.
func partsPointToOpaqueEmbedding(c @Checker, t @types.Type, w *opaqueWalk, exports bool) bool {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !w.enter(t, false) { return false }
			exports = false
			t = t.Underlying
		} else {
			break
		}
	}
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
		return w.enter(t, exports) && pointsToOpaqueEmbedding(c, t.Elem, w, exports)
	}
	if k == types.TYP_STRUCT && w.enter(t, exports) {
		for i := 0; i < len(t.Fields); i++ {
			if pointsToOpaqueEmbedding(c, t.Fields[i].Type, w, exports) { return true }
		}
	}
	return false
}

// pointeeEmbedsOpaque reports whether t is a pointer / handle (possibly nested,
// alias / named peeled) whose ULTIMATE pointee embeds an opaque type by value
// but is not itself bare opaque.  Peels through every pointer/handle level; a
// self-referential pointer chain (`type P *P`) terminates via the visited-name
// set with no opaque found.  Returns false for a non-pointer t (the value case
// is handled by embedsOpaqueByValue) and for the bare `*Opaque` / `@Opaque`
// escape hatch (the pointee is bare opaque).
func pointeeEmbedsOpaque(c @Checker, t @types.Type) bool {
	return pointeeEmbedsOpaqueIn(c, t, true)
}

// pointeeEmbedsOpaqueIn is pointeeEmbedsOpaque in exports' view (opaqueInView).
func pointeeEmbedsOpaqueIn(c @Checker, t @types.Type, exports bool) bool {
	var seen @[]@[]char
	var cur @types.Type = t
	var peeledPointer bool = false
	for cur != nil {
		// A pointee that is itself opaque here is the escape hatch, whatever its
		// definition — even one naming itself (`type Tree @[]Tree` exported as
		// `type Tree`), whose peeled underlying embeds the opaque Tree.
		if peeledPointer && opaqueInView(c, cur, exports) {
			return false
		}
		if len(cur.Name) > 0 {
			if containsName(seen, cur.Name) {
				return false
			}
			seen = slices.Append[@[]char](seen, cur.Name)
		}
		var base @types.Type
		base, _ = peelFieldAccessBase(cur)
		if base == nil {
			return false
		}
		if base.Kind == types.TYP_POINTER || base.Kind == types.TYP_MANAGED_PTR {
			cur = base.Elem
			peeledPointer = true
			continue
		}
		// base is the ultimate non-pointer pointee.  Flag it only if t was
		// actually a pointer (otherwise embedsOpaqueByValue already covered it).
		if !peeledPointer {
			return false
		}
		return embedsOpaqueByValueIn(c, base, exports) && !opaqueInView(c, base, exports)
	}
	return false
}
