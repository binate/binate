package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_opaque_args_walk.bn: the walk of whether type arguments may bring an
// opaque type, and of where pointers lead, judges types nested deepLevels deep.

// fakeInstance returns a named type with the type argument arg, as an instance of a
// generic is to the walk.
func fakeInstance(arg @types.Type) @types.Type {
	var t @types.Type = types.MakeNamedType("main.Box")
	t.InstArgs = make_slice(@types.Type, 1)
	t.InstArgs[0] = arg
	return t
}

// opaqueHolderPointer returns a pointer to a struct that holds an opaque type by value.
func opaqueHolderPointer() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Name = "o"
	fs[0].Type = types.MakeNamedType("pkg/x.O")
	var p @types.Type = make(types.Type)
	p.Kind = types.TYP_POINTER
	p.Elem = types.MakeStructType("", fs)
	return p
}

// argsBringOpaque reports whether instances of arrays and of structs may bring an
// opaque type, in a checker of its own, which holds the types its checks met and so is
// let go of before they are.
func argsBringOpaque(arrays @types.Type, structs @types.Type) (bool, bool) {
	var c @Checker = checkSrc("package \"main\"\n")
	var throughArrays bool = argsMayBringOpaque(c, fakeInstance(arrays), viewHere, nil)
	return throughArrays, argsMayBringOpaque(c, fakeInstance(structs), viewHere, nil)
}

// An instance's argument nested deepLevels deep -- in arrays, in structs -- over a
// pointer to a struct holding an opaque type may bring it.
func TestDeepArgsMayBringOpaque() testing.TestResult {
	var arrays @types.Type = arrayChain(deepLevels, opaqueHolderPointer())
	var structs @types.Type = structChain(deepLevels, opaqueHolderPointer())
	throughArrays, throughStructs := argsBringOpaque(arrays, structs)
	dropLinks(&arrays, deepLevels)
	dropLinks(&structs, deepLevels)
	if !throughArrays {
		return fail("an argument deep in arrays over an opaque holder's pointer may bring it")
	}
	if !throughStructs {
		return fail("an argument deep in structs over an opaque holder's pointer may bring it")
	}
	return ""
}

// instancePointerChain returns a pointer to the first of n instances, each with one
// type argument, a pointer to the next; the last has no argument and is over int.
func instancePointerChain(n int) @types.Type {
	var t @types.Type = types.MakeNamedType("main.L")
	t.Underlying = types.TypInt()
	for i := 0; i < n; i++ {
		var p @types.Type = make(types.Type)
		p.Kind = types.TYP_POINTER
		p.Elem = t
		t = fakeInstance(p)
	}
	var top @types.Type = make(types.Type)
	top.Kind = types.TYP_POINTER
	top.Elem = t
	return top
}

// dropInstancePointerChain releases a chain instancePointerChain built, a link at a
// time.
func dropInstancePointerChain(p *@types.Type) {
	for *p != nil {
		var l @types.Type = (*p).Elem
		*p = l
		if len(l.InstArgs) == 0 {
			*p = nil
		} else {
			*p = l.InstArgs[0]
		}
		l = nil
	}
}

// pointeeThroughInstances reports whether the pointee of chain embeds an opaque type,
// without and with the answers kept, in a checker of its own (argsBringOpaque).
func pointeeThroughInstances(chain @types.Type) (bool, bool) {
	var c @Checker = checkSrc("package \"main\"\n")
	var plain bool = pointeeEmbedsOpaque(c, chain, viewHere, nil)
	c.PointeeMemo = newPointeeMemo(c)
	return plain, pointeeEmbedsOpaque(c, chain, viewHere, nil)
}

// The pointer walk from a pointer to an instance whose argument points to the next,
// deepLevels deep, judges each instance's argument, which walks the next pointer --
// with the answers kept and without.
func TestDeepPointeeThroughInstances() testing.TestResult {
	var chain @types.Type = instancePointerChain(deepLevels)
	plain, kept := pointeeThroughInstances(chain)
	dropInstancePointerChain(&chain)
	if plain { return fail("a deep chain of instances over int embeds no opaque type") }
	if kept { return fail("a deep chain of instances over int embeds no opaque type, answers kept") }
	return ""
}

// A part an argument walk found to break a rule, reached again past a pointee walk
// that went on, gives that answer: an instance whose argument points to an instance
// whose argument points to one embedding an opaque type by value is reported, at any
// depth, as one level is -- through pointers, an array, a named pointer type.
func TestArgsWalkPartReachedAgainBreaks() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"type Opaque\n"
					"type W[T any] struct { v T }\n"
					"type L[T any] struct { n *T }\n"
					"type K[A any, B any] struct { a A; b B }\n"
					"type M *K[*M, *W[[1]Opaque]]\n"
					"func twoLevels(a W[*W[*W[[1]Opaque]]]) {}\n"
					"func threeLevels(p *L[*L[*L[[1]Opaque]]]) {}\n"
					"func throughArray(a W[*W[[2]*W[[1]Opaque]]]) {}\n")
	var msg *[]readonly char = "cannot form a pointer to a type that embeds an opaque type by value"
			" (it can never be a value; hold the opaque directly via *Opaque / @Opaque)"
	if !errAtLine(c, 6, msg) { return fail("M, a pointer to K[*M, *W[[1]Opaque]], is reported") }
	if !errAtLine(c, 7, msg) { return fail("W[*W[*W[[1]Opaque]]] is reported") }
	if !errAtLine(c, 8, msg) { return fail("*L[*L[*L[[1]Opaque]]] is reported") }
	if !errAtLine(c, 9, msg) { return fail("W[*W[[2]*W[[1]Opaque]]] is reported") }
	return ""
}

// A named pointer type to an instance of a generic over itself is a legal recursive
// type, and the walk ends where it meets the named type again.
func TestArgsWalkNamedPointerToOwnInstance() testing.TestResult {
	return expectNoErrors(
			checkSrc("package \"main\"\ntype W[T any] struct { v T }\ntype NP *W[NP]\n"))
}

// A named type met again in the walk gives the answer its pointee walk found the first
// time: in the instance X[*Y, N], Y an instance whose argument is N, a named pointer
// to a struct holding an opaque type, the pointee walk of *Y finds that N breaks a
// rule -- and goes on, to answer false -- and the walk of Y's arguments meets N again.
func TestArgsWalkNamedTypeMetAgainBreaks() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\n")
	var n @types.Type = types.MakeNamedType("main.N")
	n.Underlying = opaqueHolderPointer()
	var y @types.Type = fakeInstance(n)
	var noFields @[]@types.Field
	y.Underlying = types.MakeStructType("", noFields)
	var py @types.Type = make(types.Type)
	py.Kind = types.TYP_POINTER
	py.Elem = y
	var x @types.Type = types.MakeNamedType("main.X")
	x.InstArgs = make_slice(@types.Type, 2)
	x.InstArgs[0] = py
	x.InstArgs[1] = n
	if !argsMayBringOpaque(c, x, viewHere, nil) { return fail("X[*Y, N] may bring an opaque type") }
	return ""
}
