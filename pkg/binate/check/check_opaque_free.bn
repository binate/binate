package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/table"
import "pkg/std/vec"

// An opaque-free type is one whose by-value structure -- what embedsOpaqueByValue
// follows: aliases, `readonly`, named types' underlying types, struct fields and
// array and slice elements -- reaches no named type without an underlying type and
// no opaque export.  Such a type embeds no opaque type by value in any view, from
// any package, at any point of the check, so the by-value walk can answer for it
// without walking -- and a signature or declaration that holds a pointer to a large
// struct would otherwise walk the whole struct each time it is checked.
//
// The checker keeps the opaque-free types it has found until a type the walk reads
// changes in a way that could give one of them an opaque part: an underlying type
// cleared or replaced (setUnderlying), a field or element type replaced, or an
// opaque export marked (noteTypeGraphChanged).  Giving a named type its first
// underlying type changes nothing kept: a structure that reached it while it had
// none was not opaque-free.

// opaqueFreeTypes holds the opaque-free types the checker has found (Types) and
// the count of type changes that could make one stop being opaque-free (Changes);
// Types holds the types found since Changes was TypesChanges.
type opaqueFreeTypes struct {
	Types        @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
	TypesChanges int
	Changes      int
}

// typeIdentityHasher / typeIdentityEq key a table by a type's identity.
type typeIdentityHasher struct {}

impl typeIdentityHasher : hash.Hasher[@types.Type]

// Hash hashes a type's address.
func (h typeIdentityHasher) Hash(k @types.Type) uint {
	var p uint = bit_cast(uint, bit_cast(*uint8, k))
	return p ^ (p >> 7)
}

// typeIdentityEq is the identity equality paired with typeIdentityHasher.
type typeIdentityEq struct {}

impl typeIdentityEq : cmp.Eq[@types.Type]

// Equal reports whether a and b are the same type.
func (e typeIdentityEq) Equal(a @types.Type, b @types.Type) bool {
	return same(a, b)
}

// newTypeSet returns an empty set of types, by identity.
func newTypeSet() @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq] {
	return table.NewTable[@types.Type, bool, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
}

// opaqueFreeOf returns c's opaque-free types, creating them on first use and
// emptying them when a type change since they were found could make one stop
// being opaque-free.
func opaqueFreeOf(c @Checker) @opaqueFreeTypes {
	if c.OpaqueFree == nil {
		c.OpaqueFree = make(opaqueFreeTypes)
		c.OpaqueFree.Types = newTypeSet()
	}
	var of @opaqueFreeTypes = c.OpaqueFree
	if of.TypesChanges != of.Changes {
		of.Types = newTypeSet()
		of.TypesChanges = of.Changes
	}
	return of
}

// noteTypeGraphChanged records a change to a type that could make an
// opaque-free type stop being one.
func noteTypeGraphChanged(c @Checker) {
	var of @opaqueFreeTypes = opaqueFreeOf(c)
	of.Changes = of.Changes + 1
}

// setUnderlying makes u the underlying type of the named type t, recording a
// type change when t had one already (noteTypeGraphChanged).
func setUnderlying(c @Checker, t @types.Type, u @types.Type) {
	if t.Underlying != nil { noteTypeGraphChanged(c) }
	t.Underlying = u
}

// isOpaqueFree reports whether t is opaque-free.  It walks t's by-value structure
// unless t is already known to be, and when nothing in it is a named type without
// an underlying type or an opaque export, keeps every type it met, each of which is
// opaque-free too.
func isOpaqueFree(c @Checker, t @types.Type) bool {
	if c == nil || t == nil { return false }
	var of @opaqueFreeTypes = opaqueFreeOf(c)
	if of.Types.Has(t) { return true }
	var met @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq] = newTypeSet()
	var order @vec.Vec[@types.Type] = vec.New[@types.Type]()
	var work @vec.Vec[@types.Type] = vec.New[@types.Type]()
	work.Push(t)
	for work.Len() > 0 {
		var x @types.Type
		x, _ = work.Pop()
		if x == nil || met.Has(x) || of.Types.Has(x) { continue }
		met.Put(x, true)
		order.Push(x)
		if x.Kind == types.TYP_NAMED {
			if x.Underlying == nil || len(x.OpaqueExportPkg) > 0 { return false }
			work.Push(x.Underlying)
		} else if x.Kind == types.TYP_ALIAS {
			work.Push(x.Target)
		} else if x.Kind == types.TYP_READONLY || x.Kind == types.TYP_ARRAY ||
				x.Kind == types.TYP_SLICE || x.Kind == types.TYP_MANAGED_SLICE {
			work.Push(x.Elem)
		} else if x.Kind == types.TYP_STRUCT {
			for i := 0; i < len(x.Fields); i++ {
				work.Push(x.Fields[i].Type)
			}
		}
	}
	for i := 0; i < order.Len(); i++ {
		of.Types.Put(order.Get(i), true)
	}
	return true
}
