package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// namedOver returns a named type called name over u (nil: no underlying type).
func namedOver(name *[]readonly char, u @types.Type) @types.Type {
	var t @types.Type = types.MakeNamedType(buf.CopyStr(name))
	t.Underlying = u
	return t
}

// structOf returns a struct type with one field of each of the given types.
func structOf(fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Name = buf.CopyStr("f")
		fields[i].Type = fieldTypes[i]
	}
	return types.MakeStructType(buf.CopyStr("S"), fields)
}

// oneField returns a struct type with a single field of type t.
func oneField(t @types.Type) @types.Type {
	var ft @[]@types.Type = make_slice(@types.Type, 1)
	ft[0] = t
	return structOf(ft)
}

// isOpaqueFree follows a type's by-value parts -- named types' underlying types,
// struct fields, array and slice elements -- and not what a pointer points to: a
// struct holding an opaque type behind a pointer is opaque-free, and the types the
// walk met are kept; one holding an opaque type, or an opaque export, by value in
// an array is not.
func TestOpaqueFreeFollowsByValueParts() testing.TestResult {
	var c @Checker = NewChecker()
	var n @types.Type = namedOver("N", types.TypInt())
	var op @types.Type = namedOver("Op", nil)
	var ft @[]@types.Type = make_slice(@types.Type, 4)
	ft[0] = n
	ft[1] = types.MakePointerType(op)
	ft[2] = types.MakeArrayType(n, 2)
	ft[3] = types.MakeManagedSliceType(n)
	var s @types.Type = namedOver("S", structOf(ft))
	if !isOpaqueFree(c, s) {
		return "expected a struct holding an opaque type only behind a pointer to be opaque-free"
	}
	if !c.OpaqueFree.Types.Has(n) { return "expected the walk to keep the types it met" }
	if isOpaqueFree(c, namedOver("T", oneField(op))) {
		return "expected a struct holding an opaque type by value not to be opaque-free"
	}
	var e @types.Type = namedOver("E", types.TypInt())
	e.OpaqueExportPkg = buf.CopyStr("p")
	if isOpaqueFree(c, oneField(types.MakeArrayType(e, 1))) {
		return "expected a struct holding an opaque export in an array not to be opaque-free"
	}
	return ""
}

// A kept opaque-free type is forgotten when a type it holds by value loses its
// underlying type or becomes an opaque export, and a named type's first underlying
// type keeps what was found.
func TestOpaqueFreeForgetsOnTypeChange() testing.TestResult {
	var c @Checker = NewChecker()
	var n @types.Type = namedOver("N", types.TypInt())
	var s @types.Type = oneField(n)
	if !isOpaqueFree(c, s) { return "expected a struct of a named int to be opaque-free" }
	setUnderlying(c, n, nil)
	if isOpaqueFree(c, s) {
		return "expected clearing a held type's underlying type to forget the struct"
	}
	var changes int = c.OpaqueFree.Changes
	setUnderlying(c, n, types.TypInt())
	if c.OpaqueFree.Changes != changes {
		return "expected a first underlying type not to count as a change"
	}
	if !isOpaqueFree(c, s) {
		return "expected the struct to be opaque-free again once its field has an underlying type"
	}
	n.OpaqueExportPkg = buf.CopyStr("p")
	noteTypeGraphChanged(c)
	if isOpaqueFree(c, s) {
		return "expected marking a held type an opaque export to forget the struct"
	}
	return ""
}
