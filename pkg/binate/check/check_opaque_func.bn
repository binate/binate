package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"

// funcSignaturesSized reports whether every function type t spells out — the
// signature of a function value (`*func(Op) int`, `@func() Op`), as t itself or
// as a pointee, an array or slice element or a struct field, at any depth —
// holds its parameters and results to the opaque rules a function declaration's
// are (opaqueRulesKept), reporting the first one that breaks them at pos: a
// signature is held to one rule wherever it is written.  (The size limit on the
// parameters and results is the caller's requireFitting, which walks them too.)
// Like nestedPointerEmbedsOpaque, the walk stops at a named type, whose own
// declaration is checked, but enters a generic instance, whose structure (the
// generic's with this use's arguments) no declaration checked, and in which only
// a type with no definition anywhere counts as opaque.  w holds the types
// entered, each walked once per view, and the parameter and result types
// checked, each checked once per view.
func funcSignaturesSized(c @Checker, t @types.Type, pos token.Pos, w *opaqueWalk, exports bool,
		f *opaqueFrame) bool {
	for t != nil {
		t, exports, f = bindFrame(t, exports, f)
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !w.enter(t, exports) { return true }
			var fr opaqueFrame
			var abs @types.Type = instanceStructure(c, t, exports, f, &fr)
			if abs != nil {
				var fresh opaqueWalk
				return funcSignaturesSized(c, abs, pos, &fresh, false, &fr)
			}
			exports = false
			t = t.Underlying
		} else {
			break
		}
	}
	if t == nil { return true }
	var k int = t.Kind
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		if !w.enter(t, exports) { return true }
		for i := 0; i < len(t.Params); i++ {
			if !signaturePartKept(c, t.Params[i].Type, pos, w, exports, f) { return false }
		}
		for i := 0; i < len(t.Results); i++ {
			if !signaturePartKept(c, t.Results[i], pos, w, exports, f) { return false }
		}
		return true
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
		return !w.enter(t, exports) || funcSignaturesSized(c, t.Elem, pos, w, exports, f)
	}
	if k == types.TYP_STRUCT && w.enter(t, exports) {
		for i := 0; i < len(t.Fields); i++ {
			if !funcSignaturesSized(c, t.Fields[i].Type, pos, w, exports, f) { return false }
		}
	}
	return true
}

// signaturePartKept reports whether a function type's parameter or result type p
// keeps the opaque rules (opaqueRulesKept), checking each type once per view; f
// is the instance structure frame p is in, if any.
func signaturePartKept(c @Checker, p @types.Type, pos token.Pos, w *opaqueWalk, exports bool,
		f *opaqueFrame) bool {
	return !w.checkOnce(p, exports) || opaqueRulesKept(c, p, pos, w, exports, f)
}

// requireMethodSignaturesKept reports, at pos, each parameter or result of the
// declared interface iface's own methods that breaks the opaque rules a function
// declaration's would (opaqueRulesKept): a method is a signature too, and one no
// implementation could declare is rejected where it is written.
func requireMethodSignaturesKept(c @Checker, iface @types.Type, pos token.Pos) {
	if iface == nil || iface.Kind != types.TYP_INTERFACE { return }
	var w opaqueWalk
	var none *opaqueFrame
	for i := 0; i < len(iface.Methods); i++ {
		var ft @types.Type = iface.Methods[i].FuncType
		if ft == nil { continue }
		for j := 0; j < len(ft.Params); j++ {
			_ = signaturePartKept(c, ft.Params[j].Type, pos, &w, true, none)
		}
		for j := 0; j < len(ft.Results); j++ {
			_ = signaturePartKept(c, ft.Results[j], pos, &w, true, none)
		}
	}
}
