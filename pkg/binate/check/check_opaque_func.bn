package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"
import "pkg/stdx/slices"

// funcSignaturesSized reports whether every function type t spells out — the
// signature of a function value (`*func(Op) int`, `@func() Op`), as t itself or
// as a pointee, an array or slice element, a struct field or an interface
// value's interface, at any depth —
// holds its parameters and results to the opaque rules a function declaration's
// are (opaqueRulesKept), reporting the first one that breaks them at pos: a
// signature is held to one rule wherever it is written.  (The size limit on the
// parameters and results is the caller's requireFitting, which walks them too.)
// Like nestedPointerEmbedsOpaque, the walk stops at a named type, whose own
// declaration is checked, but enters a generic instance, whose structure (the
// generic's with this use's arguments) no declaration checked as a whole, and
// judges only the parts that come from its arguments (instanceStructure), and
// its type arguments, types written where it is.  An interface instance written
// where the walk runs is judged where it is instantiated
// (requireIfaceInstanceArgsKept); one inside an instance's structure is entered
// with it (ifaceInstanceKept).  w holds the types entered, each walked once per
// view, and the parameter and result types checked, each checked once per view.
func funcSignaturesSized(c @Checker, t @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	for t != nil {
		t, view, f = bindFrame(t, view, f)
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !w.enter(t, view) { return true }
			var av int = instArgsView(c, view, f)
			var abs0 @types.Type = abstractInstanceOf(c, t)
			for i := 0; i < len(t.InstArgs); i++ {
				if argUnmentioned(abs0, t.InstDecl, i) &&
						!funcSignaturesSized(c, t.InstArgs[i], pos, w, av, f) {
					return false
				}
			}
			var fr opaqueFrame
			var abs @types.Type = instanceStructure(c, t, view, f, &fr)
			if abs != nil {
				var fresh opaqueWalk
				return funcSignaturesSized(c, abs, pos, &fresh, viewNone, &fr)
			}
			view = substitutedView(view)
			t = t.Underlying
		} else {
			break
		}
	}
	if t == nil { return true }
	var k int = t.Kind
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		if !w.enter(t, view) { return true }
		for i := 0; i < len(t.Params); i++ {
			if !signaturePartKept(c, t.Params[i].Type, pos, w, view, f) { return false }
		}
		for i := 0; i < len(t.Results); i++ {
			if !signaturePartKept(c, t.Results[i], pos, w, view, f) { return false }
		}
		return true
	}
	if k == types.TYP_INTERFACE && len(t.InstArgs) > 0 && f != nil {
		return ifaceInstanceKept(c, t, pos, w, view, f)
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		return !w.enter(t, view) || funcSignaturesSized(c, t.Elem, pos, w, view, f)
	}
	if k == types.TYP_STRUCT && w.enter(t, view) {
		for i := 0; i < len(t.Fields); i++ {
			if !funcSignaturesSized(c, t.Fields[i].Type, pos, w, view, f) { return false }
		}
	}
	return true
}

// ifaceInstanceKept reports whether the interface instance iface, in the frame f
// if any, keeps the opaque rules in view: the type arguments its methods never
// use the rules on forming a type (argUnmentioned, formationRulesKept), then its
// methods' signatures (ifaceSignaturesKept), reporting the first part that
// breaks them at pos.
func ifaceInstanceKept(c @Checker, iface @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	var abs @types.Type = abstractInstanceOf(c, iface)
	for i := 0; i < len(iface.InstArgs); i++ {
		if argUnmentioned(abs, iface.InstDecl, i) &&
				!formationRulesKept(c, iface.InstArgs[i], pos, w, view, f) {
			return false
		}
	}
	return ifaceSignaturesKept(c, iface, pos, w, view, f)
}

// ifaceSignaturesKept reports whether every method of the interface iface, its
// parents' included, keeps the opaque rules in view (signaturePartKept),
// reporting the first part that breaks them at pos; f is the instance structure
// frame iface is in, if any.
func ifaceSignaturesKept(c @Checker, iface @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	if !w.enter(iface, view) { return true }
	for i := 0; i < len(iface.Methods); i++ {
		var ft @types.Type = iface.Methods[i].FuncType
		if ft == nil { continue }
		for j := 0; j < len(ft.Params); j++ {
			if !signaturePartKept(c, ft.Params[j].Type, pos, w, view, f) { return false }
		}
		for j := 0; j < len(ft.Results); j++ {
			if !signaturePartKept(c, ft.Results[j], pos, w, view, f) { return false }
		}
	}
	for i := 0; i < len(iface.Parents); i++ {
		if !ifaceSignaturesKept(c, iface.Parents[i], pos, w, view, f) { return false }
	}
	return true
}

// signaturePartKept reports whether a function type's parameter or result type p
// keeps the opaque rules (opaqueRulesKept), checking each type once per view; f
// is the instance structure frame p is in, if any.
func signaturePartKept(c @Checker, p @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return !w.checkOnce(p, view) || opaqueRulesKept(c, p, pos, w, view, f)
}

// requireMethodSignaturesKept reports, at pos, each parameter or result of the
// declared interface iface's own methods that breaks the opaque rules a function
// declaration's would (opaqueRulesKept): a method is a signature too, and one no
// implementation could declare is rejected where it is written.
func requireMethodSignaturesKept(c @Checker, iface @types.Type, pos token.Pos) {
	if iface == nil || iface.Kind != types.TYP_INTERFACE { return }
	var w opaqueWalk
	var none *opaqueFrame
	for i := 0; i < len(iface.Methods); i++ {
		var ft @types.Type = iface.Methods[i].FuncType
		if ft == nil { continue }
		for j := 0; j < len(ft.Params); j++ {
			_ = signaturePartKept(c, ft.Params[j].Type, pos, &w, viewHere, none)
		}
		for j := 0; j < len(ft.Results); j++ {
			_ = signaturePartKept(c, ft.Results[j], pos, &w, viewHere, none)
		}
	}
}

// requireMethodInstanceSized reports, at pos, each parameter or result of the
// instance w's method's function type ft (its receiver first) that breaks the
// opaque rules or the size limit, as a function declaration's would.  An instance
// of a generic type compiles every method with its type arguments, so each
// method's instantiated signature is held to them where the instance is checked
// (checkInstanceBody); a generic function's is held at each call instead
// (instantiateGenericFunc).  The receiver is a parameter too — a value receiver
// of `Id[Opaque]` (`type Id[T any] T`) is an opaque value, and a pointer receiver
// of `Cell[Opaque]` (`v T`) points to a type embedding one, even when the
// instance is only ever written as a type argument — but each receiver type is
// sized once per instance (w.SizedRecvs), so a broken instance is reported once,
// not at every method.
func requireMethodInstanceSized(c @Checker, w @InstWork, ft @types.Type, pos token.Pos) {
	for i := 0; i < len(ft.Params); i++ {
		var pt @types.Type = ft.Params[i].Type
		if i == 0 {
			if recvSized(w, pt) {
				continue
			}
			w.SizedRecvs = slices.Append[@types.Type](w.SizedRecvs, pt)
		}
		requireSizedType(c, pt, pos)
	}
	for i := 0; i < len(ft.Results); i++ {
		requireSizedType(c, ft.Results[i], pos)
	}
	requireFittingResults(c, ft.Results, pos)
}

// recvSized reports whether the receiver type t was already sized for the
// instance w.
func recvSized(w @InstWork, t @types.Type) bool {
	for i := 0; i < len(w.SizedRecvs); i++ {
		if w.SizedRecvs[i].Identical(t) { return true }
	}
	return false
}

// isPointerOrHandle reports whether t, its alias and readonly wrappers peeled, is
// a raw pointer or a managed pointer.
func isPointerOrHandle(t @types.Type) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else {
			t = t.Elem
		}
	}
	return t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR)
}

// requireIndependentSignatureSized reports, at pos, each parameter or result of a
// generic function's or method's abstract signature ft that mentions no type
// parameter and breaks the opaque rules or the size limit, as a function
// declaration's would — and the results' combined size when none mentions one.
// Those parts are decided once, at the declaration, whether or not the program
// instantiates the generic (spec gen.mono.check); a part that mentions a type
// parameter is checked for each instance (requireMethodInstanceSized, and a
// generic function's call).
func requireIndependentSignatureSized(c @Checker, ft @types.Type, pos token.Pos) {
	for i := 0; i < len(ft.Params); i++ {
		if !mentionsTypeParam(ft.Params[i].Type, 0) {
			requireSizedType(c, ft.Params[i].Type, pos)
		}
	}
	var dependent bool = false
	for i := 0; i < len(ft.Results); i++ {
		if mentionsTypeParam(ft.Results[i], 0) {
			dependent = true
		} else {
			requireSizedType(c, ft.Results[i], pos)
		}
	}
	if !dependent {
		requireFittingResults(c, ft.Results, pos)
	}
}
