package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_func.bn.  checkSrc, expectNoErrors, errsIn and
// charsHaveSub are shared from the package's other tests.

// A function value's signature is held to the rules a function declaration's is:
// a by-value opaque parameter or result, or one that points to a type embedding an
// opaque type by value, is rejected where the function type is written — as a
// declaration, a field, a parameter, a local, nested in another signature, or in
// an instance of a generic whose type argument is opaque.
func TestCheckOpaqueFuncValueSignatureRejected() testing.TestResult {
	var decls *[]readonly char = "type F *func(Opaque) int\n"
			"type G @func() Opaque\n"
			"type S struct { f *func(Opaque) }\n"
			"func p(g @func(int) [2]Opaque) { }\n"
			"func l() { var v *func() Opaque }\n"
			"type N *func(*func(Opaque))\n"
			"type FBox[T any] struct { f *func(T) }\ntype V FBox[Opaque]\n"
	var errs @[]types.CheckError = checkSrc(
			buf.Concat("package \"test\"\ntype Opaque\n", decls)).CheckerErrors()
	if len(errs) != 7 {
		return fail(buf.Concat("expected 7 errors, one per declaration; got ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, "cannot use an opaque type by value") {
			return fail(errs[i].Msg)
		}
	}
	return errsIn(
			checkSrc("package \"test\"\ntype Opaque\ntype P *func(*([2]Opaque))\n"),
			"cannot form a pointer to a type that embeds an opaque")
}

// A signature that holds an opaque type only behind a pointer or handle is fine,
// and so is a generic's function-value field instantiated with a sized type.
func TestCheckOpaqueFuncValueSignatureOk() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opaque\n"
							"type F *func(*Opaque) int\ntype G @func() @Opaque\n"
							"type H *func(*[2]*Opaque, @[]@Opaque) *Opaque\n"
							"type FBox[T any] struct { f *func(T) }\ntype V FBox[int]\ntype W FBox[*Opaque]\n"
							"func f(g @func(*Opaque) @Opaque) { _ = g }\n"))
}

// An instance's body judges a function value's signature in the view its own
// structure is (only a type with no definition anywhere counts): a package may
// instantiate a generic — here its own .bni's — with its own opaque export, which
// the body, checked in the .bni's view, would otherwise count as opaque.
func TestCheckOpaqueFuncValueInstanceOwnExportOk() testing.TestResult {
	var bni *[]readonly char = "package \"q\"\ntype Op\n"
			"func Pass[T any](fn *func(T) int) *func(T) int {\n\tvar f *func(T) int = fn\n\treturn f\n}\n"
			"func Use() int\n"
	var bn *[]readonly char = "package \"q\"\ntype Op struct { v int }\n"
			"func cb(o Op) int { return o.v * 10 }\n"
			"func Use() int {\n\tvar h *func(Op) int = Pass[Op](cb)\n"
			"\tvar o Op\n\to.v = 4\n\treturn h(o)\n}\n"
	return expectNoErrors(checkBniMethodPkgIn(NewChecker(), bni, bn, false))
}

// An interface method's parameters and results are held to the rules a function
// declaration's are: each that breaks them is reported at the interface.
func TestCheckOpaqueInterfaceMethodRejected() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"interface IA { M(o Opaque) }\n"
					"interface IB { N(f *func(Opaque)) }\n"
					"interface IC { K() [2]Opaque; L(p *([2]Opaque)) }\n").CheckerErrors()
	if len(errs) != 4 {
		return fail(buf.Concat("expected 4 errors, one per bad part; got ", strconv.Itoa(len(errs))))
	}
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opaque\ninterface ID { P(o *Opaque, f *func(*Opaque)) @Opaque }\n"))
}

// A type written as a builtin's operand is held to the pointer and signature rules
// too, not only to the builtin's by-value one.
func TestCheckOpaqueBuiltinOperandRejected() testing.TestResult {
	var body *[]readonly char = "func f() {\n"
			"\t_ = sizeof(*func(Opaque))\n"
			"\t_ = alignof(@func() [2]Opaque)\n"
			"\t_ = make_slice(*([2]Opaque), 2)\n"
			"\t_ = make(*func(Opaque))\n"
			"\tvar p *uint8\n\t_ = bit_cast(*func(Opaque), p)\n"
			"\t_ = __c_call(\"abs\", *func(Opaque), 1)\n}\n"
	var errs @[]types.CheckError = checkSrc(buf.Concat("package \"test\"\ntype Opaque\n",
			body)).CheckerErrors()
	if len(errs) != 6 {
		return fail(buf.Concat("expected 6 errors, one per operand; got ", strconv.Itoa(len(errs))))
	}
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype Opaque\nfunc f() {\n\t_ = sizeof(*func(*Opaque))\n"
							"\t_ = make_slice(*Opaque, 2)\n}\n"))
}
