package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// A generic instance's structure is its generic's definition with this use's
// arguments, and the two parts are written in different places: the
// definition where the generic is, the arguments where the instance is.  So the
// opaque rules judge a part of an instance in the view of where it is written:
// the generic's own parts at its declaration (checkGenericDeclAbstract), and the
// parts that come from the arguments where the instance is written
// (type.opaque.pointer-to-embedding, type.opaque.signature).  The substituted
// instance cannot tell the two apart, so the walk follows the generic's
// abstract instance — its structure with its own type parameters as the
// arguments — in viewNone, with an opaqueFrame binding those parameters to
// this use's arguments, which are judged where the instance is written.  The
// arguments themselves are types written there: one the
// structure never uses is judged as a part by itself (argUnmentioned).

// An opaqueFrame binds the type parameters of the generic owner to the
// arguments of the instance whose structure is being walked, which are judged
// in argView: the view where the instance is written.
type opaqueFrame struct {
	owner   *uint8
	args    @[]@types.Type
	argView int
}

// bindFrame returns, when t is a type parameter f binds, its argument with f's
// argument view and no frame (the argument is written where the instance is);
// otherwise t, view and f themselves.
func bindFrame(t @types.Type, view int, f *opaqueFrame) (@types.Type, int, *opaqueFrame) {
	var bound @types.Type = bindFrameType(t, f)
	if bound == nil { return t, view, f }
	var none *opaqueFrame
	return bound, f.argView, none
}

// bindFrameType returns the argument f binds the type parameter t to, or nil.
func bindFrameType(t @types.Type, f *opaqueFrame) @types.Type {
	if f == nil || t == nil || t.Kind != types.TYP_TYPE_PARAM || t.TpOwner != f.owner ||
			t.TpIndex < 0 || t.TpIndex >= len(f.args) {
		return nil
	}
	return f.args[t.TpIndex]
}

// instanceStructure returns the abstract structure of the instance t, filling fr
// to bind its generic's type parameters to t's arguments, when t is entered
// where it is written: outside any frame (inside one the parts are the
// generic's, including the arguments of the instances its definition writes),
// in a view that counts some opaque type.  The arguments are judged in that
// view.  With no complete abstract instance, nil: t is walked substituted, in
// substitutedView.
func instanceStructure(c @Checker, t @types.Type, view int, f *opaqueFrame,
		fr *opaqueFrame) @types.Type {
	if view == viewNone || f != nil { return nil }
	var abs @types.Type = abstractInstanceOf(c, t)
	if abs == nil || abs.Underlying == nil { return nil }
	fr.owner = t.InstDecl
	fr.args = t.InstArgs
	fr.argView = view
	return abs.Underlying
}

// argsMayBringOpaque reports whether the instance t, entered in view inside the
// frame f (if any), can bring an opaque type into its structure through its type
// arguments, the only parts of it not judged at its generic's declaration — for
// the walks of the pointer rules (partsPointToOpaqueEmbedding) and the signature
// rules (funcSignaturesSized).  An argument can bring one only when it mentions
// one — inside a frame, through a parameter the frame binds to an argument
// written elsewhere; outside, through a named type — and only when, its
// parameters bound, it may break an opaque rule where the structure puts it
// (argMayHoldOpaque): wherever the structure puts any other argument — by
// value, behind pointers, in a pointee, as a parameter or result of a function
// type — no rule fires.  Skipping t then also spares the walk the abstract
// instances its structure names, which a chain of generics each naming the
// next twice makes exponentially many (check_generic_postpone.bn).  One walk
// judges all the arguments, so a part they share is judged once.
func argsMayBringOpaque(c @Checker, t @types.Type, view int, f *opaqueFrame) bool {
	var w opaqueWalk
	return argsMayBringOpaqueIn(c, t, &w, view, f)
}

// argsMayBringOpaqueIn is argsMayBringOpaque in the walk w (argMayHoldOpaque),
// which a pointee check inside one (pointeeEmbedsOpaqueIn) shares: a fresh walk
// there would judge again, at each level of nested type arguments, the
// arguments the enclosing walk judges.
func argsMayBringOpaqueIn(c @Checker, t @types.Type, w *opaqueWalk, view int, f *opaqueFrame) bool {
	for i := 0; i < len(t.InstArgs); i++ {
		var a @types.Type = t.InstArgs[i]
		var mentions bool
		if f != nil { mentions = typeMentionsOwner(a, f) } else { mentions = typeMentionsNamed(a) }
		if mentions && argMayHoldOpaque(c, a, w, view, f) { return true }
	}
	return false
}

// typeMentionsOwner reports whether t mentions a type parameter the frame f
// binds.
func typeMentionsOwner(t @types.Type, f *opaqueFrame) bool {
	for i := 0; i < len(f.args); i++ {
		var v typeVisits
		if typeMentionsParam(t, f.owner, i, &v) { return true }
	}
	return false
}

// argMayHoldOpaque reports whether the type argument a, in view inside the
// frame f (if any), which binds its parameters, may break an opaque rule where a
// structure puts it: it is opaque or holds an opaque type by value, or one of
// its parts may break one (partsMayBreak).  w holds the parts judged, shared by
// every argument the check reaches: a part entered before was judged and broke
// no rule, or is on the current path.  Each call is on a part of a, or on an
// argument the frame binds, which is outside it, so the recursion ends.
func argMayHoldOpaque(c @Checker, a @types.Type, w *opaqueWalk, view int, f *opaqueFrame) bool {
	var b @types.Type
	var bv int
	var bf *opaqueFrame
	b, bv, bf = bindFrame(a, view, f)
	return embedsOpaqueByValueFramed(c, b, bv, bf) || partsMayBreak(c, b, w, bv, bf)
}

// partsMayBreak reports whether t, in view inside the frame f (if any), is or
// spells out — as a pointee, an element, a field or an interface value's
// interface — a pointer or handle to a type that embeds an opaque type by value
// (pointeeEmbedsOpaque), a function type with a parameter or result that may
// break the opaque rules (argMayHoldOpaque), which a structure that puts it in
// a signature breaks (funcSignaturesSized), or an instance with such a type
// argument, which its structure may put behind a pointer or in a signature.
// An instance's own parts — a named pointer instance's pointee among them —
// were judged at its generic's declaration, so its arguments are all of it that
// counts.  One walk judges both the pointer rules and the signature rules: two
// would each judge an instance's arguments again, doubling the work at each
// level of nested type arguments.  Each part is entered before it is judged, so
// one reached again — a nested type argument repeated — is judged once.
func partsMayBreak(c @Checker, t @types.Type, w *opaqueWalk, view int, f *opaqueFrame) bool {
	for t != nil {
		t, view, f = bindFrame(t, view, f)
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else {
			break
		}
	}
	if t == nil { return false }
	var k int = t.Kind
	if (k == types.TYP_NAMED || k == types.TYP_INTERFACE) && len(t.InstArgs) > 0 {
		if !w.enter(t, view) { return false }
		for i := 0; i < len(t.InstArgs); i++ {
			if argMayHoldOpaque(c, t.InstArgs[i], w, view, f) { return true }
		}
		return false
	}
	if k == types.TYP_NAMED { return pointeeEmbedsOpaqueIn(c, t, w, view, f) }
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		if !w.enter(t, view) { return false }
		for i := 0; i < len(t.Params); i++ {
			if argMayHoldOpaque(c, t.Params[i].Type, w, view, f) { return true }
		}
		for i := 0; i < len(t.Results); i++ {
			if argMayHoldOpaque(c, t.Results[i], w, view, f) { return true }
		}
		return false
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR {
		return w.enter(t, view) &&
				(pointeeEmbedsOpaqueIn(c, t, w, view, f) || partsMayBreak(c, t.Elem, w, view, f))
	}
	if k == types.TYP_ARRAY || k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE ||
			k == types.TYP_INTERFACE_VALUE || k == types.TYP_INTERFACE_VALUE_MANAGED {
		return w.enter(t, view) && partsMayBreak(c, t.Elem, w, view, f)
	}
	if k == types.TYP_STRUCT && w.enter(t, view) {
		for i := 0; i < len(t.Fields); i++ {
			if partsMayBreak(c, t.Fields[i].Type, w, view, f) { return true }
		}
	}
	return false
}

// typeMentionsNamed reports whether t mentions a named type or an interface:
// an opaque type is named, so one that mentions neither holds none.
func typeMentionsNamed(t @types.Type) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS { t = t.Target } else { t = t.Elem }
	}
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_NAMED || k == types.TYP_INTERFACE { return true }
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		return typeMentionsNamed(t.Elem)
	}
	if k == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if typeMentionsNamed(t.Fields[i].Type) { return true }
		}
		return false
	}
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(t.Params); i++ {
			if typeMentionsNamed(t.Params[i].Type) { return true }
		}
		for i := 0; i < len(t.Results); i++ {
			if typeMentionsNamed(t.Results[i]) { return true }
		}
	}
	return false
}

// argUnmentioned reports whether the type argument i of an instance of the
// generic owner, whose abstract instance (or alias target) is abs, is one abs
// never mentions.  Only such an argument is judged as a part by itself: the
// walk of the structure judges the others wherever their parameter occurs, and
// walking them twice would double the cost at each level of nested type
// arguments.
func argUnmentioned(abs @types.Type, owner *uint8, i int) bool {
	if abs == nil { return true }
	var v typeVisits
	if abs.Kind == types.TYP_INTERFACE { return !ifaceMentionsParam(abs, owner, i, &v) }
	if abs.Kind == types.TYP_NAMED && len(abs.InstArgs) > 0 && abs.Underlying != nil {
		return !typeMentionsParam(abs.Underlying, owner, i, &v)
	}
	return !typeMentionsParam(abs, owner, i, &v)
}

// ifaceMentionsParam reports whether the type parameter i of the generic owner
// occurs in the interface iface's methods or parents.
func ifaceMentionsParam(iface @types.Type, owner *uint8, i int, v *typeVisits) bool {
	if !v.enter(iface) { return false }
	for j := 0; j < len(iface.Methods); j++ {
		if typeMentionsParam(iface.Methods[j].FuncType, owner, i, v) { return true }
	}
	for j := 0; j < len(iface.Parents); j++ {
		if typeMentionsParam(iface.Parents[j], owner, i, v) { return true }
	}
	return false
}

// typeMentionsParam reports whether the type parameter i of the generic owner
// occurs in t: as t, in a part t spells out, or in an instance's type arguments.
func typeMentionsParam(t @types.Type, owner *uint8, i int, v *typeVisits) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS { t = t.Target } else { t = t.Elem }
	}
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_TYPE_PARAM { return t.TpOwner == owner && t.TpIndex == i }
	if (k == types.TYP_NAMED || k == types.TYP_INTERFACE) && len(t.InstArgs) > 0 {
		if !v.enter(t) { return false }
		for j := 0; j < len(t.InstArgs); j++ {
			if typeMentionsParam(t.InstArgs[j], owner, i, v) { return true }
		}
		return false
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		return typeMentionsParam(t.Elem, owner, i, v)
	}
	if k == types.TYP_STRUCT {
		if !v.enter(t) { return false }
		for j := 0; j < len(t.Fields); j++ {
			if typeMentionsParam(t.Fields[j].Type, owner, i, v) { return true }
		}
		return false
	}
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		for j := 0; j < len(t.Params); j++ {
			if typeMentionsParam(t.Params[j].Type, owner, i, v) { return true }
		}
		for j := 0; j < len(t.Results); j++ {
			if typeMentionsParam(t.Results[j], owner, i, v) { return true }
		}
	}
	return false
}

// substitutedView returns the view an instance entered in view is walked in
// substituted, when instanceStructure gives no abstract structure: inside a
// frame, the frame's (its parts are the outer generic's own, or its arguments,
// which the frame binds); otherwise viewPure.
func substitutedView(view int) int {
	if view == viewHere { return viewPure }
	return view
}

// abstractInstanceOf returns the abstract instance of t's generic — its
// structure as declared, with its own type parameters as the arguments — built
// now if its declaration's abstract check (checkGenericDeclAbstract) has not
// run yet, so a use judged before its generic's declaration gets the same
// verdict as one after it.  Each generic's is looked up once
// (InstanceState.Abstracts).  Nil — not known — while it is being built: building
// it resolves its type parameters' constraints, which may name it
// (`type Box[T any, U C[Box[int, int]]]`), and a use there judged by its abstract structure
// would build it again, without end.
func abstractInstanceOf(c @Checker, t @types.Type) @types.Type {
	if t == nil || t.InstDecl == nil { return nil }
	var known @types.Type = knownAbstract(c, t.InstDecl)
	if known != nil { return known }
	var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
	var found bool = false
	var inst @types.Type
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var e @GenericInstantiation = c.GenericInstantiations[i]
		if e == nil || !same(e.Decl, d) || !argsAreOwnParams(e.Decl, e.TypeArgs) { continue }
		found = true
		inst = e.Result
		break
	}
	if !found {
		if abstractBuilding(c, t.InstDecl) { return nil }
		inst = buildAbstractInstance(c, d, t.Kind == types.TYP_INTERFACE)
	}
	return rememberAbstract(c, t.InstDecl, inst)
}

// abstractAliasTarget returns the generic alias d's target as declared, with its
// own type parameters as the arguments, resolved now if d's abstract check
// (checkGenericDeclAbstract) has not run yet; each is looked up once
// (InstanceState.Abstracts).  Nil while it is being resolved, as for
// abstractInstanceOf.
func abstractAliasTarget(c @Checker, d @ast.Decl) @types.Type {
	var owner *uint8 = bit_cast(*uint8, d)
	var known @types.Type = knownAbstract(c, owner)
	if known != nil { return known }
	var found bool = false
	var inst @types.Type
	for i := 0; i < len(c.AliasInstantiations); i++ {
		var e @GenericInstantiation = c.AliasInstantiations[i]
		if e == nil || !same(e.Decl, d) || !argsAreOwnParams(d, e.TypeArgs) || e.Result == nil {
			continue
		}
		found = true
		inst = e.Result
		break
	}
	if !found {
		if abstractBuilding(c, owner) { return nil }
		inst = buildAbstractInstance(c, d, false)
	}
	return rememberAbstract(c, owner, inst)
}

// abstractBuilding reports whether the abstract instance (or alias target) of
// the generic declaration owner is being built (buildAbstractInstance).
func abstractBuilding(c @Checker, owner *uint8) bool {
	var st @InstanceState = instanceState(c)
	for i := 0; i < len(st.Abstracting); i++ {
		if st.Abstracting[i] == owner { return true }
	}
	return false
}

// knownAbstract returns the abstract instance (or alias target) recorded for the
// generic declaration owner, or nil.
func knownAbstract(c @Checker, owner *uint8) @types.Type {
	var st @InstanceState = instanceState(c)
	for i := 0; i < len(st.Abstracts); i++ {
		if st.Abstracts[i].Owner == owner { return st.Abstracts[i].Inst }
	}
	var none @types.Type
	return none
}

// rememberAbstract records inst, if any, as the abstract instance (or alias
// target) of the generic declaration owner, and returns it.
func rememberAbstract(c @Checker, owner *uint8, inst @types.Type) @types.Type {
	if inst == nil { return inst }
	var st @InstanceState = instanceState(c)
	var a abstractInstance
	a.Owner = owner
	a.Inst = inst
	st.Abstracts = slices.Append[abstractInstance](st.Abstracts, a)
	return inst
}

// buildAbstractInstance instantiates the generic declaration d with its own
// type parameters, resolved in its home scope and package as its abstract
// check resolves them, and returns the instance; while it does, d's abstract
// instance counts as being built (abstractBuilding).
func buildAbstractInstance(c @Checker, d @ast.Decl, isIface bool) @types.Type {
	var st @InstanceState = instanceState(c)
	st.Abstracting = slices.Append[*uint8](st.Abstracting, bit_cast(*uint8, d))
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	var home @Scope = lookupGenericDeclScope(c, d)
	if home != nil { c.Scope = NewScope(home) } else { pushScope(c) }
	if isIface {
		c.curPkgPath = genericIfaceDeclPkg(c, d)
	} else {
		c.curPkgPath = genericTypeDeclPkg(c, d)
	}
	var params @[]@types.Type = defineTypeParams(c, d)
	var inst @types.Type = instantiateGenericDeclWithArgs(c, d, isIface, params, d.Pos, false)
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	st.Abstracting = st.Abstracting[:len(st.Abstracting) - 1]
	return inst
}

// An abstractInstance is the abstract instance Inst of the generic declaration
// Owner (abstractInstanceOf).
type abstractInstance struct {
	Owner *uint8
	Inst  @types.Type
}
