package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// A generic instance's structure is its generic's definition with this use's
// arguments, and the two parts are written in different places: the
// definition where the generic is, the arguments where the instance is.  So the
// rules on forming a type judge a part of an instance in the view of where it
// is written: the generic's own parts as the generic's package does (only a type
// with no definition anywhere counts as opaque), and the parts that come from
// the arguments as the importer does (type.opaque.pointer-to-embedding).  The
// substituted instance cannot tell the two apart, so the walk follows the
// generic's abstract instance — its structure with its own type parameters as
// the arguments — with an opaqueFrame binding those parameters to this use's
// arguments.

// An opaqueFrame binds the type parameters of the generic owner to the
// arguments of the instance whose structure is being walked.
type opaqueFrame struct {
	owner *uint8
	args  @[]@types.Type
}

// bindFrame returns, when t is a type parameter f binds, its argument with the
// importer's view and no frame (the argument is written where the instance is);
// otherwise t, exports and f themselves.
func bindFrame(t @types.Type, exports bool, f *opaqueFrame) (@types.Type, bool, *opaqueFrame) {
	var bound @types.Type = bindFrameType(t, f)
	if bound == nil { return t, exports, f }
	var none *opaqueFrame
	return bound, true, none
}

// bindFrameType returns the argument f binds the type parameter t to, or nil.
func bindFrameType(t @types.Type, f *opaqueFrame) @types.Type {
	if f == nil || t == nil || t.Kind != types.TYP_TYPE_PARAM || t.TpOwner != f.owner ||
			t.TpIndex < 0 || t.TpIndex >= len(f.args) {
		return nil
	}
	return f.args[t.TpIndex]
}

// instanceStructure returns the abstract structure of the instance t, filling fr
// to bind its generic's type parameters to t's arguments, when t is entered in
// the importer's view: exports set, outside any frame (inside one the parts are
// the generic's, including the arguments of the instances its definition
// writes), and outside an instance's body, which is checked where its generic is
// written and judges an instance there in the generic's view, as it does its
// signatures (opaqueRulesKept).  Otherwise, or with no complete abstract
// instance, nil: t is walked as before, substituted and in the generic's view.
func instanceStructure(c @Checker, t @types.Type, exports bool, f *opaqueFrame,
		fr *opaqueFrame) @types.Type {
	if !exports || f != nil || instanceState(c).BodyDepth > 0 { return nil }
	var abs @types.Type = abstractInstanceOf(c, t)
	if abs == nil || abs.Underlying == nil { return nil }
	fr.owner = t.InstDecl
	fr.args = t.InstArgs
	return abs.Underlying
}

// abstractInstanceOf returns the abstract instance of t's generic — its
// structure as declared, with its own type parameters as the arguments — built
// now if its declaration's abstract check (checkGenericDeclAbstract) has not
// run yet, so a use judged before its generic's declaration gets the same
// verdict as one after it.  Each generic's is looked up once
// (InstanceState.Abstracts).
func abstractInstanceOf(c @Checker, t @types.Type) @types.Type {
	if t == nil || t.InstDecl == nil { return nil }
	var st @InstanceState = instanceState(c)
	for i := 0; i < len(st.Abstracts); i++ {
		if st.Abstracts[i].Owner == t.InstDecl { return st.Abstracts[i].Inst }
	}
	var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
	var found bool = false
	var inst @types.Type
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var e @GenericInstantiation = c.GenericInstantiations[i]
		if e == nil || !same(e.Decl, d) || !argsAreOwnParams(e.Decl, e.TypeArgs) { continue }
		found = true
		inst = e.Result
		break
	}
	if !found { inst = buildAbstractInstance(c, d, t.Kind == types.TYP_INTERFACE) }
	if inst == nil { return nil }
	var a abstractInstance
	a.Owner = t.InstDecl
	a.Inst = inst
	st.Abstracts = slices.Append[abstractInstance](st.Abstracts, a)
	return inst
}

// buildAbstractInstance instantiates the generic declaration d with its own
// type parameters, resolved in its home scope and package as its abstract
// check resolves them, and returns the instance.
func buildAbstractInstance(c @Checker, d @ast.Decl, isIface bool) @types.Type {
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	var home @Scope = lookupGenericDeclScope(c, d)
	if home != nil { c.Scope = NewScope(home) } else { pushScope(c) }
	if isIface {
		c.curPkgPath = genericIfaceDeclPkg(c, d)
	} else {
		c.curPkgPath = genericTypeDeclPkg(c, d)
	}
	var params @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		var tp @ast.TypeParam = d.TypeParams[i]
		var tparam @types.Type = MakeTypeParamType(tp.Name, bit_cast(*uint8, d), i,
				resolveTypeParamConstraint(c, tp))
		if !isBlank(tp.Name) { defineType(c.Scope, tp.Name, tparam) }
		params = slices.Append[@types.Type](params, tparam)
	}
	var inst @types.Type = instantiateGenericDeclWithArgs(c, d, isIface, params, d.Pos, false)
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
	return inst
}

// An abstractInstance is the abstract instance Inst of the generic declaration
// Owner (abstractInstanceOf).
type abstractInstance struct {
	Owner *uint8
	Inst  @types.Type
}
