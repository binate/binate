package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_inst.bn: an instance's parts that come from its type
// arguments are judged where the instance is written; its generic's own parts
// at the generic's declaration (check_generic_own.bn).

// instLibBni and instLibBn are pkg/lib: an opaque export Box; a generic Cell
// holding a *Box; a generic Pass whose body holds a Box2[T], whose field points
// to [1]T; a generic interface Get whose method returns T, and an alias GA of
// @Get[T]; a generic function Id over a pointer to [2]T; and Mine, which lib's
// .bn, where Box is not opaque, writes with Get[Box] and Id[Box].
var instLibBni *[]readonly char = "package \"pkg/lib\"\ntype Box\n"
		"type Cell[T any] struct { pp *Box; v T }\nfunc New() @Box\n"
		"type Box2[T any] struct { ps *([1]T) }\n"
		"func Pass[T any](p *T) int {\n\tvar b Box2[T]\n\t_ = b\n\treturn 1\n}\n"
		"interface Get[T any] { get() T }\nfunc Id[T any](p *([2]T)) int { return 0 }\n"
		"type GA[T any] = @Get[T]\nfunc Mine() int\n"

var instLibBn *[]readonly char = "package \"pkg/lib\"\ntype Box struct { n int }\n"
		"func New() @Box { return make(Box) }\n"
		"func Mine() int {\n\tvar g @Get[Box]\n\t_ = g\n\treturn Id[Box](nil)\n}\n"

// checkInstUser checks package q, whose .bn (after importing pkg/lib) declares
// decls, against instLibBni / instLibBn.
func checkInstUser(decls *[]readonly char) @Checker {
	return checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn), "package \"q\"\nfunc F() int\n",
			buf.Concat(buf.Concat("package \"q\"\nimport \"pkg/lib\"\n", decls),
					"func F() int { return 0 }\n"), false)
}

// A type argument written in the importer is judged as the importer sees it: a
// pointer to [2]lib.Box, or a function value over lib.Box, is ill-formed in q
// whether written directly or through a generic's type parameter — also when the
// argument reaches the pointer through a nested instance.
func TestCheckOpaqueInstanceArgImporterViewRejected() testing.TestResult {
	var decls *[]readonly char = "type PBox[T any] struct { p *T }\n"
			"type MH[T any] struct { f *func(T) }\n"
			"type G[T any] struct { h *PBox[[2]T] }\n"
			"type V PBox[[2]lib.Box]\n"
			"type U MH[lib.Box]\n"
			"type Y G[lib.Box]\n"
	var errs @[]types.CheckError = checkInstUser(decls).CheckerErrors()
	if len(errs) != 3 {
		return fail(buf.Concat("expected 3 errors, one per instance; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// lib's Cell[int] is fine in q; so is a pointer to lib.Box itself through a
// type parameter, and a recursive instance; and lib's own Get[Box] and Id[Box]
// are fine in lib, whose .bn sees Box's definition.
func TestCheckOpaqueInstanceGenericPartsOk() testing.TestResult {
	return expectNoErrors(
			checkInstUser(
					"type PBox[T any] struct { p *T }\n"
							"type L[T any] struct { next *L[T]; v *T }\n"
							"type W lib.Cell[int]\ntype X PBox[lib.Box]\ntype Z L[[2]*lib.Box]\n"))
}

// The verdict does not depend on whether the use or the generic is declared
// first: the generic's abstract instance is built when the use needs it.
func TestCheckOpaqueInstanceArgOrder() testing.TestResult {
	return errsIn(
			checkInstUser("type U struct { p PBm[[2]lib.Box] }\ntype PBm[T any] struct { p *T }\n"),
			"cannot form a pointer to a type that embeds an opaque type by value")
}

// An instance's body is checked where its generic is written, and judges an
// instance there in the generic's view: q may pass its own opaque export to
// lib.Pass, whose body holds a Box2[T] pointing to [1]T.
func TestCheckOpaqueInstanceBodyOwnExportOk() testing.TestResult {
	return expectNoErrors(
			checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn),
					"package \"q\"\ntype Op\nfunc F() int\n",
					"package \"q\"\nimport \"pkg/lib\"\ntype Op struct { v int }\n"
							"func F() int {\n\tvar o Op\n\treturn lib.Pass[Op](&o)\n}\n",
					false))
}

// A generic's own parts are judged once, at its declaration, in its view: lib's
// Bad, whose own field points to [2]Box, is rejected in lib's .bni, and not again
// at q's instances of it.
func TestCheckOpaqueInstanceOwnPartsAtDeclaration() testing.TestResult {
	var bni @[]char = buf.Concat(instLibBni, "type Bad[T any] struct { pp *([2]Box); v T }\n")
	var errs @[]types.CheckError = checkBniMethodPkgIn(checkerWithLib(bni, instLibBn),
			"package \"q\"\nfunc F() int\n",
			"package \"q\"\nimport \"pkg/lib\"\ntype W lib.Bad[int]\ntype X *lib.Bad[bool]\n"
					"func F() int { return 0 }\n",
			false).CheckerErrors()
	if len(errs) != 1 {
		return fail(buf.Concat("expected 1 error, at Bad's declaration; got ", strconv.Itoa(len(errs))))
	}
	var f @[]char = errs[0].Pos.File
	if len(f) < 4 || !types.CharEq(f[len(f) - 4:], ".bni") { return fail(errs[0].Msg) }
	return ""
}

// A generic's abstract instance is not known while it is being built: its type
// parameters' constraints may name an instance of it, whose use there — judged by
// the abstract structure — would build it again, without end.  Box's U must
// satisfy C[Box[int, int]], which int does not; and a constraint over Box[T]
// names its own parameter, which is rejected (gen.constraint.self).
func TestAbstractInstanceInOwnConstraint() testing.TestResult {
	var e testing.TestResult = errsIn(
			checkSrc(
					"package \"test\"\ninterface C[T any] { M() T }\n"
							"type Box[T any, U C[Box[int, int]]] struct { x T }\n"),
			"type argument int does not satisfy constraint C[Box[int,int]]")
	if len(e) > 0 { return e }
	return errsIn(
			checkSrc(
					"package \"test\"\ninterface C[T any] { M() T }\n"
							"type Box[T C[Box[T]]] struct { x T }\n"),
			"the constraint of type parameter T names T itself (an interface's methods take or return"
					" the type satisfying it as `Self`)")
}
