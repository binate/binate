package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_inst.bn: an instance's parts that come from its type
// arguments are judged in the importer's view, its generic's own parts in the
// generic's.

// instLibBni and instLibBn are pkg/lib: an opaque export Box; a generic Cell
// whose own field points to a type embedding Box, which lib may form; and a
// generic Pass whose body holds a Box2[T], whose field points to [1]T.
var instLibBni *[]readonly char = "package \"pkg/lib\"\ntype Box\n"
		"type Cell[T any] struct { pp *([2]Box); v T }\nfunc New() @Box\n"
		"type Box2[T any] struct { ps *([1]T) }\n"
		"func Pass[T any](p *T) int {\n\tvar b Box2[T]\n\t_ = b\n\treturn 1\n}\n"

var instLibBn *[]readonly char = "package \"pkg/lib\"\ntype Box struct { n int }\n"
		"func New() @Box { return make(Box) }\n"

// checkInstUser checks package q, whose .bn (after importing pkg/lib) declares
// decls, against instLibBni / instLibBn.
func checkInstUser(decls *[]readonly char) @Checker {
	return checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn), "package \"q\"\nfunc F() int\n",
			buf.Concat(buf.Concat("package \"q\"\nimport \"pkg/lib\"\n", decls),
					"func F() int { return 0 }\n"), false)
}

// A type argument written in the importer is judged as the importer sees it: a
// pointer to [2]lib.Box, or a function value over lib.Box, is ill-formed in q
// whether written directly or through a generic's type parameter — also when the
// argument reaches the pointer through a nested instance.
func TestCheckOpaqueInstanceArgImporterViewRejected() testing.TestResult {
	var decls *[]readonly char = "type PBox[T any] struct { p *T }\n"
			"type MH[T any] struct { f *func(T) }\n"
			"type G[T any] struct { h *PBox[[2]T] }\n"
			"type V PBox[[2]lib.Box]\n"
			"type U MH[lib.Box]\n"
			"type Y G[lib.Box]\n"
	var errs @[]types.CheckError = checkInstUser(decls).CheckerErrors()
	if len(errs) != 3 {
		return fail(buf.Concat("expected 3 errors, one per instance; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// A generic's own parts are judged in its view: lib's Cell[int], whose field
// points to [2]Box, is fine in q; so is a pointer to lib.Box itself through a
// type parameter, and a recursive instance.
func TestCheckOpaqueInstanceGenericPartsOk() testing.TestResult {
	return expectNoErrors(
			checkInstUser(
					"type PBox[T any] struct { p *T }\n"
							"type L[T any] struct { next *L[T]; v *T }\n"
							"type W lib.Cell[int]\ntype X PBox[lib.Box]\ntype Z L[[2]*lib.Box]\n"))
}

// The verdict does not depend on whether the use or the generic is declared
// first: the generic's abstract instance is built when the use needs it.
func TestCheckOpaqueInstanceArgOrder() testing.TestResult {
	return errsIn(
			checkInstUser("type U struct { p PBm[[2]lib.Box] }\ntype PBm[T any] struct { p *T }\n"),
			"cannot form a pointer to a type that embeds an opaque type by value")
}

// An instance's body is checked where its generic is written, and judges an
// instance there in the generic's view: q may pass its own opaque export to
// lib.Pass, whose body holds a Box2[T] pointing to [1]T.
func TestCheckOpaqueInstanceBodyOwnExportOk() testing.TestResult {
	return expectNoErrors(
			checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn),
					"package \"q\"\ntype Op\nfunc F() int\n",
					"package \"q\"\nimport \"pkg/lib\"\ntype Op struct { v int }\n"
							"func F() int {\n\tvar o Op\n\treturn lib.Pass[Op](&o)\n}\n",
					false))
}
