package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for requireMethodInstanceSized on a generic type's methods
// (check_opaque_func.bn, called by checkInstanceBody).  checkSrc, expectNoErrors
// and charsHaveSub are shared from the package's other tests.

// genericBox declares Bx[T], whose methods mention T by value, as a function
// value's parameter, and as a function value's result — none of them in a body
// that needs T's layout.
var genericBox *[]readonly char = "type Bx[T any] struct { p *T }\n"
		"func (b *Bx[T]) Mk() T {\n\tfor {\n\t}\n}\n"
		"func (b *Bx[T]) Set(v *func(T)) {\n}\n"
		"func (b *Bx[T]) Cb() *func(T) {\n\treturn nil\n}\n"

// An instance of a generic type compiles every method with its type arguments,
// so each method whose instantiated signature holds an opaque type by value is
// rejected where the instance is formed, even if it is never called.
func TestCheckOpaqueGenericMethodSignatureRejected() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			buf.Concat(buf.Concat("package \"test\"\ntype Opaque\n", genericBox),
					"func f() {\n\tvar b Bx[Opaque]\n\t_ = &b\n}\n")).CheckerErrors()
	if len(errs) != 3 {
		return fail(buf.Concat("expected 3 errors, one per method; got ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, "cannot use an opaque type by value") ||
				!charsHaveSub(errs[i].Msg, "in Bx[Opaque].") {
			return fail(errs[i].Msg)
		}
	}
	return ""
}

// A receiver of an instance is a parameter like any other: a method of
// `Id[Opaque]` (`type Id[T any] T`) would take an opaque value, and a pointer
// receiver of `Cell[Opaque]` points to a type embedding one — caught even when
// the instance is only a type argument, and reported once per instance, not at
// each method.
func TestCheckOpaqueGenericMethodReceiver() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Id[T any] T\nfunc (o Id[T]) V() int { return 1 }\n"
					"func f(p *Id[Opaque]) { _ = p }\n")
	if len(c.CheckerErrors()) != 1 || !anyErrContains(c, "(in Id[Opaque].V,") {
		return fail("expected exactly the error on Id[Opaque].V's value receiver")
	}
	var cell *[]readonly char = "package \"test\"\ntype Opaque\ntype Cell[T any] struct { v T }\n"
			"func (p *Cell[T]) A() int { return 1 }\nfunc (p *Cell[T]) B() int { return 2 }\n"
			"func g[T any]() int { return 0 }\ntype K[T any] struct { n int }\n"
	c = checkSrc(
			buf.Concat(cell, "func f() int { var k K[Cell[Opaque]]; _ = k; return g[Cell[Opaque]]() }\n"))
	errs := c.CheckerErrors()
	if len(errs) != 1 || !anyErrContains(c, "(in Cell[Opaque].A,") {
		return fail("a type-argument-only Cell[Opaque] is reported once, at its first method's receiver")
	}
	return ""
}

// An instance with a sized type argument — a type, or a pointer to an opaque one
// — keeps its methods.
func TestCheckOpaqueGenericMethodSignatureOk() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					buf.Concat(buf.Concat("package \"test\"\ntype Opaque\n", genericBox),
							"func f() {\n\tvar b Bx[int]\n\tvar c Bx[*Opaque]\n\t_ = &b\n\t_ = &c\n}\n")))
}
