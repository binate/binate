package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// The pointer rule's walk (pointeeEmbedsOpaque): from a pointer, through every
// pointer it points to, to the type at the end of the chain, which must not embed an
// opaque type by value unless it is one.  Each declaration of a chain of pointer
// types (`type P0 *P1`, `type P1 *P2`, ...) walks the chain below it, so the answers
// found for the pointees are kept across a batch's declarations (pointeeMemo), and a
// chain is walked once.  So is a chain of named types or aliases over each other (`type
// N0 N1`, `type A0 = A1`, ...): the type each one's chain ends at, when no pointer, is
// kept with it (pointeeBases), and each declaration's walk stops at the next one.

// pointeeBase returns the type under cur's alias, readonly and named wrappers
// (peelFieldAccessBase), entering in seen each named type it passes other than cur
// (whose name the pointer walk enters itself), or nil where it passes a name met
// before: the chain of pointers goes round, though the walk never meets the named type
// itself -- `type N *readonly N` leads from N to `readonly N`, and from there through N
// inside the readonly, to the same pointer each time.  With bases (pointeeBasesHere), a
// named type or alias whose chain was found to end at a type that is no pointer gives
// that type at once -- a walk that ends there needs no name below it -- and the named
// types and aliases it passes on the way to such a type are kept with it.
func pointeeBase(cur @types.Type, seen *nameVisits, bases @pointeeBases) @types.Type {
	var none @types.Type
	var t @types.Type = cur
	var g chainGuard = newChainGuard(t)
	var passed @vec.Vec[@types.Type]
	if bases != nil { passed = vec.New[@types.Type]() }
	for t != nil {
		var named bool = t.Kind == types.TYP_NAMED && t.Underlying != nil
		if named && !same(t, cur) && len(t.Name) > 0 && !seen.enter(walkName(t)) { return none }
		if bases != nil && (named || t.Kind == types.TYP_ALIAS) {
			var b @types.Type
			var known bool
			b, known = bases.kept.Get(t)
			if known {
				keepBases(bases, passed, b)
				return b
			}
			passed.Push(t)
		}
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if named {
			t = t.Underlying
		} else {
			if bases != nil && t.Kind != types.TYP_POINTER && t.Kind != types.TYP_MANAGED_PTR {
				keepBases(bases, passed, t)
			}
			return t
		}
		if t != nil && chainCloses(&g, t) { return none }
	}
	return none
}

// pointeeBases holds, while a batch's declarations are checked, the type each named
// type's or alias's chain of alias, readonly and named wrappers was found to end at, when
// that is no pointer (pointeeBase); it holds while no type changes.  It is the same in
// every view and frame.
type pointeeBases struct {
	kept    @table.Table[@types.Type, @types.Type, typeIdentityHasher, typeIdentityEq]
	changes int
}

// newPointeeBases returns an empty pointeeBases.
func newPointeeBases(c @Checker) @pointeeBases {
	var b @pointeeBases = make(pointeeBases)
	b.kept = table.NewTable[@types.Type, @types.Type, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
	b.changes = typeChanges(c)
	return b
}

// pointeeBasesHere returns the bases kept while a batch's declarations are checked
// (c.PointeeMemo), emptied if a type has changed since they were found, or nil where
// none are kept: outside such a check, while a package interface is built and while
// declarations are collected.
func pointeeBasesHere(c @Checker) @pointeeBases {
	var m @pointeeMemo = c.PointeeMemo
	if m == nil || c.BniBuild != nil || c.Batch != nil && c.Batch.Collecting { return nil }
	if m.bases.changes != typeChanges(c) { m.bases = newPointeeBases(c) }
	return m.bases
}

// keepBases keeps b as the base of each named type in passed.
func keepBases(bases @pointeeBases, passed @vec.Vec[@types.Type], b @types.Type) {
	for i := 0; i < passed.Len(); i++ { bases.kept.Put(passed.Get(i), b) }
}

// walkName is the name the pointer walk knows t by, to stop where it meets a type
// again: a named type's qualified name (types.NamedIdentityName), as two packages'
// types of one name are two types; any other type's own name.
func walkName(t @types.Type) @[]char {
	if t.Kind == types.TYP_NAMED { return types.NamedIdentityName(t) }
	return t.Name
}

// pointeeMemo holds, while a batch's declarations are checked (checkValueEmbedding),
// the answers pointeeEmbedsOpaque has found, one table per view (opaqueInView), for
// the package being checked (pkg).
type pointeeMemo struct {
	here  @pointeeAnswers
	pure  @pointeeAnswers
	none  @pointeeAnswers
	bases @pointeeBases
	pkg   @[]char
}

// pointeeAnswers holds, for one view, the answer the pointer walk found from each
// pointee on a chain of pointers with no generic instance on it: whether the type at
// the chain's end, reached from that pointee, embeds an opaque type by value -- the
// same from any pointer to it, as the walk stops only at a type it has met before
// (walkName).  Whether the walk goes past an instance depends on the instance's type
// arguments, which the instances on a chain judge in one walk, so the answer from a
// pointee past one can depend on the instances before it, and a chain through one is
// not kept.  The answers hold while no type changes (typeChanges counts the changes
// it was made after).
type pointeeAnswers struct {
	answers @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
	changes int
}

// newPointeeMemo returns an empty pointeeMemo.
func newPointeeMemo(c @Checker) @pointeeMemo {
	var m @pointeeMemo = make(pointeeMemo)
	m.here = newPointeeAnswers(c)
	m.pure = newPointeeAnswers(c)
	m.none = newPointeeAnswers(c)
	m.bases = newPointeeBases(c)
	m.pkg = buf.CopyStr(c.curPkgPath)
	return m
}

// newPointeeAnswers returns an empty pointeeAnswers, made after the type changes so
// far.
func newPointeeAnswers(c @Checker) @pointeeAnswers {
	var a @pointeeAnswers = make(pointeeAnswers)
	a.answers = table.NewTable[@types.Type, bool, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
	a.changes = typeChanges(c)
	return a
}

// pointeeAnswersHere returns the answers kept for view, emptied if a type has changed
// since they were found, or nil where none are kept: outside a batch's check of its
// declarations (c.PointeeMemo), inside an instance frame f, and where the view differs
// from the batch's -- another package's (opaqueExportHiddenHere), an instance's body
// (lentHere), the package interface's view, a collection in progress
// (typeInProgress).
func pointeeAnswersHere(c @Checker, view int, f *opaqueFrame) @pointeeAnswers {
	var m @pointeeMemo = c.PointeeMemo
	if m == nil || f != nil || c.BniBuild != nil || c.Batch != nil && c.Batch.Collecting {
		return nil
	}
	if !types.CharEq(m.pkg, c.curPkgPath) { return nil }
	if c.Instances != nil && c.Instances.BodyDepth > 0 || inBniView(c) { return nil }
	var a @pointeeAnswers = m.none
	if view == viewHere { a = m.here }
	if view == viewPure { a = m.pure }
	if a.changes != typeChanges(c) {
		a.answers = table.NewTable[@types.Type, bool, typeIdentityHasher, typeIdentityEq](
				typeIdentityHasher{}, typeIdentityEq{})
		a.changes = typeChanges(c)
	}
	return a
}
