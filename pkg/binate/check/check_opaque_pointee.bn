package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/table"

// The pointer rule's walk (pointeeEmbedsOpaque): from a pointer, through every
// pointer it points to, to the type at the end of the chain, which must not embed an
// opaque type by value unless it is one.  Each declaration of a chain of pointer
// types (`type P0 *P1`, `type P1 *P2`, ...) walks the chain below it, so the answers
// found for the pointees are kept across a batch's declarations (pointeeMemo), and a
// chain is walked once.

// walkName is the name the pointer walk knows t by, to stop where it meets a type
// again: a named type's qualified name (types.NamedIdentityName), as two packages'
// types of one name are two types; any other type's own name.
func walkName(t @types.Type) @[]char {
	if t.Kind == types.TYP_NAMED { return types.NamedIdentityName(t) }
	return t.Name
}

// pointeeMemo holds, while a batch's declarations are checked (checkValueEmbedding),
// the answers pointeeEmbedsOpaque has found, one table per view (opaqueInView), for
// the package being checked (pkg).
type pointeeMemo struct {
	here @pointeeAnswers
	pure @pointeeAnswers
	none @pointeeAnswers
	pkg  @[]char
}

// pointeeAnswers holds, for one view, the answer the pointer walk found from each
// pointee on a chain of pointers with no generic instance on it: whether the type at
// the chain's end, reached from that pointee, embeds an opaque type by value -- the
// same from any pointer to it, as the walk stops only at a type it has met before
// (walkName).  Whether the walk goes past an instance depends on the instance's type
// arguments, which the instances on a chain judge in one walk, so the answer from a
// pointee past one can depend on the instances before it, and a chain through one is
// not kept.  The answers hold while no type changes (typeChanges counts the changes
// it was made after).
type pointeeAnswers struct {
	answers @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
	changes int
}

// newPointeeMemo returns an empty pointeeMemo.
func newPointeeMemo(c @Checker) @pointeeMemo {
	var m @pointeeMemo = make(pointeeMemo)
	m.here = newPointeeAnswers(c)
	m.pure = newPointeeAnswers(c)
	m.none = newPointeeAnswers(c)
	m.pkg = buf.CopyStr(c.curPkgPath)
	return m
}

// newPointeeAnswers returns an empty pointeeAnswers, made after the type changes so
// far.
func newPointeeAnswers(c @Checker) @pointeeAnswers {
	var a @pointeeAnswers = make(pointeeAnswers)
	a.answers = table.NewTable[@types.Type, bool, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
	a.changes = typeChanges(c)
	return a
}

// pointeeAnswersHere returns the answers kept for view, emptied if a type has changed
// since they were found, or nil where none are kept: outside a batch's check of its
// declarations (c.PointeeMemo), inside an instance frame f, and where the view differs
// from the batch's -- another package's (opaqueExportHiddenHere), an instance's body
// (lentHere), the package interface's view, a collection in progress
// (typeInProgress).
func pointeeAnswersHere(c @Checker, view int, f *opaqueFrame) @pointeeAnswers {
	var m @pointeeMemo = c.PointeeMemo
	if m == nil || f != nil || c.BniBuild != nil || c.Batch != nil && c.Batch.Collecting {
		return nil
	}
	if !types.CharEq(m.pkg, c.curPkgPath) { return nil }
	if c.Instances != nil && c.Instances.BodyDepth > 0 || inBniView(c) { return nil }
	var a @pointeeAnswers = m.none
	if view == viewHere { a = m.here }
	if view == viewPure { a = m.pure }
	if a.changes != typeChanges(c) {
		a.answers = table.NewTable[@types.Type, bool, typeIdentityHasher, typeIdentityEq](
				typeIdentityHasher{}, typeIdentityEq{})
		a.changes = typeChanges(c)
	}
	return a
}
