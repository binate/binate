package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_pointee.bn: the pointer rule's walk, and the answers it keeps
// across a batch's declarations.

// namedPtrChain returns the first of n named types, each a pointer to the next, the
// last a pointer to leaf.
func namedPtrChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := n - 1; i >= 0; i-- {
		var named @types.Type = types.MakeNamedType(buf.Concat("main.P", strconv.Itoa(i)))
		var p @types.Type = make(types.Type)
		p.Kind = types.TYP_POINTER
		p.Elem = t
		named.Underlying = p
		t = named
	}
	return t
}

// opaqueHolder returns struct { o O }, O an opaque type.
func opaqueHolder() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Name = "o"
	fs[0].Type = types.MakeNamedType("main.O")
	return types.MakeStructType("", fs)
}

// askEachLevel asks the pointer walk, with answers kept, at each of the n levels of a
// chain from head down (namedPtrChain), and returns how many answered yes.  Its checker
// and the answers it keeps are gone when it returns, before the chain is released.
func askEachLevel(head @types.Type, n int) int {
	var c @Checker = NewChecker()
	c.PointeeMemo = newPointeeMemo(c)
	var yes int = 0
	var t @types.Type = head
	for i := 0; i < n; i++ {
		if pointeeEmbedsOpaque(c, t, viewHere, nil) { yes = yes + 1 }
		t = t.Underlying.Elem
	}
	return yes
}

// releaseChain drops a chain from namedPtrChain a link at a time, down to its leaf.
func releaseChain(p *@types.Type, n int) {
	for i := 0; i < n; i++ {
		*p = (*p).Underlying.Elem
	}
}

// Asked at each level of a chain of pointer types deepLevels deep, the walk keeps the
// answers it finds, so the chain is walked once, not once per level: the type at the
// end embeds an opaque type, so every level answers yes, and none does over int.
func TestDeepPointeeAnswersKept() testing.TestResult {
	var t @types.Type = namedPtrChain(deepLevels, types.TypInt())
	var none int = askEachLevel(t, deepLevels)
	var bottom @types.Type = t
	for i := 0; i < deepLevels - 1; i++ {
		bottom = bottom.Underlying.Elem
	}
	bottom.Underlying.Elem = opaqueHolder()
	var all int = askEachLevel(t, deepLevels)
	bottom = nil
	releaseChain(&t, deepLevels)
	if none != 0 { return "no level of a chain over int points to an opaque embedding" }
	if all != deepLevels { return "every level of a chain over one points to it" }
	return ""
}

// The answers kept are forgotten when a type changes: a pointee given its first
// underlying type (a fill), and one whose underlying type is replaced.
func TestPointeeAnswersForgottenOnChange() testing.TestResult {
	var c @Checker = NewChecker()
	c.PointeeMemo = newPointeeMemo(c)
	var leaf @types.Type = types.MakeNamedType("main.L")
	var head @types.Type = namedPtrChain(3, leaf)
	if pointeeEmbedsOpaque(c, head, viewHere, nil) {
		return "a pointer to a type with no definition is the escape hatch"
	}
	setUnderlying(c, leaf, opaqueHolder())
	if !pointeeEmbedsOpaque(c, head, viewHere, nil) {
		return "once filled, the pointee embeds an opaque type"
	}
	setUnderlying(c, leaf, types.TypInt())
	if pointeeEmbedsOpaque(c, head, viewHere, nil) {
		return "once replaced by int, the pointee embeds none"
	}
	return ""
}

// countErrSub returns how many of c's errors say needle.
func countErrSub(c @Checker, needle *[]readonly char) int {
	var n int = 0
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, needle) { n = n + 1 }
	}
	return n
}

// Each declaration of a chain of pointer types over a type embedding an opaque one is
// rejected, in either order of declaration: the answers kept for one are the walk's
// from any other.
func TestPointerChainRejectedEachLevel() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque\ntype S struct { o Opaque }\n"
	var down @Checker = checkSrc(buf.Concat(src, "type P2 *S\ntype P1 *P2\ntype P0 *P1\n"))
	var up @Checker = checkSrc(buf.Concat(src, "type P0 *P1\ntype P1 *P2\ntype P2 *S\n"))
	var needle *[]readonly char = "cannot form a pointer to a type that embeds an opaque"
	if countErrSub(down, needle) != 3 || countErrSub(up, needle) != 3 {
		return "each of the three pointer types is rejected, in either order"
	}
	return ""
}

// pointerTo returns a raw pointer to t, built apart.
func pointerTo(t @types.Type) @types.Type {
	var p @types.Type = make(types.Type)
	p.Kind = types.TYP_POINTER
	p.Elem = t
	return p
}

// pkgNamed returns a named type called name, of package pkg, over u.
func pkgNamed(pkg *[]readonly char, name *[]readonly char, u @types.Type) @types.Type {
	var t @types.Type = types.MakeNamedType(buf.CopyStr(name))
	t.Pkg = buf.CopyStr(pkg)
	t.Underlying = u
	return t
}

// Two packages' types of one name are two types to the pointer walk: a.Node, a pointer
// to other.Node, a pointer to a struct holding an opaque type, points to one, as does
// a.R, a pointer to other.Node -- in either order, with the answers kept.
func TestPointeeWalkTellsPackagesApart() testing.TestResult {
	var otherNode @types.Type = pkgNamed("other", "Node", pointerTo(opaqueHolder()))
	var aNode @types.Type = pkgNamed("a", "Node", pointerTo(otherNode))
	var r @types.Type = pkgNamed("a", "R", pointerTo(otherNode))
	for k := 0; k < 2; k++ {
		var c @Checker = NewChecker()
		c.PointeeMemo = newPointeeMemo(c)
		var first @types.Type = aNode
		var second @types.Type = r
		if k == 1 {
			first = r
			second = aNode
		}
		if !pointeeEmbedsOpaque(c, first, viewHere, nil) ||
				!pointeeEmbedsOpaque(c, second, viewHere, nil) {
			return fail("a.Node and a.R each point to a type holding an opaque type, in either order")
		}
	}
	return ""
}
