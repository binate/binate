package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/vec"

// The pointer rule's walk over a type's parts (partsPointToOpaqueEmbedding) takes the
// parts from a work list (pointsWork) rather than recursing on them, so a type nested
// to any depth is walked.  A part that is a pointer to a type embedding an opaque
// type by value ends the walk, so a part entered before (opaqueWalk) adds nothing.  An
// instance's arguments are judged before its structure, which is walked with a walk
// and a frame of its own (instanceStructure); the items hold them.

// A pointsItem is a part for the walk to judge: t, whether t's pointee is judged
// (pointee) before its parts, the view, frame and walk it is judged in, and -- holding
// them -- the frame and walk of the instance structure it is part of (ownF, ownW).  An
// instance whose arguments wait to be judged waits behind them as a rest item (rest),
// to walk its structure next; an argument (arg, the argIndex-th of the instance t,
// whose generic's abstract instance is abs) is judged only if the structure does not
// mention its parameter (argUnmentioned).
type pointsItem struct {
	t        @types.Type
	pointee  bool
	rest     bool
	arg      bool
	argIndex int
	abs      @types.Type
	view     int
	f        *opaqueFrame
	w        *opaqueWalk
	ownF     @opaqueFrame
	ownW     @opaqueWalk
}

// pointsWork holds the parts the walk has still to judge, the next one last, kept from
// one walk to the next; a walk starts at its base and leaves the list as it found it.
var pointsWork @vec.Vec[pointsItem]

// partsPointToOpaqueEmbedding reports whether a part of t -- an element, a field, a
// pointee, at any depth -- is a pointer or handle to a type that embeds an opaque type
// by value (pointeeEmbedsOpaque), in view inside the frame f (if any), in the walk w.
// An instance's type arguments are its parts too, types written where it is
// (argUnmentioned); an instance entered where it is written is walked as its generic
// declares it (instanceStructure), only the parts that come from its arguments
// judged.
func partsPointToOpaqueEmbedding(c @Checker, t @types.Type, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	if pointsWork == nil { pointsWork = vec.New[pointsItem]() }
	var base int = pointsWork.Len()
	var first pointsItem
	first.t = t
	first.view = view
	first.f = f
	first.w = w
	var found bool = pointsStep(c, &first)
	for !found && pointsWork.Len() > base {
		it, _ := pointsWork.Pop()
		found = pointsStep(c, &it)
	}
	for pointsWork.Len() > base {
		_, _ = pointsWork.Pop()
	}
	return found
}

// pointsPush pushes the part t of the item it -- in its walk, with its frame unless f
// replaces it -- for the walk to judge, its pointee first when pointee.
func pointsPush(it *pointsItem, t @types.Type, view int, f *opaqueFrame, pointee bool) {
	var p pointsItem
	p.t = t
	p.pointee = pointee
	p.view = view
	p.f = f
	p.w = it.w
	p.ownF = it.ownF
	p.ownW = it.ownW
	pointsWork.Push(p)
}

// pointsStep judges the item it: whether its type's pointee embeds an opaque type, or
// pushes its parts for the walk to judge.
func pointsStep(c @Checker, it *pointsItem) bool {
	var t @types.Type = it.t
	var view int = it.view
	var f *opaqueFrame = it.f
	if it.arg {
		if !argUnmentioned(it.abs, t.InstDecl, it.argIndex) { return false }
		t = t.InstArgs[it.argIndex]
		if pointeeEmbedsOpaque(c, t, view, f) { return true }
	} else if it.rest {
		abs, fr := instanceStructure(c, t, view, f)
		if abs != nil {
			var fresh @opaqueWalk = make(opaqueWalk)
			var p pointsItem
			p.t = abs
			p.view = viewNone
			p.f = fr
			p.w = fresh
			p.ownF = fr
			p.ownW = fresh
			pointsWork.Push(p)
			return false
		}
		view = substitutedView(view)
		buildIfPostponed(c, t)
		t = t.Underlying
	} else if it.pointee && pointeeEmbedsOpaque(c, t, view, f) {
		return true
	}
	for t != nil {
		t, view, f = bindFrame(t, view, f)
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !it.w.enter(t, view) || !argsMayBringOpaque(c, t, view, f) { return false }
			pointsPushInstance(c, it, t, view, f)
			return false
		} else {
			break
		}
	}
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
		if it.w.enter(t, view) { pointsPush(it, t.Elem, view, f, true) }
		return false
	}
	if k == types.TYP_STRUCT && it.w.enter(t, view) {
		for i := len(t.Fields) - 1; i >= 0; i-- {
			pointsPush(it, t.Fields[i].Type, view, f, true)
		}
	}
	return false
}

// pointsPushInstance pushes, for the instance t entered in view inside the frame f, its
// rest item and then its arguments, last first, for the walk to judge before the rest.
func pointsPushInstance(c @Checker, it *pointsItem, t @types.Type, view int, f *opaqueFrame) {
	var abs @types.Type = abstractInstanceOf(c, t)
	var rest pointsItem
	rest.t = t
	rest.rest = true
	rest.view = view
	rest.f = f
	rest.w = it.w
	rest.ownF = it.ownF
	rest.ownW = it.ownW
	pointsWork.Push(rest)
	for i := len(t.InstArgs) - 1; i >= 0; i-- {
		var a pointsItem = rest
		a.rest = false
		a.arg = true
		a.argIndex = i
		a.abs = abs
		pointsWork.Push(a)
	}
}
