package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_opaque_points_walk.bn: the pointer rule's walk over a type's parts
// judges types nested deepLevels deep.

// pointsOnChains reports, in a checker of its own (rulesOnChains), whether a part of a
// chain of arrays, and of a chain of structs, points to a type embedding an opaque
// type.
func pointsOnChains(arrays @types.Type, structs @types.Type) (bool, bool) {
	var c @Checker = checkSrc("package \"main\"\n")
	var throughArrays bool = nestedPointerEmbedsOpaque(c, arrays, viewHere, nil)
	return throughArrays, nestedPointerEmbedsOpaque(c, structs, viewHere, nil)
}

// A pointer to a struct holding an opaque type at the bottom of arrays, or of structs,
// nested deepLevels deep is found.
func TestDeepNestedPointerEmbedsOpaque() testing.TestResult {
	var arrays @types.Type = arrayChain(deepLevels, opaqueHolderPointer())
	var structs @types.Type = structChain(deepLevels, opaqueHolderPointer())
	throughArrays, throughStructs := pointsOnChains(arrays, structs)
	dropLinks(&arrays, deepLevels)
	dropLinks(&structs, deepLevels)
	if !throughArrays { return fail("a pointer to an opaque holder deep in arrays is found") }
	if !throughStructs { return fail("a pointer to an opaque holder deep in structs is found") }
	return ""
}
