package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/vec"

// While a batch's declarations are collected, or a `.bni`'s resolved, a type they
// define that collection or resolution has not reached yet is pending: not opaque,
// though it has no underlying type yet (typeInProgress) -- a layout read does not walk
// a slice's element, so `sizeof(@[]S)` before S's declaration meets S so.  Whether a
// pending type embeds an opaque type is not known until it is collected, so an opaque
// check that meets one -- in a constant's or a variable's initializer read during
// collection, an instance built then, an array length -- reports nothing that depends
// on it, and is made again once the declarations are all collected or resolved
// (recheckOpaqueReads): `type S q.Opaque` makes `sizeof(@[]S)` an error then.  An
// error found that way is reported where the check was made, though not named for the
// instance being built then.

// pendingReads counts the pending types the opaque checks have met (met), and holds
// the checks to make again (deferred, made on first use).
type pendingReads struct {
	met      int
	deferred @vec.Vec[deferredOpaque]
}

// The kinds of a deferredOpaque, each made again by the check it names.
const (
	deferEmbeds int = iota // requireNoOpaqueByValue
	deferValueOfType       // checkValueOfType
	deferUnsafeCastTarget  // checkUnsafeCastTarget
	deferBitCast           // checkBitCastShapes
	deferVariadicPack      // checkVariadicPack
	deferSized             // requireSizedType
	deferFormed            // requireFormedType
	deferFormedArg         // requireFormedArg
	deferOpaqueRules       // requireOpaqueRules
	deferCallSig           // requireCallSigKept
	deferFitting           // requireFitting
)

// deferredOpaque is an opaque check to make again: its kind, and the arguments it
// was made with -- the types t and u, the type arguments args, the count n, the
// position pos and the message msg, as the kind's check takes them.
type deferredOpaque struct {
	kind int
	t    @types.Type
	u    @types.Type
	args @[]@types.Type
	n    int64
	pos  token.Pos
	msg  *[]readonly char
}

// notePendingType records that an opaque check met a pending type.
func notePendingType(c @Checker) {
	if c.PendingReads == nil { c.PendingReads = make(pendingReads) }
	c.PendingReads.met = c.PendingReads.met + 1
}

// pendingTypesMet returns how many pending types the opaque checks have met.
func pendingTypesMet(c @Checker) int {
	if c.PendingReads == nil { return 0 }
	return c.PendingReads.met
}

// deferIfPending queues the check d to be made again (recheckOpaqueReads) if a pending
// type was met since met counted them (pendingTypesMet), and reports whether one was
// -- unless what it would report would be dropped now (layoutFrameBlocked): the build
// done again makes it again.
func deferIfPending(c @Checker, met int, d deferredOpaque) bool {
	if pendingTypesMet(c) == met { return false }
	if layoutFrameBlocked(c) { return true }
	if c.PendingReads.deferred == nil { c.PendingReads.deferred = vec.New[deferredOpaque]() }
	c.PendingReads.deferred.Push(d)
	return true
}

// deferredCheck returns a deferredOpaque of kind for t at pos.
func deferredCheck(kind int, t @types.Type, pos token.Pos) deferredOpaque {
	var d deferredOpaque
	d.kind = kind
	d.t = t
	d.pos = pos
	return d
}

// recheckOpaqueReads makes again the checks deferred while declarations were collected
// or a `.bni` resolved.  One that still meets a pending type -- of an enclosing
// collection or resolution not done yet -- defers itself again, for that one's end.
func recheckOpaqueReads(c @Checker) {
	if c.PendingReads == nil || c.PendingReads.deferred == nil { return }
	var queued @vec.Vec[deferredOpaque] = c.PendingReads.deferred
	c.PendingReads.deferred = nil
	for i := 0; i < queued.Len(); i++ {
		runDeferredOpaque(c, queued.Get(i))
	}
}

// runDeferredOpaque makes the check d again.
func runDeferredOpaque(c @Checker, d deferredOpaque) {
	if d.kind == deferEmbeds {
		_ = requireNoOpaqueByValue(c, d.t, d.pos, d.msg)
	} else if d.kind == deferValueOfType {
		checkValueOfType(c, d.t, d.pos, d.msg)
	} else if d.kind == deferUnsafeCastTarget {
		checkUnsafeCastTarget(c, d.t, d.pos)
	} else if d.kind == deferBitCast {
		checkBitCastShapes(c, d.pos, d.t, d.u)
	} else if d.kind == deferVariadicPack {
		checkVariadicPack(c, d.t, d.n, d.pos)
	} else if d.kind == deferSized {
		requireSizedType(c, d.t, d.pos)
	} else if d.kind == deferFormed {
		_ = requireFormedType(c, d.t, d.pos)
	} else if d.kind == deferFormedArg {
		_ = requireFormedArg(c, d.t, d.pos)
	} else if d.kind == deferOpaqueRules {
		requireOpaqueRules(c, d.t, d.pos)
	} else if d.kind == deferCallSig {
		requireCallSigKept(c, d.t, d.args, d.u, d.pos)
	} else if d.kind == deferFitting {
		_ = requireFitting(c, d.t, d.pos)
	}
}

// requireNoOpaqueByValue reports msg at pos, and returns false, when t embeds an
// opaque type by value; when that is not known yet (t reaches a pending type) the
// check is made again once it is.
func requireNoOpaqueByValue(c @Checker, t @types.Type, pos token.Pos, msg *[]readonly char) bool {
	var met int = pendingTypesMet(c)
	if embedsOpaqueByValue(c, t) {
		addCheckError(c, pos, buf.CopyStr(msg))
		return false
	}
	var d deferredOpaque = deferredCheck(deferEmbeds, t, pos)
	d.msg = msg
	_ = deferIfPending(c, met, d)
	return true
}

// checkValueOfType checks t, the type of a value a builtin makes or whose layout it
// reads (make, make_slice's element, sizeof / alignof's operand), at pos: one
// embedding an opaque type by value is reported with msg; otherwise it is held to the
// rules on forming a type and to the target's size limit.  A check that meets a pending
// type is made again once it is collected.
func checkValueOfType(c @Checker, t @types.Type, pos token.Pos, msg *[]readonly char) {
	var met int = pendingTypesMet(c)
	if embedsOpaqueByValue(c, t) {
		addCheckError(c, pos, buf.CopyStr(msg))
	} else if requireFormedType(c, t, pos) {
		_ = requireFitting(c, t, pos)
	}
	var d deferredOpaque = deferredCheck(deferValueOfType, t, pos)
	d.msg = msg
	_ = deferIfPending(c, met, d)
}

// checkVariadicPack holds the array of n arguments of type elem a variadic call packs
// its trailing arguments into (func.variadic.pack) to the target's maximum object size
// (type.layout.max-size), at pos, unless elem embeds an opaque type (reported where it
// is required).  One that meets a pending type is made again once it is collected.
func checkVariadicPack(c @Checker, elem @types.Type, n int64, pos token.Pos) {
	var met int = pendingTypesMet(c)
	var opaque bool = embedsOpaqueByValue(c, elem)
	var d deferredOpaque = deferredCheck(deferVariadicPack, elem, pos)
	d.n = n
	if deferIfPending(c, met, d) || opaque { return }
	_ = requireFittingType(c, types.MakeArrayType(elem, n), pos)
}

// sizeAwaitsPending reports, while declarations are collected or a `.bni` resolved,
// whether t's size depends on a pending type it holds by value -- one with no size
// yet, which a size limit is held to once it is collected (fitsTarget) -- noting each
// it meets (typePending).
func sizeAwaitsPending(c @Checker, t @types.Type) bool {
	if c == nil || c.BniBuild == nil && (c.Batch == nil || !c.Batch.Collecting) { return false }
	var seen typeVisits
	var base int = typeWalkBase()
	var found bool = false
	typeWalkPush(t)
	for !found && typeWalkMore(base) {
		var x @types.Type = typeWalkPop()
		if x == nil || !seen.enter(x) { continue }
		if x.Kind == types.TYP_NAMED {
			if x.Underlying == nil {
				found = typePending(c, x)
			} else {
				typeWalkPush(x.Underlying)
			}
		} else if x.Kind == types.TYP_ALIAS {
			typeWalkPush(x.Target)
		} else if x.Kind == types.TYP_ARRAY || x.Kind == types.TYP_READONLY {
			typeWalkPush(x.Elem)
		} else if x.Kind == types.TYP_STRUCT {
			pushFieldTypes(x)
		}
	}
	typeWalkEnd(base)
	return found
}
