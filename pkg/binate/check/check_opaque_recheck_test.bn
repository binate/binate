package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_recheck.bn: an opaque check that met a type not collected
// yet is made again once collection is done.

// qOpaque is a package exporting an opaque type.
var qOpaque *[]readonly char = "package \"pkg/q\"\ntype Opaque\n"

// recheckSrc returns a program importing pkg/q, of the declarations head, then S (on
// the line after head's last) defined as body.
func recheckSrc(head *[]readonly char, body *[]readonly char) @[]char {
	var src @[]char = buf.Concat("package \"main\"\nimport \"pkg/q\"\n", head)
	return buf.Concat(buf.Concat(buf.Concat(src, "type S "), body), "\n")
}

// opaqueReadAt reports whether c reported a `sizeof` / `alignof` of an opaque type at
// line, named for an instance or not.
func opaqueReadAt(c @Checker, line int) bool {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == line &&
				hasPrefixAt(errs[i].Msg, 0,
						"cannot take sizeof/alignof of an opaque type (its layout is not available here)") {
			return true
		}
	}
	return false
}

// A slice of a type declared later is no opaque type while the declarations are
// collected; once they are, the element is found to hold an imported opaque type by
// value, and the `sizeof` is reported where it is written, as S's field is at S.
func TestOpaqueRecheckOfLaterSliceElement() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q", qOpaque,
			recheckSrc("type X struct { a [sizeof(@[]S)]uint8 }\n", "struct { o q.Opaque }"))
	if !opaqueReadAt(c, 3) {
		return fail("the sizeof of a slice of S, which holds an opaque type, is reported")
	}
	if !errAtLine(c, 4,
			"cannot use an opaque type by value (its layout is not available here; hold it via *T or @T)") {
		return fail("S's opaque field is reported")
	}
	return errCount(c, 2)
}

// S, declared later as an opaque type's named type, is pending while the declarations
// are collected; the `sizeof` of a slice of it is reported once they are -- in a
// constant an array length reads, an instance built then, or an array length.
func TestOpaqueRecheckOfLaterOpaqueNamedType() testing.TestResult {
	var heads @[]*[]readonly char = make_slice(*[]readonly char, 3)
	heads[0] = "const K uint = sizeof(@[]S)\ntype Z [K]uint8\n"
	heads[1] = "type Box[T any] struct { a [sizeof(@[]T)]uint8 }\ntype W struct { b *Box[S] }\n"
	heads[2] = "type X struct { a [sizeof(@[]S)]uint8 }\n"
	for i := 0; i < len(heads); i++ {
		var c @Checker = checkSrcImporting("pkg/q", qOpaque, recheckSrc(heads[i], "q.Opaque"))
		if !opaqueReadAt(c, 3) {
			return fail(buf.Concat("the sizeof of a slice of S is reported: ", heads[i]))
		}
		var e @Checker = checkSrcImporting("pkg/q", qOpaque, recheckSrc(heads[i], "struct { v int64 }"))
		if len(e.CheckerErrors()) != 0 {
			return fail(buf.Concat("with S a struct, nothing is reported: ", heads[i]))
		}
	}
	return ""
}

// A later type has no size while the declarations are collected: an array of one far
// past what a pointer-sized element would fit, behind a slice, is not taken for too
// large -- in an array length, a constant an array length reads, an instance built
// then, or an alignof (a 64-bit target, where the array of 1-byte S fits).
func TestOpaqueRecheckNoFalseTooLarge() testing.TestResult {
	var old types.TargetInfo = pinTarget64()
	defer { types.SetTarget(old) }
	var heads @[]*[]readonly char = make_slice(*[]readonly char, 4)
	heads[0] = "type X struct { a [sizeof(@[][4611686018427387904]S)]uint8 }\n"
	heads[1] = "const K uint = sizeof(@[][4611686018427387904]S)\ntype Z [K]uint8\n"
	heads[2] = "type Box[T any] struct { a [sizeof(@[][4611686018427387904]T)]uint8 }\n"
			"type W struct { b *Box[S] }\n"
	heads[3] = "type X struct { a [alignof(@[][4611686018427387904]S)]uint8 }\n"
	for i := 0; i < len(heads); i++ {
		var c @Checker = checkSrcImporting("pkg/q", qOpaque, recheckSrc(heads[i], "struct { b uint8 }"))
		var errs @[]CheckError = c.CheckerErrors()
		if len(errs) != 0 {
			return fail(buf.Concat(buf.Concat(heads[i], ": "), errs[0].Msg))
		}
	}
	return ""
}

// No check of a slice of a `.bni`'s type over an opaque type is left deferred past the
// `.bni`'s build: an array length's sizeof is reported while the scope is built, and a
// constant's is left to the importer that reads it (a `.bni` constant's opaque layout
// read is no constant, not an error, there).
func TestBniOpaqueNamedTypeReportedInBuild() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "package \"pkg/p\"\nimport \"pkg/q\"\ntype S q.Opaque\ntype T [sizeof(@[]S)]uint8\n"
	srcs[1] = "package \"pkg/p\"\nimport \"pkg/q\"\ntype S q.Opaque\nconst K uint = sizeof(@[]S)\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = NewChecker()
		c.LoadPackageInterface("pkg/q", mkBniFile(qOpaque))
		c.LoadPackageInterface("pkg/p", mkBniFile(srcs[i]))
		if i == 0 && !opaqueReadAt(c, 4) {
			return fail("the array length's sizeof of a slice of S is reported while the scope is built")
		}
		if c.PendingReads != nil && c.PendingReads.deferred != nil && c.PendingReads.deferred.Len() > 0 {
			return fail(buf.Concat("no check is left deferred past the build, in case ", strconv.Itoa(i)))
		}
	}
	return ""
}
