package "pkg/binate/check"

import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/vec"

// The opaque rules a type is held to (opaqueRulesKept) -- no opaque type by value, no
// pointer to a type embedding one, no function signature it spells out that breaks
// them as a declaration's would (rulesSigsStep), checked in each part, an
// interface instance's methods' signatures included -- are judged on one work list of
// parts (rulesWork) rather than by recursing on them, so a type nested to any depth is
// judged.  The first part that breaks a rule is reported and ends the walk; every part
// keeps them otherwise.  An instance's structure, and an interface instance's
// signatures, are judged after its arguments: they wait behind them as items of their
// own.

// The judgements of the walk, one per item.
const (
	rulesOpaque int = iota // opaqueRulesKept
	rulesFormation         // formationRulesKept
	rulesSigs              // the signatures a type spells out (rulesSigsStep)
	rulesSigPart           // a signature's parameter or result, once per view
	rulesInstArg           // an instance's argument, if its structure does not use it
	rulesInstRest          // an instance's structure, its arguments judged
	rulesIfaceInst         // an interface instance (ifaceInstanceKept)
	rulesIfaceArg          // an interface instance's argument its methods do not use
	rulesIfaceSigs         // an interface's signatures (ifaceSignaturesKept)
)

// A rulesItem is a part for the walk to judge: the judgement (proc), its type t, the
// view, frame and walk it is judged in, and -- holding them -- the frame and walk of
// the instance structure it is part of (ownF, ownW); an instance's argument (the
// argIndex-th of the instance t) also carries its generic's abstract instance (abs).
type rulesItem struct {
	proc     int
	t        @types.Type
	argIndex int
	abs      @types.Type
	view     int
	f        *opaqueFrame
	w        *opaqueWalk
	ownF     @opaqueFrame
	ownW     @opaqueWalk
}

// rulesWork holds the parts the walk has still to judge, the next one last, kept from
// one walk to the next; a walk starts at its base and leaves the list as it found it.
var rulesWork @vec.Vec[rulesItem]

// rulesRun judges t by proc, in view inside the frame f (if any), in the walk w,
// reporting the first rule broken at pos, and reports whether all are kept.
func rulesRun(c @Checker, proc int, t @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	if rulesWork == nil { rulesWork = vec.New[rulesItem]() }
	var base int = rulesWork.Len()
	var first rulesItem
	first.proc = proc
	first.t = t
	first.view = view
	first.f = f
	first.w = w
	var kept bool = rulesStep(c, &first, pos)
	for kept && rulesWork.Len() > base {
		it, _ := rulesWork.Pop()
		kept = rulesStep(c, &it, pos)
	}
	for rulesWork.Len() > base {
		_, _ = rulesWork.Pop()
	}
	return kept
}

// rulesPush pushes the part t of the item it, judged by proc in view inside the frame f,
// in the walk of it.
func rulesPush(it *rulesItem, proc int, t @types.Type, view int, f *opaqueFrame) {
	var p rulesItem
	p.proc = proc
	p.t = t
	p.view = view
	p.f = f
	p.w = it.w
	p.ownF = it.ownF
	p.ownW = it.ownW
	rulesWork.Push(p)
}

// rulesPushArgs pushes, for the instance t (judged in view inside the frame f), the
// item proc on it -- its structure or signatures, judged after its arguments -- and
// then its arguments, last first, each an item argProc.
func rulesPushArgs(c @Checker, it *rulesItem, proc int, argProc int, t @types.Type, view int,
		f *opaqueFrame) {
	var abs @types.Type = abstractInstanceOf(c, t)
	rulesPush(it, proc, t, view, f)
	for i := len(t.InstArgs) - 1; i >= 0; i-- {
		var a rulesItem
		a.proc = argProc
		a.t = t
		a.argIndex = i
		a.abs = abs
		a.view = view
		a.f = f
		a.w = it.w
		a.ownF = it.ownF
		a.ownW = it.ownW
		rulesWork.Push(a)
	}
}

// rulesStep judges the item it, reporting at pos and returning false if it breaks a
// rule, else pushing the parts it is judged by and returning true.
func rulesStep(c @Checker, it *rulesItem, pos token.Pos) bool {
	var proc int = it.proc
	var t @types.Type = it.t
	var view int = it.view
	var f *opaqueFrame = it.f
	if proc == rulesInstArg || proc == rulesIfaceArg {
		if !argUnmentioned(it.abs, t.InstDecl, it.argIndex) { return true }
		t = t.InstArgs[it.argIndex]
		if proc == rulesInstArg { proc = rulesSigs } else { proc = rulesFormation }
	} else if proc == rulesSigPart {
		if !it.w.checkOnce(t, view) { return true }
		proc = rulesOpaque
	} else if proc == rulesIfaceInst {
		rulesPushArgs(c, it, rulesIfaceSigs, rulesIfaceArg, t, view, f)
		return true
	} else if proc == rulesIfaceSigs {
		return rulesIfaceSigsStep(it, t, view, f)
	} else if proc == rulesInstRest {
		abs, fr := instanceStructure(c, t, view, f)
		if abs != nil {
			var fresh @opaqueWalk = make(opaqueWalk)
			var p rulesItem
			p.proc = rulesSigs
			p.t = abs
			p.view = viewNone
			p.f = fr
			p.w = fresh
			p.ownF = fr
			p.ownW = fresh
			rulesWork.Push(p)
			return true
		}
		view = substitutedView(view)
		buildIfPostponed(c, t)
		t = t.Underlying
		proc = rulesSigs
	}
	if proc == rulesOpaque {
		t, view, f = bindFrame(t, view, f)
		if embedsOpaqueByValueFramed(c, t, view, f) {
			addCheckError(c, pos,
					"cannot use an opaque type by value"
							" (its layout is not available here; hold it via *T or @T)")
			return false
		}
		proc = rulesFormation
	}
	if proc == rulesFormation {
		// A pointer / handle whose ULTIMATE pointee embeds an opaque type by value
		// but is not itself bare opaque (`*Box[Opaque]`, `**Box[Opaque]`,
		// `@(*struct { o Opaque })`) is ill-formed: that pointee can never be a
		// value (every field access is rejected) and merely forming the type
		// instantiates / lays out a struct IR-gen would fabricate.  Bare `*Opaque`
		// / `@Opaque` — the escape hatch — stay legal (the pointee IS bare opaque).
		// This closes the pointer-to-opaque-embedding residual so IR-gen never sees
		// an opaque arg.
		if pointeeEmbedsOpaque(c, t, view, f) || nestedPointerEmbedsOpaque(c, t, view, f) {
			addCheckError(c, pos,
					"cannot form a pointer to a type that embeds an opaque type by"
							" value (it can never be a value; hold the opaque directly via"
							" *Opaque / @Opaque)")
			return false
		}
	}
	rulesSigsStep(c, it, t, view, f)
	return true
}

// rulesSigsStep pushes the parts the signature rules judge t by, in view inside the
// frame f: a function type's parameters and results (each once per view), an
// interface instance in a frame (ifaceInstanceKept), an element, a field, an
// instance's arguments and then its structure.  A part entered before adds nothing: it
// was judged, in this walk or an earlier one sharing it, and kept the rules -- any part
// that breaks one ends the walk, reported -- or broke one already reported, or it is on
// the current path.
func rulesSigsStep(c @Checker, it *rulesItem, t @types.Type, view int, f *opaqueFrame) {
	for t != nil {
		t, view, f = bindFrame(t, view, f)
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !it.w.enter(t, view) || !argsMayBringOpaque(c, t, view, f) { return }
			rulesPushArgs(c, it, rulesInstRest, rulesInstArg, t, view, f)
			return
		} else {
			break
		}
	}
	if t == nil { return }
	var k int = t.Kind
	if isFuncKind(k) {
		if !it.w.enter(t, view) { return }
		for i := len(t.Results) - 1; i >= 0; i-- {
			rulesPush(it, rulesSigPart, t.Results[i], view, f)
		}
		for i := len(t.Params) - 1; i >= 0; i-- {
			rulesPush(it, rulesSigPart, t.Params[i].Type, view, f)
		}
		return
	}
	if k == types.TYP_INTERFACE && len(t.InstArgs) > 0 && f != nil {
		rulesPush(it, rulesIfaceInst, t, view, f)
		return
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		if it.w.enter(t, view) { rulesPush(it, rulesSigs, t.Elem, view, f) }
		return
	}
	if k == types.TYP_STRUCT && it.w.enter(t, view) {
		for i := len(t.Fields) - 1; i >= 0; i-- {
			rulesPush(it, rulesSigs, t.Fields[i].Type, view, f)
		}
	}
}

// rulesIfaceSigsStep pushes the parts ifaceSignaturesKept judges the interface iface by,
// in view inside the frame f, unless it was entered before: its methods' parameters
// and results (each once per view), then its parents' signatures.  It reports that
// iface keeps the rules so far.
func rulesIfaceSigsStep(it *rulesItem, iface @types.Type, view int, f *opaqueFrame) bool {
	if !it.w.enter(iface, view) { return true }
	for i := len(iface.Parents) - 1; i >= 0; i-- {
		rulesPush(it, rulesIfaceSigs, iface.Parents[i], view, f)
	}
	for i := len(iface.Methods) - 1; i >= 0; i-- {
		var ft @types.Type = iface.Methods[i].FuncType
		if ft == nil { continue }
		for j := len(ft.Results) - 1; j >= 0; j-- {
			rulesPush(it, rulesSigPart, ft.Results[j], view, f)
		}
		for j := len(ft.Params) - 1; j >= 0; j-- {
			rulesPush(it, rulesSigPart, ft.Params[j].Type, view, f)
		}
	}
	return true
}

// opaqueRulesKept reports the first opaque rule t breaks in view (opaqueInView),
// and whether t keeps them all: no opaque value by value, no pointer to a type
// embedding one, and no function type t spells out — a function value's
// signature — whose parameters and results break them as a function
// declaration's would (rulesSigsStep).  w holds the types the signature
// walk has entered and checked; f is the instance structure frame t is in, if
// any (bindFrame).
func opaqueRulesKept(c @Checker, t @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return rulesRun(c, rulesOpaque, t, pos, w, view, f)
}

// formationRulesKept is opaqueRulesKept without the by-value rule: the rules on
// how a type may be formed — no pointer to a type embedding an opaque type by
// value, and no function signature that breaks the opaque rules.
func formationRulesKept(c @Checker, t @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return rulesRun(c, rulesFormation, t, pos, w, view, f)
}

// signaturePartKept reports whether a function type's parameter or result type p
// keeps the opaque rules (opaqueRulesKept), checking each type once per view; f
// is the instance structure frame p is in, if any.
func signaturePartKept(c @Checker, p @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return rulesRun(c, rulesSigPart, p, pos, w, view, f)
}

// ifaceInstanceKept reports whether the interface instance iface, in the frame f
// if any, keeps the opaque rules in view: the type arguments its methods never
// use the rules on forming a type (argUnmentioned, formationRulesKept), then its
// methods' signatures (ifaceSignaturesKept), reporting the first part that
// breaks them at pos.
func ifaceInstanceKept(c @Checker, iface @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return rulesRun(c, rulesIfaceInst, iface, pos, w, view, f)
}

// ifaceSignaturesKept reports whether every method of the interface iface, its
// parents' included, keeps the opaque rules in view (signaturePartKept),
// reporting the first part that breaks them at pos; f is the instance structure
// frame iface is in, if any.
func ifaceSignaturesKept(c @Checker, iface @types.Type, pos token.Pos, w *opaqueWalk, view int,
		f *opaqueFrame) bool {
	return rulesRun(c, rulesIfaceSigs, iface, pos, w, view, f)
}
