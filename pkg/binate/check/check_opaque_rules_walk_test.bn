package "pkg/binate/check"

import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_opaque_rules_walk.bn: the opaque rules are judged on types nested
// deepLevels deep, far deeper than a walk with one stack frame per level could go.

// rulesOnChains judges, in a checker of its own, which holds the types its checks met
// and so is let go of before they are, the formation rules on a chain of function
// types and on a chain of structs, and the signatures of a chain of interfaces; it
// returns the three answers and how many errors were reported.
func rulesOnChains(sigs @types.Type, structs @types.Type,
		ifaces @types.Type) (bool, bool, bool, int) {
	var c @Checker = checkSrc("package \"main\"\n")
	var pos token.Pos
	var w1 opaqueWalk
	var w2 opaqueWalk
	var w3 opaqueWalk
	var sigsKept bool = formationRulesKept(c, sigs, pos, &w1, viewHere, nil)
	var structsKept bool = formationRulesKept(c, structs, pos, &w2, viewHere, nil)
	var ifacesKept bool = ifaceSignaturesKept(c, ifaces, pos, &w3, viewHere, nil)
	return sigsKept, structsKept, ifacesKept, len(c.CheckerErrors())
}

// Function types nested deepLevels deep over int, and interfaces each the next's
// parent, keep the opaque rules; structs nested as deep over a pointer to a struct
// holding an opaque type break them, reported once.
func TestDeepOpaqueRules() testing.TestResult {
	var sigs @types.Type = funcChain(deepLevels, types.TypInt())
	var structs @types.Type = structChain(deepLevels, opaqueHolderPointer())
	var ifaces @types.Type = ifaceChain(deepLevels, types.TypInt())
	sigsKept, structsKept, ifacesKept, errs := rulesOnChains(sigs, structs, ifaces)
	dropFuncLinks(&sigs, deepLevels)
	dropLinks(&structs, deepLevels)
	for i := 1; i < deepLevels; i++ {
		ifaces = ifaces.Parents[0]
	}
	if !sigsKept { return fail("deep function types over int keep the opaque rules") }
	if structsKept { return fail("deep structs over a pointer to an opaque holder break them") }
	if !ifacesKept { return fail("a deep chain of interfaces keeps them") }
	if errs != 1 { return fail("the broken rule is reported once") }
	return ""
}
