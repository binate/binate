package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// Where an instance is written, its type arguments are types written there,
// held to the rules on forming a type, and the parts of the instance that come
// from them are judged there too (type.opaque.pointer-to-embedding,
// type.opaque.signature).  A struct instance is judged by the walk of the type
// that holds it (instanceStructure); the instances no such walk enters are
// judged where they are written: a generic interface's instance, a generic
// alias's use, whose target is the type as if written at the use, and a generic
// function's call.  In an instance's body, the arguments are judged as the body
// sees them: where its generic is written, with the opaque exports lent to it
// visible (lentHere).

// requireFormedArg reports, at pos, the first rule on forming a type that the
// type argument t breaks (formationRulesKept), and whether it keeps them.
func requireFormedArg(c @Checker, t @types.Type, pos token.Pos) bool {
	var w opaqueWalk
	var none *opaqueFrame
	return formationRulesKept(c, t, pos, &w, viewHere, none)
}

// unmentionedArgsFormed reports, at pos, the first type argument in args, of an
// instance of the generic owner whose abstract instance (or alias target) abs
// never mentions it (argUnmentioned), that breaks the rules on forming a type in
// view, and whether they all keep them.  The others are judged where their
// parameter occurs.
func unmentionedArgsFormed(c @Checker, args *[]@types.Type, abs @types.Type, owner *uint8,
		pos token.Pos, w *opaqueWalk, view int) bool {
	var none *opaqueFrame
	for i := 0; i < len(args); i++ {
		if argUnmentioned(abs, owner, i) && !formationRulesKept(c, args[i], pos, w, view, none) {
			return false
		}
	}
	return true
}

// judgeInView sets c to judge opaque types as a use in view v sees them, and
// returns the scope and package path to restore: a deferred check
// (recheckDeferredConstraints) may be replayed in a scope whose .bni-ness v does
// not share.
func judgeInView(c @Checker, v ImplView) (@Scope, @[]char) {
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = v.Pkg
	if v.Bni && !inBniView(c) {
		c.Scope = NewScope(c.Scope)
		c.Scope.InterfaceView = true
	}
	return savedScope, savedPkgPath
}

// requireIfaceInstanceArgsKept judges, at pos, the interface instance inst
// written in view v: the type arguments its methods never use as types written
// there, then the parts of its method signatures that come from its arguments
// (type.opaque.signature), walked as its generic declares them (its abstract
// instance) in viewNone, with a frame binding the generic's type parameters to
// inst's arguments; the generic's own parts were judged at its declaration.  It
// is made once the instances it reaches are built (deferUntilBuilt).  An
// instance written inside another instance (nestedInInstance) is judged with
// what holds it (funcSignaturesSized, requireAliasArgsKept,
// requireCallSigKept).
func requireIfaceInstanceArgsKept(c @Checker, inst @types.Type, pos token.Pos, v ImplView) {
	if inst == nil || inst.Kind != types.TYP_INTERFACE || nestedInInstance(c, v) { return }
	var later pendingCheck
	later.Kind = pendingIfaceArgs
	later.Inst = inst
	later.Pos = pos
	later.View = v
	if deferUntilBuilt(c, later) { return }
	var savedScope @Scope
	var savedPkgPath @[]char
	savedScope, savedPkgPath = judgeInView(c, v)
	var w opaqueWalk
	var abs @types.Type = abstractInstanceOf(c, inst)
	if unmentionedArgsFormed(c, inst.InstArgs, abs, inst.InstDecl, pos, &w, viewHere) {
		if abs == nil {
			var none *opaqueFrame
			_ = ifaceSignaturesKept(c, inst, pos, &w, viewHere, none)
		} else {
			var fr opaqueFrame
			fr.owner = inst.InstDecl
			fr.args = inst.InstArgs
			fr.argView = viewHere
			_ = ifaceSignaturesKept(c, abs, pos, &w, viewNone, &fr)
		}
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
}

// nestedInInstance reports whether a use in view v is written inside another
// instance — its structure, a generic alias's target or a generic call's
// signature, resolved with its type arguments bound (InstanceState.Bound) —
// rather than where c is checking: an instance's body binds its own arguments
// too (BodyDepth), so only a binding past those counts.  A deferred check whose
// view was taken inside an instance (v.All) outside a body is nested too.
func nestedInInstance(c @Checker, v ImplView) bool {
	var st @InstanceState = instanceState(c)
	return st.Bound > st.BodyDepth || v.All && st.BodyDepth == 0
}

// requireAliasArgsKept judges, at pos, a use in view v of the generic alias d
// with the type arguments args: the arguments d's target never uses as types
// written there, then the interface instances the target writes
// (aliasIfacesKept), walked as d declares its target, in viewNone with a frame
// binding d's type parameters to args.  The target is the type as if written at
// the use (gen.instantiate.alias), so the rest of it is judged by the walk of
// the type that holds the use.  A use written inside another instance
// (nestedInInstance) is judged with it.
func requireAliasArgsKept(c @Checker, d @ast.Decl, args @[]@types.Type, pos token.Pos, v ImplView) {
	if nestedInInstance(c, v) { return }
	var later pendingCheck
	later.Kind = pendingAliasArgs
	later.Decl = d
	later.Args = args
	later.Pos = pos
	later.View = v
	if deferUntilBuilt(c, later) { return }
	var owner *uint8 = bit_cast(*uint8, d)
	var abs @types.Type = abstractAliasTarget(c, d)
	var savedScope @Scope
	var savedPkgPath @[]char
	savedScope, savedPkgPath = judgeInView(c, v)
	var w opaqueWalk
	if unmentionedArgsFormed(c, args, abs, owner, pos, &w, viewHere) && abs != nil {
		var fr opaqueFrame
		fr.owner = owner
		fr.args = args
		fr.argView = viewHere
		_ = aliasIfacesKept(c, abs, pos, &w, &fr)
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
}

// aliasIfacesKept reports whether each generic interface instance that a
// generic alias's target t writes — as t itself, a pointee, an element, a
// field, an interface value's interface, or a function type's parameter or
// result, at any depth — keeps the opaque rules in the frame f
// (ifaceInstanceKept), reporting the first that does not at pos, including
// those in a struct instance's type arguments.  It stops at a type parameter,
// whose argument is judged as a type, and at a named type's structure: a struct
// instance's structure is judged by the walk of the type that holds the use.
func aliasIfacesKept(c @Checker, t @types.Type, pos token.Pos, w *opaqueWalk, f *opaqueFrame) bool {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS { t = t.Target } else { t = t.Elem }
	}
	if t == nil { return true }
	var k int = t.Kind
	if k == types.TYP_INTERFACE {
		return len(t.InstArgs) == 0 || ifaceInstanceKept(c, t, pos, w, viewNone, f)
	}
	if !w.enter(t, viewNone) { return true }
	if k == types.TYP_NAMED {
		for i := 0; i < len(t.InstArgs); i++ {
			if !aliasIfacesKept(c, t.InstArgs[i], pos, w, f) { return false }
		}
		return true
	}
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED {
		return aliasIfacesKept(c, t.Elem, pos, w, f)
	}
	if k == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if !aliasIfacesKept(c, t.Fields[i].Type, pos, w, f) { return false }
		}
	}
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(t.Params); i++ {
			if !aliasIfacesKept(c, t.Params[i].Type, pos, w, f) { return false }
		}
		for i := 0; i < len(t.Results); i++ {
			if !aliasIfacesKept(c, t.Results[i], pos, w, f) { return false }
		}
	}
	return true
}

// requireCallSigKept reports, at pos, each parameter or result of the call of
// the generic function ft with the type arguments args that breaks the opaque
// rules where the call is written, judging only the parts that come from args
// (ft's own were judged at its declaration): ft's parameters and results are
// walked as declared, in viewNone, with a frame binding its type parameters to
// args, judged in viewHere.  One that keeps them is held to the size limit as
// sig, ft's signature for args, has it, and so are the results together.
func requireCallSigKept(c @Checker, ft @types.Type, args @[]@types.Type, sig @types.Type,
		pos token.Pos) {
	var fr opaqueFrame
	if len(ft.TypeParams) > 0 { fr.owner = ft.TypeParams[0].TpOwner }
	fr.args = args
	fr.argView = viewHere
	var w opaqueWalk
	for i := 0; i < len(ft.Params) && i < len(sig.Params); i++ {
		if opaqueRulesKept(c, ft.Params[i].Type, pos, &w, viewNone, &fr) {
			_ = requireFitting(c, sig.Params[i].Type, pos)
		}
	}
	for i := 0; i < len(ft.Results) && i < len(sig.Results); i++ {
		if opaqueRulesKept(c, ft.Results[i], pos, &w, viewNone, &fr) {
			_ = requireFitting(c, sig.Results[i], pos)
		}
	}
	requireFittingResults(c, sig.Results, pos)
}
