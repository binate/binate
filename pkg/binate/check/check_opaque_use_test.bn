package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_opaque_use.bn: where an instance is written, its type
// arguments and the parts of it that come from them are judged there.  The
// library pkg/lib (instLibBni, instLibBn) and checkInstUser are in
// check_opaque_inst_test.bn.

// An interface instance's method signatures are judged where the instance is
// written: Get[lib.Box], whose get returns lib.Box by value, is ill-formed in q —
// written directly, and as the interface of a field of another generic's
// instance (S[lib.Box]) — while lib's own Get[Box] is not (Mine).
func TestCheckOpaqueIfaceInstanceArgView() testing.TestResult {
	var c @Checker = checkInstUser(
			"type V *lib.Get[lib.Box]\ntype S[T any] struct { g @lib.Get[T] }\ntype U S[lib.Box]\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 2 {
		return fail(buf.Concat("expected 2 errors, one per instance; got ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, "cannot use an opaque type by value") { return fail(errs[i].Msg) }
	}
	return ""
}

// A generic function's call is judged where it is written: lib.Id[lib.Box],
// whose parameter points to [2]lib.Box, is ill-formed in q, while lib's own
// Id[Box] is not (Mine).
func TestCheckOpaqueCallArgView() testing.TestResult {
	return errsIn(
			checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn), "package \"q\"\nfunc F() int\n",
					"package \"q\"\nimport \"pkg/lib\"\nfunc F() int { return lib.Id[lib.Box](nil) }\n", false),
			"cannot form a pointer to a type that embeds an opaque type by value")
}

// A generic alias's use is judged where it is written, its target as if written
// there: lib.GA[lib.Box] is @lib.Get[lib.Box], ill-formed in q — as a parameter,
// and as an interface method's parameter, which is resolved before every impl is
// known — and so is an alias use whose type argument is ill-formed though the
// target never uses it.
func TestCheckOpaqueAliasArgView() testing.TestResult {
	var errs @[]types.CheckError = checkInstUser(
			"type PBox[T any] struct { p *T }\ntype Ph2[T any] = int\n"
					"func f(g lib.GA[lib.Box]) { _ = g }\ninterface J { m(g lib.GA[lib.Box]) }\n"
					"type K Ph2[PBox[[2]lib.Box]]\n").CheckerErrors()
	if len(errs) != 3 {
		return fail(buf.Concat("expected 3 errors, one per use; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// A type argument is a type written where it is, held to the rules on forming a
// type whether or not the instance's structure uses it — in a type, at a call,
// and in a type-switch case or a type assertion's target.
func TestCheckOpaqueTypeArgsWritten() testing.TestResult {
	var errs @[]types.CheckError = checkInstUser(
			"type PBox[T any] struct { p *T }\ntype S[T any] struct { g @lib.Get[T] }\n"
					"type Ph[T any] struct { n int }\nfunc Z[T any]() int { return 0 }\n"
					"type W1 Ph[S[lib.Box]]\ntype W2 Ph[PBox[[2]lib.Box]]\n"
					"func g(v *any) int {\n\tswitch v.(type) {\n\tcase *S[lib.Box]:\n\t\treturn 1\n\t}\n"
					"\tif v.(*PBox[[2]lib.Box]) == nil {\n\t\treturn 2\n\t}\n"
					"\treturn Z[S[lib.Box]]() + Z[PBox[[2]lib.Box]]()\n}\n").CheckerErrors()
	if len(errs) != 6 {
		return fail(buf.Concat("expected 6 errors, one per written type; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// An alias target's interface instance inside a struct instance's type
// arguments is judged at the use; an alias argument the target uses is
// reported once, by the walk of the type holding the use, not again at the use.
func TestCheckOpaqueAliasTargetArgs() testing.TestResult {
	var c @Checker = checkInstUser(
			"type Holder[H any] struct { v H }\ntype L[Q any] = Holder[@lib.Get[Q]]\n"
					"type P[T any] = @[]T\nfunc f(x *L[lib.Box]) { _ = x }\nfunc h(x P[*([2]lib.Box)]) {}\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 2 {
		return fail(buf.Concat("expected 2 errors, one per use; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// In an instance's body an alias argument the target never uses is judged too,
// counting only a type with no definition anywhere as opaque.
func TestCheckOpaqueAliasArgInBody() testing.TestResult {
	return errsIn(
			checkSrc(
					"package \"test\"\ntype Fwd\ntype Q[T any] = @[]int\n"
							"func F[T any]() int {\n\tvar q Q[*([2]T)]\n\t_ = q\n\treturn 0\n}\n"
							"func g() int { return F[Fwd]() }\n"),
			"cannot form a pointer to a type that embeds an opaque type by value")
}

// Nested type arguments are walked once each, not once per level above them:
// forty levels of Box[Box[...]] check at once.
func TestCheckOpaqueNestedArgsWalkedOnce() testing.TestResult {
	var ty @[]char = buf.CopyStr("int")
	for i := 0; i < 40; i++ { ty = buf.Concat(buf.Concat("Box[", ty), "]") }
	var src @[]char = buf.Concat("package \"test\"\ntype Box[T any] struct { v T }\nvar x ", ty)
	return expectNoErrors(checkSrc(buf.Concat(src, "\n")))
}

// An interface instance over the instantiating package's own opaque export is
// judged where it is written: q's .bn, where Op is not opaque, may hold a
// *lib.Get[Op], though Get's `get` returns its T by value.
func TestCheckOpaqueIfaceInstanceOwnExportOk() testing.TestResult {
	return expectNoErrors(
			checkBniMethodPkgIn(checkerWithLib(instLibBni, instLibBn),
					"package \"q\"\ntype Op\nfunc F() int\n",
					"package \"q\"\nimport \"pkg/lib\"\ntype Op struct { v int }\n"
							"func F() int {\n\tvar g *lib.Get[Op]\n\t_ = g\n\treturn 0\n}\n",
					false))
}

// An interface instance in an instance's body is judged once: an instance of S
// written in the body holds Get[T] in its own structure, which the body's walk
// of S judges — not again where S's field is written.
func TestCheckOpaqueIfaceInBodyReportedOnce() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] { get() T }\n"
					"type S[T any] struct { g *Get[T] }\n"
					"func F[T any]() int {\n\tvar s *S[T]\n\t_ = s\n\treturn 0\n}\n"
					"func h() int { return F[Fwd]() }\n").CheckerErrors()
	if len(errs) != 1 {
		return fail(buf.Concat("expected 1 error, in F[Fwd]'s body; got ", strconv.Itoa(len(errs))))
	}
	return ""
}

// An interface instance written in an instance's body is judged there whatever
// else instantiated it first: S[Fwd]'s structure instantiates Get[Fwd] before
// F[Fwd]'s body writes Get[T].
func TestCheckOpaqueIfaceInBodyAfterStructure() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] { get() T }\n"
					"type S[T any] struct { g *Get[T] }\n"
					"func F[T any]() int {\n\tvar g *Get[T]\n\t_ = g\n\treturn 0\n}\n"
					"func h() int {\n\tvar s *S[Fwd]\n\t_ = s\n\treturn F[Fwd]()\n}\n").CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "in F[Fwd]") { return "" }
	}
	return fail("F[Fwd]'s body should be reported")
}

// A generic alias's use in an instance's body is judged at the use, its target
// as if written there.
func TestCheckOpaqueAliasInBodyAtUse() testing.TestResult {
	var errs @[]types.CheckError = checkSrc(
			"package \"test\"\ntype Fwd\ninterface Get[T any] { get() T }\ntype L[T any] = *Get[T]\n"
					"func F[T any]() int {\n\tvar l L[T]\n\t_ = l\n\treturn 0\n}\n"
					"func h() int { return F[Fwd]() }\n").CheckerErrors()
	if len(errs) != 1 || errs[0].Pos.Line != 6 {
		return fail(buf.Concat("expected 1 error, at the use on line 6; got ", strconv.Itoa(len(errs))))
	}
	return ""
}
