package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the predeclared `panic` (builtin.predeclared, builtin.panic): the
// checker marks an identifier that resolves to it (checkIdent), checks a direct
// call's arity and argument (checkCallExpr), and types it as a value.

// parsePanicSrc parses src as a file, for a test that inspects the checked AST.
func parsePanicSrc(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	return p.ParseFile()
}

// firstMainCallee returns the callee of main's first expression statement.
func firstMainCallee(f @ast.File) @ast.Expr {
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if d.Kind == ast.DECL_FUNC && d.Body != nil && types.CharEq(d.Name, "main") {
			return d.Body.Stmts[0].X.X
		}
	}
	return nil
}

// A direct call of `panic` marks its callee; a call through a parameter of that
// name does not.
func TestPanicCalleeMarked() testing.TestResult {
	var f @ast.File = parsePanicSrc("package \"test\"\nfunc main() { panic(\"x\") }\n")
	var c @Checker = NewChecker()
	c.Check(f)
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var callee @ast.Expr = firstMainCallee(f)
	if callee == nil || !callee.PredeclaredPanic { return fail("panic's callee should be marked") }
	var g @ast.File = parsePanicSrc(
			"package \"test\"\n"
					"func main() { h(nil) }\n"
					"func h(panic @func(*[]readonly char)) { panic(\"x\") }\n")
	var c2 @Checker = NewChecker()
	c2.Check(g)
	r = expectNoErrors(c2)
	if len(r) > 0 { return r }
	var hd @ast.Decl = g.Decls[1]
	if hd.Body.Stmts[0].X.X.PredeclaredPanic {
		return fail("a shadowing parameter should not be marked")
	}
	return ""
}

// panic's one argument is checked like any call's: a non-string is rejected.
func TestPanicArgumentType() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc main() { panic(42) }\n")
	return expectOneErr(c, "cannot assign untyped int to *[]readonly uint8")
}

// A direct call with another arity reports panic's own error, once.
func TestPanicArity() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc main() { panic(\"a\", \"b\") }\n")
	var r testing.TestResult = expectOneErr(c, "panic takes exactly one argument")
	if len(r) > 0 { return r }
	c = checkSrc("package \"test\"\nfunc main() { panic() }\n")
	return expectOneErr(c, "panic takes exactly one argument")
}

// A spread into the predeclared panic names it; into a shadowing non-variadic
// function, the ordinary error.
func TestPanicSpread() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func main() { var m *[]int\n panic(m...) }\n")
	var r testing.TestResult = expectErrSub(c, "cannot spread into panic")
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\n"
					"func main() { var m *[]int\n panic := say\n panic(m...) }\n"
					"func say(s *[]readonly char) { }\n")
	return expectErrSub(c, "cannot spread into non-variadic function")
}

// As a value, panic is a function of its signature: it binds to a matching
// function-value type, and not to another.
func TestPanicAsValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func main() { var f = panic\n var g *func(*[]readonly char) = panic\n"
					" f(\"a\")\n g(\"b\") }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrc("package \"test\"\nfunc main() { var h *func() = panic\n h() }\n")
	return expectErrSub(c, "cannot assign")
}

// A re-check of the same identifier (a REPL declaration retried after a later
// one) sets the mark from the binding it resolves to now.
func TestPanicMarkRecheck() testing.TestResult {
	var c @Checker = NewChecker()
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Name = "panic"
	checkIdent(c, e)
	if !e.PredeclaredPanic { return fail("panic should be marked") }
	var params @[]@types.Param
	var results @[]@types.Type
	var s @Scope = NewScope(c.Scope)
	defineFunc(s, "panic", types.MakeFuncType(params, results))
	c.Scope = s
	checkIdent(c, e)
	if e.PredeclaredPanic {
		return fail("a re-check resolving to a shadowing panic should clear the mark")
	}
	return ""
}

// A package variable named `panic` shadows the predeclared one also where an
// earlier initializer reads it, before the variable is defined.
func TestPanicLaterPackageVarShadows() testing.TestResult {
	var f @ast.File = parsePanicSrc(
			"package \"test\"\n"
					"var y = panic\n"
					"var panic = say\n"
					"func say(s *[]readonly char) { }\n")
	var c @Checker = NewChecker()
	c.Check(f)
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if f.Decls[0].Value == nil || f.Decls[0].Value.PredeclaredPanic {
		return fail("y's initializer should read the package variable, not the predeclared panic")
	}
	return ""
}
