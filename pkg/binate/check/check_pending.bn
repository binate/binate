package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// REPL forward references.  A declaration typed at the prompt is checked
// with errors and unbound names captured (TentativeMode).  One that uses
// names not yet declared PARKS: everything its check bound is undone, so it
// binds nothing, and it is kept on c.Pending with the names it is missing.
// A use of a parked declaration is therefore a use of an unbound name — in
// another declaration it parks that one too; in a statement at the prompt it
// reports the parked declaration as unresolved.  RetryPendingDecls
// (check_pending_retry.bn) checks the parked declarations again once the
// names they miss are declared.
//
// A missing name is the name a declaration binds, `T.M` for a method M of a
// named type T of the session, or `T:I` for an impl of interface I for T
// (pendingKey / pendingKeys).  A parked declaration also records the names of
// the session its check found bound (PendingDecl.UsedNames): a parked
// redefinition of one is checked with it, so it sees the new definition however
// the declarations parked — unless the redefinition replaces the old definition,
// which what uses the name reaches anyway.  A declaration that misses nothing
// but uses a name a parked declaration so redefines parks too, waiting for it.

// migrateTentativeErrors moves any errors captured in
// TentativeMode from c.TentativeErrors into c.Errors, then
// clears TentativeErrors.  Called when no missing names were
// captured — meaning the errors are genuinely the user's, not
// cascade noise from forward refs.
func migrateTentativeErrors(c @Checker) {
	for i := 0; i < len(c.TentativeErrors); i++ {
		c.Errors = appendUniqueCheckError(c.Errors, c.DedupFrom, c.TentativeErrors[i])
	}
	var emptyTentErrs @[]types.CheckError
	c.TentativeErrors = emptyTentErrs
}

// parkPendingDecl appends a {decl, missing-names, used-names} record to
// c.Pending, marked when d replaces the definition it redefines
// (PendingDecl.Replaces).  For a member of a const group, use
// parkPendingDeclMember instead so the iota position survives across the park /
// retry cycle.
func parkPendingDecl(c @Checker, d @ast.Decl, missing @[]@[]char, used @[]@[]char, replaces bool) {
	parkPendingDeclMember(c, d, missing, used, replaces, -1)
}

// parkPendingDeclMember is the variant that records IotaIdx —
// the parked decl's position within its containing const group.
// Free top-level decls pass -1; group members pass their
// 0-based index.  RetryPendingDecls restores c.Iota from
// IotaIdx before re-running checkConstDecl so the same iota
// value is used at retry time as would have been at the
// original definition time.
func parkPendingDeclMember(c @Checker, d @ast.Decl, missing @[]@[]char, used @[]@[]char,
		replaces bool, iotaIdx int) {
	var pd @types.PendingDecl = make(types.PendingDecl)
	pd.Decl = d
	pd.MissingNames = missing
	pd.UsedNames = used
	pd.Replaces = replaces
	pd.IotaIdx = iotaIdx
	c.Pending = slices.Append[@types.PendingDecl](c.Pending, pd)
}

// captureMissing records key as a name the declaration being checked is
// missing, once — not in a layout frame that waits, which is done again
// (layoutFrameBlocked).
func captureMissing(c @Checker, key *[]readonly char) {
	if containsName(c.TentativeMissing, key) || layoutFrameBlocked(c) { return }
	c.TentativeMissing = slices.Append[@[]char](c.TentativeMissing, buf.CopyStr(key))
}

// recordingUses reports whether the names of the session a check uses are
// recorded (noteUse): while REPL declarations are checked tentatively, and while
// the generic instances they name are checked as part of that
// (InstanceState.RecordUses) — not an existing body of an existing instance
// checked again for a method the declarations add (InstWork.Requeued), which is
// existing code.
func recordingUses(c @Checker) bool {
	if c.TentativeMode { return true }
	var st @InstanceState = c.Instances
	return st != nil && st.RecordUses && (st.Current == nil || !st.Current.Requeued || st.BodyIsNew)
}

// noteNameUse records name, when recordingUses, as a name of the session the
// check uses, when sym — what the name was found to be — is the session's
// package-level binding of it (not a local, nor a predeclared binding), and not a
// type or an interface: those are never redefined (a later definition of a
// forward-declared type fills it in), so a use of one waits for nothing.
func noteNameUse(c @Checker, name *[]readonly char, sym @Symbol) {
	if !recordingUses(c) || sym == nil || c.PackageScope == nil { return }
	if sym.Kind == types.SYM_TYPE || sym.Kind == types.SYM_INTERFACE { return }
	if same(c.PackageScope.LookupLocal(name), sym) { noteUse(c, name) }
}

// noteMethodUse records `T.M`, when recordingUses, as a name the check uses, for
// a method M (name) of named type named when named is a named type of the
// session (sessionTypeName).
func noteMethodUse(c @Checker, named @types.Type, name *[]readonly char) {
	if !recordingUses(c) { return }
	var tn @[]char = sessionTypeName(c, named)
	if len(tn) > 0 { noteUse(c, memberKey(tn, name)) }
}

// noteUse records key, when recordingUses, as a name of the session the check
// uses (c.TentativeUses), once.
func noteUse(c @Checker, key *[]readonly char) {
	if !recordingUses(c) || containsName(c.TentativeUses, key) { return }
	c.TentativeUses = slices.Append[@[]char](c.TentativeUses, buf.CopyStr(key))
}

// pendingNames returns what parked declaration pd waits for: each name it
// misses that is still unbound, or that a parked declaration it waits for
// provides (waitedProvider), then the redefinitions it waits for — the names it
// uses that are bound and that such a declaration provides.
func pendingNames(c @Checker, pd @types.PendingDecl) @[]@[]char {
	var names @[]@[]char
	for i := 0; i < len(pd.MissingNames); i++ {
		var key @[]char = pd.MissingNames[i]
		if !keyBound(c, key) || waitedProvider(c, pd, key) { names = appendKey(names, key) }
	}
	for i := 0; i < len(pd.UsedNames); i++ {
		var key @[]char = pd.UsedNames[i]
		if keyBound(c, key) && waitedProvider(c, pd, key) { names = appendKey(names, key) }
	}
	return names
}

// waitedProvider reports whether a parked declaration other than pd provides
// key, and does not replace the definition key names (PendingDecl.Replaces): pd
// waits for it.
func waitedProvider(c @Checker, pd @types.PendingDecl, key *[]readonly char) bool {
	var p @types.PendingDecl = lookupPending(c, key)
	return p != nil && !p.Replaces && !same(p, pd) && !providesKey(c, pd.Decl, key)
}

// usesParkedRedefinition reports whether a parked declaration that redefines
// one of keys, names declaration d's check found bound, without replacing it
// (PendingDecl.Replaces) is waited for by d — one d itself redefines (for a
// group, any member of it), which d supersedes on the parked list, is not.
func usesParkedRedefinition(c @Checker, keys *[]@[]char, d @ast.Decl) bool {
	if len(keys) == 0 { return false }
	var own @[]@[]char
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			own = appendKeys(own, directKeys(c, d.Decls[i]))
		}
	} else {
		own = directKeys(c, d)
	}
	for i := 0; i < len(c.Pending); i++ {
		var p @types.PendingDecl = c.Pending[i]
		if p.Replaces || keysOverlap(directKeys(c, p.Decl), own) { continue }
		for j := 0; j < len(keys); j++ {
			if providesKey(c, p.Decl, keys[j]) { return true }
		}
	}
	return false
}

// declReplaces reports whether d, just checked tentatively (snap taken before),
// redefines a name with the same signature or type — a function or method of
// the old signature (SameFuncSignature, as the REPL compares them), a variable of
// the old type — so that the REPL replaces the old definition, and what uses the
// name reaches the new one once it resolves.  A signature or type that does not
// resolve yet is not the old one.
func declReplaces(c @Checker, d @ast.Decl, snap @DeclRollback) bool {
	if d.Kind == ast.DECL_FUNC {
		var prev @types.Type = prevFuncType(snap)
		if prev == nil { return false }
		var now @types.Type
		if d.Recv != nil {
			var m @types.Method = c.LookupMethodForDecl(d)
			if m != nil { now = m.FuncType }
		} else {
			var sym @Symbol = c.Scope.Lookup(d.Name)
			if sym != nil { now = sym.Type }
		}
		return now != nil && c.SameFuncSignature(prev, now)
	}
	if d.Kind == ast.DECL_VAR {
		var prev @types.Type = prevVarType(snap)
		if prev == nil { return false }
		var sym @Symbol = c.Scope.Lookup(d.Name)
		return sym != nil && sym.Kind == types.SYM_VAR && prev.Identical(sym.Type)
	}
	return false
}

// PendingNames returns what parked declaration pd waits for (pendingNames).
func (c @Checker) PendingNames(pd @types.PendingDecl) @[]@[]char {
	return pendingNames(c, pd)
}

// pendingKey returns the main key a parked d provides to the declarations
// waiting on it, as written: the name it binds, `T.M` for a method M of named
// type T, or `T:I` for an impl of its first interface I for T (pendingKeys has
// them all, resolved).
// Empty when it binds nothing a use can name (a blank declaration, a method
// or impl whose receiver names no type).
func pendingKey(d @ast.Decl) @[]char {
	if d.Kind == ast.DECL_IMPL {
		var recv @[]char = typeExprBaseName(d.TypeRef)
		if len(recv) == 0 || len(d.Interfaces) == 0 { return "" }
		return implKey(recv, typeExprBaseName(d.Interfaces[0]))
	}
	if d.Kind == ast.DECL_FUNC && d.Recv != nil {
		var base @[]char = recvBaseName(d)
		if len(base) == 0 { return "" }
		return memberKey(base, d.Name)
	}
	if isBlank(d.Name) { return "" }
	return d.Name
}

// memberKey returns the missing-name key `T.M` for method M of named type T.
func memberKey(typeName *[]readonly char, method *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(typeName)
	cb.Write(".")
	cb.Write(method)
	return buf.CopyStr(cb.String())
}

// recvBaseName returns the name of the named type a method's receiver is
// (a pointer / managed-pointer / const / parenthesized wrapper of, or — for
// a generic type — an instantiation of), or empty.
func recvBaseName(d @ast.Decl) @[]char {
	var rb @ast.TypeExpr = d.Recv.Type
	for rb != nil &&
			(rb.Kind == ast.TEXPR_POINTER || rb.Kind == ast.TEXPR_MANAGED || rb.Kind == ast.TEXPR_CONST ||
					rb.Kind == ast.TEXPR_PAREN) {
		rb = rb.Base
	}
	if rb != nil && rb.Kind == ast.TEXPR_INSTANTIATE {
		rb = rb.Base
	}
	if rb == nil || rb.Kind != ast.TEXPR_NAMED || len(rb.Pkg) > 0 { return "" }
	return rb.Name
}

// IsDeclPending reports whether the most recent
// CheckDeclInScope call parked any decl.  For DECL_FUNC /
// DECL_VAR / DECL_CONST this is one decl; for DECL_GROUP it
// may be zero or more (per-member parking).  Tracked via c.PendingMark,
// the snapshot of len(c.Pending) at CheckDeclInScope entry.
// REPL driver gate for "skip IR-gen, print parked-message(s)";
// driver also walks Pending[PendingMark:] to enumerate which
// specific decls parked.
func (c @Checker) IsDeclPending() bool {
	return len(c.Pending) > c.PendingMark
}

// IsPendingDecl reports whether a parked declaration provides key — a name,
// `T.M` for a method, `T:I` for an impl (pendingKeys).
func (c @Checker) IsPendingDecl(key *[]readonly char) bool {
	return lookupPending(c, key) != nil
}

// lookupPending returns the parked declaration providing key (pendingKey),
// or nil.  A declaration that resolves or parks replaces any older parked
// one of its key (dropSupersededPending), so there is at most one.
func lookupPending(c @Checker, key *[]readonly char) @types.PendingDecl {
	if len(key) == 0 { return nil }
	for i := 0; i < len(c.Pending); i++ {
		if providesKey(c, c.Pending[i].Decl, key) {
			return c.Pending[i]
		}
	}
	return nil
}

// errPendingDecl reports a use, at the prompt, of the parked declaration
// providing key: "function f is unresolved (pending: g, h)" with what it
// waits for (pendingNames), or "... (it does not check)" once they are declared but
// it fails, or "... (it does not load)" when it checks but its host cannot
// load it (PendingDecl.LoadErrs).  The noun follows the declaration's kind; an impl is shown as
// written ("impl *Box : Sizer is unresolved …").
func errPendingDecl(c @Checker, pos token.Pos, key *[]readonly char) {
	var pd @types.PendingDecl = lookupPending(c, key)
	var cb @strings.Builder = strings.NewBuilder()
	if pd != nil && pd.Decl.Kind == ast.DECL_IMPL {
		cb.Write(ImplLabel(pd.Decl))
	} else {
		cb.Write(pendingDeclKindNoun(pd))
		cb.Write(" ")
		cb.Write(key)
	}
	if pd != nil && len(pd.LoadErrs) > 0 {
		cb.Write(" is unresolved (it does not load)")
	} else if pd != nil && pd.Failed {
		cb.Write(" is unresolved (it does not check)")
	} else {
		cb.Write(" is unresolved (pending: ")
		if pd != nil {
			var names @[]@[]char = pendingNames(c, pd)
			for i := 0; i < len(names); i++ {
				if i > 0 { cb.Write(", ") }
				cb.Write(names[i])
			}
		}
		cb.Write(")")
	}
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// pendingDeclKindNoun returns the user-facing noun for a parked declaration's
// kind ("function" / "method" / "variable" / "constant" / "type" /
// "interface" / "impl").
func pendingDeclKindNoun(pd @types.PendingDecl) @[]char {
	if pd != nil {
		if pd.Decl.Kind == ast.DECL_INTERFACE { return "interface" }
		if pd.Decl.Kind == ast.DECL_IMPL { return "impl" }
		if pd.Decl.Kind == ast.DECL_VAR { return "variable" }
		if pd.Decl.Kind == ast.DECL_CONST { return "constant" }
		if pd.Decl.Kind == ast.DECL_TYPE { return "type" }
		if pd.Decl.Recv != nil { return "method" }
	}
	return "function"
}

// isParkableKind reports whether a declaration of this kind is checked with
// its unbound names captured, and so may park.  A DECL_GROUP is checked
// member by member (checkGroupDeclTentative).
func isParkableKind(kind int) bool {
	return kind == ast.DECL_FUNC || kind == ast.DECL_VAR || kind == ast.DECL_CONST ||
			kind == ast.DECL_TYPE || kind == ast.DECL_INTERFACE || kind == ast.DECL_IMPL
}

// dropSupersededPending removes the parked declarations d replaces — those
// parked before this prompt (c.Pending[:c.PendingMark]) sharing a direct key
// with d (directKeys; a const group: each member's) — once d has resolved or
// parked.  Otherwise a stale parked declaration, retried later, would
// rebind its name over d's.  A forward type declaration replaces no parked
// definition of its name (forwardDeclKeepsDefinition).
func dropSupersededPending(c @Checker, d @ast.Decl) {
	var keys @[]@[]char
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			keys = appendKeys(keys, directKeys(c, d.Decls[i]))
		}
	} else {
		keys = directKeys(c, d)
	}
	var kept @[]@types.PendingDecl
	var dropped int = 0
	for i := 0; i < len(c.Pending); i++ {
		if i < c.PendingMark && keysOverlap(directKeys(c, c.Pending[i].Decl), keys) &&
				!forwardDeclKeepsDefinition(d, c.Pending[i].Decl) {
			dropped = dropped + 1
			continue
		}
		kept = slices.Append[@types.PendingDecl](kept, c.Pending[i])
	}
	c.Pending = kept
	c.PendingMark = c.PendingMark - dropped
}

// forwardDeclKeepsDefinition reports whether d, a forward type declaration
// (`type F`), leaves parked the definition p of its name (`type F Y`, waiting on
// Y): d declares the type p defines, so p, retried once what it waits on is
// declared, fills it in as any later definition of a forward-declared type does.
// Dropped, the definition would be lost without a word, and F stay opaque.
func forwardDeclKeepsDefinition(d @ast.Decl, p @ast.Decl) bool {
	return d.Kind == ast.DECL_TYPE && d.IsForward && p.Kind == ast.DECL_TYPE && !p.IsForward
}

// appendKeys appends each of more to keys, once.
func appendKeys(keys @[]@[]char, more @[]@[]char) @[]@[]char {
	for i := 0; i < len(more); i++ {
		keys = appendKey(keys, more[i])
	}
	return keys
}

// keysOverlap reports whether a and b share a key.
func keysOverlap(a *[]@[]char, b @[]@[]char) bool {
	for i := 0; i < len(a); i++ {
		if containsName(b, a[i]) { return true }
	}
	return false
}

// noteMissingMethod handles a selector name that is neither a field nor a
// method of base.  A method may still be declared for a named type of the
// session, so in TentativeMode the miss is a forward reference, captured as
// `T.M`; at the prompt, a parked method `T.M` is reported unresolved.
// Reports whether it handled the miss (otherwise the caller reports it).
func noteMissingMethod(c @Checker, pos token.Pos, base @types.Type, name *[]readonly char) bool {
	var tn @[]char = sessionTypeName(c, base)
	if len(tn) == 0 { return false }
	var key @[]char = memberKey(tn, name)
	if c.TentativeMode {
		captureMissing(c, key)
		return true
	}
	if lookupPending(c, key) != nil {
		errPendingDecl(c, pos, key)
		return true
	}
	return false
}

// sessionTypeName returns t's name when t is a named type declared in the
// package being checked and still bound to that name — for an instantiation
// of such a generic type, the generic type's name (its methods are the
// generic type's) — or empty.
func sessionTypeName(c @Checker, t @types.Type) @[]char {
	if t != nil && t.InstDecl != nil {
		var gd @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
		if same(lookupGenericTypeDeclPkg(c, "", gd.Name), gd) {
			return gd.Name
		}
		return ""
	}
	if t == nil || t.Kind != types.TYP_NAMED || !types.CharEq(t.Pkg, c.curPkgPath) ||
			c.PackageScope == nil {
		return ""
	}
	var sym @Symbol = c.PackageScope.LookupLocal(t.Name)
	if sym == nil || sym.Kind != types.SYM_TYPE || !same(sym.Type, t) { return "" }
	return t.Name
}
