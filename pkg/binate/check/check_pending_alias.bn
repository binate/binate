package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Pending aliases: within a declaration batch (collectDecls, or one `.bni`
// scope build) a type alias (`type A = T`) or an interface alias
// (`interface X = Y`) is resolved on demand — when a type expression of the
// batch's own package names it before its declaration is reached
// (resolveNamedTypeExpr) — so an alias may be named, even by another alias,
// before it is declared (decl.order.forward).  Its declaration, reached later
// in order, is then skipped.  An alias named again while its own target is
// being resolved is a cycle.  A name bound by something closer — a type
// parameter, a local — or code of another package (a generic instantiated from
// this batch) never triggers it, and the alias always resolves under the
// batch's own scope.

// ALIAS_PENDING marks a pending alias whose declaration is not yet resolved.
const ALIAS_PENDING int = 0

// ALIAS_RESOLVING marks a pending alias whose target is being resolved.
const ALIAS_RESOLVING int = 1

// ALIAS_DONE marks a pending alias whose declaration is resolved.
const ALIAS_DONE int = 2

// PendingAliases is the pending-alias registry of one declaration batch: the
// alias decls (Decls, with their ALIAS_* States, and for a type alias the
// placeholder Type preRegisterTypeNames / the `.bni` Pass 1 bound its name to —
// nil for an interface alias, which has none), the batch's package (PkgPath)
// and scope (Scope), and for a `.bni` scope build the package scope the
// declarations populate (BniScope; nil for collectDecls).
type PendingAliases struct {
	Decls        @[]@ast.Decl
	States       @[]int
	Placeholders @[]@types.Type
	PkgPath      @[]char
	Scope        @Scope
	BniScope     @Scope
}

// beginPendingAliases installs a fresh registry holding decls' type and
// interface aliases (non-generic; groups included) and returns the previous one
// for endPendingAliases.  bniScope is the `.bni` package scope, or nil.
func beginPendingAliases(c @Checker, decls *[]@ast.Decl, bniScope @Scope) @PendingAliases {
	var saved @PendingAliases = c.PendingAliases
	var reg @PendingAliases = make(PendingAliases)
	reg.BniScope = bniScope
	reg.PkgPath = buf.CopyStr(c.curPkgPath)
	reg.Scope = c.Scope
	collectPendingAliases(reg, decls)
	for i := 0; i < len(reg.Decls); i++ {
		var ph @types.Type
		if reg.Decls[i].Kind == ast.DECL_TYPE {
			var sym @Symbol = c.Scope.Lookup(reg.Decls[i].Name)
			if sym != nil { ph = sym.Type }
		}
		reg.Placeholders = slices.Append[@types.Type](reg.Placeholders, ph)
	}
	c.PendingAliases = reg
	return saved
}

// collectPendingAliases records decls' alias declarations in reg.
func collectPendingAliases(reg @PendingAliases, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			collectPendingAliases(reg, d.Decls)
			continue
		}
		if !d.IsAlias || len(d.TypeParams) > 0 { continue }
		if d.Kind != ast.DECL_TYPE && d.Kind != ast.DECL_INTERFACE { continue }
		// A blank `type _ = …` / `interface _ = …` binds no name, so no reference
		// can reach it.
		if isBlank(d.Name) { continue }
		reg.Decls = slices.Append[@ast.Decl](reg.Decls, d)
		reg.States = slices.Append[int](reg.States, ALIAS_PENDING)
	}
}

// endPendingAliases restores the registry beginPendingAliases replaced.
func endPendingAliases(c @Checker, saved @PendingAliases) {
	c.PendingAliases = saved
}

// pendingAliasIdx returns the index of the pending alias declaring name, or -1.
func pendingAliasIdx(c @Checker, name *[]readonly char) int {
	var reg @PendingAliases = c.PendingAliases
	if reg == nil { return -1 }
	for i := 0; i < len(reg.Decls); i++ {
		if types.CharEq(reg.Decls[i].Name, name) { return i }
	}
	return -1
}

// pendingAliasDeclIdx returns the index of the pending alias d, or -1.
func pendingAliasDeclIdx(c @Checker, d @ast.Decl) int {
	var reg @PendingAliases = c.PendingAliases
	if reg == nil { return -1 }
	for i := 0; i < len(reg.Decls); i++ {
		if same(reg.Decls[i], d) { return i }
	}
	return -1
}

// beginAliasDecl is called by an alias declaration's resolver: it reports
// whether to resolve d (false when d was already resolved on demand) and marks
// d as resolving.  An alias outside the registry is always resolved.
func beginAliasDecl(c @Checker, d @ast.Decl) bool {
	var i int = pendingAliasDeclIdx(c, d)
	if i < 0 { return true }
	if c.PendingAliases.States[i] == ALIAS_DONE { return false }
	c.PendingAliases.States[i] = ALIAS_RESOLVING
	return true
}

// endAliasDecl marks the alias d as resolved.
func endAliasDecl(c @Checker, d @ast.Decl) {
	var i int = pendingAliasDeclIdx(c, d)
	if i >= 0 { c.PendingAliases.States[i] = ALIAS_DONE }
}

// resolvePendingAliasNamed resolves, on demand, the pending alias a bare type
// name refers to, before the caller looks the name up.  It returns false — after
// reporting the cycle — when the name is an alias whose own target is being
// resolved.
func resolvePendingAliasNamed(c @Checker, te @ast.TypeExpr) bool {
	var i int = pendingAliasIdx(c, te.Name)
	if i < 0 { return true }
	var reg @PendingAliases = c.PendingAliases
	if reg.States[i] == ALIAS_DONE { return true }
	// Only the batch's own package, and only where the name still reaches the
	// alias's own binding (its placeholder; for an interface alias, nothing).
	if !types.CharEq(c.curPkgPath, reg.PkgPath) { return true }
	var bound @Symbol = c.Scope.Lookup(te.Name)
	if reg.Decls[i].Kind == ast.DECL_TYPE {
		if bound == nil || bound.Type != reg.Placeholders[i] { return true }
	} else if bound != nil {
		return true
	}
	if reg.States[i] == ALIAS_RESOLVING {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("invalid recursive type alias ")
		cb.Write(te.Name)
		addCheckError(c, te.Pos, buf.CopyStr(cb.String()))
		return false
	}
	var d @ast.Decl = reg.Decls[i]
	var savedScope @Scope = c.Scope
	c.Scope = reg.Scope
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, d.Pos.File)
	}
	if reg.BniScope != nil {
		if d.Kind == ast.DECL_TYPE {
			resolveTypeDeclInScope(c, reg.BniScope, d)
		} else {
			resolveInterfaceDeclInScope(c, reg.BniScope, d)
		}
	} else if d.Kind == ast.DECL_TYPE {
		collectTypeDecl(c, d)
	} else {
		collectInterfaceDecl(c, d)
	}
	c.Scope = savedScope
	return true
}
