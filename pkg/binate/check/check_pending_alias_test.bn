package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_pending_alias.bn: an alias named before its declaration
// resolves on demand; an alias cycle is reported.

// A type alias may name a later alias, and a field / const be typed through
// one.
func TestPendingAliasForwardChain() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type A = B\n")
	cb.Write("type B = C\n")
	cb.Write("type C int\n")
	cb.Write("type S struct { f F }\n")
	cb.Write("type F = int\n")
	cb.Write("const K F = 3\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// An interface alias may be named before its declaration.
func TestPendingAliasForwardIface() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func f(x *X) {}\n")
	cb.Write("interface X = Y\n")
	cb.Write("interface Y { y() int }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Aliases naming each other are a cycle.
func TestPendingAliasCycle() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type A = B\n")
	cb.Write("type B = A\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectErrSub(c, "invalid recursive type alias")
}

// In a .bni, a type alias naming a later alias resolves to the final target.
func TestPendingAliasBniForwardChain() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\ntype A = B\ntype B = int\n")
	c.LoadPackageInterface("foo", f)
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("package scope for foo not found") }
	var sym @Symbol = pkgScope.Lookup("A")
	if sym == nil || sym.Type == nil { return fail("A not in foo's scope") }
	var t @types.Type = sym.Type
	for t != nil && t.Kind == types.TYP_ALIAS {
		t = t.Target
	}
	if t == nil || t.Kind != types.TYP_INT { return fail("A should resolve to int") }
	return ""
}
