package "pkg/binate/check"

import "pkg/stdx/slices"

// pendingGroups partitions c.Pending into the strongly connected groups of
// the graph with an edge from each parked declaration to the parked
// declarations providing a name it misses (pendingKeys), and returns them in
// dependency order: a group comes after every group it reaches.  Each group
// lists indices into c.Pending, ascending (the order they parked).
func pendingGroups(c @Checker) @[]@[]int {
	var n int = len(c.Pending)
	var s @sccState = make(sccState)
	s.Keys = make_slice(@[]@[]char, n)
	s.Index = make_slice(int, n)
	s.Low = make_slice(int, n)
	s.OnStack = make_slice(bool, n)
	for i := 0; i < n; i++ {
		s.Keys[i] = pendingKeys(c, c.Pending[i].Decl)
		s.Index[i] = -1
	}
	for i := 0; i < n; i++ {
		if s.Index[i] < 0 {
			sccVisit(c, s, i)
		}
	}
	return s.Groups
}

// sccState is the working state of Tarjan's strongly-connected-components
// walk over the parked declarations (pendingGroups).
type sccState struct {
	Keys    @[]@[]@[]char
	Index   @[]int
	Low     @[]int
	OnStack @[]bool
	Stack   @[]int
	Next    int
	Groups  @[]@[]int
}

// sccVisit is Tarjan's visit of parked declaration v: a group is complete,
// and appended to s.Groups, when the walk returns to its first-visited
// member, after every group it reaches.
func sccVisit(c @Checker, s @sccState, v int) {
	s.Index[v] = s.Next
	s.Low[v] = s.Next
	s.Next = s.Next + 1
	s.Stack = slices.Append[int](s.Stack, v)
	s.OnStack[v] = true
	var missing @[]@[]char = c.Pending[v].MissingNames
	for i := 0; i < len(missing); i++ {
		for w := 0; w < len(s.Keys); w++ {
			if w == v || !containsName(s.Keys[w], missing[i]) {
				continue
			}
			if s.Index[w] < 0 {
				sccVisit(c, s, w)
				if s.Low[w] < s.Low[v] { s.Low[v] = s.Low[w] }
			} else if s.OnStack[w] && s.Index[w] < s.Low[v] {
				s.Low[v] = s.Index[w]
			}
		}
	}
	if s.Low[v] != s.Index[v] { return }
	var top int = len(s.Stack)
	var start int = top - 1
	for s.Stack[start] != v {
		start = start - 1
	}
	var group @[]int = make_slice(int, top - start)
	for i := start; i < top; i++ {
		s.OnStack[s.Stack[i]] = false
		group[i - start] = s.Stack[i]
	}
	s.Stack = s.Stack[:start]
	sortInts(group)
	s.Groups = slices.Append[@[]int](s.Groups, group)
}

// sortInts sorts a (short) list of ints ascending, in place.
func sortInts(a @[]int) {
	for i := 1; i < len(a); i++ {
		var v int = a[i]
		var j int = i - 1
		for j >= 0 && a[j] > v {
			a[j + 1] = a[j]
			j = j - 1
		}
		a[j + 1] = v
	}
}
