package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for pendingGroups (check_pending_groups.bn): the groups of parked
// declarations that wait on one another, dependencies first.

// groupsString renders pendingGroups(c) as the parked declarations' keys,
// members of a group separated by " ", groups by " | ".
func groupsString(c @Checker) @[]char {
	var gs @[]@[]int = pendingGroups(c)
	var out @[]char = ""
	for i := 0; i < len(gs); i++ {
		if i > 0 { out = buf.Concat(out, " | ") }
		for j := 0; j < len(gs[i]); j++ {
			if j > 0 { out = buf.Concat(out, " ") }
			out = buf.Concat(out, pendingKey(c.Pending[gs[i][j]].Decl))
		}
	}
	return out
}

// expectGroups fails unless pendingGroups(c) renders as want.
func expectGroups(c @Checker, want *[]readonly char) testing.TestResult {
	var got @[]char = groupsString(c)
	if streq(got, want) { return "" }
	return fail(
			buf.Concat(buf.Concat("groups: got `", got), buf.Concat("`, want `", buf.Concat(want, "`"))))
}

// A chain of parked declarations comes out dependencies first, one group
// each.
func TestPendingGroupsDependencyOrder() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func a() int { return b() }")
	replCheckDecl(c, "func b() int { return d() }")
	replCheckDecl(c, "func d() int { return e() }")
	return expectGroups(c, "d | b | a")
}

// Declarations that wait on each other form one group, in the order they
// parked.
func TestPendingGroupsCycleIsOneGroup() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() + h }")
	replCheckDecl(c, "func g() int { return f() }")
	return expectGroups(c, "f g")
}

// Declarations that wait on nothing parked are separate groups; a longer
// cycle is one group after what it depends on.
func TestPendingGroupsMixed() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = p")
	replCheckDecl(c, "func f() int { return g() + y }")
	replCheckDecl(c, "func g() int { return k() }")
	replCheckDecl(c, "func k() int { return f() + x }")
	var r testing.TestResult = expectGroups(c, "x | f g k")
	if len(r) > 0 { return r }
	if len(pendingGroups(c)) != 2 {
		return fail(buf.Concat("expected 2 groups, got ", strconv.Itoa(len(pendingGroups(c)))))
	}
	return ""
}

// sortInts sorts ascending.
func TestPendingGroupsSortInts() testing.TestResult {
	var a @[]int = make_slice(int, 5)
	a[0] = 3
	a[1] = 1
	a[2] = 4
	a[3] = 1
	a[4] = 0
	sortInts(a)
	for i := 1; i < len(a); i++ {
		if a[i - 1] > a[i] { return fail("sortInts must sort ascending") }
	}
	return ""
}
