package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// pendingIfaces pairs each interface declaration of a batch with the interface type
// preRegisterInterfaces defined for it (Checker.PendingIfaces), in order, with an index
// by each, so either is found from the other in time independent of how many there are.
type pendingIfaces struct {
	decls  @vec.Vec[@ast.Decl]
	ifaces @vec.Vec[@types.Type]
	byDecl @table.Table[@ast.Decl, int, instanceDeclHasher, instanceDeclEq]
	byType @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
}

// newPendingIfaces returns an empty pendingIfaces.
func newPendingIfaces() @pendingIfaces {
	var p @pendingIfaces = make(pendingIfaces)
	p.decls = vec.New[@ast.Decl]()
	p.ifaces = vec.New[@types.Type]()
	p.byDecl = table.NewTable[@ast.Decl, int, instanceDeclHasher, instanceDeclEq](
			instanceDeclHasher{}, instanceDeclEq{})
	p.byType = newTypeIndexTable()
	return p
}

// newTypeIndexTable returns an empty table of positions, keyed by a type's identity.
func newTypeIndexTable() @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq] {
	return table.NewTable[@types.Type, int, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
}

// add pairs d with iface.  The indexes keep each one's first pairing.
func (p @pendingIfaces) add(d @ast.Decl, iface @types.Type) {
	var at int = p.decls.Len()
	p.decls.Push(d)
	p.ifaces.Push(iface)
	if !p.byDecl.Has(d) { p.byDecl.Put(d, at) }
	if !p.byType.Has(iface) { p.byType.Put(iface, at) }
}

// typeOf returns the interface type first paired with d, or nil.
func (p @pendingIfaces) typeOf(d @ast.Decl) @types.Type {
	at, found := p.byDecl.Get(d)
	if !found { return nil }
	return p.ifaces.Get(at)
}

// declOf returns the declaration first paired with iface, or nil.
func (p @pendingIfaces) declOf(iface @types.Type) @ast.Decl {
	at, found := p.byType.Get(iface)
	if !found { return nil }
	return p.decls.Get(at)
}
