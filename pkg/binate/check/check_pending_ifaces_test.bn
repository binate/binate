package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Each of a pair finds the other; a declaration or type paired twice finds its first
// pairing; one never paired finds nil.
func TestPendingIfaces() testing.TestResult {
	var p @pendingIfaces = newPendingIfaces()
	var a @ast.Decl = make(ast.Decl)
	var b @ast.Decl = make(ast.Decl)
	var ta @types.Type = types.MakeInterfaceType("p", "A")
	var tb @types.Type = types.MakeInterfaceType("p", "B")
	p.add(a, ta)
	p.add(b, tb)
	p.add(a, tb)
	if !same(p.typeOf(a), ta) || !same(p.typeOf(b), tb) { return fail("a's type A, b's B") }
	if !same(p.declOf(ta), a) || !same(p.declOf(tb), b) { return fail("A's declaration a, B's b") }
	if p.typeOf(make(ast.Decl)) != nil || p.declOf(types.MakeInterfaceType("p", "C")) != nil {
		return fail("nothing for a stranger")
	}
	return ""
}
