package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// REPL forward references to impls (check_pending.bn).  A parked `impl T : I`
// provides the key `T:I` — and `T:P` for every parent P of I — to the
// declarations waiting on it: converting a value of the session's type T to
// the interface I, with no impl for them yet, is a forward reference to one
// (noteMissingImpl).  T is the name of the receiver's named type (through an
// alias), I the interface's key name (ifaceKey).

// pendingKeys returns every key parked declaration d provides: pendingKey,
// or for an impl one per interface it lists and per parent of those (the
// parents known when asked).
func pendingKeys(c @Checker, d @ast.Decl) @[]@[]char {
	if d.Kind == ast.DECL_IMPL {
		return implKeys(c, d, false)
	}
	var keys @[]@[]char
	var k @[]char = pendingKey(d)
	if len(k) > 0 {
		keys = slices.Append[@[]char](keys, k)
	}
	return keys
}

// directKeys returns the keys d provides by itself: pendingKeys without an
// impl's parent keys.  A declaration replaces an older parked one sharing a
// direct key (dropSupersededPending); an impl of a child interface does not
// replace one of its parent's.
func directKeys(c @Checker, d @ast.Decl) @[]@[]char {
	if d.Kind == ast.DECL_IMPL {
		return implKeys(c, d, true)
	}
	return pendingKeys(c, d)
}

// implKeys returns impl d's keys: `T:I` for each interface I it lists and,
// unless direct, for each parent of one.
func implKeys(c @Checker, d @ast.Decl, direct bool) @[]@[]char {
	var keys @[]@[]char
	var recv @[]char = implRecvKeyName(c, d.TypeRef)
	if len(recv) == 0 { return keys }
	for i := 0; i < len(d.Interfaces); i++ {
		var iface @types.Type = lookupIfaceQuietly(c, d.Interfaces[i])
		if iface == nil {
			var written @[]char = writtenIfaceKey(c, d.Interfaces[i])
			if len(written) > 0 {
				keys = appendKey(keys, implKey(recv, written))
			}
			continue
		}
		keys = appendKey(keys, implKey(recv, ifaceKey(c, iface)))
		if !direct {
			keys = appendParentKeys(c, keys, recv, iface)
		}
	}
	return keys
}

// providesKey reports whether parked declaration d provides key.
func providesKey(c @Checker, d @ast.Decl, key *[]readonly char) bool {
	return containsName(pendingKeys(c, d), key)
}

// appendParentKeys appends `recv:P` for each ancestor P of interface iface.
func appendParentKeys(c @Checker, keys @[]@[]char, recv *[]readonly char,
		iface @types.Type) @[]@[]char {
	for i := 0; i < len(iface.Parents); i++ {
		keys = appendKey(keys, implKey(recv, ifaceKey(c, iface.Parents[i])))
		keys = appendParentKeys(c, keys, recv, iface.Parents[i])
	}
	return keys
}

// appendKey appends key to keys unless it is there.
func appendKey(keys @[]@[]char, key @[]char) @[]@[]char {
	if containsName(keys, key) { return keys }
	return slices.Append[@[]char](keys, key)
}

// implKey returns the key `T:I` of an impl of the interface with key name
// iface for the type named recv.
func implKey(recv *[]readonly char, iface *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(recv)
	cb.Write(":")
	cb.Write(iface)
	return buf.CopyStr(cb.String())
}

// ifaceKey returns an interface's key name: its name, prefixed with its
// package's path when that is not the session's; an instance of a generic
// interface by its generic declaration's name (the instances of one generic
// interface share keys — a mismatch is then reported when the impl resolves).
func ifaceKey(c @Checker, iface @types.Type) @[]char {
	var name @[]char = iface.Name
	if iface.InstDecl != nil {
		var gd @ast.Decl = bit_cast(@ast.Decl, iface.InstDecl)
		name = gd.Name
	}
	return qualifiedKeyName(c, iface.Pkg, name)
}

// qualifiedKeyName returns name, prefixed with pkgPath and a dot when
// pkgPath is neither empty nor the session's package.
func qualifiedKeyName(c @Checker, pkgPath *[]readonly char, name *[]readonly char) @[]char {
	if len(pkgPath) == 0 || types.CharEq(pkgPath, c.curPkgPath) { return buf.CopyStr(name) }
	return buf.Concat(buf.Concat(pkgPath, "."), name)
}

// writtenIfaceKey returns the key name of an interface reference that does
// not resolve (yet) — a parked interface, a generic instance — from how it is
// written: its name, qualified by its package's path when it names one.
func writtenIfaceKey(c @Checker, te @ast.TypeExpr) @[]char {
	var t @ast.TypeExpr = te
	if t != nil && t.Kind == ast.TEXPR_INSTANTIATE {
		t = t.Base
	}
	if t == nil || t.Kind != ast.TEXPR_NAMED { return "" }
	if len(t.Pkg) == 0 { return buf.CopyStr(t.Name) }
	var pkg @Symbol = c.Scope.Lookup(t.Pkg)
	if pkg == nil || pkg.Kind != types.SYM_PKG { return buf.Concat(buf.Concat(t.Pkg, "."), t.Name) }
	return qualifiedKeyName(c, pkg.PkgPath, t.Name)
}

// implRecvKeyName returns the key name of an impl's receiver: the session
// type it names, through an alias (`type PB = *Box` → Box), or as written
// when it does not resolve (yet).
func implRecvKeyName(c @Checker, te @ast.TypeExpr) @[]char {
	var written @[]char = typeExprBaseName(te)
	if len(written) == 0 { return written }
	var sym @Symbol = c.Scope.Lookup(written)
	if sym != nil && sym.Kind == types.SYM_TYPE && sym.Type != nil {
		var name @[]char = sessionTypeName(c, sym.Type.ReceiverBaseNamed())
		if len(name) > 0 { return name }
	}
	return written
}

// typeExprBaseName returns the name of the named type a type expression is (a
// pointer / managed-pointer / const / parenthesized wrapper of, or an
// instantiation of), without its package, or empty.
func typeExprBaseName(te @ast.TypeExpr) @[]char {
	var t @ast.TypeExpr = te
	for t != nil &&
			(t.Kind == ast.TEXPR_POINTER || t.Kind == ast.TEXPR_MANAGED || t.Kind == ast.TEXPR_CONST ||
					t.Kind == ast.TEXPR_PAREN || t.Kind == ast.TEXPR_INSTANTIATE) {
		t = t.Base
	}
	if t == nil || t.Kind != ast.TEXPR_NAMED { return "" }
	return t.Name
}

// lookupIfaceQuietly returns the interface a non-generic interface reference
// in an impl names — in the session, or a package's — or nil, reporting
// nothing.
func lookupIfaceQuietly(c @Checker, te @ast.TypeExpr) @types.Type {
	if te == nil || te.Kind != ast.TEXPR_NAMED { return nil }
	var sym @Symbol
	if len(te.Pkg) == 0 {
		sym = c.Scope.Lookup(te.Name)
	} else {
		var pkg @Symbol = c.Scope.Lookup(te.Pkg)
		if pkg == nil || pkg.Kind != types.SYM_PKG { return nil }
		var ps @Scope = lookupPackage(c, pkg.PkgPath)
		if ps == nil { return nil }
		sym = ps.Lookup(te.Name)
	}
	if sym == nil || sym.Kind != types.SYM_INTERFACE { return nil }
	return sym.Type
}

// implBound reports whether an impl record makes the session's type named
// recv implement an interface with key name iface (directly, or through one
// of the impl's interfaces' parents).
func implBound(c @Checker, recv *[]readonly char, iface *[]readonly char) bool {
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec.RecvType == nil { continue }
		if !types.CharEq(sessionTypeName(c, rec.RecvType.ReceiverBaseNamed()), recv) { continue }
		for j := 0; j < len(rec.Interfaces); j++ {
			if ifaceHasAncestorKey(c, rec.Interfaces[j], iface) { return true }
		}
	}
	return false
}

// ifaceHasAncestorKey reports whether interface i, or one of its ancestors,
// has key name key.
func ifaceHasAncestorKey(c @Checker, i @types.Type, key *[]readonly char) bool {
	if i == nil { return false }
	if types.CharEq(ifaceKey(c, i), key) { return true }
	for k := 0; k < len(i.Parents); k++ {
		if ifaceHasAncestorKey(c, i.Parents[k], key) { return true }
	}
	return false
}

// noteMissingImpl handles a failed conversion of src to interface-value type
// dst (an assignment, argument, return or cast) when an impl could make it
// legal: src is a value of a named type of the session — for a raw `*I`,
// the value (borrowed) or one pointer to it; for a managed `@I`, a managed
// pointer to it — see noteMissingImplOf.  Reports whether it handled the
// failure (otherwise the caller reports it).
func noteMissingImpl(c @Checker, pos token.Pos, src @types.Type, dst @types.Type) bool {
	if src == nil || dst == nil { return false }
	var d @types.Type = types.ResolveAliasAndConst(dst)
	if d == nil || d.Elem == nil { return false }
	var managed bool = d.Kind == types.TYP_INTERFACE_VALUE_MANAGED
	if !managed && d.Kind != types.TYP_INTERFACE_VALUE { return false }
	var s @types.Type = peelAliasReadonly(src)
	var named @types.Type
	if s.Kind == types.TYP_NAMED && !managed {
		named = s
	} else if s.Kind == types.TYP_MANAGED_PTR || (s.Kind == types.TYP_POINTER && !managed) {
		var e @types.Type = peelAliasReadonly(s.Elem)
		if e != nil && e.Kind == types.TYP_NAMED {
			named = e
		}
	}
	if named == nil { return false }
	return noteMissingImplOf(c, pos, named, d.Elem)
}

// noteMissingImplOf handles a use that needs an impl of interface iface for
// the named type named (a conversion, or a generic constraint) when there is
// none: an impl may yet be declared for a named type of the session, so in
// TentativeMode the use is a forward reference, captured as `T:I`; at the
// prompt, a parked impl providing that is reported unresolved.  An instance
// of a generic type is not waited for: its impls would be generic-receiver
// ones, which the prompt does not support.  Reports whether it handled the
// use.
func noteMissingImplOf(c @Checker, pos token.Pos, named @types.Type, iface @types.Type) bool {
	if named == nil || named.InstDecl != nil || iface == nil || iface.Kind != types.TYP_INTERFACE {
		return false
	}
	var recv @[]char = sessionTypeName(c, named)
	if len(recv) == 0 { return false }
	var ik @[]char = ifaceKey(c, iface)
	if implBound(c, recv, ik) { return false }
	var key @[]char = implKey(recv, ik)
	if c.TentativeMode {
		captureMissing(c, key)
		return true
	}
	if lookupPending(c, key) != nil {
		errPendingDecl(c, pos, key)
		return true
	}
	return false
}

// peelAliasReadonly returns t without its alias, const and readonly
// wrappers (a named type is kept).
func peelAliasReadonly(t @types.Type) @types.Type {
	var cur @types.Type = types.ResolveAliasAndConst(t)
	for cur != nil && cur.Kind == types.TYP_READONLY {
		cur = types.ResolveAliasAndConst(cur.Elem)
	}
	return cur
}

// implKeyBound reports whether an impl key `T:I` is now declared (implBound).
func implKeyBound(c @Checker, key *[]readonly char) bool {
	for i := 0; i < len(key); i++ {
		if key[i] == ':' {
			return implBound(c, key[:i], key[i + 1:])
		}
	}
	return false
}

// isImplKey reports whether a missing-name key is an impl's (`T:I`).
func isImplKey(key *[]readonly char) bool {
	for i := 0; i < len(key); i++ {
		if key[i] == ':' { return true }
	}
	return false
}

// TypeExprLabel renders a type expression of an impl's receiver or interface
// list as written: named types (package-qualified), their instantiations, and
// pointer / managed / const / parenthesized wrappers of them.
func TypeExprLabel(te @ast.TypeExpr) @[]char {
	if te == nil { return "?" }
	if te.Kind == ast.TEXPR_POINTER { return buf.Concat("*", TypeExprLabel(te.Base)) }
	if te.Kind == ast.TEXPR_MANAGED { return buf.Concat("@", TypeExprLabel(te.Base)) }
	if te.Kind == ast.TEXPR_CONST { return buf.Concat("const ", TypeExprLabel(te.Base)) }
	if te.Kind == ast.TEXPR_PAREN {
		return buf.Concat(buf.Concat("(", TypeExprLabel(te.Base)), ")")
	}
	if te.Kind == ast.TEXPR_INSTANTIATE {
		var s @[]char = buf.Concat(TypeExprLabel(te.Base), "[")
		for i := 0; i < len(te.TypeArgs); i++ {
			if i > 0 { s = buf.Concat(s, ", ") }
			s = buf.Concat(s, TypeExprLabel(te.TypeArgs[i]))
		}
		return buf.Concat(s, "]")
	}
	if te.Kind == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 { return buf.Concat(buf.Concat(te.Pkg, "."), te.Name) }
		return buf.CopyStr(te.Name)
	}
	return "?"
}

// ImplLabel renders an impl declaration as written: `impl *Box : Sizer`.
func ImplLabel(d @ast.Decl) @[]char {
	var label @[]char = buf.Concat("impl ", TypeExprLabel(d.TypeRef))
	for i := 0; i < len(d.Interfaces); i++ {
		if i == 0 {
			label = buf.Concat(label, " : ")
		} else {
			label = buf.Concat(label, ", ")
		}
		label = buf.Concat(label, TypeExprLabel(d.Interfaces[i]))
	}
	return label
}
