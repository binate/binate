package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_pending_impl.bn: interface and impl declarations parking at
// the REPL prompt, and conversions waiting on a parked impl.  sessionChecker /
// replCheckDecl / replCheckStmts / pendingMissing live in check_pending_test.bn;
// retrySummary / expectSummary in check_pending_retry_test.bn.

// An impl whose type lacks a method of the interface parks on `T.M`, and
// resolves once the method is declared.
func TestPendingImplParksOnMethod() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "impl *Box : Sizer")
	if len(c.CheckerErrors()) != 0 {
		return fail(c.CheckerErrors()[0].Msg)
	}
	if !types.CharEq(pendingMissing(c, "Box:Sizer"), "Box.Size") {
		return fail(buf.Concat("the impl must park on Box.Size, got: ", pendingMissing(c, "Box:Sizer")))
	}
	replCheckDecl(c, "func (b *Box) Size() int { return b.n }")
	return expectSummary(retrySummary(c), "Box:Sizer")
}

// A method of the wrong signature is not a forward reference: the impl is
// rejected.
func TestPendingImplWrongSignatureRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "func (b *Box) Size() bool { return true }")
	replCheckDecl(c, "impl *Box : Sizer")
	return expectErrSub(c, "wrong signature")
}

// A conversion of a session type's value to an interface with no impl for
// them waits on one; the impl resolves it.
func TestPendingConversionParksOnImpl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "func (b *Box) Size() int { return b.n }")
	replCheckDecl(c, "func asSizer(b *Box) *Sizer { return b }")
	if !types.CharEq(pendingMissing(c, "asSizer"), "Box:Sizer") {
		return fail(buf.Concat("asSizer must park on Box:Sizer, got: ", pendingMissing(c, "asSizer")))
	}
	replCheckDecl(c, "impl *Box : Sizer")
	return expectSummary(retrySummary(c), "asSizer")
}

// A conversion to a parent interface waits on an impl of a child interface:
// the impl provides the parent's key too.
func TestPendingConversionToParentWaitsOnChildImpl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface P { A() int }")
	replCheckDecl(c, "interface Q : P { B() int }")
	replCheckDecl(c, "type D struct { n int }")
	replCheckDecl(c, "func (d *D) A() int { return d.n }")
	replCheckDecl(c, "func (d *D) B() int { return d.n }")
	replCheckDecl(c, "func asP(d *D) *P { return d }")
	replCheckDecl(c, "impl *D : Q")
	return expectSummary(retrySummary(c), "asP")
}

// A conversion at the prompt that needs a parked impl reports the impl
// unresolved.
func TestPendingImplUnresolvedAtPrompt() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "impl *Box : Sizer")
	replCheckDecl(c, "func sz(s *Sizer) int { return 0 }")
	replCheckDecl(c, "var b Box")
	replCheckStmts(c, "_ = sz(&b)")
	return expectErrSub(c, "impl *Box : Sizer is unresolved (pending: Box.Size)")
}

// An interface whose method names a type not yet declared parks on it.
func TestPendingInterfaceParksOnType() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Maker { Make() @Later }")
	if !types.CharEq(pendingMissing(c, "Maker"), "Later") {
		return fail(buf.Concat("Maker must park on Later, got: ", pendingMissing(c, "Maker")))
	}
	replCheckDecl(c, "type Later struct { v int }")
	return expectSummary(retrySummary(c), "Maker")
}

// A method converting its receiver to the interface of a parked impl, and
// the impl waiting on that method, resolve together.
func TestPendingImplAndMethodResolveTogether() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type E struct { n int }")
	replCheckDecl(c, "impl *E : Sizer")
	replCheckDecl(c, "func (e *E) Size() int { var s *Sizer = e; _ = s; return e.n }")
	return expectSummary(retrySummary(c), "E:Sizer E.Size")
}

// An impl on a generic type is rejected at the prompt.
func TestPendingGenericImplRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Getter[T any] { Get() T }")
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "impl *Cur[T] : Getter[T]")
	return expectErrSub(c, "impl declarations on a generic type are not supported at the prompt")
}

// An impl through an alias of a pointer to its type provides the type's key:
// the impl and a method boxing its receiver resolve together.
func TestPendingImplAliasReceiver() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "type PB = *Box")
	replCheckDecl(c, "impl PB : Sizer")
	replCheckDecl(c, "func (b *Box) Size() int { var s *Sizer = b; _ = s; return b.n }")
	return expectSummary(retrySummary(c), "PB:Sizer Box.Size")
}

// An impl of a generic interface instance provides the key a conversion to
// that instance misses: they resolve together.
func TestPendingImplGenericInterfaceInstance() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Getter[T any] { Get() T }")
	replCheckDecl(c, "type B struct { v int }")
	replCheckDecl(c, "impl *B : Getter[int]")
	replCheckDecl(c, "func (b *B) Get() int { var g *Getter[int] = b; _ = g; return b.v }")
	return expectSummary(retrySummary(c), "B:Getter B.Get")
}

// Keys carry the interface's package: an interface of another package is
// keyed by its path and name, so it does not stand for the session's
// interface of the same name.
func TestPendingImplKeyHasPackage() testing.TestResult {
	var c @Checker = sessionChecker()
	var mine @types.Type = types.MakeInterfaceType(buf.CopyStr(c.curPkgPath), "Stringer")
	var theirs @types.Type = types.MakeInterfaceType("pkg/builtins/lang", "Stringer")
	if !types.CharEq(ifaceKey(c, mine), "Stringer") {
		return fail(buf.Concat("the session's interface key: ", ifaceKey(c, mine)))
	}
	if !types.CharEq(ifaceKey(c, theirs), "pkg/builtins/lang.Stringer") {
		return fail(buf.Concat("an imported interface's key: ", ifaceKey(c, theirs)))
	}
	return ""
}

// An impl of a parent interface does not replace a parked impl of a child
// interface (only the interfaces an impl lists are its own keys).
func TestPendingImplOfParentKeepsChildImpl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface A { M() int }")
	replCheckDecl(c, "interface B : A { N() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "impl *Box : B")
	replCheckDecl(c, "func (b *Box) M() int { return b.n }")
	replCheckDecl(c, "impl *Box : A")
	if !c.IsPendingDecl("Box:B") {
		return fail("the parked impl of B must stay parked")
	}
	return ""
}

// A conversion no impl could make legal is an error, not a wait: a value to
// a managed interface, a pointer to a pointer, a raw pointer to a managed
// interface.
func TestPendingImplNoFalsePark() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type C struct { n int }")
	replCheckDecl(c, "func (c *C) Size() int { return c.n }")
	var srcs @[]@[]char = make_slice(@[]char, 3)
	srcs[0] = buf.CopyStr("func f1(x C) @Sizer { return x }")
	srcs[1] = buf.CopyStr("func f2(x **C) *Sizer { return x }")
	srcs[2] = buf.CopyStr("func f3(x *C) @Sizer { return x }")
	for i := 0; i < len(srcs); i++ {
		var before int = len(c.CheckerErrors())
		replCheckDecl(c, srcs[i])
		if len(c.CheckerErrors()) == before {
			return fail(buf.Concat("must be an error, not a park: ", srcs[i]))
		}
	}
	return ""
}

// An impl through an alias of a generic type's instance is rejected, like
// one written on the instance.
func TestPendingGenericImplThroughAliasRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Getter[T any] { Get() T }")
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "type CI = Cur[int]")
	replCheckDecl(c, "impl *CI : Getter[int]")
	return expectErrSub(c, "impl declarations on a generic type are not supported at the prompt")
}

// The unresolved-impl error names the parked impl as written, not the key it
// provides (here a parent's).
func TestPendingImplUnresolvedNamesDecl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface P { A() int }")
	replCheckDecl(c, "interface Q : P { B() int }")
	replCheckDecl(c, "type D struct { n int }")
	replCheckDecl(c, "impl *D : Q")
	replCheckDecl(c, "func useP(p *P) int { return 0 }")
	replCheckDecl(c, "var dd D")
	replCheckStmts(c, "_ = useP(&dd)")
	return expectErrSub(c, "impl *D : Q is unresolved")
}

// A cast to an interface, and a generic constraint, wait on an impl like a
// conversion does.
func TestPendingCastAndConstraintWaitOnImpl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Box struct { n int }")
	replCheckDecl(c, "func (b Box) Size() int { return b.n }")
	replCheckDecl(c, "func f(b *Box) *Sizer { return cast(*Sizer, b) }")
	replCheckDecl(c, "func sz[T Sizer](x T) int { return x.Size() }")
	replCheckDecl(c, "func g(b Box) int { return sz[Box](b) }")
	if !types.CharEq(pendingMissing(c, "f"), "Box:Sizer") ||
			!types.CharEq(pendingMissing(c, "g"), "Box:Sizer") {
		return fail(
				buf.Concat(buf.Concat("f and g must park on Box:Sizer, got: ", pendingMissing(c, "f")),
						buf.Concat(" / ", pendingMissing(c, "g"))))
	}
	replCheckDecl(c, "impl Box : Sizer")
	return expectSummary(retrySummary(c), "f | g")
}
