package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for a parked declaration that uses a name a parked redefinition
// provides (check_pending_retry.bn): it is checked with the redefinition, or
// after it, and so against the new definition, however the two parked.

// The redefinition of h joins the group of f, which uses h and parked on P
// before h was redefined: f is checked against the new h, so its int8 use of h
// checks, and the three resolve together.  (Against the old h, f does not
// check.)
func TestPendingParkedRedefinitionJoinsUsersGroup() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func P(n int) int { if n == 0 { return 1 }; return f() + q(n) }")
	replCheckDecl(c, "func h() int { return 1000 }")
	replCheckDecl(c, "func f() bool { return false }")
	replCheckDecl(c, "func f() int { var x int8 = h(); return cast(int, x) + P(0) }")
	replCheckDecl(c, "func h() int8 { var _ int = P(0); return 5 }")
	replCheckDecl(c, "func q(n int) int { return 100 + n }")
	return expectSummary(retrySummary(c), "P f h")
}

// A parked declaration whose missing names are declared waits for a parked
// redefinition of a name it uses, then is checked after it, against it; what
// it waits for no longer lists the names declared since.  A local of that name
// is no use of it.
func TestPendingWaitsForParkedRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1000 }")
	replCheckDecl(c, "func f() int { var x int8 = h(); return cast(int, x) + g() }")
	replCheckDecl(c, "func k() int { var h int = 3; return h + g() }")
	replCheckDecl(c, "func h() int8 { return cast(int8, z) }")
	replCheckDecl(c, "func g() int { return 1 }")
	var r testing.TestResult = expectSummary(retrySummary(c), "k")
	if len(r) > 0 { return r }
	replCheckStmts(c, "_ = f()")
	r = expectErrSub(c, "function f is unresolved (pending: h)")
	if len(r) > 0 { return r }
	replCheckDecl(c, "var z int = 5")
	return expectSummary(retrySummary(c), "h | f")
}

// A use a retry finds only once a missing name is declared — of a method of
// the value mk returns — makes the group wait for the method's parked
// redefinition: it stays parked, a use of it names the method it waits for,
// and it resolves after the redefinition, against it.
func TestPendingRetryFindsUseOfParkedRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Mv struct { n int }")
	replCheckDecl(c, "func (v Mv) Size() int { return 1000 }")
	replCheckDecl(c, "func f() int8 { return mk().Size() }")
	replCheckDecl(c, "func (v Mv) Size() int8 { return cast(int8, z) }")
	replCheckDecl(c, "func mk() Mv { var v Mv; return v }")
	var r testing.TestResult = expectSummary(retrySummary(c), "")
	if len(r) > 0 { return r }
	replCheckStmts(c, "_ = f()")
	r = expectErrSub(c, "function f is unresolved (pending: Mv.Size)")
	if len(r) > 0 { return r }
	replCheckDecl(c, "var z int = 2")
	return expectSummary(retrySummary(c), "Mv.Size | f")
}

// A use of a forward-declared type whose definition is parked waits for nothing:
// the definition fills the type in, it does not redefine it.
func TestPendingUseOfForwardTypeDoesNotWait() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type F")
	replCheckDecl(c, "type F struct { y Y }")
	replCheckDecl(c, "func f(p *F) int { return g() }")
	replCheckDecl(c, "func g() int { return 1 }")
	return expectSummary(retrySummary(c), "f")
}

// A member credited with its group's uses is checked again once the group comes
// apart, and its own uses decide whether it waits: B, which uses only A, resolves
// once A is declared at the prompt, though the group's A used h, whose
// redefinition is parked.
func TestPendingMemberWaitsOnlyOnItsOwnUses() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1 }")
	replCheckDecl(c, "func A() int { return h() + B() + w }")
	replCheckDecl(c, "func B() int { var s int8 = A(); return cast(int, s) }")
	replCheckDecl(c, "var w int = 1")
	var r testing.TestResult = expectSummary(retrySummary(c), "!A !B")
	if len(r) > 0 { return r }
	replCheckDecl(c, "func h() int8 { return cast(int8, yy) }")
	replCheckDecl(c, "func A() int8 { return 5 }")
	return expectSummary(retrySummary(c), "B")
}

// A waiting group keeps the names it was formed on: A, which waits for the
// redefinition of Mv.Get, stays in a group with the impl it converts through and
// the method that impl waits for, and all of them resolve once mk is declared,
// the redefinition first.
func TestPendingWaitingGroupKeepsItsMembers() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type C struct { n int }")
	replCheckDecl(c, "type Mv struct { n int }")
	replCheckDecl(c, "func (v Mv) Get() int { return 1000 }")
	replCheckDecl(c,
			"func A() int { var c C; var s *Sizer = &c; return s.Size() + cast(int, mk().Get()) }")
	_ = c.RetryPendingDecls()
	replCheckDecl(c, "impl *C : Sizer")
	_ = c.RetryPendingDecls()
	replCheckDecl(c, "func (c *C) Size() int { if c.n > 0 { return A() }; return 1 }")
	_ = c.RetryPendingDecls()
	replCheckDecl(c, "func (v Mv) Get() int8 { return cast(int8, mk().n + 7) }")
	_ = c.RetryPendingDecls()
	replCheckDecl(c, "func mk() Mv { var v Mv; return v }")
	var got @[]char = retrySummary(c)
	if len(c.Pending) != 0 { return fail(buf.Concat("everything must resolve; retry: ", got)) }
	return ""
}

// What a parked declaration waits for lists a name it uses only when that is a
// redefinition — bound, and provided by a parked declaration — not when a
// group-mate provides it.
func TestPendingNamesListOnlyRedefinitions() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Mv struct { n int }")
	replCheckDecl(c, "func A() int { return B() + mk().Size() }")
	replCheckDecl(c, "func B() int { return A() }")
	replCheckDecl(c, "func mk() Mv { var v Mv; return v }")
	_ = c.RetryPendingDecls()
	replCheckStmts(c, "_ = A()")
	return expectErrSub(c, "function A is unresolved (pending: Mv.Size)")
}

// A generic instance first named by a parked group is checked with it, so a use
// in its body of a name a parked redefinition provides makes the group wait for
// it, and the three resolve together: the instance binds the new h.
func TestPendingInstanceBodyUseOfParkedRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1000 }")
	replCheckDecl(c, "func gf[T any](x T) int { return cast(int, h()) }")
	replCheckDecl(c, "func P(n int) int { if n == 0 { return 1 }; return f() + q(n) }")
	replCheckDecl(c, "func f() bool { return false }")
	replCheckDecl(c, "func f() int { return gf[bool](true) + P(0) }")
	replCheckDecl(c, "func h() int8 { var _ int = P(0); return 5 }")
	replCheckDecl(c, "func q(n int) int { return 100 + n }")
	return expectSummary(retrySummary(c), "P f h")
}

// A parked redefinition of the same signature replaces the old definition,
// which what uses the name reaches once it resolves, so nothing waits for it:
// f resolves once P is declared, and f2, declared at the prompt, at once.
func TestPendingReplacingRedefinitionIsNotWaitedFor() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1 }")
	replCheckDecl(c, "func f() int { return h() + P(0) }")
	replCheckDecl(c, "func h() int { return R(0) }")
	replCheckDecl(c, "func P(n int) int { return 0 }")
	var r testing.TestResult = expectSummary(retrySummary(c), "f")
	if len(r) > 0 { return r }
	replCheckDecl(c, "func f2() int { return h() }")
	if c.IsPendingDecl("f2") { return fail("f2 must not wait for h's replacing redefinition") }
	return ""
}

// A declaration typed at the prompt that uses a name a parked declaration
// redefines with another signature parks on it, though it misses nothing, and
// resolves after it, against it.
func TestPendingPromptDeclarationWaitsForParkedRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func h() int { return 1000 }")
	replCheckDecl(c, "func h() int8 { return cast(int8, 3 + Q(0)) }")
	replCheckDecl(c, "func f() int { return cast(int, h()) }")
	if !c.IsPendingDecl("f") { return fail("f must park, waiting for h's redefinition") }
	replCheckDecl(c, "func Q(n int) int { return 0 }")
	return expectSummary(retrySummary(c), "h | f")
}

// An existing instance checked again for a method a parked declaration adds to
// its generic is existing code: what its body uses is not the declaration's,
// so get2, which uses only P, does not wait for g's redefinition, which get uses.
func TestPendingRequeuedInstanceUsesAreNotTheDeclarations() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func g() int { return 1000 }")
	replCheckDecl(c, "type Cell[T any] struct { v T }")
	replCheckDecl(c, "func (b *Cell[T]) get() int { return g() }")
	replCheckDecl(c, "func use() int { var b Cell[int]; return b.get() }")
	replCheckDecl(c, "func g() int8 { return cast(int8, 3 + Q(0)) }")
	replCheckDecl(c, "func (b *Cell[T]) get2() int { return 7 + P(0) }")
	replCheckDecl(c, "func P(n int) int { return 0 }")
	return expectSummary(retrySummary(c), "Cell.get2")
}

// The body of a method a parked declaration adds is its own, also in an existing
// instance checked again for it: the gf[bool] that put's body in the existing
// Cell[bool] names first uses h, so put waits for h's redefinition, as it would
// with no Cell[bool] named before.
func TestPendingAddedMethodsInstanceBodyUsesCount() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Cell[T any] struct { v T }")
	replCheckDecl(c, "func h() int { return 1000 }")
	replCheckDecl(c, "func gf[T any](x T) int { return cast(int, h()) }")
	replCheckDecl(c, "func (b *Cell[T]) get() int { return 1 }")
	replCheckDecl(c, "func use() int { var b Cell[bool]; return b.get() }")
	replCheckDecl(c, "func h() int8 { return cast(int8, 3 + Q(0)) }")
	replCheckDecl(c, "func (b *Cell[T]) put() int { return gf[T](b.v) }")
	if !c.IsPendingDecl("Cell.put") { return fail("put must wait for h's redefinition") }
	replCheckDecl(c, "func Q(n int) int { return 0 }")
	return expectSummary(retrySummary(c), "h | Cell.put")
}

// A const-group member does not wait for a parked redefinition that another
// member of its group supersedes.
func TestPendingConstGroupMemberDoesNotWaitOnItsGroup() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const K = 1")
	replCheckDecl(c, "const K = Z")
	replCheckDecl(c, "const (\n  K = 5\n  A = K + 1\n)")
	if c.IsPendingDecl("A") || c.IsPendingDecl("K") { return fail("the group's members must resolve") }
	return ""
}
