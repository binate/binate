package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the retry sweep over parked REPL declarations
// (check_pending_retry.bn, check_pending_groups.bn): what resolves, in which
// order and groups, and what a group that does not check does.

// retrySummary runs a retry sweep and describes what it checked: each
// declaration's key (pendingKey), "!" before one that failed, members of one
// group separated by " ", groups by " | ", in the order checked.
func retrySummary(c @Checker) @[]char {
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	var out @[]char = ""
	for i := 0; i < len(rs); i++ {
		if i > 0 {
			if rs[i].Group == rs[i - 1].Group {
				out = buf.Concat(out, " ")
			} else {
				out = buf.Concat(out, " | ")
			}
		}
		if !rs[i].Resolved { out = buf.Concat(out, "!") }
		out = buf.Concat(out, pendingKey(rs[i].Decl))
	}
	return out
}

// expectSummary fails unless the summary got is want.
func expectSummary(got *[]readonly char, want *[]readonly char) testing.TestResult {
	if types.CharEq(got, want) { return "" }
	return fail(
			buf.Concat(buf.Concat("retry: got `", got), buf.Concat("`, want `", buf.Concat(want, "`"))))
}

// Declaring the missing name resolves the parked declaration, binds it, and
// takes it off the parked list.
func TestPendingResolvedAfterDep() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() + 1 }")
	replCheckDecl(c, "func g() int { return 41 }")
	var r testing.TestResult = expectSummary(retrySummary(c), "f")
	if len(r) > 0 { return r }
	if c.IsPendingDecl("f") || c.Scope.Lookup("f") == nil {
		return fail("f must be resolved and bound")
	}
	return ""
}

// A declaration waiting on nothing declared yet is not checked.
func TestPendingNotReadyNotRetried() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = g() + 1")
	return expectSummary(retrySummary(c), "")
}

// Dependencies resolve first: with a parked on b and b on c, declaring c
// resolves b, then a.
func TestPendingDependenciesFirst() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func a() int { return b() + 1 }")
	replCheckDecl(c, "func b() int { return cc() + 10 }")
	replCheckDecl(c, "func cc() int { return 100 }")
	return expectSummary(retrySummary(c), "b | a")
}

// Mutually recursive functions park on each other and resolve together, in
// one group, as soon as the second is declared.
func TestPendingMutualRecursionResolvesTogether() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f(n int) int { if n == 0 { return 0 }; return g(n - 1) }")
	replCheckDecl(c, "func g(n int) int { if n == 0 { return 1 }; return f(n - 1) }")
	return expectSummary(retrySummary(c), "f g")
}

// Struct types that point at each other resolve together.
func TestPendingTypesViaPointersResolveTogether() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type A struct { Next @B }")
	replCheckDecl(c, "type B struct { Next @A }")
	var r testing.TestResult = expectSummary(retrySummary(c), "A B")
	if len(r) > 0 { return r }
	if c.Scope.Lookup("A") == nil || c.Scope.Lookup("B") == nil {
		return fail("A and B must be bound")
	}
	return ""
}

// Struct types that contain each other by value fail together: a group is
// checked with the by-value cycle check a file's types get.
func TestPendingByValueCycleFails() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type A struct { b B }")
	replCheckDecl(c, "type B struct { a A }")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 2 || rs[0].Resolved || len(rs[0].Errs) == 0 {
		return fail("A and B must fail together, with errors")
	}
	if !charsHaveSub(rs[0].Errs[0].Msg, "recursive type") {
		return fail(rs[0].Errs[0].Msg)
	}
	if c.Scope.Lookup("A") != nil || c.Scope.Lookup("B") != nil {
		return fail("a failed group must be undone")
	}
	return ""
}

// Variables whose initializers read each other fail together: a group is
// checked with the initialization-cycle check a file's variables get.
func TestPendingVarInitCycleFails() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var a int = b")
	replCheckDecl(c, "var b int = a")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 2 || rs[0].Resolved || len(rs[0].Errs) == 0 {
		return fail("a and b must fail together, with errors")
	}
	if !charsHaveSub(rs[0].Errs[0].Msg, "initialization cycle") {
		return fail(rs[0].Errs[0].Msg)
	}
	return ""
}

// A retry that finds every name declared but fails to check stays parked,
// undone; its errors are returned (not reported), and returned again only
// when they change.  A later declaration giving it what it expects resolves
// it.
func TestPendingRetryWithErrorStaysParked() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = y")
	replCheckDecl(c, "var y bool = true")
	var before int = len(c.CheckerErrors())
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 1 || rs[0].Resolved || len(rs[0].Errs) == 0 {
		return fail("x must fail, with its errors")
	}
	if len(c.CheckerErrors()) != before {
		return fail("a failed retry's errors are returned, not reported")
	}
	if !c.IsPendingDecl("x") || c.Scope.Lookup("x") != nil {
		return fail("x must stay parked, unbound")
	}
	rs = c.RetryPendingDecls()
	if len(rs) != 1 || rs[0].Resolved || len(rs[0].Errs) != 0 {
		return fail("the same failure must not be returned with errors again")
	}
	replCheckDecl(c, "var y int = 3")
	return expectSummary(retrySummary(c), "x")
}

// A group that finds a new missing name only once its first missing names
// are declared still resolves in the same sweep when a later group provides
// it: x misses T, then (T declared) T.M, provided by a method that parked on
// T too.
func TestPendingSweepRepeatsAfterResolution() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { c U }")
	replCheckDecl(c, "func x() int { var t T; return t.M() }")
	replCheckDecl(c, "func (t *T) M() int { return 1 }")
	replCheckDecl(c, "type U int")
	var got @[]char = retrySummary(c)
	if len(c.Pending) != 0 {
		return fail(buf.Concat("everything must resolve; retry: ", got))
	}
	return ""
}

// A resolved function that redefines one records the definition it replaces
// (the REPL replaces or shadows it).
func TestPendingResolvedRedefinitionRecordsPrev() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f(a int) int { return a }")
	replCheckDecl(c, "func f(a int, b int) int { return a + b + q }")
	replCheckDecl(c, "var q int = 1")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 1 || !rs[0].Resolved {
		return fail("f must resolve")
	}
	if rs[0].PrevFunc == nil || len(rs[0].PrevFunc.Params) != 1 {
		return fail("f must record the one-parameter definition it replaces")
	}
	return ""
}

// A parked const-group member resolves at its iota.
func TestPendingConstGroupRespectsIotaOnRetry() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const (\n  A int = iota\n  B int = M + iota\n)")
	var pd @types.PendingDecl = lookupPending(c, "B")
	if pd == nil || pd.IotaIdx != 1 {
		return fail("B must park at iota 1")
	}
	replCheckDecl(c, "const M int = 10")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 1 || !rs[0].Resolved || rs[0].IotaIdx != 1 {
		return fail("B must resolve at iota 1")
	}
	return ""
}

// A bare const-group member after a parked member repeats that member's
// initializer, so it parks too (at its own iota) and resolves with it.
func TestPendingConstGroupBareMemberRepeatsParkedExpr() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const (\n  B0 int = M << iota\n  B1\n)")
	var pd @types.PendingDecl = lookupPending(c, "B1")
	if !c.IsPendingDecl("B0") || pd == nil || pd.IotaIdx != 1 {
		return fail("B0 and the bare B1 (at iota 1) must park")
	}
	replCheckDecl(c, "const M int = 2")
	var r testing.TestResult = expectSummary(retrySummary(c), "B0 | B1")
	if len(r) > 0 { return r }
	var sym @Symbol = c.Scope.Lookup("B1")
	if sym == nil || sym.Kind != types.SYM_CONST {
		return fail("B1 must resolve to a const")
	}
	return ""
}

// A const-group member resolves in a group with the declarations it depends
// on and that depend on it (a const reading `len` of an array variable is
// constant, so this is no constant cycle).
func TestPendingConstGroupMemberInGroup() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const (\n  A = len(v)\n)")
	replCheckDecl(c, "var v [3]int = mk()")
	replCheckDecl(c, "func mk() [3]int { var a [3]int; a[0] = A; return a }")
	var got @[]char = retrySummary(c)
	if len(c.Pending) != 0 {
		return fail(buf.Concat("A, v and mk must resolve; retry: ", got))
	}
	return ""
}

// A variable read while a group's types are collected, whose initializer
// calls a method of the group declared after it, is checked then: the method
// is defined on demand (batchMethodOnDemand), and the group resolves.
func TestPendingVarNeededDuringCollectionResolvesThroughMethod() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type R struct { n int }")
	replCheckDecl(c, "var r R")
	replCheckDecl(c, "var w = r.mk()")
	replCheckDecl(c, "type S struct { a [len(w)]int }")
	replCheckDecl(c, "func (x R) mk() [2]int { var s S; _ = s; return [2]int{1, 2} }")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 3 || !rs[0].Resolved || len(c.Pending) != 0 {
		return fail("w, S and mk must resolve together")
	}
	return ""
}

// So does one with a function in mk's place.
func TestPendingVarNeededDuringCollectionResolves() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var w = mk()")
	replCheckDecl(c, "type S struct { a [len(w)]int }")
	replCheckDecl(c, "func mk() [2]int { var s S; _ = s; return [2]int{1, 2} }")
	var rs @[]@types.RetriedDecl = c.RetryPendingDecls()
	if len(rs) != 3 || !rs[0].Resolved || len(c.Pending) != 0 {
		return fail("w, S and mk must resolve together")
	}
	return ""
}

// A forward declaration of a parked definition's type keeps the definition
// parked: once what it waits on is declared, it is retried and fills the type.
func TestForwardDeclKeepsParkedDefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type F Y")
	replCheckDecl(c, "type F")
	if !c.IsPendingDecl("F") { return fail("the definition of F must stay parked") }
	replCheckDecl(c, "type Y int")
	var r testing.TestResult = expectSummary(retrySummary(c), "F")
	if len(r) > 0 { return r }
	if c.Scope.Lookup("F").Type.Underlying == nil { return fail("F must be filled") }
	return ""
}

// A declaration parked on a field of a forward-declared type is retried once the
// type's definition provides the field.
func TestPendingFieldOfForwardTypeRetried() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type F")
	replCheckDecl(c, "func g(p *F) int { return p.n }")
	if !c.IsPendingDecl("g") { return fail("g must park on F.n") }
	replCheckDecl(c, "type F struct { n int }")
	return expectSummary(retrySummary(c), "g")
}

// So is one parked on a field the type reaches through a named struct, or a
// generic struct's instance.
func TestPendingFieldThroughNamedUnderlyingRetried() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Y struct { n int }")
	replCheckDecl(c, "type F")
	replCheckDecl(c, "func g(p *F) int { return p.n }")
	replCheckDecl(c, "type F Y")
	var r testing.TestResult = expectSummary(retrySummary(c), "g")
	if len(r) > 0 { return r }
	replCheckDecl(c, "type G[T any] struct { m T }")
	replCheckDecl(c, "type H")
	replCheckDecl(c, "func h(p *H) int { return p.m }")
	replCheckDecl(c, "type H G[int]")
	return expectSummary(retrySummary(c), "h")
}

// loadCalls records, for a test, the first member of each group handed to
// failToLoad or loadAll.
var loadCalls @[]@types.RetriedDecl

// failToLoad is a group loader under which no group loads.
func failToLoad(group @[]@types.RetriedDecl) @[]@[]char {
	loadCalls = slices.Append[@types.RetriedDecl](loadCalls, group[0])
	var errs @[]@[]char = make_slice(@[]char, 1)
	errs[0] = buf.CopyStr("it needs what nothing defines")
	return errs
}

// loadAll is a group loader under which every group loads.
func loadAll(group @[]@types.RetriedDecl) @[]@[]char {
	loadCalls = slices.Append[@types.RetriedDecl](loadCalls, group[0])
	var none @[]@[]char
	return none
}

// A group that resolves but does not load is undone and parked again with its
// load errors: it binds nothing, a use of it says so, and what depends on it
// stays parked on it.  The next sweep hands its loader the errors it last failed
// with; once it loads, what depends on it resolves.
func TestPendingLoadFailureReparks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() + 1 }")
	replCheckDecl(c, "func h() int { return f() }")
	replCheckDecl(c, "func g() int { return 41 }")
	var none @[]@types.RetriedDecl
	loadCalls = none
	var rs @[]@types.RetriedDecl = c.RetryPendingDeclsLoading(failToLoad)
	if len(rs) != 1 || rs[0].Resolved || !types.CharEq(rs[0].Decl.Name, "f") || len(loadCalls) != 1 ||
			len(loadCalls[0].PrevLoadErrs) != 0 {
		return fail("f alone should be retried, fail to load, and have no earlier load errors")
	}
	if !c.IsPendingDecl("f") || c.Scope.Lookup("f") != nil || !c.IsPendingDecl("h") {
		return fail("f should be parked again, unbound, and h stay parked")
	}
	if !types.CharEq(pendingMissing(c, "h"), "f") {
		return fail("h should still miss f")
	}
	replCheckStmts(c, "_ = f()")
	var r testing.TestResult = expectErrSub(c, "function f is unresolved (it does not load)")
	if len(r) > 0 { return r }
	loadCalls = none
	rs = c.RetryPendingDeclsLoading(loadAll)
	if len(loadCalls) != 2 || len(loadCalls[0].PrevLoadErrs) != 1 ||
			!types.CharEq(loadCalls[0].PrevLoadErrs[0], "it needs what nothing defines") {
		return fail("the next sweep should hand f's loader the errors it failed with")
	}
	if len(rs) != 2 || !rs[0].Resolved || !rs[1].Resolved || c.IsPendingDecl("f") ||
			c.IsPendingDecl("h") || c.Scope.Lookup("h") == nil {
		return fail("f, then h, should resolve")
	}
	return ""
}
