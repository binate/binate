package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/constval"
import "pkg/binate/types"
import "pkg/stdx/slices"

// REPL declarations checked with errors and unbound names captured
// (TentativeMode): a group of declarations checked together as a file's
// declarations are, and a const group checked member by member.

// checkDeclsTentative checks members together, capturing errors in
// c.TentativeErrors and the names they use but nothing binds in
// c.TentativeMissing.  They are checked as one declaration batch — the
// declaration pass over all of them first, so mutually referring
// declarations see each other, then every body and initializer, then the
// checks a file's declarations get as a whole: by-value type cycles and
// value embedding, constant cycles, variable initialization cycles.  A
// member of a const group is checked at the iota of its position in its
// group (iotas[i] >= 0; c.IotaDecls).  Everything the members bind stays
// bound: the caller undoes it if they park or fail.
func checkDeclsTentative(c @Checker, members *[]@ast.Decl, iotas *[]int) {
	var emptyMissing @[]@[]char
	c.TentativeMissing = emptyMissing
	var emptyTentErrs @[]types.CheckError
	c.TentativeErrors = emptyTentErrs
	c.TentativeMode = true
	var noIotaDecls @[]@ast.Decl
	var noIotas @[]int
	c.IotaDecls = noIotaDecls
	c.Iotas = noIotas
	for i := 0; i < len(members); i++ {
		if iotas[i] >= 0 {
			c.IotaDecls = slices.Append[@ast.Decl](c.IotaDecls, members[i])
			c.Iotas = slices.Append[int](c.Iotas, iotas[i])
		}
	}
	var decls *[]@ast.Decl = members
	var savedRepl bool = c.ReplDeclMode
	c.ReplDeclMode = false
	_ = rejectTypeRedefinitions(c, decls)
	collectDecls(c, decls)
	checkValueEmbedding(c, decls)
	finishDeclBatch(c)
	checkDecls(c, decls)
	c.Batch = nil
	c.ReplDeclMode = savedRepl
	c.TentativeMode = false
	c.IotaDecls = noIotaDecls
	c.Iotas = noIotas
}

// rejectTypeRedefinitions reports each type declaration whose name the
// session scope already binds to a type (other than a forward-declared `type
// T` the declaration fills), and reports whether there was one.  A generic
// type's placeholder, which has no Underlying either, is a definition.  A redefinition
// would have to leave the values and code of the old type on the old layout,
// which the REPL cannot yet express: types are identified by name.
func rejectTypeRedefinitions(c @Checker, decls *[]@ast.Decl) bool {
	var found bool = false
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_TYPE || isBlank(d.Name) || d.IsForward {
			continue
		}
		var sym @Symbol = declScope(c).LookupLocal(d.Name)
		if sym == nil || sym.Kind != types.SYM_TYPE || sym.Type == nil {
			continue
		}
		if sym.Type.Kind == types.TYP_NAMED && sym.Type.Underlying == nil &&
				lookupGenericTypeDeclPkg(c, "", d.Name) == nil {
			continue
		}
		addCheckError(c, d.Pos, buf.Concat("cannot redefine type ", d.Name))
		found = true
	}
	return found
}

// checkGroupDeclTentative checks a `const ( ... )` group typed at the prompt
// member by member, in order, each at its iota (checkDeclsTentative).  A
// member that uses names not yet declared parks alone, with its iota: it is
// unbound while the members after it are checked, so one that uses it parks
// on it too, and gets back its binding before the group (per r) only after
// them.  The others resolve.  A bare member repeats the previous explicit
// member's initializer (spec §9.1 decl.const), so it is checked — and parks
// — as a synthesized declaration carrying that initializer.  Errors of
// members that do not park are the user's and are reported.
func checkGroupDeclTentative(c @Checker, d @ast.Decl, r @DeclRollback) {
	var parked @[]@[]char
	var prevExpr @ast.Expr = nil
	var prevTypeRef @ast.TypeExpr = nil
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		// A bare member repeats the previous explicit member's type (none for
		// an untyped one) and initializer (spec §9.1 decl.const), as in
		// checkGroupDecl / genConstGroup.  Carrying the type on the
		// synthesized repeat means a bare member is range-checked at it and,
		// when parked, resolves at it on retry.
		if m.Kind == ast.DECL_CONST && m.Value != nil {
			prevTypeRef = m.TypeRef
		}
		// A first bare member (no prevExpr) keeps the plain-iota fallback in
		// checkConstDecl.
		var member @ast.Decl = m
		if m.Kind == ast.DECL_CONST && m.Value == nil && prevExpr != nil {
			var rep @ast.Decl = make(ast.Decl)
			rep.Kind = ast.DECL_CONST
			rep.Name = m.Name
			rep.Value = prevExpr
			rep.TypeRef = prevTypeRef
			rep.Pos = m.Pos
			member = rep
		}
		var one @[]@ast.Decl = make_slice(@ast.Decl, 1)
		one[0] = member
		var iotas @[]int = make_slice(int, 1)
		iotas[0] = -1
		if m.Kind == ast.DECL_CONST {
			iotas[0] = constGroupIota(d, i)
		}
		checkDeclsTentative(c, one, iotas)
		// The value was recorded on the synthesized repeat; IR-gen reads it
		// from the member itself.
		if member != m {
			var mv constval.Value
			var mst int
			var have bool
			mv, mst, have = c.DeclConst(member)
			if have {
				recordDeclConst(c, m, mv, mst)
			}
		}
		if len(c.TentativeMissing) > 0 {
			if !isBlank(m.Name) {
				declScope(c).Undefine(m.Name)
				parked = slices.Append[@[]char](parked, m.Name)
			}
			parkPendingDeclMember(c, member, c.TentativeMissing, iotas[0])
		} else {
			migrateTentativeErrors(c)
		}
		if m.Kind == ast.DECL_CONST && m.Value != nil {
			prevExpr = m.Value
		}
	}
	for i := 0; i < len(parked); i++ {
		restoreName(c, r, parked[i])
	}
}
