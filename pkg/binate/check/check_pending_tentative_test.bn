package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for REPL declarations that park on a type not yet declared: a type
// declaration (struct, alias, named non-struct), and a variable, function
// signature or method receiver that names a parked type — the declaration
// pass of a REPL declaration captures unbound names like its bodies do.

// A struct type whose field names an undefined type parks, unbound.
func TestPendingStructTypeParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { F Bag }")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors for parked type")
	}
	if !types.CharEq(pendingMissing(c, "T"), "Bag") {
		return fail(buf.Concat("T must park on Bag, got: ", pendingMissing(c, "T")))
	}
	if c.Scope.Lookup("T") != nil {
		return fail("a parked T must not be bound")
	}
	return ""
}

// The missing type arriving resolves the struct with its layout.
func TestPendingStructTypeResolves() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { F Bag }")
	replCheckDecl(c, "type Bag struct { N int }")
	var r testing.TestResult = expectSummary(retrySummary(c), "T")
	if len(r) > 0 { return r }
	var sym @Symbol = c.Scope.Lookup("T")
	if sym == nil || sym.Type.Underlying == nil {
		return fail("T must be bound with its layout")
	}
	return ""
}

// An alias of an undefined type parks and resolves when the type arrives.
func TestPendingAliasResolves() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type R = Bag")
	if !c.IsPendingDecl("R") {
		return fail("setup: alias R should park (Bag undefined)")
	}
	replCheckDecl(c, "type Bag struct { N int }")
	return expectSummary(retrySummary(c), "R")
}

// A named non-struct type over an undefined type parks and resolves.
func TestPendingNamedNonStructResolves() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Celsius Heat")
	if !c.IsPendingDecl("Celsius") {
		return fail("setup: named-non-struct should park (Heat undefined)")
	}
	replCheckDecl(c, "type Heat int")
	return expectSummary(retrySummary(c), "Celsius")
}

// A variable of a parked type parks on it.
func TestPendingVarOfParkedTypeParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { F Bag }")
	replCheckDecl(c, "var x T")
	if !types.CharEq(pendingMissing(c, "x"), "T") {
		return fail(buf.Concat("x must park on T, got: ", pendingMissing(c, "x")))
	}
	return ""
}

// A function whose signature names a parked type parks on it (the
// signature is checked with unbound names captured too).
func TestPendingTypeFuncSigParksFunc() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { F Bag }")
	replCheckDecl(c, "func f(x T) int { return 0 }")
	if !types.CharEq(pendingMissing(c, "f"), "T") {
		return fail(buf.Concat("f must park on T, got: ", pendingMissing(c, "f")))
	}
	return ""
}

// A method whose receiver is a parked type parks on it, and resolves after
// the type does.
func TestPendingMethodOnPendingReceiver() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { F Bag }")
	replCheckDecl(c, "func (t *T) M() int { return 0 }")
	if !c.IsDeclPending() {
		return fail("method M must park (receiver T is parked)")
	}
	replCheckDecl(c, "type Bag struct { N int }")
	return expectSummary(retrySummary(c), "T | T.M")
}

// A declaration that fills a forward-declared type and parks leaves the type
// unfilled; it fills it when it resolves.
func TestPendingForwardTypeFillUndone() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T")
	replCheckDecl(c, "type T struct { x Missing; y int }")
	if !c.IsPendingDecl("T") {
		return fail("the definition of T must park")
	}
	if c.Scope.Lookup("T").Type.Underlying != nil {
		return fail("the parked definition must not leave T filled")
	}
	replCheckDecl(c, "type Missing int")
	var r testing.TestResult = expectSummary(retrySummary(c), "T")
	if len(r) > 0 { return r }
	if c.Scope.Lookup("T").Type.Underlying == nil {
		return fail("T must be filled once its definition resolves")
	}
	return ""
}

// replCheckDeclUndo checks one declaration as the REPL does: one that fails
// to check is undone (SnapshotDecl / RollbackDecl).
func replCheckDeclUndo(c @Checker, src *[]readonly char) {
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	var r @DeclRollback = c.SnapshotDecl(d)
	var before int = len(c.CheckerErrors())
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) > before {
		c.RollbackDecl(r)
	}
}

// A definition of a forward-declared type that fails at its prompt, undone,
// leaves the type unfilled, so a correct definition is accepted after it.
func TestFailedForwardTypeFillUndone() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var v int")
	replCheckDecl(c, "type T")
	replCheckDeclUndo(c, "type T struct { x v; y int }")
	var before int = len(c.CheckerErrors())
	if before == 0 {
		return fail("setup: a field of non-type v must be rejected")
	}
	if c.Scope.Lookup("T").Type.Underlying != nil {
		return fail("the failed definition must not leave T filled")
	}
	replCheckDecl(c, "type T struct { a int }")
	if len(c.CheckerErrors()) != before {
		return fail(c.CheckerErrors()[before].Msg)
	}
	return ""
}
