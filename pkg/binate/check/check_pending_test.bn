package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for parking a REPL declaration (check_pending.bn): what parks, that a
// parked declaration binds nothing, how a use of one parks or is reported, and
// which older parked declarations a newer one replaces.  The retry sweep's
// tests are in check_pending_retry_test.bn.

// sessionChecker returns a checker holding a REPL session: a loaded, empty
// main package whose scope later declarations are checked in.
func sessionChecker() @Checker {
	var p @parser.Parser = parser.New(toBytes("package \"main\"\n"), "main.bn")
	var c @Checker = NewChecker()
	c.CheckMainPersistent(p.ParseFile())
	return c
}

// replCheckDecl parses and checks one top-level decl in the persistent checker's
// scope — the per-input step a REPL driver performs.
func replCheckDecl(c @Checker, src *[]readonly char) {
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
}

// replCheckStmts parses and checks a statement list typed at the prompt.
func replCheckStmts(c @Checker, src *[]readonly char) {
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	c.CheckStmtListInScope(p.ParseStmtList())
}

// pendingMissing returns the missing names of the parked declaration
// providing key, joined by ", ", or "<not parked>".
func pendingMissing(c @Checker, key *[]readonly char) @[]char {
	var pd @types.PendingDecl = lookupPending(c, key)
	if pd == nil { return "<not parked>" }
	var out @[]char = ""
	for i := 0; i < len(pd.MissingNames); i++ {
		if i > 0 { out = buf.Concat(out, ", ") }
		out = buf.Concat(out, pd.MissingNames[i])
	}
	return out
}

// A function whose body uses an undefined name parks, with no error, and
// binds nothing.
func TestPendingForwardRefParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() + 1 }")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors")
	}
	if !c.IsDeclPending() || !c.IsPendingDecl("f") {
		return fail("f must park")
	}
	if c.Scope.Lookup("f") != nil {
		return fail("a parked f must not be bound")
	}
	return ""
}

// The errors that follow a missing name (calling a non-function, adding to it)
// are noise and are not reported when the declaration parks.
func TestPendingTentativeBodyHidesCascade() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() + 1 }")
	if len(c.CheckerErrors()) != 0 {
		return fail("cascading errors should be hidden when parked")
	}
	return ""
}

// Calling a parked function at the prompt reports it unresolved, naming what
// it waits on.
func TestPendingUseSiteError() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return g() }")
	replCheckStmts(c, "f()")
	return expectErrSub(c, "function f is unresolved (pending: g)")
}

// Reading a parked variable at the prompt reports it unresolved.
func TestPendingVarUseSiteError() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = g() + 1")
	if !c.IsPendingDecl("x") || c.Scope.Lookup("x") != nil {
		return fail("setup: x must park, unbound")
	}
	replCheckStmts(c, "_ = x")
	return expectErrSub(c, "variable x is unresolved (pending: g)")
}

// A typed constant whose value uses an undefined name parks.
func TestPendingConstParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const N int = M + 1")
	if len(c.CheckerErrors()) != 0 || !c.IsPendingDecl("N") || c.Scope.Lookup("N") != nil {
		return fail("N must park, unbound, with no error")
	}
	return ""
}

// Each member of a const group parks alone: A resolves, B (using an undefined
// M) parks and is unbound.
func TestPendingConstGroupPerMember() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const (\n  A int = 1\n  B int = M + 1\n)")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors")
	}
	if c.IsPendingDecl("A") || c.Scope.Lookup("A") == nil {
		return fail("A must resolve")
	}
	if !c.IsPendingDecl("B") || c.Scope.Lookup("B") != nil {
		return fail("B must park, unbound")
	}
	if len(c.Pending) - c.PendingMark != 1 {
		return fail("expected one freshly-parked decl (B)")
	}
	return ""
}

// A declaration that uses a parked one parks on it — it is not emitted
// against a declaration that may never be.
func TestPendingDependentParksOnParked() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return y }")
	replCheckDecl(c, "func g() int { return f() }")
	if !types.CharEq(pendingMissing(c, "g"), "f") {
		return fail(buf.Concat("g must park on f, got: ", pendingMissing(c, "g")))
	}
	return ""
}

// A pointer to a parked type parks too: the type may never be declared.
func TestPendingPointerToParkedTypeParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { c U }")
	replCheckDecl(c, "var p *T")
	if !types.CharEq(pendingMissing(c, "p"), "T") {
		return fail(buf.Concat("p must park on T, got: ", pendingMissing(c, "p")))
	}
	return ""
}

// A parked constant used as an array length parks the declaration using it.
func TestPendingConstInArrayLengthParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const N int = M")
	replCheckDecl(c, "var a [N]int")
	if len(c.CheckerErrors()) != 0 {
		return fail(c.CheckerErrors()[0].Msg)
	}
	if !types.CharEq(pendingMissing(c, "a"), "N") {
		return fail(buf.Concat("a must park on N, got: ", pendingMissing(c, "a")))
	}
	return ""
}

// A parked method is missing from its type's method set: a call of it parks
// the caller on `T.M`, and a call at the prompt reports it unresolved.
func TestPendingMethodUseParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { a int }")
	replCheckDecl(c, "func (t *T) M() int { return t.a + q }")
	if !types.CharEq(pendingMissing(c, "T.M"), "q") {
		return fail(buf.Concat("T.M must park on q, got: ", pendingMissing(c, "T.M")))
	}
	replCheckDecl(c, "func h(t *T) int { return t.M() }")
	if !types.CharEq(pendingMissing(c, "h"), "T.M") {
		return fail(buf.Concat("h must park on T.M, got: ", pendingMissing(c, "h")))
	}
	replCheckDecl(c, "var x T")
	replCheckStmts(c, "x.M()")
	return expectErrSub(c, "method T.M is unresolved (pending: q)")
}

// A parked redefinition leaves the definition it would replace bound until
// it resolves.
func TestPendingParkedRedefinitionKeepsOld() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return 1 }")
	var old @Symbol = c.Scope.Lookup("f")
	replCheckDecl(c, "func f() int { return q }")
	if !c.IsPendingDecl("f") {
		return fail("the redefinition must park")
	}
	if !same(c.Scope.Lookup("f"), old) {
		return fail("f must stay bound to its earlier definition")
	}
	return ""
}

// A declaration that resolves drops an older parked declaration of its name,
// which would otherwise rebind the name when it resolved later.
func TestPendingRedefinitionDropsStaleEntry() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = y")
	replCheckDecl(c, "var x int = 5")
	if c.IsPendingDecl("x") {
		return fail("the resolved x must replace the parked one")
	}
	replCheckDecl(c, "var y int = 2")
	if len(c.RetryPendingDecls()) != 0 {
		return fail("nothing is left to retry")
	}
	return ""
}

// A declaration that fails at its prompt replaces nothing: the older parked
// declaration of its name stays parked.
func TestPendingFailedDeclDropsNothing() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var x int = y")
	replCheckDecl(c, "var x int = true")
	if len(c.CheckerErrors()) == 0 {
		return fail("setup: `var x int = true` must fail")
	}
	if !c.IsPendingDecl("x") {
		return fail("the parked x must stay parked")
	}
	return ""
}

// Redefining a type is rejected at its prompt — also when the new definition
// uses a name not yet declared (it is not parked).
func TestReplTypeRedefinitionRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { a int }")
	replCheckDecl(c, "type T struct { b int; c U }")
	if c.IsPendingDecl("T") {
		return fail("a type redefinition must not park")
	}
	return expectErrSub(c, "cannot redefine type T")
}

// A user-facing generic instantiation performed while checking a decl that then
// PARKS (a forward reference) routes its diagnostics to c.TentativeErrors, which
// are DISCARDED when the decl parks.  The (decl, args) cache entry must NOT latch
// its diagnostics-reported flag (GenericInstantiation.ConstraintsChecked) in that
// case, or a later real use is stranded — the deferred re-check is skipped and a
// genuine opaque-by-value / constraint miss is silently accepted.  The two tests
// below exercise the shared latch (gated on !c.TentativeMode) for the size and the
// constraint diagnostic respectively.

// Size (opaque-by-value) variant: `Holder`'s field `s @Sink[Op]` instantiates
// Sink[Op] user-facing under TentativeMode, then field `m Missing` parks the type
// so the opaque error is discarded; the later real `direct` use must still report
// it (the latch must not have stuck).
func TestReplParkedIfaceInstDoesNotStrandOpaqueError() testing.TestResult {
	var c @Checker = NewChecker()
	replCheckDecl(c, "type Op")
	replCheckDecl(c, "interface Sink[T any] { put(t T) }")
	replCheckDecl(c, "type Holder struct { s @Sink[Op]; m Missing }")
	if !c.IsPendingDecl("Holder") {
		return fail("setup: Holder should park on undefined Missing")
	}
	replCheckDecl(c, "func direct(s @Sink[Op]) {}")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// Constraint variant: `Holder2`'s field `b Box[int]` instantiates Box[int] (int
// does not satisfy Marker) user-facing under TentativeMode, then field `mm Missing`
// parks the type; the later real `direct2` use must still report the constraint
// miss.
func TestReplParkedGenericInstDoesNotStrandConstraintMiss() testing.TestResult {
	var c @Checker = NewChecker()
	replCheckDecl(c, "interface Marker { m() }")
	replCheckDecl(c, "type Box[T Marker] struct { x T }")
	replCheckDecl(c, "type Holder2 struct { b Box[int]; mm Missing }")
	if !c.IsPendingDecl("Holder2") {
		return fail("setup: Holder2 should park on undefined Missing")
	}
	replCheckDecl(c, "func direct2(b Box[int]) {}")
	return expectErrSub(c, "does not satisfy constraint")
}

// A miss that no later declaration can satisfy — a field of a non-session
// struct type — is an error, not a forward reference to park on.
func TestPendingFieldMissIsError() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func g(p *struct{ x int }) int { return p.y }")
	if c.IsPendingDecl("g") {
		return fail("g must not park on a field name")
	}
	return expectErrSub(c, "undefined: y")
}

// A field miss on a session type is reported as such at the prompt, not as
// a parked declaration of the same name.
func TestPendingFieldMissNotParkedDecl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func Println() int { return zz }")
	replCheckDecl(c, "type S struct { a int }")
	replCheckDecl(c, "var s S")
	replCheckStmts(c, "s.Println = 3")
	return expectErrSub(c, "undefined: Println")
}

// Redefining a generic type is rejected like any type (its placeholder is a
// definition, not a forward declaration).
func TestReplGenericTypeRedefinitionRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "type Box[T any] struct { a int; v T }")
	var r testing.TestResult = expectErrSub(c, "cannot redefine type Box")
	if len(r) > 0 { return r }
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "type Box struct { a int }")
	if len(c.CheckerErrors()) == before {
		return fail("a struct over the generic Box must be rejected too")
	}
	return ""
}

// A parked method of a generic type binds nothing, and is waited on by its
// key `Box.Get`, also through an instantiation.
func TestPendingGenericMethodParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "func (b *Box[T]) Get() T { zz(); return b.v }")
	if !types.CharEq(pendingMissing(c, "Box.Get"), "zz") {
		return fail(buf.Concat("Box.Get must park on zz, got: ", pendingMissing(c, "Box.Get")))
	}
	if c.Scope.Lookup("Box").Type.LookupMethod("Get") != nil {
		return fail("the parked Get must not be in Box's method set")
	}
	replCheckDecl(c, "func use(bb *Box[int]) int { return bb.Get() }")
	if !types.CharEq(pendingMissing(c, "use"), "Box.Get") {
		return fail(buf.Concat("use must park on Box.Get, got: ", pendingMissing(c, "use")))
	}
	return ""
}

// In a const group, a member after a parked member that uses it parks on it
// — it does not bind to an earlier definition of that name.
func TestPendingConstGroupLaterMemberWaits() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const A = 1")
	replCheckDecl(c, "const (\n  A = K\n  B = A + 1\n)")
	if !types.CharEq(pendingMissing(c, "B"), "A") {
		return fail(buf.Concat("B must park on A, got: ", pendingMissing(c, "B")))
	}
	if c.Scope.Lookup("A") == nil {
		return fail("A must keep its earlier definition while parked")
	}
	replCheckDecl(c, "const K = 100")
	return expectSummary(retrySummary(c), "A | B")
}

// A const-group member's declared type is checked with unbound names
// captured, like its value.
func TestPendingConstGroupTypeParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "const (\n  B Missing2 = 1\n  C = 2\n)")
	if len(c.CheckerErrors()) != 0 {
		return fail(c.CheckerErrors()[0].Msg)
	}
	if !types.CharEq(pendingMissing(c, "B"), "Missing2") || c.IsPendingDecl("C") {
		return fail("B must park on Missing2, and C resolve")
	}
	return ""
}

// `len` of an unbound name in an array length parks the declaration.
func TestPendingLenInArrayLengthParks() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { a [len(v)]int }")
	if len(c.CheckerErrors()) != 0 {
		return fail(c.CheckerErrors()[0].Msg)
	}
	if !types.CharEq(pendingMissing(c, "T"), "v") {
		return fail(buf.Concat("T must park on v, got: ", pendingMissing(c, "T")))
	}
	return ""
}
