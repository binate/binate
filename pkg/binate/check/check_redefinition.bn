package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"

// Redefinitions at the REPL prompt that the REPL does not support.  A
// function, variable or constant may be redefined — replaced, or shadowed —
// but a type or an interface may not: types and interfaces are identified by
// name (the checker's and IR-gen's registries key on it), so a redefinition
// would have to leave the values and code of the old one on the old layout,
// which the REPL cannot yet express.  That covers giving a type's or an
// interface's name to anything else, and giving any other name to a type or
// an interface: a later declaration of the old kind would find the old
// registration.

// rejectAtPrompt reports each of decls the REPL does not support
// (rejectRedefinitions, rejectGenericImpls), and reports whether there was
// one.  Such a declaration is rejected at its prompt, not parked, and fails if
// it was parked.
func rejectAtPrompt(c @Checker, decls *[]@ast.Decl) bool {
	var redef bool = rejectRedefinitions(c, decls)
	var generic bool = rejectGenericImpls(c, decls)
	return redef || generic
}

// rejectGenericImpls reports each impl of decls on a generic type (`impl
// *Box[T] : I`), and reports whether there was one: its methods are
// generic-receiver methods, which the prompt does not support.
func rejectGenericImpls(c @Checker, decls *[]@ast.Decl) bool {
	var found bool = false
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_IMPL &&
				(receiverBaseInstantiation(d.TypeRef) != nil || implRecvIsInstance(c, d)) {
			addCheckError(c, d.Pos, "impl declarations on a generic type are not supported at the prompt")
			found = true
		}
	}
	return found
}

// implRecvIsInstance reports whether impl d's receiver names, through an
// alias, an instance of a generic type (`type CI = Cur[int]; impl *CI : I`).
func implRecvIsInstance(c @Checker, d @ast.Decl) bool {
	var name @[]char = typeExprBaseName(d.TypeRef)
	if len(name) == 0 { return false }
	var sym @Symbol = c.Scope.Lookup(name)
	if sym == nil || sym.Kind != types.SYM_TYPE || sym.Type == nil { return false }
	var base @types.Type = sym.Type.ReceiverBaseNamed()
	return base != nil && base.InstDecl != nil
}

// rejectRedefinitions reports each of decls that redefines a type or an
// interface, declares one over another kind of name, or declares another kind
// of entity over one (redefinitionError), and reports whether there was one.
func rejectRedefinitions(c @Checker, decls *[]@ast.Decl) bool {
	var found bool = false
	for i := 0; i < len(decls); i++ {
		var msg @[]char = redefinitionError(c, decls[i])
		if len(msg) > 0 {
			addCheckError(c, decls[i].Pos, msg)
			found = true
		}
	}
	return found
}

// redefinitionError returns the error for declaration d when the session
// already uses its name for something and a type or an interface is on either
// side — "cannot redefine type T", or "cannot redefine interface I as a
// constant" across kinds — or empty.  A forward-declared `type T` that a type
// declaration fills is not a redefinition; an alias cannot fill it.
func redefinitionError(c @Checker, d @ast.Decl) @[]char {
	if d.Kind == ast.DECL_TYPE && d.IsAlias && isSessionForwardType(c, d.Name) {
		return forwardAliasMsg(d.Name)
	}
	var newKind @[]char = declKindNoun(d)
	if len(newKind) == 0 { return "" }
	var oldKind @[]char = sessionNameKind(c, d)
	if len(oldKind) == 0 { return "" }
	if !isTypeKindNoun(newKind) && !isTypeKindNoun(oldKind) { return "" }
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cannot redefine ")
	cb.Write(oldKind)
	cb.Write(" ")
	cb.Write(d.Name)
	if !types.CharEq(newKind, oldKind) {
		cb.Write(" as ")
		cb.Write(withArticle(newKind))
	}
	return buf.CopyStr(cb.String())
}

// declKindNoun returns the kind of entity a prompt declaration binds its name
// to ("type", "interface", "constant", "variable", "function"), or empty when
// it binds no name (a blank one, a method, an impl, a forward declaration).
func declKindNoun(d @ast.Decl) @[]char {
	if isBlank(d.Name) || len(d.Name) == 0 { return "" }
	if d.Kind == ast.DECL_TYPE && !d.IsForward { return "type" }
	if d.Kind == ast.DECL_INTERFACE { return "interface" }
	if d.Kind == ast.DECL_CONST { return "constant" }
	if d.Kind == ast.DECL_VAR { return "variable" }
	if d.Kind == ast.DECL_FUNC && d.Recv == nil { return "function" }
	return ""
}

// sessionNameKind returns what the session uses declaration d's name for
// ("type", "interface", "constant", "variable", "function", "package") — a
// generic type or interface is stashed, not bound — or empty when nothing.  A
// forward-declared type counts as nothing for a type declaration, which
// fills it.
func sessionNameKind(c @Checker, d @ast.Decl) @[]char {
	if lookupGenericIfaceDeclPkg(c, "", d.Name) != nil { return "interface" }
	if lookupGenericTypeDeclPkg(c, "", d.Name) != nil { return "type" }
	var sym @Symbol = declScope(c).LookupLocal(d.Name)
	if sym == nil { return "" }
	if sym.Kind == types.SYM_TYPE {
		if isSessionForwardType(c, d.Name) && d.Kind == ast.DECL_TYPE { return "" }
		return "type"
	}
	if sym.Kind == types.SYM_INTERFACE { return "interface" }
	if sym.Kind == types.SYM_CONST { return "constant" }
	if sym.Kind == types.SYM_VAR { return "variable" }
	if sym.Kind == types.SYM_FUNC { return "function" }
	if sym.Kind == types.SYM_PKG { return "package" }
	return ""
}

// isTypeKindNoun reports whether a kind noun names a type or an interface.
func isTypeKindNoun(kind *[]readonly char) bool {
	return types.CharEq(kind, "type") || types.CharEq(kind, "interface")
}

// withArticle returns a kind noun with its indefinite article.
func withArticle(kind *[]readonly char) @[]char {
	if types.CharEq(kind, "interface") { return buf.Concat("an ", kind) }
	return buf.Concat("a ", kind)
}

// isSessionForwardType reports whether the session's `name` is a type only
// forward-declared so far (`type T`).  A generic type or interface also leaves
// a named type with no underlying under its name, so the stashed generics are
// excluded.
func isSessionForwardType(c @Checker, name *[]readonly char) bool {
	if lookupGenericIfaceDeclPkg(c, "", name) != nil || lookupGenericTypeDeclPkg(c, "", name) != nil {
		return false
	}
	return isForwardDeclaredType(declScope(c).LookupLocal(name))
}
