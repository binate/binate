package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_redefinition.bn: redefinitions of types and interfaces at
// the REPL prompt, and declarations across kinds with a type or an interface
// on either side, are rejected.  sessionChecker / replCheckDecl live in
// check_pending_test.bn.

// Redefining a type is rejected at its prompt — also when the new definition
// uses a name not yet declared (it is not parked).
func TestReplTypeRedefinitionRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { a int }")
	replCheckDecl(c, "type T struct { b int; c U }")
	if c.IsPendingDecl("T") {
		return fail("a type redefinition must not park")
	}
	return expectErrSub(c, "cannot redefine type T")
}

// Redefining a generic type is rejected like any type (its placeholder is a
// definition, not a forward declaration).
func TestReplGenericTypeRedefinitionRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Box[T any] struct { v T }")
	replCheckDecl(c, "type Box[T any] struct { a int; v T }")
	var r testing.TestResult = expectErrSub(c, "cannot redefine type Box")
	if len(r) > 0 { return r }
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "type Box struct { a int }")
	if len(c.CheckerErrors()) == before {
		return fail("a struct over the generic Box must be rejected too")
	}
	return ""
}

// A type or interface name is not redefined at the prompt by either kind of
// declaration, a generic interface's included.
func TestCheckDeclInScopeInterfaceRedefinition() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "interface Iter[T any] { Next() T }")
	replCheckDecl(c, "type Box struct { n int }")
	var srcs @[]@[]char = make_slice(@[]char, 4)
	srcs[0] = buf.CopyStr("interface Sizer { Other() int }")
	srcs[1] = buf.CopyStr("type Sizer int")
	srcs[2] = buf.CopyStr("interface Box { M() }")
	srcs[3] = buf.CopyStr("interface Iter[T any] { Other() T }")
	for i := 0; i < len(srcs); i++ {
		var before int = len(c.CheckerErrors())
		replCheckDecl(c, srcs[i])
		if len(c.CheckerErrors()) == before ||
				!charsHaveSub(c.CheckerErrors()[before].Msg, "cannot redefine") {
			return fail(buf.Concat("must be rejected as a redefinition: ", srcs[i]))
		}
	}
	return ""
}

// A type or interface is not given to another kind of entity, and another
// kind of name is not given to a type or interface; a variable, constant or
// function is still redefined freely.
func TestRedefinitionAcrossKinds() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "type Crate struct { n int }")
	replCheckDecl(c, "var vv int")
	replCheckDecl(c, "func ff() int { return 1 }")
	replCheckDecl(c, "const kk = 1")
	var srcs @[]@[]char = make_slice(@[]char, 6)
	var want @[]@[]char = make_slice(@[]char, 6)
	srcs[0] = buf.CopyStr("const Sizer = 1")
	want[0] = buf.CopyStr("cannot redefine interface Sizer as a constant")
	srcs[1] = buf.CopyStr("var Crate int")
	want[1] = buf.CopyStr("cannot redefine type Crate as a variable")
	srcs[2] = buf.CopyStr("func Sizer() {}")
	want[2] = buf.CopyStr("cannot redefine interface Sizer as a function")
	srcs[3] = buf.CopyStr("interface vv { M() }")
	want[3] = buf.CopyStr("cannot redefine variable vv as an interface")
	srcs[4] = buf.CopyStr("type ff int")
	want[4] = buf.CopyStr("cannot redefine function ff as a type")
	srcs[5] = buf.CopyStr("type kk struct { a int }")
	want[5] = buf.CopyStr("cannot redefine constant kk as a type")
	for i := 0; i < len(srcs); i++ {
		var before int = len(c.CheckerErrors())
		replCheckDecl(c, srcs[i])
		if len(c.CheckerErrors()) == before || !streq(c.CheckerErrors()[before].Msg, want[i]) {
			return fail(buf.Concat("want: ", want[i]))
		}
	}
	var before2 int = len(c.CheckerErrors())
	replCheckDecl(c, "var vv bool")
	replCheckDecl(c, "func ff() int { return 2 }")
	replCheckDecl(c, "const kk = 2")
	if len(c.CheckerErrors()) != before2 {
		return fail(c.CheckerErrors()[before2].Msg)
	}
	return ""
}

// A const-group member over an interface name is rejected with the group.
func TestRedefinitionInConstGroup() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "interface Sizer { Size() int }")
	replCheckDecl(c, "const (\n  A = 1\n  Sizer = 2\n)")
	return expectErrSub(c, "cannot redefine interface Sizer as a constant")
}

// A forward-declared type cannot be defined as an alias at the prompt (§7.12):
// it declares a named type.  Any other type defines it.
func TestReplForwardTypeAliasDefinitionRejected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type F")
	replCheckDecl(c, "type F = int")
	var r testing.TestResult = expectErrSub(c,
			"type F is forward-declared; its definition cannot be an alias")
	if len(r) > 0 { return r }
	var d @Checker = sessionChecker()
	replCheckDecl(d, "type G")
	replCheckDecl(d, "type G @[]char")
	if len(d.CheckerErrors()) != 0 { return fail(d.CheckerErrors()[0].Msg) }
	// A generic type is not forward-declared: an alias of its name redefines it.
	var e @Checker = sessionChecker()
	replCheckDecl(e, "type Bx[T any] struct { v T }")
	replCheckDecl(e, "type Bx = int")
	return expectErrSub(e, "cannot redefine type Bx")
}
