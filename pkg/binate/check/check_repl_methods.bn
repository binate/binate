package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Versions of the methods of the REPL session's types.  A method carries the
// generation of the session that declared it (types.Method.Gen).  Redefined by
// another generation with its signature, it is replaced, and its replacement
// takes its generation; with another signature it is superseded: it stays a
// member of its type, renamed in place to its hidden name (replHiddenName, as a
// superseded binding is), and the session keeps it as a method version.  A
// selector spelling the hidden name does not select it (lookupVisibleMethod),
// as an identifier spelling a binding's does not.  A generic resolves its names
// in a view of the session as of its generation (viewedScope), and a method it
// selects there is the version that generation saw (replMethodVersion) -- a
// superseded one by its hidden name.  So is the record of the selection
// (ExprMethod), which IR-gen names the callee from, and a record made before
// the method was superseded names the member renamed.  A call through a type
// parameter's constraint, in an instance, calls the method the impl that makes
// the type argument satisfy the constraint binds: the version of the impl's
// generation (constraintCallMethod).  A generic type's method versions are its
// instances' too (check_repl_methods_generic.bn).

// methodVersion is Member, a method of Owner (a type of the REPL session)
// declared by generation Gen as Name and superseded by generation Until, from
// when it is named Hidden.  For a method of a generic type Owner is the type's
// placeholder, and Generic its declaration, whose instances hold the version
// too; nil otherwise.
type methodVersion struct {
	Owner   @types.Type
	Generic @ast.Decl
	Name    @[]char
	Hidden  @[]char
	Member  @types.Method
	Gen     int
	Until   int
}

// redefineReplMethod puts m, a method of named that a REPL input declares, on
// named in place of named's method of its name: one m replaces when its
// signature is m's (m takes its generation) or it is m's generation's, and one
// m supersedes otherwise (supersedeMethod).
func redefineReplMethod(c @Checker, named @types.Type, m @types.Method) {
	var old @types.Method = named.LookupMethod(m.Name)
	if old != nil && c.Repl.Session != nil && old.Gen != m.Gen {
		if c.SameFuncSignature(old.FuncType, m.FuncType) {
			m.Gen = old.Gen
		} else {
			var notGeneric @ast.Decl
			supersedeMethod(c, named, old, notGeneric)
		}
	}
	named.SetOrAppendMethod(m)
}

// supersedeMethod keeps old, named's method of its name, as a method version
// the generation being checked supersedes, renamed to its hidden name -- of the
// generic type generic, when named is its placeholder.
func supersedeMethod(c @Checker, named @types.Type, old @types.Method, generic @ast.Decl) {
	var v methodVersion
	v.Owner = named
	v.Generic = generic
	v.Name = buf.CopyStr(old.Name)
	v.Hidden = replHiddenName(c.Repl.Gen, old.Name)
	v.Member = old
	v.Gen = old.Gen
	v.Until = c.Repl.Gen
	old.Name = buf.CopyStr(v.Hidden)
	c.Repl.Methods = slices.Append[methodVersion](c.Repl.Methods, v)
}

// replMethodVersion returns the member of named that a selection of its method
// name selects in a view of the REPL session as of a generation (replViewGen)
// when a later generation superseded the version that generation saw: that
// version, named's member under its hidden name.  Otherwise nil: the selection
// selects named's method name.
func replMethodVersion(c @Checker, named @types.Type, name *[]readonly char) @types.Method {
	if len(c.Repl.Methods) == 0 { return nil }
	var gen int = replViewGen(c)
	if gen == 0 { return nil }
	return methodVersionAt(c, named, name, gen)
}

// methodVersionAt returns the version of named's method name of generation gen
// when a later generation superseded it: named's member under its hidden name --
// copied onto an instance of a generic type formed since when the selection is
// the first to select it there (carrySupersededMethod); otherwise nil.
func methodVersionAt(c @Checker, named @types.Type, name *[]readonly char, gen int) @types.Method {
	for i := 0; i < len(c.Repl.Methods); i++ {
		var v methodVersion = c.Repl.Methods[i]
		if versionHeldBy(v, named) && v.Gen <= gen && gen < v.Until && types.CharEq(v.Name, name) {
			var m @types.Method = named.LookupMethod(v.Hidden)
			if m == nil && v.Generic != nil { m = carrySupersededMethod(c, named, v) }
			return m
		}
	}
	return nil
}

// constraintCallMethod returns the method of named, the base type of a type
// argument, that the call through a type parameter's constraint whose selector is
// sel calls in the instance being checked: the one bound by the impl that makes
// the type argument satisfy the constraint (constraintCallImpl) -- named's method
// of sel's name, or its version of the impl's generation that a later generation
// of the REPL session superseded.
func constraintCallMethod(c @Checker, sel @ast.Expr, named @types.Type) @types.Method {
	if hasMethodVersion(c, named, sel.Name) {
		var rec @Impl = constraintCallImpl(c, sel)
		if rec != nil {
			var v @types.Method = methodVersionAt(c, named, sel.Name, rec.Gen)
			if v != nil { return v }
		}
	}
	return named.LookupMethod(sel.Name)
}

// hasMethodVersion reports whether the REPL session superseded a method of named
// named name.
func hasMethodVersion(c @Checker, named @types.Type, name *[]readonly char) bool {
	for i := 0; i < len(c.Repl.Methods); i++ {
		if versionHeldBy(c.Repl.Methods[i], named) && types.CharEq(c.Repl.Methods[i].Name, name) {
			return true
		}
	}
	return false
}

// constraintCallImpl returns the impl that makes the type argument of the call
// through a constraint whose selector is sel satisfy the constraint, in the
// instance being checked -- the argument for the type parameter the call's
// receiver is (ast.Expr ConstraintParamID) and that parameter's constraint, for
// the instance's arguments -- or nil.  The constraint is resolved for them as
// the instantiation resolved it (instanceConstraint), so a length it takes from
// a type parameter is the instance's.
func constraintCallImpl(c @Checker, sel @ast.Expr) @Impl {
	var tp @types.Type = c.ExprType(sel.ConstraintParamID)
	var w @InstWork = instanceState(c).Current
	if tp == nil || tp.Kind != types.TYP_TYPE_PARAM || tp.TpConstraint == nil || w == nil {
		return nil
	}
	var g @ast.Decl = instanceGeneric(w)
	if g == nil || tp.TpOwner != bit_cast(*uint8, g) || tp.TpIndex < 0 || tp.TpIndex >= len(w.Args) {
		return nil
	}
	var constraint @types.Type
	var resolved bool
	constraint, resolved = instanceConstraint(c, g, tp.TpIndex, w.Args)
	if !resolved { constraint = substituteTypeParams(c, tp.TpConstraint, w.Args) }
	if constraint == nil || constraint.Kind != types.TYP_INTERFACE { return nil }
	return constraintImpl(c, w.Args[tp.TpIndex], constraint, implViewHere(c), false)
}

// instanceGeneric returns the generic whose type parameters the instance w binds:
// a generic function, or the generic type whose methods w checks.
func instanceGeneric(w @InstWork) @ast.Decl {
	if w.Decl != nil { return w.Decl }
	return w.TypeDecl
}

// isSupersededMethod reports whether m, a method of named, is one a later
// generation of the REPL session superseded: a version's member, or an instance's
// copy of it, under its hidden name.
func isSupersededMethod(c @Checker, named @types.Type, m @types.Method) bool {
	for i := 0; i < len(c.Repl.Methods); i++ {
		var v methodVersion = c.Repl.Methods[i]
		if same(v.Member, m) ||
				v.Generic != nil && versionHeldBy(v, named) && types.CharEq(m.Name, v.Hidden) {
			return true
		}
	}
	return false
}

// versionHeldBy reports whether named holds the method version v: its owner, or
// an instance of its generic type.
func versionHeldBy(v methodVersion, named @types.Type) bool {
	if same(v.Owner, named) { return true }
	return v.Generic != nil && named != nil && named.InstDecl == bit_cast(*uint8, v.Generic)
}

// replViewGen returns the generation of the view of the REPL session
// (replView) that the scope being checked in is in, or 0 when it is in none.
func replViewGen(c @Checker) int {
	var s @Scope = c.Scope
	for s != nil {
		if s.ViewOf != nil { return s.ViewGen }
		s = s.Parent
	}
	return 0
}

// undoMethodVersions undoes the supersessions made since the session had mark
// method versions, latest first: the method that superseded one leaves its
// type, and the one superseded gets its name back -- on a generic type's
// instances too (undoInstanceVersion).
func undoMethodVersions(c @Checker, mark int) {
	for i := len(c.Repl.Methods) - 1; i >= mark; i-- {
		removeMethodNamed(c.Repl.Methods[i].Owner, c.Repl.Methods[i].Name)
		c.Repl.Methods[i].Member.Name = buf.CopyStr(c.Repl.Methods[i].Name)
		if c.Repl.Methods[i].Generic != nil { undoInstanceVersion(c, c.Repl.Methods[i]) }
	}
	if mark < len(c.Repl.Methods) { c.Repl.Methods = c.Repl.Methods[:mark] }
}

// ShadowedMethod returns the hidden name of the method of d's receiver type that
// d, the method declaration the input checked last made, superseded (see
// check.bni).
func (c @Checker) ShadowedMethod(d @ast.Decl) (@[]char, bool) {
	var none @[]char
	var base @types.Type = methodBaseTypeForDecl(c, d)
	if base == nil { return none, false }
	var cur @types.Method = base.LookupMethod(d.Name)
	if cur == nil || cur.Gen <= c.Repl.InputGen { return none, false }
	for i := len(c.Repl.Methods) - 1; i >= 0; i-- {
		if same(c.Repl.Methods[i].Owner, base) && c.Repl.Methods[i].Until == cur.Gen &&
				types.CharEq(c.Repl.Methods[i].Name, d.Name) {
			return buf.CopyStr(c.Repl.Methods[i].Hidden), true
		}
	}
	return none, false
}
