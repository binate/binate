package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// Versions of the methods of the REPL session's generic types
// (check_repl_methods.bn).  A method of a generic type that a later input
// supersedes stays a member of the type's placeholder and of the instances formed
// before, renamed in place to its hidden name, and its record
// (GenericMethodEntry) takes the hidden name too.  An instance formed later
// carries it only where selected: the first selection of it there, by code
// declared before the supersession, copies it onto the instance, which is checked
// again (carrySupersededMethod) -- its body checked and emitted for that instance
// as the type's other methods are.  A version no code selects costs nothing, and
// one whose signature grows the type's arguments (`Wrap() Box[Opt[V]]`) does not
// make the type an infinite family once it is superseded: the expansion check reads
// the type's current methods.

// redefineGenericMethod puts m, the method of the generic type genDecl that the
// REPL declaration d declares, on genDecl's placeholder in place of its method of
// its name, as redefineReplMethod does for a type that is not generic (one of
// another signature is superseded: supersedeGenericMethod), records d as the
// type's method, and drops the method of its name from the type's instances,
// which take it again, from d, when collection back-fills them
// (backfillInstantiationMethods).
func redefineGenericMethod(c @Checker, genDecl @ast.Decl, placeholder @types.Type, m @types.Method,
		d @ast.Decl) {
	var old @types.Method = placeholder.LookupMethod(m.Name)
	if old != nil && c.Repl.Session != nil && old.Gen != m.Gen {
		if c.SameFuncSignature(old.FuncType, m.FuncType) {
			m.Gen = old.Gen
		} else {
			supersedeGenericMethod(c, genDecl, placeholder, old)
		}
	}
	placeholder.SetOrAppendMethod(m)
	recordGenericMethod(c, d, false)
	dropInstanceMethod(c, c.curPkgPath, genDecl.Name, d.Name)
}

// supersedeGenericMethod keeps old, the method of genDecl's placeholder, as a
// method version the generation being checked supersedes (supersedeMethod),
// under its hidden name on the placeholder, on each instance of genDecl and in
// its record.
func supersedeGenericMethod(c @Checker, genDecl @ast.Decl, placeholder @types.Type,
		old @types.Method) {
	var name @[]char = buf.CopyStr(old.Name)
	supersedeMethod(c, placeholder, old, genDecl)
	var hidden @[]char = buf.CopyStr(old.Name)
	renameInstanceMethods(c, genDecl, name, hidden)
	hideGenericMethodEntry(c, genDecl, name, hidden)
}

// renameInstanceMethods renames the method from of each instance of the generic
// type genDecl to to.
func renameInstanceMethods(c @Checker, genDecl @ast.Decl, from *[]readonly char,
		to *[]readonly char) {
	var entries @[]@GenericInstantiation = declInstantiations(c, genDecl)
	for i := 0; i < len(entries); i++ {
		var t @types.Type = entries[i].Result
		if t == nil || t.Kind != types.TYP_NAMED { continue }
		var m @types.Method = t.LookupMethod(from)
		if m != nil { m.Name = buf.CopyStr(to) }
	}
}

// hideGenericMethodEntry records the method name of the generic type genDecl
// under its hidden name: a copy of its record replaces it, in a copy of the list,
// so a REPL declaration's rollback snapshot keeps the record as it was.
func hideGenericMethodEntry(c @Checker, genDecl @ast.Decl, name *[]readonly char,
		hidden *[]readonly char) {
	var pkg @[]char = genericTypeDeclPkg(c, genDecl)
	for i := 0; i < len(c.Generics.Methods); i++ {
		var old @GenericMethodEntry = c.Generics.Methods[i]
		if types.CharEq(old.Name, name) && genericMethodOf(old, genDecl, pkg) {
			var e @GenericMethodEntry = make(GenericMethodEntry)
			*e = *old
			e.Name = buf.CopyStr(hidden)
			c.Generics.Methods = replaceGenericMethod(c.Generics.Methods, i, e)
			bumpGenericGen(c)
			return
		}
	}
}

// undoInstanceVersion undoes the method version v of a generic type on its
// instances: the method that superseded it leaves each, and each one's copy of
// it gets its name back.
func undoInstanceVersion(c @Checker, v methodVersion) {
	var entries @[]@GenericInstantiation = declInstantiations(c, v.Generic)
	for i := 0; i < len(entries); i++ {
		var t @types.Type = entries[i].Result
		if t == nil || t.Kind != types.TYP_NAMED { continue }
		removeMethodNamed(t, v.Name)
		var m @types.Method = t.LookupMethod(v.Hidden)
		if m != nil { m.Name = buf.CopyStr(v.Name) }
	}
}

// recordedMethodName returns the name the generic-type method declaration d has
// on the type's instances: its record's (GenericMethodEntry.Name), the hidden
// name once a later REPL input superseded it; else d's.
func recordedMethodName(c @Checker, d @ast.Decl) @[]char {
	if c.Repl.Session == nil { return d.Name }
	for i := 0; i < len(c.Generics.Methods); i++ {
		if same(c.Generics.Methods[i].Decl, d) { return c.Generics.Methods[i].Name }
	}
	return d.Name
}

// supersededEntry reports whether e records a method of a generic type that a
// later REPL input superseded: one recorded under its hidden name.
func supersededEntry(e @GenericMethodEntry) bool {
	return !types.CharEq(e.Name, e.Decl.Name)
}

// carrySupersededMethod copies the version v of a method of a generic type onto
// named, an instance of the type that does not hold it -- formed after v was
// superseded -- where code declared before selects it, and has the instance
// checked again (requeueInstance), so that its body is checked, and emitted, for
// named.  Returns the copy, or nil.
func carrySupersededMethod(c @Checker, named @types.Type, v methodVersion) @types.Method {
	if named.Kind != types.TYP_NAMED || named.InstDecl == nil { return nil }
	var pkg @[]char = genericTypeDeclPkg(c, v.Generic)
	var entry @GenericMethodEntry = genericMethodNamed(c, v.Generic, pkg, v.Hidden)
	if entry == nil || skipDemand(c) { return nil }
	copyLaterMethod(c, entry, pkg, named)
	var m @types.Method = named.LookupMethod(v.Hidden)
	if m != nil { requeueInstance(c, v.Generic, named) }
	return m
}

// requeueInstance queues again the check of the instance named of the generic
// type d, in each class it was checked in, for a method it took since.  An
// instance not checked yet takes the method into its first check.
func requeueInstance(c @Checker, d @ast.Decl, named @types.Type) {
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, d, named.InstArgs)
	if entry == nil { return }
	var s @InstCheckState = entry.InstState
	for s != nil {
		if !s.Queued {
			s.OK = false
			var w @InstWork = enqueueTypeWork(c, entry.Decl, entry.TypeArgs, s.Site, s)
			w.Requeued = true
			w.Unjudged = entry.Unjudged
		}
		s = s.Next
	}
}

// instanceHoldsMethod reports whether the instance of the generic type the
// instance check w checks holds the method name.
func instanceHoldsMethod(c @Checker, w @InstWork, name *[]readonly char) bool {
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, w.TypeDecl, w.Args)
	return entry != nil && entry.Result != nil && entry.Result.LookupMethod(name) != nil
}

// GenericMethodName returns the name the method declaration d of a generic type
// has on the type's instances (see check.bni).
func (c @Checker) GenericMethodName(d @ast.Decl) @[]char {
	return recordedMethodName(c, d)
}
