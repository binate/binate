package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the versions of the methods of the REPL session's generic types
// (check_repl_methods_generic.bn).

// sessionVarType returns the type of the session's variable name, or nil.
func sessionVarType(c @Checker, name *[]readonly char) @types.Type {
	var sym @Symbol = c.Scope.LookupLocal(name)
	if sym == nil { return nil }
	return sym.Type
}

// A method of a generic type redefined with another signature is superseded: it
// stays a member of the type's placeholder and of its instances, those formed
// before and after, under its hidden name, which the method declared before it
// selects in each instance; the new method is the type's own.
func TestReplGenericMethodVersions() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "func (c *Cur[T]) Get() T { return c.v }")
	replCheckDecl(c, "func (c *Cur[T]) Twice() T { return c.Get() }")
	replCheckDecl(c, "var a Cur[int]")
	var before int = len(c.CheckerErrors())
	var redef @[]char = "func (c *Cur[T]) Get(k int) int { return k }"
	var p @parser.Parser = parser.New(toBytes(redef), "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != before {
		return fail(buf.Concat("Get's redefinition must check: ", c.CheckerErrors()[before].Msg))
	}
	var hidden @[]char
	var ok bool
	hidden, ok = c.ShadowedMethod(d)
	if !ok || !charSliceEq(hidden, "__repl_shadowed_6_Get") {
		return fail("Get's redefinition must report the Get it superseded")
	}
	var inst @types.Type = sessionVarType(c, "a")
	if inst == nil || inst.LookupMethod("__repl_shadowed_6_Get") == nil ||
			inst.LookupMethod("Get") == nil {
		return fail("Cur[int] must hold both versions of Get")
	}
	replCheckDecl(c, "var b Cur[bool]")
	replCheckStmts(c, "var x int = a.Twice() + a.Get(7)\n_ = x\n"
			"var y bool = b.Twice()\nvar z int = b.Get(8)\n_ = y\n_ = z\n")
	if len(c.CheckerErrors()) != before {
		return fail(
				buf.Concat("Twice must call the Get it was declared against: ", c.CheckerErrors()[before].Msg))
	}
	var b @types.Type = sessionVarType(c, "b")
	if b == nil || b.LookupMethod("__repl_shadowed_6_Get") == nil ||
			lookupVisibleMethod(c, b, "__repl_shadowed_6_Get") != nil {
		return fail("Cur[bool] must hold the superseded Get, not selectable by its hidden name")
	}
	// Twice's body, Cur[bool]'s own, selects the superseded Get there: the check of
	// Cur[bool] checks it too, as for Cur[int].
	var old @ast.Decl
	for i := 0; i < len(c.Generics.Methods); i++ {
		if charSliceEq(c.Generics.Methods[i].Name, "__repl_shadowed_6_Get") {
			old = c.Generics.Methods[i].Decl
		}
	}
	if old == nil || len(c.InstanceBodies(old)) != 2 {
		return fail("the superseded Get must be checked for Cur[int] and Cur[bool]")
	}
	return ""
}

// A redefinition that is undone supersedes nothing: the type's placeholder and
// instances keep the method under its name, and its record is the one before.
func TestReplGenericMethodVersionsUndone() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "func (c *Cur[T]) Get() T { return c.v }")
	replCheckDecl(c, "var a Cur[int]")
	replCheckDeclUndo(c, "func (c *Cur[T]) Get(k int) int { return \"s\" }")
	if len(c.CheckerErrors()) == 0 { return fail("setup: Get returning a string must be rejected") }
	var inst @types.Type = sessionVarType(c, "a")
	if inst == nil || len(c.Repl.Methods) != 0 || inst.LookupMethod("Get") == nil ||
			len(inst.Methods) != 1 {
		return fail("the undone redefinition must leave Cur[int]'s Get as it was")
	}
	for i := 0; i < len(c.Generics.Methods); i++ {
		if !charSliceEq(c.Generics.Methods[i].Name, "Get") {
			return fail("the undone redefinition must leave Get's record as it was")
		}
	}
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "var x int = a.Get()\n_ = x\n")
	if len(c.CheckerErrors()) != before { return fail("a.Get() must check after the undo") }
	return ""
}

// A superseded version is carried by an instance formed later only where code
// declared before selects it: not by one no such code reaches, and by one an
// instance of a generic declared before selects it on.
func TestReplGenericMethodVersionCarriedWhereSelected() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type Cur[T any] struct { v T }")
	replCheckDecl(c, "func (c *Cur[T]) Get() T { return c.v }")
	replCheckDecl(c, "func g[X any](c *Cur[X]) X { return c.Get() }")
	replCheckDecl(c, "var a Cur[int]")
	replCheckDecl(c, "func (c *Cur[T]) Get(k int) int { return k }")
	replCheckDecl(c, "var e Cur[int8]")
	replCheckDecl(c, "var f Cur[bool]")
	var e @types.Type = sessionVarType(c, "e")
	if e == nil || e.LookupMethod("__repl_shadowed_6_Get") != nil {
		return fail("Cur[int8] must not carry the superseded Get, which no code selects there")
	}
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "var r bool = g[bool](&f)\n_ = r\n")
	if len(c.CheckerErrors()) != before {
		return fail(buf.Concat("g[bool] must call the superseded Get: ", c.CheckerErrors()[before].Msg))
	}
	var f @types.Type = sessionVarType(c, "f")
	if f == nil || f.LookupMethod("__repl_shadowed_6_Get") == nil {
		return fail("Cur[bool] must carry the superseded Get, which g[bool] selects")
	}
	return ""
}
