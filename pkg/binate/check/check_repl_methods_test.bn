package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the versions of the methods of the REPL session's types
// (check_repl_methods.bn).  The session's main file is generation 1, and each
// declaration checked at the prompt a generation of its own.

// sessionMethodVersion returns the superseded version of named's method M that
// selecting M selects in a view of c's session as of generation gen
// (replMethodVersion), or nil; gen 0 is no view.
func sessionMethodVersion(c @Checker, named @types.Type, gen int) @types.Method {
	var saved @Scope = c.Scope
	if gen > 0 { c.Scope = NewScope(replView(c.Scope, gen)) }
	var m @types.Method = replMethodVersion(c, named, "M")
	c.Scope = saved
	return m
}

// A method redefined with its signature is replaced, and its replacement takes
// its generation; with another it is superseded, and stays a member of its type
// under its hidden name, which a view as of a generation before the redefinition
// selects.
func TestReplMethodVersions() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { v int }")
	replCheckDecl(c, "func (t *T) M() int { return 1 }")
	replCheckDecl(c, "func g[X any](t *T, x X) int { return t.M() }")
	var named @types.Type = c.Scope.LookupLocal("T").Type
	replCheckDecl(c, "func (t *T) M() int { return 2 }")
	var m3 @types.Method = named.LookupMethod("M")
	if m3.Gen != 3 || len(c.Repl.Methods) != 0 {
		return fail("a same-signature redefinition must replace M, taking its generation")
	}
	replCheckDecl(c, "func (t *T) M(k int) int { return k }")
	if len(c.Repl.Methods) != 1 || !same(named.LookupMethod("__repl_shadowed_6_M"), m3) ||
			!charSliceEq(m3.Name, "__repl_shadowed_6_M") || named.LookupMethod("M").Gen != 6 {
		return fail("M's redefinition with another signature must supersede it, renamed")
	}
	if !same(sessionMethodVersion(c, named, 4), m3) || sessionMethodVersion(c, named, 6) != nil ||
			sessionMethodVersion(c, named, 0) != nil {
		return fail("a view as of 4 must select the superseded M; one as of 6, and no view, none")
	}
	if lookupVisibleMethod(c, named, "__repl_shadowed_6_M") != nil ||
			keyBound(c, "T.__repl_shadowed_6_M") || !keyBound(c, "T.M") {
		return fail("the superseded M must not be selected, or bound, by its hidden name")
	}
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "var t T\nvar r int = g[bool](&t, true)\n_ = r\n")
	if len(c.CheckerErrors()) != before {
		return fail("g's instance must call the M g was declared against")
	}
	return ""
}

// A redefinition that is undone supersedes nothing: the method keeps its name,
// and the session keeps no version of it.
func TestReplMethodVersionsUndone() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { v int }")
	replCheckDecl(c, "func (t *T) M() int { return 1 }")
	var named @types.Type = c.Scope.LookupLocal("T").Type
	var m3 @types.Method = named.LookupMethod("M")
	replCheckDeclUndo(c, "func (t *T) M(k int) int { return \"s\" }")
	if len(c.CheckerErrors()) == 0 { return fail("setup: M returning a string must be rejected") }
	if len(c.Repl.Methods) != 0 || !same(named.LookupMethod("M"), m3) || len(named.Methods) != 1 ||
			!charSliceEq(m3.Name, "M") {
		return fail("the undone redefinition must leave M as it was")
	}
	return ""
}

// An instance that selects a superseded method does not wait for a parked
// redefinition of the method, which does not change the version it selects.
func TestReplMethodVersionNotWaited() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { v int }")
	replCheckDecl(c, "func (t T) M() int { return 1 }")
	replCheckDecl(c, "func g[X any](t T, x X) int { return t.M() }")
	replCheckDecl(c, "var t T")
	replCheckDecl(c, "func (t T) M(k int) int { return k }")
	replCheckDecl(c, "func (t T) M(k int, j int) int { return k + j + later }")
	if !c.IsDeclPending() { return fail("setup: the redefinition using later must park") }
	replCheckDecl(c, "var r int = g[int8](t, 1)")
	if c.IsDeclPending() { return fail("r must not wait for M's parked redefinition") }
	return ""
}

// ShadowedMethod names the method the declaration checked last superseded, and
// only that declaration's.
func TestReplShadowedMethod() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "type T struct { v int }")
	replCheckDecl(c, "func (t *T) M() int { return 1 }")
	var redef @[]char = "func (t *T) M(k int) int { return k }"
	var p @parser.Parser = parser.New(toBytes(redef), "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	c.CheckDeclInScope(d)
	var hidden @[]char
	var ok bool
	hidden, ok = c.ShadowedMethod(d)
	if !ok || !charSliceEq(hidden, "__repl_shadowed_4_M") {
		return fail("M's redefinition must report the M it superseded")
	}
	replCheckDecl(c, "var x int = 1")
	_, ok = c.ShadowedMethod(d)
	if ok { return fail("a later input must not report M's supersession") }
	return ""
}
