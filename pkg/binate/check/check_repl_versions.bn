package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/containers/vec"
import "pkg/std/strconv"

// Versions of the REPL session's bindings.  Each input the REPL checks is a
// generation of the session (its main file is the first): the session scope
// (Checker.Repl.Session) stamps a symbol defined in it with the generation
// defining it (Symbol.Gen), and when another generation binds a variable's, a
// constant's, a function's or an import's name again, the binding it supersedes
// is kept in the scope's History under a hidden name no identifier can spell
// (`__repl_shadowed_<generation>_<name>`; `__` names are reserved) -- the name
// the shadowed declaration is registered under from then on, for the code
// written before it.  A redefinition that replaces rather than shadows -- a
// function of the same signature, a variable of the identical type -- is one
// binding with the one it replaces: it takes that one's generation, and no
// version is kept (a variable, whose type is known only once checked, records
// the merge, so that each of its symbols -- it has two, collection's and the
// check's -- answers for the binding).  An import of the package an import's
// name already names leaves that binding as it is (RegisterReplImport).  Types
// and interfaces are not versioned (the prompt does not redefine them).  An input
// undone keeps no version of a name it rebound (restoreName).  A generic declared
// in the session's scope -- a function, a method of a generic type, a generic
// type, interface or alias -- resolves its names in a view of the scope as of the
// generation declaring it (viewedScope), so its instances, checked later, read
// what it read: a binding a later input shadows is the one they keep (IR-gen
// names it by its hidden name, a package by its path), and one a later input
// replaces is the replacement.

// replVersion is an entry of the REPL session's history: a binding superseded
// -- Sym, which generation Gen defined, bound again by generation Until and
// registered under Hidden from then on -- or, with MergedInto set, a variable
// generation Gen declared merged into the binding of generation MergedInto.
type replVersion struct {
	Name       @[]char
	Sym        @Symbol
	Gen        int
	Until      int
	Hidden     @[]char
	MergedInto int
}

// markReplSession makes c's scope the REPL session's scope, versioned, its
// imports and declarations generation 1.
func markReplSession(c @Checker) {
	c.Repl.Session = c.Scope
	c.Repl.Gen = 1
	c.Scope.Versioned = true
	c.Scope.CurGen = 1
	c.Scope.History = vec.New[replVersion]()
}

// beginReplGeneration starts the REPL session's next generation, for the input
// checked next (nothing outside a session).  Generations are never reused, so a
// hidden name names one version.
func beginReplGeneration(c @Checker) {
	if c.Repl.Session == nil { return }
	c.Repl.Gen = c.Repl.Gen + 1
	c.Repl.Session.CurGen = c.Repl.Gen
}

// noteRebinding keeps old, the binding of the name sym is about to take in the
// versioned scope s, as a superseded version when it is a variable, a constant,
// a function or an import another generation defined.
func (s @Scope) noteRebinding(old @Symbol, sym @Symbol) {
	if !s.Versioned || old == nil || old.Gen == sym.Gen || !isVersionedKind(old.Kind) { return }
	var v replVersion
	v.Name = buf.CopyStr(old.Name)
	v.Sym = old
	v.Gen = old.Gen
	v.Until = s.CurGen
	v.Hidden = replHiddenName(s.CurGen, old.Name)
	s.History.Push(v)
}

// isVersionedKind reports whether a REPL binding of symbol kind k is versioned.
func isVersionedKind(k int) bool {
	return k == types.SYM_VAR || k == types.SYM_CONST || k == types.SYM_FUNC || k == types.SYM_PKG
}

// viewedScope returns the scope a generic declared in s resolves its names in:
// for the REPL session's scope, a view of it as of the generation being checked
// (replView); else s.
func viewedScope(c @Checker, s @Scope) @Scope {
	if c.Repl.Session == nil || !same(s, c.Repl.Session) { return s }
	return replView(s, c.Repl.Gen)
}

// replView returns a view of the session scope s as of generation gen.
func replView(s @Scope, gen int) @Scope {
	var v @Scope = NewScope(s.Parent)
	v.ViewOf = s
	v.ViewGen = gen
	v.Level = s.Level
	v.Pkg = s.Pkg
	return v
}

// lookupAtGen returns the binding of name the versioned scope s had as of
// generation gen: its binding now, unless a later generation bound it -- then
// the version that one superseded which gen saw (bound at gen or before, and
// superseded after it), or, with none, still its binding now (a name gen did not
// bind: a type defined since, as a forward-declared one is).
func (s @Scope) lookupAtGen(name *[]readonly char, gen int) @Symbol {
	var cur @Symbol = s.LookupLocal(name)
	if cur == nil || cur.Gen <= gen { return cur }
	for i := s.History.Len() - 1; i >= 0; i-- {
		var v replVersion = s.History.Get(i)
		if v.MergedInto == 0 && v.Gen <= gen && gen < v.Until && types.CharEq(v.Name, name) {
			return v.Sym
		}
	}
	return cur
}

// replHiddenName returns the hidden name of the binding of name that generation
// gen supersedes.
func replHiddenName(gen int, name *[]readonly char) @[]char {
	var h @[]char = buf.Concat("__repl_shadowed_", strconv.Itoa(gen))
	return buf.Concat(buf.Concat(h, "_"), name)
}

// replacedFuncGen returns the generation a function named name, of type ft,
// declared at the prompt takes: that of the function it replaces -- the
// session's binding of the name, a function of the same signature
// (SameFuncSignature) -- or 0 for its own.
func replacedFuncGen(c @Checker, name *[]readonly char, ft @types.Type) int {
	if c.Repl.Session == nil || !c.Repl.AllowRedef || !same(declScope(c), c.Repl.Session) { return 0 }
	var prev @Symbol = c.Repl.Session.LookupLocal(name)
	if prev == nil || prev.Kind != types.SYM_FUNC || prev.Gen == 0 { return 0 }
	if !c.SameFuncSignature(prev.Type, ft) { return 0 }
	return prev.Gen
}

// settleReplVars settles, for each variable decls declare (a group's members
// included), now that its type is known, whether it replaces the session's
// variable it rebinds: one of the identical type does (settleReplVar).
func settleReplVars(c @Checker, decls *[]@ast.Decl) {
	if c.Repl.Session == nil { return }
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			settleReplVars(c, d.Decls)
		} else if d.Kind == ast.DECL_VAR && !isBlank(d.Name) {
			settleReplVar(c.Repl.Session, d.Name)
		}
	}
}

// settleReplVar is settleReplVars for the variable name, in the session scope s:
// the version of the variable it superseded becomes the record of its merge, and
// it takes that variable's generation.
func settleReplVar(s @Scope, name *[]readonly char) {
	var cur @Symbol = s.LookupLocal(name)
	if cur == nil || cur.Kind != types.SYM_VAR || cur.Type == nil { return }
	for i := s.History.Len() - 1; i >= 0; i-- {
		var v replVersion = s.History.Get(i)
		if v.Until != s.CurGen { return }
		if v.MergedInto == 0 && types.CharEq(v.Name, name) {
			if v.Sym.Kind == types.SYM_VAR && v.Sym.Type != nil && v.Sym.Type.Identical(cur.Type) {
				var m replVersion
				m.Name = v.Name
				m.Gen = s.CurGen
				m.Until = s.CurGen
				m.MergedInto = v.Gen
				s.History.Set(i, m)
				cur.Gen = v.Gen
			}
			return
		}
	}
}

// dropReplVersions drops the history entries of name kept since the session had
// mark of them (ReplHistoryLen): an input undone rebound nothing.
func dropReplVersions(c @Checker, name *[]readonly char, mark int) {
	if c.Repl.Session == nil { return }
	var h @vec.Vec[replVersion] = c.Repl.Session.History
	var dropped bool = false
	for i := mark; i < h.Len(); i++ {
		if types.CharEq(h.Get(i).Name, name) { dropped = true }
	}
	if !dropped { return }
	var kept @vec.Vec[replVersion] = vec.New[replVersion]()
	for i := 0; i < h.Len(); i++ {
		if i < mark || !types.CharEq(h.Get(i).Name, name) { kept.Push(h.Get(i)) }
	}
	c.Repl.Session.History = kept
}

// registeredName returns the name the session's binding of name generation gen
// declared is registered under: the hidden name of its version once superseded,
// following the merge of a variable into the one it replaced (always an older
// generation); else name.
func registeredName(c @Checker, name *[]readonly char, gen int) @[]char {
	if c.Repl.Session != nil {
		var h @vec.Vec[replVersion] = c.Repl.Session.History
		for gen > 0 {
			var next int = 0
			for i := h.Len() - 1; i >= 0; i-- {
				var v replVersion = h.Get(i)
				if v.Gen != gen || !types.CharEq(v.Name, name) { continue }
				if v.MergedInto == 0 { return buf.CopyStr(v.Hidden) }
				next = v.MergedInto
			}
			gen = next
		}
	}
	return buf.CopyStr(name)
}

// ReplHistoryLen returns a mark of the REPL session's history (see check.bni).
func (c @Checker) ReplHistoryLen() int {
	if c.Repl.Session == nil { return 0 }
	return c.Repl.Session.History.Len()
}

// ReplShadowsSince returns the bindings of the REPL session superseded since mark
// (see check.bni).
func (c @Checker) ReplShadowsSince(mark int) @[]ReplShadow {
	var out @vec.Vec[ReplShadow] = vec.New[ReplShadow]()
	if c.Repl.Session != nil {
		var h @vec.Vec[replVersion] = c.Repl.Session.History
		for i := mark; i < h.Len(); i++ {
			var v replVersion = h.Get(i)
			if v.MergedInto > 0 { continue }
			var r ReplShadow
			r.Name = buf.CopyStr(v.Name)
			r.Hidden = buf.CopyStr(v.Hidden)
			r.Kind = v.Sym.Kind
			out.Push(r)
		}
	}
	return out.Items()
}

// ShadowedBinding returns the binding of name that the session's binding of it
// shadowed in the input checked last (see check.bni).
func (c @Checker) ShadowedBinding(name *[]readonly char) (ReplShadow, bool) {
	var r ReplShadow
	if c.Repl.Session == nil { return r, false }
	var cur @Symbol = c.Repl.Session.LookupLocal(name)
	if cur == nil || cur.Gen <= c.Repl.InputGen { return r, false }
	var h @vec.Vec[replVersion] = c.Repl.Session.History
	for i := h.Len() - 1; i >= 0; i-- {
		var v replVersion = h.Get(i)
		if v.MergedInto == 0 && v.Until == cur.Gen && types.CharEq(v.Name, name) {
			r.Name = buf.CopyStr(v.Name)
			r.Hidden = buf.CopyStr(v.Hidden)
			r.Kind = v.Sym.Kind
			return r, true
		}
	}
	return r, false
}

// RegisteredName returns the name the package-level declaration sym is
// registered under (see check.bni).
func (c @Checker) RegisteredName(sym @Symbol) @[]char {
	var none @[]char
	if sym == nil { return none }
	return registeredName(c, sym.Name, sym.Gen)
}

// RegisteredDeclName returns the name the generic function d is registered under
// (see check.bni): its binding's, by the generation its home records.
func (c @Checker) RegisteredDeclName(d @ast.Decl) @[]char {
	var none @[]char
	if d == nil { return none }
	if c.Repl.Session == nil { return buf.CopyStr(d.Name) }
	var home @GenericHome = genericHomeOf(c, d)
	if home == nil { return buf.CopyStr(d.Name) }
	return registeredName(c, d.Name, home.Gen)
}
