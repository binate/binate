package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the versions of the REPL session's bindings (check_repl_versions.bn).
// The session's main file is generation 1, and each declaration checked at the
// prompt a generation of its own.

// replShadowsText returns the bindings shadowed since mark as `name:hidden` words.
func replShadowsText(c @Checker, mark int) @[]char {
	var sh @[]ReplShadow = c.ReplShadowsSince(mark)
	var cb @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(sh); i++ {
		if i > 0 { cb.Write(" ") }
		cb.Write(sh[i].Name)
		cb.Write(":")
		cb.Write(sh[i].Hidden)
	}
	return buf.CopyStr(cb.String())
}

// expectShadows reports what is wrong with the bindings shadowed since mark.
func expectShadows(c @Checker, mark int, want *[]readonly char) testing.TestResult {
	var got @[]char = replShadowsText(c, mark)
	if charSliceEq(got, want) { return "" }
	return buf.Concat(buf.Concat(buf.Concat("shadowed: got [", got), "], want ["),
			buf.Concat(want, "]"))
}

// A function redefined with its signature replaces it: it takes its generation,
// and no version is kept; with another it shadows it, which is then registered
// under its hidden name -- the replaced and the replacing declaration alike.
func TestReplVersionsFunctions() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return 1 }")
	var f1 @Symbol = c.Scope.LookupLocal("f")
	var mark int = c.ReplHistoryLen()
	replCheckDecl(c, "func f() int { return 2 }")
	var f2 @Symbol = c.Scope.LookupLocal("f")
	if same(f1, f2) || f2.Gen != f1.Gen || len(c.ReplShadowsSince(mark)) != 0 {
		return fail("a same-signature redefinition must replace f")
	}
	replCheckDecl(c, "func f() int8 { return 3 }")
	var r testing.TestResult = expectShadows(c, mark, "f:__repl_shadowed_4_f")
	if len(r) > 0 { return r }
	if !charSliceEq(c.RegisteredName(f1), "__repl_shadowed_4_f") ||
			!charSliceEq(c.RegisteredName(f2), "__repl_shadowed_4_f") ||
			!charSliceEq(c.RegisteredName(c.Scope.LookupLocal("f")), "f") {
		return fail("f's two declarations are the shadowed one, the third is f")
	}
	return ""
}

// A variable redefined with the identical type replaces it, its type written or
// inferred; with another it shadows it.  A constant always shadows, and so does
// a binding of another kind.
func TestReplVersionsVarsAndConsts() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var v int = 1")
	var mark int = c.ReplHistoryLen()
	replCheckDecl(c, "var v int = 2")
	replCheckDecl(c, "var v = 5")
	if len(c.ReplShadowsSince(mark)) != 0 { return fail("an int v must replace v") }
	replCheckDecl(c, "var v int8 = 3")
	replCheckDecl(c, "const K int = 1")
	replCheckDecl(c, "const K int = 1")
	replCheckDecl(c, "func K() int { return 0 }")
	return expectShadows(c, mark, "v:__repl_shadowed_5_v K:__repl_shadowed_7_K K:__repl_shadowed_8_K")
}

// An input that parks, or fails and is rolled back, keeps no version: the name
// keeps its binding.  A const group's member that parks keeps none either -- the
// name it rebound keeps its binding -- while the member before it that shadowed
// a binding keeps its version.
func TestReplVersionsUndone() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func g() int { return 1 }")
	var g1 @Symbol = c.Scope.LookupLocal("g")
	var mark int = c.ReplHistoryLen()
	replCheckDeclUndo(c, "func g() int8 { return cast(int8, zz) }")
	replCheckDeclUndo(c, "func g() int8 { return true }")
	if c.ReplHistoryLen() != mark || !same(c.Scope.LookupLocal("g"), g1) ||
			!charSliceEq(c.RegisteredName(g1), "g") {
		return fail("a parked or failed redefinition must keep g as it was")
	}
	replCheckDecl(c, "var a int8 = 1")
	replCheckDecl(c, "const b int = 0")
	var b1 @Symbol = c.Scope.LookupLocal("b")
	var groupMark int = c.ReplHistoryLen()
	replCheckDecl(c, "const (\n\ta int = 2\n\tb int = zz\n)")
	if !same(c.Scope.LookupLocal("b"), b1) {
		return fail("the parked member's b must keep its binding")
	}
	return expectShadows(c, groupMark, "a:__repl_shadowed_7_a")
}

// A mid-session import is an input of its own: the variable it shadows is kept
// under the import's generation, whatever the input before it rebound.
func TestReplVersionsImport() testing.TestResult {
	var c @Checker = sessionChecker()
	c.LoadPackageInterface("pkg/strs", mkBniFile("package \"pkg/strs\"\nfunc N() int\n"))
	replCheckDecl(c, "var strs int = 7")
	var mark int = c.ReplHistoryLen()
	if !c.RegisterReplImport("strs", "pkg/strs") { return fail("pkg/strs must be imported") }
	return expectShadows(c, mark, "strs:__repl_shadowed_3_strs")
}

// A variable merged into the one it replaces answers for that binding by each of
// its symbols' generations, its own included.
func TestReplVersionsMergedVarSymbols() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var v int = 1")
	replCheckDecl(c, "var v int = 2")
	replCheckDecl(c, "var v int8 = 3")
	var own @Symbol = make(Symbol)
	own.Name = buf.CopyStr("v")
	own.Gen = 3
	var first @Symbol = make(Symbol)
	first.Name = buf.CopyStr("v")
	first.Gen = 2
	if !charSliceEq(c.RegisteredName(own), "__repl_shadowed_4_v") ||
			!charSliceEq(c.RegisteredName(first), "__repl_shadowed_4_v") {
		return fail("both v's generations must answer for the shadowed binding")
	}
	return ""
}

// A generic function shadowed by one of another signature is registered under
// its hidden name, and so is the one it replaced; the one shadowing it is not.
func TestReplVersionsGenericFunc() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func id[T any](x T) T { return x }")
	var first @ast.Decl = genericFuncDecl(c.Scope.LookupLocal("id").Type)
	replCheckDecl(c, "func id[T any](x T) T { return x }")
	var second @ast.Decl = genericFuncDecl(c.Scope.LookupLocal("id").Type)
	replCheckDecl(c, "func id[T any](x T) int { return 0 }")
	var third @ast.Decl = genericFuncDecl(c.Scope.LookupLocal("id").Type)
	if first == nil || second == nil || third == nil || same(first, second) {
		return fail("each id must be its own generic declaration")
	}
	if !charSliceEq(c.RegisteredDeclName(first), "__repl_shadowed_4_id") ||
			!charSliceEq(c.RegisteredDeclName(second), "__repl_shadowed_4_id") ||
			!charSliceEq(c.RegisteredDeclName(third), "id") {
		return fail("the first two ids are the shadowed one, the third is id")
	}
	return ""
}

// expectShadowedBinding reports what is wrong with the binding of name that the
// input checked last shadowed: it must be kept as hidden, of kind.
func expectShadowedBinding(c @Checker, name *[]readonly char, hidden *[]readonly char,
		kind int) testing.TestResult {
	var r ReplShadow
	var ok bool
	r, ok = c.ShadowedBinding(name)
	if !ok { return buf.Concat("no shadowed binding of ", name) }
	if !charSliceEq(r.Name, name) || !charSliceEq(r.Hidden, hidden) || r.Kind != kind {
		return buf.Concat(buf.Concat("shadowed binding of ", name), buf.Concat(": got ", r.Hidden))
	}
	return ""
}

// ShadowedBinding reports the binding an input shadowed, with its kind: a
// function, a constant, a variable an import takes the name of.  It reports none
// for a name the input did not bind, nor for a redefinition that replaced the
// shadowing declaration -- the replacement keeps that one's generation, whose
// shadow an earlier input made -- nor for a variable merged into the one it
// replaces.
func TestReplShadowedBinding() testing.TestResult {
	var c @Checker = sessionChecker()
	c.LoadPackageInterface("pkg/strs", mkBniFile("package \"pkg/strs\"\nfunc N() int\n"))
	replCheckDecl(c, "func f() int { return 1 }")
	replCheckDecl(c, "func f() int8 { return 2 }")
	var r testing.TestResult = expectShadowedBinding(c, "f", "__repl_shadowed_3_f", types.SYM_FUNC)
	if len(r) > 0 { return r }
	replCheckDecl(c, "func f() int8 { return 3 }")
	var ok bool
	_, ok = c.ShadowedBinding("f")
	if ok { return fail("a replacing f must report no shadowed binding") }
	replCheckDecl(c, "const K int = 1")
	replCheckDecl(c, "var K bool = true")
	r = expectShadowedBinding(c, "K", "__repl_shadowed_6_K", types.SYM_CONST)
	if len(r) > 0 { return r }
	_, ok = c.ShadowedBinding("f")
	if ok { return fail("an input that did not bind f must report no shadowed binding of it") }
	replCheckDecl(c, "var strs int = 7")
	if !c.RegisterReplImport("strs", "pkg/strs") { return fail("pkg/strs must be imported") }
	r = expectShadowedBinding(c, "strs", "__repl_shadowed_8_strs", types.SYM_VAR)
	if len(r) > 0 { return r }
	replCheckDecl(c, "var w int = 1")
	replCheckDecl(c, "var w int = 2")
	_, ok = c.ShadowedBinding("w")
	if ok { return fail("a replacing w must report no shadowed binding") }
	return ""
}

// A view of the session's scope as of a generation resolves a name to the
// binding it had then: the version a later input's shadowing superseded, the
// replacement of one a later input replaced, and -- for a name it did not bind --
// the binding now.  An instance of a generic checked after its names were
// shadowed reads what its declaration read.
func TestReplViews() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "func f() int { return 1 }")
	replCheckDecl(c, "var x int = 1")
	var f2 @Symbol = c.Scope.LookupLocal("f")
	replCheckDecl(c, "func f() int8 { return 3 }")
	replCheckDecl(c, "func f() int8 { return 4 }")
	replCheckDecl(c, "var x int = 2")
	var f5 @Symbol = c.Scope.LookupLocal("f")
	var x6 @Symbol = c.Scope.LookupLocal("x")
	if !same(replView(c.Scope, 3).Lookup("f"), f2) {
		return fail("a view as of 3 must see the first f")
	}
	if !same(replView(c.Scope, 4).Lookup("f"), f5) {
		return fail("a view as of 4 must see f's replacement")
	}
	if !same(replView(c.Scope, 3).Lookup("x"), x6) {
		return fail("a view as of 3 must see x's replacement")
	}
	if !same(replView(c.Scope, 1).Lookup("f"), f5) {
		return fail("a view as of 1, which bound no f, must see f")
	}
	if replView(c.Scope, 3).Lookup("int") == nil { return fail("a view must see the universe") }
	replCheckDecl(c, "func h() int { return 1 }")
	replCheckDecl(c, "func g[T any](v T) int { return h() + x }")
	replCheckDecl(c, "func h() int8 { return 2 }")
	replCheckDecl(c, "var x bool = true")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "var y int = g[bool](true)")
	if len(c.CheckerErrors()) != before {
		return fail(buf.Concat("g[bool] must read the h and x g read: ", c.CheckerErrors()[before].Msg))
	}
	return ""
}

// An import's name is versioned as a variable's is: an import or a declaration
// that takes it keeps the package it named, which an instance of a generic
// declared before reads; an import of the package the name already names leaves
// it bound.
func TestReplVersionsImportNames() testing.TestResult {
	var c @Checker = sessionChecker()
	c.LoadPackageInterface("pkg/pa", mkBniFile("package \"pkg/pa\"\nfunc F() int\n"))
	c.LoadPackageInterface("pkg/pb", mkBniFile("package \"pkg/pb\"\nfunc F() bool\n"))
	if !c.RegisterReplImport("s", "pkg/pa") { return fail("pkg/pa must be imported") }
	replCheckDecl(c, "func g[T any](v T) int { return s.F() }")
	var pa @Symbol = c.Scope.LookupLocal("s")
	var mark int = c.ReplHistoryLen()
	if !c.RegisterReplImport("s", "pkg/pa") { return fail("pkg/pa must be imported again") }
	if c.ReplHistoryLen() != mark || !same(c.Scope.LookupLocal("s"), pa) {
		return fail("an import of the package s names must leave s bound")
	}
	if !c.RegisterReplImport("s", "pkg/pb") { return fail("pkg/pb must be imported") }
	var r testing.TestResult = expectShadowedBinding(c, "s", "__repl_shadowed_5_s", types.SYM_PKG)
	if len(r) > 0 { return r }
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "var a int = g[bool](true)\n_ = a\n")
	replCheckDecl(c, "var s int = 3")
	var sh ReplShadow
	var ok bool
	sh, ok = c.ShadowedBinding("s")
	if !ok || sh.Kind != types.SYM_PKG { return fail("var s must shadow the import of pkg/pb") }
	replCheckStmts(c, "var b int = g[int8](1)\n_ = b\n")
	if len(c.CheckerErrors()) != before {
		return fail(buf.Concat("g's instances must call pkg/pa's F: ", c.CheckerErrors()[before].Msg))
	}
	return ""
}

// A main file's import is the file's alone: the prompt does not see it, and may
// bind the name to a package of its own.  A generic function, and a generic
// type's method, that the file declares read the file's import and the function
// declared beside them, however the prompt rebinds those names later.
func TestReplMainFileImportIsTheFiles() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/pa", mkBniFile("package \"pkg/pa\"\nfunc F() int\n"))
	c.LoadPackageInterface("pkg/pb", mkBniFile("package \"pkg/pb\"\nfunc F() bool\n"))
	var p @parser.Parser = parser.New(toBytes("package \"main\"\nimport s \"pkg/pa\"\n"
			"func h() int { return 1 }\n"
			"func g[T any](v T) int { return s.F() + h() }\n"
			"type Cell[T any] struct { v T }\n"
			"func (b Cell[T]) N() int { return s.F() + h() }\n"), "main.bn")
	c.CheckMainPersistent(mustParse(p))
	if len(c.CheckerErrors()) != 0 { return fail(buf.Concat("main.bn: ", c.CheckerErrors()[0].Msg)) }
	if c.Scope.LookupLocal("s") != nil {
		return fail("the main file's import must not be bound at the prompt")
	}
	replCheckStmts(c, "_ = s.F()\n")
	if len(c.CheckerErrors()) != 1 || !msgContains(c.CheckerErrors()[0].Msg, "undefined: s") {
		return fail("the prompt must not see the main file's import")
	}
	if !c.RegisterReplImport("s", "pkg/pb") { return fail("pkg/pb must be imported") }
	replCheckDecl(c, "func h() int8 { return 2 }")
	var before int = len(c.CheckerErrors())
	replCheckStmts(c,
			"var cl Cell[bool]\nvar a int = g[bool](true) + cl.N()\nvar b bool = s.F()\n_ = a\n_ = b\n")
	if len(c.CheckerErrors()) != before {
		return fail(
				buf.Concat("the file's generics must read its s and h: ", c.CheckerErrors()[before].Msg))
	}
	return ""
}

// The types, interfaces, aliases and impls a main file declares generically read
// the file's import and the constant declared beside them, however the prompt
// rebinds those names later: an array of the file's K elements and a field of its
// s.T, a generic alias of such a type, and a generic interface whose methods
// return them, bound by a parameterized impl.
func TestReplMainFileGenericTypesKeepTheFilesNames() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/pa", mkBniFile("package \"pkg/pa\"\ntype T struct { A int; B int }\n"))
	c.LoadPackageInterface("pkg/pb", mkBniFile("package \"pkg/pb\"\ntype T struct { C bool }\n"))
	var p @parser.Parser = parser.New(toBytes("package \"main\"\nimport s \"pkg/pa\"\n"
			"const K int = 2\n"
			"type Arr[X any] struct { a [K]X; t s.T }\n"
			"type Al[X any] = Arr[X]\n"
			"interface IG[X any] { Get() [K]X; Tag() s.T }\n"
			"type W[X any] struct { x X }\n"
			"func (w *W[X]) Get() [K]X { var r [K]X; return r }\n"
			"func (w *W[X]) Tag() s.T { var r s.T; return r }\n"
			"impl *W[X] : IG[X]\n"), "main.bn")
	c.CheckMainPersistent(mustParse(p))
	if len(c.CheckerErrors()) != 0 { return fail(buf.Concat("main.bn: ", c.CheckerErrors()[0].Msg)) }
	if !c.RegisterReplImport("s", "pkg/pb") { return fail("pkg/pb must be imported") }
	replCheckDecl(c, "const K int = 3")
	var before int = len(c.CheckerErrors())
	replCheckStmts(c, "var ar Arr[int]\nvar two [2]int = ar.a\nvar b int = ar.t.B\n"
			"var al Al[bool]\nvar two2 [2]bool = al.a\nvar b2 int = al.t.B\n"
			"var w W[int]\nvar ig *IG[int] = &w\nvar two3 [2]int = ig.Get()\nvar b3 int = ig.Tag().B\n"
			"var pt s.T\nvar cc bool = pt.C\n"
			"_ = two\n_ = b\n_ = two2\n_ = b2\n_ = two3\n_ = b3\n_ = cc\n")
	if len(c.CheckerErrors()) != before {
		return fail(
				buf.Concat("the file's generic types must read its s and K: ", c.CheckerErrors()[before].Msg))
	}
	return ""
}
