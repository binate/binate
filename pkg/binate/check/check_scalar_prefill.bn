package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/table"

// Filling the underlyings of named scalar types before top-level consts are
// resolved.  A top-level const's declared type may be a named type over a
// scalar (`const C Rate = 0.5` over `type Rate float64`); a const read during
// collection is resolved then (batchConstOnDemand) and needs that type's
// underlying to validate the const and its value, but collectDeclsBody — which
// sets underlyings — may not have reached it.  An underlying
// that is a scalar chain cannot depend on a const, so it is filled first.

// prefillUnvisited marks a type declaration the prefill has not resolved yet.
const prefillUnvisited int = 0

// prefillInProgress marks a type declaration on the current resolution path;
// reaching it again means the declarations form a cycle.
const prefillInProgress int = 1

// prefillDone marks a resolved type declaration; its result is recorded.
const prefillDone int = 2

// scalarPrefill is the state of one resolveBuiltinScalarTypeDecls run over a
// package's top-level type declarations (groups flattened), so each is
// resolved at most once.  State[i] is prefillUnvisited (the zero value),
// prefillInProgress or prefillDone; Result[i] is what a done declaration
// denotes when that is a scalar chain (see prefillDecl), else nil.  Index maps
// a declared name to its declaration's index — a full declaration in
// preference to a forward one; its keys borrow the declarations' names.
type scalarPrefill struct {
	Decls  @[]@ast.Decl
	State  @[]int
	Result @[]@types.Type
	Index  @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq]
}

// isConcreteScalar reports whether t is a builtin scalar Type object — a real,
// stable int / float / bool, not a named wrapper, alias, or placeholder.
func isConcreteScalar(t @types.Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == types.TYP_INT || t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_BOOL
}

// denotesScalarChain reports whether t is a scalar chain: a builtin scalar, or
// a named, alias or readonly type whose chain of wrappers ends at one.
func denotesScalarChain(t @types.Type) bool {
	return isConcreteScalar(types.StripWrappers(t))
}

// resolveBuiltinScalarTypeDecls fills the underlying of each distinct named
// type declared in decls that denotes a scalar chain — a builtin scalar
// (`type Celsius int`), possibly parenthesised, readonly (`type R readonly
// int8`), another such named type of this package or an imported one (`type N
// M` with `type M int8`, `type D time.Delta`), or an alias of any of those
// (`type NA A` with `type A = int16`), in any declaration order.  Other
// declarations (structs, arrays, generics, forward decls, and the alias
// declarations themselves) are left for collectDeclsBody.
//
// The placeholder preRegisterTypeNames created is filled in place with a type
// equivalent to what collectTypeDecl's resolveTypeExpr gives: the same object
// for a builtin scalar or a named type, and for an alias its target rather
// than the alias wrapper, which collectTypeDecl has not created yet (and which
// replaces the alias name's placeholder, so that placeholder is never used).
// collectTypeDecl then sees the underlying already set and keeps it.  A name is
// looked up among the package's own type declarations before the universe,
// since a package-level type may shadow a predeclared one (`type int16 = int8`).
func resolveBuiltinScalarTypeDecls(c @Checker, decls *[]@ast.Decl) {
	var n int = countTypeDecls(decls)
	var p @scalarPrefill = make(scalarPrefill)
	p.Decls = make_slice(@ast.Decl, n)
	p.State = make_slice(int, n)
	p.Result = make_slice(@types.Type, n)
	gatherTypeDecls(decls, p.Decls, 0)
	p.Index = table.NewTable[*[]readonly char, int, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	for i := 0; i < n; i++ {
		var j int
		var found bool
		j, found = p.Index.GetOrPut(p.Decls[i].Name, i)
		if found && p.Decls[j].IsForward && !p.Decls[i].IsForward {
			p.Index.Put(p.Decls[i].Name, i)
		}
	}
	for i := 0; i < n; i++ {
		prefillDecl(c, p, i)
	}
}

// countTypeDecls counts the type declarations in decls, recursing into groups.
func countTypeDecls(decls *[]@ast.Decl) int {
	var n int = 0
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_TYPE {
			n = n + 1
		} else if decls[i].Kind == ast.DECL_GROUP {
			n = n + countTypeDecls(decls[i].Decls)
		}
	}
	return n
}

// gatherTypeDecls stores the type declarations of decls (recursing into groups)
// into out starting at index at, and returns the index after the last one.
func gatherTypeDecls(decls *[]@ast.Decl, out @[]@ast.Decl, at int) int {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_TYPE {
			out[at] = d
			at = at + 1
		} else if d.Kind == ast.DECL_GROUP {
			at = gatherTypeDecls(d.Decls, out, at)
		}
	}
	return at
}

// findPrefillDecl returns the index in p of the declaration of type name — a
// full declaration in preference to a forward one — or -1 when the package
// declares no type of that name.
func findPrefillDecl(p @scalarPrefill, name *[]readonly char) int {
	var i int
	var ok bool
	i, ok = p.Index.Get(name)
	if !ok { return -1 }
	return i
}

// prefillDecl resolves type declaration i of p, once, and returns what it
// denotes when that is a scalar chain — a named declaration's own type, whose
// placeholder it fills, or an alias's target — else nil.  Reaching a
// declaration already on the current resolution path is a cycle (`type A B;
// type B A`, `type A = B; type B = A`): nil, left for collectTypeDecl to
// diagnose.
func prefillDecl(c @Checker, p @scalarPrefill, i int) @types.Type {
	if p.State[i] == prefillDone { return p.Result[i] }
	if p.State[i] != prefillUnvisited { return nil } // in progress: a cycle
	p.State[i] = prefillInProgress
	var d @ast.Decl = p.Decls[i]
	var res @types.Type = nil
	if len(d.TypeParams) == 0 && !d.IsForward && d.TypeRef != nil && !isBlank(d.Name) {
		var target @types.Type = prefillTarget(c, p, d, d.TypeRef)
		if d.IsAlias {
			res = target
		} else {
			res = fillNamedPlaceholder(c, d, target)
		}
	}
	p.State[i] = prefillDone
	p.Result[i] = res
	return res
}

// fillNamedPlaceholder sets the underlying of named declaration d's
// package-scope placeholder to target (a scalar chain, or nil for none) unless
// it is already set, and returns the named type when its underlying is a
// scalar chain, else nil.
func fillNamedPlaceholder(c @Checker, d @ast.Decl, target @types.Type) @types.Type {
	var sym @Symbol = pkgScopeLookupLocal(c, d.Name)
	if sym == nil || sym.Kind != types.SYM_TYPE || sym.Type == nil ||
			sym.Type.Kind != types.TYP_NAMED {
		return nil
	}
	if sym.Type.Underlying == nil {
		if target == nil { return nil }
		sym.Type.Underlying = target
	}
	if denotesScalarChain(sym.Type) { return sym.Type }
	return nil
}

// prefillTarget returns what type expression te, written in declaration from,
// denotes when that is a scalar chain, else nil.  An unqualified name declared
// by the package resolves through its declaration; any other resolves in the
// package scope and then the universe.
func prefillTarget(c @Checker, p @scalarPrefill, from @ast.Decl, te @ast.TypeExpr) @types.Type {
	if te == nil { return nil }
	if te.Kind == ast.TEXPR_PAREN {
		return prefillTarget(c, p, from, te.Base)
	}
	if te.Kind == ast.TEXPR_CONST {
		var inner @types.Type = prefillTarget(c, p, from, te.Base)
		if inner == nil { return nil }
		return types.MakeReadonlyType(inner)
	}
	if te.Kind != ast.TEXPR_NAMED { return nil }
	if len(te.Pkg) > 0 {
		return qualifiedScalarTarget(c, from, te)
	}
	var j int = findPrefillDecl(p, te.Name)
	if j >= 0 {
		return prefillDecl(c, p, j)
	}
	var sym @Symbol = pkgScopeLookup(c, te.Name)
	if sym == nil || sym.Kind != types.SYM_TYPE || sym.IsGeneric || !denotesScalarChain(sym.Type) {
		return nil
	}
	return sym.Type
}

// qualifiedScalarTarget returns the type `pkg.Name` that te names, looked up
// through the imports of from's file, when it is a scalar chain, else nil.  An
// imported package's scope is complete before this package's declarations are
// collected, so the type is final.
func qualifiedScalarTarget(c @Checker, from @ast.Decl, te @ast.TypeExpr) @types.Type {
	var s @Scope = c.Scope
	if fileScopedActive(c) {
		s = scopeForFile(c, from.Pos.File)
	}
	var ps @Symbol = s.Lookup(te.Pkg)
	if ps == nil || ps.Kind != types.SYM_PKG { return nil }
	var pkgScope @Scope = lookupPackage(c, ps.PkgPath)
	if pkgScope == nil { return nil }
	var m @Symbol = pkgScope.Lookup(te.Name)
	if m == nil || m.Kind != types.SYM_TYPE || m.IsGeneric || !denotesScalarChain(m.Type) {
		return nil
	}
	return m.Type
}
