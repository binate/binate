package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for filling named scalar types' underlyings before top-level consts
// are resolved (check_scalar_prefill.bn).

// A named type over another named scalar, a readonly scalar or an alias of one
// (`type N M`, `type R readonly int8`, `type NA A` with `type A = int16`, a
// longer chain, declared before or after its source) takes untyped constants
// in var and const declarations exactly like a named type over a builtin
// scalar: its underlying is filled before consts resolve, and the constant's
// fit check sees through every wrapper level.
func TestCheckNamedOverNamedScalarTakesConstants() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N M\n"
			"type M int8\n"
			"type R readonly int8\n"
			"type RN readonly N\n"
			"type NA A\n"
			"type A = int16\n"
			"const cn N = 6\n"
			"const cr R = 5\n"
			"const crn RN = 4\n"
			"const cna NA = 300\n"
			"var vn N = -128\n"
			"var vr R = 127\n"
	return expectNoErrors(checkSrc(src))
}

// The constant is still range-checked against the scalar at the bottom of the
// chain: 200 does not fit N's int8.
func TestCheckNamedOverNamedScalarRangeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype M int8\ntype N M\nvar vn N = 200\n"
	return expectError(checkSrc(src))
}

// Through an alias the constant is range-checked the same way: 300 does not
// fit the int8 that `type A = int8` names.
func TestCheckNamedOverAliasScalarRangeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype A = int8\ntype NA A\nconst c NA = 300\n"
	return expectError(checkSrc(src))
}

// An alias cycle under a named type is reported rather than followed forever
// while the named type's underlying is being filled.
func TestCheckNamedOverAliasCycleReported() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype A = B\ntype B = A\ntype C A\nconst c C = 1\n"
	return expectError(checkSrc(src))
}

// A parenthesised type expression is seen through, as resolveTypeExpr does.
func TestCheckPrefillParenthesisedTarget() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type M int8\n"
			"type P (M)\n"
			"type A = (int8)\n"
			"type NA A\n"
			"const cp P = 3\n"
			"const cna NA = 4\n"
	return expectNoErrors(checkSrc(src))
}

// A package-level type shadows the predeclared type of the same name, before
// its declaration too: here `int16` means int8, so 100 fits N and NA.
func TestCheckPrefillShadowedPredeclaredTakesConstants() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N int16\n"
			"type NA A\n"
			"type A = int16\n"
			"type int16 = int8\n"
			"const c N = 100\n"
			"const ca NA = 100\n"
	return expectNoErrors(checkSrc(src))
}

// ... and 200 does not fit a named type over the shadowing `int16`.
func TestCheckPrefillShadowedPredeclaredRangeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype int16 = int8\ntype N int16\nconst c N = 200\n"
	return expectError(checkSrc(src))
}

// ... nor one over an alias of it.
func TestCheckPrefillShadowedPredeclaredViaAliasRangeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type int16 = int8\n"
			"type NA A\n"
			"type A = int16\n"
			"const ca NA = 200\n"
	return expectError(checkSrc(src))
}

// A named-distinct shadowing type (`type int16 int8`) is seen the same way.
func TestCheckPrefillShadowingNamedRangeChecked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype N int16\ntype int16 int8\nconst c N = 200\n"
	return expectError(checkSrc(src))
}

// A cycle of named types is reported rather than followed forever.
func TestCheckPrefillNamedCycleReported() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype A B\ntype B A\nconst c A = 1\n"
	return expectError(checkSrc(src))
}

// A long chain declared in reverse order is filled, whatever its length.
func TestCheckPrefillLongReverseChain() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type N0 N1\ntype N1 N2\ntype N2 N3\ntype N3 N4\ntype N4 N5\n"
			"type N5 N6\ntype N6 N7\ntype N7 N8\ntype N8 N9\ntype N9 int8\n"
			"const c N0 = 7\n"
	return expectNoErrors(checkSrc(src))
}

// An imported named scalar, directly or through an alias, takes constants;
// its own interface declares the named-over-named chain, and its range still
// applies.
func TestCheckPrefillQualifiedTarget() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/x"),
			"package \"pkg/x\"\ntype M int8\ntype D M\nconst C D = 5\n",
			"package \"test\"\n"
					"import \"pkg/x\"\n"
					"type N x.D\n"
					"type A = x.D\n"
					"type NA A\n"
					"const cn N = 6\n"
					"const cna NA = -7\n"
					"var v x.D = x.C\n")
	return expectNoErrors(c)
}

// 200 does not fit the imported int8 chain.
func TestCheckPrefillQualifiedTargetRangeChecked() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/x"),
			"package \"pkg/x\"\ntype M int8\ntype D M\n",
			"package \"test\"\nimport \"pkg/x\"\ntype N x.D\nconst cn N = 200\n")
	return expectError(c)
}
