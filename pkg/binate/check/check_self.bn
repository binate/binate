package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

import "pkg/stdx/slices"

// `Self` type substitution — the type-checker substrate for the `Self` type.
// substituteSelf replaces every `TYP_SELF` occurrence in a type with the
// implementing type: impl validation (methodSigSatisfies) substitutes the impl's
// receiver type, and a constraint-method call (tryTypeParamMethodCall) the type
// parameter.  Whether a type mentions `Self` at all is types.MentionsSelf, which
// the object-safety gate (tryInterfaceMethodCall) applies to a method's signature.

// substituteSelf returns a copy of `t` with every TYP_SELF occurrence replaced by
// `recv`: in the elements of composite types, an anonymous struct's fields, a
// function type's parameters and results, and a generic instance's type
// arguments — every place a method signature can carry Self.  A generic instance
// whose type arguments mention Self (`Box[Self]`, the interface of `*G[Self]`) is
// re-instantiated for the substituted arguments through the shared cache, so it
// is the same @types.Type the implementing method's `Box[R]` resolves to.
// Returns `t` itself when there is nothing to substitute (the common case), and
// rebuilds a composite only when an element changed, to preserve identity.  c is
// used only to re-instantiate, so it may be nil when t contains no generic
// instance (the direct unit tests on the composite-kind walk).
func substituteSelf(c @Checker, t @types.Type, recv @types.Type) @types.Type {
	if t == nil { return nil }
	if t.Kind == types.TYP_SELF { return recv }
	if t.InstDecl != nil {
		var newArgs @[]@types.Type
		var changed bool = false
		for i := 0; i < len(t.InstArgs); i++ {
			var na @types.Type = substituteSelf(c, t.InstArgs[i], recv)
			if na != t.InstArgs[i] { changed = true }
			newArgs = slices.Append[@types.Type](newArgs, na)
		}
		if !changed { return t }
		// Not user-facing: the substitution builds the type's identity, and a
		// constraint the implementing type misses is reported where the
		// implementing method's own signature names the instance.
		var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
		return instantiateGenericDeclWithArgs(c, d, t.Kind == types.TYP_INTERFACE, newArgs, d.Pos, false)
	}
	if t.Kind == types.TYP_POINTER {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakePointerType(sub)
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeManagedPtrType(sub)
	}
	if t.Kind == types.TYP_SLICE {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeSliceType(sub)
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeManagedSliceType(sub)
	}
	if t.Kind == types.TYP_ARRAY {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		// A length that depends on a type parameter (`[sizeof(T)]Self` in a generic
		// interface) stays dependent, or the implementing method's array, which is
		// dependent too, is not identical to it.
		var at @types.Type = types.MakeArrayType(sub, t.ArrayLen)
		at.ArrayLenDependent = t.ArrayLenDependent
		return at
	}
	if t.Kind == types.TYP_READONLY {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeReadonlyType(sub)
	}
	if t.Kind == types.TYP_INTERFACE_VALUE {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeInterfaceValueType(sub)
	}
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		var sub @types.Type = substituteSelf(c, t.Elem, recv)
		if sub == t.Elem { return t }
		return types.MakeManagedInterfaceValueType(sub)
	}
	// An anonymous struct (`Mk() struct { x Self }`) is rebuilt from its
	// substituted fields.  A named struct's fields cannot mention Self except
	// through its type arguments, which the InstDecl case above substitutes.
	if t.Kind == types.TYP_STRUCT && len(t.Name) == 0 {
		var newFields @[]@types.Field
		var changed bool = false
		for i := 0; i < len(t.Fields); i++ {
			var f @types.Field = make(types.Field)
			f.Name = t.Fields[i].Name
			f.Type = substituteSelf(c, t.Fields[i].Type, recv)
			if f.Type != t.Fields[i].Type { changed = true }
			newFields = slices.Append[@types.Field](newFields, f)
		}
		if !changed { return t }
		return types.MakeStructType("", newFields)
	}
	// Function types and function-VALUE types carry Self in their
	// Params/Results (an interface method `apply(f *func(Self) int)`),
	// so recurse there and rebuild with the matching constructor.
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		var newParams @[]@types.Param
		var changed bool = false
		for i := 0; i < len(t.Params); i++ {
			var sub @types.Type = substituteSelf(c, t.Params[i].Type, recv)
			if sub != t.Params[i].Type { changed = true }
			var p @types.Param = make(types.Param)
			p.Name = t.Params[i].Name
			p.Type = sub
			p.IsVariadic = t.Params[i].IsVariadic
			newParams = slices.Append[@types.Param](newParams, p)
		}
		var newResults @[]@types.Type
		for i := 0; i < len(t.Results); i++ {
			var sub @types.Type = substituteSelf(c, t.Results[i], recv)
			if sub != t.Results[i] { changed = true }
			newResults = slices.Append[@types.Type](newResults, sub)
		}
		if !changed { return t }
		if t.Kind == types.TYP_FUNC_VALUE { return types.MakeFuncValueType(newParams, newResults) }
		if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
			return types.MakeManagedFuncValueType(newParams, newResults)
		}
		return types.MakeFuncType(newParams, newResults)
	}
	return t
}
