package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/std/vec"

// Constraint checks of instantiations whose type arguments mention `Self`
// (spec iface.self.constraint).  In an interface method signature a `Self` type
// argument satisfies a constraint C iff the interface being declared is C or
// extends it, as a type parameter bounded by that interface would.  Such a
// check therefore depends on the interface (Checker.SelfBound), which the
// instantiation cache does not key on (every `Box[Self]` shares one entry), and
// on its parents, which are resolved after its methods.  So it is never run or
// latched where the instantiation is resolved: deferSelfConstraintCheck queues
// it with its bound, and recheckSelfConstraints runs it once the bound's parents
// are known — at the end of a declaration batch (collectDecls) and, for a
// generic interface's instantiation with its own type parameters (its
// declaration check, checkGenericDeclAbstract), at the end of that
// instantiation's population.

// typeListMentionsSelf reports whether any of the types mentions `Self`.
func typeListMentionsSelf(ts *[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if types.MentionsSelf(ts[i]) { return true }
	}
	return false
}

// deferSelfConstraintCheck queues the constraint check of the instantiation
// (d, args), written at usePos in view, with the interface bounding its `Self`.
// Nothing is queued where nothing is decided about `Self`: with no SelfBound (a
// generic's abstract resolution, or a `Self` outside an interface signature,
// already reported), or in an instance resolved with its type arguments bound —
// a `Self` there arrived as a type argument, whose instantiation was checked
// where it was written, and the generic's own `Self` is decided at its
// declaration.
func deferSelfConstraintCheck(c @Checker, d @ast.Decl, args @[]@types.Type, usePos token.Pos,
		view ImplView) {
	if c.SelfBound == nil || (c.Instances != nil && c.Instances.Bound > 0) { return }
	var p @PendingConstraintCheck = make(PendingConstraintCheck)
	p.Decl = d
	p.Args = args
	p.Pos = usePos
	p.View = view
	p.Naming = namingAt(c, view)
	p.SelfBound = c.SelfBound
	if c.PendingSelfChecks == nil {
		c.PendingSelfChecks = vec.New[@PendingConstraintCheck]()
	}
	c.PendingSelfChecks.Push(p)
}

// recheckSelfConstraints runs the queued checks whose bound is bound (every
// queued check, for a nil bound), with Checker.SelfBound set to each one's
// bound, and removes them from the queue.  Like recheckDeferredConstraints, it
// also checks an interface instantiation's method sizes, which a deferred
// resolution skipped.
func recheckSelfConstraints(c @Checker, bound @types.Type) {
	if c.PendingSelfChecks == nil { return }
	var run @vec.Vec[@PendingConstraintCheck] = vec.New[@PendingConstraintCheck]()
	var kept @vec.Vec[@PendingConstraintCheck] = vec.New[@PendingConstraintCheck]()
	for i := 0; i < c.PendingSelfChecks.Len(); i++ {
		var p @PendingConstraintCheck = c.PendingSelfChecks.Get(i)
		if bound == nil || same(p.SelfBound, bound) {
			run.Push(p)
		} else {
			kept.Push(p)
		}
	}
	c.PendingSelfChecks = kept
	var savedBound @types.Type = c.SelfBound
	for i := 0; i < run.Len(); i++ {
		var p @PendingConstraintCheck = run.Get(i)
		c.SelfBound = p.SelfBound
		checkInstantiationConstraints(c, p.Decl, p.Args, p.Pos, p.View, p.Naming)
		var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, p.Decl, p.Args)
		if entry != nil && entry.Result != nil && entry.Result.Kind == types.TYP_INTERFACE {
			requireInstantiatedIfaceMethodsSized(c, entry.Result, p.Pos)
			requireIfaceInstanceArgsKept(c, entry.Result, p.Pos, p.View)
		}
	}
	c.SelfBound = savedBound
}

// boundSatisfiesConstraint reports whether a type known only to implement the
// interface bound — a type parameter constrained by it, or `Self` in its method
// signatures — satisfies the constraint iface: bound is iface or extends it.  A
// nil bound (`any`) satisfies no non-trivial constraint.  isDescendantInterface
// only walks parents (false for bound == iface), so the equal case is matched
// explicitly: the same interface — for a generic interface's instance, with
// identical type arguments (Identical), not a name that prints the same, as
// `Eq[int]` does for the predeclared int and a type parameter named int.
func boundSatisfiesConstraint(bound @types.Type, iface @types.Type) bool {
	if bound == nil || bound.Kind != types.TYP_INTERFACE { return false }
	if bound.Identical(iface) {
		return true
	}
	return isDescendantInterface(bound, iface)
}

// sameNameBoundNote explains a type parameter's constraint miss whose bound
// prints as the constraint does but is another instance of its interface: a type
// argument of the bound names a type parameter where the constraint names the
// type of the same name (`outer[int any, T Eq[int]]` against `Eq` of the
// predeclared int).
func sameNameBoundNote(t @types.Type, iface @types.Type) @[]char {
	var none @[]char
	if t == nil || t.Kind != types.TYP_TYPE_PARAM || t.TpConstraint == nil ||
			!types.CharEq(t.TpConstraint.TypeName(), iface.TypeName()) {
		return none
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(" (")
	cb.Write(t.TypeName())
	cb.Write("'s bound ")
	cb.Write(t.TpConstraint.TypeName())
	cb.Write(" names a type parameter, not the type of that name)")
	return buf.CopyStr(cb.String())
}

// selfBoundNote explains a `Self` type argument's constraint miss: the
// interface bounding it does not extend the constraint.
func selfBoundNote(c @Checker, t @types.Type, iface @types.Type) @[]char {
	var none @[]char
	if t == nil || t.Kind != types.TYP_SELF || c.SelfBound == nil { return none }
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(" (interface ")
	cb.Write(c.SelfBound.TypeName())
	cb.Write(" does not extend ")
	cb.Write(iface.TypeName())
	cb.Write(")")
	return buf.CopyStr(cb.String())
}
