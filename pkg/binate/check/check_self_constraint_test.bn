package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for `Self` as a type argument in an interface method signature
// (spec iface.self.constraint): it satisfies a constraint iff the interface
// declaring the method is the constraint or extends it.

// selfOrdPrelude declares the constraint Ord and the generic Box bounded by it.
func selfOrdPrelude() @strings.Builder {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n")
	return cb
}

// expectOneErrSub asserts the checker produced exactly one error, whose
// message contains needle.
func expectOneErrSub(c @Checker, needle *[]readonly char) testing.TestResult {
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected one error, got ")
		cb.Write(strconv.Itoa(len(errs)))
		if len(errs) > 0 {
			cb.Write(": ")
			cb.Write(errs[0].Msg)
		}
		return buf.CopyStr(cb.String())
	}
	if !charsHaveSub(errs[0].Msg, needle) { return fail(errs[0].Msg) }
	return ""
}

// An interface extending the constraint accepts `Box[Self]`.
func TestSelfTypeArgExtendingInterface() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I : Ord { Put(b *Box[Self]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The constraint itself accepts `Box[Self]` in its own methods.
func TestSelfTypeArgInConstraintItself() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box[T Ord] struct { v T }\n"
					"interface Ord { Cmp(o Self) int; Put(b *Box[Self]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The interface may reach the constraint through a parent declared after it.
func TestSelfTypeArgParentDeclaredLater() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface I : K { Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// An interface that does not extend the constraint is rejected, naming it.
func TestSelfTypeArgRejectedWithoutExtension() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I { Put(b *Box[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Ord (interface I does not extend Ord)")
}

// Every `Box[Self]` shares one cached instantiation, but each is judged by its
// own interface: Good's acceptance does not stand for Bad, nor Bad's rejection
// for Good, in either order.
func TestSelfTypeArgJudgedPerInterface() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface Good : Ord { Put(b *Box[Self]) int }\n"
					"interface Bad { Put(b *Box[Self]) int }\n"
					"interface Good2 : Ord { Take(b *Box[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// A method inherited from an interface is not checked again in the child: the
// miss is reported once, for the parent, not again for Child.
func TestSelfTypeArgInheritedNotRechecked() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface Bad { Put(b *Box[Self]) int }\n"
					"interface Child : Bad {}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// In a generic interface, `Self` is judged with the interface's own type
// parameters abstract: G[U] extends Eq[U], not Eq[int].
func TestSelfTypeArgGenericInterfaceAbstract() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { Equal(o T) bool }\n"
					"type B[T Eq[int]] struct { v T }\n"
					"interface G[U any] : Eq[U] { Put(b *B[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Eq[int]")
}

// A generic interface's own instantiation may be populated while declarations
// are collected (here through its method `Me`), before the parent K it reaches
// the constraint through has its own parents: the check waits for them.
func TestSelfTypeArgGenericInterfaceDuringCollection() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"func f(g *G[int]) int { return 0 }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n")
	var r testing.TestResult = expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
	if len(r) > 0 { return r }
	var bad @strings.Builder = selfOrdPrelude()
	bad.Write(
			"func f(g *G[int]) int { return 0 }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K {}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(bad.String())), "interface G[U] does not extend Ord")
}

// The same in an imported .bni, whose surface is built before any impl is
// recorded.
func TestSelfTypeArgGenericInterfaceInBni() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.G[int]) int { return 0 }\n")
	return expectNoErrors(c)
}

// A generic interface extending the constraint's own instantiation accepts it.
func TestSelfTypeArgGenericInterfaceExtends() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { Equal(o T) bool }\n"
					"type B[T Eq[int]] struct { v T }\n"
					"interface G[U any] : Eq[int] { Put(b *B[Self]) U }\n"
					"func use(g *G[int64]) int { return 0 }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// A type built from `Self` is judged like any other type: `*Self` is matched by
// no impl, so it does not satisfy Ord, though the interface extends Ord.
func TestSelfTypeArgPointerToSelfRejected() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I : Ord { Put(b *Box[*Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument *Self does not satisfy constraint Ord")
}

// `W[Self]` satisfies a constraint through a parameterized impl of W, whether
// or not the interface extends the constraint.
func TestSelfTypeArgThroughParameterizedImpl() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"type W[K any] struct { n int }\n"
					"func (w W[K]) Cmp(o W[K]) int { return w.n - o.n }\n"
					"impl W[K] : Ord\n"
					"interface I { Put(b *Box[W[Self]]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// `Self` through a constrained generic alias is judged by the alias's own
// constraint, which its target does not have.
func TestSelfTypeArgThroughConstrainedAlias() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T any] struct { v T }\n"
					"type O[T Ord] = Box[T]\n"
					"interface Good : Ord { Put(o O[Self]) int }\n"
					"interface Bad { Put(o O[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// Inside a generic function, `Self` in a constraint's method stands for the type
// parameter, which satisfies what its constraint extends.
func TestSelfTypeArgThroughTypeParam() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface I : Ord { Put(b *Box[Self]) int }\n"
					"func use[T I](t T, b *Box[T]) int { return t.Put(b) }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// An interface declared in an imported .bni is judged the same way.
func TestSelfTypeArgImportedInterface() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n"
					"interface Good : Ord { Put(b *Box[Self]) int }\n"
					"interface Bad { Put(b *Box[Self]) int }\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.Good) int { return 0 }\n")
	return expectOneErrSub(c, "interface Bad does not extend Ord")
}
