package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for `Self` as a type argument in an interface method signature
// (spec iface.self.constraint): it satisfies a constraint iff the interface
// declaring the method is the constraint or extends it.

// selfOrdPrelude declares the constraint Ord and the generic Box bounded by it.
func selfOrdPrelude() @strings.Builder {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n")
	return cb
}

// expectOneErrSub asserts the checker produced exactly one error, whose
// message contains needle.
func expectOneErrSub(c @Checker, needle *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected one error, got ")
		cb.Write(strconv.Itoa(len(errs)))
		if len(errs) > 0 {
			cb.Write(": ")
			cb.Write(errs[0].Msg)
		}
		return buf.CopyStr(cb.String())
	}
	if !charsHaveSub(errs[0].Msg, needle) { return fail(errs[0].Msg) }
	return ""
}

// An interface extending the constraint accepts `Box[Self]`.
func TestSelfTypeArgExtendingInterface() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I : Ord { Put(b *Box[Self]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The constraint itself accepts `Box[Self]` in its own methods.
func TestSelfTypeArgInConstraintItself() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box[T Ord] struct { v T }\n"
					"interface Ord { Cmp(o Self) int; Put(b *Box[Self]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The interface may reach the constraint through a parent declared after it.
func TestSelfTypeArgParentDeclaredLater() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface I : K { Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// An interface that does not extend the constraint is rejected, naming it.
func TestSelfTypeArgRejectedWithoutExtension() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I { Put(b *Box[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Ord (interface I does not extend Ord)")
}

// Every `Box[Self]` shares one cached instantiation, but each is judged by its
// own interface: Good's acceptance does not stand for Bad, nor Bad's rejection
// for Good, in either order.
func TestSelfTypeArgJudgedPerInterface() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface Good : Ord { Put(b *Box[Self]) int }\n"
					"interface Bad { Put(b *Box[Self]) int }\n"
					"interface Good2 : Ord { Take(b *Box[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// A method inherited from an interface is not checked again in the child: the
// miss is reported once, for the parent, not again for Child.
func TestSelfTypeArgInheritedNotRechecked() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface Bad { Put(b *Box[Self]) int }\n"
					"interface Child : Bad {}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// In a generic interface, `Self` is judged with the interface's own type
// parameters abstract: G[U] extends Eq[U], not Eq[int].
func TestSelfTypeArgGenericInterfaceAbstract() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { Equal(o T) bool }\n"
					"type B[T Eq[int]] struct { v T }\n"
					"interface G[U any] : Eq[U] { Put(b *B[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Eq[int]")
}

// A generic interface's own instantiation may be populated while declarations
// are collected (here through its method `Me`), before the parent K it reaches
// the constraint through has its own parents: the check waits for them.
func TestSelfTypeArgGenericInterfaceDuringCollection() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"func f(g *G[int]) int { return 0 }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n")
	var r testing.TestResult = expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
	if len(r) > 0 { return r }
	var bad @strings.Builder = selfOrdPrelude()
	bad.Write(
			"func f(g *G[int]) int { return 0 }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K {}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(bad.String())), "interface G[U] does not extend Ord")
}

// The same in an imported .bni, whose surface is built before any impl is
// recorded.
func TestSelfTypeArgGenericInterfaceInBni() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n"
					"interface G[U any] : K { Me() *G[U]; Put(b *Box[Self]) int }\n"
					"interface K : Ord {}\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.G[int]) int { return 0 }\n")
	return expectNoErrors(c)
}

// A generic interface extending the constraint's own instantiation accepts it.
func TestSelfTypeArgGenericInterfaceExtends() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { Equal(o T) bool }\n"
					"type B[T Eq[int]] struct { v T }\n"
					"interface G[U any] : Eq[int] { Put(b *B[Self]) U }\n"
					"func use(g *G[int64]) int { return 0 }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// A type built from `Self` is judged like any other type: `*Self` is matched by
// no impl, so it does not satisfy Ord, though the interface extends Ord.
func TestSelfTypeArgPointerToSelfRejected() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write("interface I : Ord { Put(b *Box[*Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument *Self does not satisfy constraint Ord")
}

// `W[Self]` satisfies a constraint through a parameterized impl of W, whether
// or not the interface extends the constraint.
func TestSelfTypeArgThroughParameterizedImpl() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"type W[K any] struct { n int }\n"
					"func (w W[K]) Cmp(o W[K]) int { return w.n - o.n }\n"
					"impl W[K] : Ord\n"
					"interface I { Put(b *Box[W[Self]]) int }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// `Self` through a constrained generic alias is judged by the alias's own
// constraint, which its target does not have.
func TestSelfTypeArgThroughConstrainedAlias() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T any] struct { v T }\n"
					"type O[T Ord] = Box[T]\n"
					"interface Good : Ord { Put(o O[Self]) int }\n"
					"interface Bad { Put(o O[Self]) int }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "interface Bad does not extend Ord")
}

// Inside a generic function, `Self` in a constraint's method stands for the type
// parameter, which satisfies what its constraint extends.
func TestSelfTypeArgThroughTypeParam() testing.TestResult {
	var cb @strings.Builder = selfOrdPrelude()
	cb.Write(
			"interface I : Ord { Put(b *Box[Self]) int }\n"
					"func use[T I](t T, b *Box[T]) int { return t.Put(b) }\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// An interface declared in an imported .bni is judged the same way.
func TestSelfTypeArgImportedInterface() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Ord { Cmp(o Self) int }\n"
					"type Box[T Ord] struct { v T }\n"
					"interface Good : Ord { Put(b *Box[Self]) int }\n"
					"interface Bad { Put(b *Box[Self]) int }\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.Good) int { return 0 }\n")
	return expectOneErrSub(c, "interface Bad does not extend Ord")
}

// A type parameter's bound satisfies a constraint that is the same instance of a
// generic interface, with identical type arguments, not one whose name prints the
// same: inside `outer[int any, T Eq[int]]`, T's bound is Eq of outer's type
// parameter int, so `inner[T]`, for `inner[U Eq[int]]` over the predeclared int,
// is rejected, the error saying what the bound names; with T bounded by Eq of the
// predeclared int it is accepted.
func TestTypeParamBoundSameInstance() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\n"
			"interface Eq[T any] { eq(o T) bool }\n"
			"func inner[U Eq[int]](u U) int { return 0 }\n"
	var shadowed @[]readonly char = buf.Concat(decls,
			"func outer[int any, T Eq[int]](t T) { _ = inner[T](t) }\n")
	var r testing.TestResult = expectOneErrSub(checkSrc(shadowed),
			"does not satisfy constraint Eq[int] (T's bound Eq[int] names a type parameter, "
					"not the type of that name)")
	if len(r) > 0 { return r }
	var predeclared @[]readonly char = buf.Concat(decls,
			"func outer[T Eq[int]](t T) { _ = inner[T](t) }\n")
	return expectNoErrors(checkSrc(predeclared))
}

// selfLengthPrelude declares Eq, the generic G whose constraint's length depends
// on its other type parameter, and the generic interface I3 naming G[Self, X]:
// `Self` satisfies G's constraint in I3[U, X] iff U and X have one size.
func selfLengthPrelude() @strings.Builder {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *G[Self, X]) int }\n")
	return cb
}

// expectErrSubs asserts the checker produced exactly one error per needle, the
// error at each index containing the needle there.
func expectErrSubs(c @Checker, needles *[]*[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != len(needles) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected ")
		cb.Write(strconv.Itoa(len(needles)))
		cb.Write(" errors, got ")
		cb.Write(strconv.Itoa(len(errs)))
		for i := 0; i < len(errs); i++ {
			cb.Write("; ")
			cb.Write(errs[i].Msg)
		}
		return buf.CopyStr(cb.String())
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, needles[i]) { return fail(errs[i].Msg) }
	}
	return ""
}

// A generic interface's concrete instance judges `Self` bounded by itself, with
// the lengths known (gen.mono.check): in a function's body, I3[int64, int64] is
// accepted and I3[int64, int32] is not, the error naming the instance.
func TestSelfJudgedInInterfaceInstance() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"func f() int {\n"
					"\tvar a *I3[int64, int64]\n"
					"\tvar b *I3[int64, int32]\n"
					"\t_ = a\n"
					"\t_ = b\n"
					"\treturn 0\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"constraint Eq[[4]uint8] (interface I3[int64,int32] does not extend Eq[[4]uint8]) "
					"(in I3[int64, int32], instantiated at")
}

// The same for instances named while declarations are collected -- a
// variable's type and a field's -- whose checks wait for the end of the
// collection.
func TestSelfJudgedInInterfaceInstanceDuringCollection() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"var a *I3[int64, int64]\n"
					"type H struct { f *I3[int32, int64] }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"(interface I3[int32,int64] does not extend Eq[[8]uint8]) (in I3[int32, int64], instantiated at")
}

// A miss the declaration's check reports is not reported again by an instance
// judged after it (I5[int32], in a body) nor by the first judged before it
// (I5[int64], named in a declaration, whose miss the declaration's takes the
// place of): I5 extends no Eq, whatever its type argument.
func TestSelfInstanceRepeatsNoDeclarationMiss() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface I5[U any] { m(x *G[Self, U]) int }\n"
					"var a *I5[int64]\n"
					"func f() int {\n"
					"\tvar b *I5[int32]\n"
					"\t_ = b\n"
					"\treturn 0\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Eq[[0]uint8] (interface I5[U] does not extend")
}

// An instance whose type arguments mention `Self` judges nothing: in I4[int64],
// Outer[Self, int64, int64] names G[Self, int64], whose `Self` is I4[int64]'s --
// judged where I4 names Outer -- and is not bounded by the Outer instance, which
// extends no Eq.
func TestSelfNotJudgedInInstanceOfAnotherSelf() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"interface Outer[V Eq[[sizeof(U)]uint8], U any, X any] { k(g *G[V, X]) int }\n"
					"interface I4[U any] : Eq[[sizeof(U)]uint8] { n(o *Outer[Self, U, U]) int }\n"
					"var a *I4[int64]\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The instances of an interface an imported .bni declares are judged the same
// way: the one the .bni names and the one the importer names.
func TestSelfJudgedInImportedInterfaceInstance() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *G[Self, X]) int }\n"
					"type H struct { f *I3[int64, int32] }\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.I3[int32, int32], b *s.I3[int32, int64]) int { return 0 }\n")
	var needles @[]*[]readonly char = make_slice(*[]readonly char, 2)
	needles[0] = "(in I3[int64, int32], instantiated at"
	needles[1] = "(in I3[int32, int64], instantiated at"
	return expectErrSubs(c, needles)
}

// An instance formed in a generic function's instance is judged there, naming
// the chain that formed it.
func TestSelfJudgedInInstanceFromGenericFunction() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"func f[T any]() int {\n"
					"\tvar x *I3[T, int32]\n"
					"\t_ = x\n"
					"\treturn 1\n"
					"}\n"
					"func g() int { return f[int32]() + f[int64]() }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "(in I3[int64, int32], instantiated at")
}

// An instance first built in a derivation -- a generic function instance's
// signature, a method's signature copied onto a type's instance -- judges its
// `Self` there, as it would anywhere else: its cached build is never judged
// again, so a later use does not make up for it.
func TestSelfJudgedInInstanceFirstBuiltInDerivation() testing.TestResult {
	var fn @strings.Builder = selfLengthPrelude()
	fn.Write(
			"func h[T any](x **I3[T, int32]) int { return 1 }\n"
					"func g() int {\n"
					"\tvar later *I3[int64, int32]\n"
					"\t_ = later\n"
					"\treturn h[int64](nil)\n"
					"}\n")
	var r testing.TestResult = expectOneErrSub(checkSrc(buf.CopyStr(fn.String())),
			"(in I3[int64, int32], instantiated at")
	if len(r) > 0 { return r }
	var method @strings.Builder = selfLengthPrelude()
	method.Write(
			"type S[T any] struct { t T }\n"
					"func (s *S[T]) f(x **I3[T, int32]) int { return 0 }\n"
					"func g() int {\n"
					"\tvar s S[int64]\n"
					"\tvar later *I3[int64, int32]\n"
					"\t_ = later\n"
					"\treturn s.f(nil)\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(method.String())),
			"(in I3[int64, int32], instantiated at")
}

// A generic alias's target is as if written where the alias is used: a `Self`
// argument of an instantiation in it is judged with the interface using the
// alias, in an instance (named) and in a non-generic interface -- not at a
// generic interface's declaration, whose dependent lengths are placeholders
// there (Hh[int64] is valid).
func TestSelfJudgedThroughAliasTarget() testing.TestResult {
	var inst @strings.Builder = selfLengthPrelude()
	inst.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface I4[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *GA[Self, U, X]) int }\n"
					"var ok *I4[int64, int64]\n"
					"var bad *I4[int64, int32]\n")
	var r testing.TestResult = expectOneErrSub(checkSrc(buf.CopyStr(inst.String())),
			"(interface I4[int64,int32] does not extend Eq[[4]uint8]) (in I4[int64, int32], instantiated at")
	if len(r) > 0 { return r }
	var plain @strings.Builder = selfLengthPrelude()
	plain.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface J : Eq[[8]uint8] { m(x *GA[Self, int64, int32]) int }\n"
					"interface K : Eq[[8]uint8] { m(x *GA[Self, int64, int64]) int }\n")
	r = expectOneErrSub(checkSrc(buf.CopyStr(plain.String())),
			"type argument Self does not satisfy constraint Eq[[4]uint8] (interface J does not extend")
	if len(r) > 0 { return r }
	var decl @strings.Builder = selfLengthPrelude()
	decl.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface Hh[U any] : Eq[[sizeof(U)]uint8] { m(x *GA[Self, U, int64]) int }\n"
					"var a *Hh[int64]\n")
	return expectNoErrors(checkSrc(buf.CopyStr(decl.String())))
}

// A constraint resolved for the type arguments of an instantiation judged in an
// instance (Cmp[Self, int64], V's in G2[Self, int64, *Q]) queues no `Self` check
// of its own, which no point would make: none is left once the package is
// checked.
func TestSelfConstraintFormsNoPendingCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"interface Cmp[A Eq[[8]uint8], B any] { cmp(b B) int }\n"
					"type G2[T Eq[[sizeof(X)]uint8], X any, V Cmp[T, X]] struct { t T; v V }\n"
					"type Q struct { w int }\n"
					"interface I6[U any] : Eq[[sizeof(U)]uint8] { m(x *G2[Self, U, *Q]) int }\n"
					"var a *I6[int64]\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	if c.PendingSelfChecks != nil && c.PendingSelfChecks.Len() > 0 {
		var mb @strings.Builder = strings.NewBuilder()
		mb.Write("Self checks left queued: ")
		mb.Write(strconv.Itoa(c.PendingSelfChecks.Len()))
		return buf.CopyStr(mb.String())
	}
	return ""
}
