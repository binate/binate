package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for `Self` judged in each concrete instance of a generic interface
// (spec iface.self.constraint, gen.mono.check): bounded by that instance, with
// the lengths that depend on its type arguments known.

// selfLengthPrelude declares Eq, the generic G whose constraint's length depends
// on its other type parameter, and the generic interface I3 naming G[Self, X]:
// `Self` satisfies G's constraint in I3[U, X] iff U and X have one size.
func selfLengthPrelude() @strings.Builder {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *G[Self, X]) int }\n")
	return cb
}

// expectErrSubs asserts the checker produced exactly one error per needle, the
// error at each index containing the needle there.
func expectErrSubs(c @Checker, needles *[]*[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != len(needles) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected ")
		cb.Write(strconv.Itoa(len(needles)))
		cb.Write(" errors, got ")
		cb.Write(strconv.Itoa(len(errs)))
		for i := 0; i < len(errs); i++ {
			cb.Write("; ")
			cb.Write(errs[i].Msg)
		}
		return buf.CopyStr(cb.String())
	}
	for i := 0; i < len(errs); i++ {
		if !charsHaveSub(errs[i].Msg, needles[i]) { return fail(errs[i].Msg) }
	}
	return ""
}

// A generic interface's concrete instance judges `Self` bounded by itself, with
// the lengths known (gen.mono.check): in a function's body, I3[int64, int64] is
// accepted and I3[int64, int32] is not, the error naming the instance.
func TestSelfJudgedInInterfaceInstance() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"func f() int {\n"
					"\tvar a *I3[int64, int64]\n"
					"\tvar b *I3[int64, int32]\n"
					"\t_ = a\n"
					"\t_ = b\n"
					"\treturn 0\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"constraint Eq[[4]uint8] (interface I3[int64,int32] does not extend Eq[[4]uint8]) "
					"(in I3[int64, int32], instantiated at")
}

// The same for instances named while declarations are collected -- a
// variable's type and a field's -- whose checks wait for I3's declaration check.
func TestSelfJudgedInInterfaceInstanceDuringCollection() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"var a *I3[int64, int64]\n"
					"type H struct { f *I3[int32, int64] }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"(interface I3[int32,int64] does not extend Eq[[8]uint8]) (in I3[int32, int64], instantiated at")
}

// A miss the declaration's check reports is not reported again by an instance
// (I5 extends no Eq, whatever its type argument): not by one judged after it
// (I5[int32], in a body), nor by those built before it -- named in declarations
// (I5[int64], I5[int16]) or in a generic declared before I5 (I5[int8]) -- whose
// judgments wait for it.
func TestSelfInstanceRepeatsNoDeclarationMiss() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"type X[T any] struct { p *I5[int8]; t T }\n"
					"interface I5[U any] { m(x *G[Self, U]) int }\n"
					"var a *I5[int64]\n"
					"type H struct { f *I5[int16] }\n"
					"func f() int {\n"
					"\tvar b *I5[int32]\n"
					"\t_ = b\n"
					"\treturn 0\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Eq[[0]uint8] (interface I5[U] does not extend")
}

// Nor by instances built elsewhere before the declaration's check: through an
// interface extending I5 (C, declared before it), and in a generic function's
// signature, a generic type's method's and another generic interface's method's.
func TestSelfInstanceRepeatsNoDeclarationMissElsewhere() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface C[U any] : I5[U] { n() int }\n"
					"func h[T any](x *I5[int8], t T) int { return 1 }\n"
					"type S[T any] struct { t T }\n"
					"func (s *S[T]) f(y *I5[int16]) int { return 0 }\n"
					"interface K[U any] { k(z *I5[uint8]) int }\n"
					"interface I5[U any] { m(x *G[Self, U]) int }\n"
					"var c1 *C[int64]\n"
					"var c2 *C[int32]\n"
					"var k *K[int32]\n"
					"func use() int {\n"
					"\tvar s S[int64]\n"
					"\tvar x *I5[int8]\n"
					"\tvar y *I5[int16]\n"
					"\treturn s.f(y) + h[int32](x, 3)\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())),
			"type argument Self does not satisfy constraint Eq[[0]uint8] (interface I5[U] does not extend")
}

// An instance whose type arguments mention `Self` judges nothing: in I4[int64],
// Outer[Self, int64, int64] names G[Self, int64], whose `Self` is I4[int64]'s --
// judged where I4 names Outer -- and is not bounded by the Outer instance, which
// extends no Eq.
func TestSelfNotJudgedInInstanceOfAnotherSelf() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"interface Outer[V Eq[[sizeof(U)]uint8], U any, X any] { k(g *G[V, X]) int }\n"
					"interface I4[U any] : Eq[[sizeof(U)]uint8] { n(o *Outer[Self, U, U]) int }\n"
					"var a *I4[int64]\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// The instances of an interface an imported .bni declares are judged the same
// way: the one the .bni names and the one the importer names.
func TestSelfJudgedInImportedInterfaceInstance() testing.TestResult {
	var c @Checker = checkSrcImporting(buf.CopyStr("pkg/s"),
			"package \"pkg/s\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"type G[T Eq[[sizeof(U)]uint8], U any] struct { t T }\n"
					"interface I3[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *G[Self, X]) int }\n"
					"type H struct { f *I3[int64, int32] }\n",
			"package \"main\"\n"
					"import \"pkg/s\"\n"
					"func use(g *s.I3[int32, int32], b *s.I3[int32, int64]) int { return 0 }\n")
	var needles @[]*[]readonly char = make_slice(*[]readonly char, 2)
	needles[0] = "(in I3[int64, int32], instantiated at"
	needles[1] = "(in I3[int32, int64], instantiated at"
	return expectErrSubs(c, needles)
}

// An instance formed in a generic function's instance is judged there, naming
// the chain that formed it.
func TestSelfJudgedInInstanceFromGenericFunction() testing.TestResult {
	var cb @strings.Builder = selfLengthPrelude()
	cb.Write(
			"func f[T any]() int {\n"
					"\tvar x *I3[T, int32]\n"
					"\t_ = x\n"
					"\treturn 1\n"
					"}\n"
					"func g() int { return f[int32]() + f[int64]() }\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(cb.String())), "(in I3[int64, int32], instantiated at")
}

// An instance first built in a derivation -- a generic function instance's
// signature, a method's signature copied onto a type's instance -- judges its
// `Self` there, as it would anywhere else: its cached build is never judged
// again, so a later use does not make up for it.
func TestSelfJudgedInInstanceFirstBuiltInDerivation() testing.TestResult {
	var fn @strings.Builder = selfLengthPrelude()
	fn.Write(
			"func h[T any](x **I3[T, int32]) int { return 1 }\n"
					"func g() int {\n"
					"\tvar later *I3[int64, int32]\n"
					"\t_ = later\n"
					"\treturn h[int64](nil)\n"
					"}\n")
	var r testing.TestResult = expectOneErrSub(checkSrc(buf.CopyStr(fn.String())),
			"(in I3[int64, int32], instantiated at")
	if len(r) > 0 { return r }
	var method @strings.Builder = selfLengthPrelude()
	method.Write(
			"type S[T any] struct { t T }\n"
					"func (s *S[T]) f(x **I3[T, int32]) int { return 0 }\n"
					"func g() int {\n"
					"\tvar s S[int64]\n"
					"\tvar later *I3[int64, int32]\n"
					"\t_ = later\n"
					"\treturn s.f(nil)\n"
					"}\n")
	return expectOneErrSub(checkSrc(buf.CopyStr(method.String())),
			"(in I3[int64, int32], instantiated at")
}

// A generic alias's target is as if written where the alias is used: a `Self`
// argument of an instantiation in it is judged with the interface using the
// alias, in an instance (named) and in a non-generic interface -- not at a
// generic interface's declaration, whose dependent lengths are placeholders
// there (Hh[int64] is valid).
func TestSelfJudgedThroughAliasTarget() testing.TestResult {
	var inst @strings.Builder = selfLengthPrelude()
	inst.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface I4[U any, X any] : Eq[[sizeof(U)]uint8] { m(x *GA[Self, U, X]) int }\n"
					"var ok *I4[int64, int64]\n"
					"var bad *I4[int64, int32]\n")
	var r testing.TestResult = expectOneErrSub(checkSrc(buf.CopyStr(inst.String())),
			"(interface I4[int64,int32] does not extend Eq[[4]uint8]) (in I4[int64, int32], instantiated at")
	if len(r) > 0 { return r }
	var plain @strings.Builder = selfLengthPrelude()
	plain.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface J : Eq[[8]uint8] { m(x *GA[Self, int64, int32]) int }\n"
					"interface K : Eq[[8]uint8] { m(x *GA[Self, int64, int64]) int }\n")
	r = expectOneErrSub(checkSrc(buf.CopyStr(plain.String())),
			"type argument Self does not satisfy constraint Eq[[4]uint8] (interface J does not extend")
	if len(r) > 0 { return r }
	var decl @strings.Builder = selfLengthPrelude()
	decl.Write(
			"type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]\n"
					"interface Hh[U any] : Eq[[sizeof(U)]uint8] { m(x *GA[Self, U, int64]) int }\n"
					"var a *Hh[int64]\n")
	return expectNoErrors(checkSrc(buf.CopyStr(decl.String())))
}

// A constraint resolved for the type arguments of an instantiation judged in an
// instance (Cmp[Self, int64], V's in G2[Self, int64, *Q]) queues no `Self` check
// of its own, which no point would make: none is left once the package is
// checked.
func TestSelfConstraintFormsNoPendingCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq[T any] { eq(o T) int }\n"
					"interface Cmp[A Eq[[8]uint8], B any] { cmp(b B) int }\n"
					"type G2[T Eq[[sizeof(X)]uint8], X any, V Cmp[T, X]] struct { t T; v V }\n"
					"type Q struct { w int }\n"
					"interface I6[U any] : Eq[[sizeof(U)]uint8] { m(x *G2[Self, U, *Q]) int }\n"
					"var a *I6[int64]\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	if c.PendingSelfChecks != nil && c.PendingSelfChecks.Len() > 0 {
		var mb @strings.Builder = strings.NewBuilder()
		mb.Write("Self checks left queued: ")
		mb.Write(strconv.Itoa(c.PendingSelfChecks.Len()))
		return buf.CopyStr(mb.String())
	}
	return ""
}
