package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the `Self` type substrate: TYP_SELF singleton,
// AllowSelf gating in
// resolveTypeExpr, the substituteSelf helper, impl-validation
// against a Self-using interface, and the object-safety gate.

// ============================================================
// Direct helper tests
// ============================================================

// TypSelf returns a singleton — same identity across calls.
func TestTypSelfSingleton() testing.TestResult {
	var a @types.Type = types.TypSelf()
	var b @types.Type = types.TypSelf()
	if a == nil { return fail("TypSelf returned nil") }
	if a != b { return fail("TypSelf is not a singleton") }
	if a.Kind != types.TYP_SELF { return fail("TypSelf().Kind != TYP_SELF") }
	return ""
}

// substituteSelf replaces TYP_SELF with the receiver type.
func TestSubstituteSelfBare() testing.TestResult {
	var named @types.Type = types.MakeNamedType("Point")
	var out @types.Type = substituteSelf(nil, types.TypSelf(), named)
	if out != named {
		return fail("expected substituteSelf(Self, Point) == Point")
	}
	return ""
}

// substituteSelf recurses into composites.
func TestSubstituteSelfPointer() testing.TestResult {
	var named @types.Type = types.MakeNamedType("Point")
	var ptrSelf @types.Type = types.MakePointerType(types.TypSelf())
	var out @types.Type = substituteSelf(nil, ptrSelf, named)
	if out == nil || out.Kind != types.TYP_POINTER {
		return fail("expected pointer kind")
	}
	if out.Elem != named {
		return fail("expected *Point after substitution")
	}
	return ""
}

// substituteSelf returns the same type unchanged when no Self
// is present (preserves identity for the common case).
func TestSubstituteSelfNoOp() testing.TestResult {
	var named @types.Type = types.MakeNamedType("Point")
	var slc @types.Type = types.MakeManagedSliceType(types.TypInt())
	var out @types.Type = substituteSelf(nil, slc, named)
	if out != slc {
		return fail("expected pointer-equal pass-through when no Self present")
	}
	return ""
}

// ============================================================
// Resolution / context-gating tests
// ============================================================

// Self in an interface method argument is accepted.
func TestSelfInInterfaceArg() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq { Equals(other Self) bool }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Self in an interface method result is accepted.
func TestSelfInInterfaceResult() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Cloneable { Clone() Self }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// *Self / @Self / @[]Self in interface method positions all OK.
func TestSelfCompositesInInterface() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Mix {\n"
					"\tA(p *Self) bool\n"
					"\tB() @Self\n"
					"\tC() @[]Self\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Self in a plain top-level func decl is rejected.
func TestSelfRejectedInFuncDecl() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func bad(x Self) bool { return true }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Self in a struct field is rejected.
func TestSelfRejectedInStructField() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { x Self }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Self in a var decl type is rejected.
func TestSelfRejectedInVarDecl() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"var x Self\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// AllowSelf is restored after the interface-decl block — a
// later (non-interface) decl referencing Self still errors.
func TestSelfAllowSelfRestored() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq { Equals(other Self) bool }\n"
					"func leak(x Self) {}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// ============================================================
// Impl-validation tests against Self-using interfaces
// ============================================================

// A matching impl satisfies a Self-using interface.
func TestImplSatisfiesSelfInterface() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct { x int; y int }\n"
					"interface Eq { Equals(other Self) bool }\n"
					"func (a *Point) Equals(b Point) bool {\n"
					"\treturn a.x == b.x && a.y == b.y\n"
					"}\n"
					"impl *Point : Eq\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// An impl whose `other` arg type doesn't match the named base
// is rejected as a signature mismatch.
func TestImplMismatchSelfArgType() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct { x int }\n"
					"type Other struct { y int }\n"
					"interface Eq { Equals(other Self) bool }\n")
	// `other` should be Point (Self → Point), not Other.
	cb.Write(
			"func (a *Point) Equals(b Other) bool { return false }\n"
					"impl *Point : Eq\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// A Self-returning interface method satisfies when the impl
// returns the named base type.
func TestImplSatisfiesSelfReturn() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct { x int }\n"
					"interface Cloneable { Clone() Self }\n"
					"func (p *Point) Clone() Point {\n"
					"\tvar np Point\n"
					"\tnp.x = p.x\n"
					"\treturn np\n"
					"}\n"
					"impl *Point : Cloneable\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// `*Self` substitutes correctly: impl method must take a *Point.
func TestImplPointerSelf() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct { x int }\n"
					"interface Pair { Both(other *Self) bool }\n"
					"func (a *Point) Both(b *Point) bool { return a.x == b.x }\n"
					"impl *Point : Pair\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// ============================================================
// Interface-value call rejection for Self-using methods
// ============================================================

// Calling a Self-using method through an interface value is
// rejected — the dispatch site can't bind Self to a concrete
// type, and such methods are reachable only through generic
// constraints (spec §11.9 iface.self.object-safety).
func TestSelfMethodCallThroughIvRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq { Equals(other Self) bool }\n"
					"type T struct { x int }\n"
					"func (a *T) Equals(b T) bool { return a.x == b.x }\n"
					"impl *T : Eq\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar u T\n"
					"\tvar iv *Eq = &t\n"
					"\tvar _ bool = iv.Equals(u)\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Self in result position is also rejected at the iv call site
// (Cloneable.Clone() Self can't return through type erasure).
func TestSelfReturnCallThroughIvRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Cloneable { Clone() Self }\n"
					"type Point struct { x int }\n"
					"func (p *Point) Clone() Point {\n"
					"\tvar np Point\n"
					"\tnp.x = p.x\n"
					"\treturn np\n"
					"}\n"
					"impl *Point : Cloneable\n"
					"func main() {\n"
					"\tvar p Point\n"
					"\tvar iv *Cloneable = &p\n"
					"\tvar _ Point = iv.Clone()\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Non-Self methods on an interface remain callable through an
// interface value — the rejection is per-method, not per-
// interface.  This pins that calling a Self-free sibling
// method on the same interface still works.
func TestNonSelfMethodCallThroughIvAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Mixed {\n")
	cb.Write("\tName() int\n") // no Self → callable through iv
	cb.Write("\tEquals(other Self) bool\n") // Self → not callable through iv
	cb.Write(
			"}\n"
					"type T struct { x int }\n"
					"func (a *T) Name() int { return a.x }\n"
					"func (a *T) Equals(b T) bool { return a.x == b.x }\n"
					"impl *T : Mixed\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar iv *Mixed = &t\n")
	cb.Write("\tvar _ int = iv.Name()\n") // Name (Self-free): OK
	cb.Write("}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Same behavior through a managed interface value (@Iface).
func TestSelfMethodCallThroughManagedIvRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq { Equals(other Self) bool }\n"
					"type T struct { x int }\n"
					"func (a @T) Equals(b T) bool { return a.x == b.x }\n"
					"impl @T : Eq\n"
					"func main() {\n"
					"\tvar t @T = box(T{x: 1})\n"
					"\tvar u T\n"
					"\tvar iv @Eq = t\n"
					"\tvar _ bool = iv.Equals(u)\n"
					"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Self-using method inherited from a parent interface is also
// rejected when called through a child iv (covers the
// LookupInterfaceMethod path with Hashable : Comparable shape).
func TestSelfMethodInheritedRejectedThroughIv() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Eq { Equals(other Self) bool }\n"
					"interface Hashable : Eq { Hash() uint }\n"
					"type T struct { x int }\n"
					"func (a *T) Equals(b T) bool { return a.x == b.x }\n"
					"func (a *T) Hash() uint { return cast(uint, a.x) }\n"
					"impl *T : Hashable\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar u T\n"
					"\tvar iv *Hashable = &t\n")
	cb.Write("\tvar _ bool = iv.Equals(u)\n") // inherited from Eq, uses Self
	cb.Write("}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// ============================================================
// Self inside an anonymous struct type and inside type arguments
// ============================================================

// selfShapeIfaceSrc declares interface I with one method of each shape that
// carries Self inside another type — an anonymous struct result, a generic
// struct instance, a generic interface instance — and value-receiver methods on
// P that implement them with Self = P.
func selfShapeIfaceSrc(tail *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box[T any] struct { v T }\n"
					"interface G[T any] { Get() T }\n"
					"interface I {\n"
					"\tMk() struct { x Self }\n"
					"\tPut(b *Box[Self]) int\n"
					"\tSrc() *G[Self]\n"
					"\tTag() int\n"
					"}\n"
					"type P struct { v int }\n"
					"func (p P) Mk() struct { x P } { var r struct { x P }; r.x = p; return r }\n"
					"func (p P) Put(b *Box[P]) int { return b.v.v }\n"
					"func (p P) Src() *G[P] { var g *G[P]; return g }\n"
					"func (p P) Tag() int { return p.v }\n"
					"impl P : I\n")
	cb.Write(tail)
	return buf.CopyStr(cb.String())
}

// An impl satisfies a method whose Self sits inside an anonymous struct or a
// type argument: substitution reaches the field and re-instantiates the
// instance for the implementing type.
func TestSelfInsideStructAndTypeArgImplemented() testing.TestResult {
	return expectNoErrors(checkSrc(selfShapeIfaceSrc("")))
}

// Each such method is object-unsafe: a call through an interface value is
// rejected, while the Self-free sibling Tag stays callable.
func TestSelfInsideStructResultRejectedThroughIv() testing.TestResult {
	return expectErrSub(
			checkSrc(selfShapeIfaceSrc(
					"func f(e *I) int { var s = e.Mk(); _ = s; return e.Tag() }\n")), "uses `Self`")
}

func TestSelfInsideStructTypeArgRejectedThroughIv() testing.TestResult {
	return expectErrSub(
			checkSrc(selfShapeIfaceSrc(
					"func f(e *I, b *Box[P]) int { return e.Put(b) }\n")), "uses `Self`")
}

func TestSelfInsideIfaceTypeArgRejectedThroughIv() testing.TestResult {
	return expectErrSub(checkSrc(selfShapeIfaceSrc(
			"func f(e *I) { var g = e.Src(); _ = g }\n")), "uses `Self`")
}

func TestSelfFreeSiblingCallableThroughIv() testing.TestResult {
	return expectNoErrors(checkSrc(selfShapeIfaceSrc(
			"func f(e *I) int { return e.Tag() }\n")))
}

// Through a generic constraint, Self becomes the type parameter inside the
// struct and the type argument alike, so the abstract body checks and its
// instance for P calls P's methods.
func TestSelfInsideStructAndTypeArgThroughConstraint() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					selfShapeIfaceSrc(
							"func use[T I](t T, b *Box[T]) T {\n"
									"\tvar s struct { x T } = t.Mk()\n"
									"\tvar _ int = t.Put(b)\n"
									"\tvar _ *G[T] = t.Src()\n"
									"\treturn s.x\n"
									"}\n"
									"func main() { var p P; var b Box[P]; b.v = p; var _ P = use[P](p, &b) }\n")))
}

// An implementing method whose struct field or type argument is not the
// implementing type does not satisfy the interface.
func TestSelfInsideStructMismatchRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\n"
							"interface I { Mk() struct { x Self } }\n"
							"type P struct { v int }\n"
							"func (p P) Mk() struct { x int } { var r struct { x int }; return r }\n"
							"impl P : I\n"), "wrong signature")
}

func TestSelfInsideTypeArgMismatchRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\n"
							"type Box[T any] struct { v T }\n"
							"interface I { Put(b *Box[Self]) int }\n"
							"type P struct { v int }\n"
							"func (p P) Put(b *Box[int]) int { return b.v }\n"
							"impl P : I\n"), "wrong signature")
}

// A generic-receiver impl whose Self sits in an array with a length that depends
// on a type parameter: substitution keeps the length dependent, so the
// implementing method's `[sizeof(T)]W[T]` matches.
func TestSelfInDependentArrayGenericRecvImpl() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"interface I[T any] { M(a *([sizeof(T)]Self)) int }\n"
							"type W[T any] struct { n int }\n"
							"func (w W[T]) M(a *([sizeof(T)]W[T])) int { return 8 }\n"
							"impl W[T] : I[T]\n"
							"func use[K I[int64]](k K, a *([8]K)) int { return k.M(a) }\n"
							"func main() { var w W[int64]; var a [8]W[int64]; var _ int = use[W[int64]](w, &a) }\n"))
}
