package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// sizedAliases holds, while a batch's declarations are checked in the package's own
// view, the aliases on the chains of the types requireSizedType found sized -- no
// opaque rule broken, nothing too large, nothing made again later -- so the
// declarations of a chain of aliases each stop at the next.  It holds while no type
// changes.
type sizedAliases struct {
	kept    @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
	changes int
}

// newSizedAliases returns an empty sizedAliases.
func newSizedAliases(c @Checker) @sizedAliases {
	var s @sizedAliases = make(sizedAliases)
	s.kept = newTypeSet()
	s.changes = typeChanges(c)
	return s
}

// sizedAliasesHere returns the aliases kept while a batch's declarations are checked in
// its package's own view (batchViewMemo), emptied if a type has changed since they were
// found, or nil where none are kept.
func sizedAliasesHere(c @Checker) @sizedAliases {
	var m @pointeeMemo = batchViewMemo(c)
	if m == nil { return nil }
	if m.sized.changes != typeChanges(c) { m.sized = newSizedAliases(c) }
	return m.sized
}

// isAliasLink reports whether t is an alias or readonly, a link of a chain an alias
// set (aliasChainKept) follows.
func isAliasLink(t @types.Type) bool {
	return t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY)
}

// aliasChainKept reports whether t's chain of aliases and readonly reaches an alias in
// kept, then keeping the aliases before it too; otherwise it leaves them in passed.
func aliasChainKept(kept @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq],
		t @types.Type, passed @vec.Vec[@types.Type]) bool {
	var g chainGuard = newChainGuard(t)
	var u @types.Type = t
	for isAliasLink(u) {
		if u.Kind == types.TYP_ALIAS {
			if kept.Has(u) {
				keepAliases(kept, passed)
				return true
			}
			passed.Push(u)
			u = u.Target
		} else {
			u = u.Elem
		}
		if u != nil && chainCloses(&g, u) { return false }
	}
	return false
}

// keepAliases adds the aliases passed to kept.
func keepAliases(kept @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq],
		passed @vec.Vec[@types.Type]) {
	for i := 0; i < passed.Len(); i++ { kept.Put(passed.Get(i), true) }
}
