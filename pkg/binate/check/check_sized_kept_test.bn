package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_sized_kept.bn: the aliases requireSizedType keeps across a batch.

// sizedTestChain returns the first of n aliases main.<p>0 .. main.<p>(n-1), each of
// the next, the last of leaf.
func sizedTestChain(p *[]readonly char, n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := n - 1; i >= 0; i-- {
		t = types.MakeAliasType(buf.Concat(buf.Concat("main.", p), strconv.Itoa(i)), t)
	}
	return t
}

// A chain of aliases over int is sized and its aliases kept, and an alias of a kept
// link is kept at it; a chain over an opaque type is reported at each ask and none of
// it kept; no aliases are kept outside a batch's check, and a type change empties
// them.
func TestSizedAliasesKept() testing.TestResult {
	var c @Checker = NewChecker()
	c.curPkgPath = buf.CopyStr("main")
	c.PointeeMemo = newPointeeMemo(c)
	var pos token.Pos
	var sized @types.Type = sizedTestChain("F", 5, types.TypInt())
	requireSizedType(c, sized, pos)
	var kept @sizedAliases = sizedAliasesHere(c)
	if len(c.CheckerErrors()) != 0 { return fail("a chain over int is sized") }
	if !kept.kept.Has(sized) || !kept.kept.Has(sized.Target.Target) {
		return fail("the chain's aliases are kept")
	}
	var over @types.Type = types.MakeAliasType(buf.CopyStr("main.G"), sized.Target)
	requireSizedType(c, over, pos)
	if len(c.CheckerErrors()) != 0 || !kept.kept.Has(over) {
		return fail("an alias of a kept link is sized, and kept")
	}
	var opaque @types.Type = sizedTestChain("H", 3, types.MakeNamedType(buf.CopyStr("main.Op")))
	var second token.Pos
	second.Line = 2
	requireSizedType(c, opaque, pos)
	requireSizedType(c, opaque, second)
	if len(c.CheckerErrors()) != 2 {
		return fail("a chain over an opaque type is reported each time")
	}
	if kept.kept.Has(opaque) { return fail("a chain over an opaque type is not kept") }
	if sizedAliasesHere(NewChecker()) != nil { return fail("none are kept outside a batch's check") }
	noteTypeGraphChanged(c)
	if sizedAliasesHere(c).kept.Has(sized) { return fail("a type change empties the kept aliases") }
	return ""
}
