package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// ============================================================
// Statement Checking
// ============================================================

// checkStmt type-checks a single statement, dispatching by statement kind.
func checkStmt(c @Checker, s @ast.Stmt) {
	if s == nil {
		return
	}

	if s.Kind == ast.STMT_BLOCK {
		pushScope(c)
		checkBlockStmt(c, s)
		popScope(c)
		return
	}

	if s.Kind == ast.STMT_EXPR {
		// An expression statement discards its value — a call's result tuple
		// or no-result call included (func.call.value).
		checkExprRaw(c, s.X)
		return
	}

	if s.Kind == ast.STMT_ASSIGN {
		checkAssignStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_SHORT_VAR {
		checkShortVarDecl(c, s)
		return
	}

	if s.Kind == ast.STMT_INC_DEC {
		var t @types.Type = checkExpr(c, s.X)
		var reported bool = false
		if !t.IsInteger() && !isErrType(t) {
			addCheckError(c, s.X.Pos, "inc/dec requires integer operand")
			reported = true
		}
		// Reject ++/-- on a readonly-typed LOCATION — a readonly local, a readonly
		// struct field, or an element of a readonly array (now typed `readonly T`
		// by checkIndexExpr).  Like the `=` / `+=` paths (check_assign.bn), a const
		// location has no writable storage; without this `x++` / `s.f--` / `r[i]--`
		// silently mutates the const at runtime.
		if t != nil && t.IsReadonly() {
			addCheckError(c, s.X.Pos, "cannot inc/dec const-typed location")
			reported = true
		}
		// Reject ++/-- on a const — like assignment, a const has no
		// storage to mutate (unqualified `C++` and qualified `pkg.C++`).
		// Without this the checker accepts it and, once a local const is
		// materialized into a slot, ++/-- mutates the const at runtime.
		if s.X.Kind == ast.EXPR_IDENT {
			var sym @Symbol = c.Scope.Lookup(s.X.Name)
			if sym != nil && sym.Kind == types.SYM_CONST {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("cannot inc/dec const ")
				cb.Write(s.X.Name)
				addCheckError(c, s.X.Pos, buf.CopyStr(cb.String()))
				reported = true
			}
		}
		var qm @Symbol = resolveQualifiedSym(c, s.X)
		if qm != nil && qm.Kind == types.SYM_CONST {
			var qcb @strings.Builder = strings.NewBuilder()
			qcb.Write("cannot inc/dec const ")
			qcb.Write(s.X.Name)
			addCheckError(c, s.X.Pos, buf.CopyStr(qcb.String()))
			reported = true
		}
		// `x++` is `x += 1` (§14.5): the operand must be addressable, as a compound
		// assignment's target must — else the increment lands in a throwaway copy
		// (`getS().x++`).  Checked only when nothing above has reported the
		// operand already: one mistake, one error.
		if !reported {
			checkLvalueAddressable(c, s.X, "cannot inc/dec a non-addressable value")
		}
		return
	}

	if s.Kind == ast.STMT_RETURN {
		if c.InDefer {
			// One mistake, one error: the operands are still checked for errors of
			// their own, but not against the function's results.
			addCheckError(c, s.Pos, "a deferred block may not return")
			for i := 0; i < len(s.Exprs); i++ {
				checkExprRaw(c, s.Exprs[i])
			}
			return
		}
		checkReturnStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_IF {
		var cond @types.Type = checkExpr(c, s.X)
		if !cond.IsBool() && cond.Kind != types.TYP_ERROR {
			addCheckError(c, s.X.Pos, "non-bool condition")
		}
		pushScope(c)
		checkBlockStmt(c, s.Body)
		popScope(c)
		if s.Else != nil {
			checkStmt(c, s.Else)
		}
		return
	}

	if s.Kind == ast.STMT_FOR {
		checkForStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_SWITCH {
		checkSwitchStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_TYPE_SWITCH {
		checkTypeSwitchStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_DECL {
		if s.DeclRef != nil {
			if s.DeclRef.Kind == ast.DECL_VAR {
				errIfRedeclaredLocal(c, s.DeclRef.Name, s.DeclRef.Pos, false)
				// A local var initializer is a BORROWING position, as a `:=` one is
				// (§11.4) — typed, inferred or blank, alone or in a group: a temporary
				// a composite element borrows into a raw interface value co-scopes
				// with the new binding.
				var savedPos int = c.BorrowPosKind
				c.BorrowPosKind = POS_BORROWING
				checkVarDecl(c, s.DeclRef)
				c.BorrowPosKind = savedPos
			}
			if s.DeclRef.Kind == ast.DECL_CONST {
				errIfRedeclaredLocal(c, s.DeclRef.Name, s.DeclRef.Pos, false)
				checkConstDecl(c, s.DeclRef)
			}
			if s.DeclRef.Kind == ast.DECL_TYPE {
				collectTypeDecl(c, s.DeclRef)
			}
			// A grouped `const ( … )` / `var ( … )` inside a function body parses
			// to DECL_GROUP, just like at package scope.  checkLocalGroupDecl
			// defines the members into the current (function / block) scope and
			// runs the const-group iota machinery — without this arm a func-local
			// group's members are never defined and every use reports "undefined:
			// <member>".
			if s.DeclRef.Kind == ast.DECL_GROUP {
				checkLocalGroupRedeclared(c, s.DeclRef)
				var savedGroupPos int = c.BorrowPosKind
				c.BorrowPosKind = POS_BORROWING
				checkLocalGroupDecl(c, s.DeclRef)
				c.BorrowPosKind = savedGroupPos
			}
		}
		return
	}

	if s.Kind == ast.STMT_BREAK {
		if !c.InLoop && !c.InSwitch {
			if c.InDefer && (c.DeferOuterLoop || c.DeferOuterSwitch) {
				addCheckError(c, s.Pos, "break may not leave a deferred block")
			} else {
				addCheckError(c, s.Pos, "break outside loop or switch")
			}
		}
		return
	}

	if s.Kind == ast.STMT_CONTINUE {
		if !c.InLoop {
			if c.InDefer && c.DeferOuterLoop {
				addCheckError(c, s.Pos, "continue may not leave a deferred block")
			} else {
				addCheckError(c, s.Pos, "continue outside loop")
			}
		}
		return
	}

	if s.Kind == ast.STMT_DEFER {
		checkDeferStmt(c, s)
		return
	}
	// STMT_EMPTY — nothing to check
}

// checkDeferStmt type-checks a defer statement (§14.13): `defer { … }`, or the
// shorthand `defer <call>` (in X), which stands for a block holding that one
// call.  The deferred code is checked in place, as a block nested in the
// enclosing one, so it sees the names in scope at the defer statement; inside it
// a `return` is rejected, and a `break` / `continue` has a target only in a loop
// or switch inside it (stmt.defer.block).  At the REPL prompt's top level a defer
// has no enclosing block and is rejected.
func checkDeferStmt(c @Checker, s @ast.Stmt) {
	if c.ReplTopScope != nil && same(c.Scope, c.ReplTopScope) {
		addCheckError(c, s.Pos, "defer at the prompt's top level would run at once; write it in a block")
	}
	var savedInLoop bool = c.InLoop
	var savedInSwitch bool = c.InSwitch
	var savedInDefer bool = c.InDefer
	var savedOuterLoop bool = c.DeferOuterLoop
	var savedOuterSwitch bool = c.DeferOuterSwitch
	c.DeferOuterLoop = savedInLoop || savedInDefer && savedOuterLoop
	c.DeferOuterSwitch = savedInSwitch || savedInDefer && savedOuterSwitch
	c.InLoop = false
	c.InSwitch = false
	c.InDefer = true
	if s.Body != nil {
		pushScope(c)
		checkBlockStmt(c, s.Body)
		popScope(c)
	} else {
		checkDeferCall(c, s)
	}
	c.InLoop = savedInLoop
	c.InSwitch = savedInSwitch
	c.InDefer = savedInDefer
	c.DeferOuterLoop = savedOuterLoop
	c.DeferOuterSwitch = savedOuterSwitch
}

// checkDeferCall checks the operand of the shorthand `defer <call>`: it must be a
// call (stmt.defer.call) — a function, method or function-value call, including
// one of the predeclared `panic`; a builtin-operation keyword form (`make(…)`,
// `cast(…)`, …, §15.1) is a special call shape, not a call — and is type-checked
// as an expression statement, its results discarded.
func checkDeferCall(c @Checker, s @ast.Stmt) {
	if s.X == nil || s.X.Kind != ast.EXPR_CALL {
		addCheckError(c, s.Pos, "defer requires a function, method, or "
				"function-value call")
		// Still type-check the operand (if any) so its own errors surface and
		// downstream passes see a resolved type.
		if s.X != nil {
			checkExprRaw(c, s.X)
		}
		return
	}
	checkExprRaw(c, s.X)
}

// checkBlockStmt type-checks all statements in a block.
func checkBlockStmt(c @Checker, s @ast.Stmt) {
	if s == nil {
		return
	}
	for i := 0; i < len(s.Stmts); i++ {
		checkStmt(c, s.Stmts[i])
	}
}

// checkReturnStmt validates return value count and types against the enclosing function signature.
//
// Each return expression is type-checked with the matching return-
// slot type installed as the function-value hint, so a function-
// literal whose signature matches the declared return type resolves
// as the declared flavour (@func or *func) rather than the default
// raw form.  Without the hint, `return func() { ... }` from a
// function returning `@func()` would resolve the literal as
// `*func()` and the assignability check would then fail (or, if
// AssignableTo is permissive, the literal would be allocated on
// the stack rather than the heap — same lifetime bug as
// `func-value-escape` flags for the same shape).  B.3b of plan-
// function-values-phase-2.md.
func checkReturnStmt(c @Checker, s @ast.Stmt) {
	if len(c.FuncRet) == 0 && len(s.Exprs) == 0 {
		return
	}
	if len(s.Exprs) != len(c.FuncRet) {
		// Single-expression return for a multi-return function:
		// `return f(...)` where f returns the matching result tuple
		// (hasExpandableResults), as a multi-value short variable
		// declaration takes it.
		if len(s.Exprs) == 1 && len(c.FuncRet) > 1 {
			var rhsType @types.Type = checkExprRaw(c, s.Exprs[0])
			if rhsType != nil && rhsType.Kind == types.TYP_ERROR { return }
			if hasExpandableResults(rhsType) && len(rhsType.Results) == len(c.FuncRet) {
				for i := 0; i < len(c.FuncRet); i++ {
					if !AssignableTo(rhsType.Results[i], c, c.FuncRet[i]) {
						errCannotAssign(c, s.Exprs[0].Pos, rhsType.Results[i], c.FuncRet[i])
					}
				}
				return
			}
		}
		addCheckError(c, s.Pos, "wrong number of return values")
		return
	}
	for i := 0; i < len(s.Exprs); i++ {
		var rt @types.Type = checkExprWithFVHint(c, s.Exprs[i], c.FuncRet[i])
		if !assignableOrBorrowsIface(c, s.Exprs[i], rt, c.FuncRet[i]) {
			errCannotAssign(c, s.Exprs[i].Pos, rt, c.FuncRet[i])
		}
		checkStoredLiteralAddr(c, s.Exprs[i])
	}
}

// checkForStmt type-checks for loops (C-style and for-in range loops).
func checkForStmt(c @Checker, s @ast.Stmt) {
	pushScope(c)

	if s.ForVal != nil {
		// For-in
		var iterType @types.Type = checkExpr(c, s.X)
		var elemType @types.Type = forInElemType(c, s.X.Pos, iterType)
		if s.ForKey != nil {
			defineVar(c.Scope, s.ForKey.Name, types.TypInt())
			if types.CharEq(s.ForKey.Name, s.ForVal.Name) {
				errRepeatedBinding(c, s.ForVal.Name, s.ForVal.Pos)
			}
		}
		if s.ForVal != nil {
			// Binding the range value MATERIALIZES each element as a value, so an
			// opaque (or cross-package opaque-export) element is rejected here
			// (bug 211).  No-ops on a sized element.
			requireSizedType(c, elemType, s.X.Pos)
			defineVar(c.Scope, s.ForVal.Name, elemType)
		}
	} else {
		if s.Init != nil {
			checkStmt(c, s.Init)
		}
		if s.X != nil {
			var cond @types.Type = checkExpr(c, s.X)
			if !cond.IsBool() && cond.Kind != types.TYP_ERROR {
				addCheckError(c, s.X.Pos, "non-bool condition")
			}
		}
		if s.Post != nil {
			checkStmt(c, s.Post)
		}
	}

	var savedInLoop bool = c.InLoop
	c.InLoop = true
	checkBlockStmt(c, s.Body)
	c.InLoop = savedInLoop
	popScope(c)
}

// forInElemType returns the element type for a for-in range expression
// (slice, managed-slice, or array).
func forInElemType(c @Checker, pos token.Pos, t @types.Type) @types.Type {
	if isErrType(t) {
		return types.TypError()
	}
	// StripWrappers (not ResolveAlias) so a named-distinct slice/array
	// (`type Buf @[]int`) is recognized as iterable: it is TYP_NAMED with its
	// slice/array body on `.Underlying`, which ResolveAlias (TYP_ALIAS only)
	// leaves intact.  Indexing a named slice already works, so for-in must too.
	// A string literal is ranged as its natural type, the array `[N]readonly
	// char` (stmt.for.in), as indexing one is.
	if isUntypedString(t) {
		t = types.UntypedStringNaturalArray(t)
	}
	t = types.StripWrappers(t)
	if t == nil {
		return types.TypVoid()
	}
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_ARRAY {
		return t.Elem
	}
	addCheckError(c, pos, "cannot range over non-iterable type")
	return types.TypError()
}

// errIfRedeclaredLocal reports name, declared at pos by a `var` or `const`
// declaration statement, as redeclared (spec decl.var.redeclare,
// decl.const.redeclare) when the current (function or block) scope already
// defines it — a parameter or an earlier declaration of the block — or when
// earlier is set: an earlier member of the same group declares it.
func errIfRedeclaredLocal(c @Checker, name @[]char, pos token.Pos, earlier bool) {
	if len(name) == 0 || isBlank(name) {
		return
	}
	if !earlier && c.Scope.LookupLocal(name) == nil {
		return
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(name)
	cb.Write(" redeclared in this scope")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// checkLocalGroupRedeclared applies errIfRedeclaredLocal to each member of a
// grouped `var ( … )` or `const ( … )` declaration statement g, whose name
// must also differ from the group's earlier members'.
func checkLocalGroupRedeclared(c @Checker, g @ast.Decl) {
	for i := 0; i < len(g.Decls); i++ {
		var m @ast.Decl = g.Decls[i]
		if m.Kind != ast.DECL_VAR && m.Kind != ast.DECL_CONST {
			continue
		}
		var earlier bool = false
		for j := 0; j < i; j++ {
			if g.Decls[j].Kind == m.Kind && types.CharEq(g.Decls[j].Name, m.Name) {
				earlier = true
			}
		}
		errIfRedeclaredLocal(c, m.Name, m.Pos, earlier)
	}
}

// checkLocalGroupDecl checks the members of a grouped declaration in a function
// body in the current (function or block) scope, as the single local
// declarations are: a var member by checkVarDecl, a const member at its iota
// (checkConstGroupMember).  The package-level pass over a group (checkGroupDecl
// → checkDecls) checks each member under its file's scope instead, which in a
// package with file-scoped imports loses the function's locals.
func checkLocalGroupDecl(c @Checker, g @ast.Decl) {
	for i := 0; i < len(g.Decls); i++ {
		var m @ast.Decl = g.Decls[i]
		if m.Kind == ast.DECL_VAR {
			checkVarDecl(c, m)
		} else if m.Kind == ast.DECL_CONST {
			checkConstGroupMember(c, g, i)
		}
	}
}
