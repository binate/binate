package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Switch checking (check_stmt_switch.bn, §14.10).

func TestCheckSwitchStmt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var x int = 1; switch x { case 1: case 2: } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A tagless switch (the `switch true` form) accepts boolean case expressions.
func TestCheckSwitchTaglessBool() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var n int = 5; switch { case n > 2: } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A tagless switch case must be boolean (stmt.switch.tagless-bool): a non-bool
// `case 3:` is rejected.
func TestCheckSwitchTaglessNonBool() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { switch { case 3: } }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Type switches (checkTypeSwitchStmt).  The tests below reuse assertCheck
// (check_assert_test.bn): an interface I { foo() }, a sub-interface J { foo();
// bar() }, a concrete `type T struct { x int }` with `impl *T : I, J`, and
// operands `rv *I` (raw) / `mv @I` (managed) in scope.
//
// Narrowing is probed with a typed `var <p> <T> = v` assignment, NOT member
// access: member access on an interface value is not strictly checked, but
// assignment IS — an interface `*I` is not assignable to a concrete `*T`
// (interface->concrete needs the runtime recovery), so a clean assignment proves
// the binder was narrowed and a "cannot assign" error proves it was not.

// A binderless type switch over a raw operand with a concrete case + default.
func TestTypeSwitchBinderlessOk() testing.TestResult {
	return expectNoErrors(assertCheck("switch rv.(type) { case *T: default: }"))
}

// A single-target case narrows the binder to the recovered concrete pointer:
// `v` is `*T`, so `var p *T = v` is clean.
func TestTypeSwitchBinderNarrowsConcrete() testing.TestResult {
	return expectNoErrors(
			assertCheck("switch v := rv.(type) { case *T: var p *T = v; _ = p }"))
}

// An interface target narrows the binder to the recovered interface value: `v`
// is `*J`, so `var q *J = v` is clean.
func TestTypeSwitchBinderNarrowsInterface() testing.TestResult {
	return expectNoErrors(
			assertCheck("switch v := rv.(type) { case *J: var q *J = v; _ = q }"))
}

// `@T` recovery from a managed operand `@I` narrows `v` to `@T`.
func TestTypeSwitchManagedTargetOk() testing.TestResult {
	return expectNoErrors(
			assertCheck("switch v := mv.(type) { case @T: var p @T = v; _ = p }"))
}

// A multi-target case binds the SCRUTINEE type, not a single recovered type: `v`
// is `*I`, which is NOT assignable to a concrete `*T`.
func TestTypeSwitchMultiTargetBindsScrutinee() testing.TestResult {
	return expectErrSub(
			assertCheck("switch v := rv.(type) { case *T, *J: var p *T = v; _ = p }"), "cannot assign")
}

// A default case likewise binds the scrutinee's own interface-value type.
func TestTypeSwitchDefaultBindsScrutinee() testing.TestResult {
	return expectErrSub(
			assertCheck("switch v := rv.(type) { default: var p *T = v; _ = p }"), "cannot assign")
}

// `break` is legal inside a type-switch case (c.InSwitch is set).
func TestTypeSwitchBreakOk() testing.TestResult {
	return expectNoErrors(assertCheck("switch rv.(type) { case *T: break }"))
}

// `@T` recovery from a raw operand `*I` is rejected — a raw interface value has
// no reference to share (per-case, via assertTargetType).
func TestTypeSwitchManagedFromRawRejected() testing.TestResult {
	return expectErrSub(assertCheck("switch v := rv.(type) { case @T: _ = v }"),
			"cannot recover @T from a raw interface value")
}

// Value recovery of a STRUCT `case T:` (no `*`/`@`) IS supported per-case — a
// borrow load; the binder store copy-acquires the struct's managed fields.
func TestTypeSwitchValueRecoveryStructAccepted() testing.TestResult {
	return expectNoErrors(assertCheck("switch v := rv.(type) { case T: _ = v }"))
}

// Value recovery of a SCALAR `case int:` (no `*`/`@`) IS supported per-case — a
// plain load, no error.
func TestTypeSwitchValueRecoveryScalar() testing.TestResult {
	return expectNoErrors(assertCheck("switch v := rv.(type) { case int: _ = v }"))
}

// The scrutinee must be an interface value; a non-interface operand is rejected.
func TestTypeSwitchNonInterfaceScrutinee() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g(n int) { switch n.(type) { default: } }\n")
	return expectErrSub(c, "type switch operand must be an interface value")
}

// A binderless switch still validates its case targets (surfacing a bad target
// even when nothing is bound).
func TestTypeSwitchBinderlessValidatesTargets() testing.TestResult {
	return expectErrSub(assertCheck("switch rv.(type) { case @T: }"),
			"cannot recover @T from a raw interface value")
}

// A switch has at most one default clause (stmt.switch.default.single): a second
// is rejected, in an expression switch (tagged or tagless) and in a type switch;
// one default is fine.
func TestCheckSwitchSingleDefault() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 3)
	srcs[0] = "package \"test\"\nfunc f(x int) { switch x { case 1: default: default: } }\n"
	srcs[1] = "package \"test\"\nfunc f() { switch { default: case true: default: } }\n"
	srcs[2] = "package \"test\"\ninterface I { foo() }\n"
			"func f(x *I) { switch x.(type) { default: case *I: default: } }\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if len(c.CheckerErrors()) != 1 || !anyErrContains(c, "multiple defaults in switch") {
			return fail(buf.CopyStr(srcs[i]))
		}
	}
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface I { foo() }\n"
							"func f(x int, y *I) { switch x { default: }; switch y.(type) { case *I: default: } }\n"))
}

// An untyped constant tag takes its default type (const.default), as `x := tag`
// would, and the cases match it: an int case of `switch 5` and of a constant
// name's tag, a bool case of `switch true` and a float64 case of `switch 1.5`,
// each beside an untyped case.
func TestCheckSwitchConstTagDefaultType() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "func f() { var x int = 5; switch 5 { case x: case 6: } }\n"
	srcs[1] = "const K = 5\nfunc f() { var x int = 5; switch K { case x: case 6: } }\n"
	srcs[2] = "func f() { var b bool = true; switch true { case b: case false: } }\n"
	srcs[3] = "func f() { var g float64 = 1.5; switch 1.5 { case g: case 2.5: } }\n"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat("package \"test\"\n", srcs[i])))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A case of a type other than the default one is still a mismatch: an int8 or a
// uint case of `switch 5`, a float32 case of `switch 1.5`.
func TestCheckSwitchConstTagOtherTypeRejected() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 3)
	var msgs @[]*[]readonly char = make_slice(*[]readonly char, 3)
	srcs[0] = "func f() { var x int8 = 5; switch 5 { case x: } }\n"
	msgs[0] = "mismatched types int8 and int"
	srcs[1] = "func f() { var u uint = 5; switch 5 { case u: } }\n"
	msgs[1] = "mismatched types uint and int"
	srcs[2] = "func f() { var g float32 = 1.5; switch 1.5 { case g: } }\n"
	msgs[2] = "mismatched types float32 and float64"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectOneErr(checkSrc(buf.Concat("package \"test\"\n", srcs[i])),
				msgs[i])
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A constant tag whose value does not fit `int` is rejected as `x := tag` is
// (const.default.int-width), rather than taking a case its value wraps to:
// 2^64-1 on a 64-bit target, 3000000000 on a 32-bit one (which a 64-bit one's
// `int` holds).
func TestCheckSwitchConstTagMustFitInt() testing.TestResult {
	var r testing.TestResult = expectOneErr(
			checkSrcLP64("package \"test\"\nfunc f() { switch 0xFFFFFFFFFFFFFFFF { case -1: } }\n"),
			"cannot assign untyped int to int")
	if len(r) != 0 { return buf.Concat("2^64-1: ", r) }
	var big *[]readonly char = "package \"test\"\nfunc f() { switch 3000000000 { case 1: } }\n"
	r = expectOneErr(checkSrcILP32(big), "cannot assign untyped int to int")
	if len(r) != 0 { return buf.Concat("3000000000 on 32-bit: ", r) }
	r = expectNoErrors(checkSrcLP64(big))
	if len(r) != 0 { return buf.Concat("3000000000 on 64-bit: ", r) }
	return ""
}

// A nil tag is rejected: nil has no default type.
func TestCheckSwitchNilTagRejected() testing.TestResult {
	return expectOneErr(checkSrc("package \"test\"\nfunc f() { switch nil { default: } }\n"),
			"cannot infer a type from nil")
}

// An integer constant case that the tag's type cannot hold is reported as
// assigning it would be.
func TestCheckSwitchCaseConstMustFitTag() testing.TestResult {
	return expectOneErr(
			checkSrc("package \"test\"\nfunc f() { var t int8 = 5; switch t { case 300: } }\n"),
			"cannot assign untyped int to int8")
}
