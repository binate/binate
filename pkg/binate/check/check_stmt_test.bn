package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

func TestCheckIfStmt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { if true { var x int = 1 } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckIfNonBoolCond() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { if 42 { } }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckForLoop() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { for i := 0; i < 10; i++ { } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A multi-return function-VALUE call `return fv()` destructures across the
// enclosing function's results (checkReturnStmt via hasExpandableResults).  The
// short-var / assign siblings live in check_assign_test.bn.
func TestCheckFuncValueMultiReturnReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func mr() (int, int) { return 1, 2 }\n"
			"func g(fv @func() (int, int)) (int, int) { return fv() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckIncDec() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var x int = 0; x++ }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckIncDecNonInt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var x bool = true; x++ }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

