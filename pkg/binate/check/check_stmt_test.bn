	var src *[]readonly char = "package \"test\"\nfunc f() { return }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckMultipleReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() (int, bool) { return 1, true }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckReturnCountMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() (int, bool) { return 1 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckReturnCallMultiOK() testing.TestResult {
	// `return f()` is accepted when f's results match the outer
	// function's declared results.
	var src *[]readonly char = "package \"test\"\n"
			"func f() (int, bool) { return 1, true }\n"
			"func g() (int, bool) { return f() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckReturnCallMultiArityMismatch() testing.TestResult {
	// `return f()` rejected if f's arity doesn't match outer's.
	var src *[]readonly char = "package \"test\"\n"
			"func f() (int, bool, int) { return 1, true, 0 }\n"
			"func g() (int, bool) { return f() }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckReturnCallMultiTypeMismatch() testing.TestResult {
	// `return f()` rejected if a per-result type isn't assignable.
	var src *[]readonly char = "package \"test\"\n"
			"func f() (int, bool) { return 1, true }\n"
			"func g() (int, int) { return f() }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckBreakContinue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { for i := 0; i < 10; i++ { break; continue } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A string literal is a range operand of its natural type `[N]readonly char`
// (stmt.for.in): accepted, and its element is a `readonly char`, so the value
// variable cannot be assigned.
func TestCheckForInStringLiteral() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() int {\n\tvar n int = 0\n"
					"\tfor i, ch in \"hi\" {\n\t\tn = n + i + cast(int, ch)\n\t}\n\treturn n\n}\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrc("package \"test\"\nfunc f() {\n\tfor ch in \"hi\" {\n\t\tch = 120\n\t}\n}\n")
	return expectErrSub(c, "cannot assign to const-typed location")
}

// `x++` is `x += 1`: a non-addressable operand — a field of a by-value call
// result, of an unsafe_index of an array call result — is rejected like the
// compound assignment, while an addressable one (a variable's field, a slice
// element's field, an unsafe_index of an addressable array) passes.
func TestCheckIncDecRequiresAddressable() testing.TestResult {
	var bad @[]@[]char = @[]@[]char{
			"package \"test\"\ntype S struct { x int }\nfunc getS() S { var s S; return s }\n"
		"func f() { getS().x++ }\n",
			"package \"test\"\ntype S struct { x int }\nfunc getA() [3]S { var a [3]S; return a }\n"
		"func f() { unsafe_index(getA(), 2).x-- }\n"}
	for i := 0; i < len(bad); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(bad[i]), "non-addressable")
		if len(r) > 0 { return r }
	}
	// One mistake, one error: an operand already reported (a readonly field)
	// is not also reported as non-addressable.
	var ro @Checker = checkSrc(
			"package \"test\"\ntype S struct { r readonly int }\n"
					"func getS() S { var s S; return s }\nfunc f() { getS().r++ }\n")
	if len(ro.Errors) != 1 { return "an already-reported inc/dec operand must get exactly one error" }
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ntype S struct { x int }\n"
							"func f(s S, xs @[]S, a [3]S) { s.x++; xs[1].x--; var p *S = &s; p.x++; "
							"unsafe_index(a, 2).x--; unsafe_index(xs, 0).x++ }\n"))
}

// An unsafe_index of an array is addressable only if the array is: of an array
// call result it is a temporary, so its address, a pointer method on it and a
// compound assignment to it are rejected, as for `getA()[1]`.
func TestCheckUnsafeIndexOfTemporaryArray() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\ntype P struct { x int }\nfunc (p *P) M() {}\n"
			"func getA() [3]int { var a [3]int; return a }\n"
			"func getP() [2]P { var a [2]P; return a }\n"
	var bad @[]@[]char = @[]@[]char{
			buf.Concat(decls, "func f() { var q *int = &unsafe_index(getA(), 1); _ = q }\n"),
			buf.Concat(decls, "func f() { unsafe_index(getP(), 1).M() }\n"),
			buf.Concat(decls, "func f() { unsafe_index(getA(), 1) += 2 }\n")}
	for i := 0; i < len(bad); i++ {
		var c @Checker = checkSrc(bad[i])
		if len(c.Errors) == 0 { return buf.Concat("expected an error for: ", bad[i]) }
	}
	return ""
}
