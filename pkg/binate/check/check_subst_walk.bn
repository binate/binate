package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/vec"

// The type substitutions -- a generic's type arguments for its type parameters
// (substituteTypeParams), an implementing type for `Self` (substituteSelf) -- rebuild a
// type from its substituted parts, taking the parts from a work list rather than
// recursing on them, so a type nested to any depth is substituted.  A type is rebuilt
// once all its parts are, which are substituted in order: an instance whose type
// arguments change is instantiated for the new ones, which can substitute in turn, so
// the work lists are kept from one substitution to the next, each starting at its base
// and leaving them as it found them.

// A substSpec is what a substitution puts in place of what: the type arguments args for
// the type parameters, or (self) recv for `Self`.
type substSpec struct {
	self bool
	args @[]@types.Type
	recv @types.Type
}

// A substFrame is a type a substitution is rebuilding: t, how many of its parts are
// substituted (next), where their results start on substResults (base), and, for an
// instance whose type parameters are substituted, the by-value depth to restore once
// it is built (saved).
type substFrame struct {
	t     @types.Type
	next  int
	base  int
	saved int
}

// substFrames holds the types being rebuilt, innermost last.
var substFrames @vec.Vec[substFrame]

// substResults holds the substituted parts of the types on substFrames, in order, and a
// finished substitution's result.
var substResults @vec.Vec[@types.Type]

// substitute returns t with s's substitution made in it.  A type whose parts all
// substitute without rebuilding -- the common case, `*T` or `func(T) bool` -- is
// substituted with no work list (substShallow).
func substitute(c @Checker, t @types.Type, s *substSpec) @types.Type {
	leaf, r := substLeaf(t, s)
	if leaf { return r }
	shallow, sr := substShallow(c, t, s)
	if shallow { return sr }
	if substFrames == nil {
		substFrames = vec.New[substFrame]()
		substResults = vec.New[@types.Type]()
	}
	var frameBase int = substFrames.Len()
	openSubstFrame(c, t, s)
	for substFrames.Len() > frameBase {
		var top int = substFrames.Len() - 1
		var f substFrame = substFrames.Get(top)
		if f.next < substPartCount(f.t) {
			var part @types.Type = substPart(f.t, f.next)
			f.next = f.next + 1
			substFrames.Set(top, f)
			partLeaf, pr := substLeaf(part, s)
			if !partLeaf { partLeaf, pr = substShallow(c, part, s) }
			if partLeaf {
				substResults.Push(pr)
			} else {
				openSubstFrame(c, part, s)
			}
		} else {
			_, _ = substFrames.Pop()
			substResults.Push(buildSubst(c, f, s))
		}
	}
	var out @types.Type
	out, _ = substResults.Pop()
	return out
}

// substLeaf reports whether t is substituted without rebuilding it, and returns what it
// becomes then: nil stays nil, a type parameter becomes its argument (when it has one)
// and `Self` the implementing type; a type that is neither an instance nor a composite
// -- a named or basic type, a type parameter the substitution has no argument for --
// stays as it is.
func substLeaf(t @types.Type, s *substSpec) (bool, @types.Type) {
	if t == nil { return true, t }
	if s.self {
		if t.Kind == types.TYP_SELF { return true, s.recv }
	} else if t.Kind == types.TYP_TYPE_PARAM {
		if t.TpIndex >= 0 && t.TpIndex < len(s.args) { return true, s.args[t.TpIndex] }
		return true, t
	}
	return !substRebuilds(t), t
}

// substRebuilds reports whether a substitution rebuilds t from its parts: an instance
// (from its type arguments), an anonymous struct (its fields), a function type or
// function value type (its parameters and results), or a type over an element.
func substRebuilds(t @types.Type) bool {
	if t.InstDecl != nil { return true }
	var k int = t.Kind
	return k == types.TYP_READONLY || k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_ARRAY ||
			k == types.TYP_INTERFACE_VALUE || k == types.TYP_INTERFACE_VALUE_MANAGED ||
			(k == types.TYP_STRUCT && len(t.Name) == 0) || isFuncKind(k)
}

// isFuncKind reports whether k is a function type's kind or a function value type's.
func isFuncKind(k int) bool {
	return k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE
}

// substPartCount returns how many parts a type substRebuilds rebuilds t from.
func substPartCount(t @types.Type) int {
	if t.InstDecl != nil { return len(t.InstArgs) }
	if t.Kind == types.TYP_STRUCT { return len(t.Fields) }
	if isFuncKind(t.Kind) { return len(t.Params) + len(t.Results) }
	return 1
}

// substPart returns t's i-th part: an instance's type argument, a field's type, a
// parameter's type and then a result type, or the element.
func substPart(t @types.Type, i int) @types.Type {
	if t.InstDecl != nil { return t.InstArgs[i] }
	if t.Kind == types.TYP_STRUCT { return t.Fields[i].Type }
	if isFuncKind(t.Kind) {
		if i < len(t.Params) { return t.Params[i].Type }
		return t.Results[i - len(t.Params)]
	}
	return t.Elem
}

// openSubstFrame puts t on substFrames to be rebuilt; an instance whose type
// parameters are substituted is built where it is made, never postponed (enterByValue,
// check_generic_postpone.bn): it may be a type argument another instance holds by
// value, and substitution does not track which.
func openSubstFrame(c @Checker, t @types.Type, s *substSpec) {
	var f substFrame
	f.t = t
	f.base = substResults.Len()
	if !s.self && t.InstDecl != nil { f.saved = substByValue(c) }
	substFrames.Push(f)
}

// takeSubstResults takes the results on substResults from base up off it, in order.
func takeSubstResults(base int) @[]@types.Type {
	var out @[]@types.Type = make_slice(@types.Type, substResults.Len() - base)
	for i := len(out) - 1; i >= 0; i-- {
		var r @types.Type
		r, _ = substResults.Pop()
		out[i] = r
	}
	return out
}

// substShallow substitutes in t, a type substRebuilds, when each of its parts
// substitutes without rebuilding (substLeaf), with no work list, and reports whether it
// did; an instance's by-value bracket (openSubstFrame) is kept around it.
func substShallow(c @Checker, t @types.Type, s *substSpec) (bool, @types.Type) {
	if substOverElem(t) {
		leaf, elem := substLeaf(t.Elem, s)
		if !leaf { return false, t }
		return true, buildSubstElem(t, elem, s)
	}
	var n int = substPartCount(t)
	for i := 0; i < n; i++ {
		leaf, _ := substLeaf(substPart(t, i), s)
		if !leaf { return false, t }
	}
	var f substFrame
	f.t = t
	if !s.self && t.InstDecl != nil { f.saved = substByValue(c) }
	var parts @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		_, p := substLeaf(substPart(t, i), s)
		parts[i] = p
	}
	return true, buildSubstParts(c, f, parts, s)
}

// substOverElem reports whether t, a type substRebuilds, is one over a single element
// (not an instance, a struct or a function type).
func substOverElem(t @types.Type) bool {
	return t.InstDecl == nil && t.Kind != types.TYP_STRUCT && !isFuncKind(t.Kind)
}

// buildSubst returns the type f.t rebuilt from its substituted parts, which it takes off
// substResults.
func buildSubst(c @Checker, f substFrame, s *substSpec) @types.Type {
	if substOverElem(f.t) {
		var elem @types.Type
		elem, _ = substResults.Pop()
		return buildSubstElem(f.t, elem, s)
	}
	return buildSubstParts(c, f, takeSubstResults(f.base), s)
}

// buildSubstElem returns t, a type over an element, rebuilt over its substituted
// element elem.  Substituting type parameters rebuilds every composite; substituting
// `Self` keeps a type whose parts are all unchanged, so its identity is kept.
func buildSubstElem(t @types.Type, elem @types.Type, s *substSpec) @types.Type {
	if s.self && elem == t.Elem { return t }
	return buildSubstOver(t, elem)
}

// buildSubstParts returns f.t, an instance, struct or function type, rebuilt from its
// substituted parts, as buildSubstElem does a type over an element.
func buildSubstParts(c @Checker, f substFrame, parts @[]@types.Type, s *substSpec) @types.Type {
	var t @types.Type = f.t
	if t.InstDecl != nil { return buildSubstInstance(c, f, parts, s) }
	if s.self {
		var changed bool = false
		for i := 0; i < len(parts); i++ {
			if parts[i] != substPart(t, i) { changed = true }
		}
		if !changed { return t }
	}
	if t.Kind == types.TYP_STRUCT { return buildSubstStruct(t, parts) }
	return buildSubstFunc(t, parts)
}

// buildSubstOver returns a type of t's kind -- one over an element (substRebuilds) --
// over elem.
func buildSubstOver(t @types.Type, elem @types.Type) @types.Type {
	var k int = t.Kind
	if k == types.TYP_READONLY { return types.MakeReadonlyType(elem) }
	if k == types.TYP_POINTER { return types.MakePointerType(elem) }
	if k == types.TYP_MANAGED_PTR { return types.MakeManagedPtrType(elem) }
	if k == types.TYP_SLICE { return types.MakeSliceType(elem) }
	if k == types.TYP_MANAGED_SLICE { return types.MakeManagedSliceType(elem) }
	if k == types.TYP_ARRAY {
		// A length that depends on a type parameter stays dependent: its value is known
		// only where the array type is resolved for an instantiation, and the
		// implementing method's array, which is dependent too, is identical to it only
		// so.
		var at @types.Type = types.MakeArrayType(elem, t.ArrayLen)
		at.ArrayLenDependent = t.ArrayLenDependent
		return at
	}
	if k == types.TYP_INTERFACE_VALUE { return types.MakeInterfaceValueType(elem) }
	return types.MakeManagedInterfaceValueType(elem)
}

// buildSubstInstance returns the instance f.t for its substituted type arguments args:
// f.t itself when they are unchanged (identical ones, for type parameters; the same
// ones, for `Self`), else the generic instantiated for them through the shared cache,
// so it is the same @types.Type a direct mention produces.  The instantiation is not
// user-facing: it builds the type's identity but reports no constraint miss (which
// would blame the generic's declaration); a real miss is reported at the site the user
// wrote that drove the substitution.
func buildSubstInstance(c @Checker, f substFrame, args @[]@types.Type, s *substSpec) @types.Type {
	var t @types.Type = f.t
	var changed bool = false
	for i := 0; i < len(args); i++ {
		if s.self {
			if args[i] != t.InstArgs[i] { changed = true }
		} else if !args[i].Identical(t.InstArgs[i]) {
			changed = true
		}
	}
	if !changed {
		if !s.self && c != nil { leaveByValue(c, f.saved) }
		return t
	}
	var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
	var inst @types.Type = instantiateGenericDeclWithArgs(c, d, t.Kind == types.TYP_INTERFACE, args,
			d.Pos, false)
	if !s.self && c != nil { leaveByValue(c, f.saved) }
	return inst
}

// buildSubstStruct returns an anonymous struct of t's field names over the substituted
// field types.
func buildSubstStruct(t @types.Type, fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field
	if len(fieldTypes) > 0 { fields = make_slice(@types.Field, len(fieldTypes)) }
	for i := 0; i < len(fieldTypes); i++ {
		var f @types.Field = make(types.Field)
		f.Name = t.Fields[i].Name
		f.Type = fieldTypes[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// buildSubstFunc returns a function type or function value type of t's kind, its
// parameters' names and variadic-ness, over the substituted parameter and result types
// (parts, the parameters' first).
func buildSubstFunc(t @types.Type, parts @[]@types.Type) @types.Type {
	var params @[]@types.Param
	if len(t.Params) > 0 { params = make_slice(@types.Param, len(t.Params)) }
	for i := 0; i < len(t.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = t.Params[i].Name
		p.Type = parts[i]
		p.IsVariadic = t.Params[i].IsVariadic
		params[i] = p
	}
	var results @[]@types.Type
	if len(t.Results) > 0 { results = make_slice(@types.Type, len(t.Results)) }
	for i := 0; i < len(t.Results); i++ {
		results[i] = parts[len(t.Params) + i]
	}
	if t.Kind == types.TYP_FUNC_VALUE { return types.MakeFuncValueType(params, results) }
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return types.MakeManagedFuncValueType(params, results)
	}
	return types.MakeFuncType(params, results)
}
