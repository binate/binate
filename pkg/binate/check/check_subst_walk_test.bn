package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_subst_walk.bn: the substitutions rebuild a type nested deepLevels
// deep, far deeper than a walk with one stack frame per level could go.

// arrayChain returns n array types of length 1 over leaf: [1][1]...leaf.
func arrayChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		t = types.MakeArrayType(t, 1)
	}
	return t
}

// A type parameter at the bottom of arrays nested deepLevels deep is substituted, and
// the arrays rebuilt over its argument.
func TestDeepSubstituteTypeParams() testing.TestResult {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	var t @types.Type = arrayChain(deepLevels, mkTpZero())
	var r @types.Type = substituteTypeParams(nil, t, args)
	var bottom @types.Type = innermost(r, deepLevels)
	var ok bool = r != t && bottom.Kind == types.TYP_ARRAY && bottom.ArrayLen == 1 &&
			bottom.Elem == types.TypInt()
	bottom = nil
	dropLinks(&t, deepLevels)
	dropLinks(&r, deepLevels)
	if !ok { return fail("deep arrays over T are rebuilt over int") }
	return ""
}

// `Self` at the bottom of arrays nested deepLevels deep is substituted, and arrays
// nested as deep with no `Self` in them are kept as they are.
func TestDeepSubstituteSelf() testing.TestResult {
	var recv @types.Type = types.MakeNamedType("Point")
	var t @types.Type = arrayChain(deepLevels, types.TypSelf())
	var r @types.Type = substituteSelf(nil, t, recv)
	var u @types.Type = arrayChain(deepLevels, types.TypInt())
	var kept bool = substituteSelf(nil, u, recv) == u
	var bottom @types.Type = innermost(r, deepLevels)
	var ok bool = r != t && bottom.Elem == recv
	bottom = nil
	dropLinks(&t, deepLevels)
	dropLinks(&r, deepLevels)
	dropLinks(&u, deepLevels)
	if !ok { return fail("deep arrays over Self are rebuilt over the receiver") }
	if !kept { return fail("deep arrays with no Self are kept") }
	return ""
}
