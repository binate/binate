package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for the control-flow termination analysis in check_terminates.bn
// (stmtTerminates & friends), exercised via checkFuncDecl's missing-return rule.
// Shared checkSrc/expectError helpers live in check_decl_func_test.bn.

// Void function with no return is fine (no check applies).
func TestMissingReturnVoidOk() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Missing return at end of non-void function is an error.
func TestMissingReturnFallthrough() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { var x int = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if without else cannot terminate — fall-through possible.
func TestMissingReturnIfNoElse() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int { if x > 0 { return 1 } }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where only one branch returns is an error.
func TestMissingReturnIfElsePartial() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  if x > 0 { return 1 } else { var y int = 2 }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where both branches return terminates.
func TestTerminatesIfElseBothReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  if x > 0 { return 1 } else { return -1 }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with no break terminates.
func TestTerminatesForNoBreak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int { for { var x int = 1 } }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with a top-level break does NOT terminate.
func TestMissingReturnForWithBreak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int { for { break } }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// for with a condition does NOT terminate (the cond may be false).
func TestMissingReturnForWithCond() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int {\n"
			"  for i := 0; i < 10; i++ { }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch with default + all cases terminating = terminates.
func TestTerminatesSwitchWithDefault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  switch x {\n"
			"  case 1: return 10\n"
			"  default: return 0\n"
			"  }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Switch with no default does NOT terminate.
func TestMissingReturnSwitchNoDefault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  switch x {\n"
			"  case 1: return 10\n"
			"  case 2: return 20\n"
			"  }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch where one case doesn't return does NOT terminate.
func TestMissingReturnSwitchCaseNoReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  switch x {\n"
			"  case 1: return 10\n"
			"  default: var y int = 0\n"
			"  }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch case containing a top-level `break` does NOT terminate
// (break escapes the switch without returning).
func TestMissingReturnSwitchCaseBreak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  switch x {\n"
			"  case 1: break\n"
			"  default: return 0\n"
			"  }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Nested: a `break` inside a nested for should not disqualify the
// outer for { } as terminating.
func TestTerminatesNestedBreakIgnored() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int {\n"
			"  for {\n"
			"    for i := 0; i < 3; i++ { break }\n"
			"  }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic(...) as the final statement is a terminator. Non-void
// functions need not have an explicit return after a panic.
func TestTerminatesPanic() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { panic(\"nope\") }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in the fall-through position after a conditional return.
func TestTerminatesIfReturnElsePanic() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  if x > 0 { return x }\n"
			"  panic(\"nope\")\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in both branches of an if/else.
func TestTerminatesIfElseBothPanic() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(x int) int {\n"
			"  if x > 0 { panic(\"a\") } else { panic(\"b\") }\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A call through a binding that shadows `panic` — a local, a parameter, a
// package-level function — or through a function value holding it returns like
// any call, so it does not end a function with a result (stmt.terminating).
func TestShadowedPanicDoesNotTerminate() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "package \"test\"\nfunc say(s *[]readonly char) { }\n"
			"func f() int { panic := say\n panic(\"x\") }\n"
	srcs[1] = "package \"test\"\nfunc f(panic @func(*[]readonly char)) int { panic(\"x\") }\n"
	srcs[2] = "package \"test\"\nfunc panic(s *[]readonly char) { }\nfunc f() int { panic(\"x\") }\n"
	srcs[3] = "package \"test\"\nvar p = panic\nfunc f() int { p(\"x\") }\n"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(srcs[i]), "missing return")
		if len(r) > 0 { return r }
	}
	return ""
}

// Regular function calls that look like panic but aren't are not
// terminators. A return is still required.
func TestNonPanicExprDoesNotTerminate() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g() { }\n"
			"func f() int { g() }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A switch case whose only break belongs to a nested loop still terminates: the
// loop consumes it.
func TestMissingReturnSwitchLoopBreakOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(x int) int {\n"
					"  switch x {\n"
					"  case 1:\n"
					"    for i := 0; i < 3; i++ { break }\n"
					"    return 1\n"
					"  default:\n"
					"    return 2\n"
					"  }\n"
					"}\n")
	return expectNoErrors(c)
}

// A C-style for with init and post statements but no condition terminates like
// `for { }` (stmt.terminating: a for with no condition and no break targeting
// it); with a break it does not.
func TestTerminatesForInitPostNoCond() testing.TestResult {
	var r testing.TestResult = expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"func f() int { for i := 0; ; i++ { if i == 3 { return i } } }\n"))
	if len(r) > 0 { return r }
	return expectError(
			checkSrc("package \"test\"\nfunc f() int { for i := 0; ; i++ { if i == 3 { break } } }\n"))
}
