package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"

// IsTestFunc reports whether top-level declaration d — already type-checked by
// c — is a test function for the `--test` runners.  The result type is matched
// through the signature the checker resolved for d (d.ResolvedTypeID), not by
// how the source spells it, so `testing.TestResult`, `sys.TestResult`, an
// aliased import of either, and a local alias all qualify, while a same-named
// type declared in some other package does not.
func (c @Checker) IsTestFunc(d @ast.Decl) bool {
	if d == nil || d.Kind != ast.DECL_FUNC || d.Recv != nil || d.Body == nil {
		return false
	}
	if !hasTestPrefix(d.Name) || len(d.Params) != 0 {
		return false
	}
	var ft @types.Type = c.ExprType(d.ResolvedTypeID)
	if ft == nil || ft.Kind != types.TYP_FUNC || len(ft.Results) != 1 {
		return false
	}
	return IsTestResultType(ft.Results[0])
}

// IsTestResultType reports whether t is — directly or through type aliases —
// the distinct named type pkg/builtins/testing/sys.TestResult.  A distinct
// named non-struct type records its declaring package's full path in Pkg.
func IsTestResultType(t @types.Type) bool {
	for t != nil && t.Kind == types.TYP_ALIAS {
		t = t.Target
	}
	if t == nil || t.Kind != types.TYP_NAMED {
		return false
	}
	return types.CharEq(t.Name, "TestResult") && types.CharEq(t.Pkg, "pkg/builtins/testing/sys")
}

// hasTestPrefix reports whether name starts with "Test".
func hasTestPrefix(name *[]readonly char) bool {
	var p *[]readonly char = "Test"
	if len(name) < len(p) {
		return false
	}
	for i := 0; i < len(p); i++ {
		if name[i] != p[i] {
			return false
		}
	}
	return true
}
