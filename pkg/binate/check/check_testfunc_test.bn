package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// testFuncSysBni is the interface of the canonical test-result package.
func testFuncSysBni() *[]readonly char {
	return "package \"pkg/builtins/testing/sys\"\ntype TestResult @[]char\n"
}

// checkTestFuncSrc checks mainSrc against the pkg/builtins/testing/sys interface
// and returns the checker and the parsed main file.
func checkTestFuncSrc(mainSrc *[]readonly char) (@Checker, @ast.File) {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/builtins/testing/sys", mkBniFile(testFuncSysBni()))
	var p @parser.Parser = parser.New(toBytes(mainSrc), "test.bn")
	var file @ast.File = p.ParseFile()
	c.Check(file)
	return c, file
}

// testFuncDecl returns the top-level function (not method) named name in file.
func testFuncDecl(file @ast.File, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_FUNC && d.Recv == nil && types.CharEq(d.Name, name) { return d }
	}
	return nil
}

// A test is recognized by its resolved result type however it is spelled: the
// qualified name or a local type alias of it ...
func TestIsTestFuncAcceptsQualifiedAndLocalAlias() testing.TestResult {
	var c @Checker
	var f @ast.File
	c, f = checkTestFuncSrc(
			"package \"main\"\n"
					"import \"pkg/builtins/testing/sys\"\n"
					"type R = sys.TestResult\n"
					"func TestQualified() sys.TestResult { return \"\" }\n"
					"func TestLocalAlias() R { return \"\" }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !c.IsTestFunc(testFuncDecl(f, "TestQualified")) { return "qualified sys.TestResult" }
	if !c.IsTestFunc(testFuncDecl(f, "TestLocalAlias")) { return "local alias of sys.TestResult" }
	return ""
}

// ... or through an import under a different name.
func TestIsTestFuncAcceptsAliasedImport() testing.TestResult {
	var c @Checker
	var f @ast.File
	c, f = checkTestFuncSrc(
			"package \"main\"\n"
					"import tr \"pkg/builtins/testing/sys\"\n"
					"func TestAliasedImport() tr.TestResult { return \"\" }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !c.IsTestFunc(testFuncDecl(f, "TestAliasedImport")) { return "aliased import tr.TestResult" }
	return ""
}

// Not tests: a same-named type declared in another package, a plain @[]char
// result, a parameter, a non-Test name, and a method.
func TestIsTestFuncRejectsNonTests() testing.TestResult {
	var c @Checker
	var f @ast.File
	c, f = checkTestFuncSrc(
			"package \"main\"\n"
					"import \"pkg/builtins/testing/sys\"\n"
					"type TestResult @[]char\n"
					"type P struct { x int }\n"
					"func TestImpostor() TestResult { return \"\" }\n"
					"func TestChars() @[]char { return \"\" }\n"
					"func TestParam(n int) sys.TestResult { return \"\" }\n"
					"func helper() sys.TestResult { return \"\" }\n"
					"func (p *P) TestMethod() sys.TestResult { return \"\" }\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if c.IsTestFunc(testFuncDecl(f, "TestImpostor")) {
		return "a same-named type from another package"
	}
	if c.IsTestFunc(testFuncDecl(f, "TestChars")) { return "a plain @[]char result" }
	if c.IsTestFunc(testFuncDecl(f, "TestParam")) { return "a function with a parameter" }
	if c.IsTestFunc(testFuncDecl(f, "helper")) { return "a non-Test name" }
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if d.Recv != nil && c.IsTestFunc(d) { return "a method" }
	}
	return ""
}

// IsTestResultType sees through aliases but not past the named type itself.
func TestIsTestResultTypeDirect() testing.TestResult {
	if IsTestResultType(nil) { return "nil" }
	if IsTestResultType(types.MakeManagedSliceType(types.TypChar())) { return "@[]char" }
	return ""
}
