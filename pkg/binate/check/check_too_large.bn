package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// Types too large for the target: a type's size may not exceed the maximum of the
// target's int (spec type.layout.max-size).  types lays out a type in int64 and
// reports one past the limit (SizeIfFits); the checker rejects it where a type is
// required — after collection, when every forward-declared type is complete — so
// none reaches layout in a backend, which treats one as an internal error.  A type
// whose layout depends on a type parameter is judged in each instance's check, with
// the type arguments bound (a generic body lays a type parameter out at a pointer's
// size).

// errTooLarge reports a type too large for the target at pos.
func errTooLarge(c @Checker, pos token.Pos) {
	addCheckError(c, pos, "type is too large (its size exceeds the target's maximum object size)")
}

// requireFitting reports errTooLarge at pos when t, or a type it spells out inline
// (requireFittingParts), is too large for the target, and whether neither is.  A check
// that meets a type not collected yet is made again once it is
// (check_opaque_recheck.bn).
func requireFitting(c @Checker, t @types.Type, pos token.Pos) bool {
	var met int = pendingTypesMet(c)
	var fits bool = requireFittingType(c, t, pos) && requireFittingParts(c, t, pos)
	_ = deferIfPending(c, met, deferredCheck(deferFitting, t, pos))
	return fits
}

// requireFittingType reports errTooLarge at pos when t's size exceeds the target's
// limit, and whether t fits.
func requireFittingType(c @Checker, t @types.Type, pos token.Pos) bool {
	if fitsTarget(c, t) { return true }
	errTooLarge(c, pos)
	return false
}

// requireFittingParts reports errTooLarge at pos when a type t spells out inline is
// too large (partTooLarge), and whether none is.
func requireFittingParts(c @Checker, t @types.Type, pos token.Pos) bool {
	var w typeVisits
	if partTooLarge(c, t, &w) {
		errTooLarge(c, pos)
		return false
	}
	return true
}

// fitsTarget reports whether t's size fits the target, or depends on a type
// parameter (judged per instance), for the checker c (layoutDependsOnTypeParam).
func fitsTarget(c @Checker, t @types.Type) bool {
	if t == nil || layoutDependsOnTypeParam(c, t) || sizeAwaitsPending(c, t) ||
			sizeAwaitsCycleCut(c, t) {
		return true
	}
	var ok bool
	_, ok = t.SizeIfFits()
	return ok
}

// sizeAwaitsCycleCut reports whether t holds itself by value, or holds a named type
// that does, while the declarations are collected (Checker.DeclsCollecting): it has
// no layout, and its definition's cycle is reported -- and cut -- where the
// declarations are checked (checkValueEmbedding), so its size is not asked here.  The
// checks collection replays at its end, an interface instance's methods' sizes among
// them, can meet such a type: `type N1 [1]N1` as `@L[N1]`'s argument.
func sizeAwaitsCycleCut(c @Checker, t @types.Type) bool {
	return c != nil && c.DeclsCollecting && holdsItselfByValue(t)
}

// partTooLarge reports whether a part of t — a pointee, an array or slice element, a
// struct field, a function type's parameter or result (or its results together), an
// interface method's — at any depth, is too large for the target.  A pointer's
// pointee is a type too (`unsafe_index` strides by its size, and `*p` is a value of
// it), though t's own size does not include it.  The walk does not enter a named type
// other than a generic instance: a named type's own declaration is checked, an
// instance's structure (the generic's with this use's arguments) by no declaration.
// Each type is walked once (typeVisits): a type shared by several parts, at several
// depths, is a DAG, which walked as a tree takes time exponential in its depth.
func partTooLarge(c @Checker, t @types.Type, w *typeVisits) bool {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 {
			if !w.enter(t) { return false }
			// A type argument is a type formed here, whether or not the instance
			// lays it out.
			for i := 0; i < len(t.InstArgs); i++ {
				if typeTooLarge(c, t.InstArgs[i], w) { return true }
			}
			t = t.Underlying
		} else {
			break
		}
	}
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_POINTER || k == types.TYP_MANAGED_PTR || k == types.TYP_ARRAY ||
			k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
		return w.enter(t) && typeTooLarge(c, t.Elem, w)
	}
	if k == types.TYP_STRUCT && w.enter(t) {
		for i := 0; i < len(t.Fields); i++ {
			if typeTooLarge(c, t.Fields[i].Type, w) { return true }
		}
	}
	if (k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE) &&
			w.enter(t) {
		return signatureTooLarge(c, t, w)
	}
	if k == types.TYP_INTERFACE && w.enter(t) {
		for i := 0; i < len(t.Methods); i++ {
			var ft @types.Type = t.Methods[i].FuncType
			if ft != nil && signatureTooLarge(c, ft, w) { return true }
		}
	}
	return false
}

// signatureTooLarge reports whether a function type's parameter or result, or its
// results together (returned as one record), is too large for the target.
func signatureTooLarge(c @Checker, ft @types.Type, w *typeVisits) bool {
	for i := 0; i < len(ft.Params); i++ {
		if typeTooLarge(c, ft.Params[i].Type, w) { return true }
	}
	for i := 0; i < len(ft.Results); i++ {
		if typeTooLarge(c, ft.Results[i], w) { return true }
	}
	return !recordFits(c, ft.Results)
}

// typeTooLarge reports whether t, or a part of it (partTooLarge), is too large for
// the target.
func typeTooLarge(c @Checker, t @types.Type, w *typeVisits) bool {
	return !fitsTarget(c, t) || partTooLarge(c, t, w)
}

// requireFittingSignature reports when a function's parameter or result, or its
// results together, are too large for the target (requireFitting,
// requireFittingResults).
func requireFittingSignature(c @Checker, ft @types.Type, pos token.Pos) {
	for i := 0; i < len(ft.Params); i++ {
		_ = requireFitting(c, ft.Params[i].Type, pos)
	}
	for i := 0; i < len(ft.Results); i++ {
		_ = requireFitting(c, ft.Results[i], pos)
	}
	requireFittingResults(c, ft.Results, pos)
}

// requireFittingResults reports when a function's several results, together, are
// too large for the target: they are returned as one record of them, whose size has
// the same limit (an implementation limit, spec conf.implementation.limits).
func requireFittingResults(c @Checker, results *[]@types.Type, pos token.Pos) {
	if !recordFits(c, results) {
		addCheckError(c, pos,
				"the results are too large together (their combined size exceeds"
						" the target's maximum object size)")
	}
}

// requireFittingCaptures reports when what a function literal captures is too large
// for the target together: a closure keeps its captures, by value, in one record (an
// implementation limit, spec conf.implementation.limits).
func requireFittingCaptures(c @Checker, captures *[]@ast.Capture, pos token.Pos) {
	if len(captures) < 2 { return }
	var ts @[]@types.Type = make_slice(@types.Type, len(captures))
	for i := 0; i < len(captures); i++ {
		ts[i] = c.ExprType(captures[i].ResolvedTypeID)
		if ts[i] == nil { return }
	}
	if !recordFits(c, ts) {
		addCheckError(c, pos,
				"the captures are too large together (their combined size exceeds"
						" the target's maximum object size)")
	}
}

// recordFits reports whether a struct of fields of types ts fits the target — true
// for fewer than two (each is checked as a type) or when one depends on a type
// parameter (judged per instance).
func recordFits(c @Checker, ts *[]@types.Type) bool {
	if len(ts) < 2 { return true }
	var fields @[]@types.Field = make_slice(@types.Field, len(ts))
	for i := 0; i < len(ts); i++ {
		var f @types.Field = make(types.Field)
		f.Type = ts[i]
		fields[i] = f
	}
	return fitsTarget(c, types.MakeStructType("", fields))
}
