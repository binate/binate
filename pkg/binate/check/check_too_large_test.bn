package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_too_large.bn: a type larger than the target int's maximum (spec
// type.layout.max-size), a part of one, and too-large results or captures, on a
// 32-bit target (where 2 GB is too large) and a 64-bit one.

// checkSrcILP32 type-checks src with a 32-bit target's `int` and pointers (and
// 8-byte maximum alignment, as arm32's), restoring the target afterwards.
func checkSrcILP32(src *[]readonly char) @Checker {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	var c @Checker = checkSrc(src)
	types.SetTarget(old)
	return c
}

// tooLargeOn32 reports "" when src checks cleanly on a 64-bit target and fails on a
// 32-bit one with an error containing msg.
func tooLargeOn32(src *[]readonly char, msg *[]readonly char) testing.TestResult {
	var c64 @Checker = checkSrcLP64(src)
	if len(c64.CheckerErrors()) != 0 { return fail("it fits a 64-bit target") }
	var c32 @Checker = checkSrcILP32(src)
	if !anyErrContains(c32, msg) { return fail("it is too large for a 32-bit target") }
	return ""
}

// The largest array a 32-bit target holds is 2^31 - 1 bytes: one more byte is too
// large, and a length past its int is.
func TestTooLargeArrayBoundary32() testing.TestResult {
	var c @Checker = checkSrcILP32("package \"test\"\nvar p *([(1 << 31) - 1]uint8)\n")
	if len(c.CheckerErrors()) != 0 { return fail("2^31 - 1 bytes fit") }
	var r testing.TestResult = tooLargeOn32("package \"test\"\nvar p *([1 << 30][2]uint8)\n",
			"type is too large")
	if len(r) != 0 { return r }
	return tooLargeOn32("package \"test\"\nvar p *([1 << 31]uint8)\n", "array length is too large")
}

// A type past every target's limit is too large on a 64-bit target too, as a variable,
// a pointee, a sizeof operand, or a bit_cast target — reported, not laid out.
func TestTooLargeEveryTarget() testing.TestResult {
	var srcs @[]*[]readonly char = @[]*[]readonly char{
			"package \"test\"\nvar p *([1 << 30][1 << 30][1 << 30]uint8)\n",
			"package \"test\"\nfunc f() {\n\tvar a [1 << 30][1 << 30][1 << 30]uint8\n\t_ = a\n}\n",
			"package \"test\"\nconst N = sizeof([1 << 30][1 << 30][1 << 30]uint8)\n",
			"package \"test\"\nfunc f(x [2]uint8) uint8 {\n"
					"\treturn bit_cast([1 << 30][1 << 30][1 << 30]uint8, x)[0][0][0]\n}\n"}
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrcLP64(srcs[i])
		if !anyErrContains(c, "type is too large") { return fail("too large on every target") }
	}
	return ""
}

// A struct whose fields each fit can be too large together, a forward-declared field
// type included; so can a generic instance.
func TestTooLargeStructAndInstance() testing.TestResult {
	var r testing.TestResult = tooLargeOn32(
			"package \"test\"\ntype A struct {\n\tb B\n\tc B\n}\ntype B [1 << 30]uint8\nvar p *A\n",
			"type is too large")
	if len(r) != 0 { return r }
	return tooLargeOn32(
			"package \"test\"\ntype Box[T any] struct {\n\ta T\n\tb T\n}\n"
					"var p *Box[[1 << 30]uint8]\n",
			"type is too large")
}

// A function's results, and a function literal's captures, are kept in one record, so
// together they have the same limit.
func TestTooLargeResultsAndCaptures() testing.TestResult {
	var r testing.TestResult = tooLargeOn32(
			"package \"test\"\nfunc f() ([1 << 30]uint8, [1 << 30]uint8) {\n"
					"\tvar a [1 << 30]uint8\n\treturn a, a\n}\n",
			"results are too large together")
	if len(r) != 0 { return r }
	return tooLargeOn32(
			"package \"test\"\nfunc f() {\n\tvar a [1 << 30]uint8\n\tvar b [1 << 30]uint8\n"
					"\tvar g *func() = func() {\n\t\t_ = a\n\t\t_ = b\n\t}\n\tg()\n}\n",
			"captures are too large together")
}

// An array literal is checked in memory bounded by its element count, not its length:
// `[1 << 40]int8{}` is an empty literal of a valid (64-bit target) type.
func TestHugeArrayLiteralChecks() testing.TestResult {
	var c @Checker = checkSrcLP64(
			"package \"test\"\nfunc f(p *([1 << 40]int8)) {\n"
					"\t*p = [1 << 40]int8{1 << 39: 1}\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the literal checks cleanly") }
	return ""
}

// A generic body lays a type parameter out at a pointer's size, so a type whose
// layout depends on one is judged per instance, not in the body: these generics are
// valid (F[uint8] is a 2^61-byte instance on a 64-bit target), an interface instance's
// type argument that depends on one among them.
func TestTooLargeDependentNotJudgedInBody() testing.TestResult {
	var c @Checker = checkSrcLP64(
			"package \"test\"\nfunc F[T any](p *([1 << 61]T)) int {\n\treturn len(*p)\n}\n"
					"type B[T any] struct {\n\ta [1 << 61]T\n}\n"
					"func G[T any]() {\n\tvar p *B[T]\n\t_ = p\n}\n"
					"interface E[U any] {\n\tm() int\n}\nfunc H[T any]() {\n\tvar x @E[[1 << 61]T]\n\t_ = x\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the generics check cleanly on a 64-bit target") }
	c = checkSrcILP32("package \"test\"\nfunc F[T any](p *([1 << 30]T)) int {\n\treturn len(*p)\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the generic checks cleanly on a 32-bit target") }
	return ""
}

// Every place a type is formed is held to the limit: make and make_slice, a function
// literal's parameter and result, an interface method's result, a function-value
// type's results together, a generic call's type argument, a sizeof operand's
// pointee, a generic method instance's results together (at its call), and a generic
// type instance's type argument, laid out or not -- a struct's, an interface's in an
// interface value (in a generic's body too, beside a type parameter), a constraint,
// an impl's interface list, an interface's parent or an interface alias, or a generic
// alias's (in an instance's structure or a derived signature too).
func TestTooLargeEveryForm() testing.TestResult {
	var srcs @[]*[]readonly char = @[]*[]readonly char{
			"package \"test\"\nfunc f() bool {\n\treturn make([1 << 30][2]uint8) == nil\n}\n",
			"package \"test\"\nfunc f() int {\n\treturn len(make_slice([1 << 30][2]uint8, 1))\n}\n",
			"package \"test\"\nvar g *func([1 << 30][2]uint8) = func(x [1 << 30][2]uint8) {}\n",
			"package \"test\"\nvar g *func() [1 << 30][2]uint8 = func() [1 << 30][2]uint8 {\n"
					"\tvar a [1 << 30][2]uint8\n\treturn a\n}\n",
			"package \"test\"\ninterface I {\n\tM() [1 << 30][2]uint8\n}\n",
			"package \"test\"\nvar f *func() ([1 << 30]uint8, [1 << 30]uint8)\n",
			"package \"test\"\nfunc K[T any]() {}\nfunc f() {\n\tK[[1 << 30][2]uint8]()\n}\n",
			"package \"test\"\nconst N = sizeof(*([1 << 30][2]uint8))\n",
			"package \"test\"\ntype B[T any] struct {\n\tx int\n}\n"
					"func (b *B[T]) M() (T, T) {\n\tvar t T\n\treturn t, t\n}\n"
					"func f(b *B[[1 << 30]uint8]) {\n\t_, _ = b.M()\n}\n",
			"package \"test\"\ntype P[T any] struct {\n\tn int\n}\nvar p P[[1 << 30][2]uint8]\n",
			"package \"test\"\ninterface E[U any] {\n\tm() int\n}\nvar x @E[[1 << 30][2]uint8]\n",
			"package \"test\"\ninterface E[U any] {\n\tm() int\n}\nfunc f(e *E[[1 << 30][2]uint8]) {}\n",
			"package \"test\"\ninterface Big[T any, U any] {\n\tm(u U) int\n}\n"
					"func g[T any]() {\n\tvar x @Big[T, [1 << 30][2]uint8]\n\t_ = x\n}\n",
			"package \"test\"\ntype Ph[U any] = int\nvar x Ph[[1 << 30][2]uint8]\n",
			"package \"test\"\ntype Ph[U any] = int\ntype SA[T any] struct {\n\tf Ph[[1 << 30]T]\n}\n"
					"var sa SA[[2]uint8]\n",
			"package \"test\"\ntype Ph[U any] = int\nfunc k[T any](x Ph[[1 << 30]T]) {}\n"
					"func g() {\n\tk[[2]uint8](0)\n}\n",
			"package \"test\"\ninterface C[U any] {\n\tm() int\n}\nfunc f1[T C[[1 << 30][2]uint8]]() {}\n",
			"package \"test\"\ninterface C[U any] {\n\tm() int\n}\ntype S1 struct {\n\tn int\n}\n"
					"func (s *S1) m() int {\n\treturn 0\n}\nimpl *S1 : C[[1 << 30][2]uint8]\n",
			"package \"test\"\ninterface C[U any] {\n\tm() int\n}\ninterface Q : C[[1 << 30][2]uint8] {}\n",
			"package \"test\"\ninterface C[U any] {\n\tm() int\n}\ninterface QA = C[[1 << 30][2]uint8]\n"}
	for i := 0; i < len(srcs); i++ {
		var c64 @Checker = checkSrcLP64(srcs[i])
		if len(c64.CheckerErrors()) != 0 { return fail("it fits a 64-bit target") }
		var c32 @Checker = checkSrcILP32(srcs[i])
		if !anyErrContains(c32, "too large") { return fail("it is too large for a 32-bit target") }
	}
	return ""
}

// An inferred `[...]` length fits the target's int: an index at its maximum makes it
// too large (and on a 64-bit target, one past int64).  A key that is an integer
// constant past the target's int is out of bounds.
func TestTooLargeInferredLength() testing.TestResult {
	var src32 *[]readonly char = "package \"test\"\ntype E struct {}\n"
			"var a = [...]E{(1 << 31) - 1: E{}}\n"
	var c @Checker = checkSrcILP32(src32)
	if !anyErrContains(c, "array length is too large") {
		return fail("2^31 is too long for a 32-bit target")
	}
	c = checkSrcLP64(src32)
	if len(c.CheckerErrors()) != 0 { return fail("2^31 fits a 64-bit target") }
	c = checkSrcLP64("package \"test\"\ntype E struct {}\nvar a = [...]E{(1 << 63) - 1: E{}}\n")
	if !anyErrContains(c, "array length is too large") {
		return fail("2^63 is too long for a 64-bit target")
	}
	c = checkSrcILP32("package \"test\"\nvar a = [4]int{1 << 40: 1}\n")
	if !anyErrContains(c, "index out of bounds") {
		return fail("a key past the target's int is out of bounds")
	}
	return ""
}

// A variadic call's trailing arguments are packed into an array of their number of
// the element type, held to the target's limit: two 1 GiB arguments are too large
// for a 32-bit target, through a function and a method; one argument, or a spread
// slice, is not.
func TestTooLargeVariadicPack() testing.TestResult {
	var decls *[]readonly char = "package \"test\"\ntype Big [1 << 30]uint8\n"
			"func use(xs ...Big) int { return len(xs) }\n"
			"type R struct { n int }\nfunc (r *R) use(xs ...Big) int { return len(xs) }\n"
	var r testing.TestResult = tooLargeOn32(
			buf.Concat(decls, "func f(p *Big) int { return use(*p, *p) }\n"), "type is too large")
	if len(r) != 0 { return r }
	r = tooLargeOn32(buf.Concat(decls, "func f(p *Big, q *R) int { return q.use(*p, *p) }\n"),
			"type is too large")
	if len(r) != 0 { return r }
	var one @Checker = checkSrcILP32(
			buf.Concat(decls, "func f(p *Big, s *[]Big) int { return use(*p) + use(s...) }\n"))
	if len(one.CheckerErrors()) != 0 { return fail("one argument, or a spread slice, fits") }
	return ""
}

// A by-value cycle used as an interface instance's argument, its methods sized as
// collection ends, is reported as the cycle it is, not laid out.
func TestValueCycleAsIfaceInstanceArgReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"interface L[B any] { LN(f *B) }\n"
					"type N1 [1]N1\n"
					"func f(b @L[N1]) {}\n")
	if !errAtLine(c, 3,
			"recursive type: a type cannot contain itself by value (hold the recursive element via a poin"
					"ter -- *T or @T)") {
		return fail("N1's by-value cycle is reported")
	}
	return ""
}

// By-value cycles reached before their declarations are checked -- through an array
// length's sizeof in an interface instance's method, sized as collection ends, and
// through an alias declared before the cycle -- are reported as the cycles they are.
func TestValueCyclesReachedEarlyReported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"main\"\n"
					"interface P[B any] { LN(f [sizeof(B)]int) }\n"
					"interface Q4 : P[N4] { M() }\n"
					"type N4 [1]N4\n"
					"interface K[B any] { LN(f int) }\n"
					"interface Q6 : K[A6] { M() }\n"
					"type A6 = W[N6]\n"
					"type N6 [1]A6\n"
					"type W[T any] struct { v T }\n")
	var msg *[]readonly char = "recursive type: a type cannot contain itself by value"
			" (hold the recursive element via a pointer -- *T or @T)"
	if !errAtLine(c, 4, msg) { return fail("N4, read by sizeof in P[N4]'s method, is reported") }
	if !errAtLine(c, 8, msg) {
		return fail("N6, reached through the alias A6 declared first, is reported")
	}
	return ""
}

// A part of an alias that is a type not collected yet fits until it is, so the
// alias is not kept: each of two reads of its size, made while declarations are
// collected, is made again once the part is, and reports it too large.
func TestPartsFittingNotKeptPending() testing.TestResult {
	var c @Checker = checkSrcLP64("package \"main\"\n"
			"type A = *P\n"
			"type X [sizeof(A) + sizeof(A)]uint8\n"
			"type P [0x4000000000000000]uint16\n")
	var errs @[]CheckError = c.CheckerErrors()
	var reads int = 0
	for i := 0; i < len(errs); i++ {
		if errs[i].Pos.Line == 3 && msgContains(errs[i].Msg, "too large") { reads = reads + 1 }
	}
	if reads != 2 { return fail(buf.Concat("both reads are reported, got ", strconv.Itoa(reads))) }
	return ""
}

// fittingAliasChain returns the first of n aliases main.F0 .. main.F(n-1), each of the
// next, the last of leaf.
func fittingAliasChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := n - 1; i >= 0; i-- {
		t = types.MakeAliasType(buf.Concat("main.F", strconv.Itoa(i)), t)
	}
	return t
}

// requireFittingParts keeps the aliases of a chain whose parts fit, and an alias of a
// kept link fits at it; a chain over a pointer to a type too large for a 32-bit target
// keeps none and is reported at each ask; a type change empties the kept aliases.
func TestPartsFittingKept() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	var r testing.TestResult = partsFittingKept()
	types.SetTarget(old)
	return r
}

// partsFittingKept is TestPartsFittingKept's check, on a 32-bit target.
func partsFittingKept() testing.TestResult {
	var c @Checker = NewChecker()
	var pos token.Pos
	var fits @types.Type = fittingAliasChain(5, types.MakePointerType(types.TypInt()))
	if !requireFittingParts(c, fits, pos) { return fail("a chain over *int fits") }
	if !c.PartsFitting.Types.Has(fits) || !c.PartsFitting.Types.Has(fits.Target.Target) {
		return fail("the chain's aliases are kept")
	}
	var over @types.Type = types.MakeAliasType(buf.CopyStr("main.G"), fits.Target)
	if !requireFittingParts(c, over, pos) || !c.PartsFitting.Types.Has(over) {
		return fail("an alias of a kept link fits, and is kept")
	}
	var big @types.Type = types.MakeArrayType(types.TypUint8(), 0x80000000)
	var tooLarge @types.Type = fittingAliasChain(3, types.MakePointerType(big))
	for i := 0; i < 2; i++ {
		var at token.Pos
		at.Line = i + 1
		if requireFittingParts(c, tooLarge, at) { return fail("a pointer to 2 GiB is too large") }
	}
	if c.PartsFitting.Types.Has(tooLarge) { return fail("a chain too large is not kept") }
	if len(c.CheckerErrors()) != 2 { return fail("each ask is reported") }
	noteTypeGraphChanged(c)
	if partsFittingOf(c).Types.Has(fits) { return fail("a type change empties the kept aliases") }
	return ""
}
