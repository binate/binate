package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_too_large.bn: a type larger than the target int's maximum (spec
// type.layout.max-size), a part of one, and too-large results or captures, on a
// 32-bit target (where 2 GB is too large) and a 64-bit one.

// checkSrcILP32 type-checks src with a 32-bit target's `int` and pointers (and
// 8-byte maximum alignment, as arm32's), restoring the target afterwards.
func checkSrcILP32(src *[]readonly char) @Checker {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	var c @Checker = checkSrc(src)
	types.SetTarget(old)
	return c
}

// tooLargeOn32 reports "" when src checks cleanly on a 64-bit target and fails on a
// 32-bit one with an error containing msg.
func tooLargeOn32(src *[]readonly char, msg *[]readonly char) testing.TestResult {
	var c64 @Checker = checkSrcLP64(src)
	if len(c64.CheckerErrors()) != 0 { return fail("it fits a 64-bit target") }
	var c32 @Checker = checkSrcILP32(src)
	if !anyErrContains(c32, msg) { return fail("it is too large for a 32-bit target") }
	return ""
}

// The largest array a 32-bit target holds is 2^31 - 1 bytes: one more byte is too
// large, and a length past its int is.
func TestTooLargeArrayBoundary32() testing.TestResult {
	var c @Checker = checkSrcILP32("package \"test\"\nvar p *([(1 << 31) - 1]uint8)\n")
	if len(c.CheckerErrors()) != 0 { return fail("2^31 - 1 bytes fit") }
	var r testing.TestResult = tooLargeOn32("package \"test\"\nvar p *([1 << 30][2]uint8)\n",
			"type is too large")
	if len(r) != 0 { return r }
	return tooLargeOn32("package \"test\"\nvar p *([1 << 31]uint8)\n", "array length is too large")
}

// A type past every target's limit is too large on a 64-bit target too, as a variable,
// a pointee, a sizeof operand, or a bit_cast target — reported, not laid out.
func TestTooLargeEveryTarget() testing.TestResult {
	var srcs @[]*[]readonly char = @[]*[]readonly char{
			"package \"test\"\nvar p *([1 << 30][1 << 30][1 << 30]uint8)\n",
			"package \"test\"\nfunc f() {\n\tvar a [1 << 30][1 << 30][1 << 30]uint8\n\t_ = a\n}\n",
			"package \"test\"\nconst N = sizeof([1 << 30][1 << 30][1 << 30]uint8)\n",
			"package \"test\"\nfunc f(x [2]uint8) uint8 {\n"
		"\treturn bit_cast([1 << 30][1 << 30][1 << 30]uint8, x)[0][0][0]\n}\n"}
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrcLP64(srcs[i])
		if !anyErrContains(c, "type is too large") { return fail("too large on every target") }
	}
	return ""
}

// A struct whose fields each fit can be too large together, a forward-declared field
// type included; so can a generic instance.
func TestTooLargeStructAndInstance() testing.TestResult {
	var r testing.TestResult = tooLargeOn32(
			"package \"test\"\ntype A struct {\n\tb B\n\tc B\n}\ntype B [1 << 30]uint8\nvar p *A\n",
			"type is too large")
	if len(r) != 0 { return r }
	return tooLargeOn32(
			"package \"test\"\ntype Box[T any] struct {\n\ta T\n\tb T\n}\n"
					"var p *Box[[1 << 30]uint8]\n",
			"type is too large")
}

// A function's results, and a function literal's captures, are kept in one record, so
// together they have the same limit.
func TestTooLargeResultsAndCaptures() testing.TestResult {
	var r testing.TestResult = tooLargeOn32(
			"package \"test\"\nfunc f() ([1 << 30]uint8, [1 << 30]uint8) {\n"
					"\tvar a [1 << 30]uint8\n\treturn a, a\n}\n",
			"results are too large together")
	if len(r) != 0 { return r }
	return tooLargeOn32(
			"package \"test\"\nfunc f() {\n\tvar a [1 << 30]uint8\n\tvar b [1 << 30]uint8\n"
					"\tvar g *func() = func() {\n\t\t_ = a\n\t\t_ = b\n\t}\n\tg()\n}\n",
			"captures are too large together")
}

// An array literal is checked in memory bounded by its element count, not its length:
// `[1 << 40]int8{}` is an empty literal of a valid (64-bit target) type.
func TestHugeArrayLiteralChecks() testing.TestResult {
	var c @Checker = checkSrcLP64(
			"package \"test\"\nfunc f(p *([1 << 40]int8)) {\n"
					"\t*p = [1 << 40]int8{1 << 39: 1}\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the literal checks cleanly") }
	return ""
}

// A generic body lays a type parameter out at a pointer's size, so a type whose
// layout depends on one is judged per instance, not in the body: these generics are
// valid (F[uint8] is a 2^61-byte instance on a 64-bit target).
func TestTooLargeDependentNotJudgedInBody() testing.TestResult {
	var c @Checker = checkSrcLP64(
			"package \"test\"\nfunc F[T any](p *([1 << 61]T)) int {\n\treturn len(*p)\n}\n"
					"type B[T any] struct {\n\ta [1 << 61]T\n}\n"
					"func G[T any]() {\n\tvar p *B[T]\n\t_ = p\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the generics check cleanly on a 64-bit target") }
	c = checkSrcILP32("package \"test\"\nfunc F[T any](p *([1 << 30]T)) int {\n\treturn len(*p)\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail("the generic checks cleanly on a 32-bit target") }
	return ""
}

// Every place a type is formed is held to the limit: make and make_slice, a function
// literal's parameter and result, an interface method's result, a function-value
// type's results together, a generic call's type argument, a sizeof operand's
// pointee, a generic method instance's results together (at its call), and a generic
// type instance's type argument (laid out or not).
func TestTooLargeEveryForm() testing.TestResult {
	var srcs @[]*[]readonly char = @[]*[]readonly char{
			"package \"test\"\nfunc f() bool {\n\treturn make([1 << 30][2]uint8) == nil\n}\n",
			"package \"test\"\nfunc f() int {\n\treturn len(make_slice([1 << 30][2]uint8, 1))\n}\n",
			"package \"test\"\nvar g *func([1 << 30][2]uint8) = func(x [1 << 30][2]uint8) {}\n",
			"package \"test\"\nvar g *func() [1 << 30][2]uint8 = func() [1 << 30][2]uint8 {\n"
		"\tvar a [1 << 30][2]uint8\n\treturn a\n}\n",
			"package \"test\"\ninterface I {\n\tM() [1 << 30][2]uint8\n}\n",
			"package \"test\"\nvar f *func() ([1 << 30]uint8, [1 << 30]uint8)\n",
			"package \"test\"\nfunc K[T any]() {}\nfunc f() {\n\tK[[1 << 30][2]uint8]()\n}\n",
			"package \"test\"\nconst N = sizeof(*([1 << 30][2]uint8))\n",
			"package \"test\"\ntype B[T any] struct {\n\tx int\n}\n"
		"func (b *B[T]) M() (T, T) {\n\tvar t T\n\treturn t, t\n}\n"
		"func f(b *B[[1 << 30]uint8]) {\n\t_, _ = b.M()\n}\n",
			"package \"test\"\ntype P[T any] struct {\n\tn int\n}\nvar p P[[1 << 30][2]uint8]\n"}
	for i := 0; i < len(srcs); i++ {
		var c64 @Checker = checkSrcLP64(srcs[i])
		if len(c64.CheckerErrors()) != 0 { return fail("it fits a 64-bit target") }
		var c32 @Checker = checkSrcILP32(srcs[i])
		if !anyErrContains(c32, "too large") { return fail("it is too large for a 32-bit target") }
	}
	return ""
}

// An inferred `[...]` length fits the target's int: an index at its maximum makes it
// too large (and on a 64-bit target, one past int64).  A key that is an integer
// constant past the target's int is out of bounds.
func TestTooLargeInferredLength() testing.TestResult {
	var src32 *[]readonly char = "package \"test\"\ntype E struct {}\n"
			"var a = [...]E{(1 << 31) - 1: E{}}\n"
	var c @Checker = checkSrcILP32(src32)
	if !anyErrContains(c, "array length is too large") {
		return fail("2^31 is too long for a 32-bit target")
	}
	c = checkSrcLP64(src32)
	if len(c.CheckerErrors()) != 0 { return fail("2^31 fits a 64-bit target") }
	c = checkSrcLP64("package \"test\"\ntype E struct {}\nvar a = [...]E{(1 << 63) - 1: E{}}\n")
	if !anyErrContains(c, "array length is too large") {
		return fail("2^63 is too long for a 64-bit target")
	}
	c = checkSrcILP32("package \"test\"\nvar a = [4]int{1 << 40: 1}\n")
	if !anyErrContains(c, "index out of bounds") {
		return fail("a key past the target's int is out of bounds")
	}
	return ""
}
