package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// Collection of type declarations: each non-generic type declaration binds its
// name to the type it declares (collectTypeDecl), a blank one only has its type
// checked (checkBlankTypeDecl), and either records that type on the declaration
// (recordDeclaredType).

// recordDeclaredType records t on d as the type d declares (Decl.ResolvedTypeID),
// so a reader holds the declaration's type without looking its name up -- which
// could find another type once the name is rebound; nothing when t is nil.
func recordDeclaredType(c @Checker, d @ast.Decl, t @types.Type) {
	if t != nil { d.ResolvedTypeID = registerExprType(c, t) }
}

// recordBoundType records on d the type sym, the symbol d's name is already bound
// to, binds -- when sym is a type; a declaration redeclaring a variable's or a
// constant's name declares nothing it could record.
func recordBoundType(c @Checker, d @ast.Decl, sym @Symbol) {
	if sym.Kind == types.SYM_TYPE { recordDeclaredType(c, d, sym.Type) }
}

// collectTypeDecl registers a top-level type declaration in the current
// scope during pass-1 collection, so later declarations and forward
// references resolve by name, and records on d the type it declares
// (recordDeclaredType).  Generic decls (with type params) are
// skipped here — they're instantiated on demand; a forward decl registers
// a bodyless TYP_NAMED placeholder; an alias registers a TYP_ALIAS; a
// struct / named-distinct decl registers its underlying (or fills a
// previously-registered forward placeholder's).
func collectTypeDecl(c @Checker, d @ast.Decl) {
	if len(d.TypeParams) > 0 {
		return
	}
	if isBlank(d.Name) {
		checkBlankTypeDecl(c, d)
		return
	}
	if d.IsForward {
		// Forward declaration: register as TYP_NAMED with no
		// Underlying.  The .bn impl's `type S struct { ... }` (if
		// present) fills in the body via the same path used for
		// generic-decl placeholders (the TYP_NAMED-with-nil-
		// Underlying branch below).  Idempotent — a second forward
		// decl of the same name is a no-op.
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil {
			recordBoundType(c, d, sym)
			return
		}
		var named @types.Type = types.MakeNamedType(d.Name)
		named.Pkg = buf.CopyStr(c.curPkgPath)
		defineType(c.Scope, d.Name, named)
		recordDeclaredType(c, d, named)
		return
	}
	if d.IsAlias {
		if !beginAliasDecl(c, d) { return }
		var target @types.Type = resolveTypeExpr(c, d.TypeRef)
		var alias @types.Type = types.MakeAliasType(d.Name, target)
		defineType(c.Scope, d.Name, alias)
		recordDeclaredType(c, d, alias)
		endAliasDecl(c, d)
	} else if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
		var st @types.Type = resolveStructType(c, d.TypeRef)
		st.Name = types.QualifyName(c.curPkgPath, d.Name)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		// An existing same-name type means this decl either fills a
		// forward placeholder (Underlying == nil — the legal opaque
		// path) or re-declares an already-defined type.  A genuine
		// redeclaration is diagnosed by the dedicated checkTypeRedeclar-
		// ation pass (which counts source decls, so it isn't fooled by
		// the loader's .bni merge-prepend or resolveBuiltinScalarType-
		// Decls re-seeing the same decl); collectTypeDecl stays silent
		// here rather than emit a second diagnostic.
		if sym != nil && sym.Type.Kind == types.TYP_NAMED {
			if sym.Type.Underlying == nil {
				setUnderlying(c, sym.Type, st)
			}
			recordBoundType(c, d, sym)
			return
		}
		if sym != nil && sym.Type.Kind == types.TYP_STRUCT {
			recordBoundType(c, d, sym)
			return
		}
		defineType(c.Scope, d.Name, st)
		recordDeclaredType(c, d, st)
	} else {
		var underlying @types.Type = resolveTypeExpr(c, d.TypeRef)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		// As in the struct branch: fill a forward placeholder if present,
		// otherwise stay silent and let checkTypeRedeclaration diagnose a
		// genuine redeclaration.
		if sym != nil && sym.Type.Kind == types.TYP_NAMED {
			// Stamp the defining package for cross-package identity (a struct
			// carries this in its qualified underlying Name; a non-struct
			// scalar/etc. wrapper carries it here — see namedIdentityName).
			sym.Type.Pkg = buf.CopyStr(c.curPkgPath)
			if sym.Type.Underlying == nil {
				setUnderlying(c, sym.Type, underlying)
				if namedTypeDefIsCyclic(sym.Type) {
					errCyclicType(c, d.Pos, d.Name)
					setUnderlying(c, sym.Type, nil)
				}
			}
			recordBoundType(c, d, sym)
			return
		}
		var named @types.Type = types.MakeNamedType(d.Name)
		named.Pkg = buf.CopyStr(c.curPkgPath)
		setUnderlying(c, named, underlying)
		if namedTypeDefIsCyclic(named) {
			errCyclicType(c, d.Pos, d.Name)
			setUnderlying(c, named, nil)
		}
		defineType(c.Scope, d.Name, named)
		recordDeclaredType(c, d, named)
	}
}

// checkBlankTypeDecl checks a blank type declaration `type _ …` (alias or not):
// it binds no name, but its type must still be valid — a program may use one as
// a compile-time assertion that a type expression is well-formed.
func checkBlankTypeDecl(c @Checker, d @ast.Decl) {
	if d.IsForward || d.TypeRef == nil {
		return
	}
	var t @types.Type
	if d.TypeRef.Kind == ast.TEXPR_STRUCT {
		t = resolveStructType(c, d.TypeRef)
	} else {
		t = resolveTypeExpr(c, d.TypeRef)
	}
	// Nothing is bound, but the type is recorded, for checkTypeDepths.
	recordDeclaredType(c, d, t)
}
