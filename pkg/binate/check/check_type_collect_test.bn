package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for check_type_collect.bn: each type and interface declaration records
// the type it declares (Decl.ResolvedTypeID), which is the type its name is
// bound to.

// checkSrcKeepingScope checks src as checkSrcResolved does, keeping the package
// scope installed (CheckMainPersistent), and also returns the parsed file.
func checkSrcKeepingScope(src *[]readonly char) (@Checker, @ast.File) {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = mustParse(p)
	var c @Checker = NewChecker()
	c.CheckMainPersistent(file)
	return c, file
}

// recordsMatchScope returns "" when every named, non-generic type and interface
// declaration of decls (groups included) records the type s binds its name to,
// or a message naming the first that does not.
func recordsMatchScope(c @Checker, s @Scope, decls *[]@ast.Decl) testing.TestResult {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var r testing.TestResult = recordsMatchScope(c, s, d.Decls)
			if len(r) > 0 { return r }
			continue
		}
		if d.Kind != ast.DECL_TYPE && d.Kind != ast.DECL_INTERFACE || len(d.TypeParams) > 0 { continue }
		if d.ResolvedTypeID == 0 { return fail(buf.Concat("no record on the declaration of ", d.Name)) }
		var sym @Symbol = s.Lookup(d.Name)
		if sym == nil { return fail(buf.Concat("not in scope: ", d.Name)) }
		if !same(c.ExprType(d.ResolvedTypeID), sym.Type) {
			return fail(buf.Concat("the record is not the scope's type: ", d.Name))
		}
	}
	return ""
}

// A package's struct, distinct, alias, forward-declared and grouped types and
// its interfaces and interface alias each record the type their name is bound
// to; a forward declaration and its definition record one type.
func TestCollectTypeDeclRecordsDeclaredType() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcKeepingScope(
			"package \"test\"\n"
					"type S struct { a int }\n"
					"type Id int\n"
					"type R = int\n"
					"type F\n"
					"type F struct { x int }\n"
					"type (\n\tG int\n\tH = S\n)\n"
					"interface I { M() int }\n"
					"interface J = I\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	r = recordsMatchScope(c, c.Scope, file.Decls)
	if len(r) > 0 { return r }
	var fwd @types.Type = c.ExprType(file.Decls[3].ResolvedTypeID)
	if !same(fwd, c.ExprType(file.Decls[4].ResolvedTypeID)) {
		return fail("F's forward declaration and its definition record different types")
	}
	return ""
}

// A blank type declaration records the type it checks.
func TestCollectTypeDeclRecordsBlankType() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile("package \"test\"\ntype _ *int\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if file.Decls[0].ResolvedTypeID == 0 { return fail("no record on `type _ *int`") }
	var t @types.Type = c.ExprType(file.Decls[0].ResolvedTypeID)
	if t == nil || t.Kind != types.TYP_POINTER { return fail("`type _ *int` records *int") }
	return ""
}

// A blank interface declaration, alias or not, records no type: it declares none,
// and the depth check (declaredTypeOf) does not measure it.
func TestCollectInterfaceDeclBlankRecordsNone() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(
			"package \"test\"\n"
					"interface I { M() int }\n"
					"interface _ { N() int }\n"
					"interface _ = I\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if file.Decls[0].ResolvedTypeID == 0 { return fail("no record on interface I") }
	if file.Decls[1].ResolvedTypeID != 0 { return fail("`interface _ { … }` records a type") }
	if file.Decls[2].ResolvedTypeID != 0 { return fail("`interface _ = I` records a type") }
	return ""
}

// A package interface loaded on its own (LoadPackageInterface) records each
// declaration's type as well: a struct, a distinct type, an alias, an opaque
// type, an interface and an interface alias.
func TestLoadPackageInterfaceRecordsDeclaredType() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"type S struct { a int }\n"
					"type N int\n"
					"type A = int\n"
					"type O\n"
					"interface I { M() int }\n"
					"interface J = I\n")
	c.LoadPackageInterface("foo", f)
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	return recordsMatchScope(c, pkgScope, f.Decls)
}
