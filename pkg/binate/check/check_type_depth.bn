// The nesting depth of a type, which may not pass an implementation limit (spec
// type.named.depth): a declared type nesting deeper is reported at its declaration and
// cut off there.
package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/table"
import "pkg/std/vec"

// maxTypeDepth is the deepest a type may nest (type.named.depth): the number of types in
// its longest chain of parts (measureDefinition).
const maxTypeDepth int = 1024

// depthWalk is one measure of types' nesting depths (checkTypeDepths): the declared
// types it reports, the depths found, and the work lists and tables of its two walks.
type depthWalk struct {
	c @Checker
	// The types declared, each mapped to its declaration's index in decls, in roots'
	// order (collectDepthDecls).
	declared @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	decls    @vec.Vec[@ast.Decl]
	roots    @vec.Vec[@types.Type]
	// The depths found: each definition's, and each other type's whose depth is the
	// same in any definition (it reaches no definition in the cycle measured with it).
	depths @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]

	// Finding cycles (measureFrom): the order each definition was met in, counting
	// from 1 (orders the last); the cycle each definition is in once it is complete,
	// named by the order of the first met; the frames of the definitions being looked
	// at, the definitions each refers to (refs), and those whose cycle is not complete
	// yet (open).  Listing the definitions one refers to (listRefs): the parts still to
	// look at, and the listing each type was last looked at in (listings the last).
	order    @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	orders   int
	cycle    @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	finding  @vec.Vec[cycleFrame]
	refs     @vec.Vec[@types.Type]
	open     @vec.Vec[@types.Type]
	parts    @vec.Vec[@types.Type]
	listed   @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	listings int

	// Measuring a cycle (closeCycle): the cycle; the depths of the types whose depth
	// holds within it only, reached by value and through a reference (made on first
	// use); the frames of the types being measured.
	cur       int
	cycleVal  @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	cycleRef  @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
	measuring @vec.Vec[measureFrame]
	// The definitions a by-value cycle came back round to (breakByValueCycle).
	broken @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq]
}

// newDepthWalk returns a depthWalk for c with nothing declared or measured yet.
func newDepthWalk(c @Checker) @depthWalk {
	var w @depthWalk = make(depthWalk)
	w.c = c
	w.declared = newTypeDepthTable()
	w.decls = vec.New[@ast.Decl]()
	w.roots = vec.New[@types.Type]()
	w.depths = newTypeDepthTable()
	w.order = newTypeDepthTable()
	w.cycle = newTypeDepthTable()
	w.finding = vec.New[cycleFrame]()
	w.refs = vec.New[@types.Type]()
	w.open = vec.New[@types.Type]()
	w.parts = vec.New[@types.Type]()
	w.listed = newTypeDepthTable()
	w.measuring = vec.New[measureFrame]()
	w.broken = newTypeDepthTable()
	return w
}

// newTypeDepthTable returns an empty table of ints keyed by type, by identity.
func newTypeDepthTable() @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq] {
	return table.NewTable[@types.Type, int, typeIdentityHasher, typeIdentityEq](
			typeIdentityHasher{}, typeIdentityEq{})
}

// checkTypeDepths reports each type declared in decls, and in the package interface bni
// unless that is nil, that nests more than maxTypeDepth levels, at its declaration --
// each type once, however many declarations it has.  The types declared are the named
// types and interfaces defined, each cut off where it passes the limit (cutTooDeep) so
// no type holding it nests too deeply through it, and the types an alias or a blank
// `type _` declaration names, which are only reported: such a type may be one another
// declaration or package defines.  It runs once the declarations are collected, when
// every named type's underlying type is filled, before the checks that walk the types
// (checkValueEmbedding).  A generic declaration is measured in its instances, as parts
// of the types that hold them.
func checkTypeDepths(c @Checker, decls *[]@ast.Decl, bni @ast.File) {
	var w @depthWalk = newDepthWalk(c)
	collectDepthDecls(w, decls, false)
	if bni != nil { collectDepthDecls(w, bni.Decls, false) }
	collectDepthDecls(w, decls, true)
	if bni != nil { collectDepthDecls(w, bni.Decls, true) }
	for i := 0; i < w.roots.Len(); i++ {
		var t @types.Type = w.roots.Get(i)
		measureFrom(w, t)
		// A definition is reported as it is measured (measureDefinition); the type
		// an alias or a blank declaration names may have been measured as a part of
		// another.
		if !isDefinition(t) {
			d, _ := w.depths.Get(t)
			if d > maxTypeDepth { _ = tooDeep(w, t, d) }
		}
	}
}

// collectDepthDecls records in w the types decls declare that checkTypeDepths
// measures: the named types and interfaces they define -- each by its definition, not
// a forward declaration -- or with names, the types their aliases and blank
// declarations name (collected after, so a type defined here is reported as defined).
func collectDepthDecls(w @depthWalk, decls *[]@ast.Decl, names bool) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			collectDepthDecls(w, d.Decls, names)
			continue
		}
		if len(d.TypeParams) > 0 || d.IsForward || (isBlank(d.Name) || d.IsAlias) != names {
			continue
		}
		var t @types.Type = declaredTypeOf(w.c, d)
		if t != nil && !w.declared.Has(t) {
			w.declared.Put(t, w.decls.Len())
			w.decls.Push(d)
			w.roots.Push(t)
		}
	}
}

// declaredTypeOf returns the type d declares: a named type's or an interface's, the
// alias an alias declaration declares, or the type a blank `type _` declaration
// checks (checkBlankTypeDecl); nil for any other declaration.
func declaredTypeOf(c @Checker, d @ast.Decl) @types.Type {
	if d.Kind != ast.DECL_TYPE && d.Kind != ast.DECL_INTERFACE { return nil }
	if isBlank(d.Name) {
		if d.Kind != ast.DECL_TYPE || d.ResolvedTypeID == 0 { return nil }
		return c.ExprType(d.ResolvedTypeID)
	}
	var sym @Symbol = c.Scope.Lookup(d.Name)
	if sym == nil || sym.Kind != types.SYM_TYPE && sym.Kind != types.SYM_INTERFACE { return nil }
	return sym.Type
}

// tooDeep reports t, which nests depth levels, past maxTypeDepth, at its declaration if
// it is a declared type (w.declared), and cuts it off there if that declaration defines
// it (cutTooDeep).  It returns t's depth after.
func tooDeep(w @depthWalk, t @types.Type, depth int) int {
	idx, isDeclared := w.declared.Get(t)
	if !isDeclared { return depth }
	var d @ast.Decl = w.decls.Get(idx)
	var msg @[]char = buf.Concat(buf.Concat("type ", d.Name), " nests too deeply: more than ")
	msg = buf.Concat(msg, buf.Concat(strconv.Itoa(maxTypeDepth), " levels of types"))
	addCheckError(w.c, d.Pos, msg)
	if isBlank(d.Name) || d.IsAlias { return depth }
	return cutTooDeep(w, t)
}

// cutTooDeep cuts t, a named type or an interface nesting too deeply, off where its
// chains pass the limit, and returns its depth after.  A named type over a struct has
// each field nesting maxTypeDepth levels or more poisoned with the error type, as a type
// holding itself by value has its field poisoned (checkTypeByValueCycle), so a use of it
// raises no further errors; any other named type's underlying type becomes the error
// type.  An interface's method signatures are cut likewise (cutSignature), and it drops
// each parent nesting maxTypeDepth levels or more -- and the methods that parent gives
// it.
func cutTooDeep(w @depthWalk, t @types.Type) int {
	if t.Kind == types.TYP_INTERFACE { return cutInterface(w, t) }
	var u @types.Type = t.Underlying
	if u == nil || u.Kind != types.TYP_STRUCT {
		setUnderlying(w.c, t, types.TypError())
		return 1
	}
	var deepest int = 0
	for i := 0; i < len(u.Fields); i++ {
		var fd int = knownDepth(w, u.Fields[i].Type, false)
		if fd >= maxTypeDepth {
			u.Fields[i].Type = types.TypError()
			fd = 1
		}
		if fd > deepest { deepest = fd }
	}
	noteTypeGraphChanged(w.c)
	// The struct may be another named type's underlying type too (`type U T`).
	if w.depths.Has(u) {
		w.depths.Put(u, 1 + deepest)
	} else {
		cycleDepths(w, false).Put(u, 1 + deepest)
	}
	return 1 + deepest
}

// cutInterface is cutTooDeep for interface t.
func cutInterface(w @depthWalk, t @types.Type) int {
	var depth int = 1
	var kept int = 0
	for i := 0; i < len(t.Parents); i++ {
		if knownDepth(w, t.Parents[i], true) < maxTypeDepth { kept = kept + 1 }
	}
	var parents @[]@types.Type = make_slice(@types.Type, kept)
	kept = 0
	for i := 0; i < len(t.Parents); i++ {
		var pd int = knownDepth(w, t.Parents[i], true)
		if pd < maxTypeDepth {
			parents[kept] = t.Parents[i]
			kept = kept + 1
			if 1 + pd > depth { depth = 1 + pd }
		}
	}
	t.Parents = parents
	var methods @[]@types.Method = make_slice(@types.Method, len(t.Methods))
	for i := 0; i < len(t.Methods); i++ {
		var m @types.Method = t.Methods[i]
		methods[i] = m
		if m == nil { continue }
		var md int = knownDepth(w, m.FuncType, true)
		if md >= maxTypeDepth {
			var cut @types.Method = make(types.Method)
			cut.Name = m.Name
			cut.RecvType = m.RecvType
			cut.PrivatePkg = m.PrivatePkg
			sig, sd := cutSignature(w, m.FuncType)
			cut.FuncType = sig
			md = sd
			methods[i] = cut
		}
		if 1 + md > depth { depth = 1 + md }
	}
	t.Methods = methods
	noteTypeGraphChanged(w.c)
	return depth
}

// cutSignature returns a copy of signature ft, a part of an interface, whose
// parameters and results nesting maxTypeDepth - 1 levels or more have the error type --
// a variadic parameter a slice of it -- so a call checks with no further errors, and
// the copy's depth.
func cutSignature(w @depthWalk, ft @types.Type) (@types.Type, int) {
	var deepest int = 0
	var params @[]@types.Param = make_slice(@types.Param, len(ft.Params))
	for i := 0; i < len(ft.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = ft.Params[i].Name
		p.IsVariadic = ft.Params[i].IsVariadic
		p.Type = ft.Params[i].Type
		var pd int = knownDepth(w, p.Type, true)
		if pd >= maxTypeDepth - 1 {
			p.Type = types.TypError()
			pd = 1
			if p.IsVariadic {
				p.Type = types.MakeSliceType(types.TypError())
				pd = 2
			}
		}
		if pd > deepest { deepest = pd }
		params[i] = p
	}
	var results @[]@types.Type = make_slice(@types.Type, len(ft.Results))
	for i := 0; i < len(ft.Results); i++ {
		results[i] = ft.Results[i]
		var rd int = knownDepth(w, results[i], true)
		if rd >= maxTypeDepth - 1 {
			results[i] = types.TypError()
			rd = 1
		}
		if rd > deepest { deepest = rd }
	}
	return types.MakeFuncType(params, results), 1 + deepest
}
