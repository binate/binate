package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_type_depth.bn: the limit on a declared type's nesting depth
// (checkTypeDepths), and how a type past it is cut off.

// writeChainDecl writes `type <name><i> struct { n <name><i+1> }` to b.
func writeChainDecl(b @strings.Builder, name *[]readonly char, i int) {
	b.Write("type ")
	b.Write(name)
	b.Write(strconv.Itoa(i))
	b.Write(" struct { n ")
	b.Write(name)
	b.Write(strconv.Itoa(i + 1))
	b.Write(" }\n")
}

// typeChainSrc returns a program declaring n named types T0 .. Tn-1, each holding the
// next by value -- T0 the outermost, declared first, or last when reversed -- over
// `type Tn struct { v int64 }`, which also holds a pointer back to T0 when back.
func typeChainSrc(n int, reversed bool, back bool) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for k := 0; k < n; k++ {
		var i int = k
		if reversed { i = n - 1 - k }
		writeChainDecl(b, "T", i)
	}
	b.Write("type T")
	b.Write(strconv.Itoa(n))
	if back {
		b.Write(" struct { v int64; back *T0 }\n")
	} else {
		b.Write(" struct { v int64 }\n")
	}
	return buf.CopyStr(b.String())
}

// errsSay returns "" if c reported exactly one error, saying msg, or what it reported
// instead.
func errsSay(c @Checker, msg *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		return fail(buf.Concat("one error expected, got ", strconv.Itoa(len(errs))))
	}
	if !streq(errs[0].Msg, msg) { return fail(errs[0].Msg) }
	return ""
}

// twoErrsSay returns "" if c reported exactly two errors, saying m1 and m2 in either
// order, or what it reported instead.
func twoErrsSay(c @Checker, m1 *[]readonly char, m2 *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 2 {
		return fail(buf.Concat("two errors expected, got ", strconv.Itoa(len(errs))))
	}
	if streq(errs[0].Msg, m1) && streq(errs[1].Msg, m2) ||
			streq(errs[0].Msg, m2) && streq(errs[1].Msg, m1) {
		return ""
	}
	return fail(buf.Concat(buf.Concat(errs[0].Msg, " / "), errs[1].Msg))
}

// A declared type may nest maxTypeDepth levels.  T0 of a chain of n declarations nests
// n + 2 levels -- a struct for each, and the last type's struct and int64 -- so 1022
// declarations reach the limit exactly, and one more is reported once, at T0, the type
// that passes it.
func TestDeepTypeLimit() testing.TestResult {
	var atLimit @Checker = checkSrc(typeChainSrc(maxTypeDepth - 2, false, false))
	if len(atLimit.CheckerErrors()) != 0 { return fail(atLimit.CheckerErrors()[0].Msg) }
	return errsSay(checkSrc(typeChainSrc(maxTypeDepth - 1, false, false)),
			"type T0 nests too deeply: more than 1024 levels of types")
}

// The depth does not depend on the order of the declarations: the chain declared
// bottom first, with a pointer back to its top or not, is reported at T0 just the same.
func TestDeepTypeLimitReversed() testing.TestResult {
	for k := 0; k < 2; k++ {
		var atLimit @Checker = checkSrc(typeChainSrc(maxTypeDepth - 2, true, k == 1))
		if len(atLimit.CheckerErrors()) != 0 { return fail(atLimit.CheckerErrors()[0].Msg) }
		var r testing.TestResult = errsSay(checkSrc(typeChainSrc(maxTypeDepth - 1, true, k == 1)),
				"type T0 nests too deeply: more than 1024 levels of types")
		if len(r) != 0 { return r }
	}
	return ""
}

// A chain is reported each time it passes the limit, counting from where it was cut off
// the last time: T1077 of a chain of 2100 nests 1025 levels, and once its field is
// poisoned (two levels), T54 does.
func TestDeepTypeLimitTwice() testing.TestResult {
	var c @Checker = checkSrc(typeChainSrc(2100, false, false))
	return twoErrsSay(c, "type T1077 nests too deeply: more than 1024 levels of types",
			"type T54 nests too deeply: more than 1024 levels of types")
}

// A type cut off has its deep field poisoned with the error type, so the uses of it
// raise no further errors.
func TestDeepTypeCutNoFurtherErrors() testing.TestResult {
	var src @[]char = typeChainSrc(maxTypeDepth - 1, false, false)
	src = buf.Concat(src,
			"func get(t T0) int64 { return t.n.n.v }\n"
					"func first(t T0) T1 { return t.n }\n")
	return errsSay(checkSrc(src), "type T0 nests too deeply: more than 1024 levels of types")
}

// A ring of types each holding the next by value, longer than the limit, is reported
// as the recursive type it is, where the measure comes back round to it (V0), and
// broken there; what is left, a chain of 1100 types, is reported where it passes the
// limit (V75).
func TestDeepTypeByValueRing() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for i := 0; i < 1100; i++ {
		var next int = i + 1
		if i == 1099 { next = 0 }
		b.Write("type V")
		b.Write(strconv.Itoa(i))
		b.Write(" struct { n V")
		b.Write(strconv.Itoa(next))
		b.Write(" }\n")
	}
	return twoErrsSay(checkSrc(b.String()),
			"recursive type: a type cannot contain itself by value "
					"(hold the recursive field via a pointer -- *T or @T)",
			"type V75 nests too deeply: more than 1024 levels of types")
}

// A pointer from the bottom of a chain back to its top ends the chain there, but the
// types held by value still count: the chain nests as deeply as without it.
func TestDeepTypeLimitBackPointer() testing.TestResult {
	var atLimit @Checker = checkSrc(typeChainSrc(maxTypeDepth - 2, false, true))
	if len(atLimit.CheckerErrors()) != 0 { return fail(atLimit.CheckerErrors()[0].Msg) }
	return errsSay(checkSrc(typeChainSrc(maxTypeDepth - 1, false, true)),
			"type T0 nests too deeply: more than 1024 levels of types")
}

// A blank declaration's type is measured too, and reported as `_`: a struct holding a
// chain at the limit passes it.
func TestDeepTypeLimitBlank() testing.TestResult {
	var src @[]char = typeChainSrc(maxTypeDepth - 2, false, false)
	return errsSay(checkSrc(buf.Concat(src, "type _ struct { t T0 }\n")),
			"type _ nests too deeply: more than 1024 levels of types")
}

// nestedArraySrc returns a program declaring `type A = [1][1]...int`, n arrays deep.
func nestedArraySrc(n int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\ntype A = ")
	for i := 0; i < n; i++ {
		b.Write("[1]")
	}
	b.Write("int\n")
	return buf.CopyStr(b.String())
}

// The type an alias names is measured, and reported at the alias: 1023 arrays over int
// nest as deeply as a type may, and one more is reported.
func TestDeepTypeLimitAlias() testing.TestResult {
	var atLimit @Checker = checkSrc(nestedArraySrc(maxTypeDepth - 1))
	if len(atLimit.CheckerErrors()) != 0 { return fail(atLimit.CheckerErrors()[0].Msg) }
	return errsSay(checkSrc(nestedArraySrc(maxTypeDepth)),
			"type A nests too deeply: more than 1024 levels of types")
}

// A type forward-declared in the package's .bni is reported at its definition in the
// .bn: Box holds a chain at the limit.
func TestDeepTypeLimitBni() testing.TestResult {
	var c @Checker = NewChecker()
	var src @[]char = typeChainSrc(maxTypeDepth - 2, false, false)
	src = buf.Concat(src, "type Box struct { t T0 }\n")
	_, _ = checkBniPkgFiles(c, "package \"q\"\ntype Box\n", src, true)
	var r testing.TestResult = errsSay(c, "type Box nests too deeply: more than 1024 levels of types")
	if len(r) != 0 { return r }
	if !streq(c.CheckerErrors()[0].Pos.File, "q.bn") {
		return fail(buf.Concat("reported in ", c.CheckerErrors()[0].Pos.File))
	}
	return ""
}

// A group of declarations at the prompt, whose members are checked one by one (written
// bottom first, so none waits for a later one), reports a chain past the limit once.
func TestDeepTypeLimitRepl() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("type (\n")
	b.Write("T")
	b.Write(strconv.Itoa(maxTypeDepth - 1))
	b.Write(" struct { v int64 }\n")
	for i := maxTypeDepth - 2; i >= 0; i-- {
		b.Write("T")
		b.Write(strconv.Itoa(i))
		b.Write(" struct { n T")
		b.Write(strconv.Itoa(i + 1))
		b.Write(" }\n")
	}
	b.Write(")\n")
	var c @Checker = sessionChecker()
	replCheckDecl(c, b.String())
	return errsSay(c, "type T0 nests too deeply: more than 1024 levels of types")
}

// An interface nesting too deeply through its parents is cut off where it passes the
// limit: it drops the parent whose chain does, and keeps its own method, which a call
// uses with no further errors.
func TestDeepInterfaceCut() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	b.Write("interface I0 : I1 { m(x int) int }\n")
	for i := 1; i < maxTypeDepth; i++ {
		b.Write("interface I")
		b.Write(strconv.Itoa(i))
		b.Write(" : I")
		b.Write(strconv.Itoa(i + 1))
		b.Write(" {}\n")
	}
	b.Write("interface I")
	b.Write(strconv.Itoa(maxTypeDepth))
	b.Write(" {}\n")
	b.Write("func f(i @I0) int { return i.m(1) }\n")
	var c @Checker = checkSrcResolved(b.String())
	var r testing.TestResult = errsSay(c, "type I0 nests too deeply: more than 1024 levels of types")
	if len(r) != 0 { return r }
	var sym @Symbol = c.Scope.Lookup("I0")
	if sym == nil { return fail("I0 is declared") }
	var i0 @types.Type = sym.Type
	if len(i0.Parents) != 0 { return fail("the interface cut off drops its parent") }
	if len(i0.Methods) != 1 || isErrType(i0.Methods[0].FuncType.Results[0]) {
		return fail("the interface cut off keeps its own method as it is")
	}
	return ""
}

// ifaceSigChainSrc returns a program of interfaces I0 .. Ik, each but the last with a
// method returning the next as an interface value (three levels each), the last with
// a method of no parameters or results when last2 (two levels) or none (one), and a
// function calling I0's method.
func ifaceSigChainSrc(k int, last2 bool) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for i := 0; i < k; i++ {
		b.Write("interface I")
		b.Write(strconv.Itoa(i))
		b.Write(" { m() @I")
		b.Write(strconv.Itoa(i + 1))
		b.Write(" }\n")
	}
	b.Write("interface I")
	b.Write(strconv.Itoa(k))
	if last2 {
		b.Write(" { m() }\n")
	} else {
		b.Write(" {}\n")
	}
	b.Write("func f(i @I0) { var j @I1 = i.m(); _ = j }\n")
	return buf.CopyStr(b.String())
}

// Interfaces nesting through their method signatures: 341 of them over an empty one
// nest 1024 levels, the limit; over one with a method, 1025, and I0 is cut off where
// its chain passes it -- its method's result -- so a call of it raises no further
// errors.
func TestDeepInterfaceSignatureLimit() testing.TestResult {
	var atLimit @Checker = checkSrc(ifaceSigChainSrc(341, false))
	if len(atLimit.CheckerErrors()) != 0 { return fail(atLimit.CheckerErrors()[0].Msg) }
	var c @Checker = checkSrcResolved(ifaceSigChainSrc(341, true))
	var r testing.TestResult = errsSay(c, "type I0 nests too deeply: more than 1024 levels of types")
	if len(r) != 0 { return r }
	var sym @Symbol = c.Scope.Lookup("I0")
	if sym == nil { return fail("I0 is declared") }
	var ft @types.Type = sym.Type.Methods[0].FuncType
	if len(ft.Results) != 1 || !isErrType(ft.Results[0]) {
		return fail("the method's result, where the chain passes the limit, has the error type")
	}
	return ""
}
