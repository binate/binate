// Measuring a type's nesting depth (type.named.depth) with no recursion: the
// definitions a type reaches are grouped into cycles, from one explicit stack
// (measureFrom), and each cycle's definitions are measured, from a second explicit
// stack, once every cycle they reach has been (measureDefinition).
package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/table"

// isDefinition reports whether t is a definition: a named type or an interface, a type
// whose depth is measured on its own, and through one of which every cycle of types
// passes.
func isDefinition(t @types.Type) bool {
	return t.Kind == types.TYP_NAMED || t.Kind == types.TYP_INTERFACE
}

// cycleFrame is a definition measureFrom is finding the cycle of: the order it was met
// in; the earliest order of a definition whose cycle is still open that it reaches
// (Tarjan's lowlink); the definitions it refers to, w.refs from first to end, the one
// to look at next; and its place in w.open.
type cycleFrame struct {
	t     @types.Type
	order int
	low   int
	first int
	next  int
	end   int
	at    int
}

// measureFrom finds the depth of root and of each definition it reaches whose depth is
// not yet known.  It groups the definitions into cycles -- the strongly connected
// components of the graph of definitions, each referring to those its definition
// reaches (listRefs) -- by Tarjan's algorithm on w.finding, and measures each cycle once
// it is complete (closeCycle), which is after each cycle it reaches.  root is a
// definition, or any type checkTypeDepths measures, taken as a definition of its own.
func measureFrom(w @depthWalk, root @types.Type) {
	if root == nil || w.depths.Has(root) { return }
	var base int = w.finding.Len()
	pushCycleFrame(w, root)
	for w.finding.Len() > base {
		var top int = w.finding.Len() - 1
		var f cycleFrame = w.finding.Get(top)
		if f.next < f.end {
			var x @types.Type = w.refs.Get(f.next)
			f.next = f.next + 1
			w.finding.Set(top, f)
			if w.depths.Has(x) { continue }
			o, met := w.order.Get(x)
			if !met {
				pushCycleFrame(w, x)
			} else if o < f.low {
				// x is met, and its cycle is still open: it is on w.open.
				f.low = o
				w.finding.Set(top, f)
			}
			continue
		}
		_, _ = w.finding.Pop()
		for w.refs.Len() > f.first {
			_, _ = w.refs.Pop()
		}
		if f.low == f.order { closeCycle(w, f) }
		if w.finding.Len() > base {
			var up cycleFrame = w.finding.Get(w.finding.Len() - 1)
			if f.low < up.low {
				up.low = f.low
				w.finding.Set(w.finding.Len() - 1, up)
			}
		}
	}
}

// pushCycleFrame pushes a frame for definition t on w.finding, the definitions it
// refers to listed on w.refs, and t on w.open.
func pushCycleFrame(w @depthWalk, t @types.Type) {
	w.orders = w.orders + 1
	w.order.Put(t, w.orders)
	var f cycleFrame
	f.t = t
	f.order = w.orders
	f.low = w.orders
	f.first = w.refs.Len()
	listRefs(w, t)
	if t.Kind == types.TYP_NAMED && len(t.InstArgs) > 0 && t.Underlying == nil {
		w.metUnbuilt = true
	}
	f.next = f.first
	f.end = w.refs.Len()
	f.at = w.open.Len()
	w.open.Push(t)
	w.finding.Push(f)
}

// listRefs pushes on w.refs the definitions t's definition reaches whose depths are
// not yet known: its parts that are definitions, and those among the parts of its other
// parts, and theirs in turn.  It looks at each type once (w.listed holds the listing
// that looked at it last), so a type reached by many paths costs one step.
func listRefs(w @depthWalk, t @types.Type) {
	w.listings = w.listings + 1
	w.listed.Put(t, w.listings)
	pushParts(w, t)
	for w.parts.Len() > 0 {
		p, _ := w.parts.Pop()
		if p == nil || !isDefinition(p) && typePartCount(w, p) == 0 { continue }
		l, looked := w.listed.Get(p)
		if looked && l == w.listings { continue }
		w.listed.Put(p, w.listings)
		if w.depths.Has(p) { continue }
		if isDefinition(p) {
			w.refs.Push(p)
		} else {
			pushParts(w, p)
		}
	}
}

// pushParts pushes t's parts on w.parts, the last first.
func pushParts(w @depthWalk, t @types.Type) {
	for i := typePartCount(w, t) - 1; i >= 0; i-- {
		w.parts.Push(typePart(t, i))
	}
}

// closeCycle measures the cycle f's definition completes: the definitions on w.open
// from f's place, each first recorded in w.cycle as in it -- and each recorded in
// w.valueAcyclic if the measure met no by-value cycle among them.  The measure goes by
// value from each of them to every type of the cycle it holds by value, so it meets
// each such cycle, as a type it is still inside (partDepth).
func closeCycle(w @depthWalk, f cycleFrame) {
	for i := f.at; i < w.open.Len(); i++ {
		w.cycle.Put(w.open.Get(i), f.order)
	}
	w.cur = f.order
	w.cycleVal = nil
	w.cycleRef = nil
	w.metByValue = false
	for i := f.at; i < w.open.Len(); i++ {
		var t @types.Type = w.open.Get(i)
		if !w.depths.Has(t) { measureDefinition(w, t) }
	}
	if !w.metByValue {
		for i := f.at; i < w.open.Len(); i++ {
			w.valueAcyclic.Put(w.open.Get(i), true)
		}
	}
	for w.open.Len() > f.at {
		_, _ = w.open.Pop()
	}
}

// measureFrame is a type measureDefinition is finding the depth of: whether the chain
// to it from the definition it is in has gone through a reference (partIsReference);
// whether it is that definition; the index of its part to look at next, and the
// deepest of its parts so far; and whether its depth holds within the cycle being
// measured only (it reaches a definition in the cycle).
type measureFrame struct {
	t       @types.Type
	ref     bool
	root    bool
	next    int
	deepest int
	tied    bool
}

// measureDefinition finds the depth of t, a definition in the cycle being measured
// (w.cur), with no recursion: post-order from w.measuring, each type's parts' depths
// before its own.  A type's depth is the number of types in its longest chain of
// parts, each a part of the one before (typePart), a named type and an alias counting
// as the type they stand for (ownLevel).  A chain from a definition counts the depth
// of each definition it reaches, but ends at one in the definition's cycle that it
// reaches through a reference (partIsReference); one in the cycle reached by value is
// measured first, unless the chain is inside it, a by-value cycle, which ends it (and
// is reported by checkTypeByValueCycle).  A definition past maxTypeDepth is reported
// and cut off if declared (tooDeep).
func measureDefinition(w @depthWalk, t @types.Type) {
	var pathVal typePath
	var pathRef typePath
	var base int = w.measuring.Len()
	pushMeasure(w, t, false, true, &pathVal, &pathRef)
	for w.measuring.Len() > base {
		var top int = w.measuring.Len() - 1
		var f measureFrame = w.measuring.Get(top)
		if f.next < typePartCount(w, f.t) {
			var part @types.Type = typePart(f.t, f.next)
			var ref bool = f.ref || partIsReference(f.t, f.next)
			f.next = f.next + 1
			pd, tied := partDepth(w, part, ref, &pathVal, &pathRef)
			if tied { f.tied = true }
			if pd > f.deepest { f.deepest = pd }
			w.measuring.Set(top, f)
			if pd < 0 { pushMeasure(w, part, ref, isDefinition(part), &pathVal, &pathRef) }
			continue
		}
		_, _ = w.measuring.Pop()
		var d int = f.deepest + ownLevel(w, f.t)
		if f.root {
			pathVal.pop()
			if d > maxTypeDepth && isDefinition(f.t) { d = tooDeep(w, f.t, d) }
			w.depths.Put(f.t, d)
		} else {
			if f.ref {
				pathRef.pop()
			} else {
				pathVal.pop()
			}
			if f.tied {
				cycleDepths(w, f.ref).Put(f.t, d)
			} else {
				w.depths.Put(f.t, d)
			}
		}
		if w.measuring.Len() > base {
			var up measureFrame = w.measuring.Get(w.measuring.Len() - 1)
			if d > up.deepest { up.deepest = d }
			if f.tied || f.root { up.tied = true }
			w.measuring.Set(w.measuring.Len() - 1, up)
		}
	}
}

// pushMeasure pushes a frame for t on w.measuring -- reached through a reference when
// ref, and a definition measured on its own when root (which is reached by value) --
// and t on the path it is on (pathRef or pathVal).
func pushMeasure(w @depthWalk, t @types.Type, ref bool, root bool, pathVal *typePath,
		pathRef *typePath) {
	var f measureFrame
	f.t = t
	f.ref = ref
	f.root = root
	w.measuring.Push(f)
	if ref {
		pathRef.push(t)
	} else {
		pathVal.push(t)
	}
}

// partDepth returns the depth part adds to a chain in the definition being measured
// that reaches it, through a reference when ref, and whether that depth holds within
// the cycle being measured (w.cur) only; a depth of -1 when part is to be measured
// first (pushMeasure).
func partDepth(w @depthWalk, part @types.Type, ref bool, pathVal *typePath,
		pathRef *typePath) (int, bool) {
	if part == nil { return 0, false }
	d, known := w.depths.Get(part)
	if isDefinition(part) {
		cyc, _ := w.cycle.Get(part)
		if cyc != w.cur {
			// Its cycle is complete, so it was measured with it (closeCycle).
			if !known { panic("internal error: a type's depth is read before it is measured") }
			return d, false
		}
		if ref { return 0, true }
		if pathVal.has(part) {
			w.metByValue = true
			breakByValueCycle(w, part)
			return 0, true
		}
		if known { return d, true }
		return -1, true
	}
	if known { return d, false }
	inCycle := w.cycleVal
	if ref { inCycle = w.cycleRef }
	if inCycle != nil {
		d, known = inCycle.Get(part)
		if known { return d, true }
	}
	if typePartCount(w, part) == 0 { return ownLevel(w, part), false }
	if ref && pathRef.has(part) { return 0, true }
	if !ref && pathVal.has(part) {
		w.metByValue = true
		return 0, true
	}
	return -1, false
}

// breakByValueCycle reports the by-value cycle a measure has come back round to
// definition t on, and breaks it (checkTypeByValueCycle), unless t is not a named type
// declared here or that is done already.  A type containing itself by value has no
// depth, and the cycle is reported as what it is rather than as a type nesting too
// deeply; the chains that go round it are measured as ending where it closes.
func breakByValueCycle(w @depthWalk, t @types.Type) {
	if w.broken.Has(t) { return }
	w.broken.Put(t, 0)
	idx, isDeclared := w.declared.Get(t)
	if !isDeclared { return }
	var d @ast.Decl = w.decls.Get(idx)
	if d.Kind == ast.DECL_TYPE && !d.IsAlias && !isBlank(d.Name) { checkTypeByValueCycle(w.c, t, d) }
}

// knownDepth returns the depth of t, a part of the definition just measured, reached
// through a reference when ref: as partDepth found it.
func knownDepth(w @depthWalk, t @types.Type, ref bool) int {
	if t == nil { return 0 }
	if isDefinition(t) && ref {
		cyc, _ := w.cycle.Get(t)
		if cyc == w.cur { return 0 }
	}
	d, known := w.depths.Get(t)
	if known { return d }
	inCycle := w.cycleVal
	if ref { inCycle = w.cycleRef }
	if inCycle != nil {
		d, known = inCycle.Get(t)
		if known { return d }
	}
	if typePartCount(w, t) == 0 { return ownLevel(w, t) }
	return 0
}

// cycleDepths returns the table of the depths that hold within the cycle being
// measured only, of the types reached through a reference when ref, making it on first
// use.
func cycleDepths(w @depthWalk,
		ref bool) @table.Table[@types.Type, int, typeIdentityHasher, typeIdentityEq] {
	if ref {
		if w.cycleRef == nil { w.cycleRef = newTypeDepthTable() }
		return w.cycleRef
	}
	if w.cycleVal == nil { w.cycleVal = newTypeDepthTable() }
	return w.cycleVal
}

// ownLevel is the level t adds to the depth of a chain through it: none for a named
// type or an alias, which count as the type they stand for, unless the named type has
// no underlying type to stand for here (underlyingHidden); one for any other.
func ownLevel(w @depthWalk, t @types.Type) int {
	if t.Kind == types.TYP_NAMED && !underlyingHidden(w, t) || t.Kind == types.TYP_ALIAS { return 0 }
	return 1
}

// underlyingHidden reports whether t, a named type, shows no underlying type here: it
// has none (a type declared `type T` and defined nowhere seen), or it is an opaque type
// outside the package that defines it (opaqueExportHiddenHere), whatever the checker
// has seen of its definition.  It is then measured as a type of its own, with no parts.
func underlyingHidden(w @depthWalk, t @types.Type) bool {
	return t.Underlying == nil || opaqueExportHiddenHere(w.c, t)
}

// typePartCount returns how many parts t has (typePart).
func typePartCount(w @depthWalk, t @types.Type) int {
	if t.Kind == types.TYP_NAMED {
		if underlyingHidden(w, t) { return 0 }
		return 1 + len(t.InstArgs)
	}
	if t.Kind == types.TYP_ALIAS { return 1 }
	var n int = len(t.Fields) + len(t.Params) + len(t.Results) + len(t.InstArgs)
	if t.Elem != nil { n = n + 1 }
	if t.Kind == types.TYP_INTERFACE { n = n + len(t.Methods) + len(t.Parents) }
	return n
}

// typePart returns part i of t, for i below typePartCount(w, t): a named type's
// underlying type, then its type arguments; an alias's target; for any other type its
// element, fields, parameters, results and type arguments, and an interface's method
// signatures and parents.
func typePart(t @types.Type, i int) @types.Type {
	if t.Kind == types.TYP_NAMED {
		if i == 0 { return t.Underlying }
		return t.InstArgs[i - 1]
	}
	if t.Kind == types.TYP_ALIAS { return t.Target }
	if t.Elem != nil {
		if i == 0 { return t.Elem }
		i = i - 1
	}
	if i < len(t.Fields) { return t.Fields[i].Type }
	i = i - len(t.Fields)
	if i < len(t.Params) { return t.Params[i].Type }
	i = i - len(t.Params)
	if i < len(t.Results) { return t.Results[i] }
	i = i - len(t.Results)
	if i < len(t.InstArgs) { return t.InstArgs[i] }
	i = i - len(t.InstArgs)
	if i < len(t.Methods) {
		var m @types.Method = t.Methods[i]
		if m == nil { return nil }
		return m.FuncType
	}
	return t.Parents[i - len(t.Methods)]
}

// partIsReference reports whether t refers to its part i (typePart) rather than holding
// it by value: a pointer's, slice's or interface value's element, a parameter or a
// result, a type argument, or an interface's method signature or parent.  A named
// type's underlying type, an alias's target, an array's or a readonly type's element
// and a struct's fields are held by value.
func partIsReference(t @types.Type, i int) bool {
	if t.Kind == types.TYP_NAMED { return i > 0 }
	if t.Kind == types.TYP_ALIAS { return false }
	if t.Elem != nil {
		if i == 0 {
			return t.Kind != types.TYP_ARRAY && t.Kind != types.TYP_READONLY &&
					t.Kind != types.TYP_UNTYPED_STRING
		}
		i = i - 1
	}
	return i >= len(t.Fields)
}
