package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for check_type_depth_walk.bn: a type's nesting depth, as measureFrom finds it.

// depthOf returns t's nesting depth, measured with nothing declared to report.
func depthOf(t @types.Type) int {
	var w @depthWalk = newDepthWalk(NewChecker())
	measureFrom(w, t)
	d, _ := w.depths.Get(t)
	return d
}

// declDepth returns the nesting depth of the type c's program (checked by
// checkSrcResolved) declares as name, or -1 if it declares none.
func declDepth(c @Checker, name *[]readonly char) int {
	var sym @Symbol = c.Scope.Lookup(name)
	if sym == nil || sym.Type == nil { return -1 }
	return depthOf(sym.Type)
}

// depthIs returns "" if the type c's program declares as name nests want levels, or a
// failure naming the depth found (-1 for no such type) and why want is expected.
func depthIs(c @Checker, name *[]readonly char, want int, why *[]readonly char) testing.TestResult {
	var got int = declDepth(c, name)
	if got == want { return "" }
	var msg @[]char = buf.Concat(name, ": ")
	msg = buf.Concat(msg, buf.Concat(strconv.Itoa(got), " levels; want "))
	msg = buf.Concat(msg, buf.Concat(strconv.Itoa(want), ": "))
	return fail(buf.Concat(msg, why))
}

// oneFieldStruct returns struct { f t }.
func oneFieldStruct(t @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Name = "f"
	fs[0].Type = t
	return types.MakeStructType("", fs)
}

// Every type a chain passes through counts one, but a named type and an alias count as
// the type they stand for.
func TestTypeDepthCounts() testing.TestResult {
	if depthOf(types.TypInt()) != 1 { return fail("int is one level") }
	if depthOf(types.MakePointerType(types.TypInt())) != 2 { return fail("*int is two levels") }
	var s @types.Type = oneFieldStruct(types.MakePointerType(types.TypInt()))
	if depthOf(s) != 3 { return fail("struct { f *int } is three levels") }
	var named @types.Type = types.MakeNamedType("main.N")
	named.Underlying = s
	if depthOf(named) != 3 { return fail("a named type counts as its underlying type") }
	if depthOf(types.MakeAliasType("main.A", named)) != 3 {
		return fail("an alias counts as the type it denotes")
	}
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	ps[0] = make(types.Param)
	ps[0].Type = s
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypBool()
	if depthOf(types.MakeFuncValueType(ps, rs)) != 4 { return fail("a parameter is a part") }
	var opaque @types.Type = types.MakeNamedType("main.O")
	if depthOf(types.MakePointerType(opaque)) != 2 {
		return fail("a named type with no underlying type seen is one level")
	}
	return ""
}

// A chain ends where it comes back, through a reference, to the definition it is in: a
// linked list's node nests two levels, its struct and the pointer to the node.
func TestTypeDepthCycle() testing.TestResult {
	var node @types.Type = types.MakeNamedType("main.Node")
	var next @types.Type = make(types.Type)
	next.Kind = types.TYP_POINTER
	next.Elem = node
	node.Underlying = oneFieldStruct(next)
	var d int = depthOf(node)
	node.Underlying = nil
	if d != 2 { return fail("a node holding a pointer to itself nests two levels") }
	return ""
}

// A type reached by many paths is looked at once: forty levels of a struct holding the
// level below twice (2^40 paths) are measured at once.
func TestTypeDepthShared() testing.TestResult {
	if depthOf(sharedStructs(40, types.TypInt())) != 41 {
		return fail("forty shared structs over int nest 41 levels")
	}
	return ""
}

// referenceSrc returns TestTypeDepthReferenceIntoCycle's program, its declarations in
// the reverse order when reversed.
func referenceSrc(reversed bool) @[]char {
	var decls [8]*[]readonly char
	decls[0] = "type Node struct { f *func(Node) }\n"
	decls[1] = "type H struct { g *func(Node) }\n"
	decls[2] = "type L struct { next *L }\n"
	decls[3] = "type M struct { l *L }\n"
	decls[4] = "type A struct { b B }\n"
	decls[5] = "type B struct { p *A }\n"
	decls[6] = "type Box[T any] struct { p *T }\n"
	decls[7] = "type N struct { b Box[N] }\n"
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for k := 0; k < len(decls); k++ {
		var i int = k
		if reversed { i = len(decls) - 1 - k }
		b.Write(decls[i])
	}
	return buf.CopyStr(b.String())
}

// A reference ends a chain only into the cycle of the definition it is in: from outside
// the cycle, the chain goes on through it -- the same type (a cached `*L`) or one
// spelled again (`*func(Node)`) alike -- and a type in the cycle held by value counts
// in full, whatever order the types are declared in.
func TestTypeDepthReferenceIntoCycle() testing.TestResult {
	for k := 0; k < 2; k++ {
		var c @Checker = checkSrcResolved(referenceSrc(k == 1))
		if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
		var r testing.TestResult = depthIs(c, "Node", 2, "its struct and the function value")
		if len(r) == 0 { r = depthIs(c, "H", 4, "its struct, the function value and Node") }
		if len(r) == 0 { r = depthIs(c, "L", 2, "its struct and the pointer") }
		if len(r) == 0 { r = depthIs(c, "M", 4, "its struct, the pointer and L") }
		if len(r) == 0 { r = depthIs(c, "B", 2, "its struct and the pointer") }
		if len(r) == 0 { r = depthIs(c, "A", 3, "its struct and B, held by value") }
		if len(r) == 0 {
			r = depthIs(c, "N", 3, "its struct and Box[N]'s, and the pointer; the type argument ends there")
		}
		if len(r) != 0 { return r }
	}
	return ""
}

// A ring of types, each referring to the next through a pointer, nests two levels
// however long it is: 1025 types, which would nest 2050 levels were the pointers
// followed round.
func TestDeepTypeRing() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\n")
	for i := 0; i <= maxTypeDepth; i++ {
		var next int = i + 1
		if i == maxTypeDepth { next = 0 }
		b.Write("type R")
		b.Write(strconv.Itoa(i))
		b.Write(" struct { p *R")
		b.Write(strconv.Itoa(next))
		b.Write(" }\n")
	}
	var c @Checker = checkSrcResolved(b.String())
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var r testing.TestResult = depthIs(c, "R0", 2, "a ring of types nests two levels")
	if len(r) == 0 { r = depthIs(c, "R512", 2, "a ring of types nests two levels") }
	if len(r) == 0 { r = depthIs(c, "R1024", 2, "a ring of types nests two levels") }
	return r
}
