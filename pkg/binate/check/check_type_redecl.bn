package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// Enforcement of the no-full-redeclaration rule: a
// type may be declared full at most once per package.  Kept separate from
// the resolution machinery in check_decl.bn precisely because it must NOT
// participate in that machinery's multi-pass re-processing of the same
// decl — it counts source declarations instead.  Invoked from collectDecls
// (check_decl.bn) before pass-1 collection.

// checkTypeRedeclaration enforces that a type is declared FULL at most
// once per package.  The legal shapes for a type name are: full in the
// .bni only (transparent), a forward decl (`type T`) in the .bni plus a
// full decl in one .bn (opaque), or a full decl in one .bn with no .bni
// (package-private).  A full decl in both the .bni and a .bn, or two full
// decls across the .bn files, is rejected -- wherever they are, a `type ( … )`
// group's members included.
//
// It counts source DECL_TYPE objects (one per `type T` in the source), so
// — unlike collectTypeDecl — it is not fooled by the resolution machinery
// re-processing the same decl (the loader's .bni merge-prepend re-seen by
// collectTypeDecl, or resolveBuiltinScalarTypeDecls pre-filling a distinct-
// scalar placeholder).  Forward decls are not "full" and never count.
// Generic type decls ARE covered — counting decl objects works the same
// for them (a transparent generic appears once in the merged list; a
// full-in-both appears twice), so a generic redeclaration is rejected just
// like a non-generic one (conformance/794).  FromBNI (set by the loader)
// is used only to phrase the diagnostic and point at the .bn decl, which
// is the one to remove.
func checkTypeRedeclaration(c @Checker, decls *[]@ast.Decl) {
	var forward @table.Table[*[]readonly char, bool, ScopeNameHasher, ScopeNameEq] = table.NewTable[
			*[]readonly char, bool, ScopeNameHasher, ScopeNameEq](ScopeNameHasher{}, ScopeNameEq{})
	collectForwardTypeNames(decls, forward)
	var sites @vec.Vec[typeDeclSite] = vec.New[typeDeclSite]()
	collectFullTypeDecls(c, forward, decls, false, sites)
	// The first site of each name, by name: a site is compared with it.
	var firstOfName @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq] = table.NewTable[
			*[]readonly char, int, ScopeNameHasher, ScopeNameEq](ScopeNameHasher{}, ScopeNameEq{})
	for i := 0; i < sites.Len(); i++ {
		var si typeDeclSite = sites.Get(i)
		j, found := firstOfName.Get(si.d.Name)
		if !found { firstOfName.Put(si.d.Name, i) }
		if !si.compared || !found { continue }
		var sj typeDeclSite = sites.Get(j)
		// Both are full decls of the same name: a redecl.  Point at the .bn
		// decl (the one to remove); at most one of a .bni/.bn pair is from
		// the .bni.
		var at @ast.Decl = si.d
		if si.fromBni && !sj.fromBni {
			at = sj.d
		}
		addCheckError(c, at.Pos, redeclTypeMsg(si.d.Name, si.fromBni != sj.fromBni))
	}
}

// typeDeclSite is a full type declaration of the package, in source order, with
// its origin: a group member is from the .bni when its group is, which the
// loader tags only at the top level.  compared is false for one that has drawn
// a forward-declaration error, which is not reported again as a redecl (an
// earlier such declaration still counts against a later one).
type typeDeclSite struct {
	d        @ast.Decl
	fromBni  bool
	compared bool
}

// collectFullTypeDecls appends the full type declarations in decls to sites,
// the members of every `type ( … )` group included, so a declaration is compared
// with every earlier one in the package, not only those of its own group; and it
// reports an alias or a generic type declaring a forward-declared name (one of
// forward, the package's: collectForwardTypeNames).  groupFromBni carries an
// enclosing group's FromBNI down to its members.
func collectFullTypeDecls(c @Checker,
		forward @table.Table[*[]readonly char, bool, ScopeNameHasher, ScopeNameEq], decls *[]@ast.Decl,
		groupFromBni bool, sites @vec.Vec[typeDeclSite]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			collectFullTypeDecls(c, forward, d.Decls, groupFromBni || d.FromBNI, sites)
			continue
		}
		if !isFullTypeDecl(d) {
			continue
		}
		var site typeDeclSite
		site.d = d
		site.fromBni = d.FromBNI || groupFromBni
		site.compared = true
		if d.IsAlias && forward.Has(d.Name) {
			addCheckError(c, d.Pos, forwardAliasMsg(d.Name))
			site.compared = false
		} else if len(d.TypeParams) > 0 && forward.Has(d.Name) {
			addCheckError(c, d.Pos, forwardGenericMsg(d.Name))
			site.compared = false
		}
		sites.Push(site)
	}
}

// isFullTypeDecl reports whether d fully defines a type (struct, alias,
// distinct, or generic) — as opposed to a forward decl (`type T`), which
// declares only a name and does not count as a "full" declaration for the
// no-redeclaration rule.  A blank `type _ …` defines no type (it binds no
// name), so any number of them may appear.
func isFullTypeDecl(d @ast.Decl) bool {
	return d.Kind == ast.DECL_TYPE && !d.IsForward && !isBlank(d.Name)
}

// redeclTypeMsg phrases the redeclaration error.  bniAndBn distinguishes
// the full-in-both case (one decl from the .bni, one from a .bn) from a
// plain .bn-side duplicate, pointing the user at the right fix.
func redeclTypeMsg(name @[]char, bniAndBn bool) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("duplicate type definition: ")
	cb.Write(name)
	if bniAndBn {
		cb.Write(
				" (declared in full in both the .bni and a .bn; define in"
						" .bni OR .bn, not both; use `type ")
		cb.Write(name)
		cb.Write("` forward-decl in the .bni for opaque export)")
	} else {
		cb.Write(" (a type may be declared in full only once per package)")
	}
	return buf.CopyStr(cb.String())
}

// Type-declaration collection: resolving a `type` decl (alias / struct /
// named-distinct) into a Type and defining it, plus the cyclic-underlying
// guard.  Split out of check_decl.bn to keep it under the file-length limit.

// collectTypeDecl resolves a type declaration (alias, struct, or named) and defines it in scope.
// Generic decls are skipped — their struct bodies stay AST-form
// in c.Generics.TypeDecls until an instantiation site resolves them
// with the type-param scope installed.
// namedTypeDefIsCyclic reports whether following `start`'s named-distinct
// Underlying chain (alias and readonly wrappers peeled) loops: back to `start`
// (`type A B; type B A`, `type A A`) or into any other loop.  Such a type has no
// well-defined underlying; the definition is rejected and the cycle broken at the
// call site, so the operand-comparability walks (comparabilityKind / IsInteger / …)
// can't hang `==` / stack-overflow `<` on a parseable-but-malformed input.  It
// follows the types themselves, not their names -- a type named after another
// package's (`type T p.T`) is no cycle -- and a chain of any length that ends is
// none either (chainGuard).
func namedTypeDefIsCyclic(start @types.Type) bool {
	if start == nil || start.Underlying == nil {
		return false
	}
	var g chainGuard = newChainGuard(start)
	var t @types.Type = types.ResolveAliasAndConst(start.Underlying)
	for t != nil {
		if chainCloses(&g, t) { return true }
		if t.Kind != types.TYP_NAMED || t.Underlying == nil { return false }
		t = types.ResolveAliasAndConst(t.Underlying)
	}
	return false
}

// chainGuard finds a loop in a walk down a chain of types taken one step at a time,
// with no bound on the chain's length (Brent's method).  Start it at a type of the walk
// (newChainGuard) and pass it each type the walk steps to after that (chainCloses).
// mark is the address of the type a loop would return to -- a raw address, since the
// walk holds every type it compares -- and after power steps it moves to the walk's
// current type and power doubles, so a loop of any length is found within a few laps
// of it, and a chain that ends is never taken for one.
type chainGuard struct {
	mark  *uint8
	steps int
	power int
}

// newChainGuard starts a chainGuard for a walk from start.
func newChainGuard(start @types.Type) chainGuard {
	var g chainGuard
	g.mark = bit_cast(*uint8, start)
	g.power = 1
	return g
}

// chainCloses reports whether t, the type a guarded walk has just stepped to, closes
// a loop.
func chainCloses(g *chainGuard, t @types.Type) bool {
	if bit_cast(*uint8, t) == g.mark { return true }
	g.steps = g.steps + 1
	if g.steps == g.power {
		g.mark = bit_cast(*uint8, t)
		g.power = g.power * 2
		g.steps = 0
	}
	return false
}

// charSliceEq compares two @[]char by length + byte content.  Local
// because the obvious helpers live in other packages.
func charSliceEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// peelToLayout returns the type whose layout t has: t with alias, readonly and
// named wrappers removed (nil when a named type in the chain is not filled in,
// or the chain is cyclic, which errCyclicType reports).
func peelToLayout(t @types.Type) @types.Type {
	var g chainGuard = newChainGuard(t)
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED {
			t = t.Underlying
		} else {
			return t
		}
		if t != nil && chainCloses(&g, t) { return nil }
	}
	return nil
}

// checkTypeByValueCycle rejects a named type whose underlying STRUCT or ARRAY
// contains ITSELF by value — a cycle with no finite layout (`type C struct { self C }`,
// `type C struct { items [2]C }`, `type C [2]C`, or through a named-distinct wrapper
// `type C struct { d D }; type D C`) — which would otherwise infinite-loop the size /
// destruction / ABI walks that recurse through by-value fields/elements (a SIGSEGV
// at compile time, or a bogus finite `sizeof`).  Reports a clean error and POISONS
// the offending field / element to void, breaking the cycle so those walks
// terminate.  A cycle through a pointer (`@C` / `*C`) is a valid recursive type and
// is left untouched.  A named type declared over another named type or a generic
// instantiation (`type Wrap Bad[int32]`) is checked through that type's struct or
// array.  Runs post-collection for each declaration (checkValueEmbedding) not found
// in no by-value cycle by the depth walk, when
// every named underlying is filled, so the check is decl-order-independent; each
// generic struct instantiation is also checked as it is populated, where a cycle
// through a declaration not yet filled in is left to that declaration's own check.
// The walks stop at the named types found to hold no by-value cycle (valueAcyclicOf),
// and keep each they find so, named itself included, so the declarations of a chain
// of types held by value are each checked to the next, in any order.
func checkTypeByValueCycle(c @Checker, named @types.Type, d @ast.Decl) {
	if named == nil {
		return
	}
	var kept @valueAcyclicKept = valueAcyclicOf(c)
	if kept.types.Has(named) {
		return
	}
	var st @types.Type = peelToLayout(named.Underlying)
	if st == nil {
		return
	}
	var clean bool = true
	if st.Kind == types.TYP_STRUCT {
		for i := 0; i < len(st.Fields); i++ {
			// A fresh set per field: a walk that reaches named stops there,
			// leaving the types on its path entered, and a later field reaching
			// named through one of them would not be found (or poisoned).
			var visited typeVisits
			if reachesNamedKept(st.Fields[i].Type, named, &visited, kept.types, &clean) {
				addKeptError(c, d.Pos, "recursive type: a type cannot contain itself by value "
						"(hold the recursive field via a pointer -- *T or @T)")
				st.Fields[i].Type = types.TypVoid()
				noteTypeGraphChanged(c)
			}
		}
	} else if st.Kind == types.TYP_ARRAY {
		var visited typeVisits
		if reachesNamedKept(st.Elem, named, &visited, kept.types, &clean) {
			addKeptError(c, d.Pos, "recursive type: a type cannot contain itself by value "
					"(hold the recursive element via a pointer -- *T or @T)")
			st.Elem = types.TypVoid()
			noteTypeGraphChanged(c)
		}
	} else {
		return
	}
	if clean { kept.types.Put(named, true) }
}

// collectForwardTypeNames puts into forward the names decls declare forward, `type
// name` (the .bni's, before the .bn's definition), groups included.  A bodiless
// generic `type name[T any]` is not one: it is a generic type missing its
// definition, which is reported as such (errGenericTypeNeedsDefinition).  The keys
// borrow the declarations' names.
func collectForwardTypeNames(decls *[]@ast.Decl,
		forward @table.Table[*[]readonly char, bool, ScopeNameHasher, ScopeNameEq]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP { collectForwardTypeNames(d.Decls, forward) }
		if d.Kind == ast.DECL_TYPE && d.IsForward && len(d.TypeParams) == 0 {
			forward.Put(d.Name, true)
		}
	}
}

// forwardAliasMsg is the error for an alias declaring a forward-declared type:
// its full definition declares it as a named type (§7.12
// type.opaque.alias-rejection), and an alias would make the name another name
// for its target instead.
func forwardAliasMsg(name *[]readonly char) @[]char {
	return buf.Concat(buf.Concat("type ", name),
			" is forward-declared; its definition cannot be an alias")
}

// forwardGenericMsg is the error for a name declared both as a forward type
// declaration and as a generic type, in either order: a generic type has no
// forward declaration (§12 gen.decl.definition), so a `type T` names a
// non-generic type.
func forwardGenericMsg(name *[]readonly char) @[]char {
	return buf.Concat(buf.Concat("type ", name),
			" is forward-declared and generic; a generic type has no forward declaration")
}

// isForwardDeclaredType reports whether sym is a named type whose underlying no
// definition has filled yet.  The checker also registers every declared type
// name this way before collecting it, and a generic type's name stays so, so it
// identifies a forward declaration (`type T`) only at the REPL prompt, among the
// earlier prompts' complete declarations, and with generics excluded
// (isSessionForwardType).
func isForwardDeclaredType(sym @Symbol) bool {
	return sym != nil && sym.Kind == types.SYM_TYPE && sym.Type != nil &&
			sym.Type.Kind == types.TYP_NAMED && sym.Type.Underlying == nil
}
