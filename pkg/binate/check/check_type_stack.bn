// The work list the checker's walks over a type's parts take types from, and the path
// of named types a walk is inside: a walk pushes a type's parts and pops them in turn
// instead of recursing on them, so a type nested to any depth is walked.
package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/table"
import "pkg/std/vec"

// typeWalk holds the types the walks over a type's parts have still to look at, the
// next one last, kept from one walk to the next.  A walk starts at its base
// (typeWalkBase), pushes and pops above it, and leaves it as it found it (typeWalkEnd
// when it stops early), so one walk may run inside another.  A walk pushes a type's
// parts last first, so it looks at them in order, each one's own parts before the
// next: the order a recursive walk takes.
var typeWalk @vec.Vec[@types.Type]

// typeWalkBase returns the base a new walk starts at: typeWalk's length.
func typeWalkBase() int {
	if typeWalk == nil { typeWalk = vec.New[@types.Type]() }
	return typeWalk.Len()
}

// typeWalkPush pushes t for the walk to look at next.
func typeWalkPush(t @types.Type) {
	typeWalk.Push(t)
}

// typeWalkMore reports whether the walk started at base has types left to look at.
func typeWalkMore(base int) bool {
	return typeWalk.Len() > base
}

// typeWalkPop returns the next type for the walk to look at.
func typeWalkPop() @types.Type {
	t, _ := typeWalk.Pop()
	return t
}

// typeWalkEnd drops the types the walk started at base has left, for a walk that stops
// early.
func typeWalkEnd(base int) {
	for typeWalk.Len() > base {
		_, _ = typeWalk.Pop()
	}
}

// typeHasNoParts reports whether t is built from no other type -- it has no element,
// type arguments, fields, parameters or results -- so a walk over its parts has none.
func typeHasNoParts(t @types.Type) bool {
	return t.Elem == nil && len(t.InstArgs) == 0 && len(t.Fields) == 0 && len(t.Params) == 0 &&
			len(t.Results) == 0
}

// lateVisitFrom is how many types a walk with no answer that depends on its visited
// set takes before it starts one (containsDependentArray, AggregateComparable,
// typeMentionsNamed): a small type -- the common case -- is walked with no visited set
// to make, and a cyclic or widely shared one is still walked to its end, each type
// entered once from then on.
const lateVisitFrom int = 32

// pushFieldTypes pushes struct t's field types, last first.
func pushFieldTypes(t @types.Type) {
	for i := len(t.Fields) - 1; i >= 0; i-- {
		typeWalkPush(t.Fields[i].Type)
	}
}

// pushSignatureTypes pushes function type t's parameter and result types, results
// first, so the parameters are looked at first, in order, then the results.
func pushSignatureTypes(t @types.Type) {
	for i := len(t.Results) - 1; i >= 0; i-- {
		typeWalkPush(t.Results[i])
	}
	for i := len(t.Params) - 1; i >= 0; i-- {
		typeWalkPush(t.Params[i].Type)
	}
}

// pushInstArgs pushes t's type arguments, last first.
func pushInstArgs(t @types.Type) {
	for i := len(t.InstArgs) - 1; i >= 0; i-- {
		typeWalkPush(t.InstArgs[i])
	}
}

// typePath is the named types a walk is inside, innermost last.  Past
// typeVisitsScanned types it indexes them by identity, as typeVisits does, so a walk
// inside n of them takes time linear in n to test whether a type is one.  The zero
// value is empty.
type typePath struct {
	inside @vec.Vec[@types.Type]
	index  @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
}

// has reports whether t is on p.
func (p *typePath) has(t @types.Type) bool {
	if p.index != nil { return p.index.Has(t) }
	if p.inside == nil { return false }
	for i := 0; i < p.inside.Len(); i++ {
		if same(p.inside.Get(i), t) { return true }
	}
	return false
}

// push puts t, which is not on p, on p.
func (p *typePath) push(t @types.Type) {
	if p.inside == nil { p.inside = vec.New[@types.Type]() }
	p.inside.Push(t)
	if p.index != nil {
		p.index.Put(t, true)
	} else if p.inside.Len() > typeVisitsScanned {
		p.index = newTypeSet()
		for i := 0; i < p.inside.Len(); i++ {
			p.index.Put(p.inside.Get(i), true)
		}
	}
}

// pop takes the innermost type off p.
func (p *typePath) pop() {
	t, _ := p.inside.Pop()
	if p.index != nil { _ = p.index.Remove(t) }
}
