package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for check_type_stack.bn -- the type work list and typePath -- and for the walks
// that take their parts from them, on types nested deepLevels deep: far deeper than a
// walk with one stack frame per level could go.  The deep tests release their types a
// link at a time, as spec §18.2's note says to, and are skipped on the bare-metal and
// double-VM unit-test lanes (scripts/unittest/*.skip.*).

// deepLevels is how deep the deep tests nest a type.
const deepLevels int = 200000

// ptrChain returns n pointer types over leaf, each built apart (MakePointerType keeps
// one pointer type per element type, on the element).
func ptrChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		var w @types.Type = make(types.Type)
		w.Kind = types.TYP_POINTER
		w.Elem = t
		t = w
	}
	return t
}

// structChain returns n anonymous structs over leaf: struct { f struct { f ... leaf } }.
func structChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		var fs @[]@types.Field = make_slice(@types.Field, 1)
		fs[0] = make(types.Field)
		fs[0].Name = "f"
		fs[0].Type = t
		t = types.MakeStructType("", fs)
	}
	return t
}

// namedChain returns n named types over leaf, each one's underlying the next.
func namedChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		var named @types.Type = types.MakeNamedType("main.N")
		named.Underlying = t
		t = named
	}
	return t
}

// innermost returns the innermost of the n links of a chain t built by ptrChain,
// structChain or namedChain.
func innermost(t @types.Type, n int) @types.Type {
	for i := 1; i < n; i++ {
		t = chainChild(t)
	}
	return t
}

// chainChild returns what a link of a chain holds.
func chainChild(t @types.Type) @types.Type {
	if t.Kind == types.TYP_STRUCT { return t.Fields[0].Type }
	if t.Kind == types.TYP_NAMED { return t.Underlying }
	return t.Elem
}

// dropLinks releases the top n links of the chain *p, one at a time, leaving what is
// under them in *p.  The caller's variable is the chain's only reference, so each link
// is freed as it is left and no destruction nests.
func dropLinks(p *@types.Type, n int) {
	for i := 0; i < n; i++ {
		*p = chainChild(*p)
	}
}

// A typePath finds the types on it, past typeVisitsScanned of them too, and not one
// taken off.
func TestTypePath() testing.TestResult {
	var p typePath
	var ts @[]@types.Type = make_slice(@types.Type, 40)
	for i := 0; i < len(ts); i++ {
		ts[i] = types.MakeNamedType("main.P")
		if p.has(ts[i]) { return "a type not pushed yet is not on the path" }
		p.push(ts[i])
	}
	for i := 0; i < len(ts); i++ {
		if !p.has(ts[i]) { return "every type pushed is on the path" }
	}
	p.pop()
	if p.has(ts[39]) || !p.has(ts[38]) { return "pop takes off the innermost type only" }
	return ""
}

// paramWalksFind reports whether each walk that looks for a type parameter, or for a
// named type when named, finds one in t.  The walks' visited sets, which hold every
// type they enter, are released before it returns, while t still holds them: dropped
// after t's links, they would free them all at once, one destruction nested in the
// next.
func paramWalksFind(t @types.Type, named bool) bool {
	if named { return typeMentionsNamed(t) }
	var isParam *func(@types.Type) bool = func(u @types.Type) bool {
		return u.Kind == types.TYP_TYPE_PARAM
	}
	var v1 typeVisits
	var v2 typeVisits
	var found bool = mentionsTypeWhere(t, isParam, &v1)
	if typeMentionsParam(t, nil, 0, &v2) != found { return !found }
	if mentionsTypeParam(t) != found || isTypeParamType(t) != found { return !found }
	return found
}

// The walks that look for a type parameter find one at the bottom of a chain of
// pointers deepLevels deep, and none once the bottom is int; so for a named type.
func TestDeepPointerWalks() testing.TestResult {
	var tp @types.Type = MakeTypeParamType("T", nil, 0, nil)
	var t @types.Type = ptrChain(deepLevels, tp)
	var bottom @types.Type = innermost(t, deepLevels)
	var found bool = paramWalksFind(t, false)
	bottom.Elem = types.TypInt()
	var none bool = !paramWalksFind(t, false) && !paramWalksFind(t, true)
	bottom.Elem = types.MakeNamedType("main.Leaf")
	var named bool = paramWalksFind(t, true)
	bottom = nil
	dropLinks(&t, deepLevels)
	if !found { return "a type parameter at the bottom of a deep pointer chain must be found" }
	if !none { return "a deep pointer chain over int mentions no type parameter or named type" }
	if !named { return "a named type at the bottom of a deep pointer chain must be found" }
	return ""
}

// The by-value walks find what is at the bottom of a chain of structs deepLevels deep
// -- a type parameter, an error type, a slice -- and nothing once the bottom is int.
func TestDeepStructWalks() testing.TestResult {
	var tp @types.Type = MakeTypeParamType("T", nil, 0, nil)
	var t @types.Type = structChain(deepLevels, tp)
	var bottom @types.Type = innermost(t, deepLevels)
	var param bool = layoutDependsOnTypeParam(nil, t) && containsByValueTypeParam(t)
	bottom.Fields[0].Type = types.TypError()
	var errType bool = holdsErrTypeByValue(t)
	bottom.Fields[0].Type = types.MakeSliceType(types.TypInt())
	var sliceNotComparable bool = !AggregateComparable(t)
	bottom.Fields[0].Type = types.TypInt()
	var plain bool = !layoutDependsOnTypeParam(nil, t) && !containsByValueTypeParam(t) &&
			!holdsErrTypeByValue(t) && AggregateComparable(t)
	bottom = nil
	dropLinks(&t, deepLevels)
	if !param { return "a type parameter at the bottom of a deep struct chain must be found" }
	if !errType { return "an error type at the bottom of a deep struct chain must be found" }
	if !sliceNotComparable {
		return "a slice at the bottom of a deep struct chain makes it not comparable"
	}
	if !plain { return "a deep struct chain over int has none of these" }
	return ""
}

// reachesByValue is typeReachesNamedByValue with a visited set released before it
// returns (paramWalksFind).
func reachesByValue(t @types.Type, target @types.Type) bool {
	var v typeVisits
	return typeReachesNamedByValue(t, target, &v)
}

// A chain of named types deepLevels deep reaches its innermost one by value, and holds
// itself once that one holds the outermost.
func TestDeepNamedWalks() testing.TestResult {
	var leaf @[]@types.Field = make_slice(@types.Field, 1)
	leaf[0] = make(types.Field)
	leaf[0].Name = "x"
	leaf[0].Type = types.TypInt()
	var t @types.Type = namedChain(deepLevels, types.MakeStructType("", leaf))
	var bottom @types.Type = innermost(t, deepLevels)
	var reaches bool = reachesByValue(t, bottom) &&
			!reachesByValue(t, types.MakeNamedType("main.Other"))
	var acyclic bool = !holdsItselfByValue(t)
	bottom.Underlying.Fields[0].Type = t
	var cyclic bool = holdsItselfByValue(t)
	bottom.Underlying.Fields[0].Type = types.TypInt()
	bottom = nil
	dropLinks(&t, deepLevels)
	if !reaches { return "a deep named chain reaches its innermost type, and no other" }
	if !acyclic { return "a deep named chain does not hold itself" }
	if !cyclic { return "a deep named chain holds itself once its innermost type holds its outermost" }
	return ""
}

// A dependent array is found under pointers and anonymous structs deepLevels deep --
// past any fixed depth -- and not once the bottom is a plain array.
func TestDeepContainsDependentArray() testing.TestResult {
	var t @types.Type = ptrChain(deepLevels, structChain(1, dependentArray(types.TypUint8())))
	var bottom @types.Type = innermost(t, deepLevels)
	var found bool = containsDependentArray(t)
	bottom.Elem.Fields[0].Type = types.MakeArrayType(types.TypUint8(), 4)
	var none bool = !containsDependentArray(t)
	bottom = nil
	dropLinks(&t, deepLevels)
	if !found { return "a dependent array under a deep chain must be found" }
	if !none { return "a deep chain over a plain array holds no dependent array" }
	return ""
}

// sharedStructs returns n levels of a struct holding the level below twice, over leaf:
// one struct per level, reached by 2^n paths from the top.
func sharedStructs(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		var fs @[]@types.Field = make_slice(@types.Field, 2)
		fs[0] = make(types.Field)
		fs[0].Name = "a"
		fs[0].Type = t
		fs[1] = make(types.Field)
		fs[1].Name = "b"
		fs[1].Type = t
		t = types.MakeStructType("", fs)
	}
	return t
}

// A struct reached by many paths is looked at once: forty levels of a struct holding
// the level below twice are answered at once (walked as a tree, 2^40 structs), by the
// walks that once kept no visited set.
func TestSharedStructWalks() testing.TestResult {
	var t @types.Type = sharedStructs(40, types.TypInt())
	if !AggregateComparable(t) { return "structs of int are comparable" }
	if typeMentionsNamed(t) { return "structs of int mention no named type" }
	if !AggregateComparable(sharedStructs(40, types.MakePointerType(types.TypInt()))) {
		return "structs of pointers are comparable"
	}
	if AggregateComparable(sharedStructs(40, types.MakeSliceType(types.TypInt()))) {
		return "structs of slices are not comparable"
	}
	if !typeMentionsNamed(sharedStructs(40, types.MakeNamedType("main.Leaf"))) {
		return "structs of a named type mention it"
	}
	return ""
}

// A walk run inside another (layoutDependsOnTypeParam asks mentionsTypeParam about an
// unbuilt instance's type arguments) leaves the outer walk's pending parts as it found
// them: the struct's later field is still looked at.
func TestNestedWalkKeepsPendingParts() testing.TestResult {
	var tp @types.Type = MakeTypeParamType("T", nil, 0, nil)
	var inst @types.Type = types.MakeNamedType("main.N[int]")
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	inst.InstArgs = args
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Name = "a"
	fs[0].Type = inst
	fs[1] = make(types.Field)
	fs[1].Name = "b"
	fs[1].Type = tp
	var s @types.Type = types.MakeStructType("", fs)
	if !layoutDependsOnTypeParam(nil, s) {
		return "the field after an unbuilt instance is still looked at"
	}
	fs[1].Type = types.TypInt()
	if layoutDependsOnTypeParam(nil, s) {
		return "an instance over int and an int field depend on no type parameter"
	}
	args[0] = tp
	if !layoutDependsOnTypeParam(nil, s) {
		return "an unbuilt instance over a type parameter depends on it"
	}
	return ""
}
