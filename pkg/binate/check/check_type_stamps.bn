package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/vec"

// The type each type expression denotes, as the check resolved it: the type the
// syntax names in the scope it is written in (what resolveTypeExpr returns for
// it there), never a type a use site derives from it.  `Self` in an interface
// method signature is TYP_SELF, a type parameter in a generic declaration its
// TYP_TYPE_PARAM (an instance's copy has the argument), and `readonly` is kept.
// An assertion or type-switch target denotes the type it recovers, and a type
// declaration's struct is the declared type's underlying, which the declaration
// names (a generic one's is its struct over the type parameters, unnamed: each
// instance's copy records that instance's underlying).  The `[...]` of an
// inferred-length composite literal denotes no type by itself: the literal's
// type has the length.  A node resolved more than once records the latest
// resolution, which sees every type collected; a composite type's record is
// then a type identical to, not the same object as, the one a symbol or
// signature holds.
//
// TypeExpr.DenotedTypeID indexes the table and Checker.TypeExprType reads a
// record back.  Each record names its node, so a node resolved again (a
// package's interface resolved before the package is) keeps its id, and the
// table grows with the nodes rather than the resolutions — except across a REPL
// retry, which clears the syntax's annotations, ids included, and records anew;
// an id that no record of this checker names the node by (one another checker
// left, or one a copy of the whole node inherited) is not trusted.
//
// An expression that names a type — a generic function's type argument, and
// each type within it, or the base of a method expression — has a record of
// the same kind in a table of its own: Expr.DenotedTypeID indexes it and
// Checker.ExprDenotedType reads it.  It holds what the type expression of the
// same spelling denotes there (a bare interface name, which a type argument
// may not be, its interface).  An instantiation's head names a generic, not a
// type, and has none.

// typeExprStamp records that the type expression Node denotes Type.
type typeExprStamp struct {
	Node *ast.TypeExpr
	Type @types.Type
}

// exprStamp records that the expression Node names the type Type.
type exprStamp struct {
	Node *ast.Expr
	Type @types.Type
}

// stampTables holds the checker's records of what syntax denotes: TypeExprs,
// indexed by TypeExpr.DenotedTypeID, and Exprs, indexed by Expr.DenotedTypeID
// (in each, id 0 is reserved for "not resolved").
type stampTables struct {
	TypeExprs @vec.Vec[typeExprStamp]
	Exprs     @vec.Vec[exprStamp]
}

// stampTablesOf returns c's records, creating them on first use.
func stampTablesOf(c @Checker) @stampTables {
	if c.Stamps == nil {
		var st @stampTables = make(stampTables)
		st.TypeExprs = vec.New[typeExprStamp]()
		var reserved typeExprStamp
		st.TypeExprs.Push(reserved)
		st.Exprs = vec.New[exprStamp]()
		var reservedExpr exprStamp
		st.Exprs.Push(reservedExpr)
		c.Stamps = st
	}
	return c.Stamps
}

// typeExprStamps returns c's type expression records.
func typeExprStamps(c @Checker) @vec.Vec[typeExprStamp] {
	return stampTablesOf(c).TypeExprs
}

// stampTypeExpr records t as the type te denotes (nothing for a nil te or t),
// replacing the record of an earlier resolution of te.
func stampTypeExpr(c @Checker, te @ast.TypeExpr, t @types.Type) {
	if te == nil || t == nil {
		return
	}
	var tab @vec.Vec[typeExprStamp] = typeExprStamps(c)
	var s typeExprStamp
	s.Node = te
	s.Type = t
	var id int = te.DenotedTypeID
	if id > 0 && id < tab.Len() && same(tab.Get(id).Node, s.Node) {
		tab.Set(id, s)
		return
	}
	te.DenotedTypeID = tab.Len()
	tab.Push(s)
}

// TypeExprType returns the type the type expression te denotes, as this checker
// resolved it, or nil when it resolved none for te.
func (c @Checker) TypeExprType(te *ast.TypeExpr) @types.Type {
	if te == nil || c.Stamps == nil {
		return nil
	}
	var tab @vec.Vec[typeExprStamp] = c.Stamps.TypeExprs
	var id int = te.DenotedTypeID
	if id <= 0 || id >= tab.Len() || !same(tab.Get(id).Node, te) {
		return nil
	}
	return tab.Get(id).Type
}

// stampExpr records t as the type the expression e names (nothing for a nil e
// or t), replacing the record of an earlier check of e.
func stampExpr(c @Checker, e @ast.Expr, t @types.Type) {
	if e == nil || t == nil {
		return
	}
	var tab @vec.Vec[exprStamp] = stampTablesOf(c).Exprs
	var s exprStamp
	s.Node = e
	s.Type = t
	var id int = e.DenotedTypeID
	if id > 0 && id < tab.Len() && same(tab.Get(id).Node, s.Node) {
		tab.Set(id, s)
		return
	}
	e.DenotedTypeID = tab.Len()
	tab.Push(s)
}

// ExprDenotedType returns the type the expression e names, as this checker
// resolved it, or nil when e names no type (a value, a package, a generic's
// name) or this checker recorded none for it.
func (c @Checker) ExprDenotedType(e *ast.Expr) @types.Type {
	if e == nil || c.Stamps == nil {
		return nil
	}
	var tab @vec.Vec[exprStamp] = c.Stamps.Exprs
	var id int = e.DenotedTypeID
	if id <= 0 || id >= tab.Len() || !same(tab.Get(id).Node, e) {
		return nil
	}
	return tab.Get(id).Type
}

// stampAssertTarget records the type t an assertion or type-switch target
// recovers as the type the target denotes — the syntax names it: `*T` the
// pointer, a bare `T` bound to `@Thing` the managed pointer — and an element
// `readonly` under a `*` / `@` as the pointer's element (assertTargetType
// resolves only the name under them).
func stampAssertTarget(c @Checker, target @ast.TypeExpr, t @types.Type) {
	stampTypeExpr(c, target, t)
	if target == nil || t == nil || target.Base == nil || target.Base.Kind != ast.TEXPR_CONST {
		return
	}
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR {
		stampTypeExpr(c, target.Base, t.Elem)
	}
}

// resolveReceiverWithBinders resolves te, the receiver type of a method or impl
// on a generic type, through its copy with each blank `_` binder named
// (ast.WithNamedBlankBinders), and records on te's own nodes what the copy's
// resolution recorded on the copied ones.
func resolveReceiverWithBinders(c @Checker, te @ast.TypeExpr) @types.Type {
	var named @ast.TypeExpr = ast.WithNamedBlankBinders(te)
	var t @types.Type = resolveTypeExpr(c, named)
	copyTypeExprStamps(c, te, named)
	return t
}

// copyTypeExprStamps records on each node of te the type recorded for its
// counterpart in cp, a copy of te of the same shape that may share subtrees
// with it (a shared subtree has its records already).
func copyTypeExprStamps(c @Checker, te @ast.TypeExpr, cp @ast.TypeExpr) {
	if te == nil || cp == nil || same(te, cp) {
		return
	}
	stampTypeExpr(c, te, c.TypeExprType(cp))
	copyTypeExprStamps(c, te.Base, cp.Base)
	copyExprTypeStamps(c, te.Len, cp.Len)
	for i := 0; i < len(te.Fields) && i < len(cp.Fields); i++ {
		if te.Fields[i] != nil && cp.Fields[i] != nil {
			copyTypeExprStamps(c, te.Fields[i].Type, cp.Fields[i].Type)
		}
	}
	for i := 0; i < len(te.ParamTypes) && i < len(cp.ParamTypes); i++ {
		copyTypeExprStamps(c, te.ParamTypes[i], cp.ParamTypes[i])
	}
	for i := 0; i < len(te.ResultTypes) && i < len(cp.ResultTypes); i++ {
		copyTypeExprStamps(c, te.ResultTypes[i], cp.ResultTypes[i])
	}
	for i := 0; i < len(te.TypeArgs) && i < len(cp.TypeArgs); i++ {
		copyTypeExprStamps(c, te.TypeArgs[i], cp.TypeArgs[i])
	}
}

// copyExprTypeStamps is copyTypeExprStamps for the type expressions an
// expression e holds (an array length's `sizeof(T)`), from its copy ce.
func copyExprTypeStamps(c @Checker, e @ast.Expr, ce @ast.Expr) {
	if e == nil || ce == nil || same(e, ce) {
		return
	}
	copyExprTypeStamps(c, e.X, ce.X)
	copyExprTypeStamps(c, e.Y, ce.Y)
	copyExprTypeStamps(c, e.Z, ce.Z)
	for i := 0; i < len(e.Args) && i < len(ce.Args); i++ {
		copyExprTypeStamps(c, e.Args[i], ce.Args[i])
	}
	copyTypeExprStamps(c, e.TypeRef, ce.TypeRef)
	for i := 0; i < len(e.Elems) && i < len(ce.Elems); i++ {
		if e.Elems[i] != nil && ce.Elems[i] != nil {
			copyExprTypeStamps(c, e.Elems[i].Key, ce.Elems[i].Key)
			copyExprTypeStamps(c, e.Elems[i].Value, ce.Elems[i].Value)
		}
	}
}

// stampFromAbstractCopy records on the generic declaration d what the copy of d
// its abstract instantiation (with its own type parameters, params) was resolved
// from records, for the parts only copies are resolved from: an alias's target
// and an interface's parents.
func stampFromAbstractCopy(c @Checker, d @ast.Decl, isIface bool, params @[]@types.Type) {
	if d.IsAlias {
		var alias @GenericInstantiation = lookupAliasInstantiation(c, d, params)
		if alias != nil { copyTypeExprStamps(c, d.TypeRef, alias.Clone.TypeRef) }
		return
	}
	if !isIface {
		return
	}
	var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, d, params)
	if entry == nil || entry.Clone == nil {
		return
	}
	for i := 0; i < len(d.Interfaces) && i < len(entry.Clone.Interfaces); i++ {
		copyTypeExprStamps(c, d.Interfaces[i], entry.Clone.Interfaces[i])
	}
}
