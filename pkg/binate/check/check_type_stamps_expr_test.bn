package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the checker's records of the types expressions name
// (check_type_stamps.bn).

// An expression checked again keeps its id and the latest type; an id no record
// of the checker names the expression by is not trusted.
func TestStampExprKeepsItsId() testing.TestResult {
	var a @Checker = NewChecker()
	var b @Checker = NewChecker()
	var e @ast.Expr = make(ast.Expr)
	stampExpr(a, e, types.TypInt())
	var id int = e.DenotedTypeID
	var n int = a.Stamps.Exprs.Len()
	stampExpr(a, e, types.TypBool())
	if id <= 0 || e.DenotedTypeID != id || a.Stamps.Exprs.Len() != n {
		return "an expression checked again must keep its record"
	}
	if !same(a.ExprDenotedType(e), types.TypBool()) {
		return "the record must hold the latest type"
	}
	var other @ast.Expr = make(ast.Expr)
	stampExpr(b, other, types.TypInt())
	if other.DenotedTypeID != id || b.ExprDenotedType(e) != nil {
		return "a record of another expression must not be read as e's"
	}
	var cp @ast.Expr = make(ast.Expr)
	*cp = *e
	if a.ExprDenotedType(cp) != nil || a.ExprDenotedType(nil) != nil {
		return "a whole copy of an expression, and nil, have no record"
	}
	return ""
}

// Type arguments of every spelling (a name, `*T`, `@T`, an instantiation, the
// raw interface value of a generic interface's instance), those of a generic
// function value and of a call in a generic function's or a generic type's
// method's body (whose instance copy names the argument), and method expression
// bases (a type, a generic type's instance) have records, and no other
// expression has one.
func TestStampsCoverTypeArgs() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface Getter[T any] { Get() T }\n"
			"type P struct { v int }\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func (p *P) Val() int { return p.v }\n"
			"func id[T any](x T) T { return x }\n"
			"func size[T any]() int { return cast(int, sizeof(T)) }\n"
			"func wrap[T any]() int { return size[T]() + size[*T]() + size[Box[T]]() }\n"
			"func (b *Box[T]) Sz() int { var m *func(*P) int = P.Val; _ = m; return size[*Box[T]]() }\n"
			"func main() {\n"
			"\tvar p P\n"
			"\tvar b Box[int]\n"
			"\tvar a int = id[int](1) + size[*P]() + size[@P]() + size[Box[P]]()\n"
			"\ta = a + size[*Box[int]]() + size[*Getter[int]]() + size[@[]*P]()\n"
			"\tvar f *func(int) int = id[int]\n"
			"\tvar m *func(*P) int = P.Val\n"
			"\tvar g *func(*Box[int]) int = Box[int].Get\n"
			"\t_ = wrap[int]() + m(&p) + g(&b) + f(a) + b.Sz()\n"
			"}\n"
	return stampWalkOf(src)
}

// Package-qualified type arguments (`pkg.T`, `*pkg.Box[pkg.T]`), a qualified
// generic function's, and a qualified generic type's method expression base
// have records, and the package names none; so do the package's files and the
// instance copies main makes of its generics.
func TestStampsCoverQualifiedTypeArgs() testing.TestResult {
	var bniSrc *[]readonly char = "package \"pkg/lib\"\n"
			"type T struct { v int }\n"
			"type Box[E any] struct { e E }\n"
			"func (b *Box[E]) Get() E { return b.e }\n"
			"func Id[E any](x E) E { return x }\n"
	var bnSrc *[]readonly char = "package \"pkg/lib\"\n"
	var mainSrc *[]readonly char = "package \"main\"\n"
			"import \"pkg/lib\"\n"
			"func size[T any]() int { return cast(int, sizeof(T)) }\n"
			"func main() {\n"
			"\tvar t lib.T\n"
			"\tvar b lib.Box[lib.T]\n"
			"\tvar g *func(*lib.Box[lib.T]) lib.T = lib.Box[lib.T].Get\n"
			"\tt = lib.Id[lib.T](t)\n"
			"\t_ = size[lib.T]() + size[*lib.Box[lib.T]]()\n"
			"\t_ = g(&b)\n"
			"}\n"
	var c @Checker
	var bni @ast.File
	var bn @ast.File
	c, bni, bn = checkerWithLibFiles(bniSrc, bnSrc)
	var p @parser.Parser = parser.New(toBytes(mainSrc), "test.bn")
	var file @ast.File = mustParse(p)
	c.Check(file)
	if len(c.Errors) > 0 {
		return buf.Concat("the program must check: ", c.Errors[0].Msg)
	}
	if len(c.InstanceBodies(declNamedIn(bn, "Id"))) == 0 ||
			len(c.InstanceBodies(declNamedIn(bn, "Get"))) == 0 {
		return "main must instantiate the package's Id and Box's Get"
	}
	var w @stampWalk = newStampWalk(c)
	walkStampFile(w, file)
	walkStampFile(w, bni)
	walkStampFile(w, bn)
	return stampProblems(w)
}

// kindOf returns t's kind, or -1 for nil.
func kindOf(t @types.Type) int {
	if t == nil {
		return -1
	}
	return t.Kind
}

// The records hold the types the expressions name — `*P` the pointer to P and
// its operand P itself, `@P` the managed pointer, a method expression's base its
// type (a generic type's instance with its argument), `*I` over an interface
// the raw interface value and its operand the interface — and a generic body's
// type argument names the type parameter, its instance copy's the argument.
// An instantiation's head and a value have none.
func TestExprStampsHoldNamedTypes() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface Getter[T any] { Get() T }\n"
			"type P struct { v int }\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func (p *P) Val() int { return p.v }\n"
			"func size[T any]() int { return cast(int, sizeof(T)) }\n"
			"func wrap[T any]() int { return size[T]() }\n"
			"var gp P\n"
			"var a1 int = size[*P]()\n"
			"var a2 int = size[@P]()\n"
			"var a3 *func(*P) int = P.Val\n"
			"var a4 *func(*Box[int]) int = Box[int].Get\n"
			"var a5 int = size[*Getter[int]]()\n"
			"var a6 int = wrap[int]()\n"
			"func main() {}\n"
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(src)
	if len(c.Errors) > 0 {
		return buf.Concat("the program must check: ", c.Errors[0].Msg)
	}
	var pt @types.Type = recordOf(c, declNamedIn(file, "gp").TypeRef)
	var call1 @ast.Expr = declNamedIn(file, "a1").Value
	var t1 @types.Type = c.ExprDenotedType(call1.X.Args[0])
	if kindOf(t1) != types.TYP_POINTER || pt == nil || !same(t1.Elem, pt) ||
			!same(c.ExprDenotedType(call1.X.Args[0].X), pt) {
		return "`*P` must record the pointer to P, and its operand P"
	}
	if c.ExprDenotedType(call1.X.X) != nil || c.ExprDenotedType(call1) != nil ||
			c.ExprDenotedType(call1.X) != nil {
		return "an instantiation's head, a call and an instance have no record"
	}
	if kindOf(c.ExprDenotedType(declNamedIn(file, "a2").Value.X.Args[0])) != types.TYP_MANAGED_PTR {
		return "`@P` must record the managed pointer"
	}
	if !same(c.ExprDenotedType(declNamedIn(file, "a3").Value.X), pt) {
		return "a method expression's base must record its type"
	}
	var base4 @ast.Expr = declNamedIn(file, "a4").Value.X
	var t4 @types.Type = c.ExprDenotedType(base4)
	if kindOf(t4) != types.TYP_NAMED || len(t4.InstArgs) != 1 ||
			t4.InstArgs[0].Kind != types.TYP_INT ||
			kindOf(c.ExprDenotedType(base4.Args[0])) != types.TYP_INT {
		return "a generic type's method expression base must record the instance"
	}
	var arg5 @ast.Expr = declNamedIn(file, "a5").Value.X.Args[0]
	if kindOf(c.ExprDenotedType(arg5)) != types.TYP_INTERFACE_VALUE ||
			kindOf(c.ExprDenotedType(arg5.X)) != types.TYP_INTERFACE {
		return "`*I` must record the raw interface value, and its operand the interface"
	}
	var wrap @ast.Decl = declNamedIn(file, "wrap")
	var inner @ast.Expr = wrap.Body.Stmts[0].Exprs[0].X.Args[0]
	if kindOf(c.ExprDenotedType(inner)) != types.TYP_TYPE_PARAM {
		return "a generic body's type argument must record the type parameter"
	}
	var copies @[]@InstanceBody = c.InstanceBodies(wrap)
	if len(copies) != 1 {
		return "wrap must have one instance copy"
	}
	var copied @ast.Expr = copies[0].Clone.Body.Stmts[0].Exprs[0].X.Args[0]
	if kindOf(c.ExprDenotedType(copied)) != types.TYP_INT {
		return "an instance copy's type argument must record the argument"
	}
	return ""
}
