package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the checker's records of what type expressions denote
// (check_type_stamps.bn).

// A node resolved again keeps its id, and the record holds the latest type.
func TestStampTypeExprKeepsItsId() testing.TestResult {
	var c @Checker = NewChecker()
	var te @ast.TypeExpr = make(ast.TypeExpr)
	stampTypeExpr(c, te, types.TypInt())
	var id int = te.DenotedTypeID
	var n int = c.Stamps.TypeExprs.Len()
	stampTypeExpr(c, te, types.TypBool())
	if id <= 0 || te.DenotedTypeID != id || c.Stamps.TypeExprs.Len() != n {
		return "a type expression resolved again must keep its record"
	}
	if !same(c.TypeExprType(te), types.TypBool()) {
		return "the record must hold the latest resolution"
	}
	return ""
}

// An id that no record of the checker names the node by — one another checker
// left, or one a copy of the whole node inherited — is not trusted: reading it
// gives nil, and stamping the node gives it a record of its own without
// replacing the record the id is.
func TestTypeExprTypeIgnoresForeignId() testing.TestResult {
	var a @Checker = NewChecker()
	var b @Checker = NewChecker()
	var other @ast.TypeExpr = make(ast.TypeExpr)
	stampTypeExpr(b, other, types.TypBool())
	var te @ast.TypeExpr = make(ast.TypeExpr)
	stampTypeExpr(a, te, types.TypInt())
	if te.DenotedTypeID != other.DenotedTypeID {
		return "the test needs the two checkers' ids to coincide"
	}
	if b.TypeExprType(te) != nil {
		return "a record of another node must not be read as te's"
	}
	stampTypeExpr(b, te, types.TypInt())
	if te.DenotedTypeID == other.DenotedTypeID || !same(b.TypeExprType(other), types.TypBool()) {
		return "stamping te must not replace another node's record"
	}
	var cp @ast.TypeExpr = make(ast.TypeExpr)
	*cp = *te
	if b.TypeExprType(cp) != nil || !same(b.TypeExprType(te), types.TypInt()) {
		return "a whole copy of a node must not read the node's record"
	}
	if a.TypeExprType(nil) != nil {
		return "nil has no record"
	}
	return ""
}

// stampWalkOf checks src, which must check cleanly, and returns what a walk of
// its syntax and its instance copies finds wrong with the type records ("" for
// nothing).
func stampWalkOf(src *[]readonly char) @[]char {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(src)
	if len(c.Errors) > 0 {
		return buf.Concat("the program must check: ", c.Errors[0].Msg)
	}
	var w @stampWalk = newStampWalk(c)
	walkStampFile(w, file)
	return stampProblems(w)
}

// Every type expression of declarations, signatures, struct fields and the
// expressions that hold types has a record.
func TestStampsCoverDeclsAndExprs() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"const N int = 4\n"
			"type Q int\n"
			"type P struct {\n"
			"\ta [N]int\n"
			"\tb *P\n"
			"\tc @[]int\n"
			"\td *[]readonly uint8\n"
			"\tf *func(int, ...int) bool\n"
			"\tg @func() (int, bool)\n"
			"\th (int)\n"
			"\ts struct { x int }\n"
			"}\n"
			"type A = P\n"
			"var g1 [2]Q\n"
			"var g2 *A\n"
			"func (p *P) Get(x int) [2]int { var r [2]int; r[0] = x; return r }\n"
			"func f(a int, b *[]int, c ...int) (int, @P) {\n"
			"\tvar x @P = make(P)\n"
			"\tvar z @[]int = make_slice(int, 3)\n"
			"\tvar s int = cast(int, sizeof(P)) + cast(int, alignof(Q))\n"
			"\tvar arr [3]int = [...]int{1, 2, 3}\n"
			"\tvar lit P = P{}\n"
			"\tvar bx @int = box(5)\n"
			"\tvar fl *func(int) int = func(v int) int { var t Q = cast(Q, v); return cast(int, t) }\n"
			"\tvar u uint8 = bit_cast(uint8, cast(int8, -1))\n"
			"\treturn 0, x\n"
			"}\n"
			"func main() {}\n"
	var problems @[]char = stampWalkOf(src)
	if len(problems) > 0 {
		return problems
	}
	return ""
}

// Interface method signatures (Self included), parents, impls and assertion /
// type-switch targets (an element readonly included) have records.
func TestStampsCoverInterfaces() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { M(o *Self) int }\n"
			"interface J : I { N() int }\n"
			"interface JA = J\n"
			"type T struct { v int }\n"
			"impl *T : JA\n"
			"func (t *T) M(o *T) int { return 0 }\n"
			"func (t *T) N() int { return 1 }\n"
			"func use(x *any) int {\n"
			"\tvar j *J = x.(*T)\n"
			"\tswitch x.(type) {\n"
			"\tcase *T:\n"
			"\t\treturn j.N()\n"
			"\t}\n"
			"\t_, ok := x.(T)\n"
			"\tif ok { return 2 }\n"
			"\tvar r *readonly T = x.(*readonly T)\n"
			"\tif r != nil { return 3 }\n"
			"\treturn 0\n"
			"}\n"
			"func main() {}\n"
	var problems @[]char = stampWalkOf(src)
	if len(problems) > 0 {
		return problems
	}
	return ""
}

// Generic declarations, their instance copies (which name no type parameter),
// blank receiver binders, parameterized impls, generic aliases (an array length
// that depends on a type parameter included) and generic interfaces and their
// parents have records.
func TestStampsCoverGenerics() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface Getter[T any] { Get() T }\n"
			"type Box[T any] struct { v T; next @Box[T]; arr [2]T }\n"
			"type Pair[K any, V any] struct { k K; v *V }\n"
			"type BA[T any] = Box[T]\n"
			"type Raw[T any] = [sizeof(T)]uint8\n"
			"interface Sub[T any] : Getter[T] { Put(v T) int }\n"
			"interface GI = Getter[int]\n"
			"impl *Box[T] : Getter[T]\n"
			"func (b *Box[T]) Get() T { var r T = b.v; return r }\n"
			"func (b *Box[_]) Size() int { return 1 }\n"
			"func first[T any](xs *[]T) T { var z T = xs[0]; return z }\n"
			"func main() {\n"
			"\tvar b BA[int]\n"
			"\tvar p Pair[int, Box[int]]\n"
			"\tvar xs [3]int\n"
			"\tvar rw Raw[int]\n"
			"\trw[0] = 1\n"
			"\tvar y int = first[int](xs[:]) + b.Size() + p.k\n"
			"\tvar g *GI = &b\n"
			"\tvar h *Getter[int] = &b\n"
			"\t_ = g.Get() + h.Get() + y\n"
			"}\n"
	var problems @[]char = stampWalkOf(src)
	if len(problems) > 0 {
		return problems
	}
	return ""
}

// A REPL declaration that parks on a type not declared yet records the type
// again when it resolves: the record is the type, not the parked attempt's.
func TestStampReplParkedDeclRestamped() testing.TestResult {
	var c @Checker = sessionChecker()
	var p @parser.Parser = parser.New(toBytes("var v K"), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
	if !c.IsPendingDecl("v") {
		return "v must park on K"
	}
	replCheckDecl(c, "type K int")
	_ = c.RetryPendingDecls()
	var k @Symbol = c.Scope.Lookup("K")
	if k == nil || c.IsPendingDecl("v") {
		return "K must resolve v"
	}
	if !same(c.TypeExprType(d.TypeRef), k.Type) {
		return "the record of v's type must be K"
	}
	return ""
}

// recordOf returns the record of te, or nil when te is nil.
func recordOf(c @Checker, te @ast.TypeExpr) @types.Type {
	if te == nil {
		return nil
	}
	return c.TypeExprType(te)
}

// overOwnParam reports whether t is an instance whose one type argument is a
// type parameter.
func overOwnParam(t @types.Type) bool {
	return t != nil && len(t.InstArgs) == 1 && t.InstArgs[0].Kind == types.TYP_TYPE_PARAM
}

// The records hold the types the syntax denotes: a declared type's own type,
// the struct a declaration names (not an unnamed copy of it), a blank binder's
// type parameter, and, for a generic struct's definition, an alias's target
// and an interface's parent, types over the declaration's own parameters.
func TestStampsHoldDenotedTypes() testing.TestResult {
	var c @Checker
	var file @ast.File
	var src *[]readonly char = "package \"main\"\n"
			"type S struct { x int }\n"
			"type Box[T any] struct { v T }\n"
			"type BA[T any] = Box[T]\n"
			"interface Getter[T any] { Get() T }\n"
			"interface Sub[T any] : Getter[T] { Put(v T) int }\n"
			"func (b *Box[_]) Size() int { return 1 }\n"
			"var g S\n"
			"func main() {}\n"
	c, file = checkSrcReturningFile(src)
	if len(c.Errors) > 0 {
		return buf.Concat("the program must check: ", c.Errors[0].Msg)
	}
	var s @types.Type = recordOf(c, declNamedIn(file, "g").TypeRef)
	if s != nil && s.Kind == types.TYP_NAMED { s = s.Underlying }
	var def @types.Type = recordOf(c, declNamedIn(file, "S").TypeRef)
	if s == nil || def == nil || !def.Identical(s) || !types.CharEq(def.Name, s.Name) {
		return "S's definition must record the struct S is"
	}
	var boxDef @types.Type = recordOf(c, declNamedIn(file, "Box").TypeRef)
	if boxDef == nil || boxDef.Kind != types.TYP_STRUCT || len(boxDef.Fields) != 1 ||
			boxDef.Fields[0].Type.Kind != types.TYP_TYPE_PARAM {
		return "a generic struct's definition must record its struct over its parameter"
	}
	var recv @ast.TypeExpr = declNamedIn(file, "Size").Recv.Type
	var binder @types.Type = recordOf(c, recv.Base.TypeArgs[0])
	if binder == nil || binder.Kind != types.TYP_TYPE_PARAM || recordOf(c, recv) == nil {
		return "a blank receiver binder must record its type parameter"
	}
	if !overOwnParam(recordOf(c, declNamedIn(file, "BA").TypeRef)) {
		return "an alias's target must record the instance over the alias's parameter"
	}
	if !overOwnParam(recordOf(c, declNamedIn(file, "Sub").Interfaces[0])) {
		return "an interface's parent must record the instance over its parameter"
	}
	return ""
}

// A package checked from its .bni and .bn, as every driver loads one (the
// interface first, then the package), leaves every type expression of both
// files recorded.
func TestStampsCoverBniAndBn() testing.TestResult {
	var bniSrc *[]readonly char = "package \"q\"\n"
			"type T struct { v int }\n"
			"type G[E any] struct { e E }\n"
			"func F(t *T) int\n"
			"func (t *T) Get() int\n"
			"func Pick[E any](g *G[E]) E { return g.e }\n"
	var bnSrc *[]readonly char = "package \"q\"\n"
			"type T struct { v int }\n"
			"type G[E any] struct { e E }\n"
			"func F(t *T) int { var g G[int]; return t.v + Pick[int](&g) }\n"
			"func (t *T) Get() int { return t.v }\n"
	var c @Checker = NewChecker()
	var bni @ast.File
	var bn @ast.File
	bni, bn = checkBniPkgFiles(c, bniSrc, bnSrc, false)
	if len(c.Errors) > 0 {
		return buf.Concat("the package must check: ", c.Errors[0].Msg)
	}
	var w @stampWalk = newStampWalk(c)
	walkStampFile(w, bni)
	walkStampFile(w, bn)
	return stampProblems(w)
}
