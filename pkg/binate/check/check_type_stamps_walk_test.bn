package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strconv"
import "pkg/std/vec"

// A walk of checked syntax for the checker's records of what type expressions
// denote (check_type_stamps.bn): every type expression a checked program holds
// has one, and in an instance's checked copy none names a type parameter.

// stampWalk is a walk of checked syntax with checker C.  InCopy is set while it
// walks an instance's copy; Problems holds one line per finding.
type stampWalk struct {
	C        @Checker
	InCopy   bool
	Problems @vec.Vec[@[]char]
}

// newStampWalk returns a walk of syntax checked by c.
func newStampWalk(c @Checker) @stampWalk {
	var w @stampWalk = make(stampWalk)
	w.C = c
	w.Problems = vec.New[@[]char]()
	return w
}

// noteStampProblem records what is wrong with te, at its position.
func noteStampProblem(w @stampWalk, what *[]readonly char, te @ast.TypeExpr) {
	var s @[]char = buf.Concat(what, " at ")
	s = buf.Concat(s, te.Pos.File)
	s = buf.Concat(s, ":")
	s = buf.Concat(s, strconv.Itoa(te.Pos.Line))
	s = buf.Concat(s, ":")
	s = buf.Concat(s, strconv.Itoa(te.Pos.Col))
	s = buf.Concat(s, " (kind ")
	s = buf.Concat(s, strconv.Itoa(te.Kind))
	s = buf.Concat(s, ")")
	w.Problems.Push(s)
}

// stampProblems returns the walk's findings as one string ("" for none).
func stampProblems(w @stampWalk) @[]char {
	var out @[]char
	for i := 0; i < w.Problems.Len(); i++ {
		out = buf.Concat(out, w.Problems.Get(i))
		out = buf.Concat(out, "; ")
	}
	return out
}

// copyNamesTypeParam reports whether a type parameter occurs in t (Self does not
// count: an interface instance's copy keeps it).
func copyNamesTypeParam(t @types.Type, depth int) bool {
	if t == nil || depth > 64 {
		return false
	}
	if t.Kind == types.TYP_TYPE_PARAM {
		return true
	}
	if copyNamesTypeParam(t.Elem, depth + 1) || copyNamesTypeParam(t.Target, depth + 1) {
		return true
	}
	for i := 0; i < len(t.InstArgs); i++ {
		if copyNamesTypeParam(t.InstArgs[i], depth + 1) { return true }
	}
	if t.Kind == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if copyNamesTypeParam(t.Fields[i].Type, depth + 1) { return true }
		}
	}
	for i := 0; i < len(t.Params); i++ {
		if copyNamesTypeParam(t.Params[i].Type, depth + 1) { return true }
	}
	for i := 0; i < len(t.Results); i++ {
		if copyNamesTypeParam(t.Results[i], depth + 1) { return true }
	}
	return false
}

// walkStampFile walks the declarations of file, then each instance copy the
// checker made of its generic declarations and of its generic types' methods.
func walkStampFile(w @stampWalk, file @ast.File) {
	for i := 0; i < len(file.Decls); i++ {
		walkStampDecl(w, file.Decls[i])
	}
	for i := 0; i < len(file.Decls); i++ {
		walkStampCopies(w, file.Decls[i])
	}
}

// walkStampCopies walks the instance copies of d (a group's members') with
// InCopy set.
func walkStampCopies(w @stampWalk, d @ast.Decl) {
	if d == nil {
		return
	}
	for i := 0; i < len(d.Decls); i++ {
		if d.Kind == ast.DECL_GROUP { walkStampCopies(w, d.Decls[i]) }
	}
	var copies @[]@InstanceBody = w.C.InstanceBodies(d)
	var typeCopies @[]@InstanceBody = w.C.TypeInstanceClones(d)
	var saved bool = w.InCopy
	w.InCopy = true
	for i := 0; i < len(copies); i++ { walkStampDecl(w, copies[i].Clone) }
	for i := 0; i < len(typeCopies); i++ { walkStampDecl(w, typeCopies[i].Clone) }
	w.InCopy = saved
}

// walkStampDecl walks the type expressions of d and of what it holds.
func walkStampDecl(w @stampWalk, d @ast.Decl) {
	if d == nil {
		return
	}
	if d.Recv != nil { walkStampTypeExpr(w, d.Recv.Type) }
	// An instance's copy binds its type parameters to the arguments, which each
	// instantiation checks against a copy of the constraints of its own, so the
	// copy's constraints are not resolved.
	for i := 0; i < len(d.TypeParams) && !w.InCopy; i++ {
		if d.TypeParams[i] != nil { walkStampTypeExpr(w, d.TypeParams[i].Constraint) }
	}
	for i := 0; i < len(d.Params); i++ {
		if d.Params[i] != nil { walkStampTypeExpr(w, d.Params[i].Type) }
	}
	for i := 0; i < len(d.Results); i++ { walkStampTypeExpr(w, d.Results[i]) }
	walkStampStmt(w, d.Body)
	walkStampTypeExpr(w, d.TypeRef)
	walkStampExpr(w, d.Value)
	for i := 0; i < len(d.Decls); i++ { walkStampDecl(w, d.Decls[i]) }
	for i := 0; i < len(d.Interfaces); i++ { walkStampTypeExpr(w, d.Interfaces[i]) }
}

// walkStampStmt walks the type expressions in s.
func walkStampStmt(w @stampWalk, s @ast.Stmt) {
	if s == nil {
		return
	}
	for i := 0; i < len(s.Stmts); i++ { walkStampStmt(w, s.Stmts[i]) }
	for i := 0; i < len(s.Exprs); i++ { walkStampExpr(w, s.Exprs[i]) }
	for i := 0; i < len(s.Exprs2); i++ { walkStampExpr(w, s.Exprs2[i]) }
	walkStampExpr(w, s.X)
	walkStampStmt(w, s.Body)
	walkStampStmt(w, s.Else)
	walkStampStmt(w, s.Init)
	walkStampStmt(w, s.Post)
	walkStampExpr(w, s.ForKey)
	walkStampExpr(w, s.ForVal)
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if cc == nil { continue }
		for j := 0; j < len(cc.Exprs); j++ { walkStampExpr(w, cc.Exprs[j]) }
		for j := 0; j < len(cc.Body); j++ { walkStampStmt(w, cc.Body[j]) }
		for j := 0; j < len(cc.Types); j++ { walkStampTypeExpr(w, cc.Types[j]) }
	}
	walkStampDecl(w, s.DeclRef)
}

// walkStampExpr walks the type expressions in e.
func walkStampExpr(w @stampWalk, e @ast.Expr) {
	if e == nil {
		return
	}
	walkStampExpr(w, e.X)
	walkStampExpr(w, e.Y)
	walkStampExpr(w, e.Z)
	for i := 0; i < len(e.Args); i++ { walkStampExpr(w, e.Args[i]) }
	walkStampTypeExpr(w, e.TypeRef)
	for i := 0; i < len(e.Elems); i++ {
		if e.Elems[i] == nil { continue }
		walkStampExpr(w, e.Elems[i].Key)
		walkStampExpr(w, e.Elems[i].Value)
	}
	walkStampDecl(w, e.DeclRef)
}

// walkStampTypeExpr checks te's record, then walks its components.  The `[...]`
// of an inferred-length composite-literal head denotes no type by itself (its
// literal's type has the length), and an instantiation's head names a generic,
// not a type, so neither has a record.
func walkStampTypeExpr(w @stampWalk, te @ast.TypeExpr) {
	if te == nil {
		return
	}
	if !(te.Kind == ast.TEXPR_ARRAY && te.LenInferred) {
		var t @types.Type = w.C.TypeExprType(te)
		if t == nil {
			noteStampProblem(w, "no record", te)
		} else if w.InCopy && copyNamesTypeParam(t, 0) {
			noteStampProblem(w, "a type parameter in an instance copy", te)
		}
	}
	if te.Kind != ast.TEXPR_INSTANTIATE { walkStampTypeExpr(w, te.Base) }
	walkStampExpr(w, te.Len)
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { walkStampTypeExpr(w, te.Fields[i].Type) }
	}
	for i := 0; i < len(te.ParamTypes); i++ { walkStampTypeExpr(w, te.ParamTypes[i]) }
	for i := 0; i < len(te.ResultTypes); i++ { walkStampTypeExpr(w, te.ResultTypes[i]) }
	for i := 0; i < len(te.TypeArgs); i++ { walkStampTypeExpr(w, te.TypeArgs[i]) }
}
