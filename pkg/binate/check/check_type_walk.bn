package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/std/table"
import "pkg/std/vec"

// typeVisits records the types a walk over a type graph has entered, by identity,
// so each is walked once: a struct type repeated through several fields at
// several nesting levels is a DAG, and walked as a tree it takes time exponential
// in the depth.  For a walk that asks whether any part of a type has some
// property, returning true as soon as it finds one, a type entered before has
// nothing to add: it was walked to the end without finding one, or it is still on
// the current path (a cycle).  A walk keeps one on its stack (the zero value is
// empty) and passes a pointer to it.  The first typeVisitsScanned types are looked
// through one by one -- nearly every walk enters no more -- and once there are more,
// a type is looked up by its identity in index (newTypeSet), so a walk entering n types
// takes time linear in n, not quadratic.  entered holds the types entered before index
// was made.
type typeVisits struct {
	entered @[]@types.Type
	n       int
	index   @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
}

// typeVisitsScanned is how many entered types a typeVisits looks through one by one
// before it indexes them (typeVisits).
const typeVisitsScanned int = 16

// has reports whether v records t.
func (v *typeVisits) has(t @types.Type) bool {
	if v.index != nil { return v.index.Has(t) }
	for i := 0; i < v.n; i++ {
		if same(v.entered[i], t) {
			return true
		}
	}
	return false
}

// enter reports whether t is new to v, and records it.
func (v *typeVisits) enter(t @types.Type) bool {
	if v.has(t) {
		return false
	}
	if v.index != nil {
		v.index.Put(t, true)
		return true
	}
	if v.n == len(v.entered) {
		var grown @[]@types.Type = make_slice(@types.Type, 2 * v.n + 4)
		for i := 0; i < v.n; i++ {
			grown[i] = v.entered[i]
		}
		v.entered = grown
	}
	v.entered[v.n] = t
	v.n = v.n + 1
	if v.n > typeVisitsScanned {
		v.index = newTypeSet()
		for i := 0; i < v.n; i++ {
			v.index.Put(v.entered[i], true)
		}
	}
	return true
}

// layoutDependsOnTypeParam reports whether the layout (size, alignment) of t
// depends on a type parameter: t is, or holds by value, a type parameter (or
// Self), an array whose length depends on one (ArrayLenDependent), or a struct
// with such a field — a generic type instantiated with a type parameter
// (`Box[T]` with a `[sizeof(T)]uint8` field) included — or t is a generic type
// instantiated with a type argument in which a type parameter occurs whose
// layout is not built yet.  A pointer's layout does not depend on its target.
func layoutDependsOnTypeParam(t @types.Type) bool {
	// Most types asked about are no struct, array or unbuilt instance: answer them at
	// once, with no visited set to make.
	var b @types.Type = types.StripWrappers(t)
	if b == nil { return false }
	if b.Kind == types.TYP_TYPE_PARAM || b.Kind == types.TYP_SELF { return true }
	if b.Kind != types.TYP_STRUCT && b.Kind != types.TYP_ARRAY &&
			(b.Kind != types.TYP_NAMED || len(b.InstArgs) == 0) {
		return false
	}
	var v typeVisits
	return layoutDependsOnTypeParamIn(t, &v)
}

// layoutDependsOnTypeParamIn is layoutDependsOnTypeParam, entering each struct and
// array once (typeVisits), so the walk ends even on a type that holds itself by value
// through an array (`type A [2]A`) before that is reported.
func layoutDependsOnTypeParamIn(t @types.Type, v *typeVisits) bool {
	var base int = typeWalkBase()
	var found bool = layoutDependsStep(t, v)
	for !found && typeWalkMore(base) {
		found = layoutDependsStep(typeWalkPop(), v)
	}
	typeWalkEnd(base)
	return found
}

// layoutDependsStep reports whether part t of a type layoutDependsOnTypeParamIn walks
// is one whose layout depends on a type parameter by itself, and pushes the parts of t
// whose layout t's depends on.
func layoutDependsStep(t @types.Type, v *typeVisits) bool {
	var b @types.Type = types.StripWrappers(t)
	if b == nil { return false }
	if b.Kind == types.TYP_TYPE_PARAM || b.Kind == types.TYP_SELF { return true }
	if b.Kind == types.TYP_NAMED {
		// An instantiation still being populated: its layout is unknown yet.
		for i := 0; i < len(b.InstArgs); i++ {
			if mentionsTypeParam(b.InstArgs[i]) { return true }
		}
	} else if b.Kind == types.TYP_ARRAY {
		if b.ArrayLenDependent { return true }
		if v.enter(b) { typeWalkPush(b.Elem) }
	} else if b.Kind == types.TYP_STRUCT && v.enter(b) {
		pushFieldTypes(b)
	}
	return false
}

// mentionsTypeParam reports whether a type parameter (or Self) occurs anywhere
// in t — its element, fields, type arguments, or a function type's parameters
// and results.
func mentionsTypeParam(t @types.Type) bool {
	// Most types asked about are built from no other: answer them at once.
	if t == nil { return false }
	if t.Kind == types.TYP_TYPE_PARAM || t.Kind == types.TYP_SELF { return true }
	if typeHasNoParts(t) { return false }
	var v typeVisits
	return mentionsTypeParamIn(t, &v)
}

// mentionsTypeParamIn is mentionsTypeParam, entering each type with parts once
// (typeVisits): a type shared by several parts, at several depths, walked as a
// tree takes time exponential in its depth.  The walk has no depth bound — a bound
// would answer "no" for a type nested past it (`Opt[Opt[…[T]]]`), which then
// counts as concrete.
func mentionsTypeParamIn(t @types.Type, v *typeVisits) bool {
	var base int = typeWalkBase()
	var found bool = mentionsStep(t, v)
	for !found && typeWalkMore(base) {
		found = mentionsStep(typeWalkPop(), v)
	}
	typeWalkEnd(base)
	return found
}

// mentionsStep reports whether part t of a type mentionsTypeParamIn walks is a type
// parameter (or Self), and pushes t's parts the first time it is met.
func mentionsStep(t @types.Type, v *typeVisits) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_TYPE_PARAM || t.Kind == types.TYP_SELF { return true }
	if v.enter(t) { pushMentionedParts(t) }
	return false
}

// pushMentionedParts pushes the types t is built from -- its element, type arguments,
// fields (a struct's), parameters and results -- to be looked at in that order
// (mentionsTypeParamIn, mentionsTypeWhere).
func pushMentionedParts(t @types.Type) {
	pushSignatureTypes(t)
	if t.Kind == types.TYP_STRUCT { pushFieldTypes(t) }
	pushInstArgs(t)
	if t.Elem != nil { typeWalkPush(t.Elem) }
}

// mentionsTypeWhere reports whether t, or a type it is built from — an element, a
// type argument, a field, a parameter or a result, at any depth — is one pred holds
// for, entering each type with parts once (typeVisits), as mentionsTypeParam does.
func mentionsTypeWhere(t @types.Type, pred *func(@types.Type) bool, v *typeVisits) bool {
	var base int = typeWalkBase()
	var found bool = mentionsWhereStep(t, pred, v)
	for !found && typeWalkMore(base) {
		found = mentionsWhereStep(typeWalkPop(), pred, v)
	}
	typeWalkEnd(base)
	return found
}

// mentionsWhereStep reports whether pred holds for part t of a type mentionsTypeWhere
// walks, and pushes t's parts the first time it is met.
func mentionsWhereStep(t @types.Type, pred *func(@types.Type) bool, v *typeVisits) bool {
	if t == nil { return false }
	if pred(t) { return true }
	if v.enter(t) { pushMentionedParts(t) }
	return false
}

// holdsItselfByValue reports whether the named type t holds, or t holds a named
// type that holds, itself by value — through a field, an element or a named
// type's definition — so that it has no layout (type.named.value-acyclic).
func holdsItselfByValue(t @types.Type) bool {
	var done typeVisits
	return holdsItselfIn(t, &done)
}

// heldFrame is a part on heldFrames: a type to look at, or (leave) a named type the
// walk has walked to its end.
type heldFrame struct {
	t     @types.Type
	leave bool
}

// heldFrames holds the parts holdsItselfIn has still to look at, the next one last,
// kept from one walk to the next; a walk leaves it as it found it.
var heldFrames @vec.Vec[heldFrame]

// pushHeld pushes t for holdsItselfIn to look at, or to leave.
func pushHeld(t @types.Type, leave bool) {
	var f heldFrame
	f.t = t
	f.leave = leave
	heldFrames.Push(f)
}

// holdsItselfIn is holdsItselfByValue, done the named types it has walked to their
// end without meeting one of the path's: no named type that holds itself is reached
// from one of those, so each named type is walked once, however many types hold it.
// path is the named types the walk is inside: a named type goes on it with a frame
// to leave it pushed under its underlying, and leaving it takes it off and records it
// done.
func holdsItselfIn(t @types.Type, done *typeVisits) bool {
	if heldFrames == nil { heldFrames = vec.New[heldFrame]() }
	var base int = heldFrames.Len()
	var path typePath
	pushHeld(t, false)
	for heldFrames.Len() > base {
		f, _ := heldFrames.Pop()
		var u @types.Type = f.t
		if f.leave {
			path.pop()
			_ = done.enter(u)
		} else if u == nil {
			continue
		} else if u.Kind == types.TYP_ALIAS {
			pushHeld(u.Target, false)
		} else if u.Kind == types.TYP_READONLY || u.Kind == types.TYP_ARRAY {
			pushHeld(u.Elem, false)
		} else if u.Kind == types.TYP_NAMED {
			if path.has(u) {
				for heldFrames.Len() > base {
					_, _ = heldFrames.Pop()
				}
				return true
			}
			if !done.has(u) {
				path.push(u)
				pushHeld(u, true)
				pushHeld(u.Underlying, false)
			}
		} else if u.Kind == types.TYP_STRUCT {
			for i := len(u.Fields) - 1; i >= 0; i-- {
				pushHeld(u.Fields[i].Type, false)
			}
		}
	}
	return false
}
