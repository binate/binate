package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// typeVisits.enter admits each type once, by identity: a second, structurally
// identical type is a different node.  Growing past the initial capacity keeps
// every type entered.
func TestTypeVisitsEnter() testing.TestResult {
	var v typeVisits
	var a @types.Type = types.MakeStructType("A", make_slice(@types.Field, 0))
	var b @types.Type = types.MakeStructType("A", make_slice(@types.Field, 0))
	if !v.enter(a) { return "a new type should be entered" }
	if v.enter(a) { return "a type entered before should not be entered again" }
	if !v.enter(b) { return "an identical but distinct type is a different node" }
	var many @[]@types.Type = make_slice(@types.Type, 20)
	for i := 0; i < 20; i++ {
		many[i] = types.MakeStructType("M", make_slice(@types.Field, 0))
		if !v.enter(many[i]) { return "each new type should be entered" }
	}
	if v.enter(a) || v.enter(many[0]) || v.enter(many[19]) {
		return "types entered before the set grew should still be found"
	}
	return ""
}
