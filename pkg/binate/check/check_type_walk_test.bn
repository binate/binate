package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// typeVisits.enter admits each type once, by identity: a second, structurally
// identical type is a different node.  Growing past the initial capacity keeps
// every type entered.
func TestTypeVisitsEnter() testing.TestResult {
	var v typeVisits
	var a @types.Type = types.MakeStructType("A", make_slice(@types.Field, 0))
	var b @types.Type = types.MakeStructType("A", make_slice(@types.Field, 0))
	if !v.enter(a) { return "a new type should be entered" }
	if v.enter(a) { return "a type entered before should not be entered again" }
	if !v.enter(b) { return "an identical but distinct type is a different node" }
	var many @[]@types.Type = make_slice(@types.Type, 20)
	for i := 0; i < 20; i++ {
		many[i] = types.MakeStructType("M", make_slice(@types.Field, 0))
		if !v.enter(many[i]) { return "each new type should be entered" }
	}
	if v.enter(a) || v.enter(many[0]) || v.enter(many[19]) {
		return "types entered before the set grew should still be found"
	}
	return ""
}

// Past typeVisitsScanned types a typeVisits indexes them: every type entered before and
// after is found, and a type never entered is not.
func TestTypeVisitsIndexed() testing.TestResult {
	var v typeVisits
	var ts @[]@types.Type = make_slice(@types.Type, 1000)
	for i := 0; i < len(ts); i++ {
		ts[i] = types.MakeStructType("T", make_slice(@types.Field, 0))
		if !v.enter(ts[i]) { return "each new type should be entered" }
		if (i < typeVisitsScanned) != (v.index == nil) {
			return "the index is made once there are more than typeVisitsScanned types"
		}
	}
	for i := 0; i < len(ts); i++ {
		if !v.has(ts[i]) || v.enter(ts[i]) { return "every type entered should be found" }
	}
	if v.has(types.MakeStructType("T", make_slice(@types.Field, 0))) {
		return "a type never entered should not be found"
	}
	return ""
}

// nameVisits.enter admits each name once, by its characters, before and after it
// indexes them (past typeVisitsScanned).
func TestNameVisitsEnter() testing.TestResult {
	var v nameVisits
	var names @[]@[]char = make_slice(@[]char, 100)
	for i := 0; i < len(names); i++ {
		names[i] = buf.Concat("main.P", strconv.Itoa(i))
		if !v.enter(names[i]) { return "each new name should be entered" }
	}
	for i := 0; i < len(names); i++ {
		if v.enter(buf.Concat("main.P", strconv.Itoa(i))) {
			return "a name entered before, spelled again, should not be entered again"
		}
	}
	if !v.enter(buf.CopyStr("main.Q")) { return "a name never entered should be entered" }
	return ""
}

// askLayoutEachLevel asks layoutDependsOnTypeParam, with answers kept, at each of the n
// levels of a chain of structs from head down (structChain), and returns how many
// answered yes.  Its checker and the answers it keeps are gone when it returns, before
// the chain is released.
func askLayoutEachLevel(head @types.Type, n int) int {
	var c @Checker = NewChecker()
	var yes int = 0
	var t @types.Type = head
	for i := 0; i < n; i++ {
		if layoutDependsOnTypeParam(c, t) { yes = yes + 1 }
		t = chainChild(t)
	}
	return yes
}

// Asked at each level of a chain of structs deepLevels deep, layoutDependsOnTypeParam
// keeps the types it found concrete, so the chain is walked once, not once per level.
func TestDeepConcreteLayoutsKept() testing.TestResult {
	var t @types.Type = structChain(deepLevels, types.TypInt())
	var yes int = askLayoutEachLevel(t, deepLevels)
	dropLinks(&t, deepLevels)
	if yes != 0 { return "no level of a chain of structs over int depends on a type parameter" }
	return ""
}

// The concrete layouts kept are forgotten when a type changes: a struct's field
// replaced by a type parameter, with the change noted.
func TestConcreteLayoutsForgottenOnChange() testing.TestResult {
	var c @Checker = NewChecker()
	var s @types.Type = structChain(2, types.TypInt())
	if layoutDependsOnTypeParam(c, s) { return "a struct over int depends on no type parameter" }
	var inner @types.Type = s.Fields[0].Type
	inner.Fields[0].Type = MakeTypeParamType("T", nil, 0, nil)
	noteTypeGraphChanged(c)
	if !layoutDependsOnTypeParam(c, s) {
		return "once its innermost field is a type parameter, the struct depends on one"
	}
	return ""
}
