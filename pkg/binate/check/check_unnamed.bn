package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// No program names an instance with a type parameter or `Self` among its type
// arguments, or an array whose length depends on one (typeArgsAbstract) -- other
// than a generic's own, with its own type parameters, which is its declaration's
// check -- nor what such an instance forms, in its structure, its methods'
// signatures or its signature, however concrete (spec gen.mono.instances); and a
// generic's dependent constructs are decided only for the instances named
// (gen.mono.check).  An instance first formed where nothing is named is unnamed
// (GenericInstantiation.Unnamed, FuncInstance.Unnamed).  An abstract or unnamed
// instance is built as any is -- code that refers to it needs its members -- but
// its build, which holds unnamedHeld, judges no constraint (judgesConstraints),
// queues no check and drops the errors it finds, but those it keeps
// (addKeptError); what it forms is unnamed in turn.  What a use written in the
// program judges as the instance is built is judged where the use is
// (beginUseHolding), and an instance the program names is built, and its signature
// or a method's resolved, as named wherever that is done (beginInstanceHolding).
// An unnamed instance is named the first time it is formed where the program
// names what is formed (nameInstance, nameFuncInstance) -- not in a resolution
// that waits, which is done again: its check is queued in the class it is named in
// and judges its structure, which its build did not, reporting what that finds
// (GenericInstantiation.Unjudged), and a generic function instance's signature is
// resolved again.

// unnamedHeld returns a new holder of what the build of an instance no program
// names, formed here, holds (heldReports.Unnamed): the checks it queues and the
// errors it finds are dropped, and an error it keeps held as an instance first
// formed here would hold it (provisionalHere) -- as the build of an unnamed
// instance being made does, inside one.
func unnamedHeld(c @Checker) @heldReports {
	var h @heldReports = make(heldReports)
	h.Unnamed = true
	var cur @heldReports = holding(c)
	if cur != nil && cur.Unnamed && !resolutionWaits(c) {
		h.Outer = cur.Outer
	} else {
		h.Outer = provisionalHere(c)
	}
	return h
}

// holdingUnnamed reports whether the build being made is of an instance no
// program names.
func holdingUnnamed(c @Checker) bool {
	var h @heldReports = holding(c)
	return h != nil && h.Unnamed
}

// newInstanceHeld returns what the build of the instance of the generic d with the
// type arguments args, first formed here, holds: an unnamed holder when no program
// names it -- formed where nothing is named (judgesConstraints), or abstract, other
// than d's own, then formed by a use the program writes (FormedNamed) -- else what
// provisionalHere returns.
func newInstanceHeld(c @Checker, d @ast.Decl, args *[]@types.Type) @heldReports {
	if !judgesConstraints(c) {
		return unnamedHeld(c)
	}
	if typeArgsAbstract(args) && !argsAreOwnParams(d, args) {
		var h @heldReports = unnamedHeld(c)
		h.FormedNamed = true
		return h
	}
	return provisionalHere(c)
}

// addKeptError reports msg at pos, an error the build of an instance no program
// names keeps, though it drops what else it finds (holdReport): one of a
// declaration itself, which does not depend on the type arguments and which such
// builds find -- a cycle through instances -- or an implementation limit that cuts
// an instance short, whose state later uses meet (keepReports).
func addKeptError(c @Checker, pos token.Pos, msg @[]char) {
	var saved bool = keepReports(c)
	addCheckError(c, pos, msg)
	unkeepReports(c, saved)
}

// keepReports makes the errors reported until unkeepReports kept (addKeptError),
// and returns what that restores.
func keepReports(c @Checker) bool {
	var st @InstanceState = instanceState(c)
	var saved bool = st.KeptError
	st.KeptError = true
	return saved
}

// unkeepReports ends what keepReports began.
func unkeepReports(c @Checker, saved bool) {
	instanceState(c).KeptError = saved
}

// beginInstanceHolding makes what the build or resolution of an instance being
// made holds the instance's own holder h -- while it is provisional, abstract or
// unnamed -- or else caller's, what holds where it is made, but never the holder
// of an instance no program names around it (heldReports.Unnamed): an instance the
// program names judges what it forms wherever it is built, a postponed build or one
// done again included.  endHolding restores what it returns.
func beginInstanceHolding(c @Checker, h @heldReports, caller @heldReports) @heldReports {
	var st @InstanceState = instanceState(c)
	var saved @heldReports = st.Holding
	var held @heldReports = unreleased(h)
	if held == nil {
		held = unreleased(caller)
		for held != nil && held.Unnamed { held = unreleased(held.Outer) }
	}
	st.Holding = held
	return saved
}

// beginUseHolding makes what the build being made holds, for what a use the
// program writes judges as the instance is built (requireIfaceInstanceArgsKept),
// that use's holder: an abstract instance's build drops what else it finds, but its
// use is judged where it is written (heldReports.FormedNamed).  endHolding restores
// what it returns.
func beginUseHolding(c @Checker) @heldReports {
	var st @InstanceState = instanceState(c)
	var saved @heldReports = st.Holding
	if saved != nil && saved.Unnamed && saved.FormedNamed { st.Holding = unreleased(saved.Outer) }
	return saved
}

// nameInstance names the unnamed instance entry at site: its check is queued
// (queueInstanceCheck) in the class it is named in, and judges its structure,
// which its build did not, until that finds no error (rejudgeTypeStructure,
// rejudgeIfaceStructure).
func nameInstance(c @Checker, entry @GenericInstantiation, site token.Pos, userFacing bool) {
	var none @heldReports
	entry.Unnamed = false
	entry.Held = none
	entry.Unjudged = true
	_ = queueInstanceCheck(c, entry, site, userFacing)
}

// nameFuncInstance names the unnamed generic function instance inst, of the
// generic whose home is home, at site: it gets the check state of the class it is
// named in (firstInstState), and what it holds is no longer dropped.
func nameFuncInstance(c @Checker, inst @FuncInstance, home @GenericHome, site token.Pos) {
	var none @heldReports
	inst.Unnamed = false
	inst.Held = none
	inst.State = firstInstState(c, inst.Args, site, home.Pkg)
}
