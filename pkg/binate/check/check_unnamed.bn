package "pkg/binate/check"

import "pkg/binate/token"

// No program names an instance with a type parameter or `Self` among its type
// arguments, or an array whose length depends on one (typeArgsAbstract), nor what
// such an instance forms -- in its structure, its methods' signatures or its
// signature -- however concrete (spec gen.mono.instances), and a generic's
// constraints are judged only for the instances named (gen.mono.check).  An
// instance first formed where nothing is named is unnamed
// (GenericInstantiation.Unnamed, FuncInstance.Unnamed): it is built as any is --
// code that refers to it needs its members -- but its build, which holds
// unnamedHeld, judges no constraint (judgesConstraints) and queues no check, and
// what it forms is unnamed in turn; what else its build finds is reported as any
// build's.  It is named the first time it is formed where the program names what
// is formed (nameInstance, nameFuncInstance) -- not in a resolution that waits,
// which is done again: its check is queued in the class it is named in and judges
// its structure, which its build did not (GenericInstantiation.Unjudged), and a
// generic function instance's signature is resolved again.

// unnamedHeld returns a new holder of what the build of an instance no program
// names, formed here, holds (heldReports.Unnamed): the checks it queues are
// dropped, and its errors held as an instance first formed here would hold them
// (provisionalHere) -- as the build of an unnamed instance being made does, inside
// one.
func unnamedHeld(c @Checker) @heldReports {
	var h @heldReports = make(heldReports)
	h.Unnamed = true
	var cur @heldReports = holding(c)
	if cur != nil && cur.Unnamed && !resolutionWaits(c) {
		h.Outer = cur.Outer
	} else {
		h.Outer = provisionalHere(c)
	}
	return h
}

// holdingUnnamed reports whether the build being made is of an instance no
// program names.
func holdingUnnamed(c @Checker) bool {
	var h @heldReports = holding(c)
	return h != nil && h.Unnamed
}

// newInstanceHeld returns what the build of an instance first formed here holds:
// an unnamed holder where nothing is named (judgesConstraints), else what
// provisionalHere returns.
func newInstanceHeld(c @Checker) @heldReports {
	if !judgesConstraints(c) {
		return unnamedHeld(c)
	}
	return provisionalHere(c)
}

// nameInstance names the unnamed instance entry at site: its check is queued
// (queueInstanceCheck) in the class it is named in, and judges its structure,
// which its build did not, until that finds no error (rejudgeTypeStructure,
// rejudgeIfaceStructure).
func nameInstance(c @Checker, entry @GenericInstantiation, site token.Pos, userFacing bool) {
	var none @heldReports
	entry.Unnamed = false
	entry.Held = none
	entry.Unjudged = true
	_ = queueInstanceCheck(c, entry, site, userFacing)
}

// nameFuncInstance names the unnamed generic function instance inst, of the
// generic whose home is home, at site: it gets the check state of the class it is
// named in (firstInstState), and what it holds is no longer dropped.
func nameFuncInstance(c @Checker, inst @FuncInstance, home @GenericHome, site token.Pos) {
	var none @heldReports
	inst.Unnamed = false
	inst.Held = none
	inst.State = firstInstState(c, inst.Args, site, home.Pkg)
}
