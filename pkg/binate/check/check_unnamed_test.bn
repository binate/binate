package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_unnamed.bn: a concrete instance first formed where no program
// names anything is not named -- not judged, its methods not checked -- until the
// program names it, where its misses are reported.

// unnamedShapes are, after aliasMissPrelude (eight lines), declarations forming
// M[int32] -- whose K[@T, int32] misses Tag[[4]uint8] -- only in the structure of
// G3[X, int32], abstract, in f's signature: as a field's type, through an alias,
// with the miss in a method's signature and in a method's body.
var unnamedShapes @[]@[]char = @[]@[]char{
		"type M[U any] struct { k *K[@T, U] }\ntype G3[S any, U any] struct { m *M[U]; s S }\n"
				"func f[X any](g *G3[X, int32]) int { return 0 }\n",
		"type M[U any] struct { k *K[@T, U] }\ntype MA[U any] = M[U]\n"
				"type G3[S any, U any] struct { m *MA[U]; s S }\n"
				"func f[X any](g *G3[X, int32]) int { return 0 }\n",
		"type M[U any] struct { u U }\nfunc (m *M[U]) q(k *K[@T, U]) int { return 0 }\n"
				"type G3[S any, U any] struct { m *M[U]; s S }\n"
				"func f[X any](g *G3[X, int32]) int { return 0 }\n",
		"type M[U any] struct { u U }\nfunc (m *M[U]) q() int { var k *K[@T, U]; _ = k; return 0 }\n"
				"type G3[S any, U any] struct { m *M[U]; s S }\n"
				"func f[X any](g *G3[X, int32]) int { return 0 }\n"}

// unnamedMisses are the misses unnamedShapes report once `var m M[int32]` follows
// them, naming M[int32] where the variable names it.
var unnamedMisses @[]@[]char = @[]@[]char{
		"Tag[[4]uint8] (in M[int32], instantiated at test.bn:12:8)",
		"Tag[[4]uint8] (in M[int32], instantiated at test.bn:13:8)",
		"Tag[[4]uint8] (in M[int32].q, instantiated at test.bn:13:8)",
		"Tag[[4]uint8] (in M[int32].q, instantiated at test.bn:13:8)"}

// M[int32], formed only through G3[X, int32], is accepted; named afterwards, its
// miss is reported where it is named.
func TestInstanceFormedThroughAbstractNotNamed() testing.TestResult {
	for i := 0; i < len(unnamedShapes); i++ {
		var decls @[]char = buf.Concat(aliasMissPrelude, unnamedShapes[i])
		var r testing.TestResult = expectNoErrors(checkSrc(decls))
		if len(r) > 0 { return r }
		r = expectOneError(checkSrc(buf.Concat(decls, "var m M[int32]\n")), unnamedMisses[i])
		if len(r) > 0 { return r }
	}
	return ""
}

// Named through a chain of instances the program names -- G3[int8, int32], or
// f[int8] whose body forms H[int8, int32] -- M[int32]'s miss names the chain.
func TestInstanceFormedThroughAbstractNamedByChain() testing.TestResult {
	var r testing.TestResult = expectOneError(
			checkSrc(buf.Concat(buf.Concat(aliasMissPrelude, unnamedShapes[0]), "var g G3[int8, int32]\n")),
			"Tag[[4]uint8] (in M[int32], instantiated at test.bn:12:9 via G3[int8, int32])")
	if len(r) > 0 { return r }
	return expectOneError(
			checkSrc(buf.Concat(aliasMissPrelude, "type M[U any] struct { k *K[@T, U] }\n"
					"type H[V any, W any] struct { m *M[W]; v V }\n"
					"func f[X any](x X) int { var h H[X, int32]; _ = h; return 0 }\n"
					"func g() int { return f[int8](1) }\n")),
			"Tag[[4]uint8] (in M[int32], instantiated at test.bn:12:24 via f[int8])")
}

// I[int64], formed only in the structure of H[X, int64], has its `Self` judged only
// once the program names it: G2[Self, int64] in its method's signature misses
// Tag[[8]uint8], I[int64] extending only Tag[[4]uint8].
func TestUnnamedInterfaceInstanceJudgesNoSelf() testing.TestResult {
	var decls @[]char = buf.Concat(aliasMissPrelude,
			"type G2[S Tag[[sizeof(U)]uint8], U any] struct { u U }\n"
					"interface I[U any] : Tag[[4]uint8] { m(g *G2[Self, U]) int }\n"
					"type H[V any, W any] struct { i *I[W]; v V }\n"
					"func f[X any](h *H[X, int64]) int { return 0 }\n")
	var r testing.TestResult = expectNoErrors(checkSrc(decls))
	if len(r) > 0 { return r }
	return expectOneError(checkSrc(buf.Concat(decls, "func use(i *I[int64]) {}\n")),
			"type argument Self does not satisfy constraint Tag[[8]uint8] (interface I[int64] does not "
					"extend Tag[[8]uint8]) (in I[int64], instantiated at test.bn:13:14)")
}

// A resolution that waits for a layout not built yet (N's, read as 0) forms an
// instance from the length it could not read -- Other[[0]uint8], gf[[0]uint8] --
// which an abstract instance forms too, before or after: no program names it, so
// what its build or check would report is never given out; the resolution done
// again forms the instance with the real length.
func TestUnnamedInstanceInWaitingResolution() testing.TestResult {
	var other *[]readonly char = "package \"test\"\ntype Other[T any] struct { x T }\n"
			"func (o *Other[T]) q() int { return 32 / cast(int, sizeof(T)) }\n"
			"type G3[S any, U any] struct { o *Other[U]; s S }\n"
	var bx *[]readonly char = "type Box[T any] struct { a *Other[[sizeof(N)]uint8]; t T }\n"
			"type N struct { v int64; p *Box[int] }\n"
	var gf *[]readonly char = "package \"test\"\n"
			"func gf[T any]() [2]int { var a [2]int; a[0] = 32 / cast(int, sizeof(T)); return a }\n"
			"type H[V any, W any] struct { a [len(gf[W]())]uint8; v V }\n"
	var gbx *[]readonly char = "type Box[T any] struct { a *([len(gf[[sizeof(T)]uint8]())]uint8); "
			"t int }\n"
			"type N struct { v int64; p *Box[N] }\n"
	var srcs @[]@[]char = @[]@[]char{
			buf.Concat(buf.Concat(other, "func f[X any](g *G3[X, [0]uint8]) int { return 0 }\n"), bx),
			buf.Concat(buf.Concat(other, bx),
					"func f[X any]() int { var g *G3[X, [0]uint8]; _ = g; return 0 }\n"),
			buf.Concat(buf.Concat(gf, "func f[X any](h *H[X, [0]uint8]) int { return 0 }\n"), gbx),
			buf.Concat(buf.Concat(gf, gbx),
					"func f[X any]() int { var h *H[X, [0]uint8]; _ = h; return 0 }\n"),
			buf.CopyStr("package \"test\"\ntype Other[T any] struct { a [32 / sizeof(T)]uint8 }\n"
					"type G3[S any, U any] struct { o *Other[[sizeof(U)]uint8]; s S }\n"
					"type Box[T any] struct { g G3[T, N]; t T }\ntype N struct { v int64; p *Box[int] }\n")}
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(srcs[i]))
		if len(r) > 0 { return r }
	}
	return ""
}

// f's body converts *M[int32], which only G3[X, int32] forms, to *J: the
// satisfaction probe resolves M's impl for it, forming J4[Q[int32]], whose
// Q[int32] misses -- named no more than M[int32] is.  Once the program names
// M[int32], its check reports the miss.
func TestUnnamedInstanceImplProbeNamesNothing() testing.TestResult {
	var decls @[]char = buf.Concat(aliasMissPrelude,
			"interface J { j() int }\ninterface J4[Z any] { j4() int }\n"
					"type Q[Z any] struct { k *K[@T, Z] }\ntype M[U any] struct { u U }\n"
					"func (m *M[U]) j() int { return 1 }\nfunc (m *M[U]) j4() int { return 2 }\n"
					"impl *M[U] : J, J4[Q[U]]\ntype G3[S any, U any] struct { m *M[U]; s S }\n"
					"func f[X any](g *G3[X, int32]) int { var t *J = g.m; return t.j() }\n")
	var r testing.TestResult = expectNoErrors(checkSrc(decls))
	if len(r) > 0 { return r }
	return expectOneError(checkSrc(buf.Concat(decls, "var m M[int32]\n")),
			"Tag[[4]uint8] (in Q[int32], instantiated at test.bn:15:21)")
}

// replPrelude is aliasMissPrelude's Tag, K, T and impl, as REPL inputs.
var replPrelude @[]@[]char = @[]@[]char{
		"interface Tag[X any] { tag() int }", "type K[V Tag[[sizeof(U)]uint8], U any] struct { v V }",
		"type T struct { n int }", "func (t @T) tag() int { return t.n }", "impl @T : Tag[[8]uint8]"}

// replSession returns a REPL session's checker that has checked replPrelude and
// then decls, one input each.
func replSession(decls *[]*[]readonly char) @Checker {
	var c @Checker = sessionChecker()
	for i := 0; i < len(replPrelude); i++ { replCheckDecl(c, replPrelude[i]) }
	for i := 0; i < len(decls); i++ { replCheckDecl(c, decls[i]) }
	return c
}

// At the prompt, gf[@T, int32], formed only in H[X, int32]'s structure, is not
// recorded as named by the input; an input naming it is rejected for its miss.
func TestReplUnnamedFuncInstance() testing.TestResult {
	var c @Checker = replSession(
			@[]*[]readonly char{
					"func gf[V Tag[[8]uint8], U any]() [3]uint8 { var k *K[V, U]; _ = k; "
							"var r [3]uint8; return r }",
					"type H[V any, W any] struct { a [len(gf[@T, W]())]uint8; v V }",
					"func f[X any](h *H[X, int32]) int { return 0 }"})
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	replCheckDecl(c, "func g() int { var r [3]uint8 = gf[@T, int32](); return len(r) }")
	return expectOneError(c, "Tag[[4]uint8] (in gf[@T, int32], instantiated at")
}

// At the prompt, an input naming M[int32], formed only through G3[X, int32], is
// rejected for its miss and undone; the next input naming it is rejected again.
func TestReplUnnamedInstanceNamedAfterUndo() testing.TestResult {
	var c @Checker = replSession(
			@[]*[]readonly char{"type M[U any] struct { k *K[@T, U] }",
					"type G3[S any, U any] struct { m *M[U]; s S }",
					"func f[X any](g *G3[X, int32]) int { return 0 }"})
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	replCheckDeclUndo(c, "var m M[int32]")
	var before int = len(c.CheckerErrors())
	replCheckDecl(c, "var m2 M[int32]")
	if before != 1 || len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c, "(in M[int32], instantiated at <repl>:1:9)") {
		return fail(buf.Concat("expected M[int32]'s miss reported at each input; ", allErrorMsgs(c)))
	}
	return ""
}
