package "pkg/binate/check"

import "pkg/builtins/testing"

// unsafe_cast's unchecked interface narrowing takes the targets a type assertion
// could name (isAssertableConcreteTarget; spec §8.7, §11.12).

// narrowCheck checks body inside `func f(m @any, r *any)` with a named struct T,
// a named type H over a managed pointer, an alias A of an array, and an alias S
// of an anonymous struct in scope.
func narrowCheck(body *[]readonly char) @Checker {
	var src @[]char = "package \"test\"\n"
			"type T struct { x int }\n"
			"type H @T\n"
			"type A = [2]int\n"
			"type S = struct { x int }\n"
			"func f(m @any, r *any) {\n"
	src = concatAssert(src, body)
	src = concatAssert(src, "\n}\n")
	return checkSrc(src)
}

// Pointers to, and values of, named types recover in every kind — including
// `*I -> @T` — and so do slices and a named type over a pointer.
func TestUnsafeCastNarrowAcceptsNameableTargets() testing.TestResult {
	return expectNoErrors(
			narrowCheck(
					"var a @T = unsafe_cast(@T, m); var b *T = unsafe_cast(*T, m)\n"
							"var c T = unsafe_cast(T, m); var d *T = unsafe_cast(*T, r)\n"
							"var e T = unsafe_cast(T, r); var g @T = unsafe_cast(@T, r)\n"
							"var h H = unsafe_cast(H, m); var i int = unsafe_cast(int, m)\n"
							"var j @[]int = unsafe_cast(@[]int, m); var k *[]int = unsafe_cast(*[]int, r)\n"
							"_ = a; _ = b; _ = c; _ = d; _ = e; _ = g; _ = h; _ = i; _ = j; _ = k"))
}

// An array, through an alias too, is not a target an assertion can name.
func TestUnsafeCastNarrowRejectsArrayAlias() testing.TestResult {
	return expectErrSub(narrowCheck("var a A = unsafe_cast(A, m); _ = a"),
			"unsafe_cast recovers from an interface value only what a type assertion could name")
}

// Nor is an anonymous struct, through an alias, or a pointer to one.
func TestUnsafeCastNarrowRejectsAnonStruct() testing.TestResult {
	return expectErrSub(narrowCheck("var s *S = unsafe_cast(*S, m); _ = s"),
			"unsafe_cast recovers from an interface value only what a type assertion could name")
}

// A function value is not a target either.
func TestUnsafeCastNarrowRejectsFuncValue() testing.TestResult {
	return expectErrSub(narrowCheck("var g @func() int = unsafe_cast(@func() int, m); _ = g"),
			"unsafe_cast recovers from an interface value only what a type assertion could name")
}

// The target is checked as written, not peeled: a NAMED array is a value an
// assertion can name, so unsafe_cast accepts it and cast points to the
// assertion or unsafe_cast.
func TestUnsafeCastNarrowNamedArray() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type NA [2]int\n"
			"func f(m @any) { var a NA = unsafe_cast(NA, m); _ = a }\n"
	var r testing.TestResult = expectNoErrors(checkSrc(src))
	if len(r) > 0 {
		return r
	}
	return expectErrSub(
			checkSrc(
					"package \"test\"\n"
							"type NA [2]int\n"
							"func f(m @any) { var a NA = cast(NA, m); _ = a }\n"),
			"cast cannot recover a concrete type from an interface value")
}

// A generic unsafe_cast is checked on each instance: an array type argument is
// rejected, a named one accepted.
func TestUnsafeCastNarrowInstances() testing.TestResult {
	var bad *[]readonly char = "package \"test\"\n"
			"func F[T any](m @any) T { return unsafe_cast(T, m) }\n"
			"func g(m @any) { var a [2]int = F[[2]int](m); _ = a }\n"
	var r testing.TestResult = expectErrSub(checkSrc(bad),
			"unsafe_cast recovers from an interface value only what a type assertion could name")
	if len(r) > 0 {
		return r
	}
	return expectNoErrors(
			checkSrc(
					"package \"test\"\n"
							"type Box struct { v int }\n"
							"func F[T any](m @any) T { return unsafe_cast(T, m) }\n"
							"func g(m @any) { var b Box = F[Box](m); _ = b }\n"))
}

// An undefined target is reported once, as undefined — not also as a target an
// assertion cannot name.
func TestUnsafeCastNarrowUndefinedTargetReportedOnce() testing.TestResult {
	return expectOneErr(narrowCheck("var x int = unsafe_cast(Undef, m); _ = x"), "undefined")
}

// A raw interface value cast to a managed one is reported as that, not as a
// narrowing.
func TestCastRawToManagedIfaceMessage() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\n"
							"interface A { f() int }\n"
							"func h(r *A) { var a @A = cast(@A, r); _ = a }\n"),
			"cast cannot convert a raw interface value to a managed one")
}

// A pointer-to-pointer target is reported with the targets that can be
// recovered.
func TestCastPointerToPointerTargetMessage() testing.TestResult {
	return expectErrSub(narrowCheck("var p **T = cast(**T, m); _ = p"),
			"only a pointer to, or a value of, a named type")
}
