package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/std/vec"

// Typing of untyped non-constant integer expressions (spec §13.5
// expr.shift.untyped-value): a shift that is not a constant expression but
// whose value operand is untyped, and a `-` / `~` / `+` / arithmetic / bitwise
// operator combining such an expression with untyped integer constants.  Such
// an expression is typed exactly as an untyped integer constant in the same
// position would be.  While it is checked it carries a NonConst untyped-int
// type; as soon as its context is known the context's type is recorded on
// every node of it (fixUntypedNonConst), and any still untyped when its
// declaration is done gets the default `int` (finalizeUntypedNonConst).
// IR-gen reads the recorded types.

// makeUntypedIntNonConst returns a fresh untyped-int type marked NonConst.
func makeUntypedIntNonConst() @types.Type {
	var t @types.Type = make(types.Type)
	t.Kind = types.TYP_UNTYPED_INT
	t.Name = types.TypUntypedInt().Name
	t.NonConst = true
	return t
}

// isUntypedNonConst reports whether t is an untyped non-constant integer type.
func isUntypedNonConst(t @types.Type) bool {
	return t != nil && t.Kind == types.TYP_UNTYPED_INT && t.NonConst
}

// exprTypeOf returns the type recorded for e, or nil when none is.
func exprTypeOf(c @Checker, e @ast.Expr) @types.Type {
	if e == nil || e.ResolvedTypeID <= 0 || e.ResolvedTypeID >= c.NumExprTypes {
		return nil
	}
	return c.ExprTypes[e.ResolvedTypeID]
}

// noteUntypedNonConst records e as awaiting a type (checkExpr calls it for
// every expression it types untyped non-constant).
func noteUntypedNonConst(c @Checker, e @ast.Expr) {
	if c.UntypedNonConst == nil {
		c.UntypedNonConst = vec.New[@ast.Expr]()
	}
	c.UntypedNonConst.Push(e)
}

// isIntegerTarget reports whether t is a concrete integer type — or a
// named-distinct, alias, or `readonly` type whose underlying type is one.
func isIntegerTarget(t @types.Type) bool {
	var u @types.Type = types.PeelNamedBounded(t)
	return u != nil && u.Kind == types.TYP_INT
}

// isInterfaceTarget reports whether t is an interface value type (`*I`, `@I`,
// `*any`, `@any`), wrappers peeled.
func isInterfaceTarget(t @types.Type) bool {
	var u @types.Type = types.PeelNamedBounded(t)
	return u != nil &&
			(u.Kind == types.TYP_INTERFACE_VALUE || u.Kind == types.TYP_INTERFACE_VALUE_MANAGED)
}

// fixUntypedNonConst gives e — if it is an untyped non-constant integer
// expression — the type t its context requires.  An interface target gives
// the default `int` (the expression then converts as an `int` value would);
// any other non-integer target is an error, since the value of a shift must be
// an integer, and `int` is then used so checking continues.
func fixUntypedNonConst(c @Checker, e @ast.Expr, t @types.Type) {
	if !isUntypedNonConst(exprTypeOf(c, e)) {
		return
	}
	var target @types.Type = t
	if target == nil || target.Kind == types.TYP_UNTYPED_INT || isInterfaceTarget(target) {
		target = types.TypInt()
	} else if !isIntegerTarget(target) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("the value of a shift must be an integer, but here it would have type ")
		cb.Write(target.TypeName())
		addCheckError(c, e.Pos, buf.CopyStr(cb.String()))
		target = types.TypInt()
	}
	setUntypedTypeDown(c, e, target)
}

// typeUntypedAt gives e the type dst of a boundary it is assigned across
// (variable, field, element, parameter, result, switch case) when e is an
// untyped non-constant integer expression and dst is an integer or interface
// type.  Any other dst is left to the boundary's own assignability check,
// which rejects an untyped integer there.
func typeUntypedAt(c @Checker, e @ast.Expr, dst @types.Type) {
	if dst == nil || !isUntypedNonConst(exprTypeOf(c, e)) {
		return
	}
	if isIntegerTarget(dst) || isInterfaceTarget(dst) {
		fixUntypedNonConst(c, e, dst)
	}
}

// setUntypedTypeDown records t on e and on every node the type flows down to
// — the operands of `-`, `~`, `+`, and the arithmetic and bitwise operators,
// and the value operand of each shift (never a shift count, which is its own
// position) — stopping at nodes that are not untyped non-constant.  Each
// maximal untyped constant reached this way must fit t (spec §6.4
// const.expr.fit); a constant whose fold the checker deferred (no value yet)
// is not checked.
func setUntypedTypeDown(c @Checker, e @ast.Expr, t @types.Type) {
	var et @types.Type = exprTypeOf(c, e)
	if et == nil {
		return
	}
	if isUntypedNonConst(et) {
		c.ExprTypes[e.ResolvedTypeID] = t
		if e.Kind == ast.EXPR_BINARY {
			setUntypedTypeDown(c, e.X, t)
			if e.Op != cast(int, token.SHL) && e.Op != cast(int, token.SHR) {
				setUntypedTypeDown(c, e.Y, t)
			}
			return
		}
		if e.Kind == ast.EXPR_UNARY {
			setUntypedTypeDown(c, e.X, t)
			return
		}
		if e.Kind == ast.EXPR_BUILTIN && len(e.Args) == 2 &&
				(e.Op == cast(int, token.UNSAFE_SHL) || e.Op == cast(int, token.UNSAFE_SHR)) {
			setUntypedTypeDown(c, e.Args[0], t)
		}
		return
	}
	if et.Kind == types.TYP_UNTYPED_INT && et.HasLitVal && !untypedIntLitFitsTarget(et, t) {
		errCannotAssign(c, e.Pos, et, t)
	}
}

// finalizeUntypedNonConst gives every expression still untyped non-constant —
// one whose context required no type — the default `int` (spec §6.2), with the
// same constant-fit checks, and empties the list.
func finalizeUntypedNonConst(c @Checker) {
	if c.UntypedNonConst == nil {
		return
	}
	var pending @[]@ast.Expr = c.UntypedNonConst.Items()
	c.UntypedNonConst = nil
	for i := 0; i < len(pending); i++ {
		if isUntypedNonConst(exprTypeOf(c, pending[i])) {
			setUntypedTypeDown(c, pending[i], types.TypInt())
		}
	}
}

// checkUntypedValueShift types a shift (`<<` / `>>`, or unsafe_shl /
// unsafe_shr) whose value operand is untyped.  A shift whose value and count
// are both constants is a constant expression folded at constant precision —
// with a typed constant count too, whose type never contributes.  Otherwise the
// shift is an untyped non-constant integer expression.  Returns nil (the
// caller's regular shift typing applies) when the value operand is typed, is
// not an integer, or both operands are untyped constants (the regular fold).
func checkUntypedValueShift(c @Checker, pos token.Pos, op int, count @ast.Expr, lt @types.Type,
		rt @types.Type) @types.Type {
	if lt == nil || rt == nil || lt.Kind != types.TYP_UNTYPED_INT || !rt.IsInteger() {
		return nil
	}
	if isUntypedNonConst(lt) || isUntypedNonConst(rt) {
		return makeUntypedIntNonConst()
	}
	if rt.Kind == types.TYP_UNTYPED_INT {
		return nil
	}
	// The count's exact value: a uint64 count >= 2^63 is a huge count (the
	// shift is -1, 0, or out of range), not a negative one.
	var n bignum.Num
	var k int
	n, k = foldConstNum(c, count)
	if k != FOLD_OK {
		var cv int
		var isConst bool
		cv, isConst = evalConstIntValue(c, count)
		if !isConst {
			return makeUntypedIntNonConst()
		}
		n = hostIntAtType(cv, rt)
	}
	return foldIntBitwise(c, pos, op, lt, untypedIntOfNum(n))
}

// hostIntAtType reads v, a constant folded through a host int (so holding its
// two's-complement bit pattern), as a value of the integer type t: for an
// unsigned t the low bits of t's width, non-negative; otherwise v itself.
func hostIntAtType(v int, t @types.Type) bignum.Num {
	var p @types.Type = types.PeelNamedBounded(t)
	if p == nil || p.Kind != types.TYP_INT || p.Signed {
		return bignum.FromInt64(cast(int64, v))
	}
	var u uint64 = cast(uint64, cast(int64, v))
	var w int = p.SizeOf() * 8
	if w < 64 {
		u = u & ((cast(uint64, 1) << cast(uint64, w)) - 1)
	}
	return bignum.FromUint64(u)
}

// checkUntypedNonConstOperands types a non-shift binary operator one of whose
// operands is an untyped non-constant integer expression.  A typed peer gives
// it the peer's type (and the operator is then checked as an operator over two
// peers); against another untyped integer operand an arithmetic or bitwise
// operator stays untyped non-constant, and a comparison gives both the default
// `int`; an untyped floating-point, boolean, or string peer is an error.
// Returns nil when neither operand is untyped non-constant, or the operator is
// `&&` / `||` (whose regular checks reject an integer operand).
func checkUntypedNonConstOperands(c @Checker, e @ast.Expr, lt @types.Type,
		rt @types.Type) @types.Type {
	if !isUntypedNonConst(lt) && !isUntypedNonConst(rt) {
		return nil
	}
	if e.Op == cast(int, token.LAND) || e.Op == cast(int, token.LOR) {
		return nil
	}
	var cmp bool = e.Op == cast(int, token.EQ) || e.Op == cast(int, token.NEQ) ||
			e.Op == cast(int, token.LT) || e.Op == cast(int, token.GT) || e.Op == cast(int, token.LEQ) ||
			e.Op == cast(int, token.GEQ)
	var lUntyped bool = lt != nil && lt.Kind == types.TYP_UNTYPED_INT
	var rUntyped bool = rt != nil && rt.Kind == types.TYP_UNTYPED_INT
	if lUntyped && rUntyped {
		if !cmp {
			return makeUntypedIntNonConst()
		}
		fixUntypedNonConst(c, e.X, types.TypInt())
		fixUntypedNonConst(c, e.Y, types.TypInt())
		return checkBinaryOp(c, e.Pos, e.Op, types.TypInt(), types.TypInt())
	}
	var peer @types.Type = rt
	if !lUntyped {
		peer = lt
	}
	if peer == nil || peer.Kind == types.TYP_UNTYPED_FLOAT || peer.Kind == types.TYP_UNTYPED_BOOL ||
			peer.Kind == types.TYP_UNTYPED_STRING {
		addCheckError(c, e.Pos,
				"an untyped integer shift expression cannot be combined with an untyped non-integer constant")
		return types.TypError()
	}
	fixUntypedNonConst(c, e.X, peer)
	fixUntypedNonConst(c, e.Y, peer)
	return checkBinaryOp(c, e.Pos, e.Op, peer, peer)
}
