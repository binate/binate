package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_untyped_shift.bn: an untyped constant shift value with a
// non-constant count takes its type from the shift's context (spec §13.5
// expr.shift.untyped-value), recorded on every node the type flows down to.

// shiftDeclSrc returns a package source declaring `var n uint8 = 9`, `var m
// uint8 = 240` and `var x int32 = 1`, followed by decl (the declaration under
// test, which is therefore file.Decls[3]).
func shiftDeclSrc(decl *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nvar n uint8 = 9\nvar m uint8 = 240\nvar x int32 = 1\n")
	cb.Write(decl)
	cb.Write("\n")
	return buf.CopyStr(cb.String())
}

// shiftDeclValue checks shiftDeclSrc(decl) and returns the checker and the
// initializer of the declaration under test.
func shiftDeclValue(decl *[]readonly char) (@Checker, @ast.Expr) {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(shiftDeclSrc(decl))
	return c, file.Decls[3].Value
}

// isIntType reports whether t is a concrete integer type of the given width
// and signedness.
func isIntType(t @types.Type, width int, signed bool) bool {
	return t != nil && t.Kind == types.TYP_INT && t.Width == width && t.Signed == signed
}

// The shift takes the declared type of the variable it initializes.
func TestUntypedShiftTakesDeclType() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var b int64 = 1 << n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !isIntType(c.ExprType(e.ResolvedTypeID), 64, true) {
		return "`var b int64 = 1 << n` must type the shift int64, not the count's uint8"
	}
	return ""
}

// Where no type is required the shift takes the default int.
func TestUntypedShiftDefaultsToInt() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var y = 1 << n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if c.ExprType(e.ResolvedTypeID) != types.TypInt() {
		return "`var y = 1 << n` must default the shift to int"
	}
	return ""
}

// The type flows down through `~` to the shift, from a typed peer.
func TestUntypedShiftFlowsThroughComplement() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var e uint8 = m & ~(1 << n)")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var notExpr @ast.Expr = e.Y
	if !isIntType(c.ExprType(notExpr.ResolvedTypeID), 8, false) ||
			!isIntType(c.ExprType(notExpr.X.ResolvedTypeID), 8, false) {
		return "`m & ~(1 << n)` must type both the ~ and the shift uint8"
	}
	return ""
}

// A shift used as another shift's value takes the outer shift's type; a shift
// used as a count is its own position (default int).
func TestUntypedShiftValueVsCountPosition() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var f uint8 = (1 << n) << 2")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !isIntType(c.ExprType(e.X.ResolvedTypeID), 8, false) {
		return "the value shift of `(1 << n) << 2` must be uint8"
	}
	c, e = shiftDeclValue("var u uint8 = 1 << (1 << n)")
	r = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !isIntType(c.ExprType(e.ResolvedTypeID), 8, false) { return "the outer shift must be uint8" }
	if c.ExprType(e.Y.ResolvedTypeID) != types.TypInt() {
		return "a shift in count position must default to int, not take the outer type"
	}
	return ""
}

// A typed operand gives its type to the untyped shift (the typed operand wins
// over the declaration's type).
func TestUntypedShiftTypedPeerWins() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var g int32 = x + (1 << n)")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !isIntType(c.ExprType(e.Y.ResolvedTypeID), 32, true) {
		return "`x + (1 << n)` (x int32) must type the shift int32"
	}
	var c2 @Checker
	var e2 @ast.Expr
	c2, e2 = shiftDeclValue("var h int64 = x + (1 << n)")
	_ = e2
	return expectError(c2)
}

// Each maximal untyped constant subexpression must fit the final type.
func TestUntypedShiftConstantsFitFinalType() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var ok uint8 = (1 << n) + (300 - 100)")
	_ = e
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c, e = shiftDeclValue("var bad uint8 = (1 << n) + (0 - 1)")
	if len(expectError(c)) > 0 { return "(0 - 1) does not fit uint8" }
	c, e = shiftDeclValue("var big uint8 = 256 << n")
	if len(expectError(c)) > 0 { return "256 does not fit uint8" }
	c, e = shiftDeclValue("var neg int8 = -1 << n")
	return expectNoErrors(c)
}

// A non-integer context is an error; so are a floating-point shift value and
// mixing with an untyped floating-point constant.
func TestUntypedShiftNonIntegerContextErrors() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var p float64 = cast(float64, 1 << n)")
	_ = e
	if len(expectError(c)) > 0 { return "cast(float64, 1 << n) must be an error" }
	c, e = shiftDeclValue("var f float64 = 1 << n")
	if len(expectError(c)) > 0 { return "var f float64 = 1 << n must be an error" }
	c, e = shiftDeclValue("var y int = 1.0 << n")
	if len(expectError(c)) > 0 { return "1.0 << n must be an error" }
	c, e = shiftDeclValue("var z int = (1 << n) + 1.5")
	if len(expectError(c)) > 0 { return "(1 << n) + 1.5 must be an error" }
	c, e = shiftDeclValue("var w int64 = cast(int64, 1 << n)")
	return expectNoErrors(c)
}

// A shift whose untyped value and count are both constants — here a typed
// constant count — folds to an untyped constant; the count's type does not
// type it.
func TestConstShiftTypedCountFoldsUntyped() testing.TestResult {
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile("package \"test\"\nconst K uint8 = 3\nvar v int64 = 1 << K\n")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	var t @types.Type = c.ExprType(file.Decls[1].Value.ResolvedTypeID)
	if t == nil || t.Kind != types.TYP_UNTYPED_INT || !t.HasLitVal || t.LitMag != cast(uint64, 8) {
		return "`1 << K` (const K uint8 = 3) must fold to the untyped constant 8"
	}
	c, file = checkSrcReturningFile("package \"test\"\nconst K uint8 = 3\nvar w uint8 = 64 << K\n")
	return expectError(c)
}

// unsafe_shl with an untyped value is typed from its context too.
func TestUnsafeShlTypedFromContext() testing.TestResult {
	var c @Checker
	var e @ast.Expr
	c, e = shiftDeclValue("var s int64 = unsafe_shl(1, n)")
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if !isIntType(c.ExprType(e.ResolvedTypeID), 64, true) {
		return "`var s int64 = unsafe_shl(1, n)` must type the shift int64"
	}
	return ""
}
