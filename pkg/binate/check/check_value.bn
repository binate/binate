package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"

// Single values (func.call.value).  A call with no result is not a value — it
// is used only as an expression statement or a deferred call — and a call with
// several results is a value list, not a value: only a multi-value assignment
// or short variable declaration, or a tail `return`, distributes its results.
// checkExpr enforces this for every expression; the sites where a
// multi-result or no-result call is legal check their operand with
// checkExprRaw instead.

// checkExpr type-checks an expression that must be a single value: a call
// with no result, or with several, is reported ("has no value" / "returns N
// values") and typed TypError — the error type, which assignability, operators,
// conditions, callees and the distributing sites do not report again.
func checkExpr(c @Checker, e @ast.Expr) @types.Type {
	var t @types.Type = checkExprRaw(c, e)
	if t == nil || e == nil {
		return t
	}
	if t.Kind == types.TYP_TUPLE {
		var cb @strings.Builder = strings.NewBuilder()
		writeCallText(cb, e)
		cb.Write(" returns ")
		cb.Write(strconv.Itoa(len(t.Results)))
		cb.Write(" values, not a single value")
		addCheckError(c, e.Pos, buf.CopyStr(cb.String()))
		return types.TypError()
	}
	if t.Kind == types.TYP_VOID && isNoResultCall(e) {
		var cb @strings.Builder = strings.NewBuilder()
		writeCallText(cb, e)
		cb.Write(" has no value")
		addCheckError(c, e.Pos, buf.CopyStr(cb.String()))
		return types.TypError()
	}
	return t
}

// checkExprRaw type-checks an expression, registers its type, and returns it —
// for a call, possibly TypVoid (no result) or a result tuple (several); the
// single-value form, checkExpr, is what nearly every context uses.
func checkExprRaw(c @Checker, e @ast.Expr) @types.Type {
	if e == nil {
		return types.TypVoid()
	}

	var t @types.Type = checkExprInner(c, e)
	e.ResolvedTypeID = registerExprType(c, t)
	recordConst(c, e)
	if isUntypedNonConst(t) {
		noteUntypedNonConst(c, e)
	}
	return t
}

// callResultsType is the type of a call whose callee's (substituted) results
// are `results`: TypVoid for none, the result for one, and a result tuple for
// several.
func callResultsType(results @[]@types.Type) @types.Type {
	if len(results) == 0 {
		return types.TypVoid()
	}
	if len(results) == 1 {
		return results[0]
	}
	return types.MakeTupleType(results)
}

// isNoResultCall reports whether e — typed TypVoid — is a call with no
// result: a call (the call paths type an error TypError, so their TypVoid
// means no result), or a `__c_call` with the void result spelling.
func isNoResultCall(e @ast.Expr) bool {
	if e.Kind == ast.EXPR_CALL {
		return true
	}
	return e.Kind == ast.EXPR_BUILTIN && e.Op == cast(int, token.C_CALL) && e.TypeRef == nil
}

// writeCallText names a call for a diagnostic by its callee's spelling —
// `f()`, `pkg.f()`, `x.y.m()`, `F[…]()`, `mk()()` — or `__c_call(…)`; a call
// whose callee is spelled any other way (a function literal) is `call`.
func writeCallText(cb @strings.Builder, e @ast.Expr) {
	if e.Kind == ast.EXPR_BUILTIN {
		cb.Write("__c_call(…)")
		return
	}
	var callee @strings.Builder = strings.NewBuilder()
	if e.X != nil && writeCalleeText(callee, e.X) {
		cb.Write(callee.String())
		cb.Write("()")
		return
	}
	cb.Write("call")
}

// writeCalleeText writes the spelling of callee x — a name, or a selector, a
// generic instantiation or a call built on one — and reports whether it could.
func writeCalleeText(cb @strings.Builder, x @ast.Expr) bool {
	if x.Kind == ast.EXPR_IDENT {
		cb.Write(x.Name)
		return true
	}
	if x.X == nil ||
			!(x.Kind == ast.EXPR_SELECTOR || x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX ||
					x.Kind == ast.EXPR_CALL) {
		return false
	}
	if !writeCalleeText(cb, x.X) {
		return false
	}
	if x.Kind == ast.EXPR_SELECTOR {
		cb.WriteByte('.')
		cb.Write(x.Name)
	} else if x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		cb.Write("[…]")
	} else {
		cb.Write("()")
	}
	return true
}
