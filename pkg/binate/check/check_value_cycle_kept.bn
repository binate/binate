package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// valueAcyclicKept holds the named types checkTypeByValueCycle's walks have found to
// hold no by-value cycle: nothing they hold by value, at any depth, holds itself by
// value, and every named type among it has its underlying type.  So a walk looking
// for a type held by value stops at one: it cannot reach the type it looks for, which
// would then be on a cycle there.  Filling in a type not among them changes none of
// them; any other change to a type (typeGraphChanges) empties the set.
type valueAcyclicKept struct {
	types   @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]
	changes int
}

// valueAcyclicOf returns c's valueAcyclicKept, emptied if a type has changed since it
// was filled.
func valueAcyclicOf(c @Checker) @valueAcyclicKept {
	if c.ValueAcyclic == nil || c.ValueAcyclic.changes != typeGraphChanges(c) {
		var k @valueAcyclicKept = make(valueAcyclicKept)
		k.types = newTypeSet()
		k.changes = typeGraphChanges(c)
		c.ValueAcyclic = k
	}
	return c.ValueAcyclic
}

// typeGraphChanges returns the number of changes to types other than filling in an
// underlying type (noteTypeGraphChanged) the checker has made so far.
func typeGraphChanges(c @Checker) int {
	return opaqueFreeOf(c).Changes
}

// acyclicItem is a type reachesNamedKept has still to look at, or, with exit, the named
// type whose parts it has all looked at.
type acyclicItem struct {
	t    @types.Type
	exit bool
}

// acyclicFrame is a named type reachesNamedKept is inside (or nil, for the type it
// starts at), and whether each named type met in it so far is kept, or was walked and
// kept in turn (clean).
type acyclicFrame struct {
	t     @types.Type
	clean bool
}

// acyclicWork is reachesNamedKept's work list, kept from one walk to the next; a walk
// leaves it as it found it.
var acyclicWork @vec.Vec[acyclicItem]

// acyclicPath is the path of named types reachesNamedKept is inside, kept from one walk
// to the next; a walk leaves it as it found it.
var acyclicPath @vec.Vec[acyclicFrame]

// reachesNamedKept reports whether t reaches the named type target by value -- through
// struct fields, array elements, readonly and alias and named-to-underlying links,
// stopping at a pointer, slice or managed wrapper: target behind `*target` or
// `@target` is a recursive type such as a linked-list node, held by no value.  visited
// holds the named types it enters, shared by every branch: one entered again adds no
// reach of target -- it was walked to the end without reaching it, or it is on the path
// being walked, on another by-value cycle, whose walk would not end.  It does not walk
// a named type in kept, which holds no
// by-value cycle and so cannot reach target, and adds to kept each named type it walks
// when every named type among its parts is kept or added in turn, and none is met
// again (on a cycle, or walked already and not kept) or has no underlying type yet.
// It sets *clean false unless t is such too, and when it reaches target.
func reachesNamedKept(t @types.Type, target @types.Type, visited *typeVisits,
		kept @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq], clean *bool) bool {
	if acyclicWork == nil {
		acyclicWork = vec.New[acyclicItem]()
		acyclicPath = vec.New[acyclicFrame]()
	}
	var workBase int = acyclicWork.Len()
	var pathBase int = acyclicPath.Len()
	var root acyclicFrame
	root.clean = true
	acyclicPath.Push(root)
	pushAcyclic(t, false)
	var found bool = false
	for !found && acyclicWork.Len() > workBase {
		it, _ := acyclicWork.Pop()
		found = acyclicStep(it, target, visited, kept)
	}
	if found || !acyclicPath.Get(pathBase).clean { *clean = false }
	for acyclicWork.Len() > workBase {
		_, _ = acyclicWork.Pop()
	}
	for acyclicPath.Len() > pathBase {
		_, _ = acyclicPath.Pop()
	}
	return found
}

// acyclicStep looks at it for reachesNamedKept: it reports whether it is target, and
// otherwise pushes what it holds by value, or, at a named type's exit, keeps it if it
// is clean and makes the frame it is in not clean if not.
func acyclicStep(it acyclicItem, target @types.Type, visited *typeVisits,
		kept @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]) bool {
	var t @types.Type = it.t
	if it.exit {
		f, _ := acyclicPath.Pop()
		if f.clean {
			kept.Put(f.t, true)
		} else {
			acyclicUnclean()
		}
		return false
	}
	if t == nil { return false }
	if t.Kind == types.TYP_ALIAS {
		pushAcyclic(t.Target, false)
	} else if t.Kind == types.TYP_READONLY || t.Kind == types.TYP_ARRAY {
		pushAcyclic(t.Elem, false)
	} else if t.Kind == types.TYP_STRUCT {
		for i := len(t.Fields) - 1; i >= 0; i-- {
			pushAcyclic(t.Fields[i].Type, false)
		}
	} else if t.Kind == types.TYP_NAMED {
		if same(t, target) { return true }
		if kept.Has(t) { return false }
		if t.Underlying == nil || !visited.enter(t) {
			acyclicUnclean()
			return false
		}
		var f acyclicFrame
		f.t = t
		f.clean = true
		acyclicPath.Push(f)
		pushAcyclic(t, true)
		pushAcyclic(t.Underlying, false)
	}
	return false
}

// pushAcyclic pushes t on reachesNamedKept's work list, as a type to look at, or with
// exit, as the end of the named type t's parts.
func pushAcyclic(t @types.Type, exit bool) {
	var it acyclicItem
	it.t = t
	it.exit = exit
	acyclicWork.Push(it)
}

// acyclicUnclean marks the innermost frame of reachesNamedKept's path not clean.
func acyclicUnclean() {
	var top int = acyclicPath.Len() - 1
	var f acyclicFrame = acyclicPath.Get(top)
	f.clean = false
	acyclicPath.Set(top, f)
}
