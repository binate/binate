package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_value_cycle_kept.bn: the named types the by-value cycle check keeps
// as holding no cycle.

// acyclicTestChain returns n named types main.<p>0 .. main.<p>(n-1), each a struct
// holding the next by value, the last a struct holding leaf.
func acyclicTestChain(p *[]readonly char, n int, leaf @types.Type) @[]@types.Type {
	var out @[]@types.Type = make_slice(@types.Type, n)
	var next @types.Type = leaf
	for i := n - 1; i >= 0; i-- {
		var fs @[]@types.Field = make_slice(@types.Field, 1)
		fs[0] = make(types.Field)
		fs[0].Name = "v"
		fs[0].Type = next
		var named @types.Type = types.MakeNamedType(buf.Concat(buf.Concat("main.", p), strconv.Itoa(i)))
		named.Underlying = types.MakeStructType("", fs)
		out[i] = named
		next = named
	}
	return out
}

// acyclicTestDecl returns a type declaration named name.
func acyclicTestDecl(name *[]readonly char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_TYPE
	d.Name = buf.CopyStr(name)
	return d
}

// Checked from the top, a chain over int keeps every link, and a link checked after
// is found kept; a type over a ring that does not pass through it is not reported and
// keeps nothing, so the ring's own types are still checked; a chain whose last link
// holds its first by value is reported once, at the first, and keeps none of its
// links; a chain over a type with no underlying type yet keeps none; a change to a
// type empties the set.
func TestValueAcyclicKept() testing.TestResult {
	var c @Checker = NewChecker()
	var d @ast.Decl = acyclicTestDecl("T")
	var plain @[]@types.Type = acyclicTestChain("A", 6, types.TypInt())
	checkTypeByValueCycle(c, plain[0], d)
	var kept @valueAcyclicKept = valueAcyclicOf(c)
	for i := 0; i < len(plain); i++ {
		if !kept.types.Has(plain[i]) {
			return fail(buf.Concat("a link over int is kept: ", plain[i].Name))
		}
	}
	checkTypeByValueCycle(c, plain[3], d)
	if len(c.CheckerErrors()) != 0 { return fail("a chain over int holds no cycle") }
	var met @[]@types.Type = acyclicTestChain("R", 2, types.TypInt())
	met[1].Underlying.Fields[0].Type = met[0]
	var holder @[]@types.Type = acyclicTestChain("D", 1, met[0])
	checkTypeByValueCycle(c, holder[0], d)
	var ringKept bool = kept.types.Has(holder[0]) || kept.types.Has(met[0]) || kept.types.Has(met[1])
	met[1].Underlying.Fields[0].Type = types.TypInt()
	if len(c.CheckerErrors()) != 0 { return fail("a ring not through D is not D's to report") }
	if ringKept { return fail("nothing on or over a ring is kept") }
	var ring @[]@types.Type = acyclicTestChain("B", 4, types.TypInt())
	ring[3].Underlying.Fields[0].Type = ring[0]
	var before int = typeGraphChanges(c)
	checkTypeByValueCycle(c, ring[0], d)
	if len(c.CheckerErrors()) != 1 { return fail("the ring is reported at its first link") }
	if typeGraphChanges(c) == before { return fail("breaking the ring changes a type") }
	kept = valueAcyclicOf(c)
	if kept.types.Has(plain[0]) { return fail("a change empties the kept types") }
	var open @[]@types.Type = acyclicTestChain("C", 3, types.MakeNamedType(buf.CopyStr("main.P")))
	checkTypeByValueCycle(c, open[0], d)
	for i := 0; i < len(open); i++ {
		if kept.types.Has(open[i]) { return fail("a chain over a type not filled in is not kept") }
	}
	return ""
}
