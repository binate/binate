package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/table"

// checkValueEmbedding rejects an opaque type embedded BY VALUE in a type
// declaration's definition — a struct value field, an array or slice element —
// or a by-value function parameter / return.  It runs AFTER
// collectDecls, when forward references are filled in place — so a TYP_NAMED
// placeholder is now either concrete or a genuine opaque type.  Checking
// these sites inline during collection would race forward-reference
// resolution: a `type Whence int` used before its decl is a not-yet-resolved
// placeholder (nil-Underlying TYP_NAMED), byte-identical to an opaque type.
// Var decls are checked in pass 2 by checkVarDecl (also post-collection).
//
// A generic decl is not re-resolved here — its type-param scope is no longer
// installed, so that would spuriously fail — but checked through its abstract
// instance (checkGenericDeclAbstract) or, for a generic function, its recorded
// signature (requireGenericFuncSigKept): its own parts are held to the same
// rules, where it is written, whether or not it is instantiated (a type
// parameter is not opaque).  Re-resolving each type expression does nothing
// but record again what it denotes (resolveTypeExpr reads the scope and builds
// throwaway Type values; a struct definition is rebuilt unrecorded).
//
// valueAcyclic holds the named types checkTypeDepths found in no by-value cycle; nil
// when it could not tell.
func checkValueEmbedding(c @Checker, decls *[]@ast.Decl,
		valueAcyclic @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]) {
	// The answers kept across the declarations (pointeeMemo), and the layouts: one
	// layout query held open lays each type out once, not once for each declaration
	// holding it, until a type changes (restartHeldLayout).
	var saved @pointeeMemo = c.PointeeMemo
	c.PointeeMemo = newPointeeMemo(c)
	var held bool = c.LayoutHeld
	if !held {
		types.BeginLayoutQuery()
		c.LayoutHeld = true
	}
	checkDeclsEmbedding(c, decls, valueAcyclic)
	if !held {
		c.LayoutHeld = false
		types.EndLayoutQuery()
	}
	c.PointeeMemo = saved
}

// checkDeclsEmbedding is checkValueEmbedding's check of decls, a group's members
// included.
func checkDeclsEmbedding(c @Checker, decls *[]@ast.Decl,
		valueAcyclic @table.Table[@types.Type, bool, typeIdentityHasher, typeIdentityEq]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		// File-scoped imports: field/param/result types may be qualified, so
		// resolve under this decl's file scope (see checkPackageImpl).
		if fileScopedActive(c) {
			c.Scope = scopeForFile(c, d.Pos.File)
		}
		if d.Kind == ast.DECL_GROUP {
			checkDeclsEmbedding(c, d.Decls, valueAcyclic)
			continue
		}
		if len(d.TypeParams) > 0 && d.Kind == ast.DECL_FUNC {
			requireGenericFuncSigKept(c, d)
			continue
		}
		if len(d.TypeParams) > 0 {
			checkGenericDeclAbstract(c, d)
			continue
		}
		// A method on a generic type binds the type's parameters; its param /
		// result types reference those binders, which are not in scope here, so
		// resolving them for the sizing check would spuriously report `undefined:
		// T` — its recorded signature is judged with its body instead
		// (checkFuncDecl: requireGenericMethodSigKept).
		if d.Kind == ast.DECL_FUNC && d.Recv != nil && receiverBaseInstantiation(d.Recv.Type) != nil {
			continue
		}
		// Reject a type whose underlying STRUCT or ARRAY contains itself BY VALUE
		// (`type C struct { self C }`, `type C [2]C`, or through a named-distinct
		// wrapper `type C struct { d D }; type D C`).  Runs here (post-collection)
		// rather than in collectTypeDecl so EVERY named type's underlying is filled —
		// a wrapper cycle is then visible regardless of decl order.  Must precede the
		// requireSizedType walk below (and IR-gen's size/destruction/ABI walks), which
		// recurse through by-value fields/elements and would otherwise stack-overflow;
		// checkTypeByValueCycle poisons the offending field/element so those walks
		// terminate.  Runs for every type decl (an array/struct underlying may be
		// reached only through a named-distinct wrapper decl) but those the depth
		// walk found in no by-value cycle (valueAcyclic).
		if d.Kind == ast.DECL_TYPE {
			var tsym @Symbol = c.Scope.Lookup(d.Name)
			if tsym != nil && (valueAcyclic == nil || !valueAcyclic.Has(tsym.Type)) {
				checkTypeByValueCycle(c, tsym.Type, d)
			}
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			for j := 0; j < len(d.TypeRef.Fields); j++ {
				requireSizedType(c, resolveTypeExpr(c, d.TypeRef.Fields[j].Type), d.Pos)
			}
			// Fields that each fit can add up past the target's limit.  The struct
			// is built again unrecorded: the definition's record stays the declared
			// type's underlying, which collectTypeDecl names.
			_ = requireFittingType(c, buildStructType(c, d.TypeRef), d.Pos)
		} else if d.Kind == ast.DECL_TYPE && d.TypeRef != nil {
			// Any other definition is held to the rule a struct field is: one that
			// holds an opaque type by value (`type A [2]Op`, `type S @[]Op`) or
			// points to a type that does (`type P *([2]Op)`) can never be used, so
			// it is rejected where it is declared — a blank or alias declaration
			// included.  A definition that is itself opaque (`type O Op`, a
			// distinct type over an opaque one; §7.12) is used through *O / @O.
			var dt @types.Type = resolveTypeExpr(c, d.TypeRef)
			if !isOpaqueValueType(c, dt) {
				requireSizedType(c, dt, d.Pos)
			}
		}
		if d.Kind == ast.DECL_FUNC { requireFuncDeclSized(c, d) }
		if d.Kind == ast.DECL_INTERFACE && !d.IsAlias {
			// A method's parameter or result that breaks the opaque rules, as a
			// function declaration's would (type.opaque.signature); or one, or its
			// results together, too large for the target (spec type.layout.max-size).
			var isym @Symbol = c.Scope.Lookup(d.Name)
			if isym != nil {
				requireMethodSignaturesKept(c, isym.Type, d.Pos)
				_ = requireFittingParts(c, isym.Type, d.Pos)
			}
		}
	}
}
