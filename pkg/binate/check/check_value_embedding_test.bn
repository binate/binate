package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for check_value_embedding.bn: the checks of a batch's declarations after
// collection.

// The pointer walk's answers are kept while a batch's declarations are checked, and
// only then.
func TestValueEmbeddingKeepsPointeeAnswers() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\ntype Opaque\ntype P1 *Opaque\ntype P0 *P1\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	if c.PointeeMemo != nil { return "the answers are dropped once the batch is checked" }
	if c.LayoutHeld { return "the layout query is closed once the batch is checked" }
	return ""
}
