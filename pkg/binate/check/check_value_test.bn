package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_value.bn: a call with no result, or with several, is not a
// single value (func.call.value).

// A no-result call used as a value — bound, blank-assigned, an operand, a
// condition, a void __c_call — and a multi-result call used as one — bound, a
// callee, an argument — are each one error, not re-reported by their context.
func TestCheckCallValueRejectedOnce() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 8)
	srcs[0] = "package \"test\"\nfunc nothing() {}\nfunc f() {\n\tvar v = nothing()\n\t_ = v\n}\n"
	srcs[1] = "package \"test\"\nfunc nothing() {}\nfunc f() {\n\t_ = nothing()\n}\n"
	srcs[2] = "package \"test\"\nfunc nothing() {}\nfunc f() int {\n\treturn nothing() + 1\n}\n"
	srcs[3] = "package \"test\"\nfunc nothing() {}\nfunc f() {\n\tif nothing() {\n\t}\n}\n"
	srcs[4] = "package \"test\"\nfunc f() {\n\tvar r = __c_call(\"abort\", \"void\")\n\t_ = r\n}\n"
	srcs[5] = "package \"test\"\nfunc two() (int, int) { return 1, 2 }\nfunc f() {\n\tvar w = two()\n"
			"\t_ = w\n}\n"
	srcs[6] = "package \"test\"\nfunc two() (int, int) { return 1, 2 }\nfunc f() {\n"
			"\ta, b := two()()\n\t_ = a\n\t_ = b\n}\n"
	srcs[7] = "package \"test\"\nfunc two() (int, int) { return 1, 2 }\nfunc g(x int, y int) {}\n"
			"func f() {\n\tg(two())\n}\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(srcs[i])
		if len(c.CheckerErrors()) != 1 {
			return fail("a call used as a single value it is not must be one error")
		}
	}
	var c @Checker = checkSrc("package \"test\"\nfunc nothing() {}\nfunc f() {\n\t_ = nothing()\n}\n")
	var r testing.TestResult = expectErrSub(c, "nothing() has no value")
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\nfunc two() (int, int) { return 1, 2 }\nfunc f() {\n\tvar w = two()\n"
					"\t_ = w\n}\n")
	return expectErrSub(c, "two() returns 2 values, not a single value")
}

// A call returning ONE function value is one value, not its value's results:
// it binds, and does not destructure.
func TestCheckCallReturningFuncValueIsOneValue() testing.TestResult {
	var mk *[]readonly char = "package \"test\"\nfunc two() (int, int) { return 1, 2 }\n"
			"func mk() @func() (int, int) { return two }\n"
	var c @Checker = checkSrc(
			buf.Concat(mk, "func f() {\n\tvar g = mk()\n\ta, b := g()\n\t_ = a\n\t_ = b\n}\n"))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	c = checkSrc(buf.Concat(mk, "func f() {\n\ta, b := mk()\n\t_ = a\n\t_ = b\n}\n"))
	return expectErrSub(c, "assignment count mismatch")
}

// Where a multi-result or no-result call is legal it is accepted: an expression
// statement, a deferred call, a destructure, a tail return.
func TestCheckCallValueAcceptedWhereDistributed() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc nothing() {}\nfunc two() (int, int) { return 1, 2 }\n"
					"func fwd() (int, int) { return two() }\n"
					"func f() {\n\tnothing()\n\ttwo()\n\tdefer two()\n\tdefer nothing()\n"
					"\ta, b := two()\n\ta, b = fwd()\n\t_, _ = two()\n\t_ = a\n\t_ = b\n}\n")
	return expectNoErrors(c)
}

// A destructure whose right-hand side is already an error still reports a
// later misuse of a name it did not newly declare, and an undefined target.
func TestCheckCallValueLaterErrorsKept() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc two() (int, int) { return 1, 2 }\n"
					"func f() {\n\tx := 1\n\tx, y := two()()\n\tvar s *[]char = x\n"
					"\tq, undefinedV = two()()\n\t_ = s\n\t_ = y\n\t_ = q\n}\n")
	var r testing.TestResult = expectErrSub(c, "cannot assign")
	if len(r) > 0 { return r }
	return expectErrSub(c, "undefined: undefinedV")
}

// The message names the call by its callee's spelling.
func TestCheckCallValueMessageNamesCallee() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc two() (int, int) { return 1, 2 }\n"
					"func mk() @func() (int, int) { return two }\n"
					"func f() {\n\tvar w = mk()()\n\t_ = w\n}\n")
	return expectErrSub(c, "mk()() returns 2 values")
}
