package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// The placeholders a variable's check reads in its initializer outside the
// array lengths in it, judged when the check ends (judgeFreeReads) — or, when
// reads alone may make the cycle, once the initialization order is found
// (judgeSelfReads); see check_var_placeholder.bn.

// varCheckMark is where the check of a variable begins: the placeholder reads
// logged, the array length depth, and the variables whose type cycle is
// reported, so far.
type varCheckMark struct {
	reads  int
	depth  int
	cycled int
}

// beginVarCheck marks the beginning of the check of the batch's variable d,
// with an inferred type, and returns the mark (VarsChecking); d is being
// resolved meanwhile (enterDeclResolution).
func beginVarCheck(c @Checker, d @ast.Decl) varCheckMark {
	var b @DeclBatch = c.Batch
	enterDeclResolution(c, d)
	var m varCheckMark
	m.reads = len(b.PlaceholderReads)
	m.depth = b.LenDepth
	m.cycled = len(b.VarsCycled)
	b.VarsChecking = slices.Append[@ast.Decl](b.VarsChecking, d)
	b.VarsCheckingLens = slices.Append[int](b.VarsCheckingLens, b.LenDepth)
	return m
}

// endVarCheck ends the check of the batch's variable that beginVarCheck began,
// the last begun, judges its free reads (judgeFreeReads), and reports whether a
// read has waited for a declaration being resolved (leaveDeclResolution).
func endVarCheck(c @Checker, d @ast.Decl, m varCheckMark) bool {
	var b @DeclBatch = c.Batch
	b.VarsChecking = b.VarsChecking[:len(b.VarsChecking) - 1]
	b.VarsCheckingLens = b.VarsCheckingLens[:len(b.VarsCheckingLens) - 1]
	judgeFreeReads(c, d, m)
	return leaveDeclResolution(c)
}

// judgeFreeReads judges the placeholders read in the check of the batch's
// variable d, begun at m, at its own array length depth: in its initializer
// outside the array lengths in it, code that is compiled, which took the
// placeholder for an error already reported.  d's own placeholder read so, its
// type depends on itself; another variable's, whose type was being found and
// needed d's, that one's type depends on itself — unless that variable's own
// check, around d's at the same depth, is what judges it (freeReadVerdict).  A
// variable type cycle reported meanwhile stands for them.  Each read judged is
// marked so (a depth of -1), so that a check around d's does not judge it
// again; so is each read of a check in a layout frame that waits, which is done
// again, and judged then (layoutFrameBlocked).
func judgeFreeReads(c @Checker, d @ast.Decl, m varCheckMark) {
	var b @DeclBatch = c.Batch
	var judging bool = len(b.VarsCycled) == m.cycled && !layoutFrameBlocked(c)
	for i := m.reads; i < len(b.PlaceholderReads); i++ {
		if b.ReadLens[i] != m.depth {
			continue
		}
		var p @ast.Decl = b.PlaceholderReads[i]
		if judging && !declInList(b.VarsCycled, p) {
			var mine bool
			var cycle bool
			mine, cycle = freeReadVerdict(c, d, p, m.depth)
			if !mine {
				continue
			}
			if cycle {
				errVarTypeCycle(c, p)
			}
		}
		b.ReadLens[i] = -1
	}
}

// freeReadVerdict judges the read of p's placeholder in the check of d at the
// array length depth depth (judgeFreeReads), and reports whether it is that
// check's to judge and whether it is a type cycle of p's: not that check's when
// p's own check, around d's at the same depth, judges it; not yet when reads
// alone may make a cycle of d's own, the initialization order's, which judges it
// once it is found (judgeSelfReads); no cycle while types are collected, the read
// of a variable being checked, which is errVarCycle's and defers the check.
func freeReadVerdict(c @Checker, d @ast.Decl, p @ast.Decl, depth int) (bool, bool) {
	var b @DeclBatch = c.Batch
	var checking int = -1
	for i := 0; i < len(b.VarsChecking); i++ {
		if same(b.VarsChecking[i], p) {
			checking = i
		}
	}
	if !same(p, d) && checking < 0 {
		return true, true
	}
	if b.Collecting {
		return true, false
	}
	if same(p, d) {
		if !varOnInitCycle(c, d) {
			return true, true
		}
		if !declInList(b.VarsSelfRead, d) {
			b.VarsSelfRead = slices.Append[@ast.Decl](b.VarsSelfRead, d)
		}
		return true, false
	}
	if b.VarsCheckingLens[checking] == depth {
		return false, false
	}
	return true, true
}

// freeReadOf reports whether the check of the batch's variable d begun at m
// read d's own placeholder at its own array length depth (judgeFreeReads).
func freeReadOf(b @DeclBatch, d @ast.Decl, m varCheckMark) bool {
	for i := m.reads; i < len(b.PlaceholderReads); i++ {
		if same(b.PlaceholderReads[i], d) && b.ReadLens[i] == m.depth {
			return true
		}
	}
	return false
}

// judgeSelfReads judges, once the initialization order is found, each variable
// whose initializer read its own placeholder where reads alone may have made the
// cycle (VarsSelfRead): its type depends on itself unless they do — a cycle the
// order has reported.
func judgeSelfReads(c @Checker) {
	var b @DeclBatch = c.Batch
	for i := 0; i < len(b.VarsSelfRead); i++ {
		var d @ast.Decl = b.VarsSelfRead[i]
		if !declInList(b.VarsCycled, d) && !varOnInitCycle(c, d) {
			errVarTypeCycle(c, d)
		}
	}
}

// judgeSelfReadsUnordered judges the variables on VarsSelfRead where no
// initialization order is found — a package checked for its declarations alone,
// some of whose initializers collection checked: each is a cycle of reads when
// the initializers, as checked so far, make one (errVarCycle), and else a
// variable type cycle.
func judgeSelfReadsUnordered(c @Checker) {
	var b @DeclBatch = c.Batch
	for i := 0; i < len(b.VarsSelfRead); i++ {
		var d @ast.Decl = b.VarsSelfRead[i]
		if declInList(b.VarsCycled, d) {
			continue
		}
		if varOnInitCycle(c, d) {
			errVarCycle(c, d.Pos, d.Name)
		} else {
			errVarTypeCycle(c, d)
		}
	}
}

// varOnInitCycle reports whether the initializer of the batch's variable d reads
// d itself through the initializers it reads (initVarDeps): the initialization
// order reports such a cycle.  Before the initializers they pass through are
// checked, a name whose type is not known yet counts as read, so a cycle found
// then may not be one once they are (judgeSelfReads), but none is missed.
func varOnInitCycle(c @Checker, d @ast.Decl) bool {
	var seen @[]@[]char
	var work @[]@[]char = initVarDeps(c, d.Name)
	for len(work) > 0 {
		var n @[]char = work[len(work) - 1]
		work = work[:len(work) - 1]
		if types.CharEq(n, d.Name) {
			return true
		}
		if !nameInList(seen, n) {
			seen = slices.Append[@[]char](seen, n)
			var deps @[]@[]char = initVarDeps(c, n)
			for i := 0; i < len(deps); i++ {
				work = slices.Append[@[]char](work, deps[i])
			}
		}
	}
	return false
}

// initVarDeps returns the names the initializer of the batch's variable name
// reads, as the initialization order finds them (collectVarDeps), or none.
func initVarDeps(c @Checker, name *[]readonly char) @[]@[]char {
	var deps @[]@[]char
	var d @ast.Decl = findDeclIn(c.Batch.Vars, name)
	if d == nil || d.Value == nil {
		return deps
	}
	var saved declContext = enterPackageDecl(c, d)
	deps = collectVarDeps(c, d.Value, deps)
	leavePackageDecl(c, saved)
	return deps
}
