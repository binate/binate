package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for a package variable whose placeholder is read while its type is
// found, in an initializer outside the array lengths in it — code that is
// compiled, which took the placeholder for an error already reported though
// nothing made the reader's type an error: the variable's type depends on
// itself, a variable type cycle (judgeFreeReads, check_var_free_reads.bn),
// unless the cycle is made of reads alone, which the initialization order
// reports.

// The declarations each test's programs share.
var readCycleDecls *[]readonly char = "package \"test\"\n"
		"type S struct { arr [3]int }\n"
		"func h(n bool) S { var s S; return s }\n"
		"func hi(n int) S { var s S; return s }\n"
		"func g(f @func() int) S { var s S; return s }\n"
		"func pick(f @func() int) [3]int { var r [3]int; return r }\n"
		"func ha(x [3]int) S { var s S; return s }\n"

// b's type depends on a's, which b's call reads as a placeholder, and a's on
// b's, through an array length — whether h takes a bool or an int (checked b
// first, b's placeholder leaves a's array length without a value instead); v's
// declared type the same way, also while the package's types are collected; a's
// type on its own, read in a function literal's body, also when checked again
// after collection.
func TestVarPlaceholderReadIsTypeCycle() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 7)
	var names @[]*[]readonly char = make_slice(*[]readonly char, 7)
	srcs[0] = "var a = len([len(b)]int{})\nvar b = h(a).arr\n"
	names[0] = "variable type cycle involving `a`"
	srcs[1] = "var a = len([len(b)]int{})\nvar b = hi(a).arr\n"
	names[1] = "variable type cycle involving `a`"
	srcs[2] = "var b = hi(a).arr\nvar a = len([len(b)]int{})\n"
	names[2] = "variable type cycle involving `b`"
	srcs[3] = "var v [len(w)]int\nvar w = h(v).arr\n"
	names[3] = "variable type cycle involving `v`"
	srcs[4] = "type T [len(v)]uint8\nvar v [len(w)]int\nvar w = h(v).arr\n"
	names[4] = "variable type cycle involving `v`"
	srcs[5] = "var a = g(func() int { var t bool = a[0]; _ = t; return 0 }).arr\n"
	names[5] = "variable type cycle involving `a`"
	srcs[6] = "type T [len(a)]uint8\n"
			"var a = g(func() int { var t bool = a[0]; _ = t; return 0 }).arr\n"
	names[6] = "variable type cycle involving `a`"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat(readCycleDecls, srcs[i])
		var r testing.TestResult = expectOneErr(checkSrc(src), names[i])
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A cycle of reads alone, the placeholder read the same way, is the
// initialization order's, reported once — also when the check that reads it
// is inside another variable's (z's), which does not judge it again, and when
// it is checked while types are collected, deferred and checked again (x read
// by T's array length), and when the read is the length of a placeholder's
// slice, which reads it whatever its type (`len(d[0:1])`).
func TestVarPlaceholderReadOfReadsIsInitCycle() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 7)
	var names @[]*[]readonly char = make_slice(*[]readonly char, 7)
	srcs[0] = "func g2(x [3]int) S { var s S; return s }\n"
			"var a = g2(b).arr\nvar b = hi(a[0]).arr\n"
	names[0] = "variable initialization cycle involving `a`"
	srcs[1] = "func g2(x [3]int) S { var s S; return s }\n"
			"var z = a\nvar a = g2(b).arr\nvar b = hi(a[0]).arr\n"
	names[1] = "variable initialization cycle involving `a`"
	srcs[2] = "var z = x\nvar x = hi(x[0]).arr\n"
	names[2] = "variable initialization cycle involving `x`"
	srcs[3] = "type R struct { x int }\nfunc (r R) m() int { return r.x }\n"
			"type W struct { r R }\nfunc wrap(n int) W { var w W; return w }\n"
			"var u = v.m()\nvar v = wrap(u).r\n"
	names[3] = "variable initialization cycle involving `u`"
	srcs[4] = "type T [len(x)]uint8\nvar x = hi(x[0]).arr\n"
	names[4] = "variable initialization cycle involving `x`"
	srcs[5] = "var d = hi(len(d[0:1])).arr\n"
	names[5] = "variable initialization cycle involving `d`"
	srcs[6] = "var b = hi(a).arr\nvar a = len(b[0:z]) + 0\nvar z = b[0]\n"
	names[6] = "variable initialization cycle involving `b`"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat(readCycleDecls, srcs[i])
		var r testing.TestResult = expectOneErr(checkSrc(src), names[i])
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// d's type depends on v's, which v's call reads as a placeholder: d's own type
// cycle, also when, while d is checked, reads alone seem to make a cycle of it —
// through x's initializer, not checked yet, taking the length of w, whose type is
// not known yet — which they do not once w is an array: it is judged once pass 2
// is done.  So is a cycle whose only read is the length
// of a placeholder — b's, read by a's initializer while b's type is found, or
// d's own, read by d's — whose value is not known.  One cycle is reported, not a
// type cycle and a cycle of reads both.
// Nor is a cycle of reads reported through `len` of d once d's type cycle is,
// which makes d the error type: x's `len(d)`, not checked when d's cycle is
// judged, does not count as a read.
func TestVarPlaceholderReadThroughLenIsTypeCycle() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 5)
	srcs[0] = "var d = len(v) + 0\nvar v = hi(d).arr\n"
	srcs[1] = "func arrOf(n int) [3]int { var r [3]int; return r }\n"
			"var d = x[0] + len(v)\nvar v = hi(d).arr\n"
			"var x = [3]int{len(w), 0, 0}\nvar w = arrOf(d)\n"
	srcs[2] = "var b = hi(a).arr\nvar a = len(b) + 0\n"
	srcs[3] = "var d = hi(len(w) + x[0]).arr\nvar w = hi(d[0]).arr\nvar x = [3]int{len(d), 0, 0}\n"
	srcs[4] = "var d = hi(len(d)).arr\n"
	var names @[]*[]readonly char = make_slice(*[]readonly char, 5)
	names[0] = "variable type cycle involving `d`"
	names[1] = "variable type cycle involving `d`"
	names[2] = "variable type cycle involving `b`"
	names[3] = "variable type cycle involving `d`"
	names[4] = "variable type cycle involving `d`"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat(readCycleDecls, srcs[i])
		var r testing.TestResult = expectOneErr(checkSrc(src), names[i])
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A cycle of reads beside a variable whose type cycle is reported is still
// reported: a and b read each other, whether or not through x.
func TestVarInitCycleBesideTypeCycle() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "var a int = x[0] + b\nvar x = [len(x)]int{b, 0, 0}\nvar b int = a\n"
	srcs[1] = "var x = [len(x)]int{a, 0, 0}\nvar a int = x[0]\n"
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(buf.Concat(readCycleDecls, srcs[i]))
		if errorsContaining(c, "variable type cycle involving `x`") != 1 ||
				errorsContaining(c, "variable initialization cycle") != 1 {
			return buf.Concat(srcs[i], "expected x's type cycle and one cycle of reads")
		}
	}
	return ""
}

// A generic function's body reading a is checked with a's type, not while a's
// is found; a variable read before its turn with its type known reads no
// placeholder; u's placeholder read in a function literal in u's own array
// length, which is not compiled, is no cycle; nor is x's call of u, x named in
// a function literal in u's array length, which sees u's type.
func TestVarPlaceholderReadNotCycle() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "func gen[T any]() T { var t int = a; _ = t; var z T; return z }\n"
			"var a = gen[int]() + 0\n"
	srcs[1] = "var a = hi(b[0]).arr\nvar b = [3]int{7, 8, 9}\nvar c = len([len(a)]int{})\n"
	srcs[2] = "var u = [len(pick(func() int { return len(u) }))]int{}\n"
	srcs[3] = "var u = [len(pick(func() int { return len(x) }))]int{}\nvar x = ha(u).arr\n"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat(readCycleDecls, srcs[i])
		var r testing.TestResult = expectNoErrors(checkSrc(src))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}
