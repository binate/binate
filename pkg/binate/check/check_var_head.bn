package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// The type a package variable's initializer spells at its head, known before
// its operands are checked (spec decl.var.type-acyclic): a function literal's,
// a composite literal's written type, a cast's type, or a call's one result —
// that of a function or method whose signature is not defined yet resolved
// alone.

// varHeadType returns the type the initializer of the batch's variable d
// spells at its head (initHeadType), or nil — also when its head names d again
// (`var u = [len(u)]int{}`), which then reads a placeholder, when a placeholder
// leaves an array length in it without a value, or when it holds by value an
// instance not built yet (whose array length names d).
func varHeadType(c @Checker, d @ast.Decl) @types.Type {
	var b @DeclBatch = c.Batch
	if declInList(b.VarsHeadTyping, d) {
		return nil
	}
	var poisons int = len(b.PoisonedBy)
	b.VarsHeadTyping = slices.Append[@ast.Decl](b.VarsHeadTyping, d)
	var t @types.Type = initHeadType(c, d.Value)
	b.VarsHeadTyping = b.VarsHeadTyping[:len(b.VarsHeadTyping) - 1]
	var seen typeVisits
	if len(b.PoisonedBy) > poisons || t != nil && instanceNotBuiltIn(c, t, &seen) {
		return nil
	}
	return t
}

// initHeadType returns the type of the initializer e known before its operands
// are checked, or nil: a function literal's (funcLitDefaultType), a composite
// literal's spelled type, a cast's type, or a call's one result (calleeResult).
func initHeadType(c @Checker, e @ast.Expr) @types.Type {
	if e == nil {
		return nil
	}
	if e.Kind == ast.EXPR_FUNC_LIT {
		var ft @types.Type = funcLitDefaultType(c, e)
		if isErrType(ft) {
			return nil
		}
		return ft
	}
	if e.Kind == ast.EXPR_COMPOSITE && e.TypeRef != nil &&
			!(e.TypeRef.Kind == ast.TEXPR_ARRAY && e.TypeRef.LenInferred) {
		return resolveTypeExpr(c, e.TypeRef)
	}
	if e.Kind == ast.EXPR_BUILTIN && e.TypeRef != nil &&
			(e.Op == cast(int, token.CAST) || e.Op == cast(int, token.BIT_CAST)) {
		return resolveTypeExpr(c, e.TypeRef)
	}
	if e.Kind == ast.EXPR_CALL && e.X != nil {
		return calleeResult(c, e.X)
	}
	return nil
}

// calleeResult returns the one result of the callee e, whose type is known
// without checking the call's arguments — a function of a package, named
// plainly or qualified (`f`, `pkg.F`), a generic one's instance (`g[int]`), a
// method of a variable (`v.m`), or a function literal called where it is
// written, by its signature, before its body — or nil.  A function or method of
// the batch whose signature is being resolved, or is not resolved yet, has its
// result type resolved alone (definingFuncResult).
func calleeResult(c @Checker, e @ast.Expr) @types.Type {
	var ft @types.Type
	var fd @ast.Decl = nil
	if e.Kind == ast.EXPR_IDENT {
		fd = funcNotDefined(c, e.Name)
	}
	if fd != nil {
		return definingFuncResult(c, fd)
	}
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		fd = funcNotDefined(c, e.X.Name)
		if fd != nil && len(fd.TypeParams) > 0 {
			return definingInstanceResult(c, fd, e)
		}
	}
	if e.Kind == ast.EXPR_FUNC_LIT && e.DeclRef != nil {
		ft = resolveFuncDeclType(c, e.DeclRef)
	} else if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil &&
			genericFuncNamed(c, e.X) != nil {
		ft = checkInstantiateOrIndex(c, e)
	} else if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = lookupDeclOnDemand(c, e.Name)
		if sym != nil && sym.Kind == types.SYM_FUNC {
			ft = sym.Type
		}
	} else if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var q @Symbol = resolveQualifiedSym(c, e)
		var v @Symbol = nil
		if q == nil {
			v = lookupDeclOnDemand(c, e.X.Name)
		}
		if q != nil && q.Kind == types.SYM_FUNC {
			ft = q.Type
		} else if v != nil && v.Kind == types.SYM_VAR && !isErrType(v.Type) &&
				!hasVisibleField(c, v.Type, e.Name) {
			var named @types.Type = methodRecvBase(types.ResolveAliasAndConst(v.Type))
			if named != nil {
				fd = methodNotDefined(c, named, e.Name)
			}
			if fd != nil && receiverBaseInstantiation(fd.Recv.Type) != nil {
				return instanceMethodResult(c, fd, named)
			}
			if fd != nil {
				return definingFuncResult(c, fd)
			}
			if named != nil {
				var m @types.Method = lookupVisibleMethod(c, named, e.Name)
				if m != nil {
					ft = m.FuncType
				}
			}
		}
	}
	if ft == nil || ft.Kind != types.TYP_FUNC || len(ft.TypeParams) > 0 || len(ft.Results) != 1 {
		return nil
	}
	return ft.Results[0]
}

// funcNotDefined returns the batch's function name when its signature is being
// resolved (FuncsDefining), or, while types are collected, when it is not
// defined yet — neither on demand nor by collection reaching it — or nil.
func funcNotDefined(c @Checker, name *[]readonly char) @ast.Decl {
	var b @DeclBatch = c.Batch
	if b == nil {
		return nil
	}
	var d @ast.Decl = findDeclIn(b.Funcs, name)
	if d == nil || declInList(b.FuncsDefining, d) {
		return d
	}
	if !b.Collecting || declInList(b.FuncsDefined, d) {
		return nil
	}
	var sym @Symbol = declScope(c).LookupLocal(name)
	if sym != nil && sym.Kind == types.SYM_FUNC {
		return nil
	}
	return d
}

// methodNotDefined returns the batch's method name of the named type named when
// its signature is being resolved (MethodsDefining), or, while types are
// collected, when it is not defined yet — neither on demand nor by collection
// reaching it — or, for an instance of the batch's generic type, when the
// instance has no copy of it yet; or nil.  Receivers are looked up in the
// package scope, as batchMethodDeclFor does.
func methodNotDefined(c @Checker, named @types.Type, name *[]readonly char) @ast.Decl {
	var b @DeclBatch = c.Batch
	if b == nil || named.Kind != types.TYP_NAMED || !types.CharEq(c.curPkgPath, b.Pkg) {
		return nil
	}
	var found @ast.Decl = nil
	var gd @ast.Decl = batchGenericOf(c, named)
	var savedScope @Scope = c.Scope
	c.Scope = c.PackageScope
	for i := 0; i < b.Methods.Len() && found == nil; i++ {
		var d @ast.Decl = b.Methods.Get(i)
		if types.CharEq(d.Name, name) && methodDeclOf(c, d, named, gd) {
			found = d
		}
	}
	c.Scope = savedScope
	if found != nil && gd != nil {
		// A method of the batch's generic type, which named, an instance,
		// does not have a copy of yet.
		if named.LookupMethod(name) != nil {
			return nil
		}
		return found
	}
	if found == nil || declInList(b.MethodsDefining, found) {
		return found
	}
	if !b.Collecting || declInVec(b.MethodsCollected, found) || declInList(b.MethodsDefined, found) {
		return nil
	}
	return found
}

// definingInstanceResult is definingFuncResult for the instance e (`mk[int]`) of
// the batch's generic function fd: the result type is resolved alone, with each
// of fd's type parameters bound to e's type argument, as resolveInstanceSignature
// resolves the instance's signature — so a length the result takes from a type
// parameter (`[sizeof(T)]int`) is the instance's.  The instance itself, its
// constraints checked, is formed where the variable's initializer is checked.
func definingInstanceResult(c @Checker, fd @ast.Decl, e @ast.Expr) @types.Type {
	if len(fd.Results) != 1 || len(e.Args) != len(fd.TypeParams) {
		return nil
	}
	var args @[]@types.Type
	for i := 0; i < len(e.Args); i++ {
		var t @types.Type = typeArgFromExpr(c, e.Args[i])
		if t == nil || isErrType(t) {
			return nil
		}
		args = slices.Append[@types.Type](args, t)
	}
	var saved declContext = enterPackageDecl(c, fd)
	pushScope(c)
	for i := 0; i < len(fd.TypeParams); i++ {
		if !isBlank(fd.TypeParams[i].Name) {
			defineType(c.Scope, fd.TypeParams[i].Name, args[i])
		}
	}
	var rt @types.Type = resolveInstanceResult(c, fd.Results[0])
	popScope(c)
	leavePackageDecl(c, saved)
	return rt
}

// instanceMethodResult is definingFuncResult for the method md of a generic
// type, read through its instance named: the result type, a copy of it, is
// resolved alone with the receiver's binders bound to named's type arguments, as
// copyPlaceholderMethods resolves the instance's copy of the signature.
func instanceMethodResult(c @Checker, md @ast.Decl, named @types.Type) @types.Type {
	var inst @ast.TypeExpr = receiverBaseInstantiation(md.Recv.Type)
	if inst == nil || len(md.Results) != 1 {
		return nil
	}
	var saved declContext = enterPackageDecl(c, md)
	pushScope(c)
	for j := 0; j < len(inst.TypeArgs) && j < len(named.InstArgs); j++ {
		var binder @ast.TypeExpr = inst.TypeArgs[j]
		if binder != nil && binder.Kind == ast.TEXPR_NAMED {
			defineType(c.Scope, ast.ReceiverBinderName(binder, j), named.InstArgs[j])
		}
	}
	var rt @types.Type = resolveInstanceResult(c, md.Results[0])
	popScope(c)
	leavePackageDecl(c, saved)
	return rt
}

// resolveInstanceResult resolves the result type r of a generic declaration for
// an instance whose type arguments the scope binds, from a copy of r — resolution
// under the arguments records on the AST (a length depending on a type
// parameter), which must not be stamped on the declaration every instance shares
// — and, as an instance's signature is (DerivingInstanceSig), so that a
// constraint miss in it is the declaration's own.
func resolveInstanceResult(c @Checker, r @ast.TypeExpr) @types.Type {
	var savedDeriving bool = c.DerivingInstanceSig
	c.DerivingInstanceSig = true
	var rt @types.Type = resolveTypeExpr(c, ast.CloneTypeExpr(r))
	c.DerivingInstanceSig = savedDeriving
	return rt
}

// definingFuncResult returns the one result of the batch's function or method
// fd, not generic, whose signature is being resolved or is not resolved yet: a
// declaration the signature needs may read a variable whose initializer calls fd
// (`var t = mk(nil)` read by `func mk(p *([len(t)]int)) [3]int`), and fd is
// defined when collection reaches it.  The result type is resolved alone, in fd's file,
// so the variable's type does not depend on the rest of the signature; when the
// result type reads the variable (`func mk() [len(t)]int`), that is a variable
// type cycle (batchVarOnDemand).  An error in the result type is the signature's
// own, reported once (appendUniqueCheckError).
func definingFuncResult(c @Checker, fd @ast.Decl) @types.Type {
	if len(fd.TypeParams) > 0 || len(fd.Results) != 1 {
		return nil
	}
	var saved declContext = enterPackageDecl(c, fd)
	var t @types.Type = resolveTypeExpr(c, fd.Results[0])
	leavePackageDecl(c, saved)
	return t
}
