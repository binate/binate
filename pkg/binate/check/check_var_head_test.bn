package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for a package variable named before its turn whose initializer spells
// its type at its head: it is defined with that type, and its initializer is
// checked when pass 2 reaches it (defineVarOnDemand, check_decl_batch_var.bn).

// p's type is w's, which w's head spells, so it does not wait for w's elements,
// which read a, whose array length reads p: in every order of the three
// declarations there is no cycle.
func TestVarHeadTypeOrderIndependent() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 3)
	decls[0] = "var p = w\n"
	decls[1] = "var w = [3]bool{a == 3, true, false}\n"
	decls[2] = "var a = len([len(p)]int{})\n"
	var orders [18]int = [18]int{0, 1, 2, 0, 2, 1, 1, 0, 2, 1, 2, 0, 2, 0, 1, 2, 1, 0}
	for i := 0; i < 6; i++ {
		var src @[]readonly char = buf.Concat("package \"test\"\n", decls[orders[3 * i]])
		src = buf.Concat(src, decls[orders[3 * i + 1]])
		src = buf.Concat(src, decls[orders[3 * i + 2]])
		var r testing.TestResult = expectNoErrors(checkSrc(src))
		if len(r) != 0 { return buf.Concat(src, r) }
	}
	return ""
}

// The check of a variable whose type was read from its head sees the real types
// of what its operands read: a's int, where a bool is wanted, is rejected as an
// array's element, a function literal's result, the element of a chain's end
// (w's x, read from a), a struct's field and a call's argument.
func TestVarHeadTypeOperandsChecked() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 5)
	srcs[0] = "var a = len([len(b)]int{})\nvar b = [3]bool{a, true, false}\n"
	srcs[1] = "var a = len([len(b)]int{})\n"
			"var b = [3]*func() bool{func() bool { return a }, nil, nil}\n"
	srcs[2] = "var a = len([len(w)]int{})\nvar w = [2]bool{x, true}\nvar x = a + 1\n"
	srcs[3] = "type S struct { arr [2]int; flag bool }\n"
			"var a = len([len(b.arr)]int{})\nvar b = S{arr: [2]int{}, flag: a}\n"
	srcs[4] = "var a = len([len(b)]int{})\nvar b = [3]int{f(a), 0, 0}\n"
			"func f(x bool) int { if x { return 1 }; return 0 }\n"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat("package \"test\"\n", srcs[i])
		var r testing.TestResult = expectOneErr(checkSrc(src), "cannot assign int to bool")
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// With an int where an int is wanted, they check cleanly.
func TestVarHeadTypeOperandsValid() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "var a = len([len(b)]int{})\nvar b = [3]int{a, 0, 0}\n"
	srcs[1] = "var a = len([len(w)]int{})\nvar w = [2]int{x, 0}\nvar x = a + 1\n"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat("package \"test\"\n", srcs[i])
		var r testing.TestResult = expectNoErrors(checkSrc(src))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A variable named while the type its head spells is being found has a type
// that depends on itself, a variable type cycle, also when it is named in a
// value position of the check of a variable whose type the head needs: u's head
// needs w's type, an array length, and w's check passes u to mk — whether mk
// takes a bool, a pointer or u's own type.
func TestVarHeadTypeReadWhileFoundIsCycle() testing.TestResult {
	var mks @[]*[]readonly char = make_slice(*[]readonly char, 3)
	mks[0] = "func mk(b bool) S { var s S; return s }\n"
	mks[1] = "func mk(p @S) S { return *p }\n"
	mks[2] = "func mk(p [3]int) S { var s S; s.arr = p; return s }\n"
	var tail *[]readonly char = "func f() int { return len(u) }\n"
			"var u = [len(w)]int{5, 6, 7}\nvar w = mk(u).arr\n"
	for i := 0; i < len(mks); i++ {
		var src @[]readonly char = buf.Concat("package \"test\"\ntype S struct { arr [3]int }\n", mks[i])
		src = buf.Concat(src, tail)
		var r testing.TestResult = expectOneErr(checkSrc(src), "variable type cycle involving `u`")
		if len(r) != 0 { return buf.Concat(mks[i], r) }
	}
	return ""
}

// While the package's types are collected, a variable whose type its call's
// result gives has that type, though the call's argument takes an impl declared
// later (converting s to *I): B is a [3]uint8.
func TestVarHeadTypeDuringCollectionNeedsLaterDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = pick(&s)\n"
			"func pick(i *I) [3]int32 { var a [3]int32; return a }\n"
			"interface I { M() }\n"
			"var s S\n"
			"type S struct { n int }\n"
			"func (r S) M() {}\n"
			"impl S : I\n"
			"func use(a [3]uint8) int { return 0 }\n"
			"func f() int { var b B; return use(b) }\n"
	return expectNoErrors(checkSrc(src))
}

// A function literal called where it is written spells its type at its head too,
// its signature's one result, known before its body is checked: b's type does
// not wait for its body, which reads a, whose array length reads b.  So the body
// sees a's int — rejected where a bool is wanted — and with no such misuse the
// two check cleanly.
func TestVarHeadTypeCalledLiteral() testing.TestResult {
	var bad *[]readonly char = "package \"test\"\nvar a = len([len(b)]int{})\n"
			"var b = func() [3]int { var r [3]int; var t bool = a; _ = t; return r }()\n"
	var r testing.TestResult = expectOneErr(checkSrc(bad), "cannot assign int to bool")
	if len(r) != 0 { return buf.Concat("bool local: ", r) }
	var good *[]readonly char = "package \"test\"\nvar b = [len(a)]int{}\n"
			"var a = func() [3]int { var r [3]int; _ = b; return r }()\n"
	r = expectNoErrors(checkSrc(good))
	if len(r) != 0 { return buf.Concat("array length: ", r) }
	return ""
}

// A called literal whose result's array length names the variable it initializes
// is a variable type cycle.
func TestVarHeadTypeCalledLiteralCycle() testing.TestResult {
	return expectOneErr(
			checkSrc("package \"test\"\nvar u = func() [len(u)]int { var r [len(u)]int; return r }()\n"),
			"variable type cycle involving `u`")
}

// So does a called literal's: u's result type needs w's type, and w's check
// passes u to mk.
func TestVarHeadTypeCalledLiteralReadWhileFound() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype S struct { arr [3]int }\n"
			"func mk(n int) S { var s S; s.arr[0] = n; return s }\n"
			"func f() int { return len(u) }\n"
			"var u = func() [len(w)]int { var r [3]int; return r }()\nvar w = mk(u).arr\n"
	return expectOneErr(checkSrc(src), "variable type cycle involving `u`")
}

// A variable whose initializer calls a function whose signature is being
// resolved — mk's parameter's array length reads t — has that function's result
// type, resolved alone, in either order of the two: t is a [3]int, and mk's
// parameter a *([3]int).  So does one calling a method of a variable.
func TestVarHeadTypeOfFuncBeingDefined() testing.TestResult {
	var mk *[]readonly char = "func mk(p *([len(t)]int)) [3]int { var r [3]int; return r }\n"
			"func use() int { var a [3]int; return len(mk(&a)) }\n"
	var m *[]readonly char = "type R struct { n int }\nvar v R\n"
			"func (r R) m(p *([len(t)]int)) [3]int { var a [3]int; return a }\n"
	var srcs @[]@[]readonly char = make_slice(@[]readonly char, 4)
	srcs[0] = buf.Concat("var t = mk(nil)\n", mk)
	srcs[1] = buf.Concat(mk, "var t = mk(nil)\n")
	srcs[2] = buf.Concat("var t = v.m(nil)\n", m)
	srcs[3] = buf.Concat(m, "var t = v.m(nil)\n")
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat("package \"test\"\n", srcs[i])))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// The same when t's head is the first to need mk's result, before mk's
// signature is resolved, which reads u, whose declared type reads t: in every
// order of the three, for a function and for a method.
func TestVarHeadTypeOfFuncNotDefinedYet() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 6)
	decls[0] = "var t = mk(nil)\n"
	decls[1] = "var u [len(t)]int\n"
	decls[2] = "func mk(p *([len(u)]int)) [3]int { var r [3]int; return r }\n"
	decls[3] = "var t = v.m(nil)\n"
	decls[4] = "var u [len(t)]int\n"
	decls[5] = "func (r R) m(p *([len(u)]int)) [3]int { var a [3]int; return a }\n"
	var orders [18]int = [18]int{0, 1, 2, 0, 2, 1, 1, 0, 2, 1, 2, 0, 2, 0, 1, 2, 1, 0}
	for k := 0; k < 2; k++ {
		for i := 0; i < 6; i++ {
			var src @[]readonly char = "package \"test\"\ntype R struct { n int }\nvar v R\n"
			for j := 0; j < 3; j++ {
				src = buf.Concat(src, decls[k * 3 + orders[i * 3 + j]])
			}
			var r testing.TestResult = expectNoErrors(checkSrc(src))
			if len(r) != 0 { return buf.Concat(src, r) }
		}
	}
	return ""
}

// When that result type reads the variable, the variable's type depends on
// itself: one error, a variable type cycle — in either order, when a type
// declaration reads the variable first, and through a method.  An error of the
// result type's own is reported once.
func TestVarHeadTypeOfFuncBeingDefinedCycle() testing.TestResult {
	var mk *[]readonly char = "func mk() [len(t)]int { var r [len(t)]int; return r }\n"
	var srcs @[]@[]readonly char = make_slice(@[]readonly char, 5)
	var names @[]*[]readonly char = make_slice(*[]readonly char, 5)
	srcs[0] = buf.Concat("var t = mk()\n", mk)
	names[0] = "variable type cycle involving `t`"
	srcs[1] = buf.Concat(mk, "var t = mk()\n")
	names[1] = "variable type cycle involving `t`"
	srcs[2] = buf.Concat("type B [len(t)]uint8\nvar t = mk()\n", mk)
	names[2] = "variable type cycle involving `t`"
	srcs[3] = "var t = mk(nil)\nfunc mk(p *([len(t)]int)) nosuch { var r [3]int; return r }\n"
	names[3] = "undefined"
	srcs[4] = "type R struct { n int }\nvar v R\nvar t = v.m()\n"
			"func (r R) m() [len(t)]int { var a [len(t)]int; return a }\n"
	names[4] = "variable type cycle involving `t`"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectOneErr(checkSrc(buf.Concat("package \"test\"\n", srcs[i])),
				names[i])
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// So does one calling a generic function's instance, or a method of a generic
// type's instance, whose result type is resolved alone with the instance's type
// arguments: in either order, with a result naming the type parameter; and a
// result type reading the variable is a variable type cycle.
func TestVarHeadTypeOfGenericInstance() testing.TestResult {
	var mk *[]readonly char = "func mk[T any](p *([len(t)]int)) [3]T { var r [3]T; return r }\n"
			"func use() int { var a [3]int; return len(mk[int64](&a)) }\n"
	var m *[]readonly char = "type B[T any] struct { n T }\nvar v B[int64]\n"
			"func (r B[T]) m(p *([len(t)]int)) [3]T { var a [3]T; return a }\n"
	var srcs @[]@[]readonly char = make_slice(@[]readonly char, 4)
	srcs[0] = buf.Concat("var t = mk[int64](nil)\nvar u int64 = t[0]\n", mk)
	srcs[1] = buf.Concat(mk, "var t = mk[int64](nil)\nvar u int64 = t[0]\n")
	srcs[2] = buf.Concat("var t = v.m(nil)\nvar u int64 = t[0]\n", m)
	srcs[3] = buf.Concat(m, "var t = v.m(nil)\nvar u int64 = t[0]\n")
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(buf.Concat("package \"test\"\n", srcs[i])))
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	var cyc *[]readonly char = "package \"test\"\nvar t = mk[int]()\n"
			"func mk[T any]() [len(t)]T { var r [3]T; return r }\n"
	return expectOneErr(checkSrc(cyc), "variable type cycle involving `t`")
}

// A length the instance's result takes from a type parameter is the instance's:
// t's type is [8]int, so mk[int64]'s parameter is a *[8]int, which a *[5]int is
// not; the same for the method m of B[int64].
func TestVarHeadTypeOfGenericInstanceLength() testing.TestResult {
	var mk *[]readonly char = "var t = mk[int64](nil)\n"
			"func mk[T any](p *([len(t)]int)) [sizeof(T)]int { var r [sizeof(T)]int; return r }\n"
	var m *[]readonly char = "type B[T any] struct { n T }\nvar v B[int64]\nvar t = v.m(nil)\n"
			"func (r B[T]) m(p *([len(t)]int)) [sizeof(T)]int { var a [sizeof(T)]int; return a }\n"
	var srcs @[]@[]readonly char = make_slice(@[]readonly char, 4)
	srcs[0] = buf.Concat(mk, "func use() int { var a [8]int; return len(mk[int64](&a)) }\n")
	srcs[1] = buf.Concat(mk, "func use() int { var a [5]int; return len(mk[int64](&a)) }\n")
	srcs[2] = buf.Concat(m, "func use() int { var a [8]int; return len(v.m(&a)) }\n")
	srcs[3] = buf.Concat(m, "func use() int { var a [5]int; return len(v.m(&a)) }\n")
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(buf.Concat("package \"test\"\n", srcs[i]))
		var r testing.TestResult
		if i % 2 == 0 {
			r = expectNoErrors(c)
		} else {
			r = expectOneErr(c, "cannot assign *[5]int to *[8]int")
		}
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}
