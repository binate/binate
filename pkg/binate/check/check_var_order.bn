package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// The initialization order of a package's top-level variables: a depth-first walk of
// the reads of their initializers (collectVarDeps, check_var_resolve.bn), kept on a
// stack of its own, so a long chain of reads takes no recursion, and finding each
// variable by name, so the walk takes time linear in the variables and the reads
// collectVarDeps gives it.

// resolveTopLevelVarOrder computes the dependency order of the package's top-level
// init-vars and records it under c.curPkgPath (and in c.VarOrdered) for IR-gen's
// buildInitBody -- and for the REPL, which runs the initializers of a group of
// declarations resolved together in this order.  Batch path only (orderBatchVars).
func resolveTopLevelVarOrder(c @Checker, decls *[]@ast.Decl) {
	var flat @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	appendPkgVarDecls(decls, flat)
	var vars @initVars = newInitVars()
	for i := 0; i < flat.Len(); i++ {
		var d @ast.Decl = flat.Get(i)
		if d.Value == nil { continue }
		if isBlank(d.Name) { continue }
		vars.add(d)
	}
	// A lone init-var still needs the walk -- `var a int = a + 1` is a self-cycle --
	// so only a package with none is skipped.
	if vars.decls.Len() == 0 { return }
	var order @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < vars.decls.Len(); i++ {
		visitVarsFrom(c, vars, vars.first(vars.decls.Get(i).Name), order)
	}
	c.VarOrdered = order.Items()
	recordVarInitOrder(c, c.curPkgPath, c.VarOrdered)
}

// appendPkgVarDecls pushes onto out every package-level var declaration in decls -- a
// top-level DECL_VAR and each member of a `var ( ... )` DECL_GROUP -- in source order,
// so a grouped var takes part in the order exactly like a top-level one.  It mirrors
// IR-gen's initVarDecls, so both sides agree on the init-vars.
func appendPkgVarDecls(decls *[]@ast.Decl, out @vec.Vec[@ast.Decl]) {
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_VAR {
			out.Push(decls[i])
		} else if decls[i].Kind == ast.DECL_GROUP {
			appendPkgVarDecls(decls[i].Decls, out)
		}
	}
}

// A variable's mark in the walk: not reached yet, on the walk's path, or ordered.
const (
	varUnvisited int = 0
	varOnPath int = 1
	varOrdered int = 2
)

// initVars is a package's init-vars -- its variables with an initializer, not blank --
// in source order, each with its mark in the walk, and the first of each name found
// by name.  The index's keys borrow the declarations' names.
type initVars struct {
	decls @vec.Vec[@ast.Decl]
	marks @vec.Vec[int]
	index @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq]
}

// newInitVars returns an empty initVars.
func newInitVars() @initVars {
	var vs @initVars = make(initVars)
	vs.decls = vec.New[@ast.Decl]()
	vs.marks = vec.New[int]()
	vs.index = table.NewTable[*[]readonly char, int, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	return vs
}

// add appends the init-var d to vs.
func (vs @initVars) add(d @ast.Decl) {
	vs.decls.Push(d)
	vs.marks.Push(varUnvisited)
	_, _ = vs.index.GetOrPut(d.Name, vs.decls.Len() - 1)
}

// first returns the index in vs of its first init-var named name, which it holds.
func (vs @initVars) first(name *[]readonly char) int {
	i, _ := vs.index.Get(name)
	return i
}

// varVisit is an init-var the walk is in: its index in initVars, the names its
// initializer reads, and how many of them the walk has followed.
type varVisit struct {
	idx  int
	deps @[]@[]char
	next int
}

// visitVarsFrom appends to order the init-var at root and each one it reaches that is
// not ordered yet, each after every init-var its initializer reads: a post-order
// depth-first walk on a stack of its own.  A read of a variable on the walk's path is
// an initialization cycle (errVarCycle), which the walk does not follow, so it ends;
// a variable is appended once, as the walk leaves it.
func visitVarsFrom(c @Checker, vars @initVars, root int, order @vec.Vec[@[]char]) {
	if vars.marks.Get(root) != varUnvisited { return }
	var path @vec.Vec[@varVisit] = vec.New[@varVisit]()
	path.Push(enterVar(c, vars, root))
	for path.Len() > 0 {
		var v @varVisit = path.Get(path.Len() - 1)
		if v.next == len(v.deps) {
			vars.marks.Set(v.idx, varOrdered)
			order.Push(vars.decls.Get(v.idx).Name)
			_, _ = path.Pop()
			continue
		}
		var dep @[]char = v.deps[v.next]
		v.next = v.next + 1
		j, found := vars.index.Get(dep)
		if !found || vars.marks.Get(j) == varOrdered { continue }
		if vars.marks.Get(j) == varOnPath {
			errVarCycle(c, vars.decls.Get(j).Pos, dep)
			continue
		}
		path.Push(enterVar(c, vars, j))
	}
}

// enterVar marks the init-var at idx as on the walk's path and returns its visit, with
// the names its initializer reads, resolved in its own file's scope (declaredType).
func enterVar(c @Checker, vars @initVars, idx int) @varVisit {
	vars.marks.Set(idx, varOnPath)
	var d @ast.Decl = vars.decls.Get(idx)
	var v @varVisit = make(varVisit)
	v.idx = idx
	var saved declContext = enterPackageDecl(c, d)
	v.deps = collectVarDeps(c, d.Value, v.deps)
	leavePackageDecl(c, saved)
	return v
}
