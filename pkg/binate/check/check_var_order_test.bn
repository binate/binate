package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for check_var_order.bn.

// varChainLevels is how long the deep tests' chains of initializer reads are: past
// where a walk recursing along such a chain ran out of an 8 MB stack.
const varChainLevels int = 20000

// orderIs returns a failure unless c ordered exactly the variables want, in order.
func orderIs(c @Checker, want *[]*[]readonly char) testing.TestResult {
	if len(c.VarOrdered) != len(want) {
		return fail(buf.Concat("variables ordered: ", strconv.Itoa(len(c.VarOrdered))))
	}
	for i := 0; i < len(want); i++ {
		if !types.CharEq(c.VarOrdered[i], want[i]) {
			return fail(buf.Concat("ordered at ", strconv.Itoa(i)))
		}
	}
	return ""
}

// A variable read by two others is ordered once, before the first of them, and the
// readers in their turn.
func TestVarInitOrderSharedRead() testing.TestResult {
	var c @Checker = checkSrc("package \"main\"\n"
			"var a int = b + c\n"
			"var b int = d\n"
			"var c int = d\n"
			"var d int = 1\n")
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	var want @[]*[]readonly char = make_slice(*[]readonly char, 4)
	want[0] = "d"
	want[1] = "b"
	want[2] = "c"
	want[3] = "a"
	return orderIs(c, want)
}

// The first of a long chain of variables, each reading the next, is ordered last,
// after the others in turn.
func TestDeepVarInitChain() testing.TestResult {
	var c @Checker = checkSrc(
			linkChainSrc("package \"main\"\n", "var v", " int = v", " + 1", varChainLevels, " int = 0\n"))
	var r testing.TestResult = errCount(c, 0)
	if len(r) > 0 { return r }
	if len(c.VarOrdered) != varChainLevels + 1 { return fail("each variable ordered once") }
	var last @[]char = buf.Concat("v", strconv.Itoa(varChainLevels))
	if !types.CharEq(c.VarOrdered[0], last) || !types.CharEq(c.VarOrdered[varChainLevels], "v0") {
		return fail("the chain's last first, v0 last")
	}
	return ""
}

// A long chain whose last variable reads the first is one initialization cycle,
// reported once, at the first.
func TestDeepVarInitChainCycle() testing.TestResult {
	var c @Checker = checkSrc(
			linkChainSrc("package \"main\"\n", "var v", " int = v", " + 1", varChainLevels,
					" int = v0 + 1\n"))
	var r testing.TestResult = errCount(c, 1)
	if len(r) > 0 { return r }
	return expectErrSub(c, "involving `v0`")
}
