package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// A package variable named while its own type is being found — its declared
// type resolved, or its initializer checked — has no type yet.  When its
// initializer spells its type at its head (varHeadType), that is its type.
// Otherwise it is defined with a placeholder, the error type, which an
// expression reading it treats as an error already reported.  An array length
// an operand of which a placeholder leaves in error makes a type depend on the
// type being found: a variable type cycle (placeholderPoisoned, from
// evalArrayLen).  A placeholder read in an initializer outside the array
// lengths in it, code that is compiled, makes the type of the variable it
// stands for depend on itself too (judgeFreeReads).  A cycle of reads alone is
// the initialization order's (prog.init.var-cycle).

// varPlaceholder is a placeholder symbol and the variable it stands for.
type varPlaceholder struct {
	sym @Symbol
	d   @ast.Decl
}

// definePlaceholder defines the batch's variable d with a placeholder.
func definePlaceholder(c @Checker, d @ast.Decl) {
	defineVar(c.Scope, d.Name, types.TypError())
	recordPlaceholder(c, d)
}

// recordPlaceholder records the symbol the batch's variable d is defined with,
// the error type, as its placeholder.
func recordPlaceholder(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	var p varPlaceholder
	p.sym = c.Scope.Lookup(d.Name)
	p.d = d
	b.Placeholders = slices.Append[varPlaceholder](b.Placeholders, p)
}

// placeholderOf returns the variable sym is the placeholder of, or nil.
func placeholderOf(c @Checker, sym @Symbol) @ast.Decl {
	var b @DeclBatch = c.Batch
	if b == nil || sym == nil || !isErrType(sym.Type) {
		return nil
	}
	for i := 0; i < len(b.Placeholders); i++ {
		if same(b.Placeholders[i].sym, sym) {
			return b.Placeholders[i].d
		}
	}
	return nil
}

// notePlaceholderRead logs a read of sym when it is a placeholder
// (PlaceholderReads), with the array length depth it is read at (ReadLens).
func notePlaceholderRead(c @Checker, sym @Symbol) {
	var d @ast.Decl = placeholderOf(c, sym)
	if d != nil {
		var b @DeclBatch = c.Batch
		b.PlaceholderReads = slices.Append[@ast.Decl](b.PlaceholderReads, d)
		b.ReadLens = slices.Append[int](b.ReadLens, b.LenDepth)
	}
}

// placeholderMark is what has been reported, which placeholders read, and which
// array length operands a placeholder left in error, at a point of checking.
type placeholderMark struct {
	checks  checkMark
	reads   int
	poisons int
}

// markPlaceholders returns the current placeholderMark.
func markPlaceholders(c @Checker) placeholderMark {
	var m placeholderMark
	m.checks = markChecks(c)
	if c.Batch != nil {
		m.reads = len(c.Batch.PlaceholderReads)
		m.poisons = len(c.Batch.PoisonedBy)
	}
	return m
}

// notePlaceholderOperand notes the variable whose placeholder leaves the array
// length operand e in error: e is that placeholder, or it was checked since m
// with nothing reported and read one — the first read since m (PoisonedBy).
func notePlaceholderOperand(c @Checker, sym @Symbol, m placeholderMark) {
	var b @DeclBatch = c.Batch
	if b == nil {
		return
	}
	var d @ast.Decl = placeholderOf(c, sym)
	if d == nil && len(b.PlaceholderReads) > m.reads && !checksSince(c, m.checks) {
		d = b.PlaceholderReads[m.reads]
	}
	if d != nil {
		b.PoisonedBy = slices.Append[@ast.Decl](b.PoisonedBy, d)
	}
}

// checkDimOperand checks the operand e of an array length (checkExpr) and
// returns its type, noting a placeholder that leaves it in error
// (notePlaceholderOperand).
func checkDimOperand(c @Checker, e @ast.Expr) @types.Type {
	var m placeholderMark = markPlaceholders(c)
	var t @types.Type = checkExpr(c, e)
	if isErrType(t) {
		notePlaceholderOperand(c, nil, m)
	}
	return t
}

// placeholderPoisoned reports whether a placeholder left an operand of an
// array length evaluated since m in error: the variable it stands for has a
// type that depends on itself, which it reports.  A layout frame that waits is
// done again, and judged then (layoutFrameBlocked).
func placeholderPoisoned(c @Checker, m placeholderMark) bool {
	var b @DeclBatch = c.Batch
	if b == nil || len(b.PoisonedBy) == m.poisons || layoutFrameBlocked(c) {
		return false
	}
	errVarTypeCycle(c, b.PoisonedBy[m.poisons])
	return true
}

// errVarTypeCycle reports that the type of the variable d depends on itself,
// through an array length, and records it (VarsCycled, CycleErrors).
func errVarTypeCycle(c @Checker, d @ast.Decl) {
	var b @DeclBatch = c.Batch
	var before checkMark = markChecks(c)
	reportVarTypeCycle(c, d)
	if checksSince(c, before) {
		b.CycleErrors++
	}
	if !declInList(b.VarsCycled, d) {
		b.VarsCycled = slices.Append[@ast.Decl](b.VarsCycled, d)
	}
}

// ownChecksSince reports whether checking has reported anything since m other
// than variable type cycles, of which there were cycles errors at m
// (CycleErrors): a check whose only errors are other variables' type cycles
// need not be done again.
func ownChecksSince(c @Checker, m checkMark, cycles int) bool {
	var now checkMark = markChecks(c)
	return now.Missing > m.Missing || now.Errs - m.Errs > c.Batch.CycleErrors - cycles
}

// reportVarTypeCycle reports errVarTypeCycle's error.
func reportVarTypeCycle(c @Checker, d @ast.Decl) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("variable type cycle involving `")
	cb.Write(d.Name)
	cb.Write("`")
	addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
}

// varHeadType returns the type the initializer of the batch's variable d
// spells at its head (initHeadType), or nil — also when its head names d again
// (`var u = [len(u)]int{}`), which then reads a placeholder, when a placeholder
// leaves an array length in it without a value, or when it holds by value an
// instance not built yet (whose array length names d).
func varHeadType(c @Checker, d @ast.Decl) @types.Type {
	var b @DeclBatch = c.Batch
	if declInList(b.VarsHeadTyping, d) {
		return nil
	}
	var poisons int = len(b.PoisonedBy)
	b.VarsHeadTyping = slices.Append[@ast.Decl](b.VarsHeadTyping, d)
	var t @types.Type = initHeadType(c, d.Value)
	b.VarsHeadTyping = b.VarsHeadTyping[:len(b.VarsHeadTyping) - 1]
	var seen typeVisits
	if len(b.PoisonedBy) > poisons || t != nil && instanceNotBuiltIn(c, t, &seen) {
		return nil
	}
	return t
}

// initHeadType returns the type of the initializer e known before its operands
// are checked, or nil: a function literal's (funcLitDefaultType), a composite
// literal's spelled type, a cast's type, or a call's one result (calleeResult).
func initHeadType(c @Checker, e @ast.Expr) @types.Type {
	if e == nil {
		return nil
	}
	if e.Kind == ast.EXPR_FUNC_LIT {
		var ft @types.Type = funcLitDefaultType(c, e)
		if isErrType(ft) {
			return nil
		}
		return ft
	}
	if e.Kind == ast.EXPR_COMPOSITE && e.TypeRef != nil &&
			!(e.TypeRef.Kind == ast.TEXPR_ARRAY && e.TypeRef.LenInferred) {
		return resolveTypeExpr(c, e.TypeRef)
	}
	if e.Kind == ast.EXPR_BUILTIN && e.TypeRef != nil &&
			(e.Op == cast(int, token.CAST) || e.Op == cast(int, token.BIT_CAST)) {
		return resolveTypeExpr(c, e.TypeRef)
	}
	if e.Kind == ast.EXPR_CALL && e.X != nil {
		return calleeResult(c, e.X)
	}
	return nil
}

// calleeResult returns the one result of the callee e, whose type is known
// without checking the call's arguments — a function of a package, named
// plainly or qualified (`f`, `pkg.F`), a generic one's instance (`g[int]`), a
// method of a variable (`v.m`), or a function literal called where it is
// written, by its signature, before its body — or nil.
func calleeResult(c @Checker, e @ast.Expr) @types.Type {
	var ft @types.Type
	if e.Kind == ast.EXPR_FUNC_LIT && e.DeclRef != nil {
		ft = resolveFuncDeclType(c, e.DeclRef)
	} else if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil &&
			genericFuncNamed(c, e.X) != nil {
		ft = checkInstantiateOrIndex(c, e)
	} else if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = lookupDeclOnDemand(c, e.Name)
		if sym != nil && sym.Kind == types.SYM_FUNC {
			ft = sym.Type
		}
	} else if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var q @Symbol = resolveQualifiedSym(c, e)
		var v @Symbol = nil
		if q == nil {
			v = lookupDeclOnDemand(c, e.X.Name)
		}
		if q != nil && q.Kind == types.SYM_FUNC {
			ft = q.Type
		} else if v != nil && v.Kind == types.SYM_VAR && !isErrType(v.Type) &&
				!hasVisibleField(c, v.Type, e.Name) {
			var named @types.Type = methodRecvBase(types.ResolveAliasAndConst(v.Type))
			if named != nil {
				var m @types.Method = lookupVisibleMethod(c, named, e.Name)
				if m != nil {
					ft = m.FuncType
				}
			}
		}
	}
	if ft == nil || ft.Kind != types.TYP_FUNC || len(ft.TypeParams) > 0 || len(ft.Results) != 1 {
		return nil
	}
	return ft.Results[0]
}

// resolveBatchVarType resolves the declared type of the batch's variable d,
// marked as being resolved meanwhile: an array length in it naming d reads a
// placeholder (batchVarOnDemand).  Its type cycle reported, d's type is the
// error type, so nothing more is reported about it.
func resolveBatchVarType(c @Checker, d @ast.Decl) @types.Type {
	var b @DeclBatch = c.Batch
	if b == nil {
		return resolveTypeExpr(c, d.TypeRef)
	}
	b.VarsResolving = slices.Append[@ast.Decl](b.VarsResolving, d)
	var t @types.Type = resolveTypeExpr(c, d.TypeRef)
	b.VarsResolving = b.VarsResolving[:len(b.VarsResolving) - 1]
	if declInList(b.VarsCycled, d) {
		return types.TypError()
	}
	return t
}

// notePoisonedLen notes an array length evaluated since m and left without a
// value: a variable type cycle when a placeholder left an operand of it in
// error (placeholderPoisoned), or else, with nothing reported since m, one
// another declaration's error left so (SilentPoisons) — not one a layout frame
// that waits left so (layoutFrameBlocked).
func notePoisonedLen(c @Checker, m placeholderMark) {
	if placeholderPoisoned(c, m) || c.Batch == nil || checksSince(c, m.checks) ||
			layoutFrameBlocked(c) {
		return
	}
	c.Batch.SilentPoisons++
}
