package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_var_placeholder.bn: a package variable whose type depends on
// itself through an array length is a type cycle, reported once; one only read
// while its type is found is not.

// A declared type naming the variable.
func TestVarTypeCycleDeclared() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar v [len(v)]int\n")
	return expectOneErr(c, "variable type cycle involving `v`")
}

// Two declared types naming each other.
func TestVarTypeCycleDeclaredMutual() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar a [len(b)]int\nvar b [len(a)]int\n")
	return expectOneErr(c, "variable type cycle involving")
}

// A declared type naming the variable as a constant.
func TestVarTypeCycleDeclaredConstOperand() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar v [v]int\n")
	return expectOneErr(c, "variable type cycle involving `v`")
}

// A declared type naming the variable, with an initializer.
func TestVarTypeCycleDeclaredInitialized() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar v [len(v)]int = [0]int{}\n")
	return expectOneErr(c, "variable type cycle involving `v`")
}

// An inferred type whose array length names the variable.
func TestVarTypeCycleInferred() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar u = [len(u)]int{}\n")
	return expectOneErr(c, "variable type cycle involving `u`")
}

// Through a selector.
func TestVarTypeCycleInferredSelector() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype S struct { x [2]int }\nvar u = [len(u.x)]S{}\n")
	return expectOneErr(c, "variable type cycle involving `u`")
}

// Two inferred types naming each other.
func TestVarTypeCycleInferredMutual() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar u = [len(w)]int{}\nvar w = [len(u)]int{}\n")
	return expectOneErr(c, "variable type cycle involving")
}

// A read and an array length: whichever is checked first, the cycle runs
// through a type, which the initialization order does not see.
func TestVarTypeCycleReadThenLen() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar a = b\nvar b = [len(a)]int{}\n")
	var r testing.TestResult = expectOneErr(c, "variable type cycle involving")
	if len(r) != 0 { return r }
	c = checkSrc("package \"test\"\nvar b = [len(a)]int{}\nvar a = b\n")
	return expectOneErr(c, "variable type cycle involving")
}

// A function literal's signature naming its variable.
func TestVarTypeCycleFuncLitSignature() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar f = func(a [len(f)]int) {}\n")
	return expectOneErr(c, "variable type cycle involving `f`")
}

// Reads alone are still the initialization cycle.
func TestVarTypeCycleReadsAreInitCycle() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar a = b\nvar b = a\n")
	if errorsContaining(c, "type cycle") != 0 { return fail("reads alone are no type cycle") }
	return expectOneErr(c, "variable initialization cycle")
}

// A function literal in an array length, whose body reads the variable when it
// runs, is no cycle: the length is its result's.
func TestVarTypeCycleFuncLitBodyNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc pick(f @func() int) [3]int { var r [3]int; return r }\n"
					"var u = [len(pick(func() int { return len(u) }))]int{}\n")
	return expectNoErrors(c)
}

// A function literal reading its own variable in its body is no cycle.
func TestVarTypeCycleRecursiveFuncLitNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar g = func(n int) int { if n > 0 { return g(n - 1) }; return 7 }\n")
	return expectNoErrors(c)
}

// At the prompt too.
func TestVarTypeCycleRepl() testing.TestResult {
	var c @Checker = sessionChecker()
	replCheckDecl(c, "var v [len(v)]int")
	var r testing.TestResult = expectOneErr(c, "variable type cycle involving `v`")
	if len(r) != 0 { return r }
	replCheckDecl(c, "var u = [len(u)]int{}")
	if errorsContaining(c, "variable type cycle involving `u`") != 1 {
		return fail("expected the type cycle of u")
	}
	return ""
}

// A function literal's variable named in an array length in its body: its type
// is the literal's signature.
func TestVarTypeCycleFuncLitBodyLenNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar g = func() [3]int { var x [len(g())]int; return x }\n")
	return expectNoErrors(c)
}

// Another variable named in an array length in a function literal's body,
// whose initializer calls the literal, in either order: their types are the
// literal's signature and the spelled composite type.
func TestVarTypeCycleSpelledTypesNotCycle() testing.TestResult {
	var lit *[]readonly char = "var a = func() int { var x [len(b)]int; return len(x) }\n"
	var arr *[]readonly char = "var b = [3]int{a(), 0, 0}\n"
	var r testing.TestResult = expectNoErrors(
			checkSrc(catStrs(catStrs("package \"test\"\n", lit), arr)))
	if len(r) != 0 { return r }
	return expectNoErrors(checkSrc(catStrs(catStrs("package \"test\"\n", arr), lit)))
}

// An array length whose own type is fixed, whatever the one it is in.
func TestVarTypeCycleFixedResultNotCycle() testing.TestResult {
	var r testing.TestResult = expectNoErrors(
			checkSrc(
					"package \"test\"\nvar a = len([len(b)]int{})\nvar b = [3]int{a, 0, 0}\n"))
	if len(r) != 0 { return r }
	return expectNoErrors(
			checkSrc(
					"package \"test\"\nvar a = [len(b)]int{}\nvar b = [3]int{len(a), 0, 0}\n"))
}

// A declared type whose array length calls a function literal reading the
// variable: the length is the call's result's.
func TestVarTypeCycleDeclaredFuncLitBodyNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc pick(f @func() int) [3]int { var r [3]int; return r }\n"
					"var v [len(pick(func() int { return len(v) }))]int\n")
	return expectNoErrors(c)
}

// Found while the package's types are collected, through another variable's
// declared type.
func TestVarTypeCycleDuringCollection() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar z [len(u)]int\nvar u = [len(u)]int{}\n")
	return expectOneErr(c, "variable type cycle involving `u`")
}

// A declared type's cycle found inside the check of a variable deferred while
// the package's types are collected stands.
func TestVarTypeCycleSurvivesDeferral() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar z [len(u)]int\nvar u = [len(v)]int{}\nvar v [len(v)]int\n")
	if errorsContaining(c, "variable type cycle involving `v`") != 1 {
		return fail("expected the type cycle of v")
	}
	// u checks cleanly only through v's error: not told to declare its type.
	if errorsContaining(c, "declare its type") != 0 {
		return fail("u's length is left without a value by v's error, not by collection")
	}
	return ""
}

// Through a generic function's instance: rejected, not given a made-up type.
func TestVarTypeCycleThroughGenericInstance() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc mk[T any]() [len(u)]T { var r [len(u)]T; return r }\n"
					"var u = mk[int]()\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("the cycle through mk[int]'s signature must be an error")
	}
	return ""
}

// A variable whose type cycle is reported has the error type: using it reports
// nothing more, declared or inferred.
func TestVarTypeCycleUseReportsNothingMore() testing.TestResult {
	var r testing.TestResult = expectOneErr(
			checkSrc("package \"test\"\nvar v [len(v)]int\nvar w [2]int = v\n"),
			"variable type cycle involving `v`")
	if len(r) != 0 { return r }
	return expectOneErr(checkSrc("package \"test\"\nvar u = [len(u)]int{}\nvar y [5]int = u\n"),
			"variable type cycle involving `u`")
}

// A type cycle found inside a check deferred while the package's types are
// collected stands, though no array length reading the deferred variable
// reports it (z's type is int whatever u's is).
func TestVarTypeCycleDeferredStands() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype B [z]int\nvar z = len(u)\nvar u = [len(v)]int{}\n"
					"var v [len(v)]int\n")
	if errorsContaining(c, "variable type cycle involving `v`") != 1 {
		return fail("expected the type cycle of v")
	}
	return ""
}

// A method call's result types the variable before its arguments are checked:
// a function literal argument's body may size an array by it.
func TestVarTypeCycleMethodHeadNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype S struct { arr [3]int; f @func() int }\ntype M struct { k int }\n"
					"func (m M) mk(f @func() int) S { var s S; s.f = f; return s }\nvar m M\n"
					"var h = m.mk(func() int { var a [len(h.arr)]int; return len(a) })\n")
	return expectNoErrors(c)
}

// The variable blamed is the one whose placeholder left the length without a
// value, not another read after it (b's initializer spells no type at its
// head, so b has a placeholder too).
func TestVarTypeCycleBlamesPoisoner() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc idx(f @func() int) int { return 0 }\n"
					"var b = -idx(func() int { return len(a) })\n"
					"var a = [len(a[idx(func() int { return b })])][2]int{}\n")
	if errorsContaining(c, "variable type cycle involving `a`") != 1 ||
			errorsContaining(c, "involving `b`") != 0 {
		return fail("expected the type cycle of a alone")
	}
	return ""
}

// A length left without a value by an error reported before, with a harmless
// placeholder read beside it, is no type cycle.
func TestVarTypeCycleEarlierErrorNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc bad() Nosuch { var r Nosuch; return r }\n"
					"func pick(f @func() int) [3]int { var r [3]int; return r }\n"
					"var u = [len(pick(func() int { return len(u) })) + len(bad())]int{}\n")
	if errorsContaining(c, "type cycle") != 0 {
		return fail("the length's error is bad's")
	}
	return ""
}

// A variable whose type is its call's result has that type when read while the
// package's types are collected, though its call's argument takes an impl
// declared later and a function literal in it sizes an array by it.
func TestVarTypeCycleHeadTypedDuringCollection() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type B [len(tbl)]uint8\n"
			"var tbl = pick(&s, func() int { var a [len(tbl)]int32; return len(a) })\n"
			"func pick(i *I, f @func() int) [3]int32 { var a [3]int32; return a }\n"
			"interface I { M() }\n"
			"var s S\n"
			"type S struct { n int }\n"
			"func (r S) M() {}\n"
			"impl S : I\n"
	return expectNoErrors(checkSrc(src))
}

// A variable whose check, while the package's types are collected, finds only
// another variable's type cycle is not deferred, nor told to declare its type.
func TestVarTypeCycleOthersCycleNotDeferred() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype B [len(u)]int\nvar u = [3]int{len(v), 0, 0}\nvar v [len(v)]int\n")
	return expectOneErr(c, "variable type cycle involving `v`")
}

// So does an explicit generic instance's call.
func TestVarTypeCycleGenericCallHeadNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc G[T any](f @func() int) [3]T { var r [3]T; return r }\n"
					"var g = G[int](func() int { var a [len(g)]int; return len(a) })\n")
	return expectNoErrors(c)
}

// A generic's declaration whose array length selects a field of the variable
// its instance initializes is a cycle of the instance's layout — the selection
// needs the instance built — reported as one, as without generics: the
// declaration waits for the variable's type, the instance, and is the cycle
// when it is resolved again.
func TestVarTypeCycleInstanceBeingBuilt() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Box[T any] struct { b [2]int; a [len(u.b)]T }\n"
					"var u = Box[int]{}\n")
	return expectOneErr(c, "cyclic type definition involving `Box`")
}

// Nor is an operand whose own error is reported in its check, beside a harmless
// placeholder read.
func TestVarTypeCycleOperandOwnErrorNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc pick(f @func() int) [3]int { var r [3]int; return r }\n"
					"var u = [len(pick(func() int { return len(u) }).nosuch)]int{}\n")
	if len(c.CheckerErrors()) == 0 || errorsContaining(c, "type cycle") != 0 {
		return fail("expected nosuch's error alone")
	}
	return ""
}

// A declared type whose array length names a constant reading the variable
// (`const K = len(V)`, `var V [K]int`): the constant's check takes the
// placeholder as an error reported already, and the length it leaves without
// a value is the cycle, reported once, at the variable (notePoisonedConst) — in
// either order, through a group's bare member, an operator or a call of an
// element, and through another variable.  A read in a function literal in the
// constant, which its value does not depend on, is not blamed; another length
// naming the constant once the cycle is reported reports nothing more; a
// constant reading a variable whose type is not being found is no cycle.
func TestVarTypeCycleThroughConst() testing.TestResult {
	var srcs [5]*[]readonly char
	var lines [5]int
	srcs[0] = "const K = len(V)\nvar V [K]int\n"
	lines[0] = 3
	srcs[1] = "var V [K]int\nconst K = len(V)\n"
	lines[1] = 2
	srcs[2] = "const (\n\tK = len(V)\n\tJ\n)\nvar V [J]int\n"
	lines[2] = 6
	srcs[3] = "const K = len(V) + 1\nvar V [K - 1]int\n"
	lines[3] = 3
	srcs[4] = "var V [K]*func() [3]int\nconst K = len(V[0]())\n"
	lines[4] = 2
	for i := 0; i < len(srcs); i++ {
		var c @Checker = checkSrc(buf.Concat("package \"test\"\n", srcs[i]))
		var r testing.TestResult = expectOneErrAt(c, lines[i], 1, "variable type cycle involving `V`")
		if len(r) > 0 { return r }
	}
	var c @Checker = checkSrc("package \"test\"\nvar A [len(B)]int\nconst K = len(A)\nvar B [K]int\n")
	var r testing.TestResult = expectOneErrAt(c, 2, 1, "variable type cycle involving `A`")
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\nfunc pick(f *func() int) [3]int { var a [3]int; return a }\n"
					"var X [len(V)]int\nvar V [K]int\n"
					"const K = len(pick(func() int { return len(X) })) + len(V)\n")
	r = expectOneErrAt(c, 4, 1, "variable type cycle involving `V`")
	if len(r) > 0 { return r }
	c = checkSrc(
			"package \"test\"\nconst K = len(V)\nvar V [K]int\nfunc f(x [3]int) [3]int { return x }\n"
					"var W [len(f(W)) + K]int\n")
	r = expectOneErrAt(c, 3, 1, "variable type cycle involving `V`")
	if len(r) > 0 { return r }
	c = checkSrc("package \"test\"\nconst K = len(V)\nvar V [4]int\nvar W [K]int\n")
	return expectNoErrors(c)
}

// A constant read where the variable's own array length needs no type of it —
// a call's argument — is no cycle of the variable's, nor is it one for another
// length naming the constant once the variable has its type.
func TestVarTypeCycleConstReadInLengthArgNotCycle() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int) [3]int { var a [3]int; return a }\n"
					"var V [len(f(K))]int\nconst K = len(V)\nvar Z [K]int\n")
	if errorsContaining(c, "type cycle") != 0 {
		return fail("V's type needs only f's result type")
	}
	return ""
}
