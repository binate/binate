package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/std/vec"

// The package-var reads of an immediately-invoked function literal's body, which
// runs at initialization (collectVarDepsIn, check_var_resolve.bn).

// varDepScope is the names an immediately-invoked function literal's body binds
// where a read is collected, innermost last: its parameters, and the locals, loop
// variables and type-switch binders in scope (decl.scope.block).  Each denotes the
// body's own variable, shadowing a package variable of its name
// (decl.scope.shadow), so reading it reads no package variable.
type varDepScope struct {
	names @vec.Vec[@[]char]
}

// newVarDepScope returns a varDepScope binding nothing.
func newVarDepScope() @varDepScope {
	var s @varDepScope = make(varDepScope)
	s.names = vec.New[@[]char]()
	return s
}

// bind binds name in the innermost block; `_` binds nothing.
func (s @varDepScope) bind(name @[]char) {
	if len(name) > 0 && !isBlank(name) {
		s.names.Push(name)
	}
}

// binds reports whether name is bound.
func (s @varDepScope) binds(name *[]readonly char) bool {
	for i := 0; i < s.names.Len(); i++ {
		if types.CharEq(s.names.Get(i), name) {
			return true
		}
	}
	return false
}

// mark returns how many names are bound, which leave returns to.
func (s @varDepScope) mark() int {
	return s.names.Len()
}

// leave unbinds the names bound since mark m: the end of their block.
func (s @varDepScope) leave(m int) {
	for s.names.Len() > m {
		_, _ = s.names.Pop()
	}
}

// declaredTypeShadowed reports whether scope binds a name declaredType looks up
// to find e's type — the variable, function or package e names — so that the
// body's own declaration, not the package's, is what it names (nil scope binds
// nothing).  A type assertion's target is the package's type: a body declares no
// type, and a name it binds that the target names leaves the target no type.
func declaredTypeShadowed(e @ast.Expr, scope @varDepScope) bool {
	if scope == nil || e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return scope.binds(e.Name) }
	if e.Kind == ast.EXPR_SELECTOR || e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX ||
			e.Kind == ast.EXPR_UNARY || e.Kind == ast.EXPR_CALL {
		return declaredTypeShadowed(e.X, scope)
	}
	return false
}

// collectVarDepsFuncLitBody walks the body of an immediately-invoked function
// literal, collecting package-var reads (the body runs at init).  A nested
// NAMED-function call is not followed (the deferred transitive-through-
// functions case) and a stored (non-invoked) nested closure is skipped, but a
// nested direct-call IIFE body IS descended — collectVarDeps re-recognizes it
// and walks it, which is correct (its body runs) and at worst over-approximates.
// The literal's parameters are bound in its body, inside outer, the names bound
// where it is called (nil outside any literal's body).
func collectVarDepsFuncLitBody(c @Checker, lit @ast.Expr, deps @[]@[]char,
		outer @varDepScope) @[]@[]char {
	if lit == nil || lit.DeclRef == nil { return deps }
	var scope @varDepScope = outer
	if scope == nil {
		scope = newVarDepScope()
	}
	var m int = scope.mark()
	for i := 0; i < len(lit.DeclRef.Params); i++ {
		scope.bind(lit.DeclRef.Params[i].Name)
	}
	deps = collectVarDepsStmt(c, lit.DeclRef.Body, deps, scope)
	scope.leave(m)
	return deps
}

// collectVarDepsStmt collects package-var reads from statement `s` and its
// sub-statements / sub-expressions.  New bindings (`:=` LHS, for-in loop vars,
// a nested `var`/`const`'s name) are NOT collected — they are writes, not
// reads — and are bound in scope from their declaration to the end of their
// block, loop or case clause (decl.scope.block, stmt.for.scope); a name is not
// in scope in its own initializer (`x := x`, func.closure.recursion), so that is
// walked first.  Assignment LHS exprs ARE collected: an op-assign reads the target,
// and an indexed target (`a[i] = ...`) reads `a`/`i`; over-collecting a plain
// `=` target is a benign spurious edge (never a missed read).
func collectVarDepsStmt(c @Checker, s @ast.Stmt, deps @[]@[]char, scope @varDepScope) @[]@[]char {
	if s == nil { return deps }
	if s.Kind == ast.STMT_BLOCK {
		var m int = scope.mark()
		for i := 0; i < len(s.Stmts); i++ {
			deps = collectVarDepsStmt(c, s.Stmts[i], deps, scope)
		}
		scope.leave(m)
		return deps
	}
	if s.Kind == ast.STMT_EXPR || s.Kind == ast.STMT_INC_DEC {
		return collectVarDepsIn(c, s.X, deps, scope)
	}
	if s.Kind == ast.STMT_ASSIGN {
		for i := 0; i < len(s.Exprs); i++ {
			deps = collectVarDepsIn(c, s.Exprs[i], deps, scope)
		}
		for i := 0; i < len(s.Exprs2); i++ {
			deps = collectVarDepsIn(c, s.Exprs2[i], deps, scope)
		}
		return deps
	}
	if s.Kind == ast.STMT_SHORT_VAR {
		// LHS names are fresh locals (writes); only the RHS reads.
		for i := 0; i < len(s.Exprs2); i++ {
			deps = collectVarDepsIn(c, s.Exprs2[i], deps, scope)
		}
		for i := 0; i < len(s.Exprs); i++ {
			if s.Exprs[i] != nil && s.Exprs[i].Kind == ast.EXPR_IDENT {
				scope.bind(s.Exprs[i].Name)
			}
		}
		return deps
	}
	if s.Kind == ast.STMT_RETURN {
		for i := 0; i < len(s.Exprs); i++ {
			deps = collectVarDepsIn(c, s.Exprs[i], deps, scope)
		}
		return deps
	}
	if s.Kind == ast.STMT_IF {
		deps = collectVarDepsIn(c, s.X, deps, scope)
		deps = collectVarDepsStmt(c, s.Body, deps, scope)
		return collectVarDepsStmt(c, s.Else, deps, scope)
	}
	if s.Kind == ast.STMT_FOR {
		// The loop is a scope of its own: its init statement's variables, and
		// the for-in loop vars (ForKey / ForVal), fresh bindings of each
		// element, after the iterable s.X is read.
		var m int = scope.mark()
		deps = collectVarDepsStmt(c, s.Init, deps, scope)
		deps = collectVarDepsIn(c, s.X, deps, scope)
		if s.ForKey != nil && s.ForKey.Kind == ast.EXPR_IDENT {
			scope.bind(s.ForKey.Name)
		}
		if s.ForVal != nil && s.ForVal.Kind == ast.EXPR_IDENT {
			scope.bind(s.ForVal.Name)
		}
		deps = collectVarDepsStmt(c, s.Post, deps, scope)
		deps = collectVarDepsStmt(c, s.Body, deps, scope)
		scope.leave(m)
		return deps
	}
	if s.Kind == ast.STMT_SWITCH || s.Kind == ast.STMT_TYPE_SWITCH {
		// A type switch reads its scrutinee (s.X) and each case body; the case
		// AssertTargetList (cc.Types) holds type expressions, not var reads, and
		// cc.Exprs is empty, so collectVarDepsCase covers both switch forms.  Each
		// case clause is a block of its own, where a type switch's binder is bound.
		deps = collectVarDepsIn(c, s.X, deps, scope)
		for i := 0; i < len(s.Cases); i++ {
			var m int = scope.mark()
			if s.Kind == ast.STMT_TYPE_SWITCH {
				scope.bind(s.Binder)
			}
			deps = collectVarDepsCase(c, s.Cases[i], deps, scope)
			scope.leave(m)
		}
		return deps
	}
	if s.Kind == ast.STMT_DECL {
		return collectVarDepsDecl(c, s.DeclRef, deps, scope)
	}
	if s.Kind == ast.STMT_DEFER {
		// The deferred block runs when its enclosing block exits — still part
		// of the initializer's evaluation — so its reads count.
		return collectVarDepsStmt(c, s.Body, deps, scope)
	}
	// STMT_EMPTY / STMT_BREAK / STMT_CONTINUE: no package-var reads.
	return deps
}

// collectVarDepsDecl collects package-var reads from a local declaration.  A
// GROUPED decl (`var ( ... )` / `const ( ... )`) parses to DECL_GROUP with a
// nil Value and its member specs in Decls (a single-member group collapses to
// the bare member), so recurse each member — mirroring registerConstPlaceholders
// in check_const_resolve.bn.  A plain var/const decl's initializer is its
// Value.  Missing the group case would DROP a read (`var ( x = pkgVar )` inside
// an IIFE body), which is a silent wrong-value miscompile — the exact failure
// the walk's "never miss a read" invariant forbids.  The declared name is bound
// after its initializer is walked.
func collectVarDepsDecl(c @Checker, d @ast.Decl, deps @[]@[]char, scope @varDepScope) @[]@[]char {
	if d == nil { return deps }
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			deps = collectVarDepsDecl(c, d.Decls[i], deps, scope)
		}
		return deps
	}
	deps = collectVarDepsIn(c, d.Value, deps, scope)
	scope.bind(d.Name)
	return deps
}

// collectVarDepsCase collects package-var reads from a switch case clause's
// guard expressions and body statements.
func collectVarDepsCase(c @Checker, cc @ast.CaseClause, deps @[]@[]char,
		scope @varDepScope) @[]@[]char {
	if cc == nil { return deps }
	for i := 0; i < len(cc.Exprs); i++ {
		deps = collectVarDepsIn(c, cc.Exprs[i], deps, scope)
	}
	for i := 0; i < len(cc.Body); i++ {
		deps = collectVarDepsStmt(c, cc.Body[i], deps, scope)
	}
	return deps
}
