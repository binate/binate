package "pkg/binate/check"

import "pkg/binate/ast"

// The package-var reads of an immediately-invoked function literal's body, which
// runs at initialization (collectVarDepsIn, check_var_resolve.bn).

// collectVarDepsFuncLitBody walks the body of an immediately-invoked function
// literal, collecting package-var reads (the body runs at init).  A nested
// NAMED-function call is not followed (the deferred transitive-through-
// functions case) and a stored (non-invoked) nested closure is skipped, but a
// nested direct-call IIFE body IS descended — collectVarDeps re-recognizes it
// and walks it, which is correct (its body runs) and at worst over-approximates.
// An IIFE-local name that shadows a package var is collected as a spurious
// edge — a documented limitation that only ever over-constrains the order (or
// raises a loud cycle error), never silently drops a read.
func collectVarDepsFuncLitBody(c @Checker, lit @ast.Expr, deps @[]@[]char) @[]@[]char {
	if lit == nil || lit.DeclRef == nil { return deps }
	return collectVarDepsStmt(c, lit.DeclRef.Body, deps)
}

// collectVarDepsStmt collects package-var reads from statement `s` and its
// sub-statements / sub-expressions.  New bindings (`:=` LHS, for-in loop vars,
// a nested `var`/`const`'s name) are NOT collected — they are writes, not
// reads.  Assignment LHS exprs ARE collected: an op-assign reads the target,
// and an indexed target (`a[i] = ...`) reads `a`/`i`; over-collecting a plain
// `=` target is a benign spurious edge (never a missed read).
func collectVarDepsStmt(c @Checker, s @ast.Stmt, deps @[]@[]char) @[]@[]char {
	if s == nil { return deps }
	if s.Kind == ast.STMT_BLOCK {
		for i := 0; i < len(s.Stmts); i++ {
			deps = collectVarDepsStmt(c, s.Stmts[i], deps)
		}
		return deps
	}
	if s.Kind == ast.STMT_EXPR || s.Kind == ast.STMT_INC_DEC {
		return collectVarDepsIn(c, s.X, deps, false)
	}
	if s.Kind == ast.STMT_ASSIGN {
		for i := 0; i < len(s.Exprs); i++ {
			deps = collectVarDepsIn(c, s.Exprs[i], deps, false)
		}
		for i := 0; i < len(s.Exprs2); i++ {
			deps = collectVarDepsIn(c, s.Exprs2[i], deps, false)
		}
		return deps
	}
	if s.Kind == ast.STMT_SHORT_VAR {
		// LHS names are fresh locals (writes); only the RHS reads.
		for i := 0; i < len(s.Exprs2); i++ {
			deps = collectVarDepsIn(c, s.Exprs2[i], deps, false)
		}
		return deps
	}
	if s.Kind == ast.STMT_RETURN {
		for i := 0; i < len(s.Exprs); i++ {
			deps = collectVarDepsIn(c, s.Exprs[i], deps, false)
		}
		return deps
	}
	if s.Kind == ast.STMT_IF {
		deps = collectVarDepsStmt(c, s.Init, deps)
		deps = collectVarDepsIn(c, s.X, deps, false)
		deps = collectVarDepsStmt(c, s.Body, deps)
		return collectVarDepsStmt(c, s.Else, deps)
	}
	if s.Kind == ast.STMT_FOR {
		// For-in loop vars (ForKey / ForVal) are fresh bindings — skip them;
		// the iterable is s.X.
		deps = collectVarDepsStmt(c, s.Init, deps)
		deps = collectVarDepsIn(c, s.X, deps, false)
		deps = collectVarDepsStmt(c, s.Post, deps)
		return collectVarDepsStmt(c, s.Body, deps)
	}
	if s.Kind == ast.STMT_SWITCH || s.Kind == ast.STMT_TYPE_SWITCH {
		// A type switch reads its scrutinee (s.X) and each case body; the case
		// AssertTargetList (cc.Types) holds type expressions, not var reads, and
		// cc.Exprs is empty, so collectVarDepsCase covers both switch forms.
		deps = collectVarDepsIn(c, s.X, deps, false)
		for i := 0; i < len(s.Cases); i++ {
			deps = collectVarDepsCase(c, s.Cases[i], deps)
		}
		return deps
	}
	if s.Kind == ast.STMT_DECL {
		return collectVarDepsDecl(c, s.DeclRef, deps)
	}
	if s.Kind == ast.STMT_DEFER {
		// The deferred block runs when its enclosing block exits — still part
		// of the initializer's evaluation — so its reads count.
		return collectVarDepsStmt(c, s.Body, deps)
	}
	// STMT_EMPTY / STMT_BREAK / STMT_CONTINUE: no package-var reads.
	return deps
}

// collectVarDepsDecl collects package-var reads from a local declaration.  A
// GROUPED decl (`var ( ... )` / `const ( ... )`) parses to DECL_GROUP with a
// nil Value and its member specs in Decls (a single-member group collapses to
// the bare member), so recurse each member — mirroring registerConstPlaceholders
// in check_const_resolve.bn.  A plain var/const decl's initializer is its
// Value.  Missing the group case would DROP a read (`var ( x = pkgVar )` inside
// an IIFE body), which is a silent wrong-value miscompile — the exact failure
// the walk's "never miss a read" invariant forbids.
func collectVarDepsDecl(c @Checker, d @ast.Decl, deps @[]@[]char) @[]@[]char {
	if d == nil { return deps }
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			deps = collectVarDepsDecl(c, d.Decls[i], deps)
		}
		return deps
	}
	return collectVarDepsIn(c, d.Value, deps, false)
}

// collectVarDepsCase collects package-var reads from a switch case clause's
// guard expressions and body statements.
func collectVarDepsCase(c @Checker, cc @ast.CaseClause, deps @[]@[]char) @[]@[]char {
	if cc == nil { return deps }
	for i := 0; i < len(cc.Exprs); i++ {
		deps = collectVarDepsIn(c, cc.Exprs[i], deps, false)
	}
	for i := 0; i < len(cc.Body); i++ {
		deps = collectVarDepsStmt(c, cc.Body[i], deps)
	}
	return deps
}
