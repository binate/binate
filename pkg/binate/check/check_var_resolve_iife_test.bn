package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_var_resolve_iife.bn: the reads of an immediately-invoked
// function literal's body, pinned through the presence or absence of an
// initialization-cycle error.

// A directly-invoked function literal (IIFE) IS run at init, so a reference in
// its body DOES form an edge: `var a = (func() int { return b })()` reads `b`,
// so combined with `var b = a` it is a cycle.  (If the IIFE body were skipped
// like a stored closure, no cycle would be reported — this pins the IIFE
// carve-out in collectVarDeps.)
func TestVarInitIIFEBodyFormsCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = (func() int { return b })()\n"
			"var b int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A read inside a GROUPED local declaration in an IIFE body must still form an
// edge.  A multi-member `var ( ... )` parses to DECL_GROUP with a nil Value and
// its members in Decls, so collecting only DeclRef.Value would DROP the read of
// `b` here — a silent miscompile.  Pinned via the cycle discriminator: the
// grouped `x = b` read plus `var b = a` is a cycle iff the read is collected.
func TestVarInitIIFEGroupedLocalReadFormsCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = (func() int {\n"
			"\tvar (\n"
			"\t\tx = b\n"
			"\t\ty = 1\n"
			"\t)\n"
			"\treturn x + y\n"
			"})()\n"
			"var b int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// Inside an immediately-invoked literal a local may shadow the package's array
// with a slice, whose length is a read: there every operand of len is walked,
// so the read of b in `len(a[b])` still makes t and b a cycle.
func TestVarInitLenInLiteralWalked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a [2][3]int\n"
			"func mk() @[]@[]int { return make_slice(@[]int, 2) }\n"
			"var t int = func() int { var a @[]@[]int = mk(); return len(a[b]) }()\n"
			"var b int = t\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// iifeShadowSrc is a package with an array arr, an interface Shape and its impl
// *Sq, and then decls.
func iifeShadowSrc(decls *[]readonly char) @[]readonly char {
	return buf.Concat(
			"package \"test\"\nvar arr [3]int\ninterface Shape { Area() int }\n"
					"type Sq struct { s int }\nfunc (q *Sq) Area() int { return q.s }\nimpl *Sq : Shape\n",
			decls)
}

// A name an immediately-invoked literal binds denotes its own variable where it is
// in scope, not the package variable of that name, so reading it there is no
// initialization edge: a parameter, a local declared with var, const or :=, a
// grouped local, a C-style or for-in loop variable, a type switch's binder, a
// nested literal's parameter.
func TestVarInitIIFEShadowNotARead() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 11)
	decls[0] = "var u = func() int { var u = 3; return u }()\n"
	decls[1] = "var u = func(u int) int { return u }(4)\n"
	decls[2] = "var u = func() int { u := 3; return u }()\n"
	decls[3] = "var u = func() int { const u = 5; return u }()\n"
	decls[4] = "var u = func() int { var ( u = 7 ); return u }()\n"
	decls[5] = "var u = func() int { var s = 0; for u := 0; u < 3; u++ { s = s + u }; return s }()\n"
	decls[6] = "var u = func() int { var s = 0; for u in arr { s = s + u }; return s }()\n"
	decls[7] = "var u = func() int { var s = 0; for i, u in arr { s = s + i * u }; return s }()\n"
	decls[8] = "var u = func() int { var q Sq; var sh *Shape = &q\n"
			"\tswitch u := sh.(type) { case *Sq: return u.s }; return 0 }()\n"
	decls[9] = "var u = func() int { return func(u int) int { return u }(1) }()\n"
	decls[10] = "type Config struct { n int }\n"
			"var cfg = func() Config { var cfg Config; cfg.n = 3; return cfg }()\n"
	for i := 0; i < len(decls); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(iifeShadowSrc(decls[i])))
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}

// Out of the binding's scope the name is the package variable again, and reading
// it an edge: after the block, loop, case clause, if or else body, defer block or
// nested literal that declares it; in its own initializer (a grouped var's and a
// loop's init statement too), on the right of a `:=` naming it with others, and
// before its declaration; in the operand a for-in or a type switch binds it over,
// and a later case's value; in the arguments the literal is called with.
func TestVarInitIIFEShadowEndsWithScope() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 20)
	decls[0] = "var u = func() int { { var u = 1; _ = u }; return u }()\n"
	decls[1] = "var u = func() int { var u = u + 1; return u }()\n"
	decls[2] = "var u = func() int { u := u; return u }()\n"
	decls[3] = "var u = func() int { x := u; var u = 3; return x + u }()\n"
	decls[4] = "var u = func(u int) int { return u }(u)\n"
	decls[5] = "var u = func() int {\n"
			"\tswitch 1 { case 1: u := 2; _ = u; case 2: return u }; return 0 }()\n"
	decls[6] = "var u = func() int { for u := 0; u < 1; u++ {}; return u }()\n"
	decls[7] = "var u = func() int { for u in arr { _ = u }; return u }()\n"
	decls[8] = "var u = func() int { var q Sq; var sh *Shape = &q\n"
			"\tswitch u := sh.(type) { case *Sq: _ = u }; return u }()\n"
	decls[9] = "var u = func() int { _ = func(u int) int { return u }(1); return u }()\n"
	decls[10] = "var u = func() int { if true { var u = 1; _ = u }; return u }()\n"
	decls[11] = "var u = func() int { if false { } else { u := 1; _ = u }; return u }()\n"
	decls[12] = "var u = func() int { defer { var u = 1; _ = u }; return u }()\n"
	decls[13] = "var u = func() int { _ = func() int { var u = 1; return u }(); return u }()\n"
	decls[14] = "var u = func() int { x, u := u, 1; return x + u }()\n"
	decls[15] = "var u = func() int { var ( c = 1; u = u + c ); return u }()\n"
	decls[16] = "var u [3]int = func() [3]int { var r [3]int; for u in u { r[0] = u }; return r }()\n"
	decls[17] = "var u = func() int { var s = 0; for u := u; u < 3; u++ { s = s + u }; return s }()\n"
	decls[18] = "var q0 Sq\n"
			"var u *Shape = func() *Shape { switch u := u.(type) { case *Sq: _ = u }; return &q0 }()\n"
	decls[19] = "var u = func() int {\n"
			"\tvar t = 1; switch t { case 2: u := 3; _ = u; case u: return 0 }; return 0 }()\n"
	for i := 0; i < len(decls); i++ {
		var r testing.TestResult = expectErrSub(checkSrc(iifeShadowSrc(decls[i])),
				"variable initialization cycle involving `u`")
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}

// In an immediately-invoked literal's body too, len of an array does not read
// its operand (builtin.len) when the body binds none of the names its type is
// found by: the package's array, a field of one, an element of one and a
// function's result (the function not called), beside a local and a parameter
// that shadow nothing the operand names.
func TestVarInitLenInLiteralNotARead() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 6)
	decls[0] = "var n = func() int { return len(ar) }()\nvar ar [3]int = [3]int{n, 0, 0}\n"
	decls[1] = "type S2 struct { f [2]int }\n"
			"var n = func() int { return len(s2.f) }()\nvar s2 S2 = S2{f: [2]int{n, 0}}\n"
	decls[2] = "var n = func() int { return len(m2[0]) }()\n"
			"var m2 [2][3]int = [2][3]int{[3]int{n, 0, 0}, [3]int{}}\n"
	decls[3] = "func h3(x int) [3]int { var r [3]int; r[0] = x; return r }\n"
			"var n = func() int { return len(h3(b3)) }()\nvar b3 int = n\n"
	decls[4] = "var n = func() int { var k = 1; return len(ar) + k }()\n"
			"var ar [3]int = [3]int{n, 0, 0}\n"
	decls[5] = "var n = func(k int) int { return len(ar) + k }(1)\n"
			"var ar [3]int = [3]int{n, 0, 0}\n"
	for i := 0; i < len(decls); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(iifeShadowSrc(decls[i])))
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}

// A local shadowing the function len's operand calls makes the operand walked
// there: the read of b3 in the call's argument makes n and b3 a cycle.
func TestVarInitLenInLiteralShadowedFuncWalked() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func h3(x int) [3]int { var r [3]int; r[0] = x; return r }\n"
			"var n = func() int {\n"
			"\tvar h3 = func(x int) @[]int { return make_slice(int, x) }\n"
			"\treturn len(h3(b3))\n"
			"}()\n"
			"var b3 int = n\n"
	return expectErrSub(checkSrc(src), "variable initialization cycle")
}
