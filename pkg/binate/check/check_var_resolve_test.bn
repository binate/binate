package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for dependency-ordered package-var initialization
// (check_var_resolve.bn): the syntactic dependency walk (collectVarDeps) and
// the cycle detection it feeds.  Ordering itself is observable only at runtime
// (conformance/regressions/var-init-*), but the walk's decisions — which
// sub-expressions form an init-time edge — are pinned here via the presence or
// absence of a cycle error, which needs no codegen.

// A forward reference to a later-declared typed package var is legal (order,
// not scope) and must not be misreported as a cycle: `b` reads `a`, `a` reads
// nothing.  The dependency walk records a -> (b depends on a) and the sweep
// orders `a` first.
func TestVarInitForwardRefNoCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var b int = a + 1\n"
			"var a int = 41\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A self-referential initializer (`var a = a + 1`) is a degenerate cycle.  The
// single-var package must still be swept (the < 2 fast path would miss this).
func TestVarInitSelfCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = a + 1\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A mutual cycle (`var a = b; var b = a`) has no valid initialization order.
func TestVarInitMutualCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = b\n"
			"var b int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A transitive cycle (`a -> b -> c -> a`) is detected across DFS depth, not
// just at a direct back-edge.
func TestVarInitTransitiveCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = b\n"
			"var b int = c\n"
			"var c int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A function LITERAL body is not run at init, so a reference inside it forms
// NO init-time edge: two package vars whose initializers are closures that
// reference each other must NOT be reported as a cycle.  (If collectVarDeps
// wrongly walked closure bodies, this would be a false f <-> g cycle.)
func TestVarInitClosureRefNoCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var f *func() int = func() int { return g() }\n"
			"var g *func() int = func() int { return f() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A composite-literal element KEY is never a value-position read — a struct
// key is a field NAME.  A field name that coincides with a package var must
// not create a spurious dependency: `x = P{a: 5}` does not read package var
// `a`, so `x` and `a` do not cycle even though `a` reads `x`.  (If Keys were
// collected, this would be a false x <-> a cycle.)
func TestVarInitCompositeKeyNotDep() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type P struct { a int }\n"
			"var x P = P{a: 5}\n"
			"var a int = x.a\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// len of an array does not read its operand (builtin.len), so it forms no
// initialization edge: an initializer may take the length of its own variable,
// of a field of it or of an element of it.
func TestVarInitLenOfArrayNotARead() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func h(n int) [3]int { var a [3]int; a[0] = n; return a }\n"
			"var a [3]int = h(len(a))\n"
			"type S struct { f [2]int }\n"
			"func mk(n int) S { var s S; s.f[0] = n; return s }\n"
			"var s S = mk(len(s.f))\n"
			"func mm(n int) [2][4]int { var m [2][4]int; m[0][0] = n; return m }\n"
			"var m [2][4]int = mm(len(m[0]))\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// len of an array does not read it whether its type is declared or inferred:
// the initialization order is found once the initializers are checked, so it
// knows b is an array whose type its initializer gives (a composite literal, a
// call's result, a field of one, a copy of another array), also when the read is
// in an immediately-invoked literal, or reached through two variables.
func TestVarInitLenOfInferredArrayNotARead() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 6)
	decls[0] = "var a = len(b)\nvar b = [3]int{a, 0, 0}\n"
	decls[1] = "var a = len(b.f)\nvar b = mk(a)\n"
	decls[2] = "var a = len(b)\nvar b = c\nvar c = [3]int{a, 0, 0}\n"
	decls[3] = "var d = x + 0\nvar x = len(z)\nvar z = [3]int{d, 0, 0}\n"
	decls[4] = "var z = [3]int{d, 0, 0}\nvar d = x + 0\nvar x = len(z)\n"
	decls[5] = "var a = func() int { return len(b) }()\nvar b = h(a)\n"
	var shared *[]readonly char = "package \"test\"\n"
			"func h(n int) [3]int { var a [3]int; a[0] = n; return a }\n"
			"type S struct { f [2]int }\n"
			"func mk(n int) S { var s S; s.f[0] = n; return s }\n"
	for i := 0; i < len(decls); i++ {
		var src @[]readonly char = buf.Concat(shared, decls[i])
		var r testing.TestResult = expectNoErrors(checkSrc(src))
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}

// len of an array reached through a type assertion does not evaluate the
// assertion either (builtin.len): taking the length of an array field of what
// sh or mh recovers forms no edge to them, by `*T`, `@T` or a value `T`, nor
// through a dereference.
func TestVarInitLenOfAssertedArrayNotARead() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 4)
	decls[0] = "var a int = len(sh.(*Bx).arr)\n"
	decls[1] = "var a int = len(mh.(@Bx).arr)\n"
	decls[2] = "var a int = len(sh.(Bx).arr)\n"
	decls[3] = "var a int = len((*sh.(*Bx)).arr)\n"
	var shapes *[]readonly char = "interface Shape { Area() int }\n"
			"type Bx struct { arr [3]int }\n"
			"func (q *Bx) Area() int { return len(q.arr) }\n"
			"impl *Bx : Shape\nimpl Bx : Shape\nvar q0 Bx\n"
			"func mk(n int) *Shape { q0.arr[0] = n; return &q0 }\n"
			"func mm(n int) @Shape { var b @Bx = make(Bx); b.arr[0] = n; return b }\n"
			"var sh *Shape = mk(a)\nvar mh @Shape = mm(a)\n"
	for i := 0; i < len(decls); i++ {
		var src @[]readonly char = buf.Concat("package \"test\"\n", buf.Concat(shapes, decls[i]))
		var r testing.TestResult = expectNoErrors(checkSrc(src))
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}

// len of a slice reads it: a slice variable's initializer taking its own length
// is an initialization cycle, and so is taking the length of a variable whose
// type is inferred to be a slice, whose initializer reads the first.
func TestVarInitLenOfSliceIsARead() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "var t @[]int = k(len(t))\n"
	srcs[1] = "var a = len(b)\nvar b = k(a)\n"
	for i := 0; i < len(srcs); i++ {
		var src @[]readonly char = buf.Concat(
				"package \"test\"\n"
						"func k(n int) @[]int { return make_slice(int, n) }\n",
				srcs[i])
		var r testing.TestResult = expectErrSub(checkSrc(src), "variable initialization cycle")
		if len(r) != 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// A main file checked for a REPL session (CheckMainPersistent) gets its
// variables' initialization order too: a, whose initializer takes the length of
// the array b, before b, which reads a; and a cycle of reads is reported.
func TestVarInitOrderPersistentMain() testing.TestResult {
	var p @parser.Parser = parser.New(
			toBytes("package \"test\"\n"
					"var b = [3]int{a, 0, 0}\nvar a = len(b)\nfunc main() {}\n"), "test.bn")
	var c @Checker = NewChecker()
	c.CheckMainPersistent(mustParse(p))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var order @[]@[]char = c.VarInitOrder("test")
	if len(order) != 2 || !types.CharEq(order[0], "a") || !types.CharEq(order[1], "b") {
		return fail("the order must be a, then b")
	}
	var p2 @parser.Parser = parser.New(
			toBytes("package \"test\"\n"
					"var a int = b\nvar b int = a\nfunc main() {}\n"), "test.bn")
	var c2 @Checker = NewChecker()
	c2.CheckMainPersistent(mustParse(p2))
	return expectErrSub(c2, "variable initialization cycle")
}

// A package checked for its declarations alone (CheckPackageDecls) finds no
// initialization order, but a variable whose initializer, checked while types
// are collected, reads itself is still rejected: x, by a cycle of reads.
func TestVarSelfReadJudgedInDeclsOnlyCheck() testing.TestResult {
	var p @parser.Parser = parser.New(
			toBytes(
					"package \"test\"\n"
							"type S struct { arr [3]int }\nfunc hi(n int) S { var s S; return s }\n"
							"type T [len(x)]uint8\nvar x = hi(x[0]).arr\n"), "test.bn")
	var c @Checker = NewChecker()
	c.CheckPackageDecls("test", mustParse(p), make_slice(@ast.File, 0), nil)
	return expectOneErr(c, "variable initialization cycle involving `x`")
}

// A type assertion reads its operand (iface.assert): an initializer asserting on
// sh, whose own initializer reads a, is an initialization cycle — the single-value
// form, the comma-ok forms of := and = in an immediately-invoked literal, a
// local's initializer there, and an assertion as a method call's receiver or as
// a call's argument.
func TestVarInitTypeAssertIsARead() testing.TestResult {
	var decls @[]*[]readonly char = make_slice(*[]readonly char, 6)
	decls[0] = "var a int = sh.(*Sq).s\n"
	decls[1] = "var a = func() int { v, ok := sh.(*Sq); if ok { return v.s }; return 0 }()\n"
	decls[2] = "var a = func() int { var v *Sq; var ok bool\n"
			"\tv, ok = sh.(*Sq); if ok { return v.s }; return 0 }()\n"
	decls[3] = "var a = func() int { var v *Sq = sh.(*Sq); return v.s }()\n"
	decls[4] = "var a int = sh.(*Sq).Area()\n"
	decls[5] = "func f(p *Sq) int { return p.s }\nvar a int = f(sh.(*Sq))\n"
	var sh *[]readonly char = "var q0 Sq\n"
			"func mk(n int) *Shape { q0.s = n; return &q0 }\n"
			"var sh *Shape = mk(a)\n"
	for i := 0; i < len(decls); i++ {
		var src @[]readonly char = iifeShadowSrc(buf.Concat(decls[i], sh))
		var r testing.TestResult = expectErrSub(checkSrc(src), "variable initialization cycle")
		if len(r) != 0 { return buf.Concat(decls[i], r) }
	}
	return ""
}
