package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for dependency-ordered package-var initialization
// (check_var_resolve.bn): the syntactic dependency walk (collectVarDeps) and
// the cycle detection it feeds.  Ordering itself is observable only at runtime
// (conformance/regressions/var-init-*), but the walk's decisions — which
// sub-expressions form an init-time edge — are pinned here via the presence or
// absence of a cycle error, which needs no codegen.

// A forward reference to a later-declared typed package var is legal (order,
// not scope) and must not be misreported as a cycle: `b` reads `a`, `a` reads
// nothing.  The dependency walk records a -> (b depends on a) and the sweep
// orders `a` first.
func TestVarInitForwardRefNoCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var b int = a + 1\n"
			"var a int = 41\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A self-referential initializer (`var a = a + 1`) is a degenerate cycle.  The
// single-var package must still be swept (the < 2 fast path would miss this).
func TestVarInitSelfCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = a + 1\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A mutual cycle (`var a = b; var b = a`) has no valid initialization order.
func TestVarInitMutualCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = b\n"
			"var b int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A transitive cycle (`a -> b -> c -> a`) is detected across DFS depth, not
// just at a direct back-edge.
func TestVarInitTransitiveCycleRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var a int = b\n"
			"var b int = c\n"
			"var c int = a\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}

// A function LITERAL body is not run at init, so a reference inside it forms
// NO init-time edge: two package vars whose initializers are closures that
// reference each other must NOT be reported as a cycle.  (If collectVarDeps
// wrongly walked closure bodies, this would be a false f <-> g cycle.)
func TestVarInitClosureRefNoCycle() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var f *func() int = func() int { return g() }\n"
			"var g *func() int = func() int { return f() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A composite-literal element KEY is never a value-position read — a struct
// key is a field NAME.  A field name that coincides with a package var must
// not create a spurious dependency: `x = P{a: 5}` does not read package var
// `a`, so `x` and `a` do not cycle even though `a` reads `x`.  (If Keys were
// collected, this would be a false x <-> a cycle.)
func TestVarInitCompositeKeyNotDep() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type P struct { a int }\n"
			"var x P = P{a: 5}\n"
			"var a int = x.a\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// len of an array does not read its operand (builtin.len), so it forms no
// initialization edge: an initializer may take the length of its own variable,
// of a field of it or of an element of it.
func TestVarInitLenOfArrayNotARead() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func h(n int) [3]int { var a [3]int; a[0] = n; return a }\n"
			"var a [3]int = h(len(a))\n"
			"type S struct { f [2]int }\n"
			"func mk(n int) S { var s S; s.f[0] = n; return s }\n"
			"var s S = mk(len(s.f))\n"
			"func mm(n int) [2][4]int { var m [2][4]int; m[0][0] = n; return m }\n"
			"var m [2][4]int = mm(len(m[0]))\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// len of a slice reads it: a slice variable's initializer taking its own length
// is an initialization cycle.
func TestVarInitLenOfSliceIsARead() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func k(n int) @[]int { return make_slice(int, n) }\n"
			"var t @[]int = k(len(t))\n"
	var c @Checker = checkSrc(src)
	return expectErrSub(c, "variable initialization cycle")
}
