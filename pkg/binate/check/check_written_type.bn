package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"

// A constraint as its declaration writes it.  An array length that depends on a type
// parameter has a placeholder value in the type (types.Type.ArrayLenDependent), so the
// name of a type holding one shows the placeholder; and since identity does not compare
// such lengths, the generic instances formed from them are one per placeholder, whose
// name is the first one's.  A constraint miss reported in a generic's declaration, where
// the length is not known, names the constraint by its written form instead, and the
// generic that writes it: the form's names are that generic's, which at the use the miss
// is reported at can name other things.

// constraintDisplayName returns how a miss names the constraint iface, the bound of the
// type parameter index of the generic d: as d writes it, followed by ` of ` and d's name
// (`Tag[[sizeof(X)]uint8] of In`), qualified by its package's name when another package
// declares it (`of lib.In`), when iface holds an array length that depends on a type
// parameter and writeWrittenType writes the constraint; else by iface's name.
func constraintDisplayName(c @Checker, iface @types.Type, d @ast.Decl, index int) @[]char {
	if d != nil && index >= 0 && index < len(d.TypeParams) && d.TypeParams[index] != nil &&
			holdsDependentLength(iface) {
		var cb @strings.Builder = strings.NewBuilder()
		if writeWrittenType(cb, d.TypeParams[index].Constraint) {
			cb.Write(" of ")
			var home @[]char = genericDeclHomePkg(c, d)
			if len(home) > 0 && !types.CharEq(home, c.curPkgPath) {
				cb.Write(lastPathSegment(home))
				cb.WriteByte('.')
			}
			cb.Write(d.Name)
			return buf.CopyStr(cb.String())
		}
	}
	return iface.TypeName()
}

// genericDeclHomePkg returns the path of the package that declares the generic d: a
// generic function's home (genericHomeOf), or a generic type's or interface's
// (Checker.GenericDeclPkg).
func genericDeclHomePkg(c @Checker, d @ast.Decl) @[]char {
	var h @GenericHome = genericHomeOf(c, d)
	if h != nil { return h.Pkg }
	return c.GenericDeclPkg(d)
}

// writeWrittenType writes the type expression te into cb as its source writes it, and
// reports whether it could: not when it holds an expression writeWrittenExpr does not.
func writeWrittenType(cb @strings.Builder, te @ast.TypeExpr) bool {
	if te == nil { return false }
	var k int = te.Kind
	if k == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 {
			cb.Write(te.Pkg)
			cb.WriteByte('.')
		}
		cb.Write(te.Name)
		return true
	}
	if k == ast.TEXPR_TYPE_PARAM {
		cb.Write(te.Name)
		return true
	}
	if k == ast.TEXPR_SELF {
		cb.Write("Self")
		return true
	}
	if k == ast.TEXPR_POINTER || k == ast.TEXPR_MANAGED || k == ast.TEXPR_SLICE ||
			k == ast.TEXPR_MANAGED_SLICE || k == ast.TEXPR_CONST {
		cb.Write(writtenTypePrefix(k))
		return writeWrittenType(cb, te.Base)
	}
	if k == ast.TEXPR_ARRAY {
		cb.WriteByte('[')
		if te.LenInferred {
			cb.Write("...")
		} else if !writeWrittenExpr(cb, te.Len) {
			return false
		}
		cb.WriteByte(']')
		return writeWrittenType(cb, te.Base)
	}
	if k == ast.TEXPR_PAREN {
		cb.WriteByte('(')
		if !writeWrittenType(cb, te.Base) { return false }
		cb.WriteByte(')')
		return true
	}
	if k == ast.TEXPR_INSTANTIATE {
		if !writeWrittenType(cb, te.Base) { return false }
		return writeWrittenTypeList(cb, te.TypeArgs, '[', ']', false)
	}
	if k == ast.TEXPR_STRUCT { return writeWrittenStruct(cb, te) }
	if k == ast.TEXPR_FUNC_VALUE || k == ast.TEXPR_MANAGED_FUNC_VALUE {
		cb.Write(writtenTypePrefix(k))
		cb.Write("func")
		if !writeWrittenTypeList(cb, te.ParamTypes, '(', ')', te.VariadicParams) { return false }
		if len(te.ResultTypes) == 1 {
			cb.WriteByte(' ')
			return writeWrittenType(cb, te.ResultTypes[0])
		}
		if len(te.ResultTypes) > 1 {
			cb.WriteByte(' ')
			return writeWrittenTypeList(cb, te.ResultTypes, '(', ')', false)
		}
		return true
	}
	return false
}

// writtenTypePrefix returns what a type expression of kind k writes before its base: a
// pointer's `*`, a managed pointer's `@`, a slice's `*[]`, a managed-slice's `@[]`,
// `readonly `, or a function value's `*` / `@`.
func writtenTypePrefix(k int) *[]readonly char {
	if k == ast.TEXPR_POINTER || k == ast.TEXPR_FUNC_VALUE { return "*" }
	if k == ast.TEXPR_MANAGED || k == ast.TEXPR_MANAGED_FUNC_VALUE { return "@" }
	if k == ast.TEXPR_SLICE { return "*[]" }
	if k == ast.TEXPR_MANAGED_SLICE { return "@[]" }
	return "readonly "
}

// writeWrittenTypeList writes the type expressions list between open and shut, apart by
// ", ", the last one after `...` when variadic, and reports whether it could.
func writeWrittenTypeList(cb @strings.Builder, list @[]@ast.TypeExpr, open uint8, shut uint8,
		variadic bool) bool {
	cb.WriteByte(open)
	for i := 0; i < len(list); i++ {
		if i > 0 { cb.Write(", ") }
		if variadic && i == len(list) - 1 { cb.Write("...") }
		if !writeWrittenType(cb, list[i]) { return false }
	}
	cb.WriteByte(shut)
	return true
}

// writeWrittenStruct writes the struct type te as written, its fields on one line as a
// struct type's name has them (`struct { a A; b B }`, a field with no name as its type),
// and reports whether it could.
func writeWrittenStruct(cb @strings.Builder, te @ast.TypeExpr) bool {
	if len(te.Fields) == 0 {
		cb.Write("struct {}")
		return true
	}
	cb.Write("struct { ")
	for i := 0; i < len(te.Fields); i++ {
		if i > 0 { cb.Write("; ") }
		if te.Fields[i] == nil { return false }
		if len(te.Fields[i].Name) > 0 {
			cb.Write(te.Fields[i].Name)
			cb.WriteByte(' ')
		}
		if !writeWrittenType(cb, te.Fields[i].Type) { return false }
	}
	cb.Write(" }")
	return true
}

// writeWrittenExpr writes the constant expression e into cb as written, in the
// parentheses its source puts it in, and reports whether it is one this writes: a
// literal or name, an operator or a selector applied to ones, a builtin, conversion or
// index of ones, or a type.
func writeWrittenExpr(cb @strings.Builder, e @ast.Expr) bool {
	if e == nil { return false }
	if e.Parenthesized { cb.WriteByte('(') }
	var ok bool = writeWrittenOperand(cb, e)
	if e.Parenthesized { cb.WriteByte(')') }
	return ok
}

// writeWrittenOperand is writeWrittenExpr for e without its parentheses.
func writeWrittenOperand(cb @strings.Builder, e @ast.Expr) bool {
	var k int = e.Kind
	if k == ast.EXPR_IDENT || k == ast.EXPR_INT_LIT || k == ast.EXPR_FLOAT_LIT ||
			k == ast.EXPR_CHAR_LIT {
		cb.Write(e.Name)
		return true
	}
	if k == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			cb.Write(e.Name)
		} else if e.BoolVal {
			cb.Write("true")
		} else {
			cb.Write("false")
		}
		return true
	}
	if k == ast.EXPR_BINARY {
		if !writeWrittenExpr(cb, e.X) { return false }
		cb.WriteByte(' ')
		cb.Write(token.TypeName(cast(token.Type, e.Op)))
		cb.WriteByte(' ')
		return writeWrittenExpr(cb, e.Y)
	}
	if k == ast.EXPR_UNARY {
		var op token.Type = cast(token.Type, e.Op)
		cb.Write(token.TypeName(op))
		// Two of `-`, `+` or `&` in a row are apart, as `- -x`: written together, they
		// would read as one token.
		if e.X != nil && e.X.Kind == ast.EXPR_UNARY && !e.X.Parenthesized && e.X.Op == e.Op &&
				(op == token.MINUS || op == token.PLUS || op == token.AMP) {
			cb.WriteByte(' ')
		}
		return writeWrittenExpr(cb, e.X)
	}
	if k == ast.EXPR_SELECTOR {
		if !writeWrittenExpr(cb, e.X) { return false }
		cb.WriteByte('.')
		cb.Write(e.Name)
		return true
	}
	if k == ast.EXPR_BUILTIN { return writeWrittenBuiltin(cb, e) }
	if k == ast.EXPR_INSTANTIATE_OR_INDEX && e.Unchecked {
		// The check rewrites `unsafe_index(c, i)` in place into the index `c[i]` it is,
		// marked (lowerUnsafeIndex).
		if len(e.Args) != 1 { return false }
		cb.Write("unsafe_index(")
		if !writeWrittenExpr(cb, e.X) { return false }
		cb.Write(", ")
		if !writeWrittenExpr(cb, e.Args[0]) { return false }
		cb.WriteByte(')')
		return true
	}
	if k == ast.EXPR_CALL || k == ast.EXPR_INSTANTIATE_OR_INDEX {
		if e.Spread || !writeWrittenExpr(cb, e.X) { return false }
		if k == ast.EXPR_CALL { return writeWrittenExprList(cb, e.Args, '(', ')') }
		return writeWrittenExprList(cb, e.Args, '[', ']')
	}
	if k == ast.EXPR_TYPE { return writeWrittenType(cb, e.TypeRef) }
	return false
}

// writeWrittenBuiltin writes the builtin call e as written -- its keyword, then its
// type operand and its arguments -- and reports whether it could: not a C call or
// global, which no constant expression is.
func writeWrittenBuiltin(cb @strings.Builder, e @ast.Expr) bool {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL || op == token.C_GLOBAL { return false }
	cb.Write(token.TypeName(op))
	if e.TypeRef == nil { return writeWrittenExprList(cb, e.Args, '(', ')') }
	cb.WriteByte('(')
	if !writeWrittenType(cb, e.TypeRef) { return false }
	for i := 0; i < len(e.Args); i++ {
		cb.Write(", ")
		if !writeWrittenExpr(cb, e.Args[i]) { return false }
	}
	cb.WriteByte(')')
	return true
}

// writeWrittenExprList writes the expressions list between open and shut, apart by
// ", ", and reports whether it could.
func writeWrittenExprList(cb @strings.Builder, list @[]@ast.Expr, open uint8, shut uint8) bool {
	cb.WriteByte(open)
	for i := 0; i < len(list); i++ {
		if i > 0 { cb.Write(", ") }
		if !writeWrittenExpr(cb, list[i]) { return false }
	}
	cb.WriteByte(shut)
	return true
}
