package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for check_written_type.bn: a constraint miss in a generic's declaration names
// a constraint that holds an array length depending on a type parameter as written.

// writtenType returns what writeWrittenType writes for te, the type of A in `type A =
// te`, or "<not written>" when it writes none.
func writtenType(te *[]readonly char) @[]char {
	var src @[]char = buf.Concat(buf.Concat("package \"test\"\ntype A = ", te), "\n")
	var file @ast.File = mustParse(parser.New(toBytes(src), "test.bn"))
	var cb @strings.Builder = strings.NewBuilder()
	if !writeWrittenType(cb, file.Decls[0].TypeRef) { return buf.CopyStr("<not written>") }
	return buf.CopyStr(cb.String())
}

// expectWritten expects writeWrittenType to write te as it is written.
func expectWritten(te *[]readonly char) testing.TestResult {
	var got @[]char = writtenType(te)
	if !charsHaveSub(got, te) || len(got) != len(te) {
		return fail(buf.Concat("written as ", got))
	}
	return ""
}

// Each kind of type expression, and each kind of constant expression in a length, is
// written as the source writes it, in its parentheses.
func TestWrittenTypeAsSourceWritesIt() testing.TestResult {
	var forms [10]*[]readonly char
	forms[0] = "Tag[[(sizeof(X) + 2) * k.K]uint8, *[]readonly int, @[]@T]"
	forms[1] = "Pair[[-K + alignof(@[]X)]uint8, *func(int, ...X) bool]"
	forms[2] = "[cast(int, sizeof(struct { a X; b [2]X })) - len(tbl[0])]@func() (int, bool)"
	forms[3] = "[- -K]int"
	forms[4] = "[-(-K) << 1]struct {}"
	forms[5] = "*([int(c) % 'a']T)"
	forms[6] = "[cast(int, true)]@func(*func() X)"
	forms[7] = "@[]p.Q[[sizeof(X) / 2.0]uint8]"
	forms[8] = "[-~K * sizeof(struct { T; a X })]@[]T"
	forms[9] = "[cast(int, !!b) + - -K]T"
	for i := 0; i < len(forms); i++ {
		var r testing.TestResult = expectWritten(forms[i])
		if len(r) > 0 { return r }
	}
	return ""
}

// A length that is no constant expression -- a C global's value -- is not written.
func TestWrittenTypeOfCGlobalLengthNotWritten() testing.TestResult {
	var got @[]char = writtenType("Tag[[__c_global(\"n\", int)]uint8]")
	if !charsHaveSub(got, "<not written>") { return fail(buf.Concat("written as ", got)) }
	return ""
}

// Out's check rejects In[@T, X] whatever length X gives, and names In's constraint as
// In writes it, with In's name, not with the length's placeholder 0.
func TestDeclarationMissNamesDependentConstraintAsWritten() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Tag[X any] { tag() int }\n"
					"func In[V Tag[[sizeof(X)]uint8], X any](v V) int { return v.tag() }\n"
					"type T struct { n int }\nfunc Out[X any]() int { return In[@T, X](make(T)) }\n")
	return errsIn(c, "type argument @T does not satisfy constraint Tag[[sizeof(X)]uint8] of In")
}

// Tag's instances for In1's and In2's constraints are one, its length a placeholder in
// both; each miss names its own generic's constraint, as written.
func TestDeclarationMissesNameTheirOwnConstraints() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Tag[X any] { tag() int }\n"
					"func In1[V Tag[[sizeof(X)]uint8], X any](v V) int { return v.tag() }\n"
					"func In2[V Tag[[sizeof(X) * 2]uint8], X any](v V) int { return v.tag() }\n"
					"type T struct { n int }\nfunc Out1[X any]() int { return In1[@T, X](make(T)) }\n"
					"func Out2[X any]() int { return In2[@T, X](make(T)) }\n")
	if len(c.CheckerErrors()) != 2 ||
			!anyErrContains(c,
					"type argument @T does not satisfy constraint Tag[[sizeof(X)]uint8] of In1") ||
			!anyErrContains(c,
					"type argument @T does not satisfy constraint Tag[[sizeof(X) * 2]uint8] of In2") {
		return fail("expected Out1's and Out2's misses, each naming its constraint")
	}
	return ""
}

// A length reading an imported constant names it as written, qualified by the package.
func TestDeclarationMissNamesQualifiedConstAsWritten() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/k", "package \"pkg/k\"\nconst K int = 2\n",
			"package \"test\"\nimport \"pkg/k\"\ninterface Tag[X any] { tag() int }\n"
					"func In[V Tag[[sizeof(X) * k.K]uint8], X any](v V) int { return v.tag() }\n"
					"type T struct { n int }\nfunc Out[X any]() int { return In[@T, X](make(T)) }\n")
	return errsIn(c, "type argument @T does not satisfy constraint Tag[[sizeof(X) * k.K]uint8] of In")
}

// The names of In's constraint are In's, which Out's do not change: Out's X is not In's.
func TestDeclarationMissNamesTheGenericWritingIt() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Tag[X any] { tag() int }\n"
					"func In[V Tag[[sizeof(X)]uint8], X any](v V) int { return v.tag() }\n"
					"type T struct { n int }\nfunc Out[X any, Y any]() int { return In[@T, Y](make(T)) }\n")
	return errsIn(c, "type argument @T does not satisfy constraint Tag[[sizeof(X)]uint8] of In")
}

// Nor do another package's: lib's In writes Tag and K, the names of lib's declarations, which
// the package reporting the miss declares too; the generic is named with its package's.
func TestDeclarationMissNamesAnImportedGenericWritingIt() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/lib",
			"package \"pkg/lib\"\ninterface Tag[X any] { tag() int }\nconst K int = 2\n"
					"func In[V Tag[[sizeof(X) * K]uint8], X any](v V) int { return v.tag() }\n",
			"package \"test\"\nimport \"pkg/lib\"\ninterface Tag[X any] { tag() int }\nconst K int = 3\n"
					"type T struct { n int }\n"
					"func Out[X any, Y any]() int { return lib.In[@T, Y](make(T)) }\n")
	return errsIn(c,
			"type argument @T does not satisfy constraint Tag[[sizeof(X) * K]uint8] of lib.In")
}

// A constraint whose length comes from its argument, not its text, is named as written too:
// Eq[B] of In2, B's argument written at the use.
func TestDeclarationMissOfArgumentsLengthNamedAsWritten() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Eq[T any] { eq(o T) int }\n"
					"func In2[A Eq[B], B any](a A) int { return 1 }\ntype T struct { n int }\n"
					"func Out2[U any, B any]() int { return In2[@T, [sizeof(U)]uint8](make(T)) }\n")
	return errsIn(c, "type argument @T does not satisfy constraint Eq[B] of In2")
}

// The check rewrites `unsafe_index(c, i)` into the index it is; the constraint names it as
// written.
func TestDeclarationMissNamesUnsafeIndexAsWritten() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ninterface Tag[X any] { tag() int }\nvar tbl [3][4]int\n"
					"func In3[V Tag[[len(unsafe_index(tbl, 0)) + sizeof(X)]uint8], X any](v V) int {\n"
					"\treturn v.tag()\n}\n"
					"type T struct { n int }\nfunc Out3[X any]() int { return In3[@T, X](make(T)) }\n")
	return errsIn(c,
			"type argument @T does not satisfy constraint Tag[[len(unsafe_index(tbl, 0)) + sizeof(X)]uint8] "
					"of In3")
}
