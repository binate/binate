package "pkg/binate/check"

import "pkg/binate/types"

// The Checker's accessor methods: how code outside the package reads and sets
// the few fields it needs.

// Interpreted reports whether this Checker checks code destined for an
// interpreted context (the bytecode VM / REPL), where the native-only
// `__c_call` FFI can never run and is rejected at the frontend.  It is off for
// cmd/bnc, where `__c_call` lowers to a real C call.
func (c @Checker) Interpreted() bool {
	return c.Interpreted
}

// SetInterpreted marks this Checker as checking for an interpreted context (see
// Interpreted).  An embedder that runs the checked code on the bytecode VM /
// REPL sets it before checking.
func (c @Checker) SetInterpreted(v bool) {
	c.Interpreted = v
}

// Pending returns the parked declarations that could not fully resolve at
// first-check time (see PendingDecl).  The REPL driver walks these to retry
// them and to announce the ones still parked.
func (c @Checker) Pending() @[]@types.PendingDecl {
	return c.Pending
}

// PendingMark is the len(Pending) snapshot taken when the current declaration
// began checking; entries at or beyond this index were parked by that
// declaration (see Pending).
func (c @Checker) PendingMark() int {
	return c.PendingMark
}

// Scope returns the checker's current symbol scope.  The REPL resolves symbols
// through it (Scope.Lookup) after a check leaves the main file's scope
// installed.
func (c @Checker) Scope() @Scope {
	return c.Scope
}
