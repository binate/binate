package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the Checker's accessor methods.  Each reuses its field's name, so
// inside this package a selector `c.Interpreted` names the field, which takes
// precedence over the same-named method (expr.member); the tests call the
// methods through method expressions (`Checker.Interpreted(c)`).

// SetInterpreted sets what Interpreted reports, and the check reads it: a
// `__c_call` is rejected in an interpreted context.
func TestCheckerSetInterpreted() testing.TestResult {
	var c @Checker = NewChecker()
	if Checker.Interpreted(c) { return fail("a new Checker must not be interpreted") }
	Checker.SetInterpreted(c, true)
	if !Checker.Interpreted(c) { return fail("SetInterpreted(true) must take effect") }
	var p @parser.Parser = parser.New(
			toBytes(
					"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"abs\", int32, x) }\n"), "test.bn")
	var file @ast.File = p.ParseFile()
	c.Check(file)
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_call must be rejected after SetInterpreted(true)")
	}
	Checker.SetInterpreted(c, false)
	if Checker.Interpreted(c) { return fail("SetInterpreted(false) must take effect") }
	return ""
}

// Pending and PendingMark report the parked declarations and the mark the
// current declaration began at.
func TestCheckerPendingAccessors() testing.TestResult {
	var c @Checker = NewChecker()
	if len(Checker.Pending(c)) != 0 || Checker.PendingMark(c) != 0 {
		return fail("a new Checker has no parked declarations")
	}
	var p @types.PendingDecl = make(types.PendingDecl)
	c.Pending = slices.Append[@types.PendingDecl](c.Pending, p)
	c.PendingMark = 1
	var got @[]@types.PendingDecl = Checker.Pending(c)
	if len(got) != 1 || !same(got[0], p) || Checker.PendingMark(c) != 1 {
		return fail("Pending / PendingMark must report the checker's own")
	}
	return ""
}

// Scope returns the checker's current scope, through which names resolve.
func TestCheckerScopeAccessor() testing.TestResult {
	var c @Checker = NewChecker()
	if !same(Checker.Scope(c), c.Scope) { return fail("Scope() must be the current scope") }
	var sym @Symbol = Checker.Scope(c).Lookup("int")
	if sym == nil || sym.Kind != types.SYM_TYPE {
		return fail("the universe type int must resolve through Scope()")
	}
	return ""
}
