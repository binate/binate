package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"

// genericState holds the checker's generic declarations, the instantiations built
// from them, and the bookkeeping of building them (Checker.Generics).
type genericState struct {
	// TypeDecls: AST decls for generic struct declarations
	// (DECL_TYPE with non-empty TypeParams).  Pass 1 stashes the AST
	// here instead of resolving the struct body (T is unbound at decl
	// time); use sites
	// `Name[T1, T2]` look up by Name and instantiate fresh,
	// caching the result in Instantiations.
	TypeDecls @[]@ast.Decl

	// TypeDeclPkgs: parallel array carrying each entry's
	// defining package's short-name — empty for the current
	// (main) package, the import alias for entries registered
	// from an imported .bni.
	// lookupGenericTypeDeclPkg uses this to disambiguate
	// `Pair[int]` from `otherpkg.Pair[int]`.
	TypeDeclPkgs @[]@[]char

	// IfaceDecls: AST decls for generic interface
	// declarations (DECL_INTERFACE with non-empty TypeParams).
	// Same pattern as TypeDecls — Pass 1 stashes the AST
	// instead of resolving the method set (T is unbound at decl time);
	// use sites `Name[T1, T2]` look up by Name and instantiate
	// fresh, caching alongside structs in Instantiations.
	IfaceDecls @[]@ast.Decl

	// IfaceDeclPkgs: parallel pkg-pairing for
	// IfaceDecls.
	IfaceDeclPkgs @[]@[]char

	// TypeDeclScopes / IfaceDeclScopes: parallel to
	// TypeDecls / IfaceDecls — the DEFINING-FILE import scope
	// each generic decl's body must resolve its package-qualified field/method
	// types against.  Recorded because a generic body is resolved LAZILY at the
	// (possibly cross-package) instantiation site, where the use-site c.Scope
	// would otherwise bind a qualifier to the consumer's imports (wrong package
	// → wrong layout).  The @Scope survives past checkPackageImpl (file scopes
	// are only dropped from the FileScope arrays; the object + its SYM_PKG
	// PkgPath→lookupPackage mapping stay live via c.Packages).
	TypeDeclScopes  @[]@Scope
	IfaceDeclScopes @[]@Scope

	// Methods: the generic-receiver method decls (`func (b @Box[T]) Get()
	// T`) — a local generic type's (collectGenericMethodDecl) and an imported
	// one's (stashed at `.bni` load, bni_scope) — each with its defining package
	// and scope (recordGenericMethod).  Each instantiation's methods are
	// resolved from these declarations with the instantiation's arguments
	// (copyPlaceholderMethods), keyed by defining package + receiver base type
	// name.  Bodies (needed for the consumer to monomorphize) ride the AST decl,
	// as for generic functions.
	Methods @[]@GenericMethodEntry
	// Gen counts the changes to TypeDecls, IfaceDecls and
	// Methods (bumpGenericGen): what is derived from them all — which
	// generics form infinite families (expandVerdictOf) — is redone after one.
	Gen int

	// DerivingInstanceSig is true while a signature is resolved for an
	// instantiation from its generic's declaration (an instance's methods, a
	// generic function instance): generic instantiations there are the
	// declaration's, not written at a use, so a constraint miss in them is the
	// declaration's own, which its abstract check reports.
	DerivingInstanceSig bool

	// Instantiations: cache of (decl, type-args) →
	// instantiated @types.Type so `List[int]` produces the same @types.Type
	// across uses (Identical-comparison works).  Indexed in
	// insertion order; lookup walks the list.
	Instantiations @[]@GenericInstantiation

	// AliasInstantiations holds, per (generic alias, type-args), the copy of the
	// alias its target was resolved from (instantiateGenericAlias); kept apart
	// from Instantiations, whose results are the instances themselves.
	AliasInstantiations @[]@GenericInstantiation
	// AliasResolving holds the alias instantiations whose targets are being
	// resolved since the innermost defined instantiation began populating: an
	// alias reached again within them refers to itself with no defined type in
	// between, which is an invalid recursive alias.
	AliasResolving @[]@GenericInstantiation

	// DeclsResolved lists the generic struct / interface declarations
	// already resolved with their type parameters abstract
	// (resolveGenericTypeDeclAbstract).
	DeclsResolved @[]@ast.Decl

	// InstDepth is the current nesting depth of generic
	// instantiation (instantiateGenericDeclWithArgs, and a generic alias's
	// target, instantiateGenericAlias).  Bounds infinitely-growing
	// instantiation chains (`type Box[T] struct { inner @Box[Wrap[T]] }`)
	// — each level has different type args, so the placeholder cache never
	// hits; the depth bound rejects them with a clean diagnostic instead of
	// overflowing the stack.  While it is nonzero an instance may still be
	// being built, so the checks of interface instances and generic alias uses
	// wait for it to return to zero (deferUntilBuilt).
	InstDepth int

	// IfacePopulating is the stack of instantiated generic
	// interfaces whose extension clause is currently being resolved.
	// resolveInterfaceExtension consults it to detect an inheritance
	// cycle across distinct instantiated interfaces (`interface P[T] :
	// Q[T]` + `interface Q[T] : P[T]`): the back-edge parent resolves
	// to an interface still on this stack, so it is reported and
	// dropped — keeping the Parents graph acyclic so the ancestor-
	// closure walks (ifaceFullMethods / isDescendantInterface) can't
	// loop.  (Direct self-extension is caught separately by name.)
	IfacePopulating @[]@types.Type
}
