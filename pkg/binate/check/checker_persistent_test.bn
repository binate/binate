package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the REPL / persistent-mode checker entry points
// (CheckMainPersistent, Check{Decl,Expr,StmtList}InScope), split out with
// checker_persistent.bn.  toBytes lives in checker_util_test.bn (shared).

// ============================================================
// REPL entry-point tests
// ============================================================

// replParseExpr is a small helper to parse a single expression from
// a string, used by the REPL entry-point tests below.
func replParseExpr(src *[]readonly char) @ast.Expr {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	return mustParseExpr(p)
}

// replParseDecl parses a top-level declaration from a string.
func replParseDecl(src *[]readonly char) @ast.Decl {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	return mustParseDecl(p)
}

// replParseStmtList parses a stmt list from a string.
func replParseStmtList(src *[]readonly char) @[]@ast.Stmt {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	return mustParseStmts(p)
}

// TestCheckExprInScopeBasic checks a simple binary expression and
// verifies the inferred type is int.
func TestCheckExprInScopeBasic() testing.TestResult {
	var e @ast.Expr = replParseExpr("1 + 2")
	var c @Checker = NewChecker()
	var t @types.Type = c.CheckExprInScope(e)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors for 1+2")
	}
	if t == nil { return fail("expected non-nil type") }
	// Untyped int literal expressions resolve to int (TYP_INT or
	// TYP_UNTYPED_INT depending on context); accept either.
	if t.Kind != types.TYP_INT && t.Kind != types.TYP_UNTYPED_INT {
		return fail("expected int-like type")
	}
	return ""
}

// TestCheckExprInScopeUndefined verifies an undefined identifier
// surfaces as an error rather than crashing.
func TestCheckExprInScopeUndefined() testing.TestResult {
	var e @ast.Expr = replParseExpr("undefined_name")
	var c @Checker = NewChecker()
	c.CheckExprInScope(e)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected an error for undefined name")
	}
	return ""
}

// TestCheckStmtListInScopeBasic checks a small statement list with a
// var decl and a follow-up assignment.
func TestCheckStmtListInScopeBasic() testing.TestResult {
	var ss @[]@ast.Stmt = replParseStmtList("var x int = 5; x = x + 1")
	var c @Checker = NewChecker()
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors")
	}
	return ""
}

// TestCheckStmtListInScopeNoLeak verifies that local var decls in the
// stmt list do not leak into c.Scope after the call returns.
func TestCheckStmtListInScopeNoLeak() testing.TestResult {
	var ss @[]@ast.Stmt = replParseStmtList("var temp int = 5")
	var c @Checker = NewChecker()
	c.CheckStmtListInScope(ss)
	// After the call, `temp` must not be visible in c.Scope.
	if c.Scope.Lookup("temp") != nil {
		return fail("local var leaked into outer scope")
	}
	return ""
}

// TestCheckDeclInScope verifies that a single func decl typed at
// the prompt registers in c.Scope persistently and that the body
// is checked.
func TestCheckDeclInScope() testing.TestResult {
	var src *[]readonly char = "func double(x int) int { return x * 2 }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `func double(x int) int`")
	}
	if c.Scope.Lookup("double") == nil {
		return fail("double not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckDeclInScopeBadBody verifies that a func decl whose body
// has a type error surfaces an error (and doesn't silently accept).
func TestCheckDeclInScopeBadBody() testing.TestResult {
	var src *[]readonly char = "func bad() int { return \"not an int\" }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected an error for body-type mismatch")
	}
	return ""
}

// TestCheckDeclInScopeConst verifies that a single typed const
// decl typed at the prompt registers a Const symbol in c.Scope.
func TestCheckDeclInScopeConst() testing.TestResult {
	var src *[]readonly char = "const K int = 42"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `const K int = 42`")
	}
	if c.Scope.Lookup("K") == nil {
		return fail("K not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckDeclInScopeConstGroup verifies that a grouped const
// block (single-line form) registers each member persistently.
func TestCheckDeclInScopeConstGroup() testing.TestResult {
	var src *[]readonly char = "const ( A = 10; B = 20 )"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on grouped const")
	}
	if c.Scope.Lookup("A") == nil { return fail("A not in scope") }
	if c.Scope.Lookup("B") == nil { return fail("B not in scope") }
	return ""
}

// TestCheckDeclInScopeConstGroupRedeclared verifies that a const group typed at
// the prompt that declares a name twice is rejected as it is in a file, at the
// later member, and binds nothing: its members are checked one at a time, and the
// later A would otherwise be taken for a redefinition of the earlier.
func TestCheckDeclInScopeConstGroupRedeclared() testing.TestResult {
	var c @Checker = NewChecker()
	c.CheckDeclInScope(replParseDecl("const ( A int = 1; B int = A; A int = 2 )"))
	if !isOneRedeclaredA(c, 31) { return fail("the later A must be the one error") }
	if c.Scope.Lookup("A") != nil || c.Scope.Lookup("B") != nil {
		return fail("the rejected group must bind nothing")
	}
	return ""
}

// TestCheckGroupNames verifies that CheckGroupNames fails a var group that
// declares a name twice, reporting the later member, and passes one whose
// names differ or are blank, and a type group of a forward declaration and the
// type's definition (two definitions are the type redefinition check's).
func TestCheckGroupNames() testing.TestResult {
	var c @Checker = NewChecker()
	if c.CheckGroupNames(replParseDecl("var ( A int = 1; B int = A; A int = 2 )")) {
		return fail("a var group declaring A twice must fail")
	}
	if !isOneRedeclaredA(c, 29) { return fail("the later A must be the one error") }
	if !c.CheckGroupNames(replParseDecl("var ( _ int = 1; _ int = 2; C int = 3 )")) {
		return fail("a var group of blank and distinct names must pass")
	}
	if !c.CheckGroupNames(replParseDecl("type ( T; T struct { a int } )")) {
		return fail("a forward type and its definition must pass")
	}
	if len(c.CheckerErrors()) != 1 { return fail("the groups that pass must report nothing") }
	return ""
}

// isOneRedeclaredA reports whether c's one error is A redeclared, at column col.
func isOneRedeclaredA(c @Checker, col int) bool {
	var errs @[]CheckError = c.CheckerErrors()
	return len(errs) == 1 && errs[0].Pos.Col == col &&
			charsHaveSub(errs[0].Msg, "A redeclared in this block")
}

// TestCheckDeclInScopeVar verifies that a single typed var decl
// typed at the prompt registers a Var symbol in c.Scope.
func TestCheckDeclInScopeVar() testing.TestResult {
	var src *[]readonly char = "var counter int"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `var counter int`")
	}
	if c.Scope.Lookup("counter") == nil {
		return fail("counter not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckMainPersistentLeavesScope verifies that decls from a
// main file are visible in c.Scope after CheckMainPersistent
// returns — the property the REPL relies on.
//
// The REPL's pending-declaration tests live in check_pending_test.bn.

func TestCheckMainPersistentLeavesScope() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() int { return 7 }\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = mustParse(p)
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no checker errors")
	}
	if c.Scope.Lookup("helper") == nil {
		return fail("helper not visible in c.Scope after CheckMainPersistent")
	}
	return ""
}

// CheckMainPersistent must stamp the package path onto interfaces declared in
// the REPL main file (via curPkgPath), like Check does.  An empty Pkg breaks
// the (Pkg, Name) identity used to match a REPL-defined interface against an
// imported one.
func TestCheckMainPersistentStampsInterfacePkg() testing.TestResult {
	var b @[]uint8 = toBytes("package \"mypkg\"\ninterface Greeter { Hi() int }\n")
	var p @parser.Parser = parser.New(b, "test.bn")
	var file @ast.File = mustParse(p)
	var c @Checker = NewChecker()
	c.CheckMainPersistent(file)
	var sym @Symbol = c.Scope.Lookup("Greeter")
	if sym == nil { return fail("Greeter interface not in persistent scope") }
	if sym.Type == nil { return fail("Greeter symbol has no type") }
	if !types.CharEq(sym.Type.Pkg, "mypkg") {
		return fail("REPL-defined interface should carry its package path mypkg")
	}
	return ""
}

// A REPL statement list types an untyped constant shift value with a
// non-constant count like any declaration does: `x := 1 << n` defaults to int
// (spec §13.5 expr.shift.untyped-value), not the count's uint8.
func TestCheckStmtListInScopeDefaultsUntypedShift() testing.TestResult {
	var ss @[]@ast.Stmt = replParseStmtList("var n uint8 = 9\nx := 1 << n\n_ = x\n")
	var c @Checker = NewChecker()
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) != 0 { return fail("expected no errors") }
	if len(ss) < 2 || len(ss[1].Exprs2) != 1 { return fail("unexpected parse") }
	if c.ExprType(ss[1].Exprs2[0].ResolvedTypeID) != types.TypInt() {
		return fail("`x := 1 << n` in a REPL statement list must default the shift to int")
	}
	return ""
}
