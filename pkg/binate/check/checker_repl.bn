package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"

// replState holds the state of the REPL's declaration-at-a-time checking
// (Checker.Repl): the tentative check that parks a declaration naming what is not
// declared yet, the parked declarations, and the modes the REPL's entry points set.
type replState struct {
	// TopScope is the scope of the REPL's immediate-mode statement list while
	// CheckStmtListInScope checks it, nil otherwise: a `defer` directly in it has
	// no enclosing block to wait for — it would run at once — and is rejected,
	// while one in a nested block is not (stmt.defer).
	TopScope @Scope

	// AllowRedef: when true, suppresses the bni-vs-bn signature
	// match check that normally fires whenever a function name is
	// already in local scope.  Set by REPL entry points
	// (CheckDeclInScope) so re-typing a func at the prompt isn't
	// reported as a "bni declared X" mismatch.  Off by default;
	// the compile-time path keeps the check active.
	AllowRedef bool

	// REPL forward references (check_pending.bn).  While TentativeMode is
	// set, errors go to TentativeErrors instead of Errors, and a name used
	// but not bound (errUndefined, a method missing from a session type,
	// an unbound constant in a constant expression) is captured in
	// TentativeMissing.  After a declaration's check:
	//   - TentativeMissing non-empty → the declaration parks on Pending
	//     (the missing names are why; the errors that followed them are
	//     noise).
	//   - TentativeMissing empty but TentativeErrors non-empty → real
	//     errors, reported.
	// The names of the session the check finds bound are captured in
	// TentativeUses (noteNameUse, noteMethodUse).
	TentativeMode    bool
	TentativeMissing @[]@[]char
	TentativeUses    @[]@[]char
	TentativeErrors  @[]types.CheckError
	Pending          @[]@types.PendingDecl
	// IotaDecls / Iotas give a const-group member checked outside its group
	// — a REPL group member, checked with the declarations it depends on
	// (checkDeclsTentative) — the iota of its position in its group.
	IotaDecls @[]@ast.Decl
	Iotas     @[]int

	// PendingMark is the length of Pending at the entry to the
	// most recent CheckDeclInScope call.  IsDeclPending() reports
	// whether Pending grew during that call (covering both the
	// single-decl case and DECL_GROUP per-member parking — where
	// TentativeMissing alone wouldn't, since the group loop
	// resets it per member).  REPL driver also walks
	// `Pending[PendingMark:]` to iterate every decl that just
	// parked, for per-decl "X parked (pending: ...)" announcements.
	PendingMark int

	// DeclMode is set while the REPL checks a declaration outside a
	// declaration batch: a `const ( ... )` group typed at the prompt,
	// whose members are checked — and park — one by one at their iota
	// (checkGroupDeclTentative), a parked member of one, and an interface
	// or `impl` declaration.  The batch-path dependency-ordered const
	// resolution (DeclBatch) does not run then; collectDeclsBody
	// forward-registers the group's const placeholders instead.  Other
	// REPL declarations are checked as a batch (checkDeclsTentative).
	// Distinct from TentativeMode (errors and unbound names captured) and
	// AllowRedef (`.bni`/`.bn` redefinition tolerance).
	DeclMode bool
}
