package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// A REPL declaration that fails to check, or parks, is undone: otherwise the
// session scope keeps its name bound to a symbol IR-gen never emitted (a
// later prompt reading it gets a global that does not exist), or a method set
// keeps a method with no body.

// DeclRollback records what a REPL declaration is about to (re)bind, before
// it is checked: each name's current binding in the session scope, a method's
// current entry in its receiver base type's method set, a forward-declared
// type (`type T`) the declaration would fill in place, and how many
// declarations are parked (whatever the declaration parks is dropped with it).
type DeclRollback struct {
	PendingLen int
	Names      @[]@[]char
	Prev       @[]@Symbol // nil: the name was not bound in the session scope
	RecvType   @types.Type
	Method     @[]char
	Old        @types.Method
	Fwd        @types.Type // a forward-declared type d fills: its Underlying is still nil
}

// SnapshotDecl records what d is about to (re)bind (DeclRollback); call it
// before CheckDeclInScope, and RollbackDecl if d fails to check.
func (c @Checker) SnapshotDecl(d @ast.Decl) @DeclRollback {
	var r @DeclRollback = make(DeclRollback)
	r.PendingLen = len(c.Pending)
	if d == nil {
		return r
	}
	if d.Kind == ast.DECL_FUNC && d.Recv != nil {
		r.RecvType = methodBaseTypeForDecl(c, d)
		r.Method = d.Name
		if r.RecvType != nil {
			r.Old = r.RecvType.LookupMethod(d.Name)
		}
		return r
	}
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			noteRollbackName(c, r, d.Decls[i].Name)
		}
		return r
	}
	noteRollbackName(c, r, d.Name)
	if d.Kind == ast.DECL_TYPE && len(r.Prev) == 1 && r.Prev[0] != nil &&
			r.Prev[0].Kind == types.SYM_TYPE && r.Prev[0].Type != nil &&
			r.Prev[0].Type.Kind == types.TYP_NAMED && r.Prev[0].Type.Underlying == nil {
		r.Fwd = r.Prev[0].Type
	}
	return r
}

// noteRollbackName records name and its current session-scope binding.
func noteRollbackName(c @Checker, r @DeclRollback, name @[]char) {
	if len(name) == 0 || isBlank(name) {
		return
	}
	r.Names = slices.Append[@[]char](r.Names, name)
	r.Prev = slices.Append[@Symbol](r.Prev, declScope(c).LookupLocal(name))
}

// declScope is the scope a declaration binds its name in: c.Scope, or the
// scope it forwards definitions to (Scope.DelegateDefine).
func declScope(c @Checker) @Scope {
	var s @Scope = c.Scope
	for s.DelegateDefine && s.Parent != nil {
		s = s.Parent
	}
	return s
}

// RollbackDecl undoes what a declaration that failed to check bound: each
// name returns to its previous binding (or to unbound), a method to its
// previous entry (or is removed), and whatever it parked is dropped.
func (c @Checker) RollbackDecl(r @DeclRollback) {
	if r == nil {
		return
	}
	if len(c.Pending) > r.PendingLen {
		c.Pending = c.Pending[:r.PendingLen]
	}
	undoDecl(c, r)
}

// undoDecl returns each name snapshot r recorded to its previous binding (or
// to unbound), its method to its previous entry (or removes it), and a
// forward-declared type it filled to unfilled.  The parked list is left
// alone: a declaration that parks is undone, then parked.
func undoDecl(c @Checker, r @DeclRollback) {
	for i := 0; i < len(r.Names); i++ {
		restoreName(c, r, r.Names[i])
	}
	restoreMethod(r)
	if r.Fwd != nil {
		var noUnderlying @types.Type
		r.Fwd.Underlying = noUnderlying
	}
}

// prevFuncType returns the signature of the function or method a
// declaration replaced, from the snapshot r taken before it was checked, or
// nil when it replaced none.
func prevFuncType(r @DeclRollback) @types.Type {
	if r.RecvType != nil {
		if r.Old != nil {
			return r.Old.FuncType
		}
		return nil
	}
	if len(r.Prev) == 1 && r.Prev[0] != nil && r.Prev[0].Kind == types.SYM_FUNC {
		return r.Prev[0].Type
	}
	return nil
}

// restoreName returns name to its binding in snapshot r (or to unbound, when
// r did not bind it or has no record of it).
func restoreName(c @Checker, r @DeclRollback, name @[]char) {
	if len(name) == 0 || isBlank(name) {
		return
	}
	var ds @Scope = declScope(c)
	if r != nil {
		for i := 0; i < len(r.Names); i++ {
			if types.CharEq(r.Names[i], name) {
				if r.Prev[i] != nil {
					ds.Define(r.Prev[i])
				} else {
					ds.Undefine(name)
				}
				return
			}
		}
	}
	ds.Undefine(name)
}

// restoreMethod returns snapshot r's method to its earlier entry, or removes it
// when it had none.
func restoreMethod(r @DeclRollback) {
	if r == nil || r.RecvType == nil {
		return
	}
	if r.Old != nil {
		r.RecvType.SetOrAppendMethod(r.Old)
		return
	}
	var kept @[]@types.Method
	for i := 0; i < len(r.RecvType.Methods); i++ {
		if !types.CharEq(r.RecvType.Methods[i].Name, r.Method) {
			kept = slices.Append[@types.Method](kept, r.RecvType.Methods[i])
		}
	}
	r.RecvType.Methods = kept
}
