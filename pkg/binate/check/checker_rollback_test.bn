package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for checker_rollback.bn (and Scope.Undefine, which it uses).

// Undefine removes only the scope's own binding of the name — in a small
// (linear) scope and in one large enough to use the name index — and leaves
// every other binding findable.
func TestScopeUndefine() testing.TestResult {
	var sizes @[]int = make_slice(int, 2)
	sizes[0] = 3
	sizes[1] = scopeHashThreshold + 5
	for k := 0; k < len(sizes); k++ {
		var sc @Scope = NewScope(nil)
		for i := 0; i < sizes[k]; i++ {
			defineVar(sc, buf.Concat("v", strconv.Itoa(i)), types.TypInt())
		}
		sc.Undefine("v1")
		if sc.LookupLocal("v1") != nil {
			return fail("an undefined name must no longer be bound")
		}
		for i := 0; i < sizes[k]; i++ {
			if i != 1 && sc.LookupLocal(buf.Concat("v", strconv.Itoa(i))) == nil {
				return fail("undefining one name must keep every other binding")
			}
		}
		sc.Undefine("absent")
		if len(sc.Syms) != sizes[k] - 1 {
			return fail("undefining an unbound name must change nothing")
		}
	}
	return ""
}

// replSessionChecker returns a checker with a session scope (a child of the
// universe) binding a variable `a` and a named type `T`, as the REPL has.
func replSessionChecker() @Checker {
	var c @Checker = NewChecker()
	c.Scope = NewScope(c.Scope)
	defineVar(c.Scope, "a", types.TypInt())
	defineType(c.Scope, "T", types.MakeNamedType("T"))
	return c
}

// replDecl builds a variable declaration of name.
func replDecl(name *[]readonly char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = buf.CopyStr(name)
	return d
}

// RollbackDecl unbinds a name the declaration newly bound, and restores the
// earlier binding of one it redefined.
func TestRollbackDeclNames() testing.TestResult {
	var c @Checker = replSessionChecker()
	var fresh @DeclRollback = c.SnapshotDecl(replDecl("b"))
	defineVar(declScope(c), "b", types.TypBool())
	c.RollbackDecl(fresh)
	if declScope(c).LookupLocal("b") != nil {
		return fail("a newly bound name must be unbound by the rollback")
	}
	var orig @Symbol = declScope(c).LookupLocal("a")
	if orig == nil {
		return fail("a must be bound in the session scope")
	}
	var redef @DeclRollback = c.SnapshotDecl(replDecl("a"))
	defineVar(declScope(c), "a", types.TypBool())
	c.RollbackDecl(redef)
	if !same(declScope(c).LookupLocal("a"), orig) {
		return fail("a redefined name must get its earlier binding back")
	}
	return ""
}

// RollbackDecl removes a method the declaration newly registered.
func TestRollbackDeclNewMethod() testing.TestResult {
	var c @Checker = replSessionChecker()
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = buf.CopyStr("M")
	d.Recv = make(ast.ParamDecl)
	d.Recv.Type = make(ast.TypeExpr)
	d.Recv.Type.Kind = ast.TEXPR_NAMED
	d.Recv.Type.Name = buf.CopyStr("T")
	var r @DeclRollback = c.SnapshotDecl(d)
	var base @types.Type = methodBaseTypeForDecl(c, d)
	if base == nil {
		return fail("T must resolve as the method's base type")
	}
	var m @types.Method = make(types.Method)
	m.Name = buf.CopyStr("M")
	base.SetOrAppendMethod(m)
	c.RollbackDecl(r)
	if base.LookupMethod("M") != nil {
		return fail("a newly registered method must be removed by the rollback")
	}
	return ""
}
