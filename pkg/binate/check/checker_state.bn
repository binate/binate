package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/std/vec"

// Checker holds all type-checker state.  It is exposed to importers only as
// the opaque handle `type Checker` (in the .bni); these fields are internal
// and reached from outside the package through the accessor methods
// (Interpreted / SetInterpreted / Pending / PendingMark / Scope) and the
// checker driver methods (NewChecker, CheckPackage, CheckerErrors, ...).
type Checker struct {
	Errors @[]types.CheckError
	// ErrorsAbsorbed counts the errors reported but not added because one already
	// reported stands for them (reportCheckError): an instance's check failed if
	// it grew, as if Errors had.
	ErrorsAbsorbed int
	// DedupFrom is the first index of Errors a new error is compared with to
	// drop a duplicate (appendUniqueCheckError).  0 in a batch check; each
	// REPL check entry sets it to len(Errors), because every prompt's errors
	// sit at `<repl>:1:<col>` — a prompt repeating an earlier prompt's mistake
	// must still report it, or the REPL, seeing no new error, would run it.
	DedupFrom int
	Scope     @Scope
	FuncRet   @[]@types.Type
	Packages  @[]@PkgEntry
	Iota      int
	// InLoop is true inside a for-statement body with NO intervening function
	// literal or deferred block: a `break` / `continue` there has a target
	// (§14.12).  It is reset on entry to a function-literal body (checkFuncLit) —
	// the literal's body is a function of its own — and to a deferred block
	// (checkDeferStmt), which a `break` / `continue` may not leave; nested if /
	// switch / blocks do not touch it.
	InLoop bool
	// InSwitch is true inside a switch or type-switch body with no intervening
	// function literal: a `break` there has a target, a `continue` does not.
	InSwitch bool
	// InDefer is true inside a deferred block (§14.13) with no intervening
	// function literal: a `return` there is rejected, as is a `break` /
	// `continue` with no loop or switch inside the deferred block
	// (stmt.defer.block).  It is reset on entry to a function body, a function
	// literal and a package-level declaration checked on demand.
	InDefer bool
	// DeferOuterLoop / DeferOuterSwitch record, while InDefer, whether a loop /
	// switch encloses the deferred block — the target a `break` / `continue` in it
	// would leave for — so the error says the deferred block is what it may not
	// leave rather than that there is no loop.
	DeferOuterLoop   bool
	DeferOuterSwitch bool
	// Interpreted: true when this Checker checks code for the bytecode VM /
	// REPL (an interpreted context), where `__c_call` (native-only FFI) can
	// never run — so checkCCall rejects it as a type error, at the frontend,
	// rather than failing later at lowering.  Off for cmd/bnc, where `__c_call`
	// compiles to a real C call.  Injected packages load interface-only, so
	// their `.bn` `__c_call` never reaches the checker; this therefore flags
	// only interpreted code's own `__c_call`.
	Interpreted bool
	// CCallSyms / CGlobalSyms record the verbatim C symbols named by __c_call
	// and __c_global respectively, across the whole compile.  A C symbol is
	// either a function OR a data object, never both, so a symbol appearing in
	// both is a contradiction: the emitted LLVM module would carry a
	// `declare <ret> @sym(...)` AND a `@sym = external global <T>`, which is
	// ill-formed (a redefinition the verifier/linker rejects).  checkCCall /
	// checkCGlobal cross-check these to reject the clash with a clean
	// diagnostic.  Compiled-mode only (left empty under Interpreted, where both
	// builtins are already rejected outright).
	CCallSyms   @[]@[]char
	CGlobalSyms @[]@[]char
	// InGroupBareMember: true only while checking a BARE-repeat group member
	// (`const ( B0 int = 1 << iota; B1; B2 )`), which re-uses the preceding
	// member's initializer AST node at a new iota.  The signedness-aware
	// const-value fold + ExprType stamp (which IR-gen's genConstGroup reads for
	// explicit members) are suppressed for these: the shared node carries one
	// ExprType id, so stamping it per-member would overwrite an earlier member's
	// value.  An EXPLICIT grouped member has its own node and IS stamped.
	InGroupBareMember bool
	// BareExplicitIota is, while InGroupBareMember, the iota of the explicit
	// member whose initializer the bare member repeats.
	BareExplicitIota int

	// AllowSelf: when true, `Self` is a valid type expression.
	// Set transiently while resolving an interface method's
	// signature (argument and result types only).  Off everywhere
	// else — including inside interface alias targets, interface
	// extension parent lists, and ordinary func / var / type /
	// struct declarations.  A TEXPR_SELF reference reached with
	// AllowSelf=false produces a type error.
	AllowSelf bool
	// SelfBound: the interface whose method signatures are being resolved,
	// which bounds a `Self` type argument there (spec iface.self.constraint).
	// nil in a generic interface's abstract resolution, which has no interface
	// type, and outside interface signatures (where `Self` is already an
	// error).  An instance resolved with its type arguments bound may carry
	// one, but queues nothing (deferSelfConstraintCheck).
	SelfBound @types.Type
	// PendingSelfChecks: the constraint checks of the instantiations whose type
	// arguments mention `Self`, each with its SelfBound, run once that
	// interface's parents are resolved (check_self_constraint.bn).
	PendingSelfChecks @vec.Vec[@PendingConstraintCheck]

	// AllowUniverseRecv: when true, methods may be declared on
	// universe primitives (`int`, `bool`, `char`, etc.).  Set by
	// Check / CheckPackage when the source file's package is the
	// carve-out package (currently `pkg/builtins/lang`).  Off everywhere
	// else — user packages can't extend `int`.
	AllowUniverseRecv bool

	// BuildingIfaceScope: true only while buildScopeFromFile resolves a
	// package's `.bni` into its exported-symbol surface (LoadPackageInterface).
	// That pass builds type IDENTITY for the surface — it resolves each `.bni`
	// signature's generic instantiations — before the `.bni`'s extension clauses
	// are resolved (its pass 3).  So a `.bni` that names a generic instantiated
	// on a type satisfying the constraint through an impl of a child interface
	// (e.g. `func Make() @Box[Item]` with `impl Item : Sub` and `interface Sub :
	// Sizer`) would constraint-check `Box[Item]` before `Sub` has its parent and
	// be wrongly rejected.  While this flag is set, instantiation resolution is
	// treated as non-user-facing: the type is built and cached but its
	// constraints are NOT checked and NOT latched, so the authoritative check
	// happens later in CheckPackage (where c.Impls is populated) at the first
	// real user-facing resolution of the same (decl, args).  Mirrors the
	// speculative-instantiation deferral instantiateGenericDeclWithArgs already
	// uses for internal re-instantiation.
	BuildingIfaceScope bool
	// BniDecls holds the declarations of the `.bni` whose scope is being
	// built (buildScopeFromFile), nil otherwise: a constant's initializer, or a
	// variable's array length, may name a `.bni` variable not defined yet, which
	// is then defined on demand (defineBniVarByName).
	BniDecls @[]@ast.Decl
	// BniTypesResolved lists the `.bni`'s type declarations resolved before
	// their turn, because a constant's initializer named them (sizeof, alignof,
	// a composite literal's type): the build does not resolve them again.
	BniTypesResolved @[]@ast.Decl
	// BniBuild is the state of the `.bni` declarations being resolved, nil
	// otherwise (bni_scope_demand.bn).
	BniBuild @BniBuild
	// PkgBni is the `.bni` of the package being checked (checkPackageImpl), nil
	// otherwise or when it has none: a method its `.bn` alone declares is private
	// to the package (method_private.bn).
	PkgBni @ast.File

	// CollectingDecls: true while collectDecls resolves a package's (or a single
	// file's) declarations into scope — the batch CheckPackage / single-file Check
	// path, NOT the REPL.  A generic instantiation is constraint-checked the moment
	// a signature that names it is resolved, but the package's interfaces get
	// their parents only once collection is done (resolvePendingIfaceParents) — so
	// an instantiation whose type argument satisfies the constraint through an
	// impl of a child interface (a `func F() @Box[Item]` with `impl Item : Sub`
	// and `interface Sub : Sizer`) would be wrongly rejected.  Top-level decls are
	// order-independent, so while this flag is set instantiation resolution is
	// non-user-facing (built and cached for identity, check skipped and NOT
	// latched); recheckDeferredConstraints re-fires the checks once the interfaces
	// have their parents.  Same deferral mechanism as BuildingIfaceScope.
	CollectingDecls bool

	// PendingChecks: the generic-instantiation constraint checks deferred during
	// the current batch collection (recorded while CollectingDecls is set), replayed
	// by recheckDeferredConstraints once collectDeclsBody has recorded every impl,
	// and those deferred while a type-parameter list's constraints are resolved,
	// replayed at its end (replayPendingChecks).  See PendingConstraintCheck.
	PendingChecks @[]@PendingConstraintCheck
	// PendingFuncChecks: the constraint checks of generic-function
	// instantiations deferred the same ways, replayed with them.  See
	// PendingFuncConstraintCheck.
	PendingFuncChecks @[]@PendingFuncConstraintCheck

	// PackageScope: the file/package-level scope, captured at the
	// start of pass-2 body checking — the package-level lookup root
	// (capture analysis, for one, looks globals up in it).
	PackageScope @Scope

	// FileScopeNames / FileScopes: the per-file import scopes for the
	// package currently being checked (multi-file CheckPackage path only),
	// keyed by source-file path (a decl's Pos.File).  Built by
	// buildFileScopes; consulted per decl in collectDeclsBody / checkDecls /
	// resolveConstByName so a qualifier in file F resolves against only F's
	// imports.  Empty in single-file / REPL mode (imports go straight into
	// the one package scope as before).
	FileScopeNames @[]@[]char
	FileScopes     @[]@Scope

	// CaptureStack: active function-literal capture frames.  Pushed
	// on entry to a literal body in checkFuncLit, popped on exit;
	// each successful Ident lookup walks the stack from innermost
	// to outermost and records a capture on every frame the
	// resolution crosses.  Empty stack means we're
	// not inside any literal body — captures are a no-op.
	CaptureStack @[]@CaptureFrame

	// Type registry: maps ResolvedTypeID → Type.
	// Populated during type checking; queried by downstream tools (linter, etc.).
	ExprTypes    @[]@types.Type
	NumExprTypes int
	// The types the type expressions denote (check_type_stamps.bn).
	Stamps @stampTables
	// The types found to embed no opaque type by value (check_opaque_free.bn).
	OpaqueFree @opaqueFreeTypes
	// The pointer walk's answers kept while a batch's declarations are checked
	// (check_opaque_pointee.bn); nil otherwise.
	PointeeMemo @pointeeMemo
	// The types found to have a layout that depends on no type parameter
	// (check_type_walk.bn).
	ConcreteLayouts @concreteLayouts
	// The constant value recorded for each checked expression (recordConst)
	// and its constval status, indexed like ExprTypes.
	ConstVals  @[]constval.Value
	ConstStats @[]int
	// The value recorded for each checked constant declaration, indexed by
	// its ConstID - 1 (recordDeclConst).
	DeclConsts @vec.Vec[declConst]

	// Impls: collected `impl T : Iface, ...` declarations. Collection
	// only resolves the receiver type and interface names; satisfaction
	// is checked separately (check_impl.bn).
	Impls @[]@Impl

	// Instances: the homes of the generic functions and their instantiations
	// with concrete type arguments (check_instances.bn).  Created on first use.
	Instances @InstanceState
	// The generic declarations and their instantiations (checker_generics.bn).
	Generics genericState
	// The REPL's declaration-at-a-time checking state (checker_repl.bn).
	Repl replState

	// UntypedNonConst holds every expression checked since the last
	// finalizeUntypedNonConst whose type is an untyped NON-constant integer
	// (types.Type.NonConst; spec §13.5 expr.shift.untyped-value).  A context
	// that requires a type records it on the expression as it is checked
	// (fixUntypedNonConst); finalizeUntypedNonConst gives each one still
	// untyped when its declaration is done the default `int`.  Created lazily.
	UntypedNonConst @vec.Vec[@ast.Expr]

	// ExpectedFVType is a transient hint set by callers of
	// checkExpr that already know the destination type's
	// function-value form — VarDecl with `var f @func()`, return
	// statements whose function returns @func, etc.  When set to
	// a TYP_MANAGED_FUNC_VALUE / TYP_FUNC_VALUE, checkFuncLit
	// consults it to resolve a literal whose signature matches
	// as the requested form rather than the default *func.  IR-
	// gen reads the literal's resolved type to choose stack-
	// alloc (raw *func) vs heap-alloc (managed @func).  Nil
	// outside the narrow set-and-clear windows.
	ExpectedFVType @types.Type

	// LitBorrows holds the source expressions the implicit value-borrow took a
	// composite literal's storage for (noteBorrowedLiteral), which an assignment
	// or `return` may not store (checkStoredLiteralAddr).
	LitBorrows @[]@ast.Expr
	// LitViews holds the source expressions converted from a managed slice to a
	// raw-slice view of a backing a composite literal owns (noteLiteralView): the
	// literal is addressed, and the view may not be stored.
	LitViews @[]@ast.Expr

	// BorrowPosKind is a transient marker (like ExpectedFVType) for the
	// implicit interface value-borrow (iface.construct.value-borrow): it is set
	// to POS_BORROWING for the extent of checking a source at a BORROWING
	// construction position (a call argument or a var/`:=` initializer), and left
	// at the default POS_STORING everywhere else (assignment, field/element
	// store, return).  canBorrowValueIntoRawIface reads it to admit a
	// NON-addressable value source (a materialised stack temporary) only where
	// the borrow cannot outlive it; a composite literal's elements inherit the
	// enclosing literal's kind because the field persists across the recursive
	// checkExpr (set/restore keeps it leaf-granular — a nested call argument
	// re-sets it).
	BorrowPosKind int

	// Batch is the package-level declaration batch being checked
	// (check_decl_batch.bn): its constants, types and variables resolved on
	// demand.  Nil outside a batch check (the REPL's single declarations).
	Batch @DeclBatch

	// ConstResolving / ConstResolved drive dependency-ordered
	// resolution of top-level consts (beginTopLevelConsts,
	// finishTopLevelConsts, batchConstOnDemand).
	// ConstResolving is the active depth-first stack, used to detect a
	// `const A = B; const B = A` cycle; ConstResolved memoizes names
	// whose real type+value have been recorded so re-entry is a no-op.
	// Both are reset per sweep and used only on the batch path.
	ConstResolving @[]@[]char
	ConstResolved  @[]@[]char
	// ConstMembersResolved lists the top-level const-group members resolved
	// before pass 2, so pass 2 does not check them again.
	ConstMembersResolved @[]@ast.Decl

	// VarVisiting / VarOrdered drive the dependency-order topological
	// sort of a package's top-level `var x T = expr` initializers
	// (resolveTopLevelVarOrder, check_var_resolve.bn).  VarVisiting is the
	// active depth-first path stack — a back-edge into it is a
	// `var a = b; var b = a` initialization cycle; VarOrdered is the
	// accumulating post-order result, which also serves as the visited
	// ("done") set.  Both are transient: reset at the start of each
	// package's sweep and used only on the batch path.
	VarVisiting @[]@[]char
	VarOrdered  @[]@[]char

	// VarInitOrderPaths / VarInitOrders record, per package, the
	// dependency order of that package's top-level init-vars, so IR-gen's
	// buildInitBody emits the `<name> = <value>` assignments in an order
	// where each initializer's package-var dependencies run first —
	// instead of filename-then-source order, under which a cross-file or
	// forward reference silently reads a zero value.  ONE Checker instance
	// checks every package before any IR-gen runs, so a scalar order field
	// would be clobbered across packages; these parallel arrays are keyed
	// by package path.  VarInitOrder(path) reads them back.
	VarInitOrderPaths @[]@[]char
	VarInitOrders     @[]@[]@[]char

	// PendingIfaceDecls / PendingIfaceTypes pair each non-generic, non-alias
	// interface decl of the declaration batch being collected with the
	// interface Type preRegisterInterfaces defined for it.  collectInterfaceDecl
	// fills the Type's methods in declaration order; resolvePendingIfaceParents
	// resolves every one's extension clause after the whole batch is collected,
	// so a parent may be declared after its child (decl.order.forward) and the
	// method-conflict check sees every parent's methods.
	PendingIfaceDecls @[]@ast.Decl
	PendingIfaceTypes @[]@types.Type

	// PendingAliases is the current declaration batch's pending-alias
	// registry (check_pending_alias.bn): aliases resolved on demand when
	// named before their declaration; nil outside a batch.
	PendingAliases @PendingAliases

	// DeferredIfaceConflictDecls / DeferredIfaceConflictTypes queue the
	// method-conflict checks of interfaces whose extension clause was resolved
	// while a declaration batch (CollectingDecls) or a `.bni` scope
	// (BuildingIfaceScope) is being collected — pending interfaces and generic
	// instantiations populated along the way.  The check walks the whole
	// ancestor closure, so it runs only once every parent edge of the batch
	// exists (runDeferredIfaceConflicts).
	DeferredIfaceConflictDecls @[]@ast.Decl
	DeferredIfaceConflictTypes @[]@types.Type

	// curPkgPath: the full path of the package currently being checked /
	// whose .bni is being loaded.  It stamps Pkg onto each TYP_INTERFACE
	// (interface identity is (Pkg, Name), so two packages' same-named
	// interfaces — even of packages whose paths end in the same segment —
	// stay distinct, and agree with IR-gen's full-path interface keys) and
	// path-qualifies a named type's Type.Name for mangling (must equal
	// IR-gen's per-module package path for the same module).  Per-checker:
	// the Check* entry points save the prior value, set it for the pass,
	// and restore on exit, so nested checks (REPL-inside-compile) and
	// concurrent checkers don't collide.
	curPkgPath @[]char
}
