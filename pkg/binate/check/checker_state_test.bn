package "pkg/binate/check"

import "pkg/builtins/testing"

// Tests for a new Checker's state (its accessor methods are tested in
// checker_accessors_test.bn).

// A freshly-constructed Checker is in the compiled (non-interpreted) mode with
// an empty pending list and the universe scope installed.
func TestCheckerStateInitial() testing.TestResult {
	var c @Checker = NewChecker()
	if c.Interpreted { return fail("new checker should not be Interpreted") }
	if c.PendingMark != 0 { return fail("new checker PendingMark should be 0") }
	if len(c.Pending) != 0 { return fail("new checker Pending should be empty") }
	if c.Scope == nil { return fail("new checker should have the universe scope") }
	return ""
}

// The Interpreted flag round-trips (SetInterpreted's effect, observed via the
// field the accessor returns).
func TestCheckerInterpretedFlag() testing.TestResult {
	var c @Checker = NewChecker()
	c.Interpreted = true
	if !c.Interpreted { return fail("Interpreted should be true after set") }
	c.Interpreted = false
	if c.Interpreted { return fail("Interpreted should be false after clear") }
	return ""
}
