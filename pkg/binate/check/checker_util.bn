package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/token"

// ============================================================
// Helpers
// ============================================================

// isUntypedScalar reports whether t is nil or an untyped scalar (untyped int /
// float / bool) — i.e. NOT a concrete type that an untyped literal must fit.
// Used to gate checkUntypedLitFits so its fit-check fires only against a
// concrete peer.
func isUntypedScalar(t @types.Type) bool {
	if t == nil {
		return true
	}
	return t.Kind == types.TYP_UNTYPED_INT || t.Kind == types.TYP_UNTYPED_FLOAT ||
			t.Kind == types.TYP_UNTYPED_BOOL
}

// checkUntypedLitFits enforces that an untyped-int operand's value is
// representable in its concrete typed peer (§6.1 `const.untyped`: the fit IS
// enforced) for a SYMMETRIC integer binop — arithmetic (+ - * / %) and bitwise
// (& | ^) — whose operands must share a type (§13.3).  Without it, `uint8 / -1`,
// `int8 + 200`, or `uint8 / 300` silently widened to `int` in commonType (which
// returns the peer without a fit-check).  The comparison operators already get
// this via AssignableTo; this brings arithmetic/bitwise into line.
//
// NOT for shifts: a shift count is independent of the value's type (§13.5), so a
// huge literal count (`x << 1000`, a defined overshift) must NOT be fit-checked
// against the value — hence this is called only from the arithmetic/bitwise arms
// of checkBinaryOp, never the shift arm.  Only fires against a concrete peer with
// a known literal value; a both-untyped pair keeps its constant-folding path.
// The peer must be a CONCRETE INTEGER: an untyped-int against a float peer is
// the int/float mix that checkArithOp reports with its clearer "cannot mix int
// and float" message (AssignableTo would also fail here, so gating on the peer
// being integer keeps that domain-specific diagnostic instead of a generic
// mismatch); a bare type-parameter or other non-integer peer is likewise left
// to the existing "requires numeric/integer operands" error rather than a
// redundant second one.
func checkUntypedLitFits(c @Checker, pos token.Pos, a @types.Type, b @types.Type) {
	if a != nil && a.Kind == types.TYP_UNTYPED_INT && a.HasLitVal && !isUntypedScalar(b) &&
			b.IsInteger() && !AssignableTo(a, c, b) {
		errTypeMismatch(c, pos, a, b)
		return
	}
	if b != nil && b.Kind == types.TYP_UNTYPED_INT && b.HasLitVal && !isUntypedScalar(a) &&
			a.IsInteger() && !AssignableTo(b, c, a) {
		errTypeMismatch(c, pos, a, b)
	}
}

// commonType returns the common type of a and b, reporting a mismatch
// error if they differ. An untyped constant takes on the concrete
// peer's type; two untyped operands of the same class yield an untyped
// result.
func commonType(c @Checker, pos token.Pos, a @types.Type, b @types.Type) @types.Type {
	if a != nil && a.Kind == types.TYP_UNTYPED_INT {
		return b
	}
	if b != nil && b.Kind == types.TYP_UNTYPED_INT {
		return a
	}
	if a != nil && a.Kind == types.TYP_UNTYPED_FLOAT {
		return b
	}
	if b != nil && b.Kind == types.TYP_UNTYPED_FLOAT {
		return a
	}
	// Two operands of an arithmetic / bitwise op must be the SAME type.
	// `Identical` compares only width + signedness, so `int` and `int64` (or
	// `int` / `int32` on a 32-bit target) look identical though they are
	// distinct types — distinctNamedInts catches that, so `anInt + anInt64` is a
	// mismatch like `anInt32 + anInt64` already is (the user must cast).
	if !a.Identical(b) || distinctNamedInts(a, b) {
		errTypeMismatch(c, pos, a, b)
	}
	return a
}

// defaultType returns the default concrete type for an untyped type
// (int for untyped int, float64 for untyped float, etc.).
func defaultType(t @types.Type) @types.Type {
	if t == nil {
		return types.TypVoid()
	}
	if t.Kind == types.TYP_UNTYPED_INT {
		return types.TypInt()
	}
	if t.Kind == types.TYP_UNTYPED_FLOAT {
		return types.TypFloat64()
	}
	if t.Kind == types.TYP_UNTYPED_BOOL {
		return types.TypBool()
	}
	if t.Kind == types.TYP_UNTYPED_STRING {
		return defaultStringLitType()
	}
	// A bare top-level function reference has type TYP_FUNC, which is not a
	// storable value; in an inference context (`var f = add`) it decays to a
	// managed func value @func — the same managed-by-default choice as a func
	// literal (checkFuncLit) and @[]T.  An @func referencing a captureless
	// top-level function carries a nil data word, so this is ~free; it borrows
	// to *func at a destination that wants raw.
	if t.Kind == types.TYP_FUNC {
		return types.MakeManagedFuncValueType(t.Params, t.Results)
	}
	return t
}

// checkDefaultIntFits reports "cannot assign untyped int to <T>" when an
// untyped-int literal `src` takes its default type `defaulted` (via
// defaultType) in an inference context (`x := e`, `var x = e`) but its value
// does not fit that default.  This is the const.default.int-width (§6.2)
// constraint the explicit `var x T = e` path already enforces through
// AssignableTo: a literal outside the default int's range (e.g.
// 0xFFFFFFFFFFFFFFFF = 2^64-1 -- a valid untyped int but not in int64)
// "cannot use the default and shall be given an explicit type."  Without it
// the literal silently WRAPS to the default int (2^64-1 -> -1) with no
// diagnostic.  No-op for non-literal / non-untyped-int sources (concrete RHS
// types are already typed, so nothing to default-fit).
func checkDefaultIntFits(c @Checker, pos token.Pos, src @types.Type, defaulted @types.Type) {
	if src == nil || src.Kind != types.TYP_UNTYPED_INT || !src.HasLitVal {
		return
	}
	if !untypedIntLitFitsTarget(src, defaulted) {
		errCannotAssign(c, pos, src, defaulted)
	}
}

// compoundToBase converts a compound assignment operator (+=, -=, etc.) to its base operator.
func compoundToBase(op int) int {
	if op == cast(int, token.ADD_ASSIGN) { return cast(int, token.PLUS) }
	if op == cast(int, token.SUB_ASSIGN) { return cast(int, token.MINUS) }
	if op == cast(int, token.MUL_ASSIGN) { return cast(int, token.STAR) }
	if op == cast(int, token.QUO_ASSIGN) { return cast(int, token.SLASH) }
	if op == cast(int, token.REM_ASSIGN) { return cast(int, token.PERCENT) }
	if op == cast(int, token.AND_ASSIGN) { return cast(int, token.AMP) }
	if op == cast(int, token.OR_ASSIGN) { return cast(int, token.PIPE) }
	if op == cast(int, token.XOR_ASSIGN) { return cast(int, token.CARET) }
	if op == cast(int, token.SHL_ASSIGN) { return cast(int, token.SHL) }
	if op == cast(int, token.SHR_ASSIGN) { return cast(int, token.SHR) }
	return op
}

// litIntValue extracts the integer value carried by an untyped-int
// literal type (HasLitVal), reconstructing the sign from LitMag/LitSign.
// ok=false when t carries no literal value.
func litIntValue(t @types.Type) (int64, bool) {
	if t == nil || !t.HasLitVal {
		return 0, false
	}
	// int64 (not host int): LitMag is a uint64 magnitude that may exceed a
	// 32-bit host int, so narrowing to `int` would lose a large const's value
	// on an ILP32 host.
	var v int64 = cast(int64, t.LitMag)
	if t.LitSign {
		v = -v
	}
	return v, true
}

// stripQuotes removes surrounding double quotes from a string literal.
func stripQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// lastPathSegment returns the portion of the path after the last '/'
// (used for default import names).
func lastPathSegment(path *[]readonly char) *[]readonly char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:]
}
