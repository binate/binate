package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

func TestCompoundToBase() testing.TestResult {
	if compoundToBase(cast(int, token.ADD_ASSIGN)) != cast(int, token.PLUS) {
		return fail("+= should map to +")
	}
	if compoundToBase(cast(int, token.SUB_ASSIGN)) != cast(int, token.MINUS) {
		return fail("-= should map to -")
	}
	if compoundToBase(cast(int, token.MUL_ASSIGN)) != cast(int, token.STAR) {
		return fail("*= should map to *")
	}
	return ""
}

func TestDefaultType() testing.TestResult {
	var ut @types.Type = types.TypUntypedInt()
	var dt @types.Type = defaultType(ut)
	if dt.Kind != types.TYP_INT { return fail("untyped int should default to int") }

	var ub @types.Type = types.TypUntypedBool()
	var db @types.Type = defaultType(ub)
	if db.Kind != types.TYP_BOOL { return fail("untyped bool should default to bool") }

	var plain @types.Type = types.TypInt()
	if defaultType(plain).Kind != types.TYP_INT { return fail("typed int should stay int") }
	return ""
}

func TestStripQuotes() testing.TestResult {
	var s *[]readonly char = stripQuotes("\"hello\"")
	if len(s) != 5 { return fail("expected len 5") }
	return ""
}

// An arithmetic operand of type int does not mix with one of `readonly int64`
// or an alias of int64 (the user must cast), while int64 mixes with both.
func TestArithIntWithWrappedInt64Rejected() testing.TestResult {
	var roSrc *[]readonly char = "package \"test\"\n"
			"func f() int64 { var a int = 1; var b readonly int64 = 2; return a + b }\n"
	var alSrc *[]readonly char = "package \"test\"\ntype W = int64\n"
			"func f() int64 { var a int = 1; var b W = 2; return b * a }\n"
	var okSrc *[]readonly char = "package \"test\"\ntype W = int64\n"
			"func f() int64 { var a int64 = 1; var b readonly int64 = 2; var c W = 3; return a + b + c }\n"
	var r testing.TestResult = expectError(checkSrc(roSrc))
	if len(r) != 0 { return r }
	r = expectError(checkSrc(alSrc))
	if len(r) != 0 { return r }
	return expectNoErrors(checkSrc(okSrc))
}

// nil has no default type: a name whose type is inferred from it (`:=`, a
// parallel `:=`, `var x = nil`) or a boxed nil is rejected, once — a later use
// of the name adds no second diagnostic — while a declared destination type
// still takes nil.
func TestNilInferenceRejected() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 4)
	srcs[0] = buf.CopyStr("package \"test\"\nfunc f() { g := nil; _ = present(g) }\n")
	srcs[1] = buf.CopyStr("package \"test\"\nfunc f() { a, g := 1, nil; _ = a; _ = present(g) }\n")
	srcs[2] = buf.CopyStr("package \"test\"\nfunc f() { var g = nil; _ = present(g) }\n")
	srcs[3] = buf.CopyStr("package \"test\"\nfunc f() { var b = box(nil); _ = b }\n")
	for i := 0; i < len(srcs); i++ {
		var errs @[]types.CheckError = checkSrc(srcs[i]).CheckerErrors()
		if len(errs) != 1 {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("nil inference source ")
			cb.Write(strconv.Itoa(i))
			cb.Write(" should be exactly one error, got ")
			cb.Write(strconv.Itoa(len(errs)))
			if len(errs) > 0 {
				cb.Write(": ")
				cb.Write(errs[0].Msg)
				if len(errs) > 1 {
					cb.Write(" / ")
					cb.Write(errs[1].Msg)
				}
			}
			return fail(buf.CopyStr(cb.String()))
		}
	}
	var declared *[]readonly char = "package \"test\"\n"
			"func f() { var p *int = nil; var g *func() int = nil; _ = p; _ = present(g) }\n"
	return expectNoErrors(checkSrc(declared))
}
