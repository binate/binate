package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/token"
import "pkg/binate/types"

// Array dimensions.  Types resolve in pass 1, before expressions are checked,
// so a dimension is evaluated whole with constval (evalConst) rather than read
// from recordConst.

// evalArrayLen evaluates the array dimension e.  known is false when the
// length is not known yet (a constant declared later: the type is resolved
// again once it is), depends on a type parameter (dependent: each
// instantiation evaluates it), or is invalid (reported here, once — errors
// dedupe across re-resolution).  One left without a value by a variable's
// placeholder is a variable type cycle (placeholderPoisoned).  Meanwhile the
// batch counts it as an array length being evaluated (LenDepth).
func evalArrayLen(c @Checker, e @ast.Expr) (int64, bool, bool) {
	var b @DeclBatch = c.Batch
	if b != nil {
		b.LenDepth++
	}
	var n int64
	var known bool
	var dependent bool
	n, known, dependent = evalArrayLenIn(c, e)
	if b != nil {
		b.LenDepth--
	}
	return n, known, dependent
}

// evalArrayLenIn is evalArrayLen's evaluation.
func evalArrayLenIn(c @Checker, e @ast.Expr) (int64, bool, bool) {
	if e == nil {
		return 0, false, false
	}
	var watch placeholderMark = markPlaceholders(c)
	validateDimExpr(c, e)
	var v constval.Value
	var st int
	var at @ast.Expr
	v, st, at = evalDimConst(c, e)
	if st == constval.OK {
		if v.IsBool {
			addCheckError(c, e.Pos, "array length must be a constant integer")
			return 0, false, false
		}
		if v.N.IsNegative() {
			// A negative length has no valid layout.
			addCheckError(c, e.Pos, "array length must be non-negative")
			return 0, false, false
		}
		if !v.N.FitsSigned(targetIntBits()) {
			addCheckError(c, e.Pos, "array length is too large")
			return 0, false, false
		}
		return v.N.ToInt64(), true, false
	}
	if st == constval.DEPENDENT {
		// Each instance's check evaluates it with the type arguments bound
		// (gen.mono.check); its `len` operands are checked here, so one that
		// is not an array is reported in the generic body itself.
		if !checkDimLenOperands(c, e) {
			addCheckError(c, e.Pos, "array length must be a constant integer")
			return 0, false, false
		}
		if placeholderPoisoned(c, watch) {
			return 0, false, false
		}
		return 0, false, true
	}
	if st == constval.POISONED {
		notePoisonedLen(c, watch)
	}
	if st == constval.NOT_KNOWN || st == constval.POISONED {
		return 0, false, false
	}
	if isConstErr(st) {
		reportConstErr(c, at.Pos, st)
		return 0, false, false
	}
	addCheckError(c, e.Pos, "array length must be a constant integer")
	return 0, false, false
}

// checkDimLenOperands checks every `len(x)` operand in array dimension e, and
// reports whether each is an array or a string literal (an array whose length
// depends on a type parameter included: its instances have one), or one whose
// error is reported.  It reports an unbound name among e's other operands.
func checkDimLenOperands(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return true
	}
	if e.Kind == ast.EXPR_BUILTIN && e.Op == cast(int, token.LEN) && len(e.Args) == 1 {
		var t @types.Type = checkDimOperand(c, e.Args[0])
		if isUntypedString(t) || isErrType(t) {
			return true
		}
		var p @types.Type = types.StripWrappers(t)
		return p != nil && p.Kind == types.TYP_ARRAY
	}
	if e.Kind == ast.EXPR_IDENT || e.Kind == ast.EXPR_SELECTOR {
		// Evaluation stops at the operand the length depends on, so one after
		// it is not resolved: its unbound name is reported here
		// (reportUnbound); anything else about it is each instance's to report.
		_, _, _ = evalDimConst(c, e)
		return true
	}
	if e.Kind == ast.EXPR_UNARY {
		return checkDimLenOperands(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return checkDimLenOperands(c, e.X) && checkDimLenOperands(c, e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		for i := 0; i < len(e.Args); i++ {
			if !checkDimLenOperands(c, e.Args[i]) {
				return false
			}
		}
	}
	return true
}

// dimNameUndefined reports whether name, which an array dimension names and
// the scope does not bind, is undefined there.  Not `__Package`, which
// checkIdent resolves; nor a function of the batch named in its own signature,
// which batchFuncOnDemand declines while it is being defined: the signature is
// resolved again once it is, and its length is not constant then either.
// While a `.bni` scope is built, which defines the `.bni`'s declarations in
// order, nor is a name the `.bni` declares, which may not be defined yet.
func dimNameUndefined(c @Checker, name *[]readonly char) bool {
	if types.CharEq(name, "__Package") {
		return false
	}
	if c.Batch != nil && anyDeclNamed(c.Batch.FuncsDefining, name) {
		return false
	}
	return !c.BuildingIfaceScope || !bniDeclaresName(c.BniDecls, name)
}

// anyDeclNamed reports whether one of ds declares name.
func anyDeclNamed(ds *[]@ast.Decl, name *[]readonly char) bool {
	for i := 0; i < len(ds); i++ {
		if types.CharEq(ds[i].Name, name) {
			return true
		}
	}
	return false
}

// bniDeclaresName reports whether the `.bni` declarations decls declare name
// in the package's scope: a constant, variable, function, type or interface,
// in a group or not (a method's name is its receiver's).
func bniDeclaresName(decls *[]@ast.Decl, name *[]readonly char) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			if bniDeclaresName(d.Decls, name) {
				return true
			}
		} else if d.Kind != ast.DECL_IMPL && d.Kind != ast.DECL_EXPOSE && d.Recv == nil &&
				types.CharEq(d.Name, name) {
			return true
		}
	}
	return false
}

// targetIntBits is the width of the target's int, which an array length fits (spec
// type.array.form: `len` of an array is an int).
func targetIntBits() int {
	return types.GetTarget().IntSize * 8
}

// targetIntMax is the maximum of the target's int.
func targetIntMax() int64 {
	var bits int = targetIntBits()
	if bits >= 64 { return 9223372036854775807 }
	return (cast(int64, 1) << (bits - 1)) - 1
}

// validateDimExpr reports what checkExpr would in array-dimension expression
// `e`, which is evaluated with constval (evalConst) and never checked: a
// malformed escape in a char literal (`['\q']int`, checkExpr's EXPR_CHAR_LIT
// arm) and sizeof / alignof of an opaque type (checkBuiltinCall's arm), with
// the same messages.  Errors dedupe, so re-resolving the same array type
// across passes reports each once.
func validateDimExpr(c @Checker, e @ast.Expr) {
	if e == nil {
		return
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		checkCharLitEscapes(c, e.Name, e.Pos)
		return
	}
	if e.Kind == ast.EXPR_UNARY {
		validateDimExpr(c, e.X)
		return
	}
	if e.Kind == ast.EXPR_BINARY {
		validateDimExpr(c, e.X)
		validateDimExpr(c, e.Y)
		return
	}
	if e.Kind == ast.EXPR_BUILTIN &&
			(e.Op == cast(int, token.SIZEOF) || e.Op == cast(int, token.ALIGNOF)) && e.TypeRef != nil {
		var t @types.Type = resolveTypeExpr(c, e.TypeRef)
		if prepareLayout(c, t, e.TypeRef.Pos) && !layoutNotBuilt(c, t, e.TypeRef.Pos) &&
				embedsOpaqueByValue(c, t) {
			addCheckError(c, e.Pos,
					"cannot take sizeof/alignof of an opaque type (its layout is not available here)")
		}
		return
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			validateDimExpr(c, e.Args[i])
		}
	}
}
