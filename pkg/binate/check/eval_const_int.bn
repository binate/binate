package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/token"
import "pkg/binate/types"

// Array dimensions.  Types resolve in pass 1, before expressions are checked,
// so a dimension is evaluated whole with constval (evalConst) rather than read
// from recordConst.

// evalArrayLen evaluates the array dimension e.  known is false when the
// length is not known yet (a constant declared later: the type is resolved
// again once it is), depends on a type parameter (dependent: each
// instantiation evaluates it), or is invalid (reported here, once — errors
// dedupe across re-resolution).
func evalArrayLen(c @Checker, e @ast.Expr) (int, bool, bool) {
	if e == nil {
		return 0, false, false
	}
	validateDimExpr(c, e)
	var v constval.Value
	var st int
	var at @ast.Expr
	v, st, at = evalConst(c, e)
	if st == constval.OK {
		if v.IsBool {
			addCheckError(c, e.Pos, "array length must be a constant integer")
			return 0, false, false
		}
		if v.N.IsNegative() {
			// A negative length has no valid layout.
			addCheckError(c, e.Pos, "array length must be non-negative")
			return 0, false, false
		}
		if !v.N.FitsSigned(hostIntBits()) {
			addCheckError(c, e.Pos, "array length is too large")
			return 0, false, false
		}
		return v.N.ToInt(), true, false
	}
	if st == constval.DEPENDENT {
		// IR-gen evaluates it for each instantiation, reading the types of
		// its `len` operands, which are checked here.
		if !checkDimLenOperands(c, e) {
			addCheckError(c, e.Pos, "array length must be a constant integer")
			return 0, false, false
		}
		return 0, false, true
	}
	if st == constval.NOT_KNOWN || st == constval.POISONED {
		return 0, false, false
	}
	if isConstErr(st) {
		reportConstErr(c, at.Pos, st)
		return 0, false, false
	}
	addCheckError(c, e.Pos, "array length must be a constant integer")
	return 0, false, false
}

// checkDimLenOperands checks every `len(x)` operand in array dimension e, so
// IR-gen can read its type, and reports whether each is an array or string
// literal of known length (an array whose length depends on a type parameter
// has none).
func checkDimLenOperands(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return true
	}
	if e.Kind == ast.EXPR_BUILTIN && e.Op == cast(int, token.LEN) && len(e.Args) == 1 {
		var t @types.Type = checkExpr(c, e.Args[0])
		if isUntypedString(t) {
			return true
		}
		var p @types.Type = types.StripWrappers(t)
		return p != nil && p.Kind == types.TYP_ARRAY && !p.ArrayLenDependent
	}
	if e.Kind == ast.EXPR_UNARY {
		return checkDimLenOperands(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return checkDimLenOperands(c, e.X) && checkDimLenOperands(c, e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		for i := 0; i < len(e.Args); i++ {
			if !checkDimLenOperands(c, e.Args[i]) {
				return false
			}
		}
	}
	return true
}

// hostIntBits is the width of the compiler's own int, which holds an array
// length (types.Type.ArrayLen).
func hostIntBits() int {
	return cast(int, sizeof(int)) * 8
}

// validateDimExpr reports what checkExpr would in array-dimension expression
// `e`, which is evaluated with constval (evalConst) and never checked: a
// malformed escape in a char literal (`['\q']int`, checkExpr's EXPR_CHAR_LIT
// arm) and sizeof / alignof of an opaque type (checkBuiltinCall's arm), with
// the same messages.  Errors dedupe, so re-resolving the same array type
// across passes reports each once.
func validateDimExpr(c @Checker, e @ast.Expr) {
	if e == nil {
		return
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		checkCharLitEscapes(c, e.Name, e.Pos)
		return
	}
	if e.Kind == ast.EXPR_UNARY {
		validateDimExpr(c, e.X)
		return
	}
	if e.Kind == ast.EXPR_BINARY {
		validateDimExpr(c, e.X)
		validateDimExpr(c, e.Y)
		return
	}
	if e.Kind == ast.EXPR_BUILTIN &&
			(e.Op == cast(int, token.SIZEOF) || e.Op == cast(int, token.ALIGNOF)) && e.TypeRef != nil {
		if embedsOpaqueByValue(c, resolveTypeExpr(c, e.TypeRef)) {
			addCheckError(c, e.Pos,
					"cannot take sizeof/alignof of an opaque type (its layout is not available here)")
		}
		return
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			validateDimExpr(c, e.Args[i])
		}
	}
}
