package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// evalConstInt / evalConstIntValue fold array dimensions (and the const
// contexts — shift counts, cast fits — that must agree with IR-gen).  These
// exercise the evaluator end-to-end through array-dimension positions.

// A constant-arithmetic dimension folds without error.
func TestEvalConstIntArithDimFolds() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype S struct { a [2*3 + 1]int }\n")
	return expectNoErrors(c)
}

// A division-by-zero in a fully-known constant dimension is reported (not
// silently yielded as a [0]T array).
func TestEvalConstIntDivByZeroRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype S struct { a [1/0]int }\n")
	return expectErrSub(c, "division by zero")
}

// A non-constant dimension (a runtime parameter) is rejected as non-constant.
func TestEvalConstIntNonConstDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(n int) { var a [n]int; _ = a }\n")
	return expectErrSub(c, "must be a constant integer")
}

// An opaque sizeof used as a dimension reports the opaque diagnostic and does
// NOT additionally report a spurious "division by zero": dimFullyKnown treats
// an opaque sizeof as not-known, so evalConstInt takes its quiet path instead
// of mistaking the (separately diagnosed) non-fold for an arithmetic fault.
func TestEvalConstIntOpaqueSizeofDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var a [sizeof(Opaque)]int; _ = a }\n")
	var r testing.TestResult = expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
	if len(r) != 0 { return r }
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "division by zero") {
			return fail(
					"opaque sizeof dim must not report a spurious division-by-zero")
		}
	}
	return ""
}

// The alignof dimension arm shares dimFullyKnown's SIZEOF/ALIGNOF branch but
// evalConstIntValue's ALIGNOF arm is separate, so cover it independently: same
// clean opaque diagnostic, no spurious "division by zero".
func TestEvalConstIntOpaqueAlignofDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var a [alignof(Opaque)]int; _ = a }\n")
	var r testing.TestResult = expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
	if len(r) != 0 { return r }
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "division by zero") {
			return fail(
					"opaque alignof dim must not report a spurious division-by-zero")
		}
	}
	return ""
}

// An undefined name in a dimension is reported as undefined — once, without
// "must be a constant integer" too — as a `len` operand or a constant operand,
// wherever the array type is spelled.
func TestEvalConstIntUndefinedLenOperandDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar g [len(nosuch)]int\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A constant operand.
func TestEvalConstIntUndefinedConstOperandDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\ntype S struct { a [nosuch + 1]int }\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A parameter's type.
func TestEvalConstIntUndefinedParamDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f(a [len(nosuch)]int) {}\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A local's type.
func TestEvalConstIntUndefinedLocalDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f() { var a [nosuch]int; _ = a }\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A generic function's body, instantiated.
func TestEvalConstIntUndefinedGenericDim() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g[T any]() { var a [len(nosuch)]T; _ = a }\n"
					"func f() { g[int]() }\n")
	return expectOneErr(c, "undefined: nosuch")
}

// `_` binds nothing, so as a dimension it is reported as checkIdent reports it.
func TestEvalConstIntBlankDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar g [_]int\n")
	return expectOneErr(c, "cannot use _ as a value")
}

// A function named in its own signature is not undefined, though it is not
// defined while the signature is first resolved: the length is reported once,
// as not constant (len of a function).
func TestEvalConstIntOwnSignatureDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc g(a [len(g)]int) {}\n")
	return expectOneErr(c, "must be a constant integer")
}

// Nor is `__Package`, which checkIdent resolves.
func TestEvalConstIntPackageAccessorDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar g [__Package]int\n")
	return expectOneErr(c, "must be a constant integer")
}

// A `.bni` dimension's undefined name is reported once: by the `.bni` scope's
// build and by the package's check, at the same name.
func TestEvalConstIntUndefinedBniDim() testing.TestResult {
	var c @Checker = checkerWithLib("package \"pkg/lib\"\ntype T struct { a [nosuch]int }\n",
			"package \"pkg/lib\"\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A `len` operand.
func TestEvalConstIntUndefinedBniLenDim() testing.TestResult {
	var c @Checker = checkerWithLib("package \"pkg/lib\"\ntype T struct { a [len(nosuch)]int }\n",
			"package \"pkg/lib\"\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A name the `.bni` declares after the dimension is not undefined, though the
// `.bni` scope's build has not defined it when it evaluates the dimension.
func TestEvalConstIntLaterBniNameNotUndefined() testing.TestResult {
	var c @Checker = checkerWithLib("package \"pkg/lib\"\ntype T [N]int\nconst N = 3\n",
			"package \"pkg/lib\"\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "undefined") {
			return fail(errs[i].Msg)
		}
	}
	return ""
}

// A qualified operand: the qualifier is undefined.
func TestEvalConstIntUndefinedQualifierDim() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar g [nosuch.X]int\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A dimension that depends on a type parameter is reported once too.
func TestEvalConstIntUndefinedDependentDim() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype B[T any] struct { a [alignof(T) + len(nosuch)]T }\n"
					"var b B[int]\n")
	return expectOneErr(c, "undefined: nosuch")
}

// So is one after the operand the length depends on, which its evaluation does
// not reach, in a generic not instantiated.
func TestEvalConstIntUndefinedAfterDependentDim() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype B[T any] struct { a [alignof(T) + nosuch]T }\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A qualified one, in a generic function's body.
func TestEvalConstIntUndefinedQualifierAfterDependentDim() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g[T any]() { var a [alignof(T) + nosuch.X]T; _ = a }\n")
	return expectOneErr(c, "undefined: nosuch")
}

// A constant there, declared later, is not.
func TestEvalConstIntConstAfterDependentDim() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype B[T any] struct { a [alignof(T) + N]T }\nconst N = 2\n"
					"var b B[int]\n")
	return expectNoErrors(c)
}
