package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// A package's impls are collected before its other declarations are resolved.
// An impl needs only names — its receiver's named type, or a generic's
// binders, and its interfaces, all registered before anything resolves — so
// collecting it reads no layout, and a question asked while the declarations
// resolve of whether a type satisfies an interface sees every impl of the
// package, in any order: an array length or a constant passing a value to a
// function of an interface (`[len(F(&v))]int` with `func F(i *I) [3]int`).
// An interface an impl lists, or a value's interface being widened, may not
// have its parents then; they are readied when asked (readyIfaceParentsHere).
//
// The `.bni` build collects the `.bni`'s impls the same way, and drops them
// when it ends: the package's own check collects them from its declarations.

// collectBatchImpls collects the impls among the batch's declarations decls
// (collectImplDecl), each in its file's scope.
func collectBatchImpls(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_IMPL {
			continue
		}
		var saved declContext = enterPackageDecl(c, d)
		collectImplDecl(c, d)
		leavePackageDecl(c, saved)
	}
}

// collectBniImpls collects the impls among the `.bni`'s declarations decls and
// returns the number of impls c had before, for dropBniImpls.
func collectBniImpls(c @Checker, decls *[]@ast.Decl) int {
	var mark int = len(c.Impls)
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_IMPL {
			collectImplDecl(c, decls[i])
		}
	}
	return mark
}

// dropBniImpls drops the impls collectBniImpls collected, from mark on.
func dropBniImpls(c @Checker, mark int) {
	if len(c.Impls) > mark {
		c.Impls = c.Impls[:mark]
	}
}

// bniGenericStandIn returns the placeholder a `.bni` build's
// parameterized-receiver impl of the build's generic type name records
// (Impl.Placeholder): a named type of that name, without methods.  The build
// registers no placeholder of a generic type (recordBniGenericMethods), and it
// drops its impls before any coverage check, the one reader of a placeholder's
// methods.
func bniGenericStandIn(c @Checker, name *[]readonly char) @types.Type {
	var t @types.Type = types.MakeNamedType(buf.CopyStr(name))
	t.Pkg = buf.CopyStr(c.curPkgPath)
	return t
}

// implSatisfiesHere is implSatisfiesInterface for a use in c, where an
// interface rec lists may be one of the package's own whose parents are not
// resolved yet: those are readied first.
func implSatisfiesHere(c @Checker, rec @Impl, iface @types.Type) bool {
	if implSatisfiesInterface(rec, iface) {
		return true
	}
	if rec == nil || !types.CharEq(rec.Pkg, c.curPkgPath) {
		return false
	}
	for i := 0; i < len(rec.Interfaces); i++ {
		readyIfaceParentsHere(c, rec.Interfaces[i])
	}
	return implSatisfiesInterface(rec, iface)
}

// isDescendantHere is isDescendantInterface for a use in c, where child may be
// one of the package's own interfaces whose parents are not resolved yet:
// those are readied first.
func isDescendantHere(c @Checker, child @types.Type, ancestor @types.Type) bool {
	if isDescendantInterface(child, ancestor) {
		return true
	}
	readyIfaceParentsHere(c, child)
	return isDescendantInterface(child, ancestor)
}

// readyIfaceParentsHere resolves the extension clauses of iface, one of the
// package's own interfaces, and of its ancestors, while the package's
// declarations are collected or its `.bni`'s resolved, before those clauses
// are resolved in their turn (resolvePendingIfaceParents,
// resolveBniInterfaceParents) — only the clauses, which name interfaces, not
// the interfaces' methods, whose signatures may read a layout not built yet.
// Elsewhere, or for another package's interface, it does nothing.
func readyIfaceParentsHere(c @Checker, iface @types.Type) {
	var visiting @[]@ast.Decl
	readyParentsFrom(c, iface, visiting)
}

// readyParentsFrom is readyIfaceParentsHere, the declarations of the
// interfaces visiting being readied further up.
func readyParentsFrom(c @Checker, iface @types.Type, visiting @[]@ast.Decl) {
	if iface == nil || iface.Kind != types.TYP_INTERFACE {
		return
	}
	var bni bool = inBniBuild(c)
	var d @ast.Decl
	if bni {
		d = bniIfaceDeclOf(c, iface)
	} else if c.Batch != nil && c.Batch.Collecting {
		d = batchIfaceDeclOf(c, iface)
	}
	if d == nil || len(d.Interfaces) == 0 || declInList(visiting, d) {
		return
	}
	if bni {
		var saved bniDeclContext = enterBniDecl(c, d)
		resolveInterfaceParents(c, d, iface, false)
		leaveBniDecl(c, saved)
	} else {
		var saved declContext = enterPackageDecl(c, d)
		resolveInterfaceParents(c, d, iface, false)
		leavePackageDecl(c, saved)
	}
	var inner @[]@ast.Decl = slices.Append[@ast.Decl](visiting, d)
	for i := 0; i < len(iface.Parents); i++ {
		readyParentsFrom(c, iface.Parents[i], inner)
	}
}
