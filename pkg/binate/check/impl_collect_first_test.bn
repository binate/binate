package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for impl_collect_first.bn: an array length or a constant passing a
// value to a function of an interface sees the package's impls declared after
// it, in a `.bn` and in a `.bni` an importer builds, and an interface's parents
// through an impl of a child interface or a widened interface value.

// implFirstBnCases reports "" when each single-file program srcs[i] checks
// cleanly.
func implFirstBnCases(srcs @[]*[]readonly char) testing.TestResult {
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoErrors(checkSrc(srcs[i]))
		if len(r) > 0 { return buf.Concat(srcs[i], r) }
	}
	return ""
}

// In a `.bn`, a type's length and a constant read an impl declared after them
// — a raw and a managed interface value, an impl of a child interface for its
// parent, a generic type's — and a value of an interface widens to a parent
// declared after it.  Another impl of the type, whose interface, or that
// interface's parent, has a method reading the type's layout, is no cycle: an
// interface's parents are readied, not its methods.
func TestImplFirstBn() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 8)
	srcs[0] = "package \"main\"\ninterface I { M() int }\ntype T struct { x int }\n"
			"func (t *T) M() int { return t.x }\nvar V T\n"
			"func F(i *I) [3]int { var r [3]int; return r }\n"
			"type N struct { a [len(F(&V))]uint8 }\nimpl *T : I\nvar n N\nvar b [3]uint8 = n.a\n"
	srcs[1] = "package \"main\"\nconst S = len(F(&V))\n"
			"interface I { M() int }\ntype T struct { x int }\nfunc (t *T) M() int { return t.x }\nvar V T\n"
			"func F(i *I) [3]int { var r [3]int; return r }\nimpl *T : I\n"
			"var a [S]int\nvar b [3]int = a\n"
	srcs[2] = "package \"main\"\ntype N struct { a [len(F(P))]uint8 }\ninterface I { M() int }\n"
			"type T struct { x int }\nfunc (t *T) M() int { return t.x }\nvar P @T\n"
			"func F(i @I) [3]int { var r [3]int; return r }\nimpl *T : I\nvar n N\nvar b [3]uint8 = n.a\n"
	srcs[3] = "package \"main\"\ntype N struct { a [len(F(&V))]uint8 }\nvar V T\n"
			"func F(i *B) [3]int { var r [3]int; return r }\nimpl *T : I\n"
			"interface I : C { K() int }\ninterface C : B { L() int }\ninterface B { M() int }\n"
			"type T struct { x int }\nfunc (t *T) M() int { return t.x }\n"
			"func (t *T) K() int { return t.x }\nfunc (t *T) L() int { return t.x }\n"
			"var n N\nvar b [3]uint8 = n.a\n"
	srcs[4] = "package \"main\"\ntype N struct { a [len(F(X))]uint8 }\nvar X @I\n"
			"func F(b @B) [3]int { var r [3]int; return r }\n"
			"interface I : B { K() int }\ninterface B { M() int }\nvar n N\nvar b [3]uint8 = n.a\n"
	srcs[5] = "package \"main\"\nimpl *T : J\nimpl *T : I\ntype N struct { a [len(F(&V))]uint8 }\n"
			"interface J { L(x [sizeof(N)]uint8) int }\ninterface I { M() int }\ntype T struct { x int }\n"
			"func (t *T) M() int { return 1 }\nfunc (t *T) L(x [sizeof(N)]uint8) int { return 2 }\n"
			"func F(i *I) [3]int { var r [3]int; return r }\nvar V T\nvar n N\nvar b [3]uint8 = n.a\n"
	srcs[6] = "package \"main\"\nimpl *T : J\nimpl *T : I\ntype N struct { a [len(F(&V))]uint8 }\n"
			"interface J : B { Q() int }\ninterface B { L(x [sizeof(N)]uint8) int }\n"
			"interface I { M() int }\ntype T struct { x int }\nfunc (t *T) M() int { return 1 }\n"
			"func (t *T) Q() int { return 1 }\nfunc (t *T) L(x [sizeof(N)]uint8) int { return 2 }\n"
			"func F(i *I) [3]int { var r [3]int; return r }\nvar V T\nvar n N\nvar b [3]uint8 = n.a\n"
	srcs[7] = "package \"main\"\ntype N struct { a [len(F(&V))]uint8 }\nimpl *Box[X] : I\n"
			"interface I : B { K() int }\ninterface B { M() int }\ntype Box[X any] struct { x X }\n"
			"func (b *Box[X]) M() int { return 1 }\nfunc (b *Box[X]) K() int { return 2 }\n"
			"func F(b *B) [3]int { var r [3]int; return r }\nvar V Box[int]\nvar n N\nvar b [3]uint8 = n.a\n"
	return implFirstBnCases(srcs)
}

// In a `.bni` an importer builds, a type's length and a constant read the
// `.bni`'s impls, declared before or after them: a raw and a managed interface
// value, an impl of a child interface for its parent, a generic type's impl,
// a generic function's constraint; and a value of an interface widens to a
// parent declared after it.  Another impl's interface whose method reads the
// layout is no cycle.
func TestImplFirstBni() testing.TestResult {
	var bnis @[]*[]readonly char = make_slice(*[]readonly char, 8)
	var mains @[]*[]readonly char = make_slice(*[]readonly char, 8)
	bnis[0] = "interface I { M() int }\ntype T struct { x int }\nfunc (t *T) M() int\nvar V T\n"
			"func F(i *I) [3]int\ntype N struct { a [len(F(&V))]uint8 }\nimpl *T : I\n"
	bnis[1] = "const S = len(F(&V))\nimpl *T : I\nfunc F(i *I) [3]int\nvar V T\n"
			"func (t *T) M() int\ntype T struct { x int }\ninterface I { M() int }\n"
	bnis[2] = "type N struct { a [len(F(P))]uint8 }\n"
			"interface I { M() int }\ntype T struct { x int }\nfunc (t *T) M() int\n"
			"var P @T\nfunc F(i @I) [3]int\nimpl *T : I\n"
	bnis[3] = "type N struct { a [len(F(&V))]uint8 }\nvar V T\nfunc F(i *B) [3]int\nimpl *T : I\n"
			"interface I : C { K() int }\ninterface C : B { L() int }\ninterface B { M() int }\n"
			"type T struct { x int }\nfunc (t *T) M() int\nfunc (t *T) K() int\nfunc (t *T) L() int\n"
	bnis[4] = "const S = len(F(&V))\ninterface I { M() int }\ntype Box[X any] struct { x X }\n"
			"func (b *Box[X]) M() int { return 1 }\nvar V Box[int]\nfunc F(i *I) [3]int\n"
			"impl *Box[X] : I\n"
	bnis[5] = "const S = len(G[T](V))\ninterface I { M() int }\ntype T struct { x int }\n"
			"func (t T) M() int\nvar V T\nfunc G[X I](x X) [3]int { var r [3]int; return r }\n"
			"impl T : I\n"
	bnis[6] = "type N struct { a [len(F(X))]uint8 }\nconst S = len(F(X))\nvar X *I\n"
			"func F(b *B) [3]int\ninterface I : B { K() int }\ninterface B { M() int }\n"
	bnis[7] = "impl *T : J\nimpl *T : I\ntype N struct { a [len(F(&V))]uint8 }\n"
			"interface J { L(x [sizeof(N)]uint8) int }\ninterface I { M() int }\ntype T struct { x int }\n"
			"func (t *T) M() int\nfunc (t *T) L(x [sizeof(N)]uint8) int\nfunc F(i *I) [3]int\nvar V T\n"
	for i := 0; i < len(mains); i++ {
		mains[i] = bniTypeNIs3
	}
	mains[1] = bniConstIs3
	mains[4] = bniConstIs3
	mains[5] = bniConstIs3
	return bniMemberCases(bnis, mains)
}

// The impls collected for a `.bni`'s build are dropped when it ends — the
// package's own check collects them — and the build sees no impl the `.bni`
// does not declare; nor does it report an impl of a generic type it does not
// declare, which the package's own check, seeing its `.bn`'s, reports.
func TestImplFirstBniDropped() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ninterface I { M() int }\n"
					"type T struct { x int }\nfunc (t *T) M() int\nvar V T\nfunc F(i *I) [3]int\n"
					"const S = len(F(&V))\nimpl *T : I\n",
			buf.Concat(importQ, bniConstIs3))
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }
	if len(c.Impls) != 0 {
		return fail("the .bni build's impl is kept")
	}
	c = checkSrcImporting("pkg/q",
			"package \"pkg/q\"\ninterface I { M() int }\n"
					"type T struct { x int }\nfunc (t *T) M() int\nvar V T\nfunc F(i *I) [3]int\n"
					"const S = len(F(&V))\n",
			importQ)
	r = expectOneErrAt(c, 7, 17, "cannot assign *T to *I")
	if len(r) > 0 { return r }
	c = checkSrcImporting("pkg/q", "package \"pkg/q\"\ninterface I { M() int }\nimpl *Box[X] : I\n",
			importQ)
	return expectNoErrors(c)
}
