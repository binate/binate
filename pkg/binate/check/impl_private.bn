package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// An impl only a package's .bn declares, when the package has a .bni, is private
// to that package's .bn (pkg.export), like a method only the .bn declares: it
// makes its receiver satisfy its interfaces — for a conversion to an interface
// value (iface.construct.visible-impl) or a type argument's constraint
// (gen.satisfy) — only in that .bn, not in another package and not in the
// package's own .bni, whose generic bodies are monomorphized in importers and
// which an importer reading only the .bni must be able to check.
// Impl.PrivatePkg names that package.

// privateImplPkg returns the current package's path when the impl d is private
// to its .bn: d is in a .bn of a package with a .bni; otherwise empty.
func privateImplPkg(c @Checker, d @ast.Decl) @[]char {
	var none @[]char
	if c.PkgBni == nil || declaredInBni(d) { return none }
	return buf.CopyStr(c.curPkgPath)
}

// An ImplView is the place of a use of impls, which decides the impls visible
// there (implVisible).
type ImplView struct {
	// Pkg is the package whose source makes the use, and Bni whether the use is in
	// that package's .bni.
	Pkg @[]char
	Bni bool
	// All is set in an instance of a generic — its fields, methods, impls and
	// body, resolved and checked with the type arguments bound — where every impl
	// is visible: the instance's uses of impls through its type arguments were
	// checked where the generic was instantiated, and its other uses where the
	// generic was declared.
	All bool
}

// bindInstance marks the resolution of d's instantiation with args as one of an
// instance (InstanceState.Bound), and returns the Bound unbindInstance restores.
// With args d's own type parameters, it is d resolved as written instead
// (checkGenericDeclAbstract): its uses of impls are checked in d's own view.
func bindInstance(c @Checker, d @ast.Decl, args *[]@types.Type) int {
	var st @InstanceState = instanceState(c)
	var saved int = st.Bound
	if argsAreOwnParams(d, args) {
		st.Bound = 0
	} else {
		st.Bound = saved + 1
	}
	return saved
}

// unbindInstance ends what bindInstance began, restoring Bound to saved.
func unbindInstance(c @Checker, saved int) {
	instanceState(c).Bound = saved
}

// argsAreOwnParams reports whether args are the generic declaration d's own type
// parameters, in order.
func argsAreOwnParams(d @ast.Decl, args *[]@types.Type) bool {
	if len(args) == 0 || len(args) != len(d.TypeParams) { return false }
	for i := 0; i < len(args); i++ {
		var a @types.Type = args[i]
		if a == nil || a.Kind != types.TYP_TYPE_PARAM || a.TpIndex != i ||
				a.TpOwner != bit_cast(*uint8, d) {
			return false
		}
	}
	return true
}

// implViewHere returns the view of a use of impls in what c is checking.
func implViewHere(c @Checker) ImplView {
	var v ImplView
	v.Pkg = c.curPkgPath
	v.Bni = inBniView(c)
	v.All = instanceState(c).Bound > 0
	return v
}

// implViewAt returns the view of a use of impls at pos: implViewHere, in the
// .bni when pos is in one.  A .bni declaration's instantiations are resolved
// while the package's interface scope is built, before c's scope is the .bni's.
func implViewAt(c @Checker, pos token.Pos) ImplView {
	var v ImplView = implViewHere(c)
	var f @[]char = pos.File
	if len(f) >= 4 && types.CharEq(f[len(f) - 4:], ".bni") { v.Bni = true }
	return v
}

// implVisible reports whether rec makes its receiver satisfy its interfaces at
// a use in view v.
func implVisible(rec @Impl, v ImplView) bool {
	if v.All || len(rec.PrivatePkg) == 0 { return true }
	return !v.Bni && types.CharEq(rec.PrivatePkg, v.Pkg)
}

// implViewKey returns a key that is equal for two views exactly when they see
// the same impls.
func implViewKey(v ImplView) @[]char {
	if v.All { return buf.CopyStr("*") }
	if v.Bni { return buf.Concat(v.Pkg, ".bni") }
	return buf.Concat(v.Pkg, ".bn")
}

// constraintsCheckedIn reports whether e's constraints were checked from a view
// that sees the impls v sees: whether a type argument satisfies its constraint
// depends on the impls visible where the instantiation is written.
func constraintsCheckedIn(e @GenericInstantiation, v ImplView) bool {
	var key @[]char = implViewKey(v)
	for i := 0; i < len(e.CheckedViews); i++ {
		if types.CharEq(e.CheckedViews[i], key) { return true }
	}
	return false
}

// markConstraintsChecked records that e's constraints were checked from view v.
func markConstraintsChecked(e @GenericInstantiation, v ImplView) {
	e.CheckedViews = slices.Append[@[]char](e.CheckedViews, implViewKey(v))
}

// hiddenImplPkg returns the package an impl rec is private to when rec, not
// visible from view v, would make src satisfy the interface iface — directly,
// through an ancestor, or as an instance of a parameterized impl; otherwise
// empty.
func hiddenImplPkg(c @Checker, src @types.Type, iface @types.Type, v ImplView) @[]char {
	var none @[]char
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil || implVisible(rec, v) { continue }
		if implSatisfiesInterface(rec, iface) && receiverAssignable(src, rec.RecvType) ||
				genericImplSatisfies(c, rec, src, iface) {
			return rec.PrivatePkg
		}
	}
	return none
}

// privateImplNote returns the note a type error appends when the impl that
// would allow the use is private to package pkg, or empty when pkg is.
func privateImplNote(pkg *[]readonly char) @[]char {
	if len(pkg) == 0 { return buf.CopyStr("") }
	return buf.Concat(": the matching impl is private to package ", pkg)
}

// conversionImplNote returns privateImplNote's note for a failed conversion of
// src to the interface value type dst here, when an impl c cannot see here is
// what keeps it from being assignable; otherwise empty.
func conversionImplNote(c @Checker, src @types.Type, dst @types.Type) @[]char {
	var none @[]char
	var d @types.Type = types.ResolveAliasAndConst(dst)
	if src == nil || d == nil || d.Elem == nil ||
			d.Kind != types.TYP_INTERFACE_VALUE && d.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return none
	}
	var v ImplView = implViewHere(c)
	if v.All { return none }
	var st @InstanceState = instanceState(c)
	st.Bound = st.Bound + 1
	var ok bool = AssignableTo(src, c, dst)
	st.Bound = st.Bound - 1
	if !ok { return none }
	return privateImplNote(hiddenImplPkg(c, src, d.Elem, v))
}

// constraintImplNote returns privateImplNote's note for a type argument t that
// does not satisfy its constraint iface from view v, when an impl v cannot see
// is what keeps it from satisfying it; otherwise empty.
func constraintImplNote(c @Checker, t @types.Type, iface @types.Type, v ImplView) @[]char {
	var none @[]char
	if v.All { return none }
	var all ImplView
	all.All = true
	if !typeSatisfiesConstraint(c, t, iface, all) { return none }
	return privateImplNote(hiddenImplPkg(c, t, iface, v))
}
