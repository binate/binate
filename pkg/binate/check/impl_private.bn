package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// An impl only a package's .bn declares, when the package has a .bni, is private
// to that package's .bn (pkg.export), like a method only the .bn declares: it
// makes its receiver satisfy its interfaces — for a conversion to an interface
// value (iface.construct.visible-impl) or a type argument's constraint
// (gen.satisfy) — only in that .bn, not in another package and not in the
// package's own .bni, whose generic bodies are monomorphized in importers and
// which an importer reading only the .bni must be able to check.
// Impl.PrivatePkg names that package.

// privateImplPkg returns the current package's path when the impl d is private
// to its .bn: d is in a .bn of a package with a .bni; otherwise empty.
func privateImplPkg(c @Checker, d @ast.Decl) @[]char {
	var none @[]char
	if c.PkgBni == nil || declaredInBni(d) { return none }
	return buf.CopyStr(c.curPkgPath)
}

// An ImplView is the place of a use of impls, which decides the impls visible
// there (implVisible).
type ImplView struct {
	// Pkg is the package whose source makes the use, and Bni whether the use is in
	// that package's .bni.
	Pkg @[]char
	Bni bool
	// Inst is set in an instance of a generic — its fields, methods, impls and
	// body, resolved and checked with the type arguments bound — where Pkg and Bni
	// are the generic's, and the use also sees the impls private to its view
	// root's .bn (VRoot, impl_view_root.bn): those its type arguments may lean on
	// where the chain of instantiations naming it is written.
	Inst  bool
	VRoot @[]char
	// All is set where every impl is visible: in a probe asking whether any impl
	// would serve (constraintImplNote, conversionImplNote: InstanceState.ProbeAll),
	// and, for now, in a generic alias's target resolved with its type arguments
	// bound (implViewHere) and in a derivation made outside any build or instance
	// check (instantiateGenericDeclWithArgs).
	// TODO(plan-instance-impl-view.md step 3): judge an alias's target in its use's
	// view, and make a derivation outside any build or check judge nothing.
	All bool
	// Derived is set for a constraint check of an instantiation an instance's
	// declared types form (DerivingInstanceSig), with Inst (or All): it sees what
	// they see, and is latched apart from a use's check (implViewKey), which
	// judges more.
	Derived bool
}

// An instanceBinding is what bindInstance changes, for unbindInstance to
// restore: InstanceState's Bound, Building, BuildLenders, BuildChainRoot,
// BuildVRoot, site (setSite) and Concrete, and Generics.MissLevel.
type instanceBinding struct {
	Bound          int
	Building       bool
	BuildLenders   @[]@[]char
	BuildChainRoot @[]char
	BuildVRoot     @[]char
	Site           siteState
	MissLevel      int
	Concrete       int
}

// bindInstance marks the resolution of d's instantiation with args, named here,
// as one of an instance (InstanceState.Bound), whose instances are named in
// this naming's lender class (InstanceState.BuildLenders), chain
// (BuildChainRoot) and view root (BuildVRoot, impl_view_root.bn) as written
// where the generic is, and returns what unbindInstance restores.  With args
// d's own type parameters, it is d resolved as written instead
// (checkGenericDeclAbstract): its uses of impls are checked in d's own view,
// and it lends nothing and is in no chain.
func bindInstance(c @Checker, d @ast.Decl, args *[]@types.Type) instanceBinding {
	return bindInstanceAt(c, d, args, namingHere(c))
}

// bindInstanceAt is bindInstance for a naming in the context n, which need not
// be the current one: a constraint check runs in the generic's scope, and may
// be replayed after collection (recheckDeferredConstraints).
func bindInstanceAt(c @Checker, d @ast.Decl, args *[]@types.Type, n namingContext) instanceBinding {
	var none @[]@[]char
	var noRoot @[]char
	if argsAreOwnParams(d, args) { return bindInstanceIn(c, args, false, none, noRoot, noRoot) }
	return bindInstanceIn(c, args, true, lenderClassAt(exportOwners(c, args), n), n.ChainRoot,
			normalizeViewRoot(c, n.VRoot, args))
}

// bindAliasTarget is bindInstance for the target of the generic alias d with
// args, which is as if written where the alias is used (gen.instantiate.alias):
// the instances it names carry the view root carried to the use, not one
// normalized for the alias's arguments -- the target may write a type they do
// not mention (`type KT[U any] = K[*T, U]`).
func bindAliasTarget(c @Checker, d @ast.Decl, args *[]@types.Type) instanceBinding {
	var n namingContext = namingHere(c)
	if argsAreOwnParams(d, args) { return bindInstanceAt(c, d, args, n) }
	return bindInstanceIn(c, args, true, lenderClassAt(exportOwners(c, args), n), n.ChainRoot, n.VRoot)
}

// bindInstanceIn is bindInstance for the instantiation with args -- of an instance
// when inst, otherwise of a generic as written -- whose instances are named in the
// lender class lenders, the chain rooted in root and the view root vroot.
func bindInstanceIn(c @Checker, args *[]@types.Type, inst bool, lenders @[]@[]char, root @[]char,
		vroot @[]char) instanceBinding {
	var st @InstanceState = instanceState(c)
	var saved instanceBinding
	saved.Bound = st.Bound
	saved.Building = st.Building
	saved.BuildLenders = st.BuildLenders
	saved.BuildChainRoot = st.BuildChainRoot
	saved.BuildVRoot = st.BuildVRoot
	saved.Concrete = st.Concrete
	st.Bound = 0
	if inst { st.Bound = saved.Bound + 1 }
	st.Concrete = 0
	if !typeArgsAbstract(args) { st.Concrete = saved.Concrete + 1 }
	st.Building = true
	st.BuildLenders = lenders
	st.BuildChainRoot = root
	st.BuildVRoot = vroot
	saved.Site = clearSite(c)
	// A replayed check's level is its own report's (missDeclLevel), not that of
	// what the binding resolves.
	saved.MissLevel = c.Generics.MissLevel
	c.Generics.MissLevel = 0
	return saved
}

// unbindInstance ends what bindInstance began, restoring saved.
func unbindInstance(c @Checker, saved instanceBinding) {
	var st @InstanceState = instanceState(c)
	st.Bound = saved.Bound
	st.Building = saved.Building
	st.BuildLenders = saved.BuildLenders
	st.BuildChainRoot = saved.BuildChainRoot
	st.BuildVRoot = saved.BuildVRoot
	restoreSite(c, saved.Site)
	c.Generics.MissLevel = saved.MissLevel
	st.Concrete = saved.Concrete
}

// argsAreOwnParams reports whether args are the generic declaration d's own type
// parameters, in order.
func argsAreOwnParams(d @ast.Decl, args *[]@types.Type) bool {
	if len(args) == 0 || len(args) != len(d.TypeParams) { return false }
	for i := 0; i < len(args); i++ {
		var a @types.Type = args[i]
		if a == nil || a.Kind != types.TYP_TYPE_PARAM || a.TpIndex != i ||
				a.TpOwner != bit_cast(*uint8, d) {
			return false
		}
	}
	return true
}

// implViewHere returns the view of a use of impls in what c is checking.
func implViewHere(c @Checker) ImplView {
	var v ImplView
	v.Pkg = c.curPkgPath
	v.Bni = inBniView(c)
	var st @InstanceState = instanceState(c)
	v.All = st.ProbeAll || st.Bound > 0 && aliasNamings(c) > 0
	if st.Bound > 0 {
		v.Inst = true
		v.VRoot = viewRootHere(c)
	}
	return v
}

// implViewAt returns the view of a use of impls at pos: implViewHere, in the
// .bni when pos is in one.  A .bni declaration's instantiations are resolved
// while the package's interface scope is built, before c's scope is the .bni's.
func implViewAt(c @Checker, pos token.Pos) ImplView {
	var v ImplView = implViewHere(c)
	var f @[]char = pos.File
	if len(f) >= 4 && types.CharEq(f[len(f) - 4:], ".bni") { v.Bni = true }
	return v
}

// implVisible reports whether rec makes its receiver satisfy its interfaces at
// a use in view v.
func implVisible(rec @Impl, v ImplView) bool {
	if v.All || len(rec.PrivatePkg) == 0 { return true }
	if !v.Bni && types.CharEq(rec.PrivatePkg, v.Pkg) { return true }
	return v.Inst && len(v.VRoot) > 0 && types.CharEq(rec.PrivatePkg, v.VRoot)
}

// implViewKey returns the key a constraint check from view v is latched under
// (constraintsCheckedIn): equal for two views exactly when they see the same
// impls and judge alike -- a derived check's (Derived) apart from a use's.  An
// instance's view is keyed by its own package's .bn (none for a .bni) and its
// view root: `*pkg+root`, `*derived:pkg+root`.
func implViewKey(v ImplView) @[]char {
	if v.All && v.Derived { return buf.CopyStr("*derived") }
	if v.All { return buf.CopyStr("*") }
	if v.Inst {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("*")
		if v.Derived { cb.Write("derived:") }
		if !v.Bni { cb.Write(v.Pkg) }
		cb.Write("+")
		cb.Write(v.VRoot)
		return buf.CopyStr(cb.String())
	}
	if v.Bni { return buf.Concat(v.Pkg, ".bni") }
	return buf.Concat(v.Pkg, ".bn")
}

// constraintsCheckedIn reports whether e's constraints were checked from a view
// that sees the impls v sees: whether a type argument satisfies its constraint
// depends on the impls visible where the instantiation is written.
func constraintsCheckedIn(e @GenericInstantiation, v ImplView) bool {
	var key @[]char = implViewKey(v)
	for i := 0; i < len(e.CheckedViews); i++ {
		if types.CharEq(e.CheckedViews[i], key) { return true }
	}
	return false
}

// markConstraintsChecked records that e's constraints were checked from view v.
func markConstraintsChecked(e @GenericInstantiation, v ImplView) {
	e.CheckedViews = slices.Append[@[]char](e.CheckedViews, implViewKey(v))
}

// unmarkConstraintsChecked undoes markConstraintsChecked for view v, for a check
// whose report was dropped: it is made again at the next use.
func unmarkConstraintsChecked(e @GenericInstantiation, v ImplView) {
	var key @[]char = implViewKey(v)
	var kept @[]@[]char
	for i := 0; i < len(e.CheckedViews); i++ {
		if !types.CharEq(e.CheckedViews[i], key) {
			kept = slices.Append[@[]char](kept, e.CheckedViews[i])
		}
	}
	e.CheckedViews = kept
}

// hiddenImplPkg returns the package an impl rec is private to when rec, not
// visible from view v, would make src satisfy the interface iface — directly,
// through an ancestor, or as an instance of a parameterized impl; otherwise
// empty.  src is a type argument when typeArg (its receiver matched as
// constraintRecvMatches does), else a value converted to the interface (matched
// with receiver smoothing).
func hiddenImplPkg(c @Checker, src @types.Type, iface @types.Type, v ImplView,
		typeArg bool) @[]char {
	var none @[]char
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil || implVisible(rec, v) { continue }
		var serves bool
		if typeArg {
			serves = constraintRecvMatches(src, rec.RecvType)
		} else {
			serves = receiverAssignable(src, rec.RecvType)
		}
		if implSatisfiesInterface(rec, iface) && serves ||
				genericImplMatches(c, rec, src, iface, typeArg, false) {
			return rec.PrivatePkg
		}
	}
	return none
}

// privateImplNote returns the note a type error appends when the impl that
// would allow the use is private to package pkg, or empty when pkg is.
func privateImplNote(pkg *[]readonly char) @[]char {
	if len(pkg) == 0 { return buf.CopyStr("") }
	return buf.Concat(": the matching impl is private to package ", pkg)
}

// conversionImplNote returns privateImplNote's note for a failed conversion of
// src to the interface value type dst here, when an impl c cannot see here is
// what keeps it from being assignable; otherwise empty.  It asks whether the
// conversion would work with every impl visible (InstanceState.ProbeAll), as an
// instance's resolution, its type arguments bound.
func conversionImplNote(c @Checker, src @types.Type, dst @types.Type) @[]char {
	var none @[]char
	var d @types.Type = types.ResolveAliasAndConst(dst)
	if src == nil || d == nil || d.Elem == nil ||
			d.Kind != types.TYP_INTERFACE_VALUE && d.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return none
	}
	var v ImplView = implViewHere(c)
	if v.All { return none }
	var st @InstanceState = instanceState(c)
	st.Bound = st.Bound + 1
	st.ProbeAll = true
	var ok bool = AssignableTo(src, c, dst)
	st.ProbeAll = false
	st.Bound = st.Bound - 1
	if !ok { return none }
	return privateImplNote(hiddenImplPkg(c, src, d.Elem, v, false))
}

// constraintImplNote returns privateImplNote's note for a type argument t that
// does not satisfy its constraint iface from view v, when an impl v cannot see
// is what keeps it from satisfying it; otherwise empty.
func constraintImplNote(c @Checker, t @types.Type, iface @types.Type, v ImplView) @[]char {
	var none @[]char
	if v.All { return none }
	var all ImplView
	all.All = true
	if !typeSatisfiesConstraint(c, t, iface, all) { return none }
	return privateImplNote(hiddenImplPkg(c, t, iface, v, true))
}
