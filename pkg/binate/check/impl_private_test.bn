package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for impl_private.bn.  privLibBni and privLibBn (pkg/lib: T with a
// private dbl, interface D { dbl() int }) are in method_private_test.bn.

// Generics over D in pkg/lib's interface: a generic type, generic types one of
// which holds the other, and generic functions one of which calls the other.
var implLibBni *[]readonly char = "type H[X D] struct { x X }\ntype HH[X D] struct { h H[X] }\n"
		"func Inner[X D](x X) int { return x.dbl() }\nfunc Outer[X D](x X) int { return Inner[X](x) }\n"

// checkImplUser checks package q, whose .bn (after its import of pkg/lib) is
// body, against pkg/lib whose interface is privLibBni, implLibBni and extraBni,
// and whose .bn is privLibBn and extraBn.
func checkImplUser(extraBni *[]readonly char, extraBn *[]readonly char,
		body *[]readonly char) @Checker {
	var bni @[]char = buf.Concat(buf.Concat(privLibBni, implLibBni), extraBni)
	return checkBniMethodPkgIn(checkerWithLib(bni, buf.Concat(privLibBn, extraBn)),
			"package \"q\"\nfunc F() int\n", buf.Concat("package \"q\"\nimport \"pkg/lib\"\n", body), false)
}

// An impl only a package's .bn declares is not visible to another package: it
// cannot convert through it, nor satisfy a generic function's or a generic
// type's constraint through it — though pkg/lib's own .bn uses the same
// instantiation first.
func TestPrivateImplHiddenFromImporters() testing.TestResult {
	var useOwn *[]readonly char = "impl @T : D\nfunc useOwn() int {\n\tvar d @D = make(T)\n"
			"\tvar h H[@T]\n\treturn d.dbl() + Inner[@T](make(T))\n}\n"
	var c @Checker = checkImplUser("", useOwn, "func F() int { return 0 }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var r testing.TestResult = errsIn(
			checkImplUser("", useOwn, "func F() int {\n\tvar d @lib.D = make(lib.T)\n\treturn 0\n}\n"),
			"cannot assign @T to @D: the matching impl is private to package pkg/lib")
	if len(r) > 0 { return r }
	r = errsIn(checkImplUser("", useOwn, "func F() int { return lib.Inner[@lib.T](make(lib.T)) }\n"),
			"does not satisfy constraint D: the matching impl is private to package pkg/lib")
	if len(r) > 0 { return r }
	return errsIn(checkImplUser("", useOwn, "func F() int {\n\tvar h lib.H[@lib.T]\n\treturn 0\n}\n"),
			"does not satisfy constraint D: the matching impl is private to package pkg/lib")
}

// An impl the .bni declares is visible to importers.
func TestBniImplVisibleToImporters() testing.TestResult {
	var c @Checker = checkImplUser("func (t @T) dbl() int\nimpl @T : D\n", "",
			"func F() int {\n\tvar d @lib.D = make(lib.T)\n\tvar h lib.H[@lib.T]\n"
					"\treturn d.dbl() + lib.Inner[@lib.T](make(lib.T))\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A package's .bni does not see an impl only its .bn declares: not in a generic
// body, nor in an instantiation in a signature.
func TestPrivateImplHiddenFromBni() testing.TestResult {
	var r testing.TestResult = errsIn(
			checkImplUser("func Wrap[E any](t @T) @D { return t }\n", "impl @T : D\n",
					"func F() int { return 0 }\n"), "cannot assign @T to @D: the matching impl is private")
	if len(r) > 0 { return r }
	return errsIn(
			checkImplUser("func MkH() @H[@T]\n", "impl @T : D\nfunc MkH() @H[@T] { return make(H[@T]) }\n",
					"func F() int { return 0 }\n"), "does not satisfy constraint D: the matching impl is private")
}

// An instance of a generic sees every impl: q's private impl, which satisfies
// the constraint where q instantiates lib's generics, also satisfies it in the
// instances, where Outer[@Q] calls Inner[@Q] and HH[@Q] holds an H[@Q].
func TestPrivateImplInInstances() testing.TestResult {
	var c @Checker = checkImplUser("", "",
			"type Q struct { v int }\nfunc (q @Q) dbl() int { return q.v }\nimpl @Q : lib.D\n"
					"func F() int {\n\tvar hh lib.HH[@Q]\n\treturn lib.Outer[@Q](make(Q))\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A constraint naming an earlier type parameter (`G Getter[X]`) is resolved with
// the type arguments bound, so q's private impls, visible where q instantiates
// Holder, satisfy Getter's constraint on X too.
func TestPrivateImplConstraintOverParam() testing.TestResult {
	var c @Checker = checkImplUser(
			"interface Getter[X D] { get() X }\ntype Holder[X D, G Getter[X]] struct { g G }\n", "",
			"type Q struct { v int }\nfunc (q @Q) dbl() int { return q.v }\nimpl @Q : lib.D\n"
					"type QB struct { q @Q }\nfunc (b @QB) get() @Q { return b.q }\nimpl @QB : lib.Getter[@Q]\n"
					"func F() int {\n\tvar h lib.Holder[@Q, @QB]\n\treturn 0\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A generic alias's target and a generic interface's parents are checked as
// written, in their declaration's view: neither pkg/lib's .bni nor an importer's
// alias satisfies a constraint through pkg/lib's .bn impl.
func TestPrivateImplInAliasesAndParents() testing.TestResult {
	var r testing.TestResult = errsIn(
			checkImplUser("type A[E any] = H[@T]\n", "impl @T : D\n", "func F() int { return 0 }\n"),
			"does not satisfy constraint D: the matching impl is private")
	if len(r) > 0 { return r }
	r = errsIn(
			checkImplUser("interface K[X D] { k() X }\ninterface J[E any] : K[@T] {}\n", "impl @T : D\n",
					"func F() int { return 0 }\n"), "does not satisfy constraint D: the matching impl is private")
	if len(r) > 0 { return r }
	return errsIn(
			checkImplUser("", "impl @T : D\n",
					"type MA[E any] = lib.H[@lib.T]\nfunc F() int { return 0 }\n"),
			"does not satisfy constraint D: the matching impl is private to package pkg/lib")
}
