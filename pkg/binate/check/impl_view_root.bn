package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/stdx/slices"

// The view root of an instance's check (ImplView.VRoot): the package whose impls
// private to its .bn (impl_private.bn) the judgments made in the instance see,
// besides the public impls and those of the generic's own package when the
// generic is declared in a .bn (gen.mono.check: a type a root instantiation
// supplies is judged with the impls at that root).  Such an impl exists only in a
// package with a .bni, and a generic declared in such a package's .bn is named
// only from that .bn, so the only package whose private impls a chain of
// instantiations may lean on is the one whose .bn the chain is written in: a
// naming written in a .bn of a package with a .bni carries that package, any
// other naming inside an instance carries the view root of the instance it is
// made in, and one outside any carries none (carriedViewRoot).  An instance keeps
// the root carried to its naming only when one of that package's private impls
// has a receiver its type arguments mention (normalizeViewRoot): only a type the
// root supplies can match one, so an instance named from many packages with
// private impls that cannot serve it is checked once, with no root.  Each class
// of an instance's checks has its root (InstCheckState.VRoot), and a class whose
// root sees what the build's did not judges the instance's structure again
// (check_instance_rejudge.bn).

// carriedViewRoot returns the view root a naming written where site is
// (namingContext.Site) carries: site, when it is a .bn of a package with a .bni;
// otherwise the view root of the build or instance check the naming is made in
// (viewRootHere).
func carriedViewRoot(c @Checker, site @[]char) @[]char {
	if len(site) > 0 && packageHasInterface(c, site) { return site }
	return viewRootHere(c)
}

// viewRootHere returns the view root of the build or instance check being made:
// the build's (InstanceState.BuildVRoot) while an instance is resolved with its
// type arguments bound, else that of the instance being checked; outside any,
// none.
func viewRootHere(c @Checker) @[]char {
	var none @[]char
	if c.Instances == nil { return none }
	var st @InstanceState = c.Instances
	if st.Building { return st.BuildVRoot }
	if st.Current != nil { return st.Current.VRoot }
	return none
}

// normalizeViewRoot returns root, the view root carried to the naming of an
// instance with the type arguments args, when an impl private to root's .bn has a
// receiver args mention (privateImplServes); otherwise none.
func normalizeViewRoot(c @Checker, root @[]char, args *[]@types.Type) @[]char {
	var none @[]char
	if len(root) == 0 { return none }
	for i := 0; i < len(c.PrivateImpls); i++ {
		var rec @Impl = c.Impls[c.PrivateImpls[i]]
		if types.CharEq(rec.PrivatePkg, root) && privateImplServes(rec, args) { return root }
	}
	return none
}

// privateImplMayServe reports whether an impl private to some package's .bn has
// a receiver the type arguments args mention: only then may two classes of an
// instance with them have different view roots.
func privateImplMayServe(c @Checker, args *[]@types.Type) bool {
	for i := 0; i < len(c.PrivateImpls); i++ {
		if privateImplServes(c.Impls[c.PrivateImpls[i]], args) { return true }
	}
	return false
}

// privateImplServes reports whether the type arguments args mention the receiver
// base of the impl rec (ReceiverBaseNamed) -- its named type, or for a receiver
// that is an instance (a parameterized impl's `*W[K]`) any instance of its
// generic, or its predeclared type -- at any depth: through elements, signatures,
// anonymous structs' fields, interface values and instances' type arguments.  A
// named type's structure is not entered: a generic cannot reach the types of a
// type argument's fields.
func privateImplServes(rec @Impl, args *[]@types.Type) bool {
	if rec.RecvType == nil { return false }
	var base @types.Type = rec.RecvType.ReceiverBaseNamed()
	if base == nil { return false }
	var v typeVisits
	for i := 0; i < len(args); i++ {
		if mentionsReceiverBase(args[i], base, &v) { return true }
	}
	return false
}

// mentionsReceiverBase reports whether t mentions the receiver base base
// (privateImplServes), taking each part from the type work list (typeWalk) and,
// once it has taken lateVisitFrom, entering each type with parts once (v).
func mentionsReceiverBase(t @types.Type, base @types.Type, v *typeVisits) bool {
	var walk int = typeWalkBase()
	var steps int = 1
	var found bool = receiverBaseStep(t, base, v, steps)
	for !found && typeWalkMore(walk) {
		steps = steps + 1
		found = receiverBaseStep(typeWalkPop(), base, v, steps)
	}
	typeWalkEnd(walk)
	return found
}

// receiverBaseStep reports whether part t of a type mentionsReceiverBase walks, the
// steps-th it takes, is base, and pushes t's parts.
func receiverBaseStep(t @types.Type, base @types.Type, v *typeVisits, steps int) bool {
	if t == nil { return false }
	var u @types.Type = t.ResolveAlias()
	if u == nil { return false }
	if isReceiverBase(u, base) { return true }
	if steps > lateVisitFrom && !v.enter(u) { return false }
	if u.Kind == types.TYP_NAMED || u.Kind == types.TYP_INTERFACE {
		pushInstArgs(u)
		return false
	}
	if u.Kind == types.TYP_STRUCT && len(u.Name) == 0 { pushFieldTypes(u) }
	pushSignatureTypes(u)
	if u.Elem != nil { typeWalkPush(u.Elem) }
	return false
}

// isReceiverBase reports whether u is the receiver base base: an instance of the
// same generic, when base is an instance; the same named type; or the same
// predeclared type.
func isReceiverBase(u @types.Type, base @types.Type) bool {
	if base.InstDecl != nil { return u.InstDecl != nil && u.InstDecl == base.InstDecl }
	if base.Kind == types.TYP_NAMED {
		return u.Kind == types.TYP_NAMED && u.InstDecl == nil && (same(u, base) || u.Identical(base))
	}
	return u.Kind == base.Kind && u.Identical(base)
}

// recordImpl adds rec to c's impls (Checker.Impls), and its index to the impls
// private to a package's .bn (Checker.PrivateImpls) when it is one.
func recordImpl(c @Checker, rec @Impl) {
	if len(rec.PrivatePkg) > 0 {
		c.PrivateImpls = slices.Append[int](c.PrivateImpls, len(c.Impls))
	}
	c.Impls = slices.Append[@Impl](c.Impls, rec)
}

// truncateImpls drops c's impls from n on: a .bni build's (dropBniImpls), or an
// undone REPL declaration's.
func truncateImpls(c @Checker, n int) {
	if len(c.Impls) <= n { return }
	c.Impls = c.Impls[:n]
	var k int = len(c.PrivateImpls)
	for k > 0 && c.PrivateImpls[k - 1] >= n {
		k = k - 1
	}
	c.PrivateImpls = c.PrivateImpls[:k]
}
