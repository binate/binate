package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for impl_view_root.bn.

// pkg/lib's interface for the tests below: a Tag its generics need for a length
// that depends on a type parameter, so a function's own check leaves whether its
// call of In satisfies In's constraint to each instance; T is a Tag[[8]uint8]
// everywhere.
var viewLibBni *[]readonly char = "package \"pkg/lib\"\ninterface Tag[X any] { tag() int }\n"
		"func In[V Tag[[sizeof(X)]uint8], X any](v V) int { return v.tag() }\n"
		"func Out[V Tag[[sizeof(U)]uint8], U any, X any](v V) int { return In[V, X](v) }\n"
		"type W[V Tag[[sizeof(X)]uint8], X any] struct { v V }\n"
		"type HW[V Tag[[sizeof(U)]uint8], U any] struct { w *W[V, int32] }\n"
		"type T struct { n int }\nfunc (t @T) tag() int\nimpl @T : Tag[[8]uint8]\n"

// pkg/lib's .bn: T is a Tag[[4]uint8] only there, and the .bn names Out's and
// HW's instances for T first, extra after.
func viewLibBn(extra *[]readonly char) @[]char {
	return buf.Concat(
			"package \"pkg/lib\"\nfunc (t @T) tag() int { return t.n }\nimpl @T : Tag[[4]uint8]\n"
					"func own() int {\n\tvar h HW[@T, int64]\n\treturn Out[@T, int64, int32](make(T))\n}\n",
			extra)
}

// checkViewUser checks package q, whose .bn (after its import of pkg/lib) is
// body, against pkg/lib (viewLibBni with extraBni, viewLibBn with extraBn).
func checkViewUser(extraBni *[]readonly char, extraBn *[]readonly char,
		body *[]readonly char) @Checker {
	return checkBniMethodPkgIn(checkerWithLib(buf.Concat(viewLibBni, extraBni), viewLibBn(extraBn)),
			"package \"q\"\nfunc F() int\n", buf.Concat("package \"q\"\nimport \"pkg/lib\"\n", body), false)
}

// In an instance rooted in pkg/lib's .bn, T satisfies a constraint through lib's
// private impl: Out[@T, int64, int32] calls In[@T, int32], whose constraint is
// Tag[[4]uint8], and HW[@T, int64]'s field is a W[@T, int32].
func TestViewRootSeesRootPrivateImpl() testing.TestResult {
	var c @Checker = checkViewUser("", "", "func F() int { return 0 }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// In an instance q's .bn names, lib's private impl is not visible: In's
// constraint in Out[@lib.T, int64, int32], though lib's .bn named the same
// instance first and was accepted there.
func TestViewRootOtherRootFunc() testing.TestResult {
	var c @Checker = checkViewUser("", "",
			"func F() int { return lib.Out[@lib.T, int64, int32](make(lib.T)) }\n")
	return errsIn(c,
			"does not satisfy constraint Tag[[4]uint8]: the matching impl is private to package pkg/lib "
					"(in Out[@T, int64, int32], instantiated at q.bn:3:")
}

// So is the constraint of HW[@lib.T, int64]'s field, judged again for q's class
// of the instance's checks.
func TestViewRootOtherRootStruct() testing.TestResult {
	var c @Checker = checkViewUser("", "",
			"func F() int {\n\tvar h lib.HW[@lib.T, int64]\n\treturn 0\n}\n")
	return errsIn(c,
			"does not satisfy constraint Tag[[4]uint8]: the matching impl is private to package pkg/lib "
					"(in HW[@T, int64], instantiated at q.bn:4:")
}

// An instance carries its view root into the instances its check names: Mid's
// instance, rooted in lib's .bn, names Out's, which names In's, all in lib's
// .bni.  From q, the same chain is rejected.
func TestViewRootCarried() testing.TestResult {
	var mid *[]readonly char = "func Mid[V Tag[[sizeof(U)]uint8], U any, X any](v V) int { return Out["
			"V, U, X](v) }\n"
	var c @Checker = checkViewUser(mid,
			"func viaMid() int { return Mid[@T, int64, int32](make(T)) }\n", "func F() int { return 0 }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return errsIn(
			checkViewUser(mid, "", "func F() int { return lib.Mid[@lib.T, int64, int32](make(lib.T)) }\n"),
			"the matching impl is private to package pkg/lib (in Out[@T, int64, int32], instantiated at q.b"
					"n:3:")
}

// A naming written in a .bn of a package with a .bni carries that package as its
// view root, even inside an instance with none: G[int]'s arguments mention no
// receiver of lib's private impls, but Out's instance, named in G's body in lib's
// .bn, is rooted there.
func TestViewRootSiteRule() testing.TestResult {
	var c @Checker = checkViewUser("",
			"func G[Z any]() int { return Out[@T, int64, int32](make(T)) }\n"
					"func useG() int { return G[int]() }\n",
			"func F() int { return 0 }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A generic alias's target is as if written where the alias is used: KT[int64],
// used in lib's .bn, is K[@T, int64] written there, whose method's body is rooted
// in lib's .bn though the alias's arguments mention no receiver of lib's private
// impls.  Used in q, it is rejected.
func TestViewRootAliasTarget() testing.TestResult {
	var k *[]readonly char = "type K[V Tag[[sizeof(U)]uint8], U any] struct { v V }\n"
			"func (k *K[V, U]) call() int { return In[V, int32](k.v) }\ntype KT[U any] = K[@T, U]\n"
	var c @Checker = checkViewUser(k, "func useKT() int {\n\tvar k KT[int64]\n\treturn k.call()\n}\n",
			"func F() int { return 0 }\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return errsIn(
			checkViewUser(k, "", "func F() int {\n\tvar k lib.KT[int64]\n\treturn k.call()\n}\n"),
			"the matching impl is private to package pkg/lib (in K[@T, int64].call, instantiated at q.bn:4:")
}

// An instance whose type arguments mention no private impl's receiver has no
// view root, wherever it is named; one whose arguments mention q's private impl's
// receiver, named in q's .bn, has q.
func TestViewRootNormalized() testing.TestResult {
	var c @Checker = checkImplUser("", "",
			"type Q struct { v int }\nfunc (q @Q) dbl() int { return q.v }\nimpl @Q : lib.D\n"
					"func F() int {\n\tvar b lib.Box[int]\n\tvar h lib.H[@Q]\n\treturn 0\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var boxState @InstCheckState = instStateNamed(c, "Box")
	var h @InstCheckState = instStateNamed(c, "H")
	if boxState == nil || h == nil { return "expected the instances of Box and H" }
	if len(boxState.VRoot) != 0 || boxState.Next != nil {
		return "expected Box[int] to have no view root"
	}
	if !streq(h.VRoot, "q") { return "expected H[@Q] to have the view root q" }
	return ""
}

// instStateNamed returns the first check state of the concrete instance of the
// generic type named name, or nil.
func instStateNamed(c @Checker, name *[]readonly char) @InstCheckState {
	for i := 0; i < len(c.Generics.Instantiations); i++ {
		var e @GenericInstantiation = c.Generics.Instantiations[i]
		if e != nil && e.InstState != nil && streq(e.Decl.Name, name) { return e.InstState }
	}
	return nil
}

// A view inside an instance is keyed by its package's .bn (none for a .bni) and
// its view root, a derived check's apart.
func TestImplViewKeyRoots() testing.TestResult {
	var v ImplView
	v.Pkg = buf.CopyStr("pkg/lib")
	v.Inst = true
	if !streq(implViewKey(v), "*pkg/lib+") { return fail(implViewKey(v)) }
	v.VRoot = buf.CopyStr("q")
	if !streq(implViewKey(v), "*pkg/lib+q") { return fail(implViewKey(v)) }
	v.Bni = true
	if !streq(implViewKey(v), "*+q") { return fail(implViewKey(v)) }
	v.Derived = true
	if !streq(implViewKey(v), "*derived:+q") { return fail(implViewKey(v)) }
	return ""
}

// An impl private to a package's .bn is visible in an instance whose view root
// is that package, and not in one with another or none.
func TestImplVisibleViewRoot() testing.TestResult {
	var rec @Impl = make(Impl)
	rec.PrivatePkg = buf.CopyStr("q")
	var v ImplView
	v.Pkg = buf.CopyStr("pkg/lib")
	v.Bni = true
	v.Inst = true
	if implVisible(rec, v) { return "expected the impl hidden with no view root" }
	v.VRoot = buf.CopyStr("r")
	if implVisible(rec, v) { return "expected the impl hidden with the view root r" }
	v.VRoot = buf.CopyStr("q")
	if !implVisible(rec, v) { return "expected the impl visible with the view root q" }
	return ""
}

// Dropping impls drops the indexes of the private ones among them.
func TestTruncateImplsPrivate() testing.TestResult {
	var c @Checker = NewChecker()
	var pub @Impl = make(Impl)
	var priv @Impl = make(Impl)
	priv.PrivatePkg = buf.CopyStr("q")
	recordImpl(c, pub)
	recordImpl(c, priv)
	recordImpl(c, pub)
	recordImpl(c, priv)
	if len(c.PrivateImpls) != 2 || c.PrivateImpls[0] != 1 || c.PrivateImpls[1] != 3 {
		return "expected the private impls at 1 and 3"
	}
	truncateImpls(c, 3)
	if len(c.Impls) != 3 || len(c.PrivateImpls) != 1 { return "expected one private impl left" }
	truncateImpls(c, 1)
	if len(c.Impls) != 1 || len(c.PrivateImpls) != 0 { return "expected no private impl left" }
	return ""
}

// A receiver base is mentioned through pointers, slices, function types and an
// instance's type arguments, not through a named type's fields.
func TestPrivateImplServesThroughParts() testing.TestResult {
	var c @Checker = checkImplUser("", "",
			"type Q struct { v int }\nfunc (q @Q) dbl() int { return q.v }\nimpl @Q : lib.D\n"
					"func F() int {\n\tvar h lib.H[@Q]\n\treturn 0\n}\n")
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	if len(c.PrivateImpls) != 1 { return "expected one private impl" }
	var rec @Impl = c.Impls[c.PrivateImpls[0]]
	var q @types.Type = rec.RecvType
	var h @types.Type = instNamed(c, "H")
	if h == nil { return "expected H's instance" }
	var noParams @[]@types.Param
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.MakeSliceType(types.MakeFuncType(noParams, oneType(q)))
	if !privateImplServes(rec, args) { return "expected a slice of func() @Q to mention Q" }
	args[0] = types.MakePointerType(h)
	if !privateImplServes(rec, args) { return "expected *H[@Q] to mention Q" }
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = buf.CopyStr("q")
	fields[0].Type = q
	var s @types.Type = types.MakeNamedType(buf.CopyStr("q.S"))
	s.Underlying = types.MakeStructType(buf.CopyStr("q.S"), fields)
	args[0] = s
	if privateImplServes(rec, args) { return "expected S, holding a @Q, not to mention Q" }
	args[0] = types.TypInt()
	if privateImplServes(rec, args) { return "expected int not to mention Q" }
	return ""
}

// instNamed returns the concrete instance of the generic type named name, or nil.
func instNamed(c @Checker, name *[]readonly char) @types.Type {
	for i := 0; i < len(c.Generics.Instantiations); i++ {
		var e @GenericInstantiation = c.Generics.Instantiations[i]
		if e != nil && e.InstState != nil && streq(e.Decl.Name, name) { return e.Result }
	}
	return nil
}

// oneType returns a list holding t.
func oneType(t @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = t
	return ts
}
