package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/stdx/slices"

// Tests for the duplicate-same-short-name import check (registerImportsInto):
// two imports that resolve to the same short name but DIFFERENT paths collide
// (a qualifier `gen.X` would silently bind to one of them by import order), so
// one must be aliased.  And for the import-once check (checkImportsOnce, spec
// pkg.import.once): a file imports a package at most once, under any names.
// mkBniFile / toBytes / anyErrContains / msgContains live in sibling *_test.bn
// files (same package).

// checkMainImporting2 loads two package interfaces, then type-checks a main
// source that may import them.
func checkMainImporting2(aPath @[]char, aBni *[]readonly char, bPath @[]char, bBni *[]readonly char,
		mainSrc *[]readonly char) @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface(aPath, mkBniFile(aBni))
	c.LoadPackageInterface(bPath, mkBniFile(bBni))
	var p @parser.Parser = parser.New(toBytes(mainSrc), "test.bn")
	var file @ast.File = mustParse(p)
	c.Check(file)
	return c
}

// Two same-final-segment packages imported BOTH unaliased (both default to
// `gen`) is a collision and is rejected.
func TestDuplicateSameSegmentImportRejected() testing.TestResult {
	var c @Checker = checkMainImporting2(
			"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n", "pkg/bb/gen",
			"package \"pkg/bb/gen\"\nconst B int = 2\n",
			"package \"main\"\n"
					"import \"pkg/aa/gen\"\n"
					"import \"pkg/bb/gen\"\n"
					"func main() { }\n")
	if !anyErrContains(c, "`gen` names two imported packages (pkg/aa/gen and pkg/bb/gen)") {
		return fail("two same-segment unaliased imports (both `gen`) should be rejected")
	}
	return ""
}

// Aliasing one of the colliding imports resolves the clash -- distinct names,
// no error.
func TestDuplicateImportAliasedAccepted() testing.TestResult {
	var c @Checker = checkMainImporting2(
			"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n", "pkg/bb/gen",
			"package \"pkg/bb/gen\"\nconst B int = 2\n",
			"package \"main\"\n"
					"import \"pkg/aa/gen\"\n"
					"import gen2 \"pkg/bb/gen\"\n"
					"func main() { }\n")
	return expectNoErrors(c)
}

// checkMainImportingGen type-checks a main source that may import pkg/aa/gen.
func checkMainImportingGen(mainSrc *[]readonly char) @Checker {
	return checkMainImporting2("pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n",
			"pkg/bb/other", "package \"pkg/bb/other\"\nconst B int = 2\n", mainSrc)
}

// onceErrorsAt returns "" when c's errors are exactly the import-once error at
// line first and, unless it is 0, at line second, both in the file file, and
// otherwise how they differ.
func onceErrorsAt(c @Checker, file *[]readonly char, first int, second int) testing.TestResult {
	var errs @[]types.CheckError = c.CheckerErrors()
	var want int = 1
	if second != 0 { want = 2 }
	if len(errs) != want {
		return fail(buf.Concat("error count ", strconv.Itoa(len(errs))))
	}
	for i := 0; i < want; i++ {
		var line int = first
		if i == 1 { line = second }
		if errs[i].Pos.Line != line || !types.CharEq(errs[i].Pos.File, file) ||
				!msgContains(errs[i].Msg, "package pkg/aa/gen is imported more than once in this file") {
			return fail(buf.Concat("unexpected error: ", errs[i].Msg))
		}
	}
	return ""
}

// Importing the SAME package twice in one file is an error at the second import,
// whatever names the two bind: the same one, two different ones, or the blank
// identifier beside either.
func TestSamePathImportTwiceRejected() testing.TestResult {
	var pairs @[]@[]char = make_slice(@[]char, 6)
	pairs[0] = "import \"pkg/aa/gen\"\nimport \"pkg/aa/gen\"\n"
	pairs[1] = "import g \"pkg/aa/gen\"\nimport g \"pkg/aa/gen\"\n"
	pairs[2] = "import \"pkg/aa/gen\"\nimport g2 \"pkg/aa/gen\"\n"
	pairs[3] = "import _ \"pkg/aa/gen\"\nimport gen \"pkg/aa/gen\"\n"
	pairs[4] = "import \"pkg/aa/gen\"\nimport _ \"pkg/aa/gen\"\n"
	pairs[5] = "import _ \"pkg/aa/gen\"\nimport _ \"pkg/aa/gen\"\n"
	for i := 0; i < len(pairs); i++ {
		var c @Checker = checkMainImportingGen(
				buf.Concat(buf.Concat("package \"main\"\n", pairs[i]), "func main() { }\n"))
		var r testing.TestResult = onceErrorsAt(c, "test.bn", 3, 0)
		if len(r) > 0 { return fail(buf.Concat(buf.Concat(strconv.Itoa(i), ": "), r)) }
	}
	return ""
}

// In a group too, and each import after the first is reported.
func TestSamePathImportThriceGroupedRejected() testing.TestResult {
	var c @Checker = checkMainImportingGen(
			"package \"main\"\n"
					"import (\n"
					"\t\"pkg/aa/gen\"\n"
					"\tg2 \"pkg/aa/gen\"\n"
					"\t_ \"pkg/aa/gen\"\n"
					")\n"
					"func main() { }\n")
	return onceErrorsAt(c, "test.bn", 4, 5)
}

// mergeLikeLoader returns the merge of files as the loader makes it: their
// imports, a repeated (alias, path) once, so a repeat within one file is only on
// that file's own list; and their declarations.
func mergeLikeLoader(files @[]@ast.File) @ast.File {
	var merged @ast.File = make(ast.File)
	merged.PkgName = files[0].PkgName
	merged.Pos = files[0].Pos
	for i := 0; i < len(files); i++ {
		for j := 0; j < len(files[i].Imports); j++ {
			var imp @ast.ImportSpec = files[i].Imports[j]
			var seen bool = false
			for k := 0; k < len(merged.Imports); k++ {
				var had @ast.ImportSpec = merged.Imports[k]
				if types.CharEq(had.Alias, imp.Alias) && types.CharEq(had.Path, imp.Path) { seen = true }
			}
			if !seen { merged.Imports = slices.Append[@ast.ImportSpec](merged.Imports, imp) }
		}
		for j := 0; j < len(files[i].Decls); j++ {
			merged.Decls = slices.Append[@ast.Decl](merged.Decls, files[i].Decls[j])
		}
	}
	return merged
}

// twoFiles returns the files a.bn of aSrc and b.bn of bSrc.
func twoFiles(aSrc *[]readonly char, bSrc *[]readonly char) @[]@ast.File {
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = mustParse(parser.New(toBytes(aSrc), "a.bn"))
	files[1] = mustParse(parser.New(toBytes(bSrc), "b.bn"))
	return files
}

// checkerWithGen returns a checker with pkg/aa/gen loaded.
func checkerWithGen() @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/aa/gen", mkBniFile("package \"pkg/aa/gen\"\nconst A int = 1\n"))
	return c
}

// checkLibImporting checks package pkg/lib, whose files are aSrc (a.bn), bSrc
// (b.bn) and its interface bniSrc, on their merge (mergeLikeLoader), after
// loading pkg/aa/gen.
func checkLibImporting(aSrc *[]readonly char, bSrc *[]readonly char,
		bniSrc *[]readonly char) @Checker {
	var c @Checker = checkerWithGen()
	var files @[]@ast.File = twoFiles(aSrc, bSrc)
	var bni @ast.File = mkBniFile(bniSrc)
	c.LoadPackageInterface("pkg/lib", bni)
	c.CheckPackage("pkg/lib", mergeLikeLoader(files), files, bni)
	return c
}

// Each file of a package, its .bni among them, may import the same package,
// under a name of its own.
func TestSamePathImportedByEachFileAccepted() testing.TestResult {
	var c @Checker = checkLibImporting(
			"package \"pkg/lib\"\nimport q \"pkg/aa/gen\"\nfunc F() int { return q.A }\n",
			"package \"pkg/lib\"\nimport r \"pkg/aa/gen\"\nfunc G() int { return r.A }\n",
			"package \"pkg/lib\"\nimport _ \"pkg/aa/gen\"\n")
	return expectNoErrors(c)
}

// A repeat within one of a package's files is reported in that file, though the
// merged file holds the import once.
func TestSamePathImportTwiceInOneFileOfPackage() testing.TestResult {
	var c @Checker = checkLibImporting(
			"package \"pkg/lib\"\nimport \"pkg/aa/gen\"\nfunc F() int { return gen.A }\n",
			"package \"pkg/lib\"\nimport \"pkg/aa/gen\"\nimport \"pkg/aa/gen\"\n", "package \"pkg/lib\"\n")
	return onceErrorsAt(c, "b.bn", 3, 0)
}

// A package's .bni imports a package at most once too.
func TestSamePathImportTwiceInBni() testing.TestResult {
	var c @Checker = checkLibImporting("package \"pkg/lib\"\n", "package \"pkg/lib\"\n",
			"package \"pkg/lib\"\nimport \"pkg/aa/gen\"\nimport g \"pkg/aa/gen\"\n")
	return onceErrorsAt(c, "test.bni", 3, 0)
}

// Two blank imports (`import _ "..."`) of different paths are side-effect-only
// and legitimately repeatable -- not a collision.
func TestBlankImportsNotCollision() testing.TestResult {
	var c @Checker = checkMainImporting2(
			"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n", "pkg/bb/gen",
			"package \"pkg/bb/gen\"\nconst B int = 2\n",
			"package \"main\"\n"
					"import _ \"pkg/aa/gen\"\n"
					"import _ \"pkg/bb/gen\"\n"
					"func main() { }\n")
	return expectNoErrors(c)
}

// Two imports given the SAME explicit alias but different paths collide on that
// alias -- rejected, like the unaliased same-segment case.
func TestSameAliasDifferentPathsRejected() testing.TestResult {
	var c @Checker = checkMainImporting2(
			"pkg/aa/thing", "package \"pkg/aa/thing\"\nconst A int = 1\n", "pkg/bb/other",
			"package \"pkg/bb/other\"\nconst B int = 2\n",
			"package \"main\"\n"
					"import g \"pkg/aa/thing\"\n"
					"import g \"pkg/bb/other\"\n"
					"func main() { }\n")
	if !anyErrContains(c, "`g` names two imported packages (pkg/aa/thing and pkg/bb/other)") {
		return fail("two imports with the same alias `g` should be rejected")
	}
	return ""
}

// A package checked for its declarations alone, as a dependency, is not
// reported; it is when it is checked itself.
func TestSamePathImportTwiceNotReportedForDecls() testing.TestResult {
	var c @Checker = checkerWithGen()
	var files @[]@ast.File = twoFiles(
			"package \"pkg/lib\"\nimport \"pkg/aa/gen\"\nimport \"pkg/aa/gen\"\n", "package \"pkg/lib\"\n")
	c.CheckPackageDecls("pkg/lib", mergeLikeLoader(files), files, nil)
	return expectNoErrors(c)
}

// checkProgramImporting checks the main program of the files aSrc (a.bn) and
// bSrc (b.bn) on their merge (mergeLikeLoader), after loading pkg/aa/gen: with
// CheckProgramPersistent when persistent, else with CheckProgram.
func checkProgramImporting(aSrc *[]readonly char, bSrc *[]readonly char, persistent bool) @Checker {
	var c @Checker = checkerWithGen()
	var files @[]@ast.File = twoFiles(aSrc, bSrc)
	if persistent {
		c.CheckProgramPersistent(mergeLikeLoader(files), files)
	} else {
		c.CheckProgram(mergeLikeLoader(files), files)
	}
	return c
}

// A main program's files may each import a package, under a name of its own,
// though their merge holds it under both; a repeat within one of them is
// reported in that file, though the merge holds the import once.
func TestProgramImportsOncePerFile() testing.TestResult {
	for i := 0; i < 2; i++ {
		var persistent bool = i == 1
		var c @Checker = checkProgramImporting(
				"package \"main\"\nimport q \"pkg/aa/gen\"\nfunc main() { _ = q.A }\n",
				"package \"main\"\nimport r \"pkg/aa/gen\"\nfunc g() int { return r.A }\n", persistent)
		var r testing.TestResult = expectNoErrors(c)
		if len(r) > 0 { return fail(buf.Concat(buf.Concat("each file ", strconv.Itoa(i)), r)) }
		c = checkProgramImporting("package \"main\"\nimport \"pkg/aa/gen\"\nfunc main() { _ = gen.A }\n",
				"package \"main\"\nimport \"pkg/aa/gen\"\nimport \"pkg/aa/gen\"\n", persistent)
		r = onceErrorsAt(c, "b.bn", 3, 0)
		if len(r) > 0 { return fail(buf.Concat(buf.Concat("one file ", strconv.Itoa(i)), r)) }
	}
	return ""
}
