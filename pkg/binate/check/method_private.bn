package "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// A method only a package's .bn declares, when the package has a .bni, is
// private to that package's .bn (pkg.export): another package cannot select it —
// call it, take it as a method value or method expression, or bind it in an
// impl — and neither can the package's own .bni, whose generic bodies are
// monomorphized in importers and whose impls an importer reading only the .bni
// must be able to check (pkg.bni.self-contained).  Method.PrivatePkg names that
// package; the impls in the package's .bn may still bind the method.

// privateMethodPkg returns the current package's path when its method
// declaration d is private to its .bn: d is in a .bn, and the package's .bni
// declares no method of d's name on d's receiver base type; otherwise empty.
func privateMethodPkg(c @Checker, d @ast.Decl) @[]char {
	var none @[]char
	if c.PkgBni == nil || declaredInBni(d) || bniDeclaresMethod(c.PkgBni, d) { return none }
	return buf.CopyStr(c.curPkgPath)
}

// privateGenericMethodPkg returns pkg when the method d of a generic type,
// declared in package pkg, is private to pkg's .bn: a generic type's method is
// defined in the .bni or the .bn, never both (pkg.bni.generic.once), so one in a
// .bn of a package with a .bni is private; otherwise empty.
func privateGenericMethodPkg(c @Checker, pkg *[]readonly char, d @ast.Decl) @[]char {
	var none @[]char
	if declaredInBni(d) || !packageHasInterface(c, pkg) { return none }
	return buf.CopyStr(pkg)
}

// bniDeclaresMethod reports whether bni declares a method of d's name on d's
// receiver base type.
func bniDeclaresMethod(bni @ast.File, d @ast.Decl) bool {
	for i := 0; i < len(bni.Decls); i++ {
		var e @ast.Decl = bni.Decls[i]
		if e.Kind == ast.DECL_FUNC && e.Recv != nil && types.CharEq(e.Name, d.Name) &&
				types.CharEq(recvBaseName(e), recvBaseName(d)) {
			return true
		}
	}
	return false
}

// methodHiddenHere reports whether m may not be selected here: it is private to
// another package's .bn, or to this package's while c resolves in the package
// interface's view.
func methodHiddenHere(c @Checker, m @types.Method) bool {
	if m == nil || len(m.PrivatePkg) == 0 { return false }
	return !types.CharEq(m.PrivatePkg, c.curPkgPath) || inBniView(c)
}

// lookupVisibleMethod returns named's method name when it may be selected here
// (methodHiddenHere), or nil.  An instance the back-fill has not reached takes
// its generic's methods first (backfillMethodOnDemand); while the package's
// declarations are collected, one collection has not reached yet is defined
// first (batchMethodOnDemand).  One of its generic's methods an instance does
// not have yet, while they are copied onto it, makes a build the copy started
// wait for them (methodCopyReadWaits).
func lookupVisibleMethod(c @Checker, named @types.Type, name *[]readonly char) @types.Method {
	var m @types.Method = named.LookupMethod(name)
	if m == nil { m = backfillMethodOnDemand(c, named, name) }
	if m == nil { m = batchMethodOnDemand(c, named, name) }
	if m == nil { _ = methodCopyReadWaits(c, named, name) }
	if methodHiddenHere(c, m) { return nil }
	if m != nil { noteMethodUse(c, named, name) }
	return m
}

// lookupImplMethod returns named's method name for the impl rec, or nil when it
// is private to a package's .bn and rec is not one of that .bn's impls: another
// package's impl, or an impl in the package's .bni.
func lookupImplMethod(rec @Impl, named @types.Type, name *[]readonly char) @types.Method {
	var m @types.Method = named.LookupMethod(name)
	if m == nil || len(m.PrivatePkg) == 0 { return m }
	if rec.InBni || !types.CharEq(m.PrivatePkg, rec.Pkg) { return nil }
	return m
}
