package "pkg/binate/check"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for method_private.bn and the .bni view of opaque types.  checkerWithLib /
// checkBniMethodPkgIn / errsIn live in bni_view_test.bn and
// check_bni_methods_test.bn.

// pkg/lib's interface: T with Get exported, interface D, opaque O.
var privLibBni *[]readonly char =
	"package \"pkg/lib\"\ntype T struct { v int }\nfunc (t @T) Get() int\n"
			"interface D { dbl() int }\ntype O\nfunc MkO() @O\ntype Box[E any] struct { v E }\n"

// pkg/lib's implementation: T's private dbl, O's layout and private secret, Box's
// private peek.
var privLibBn *[]readonly char = "package \"pkg/lib\"\nfunc (t @T) Get() int { return t.dbl() }\n"
		"func (t @T) dbl() int { return t.v * 2 }\ntype O struct { w int }\n"
		"func MkO() @O { return make(O) }\nfunc (o @O) secret() int { return o.w }\n"
		"func (b @Box[E]) peek() E { return b.v }\n"

// checkUserOfLib checks package q, whose .bn (after its import of pkg/lib) is
// body, against pkg/lib with lib's interface extended by extraBni.
func checkUserOfLib(extraBni *[]readonly char, body *[]readonly char) @Checker {
	return checkBniMethodPkgIn(checkerWithLib(buf.Concat(privLibBni, extraBni), privLibBn),
			"package \"q\"\nfunc F() int\n", buf.Concat("package \"q\"\nimport \"pkg/lib\"\n", body), false)
}

// A method only a package's .bn declares cannot be selected from another
// package — called, taken as a method value or method expression, or have its
// address taken, on an opaque type too — while an exported one can.
func TestPrivateMethodHiddenFromImporters() testing.TestResult {
	var mk *[]readonly char = "func F() int {\n\tvar t @lib.T = make(lib.T)\n"
	var c @Checker = checkUserOfLib("", buf.Concat(mk, "\treturn t.Get()\n}\n"))
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	var r testing.TestResult = errsIn(checkUserOfLib("", buf.Concat(mk, "\treturn t.dbl()\n}\n")),
			"undefined: dbl")
	if len(r) > 0 { return r }
	r = errsIn(checkUserOfLib("", buf.Concat(mk, "\tf := t.dbl\n\treturn f()\n}\n")), "undefined: dbl")
	if len(r) > 0 { return r }
	r = errsIn(
			checkUserOfLib("",
					"func F() int {\n\tvar b @lib.Box[int] = make(lib.Box[int])\n\treturn b.peek()\n}\n"),
			"undefined: peek")
	if len(r) > 0 { return r }
	r = errsIn(checkUserOfLib("", "func F() int { return lib.MkO().secret() }\n"), "undefined: secret")
	if len(r) > 0 { return r }
	r = errsIn(checkUserOfLib("", buf.Concat(mk, "\tp := &t.dbl\n\treturn 0\n}\n")), "undefined: dbl")
	if len(r) > 0 { return r }
	return errsIn(checkUserOfLib("", "func F() int {\n\tf := lib.Box[int].peek\n\treturn 0\n}\n"),
			"undefined: peek")
}

// An impl in another package, or in the type's package's .bni, cannot bind a
// method private to that package's .bn; an impl in the .bn can.
func TestPrivateMethodImpls() testing.TestResult {
	var r testing.TestResult = errsIn(
			checkUserOfLib("", "func F() int { return 0 }\nimpl @lib.T : lib.D\n"), "missing method `dbl`")
	if len(r) > 0 { return r }
	r = errsIn(checkerWithLib(buf.Concat(privLibBni, "impl @T : D\n"), privLibBn),
			"missing method `dbl`")
	if len(r) > 0 { return r }
	var c @Checker = checkerWithLib(privLibBni, buf.Concat(privLibBn, "impl @T : D\n"))
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}

// A package's .bni sees its members as an importer does: its generic bodies
// cannot call a method private to the .bn or read a field of a type it declares
// opaque, and it cannot hold such a type by value or take its size.
func TestBniViewMembers() testing.TestResult {
	var r testing.TestResult = errsIn(
			checkUserOfLib("func Twice[E any](t @T) int { return t.dbl() }\n",
					"func F() int { return lib.Twice[int](make(lib.T)) }\n"), "undefined: dbl")
	if len(r) > 0 { return r }
	r = errsIn(
			checkUserOfLib("func (b @Box[E]) Peek() E { return b.peek() }\n",
					"func F() int {\n\tvar b @lib.Box[int] = make(lib.Box[int])\n\treturn b.Peek()\n}\n"),
			"undefined: peek")
	if len(r) > 0 { return r }
	r = errsIn(
			checkUserOfLib("func W[E any](o @O) int { return o.w }\n",
					"func F() int { return lib.W[int](lib.MkO()) }\n"), "cannot access field on this type")
	if len(r) > 0 { return r }
	r = errsIn(checkerWithLib(buf.Concat(privLibBni, "type S struct { o O }\n"), privLibBn),
			"cannot use an opaque type by value")
	if len(r) > 0 { return r }
	return errsIn(checkerWithLib(buf.Concat(privLibBni, "const Z uint = sizeof(O)\n"), privLibBn),
			"cannot take sizeof/alignof of an opaque type")
}

// A call through a type parameter's constraint calls the type argument's method
// through its impl, which may bind a method private to its package: the .bni's
// generic body, instantiated in the .bn with T, calls T's private dbl through D.
func TestPrivateMethodViaConstraint() testing.TestResult {
	var c @Checker = checkerWithLib(
			buf.Concat(privLibBni, "func TwiceD[X D](x X) int { return x.dbl() * 2 }\n"),
			buf.Concat(privLibBn, "impl @T : D\nfunc useD(t @T) int { return TwiceD[@T](t) }\n"))
	if len(c.CheckerErrors()) != 0 { return fail(c.CheckerErrors()[0].Msg) }
	return ""
}
