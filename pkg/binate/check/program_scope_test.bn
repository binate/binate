package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for a main program's file-scoped imports (CheckProgram, spec
// pkg.import.scope): each of the program's files resolves its qualifiers against
// its own imports, as a package's files do.  twoFiles / mergeLikeLoader live in
// import_dup_test.bn, mkBniFile in bni_scope_test.bn (same package).

// checkProgramOfTwo checks the main program of the files aSrc (a.bn) and bSrc
// (b.bn) with CheckProgram, after loading pkg/aa/gen, whose F returns an int, and
// pkg/bb/other, whose F returns a bool.
func checkProgramOfTwo(aSrc *[]readonly char, bSrc *[]readonly char) @Checker {
	return checkProgramFiles(twoFiles(aSrc, bSrc))
}

// checkProgramFiles checks the main program of the files files as
// checkProgramOfTwo does.
func checkProgramFiles(files @[]@ast.File) @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/aa/gen", mkBniFile("package \"pkg/aa/gen\"\nfunc F() int\n"))
	c.LoadPackageInterface("pkg/bb/other", mkBniFile("package \"pkg/bb/other\"\nfunc F() bool\n"))
	c.CheckProgram(mergeLikeLoader(files), files)
	return c
}

// programErrorAt returns "" when c's one error is at line line of the file file and
// holds msg, and otherwise how they differ, prefixed with what.
func programErrorAt(c @Checker, what *[]readonly char, file *[]readonly char, line int,
		msg *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 1 {
		return fail(buf.Concat(buf.Concat(what, ": error count "), strconv.Itoa(len(errs))))
	}
	if errs[0].Pos.Line != line || !types.CharEq(errs[0].Pos.File, file) ||
			!msgContains(errs[0].Msg, msg) {
		return fail(buf.Concat(buf.Concat(what, ": unexpected error: "), errs[0].Msg))
	}
	return ""
}

// A file may not use a package only another file of the program imports.
func TestProgramFileUsesAnotherFilesImportRejected() testing.TestResult {
	var c @Checker = checkProgramOfTwo(
			"package \"main\"\nimport \"pkg/aa/gen\"\nfunc main() { _ = gen.F() }\n",
			"package \"main\"\nfunc h() int { return gen.F() }\n")
	return programErrorAt(c, "cross-file use", "b.bn", 2, "undefined: gen")
}

// Two files may bind one name to different packages; each file's uses resolve
// to its own (a.bn's g.F is an int, b.bn's a bool).
func TestProgramFilesBindOneNameToTwoPackages() testing.TestResult {
	var c @Checker = checkProgramOfTwo(
			"package \"main\"\nimport g \"pkg/aa/gen\"\nfunc main() { var x int = g.F(); _ = x }\n",
			"package \"main\"\nimport g \"pkg/bb/other\"\nfunc h() bool { return g.F() }\n")
	return expectNoErrors(c)
}

// A generic function, and a generic type's method, declared in one file resolve
// their qualifiers against that file's imports, wherever they are instantiated:
// here in b.bn, which binds g to another package.
func TestProgramGenericResolvesInItsOwnFile() testing.TestResult {
	var c @Checker = checkProgramOfTwo(
			"package \"main\"\nimport g \"pkg/aa/gen\"\n"
					"func Get[T any](x T) int { return g.F() }\n"
					"type Cell[T any] struct { v T }\n"
					"func (b Cell[T]) N() int { return g.F() }\n"
					"func main() { }\n",
			"package \"main\"\nimport g \"pkg/bb/other\"\n"
					"func h() int { var cl Cell[bool]; return Get[int](1) + cl.N() }\n"
					"func k() bool { return g.F() }\n")
	return expectNoErrors(c)
}

// An import may not bind the name of a declaration in another file of the
// program; the one error is the import's, and the file sees the declaration.
func TestProgramImportConflictsWithOtherFilesDecl() testing.TestResult {
	var c @Checker = checkProgramOfTwo(
			"package \"main\"\nimport g \"pkg/aa/gen\"\nfunc main() { var x int = g(); _ = x }\n",
			"package \"main\"\nfunc g() int { return 1 }\n")
	return programErrorAt(c, "conflict", "a.bn", 2,
			"g: import alias conflicts with a declaration of the same name")
}

// The files of a program are told apart by name: a second file of the first's
// name is an error, not a file resolving against the first's imports.
func TestProgramFilesNamedAlike() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = mustParse(
			parser.New(toBytes("package \"main\"\nimport g \"pkg/aa/gen\"\nfunc main() { }\n"), "p.bn"))
	files[1] = mustParse(parser.New(toBytes("package \"main\"\nimport g \"pkg/bb/other\"\n"), "p.bn"))
	return programErrorAt(checkProgramFiles(files), "named alike", "p.bn", 1,
			"two source files are named p.bn")
}

// A file with no name beside named ones is an error, not a file resolving
// against no imports.
func TestProgramFileWithNoName() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = mustParse(parser.New(toBytes("package \"main\"\nfunc main() { }\n"), "a.bn"))
	files[1] = mustParse(parser.New(toBytes("package \"main\"\nimport \"pkg/aa/gen\"\n"), ""))
	return programErrorAt(checkProgramFiles(files), "no name", "", 1, "a source file has no name")
}
