package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// roOf, ptrOf, msliceOf, sliceOf and arrOf build `readonly T`, `*T`, `@[]T`,
// `*[]T` and `[2]T`.
func roOf(t @types.Type) @types.Type { return types.MakeReadonlyType(t) }

func ptrOf(t @types.Type) @types.Type { return types.MakePointerType(t) }

func msliceOf(t @types.Type) @types.Type { return types.MakeManagedSliceType(t) }

func sliceOf(t @types.Type) @types.Type { return types.MakeSliceType(t) }

func arrOf(t @types.Type) @types.Type { return types.MakeArrayType(t, 2) }

// Adding readonly below the outermost shared handle is assignable only when
// every level between the handle and the added readonly is readonly too.
func TestReadonlyAddBelowSharedHandle() testing.TestResult {
	var ch @types.Type = types.TypChar()
	var pc @types.Type = ptrOf(ch)
	if AssignableTo(msliceOf(pc), nil, msliceOf(ptrOf(roOf(ch)))) {
		return fail("@[]*char must not assign to @[]*readonly char")
	}
	if !AssignableTo(msliceOf(pc), nil, msliceOf(roOf(ptrOf(roOf(ch))))) {
		return fail("@[]*char must assign to @[]readonly *readonly char")
	}
	if AssignableTo(ptrOf(pc), nil, ptrOf(ptrOf(roOf(ch)))) {
		return fail("**char must not assign to **readonly char")
	}
	if !AssignableTo(ptrOf(pc), nil, ptrOf(roOf(ptrOf(roOf(ch))))) {
		return fail("**char must assign to *readonly *readonly char")
	}
	var ppc @types.Type = ptrOf(ptrOf(pc))
	if AssignableTo(ppc, nil, ptrOf(roOf(ptrOf(ptrOf(roOf(ch)))))) {
		return fail("***char must not assign to *readonly **readonly char (level 2 is writable)")
	}
	if !AssignableTo(ppc, nil, ptrOf(roOf(ptrOf(roOf(ptrOf(roOf(ch))))))) {
		return fail("***char must assign to *readonly *readonly *readonly char")
	}
	return ""
}

// Readonly added one level in, or below a by-value copy, is always assignable.
func TestReadonlyAddOneLevelOrByValue() testing.TestResult {
	var ch @types.Type = types.TypChar()
	if !AssignableTo(msliceOf(ch), nil, msliceOf(roOf(ch))) {
		return fail("@[]char must assign to @[]readonly char")
	}
	if !AssignableTo(ptrOf(ptrOf(ch)), nil, ptrOf(roOf(ptrOf(ch)))) {
		return fail("**char must assign to *readonly *char")
	}
	if !AssignableTo(arrOf(ptrOf(ch)), nil, arrOf(ptrOf(roOf(ch)))) {
		return fail("[2]*char must assign to [2]*readonly char (a copy)")
	}
	return ""
}

// An array's elements and an anonymous struct's fields share their container's
// level: behind a handle they are shared storage, and a by-value array of
// handles still shares what the handles reach.
func TestReadonlyAddThroughInlineStorage() testing.TestResult {
	var ch @types.Type = types.TypChar()
	var pc @types.Type = ptrOf(ch)
	if AssignableTo(ptrOf(arrOf(pc)), nil, ptrOf(arrOf(ptrOf(roOf(ch))))) {
		return fail("*([2]*char) must not assign to *([2]*readonly char)")
	}
	if !AssignableTo(ptrOf(arrOf(pc)), nil, ptrOf(roOf(arrOf(ptrOf(roOf(ch)))))) {
		return fail("*([2]*char) must assign to *(readonly [2]*readonly char)")
	}
	// Readonly elements do not guard the level: `*re = w` overwrites them whole.
	if AssignableTo(ptrOf(arrOf(pc)), nil, ptrOf(arrOf(roOf(ptrOf(roOf(ch)))))) {
		return fail("*([2]*char) must not assign to *([2]readonly *readonly char)")
	}
	var structs @types.Type = msliceOf(anonStruct1("p", pc))
	if AssignableTo(structs, nil, msliceOf(anonStruct1("p", roOf(ptrOf(roOf(ch)))))) {
		return fail("@[]struct{p *char} must not assign to @[]struct{p readonly *readonly char}")
	}
	if !AssignableTo(structs, nil, msliceOf(roOf(anonStruct1("p", ptrOf(roOf(ch)))))) {
		return fail("@[]struct{p *char} must assign to @[]readonly struct{p *readonly char}")
	}
	if AssignableTo(ptrOf(anonStruct1("p", pc)), nil, ptrOf(anonStruct1("p", ptrOf(roOf(ch))))) {
		return fail("*struct{p *char} must not assign to *struct{p *readonly char}")
	}
	if AssignableTo(arrOf(msliceOf(pc)), nil, arrOf(msliceOf(ptrOf(roOf(ch))))) {
		return fail("[2]@[]*char must not assign to [2]@[]*readonly char (the slices share slots)")
	}
	return ""
}

// The managed -> raw borrow shares the managed handle's storage.
func TestReadonlyAddBehindBorrow() testing.TestResult {
	var ch @types.Type = types.TypChar()
	var pc @types.Type = ptrOf(ch)
	if AssignableTo(msliceOf(pc), nil, sliceOf(ptrOf(roOf(ch)))) {
		return fail("@[]*char must not borrow as *[]*readonly char")
	}
	if !AssignableTo(msliceOf(pc), nil, sliceOf(roOf(ptrOf(roOf(ch))))) {
		return fail("@[]*char must borrow as *[]readonly *readonly char")
	}
	if AssignableTo(types.MakeManagedPtrType(pc), nil, ptrOf(ptrOf(roOf(ch)))) {
		return fail("@(*char) must not borrow as **readonly char")
	}
	return ""
}
