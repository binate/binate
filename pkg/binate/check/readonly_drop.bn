package "pkg/binate/check"

import "pkg/binate/types"

// Readonly as a capability: whether a conversion between two types that are
// identical modulo `readonly` would hand out write access through a handle the
// source only allowed to read.  Outermost readonly on a whole value is a copy's
// business and adjusts freely (§7.11 type.readonly.drop); readonly behind a
// pointer / slice / array handle, inside a function signature, or in an
// anonymous struct's field is part of the type.

// dropsConst reports whether src → dst would leak write capability
// by dropping const somewhere "behind a reference."
//
// Outermost const is NOT a capability concern — `const T → T` at the
// top level is a value copy (for any T, value or reference), and the
// original const handle is unaffected. So the outer layer is permissive.
//
// Const on an element type (inside a pointer / slice / array) IS a
// capability. Dropping it means a new handle could write to pointees
// that the original handle promised not to. Strict.
//
// Called only when src and dst are already known structurally
// compatible (per `Identical`).
func dropsConst(src @types.Type, dst @types.Type) bool {
	return readonlyBreaks(readonlyLoose, src, dst)
}

// peelOuterConstAndAlias strips outer TYP_READONLY and TYP_ALIAS
// wrappers from t. Helper for the string-target predicates and
// raw-slice-literal element check.
func peelOuterConstAndAlias(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// stripOuterConstAndAlias removes outer const and alias wrappers
// (but not element-level const). Helper for dropsConst.
func stripOuterConstAndAlias(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// dropsConstStrict is the element-position variant of dropsConst:
// const at any nested level counts as a capability promise, and
// dropping it is rejected.
func DropsConstStrict(src @types.Type, dst @types.Type) bool {
	return readonlyBreaks(readonlyStrict, src, dst)
}

// addsReadonlyBelowHandle reports whether src → dst, identical modulo readonly
// with none dropped, adds `readonly` at a level below the outermost shared
// handle without every level between that handle and the added one also being
// readonly in dst (§8.3 conv.readonly).  Such a conversion leaves a writable
// handle to storage the new handle holds as readonly: `@[]*char → @[]*readonly
// char` lets `b[0] = &lit[0]` store a `*readonly char` into a slot the source
// handle still reads as a writable `*char`.  `@[]*char → @[]readonly *readonly
// char` is safe (the new handle cannot write the slots), and adding readonly one
// level in (`*T → *readonly T`, `@[]T → @[]readonly T`) always is.
//
// Levels count from the value itself — level 0, a copy, whose readonly adjusts
// freely: crossing a pointer or slice handle moves one level down, while an
// array's elements and an anonymous struct's fields share their container's
// storage and stay on its level (so a by-value `[2]*char → [2]*readonly char` is
// a fresh copy, but the same retype behind a pointer is not).  A level is
// readonly only when its slot — the type directly behind the handle — is: a
// `[N]readonly T` or `struct{ f readonly T }` slot can still be overwritten as a
// whole value, so readonly elements or fields do not guard it.
func addsReadonlyBelowHandle(src @types.Type, dst @types.Type) bool {
	return addsReadonlyAt(src, dst, 0, true, false)
}

// addsReadonlyBehindBorrow is addsReadonlyBelowHandle for a managed → raw borrow
// (`@T → *T`, `@[]T → *[]T`) given the two element types: the borrow shares the
// managed handle's storage, so the elements are at level 1.
func addsReadonlyBehindBorrow(srcElem @types.Type, dstElem @types.Type) bool {
	return addsReadonlyAt(srcElem, dstElem, 1, true, isReadonlySlot(dstElem))
}

// isReadonlySlot reports whether a location of type t is readonly at its
// outermost level (types.Type.IsReadonly: through aliases and named types).
func isReadonlySlot(t @types.Type) bool {
	return t != nil && t.IsReadonly()
}

// signaturesMatchStrict reports whether two function signatures have the same
// parameter and result types with readonly significant everywhere except at each
// parameter's and result's outermost level.  (Lengths and variadic-ness are the
// caller's Identical check.)
func signaturesMatchStrict(a @types.Type, b @types.Type) bool {
	return !readonlyBreaks(readonlySigs, a, b)
}

// sigTypeIdenticalStrict compares a parameter or result type of two signatures:
// their outermost readonly is not part of the signature, everything inside is.
// A parameter or result that is itself a function type is compared by the same
// rule (its own parameters' outermost readonly left out), not by IdenticalStrict.
func sigTypeIdenticalStrict(a @types.Type, b @types.Type) bool {
	return !readonlyBreaks(readonlySigType, a, b)
}

// isBorrowDroppingReadonly reports whether ps -> pd (both peeled) is a managed ->
// raw borrow — `@T -> *T` or `@[]T -> *[]T` — whose element loses a `readonly`:
// legal for unsafe_cast, never for cast or an implicit borrow (§8.4).
func isBorrowDroppingReadonly(ps @types.Type, pd @types.Type) bool {
	return isBorrowOfSameElem(ps, pd) && DropsConstStrict(ps.Elem, pd.Elem)
}

// isBorrowAddingReadonly reports whether ps -> pd (both peeled) is a managed ->
// raw borrow whose element gains a `readonly` below the shared handle without
// every level between being readonly (addsReadonlyBehindBorrow): legal for
// unsafe_cast, never for cast or an implicit borrow.
func isBorrowAddingReadonly(ps @types.Type, pd @types.Type) bool {
	return isBorrowOfSameElem(ps, pd) && addsReadonlyBehindBorrow(ps.Elem, pd.Elem)
}

// isBorrowOfSameElem reports whether ps -> pd (both peeled) is a managed -> raw
// borrow (`@T -> *T`, `@[]T -> *[]T`) over elements identical modulo readonly.
func isBorrowOfSameElem(ps @types.Type, pd @types.Type) bool {
	var borrow bool = (ps.Kind == types.TYP_MANAGED_PTR && pd.Kind == types.TYP_POINTER) ||
			(ps.Kind == types.TYP_MANAGED_SLICE && pd.Kind == types.TYP_SLICE)
	return borrow && ps.Elem != nil && pd.Elem != nil && ps.Elem.Identical(pd.Elem)
}

// structFieldsDropReadonly reports whether a `cast` between two structs with the
// same fields modulo readonly (sameStructFields) drops a field's readonly behind
// a handle — the drop a field-by-field assignment would reject.  The struct is
// copied, so each field is a level-0 value (dropsConst).
func structFieldsDropReadonly(ps @types.Type, pd @types.Type) bool {
	if !isSameFieldsStructPair(ps, pd) { return false }
	for i := 0; i < len(ps.Fields); i++ {
		if dropsConst(ps.Fields[i].Type, pd.Fields[i].Type) { return true }
	}
	return false
}

// structFieldsAddReadonly is structFieldsDropReadonly for a field that gains
// readonly below a shared handle (addsReadonlyBelowHandle).
func structFieldsAddReadonly(ps @types.Type, pd @types.Type) bool {
	if !isSameFieldsStructPair(ps, pd) { return false }
	for i := 0; i < len(ps.Fields); i++ {
		if addsReadonlyBelowHandle(ps.Fields[i].Type, pd.Fields[i].Type) { return true }
	}
	return false
}

// isSameFieldsStructPair reports whether ps and pd (both peeled) are structs
// with the same fields modulo readonly.
func isSameFieldsStructPair(ps @types.Type, pd @types.Type) bool {
	return ps.Kind == types.TYP_STRUCT && pd.Kind == types.TYP_STRUCT && sameStructFields(ps, pd)
}
