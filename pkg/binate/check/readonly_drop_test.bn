package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// fnValue builds `*func(param) result` (a nil param or result omits it).
func fnValue(param @types.Type, result @types.Type) @types.Type {
	var params @[]@types.Param
	if param != nil {
		params = make_slice(@types.Param, 1)
		params[0] = make(types.Param)
		params[0].Name = "x"
		params[0].Type = param
	}
	var results @[]@types.Type
	if result != nil {
		results = make_slice(@types.Type, 1)
		results[0] = result
	}
	return types.MakeFuncValueType(params, results)
}

func roPtr(t @types.Type) @types.Type {
	return types.MakePointerType(types.MakeReadonlyType(t))
}

// A function value's element-level readonly is part of its type: changing it in
// a result or a parameter, in either direction, makes the types unassignable.
func TestFuncValueElementReadonlyIsSignificant() testing.TestResult {
	var p @types.Type = types.MakePointerType(types.TypInt())
	if AssignableTo(fnValue(nil, roPtr(types.TypInt())), nil, fnValue(nil, p)) {
		return fail("*func() *readonly int must not assign to *func() *int")
	}
	if AssignableTo(fnValue(nil, p), nil, fnValue(nil, roPtr(types.TypInt()))) {
		return fail("*func() *int must not assign to *func() *readonly int (identity, not variance)")
	}
	if AssignableTo(fnValue(roPtr(types.TypInt()), nil), nil, fnValue(p, nil)) {
		return fail("*func(*readonly int) must not assign to *func(*int)")
	}
	if !AssignableTo(fnValue(p, p), nil, fnValue(p, p)) {
		return fail("identical function values must assign")
	}
	return ""
}

// A parameter's OUTERMOST readonly is not part of the signature.
func TestFuncValueOuterParamReadonlyIgnored() testing.TestResult {
	var ri @types.Type = types.MakeReadonlyType(types.TypInt())
	if !AssignableTo(fnValue(ri, nil), nil, fnValue(types.TypInt(), nil)) ||
			!AssignableTo(fnValue(types.TypInt(), nil), nil, fnValue(ri, nil)) {
		return fail("*func(readonly int) and *func(int) must assign both ways")
	}
	return ""
}

// An anonymous struct copy may not lose readonly behind a field's handle; the
// field's own outermost readonly is a copy's and may change.
func TestAnonStructFieldReadonly() testing.TestResult {
	var src @types.Type = anonStruct1("q", roPtr(types.TypInt()))
	var dst @types.Type = anonStruct1("q", types.MakePointerType(types.TypInt()))
	if AssignableTo(src, nil, dst) {
		return fail("struct { q *readonly int } must not assign to struct { q *int }")
	}
	var roField @types.Type = anonStruct1("n", types.MakeReadonlyType(types.TypInt()))
	if !AssignableTo(roField, nil, anonStruct1("n", types.TypInt())) {
		return fail("struct { n readonly int } should copy into struct { n int }")
	}
	return ""
}

func anonStruct1(name @[]char, t @types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = name
	fields[0].Type = t
	return types.MakeStructType("", fields)
}
