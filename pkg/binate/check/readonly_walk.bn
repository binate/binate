package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/std/vec"

// The readonly walks (readonly_drop.bn) take the pairs of types they compare from a
// work list rather than recursing on them, so a pair nested to any depth -- a chain of
// pointers through aliases, a generic's instance -- is compared.  Each follows a chain
// of handles in place and pushes the pairs a struct's fields or a function signature
// hold; a walk answers whether any pair breaks its rule, so the order the pairs are
// looked at in does not change the answer.

// A readonlyPair is a pair of types the readonly walk compares, and the rule it holds
// them to (kind).
type readonlyPair struct {
	kind int
	src  @types.Type
	dst  @types.Type
}

// The rules a readonlyPair is held to, each broken when: src -> dst drops readonly
// behind a handle, at any level (DropsConstStrict) or below the outermost
// (dropsConst); two function signatures' parameter and result types differ
// (signaturesMatchStrict); a parameter or result type of two signatures differs
// (sigTypeIdenticalStrict).  The alike kinds are readonlySigs and readonlySigType for a
// pair inside two function types already found identical modulo readonly (Identical),
// which every pair inside them is too: Identical is not asked again of the function
// types inside them, which would walk each one's parts once per function type around it.
const (
	readonlyStrict int = iota
	readonlyLoose
	readonlySigs
	readonlySigType
	readonlyAlikeSigs
	readonlyAlikeSigType
)

// readonlyWork holds the pairs the readonly walk has still to look at, the next one
// last, kept from one walk to the next; a walk starts at its base and leaves the list
// as it found it, as typeWalk does.
var readonlyWork @vec.Vec[readonlyPair]

// readonlyBreaks reports whether src -> dst, or a pair of types inside them, breaks
// the readonly rule kind states.
func readonlyBreaks(kind int, src @types.Type, dst @types.Type) bool {
	if readonlyWork == nil { readonlyWork = vec.New[readonlyPair]() }
	var base int = readonlyWork.Len()
	var breaks bool = readonlyStep(kind, src, dst)
	for !breaks && readonlyWork.Len() > base {
		p, _ := readonlyWork.Pop()
		breaks = readonlyStep(p.kind, p.src, p.dst)
	}
	for readonlyWork.Len() > base {
		_, _ = readonlyWork.Pop()
	}
	return breaks
}

// pushReadonlyPair pushes src -> dst, held to kind, for the readonly walk to look at.
func pushReadonlyPair(kind int, src @types.Type, dst @types.Type) {
	var p readonlyPair
	p.kind = kind
	p.src = src
	p.dst = dst
	readonlyWork.Push(p)
}

// readonlyStep reports whether src -> dst itself breaks the rule kind states, following
// a chain of pointer, slice and array handles in place, and pushes the pairs inside a
// struct or a signature it reaches.  A type breaks no rule against itself, so a pair of
// one type is not walked: a type whose parts share types (`struct { a X; b X }`, X
// another such) would be walked once per path through it.
func readonlyStep(kind int, src @types.Type, dst @types.Type) bool {
	for {
		if same(src, dst) { return false }
		if kind == readonlySigs || kind == readonlyAlikeSigs {
			return sigsStep(src, dst, kind == readonlyAlikeSigs)
		}
		if kind == readonlySigType || kind == readonlyAlikeSigType {
			return sigTypeStep(src, dst, kind == readonlyAlikeSigType)
		}
		if kind == readonlyStrict {
			// Readonly at any level is a promise: dropping it at this one breaks it.
			for src != nil && src.Kind == types.TYP_ALIAS { src = src.Target }
			for dst != nil && dst.Kind == types.TYP_ALIAS { dst = dst.Target }
			if src == nil || dst == nil { return false }
			var srcC bool = src.Kind == types.TYP_READONLY
			var dstC bool = dst.Kind == types.TYP_READONLY
			if srcC && !dstC { return true }
			if srcC { src = src.Elem }
			if dstC { dst = dst.Elem }
			for src != nil && src.Kind == types.TYP_ALIAS { src = src.Target }
			for dst != nil && dst.Kind == types.TYP_ALIAS { dst = dst.Target }
			if src == nil || dst == nil { return false }
			if src.Kind != types.TYP_READONLY && dst.Kind == types.TYP_READONLY { return false }
		} else {
			// The outermost readonly is the holder's: a copy adjusts it freely.
			src = stripOuterConstAndAlias(src)
			dst = stripOuterConstAndAlias(dst)
			if src == nil || dst == nil { return false }
		}
		if src.Kind != dst.Kind { return false }
		var k int = src.Kind
		if k != types.TYP_POINTER && k != types.TYP_MANAGED_PTR && k != types.TYP_SLICE &&
				k != types.TYP_MANAGED_SLICE && k != types.TYP_ARRAY {
			return readonlyInsideStep(src, dst, kind == readonlyStrict)
		}
		// The elements are behind a handle: readonly there is part of the type.
		src = src.Elem
		dst = dst.Elem
		kind = readonlyStrict
	}
	return false
}

// readonlyInsideStep pushes, for two same-kind types identical modulo readonly, the
// pairs inside them whose readonly is part of the type: a function signature's
// parameter and result types, exact apart from each one's outermost readonly (§7.9
// type.func.kinds; §7.11 type.readonly.param-signature), in either direction; an
// anonymous struct's fields,
// which may not lose readonly behind a handle, nor -- when fieldsStrict, the struct
// itself behind a handle -- at their own outer level.  It reports false: what it pushes
// decides.
func readonlyInsideStep(src @types.Type, dst @types.Type, fieldsStrict bool) bool {
	if src.Kind == types.TYP_FUNC || src.Kind == types.TYP_FUNC_VALUE ||
			src.Kind == types.TYP_MANAGED_FUNC_VALUE {
		pushReadonlyPair(readonlySigs, src, dst)
		return false
	}
	if src.Kind != types.TYP_STRUCT || len(src.Name) > 0 || len(dst.Name) > 0 ||
			len(src.Fields) != len(dst.Fields) {
		return false
	}
	var fieldKind int = readonlyLoose
	if fieldsStrict { fieldKind = readonlyStrict }
	for i := len(src.Fields) - 1; i >= 0; i-- {
		pushReadonlyPair(fieldKind, src.Fields[i].Type, dst.Fields[i].Type)
	}
	return false
}

// sigsStep reports whether two function signatures differ in their parameters' or
// results' number, and pushes their parameter and result types to compare -- of
// signatures known identical modulo readonly when alike.
func sigsStep(a @types.Type, b @types.Type, alike bool) bool {
	if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
		return true
	}
	var kind int = readonlySigType
	if alike { kind = readonlyAlikeSigType }
	for i := len(a.Results) - 1; i >= 0; i-- {
		pushReadonlyPair(kind, a.Results[i], b.Results[i])
	}
	for i := len(a.Params) - 1; i >= 0; i-- {
		pushReadonlyPair(kind, a.Params[i].Type, b.Params[i].Type)
	}
	return false
}

// sigTypeStep reports whether a parameter or result type of two signatures differs:
// their outermost readonly is not part of the signature, everything inside is.  Two
// function types are compared by the same rule (their own parameters' outermost
// readonly left out), pushed, not by IdenticalStrict -- once found identical modulo
// readonly, which they are already known to be when alike.
func sigTypeStep(a @types.Type, b @types.Type, alike bool) bool {
	var pa @types.Type = peelOuterConstAndAlias(a)
	var pb @types.Type = peelOuterConstAndAlias(b)
	if pa == nil || pb == nil {
		return pa != nil || pb != nil
	}
	if pa.Kind == pb.Kind &&
			(pa.Kind == types.TYP_FUNC || pa.Kind == types.TYP_FUNC_VALUE ||
					pa.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		if !alike && !pa.Identical(pb) && !identicalDeferringDependent(pa, pb) { return true }
		pushReadonlyPair(readonlyAlikeSigs, pa, pb)
		return false
	}
	// A length that depends on a type parameter matches any length: each
	// instantiation's check compares it (identicalStrictDeferringDependent).
	return !pa.IdenticalStrict(pb) && !identicalStrictDeferringDependent(pa, pb)
}

// An addsFrame is a pair of types addsReadonlyAt compares, at level, with whether every
// level from 1 up to (not including) it is readonly in dst (guarded) and whether its
// slot is (slotRO).
type addsFrame struct {
	src     @types.Type
	dst     @types.Type
	level   int
	guarded bool
	slotRO  bool
}

// addsWork holds the frames addsReadonlyAt has still to look at, as readonlyWork does
// the readonly walk's pairs.
var addsWork @vec.Vec[addsFrame]

// addsReadonlyAt is addsReadonlyBelowHandle's walk, from src -> dst at level `level`:
// guarded reports whether every level from 1 up to (not including) this one is
// readonly in dst, and slotRO whether this level's slot is readonly in dst.  It
// follows a chain of handles and arrays in place and pushes an anonymous struct's
// fields.
func addsReadonlyAt(src @types.Type, dst @types.Type, level int, guarded bool, slotRO bool) bool {
	if addsWork == nil { addsWork = vec.New[addsFrame]() }
	var base int = addsWork.Len()
	var f addsFrame
	f.src = src
	f.dst = dst
	f.level = level
	f.guarded = guarded
	f.slotRO = slotRO
	var adds bool = addsReadonlyStep(f)
	for !adds && addsWork.Len() > base {
		g, _ := addsWork.Pop()
		adds = addsReadonlyStep(g)
	}
	for addsWork.Len() > base {
		_, _ = addsWork.Pop()
	}
	return adds
}

// addsReadonlyStep reports whether frame f's pair adds readonly where
// addsReadonlyBelowHandle forbids it, following handles and arrays in place and
// pushing the frames of an anonymous struct's fields.  A pair of one type adds none and
// is not walked (readonlyStep).
func addsReadonlyStep(f addsFrame) bool {
	for {
		if same(f.src, f.dst) { return false }
		var src @types.Type = f.src
		var dst @types.Type = f.dst
		if src != nil { src = src.ResolveAlias() }
		if dst != nil { dst = dst.ResolveAlias() }
		if src == nil || dst == nil { return false }
		var srcRO bool = src.Kind == types.TYP_READONLY
		var dstRO bool = dst.Kind == types.TYP_READONLY
		if dstRO && !srcRO && f.level >= 2 && !f.guarded { return true }
		src = peelOuterConstAndAlias(src)
		dst = peelOuterConstAndAlias(dst)
		if src == nil || dst == nil || src.Kind != dst.Kind { return false }
		if src.Kind == types.TYP_POINTER || src.Kind == types.TYP_MANAGED_PTR ||
				src.Kind == types.TYP_SLICE || src.Kind == types.TYP_MANAGED_SLICE {
			// The element is behind this handle, one level down.  Nothing lies between
			// the outermost handle and level 1.
			f.guarded = f.level == 0 || (f.guarded && f.slotRO)
			f.level = f.level + 1
			f.slotRO = isReadonlySlot(dst.Elem)
			f.src = src.Elem
			f.dst = dst.Elem
		} else if src.Kind == types.TYP_ARRAY {
			f.src = src.Elem
			f.dst = dst.Elem
		} else {
			if src.Kind != types.TYP_STRUCT || len(src.Name) > 0 || len(dst.Name) > 0 ||
					len(src.Fields) != len(dst.Fields) {
				return false
			}
			for i := len(src.Fields) - 1; i >= 0; i-- {
				var g addsFrame = f
				g.src = src.Fields[i].Type
				g.dst = dst.Fields[i].Type
				addsWork.Push(g)
			}
			return false
		}
	}
	return false
}
