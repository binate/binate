package "pkg/binate/check"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for readonly_walk.bn: the readonly walks compare pairs nested deepLevels deep,
// far deeper than a walk with one stack frame per level could go.

// A readonly dropped at the bottom of two pointer chains deepLevels deep is found, and
// so is one added there below handles that do not guard it; with the bottoms alike,
// neither is.
func TestDeepReadonlyDropAndAdd() testing.TestResult {
	var ro @types.Type = ptrChain(deepLevels, types.MakeReadonlyType(types.TypInt()))
	var rw @types.Type = ptrChain(deepLevels, types.TypInt())
	var rw2 @types.Type = ptrChain(deepLevels, types.TypInt())
	var drops bool = DropsConstStrict(ro, rw) && dropsConst(ro, rw)
	var adds bool = addsReadonlyBelowHandle(rw, ro)
	var neither bool = !DropsConstStrict(rw, rw2) && !dropsConst(rw, rw2) &&
			!addsReadonlyBelowHandle(rw, rw2)
	dropLinks(&ro, deepLevels)
	dropLinks(&rw, deepLevels)
	dropLinks(&rw2, deepLevels)
	if !drops { return fail("a readonly dropped under a deep pointer chain is found") }
	if !adds { return fail("a readonly added under a deep pointer chain is found") }
	if !neither { return fail("two alike deep pointer chains neither drop nor add readonly") }
	return ""
}

// funcChain returns n function types over leaf, each taking the one below as its
// parameter: func(func(... func(leaf))).
func funcChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		var ps @[]@types.Param = make_slice(@types.Param, 1)
		ps[0] = make(types.Param)
		ps[0].Name = "x"
		ps[0].Type = t
		var none @[]@types.Type
		t = types.MakeFuncType(ps, none)
	}
	return t
}

// dropFuncLinks releases the top n links of the function chain *p, one at a time.
func dropFuncLinks(p *@types.Type, n int) {
	for i := 0; i < n; i++ {
		*p = (*p).Params[0].Type
	}
}

// Two signatures nested deepLevels deep match when their innermost parameter types do,
// and not when that one's pointee differs in readonly.
func TestDeepSignaturesMatchStrict() testing.TestResult {
	var a @types.Type = funcChain(deepLevels, types.MakePointerType(types.TypInt()))
	var b @types.Type = funcChain(deepLevels, types.MakePointerType(types.TypInt()))
	var c @types.Type = funcChain(deepLevels,
			types.MakePointerType(types.MakeReadonlyType(types.TypInt())))
	var alike bool = signaturesMatchStrict(a, b)
	var differ bool = !signaturesMatchStrict(a, c)
	dropFuncLinks(&a, deepLevels)
	dropFuncLinks(&b, deepLevels)
	dropFuncLinks(&c, deepLevels)
	if !alike { return fail("deep signatures alike to the bottom match") }
	if !differ { return fail("deep signatures differing in readonly at the bottom do not match") }
	return ""
}

// twoFields returns struct { a x; b x }.
func twoFields(x @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Name = "a"
	fs[0].Type = x
	fs[1] = make(types.Field)
	fs[1].Name = "b"
	fs[1].Type = x
	return types.MakeStructType("", fs)
}

// sharedParts returns two distinct structs of two fields of type X(n), where X(0) is
// *int and X(i) is struct { a X(i-1); b X(i-1) }: types whose parts share types, with
// 2^n paths through them.
func sharedParts(n int) (@types.Type, @types.Type) {
	var x @types.Type = types.MakePointerType(types.TypInt())
	for i := 0; i < n; i++ {
		x = twoFields(x)
	}
	return twoFields(x), twoFields(x)
}

// Two distinct types sharing their parts, with 2^64 paths through them, are compared
// pair by pair only down to the pairs of one type, which drop and add no readonly.
func TestReadonlyWalkSharedParts() testing.TestResult {
	a, b := sharedParts(64)
	if DropsConstStrict(a, b) || dropsConst(a, b) || addsReadonlyBelowHandle(a, b) {
		return fail("types sharing their parts drop or add no readonly")
	}
	return ""
}
