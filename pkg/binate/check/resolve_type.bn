package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Type Resolution
// ============================================================
//
// Converts AST type expressions (`ast.TypeExpr`) into resolved
// `Type` values. Used by the checker (decl/expr/stmt) to bind
// source-level type syntax to the package's symbol scope.

// resolveTypeExpr resolves an AST type expression into a Type.
//
// Interface names: bare `Iface` is not a usable type expression.
// Only `*Iface` / `@Iface`
// are usable forms, which lower to TYP_INTERFACE_VALUE /
// TYP_INTERFACE_VALUE_MANAGED here. The `*X` / `@X` cases use
// resolveTypeExprAllowInterface for the base so an interface
// symbol resolves to its TYP_INTERFACE; if the base is anything
// else, regular pointer / managed-pointer behavior. Bare
// interface names hitting the TEXPR_NAMED arm produce an error
// pointing the user toward the `*` / `@` forms.
func resolveTypeExpr(c @Checker, te @ast.TypeExpr) @types.Type {
	if te == nil {
		return types.TypVoid()
	}

	if te.Kind == ast.TEXPR_NAMED {
		var t @types.Type = resolveNamedTypeExpr(c, te)
		if t != nil && t.Kind == types.TYP_INTERFACE {
			errInterfaceNotAType(c, te.Pos, te.Name)
			return types.TypError()
		}
		return t
	}
	// A type built on a component whose error is already reported is that
	// error, not `*<error>` / `@[]<error>` / …, so its uses report nothing more.
	if te.Kind == ast.TEXPR_POINTER {
		var base @types.Type = resolveTypeExprAllowInterface(c, te.Base)
		if isErrType(base) { return types.TypError() }
		if base != nil && base.Kind == types.TYP_INTERFACE {
			return types.MakeInterfaceValueType(base)
		}
		return types.MakePointerType(base)
	}
	if te.Kind == ast.TEXPR_MANAGED {
		var base @types.Type = resolveTypeExprAllowInterface(c, te.Base)
		if isErrType(base) { return types.TypError() }
		if base != nil && base.Kind == types.TYP_INTERFACE {
			return types.MakeManagedInterfaceValueType(base)
		}
		return types.MakeManagedPtrType(base)
	}
	if te.Kind == ast.TEXPR_MANAGED_SLICE {
		var elem @types.Type = resolveTypeExpr(c, te.Base)
		if isErrType(elem) { return types.TypError() }
		return types.MakeManagedSliceType(elem)
	}
	if te.Kind == ast.TEXPR_SLICE {
		var elem @types.Type = resolveTypeExpr(c, te.Base)
		if isErrType(elem) { return types.TypError() }
		return types.MakeSliceType(elem)
	}
	if te.Kind == ast.TEXPR_ARRAY {
		// `[...]T` is an inferred-length array, valid ONLY as a composite-literal
		// head (where checkCompositeLit folds the length from the elements).  In
		// any other type position — a var / param / field / return type — there
		// is no element list to infer from, so reject it here.  (The literal-head
		// path never calls resolveTypeExpr on the `[...]` node; it resolves the
		// element type and infers the length directly.)
		if te.LenInferred {
			addCheckError(c, te.Pos, "[...] array length is only valid in a composite literal")
			// Return the error sentinel (not a [0]T placeholder) so the
			// surrounding context — e.g. a `var a [...]int = [...]int{…}` whose
			// initializer resolves to a real [N]int — does not pile a follow-on
			// "cannot assign" onto the primary diagnostic.
			return types.TypError()
		}
		var length int
		var known bool
		var dependent bool
		length, known, dependent = evalArrayLen(c, te.Len)
		// Stamp the resolved length on the AST node so IR-gen reads the
		// checker's value instead of re-folding `Len` against its own const
		// table (which a use site can outrun, folding the dim to a garbage
		// size — see TypeExpr.LenVal in ast.bni).  Only a known length is
		// stamped: a dimension not known yet (pass 1, before a const's value
		// is recorded) is re-resolved later, and one that depends on a type
		// parameter is stamped on each instance's checked copy, resolved with
		// the type arguments bound (gen.mono.check).
		if known {
			te.LenVal = length
			te.LenKnown = true
		}
		var arrElem @types.Type = resolveTypeExpr(c, te.Base)
		if isErrType(arrElem) { return types.TypError() }
		var at @types.Type = types.MakeArrayType(arrElem, length)
		at.ArrayLenDependent = dependent
		return at
	}
	if te.Kind == ast.TEXPR_STRUCT {
		return resolveStructType(c, te)
	}
	if te.Kind == ast.TEXPR_PAREN {
		return resolveTypeExpr(c, te.Base)
	}
	if te.Kind == ast.TEXPR_CONST {
		var inner @types.Type = resolveTypeExpr(c, te.Base)
		if isErrType(inner) { return types.TypError() }
		return types.MakeReadonlyType(inner)
	}
	if te.Kind == ast.TEXPR_FUNC_VALUE {
		return resolveFuncValueType(c, te, false)
	}
	if te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		return resolveFuncValueType(c, te, true)
	}
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// A generic interface's instance is an interface, which is not a type
		// (iface.value.spelling): only its interface value `*G[T]` / `@G[T]` is,
		// built by the TEXPR_POINTER / TEXPR_MANAGED arms above.
		var inst @types.Type = resolveTypeInstantiation(c, te)
		if inst != nil && inst.Kind == types.TYP_INTERFACE && te.Base != nil {
			errInterfaceNotAType(c, te.Base.Pos, te.Base.Name)
			return types.TypError()
		}
		return inst
	}
	if te.Kind == ast.TEXPR_SELF {
		// `Self` is valid only while we're resolving an interface
		// method's argument / result types.  AllowSelf is set
		// transiently by collectInterfaceDecl around that call;
		// everywhere else, surface a clean error.  Return TypSelf()
		// either way so downstream checks see a consistent shape
		// (impl-collection's substituteSelf will replace it).
		if !c.AllowSelf {
			addCheckError(c, te.Pos, "`Self` is only valid inside interface method signatures")
		}
		return types.TypSelf()
	}
	addCheckError(c, te.Pos, "invalid type expression")
	return types.TypError()
}

// resolveFuncValueType converts a TEXPR_FUNC_VALUE / TEXPR_MANAGED_FUNC_VALUE
// AST node into the corresponding TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE
// Type. Parameters in the source are anonymous (types only); we still
// build Param structs for them with empty names so downstream code
// (signature comparison, vtable type generation) can treat them
// uniformly with named parameters from regular function declarations.
func resolveFuncValueType(c @Checker, te @ast.TypeExpr, managed bool) @types.Type {
	var params @[]@types.Param
	for i := 0; i < len(te.ParamTypes); i++ {
		var typ @types.Type = resolveTypeExpr(c, te.ParamTypes[i])
		var p @types.Param = make(types.Param)
		if te.VariadicParams && i == len(te.ParamTypes) - 1 {
			// Variadic final param of `*func(...T)`: in-body type is *[]T
			// (func.variadic.identity); te.ParamTypes[i] is the element T.
			p.Type = types.MakeSliceType(typ)
			p.IsVariadic = true
		} else {
			p.Type = typ
		}
		params = slices.Append[@types.Param](params, p)
	}
	var results @[]@types.Type
	for i := 0; i < len(te.ResultTypes); i++ {
		var typ @types.Type = resolveTypeExpr(c, te.ResultTypes[i])
		results = slices.Append[@types.Type](results, typ)
	}
	if sigHasErrType(params, results) {
		return types.TypError()
	}
	if managed {
		return types.MakeManagedFuncValueType(params, results)
	}
	return types.MakeFuncValueType(params, results)
}

// resolveNamedTypeExpr resolves a named type reference, including
// qualified (pkg.Type) names. Accepts SYM_TYPE and SYM_INTERFACE
// symbols — for SYM_INTERFACE, returns the TYP_INTERFACE Type. The
// caller is responsible for either (a) wrapping in `*` / `@` to
// produce an interface-value type, or (b) reporting that bare
// interface names aren't usable as type expressions. resolveTypeExpr
// does (b); resolveTypeExprAllowInterface does (a).
func resolveNamedTypeExpr(c @Checker, te @ast.TypeExpr) @types.Type {
	if len(te.Pkg) > 0 {
		// Qualified type: pkg.Type
		var sym @Symbol = c.Scope.Lookup(te.Pkg)
		if sym == nil || sym.Kind != types.SYM_PKG {
			errUndefined(c, te.Pos, te.Pkg)
			return types.TypError()
		}
		var pkgScope @Scope = lookupPackage(c, sym.PkgPath)
		if pkgScope == nil {
			errUndefined(c, te.Pos, te.Pkg)
			return types.TypError()
		}
		var member @Symbol = pkgScope.Lookup(te.Name)
		if member == nil {
			errNoMember(c, te.Pos, te.Name)
			return types.TypError()
		}
		if member.IsGeneric {
			// A bare reference to an exposed generic marker (`fwd.Box` with no
			// type arguments) is not a usable type, exactly as a bare `glib.Box`
			// is rejected — the marker exists only to carry the home package.
			addCheckError(c, te.Pos, "generic type used without type arguments")
			return types.TypError()
		}
		return member.Type
	}
	// An alias of this batch named before its declaration resolves now.
	if !resolvePendingAliasNamed(c, te) {
		return types.TypVoid()
	}
	var sym @Symbol = c.Scope.Lookup(te.Name)
	if sym == nil {
		errUndefined(c, te.Pos, te.Name)
		return types.TypError()
	}
	if sym.IsGeneric {
		// A bare reference to an exposed generic marker (no type arguments) is not
		// a usable type — reject rather than returning its nil placeholder Type.
		addCheckError(c, te.Pos, "generic type used without type arguments")
		return types.TypError()
	}
	if sym.Kind != types.SYM_TYPE && sym.Kind != types.SYM_INTERFACE {
		errNotAType(c, te.Pos, te.Name)
		return types.TypError()
	}
	return sym.Type
}

// resolveTypeExprAllowInterface resolves a type expression in the
// "base of `*X` / `@X`" position, where a bare interface name, or a
// generic interface's instance, is a valid base (it lowers to
// TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED at the caller).
// For non-interface bases this is identical to resolveTypeExpr.
func resolveTypeExprAllowInterface(c @Checker, te @ast.TypeExpr) @types.Type {
	if te != nil && te.Kind == ast.TEXPR_NAMED {
		return resolveNamedTypeExpr(c, te)
	}
	if te != nil && te.Kind == ast.TEXPR_INSTANTIATE {
		return resolveTypeInstantiation(c, te)
	}
	return resolveTypeExpr(c, te)
}

// resolveStructType resolves a struct type expression, building the field list.
func resolveStructType(c @Checker, te @ast.TypeExpr) @types.Type {
	checkStructFieldNamesDistinct(c, te)
	var fields @[]@types.Field
	for i := 0; i < len(te.Fields); i++ {
		var fd @ast.FieldDecl = te.Fields[i]
		var typ @types.Type = resolveTypeExpr(c, fd.Type)
		var f @types.Field = make(types.Field)
		f.Name = fd.Name
		f.Type = typ
		fields = slices.Append[@types.Field](fields, f)
	}
	return types.MakeStructType("", fields)
}

// checkStructFieldNamesDistinct reports a field name declared twice in the
// struct type expression te.  A blank `_` field is unnamed padding and an
// embedded field (a bare type) carries no name, so any number of either may
// appear.  Syntactic, so it also runs on a generic struct's body before any
// instantiation resolves it (preRegisterTypeNames).
func checkStructFieldNamesDistinct(c @Checker, te @ast.TypeExpr) {
	for i := 0; i < len(te.Fields); i++ {
		var name @[]char = te.Fields[i].Name
		if len(name) == 0 || isBlank(name) {
			continue
		}
		for j := 0; j < i; j++ {
			if types.CharEq(te.Fields[j].Name, name) {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("duplicate field name ")
				cb.Write(name)
				cb.Write(" in struct")
				addCheckError(c, te.Fields[i].Pos, buf.CopyStr(cb.String()))
				break
			}
		}
	}
}

// resolveFuncDeclType resolves a function declaration's parameter and
// return types into a func type.  When d carries a generic
// type-parameter list, installs a per-decl scope with the type-params
// as SYM_TYPE entries before resolving signatures, so references to
// `T` in param / result type expressions resolve correctly; the
// resulting FUNC type's TypeParams field carries the @[]@types.Type for
// the body-check pass to re-install.
func resolveFuncDeclType(c @Checker, d @ast.Decl) @types.Type {
	var pushedTpScope bool = false
	var tpTypes @[]@types.Type
	if len(d.TypeParams) > 0 {
		pushScope(c)
		pushedTpScope = true
		tpTypes = installTypeParamScope(c, d)
	}
	// Check for duplicate parameter names.  A blank `_` parameter binds
	// nothing, so any number of parameters may be `_`.
	for i := 0; i < len(d.Params); i++ {
		if isBlank(d.Params[i].Name) {
			continue
		}
		for j := 0; j < i; j++ {
			if types.CharEq(d.Params[i].Name, d.Params[j].Name) {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("duplicate parameter name: ")
				cb.Write(d.Params[i].Name)
				addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
			}
		}
	}
	var params @[]@types.Param
	for i := 0; i < len(d.Params); i++ {
		var pd @ast.ParamDecl = d.Params[i]
		var typ @types.Type = resolveTypeExpr(c, pd.Type)
		var p @types.Param = make(types.Param)
		p.Name = pd.Name
		if pd.Variadic {
			// A variadic parameter's in-body type is the raw slice *[]T
			// (func.variadic.decl); pd.Type is the element type T.  Any
			// element-`readonly` is already in the resolved element type — do
			// not re-wrap.
			p.Type = types.MakeSliceType(typ)
			p.IsVariadic = true
		} else {
			p.Type = typ
		}
		params = slices.Append[@types.Param](params, p)
	}
	var results @[]@types.Type
	for i := 0; i < len(d.Results); i++ {
		var rt @types.Type = resolveTypeExpr(c, d.Results[i])
		results = slices.Append[@types.Type](results, rt)
	}
	var ft @types.Type = types.MakeFuncType(params, results)
	if pushedTpScope {
		ft.TypeParams = tpTypes
		popScope(c)
	}
	return ft
}

// installTypeParamScope defines each of d's type-parameters as a
// SYM_TYPE entry in the current scope (which should be a fresh
// scope pushed by the caller).  Returns the @[]@types.Type of the
// constructed TYP_TYPE_PARAM types for the caller to attach to
// the resulting FUNC type — these same @types.Type instances are
// re-installed during body checking so identity comparison
// (Q3) is stable.
//
// Constraint resolution: `any` (the bare unconstrained marker)
// stores nil in TpConstraint; any other shape must resolve to a
// declared interface (TYP_INTERFACE) and is stored on
// TpConstraint for the satisfaction check and constraint-
// method dispatch.
func installTypeParamScope(c @Checker, d @ast.Decl) @[]@types.Type {
	checkTypeParamNamesDistinct(c, d)
	var tpTypes @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		var tp @ast.TypeParam = d.TypeParams[i]
		var constraint @types.Type = resolveTypeParamConstraint(c, tp)
		var tparam @types.Type = MakeTypeParamType(tp.Name, bit_cast(*uint8, d), i, constraint)
		// A blank `_` parameter names nothing.
		if !isBlank(tp.Name) {
			defineType(c.Scope, tp.Name, tparam)
		}
		tpTypes = slices.Append[@types.Type](tpTypes, tparam)
	}
	return tpTypes
}

// checkTypeParamNamesDistinct reports a name declared twice in d's
// type-parameter list (a generic function, type or interface): the parameters
// are fresh names, one per position.  A blank `_` names nothing, so any number
// of parameters may be `_`.
func checkTypeParamNamesDistinct(c @Checker, d @ast.Decl) {
	for i := 0; i < len(d.TypeParams); i++ {
		var name @[]char = d.TypeParams[i].Name
		if isBlank(name) {
			continue
		}
		for j := 0; j < i; j++ {
			if types.CharEq(d.TypeParams[j].Name, name) {
				var b @strings.Builder = strings.NewBuilder()
				b.Write("type parameter name ")
				b.Write(name)
				b.Write(" declared more than once")
				addCheckError(c, d.TypeParams[i].Pos, buf.CopyStr(b.String()))
				break
			}
		}
	}
}

// resolveTypeParamConstraint resolves a parsed constraint
// TypeExpr to nil (for the universe `any`) or to a TYP_INTERFACE @types.Type.
// The constraint is resolved like any other type name, so a package's own
// `any` (an interface, or a non-interface type — then an error) shadows the
// universe one.  Anything else surfaces a clean error and returns nil so the
// rest of the decl still type-checks.
func resolveTypeParamConstraint(c @Checker, tp @ast.TypeParam) @types.Type {
	if tp.Constraint == nil {
		addCheckError(c, tp.Pos, "type parameter must have a constraint (use `any` for none)")
		return nil
	}
	var t @types.Type = resolveTypeExprAllowInterface(c, tp.Constraint)
	if t == nil || t.Kind == types.TYP_VOID || isErrType(t) || isUniverseAny(t) {
		return nil
	}
	if t.Kind != types.TYP_INTERFACE {
		addCheckError(c, tp.Pos, "constraint must be `any` or an interface name")
		return nil
	}
	return t
}
