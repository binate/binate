package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// Named type references: a type or an interface named by an identifier, or by
// a package-qualified `pkg.T`.

// resolveNamedTypeExpr resolves a named type reference, including
// qualified (pkg.Type) names. Accepts SYM_TYPE and SYM_INTERFACE
// symbols — for SYM_INTERFACE, returns the TYP_INTERFACE Type. The
// caller is responsible for either (a) wrapping in `*` / `@` to
// produce an interface-value type, or (b) reporting that bare
// interface names aren't usable as type expressions. resolveTypeExpr
// does (b); resolveTypeExprAllowInterface does (a).
func resolveNamedTypeExpr(c @Checker, te @ast.TypeExpr) @types.Type {
	if len(te.Pkg) > 0 {
		// Qualified type: pkg.Type
		var sym @Symbol = c.Scope.Lookup(te.Pkg)
		if sym == nil || sym.Kind != types.SYM_PKG {
			errUndefined(c, te.Pos, te.Pkg)
			return types.TypError()
		}
		var pkgScope @Scope = lookupPackage(c, sym.PkgPath)
		if pkgScope == nil {
			errUndefined(c, te.Pos, te.Pkg)
			return types.TypError()
		}
		var member @Symbol = pkgScope.Lookup(te.Name)
		if member == nil {
			errNoMember(c, te.Pos, te.Name)
			return types.TypError()
		}
		if member.IsGeneric {
			// A bare reference to an exposed generic marker (`fwd.Box` with no
			// type arguments) is not a usable type, exactly as a bare `glib.Box`
			// is rejected — the marker exists only to carry the home package.
			addCheckError(c, te.Pos, "generic type used without type arguments")
			return types.TypError()
		}
		return member.Type
	}
	return resolveTypeName(c, te.Name, te.Pos)
}

// resolveTypeName resolves the unqualified type name name, written at pos, in
// the current scope, for a type expression's name and for a type argument
// written as an identifier: a type's type, or an interface's TYP_INTERFACE (as
// resolveNamedTypeExpr gives it).  An alias of this batch named before its
// declaration resolves now (resolvePendingAliasNamed; void after a reported
// cycle).  A generic type's bare name, an undefined name and a name of no type
// are errors.
func resolveTypeName(c @Checker, name *[]readonly char, pos token.Pos) @types.Type {
	if !resolvePendingAliasNamed(c, name, pos) {
		return types.TypVoid()
	}
	var sym @Symbol = c.Scope.Lookup(name)
	if sym == nil {
		errUndefined(c, pos, name)
		return types.TypError()
	}
	if isGenericTypePlaceholder(c, sym) {
		// A bare reference to the placeholder a generic type declared here registers
		// under its name is not a usable type: an instantiation writes its type
		// arguments (gen.instantiate) — reject rather than return the placeholder,
		// which has no underlying.
		addCheckError(c, pos, "generic type used without type arguments")
		return types.TypError()
	}
	if sym.Kind != types.SYM_TYPE && sym.Kind != types.SYM_INTERFACE {
		errNotAType(c, pos, name)
		return types.TypError()
	}
	return sym.Type
}

// isGenericTypePlaceholder reports whether sym is the placeholder a generic type
// declaration registers under its bare name so its instantiations can name it: a
// named type of that same name with no underlying, declared (by its package and
// name) with type parameters.  A type parameter of the same name, bound to an
// argument with no underlying yet (an instantiation in progress, a type not yet
// collected), is not: its type carries the argument's own name.
func isGenericTypePlaceholder(c @Checker, sym @Symbol) bool {
	if sym.Kind != types.SYM_TYPE || sym.Type == nil { return false }
	var t @types.Type = sym.Type
	if t.Kind != types.TYP_NAMED || t.Underlying != nil || !charSliceEq(t.Name, sym.Name) {
		return false
	}
	return lookupGenericTypeDeclPkg(c, t.Pkg, sym.Name) != nil
}
