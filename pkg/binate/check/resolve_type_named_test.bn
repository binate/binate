package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for resolve_type_named.bn: named type references.

// A reference to an unknown name in type position is an "undefined" error, not
// a stand-in type that would hide the typo.
func TestResolveNamedTypeUndefined() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar v UnknownT\n")
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return fail("undefined type should produce a check error")
	}
	return ""
}

// A reference where the name resolves to something other than a type
// (e.g., a const) reports a distinct "not a type" diagnostic.
func TestResolveNamedTypeNotAType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst N int = 4\nvar v N\n"
	var c @Checker = checkSrcResolved(src)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return fail("non-type ident in type position should error")
	}
	return ""
}

// A generic type's bare name names no type wherever a name is read as one: a
// type expression, a type argument written as an expression (`one[Box]`,
// `one[*Box]`, the function value `one[Box]`, `size[Box]`), and a method
// expression's base (`Box.Get`, also called).
func TestBareGenericNameRejected() testing.TestResult {
	var prelude *[]readonly char = "package \"main\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func one[T any]() int { return 1 }\n"
			"func size[T any]() int { return cast(int, sizeof(T)) }\n"
			"func main() {\n"
	var bodies @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bodies[0] = "\tvar x Box\n\t_ = x\n"
	bodies[1] = "\t_ = one[Box]()\n"
	bodies[2] = "\t_ = one[*Box]()\n"
	bodies[3] = "\tvar f *func() int = one[Box]\n\t_ = f\n"
	bodies[4] = "\t_ = size[Box]()\n"
	bodies[5] = "\tvar g = Box.Get\n\t_ = g\n"
	bodies[6] = "\tvar b Box[int]\n\t_ = Box.Get(&b)\n"
	for i := 0; i < len(bodies); i++ {
		var src @[]char = buf.Concat(buf.Concat(prelude, bodies[i]), "}\n")
		var r testing.TestResult = expectOneErrSub(checkSrc(src),
				"generic type used without type arguments")
		if len(r) > 0 {
			return buf.Concat(buf.Concat(bodies[i], ": "), r)
		}
	}
	return ""
}
