package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/binate/constval"

import "pkg/std/cmp"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/std/hash"

// ============================================================
// Scope and Symbols
// ============================================================

// NewScope creates a new scope with the given parent (nil for the top-level scope).
func NewScope(parent @Scope) @Scope {
	var s @Scope = make(Scope)
	s.Parent = parent
	return s
}

// scopeHashThreshold is the symbol count past which a scope switches from a
// linear Syms scan to the name→index hash.  Below it, the scan is cheap and the
// hash's bucket allocation would be pure overhead across the many tiny block /
// function scopes; above it (the package scope), the linear scan is the
// O(N²)-per-package cost the hash removes.
const scopeHashThreshold int = 16

// scopeHashName is a djb2 hash of a symbol name — ScopeNameHasher.Hash delegates
// to it.  The arithmetic wraps (two's complement), fine for a hash.
func scopeHashName(name *[]readonly char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// ScopeNameHasher / ScopeNameEq are the ZERO-SIZE trait-type policies for a
// Scope's symIndex table.Table: djb2 over the name, and byte-equality.
// Zero-size with method Hash/Equal, so the table's dispatch is DIRECT
// (inlinable) — parity with the former open-coded probe.  Package-internal:
// only the Scope symbol table uses them.
type ScopeNameHasher struct {}

// Hash is ScopeNameHasher's method.
func (h ScopeNameHasher) Hash(k *[]readonly char) uint {
	return cast(uint, scopeHashName(k))
}

impl ScopeNameHasher : hash.Hasher[*[]readonly char]

// ScopeNameEq is the equality policy paired with ScopeNameHasher.
type ScopeNameEq struct {}

// Equal is ScopeNameEq's method.
func (e ScopeNameEq) Equal(a *[]readonly char, b *[]readonly char) bool {
	return types.CharEq(a, b)
}

impl ScopeNameEq : cmp.Eq[*[]readonly char]

// symHashActivate creates the name→Syms-index table (from nil) and indexes every
// current symbol.  Called when the scope first crosses scopeHashThreshold; the
// stdlib table.Table self-grows and rehashes thereafter, so there is no manual
// resize.  Keys borrow Syms[i].Name (the @Symbol owns the backing).
func (s @Scope) symHashActivate() {
	s.symIndex = table.NewTable[*[]readonly char, int, ScopeNameHasher, ScopeNameEq](
			ScopeNameHasher{}, ScopeNameEq{})
	for i := 0; i < len(s.Syms); i++ {
		s.symIndex.Put(s.Syms[i].Name, i)
	}
}

// LookupLocal searches for a symbol in this scope only (not parents).
func (s @Scope) LookupLocal(name *[]readonly char) @Symbol {
	if s.ViewOf != nil { return s.ViewOf.lookupAtGen(name, s.ViewGen) }
	if s.Frozen { return s.lookupFrozen(name) }
	if s.symIndex != nil {
		var idx int
		var ok bool
		idx, ok = s.symIndex.Get(name)
		if !ok {
			return nil
		}
		return s.Syms[idx]
	}
	for i := 0; i < len(s.Syms); i++ {
		if types.CharEq(s.Syms[i].Name, name) {
			return s.Syms[i]
		}
	}
	return nil
}

// lookupFrozen is LookupLocal for a frozen scope: its symbols as they were then
// (FrozenSyms), a symbol's index the same since (Define overwrites in place).
func (s @Scope) lookupFrozen(name *[]readonly char) @Symbol {
	if s.symIndex != nil {
		var idx int
		var ok bool
		idx, ok = s.symIndex.Get(name)
		if !ok || idx >= len(s.FrozenSyms) {
			return nil
		}
		return s.FrozenSyms[idx]
	}
	for i := 0; i < len(s.FrozenSyms); i++ {
		if types.CharEq(s.FrozenSyms[i].Name, name) {
			return s.FrozenSyms[i]
		}
	}
	return nil
}

// Define adds a symbol to the scope, overwriting any existing symbol with the same name.
// The blank identifier `_` is never bound: every blank form (a blank declaration,
// parameter, receiver, loop variable, type-switch binder, import) binds nothing,
// so `_` never resolves as a name.
func (s @Scope) Define(sym @Symbol) {
	if isBlank(sym.Name) {
		return
	}
	if s.ViewOf != nil { panic("internal error: a definition in a view of the REPL session's scope") }
	// A per-file import scope forwards package-symbol defines to the shared
	// package scope (its parent), so collecting a file's decls under its own
	// import scope still registers the symbols package-wide.  The file's
	// imports themselves are registered before DelegateDefine is set, so they
	// stay local to the file.
	if s.DelegateDefine && s.Parent != nil {
		s.Parent.Define(sym)
		return
	}
	// The scope a symbol is first defined in says where it is declared.
	if s.Level != 0 && sym.Level == 0 {
		sym.Level = s.Level
		sym.ScopePkg = s.Pkg
	}
	if s.Versioned && sym.Gen == 0 { sym.Gen = s.CurGen }
	// Overwrite in place if the name exists — O(1) via the hash once active, else
	// linear over the small-scope Syms.
	if s.symIndex != nil {
		var idx int
		var ok bool
		idx, ok = s.symIndex.Get(sym.Name)
		if ok {
			// Refresh the stored key to sym.Name BEFORE replacing Syms[idx]: the key
			// borrows the OLD @Symbol's Name, which the replacement frees; table.Put's
			// key refresh re-points it at sym.Name (live once Syms[idx] = sym).  The
			// probe still reads the old key here (the old @Symbol is not freed yet).
			s.symIndex.Put(sym.Name, idx)
			s.noteRebinding(s.Syms[idx], sym)
			s.Syms[idx] = sym
			return
		}
	} else {
		for i := 0; i < len(s.Syms); i++ {
			if types.CharEq(s.Syms[i].Name, sym.Name) {
				s.noteRebinding(s.Syms[i], sym)
				s.Syms[i] = sym
				return
			}
		}
	}
	s.appendSym(sym)
	if s.symIndex != nil {
		s.symIndex.Put(sym.Name, len(s.Syms) - 1)
	} else if len(s.Syms) > scopeHashThreshold {
		s.symHashActivate()
	}
}

// Undefine removes this scope's own binding of name, if any (a REPL
// declaration that failed to check is undone this way).
func (s @Scope) Undefine(name *[]readonly char) {
	var at int = -1
	for i := 0; i < len(s.Syms); i++ {
		if types.CharEq(s.Syms[i].Name, name) {
			at = i
			break
		}
	}
	if at < 0 {
		return
	}
	var kept @[]@Symbol = make_slice(@Symbol, len(s.Syms) - 1)
	var k int = 0
	for i := 0; i < len(s.Syms); i++ {
		if i != at {
			kept[k] = s.Syms[i]
			k = k + 1
		}
	}
	s.Syms = kept
	s.symsBacking = kept
	if s.symIndex != nil {
		s.symHashActivate()
	}
}

// appendSym appends sym to Syms, the front of symsBacking, doubling the backing when
// it is full.
func (s @Scope) appendSym(sym @Symbol) {
	var n int = len(s.Syms)
	if n == len(s.symsBacking) {
		var grown @[]@Symbol = make_slice(@Symbol, 2 * n + 4)
		for i := 0; i < n; i++ {
			grown[i] = s.Syms[i]
		}
		s.symsBacking = grown
	}
	s.symsBacking[n] = sym
	s.Syms = s.symsBacking[0:n + 1]
}

// Lookup searches for a symbol by name in the scope and its parents.
func (s @Scope) Lookup(name *[]readonly char) @Symbol {
	var local @Symbol = s.LookupLocal(name)
	if local != nil {
		return local
	}
	if s.Parent == nil {
		return nil
	}
	if s.ParentNames != nil && s.ParentNames.LookupLocal(name) == nil {
		var u @Scope = s.Parent.Parent
		if u == nil { return nil }
		for u.Parent != nil { u = u.Parent }
		return u.LookupLocal(name)
	}
	return s.Parent.Lookup(name)
}

// ============================================================
// Helpers
// ============================================================

// ============================================================
// Scope construction + symbol definition
// ============================================================

// defineType adds a type symbol to the scope.
func defineType(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_TYPE
	s.Define(sym)
}

// defineTypeArg adds to the scope the type parameter (or receiver binder) name
// bound to its type argument t for an instance's check (Symbol.IsTypeArg).
func defineTypeArg(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_TYPE
	sym.IsTypeArg = true
	s.Define(sym)
}

// defineConst adds a constant symbol without an integer or boolean value (a
// floating-point or string constant) to the scope.
func defineConst(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_CONST
	sym.CStat = constval.NOT_CONST
	sym.HasCVal = true
	s.Define(sym)
}

// defineConstPlaceholder forward-registers a constant's name and type before
// its value is known.
func defineConstPlaceholder(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_CONST
	s.Define(sym)
}

// defineConstValue adds a constant symbol with its value v and constval status
// st.
func defineConstValue(s @Scope, name @[]char, t @types.Type, v constval.Value, st int) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_CONST
	sym.CVal = v
	sym.CStat = st
	sym.HasCVal = true
	s.Define(sym)
}

// defineFunc adds a function symbol to the scope.
func defineFunc(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_FUNC
	s.Define(sym)
}

// defineVar adds a variable symbol to the scope.
func defineVar(s @Scope, name @[]char, t @types.Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = types.SYM_VAR
	s.Define(sym)
}

// definePkg adds a package symbol to the scope, mapping the local name to its import path.
func definePkg(s @Scope, name @[]char, path @[]char) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Kind = types.SYM_PKG
	sym.PkgPath = path
	s.Define(sym)
}

// Scope is a lexical scope: its own symbols (Syms) plus a link to the enclosing
// Parent.  Name resolution is O(1) for large scopes via the lazy symIndex (below).
type Scope struct {
	Parent @Scope
	Syms   @[]@Symbol
	// symsBacking is the slice Syms is a view of the front of: it doubles when full
	// (appendSym), so a scope of n symbols is built in time linear in n, not with a
	// copy of every symbol at each definition.
	symsBacking @[]@Symbol
	// symIndex is a LAZY name→Syms-index hash, created only once a scope grows
	// past scopeHashThreshold (see scope.bn).  nil means inactive: small scopes
	// (the vast majority — block / function scopes) stay on the plain linear Syms
	// scan, so no table is allocated for them.  A large scope (the package scope,
	// hundreds/thousands of symbols) builds the hash so Lookup / LookupLocal /
	// Define are O(1) instead of O(N) — the linear scan is O(N²) to build+resolve
	// a package and is catastrophic under the double-VM unit lane, where the
	// checker runs at ~VM² speed.  The value is the Syms index; the key is a
	// *[]readonly char borrow of Syms[idx].Name (the @Symbol owns the backing, so
	// the borrow stays live).  Define's in-place overwrite re-Puts the name so the
	// stored key tracks the replacement's Name (table.Put's key refresh).
	symIndex @table.Table[*[]readonly char, int, ScopeNameHasher, ScopeNameEq]
	// DelegateDefine: when true, Define forwards to Parent instead of
	// inserting locally.  Set on a per-file IMPORT scope so package-level
	// symbols collected while that scope is active (the current decl's file
	// scope) land in the shared package scope, while the file's imports —
	// registered BEFORE the flag is set — stay local to the file.  This is
	// what makes imports file-scoped without reclassifying every collector's
	// define call.  See checkPackageImpl / buildFileScopes.
	DelegateDefine bool
	// ParentNames, when set, limits what a lookup sees in Parent to the names
	// ParentNames itself declares: any other name is looked up in the universe,
	// the outermost scope.  Set on the package interface's (.bni's) file scope,
	// whose parent is the package scope, to the names the interface declares
	// (bniViewNames) — so a .bni declaration sees neither the .bn's private
	// declarations nor, in a REPL session, whose package scopes sit on the
	// session's scope, the names declared at the prompt (bni_view.bn).
	ParentNames @Scope
	// InterfaceView marks a scope in which, and in whose child scopes, names
	// resolve in the package interface's view (bni_view.bn): the .bni's file
	// scope, and the scope a package interface is built in (buildScopeFromFile),
	// in which its generic declarations' bodies resolve.
	InterfaceView bool
	// Versioned marks the REPL session's scope (check_repl_versions.bn): Define
	// stamps CurGen, the generation being checked, on a symbol defined in it, and
	// keeps in History the bindings later generations shadow.
	Versioned bool
	CurGen    int
	History   @vec.Vec[replVersion]
	// ViewOf, when set, makes the scope a view of the REPL session's scope ViewOf
	// as of generation ViewGen (replView): a name looked up in it resolves to the
	// binding it had then.  A view holds no symbols; its parent is ViewOf's.
	ViewOf  @Scope
	ViewGen int
	// Level is SCOPE_PACKAGE for a scope at a package's top level -- its own,
	// its interface's, a file's import scope -- with the package in Pkg, and
	// SCOPE_UNIVERSE for the universe; 0 for a function's or a block's.  Define
	// stamps both on the symbols defined in it (check_name_records.bn).
	Level int
	// Frozen, set while a `len` operand queued earlier is checked
	// (check_len_head.bn), makes LookupLocal see FrozenSyms, the symbols the block
	// had where the operand was: not the locals declared after it, nor a symbol
	// that replaced one of them.
	Frozen     bool
	FrozenSyms @[]@Symbol
	Pkg        @[]char
}

// Symbol is one entry in a Scope's symbol table: a resolved name binding
// carrying the name, its type, its kind (a SYM_* constant), and the extra
// per-kind state the checker records (const-fold values, expose home package,
// generic marker).  Reached from outside the package only through the Kind /
// Type accessors.
type Symbol struct {
	Name    @[]char
	Type    @types.Type
	Kind    int
	PkgPath @[]char
	// HomePkg is the resolved home package of an expose-INJECTED symbol: when
	// package A `expose`s package P, P's exported symbols are copied into A's
	// surface with HomePkg == P's path (or, for a symbol P itself re-exposed
	// from Q, Q's path, preserved transitively).  A later phase reads it so a
	// reference `A.X` mangles to the resolved home's symbol rather than A's
	// spelling.  Empty for every natively-declared symbol.  Distinct from
	// PkgPath (which is the target of a SYM_PKG import alias) so the
	// SYM_PKG-gated PkgPath reads stay unaffected.
	HomePkg @[]char
	// For Kind == SYM_CONST: the constant's value (CVal) and constval status
	// (CStat: OK, NOT_CONST for a constant this package does not fold — a
	// floating-point or string one, DEPENDENT, or POISONED), set once the
	// declaration is checked (HasCVal).  A forward-registered placeholder has
	// HasCVal false, which the checker's constval Env reports as NOT_KNOWN.
	CVal    constval.Value
	CStat   int
	HasCVal bool
	// IsGeneric marks an expose-INJECTED marker for an exposed GENERIC type or
	// interface.  A generic decl gets no ordinary scope symbol (it lives only in
	// the Generics.TypeDecls/Generics.IfaceDecls registries), so `expose` injects a
	// bare marker — carrying only Name + HomePkg + Kind — so that
	// PackageMemberHome can report the exposed generic's home (letting a
	// qualified `fwd.Box[int]` remap its generic-decl lookup to the home).  The
	// marker's Type is never a usable type: a BARE `fwd.Box` (no type arguments)
	// is rejected, exactly as a bare `glib.Box` is (see resolveNamedTypeExpr).
	IsGeneric bool
	// IsTypeArg marks a type parameter (or a method's receiver binder) bound to
	// its type argument while an instance is checked (bindInstanceArgs): an
	// assertion target that names it recovers as the type argument says
	// (iface.assert.typeparam), not as a type name does.
	IsTypeArg bool
	// Level and ScopePkg are the Level and Pkg of the scope the symbol was first
	// defined in: 0 and "" for one declared in a function or a block.
	Level    int
	ScopePkg @[]char
	// Gen is the generation of the REPL session that defined the symbol in the
	// session scope (check_repl_versions.bn): 0 outside a session.
	Gen int
}

// Kind returns the symbol's kind (one of the SYM_* constants).
func (s @Symbol) Kind() int {
	return s.Kind
}

// Type returns the symbol's type (nil for kinds that carry none).
func (s @Symbol) Type() @types.Type {
	return s.Type
}
