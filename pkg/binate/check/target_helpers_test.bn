package "pkg/binate/check"

import "pkg/binate/types"

func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// pinTarget64 sets a 64-bit target and returns the one it replaces, for the caller to restore
// (`defer { types.SetTarget(old) }`): a test whose sizes are a 64-bit target's then checks the
// same program on a 32-bit host, where the default target is 32-bit.
func pinTarget64() types.TargetInfo {
	var old types.TargetInfo = types.GetTarget()
	setTarget64()
	return old
}
