package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Direct unit coverage for the pure, nominal interface predicates in
// types_assignable_iface.bn (isUniverseAny / sameInterface / isDescendantInterface).
// The construction-site admissions there (canAssignToRawInterfaceValue etc.) are
// exercised through AssignableTo in types_assignable_test.bn and end-to-end by the
// interface-value conformance tests; these cover the pure predicates in isolation,
// plus (through checkSrc) the rule that a named pointer type constructs as a value.

// isUniverseAny is true ONLY for the built-in empty-package `any`.
func TestIsUniverseAnyMatchesBuiltinAny() testing.TestResult {
	if !isUniverseAny(types.MakeInterfaceType("", "any")) {
		return "empty-package `any` should be the universe interface"
	}
	return ""
}

// A user-declared interface — even an empty one, even named `any` inside a
// package — is a nominal marker, not the universe.
func TestIsUniverseAnyRejectsUserInterfaces() testing.TestResult {
	if isUniverseAny(types.MakeInterfaceType("pkg/x", "any")) {
		return "a package's own `any` interface must not be the universe"
	}
	if isUniverseAny(types.MakeInterfaceType("", "Empty")) {
		return "an empty-package interface named other than `any` must not match"
	}
	return ""
}

// sameInterface compares canonical (Pkg, Name); a shared name across packages
// must not collide.
func TestSameInterfaceByPkgAndName() testing.TestResult {
	var a @types.Type = types.MakeInterfaceType("pkg/x", "Reader")
	if !sameInterface(a, types.MakeInterfaceType("pkg/x", "Reader")) {
		return "same pkg+name interfaces should be the same interface"
	}
	if sameInterface(a, types.MakeInterfaceType("pkg/y", "Reader")) {
		return "different-package interfaces sharing a name must not match"
	}
	if sameInterface(a, types.MakeInterfaceType("pkg/x", "Writer")) {
		return "different-name interfaces must not match"
	}
	return ""
}

// isDescendantInterface walks .Parents; an interface is not its own descendant.
func TestIsDescendantInterface() testing.TestResult {
	var base @types.Type = types.MakeInterfaceType("pkg/x", "Base")
	var child @types.Type = types.MakeInterfaceType("pkg/x", "Child")
	child.Parents = slices.Append[@types.Type](child.Parents, base)
	if !isDescendantInterface(child, base) {
		return "Child extending Base should be a descendant of Base"
	}
	if isDescendantInterface(base, child) {
		return "Base must not be a descendant of Child"
	}
	if isDescendantInterface(base, base) {
		return "an interface is not its own descendant"
	}
	return ""
}

// iface.construct.named-pointer: a named type over a pointer is a value for interface
// construction.  It borrows into a raw interface (as `&h`) and boxes into a managed
// one through `box(h)`; a bare `h` widening to a managed interface is rejected.
func TestNamedPointerBorrowsIntoRawIface() testing.TestResult {
	return expectNoErrors(
			checkSrc(
					"package \"test\"\ninterface G { Get() int }\ntype N struct { v int }\ntype H @N\n"
							"func (h H) Get() int { return h.v }\nimpl H : G\n"
							"func f(h H) { var r *G = h; var a *any = h; var b @G = box(h); _ = r; _ = a; _ = b }\n"))
}

func TestNamedPointerBareIntoManagedIfaceRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ninterface G { Get() int }\ntype N struct { v int }\ntype H @N\n"
							"func (h H) Get() int { return h.v }\nimpl H : G\n"
							"func f(h H) { var b @G = h; _ = b }\n"), "cannot assign H to @G")
}

func TestNamedPointerBareIntoManagedAnyRejected() testing.TestResult {
	return expectErrSub(
			checkSrc(
					"package \"test\"\ntype N struct { v int }\ntype H @N\n"
							"func f(h H) { var a @any = h; _ = a }\n"), "cannot assign H to @any")
}
