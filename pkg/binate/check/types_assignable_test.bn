package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the assignability rules in types_assignable.bn.
// Helpers `fail` and `streq` are defined in types_test.bn (sibling file).

func TestAssignableTo() testing.TestResult {
	// Error sentinel: assignable to and from anything, so an already-reported
	// type error doesn't spawn a follow-on "cannot assign" cascade.
	if !AssignableTo(types.TypError(), nil, types.TypInt()) { return fail("error to int") }
	if !AssignableTo(types.TypInt(), nil, types.TypError()) { return fail("int to error") }
	if !AssignableTo(types.TypError(), nil, types.TypError()) { return fail("error to error") }
	if !AssignableTo(types.TypError(), nil, types.MakeManagedSliceType(types.TypInt())) {
		return fail("error to @[]int")
	}
	// Void, by contrast, is NOT assignable to a value type (a real
	// void-returning call assigned to a value stays a reportable error).
	if AssignableTo(types.TypVoid(), nil, types.TypInt()) { return fail("void to int must fail") }
	// Same types
	if !AssignableTo(types.TypInt(), nil, types.TypInt()) { return fail("int to int") }
	// Untyped int to int
	if !AssignableTo(types.TypUntypedInt(), nil, types.TypInt()) { return fail("untyped int to int") }
	if !AssignableTo(types.TypUntypedInt(), nil, types.TypInt32()) {
		return fail("untyped int to int32")
	}
	// Untyped bool to bool
	if !AssignableTo(types.TypUntypedBool(), nil, types.TypBool()) {
		return fail("untyped bool to bool")
	}
	// nil to pointer
	if !AssignableTo(types.TypNil(), nil, types.MakePointerType(types.TypInt())) {
		return fail("nil to *int")
	}
	// nil to slice — NOT allowed
	if AssignableTo(types.TypNil(), nil, types.MakeSliceType(types.TypInt())) {
		return fail("nil to *[]int should fail")
	}
	if AssignableTo(types.TypNil(), nil, types.MakeManagedSliceType(types.TypInt())) {
		return fail("nil to @[]int should fail")
	}
	// Managed to raw pointer
	if !AssignableTo(types.MakeManagedPtrType(types.TypInt()), nil,
			types.MakePointerType(types.TypInt())) {
		return fail("@int to *int")
	}
	// A RUNTIME [N]readonly char array is NOT assignable to ANY slice — array→slice
	// is not a legal implicit conversion (returning/assigning a stack array as a
	// slice is a use-after-free).  Only a string LITERAL (TYP_UNTYPED_STRING, below)
	// adopts a slice; the two are now distinct types, so the collision that made
	// this decay fire for runtime arrays is gone.
	var runtimeArr @types.Type = types.MakeArrayType(types.MakeReadonlyType(types.TypChar()), 5)
	if AssignableTo(runtimeArr, nil, types.MakeSliceType(types.TypChar())) {
		return fail("[5]readonly char (runtime) to *[]char should NOT be assignable")
	}
	if AssignableTo(runtimeArr, nil, types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))) {
		return fail("[5]readonly char (runtime) to *[]readonly char should NOT be assignable")
	}
	if AssignableTo(runtimeArr, nil,
			types.MakeManagedSliceType(types.MakeReadonlyType(types.TypChar()))) {
		return fail("[5]readonly char (runtime) to @[]readonly char should NOT be assignable")
	}
	if AssignableTo(runtimeArr, nil, types.MakeManagedSliceType(types.TypChar())) {
		return fail("[5]readonly char (runtime) to @[]char should NOT be assignable")
	}
	// An untyped string literal DOES adopt a char-slice target (but not *[]char).
	var litStr @types.Type = makeUntypedString(5)
	if AssignableTo(litStr, nil, types.MakeSliceType(types.TypChar())) {
		return fail("untyped string to *[]char should NOT be assignable")
	}
	if !AssignableTo(litStr, nil, types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))) {
		return fail("untyped string to *[]readonly char")
	}
	if !AssignableTo(litStr, nil,
			types.MakeManagedSliceType(types.MakeReadonlyType(types.TypChar()))) {
		return fail("untyped string to @[]readonly char")
	}
	if !AssignableTo(litStr, nil, types.MakeManagedSliceType(types.TypChar())) {
		return fail("untyped string to @[]char")
	}
	// @[]T → *[]T (managed to raw slice).
	if !AssignableTo(types.MakeManagedSliceType(types.TypInt()), nil,
			types.MakeSliceType(types.TypInt())) {
		return fail("@[]int to *[]int")
	}
	// @[]T → readonly *[]T and @T → readonly *T: the managed→raw decay must
	// see through a readonly (or alias) wrapper on the destination, the same
	// way the interface-value arms do.  readonly is strictly more restrictive
	// on capability, so adding it to the raw target is sound (and layout-
	// transparent).
	if !AssignableTo(types.MakeManagedSliceType(types.TypInt()), nil,
			types.MakeReadonlyType(types.MakeSliceType(types.TypInt()))) {
		return fail("@[]int to readonly *[]int")
	}
	if !AssignableTo(types.MakeManagedPtrType(types.TypInt()), nil,
			types.MakeReadonlyType(types.MakePointerType(types.TypInt()))) {
		return fail("@int to readonly *int")
	}
	// Not assignable
	if AssignableTo(types.TypInt(), nil, types.TypBool()) { return fail("int to bool should fail") }

	// Function reference → function-value type. Same signature: assignable.
	var fnParams @[]@types.Param = make_slice(@types.Param, 1)
	var fnP0 @types.Param = make(types.Param)
	fnP0.Type = types.TypInt()
	fnParams[0] = fnP0
	var fnResults @[]@types.Type = make_slice(@types.Type, 1)
	fnResults[0] = types.TypInt()
	var fn @types.Type = types.MakeFuncType(fnParams, fnResults)
	var fv @types.Type = types.MakeFuncValueType(fnParams, fnResults)
	if !AssignableTo(fn, nil, fv) {
		return fail("func(int) int → *func(int) int (matching sig)")
	}
	var fvm @types.Type = types.MakeManagedFuncValueType(fnParams, fnResults)
	if !AssignableTo(fn, nil, fvm) {
		return fail("func(int) int → @func(int) int")
	}
	// @func → readonly *func: the managed→raw func-value decay sees through a
	// readonly wrapper on the destination, like the @T / @[]T decay arms.
	if !AssignableTo(fvm, nil, types.MakeReadonlyType(fv)) {
		return fail("@func(int) int → readonly *func(int) int")
	}
	// Mismatched signature: return type differs.
	var fvBoolResult @[]@types.Type = make_slice(@types.Type, 1)
	fvBoolResult[0] = types.TypBool()
	var fvMismatch @types.Type = types.MakeFuncValueType(fnParams, fvBoolResult)
	if AssignableTo(fn, nil, fvMismatch) {
		return fail("func(int) int → *func(int) bool should fail")
	}
	// Mismatched signature: param count differs.
	var fnNoParams @[]@types.Param
	var fvDiffParams @types.Type = types.MakeFuncValueType(fnNoParams, fnResults)
	if AssignableTo(fn, nil, fvDiffParams) {
		return fail("func(int) int → *func() int should fail")
	}
	return ""
}

// TestNamedDistinctAssignability checks the named-distinct transparency
// arm of AssignableTo (Go's rule): an unnamed composite crosses a
// named-distinct boundary without a cast, but a scalar-underlying distinct
// type and two distinct named types still require an explicit cast.
func TestNamedDistinctAssignability() testing.TestResult {
	// (a) scalar-underlying distinct type: `type Celsius float64`.
	// A named type whose concrete underlying is a SCALAR is NOT
	// assignable to/from that scalar — the rule only crosses for
	// unnamed COMPOSITE underlyings.
	var celsius @types.Type = types.MakeNamedType("Celsius")
	celsius.Underlying = types.TypFloat64()
	if AssignableTo(types.TypFloat64(), nil, celsius) {
		return fail("float64 to Celsius should require cast")
	}
	if AssignableTo(celsius, nil, types.TypFloat64()) {
		return fail("Celsius to float64 should require cast")
	}

	// (b) two distinct named types with identical composite underlying:
	// `type A @[]int; type B @[]int`.  Both sides are named, so the
	// "exactly one side named" guard excludes them — NOT mutually
	// assignable.
	var aTy @types.Type = types.MakeNamedType("A")
	aTy.Underlying = types.MakeManagedSliceType(types.TypInt())
	var bTy @types.Type = types.MakeNamedType("B")
	bTy.Underlying = types.MakeManagedSliceType(types.TypInt())
	if AssignableTo(aTy, nil, bTy) {
		return fail("A to B (distinct named @[]int) should require cast")
	}
	if AssignableTo(bTy, nil, aTy) {
		return fail("B to A (distinct named @[]int) should require cast")
	}

	// (c) sanity positive: unnamed `@[]int` <-> `type Buf @[]int`.
	var buf @types.Type = types.MakeNamedType("Buf")
	buf.Underlying = types.MakeManagedSliceType(types.TypInt())
	if !AssignableTo(types.MakeManagedSliceType(types.TypInt()), nil, buf) {
		return fail("@[]int to Buf (named @[]int) should be assignable")
	}
	if !AssignableTo(buf, nil, types.MakeManagedSliceType(types.TypInt())) {
		return fail("Buf to @[]int should be assignable")
	}
	return ""
}
