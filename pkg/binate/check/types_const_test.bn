package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests specifically for the readonly-assignability rules exported
// from types_const.bn. The MakeReadonlyType / IsReadonly / StripReadonly
// predicates themselves are covered in types_test.bn; these
// tests exercise the widening / narrowing policy enforced by
// `AssignableTo` + `dropsConst`.

// AssignableTo allows widening T → readonly T for a value type.
func TestAssignableWidenValue() testing.TestResult {
	if !AssignableTo(types.TypInt(), nil, types.MakeReadonlyType(types.TypInt())) {
		return fail("int → readonly int should be assignable")
	}
	return ""
}

// AssignableTo allows readonly T → T (outer-readonly drop) for a value type.
// This is a value copy — the readonly handle is unaffected.
func TestAssignableOuterReadonlyValueCopyOut() testing.TestResult {
	if !AssignableTo(types.MakeReadonlyType(types.TypInt()), nil, types.TypInt()) {
		return fail("readonly int → int (value copy) should be assignable")
	}
	return ""
}

// AssignableTo allows *T → *readonly T (add readonly to element — widening).
func TestAssignableAddElemReadonly() testing.TestResult {
	var pInt @types.Type = types.MakePointerType(types.TypInt())
	var pConstInt @types.Type = types.MakePointerType(types.MakeReadonlyType(types.TypInt()))
	if !AssignableTo(pInt, nil, pConstInt) {
		return fail("*int → *readonly int should be assignable")
	}
	return ""
}

// AssignableTo rejects *readonly T → *T (element-level readonly drop).
func TestRejectDropElemReadonly() testing.TestResult {
	var pInt @types.Type = types.MakePointerType(types.TypInt())
	var pConstInt @types.Type = types.MakePointerType(types.MakeReadonlyType(types.TypInt()))
	if AssignableTo(pConstInt, nil, pInt) {
		return fail("*readonly int → *int should NOT be assignable")
	}
	return ""
}

// AssignableTo rejects element readonly drop on slices; widening OK.
func TestRejectDropSliceElemReadonly() testing.TestResult {
	var sInt @types.Type = types.MakeSliceType(types.TypInt())
	var sConstInt @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypInt()))
	if AssignableTo(sConstInt, nil, sInt) {
		return fail("*[]readonly int → *[]int should NOT be assignable")
	}
	if !AssignableTo(sInt, nil, sConstInt) {
		return fail("*[]int → *[]readonly int should be assignable")
	}
	return ""
}

// ============================================================
// String-literal → slice target rules
// ============================================================
//
// A string literal is UNTYPED (TYP_UNTYPED_STRING); these tests use
// makeUntypedString(N) as the source, the type EXPR_STRING_LIT produces.  (A
// RUNTIME [N]readonly char array — a distinct TYP_ARRAY — is NOT slice-assignable;
// that rejection is asserted in types_assignable_test.bn TestAssignableTo.)

// An untyped string → *[]char is the ratchet: rejected. A mutable raw borrow
// of rodata has no correct lowering.
func TestRejectStringToRawCharSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	if AssignableTo(src, nil, types.MakeSliceType(types.TypChar())) {
		return fail("untyped string → *[]char should NOT be assignable")
	}
	return ""
}

// [N]readonly char → *[]readonly char: zero-copy borrow, allowed.
func TestAllowStringToReadonlyRawCharSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	var dst @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	if !AssignableTo(src, nil, dst) {
		return fail("[N]readonly char → *[]readonly char should be assignable")
	}
	return ""
}

// [N]readonly char → @[]char: implicit-copy path, allowed at the type level.
func TestAllowStringToManagedCharSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	var dst @types.Type = types.MakeManagedSliceType(types.TypChar())
	if !AssignableTo(src, nil, dst) {
		return fail("[N]readonly char → @[]char should be assignable")
	}
	return ""
}

// [N]readonly char → @[]readonly char: zero-copy managed borrow, allowed.
func TestAllowStringToReadonlyManagedCharSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	var dst @types.Type = types.MakeManagedSliceType(types.MakeReadonlyType(types.TypChar()))
	if !AssignableTo(src, nil, dst) {
		return fail("[N]readonly char → @[]readonly char should be assignable")
	}
	return ""
}

// [N]readonly char → *[]int (non-char element) is rejected — the string
// interchangeability rule only fires for char/uint8 elements.
func TestRejectStringToNonCharSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	if AssignableTo(src, nil, types.MakeSliceType(types.TypInt())) {
		return fail("[N]readonly char → *[]int should NOT be assignable")
	}
	if AssignableTo(src, nil, types.MakeManagedSliceType(types.TypInt())) {
		return fail("[N]readonly char → @[]int should NOT be assignable")
	}
	return ""
}

// [N]readonly char → non-slice type is rejected.
func TestRejectStringToNonSlice() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	if AssignableTo(src, nil, types.TypInt()) {
		return fail("[N]readonly char → int should NOT be assignable")
	}
	if AssignableTo(src, nil, types.MakePointerType(types.TypChar())) {
		return fail("[N]readonly char → *char should NOT be assignable")
	}
	return ""
}

// Outer readonly on the destination is transparent — *[]readonly char
// wrapped in one more readonly layer is still a valid target.
func TestAllowStringToOuterReadonlySliceTarget() testing.TestResult {
	var src @types.Type = makeUntypedString(3)
	var inner @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	var outer @types.Type = types.MakeReadonlyType(inner)
	if !AssignableTo(src, nil, outer) {
		return fail("[N]readonly char → readonly *[]readonly char should be assignable")
	}
	return ""
}
