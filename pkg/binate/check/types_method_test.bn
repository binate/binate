package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Test for the type-method operations in types_method.bn — MakeMethod builds a
// method record, AddMethod registers it on a receiver type, and LookupMethod finds
// it (returning nil on a miss).  types.ResetPrimitiveMethods keeps the shared
// TypInt singleton clean across tests; the shared fail helper lives in another
// *_test.bn file of this package.
func TestTypeMethodAddAndLookup() testing.TestResult {
	types.ResetPrimitiveMethods()
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var ft @types.Type = types.MakeFuncType(noParams, noResults)
	var m @types.Method = MakeMethod("TypeMethodProbe", types.TypInt(), ft)
	if !types.TypInt().AddMethod(m) {
		types.ResetPrimitiveMethods()
		return fail("AddMethod should accept a fresh method on TypInt")
	}
	if types.TypInt().LookupMethod("TypeMethodProbe") == nil {
		types.ResetPrimitiveMethods()
		return fail("LookupMethod should find the just-added method")
	}
	if types.TypInt().AddMethod(m) {
		types.ResetPrimitiveMethods()
		return fail("AddMethod should reject a duplicate method name")
	}
	types.ResetPrimitiveMethods()
	return ""
}
