package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the predicates in types_query.bn. Assignability tests
// live in types_assignable_test.bn (split for the file-length cap).

// ReinterpretBitCast truncates + sign-extends to the target int type, matching
// what a runtime bit_cast produces — the value the checker and IR-gen must
// agree on.  Signed targets sign-extend the high bit; unsigned targets keep
// the truncated magnitude.
func TestReinterpretBitCast() testing.TestResult {
	if types.ReinterpretBitCast(253, types.TypInt8()) != -3 {
		return fail("bit_cast(int8, 253) should be -3")
	}
	if types.ReinterpretBitCast(3, types.TypInt8()) != 3 {
		return fail("bit_cast(int8, 3) should be 3")
	}
	if types.ReinterpretBitCast(128, types.TypInt8()) != -128 {
		return fail("bit_cast(int8, 128) should be -128")
	}
	if types.ReinterpretBitCast(127, types.TypInt8()) != 127 {
		return fail("bit_cast(int8, 127) should be 127")
	}
	if types.ReinterpretBitCast(256, types.TypInt8()) != 0 {
		return fail("bit_cast(int8, 256) truncates to 0")
	}
	if types.ReinterpretBitCast(253, types.TypUint8()) != 253 {
		return fail("bit_cast(uint8, 253) stays 253 (unsigned)")
	}
	if types.ReinterpretBitCast(0 - 1, types.TypUint8()) != 255 {
		return fail("bit_cast(uint8, -1) reinterprets to 255")
	}
	if types.ReinterpretBitCast(0 - 1, types.TypInt8()) != -1 {
		return fail("bit_cast(int8, -1) stays -1")
	}
	// A 64-bit target is returned unchanged (no truncation in a host int).
	if types.ReinterpretBitCast(0 - 5, types.TypInt64()) != -5 {
		return fail("bit_cast(int64, -5) passes through")
	}
	return ""
}

// Helpers `fail` and `streq` are defined in types_test.bn (sibling file).

// ============================================================
// Type Query Tests
// ============================================================

func TestIsInteger() testing.TestResult {
	if !types.TypInt().IsInteger() { return fail("int should be integer") }
	if !types.TypInt32().IsInteger() { return fail("int32 should be integer") }
	if !types.TypUint64().IsInteger() { return fail("uint64 should be integer") }
	if !types.TypUntypedInt().IsInteger() { return fail("untyped int should be integer") }
	if types.TypBool().IsInteger() { return fail("bool should not be integer") }
	return ""
}

func TestSignedMinForWidth() testing.TestResult {
	if types.SignedMinForWidth(8) != cast(int64, -128) {
		return fail("int8 MIN should be -128")
	}
	if types.SignedMinForWidth(16) != cast(int64, -32768) {
		return fail("int16 MIN should be -32768")
	}
	if types.SignedMinForWidth(32) != cast(int64, -2147483648) {
		return fail("int32 MIN should be -2147483648")
	}
	var i64min int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	if types.SignedMinForWidth(64) != i64min {
		return fail("int64 MIN should be INT64_MIN")
	}
	// Widths above 63 saturate at the int64 minimum (no shift overflow).
	if types.SignedMinForWidth(128) != i64min {
		return fail("width > 64 should saturate at INT64_MIN")
	}
	return ""
}

func TestIsBool() testing.TestResult {
	if !types.TypBool().IsBool() { return fail("bool should be bool") }
	if !types.TypUntypedBool().IsBool() { return fail("untyped bool should be bool") }
	if types.TypInt().IsBool() { return fail("int should not be bool") }
	return ""
}

func TestIsPointer() testing.TestResult {
	if !types.MakePointerType(types.TypInt()).IsPointer() { return fail("*int should be pointer") }
	if !types.MakeManagedPtrType(types.TypInt()).IsPointer() { return fail("@int should be pointer") }
	if types.TypInt().IsPointer() { return fail("int should not be pointer") }
	return ""
}

func TestIsSlice() testing.TestResult {
	if !types.MakeSliceType(types.TypInt()).IsSlice() { return fail("*[]int should be slice") }
	if !types.MakeManagedSliceType(types.TypInt()).IsSlice() { return fail("@[]int should be slice") }
	if types.TypInt().IsSlice() { return fail("int should not be slice") }
	return ""
}

func TestIsNillable() testing.TestResult {
	if !types.MakePointerType(types.TypInt()).IsNillable() { return fail("*int should be nillable") }
	if !types.MakeManagedPtrType(types.TypInt()).IsNillable() {
		return fail("@int should be nillable")
	}
	if types.MakeSliceType(types.TypInt()).IsNillable() {
		return fail("*[]int should not be nillable")
	}
	if types.MakeManagedSliceType(types.TypInt()).IsNillable() {
		return fail("@[]int should not be nillable")
	}
	if types.TypInt().IsNillable() { return fail("int should not be nillable") }
	return ""
}

func TestSliceElem() testing.TestResult {
	var s @types.Type = types.MakeSliceType(types.TypInt())
	var e @types.Type = s.SliceElem()
	if !e.Identical(types.TypInt()) { return fail("slice elem wrong") }
	if !(types.TypInt().SliceElem() == nil) { return fail("non-slice should return nil") }
	return ""
}

func TestPointerElem() testing.TestResult {
	var p @types.Type = types.MakePointerType(types.TypBool())
	var e @types.Type = p.PointerElem()
	if !e.Identical(types.TypBool()) { return fail("pointer elem wrong") }
	if !(types.TypInt().PointerElem() == nil) { return fail("non-pointer should return nil") }
	return ""
}

func TestResolveAlias() testing.TestResult {
	var target @types.Type = types.TypInt()
	var alias @types.Type = types.MakeAliasType("MyInt", target)
	var resolved @types.Type = alias.ResolveAlias()
	if !resolved.Identical(target) { return fail("alias should resolve to target") }
	// Non-alias passthrough
	var plain @types.Type = types.TypBool()
	if !plain.ResolveAlias().Identical(plain) { return fail("non-alias should pass through") }
	return ""
}

// IsByvalParam classifies a parameter for the >16-byte indirect
// (`ptr byval`) calling convention.  It must peel the transparent
// wrappers (alias / readonly / named) before the aggregate-Kind + size
// test, or a `readonly Big` param is mis-read as a non-aggregate scalar
// and lowered by value — and the IR-gen / codegen halves that share this
// one predicate disagree, so the emitted function fails to compile.
// Fixed-width int64 fields keep the 24 / 16 / 32-byte sizes independent
// of the locked `int` singleton's width.
func TestIsByvalParamPeelsWrappers() testing.TestResult {
	setTarget64()
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		var fld @types.Field = make(types.Field)
		fld.Name = "f"
		fld.Type = types.TypInt64()
		f3[i] = fld
	}
	var big @types.Type = types.MakeStructType("Big", f3) // 24 B, > 16

	if !big.IsByvalParam() { return fail("plain 24B struct must be byval") }
	if !types.MakeReadonlyType(big).IsByvalParam() {
		return fail("readonly 24B struct must be byval")
	}
	var named @types.Type = types.MakeNamedType("BigName")
	named.Underlying = big
	if !named.IsByvalParam() { return fail("named 24B struct must be byval") }
	if !types.MakeAliasType("BigAlias", big).IsByvalParam() {
		return fail("alias 24B struct must be byval")
	}
	if !types.MakeReadonlyType(types.MakeAliasType("BA2", big)).IsByvalParam() {
		return fail("readonly-alias 24B struct must be byval")
	}
	if !types.MakeReadonlyType(types.MakeArrayType(types.TypInt64(), 4)).IsByvalParam() {
		return fail("readonly [4]int64 (32B) must be byval")
	}

	var f2 @[]@types.Field = make_slice(@types.Field, 2)
	var ga @types.Field = make(types.Field)
	ga.Name = "a"
	ga.Type = types.TypInt64()
	f2[0] = ga
	var gb @types.Field = make(types.Field)
	gb.Name = "b"
	gb.Type = types.TypInt64()
	f2[1] = gb
	var small @types.Type = types.MakeStructType("Pair", f2) // 16 B, == 16 (not >)
	if small.IsByvalParam() { return fail("16B struct must NOT be byval") }
	if types.MakeReadonlyType(small).IsByvalParam() {
		return fail("readonly 16B struct must NOT be byval")
	}

	if types.TypInt64().IsByvalParam() { return fail("int64 must NOT be byval") }
	if types.MakeReadonlyType(types.TypInt64()).IsByvalParam() {
		return fail("readonly int64 must NOT be byval")
	}
	return ""
}

// A cyclic named type (`type A B; type B A`) must not hang the operand
// predicates: peelNamedBounded's depth bound makes comparabilityKind /
// IsInteger / IsBool terminate (reporting the type as non-comparable /
// non-numeric) rather than looping forever.  Defense-in-depth for the
// decl-time cyclic-type reject.  CR-2 Plan-1 Round-2.
func TestPeelNamedBoundedCyclicTerminates() testing.TestResult {
	var a @types.Type = types.MakeNamedType("A")
	var b @types.Type = types.MakeNamedType("B")
	a.Underlying = b
	b.Underlying = a
	if ComparabilityKind(a) != types.TYP_VOID {
		return fail("cyclic comparabilityKind should bottom out to TYP_VOID")
	}
	if a.IsInteger() { return fail("cyclic type must not report IsInteger") }
	if a.IsNumeric() { return fail("cyclic type must not report IsNumeric") }
	if a.IsBool() { return fail("cyclic type must not report IsBool") }
	return ""
}
