package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Foundation tests for variadic-ness in func-type identity (func.variadic.identity,
// spec §10.3).  Param.IsVariadic and a variadic-ness comparison thread through
// every func-type comparator; these
// tests pin that a variadic signature is DISTINCT from the otherwise-identical
// one taking a plain `*[]T` param.  Helpers `fail` / `charsEqSig` live in sibling
// test files (same package).

// mkOneSliceParamFunc builds a func-KIND type (TYP_FUNC or TYP_FUNC_VALUE) with a
// single param whose type is the raw slice `*[]elem`, optionally variadic, and no
// results.  A fixed and a variadic instance share the same Params[0].Type (*[]elem)
// and differ ONLY in IsVariadic — exactly the identity-distinguishing case.
func mkOneSliceParamFunc(kind int, elem @types.Type, variadic bool) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.MakeSliceType(elem)
	p.IsVariadic = variadic
	params[0] = p
	var noResults @[]@types.Type
	if kind == types.TYP_FUNC {
		return types.MakeFuncType(params, noResults)
	}
	return types.MakeFuncValueType(params, noResults)
}

// A variadic func-value type is NOT Identical to the fixed `*[]T` one, even
// though their param body types are the same *[]int.
func TestVariadicNotIdenticalToFixedSlice() testing.TestResult {
	var fixed @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), false)
	var vari @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), true)
	if fixed.Identical(vari) {
		return fail("*func(...int) must not be Identical to *func(*[]int)")
	}
	if vari.Identical(fixed) {
		return fail("Identical must reject the variadic distinction symmetrically")
	}
	return ""
}

// Two equally-variadic func-value types ARE Identical — the flag must not break
// equality for matching signatures.
func TestVariadicIdenticalToVariadic() testing.TestResult {
	var a @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), true)
	var b @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), true)
	if !a.Identical(b) {
		return fail("two identical variadic func-value types must be Identical")
	}
	return ""
}

// funcSignaturesMatch (TYP_FUNC vs a func-value type) must also compare
// variadic-ness: a variadic func matches only a variadic func-value type.
func TestFuncSignaturesMatchVariadic() testing.TestResult {
	var fnVar @types.Type = mkOneSliceParamFunc(types.TYP_FUNC, types.TypInt(), true)
	var fvFixed @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), false)
	if funcSignaturesMatch(fnVar, fvFixed) {
		return fail("a variadic func must not match a fixed *[]T func-value")
	}
	var fvVar @types.Type = mkOneSliceParamFunc(types.TYP_FUNC_VALUE, types.TypInt(), true)
	if !funcSignaturesMatch(fnVar, fvVar) {
		return fail("a variadic func must match a variadic func-value")
	}
	return ""
}

// funcIsVariadic reads the LAST param, so a flag on a non-last param does not
// make the signature variadic.  This underpins receiver safety: a method's
// receiver sits at Params[0] (never last when there are user params) and is
// never variadic, so funcIsVariadic reflects the user-facing variadic-ness.
func TestFuncIsVariadicReadsLastParam() testing.TestResult {
	// Two params, only the LAST variadic -> variadic.
	var pv @[]@types.Param = make_slice(@types.Param, 2)
	var a @types.Param = make(types.Param)
	a.Type = types.TypInt()
	pv[0] = a
	var b @types.Param = make(types.Param)
	b.Type = types.MakeSliceType(types.TypInt())
	b.IsVariadic = true
	pv[1] = b
	var noRes @[]@types.Type
	if !types.FuncIsVariadic(types.MakeFuncType(pv, noRes)) {
		return fail("a last-param variadic func should be variadic")
	}
	// A flag on a non-last param (index 0) only -> NOT variadic.
	var pf @[]@types.Param = make_slice(@types.Param, 2)
	var c @types.Param = make(types.Param)
	c.Type = types.MakeSliceType(types.TypInt())
	c.IsVariadic = true
	pf[0] = c
	var d @types.Param = make(types.Param)
	d.Type = types.TypInt()
	pf[1] = d
	if types.FuncIsVariadic(types.MakeFuncType(pf, noRes)) {
		return fail("a flag on a non-last param must not make the func variadic")
	}
	// Zero params -> not variadic.
	var np @[]@types.Param
	if types.FuncIsVariadic(types.MakeFuncType(np, noRes)) {
		return fail("a zero-param func is not variadic")
	}
	return ""
}

// A receiver-only method (`func (r *T) m()`, receiver at Params[0], no user
// params) is NOT variadic: the receiver — which is the LAST param here — is
// never variadic.  This locks the invariant that funcIsVariadic (reads the last
// param) reflects user-facing variadic-ness even when the receiver IS the last
// param; the parser/resolve never set IsVariadic on a receiver (F9).
func TestFuncIsVariadicReceiverOnlyMethod() testing.TestResult {
	var recvT @types.Type = make(types.Type)
	recvT.Kind = types.TYP_POINTER
	recvT.Elem = types.TypInt()
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var recv @types.Param = make(types.Param)
	recv.Type = recvT
	// A receiver is never variadic — IsVariadic stays false.
	params[0] = recv
	var noRes @[]@types.Type
	if types.FuncIsVariadic(types.MakeFuncType(params, noRes)) {
		return fail("a receiver-only method must not be variadic")
	}
	return ""
}
