package "pkg/binate/check"

import "pkg/binate/types"

// The universe: the scope at the root of every scope chain, holding the
// predeclared types, constants and functions.

// universeScope creates the top-level scope containing all predeclared
// types, constants, and builtins.
func universeScope() @Scope {
	types.EnsureInit()
	var s @Scope = NewScope(nil)
	s.Level = SCOPE_UNIVERSE

	defineType(s, "bool", types.TypBool())
	defineType(s, "char", types.TypChar())
	defineType(s, "int", types.TypInt())
	defineType(s, "int8", types.TypInt8())
	defineType(s, "int16", types.TypInt16())
	defineType(s, "int32", types.TypInt32())
	defineType(s, "int64", types.TypInt64())
	defineType(s, "uint", types.TypUint())
	defineType(s, "uint8", types.TypUint8())
	defineType(s, "uint16", types.TypUint16())
	defineType(s, "uint32", types.TypUint32())
	defineType(s, "uint64", types.TypUint64())
	defineType(s, "float32", types.TypFloat32())
	defineType(s, "float64", types.TypFloat64())
	defineType(s, "byte", types.TypByte())

	// `any` is the implicit universal interface.  Empty method set,
	// so every type satisfies it; usable spellings are `*any` and
	// `@any`.  Bare `any` as a type expression is rejected by
	// resolveTypeExpr, except in the generic-constraint position
	// where `any` means "no constraint" (see
	// resolveTypeParamConstraint's name-based fast path).
	var emptyPkg @[]char
	var anyName @[]char = "any"
	var anyIface @types.Type = types.MakeInterfaceType(emptyPkg, anyName)
	defineInterface(s, anyName, anyIface)

	defineConst(s, "true", types.TypUntypedBool())
	defineConst(s, "false", types.TypUntypedBool())
	defineConst(s, "nil", types.TypNil())

	// The predeclared function `panic(msg *[]readonly char)` (builtin.predeclared,
	// builtin.panic).  A direct call is checked specially (isPanicCall); as a value
	// it is an ordinary function of this type.
	var panicParams @[]@types.Param = make_slice(@types.Param, 1)
	panicParams[0] = make(types.Param)
	panicParams[0].Name = "msg"
	panicParams[0].Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	var noResults @[]@types.Type
	defineFunc(s, "panic", types.MakeFuncType(panicParams, noResults))

	return s
}

// universeOf returns the universe scope: the root of c's scope chain, and of
// every scope chain.
func universeOf(c @Checker) @Scope {
	var u @Scope = c.Scope
	for u != nil && u.Parent != nil { u = u.Parent }
	return u
}

// isUniverseSymbol reports whether sym is the universe scope's own binding of its
// name rather than a binding that shadows it.
func isUniverseSymbol(c @Checker, sym @Symbol) bool {
	if sym == nil { return false }
	var u @Scope = universeOf(c)
	return u != nil && same(u.LookupLocal(sym.Name), sym)
}

// isUniversePanic reports whether sym, the symbol an identifier resolved to, is
// the universe scope's predeclared `panic` rather than a binding of that name
// that shadows it (builtin.predeclared).
func isUniversePanic(c @Checker, sym @Symbol) bool {
	if sym == nil || sym.Kind != types.SYM_FUNC || !types.CharEq(sym.Name, "panic") { return false }
	return isUniverseSymbol(c, sym)
}
