package "pkg/binate/check"

import "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the universe scope (universe.bn).

// The universe's `panic` takes one `*[]readonly char` and returns nothing
// (builtin.panic), and isUniversePanic tells it from a binding of that name.
func TestUniversePanic() testing.TestResult {
	var c @Checker = NewChecker()
	var sym @Symbol = c.Scope.LookupLocal("panic")
	if sym == nil || sym.Type == nil || len(sym.Type.Params) != 1 || len(sym.Type.Results) != 0 {
		return fail("the universe panic should take one parameter and return nothing")
	}
	var msgTyp @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	if !sym.Type.Params[0].Type.Identical(msgTyp) {
		return fail("the universe panic's parameter should be *[]readonly char")
	}
	if !isUniversePanic(c, sym) { return fail("the universe panic should be recognized") }
	var shadow @Symbol = make(Symbol)
	shadow.Name = "panic"
	shadow.Type = sym.Type
	shadow.Kind = types.SYM_FUNC
	if isUniversePanic(c, shadow) { return fail("a same-named function is not the universe panic") }
	return ""
}
