// Package codegen emits LLVM IR text from the Binate IR representation.
package "pkg/binate/codegen"

import "pkg/binate/ir"

// SetDebugInfo enables/disables DWARF debug metadata in emitted LLVM IR.
func SetDebugInfo(enabled bool)

// SetEmitComdat enables COMDAT groups on weak_odr definitions.  Enable it only
// for ELF/COFF targets — Mach-O does not support COMDATs.  Defaults off.
func SetEmitComdat(enabled bool)

// SetTargetOSDarwin records whether the target OS is Darwin, whose arm64 calling
// convention passes every variadic argument on the stack (a __c_call then puts no
// aarch64 x7 dummy ahead of a variadic aggregate).  Defaults off.
func SetTargetOSDarwin(darwin bool)

// SetHosted records whether the target has a C library (Linux, macOS), so a
// large aggregate's bulk zero-fill / copy may be the llvm.memset / llvm.memcpy
// intrinsic, which clang can optimize, rather than a call to rt.MemZero /
// rt.MemCopy (bare metal).  Defaults off.
func SetHosted(hosted bool)

// EmitModule produces LLVM IR text (.ll) for the given IR module.
func EmitModule(m @ir.Module) @[]char
