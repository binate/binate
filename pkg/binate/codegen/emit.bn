package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// LLVM IR Text Emitter
//
// Walks an ir.Module and produces LLVM IR text (.ll format).
// Currently supports: functions, int/bool/string constants,
// arithmetic, comparisons, loads/stores/alloca, branches,
// calls to runtime builtins, return.
// ============================================================

// modulePkgName holds the current module's package path (for name
// mangling).  It is the full import path (e.g. `pkg/binate/native/x64`);
// the mangler short-names it internally for now (see pkg/binate/mangle —
// full-path migration).
var modulePkgName *[]readonly char

// retSeq is a per-function counter for unique multi-return temporary names.
var retSeq int

// tmpSeq is a per-function counter for unique temporary names in void instructions.
var tmpSeq int

// currentFuncUsesSret is set by emitFuncDbg before walking the body, so
// emitReturn can route OP_RETURN to a store-through-%v.retbuf + ret void
// instead of `ret <T> <val>`.  Per-function state — emitFuncDbg sets it
// at entry; nothing else relies on it across functions.
var currentFuncUsesSret bool

// emitDebugInfo controls whether DWARF debug metadata is emitted.
var emitDebugInfo bool

// SetDebugInfo enables or disables DWARF debug metadata emission.
func SetDebugInfo(enabled bool) {
	emitDebugInfo = enabled
}

// EmitModule produces LLVM IR text for the given module.
func EmitModule(m @ir.Module) @[]char {
	var out @strings.Builder = strings.NewBuilder()

	// Set module package path for mangling (full path; mangler
	// short-names internally during the full-path migration).
	modulePkgName = stripQuotes(m.Name)

	// Module header
	out.Write("; ModuleID = '")
	out.Write(stripQuotes(m.Name))
	out.Write("'\n")
	out.Write("source_filename = \"")
	out.Write(stripQuotes(m.Name))
	out.Write(".bn\"\n")
	// NOTE: omitting target triple; clang will use the host default
	out.WriteByte('\n')

	// Slice type definitions.  The length fields use the target's
	// Binate-int width — i64 under LP64, i32 under --target arm32-linux.
	out.Write("%BnSlice = type { i8*, ")
	out.Write(intLL())
	out.Write(" }\n")
	out.Write("%BnManagedSlice = type { i8*, ")
	out.Write(intLL())
	out.Write(", i8*, ")
	out.Write(intLL())
	out.Write(" }\n")
	// Function-value type: {vtable_ptr, data_ptr}. Same layout for
	// raw (*func(...)) and managed (@func(...)) — only refcounting
	// of the data pointer differs, and that's at the IR level.
	out.Write("%BnFuncValue = type { i8*, i8* }\n")
	// Vtable type for function-value vtables: {dtor, call}, both
	// untyped pointers. dtor is per-(function, capture-shape); for
	// non-capturing it's null. call slot holds the bitcasted real
	// function pointer (compiled mode); VM mode's call slot stays
	// null in Phase 1 — Phase 3 fills it with a per-signature
	// trampoline.
	out.Write("%BnVtable = type { i8*, i8* }\n")
	// Interface-value type: {data_ptr, vtable_ptr}. Same 2-word
	// layout as %BnFuncValue but field meanings differ — slot 0
	// is the data pointer (raw or managed; the runtime treats the
	// data slot uniformly as i8*), slot 1 is the vtable pointer
	// (`@__ivt.<mangled>` global from emit_impls.bn). Same shape
	// for `*Iface` and `@Iface`; the refcounting on the data ptr
	// is what distinguishes the managed form (Slice 2.3b).
	out.Write("%BnIfaceValue = type { i8*, i8* }\n\n")

	// Collect and emit struct type definitions (packed with explicit padding)
	var emptyStructDefs @[]StructDef
	moduleStructDefs = emptyStructDefs
	collectStructTypes(m)
	for i := 0; i < len(moduleStructDefs); i++ {
		var sd StructDef = moduleStructDefs[i]
		out.Write("%")
		out.Write(mangle.StructName(modulePkgName,sd.Name))
		out.Write(" = type <{ ")
		var layout @[]types.FieldLayout = sd.Typ.StructLayout()
		var first bool = true
		for j := 0; j < len(layout); j++ {
			var fl types.FieldLayout = layout[j]
			if fl.PaddingBefore > 0 {
				if !first { out.Write(", ") }
				out.WriteByte('[')
				stringutils.WriteInt(out, fl.PaddingBefore)
				out.Write(" x i8]")
				first = false
			}
			if !first { out.Write(", ") }
			out.Write(llvmType(sd.Typ.Fields[j].Type))
			first = false
		}
		// Trailing padding
		var trailing int = sd.Typ.TrailingPadding()
		if trailing > 0 {
			out.Write(", [")
			stringutils.WriteInt(out, trailing)
			out.Write(" x i8]")
		}
		out.Write(" }>\n")
	}
	if len(moduleStructDefs) > 0 {
		out.WriteByte('\n')
	}

	// Emit string constants as globals (from module-level data)
	if len(m.Strings) == 0 {
		m.FinalizeStrings()
	}
	var strs @[]ir.StringConst = m.Strings
	for i := 0; i < len(strs); i++ {
		emitStringGlobal(out, strs[i])
	}
	if len(strs) > 0 {
		out.WriteByte('\n')
	}

	// Global variables
	for i := 0; i < len(m.Globals); i++ {
		var g @ir.Global = m.Globals[i]
		out.Write("@")
		out.Write(mangle.GlobalName(modulePkgName,g.Name))
		// Imported extern var: declare only (the defining package emits
		// the real `= global` definition).  g.Name is the defining-pkg
		// dotted qualname, so GlobalName above mangled it to the owner's
		// symbol, which this declaration links against.
		if g.IsExtern {
			out.Write(" = external global ")
			out.Write(llvmType(g.Typ))
			out.Write("\n")
			continue
		}
		out.Write(" = global ")
		var gTypStr @[]char = llvmType(g.Typ)
		out.Write(gTypStr)
		// Choose a type-appropriate static zero.  The actual initializer
		// value (for `var x T = expr`) is applied at startup by the
		// per-package __init function (see gen_init.bn); this is only the
		// pre-init default, but it must be a valid LLVM constant for the
		// type — a bare `0` is rejected by LLVM for any non-integer type
		// ("integer constant must have integer type"), so floats need
		// `0.0` and aggregates need `zeroinitializer`.
		//
		// Peel the transparent wrappers (`readonly`, named-distinct)
		// first, exactly as llvmType does for the printed type
		// (emit_types.bn): otherwise a `readonly`-qualified or named-
		// over-aggregate global picks its init token from the wrapper
		// kind (TYP_READONLY / TYP_NAMED, which match no branch below)
		// and emits an invalid bare `0` against, e.g., `%BnIfaceValue`
		// or a struct-typed slot.
		var gt @types.Type = stripWrappers(g.Typ)
		if gt != nil && (gt.Kind == types.TYP_MANAGED_PTR || gt.Kind == types.TYP_POINTER) {
			out.Write(" null\n")
		} else if gt != nil &&
			(gt.Kind == types.TYP_SLICE ||
				gt.Kind == types.TYP_MANAGED_SLICE ||
				gt.Kind == types.TYP_STRUCT ||
				gt.Kind == types.TYP_ARRAY ||
				gt.Kind == types.TYP_INTERFACE_VALUE ||
				gt.Kind == types.TYP_INTERFACE_VALUE_MANAGED ||
				gt.Kind == types.TYP_FUNC_VALUE ||
				gt.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			// The 16-byte address-aggregates (iface value, func value)
			// are struct types in LLVM, so a bare `0` is rejected the
			// same way a struct/slice is; they need `zeroinitializer`.
			out.Write(" zeroinitializer\n")
		} else if gt != nil && gt.IsFloat() {
			out.Write(" 0.0\n")
		} else {
			out.Write(" 0\n")
		}
	}
	if len(m.Globals) > 0 {
		out.WriteByte('\n')
	}

	// (The C-runtime manifest is empty; bn_print_* / bn_exit
	// migrated to bootstrap.formatX + bootstrap.Write / rt.Exit.)
	// bn_bounds_check is provided by pkg/builtins/rt (rt.BoundsCheck)
	// bn_box, bn_alloc, bn_refcount_inc, bn_refcount_dec are provided by pkg/builtins/rt
	// (declared via extern function declarations below)
	out.WriteByte('\n')

	// Extern function declarations (from imports)
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if !f.IsExtern {
			continue
		}
		// Check if this extern needs sret for the return type.
		// Applies to ALL externs returning a single aggregate above
		// the sret threshold (16 bytes on 64-bit, 4 on 32-bit) —
		// IsCExtern (libc bridges) and plain cross-package Binate
		// externs both need sret marking so the AAPCS-C-style
		// indirect-result convention is consistent across the LLVM
		// boundary.  Without this, LLVM's AArch64 backend silently
		// picks pack-vs-sret based on field-count for unannotated
		// aggregate returns, which doesn't match what the call site
		// emits.
		var useSret bool = false
		if len(f.Results) == 1 {
			useSret = needsSret(f.Results[0])
		}

		out.Write("declare ")
		if useSret {
			out.Write("void")
		} else if len(f.Results) == 0 {
			out.Write("void")
		} else if len(f.Results) == 1 && aggRetCoerced(f.Results[0]) {
			// In-register aggregate result: declare the coerced ABI
			// return type `[N x i64]` so callers of this extern agree
			// with the definition (which also returns `[N x i64]`).
			aggCoerceLLTy(out, f.Results[0])
		} else if len(f.Results) == 1 {
			out.Write(llvmType(f.Results[0]))
		} else if f.MultiReturnType != nil {
			out.Write(llvmType(f.MultiReturnType))
		} else {
			out.Write(multiReturnType(f.Results))
		}
		out.Write(" @")
		out.Write(mangle.FuncName(modulePkgName,f.Name))
		out.WriteByte('(')
		if useSret {
			out.Write("ptr sret(")
			out.Write(llvmType(f.Results[0]))
			out.Write(") align 8")
			if len(f.Params) > 0 { out.Write(", ") }
		}
		for j := 0; j < len(f.Params); j++ {
			if j > 0 {
				out.Write(", ")
			}
			writeParamTypeLLVM(out, f.Params[j].Typ)
		}
		out.Write(")\n")
	}

	// Raw C symbols referenced by __c_call: emit unmangled declares
	// (one per distinct symbol).
	emitCCallDeclares(out, m)

	out.WriteByte('\n')

	// Function-value vtable globals. Each function-taken-as-value
	// gets a weak_odr `%BnVtable` global named `__vt.<mangled>`.
	// weak_odr (not linkonce_odr) so -O2 doesn't drop the body when
	// it has no in-TU references — other TUs may link against it.
	// See plan-function-values.md (VM-mode vtables — Phase 1) for
	// the layout rationale.
	emitFuncValueVtables(out, m)

	// Interface-impl vtable globals (Slice 2.3a-1 of plan-interface-
	// syntax-revision.md). One `[N x i8*]` constant per (impl,
	// interface) pair, named `__ivt.<mangled>`. Slot j holds the
	// impl method that satisfies the interface's j'th method;
	// dispatch sites (Slice 2.3a-3) bitcast the slot to a uniform
	// shim signature when calling.
	emitImplVtables(out, m)

	// Build function return type map for multi-return calls
	var funcRetTypes @[]FuncRetType
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if len(f.Results) > 0 {
			var frt FuncRetType
			frt.Name = mangle.FuncName(modulePkgName,f.Name)
			if len(f.Results) == 1 && aggRetCoerced(f.Results[0]) {
				// Record the coerced ABI return type so call sites
				// (lookupRetType) emit `call [N x i64] @...` and bind
				// the result through the coercion in emitCall.
				var frtb @strings.Builder = strings.NewBuilder()
				aggCoerceLLTy(frtb, f.Results[0])
				frt.RetType = buf.CopyStr(frtb.String())
			} else if len(f.Results) == 1 {
				frt.RetType = llvmType(f.Results[0])
				if needsSret(f.Results[0]) {
					frt.IsSret = true
				}
			} else if f.MultiReturnType != nil {
				frt.RetType = llvmType(f.MultiReturnType)
			} else {
				frt.RetType = multiReturnType(f.Results)
			}
			funcRetTypes = slices.Append[FuncRetType](funcRetTypes, frt)
		}
	}

	// Assign debug metadata IDs to non-extern functions.
	// Layout: !0=CU, !1=DwarfVersion, !2=DebugInfoVersion,
	//   !3=DIFile, !4=DISubroutineType, !5..!15=DIBasicType slots
	//   (see dbgTypeID in emit_debug.bn for the slot assignment).
	// Then for each non-extern func i:
	//   !(dbgFuncIDBase+i*2)=DISubprogram, !(dbgFuncIDBase+i*2+1)=DILocation
	// After all per-function entries, non-scalar DI nodes from the
	// registry (see emit_debug_types.bn) starting at
	// dbgFuncIDBase + 2*dbgNonExternCount.
	resetDbgTypeRegistry()
	var dbgFuncIDs @[]int
	var dbgFuncSubrTypeIDs @[]int
	var dbgNonExternCount int = 0
	if emitDebugInfo {
		for i := 0; i < len(m.Funcs); i++ {
			if m.Funcs[i].IsExtern {
				dbgFuncIDs = slices.Append[int](dbgFuncIDs, -1)
			} else {
				dbgFuncIDs = slices.Append[int](dbgFuncIDs, dbgFuncIDBase + dbgNonExternCount * 2)
				dbgNonExternCount = dbgNonExternCount + 1
			}
		}
		setDbgTypeIDBase(dbgFuncIDBase + dbgNonExternCount * 2)
		// Allocate per-function DISubroutineType + types-tuple IDs.
		// Eagerly interns param + return types so the tuple's
		// references are resolvable.  Done after the per-function
		// metadata block so the registry IDs interleave naturally.
		dbgFuncSubrTypeIDs = setupDbgFuncSubroutineTypes(m)
	}

	// Functions
	for i := 0; i < len(m.Funcs); i++ {
		var dbgID int = -1
		if emitDebugInfo && len(dbgFuncIDs) > 0 {
			dbgID = dbgFuncIDs[i]
		}
		emitFuncDbg(out, m, m.Funcs[i], strs, funcRetTypes, dbgID)
		out.WriteByte('\n')
	}

	// Per-package reflect descriptor + generated __Package() accessor
	// (Phase B of notes-package-introspection.md).
	emitPackageDescriptor(out, m)

	// Emit debug metadata at end of module
	if emitDebugInfo && dbgNonExternCount > 0 {
		emitDebugMetadata(out, m, dbgFuncIDs, dbgFuncSubrTypeIDs)
	}

	return buf.CopyStr(out.String())
}

// FuncRetType records the LLVM return-type string for one mangled func
// name (Name) so call sites can spell the call correctly. IsSret marks
// callees that return their aggregate result via an X8/sret pointer
// instead of in registers.
type FuncRetType struct {
	Name    @[]char
	RetType @[]char
	IsSret  bool
}

// Struct type definitions for LLVM named types
type StructDef struct {
	Name        @[]char         // Binate struct name (e.g., "Point")
	MangledName @[]char         // mangled LLVM name, cached to avoid re-mangling on lookup
	Fields      @[]@types.Type  // field types
	Typ         @types.Type     // original struct type (for layout computation)
}

// moduleStructDefs accumulates StructDefs encountered during EmitModule
// so the module preamble can emit each named LLVM struct once. Reset at
// the start of every EmitModule call.
var moduleStructDefs @[]StructDef

// lookupRetType finds the LLVM return type string for a function by mangled name.
func lookupRetType(funcRetTypes *[]FuncRetType, name @[]char) @[]char {
	for i := 0; i < len(funcRetTypes); i++ {
		if charsEqual(funcRetTypes[i].Name, name) {
			return funcRetTypes[i].RetType
		}
	}
	return ""
}

// lookupIsSret checks whether a function uses sret (indirect return) convention.
func lookupIsSret(funcRetTypes *[]FuncRetType, name *[]readonly char) bool {
	for i := 0; i < len(funcRetTypes); i++ {
		if charsEqual(funcRetTypes[i].Name, name) {
			return funcRetTypes[i].IsSret
		}
	}
	return false
}



// strBlobSym builds the LLVM symbol name `.str.<id>` for a string constant's
// byte blob (emitDataGlobal prepends `@`).
func strBlobSym(id int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".str.")
	stringutils.WriteInt(b, id)
	return buf.CopyStr(b.String())
}

// strMSSym builds the LLVM symbol name `.str.<id>.ms` for a string constant's
// static managed-slice header.
func strMSSym(id int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".str.")
	stringutils.WriteInt(b, id)
	b.Write(".ms")
	return buf.CopyStr(b.String())
}

// emitStringGlobal emits a string constant as a byte blob + a static
// managed-slice header, both via the shared ir.Build* builders so the layout
// matches the native backend and cannot drift.
func emitStringGlobal(out *strings.Builder, sc ir.StringConst) {
	// Byte blob `@.str.<id> = private unnamed_addr constant [N x i8] c"..."`.
	emitDataGlobal(out, ir.BuildStringBlob(strBlobSym(sc.ID), sc.Data))
	// Static managed-slice header `@.str.<id>.ms` = { data, len, null, len }
	// aliasing the blob; an anonymous `{ ptr, iN, ptr, iN }` (was the named
	// %BnManagedSlice — its typed `load` consumers resolve identically under
	// opaque pointers).  LLVM keeps it private (resolved intra-module).
	emitDataGlobal(out, ir.BuildStringMSHeader(strMSSym(sc.ID),
		strBlobSym(sc.ID), sc.Len, ir.DG_LOCAL))
	return
}

// emitStringBytes writes string data as LLVM IR c"..." byte content, escaping special chars.
func emitStringBytes(out *strings.Builder, data *[]readonly char) {
	for i := 0; i < len(data); i++ {
		var c char = data[i]
		if c == '\n' {
			out.Write("\\0A")
		} else if c == '\r' {
			out.Write("\\0D")
		} else if c == '\t' {
			out.Write("\\09")
		} else if c == '"' {
			out.Write("\\22")
		} else if c == '\\' {
			out.Write("\\5C")
		} else if cast(int, c) < 32 || cast(int, c) > 126 {
			// Hex escape
			out.WriteByte('\\')
			stringutils.WriteHexByte(out, cast(int, c))
		} else {
			out.WriteByte(c)
		}
	}
	return
}
