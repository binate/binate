package "pkg/binate/codegen"

import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// aarch64: a two-word aggregate arriving with only x7 left
// ============================================================
//
// AAPCS64 places a ≤16-byte, two-word aggregate that arrives with only x7 left
// wholly on the stack, and leaves x7 unused (stage C.13 — types.Aapcs64ArgStraddles).
// A struct / array argument is spelled `[N x i64]`, which LLVM already places that
// way; a slice / iface-value / func-value is a first-class `{ptr, i64}` /
// `{ptr, ptr}`, whose members LLVM would place one at a time — the first in x7, the
// second on the stack.  So at that position the argument list carries a dummy `i64`
// first: it takes x7, and the aggregate follows whole on the stack, as C and the
// native backend place it.  Every LLVM argument and parameter list of the direct-call
// convention — definitions, declarations, calls, func-value / closure shims, the
// #[c_export] thunk and __c_call — inserts the same dummy, so both sides of a call
// agree.

// targetIsAA64 reports whether the current target is aarch64.
func targetIsAA64() bool {
	return types.GetTarget().Arch == types.ARCH_AA64
}

// aa64StraddlePad reports whether argument pos of argTypes needs the dummy `i64` ahead
// of it: the aarch64 target, a first-class two-word aggregate (not the `[N x i64]`-
// coerced kind) arriving with only x7 left.  The first sretOff entries of argTypes are
// a synthetic sret pointer, which rides x8 on aarch64 and takes no argument register.
func aa64StraddlePad(argTypes @[]@types.Type, pos int, sretOff int) bool {
	if !targetIsAA64() || pos < sretOff || pos >= len(argTypes) { return false }
	if aggParamCoerced(argTypes[pos]) { return false }
	if sretOff == 0 { return types.Aapcs64ArgStraddles(argTypes, pos) }
	var ts @[]@types.Type = make_slice(@types.Type, len(argTypes) - sretOff)
	for i := 0; i < len(ts); i++ { ts[i] = argTypes[i + sretOff] }
	return types.Aapcs64ArgStraddles(ts, pos - sretOff)
}

// aa64StraddlePadFlags returns aa64StraddlePad for each of n arguments that start at
// position base of argTypes (a shim's user args, say, after its captures).
func aa64StraddlePadFlags(argTypes @[]@types.Type, base int, n int, sretOff int) @[]bool {
	var flags @[]bool = make_slice(bool, n)
	for i := 0; i < n; i++ {
		flags[i] = aa64StraddlePad(argTypes, base + i, sretOff)
	}
	return flags
}

// writeAA64PadArg writes the dummy call argument `i64 poison, ` ahead of argument
// pos when aa64StraddlePad holds for it.
func writeAA64PadArg(out *strings.Builder, argTypes @[]@types.Type, pos int, sretOff int) {
	if aa64StraddlePad(argTypes, pos, sretOff) { out.Write("i64 poison, ") }
}

// writeAA64PadParam writes the dummy define-line parameter `i64 <prefix><n>.x7, `
// ahead of parameter pos when aa64StraddlePad holds for it — named after the
// parameter's own value (`%v<id>`, or a thunk's `%ca<i>`).
func writeAA64PadParam(out *strings.Builder, argTypes @[]@types.Type, pos int, sretOff int,
		prefix *[]readonly char, n int) {
	if !aa64StraddlePad(argTypes, pos, sretOff) { return }
	out.Write("i64 ")
	out.Write(prefix)
	stringutils.WriteInt(out, n)
	out.Write(".x7, ")
}

// shimPadFlags returns aa64StraddlePad for each user param of a func-value shim's
// underlying call, whose argument list is the params, behind the retbuf pointer when
// sretPrefix.
func shimPadFlags(fvTyp @types.Type, sretPrefix bool) @[]bool {
	var off int = 0
	if sretPrefix { off = 1 }
	var ts @[]@types.Type = make_slice(@types.Type, len(fvTyp.Params) + off)
	if sretPrefix { ts[0] = types.MakePointerType(types.TypUint8()) }
	for i := 0; i < len(fvTyp.Params); i++ { ts[i + off] = fvTyp.Params[i].Type }
	return aa64StraddlePadFlags(ts, off, len(fvTyp.Params), off)
}

// targetOSDarwin records that the target OS is Darwin, whose arm64 convention passes
// every variadic argument on the stack — so a variadic __c_call argument never takes
// x7 and needs no dummy ahead of it.
var targetOSDarwin bool

// SetTargetOSDarwin records whether the target OS is Darwin (see targetOSDarwin).
func SetTargetOSDarwin(darwin bool) {
	targetOSDarwin = darwin
}

// writeAA64PadType writes the dummy declared parameter type `i64, ` ahead of
// parameter pos when aa64StraddlePad holds for it.
func writeAA64PadType(out *strings.Builder, argTypes @[]@types.Type, pos int, sretOff int) {
	if aa64StraddlePad(argTypes, pos, sretOff) { out.Write("i64, ") }
}
