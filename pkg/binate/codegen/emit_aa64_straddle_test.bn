package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the aarch64 dummy `i64` ahead of a first-class two-word aggregate that
// arrives with only x7 left (emit_aa64_straddle.bn): AAPCS64 places the aggregate
// wholly on the stack and leaves x7 unused, and the dummy makes LLVM do the same at
// every definition, call, shim and __c_call.

// aa64PadSrc passes a raw slice after seven ints — so it arrives with only x7 left —
// to a function directly, through a function value, as a closure's eighth capture,
// and to a C function.
func aa64PadSrc() *[]readonly char {
	return "package \"main\"\n"
			"func take(a int, b int, c int, d int, e int, f int, g int, s *[]int, z int) int {\n"
			"\treturn len(s) + z\n}\n"
			"func main() {\n"
			"\tvar arr [3]int\n"
			"\tvar s *[]int = arr[:]\n"
			"\tvar fv *func(int, int, int, int, int, int, int, *[]int, int) int = take\n"
			"\tvar a1 int = 1\n\tvar a2 int = 2\n\tvar a3 int = 3\n\tvar a4 int = 4\n"
			"\tvar a5 int = 5\n\tvar a6 int = 6\n\tvar a7 int = 7\n"
			"\tvar cl *func() int = func() int { return a1 + a2 + a3 + a4 + a5 + a6 + a7 + len(s) }\n"
			"\t_ = take(1, 2, 3, 4, 5, 6, 7, s, 9) + fv(1, 2, 3, 4, 5, 6, 7, s, 9) + cl()\n"
			"\t_ = __c_call(\"cf\", int, 1, 2, 3, 4, 5, 6, 7, s, 9)\n"
			"}\n"
}

// countOf counts the occurrences of needle in haystack.
func countOf(haystack *[]readonly char, needle *[]readonly char) int {
	var n int = 0
	var at int = indexAfter(haystack, needle, 0)
	for at >= 0 {
		n = n + 1
		at = indexAfter(haystack, needle, at + len(needle))
	}
	return n
}

// On aarch64 the slice's definition parameter, the direct call, the func-value shim's
// call, the closure shim's call (the slice is its eighth capture) and the __c_call each
// carry the dummy, and the C declaration its type.  x86-64 carries none.
func TestAA64StraddlePadSites() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var out @[]char = compileToLLVM(aa64PadSrc())
	types.SetArch(types.ARCH_X64)
	var x64 @[]char = compileToLLVM(aa64PadSrc())
	types.SetArch(types.ARCH_UNKNOWN)
	if !contains(out,
			"@bn_F1_4_main1_4_take(i64 %v0, i64 %v1, i64 %v2, i64 %v3, i64 %v4, i64 %v5, "
					"i64 %v6, i64 %v7.x7, %BnSlice %v7, i64 %v8)") {
		return fail("the definition must take a dummy `i64 %v7.x7` ahead of the slice")
	}
	if countOf(out, "i64 poison, %BnSlice") != 4 {
		return fail(
				"the direct call, the func-value shim, the closure shim and the __c_call must "
						"each pass a dummy ahead of the slice")
	}
	if !contains(out, "@cf(i64, i64, i64, i64, i64, i64, i64, i64, %BnSlice, i64)") {
		return fail("the C declaration must declare the dummy ahead of the slice")
	}
	if contains(x64, ".x7") || contains(x64, "i64 poison, %BnSlice") {
		return fail("x86-64 must not carry the aarch64 dummy")
	}
	return ""
}

// aa64VariadicSliceCCall builds `vf(7 x int64, ..., slice)`: seven fixed int64 and a
// variadic raw slice arriving with only x7 left.
func aa64VariadicSliceCCall() @[]char {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var args @[]@ir.Instr = make_slice(@ir.Instr, 8)
	for i := 0; i < 7; i++ { args[i] = irbuild.EmitConstInt(entry, i, types.TypInt64()) }
	args[7] = irbuild.EmitConstNil(entry, types.MakeSliceType(types.TypInt64()))
	irbuild.EmitCCall(entry, "vf", args, types.TypInt32(), 7, true)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(entry, noRet)
	m.AddFunc(f)
	return EmitModule(m)
}

// A variadic slice arriving with only x7 left gets the dummy on Linux, where AAPCS64
// places variadic arguments like fixed ones, but not on Darwin, where every variadic
// argument goes on the stack.
func TestAA64StraddlePadVariadicByOS() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	SetTargetOSDarwin(false)
	var linux @[]char = aa64VariadicSliceCCall()
	SetTargetOSDarwin(true)
	var darwin @[]char = aa64VariadicSliceCCall()
	SetTargetOSDarwin(false)
	types.SetArch(types.ARCH_UNKNOWN)
	if !contains(linux, "i64 poison, %BnSlice") {
		return fail("a Linux variadic slice at x7 must carry the dummy")
	}
	if contains(darwin, "i64 poison") {
		return fail("a Darwin variadic argument never takes x7, so it needs no dummy")
	}
	return ""
}

// aa64PadSretSrc puts a slice at x7 in a function returning a 24-byte struct (sret
// in x8, so it takes no argument register) — called directly, through a function
// value and from a closure returning the struct that captures seven ints and the
// slice — in an sret __c_call, and in a #[c_export] function whose three-int result
// (returned through sret in C, in registers in Binate) gives it a C-entry thunk.
func aa64PadSretSrc() *[]readonly char {
	return "package \"main\"\n"
			"type B24 struct { a int\n\tb int\n\tc int }\n"
			"func big(a int, b int, c int, d int, e int, f int, g int, s *[]int, z int) B24 {\n"
			"\tvar r B24\n\tr.a = len(s) + z\n\treturn r\n}\n"
			"#[c_export(\"ex\")]\n"
			"func ex(n int, b int, c int, d int, e int, f int, g int, s *[]int, z int) (int, int, int) {\n"
			"\treturn len(s), z, n\n}\n"
			"func main() {\n"
			"\tvar arr [3]int\n"
			"\tvar s *[]int = arr[:]\n"
			"\tvar fv *func(int, int, int, int, int, int, int, *[]int, int) B24 = big\n"
			"\tvar a1 int = 1\n\tvar a2 int = 2\n\tvar a3 int = 3\n\tvar a4 int = 4\n"
			"\tvar a5 int = 5\n\tvar a6 int = 6\n\tvar a7 int = 7\n"
			"\tvar cl *func() B24 = func() B24 {\n"
			"\t\tvar r B24\n\t\tr.a = a1 + a2 + a3 + a4 + a5 + a6 + a7 + len(s)\n\t\treturn r\n\t}\n"
			"\t_ = big(1, 2, 3, 4, 5, 6, 7, s, 9).a + fv(1, 2, 3, 4, 5, 6, 7, s, 9).a + cl().a\n"
			"\tvar cb B24 = __c_call(\"cbig\", B24, 1, 2, 3, 4, 5, 6, 7, s, 9)\n"
			"\t_ = cb.a\n"
			"}\n"
}

// With an sret result, which rides x8 and takes no argument register, the slice still
// arrives at x7: the definition, the direct call, the func-value shim's sret call, the
// closure's sret shim, the sret __c_call and the #[c_export] thunk (its C-facing
// parameter list and its forward call) all carry the dummy.
func TestAA64StraddlePadSretAndThunk() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var out @[]char = compileToLLVM(aa64PadSretSrc())
	types.SetArch(types.ARCH_UNKNOWN)
	if !contains(out, "i64 %v6, i64 %v7.x7, %BnSlice %v7, i64 %v8)") {
		return fail("the sret definition must take the dummy ahead of the slice")
	}
	if !contains(out, "i64 %ca7.x7, %BnSlice %ca7") {
		return fail("the #[c_export] thunk must take the dummy ahead of the slice")
	}
	if countOf(out, "i64 poison, %BnSlice") != 5 {
		return fail(
				"the direct sret call, the func-value shim, the closure shim, the sret "
						"__c_call and the thunk's forward call must each pass the dummy")
	}
	return ""
}

// On Darwin a FIXED slice argument arriving at x7 still gets the dummy — only the
// variadic ones go on the stack.
func TestAA64StraddlePadDarwinFixedArg() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	SetTargetOSDarwin(true)
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var args @[]@ir.Instr = make_slice(@ir.Instr, 9)
	for i := 0; i < 7; i++ { args[i] = irbuild.EmitConstInt(entry, i, types.TypInt64()) }
	args[7] = irbuild.EmitConstNil(entry, types.MakeSliceType(types.TypInt64()))
	args[8] = irbuild.EmitConstInt(entry, 9, types.TypInt64())
	irbuild.EmitCCall(entry, "vf", args, types.TypInt32(), 8, true)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(entry, noRet)
	m.AddFunc(f)
	var out @[]char = EmitModule(m)
	SetTargetOSDarwin(false)
	types.SetArch(types.ARCH_UNKNOWN)
	if countOf(out, "i64 poison, %BnSlice") != 1 {
		return fail("a fixed slice at x7 needs the dummy on Darwin too")
	}
	if !contains(out, "declare i32 @vf(i64, i64, i64, i64, i64, i64, i64, i64, %BnSlice, ...)") {
		return fail("the variadic declare must declare the dummy ahead of the fixed slice")
	}
	return ""
}
