package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// In-register aggregate ABI coercion ([N x iW], W = pointer size)
// ============================================================
//
// cmd/bnc compiles the MAIN module with the chosen backend (native on
// aa64/x64/arm32) but EVERY dependency package goes through LLVM/clang.
// A cross-package call is therefore a native-caller -> LLVM-callee (or
// the reverse) boundary, and the two sides must agree byte-for-byte on
// how a <=16-byte aggregate travels by value.
//
// The native backends pack such an aggregate into consecutive GP
// registers as pointer-sized words -- the textbook AAPCS64 / SysV
// `[N x i64]` lowering on LP64, and AAPCS32's 4-aligned `[N x i32]`
// lowering on ILP32.  But emitting the LLVM function with a FIRST-CLASS
// struct param/return makes LLVM's target lowering EXPAND the struct
// field-per-register (an explicit padding leaf `[K x i8]` becomes K
// separate i8 regs; a sub-word `i32` field takes its own reg), so a
// `<{ i64, i32, [4 x i8] }>` eats 6 registers instead of 2 and the
// second struct arg lands in the wrong register.  Native and LLVM then
// disagree -> silent struct corruption.
//
// The fix: at the LLVM boundary, pass/return an in-register aggregate as
// the target's coerced ABI type -- `[N x i64]` (N = ceil(SizeOf/8)) on
// LP64, `[N x i32]` (N = ceil(SizeOf/4)) on ILP32 -- matching the native
// packing AND what clang emits for the same target (verified: clang
// -target arm-none-eabi -mfloat-abi=soft coerces a <=16-byte struct to
// `[N x i32]`, 4-aligned).  This target choice MATTERS on ILP32: an
// `i64` element is 8-aligned, so a `[N x i64]` aggregate triggers LLVM's
// AAPCS §6.5 C.3 even-register bump (it skips an odd GP register),
// whereas the 4-aligned `[N x i32]` does not -- a native arm32 caller
// packs a naturally-<8-aligned struct after a leading scalar at (e.g.)
// r1:r2, and a `[N x i64]` callee would read r2:r3 -> corruption.
//
// The function BODY is untouched -- it still computes/consumes the `%S`
// SSA value via extractvalue/insertvalue -- so coercion is local to
// three boundaries (param entry, return, call site), each implemented
// with the alloca/store/load idiom: the struct and the `[N x iW]` share
// the same slot (N * elementBytes >= SizeOf), viewed under two LLVM
// types through one opaque pointer.  Both the caller half and the callee
// half are emitted by this same codegen, so they always agree regardless
// of target.
//
// Scope: structs and arrays.  Slices (`%BnSlice = {i8*, i64}`),
// func-values and interface-values (`{i8*, i8*}`) have word-sized fields
// only, so their first-class form already lowers to exactly N word
// registers -- identical to `[N x iW]` -- and they keep their existing
// (separately-consistent) conventions.  The >16-byte byval (params) /
// sret (returns) paths are unchanged.

// aggInRegCoercedKind reports whether t's representation kind is one
// whose first-class LLVM form can diverge from the native `[N x iW]`
// (W = pointer size — i64 on LP64, i32 on ILP32) packing -- i.e. a NAMED
// struct or an array.  Transparent wrappers
// (readonly / named / alias) are peeled first, matching llvmType /
// IsByvalParam.
//
// An ANONYMOUS struct (Name == "") is EXCLUDED: that is the IR's
// multi-return encoding (an `{T1, T2, ...}` result for a function with
// several return values), which has its own `multiReturnType` `{...}`
// convention on BOTH the def/declare/funcRetTypes side and the call
// site -- it is never a single by-value aggregate result/param, so it
// must not be coerced (doing so would type-mismatch the call's
// `{...}` result against a `[N x iW]` bind).  A real struct passed /
// returned by value is always a named struct (e.g. `time.Point`).
func aggInRegCoercedKind(t @types.Type) bool {
	return types.AggInRegCoercedKind(t)
}

// aggParamCoerced reports whether a parameter of type t is passed using
// the `[N x iW]` coerced ABI: a struct/array that fits in registers
// (NOT IsByvalParam, i.e. SizeOf <= 16).  Empty (zero-size) aggregates
// are excluded -- N would be 0, and there is nothing to pass.
func aggParamCoerced(t @types.Type) bool {
	if !aggInRegCoercedKind(t) { return false }
	if t.SizeOf() < 1 { return false }
	return !t.IsByvalParam()
}

// aggRetCoerced delegates to the shared types.AggRetCoerced (a struct/array
// returned via the `[N x iW]` coerced ABI — fits the return registers, NOT
// sret).  See pkg/binate/types/abi_return.bn.
func aggRetCoerced(t @types.Type) bool {
	return types.AggRetCoerced(t)
}

// aggCoerceElemBytes is the byte width of ONE element of the coerced ABI
// aggregate type: 8 (i64) on LP64, 4 (i32) on ILP32.  ILP32 is the
// pointer-size-4 target (AAPCS32 arm32), matching types.NeedsSret's
// predicate — see pkg/binate/types/abi_return.bn.  The 4-aligned i32
// element on ILP32 is what clang emits for a <=16-byte struct, and it
// avoids the 8-aligned-i64 even-register bump the native side never
// performs for a naturally-4-aligned aggregate.
func aggCoerceElemBytes() int {
	if types.GetTarget().PointerSize == 4 {
		return 4
	}
	return 8
}

// aggCoerceWords returns N = ceil(SizeOf(t)/elementBytes): the number of
// elements of the coerced ABI aggregate type (i64 words on LP64, i32
// words on ILP32).  N * aggCoerceElemBytes() >= SizeOf(t), so the shared
// alloca/store/load slot never over-runs.
func aggCoerceWords(t @types.Type) int {
	var sz int = t.SizeOf()
	var w int = aggCoerceElemBytes()
	return (sz + w - 1) / w
}

// aggCoerceLLTy writes the coerced ABI LLVM type for t: the GP register
// packing native and LLVM agree on — `[N x i64]` (N = ceil(SizeOf/8)) on
// LP64, `[N x i32]` (N = ceil(SizeOf/4)) on ILP32 (AAPCS32 arm32, the
// 4-aligned form clang emits) — but for an HFA aggregate when HfaInSimd()
// is on it writes the SIMD form `[M x float]` / `[M x double]` (M = member
// count, byte-identical layout to the struct / GP aggregate over the shared
// coercion slot) so LLVM places it in consecutive v-registers, matching
// AAPCS64.  Both the caller and callee halves emit this same type, so
// LLVM<->LLVM stays self-consistent regardless of which registers LLVM picks.
func aggCoerceLLTy(out *strings.Builder, t @types.Type) {
	n, byteWidth := types.HfaClassify(t)
	// SIMD only for a genuine coerced-KIND HFA (named struct / array) — the same
	// set hfaSimdAggregate exempts from NeedsSret/IsByvalParam, so the spelling
	// and the byval/sret exemption decide on ONE set by construction, not by
	// caller discipline.  aggInRegCoercedKind excludes the anonymous multi-return
	// tuple, which hfaFold would otherwise count as an HFA.  (HFA-in-SIMD is
	// aa64/LP64-only and dormant; ILP32 never reaches it.)
	if types.HfaInSimd() && n > 0 && aggInRegCoercedKind(t) {
		out.Write("[")
		stringutils.WriteInt(out, n)
		if byteWidth == 4 {
			out.Write(" x float]")
		} else {
			out.Write(" x double]")
		}
		return
	}
	out.Write("[")
	stringutils.WriteInt(out, aggCoerceWords(t))
	if aggCoerceElemBytes() == 4 {
		out.Write(" x i32]")
	} else {
		out.Write(" x i64]")
	}
	return
}

// writeAggParamRef writes the coerced incoming-param reference `%vID.ag`
// for an in-register-aggregate param on the define-line, in place of the
// plain `%vID` (which is taken by the reconstructed struct value the body
// references).  Used only when aggParamCoerced(t) holds.
func writeAggParamRef(out *strings.Builder, id int) {
	emitRef(out, id)
	out.Write(".ag")
	return
}

// writeAggParamPrologue emits, for ONE in-register-aggregate param, the
// entry-block reconstruction of the `%S` value the body expects.  The
// incoming param is declared as `[N x iW] %vID.ag` on the define-line
// (writeAggParamRef); here we spill those words and load them back as the
// struct, naming the loaded value `%vID` -- exactly the name every body
// extractvalue / GEP reference already uses, so the body needs no rewrite:
//
//	store [N x iW] %vID.ag, ptr %vID.agp ; spill the coerced words
//	%vID = load %S, ptr %vID.agp          ; struct view of same bytes
//
// The `%vID.agp` alloca is `[N x iW]`-typed (N * elementBytes >= SizeOf),
// so neither the `[N x iW]` store nor the `%S` load over-runs the slot.
//
// The alloca line is emitted separately by writeAggParamAllocaDecl
// (entry-hoisted); this writes only the store + load, at the top of the
// entry block.
func writeAggParamPrologue(out *strings.Builder, id int, t @types.Type) {
	out.Write("store ")
	aggCoerceLLTy(out, t)
	out.Write(" ")
	emitRef(out, id)
	out.Write(".ag, ptr ")
	emitRef(out, id)
	out.Write(".agp\n  ")
	emitRef(out, id)
	out.Write(" = load ")
	out.Write(llvmType(t))
	out.Write(", ptr ")
	emitRef(out, id)
	out.Write(".agp\n  ")
	return
}

// writeAggParamAllocaDecl emits the entry-hoisted `alloca [N x iW]` for
// one coerced aggregate param (named `%vID.agp`).  Placed in the entry
// block by the alloca-hoist pre-pass (a function-entry, once-per-call
// slot regardless of loops in the body).
func writeAggParamAllocaDecl(out *strings.Builder, id int, t @types.Type) {
	emitRef(out, id)
	out.Write(".agp = alloca ")
	aggCoerceLLTy(out, t)
	out.WriteByte('\n')
	return
}

// emitAggParamCoercion emits, at the top of f's entry block (after the
// hoisted allocas, before any body instruction), the `[N x iW]` alloca
// plus the store/load reconstruction for every in-register-aggregate
// param.  After this runs, each coerced param's `%vID` holds the
// struct value the body's later store-into-slot / field copies consume,
// exactly as a non-coerced first-class struct param would have.
func emitAggParamCoercion(out *strings.Builder, f @ir.Func) {
	for i := 0; i < len(f.Params); i++ {
		if !aggParamCoerced(f.Params[i].Typ) {
			continue
		}
		// The `[N x i64]` reconstruction slot is the same on every target
		// (aggCoerceLLTy folds to it on x64); only the prologue's store
		// shape differs — x64 SSE stores each split eightbyte param at its
		// slot offset (sysvParamPrologue), the GP path stores the one
		// `[N x iW]` value (writeAggParamPrologue).
		writeAggParamAllocaDecl(out, f.Params[i].ID, f.Params[i].Typ)
		out.Write("  ")
		if types.SysVInSse(f.Params[i].Typ) {
			sysvParamPrologue(out, f.Params[i].ID, f.Params[i].Typ)
		} else {
			writeAggParamPrologue(out, f.Params[i].ID, f.Params[i].Typ)
		}
	}
	return
}

// emitReturnAggAllocaDecl emits the entry-hoisted `[N x iW]` slot
// `%v<retID>.agrp` for an OP_RETURN whose single result is an
// in-register aggregate (aggRetCoerced).  emitReturn stores the `%S`
// result into this slot and loads it back as `[N x iW]` to return.  A
// `ret` can live in a non-entry block, so the slot MUST be hoisted (the
// alloca-hoist invariant) -- done by the OP_RETURN case in
// emitEntryAllocaDecls.  No-op for a void / scalar / sret return.
func emitReturnAggAllocaDecl(out *strings.Builder, instr @ir.Instr) {
	if len(instr.Args) != 1 {
		return
	}
	if !aggRetCoerced(instr.Args[0].Typ) {
		return
	}
	emitRef(out, instr.ID)
	out.Write(".agrp = alloca ")
	aggCoerceLLTy(out, instr.Args[0].Typ)
	out.WriteByte('\n')
	return
}

// emitAggReturn emits the OP_RETURN body for a single in-register
// aggregate result (aggRetCoerced): coerce the `%S` result value to the
// `[N x iW]` ABI type (aggCoerceLLTy) through the entry-hoisted `.agrp`
// slot (emitReturnAggAllocaDecl) and `ret [N x iW]`, so the return
// registers agree with a native caller.  The struct and the `[N x iW]`
// share the same slot.  Called from emitReturn (emit_helpers.bn).
func emitAggReturn(out *strings.Builder, instr @ir.Instr) {
	out.Write("store ")
	out.Write(llvmType(instr.Args[0].Typ))
	out.WriteByte(' ')
	emitValRef(out, instr.Args[0])
	out.Write(", ptr ")
	emitRef(out, instr.ID)
	out.Write(".agrp\n  ")
	emitRef(out, instr.ID)
	out.Write(".agr = load ")
	aggCoerceLLTy(out, instr.Args[0].Typ)
	out.Write(", ptr ")
	emitRef(out, instr.ID)
	out.Write(".agrp\n  ret ")
	aggCoerceLLTy(out, instr.Args[0].Typ)
	out.WriteByte(' ')
	emitRef(out, instr.ID)
	out.Write(".agr\n")
	return
}

// ------------------------------------------------------------
// Call-site coercion (LLVM caller half)
// ------------------------------------------------------------
//
// For each in-register-aggregate ARG, the struct value is coerced to
// `[N x iW]` (store -> load) before the call and passed as the coerced
// type; for an in-register-aggregate RESULT, the call yields `[N x iW]`
// which is stored to a slot and loaded back as `%S` to bind `%v<callID>`.
// Both halves use entry-hoisted `[N x iW]` slots named off the call
// instr.ID (stable between the hoist pass and the call site).

// aggCallArgCoerced reports whether call arg i is an in-register
// aggregate that must be coerced to `[N x iW]` at the call site.
func aggCallArgCoerced(instr @ir.Instr, i int) bool {
	return aggParamCoerced(instr.Args[i].Typ)
}

// aggCallResultCoerced reports whether the call's single result is an
// in-register aggregate returned as `[N x iW]` (so the call site binds
// the result through a coercion).  An sret call (>16 result) is NOT
// coerced.
func aggCallResultCoerced(instr @ir.Instr) bool {
	if instr.Typ == nil {
		return false
	}
	return aggRetCoerced(instr.Typ)
}

// emitAggCallArgPreamble emits, BEFORE the call line, the store/load that
// coerces each in-register-aggregate arg `%S` -> `[N x iW]`:
//
//	store %S <argref>, ptr %v<callID>.agA<i>
//	%v<callID>.agL<i> = load [N x iW], ptr %v<callID>.agA<i>
//
// The call args list then passes `%v<callID>.agL<i>` (writeAggCallArg).
// The `.agA<i>` slot is entry-hoisted (emitAggCallAllocaDecls).
func emitAggCallArgPreamble(out *strings.Builder, instr @ir.Instr) {
	for i := 0; i < len(instr.Args); i++ {
		if !aggCallArgCoerced(instr, i) {
			continue
		}
		if types.SysVInSse(instr.Args[i].Typ) {
			// x64 SSE arg: store `%S` and load each eightbyte from its
			// offset (split), passed by sysvWriteCallArg.
			sysvEmitCallArgPreamble(out, instr, i)
			continue
		}
		out.Write("store ")
		out.Write(llvmType(instr.Args[i].Typ))
		out.WriteByte(' ')
		emitValRef(out, instr.Args[i])
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agL")
		stringutils.WriteInt(out, i)
		out.Write(" = load ")
		aggCoerceLLTy(out, instr.Args[i].Typ)
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  ")
	}
	return
}

// writeAggCallArg writes ONE coerced-aggregate call arg in the call's
// argument list: `[N x iW] %v<callID>.agL<i>` (the value loaded by
// emitAggCallArgPreamble).  Called from writeByvalArgLLVM's coerced
// branch.
func writeAggCallArg(out *strings.Builder, instr @ir.Instr, i int) {
	aggCoerceLLTy(out, instr.Args[i].Typ)
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agL")
	stringutils.WriteInt(out, i)
	return
}

// emitAggCallResultBind emits, AFTER the call line, the bind of an
// in-register-aggregate result.  The call value is captured as
// `%v<callID>.agR` ([N x iW]); store it to the `.agRB` slot and load it
// back as `%S` to define `%v<callID>` (the struct value the rest of the
// IR consumes):
//
//	store [N x iW] %v<callID>.agR, ptr %v<callID>.agRB
//	%v<callID> = load %S, ptr %v<callID>.agRB
//
// The `.agRB` slot is entry-hoisted (emitAggCallAllocaDecls).
func emitAggCallResultBind(out *strings.Builder, instr @ir.Instr) {
	if types.SysVInSse(instr.Typ) {
		// x64 SSE result: the call yielded the first-class `{ .. }` /
		// eightbyte aggregate; store it and load `%S` back.
		sysvEmitCallResultBind(out, instr)
		return
	}
	out.Write("  store ")
	aggCoerceLLTy(out, instr.Typ)
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agR, ptr %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agRB\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(llvmType(instr.Typ))
	out.Write(", ptr %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agRB\n")
	return
}

// emitAggCallAllocaDecls emits the entry-hoisted `[N x iW]` slots for a
// call's coerced-aggregate args (`.agA<i>`) and coerced-aggregate result
// (`.agRB`).  Called from the OP_CALL case of emitEntryAllocaDecls
// alongside the byval / sret slot decls.  No-op when the call has none.
func emitAggCallAllocaDecls(out *strings.Builder, instr @ir.Instr) {
	for i := 0; i < len(instr.Args); i++ {
		if !aggCallArgCoerced(instr, i) {
			continue
		}
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write(" = alloca ")
		aggCoerceLLTy(out, instr.Args[i].Typ)
		out.WriteByte('\n')
	}
	if aggCallResultCoerced(instr) {
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agRB = alloca ")
		aggCoerceLLTy(out, instr.Typ)
		out.WriteByte('\n')
	}
	return
}

// ------------------------------------------------------------
// Iface-dispatch coercion (caller half)
// ------------------------------------------------------------
//
// Mirrors the OP_CALL coercion for OP_CALL_IFACE_METHOD, whose args
// begin at instr.Args[1] (Args[0] is the interface value).  The thunk
// the dispatch bitcasts to is the impl method (its signature is coerced
// via writeParamTypeLLVM to [N x iW]), so
// the dispatch site must pass `[N x iW]` args and bind a `[N x iW]`
// result.  argIdx i corresponds to instr.Args[i+1].

// aggIfaceArgCoerced reports whether iface-call positional arg i
// (instr.Args[i+1]) is an in-register aggregate to coerce.
func aggIfaceArgCoerced(instr @ir.Instr, i int) bool {
	return aggParamCoerced(instr.Args[i + 1].Typ)
}

// emitAggIfaceArgPreamble emits the per-arg `%S` -> `[N x iW]` coercion
// (store/load via the `.agA<i>` slot) for each in-register-aggregate
// positional arg of an iface-method call, BEFORE the call line.
func emitAggIfaceArgPreamble(out *strings.Builder, instr @ir.Instr,
		nArgs int) {
	for i := 0; i < nArgs; i++ {
		if !aggIfaceArgCoerced(instr, i) {
			continue
		}
		var at @types.Type = instr.Args[i + 1].Typ
		out.Write("store ")
		out.Write(llvmType(at))
		out.WriteByte(' ')
		emitValRef(out, instr.Args[i + 1])
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agL")
		stringutils.WriteInt(out, i)
		out.Write(" = load ")
		aggCoerceLLTy(out, at)
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  ")
	}
	return
}

// writeAggIfaceArg writes ONE coerced iface positional arg in the call
// list: `[N x iW] %v<callID>.agL<i>`.
func writeAggIfaceArg(out *strings.Builder, instr @ir.Instr, i int) {
	aggCoerceLLTy(out, instr.Args[i + 1].Typ)
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agL")
	stringutils.WriteInt(out, i)
	return
}

// emitAggIfaceAllocaDecls emits the entry-hoisted `[N x iW]` slots for
// an iface-method call's coerced positional args (`.agA<i>`) and (when
// the single result is coerced) the result slot (`.agRB`).  Called from
// the OP_CALL_IFACE_METHOD case of emitEntryAllocaDecls.
func emitAggIfaceAllocaDecls(out *strings.Builder, instr @ir.Instr) {
	var nArgs int = len(instr.Args) - 1
	for i := 0; i < nArgs; i++ {
		if !aggIfaceArgCoerced(instr, i) {
			continue
		}
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write(" = alloca ")
		aggCoerceLLTy(out, instr.Args[i + 1].Typ)
		out.WriteByte('\n')
	}
	if aggCallResultCoerced(instr) {
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agRB = alloca ")
		aggCoerceLLTy(out, instr.Typ)
		out.WriteByte('\n')
	}
	return
}
