package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/binate/types/abi"
import "pkg/std/strings"

// ------------------------------------------------------------
// Call-site coercion (LLVM caller half)
// ------------------------------------------------------------
//
// For each in-register-aggregate ARG, the struct value is coerced to
// `[N x iW]` (store -> load) before the call and passed as the coerced
// type; for an in-register-aggregate RESULT, the call yields `[N x iW]`
// which is stored to a slot and loaded back as `%S` to bind `%v<callID>`.
// Both halves use entry-hoisted `[N x iW]` slots named off the call
// instr.ID (stable between the hoist pass and the call site).

// aggCallArgCoerced reports whether call arg i is an in-register
// aggregate that must be coerced to `[N x iW]` at the call site.
func aggCallArgCoerced(instr @ir.Instr, i int) bool {
	return aggParamCoerced(callArgAbiTyp(instr, i))
}

// cCallBaseStandard reports whether instr is a variadic `__c_call` under AAPCS-VFP
// (arm32 hard-float), which passes and returns every argument of the call — the
// fixed ones too — by the base standard: an HFA there is an ordinary composite in
// the core registers / memory, not an FP co-processor register candidate.
func cCallBaseStandard(instr @ir.Instr) bool {
	return instr.Op == iropcode.OP_C_CALL && instr.CVariadic && abi.Arm32HardFloat()
}

// callArgAbiTyp returns the type the ABI classifies call argument i as: its own
// type, except an HFA in a base-standard call (cCallBaseStandard), which takes its GP
// view (abi.HfaGpView) — spelled `[N x iW]`, byval past 16 bytes, as clang passes a
// variadic HFA.  The argument's VALUE keeps its own type (it is stored as such and
// reloaded in the classified form).
func callArgAbiTyp(instr @ir.Instr, i int) @types.Type {
	if cCallBaseStandard(instr) { return abi.HfaGpView(instr.Args[i].Typ) }
	return instr.Args[i].Typ
}

// callResultAbiTyp is callArgAbiTyp for the call's single result: an HFA result of a
// base-standard call returns through sret past 4 bytes, else in r0 as `[1 x i32]` —
// not in s0.. / d0.. (LLVM would return a `[N x float]` in r0..r3 for a variadic call,
// unlike the C callee).
func callResultAbiTyp(instr @ir.Instr) @types.Type {
	if cCallBaseStandard(instr) { return abi.HfaGpView(instr.Typ) }
	return instr.Typ
}

// aggCallResultCoerced reports whether the call's single result is an
// in-register aggregate returned as `[N x iW]` (so the call site binds
// the result through a coercion).  An sret call (>16 result) is NOT
// coerced.
func aggCallResultCoerced(instr @ir.Instr) bool {
	if instr.Typ == nil {
		return false
	}
	return aggRetCoerced(callResultAbiTyp(instr))
}

// emitAggCallArgPreamble emits, BEFORE the call line, the store/load that
// coerces each in-register-aggregate arg `%S` -> `[N x iW]`:
//
//	store %S <argref>, ptr %v<callID>.agA<i>
//	%v<callID>.agL<i> = load [N x iW], ptr %v<callID>.agA<i>
//
// The call args list then passes `%v<callID>.agL<i>` (writeAggCallArg).
// The `.agA<i>` slot is entry-hoisted (emitAggCallAllocaDecls).
//
// A memory-class aggregate arg (x64 straddle — hasSretPrefix models the sret
// pointer's RDI shift) is instead just STORED into the `.agA<i>` slot for a
// `byval` pass (emit_mem_byval.bn); it needs no load-back.
func emitAggCallArgPreamble(out *strings.Builder, instr @ir.Instr, hasSretPrefix bool) {
	var argTypes @[]@types.Type = callArgTypes(instr, hasSretPrefix)
	var sretOff int = 0
	if hasSretPrefix {
		sretOff = 1
	}
	for i := 0; i < len(instr.Args); i++ {
		// A memory-class aggregate of ANY kind (struct/array coerced today, or a
		// first-class slice / iface- / func-value) is stored into its `.agA<i>`
		// slot for a `byval` pass — checked before the coerced-only gate.
		if aggMemClass(argTypes, i + sretOff) {
			emitMemByvalArgStore(out, instr.ID, instr.Args[i], i)
			continue
		}
		if !aggCallArgCoerced(instr, i) {
			continue
		}
		if abi.SysVInSse(instr.Args[i].Typ) {
			// x64 SSE arg: store `%S` and load each eightbyte from its
			// offset (split), passed by sysvWriteCallArg.
			sysvEmitCallArgPreamble(out, instr, i)
			continue
		}
		out.Write("store ")
		out.Write(llvmType(instr.Args[i].Typ))
		out.WriteByte(' ')
		emitValRef(out, instr.Args[i])
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agL")
		stringutils.WriteInt(out, i)
		out.Write(" = load ")
		aggCoerceLLTy(out, callArgAbiTyp(instr, i))
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write("\n  ")
	}
	return
}

// writeAggCallArg writes ONE coerced-aggregate call arg in the call's
// argument list: `[N x iW] %v<callID>.agL<i>` (the value loaded by
// emitAggCallArgPreamble).  Called from writeByvalArgLLVM's coerced
// branch.
func writeAggCallArg(out *strings.Builder, instr @ir.Instr, i int) {
	aggCoerceLLTy(out, callArgAbiTyp(instr, i))
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agL")
	stringutils.WriteInt(out, i)
	return
}

// emitAggCallResultBind emits, AFTER the call line, the bind of an
// in-register-aggregate result.  The call value is captured as
// `%v<callID>.agR` ([N x iW]); store it to the `.agRB` slot and load it
// back as `%S` to define `%v<callID>` (the struct value the rest of the
// IR consumes):
//
//	store [N x iW] %v<callID>.agR, ptr %v<callID>.agRB
//	%v<callID> = load %S, ptr %v<callID>.agRB
//
// The `.agRB` slot is entry-hoisted (emitAggCallAllocaDecls).
func emitAggCallResultBind(out *strings.Builder, instr @ir.Instr) {
	if abi.SysVInSse(instr.Typ) {
		// x64 SSE result: the call yielded the first-class `{ .. }` /
		// eightbyte aggregate; store it and load `%S` back.
		sysvEmitCallResultBind(out, instr)
		return
	}
	out.Write("  store ")
	aggCoerceLLTy(out, callResultAbiTyp(instr))
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agR, ptr %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agRB\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(llvmType(instr.Typ))
	out.Write(", ptr %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".agRB\n")
	return
}

// emitAggCallAllocaDecls emits the entry-hoisted `[N x iW]` slots for a
// call's coerced-aggregate args (`.agA<i>`) and coerced-aggregate result
// (`.agRB`).  Called from the OP_CALL case of emitEntryAllocaDecls
// alongside the byval / sret slot decls.  No-op when the call has none.
func emitAggCallAllocaDecls(out *strings.Builder, instr @ir.Instr) {
	for i := 0; i < len(instr.Args); i++ {
		// A coerced struct/array arg needs its `[N x iW]` coercion slot; a
		// first-class ≤16 aggregate (slice / iface- / func-value) needs a
		// same-sized slot ONLY when it is memory-class (byval).  The alloca-hoist
		// pass has no sret-prefix context to decide memory-class, so allocate the
		// slot for every such ≤16 aggregate arg (an unused slot for a fitting
		// first-class one is harmless / DCE'd); the preamble + arg emission use
		// it only for the memory-class case.
		if !aggCallArgCoerced(instr, i) && !aggArgFirstClassSmall(instr.Args[i].Typ) {
			continue
		}
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agA")
		stringutils.WriteInt(out, i)
		out.Write(" = alloca ")
		aggCoerceLLTy(out, callArgAbiTyp(instr, i))
		out.WriteByte('\n')
	}
	if aggCallResultCoerced(instr) {
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agRB = alloca ")
		aggCoerceLLTy(out, callResultAbiTyp(instr))
		out.WriteByte('\n')
	}
	return
}
