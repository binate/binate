package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the CALL-SITE half of the in-register aggregate ABI coercion
// (emit_agg_coerce_call.bn — split out of emit_agg_coerce.bn for file-length
// hygiene): a ≤16-byte struct arg that FITS the argument registers is coerced to
// the `[N x iW]` ABI value at the call site, while one that STRADDLES the
// reg/stack boundary on x64 is passed as a true `ptr byval(<T>)` (emit_mem_byval.bn).

// TestCallSiteAggCoercion pins that a fitting 16-byte struct arg is passed as
// `[2 x i64]` at the call site (LP64), matching the callee's coerced param.
func TestCallSiteAggCoercion() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type S struct { a int64; b int64 }\n"
			"func use(p S, q S) int64 {\n"
			"\treturn p.a + q.a\n"
			"}\n"
			"func main() {\n"
			"\tvar x S\n"
			"\tx.a = cast(int64, 1)\n"
			"\tprintln(use(x, x))\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call i64 @bn_F1_4_main1_3_use([2 x i64] ") {
		return fail("call to use should pass [2 x i64] coerced args")
	}
	return ""
}

// TestCallSiteStraddleByval pins that on x64 a memory-class (straddling) struct
// arg is passed `byval` at the call site and declared `byval` on the callee,
// while the earlier fitting args stay `[2 x i64]`.  dsum(lead, p1..p4 S): lead ->
// RDI, p1 -> RSI:RDX, p2 -> RCX:R8, so p3 straddles R9 (memory) and p4 is memory.
func TestCallSiteStraddleByval() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type S struct { a int64; b int64 }\n"
			"func dsum(lead int64, p1 S, p2 S, p3 S, p4 S) int64 {\n"
			"\treturn lead + p1.a + p2.a + p3.a + p4.a\n"
			"}\n"
			"func main() {\n"
			"\tvar x S\n"
			"\tx.a = cast(int64, 1)\n"
			"\tprintln(dsum(cast(int64, 9), x, x, x, x))\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// The callee declares p3/p4 as byval and p1/p2 as coerced [2 x i64].
	if !contains(out, "byval(") {
		return fail("straddling struct params must be declared byval on x64")
	}
	if !contains(out, "[2 x i64] ") {
		return fail("fitting struct params must stay coerced [2 x i64]")
	}
	// The call site passes a byval pointer for the memory-class args.
	if !contains(out, "ptr byval(") {
		return fail("call site must pass memory-class args as ptr byval")
	}
	setTarget64()
	return ""
}
