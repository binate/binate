package "pkg/binate/codegen"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the in-register aggregate `[N x i64]` ABI coercion
// (emit_agg_coerce.bn).  A <=16-byte named struct passed/returned by
// value must be emitted with the coerced `[N x i64]` ABI type at the
// param entry, the return, and the call site -- NOT as a first-class
// LLVM struct value, which LLVM lowers by field-expansion and so
// disagrees with the native backends' register packing across a
// cross-package (native<->LLVM) boundary.

// TestAggCoerce16ByteStructByValue checks that a {i64,i32} struct (16
// bytes with a trailing padding leaf) passed and returned by value uses
// the `[2 x i64]` coerced ABI on the define-line, the return, and the
// call site, while the body keeps operating on the first-class struct.
func TestAggCoerce16ByteStructByValue() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type S struct { sec int64; nsec int32 }\n")
	cb.Write("func mk(s int64, n int32) S {\n")
	cb.Write("\treturn S{sec: s, nsec: n}\n")
	cb.Write("}\n")
	cb.Write("func first(p S, q S) int64 {\n")
	cb.Write("\treturn p.sec + q.sec\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a S = mk(cast(int64, 1), cast(int32, 2))\n")
	cb.Write("\tvar b S = mk(cast(int64, 3), cast(int32, 4))\n")
	cb.Write("\tprintln(first(a, b))\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)

	// Param side: the callee declares `[2 x i64]` params, not the
	// first-class `%bn_main__S`.
	if !contains(out, "define i64 @bn_main__first([2 x i64] ") {
		return fail("first's params should be coerced to [2 x i64]")
	}
	// The body still reconstructs the struct value from the words.
	if !contains(out, " = load %bn_main__S, ptr ") {
		return fail("expected struct reconstruction load in prologue")
	}
	// Return side: mk returns `[2 x i64]`, not `%bn_main__S`.
	if !contains(out, "define [2 x i64] @bn_main__mk(") {
		return fail("mk should return the coerced [2 x i64] type")
	}
	if !contains(out, "ret [2 x i64] ") {
		return fail("expected coerced [2 x i64] return")
	}
	// Call site: args coerced to [2 x i64], result of mk bound back.
	if !contains(out, "call i64 @bn_main__first([2 x i64] ") {
		return fail("call to first should pass [2 x i64] args")
	}
	if !contains(out, "call [2 x i64] @bn_main__mk(") {
		return fail("call to mk should yield [2 x i64]")
	}
	var pass testing.TestResult
	return pass
}

// TestAggCoerce8ByteSubWordStruct checks that an {i32,i32} struct (8
// bytes, sub-word fields) -- which the native side coalesces into ONE
// word but LLVM's first-class form would expand to two i32 registers --
// is coerced to `[1 x i64]` by value.
func TestAggCoerce8ByteSubWordStruct() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type P struct { x int32; y int32 }\n")
	cb.Write("func sum(a P) int64 {\n")
	cb.Write("\treturn cast(int64, a.x) + cast(int64, a.y)\n")
	cb.Write("}\n")
	cb.Write("func mkp(x int32, y int32) P {\n")
	cb.Write("\treturn P{x: x, y: y}\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar p P = mkp(cast(int32, 5), cast(int32, 6))\n")
	cb.Write("\tprintln(sum(p))\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)

	if !contains(out, "define i64 @bn_main__sum([1 x i64] ") {
		return fail("sum's 8-byte struct param should coerce to [1 x i64]")
	}
	if !contains(out, "define [1 x i64] @bn_main__mkp(") {
		return fail("mkp should return the coerced [1 x i64] type")
	}
	var pass testing.TestResult
	return pass
}

// TestAggCoerceLargeStructStaysIndirect checks that a >16-byte struct is
// NOT coerced -- it keeps the `ptr` byval param / sret return
// convention.  Coercion is for in-register (<=16-byte) aggregates only.
func TestAggCoerceLargeStructStaysIndirect() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type Big struct { a int64; b int64; c int64 }\n")
	cb.Write("func take(g Big) int64 {\n")
	cb.Write("\treturn g.a + g.b + g.c\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar g Big = Big{a: cast(int64, 1), b: cast(int64, 2), c: cast(int64, 3)}\n")
	cb.Write("\tprintln(take(g))\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)

	// A 24-byte struct param is `ptr` (indirect), never `[N x i64]`.
	if !contains(out, "define i64 @bn_main__take(ptr ") {
		return fail("a 24-byte struct param should stay indirect (ptr)")
	}
	if contains(out, "@bn_main__take([") {
		return fail("a 24-byte struct param must NOT be coerced to [N x i64]")
	}
	var pass testing.TestResult
	return pass
}
