package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for the in-register aggregate `[N x iW]` ABI coercion (W =
// pointer size — i64 on LP64, i32 on ILP32) (emit_agg_coerce.bn).  A
// <=16-byte named struct passed/returned by value must be emitted with
// the coerced `[N x iW]` ABI type at the param entry, the return, and
// the call site -- NOT as a first-class LLVM struct value, which LLVM
// lowers by field-expansion and so disagrees with the native backends'
// register packing across a cross-package (native<->LLVM) boundary.  The
// cases below pin the LP64 spelling (setTarget64), i.e. `[N x i64]`.

// TestAggCoerce16ByteStructByValue checks that a {i64,i32} struct (16
// bytes with a trailing padding leaf) passed and returned by value uses
// the `[2 x i64]` coerced ABI on the define-line, the return, and the
// call site, while the body keeps operating on the first-class struct.
func TestAggCoerce16ByteStructByValue() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type S struct { sec int64; nsec int32 }\n"
			"func mk(s int64, n int32) S {\n"
			"\treturn S{sec: s, nsec: n}\n"
			"}\n"
			"func first(p S, q S) int64 {\n"
			"\treturn p.sec + q.sec\n"
			"}\n"
			"func main() {\n"
			"\tvar a S = mk(cast(int64, 1), cast(int32, 2))\n"
			"\tvar b S = mk(cast(int64, 3), cast(int32, 4))\n"
			"\tprintln(first(a, b))\n"
			"}\n"
	var out @[]char = compileToLLVM(src)

	// Param side: the callee declares `[2 x i64]` params, not the
	// first-class `%bn_S1_4_main1_1_S`.
	if !contains(out, "define i64 @bn_F1_4_main1_5_first([2 x i64] ") {
		return fail("first's params should be coerced to [2 x i64]")
	}
	// The body still reconstructs the struct value from the words.
	if !contains(out, " = load %bn_S1_4_main1_1_S, ptr ") {
		return fail("expected struct reconstruction load in prologue")
	}
	// Return side: mk returns `[2 x i64]`, not `%bn_S1_4_main1_1_S`.
	if !contains(out, "define [2 x i64] @bn_F1_4_main1_2_mk(") {
		return fail("mk should return the coerced [2 x i64] type")
	}
	if !contains(out, "ret [2 x i64] ") {
		return fail("expected coerced [2 x i64] return")
	}
	// Call site: args coerced to [2 x i64], result of mk bound back.
	if !contains(out, "call i64 @bn_F1_4_main1_5_first([2 x i64] ") {
		return fail("call to first should pass [2 x i64] args")
	}
	if !contains(out, "call [2 x i64] @bn_F1_4_main1_2_mk(") {
		return fail("call to mk should yield [2 x i64]")
	}
	var pass testing.TestResult
	return pass
}

// TestAggCoerce8ByteSubWordStruct checks that an {i32,i32} struct (8
// bytes, sub-word fields) -- which the native side coalesces into ONE
// word but LLVM's first-class form would expand to two i32 registers --
// is coerced to `[1 x i64]` by value.
func TestAggCoerce8ByteSubWordStruct() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type P struct { x int32; y int32 }\n"
			"func sum(a P) int64 {\n"
			"\treturn cast(int64, a.x) + cast(int64, a.y)\n"
			"}\n"
			"func mkp(x int32, y int32) P {\n"
			"\treturn P{x: x, y: y}\n"
			"}\n"
			"func main() {\n"
			"\tvar p P = mkp(cast(int32, 5), cast(int32, 6))\n"
			"\tprintln(sum(p))\n"
			"}\n"
	var out @[]char = compileToLLVM(src)

	if !contains(out, "define i64 @bn_F1_4_main1_3_sum([1 x i64] ") {
		return fail("sum's 8-byte struct param should coerce to [1 x i64]")
	}
	if !contains(out, "define [1 x i64] @bn_F1_4_main1_3_mkp(") {
		return fail("mkp should return the coerced [1 x i64] type")
	}
	var pass testing.TestResult
	return pass
}

// TestAggCoerceLargeStructStaysIndirect checks that a >16-byte struct is
// NOT coerced -- it keeps the `ptr` byval param / sret return
// convention.  Coercion is for in-register (<=16-byte) aggregates only.
func TestAggCoerceLargeStructStaysIndirect() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"func take(g Big) int64 {\n"
			"\treturn g.a + g.b + g.c\n"
			"}\n"
			"func main() {\n"
			"\tvar g Big = Big{a: cast(int64, 1), b: cast(int64, 2), c: cast(int64, 3)}\n"
			"\tprintln(take(g))\n"
			"}\n"
	var out @[]char = compileToLLVM(src)

	// A 24-byte struct param is `ptr` (indirect), never `[N x i64]`.
	if !contains(out, "define i64 @bn_F1_4_main1_4_take(ptr ") {
		return fail("a 24-byte struct param should stay indirect (ptr)")
	}
	if contains(out, "@bn_F1_4_main1_4_take([") {
		return fail("a 24-byte struct param must NOT be coerced to [N x i64]")
	}
	var pass testing.TestResult
	return pass
}
