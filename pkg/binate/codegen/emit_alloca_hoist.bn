package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"

// emitEntryAllocaDecls emits — at the top of the function entry block —
// the `alloca` declaration for every alloca-producing instruction in f,
// scanning ALL blocks (not just the entry block).  An LLVM `alloca` in a
// non-entry block allocates fresh native stack each time control reaches
// it and is not freed until the function returns, so a construct that
// emits its alloca inside a loop body / if-branch leaks native stack per
// execution and eventually SIGSEGVs (stack overflow).  Hoisting every
// alloca here defeats that.
//
// EVERY op whose lowering emits an alloca must be handled here — this
// dispatch must stay exhaustive (conformance/check-alloca-hoist.py and
// the matrix/loop-leak cells guard against a new op emitting an
// un-hoisted alloca).  The sources:
//   - OP_ALLOC: ordinary stack-allocated locals.
//   - OP_CONST_NIL (aggregate): the `.a` zero-fill slot for a nil
//     slice / managed-slice / func-value / iface-value / struct / array
//     (e.g. a default-initialized `var m @[]char`).
//   - OP_MAKE_SLICE: bn_pkg__builtins__rt__MakeManagedSlice's .p slot.
//   - OP_RODATA_MSLICE_COPY: the same .p slot (it too calls
//     MakeManagedSlice via sret).
//   - OP_RODATA_ARRAY: the `.tmp` [N x i8] slot for a
//     `var a [N]char = "..."` string→array copy.
//   - OP_BOX: the `.tmp` spill slot when boxing a scalar register
//     (a box() of an existing alloca needs none).
//   - sret OP_CALL: the .sret out-parameter slot for callees that return
//     a large struct via sret convention.
//   - byval OP_CALL: the .bv<i> spill slot for each aggregate arg passed
//     by value (callee takes a >16-byte struct).
//   - OP_CALL_FUNC_VALUE: the .ap<i> aggregate-arg slots and the .rb
//     aggregate-return retbuf of a function-value call.
//   - OP_CALL_IFACE_METHOD: the .rb sret buffer for an iface-method call
//     returning a >16-byte aggregate.
//   - OP_CALL_INDIRECT: the .rb sret buffer for an indirect call returning
//     a >16-byte aggregate (e.g. _call_shim_quad).
// In each case only the alloca is emitted here at entry; the rest of the
// lowering (zero-init store, call body, load, etc.) stays at the instr's
// original location.
func emitEntryAllocaDecls(out *buf.Builder, f @ir.Func,
		dbgSubprogramID int, funcRetTypes *[]FuncRetType) {
	for hi := 0; hi < len(f.Blocks); hi++ {
		var hblk @ir.Block = f.Blocks[hi]
		for hj := 0; hj < len(hblk.Instrs); hj++ {
			var hinstr @ir.Instr = hblk.Instrs[hj]
			// Emit this hoisted slot's alloca decls into a temp builder
			// so the debug path can splice !dbg onto the last line as the
			// snapshot is appended to out (Builder is append-only).
			var tmp @buf.Builder = buf.NewBuilder()
			var hadAlloc bool = false
			if hinstr.Op == ir.OP_ALLOC {
				emitAllocDecl(tmp, hinstr)
				hadAlloc = true
			} else if hinstr.Op == ir.OP_CONST_NIL {
				// Aggregate nil's `.a` zero-fill slot; raw-pointer
				// nil emits nothing (no alloca to hoist).
				emitConstNilAllocDecl(tmp, hinstr)
				hadAlloc = tmp.Len() > 0
			} else if hinstr.Op == ir.OP_MAKE_SLICE {
				emitMakeSliceAllocDecl(tmp, hinstr)
				hadAlloc = true
			} else if hinstr.Op == ir.OP_RODATA_MSLICE_COPY {
				// emitStringToCharsCopy also calls MakeManagedSlice
				// now via sret; hoist its `.p` alloca to entry block.
				emitMakeSliceAllocDecl(tmp, hinstr)
				hadAlloc = true
			} else if hinstr.Op == ir.OP_RODATA_ARRAY {
				// `var a [N]char = "..."` — the `.tmp` [N x i8]
				// copy/zero-pad slot.
				emitStringToArrayAllocDecl(tmp, hinstr)
				hadAlloc = true
			} else if hinstr.Op == ir.OP_BOX {
				// box() of a scalar register — the `.tmp` spill
				// slot (nothing for an OP_ALLOC source).
				emitBoxAllocDecl(tmp, hinstr)
				hadAlloc = tmp.Len() > 0
			} else if hinstr.Op == ir.OP_CALL {
				// Byval spill slots first, then the sret slot:
				// addDbgToLastLine below annotates only the LAST
				// emitted line, so emitting sret last preserves its
				// existing !dbg attribution (byval allocas, rare to
				// coexist with sret, go un-annotated — LLVM tolerates
				// allocas without !dbg).
				emitByvalAllocDecls(tmp, hinstr)
				emitSretAllocDecl(tmp, hinstr, funcRetTypes)
				hadAlloc = tmp.Len() > 0
			} else if hinstr.Op == ir.OP_CALL_FUNC_VALUE {
				// .ap<i> aggregate-arg slots + .rb retbuf for a
				// function-value call (emitCallFuncValue /
				// emitFuncValueArgPreamble keep the stores / bitcasts
				// / call / load at the call site).
				emitFuncValueCallAllocDecls(tmp, hinstr)
				hadAlloc = tmp.Len() > 0
			} else if hinstr.Op == ir.OP_CALL_IFACE_METHOD {
				// .bv<i> spill slots for >16-byte by-value aggregate
				// args, plus the .rb sret buffer for an iface-method
				// call returning a >16-byte aggregate.
				emitByvalAllocDecls(tmp, hinstr)
				emitIfaceMethodSretAllocDecl(tmp, hinstr)
				hadAlloc = tmp.Len() > 0
			} else if hinstr.Op == ir.OP_CALL_INDIRECT {
				// .rb sret buffer for an indirect call returning a
				// >16-byte aggregate (e.g. _call_shim_quad).
				emitIndirectCallSretAllocDecl(tmp, hinstr)
				hadAlloc = tmp.Len() > 0
			}
			if hadAlloc && dbgSubprogramID >= 0 {
				var hline int = hinstr.Line
				if hline <= 0 { hline = 1 }
				addDbgToLastLine(out, buf.CopyStr(tmp.String()), hline,
					dbgSubprogramID)
			} else {
				out.Write(tmp.String())
			}
		}
	}
	return
}
