package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests the alloca-hoist invariant enforced by emitEntryAllocaDecls: every
// alloca a construct's lowering emits lands in the function ENTRY block,
// never inside a loop body / if-branch.  An LLVM alloca in a non-entry
// block allocates fresh native stack each time control reaches it and is
// not freed until the function returns, so a construct emitting its alloca
// inside a loop leaks native stack per iteration and SIGSEGVs (stack
// overflow).  Each test compiles a leak-prone construct inside a loop and
// asserts its alloca appears BEFORE the first `for.body` label — i.e. it
// was hoisted to the entry block.  The conformance/matrix/loop-leak cells
// are the end-to-end siblings; conformance/check-alloca-hoist.py is the
// whole-corpus static checker.

// allocaHoistedAboveLoop reports whether `allocaNeedle` occurs in `out`
// and at an earlier offset than the first `for.body` label — the alloca
// was hoisted to the entry block rather than left inside the loop.
func allocaHoistedAboveLoop(out *[]readonly char,
		allocaNeedle *[]readonly char) bool {
	var aIdx int = indexAfter(out, allocaNeedle, 0)
	if aIdx < 0 { return false }
	var loopIdx int = indexAfter(out, "for.body", 0)
	if loopIdx < 0 { return false }
	return aIdx < loopIdx
}

// OP_CONST_NIL: a default-init managed-slice local in a loop — the
// original leak (claude-todo.md). Its `.a` slot must be hoisted.
func TestAllocaHoistConstNilManagedSliceInLoop() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"func main() {\n"
		"\tfor i := 0; i < 3; i++ {\n"
		"\t\tvar m @[]char\n"
		"\t\t_ = len(m)\n"
		"\t}\n"
		"}\n")
	if !contains(out, "alloca %BnManagedSlice") {
		return fail("expected a managed-slice alloca")
	}
	if !allocaHoistedAboveLoop(out, "alloca %BnManagedSlice") {
		return fail("managed-slice .a alloca must be hoisted above for.body")
	}
	return ""
}

// OP_CONST_NIL: a default-init func-value local in a loop.
func TestAllocaHoistConstNilFuncValueInLoop() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"func main() {\n"
		"\tfor i := 0; i < 3; i++ {\n"
		"\t\tvar f *func()\n"
		"\t\t_ = f\n"
		"\t}\n"
		"}\n")
	if !allocaHoistedAboveLoop(out, "alloca %BnFuncValue") {
		return fail("func-value .a alloca must be hoisted above for.body")
	}
	return ""
}

// OP_RODATA_ARRAY: `var a [N]char = "..."` in a loop — the `.tmp`
// [N x i8] slot must be hoisted.
func TestAllocaHoistRodataArrayInLoop() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"func main() {\n"
		"\tfor i := 0; i < 3; i++ {\n"
		"\t\tvar a [5]char = \"hello\"\n"
		"\t\t_ = a[0]\n"
		"\t}\n"
		"}\n")
	if !contains(out, "alloca [5 x i8]") {
		return fail("expected a [5 x i8] .tmp alloca")
	}
	if !allocaHoistedAboveLoop(out, "alloca [5 x i8]") {
		return fail("rodata-array .tmp alloca must be hoisted above for.body")
	}
	return ""
}

// OP_BOX: box() of a scalar register in a loop — the `.tmp` spill slot
// must be hoisted.
func TestAllocaHoistBoxScalarInLoop() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"func main() {\n"
		"\tfor i := 0; i < 3; i++ {\n"
		"\t\tvar p @int = box(i)\n"
		"\t\t_ = p\n"
		"\t}\n"
		"}\n")
	if !contains(out, "@bn_pkg__builtins__rt__Box") {
		return fail("expected a Box call")
	}
	if !allocaHoistedAboveLoop(out, "alloca i64") {
		return fail("box .tmp alloca must be hoisted above for.body")
	}
	return ""
}

// Control: a plain default-init struct local (OP_ALLOC) must also be
// hoisted (it always has been) — guards against a regression there.
func TestAllocaHoistAllocStructInLoop() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"type Pt struct {\n"
		"\tx int\n"
		"\ty int\n"
		"}\n"
		"func main() {\n"
		"\tfor i := 0; i < 3; i++ {\n"
		"\t\tvar p Pt\n"
		"\t\t_ = p.x\n"
		"\t}\n"
		"}\n")
	if !allocaHoistedAboveLoop(out, "alloca %bn_main__Pt") {
		return fail("struct alloca must be hoisted above for.body")
	}
	return ""
}
