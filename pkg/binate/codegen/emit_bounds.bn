package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Inline bounds-check lowering
// ============================================================

// emitBoundsCheckInline emits inline LLVM IR for OP_BOUNDS_CHECK, in
// place of a call to `rt.BoundsCheck`(index, length).  It emits the
// two-compare signed fault condition `index < 0 || index >= length`
// — byte-identical to rt.BoundsCheck — and branches to a cold block
// that calls the noreturn `rt.BoundsFail`(index, length) on failure;
// the fall-through .ok block continues the in-bounds path.
//
// The compiled backends are fatal on a bounds fault (they ignore the
// VM's recoverable-fault pads), so the fail path aborts via BoundsFail
// — the exact sink rt.BoundsCheck itself calls, so the diagnostic is
// identical.  Inlining removes the opaque cross-TU call round-trip
// from the hot path of every checked access (rt lives in its own
// clang TU, so neither backend can inline a call to rt.BoundsCheck).
//
// Seeded from tmpSeq for per-emission unique labels (like
// emitRefIncInline).  The active LLVM block on entry terminates with
// the `br`; on return the active block is bc.<seq>.ok, so subsequent
// emissions in the same IR block fall into it.
//
// NOTE: the two signed compares could fold to ONE unsigned compare
// `(unsigned)index >= (unsigned)length`, shaving a compare — but that
// is sound only when length >= 0, which for slice range checks holds
// only via the lo/hi check ordering in gen_slice.bn (the length operand
// there is `hi+1`, a user value, not an extent).  clang -O2 folds the
// two-compare form to the single unsigned compare anyway, so this costs
// nothing at the standard build; it is kept explicit to match
// rt.BoundsCheck exactly.  The single-compare form could be adopted at
// bnc -O0 if that one instruction ever matters.
//
//   %bc.<seq>.neg = icmp slt <int> <idx>, 0
//   %bc.<seq>.oob = icmp sge <int> <idx>, <len>
//   %bc.<seq>.bad = or i1 %bc.<seq>.neg, %bc.<seq>.oob
//   br i1 %bc.<seq>.bad, label %bc.<seq>.fail, label %bc.<seq>.ok
//   bc.<seq>.fail:
//     call void @rt.BoundsFail(<int> <idx>, <int> <len>)
//     unreachable
//   bc.<seq>.ok:
//
// An index wider than int (an int64 / uint64 index on a 32-bit target) is
// checked as its whole 64-bit value: the length is sign-extended to i64 first
// (`%bc.<seq>.len`), and the fail path calls rt.BoundsFail64, which reports the
// index in full.
func emitBoundsCheckInline(out *strings.Builder, instr @ir.Instr) {
	var seq int = tmpSeq
	tmpSeq++
	var wide bool = types.IsWiderThanInt(instr.Args[0].Typ)
	var idxLL @[]char = intLL()
	if wide {
		idxLL = "i64"
		// len64 := sext len
		out.Write("%bc.")
		stringutils.WriteInt(out, seq)
		out.Write(".len = sext ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.Write(" to i64\n  ")
	}
	// neg := idx < 0
	out.Write("%bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".neg = icmp slt ")
	out.Write(idxLL)
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", 0\n")
	// oob := idx >= len
	out.Write("  %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".oob = icmp sge ")
	out.Write(idxLL)
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	if wide {
		out.Write("%bc.")
		stringutils.WriteInt(out, seq)
		out.Write(".len")
	} else {
		emitRef(out, instr.Args[1].ID)
	}
	out.Write("\n")
	// bad := neg || oob
	out.Write("  %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".bad = or i1 %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".neg, %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".oob\n")
	// branch on the fault condition
	out.Write("  br i1 %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".bad, label %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".fail, label %bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".ok\n")
	// .fail block: cold, noreturn abort with the identical diagnostic.
	out.Write("bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".fail:\n")
	out.Write("  call void @")
	if wide {
		out.Write(rtSym("BoundsFail64"))
	} else {
		out.Write(rtSym("BoundsFail"))
	}
	out.Write("(")
	out.Write(idxLL)
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, instr.Args[1].ID)
	out.Write(")\n")
	out.Write("  unreachable\n")
	// .ok block: subsequent IR-instructions emit here.
	out.Write("bc.")
	stringutils.WriteInt(out, seq)
	out.Write(".ok:\n")
	return
}
