package "pkg/binate/codegen"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the inline bounds-check lowering (emitBoundsCheckInline in
// emit_bounds.bn).  It replaces the old `call rt.BoundsCheck(idx, len)`
// with the two-compare signed fault condition (idx < 0 || idx >= len)
// branching to a cold `rt.BoundsFail` call.  Helpers (compileToLLVM,
// contains, fail) live in emit_test.bn.
//
// The index is a call result (ri()) so it is not a compile-time
// constant — the const-index BCE pass can't fold it (and does not run
// at level 0 anyway), so the check survives to the backend.

// TestEmitBoundsCheckInlined checks that an array index lowers to the
// inline compare/branch form (no rt.BoundsCheck call) with a cold
// rt.BoundsFail slow path.
func TestEmitBoundsCheckInlined() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func ri() int { return 2 }\n"
			"func main() {\n"
			"\tvar a [3]int\n"
			"\tvar x int = a[ri()]\n"
			"\t_ = x\n"
			"}\n"
	var out @[]char = compileToLLVM(src)

	// No call to rt.BoundsCheck (its `declare` may still be present, so
	// match the CALL form specifically).
	var callBC @strings.Builder = strings.NewBuilder()
	callBC.Write("call void @")
	callBC.Write(rtSym("BoundsCheck"))
	if contains(out, callBC.String()) {
		return fail("BoundsCheck should be inlined; no call to rt.BoundsCheck expected")
	}

	// The two-compare fault condition + cold BoundsFail call.
	if !contains(out, ".oob = icmp sge ") {
		return fail("expected inline `idx >= len` compare (icmp sge)")
	}
	if !contains(out, ".neg = icmp slt ") {
		return fail("expected inline `idx < 0` compare (icmp slt)")
	}
	var callBF @strings.Builder = strings.NewBuilder()
	callBF.Write("call void @")
	callBF.Write(rtSym("BoundsFail"))
	if !contains(out, callBF.String()) {
		return fail("expected cold-path call to rt.BoundsFail")
	}
	if !contains(out, "unreachable") {
		return fail("expected `unreachable` after the noreturn BoundsFail call")
	}
	if !contains(out, "bc.") {
		return fail("expected inline bounds-check labels (bc.<seq>.*)")
	}
	var pass testing.TestResult
	return pass
}

// countSubstr returns the number of non-overlapping occurrences of
// `needle` in `hay`.
func countSubstr(hay *[]readonly char, needle *[]readonly char) int {
	if len(needle) == 0 || len(needle) > len(hay) {
		return 0
	}
	var n int = 0
	var i int = 0
	for i <= len(hay) - len(needle) {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if hay[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match {
			n++
			i = i + len(needle)
		} else {
			i++
		}
	}
	return n
}

// TestEmitBoundsCheckTwoAccessesDistinctLabels checks that two surviving
// bounds checks in one function get distinct labels (no collision), so
// the emitted LLVM is well-formed.  Counts the `.fail:`/`.ok:` blocks
// rather than pinning specific seq numbers (tmpSeq state isn't
// contract).  For LLVM distinctness is guaranteed by the per-emission
// tmpSeq seed; the native backends carry the analogous regression guard
// where it matters more (void-instr ID reuse would collide).
func TestEmitBoundsCheckTwoAccessesDistinctLabels() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func ri() int { return 1 }\n"
			"func main() {\n"
			"\tvar a [3]int\n"
			"\tvar x int = a[ri()]\n"
			"\tvar y int = a[ri()]\n"
			"\t_ = x\n"
			"\t_ = y\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// Two surviving checks → two `.fail:` blocks and two `.ok:` blocks.
	if countSubstr(out, ".fail:\n") < 2 {
		return fail("expected two inline bounds-check .fail blocks (one per access)")
	}
	if countSubstr(out, ".ok:\n") < 2 {
		return fail("expected two inline bounds-check .ok blocks (one per access)")
	}
	var pass testing.TestResult
	return pass
}
