package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// Memory-backed values (emit_bulk_value.bn) as by-value call arguments.
//
// A bulk aggregate argument is always passed by address: the callee receives a
// pointer to a copy of the value that the caller made for the call — the
// `.bv<i>` slot of a direct call or __c_call (a >16-byte IsByvalParam
// argument), or the `.ap<i>` slot of a function-value / interface-method call
// (the shim takes an aggregate argument by address).  A memory-backed argument
// fills that slot with one bulk copy from its private copy — or, when the call
// is the value's only use and in the value's block, the private copy itself is
// passed: nothing reads it after the call, so the callee may write to it as to a
// copy of its own.

// isBulkCallArg reports whether operand k of ins is a call argument passed by
// address whose slot can be filled from a memory-backed value: an IsByvalParam
// argument of a direct call or __c_call, or a by-address aggregate argument of
// a function-value / interface-method call (shimArgByAddress).
func isBulkCallArg(ins @ir.Instr, k int) bool {
	if ins.Op == iropcode.OP_CALL || ins.Op == iropcode.OP_C_CALL {
		return ins.Args[k].Typ != nil && ins.Args[k].Typ.IsByvalParam()
	}
	if k < 1 { return false }
	var fnTyp @types.Type
	var p int
	if ins.Op == iropcode.OP_CALL_FUNC_VALUE {
		// Args[0] is the function value; operand k is its parameter k-1.
		fnTyp = ins.Args[0].Typ
		p = k - 1
	} else if ins.Op == iropcode.OP_CALL_IFACE_METHOD {
		// Args[0] is the interface value; the method's parameter 0 is the
		// receiver, so operand k is parameter k.
		fnTyp = ifaceMethodFuncType(ins)
		p = k
	} else {
		return false
	}
	if fnTyp == nil || p >= len(fnTyp.Params) { return false }
	return shimArgByAddress(fnTyp.Params[p].Type)
}

// shimArgByAddress reports whether a function-value / interface-method call
// passes an argument of parameter type pt through its `.ap<i>` slot — the
// branch emitFuncValueArgPreamble takes for an aggregate that is neither split,
// float-slotted nor register-coerced.
func shimArgByAddress(pt @types.Type) bool {
	if is64ScalarShimSplit(pt) || isFloatScalarParam(pt) || aggParamCoerced(pt) { return false }
	return isAggregateArg(pt)
}

// bulkArgDirect reports whether argument v of call is passed as the address of
// v's own private copy: v is memory-backed, not an extracted member (whose
// memory is part of its aggregate's), the call is its only use, and the call is
// in v's block.  The block condition makes each fill of the copy reach the call
// at most once — a call in a loop whose body does not reload v would otherwise
// pass, from its second iteration on, a copy an earlier callee may have written
// to.
func bulkArgDirect(call @ir.Instr, v @ir.Instr) bool {
	if !isBulkMem(v) || v.Op == iropcode.OP_EXTRACT { return false }
	if v.ID >= len(curBulkUses) || curBulkUses[v.ID] != 1 { return false }
	if call.ID < 0 || call.ID >= len(curInstrBlock) { return false }
	return curInstrBlock[call.ID] == curInstrBlock[v.ID]
}

// byvalArgSlotRef returns the address a direct call or __c_call passes for its
// IsByvalParam argument i: the argument's private copy when bulkArgDirect,
// else the call's `%v<callID>.bv<i>` slot.
func byvalArgSlotRef(instr @ir.Instr, i int) @[]char {
	if bulkArgDirect(instr, instr.Args[i]) { return bulkMemRef(instr.Args[i]) }
	var sb @strings.Builder = strings.NewBuilder()
	emitRef(sb, instr.ID)
	sb.Write(".bv")
	stringutils.WriteInt(sb, i)
	return buf.CopyStr(sb.String())
}

// emitByvalArgFill emits, before a direct call or __c_call, the fill of
// IsByvalParam argument i's `.bv<i>` slot: a bulk copy from a memory-backed
// argument's private copy (nothing when that copy is passed itself), else a
// store of the SSA value.  Each line ends with the next line's indent.
func emitByvalArgFill(out *strings.Builder, instr @ir.Instr, i int) {
	var arg @ir.Instr = instr.Args[i]
	if bulkArgDirect(instr, arg) { return }
	if isBulkMem(arg) {
		emitMemCopy(out, byvalArgSlotRef(instr, i), bulkMemRef(arg), arg.Typ.SizeOf())
		out.Write("  ")
		return
	}
	out.Write("store ")
	out.Write(llvmType(arg.Typ))
	out.WriteByte(' ')
	emitRef(out, arg.ID)
	out.Write(", ptr ")
	out.Write(byvalArgSlotRef(instr, i))
	out.Write("\n  ")
}

// emitBulkShimArgFill emits, before a function-value / interface-method call,
// the `%v<callID>.ap8.<i>` address of memory-backed user argument i (operand
// i+1) of parameter type pt: its private copy when bulkArgDirect, else the
// call's `.ap<i>` slot filled from it by one bulk copy.  Each line ends with
// the next line's indent.
func emitBulkShimArgFill(out *strings.Builder, instr @ir.Instr, i int, pt @types.Type) {
	var arg @ir.Instr = instr.Args[i + 1]
	var slot @strings.Builder = strings.NewBuilder()
	if bulkArgDirect(instr, arg) {
		slot.Write(bulkMemRef(arg))
	} else {
		emitRef(slot, instr.ID)
		slot.Write(".ap")
		stringutils.WriteInt(slot, i)
		emitMemCopy(out, slot.String(), bulkMemRef(arg), pt.SizeOf())
		out.Write("  ")
	}
	emitRef(out, instr.ID)
	out.Write(".ap8.")
	stringutils.WriteInt(out, i)
	out.Write(" = bitcast ptr ")
	out.Write(slot.String())
	out.Write(" to i8*\n  ")
}
