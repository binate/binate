package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// bulkCoercedSrc declares D, an int nested in 20 one-element arrays, and F19, two
// float64s nested in 20 structs (deep, so bulk, and small enough to travel in
// registers), and functions passing and returning them every way: directly, through a
// function value and an interface method, among several results, (many) after six
// ints, where x86-64 has run out of registers and passes it in memory, and captured by
// a closure.
func bulkCoercedSrc() @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"main\"\ntype D ")
	for i := 0; i < 20; i++ { sb.Write("[1]") }
	sb.Write("int\ntype F0 struct {\n\ta float64\n\tb float64\n}\n")
	for i := 1; i < 20; i++ {
		sb.Write("type F")
		stringutils.WriteInt(sb, i)
		sb.Write(" struct {\n\tf F")
		stringutils.WriteInt(sb, i - 1)
		sb.Write("\n}\n")
	}
	sb.Write("var g D\nvar h F19\n"
			"interface Passer {\n\tpassD(a D) D\n}\n"
			"type Pass struct {\n\tn int\n}\n"
			"func (q *Pass) passD(a D) D { return a }\n"
			"impl *Pass : Passer\n"
			"func pass(a D) D { return a }\n"
			"func passF(a F19) F19 { return a }\n"
			"func take(a D) { g = a }\n"
			"func give() D { return g }\n"
			"func two(a D) (D, int) { return a, 1 }\n"
			"func many(a int, b int, c int, d int, e int, f int, x D) D { return x }\n"
			"func viaCall() {\n\tvar b D = pass(g)\n\tg = b\n\th = passF(h)\n}\n"
			"func viaValue() {\n\tvar fv *func(D) D = pass\n\tvar b D = fv(g)\n\tg = b\n}\n"
			"func viaIface() {\n\tvar q Pass\n\tvar p *Passer = &q\n\tvar b D = p.passD(g)\n"
			"\tg = b\n}\n"
			"func viaTwo() int {\n\tvar b D\n\tvar n int\n\tb, n = two(g)\n\tg = b\n\treturn n\n}\n"
			"func viaValueTwo() int {\n\tvar fv *func(D) (D, int) = two\n\tvar b D\n\tvar n int\n"
			"\tb, n = fv(g)\n\tg = b\n\treturn n\n}\n"
			"func viaMany() { g = many(1, 2, 3, 4, 5, 6, g) }\n"
			"func viaClosure() {\n\tvar x D = g\n\tvar f @func() = func() { take(x) }\n\tf()\n}\n"
			"func main() {\n\ttake(give())\n\tviaCall()\n\tviaValue()\n\tviaIface()\n"
			"\t_ = viaTwo() + viaValueTwo()\n\tviaMany()\n\tviaClosure()\n}\n")
	return buf.CopyStr(sb.String())
}

// bulkCoercedNames returns the functions of bulkCoercedSrc that pass or return a
// deep value.
func bulkCoercedNames() @[]@[]char {
	var list *[]readonly char = "pass passF passD take give two many viaCall viaValue viaIface "
			"viaTwo viaValueTwo viaMany"
	var n int = 1
	for i := 0; i < len(list); i++ {
		if list[i] == ' ' { n = n + 1 }
	}
	var names @[]@[]char = make_slice(@[]char, n)
	var k int = 0
	var start int = 0
	for i := 0; i <= len(list); i++ {
		if i == len(list) || list[i] == ' ' {
			names[k] = buf.CopyStr(list[start:i])
			k = k + 1
			start = i + 1
		}
	}
	return names
}

// llvmUserFuncBody is llvmFuncBody for a function the source declares: it skips the
// compiler's own functions (`@__shim…` and the like), which can carry the same name.
func llvmUserFuncBody(out *[]readonly char, name *[]readonly char) @[]char {
	var i int = 0
	for i < len(out) {
		var j int = i
		for j < len(out) && out[j] != '\n' { j = j + 1 }
		var line *[]readonly char = out[i:j]
		if len(line) > 7 && contains(line[0:7], "define ") && !contains(line, "@__") {
			var body @[]char = llvmFuncBody(out[i:], name)
			if len(body) > 0 && len(body) >= j - i && charsEqual(body[0:j - i], line) { return body }
		}
		i = j + 1
	}
	var none @[]char
	return none
}

// deepSSALine returns the first line of body that holds a value of a type spelled
// with marker as an SSA value — a load, store, insertvalue or extractvalue of it —
// or "" when there is none.
func deepSSALine(body *[]readonly char, marker *[]readonly char) @[]char {
	var i int = 0
	for i < len(body) {
		var j int = i
		for j < len(body) && body[j] != '\n' { j = j + 1 }
		var line *[]readonly char = body[i:j]
		if contains(line, marker) && !contains(line, "getelementptr") && !contains(line, "alloca") &&
				(contains(line, " = load ") || contains(line, "store ") || contains(line, "insertvalue") ||
						contains(line, "extractvalue")) {
			return buf.CopyStr(line)
		}
		i = j + 1
	}
	return buf.CopyStr("")
}

// A deep aggregate small enough to travel in registers never takes its SSA form at
// a call boundary: a parameter is read in its slot, an argument and a returned value
// are copied into theirs, and a result is read in the slot its registers are stored
// to — on every target, x86-64's SSE and memory-class forms among them.  Nor does
// it anywhere in the module: a closure's shim copies a capture into its slot.
func TestBulkCoercedNoSSAValue() testing.TestResult {
	var names @[]@[]char = bulkCoercedNames()
	var arches @[]int = make_slice(int, 3)
	arches[0] = types.ARCH_AA64
	arches[1] = types.ARCH_X64
	arches[2] = types.ARCH_ARM32
	for a := 0; a < len(arches); a++ {
		var out @[]char = compileForArch(bulkCoercedSrc(), arches[a])
		var arch @[]char = buf.CopyStr("aa64: ")
		if arches[a] == types.ARCH_X64 { arch = buf.CopyStr("x64: ") }
		if arches[a] == types.ARCH_ARM32 { arch = buf.CopyStr("arm32: ") }
		for k := 0; k < len(names); k++ {
			var body @[]char = llvmUserFuncBody(out, names[k])
			if len(body) == 0 { return fail(buf.Concat(arch, buf.Concat(names[k], " was not emitted"))) }
			var bad @[]char = deepSSALine(body, "[1 x [1 x [1 x")
			if len(bad) == 0 { bad = deepSSALine(body, "F19") }
			if len(bad) > 0 {
				return fail(buf.Concat(buf.Concat(arch, names[k]), buf.Concat(": an SSA value: ", bad)))
			}
		}
		var bad @[]char = deepSSALine(out, "[1 x [1 x [1 x")
		if len(bad) == 0 { bad = deepSSALine(out, "F19") }
		if len(bad) > 0 { return fail(buf.Concat(arch, buf.Concat("an SSA value: ", bad))) }
		var pass @[]char = llvmUserFuncBody(out, "pass")
		if !contains(pass, rtSym("MemCopy")) || !contains(pass, "%aggret.slot") {
			return fail(buf.Concat(arch, buf.Concat("pass: copied into the return slot: ", pass)))
		}
		var many @[]char = llvmUserFuncBody(out, "many")
		var viaMany @[]char = llvmUserFuncBody(out, "viaMany")
		if arches[a] == types.ARCH_X64 && (!contains(many, ".bv") || !contains(viaMany, ".agA6")) {
			return fail(buf.Concat("x64: x is passed in memory, read in the caller's copy: ", many))
		}
	}
	setTarget64()
	return ""
}

// A __c_call returning a deep aggregate in registers leaves it in the `.agRB` slot
// its registers are stored to: the bind loads nothing, and the value's memory is that
// slot.
func TestBulkCCallResultInRegisters() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var d @types.Type = types.TypInt()
	for i := 0; i < 20; i++ { d = types.MakeArrayType(d, 1) }
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var dst @ir.Instr = irbuild.EmitAlloc(e, d)
	var noArgs @[]@ir.Instr = make_slice(@ir.Instr, 0)
	var cc @ir.Instr = irbuild.EmitCCall(e, buf.CopyStr("cf"), noArgs, d, 0, false)
	irbuild.EmitStore(e, dst, cc)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	computeBulkMemValues(f, noFuncRetTypes())
	var mem bool = isBulkMem(cc)
	var sb @strings.Builder = strings.NewBuilder()
	emitCCall(sb, cc)
	var call @[]char = buf.CopyStr(sb.String())
	var ref @[]char = bulkMemRef(cc)
	clearBulkMemValues()
	setTarget64()
	if !mem { return fail("a deep __c_call result in registers should be memory-backed") }
	if contains(call, " = load ") { return fail(buf.Concat("no load of the result: ", call)) }
	if !contains(ref, ".agRB") {
		return fail(buf.Concat("the value's memory is the .agRB slot: ", ref))
	}
	return ""
}
