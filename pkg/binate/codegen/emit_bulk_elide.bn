package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/std/strings"

// Memory-backed loads (emit_bulk_value.bn) that read their source in place.
//
// A memory-backed load normally copies its source into a private slot, `.m`, so
// that its consumers see the bytes as they were at the load.  When the source
// provably keeps those bytes until the load's last use — common.AggLoadElision,
// the rule the native backends use to skip the same copy: the source is a
// confined stack slot not re-stored before the last use, or nothing that writes or
// frees memory lies between the load and its last use, and either every use reads
// a scalar field or the load's one use returns it or stores it whole — the copy
// is skipped and the load's memory is its source.  Each consumer reads the source
// where it runs: a store or return copies from it, a call argument is copied from
// it into the call's slot, and an extract reads its member from it.  A whole
// store's destination may overlap the source, so it copies as memmove does
// (curBulkOverlapping).
//
// Two further conditions keep every read inside the interval the rule checks:
// no bulk member of the load is itself memory-backed (its memory would be an
// address inside the source, read by its own later consumers), and the load is
// never passed to a callee as its own copy (bulkArgDirect) — the callee could
// write its argument, that is, the source.  A load whose only use is a by-value
// argument of a call in its block is left alone: it is passed its private copy
// (bulkArgDirect), one copy either way.

// curBulkElided[id] reports whether the memory-backed load with SSA id `id` of
// the function being emitted reads its source in place (markElidedBulkLoads).
var curBulkElided @[]bool

// curBulkOverlapping[id] reports whether the memory-backed load with SSA id `id` of the
// function being emitted reads its source in place for its one use, a whole store whose
// destination may overlap the source (common.AGG_LOAD_IN_PLACE_OVERLAPPING): the store
// copies as memmove does (emitBulkMemStore).
var curBulkOverlapping @[]bool

// curLastUseLoad[id] reports whether the load with value ID id of the function being
// emitted reads its slot in place for its one by-value argument use, the slot being
// dead after the call (common.LastUseArgLoads): the call passes the slot itself.
var curLastUseLoad @[]bool

// curLastUseSlot[id] reports whether the stack slot with value ID id is read in place
// by a load passed as its last use (curLastUseLoad): a call may pass the slot itself,
// so its alloca is aligned as a by-value argument (writeByvalSlotAlign).
var curLastUseSlot @[]bool

// isLastUseLoad reports whether the load with value ID id reads its slot in place for
// its one by-value argument use.
func isLastUseLoad(id int) bool {
	return id >= 0 && id < len(curLastUseLoad) && curLastUseLoad[id]
}

// markElidedBulkLoads decides which memory-backed loads of f read their source
// in place (see above), a load whose slot is dead after the call it is passed to
// among them (common.LastUseArgLoads).
func markElidedBulkLoads(f @ir.Func, n int) {
	curBulkElided = make_slice(bool, n)
	curBulkOverlapping = make_slice(bool, n)
	curLastUseLoad = common.LastUseArgLoads(f)
	curLastUseSlot = make_slice(bool, n)
	var keep @[]bool = make_slice(bool, n)
	// One index of f's uses answers every load's question, made at the first.
	var elider @common.AggLoadElider
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_EXTRACT && isBulkMem(ins) {
				var p @ir.Instr = ins.Args[0]
				if p.ID >= 0 && p.ID < n { keep[p.ID] = true }
				continue
			}
			for k := 0; k < len(ins.Args); k++ {
				var a @ir.Instr = ins.Args[k]
				if a == nil || a.Op != iropcode.OP_LOAD || !isBulkMem(a) { continue }
				if isBulkCallArg(ins, k) && bulkArgDirect(ins, a) { keep[a.ID] = true }
			}
		}
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op != iropcode.OP_LOAD || !isBulkMem(ins) { continue }
			if isLastUseLoad(ins.ID) && ins.Args[0].ID >= 0 && ins.Args[0].ID < n {
				curLastUseSlot[ins.Args[0].ID] = true
			}
			if isLastUseLoad(ins.ID) {
				curBulkElided[ins.ID] = true
			} else if !keep[ins.ID] {
				if elider == nil { elider = common.NewAggLoadElider(f) }
				var kind int = elider.Elision(ins)
				if kind != common.AGG_LOAD_COPIED { curBulkElided[ins.ID] = true }
				if kind == common.AGG_LOAD_IN_PLACE_OVERLAPPING { curBulkOverlapping[ins.ID] = true }
			}
		}
	}
}

// isBulkElided reports whether v is a memory-backed load reading its source in
// place.
func isBulkElided(v @ir.Instr) bool {
	return v != nil && v.ID >= 0 && v.ID < len(curBulkElided) && curBulkElided[v.ID]
}

// isBulkOverlapping reports whether v is a memory-backed load reading its source in
// place for a whole store whose destination may overlap it (curBulkOverlapping).
func isBulkOverlapping(v @ir.Instr) bool {
	return v != nil && v.ID >= 0 && v.ID < len(curBulkOverlapping) && curBulkOverlapping[v.ID]
}

// bulkLoadCopies reports whether memory-backed load ld copies its source into a
// private `.m` slot: it has a use and does not read its source in place.
func bulkLoadCopies(ld @ir.Instr) bool {
	return isBulkMem(ld) && !bulkMemUnused(ld) && !isBulkElided(ld) && !isRetbufLoad(ld.ID)
}

// writeBulkElidedRef writes the memory of load ld, which reads its source in
// place: the source address.
func writeBulkElidedRef(sb *strings.Builder, ld @ir.Instr) {
	emitPtrRef(sb, ld.Args[0])
}
