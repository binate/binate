package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// `var b = a` from a local only ever loaded and stored whole copies straight from
// a — the load reads its source in place, with no private copy.
func TestBulkLoadFromConfinedSlotReadsInPlace() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"var g [30]int\n"
			"func viaSlot() int {\n\tvar a [30]int = g\n\tvar b [30]int = a\n\treturn b[3]\n}\n"
			"func main() { _ = viaSlot() }\n"
	var fn @[]char = llvmFuncBody(compileToLLVM(src), "viaSlot")
	// No load keeps a private copy: the global's is stored whole with only a's slot
	// allocated between, so its store copies from g as memmove does.
	if countSubstr(fn, ".m = alloca") != 0 ||
			countSubstr(fn, "@llvm.memmove") + countSubstr(fn, "_MemMove(") != 1 {
		return fail(buf.Concat("no load keeps a private copy; the global's is memmoved: ", fn))
	}
	return ""
}

// elideFunc builds a function with a stack slot `a` of a bulk struct type
// (struct { data [20]int; n int }) whose address is confined to whole loads and
// stores, and a slot `d` of the same type.
func elideFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr, @types.Type) {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var flds @[]@types.Field = make_slice(@types.Field, 2)
	flds[0] = make(types.Field)
	flds[0].Name = buf.CopyStr("data")
	flds[0].Type = types.MakeArrayType(types.TypInt(), 20)
	flds[1] = make(types.Field)
	flds[1].Name = buf.CopyStr("n")
	flds[1].Type = types.TypInt()
	var st @types.Type = types.MakeStructType("", flds)
	var a @ir.Instr = irbuild.EmitAlloc(e, st)
	var d @ir.Instr = irbuild.EmitAlloc(e, st)
	return f, e, a, d, st
}

// A load from a confined slot that is stored elsewhere reads its source in place:
// no private copy, and the store copies straight from the slot.  Passed to two
// calls, such a load is copied from the slot into each call's slot.
func TestElidedBulkLoadStoreAndArg() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var e @ir.Block
	var a @ir.Instr
	var d @ir.Instr
	var st @types.Type
	f, e, a, d, st = elideFunc()
	var v @ir.Instr = irbuild.EmitLoad(e, a, st)
	irbuild.EmitStore(e, d, v)
	var w @ir.Instr = irbuild.EmitLoad(e, a, st)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = w
	var c @ir.Instr = irbuild.EmitCall(e, "g", args, types.TypInt())
	irbuild.EmitCall(e, "g", args, types.TypInt())
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	computeBulkMemValues(f, noFuncRetTypes())
	var elidedV bool = isBulkElided(v)
	var elidedW bool = isBulkElided(w)
	var sb @strings.Builder = strings.NewBuilder()
	emitLoadInstr(sb, v)
	var loadOut @[]char = buf.CopyStr(sb.String())
	var ref @[]char = bulkMemRef(v)
	var aRef @strings.Builder = strings.NewBuilder()
	emitPtrRef(aRef, a)
	var want @[]char = buf.CopyStr(aRef.String())
	var sb2 @strings.Builder = strings.NewBuilder()
	emitByvalArgFill(sb2, c, 0)
	var fill @[]char = buf.CopyStr(sb2.String())
	clearBulkMemValues()
	if !elidedV || !elidedW { return fail("loads from a confined slot should read it in place") }
	if len(loadOut) != 0 { return fail(buf.Concat("an in-place load copies nothing: ", loadOut)) }
	if !contains(ref, want) || len(ref) != len(want) {
		return fail(buf.Concat("an in-place load's memory is its source: ", ref))
	}
	if !contains(fill, ".bv0") || !contains(fill, want) {
		return fail(buf.Concat("the argument is copied from the source into .bv0: ", fill))
	}
	return ""
}

// A load with a memory-backed bulk member keeps its private copy (the member's
// memory would be inside the source, read after the checked interval), and so
// does a load passed to a __c_call (and also stored, so that it is not merely a
// sole call argument, which keeps its copy anyway).
func TestBulkLoadKeepsCopy() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var e @ir.Block
	var a @ir.Instr
	var d @ir.Instr
	var st @types.Type
	f, e, a, d, st = elideFunc()
	var v @ir.Instr = irbuild.EmitLoad(e, a, st)
	var data @ir.Instr = irbuild.EmitExtract(e, v, 0, types.MakeArrayType(types.TypInt(), 20))
	irbuild.EmitStore(e, irbuild.EmitAlloc(e, data.Typ), data)
	var w @ir.Instr = irbuild.EmitLoad(e, a, st)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = w
	irbuild.EmitCCall(e, buf.CopyStr("cf"), args, types.TypInt(), 1, false)
	irbuild.EmitStore(e, d, w)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	computeBulkMemValues(f, noFuncRetTypes())
	var memberKept bool = isBulkMem(v) && !isBulkElided(v) && isBulkMem(data)
	var cKept bool = isBulkMem(w) && !isBulkElided(w)
	clearBulkMemValues()
	if !memberKept { return fail("a load with a memory-backed member keeps its private copy") }
	if !cKept { return fail("a load passed to a __c_call keeps its private copy") }
	return ""
}

// A load through a pointer whose one use is a whole store reads its source in place,
// and the store copies as memmove does, its destination possibly overlapping the
// source — llvm.memmove hosted, rt.MemMove on bare metal; a load from a confined slot
// stored whole reads in place too, but its store, which cannot overlap, is a memcpy.
func TestBulkLoadStoredWholeMovesInPlace() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var e @ir.Block
	var a @ir.Instr
	var d @ir.Instr
	var st @types.Type
	f, e, a, d, st = elideFunc()
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(st))
	var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(st)), st)
	irbuild.EmitStore(e, d, v)
	var w @ir.Instr = irbuild.EmitLoad(e, a, st)
	irbuild.EmitStore(e, d, w)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	computeBulkMemValues(f, noFuncRetTypes())
	var inPlace bool = isBulkElided(v) && isBulkOverlapping(v) && isBulkElided(w) &&
			!isBulkOverlapping(w)
	var out @[]@[]char = make_slice(@[]char, 2)
	for h := 0; h < 2; h++ {
		SetHosted(h == 0)
		var sb @strings.Builder = strings.NewBuilder()
		for ii := 0; ii < len(e.Instrs); ii++ {
			if e.Instrs[ii].Op == iropcode.OP_STORE { emitStoreInstr(sb, e.Instrs[ii]) }
		}
		out[h] = buf.CopyStr(sb.String())
	}
	SetHosted(false)
	clearBulkMemValues()
	if !inPlace { return fail("both loads read in place; only the one through a pointer may overlap") }
	if countSubstr(out[0], "@llvm.memmove") != 1 || countSubstr(out[0], "@llvm.memcpy") != 1 {
		return fail(buf.Concat("hosted: one llvm.memmove, one llvm.memcpy: ", out[0]))
	}
	if countSubstr(out[1], rtSym("MemMove")) != 1 || countSubstr(out[1], rtSym("MemCopy")) != 1 {
		return fail(buf.Concat("bare metal: one rt.MemMove, one rt.MemCopy: ", out[1]))
	}
	return ""
}
