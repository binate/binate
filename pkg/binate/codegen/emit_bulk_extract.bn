package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Memory-backed values (emit_bulk_value.bn) read by OP_EXTRACT.
//
// An OP_EXTRACT of a field or element of a memory-backed aggregate reads it in
// place: a GEP to the member's address in the aggregate's memory, `%v<ID>.ep`,
// then a load of a scalar member, or a per-leaf load of a small aggregate
// member.  A bulk member is itself memory-backed, its memory being that
// address.  That memory is part of the parent's, which holds the parent's value
// until the parent's definition runs again; a use of the member is dominated by
// the extract, and every path from such a re-run to the use passes the extract
// again, so the use never sees a stale address.  Being part of the parent's
// memory, a member's is never handed to a callee as its own copy
// (bulkArgDirect).

// bulkExtractCandidate reports whether ins extracts a bulk member — memory-backed
// when its aggregate is (computeBulkMemValues).
func bulkExtractCandidate(ins @ir.Instr) bool {
	return ins.Op == iropcode.OP_EXTRACT && isBulkAggregate(ins.Typ)
}

// clearOrphanedBulkExtracts un-marks every memory-backed extract whose aggregate
// is not memory-backed, until none is left: a member's memory is its parent's.
func clearOrphanedBulkExtracts(f @ir.Func) {
	var changed bool = true
	for changed {
		changed = false
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_EXTRACT || !isBulkMem(ins) || isBulkMem(ins.Args[0]) { continue }
				curBulkMem[ins.ID] = false
				changed = true
			}
		}
	}
}

// emitBulkMemExtract lowers an OP_EXTRACT from memory-backed aggregate
// instr.Args[0]: the member's address `%v<ID>.ep`, then — unless the member is
// memory-backed itself — a load of it.  An unused memory-backed member emits
// nothing.
func emitBulkMemExtract(out *strings.Builder, instr @ir.Instr, funcRetTypes *[]FuncRetType) {
	if bulkMemUnused(instr) { return }
	var agg @ir.Instr = instr.Args[0]
	emitRef(out, instr.ID)
	out.Write(".ep = getelementptr inbounds ")
	out.Write(extractAggLLType(instr, funcRetTypes))
	out.Write(", ptr ")
	out.Write(bulkMemRef(agg))
	out.Write(", i32 0, i32 ")
	stringutils.WriteInt(out, structLLVMIndex(agg.Typ, instr.Index))
	out.WriteByte('\n')
	if isBulkMem(instr) { return }
	var addr @strings.Builder = strings.NewBuilder()
	emitRef(addr, instr.ID)
	addr.Write(".ep")
	if isAggregateForStore(instr.Typ) {
		emitAggregateLoadIntoSSAFrom(out, instr, addr.String())
		return
	}
	out.Write("  ")
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(llvmType(instr.Typ))
	out.Write(", ptr ")
	out.Write(addr.String())
	out.WriteByte('\n')
}
