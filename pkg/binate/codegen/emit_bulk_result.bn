package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"

// Memory-backed values (emit_bulk_value.bn) produced by calls and returned.
//
// A call whose bulk result comes back through a buffer the caller provides — the
// `.sret` slot of a direct call or __c_call, the `.rb` result buffer of a
// function-value or interface-method call — produces a memory-backed value
// whose bytes are that buffer; the whole-value load out of it is dropped.  The
// buffer belongs to the one call instruction, and only that call writes it —
// or a callee the value is handed to as its own copy, which bulkArgDirect
// allows only at the value's single use, in its block, so after the value's
// last read.  So it holds the value until the call runs again, and by then the
// value is dead: IR values are SSA, and a phi (the only way a value outlives
// its definition's next execution) does not accept the memory form.
//
// A `return v` of a memory-backed value from a function returning through sret
// copies v's bytes into the caller's buffer, `%v.retbuf`, with one bulk copy.

// bulkCallResult reports whether call ins produces a bulk value through a
// caller-provided buffer: a direct call whose callee returns through sret, a
// __c_call returning through sret, or a function-value / interface-method call
// with one aggregate result (its `.rb` buffer).
func bulkCallResult(ins @ir.Instr, funcRetTypes *[]FuncRetType) bool {
	if ins.ID < 0 || ins.Typ == nil || !isBulkAggregate(ins.Typ) { return false }
	if ins.Op == iropcode.OP_CALL {
		return lookupIsSret(funcRetTypes, mangle.FuncName(modulePkgName, ins.StrVal))
	}
	if ins.Op == iropcode.OP_C_CALL { return cCallRetSret(ins) }
	var fnTyp @types.Type
	if ins.Op == iropcode.OP_CALL_FUNC_VALUE {
		fnTyp = ins.Args[0].Typ
	} else if ins.Op == iropcode.OP_CALL_IFACE_METHOD {
		fnTyp = ifaceMethodFuncType(ins)
	} else {
		return false
	}
	return fnTyp != nil && len(fnTyp.Results) == 1 && isAggregateReturn(fnTyp)
}

// bulkResultBufferSuffix returns the name suffix of the pointer to the bytes of
// memory-backed value v: `.m` (the private copy of a load), `.sret` (a direct
// call's or __c_call's result slot), `.rb` (a function-value or
// interface-method call's result buffer) or `.ep` (an extracted member's
// address in its aggregate's memory).
func bulkResultBufferSuffix(v @ir.Instr) *[]readonly char {
	if v.Op == iropcode.OP_EXTRACT { return ".ep" }
	if v.Op == iropcode.OP_CALL || v.Op == iropcode.OP_C_CALL { return ".sret" }
	if v.Op == iropcode.OP_CALL_FUNC_VALUE || v.Op == iropcode.OP_CALL_IFACE_METHOD { return ".rb" }
	return ".m"
}

// bulkReturnSupported reports whether return ins accepts a memory-backed value:
// it returns one value, through sret.
func bulkReturnSupported(ins @ir.Instr) bool {
	return len(ins.Args) == 1 && currentFuncUsesSret
}

// emitBulkMemReturn lowers `return v` of memory-backed value v: one bulk copy
// of v's bytes into the caller's sret buffer, then `ret void`.
func emitBulkMemReturn(out *strings.Builder, v @ir.Instr) {
	emitMemCopy(out, "%v.retbuf", bulkMemRef(v), v.Typ.SizeOf())
	out.Write("  ret void\n")
}
