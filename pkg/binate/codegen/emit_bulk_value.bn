package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/strings"

// Memory-backed bulk aggregate values.
//
// An aggregate VALUE is normally an LLVM first-class SSA aggregate: an
// aggregate OP_LOAD is a per-leaf load + insertvalue chain, an OP_STORE of
// one a per-leaf extractvalue + store — O(leaves) IR, so a large array value
// makes the IR (and clang's memory compiling it) grow with its length.  A
// value of a BULK type (isBulkAggregate — more than bulkLeafThreshold leaves)
// is instead MEMORY-BACKED when every consumer of it accepts that form: its
// LLVM form is a pointer, `%v<ID>.m`, to a private function-scoped copy of its
// bytes, filled by one rt.MemCopy where the value is produced and read by one
// rt.MemCopy per consumer.  The private copy keeps the value's bytes as they
// were where it was evaluated, and makes each consumer's copy overlap-free.
//
// A bulk value with any consumer that does not accept the memory form keeps
// the SSA form.  Producers: an OP_LOAD.  Consumers: an OP_STORE of the value.

// curBulkMem[id] reports whether the value with SSA id `id` of the function
// being emitted is memory-backed (computeBulkMemValues).
var curBulkMem @[]bool

// computeBulkMemValues decides, for function f, which values are
// memory-backed: a bulk-typed OP_LOAD whose every use is as the stored value
// of an OP_STORE.
func computeBulkMemValues(f @ir.Func) {
	var n int = f.NextID
	if n < 0 { n = 0 }
	curBulkMem = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_LOAD && ins.ID >= 0 && ins.ID < n && isBulkAggregate(ins.Typ) {
				curBulkMem[ins.ID] = true
			}
		}
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			clearUnsupportedBulkUses(b.Instrs[ii], n)
		}
	}
}

// clearBulkMemValues forgets the memory-backed values of the function just
// emitted, so none is taken for a value of whatever is emitted next.
func clearBulkMemValues() {
	var none @[]bool
	curBulkMem = none
}

// clearUnsupportedBulkUses un-marks every memory-backed candidate ins uses
// other than as an OP_STORE's stored value (Args[1]) — including as a phi
// operand.
func clearUnsupportedBulkUses(ins @ir.Instr, n int) {
	for k := 0; k < len(ins.Args); k++ {
		var a @ir.Instr = ins.Args[k]
		if a == nil || a.ID < 0 || a.ID >= n || !curBulkMem[a.ID] { continue }
		if ins.Op == iropcode.OP_STORE && k == 1 { continue }
		curBulkMem[a.ID] = false
	}
	for k := 0; k < len(ins.Phis); k++ {
		var v *ir.Instr = ins.Phis[k].Val
		if v != nil && v.ID >= 0 && v.ID < n { curBulkMem[v.ID] = false }
	}
}

// isBulkMem reports whether v is a memory-backed value of the function being
// emitted.
func isBulkMem(v @ir.Instr) bool {
	return v != nil && v.ID >= 0 && v.ID < len(curBulkMem) && curBulkMem[v.ID]
}

// bulkMemRef returns `%v<ID>.m`, the pointer to memory-backed value v's bytes.
func bulkMemRef(v @ir.Instr) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	emitRef(sb, v.ID)
	sb.Write(".m")
	return buf.CopyStr(sb.String())
}

// emitBulkMemAllocDecl emits the entry-hoisted `%v<ID>.m = alloca <T>` slot of
// memory-backed value v (emitEntryAllocaDecls).
func emitBulkMemAllocDecl(out *strings.Builder, v @ir.Instr) {
	out.Write(bulkMemRef(v))
	out.Write(" = alloca ")
	out.Write(llvmType(v.Typ))
	out.WriteByte('\n')
}

// emitBulkMemLoad lowers a memory-backed OP_LOAD: one rt.MemCopy of the
// source's bytes into the value's slot.
func emitBulkMemLoad(out *strings.Builder, ld @ir.Instr) {
	var src @strings.Builder = strings.NewBuilder()
	emitPtrRef(src, ld.Args[0])
	emitRtMemCopy(out, bulkMemRef(ld), buf.CopyStr(src.String()), ld.Typ.SizeOf())
}

// emitBulkMemStore lowers an OP_STORE of memory-backed value v to the address
// dstPtr: one rt.MemCopy from the value's slot.
func emitBulkMemStore(out *strings.Builder, dstPtr @ir.Instr, v @ir.Instr) {
	var dst @strings.Builder = strings.NewBuilder()
	emitPtrRef(dst, dstPtr)
	emitRtMemCopy(out, buf.CopyStr(dst.String()), bulkMemRef(v), v.Typ.SizeOf())
}
