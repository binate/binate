package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// llvmFuncBody returns the text of the emitted LLVM function whose mangled name
// ends in `_<name>`, from its `define` line through its closing `}`; empty when
// there is none.
func llvmFuncBody(out *[]readonly char, name *[]readonly char) @[]char {
	var needle @[]char = buf.Concat(buf.Concat("_", name), "(")
	var i int = 0
	for i < len(out) {
		var j int = i
		for j < len(out) && out[j] != '\n' { j = j + 1 }
		var line *[]readonly char = out[i:j]
		if len(line) > 7 && contains(line[0:7], "define ") && contains(line, needle) {
			var k int = j + 1
			for k < len(out) {
				var m int = k
				for m < len(out) && out[m] != '\n' { m = m + 1 }
				if m - k == 1 && out[k] == '}' { return buf.CopyStr(out[i:m]) }
				k = m + 1
			}
			return buf.CopyStr(out[i:])
		}
		i = j + 1
	}
	var none @[]char
	return none
}

// A whole-array copy `d = src` of a bulk array (100 leaves) is two rt.MemCopy
// calls — into the loaded value's private slot, then into d — and builds no
// per-leaf SSA aggregate.
func TestBulkLoadStoreIsMemCopy() testing.TestResult {
	setTarget64()
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"var src [100]uint8\n"
					"func cp() int {\n"
					"\tvar d [100]uint8\n"
					"\td = src\n"
					"\treturn cast(int, d[3])\n"
					"}\n"
					"func main() { _ = cp() }\n")
	var fn @[]char = llvmFuncBody(out, "cp")
	if len(fn) == 0 { return fail("cp was not emitted") }
	if countSubstr(fn, rtSym("MemCopy")) != 2 {
		return fail("a bulk load + store should be two rt.MemCopy calls")
	}
	if contains(fn, "insertvalue") || contains(fn, "extractvalue") {
		return fail("a memory-backed bulk value must not build a per-leaf SSA aggregate")
	}
	return ""
}

// The analysis: a bulk OP_LOAD whose only use is as an OP_STORE's value is
// memory-backed; one with a use that does not accept the memory form (here a
// return other than through sret) keeps the SSA form.  clearBulkMemValues then
// forgets them all.
func TestComputeBulkMemValues() testing.TestResult {
	setTarget64()
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var arr @types.Type = types.MakeArrayType(types.TypUint8(), 100)
	var src @ir.Instr = irbuild.EmitAlloc(e, arr)
	var dst @ir.Instr = irbuild.EmitAlloc(e, arr)
	var stored @ir.Instr = irbuild.EmitLoad(e, src, arr)
	irbuild.EmitStore(e, dst, stored)
	var returned @ir.Instr = irbuild.EmitLoad(e, src, arr)
	var small @ir.Instr = irbuild.EmitLoad(e, src, types.MakeArrayType(types.TypUint8(), 16))
	irbuild.EmitStore(e, dst, small)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = returned
	irbuild.EmitReturn(e, rets)
	var was bool = currentFuncUsesSret
	currentFuncUsesSret = false
	computeBulkMemValues(f, noFuncRetTypes())
	currentFuncUsesSret = was
	if !isBulkMem(stored) { return fail("a bulk load used only by a store should be memory-backed") }
	if isBulkMem(returned) { return fail("a bulk load returned other than through sret stays SSA") }
	if isBulkMem(small) { return fail("a 16-leaf aggregate is not bulk") }
	clearBulkMemValues()
	if isBulkMem(stored) { return fail("clearBulkMemValues should forget the function's values") }
	return ""
}

// noFuncRetTypes is the empty callee table computeBulkMemValues takes for a
// hand-built function that calls nothing returning through sret.
func noFuncRetTypes() @[]FuncRetType {
	var none @[]FuncRetType
	return none
}
