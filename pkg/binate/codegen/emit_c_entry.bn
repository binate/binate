package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/std/strings"
import "pkg/stdx/slices"

// __c_entry (OP_C_ENTRY) hands C the address of a Binate function's C entry as a
// callback pointer.  On the LLVM backend the mangled entry is already
// C-ABI-callable for ARGUMENTS — LLVM's calling convention lowers each narrow
// argument with the ABI-correct extension — so, unlike the native backends, there
// is no argument-normalization thunk here.  But a multi-value RETURN whose C
// struct-return ABI diverges from Binate's internal register-return convention
// (cExportRetNeedsAdapt) is miscompiled if C calls the raw mangled entry: it reads
// the internal register / first-class-aggregate form, not the platform
// struct-return form (the same divergence #[c_export] adapts).  So for such a
// target the C entry becomes a weak `__centry.<mangled>` adaptation thunk
// (emitCAbiAdapterThunk with linkonce_odr linkage, reusing the #[c_export] return
// machinery), and OP_C_ENTRY takes the thunk's address instead.  The thunk name
// matches the native backends' cEntryThunkSym (`__centry.` + the same mangled
// tail; clang/ld then apply the object-format prefix that native's symPrefixed
// applies too), so a mixed-producer program coalesces the weak copies to one
// survivor — the pointer identity pkg.centry.identity wants.

// cEntryLLVMNeedsThunk reports whether __c_entry(tf) on the LLVM backend must
// reference a `__centry.<mangled>` return-adaptation thunk rather than tf's mangled
// entry directly.  Only a divergent multi-value return forces it — arguments need
// no LLVM-side adaptation.
func cEntryLLVMNeedsThunk(tf @ir.Func) bool {
	return cExportRetNeedsAdapt(tf)
}

// cEntryThunkLLVMName builds the `__centry.<mangled>` global name for a __c_entry
// target named `name` (an OP_C_ENTRY StrVal).  mangle.FuncName resolves a dotted
// (pre-qualified cross-package) name or a bare local one to the same symbol the
// entry uses; the `__centry.` prefix matches the native cEntryThunkSym, and clang's
// Mach-O leading-'_' / bare-ELF object mangling then lands on the same object
// symbol the native TUs emit, so the weak copies coalesce.
func cEntryThunkLLVMName(name *[]readonly char) @[]readonly char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("__centry.")
	out.Write(mangle.FuncName(modulePkgName, name))
	return out.String()
}

// emitCEntry lowers OP_C_ENTRY: __c_entry(f) yields the address of f's C entry as a
// raw i8*.  Normally that is f's mangled entry directly (LLVM lowers arguments
// C-ABI-correctly, so no adaptation is needed); but when f's multi-value return
// diverges from the C struct-return ABI (cEntryLLVMNeedsThunk) the address is the
// weak `__centry.<mangled>` return-adaptation thunk (emitCEntryThunks) instead, so
// a C caller of the callback reads the platform struct-return form.  The
// getelementptr-0 idiom yields the symbol's address as i8* without spelling f's
// (here irrelevant) function type.
func emitCEntry(out *strings.Builder, m @ir.Module, instr @ir.Instr) {
	var sym @[]readonly char = mangle.FuncName(modulePkgName, instr.StrVal)
	var tf @ir.Func
	var found bool
	tf, found = ir.CEntryTargetFunc(m, instr.StrVal)
	if found && cEntryLLVMNeedsThunk(tf) {
		sym = cEntryThunkLLVMName(instr.StrVal)
	}
	emitRef(out, instr.ID)
	out.Write(" = getelementptr i8, i8* @")
	out.Write(sym)
	out.Write(", i64 0\n")
}

// emitCEntryThunks emits one weak (linkonce_odr) `__centry.<mangled>`
// return-adaptation thunk per distinct __c_entry target in m whose return needs
// C-ABI adaptation (cEntryLLVMNeedsThunk).  Deduplicated by thunk name — the same
// callback __c_entry'd at several sites (or from several functions) needs one
// thunk.  Called once from EmitModule after the function bodies; a divergent
// multi-return's internal type comes from f.MultiReturnType directly, so a
// cross-package target absent from funcRetTypes still resolves.
func emitCEntryThunks(out *strings.Builder, m @ir.Module, funcRetTypes *[]FuncRetType) {
	var seen @[]@[]readonly char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern {
			continue
		}
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var ins @ir.Instr = blk.Instrs[ii]
				if ins.Op != iropcode.OP_C_ENTRY {
					continue
				}
				var tf @ir.Func
				var found bool
				tf, found = ir.CEntryTargetFunc(m, ins.StrVal)
				if !found || !cEntryLLVMNeedsThunk(tf) {
					continue
				}
				var name @[]readonly char = cEntryThunkLLVMName(ins.StrVal)
				if cEntryNameSeen(seen, name) {
					continue
				}
				seen = slices.Append[@[]readonly char](seen, name)
				emitCAbiAdapterThunk(out, tf, name, "linkonce_odr", funcRetTypes)
			}
		}
	}
}

// cEntryNameSeen reports whether `name` is already in the emitted-thunk set.
func cEntryNameSeen(seen @[]@[]readonly char, name *[]readonly char) bool {
	for i := 0; i < len(seen); i++ {
		if charsEqual(seen[i], name) {
			return true
		}
	}
	return false
}
