package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/std/strings"
import "pkg/stdx/slices"

// __c_entry (OP_C_ENTRY) hands C the address of a Binate function's C entry as a
// callback pointer.  For a target that needs a `__centry.<mangled>` thunk
// (common.CallConv.CEntryNeedsThunk — the decision shared with the native backends'
// collectCEntryThunkTargets) OP_C_ENTRY takes the weak `linkonce_odr` thunk's
// address instead of the raw mangled entry.  The thunk (emitCAbiAdapterThunk,
// reusing the #[c_export] return/parameter machinery) covers three cases:
//   - a multi-value RETURN whose C struct-return ABI diverges from Binate's internal
//     register-return convention;
//   - a >16-byte by-value aggregate PARAMETER whose C form (x86-64 `ptr byval` /
//     arm32 by-value coerced) differs from the internal plain `ptr`;
//   - a narrow GP register PARAMETER.  Unlike the first two — where calling the raw
//     mangled entry would MISCOMPILE (the return reads the internal aggregate form,
//     or the parameter reads a pointer C never passed) — a narrow argument is
//     already handled by LLVM's calling convention (it self-extends via the mangled
//     definition's signext/zeroext attributes), so the LLVM thunk is a pure
//     FORWARDER.  It is emitted anyway so the thunk-target set matches native's
//     exactly: the native backends DO route narrow-register args through the thunk,
//     and pkg.centry.identity requires both producers to hand out the same pointer.
// The thunk name matches the native backends' cEntryThunkSym (`__centry.` + the same
// mangled tail; clang/ld then apply the object-format prefix that native's
// symPrefixed applies too), so a mixed-producer program coalesces the weak copies to
// one survivor — the pointer identity pkg.centry.identity wants (ABI review #10).

// cEntryLLVMNeedsThunk reports whether __c_entry(tf) on the LLVM backend references
// a `__centry.<mangled>` thunk rather than tf's mangled entry directly.  It is the
// SAME decision every backend makes — common.CallConv.CEntryNeedsThunk for the
// current target — so the thunk-target set (and thus the pointer __c_entry(tf)
// yields) matches the native backends' collectCEntryThunkTargets EXACTLY, which is
// what closes the cross-producer pkg.centry.identity gap (ABI review #10).  For a
// narrow-register-parameter-only target the LLVM thunk is a pure FORWARDER — LLVM's
// calling convention already self-extends narrow arguments through the mangled
// definition's attributes, so functionally the bare entry would do; the thunk
// exists only so a mixed-producer link coalesces on the one `__centry.` symbol the
// native TUs also emit.
func cEntryLLVMNeedsThunk(tf @ir.Func) bool {
	return callConvForTarget().CEntryNeedsThunk(tf)
}

// cEntryThunkLLVMName builds the `__centry.<mangled>` global name for a __c_entry
// target named `name` (an OP_C_ENTRY StrVal).  mangle.FuncName resolves a dotted
// (pre-qualified cross-package) name or a bare local one to the same symbol the
// entry uses; the `__centry.` prefix matches the native cEntryThunkSym, and clang's
// Mach-O leading-'_' / bare-ELF object mangling then lands on the same object
// symbol the native TUs emit, so the weak copies coalesce.
func cEntryThunkLLVMName(name *[]readonly char) @[]readonly char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("__centry.")
	out.Write(mangle.FuncName(modulePkgName, name))
	return out.String()
}

// emitCEntry lowers OP_C_ENTRY: __c_entry(f) yields the address of f's C entry as a
// raw i8*.  For a target that needs a thunk (cEntryLLVMNeedsThunk) the address is
// the weak `__centry.<mangled>` thunk (emitCEntryThunks); otherwise it is f's
// mangled entry directly.  The getelementptr-0 idiom yields the symbol's address as
// i8* without spelling f's (here irrelevant) function type.
func emitCEntry(out *strings.Builder, m @ir.Module, instr @ir.Instr) {
	var sym @[]readonly char = mangle.FuncName(modulePkgName, instr.StrVal)
	var tf @ir.Func
	var found bool
	tf, found = ir.CEntryTargetFunc(m, instr.StrVal)
	if found && cEntryLLVMNeedsThunk(tf) {
		sym = cEntryThunkLLVMName(instr.StrVal)
	}
	emitRef(out, instr.ID)
	out.Write(" = getelementptr i8, i8* @")
	out.Write(sym)
	out.Write(", i64 0\n")
}

// emitCEntryThunks emits one weak (linkonce_odr) `__centry.<mangled>` thunk per
// distinct __c_entry target in m that needs one (cEntryLLVMNeedsThunk).
// Deduplicated by thunk name — the same callback __c_entry'd at several sites (or
// from several functions) needs one thunk.  Called once from EmitModule after the
// function bodies; a divergent multi-return's internal type comes from
// f.MultiReturnType directly, so a cross-package target absent from funcRetTypes
// still resolves.
func emitCEntryThunks(out *strings.Builder, m @ir.Module, funcRetTypes *[]FuncRetType) {
	var seen @[]@[]readonly char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern {
			continue
		}
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var ins @ir.Instr = blk.Instrs[ii]
				if ins.Op != iropcode.OP_C_ENTRY {
					continue
				}
				var tf @ir.Func
				var found bool
				tf, found = ir.CEntryTargetFunc(m, ins.StrVal)
				if !found || !cEntryLLVMNeedsThunk(tf) {
					continue
				}
				var name @[]readonly char = cEntryThunkLLVMName(ins.StrVal)
				if cEntryNameSeen(seen, name) {
					continue
				}
				seen = slices.Append[@[]readonly char](seen, name)
				emitCAbiAdapterThunk(out, tf, name, "linkonce_odr", funcRetTypes)
			}
		}
	}
}

// cEntryNameSeen reports whether `name` is already in the emitted-thunk set.
func cEntryNameSeen(seen @[]@[]readonly char, name *[]readonly char) bool {
	for i := 0; i < len(seen); i++ {
		if charsEqual(seen[i], name) {
			return true
		}
	}
	return false
}
