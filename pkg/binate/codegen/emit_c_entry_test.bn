package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the OP_C_ENTRY LLVM lowering (emit_instr.bn) used by the __c_entry
// builtin.  On the LLVM backend a Binate function's mangled entry is already
// C-ABI-callable, so __c_entry(f) lowers to the address of f's mangled symbol as
// a raw i8* via the getelementptr-0 idiom (no adaptation thunk, no function-type
// spelling).

// buildCEntryModule builds a module whose `caller` returns __c_entry(g) — a
// *uint8 code address (OP_C_ENTRY).  g need not be defined here: the emission
// references its mangled symbol by name.
func buildCEntryModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(types.TypUint8())
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var ce @ir.Instr = entry.EmitCEntry("g")
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ce
	entry.EmitReturn(retArgs)
	m.AddFunc(f)
	return m
}

// __c_entry(g) lowers to `getelementptr i8, i8* @<mangled g>, i64 0` — the
// function's own mangled entry taken as a raw i8*, no thunk and no function-type
// bitcast.
func TestEmitCEntryGep() testing.TestResult {
	var out @[]char = EmitModule(buildCEntryModule())
	if !contains(out, "getelementptr i8, i8* @bn_F1_4_main1_1_g, i64 0") {
		return fail(
				"expected __c_entry to lower to "
						"`getelementptr i8, i8* @bn_F1_4_main1_1_g, i64 0`")
	}
	// The result is produced by that getelementptr, NOT by a bitcast of the
	// function symbol to i8* (the degenerate LLVM case emits no adaptation — clang
	// folds @f to a ptr directly).
	if contains(out, "@bn_F1_4_main1_1_g to i8*") {
		return fail("__c_entry must not bitcast the function symbol to i8* on LLVM")
	}
	return ""
}

// __c_entry(f) where f's multi-value return DIVERGES from the C struct-return ABI
// must NOT hand C the raw mangled entry (which returns Binate's internal
// register/aggregate form) — it takes the address of a weak `__centry.<mangled>`
// return-adaptation thunk instead (emit_c_entry.bn), reusing the #[c_export]
// return machinery so a C caller of the callback reads the platform struct-return
// form.  (int64,int64,int64) 24B on x86-64: the C ABI sret's it, the internal
// convention register-returns it → the thunk stores the register result into the
// caller's sret buffer.
func TestEmitCEntryMultiReturnThunkX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"func mret() (int64, int64, int64) "
			"{ return cast(int64, 10), cast(int64, 20), cast(int64, 30) }\n"
			"func caller() *uint8 { return __c_entry(mret) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	// A weak (coalesced) __centry thunk is defined ...
	if !contains(out, "define linkonce_odr") || !contains(out, "@__centry.") {
		return fail("expected a weak linkonce_odr __centry.<mangled> return-adaptation thunk")
	}
	// ... and __c_entry takes ITS address, not the raw mangled entry.
	if !contains(out, "getelementptr i8, i8* @__centry.") {
		return fail("__c_entry(mret) must reference the __centry thunk, not the raw entry")
	}
	return ""
}

// __c_entry(f) where f's multi-value return needs NO adaptation (a word-sized
// (int64,int64), placed identically by both conventions) stays the degenerate
// case: the address of f's OWN mangled entry, no __centry thunk.  Pins that the
// thunk fires on the C-ABI DIVERGENCE, not on any multi-return.
func TestEmitCEntryWordSizedMultiReturnNoThunk() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"func mret2() (int64, int64) { return cast(int64, 1), cast(int64, 2) }\n"
			"func caller() *uint8 { return __c_entry(mret2) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if contains(out, "__centry.") {
		return fail("a word-sized multi-return needs no adaptation — no __centry thunk")
	}
	if !contains(out, "getelementptr i8, i8* @bn_") {
		return fail("__c_entry of a non-diverging return should reference the mangled entry directly")
	}
	return ""
}

// __c_entry of a PADDED multi-return ((int32,int64) — an interior pad between the
// sub-word i32 and the i64) must forward the mangled def's FLAT coerced boundary
// return type, not the raw packed `<{ i32, [4 x i8], i64 }>`: the pad shifts the
// i64 into the next return register, so calling the padded type reads the second
// field from the wrong register (a silent return-value miscompile — regression
// guard for the __centry thunk's internal-call retTyp).
func TestEmitCEntryPaddedMultiReturnCoerced() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"func mretp() (int32, int64) { return cast(int32, 11), cast(int64, 22) }\n"
			"func caller() *uint8 { return __c_entry(mretp) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "%r = call { i32,") {
		return fail("the __centry thunk must call the flat { i32, i64 } coerced multi-return")
	}
	if contains(out, "%r = call <{ i32,") {
		return fail("the __centry thunk must NOT call the raw packed <{ i32, [4 x i8], i64 }>")
	}
	return ""
}

// __c_entry(f) where f takes a >16-byte by-value aggregate PARAMETER needs a
// __centry adaptation thunk on x86-64: the SysV ABI passes the 24-byte struct
// MEMORY class (`ptr byval`) while the mangled entry takes a plain `ptr`, so a C
// caller of the raw entry would mis-pass the struct.  Pins that cEntryLLVMNeedsThunk
// fires on a divergent PARAMETER, not only a divergent return.
func TestEmitCEntryByvalParamThunkX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"func cb(s Big) int64 { return s.a }\n"
			"func caller() *uint8 { return __c_entry(cb) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "define linkonce_odr") || !contains(out, "@__centry.") {
		return fail("expected a weak __centry thunk for a byval-param __c_entry target on x64")
	}
	if !contains(out, "getelementptr i8, i8* @__centry.") {
		return fail(
				"__c_entry(cb) with a byval param must reference the __centry thunk, not the raw entry")
	}
	return ""
}

// The SAME byval-param callback needs NO __centry thunk on AArch64: AAPCS64 passes a
// >16-byte aggregate INDIRECTLY (a pointer) both at the C boundary and internally, so
// the mangled entry is already C-callable and __c_entry references it directly.  Pins
// the target-gating of cEntryLLVMNeedsThunk (the param divergence is x86-64/arm32
// only), the LLVM analogue of the native TestCEntryByvalParamNoThunkAA64.
func TestEmitCEntryByvalParamNoThunkAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"func cb(s Big) int64 { return s.a }\n"
			"func caller() *uint8 { return __c_entry(cb) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "__centry.") {
		return fail(
				"a byval param needs no adaptation on aa64 (indirect both ways) — no __centry thunk")
	}
	if !contains(out, "getelementptr i8, i8* @bn_") {
		return fail(
				"__c_entry of a byval-param callback on aa64 should reference the mangled entry directly")
	}
	return ""
}
