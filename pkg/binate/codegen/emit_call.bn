package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/types"

// ============================================================
// Call lowering
// ============================================================

// emitCall emits a call instruction, handling sret, name mangling, and arg width casts.
func emitCall(out *buf.Builder, instr @ir.Instr, funcRetTypes *[]FuncRetType) {
	var isVoid bool = false
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID {
		isVoid = true
	}
	if instr.Typ == nil {
		isVoid = true
	}

	// Emit argument casts where LLVM actual type differs from declared/expected type
	for i := 0; i < len(instr.Args); i++ {
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		var targetBits int = declBits

		if argBits != targetBits && argBits > 0 && targetBits > 0 {
			out.Write("%v")
			buf.WriteInt(out, instr.ID)
			out.Write(".a")
			buf.WriteInt(out, i)
			if argBits > targetBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, instr.Args[i].ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(targetBits))
			out.Write("\n  ")
		}
	}

	// Pre-emit alloca + store for byval-eligible aggregate args so the
	// call line below can reference `%v<callID>.bv<i>` with byval.
	writeByvalArgPreamble(out, instr)

	// Mangle the function name (OP_CALL is the only call op now).
	var callNameBuf @[]char = mangle.FuncName(modulePkgName, instr.StrVal)

	// Check if this call needs sret (C extern returning large struct)
	var isSret bool = lookupIsSret(funcRetTypes, callNameBuf)
	var sretRetType @[]char
	if isSret {
		sretRetType = lookupRetType(funcRetTypes, callNameBuf)
	}

	if isSret {
		// Sret call: the `.sret` alloca is hoisted to function
		// entry by emitSretAllocDecl; here we only emit the
		// `call void` with sret first param + the result load.
		out.Write("call void @")
		out.Write(callNameBuf)
		out.Write("(ptr sret(")
		out.Write(sretRetType)
		out.Write(") align 8 ")
		emitRef(out, instr.ID)
		out.Write(".sret")
	} else if isVoid {
		out.Write("call void @")
		out.Write(callNameBuf)
		out.WriteByte('(')
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		var retStr @[]char = lookupRetType(funcRetTypes, callNameBuf)
		if len(retStr) > 0 {
			out.Write(retStr)
		} else {
			out.Write(llvmType(instr.Typ))
		}
		out.Write(" @")
		out.Write(callNameBuf)
		out.WriteByte('(')
	}

	for i := 0; i < len(instr.Args); i++ {
		if i > 0 || isSret {
			out.Write(", ")
		}
		writeByvalArgLLVM(out, instr, i)
	}

	out.Write(")\n")

	if isSret {
		// Load the result from the sret alloca
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(sretRetType)
		out.Write(", ptr ")
		emitRef(out, instr.ID)
		out.Write(".sret\n")
	}

	return
}

// emitCallIndirect emits an indirect call through a function pointer.
// instr.Args[0] is the fn_ptr (i8*); instr.Args[1..] are the call args;
// instr.Typ is the return type. The signature is reconstructed at the
// call site, the i8* is bitcast to the matching function-pointer type,
// then a `call` is emitted through the bitcasted register.
func emitCallIndirect(out *buf.Builder, instr @ir.Instr) {
	var isVoid bool = false
	if instr.Typ == nil { isVoid = true }
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID { isVoid = true }

	var nArgs int = len(instr.Args) - 1

	// Per-arg width casts (parallel to emitCall): emit zext/trunc when
	// the arg's LLVM-emitted width differs from its declared type's
	// width. The cast result is named `%v.ID.aN`.
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			buf.WriteInt(out, instr.ID)
			out.Write(".a")
			buf.WriteInt(out, i)
			if argBits > declBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, argInstr.ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(declBits))
			out.Write("\n  ")
		}
	}

	// A >16-byte single aggregate result is returned via an explicit sret
	// pointer (the `.rb` buffer hoisted by emitIndirectCallSretAllocDecl),
	// mirroring the callee's definition convention — same as the direct
	// (isSret) and iface-method paths.  Relying on LLVM to legalize a
	// by-value >16 struct return through the indirect `call` does NOT wire
	// the sret buffer for the callee, which reads X8 and writes to garbage.
	var useSret bool = singleResultUsesSret(instr.Typ)

	// Build the function-pointer LLVM type.  sret form prepends a `ptr`
	// param for the buffer: void(ptr, <arg_types>)*; otherwise
	// <ret>(<arg_types>)*.
	var sigBuf @buf.Builder = buf.NewBuilder()
	if useSret || isVoid {
		sigBuf.Write("void")
	} else {
		sigBuf.Write(llvmType(instr.Typ))
	}
	sigBuf.WriteByte('(')
	if useSret { sigBuf.Write("ptr") }
	for i := 0; i < nArgs; i++ {
		if i > 0 || useSret { sigBuf.Write(", ") }
		sigBuf.Write(llvmType(instr.Args[i + 1].Typ))
	}
	sigBuf.Write(")*")

	// Bitcast the i8* fn_ptr to the function-pointer type.
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(" to ")
	out.Write(sigBuf.String())
	out.Write("\n  ")

	// Emit the call through the bitcasted function pointer.
	if useSret {
		out.Write("call void %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(ptr sret(")
		out.Write(llvmType(instr.Typ))
		out.Write(") align 8 %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb")
	} else if isVoid {
		out.Write("call void %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(")
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		out.Write(llvmType(instr.Typ))
		out.Write(" %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(")
	}

	for i := 0; i < nArgs; i++ {
		if i > 0 || useSret { out.Write(", ") }
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		out.Write(llvmType(argInstr.Typ))
		out.WriteByte(' ')
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			buf.WriteInt(out, instr.ID)
			out.Write(".a")
			buf.WriteInt(out, i)
		} else {
			emitValRef(out, argInstr)
		}
	}
	out.Write(")\n")

	if useSret {
		// Load the result from the sret alloca to produce the SSA value.
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(llvmType(instr.Typ))
		out.Write(", ptr %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb\n")
	}
	return
}

// emitIndirectCallSretAllocDecl emits ONLY the `%v<id>.rb = alloca <ret>`
// for an OP_CALL_INDIRECT whose return uses the sret convention (a >16-byte
// single aggregate, e.g. a `_call_shim_quad` capturing a compiled iface
// method's managed-slice return).  Called from emitEntryAllocaDecls's
// alloca-hoist pre-pass; the call through the buffer and the result-load
// stay at the call site (emitCallIndirect).  Mirrors
// emitIfaceMethodSretAllocDecl, and the sret-vs-direct decision matches
// emitCallIndirect's `useSret` exactly so the hoisted alloca is emitted iff
// the call site references it.
func emitIndirectCallSretAllocDecl(out *buf.Builder, instr @ir.Instr) {
	if !singleResultUsesSret(instr.Typ) { return }
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".rb = alloca ")
	out.Write(llvmType(instr.Typ))
	out.Write("\n  ")
	return
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE: call through a 2-word
// {vtable_ptr, data_ptr} function value.
//
// Scalar/void return — Phase 3's always-shim shape from
// plan-function-values-phase-3.md: vtable.call has signature
// `<ret>(i8* data, <args>)*`.  Caller extracts data + vtable.call,
// bitcasts to the shim signature, passes data as the first argument.
//
// Aggregate return — retbuf-style shape: vtable.call has signature
// `void(i8* retbuf, i8* data, <args>)*`.  Caller allocates retbuf
// of the aggregate type's size on the stack, calls the shim, then
// loads the result back from retbuf.  The retbuf-style is uniform
// across compiled and bytecode dispatchers, so the same shim shape
// serves OP_CALL_FUNC_VALUE here and dispatchExternBinding's
// aggregate path in pkg/binate/vm.
func emitCallFuncValue(out *buf.Builder, instr @ir.Instr) {
	// Args[0] = function value; Args[1..] = call args.
	var fnVal @ir.Instr = instr.Args[0]
	var fnTyp @types.Type = fnVal.Typ
	if fnTyp == nil { return }
	var nArgs int = len(instr.Args) - 1

	var isVoid bool = false
	if instr.Typ == nil { isVoid = true }
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID { isVoid = true }
	var isAggregate bool = isAggregateReturn(fnTyp)

	// Extract data (field 1 of %BnFuncValue) → i8*. Passed as the
	// shim's first argument (or second, in retbuf shape).
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".dt = extractvalue %BnFuncValue ")
	emitRef(out, fnVal.ID)
	out.Write(", 1\n  ")
	// Extract vtable_ptr (field 0 of %BnFuncValue) → i8*.
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue %BnFuncValue ")
	emitRef(out, fnVal.ID)
	out.Write(", 0\n  ")
	// Bitcast to %BnVtable*.
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".vt8 to %BnVtable*\n  ")
	// GEP to vtable.call (field 1).
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".cp = getelementptr inbounds %BnVtable, %BnVtable* %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".vt, i32 0, i32 1\n  ")
	// Load the call slot (i8*).
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".cb = load i8*, i8** %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".cp\n  ")

	// Bitcast call slot to the shim signature.
	var sig @[]char = funcSignatureLLVM(fnTyp)
	out.Write("%v")
	buf.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".cb to ")
	out.Write(sig)
	out.Write("\n  ")

	// Pre-emit allocas + stores for aggregate args.  Each one becomes
	// a pointer-typed slot that the shim derefs internally.
	emitFuncValueArgPreamble(out, instr, fnTyp, nArgs)

	if isAggregate {
		// retbuf (%v<id>.rb) is hoisted to the entry block by
		// emitFuncValueCallAllocDecls; here we only bitcast it to
		// i8*, call the shim with (retbuf, data, args...), and load
		// the result back.
		out.Write("%v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb8 = bitcast ")
		writeFuncResultsLLVM(out, fnTyp)
		out.Write("* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb to i8*\n  ")
		out.Write("call void %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb8, i8* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".dt")
		emitFuncValueArgList(out, instr, fnTyp, nArgs)
		out.Write(")\n  ")
		// Load the result from retbuf.
		emitRef(out, instr.ID)
		out.Write(" = load ")
		writeFuncResultsLLVM(out, fnTyp)
		out.Write(", ")
		writeFuncResultsLLVM(out, fnTyp)
		out.Write("* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb\n")
		return
	}

	// Scalar/void path — original Phase 3 always-shim convention.
	if isVoid {
		out.Write("call void %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".dt")
		emitFuncValueArgList(out, instr, fnTyp, nArgs)
		out.Write(")\n")
		return
	}
	if isFloatScalarParam(instr.Typ) {
		// The shim returns the int slot; receive it into a temp, then
		// bitcast back to the natural float type as the result value.
		out.Write("%v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fc = call ")
		out.Write(shimIntSlotType(instr.Typ))
		out.Write(" %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".dt")
		emitFuncValueArgList(out, instr, fnTyp, nArgs)
		out.Write(")\n  ")
		emitRef(out, instr.ID)
		out.Write(" = bitcast ")
		out.Write(shimIntSlotType(instr.Typ))
		out.Write(" %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".fc to ")
		out.Write(llvmType(instr.Typ))
		out.Write("\n")
		return
	}
	emitRef(out, instr.ID)
	out.Write(" = call ")
	out.Write(llvmType(instr.Typ))
	out.Write(" %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".fn(i8* %v")
	buf.WriteInt(out, instr.ID)
	out.Write(".dt")
	emitFuncValueArgList(out, instr, fnTyp, nArgs)
	out.Write(")\n")
	return
}

// emitFuncValueArgPreamble emits the store + i8* bitcast for each
// aggregate arg in a function-value call, filling the %v<id>.ap<i>
// pointer slot that the call site references in place of the natural
// value.  The matching `alloca` for each slot is hoisted to the
// function entry block by emitFuncValueCallAllocDecls (emitFuncDbg's
// pre-pass) — NOT emitted here — so a function-value call passing an
// aggregate arg from inside a loop body doesn't leak a fresh slot
// per iteration.  See explorations/plan-codegen-byval-spill-hoist.md.
func emitFuncValueArgPreamble(out *buf.Builder, instr @ir.Instr,
		fnTyp @types.Type, nArgs int) {
	for i := 0; i < nArgs; i++ {
		var pt @types.Type = fnTyp.Params[i].Type
		if isFloatScalarParam(pt) {
			// Bitcast the natural float arg to its int slot so the call
			// matches the int-ified shim signature; the shim bitcasts
			// it back.  Ref is %v<id>.fb<i> (emitFuncValueArgList).
			var fArg @ir.Instr = instr.Args[i + 1]
			out.Write("%v")
			buf.WriteInt(out, instr.ID)
			out.Write(".fb")
			buf.WriteInt(out, i)
			out.Write(" = bitcast ")
			out.Write(llvmType(fArg.Typ))
			out.WriteByte(' ')
			emitRef(out, fArg.ID)
			out.Write(" to ")
			out.Write(shimIntSlotType(pt))
			out.Write("\n  ")
			continue
		}
		if !isAggregateArg(pt) { continue }
		var argInstr @ir.Instr = instr.Args[i + 1]
		// store <pt> %arg, <pt>* %slot; bitcast %slot to i8*.
		out.Write("store ")
		out.Write(llvmType(argInstr.Typ))
		out.WriteByte(' ')
		emitRef(out, argInstr.ID)
		out.Write(", ")
		out.Write(llvmType(pt))
		out.Write("* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".ap")
		buf.WriteInt(out, i)
		out.Write("\n  ")
		out.Write("%v")
		buf.WriteInt(out, instr.ID)
		out.Write(".ap8.")
		buf.WriteInt(out, i)
		out.Write(" = bitcast ")
		out.Write(llvmType(pt))
		out.Write("* %v")
		buf.WriteInt(out, instr.ID)
		out.Write(".ap")
		buf.WriteInt(out, i)
		out.Write(" to i8*\n  ")
	}
	return
}

// emitFuncValueCallAllocDecls emits ONLY the entry-block `alloca`
// lines an OP_CALL_FUNC_VALUE lowering needs: one `%v<id>.ap<i>` per
// aggregate arg (matching emitFuncValueArgPreamble) plus, for an
// aggregate-return func value, the `%v<id>.rb` retbuf (matching
// emitCallFuncValue).  Called from emitFuncDbg's alloca-hoist
// pre-pass; the stores / bitcasts / call / result-load stay at the
// call site.  Slot names derive purely from (instr.ID, arg index),
// so the entry allocas and the call-site references agree without
// extra plumbing.  Returns out unchanged if the call has no
// aggregate args and a non-aggregate return.
func emitFuncValueCallAllocDecls(out *buf.Builder,
		instr @ir.Instr) {
	var fnVal @ir.Instr = instr.Args[0]
	var fnTyp @types.Type = fnVal.Typ
	if fnTyp == nil { return }
	var nArgs int = len(instr.Args) - 1
	for i := 0; i < nArgs; i++ {
		var pt @types.Type = fnTyp.Params[i].Type
		if !isAggregateArg(pt) { continue }
		out.Write("%v")
		buf.WriteInt(out, instr.ID)
		out.Write(".ap")
		buf.WriteInt(out, i)
		out.Write(" = alloca ")
		out.Write(llvmType(pt))
		out.WriteByte('\n')
	}
	if isAggregateReturn(fnTyp) {
		out.Write("%v")
		buf.WriteInt(out, instr.ID)
		out.Write(".rb = alloca ")
		writeFuncResultsLLVM(out, fnTyp)
		out.WriteByte('\n')
	}
	return
}

// emitFuncValueArgList emits the comma-separated arg list following
// the (data,...) prefix in a function-value call.  Aggregate args
// reference the i8* preamble slot; scalars pass their natural value.
func emitFuncValueArgList(out *buf.Builder, instr @ir.Instr,
		fnTyp @types.Type, nArgs int) {
	for i := 0; i < nArgs; i++ {
		out.Write(", ")
		var pt @types.Type = fnTyp.Params[i].Type
		if isAggregateArg(pt) {
			out.Write("i8* %v")
			buf.WriteInt(out, instr.ID)
			out.Write(".ap8.")
			buf.WriteInt(out, i)
			continue
		}
		if isFloatScalarParam(pt) {
			// Pass the int slot filled by emitFuncValueArgPreamble.
			out.Write(shimIntSlotType(pt))
			out.Write(" %v")
			buf.WriteInt(out, instr.ID)
			out.Write(".fb")
			buf.WriteInt(out, i)
			continue
		}
		var argInstr @ir.Instr = instr.Args[i + 1]
		out.Write(llvmType(argInstr.Typ))
		out.WriteByte(' ')
		emitValRef(out, argInstr)
	}
	return
}
