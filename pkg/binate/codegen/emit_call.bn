package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Call lowering
// ============================================================

// emitCall emits a call instruction, handling sret, name mangling, and arg width casts.
func emitCall(out *strings.Builder, instr @ir.Instr, funcRetTypes *[]FuncRetType) {
	var isVoid bool = false
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID {
		isVoid = true
	}
	if instr.Typ == nil {
		isVoid = true
	}

	// Mangle the callee name and detect the sret shape up front: the sret
	// buffer pointer rides RDI on SysV, shifting every user arg up one GP
	// register, so the memory-class arg decision (aggMemClass, threaded into
	// the coercion preamble + arg emission below) must know it before those run.
	var callNameBuf @[]char = mangle.FuncName(modulePkgName, instr.StrVal)
	var isSret bool = lookupIsSret(funcRetTypes, callNameBuf)
	var sretRetType @[]char
	if isSret {
		sretRetType = lookupRetType(funcRetTypes, callNameBuf)
	}

	// Emit argument casts where LLVM actual type differs from declared/expected type
	for i := 0; i < len(instr.Args); i++ {
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		var targetBits int = declBits

		if argBits != targetBits && argBits > 0 && targetBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
			if argBits > targetBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, instr.Args[i].ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(targetBits))
			out.Write("\n  ")
		}
	}

	// Pre-emit alloca + store for byval-eligible aggregate args so the
	// call line below can reference `%v<callID>.bv<i>` with byval.
	writeByvalArgPreamble(out, instr)

	// Pre-emit store + load for in-register-aggregate args (struct/array
	// <= 16 bytes), coercing each to the `[N x iW]` ABI type so this
	// (possibly native) caller agrees with the LLVM callee.  A memory-class
	// aggregate (straddles the reg/stack boundary on x64) is instead stored
	// into its slot for a `byval` pass (emit_mem_byval.bn) — isSret tells the
	// preamble whether the sret pointer shifted the register positions.  See
	// emit_agg_coerce.bn.
	emitAggCallArgPreamble(out, instr, isSret)

	if isSret {
		// Sret call: the `.sret` alloca is hoisted to function
		// entry by emitSretAllocDecl; here we only emit the
		// `call void` with sret first param + the result load.
		out.Write("call void @")
		out.Write(callNameBuf)
		out.Write("(ptr sret(")
		out.Write(sretRetType)
		out.Write(") align 8 ")
		emitRef(out, instr.ID)
		out.Write(".sret")
	} else if isVoid {
		out.Write("call void @")
		out.Write(callNameBuf)
		out.WriteByte('(')
	} else {
		if aggCallResultCoerced(instr) {
			// Coerced in-register-aggregate result: capture the call's
			// `[N x iW]` value as `%v<callID>.agR`; the post-call bind
			// (emitAggCallResultBind) loads `%v<callID>` as the struct.
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".agR")
		} else {
			emitRef(out, instr.ID)
		}
		out.Write(" = call ")
		var retStr @[]char = lookupRetType(funcRetTypes, callNameBuf)
		if len(retStr) > 0 {
			out.Write(retStr)
		} else {
			out.Write(llvmType(instr.Typ))
		}
		out.Write(" @")
		out.Write(callNameBuf)
		out.WriteByte('(')
	}

	for i := 0; i < len(instr.Args); i++ {
		if i > 0 || isSret {
			out.Write(", ")
		}
		writeByvalArgLLVM(out, instr, i, isSret)
	}

	out.Write(")\n")

	if isSret {
		// Load the result from the sret alloca
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(sretRetType)
		out.Write(", ptr ")
		emitRef(out, instr.ID)
		out.Write(".sret\n")
	} else if aggCallResultCoerced(instr) {
		// Bind the coerced `[N x iW]` result back to the `%S` value
		// `%v<callID>` the rest of the IR consumes (store -> load via
		// the entry-hoisted `.agRB` slot).
		emitAggCallResultBind(out, instr)
	}

	return
}

// emitCallIndirect emits an indirect call through a function pointer.
// instr.Args[0] is the fn_ptr (i8*); instr.Args[1..] are the call args;
// instr.Typ is the return type. The signature is reconstructed at the
// call site, the i8* is bitcast to the matching function-pointer type,
// then a `call` is emitted through the bitcasted register.
func emitCallIndirect(out *strings.Builder, instr @ir.Instr) {
	var isVoid bool = false
	if instr.Typ == nil { isVoid = true }
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID { isVoid = true }

	var nArgs int = len(instr.Args) - 1

	// Per-arg width casts (parallel to emitCall): emit zext/trunc when
	// the arg's LLVM-emitted width differs from its declared type's
	// width. The cast result is named `%v.ID.aN`.
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
			if argBits > declBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, argInstr.ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(declBits))
			out.Write("\n  ")
		}
	}

	// Build the function-pointer LLVM type: <ret>(<arg_types>)* (or
	// void(<arg_types>)* for a void return).
	var sigBuf @strings.Builder = strings.NewBuilder()
	if isVoid {
		sigBuf.Write("void")
	} else {
		sigBuf.Write(llvmType(instr.Typ))
	}
	sigBuf.WriteByte('(')
	for i := 0; i < nArgs; i++ {
		if i > 0 { sigBuf.Write(", ") }
		sigBuf.Write(llvmType(instr.Args[i + 1].Typ))
	}
	sigBuf.Write(")*")

	// Bitcast the i8* fn_ptr to the function-pointer type.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(" to ")
	out.Write(sigBuf.String())
	out.Write("\n  ")

	// Emit the call through the bitcasted function pointer.
	if isVoid {
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(")
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		out.Write(llvmType(instr.Typ))
		out.Write(" %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(")
	}

	for i := 0; i < nArgs; i++ {
		if i > 0 { out.Write(", ") }
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		out.Write(llvmType(argInstr.Typ))
		out.WriteByte(' ')
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
		} else {
			emitValRef(out, argInstr)
		}
	}
	out.Write(")\n")
	return
}
