package "pkg/binate/codegen"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emitCallFuncValue (OP_CALL_FUNC_VALUE lowering in
// emit_call_funcvalue.bn).  Helpers (compileToLLVM, contains, fail)
// live in emit_test.bn.  The aggregate-return retbuf path and the
// aggregate-arg helpers (emitFuncValueArgPreamble /
// emitFuncValueCallAllocDecls / emitFuncValueArgList) are additionally
// exercised by emit_funcvals_closure_test.bn.

// TestEmitCallFuncValueScalar checks that a scalar-returning call through
// a function value lowers to the 2-word %BnFuncValue dispatch: extract the
// data + vtable.call slot, bitcast to the shim signature, then call the
// shim with data as the first argument.
func TestEmitCallFuncValueScalar() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar f *func(int) int = func(x int) int { return x * 2 }\n")
	cb.Write("\tprintln(f(21))\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)
	// The call extracts data (field 1) + vtable_ptr (field 0) from the
	// %BnFuncValue and dispatches through the vtable's call slot.
	if !contains(out, "extractvalue %BnFuncValue") {
		return fail("expected %BnFuncValue extract for func-value call")
	}
	if !contains(out, "%BnVtable") {
		return fail("expected vtable dispatch for func-value call")
	}
	var pass testing.TestResult
	return pass
}
