package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for emitCallFuncValue (OP_CALL_FUNC_VALUE lowering in
// emit_call_funcvalue.bn).  Helpers (compileToLLVM, contains, fail)
// live in emit_test.bn.  The aggregate-return retbuf path and the
// aggregate-arg helpers (emitFuncValueArgPreamble /
// emitFuncValueCallAllocDecls / emitFuncValueArgList) are additionally
// exercised by emit_funcvals_closure_test.bn.

// TestEmitCallFuncValueScalar checks that a scalar-returning call through
// a function value lowers to the 2-word %BnFuncValue dispatch: extract the
// data + vtable.call slot, bitcast to the shim signature, then call the
// shim with data as the first argument.
func TestEmitCallFuncValueScalar() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar f *func(int) int = func(x int) int { return x * 2 }\n"
			"\t_ = f(21)\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// The call extracts data (field 1) + vtable_ptr (field 0) from the
	// %BnFuncValue and dispatches through the vtable's call slot.
	if !contains(out, "extractvalue %BnFuncValue") {
		return fail("expected %BnFuncValue extract for func-value call")
	}
	if !contains(out, "%BnVtable") {
		return fail("expected vtable dispatch for func-value call")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCapturingIIFESingleRefDec guards against a double-free of a
// capturing immediately-invoked @func literal's heap closure record.  The
// callee literal is a fresh temporary owned by no var; genFuncLit registers
// every managed-func-value literal once for end-of-statement RefDec, so a
// capturing IIFE must emit EXACTLY ONE managed-func-value RefDec of the
// callee.  Two would RefDec the same value twice at statement end,
// double-freeing the heap closure record — the second RefDec re-reads the
// record's already-freed refcount header, a non-deterministic heap-corruption
// crash; zero would leak the record and every value it captured.  Each
// `fv_refdec.<n>:` block header marks exactly one such RefDec sequence (the
// `.` after `fv_refdec` excludes the `fv_refdec_cont.<n>:` continuation
// blocks; the leading newline excludes `%fv_refdec.<n>` branch targets).
func TestEmitCapturingIIFESingleRefDec() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type Counter struct { N int }\n"
			"func main() {\n"
			"\tvar c @Counter = make(Counter)\n"
			"\tc.N = 7\n"
			"\tvar r int = (func() int { return c.N })()\n"
			"\t_ = r\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	var n int = countSubstr(out, "\nfv_refdec.")
	if n != 1 {
		return fail(
				"capturing IIFE @func callee must be RefDec'd exactly once "
						"(a second registration double-frees the heap closure record)")
	}
	var pass testing.TestResult
	return pass
}
