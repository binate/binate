package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"

// emitCallHandle lowers OP_CALL_HANDLE — call through a 16-byte
// {vtable_ptr, data_ptr} function-value handle.  instr.Args[0] is the
// handle (i8* pointing at the {vtable, data} block); instr.Args[1..]
// are user call args; instr.Typ is the return type.  Loads handle's
// vtable.call and data fields and dispatches as
// `call(data, args)` — shim-shape calling convention (matches the
// per-function __shim that __vt.<mangled>'s call slot points at).
// Phase 4 of plan-uniform-native-fnptrs.md.
//
// Split out of emit_call.bn to keep that file under the file-length
// soft cap.
func emitCallHandle(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var isVoid bool = false
	if instr.Typ == nil { isVoid = true }
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID { isVoid = true }
	var nArgs int = len(instr.Args) - 1

	// Per-arg width casts (parallel to emitCallIndirect).
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out = out.WriteStr("%v")
			out = out.WriteInt(instr.ID)
			out = out.WriteStr(".a")
			out = out.WriteInt(i)
			if argBits > declBits {
				out = out.WriteStr(" = trunc ")
			} else {
				out = out.WriteStr(" = zext ")
			}
			out = out.WriteStr(llvmTypeForBits(argBits))
			out = out.WriteByte(' ')
			out = emitRef(out, argInstr.ID)
			out = out.WriteStr(" to ")
			out = out.WriteStr(llvmTypeForBits(declBits))
			out = out.WriteStr("\n  ")
		}
	}

	// Cast handle (i8*) to %BnFuncValue*.
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".h = bitcast i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(" to %BnFuncValue*\n  ")
	// data slot (offset 1).
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".h, i32 0, i32 1\n  ")
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".data = load i8*, i8** %v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt\n  ")
	// vtable_ptr (offset 0) → bitcast to %BnVtable*.
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8p = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".h, i32 0, i32 0\n  ")
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = load i8*, i8** %v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8p\n  ")
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to %BnVtable*\n  ")
	// vtable.call (offset 1) → load i8* → bitcast to fn ptr.
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".cp = getelementptr inbounds %BnVtable, %BnVtable* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i32 0, i32 1\n  ")
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".cb = load i8*, i8** %v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".cp\n  ")

	// Build sig `<ret>(i8*, <arg_types>)*`.
	var sigBuf buf.CharBuf = buf.New()
	if isVoid { sigBuf = sigBuf.WriteStr("void") } else {
		sigBuf = sigBuf.WriteStr(llvmType(instr.Typ))
	}
	sigBuf = sigBuf.WriteStr("(i8*")
	for i := 0; i < nArgs; i++ {
		sigBuf = sigBuf.WriteStr(", ")
		sigBuf = sigBuf.WriteStr(llvmType(instr.Args[i + 1].Typ))
	}
	sigBuf = sigBuf.WriteStr(")*")
	out = out.WriteStr("%v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fn = bitcast i8* %v"); out = out.WriteInt(instr.ID)
	out = out.WriteStr(".cb to ")
	out = writeBuf(out, sigBuf)
	out = out.WriteStr("\n  ")

	// Call: <fn>(data, args...).
	if isVoid {
		out = out.WriteStr("call void %v"); out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v"); out = out.WriteInt(instr.ID)
		out = out.WriteStr(".data")
	} else {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(" %v"); out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v"); out = out.WriteInt(instr.ID)
		out = out.WriteStr(".data")
	}
	for i := 0; i < nArgs; i++ {
		out = out.WriteStr(", ")
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		out = out.WriteStr(llvmType(argInstr.Typ))
		out = out.WriteByte(' ')
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out = out.WriteStr("%v")
			out = out.WriteInt(instr.ID)
			out = out.WriteStr(".a")
			out = out.WriteInt(i)
		} else {
			out = emitValRef(out, argInstr)
		}
	}
	out = out.WriteStr(")\n")
	return out
}
