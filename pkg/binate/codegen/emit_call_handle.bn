package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitCallHandle lowers OP_CALL_HANDLE — call through a 16-byte
// {vtable_ptr, data_ptr} function-value handle.  instr.Args[0] is the
// handle (i8* pointing at the {vtable, data} block); instr.Args[1..]
// are user call args; instr.Typ is the return type.  Loads handle's
// vtable.call and data fields and dispatches as
// `call(data, args)` — shim-shape calling convention (matches the
// per-function __shim that __vt.<mangled>'s call slot points at).
//
// Split out of emit_call.bn to keep that file under the file-length
// soft cap.
func emitCallHandle(out *strings.Builder, instr @ir.Instr) {
	var isVoid bool = false
	if instr.Typ == nil { isVoid = true }
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_VOID { isVoid = true }
	var nArgs int = len(instr.Args) - 1

	// Per-arg width casts (parallel to emitCallIndirect).
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
			if argBits > declBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, argInstr.ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(declBits))
			out.Write("\n  ")
		}
	}

	// Cast handle (i8*) to %BnFuncValue*.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h = bitcast i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(" to %BnFuncValue*\n  ")
	// data slot (offset 1).
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h, i32 0, i32 ")
	stringutils.WriteInt(out, types.FuncValueDataIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".data = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt\n  ")
	// vtable_ptr (offset 0) → bitcast to %BnVtable*.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8p = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h, i32 0, i32 ")
	stringutils.WriteInt(out, types.FuncValueVtableIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8p\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to %BnVtable*\n  ")
	// vtable.call (offset 1) → load i8* → bitcast to fn ptr.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cp = getelementptr inbounds %BnVtable, %BnVtable* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i32 0, i32 1\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cb = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cp\n  ")

	// Build sig `<ret>(i8*, <arg_types>)*`.
	var sigBuf @strings.Builder = strings.NewBuilder()
	if isVoid { sigBuf.Write("void") } else {
		sigBuf.Write(llvmType(instr.Typ))
	}
	sigBuf.Write("(i8*")
	for i := 0; i < nArgs; i++ {
		sigBuf.Write(", ")
		sigBuf.Write(llvmType(instr.Args[i + 1].Typ))
	}
	sigBuf.Write(")*")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cb to ")
	out.Write(sigBuf.String())
	out.Write("\n  ")

	// Call: <fn>(data, args...).
	if isVoid {
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".data")
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		out.Write(llvmType(instr.Typ))
		out.Write(" %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".data")
	}
	for i := 0; i < nArgs; i++ {
		out.Write(", ")
		var argInstr @ir.Instr = instr.Args[i + 1]
		var argBits int = llvmTypeBits(argInstr)
		var declBits int = typeBits(argInstr.Typ)
		out.Write(llvmType(argInstr.Typ))
		out.WriteByte(' ')
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
		} else {
			emitValRef(out, argInstr)
		}
	}
	out.Write(")\n")
	return
}
