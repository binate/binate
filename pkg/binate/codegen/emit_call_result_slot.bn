package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"

// A direct call whose aggregate result comes back through an sret buffer, and is
// stored whole into a stack slot that may stand in for that buffer
// (common.CallResultSlots), passes the slot itself as the buffer: no `.sret` alloca,
// no load out of it, and the store copies nothing.  The slot's alloca is declared
// `align 8`, the alignment the sret pointer promises the callee.
//
// Likewise a direct sret call whose result the function returns through its own sret
// buffer (common.ReturnedCallResults) passes that buffer, `%v.retbuf`, on: no `.sret`
// alloca, no load, and the return only returns.

// curCallResultSlot[id] is, for the function being emitted, the value ID of the slot
// the direct call with value ID id writes its result into through its sret pointer,
// or -1.
var curCallResultSlot @[]int

// curResultSlotTarget[id] reports whether slot id is a call's sret buffer in the
// function being emitted (curCallResultSlot).
var curResultSlotTarget @[]bool

// curRetbufCall[id] reports whether the direct call with value ID id writes the
// aggregate the function being emitted returns straight into `%v.retbuf`.
var curRetbufCall @[]bool

// computeCallResultSlots records f's direct sret calls whose result goes straight into
// a slot.
func computeCallResultSlots(f @ir.Func, funcRetTypes *[]FuncRetType) {
	clearCallResultSlots()
	var slots @[]int = common.CallResultSlots(f)
	var targets @[]bool = make_slice(bool, len(slots))
	var rets @[]bool = common.ReturnedCallResults(f)
	var retSret bool = len(f.Results) == 1 && needsSret(f.Results[0])
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.ID >= 0 && ins.ID < len(rets) && rets[ins.ID] &&
					!(retSret && lookupIsSret(funcRetTypes, mangle.FuncName(modulePkgName, ins.StrVal))) {
				rets[ins.ID] = false
			}
			if ins.ID < 0 || ins.ID >= len(slots) || slots[ins.ID] < 0 { continue }
			if ins.Op == iropcode.OP_CALL &&
					lookupIsSret(funcRetTypes, mangle.FuncName(modulePkgName, ins.StrVal)) {
				targets[slots[ins.ID]] = true
			} else {
				slots[ins.ID] = -1
			}
		}
	}
	curCallResultSlot = slots
	curResultSlotTarget = targets
	curRetbufCall = rets
}

// clearCallResultSlots forgets the placed calls of the function just emitted.
func clearCallResultSlots() {
	var none @[]int
	var noFlags @[]bool
	curCallResultSlot = none
	curResultSlotTarget = noFlags
	curRetbufCall = noFlags
}

// callResultSlot returns the value ID of the slot the call with value ID id writes its
// result into through its sret pointer, or -1.
func callResultSlot(id int) int {
	if id < 0 || id >= len(curCallResultSlot) { return -1 }
	return curCallResultSlot[id]
}

// callResultToRetbuf reports whether the call with value ID id writes the aggregate the
// function returns straight into `%v.retbuf`.
func callResultToRetbuf(id int) bool {
	return id >= 0 && id < len(curRetbufCall) && curRetbufCall[id]
}

// isCallResultSlot reports whether the slot with value ID id is a call's sret buffer.
func isCallResultSlot(id int) bool {
	return id >= 0 && id < len(curResultSlotTarget) && curResultSlotTarget[id]
}
