package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_call_result_slot.bn: a direct sret call whose result is stored whole
// into a local passes the local as its sret buffer.

// resultIntoLocalSrc reassigns a declared local from a call returning a large struct.
func resultIntoLocalSrc() *[]readonly char {
	return "package \"main\"\n"
			"type Big struct { n int\n arr [40]int }\n"
			"func mk(k int) Big {\n"
			"\tvar b Big\n"
			"\tb.n = k\n"
			"\treturn b\n"
			"}\n"
			"func use(k int) int {\n"
			"\tvar x Big\n"
			"\tx = mk(k)\n"
			"\treturn x.n\n"
			"}\n"
			"func main() {}\n"
}

// The call's sret buffer is x's alloca, declared `align 8` as the sret pointer
// promises: no `.sret` buffer, and no copy of the result into x.
func TestCallResultIntoLocal() testing.TestResult {
	var archs @[]int = make_slice(int, 3)
	archs[0] = types.ARCH_AA64
	archs[1] = types.ARCH_X64
	archs[2] = types.ARCH_ARM32
	for i := 0; i < len(archs); i++ {
		var use @[]char = llvmFuncBody(compileForArch(resultIntoLocalSrc(), archs[i]), "use")
		if len(use) == 0 { return fail("use is emitted") }
		if contains(use, ".sret") {
			return fail("the call's result buffer is the local, not a `.sret` slot")
		}
		if !contains(use, "= alloca %bn_S1_4_main1_3_Big, align 8\n") {
			return fail("the local standing in for the sret buffer is declared align 8")
		}
		if contains(use, "memcpy") || contains(use, "MemCopy") ||
				contains(use, "store %bn_S1_4_main1_3_Big") {
			return fail("the result is not copied into the local")
		}
	}
	return ""
}
