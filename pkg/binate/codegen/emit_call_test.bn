package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitCall and emitCallIndirect (the direct + indirect call
// lowering in emit_call.bn).  Function-value call lowering has moved to
// emit_call_funcvalue.bn / emit_call_funcvalue_test.bn.

func TestEmitCallFunc() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"func add(a int, b int) int {\n"
			"\treturn a + b\n"
			"}\n"
			"func main() { println(add(1, 2)) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call i64 @bn_F1_4_main1_3_add") {
		return fail("expected call to mangled function name")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectVoid checks the LLVM lowering of OP_CALL_INDIRECT
// for a void-returning indirect call with one i64 argument. The
// expected shape is: bitcast i8* fn to void(i64)*, then call void
// through the bitcasted register.
func TestEmitCallIndirectVoid() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var arg @ir.Instr = entry.EmitConstInt(42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	entry.EmitCallIndirect(fnPtr, callArgs, types.TypVoid())

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8*") {
		return fail("expected bitcast i8* for fn_ptr")
	}
	if !contains(out, "to void(i64)*") {
		return fail("expected void(i64)* function-pointer type")
	}
	if !contains(out, "call void %") {
		return fail("expected indirect call through register")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectInt checks the lowering of an int-returning
// indirect call. The bitcast target uses the int return type and the
// call is assigned to a value register.
func TestEmitCallIndirectInt() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var arg @ir.Instr = entry.EmitConstInt(42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	var result @ir.Instr = entry.EmitCallIndirect(fnPtr, callArgs, types.TypInt())

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = result
	entry.EmitReturn(retArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8*") {
		return fail("expected bitcast i8* for fn_ptr")
	}
	if !contains(out, "to i64(i64)*") {
		return fail("expected i64(i64)* function-pointer type")
	}
	if !contains(out, "= call i64 %") {
		return fail("expected indirect call returning i64")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectNoArgs checks the lowering of a no-argument
// indirect call (e.g., a dtor accepting no args).
func TestEmitCallIndirectNoArgs() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var noCallArgs @[]@ir.Instr
	entry.EmitCallIndirect(fnPtr, noCallArgs, types.TypVoid())

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "to void()*") {
		return fail("expected void()* function-pointer type for no-arg call")
	}
	if !contains(out, "call void %") {
		return fail("expected indirect call through register")
	}
	var pass testing.TestResult
	return pass
}
