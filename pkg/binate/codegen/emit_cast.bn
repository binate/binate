package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/std/strings"

// emitCast emits a type cast (sext/zext/trunc, ptrtoint/inttoptr, or identity).
func emitCast(out *strings.Builder, instr @ir.Instr) {
	// Peel TYP_NAMED: a cast to/from a named distinct scalar selects
	// fp/int conversion and width from the underlying.  typeBits (used
	// for srcBits/dstBits) and llvmType peel on their own; this peels
	// the local Kind== checks below.
	var srcTyp @types.Type = unwrapNamed(instr.Args[0].Typ)
	var dstTyp @types.Type = unwrapNamed(instr.TypeArg)

	// Source operand, IsGlobalRef-aware: `cast(int, &G)` of a global's
	// address renders the source as `@<mangled>`, not the nonexistent
	// `%v-1` (the IsGlobalRef pseudo has ID -1 and no SSA definition).
	// Mirrors emitBitCast; writeBuf is non-destructive, so the arms that
	// emit the source twice (same-size aggregate identity) stay correct.
	var srcRef @strings.Builder = strings.NewBuilder()
	emitValRef(srcRef, instr.Args[0])

	// STRUCT → DISTINCT-STRUCT cast: llvmType gives two different named LLVM
	// struct types (`%A` vs `%B`), so the same-representation `select`/identity
	// below would declare the result with the SOURCE struct type while every
	// downstream use expects the DEST type — clang rejects it ('%v defined with
	// type %A but expected %B').  Reinterpret the bytes through a scratch alloca:
	// store the src struct, load it back as the dst struct.  (Same-repr aggregates
	// — slice→slice, or a struct cast to an identical LLVM type — keep the identity
	// path below, where srcLL == dstLL.)  Per spec §8.5 a different-size struct cast
	// has unspecified value; a slot sized for the larger operand yields VALID IR.
	if srcTyp != nil && dstTyp != nil && srcTyp.Kind == types.TYP_STRUCT &&
			dstTyp.Kind == types.TYP_STRUCT {
		var srcLL @[]char = llvmType(srcTyp)
		var dstLL @[]char = llvmType(dstTyp)
		if !charsEqual(srcLL, dstLL) {
			// Slot = the LARGER struct by BYTE size, so `store <src>` / `load <dst>`
			// both fit — an undersized slot would write OUT OF BOUNDS on the stack
			// for a src-bigger-than-dst cast.  Size by SizeOf(): typeBits() returns
			// the host int width (64) for every struct (structs have Width==0), so a
			// bit-width compare is a dead guard that always keeps the dst slot.
			var slotLL @[]char = dstLL
			if srcTyp.SizeOf() > dstTyp.SizeOf() { slotLL = srcLL }
			emitRef(out, instr.ID)
			out.Write(".crs = alloca ")
			out.Write(slotLL)
			out.Write("\n  store ")
			out.Write(srcLL)
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", ptr ")
			emitRef(out, instr.ID)
			out.Write(".crs\n  ")
			emitRef(out, instr.ID)
			out.Write(" = load ")
			out.Write(dstLL)
			out.Write(", ptr ")
			emitRef(out, instr.ID)
			out.Write(".crs\n")
			return
		}
	}

	emitRef(out, instr.ID)

	var srcBits int = llvmTypeBits(instr.Args[0])
	var dstBits int = typeBits(dstTyp)

	// Check if source is a non-scalar type (slice, struct, etc.)
	// where "add X, 0" is not valid LLVM IR
	var srcIsAggregate bool = srcTyp != nil &&
			(srcTyp.Kind == types.TYP_SLICE || srcTyp.Kind == types.TYP_MANAGED_SLICE ||
					srcTyp.Kind == types.TYP_STRUCT)

	var srcIsPtr bool = srcTyp != nil &&
			(srcTyp.Kind == types.TYP_POINTER || srcTyp.Kind == types.TYP_MANAGED_PTR)
	var dstIsPtr bool = dstTyp != nil &&
			(dstTyp.Kind == types.TYP_POINTER || dstTyp.Kind == types.TYP_MANAGED_PTR)

	var srcIsFloat bool = srcTyp != nil &&
			(srcTyp.Kind == types.TYP_FLOAT || srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
			(dstTyp.Kind == types.TYP_FLOAT || dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Float ↔ float: fpext (widen) or fptrunc (narrow).
	if srcIsFloat && dstIsFloat {
		var srcW int = 64
		var dstW int = 64
		if srcTyp.Kind == types.TYP_FLOAT && srcTyp.Width > 0 { srcW = srcTyp.Width }
		if dstTyp.Kind == types.TYP_FLOAT && dstTyp.Width > 0 { dstW = dstTyp.Width }
		if srcW == dstW {
			// Same-width float-to-float: emit a no-op fadd X, 0.0.
			out.Write(" = fadd ")
			out.Write(llvmType(dstTyp))
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", 0.0\n")
			return
		}
		if srcW < dstW {
			out.Write(" = fpext ")
		} else {
			out.Write(" = fptrunc ")
		}
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Int → float: sitofp (signed) or uitofp (unsigned).
	if !srcIsFloat && dstIsFloat && !srcIsPtr {
		if isUnsigned(srcTyp) {
			out.Write(" = uitofp ")
		} else {
			out.Write(" = sitofp ")
		}
		out.Write(llvmTypeForBits(srcBits))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Float → int: fptosi (signed) or fptoui (unsigned). Truncates
	// towards zero (LLVM semantics).
	if srcIsFloat && !dstIsFloat && !dstIsPtr {
		if isUnsigned(dstTyp) {
			out.Write(" = fptoui ")
		} else {
			out.Write(" = fptosi ")
		}
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Pointer ↔ pointer: bitcast
	if srcIsPtr && dstIsPtr {
		out.Write(" = bitcast ")
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Pointer → int: ptrtoint
	if srcIsPtr && !dstIsPtr {
		out.Write(" = ptrtoint ")
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Int → pointer: inttoptr
	if !srcIsPtr && dstIsPtr {
		out.Write(" = inttoptr ")
		out.Write(llvmTypeForBits(srcBits))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	if srcBits == dstBits {
		if srcIsAggregate {
			// Non-scalar same-representation (e.g., *[]readonly char → *[]uint8):
			// both map to the same LLVM type — identity via select
			var tyLL @[]char = llvmType(srcTyp)
			out.Write(" = select i1 true, ")
			out.Write(tyLL)
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", ")
			out.Write(tyLL)
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.WriteByte('\n')
		} else {
			// Scalar same-size: identity via add 0
			out.Write(" = add ")
			out.Write(llvmType(dstTyp))
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", 0\n")
		}
		return
	}

	if srcBits < dstBits {
		if isUnsigned(srcTyp) {
			out.Write(" = zext ")
		} else {
			out.Write(" = sext ")
		}
	} else {
		out.Write(" = trunc ")
	}

	var srcLLVM @[]char = llvmTypeForBits(srcBits)
	out.Write(srcLLVM)
	out.WriteByte(' ')
	out.Write(srcRef.String())
	out.Write(" to ")
	out.Write(llvmType(dstTyp))
	out.WriteByte('\n')
	return
}

// emitBitCast emits a bitcast, ptrtoint, inttoptr, or identity for bit_cast.
func emitBitCast(out *strings.Builder, instr @ir.Instr) {
	// Peel ALL transparent wrappers (named / alias / readonly), not just named,
	// so a bit_cast selects its pointer/float/int form from the representation.
	// A named-only peel misclassifies a `readonly float64` operand as neither
	// float nor pointer (Kind stays TYP_READONLY) and falls through to the same-
	// size identity `add`, emitting `add i64 <a double value>` — invalid LLVM.
	// The load form of the operand carries the peeled type, so this only bit at
	// -O1+, where load-forwarding forwards the still-readonly-wrapped value.
	var srcTyp @types.Type = peelReprType(instr.Args[0].Typ)
	var dstTyp @types.Type = peelReprType(instr.TypeArg)
	var srcLL @[]char = llvmType(srcTyp)
	var dstLL @[]char = llvmType(dstTyp)
	var srcIsPtr bool = isPointerType(srcTyp)
	var dstIsPtr bool = isPointerType(dstTyp)
	var srcIsFloat bool = srcTyp != nil &&
			(srcTyp.Kind == types.TYP_FLOAT || srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
			(dstTyp.Kind == types.TYP_FLOAT || dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Source operand, IsGlobalRef-aware: a bit_cast of a global's
	// address (e.g. `bit_cast(int, &G)`) renders the source as
	// `@<mangled>`, not the nonexistent `%v-1`.
	var srcRef @strings.Builder = strings.NewBuilder()
	emitValRef(srcRef, instr.Args[0])

	emitRef(out, instr.ID)

	if srcIsPtr && dstIsPtr {
		out.Write(" = bitcast ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcIsPtr && !dstIsPtr {
		out.Write(" = ptrtoint ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if !srcIsPtr && dstIsPtr {
		out.Write(" = inttoptr ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcIsFloat != dstIsFloat {
		// Int ↔ float same-size bit_cast: reinterprets bits, NOT a
		// numeric conversion. LLVM `bitcast` between scalars of the
		// same bit width handles this directly.
		out.Write(" = bitcast ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcTyp != nil && srcTyp.Kind == types.TYP_SLICE {
		// Raw-slice element retype (e.g. `*[]uint8` -> `*[]int8`): the
		// {ptr,len} representation is identical, so the reinterpret is a
		// no-op.  `add` is only valid for a scalar integer; for the
		// %BnSlice aggregate emit an identity `select` to produce the
		// result at the (same) target LLVM type.  Both endpoints are raw
		// slices here (IR-gen routes a raw-slice-vs-non-slice bit_cast
		// through memory), and llvmType renders every raw slice as the
		// element-agnostic %BnSlice, so srcLL == dstLL.
		out.Write(" = select i1 true, ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(", ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.WriteByte('\n')
	} else if srcIsFloat {
		// Same-representation float bit_cast (a size-equal float→float no-op, which
		// the checker permits): `add` is integer-only, so emit an identity `fadd
		// X, 0.0` rather than `add <a float>, 0` (invalid LLVM).
		out.Write(" = fadd ")
		out.Write(dstLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(", 0.0\n")
	} else {
		out.Write(" = add ")
		out.Write(dstLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(", 0\n")
	}
	return
}

// isPointerType returns true if the type is a raw or managed pointer.
func isPointerType(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR
}
