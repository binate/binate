package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the cast emitters (emitCast) in emit_cast.bn.

// int → float64 cast uses `sitofp`.
func TestEmitCastIntToFloat() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float64) float64 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var i int = 5\n")
	cb.Write("  use(cast(float64, i))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "sitofp i64") {
		return fail("expected 'sitofp i64' for int → float cast")
	}
	var pass testing.TestResult
	return pass
}

// float → int cast uses `fptosi`.
func TestEmitCastFloatToInt() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x int) int { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float64 = 3.7\n")
	cb.Write("  use(cast(int, f))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fptosi double") {
		return fail("expected 'fptosi double' for float → int cast")
	}
	// The fptosi result is frozen so the saturation lowering's mask can discard
	// the out-of-range poison without clang -O2 propagating it.
	if !contains(out, "freeze") {
		return fail("expected the fptosi result to be frozen (out-of-range poison guard)")
	}
	var pass testing.TestResult
	return pass
}

// float64 → float32 cast uses `fptrunc`.
func TestEmitCastFloat64To32() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float32) float32 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var d float64 = 3.14\n")
	cb.Write("  use(cast(float32, d))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fptrunc double") {
		return fail("expected 'fptrunc double' for narrowing float cast")
	}
	var pass testing.TestResult
	return pass
}

// float32 → float64 cast uses `fpext`.
func TestEmitCastFloat32To64() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float64) float64 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float32 = cast(float32, 1.5)\n")
	cb.Write("  use(cast(float64, f))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fpext float") {
		return fail("expected 'fpext float' for widening float cast")
	}
	var pass testing.TestResult
	return pass
}

// An array retype over elements with one LLVM type ([4]int8 -> [4]uint8, both
// `[4 x i8]`) is an identity `select`: the scalar `add X, 0` identity is invalid on
// an aggregate and clang rejects it.
func TestEmitCastArraySameReprIsSelect() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x [4]uint8) [4]uint8 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var a [4]int8\n")
	cb.Write("  a[0] = -1\n")
	cb.Write("  use(cast([4]uint8, a))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if contains(out, "add [4 x i8]") {
		return fail("an array cast must not use the scalar `add X, 0` identity")
	}
	if !contains(out, "select i1 true, [4 x i8]") {
		return fail("expected an identity select at [4 x i8] for [4]int8 -> [4]uint8")
	}
	var pass testing.TestResult
	return pass
}

// An array retype whose element LLVM types differ ([2]bool -> [2]uint8 is
// `[2 x i1]` -> `[2 x i8]`) reinterprets through a scratch slot — an identity at
// the source type would give the result the wrong LLVM type.  The slot is
// declared by emitCastAllocDecl (the entry-block hoisting pass) and only used
// by emitCast.  Built directly as IR: the operand shape is independent of which
// retypes the checker admits.
func TestEmitCastArrayDistinctReprReinterprets() testing.TestResult {
	setTarget64()
	var src @ir.Instr = make(ir.Instr)
	src.ID = 7
	src.Typ = types.MakeArrayType(types.TypBool(), 2)
	var c @ir.Instr = make(ir.Instr)
	c.ID = 8
	c.Typ = types.MakeArrayType(types.TypUint8(), 2)
	c.TypeArg = c.Typ
	c.Args = make_slice(@ir.Instr, 1)
	c.Args[0] = src
	var d @strings.Builder = strings.NewBuilder()
	emitCastAllocDecl(d, c)
	if !contains(buf.CopyStr(d.String()), "%v8.crs = alloca [2 x i8]") {
		return fail("expected a scratch slot for the [2 x i1] -> [2 x i8] reinterpret")
	}
	var b @strings.Builder = strings.NewBuilder()
	emitCast(b, c)
	var out @[]char = buf.CopyStr(b.String())
	if contains(out, "alloca") {
		return fail("emitCast must use the hoisted slot, not declare its own")
	}
	if !contains(out, "store [2 x i1] %v7, ptr %v8.crs") {
		return fail("expected the source stored at its own LLVM type")
	}
	if !contains(out, "%v8 = load [2 x i8], ptr %v8.crs") {
		return fail("expected the result loaded back at the destination LLVM type")
	}
	if contains(out, "select i1 true") {
		return fail("a distinct-representation array cast must not take the identity select")
	}
	var pass testing.TestResult
	return pass
}
