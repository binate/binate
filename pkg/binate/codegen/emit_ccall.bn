package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// cCallResultIsVoid reports whether an OP_C_CALL has no SSA result — the "void"
// spelling.  A void __c_call carries a real (unique) instruction ID with a
// TYP_VOID result type (so its per-arg scratch slots stay distinct); a nil
// result type is also treated as void for robustness against a direct EmitCCall
// caller that passes one.
func cCallResultIsVoid(ins @ir.Instr) bool {
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// ============================================================
// __c_call lowering (Stage 1: fixed-arg, scalar/pointer args + return)
// ============================================================
//
// OP_C_CALL emits `<%vID> = call <ret> @<symbol>(<args>)` with the
// symbol verbatim (NOT mangled — `instr.StrVal` already holds the raw
// C symbol). The type checker restricts Stage 1 to scalar/pointer
// return + args and rejects variadic calls, so the lowering here can
// stay simple: no sret, no varargs sig, no struct-by-value handling.

// emitCCall emits LLVM IR for an OP_C_CALL instruction.
func emitCCall(out *strings.Builder, instr @ir.Instr) {
	// Emit width-cast preludes for any arg whose SSA value's LLVM
	// width differs from its declared type — mirrors emitCall.
	for i := 0; i < len(instr.Args); i++ {
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
			if argBits > declBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, instr.Args[i].ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(declBits))
			out.Write("\n  ")
		}
	}

	// Byval + in-register-aggregate coercion preambles — reuse the regular call
	// path's C-ABI machinery so an aggregate __c_call argument is passed per the
	// platform C ABI (small-struct register coercion, byval for memory-class /
	// >16-byte aggregates), matching what the C callee expects, rather than a bare
	// first-class struct value (which LLVM lowers differently — it miscompiled a
	// small struct as a single register).  hasSretPrefix is false: a __c_call
	// return is a scalar/pointer (the checker restricts it), so no sret shift.
	writeByvalArgPreamble(out, instr)
	emitAggCallArgPreamble(out, instr, false)

	// `%vID = call <ret> [(<sig>)] @<symbol>(<args>)`, or `call void
	// [(<sig>)] @<symbol>(<args>)` for a void return (the `"void"`
	// spelling: a nil result type, no SSA result — `llvmType(nil)` is
	// `i64`, so void is written explicitly).  Variadic (CFixedArgs <
	// len(Args)) needs the explicit function-pointer signature
	// `(<fixed-types>, ...)` before the callee so LLVM lowers the call
	// per the varargs convention (platform-specific — the LLVM backend
	// hides it from us).  sret (big struct return) is still unsupported.
	var isVariadic bool = instr.CFixedArgs < len(instr.Args)
	if cCallResultIsVoid(instr) {
		out.Write("call void")
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		out.Write(llvmType(instr.Typ))
	}
	if isVariadic {
		// Each fixed param in the explicit varargs signature MUST be spelled in
		// its C-ABI-lowered shape (writeCCallParamType), NOT the raw llvmType:
		// writeByvalArgLLVM emits the argument coerced (a small struct as its
		// register form `[N x iW]`, an x64 SSE aggregate SSE-split, a memory-class
		// one as `ptr byval`), and LLVM requires the fixed call-type param to match
		// its argument.  Using the raw type made a fixed AGGREGATE param disagree
		// with the coerced argument (`%struct` vs `[2 x float]`) — invalid LLVM,
		// clang rejected the module.  Same position-aware C-ABI logic
		// emitCCallDeclare uses for the `declare`.
		out.Write(" (")
		var fixedTypes @[]@types.Type = make_slice(@types.Type, instr.CFixedArgs)
		for i := 0; i < instr.CFixedArgs; i++ { fixedTypes[i] = instr.Args[i].Typ }
		for i := 0; i < instr.CFixedArgs; i++ {
			if i > 0 { out.Write(", ") }
			writeCCallParamType(out, instr.Args[i].Typ, fixedTypes, i)
		}
		if instr.CFixedArgs > 0 { out.Write(", ") }
		out.Write("...)")
	}
	out.Write(" @")
	out.Write(instr.StrVal)
	out.WriteByte('(')
	for i := 0; i < len(instr.Args); i++ {
		if i > 0 { out.Write(", ") }
		// The same per-arg emitter the regular call uses: the coerced-aggregate,
		// memory-class byval, >16 indirect-pointer, and plain-scalar (with the
		// width-cast `.a<i>` naming emitted above) branches.  hasSretPrefix false.
		writeByvalArgLLVM(out, instr, i, false)
	}
	out.Write(")\n")
	return
}

// emitCCallDeclares emits `declare <ret> @<symbol>(<argtypes>)` for
// every distinct C symbol referenced by an OP_C_CALL in the module.
// Called from emitModule's preamble alongside the extern-function loop
// and the implicit-libc-Memcpy declare.
func emitCCallDeclares(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_C_CALL { continue }
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = slices.Append[@[]char](seen, ins.StrVal)
				emitCCallDeclare(out, ins)
			}
		}
	}
	return
}

// emitCCallDeclare writes one `declare` line for the OP_C_CALL.  The
// signature is reconstructed from the instr's arg types and return
// type (the same data codegen uses to emit the call itself).  For
// variadic callees, only the FIXED-arg types are spelled out; the
// trailing `, ...` denotes the variadic tail (the variadic actuals
// vary per call site, but the declared signature stays the same).
func emitCCallDeclare(out *strings.Builder, ins @ir.Instr) {
	var isVariadic bool = ins.CFixedArgs < len(ins.Args)
	var nFixed int = len(ins.Args)
	if isVariadic { nFixed = ins.CFixedArgs }
	out.Write("declare ")
	if cCallResultIsVoid(ins) {
		out.Write("void")
	} else {
		out.Write(llvmType(ins.Typ))
	}
	out.Write(" @")
	out.Write(ins.StrVal)
	out.WriteByte('(')
	// Each declared param type MUST match the call site's shape (writeByvalArgLLVM)
	// exactly, or LLVM lowers the direct call ambiguously.  Build the fixed-arg
	// type list so the x64 memory-class decision is position-aware (a ≤16 aggregate
	// that STRADDLES the register file after a preceding arg is `ptr byval`, like
	// the call site) — no sret prefix, since a __c_call return is scalar/pointer/
	// void.
	var declArgTypes @[]@types.Type = make_slice(@types.Type, nFixed)
	for i := 0; i < nFixed; i++ { declArgTypes[i] = ins.Args[i].Typ }
	for i := 0; i < nFixed; i++ {
		if i > 0 { out.Write(", ") }
		writeCCallParamType(out, ins.Args[i].Typ, declArgTypes, i)
	}
	if isVariadic {
		if nFixed > 0 { out.Write(", ") }
		out.Write("...")
	}
	out.Write(")\n")
	return
}

// writeCCallParamType spells the C-ABI LLVM type of one __c_call parameter at
// position `pos` in `argTypes`.  It is writeCAbiParamType PLUS the x86-64 SSE
// split: a float-containing ≤16-byte aggregate passed in registers is spelled one
// eightbyte type per eightbyte (`<2 x float>` / `float` / `double` / `iN`) so the
// declared/varargs-signature param matches the SSE-split ARGUMENT the value
// emitter (sysvWriteCallArg) produces — the GP `[N x i64]` form writeCAbiParamType
// would emit disagrees, which LLVM rejects.  A >16-byte or straddling SSE
// aggregate is memory-class (`ptr byval`), left to writeCAbiParamType.  This split
// is __c_call-specific: the #[c_export] thunk (writeCAbiParamType's other caller)
// forwards params in the GP shape and would mis-forward the split form, so it
// keeps the coerced spelling (its SSE-aggregate handling is tracked separately).
func writeCCallParamType(out *strings.Builder, at @types.Type, argTypes @[]@types.Type, pos int) {
	if types.SysVInSse(at) && !at.IsByvalParam() && !aggMemClassMaybeC(argTypes, pos, true) {
		sysvWriteDeclareParamTypes(out, at)
		return
	}
	writeCAbiParamType(out, at, argTypes, pos)
}

// cCallSymbolSeen reports whether sym is already in the per-module
// dedup list of declared C symbols built up by emitCCallDeclares.
func cCallSymbolSeen(seen @[]@[]char, sym *[]readonly char) bool {
	for i := 0; i < len(seen); i++ {
		if cCallStrEq(seen[i], sym) { return true }
	}
	return false
}

// cCallStrEq compares two C-symbol names for exact byte equality.  A
// tiny local helper to keep emit_ccall.bn free of cross-package
// dependencies (pkg/binate/codegen's other string-compare helpers live with
// their consumers).
func cCallStrEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
