package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// cCallResultIsVoid reports whether an OP_C_CALL has no SSA result — the "void"
// spelling.  A void __c_call carries a real (unique) instruction ID with a
// TYP_VOID result type (so its per-arg scratch slots stay distinct); a nil
// result type is also treated as void for robustness against a direct EmitCCall
// caller that passes one.
func cCallResultIsVoid(ins @ir.Instr) bool {
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// ============================================================
// __c_call lowering
// ============================================================
//
// OP_C_CALL emits `<%vID> = call <ret> @<symbol>(<args>)` with the symbol
// verbatim (NOT mangled — `instr.StrVal` already holds the raw C symbol).
// Arguments and the return admit any defined-ABI-layout type: aggregates are
// passed/returned per the platform C ABI (small-struct register coercion, `byval`
// for memory-class args, a hidden sret buffer for an aggregate return above the
// size cutoff, register-coerced below it), reusing the regular call path's C-ABI
// machinery.  Variadic calls (CFixedArgs < len(Args)) spell an explicit
// function-pointer signature.

// emitCCall emits LLVM IR for an OP_C_CALL instruction.
func emitCCall(out *strings.Builder, instr @ir.Instr) {
	// Emit width-cast preludes for any arg whose SSA value's LLVM
	// width differs from its declared type — mirrors emitCall.
	for i := 0; i < len(instr.Args); i++ {
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".a")
			stringutils.WriteInt(out, i)
			if argBits > declBits {
				out.Write(" = trunc ")
			} else {
				out.Write(" = zext ")
			}
			out.Write(llvmTypeForBits(argBits))
			out.WriteByte(' ')
			emitRef(out, instr.Args[i].ID)
			out.Write(" to ")
			out.Write(llvmTypeForBits(declBits))
			out.Write("\n  ")
		}
	}

	// Return classification, computed from the type (a verbatim C symbol has no
	// funcRetTypes entry): an aggregate above the platform size cutoff returns via
	// a hidden sret buffer (cCallRetSret); a named struct/array below it returns
	// register-coerced to `[N x iW]` / the x64 SSE form (aggCallResultCoerced);
	// everything else — a scalar, a pointer, or a first-class aggregate LLVM
	// register-returns directly (a slice / interface / function value) — binds the
	// call value straight to %vID via the plain `llvmType` spelling.  Binate's
	// internal aggregate-return convention is pinned to the C cutoff (§ InternalSret
	// == C sret cutoff) and uses the same coercion, so this reuses the regular call
	// path's helpers unchanged.
	var sret bool = cCallRetSret(instr)
	var coerced bool = aggCallResultCoerced(instr)

	// Byval + in-register-aggregate arg coercion preambles — reuse the regular call
	// path's C-ABI machinery so an aggregate __c_call argument is passed per the
	// platform C ABI (small-struct register coercion, byval for memory-class /
	// >16-byte aggregates), matching what the C callee expects.  hasSretPrefix =
	// sret: an sret return buffer pointer rides the first GP arg register, shifting
	// the x64 memory-class straddle decision for a following aggregate arg.
	writeByvalArgPreamble(out, instr)
	emitAggCallArgPreamble(out, instr, sret)

	// `%vID = call <ret> [(<sig>)] @<symbol>(<args>)`, or `call void ...` for a void
	// or sret return.  Variadic (CFixedArgs < len(Args)) needs the explicit
	// function-pointer signature `([ptr sret,] <fixed-types>, ...)` before the
	// callee so LLVM lowers the call per the varargs convention.
	var isVariadic bool = instr.CFixedArgs < len(instr.Args)
	if sret || cCallResultIsVoid(instr) {
		out.Write("call void")
	} else if coerced {
		// Capture the register-coerced aggregate result as `%vID.agR`; the post-call
		// bind (emitAggCallResultBind) reinterprets it to the struct value `%vID`.
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".agR = call ")
		writeCCallAggRetType(out, instr.Typ)
	} else {
		emitRef(out, instr.ID)
		out.Write(" = call ")
		out.Write(llvmType(instr.Typ))
	}
	if isVariadic {
		// Each fixed param in the explicit varargs signature MUST be spelled in its
		// C-ABI-lowered shape (writeCCallParamType), NOT the raw llvmType, so it
		// matches the coerced/byval argument writeByvalArgLLVM emits.  A leading
		// `ptr sret(<T>)` is a fixed param when the return sret's.  Same
		// position-aware C-ABI logic emitCCallDeclare uses.
		out.Write(" (")
		var fixedTypes @[]@types.Type = make_slice(@types.Type, instr.CFixedArgs)
		for i := 0; i < instr.CFixedArgs; i++ { fixedTypes[i] = instr.Args[i].Typ }
		var wrote bool = false
		if sret {
			out.Write("ptr sret(")
			out.Write(llvmType(instr.Typ))
			out.Write(") align 8")
			wrote = true
		}
		for i := 0; i < instr.CFixedArgs; i++ {
			if wrote { out.Write(", ") }
			writeCCallParamType(out, instr.Args[i].Typ, fixedTypes, i)
			wrote = true
		}
		if wrote { out.Write(", ") }
		out.Write("...)")
	}
	out.Write(" @")
	out.Write(instr.StrVal)
	out.WriteByte('(')
	if sret {
		// The hidden sret buffer pointer is the first argument; the alloca is
		// hoisted to function entry (emitCCallSretAllocDecl).
		out.Write("ptr sret(")
		out.Write(llvmType(instr.Typ))
		out.Write(") align 8 %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sret")
	}
	for i := 0; i < len(instr.Args); i++ {
		if i > 0 || sret { out.Write(", ") }
		// The same per-arg emitter the regular call uses: the coerced-aggregate,
		// memory-class byval, >16 indirect-pointer, and plain-scalar (with the
		// width-cast `.a<i>` naming emitted above) branches.
		writeByvalArgLLVM(out, instr, i, sret)
	}
	out.Write(")\n")
	if sret {
		// Load the aggregate result out of the sret buffer into %vID.
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(llvmType(instr.Typ))
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sret\n")
	} else if coerced {
		emitAggCallResultBind(out, instr)
	}
	return
}

// cCallRetSret reports whether an OP_C_CALL returns its aggregate result via a
// hidden sret buffer — an aggregate above the platform size cutoff (types.NeedsSret,
// which is false for a scalar/pointer/void and for an HFA).  Computed from the type
// because a verbatim C symbol has no funcRetTypes entry.
func cCallRetSret(ins @ir.Instr) bool {
	if cCallResultIsVoid(ins) || ins.Typ == nil {
		return false
	}
	return types.NeedsSret(ins.Typ)
}

// writeCCallAggRetType writes the register-coerced RETURN type of an aggregate
// __c_call result — the single-aggregate analogue of writeCMultiReturnCoercedType:
// the x86-64 SSE eightbyte form when a float eightbyte places it in XMM
// (types.SysVInSse, the branch emitAggCallResultBind's sysvEmitCallResultBind
// takes), else the GP `[N x iW]` coercion.  Must match the `.agR` capture type the
// bind consumes.
func writeCCallAggRetType(out *strings.Builder, t @types.Type) {
	if types.SysVInSse(t) {
		sysvReturnLLTy(out, t)
	} else {
		aggCoerceLLTy(out, t)
	}
}

// emitCCallSretAllocDecl emits the entry-hoisted `%vID.sret = alloca <T>` for an
// OP_C_CALL whose aggregate result returns via sret (cCallRetSret).  The type-based
// counterpart of emitSretAllocDecl (which keys on funcRetTypes, absent for a
// verbatim C symbol).  No-op otherwise.
func emitCCallSretAllocDecl(out *strings.Builder, ins @ir.Instr) {
	if !cCallRetSret(ins) {
		return
	}
	emitRef(out, ins.ID)
	out.Write(".sret = alloca ")
	out.Write(llvmType(ins.Typ))
	out.WriteByte('\n')
	return
}

// emitCCallDeclares emits `declare <ret> @<symbol>(<argtypes>)` for
// every distinct C symbol referenced by an OP_C_CALL in the module.
// Called from emitModule's preamble alongside the extern-function loop
// and the implicit-libc-Memcpy declare.
func emitCCallDeclares(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_C_CALL { continue }
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = slices.Append[@[]char](seen, ins.StrVal)
				emitCCallDeclare(out, ins)
			}
		}
	}
	return
}

// emitCCallDeclare writes one `declare` line for the OP_C_CALL.  The
// signature is reconstructed from the instr's arg types and return
// type (the same data codegen uses to emit the call itself).  For
// variadic callees, only the FIXED-arg types are spelled out; the
// trailing `, ...` denotes the variadic tail (the variadic actuals
// vary per call site, but the declared signature stays the same).
func emitCCallDeclare(out *strings.Builder, ins @ir.Instr) {
	var isVariadic bool = ins.CFixedArgs < len(ins.Args)
	var nFixed int = len(ins.Args)
	if isVariadic { nFixed = ins.CFixedArgs }
	var sret bool = cCallRetSret(ins)
	var sretOff int = 0
	if sret { sretOff = 1 }
	out.Write("declare ")
	// The declared return type MUST match the call site: `void` for an sret return
	// (the aggregate travels through the hidden buffer) or a void C function; the
	// register-coerced form for a small aggregate; else the plain type.
	if sret || cCallResultIsVoid(ins) {
		out.Write("void")
	} else if aggCallResultCoerced(ins) {
		writeCCallAggRetType(out, ins.Typ)
	} else {
		out.Write(llvmType(ins.Typ))
	}
	out.Write(" @")
	out.Write(ins.StrVal)
	out.WriteByte('(')
	// Each declared param type MUST match the call site's shape (writeByvalArgLLVM)
	// exactly, or LLVM lowers the direct call ambiguously.  Build the fixed-arg type
	// list WITH the leading sret pointer (when present) so the x64 memory-class
	// decision is position-aware (a ≤16 aggregate that STRADDLES the register file
	// after the sret pointer / a preceding arg is `ptr byval`, like the call site).
	var declArgTypes @[]@types.Type = make_slice(@types.Type, nFixed + sretOff)
	if sret { declArgTypes[0] = types.MakePointerType(types.TypUint8()) }
	for i := 0; i < nFixed; i++ { declArgTypes[sretOff + i] = ins.Args[i].Typ }
	var wrote bool = false
	if sret {
		out.Write("ptr sret(")
		out.Write(llvmType(ins.Typ))
		out.Write(") align 8")
		wrote = true
	}
	for i := 0; i < nFixed; i++ {
		if wrote { out.Write(", ") }
		writeCCallParamType(out, ins.Args[i].Typ, declArgTypes, i + sretOff)
		wrote = true
	}
	if isVariadic {
		if wrote { out.Write(", ") }
		out.Write("...")
	}
	out.Write(")\n")
	return
}

// writeCCallParamType spells the C-ABI LLVM type of one __c_call parameter at
// position `pos` in `argTypes`.  It is writeCAbiParamType PLUS the x86-64 SSE
// split: a float-containing ≤16-byte aggregate passed in registers is spelled one
// eightbyte type per eightbyte (`<2 x float>` / `float` / `double` / `iN`) so the
// declared/varargs-signature param matches the SSE-split ARGUMENT the value
// emitter (sysvWriteCallArg) produces — the GP `[N x i64]` form writeCAbiParamType
// would emit disagrees, which LLVM rejects.  A >16-byte or straddling SSE
// aggregate is memory-class (`ptr byval`), left to writeCAbiParamType.  This split
// is __c_call-specific: the #[c_export] thunk (writeCAbiParamType's other caller)
// forwards params in the GP shape and would mis-forward the split form, so it
// keeps the coerced spelling (its SSE-aggregate handling is tracked separately).
func writeCCallParamType(out *strings.Builder, at @types.Type, argTypes @[]@types.Type, pos int) {
	if types.SysVInSse(at) && !at.IsByvalParam() && !aggMemClassMaybeC(argTypes, pos, true) {
		sysvWriteDeclareParamTypes(out, at)
		return
	}
	writeCAbiParamType(out, at, argTypes, pos)
	// A sub-`int` scalar param carries `signext`/`zeroext` (the C-ABI extension a
	// clang callee assumes the caller applied) so the `declare` / varargs signature
	// matches the call-site argument writeByvalArgLLVM emits; "" for an aggregate /
	// ptr / word-width scalar.
	writeCAbiParamExtAttr(out, at)
}

// cCallSymbolSeen reports whether sym is already in the per-module
// dedup list of declared C symbols built up by emitCCallDeclares.
func cCallSymbolSeen(seen @[]@[]char, sym *[]readonly char) bool {
	for i := 0; i < len(seen); i++ {
		if cCallStrEq(seen[i], sym) { return true }
	}
	return false
}

// cCallStrEq compares two C-symbol names for exact byte equality.  A
// tiny local helper to keep emit_ccall.bn free of cross-package
// dependencies (pkg/binate/codegen's other string-compare helpers live with
// their consumers).
func cCallStrEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
