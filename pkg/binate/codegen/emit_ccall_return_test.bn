package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the AGGREGATE __c_call RETURN lowering (emit_ccall.bn): a C function
// returning a struct/array by value.  An aggregate above the platform size cutoff
// returns via a hidden sret buffer; a named struct/array below it returns
// register-coerced (`[N x iW]` GP, `<2 x float>`/… x64 SSE, `[N x float]` aa64 HFA)
// — the same forms Binate's own aggregate-returning functions use, whose internal
// convention is pinned to the C cutoff, so the machinery is shared.

// A >16-byte struct return (LP64 cutoff 16) is returned via a hidden sret buffer:
// the declare + call spell `ptr sret(<T>)`, and the result loads out of the entry-
// hoisted `%vID.sret` alloca.
func TestEmitCCallStructReturnSret() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"func f() int64 { var b Big = __c_call(\"mkBig\", Big); return b.a }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "declare void @mkBig(ptr sret(") {
		return fail("expected `declare void @mkBig(ptr sret(<Big>) ...)` for a >16-byte return")
	}
	if !contains(out, "call void @mkBig(ptr sret(") {
		return fail("expected the sret call `call void @mkBig(ptr sret(<Big>) ... %v..sret)`")
	}
	if !contains(out, ".sret = alloca ") {
		return fail("expected an entry-hoisted `%v..sret = alloca <Big>` buffer")
	}
	return ""
}

// A <=16-byte named struct return (2x int32 = 8 bytes) is register-coerced to the
// GP `[N x iW]` form on LP64: the call captures `%vID.agR` as `[1 x i64]`, the
// declare returns `[1 x i64]`, and the post-call bind reinterprets it to the struct.
func TestEmitCCallStructReturnGpCoerced() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Small struct { a int32; b int32 }\n"
			"func f() int32 { var s Small = __c_call(\"mkSmall\", Small); return s.a }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "declare [1 x i64] @mkSmall()") {
		return fail("expected `declare [1 x i64] @mkSmall()` (GP-coerced 8-byte return)")
	}
	if !contains(out, ".agR = call [1 x i64] @mkSmall()") {
		return fail("expected the coerced-result capture `%v..agR = call [1 x i64] @mkSmall()`")
	}
	if contains(out, "sret") {
		return fail("an 8-byte struct return must NOT sret")
	}
	return ""
}

// A <=16-byte all-float struct return (2x float32) on x86-64 comes back in an SSE
// register, spelled `<2 x float>` (one SSE eightbyte of two floats) — NOT the GP
// `[N x i64]` form, which would read it from a GP register the C callee never used.
func TestEmitCCallStructReturnSseX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type FP struct { x float32; y float32 }\n"
			"func f() float32 { var p FP = __c_call(\"mkFP\", FP); return p.x }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "declare <2 x float> @mkFP()") {
		return fail("expected `declare <2 x float> @mkFP()` (x64 SSE float-struct return)")
	}
	if !contains(out, ".agR = call <2 x float> @mkFP()") {
		return fail("expected the SSE-coerced result capture `%v..agR = call <2 x float> @mkFP()`")
	}
	return ""
}
