package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for emit_ccall.bn — the OP_C_CALL LLVM lowering used by the
// __c_call intrinsic.  Covers:
//   * the emitted call uses the raw (UN-mangled) symbol name,
//   * each distinct C symbol gets exactly one extern `declare`,
//   * the small per-module dedup helpers behave as documented.

// emitCCall must emit `<%vID> = call <ret> @<rawSym>(<args>)` with the
// symbol VERBATIM — no `bn_<kind>...` mangling.  This is the property
// that distinguishes __c_call from every other call op in codegen.
func TestEmitCCallEmitsRawSymbol() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt32()
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// __c_call("abs", int32, cast(int32, -42))
	var argInt @ir.Instr = entry.EmitConstInt(-42, types.TypInt32())
	var ccArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	ccArgs[0] = argInt
	var ret @ir.Instr = entry.EmitCCall("abs", ccArgs, types.TypInt32(), 1)

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ret
	entry.EmitReturn(retArgs)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "call i32 @abs(") {
		return fail("expected verbatim `call i32 @abs(...)` (no mangling)")
	}
	// Make sure we are NOT routing through the bn_<kind> mangler —
	// any leak of `bn_F1_4_main1_3_abs` or similar would mean the dedicated
	// emit path silently fell back to the normal OP_CALL lowering.
	if contains(out, "bn_F1_4_main1_3_abs") {
		return fail("`abs` must not be name-mangled by __c_call lowering")
	}
	return ""
}

// A void __c_call (resultTyp == nil — the "void" spelling) lowers to a
// result-less `call void @<sym>(...)`: no `%vID = ` prefix (a void call
// produces no SSA value, and `llvmType(nil)` is `i64`, so void is written
// explicitly), plus a matching `declare void @<sym>(...)`.
func TestEmitCCallVoidReturn() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// __c_call("free", "void", <*uint8>) — a nil resultTyp is the void form.
	var p @ir.Instr = entry.EmitConstNil(types.MakePointerType(types.TypUint8()))
	var ccArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	ccArgs[0] = p
	entry.EmitCCall("free", ccArgs, nil, 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "call void @free(") {
		return fail("void __c_call must emit `call void @free(...)`")
	}
	if contains(out, "= call void @free") {
		return fail("a void call has no SSA result — must not emit `%v = call void`")
	}
	if !contains(out, "declare void @free(") {
		return fail("void __c_call must emit `declare void @free(...)`")
	}
	return ""
}

// Each distinct C symbol referenced in the module must get exactly
// one `declare <ret> @<sym>(<argtypes>)`.  emitCCallDeclares dedupes,
// so calling `abs` twice still yields a single declare.
func TestEmitCCallDeclaresAreDeduped() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var a1 @ir.Instr = entry.EmitConstInt(1, types.TypInt32())
	var a2 @ir.Instr = entry.EmitConstInt(2, types.TypInt32())
	var args1 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args1[0] = a1
	var args2 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args2[0] = a2
	entry.EmitCCall("abs", args1, types.TypInt32(), 1)
	entry.EmitCCall("abs", args2, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "declare i32 @abs(i32)") {
		return fail("expected `declare i32 @abs(i32)` line")
	}
	if countOccurrences(out, "declare i32 @abs(") != 1 {
		return fail("expected exactly one declare for `abs` (dedup)")
	}
	return ""
}

// Different symbols must each get their own declare; ensures the
// dedup is keyed by symbol, not "any C call seen".
func TestEmitCCallDeclaresKeyedBySymbol() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var a @ir.Instr = entry.EmitConstInt(1, types.TypInt32())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = a
	entry.EmitCCall("abs", args, types.TypInt32(), 1)
	entry.EmitCCall("labs", args, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "declare i32 @abs(") {
		return fail("expected declare for `abs`")
	}
	if !contains(out, "declare i32 @labs(") {
		return fail("expected declare for `labs`")
	}
	return ""
}

// Direct unit test for cCallStrEq — exercises the equal, unequal,
// and length-mismatch branches.
func TestCCallStrEq() testing.TestResult {
	if !cCallStrEq("abs", "abs") { return fail("equal strings should compare equal") }
	if cCallStrEq("abs", "ABS") { return fail("case-different strings must not compare equal") }
	if cCallStrEq("abs", "absx") { return fail("length-mismatched strings must not compare equal") }
	if cCallStrEq("", "") {} else { return fail("empty strings should compare equal") }
	return ""
}

// cCallSymbolSeen + appendCCallSymbol together implement the
// per-module dedup; both ends of the contract matter (Seen reports
// presence; Append actually grows the list so Seen flips to true).
func TestCCallSymbolDedup() testing.TestResult {
	var seen @[]@[]char
	if cCallSymbolSeen(seen, "abs") {
		return fail("empty list should not report `abs` seen")
	}
	seen = slices.Append[@[]char](seen, "abs")
	if !cCallSymbolSeen(seen, "abs") {
		return fail("after Append, Seen should report `abs` present")
	}
	if cCallSymbolSeen(seen, "labs") {
		return fail("Seen must not false-positive a different symbol")
	}
	seen = slices.Append[@[]char](seen, "labs")
	if len(seen) != 2 {
		return fail("Append should grow the list by one each call")
	}
	return ""
}

// Variadic __c_call (Stage 3): the LLVM `call` site must spell out the
// function-pointer signature `<ret> (<fixed-types>, ...)` before the
// @symbol, so LLVM lowers per the platform varargs convention.  Without
// the explicit `, ...` LLVM would treat the call as fixed-arity and
// pick the wrong ABI on darwin-arm64 (and miss the AL setup on
// x86-64).
func TestEmitCCallVariadicCallHasVarargsSig() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// printf(fmtPtr, 42) — 1 fixed arg (*uint8) + 1 variadic (i32).
	var fmtPtr @ir.Instr = entry.EmitConstNil(types.MakePointerType(types.TypUint8()))
	var v @ir.Instr = entry.EmitConstInt(42, types.TypInt32())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = fmtPtr
	args[1] = v
	entry.EmitCCall("printf", args, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, " = call i32 (i8*, ...) @printf(") {
		return fail("variadic call must spell out `(<fixed-types>, ...)` signature")
	}
	if !contains(out, "declare i32 @printf(i8*, ...)") {
		return fail("variadic declare must end with `, ...`")
	}
	return ""
}

// Non-variadic __c_call must NOT spell out the function-pointer
// signature — the simpler `<ret> @sym(<args>)` form is correct (and
// the declare has no trailing `, ...`).  Regression guard for any
// future refactor accidentally emitting the varargs sig everywhere.
func TestEmitCCallNonVariadicHasNoVarargsSig() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var a @ir.Instr = entry.EmitConstInt(-42, types.TypInt32())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = a
	entry.EmitCCall("abs", args, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if contains(out, "(i32, ...) @abs") || contains(out, "(...) @abs") {
		return fail("non-variadic call must not have a varargs signature")
	}
	if contains(out, "declare i32 @abs(i32, ...)") {
		return fail("non-variadic declare must not have `, ...`")
	}
	if !contains(out, "declare i32 @abs(i32)") {
		return fail("expected plain declare for `abs`")
	}
	return ""
}

// Two variadic call sites for the same C symbol with DIFFERENT
// variadic-arg counts must still emit exactly one extern declare —
// the variadic-arg types vary per call site, but the declared
// signature (fixed prefix + `, ...`) does not.  Realistic case is
// printf used twice in a module with different arg counts.
func TestEmitCCallDedupVariadicSameSymbol() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var fmtPtr @ir.Instr = entry.EmitConstNil(types.MakePointerType(types.TypUint8()))
	var v1 @ir.Instr = entry.EmitConstInt(1, types.TypInt32())
	var v2 @ir.Instr = entry.EmitConstInt(2, types.TypInt32())

	// printf(fmt, 1) — 1 fixed + 1 variadic.
	var args1 @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args1[0] = fmtPtr
	args1[1] = v1
	entry.EmitCCall("printf", args1, types.TypInt32(), 1)

	// printf(fmt, 1, 2) — 1 fixed + 2 variadic.
	var args2 @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args2[0] = fmtPtr
	args2[1] = v1
	args2[2] = v2
	entry.EmitCCall("printf", args2, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if countOccurrences(out, "declare i32 @printf(") != 1 {
		return fail("variadic dedup: expected exactly one declare for `printf`")
	}
	if !contains(out, "declare i32 @printf(i8*, ...)") {
		return fail("declare should be `printf(i8*, ...)` (fixed prefix + variadic tail)")
	}
	return ""
}

// countOccurrences counts non-overlapping occurrences of needle in
// haystack — small local helper used to verify the declare-dedup
// invariant (exactly one occurrence).
func countOccurrences(haystack *[]readonly char, needle *[]readonly char) int {
	if len(needle) == 0 || len(haystack) < len(needle) { return 0 }
	var n int = 0
	var i int = 0
	for i <= len(haystack) - len(needle) {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] { match = false; break }
		}
		if match { n = n + 1; i = i + len(needle) } else { i = i + 1 }
	}
	return n
}

// A variadic __c_call whose FIXED args include a by-value AGGREGATE must spell
// that param, in the explicit call-site varargs signature, in its C-ABI-COERCED
// shape ([N x iW]) — matching both the coerced ARGUMENT (writeByvalArgLLVM) and
// the `declare`.  Spelling the raw struct type made the fixed param disagree with
// its argument (`%struct` vs `[2 x float]`), which clang rejects as invalid LLVM,
// so the whole program failed to compile.  Regression guard for that fix.
func TestEmitCCallVariadicFixedAggregateCoercedSig() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64) // pin the coerced spelling ([2 x float]); reset below
	var src *[]readonly char = "package \"main\"\n"
			"type V2 struct { x float32; y float32 }\n"
			"func main() {\n"
			"\tvar a V2\n"
			"\ta.x = 1.0\n"
			"\tvar b V2\n"
			"\tb.x = 2.0\n"
			"\tvar n int32 = __c_call(\"vfa\", int32, a, cast(int32, 1), ..., b)\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// The call-site varargs signature spells the fixed aggregate coerced ([2 x
	// float]) — matching both the coerced argument and the declare.  Pre-fix it
	// carried the raw `%...V2` struct type here, so this exact string was absent
	// and clang rejected the module.
	if !contains(out, "call i32 ([2 x float], i32, ...) @vfa(") {
		setTarget64()
		return fail("variadic call-site sig must spell the fixed aggregate coerced ([2 x float])")
	}
	// The declare agrees (it always used writeCAbiParamType).
	if !contains(out, "declare i32 @vfa([2 x float], i32, ...)") {
		setTarget64()
		return fail("variadic declare must spell the fixed aggregate coerced")
	}
	setTarget64()
	return ""
}

// On x86-64 a float-containing <=16 aggregate is SSE-class: the value is emitted
// SSE-split (<2 x float> / per-eightbyte), so the C-ABI param-type speller (the
// `declare` AND the variadic call-site signature) must spell it the same way.
// The GP `[N x i64]` coercion disagreed with the SSE-split argument and clang
// rejected the whole module — for a NON-variadic float-aggregate __c_call too, so
// this pins both call shapes.  Regression guard for the x64 half of the fix.
func TestEmitCCallX64SseAggregateParamMatchesArg() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64) // reset below
	var src *[]readonly char = "package \"main\"\n"
			"type V2 struct { x float32; y float32 }\n"
			"func main() {\n"
			"\tvar a V2\n"
			"\ta.x = 1.0\n"
			"\tvar b V2\n"
			"\tb.x = 2.0\n"
			"\tvar n1 int32 = __c_call(\"nv\", int32, a)\n"
			"\tvar n2 int32 = __c_call(\"vv\", int32, a, cast(int32, 1), ..., b)\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// Non-variadic: declare + call arg both spell the SSE aggregate <2 x float>.
	if !contains(out, "declare i32 @nv(<2 x float>)") {
		setTarget64()
		return fail("x64 non-variadic SSE aggregate declare must be <2 x float>")
	}
	if !contains(out, "call i32 @nv(<2 x float> ") {
		setTarget64()
		return fail("x64 non-variadic SSE aggregate call arg must be <2 x float>")
	}
	// Variadic: the call-site varargs signature's fixed SSE param + the declare.
	if !contains(out, "call i32 (<2 x float>, i32, ...) @vv(") {
		setTarget64()
		return fail("x64 variadic fixed SSE aggregate call-site sig must be <2 x float>")
	}
	if !contains(out, "declare i32 @vv(<2 x float>, i32, ...)") {
		setTarget64()
		return fail("x64 variadic fixed SSE aggregate declare must be <2 x float>")
	}
	setTarget64()
	return ""
}
