package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// The explicit function type of a variadic __c_call's call line carries TYPES only:
// LLVM rejects a parameter attribute there ("argument attributes invalid in function
// type"), so an sret result, a byval fixed param and a narrow fixed param are spelled
// `ptr`, `ptr` and `i8` in it — the attributes stay on the arguments and the declare.

// varSigSrc calls a variadic C function returning a 24-byte struct (sret on every
// target), with a 24-byte struct and an int8 before `...`.
var varSigSrc *[]readonly char = "package \"main\"\n"
		"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
		"func f(b Big, c int8) Big { return __c_call(\"vf\", Big, b, c, ..., cast(int32, 1)) }\n"
		"func main() {}\n"

// x86-64: the sret pointer and the byval Big are `ptr`, the int8 `i8`.
func TestVariadicCCallSignatureBareTypesX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var out @[]char = compileToLLVM(varSigSrc)
	types.SetArch(types.ARCH_UNKNOWN)
	if !contains(out, "call void (ptr, ptr, i8, ...) @vf(ptr sret(") {
		return fail("the variadic call's signature must be (ptr, ptr, i8, ...) with no attributes")
	}
	if !contains(out, "declare void @vf(ptr sret(") {
		return fail("the declare keeps the sret attribute")
	}
	if !contains(out, "@vf(ptr sret(%bn_S1_4_main1_3_Big) align 8 %v") ||
			!contains(out, ", i8 signext %v") {
		return fail("the arguments keep their sret / signext attributes")
	}
	return ""
}

// x86-64: the sret pointer takes RDI, so after four int64s only R9 is left and a
// 16-byte struct goes to memory — `ptr byval` as the argument and `ptr` in the
// signature, which must count the sret pointer as the declare does.
func TestVariadicCCallSignatureSretShiftX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
					"type P struct { a int64\n\tb int64 }\n"
					"func g(i int64, p P) Big {\n"
					"\treturn __c_call(\"vg\", Big, i, i, i, i, p, ..., cast(int32, 1))\n"
					"}\n"
					"func main() {}\n")
	types.SetArch(types.ARCH_UNKNOWN)
	if !contains(out, "call void (ptr, i64, i64, i64, i64, ptr, ...) @vg(ptr sret(") {
		return fail("after the sret pointer and four int64s, P is memory-class: `ptr` in the signature")
	}
	if !contains(out,
			"declare void @vg(ptr sret(%bn_S1_4_main1_3_Big) align 8, i64, i64, i64, i64, ptr byval(") {
		return fail("the declare passes P byval")
	}
	return ""
}

// arm32: the same, the Big passed by value split across r0-r3 and the stack.
func TestVariadicCCallSignatureBareTypesArm32() testing.TestResult {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	var out @[]char = compileToLLVM(varSigSrc)
	types.SetArch(types.ARCH_UNKNOWN)
	setTarget64()
	if !contains(out, "call void (ptr, ptr, i8, ...) @vf(ptr sret(") {
		return fail("the variadic call's signature must be (ptr, ptr, i8, ...) with no attributes")
	}
	return ""
}
