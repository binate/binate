package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/std/strings"

// C-ABI ENTRY classification for the LLVM backend: whether a #[c_export] / __c_entry
// entry must ADAPT the platform C ABI to Binate's internal form (and how), and the
// coerced return type to present when it does.  Shared by the #[c_export] entry
// emission (emit_cexport_thunk.bn) and the __c_entry entry lowering (emit_c_entry.bn),
// which both hand C a callable entry for the same function and so face the same
// return/parameter divergences.  The parallel per-target classifier for the native
// backends is pkg/binate/native/callconv (CExportMultiReturnAdaptKind et al.).

// cExportNeedsThunk reports whether f's C entry must ADAPT some part of the C ABI
// to Binate's internal form and so requires an adapting entry thunk rather than a
// plain alias: only when the RETURN diverges (cExportRetNeedsAdapt) — a multi-value
// tuple the C ABI sret's but the internal convention keeps in registers (or packs
// differently).  Parameters never diverge on their own: Binate passes each the C
// way on every target.  An adapted return's C-side sret pointer can shift the
// x86-64 register cursor, which the thunk then adapts for its parameters too.
func cExportNeedsThunk(f @ir.Func) bool {
	return cExportRetNeedsAdapt(f)
}

// cExportRetNeedsAdapt reports whether f's RETURN convention differs between the
// platform C ABI (what a C caller of the export uses) and Binate's internal
// convention (what the mangled definition emits), so the C entry must ADAPT the
// return rather than expose the internal one directly.  Two divergences:
//
//   - sret: a multi-value tuple the C ABI returns via a hidden sret buffer
//     (cMultiRetNeedsSret) while the internal convention keeps it in the return
//     registers as a first-class aggregate (!multiRetNeedsSret).  The internal
//     register budget (FuncReturnsBigMultiReturn — up to 8 GP on aarch64, 3 on
//     x86-64, 4 on arm32, matching clang's FCA-return lowering) is WIDER than the
//     C struct-return budget (> 16-byte / > 4-byte → memory), so the internal
//     convention register-returns a tuple the C ABI sret's.
//   - in-register packing (cExportMultiRetInRegCoerced): both return in registers
//     but the C ABI PACKS sub-word fields per eightbyte where the internal FCA
//     spreads them.
//
// A single aggregate return uses the C cutoff (needsSret) on both sides and the
// same coercion, so it never diverges; and whenever the internal convention
// itself sret's the tuple, the narrower C budget does too, so both forward the
// same sret buffer with no adaptation.
func cExportRetNeedsAdapt(f @ir.Func) bool {
	return (cMultiRetNeedsSret(f) && !multiRetNeedsSret(f)) || cExportMultiRetInRegCoerced(f)
}

// cExportMultiRetInRegCoerced reports whether f's multi-value return is returned
// IN registers by BOTH the C ABI and the internal convention, but the C ABI PACKS
// sub-word fields per eightbyte where the internal first-class aggregate spreads
// them (e.g. aarch64 (int32,int32): clang packs into x0, the FCA uses w0/w1) — so
// the C entry must present clang's eightbyte-coerced form, reinterpreted from the
// internal return.  NOT the sret case (cMultiRetNeedsSret) nor an HFA
// (callconv.CMultiReturnTupleReturnsHfaInFpRegs — the FCA already matches clang's
// FP-register return).
// The trigger is a field narrower than a register word: a tuple of word-sized
// fields (the common (T, @Error)) needs no repack and stays a plain alias.
func cExportMultiRetInRegCoerced(f @ir.Func) bool {
	if len(f.Results) <= 1 {
		return false
	}
	return callconv.CMultiReturnTupleInRegCoerced(f.MultiReturnType)
}

// writeCMultiReturnCoercedType writes clang's C struct-return coerced type for f's
// in-register multi-value tuple `t`: the x86-64 SSE eightbyte form
// (sysvReturnLLTy) when any eightbyte classifies SSE, else the GP `[N x iW]`
// coercion (aggCoerceLLTy) — the SAME spelling a single named-aggregate return of
// the tuple's layout uses, which clang agrees with.  The SSE test classifies the
// eightbytes directly (tupleReturnHasSseEightbyteX64) rather than via SysVInSse,
// which excludes the ANONYMOUS multi-return tuple from the coerced-kind set.  Only
// valid for the register-return coercion cases (not sret, not HFA — so
// aggCoerceLLTy takes its GP branch, never the SIMD one).
func writeCMultiReturnCoercedType(out *strings.Builder, t @types.Type) {
	if targetIsX64() && tupleReturnHasSseEightbyteX64(t) {
		sysvReturnLLTy(out, t)
	} else {
		aggCoerceLLTy(out, t)
	}
}

// tupleReturnHasSseEightbyteX64 reports whether any eightbyte of the multi-return
// tuple `t` classifies as an x86-64 SSE (float) eightbyte — so the C struct-return
// coerced form places it in an XMM register.  Classifies structurally
// (SysVClassify), so it applies to the anonymous tuple that SysVInSse excludes.
func tupleReturnHasSseEightbyteX64(t @types.Type) bool {
	var cl @[]int = types.SysVClassify(t)
	for eb := 0; eb < len(cl); eb++ {
		if cl[eb] == types.EB_SSE {
			return true
		}
	}
	return false
}

// cMultiRetNeedsSret reports whether a C caller of a #[c_export] returning f's
// multi-value tuple receives it via a hidden sret buffer.  Thin @ir.Func wrapper
// over the shared callconv.CMultiReturnTupleNeedsSret, which both backends consult.
func cMultiRetNeedsSret(f @ir.Func) bool {
	if len(f.Results) <= 1 {
		return false
	}
	return callconv.CMultiReturnTupleNeedsSret(f.MultiReturnType)
}
