package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the LLVM-backend C-ABI entry classification (emit_cexport_classify.bn):
// cExportRetNeedsAdapt decides whether a #[c_export] / __c_entry entry must adapt
// the multi-value return to the platform C struct-return ABI, and
// tupleReturnHasSseEightbyteX64 drives the coerced-return-type spelling.  The whole
// thunk emission is also covered end-to-end through compileToLLVM
// (emit_cexport_thunk_test.bn, emit_c_entry_test.bn); these pin the decision
// directly.  (setTarget64 lives in emit_util_test.bn, fail in emit_test.bn.)

// clTuple builds an anonymous multi-return @ir.Func returning the given field
// types (Results + MultiReturnType), as ir-gen's makeMultiReturnStructType shapes
// it.
func clFunc(fieldTypes @[]@types.Type) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	var noParams @[]@ir.Param
	var f @ir.Func = ir.NewFunc("main", "cb", noParams, fieldTypes)
	f.MultiReturnType = types.MakeStructType("", fields)
	return f
}

func cl2(a @types.Type, b @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = a
	r[1] = b
	return r
}

func cl3(a @types.Type, b @types.Type, c @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 3)
	r[0] = a
	r[1] = b
	r[2] = c
	return r
}

// (int64,int64,int64) 24B: the C ABI sret's it while the internal convention
// register-returns it — cExportRetNeedsAdapt on both x86-64 and aarch64.
func TestCExportRetNeedsAdaptSret() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var f @ir.Func = clFunc(cl3(types.TypInt64(), types.TypInt64(), types.TypInt64()))
	var x64 bool = cExportRetNeedsAdapt(f)
	types.SetArch(types.ARCH_AA64)
	var aa64 bool = cExportRetNeedsAdapt(f)
	types.SetArch(types.ARCH_AA64)
	if !x64 || !aa64 {
		return fail("(i64,i64,i64) must need return adaptation (C sret vs internal register-return)")
	}
	return ""
}

// (int64,int64) 16B word-sized: placed identically by both conventions — no
// adaptation (a plain alias / degenerate __c_entry).
func TestCExportRetNoAdaptWordSized() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var f @ir.Func = clFunc(cl2(types.TypInt64(), types.TypInt64()))
	if cExportRetNeedsAdapt(f) {
		types.SetArch(types.ARCH_AA64)
		return fail("(i64,i64) is word-sized and must NOT need adaptation")
	}
	types.SetArch(types.ARCH_AA64)
	return ""
}

// (int32,int32): both register-return, but the C ABI packs the two i32s into one
// eightbyte where the internal aggregate spreads them — a COERCE adaptation.
func TestCExportRetNeedsAdaptCoerce() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var f @ir.Func = clFunc(cl2(types.TypInt32(), types.TypInt32()))
	if !cExportRetNeedsAdapt(f) {
		return fail("(i32,i32) must need adaptation (sub-word eightbyte packing)")
	}
	return ""
}

// A single (non-multi) result never diverges — the C cutoff applies both ways.
func TestCExportRetNoAdaptSingleResult() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var noParams @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.TypInt64()
	var f @ir.Func = ir.NewFunc("main", "cb", noParams, res)
	if cExportRetNeedsAdapt(f) {
		types.SetArch(types.ARCH_AA64)
		return fail("a single scalar result must never need multi-return adaptation")
	}
	types.SetArch(types.ARCH_AA64)
	return ""
}

// tupleReturnHasSseEightbyteX64 classifies the anonymous tuple structurally, so a
// (float64,float64) tuple's eightbytes read as SSE (an all-float x86-64 return
// rides XMM0/XMM1) while an (int64,int64) tuple has none.
func TestTupleReturnHasSseEightbyteX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var ff @ir.Func = clFunc(cl2(types.TypFloat64(), types.TypFloat64()))
	var ii @ir.Func = clFunc(cl2(types.TypInt64(), types.TypInt64()))
	var sseF bool = tupleReturnHasSseEightbyteX64(ff.MultiReturnType)
	var sseI bool = tupleReturnHasSseEightbyteX64(ii.MultiReturnType)
	types.SetArch(types.ARCH_AA64)
	if !sseF {
		return fail("(f64,f64) must have an SSE eightbyte (XMM return)")
	}
	if sseI {
		return fail("(i64,i64) must have no SSE eightbyte (GP return)")
	}
	return ""
}
