package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the #[c_export] entry thunk's multi-value RETURN adaptation
// (emit_cexport_thunk.bn + emit_cexport_classify.bn): the internal return is laid
// out at the tuple's raw field offsets before C sees it, and an FP-HFA tuple with a
// struct field is returned in clang's FP-register form.  compileToLLVM / contains /
// fail live in emit_test.bn; setTarget64 / setTargetArm32 in emit_util_test.bn.

// (int32, P) with P = {x, y int32}: the internal flat return spells P `[1 x i64]`,
// which a whole-struct store would put at offset 8; C's struct has P at offset 4, so
// the thunk lays each field out at its raw offset before loading clang's form.
func TestEmitCExportTupleStructFieldAtRawOffsetAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type P struct { x int32\n\ty int32 }\n"
			"#[c_export(\"mip\")]\n"
			"func Mip() (int32, P) { return 7, P{x: 8, y: 9} }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define [2 x i64] @\"mip\"()") {
		return fail("expected a thunk returning clang's packed `[2 x i64]`")
	}
	if !contains(out, "%ca.rt.sp1 = getelementptr i8, ptr %ca.rslot, i32 4") {
		return fail("the struct field must be laid out at its raw offset 4")
	}
	if !contains(out, "store [1 x i64] %ca.rt.se1, ptr %ca.rt.sp1") {
		return fail("the struct field must be stored at its own address")
	}
	if contains(out, "%r, ptr %ca.rslot") {
		return fail("the thunk must not store the flat return whole (misplaces the field)")
	}
	return ""
}

// (int32, P, int64): C returns the 24-byte tuple through its sret buffer.  The thunk
// lays the fields out in a local slot (a coerced field's store may run past the
// tuple) and copies exactly the tuple's leaves (i32 at 0, P at 4 and 8, i64 at 16)
// into the caller's buffer.
func TestEmitCExportTupleSretCopiesExactSizeAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type P struct { x int32\n\ty int32 }\n"
			"#[c_export(\"mipl\")]\n"
			"func Mipl() (int32, P, int64) { return 1, P{x: 2, y: 3}, 4 }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"mipl\"(ptr sret(") {
		return fail("expected a C-ABI entry thunk with an sret return")
	}
	if !contains(out, "%ca.rt.sp1 = getelementptr i8, ptr %ca.rslot, i32 4") {
		return fail("the struct field must be laid out at its raw offset 4")
	}
	var thunk @[]char = defineBodyWith(out, "@\"mipl\"")
	if !contains(thunk, "%v0.fc3_dp = getelementptr i8, ptr %ca.sret, i32 16") ||
			contains(thunk, "%v0.fc4_") {
		return fail("exactly the tuple's four leaves must be copied into the C sret buffer")
	}
	if contains(out, "%r, ptr %ca.sret") {
		return fail("the thunk must not store the flat return into the C buffer whole")
	}
	return ""
}

// (V2d, float64) with V2d = {x, y float64}: an aarch64 HFA in C (d0..d2), so the
// thunk returns `[3 x double]`, reloaded from the fields laid out in the slot.
func TestEmitCExportHfaFieldTupleAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type V2d struct { x float64\n\ty float64 }\n"
			"#[c_export(\"mvd\")]\n"
			"func Mvd() (V2d, float64) { return V2d{x: 1.5, y: 2.5}, 3.5 }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define [3 x double] @\"mvd\"()") {
		return fail("expected a thunk returning the HFA form `[3 x double]`")
	}
	if !contains(out, "%rc = load [3 x double], ptr %ca.rslot") {
		return fail("the thunk must reload the HFA members from the slot")
	}
	return ""
}

// arm32 hard-float: (V2f, float32) is a three-float HFA in C (s0..s2) — repacked from
// the slot; (D3, float64)'s six GP words exceed the four internal return registers, so
// the body returns through a local buffer the thunk reloads as `[4 x double]`.
func TestEmitCExportHfaFieldTupleArm32Hard() testing.TestResult {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	var src *[]readonly char = "package \"main\"\n"
			"type V2f struct { x float32\n\ty float32 }\n"
			"type D3 struct { x float64\n\ty float64\n\tz float64 }\n"
			"#[c_export(\"mvf\")]\n"
			"func Mvf() (V2f, float32) { return V2f{x: 1.5, y: 2.5}, 3.5 }\n"
			"#[c_export(\"md3\")]\n"
			"func Md3() (D3, float64) { return D3{x: 1.5, y: 2.5, z: 3.5}, 4.5 }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "define [3 x float] @\"mvf\"()") {
		return fail("expected the (V2f, float32) thunk to return `[3 x float]`")
	}
	if !contains(out, "%rc = load [3 x float], ptr %ca.rslot") {
		return fail("the (V2f, float32) thunk must reload the members from the slot")
	}
	if !contains(out, "define [4 x double] @\"md3\"()") {
		return fail("expected the (D3, float64) thunk to return `[4 x double]`")
	}
	if !contains(out, "%rc = load [4 x double], ptr %ca.sret") {
		return fail("the (D3, float64) thunk must reload the body's sret buffer")
	}
	return ""
}
