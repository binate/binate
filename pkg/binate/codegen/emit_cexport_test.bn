package "pkg/binate/codegen"

import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Tests for #[c_export] LLVM alias emission.
// A #[c_export("name")] function gets an additional `@"name" = alias i8, ptr
// @<mangled>` line so C can reach it under the unmangled name; the mangled bn_
// define is untouched.  compileToLLVM / contains / fail live in emit_test.bn.

func TestEmitCExportAlias() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"add_ints\")]\n"
			"func Add(a int, b int) int { return a + b }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"add_ints\" = alias i8, ptr @bn_") {
		return fail("expected c_export alias `@\"add_ints\" = alias i8, ptr @bn_...`")
	}
	return ""
}

// Several #[c_export] names on one function each get their own alias.
func TestEmitCExportMultipleAliases() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"a1\", \"a2\")]\n"
			"func F() {}\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"a1\" = alias i8, ptr @bn_") {
		return fail("expected alias a1")
	}
	if !contains(out, "@\"a2\" = alias i8, ptr @bn_") {
		return fail("expected alias a2")
	}
	return ""
}

// A function without #[c_export] gets no alias.
func TestEmitNoCExportNoAlias() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc Plain() int { return 1 }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "= alias ") {
		return fail("no alias should be emitted without #[c_export]")
	}
	return ""
}

// The c_export name policy is permissive (any string), so a name with a `"` or
// `\` must be hex-escaped into the LLVM quoted identifier (\22 / \5C) rather
// than emitted raw — which would be a clang parse error.  Built programmatically
// to avoid source-level escaping.
func TestCExportNameEscaping() testing.TestResult {
	var name @[]char
	name = slices.Append[char](name, 'a')
	name = slices.Append[char](name, cast(char, 34)) // "
	name = slices.Append[char](name, 'b')
	name = slices.Append[char](name, cast(char, 92)) // backslash
	name = slices.Append[char](name, 'c')
	var sb @strings.Builder = strings.NewBuilder()
	writeLLVMQuotedName(sb, name)
	var got @[]readonly char = sb.String()
	if !contains(got, "\\22") {
		return fail("a double-quote in a c_export name must be hex-escaped as \\22")
	}
	if !contains(got, "\\5C") {
		return fail("a backslash in a c_export name must be hex-escaped as \\5C")
	}
	// The raw `a`, `b`, `c` bytes pass through unescaped.
	if !contains(got, "a") || !contains(got, "b") || !contains(got, "c") {
		return fail("printable bytes must pass through unescaped")
	}
	return ""
}

// A #[c_export] function returning a signed sub-`int`-width result must carry the
// `signext` return attribute on its define — a clang caller at -O1+ trusts the
// callee to have extended and reads the whole register (no re-extension), so an
// un-extended i8 return would surface as dirty upper bits / a wrong value.
func TestEmitCExportSignextI8Return() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"r8\")]\n"
			"func R(x int) int8 { return cast(int8, x) }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define signext i8 @bn_") {
		return fail("expected `define signext i8` for a c_export int8 return")
	}
	return ""
}

// int16 is likewise sub-`int` on every target, so it too signext-extends.
func TestEmitCExportSignextI16Return() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"r16\")]\n"
			"func R(x int) int16 { return cast(int16, x) }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define signext i16 @bn_") {
		return fail("expected `define signext i16` for a c_export int16 return")
	}
	return ""
}

// An unsigned sub-`int` result zero-extends (`zeroext`), not sign-extends.
func TestEmitCExportZeroextU8Return() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"ru8\")]\n"
			"func R(x int) uint8 { return cast(uint8, x) }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define zeroext i8 @bn_") {
		return fail("expected `define zeroext i8` for a c_export uint8 return")
	}
	return ""
}

// A bool result (i1) zero-extends — clang's `_Bool` ABI is `zeroext i1`.
func TestEmitCExportZeroextBoolReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"rb\")]\n"
			"func R(x int) bool { return x != 0 }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define zeroext i1 @bn_") {
		return fail("expected `define zeroext i1` for a c_export bool return")
	}
	return ""
}

// A word-width (C `int`-and-wider) result carries NO extension attribute, exactly
// as clang emits — the attributes apply only below C `int`.
func TestEmitCExportWordReturnNoExt() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n#[c_export(\"rw\")]\n"
			"func R(x int) int { return x }\nfunc main() {}\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "signext") || contains(out, "zeroext") {
		return fail("a word-width c_export return must carry no signext/zeroext")
	}
	return ""
}

// A sub-`int` scalar return is extended UNCONDITIONALLY — no #[c_export] /
// __c_entry annotation required — matching the native backends' full-width
// canonical returns and the VM.  This is exactly what gives SEPARATE compilation
// parity: an ordinary narrow-return function's own compile extends its define
// even though no __c_entry use of it is visible there (the use may be in another
// package).  int8 sign-extends; uint8 zero-extends.
func TestEmitNarrowReturnExtendedUnconditionally() testing.TestResult {
	var srcS *[]readonly char = "package \"main\"\n"
			"func R(x int) int8 { return cast(int8, x) }\n"
			"func main() int { return cast(int, R(1)) }\n"
	if !contains(compileToLLVM(srcS), "define signext i8 @bn_") {
		return fail("an ordinary int8 return must sign-extend (`define signext i8`)")
	}
	var srcU *[]readonly char = "package \"main\"\n"
			"func R(x int) uint8 { return cast(uint8, x) }\n"
			"func main() int { return cast(int, R(1)) }\n"
	if !contains(compileToLLVM(srcU), "define zeroext i8 @bn_") {
		return fail("an ordinary uint8 return must zero-extend (`define zeroext i8`)")
	}
	return ""
}
