package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// A #[c_export] function is reachable from C under each export name.  When none
// of its parameters needs C-ABI adaptation, the export name is a plain alias of
// the mangled definition (emitCExportAlias): the definition itself is a correct
// C entry.  But a parameter that is a >16-byte by-value aggregate is passed
// DIFFERENTLY by the two conventions on x86-64 and arm32: Binate's internal
// convention hands it over as a single pointer in a GP register
// (types.IsByvalParam / writeParamTypeLLVM's plain `ptr`), while the platform C ABI
// passes it BY VALUE — on x86-64 in the SysV MEMORY class (on the stack), on arm32
// (AAPCS32) split across the core registers and stack.  A C caller following the
// platform convention therefore does NOT match the mangled definition — a silent
// mis-ABI.  On aarch64 the conventions coincide (a >16-byte aggregate rides a
// pointer in a register under AAPCS64 too), so no adaptation is needed there.
//
// For such a function this file emits a small C-ABI ENTRY THUNK under the export
// name instead of an alias: the thunk declares the true C-ABI signature and
// forwards to the mangled internal definition, mapping each parameter from its C
// form to its internal form.  Scalars and pointers forward straight through (same
// LLVM type; LLVM re-assigns the registers).  A >16-byte aggregate is forwarded as
// the internal plain `ptr`: on x86-64 it arrives as `ptr byval` (already a pointer,
// forwarded directly); on arm32 it arrives as a by-value coerced `[N x iW]` and is
// spilled to an alloca whose pointer is forwarded.  A further subtlety on x86-64:
// because a >16-byte aggregate consumes NO C register (MEMORY class) but one
// internal register, it shifts the register cursor, so a ≤16-byte aggregate that
// follows one can be register-class in C yet memory-class internally — that param is
// likewise spilled.  See emitCExportThunk for the full case list.

// emitCExportEntries emits, per #[c_export("name")] on f, either a C-ABI entry
// thunk (when a parameter needs adaptation) or a plain alias.  Externs have no
// body to export.
func emitCExportEntries(out *strings.Builder, f @ir.Func, funcRetTypes *[]FuncRetType) {
	if f.IsExtern {
		return
	}
	var thunked bool = cExportNeedsThunk(f)
	for i := 0; i < len(f.CExportNames); i++ {
		if thunked {
			emitCExportThunk(out, f, f.CExportNames[i], funcRetTypes)
		} else {
			emitCExportAlias(out, f, f.CExportNames[i])
		}
	}
}

// cExportNeedsThunk reports whether f has a parameter whose C-ABI passing form
// differs from Binate's internal form and so requires an adapting entry thunk.
// That is a >16-byte by-value aggregate on the targets whose C ABI passes such an
// aggregate by value rather than as the internal single pointer: x86-64 (SysV
// MEMORY class, `ptr byval`) and arm32 (AAPCS32, by-value coerced `[N x iW]`).
// aarch64's conventions coincide (a >16-byte aggregate rides a pointer both ways),
// so it never needs a thunk.  A >16-byte param is also what shifts the register
// cursor and so is the only trigger — a ≤16-byte straddle only arises alongside
// one.
func cExportNeedsThunk(f @ir.Func) bool {
	if !targetIsX64() && types.GetTarget().PointerSize != 4 {
		return false
	}
	for i := 0; i < len(f.Params); i++ {
		if f.Params[i].Typ.IsByvalParam() {
			return true
		}
	}
	return false
}

// emitCExportThunk emits a C-ABI entry thunk named cname that forwards to f's
// mangled definition.  Each parameter is declared in the platform C form
// (writeCAbiParamType) and forwarded in Binate's internal form.  The two diverge
// only for aggregates, and only because a >16-byte aggregate rides ONE GP register
// internally (a pointer) but is passed by value in the C ABI (consuming no register
// on x86-64 — SysV MEMORY / stack — or several on arm32 — AAPCS by-value split).
// Cases:
//   - x86-64 >16-byte aggregate: declared `ptr byval(<T>)` (C), forwarded plain
//     `ptr` — the same pointer;
//   - arm32 >16-byte aggregate: declared by-value coerced `[N x iW]` (C), spilled
//     to an alloca, forwarded plain `ptr` of that slot;
//   - x86-64 ≤16-byte aggregate that is register-class in C but MEMORY-class
//     internally (a preceding >16-byte aggregate shifted the cursor): declared
//     coerced `[N x iW]`, spilled, forwarded `ptr byval(<T>)` of the slot;
//   - a ≤16-byte aggregate classified the same way by both conventions: forwarded
//     straight through (coerced value, or an x86-64 both-memory byval pointer).
// Every scalar / pointer forwards straight through (same LLVM type; LLVM re-assigns
// the registers).  The return (including sret) is forwarded unchanged — the
// internal and C sret thresholds coincide on both targets.
func emitCExportThunk(out *strings.Builder, f @ir.Func, cname *[]readonly char,
		funcRetTypes *[]FuncRetType) {
	var mangled @[]char = mangle.FuncName(modulePkgName, f.Name)

	// Match the mangled definition's return shape (emitFuncDbg): a large aggregate
	// / large multi-return returns via sret; everything else returns by value.
	var useSret bool = false
	var sretRetType @[]char
	if len(f.Results) == 1 && needsSret(f.Results[0]) {
		useSret = true
		sretRetType = llvmType(f.Results[0])
	} else if multiRetNeedsSret(f) {
		useSret = true
		sretRetType = llvmType(f.MultiReturnType)
	}

	var retTyp @[]char = "void"
	if !useSret && len(f.Results) > 0 {
		retTyp = lookupRetType(funcRetTypes, mangled)
	}

	out.Write("define ")
	// A sub-`int`-width scalar return carries the platform extension attribute,
	// exactly as the mangled definition does (see cabiIntExtAttr).
	if !useSret && len(f.Results) == 1 && !aggRetCoerced(f.Results[0]) {
		out.Write(cabiIntExtAttr(f.Results[0]))
	}
	out.Write(retTyp)
	out.WriteByte(' ')
	writeLLVMQuotedName(out, cname)
	out.WriteByte('(')

	var defArgTypes @[]@types.Type = defineArgTypes(f, useSret)
	var defSretOff int = 0
	if useSret {
		out.Write("ptr sret(")
		out.Write(sretRetType)
		out.Write(") align 8 %ca.sret")
		if len(f.Params) > 0 {
			out.Write(", ")
		}
		defSretOff = 1
	}
	// Parameters in the platform C form (writeCAbiParamType, shared with the
	// __c_call declare): a >16-byte aggregate is `ptr byval` on x86-64 but a
	// by-value coerced `[N x iW]` on arm32; a ≤16-byte x86-64 straddle is `ptr
	// byval`; everything else is the coerced / scalar / pointer form.
	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out.Write(", ")
		}
		writeCAbiParamType(out, f.Params[i].Typ, defArgTypes, i + defSretOff)
		out.Write(" %ca")
		stringutils.WriteInt(out, i)
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\nentry:\n")

	// Spill each param that arrives as a VALUE but the internal convention forwards
	// as a pointer: a >16-byte aggregate on arm32 (arrives coerced `[N x iW]`, needs
	// a `ptr`), or a ≤16-byte x86-64 aggregate that is register-class in C but
	// MEMORY-class internally (arrives coerced, needs `ptr byval`).  Materialize the
	// incoming value in an alloca and forward a pointer to it.
	//
	// The alloca and store types are BOTH the incoming C form (writeCAbiParamType) —
	// they must match each other and the incoming param declaration.  Sizing the
	// alloca to the coerced `[N x iW]` (N·wordBytes, rounded up), not the aggregate's
	// natural size, is load-bearing: a non-word-multiple struct (e.g. a 12-byte
	// {i32,i32,i32}) would otherwise over-run a natural-sized slot and, at -O2, SROA
	// drops the out-of-bounds tail — a silent miscompile.  The `ptr byval(<T>)` /
	// `ptr` forward reads only SizeOf(T) ≤ the slot.  (Same rule as
	// writeAggParamAllocaDecl.)
	for i := 0; i < len(f.Params); i++ {
		if cExportThunkParamSpills(f, i, defArgTypes, defSretOff) {
			out.Write("  %ca")
			stringutils.WriteInt(out, i)
			out.Write(".slot = alloca ")
			writeCAbiParamType(out, f.Params[i].Typ, defArgTypes, i + defSretOff)
			out.Write(", align 8\n  store ")
			writeCAbiParamType(out, f.Params[i].Typ, defArgTypes, i + defSretOff)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
			out.Write(", ptr %ca")
			stringutils.WriteInt(out, i)
			out.Write(".slot\n")
		}
	}

	if useSret || len(f.Results) == 0 {
		out.Write("  call void @")
	} else {
		out.Write("  %r = call ")
		out.Write(retTyp)
		out.Write(" @")
	}
	out.Write(mangled)
	out.WriteByte('(')
	if useSret {
		out.Write("ptr sret(")
		out.Write(sretRetType)
		out.Write(") %ca.sret")
		if len(f.Params) > 0 {
			out.Write(", ")
		}
	}
	// Arguments in Binate's internal form.
	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out.Write(", ")
		}
		if f.Params[i].Typ.IsByvalParam() {
			out.Write("ptr %ca") // >16-byte aggregate: internal plain pointer
			stringutils.WriteInt(out, i)
			if cExportThunkParamSpills(f, i, defArgTypes, defSretOff) {
				out.Write(".slot") // arm32: forward the materialized copy (x64: the byval ptr)
			}
		} else if aggMemClass(defArgTypes, i + defSretOff) {
			// ≤16-byte aggregate the internal convention passes MEMORY-class byval.
			writeByvalMemType(out, f.Params[i].Typ)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
			if cExportThunkParamSpills(f, i, defArgTypes, defSretOff) {
				out.Write(".slot") // forward the spilled copy, not the register value
			}
		} else {
			writeParamTypeLLVM(out, f.Params[i].Typ)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
		}
	}
	out.Write(")\n")
	if useSret || len(f.Results) == 0 {
		out.Write("  ret void\n")
	} else {
		out.Write("  ret ")
		out.Write(retTyp)
		out.Write(" %r\n")
	}
	out.Write("}\n")
}

// cExportThunkParamSpills reports whether parameter i arrives as a VALUE that the
// internal convention forwards as a POINTER, and so must be materialized in an
// alloca.  Two cases: (1) a >16-byte aggregate on arm32 — the C ABI passes it by
// value (coerced `[N x iW]`) but the internal convention wants a `ptr`; (2) a
// ≤16-byte x86-64 aggregate that is register-class in C but MEMORY-class internally
// (a preceding >16-byte aggregate shifted the cursor) — arrives coerced, forwarded
// `ptr byval`.  It does NOT spill when the C ABI already hands over a pointer: an
// x86-64 >16-byte aggregate (`ptr byval`) or a ≤16-byte aggregate that is
// memory-class in C too — those forward the incoming pointer directly.
func cExportThunkParamSpills(f @ir.Func, i int, defArgTypes @[]@types.Type, defSretOff int) bool {
	var at @types.Type = f.Params[i].Typ
	// The internal convention forwards this param as a pointer: a >16-byte aggregate
	// (plain `ptr`) or an x86-64 ≤16-byte MEMORY-class straddle (`ptr byval`).
	var forwardIndirect bool = at.IsByvalParam() || aggMemClass(defArgTypes, i + defSretOff)
	// The C ABI already hands it over AS a pointer only for an x86-64 byval: a
	// >16-byte aggregate, or a ≤16-byte straddle that is memory-class in C too.
	var cAbiByvalPtr bool = (targetIsX64() && at.IsByvalParam()) ||
			aggMemClassMaybeC(defArgTypes, i + defSretOff, true)
	return forwardIndirect && !cAbiByvalPtr
}
