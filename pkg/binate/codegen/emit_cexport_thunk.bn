package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// A #[c_export] function is reachable from C under each export name.  When none
// of its parameters needs C-ABI adaptation, the export name is a plain alias of
// the mangled definition (emitCExportAlias): the definition itself is a correct
// C entry.  But a parameter that is a >16-byte by-value aggregate is passed
// DIFFERENTLY by the two conventions on x86-64 and arm32: Binate's internal
// convention hands it over as a single pointer in a GP register
// (types.IsByvalParam / writeParamTypeLLVM's plain `ptr`), while the platform C ABI
// passes it BY VALUE — on x86-64 in the SysV MEMORY class (on the stack), on arm32
// (AAPCS32) split across the core registers and stack.  A C caller following the
// platform convention therefore does NOT match the mangled definition — a silent
// mis-ABI.  On aarch64 the conventions coincide (a >16-byte aggregate rides a
// pointer in a register under AAPCS64 too), so no adaptation is needed there.
//
// For such a function this file emits a small C-ABI ENTRY THUNK under the export
// name instead of an alias: the thunk declares the true C-ABI signature and
// forwards to the mangled internal definition, mapping each parameter from its C
// form to its internal form.  Scalars and pointers forward straight through (same
// LLVM type; LLVM re-assigns the registers).  A >16-byte aggregate is forwarded as
// the internal plain `ptr`: on x86-64 it arrives as `ptr byval` (already a pointer,
// forwarded directly); on arm32 it arrives as a by-value coerced `[N x iW]` and is
// spilled to an alloca whose pointer is forwarded.  A further subtlety on x86-64:
// because a >16-byte aggregate consumes NO C register (MEMORY class) but one
// internal register, it shifts the register cursor, so a ≤16-byte aggregate that
// follows one can be register-class in C yet memory-class internally — that param is
// likewise spilled.  See emitCAbiAdapterThunk for the full case list.

// emitCExportEntries emits, per #[c_export("name")] on f, either a C-ABI entry
// thunk (when a parameter needs adaptation) or a plain alias.  Externs have no
// body to export.
func emitCExportEntries(out *strings.Builder, f @ir.Func, funcRetTypes *[]FuncRetType) {
	if f.IsExtern {
		return
	}
	var thunked bool = cExportNeedsThunk(f)
	for i := 0; i < len(f.CExportNames); i++ {
		if thunked {
			emitCAbiAdapterThunk(out, f, f.CExportNames[i], "", funcRetTypes)
		} else {
			emitCExportAlias(out, f, f.CExportNames[i])
		}
	}
}

// emitCAbiAdapterThunk emits a C-ABI entry thunk named thunkName (with LLVM
// `linkage`, empty for the strong #[c_export] entry / "linkonce_odr" for the weak
// coalesced __c_entry thunk) that forwards to f's mangled definition.  Each
// parameter is declared in the platform C form
// (writeCAbiParamType) and forwarded in Binate's internal form.  The two diverge
// only for aggregates, and only because a >16-byte aggregate rides ONE GP register
// internally (a pointer) but is passed by value in the C ABI (consuming no register
// on x86-64 — SysV MEMORY / stack — or several on arm32 — AAPCS by-value split).
// Cases:
//   - x86-64 >16-byte aggregate: declared `ptr byval(<T>)` (C), forwarded plain
//     `ptr` — the same pointer;
//   - arm32 >16-byte aggregate: declared by-value coerced `[N x iW]` (C), spilled
//     to an alloca, forwarded plain `ptr` of that slot;
//   - x86-64 ≤16-byte aggregate that is register-class in C but MEMORY-class
//     internally (a preceding >16-byte aggregate shifted the cursor): declared
//     coerced `[N x iW]`, spilled, forwarded `ptr byval(<T>)` of the slot;
//   - a ≤16-byte aggregate classified the same way by both conventions: forwarded
//     straight through (coerced value, or an x86-64 both-memory byval pointer).
// Every scalar / pointer forwards straight through (same LLVM type; LLVM
// re-assigns the registers).  The RETURN is forwarded unchanged when the C and
// internal conventions agree, but a divergent multi-value tuple
// (cExportRetNeedsAdapt) is ADAPTED — two shapes: (1) retAdapt, the C ABI sret's a
// tuple the internal convention register-returns → declare the sret buffer, call
// the register-returning def, STORE the first-class aggregate into the buffer; (2)
// cRegCoerce, both register-return but the C ABI packs sub-word fields per
// eightbyte → declare clang's coerced return type and REINTERPRET the internal
// return through a memory slot.  So the sret decision is split — cUseSret governs
// the C-facing signature, intUseSret the internal call.
func emitCAbiAdapterThunk(out *strings.Builder, f @ir.Func, thunkName *[]readonly char,
		linkage *[]readonly char, funcRetTypes *[]FuncRetType) {
	var mangled @[]char = mangle.FuncName(modulePkgName, f.Name)

	// The C-facing return convention (cUseSret) can differ from the mangled
	// definition's internal one (intUseSret): a single large aggregate sret's on
	// both sides (needsSret), but a multi-value tuple in the divergence window
	// sret's in C (cMultiRetNeedsSret) yet rides the return registers internally
	// (multiRetNeedsSret) — retAdapt.  A single result's decision is identical both
	// ways, so retAdapt is only ever a multi-return.  cRegCoerce is the register-
	// return packing divergence — no sret either side, but the C form is coerced.
	var singleSret bool = len(f.Results) == 1 && needsSret(f.Results[0])
	var cUseSret bool = singleSret || cMultiRetNeedsSret(f)
	var intUseSret bool = singleSret || multiRetNeedsSret(f)
	var retAdapt bool = cUseSret && !intUseSret
	var cRegCoerce bool = cExportMultiRetInRegCoerced(f)
	// coerceFromSret (x86-64): the C ABI register-returns a tuple the internal
	// convention sret's (> 3 narrow GP words the C ABI packs into ≤ 2 eightbytes).
	// The body writes a LOCAL buffer the entry then reloads in clang's coerced form.
	var coerceFromSret bool = cRegCoerce && intUseSret
	var sretRetType @[]char
	if cUseSret || intUseSret {
		if singleSret {
			sretRetType = llvmType(f.Results[0])
		} else {
			sretRetType = llvmType(f.MultiReturnType)
		}
	}

	// retTyp is the value the INTERNAL mangled call returns — void when it returns
	// via sret (or has no results), else its by-value / first-class-aggregate type
	// (lookupRetType).  It also spells the C-facing declared return type when the C
	// ABI returns by value in the SAME form (!cUseSret && !cRegCoerce).
	// retTyp must be the mangled DEFINITION's exact return spelling — for a
	// register-returned multi-value tuple that is the FLAT boundary form (the
	// per-field-coerced `multiReturnCoercedLLTy` when a field is coercible, else the
	// raw tuple), NOT bare llvmType(MultiReturnType): the padded raw form would put
	// the fields in the wrong return registers.  lookupRetType returns exactly the
	// form the funcRetTypes builder recorded for the def, and a cross-package
	// __c_entry target is registered as an extern in funcRetTypes (RegisterImports),
	// so it resolves here too.
	var retTyp @[]char = "void"
	if !intUseSret && len(f.Results) > 0 {
		retTyp = lookupRetType(funcRetTypes, mangled)
	}

	out.Write("define ")
	if len(linkage) > 0 {
		out.Write(linkage)
		out.WriteByte(' ')
	}
	// A sub-`int`-width scalar return carries the platform extension attribute,
	// exactly as the mangled definition does (see cabiIntExtAttr).
	if !cUseSret && len(f.Results) == 1 && !aggRetCoerced(f.Results[0]) {
		out.Write(cabiIntExtAttr(f.Results[0]))
	}
	if cUseSret {
		out.Write("void")
	} else if cRegCoerce {
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
	} else {
		out.Write(retTyp)
	}
	out.WriteByte(' ')
	writeLLVMQuotedName(out, thunkName)
	out.WriteByte('(')

	// Two register cursors: the C-facing declaration/arrival (cDefArgTypes/cSretOff,
	// with the sret buffer pointer prepended iff cUseSret) and the internal forward
	// (intDefArgTypes/intSretOff).  They coincide unless retAdapt, where only the C
	// side carries the sret slot — which on SretInGpArgReg targets (x86-64/arm32)
	// shifts the GP cursor and thus a following aggregate's memory-class decision.
	var cDefArgTypes @[]@types.Type = defineArgTypes(f, cUseSret)
	var cSretOff int = 0
	var intDefArgTypes @[]@types.Type = defineArgTypes(f, intUseSret)
	var intSretOff int = 0
	if intUseSret {
		intSretOff = 1
	}
	if cUseSret {
		out.Write("ptr sret(")
		out.Write(sretRetType)
		out.Write(") align 8 %ca.sret")
		if len(f.Params) > 0 {
			out.Write(", ")
		}
		cSretOff = 1
	}
	// Parameters in the platform C form (writeCAbiParamType, shared with the
	// __c_call declare): a >16-byte aggregate is `ptr byval` on x86-64 but a
	// by-value coerced `[N x iW]` on arm32; a ≤16-byte x86-64 straddle is `ptr
	// byval`; everything else is the coerced / scalar / pointer form.
	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out.Write(", ")
		}
		if cExportThunkParamCSse(f, i, cDefArgTypes, cSretOff) {
			// x86-64 SSE (float) aggregate the C ABI passes SSE-split in XMM/GP:
			// declare it SSE-split (one param per eightbyte), not the GP
			// `[N x i64]` — writeCAbiParamType would have the thunk read it from a
			// GP register the C caller never used.  (This covers both the
			// forward-straight-through case and the memory-class-internally case
			// that reconstructs to a byval below.)
			sysvWriteThunkSseParams(out, i, f.Params[i].Typ)
		} else {
			writeCAbiParamType(out, f.Params[i].Typ, cDefArgTypes, i + cSretOff)
			// A sub-`int` scalar param carries the platform C extension attribute
			// (`i8 signext` / `i8 zeroext`) here, matching what clang emits for the
			// same C prototype (and the __c_call declare, writeCCallParamType).  The
			// thunk is a C-ONLY entry, so this only constrains the C ABI; it forwards
			// (below) to the bare internal define, whose body re-extends the low bits.
			// (No-op for i32-and-wider / ptr / float / aggregate.)  The plain-alias
			// c_export shape can NOT get this — an alias cannot carry param attrs, and
			// adding signext to the shared internal define would break separate-
			// compilation Binate callers, which pass narrow args bare (the callee
			// re-extends).  So param-declaration parity here is thunk-only.
			writeCAbiParamExtAttr(out, f.Params[i].Typ)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
		}
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\nentry:\n")

	if coerceFromSret {
		// The C ABI returns the tuple in registers but the body sret's it: give the
		// body a LOCAL buffer (sized to the coerced form, ≥ the tuple) to write, then
		// reload it packed below.  The C caller passed no sret pointer.
		out.Write("  %ca.sret = alloca ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(", align 8\n")
	}

	// Spill each param that arrives as a VALUE but the internal convention forwards
	// as a pointer: a >16-byte aggregate on arm32 (arrives coerced `[N x iW]`, needs
	// a `ptr`), or a ≤16-byte x86-64 aggregate that is register-class in C but
	// MEMORY-class internally (arrives coerced, needs `ptr byval`).  Materialize the
	// incoming value in an alloca and forward a pointer to it.
	//
	// The alloca and store types are BOTH the incoming C form (writeCAbiParamType) —
	// they must match each other and the incoming param declaration.  Sizing the
	// alloca to the coerced `[N x iW]` (N·wordBytes, rounded up), not the aggregate's
	// natural size, is load-bearing: a non-word-multiple struct (e.g. a 12-byte
	// {i32,i32,i32}) would otherwise over-run a natural-sized slot and, at -O2, SROA
	// drops the out-of-bounds tail — a silent miscompile.  The `ptr byval(<T>)` /
	// `ptr` forward reads only SizeOf(T) ≤ the slot.  (Same rule as
	// writeAggParamAllocaDecl.)
	for i := 0; i < len(f.Params); i++ {
		if cExportThunkParamCSse(f, i, cDefArgTypes, cSretOff) &&
				aggMemClass(intDefArgTypes, i + intSretOff) {
			// x86-64 SSE aggregate that is register-class in C (arrives SSE-split)
			// but MEMORY-class internally (a preceding >16-byte aggregate shifted
			// the GP cursor): reconstruct the split eightbytes into the slot, then
			// the forward emits `ptr byval(<T>) %ca<i>.slot` via the aggMemClass
			// branch.  The plain (single-value) spill below can't apply — the param
			// arrives as several `%ca<i>.ag<eb>` values, not one `%ca<i>`.
			sysvWriteThunkSseSpill(out, i, f.Params[i].Typ)
		} else if cExportThunkParamSpills(f, i, cDefArgTypes, cSretOff, intDefArgTypes, intSretOff) {
			out.Write("  %ca")
			stringutils.WriteInt(out, i)
			out.Write(".slot = alloca ")
			writeCAbiParamType(out, f.Params[i].Typ, cDefArgTypes, i + cSretOff)
			out.Write(", align 8\n  store ")
			writeCAbiParamType(out, f.Params[i].Typ, cDefArgTypes, i + cSretOff)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
			out.Write(", ptr %ca")
			stringutils.WriteInt(out, i)
			out.Write(".slot\n")
		}
	}

	if intUseSret || len(f.Results) == 0 {
		out.Write("  call void @")
	} else {
		out.Write("  %r = call ")
		out.Write(retTyp)
		out.Write(" @")
	}
	out.Write(mangled)
	out.WriteByte('(')
	if intUseSret {
		out.Write("ptr sret(")
		out.Write(sretRetType)
		out.Write(") %ca.sret")
		if len(f.Params) > 0 {
			out.Write(", ")
		}
	}
	// Arguments in Binate's internal form.
	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out.Write(", ")
		}
		if f.Params[i].Typ.IsByvalParam() {
			out.Write("ptr %ca") // >16-byte aggregate: internal plain pointer
			stringutils.WriteInt(out, i)
			if cExportThunkParamSpills(f, i, cDefArgTypes, cSretOff, intDefArgTypes, intSretOff) {
				out.Write(".slot") // arm32: forward the materialized copy (x64: the byval ptr)
			}
		} else if aggMemClass(intDefArgTypes, i + intSretOff) {
			// ≤16-byte aggregate the internal convention passes MEMORY-class byval.
			writeByvalMemType(out, f.Params[i].Typ)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
			if cExportThunkParamSpills(f, i, cDefArgTypes, cSretOff, intDefArgTypes, intSretOff) {
				out.Write(".slot") // forward the spilled copy, not the register value
			}
		} else if cExportThunkParamIsSse(f, i, cDefArgTypes, cSretOff, intDefArgTypes, intSretOff) {
			// x86-64 in-register SSE aggregate: forward the SSE-split values
			// straight to the internal define's matching SSE-split params (same
			// per-eightbyte types the C ABI delivered).
			sysvWriteThunkSseParams(out, i, f.Params[i].Typ)
		} else {
			writeParamTypeLLVM(out, f.Params[i].Typ)
			out.Write(" %ca")
			stringutils.WriteInt(out, i)
		}
	}
	out.Write(")\n")
	if retAdapt {
		// The C ABI returns the tuple via the sret buffer, but the internal
		// definition returned it as a first-class aggregate in %r: store it into
		// the caller's buffer at the tuple's field offsets, then return void.
		out.Write("  store ")
		out.Write(retTyp)
		out.Write(" %r, ptr %ca.sret\n  ret void\n")
	} else if coerceFromSret {
		// The body wrote the tuple into the local buffer (its sret pointer): reload
		// clang's eightbyte-coerced form and return it.
		out.Write("  %rc = load ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(", ptr %ca.sret\n  ret ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(" %rc\n")
	} else if cRegCoerce {
		// Both return in registers, but the C ABI packs the tuple's sub-word
		// fields per eightbyte where the internal aggregate %r spreads them.
		// Reinterpret through a shared slot: store the internal form, load clang's
		// coerced form (same bytes; the coerced type is >= the tuple size, so its
		// trailing padding lanes read the slot's uninitialized tail — undefined,
		// exactly as clang leaves them).  align 8 covers both LP64 (i64) and the
		// 8-aligned ILP32 coercion words.
		out.Write("  %ca.rslot = alloca ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(", align 8\n  store ")
		out.Write(retTyp)
		out.Write(" %r, ptr %ca.rslot\n  %rc = load ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(", ptr %ca.rslot\n  ret ")
		writeCMultiReturnCoercedType(out, f.MultiReturnType)
		out.Write(" %rc\n")
	} else if cUseSret || len(f.Results) == 0 {
		out.Write("  ret void\n")
	} else {
		out.Write("  ret ")
		out.Write(retTyp)
		out.Write(" %r\n")
	}
	out.Write("}\n")
}

// cExportThunkParamSpills reports whether parameter i arrives as a VALUE that the
// internal convention forwards as a POINTER, and so must be materialized in an
// alloca.  Two cases: (1) a >16-byte aggregate on arm32 — the C ABI passes it by
// value (coerced `[N x iW]`) but the internal convention wants a `ptr`; (2) a
// ≤16-byte x86-64 aggregate that is register-class in C but MEMORY-class internally
// (a preceding >16-byte aggregate shifted the cursor) — arrives coerced, forwarded
// `ptr byval`.  It does NOT spill when the C ABI already hands over a pointer: an
// x86-64 >16-byte aggregate (`ptr byval`) or a ≤16-byte aggregate that is
// memory-class in C too — those forward the incoming pointer directly.
// The two cursors (cArgTypes/cOff vs intArgTypes/intOff) coincide unless the
// return is being adapted (retAdapt), where only the C side carries the sret slot.
func cExportThunkParamSpills(f @ir.Func, i int, cArgTypes @[]@types.Type, cOff int,
		intArgTypes @[]@types.Type, intOff int) bool {
	var at @types.Type = f.Params[i].Typ
	// The internal convention forwards this param as a pointer: a >16-byte aggregate
	// (plain `ptr`) or an x86-64 ≤16-byte MEMORY-class straddle (`ptr byval`).
	var forwardIndirect bool = at.IsByvalParam() || aggMemClass(intArgTypes, i + intOff)
	// The C ABI already hands it over AS a pointer only for an x86-64 byval: a
	// >16-byte aggregate, or a ≤16-byte straddle that is memory-class in C too.
	var cAbiByvalPtr bool = (targetIsX64() && at.IsByvalParam()) ||
			aggMemClassMaybeC(cArgTypes, i + cOff, true)
	return forwardIndirect && !cAbiByvalPtr
}

// cExportThunkParamCSse reports whether the platform C ABI passes c_export-thunk
// param i as an x86-64 in-register SSE (float-containing) aggregate — SSE-split
// across XMM (and GP for any integer eightbyte).  The thunk DECLARES such a param
// SSE-split (sysvWriteThunkSseParams) so it receives the eightbytes where the C
// caller placed them, never the GP `[N x i64]` coercion.  Excludes a >16-byte
// aggregate (byval pointer) and a ≤16-byte aggregate the C ABI itself passes
// MEMORY-class (a straddle that is memory-class in C too) — those keep the
// pointer / byval C form.
func cExportThunkParamCSse(f @ir.Func, i int, defArgTypes @[]@types.Type, defSretOff int) bool {
	var at @types.Type = f.Params[i].Typ
	return types.SysVInSse(at) && !at.IsByvalParam() &&
			!aggMemClassMaybeC(defArgTypes, i + defSretOff, true)
}

// cExportThunkParamIsSse reports whether c_export-thunk param i is an x86-64 SSE
// aggregate that is register-class in BOTH conventions and so forwards SSE-split
// straight through to the internal define (no reconstruction).  That is
// cExportThunkParamCSse AND register-class internally (!aggMemClass): the SSE and
// GP register files are independent, so a preceding >16-byte MEMORY aggregate —
// which only shifts the GP cursor — leaves a pure-float aggregate in the SSE file
// both ways.  The complementary case (register-class in C but MEMORY-class
// internally — a mixed int+float aggregate whose GP eightbyte no longer fits the
// internal GP file) is declared SSE-split but reconstructed to a `ptr byval` for
// the internal define (sysvWriteThunkSseSpill + the aggMemClass forward branch).
func cExportThunkParamIsSse(f @ir.Func, i int, cArgTypes @[]@types.Type, cOff int,
		intArgTypes @[]@types.Type, intOff int) bool {
	return cExportThunkParamCSse(f, i, cArgTypes, cOff) && !aggMemClass(intArgTypes, i + intOff)
}
