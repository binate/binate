package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the #[c_export] C-ABI entry thunk (emit_cexport_thunk.bn).
// compileToLLVM / contains / fail live in emit_test.bn; setTarget64 in
// emit_util_test.bn.

// On x86-64 a #[c_export] function taking a >16-byte struct BY VALUE must be
// reached from C through an entry thunk, not a plain alias: the C ABI passes such
// a struct in the SysV MEMORY class (`ptr byval`), while Binate's internal
// convention passes a plain pointer, so the mangled definition alone would misread
// a conforming C caller.  The thunk presents the byval C signature and forwards to
// the mangled definition with the pointer in internal form.
func TestEmitCExportBigAggParamThunkX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int { return cast(int, x.a) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "@\"take_big\" = alias") {
		return fail("a >16-byte by-value param must NOT get a plain alias on x64")
	}
	if !contains(out, "@\"take_big\"(ptr byval(") {
		return fail("expected a C-ABI entry thunk with a `ptr byval(...)` param")
	}
	// The thunk forwards to the mangled definition passing the pointer in internal
	// (plain-ptr, no byval) form.
	if !contains(out, "call i64 @bn_") || !contains(out, "ptr %ca0)") {
		return fail("thunk must forward to the mangled def with `ptr %ca0` (internal form)")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// On aarch64 the internal and C conventions coincide (a >16-byte aggregate rides a
// pointer in a register both ways), so the same signature stays a plain alias — no
// thunk, no over-adaptation.
func TestEmitCExportBigAggParamAliasAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int { return cast(int, x.a) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"take_big\" = alias") {
		return fail("aarch64 conventions coincide — a >16-byte by-value param stays an alias")
	}
	if contains(out, "@\"take_big\"(ptr byval(") {
		return fail("aarch64 must NOT emit an adapting thunk")
	}
	return ""
}

// A >16-byte aggregate consumes a GP register internally but none in the C ABI
// (MEMORY class), shifting the register cursor.  A ≤16-byte aggregate that follows
// enough GP-consuming params is then REGISTER-class in C (coerced `[2 x i64]`) but
// MEMORY-class internally (byval).  The thunk must declare it in the C register
// form, SPILL the incoming value to an alloca, and forward `ptr byval` of the slot
// — otherwise it would read the ≤16 struct from the wrong place (a silent mis-ABI).
func TestEmitCExportThunkStraddleSpillX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"type Small struct { x int64\n\ty int64 }\n"
			"#[c_export(\"take_mix\")]\n"
			"func Take(big Big, s0 int64, s1 int64, s2 int64, s3 int64, small Small) int64 {\n"
			"\treturn big.a + small.x }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// `small` is declared as the C register-coerced [2 x i64], NOT byval.
	if !contains(out, "@\"take_mix\"(ptr byval(") {
		return fail("expected the >16-byte `big` param declared byval")
	}
	// The spill: an alloca + store of the coerced value, then the byval forward.
	if !contains(out, ".slot = alloca ") || !contains(out, "store [2 x i64] %ca5") {
		return fail("expected `small` spilled to an alloca (C register -> internal byval)")
	}
	if !contains(out, "byval(%bn_S1_4_main1_5_Small) align 8 %ca5.slot") {
		return fail("expected `small` forwarded as `ptr byval(...) %ca5.slot`")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A 2-word FIRST-CLASS aggregate (raw slice / interface / function value) in the
// spill position is declared as its first-class type (%BnSlice / %BnIfaceValue /
// %BnFuncValue) — aggParamCoerced is false for these, unlike a named struct — so
// the spill store must use that SAME spelling, not the coerced [2 x i64], or LLVM
// rejects the store as a type mismatch.
func TestEmitCExportThunkStraddleSpillSliceX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_slc\")]\n"
			"func Take(big Big, s0 int64, s1 int64, s2 int64, s3 int64, sl *[]int32) int64 {\n"
			"\treturn big.a + cast(int64, len(sl)) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "%BnSlice %ca5") {
		return fail("a 2-word raw-slice straddle param must be declared first-class %BnSlice")
	}
	if !contains(out, "store %BnSlice %ca5, ptr %ca5.slot") {
		return fail("the spill store must use the first-class %BnSlice spelling, not [2 x i64]")
	}
	if !contains(out, "byval(%BnSlice) align 8 %ca5.slot") {
		return fail("the slice must forward as `ptr byval(%BnSlice) ... %ca5.slot`")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A coerced struct whose SizeOf is NOT a word multiple (a 12-byte {i32,i32,i32})
// in the spill position: the store writes the coerced [2 x i64] (16 bytes), so the
// spill alloca must be sized to THAT, not the 12-byte natural struct type — else
// the 16-byte store over-runs the 12-byte slot and -O2 SROA drops the trailing
// eightbyte (a silent miscompile).
func TestEmitCExportThunkStraddleSpillAllocaSizeX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"type Twelve struct { a int32\n\tb int32\n\tc int32 }\n"
			"#[c_export(\"take_tw\")]\n"
			"func Take(big Big, s0 int64, s1 int64, s2 int64, s3 int64, tw Twelve) int64 {\n"
			"\treturn big.a + cast(int64, tw.a) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".slot = alloca [2 x i64]") {
		return fail("spill alloca must be the stored [2 x i64] (16B), not the 12-byte struct")
	}
	if !contains(out, "store [2 x i64] %ca5, ptr %ca5.slot") {
		return fail("expected the coerced [2 x i64] store")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// On arm32 (AAPCS32) a >16-byte by-value #[c_export] param is passed BY VALUE
// coerced to `[N x i32]` (not the x86-64 `ptr byval`), so the thunk must spill it
// to an alloca and forward the internal plain `ptr` of the slot.
func TestEmitCExportThunkArm32BigAggSpill() testing.TestResult {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int64 { return x.a + x.b + x.c }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"take_big\"([3 x i64] %ca0)") {
		return fail("arm32 >16 param must be declared by-value coerced [3 x i64], not byval")
	}
	if !contains(out, ".slot = alloca [3 x i64]") ||
			!contains(out, "store [3 x i64] %ca0, ptr %ca0.slot") {
		return fail("arm32 >16 param must be spilled to a [3 x i64] alloca")
	}
	if !contains(out, "ptr %ca0.slot)") {
		return fail("arm32 >16 param must forward the spilled slot as a plain ptr")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A #[c_export] function that needs a thunk (its >16-byte `big` param forces one)
// and ALSO takes an x86-64 SSE (float) aggregate param.  The C ABI and the
// internal define both pass an in-register SSE aggregate SSE-split in XMM, so the
// thunk must declare it SSE-split (`<2 x float>` for a 1-eightbyte V2, `double,
// double` for a 2-eightbyte D2) and forward it straight through — NOT the GP
// `[N x i64]` coercion, which had the thunk read the arg from a GP register the C
// caller never used AND forward a `[N x i64]` to an internal define expecting the
// SSE form (a silent double-miscompile that still compiled under opaque pointers).
func TestEmitCExportThunkSseAggParamX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"type V2 struct { x float32; y float32 }\n"
			"type D2 struct { p float64; q float64 }\n"
			"#[c_export(\"take_big_v2\")]\n"
			"func takeBigV2(big Big, v V2) float32 { return v.x }\n"
			"#[c_export(\"take_big_d2\")]\n"
			"func takeBigD2(big Big, v D2) float64 { return v.p }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// V2 (1 SSE eightbyte): the thunk exists (big is byval) and the V2 param is
	// SSE-split <2 x float> (appears in both the declaration and the forward).
	if !contains(out, "@\"take_big_v2\"(ptr byval(") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("expected a take_big_v2 thunk with a byval `big` param")
	}
	if !contains(out, "<2 x float> %ca1.ag0)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("V2 SSE aggregate param must be SSE-split <2 x float>, not GP-coerced")
	}
	// It must NOT be the GP [1 x i64] form (the pre-fix miscompile shape).
	if contains(out, "[1 x i64] %ca1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("V2 SSE aggregate must not be spelled [1 x i64] in the thunk")
	}
	// D2 (2 SSE eightbytes): declared + forwarded as `double, double`.
	if !contains(out, "double %ca1.ag0, double %ca1.ag1)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("D2 SSE aggregate param must be SSE-split `double, double`")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// The mixed int+float SSE-straddle case: a #[c_export] thunk param that is an SSE
// aggregate register-class in C but MEMORY-class internally.  A preceding >16-byte
// aggregate consumes an internal GP register (its pointer) while consuming NO C
// register (SysV MEMORY), so with enough int args the internal GP file fills and
// the mixed {i64,f64} aggregate goes memory-class internally, yet it stays
// register-class in C.  The thunk must DECLARE it SSE-split (received where the C
// caller placed the eightbytes: i64 in a GP reg, f64 in XMM), RECONSTRUCT it into a
// slot, and FORWARD `ptr byval` to the memory-class internal define — not the GP
// `[2 x i64]` form, which read a GP register the C caller never used (a silent
// miscompile: `return mf.f` yielded garbage, yet the module compiled).
func TestEmitCExportThunkMixedSseStraddleX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"type MF struct { i int64; f float64 }\n"
			"#[c_export(\"t_str\")]\n"
			"func TStr(big Big, a int64, b int64, c int64, d int64, e int64, mf MF) float64 { "
			"return mf.f }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// mf (param index 6) declared SSE-split (i64 + double), NOT the GP [2 x i64].
	if !contains(out, "i64 %ca6.ag0, double %ca6.ag1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must be declared SSE-split (i64 + double)")
	}
	if contains(out, "[2 x i64] %ca6") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must not use the GP [2 x i64] form")
	}
	// Reconstructed into the slot: the f64 eightbyte stored at offset 8.
	if !contains(out, "store double %ca6.ag1, ptr %ca6.slot.e1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must be reconstructed into %ca6.slot")
	}
	// Forwarded as `ptr byval(...) %ca6.slot` to the memory-class internal define.
	if !contains(out, "byval(") || !contains(out, "%ca6.slot)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must forward ptr byval of the slot")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A #[c_export] function that ALREADY thunks (a >16-byte by-value struct param on
// x86-64) and also has narrow scalar params must declare those scalars with the
// platform C extension attribute (`i8 signext` / `i8 zeroext`) IN THE THUNK — clang
// param-declaration parity for the same C prototype — while forwarding them BARE to
// the bare internal define (Binate's param ABI passes narrow args bare; the callee
// re-extends).  (The plain-alias c_export shape can't carry these attrs — an alias
// has no param attributes, and adding signext to the shared internal define would
// break separate-compilation Binate callers — so this parity is thunk-only.)
func TestEmitCExportThunkNarrowParamExtX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_mixed\")]\n"
			"func Take(x Big, v int8, w uint8) int {\n"
			"\treturn cast(int, x.a) + cast(int, v) + cast(int, w)\n"
			"}\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// The thunk's narrow params carry the C extension attributes.
	if !contains(out, "i8 signext %ca1") {
		return fail("thunk must declare the int8 param as `i8 signext %ca1`")
	}
	if !contains(out, "i8 zeroext %ca2") {
		return fail("thunk must declare the uint8 param as `i8 zeroext %ca2`")
	}
	// It forwards them BARE (no signext/zeroext) to the bare internal define.
	if !contains(out, "i8 %ca1, i8 %ca2)") {
		return fail("thunk must forward the narrow params BARE to the internal define")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}
