package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the #[c_export] C-ABI entry thunk (emit_cexport_thunk.bn).
// compileToLLVM / contains / fail live in emit_test.bn; setTarget64 in
// emit_util_test.bn.

// On x86-64 a #[c_export] function taking a >16-byte struct BY VALUE stays a plain
// alias: the C ABI and Binate's internal convention both pass it in the SysV MEMORY
// class (`ptr byval`), so the mangled definition is already a correct C entry.
func TestEmitCExportBigAggParamAliasX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int { return cast(int, x.a) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "@\"take_big\" = alias") {
		return fail("a >16-byte by-value param stays a plain alias on x64 (MEMORY class both ways)")
	}
	if !contains(out, "_Take(ptr byval(") {
		return fail("the definition takes the >16-byte param `ptr byval(...)` on x64")
	}
	return ""
}

// When a #[c_export] function on x86-64 needs a thunk for its RETURN (a three-int64
// tuple the C ABI returns through sret but the internal convention in registers), its
// >16-byte by-value param is declared AND forwarded `ptr byval(<T>)` — the same SysV
// MEMORY form both ways.  A plain `ptr` forward would hand the definition the pointer
// in a register while it reads the struct from the stack.
func TestEmitCExportThunkBigAggForwardByvalX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big3\")]\n"
			"func Take(x Big) (int64, int64, int64) { return x.a, x.b, x.c }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "@\"take_big3\"(ptr sret(") {
		return fail("expected a C-ABI entry thunk with an sret return")
	}
	if !contains(out, "@bn_F1_4_main1_4_Take(ptr byval(") {
		return fail("the thunk must forward the >16-byte param `ptr byval(...)`")
	}
	if contains(out, "_Take(ptr %ca0") {
		return fail("the thunk must not forward the >16-byte param as a plain `ptr`")
	}
	return ""
}

// On aarch64 the internal and C conventions coincide (a >16-byte aggregate rides a
// pointer in a register both ways), so the same signature stays a plain alias — no
// thunk, no over-adaptation.
func TestEmitCExportBigAggParamAliasAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int { return cast(int, x.a) }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"take_big\" = alias") {
		return fail("aarch64 conventions coincide — a >16-byte by-value param stays an alias")
	}
	if contains(out, "@\"take_big\"(ptr byval(") {
		return fail("aarch64 must NOT emit an adapting thunk")
	}
	return ""
}

// On x86-64 an adapted return's sret pointer takes a C GP register the internal side
// does not, so the two register cursors differ.  A 2-eightbyte aggregate that lands
// C-memory yet internal-register fills the internal GP file while one C register is
// left, so a following 1-eightbyte aggregate is REGISTER-class in C (coerced
// `[1 x i64]`) but MEMORY-class internally (byval).  The thunk must declare it in the
// C register form, SPILL the incoming value to an alloca, and forward `ptr byval` of
// the slot — otherwise it would read the struct from the wrong place (a silent
// mis-ABI).  H is a 4-byte {i32}, NOT a word multiple: the store writes the coerced
// `[1 x i64]` (8 bytes), so the spill alloca must be sized to THAT, not the 4-byte
// struct — else the store over-runs the slot and -O2 SROA drops the tail.
func TestEmitCExportThunkStraddleSpillX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type GG struct { a int64\n\tb int64 }\n"
			"type H struct { a int32 }\n"
			"#[c_export(\"take_mix\")]\n"
			"func Take(a int64, b int64, c int64, d int64, gg GG, h H) (int64, int64, int64) {\n"
			"\treturn cast(int64, h.a), gg.a, d }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	// `h` is declared as the C register-coerced [1 x i64], NOT byval.
	if !contains(out, "[1 x i64] %ca5)") {
		return fail("expected `h` declared as the C register form `[1 x i64] %ca5`")
	}
	// The spill: a [1 x i64]-sized alloca + store of the coerced value.
	if !contains(out, "%ca5.slot = alloca [1 x i64]") ||
			!contains(out, "store [1 x i64] %ca5, ptr %ca5.slot") {
		return fail("expected `h` spilled to a [1 x i64] alloca (C register -> internal byval)")
	}
	if !contains(out, "byval(%bn_S1_4_main1_1_H) align 8 %ca5.slot") {
		return fail("expected `h` forwarded as `ptr byval(...) %ca5.slot`")
	}
	return ""
}

// On arm32 (AAPCS32) a >16-byte by-value #[c_export] param is passed BY VALUE
// coerced to `[N x i32]` (not the x86-64 `ptr byval`), so the thunk must spill it
// to an alloca and forward the internal plain `ptr` of the slot.
func TestEmitCExportThunkArm32BigAggSpill() testing.TestResult {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64\n\tb int64\n\tc int64 }\n"
			"#[c_export(\"take_big\")]\n"
			"func Take(x Big) int64 { return x.a + x.b + x.c }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@\"take_big\"([3 x i64] %ca0)") {
		return fail("arm32 >16 param must be declared by-value coerced [3 x i64], not byval")
	}
	if !contains(out, ".slot = alloca [3 x i64]") ||
			!contains(out, "store [3 x i64] %ca0, ptr %ca0.slot") {
		return fail("arm32 >16 param must be spilled to a [3 x i64] alloca")
	}
	if !contains(out, "ptr %ca0.slot)") {
		return fail("arm32 >16 param must forward the spilled slot as a plain ptr")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A #[c_export] function that needs a thunk (its three-int64 return, which the C ABI
// returns through sret) and takes an x86-64 SSE (float) aggregate param after a
// >16-byte `big` one.  The C ABI and the internal define both pass an in-register SSE
// aggregate SSE-split in XMM, so the thunk must declare it SSE-split (`<2 x float>`
// for a 1-eightbyte V2, `double, double` for a 2-eightbyte D2) and forward it
// straight through — NOT the GP `[N x i64]` coercion, which had the thunk read the
// arg from a GP register the C caller never used AND forward a `[N x i64]` to an
// internal define expecting the SSE form (a silent double-miscompile that still
// compiled under opaque pointers).
func TestEmitCExportThunkSseAggParamX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int64; b int64; c int64 }\n"
			"type V2 struct { x float32; y float32 }\n"
			"type D2 struct { p float64; q float64 }\n"
			"#[c_export(\"take_big_v2\")]\n"
			"func takeBigV2(big Big, v V2) (int64, int64, int64) { "
			"return cast(int64, v.x), big.a, 0 }\n"
			"#[c_export(\"take_big_d2\")]\n"
			"func takeBigD2(big Big, v D2) (int64, int64, int64) { "
			"return cast(int64, v.p), big.a, 0 }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// V2 (1 SSE eightbyte): the thunk exists (the adapted return) and the V2 param is
	// SSE-split <2 x float> (appears in both the declaration and the forward).
	if !contains(out, "@\"take_big_v2\"(ptr sret(") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("expected a take_big_v2 thunk with an sret return")
	}
	if !contains(out, "<2 x float> %ca1.ag0)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("V2 SSE aggregate param must be SSE-split <2 x float>, not GP-coerced")
	}
	// It must NOT be the GP [1 x i64] form (the pre-fix miscompile shape).
	if contains(out, "[1 x i64] %ca1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("V2 SSE aggregate must not be spelled [1 x i64] in the thunk")
	}
	// D2 (2 SSE eightbytes): declared + forwarded as `double, double`.
	if !contains(out, "double %ca1.ag0, double %ca1.ag1)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("D2 SSE aggregate param must be SSE-split `double, double`")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// The mixed int+float SSE-straddle case: a #[c_export] thunk param that is an SSE
// aggregate register-class in C but MEMORY-class internally.  An adapted return's
// sret pointer takes a C GP register the internal side does not; a 2-eightbyte GP
// aggregate that lands C-memory yet internal-register then fills the internal GP
// file while one C register is left, so the mixed {i64,f64} aggregate goes
// memory-class internally yet stays register-class in C.  The thunk must DECLARE it
// SSE-split (received where the C caller placed the eightbytes: i64 in a GP reg, f64
// in XMM), RECONSTRUCT it into a slot, and FORWARD `ptr byval` to the memory-class
// internal define — not the GP `[2 x i64]` form, which read a GP register the C
// caller never used (a silent miscompile: `return mf.f` yielded garbage, yet the
// module compiled).
func TestEmitCExportThunkMixedSseStraddleX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type GG struct { a int64; b int64 }\n"
			"type MF struct { i int64; f float64 }\n"
			"#[c_export(\"t_str\")]\n"
			"func TStr(a int64, b int64, c int64, d int64, gg GG, mf MF) (int64, int64, int64) { "
			"return mf.i, gg.a, d }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// mf (param index 5) declared SSE-split (i64 + double), NOT the GP [2 x i64].
	if !contains(out, "i64 %ca5.ag0, double %ca5.ag1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must be declared SSE-split (i64 + double)")
	}
	if contains(out, "[2 x i64] %ca5") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must not use the GP [2 x i64] form")
	}
	// Reconstructed into the slot: the f64 eightbyte stored at offset 8.
	if !contains(out, "store double %ca5.ag1, ptr %ca5.slot.e1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must be reconstructed into %ca5.slot")
	}
	// Forwarded as `ptr byval(...) %ca5.slot` to the memory-class internal define.
	if !contains(out, "byval(") || !contains(out, "%ca5.slot)") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("mixed SSE straddle param must forward ptr byval of the slot")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// A #[c_export] function that ALREADY thunks (its three-int64 return, which the C ABI
// returns through sret) and has narrow scalar params must declare those scalars with
// the platform C extension attribute (`i8 signext` / `i8 zeroext`) IN THE THUNK —
// clang param-declaration parity for the same C prototype — while forwarding them
// BARE to the bare internal define (Binate's param ABI passes narrow args bare; the
// callee re-extends).  (The plain-alias c_export shape can't carry these attrs — an
// alias has no param attributes, and adding signext to the shared internal define
// would break separate-compilation Binate callers — so this parity is thunk-only.)
func TestEmitCExportThunkNarrowParamExtX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"#[c_export(\"take_mixed\")]\n"
			"func Take(v int8, w uint8) (int64, int64, int64) {\n"
			"\treturn cast(int64, v), cast(int64, w), 0\n"
			"}\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// The thunk's narrow params carry the C extension attributes.
	if !contains(out, "i8 signext %ca0") {
		return fail("thunk must declare the int8 param as `i8 signext %ca0`")
	}
	if !contains(out, "i8 zeroext %ca1") {
		return fail("thunk must declare the uint8 param as `i8 zeroext %ca1`")
	}
	// It forwards them BARE (no signext/zeroext) to the bare internal define.
	if !contains(out, "i8 %ca0, i8 %ca1)") {
		return fail("thunk must forward the narrow params BARE to the internal define")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// The reverse SSE-straddle: a #[c_export] thunk param that is an SSE aggregate
// MEMORY-class in C but SSE-SPLIT (register-class) internally.  An adapted return's
// sret pointer takes a C GP register the internal side does not; a 2-eightbyte GP
// aggregate that lands C-memory yet internal-register then fills the internal GP
// file while one C register is left, so a following {i64,f64} aggregate goes wholly
// to memory internally while it stays register-class in C, where it spends an XMM the
// internal side never does.  That one-XMM head-start exhausts the C XMM file a slot
// sooner, so a later two-double aggregate lands in C MEMORY (arrives `ptr byval`) yet
// stays SSE-split internally.  The thunk must LOAD the two eightbytes from the byval
// pointer and FORWARD them SSE-split (`double, double`) — not the GP `[2 x i64]`
// form, which passes a raw pointer where the internal define expects two doubles (a
// clang type-mismatch that fails the whole module compile).
func TestEmitCExportThunkCMemInternalSseX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type GG struct { a int64; b int64 }\n"
			"type MF struct { i int64; f float64 }\n"
			"type V2d struct { x float64; y float64 }\n"
			"#[c_export(\"t_cmem\")]\n"
			"func TCMem(a int64, b int64, c int64, d int64, gg GG, mf MF, "
			"g float64, h float64, i float64, j float64, k float64, l float64, "
			"ff V2d, m float64) (int64, int64, int64) { return cast(int64, ff.x), b, c }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// ff (param index 12) arrives as a byval pointer (C MEMORY class): the thunk
	// LOADS eightbyte 0 straight from %ca12 — only possible if %ca12 is a pointer.
	if !contains(out, "%ca12.ld0 = load double, ptr %ca12") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory SSE aggregate must arrive byval and load eightbyte 0 from %ca12")
	}
	// Eightbyte 1 is loaded from the +8 sub-pointer.
	if !contains(out, "%ca12.ld1 = load double, ptr %ca12.e1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("thunk must load eightbyte 1 of the C-memory aggregate from %ca12.e1")
	}
	// Forwarded SSE-split (`double %ca12.ld0, double %ca12.ld1`) to the internal define.
	if !contains(out, "double %ca12.ld0, double %ca12.ld1") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory SSE aggregate must forward SSE-split `double, double`")
	}
	// It must NOT use the GP [2 x i64] form (the pre-fix miscompile shape).
	if contains(out, "[2 x i64] %ca12") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory SSE aggregate must not forward the GP [2 x i64] form")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}

// The GP analogue of the C-memory / internal-register straddle: a #[c_export] thunk
// param that is a 1-eightbyte GP aggregate MEMORY-class in C but REGISTER-class
// internally.  An adapted return's sret pointer takes a C GP register the internal
// side does not, so after five int64 params the C GP file is full while the internal
// one has a register left.  The thunk must LOAD the value from the byval pointer —
// through a coerced-sized alloca so a non-word-multiple struct never over-reads — and
// FORWARD it by value (`[1 x i64] %ca<i>.ld`), not the bare `[1 x i64] %ca<i>` (a
// `ptr` where the internal define wants `[1 x i64]`: a clang type-mismatch that fails
// the whole module compile).  H is deliberately a 4-byte {i32} (NON-word-multiple):
// the coerced `[1 x i64]` alloca is wider than the natural struct, so the
// natural-then-coerce round-trip is load-bearing — a naive `load [1 x i64], ptr %ca5`
// would over-read the 4-byte byval region.
func TestEmitCExportThunkCMemInternalGpX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type H struct { a int32 }\n"
			"#[c_export(\"t_gp\")]\n"
			"func TGP(a int64, b int64, c int64, d int64, e int64, h H) (int64, int64, int64) { "
			"return cast(int64, h.a), b, c }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	// h (param index 5) arrives as a byval pointer (C MEMORY class): the thunk loads
	// the NATURAL struct straight from %ca5 — only possible if %ca5 is a pointer.
	if !contains(out, "%ca5.nv = load ") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory GP aggregate must arrive byval and load its natural value from %ca5")
	}
	// It is re-coerced through a [1 x i64]-sized alloca (over-read protection) and
	// loaded back as the internal define's coerced [1 x i64] form.
	if !contains(out, "%ca5.agp = alloca [1 x i64]") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory GP aggregate must re-coerce through a [1 x i64]-sized alloca")
	}
	if !contains(out, "%ca5.ld = load [1 x i64], ptr %ca5.agp") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("thunk must load the coerced [1 x i64] back from the alloca")
	}
	// Forwarded by value (`[1 x i64] %ca5.ld`) to the internal define's register param.
	if !contains(out, "[1 x i64] %ca5.ld") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory GP aggregate must forward the coerced value `[1 x i64] %ca5.ld`")
	}
	// It must NOT forward the bare byval pointer as `[1 x i64] %ca5,` (the pre-fix
	// miscompile: a `ptr` where the internal define declares `[1 x i64]`).
	if contains(out, "[1 x i64] %ca5,") {
		setTarget64()
		types.SetArch(types.ARCH_AA64)
		return fail("C-memory GP aggregate must not forward the bare byval ptr as [1 x i64]")
	}
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	return ""
}
