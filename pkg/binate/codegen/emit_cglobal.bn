package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// __c_global lowering (address of an external C data symbol)
// ============================================================
//
// OP_C_GLOBAL yields the ADDRESS of an external C global variable named
// verbatim on instr.StrVal (no mangling — like OP_C_CALL).  Two pieces:
// a module-preamble `@<sym> = external global <T>` declaration per distinct
// symbol (emitCGlobalDeclares), and a per-instruction materialization that
// binds the symbol's address to the SSA result (emitCGlobal).  On the LLVM
// backend, clang synthesizes the platform-correct addressing (GOT-indirect
// or copy-relocation) for the external reference — so this backend is the
// portable path.

// emitCGlobalDeclares emits `@<sym> = external global <T>` once for every
// distinct C symbol referenced by an OP_C_GLOBAL in the module.  Called from
// emitModule's preamble alongside emitCCallDeclares and the imported-extern-var
// declarations (which use the same `external global` form for Binate externs).
// The pointee type T rides ins.TypeArg; the symbol is verbatim (unmangled).
func emitCGlobalDeclares(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_C_GLOBAL { continue }
				// cCallSymbolSeen is a plain symbol-name dedup helper
				// (emit_ccall.bn); reused here for OP_C_GLOBAL symbols.
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = slices.Append[@[]char](seen, ins.StrVal)
				out.Write("@")
				out.Write(ins.StrVal)
				out.Write(" = external global ")
				out.Write(llvmType(ins.TypeArg))
				out.WriteByte('\n')
			}
		}
	}
	return
}

// emitCGlobal materializes the address of the external global into the SSA
// result: `%vID = bitcast <T>* @<sym> to i8*`.  The declared
// `@<sym> = external global <T>` gives @<sym> LLVM type `<T>*`, so the pointee
// type (TypeArg) is spelled EXPLICITLY — llvmType collapses a raw pointer to
// `i8*`, which would mismatch @<sym>'s real pointer type (the same reason the
// global-ref bitcast in emit_instr.bn spells TypeArg).  The result is the raw
// `*T` (an i8* in the module's collapsed pointer representation).
func emitCGlobal(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = bitcast ")
	out.Write(llvmType(instr.TypeArg))
	out.Write("* @")
	out.Write(instr.StrVal)
	out.Write(" to i8*\n")
	return
}

// emitDataSymAddr materializes the address of a Binate data global
// (OP_DATA_SYM_ADDR) into the SSA result.  The per-instruction form is identical
// to emitCGlobal — `bitcast <T>* @<sym> to i8*`, spelling the pointee type from
// TypeArg.  The symbol is a mangled weak Binate name (e.g. `__typeinfo.<T>`);
// when the module DEFINES it (a same-package impl's record) no declaration is
// needed, and when it only REFERENCES it cross-TU (a type assertion whose T
// lives in another package) emitDataSymAddrDeclares emits the `external global`.
func emitDataSymAddr(out *strings.Builder, instr @ir.Instr) {
	emitCGlobal(out, instr)
	return
}

// emitDataSymAddrDeclares emits `@<sym> = external global i8` for each distinct
// OP_DATA_SYM_ADDR symbol this module REFERENCES but does NOT define — a
// cross-TU weak data symbol (e.g. `&__typeinfo.<T>` for a type whose impl lives
// in another package, materialized by a type assertion).  Without the
// declaration clang rejects `ptr @<sym>` with "use of undefined value"; the weak
// definition in the owning module resolves it at link.  (The native backends
// declare the same reference via SetGlobal at lower time.)  Symbols the module
// DOES define — its own `__typeinfo` / `__ifaceid` records and its `_pkg_satfrag`
// node — are skipped so the declaration never conflicts with the definition.
func emitDataSymAddrDeclares(out *strings.Builder, m @ir.Module) {
	var defined @[]@[]char = collectDefinedDataSyms(m)
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_DATA_SYM_ADDR { continue }
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = slices.Append[@[]char](seen, ins.StrVal)
				// Skip a symbol this module defines (its own __typeinfo / `_pkg_satfrag`).
				if cCallSymbolSeen(defined, ins.StrVal) { continue }
				out.Write("@")
				out.Write(ins.StrVal)
				out.Write(" = external global i8\n")
			}
		}
	}
	return
}

// collectDefinedDataSyms returns the OP_DATA_SYM_ADDR-referenced symbols this
// module DEFINES: its per-type `__typeinfo` records (CollectTypeInfoDescs — one
// per local impl's receiver), its per-interface `__ifaceid` markers
// (CollectIfaceIdSyms — an interface-target assertion `x.(*J)` materializes
// `&__ifaceid.<J>`, and J is defined here when it is a local interface), and —
// when the satisfaction registry is wired (SatRegistryRequested) — its own
// `_pkg_satfrag` graph node (referenced by the `__entry` registry-wiring LEA).
// emitDataSymAddrDeclares skips these so an in-module symbol is never re-declared
// `external` (which would conflict with its weak_odr definition).
func collectDefinedDataSyms(m @ir.Module) @[]@[]char {
	var out @[]@[]char
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(m)
	for i := 0; i < len(descs); i++ {
		out = slices.Append[@[]char](out, descs[i].Sym)
	}
	var ifaceIds @[]@[]char = ir.CollectIfaceIdSyms(m)
	for i := 0; i < len(ifaceIds); i++ {
		out = slices.Append[@[]char](out, ifaceIds[i])
	}
	if m.SatRegistryRequested {
		out = slices.Append[@[]char](out, mangle.GlobalName(modulePkgName, "_pkg_satfrag"))
	}
	return out
}
