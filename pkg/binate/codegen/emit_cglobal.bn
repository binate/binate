package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// __c_global lowering (address of an external C data symbol)
// ============================================================
//
// OP_C_GLOBAL yields the ADDRESS of an external C global variable named
// verbatim on instr.StrVal (no mangling — like OP_C_CALL).  Two pieces:
// a module-preamble `@<sym> = external global <T>` declaration per distinct
// symbol (emitCGlobalDeclares), and a per-instruction materialization that
// binds the symbol's address to the SSA result (emitCGlobal).  On the LLVM
// backend, clang synthesizes the platform-correct addressing (GOT-indirect
// or copy-relocation) for the external reference — so this backend is the
// portable path; see explorations/plan-c-global.md.

// emitCGlobalDeclares emits `@<sym> = external global <T>` once for every
// distinct C symbol referenced by an OP_C_GLOBAL in the module.  Called from
// emitModule's preamble alongside emitCCallDeclares and the imported-extern-var
// declarations (which use the same `external global` form for Binate externs).
// The pointee type T rides ins.TypeArg; the symbol is verbatim (unmangled).
func emitCGlobalDeclares(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != iropcode.OP_C_GLOBAL { continue }
				// cCallSymbolSeen is a plain symbol-name dedup helper
				// (emit_ccall.bn); reused here for OP_C_GLOBAL symbols.
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = slices.Append[@[]char](seen, ins.StrVal)
				out.Write("@")
				out.Write(ins.StrVal)
				out.Write(" = external global ")
				out.Write(llvmType(ins.TypeArg))
				out.WriteByte('\n')
			}
		}
	}
	return
}

// emitCGlobal materializes the address of the external global into the SSA
// result: `%vID = bitcast <T>* @<sym> to i8*`.  The declared
// `@<sym> = external global <T>` gives @<sym> LLVM type `<T>*`, so the pointee
// type (TypeArg) is spelled EXPLICITLY — llvmType collapses a raw pointer to
// `i8*`, which would mismatch @<sym>'s real pointer type (the same reason the
// global-ref bitcast in emit_instr.bn spells TypeArg).  The result is the raw
// `*T` (an i8* in the module's collapsed pointer representation).
func emitCGlobal(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = bitcast ")
	out.Write(llvmType(instr.TypeArg))
	out.Write("* @")
	out.Write(instr.StrVal)
	out.Write(" to i8*\n")
	return
}
