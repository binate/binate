package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_cglobal.bn — the OP_C_GLOBAL LLVM lowering used by the
// __c_global intrinsic.  Covers: the `external global` declaration and the
// address-materialization bitcast both use the VERBATIM (un-mangled) symbol,
// and each distinct symbol is declared exactly once.

// buildCGlobalModule builds a module whose `caller` returns
// __c_global(sym, *uint8) — a raw pointer result (**uint8).  The pointee is a
// pointer so the emitted types exercise the pointer-collapse path.
func buildCGlobalModule(sym @[]char) @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var pointee @types.Type = types.MakePointerType(types.TypUint8())
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(pointee)
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = entry.EmitCGlobal(sym, pointee)
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = g
	entry.EmitReturn(retArgs)
	m.AddFunc(f)
	return m
}

// The declaration + the address bitcast must use the raw symbol verbatim —
// no `bn_<kind>...` mangling (the property that distinguishes __c_global from
// an ordinary module-owned global reference).
func TestEmitCGlobalRawSymbol() testing.TestResult {
	var out @[]char = EmitModule(buildCGlobalModule("environ"))
	if !contains(out, "@environ = external global i8*") {
		return fail("expected `@environ = external global i8*` declaration")
	}
	if !contains(out, "bitcast i8** @environ to i8*") {
		return fail("expected the address materialization "
				"`bitcast i8** @environ to i8*`")
	}
	// Any leak of a mangled name would mean the lowering fell back to the
	// module-owned-global path (which mangles) instead of the verbatim path.
	if contains(out, "bn_") && contains(out, "environ") &&
			!contains(out, "@environ = external global") {
		return fail("`environ` must not be name-mangled by __c_global lowering")
	}
	return ""
}

// Each distinct C data symbol gets exactly one `external global` declaration,
// even when referenced by multiple OP_C_GLOBAL instrs.
func TestEmitCGlobalDeclaresAreDeduped() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var pointee @types.Type = types.MakePointerType(types.TypUint8())
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	entry.EmitCGlobal("environ", pointee)
	entry.EmitCGlobal("environ", pointee)
	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if countOccurrences(out, "@environ = external global") != 1 {
		return fail("expected exactly one `external global` for `environ` (dedup)")
	}
	return ""
}
