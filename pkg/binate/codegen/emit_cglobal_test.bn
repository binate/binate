package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_cglobal.bn — the OP_C_GLOBAL LLVM lowering used by the
// __c_global intrinsic.  Covers: the `external global` declaration and the
// address-materialization bitcast both use the VERBATIM (un-mangled) symbol,
// and each distinct symbol is declared exactly once.

// buildCGlobalModule builds a module whose `caller` returns
// __c_global(sym, *uint8) — a raw pointer result (**uint8).  The pointee is a
// pointer so the emitted types exercise the pointer-collapse path.
func buildCGlobalModule(sym @[]char) @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var pointee @types.Type = types.MakePointerType(types.TypUint8())
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(pointee)
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = entry.EmitCGlobal(sym, pointee)
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = g
	entry.EmitReturn(retArgs)
	m.AddFunc(f)
	return m
}

// The declaration + the address bitcast must use the raw symbol verbatim —
// no `bn_<kind>...` mangling (the property that distinguishes __c_global from
// an ordinary module-owned global reference).
func TestEmitCGlobalRawSymbol() testing.TestResult {
	var out @[]char = EmitModule(buildCGlobalModule("environ"))
	if !contains(out, "@environ = external global i8*") {
		return fail("expected `@environ = external global i8*` declaration")
	}
	if !contains(out, "bitcast i8** @environ to i8*") {
		return fail("expected the address materialization "
				"`bitcast i8** @environ to i8*`")
	}
	// Any leak of a mangled name would mean the lowering fell back to the
	// module-owned-global path (which mangles) instead of the verbatim path.
	if contains(out, "bn_") && contains(out, "environ") &&
			!contains(out, "@environ = external global") {
		return fail("`environ` must not be name-mangled by __c_global lowering")
	}
	return ""
}

// Each distinct C data symbol gets exactly one `external global` declaration,
// even when referenced by multiple OP_C_GLOBAL instrs.
func TestEmitCGlobalDeclaresAreDeduped() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var pointee @types.Type = types.MakePointerType(types.TypUint8())
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	entry.EmitCGlobal("environ", pointee)
	entry.EmitCGlobal("environ", pointee)
	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if countOccurrences(out, "@environ = external global") != 1 {
		return fail("expected exactly one `external global` for `environ` (dedup)")
	}
	return ""
}

// OP_DATA_SYM_ADDR materializes a Binate data global's address via the same
// `bitcast <T>* @<sym> to i8*` as OP_C_GLOBAL (pointee spelled from TypeArg).
// When the symbol is NOT defined in this module (a cross-TU reference — here the
// module has no impl for T, so no `__typeinfo.<T>` record), emitDataSymAddrDeclares
// must ALSO emit an `external global` declaration, or clang rejects the bitcast
// with "use of undefined value".  (The in-module-DEFINED case is the sibling
// test below.)
func TestEmitDataSymAddrBitcast() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var pointee @types.Type = types.MakePointerType(types.TypUint8())
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(pointee)
	var f @ir.Func = ir.NewFunc("", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = entry.EmitDataSymAddr("__typeinfo.bn_S1_4_main1_T", pointee)
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = g
	entry.EmitReturn(retArgs)
	m.AddFunc(f)
	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8** @__typeinfo.bn_S1_4_main1_T to i8*") {
		return fail("expected the address bitcast of the __typeinfo symbol")
	}
	// This module has no impl for T, so it does NOT define __typeinfo.<T> — the
	// symbol is a cross-TU reference and MUST be declared `external global`
	// (emitDataSymAddrDeclares), or clang rejects the bitcast with "use of
	// undefined value".  (A module that DOES define the record — a same-package
	// impl — skips the declaration; covered end-to-end by conformance 994 vs 997.)
	if !contains(out, "@__typeinfo.bn_S1_4_main1_T = external global") {
		return fail("a cross-TU OP_DATA_SYM_ADDR symbol should be declared external global")
	}
	return ""
}

// The conflict-avoidance gate: a module that DEFINES a `__typeinfo.<T>` record (a
// LOCAL impl) must NOT ALSO declare that symbol `external global` — that would be
// an LLVM redefinition.  emitDataSymAddrDeclares skips symbols in
// collectDefinedDataSyms (the module's own CollectTypeInfoDescs records).  Here
// the assertion's `&__typeinfo.<T>` is same-module, so the record appears as a
// weak_odr DEFINITION and NOT as an external declaration.
func TestEmitDataSymAddrDefinedNotExtern() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func f(iv *I) *T { return iv.(*T) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@__typeinfo.bn_S1_4_main1_1_T = weak_odr") {
		return fail("expected __typeinfo.<T> to be a weak_odr DEFINITION (local impl)")
	}
	if contains(out, "@__typeinfo.bn_S1_4_main1_1_T = external global") {
		return fail("a DEFINED __typeinfo must NOT also be declared external (LLVM conflict)")
	}
	return ""
}
