package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"

// emitConstNil emits a nil constant (zero-filled value for
// aggregate types, null for raw pointers).
//
// For aggregate types we emit the alloca + zero-fill + load idiom:
//
//   %vID.a = alloca <T>                      ; hoisted to entry block
//   <fieldwise zero of *T at %vID.a>         ; here, at the instr site
//   %vID  = load <T>, <T>* %vID.a            ; here, at the instr site
//
// The `.a` alloca is hoisted to the function entry block by
// emitConstNilAllocDecl (the alloca pre-pass), so a nil aggregate built
// inside a loop body doesn't leak native stack per iteration; only the
// zero-fill + load stay at the instruction's original location.
//
// The zero-fill uses emitFieldwiseZero (per-scalar store of zero)
// instead of `store <T> zeroinitializer, <T>* %vID.a`.  An
// aggregate store of zeroinitializer is the kind of operation LLVM
// may lower to `memset` / `__aeabi_memclr` for types past a target-
// specific size threshold, which would pull in a libc dependency we
// don't carry on bare-metal.  See
// explorations/plan-codegen-c-free-copies.md.
func emitConstNil(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var name @[]char = constNilLLVMTypeName(instr)
	if len(name) > 0 {
		return emitNilAggregate(out, instr, name)
	}
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = inttoptr ")
	out = out.WriteStr(intLL())
	out = out.WriteStr(" 0 to i8*\n")
	return out
}

// constNilLLVMTypeName returns the LLVM aggregate type name whose `.a`
// slot an aggregate OP_CONST_NIL alloca's + zero-fills (e.g. "%BnSlice",
// "%BnManagedSlice", "%BnIfaceValue", or a named-struct ref like
// "%bn_pkg__X__T"), or an empty slice for a non-aggregate nil — a raw
// pointer, which lowers to `inttoptr` with no alloca.  emitConstNil (the
// in-place zero-fill + load) and emitConstNilAllocDecl (the alloca-hoist
// pre-pass) both dispatch on this so the hoisted alloca and the in-place
// lowering agree on the slot type.
func constNilLLVMTypeName(instr @ir.Instr) @[]char {
	var empty @[]char
	if instr.Typ == nil { return empty }
	// Peel an outer readonly / alias wrapper: a `readonly @[]char` const-nil
	// is still an aggregate and must alloca + zero-fill its image, not fall
	// through to the scalar `inttoptr 0` path — that emits a bare `ptr`
	// where the consumer loads a `%BnManagedSlice`, an LLVM type mismatch
	// (clang rejects it).  Named-distinct types keep their own LLVM name, so
	// the TYP_NAMED branch below still dispatches on the peeled `t`.
	var t @types.Type = instr.Typ
	for t != nil {
		var r @types.Type = t.ResolveAlias()
		if r != nil && r.Kind == types.TYP_READONLY && r.Elem != nil {
			t = r.Elem
		} else {
			t = r
			break
		}
	}
	if t == nil { return empty }
	if t.Kind == types.TYP_SLICE { return "%BnSlice" }
	if t.Kind == types.TYP_MANAGED_SLICE {
		return "%BnManagedSlice"
	}
	if t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		// The LLVM type is the uniform %BnFuncValue regardless of
		// the function signature.
		return "%BnFuncValue"
	}
	if t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		// The LLVM type is the uniform %BnIfaceValue regardless of
		// the interface's method set. Without this nil-init, `var
		// iv *I` (no explicit init) leaves the alloca undef and the
		// optimizer is free to misbehave on the subsequent dispatch
		// — defining the no-init form to be all-zeros makes nil-
		// iface dispatch a deterministic SEGV rather than UB.
		return "%BnIfaceValue"
	}
	if t.Kind == types.TYP_STRUCT ||
		t.Kind == types.TYP_ARRAY ||
		(t.Kind == types.TYP_NAMED && t.Underlying != nil) {
		return llvmType(t)
	}
	return empty
}

// emitConstNilAllocDecl emits just the `%vID.a = alloca <T>` for an
// aggregate-typed OP_CONST_NIL.  The alloca-hoisting pre-pass calls this
// so a nil aggregate built inside a loop body / if-branch gets its slot
// at the function entry block and doesn't leak native stack per execution
// (LLVM allocas in non-entry blocks aren't freed until function return).
// Non-aggregate nils (raw pointers) have no alloca and emit nothing.
func emitConstNilAllocDecl(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var name @[]char = constNilLLVMTypeName(instr)
	if len(name) == 0 { return out }
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".a = alloca ")
	out = out.WriteStr(name)
	out = out.WriteByte('\n')
	return out
}

// emitNilAggregate emits the in-place `fieldwise-zero + load` for an
// aggregate-typed nil constant.  llvmTyName is the LLVM-text form of the
// aggregate type (e.g. "%BnSlice", "%BnManagedSlice", or a named-struct
// ref like "%bn_pkg__X__T").  The matching `.a` alloca is hoisted to the
// function entry block by emitConstNilAllocDecl; this runs at the instr's
// original location so each execution (e.g. each loop iteration) re-zeroes
// the slot.
func emitNilAggregate(
	out buf.CharBuf,
	instr @ir.Instr,
	llvmTyName *[]readonly char,
) buf.CharBuf {
	// fieldwise zero — build the slot ref "%vID.a" and walk t's
	// layout, emitting one scalar zero-store per leaf.
	var slotBuf buf.CharBuf = buf.New()
	slotBuf = slotBuf.WriteStr("%v")
	slotBuf = slotBuf.WriteInt(instr.ID)
	slotBuf = slotBuf.WriteStr(".a")
	out = emitFieldwiseZero(out, slotBuf.Bytes(), instr.Typ, instr.ID)
	// load
	out = out.WriteStr("  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load ")
	out = out.WriteStr(llvmTyName)
	out = out.WriteStr(", ")
	out = out.WriteStr(llvmTyName)
	out = out.WriteStr("* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".a\n")
	return out
}
