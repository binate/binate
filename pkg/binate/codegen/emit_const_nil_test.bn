package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for emitConstNil — per-kind nil/zero-init lowering.
//
// Each aggregate-typed nil constant lowers to an
// `alloca + fieldwise-zero + load` sequence; the fieldwise-zero
// pass (emitFieldwiseZero) emits one scalar `store <T> <zero>` per
// scalar leaf, never a single aggregate `store <T> zeroinitializer`
// (LLVM may lower the latter to memset / __aeabi_memclr).  Tests
// assert the per-scalar shape and absence of the legacy
// `zeroinitializer` substring + any libc memory primitive.

func TestEmitConstNilSlice() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var s *[]int; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "%BnSlice zeroinitializer") {
		return fail("aggregate zeroinitializer must be gone for *[]int nil")
	}
	if !contains(out, "alloca %BnSlice") {
		return fail("expected %BnSlice slot alloca")
	}
	// 2 scalar fields → at least 2 explicit zero-stores.  ptr null
	// for the data pointer, integer 0 for the length.
	if !contains(out, "store ptr null, ptr ") {
		return fail("expected ptr-null store for slice data field")
	}
	if !contains(out, "store i64 0, ptr ") &&
		!contains(out, "store i32 0, ptr ") {
		return fail("expected int 0 store for slice length field")
	}
	if contains(out, "memset") || contains(out, "memcpy") {
		return fail("must not emit memset/memcpy")
	}
	return ""
}

func TestEmitConstNilManagedSlice() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var s @[]int; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "%BnManagedSlice zeroinitializer") {
		return fail("aggregate zeroinitializer must be gone for @[]int nil")
	}
	if !contains(out, "alloca %BnManagedSlice") {
		return fail("expected %BnManagedSlice slot alloca")
	}
	if !contains(out, "store ptr null, ptr ") {
		return fail("expected ptr-null store for managed-slice fields")
	}
	if contains(out, "memset") || contains(out, "memcpy") {
		return fail("must not emit memset/memcpy")
	}
	return ""
}

func TestEmitConstNilFuncValue() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var f *func(); _ = f }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "%BnFuncValue zeroinitializer") {
		return fail("aggregate zeroinitializer must be gone for *func() nil")
	}
	if !contains(out, "alloca %BnFuncValue") {
		return fail("expected %BnFuncValue slot alloca")
	}
	// 2 ptr fields → 2 `store ptr null, ptr ...` lines.
	if !contains(out, "store ptr null, ptr ") {
		return fail("expected ptr-null stores for func-value fields")
	}
	return ""
}

func TestEmitConstNilIfaceValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("func main() { var iv *I; _ = iv }\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if contains(out, "%BnIfaceValue zeroinitializer") {
		return fail("aggregate zeroinitializer must be gone for *I nil")
	}
	if !contains(out, "alloca %BnIfaceValue") {
		return fail("expected %BnIfaceValue slot alloca")
	}
	if !contains(out, "store ptr null, ptr ") {
		return fail("expected ptr-null stores for iface-value fields")
	}
	return ""
}
