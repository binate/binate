package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the bulk path of emitFieldwiseZero / emitFieldwiseCopy
// (emit_copy.bn): above bulkLeafThreshold scalar leaves, one call to
// rt.MemZero / rt.MemCopy replaces the per-leaf stores.

// A 64-byte array (64 leaves) zero-fills with one rt.MemZero call of its size,
// and no per-leaf store.
func TestEmitFieldwiseZeroBulkArrayCallsMemZero() testing.TestResult {
	setTarget64()
	var out @[]char = emitZeroToString("%dst", types.MakeArrayType(types.TypUint8(), 64), 3)
	var want @[]char = buf.Concat(buf.Concat("call void @", rtSym("MemZero")), "(i8* %dst, i64 64)")
	if !contains(out, want) { return fail(buf.Concat("expected an rt.MemZero call, got: ", out)) }
	if contains(out, "store ") { return fail("a bulk zero-fill must not emit per-leaf stores") }
	return ""
}

// A 64-byte array copies with one rt.MemCopy call of its size, and no per-leaf
// load or store.
func TestEmitFieldwiseCopyBulkArrayCallsMemCopy() testing.TestResult {
	setTarget64()
	var out @[]char = emitCopyToString("%dst", "%src", types.MakeArrayType(types.TypUint8(), 64), 4)
	var want @[]char = buf.Concat(buf.Concat("call void @", rtSym("MemCopy")),
			"(i8* %dst, i8* %src, i64 64)")
	if !contains(out, want) { return fail(buf.Concat("expected an rt.MemCopy call, got: ", out)) }
	if contains(out, "store ") || contains(out, "load ") {
		return fail("a bulk copy must not emit per-leaf loads or stores")
	}
	return ""
}

// On a 32-bit target the size argument is the target's int (i32).
func TestEmitFieldwiseZeroBulkUsesTargetInt() testing.TestResult {
	setTarget32()
	var out @[]char = emitZeroToString("%dst", types.MakeArrayType(types.TypUint8(), 64), 5)
	setTarget64()
	if !contains(out, "(i8* %dst, i32 64)") {
		return fail(buf.Concat("expected an i32 size, got: ", out))
	}
	return ""
}

// The threshold: 16 leaves still zero-fill per leaf, 17 call rt.MemZero.
func TestEmitFieldwiseZeroBulkThreshold() testing.TestResult {
	setTarget64()
	var at @[]char = emitZeroToString("%dst", types.MakeArrayType(types.TypUint8(), 16), 6)
	if contains(at, "MemZero") || !contains(at, "store ") {
		return fail("16 leaves must zero-fill per leaf")
	}
	var over @[]char = emitZeroToString("%dst", types.MakeArrayType(types.TypUint8(), 17), 7)
	if !contains(over, "MemZero") || contains(over, "store ") {
		return fail("17 leaves must call rt.MemZero")
	}
	return ""
}
