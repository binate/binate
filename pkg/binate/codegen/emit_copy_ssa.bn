package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"

// SSA-source variants of the fieldwise emitters in emit_copy.bn.
//
// The ptr→ptr helpers in emit_copy.bn cover cases where both
// endpoints are addresses (e.g., byval-spill, alloc-zero).  Step 5
// of plan-codegen-c-free-copies.md handles a different shape: an
// aggregate SSA value being stored to a pointer (the generic
// OP_STORE case).  Here the source isn't a pointer — it's a
// register-resident aggregate — so the per-leaf source-side read
// uses `extractvalue <T> %src, <indexPath>` with LLVM aggregate-
// index syntax instead of byte-offset GEPs.
//
// Same goal: never emit `store <Aggregate> %v, ptr <slot>` for
// types past LLVM's memcpy-lowering threshold on ARM EABI.

// emitAggregateStoreFromSSAInstr emits LLVM IR that writes the
// scalar leaves of an aggregate SSA value (`src`) to the address
// `dst`.  Source side uses `extractvalue <T> %src, <indexPath>`
// (LLVM aggregate-index syntax); dest side uses byte-offset GEPs
// from `dst` (no need for the LLVM aggregate-element-pointer form).
//
// Routed-to from OP_STORE's aggregate-typed case to avoid the
// `store <T> %v, ptr <slot>` form, which on ARM EABI lowers to
// `__aeabi_memcpy` for aggregates above a target-specific threshold
// — the actual link-time blocker on baremetal.
//
// SSA naming uses the combined dst.ID + src.ID prefix to keep names
// unique even when two OP_STOREs share either endpoint (an OP_STORE
// itself is a void instr with ID = -1, so it has no identifier of
// its own).
func emitAggregateStoreFromSSAInstr(
	out buf.CharBuf,
	dst @ir.Instr,
	src @ir.Instr,
) buf.CharBuf {
	if src.Typ == nil {
		return out
	}
	var dstBuf buf.CharBuf = buf.New()
	dstBuf = emitPtrRef(dstBuf, dst)
	var srcBuf buf.CharBuf = buf.New()
	srcBuf = emitRef(srcBuf, src.ID)
	var srcLLTy @[]char = llvmType(src.Typ)
	var counter int = 0
	var newOut buf.CharBuf
	newOut, counter = emitStoreSSARec(out, dstBuf.Bytes(), srcBuf.Bytes(),
		srcLLTy, src.Typ, 0, "", dst.ID, src.ID, counter)
	return newOut
}

// emitStoreSSARec is the recursive workhorse for
// emitAggregateStoreFromSSAInstr.  Walks t's layout tracking BOTH
// byte offset (for the dest-side GEP) AND LLVM aggregate-index
// path (for the source-side extractvalue).  At each scalar leaf,
// emits:
//
//   %vDST_SRC.ssN_v  = extractvalue <srcLLTy> <srcRef><indexPath>
//   %vDST_SRC.ssN_dp = getelementptr i8, ptr <dstRef>, i32 <offset>
//   store <scalar> %vDST_SRC.ssN_v, ptr %vDST_SRC.ssN_dp
//
// The two-ID `vDST_SRC` prefix keeps SSA names unique across
// OP_STOREs sharing either endpoint.
func emitStoreSSARec(
	out buf.CharBuf,
	dstRef *[]const char,
	srcRef *[]const char,
	srcLLTy *[]const char,
	t @types.Type,
	offset int,
	indexPath *[]const char,
	dstID int,
	srcID int,
	counter int,
) (buf.CharBuf, int) {
	if t == nil {
		return out, counter
	}
	t = t.ResolveAlias()
	if t.Kind == types.TYP_CONST {
		return emitStoreSSARec(out, dstRef, srcRef, srcLLTy, t.Elem,
			offset, indexPath, dstID, srcID, counter)
	}

	// Struct: recurse into each field with appended LLVM field
	// index.  Two LLVM-emission styles are in play:
	//   - Named user structs use the packed `<{ ... }>` form with
	//     explicit `[N x i8]` padding fields interleaved between
	//     declared fields.  Map Binate index → LLVM index via
	//     structLLVMIndex.
	//   - Anonymous multi-return tuples use the non-packed
	//     `{ ... }` form without explicit padding; the Binate
	//     index IS the LLVM index.
	if t.Kind == types.TYP_STRUCT {
		var layout @[]types.FieldLayout = t.StructLayout()
		var named bool = len(t.Name) > 0
		for i := 0; i < len(layout); i++ {
			var llvmIdx int = i
			if named { llvmIdx = structLLVMIndex(t, i) }
			var sub @[]char = extendIndexPath(indexPath, llvmIdx)
			out, counter = emitStoreSSARec(out, dstRef, srcRef, srcLLTy,
				t.Fields[i].Type, offset + layout[i].Offset,
				sub, dstID, srcID, counter)
		}
		return out, counter
	}

	// Array: recurse into each element with appended index N.
	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 {
			return out, counter
		}
		var elemSize int = t.Elem.SizeOf()
		for i := 0; i < t.ArrayLen; i++ {
			var sub @[]char = extendIndexPath(indexPath, i)
			out, counter = emitStoreSSARec(out, dstRef, srcRef, srcLLTy,
				t.Elem, offset + i * elemSize, sub,
				dstID, srcID, counter)
		}
		return out, counter
	}

	// Slice / managed-slice / func-value / interface-value: fixed
	// layouts.  Each emits per-scalar (extract + gep + store) with
	// the appended single-level index.
	if t.Kind == types.TYP_SLICE {
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, "ptr", offset, extendIndexPath(indexPath, 0),
			dstID, srcID, counter)
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, intLL(),
			offset + types.GetTarget().PointerSize,
			extendIndexPath(indexPath, 1),
			dstID, srcID, counter)
		return out, counter
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		var ps int = types.GetTarget().PointerSize
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, "ptr", offset,
			extendIndexPath(indexPath, 0), dstID, srcID, counter)
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, intLL(), offset + ps,
			extendIndexPath(indexPath, 1), dstID, srcID, counter)
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, "ptr", offset + 2 * ps,
			extendIndexPath(indexPath, 2), dstID, srcID, counter)
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, intLL(), offset + 3 * ps,
			extendIndexPath(indexPath, 3), dstID, srcID, counter)
		return out, counter
	}
	if t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		var ps int = types.GetTarget().PointerSize
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, "ptr", offset,
			extendIndexPath(indexPath, 0), dstID, srcID, counter)
		out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef,
			srcLLTy, "ptr", offset + ps,
			extendIndexPath(indexPath, 1), dstID, srcID, counter)
		return out, counter
	}

	// Scalar leaf at the current (offset, indexPath).
	var llvmTyp @[]char = llvmType(t)
	out, counter = emitScalarStoreFromSSA(out, dstRef, srcRef, srcLLTy,
		llvmTyp, offset, indexPath, dstID, srcID, counter)
	return out, counter
}

// emitScalarStoreFromSSA emits one extractvalue + GEP + store triple
// for a single scalar leaf at byte offset `offset` and LLVM aggregate
// index path `indexPath` (the comma-prefix-and-space-separated form
// extractvalue takes after the value operand).
func emitScalarStoreFromSSA(
	out buf.CharBuf,
	dstRef *[]const char,
	srcRef *[]const char,
	srcLLTy *[]const char,
	scalarTy *[]const char,
	offset int,
	indexPath *[]const char,
	dstID int,
	srcID int,
	counter int,
) (buf.CharBuf, int) {
	// extractvalue
	out = out.WriteStr("  %v")
	out = out.WriteInt(dstID)
	out = out.WriteByte('_')
	out = out.WriteInt(srcID)
	out = out.WriteStr(".ss")
	out = out.WriteInt(counter)
	out = out.WriteStr("_v = extractvalue ")
	out = out.WriteStr(srcLLTy)
	out = out.WriteByte(' ')
	out = out.WriteStr(srcRef)
	out = out.WriteStr(indexPath)
	out = out.WriteByte('\n')
	// gep
	out = out.WriteStr("  %v")
	out = out.WriteInt(dstID)
	out = out.WriteByte('_')
	out = out.WriteInt(srcID)
	out = out.WriteStr(".ss")
	out = out.WriteInt(counter)
	out = out.WriteStr("_dp = getelementptr i8, ptr ")
	out = out.WriteStr(dstRef)
	out = out.WriteStr(", i32 ")
	out = out.WriteInt(offset)
	out = out.WriteByte('\n')
	// store
	out = out.WriteStr("  store ")
	out = out.WriteStr(scalarTy)
	out = out.WriteStr(" %v")
	out = out.WriteInt(dstID)
	out = out.WriteByte('_')
	out = out.WriteInt(srcID)
	out = out.WriteStr(".ss")
	out = out.WriteInt(counter)
	out = out.WriteStr("_v, ptr %v")
	out = out.WriteInt(dstID)
	out = out.WriteByte('_')
	out = out.WriteInt(srcID)
	out = out.WriteStr(".ss")
	out = out.WriteInt(counter)
	out = out.WriteStr("_dp\n")
	return out, counter + 1
}

// extendIndexPath returns a fresh @[]char `<existing>, <i>` — the
// LLVM aggregate-index-path syntax appended with one more level.
// At top level (existing is empty), produces `, <i>` so the result
// reads cleanly as `extractvalue %T %src<indexPath>`.
func extendIndexPath(existing *[]const char, i int) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(existing)
	b = b.WriteStr(", ")
	b = b.WriteInt(i)
	return b.Bytes()
}

// isAggregateForStore reports whether OP_STORE of a value of type t
// should be lowered to a per-scalar sequence (via
// emitAggregateStoreFromSSAInstr) rather than a plain
// `store <T> %v, ptr` aggregate store.  An aggregate `store` for
// types above a target-specific size threshold lowers to
// `__aeabi_memcpy` / similar libc memory primitives on ARM EABI;
// the per-scalar form sidesteps that entirely.
//
// Same predicate as the byval-eligibility test in codegen/native
// (kept separate so its meaning stays "lower to scalars" rather
// than "use byval ABI" — they happen to coincide today but are
// distinct concepts).
func isAggregateForStore(t @types.Type) bool {
	if t == nil {
		return false
	}
	t = t.ResolveAlias()
	if t.Kind == types.TYP_CONST {
		return isAggregateForStore(t.Elem)
	}
	if t.Kind == types.TYP_STRUCT ||
		t.Kind == types.TYP_ARRAY ||
		t.Kind == types.TYP_SLICE ||
		t.Kind == types.TYP_MANAGED_SLICE ||
		t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return true
	}
	return false
}
