package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// SSA-source aggregate LOAD lowering — the read/insertvalue counterpart
// to the store emitters in emit_copy_ssa.bn (which keeps the shared
// extendIndexPath helper and the isAggregateForStore predicate).

// emitAggregateLoadIntoSSAInstr emits LLVM IR that reads the scalar
// leaves of an aggregate from the address `srcPtr` and assembles
// them into the aggregate-typed SSA result of `dst` (an OP_LOAD
// instr).  Per leaf:
//
//   %vID.flN_lp  = getelementptr i8, ptr <srcRef>, i32 <offset>
//   %vID.flN_v   = load <scalar>, ptr %vID.flN_lp
//   %vID.flN_acc = insertvalue <T> <previous>, <scalar> %vID.flN_v, <indexPath>
//
// The chain accumulates the aggregate into `%vID.fl(N-1)_acc`; the
// LAST insertvalue is named `%vID` directly so callers see the
// fully-built aggregate value at the OP_LOAD's instr-ID name.
//
// Routed-to from OP_LOAD's aggregate-typed case to avoid the
// `%vID = load <T>, ptr %p` form, which LLVM's ARM EABI backend
// may lower to `__aeabi_memcpy` for large aggregates.  The
// threshold (and whether load-lowering reaches for memcpy at all)
// depends on LLVM version + target ABI — not pinned by any spec.
// Decomposing here removes that dependency entirely.
func emitAggregateLoadIntoSSAInstr(
	out *strings.Builder,
	dst @ir.Instr,
	srcPtr @ir.Instr,
) {
	if dst.Typ == nil {
		return
	}
	var srcBuf @strings.Builder = strings.NewBuilder()
	emitPtrRef(srcBuf, srcPtr)
	var dstLLTy @[]char = llvmType(dst.Typ)
	var total int = countAggregateLeaves(dst.Typ)
	var counter int = 0
	// First insertvalue's "previous" operand is `undef`; subsequent
	// inserts thread the accumulator name.
	var prev @[]char = "undef"
	counter, prev = emitLoadSSARec(out, buf.CopyStr(srcBuf.String()),
		dstLLTy, dst.Typ, 0, "", dst.ID, total, counter, prev)
}

// emitLoadSSARec is the recursive workhorse for
// emitAggregateLoadIntoSSAInstr.  Walks t's layout tracking byte
// offset (for the GEP), LLVM aggregate-index path (for
// insertvalue), and the accumulator-SSA-name flowing through the
// insertvalue chain.  Returns (out, counter, latest-acc-name).
func emitLoadSSARec(
	out *strings.Builder,
	srcRef *[]readonly char,
	dstLLTy *[]readonly char,
	t @types.Type,
	offset int,
	indexPath *[]readonly char,
	dstID int,
	total int,
	counter int,
	prev *[]readonly char,
) (int, @[]char) {
	var prevAcc @[]char
	prevAcc = buf.CopyStr(prev)
	if t == nil {
		return counter, prevAcc
	}
	t = t.ResolveAlias()
	if t.Kind == types.TYP_READONLY {
		return emitLoadSSARec(out, srcRef, dstLLTy, t.Elem,
			offset, indexPath, dstID, total, counter, prev)
	}

	if t.Kind == types.TYP_STRUCT {
		var layout @[]types.FieldLayout = t.StructLayout()
		var named bool = len(t.Name) > 0
		for i := 0; i < len(layout); i++ {
			var llvmIdx int = i
			if named { llvmIdx = structLLVMIndex(t, i) }
			var sub @[]char = extendIndexPath(indexPath, llvmIdx)
			counter, prevAcc = emitLoadSSARec(out, srcRef, dstLLTy,
				t.Fields[i].Type, offset + layout[i].Offset,
				sub, dstID, total, counter, prevAcc)
		}
		return counter, prevAcc
	}

	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 {
			return counter, prevAcc
		}
		var elemSize int = t.Elem.SizeOf()
		for i := 0; i < t.ArrayLen; i++ {
			var sub @[]char = extendIndexPath(indexPath, i)
			counter, prevAcc = emitLoadSSARec(out, srcRef, dstLLTy,
				t.Elem, offset + i * elemSize, sub,
				dstID, total, counter, prevAcc)
		}
		return counter, prevAcc
	}

	if t.Kind == types.TYP_SLICE {
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, "ptr", offset, extendIndexPath(indexPath, 0),
			dstID, total, counter, prevAcc)
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, intLL(),
			offset + types.GetTarget().PointerSize,
			extendIndexPath(indexPath, 1),
			dstID, total, counter, prevAcc)
		return counter, prevAcc
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		var ps int = types.GetTarget().PointerSize
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, "ptr", offset,
			extendIndexPath(indexPath, 0), dstID, total, counter, prevAcc)
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, intLL(), offset + ps,
			extendIndexPath(indexPath, 1), dstID, total, counter, prevAcc)
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, "ptr", offset + 2 * ps,
			extendIndexPath(indexPath, 2), dstID, total, counter, prevAcc)
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, intLL(), offset + 3 * ps,
			extendIndexPath(indexPath, 3), dstID, total, counter, prevAcc)
		return counter, prevAcc
	}
	if t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		var ps int = types.GetTarget().PointerSize
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, "ptr", offset,
			extendIndexPath(indexPath, 0), dstID, total, counter, prevAcc)
		counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef,
			dstLLTy, "ptr", offset + ps,
			extendIndexPath(indexPath, 1), dstID, total, counter, prevAcc)
		return counter, prevAcc
	}

	var llvmTyp @[]char = llvmType(t)
	counter, prevAcc = emitScalarLoadIntoSSA(out, srcRef, dstLLTy,
		llvmTyp, offset, indexPath, dstID, total, counter, prevAcc)
	return counter, prevAcc
}

// emitScalarLoadIntoSSA emits one GEP + load + insertvalue triple
// for a single scalar leaf.  The insertvalue's result is named
// `%vDST` for the LAST leaf (counter == total - 1) and
// `%vDST.flN_acc` for all others — so the OP_LOAD's instr-ID SSA
// name carries the fully-assembled aggregate.
func emitScalarLoadIntoSSA(
	out *strings.Builder,
	srcRef *[]readonly char,
	dstLLTy *[]readonly char,
	scalarTy *[]readonly char,
	offset int,
	indexPath *[]readonly char,
	dstID int,
	total int,
	counter int,
	prev *[]readonly char,
) (int, @[]char) {
	// gep
	out.Write("  %v")
	stringutils.WriteInt(out, dstID)
	out.Write(".fl")
	stringutils.WriteInt(out, counter)
	out.Write("_lp = getelementptr i8, ptr ")
	out.Write(srcRef)
	out.Write(", i32 ")
	stringutils.WriteInt(out, offset)
	out.WriteByte('\n')
	// load
	out.Write("  %v")
	stringutils.WriteInt(out, dstID)
	out.Write(".fl")
	stringutils.WriteInt(out, counter)
	out.Write("_v = load ")
	out.Write(scalarTy)
	out.Write(", ptr %v")
	stringutils.WriteInt(out, dstID)
	out.Write(".fl")
	stringutils.WriteInt(out, counter)
	out.Write("_lp\n")
	// insertvalue — last leaf names %vDST; others name %vDST.flN_acc.
	var isLast bool = (counter == total - 1)
	out.Write("  ")
	if isLast {
		out.Write("%v")
		stringutils.WriteInt(out, dstID)
	} else {
		out.Write("%v")
		stringutils.WriteInt(out, dstID)
		out.Write(".fl")
		stringutils.WriteInt(out, counter)
		out.Write("_acc")
	}
	out.Write(" = insertvalue ")
	out.Write(dstLLTy)
	out.WriteByte(' ')
	out.Write(prev)
	out.Write(", ")
	out.Write(scalarTy)
	out.Write(" %v")
	stringutils.WriteInt(out, dstID)
	out.Write(".fl")
	stringutils.WriteInt(out, counter)
	out.Write("_v")
	out.Write(indexPath)
	out.WriteByte('\n')
	// Compute the accumulator name for the next leaf.
	var nextAcc @strings.Builder = strings.NewBuilder()
	if isLast {
		nextAcc.Write("%v")
		stringutils.WriteInt(nextAcc, dstID)
	} else {
		nextAcc.Write("%v")
		stringutils.WriteInt(nextAcc, dstID)
		nextAcc.Write(".fl")
		stringutils.WriteInt(nextAcc, counter)
		nextAcc.Write("_acc")
	}
	return counter + 1, buf.CopyStr(nextAcc.String())
}

// countAggregateLeaves returns the number of scalar leaves in t's
// layout.  Used by emitAggregateLoadIntoSSAInstr to know when to
// name the final insertvalue with the OP_LOAD's instr-ID SSA name.
func countAggregateLeaves(t @types.Type) int {
	if t == nil { return 0 }
	t = t.ResolveAlias()
	if t.Kind == types.TYP_READONLY { return countAggregateLeaves(t.Elem) }
	if t.Kind == types.TYP_STRUCT {
		var n int = 0
		for i := 0; i < len(t.Fields); i++ {
			n = n + countAggregateLeaves(t.Fields[i].Type)
		}
		return n
	}
	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 { return 0 }
		return t.ArrayLen * countAggregateLeaves(t.Elem)
	}
	if t.Kind == types.TYP_SLICE { return 2 }
	if t.Kind == types.TYP_MANAGED_SLICE { return 4 }
	if t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return 2
	}
	if t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return 2
	}
	return 1
}
