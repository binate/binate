package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Direct unit tests for the SSA-source aggregate LOAD emitters in
// emit_copy_ssa_load.bn (emitAggregateLoadIntoSSAInstr / emitLoadSSARec /
// emitScalarLoadIntoSSA / countAggregateLeaves).  The store-side
// counterparts live in emit_copy_ssa_test.bn; shared helpers (setTarget64,
// fieldsTwo, fieldsThree, contains, fail, compileToLLVM) live in the
// sibling codegen test files (same package).

// emitAggregateLoadIntoSSAInstr on a two-int32 named struct emits
// 2 leaves: each is GEP + load + insertvalue.  The LAST insertvalue
// names the OP_LOAD's result (%vID), not the intermediate
// accumulator — so callers see the fully-built aggregate at the
// expected SSA name.
func TestEmitLoadSSARecLastInsertvalueNamesResult() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("S", fieldsTwo(
		types.TypInt32(), "a", types.TypInt32(), "b"))
	var loadInstr @ir.Instr = make(ir.Instr)
	loadInstr.ID = 42
	loadInstr.Typ = s
	var srcInstr @ir.Instr = make(ir.Instr)
	srcInstr.ID = 7
	var b @strings.Builder = strings.NewBuilder()
	emitAggregateLoadIntoSSAInstr(b, loadInstr, srcInstr)
	var out @[]char = buf.CopyStr(b.String())
	// llvmType for a named struct produces `%bn_<pkg>__<Name>`;
	// the modulePkgName defaults to "main" outside a Module context.
	// First leaf: GEP at offset 0, load i32, insertvalue undef.
	if !contains(out,
			"%v42.fl0_acc = insertvalue %bn_S1_4_main1_1_S undef, i32 %v42.fl0_v, 0") {
		return fail("expected first insertvalue against undef")
	}
	// Second (last) leaf: insertvalue names %v42 (the result),
	// previous-acc = %v42.fl0_acc.
	if !contains(out,
			"%v42 = insertvalue %bn_S1_4_main1_1_S %v42.fl0_acc, i32 %v42.fl1_v, 1") {
		return fail("expected last insertvalue to name the OP_LOAD result")
	}
	// No aggregate load remains.
	if contains(out, "load %bn_S1_4_main1_1_S, ptr") {
		return fail("aggregate load must be gone")
	}
	return ""
}

// countAggregateLeaves: a struct of {int, slice, int} has 4 leaves
// (1 + 2 + 1).
func TestCountAggregateLeaves() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("S", fieldsThree(
		types.TypInt(), "a",
		types.MakeSliceType(types.TypInt()), "b",
		types.TypInt(), "c"))
	if countAggregateLeaves(s) != 4 {
		return fail("{int, slice, int} should have 4 scalar leaves")
	}
	if countAggregateLeaves(types.TypInt()) != 1 {
		return fail("scalar int should be 1 leaf")
	}
	if countAggregateLeaves(types.MakeManagedSliceType(types.TypChar())) != 4 {
		return fail("managed-slice should be 4 leaves")
	}
	if countAggregateLeaves(types.MakeArrayType(types.TypInt32(), 5)) != 5 {
		return fail("[5]int32 should have 5 leaves")
	}
	return ""
}

// Load-side managed-slice: 4 leaves via the TYP_MANAGED_SLICE
// branch of emitLoadSSARec.  Same parallel coverage as
// TestEmitStoreSSARecManagedSlice did for the store path.
func TestEmitLoadSSARecManagedSlice() testing.TestResult {
	setTarget64()
	var msl @types.Type =
		types.MakeManagedSliceType(types.TypChar())
	var loadInstr @ir.Instr = make(ir.Instr)
	loadInstr.ID = 8
	loadInstr.Typ = msl
	var srcInstr @ir.Instr = make(ir.Instr)
	srcInstr.ID = 2
	var b @strings.Builder = strings.NewBuilder()
	emitAggregateLoadIntoSSAInstr(b, loadInstr, srcInstr)
	var out @[]char = buf.CopyStr(b.String())
	// 4 GEPs at offsets 0, 8, 16, 24 (LP64 ptrSize=8).
	if !contains(out, "%v8.fl0_lp = getelementptr i8, ptr %v2, i32 0") {
		return fail("expected leaf 0 GEP at offset 0")
	}
	if !contains(out, "%v8.fl3_lp = getelementptr i8, ptr %v2, i32 24") {
		return fail("expected leaf 3 GEP at offset 24")
	}
	// Last insertvalue names the result.
	if !contains(out, "%v8 = insertvalue %BnManagedSlice") {
		return fail("expected last insertvalue to name %v8")
	}
	if contains(out, "%v8.fl4_") {
		return fail("only 4 leaves expected for managed-slice")
	}
	return ""
}

// Load-side padded named struct: same trap as the store path —
// `{ bool, int64 }` lays out at LLVM as `<{ i1, [7 x i8], i64 }>`,
// and the int64 insertvalue must use LLVM index 2 (not Binate
// index 1).  Mirror of TestEmitStoreSSARecPaddedNamedStruct.
func TestEmitLoadSSARecPaddedNamedStruct() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("X", fieldsTwo(
		types.TypBool(), "a", types.TypInt64(), "b"))
	var loadInstr @ir.Instr = make(ir.Instr)
	loadInstr.ID = 5
	loadInstr.Typ = s
	var srcInstr @ir.Instr = make(ir.Instr)
	srcInstr.ID = 9
	var b @strings.Builder = strings.NewBuilder()
	emitAggregateLoadIntoSSAInstr(b, loadInstr, srcInstr)
	var out @[]char = buf.CopyStr(b.String())
	// Second leaf insertvalue path uses LLVM index 2.
	if !contains(out,
			"%v5 = insertvalue %bn_S1_4_main1_1_X %v5.fl0_acc, i64 %v5.fl1_v, 2") {
		return fail("expected int64 insertvalue at LLVM index 2 (skipping padding)")
	}
	// And NOT at Binate index 1.
	if contains(out, "i64 %v5.fl1_v, 1\n") {
		return fail("must NOT use Binate field index 1 (which is padding at LLVM)")
	}
	return ""
}

// End-to-end via compileToLLVM: dereferencing a pointer to a
// struct produces an aggregate OP_LOAD.  Must lower via
// emitAggregateLoadIntoSSAInstr: per-leaf GEP + load + insertvalue
// chain, NOT a single `load %T, %T* %p`.
func TestAggregateLoadUsesFieldwise() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type P struct { x int; y int }\n")
	cb.Write("func read(p *P) P { return *p }\n")
	cb.Write("func main() {}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Fieldwise per-leaf load.
	if !contains(out, ".fl0_v = load") {
		return fail("expected fieldwise load for *P deref")
	}
	if !contains(out, ".fl0_acc = insertvalue %bn_S1_4_main1_1_P") {
		return fail("expected fieldwise insertvalue chain")
	}
	// No aggregate-value load of the named struct should appear.
	if contains(out, "load %bn_S1_4_main1_1_P,") {
		return fail("aggregate struct load must be gone")
	}
	return ""
}
