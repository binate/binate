package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Direct unit tests for the SSA-source fieldwise emitters in
// emit_copy_ssa.bn.  End-to-end coverage of the OP_STORE aggregate
// path lives in emit_copy_test.bn (TestAggregateStoreUsesFieldwise);
// these tests pin the helper's emission shape for specific type
// constructions (named struct, anonymous tuple, slice, etc.).

// emitStoreSSARec on a two-int32 named struct: expect 2 leaves with
// LLVM index path `, 0` and `, 1`, byte offsets 0 and 4.  Verifies
// the basic extractvalue + GEP + store sequence.
func TestEmitStoreSSARecTwoInt32() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("S", fieldsTwo(
		types.TypInt32(), "a", types.TypInt32(), "b"))
	var b @strings.Builder = strings.NewBuilder()
	var counter int = 0
	counter = emitStoreSSARec(b, "%d", "%v3", "%S",
		s, 0, "", 7, 3, counter)
	var out @[]char = buf.CopyStr(b.String())
	// Two leaves total.
	if !contains(out, "%v7_3.ss0_v = extractvalue %S %v3, 0") {
		return fail("expected first extractvalue at index 0")
	}
	if !contains(out, "%v7_3.ss1_v = extractvalue %S %v3, 1") {
		return fail("expected second extractvalue at index 1")
	}
	// Per-leaf byte offsets.
	if !contains(out, "%v7_3.ss0_dp = getelementptr i8, ptr %d, i32 0") {
		return fail("expected first GEP at offset 0")
	}
	if !contains(out, "%v7_3.ss1_dp = getelementptr i8, ptr %d, i32 4") {
		return fail("expected second GEP at offset 4")
	}
	if !contains(out, "store i32 %v7_3.ss0_v, ptr %v7_3.ss0_dp") {
		return fail("expected first store")
	}
	return ""
}

// Managed-slice source: 4 leaves with LLVM indices 0,1,2,3.  Pins
// the TYP_MANAGED_SLICE branch of emitStoreSSARec.
func TestEmitStoreSSARecManagedSlice() testing.TestResult {
	setTarget64()
	var msl @types.Type =
		types.MakeManagedSliceType(types.TypChar())
	var b @strings.Builder = strings.NewBuilder()
	var counter int = 0
	counter = emitStoreSSARec(b, "%d", "%v5", "%BnManagedSlice",
		msl, 0, "", 9, 5, counter)
	var out @[]char = buf.CopyStr(b.String())
	if !contains(out, "%v9_5.ss0_v = extractvalue %BnManagedSlice %v5, 0") {
		return fail("expected leaf 0 extract index 0")
	}
	if !contains(out, "%v9_5.ss3_v = extractvalue %BnManagedSlice %v5, 3") {
		return fail("expected leaf 3 extract index 3")
	}
	// 4th leaf at offset 24 (LP64 ptrSize=8, 3*8).
	if !contains(out, "%v9_5.ss3_dp = getelementptr i8, ptr %d, i32 24") {
		return fail("expected leaf 3 GEP at offset 24")
	}
	if contains(out, "%v9_5.ss4_") {
		return fail("only 4 leaves expected for managed-slice")
	}
	return ""
}

// isAggregateForStore: TYP_STRUCT / TYP_ARRAY / TYP_SLICE etc.
// return true; scalar types return false.
func TestIsAggregateForStore() testing.TestResult {
	if !isAggregateForStore(types.MakeStructType("S",
		fieldsTwo(types.TypInt32(), "a", types.TypInt32(), "b"))) {
		return fail("struct must be aggregate")
	}
	if !isAggregateForStore(
			types.MakeManagedSliceType(types.TypChar())) {
		return fail("managed-slice must be aggregate")
	}
	if !isAggregateForStore(types.MakeArrayType(types.TypInt32(), 5)) {
		return fail("array must be aggregate")
	}
	if isAggregateForStore(types.TypInt32()) {
		return fail("scalar i32 must not be aggregate")
	}
	if isAggregateForStore(types.TypBool()) {
		return fail("bool must not be aggregate")
	}
	if isAggregateForStore(types.MakePointerType(types.TypInt32())) {
		return fail("raw pointer must not be aggregate")
	}
	if isAggregateForStore(nil) {
		return fail("nil type must not be aggregate")
	}
	return ""
}

// extendIndexPath: at top level, " , 0".  Nested: "<prev>, 2".
func TestExtendIndexPath() testing.TestResult {
	var p0 @[]char = extendIndexPath("", 0)
	if !contains(p0, ", 0") {
		return fail("top-level path should start with `, 0`")
	}
	var p1 @[]char = extendIndexPath(p0, 5)
	if !contains(p1, ", 0, 5") {
		return fail("nested path should be `, 0, 5`")
	}
	return ""
}

// Named struct with internal padding: `{ bool, int64 }` lays out
// as `<{ i1, [7 x i8], i64 }>` at the LLVM level (bool at offset 0,
// int64 at offset 8 with 7 bytes of padding).  extractvalue for the
// int64 field must use LLVM index 2 (skipping the explicit padding
// at index 1), NOT Binate's field index 1.
//
// Regression test for the bug surfaced during step 5 development:
// the walker initially used Binate indices directly, producing
// out-of-bounds extractvalues for structs with padding.
func TestEmitStoreSSARecPaddedNamedStruct() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("X", fieldsTwo(
		types.TypBool(), "a", types.TypInt64(), "b"))
	var b @strings.Builder = strings.NewBuilder()
	var counter int = 0
	counter = emitStoreSSARec(b, "%d", "%v3", "%X",
		s, 0, "", 1, 3, counter)
	var out @[]char = buf.CopyStr(b.String())
	// Field 0 (bool) — LLVM index 0, offset 0.
	if !contains(out, "%v1_3.ss0_v = extractvalue %X %v3, 0") {
		return fail("expected bool field at LLVM index 0")
	}
	// Field 1 (int64) — LLVM index 2 (skipping padding), offset 8.
	if !contains(out, "%v1_3.ss1_v = extractvalue %X %v3, 2") {
		return fail("expected int64 field at LLVM index 2 (skipping padding)")
	}
	if !contains(out, "%v1_3.ss1_dp = getelementptr i8, ptr %d, i32 8") {
		return fail("expected int64 GEP at byte offset 8")
	}
	if contains(out, "%v1_3.ss1_v = extractvalue %X %v3, 1") {
		return fail("must NOT use Binate field index 1 (which is padding at LLVM)")
	}
	return ""
}

// Anonymous multi-return tuple: `{int, bool}` has NO explicit LLVM
// padding (non-packed `{ }` form).  Binate field index == LLVM
// field index.  Contrasts with the named-struct test above to pin
// the named/anonymous distinction in emitStoreSSARec.
func TestEmitStoreSSARecAnonymousTuple() testing.TestResult {
	setTarget64()
	// Empty name → anonymous tuple per llvmType's branch.
	var s @types.Type = types.MakeStructType("", fieldsTwo(
		types.TypInt(), "a", types.TypBool(), "b"))
	var b @strings.Builder = strings.NewBuilder()
	var counter int = 0
	counter = emitStoreSSARec(b, "%d", "%v0",
		"{i64, i1}", s, 0, "", 1, 0, counter)
	var out @[]char = buf.CopyStr(b.String())
	// Index 0 for the int.
	if !contains(out, ".ss0_v = extractvalue {i64, i1} %v0, 0") {
		return fail("expected first field at LLVM index 0")
	}
	// Index 1 for the bool (NOT 2 — no padding skip in anon tuples).
	if !contains(out, ".ss1_v = extractvalue {i64, i1} %v0, 1") {
		return fail("expected second field at LLVM index 1 (no padding skip)")
	}
	return ""
}

// End-to-end via compileToLLVM: an aggregate OP_STORE (struct
// assignment in source) must lower via the SSA-source helper —
// expect `.ss0_v = extractvalue` and the byte-offset GEP shape,
// NOT a plain `store <T> %v, %T* %v`.
func TestAggregateStoreUsesFieldwise() testing.TestResult {
	setTarget64()
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type P struct { x int; y int }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a P\n")
	cb.Write("\tvar b P\n")
	cb.Write("\ta.x = 1\n")
	cb.Write("\tb = a\n") // <-- aggregate OP_STORE
	cb.Write("\t_ = b\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, ".ss0_v = extractvalue %bn_S1_4_main1_1_P") {
		return fail("expected fieldwise extractvalue for struct assign")
	}
	// No aggregate-value store of the named struct should appear
	// after IR-gen of `b = a` — only per-field stores.  Sanity-check
	// via grep for the legacy shape.
	if contains(out, "store %bn_S1_4_main1_1_P %") {
		return fail("aggregate struct store must be gone")
	}
	return ""
}
