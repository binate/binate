package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitFieldwiseCopy / emitFieldwiseZero (emit_copy.bn).
//
// Each test calls the helper directly on a synthetic @types.Type,
// then asserts on substrings of the emitted LLVM text — looking for
// the expected per-scalar GEP+load+store sequence and the ABSENCE
// of any aggregate `store <T>` / `memcpy` / `memset` constructs.

// makeFields builds a small @[]@Field literal for tests.  Inlined
// to dodge the BUILDER restriction on @[]@T composite literals.
func makeFields(types_in @[]@types.Type, names @[]@[]char) @[]@types.Field {
	var result @[]@types.Field = make_slice(@types.Field, len(types_in))
	for i := 0; i < len(types_in); i++ {
		var f @types.Field = make(types.Field)
		f.Name = names[i]
		f.Type = types_in[i]
		result[i] = f
	}
	return result
}

// fieldsTwo returns a two-field @[]@Field convenience.
func fieldsTwo(t0 @types.Type, n0 @[]char,
	t1 @types.Type, n1 @[]char) @[]@types.Field {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = t0
	ts[1] = t1
	var ns @[]@[]char = make_slice(@[]char, 2)
	ns[0] = n0
	ns[1] = n1
	return makeFields(ts, ns)
}

// fieldsThree — three-field variant.
func fieldsThree(t0 @types.Type, n0 @[]char,
	t1 @types.Type, n1 @[]char,
	t2 @types.Type, n2 @[]char) @[]@types.Field {
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = t0
	ts[1] = t1
	ts[2] = t2
	var ns @[]@[]char = make_slice(@[]char, 3)
	ns[0] = n0
	ns[1] = n1
	ns[2] = n2
	return makeFields(ts, ns)
}

// emitCopyToString invokes emitFieldwiseCopy on a fresh CharBuf and
// returns the resulting LLVM text.
func emitCopyToString(dst *[]const char, src *[]const char,
	t @types.Type, idTag int) @[]char {
	var b buf.CharBuf = buf.New()
	b = emitFieldwiseCopy(b, dst, src, t, idTag)
	return b.Bytes()
}

// emitZeroToString — sibling for emitFieldwiseZero.
func emitZeroToString(dst *[]const char, t @types.Type, idTag int) @[]char {
	var b buf.CharBuf = buf.New()
	b = emitFieldwiseZero(b, dst, t, idTag)
	return b.Bytes()
}

// ============================================================
// emitFieldwiseCopy
// ============================================================

// Scalar int32: a single GEP+load+store at offset 0.
func TestEmitFieldwiseCopyInt32() testing.TestResult {
	setTarget64()
	var out @[]char = emitCopyToString("%dst", "%src", types.TypInt32(), 7)
	if !contains(out, "%v7.fc0_dp = getelementptr i8, ptr %dst, i32 0") {
		return fail("expected dst GEP at offset 0")
	}
	if !contains(out, "%v7.fc0_sp = getelementptr i8, ptr %src, i32 0") {
		return fail("expected src GEP at offset 0")
	}
	if !contains(out, "%v7.fc0_v = load i32, ptr %v7.fc0_sp") {
		return fail("expected i32 load from src GEP")
	}
	if !contains(out, "store i32 %v7.fc0_v, ptr %v7.fc0_dp") {
		return fail("expected i32 store to dst GEP")
	}
	// Must not introduce any aggregate / bulk-copy primitive.
	if contains(out, "memcpy") || contains(out, "memmove") ||
		contains(out, "memset") {
		return fail("emit must not reach for libc memory primitives")
	}
	return ""
}

// Struct {int32, int32}: two scalar copies at offsets 0 and 4.
func TestEmitFieldwiseCopyTwoInt32Fields() testing.TestResult {
	setTarget64()
	var s @types.Type = types.MakeStructType("S", fieldsTwo(
		types.TypInt32(), "a", types.TypInt32(), "b"))
	var out @[]char = emitCopyToString("%d", "%s", s, 1)
	if !contains(out, "%v1.fc0_dp = getelementptr i8, ptr %d, i32 0") {
		return fail("expected first field GEP at offset 0")
	}
	if !contains(out, "%v1.fc1_dp = getelementptr i8, ptr %d, i32 4") {
		return fail("expected second field GEP at offset 4")
	}
	if !contains(out, "store i32 %v1.fc1_v, ptr %v1.fc1_dp") {
		return fail("expected i32 store of second field")
	}
	// Counter must monotonically increment, not collide.
	if contains(out, "%v1.fc2_") {
		return fail("only two scalars expected for {int32,int32}")
	}
	return ""
}

// CharBuf-shape: struct { @[]char, int }, 20 bytes on ILP32, 24 on LP64.
// Expect 5 scalar copies: 4 from the managed-slice (ptr,len,ptr,len)
// + 1 from the int.  No aggregate load/store anywhere.
func TestEmitFieldwiseCopyCharBufShape() testing.TestResult {
	setTarget64()
	var mslChar @types.Type =
		types.MakeManagedSliceType(types.TypChar())
	var s @types.Type = types.MakeStructType("CharBuf", fieldsTwo(
		mslChar, "Data", types.TypInt(), "Len"))
	var out @[]char = emitCopyToString("%d", "%s", s, 42)
	// All 5 leaves should be present (fc0..fc4) and only those.
	if !contains(out, "%v42.fc0_dp") {
		return fail("expected leaf 0")
	}
	if !contains(out, "%v42.fc4_dp") {
		return fail("expected leaf 4 (Len field)")
	}
	if contains(out, "%v42.fc5_") {
		return fail("only 5 scalars expected for {@[]char,int}")
	}
	// First scalar = managed-slice data ptr at offset 0 (Data.data).
	if !contains(out, "load ptr, ptr %v42.fc0_sp") {
		return fail("expected ptr load for Data.data")
	}
	// Last scalar = int Len at offset 24 on LP64 (4*8 = 24).
	if !contains(out, "i32 24") {
		return fail("expected int32 24 offset for Len field on LP64")
	}
	// No aggregate stores / memcpy / memset.
	if contains(out, "store %") {
		return fail("must not emit aggregate `store %...`")
	}
	if contains(out, "memcpy") || contains(out, "memset") {
		return fail("must not call memcpy / memset")
	}
	return ""
}

// Array [3]int32: three i32 copies at offsets 0, 4, 8.
func TestEmitFieldwiseCopyArrayOfInt32() testing.TestResult {
	setTarget64()
	var arr @types.Type = types.MakeArrayType(types.TypInt32(), 3)
	var out @[]char = emitCopyToString("%d", "%s", arr, 0)
	if !contains(out, "%v0.fc0_dp = getelementptr i8, ptr %d, i32 0") {
		return fail("expected element 0 at offset 0")
	}
	if !contains(out, "%v0.fc1_dp = getelementptr i8, ptr %d, i32 4") {
		return fail("expected element 1 at offset 4")
	}
	if !contains(out, "%v0.fc2_dp = getelementptr i8, ptr %d, i32 8") {
		return fail("expected element 2 at offset 8")
	}
	if contains(out, "%v0.fc3_") {
		return fail("only 3 elements expected for [3]int32")
	}
	return ""
}

// ============================================================
// emitFieldwiseZero
// ============================================================

// Scalar int32: one GEP + `store i32 0` — no load.
func TestEmitFieldwiseZeroInt32() testing.TestResult {
	setTarget64()
	var out @[]char = emitZeroToString("%dst", types.TypInt32(), 3)
	if !contains(out, "%v3.fz0_dp = getelementptr i8, ptr %dst, i32 0") {
		return fail("expected GEP at offset 0")
	}
	if !contains(out, "store i32 0, ptr %v3.fz0_dp") {
		return fail("expected `store i32 0`")
	}
	// No load (zero-init has no source).
	if contains(out, "load ") {
		return fail("zero-init must not load")
	}
	return ""
}

// Managed-slice zero-init: 4 scalar zero-stores (ptr/intN/ptr/intN).
// Two of them are `store ptr null`, two are `store i64 0` (LP64).
func TestEmitFieldwiseZeroManagedSlice() testing.TestResult {
	setTarget64()
	var msl @types.Type =
		types.MakeManagedSliceType(types.TypChar())
	var out @[]char = emitZeroToString("%d", msl, 9)
	if !contains(out, "store ptr null, ptr %v9.fz0_dp") {
		return fail("expected data-pointer null-store at offset 0")
	}
	if !contains(out, "store i64 0, ptr %v9.fz1_dp") {
		return fail("expected len zero-store at offset 8 (LP64)")
	}
	if !contains(out, "store ptr null, ptr %v9.fz2_dp") {
		return fail("expected backing-pointer null-store at offset 16")
	}
	if contains(out, "%v9.fz4_") {
		return fail("only 4 scalars expected for managed-slice")
	}
	return ""
}

// Nested struct {{int32, int32}, int32}: 3 scalars at offsets 0, 4, 8.
// Confirms recursion across the inner struct boundary.
func TestEmitFieldwiseCopyNestedStruct() testing.TestResult {
	setTarget64()
	var inner @types.Type = types.MakeStructType("Inner", fieldsTwo(
		types.TypInt32(), "x", types.TypInt32(), "y"))
	var outer @types.Type = types.MakeStructType("Outer", fieldsTwo(
		inner, "p", types.TypInt32(), "z"))
	var out @[]char = emitCopyToString("%d", "%s", outer, 5)
	if !contains(out, "%v5.fc0_dp = getelementptr i8, ptr %d, i32 0") {
		return fail("expected inner.x at offset 0")
	}
	if !contains(out, "%v5.fc1_dp = getelementptr i8, ptr %d, i32 4") {
		return fail("expected inner.y at offset 4")
	}
	if !contains(out, "%v5.fc2_dp = getelementptr i8, ptr %d, i32 8") {
		return fail("expected outer.z at offset 8")
	}
	if contains(out, "%v5.fc3_") {
		return fail("only 3 scalars total expected")
	}
	return ""
}

// Pointer type: a single load+store at offset 0.  llvmType() maps
// raw pointers to `i8*` (the historical typed-pointer form), which
// is interchangeable with `ptr` in the operand position — both
// store the same machine value, neither triggers memcpy lowering.
func TestEmitFieldwiseCopyPointer() testing.TestResult {
	setTarget64()
	var p @types.Type =
		types.MakePointerType(types.TypInt32())
	var out @[]char = emitCopyToString("%d", "%s", p, 11)
	if !contains(out, "%v11.fc0_v = load i8*, ptr %v11.fc0_sp") {
		return fail("expected i8* load for raw pointer type")
	}
	if !contains(out, "store i8* %v11.fc0_v, ptr %v11.fc0_dp") {
		return fail("expected i8* store for raw pointer type")
	}
	return ""
}

// Zero-init of a typed-pointer scalar (`i8*` from llvmType) must
// emit `store i8* null`, not `store i8* 0` — the latter is invalid
// LLVM.  Covers the zeroLiteralForLLVMType branch that recognises
// trailing '*' as a pointer type.
func TestEmitFieldwiseZeroPointer() testing.TestResult {
	setTarget64()
	var p @types.Type =
		types.MakePointerType(types.TypInt32())
	var out @[]char = emitZeroToString("%d", p, 4)
	if !contains(out, "store i8* null, ptr %v4.fz0_dp") {
		return fail("expected `store i8* null` for raw pointer zero-init")
	}
	if contains(out, "store i8* 0,") {
		return fail("must not emit invalid `store i8* 0`")
	}
	return ""
}

// Byval-param spill end-to-end: a function taking a 24-byte struct
// param compiles into LLVM IR where the entry-block param-spill
// uses the per-scalar load/store sequence (5 leaves for {int64,
// int64, int}) and NO `@llvm.memcpy` call appears.
//
// This pins the actual codegen path for plan-codegen-c-free-copies
// step 2: the byval-spill case in emit_instr.bn's OP_STORE.
func TestEmitByvalSpillUsesFieldwiseCopy() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int }\n")
	cb = cb.WriteStr("func take(x Big) int { return x.c }\n")
	cb = cb.WriteStr("func main() {}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// Must NOT emit a memcpy intrinsic for the byval spill.
	if contains(out, "@llvm.memcpy") {
		return fail("byval spill must not emit @llvm.memcpy")
	}
	// Per-field offsets: a@0, b@8, c@16.  All three appear as
	// byte-offset GEPs from the slot alloca.
	if !contains(out, "getelementptr i8, ptr ") {
		return fail("expected byte-offset GEP for byval spill")
	}
	if !contains(out, ", i32 8\n") {
		return fail("expected offset 8 GEP for field b")
	}
	if !contains(out, ", i32 16\n") {
		return fail("expected offset 16 GEP for field c")
	}
	// And the declare itself is gone.
	if contains(out, "declare void @llvm.memcpy") {
		return fail("@llvm.memcpy declare should be dropped")
	}
	return ""
}

// Two byval params in one function must each get a UNIQUE SSA-name
// prefix in the spill sequence — otherwise LLVM rejects the IR with
// "multiple definition of local value".  The idTag in emit_instr.bn
// uses Args[0].ID (the dst alloca, fresh per param-spill) precisely
// to provide that uniqueness; this test pins that contract.
func TestEmitByvalSpillTwoParamsHaveDistinctSSANames() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int }\n")
	cb = cb.WriteStr("func take(x Big, y Big) int { return x.c + y.c }\n")
	cb = cb.WriteStr("func main() {}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// LLVM verifier (clang in our pipeline) would already reject a
	// dup-name IR before this test could even read it; the
	// compileToLLVM call would surface a "clang failed" message.
	// Add an explicit substring check so the assertion is
	// human-readable when this regresses, not just a build failure.
	if contains(out, "multiple definition") {
		return fail("two byval params produced colliding SSA names")
	}
	if contains(out, "@llvm.memcpy") {
		return fail("byval spill must not emit @llvm.memcpy")
	}
	return ""
}

// Byval managed-slice param: @[]char is 4*ptrSize = 32 bytes on LP64,
// so exceeds the 16-byte byval threshold.  Exercises emitCopyRec's
// TYP_MANAGED_SLICE branch (4 scalar copies — ptr, len, backing,
// cap) on the byval-spill path.
func TestEmitByvalSpillManagedSlice() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func take(x @[]char) int { return len(x) }\n")
	cb = cb.WriteStr("func main() {}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if contains(out, "@llvm.memcpy") {
		return fail("byval managed-slice spill must not emit @llvm.memcpy")
	}
	// 4 scalar fields → offsets 0, 8, 16, 24 (LP64 ptrSize=8).
	if !contains(out, ", i32 24\n") {
		return fail("expected offset 24 GEP for managed-slice cap field")
	}
	return ""
}

// Raw slice (TYP_SLICE) copy: two scalar copies (data ptr at offset 0,
// length int at offset ptrSize).  Smaller than managed-slice (no
// backing/cap fields); exercises the parallel TYP_SLICE branch in
// emitCopyRec that the managed-slice tests don't cover.
func TestEmitFieldwiseCopyRawSlice() testing.TestResult {
	setTarget64()
	var sl @types.Type = types.MakeSliceType(types.TypChar())
	var out @[]char = emitCopyToString("%d", "%s", sl, 2)
	if !contains(out, "%v2.fc0_v = load ptr, ptr %v2.fc0_sp") {
		return fail("expected ptr load for raw slice data")
	}
	if !contains(out, "%v2.fc1_dp = getelementptr i8, ptr %d, i32 8") {
		return fail("expected len GEP at offset 8 on LP64")
	}
	if contains(out, "%v2.fc2_") {
		return fail("only 2 scalars expected for raw slice")
	}
	return ""
}

// Function value (TYP_FUNC_VALUE): two pointer copies (vtable, data).
// Same shape as TYP_INTERFACE_VALUE / managed variants — covers all
// 4 *_VALUE branches via the shared code path.
func TestEmitFieldwiseCopyFuncValue() testing.TestResult {
	setTarget64()
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fv @types.Type =
		types.MakeFuncValueType(noParams, noResults)
	var out @[]char = emitCopyToString("%d", "%s", fv, 8)
	if !contains(out, "%v8.fc0_dp = getelementptr i8, ptr %d, i32 0") {
		return fail("expected vtable-ptr GEP at offset 0")
	}
	if !contains(out, "%v8.fc1_dp = getelementptr i8, ptr %d, i32 8") {
		return fail("expected data-ptr GEP at offset 8 on LP64")
	}
	if !contains(out, "load ptr, ptr %v8.fc0_sp") {
		return fail("expected ptr load for func-value field 0")
	}
	if !contains(out, "load ptr, ptr %v8.fc1_sp") {
		return fail("expected ptr load for func-value field 1")
	}
	if contains(out, "%v8.fc2_") {
		return fail("only 2 scalars expected for func-value")
	}
	return ""
}

// Float zero-init: `store double 0.0, ptr ...` — the `0.0` literal
// branch in zeroLiteralForLLVMType.  An aggregate-store of float
// might lower differently from int on some targets, so the explicit
// scalar-store path is the safe shape.
func TestEmitFieldwiseZeroFloat() testing.TestResult {
	setTarget64()
	var out @[]char = emitZeroToString("%d", types.TypFloat64(), 6)
	if !contains(out, "store double 0.0, ptr %v6.fz0_dp") {
		return fail("expected `store double 0.0` for float64 zero")
	}
	if contains(out, "store double 0,") {
		return fail("must not emit `store double 0` (missing `.0`)")
	}
	return ""
}

// 32-bit-target managed-slice zero-init: 4 scalar stores at offsets
// 0, 4, 8, 12 (ptrSize=4 on ILP32) — verifies target-aware offsets.
func TestEmitFieldwiseZeroManagedSliceILP32() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 4
	types.SetTarget(t32)
	var msl @types.Type =
		types.MakeManagedSliceType(types.TypChar())
	var out @[]char = emitZeroToString("%d", msl, 0)
	types.SetTarget(saved)

	if !contains(out, "store ptr null, ptr %v0.fz0_dp") {
		return fail("expected data-ptr null-store at offset 0")
	}
	if !contains(out, "%v0.fz1_dp = getelementptr i8, ptr %d, i32 4") {
		return fail("expected len GEP at offset 4 (ILP32 ptrSize)")
	}
	if !contains(out, "%v0.fz3_dp = getelementptr i8, ptr %d, i32 12") {
		return fail("expected cap GEP at offset 12 (ILP32 4*3)")
	}
	return ""
}
