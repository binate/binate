package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// emitDataGlobal lowers one ir.DataGlobal to a module-level LLVM constant /
// global:
//
//   @<name> = [weak_odr|private] constant|global { <term-types> } { <term-inits> }, align N
//
// The anonymous struct type + initializer are built term-by-term, so the
// emitted byte layout is exactly the DataGlobal's Init sequence.  This is the
// single LLVM lowering every static blob routes through, the LLVM half of the
// `ir.DataGlobal` unification (the native half is native/common's
// EmitDataGlobal); the two cannot drift because both walk the same terms.
func emitDataGlobal(out *strings.Builder, dg @ir.DataGlobal) {
	out.Write("@")
	out.Write(dg.Name)
	out.Write(" = ")
	if dg.Linkage == ir.DG_WEAK {
		out.Write("weak_odr ")
	} else if dg.Linkage == ir.DG_LOCAL {
		out.Write("private ")
	}
	// DG_GLOBAL: default external linkage for a definition — no keyword.
	if dg.UnnamedAddr {
		out.Write("unnamed_addr ")
	}
	if dg.ReadOnly {
		out.Write("constant ")
	} else {
		out.Write("global ")
	}
	writeDataGlobalLLTy(out, dg)
	out.WriteByte(' ')
	writeDataGlobalInit(out, dg)
	out.Write(", align ")
	stringutils.WriteInt(out, dg.Align)
	out.WriteByte('\n')
	return
}

// dgIsSingleBytes reports whether dg is a lone DT_BYTES blob.  Such a blob
// emits as a BARE top-level `[N x i8]` (e.g. a string constant @.str.<id>)
// rather than a one-element anonymous struct `{ [N x i8] }` — keeping a plain
// byte array's IR type a plain array, which is what every gep/load consumer of
// such a global expects.
func dgIsSingleBytes(dg @ir.DataGlobal) bool {
	return len(dg.Init) == 1 && dg.Init[0].Kind == ir.DT_BYTES
}

// writeDataGlobalLLTy writes the anonymous struct type `{ t0, t1, ... }`
// matching dg.Init's terms (DT_BYTES/DT_ZERO -> [N x i8], DT_INT -> iW,
// DT_SYMREF -> ptr) — or a bare `[N x i8]` for a single-DT_BYTES blob.
func writeDataGlobalLLTy(out *strings.Builder, dg @ir.DataGlobal) {
	if dgIsSingleBytes(dg) {
		writeByteArrayTy(out, len(dg.Init[0].Bytes))
		return
	}
	out.Write("{ ")
	for i := 0; i < len(dg.Init); i++ {
		if i > 0 { out.Write(", ") }
		writeDataTermLLTy(out, dg.Init[i])
	}
	out.Write(" }")
	return
}

// writeDataTermLLTy writes one term's LLVM type.
func writeDataTermLLTy(out *strings.Builder, t @ir.DataTerm) {
	if t.Kind == ir.DT_INT {
		out.WriteByte('i')
		stringutils.WriteInt(out, t.Width * 8)
	} else if t.Kind == ir.DT_SYMREF {
		out.Write("ptr")
	} else if t.Kind == ir.DT_BYTES {
		writeByteArrayTy(out, len(t.Bytes))
	} else {
		writeByteArrayTy(out, t.Width)
	}
	return
}

// writeByteArrayTy writes `[n x i8]`.
func writeByteArrayTy(out *strings.Builder, n int) {
	out.WriteByte('[')
	stringutils.WriteInt(out, n)
	out.Write(" x i8]")
	return
}

// writeBareBytesValue writes a DT_BYTES term's VALUE with no leading type, for
// a bare top-level array: `c"..."`, or `zeroinitializer` when empty.
func writeBareBytesValue(out *strings.Builder, t @ir.DataTerm) {
	if len(t.Bytes) == 0 {
		out.Write("zeroinitializer")
	} else {
		out.Write("c\"")
		emitStringBytes(out, t.Bytes)
		out.Write("\"")
	}
	return
}

// writeDataGlobalInit writes the struct initializer `{ <ty> <val>, ... }` — or
// a bare `c"..."` / `zeroinitializer` value for a single-DT_BYTES blob.
func writeDataGlobalInit(out *strings.Builder, dg @ir.DataGlobal) {
	if dgIsSingleBytes(dg) {
		writeBareBytesValue(out, dg.Init[0])
		return
	}
	out.Write("{ ")
	for i := 0; i < len(dg.Init); i++ {
		if i > 0 { out.Write(", ") }
		writeDataTermInit(out, dg.Init[i])
	}
	out.Write(" }")
	return
}

// writeDataTermInit writes one term as a `<ty> <value>` struct element.
func writeDataTermInit(out *strings.Builder, t @ir.DataTerm) {
	if t.Kind == ir.DT_INT {
		out.WriteByte('i')
		stringutils.WriteInt(out, t.Width * 8)
		out.WriteByte(' ')
		// The bits round-trip through int64; LLVM accepts the signed decimal
		// for any iN.  (Sub-8-byte terms with the high bit set would need
		// width-aware sign-extension — none arise in the current callers.)
		stringutils.WriteInt64(out, bit_cast(int64, t.IntVal))
		return
	}
	if t.Kind == ir.DT_SYMREF {
		if len(t.Sym) == 0 {
			// Empty Sym means a null pointer (e.g. an empty table slice).
			out.Write("ptr null")
		} else if t.Addend == 0 {
			out.Write("ptr @")
			out.Write(t.Sym)
		} else {
			out.Write("ptr getelementptr inbounds (i8, ptr @")
			out.Write(t.Sym)
			out.Write(", i64 ")
			stringutils.WriteInt(out, t.Addend)
			out.WriteByte(')')
		}
		return
	}
	if t.Kind == ir.DT_BYTES {
		writeByteArrayTy(out, len(t.Bytes))
		if len(t.Bytes) == 0 {
			out.Write(" zeroinitializer")
		} else {
			out.Write(" c\"")
			emitStringBytes(out, t.Bytes)
			out.Write("\"")
		}
		return
	}
	// DT_ZERO
	writeByteArrayTy(out, t.Width)
	out.Write(" zeroinitializer")
	return
}
