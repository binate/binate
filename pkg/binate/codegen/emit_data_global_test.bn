package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

// emitOneDataGlobal runs emitDataGlobal into a fresh builder and returns the text.
func emitOneDataGlobal(dg @ir.DataGlobal) @[]readonly char {
	var out @strings.Builder = strings.NewBuilder()
	emitDataGlobal(out, dg)
	return out.String()
}

// emitStringGlobal emits the byte blob + the static `.ms` managed-slice header,
// both via the shared ir.Build* builders.  Pin the `.ms`'s anonymous-struct
// shape `{ ptr, iN, ptr, iN }` (was the named %BnManagedSlice) — the data
// pointer aliases the blob, the refptr is null, and len appears in words 1 + 3.
func TestEmitStringGlobalMSHeader() testing.TestResult {
	setTarget64()
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	sc.Len = 2
	var out @strings.Builder = strings.NewBuilder()
	emitStringGlobal(out, sc)
	var got @[]readonly char = out.String()
	if !contains(got,
			"@.str.0 = private unnamed_addr constant [2 x i8] c\"hi\", align 1\n") {
		return fail("string blob def mismatch")
	}
	if !contains(got,
			"@.str.0.ms = private constant { ptr, i64, ptr, i64 } "
			"{ ptr @.str.0, i64 2, ptr null, i64 2 }, align 8\n") {
		return fail(".ms header should be an anon { ptr, iN, ptr, iN } aliasing the blob")
	}
	return ""
}

// TestEmitDataGlobalScalarsAndSymrefs pins the LLVM lowering of int + symref
// terms (incl. a +addend symref → constant GEP) and weak_odr/constant linkage.
func TestEmitDataGlobalScalarsAndSymrefs() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("g", ir.DG_WEAK, 8, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init,
		ir.DataInt(8, bit_cast(uint64, cast(int64, -5))))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("nm", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("base", 16))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 5)))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got, "@g = weak_odr constant { i64, ptr, ptr, i64 } "
			"{ i64 -5, ptr @nm, "
			"ptr getelementptr inbounds (i8, ptr @base, i64 16), i64 5 }, "
			"align 8\n") {
		return fail("emitDataGlobal scalars/symrefs mismatch")
	}
	return ""
}

// TestEmitDataGlobalBytes pins a private rodata bytes blob: a lone DT_BYTES
// emits as a BARE top-level `[N x i8]`, NOT a one-element struct `{ [N x i8] }`
// (so a plain byte array's IR type stays a plain array for gep/load consumers).
func TestEmitDataGlobalBytes() testing.TestResult {
	setTarget64()
	var bs @[]uint8 = make_slice(uint8, 3)
	bs[0] = cast(uint8, 'a')
	bs[1] = cast(uint8, 'b')
	bs[2] = cast(uint8, 'c')
	var dg @ir.DataGlobal = ir.NewDataGlobal("nm", ir.DG_LOCAL, 1, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(bs))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@nm = private constant [3 x i8] c\"abc\", align 1\n") {
		return fail("emitDataGlobal bytes mismatch")
	}
	return ""
}

// TestEmitDataGlobalStringBlob pins the string-constant blob shape: a bare
// `[N x i8]` with `unnamed_addr` (lets LLVM merge identical constants) — the
// exact form @.str.<id> migrates onto.
func TestEmitDataGlobalStringBlob() testing.TestResult {
	setTarget64()
	var bs @[]uint8 = make_slice(uint8, 2)
	bs[0] = cast(uint8, 'h')
	bs[1] = cast(uint8, 'i')
	var dg @ir.DataGlobal = ir.NewDataGlobal(".str.0", ir.DG_LOCAL, 1, true)
	dg.UnnamedAddr = true
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(bs))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@.str.0 = private unnamed_addr constant [2 x i8] c\"hi\", align 1\n") {
		return fail("string blob should be a bare unnamed_addr [N x i8]")
	}
	return ""
}

// TestEmitDataGlobalEmptyBytes pins the empty-blob bare form: `[0 x i8]
// zeroinitializer` (the zero-length-string case), NOT a struct wrapper.
func TestEmitDataGlobalEmptyBytes() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal(".str.1", ir.DG_LOCAL, 1, true)
	dg.UnnamedAddr = true
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(make_slice(uint8, 0)))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@.str.1 = private unnamed_addr constant [0 x i8] zeroinitializer, align 1\n") {
		return fail("empty string blob should be bare [0 x i8] zeroinitializer")
	}
	return ""
}

// TestEmitDataGlobalZeroMutable pins DT_ZERO + a strong (DG_GLOBAL) mutable global.
func TestEmitDataGlobalZeroMutable() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("z", ir.DG_GLOBAL, 8, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataZero(8))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@z = global { [8 x i8] } { [8 x i8] zeroinitializer }, align 8\n") {
		return fail("emitDataGlobal zero/mutable mismatch")
	}
	return ""
}

// TestEmitDataGlobalNullSymref pins the empty-Sym symref -> `ptr null` path
// (the empty-table-slice form the __Package descriptor uses).
func TestEmitDataGlobalNullSymref() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("n", ir.DG_GLOBAL, 8, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 0)))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@n = global { ptr, i64 } { ptr null, i64 0 }, align 8\n") {
		return fail("null symref should emit ptr null")
	}
	return ""
}
