package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

// emitOneDataGlobal runs emitDataGlobal into a fresh builder and returns the text.
func emitOneDataGlobal(dg @ir.DataGlobal) @[]readonly char {
	var out @strings.Builder = strings.NewBuilder()
	emitDataGlobal(out, dg)
	return out.String()
}

// TestEmitDataGlobalScalarsAndSymrefs pins the LLVM lowering of int + symref
// terms (incl. a +addend symref → constant GEP) and weak_odr/constant linkage.
func TestEmitDataGlobalScalarsAndSymrefs() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("g", ir.DG_WEAK, 8, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init,
		ir.DataInt(8, bit_cast(uint64, cast(int64, -5))))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("nm", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("base", 16))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 5)))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got, "@g = weak_odr constant { i64, ptr, ptr, i64 } "
			"{ i64 -5, ptr @nm, "
			"ptr getelementptr inbounds (i8, ptr @base, i64 16), i64 5 }, "
			"align 8\n") {
		return fail("emitDataGlobal scalars/symrefs mismatch")
	}
	return ""
}

// TestEmitDataGlobalBytes pins a private rodata bytes blob (c"..." escaping).
func TestEmitDataGlobalBytes() testing.TestResult {
	setTarget64()
	var bs @[]uint8 = make_slice(uint8, 3)
	bs[0] = cast(uint8, 'a')
	bs[1] = cast(uint8, 'b')
	bs[2] = cast(uint8, 'c')
	var dg @ir.DataGlobal = ir.NewDataGlobal("nm", ir.DG_LOCAL, 1, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(bs))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@nm = private constant { [3 x i8] } { [3 x i8] c\"abc\" }, align 1\n") {
		return fail("emitDataGlobal bytes mismatch")
	}
	return ""
}

// TestEmitDataGlobalZeroMutable pins DT_ZERO + a strong (DG_GLOBAL) mutable global.
func TestEmitDataGlobalZeroMutable() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("z", ir.DG_GLOBAL, 8, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataZero(8))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@z = global { [8 x i8] } { [8 x i8] zeroinitializer }, align 8\n") {
		return fail("emitDataGlobal zero/mutable mismatch")
	}
	return ""
}

// TestEmitDataGlobalNullSymref pins the empty-Sym symref -> `ptr null` path
// (the empty-table-slice form the _Package descriptor uses).
func TestEmitDataGlobalNullSymref() testing.TestResult {
	setTarget64()
	var dg @ir.DataGlobal = ir.NewDataGlobal("n", ir.DG_GLOBAL, 8, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 0)))
	var got @[]readonly char = emitOneDataGlobal(dg)
	if !charsEqual(got,
			"@n = global { ptr, i64 } { ptr null, i64 0 }, align 8\n") {
		return fail("null symref should emit ptr null")
	}
	return ""
}
