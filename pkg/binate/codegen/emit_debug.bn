package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Function emission
// ============================================================

// emitFuncDbg emits an LLVM function definition with optional DWARF debug annotations.
func emitFuncDbg(
		out *strings.Builder, m @ir.Module, f @ir.Func, strs *[]ir.StringConst,
		funcRetTypes *[]FuncRetType, dbgSubprogramID int) {
	if f.IsExtern {
		return
	}

	retSeq = 0
	tmpSeq = 0

	// Detect whether this function returns its single aggregate
	// result via the sret convention.  When true, the define-line
	// becomes `define void @name(ptr sret(%T) align 8 %v.retbuf,
	// <params>)` and OP_RETURN writes through %v.retbuf instead
	// of `ret %T %val`.  See round-5 audit in claude-todo.md for
	// the rationale (forcing LLVM to use sret consistently rather
	// than its per-shape pack-vs-sret heuristic).
	var useSret bool = false
	var sretRetType @[]char
	if len(f.Results) == 1 && needsSret(f.Results[0]) {
		useSret = true
		sretRetType = llvmType(f.Results[0])
	} else if multiRetNeedsSret(f) {
		// Large multi-return: route the result tuple through the same sret
		// buffer convention a single large result uses (and the native
		// backends already apply per the register-count rule), instead of a
		// raw `ret {T1,T2,…}` first-class aggregate.  OP_RETURN stores the
		// packed tuple through %v.retbuf; the buffer's pointee is the tuple
		// struct MultiReturnType.
		useSret = true
		sretRetType = llvmType(f.MultiReturnType)
	}
	currentFuncUsesSret = useSret
	currentFuncCoercedMultiRet = funcMultiRetCoerced(f)

	// define <rettype> @<name>(<params>) [!dbg !N] {
	var retTyp @[]char
	if useSret {
		retTyp = "void"
	} else if len(f.Results) == 0 {
		retTyp = "void"
	} else if len(f.Results) == 1 && aggRetCoerced(f.Results[0]) {
		// In-register aggregate result: return the coerced ABI type
		// (built into a temp builder since retTyp is a string) so this
		// LLVM callee's return registers agree with a native caller (and
		// vice versa).  x64 SSE returns the first-class `{ .. }` /
		// eightbyte aggregate (sysvReturnLLTy); every other target returns
		// the GP `[N x iW]` (aggCoerceLLTy).  OP_RETURN coerces the `%S`
		// result to the matching shape.  See emit_agg_coerce.bn /
		// emit_sysv_coerce.bn.
		var rtb @strings.Builder = strings.NewBuilder()
		if types.SysVInSse(f.Results[0]) {
			sysvReturnLLTy(rtb, f.Results[0])
		} else {
			aggCoerceLLTy(rtb, f.Results[0])
		}
		retTyp = buf.CopyStr(rtb.String())
	} else if len(f.Results) == 1 {
		retTyp = llvmType(f.Results[0])
	} else if funcMultiRetCoerced(f) {
		// Register-returned multi-return with a coercible field: return the
		// per-field-coerced tuple so LLVM register-returns it (matching the
		// native caller) instead of quirk-sret'ing a padded struct member.
		// OP_RETURN reinterprets the raw tuple to this shape.
		var rtb @strings.Builder = strings.NewBuilder()
		multiReturnCoercedLLTy(rtb, f.MultiReturnType)
		retTyp = buf.CopyStr(rtb.String())
	} else {
		retTyp = multiReturnType(f.Results)
	}

	if f.IsLinkOnce {
		// weak_odr: same merge semantics as linkonce_odr, but cannot be
		// discarded when locally unreferenced.  Required for cross-TU dtor /
		// copy helpers — at -O2 the optimizer would otherwise DCE the
		// definition in its home TU after inlining all local callers, leaving
		// extern references in other TUs unresolved.
		out.Write("define weak_odr ")
	} else {
		out.Write("define ")
	}
	out.Write(retTyp)
	out.Write(" @")
	out.Write(mangle.FuncName(modulePkgName, f.Name))
	out.WriteByte('(')

	if useSret {
		out.Write("ptr sret(")
		out.Write(sretRetType)
		out.Write(") align 8 %v.retbuf")
		if len(f.Params) > 0 {
			out.Write(", ")
		}
	}
	var defArgTypes @[]@types.Type = defineArgTypes(f, useSret)
	var defSretOff int = 0
	if useSret {
		defSretOff = 1
	}
	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out.Write(", ")
		}
		writeDefineParam(out, f, i, defArgTypes, defSretOff)
	}

	if dbgSubprogramID >= 0 {
		out.Write(") !dbg !")
		stringutils.WriteInt(out, dbgSubprogramID)
		out.Write(" {\n")
	} else {
		out.Write(") {\n")
	}

	// Build function body with per-instruction debug locations.  Every
	// alloca is hoisted to the top of the entry block (emitEntryAllocaDecls)
	// so an alloca emitted inside a loop body / if-branch doesn't leak
	// native stack per execution; the rest of each lowering stays in place.
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		if i > 0 {
			out.WriteByte('\n')
		}
		out.Write(blk.Label)
		out.Write(":\n")
		if i == 0 {
			emitEntryAllocaDecls(out, f, dbgSubprogramID, funcRetTypes)
			// Reconstruct each coerced in-register-aggregate param's
			// `%S` value from its incoming `[N x iW]` words, at the
			// top of the entry block (before any body reference to
			// `%vID`).  The `.agp` alloca + the store/load prologue
			// share the same slot.  See emit_agg_coerce.bn.
			emitAggParamCoercion(out, f)
		}
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if dbgSubprogramID >= 0 {
				var line int = instr.Line
				if line <= 0 { line = 1 }
				// Emit into a temp builder, then splice !dbg into EVERY
				// instruction line as the snapshot is appended to out
				// (Builder is append-only — annotate a snapshot rather
				// than backing up over out).  emitInstr can emit more
				// than one line — an sret OP_CALL emits the
				// `call void @f(...)` plus the result `load`, and each
				// inlinable call in a debug-info function must carry a
				// !dbg or LLVM discards the whole module's debug info.
				// Ops that emit no instruction text (OP_SP_RESTORE) or
				// only an indent (an empty struct/array OP_ALLOC — no
				// fields to zero) leave no annotated line; labels too.
				var tmp @strings.Builder = strings.NewBuilder()
				emitInstr(tmp, m, instr, strs, funcRetTypes)
				annotateInstrDbg(out, buf.CopyStr(tmp.String()), line, dbgSubprogramID)
				// Emit llvm.dbg.declare for named allocas
				if instr.Op == iropcode.OP_ALLOC && len(instr.StrVal) > 0 {
					emitDbgDeclare(out, instr, dbgSubprogramID, line)
				}
			} else {
				emitInstr(out, m, instr, strs, funcRetTypes)
			}
		}
	}

	out.Write("}\n")
	return
}

// addDbgToLastLine appends `seg` to out, replacing the trailing newline of
// seg's (single) last line with ", !dbg !DILocation(line: N, scope: !M)\n".
//
// Skips the annotation (appends seg verbatim) if the last line is a basic-block
// label declaration (ends with ':') — `!dbg` metadata is only valid on
// instructions, not labels. Multi-line emitters that end on a label
// (e.g. emitRefIncInline, emitRefDecInline) leave that label
// un-annotated; intermediate instructions in such emissions also
// lack `!dbg` (LLVM tolerates this — the surrounding DISubprogram
// is enough metadata for the IR to be valid; only source-line
// attribution within those sites is lost).
func addDbgToLastLine(out *strings.Builder, seg *[]readonly char, line int, scopeID int) {
	var n int = len(seg)
	if n == 0 {
		return
	}
	// seg ends with '\n' from emitInstr.  If the char before it is ':',
	// the last line is a label declaration — append verbatim, no !dbg.
	if n >= 2 && seg[n - 2] == ':' {
		out.Write(seg)
		return
	}
	// Append everything except the final '\n', then the dbg suffix + '\n'.
	out.Write(seg[0:n - 1])
	out.Write(", !dbg !DILocation(line: ")
	stringutils.WriteInt(out, line)
	out.Write(", scope: !")
	stringutils.WriteInt(out, scopeID)
	out.Write(")\n")
}

// annotateInstrDbg appends `seg` (one IR instruction's emitted text) to out,
// splicing ", !dbg !DILocation(line, scope)" before the newline of EVERY
// instruction line in it.  emitInstr can emit several lines: an sret OP_CALL
// emits the `call void @f(...)` then the result `load`, and each inlinable call
// in a debug-info function must carry a !dbg or LLVM discards the whole module's
// debug info — so all of them are annotated, not just the last (the prior
// per-only-last-line behavior left the sret call bare).  Block labels and empty
// / indent-only lines (an op that emitted no instruction text) are left
// un-annotated, since !dbg on a non-instruction line dangles and clang rejects
// it.  The caller passes seg as a snapshot (Builder is append-only), so out and
// seg never alias.
func annotateInstrDbg(out *strings.Builder, seg *[]readonly char, line int, scopeID int) {
	if len(seg) == 0 {
		return
	}
	var ref @strings.Builder = strings.NewBuilder()
	ref.Write(", !dbg !DILocation(line: ")
	stringutils.WriteInt(ref, line)
	ref.Write(", scope: !")
	stringutils.WriteInt(ref, scopeID)
	ref.WriteByte(')')
	addDbgAnnotations(out, seg, buf.CopyStr(ref.String()))
}

// emitDbgDeclare emits a call to @llvm.dbg.declare for a named alloca.
// For parameter allocas (instr.ParamIndex > 0), the DILocalVariable
// gets `arg: <N>` so lldb shows the var as a function argument; for
// regular locals the field is omitted.
func emitDbgDeclare(out *strings.Builder, instr @ir.Instr, scopeID int, line int) {
	// call void @llvm.dbg.declare(metadata <type>* %vN,
	//   metadata !DILocalVariable(...),
	//   metadata !DIExpression()), !dbg !DILocation(...)
	var allocTyp @[]char = llvmType(instr.TypeArg)
	out.Write("  call void @llvm.dbg.declare(metadata ")
	out.Write(allocTyp)
	out.Write("* ")
	emitRef(out, instr.ID)
	out.Write(", metadata !DILocalVariable(name: \"")
	out.Write(instr.StrVal)
	out.Write("\"")
	if instr.ParamIndex > 0 {
		out.Write(", arg: ")
		stringutils.WriteInt(out, instr.ParamIndex)
	}
	out.Write(", scope: !")
	stringutils.WriteInt(out, scopeID)
	out.Write(", file: !3, line: ")
	stringutils.WriteInt(out, line)
	out.Write(", type: !")
	stringutils.WriteInt(out, dbgTypeID(instr.TypeArg))
	out.WriteByte(')')
	out.Write(", metadata !DIExpression())")
	out.Write(", !dbg !DILocation(line: ")
	stringutils.WriteInt(out, line)
	out.Write(", scope: !")
	stringutils.WriteInt(out, scopeID)
	out.Write(")\n")
	return
}

// dbgFuncIDBase is the metadata-id offset where per-function DISubprogram /
// DILocation pairs start. Slots !0..!4 are CU/flags/file/subroutine-type;
// !5..!(dbgFuncIDBase-1) are DIBasicType slots emitted by emitDebugMetadata.
const dbgFuncIDBase int = 16

// dbgTypeID returns the metadata-id of the DI node that describes
// the given type.  Scalar kinds (bool, signed/unsigned int widths,
// floats) live in the fixed !5..!15 bank; pointer and struct types
// are interned into a per-module registry (see emit_debug_types.bn)
// and assigned ids past the per-function metadata block.  Kinds
// not yet handled fall back to !5 (the legacy "int" slot).
//
// Scalar slot layout:
//   !5  int    (signed 64) — also the non-scalar fallback
//   !6  int8
//   !7  int16
//   !8  int32
//   !9  uint   (unsigned 64)
//   !10 uint8  (also char / byte)
//   !11 uint16
//   !12 uint32
//   !13 float32
//   !14 float64
//   !15 bool
func dbgTypeID(t @types.Type) int {
	if t == nil { return 5 }
	var s int = dbgScalarSlot(t)
	if s >= 0 { return s }
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgPointer(t, key)
	}
	if t.Kind == types.TYP_STRUCT {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgStruct(t, key)
	}
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgSlice(t, key)
	}
	if t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgIfaceValue(t, key)
	}
	if t.Kind == types.TYP_FUNC_VALUE || t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgFuncValue(t, key)
	}
	if t.Kind == types.TYP_ARRAY {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgArray(t, key)
	}
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		var key @[]char = dbgTypeKey(t)
		var existing int = lookupDbgType(key)
		if existing >= 0 { return existing }
		return internDbgNamed(t, key)
	}
	return 5
}

// addDbgAnnotations inserts dbgRef (e.g., ", !dbg !DILocation(...)") before the
// newline on every instruction line in body, writing the result into out.  An
// instruction line is space-indented AND has at least one non-space character;
// block labels (no leading space) and whitespace-only lines (an op that emitted
// only emitInstr's indent — e.g. an empty struct/array OP_ALLOC) are copied
// through un-annotated, since a !dbg on a non-instruction line dangles and clang
// rejects it.
func addDbgAnnotations(out *strings.Builder, body *[]readonly char, dbgRef *[]readonly char) {
	var lineStart int = 0
	for i := 0; i < len(body); i++ {
		if body[i] == '\n' {
			out.Write(body[lineStart:i])
			if lineIsInstr(body, lineStart, i) {
				out.Write(dbgRef)
			}
			out.WriteByte('\n')
			lineStart = i + 1
		}
	}
	// Copy any trailing content without newline (e.g. emitInstr's stray
	// indent for a no-text op); never annotated, since it carries no newline.
	if lineStart < len(body) {
		out.Write(body[lineStart:len(body)])
	}
	return
}

// lineIsInstr reports whether body[start:end) is an instruction line — space-
// indented with at least one non-space character.  A whitespace-only line (just
// emitInstr's "  " indent, from an op that emitted no instruction text) is not
// an instruction, so it must not receive a dangling !dbg.
func lineIsInstr(body *[]readonly char, start int, end int) bool {
	if start >= end || body[start] != ' ' {
		return false
	}
	for k := start; k < end; k++ {
		if body[k] != ' ' {
			return true
		}
	}
	return false
}

// emitDebugMetadata appends DWARF debug metadata nodes to the module output.
// Uses LineTablesOnly emission for lightweight function-level debug info.
func emitDebugMetadata(out *strings.Builder, m @ir.Module, dbgFuncIDs *[]int,
		dbgFuncSubrTypeIDs *[]int) {
	var modName *[]readonly char = stripQuotes(m.Name)

	// Named metadata
	out.Write("!llvm.dbg.cu = !{!0}\n")
	out.Write("!llvm.module.flags = !{!1, !2}\n\n")

	// !0 = DICompileUnit
	out.Write("!0 = distinct !DICompileUnit(")
	out.Write("language: DW_LANG_C99, file: !3, ")
	out.Write("producer: \"binate\", ")
	out.Write("isOptimized: false, ")
	out.Write("runtimeVersion: 0, ")
	out.Write("emissionKind: FullDebug)\n")

	// !1 = Dwarf Version flag
	out.Write("!1 = !{i32 7, !\"Dwarf Version\", i32 4}\n")

	// !2 = Debug Info Version flag
	out.Write("!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n")

	// !3 = DIFile
	out.Write("!3 = !DIFile(filename: \"")
	out.Write(modName)
	out.Write(".bn\", directory: \".\")\n")

	// !4 = DISubroutineType (shared, generic)
	out.Write("!4 = !DISubroutineType(types: !{})\n")

	// !5..!15 = DIBasicType slots for each scalar kind (see dbgTypeID
	// for the slot assignment). Slot !5 doubles as the fallback for
	// non-scalar TypeArgs until step 4 of the DWARF type-coverage work
	// lands DICompositeType / DIDerivedType.
	out.Write("!5 = !DIBasicType(name: \"int\", size: 64, encoding: DW_ATE_signed)\n")
	out.Write("!6 = !DIBasicType(name: \"int8\", size: 8, encoding: DW_ATE_signed)\n")
	out.Write("!7 = !DIBasicType(name: \"int16\", size: 16, encoding: DW_ATE_signed)\n")
	out.Write("!8 = !DIBasicType(name: \"int32\", size: 32, encoding: DW_ATE_signed)\n")
	out.Write("!9 = !DIBasicType(name: \"uint\", size: 64, encoding: DW_ATE_unsigned)\n")
	out.Write("!10 = !DIBasicType(name: \"uint8\", ")
	out.Write("size: 8, encoding: DW_ATE_unsigned_char)\n")
	out.Write("!11 = !DIBasicType(name: \"uint16\", size: 16, encoding: DW_ATE_unsigned)\n")
	out.Write("!12 = !DIBasicType(name: \"uint32\", size: 32, encoding: DW_ATE_unsigned)\n")
	out.Write("!13 = !DIBasicType(name: \"float32\", size: 32, encoding: DW_ATE_float)\n")
	out.Write("!14 = !DIBasicType(name: \"float64\", size: 64, encoding: DW_ATE_float)\n")
	out.Write("!15 = !DIBasicType(name: \"bool\", size: 8, encoding: DW_ATE_boolean)\n")

	// Emit DISubprogram + DILocation for each non-extern function
	for i := 0; i < len(m.Funcs); i++ {
		if dbgFuncIDs[i] < 0 {
			continue
		}
		var f @ir.Func = m.Funcs[i]
		var spID int = dbgFuncIDs[i]
		var locID int = spID + 1

		// DISubprogram. f.Line is the source line of the func decl
		// (1-based; 0 for synthetic dtors / init / entry wrappers
		// that have no source position).  type: references the
		// per-function DISubroutineType (signature-specific) when
		// available, else !4 (the legacy shared empty placeholder).
		var subrTypeID int = 4
		if i < len(dbgFuncSubrTypeIDs) && dbgFuncSubrTypeIDs[i] >= 0 {
			subrTypeID = dbgFuncSubrTypeIDs[i]
		}
		out.WriteByte('!')
		stringutils.WriteInt(out, spID)
		out.Write(" = distinct !DISubprogram(name: \"")
		out.Write(f.Name)
		out.Write("\", linkageName: \"")
		out.Write(mangle.FuncName(modulePkgName, f.Name))
		out.Write("\", scope: !3, file: !3, ")
		out.Write("line: ")
		stringutils.WriteInt(out, f.Line)
		out.Write(", type: !")
		stringutils.WriteInt(out, subrTypeID)
		out.Write(", scopeLine: ")
		stringutils.WriteInt(out, f.Line)
		out.Write(", spFlags: DISPFlagDefinition, ")
		out.Write("unit: !0)\n")

		// DILocation entries are now emitted inline on each instruction.
		// Keep the metadata slot reserved for ID numbering consistency.
		out.WriteByte('!')
		stringutils.WriteInt(out, locID)
		out.Write(" = !DILocation(line: 0, scope: !")
		stringutils.WriteInt(out, spID)
		out.Write(")\n")
	}

	// Non-scalar DI nodes (DIDerivedType for pointers, DICompositeType
	// for structs).  IDs were allocated past the per-function block
	// during function emission; see emit_debug_types.bn.
	emitDbgTypeNodes(out)

	// Per-function DISubroutineType + types-tuple nodes (step 7).
	emitDbgFuncSubroutineTypes(out, m, dbgFuncSubrTypeIDs)

	return
}

// ============================================================
// Instruction emission
// ============================================================
