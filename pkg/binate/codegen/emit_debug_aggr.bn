package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// DWARF type-coverage step 5 — extends the registry from
// emit_debug_types.bn (pointers + structs) to slices, interface
// values, function values, arrays, and named typedefs.  Each
// kind has an intern* helper that allocates ids and registers an
// entry, and an emitDbg*Node helper that writes the DI metadata
// at the end of EmitModule.  emitDbgTypeNodes (in
// emit_debug_types.bn) dispatches on Kind.

// internDbgSlice registers a `*[]T` or `@[]T` slice type.  Raw
// slices are 2-word { ptr, len }, managed-slices are 4-word
// { ptr, len, refptr, refbacking_len }.  Member ids are
// pre-allocated.  The element type is interned so the ptr field
// can reference its DI node (via a synthetic `*Elem` pointer).
func internDbgSlice(t @types.Type, key @[]char) int {
	var id int = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var nFields int = 2
	if t.Kind == types.TYP_MANAGED_SLICE { nFields = 4 }
	var memberIDs @[]int = make_slice(int, nFields)
	for i := 0; i < nFields; i++ {
		memberIDs[i] = nextDbgTypeID
		nextDbgTypeID = nextDbgTypeID + 1
	}
	var e dbgTypeEntry
	e.Key = key
	e.ID = id
	e.MemberIDs = memberIDs
	e.Typ = t
	dbgTypeRegistry = slices.Append[dbgTypeEntry](dbgTypeRegistry, e)
	// Eagerly intern an element-typed pointer for the ptr member.
	dbgTypeID(types.MakePointerType(t.Elem))
	return id
}

// internDbgIfaceValue registers a `*Iface` or `@Iface` interface
// value (2-word { data, vtable } — both i8*).  Both raw and
// managed forms have the same layout; the registry distinguishes
// them by key (manage-ness prefix) so lldb shows the right name.
func internDbgIfaceValue(t @types.Type, key @[]char) int {
	var id int = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var memberIDs @[]int = make_slice(int, 2)
	memberIDs[0] = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	memberIDs[1] = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var entry dbgTypeEntry
	entry.Key = key
	entry.ID = id
	entry.MemberIDs = memberIDs
	entry.Typ = t
	dbgTypeRegistry = slices.Append[dbgTypeEntry](dbgTypeRegistry, entry)
	return id
}

// internDbgFuncValue registers a `*func(...)` or `@func(...)`
// function value (2-word { vtable, data } — both i8*).
func internDbgFuncValue(t @types.Type, key @[]char) int {
	var id int = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var memberIDs @[]int = make_slice(int, 2)
	memberIDs[0] = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	memberIDs[1] = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var entry dbgTypeEntry
	entry.Key = key
	entry.ID = id
	entry.MemberIDs = memberIDs
	entry.Typ = t
	dbgTypeRegistry = slices.Append[dbgTypeEntry](dbgTypeRegistry, entry)
	return id
}

// internDbgArray registers a `[N]T` array.  DICompositeType
// DW_TAG_array_type has no member nodes — the count goes into a
// DISubrange in the elements list, emitted inline at node-emit
// time.  The element type is interned eagerly so its id is
// resolvable when the array node is written.
func internDbgArray(t @types.Type, key @[]char) int {
	var id int = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var entry dbgTypeEntry
	entry.Key = key
	entry.ID = id
	entry.Typ = t
	dbgTypeRegistry = slices.Append[dbgTypeEntry](dbgTypeRegistry, entry)
	dbgTypeID(t.Elem)
	return id
}

// internDbgNamed registers a named distinct type (`type T U`).
// DIDerivedType DW_TAG_typedef sits over the underlying's DI
// node — no extra member ids.
func internDbgNamed(t @types.Type, key @[]char) int {
	var id int = nextDbgTypeID
	nextDbgTypeID = nextDbgTypeID + 1
	var entry dbgTypeEntry
	entry.Key = key
	entry.ID = id
	entry.Typ = t
	dbgTypeRegistry = slices.Append[dbgTypeEntry](dbgTypeRegistry, entry)
	dbgTypeID(t.Underlying)
	return id
}

// emitDbgSliceNode emits a DICompositeType DW_TAG_structure_type
// describing the runtime slice layout: { ptr, len } for raw,
// { ptr, len, refptr, refbacking_len } for managed.  ptr's
// baseType is `*Elem` (synthetic; interned during internDbgSlice);
// the rest are i64 / i8*.
func emitDbgSliceNode(out *buf.Builder, e dbgTypeEntry) {
	var t @types.Type = e.Typ
	var isManaged bool = t.Kind == types.TYP_MANAGED_SLICE
	var sizeBits int
	if isManaged { sizeBits = 256 } else { sizeBits = 128 }
	var ptrTypeID int = dbgTypeID(types.MakePointerType(t.Elem))
	// Member 0: ptr (offset 0, 64 bits).
	emitDbgMember(out, e.MemberIDs[0], "ptr", e.ID, ptrTypeID, 64, 0)
	// Member 1: len (offset 64, 64 bits, scalar slot 5 = int).
	emitDbgMember(out, e.MemberIDs[1], "len", e.ID, 5, 64, 64)
	if isManaged {
		// Member 2: refptr (offset 128, 64 bits).  baseType !5 — DWARF
		// just needs SOMETHING here; the runtime treats this as i8*
		// but lldb has no use for that distinction.
		emitDbgMember(out, e.MemberIDs[2], "refptr", e.ID, 5, 64, 128)
		// Member 3: refbacking_len (offset 192, 64 bits).
		emitDbgMember(out, e.MemberIDs[3], "refbacking_len",
			e.ID, 5, 64, 192)
	}
	out.WriteByte('!')
	buf.WriteInt(out, e.ID)
	out.Write(" = !DICompositeType(tag: DW_TAG_structure_type, name: \"")
	out.Write(e.Key)
	out.Write("\", file: !3, size: ")
	buf.WriteInt(out, sizeBits)
	out.Write(", elements: !{")
	for i := 0; i < len(e.MemberIDs); i++ {
		if i > 0 { out.Write(", ") }
		out.WriteByte('!')
		buf.WriteInt(out, e.MemberIDs[i])
	}
	out.Write("})\n")
	return
}

// emitDbgIfaceValueNode emits a DICompositeType for an interface
// value (2-word { data, vtable } — both i8*).  The interface's
// declared name (e.g. Stringer) goes into the composite's name
// so lldb shows `*Stringer` / `@Stringer` rather than an opaque
// pair of pointers.
func emitDbgIfaceValueNode(out *buf.Builder, e dbgTypeEntry) {
	emitDbgMember(out, e.MemberIDs[0], "data", e.ID, 5, 64, 0)
	emitDbgMember(out, e.MemberIDs[1], "vtable", e.ID, 5, 64, 64)
	out.WriteByte('!')
	buf.WriteInt(out, e.ID)
	out.Write(" = !DICompositeType(tag: DW_TAG_structure_type, name: \"")
	out.Write(e.Key)
	out.Write("\", file: !3, size: 128, elements: !{!")
	buf.WriteInt(out, e.MemberIDs[0])
	out.Write(", !")
	buf.WriteInt(out, e.MemberIDs[1])
	out.Write("})\n")
	return
}

// emitDbgFuncValueNode emits a DICompositeType for a function
// value (2-word { vtable, data } — both i8*).
func emitDbgFuncValueNode(out *buf.Builder, e dbgTypeEntry) {
	emitDbgMember(out, e.MemberIDs[0], "vtable", e.ID, 5, 64, 0)
	emitDbgMember(out, e.MemberIDs[1], "data", e.ID, 5, 64, 64)
	out.WriteByte('!')
	buf.WriteInt(out, e.ID)
	out.Write(" = !DICompositeType(tag: DW_TAG_structure_type, name: \"")
	out.Write(e.Key)
	out.Write("\", file: !3, size: 128, elements: !{!")
	buf.WriteInt(out, e.MemberIDs[0])
	out.Write(", !")
	buf.WriteInt(out, e.MemberIDs[1])
	out.Write("})\n")
	return
}

// emitDbgArrayNode emits a DICompositeType DW_TAG_array_type
// node.  The element type is referenced via `baseType:`; the
// length goes into an inline DISubrange in the elements list.
func emitDbgArrayNode(out *buf.Builder, e dbgTypeEntry) {
	var t @types.Type = e.Typ
	var sizeBits int = t.SizeOf() * 8
	out.WriteByte('!')
	buf.WriteInt(out, e.ID)
	out.Write(" = !DICompositeType(tag: DW_TAG_array_type, baseType: !")
	buf.WriteInt(out, dbgTypeID(t.Elem))
	out.Write(", size: ")
	buf.WriteInt(out, sizeBits)
	out.Write(", elements: !{!DISubrange(count: ")
	buf.WriteInt(out, t.ArrayLen)
	out.Write(")})\n")
	return
}

// emitDbgNamedNode emits a DIDerivedType DW_TAG_typedef adding a
// language-level alias name on top of the underlying type's DI
// node.
func emitDbgNamedNode(out *buf.Builder, e dbgTypeEntry) {
	out.WriteByte('!')
	buf.WriteInt(out, e.ID)
	out.Write(" = !DIDerivedType(tag: DW_TAG_typedef, name: \"")
	out.Write(e.Typ.Name)
	out.Write("\", file: !3, baseType: !")
	buf.WriteInt(out, dbgTypeID(e.Typ.Underlying))
	out.Write(")\n")
	return
}

// emitDbgMember writes one DW_TAG_member DIDerivedType node.
// Shared by the slice / interface-value / function-value emitters.
func emitDbgMember(out *buf.Builder, id int, name *[]readonly char,
	scopeID int, baseTypeID int, sizeBits int, offsetBits int) {
	out.WriteByte('!')
	buf.WriteInt(out, id)
	out.Write(" = !DIDerivedType(tag: DW_TAG_member, name: \"")
	out.Write(name)
	out.Write("\", scope: !")
	buf.WriteInt(out, scopeID)
	out.Write(", file: !3, baseType: !")
	buf.WriteInt(out, baseTypeID)
	out.Write(", size: ")
	buf.WriteInt(out, sizeBits)
	out.Write(", offset: ")
	buf.WriteInt(out, offsetBits)
	out.Write(")\n")
	return
}
