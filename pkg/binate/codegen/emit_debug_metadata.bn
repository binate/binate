package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// emitDebugMetadata appends DWARF debug metadata nodes to the module output.
// Uses LineTablesOnly emission for lightweight function-level debug info.
func emitDebugMetadata(out *strings.Builder, m @ir.Module, dbgFuncIDs *[]int,
		dbgFuncSubrTypeIDs *[]int) {
	var modName *[]readonly char = stripQuotes(m.Name)

	// Named metadata
	out.Write("!llvm.dbg.cu = !{!0}\n")
	out.Write("!llvm.module.flags = !{!1, !2}\n\n")

	// !0 = DICompileUnit
	out.Write("!0 = distinct !DICompileUnit(")
	out.Write("language: DW_LANG_C99, file: !3, ")
	out.Write("producer: \"binate\", ")
	out.Write("isOptimized: false, ")
	out.Write("runtimeVersion: 0, ")
	out.Write("emissionKind: FullDebug)\n")

	// !1 = Dwarf Version flag
	out.Write("!1 = !{i32 7, !\"Dwarf Version\", i32 4}\n")

	// !2 = Debug Info Version flag
	out.Write("!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n")

	// !3 = DIFile
	out.Write("!3 = !DIFile(filename: \"")
	out.Write(modName)
	out.Write(".bn\", directory: \".\")\n")

	// !4 = DISubroutineType (shared, generic)
	out.Write("!4 = !DISubroutineType(types: !{})\n")

	// !5..!15 = DIBasicType slots for each scalar kind (see dbgTypeID
	// for the slot assignment). Slot !5 doubles as the fallback for
	// non-scalar TypeArgs until step 4 of the DWARF type-coverage work
	// lands DICompositeType / DIDerivedType.
	out.Write("!5 = !DIBasicType(name: \"int\", size: 64, encoding: DW_ATE_signed)\n")
	out.Write("!6 = !DIBasicType(name: \"int8\", size: 8, encoding: DW_ATE_signed)\n")
	out.Write("!7 = !DIBasicType(name: \"int16\", size: 16, encoding: DW_ATE_signed)\n")
	out.Write("!8 = !DIBasicType(name: \"int32\", size: 32, encoding: DW_ATE_signed)\n")
	out.Write("!9 = !DIBasicType(name: \"uint\", size: 64, encoding: DW_ATE_unsigned)\n")
	out.Write("!10 = !DIBasicType(name: \"uint8\", ")
	out.Write("size: 8, encoding: DW_ATE_unsigned_char)\n")
	out.Write("!11 = !DIBasicType(name: \"uint16\", size: 16, encoding: DW_ATE_unsigned)\n")
	out.Write("!12 = !DIBasicType(name: \"uint32\", size: 32, encoding: DW_ATE_unsigned)\n")
	out.Write("!13 = !DIBasicType(name: \"float32\", size: 32, encoding: DW_ATE_float)\n")
	out.Write("!14 = !DIBasicType(name: \"float64\", size: 64, encoding: DW_ATE_float)\n")
	out.Write("!15 = !DIBasicType(name: \"bool\", size: 8, encoding: DW_ATE_boolean)\n")

	// Emit DISubprogram + DILocation for each non-extern function
	for i := 0; i < len(m.Funcs); i++ {
		if dbgFuncIDs[i] < 0 {
			continue
		}
		var f @ir.Func = m.Funcs[i]
		var spID int = dbgFuncIDs[i]
		var locID int = spID + 1

		// DISubprogram. f.Line is the source line of the func decl
		// (1-based; 0 for synthetic dtors / init / entry wrappers
		// that have no source position).  type: references the
		// per-function DISubroutineType (signature-specific) when
		// available, else !4 (the legacy shared empty placeholder).
		var subrTypeID int = 4
		if i < len(dbgFuncSubrTypeIDs) && dbgFuncSubrTypeIDs[i] >= 0 {
			subrTypeID = dbgFuncSubrTypeIDs[i]
		}
		out.WriteByte('!')
		stringutils.WriteInt(out, spID)
		out.Write(" = distinct !DISubprogram(name: \"")
		out.Write(f.Name)
		out.Write("\", linkageName: \"")
		out.Write(mangle.FuncName(modulePkgName, f.Name))
		out.Write("\", scope: !3, file: !3, ")
		out.Write("line: ")
		stringutils.WriteInt(out, f.Line)
		out.Write(", type: !")
		stringutils.WriteInt(out, subrTypeID)
		out.Write(", scopeLine: ")
		stringutils.WriteInt(out, f.Line)
		out.Write(", spFlags: DISPFlagDefinition, ")
		out.Write("unit: !0)\n")

		// DILocation entries are now emitted inline on each instruction.
		// Keep the metadata slot reserved for ID numbering consistency.
		out.WriteByte('!')
		stringutils.WriteInt(out, locID)
		out.Write(" = !DILocation(line: 0, scope: !")
		stringutils.WriteInt(out, spID)
		out.Write(")\n")
	}

	// Non-scalar DI nodes (DIDerivedType for pointers, DICompositeType
	// for structs).  IDs were allocated past the per-function block
	// during function emission; see emit_debug_types.bn.
	emitDbgTypeNodes(out)

	// Per-function DISubroutineType + types-tuple nodes (step 7).
	emitDbgFuncSubroutineTypes(out, m, dbgFuncSubrTypeIDs)

	return
}

// ============================================================
// Instruction emission
// ============================================================
