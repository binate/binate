package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// isParamSlotSetup reports whether instr sets up a parameter's frame slot, a part
// of the function's prologue: the slot itself (whose lowering zero-fills an
// aggregate's slot) or the store of the parameter into it.  A store of the
// parameter's value elsewhere (into a local, once an optimization has forwarded the
// slot's loads to the parameter) is the body's.
func isParamSlotSetup(instr @ir.Instr) bool {
	if instr.Op == iropcode.OP_ALLOC { return instr.ParamIndex > 0 }
	return instr.Op == iropcode.OP_STORE && len(instr.Args) == 2 && instr.Args[0] != nil &&
			instr.Args[0].Op == iropcode.OP_ALLOC && instr.Args[0].ParamIndex > 0 && instr.Args[1] != nil &&
			instr.Args[1].Op == iropcode.OP_PARAM
}

// annotateParamSlotSetupDbg appends seg, the lowering of a parameter slot's setup,
// to out without source locations, as clang emits a C function's parameter stores:
// LLVM then puts the function's first location -- where a debugger stops for a
// breakpoint on the function, and for one on its first statement's line -- after
// the setup, with the parameters in their slots.  A call of a function (not an
// intrinsic's, such as llvm.memcpy) must have a location, so it gets line 0, which
// LLVM reads as code of no source line and does not take for that first location.
func annotateParamSlotSetupDbg(out *strings.Builder, seg *[]readonly char, scopeID int) {
	var ref @strings.Builder = strings.NewBuilder()
	ref.Write(", !dbg !DILocation(line: 0, scope: !")
	stringutils.WriteInt(ref, scopeID)
	ref.WriteByte(')')
	var lineStart int = 0
	for i := 0; i < len(seg); i++ {
		if seg[i] == '\n' {
			out.Write(seg[lineStart:i])
			if lineCallsFunction(seg[lineStart:i]) { out.Write(ref.String()) }
			out.WriteByte('\n')
			lineStart = i + 1
		}
	}
	out.Write(seg[lineStart:len(seg)])
	return
}

// lineCallsFunction reports whether an instruction line calls a function rather
// than an LLVM intrinsic: it holds `call ` and its callee is not `@llvm.`.
func lineCallsFunction(line *[]readonly char) bool {
	for i := 0; i < len(line); i++ {
		if textAt(line, i, "call ") {
			for j := i + 5; j < len(line); j++ {
				if line[j] == '@' { return !textAt(line, j + 1, "llvm.") }
			}
			return false
		}
	}
	return false
}

// textAt reports whether s[at:] begins with text.
func textAt(s *[]readonly char, at int, text *[]readonly char) bool {
	if at + len(text) > len(s) { return false }
	for k := 0; k < len(text); k++ {
		if s[at + k] != text[k] { return false }
	}
	return true
}
