package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_debug_param.bn.

// funcText returns the text of the function whose define line holds name, through
// its closing brace, or an empty slice.
func funcText(out *[]readonly char, name *[]readonly char) *[]readonly char {
	var start int = -1
	var lineStart int = 0
	for i := 0; i < len(out); i++ {
		if out[i] != '\n' { continue }
		var line *[]readonly char = out[lineStart:i]
		if start < 0 && textAt(line, 0, "define ") && contains(line, name) { start = lineStart }
		if start >= 0 && len(line) == 1 && line[0] == '}' { return out[start:i] }
		lineStart = i + 1
	}
	return out[0:0]
}

// linesWith counts the lines of text holding needle, and those of them also holding
// mark.
func linesWith(text *[]readonly char, needle *[]readonly char, mark *[]readonly char) (int, int) {
	var n int = 0
	var marked int = 0
	var start int = 0
	for i := 0; i <= len(text); i++ {
		if i == len(text) || text[i] == '\n' {
			var line *[]readonly char = text[start:i]
			if contains(line, needle) {
				n++
				if contains(line, mark) { marked++ }
			}
			start = i + 1
		}
	}
	return n, marked
}

// With -g, the setup of a parameter's slot -- an aggregate slot's zero-fill and the
// stores of the parameter into it -- takes no location: the declaration's line 6
// locates only the parameters' variables and slots (an alloca, which emits no code),
// and the first statement keeps its line 7.
func TestEmitDebugParamSlotSetupHasNoLocation() testing.TestResult {
	SetDebugInfo(true)
	var src *[]readonly char = "package \"main\"\n"
			"type P struct {\n"
			"\ta int\n"
			"\tb int\n"
			"}\n"
			"func helper(n int, p P) int {\n"
			"\tvar x int = n + p.a\n"
			"\treturn x\n"
			"}\n"
			"func main() { _ = helper(1, P{a: 2, b: 3}) }\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	var body *[]readonly char = funcText(out, "helper")
	if len(body) == 0 { return fail("no helper in the output") }
	located, declares := linesWith(body, "!DILocation(line: 6, scope:", "llvm.dbg.declare")
	_, slots := linesWith(body, "!DILocation(line: 6, scope:", " = alloca ")
	if located != declares + slots || declares != 2 {
		return fail(buf.Concat("only the parameters' declarations are on line 6:\n", body))
	}
	nVar, nLine6 := linesWith(body, "DILocalVariable(name: \"n\", arg: 1,", "file: !3, line: 6, type:")
	pVar, pLine6 := linesWith(body, "DILocalVariable(name: \"p\", arg: 2,", "file: !3, line: 6, type:")
	if nVar != 1 || pVar != 1 || nLine6 != 1 || pLine6 != 1 {
		return fail(
				buf.Concat("the parameters' variables are declared on the function's line 6:\n", body))
	}
	if !contains(body, "!DILocation(line: 7, scope:") {
		return fail("the first statement's code must keep its line 7")
	}
	return ""
}

// Once an optimization forwards a parameter slot's loads to the parameter, a body
// statement's store of the parameter's value is the body's, and keeps its line 4.
func TestEmitDebugBodyStoreOfParamKeepsLine() testing.TestResult {
	SetDebugInfo(true)
	var src *[]readonly char = "package \"main\"\n"
			"func fill(n int, i int) int {\n"
			"\tvar a [4]int\n"
			"\ta[1] = n\n"
			"\treturn a[i]\n"
			"}\n"
			"func main() { _ = fill(7, 1) }\n"
	var out @[]char = compileToLLVMOpt(src, 1)
	SetDebugInfo(false)
	var body *[]readonly char = funcText(out, "fill")
	_, onLine4 := linesWith(body, "store i64 %v0, ", "!DILocation(line: 4, scope:")
	if onLine4 != 1 {
		return fail(buf.Concat("the store of n into a[1] must keep its line 4:\n", body))
	}
	return ""
}

// Within a slot setup's lowering only a call of a function gets a location, line 0:
// LLVM requires one there, and an intrinsic's call needs none.
func TestAnnotateParamSlotSetupDbgLocatesOnlyCalls() testing.TestResult {
	var seg *[]readonly char = "  %a = load i64, i64* %v3\n"
			"  call void @llvm.memcpy.p0.p0.i64(ptr %d, ptr %s, i64 64, i1 false)\n"
			"  call void @bn_rt_MemCopy(i8* %d, i8* %s, i64 64)\n"
			"  %r = call i64 @f()\n"
			"  store i64 %a, i64* %v4\n"
	var want *[]readonly char = "  %a = load i64, i64* %v3\n"
			"  call void @llvm.memcpy.p0.p0.i64(ptr %d, ptr %s, i64 64, i1 false)\n"
			"  call void @bn_rt_MemCopy(i8* %d, i8* %s, i64 64), !dbg !DILocation(line: 0, scope: !9)\n"
			"  %r = call i64 @f(), !dbg !DILocation(line: 0, scope: !9)\n"
			"  store i64 %a, i64* %v4\n"
	var out @strings.Builder = strings.NewBuilder()
	annotateParamSlotSetupDbg(out, seg, 9)
	var got @[]readonly char = out.String()
	if len(got) != len(want) || !textAt(got, 0, want) { return fail(buf.Concat("got:\n", got)) }
	return ""
}
