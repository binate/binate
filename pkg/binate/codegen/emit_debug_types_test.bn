package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_debug_types.bn — DIDerivedType DW_TAG_pointer_type
// for `*T` / `@T`, DICompositeType DW_TAG_structure_type for
// structs (with DW_TAG_member nodes per field), and the dbgScalarSlot
// helper that decides scalar vs registry routing.

// TestEmitDebugPointerType verifies that `*T` and `@T` allocas
// reference a DIDerivedType DW_TAG_pointer_type node (not the
// legacy !5 fallback) and that the node's `name:` carries the
// `*` / `@` prefix so lldb shows the language-level form.
// Two distinct pointer types appear here: `*Counter` (raw) and
// `@Counter` (managed); the second proves the registry gives
// each its own dedup'd entry.
func TestEmitDebugPointerType() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Counter struct { N int }\n")
	cb = cb.WriteStr("func raw(p *Counter) int { return p.N }\n")
	cb = cb.WriteStr("func mgd(p @Counter) int { return p.N }\n")
	cb = cb.WriteStr("func main() { var c @Counter = make(Counter); println(mgd(c)) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_pointer_type, name: \"*Counter\"") {
		return fail("expected DIDerivedType for *Counter")
	}
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_pointer_type, name: \"@Counter\"") {
		return fail("expected DIDerivedType for @Counter")
	}
	if !contains(out, "size: 64)") {
		return fail("expected pointer DIDerivedType size: 64")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugStructType verifies a struct-typed local lowers
// to a DICompositeType DW_TAG_structure_type with one DW_TAG_member
// per field, in field declaration order, with correct byte offsets.
// Pinning offsets catches a regression where StructLayout's padding
// is mis-applied to the DWARF emission.
func TestEmitDebugStructType() testing.TestResult {
	setTarget64()
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Pair struct { A int; B int }\n")
	cb = cb.WriteStr("func use(p @Pair) int { return p.A + p.B }\n")
	cb = cb.WriteStr("func main() { var pp @Pair = make(Pair); println(use(pp)) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out,
		"!DICompositeType(tag: DW_TAG_structure_type, name: \"Pair\"") {
		return fail("expected DICompositeType for Pair")
	}
	if !contains(out, "size: 128, elements: !{") {
		return fail("expected Pair size: 128 with elements list")
	}
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_member, name: \"A\"") {
		return fail("expected DW_TAG_member for field A")
	}
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_member, name: \"B\"") {
		return fail("expected DW_TAG_member for field B")
	}
	if !contains(out, "size: 64, offset: 0)") {
		return fail("expected first member at offset 0")
	}
	if !contains(out, "size: 64, offset: 64)") {
		return fail("expected second member at offset 64 (8 bytes)")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugStructFieldsReferenceScalarSlots pins the bridge
// between step 1's scalar bank and step 4's struct emission: each
// member's `baseType:` for a scalar field must point to the right
// slot in !5..!15 (so lldb formats the field correctly).
func TestEmitDebugStructFieldsReferenceScalarSlots() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Mixed struct { Flag bool; B byte }\n")
	cb = cb.WriteStr("func use(m @Mixed) int { if m.Flag { return cast(int, m.B) }; return 0 }\n")
	cb = cb.WriteStr("func main() { var mm @Mixed = make(Mixed); println(use(mm)) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	// bool field must reference !15.
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_member, name: \"Flag\", scope: !") {
		return fail("expected Flag member node")
	}
	if !contains(out, "baseType: !15, size: 8") {
		return fail("expected Flag's baseType to reference bool slot !15")
	}
	// byte (uint8) field must reference !10.
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_member, name: \"B\", scope: !") {
		return fail("expected B member node")
	}
	if !contains(out, "baseType: !10, size: 8") {
		return fail("expected B's baseType to reference uint8 slot !10")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugPointerToStructChain verifies the registry's
// recursive interning: a `*Counter` alloca causes BOTH the
// DIDerivedType for `*Counter` AND the DICompositeType for
// `Counter` to be emitted, with the pointer's `baseType:` pointing
// at the struct's metadata-id.  Catches a regression where the
// pointer node references !5 (the fallback) instead of the
// freshly-interned struct.
func TestEmitDebugPointerToStructChain() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Node struct { Val int }\n")
	cb = cb.WriteStr("func use(n *Node) int { return n.Val }\n")
	cb = cb.WriteStr("func main() { println(0) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out,
		"!DICompositeType(tag: DW_TAG_structure_type, name: \"Node\"") {
		return fail("expected DICompositeType for Node")
	}
	if !contains(out,
		"!DIDerivedType(tag: DW_TAG_pointer_type, name: \"*Node\"") {
		return fail("expected DIDerivedType for *Node")
	}
	// Pointer node must reference the struct metadata id, not !5.
	// We don't know the exact ids without parsing, but a valid
	// emission has `baseType: !N` where !N is the Node DICompositeType
	// — and !N is NOT 5 (which is the int slot).  Confirm `baseType: !5`
	// does NOT appear in a pointer-type DIDerivedType context.
	if contains(out,
		"DIDerivedType(tag: DW_TAG_pointer_type, name: \"*Node\", baseType: !5") {
		return fail("*Node's baseType must not be !5 (the int fallback)")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugRegistryDedupsSameType verifies that two locals
// sharing a type emit one DI node, not two.  Counts the
// occurrences of "name: \"Pair\"," in the output — should be
// exactly one (the DICompositeType definition; not counting
// dbg.declare references which use `type: !N`, not `name:`).
func TestEmitDebugRegistryDedupsSameType() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Pair struct { A int; B int }\n")
	cb = cb.WriteStr("func use(p1 @Pair, p2 @Pair) int { return p1.A + p2.B }\n")
	cb = cb.WriteStr("func main() { var pp @Pair = make(Pair); println(use(pp, pp)) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	// Match the unique DICompositeType definition prefix.
	var defStr *[]const char =
		"!DICompositeType(tag: DW_TAG_structure_type, name: \"Pair\""
	var count int = 0
	for i := 0; i <= len(out) - len(defStr); i++ {
		var match bool = true
		for j := 0; j < len(defStr); j++ {
			if out[i + j] != defStr[j] { match = false; break }
		}
		if match { count = count + 1 }
	}
	if count != 1 {
		return fail("expected exactly one DICompositeType for Pair (registry dedup)")
	}
	var pass testing.TestResult
	return pass
}

// TestDbgTypeKey pins the structural-string keys that drive
// registry deduplication.  A regression that conflates raw and
// managed pointers (or two distinct struct names) would silently
// emit fewer DI nodes than expected.
func TestDbgTypeKey() testing.TestResult {
	if !charsEqual(dbgTypeKey(types.MakePointerType(types.TypInt())), "*int") {
		return fail("*int key should be \"*int\"")
	}
	if !charsEqual(dbgTypeKey(types.MakeManagedPtrType(types.TypInt())), "@int") {
		return fail("@int key should be \"@int\"")
	}
	if !charsEqual(dbgTypeKey(types.TypBool()), "bool") {
		return fail("bool key should be \"bool\"")
	}
	if !charsEqual(dbgTypeKey(types.TypInt32()), "int32") {
		return fail("int32 key should be \"int32\"")
	}
	// Pointer-to-pointer: structural composition.
	var pp @types.Type = types.MakePointerType(types.MakeManagedPtrType(types.TypInt()))
	if !charsEqual(dbgTypeKey(pp), "*@int") {
		return fail("*@int key should compose to \"*@int\"")
	}
	if !charsEqual(dbgTypeKey(nil), "?") {
		return fail("nil key should be \"?\"")
	}
	var pass testing.TestResult
	return pass
}

// TestDbgScalarSlotIsolated pins dbgScalarSlot's behaviour for
// non-scalars (returns -1).  Combined with TestDbgTypeIDScalars,
// this covers the "fallback path is taken" branch — without it
// a regression that always returned 5 from dbgScalarSlot would
// silently break the non-scalar registry hand-off.
func TestDbgScalarSlotIsolated() testing.TestResult {
	if dbgScalarSlot(types.MakePointerType(types.TypInt())) != -1 {
		return fail("pointer should not have a scalar slot")
	}
	if dbgScalarSlot(types.MakeManagedSliceType(types.TypInt())) != -1 {
		return fail("managed-slice should not have a scalar slot")
	}
	if dbgScalarSlot(types.TypBool()) != 15 {
		return fail("bool should map to slot 15")
	}
	if dbgScalarSlot(nil) != -1 {
		return fail("nil should not have a scalar slot")
	}
	var pass testing.TestResult
	return pass
}
