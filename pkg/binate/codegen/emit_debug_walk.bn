package "pkg/binate/codegen"

import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// The debug types a module needs are interned depth first: a type is registered when
// it is first seen, with its metadata ids, and then its parts are interned, each
// completely before the next -- a pointer's or a readonly type's element, an array's
// element, a slice's element pointer, a named type's underlying type, a struct's
// fields.  A part can be a pointer to another struct, so a ring of structs each
// holding a pointer to the next is interned struct by struct, and so is a chain of
// named types; either is as long as a program makes it (type.named.depth bounds
// neither: a named type adds no level, and a chain ends at a cycle through an indirect
// part).  So the types whose parts are still to be interned are kept on a stack of
// their own (dbgWalk), not a call per type.

// A dbgWalkFrame is a registered type whose parts are being interned and the next of
// them.
type dbgWalkFrame struct {
	t    @types.Type
	next int
}

// dbgWalk holds the registered types whose parts are still to be interned, innermost
// last.
var dbgWalk @vec.Vec[dbgWalkFrame]

// dbgTypeIndex finds a registered type's metadata id by its key (dbgTypeKey).
var dbgTypeIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]

// newDbgTypeRegistry empties the registry, its index and the walk.
func newDbgTypeRegistry() {
	dbgTypeRegistry = vec.New[dbgTypeEntry]()
	dbgTypeIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	dbgWalk = vec.New[dbgWalkFrame]()
}

// registerDbgType adds e to the registry, and its type to the walk's stack when it has
// parts to intern (dbgPartCount).
func registerDbgType(e dbgTypeEntry) {
	if dbgTypeRegistry == nil { newDbgTypeRegistry() }
	dbgTypeRegistry.Push(e)
	dbgTypeIndex.Put(e.Key, e.ID)
	if dbgPartCount(e.Typ) > 0 {
		var f dbgWalkFrame
		f.t = e.Typ
		dbgWalk.Push(f)
	}
}

// walkDbgParts interns the parts of the types on the walk's stack, each part's own
// parts before the next part.
func walkDbgParts() {
	if dbgWalk == nil { return }
	for dbgWalk.Len() > 0 {
		var top int = dbgWalk.Len() - 1
		var f dbgWalkFrame = dbgWalk.Get(top)
		if f.next >= dbgPartCount(f.t) {
			_, _ = dbgWalk.Pop()
			continue
		}
		var part @types.Type = dbgPart(f.t, f.next)
		f.next = f.next + 1
		dbgWalk.Set(top, f)
		_ = dbgTypeIDHere(part)
	}
}

// dbgPartCount returns how many parts of the registered type t are interned after it
// (dbgPart).
func dbgPartCount(t @types.Type) int {
	if t.Kind == types.TYP_STRUCT { return len(t.Fields) }
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_ARRAY ||
			t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR || t.Kind == types.TYP_READONLY ||
			t.Kind == types.TYP_NAMED {
		return 1
	}
	return 0
}

// dbgPart returns part i of the registered type t: a struct's field type, a slice's
// element pointer (the type its ptr member is described as), a named type's
// underlying type, or the element of anything else with a part.
func dbgPart(t @types.Type, i int) @types.Type {
	if t.Kind == types.TYP_STRUCT { return t.Fields[i].Type }
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		return types.MakePointerType(t.Elem)
	}
	if t.Kind == types.TYP_NAMED { return t.Underlying }
	return t.Elem
}
