package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_debug_walk.bn: debug types are interned depth first, from a stack of
// their own.

// A type is registered when first seen and its parts are interned after it, each
// completely before the next: A { p *B; q *C } takes its id and its two members',
// then *B, then B and its two members, and only then *C.
func TestDebugTypesInternedDepthFirst() testing.TestResult {
	setTarget64()
	resetDbgTypeRegistry()
	setDbgTypeIDBase(100)
	var b @types.Type = types.MakeStructType("B", fieldsTwo(types.TypInt(), "w", types.TypInt(), "x"))
	var c @types.Type = types.MakeStructType("C", fieldsTwo(types.TypInt(), "y", types.TypInt(), "z"))
	var pb @types.Type = types.MakePointerType(b)
	var pc @types.Type = types.MakePointerType(c)
	var a @types.Type = types.MakeStructType("A", fieldsTwo(pb, "p", pc, "q"))
	var idA int = dbgTypeID(a)
	var idPB int = lookupDbgType(dbgTypeKey(pb))
	var idB int = lookupDbgType(dbgTypeKey(b))
	var idPC int = lookupDbgType(dbgTypeKey(pc))
	resetDbgTypeRegistry()
	if idA != 100 { return fail("A should take the first id") }
	if idPB != 103 { return fail("*B should come right after A and its two members") }
	if idB != 104 { return fail("B should come right after *B") }
	if idPC != 107 { return fail("*C should come after B and its two members, not before B") }
	return ""
}

// A chain of named types far longer than a stack could follow a call per link is
// registered whole, each link once.
func TestDeepNamedChainDebugTypes() testing.TestResult {
	setTarget64()
	resetDbgTypeRegistry()
	setDbgTypeIDBase(100)
	var chain @types.Type = namedChain(types.TypInt(), deepNamed)
	var id int = dbgTypeID(chain)
	var n int = dbgTypeRegistry.Len()
	releaseNamedChain(chain)
	resetDbgTypeRegistry()
	if id != 100 { return fail("the chain's head should take the first id") }
	if n != deepNamed { return fail("every link of the chain should be registered once") }
	return ""
}

// So is a ring of structs, each holding a pointer to the next: a pointer and a struct
// for each.
func TestDeepStructRingDebugTypes() testing.TestResult {
	setTarget64()
	resetDbgTypeRegistry()
	setDbgTypeIDBase(100)
	var ring @[]@types.Type = structRing(deepRing)
	_ = dbgTypeID(types.MakePointerType(ring[0]))
	var n int = dbgTypeRegistry.Len()
	releaseRing(ring)
	resetDbgTypeRegistry()
	if n != 2 * deepRing {
		return fail("each struct of the ring and its pointer should be registered once")
	}
	return ""
}

// A chain of aliases keys as the type it ends at.
func TestDeepAliasChainDebugKey() testing.TestResult {
	var t @types.Type = types.TypInt()
	for i := 0; i < deepNamed; i++ {
		t = types.MakeAliasType("A", t)
	}
	var key @[]char = dbgTypeKey(t)
	var cur @types.Type = t
	for cur != nil && cur.Kind == types.TYP_ALIAS {
		var next @types.Type = cur.Target
		cur.Target = nil
		cur = next
	}
	if !charsEqual(key, "int") { return fail("the chain should key as int") }
	return ""
}
