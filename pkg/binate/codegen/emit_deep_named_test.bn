package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for the walks that peel named types in a loop (emit_copy.bn, emit_types.bn,
// emit_funcvals_sig.bn, emit_struct_discover.bn): a chain of named types adds no level
// to a type's depth, so it is as long as a program makes it.

// deepNamed is how long the deep tests' chains of named types are: far past what a
// walk with a call per link could hold on its stack.
const deepNamed int = 100000

// namedChain returns n named types around base, each over the next: N0 over N1 ...
// over base.
func namedChain(base @types.Type, n int) @types.Type {
	var t @types.Type = base
	for i := n - 1; i >= 0; i-- {
		var nt @types.Type = types.MakeNamedType(buf.Concat("N", strconv.Itoa(i)))
		nt.Underlying = t
		t = nt
	}
	return t
}

// releaseNamedChain drops a chain of named types a link at a time, so its release does
// not nest one destruction per link.
func releaseNamedChain(t @types.Type) {
	var cur @types.Type = t
	for cur != nil && cur.Kind == types.TYP_NAMED {
		var next @types.Type = cur.Underlying
		cur.Underlying = nil
		cur = next
	}
}

// Copying and zeroing a value of a type at the end of a chain of named types far
// longer than a stack could follow a call per link copy and zero its struct's fields.
func TestDeepNamedChainCopyZero() testing.TestResult {
	setTarget64()
	var st @types.Type = types.MakeStructType("Pt",
			fieldsTwo(types.TypInt32(), "x", types.TypInt32(), "y"))
	var chain @types.Type = namedChain(st, deepNamed)
	var copied @[]char = emitCopyToString("%d", "%s", chain, 1)
	var zeroed @[]char = emitZeroToString("%d", chain, 2)
	releaseNamedChain(chain)
	if !contains(copied, "%v1.fc1_dp = getelementptr i8, ptr %d, i32 4") ||
			!contains(copied, "store i32 %v1.fc1_v, ptr %v1.fc1_dp") {
		return fail("the copy should copy the struct's second field")
	}
	if !contains(zeroed, "store i32 0, ptr %v2.fz1_dp") {
		return fail("the zeroing should zero the struct's second field")
	}
	return ""
}

// The scalar queries see through such a chain to an int8 or a float32 at its end.
func TestDeepNamedChainScalarQueries() testing.TestResult {
	setTarget64()
	var i8 @types.Type = namedChain(types.TypInt8(), deepNamed)
	var bits int = typeBits(i8)
	var unsigned bool = isUnsigned(i8)
	var ext @[]char = cabiIntExtAttr(i8)
	var wide bool = is64ScalarUnderlying(i8)
	releaseNamedChain(i8)
	var f32 @types.Type = namedChain(types.TypFloat32(), deepNamed)
	var isFloat bool = isFloatScalarParam(f32)
	var slot32 bool = floatSlotIsI32(f32)
	releaseNamedChain(f32)
	if bits != 8 { return fail("typeBits should see the int8") }
	if unsigned { return fail("isUnsigned should see a signed int8") }
	if !charsEqual(ext, "signext ") { return fail(buf.Concat("cabiIntExtAttr: ", ext)) }
	if wide { return fail("is64ScalarUnderlying should see an 8-bit int") }
	if !isFloat || !slot32 { return fail("the float queries should see the float32") }
	return ""
}

// A global whose type is such a chain over a struct declares the struct
// (discoverStructFromType follows the chain to it).
func TestDeepNamedChainGlobalDiscovered() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var st @types.Type = types.MakeStructType("Pt",
			fieldsTwo(types.TypInt(), "x", types.TypInt(), "y"))
	var chain @types.Type = namedChain(st, deepNamed)
	var g @ir.Global = make(ir.Global)
	g.Name = "g"
	g.Typ = chain
	m.AddGlobal(g)
	var out @[]char = EmitModule(m)
	g.Typ = nil
	releaseNamedChain(chain)
	if !contains(out, "%bn_S1_4_main1_2_Pt = type") {
		return fail("the struct at the end of the chain should be declared")
	}
	return ""
}
