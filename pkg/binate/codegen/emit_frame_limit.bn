package "pkg/binate/codegen"

import "pkg/binate/native/callconv"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// FrameSizeChecked reports whether the LLVM backend has LLVM reject a function whose
// frame passes a limit (llvmFrameLimit); see codegen.bni.
func FrameSizeChecked() bool {
	return llvmFrameLimit() >= 0
}

// llvmFrameLimit returns the largest frame the LLVM backend lets LLVM lay out for the
// target, or -1 for none.  Each function's "warn-stack-size" states it (a 32-bit
// count, so at most 2^32 - 1), LLVM reports a frame past it, and the driver makes that
// report an error (-Werror=frame-larger-than).
//
// On a 32-bit target the limit is the target's own, its address space (types.FrameLimit,
// spec §21.4): a frame past it would otherwise wrap (two 2 GiB locals on arm32 reserve
// 16 bytes).  On x86-64 it is 2^31 - 1, short of the target's limit: LLVM addresses a
// frame object there with a signed 32-bit displacement and silently truncates a larger
// one (in a 3 GiB frame a store to the last local lands 1 GiB above the frame, in the
// caller's memory).  LLVM addresses any frame aarch64 allows, so there is none there.
func llvmFrameLimit() int64 {
	var limit int64 = types.FrameLimit()
	if limit <= 0xFFFFFFFF { return limit }
	if types.GetTarget().Arch == types.ARCH_X64 { return x64DispLimit }
	return -1
}

// x64DispLimit is the largest displacement from the frame pointer that LLVM's x86-64
// code generator addresses correctly: it encodes a frame object's address as a signed
// 32-bit displacement and silently truncates a larger one.
const x64DispLimit int64 = 0x7FFFFFFF

// emitError holds the first error EmitModule found in the module it last lowered, or
// is empty; see codegen.bni.
var emitError @[]readonly char

// EmitError returns the error EmitModule found in the module it last lowered; see
// codegen.bni.
func EmitError() @[]readonly char {
	return emitError
}

// checkStackArgs records an error (EmitError) when the define named name (a function,
// or a C export's entry), whose parameters are argTypes, receives a stack argument
// LLVM cannot address: on x86-64, one ending past x64DispLimit bytes above the frame
// pointer.  The frame limit (llvmFrameLimit) bounds the function's own frame, not the
// arguments its caller lays out above it.  Each SysV stack argument takes its size
// rounded up to eightbytes from its offset (CallArgStackOff), and the first starts 16
// bytes above the frame pointer, past the saved frame pointer and the return address.
func checkStackArgs(name *[]readonly char, argTypes @[]@types.Type) {
	if !targetIsX64() || len(emitError) > 0 { return }
	var cc callconv.CallConv = callConvForTarget()
	var end int64 = 0
	for i := 0; i < len(argTypes); i++ {
		var off int = cc.CallArgStackOff(argTypes, i)
		if off < 0 { continue }
		var argEnd int64 = cast(int64, off) + ((argTypes[i].Size() + 7) & ~7)
		if argEnd > end { end = argEnd }
	}
	if 16 + end - 1 <= x64DispLimit { return }
	var msg @strings.Builder = strings.NewBuilder()
	msg.Write("the stack arguments of ")
	msg.Write(name)
	msg.Write(" end past what the LLVM backend addresses on x86-64 (at most ")
	stringutils.WriteInt64(msg, x64DispLimit)
	msg.Write(" bytes above the frame pointer)")
	emitError = msg.String()
}
