package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// llvmFrameLimit is the target's own limit (types.FrameLimit) on a 32-bit target,
// 2^31 - 1 on x86-64, and none on aarch64; FrameSizeChecked follows it.
func TestLLVMFrameLimit() testing.TestResult {
	setTarget32()
	var limit32 int64 = llvmFrameLimit()
	var checked32 bool = FrameSizeChecked()
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var limitX64 int64 = llvmFrameLimit()
	var checkedX64 bool = FrameSizeChecked()
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var limitAA64 int64 = llvmFrameLimit()
	var checkedAA64 bool = FrameSizeChecked()
	setTarget64()
	if limit32 != 0xFFFFFFFF || !checked32 {
		return fail("a 32-bit target's LLVM frame limit should be 2^32 - 1, checked")
	}
	if limitX64 != 0x7FFFFFFF || !checkedX64 {
		return fail("x86-64's LLVM frame limit should be 2^31 - 1, checked")
	}
	if limitAA64 != -1 || checkedAA64 {
		return fail("aarch64 should have no LLVM frame limit")
	}
	return ""
}

// Every define carries "warn-stack-size" at the LLVM backend's frame limit for the
// target, so LLVM reports a frame past it (an error under -Werror=frame-larger-than)
// instead of miscompiling it: on a 32-bit target, the address space (types.FrameLimit);
// on x86-64, 2^31 - 1, the largest frame LLVM addresses there.  An aarch64 define
// carries none.
func TestStackSizeAttrPerTarget() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc plain() int { return 0 }\nfunc main() { }\n"
	setTarget32()
	var out32 @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var outX64 @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var outAA64 @[]char = compileToLLVM(src)
	setTarget64()
	if !contains(out32, "\"frame-pointer\"=\"all\" \"warn-stack-size\"=\"4294967295\"") {
		return fail("a 32-bit target's define should carry warn-stack-size at 4294967295")
	}
	if !contains(outX64, "\"frame-pointer\"=\"all\" \"warn-stack-size\"=\"2147483647\"") {
		return fail("an x86-64 define should carry warn-stack-size at 2147483647")
	}
	if contains(outAA64, "warn-stack-size") {
		return fail("an aarch64 define should carry no warn-stack-size")
	}
	return ""
}
