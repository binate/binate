package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// llvmFrameLimit is the target's own limit (types.FrameLimit) on a 32-bit target,
// 2^31 - 1 on x86-64, and none on aarch64; FrameSizeChecked follows it.
func TestLLVMFrameLimit() testing.TestResult {
	setTarget32()
	var limit32 int64 = llvmFrameLimit()
	var checked32 bool = FrameSizeChecked()
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var limitX64 int64 = llvmFrameLimit()
	var checkedX64 bool = FrameSizeChecked()
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var limitAA64 int64 = llvmFrameLimit()
	var checkedAA64 bool = FrameSizeChecked()
	setTarget64()
	if limit32 != 0xFFFFFFFF || !checked32 {
		return fail("a 32-bit target's LLVM frame limit should be 2^32 - 1, checked")
	}
	if limitX64 != 0x7FFFFFFF || !checkedX64 {
		return fail("x86-64's LLVM frame limit should be 2^31 - 1, checked")
	}
	if limitAA64 != -1 || checkedAA64 {
		return fail("aarch64 should have no LLVM frame limit")
	}
	return ""
}

// Every define carries "warn-stack-size" at the LLVM backend's frame limit for the
// target, so LLVM reports a frame past it (an error under -Werror=frame-larger-than)
// instead of miscompiling it: on a 32-bit target, the address space (types.FrameLimit);
// on x86-64, 2^31 - 1, the largest frame LLVM addresses there.  An aarch64 define
// carries none.
func TestStackSizeAttrPerTarget() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc plain() int { return 0 }\nfunc main() { }\n"
	setTarget32()
	var out32 @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var outX64 @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var outAA64 @[]char = compileToLLVM(src)
	setTarget64()
	if !contains(out32, "\"frame-pointer\"=\"all\" \"warn-stack-size\"=\"4294967295\"") {
		return fail("a 32-bit target's define should carry warn-stack-size at 4294967295")
	}
	if !contains(outX64, "\"frame-pointer\"=\"all\" \"warn-stack-size\"=\"2147483647\"") {
		return fail("an x86-64 define should carry warn-stack-size at 2147483647")
	}
	if contains(outAA64, "warn-stack-size") {
		return fail("an aarch64 define should carry no warn-stack-size")
	}
	return ""
}

// stackArgsError compiles src for x86-64 (or aarch64) and returns EmitError.
func stackArgsError(src *[]readonly char, x64 bool) @[]readonly char {
	setTarget64()
	if x64 {
		types.SetArch(types.ARCH_X64)
	} else {
		types.SetArch(types.ARCH_AA64)
	}
	compileToLLVM(src)
	setTarget64()
	return EmitError()
}

// On x86-64 a function whose stack arguments end past 2^31 - 1 bytes above its frame
// pointer is an error naming it: three 1 GiB arrays, passed by value on the stack, end
// 3 GiB above it.  aarch64 passes them by reference, so it takes the function.
func TestStackArgsPastDispLimit() testing.TestResult {
	var src *[]readonly char = "package \"main\"\ntype Big [0x40000000]uint8\n"
			"func f(a Big, b Big, c Big) int { return cast(int, c[5]) }\nfunc main() { }\n"
	var errX64 @[]readonly char = stackArgsError(src, true)
	if !contains(errX64,
			"the stack arguments of main.f end past what the LLVM backend addresses "
					"on x86-64 (at most 2147483647 bytes above the frame pointer)") {
		return fail("x86-64 should reject f's stack arguments, naming f")
	}
	if len(stackArgsError(src, false)) != 0 {
		return fail("aarch64 should take f: it passes the arrays by reference")
	}
	return ""
}

// The bound is exact: the last byte of the stack arguments sits 16 + end - 1 bytes above
// the frame pointer, so a lone argument of 2^31 - 16 bytes fits and one byte more (its
// slot rounded up to 2^31 - 8) does not.  EmitModule clears the error for the next module.
func TestStackArgsBoundary() testing.TestResult {
	var fits @[]readonly char = stackArgsError(
			"package \"main\"\nfunc g(a [0x7FFFFFF0]uint8) { }\nfunc main() { }\n", true)
	if len(fits) != 0 {
		return fail("a stack argument ending 2^31 - 1 bytes above the frame pointer should fit")
	}
	var over @[]readonly char = stackArgsError(
			"package \"main\"\nfunc g(a [0x7FFFFFF1]uint8) { }\nfunc main() { }\n", true)
	if !contains(over, "the stack arguments of main.g end past") {
		return fail("a stack argument ending past 2^31 - 1 bytes should be rejected")
	}
	if len(stackArgsError("package \"main\"\nfunc main() { }\n", true)) != 0 {
		return fail("EmitModule should clear the previous module's error")
	}
	return ""
}

// A C export's entry is checked with the C layout: returning a tuple the C ABI returns
// through an sret pointer (and the internal convention in registers), its sixth int moves
// to the stack ahead of the array, which then ends 8 bytes past the limit, while the
// internal define's arguments fit.
func TestStackArgsCExportEntry() testing.TestResult {
	var params *[]readonly char = "(s1 int, s2 int, s3 int, s4 int, s5 int, s6 int, "
			"a [0x7FFFFFF0]uint8) (int, int, int) { return s1, s6, cast(int, a[5]) }\n"
	var internal @[]readonly char = stackArgsError(
			buf.Concat(buf.Concat("package \"main\"\nfunc f", params), "func main() { }\n"), true)
	if len(internal) != 0 {
		return fail("the internal define's stack arguments should fit")
	}
	var exported @[]readonly char = stackArgsError(
			buf.Concat(buf.Concat("package \"main\"\n#[c_export(\"bn_edge\")]\nfunc f", params),
					"func main() { }\n"), true)
	if !contains(exported, "the stack arguments of the C entry of main.f end past") {
		return fail("the C entry's stack arguments should be rejected")
	}
	return ""
}
