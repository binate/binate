package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types/abi"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// The module's function return types: how each call site spells a call, by the
// callee's mangled name.

// FuncRetType records the LLVM return-type string for one mangled func
// name (Name) so call sites can spell the call correctly. IsSret marks
// callees that return their aggregate result via an X8/sret pointer
// instead of in registers.
type FuncRetType struct {
	Name    @[]char
	RetType @[]char
	IsSret  bool
}

// buildFuncRetTypes returns the return types of m's functions with results, in
// m.Funcs' order, and indexes them by name (indexFuncRetTypes).
func buildFuncRetTypes(m @ir.Module) @[]FuncRetType {
	var frts @vec.Vec[FuncRetType] = vec.New[FuncRetType]()
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if len(f.Results) > 0 {
			var frt FuncRetType
			frt.Name = mangle.FuncName(modulePkgName, f.Name)
			if len(f.Results) == 1 && aggRetCoerced(f.Results[0]) {
				// Record the coerced ABI return type so call sites
				// (lookupRetType) emit `call <ret> @...` and bind the
				// result through the coercion in emitCall — x64 SSE's
				// `{ .. }` / eightbyte aggregate (sysvReturnLLTy) or the
				// GP `[N x iW]` (aggCoerceLLTy).
				var frtb @strings.Builder = strings.NewBuilder()
				if abi.SysVInSse(f.Results[0]) {
					sysvReturnLLTy(frtb, f.Results[0])
				} else {
					aggCoerceLLTy(frtb, f.Results[0])
				}
				frt.RetType = buf.CopyStr(frtb.String())
			} else if len(f.Results) == 1 {
				frt.RetType = llvmType(f.Results[0])
				if needsSret(f.Results[0]) {
					frt.IsSret = true
				}
			} else if funcMultiRetCoerced(f) {
				// Register-returned multi-return with a coercible field: record
				// the per-field-coerced tuple type so call sites spell `call
				// {coerced} @…` and reinterpret the result back to the raw tuple.
				var frtb2 @strings.Builder = strings.NewBuilder()
				multiReturnCoercedLLTy(frtb2, f.MultiReturnType)
				frt.RetType = buf.CopyStr(frtb2.String())
			} else if f.MultiReturnType != nil {
				frt.RetType = llvmType(f.MultiReturnType)
				// A large multi-return tuple goes through sret (same
				// register-count rule + retbuf pointee the def side uses), so
				// call sites emit the sret pointer + load the result back.
				if multiRetNeedsSret(f) {
					frt.IsSret = true
				}
			} else {
				frt.RetType = multiReturnType(f.Results)
			}
			frts.Push(frt)
		}
	}
	var funcRetTypes @[]FuncRetType = frts.Items()
	indexFuncRetTypes(funcRetTypes)
	return funcRetTypes
}

// funcRetIndexed is the list of return types EmitModule built for the module it
// is emitting, and funcRetIndex the first index of each name in it, so a lookup in
// that list costs time independent of its length; a lookup in another list (a unit
// test's) walks it.  EmitModule drops both as it starts and as it ends.
var funcRetIndexed @[]FuncRetType

// funcRetIndex is the first index of each name in funcRetIndexed.
var funcRetIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]

// indexFuncRetTypes makes frts the list lookupRetType and lookupIsSret find names in
// through funcRetIndex.  The index's keys borrow its elements' names.
func indexFuncRetTypes(frts @[]FuncRetType) {
	funcRetIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(frts); i++ {
		_, _ = funcRetIndex.GetOrPut(frts[i].Name, i)
	}
	funcRetIndexed = frts
}

// dropFuncRetIndex drops funcRetIndex and the list it was built over.
func dropFuncRetIndex() {
	var noList @[]FuncRetType
	var noIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]
	funcRetIndexed = noList
	funcRetIndex = noIndex
}

// funcRetAt returns the index in funcRetTypes of its first entry named name, or -1:
// through funcRetIndex when funcRetTypes is the list it indexes (the same elements:
// funcRetIndexed holds them alive, so their memory is no other list's).
func funcRetAt(funcRetTypes *[]FuncRetType, name *[]readonly char) int {
	var n int = len(funcRetTypes)
	if funcRetIndex != nil && n > 0 && n == len(funcRetIndexed) &&
			&funcRetTypes[0] == &funcRetIndexed[0] {
		i, found := funcRetIndex.Get(name)
		if !found { return -1 }
		return i
	}
	for i := 0; i < n; i++ {
		if charsEqual(funcRetTypes[i].Name, name) { return i }
	}
	return -1
}

// lookupRetType finds the LLVM return type string for a function by mangled name.
func lookupRetType(funcRetTypes *[]FuncRetType, name *[]readonly char) @[]char {
	var i int = funcRetAt(funcRetTypes, name)
	if i < 0 { return "" }
	return funcRetTypes[i].RetType
}

// lookupIsSret checks whether a function uses sret (indirect return) convention.
func lookupIsSret(funcRetTypes *[]FuncRetType, name *[]readonly char) bool {
	var i int = funcRetAt(funcRetTypes, name)
	if i < 0 { return false }
	return funcRetTypes[i].IsSret
}
