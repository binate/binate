package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for emit_func_rets.bn.

// frtOf returns a FuncRetType named name, of the return type ret.
func frtOf(name *[]readonly char, ret *[]readonly char, sret bool) FuncRetType {
	var frt FuncRetType
	frt.Name = buf.CopyStr(name)
	frt.RetType = buf.CopyStr(ret)
	frt.IsSret = sret
	return frt
}

// A lookup finds the first entry of a name, through the index in the indexed list
// and by a walk in any other (a copy, a prefix), alike.
func TestFuncRetLookups() testing.TestResult {
	var frts @[]FuncRetType = make_slice(FuncRetType, 3)
	frts[0] = frtOf("a", "i64", false)
	frts[1] = frtOf("b", "%T", true)
	frts[2] = frtOf("a", "i8", true)
	var other @[]FuncRetType = make_slice(FuncRetType, 3)
	for i := 0; i < 3; i++ { other[i] = frts[i] }
	indexFuncRetTypes(frts)
	for k := 0; k < 2; k++ {
		var list @[]FuncRetType = frts
		if k == 1 { list = other }
		if !charsEqual(lookupRetType(list, "a"), "i64") || lookupIsSret(list, "a") {
			return fail("the first a")
		}
		if !lookupIsSret(list, "b") || len(lookupRetType(list, "c")) != 0 || lookupIsSret(list, "c") {
			return fail("b sret, no c")
		}
	}
	// A prefix of the indexed list starts where it does but is not it: walked.
	if len(lookupRetType(frts[0:1], "b")) != 0 { return fail("no b in the prefix") }
	dropFuncRetIndex()
	if funcRetIndex != nil || len(funcRetIndexed) != 0 { return fail("dropped") }
	return ""
}
