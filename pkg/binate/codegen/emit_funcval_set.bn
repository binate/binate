package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// funcValueSet is the list of functions emitFuncValueVtables emits a (shim, vt, handle)
// triple for: each name with the function-value type it is called through, in the order
// first added, each name once -- found by name in a table, so a module of n functions
// builds it in time linear in n.  Its keys borrow the names, which names holds.
type funcValueSet struct {
	names @vec.Vec[@[]char]
	sigs  @vec.Vec[@types.Type]
	index @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq]
}

// newFuncValueSet returns an empty funcValueSet.
func newFuncValueSet() @funcValueSet {
	var s @funcValueSet = make(funcValueSet)
	s.names = vec.New[@[]char]()
	s.sigs = vec.New[@types.Type]()
	s.index = table.NewTable[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	return s
}

// has reports whether s holds name.
func (s @funcValueSet) has(name *[]readonly char) bool {
	return s.index.Has(name)
}

// add appends name, called through the function-value type sig, to s, which does not
// hold it yet.
func (s @funcValueSet) add(name @[]char, sig @types.Type) {
	s.names.Push(name)
	s.sigs.Push(sig)
	s.index.Put(name, true)
}

// count returns how many names s holds.
func (s @funcValueSet) count() int {
	return s.names.Len()
}

// name returns s's i-th name.
func (s @funcValueSet) name(i int) @[]char {
	return s.names.Get(i)
}

// sig returns the function-value type s's i-th name is called through.
func (s @funcValueSet) sig(i int) @types.Type {
	return s.sigs.Get(i)
}

// moduleFuncsIndexed is the m.Funcs moduleFuncIndex was built over: the functions of
// the module EmitModule is emitting, which are neither renamed nor dropped meanwhile.
// EmitModule drops both as it starts and as it ends (dropModuleFuncIndex), so they
// hold no module's IR after it.
var moduleFuncsIndexed @[]@ir.Func

// moduleFuncIndex is the first index of each name in moduleFuncsIndexed.
var moduleFuncIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]

// dropModuleFuncIndex drops moduleFunc's index and the functions it was built over.
func dropModuleFuncIndex() {
	var noFuncs @[]@ir.Func
	var noIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]
	moduleFuncsIndexed = noFuncs
	moduleFuncIndex = noIndex
}

// moduleFunc returns m's first function named name, or nil: from an index of m.Funcs,
// built again when m.Funcs is not the list it was built over (another module's, or one
// grown since).
func moduleFunc(m @ir.Module, name *[]readonly char) @ir.Func {
	if moduleFuncIndex == nil || !same(moduleFuncsIndexed, m.Funcs) {
		moduleFuncIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
				irdata.FuncSigHasher{}, irdata.FuncSigEq{})
		for i := 0; i < len(m.Funcs); i++ {
			_, _ = moduleFuncIndex.GetOrPut(m.Funcs[i].Name, i)
		}
		moduleFuncsIndexed = m.Funcs
	}
	var idx int
	var ok bool
	idx, ok = moduleFuncIndex.Get(name)
	if !ok { return nil }
	return m.Funcs[idx]
}
