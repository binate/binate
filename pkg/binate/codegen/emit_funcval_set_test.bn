package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcval_set.bn.

// A funcValueSet holds each name once, in the order first added, with its type.
func TestFuncValueSet() testing.TestResult {
	var s @funcValueSet = newFuncValueSet()
	var t @types.Type = types.TypInt()
	s.add("pkg.a", t)
	var none @types.Type
	s.add("pkg.b", none)
	if !s.has("pkg.a") || !s.has("pkg.b") || s.has("pkg.c") { return "has a and b, not c" }
	if s.count() != 2 || !charsEqual(s.name(1), "pkg.b") || !same(s.sig(0), t) {
		return "a then b, a with its type"
	}
	return ""
}

// moduleFunc finds a module's first function of a name, and finds it again after the
// module grows.
func TestModuleFunc() testing.TestResult {
	var m @ir.Module = ir.NewModule("m")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f1 @ir.Func = ir.NewFunc("m", "f", noParams, noResults)
	m.AddFunc(f1)
	m.AddFunc(ir.NewFunc("m", "f", noParams, noResults))
	if !same(moduleFunc(m, f1.Name), f1) { return "the first f" }
	if moduleFunc(m, "nope") != nil { return "no function nope" }
	var g @ir.Func = ir.NewFunc("m", "g", noParams, noResults)
	m.AddFunc(g)
	if !same(moduleFunc(m, g.Name), g) { return "g, added after the index was built" }
	return ""
}
