package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Function-value LLVM emission
// ============================================================
//
// The pure type->LLVM-string formatting helpers (isAggregateReturn,
// funcSignatureLLVM, shimIntSlotType, ...) live in emit_funcvals_sig.bn.

// emitFuncValueVtables walks the module's instructions, collects
// unique function names referenced by OP_FUNC_VALUE, and emits, per
// name:
//   1. A per-function shim `@__shim.<mangled>` that takes
//      `(i8* data, <args>)`, ignores `data`, and tail-calls the
//      real function. (Always-shim.)
//   2. A `@__vt.<mangled> = weak_odr constant %BnVtable {...}` whose
//      `call` slot points at the shim. dtor stays null (non-
//      capturing has no captured ctx to clean up).
func emitFuncValueVtables(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var instr @ir.Instr = blk.Instrs[k]
				// Collect OP_FUNC_VALUE (carries the function-value
				// type in instr.Typ) and OP_FUNC_HANDLE (user-facing
				// `_func_handle(F)` and emitManagedPtrRefDec's dtor
				// refs).
				// OP_FUNC_HANDLE's result type is opaque *uint8, so
				// synthesize a TYP_FUNC_VALUE from the referenced
				// function's Params/Results.  Both kinds need the same
				// per-function __shim / __vt / __handle backing:
				// OP_FUNC_HANDLE's native lowering references
				// @__handle.<mangled>, which depends on @__vt.<mangled>
				// (in turn depends on @__shim.<mangled>).
				if instr.Op != iropcode.OP_FUNC_VALUE && instr.Op != iropcode.OP_FUNC_HANDLE {
					continue
				}
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charsEqual(seen[s], instr.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				var sigTyp @types.Type = instr.Typ
				if instr.Op == iropcode.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueType(m, instr.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, instr.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	// Pre-pass: add each impl's receiver-dtor reference to the seen
	// list so the main loop below emits its (shim, vt, handle) triple.
	// Without this, the @__ivt's slot 0 would point at @__handle.<dtor>
	// even when no other path (e.g. emitManagedPtrRefDec on @T) caused
	// the triple to be emitted — the @__handle would dangle as an
	// undefined symbol at link time.  Same fix shape as
	// emitClosureDtorTriples but routed through the main loop so the
	// existing dedup against OP_FUNC_HANDLE references handles the
	// collision case (a module that BOTH does @T cleanup AND constructs
	// an iface from @T mustn't double-define @__handle.<dtor>).
	seen, sigs = addImplDtorsToSeen(m, seen, sigs)
	// Pre-pass: add each non-generic impl's interface-method references so the
	// main loop emits the (shim, vt, handle) triples the parallel @__ivtshim
	// vtable (emitImplShimVtable) points its method slots at.
	seen, sigs = addImplMethodsToSeen(m, seen, sigs)
	// Pre-pass: add every .bni-exported function so its triple is emitted
	// even when nothing references it as a function value — B0's
	// per-package Functions table symrefs @__handle.<exported fn>.
	seen, sigs = addExportedFuncsToSeen(m, seen, sigs)
	// Pre-pass: add the compiler-synthesized __Package accessor so its
	// triple is emitted too — the Functions table self-lists __Package,
	// whose Value symrefs @__handle.<...>__Package (emit_pkg_descriptor.bn).
	seen, sigs = addPackageAccessorToSeen(m, seen, sigs)
	if len(seen) == 0 && !moduleHasClosureWithDtor(m) {
		return
	}
	for i := 0; i < len(seen); i++ {
		var mangled @[]char = mangle.FuncName(modulePkgName, seen[i])
		var useSret bool = funcValueUsesSret(m, seen[i], sigs[i])
		// If the referenced function is a closure (IsClosure=true),
		// route through the closure-shim emitter which reads
		// captures out of the data pointer before tail-calling the
		// underlying (capturing function literals).
		var closureFunc @ir.Func = lookupClosureFunc(m, seen[i])
		if closureFunc != nil {
			emitClosureShim(out, mangled, sigs[i], closureFunc, useSret)
		} else {
			emitFuncValueShim(out, mangled, sigs[i], useSret)
		}
		emitFuncValueBackingGlobals(out, mangled, closureFunc)
	}
	// For every closure literal whose struct needs destruction, emit
	// the standard function-value triple (shim, vtable, handle) for
	// its dtor.  Mirrors the @T-with-managed-fields cleanup path:
	// rt.ZeroRefDestroy expects `dtor` to be a HANDLE POINTER (the
	// OP_CALL_HANDLE dispatch reads handle.vtable.call and invokes
	// `shim(handle.data, ptr)`), so the @func vtable's slot 0 stores
	// the dtor's handle address — emitted here — rather than a raw
	// fn pointer (which would crash OP_CALL_HANDLE on byte-pun bytes
	// from the dtor's machine code).  Cross-mode-clean: VM dispatch
	// of the same handle routes through the trampoline identically.
	emitClosureDtorTriples(out, m)
	out.WriteByte('\n')
	return
}

// addExportedFuncsToSeen appends every .bni-exported, non-extern function
// defined in the module to emitFuncValueVtables's `seen` + `sigs` arrays, so
// the main loop emits its (shim, vt, handle) triple even when no
// OP_FUNC_VALUE / OP_FUNC_HANDLE references it.  The per-package Functions
// table's Value field symrefs @__handle.<exported fn>, which must be a defined
// symbol.  Dedups against the existing seen entries by f.Name (the same name
// form OP_FUNC_HANDLE stores, since lookupFuncValueType keys on f.Name).
// Externs are skipped (their defining TU emits the triple); a func with no
// synthesizable func-value type is skipped.  The triples are weak_odr and
// dead-strip when the table referencing them is itself unreferenced, so this
// costs nothing for packages no one introspects.
func addExportedFuncsToSeen(m @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (ir.Func.IsStructDtor) + lang's primitive methods
		// (ir.Func.IsPrimitiveMethod), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsPrimitiveMethod { continue }
		var sigTyp @types.Type = lookupFuncValueType(m, f.Name)
		if sigTyp == nil { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charsEqual(seen[s], f.Name) {
				dup = true
				break
			}
		}
		if dup { continue }
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// addPackageAccessorToSeen appends the compiler-synthesized `__Package`
// accessor to emitFuncValueVtables's `seen` + `sigs` so the main loop
// emits its (shim, vt, handle) triple — the per-package Functions table
// self-lists __Package, and its Value field symrefs @__handle.<...>__Package,
// which must be a defined symbol.  Keyed on the fully-qualified
// `<pkg>.__Package` (like every other entry, f.Name form): FuncName mangles
// the dotted name to the same `<pkg>.__Package` function symbol the
// descriptor's accessor defines and the self-entry's Value uses.  No-op
// when PackageAccessorSig is nil (reflect not loaded for this module).
func addPackageAccessorToSeen(m @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	if m.PackageAccessorSig == nil { return seen, sigs }
	var qn @[]char = mangle.QualifyName(modulePkgName, "__Package")
	for s := 0; s < len(seen); s++ {
		if charsEqual(seen[s], qn) { return seen, sigs }
	}
	seen = slices.Append[@[]char](seen, qn)
	sigs = slices.Append[@types.Type](sigs, m.PackageAccessorSig)
	return seen, sigs
}

// funcValueUsesSret reports whether the underlying callee for an
// OP_FUNC_VALUE reference uses the sret return convention
// (`void f(ptr sret(...) align 8, ...args)`).  True for a single
// aggregate result over the target's sret threshold (needsSret), AND for
// a large MULTI-return tuple over the target's return-register budget
// (multiRetResultsNeedSret) — the same decisions emit_debug.bn /
// emit.bn / emit_call.bn apply to the direct callee/declaration/call
// site, so the shim's call to the underlying agrees on whether a retbuf
// pointer is passed.  Without this the shim would emit a register-style
// call against an sret-declared function, producing memory corruption
// when the callee writes the result through what it thinks is the sret
// pointer (which is actually the first user arg).
func funcValueUsesSret(m @ir.Module, name @[]char, fvTyp @types.Type) bool {
	if !isAggregateReturn(fvTyp) { return false }
	if len(fvTyp.Results) > 1 {
		// Large multi-return tuple: sret'd under the target's register-count
		// rule, matching the direct callee (emit_debug.bn's multiRetNeedsSret)
		// and the native func-value shims (isBigMultiReturnArm32 / _x64).  A
		// small tuple stays the raw {..} first-class-aggregate return.  Without
		// this the shim would emit a register-style `call {T1,T2} @f` against a
		// callee now DEFINED `void @f(ptr sret({T1,T2}), …)`, silently
		// corrupting the result — the multi-return analogue of the single-result
		// mismatch guarded below.
		return multiRetResultsNeedSret(fvTyp.Results)
	}
	// Single aggregate result: route through needsSret so the threshold tracks
	// the target's host ABI — 16 bytes on LP64 (AAPCS64 / SysV-AMD64), 4 bytes
	// on ILP32 (AAPCS32 arm32-linux).  Without this, the hardcoded `> 16` path
	// leaves 5..16-byte aggregate-returning func-values at register-style shim
	// emission while pkg/binate/codegen/emit_call.bn and the declaration in
	// emit.bn already emit sret(...) for them on arm32; the caller-vs-callee
	// mismatch silently corrupts the returned struct and the pkg/binate/vm test
	// binary segfaults at init.
	return needsSret(fvTyp.Results[0])
}

// isUniversalTrampoline reports whether the function-value reference
// resolves to one of the universal cross-mode trampolines
// (vm.TrampolineScalar / vm.TrampolineScalar64 / vm.TrampolineAggregate).
// These are special: their `data` parameter IS the closure record (not
// implicit context the shim should strip), so the standard "shim strips
// data" wrapper would route the actual closure rec to the wrong argument
// slot.  emitFuncValueVtable below sets __vt.<mangled>.call to the function
// directly (bypassing __shim) for these names.
func isUniversalTrampoline(mangled @[]char) bool {
	return charsEqual(mangled, mangle.FuncName("pkg/binate/vm", "TrampolineScalar")) ||
			charsEqual(mangled, mangle.FuncName("pkg/binate/vm", "TrampolineScalar64")) ||
			charsEqual(mangled, mangle.FuncName("pkg/binate/vm", "TrampolineAggregate"))
}

// emitFuncValueBackingGlobals lays the @__vt.<mangled> vtable + the
// @__handle.<mangled> function-value block for one func-value reference,
// through the shared irdata.BuildFuncValue builder + emitDataGlobal (the SAME
// terms the native backends lower, so the two cannot drift).  The vtable's
// call slot points at @__shim.<mangled>; a universal trampoline bypasses the
// shim (call slot = the function itself) because its `data` parameter IS the
// closure record, so the standard "shim strips data" wrapper would misroute
// it (see isUniversalTrampoline).  The dtor slot points at the closure-struct
// dtor's HANDLE for a capturing @func whose struct needs destruction (so the
// @func variable's scope-end RefDec walks the vtable to release each managed
// capture before freeing the closure struct), else null.
func emitFuncValueBackingGlobals(out *strings.Builder, mangled @[]char, closureFunc @ir.Func) {
	var callSym @[]char
	if isUniversalTrampoline(mangled) {
		callSym = buf.CopyStr(mangled)
	} else {
		callSym = catSym("__shim.", mangled)
	}
	var dgs @[]@irdata.DataGlobal = irdata.BuildFuncValue(catSym("__vt.", mangled),
			funcValueDtorHandleSym(closureFunc), callSym, catSym("__handle.", mangled))
	for i := 0; i < len(dgs); i++ {
		emitDataGlobal(out, dgs[i])
	}
	return
}

// funcValueDtorHandleSym returns the @__handle.<closure-dtor> symbol for a
// capturing @func whose closure struct needs destruction, else an empty slice
// (a null dtor slot).  The handle is a static %BnFuncValue { vtable, null }
// whose vtable.call shim strips the data slot and tail-calls the closure dtor;
// slot 0 carries the HANDLE (not a raw fn pointer) so rt.ZeroRefDestroy's
// `_call_dtor(dtor, ptr)` — lowered as OP_CALL_HANDLE — dispatches via
// `handle.vtable.call(handle.data, ptr)`.  The matching triple is emitted by
// emitClosureDtorTriples; the symbol matches what generateDtors emits via
// registerClosureStructForCleanup.
func funcValueDtorHandleSym(closureFunc @ir.Func) @[]char {
	if closureFunc == nil || !closureFunc.IsManagedFuncValue || closureFunc.ClosureStruct == nil ||
			!closureFunc.ClosureStruct.NeedsDestruction() {
		var none @[]char
		return none
	}
	return catSym("__handle.", closureStructDtorMangledName(closureFunc.ClosureStruct))
}

// closureStructDtorMangledName builds the LLVM symbol for the closure struct
// dtor — same mangling pkg/binate/mangle's GlobalName produces for
// the unqualified `__dtor_<struct_name>` synthesized by
// generateDtors's Pass 1 for local (no-dot) struct names.  The
// closure-struct Name is always unqualified by construction
// (`__closure_<lit_id>` or `__closure_<wrapper_name>`), so the
// `bn_F...`-mangled `__dtor_<struct_name>` (func-kind) symbol
// reaches the right symbol.  Mirrors `qualifiedDtorNameForType`'s
// non-dot fallback path in pkg/ir/gen_dtor.bn.
func closureStructDtorMangledName(structTyp @types.Type) @[]char {
	var raw @strings.Builder = strings.NewBuilder()
	raw.Write("__dtor_")
	raw.Write(structTyp.Name)
	return mangle.FuncName(modulePkgName, buf.CopyStr(raw.String()))
}

// lookupFuncValueType finds a function in the module by qualified
// name and synthesizes a TYP_FUNC_VALUE from its parameter / result
// signature.  Used by emitFuncValueVtables to back OP_FUNC_HANDLE
// references (whose IR result type is the opaque `*uint8`, not the
// underlying function type) so they get the same per-function
// __shim / __vt / __handle emission as OP_FUNC_VALUE references.
// Returns nil if the function isn't in the module — caller should
// skip emission in that case (cross-module references resolve at
// link time and don't need locally-emitted shims).
func lookupFuncValueType(m @ir.Module, qname @[]char) @types.Type {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if !charsEqual(f.Name, qname) { continue }
		// ir.Param and types.Param have the same shape (Name +
		// Type) but are distinct nominal types; copy field-by-field
		// into a fresh `@[]@types.Param`.
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		return types.MakeFuncValueType(params, f.Results)
	}
	return nil
}
