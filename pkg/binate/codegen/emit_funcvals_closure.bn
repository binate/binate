package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// LLVM emission for the per-(literal, capture-shape) shim that
// backs a capturing function literal (B.2 of plan-function-values
// -phase-2.md).  Split from emit_funcvals.bn to keep both files
// under the hygiene file-length cap; emit_funcvals.bn now keeps
// the non-closure shim path and the vtable / handle backing.

// lookupClosureFunc returns the Func with the given name iff it is
// a capturing-literal closure (IsClosure=true).  Returns nil for
// non-closure refs and for cross-package refs the module doesn't
// own.
func lookupClosureFunc(m @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if !charsEqual(m.Funcs[i].Name, name) { continue }
		if !m.Funcs[i].IsClosure { return nil }
		return m.Funcs[i]
	}
	return nil
}

// emitClosureShim emits the per-(literal, capture-shape) shim for a
// capturing function literal.  The shim signature matches the
// user-visible function-value type (`<ret> (i8* %data, <user_args>)`);
// its body bit-casts %data to the closure struct pointer, loads
// each capture field, then tail-calls the lifted underlying with
// `(captures..., user_args)` — matching the underlying's signature
// where captures are prepended to user-declared params.
//
// Captures may be value (CAP_VAL), raw-pointer (CAP_RAW_PTR), or managed
// (CAP_MANAGED).  A scalar capture loads directly; an aggregate capture loads
// per-field or is passed by-address — `ptr byval(<T>)` for a memory-class or
// >16-byte aggregate, a coerced `[N x iW]` otherwise (emitClosureCaptureLoads).
//
// An aggregate return (a multi-return tuple, or a single result wider
// than a return register) rides the retbuf shim shape via
// emitClosureShimAggregate — the same shape funcSignatureLLVM stamps
// into this closure's vtable slot (`void(i8*, i8*, ...)`).  Without that
// branch the shim returned the aggregate BY VALUE while its vtable
// advertised retbuf, so emitCallFuncValue read the result from a buffer
// the shim never wrote — silent garbage / crash on a managed component.
func emitClosureShim(out *strings.Builder, mangled @[]char, fvTyp @types.Type, f @ir.Func,
		useSret bool) {
	if isAggregateReturn(fvTyp) {
		emitClosureShimAggregate(out, mangled, fvTyp, f, useSret)
		return
	}
	var isVoid bool = len(fvTyp.Results) == 0
	var floatRet bool = resultIsFloatScalar(fvTyp)
	var n int = f.NumCaptureParams
	var closureMangled @[]char = mangle.StructName(modulePkgName, f.ClosureStruct.Name)
	out.Write("define weak_odr ")
	writeShimResultLLVM(out, fvTyp)
	out.Write(" @__shim.")
	out.Write(mangled)
	out.Write("(i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		writeShimParamDecl(out, fvTyp.Params[i].Type, i)
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\n  ")
	// User-arg aggregates still need the pointer→value load.  The lifted
	// underlying's params are [captures..., user-args...] with a non-aggregate
	// return (no sret prefix), so the memory-class flags use closure positions.
	var inMem @[]bool = closureInMemFlags(f, fvTyp, false)
	emitShimArgLoads(out, fvTyp, inMem)
	emitClosureCaptureLoads(out, closureMangled, f, n, false)
	if !isVoid {
		out.Write("%r = ")
	}
	// A scalar-float return bitcasts %r to the int slot after the call, so it
	// can't be a tail call; a byval (memory-class) arg also forbids a tail call
	// (the byval copy is in this shim's frame — a tail call would tear it down
	// before the callee reads it).
	if floatRet || anyInMem(inMem) {
		out.Write("call ")
	} else {
		out.Write("tail call ")
	}
	writeFuncResultsLLVM(out, fvTyp)
	out.Write(" @")
	out.Write(mangled)
	out.WriteByte('(')
	writeClosureUnderlyingArgs(out, fvTyp, f, n, false, false)
	out.Write(")\n  ")
	if isVoid {
		out.Write("ret void\n}\n")
	} else if floatRet {
		out.Write("%rf = bitcast ")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(" %r to ")
		out.Write(shimIntSlotType(fvTyp.Results[0]))
		out.Write("\n  ret ")
		out.Write(shimIntSlotType(fvTyp.Results[0]))
		out.Write(" %rf\n}\n")
	} else {
		out.Write("ret ")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(" %r\n}\n")
	}
	return
}

// emitClosureCaptureLoads bitcasts %data to the closure struct pointer
// (%ctx) and loads each capture field into %cap<i>.  >16-byte aggregate
// captures use the IndirectLargeAggregates convention: the
// underlying function declares the param as
// `ptr`, so only the GEP (%cap<i>_ptr) is emitted — no struct load — and
// the call passes that pointer directly.  Scalars and small aggregates
// load as usual.  Shared by the scalar and aggregate closure shims.
func emitClosureCaptureLoads(out *strings.Builder, closureMangled @[]char, f @ir.Func, n int,
		sretPrefix bool) {
	var capInMem @[]bool = closureCaptureInMemFlags(f, sretPrefix)
	out.Write("%ctx = bitcast i8* %data to %")
	out.Write(closureMangled)
	out.Write("*\n  ")
	for i := 0; i < n; i++ {
		var capTyp @types.Type = f.Params[i].Typ
		var capLL @[]char = llvmType(capTyp)
		out.Write("%cap")
		stringutils.WriteInt(out, i)
		out.Write("_ptr = getelementptr %")
		out.Write(closureMangled)
		out.Write(", %")
		out.Write(closureMangled)
		out.Write("* %ctx, i32 0, i32 ")
		// The capture's LLVM field index, NOT the capture index i: the
		// closure struct is packed with explicit alignment-pad fields
		// (e.g. an int capture followed by a float64 gets a [4 x i8] pad on
		// ILP32, where float64 is 8-aligned), so capture i lives at a padded
		// LLVM index.  The capture WRITER (struct-field store) already maps
		// through structLLVMIndex; the thunk's load must match or it reads the
		// pad as a capture and shifts every later one (dropping the last).
		var llIdx int = i
		if f.ClosureStruct != nil {
			llIdx = structLLVMIndex(f.ClosureStruct, i)
		}
		stringutils.WriteInt(out, llIdx)
		out.Write("\n  ")
		if capInMem[i] {
			// x64 SysV memory-class aggregate capture: passed straight through to
			// the underlying as `ptr byval(<T>)` on the closure-struct field
			// pointer %cap<i>_ptr (writeClosureUnderlyingArgs) — no struct load or
			// [N x iW] coercion, matching the underlying's byval define-line.
			continue
		}
		if capTyp.IsByvalParam() {
			continue
		}
		if types.SysVInSse(capTyp) {
			// x64 SSE capture: load each eightbyte straight from the closure-
			// struct field pointer %cap<i>_ptr into %cap<i>_e<eb> (split), passed
			// by writeClosureUnderlyingArgs — no `[N x iW]` %cap<i>/_ag needed.
			var cp @[]char = sysvName("%cap", i, "_ptr")
			var cb @[]char = sysvName("%cap", i, "")
			sysvEmitAggPtrLoads(out, cp, cb, capTyp)
			continue
		}
		out.Write("%cap")
		stringutils.WriteInt(out, i)
		out.Write(" = load ")
		out.Write(capLL)
		out.Write(", ")
		out.Write(capLL)
		out.Write("* %cap")
		stringutils.WriteInt(out, i)
		out.Write("_ptr\n  ")
		if aggParamCoerced(capTyp) {
			// Coerced in-register-aggregate capture: the lifted body's
			// param is the `[N x iW]` ABI type, so also produce a
			// `[N x iW]` value %cap<i>_ag (store the %S load to a
			// [N x iW] slot, load it back).  writeClosureUnderlyingArgs
			// references %cap<i>_ag for coerced captures.  See
			// emit_agg_coerce.bn.
			out.Write("%cap")
			stringutils.WriteInt(out, i)
			out.Write("_ags = alloca ")
			aggCoerceLLTy(out, capTyp)
			out.Write("\n  store ")
			out.Write(capLL)
			out.Write(" %cap")
			stringutils.WriteInt(out, i)
			out.Write(", ptr %cap")
			stringutils.WriteInt(out, i)
			out.Write("_ags\n  %cap")
			stringutils.WriteInt(out, i)
			out.Write("_ag = load ")
			aggCoerceLLTy(out, capTyp)
			out.Write(", ptr %cap")
			stringutils.WriteInt(out, i)
			out.Write("_ags\n  ")
		}
	}
	return
}

// writeClosureUnderlyingArgs writes the underlying lifted-closure call's
// argument list: the n captures (prepended) followed by the user args.
// Byval-passed captures reuse the GEP pointer (%cap<i>_ptr) directly — no
// load was emitted for them.  leadComma controls whether a comma precedes
// the very first item (true when a prior arg — e.g. an sret retbuf — has
// already been written into the list).  Shared by the scalar and
// aggregate closure shims.
func writeClosureUnderlyingArgs(out *strings.Builder, fvTyp @types.Type, f @ir.Func, n int,
		leadComma bool, sretPrefix bool) {
	// Memory-class flags: user args via closureInMemFlags, captures (the leading
	// n params) via closureCaptureInMemFlags — the same position-aware decision
	// the underlying's define-line byval's.
	var inMem @[]bool = closureInMemFlags(f, fvTyp, sretPrefix)
	var capInMem @[]bool = closureCaptureInMemFlags(f, sretPrefix)
	var wrote bool = leadComma
	for i := 0; i < n; i++ {
		if wrote { out.Write(", ") }
		wrote = true
		if capInMem[i] {
			// Memory-class aggregate capture: pass `ptr byval(<T>) align 8` on the
			// closure-struct field pointer (emitClosureCaptureLoads left only the
			// %cap<i>_ptr GEP), matching the underlying's byval param — not the
			// splittable [N x iW] coercion the aggParamCoerced path would use.
			writeByvalMemType(out, f.Params[i].Typ)
			out.Write(" %cap")
			stringutils.WriteInt(out, i)
			out.Write("_ptr")
			continue
		}
		if types.SysVInSse(f.Params[i].Typ) {
			// x64 SSE capture: split per-eightbyte args (`<eb0> %cap<i>_e0,
			// ...`, from sysvEmitAggPtrLoads on %cap<i>_ptr), matching the
			// lifted underlying's SSE-split capture params.
			var cb @[]char = sysvName("%cap", i, "")
			sysvWriteAggPtrArgs(out, cb, f.Params[i].Typ)
			continue
		}
		writeParamTypeLLVM(out, f.Params[i].Typ)
		out.Write(" %cap")
		stringutils.WriteInt(out, i)
		if f.Params[i].Typ.IsByvalParam() {
			out.Write("_ptr")
		} else if aggParamCoerced(f.Params[i].Typ) {
			out.Write("_ag")
		}
	}
	for i := 0; i < len(fvTyp.Params); i++ {
		if wrote { out.Write(", ") }
		wrote = true
		writeShimUnderlyingArg(out, fvTyp.Params[i].Type, i, inMem[i])
	}
	return
}

// emitClosureShimAggregate emits the retbuf-style shim for a CAPTURING
// closure whose return is aggregate (a multi-return tuple, or a single
// result wider than a return register).  It mirrors
// emitFuncValueShimAggregate (the non-capturing retbuf shim) but loads
// the captures out of %data and prepends them to the underlying call,
// exactly as the scalar closure shim does.
//
//   define weak_odr void @__shim.<m>(i8* %retbuf, i8* %data, <args>) {
//     <load user-arg aggregates>
//     %ctx = bitcast i8* %data to %<closure>*
//     <load captures>
//     %rb = bitcast i8* %retbuf to <ret>*
//     ; useSret: callee writes the result through %rb directly
//     ;   call void @<m>(ptr sret(<ret>) align 8 %rb, captures, args)
//     ; else: callee returns by value; shim stores it through %rb
//     ;   %r = call <ret> @<m>(captures, args); store <ret> %r, <ret>* %rb
//     ret void
//   }
//
// useSret follows funcValueUsesSret: true for a single >register-width
// aggregate result whose underlying lifted function uses the sret
// convention (needsSret), OR a large multi-return tuple over the return-
// register budget (multiRetResultsNeedSret).  A small tuple stays the raw
// {..} first-class-aggregate register-return path below.
func emitClosureShimAggregate(out *strings.Builder, mangled @[]char, fvTyp @types.Type, f @ir.Func,
		useSret bool) {
	var n int = f.NumCaptureParams
	var closureMangled @[]char = mangle.StructName(modulePkgName, f.ClosureStruct.Name)
	out.Write("define weak_odr void @__shim.")
	out.Write(mangled)
	out.Write("(i8* %retbuf, i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		writeShimParamDecl(out, fvTyp.Params[i].Type, i)
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\n  ")
	var inMem @[]bool = closureInMemFlags(f, fvTyp, useSret)
	emitShimArgLoads(out, fvTyp, inMem)
	emitClosureCaptureLoads(out, closureMangled, f, n, useSret)
	// A coerced multi-return callee (funcMultiRetCoerced) returns the per-field-
	// coerced FLAT tuple, so the shim's %rb reinterpret / call / store must spell the
	// coerced type — matching the func-value shim (writeShimResultLLTy).  coercedMR is
	// false whenever useSret (a large multi-return over the return-register budget) or
	// a single-aggregate result, so those keep the raw spelling; the retbuf bytes are
	// byte-identical either way, so the caller's raw load reads the correct value.
	var coercedMR bool = multiRetResultsCoerced(fvTyp.Results)
	// The coerced multi-return path scatters field-by-field to %retbuf (below), so it
	// needs no whole-buffer `%rb` pointer; emit `%rb` only for the sret + raw paths.
	// coercedMR is false whenever useSret, so the sret path always has its %rb.
	if !coercedMR {
		out.Write("%rb = bitcast i8* %retbuf to ")
		writeShimResultLLTy(out, fvTyp, coercedMR)
		out.Write("*\n  ")
	}
	if useSret {
		// Sret call: pass %rb as the callee's sret arg; it writes the
		// aggregate result through it.  (Sret => coercedMR false => raw %rb.)
		out.Write("call void @")
		out.Write(mangled)
		out.Write("(ptr sret(")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(") align 8 %rb")
		writeClosureUnderlyingArgs(out, fvTyp, f, n, true, true)
		out.Write(")\n  ret void\n}\n")
		return
	}
	// Register-return path: callee returns the aggregate by value.
	out.Write("%r = call ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write(" @")
	out.Write(mangled)
	out.WriteByte('(')
	writeClosureUnderlyingArgs(out, fvTyp, f, n, false, false)
	out.Write(")\n  ")
	if coercedMR {
		// Scatter the flat result's fields to their raw FieldOffsets in %retbuf: a whole
		// `store <flat>` into the raw-layout retbuf would misplace a coerced non-word-
		// aligned struct field (see emitScatterFlatValue).
		emitScatterFlatValue(out, multiReturnTupleType(fvTyp.Results), "%r", "%retbuf", "cshim")
		out.Write("  ret void\n}\n")
		return
	}
	// Non-coerced (single-aggregate / raw) result: whole-store through %rb.
	out.Write("store ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write(" %r, ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write("* %rb\n  ret void\n}\n")
	return
}
