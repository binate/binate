package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals_closure.bn — the closure-shim emitter
// (B.2 of plan-function-values-phase-2.md).  Compiles a small
// capturing-literal program and inspects the resulting LLVM IR
// for the expected shim shape: a `__shim.<mangled>` definition
// that bit-casts %data to a closure-struct pointer, loads each
// capture field, and tail-calls the underlying lifted function.
// Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// TestEmitClosureShimBitcast: a capturing literal's shim must
// bitcast %data to the closure-struct pointer type before loading
// any field.  Without this, the LLVM verifier would reject the
// subsequent getelementptr on an unrelated i8* operand.
func TestEmitClosureShimBitcast() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar base int = 10\n"
			"\tvar f *func(int) int = func(x int) int { return base + x }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "%ctx = bitcast i8* %data to %") {
		return fail("expected closure shim to bitcast %data to closure struct")
	}
	return ""
}

// TestEmitClosureShimLoadAndCall: the shim must load each capture
// from the closure struct and pass them as the leading args of the
// underlying tail call.  Verifies the getelementptr / load pattern
// and that the capture arrives before user args in the call.
func TestEmitClosureShimLoadAndCall() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar k int = 7\n"
			"\tvar f *func(int) int = func(x int) int { return k * x }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "%cap0_ptr = getelementptr") {
		return fail("expected shim to GEP into the closure struct")
	}
	if !contains(out, "%cap0 = load") {
		return fail("expected shim to load capture from closure struct")
	}
	if !contains(out, "tail call") {
		return fail("expected shim to tail-call underlying lifted body")
	}
	return ""
}

// TestEmitClosureFuncValueDataSlot: at the literal-construction
// site, the OP_FUNC_VALUE must insert the closure-struct pointer
// (not null) into the function-value's data slot.  Specifically:
// the `.dp = bitcast ... to i8*` path is the B.2 capturing form,
// distinct from Phase 1's `i8* null, 1`.
func TestEmitClosureFuncValueDataSlot() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar base int = 1\n"
			"\tvar f *func() int = func() int { return base }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".dp = bitcast") {
		return fail("expected capturing OP_FUNC_VALUE to bitcast closure ptr into data slot")
	}
	return ""
}

// TestEmitNonCapturingStillHasNullData: regression guard — a
// non-capturing function literal must still emit `i8* null` in the
// data slot (Phase 1 path), not accidentally route through the B.2
// capturing path.
// TestEmitClosureShimByvalCaptureSkipsLoad: a >16-byte aggregate
// capture (e.g. a `@[]int` managed-slice, 32 bytes) is passed to
// the underlying lifted body via the IndirectLargeAggregates
// convention — the underlying takes
// `ptr` for the param.  The shim must therefore pass the GEP'd
// pointer (`%cap0_ptr`) directly without loading the struct value;
// a load would produce a struct value that LLVM rejects as the
// `ptr` argument.  Regression for the bug that surfaced on
// conformance/510 + 514 right after f5340fac landed.
func TestEmitClosureShimByvalCaptureSkipsLoad() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar s @[]int = make_slice(int, 1)\n"
			"\ts[0] = 5\n"
			"\tvar f *func(int) int = func(i int) int { return s[i] }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "%cap0_ptr = getelementptr") {
		return fail("expected shim to GEP into the closure struct")
	}
	if contains(out, "%cap0 = load %BnManagedSlice") {
		return fail("byval capture must not be loaded — passes %cap0_ptr directly as ptr")
	}
	if !contains(out, "ptr %cap0_ptr") {
		return fail("expected tail call to pass %cap0_ptr as the ptr arg")
	}
	return ""
}

// TestEmitClosureMemClassCaptureByval: a ≤16-byte GP-aggregate CAPTURE that
// STRADDLES the SysV reg/stack boundary (memory-class, x64) must be passed to
// the lifted underlying as `ptr byval(<T>) align 8` on its closure-struct field
// pointer — matching the underlying's byval define-line — NOT coerced to a
// splittable `[N x iW]`.  Five int captures fill rdi..r8, so the trailing 16-byte
// Pair capture goes wholly to MEMORY; the pre-fix shim loaded + coerced it to
// `[2 x i64] %cap5_ag` while the body declared `byval`, a define/call ABI
// mismatch that miscompiled on x64 (a0 read the capture's slot -> 222/100 for
// conformance 924).  Forces x64 so the memory-class path fires regardless of the
// host arch (off x64, AAPCS splits and byval is inert — TestAggMemClassX64).
func TestEmitClosureMemClassCaptureByval() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Pair struct { A int\n B int }\n"
			"func main() {\n"
			"\tvar c0 int = 1\n"
			"\tvar c1 int = 2\n"
			"\tvar c2 int = 3\n"
			"\tvar c3 int = 4\n"
			"\tvar c4 int = 5\n"
			"\tvar pcap Pair\n"
			"\tpcap.A = 100\n"
			"\tpcap.B = 200\n"
			"\tvar f *func(int) Pair = func(a0 int) Pair {\n"
			"\t\tvar r Pair\n"
			"\t\tr.A = c0 + c1 + c2 + c3 + c4 + pcap.A + pcap.B\n"
			"\t\tr.B = a0\n"
			"\t\treturn r\n"
			"\t}\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// Reset the live target so later codegen tests keep the LP64/host default.
	setTarget64()
	if !contains(out, "%cap5_ptr = getelementptr") {
		return fail("expected the Pair capture GEP %cap5_ptr")
	}
	if !contains(out, "align 8 %cap5_ptr") {
		return fail("memory-class Pair capture must be passed as `ptr byval(...) align 8 %cap5_ptr`")
	}
	if contains(out, "%cap5_ag") {
		return fail("memory-class Pair capture must NOT be coerced to a splittable [N x iW] (%cap5_ag)")
	}
	if contains(out, "%cap5 = load ") {
		return fail("memory-class Pair capture must NOT be struct-loaded (byval passes the pointer)")
	}
	return ""
}

func TestEmitNonCapturingStillHasNullData() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar f *func(int) int = func(x int) int { return x * 2 }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "i8* null, 1") {
		return fail("non-capturing literal should keep i8* null in data slot")
	}
	return ""
}

// TestEmitClosureShimAggregateReturnUsesRetbuf: a CAPTURING closure
// returning a MULTI-RETURN tuple must emit the retbuf-style shim
// (`void @__shim.<m>(i8* %retbuf, i8* %data)` that stores the result
// through %retbuf) — matching the vtable's `void(i8*, i8*)` call-slot
// type (funcSignatureLLVM → isAggregateReturn) and emitCallFuncValue's
// result-buffer ABI.  The pre-fix shim returned the tuple BY VALUE
// (`<{ i64, i64 }> @__shim.<m>(i8* %data)`) while the call site read a
// retbuf the shim never wrote → silent garbage (managed component →
// crash).  emit_funcvals_closure.bn had no aggregate-return branch.
// (The tuple type is the packed `<{ ... }>` form — anonStructLL.)
func TestEmitClosureShimAggregateReturnUsesRetbuf() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {\n"
			"\tvar n int = 1\n"
			"\tvar f @func() (int, int) = func() (int, int) { return n, n }\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "void @__shim.") {
		return fail("expected aggregate closure shim to use the void retbuf shape")
	}
	if !contains(out, "i8* %retbuf, i8* %data") {
		return fail("expected retbuf shim to take (i8* %retbuf, i8* %data)")
	}
	if !contains(out, "store <{ i64, i64 }> %r") {
		return fail("expected shim to store the packed tuple result through %retbuf")
	}
	if contains(out, "<{ i64, i64 }> @__shim.") {
		return fail("shim must not return the tuple by value (pre-fix bug shape)")
	}
	return ""
}
