package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Closure-dtor handle triples — emitted alongside the per-function
// (shim, vtable, handle) triple in emit_funcvals.bn.
//
// Background: an @func capturing literal needs cleanup at scope end
// — its data slot points at a refcounted closure struct whose
// captured @T / @[]T fields must be RefDec'd before the struct is
// freed.  The cleanup machinery is `emitManagedFuncValueRefDec` →
// `EmitFuncValueDtor` (reads the @func value's vtable[0]) →
// `_call_dtor(dtor, ptr)` inside `rt.ZeroRefDestroy`, which lowers
// as `OP_CALL_HANDLE` (`handle.vtable.call(handle.data, ptr)`).
//
// The dispatch shape forces vtable[0] to store a HANDLE POINTER
// (`*BnFuncValue`), not a raw function pointer — the latter makes
// OP_CALL_HANDLE dereference the dtor function's own machine code
// as if it were a {vtable, data} struct (LP64 / aa64 / x64 happen
// to exit cleanly after a random jump; arm32-baremetal loops).
//
// This file emits the per-closure-literal triple that backs that
// handle pointer.  Mirrors the @T-with-managed-fields path that
// `emitManagedPtrRefDec` already routes through via
// `EmitFuncHandle(qualifiedDtorName)`.

// addImplDtorsToSeen appends each impl's receiver-dtor reference
// to emitFuncValueVtables's `seen` + `sigs` arrays so the main
// emission loop produces the (shim, vt, handle) triple for it.
// Dedups against the existing seen entries — a module that both
// constructs an @Iface from @Recv AND does `@Recv` cleanup
// (which emits an OP_FUNC_HANDLE for the dtor) would otherwise
// double-define `@__handle.<dtor>`.
//
// Skips impls whose receiver type has no dtor (`info.DtorFuncName`
// is empty, or the function isn't in m.Funcs — e.g. cross-package
// referenced impls).  Those keep null in @__ivt slot 0.
func addImplDtorsToSeen(m @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		if len(info.DtorFuncName) == 0 { continue }
		var sigTyp @types.Type = lookupFuncValueType(m, info.DtorFuncName)
		if sigTyp == nil { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charsEqual(seen[s], info.DtorFuncName) {
				dup = true
				break
			}
		}
		if dup { continue }
		seen = slices.Append[@[]char](seen, info.DtorFuncName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// addImplMethodsToSeen appends each impl's interface-method references to
// emitFuncValueVtables's `seen` + `sigs` so the main loop emits their (shim, vt,
// handle) triples.  The raw @__ivt vtable (emitImplVtable, useHandles=true) now
// holds @__handle.<method> in EVERY method slot for EVERY impl; without this
// pre-pass those handles dangle as undefined symbols (an iface impl method like
// errors.errorImpl.Error is on an unexported type, so addExportedFuncsToSeen
// never reaches it).  Mirrors addImplDtorsToSeen (slot 0) for the method slots.
//
// Unlike the parallel @__ivtshim vtable / the descriptor Vtables table (both
// gated non-generic, because a bytecode importer re-lowers its own copy of a
// generic instantiation), this is NOT gated: the raw @__ivt is emitted for
// generic-instantiation impls too, so their method handles must exist.  A
// generic-inst method whose func-value type can't be resolved (not in m.Funcs)
// is skipped by addIfaceMethodsToSeen, so nothing dangles the other way.
func addImplMethodsToSeen(m @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		seen, sigs = addIfaceMethodsToSeen(m, info, info.IfacePkg, info.IfaceName, seen, sigs)
	}
	return seen, sigs
}

// addIfaceMethodsToSeen adds the method references for one (impl, iface) level
// and recurses into the iface's parents — the same own-then-parents walk
// collectImplVtableSlots uses, so the seen set exactly covers the shim vtable's
// method slots.  Skips a method whose func-value type can't be resolved or that
// is already seen (dedup against OP_FUNC_HANDLE refs / other impls sharing it).
func addIfaceMethodsToSeen(m @ir.Module, info @ir.ImplInfo, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, seen @[]@[]char, sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(m, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(m, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		seen, sigs = addIfaceMethodsToSeen(m, info, parentPkgs[i], parentNames[i], seen, sigs)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(m, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncName(info.RecvPkg, info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(m, qualified)
		var sigTyp @types.Type = lookupFuncValueType(m, slotName)
		if sigTyp == nil { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charsEqual(seen[s], slotName) {
				dup = true
				break
			}
		}
		if dup { continue }
		seen = slices.Append[@[]char](seen, slotName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// moduleHasClosureWithDtor reports whether m has at least one
// IsManagedFuncValue closure whose struct needs destruction —
// gates emitFuncValueVtables's "no triples needed" early return so
// modules whose only closure literal is dtor-needing still reach
// emitClosureDtorTriples.
func moduleHasClosureWithDtor(m @ir.Module) bool {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if !f.IsManagedFuncValue { continue }
		if f.ClosureStruct == nil { continue }
		if f.ClosureStruct.NeedsDestruction() { return true }
	}
	return false
}

// emitClosureDtorTriples walks the module's closure literals and
// emits one function-value triple per unique closure-struct dtor.
// The triple = (shim, vtable, handle):
//
//   define weak_odr void @__shim.<dtor>(i8* %data, i8* %ptr) {
//     tail call void @<dtor>(i8* %ptr)
//     ret void
//   }
//   @__vt.<dtor>     = weak_odr constant %BnVtable { null, &shim }
//   @__handle.<dtor> = weak_odr constant %BnFuncValue { &vt, null }
//
// The @func vtable's slot 0 references @__handle.<dtor> as an i8*
// (see emitFuncValueVtableDtor in emit_funcvals.bn).  Dedups by
// mangled dtor name so re-uses across literals (same closure-
// struct shape) share one triple.
func emitClosureDtorTriples(out *strings.Builder, m @ir.Module) {
	var seen @[]@[]char
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if !f.IsManagedFuncValue { continue }
		if f.ClosureStruct == nil { continue }
		if !f.ClosureStruct.NeedsDestruction() { continue }
		var dname @[]char = closureStructDtorMangledName(f.ClosureStruct)
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charsEqual(seen[s], dname) {
				dup = true
				break
			}
		}
		if dup { continue }
		seen = slices.Append[@[]char](seen, dname)
		emitClosureDtorTriple(out, dname)
	}
	return
}

// emitClosureDtorTriple emits one (shim, vtable, handle) triple for
// the closure-struct dtor named `dname` (already fully mangled).
// The shim's `data` argument is unused — the closure-struct dtor
// only needs the payload pointer.  Linkage is weak_odr so the same
// triple emitted in two TUs (two TUs each emit one closure literal
// that happens to share a dtor mangled name) dedupes at link time.
func emitClosureDtorTriple(out *strings.Builder, dname @[]char) {
	// Shim: void(i8* data, i8* ptr) → tail call dtor(ptr).
	writeShimComdatDecl(out, dname)
	out.Write("define weak_odr void @__shim.")
	out.Write(dname)
	out.Write("(i8* %data, i8* %ptr)")
	writeFnDefineAttrs(out)
	writeComdatAttr(out)
	out.Write(" {\n")
	out.Write("  tail call void @")
	out.Write(dname)
	out.Write("(i8* %ptr)\n")
	out.Write("  ret void\n")
	out.Write("}\n")
	// Vtable (dtor slot null, call slot = the shim above) + handle, through
	// the shared irdata.BuildFuncValue builder — so the dtor triple's backing
	// globals share the one func-value layout the main loop uses (a nil
	// closureFunc gives the null dtor slot).
	var noClosure @ir.Func
	emitFuncValueBackingGlobals(out, dname, noClosure)
	return
}
