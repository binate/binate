package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for emit_funcvals_dtor.bn — the closure-dtor handle-triple
// emitter that backs the @func value's vtable slot 0.
//
// The triple `(shim, vt, handle)` for each closure-struct dtor
// makes `rt.ZeroRefDestroy`'s `_call_dtor(dtor, ptr)` — which
// lowers as `OP_CALL_HANDLE` — dispatchable: it expects `dtor` to
// be a `*BnFuncValue` handle pointer, not a raw fn pointer.  The
// regression these tests pin is the original B.3b commit 2 shape
// where the @func vtable[0] stored the raw dtor fn pointer
// directly — which made OP_CALL_HANDLE byte-pun-read the dtor's
// own machine code as if it were a {vtable, data} struct.  Helpers
// (compileToLLVM, contains, fail) live in emit_test.bn.

// TestEmitClosureDtorTripleShim: a capturing @func literal whose
// struct needs destruction must emit a `@__shim.<dtor>` whose
// signature is `void(i8* data, i8* ptr)` and whose body tail-
// calls the closure-struct dtor with `ptr`, discarding `data`.
// Pins the shim shape OP_CALL_HANDLE's dispatch invokes.
func TestEmitClosureDtorTripleShim() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Box struct { N int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b @Box = make(Box)\n")
	cb = cb.WriteStr("\tb.N = 1\n")
	cb = cb.WriteStr(
		"\tvar f @func() int = func() int { return b.N }\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out,
			"define weak_odr void @__shim.bn_main____dtor") {
		return fail(
			"expected dtor shim definition for closure struct")
	}
	if !contains(out, "(i8* %data, i8* %ptr) {") {
		return fail("expected dtor shim to take (data, ptr)")
	}
	if !contains(out, "tail call void @bn_main____dtor") {
		return fail(
			"expected dtor shim to tail-call closure-struct dtor")
	}
	return ""
}

// TestEmitClosureDtorTripleVt: the dtor vtable for a capturing
// @func literal must have slot 0 = null (the dtor itself has no
// captures) and slot 1 = the dtor shim.  Pins the
// %BnVtable literal so OP_CALL_HANDLE finds the shim at vt[1].
func TestEmitClosureDtorTripleVt() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Box struct { N int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b @Box = make(Box)\n")
	cb = cb.WriteStr("\tb.N = 1\n")
	cb = cb.WriteStr(
		"\tvar f @func() int = func() int { return b.N }\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out,
			"@__vt.bn_main____dtor___closure___funclit_0 ") {
		return fail("expected @__vt.<dtor> definition for closure")
	}
	if !contains(out,
			"constant %BnVtable { i8* null, i8* bitcast") {
		return fail("expected dtor vtable slot 0=null, slot 1=shim")
	}
	return ""
}

// TestEmitClosureDtorTripleHandle: the per-closure dtor handle
// must be defined as `%BnFuncValue { &vt, null }` so OP_CALL_HANDLE
// reads vt from handle[0] and a null data pointer from handle[1].
// Together with the vtable test above this pins the full dispatch
// shape ZeroRefDestroy's `_call_dtor` lowering walks.
func TestEmitClosureDtorTripleHandle() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Box struct { N int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b @Box = make(Box)\n")
	cb = cb.WriteStr("\tb.N = 1\n")
	cb = cb.WriteStr(
		"\tvar f @func() int = func() int { return b.N }\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out,
			"@__handle.bn_main____dtor___closure___funclit_0 ") {
		return fail("expected @__handle.<dtor> definition")
	}
	if !contains(out,
			"%BnVtable* @__vt.bn_main____dtor___closure___funclit_0 to i8*), i8* null }") {
		return fail(
			"expected dtor handle { &vt, null }")
	}
	return ""
}

// TestEmitClosureFuncVtablePointsAtDtorHandle: this is the
// critical-bug guard — the @func value's vtable slot 0 MUST hold
// the dtor's HANDLE POINTER, not the raw dtor fn pointer.  The
// pre-fix shape stored `bitcast (void(i8*)* @<dtor> to i8*)` which
// made OP_CALL_HANDLE dereference the dtor's machine code as if it
// were a vtable.  Pinning the post-fix bitcast (`%BnFuncValue*
// @__handle.<dtor>`) prevents the regression.
func TestEmitClosureFuncVtablePointsAtDtorHandle() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Box struct { N int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b @Box = make(Box)\n")
	cb = cb.WriteStr("\tb.N = 1\n")
	cb = cb.WriteStr(
		"\tvar f @func() int = func() int { return b.N }\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out,
			"@__vt.bn_main____funclit_0 = weak_odr constant %BnVtable") {
		return fail("expected @func vtable definition")
	}
	if !contains(out,
			"bitcast (%BnFuncValue* @__handle.bn_main____dtor___closure___funclit_0 to i8*)") {
		return fail(
			"expected @func vtable slot 0 = bitcast of dtor HANDLE pointer")
	}
	if contains(out,
			"bitcast (void(i8*)* @bn_main____dtor___closure___funclit_0 to i8*)") {
		return fail(
			"@func vtable slot 0 must NOT bitcast raw closure dtor fn ptr — that crashes OP_CALL_HANDLE")
	}
	return ""
}

// TestEmitNonCapturingDtorTripleSkipped: a non-capturing @func or
// a capturing literal whose closure struct has no managed fields
// shouldn't trigger dtor-triple emission — there's nothing for the
// dtor to clean up, and the vtable's slot 0 stays null.  Pinning
// "no dtor triple" prevents the triple from accidentally bloating
// every module.
func TestEmitNonCapturingDtorTripleSkipped() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar k int = 7\n")
	cb = cb.WriteStr(
		"\tvar f @func() int = func() int { return k }\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if contains(out, "@__shim.bn_main____dtor___closure") {
		return fail(
			"closure with no managed captures should not emit a dtor triple")
	}
	if contains(out, "@__handle.bn_main____dtor___closure") {
		return fail(
			"closure with no managed captures should not emit a dtor handle")
	}
	return ""
}
