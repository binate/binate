package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals_packed.bn: the LLVM @__shimP.<m> packed-dispatch shim
// (the func-value vtable's slot-2 call_packed target).  Structural checks that
// the shim is emitted with the packed-args entry and forwards to @__shim; step
// 4's e2e/conformance exercises it end-to-end.

// A scalar func value gets a @__shimP that inttoptr's the packed args pointer,
// then calls @__shim (the real-ABI shim it forwards to).
func TestEmitFuncValuePackedShimScalar() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func add(a int, b int) int { return a + b }\n"
			"func main() {\n"
			"\tvar f *func(int, int) int = add\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define weak_odr i64 @__shimP.") {
		return fail("expected a @__shimP.<m> packed-dispatch shim define")
	}
	if !contains(out, "%args = inttoptr i64 %pa0 to i8*") {
		return fail("__shimP must inttoptr the packed args pointer (pa0)")
	}
	// The host is LP64, so `add`'s int result is i64 — __shimP does
	// `%r = call i64 @__shim.<add>(...)`.
	if !contains(out, "call i64 @__shim.") {
		return fail("__shimP (scalar shape) must call @__shim for the result")
	}
	return ""
}

// An aggregate-return func value gets a @__shimP that inttoptr's the retbuf
// (pa2) and calls the void retbuf-shaped @__shim.
func TestEmitFuncValuePackedShimAggregateRet() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int\n b int\n c int }\n"
			"func mk() Big {\n"
			"\tvar r Big\n"
			"\treturn r\n"
			"}\n"
			"func main() {\n"
			"\tvar f *func() Big = mk\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "define weak_odr i64 @__shimP.") {
		return fail("expected a @__shimP.<m> packed-dispatch shim define")
	}
	if !contains(out, "%rb = inttoptr i64 %pa2 to i8*") {
		return fail("__shimP (aggregate shape) must inttoptr the retbuf (pa2)")
	}
	if !contains(out, "call void @__shim.") {
		return fail("__shimP (aggregate shape) must call the void retbuf @__shim")
	}
	return ""
}

// On ELF (emitUseComdat) @__shimP.<m> must declare its OWN `$__shimP.<m> = comdat
// any` to match its bare `comdat` attr — NOT re-use writeShimComdatDecl's
// `$__shim.<m>` (already emitted for the sibling __shim), which would both
// redefine that comdat AND leave @__shimP's comdat undefined (two clang parse
// errors on every ELF func-value module).  This class of bug is invisible on the
// comdat-off (Mach-O) host, so exercise comdat-on explicitly; emitUseComdat is
// process-global, so restore it before asserting.  Mirrors
// TestEmitFuncValueShimComdatWiring.
func TestEmitFuncValuePackedShimComdatELF() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noFnParams @[]@ir.Param
	var fnResults @[]@types.Type = make_slice(@types.Type, 1)
	fnResults[0] = types.TypInt()
	var helperFn @ir.Func = ir.NewFunc("", "helper", noFnParams, fnResults)
	var helperEntry @ir.Block = ir.AddBlock(helperFn, "entry")
	var zeroInstr @ir.Instr = irbuild.EmitConstInt(helperEntry, 0, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = zeroInstr
	irbuild.EmitReturn(helperEntry, retArgs)
	m.AddFunc(helperFn)

	var noMainParams @[]@ir.Param
	var noMainResults @[]@types.Type
	var mainFn @ir.Func = ir.NewFunc("", "main", noMainParams, noMainResults)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var noFvParams @[]@types.Param
	var fvResults @[]@types.Type = make_slice(@types.Type, 1)
	fvResults[0] = types.TypInt()
	var fvTyp @types.Type = types.MakeFuncValueType(noFvParams, fvResults)
	irbuild.EmitFuncValue(entry, "helper", fvTyp)
	var noRetArgs @[]@ir.Instr
	irbuild.EmitReturn(entry, noRetArgs)
	m.AddFunc(mainFn)

	SetEmitComdat(true)
	var on @[]char = EmitModule(m)
	SetEmitComdat(false)
	if !contains(on, "$__shimP.") {
		return fail("ELF: @__shimP must declare its OWN `$__shimP... = comdat any`")
	}
	if !contains(on, "@__shimP.") {
		return fail("expected a @__shimP define")
	}
	return ""
}

// On ILP32 (arm32) the packed-args params and their inttoptr are the TARGET INT
// type (i32), NOT a hardcoded i64.  __shimP is invoked via `_call_shim_scalar64(fn,
// data, a0..a6)` whose a-args are word-sized `int`; an i64 param under AAPCS32 is an
// even-aligned register PAIR, so a hardcoded-i64 %pa0 would be fetched from the wrong
// registers than the word-sized args the caller placed (the args pointer lands in R1,
// but an i64 %pa0 reads R2:R3) — the arm32_linux_int crash on native aggregate func
// values (879/881/882).  The i64 RETURN stays (matches _call_shim_scalar64's int64).
func TestEmitFuncValuePackedShimILP32Params() testing.TestResult {
	setTargetArm32()
	var src *[]readonly char = "package \"main\"\n"
			"func add(a int, b int) int { return a + b }\n"
			"func main() {\n"
			"\tvar f *func(int, int) int = add\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	if !contains(out, "define weak_odr i64 @__shimP.") {
		return fail("ILP32: __shimP must still return i64 (matches _call_shim_scalar64)")
	}
	if !contains(out, "i32 %pa0, i32 %pa1") {
		return fail("ILP32: __shimP packed-args params must be i32, not a hardcoded i64")
	}
	if !contains(out, "%args = inttoptr i32 %pa0 to i8*") {
		return fail("ILP32: __shimP must inttoptr the packed args pointer as i32")
	}
	return ""
}

// ILP32 aggregate-return variant of TestEmitFuncValuePackedShimILP32Params: the
// retbuf inttoptr (`%rb = inttoptr iw %pa2`) must also be i32 on ILP32.  This is
// the exact shape the arm32_linux_int crash hit — native cross-package aggregate
// returns (879/881/882) route through __shimP's retbuf path — so pin pa2 on ILP32
// directly (the scalar test above covers pa0).
func TestEmitFuncValuePackedShimILP32AggregateRetbuf() testing.TestResult {
	setTargetArm32()
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int\n b int\n c int }\n"
			"func mk() Big {\n"
			"\tvar r Big\n"
			"\treturn r\n"
			"}\n"
			"func main() {\n"
			"\tvar f *func() Big = mk\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	if !contains(out, "%rb = inttoptr i32 %pa2 to i8*") {
		return fail("ILP32: __shimP (aggregate) must inttoptr the retbuf (pa2) as i32, not i64")
	}
	return ""
}
