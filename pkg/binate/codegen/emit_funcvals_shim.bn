package "pkg/binate/codegen"

import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Function-value LLVM shim emission
// ============================================================
//
// The per-function `@__shim.<mangled>` wrappers that adapt a function
// value's `{vtable, data}` calling convention to the underlying function.
// Split out of emit_funcvals.bn; shared helpers (isAggregateReturn /
// isAggregateArg / writeFuncResultsLLVM / shimParamType / llvmType) live
// there (same package).

// emitFuncValueShim emits the per-function shim wrapper.
//
// Scalar/void return — Phase 3's always-shim shape:
//   define <ret> @__shim.<m>(i8* %data, <args>) {
//     <ret> %r = tail call <ret> @<m>(<args>)
//     ret <ret> %r
//   }
//
// Aggregate return — retbuf-style shim:
//   define void @__shim.<m>(i8* %retbuf, i8* %data, <args>) {
//     <ret> %r = call <ret> @<m>(<args>)
//     <ret>* %rb = bitcast i8* %retbuf to <ret>*
//     store <ret> %r, <ret>* %rb
//     ret void
//   }
// The retbuf shape lets bytecode dispatchers (dispatchExternBinding,
// dispatchCompiledFuncValue) capture the full multi-word result via
// a fixed-shape rt._call_shim_aggregate helper.  The compiled-side
// caller (emitCallFuncValue) allocates retbuf, calls the shim, and
// loads the result back.
//
// data is unused in non-capturing function values (Phase 1); future
// Phase 2 closures will populate it.  weak_odr lets cross-TU
// duplicate shims dedupe at link time.
func emitFuncValueShim(out *strings.Builder, mangled @[]char, fvTyp @types.Type, useSret bool) {
	if isAggregateReturn(fvTyp) {
		emitFuncValueShimAggregate(out, mangled, fvTyp, useSret)
		return
	}
	var isVoid bool = len(fvTyp.Results) == 0
	var floatRet bool = resultIsFloatScalar(fvTyp)
	out.Write("define weak_odr ")
	writeShimResultLLVM(out, fvTyp)
	out.Write(" @__shim.")
	out.Write(mangled)
	out.Write("(i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		writeShimParamDecl(out, fvTyp.Params[i].Type, i)
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\n  ")
	// Load aggregate args from their pointer slots before calling the
	// underlying.  Scalars pass through unchanged.  A non-aggregate-return
	// underlying takes no sret prefix, so the memory-class flags use the bare
	// param positions.
	var inMem @[]bool = shimInMemFlags(fvTyp, false)
	emitShimArgLoads(out, fvTyp, inMem)
	if !isVoid {
		out.Write("%r = ")
	}
	// A scalar-float return must bitcast %r (natural) to the int slot
	// after the call, so it can't be a tail call; a byval (memory-class)
	// arg also forbids a tail call (the byval copy is in this shim's frame,
	// which a tail call would tear down before the callee reads it —
	// use-after-free); everything else stays a tail call.
	if floatRet || anyInMem(inMem) {
		out.Write("call ")
	} else {
		out.Write("tail call ")
	}
	writeFuncResultsLLVM(out, fvTyp)
	out.Write(" @")
	out.Write(mangled)
	out.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { out.Write(", ") }
		writeShimUnderlyingArg(out, fvTyp.Params[i].Type, i, inMem[i])
	}
	out.Write(")\n  ")
	if isVoid {
		out.Write("ret void\n}\n")
	} else if floatRet {
		out.Write("%rf = bitcast ")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(" %r to ")
		out.Write(shimIntSlotType(fvTyp.Results[0]))
		out.Write("\n  ret ")
		out.Write(shimIntSlotType(fvTyp.Results[0]))
		out.Write(" %rf\n}\n")
	} else {
		out.Write("ret ")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(" %r\n}\n")
	}
	return
}

// writeShimParamDecl writes the comma-prefixed shim DEFINITION parameter(s)
// for one user arg i: `, i32 %a<i>_lo, i32 %a<i>_hi` for a 64-bit scalar split
// on ILP32 (is64ScalarShimSplit), otherwise `, <shimParamType> %a<i>`.  The
// body reassembles the two halves (emitShimArgLoads) and references the
// reassembled value (writeShimArgRef).  Shared by all four shim-def emitters
// (scalar/aggregate + closure scalar/aggregate) so their signatures cannot
// drift from funcSignatureLLVM / the native caller arg list.
func writeShimParamDecl(out *strings.Builder, t @types.Type, i int) {
	if is64ScalarShimSplit(t) {
		out.Write(", i32 %a")
		stringutils.WriteInt(out, i)
		out.Write("_lo, i32 %a")
		stringutils.WriteInt(out, i)
		out.Write("_hi")
		return
	}
	out.Write(", ")
	out.Write(shimParamType(t))
	out.Write(" %a")
	stringutils.WriteInt(out, i)
}

// emitShimArgLoads emits LLVM `load` instructions for each aggregate
// arg in the shim's signature, producing %a<i>_v values that hold the
// dereferenced aggregate.  Scalars don't need loading; they pass
// through as %a<i>.  A 64-bit scalar split into two i32 slots on ILP32
// is reassembled here into %a<i>_v (i64) / %a<i>_f (double).
func emitShimArgLoads(out *strings.Builder, fvTyp @types.Type, inMemFlags @[]bool) {
	for i := 0; i < len(fvTyp.Params); i++ {
		var pt @types.Type = fvTyp.Params[i].Type
		if inMemFlags[i] {
			// x64 SysV memory-class aggregate: passed straight through to the
			// underlying as `ptr byval(<T>)` on the incoming pointer arg
			// %a<i> (writeShimUnderlyingArg) — no load / coercion here.
			continue
		}
		if is64ScalarShimSplit(pt) {
			// Reassemble the i64 from two i32 slots (little-endian: lo,
			// hi) — the same uint32 zero-extend as the VM's joinInt64,
			// so a high-bit-set low half doesn't sign-pollute the top.
			out.Write("%a")
			stringutils.WriteInt(out, i)
			out.Write(".l64 = zext i32 %a")
			stringutils.WriteInt(out, i)
			out.Write("_lo to i64\n  %a")
			stringutils.WriteInt(out, i)
			out.Write(".h64 = zext i32 %a")
			stringutils.WriteInt(out, i)
			out.Write("_hi to i64\n  %a")
			stringutils.WriteInt(out, i)
			out.Write(".hs = shl i64 %a")
			stringutils.WriteInt(out, i)
			out.Write(".h64, 32\n  %a")
			stringutils.WriteInt(out, i)
			out.Write("_v = or i64 %a")
			stringutils.WriteInt(out, i)
			out.Write(".l64, %a")
			stringutils.WriteInt(out, i)
			out.Write(".hs\n  ")
			if isFloatScalarParam(pt) {
				// float64: bitcast the reassembled i64 back to double
				// for the underlying call (writeShimArgRef -> %a<i>_f).
				out.Write("%a")
				stringutils.WriteInt(out, i)
				out.Write("_f = bitcast i64 %a")
				stringutils.WriteInt(out, i)
				out.Write("_v to double\n  ")
			}
			continue
		}
		if isFloatScalarParam(pt) {
			// The arg arrives as an integer slot (shimIntSlotType);
			// bitcast it back to the natural float type so the
			// underlying call places it in a float register.  The
			// underlying-call arg ref is %a<i>_f (writeShimArgRef).
			out.Write("%a")
			stringutils.WriteInt(out, i)
			out.Write("_f = bitcast ")
			out.Write(shimIntSlotType(pt))
			out.Write(" %a")
			stringutils.WriteInt(out, i)
			out.Write(" to ")
			out.Write(llvmType(pt))
			out.Write("\n  ")
			continue
		}
		if pt.IsByvalParam() {
			// >16-byte aggregate: passed straight through to the
			// underlying as a `ptr` (the incoming i8* %a<i>, which the
			// callee copies into its own slot) — no deref/load here.
			continue
		}
		if aggParamCoerced(pt) {
			// In-register named-struct/array arg: passed by-address as an i8*
			// (shimParamType).  x64 SSE loads each eightbyte straight from the
			// pointer image into %a<i>_e<eb> (split, passed by
			// sysvWriteAggPtrArgs); the GP path loads the one `[N x iW]` value
			// %a<i>_v (writeShimArgRef).
			if types.SysVInSse(pt) {
				var an @[]char = sysvName("%a", i, "")
				sysvEmitAggPtrLoads(out, an, an, pt)
				continue
			}
			out.Write("%a")
			stringutils.WriteInt(out, i)
			out.Write("_p = bitcast i8* %a")
			stringutils.WriteInt(out, i)
			out.Write(" to ")
			aggCoerceLLTy(out, pt)
			out.Write("*\n  %a")
			stringutils.WriteInt(out, i)
			out.Write("_v = load ")
			aggCoerceLLTy(out, pt)
			out.Write(", ")
			aggCoerceLLTy(out, pt)
			out.Write("* %a")
			stringutils.WriteInt(out, i)
			out.Write("_p\n  ")
			continue
		}
		if !isAggregateArg(pt) { continue }
		out.Write("%a")
		stringutils.WriteInt(out, i)
		out.Write("_p = bitcast i8* %a")
		stringutils.WriteInt(out, i)
		out.Write(" to ")
		out.Write(llvmType(pt))
		out.Write("*\n  %a")
		stringutils.WriteInt(out, i)
		out.Write("_v = load ")
		out.Write(llvmType(pt))
		out.Write(", ")
		out.Write(llvmType(pt))
		out.Write("* %a")
		stringutils.WriteInt(out, i)
		out.Write("_p\n  ")
	}
	return
}

// writeShimUnderlyingArg writes ONE underlying-call arg for shim param i:
// x64 SSE splits the by-address aggregate into per-eightbyte register args
// (`<eb0> %a<i>_e0, <eb1> %a<i>_e1`, from sysvEmitAggPtrLoads), matching the
// SSE-split underlying define; otherwise the GP `<type> <ref>`
// (writeParamTypeLLVM + writeShimArgRef).  The caller emits the leading ", "
// that separates this arg from the previous one.
func writeShimUnderlyingArg(out *strings.Builder, t @types.Type, i int, inMem bool) {
	if inMem {
		// x64 SysV memory-class aggregate: pass the incoming by-address pointer
		// %a<i> as `ptr byval(<T>) align 8`, so LLVM lays the whole aggregate on
		// the outgoing stack — matching the underlying's byval define-line.
		writeByvalMemType(out, t)
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		return
	}
	if types.SysVInSse(t) {
		var an @[]char = sysvName("%a", i, "")
		sysvWriteAggPtrArgs(out, an, t)
		return
	}
	writeParamTypeLLVM(out, t)
	writeShimArgRef(out, t, i)
	return
}

// writeShimArgRef writes the arg reference used in the underlying-
// call argument list.  For aggregate args, it's `%a<i>_v` (the
// loaded value).  For scalars, it's `%a<i>` (the parameter
// directly).  A leading space is included for readability after
// the type.
func writeShimArgRef(out *strings.Builder, t @types.Type, i int) {
	if is64ScalarShimSplit(t) {
		// 64-bit scalar reassembled from two i32 slots (emitShimArgLoads):
		// the natural i64 value %a<i>_v, or the float64 %a<i>_f.
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		if isFloatScalarParam(t) {
			out.Write("_f")
		} else {
			out.Write("_v")
		}
		return
	}
	if t.IsByvalParam() {
		// >16-byte aggregate: pass the incoming pointer arg directly
		// (%a<i> is the i8* the underlying's `ptr` param expects), not a
		// loaded-back value.
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		return
	}
	if aggParamCoerced(t) {
		// Coerced in-register aggregate: passed by-address; use the
		// `[N x iW]` value loaded from the pointer (emitShimArgLoads).
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		out.Write("_v")
		return
	}
	if isAggregateArg(t) {
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		out.Write("_v")
		return
	}
	if isFloatScalarParam(t) {
		// The natural-float value materialized from the int slot by
		// emitShimArgLoads (%a<i>_f).
		out.Write(" %a")
		stringutils.WriteInt(out, i)
		out.Write("_f")
		return
	}
	out.Write(" %a")
	stringutils.WriteInt(out, i)
	return
}

// emitFuncValueShimAggregate emits the retbuf-style aggregate shim.
// Called from emitFuncValueShim when the return type is multi-word.
// Aggregate args still use the pointer-arg convention (shim derefs).
//
// useSret indicates whether the underlying callee is a C-extern with
// >16-byte return that uses the C-ABI sret convention.  When true,
// the shim passes retbuf directly as the callee's first sret arg
// (bypassing the intermediate %r value).  When false, the callee
// returns the aggregate by value and the shim stores the result
// through retbuf.
func emitFuncValueShimAggregate(out *strings.Builder, mangled @[]char, fvTyp @types.Type,
		useSret bool) {
	out.Write("define weak_odr void @__shim.")
	out.Write(mangled)
	out.Write("(i8* %retbuf, i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		writeShimParamDecl(out, fvTyp.Params[i].Type, i)
	}
	out.WriteByte(')')
	writeFnDefineAttrs(out)
	out.Write(" {\n  ")
	// Load aggregate args (if any) before calling the underlying.  A C-sret
	// underlying prepends the retbuf pointer (useSret), shifting the memory-class
	// arg positions; the register-return path does not.
	var inMem @[]bool = shimInMemFlags(fvTyp, useSret)
	emitShimArgLoads(out, fvTyp, inMem)
	if useSret {
		// Sret call: pass retbuf as the sret arg directly; the
		// callee writes the aggregate result through it.
		out.Write("%rb = bitcast i8* %retbuf to ")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write("*\n  ")
		out.Write("call void @")
		out.Write(mangled)
		out.Write("(ptr sret(")
		writeFuncResultsLLVM(out, fvTyp)
		out.Write(") align 8 %rb")
		for i := 0; i < len(fvTyp.Params); i++ {
			out.Write(", ")
			writeShimUnderlyingArg(out, fvTyp.Params[i].Type, i, inMem[i])
		}
		out.Write(")\n  ret void\n}\n")
		return
	}
	// Register-return path: callee returns the aggregate by value (no sret
	// pointer prefix).  A coerced multi-return callee (funcMultiRetCoerced)
	// returns the per-field-coerced tuple, so the shim's call + store spell the
	// coerced type; the retbuf holds byte-identical bytes, so the caller's raw
	// load still reads the correct value.
	var coercedMR bool = multiRetResultsCoerced(fvTyp.Results)
	out.Write("%r = call ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write(" @")
	out.Write(mangled)
	out.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { out.Write(", ") }
		writeShimUnderlyingArg(out, fvTyp.Params[i].Type, i, inMem[i])
	}
	out.Write(")\n  ")
	if coercedMR {
		// Scatter the flat result's fields to their raw FieldOffsets in %retbuf: a whole
		// `store <flat>` into the raw-layout retbuf would misplace a coerced non-word-
		// aligned struct field (see emitScatterFlatValue).
		emitScatterFlatValue(out, multiReturnTupleType(fvTyp.Results), "%r", "%retbuf", "shim")
		out.Write("  ret void\n}\n")
		return
	}
	out.Write("%rb = bitcast i8* %retbuf to ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write("*\n  ")
	out.Write("store ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write(" %r, ")
	writeShimResultLLTy(out, fvTyp, coercedMR)
	out.Write("* %rb\n  ret void\n}\n")
	return
}
