package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals_shim.bn — the per-function `@__shim.<mangled>`
// aggregate-return wrappers. Helpers (contains, fail, EmitModule,
// setTarget64) live in the sibling codegen test files (same package).

// TestEmitFuncValueShimAggregateSret: when a function value
// references a C-extern with a >16-byte return, the aggregate-shim
// must use sret convention (`call void @fn(ptr sret(...) align 8
// %rb, ...)`) — NOT the register-style `%r = call <ret> @fn(...)`
// shape it would otherwise emit.  Without this, the shim's call
// signature mismatches the declared sret signature and the callee
// writes the result through what it thinks is the sret pointer
// (the first user arg's value), corrupting memory.
//
// Surfaced by trying to register `bootstrap.ReadDir` (which returns
// @[]@[]char = 32 bytes, IsCExtern) directly through the
// vm.Externs registry: cmd/bni built fine but builder-comp-int-int
// 313/317 tests failed because the inner cmd/bni's loader.bn
// got back garbage from ReadDir.
func TestEmitFuncValueShimAggregateSret() testing.TestResult {
	setTarget64()
	// Build: an IsCExtern function `buf.Concat(*[]readonly char,
	// *[]readonly char) @[]char` (32-byte managed-slice return),
	// plus a free function in the same module that references it
	// via OP_FUNC_VALUE so the shim gets emitted.
	var m @ir.Module = ir.NewModule("\"main\"")

	var concatParams @[]@ir.Param = make_slice(@ir.Param, 2)
	var p1 @ir.Param = make(ir.Param)
	p1.Name = "a"
	p1.Typ = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	concatParams[0] = p1
	var p2 @ir.Param = make(ir.Param)
	p2.Name = "b"
	p2.Typ = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	concatParams[1] = p2
	var concatResults @[]@types.Type = make_slice(@types.Type, 1)
	concatResults[0] = types.MakeManagedSliceType(types.TypChar())
	var concatFn @ir.Func =
		ir.NewExternFunc("", "pkg/binate/buf.Concat", concatParams, concatResults)
	concatFn.IsCExtern = true
	m.AddFunc(concatFn)

	// `func main() { var f *func(...) @[]char = buf.Concat }`
	// — emits OP_FUNC_VALUE for "pkg/binate/buf.Concat" so the shim is
	// generated.
	var mainNoParams @[]@ir.Param
	var mainNoResults @[]@types.Type
	var mainFn @ir.Func =
		ir.NewFunc("", "main", mainNoParams, mainNoResults)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var fvParams @[]@types.Param = make_slice(@types.Param, 2)
	var fp1 @types.Param = make(types.Param)
	fp1.Name = "a"
	fp1.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	fvParams[0] = fp1
	var fp2 @types.Param = make(types.Param)
	fp2.Name = "b"
	fp2.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	fvParams[1] = fp2
	var fvResults @[]@types.Type = make_slice(@types.Type, 1)
	fvResults[0] = types.MakeManagedSliceType(types.TypChar())
	var fvTyp @types.Type = types.MakeFuncValueType(fvParams, fvResults)
	entry.EmitFuncValue("pkg/binate/buf.Concat", fvTyp)
	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)
	m.AddFunc(mainFn)

	var out @[]char = EmitModule(m)

	// The emitted aggregate-shim should pass retbuf as the sret
	// arg — NOT call the C-extern as if it returned the aggregate
	// in registers.
	if !contains(out,
		"call void @bn_F3_3_pkg6_binate3_buf1_6_Concat(ptr sret(%BnManagedSlice) align 8 %rb") {
		return fail("aggregate-shim must dispatch IsCExtern callee with sret convention")
	}
	// And it must NOT contain the register-return form for this
	// callee (which would mismatch the sret-declared signature).
	if contains(out, "%r = call %BnManagedSlice @bn_F3_3_pkg6_binate3_buf1_6_Concat") {
		return fail("aggregate-shim must not emit register-style call for sret callee")
	}
	return ""
}

// TestEmitFuncValueShimAggregateUsesSret: a Binate (non-CExtern)
// function value with aggregate return >16 bytes uses the sret
// dispatch form — post round-5, pkg/binate/codegen forces sret universally
// so LLVM's per-shape pack-vs-sret heuristic can't break the
// caller/callee convention.  Confirms funcValueUsesSret no longer
// gates on IsCExtern.
func TestEmitFuncValueShimAggregateUsesSret() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noFnParams @[]@ir.Param
	var fnResults @[]@types.Type = make_slice(@types.Type, 1)
	fnResults[0] = types.MakeManagedSliceType(types.TypChar())
	var helperFn @ir.Func =
		ir.NewFunc("", "getSlice", noFnParams, fnResults)
	var helperEntry @ir.Block = ir.AddBlock(helperFn, "entry")
	var nilInstr @ir.Instr =
		helperEntry.EmitConstNil(fnResults[0])
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = nilInstr
	helperEntry.EmitReturn(retArgs)
	m.AddFunc(helperFn)

	var noMainParams @[]@ir.Param
	var noMainResults @[]@types.Type
	var mainFn @ir.Func =
		ir.NewFunc("", "main", noMainParams, noMainResults)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var noFvParams @[]@types.Param
	var fvResults @[]@types.Type = make_slice(@types.Type, 1)
	fvResults[0] = types.MakeManagedSliceType(types.TypChar())
	var fvTyp @types.Type = types.MakeFuncValueType(noFvParams, fvResults)
	entry.EmitFuncValue("getSlice", fvTyp)
	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)
	m.AddFunc(mainFn)

	var out @[]char = EmitModule(m)

	// The shim's call MUST be the sret form (universal post round-5).
	if !contains(out, "call void @bn_F1_4_main1_8_getSlice(ptr sret(%BnManagedSlice) align 8") {
		return fail("aggregate-shim for Binate callee must use sret form")
	}
	return ""
}
