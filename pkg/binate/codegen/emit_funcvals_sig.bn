package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Function-value LLVM type / signature formatting
// ============================================================
//
// Pure type->LLVM-string helpers shared by the func-value shim, vtable,
// and call-site emitters (emit_funcvals.bn / emit_funcvals_shim.bn).
// They translate a TYP_FUNC_VALUE's params/results into the shim ABI's
// LLVM types: aggregate-return (retbuf) vs scalar shapes, aggregate-arg
// (i8*) passing, and float-scalar int-ification for the all-int VM
// dispatch.

// isAggregateReturn reports whether the function value's return type
// is too large to fit in a single host-int-sized return register and
// thus needs the retbuf-style shim.
//
// Threshold: SizeOf > target's PointerSize.  On LP64 (= 8 bytes) this
// covers slices (16 bytes), managed-slices (32 bytes), function values
// (16 bytes), and any struct/array whose layout exceeds an int.  ≤ 8
// byte returns (int, pointer, bool, float, 1-int struct) keep using
// the scalar shape so existing dispatch paths (Phase 3
// dispatchCompiledFuncValue's rt._call_shim_scalar) work unchanged.
// On ILP32 the threshold drops to > 4, which matches AAPCS32 / arm-
// linux-gnueabihf — slices, managed-slices, function values, and any
// >4-byte struct route through the aggregate-retbuf shim shape; the
// scalar shape only handles single-word returns (int/pointer/bool/
// float / *T).  Without target awareness, 5..8-byte aggregates on
// arm32 stayed at the scalar shim shape while emit.bn / emit_call.bn
// already emitted sret(...) for them, mismatching caller and callee.
//
// isAggregateReturn delegates to the shared ABI predicate (the single source of
// truth for codegen, the native backends, and the VM cross-mode dispatch); see
// types.IsAggregateReturn in pkg/binate/types/abi_return.bn.
func isAggregateReturn(fvTyp @types.Type) bool {
	return types.IsAggregateReturn(fvTyp.Results)
}

// isAggregateArg reports whether a parameter type doesn't fit in a
// single register slot and thus needs pointer-to-aggregate passing in
// the shim convention.  Same threshold as isAggregateReturn: SizeOf >
// one target word (> 8 on LP64, > 4 on ILP32).  Slices, managed-slices,
// function values, and any wider-than-a-word struct/array qualify.
//
// In the shim, aggregate-arg slots take `i8*` (pointer to the
// aggregate); the shim loads the value before calling the underlying.
// This lets the bytecode-side dispatcher (rt._call_shim_scalar /
// rt._call_shim_aggregate, both of which pass int args) carry slice
// values via their existing pointer-in-register convention without
// needing a parallel int-pair-per-slice ABI.
//
// Delegates to the shared ABI predicate (the single source of truth for
// codegen, the native backends, and the VM cross-mode dispatch); see
// types.IsAggregateArg in pkg/binate/types/abi_return.bn.
func isAggregateArg(t @types.Type) bool {
	return types.IsAggregateArg(t)
}

// isFloatScalarParam reports whether t is a scalar floating-point type
// (float32 / float64 / untyped-float).  Its natural LLVM type
// (`float` / `double`) is passed in a floating-point register, so it is
// the only kind of scalar param/return a shim must int-ify to ride the
// VM's all-int dispatch (rt._call_shim_scalar passes everything in GP
// registers).
func isFloatScalarParam(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_READONLY { return isFloatScalarParam(t.Elem) }
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		return isFloatScalarParam(t.Underlying)
	}
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// floatSlotIsI32 reports whether a float scalar's integer slot is i32
// (float32) rather than i64 (float64 / untyped-float).  Mirrors
// llvmType's width mapping (Width==32 -> float, else double).
func floatSlotIsI32(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_READONLY { return floatSlotIsI32(t.Elem) }
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		return floatSlotIsI32(t.Underlying)
	}
	return t.Kind == types.TYP_FLOAT && t.Width == 32
}

// is64ScalarShimSplit reports whether a shim SCALAR param/return of type t is a
// 64-bit scalar (int64 / uint64 / float64 / untyped-float) that THIS target
// carries as TWO i32 slots rather than one i64 slot — i.e. only on ILP32
// (PointerSize == 4).  On LP64 a 64-bit scalar is one i64 slot, so this is
// false and the single-slot shimIntSlotType path is used.
//
// This must agree with the VM's argSlots(=2 for a 64-bit scalar on REG_SLOT<8):
// the __shim consumes exactly the slots the bytecode dispatcher passes.  A
// mismatch — the current bug — makes rt._call_shim_scalar pass v as two i32
// slots while the shim declares one i64 (AAPCS32 even-aligns it), skewing every
// following arg (the ILP32 println-of-unsigned/int64/float segfault).  Peels
// readonly / named like isFloatScalarParam; aggregates are TYP_SLICE/STRUCT/…
// (not INT/FLOAT), so they are excluded and keep their i8* single slot.
func is64ScalarShimSplit(t @types.Type) bool {
	if types.GetTarget().PointerSize >= 8 { return false }
	return is64ScalarUnderlying(t)
}

// is64ScalarUnderlying reports whether t's representation is a 64-bit scalar
// (int64 / uint64 / float64 / untyped-float), peeling readonly / named.
func is64ScalarUnderlying(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_READONLY { return is64ScalarUnderlying(t.Elem) }
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		return is64ScalarUnderlying(t.Underlying)
	}
	if t.Kind == types.TYP_INT && t.Width == 64 { return true }
	if t.Kind == types.TYP_FLOAT && t.Width == 64 { return true }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return true }
	return false
}

// shimIntSlotType returns the LLVM type a shim uses to carry a SCALAR
// value across the uniform all-int dispatch boundary.  A float scalar
// is int-ified to an exact-width integer (float64 / untyped-float ->
// i64, float32 -> i32) so the all-int rt._call_shim_scalar carries its
// bits through a GP register; the shim bitcasts back to the natural
// float type before calling the underlying (and bitcasts a float return
// back to the slot before returning).  Non-float scalars keep their
// natural llvmType.  Aggregate args are handled separately by
// shimParamType (passed as i8*), so this is only reached for scalars.
func shimIntSlotType(t @types.Type) @[]char {
	if isFloatScalarParam(t) {
		var b @strings.Builder = strings.NewBuilder()
		if floatSlotIsI32(t) {
			b.Write("i32")
		} else {
			b.Write("i64")
		}
		return buf.CopyStr(b.String())
	}
	return llvmType(t)
}

// resultIsFloatScalar reports whether a function value's return is a
// single scalar float.  In that case the shim cannot tail-call the
// natural-typed underlying (a bitcast of the result must follow the
// call) and the compiled call site must bitcast the int-slot result
// back to its natural float type.
func resultIsFloatScalar(fvTyp @types.Type) bool {
	if len(fvTyp.Results) != 1 { return false }
	return isFloatScalarParam(fvTyp.Results[0])
}

// writeShimResultLLVM writes a shim's DECLARED return type — the
// int-ified slot for a scalar float return (see shimIntSlotType), the
// natural type otherwise.  Used for the shim signature and the shim's
// `ret`.  The UNDERLYING call and any retbuf keep the natural type
// (writeFuncResultsLLVM).  Only reached for non-aggregate returns
// (aggregate returns use the void retbuf shim shape).
func writeShimResultLLVM(b *strings.Builder, fvTyp @types.Type) {
	if len(fvTyp.Results) == 0 {
		b.Write("void")
		return
	}
	if len(fvTyp.Results) == 1 && aggRetCoerced(fvTyp.Results[0]) {
		// A scalar-shim in-register-aggregate result (<=8 bytes, so
		// isAggregateReturn is false): the shim's DECLARED return type
		// must be the coerced `[N x iW]` the underlying returns and the
		// shim re-returns.  (For >8 results, isAggregateReturn routes to
		// the retbuf shim and writeShimResultLLVM is not reached.)  See
		// emit_agg_coerce.bn.
		aggCoerceLLTy(b, fvTyp.Results[0])
		return
	}
	if len(fvTyp.Results) == 1 {
		b.Write(shimIntSlotType(fvTyp.Results[0]))
		return
	}
	writeFuncResultsLLVM(b, fvTyp)
	return
}

// funcSignatureLLVM formats the LLVM function-pointer type for a
// function-value type's vtable.call slot.
//
//   - Scalar/void return + scalar args: `<ret>(i8*, <args>)*` — the
//     scalar shim shape.
//   - Aggregate return: `void(i8*, i8*, <args>)*` — retbuf-style.
//   - Aggregate args: each aggregate arg becomes i8* (pointer-to-
//     aggregate); shim loads before calling underlying.
// All three transforms compose freely.
//
// fvTyp must be a TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE.
func funcSignatureLLVM(fvTyp @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	if isAggregateReturn(fvTyp) {
		b.Write("void(i8*, i8*")
		for i := 0; i < len(fvTyp.Params); i++ {
			writeShimParamTypes(b, fvTyp.Params[i].Type)
		}
		b.Write(")*")
		return buf.CopyStr(b.String())
	}
	writeShimResultLLVM(b, fvTyp)
	b.WriteByte('(')
	b.Write("i8*")
	for i := 0; i < len(fvTyp.Params); i++ {
		writeShimParamTypes(b, fvTyp.Params[i].Type)
	}
	b.Write(")*")
	return buf.CopyStr(b.String())
}

// writeShimParamTypes writes the comma-prefixed LLVM slot TYPE(S) for one shim
// param — two `i32` slots for a 64-bit scalar split on ILP32
// (is64ScalarShimSplit), otherwise the single shimParamType.  Names are NOT
// emitted (this is for the bitcast function-pointer TYPE); the shim DEFINITION
// (writeShimParamDecl) and the call arg list emit the same slot shape with
// names/values.  All three must agree slot-for-slot.
func writeShimParamTypes(b *strings.Builder, t @types.Type) {
	if is64ScalarShimSplit(t) {
		b.Write(", i32, i32")
		return
	}
	b.Write(", ")
	b.Write(shimParamType(t))
}

// shimParamType returns the LLVM type for a shim parameter.
// EVERY aggregate — a coerced in-register named struct/array (SizeOf <= 16),
// a >16-byte byval struct, a slice, a func-value, an iface-value — rides the
// dispatch convention as an i8* POINTER to the aggregate; the per-function
// shim loads it and re-marshals to the underlying's real ABI (for a coerced
// aggregate it loads the `[N x iW]` coerced value; see emitShimArgLoads).
// Centralizing the marshaling in the shim — the one place that statically
// knows the signature — is what keeps the LLVM, native, and VM dispatchers
// interchangeable: every caller just passes a pointer, regardless of how the
// underlying ABI ends up classifying the aggregate.  Scalars keep their
// natural type.  See emit_agg_coerce.bn.
func shimParamType(t @types.Type) @[]char {
	if aggParamCoerced(t) || isAggregateArg(t) {
		var b @strings.Builder = strings.NewBuilder()
		b.Write("i8*")
		return buf.CopyStr(b.String())
	}
	return shimIntSlotType(t)
}

// writeFuncResultsLLVM writes the LLVM return-type form for a
// function-value signature into b. void / single-type / multi-
// return-anonymous-struct.
func writeFuncResultsLLVM(b *strings.Builder, fvTyp @types.Type) {
	if len(fvTyp.Results) == 0 {
		b.Write("void")
		return
	}
	if len(fvTyp.Results) == 1 && aggRetCoerced(fvTyp.Results[0]) {
		// The underlying function returns an in-register aggregate as the
		// coerced ABI type (emit_agg_coerce.bn); the shim / closure /
		// compiled func-value call site must spell the SAME type for the
		// underlying call + the retbuf store — x64 SSE's `{ .. }` / eightbyte
		// aggregate (sysvReturnLLTy) or the GP `[N x iW]` (aggCoerceLLTy).
		// The retbuf is memory, so the SSE aggregate image == the struct
		// image the compiled caller loads back.  See emit_sysv_coerce.bn.
		if types.SysVInSse(fvTyp.Results[0]) {
			sysvReturnLLTy(b, fvTyp.Results[0])
		} else {
			aggCoerceLLTy(b, fvTyp.Results[0])
		}
		return
	}
	if len(fvTyp.Results) == 1 {
		b.Write(llvmType(fvTyp.Results[0]))
		return
	}
	// Multi-return tuple: the RAW PACKED-with-padding form (multiReturnType →
	// anonStructLL).  A multi-field tuple is isAggregateReturn, so the func-value
	// path returns it via a RETBUF (memory): this same type spells the retbuf alloca,
	// the caller's load-back, AND the downstream field-index consumers (extractvalue
	// reads llvmType(tuple) = this packed form), so all three MUST agree on ONE type.
	// Unlike the DIRECT register-return path (which reinterprets the packed tuple to
	// a flat, padding-member-free FCA boundary at ret/call — emit_agg_coerce.bn's
	// coerced bridge — because a padding MEMBER would claim its own return register),
	// the retbuf is memory, where the packed byte layout is exactly right and no
	// register is at stake.  Spelling the flat/coerced boundary form here instead
	// desyncs the retbuf load from the packed extractvalue — a COMPILE_ERROR on any
	// multi-return func-value call (regressions/funcval-*-multiret).
	b.Write(multiReturnType(fvTyp.Results))
	return
}
