package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals_sig.bn — the type->LLVM-string formatting
// helpers (funcSignatureLLVM / shimIntSlotType / isFloatScalarParam,
// ...).  Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// TestFuncSignatureLLVMVoid: a function-value type with no results
// renders as `void(<args>)*`. funcSignatureLLVM is consumed by
// emitFuncValueVtables when wiring up the call slot's bitcast, so a
// regression in either piece would surface as malformed LLVM.
func TestFuncSignatureLLVMVoid() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func helper() {}\n"
			"func main() {\n"
			"\tvar h @func() = helper\n"
			"\th()\n"
			"}\n"
	// Call through the func value so the call site emits the typed
	// function-pointer signature (the func-value vtable itself is now an
	// opaque-pointer ir.DataGlobal and no longer carries the bitcast sig).

	var out @[]char = compileToLLVM(src)
	if !contains(out, "void(i8*)*") {
		return fail("expected void(i8*)* signature for @func() type (hidden ctx)")
	}
	return ""
}

// TestShimIntSlotTypeFloat: float scalars int-ify to exact-width
// integer slots (float64/untyped-float -> i64, float32 -> i32); non-
// float scalars keep their natural llvmType.  The shared slot
// predicate the shim and the call site both derive from — if it
// drifts, the two sides disagree and float func-values silently
// miscompile (plan-float-arg-shim.md).
func TestShimIntSlotTypeFloat() testing.TestResult {
	if !charsEqual(shimIntSlotType(types.TypFloat64()), "i64") {
		return fail("float64 slot must be i64")
	}
	if !charsEqual(shimIntSlotType(types.TypUntypedFloat()), "i64") {
		return fail("untyped-float slot must be i64")
	}
	if !charsEqual(shimIntSlotType(types.TypFloat32()), "i32") {
		return fail("float32 slot must be i32 (exact width, never widened)")
	}
	if !charsEqual(shimIntSlotType(types.TypInt64()), "i64") {
		return fail("int64 slot stays natural i64")
	}
	if !charsEqual(shimIntSlotType(types.TypUint8()), "i8") {
		return fail("uint8 slot stays natural i8")
	}
	return ""
}

// TestIsFloatScalarParam: only float32 / float64 / untyped-float are
// float scalars; ints and pointers are not.
func TestIsFloatScalarParam() testing.TestResult {
	if !isFloatScalarParam(types.TypFloat64()) {
		return fail("float64 is a float scalar")
	}
	if !isFloatScalarParam(types.TypFloat32()) {
		return fail("float32 is a float scalar")
	}
	if !isFloatScalarParam(types.TypUntypedFloat()) {
		return fail("untyped-float is a float scalar")
	}
	if isFloatScalarParam(types.TypInt()) {
		return fail("int is not a float scalar")
	}
	if isFloatScalarParam(types.MakePointerType(types.TypUint8())) {
		return fail("pointer is not a float scalar")
	}
	return ""
}

// chkSplit threads a result: if prev already failed it passes through, else it
// asserts is64ScalarShimSplit(t) == want, returning msg on mismatch.
func chkSplit(prev testing.TestResult, t @types.Type, want bool, msg @[]char) testing.TestResult {
	if len(prev) != 0 { return prev }
	if is64ScalarShimSplit(t) != want { return fail(msg) }
	return ""
}

// is64ScalarShimSplit is true only for a 64-bit SCALAR on ILP32 — the case the
// shim passes as two i32 slots.  Aggregates and float32/int are one slot; on
// LP64 a 64-bit scalar is one i64 slot.
func TestIs64ScalarShimSplit() testing.TestResult {
	setTarget32()
	var r testing.TestResult = ""
	r = chkSplit(r, types.TypInt64(), true, "ILP32 int64 splits")
	r = chkSplit(r, types.TypUint64(), true, "ILP32 uint64 splits")
	r = chkSplit(r, types.TypFloat64(), true, "ILP32 float64 splits")
	r = chkSplit(r, types.TypFloat32(), false, "ILP32 float32 not split")
	r = chkSplit(r, types.TypInt(), false, "ILP32 int (i32) not split")
	r = chkSplit(r, types.MakeSliceType(types.TypUint8()), false, "ILP32 slice not split")
	setTarget64()
	r = chkSplit(r, types.TypInt64(), false, "LP64 int64 is one i64 slot")
	r = chkSplit(r, types.TypFloat64(), false, "LP64 float64 is one i64 slot")
	return r
}

// mkFvU64Slice builds the `*func(uint64, *[]uint8) int` func-value type — the
// formatUint shape (a 64-bit scalar arg followed by a slice arg).
func mkFvU64Slice() @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 2)
	var p0 @types.Param = make(types.Param)
	p0.Name = "v"
	p0.Type = types.TypUint64()
	params[0] = p0
	var p1 @types.Param = make(types.Param)
	p1.Name = "buf"
	p1.Type = types.MakeSliceType(types.TypUint8())
	params[1] = p1
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	return types.MakeFuncValueType(params, results)
}

// funcSignatureLLVM (the vtable.call bitcast type, sharing the shim def shape)
// splits a 64-bit scalar arg into two i32 slots on ILP32, but keeps one i64
// slot on LP64.  A drift between this, the shim def, and the native caller is
// the ILP32 println-of-64-bit segfault.
func TestFuncSignature64BitArgSplit() testing.TestResult {
	var fv @types.Type = mkFvU64Slice()
	setTarget32()
	var s32 @[]char = funcSignatureLLVM(fv)
	setTarget64()
	if !contains(s32, ", i32, i32, i8*)") {
		return fail("ILP32: uint64 arg must be two i32 slots then the slice i8*")
	}
	var s64 @[]char = funcSignatureLLVM(fv)
	if !contains(s64, ", i64, i8*)") {
		return fail("LP64: uint64 arg stays one i64 slot")
	}
	return ""
}
