package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals_sig.bn — the type->LLVM-string formatting
// helpers (funcSignatureLLVM / shimIntSlotType / isFloatScalarParam,
// ...).  Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// TestFuncSignatureLLVMVoid: a function-value type with no results
// renders as `void(<args>)*`. funcSignatureLLVM is consumed by
// emitFuncValueVtables when wiring up the call slot's bitcast, so a
// regression in either piece would surface as malformed LLVM.
func TestFuncSignatureLLVMVoid() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func helper() {}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar h @func() = helper\n")
	cb.Write("\t_ = h\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "void(i8*)*") {
		return fail("expected void(i8*)* signature for @func() type (hidden ctx)")
	}
	return ""
}

// TestShimIntSlotTypeFloat: float scalars int-ify to exact-width
// integer slots (float64/untyped-float -> i64, float32 -> i32); non-
// float scalars keep their natural llvmType.  The shared slot
// predicate the shim and the call site both derive from — if it
// drifts, the two sides disagree and float func-values silently
// miscompile (plan-float-arg-shim.md).
func TestShimIntSlotTypeFloat() testing.TestResult {
	if !charsEqual(shimIntSlotType(types.TypFloat64()), "i64") {
		return fail("float64 slot must be i64")
	}
	if !charsEqual(shimIntSlotType(types.TypUntypedFloat()), "i64") {
		return fail("untyped-float slot must be i64")
	}
	if !charsEqual(shimIntSlotType(types.TypFloat32()), "i32") {
		return fail("float32 slot must be i32 (exact width, never widened)")
	}
	if !charsEqual(shimIntSlotType(types.TypInt64()), "i64") {
		return fail("int64 slot stays natural i64")
	}
	if !charsEqual(shimIntSlotType(types.TypUint8()), "i8") {
		return fail("uint8 slot stays natural i8")
	}
	return ""
}

// TestIsFloatScalarParam: only float32 / float64 / untyped-float are
// float scalars; ints and pointers are not.
func TestIsFloatScalarParam() testing.TestResult {
	if !isFloatScalarParam(types.TypFloat64()) {
		return fail("float64 is a float scalar")
	}
	if !isFloatScalarParam(types.TypFloat32()) {
		return fail("float32 is a float scalar")
	}
	if !isFloatScalarParam(types.TypUntypedFloat()) {
		return fail("untyped-float is a float scalar")
	}
	if isFloatScalarParam(types.TypInt()) {
		return fail("int is not a float scalar")
	}
	if isFloatScalarParam(types.MakePointerType(types.TypUint8())) {
		return fail("pointer is not a float scalar")
	}
	return ""
}
