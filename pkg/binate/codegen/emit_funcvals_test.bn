package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals.bn — emitFuncValueVtables and the shim
// int-ification it drives. The vtables emitter walks the module for
// OP_FUNC_VALUE instructions and emits one `@__vt.<mangled>` global
// per unique referenced function, with the function pointer in the
// `call` slot and null in the `dtor` slot (Phase 1 — no captured
// context). The pure type/signature-formatting helpers are tested in
// emit_funcvals_sig_test.bn. Helpers (compileToLLVM, contains, fail)
// live in emit_test.bn.

// TestEmitFuncValueVtable: a function-value reference must produce
// a `@__vt.<callee>` global in the LLVM output, not an inline
// constant or a missing definition. Without this, OP_CALL_FUNC_VALUE
// would dispatch through a vtable address that doesn't exist.
func TestEmitFuncValueVtable() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func add(a int, b int) int { return a + b }\n"
			"func main() {\n"
			"\tvar f *func(int, int) int = add\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@__vt.") {
		return fail("expected @__vt.<name> vtable global for function-value reference")
	}
	// The vtable is an irdata.DataGlobal — a flat anonymous { ptr, ptr } (dtor,
	// call), not the named %BnVtable type (which the typed-pointer references
	// elsewhere auto-upgrade to `ptr`).
	if !contains(out, "@__vt.") || !contains(out, "weak_odr constant { ptr, ptr }") {
		return fail("expected vtable to be a weak_odr { ptr, ptr } constant")
	}
	if !contains(out, "ptr null") {
		return fail("expected dtor slot to be null (no captured ctx)")
	}
	return ""
}

// TestShimIntIfiesFloatParamAndReturn: the per-function shim for a
// *func(float64) float64 value declares int-ified slots and bitcasts
// i64<->double at its boundary, so the all-int VM dispatch can carry
// the float through GP registers.
func TestShimIntIfiesFloatParamAndReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func idf(x float64) float64 { return x }\n"
			"func main() {\n"
			"\tvar f *func(float64) float64 = idf\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	// The shim materializes the float arg from its i64 slot ...
	if !contains(out, "bitcast i64 %a0 to double") {
		return fail("shim must bitcast the i64 arg slot back to double")
	}
	// ... and int-ifies the float result before returning.
	if !contains(out, "bitcast double %r to i64") {
		return fail("shim must bitcast the double result into the i64 slot")
	}
	return ""
}

// TestCallSiteIntIfiesFloatArgAndReturn: a compiled call through a
// *func(float64) float64 value bitcasts the float arg to its i64 slot
// before the call and bitcasts the i64 result back to double after —
// matching the int-ified shim signature.
func TestCallSiteIntIfiesFloatArgAndReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func idf(x float64) float64 { return x }\n"
			"func main() {\n"
			"\tvar f *func(float64) float64 = idf\n"
			"\tvar r float64 = f(2.0)\n"
			"\t_ = r\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".fb0 = bitcast double ") {
		return fail("call site must bitcast the float arg to its i64 slot")
	}
	if !contains(out, ".fc to double") {
		return fail("call site must bitcast the i64 result back to double")
	}
	return ""
}

// TestFuncValueUsesSretIsTargetAware: an 8-byte aggregate result
// type should route through sret on an ILP32 target (AAPCS32 threshold
// = 4 bytes) but stay register-style on LP64 (AAPCS64 / SysV threshold
// = 16 bytes).  Pins the target-aware behaviour of `funcValueUsesSret`
// — without this, the hardcoded `> 16` gate left 5..16-byte aggregate-
// returning func-values at register-style shim emission on arm32 while
// emit.bn's declarations + emit_call.bn's call sites already used
// sret(...), corrupting the returned struct and crashing the pkg/binate/vm
// test binary at init under builder-comp_arm32_linux.
//
// Uses an explicit two-`int32` struct so SizeOf is deterministically 8
// across hosts (no LP64-vs-ILP32 native int width interaction).  See
// the analogous setTarget32 / setTarget64 helpers in
// pkg/binate/types/scope_test.bn.
func TestFuncValueUsesSretIsTargetAware() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fa @types.Field = make(types.Field)
	fa.Name = "a"
	fa.Type = types.TypInt32()
	fields[0] = fa
	var fb @types.Field = make(types.Field)
	fb.Name = "b"
	fb.Type = types.TypInt32()
	fields[1] = fb
	var s8 @types.Type = types.MakeStructType("Pair32", fields)
	var noFvParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = s8
	var fvTyp @types.Type = types.MakeFuncValueType(noFvParams, results)
	var m @ir.Module = ir.NewModule("\"main\"")

	var saved types.TargetInfo = types.GetTarget()

	// Real arm32 (AAPCS32) is MaxAlign=8, not 4; the Pair32 result is two int32
	// (no 8-byte member), so SizeOf and thus the sret outcome are MaxAlign-
	// invariant — the 8 just keeps the fixture honest about the arm32 target.
	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 8
	types.SetTarget(t32)
	var arm32 bool = funcValueUsesSret(m, "f", fvTyp)

	var t64 types.TargetInfo
	t64.PointerSize = 8
	t64.IntSize = 8
	t64.MaxAlign = 8
	types.SetTarget(t64)
	var lp64 bool = funcValueUsesSret(m, "f", fvTyp)

	types.SetTarget(saved)

	if !arm32 { return fail("8-byte aggregate must use sret on arm32 (> 4)") }
	if lp64 { return fail("8-byte aggregate must NOT use sret on LP64 (≤ 16)") }
	return ""
}
