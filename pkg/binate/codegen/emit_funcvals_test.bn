package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_funcvals.bn — funcSignatureLLVM and
// emitFuncValueVtables. The vtables emitter walks the module for
// OP_FUNC_VALUE instructions and emits one `@__vt.<mangled>` global
// per unique referenced function, with the function pointer in the
// `call` slot and null in the `dtor` slot (Phase 1 — no captured
// context). Helpers (compileToLLVM, contains, fail) live in
// emit_test.bn.

// TestEmitFuncValueVtable: a function-value reference must produce
// a `@__vt.<callee>` global in the LLVM output, not an inline
// constant or a missing definition. Without this, OP_CALL_FUNC_VALUE
// would dispatch through a vtable address that doesn't exist.
func TestEmitFuncValueVtable() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func add(a int, b int) int { return a + b }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(int, int) int = add\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@__vt.") {
		return fail("expected @__vt.<name> vtable global for function-value reference")
	}
	if !contains(out, "weak_odr constant %BnVtable") {
		return fail("expected vtable to be a weak_odr %BnVtable constant")
	}
	if !contains(out, "i8* null") {
		return fail("expected dtor slot to be null (Phase 1, no captured ctx)")
	}
	return ""
}

// TestFuncSignatureLLVMVoid: a function-value type with no results
// renders as `void(<args>)*`. funcSignatureLLVM is consumed by
// emitFuncValueVtables when wiring up the call slot's bitcast, so a
// regression in either piece would surface as malformed LLVM.
func TestFuncSignatureLLVMVoid() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func helper() {}\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar h @func() = helper\n")
	cb = cb.WriteStr("\t_ = h\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "void(i8*)*") {
		return fail("expected void(i8*)* signature for @func() type (hidden ctx)")
	}
	return ""
}

// TestFuncValueUsesSretIsTargetAware: an 8-byte aggregate result
// type should route through sret on an ILP32 target (AAPCS32 threshold
// = 4 bytes) but stay register-style on LP64 (AAPCS64 / SysV threshold
// = 16 bytes).  Pins the target-aware behaviour of `funcValueUsesSret`
// — without this, the hardcoded `> 16` gate left 5..16-byte aggregate-
// returning func-values at register-style shim emission on arm32 while
// emit.bn's declarations + emit_call.bn's call sites already used
// sret(...), corrupting the returned struct and crashing the pkg/binate/vm
// test binary at init under builder-comp_arm32_linux.
//
// Uses an explicit two-`int32` struct so SizeOf is deterministically 8
// across hosts (no LP64-vs-ILP32 native int width interaction).  See
// the analogous setTarget32 / setTarget64 helpers in
// pkg/binate/types/scope_test.bn.
func TestFuncValueUsesSretIsTargetAware() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fa @types.Field = make(types.Field)
	fa.Name = "a"
	fa.Type = types.TypInt32()
	fields[0] = fa
	var fb @types.Field = make(types.Field)
	fb.Name = "b"
	fb.Type = types.TypInt32()
	fields[1] = fb
	var s8 @types.Type = types.MakeStructType("Pair32", fields)
	var noFvParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = s8
	var fvTyp @types.Type = types.MakeFuncValueType(noFvParams, results)
	var m @ir.Module = ir.NewModule("\"main\"")

	var saved types.TargetInfo = types.GetTarget()

	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 4
	types.SetTarget(t32)
	var arm32 bool = funcValueUsesSret(m, "f", fvTyp)

	var t64 types.TargetInfo
	t64.PointerSize = 8
	t64.IntSize = 8
	t64.MaxAlign = 8
	types.SetTarget(t64)
	var lp64 bool = funcValueUsesSret(m, "f", fvTyp)

	types.SetTarget(saved)

	if !arm32 { return fail("8-byte aggregate must use sret on arm32 (> 4)") }
	if lp64 { return fail("8-byte aggregate must NOT use sret on LP64 (≤ 16)") }
	return ""
}
