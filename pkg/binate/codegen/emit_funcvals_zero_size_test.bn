package "pkg/binate/codegen"

import "pkg/builtins/testing"

// A zero-size aggregate argument takes a pointer slot in the func-value dispatch, like
// any other aggregate (docs/abi 03 §3.3), as the native backends and the VM give it:
// the shim declares `i8*` for it, and the call through the func value passes its
// address (the `.ap8.1` slot of argument 1).
func TestFuncValueZeroSizeArgTakesSlot() testing.TestResult {
	setTarget64()
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"type E struct { }\n"
					"func ze(a int, e E, b int) int { return a + b }\n"
					"func main() { var f *func(int, E, int) int = ze; var e E; f(1, e, 2) }\n")
	if !contains(out, "@__shim.bn_F1_4_main1_2_ze(i8* %data, i64 %a0, i8* %a1, i64 %a2)") {
		return fail("the shim should take the zero-size argument as an i8* slot")
	}
	if !contains(out, ".ap8.1, i64") {
		return fail("the call through the func value should pass the zero-size argument's address")
	}
	return ""
}
