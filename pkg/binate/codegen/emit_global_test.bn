package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests the module-global static-zero emission (emit.bn).  A package-level
// global must be declared with a valid LLVM constant for its type: the real
// initializer value (for `var x T = expr`) is applied at startup by the
// synthetic per-package __init, so the static slot only needs a valid zero.
// `0` is right for integer scalars and `null` for pointers, but the 16-byte
// address-aggregates — interface value (`%BnIfaceValue`) and func value
// (`%BnFuncValue`) — are LLVM struct types and need `zeroinitializer`; a bare
// `0` is rejected by clang ("integer constant must have integer type"), so a
// global of such a type failed to compile at all.  `readonly` is a semantic-
// only modifier and must be unwrapped first (mirroring llvmType), or a
// `readonly`-qualified aggregate global picks its init token from the wrapper
// kind and emits the invalid `0`.  The float sibling (`double 0.0`, not
// `double 0`) shares the same zero-by-kind ladder.

// A `@func` (func-value) global emits a zeroinitializer, never a bare `0`.
func TestEmitGlobalFuncValueZeroInit() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"var g @func() int\n"
		"func main() {}\n")
	if !contains(out, "@bn_main__g = global %BnFuncValue zeroinitializer") {
		return fail("func-value global must emit `%BnFuncValue zeroinitializer`")
	}
	if contains(out, "global %BnFuncValue 0") {
		return fail("func-value global must NOT emit the invalid `%BnFuncValue 0`")
	}
	return ""
}

// An `@Iface` (interface-value) global emits a zeroinitializer, never `0`.
func TestEmitGlobalIfaceValueZeroInit() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"interface I { M() int }\n"
		"var g @I\n"
		"func main() {}\n")
	if !contains(out, "@bn_main__g = global %BnIfaceValue zeroinitializer") {
		return fail("iface-value global must emit `%BnIfaceValue zeroinitializer`")
	}
	if contains(out, "global %BnIfaceValue 0") {
		return fail("iface-value global must NOT emit the invalid `%BnIfaceValue 0`")
	}
	return ""
}

// A `readonly`-qualified aggregate global unwraps the modifier and still
// emits a zeroinitializer (regression for the readonly variant of the
// address-aggregate global bug, which otherwise picks `0` from the
// TYP_READONLY wrapper kind and hard-fails clang).
func TestEmitGlobalReadonlyAggregateZeroInit() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"var g readonly @func() int\n"
		"func main() {}\n")
	if !contains(out, "@bn_main__g = global %BnFuncValue zeroinitializer") {
		return fail("readonly func-value global must emit `%BnFuncValue zeroinitializer`")
	}
	if contains(out, "global %BnFuncValue 0") {
		return fail("readonly func-value global must NOT emit the invalid `%BnFuncValue 0`")
	}
	return ""
}

// The float sibling: a `float64` global emits `double 0.0`, not the invalid
// `double 0` — guards the same zero-by-kind ladder this fix extends.
func TestEmitGlobalFloatZeroInit() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"var g float64 = 1.5\n"
		"func main() {}\n")
	if !contains(out, "@bn_main__g = global double 0.0") {
		return fail("float global must emit `double 0.0`")
	}
	return ""
}

// emitGlobalOfType builds a `main` module with a single global `g` of the
// given type and returns the emitted LLVM IR — the harness for the
// named-wrapper static-zero-token tests below.  Built by direct module
// construction (not source) so the global carries exactly the given
// TYP_NAMED, isolating the codegen static-zero dispatch from the
// front-end's named-type resolution.
func emitGlobalOfType(t @types.Type) @[]char {
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Global = make(ir.Global)
	g.Name = "g"
	g.Typ = t
	m.AddGlobal(g)
	return EmitModule(m)
}

// namedOver wraps an underlying type in a TYP_NAMED, modeling `type X U`.
func namedOver(name @[]char, underlying @types.Type) @types.Type {
	var n @types.Type = types.MakeNamedType(name)
	n.Underlying = underlying
	return n
}

// A named-over-iface-value global peels the TYP_NAMED wrapper and emits
// `zeroinitializer`, never the invalid `%BnIfaceValue 0`: the static-zero
// dispatch must strip TYP_NAMED (via stripWrappers), not only TYP_READONLY,
// or the named wrapper falls through every aggregate branch to a bare `0`
// that clang rejects (plan-cr2-2 Defect 1).
func TestEmitGlobalNamedIfaceValueZeroInit() testing.TestResult {
	var iface @types.Type = types.MakeInterfaceType("main", "I")
	var out @[]char = emitGlobalOfType(
		namedOver("H", types.MakeManagedInterfaceValueType(iface)))
	if !contains(out, "@bn_main__g = global %BnIfaceValue zeroinitializer") {
		return fail("named iface-value global must emit `%BnIfaceValue zeroinitializer`")
	}
	if contains(out, "global %BnIfaceValue 0") {
		return fail("named iface-value global must NOT emit the invalid `%BnIfaceValue 0`")
	}
	return ""
}

// A named-over-func-value global: same peel, `%BnFuncValue zeroinitializer`.
func TestEmitGlobalNamedFuncValueZeroInit() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var out @[]char = emitGlobalOfType(
		namedOver("Fn", types.MakeManagedFuncValueType(noParams, noResults)))
	if !contains(out, "@bn_main__g = global %BnFuncValue zeroinitializer") {
		return fail("named func-value global must emit `%BnFuncValue zeroinitializer`")
	}
	if contains(out, "global %BnFuncValue 0") {
		return fail("named func-value global must NOT emit the invalid `%BnFuncValue 0`")
	}
	return ""
}

// A named-over-managed-slice global: `%BnManagedSlice zeroinitializer`.
func TestEmitGlobalNamedManagedSliceZeroInit() testing.TestResult {
	var out @[]char = emitGlobalOfType(
		namedOver("Buf", types.MakeManagedSliceType(types.TypInt())))
	if !contains(out, "@bn_main__g = global %BnManagedSlice zeroinitializer") {
		return fail("named managed-slice global must emit `%BnManagedSlice zeroinitializer`")
	}
	if contains(out, "global %BnManagedSlice 0") {
		return fail("named managed-slice global must NOT emit the invalid `%BnManagedSlice 0`")
	}
	return ""
}

// A named-over-managed-ptr global takes the pointer arm: `i8* null`, not the
// bare `i8* 0` the unpeeled TYP_NAMED would fall through to.
func TestEmitGlobalNamedManagedPtrZeroInit() testing.TestResult {
	var out @[]char = emitGlobalOfType(
		namedOver("P", types.MakeManagedPtrType(types.TypInt())))
	if !contains(out, "@bn_main__g = global i8* null") {
		return fail("named managed-ptr global must emit `i8* null`")
	}
	if contains(out, "global i8* 0") {
		return fail("named managed-ptr global must NOT emit the invalid `i8* 0`")
	}
	return ""
}
