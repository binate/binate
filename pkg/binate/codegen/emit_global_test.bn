package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests the module-global static storage emission (emit.bn).  A package-level
// `var` lowers through the shared irdata.BuildGlobalVar to a mutable byte blob of
// the type's SizeOf — `@<sym> = global { [N x i8] } { [N x i8] zeroinitializer
// }, align A` — under opaque pointers (the real initializer for `var x T = expr`
// runs at startup in the synthetic per-package __init).  An all-zero blob is
// every type's zero bit pattern, so there is no longer a per-type zero token to
// get wrong; what must stay correct is N = SizeOf and A = AlignOf, which already
// peel the transparent `readonly` / named wrappers.

// emitGlobalOfType builds a `main` module with a single global `g` of the given
// type and returns the emitted LLVM IR — the harness for the wrapper tests
// below.  Built by direct module construction (not source) so the global
// carries exactly the given wrapper, isolating codegen from front-end
// named-type resolution.
func emitGlobalOfType(t @types.Type) @[]char {
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Global = make(ir.Global)
	g.Name = "g"
	g.Typ = t
	m.AddGlobal(g)
	return EmitModule(m)
}

// namedOver wraps an underlying type in a TYP_NAMED, modeling `type X U`.
func namedOver(name @[]char, underlying @types.Type) @types.Type {
	var n @types.Type = types.MakeNamedType(name)
	n.Underlying = underlying
	return n
}

// The canonical byte-blob form: a scalar global is `{ [8 x i8] }` zero-filled,
// mutable, align 8 — no typed `i64 0`.
func TestEmitGlobalByteBlobForm() testing.TestResult {
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"var g int\n"
					"func main() {}\n")
	if !contains(out,
			"@bn_G1_4_main1_1_g = global { [8 x i8] } "
					"{ [8 x i8] zeroinitializer }, align 8") {
		return fail("scalar global must emit a mutable 8-byte zero blob, align 8")
	}
	return ""
}

// A 16-byte address-aggregate (func value / iface value) sizes its blob at 16 —
// the SizeOf, not a typed %BnFuncValue.  (Pre-DataGlobal this was the
// zeroinitializer-vs-bare-0 bug; the byte blob makes it unconditional.)
func TestEmitGlobalFuncValueSize() testing.TestResult {
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"var g @func() int\n"
					"func main() {}\n")
	if !contains(out, "@bn_G1_4_main1_1_g = global { [16 x i8] }") {
		return fail("func-value global should be a 16-byte blob")
	}
	return ""
}

// A managed-slice global is 32 bytes (4 words).
func TestEmitGlobalManagedSliceSize() testing.TestResult {
	var out @[]char = emitGlobalOfType(types.MakeManagedSliceType(types.TypInt()))
	if !contains(out, "@bn_G1_4_main1_1_g = global { [32 x i8] }") {
		return fail("managed-slice global should be a 32-byte blob")
	}
	return ""
}

// A managed-ptr global is one pointer word (8 bytes) — exercises the
// pointer-size SizeOf arm.
func TestEmitGlobalManagedPtrSize() testing.TestResult {
	var out @[]char = emitGlobalOfType(types.MakeManagedPtrType(types.TypInt()))
	if !contains(out, "@bn_G1_4_main1_1_g = global { [8 x i8] }") {
		return fail("managed-ptr global should be an 8-byte blob")
	}
	return ""
}

// SizeOf must peel a `readonly` wrapper: a `readonly @func() int` global is
// still 16 bytes, not mis-sized off the wrapper.  (Regression for the readonly
// variant of the old address-aggregate global bug.)
func TestEmitGlobalReadonlyPeeledForSize() testing.TestResult {
	var out @[]char = compileToLLVM(
			"package \"main\"\n"
					"var g readonly @func() int\n"
					"func main() {}\n")
	if !contains(out, "@bn_G1_4_main1_1_g = global { [16 x i8] }") {
		return fail("readonly func-value global should still be a 16-byte blob")
	}
	return ""
}

// SizeOf must peel a TYP_NAMED wrapper: a named-over-managed-slice global is
// still 32 bytes (regression for plan-cr2-2 Defect 1, now a size concern).
func TestEmitGlobalNamedPeeledForSize() testing.TestResult {
	var out @[]char = emitGlobalOfType(
			namedOver("Buf", types.MakeManagedSliceType(types.TypInt())))
	if !contains(out, "@bn_G1_4_main1_1_g = global { [32 x i8] }") {
		return fail("named managed-slice global should still be a 32-byte blob")
	}
	return ""
}

// An imported extern var is a DECLARATION, not a DataGlobal definition: it stays
// a typed `external global` (no storage, no byte blob), keyed to the owner's
// mangled symbol.
func TestEmitGlobalExternDeclUnchanged() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Global = make(ir.Global)
	g.Name = "pkg/other.Count"
	g.Typ = types.TypInt()
	g.IsExtern = true
	m.AddGlobal(g)
	var out @[]char = EmitModule(m)
	if !contains(out, " = external global ") {
		return fail("an extern var must stay an `external global` declaration")
	}
	if contains(out, "external global { [") {
		return fail("an extern decl must keep its type, not become a byte blob")
	}
	return ""
}
