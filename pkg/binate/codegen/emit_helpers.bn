package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"


// emitAllocDecl emits just the `alloca` instruction for an OP_ALLOC.
// All alloca declarations are hoisted to the function entry block so
// that allocas inside loop bodies don't leak native stack per iteration
// (LLVM allocas in non-entry blocks allocate fresh stack each time the
// block is executed and aren't freed until function return).
func emitAllocDecl(out *strings.Builder, instr @ir.Instr) {
	var allocTyp @[]char = llvmType(instr.TypeArg)
	emitRef(out, instr.ID)
	out.Write(" = alloca ")
	out.Write(allocTyp)
	out.WriteByte('\n')
	return
}

// emitMakeSliceAllocDecl emits just the `.p = alloca %BnManagedSlice`
// for an OP_MAKE_SLICE instruction. Same hoisting rationale as
// emitAllocDecl: keeping it inline at the OP_MAKE_SLICE site (a
// non-entry block, e.g. inside a loop body or if-branch) leaks
// native stack per execution. The store/bitcast/load from the call
// result stay at the original location.
func emitMakeSliceAllocDecl(out *strings.Builder, instr @ir.Instr) {
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p = alloca %BnManagedSlice\n")
	return
}

// emitSretAllocDecl emits just the `.sret = alloca <type>` for an
// OP_CALL that uses sret return convention. Same hoisting rationale
// as emitAllocDecl. The actual `call void` and result load stay at
// the original location.
func emitSretAllocDecl(out *strings.Builder, instr @ir.Instr,
		funcRetTypes *[]FuncRetType) {
	var callNameBuf @[]char =
		mangle.FuncName(modulePkgName, instr.StrVal)
	if !lookupIsSret(funcRetTypes, callNameBuf) {
		return
	}
	var sretRetType @[]char =
		lookupRetType(funcRetTypes, callNameBuf)
	emitRef(out, instr.ID)
	out.Write(".sret = alloca ")
	out.Write(sretRetType)
	out.WriteByte('\n')
	return
}

// emitAlloc emits the zero-fill for struct/array OP_ALLOCs.  The
// alloca itself is hoisted to the entry block by emitAllocDecl;
// this runs at the original location so that each time control
// reaches the declaration (e.g. each loop iteration) the slot is
// re-zeroed.  Uses emitFieldwiseZero (per-scalar store of zero) so
// LLVM never lowers the zero-fill to memset / __aeabi_memclr (a
// libc dependency we don't carry on bare-metal — see
// explorations/plan-codegen-c-free-copies.md).
func emitAlloc(out *strings.Builder, instr @ir.Instr) {
	if instr.TypeArg == nil {
		return
	}
	// Decide whether to zero-fill on the PEELED kind: a named distinct type
	// (`type Arr [8]int`, `type Buf @[]int`) has Kind TYP_NAMED, so an unpeeled
	// `Kind ==` check would skip the fill and leave the local holding stack
	// garbage (a read of an unset element / field / slice-header word returns
	// garbage).  emitFieldwiseZeroInstr (-> emitZeroRec) already peels
	// TYP_NAMED/TYP_READONLY when it runs; only this gate did not.
	// A SCALAR (named or anonymous) is NOT zero-filled here: a default-init
	// scalar local gets its zero store from IR-gen's var-decl path (gen_stmt.bn),
	// which fires only for the no-initializer case — firing here would re-zero
	// every OP_ALLOC, including initialized ones that emitAlloc also visits.
	var und @types.Type = instr.TypeArg
	for und != nil {
		if und.Kind == types.TYP_NAMED && und.Underlying != nil {
			und = und.Underlying
		} else if und.Kind == types.TYP_READONLY {
			und = und.Elem
		} else {
			break
		}
	}
	if und == nil {
		return
	}
	// Zero-fill any multi-word AGGREGATE — the same set the native backends
	// zero (common.IsAggregateTyp): struct, array, raw/managed slice,
	// func-value, and interface-value.  Leaving these as LLVM `undef` while
	// native + the VM zero them is a backend inconsistency: a partial-init
	// constructor (or an un-peeled no-init dispatch) then reads nondeterministic
	// garbage on LLVM only.  (A scalar is excluded above — handled by IR-gen.)
	var isAgg bool = und.Kind == types.TYP_STRUCT ||
		und.Kind == types.TYP_ARRAY ||
		und.Kind == types.TYP_MANAGED_SLICE ||
		und.Kind == types.TYP_SLICE ||
		und.Kind == types.TYP_FUNC_VALUE ||
		und.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		und.Kind == types.TYP_INTERFACE_VALUE ||
		und.Kind == types.TYP_INTERFACE_VALUE_MANAGED
	if !isAgg {
		return
	}
	emitFieldwiseZeroInstr(out, instr, instr.TypeArg, instr.ID)
	return
}

// emitGetFieldPtr emits a getelementptr for struct field access, with bitcast if needed.
func emitGetFieldPtr(out *strings.Builder, instr @ir.Instr) {
	// getelementptr inbounds %Struct, %Struct* %ptr, i32 0, i32 <index>
	var baseTyp @types.Type = instr.Args[0].TypeArg
	if baseTyp == nil && instr.Args[0].Typ != nil && instr.Args[0].Typ.Elem != nil {
		baseTyp = instr.Args[0].Typ.Elem
	}
	// Unwrap pointer-to-struct to get the struct type itself
	if baseTyp != nil && (baseTyp.Kind == types.TYP_POINTER || baseTyp.Kind == types.TYP_MANAGED_PTR) {
		if baseTyp.Elem != nil {
			baseTyp = baseTyp.Elem
		}
	}
	var baseLL @[]char = intLL()
	if baseTyp != nil {
		baseLL = llvmType(baseTyp)
	}

	// If the source is a pointer that's i8* at LLVM level, bitcast to struct pointer.
	// Managed pointers and bitcast results are i8*; allocas are already %Struct*.
	var needsBitcast bool = false
	if instr.Args[0].Typ != nil && baseTyp != nil {
		if instr.Args[0].Typ.Kind == types.TYP_MANAGED_PTR {
			needsBitcast = true
		}
		if instr.Args[0].Typ.Kind == types.TYP_POINTER && instr.Args[0].Op != iropcode.OP_ALLOC {
			needsBitcast = true
		}
	}
	var useBitcast bool = false
	if needsBitcast {
		// Emit bitcast: %vN.sc = bitcast i8* %vM to %Struct*
		emitRef(out, instr.ID)
		out.Write(".sc = bitcast i8* ")
		emitPtrRef(out, instr.Args[0])
		out.Write(" to ")
		out.Write(baseLL)
		out.Write("*\n  ")
		useBitcast = true
	}

	// Map Binate field index to LLVM index.  Named user structs emit the
	// packed form with explicit `[N x i8]` padding fields, so the Binate
	// index must be remapped past them.  Anonymous multi-return tuples emit
	// the non-packed `{...}` form WITHOUT padding fields, so their Binate
	// index already IS the LLVM index — remapping there overshoots whenever a
	// field has PaddingBefore > 0 (e.g. an iface after a `bool`).  Mirrors the
	// named-vs-anonymous split in emitStoreSSARec (emit_copy_ssa.bn).
	var llvmFieldIdx int = instr.Index
	if baseTyp != nil {
		var resolved @types.Type = baseTyp.ResolveAlias()
		if len(resolved.Name) > 0 {
			llvmFieldIdx = structLLVMIndex(baseTyp, instr.Index)
		}
	}

	emitRef(out, instr.ID)
	out.Write(" = getelementptr inbounds ")
	out.Write(baseLL)
	out.Write(", ")
	out.Write(baseLL)
	out.Write("* ")
	if useBitcast {
		emitRef(out, instr.ID)
		out.Write(".sc")
	} else {
		emitPtrRef(out, instr.Args[0])
	}
	out.Write(", i32 0, i32 ")
	stringutils.WriteInt(out, llvmFieldIdx)
	out.WriteByte('\n')
	return
}

// emitGetElemPtr emits a getelementptr for array/pointer element indexing.
func emitGetElemPtr(out *strings.Builder, instr @ir.Instr) {
	var baseTyp @types.Type = instr.Args[0].TypeArg
	// Raw pointer indexing: base is a pointer value (not an alloca)
	var isRawPtr bool =
		instr.Args[0].Op != iropcode.OP_ALLOC &&
			instr.Args[0].Typ != nil &&
			instr.Args[0].Typ.Kind == types.TYP_POINTER
	if isRawPtr {
		// Raw pointer indexing: bitcast i8* to ElemT*, then single-index GEP
		var elemTypLL @[]char = intLL()
		if instr.Typ != nil && instr.Typ.Elem != nil {
			elemTypLL = llvmType(instr.Typ.Elem)
		}
		// %vN.bc = bitcast i8* %base to ElemT*
		emitRef(out, instr.ID)
		out.Write(".bc = bitcast i8* ")
		emitRef(out, instr.Args[0].ID)
		out.Write(" to ")
		out.Write(elemTypLL)
		out.Write("*\n  ")
		// %vN = getelementptr ElemT, ElemT* %vN.bc, <int> %idx
		emitRef(out, instr.ID)
		out.Write(" = getelementptr ")
		out.Write(elemTypLL)
		out.Write(", ")
		out.Write(elemTypLL)
		out.Write("* ")
		emitRef(out, instr.ID)
		out.Write(".bc, ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.WriteByte('\n')
	} else {
		// Array alloca: double-index GEP: ptr[0][index].  Base
		// is either a local alloca (emit as %v<id>) or — for a
		// module-level `var heap [N]T` — a global (emit as
		// @bn_G...); emitPtrRef picks the right form
		// based on instr.Args[0].IsGlobalRef.
		emitRef(out, instr.ID)
		out.Write(" = getelementptr inbounds ")
		if baseTyp != nil {
			out.Write(llvmType(baseTyp))
		} else {
			out.Write(intLL())
		}
		out.Write(", ")
		if baseTyp != nil {
			out.Write(llvmType(baseTyp))
		} else {
			out.Write(intLL())
		}
		out.Write("* ")
		emitPtrRef(out, instr.Args[0])
		out.Write(", i64 0, ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.WriteByte('\n')
	}
	return
}

// emitReturn emits a ret instruction, packing multiple returns via insertvalue.
func emitReturn(out *strings.Builder, instr @ir.Instr) {
	if len(instr.Args) == 0 {
		out.Write("ret void\n")
	} else if len(instr.Args) == 1 {
		// NOTE: RefInc for ownership transfer on return is emitted in the IR gen
		// (before scope-exit RefDecs), not here. See genReturn in gen_stmt.bn.
		if currentFuncUsesSret {
			// sret-returning function: write through %v.retbuf and
			// `ret void`.  emitFuncDbg set up the sret arg as
			// %v.retbuf in the define-line.
			out.Write("store ")
			out.Write(llvmType(instr.Args[0].Typ))
			out.WriteByte(' ')
			emitValRef(out, instr.Args[0])
			out.Write(", ptr %v.retbuf\n")
			out.Write("  ret void\n")
			return
		}
		if aggRetCoerced(instr.Args[0].Typ) {
			// In-register aggregate return: coerce the `%S` result to
			// the `[N x i64]` ABI type (emit_agg_coerce.bn).
			emitAggReturn(out, instr)
			return
		}
		out.Write("ret ")
		out.Write(llvmType(instr.Args[0].Typ))
		out.WriteByte(' ')
		emitValRef(out, instr.Args[0])
		out.WriteByte('\n')
	} else {
		// Multi-return: pack values into struct with insertvalue
		var structTyp @[]char
		if instr.Typ != nil {
			structTyp = llvmType(instr.Typ)
		} else {
			structTyp = multiReturnType_args(instr.Args)
		}
		// Build aggregate with insertvalue chain
		// Previous agg name -- starts as "undef", then becomes "%v.ret.N.I"
		var prevIsUndef bool = true
		var prevRetSeq int = 0
		var prevRetIdx int = 0
		for i := 0; i < len(instr.Args); i++ {
			var curRetSeq int = retSeq
			retSeq++
			out.WriteByte(' ')
			out.Write("%v.ret.")
			stringutils.WriteInt(out, curRetSeq)
			out.WriteByte('.')
			stringutils.WriteInt(out, i)
			out.Write(" = insertvalue ")
			out.Write(structTyp)
			out.WriteByte(' ')
			if prevIsUndef {
				out.Write("undef")
			} else {
				out.Write("%v.ret.")
				stringutils.WriteInt(out, prevRetSeq)
				out.WriteByte('.')
				stringutils.WriteInt(out, prevRetIdx)
			}
			out.Write(", ")
			out.Write(llvmType(instr.Args[i].Typ))
			out.WriteByte(' ')
			emitValRef(out, instr.Args[i])
			out.Write(", ")
			stringutils.WriteInt(out, i)
			out.WriteByte('\n')
			out.Write("  ")
			prevIsUndef = false
			prevRetSeq = curRetSeq
			prevRetIdx = i
		}
		out.Write("ret ")
		out.Write(structTyp)
		out.WriteByte(' ')
		out.Write("%v.ret.")
		stringutils.WriteInt(out, prevRetSeq)
		out.WriteByte('.')
		stringutils.WriteInt(out, prevRetIdx)
		out.WriteByte('\n')
	}
	return
}

// emitExtract emits an extractvalue to unpack a field from a multi-return aggregate.
func emitExtract(out *strings.Builder, instr @ir.Instr, funcRetTypes *[]FuncRetType) {
	emitRef(out, instr.ID)
	out.Write(" = extractvalue ")
	// The aggregate is a call result -- look up its type from funcRetTypes
	var aggTyp @[]char
	var callInstr @ir.Instr = instr.Args[0]
	if callInstr.Op == iropcode.OP_CALL {
		aggTyp = lookupRetType(funcRetTypes, mangle.FuncName(modulePkgName,callInstr.StrVal))
	}
	if len(aggTyp) == 0 {
		aggTyp = llvmType(instr.Args[0].Typ)
	}
	out.Write(aggTyp)
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	stringutils.WriteInt(out, instr.Index)
	out.WriteByte('\n')
	return
}

// emitManagedToRawInstr emits extractvalue/insertvalue to convert @[]T to *[]T.
func emitManagedToRawInstr(out *strings.Builder, instr @ir.Instr) {
	// @[]T -> *[]T: extract {data, len} prefix from %BnManagedSlice
	var srcID int = instr.Args[0].ID
	emitRef(out, instr.ID)
	out.Write(".d = extractvalue %BnManagedSlice ")
	emitRef(out, srcID)
	out.Write(", 0\n  ")
	emitRef(out, instr.ID)
	out.Write(".l = extractvalue %BnManagedSlice ")
	emitRef(out, srcID)
	out.Write(", 1\n  ")
	emitRef(out, instr.ID)
	out.Write(".0 = insertvalue %BnSlice undef, i8* ")
	emitRef(out, instr.ID)
	out.Write(".d, 0\n  ")
	emitRef(out, instr.ID)
	out.Write(" = insertvalue %BnSlice ")
	emitRef(out, instr.ID)
	out.Write(".0, ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, instr.ID)
	out.Write(".l, 1\n")
	return
}

// rtSym returns the mangled symbol name for a pkg/builtins/rt runtime
// function (e.g. "Alloc" -> the mangled symbol for `rt.Alloc`), routed through
// mangle.FuncName so the runtime-call sites the codegen emits track the
// mangling scheme (one source of truth shared with the native backends).
// Callers emit the `@` sigil themselves, then this name.
func rtSym(name *[]readonly char) @[]char {
	return mangle.FuncName("pkg/builtins/rt", name)
}

// emitMakeSliceInstr emits a call to MakeManagedSlice for make_slice.
// The `.p` alloca is hoisted to function entry by emitMakeSliceAllocDecl;
// here we emit the sret call (passing `.p` as the sret buffer pointer)
// plus a load of the result.
func emitMakeSliceInstr(out *strings.Builder, instr @ir.Instr) {
	var elemSize int = elemSizeOf(instr.TypeArg)
	out.Write("call void @")
	out.Write(rtSym("MakeManagedSlice"))
	out.Write("(")
	out.Write("ptr sret(%BnManagedSlice) align 8 %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p, ")
	out.Write(intLL())
	out.WriteByte(' ')
	stringutils.WriteInt(out, elemSize)
	out.Write(", ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(")\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load %BnManagedSlice, %BnManagedSlice* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p\n")
	return
}

// boxValLLVM returns the LLVM type of OP_BOX's payload — the type whose
// `.tmp` slot the scalar-source path alloca's before handing its address
// to rt.Box.  emitBoxAllocDecl (the alloca hoist) and emitBoxInstr must
// agree on it.
func boxValLLVM(instr @ir.Instr) @[]char {
	var valTyp @types.Type = instr.Args[0].Typ
	if instr.Args[0].Op == iropcode.OP_ALLOC && instr.Args[0].TypeArg != nil {
		valTyp = instr.Args[0].TypeArg
	}
	return llvmType(valTyp)
}

// emitBoxAllocDecl emits the `%vID.tmp = alloca <T>` for an OP_BOX whose
// source is a scalar register (not an existing alloca): the payload must
// live in memory to take its address for rt.Box.  Hoisted to the entry
// block so a box() inside a loop body doesn't leak native stack per
// iteration.  An OP_ALLOC source already has its slot — no `.tmp` there.
func emitBoxAllocDecl(out *strings.Builder, instr @ir.Instr) {
	if len(instr.Args) < 1 { return }
	if instr.Args[0].Op == iropcode.OP_ALLOC { return }
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".tmp = alloca ")
	out.Write(boxValLLVM(instr))
	out.WriteByte('\n')
	return
}

// emitBoxInstr emits LLVM IR for OP_BOX: allocates a managed wrapper for
// a value, copies the value in, and returns a pointer to the payload.
// Branches on whether the source is an alloca (bitcast its address) or a
// scalar register (store-then-bitcast) to keep the generated IR direct.
// In the scalar-source case the `.tmp` spill alloca is hoisted to the
// entry block by emitBoxAllocDecl.
func emitBoxInstr(out *strings.Builder, instr @ir.Instr) {
	var valTyp @types.Type = instr.Args[0].Typ
	if instr.Args[0].Op == iropcode.OP_ALLOC && instr.Args[0].TypeArg != nil {
		valTyp = instr.Args[0].TypeArg
	}
	var valLLVM @[]char = llvmType(valTyp)
	var sizeBytes int = typeSizeBytes(valTyp)

	if instr.Args[0].Op == iropcode.OP_ALLOC {
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".bc = bitcast ")
		out.Write(valLLVM)
		out.Write("* ")
		emitRef(out, instr.Args[0].ID)
		out.Write(" to i8*\n")
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = call i8* @")
		out.Write(rtSym("Box"))
		out.Write("(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".bc, ")
		out.Write(intLL())
		out.WriteByte(' ')
		stringutils.WriteInt(out, sizeBytes)
		out.Write(")\n")
	} else {
		// The `.tmp` alloca is hoisted to the entry block by
		// emitBoxAllocDecl; only the store/bitcast/call run here.
		out.Write("  store ")
		out.Write(valLLVM)
		out.WriteByte(' ')
		emitRef(out, instr.Args[0].ID)
		out.Write(", ")
		out.Write(valLLVM)
		out.Write("* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".tmp\n  %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".bc = bitcast ")
		out.Write(valLLVM)
		out.Write("* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".tmp to i8*\n  ")
		emitRef(out, instr.ID)
		out.Write(" = call i8* @")
		out.Write(rtSym("Box"))
		out.Write("(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".bc, ")
		out.Write(intLL())
		out.WriteByte(' ')
		stringutils.WriteInt(out, sizeBytes)
		out.Write(")\n")
	}
	return
}


// emitDerefInstr lowers OP_DEREF to a `bitcast i8* to T*` followed by
// a `load T` of the result, where T is the element type recorded on
// instr.Typ. Used for raw-pointer field/element loads that don't fit
// the OP_LOAD path.
func emitDerefInstr(out *strings.Builder, instr @ir.Instr) {
	var elemTyp @types.Type = instr.Typ
	var elemLLVM @[]char = llvmType(elemTyp)
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".bc = bitcast i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(" to ")
	out.Write(elemLLVM)
	out.Write("*\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(elemLLVM)
	out.Write(", ")
	out.Write(elemLLVM)
	out.Write("* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".bc\n")
	return
}
