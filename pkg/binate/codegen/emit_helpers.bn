package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitAllocDecl emits just the `alloca` instruction for an OP_ALLOC.
// All alloca declarations are hoisted to the function entry block so
// that allocas inside loop bodies don't leak native stack per iteration
// (LLVM allocas in non-entry blocks allocate fresh stack each time the
// block is executed and aren't freed until function return).
func emitAllocDecl(out *strings.Builder, instr @ir.Instr) {
	var allocTyp @[]char = llvmType(instr.TypeArg)
	emitRef(out, instr.ID)
	out.Write(" = alloca ")
	out.Write(allocTyp)
	out.WriteByte('\n')
	return
}

// emitMakeSliceAllocDecl emits just the `.p = alloca %BnManagedSlice`
// for an OP_MAKE_SLICE instruction. Same hoisting rationale as
// emitAllocDecl: keeping it inline at the OP_MAKE_SLICE site (a
// non-entry block, e.g. inside a loop body or if-branch) leaks
// native stack per execution. The store/bitcast/load from the call
// result stay at the original location.
func emitMakeSliceAllocDecl(out *strings.Builder, instr @ir.Instr) {
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p = alloca %BnManagedSlice\n")
	return
}

// emitSretAllocDecl emits just the `.sret = alloca <type>` for an
// OP_CALL that uses sret return convention. Same hoisting rationale
// as emitAllocDecl. The actual `call void` and result load stay at
// the original location.
func emitSretAllocDecl(out *strings.Builder, instr @ir.Instr, funcRetTypes *[]FuncRetType) {
	var callNameBuf @[]char = mangle.FuncName(modulePkgName, instr.StrVal)
	if !lookupIsSret(funcRetTypes, callNameBuf) {
		return
	}
	var sretRetType @[]char = lookupRetType(funcRetTypes, callNameBuf)
	emitRef(out, instr.ID)
	out.Write(".sret = alloca ")
	out.Write(sretRetType)
	out.WriteByte('\n')
	return
}

// emitAlloc emits the zero-fill for struct/array OP_ALLOCs.  The
// alloca itself is hoisted to the entry block by emitAllocDecl;
// this runs at the original location so that each time control
// reaches the declaration (e.g. each loop iteration) the slot is
// re-zeroed.  Uses emitFieldwiseZero (per-scalar store of zero) so
// LLVM never lowers the zero-fill to memset / __aeabi_memclr (a
// libc dependency we don't carry on bare-metal — see
// explorations/plan-codegen-c-free-copies.md).
func emitAlloc(out *strings.Builder, instr @ir.Instr) {
	if instr.TypeArg == nil {
		return
	}
	// Decide whether to zero-fill on the PEELED kind: a named distinct type
	// (`type Arr [8]int`, `type Buf @[]int`) has Kind TYP_NAMED, so an unpeeled
	// `Kind ==` check would skip the fill and leave the local holding stack
	// garbage (a read of an unset element / field / slice-header word returns
	// garbage).  emitFieldwiseZeroInstr (-> emitZeroRec) already peels
	// TYP_NAMED/TYP_READONLY when it runs; only this gate did not.
	// A SCALAR (named or anonymous) is NOT zero-filled here: a default-init
	// scalar local gets its zero store from IR-gen's var-decl path (gen_stmt.bn),
	// which fires only for the no-initializer case — firing here would re-zero
	// every OP_ALLOC, including initialized ones that emitAlloc also visits.
	var und @types.Type = instr.TypeArg
	for und != nil {
		if und.Kind == types.TYP_NAMED && und.Underlying != nil {
			und = und.Underlying
		} else if und.Kind == types.TYP_READONLY {
			und = und.Elem
		} else {
			break
		}
	}
	if und == nil {
		return
	}
	// Zero-fill any multi-word AGGREGATE — the same set the native backends
	// zero (common.IsAggregateTyp): struct, array, raw/managed slice,
	// func-value, and interface-value.  Leaving these as LLVM `undef` while
	// native + the VM zero them is a backend inconsistency: a partial-init
	// constructor (or an un-peeled no-init dispatch) then reads nondeterministic
	// garbage on LLVM only.  (A scalar is excluded above — handled by IR-gen.)
	var isAgg bool = und.Kind == types.TYP_STRUCT || und.Kind == types.TYP_ARRAY ||
			und.Kind == types.TYP_MANAGED_SLICE || und.Kind == types.TYP_SLICE ||
			und.Kind == types.TYP_FUNC_VALUE || und.Kind == types.TYP_MANAGED_FUNC_VALUE ||
			und.Kind == types.TYP_INTERFACE_VALUE || und.Kind == types.TYP_INTERFACE_VALUE_MANAGED
	if !isAgg {
		return
	}
	emitFieldwiseZeroInstr(out, instr, instr.TypeArg, instr.ID)
	return
}

// emitGetFieldPtr emits a getelementptr for struct field access, with bitcast if needed.
func emitGetFieldPtr(out *strings.Builder, instr @ir.Instr) {
	// getelementptr inbounds %Struct, %Struct* %ptr, i32 0, i32 <index>
	var baseTyp @types.Type = instr.Args[0].TypeArg
	if baseTyp == nil && instr.Args[0].Typ != nil && instr.Args[0].Typ.Elem != nil {
		baseTyp = instr.Args[0].Typ.Elem
	}
	// Unwrap pointer-to-struct to get the struct type itself
	if baseTyp != nil && (baseTyp.Kind == types.TYP_POINTER || baseTyp.Kind == types.TYP_MANAGED_PTR) {
		if baseTyp.Elem != nil {
			baseTyp = baseTyp.Elem
		}
	}
	var baseLL @[]char = intLL()
	if baseTyp != nil {
		baseLL = llvmType(baseTyp)
	}

	// If the source is a pointer that's i8* at LLVM level, bitcast to struct pointer.
	// Managed pointers and bitcast results are i8*; allocas are already %Struct*.
	var needsBitcast bool = false
	if instr.Args[0].Typ != nil && baseTyp != nil {
		if instr.Args[0].Typ.Kind == types.TYP_MANAGED_PTR {
			needsBitcast = true
		}
		if instr.Args[0].Typ.Kind == types.TYP_POINTER && instr.Args[0].Op != iropcode.OP_ALLOC {
			needsBitcast = true
		}
	}
	var useBitcast bool = false
	if needsBitcast {
		// Emit bitcast: %vN.sc = bitcast i8* %vM to %Struct*
		emitRef(out, instr.ID)
		out.Write(".sc = bitcast i8* ")
		emitPtrRef(out, instr.Args[0])
		out.Write(" to ")
		out.Write(baseLL)
		out.Write("*\n  ")
		useBitcast = true
	}

	// Map Binate field index to LLVM index.  Named user structs emit the
	// packed form with explicit `[N x i8]` padding fields, so the Binate
	// index must be remapped past them.  Anonymous multi-return tuples emit
	// the non-packed `{...}` form WITHOUT padding fields, so their Binate
	// index already IS the LLVM index — remapping there overshoots whenever a
	// field has PaddingBefore > 0 (e.g. an iface after a `bool`).  Mirrors the
	// named-vs-anonymous split in emitStoreSSARec (emit_copy_ssa.bn).
	var llvmFieldIdx int = instr.Index
	if baseTyp != nil {
		var resolved @types.Type = baseTyp.ResolveAlias()
		if len(resolved.Name) > 0 {
			llvmFieldIdx = structLLVMIndex(baseTyp, instr.Index)
		}
	}

	emitRef(out, instr.ID)
	out.Write(" = getelementptr inbounds ")
	out.Write(baseLL)
	out.Write(", ")
	out.Write(baseLL)
	out.Write("* ")
	if useBitcast {
		emitRef(out, instr.ID)
		out.Write(".sc")
	} else {
		emitPtrRef(out, instr.Args[0])
	}
	out.Write(", i32 0, i32 ")
	stringutils.WriteInt(out, llvmFieldIdx)
	out.WriteByte('\n')
	return
}

// emitGetElemPtr emits a getelementptr for array/pointer element indexing.
func emitGetElemPtr(out *strings.Builder, instr @ir.Instr) {
	var baseTyp @types.Type = instr.Args[0].TypeArg
	// Pointer-value indexing: the base is a pointer VALUE (not an alloca).
	// A managed pointer counts too — `@([N]T)` is an i8* that points AT the
	// element buffer (the refcount header sits at a NEGATIVE offset), exactly
	// like a raw `*([N]T)`, so `(*m)[i]` indexes it through the same single-
	// index bitcast path.  Without including TYP_MANAGED_PTR a managed
	// pointer-to-array fell to the array-alloca double-index GEP below and
	// emitted invalid getelementptr indices.
	var isPtrVal bool = instr.Args[0].Op != iropcode.OP_ALLOC && instr.Args[0].Typ != nil &&
			(instr.Args[0].Typ.Kind == types.TYP_POINTER || instr.Args[0].Typ.Kind == types.TYP_MANAGED_PTR)
	if isPtrVal {
		// Raw / managed pointer indexing: bitcast i8* to ElemT*, single-index GEP
		var elemTypLL @[]char = intLL()
		if instr.Typ != nil && instr.Typ.Elem != nil {
			elemTypLL = llvmType(instr.Typ.Elem)
		}
		// %vN.bc = bitcast i8* %base to ElemT*
		emitRef(out, instr.ID)
		out.Write(".bc = bitcast i8* ")
		emitRef(out, instr.Args[0].ID)
		out.Write(" to ")
		out.Write(elemTypLL)
		out.Write("*\n  ")
		// %vN = getelementptr ElemT, ElemT* %vN.bc, <int> %idx
		emitRef(out, instr.ID)
		out.Write(" = getelementptr ")
		out.Write(elemTypLL)
		out.Write(", ")
		out.Write(elemTypLL)
		out.Write("* ")
		emitRef(out, instr.ID)
		out.Write(".bc, ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.WriteByte('\n')
	} else {
		// Array alloca: double-index GEP: ptr[0][index].  Base
		// is either a local alloca (emit as %v<id>) or — for a
		// module-level `var heap [N]T` — a global (emit as
		// @bn_G...); emitPtrRef picks the right form
		// based on instr.Args[0].IsGlobalRef.
		emitRef(out, instr.ID)
		out.Write(" = getelementptr inbounds ")
		if baseTyp != nil {
			out.Write(llvmType(baseTyp))
		} else {
			out.Write(intLL())
		}
		out.Write(", ")
		if baseTyp != nil {
			out.Write(llvmType(baseTyp))
		} else {
			out.Write(intLL())
		}
		out.Write("* ")
		emitPtrRef(out, instr.Args[0])
		out.Write(", i64 0, ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.WriteByte('\n')
	}
	return
}
