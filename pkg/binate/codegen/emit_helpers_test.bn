package "pkg/binate/codegen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for extracted emitInstr helpers (nontrivial op handlers).

func TestEmitAllocStructZeroInit() testing.TestResult {
	var src *[]readonly char = "package \"main\"\ntype P struct { X int }\nfunc main() { var p P }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "alloca") {
		return fail("expected alloca for struct")
	}
	// emitAlloc now zero-fills per-scalar via emitFieldwiseZero
	// (no aggregate `store ... zeroinitializer` — that's a libc
	// memset risk on ILP32 targets).  Pin the per-scalar store
	// shape: at least one `store i64 0, ptr ...` (or i32 on 32b).
	if contains(out, "zeroinitializer") {
		return fail("aggregate zeroinitializer must be gone for struct alloc")
	}
	if !contains(out, "store i64 0, ptr ") &&
		!contains(out, "store i32 0, ptr ") {
		return fail("expected per-field int 0 store")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitGetFieldPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type P struct { X int; Y int }\n")
	cb = cb.WriteStr("func main() { var p P; p.Y = 5 }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "getelementptr inbounds") {
		return fail("expected getelementptr for field access")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func f() (int, int) { return 1, 2 }\n")
	cb = cb.WriteStr("func main() { a, b := f() }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "insertvalue") {
		return fail("expected insertvalue for multi-return packing")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitMakeSlice() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var s @[]int = make_slice(int, 5) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "bn_pkg__builtins__rt__MakeManagedSlice") {
		return fail("expected MakeManagedSlice call")
	}
	var pass testing.TestResult
