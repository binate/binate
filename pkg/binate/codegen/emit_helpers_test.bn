}
func TestEmitManagedToRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func f() *[]int {\n")
	cb = cb.WriteStr("\tvar s @[]int = make_slice(int, 3)\n")
	cb = cb.WriteStr("\treturn s\n")
	cb = cb.WriteStr("}\n")
	cb = cb.WriteStr("func main() { f() }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue %BnManagedSlice") {
		return fail("expected extractvalue from managed slice")
	}
	var pass testing.TestResult
	return pass
}
// indexAfter returns the index of `needle` in `haystack` at or after
// `start`, or -1 if not found. Used to verify ordering in LLVM IR.
func indexAfter(haystack *[]readonly char, needle *[]readonly char, start int) int {
	if start < 0 { start = 0 }
	for i := start; i+len(needle) <= len(haystack); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i+j] != needle[j] {
				match = false
				break
			}
		}
		if match { return i }
	}
	return -1
}
// `var` declarations inside a for-loop body must not emit an `alloca`
// instruction inside the loop-body block — otherwise the native stack
// leaks per iteration (LLVM allocas in non-entry blocks allocate
// fresh stack each time the block runs and aren't freed until the
// function returns). The fix hoists all allocas to the entry block.
//
// Assertion: every `alloca` substring in the function appears before
// the `for.body:` block label.
func TestAllocaHoistedOutOfLoopBody() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar sum int = 0\n")
	cb = cb.WriteStr("\tfor i := 0; i < 10; i++ {\n")
	cb = cb.WriteStr("\t\tvar local int = i * 2\n")
	cb = cb.WriteStr("\t\tsum = sum + local\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	// No `alloca` must appear at or after for.body.
	var allocaAfter int = indexAfter(out, "alloca", bodyIdx)
	if allocaAfter >= 0 {
		return fail("found alloca inside/after for.body — should be hoisted to entry")
	}
	// Sanity: there must be at least one alloca somewhere (sum + i + local).
	var allocaAny int = indexAfter(out, "alloca", 0)
	if allocaAny < 0 { return fail("expected some alloca in output") }
	var pass testing.TestResult
	return pass
}
// Same check for struct allocas: the `alloca` line must be in entry,
// but the zero-init `store zeroinitializer` should remain at the
// declaration site so the slot is re-zeroed on each iteration.
func TestStructAllocaHoistedZeroInitStaysInBody() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type P struct { X int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar p P\n")
	cb = cb.WriteStr("\t\tp.X = i\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block") }
	// alloca must not appear in/after for.body
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("struct alloca should be hoisted, not in for.body")
	}
	// Per-iteration zero-fill must appear in/after for.body — the
	// shape changed from `store ... zeroinitializer` to per-scalar
	// `store i32 0` / `store i64 0` via emitFieldwiseZero.  Pin
	// the .fz<N>_dp GEP suffix unique to the fieldwise-zero path.
	if indexAfter(out, ".fz0_dp", bodyIdx) < 0 {
		return fail("expected fieldwise zero-init in for.body for re-zeroing per iteration")
	}
	var pass testing.TestResult
	return pass
}

// A call passing a >16-byte struct BY VALUE from inside a loop body
// must not emit the byval-spill `alloca` (the `%v<id>.bv<i>` slot)
// in the loop-body block — otherwise the native stack leaks one
// spill slot per iteration (LLVM allocas in non-entry blocks aren't
// freed until function return).  This is the bug that bottomed the
// bni VM's host stack under the `-int` unit-test modes: execLoop
// passes a 48-byte BCInstr by value to ~13 helper calls per
// iteration.  The fix hoists the byval alloca to the entry block
// (emitByvalAllocDecls); only the `store` into the slot stays at
// the call site.  See explorations/plan-codegen-byval-spill-hoist.md.
func TestByvalSpillAllocaHoistedToEntry() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func use(x Big) int { return x.c }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tuse(b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// Sanity: a byval spill slot must actually be generated — the
	// arg is a 24-byte struct, above the 16-byte byval threshold.
	// Without this the test could pass vacuously if byval stopped
	// triggering.
	if !contains(out, ".bv0") {
		return fail("expected a byval spill slot %v<id>.bv0 for the >16B struct arg")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	// No `alloca` may appear at or after for.body — the byval spill
	// alloca must be hoisted to the entry block.
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — byval spill must be hoisted to entry")
	}
	var pass testing.TestResult
	return pass
}

// A single call that is BOTH sret-returning AND byval-arg-taking
// (`func f(x Big) Big`, Big > 16 bytes) must get BOTH its `.bv<i>`
// spill slot and its `.sret` out-param slot hoisted to the entry
// block when the call is inside a loop.  This exercises the
// emit_debug.bn hoist-loop branch that emits emitByvalAllocDecls
// and emitSretAllocDecl for the same OP_CALL — the path the
// byval-spill hoist added alongside the pre-existing sret hoist.
func TestByvalAndSretBothHoistedFromOneCall() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func ident(x Big) Big { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar r Big = ident(b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// Both slot kinds must actually be generated (sanity, so the
	// test can't pass vacuously if either convention stops firing).
	if !contains(out, ".bv0") {
		return fail("expected a byval spill slot .bv0 for the >16B arg")
	}
	if !contains(out, ".sret") {
		return fail("expected an sret slot .sret for the >16B return")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	// Neither the byval nor the sret alloca may sit in/after the
	// loop body — both must be hoisted to entry.
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — byval + sret slots must both be hoisted")
	}
	var pass testing.TestResult
	return pass
}

// A function-value call passing an aggregate arg AND returning an
// aggregate, from inside a loop, must hoist both its `.ap<i>`
// aggregate-arg spill slot and its `.rb` retbuf to the entry block.
// Same leak class as the byval direct-call case, on the
// OP_CALL_FUNC_VALUE path (emitFuncValueArgPreamble / emitCallFuncValue
// keep the stores/bitcasts/call/load at the call site; the allocas
// are hoisted by emitFuncValueCallAllocDecls).
func TestFuncValueCallAggAllocasHoistedToEntry() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func use(x Big) Big { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(Big) Big = use\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar r Big = f(b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// Sanity: both slot kinds must actually be generated.
	if !contains(out, ".ap0") {
		return fail("expected aggregate-arg slot .ap0 for the func-value call")
	}
	if !contains(out, ".rb") {
		return fail("expected aggregate-return retbuf .rb for the func-value call")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — func-value .ap/.rb slots must be hoisted")
	}
	var pass testing.TestResult
	return pass
}

// An interface-method call returning a >16-byte aggregate (sret)
// from inside a loop must hoist its `.rb` sret buffer to the entry
// block (emitCallIfaceMethod keeps the thunk call + result-load at
// the call site; the alloca comes from emitIfaceMethodSretAllocDecl).
func TestIfaceMethodSretAllocaHoistedToEntry() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("interface S { str() @[]char }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) str() @[]char { return \"hi\" }\n")
	cb = cb.WriteStr("impl *T : S\n")
	cb = cb.WriteStr("func use(iv *S) {\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar _ @[]char = iv.str()\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	cb = cb.WriteStr("func main() { var t T; use(&t) }\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	// The sret retbuf alloca must appear BEFORE the loop body (i.e.
	// hoisted to the entry block).  Assert on the .rb slot
	// specifically rather than "no alloca after for.body": a
	// managed-slice return value brings its own per-iteration
	// cleanup temporaries into the loop body that are unrelated to
	// this fix.
	var rbIdx int = indexAfter(out, ".rb = alloca %BnManagedSlice", 0)
	if rbIdx < 0 {
		return fail("expected sret retbuf alloca for the iface-method call")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	if rbIdx >= bodyIdx {
		return fail("iface sret retbuf alloca must be hoisted before for.body, not at the call site")
	}
	var pass testing.TestResult
	return pass
}

// Isolates the .ap<i> aggregate-arg hoist from the .rb retbuf hoist:
// a func-value call with an aggregate ARG but a SCALAR return emits
// .ap0 and NO .rb.  emitFuncValueCallAllocDecls's .ap loop is
// independent of return type, so a regression that guarded .ap
// hoisting on the return shape would leak only in this combination —
// which TestFuncValueCallAggAllocasHoistedToEntry (aggregate arg AND
// return) can't catch.
func TestFuncValueCallAggArgScalarReturnHoisted() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func use(x Big) int { return x.c }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(Big) int = use\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar r int = f(b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, ".ap0") {
		return fail("expected aggregate-arg slot .ap0")
	}
	if contains(out, ".rb = alloca") {
		return fail("scalar return must not produce a .rb retbuf alloca")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block") }
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — .ap slot must be hoisted")
	}
	var pass testing.TestResult
	return pass
}

// Isolates the .rb retbuf hoist from the .ap hoist: a func-value
// call with NO aggregate args but an aggregate RETURN emits .rb and
// no .ap.  emitFuncValueCallAllocDecls's .rb branch is independent
// of the arg loop, so a regression that tied .rb emission to having
// aggregate args would leak only here.
func TestFuncValueCallAggReturnNoArgsHoisted() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func mk() Big { var b Big; return b }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func() Big = mk\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar r Big = f()\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, ".rb = alloca") {
		return fail("expected aggregate-return retbuf .rb alloca")
	}
	if contains(out, ".ap0") {
		return fail("a no-arg call must not produce an .ap aggregate-arg slot")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block") }
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — .rb retbuf must be hoisted")
	}
	var pass testing.TestResult
	return pass
}

// Exercises the void-return func-value call path AND multiple
// aggregate args: a `*func(Big, Big)` call emits .ap0 + .ap1 and no
// .rb.  A regression that special-cased only the first arg (.ap0)
// would leak .ap1 per iteration; the per-arg presence checks catch a
// loop that stops early, and the no-body-alloca check catches a
// hoist that misses .ap1.
func TestFuncValueCallMultiAggArgVoidHoisted() testing.TestResult {
	setTarget64()
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func sink(x Big, y Big) {}\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(Big, Big) = sink\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tf(b, b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, ".ap0") {
		return fail("expected first aggregate-arg slot .ap0")
	}
	if !contains(out, ".ap1") {
		return fail("expected second aggregate-arg slot .ap1")
	}
	if contains(out, ".rb = alloca") {
		return fail("a void call must not produce a .rb retbuf alloca")
	}
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block") }
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("found alloca in/after for.body — both .ap slots must be hoisted")
	}
	var pass testing.TestResult
	return pass
}

// Under -g (debug info on), the hoisted .ap<i> / .rb allocas go
// through emitFuncDbg's addDbgToLastLine annotation path on the new
// OP_CALL_FUNC_VALUE hoist branch.  Confirm the allocas still hoist
// (appear before for.body) and that debug locations are emitted
// (the -g path ran without malforming the output).
func TestFuncValueCallAggAllocasWithDebugInfo() testing.TestResult {
	setTarget64()
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type Big struct { a int64; b int64; c int64 }\n")
	cb = cb.WriteStr("func use(x Big) Big { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(Big) Big = use\n")
	cb = cb.WriteStr("\tvar b Big\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar r Big = f(b)\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	SetDebugInfo(false)
	if !contains(out, "DILocation") {
		return fail("expected DILocation debug metadata under -g")
	}
	var apIdx int = indexAfter(out, ".ap0", 0)
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if apIdx < 0 || bodyIdx < 0 {
		return fail("expected .ap0 slot and for.body block under -g")
	}
	if apIdx >= bodyIdx {
		return fail(".ap0 slot must be hoisted before for.body under -g")
	}
	var pass testing.TestResult
	return pass
}
