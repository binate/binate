package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for HFAs on arm32 hard-float (AAPCS-VFP): a fixed HFA argument and result
// take the FP form `[N x float]` / `[N x double]` (never sret / byval, whatever the
// size), as LLVM's ARM AAPCS-VFP lowering expects; a variadic __c_call passes and
// returns every HFA by the base standard — the GP form `[N x iW]` (byval past 16
// bytes), a result through sret past 4 bytes, `[1 x i32]` at 4; soft-float keeps the
// GP rules throughout.

// hfaArm32Src declares HFA types and functions passing and returning them, directly
// and through fixed and variadic __c_calls.
var hfaArm32Src *[]readonly char = "package \"main\"\n"
		"type F1 struct { x float32 }\n"
		"type D2 struct { x float64\n\ty float64 }\n"
		"type D3 struct { x float64\n\ty float64\n\tz float64 }\n"
		"func add(a D2, b float32) D2 { return D2{x: a.x + cast(float64, b), y: a.y} }\n"
		"func fixed(x float64, d D2) float64 {\n"
		"\tvar r D3 = __c_call(\"cmk\", D3, x)\n"
		"\treturn r.x + __c_call(\"cuse\", float64, d)\n"
		"}\n"
		"func variadic(x float64, d D2, e D3) float64 {\n"
		"\tvar r D2 = __c_call(\"vmk\", D2, cast(int32, 1), ..., x)\n"
		"\tvar f F1 = __c_call(\"vmkf1\", F1, cast(int32, 1), ..., x)\n"
		"\treturn r.x + cast(float64, f.x) + __c_call(\"vuse\", float64, cast(int32, 1), ..., d, e) +\n"
		"\t\t\t__c_call(\"vfix\", float64, d, cast(int32, 1), ...) +\n"
		"\t\t\t__c_call(\"vfix3\", float64, e, cast(int32, 1), ...)\n"
		"}\n"
		"func main() {\n"
		"\tvar d D2 = add(D2{x: 1.0, y: 2.0}, 0.5)\n"
		"\tvar e D3\n"
		"\t_ = fixed(1.0, d) + variadic(2.0, d, e)\n"
		"}\n"

// callLine returns the line of out holding a call to needle (e.g. "@f("), or "".
func callLine(out *[]readonly char, needle *[]readonly char) @[]char {
	var start int = 0
	for i := 0; i <= len(out); i++ {
		if i == len(out) || out[i] == '\n' {
			var line @[]char = make_slice(char, i - start)
			for k := 0; k < i - start; k++ { line[k] = out[start + k] }
			if contains(line, needle) && contains(line, "call ") { return line }
			start = i + 1
		}
	}
	var none @[]char
	return none
}

// compileHfaArm32 compiles hfaArm32Src for arm32 with the given float ABI.
func compileHfaArm32(floatABI int) @[]char {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(floatABI)
	var out @[]char = compileToLLVM(hfaArm32Src)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	types.SetArch(types.ARCH_UNKNOWN)
	setTarget64()
	return out
}

// A fixed HFA argument / result: `[2 x double]` both ways for a Binate function, and a
// 24-byte D3 __c_call result in d0-d2 — no sret.
func TestHfaArm32HardFixedFpForm() testing.TestResult {
	var out @[]char = compileHfaArm32(types.FLOAT_ABI_HARD)
	if !contains(out, "define [2 x double] @bn_F1_4_main1_3_add([2 x double] %v0.ag, float %v1)") {
		return fail("add must take and return D2 as [2 x double]")
	}
	if !contains(out, "declare [3 x double] @cmk(double)") {
		return fail("a __c_call returning D3 must return [3 x double], not through sret")
	}
	if !contains(out, "declare double @cuse([2 x double])") {
		return fail("a __c_call passing D2 must pass [2 x double]")
	}
	return ""
}

// A variadic __c_call uses the base standard: D2 (16 bytes) returns through sret, F1
// in r0 as [1 x i32]; a tail D2 is [2 x i64] and a tail D3 (24 bytes) byval; a FIXED
// D2 before `...` is [2 x i64] too.
func TestHfaArm32HardVariadicBaseStandard() testing.TestResult {
	var out @[]char = compileHfaArm32(types.FLOAT_ABI_HARD)
	if !contains(out, "declare void @vmk(ptr sret(%bn_S1_4_main1_2_D2) align 8, i32, ...)") {
		return fail("a variadic __c_call returning D2 must return it through sret")
	}
	if !contains(out, "declare [1 x i32] @vmkf1(i32, ...)") {
		return fail("a variadic __c_call returning F1 must return [1 x i32] (r0)")
	}
	var vuse @[]char = callLine(out, "@vuse(")
	if !contains(vuse, ", [2 x i64] %v") || !contains(vuse, ", ptr byval([3 x i64]) align 8 %v") {
		return fail("variadic tail HFAs must pass as [2 x i64] and byval (D3)")
	}
	if !contains(out, "declare double @vfix([2 x i64], i32, ...)") {
		return fail("a fixed HFA in a variadic __c_call must pass as [2 x i64]")
	}
	// A fixed 24-byte D3 is byval, with the same GP-view type in the declare and the
	// call, and a bare `ptr` in the call's explicit signature.
	if !contains(out, "declare double @vfix3(ptr byval([3 x i64]) align 8, i32, ...)") {
		return fail("a fixed D3 in a variadic __c_call must be declared byval [3 x i64]")
	}
	var vfix3 @[]char = callLine(out, "@vfix3(")
	if !contains(vfix3, "(ptr, i32, ...) @vfix3(ptr byval([3 x i64]) align 8 %v") {
		return fail("the fixed D3 must be passed byval [3 x i64] with a bare signature")
	}
	return ""
}

// Soft-float keeps the GP rules: D2 is an sret result and a [2 x i64] argument.
func TestHfaArm32SoftGpForm() testing.TestResult {
	var out @[]char = compileHfaArm32(types.FLOAT_ABI_SOFT)
	if !contains(out, "define void @bn_F1_4_main1_3_add(ptr sret(") {
		return fail("soft-float add must return D2 through sret")
	}
	if !contains(out, "declare double @cuse([2 x i64])") {
		return fail("soft-float must pass D2 as [2 x i64]")
	}
	if contains(out, "x double]") { return fail("soft-float must not spell any HFA in the FP form") }
	return ""
}
