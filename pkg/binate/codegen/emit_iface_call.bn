package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Interface-value ops: OP_IFACE_VALUE (construction), OP_CALL_IFACE_METHOD
// (dispatch), OP_IFACE_DTOR / OP_FUNC_VALUE_DTOR (vtable dtor loads)
// ============================================================
//
// Split out of emit_impls.bn for file-size hygiene; emit_impls.bn
// keeps the vtable-emission side (impl vtable globals + slot wiring
// + slot collection).

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD: dispatch through the vtable
// of an interface value.  Args[0] is the iv value (TYP_INTERFACE_VALUE /
// TYP_INTERFACE_VALUE_MANAGED); Args[1..] are user args; Index is the method
// slot.
//
// Every @__ivt method slot holds the method's function-value HANDLE
// (@__handle.<m>) — the same convention slot 0 (the dtor) already uses (see
// emitImplVtable, useHandles=true).  Dispatch therefore goes THROUGH the
// handle's marshaling shim exactly like OP_CALL_FUNC_VALUE, so a bytecode
// (VM-lowered) impl's method — whose handle re-enters the VM — is callable by
// native code identically to a native impl's.  The shim (@__shim.<m>, emitted
// by emitFuncValueShim over the method's `(receiver, args) -> results`
// func-value type) takes `(data, receiver, args)` (or `(retbuf, data, receiver,
// args)` for an aggregate return) and strips `data` before forwarding
// `(receiver, args)` to the real method.
//
// LLVM shape (scalar return, one scalar user arg):
//
//   %recv = extractvalue %BnIfaceValue %iv, 0     ; iv data ptr = the receiver
//   %vt8  = extractvalue %BnIfaceValue %iv, 1     ; vtable word (i8*)
//   %vts  = bitcast i8* %vt8 to i8**              ; -> array of slots
//   %hsp  = getelementptr inbounds i8*, i8** %vts, i64 <Index>
//   %hp   = load i8*, i8** %hsp                   ; the method HANDLE (a %BnFuncValue*)
//   %h    = bitcast i8* %hp to %BnFuncValue*
//   %dt   = load i8*, ... %h.data                 ; handle's own data word
//   %vt   = bitcast (load %h.vtable) to %BnVtable*
//   %cb   = load i8*, ... %vt.call                ; the shim
//   %fn   = bitcast i8* %cb to <ret>(i8*, i8*, <argTys>)*
//   %r    = call <ret> %fn(i8* %dt, i8* %recv, <args>)
//
// The handle-field extraction mirrors emitCallHandle (the handle is a POINTER
// loaded at runtime, not an SSA aggregate); the arg/return marshaling mirrors
// emitCallFuncValue, with the iv data ptr prepended as the first arg after the
// handle's data (the shim's receiver param).
func emitCallIfaceMethod(out *strings.Builder, instr @ir.Instr) {
	var iv @ir.Instr = instr.Args[0]
	var nArgs int = len(instr.Args) - 1
	var fnTyp @types.Type = ifaceMethodFuncType(instr)
	var isVoid bool = instr.Typ == nil || instr.Typ.Kind == types.TYP_VOID
	var isAggregate bool = isAggregateReturn(fnTyp)

	// Receiver = the iv's data ptr (%v<id>.recv), passed to the shim ahead of
	// the user args.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".recv = extractvalue %BnIfaceValue ")
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueDataIndex())
	out.Write("\n  ")
	// Vtable word -> i8** -> method slot -> handle pointer (i8*).  instr.Index
	// is the absolute vtable slot:
	// for a non-extended interface method_position + 2 (the two-word any-block —
	// dtor then *TypeInfo — precedes the methods); an extended interface
	// accounts for the concat layout's nested parent any-blocks.
	// findInterfaceMethod produces it.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue %BnIfaceValue ")
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueVtableIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vts = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to i8**\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hsp = getelementptr inbounds i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vts, i64 ")
	stringutils.WriteInt(out, instr.Index)
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hp = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hsp\n  ")
	// From the handle (mirrors emitCallHandle): load its data word and its
	// vtable.call slot (the shim).
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hp to %BnFuncValue*\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dtp = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h, i32 0, i32 ")
	stringutils.WriteInt(out, types.FuncValueDataIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dtp\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8p = getelementptr inbounds %BnFuncValue, %BnFuncValue* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".h, i32 0, i32 ")
	stringutils.WriteInt(out, types.FuncValueVtableIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hvt8 = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8p\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".hvt8 to %BnVtable*\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cp = getelementptr inbounds %BnVtable, %BnVtable* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i32 0, i32 1\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cb = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cp\n  ")

	// Bitcast the shim call slot to the method's shim signature — `<ret>(i8*
	// data, i8* receiver, <argTys>)*`, or `void(i8* retbuf, i8* data, i8*
	// receiver, <argTys>)*` for an aggregate return.  funcSignatureLLVM spells
	// the whole thing from fnTyp (Params[0] = receiver).
	var sig @[]char = funcSignatureLLVM(fnTyp)
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".cb to ")
	out.Write(sig)
	out.Write("\n  ")

	// Aggregate user args ride the shim's by-address convention.  paramBase 1
	// skips the receiver param (fnTyp.Params[0]); the arg values are still
	// instr.Args[i+1].
	emitFuncValueArgPreamble(out, instr, fnTyp, nArgs, 1)

	if isAggregate {
		// retbuf (%v<id>.rb) is hoisted to the entry block by
		// emitIfaceMethodCallAllocDecls; bitcast it to i8*, call the shim with
		// (retbuf, data, receiver, args...), then load the result back.
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb8 = bitcast ")
		writeFuncResultsLLVM(out, fnTyp)
		out.Write("* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb to i8*\n  ")
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb8, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".recv")
		emitFuncValueArgList(out, instr, fnTyp, nArgs, 1)
		out.Write(")\n  ")
		// The retbuf holds the natural aggregate bytes; for a coerced
		// in-register aggregate result the IR consumes the struct value, so load
		// it back as the struct (%S) — same bytes.  Otherwise load the natural
		// result type.  Mirrors emitCallFuncValue.
		emitRef(out, instr.ID)
		out.Write(" = load ")
		if aggRetCoerced(instr.Typ) {
			out.Write(llvmType(instr.Typ))
		} else {
			writeFuncResultsLLVM(out, fnTyp)
		}
		out.Write(", ")
		writeFuncResultsLLVM(out, fnTyp)
		out.Write("* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb\n")
		return
	}

	if isVoid {
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".recv")
		emitFuncValueArgList(out, instr, fnTyp, nArgs, 1)
		out.Write(")\n")
		return
	}
	if isFloatScalarParam(instr.Typ) {
		// The shim returns the int slot; receive it into a temp, then bitcast
		// back to the natural float type as the result value.
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fc = call ")
		out.Write(shimIntSlotType(instr.Typ))
		out.Write(" %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".recv")
		emitFuncValueArgList(out, instr, fnTyp, nArgs, 1)
		out.Write(")\n  ")
		emitRef(out, instr.ID)
		out.Write(" = bitcast ")
		out.Write(shimIntSlotType(instr.Typ))
		out.Write(" %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fc to ")
		out.Write(llvmType(instr.Typ))
		out.Write("\n")
		return
	}
	emitRef(out, instr.ID)
	out.Write(" = call ")
	out.Write(llvmType(instr.Typ))
	out.Write(" %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fn(i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt, i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".recv")
	emitFuncValueArgList(out, instr, fnTyp, nArgs, 1)
	out.Write(")\n")
	return
}

// ifaceMethodFuncType reconstructs the method's func-value TYPE at an
// OP_CALL_IFACE_METHOD site — the SAME type emitFuncValueShim used to emit the
// method's @__shim (so the dispatch's signature + return convention match the
// shim exactly).  Params = [receiver, user args]; Results = the method's result
// list.  The receiver is a plain `*uint8` because the shim's first non-data
// param is always a pointer (llvmType collapses every pointer receiver — raw,
// managed, or a value-receiver thunk's `*readonly T` — to i8*), so the exact
// pointee is irrelevant to the LLVM slot.  User-arg types come from the already-
// coerced call args (buildCallArgs bound them to the method's params), and the
// result list is recovered from instr.Typ.
func ifaceMethodFuncType(instr @ir.Instr) @types.Type {
	var nArgs int = len(instr.Args) - 1
	var params @[]@types.Param
	var recv @types.Param = make(types.Param)
	recv.Type = types.MakePointerType(types.TypUint8())
	params = slices.Append[@types.Param](params, recv)
	for i := 0; i < nArgs; i++ {
		var p @types.Param = make(types.Param)
		p.Type = instr.Args[i + 1].Typ
		params = slices.Append[@types.Param](params, p)
	}
	return types.MakeFuncValueType(params, ifaceMethodResultTypes(instr.Typ))
}

// ifaceMethodResultTypes recovers a method's result-type LIST from the collapsed
// OP_CALL_IFACE_METHOD result type stamped by genInterfaceMethodCall: void (nil
// / TYP_VOID) -> empty; a nameless struct with fields -> its field types (the
// multi-return tuple makeMultiReturnStructType built, reversed field-for-field);
// anything else -> the single type.  This is the exact inverse of the void /
// single / makeMultiReturnStructType collapse, so ifaceMethodFuncType's Results
// equal the impl method's real results and isAggregateReturn / writeFuncResultsLLVM
// agree with the shim.
func ifaceMethodResultTypes(typ @types.Type) @[]@types.Type {
	var results @[]@types.Type
	if typ == nil || typ.Kind == types.TYP_VOID { return results }
	if typ.Kind == types.TYP_STRUCT && len(typ.Name) == 0 && len(typ.Fields) > 0 {
		for i := 0; i < len(typ.Fields); i++ {
			results = slices.Append[@types.Type](results, typ.Fields[i].Type)
		}
		return results
	}
	results = slices.Append[@types.Type](results, typ)
	return results
}

// emitIfaceMethodCallAllocDecls emits the entry-block `alloca` lines an
// OP_CALL_IFACE_METHOD lowering needs under the handle/shim convention: the
// aggregate-arg coercion slots (`.cas<i>` / `.ap<i>`) and, for an aggregate
// return, the `%v<id>.rb` retbuf — exactly the func-value shape
// (emitShimCallAllocDecls, paramBase 1 to skip the receiver).  Called from
// emitFuncDbg's alloca-hoist pre-pass; the stores / call / result-load stay at
// the call site (emitCallIfaceMethod).  Returns out unchanged when the call has
// no aggregate args and a non-aggregate return.
func emitIfaceMethodCallAllocDecls(out *strings.Builder, instr @ir.Instr) {
	var fnTyp @types.Type = ifaceMethodFuncType(instr)
	var nArgs int = len(instr.Args) - 1
	emitShimCallAllocDecls(out, instr, fnTyp, nArgs, 1)
	return
}

// emitIfaceDtor lowers OP_IFACE_DTOR: load slot 0 of an interface
// value's vtable as an i8* (matches OP_FUNC_HANDLE's shape, which
// is the type of the dtor operand of OP_REFDEC). Args[0] is the iv.
//
// LLVM shape:
//
//   %vt8 = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt  = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp  = getelementptr inbounds i8*, i8** %vt, i64 0
//   %r   = load i8*, i8** %sp                   ; dtor i8*
func emitIfaceDtor(out *strings.Builder, instr @ir.Instr) {
	emitVtableSlotLoad(out, instr, "%BnIfaceValue", types.IfaceValueVtableIndex(), 0)
	return
}

// emitFuncValueDtor lowers OP_FUNC_VALUE_DTOR — same shape as
// emitIfaceDtor but extracts the vtable from slot 0 of
// %BnFuncValue (which is laid out {vtable, data}, the opposite of
// %BnIfaceValue's {data, vtable}).
func emitFuncValueDtor(out *strings.Builder, instr @ir.Instr) {
	emitVtableSlotLoad(out, instr, "%BnFuncValue", types.FuncValueVtableIndex(), 0)
	return
}

// emitIfaceTypeInfo lowers OP_IFACE_TYPEINFO — read an interface value's
// dynamic `*TypeInfo` from any-block slot 1 of its vtable (spec §7.13.8 /
// §11.12).  Same shape as emitIfaceDtor but loads vtable slot 1 (the
// `*TypeInfo`) instead of slot 0 (the dtor).
func emitIfaceTypeInfo(out *strings.Builder, instr @ir.Instr) {
	emitVtableSlotLoad(out, instr, "%BnIfaceValue", types.IfaceValueVtableIndex(), 1)
	return
}

// emitVtableSlotLoad is the shared LLVM-emit body of emitIfaceDtor /
// emitFuncValueDtor / emitIfaceTypeInfo: extract the vtable pointer from slot
// `vtSlot` of the 2-word value `valueTyp` (`%BnIfaceValue` = {data, vtable};
// `%BnFuncValue` = {vtable, data}), then load word `loadSlot` of that vtable —
// slot 0 is the dtor handle, slot 1 the `*TypeInfo`.  Result is an i8*.
func emitVtableSlotLoad(out *strings.Builder, instr @ir.Instr, valueTyp *[]readonly char,
		vtSlot int, loadSlot int) {
	var iv @ir.Instr = instr.Args[0]
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue ")
	out.Write(valueTyp)
	out.WriteByte(' ')
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, vtSlot)
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to i8**\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(
			".sp = getelementptr inbounds i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i64 ")
	stringutils.WriteInt(out, loadSlot)
	out.Write("\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".sp\n")
	return
}

// emitIfaceValueLLVM lowers OP_IFACE_VALUE — interface-value construction —
// to a 2-word %BnIfaceValue built by an insertvalue chain:
//   data    = bitcast (<srcType> %data to i8*)   ; field 0 (Args[0])
//   vtable  = bitcast (... to i8*)               ; field 1
// STATIC form (instr.StrVal non-empty): the vtable is the
// `[N x i8*]* @<__ivt.<...>>` global (emitted by emitImplVtables, Slice
// 2.3a-1) bitcast to i8*.  DYNAMIC form (instr.StrVal empty): the vtable is a
// runtime SSA value in Args[1] (interface-assertion recovery, RTTI Slice 5)
// bitcast to i8* directly, with no symbol reference.  m is consulted only in
// the static form (vtableSlotCount).
func emitIfaceValueLLVM(out *strings.Builder, m @ir.Module, instr @ir.Instr) {
	var dataInstr @ir.Instr = instr.Args[0]
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dp = bitcast ")
	if dataInstr.IsGlobalRef {
		// The data ptr is a global's address (`@<mangled>`), which has LLVM
		// type `<pointee>*`.  llvmType collapses a raw pointer to `i8*`, which
		// would mismatch the global symbol's real pointer type, so spell the
		// pointee type (TypeArg) explicitly and reference the symbol via
		// emitPtrRef rather than a nonexistent `%v<id>` (the global pseudo-instr
		// has ID -1).
		out.Write(llvmType(dataInstr.TypeArg))
		out.Write("* ")
		emitPtrRef(out, dataInstr)
	} else {
		out.Write(llvmType(dataInstr.Typ))
		out.WriteByte(' ')
		emitRef(out, dataInstr.ID)
	}
	out.Write(" to i8*\n  ")
	if len(instr.StrVal) == 0 {
		// DYNAMIC vtable: bitcast the runtime Args[1] SSA value to i8*.
		var vtInstr @ir.Instr = instr.Args[1]
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt = bitcast ")
		out.Write(llvmType(vtInstr.Typ))
		out.WriteByte(' ')
		emitValRef(out, vtInstr)
		out.Write(" to i8*\n  ")
	} else {
		// STATIC vtable: bitcast the `[N x i8*]* @<__ivt>` global to i8*.
		var nSlots int = vtableSlotCount(m, instr.StrVal)
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt = bitcast [")
		stringutils.WriteInt(out, nSlots)
		out.Write(" x i8*]* @")
		out.Write(instr.StrVal)
		out.Write(" to i8*\n  ")
	}
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".0 = insertvalue %BnIfaceValue undef, i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dp, ")
	stringutils.WriteInt(out, types.IfaceValueDataIndex())
	out.Write("\n  ")
	emitRef(out, instr.ID)
	out.Write(" = insertvalue %BnIfaceValue %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".0, i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, ")
	stringutils.WriteInt(out, types.IfaceValueVtableIndex())
	out.Write("\n")
	return
}
