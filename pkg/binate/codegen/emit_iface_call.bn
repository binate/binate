package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Interface-value dispatch — OP_CALL_IFACE_METHOD, OP_IFACE_DTOR
// ============================================================
//
// Split out of emit_impls.bn for file-size hygiene; emit_impls.bn
// keeps the vtable-emission side (impl vtable globals + slot wiring
// + slot collection).

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD: dispatch through
// the vtable of an interface value. Args[0] is the iv value
// (TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED); Args[1..] are
// user args; Index is the method slot.
//
// LLVM shape:
//
//   %dt   = extractvalue %BnIfaceValue %iv, 0   ; data ptr
//   %vt8  = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt   = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp   = getelementptr inbounds i8*, i8** %vt, i64 <Index>
//   %fp   = load i8*, i8** %sp                   ; function pointer
//   %fn   = bitcast i8* %fp to <ret>(i8*, <argTys>)*
//   %r    = call <ret> %fn(i8* %dt, <args>)
//
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
func emitCallIfaceMethod(out *strings.Builder,
		instr @ir.Instr) {
	var iv @ir.Instr = instr.Args[0]
	var nArgs int = len(instr.Args) - 1
	var isVoid bool = instr.Typ == nil ||
		instr.Typ.Kind == types.TYP_VOID
	// The bitcast signature and call shape must match the callee's
	// definition convention (emit_debug.bn): a SINGLE >16-byte result is
	// returned via explicit sret, but a MULTI-return tuple is returned BY
	// VALUE.  ifaceMethodUsesSret encodes that distinction — using sret for
	// a multi-return would read an unwritten buffer (garbage).
	var useSret bool = ifaceMethodUsesSret(instr)

	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt = extractvalue %BnIfaceValue ")
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueDataIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue %BnIfaceValue ")
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueVtableIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to i8**\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(
		".sp = getelementptr inbounds i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i64 ")
	// instr.Index is the absolute vtable slot (Slice E.4 of
	// plan-interface-embedding.md).  For a non-extended interface
	// it equals method_position + 2 (the two-word any-block — dtor
	// then *TypeInfo — precedes the methods); for an extended
	// interface it accounts for the concat layout's nested parent
	// any-blocks.  findInterfaceMethod produces it.
	stringutils.WriteInt(out, instr.Index)
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fp = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".sp\n  ")
	// Bitcast the function pointer to the thunk's actual signature:
	//   sret form: void(ptr sret(<ret>) align 8, i8*, args...)*
	//   direct:    <ret>(i8*, args...)*   or   void(i8*, args...)*
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fn = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".fp to ")
	if useSret {
		out.Write("void")
	} else if isVoid {
		out.Write("void")
	} else if aggCallResultCoerced(instr) {
		// Coerced in-register-aggregate result: the thunk returns the
		// coerced ABI type, so the bitcast signature + the call result must
		// spell it — x64 SSE's `{ .. }` / eightbyte aggregate (sysvReturnLLTy)
		// or the GP `[N x iW]` (aggCoerceLLTy).  See emit_sysv_coerce.bn.
		if types.SysVInSse(instr.Typ) {
			sysvReturnLLTy(out, instr.Typ)
		} else {
			aggCoerceLLTy(out, instr.Typ)
		}
	} else {
		out.Write(llvmType(instr.Typ))
	}
	out.WriteByte('(')
	if useSret {
		out.Write("ptr, ")
	}
	out.Write("i8*")
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i+1]
		out.Write(", ")
		if types.SysVInSse(argInstr.Typ) {
			// x64 SSE aggregate arg: the thunk's define splits it into
			// per-eightbyte params, so the bitcast sig must too.
			sysvWriteDeclareParamTypes(out, argInstr.Typ)
		} else {
			writeParamTypeLLVM(out, argInstr.Typ)
		}
	}
	out.Write(")*\n  ")
	// Spill each >16-byte by-value aggregate arg into its hoisted
	// `.bv<i>` slot and pass a plain `ptr`: the vtable thunk declares
	// those params as `ptr` (writeParamTypeLLVM), so passing the
	// aggregate by value would shift every following arg (598) or
	// wild-deref a value-as-pointer (the >16-byte indirect-call SIGSEGV).
	writeByvalArgPreamble(out, instr)

	// Coerce in-register-aggregate positional args to `[N x iW]` (the
	// thunk's coerced param type) before the call line.
	emitAggIfaceArgPreamble(out, instr, nArgs)

	if useSret {
		// The sret buffer (%v<id>.rb) is hoisted to the function
		// entry block by emitIfaceMethodSretAllocDecl (emitFuncDbg's
		// pre-pass) so an iface-method call returning a big struct
		// from inside a loop doesn't leak a fresh buffer per
		// iteration; here we only call the thunk through it and load
		// the result.
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(ptr sret(")
		out.Write(llvmType(instr.Typ))
		out.Write(") align 8 %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt")
	} else if isVoid {
		out.Write("call void %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt")
	} else {
		if aggCallResultCoerced(instr) {
			// Capture the thunk's coerced result as `%v<id>.agR`; the
			// post-call bind (emitAggCallResultBind, SSE-aware) loads
			// `%v<id>` as the struct.  x64 SSE's `{ .. }` / eightbyte
			// aggregate (sysvReturnLLTy) or the GP `[N x iW]`.
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".agR = call ")
			if types.SysVInSse(instr.Typ) {
				sysvReturnLLTy(out, instr.Typ)
			} else {
				aggCoerceLLTy(out, instr.Typ)
			}
		} else {
			emitRef(out, instr.ID)
			out.Write(" = call ")
			out.Write(llvmType(instr.Typ))
		}
		out.Write(" %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".fn(i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dt")
	}
	for i := 0; i < nArgs; i++ {
		out.Write(", ")
		var argInstr @ir.Instr = instr.Args[i+1]
		if aggIfaceArgCoerced(instr, i) {
			// Coerced in-register aggregate (loaded from the `.agA<i>` slot
			// by emitAggIfaceArgPreamble): x64 SSE passes split per-eightbyte
			// values (sysvWriteIfaceArg), the GP path one `[N x iW]` value.
			if types.SysVInSse(argInstr.Typ) {
				sysvWriteIfaceArg(out, instr, i)
			} else {
				writeAggIfaceArg(out, instr, i)
			}
		} else if argInstr.Typ.IsByvalParam() {
			// Pass the spill-slot pointer filled by the preamble above;
			// matches the thunk's `ptr` param.  Args index is i+1
			// (Args[0] is the iface value), so the slot is `.bv<i+1>`.
			out.Write("ptr %v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".bv")
			stringutils.WriteInt(out, i + 1)
		} else {
			out.Write(llvmType(argInstr.Typ))
			out.WriteByte(' ')
			emitValRef(out, argInstr)
		}
	}
	out.Write(")\n")
	if useSret {
		// Load the result from the sret alloca to produce the SSA value.
		out.Write("  ")
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(llvmType(instr.Typ))
		out.Write(", ptr %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".rb\n")
	} else if aggCallResultCoerced(instr) {
		// Bind the coerced `[N x iW]` result back to the `%S` value
		// `%v<id>` via the entry-hoisted `.agRB` slot.
		emitAggCallResultBind(out, instr)
	}
	return
}

// ifaceMethodUsesSret reports whether an OP_CALL_IFACE_METHOD's return uses
// the explicit-sret convention.  Both emitCallIfaceMethod and
// emitIfaceMethodSretAllocDecl gate on this so the hoisted alloca and the
// call shape always agree (see singleResultUsesSret for the rationale).
func ifaceMethodUsesSret(instr @ir.Instr) bool {
	return singleResultUsesSret(instr.Typ)
}

// singleResultUsesSret reports whether a call returning `typ` passes the
// result via an explicit sret pointer (>16-byte single aggregate), as
// opposed to by value in registers.  Gates the iface-method path
// (ifaceMethodUsesSret) so it agrees with the callee's definition convention:
// a Binate function returns via sret only for a SINGLE >16-byte result.  A
// MULTI-return
// result reaches codegen as an anonymous tuple struct (no Name, has fields)
// and is returned BY VALUE — the register convention LLVM legalizes
// consistently — so dispatching it with explicit sret would read an
// unwritten buffer (garbage).
func singleResultUsesSret(typ @types.Type) bool {
	if typ == nil || typ.Kind == types.TYP_VOID { return false }
	if !needsSret(typ) { return false }
	if typ.Kind == types.TYP_STRUCT &&
		len(typ.Name) == 0 && len(typ.Fields) > 0 {
		return false
	}
	return true
}

// emitIfaceMethodSretAllocDecl emits ONLY the `%v<id>.rb = alloca
// <ret>` for an OP_CALL_IFACE_METHOD whose return uses the sret
// convention (>16-byte aggregate).  Called from emitFuncDbg's
// alloca-hoist pre-pass; the thunk call through the buffer and the
// result-load stay at the call site (emitCallIfaceMethod).  The
// sret-vs-direct decision mirrors emitCallIfaceMethod's `useSret`
// exactly, so the hoisted alloca is emitted iff the call site
// references it.  Returns out unchanged otherwise.
func emitIfaceMethodSretAllocDecl(out *strings.Builder,
		instr @ir.Instr) {
	if !ifaceMethodUsesSret(instr) { return }
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".rb = alloca ")
	out.Write(llvmType(instr.Typ))
	out.WriteByte('\n')
	return
}

// emitIfaceDtor lowers OP_IFACE_DTOR: load slot 0 of an interface
// value's vtable as an i8* (matches OP_FUNC_HANDLE's shape, which
// is the type of the dtor operand of OP_REFDEC). Args[0] is the iv.
//
// LLVM shape:
//
//   %vt8 = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt  = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp  = getelementptr inbounds i8*, i8** %vt, i64 0
//   %r   = load i8*, i8** %sp                   ; dtor i8*
//
// Slice 2.5b of plan-interface-syntax-revision.md.
func emitIfaceDtor(out *strings.Builder,
		instr @ir.Instr) {
	emitVtableDtorLoad(out, instr, "%BnIfaceValue", types.IfaceValueVtableIndex())
	return
}

// emitFuncValueDtor lowers OP_FUNC_VALUE_DTOR — same shape as
// emitIfaceDtor but extracts the vtable from slot 0 of
// %BnFuncValue (which is laid out {vtable, data}, the opposite of
// %BnIfaceValue's {data, vtable}).
func emitFuncValueDtor(out *strings.Builder,
		instr @ir.Instr) {
	emitVtableDtorLoad(out, instr, "%BnFuncValue", types.FuncValueVtableIndex())
	return
}

// emitVtableDtorLoad is the shared LLVM-emit body of
// emitIfaceDtor / emitFuncValueDtor.  `valueTyp` is the LLVM type
// name of the 2-word aggregate (`%BnIfaceValue` or `%BnFuncValue`);
// `vtSlot` is the index of the vtable pointer in that aggregate
// (1 for iface, 0 for func-value).  Both ops then load slot 0 of
// the vtable — the dtor.
func emitVtableDtorLoad(out *strings.Builder,
		instr @ir.Instr, valueTyp *[]readonly char,
		vtSlot int) {
	var iv @ir.Instr = instr.Args[0]
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue ")
	out.Write(valueTyp)
	out.WriteByte(' ')
	emitRef(out, iv.ID)
	out.Write(", ")
	stringutils.WriteInt(out, vtSlot)
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to i8**\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(
		".sp = getelementptr inbounds i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i64 0\n  ")
	emitRef(out, instr.ID)
	out.Write(" = load i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".sp\n")
	return
}
