package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for emit_iface_call.bn — OP_CALL_IFACE_METHOD and OP_IFACE_DTOR
// dispatch through the iv vtable.  End-to-end dispatch behaviour is covered
// by conformance tests (411_pkg_std_stringer, 357_iface_dispatch, etc.);
// these unit tests pin LLVM-text shape so a regression in the handle-based
// dispatch (S1 of plan-iface-crossmode.md) shows up here, not as silent
// runtime corruption.
//
// Post-S1, every @__ivt method slot holds the method's function-value HANDLE
// (@__handle.<m>), so dispatch loads the handle from the vtable slot, extracts
// its data + vtable.call (the marshaling shim), and calls the shim with the iv
// data ptr prepended as the receiver — the SAME convention OP_CALL_FUNC_VALUE
// uses (emit_call_funcvalue.bn).  The shim signature therefore carries the
// handle's data ptr AND the receiver ahead of the user args.

// A scalar-returning interface method dispatches through the loaded handle's
// shim: bitcast to `<ret>(i8* data, i8* receiver, args...)*` and call with
// (data, receiver).  No retbuf alloca, no `ptr sret(...)` parameter.
func TestEmitCallIfaceMethodScalarReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() int }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() int { return t.x }\n"
			"impl *T : I\n"
			"func use(iv *I) int { return iv.foo() }\n"
			"func main() { var t T; var iv *I = &t; var _ int = use(iv) }\n"
	var out @[]char = compileToLLVM(src)
	// The method HANDLE is loaded from the vtable slot, then its data +
	// vtable.call are extracted; the receiver is the iv data ptr.
	if !contains(out, ".hp = load i8*, i8** %") {
		return fail("expected method-handle load from the vtable slot")
	}
	if !contains(out, ".recv = extractvalue %BnIfaceValue %") {
		return fail("expected receiver (iv data ptr) extract")
	}
	// Shim signature: data ptr + receiver ptr ahead of the (empty) user args.
	if !contains(out, ".fn = bitcast i8*") {
		return fail("expected shim function-pointer bitcast")
	}
	if !contains(out, "to i64(i8*, i8*)*") {
		return fail("expected scalar shim bitcast: i64(i8*, i8*)*")
	}
	// Call passes (data, receiver).
	if !contains(out, ".dt, i8* %") {
		return fail("expected shim call to pass (data, receiver)")
	}
	// Scalar return uses no retbuf and no C-ABI sret.
	if contains(out, ".rb = alloca") {
		return fail("scalar return must not emit a retbuf alloca")
	}
	if contains(out, "ptr sret(") {
		return fail("handle dispatch must not use the C-ABI sret convention")
	}
	return ""
}

// An aggregate-returning interface method (32-byte managed-slice) dispatches
// via the shim's retbuf shape: bitcast to `void(i8* retbuf, i8* data, i8*
// receiver, args...)*`, a hoisted retbuf alloca, a void call through it, and a
// load-from-retbuf for the SSA result.  This mirrors OP_CALL_FUNC_VALUE's
// aggregate path — NOT the old C-ABI sret shape.
func TestEmitCallIfaceMethodRetbufReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface S { str() @[]char }\n"
			"type T struct { x int }\n"
			"func (t *T) str() @[]char { return \"hi\" }\n"
			"impl *T : S\n"
			"func use(iv *S) @[]char { return iv.str() }\n"
			"func main() { var t T; var iv *S = &t; var _ @[]char = use(iv) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".fn = bitcast i8*") {
		return fail("expected shim function-pointer bitcast")
	}
	// Retbuf shim shape: void(retbuf, data, receiver) — three leading i8*.
	if !contains(out, "to void(i8*, i8*, i8*)*") {
		return fail("expected retbuf-form bitcast: void(i8*, i8*, i8*)*")
	}
	if !contains(out, ".rb = alloca %BnManagedSlice") {
		return fail("expected retbuf alloca")
	}
	// The retbuf alloca is hoisted to the entry block, so it must precede the
	// call site (a regression re-emitting it inline, or dropping the hoist,
	// would put it after).
	var rbAllocaIdx int = indexAfter(out, ".rb = alloca %BnManagedSlice", 0)
	var callIdx int = indexAfter(out, ".rb8, i8* %", 0)
	if rbAllocaIdx < 0 || callIdx < 0 || rbAllocaIdx >= callIdx {
		return fail("retbuf alloca must be hoisted before the retbuf-form call site")
	}
	// The retbuf is bitcast to i8* and passed as the shim's first arg, ahead of
	// the handle data + receiver.
	if !contains(out, ".rb8 = bitcast %BnManagedSlice* %") {
		return fail("expected retbuf bitcast to i8*")
	}
	if !contains(out, "call void %") {
		return fail("expected void retbuf-form call")
	}
	// Result is loaded back from the retbuf.
	if !contains(out, " = load %BnManagedSlice, %BnManagedSlice* %") {
		return fail("expected load from the retbuf")
	}
	return ""
}

// A >16-byte struct passed by value to an interface method rides the shim's
// by-address convention: the aggregate is spilled to a hoisted `.ap<i>` slot
// and passed as an i8* pointer, and the shim signature declares it as an i8*
// (not the struct value).  Three int64s = 24 bytes on every target, so the
// >word aggregate threshold fires regardless of pointer width.
func TestEmitCallIfaceMethodByvalAggregateArg() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct {\n"
			"\ta int64\n"
			"\tb int64\n"
			"\tc int64\n"
			"}\n"
			"interface Sink { take(x Big, tag int) int }\n"
			"type T struct { y int }\n"
			"func (t *T) take(x Big, tag int) int { return tag }\n"
			"impl *T : Sink\n"
			"func use(iv *Sink) int { var b Big; return iv.take(b, 7) }\n"
			"func main() { var t T; var iv *Sink = &t; var _ int = use(iv) }\n"
	var out @[]char = compileToLLVM(src)
	// The shim signature passes the >16-byte struct by-address (i8*), after the
	// data + receiver ptrs and before the trailing i64 tag.
	if !contains(out, "to i64(i8*, i8*, i8*, i64)*") {
		return fail("expected >16-byte struct arg lowered to i8* in the shim signature")
	}
	// The spill slot for the aggregate arg (user arg 0) is hoisted to the entry
	// block, then bitcast to i8* and passed.
	if !contains(out, ".ap0 = alloca ") {
		return fail("expected hoisted aggregate-arg spill-slot alloca (.ap0)")
	}
	if !contains(out, ".ap8.0 = bitcast ") {
		return fail("expected aggregate-arg spill slot bitcast to i8*")
	}
	if !contains(out, ", i8* %") {
		return fail("expected the call to pass the aggregate spill slot as i8*")
	}
	return ""
}

// A multi-return interface method (two ints = a >word tuple) dispatches via the
// retbuf shim shape too: isAggregateReturn is register-count-independent here
// because a 2-word tuple exceeds one word.  The reconstructed method func type
// must recover the tuple result list so the shim signature / retbuf agree.
func TestEmitCallIfaceMethodMultiReturnUsesRetbuf() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface P { pair() (int, int) }\n"
			"type T struct { x int }\n"
			"func (t *T) pair() (int, int) { return t.x, t.x }\n"
			"impl *T : P\n"
			"func use(iv *P) int { var a int; var b int; a, b = iv.pair(); return a + b }\n"
			"func main() { var t T; var iv *P = &t; var _ int = use(iv) }\n"
	var out @[]char = compileToLLVM(src)
	// Retbuf shape (no user args): void(retbuf, data, receiver).
	if !contains(out, "to void(i8*, i8*, i8*)*") {
		return fail("expected multi-return retbuf bitcast: void(i8*, i8*, i8*)*")
	}
	if !contains(out, ".rb = alloca <{ i64, i64 }>") {
		return fail("expected retbuf alloca of the two-int tuple")
	}
	if !contains(out, ".rb8 = bitcast <{ i64, i64 }>* %") {
		return fail("expected retbuf bitcast to i8*")
	}
	return ""
}

// OP_IFACE_DTOR loads slot 0 of the iv's vtable as an i8*.
// Same shape regardless of the interface's method count or
// return-type characteristics.
func TestEmitIfaceDtorLoadsSlotZero() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { s @[]char }\n"
			"func (t *T) foo() { }\n"
			"impl @T : I\n"
			"func main() { var t @T = make(T); var iv @I = t }\n"
	var out @[]char = compileToLLVM(src)
	// IFACE_DTOR is emitted during refdec of a managed iv; pin
	// the GEP-i64-0 + load-i8* sequence.
	if !contains(out, ".sp = getelementptr inbounds i8*, i8** %") {
		return fail("expected GEP into vtable for dtor slot")
	}
	if !contains(out, ".vt, i64 0\n") {
		return fail("expected GEP index 0 for dtor slot")
	}
	if !contains(out, " = load i8*, i8** %") {
		return fail("expected i8* load of dtor slot")
	}
	return ""
}
