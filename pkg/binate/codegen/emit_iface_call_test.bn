package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for emit_iface_call.bn — OP_CALL_IFACE_METHOD and
// OP_IFACE_DTOR dispatch through the iv vtable.  End-to-end
// dispatch behaviour is covered by conformance tests
// (411_pkg_std_stringer, 357_iface_dispatch, etc.); these
// unit tests pin LLVM-text shape so a regression in the
// emit_iface_call.bn split or the round-5 sret refactor shows
// up here, not as silent runtime corruption.

// A scalar-returning interface method dispatches through the
// vtable with a direct-return bitcast: `<ret>(i8*, args...)*`.
// No sret alloca, no `ptr sret(...)` parameter.
func TestEmitCallIfaceMethodScalarReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"interface I { foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(iv *I) int { return iv.foo() }\n"
		"func main() { var t T = make(T); var _ int = use(&t) }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	// Bitcast must be direct-return (i64), no `ptr sret(`.
	if !contains(out, ".fn = bitcast i8*") {
		return fail("expected vtable function-pointer bitcast")
	}
	if !contains(out, "to i64(i8*)*") {
		return fail("expected direct-return bitcast: i64(i8*)*")
	}
	if contains(out, ".rb = alloca") {
		return fail("scalar return must not emit sret alloca")
	}
	if contains(out, ".fn(ptr sret(") {
		return fail("scalar return must not dispatch via sret")
	}
	return ""
}

// An aggregate-returning interface method (32-byte managed-slice)
// MUST dispatch via sret post round-5: bitcast to
// `void(ptr, i8*, args...)*`, alloca for the retbuf, sret-call,
// and load-from-alloca for the SSA result.  Without this, the
// vtable thunk's sret signature mismatches the dispatch site —
// silent memory corruption.
func TestEmitCallIfaceMethodSretReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"interface S { str() @[]char }\n"
		"type T struct { x int }\n"
		"func (t *T) str() @[]char { return \"hi\" }\n"
		"impl *T : S\n"
		"func use(iv *S) @[]char { return iv.str() }\n"
		"func main() { var t T = make(T); var _ @[]char = use(&t) }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".fn = bitcast i8*") {
		return fail("expected vtable function-pointer bitcast")
	}
	if !contains(out, "to void(ptr, i8*)*") {
		return fail("expected sret-form bitcast: void(ptr, i8*)*")
	}
	if !contains(out, ".rb = alloca %BnManagedSlice") {
		return fail("expected sret retbuf alloca")
	}
	// The retbuf alloca is hoisted to the entry block, so it must
	// precede the sret-form call site (a regression that re-emitted
	// it inline at the call site, or dropped the hoist, would put it
	// after — this guards the substring check from being satisfied
	// by an alloca in the wrong place).
	var rbAllocaIdx int = indexAfter(out, ".rb = alloca %BnManagedSlice", 0)
	var sretCallIdx int = indexAfter(out, ".fn(ptr sret(%BnManagedSlice) align 8", 0)
	if rbAllocaIdx < 0 || sretCallIdx < 0 || rbAllocaIdx >= sretCallIdx {
		return fail("sret retbuf alloca must be hoisted before the sret-form call site")
	}
	if !contains(out, ".fn(ptr sret(%BnManagedSlice) align 8") {
		return fail("expected sret-form call")
	}
	if !contains(out, " = load %BnManagedSlice, ptr %") {
		return fail("expected load from sret retbuf")
	}
	return ""
}

// A >16-byte struct passed by value to an interface method must be
// spilled to a hoisted `.bv` slot and passed as a plain `ptr`: the
// vtable thunk declares that param as `ptr` (writeParamTypeLLVM), so
// passing the aggregate by value would shift every following arg
// (598_iface_dispatch_multiword_arg reads `tag` as 0) or wild-deref a
// value-as-pointer (the >16-byte indirect-call SIGSEGV).  Three int64s
// = 24 bytes on every target, so the byval threshold fires regardless
// of pointer width.
func TestEmitCallIfaceMethodByvalAggregateArg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"type Big struct {\n"
		"\ta int64\n"
		"\tb int64\n"
		"\tc int64\n"
		"}\n"
		"interface Sink { take(x Big, tag int) int }\n"
		"type T struct { y int }\n"
		"func (t *T) take(x Big, tag int) int { return tag }\n"
		"impl *T : Sink\n"
		"func use(iv *Sink) int { var b Big; return iv.take(b, 7) }\n"
		"func main() { var t T = make(T); var _ int = use(&t) }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	// The vtable bitcast signature passes the >16-byte struct as `ptr`
	// (after the i8* data ptr), not by value.  Without the fix this
	// would be the struct type, e.g. `(i8*, %Big, ...`.
	if !contains(out, "(i8*, ptr,") {
		return fail("expected >16-byte struct arg lowered to ptr in vtable signature")
	}
	// The spill slot for the byval arg (Args[1], the struct) is alloca'd
	// in the entry block (hoisted, not re-emitted per call).
	if !contains(out, ".bv1 = alloca") {
		return fail("expected hoisted byval spill-slot alloca (.bv1)")
	}
	// The dispatch passes the spill slot as a plain ptr.
	if !contains(out, ", ptr %") {
		return fail("expected the call to pass the byval spill slot as ptr")
	}
	return ""
}

// OP_IFACE_DTOR loads slot 0 of the iv's vtable as an i8*.
// Same shape regardless of the interface's method count or
// return-type characteristics.
func TestEmitIfaceDtorLoadsSlotZero() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { s @[]char }\n"
		"func (t *T) foo() { }\n"
		"impl @T : I\n"
		"func main() { var t @T = make(T); var iv @I = t }\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	// IFACE_DTOR is emitted during refdec of a managed iv; pin
	// the GEP-i64-0 + load-i8* sequence.
	if !contains(out, ".sp = getelementptr inbounds i8*, i8** %") {
		return fail("expected GEP into vtable for dtor slot")
	}
	if !contains(out, ".vt, i64 0\n") {
		return fail("expected GEP index 0 for dtor slot")
	}
	if !contains(out, " = load i8*, i8** %") {
		return fail("expected i8* load of dtor slot")
	}
	return ""
}
