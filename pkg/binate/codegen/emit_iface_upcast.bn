package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// OP_IFACE_UPCAST lowering: rebuild an interface value with the
// source's data pointer and a vtable pointer adjusted to point at
// the target ancestor's nested sub-vtable within the source's
// concat-laid-out vtable.
//
// The slot offset is statically known per (srcIface, targetIface)
// pair: target's full vtable starts at
// `IfaceParentSlotOffset(srcIface, targetIface) * sizeof(i8*)`
// bytes into srcIface's vtable.  After the offset, the layout
// begins with target's any-block (matching `*Target`'s expected
// vtable shape), then target's parents, then target's own methods.
//
// LLVM shape:
//
//   %dt    = extractvalue %BnIfaceValue %src, 0   ; data ptr
//   %vt8   = extractvalue %BnIfaceValue %src, 1   ; vtable ptr (i8*)
//   %vt    = bitcast i8* %vt8 to i8**
//   %new   = getelementptr inbounds i8*, i8** %vt, i64 <offset>
//   %nvt8  = bitcast i8** %new to i8*
//   %iv.0  = insertvalue %BnIfaceValue undef, i8* %dt, 0
//   %iv    = insertvalue %BnIfaceValue %iv.0, i8* %nvt8, 1
func emitIfaceUpcast(out *strings.Builder, instr @ir.Instr) {
	var src @ir.Instr = instr.Args[0]
	// Slot offset is precomputed at IR-gen time (EmitIfaceUpcast) and
	// carried on the instr, so the backend needs no interface registry.
	var offset int = instr.IfaceUpcastSlotOffset
	if offset < 0 {
		// IfaceParentSlotOffset returns -1 only when target is not an
		// ancestor of source (same-interface is now resolved to 0).
		// That is an invalid upcast the checker should never produce;
		// writing -1 as the vtable GEP index would walk the pointer one
		// slot BEFORE its base (silent vtable corruption / SIGSEGV).
		// Abort loudly instead of emitting `getelementptr ... i64 -1`.
		panic("emitIfaceUpcast: negative vtable slot offset (target not an ancestor of source)")
	}
	// Extract data from source iv.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt = extractvalue %BnIfaceValue ")
	emitRef(out, src.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueDataIndex())
	out.Write("\n  ")
	// Extract vtable from source iv and adjust by offset.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 = extractvalue %BnIfaceValue ")
	emitRef(out, src.ID)
	out.Write(", ")
	stringutils.WriteInt(out, types.IfaceValueVtableIndex())
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt = bitcast i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt8 to i8**\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".new = getelementptr inbounds i8*, i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".vt, i64 ")
	stringutils.WriteInt(out, offset)
	out.Write("\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".nvt8 = bitcast i8** %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".new to i8*\n  ")
	// Build new iv.
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".0 = insertvalue %BnIfaceValue undef, i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".dt, ")
	stringutils.WriteInt(out, types.IfaceValueDataIndex())
	out.Write("\n  ")
	emitRef(out, instr.ID)
	out.Write(" = insertvalue %BnIfaceValue %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".0, i8* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".nvt8, ")
	stringutils.WriteInt(out, types.IfaceValueVtableIndex())
	out.Write("\n")
	return
}
