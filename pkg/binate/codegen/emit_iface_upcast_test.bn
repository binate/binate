package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_iface_upcast.bn — OP_IFACE_UPCAST lowering for
// explicit interface-to-parent-interface conversions. The codegen
// extracts the source iv's data pointer and vtable, GEPs into the
// vtable by the parent's slot offset (per the concat layout — see
// plan-interface-embedding.md Slice E.4 part 2b), and rebuilds an
// iv with the same data and the adjusted vtable pointer. Helpers
// (compileToLLVM, contains, fail) live in emit_test.bn.

// The full LLVM shape — extract data, extract+adjust vtable, rebuild
// iv — must appear when an iv is assigned to a parent iface type.
// Without each piece, the parent-typed view would either point at
// the wrong sub-vtable or get a malformed value.
func TestEmitIfaceUpcastShape() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n"
		"func main() {\n"
		"\tvar f F\n"
		"\tvar rc *RC = &f\n"
		"\tvar c *Closer = rc\n"
		"\tc.Close()\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, ".dt = extractvalue %BnIfaceValue ") {
		return fail("expected extractvalue of data pointer (slot 0)")
	}
	if !contains(out, ".vt8 = extractvalue %BnIfaceValue ") {
		return fail("expected extractvalue of vtable pointer (slot 1)")
	}
	if !contains(out, ".vt = bitcast i8* ") {
		return fail("expected bitcast of vtable from i8* to i8**")
	}
	if !contains(out,
			".new = getelementptr inbounds i8*, i8** ") {
		return fail("expected GEP into vtable to land on parent's sub-vtable")
	}
	if !contains(out, ".nvt8 = bitcast i8** ") {
		return fail("expected bitcast of adjusted vtable back to i8*")
	}
	if !contains(out, ".0 = insertvalue %BnIfaceValue undef, i8* ") {
		return fail("expected insertvalue to put data pointer in new iv")
	}
	if !contains(out, " = insertvalue %BnIfaceValue ") {
		return fail("expected insertvalue to put adjusted vtable in new iv")
	}
	return ""
}

// `RC : Closer` lays out (F, RC) as [RC.dtor, Closer.dtor (parent
// any-block), Closer.Close, RC.Read] — so Closer's full vtable
// starts at slot 1, after RC's any-block. The upcast GEP must
// reflect that offset literally. If the offset were wrong (e.g. 0),
// the resulting *Closer would dispatch through RC's own slots and
// crash; if it were too large, it would walk past the end of the
// vtable.
func TestEmitIfaceUpcastOffsetParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n"
		"func main() {\n"
		"\tvar f F\n"
		"\tvar rc *RC = &f\n"
		"\tvar c *Closer = rc\n"
		"\tc.Close()\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, ", i8** %v") {
		return fail("expected GEP to receive vtable ptr")
	}
	// The GEP-by-offset line for the parent upcast must be exactly
	// `i64 1` — RC's any-block at slot 0, Closer's full vtable
	// starting at slot 1.
	if !contains(out, ".vt, i64 1\n") {
		return fail("expected upcast GEP offset of 1 slot (Closer starts after RC any-block)")
	}
	return ""
}

// Upcasting an @-iface (managed iface value) through the parent
// must go through the same OP_IFACE_UPCAST path — the IR doesn't
// distinguish raw vs managed at the upcast layer; both reuse the
// %BnIfaceValue shape. This confirms the lowering doesn't choke
// on the managed result type.
func TestEmitIfaceUpcastManaged() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n"
		"func main() {\n"
		"\tvar rc @RC = make(F)\n"
		"\tvar c @Closer = rc\n"
		"\tc.Close()\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, ".vt, i64 1\n") {
		return fail("expected managed upcast GEP offset of 1 slot")
	}
	if !contains(out, " = insertvalue %BnIfaceValue ") {
		return fail("expected new managed iv to be built via insertvalue")
	}
	return ""
}

// Multi-level upcast: GrandChild → Parent across two levels of
// extension.  IfaceParentSlotOffset(GrandChild, Parent) should
// return 2 (slot 0 = GrandChild's any-block, slot 1 = Child's
// any-block, slot 2 = Parent's any-block inlined inside Child's
// sub-vtable).  Pins the recursive offset walk through codegen.
func TestEmitIfaceUpcastMultiLevel() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface P { P() }\n"
		"interface C : P { C() }\n"
		"interface G : C { G() }\n"
		"type T struct { x int }\n"
		"func (t *T) P() { }\n"
		"func (t *T) C() { }\n"
		"func (t *T) G() { }\n"
		"impl *T : G\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar g *G = &t\n"
		"\tvar p *P = g\n"
		"\t_ = p\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "extractvalue %BnIfaceValue") {
		return fail("expected extractvalue for multi-level upcast")
	}
	// G → P offset is 2 (G@0, C@1, P@2 inside C's sub-vtable).
	if !contains(out, ", i64 2\n") {
		return fail("expected vtable GEP offset of 2 for G→P upcast")
	}
	return ""
}

// Identical-type assignment (RC → RC) must NOT emit an upcast —
// the gen_util.bn check uses Identical, and ifaceValueTypesAgree
// returns true for the identical case before the upcast emit
// fires.  Pins that no spurious OP_IFACE_UPCAST sneaks in for
// the no-op case.
func TestEmitIfaceUpcastIdenticalIsNoOp() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\tvar iv2 *I = iv\n"
		"\t_ = iv2\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// The extractvalue/insertvalue pattern signature is unique to
	// emitIfaceUpcast (the OP_IFACE_VALUE construction path uses
	// %BnIfaceValue undef but doesn't extractvalue from another iv).
	// `getelementptr inbounds i8*, i8**` against a vtable is also
	// unique to the upcast.  Their absence here pins that
	// ifaceValueTypesAgree short-circuits identical-type assigns.
	if contains(out, "getelementptr inbounds i8*, i8**") {
		return fail("identical-type iface assign should not emit upcast GEP")
	}
	return ""
}
