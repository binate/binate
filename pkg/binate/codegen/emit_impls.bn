package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Interface vtable emission
// ============================================================

// currentModuleImpls holds the active module's Impls list during
// EmitModule. Set when emitImplVtables runs (effectively at the
// start of EmitModule); read by OP_IFACE_VALUE lowering in
// emit_instr.bn to spell the vtable bitcast's source array size.
// Cleared between modules to keep test runs isolated.
var currentModuleImpls @[]@ir.ImplInfo

// currentModuleImportedImpls is the parallel cache for imports
// (Slice 2.8). vtableSlotCount walks both so cross-package
// OP_IFACE_VALUE sites get the correct array size for the bitcast.
var currentModuleImportedImpls @[]@ir.ImplInfo

// emitImplVtables walks m.Impls and emits one `@__ivt.<mangled>`
// global per (impl, interface) pair. The global is a `[N x i8*]`
// constant where N is the interface's method count; each slot is
// the address of the impl method that satisfies the corresponding
// interface method, bitcast through the impl method's actual LLVM
// type to i8*. Dispatch sites (Slice 2.3a-3) bitcast the slot back
// to a uniform shim signature when calling.
//
// Slice 2.3a-1 of plan-interface-syntax-revision.md.
func emitImplVtables(out *strings.Builder, m @ir.Module) {
	currentModuleImpls = m.Impls
	currentModuleImportedImpls = m.ImportedImpls
	if len(m.Impls) == 0 && len(m.ImportedImpls) == 0 {
		return
	}
	for i := 0; i < len(m.Impls); i++ {
		emitImplVtable(out, m, m.Impls[i])
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.  Gated to
		// non-generic impls — the same set the descriptor's Vtables table lists
		// (generic instantiations re-lower at the bytecode importer).
		if !recvTypeIsGenericInst(m.Impls[i].RecvTypeName) {
			emitImplShimVtable(out, m, m.Impls[i])
		}
	}
	// Slice 2.8: declare imported vtables as external so this TU's
	// references resolve at link time. The vtable's actual definition
	// is in the imported package's TU, with weak_odr linkage.
	// Slice 2.9: skip imported entries that duplicate a local entry
	// — the local definition (also weak_odr) already provides the
	// symbol, and emitting an `external constant` declaration on top
	// of a local definition is a redefinition error.
	for i := 0; i < len(m.ImportedImpls); i++ {
		if importedImplCoveredLocally(m.Impls, m.ImportedImpls[i]) {
			continue
		}
		emitImportedImplVtableDecl(out, m, m.ImportedImpls[i])
	}
	emitTypeInfos(out, m)
	emitIfaceIds(out, m)
	emitSatEntries(out, m)
	out.WriteByte('\n')
	return
}

// emitSatEntries emits one weak `__satentry.<T,J>` record per `(T, J)` in the
// module's m.Impls — the distributed interface-satisfaction registry (spec
// §11.12 `iface.rtti`).  Each records `{&TypeInfo(T), &IfaceId(J),
// &__ivt.<T>__<J>}`; the Phase-5 assertion scans by `(dynamic-type, IfaceId)`.
// Weak linkage coalesces the same `(T, J)` emitted from several TUs.  The
// symbols are raw LLVM names (no object-format prefix).
func emitSatEntries(out *strings.Builder, m @ir.Module) {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(m)
	for i := 0; i < len(descs); i++ {
		emitDataGlobal(out, irdata.BuildSatEntry(STATIC_MANAGED_REFCOUNT, descs[i]))
	}
	return
}

// emitIfaceIds emits one weak `__ifaceid.<J>` 1-byte marker per canonical
// interface in the module (ir.CollectIfaceIdSyms).  Only the marker's address
// is meaningful — a Phase-5 assertion `x.(*J)` and the satisfaction entries
// reference the same symbol (spec §11.12 `iface.rtti`).  Weak linkage coalesces
// the same interface emitted from several TUs.  The symbols are the raw LLVM
// names (no object-format prefix).
func emitIfaceIds(out *strings.Builder, m @ir.Module) {
	var syms @[]@[]char = ir.CollectIfaceIdSyms(m)
	for i := 0; i < len(syms); i++ {
		emitDataGlobal(out, irdata.BuildIfaceId(syms[i]))
	}
	return
}

// emitTypeInfos emits one weak `__typeinfo.<T>` RTTI record per distinct
// boxable receiver type (ir.CollectTypeInfoDescs).  The vtable any-block
// slot 1 points at these (spec §7.13.8 / §7.13.14); the record's address is
// the type's identity a concrete assertion compares, and the size/align
// words carry its layout.  Weak linkage coalesces the same type emitted from
// several TUs.
func emitTypeInfos(out *strings.Builder, m @ir.Module) {
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(m)
	for i := 0; i < len(descs); i++ {
		// Word 0's destructor handle uses the very helper the vtable any-block
		// slot 0 uses (implDtorSlotSym: gated on the dtor being in this module),
		// so the record's dtor word is byte-identical to that slot.  Sym / NameSym
		// are the raw LLVM symbols (no object-format prefix), as set by
		// CollectTypeInfoDescs.  BuildTypeInfo returns [record, name-blob].
		descs[i].DtorSym = implDtorSlotSym(m, descs[i].DtorFuncName)
		var dgs @[]@irdata.DataGlobal = irdata.BuildTypeInfo(descs[i])
		for j := 0; j < len(dgs); j++ {
			emitDataGlobal(out, dgs[j])
		}
	}
	return
}

// importedImplCoveredLocally reports whether a local impl entry
// covers the same canonical (R, I) pair as `imp`. When true, the
// imported entry's external declaration would conflict with the
// local definition (both are weak_odr; LLVM treats two definitions
// of the same symbol — even weak_odr + extern — as a redefinition
// error). Slice 2.9.
func importedImplCoveredLocally(local @[]@ir.ImplInfo, imp @ir.ImplInfo) bool {
	if imp == nil { return false }
	for i := 0; i < len(local); i++ {
		var info @ir.ImplInfo = local[i]
		if info == nil { continue }
		if !charsEqual(info.RecvPkg, imp.RecvPkg) { continue }
		if !charsEqual(info.RecvTypeName, imp.RecvTypeName) {
			continue
		}
		if !charsEqual(info.IfacePkg, imp.IfacePkg) { continue }
		if !charsEqual(info.IfaceName, imp.IfaceName) { continue }
		return true
	}
	return false
}

// emitImportedImplVtableDecl emits an `external constant [N x i8*]`
// declaration for a vtable defined in an imported package's TU. The
// array size must match what the imported TU emitted: N+2 (the
// two-word any-block — dtor + *TypeInfo — plus N method slots), where
// N is the canonical interface's method count discoverable via
// vtableSlotCountForInfo. Slice 2.8.
func emitImportedImplVtableDecl(out *strings.Builder, m @ir.Module, info @ir.ImplInfo) {
	var nSlots int = vtableSlotCountForInfo(m, info)
	if nSlots == 0 { return }
	var vtName @[]char = implVtableName(info)
	out.Write("@")
	out.Write(vtName)
	out.Write(" = external constant [")
	stringutils.WriteInt(out, nSlots)
	out.Write(" x i8*]\n")
	return
}

// vtableSlotCount returns the total number of slots in the vtable
// global named `name`, computed under the concat layout (Slice E.3):
// dtor any-block + recursive parent vtables + own methods.  Returns
// 0 if no impl matches.  Slice 2.8 also walks the imported-impl
// list so cross-package OP_IFACE_VALUE sites can spell the bitcast
// source type with the right array size.
func vtableSlotCount(m @ir.Module, name *[]readonly char) int {
	for i := 0; i < len(currentModuleImpls); i++ {
		var info @ir.ImplInfo = currentModuleImpls[i]
		if info == nil { continue }
		var built @[]char = implVtableName(info)
		if charsEqual(built, name) {
			return vtableSlotCountForInfo(m, info)
		}
	}
	for i := 0; i < len(currentModuleImportedImpls); i++ {
		var info @ir.ImplInfo = currentModuleImportedImpls[i]
		if info == nil { continue }
		var built @[]char = implVtableName(info)
		if charsEqual(built, name) {
			return vtableSlotCountForInfo(m, info)
		}
	}
	return 0
}

// vtableSlotCountForInfo returns the full vtable slot count for an
// `(R, I)` pair under the concat layout from
// plan-interface-embedding.md:
//   size(I) = 2 (any-block: dtor + *TypeInfo)
//                                 + sum(size(P) for P in I.Parents)
//                                 + len(I's own methods)
// For interfaces with no parents this reduces to N+2.  Used by both
// vtable emission (here) and
// imported-impl declarations (Slice 2.8) so both sides agree on
// the array size regardless of which TU defines the vtable.
func vtableSlotCountForInfo(m @ir.Module, info @ir.ImplInfo) int {
	return ir.IfaceFullVtableSize(m, info.IfacePkg, info.IfaceName)
}

// emitImplVtable emits the raw `@__ivt.<R>__<I>` vtable for the `(R, I)` pair
// on `info`, with the concat layout from plan-interface-embedding.md:
//   [any-block: R's dtor, then R's *TypeInfo]
//   for each parent P (declaration order): full vtable of (R, P) (recursive)
//   R's methods for I's own methods
// For non-extending interfaces this reduces to slots 0-1 = any-block
// (dtor, *TypeInfo) + slots 2..N+1 = own methods.  The recursive
// structure is materialized INLINE (the parent's
// slot values re-appear at the right offsets, not a GEP reference) — that is
// what makes `*Child → *Parent` upcast a fixed pointer offset (Slice E.4); the
// parent's own symbol is still emitted separately for direct `*Parent` use.
// The slot byte layout is laid by the shared irdata.BuildImplVtable; this gathers
// the ordered raw method-fn slot symbols (useHandles=false).
func emitImplVtable(out *strings.Builder, m @ir.Module, info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlots(m, info, info.IfacePkg, info.IfaceName, false)
	emitDataGlobal(out, irdata.BuildImplVtable(implVtableName(info), slots))
	return
}

// emitImplShimVtable emits the parallel `@__ivtshim.<mangled>` vtable for an
// `(R, I)` impl: the same slot layout as @__ivt, but every method slot holds the
// method's function-value HANDLE (@__handle.<m>) instead of the raw fn.  The
// bytecode VM resolves this from the raw @__ivt address (descriptor's
// VtableInfo.ShimAddr -> registerVtableAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim, so it never
// replicates the native arg/return ABI.  Native-to-native dispatch keeps using
// the raw @__ivt directly; this is consumed only by the cross-mode VM path.
func emitImplShimVtable(out *strings.Builder, m @ir.Module, info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlots(m, info, info.IfacePkg, info.IfaceName, true)
	emitDataGlobal(out, irdata.BuildImplVtable(implShimVtableName(info), slots))
	return
}

// implShimVtableName builds the LLVM symbol for an impl's parallel shim vtable:
// `__ivtshim.bn_W...` (the @__ivt name with the `__ivt` prefix replaced by
// `__ivtshim`).
func implShimVtableName(info @ir.ImplInfo) @[]char {
	return mangle.ImplVtableShimName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName)
}

// collectImplVtableSlots returns the ordered slot symbols for a single
// `(R, X)` block (X identified by ifacePkg / ifaceName): the receiver's dtor
// HANDLE (slot 0 of the level), then — for each parent P of X — that parent's
// full sub-vtable slots (recursive, materialized INLINE so a `*X → *P` upcast
// is a fixed offset), then X's own method slots in declaration order.  The
// recursion bottoms out at parentless interfaces (`[dtor, m1, m2, ...]`).  An
// empty slot symbol denotes a null pointer.  irdata.BuildImplVtable lays the bytes.
func collectImplVtableSlots(m @ir.Module, info @ir.ImplInfo, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, useHandles bool) @[]@[]char {
	var slots @[]@[]char
	slots = appendSlotSym(slots, implDtorSlotSym(m, info.DtorFuncName))
	// Two-word any-block: slot 1 is the concrete type's *TypeInfo (RTTI,
	// spec §7.13.8/§7.13.14) — the `__typeinfo.<T>` record emitted weak by
	// emitTypeInfos.  Keyed on the receiver type so every nested sub-vtable
	// carries the SAME leaf-type record.  Its payload is a zero/null
	// placeholder for now; its address is the type's identity.
	slots = appendSlotSym(slots, mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(m, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(m, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		var ps @[]@[]char = collectImplVtableSlots(m, info, parentPkgs[i], parentNames[i], useHandles)
		for j := 0; j < len(ps); j++ {
			slots = appendSlotSym(slots, ps[j])
		}
	}
	// Own methods of this level, in declaration order.
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(m, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncName(info.RecvPkg, info.RecvTypeName, ownMethods[i])
		// plan-primitives-impl-interfaces.md § "Interface-value dispatch and
		// value receivers": a value-receiver method's slot points at a
		// generated *readonly T-receiver thunk (the dispatch path passes the iv
		// data pointer, which the thunk derefs before tail-calling the
		// underlying method); pointer-receiver methods need no thunk, so
		// LookupVtableSlotName returns the original name.
		var slotName @[]char = ir.LookupVtableSlotName(m, qualified)
		slots = appendSlotSym(slots, implMethodSlotSym(m, slotName, useHandles))
	}
	return slots
}

// appendSlotSym appends one vtable slot symbol (empty = a null slot).
func appendSlotSym(dst @[]@[]char, s @[]char) @[]@[]char {
	return slices.Append[@[]char](dst, s)
}

// buildMethodFuncName builds `<recvPkg>.<recvName>.<methodName>`
// — the IR-level qualified name a method registered on the
// receiver type would have under methodFuncName / methodQualName.
// Duplicated in codegen for the parent-slot emission path so we
// don't reach across into pkg/binate/ir for what's purely a name format.
func buildMethodFuncName(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(recvPkg)
	b.WriteByte('.')
	b.Write(recvName)
	b.WriteByte('.')
	b.Write(methodName)
	return buf.CopyStr(b.String())
}

// implDtorSlotSym returns the slot-0 symbol of the @__ivt.<R>__<I> vtable: the
// receiver type's dtor HANDLE (`@__handle.<dtor>`), or empty (a null slot) when
// no dtor was emitted (the type has no managed fields, so plain rt.Free
// suffices at refcount-zero).
//
// Slot 0 holds a HANDLE pointer, not the raw dtor fn pointer.  An @Iface
// value's scope-end cleanup extracts this slot via `EmitIfaceDtor` and passes
// it as `dtor` to `rt.ZeroRefDestroy`, which calls `_call_dtor(dtor, ptr)` —
// lowered as `OP_CALL_HANDLE` (`handle.vtable.call(handle.data, ptr)`).  A raw
// fn pointer would byte-pun-read the dtor's machine code as a {vtable, data}
// struct.  The per-dtor (shim, vt, handle) triple the slot references is
// emitted by emitFuncValueVtables via addImplDtorsToSeen.
func implDtorSlotSym(m @ir.Module, dtorName @[]char) @[]char {
	var none @[]char
	if len(dtorName) == 0 { return none }
	if lookupModuleFunc(m, dtorName) == nil { return none }
	return catSym("__handle.", mangle.FuncName(modulePkgName, dtorName))
}

// implVtableName builds the LLVM symbol name for an impl vtable in
// the canonical form
// `__ivt.bn_V...` (the
// (R, I)-canonical mangling adopted by Slice 2.6 of plan-cross-
// package-interfaces.md). The fields come from ImplInfo, populated
// at IR-gen collection time; the iface name is alias-resolved there.
// weak_odr linkage matches function-value vtables — duplicate
// emissions across translation units dedupe at link time, which is
// what makes the "any TU may declare the impl" rule sound.
func implVtableName(info @ir.ImplInfo) @[]char {
	return mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName)
}

// implMethodSlotSym returns a single method slot's symbol.  For the raw `@__ivt`
// vtable (useHandles=false) it is the raw method fn symbol (`@<func>`), which
// native-to-native dispatch calls directly.  For the parallel `@__ivtshim`
// vtable (useHandles=true) it is the method's function-value HANDLE
// (`@__handle.<func>`, the same form the dtor slot uses) — the bytecode VM
// dispatches through it (handle.vtable.call is the marshaling shim) so it never
// replicates the native arg ABI.  Looks up the impl method in m.Funcs; returns
// empty (a null slot) if not found (defensive — the satisfaction check should
// have validated method presence).
func implMethodSlotSym(m @ir.Module, funcName @[]char, useHandles bool) @[]char {
	var none @[]char
	if lookupModuleFunc(m, funcName) == nil { return none }
	var mangled @[]char = mangle.FuncName(modulePkgName, funcName)
	if useHandles {
		return catSym("__handle.", mangled)
	}
	return mangled
}

// lookupModuleFunc returns the ir.Func with the given canonical
// name, or nil if absent.
func lookupModuleFunc(m @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, name) {
			return m.Funcs[i]
		}
	}
	return nil
}
