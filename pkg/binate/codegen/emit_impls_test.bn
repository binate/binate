package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_impls.bn — emits an `(N+2)`-pointer vtable global per
// (impl, interface) pair, an irdata.DataGlobal lowered to an anonymous
// `{ ptr, ptr, ... }` constant (was the named `[N x i8*]` array; opaque
// pointers make the typed-pointer references elsewhere auto-upgrade). Symbol
// form is the canonical `@__ivt.bn_V...`. For same-package impls
// (today's only case), recv_pkg and iface_pkg both equal the impl
// declaration's package. Slot 0 is the receiver type's dtor HANDLE (or a null
// pointer if the type has no managed fields), slot 1 is the *TypeInfo (a null
// placeholder until RTTI is populated), and slots 2..N+1 are the impl methods.

// A single-method impl whose receiver has no managed fields
// produces a 3-slot vtable: { null dtor, *TypeInfo, <method> } — the
// two-word any-block (null dtor + the type's __typeinfo record) then
// the method.
func TestEmitImplVtableSingleMethod() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail("expected vtable global @__ivt.bn_V1_4_main1_T1_4_main1_I")
	}
	if !contains(out,
			"weak_odr constant { ptr, ptr, ptr } { ptr null, ptr @__typeinfo.bn_S1_4_main1_1_T,") {
		return fail(
				"expected 3-slot vtable (null dtor, *TypeInfo, method)")
	}
	if !contains(out, "@bn_F1_4_main2_1_T3_foo") {
		return fail("expected method slot to bitcast bn_F1_4_main2_1_T3_foo")
	}
	return ""
}

// A `__typeinfo.<T>` RTTI record is emitted per boxable type — a weak
// 8-word record (dtor, size, align, name-ptr, name-len, KIND, fields-ptr,
// field-count) whose ADDRESS is the type's identity (spec §7.13.14).  Size/align
// are `struct { x int }` = 8/8 at LP64; word 0 is the destructor handle — NULL
// here because `struct { x int }` has no managed field (TestEmitTypeInfoRecordDtor
// covers the non-null case); words 3–4 are the name pointer + byte length, into a
// private `main.T` blob; word 5 is KIND_STRUCT (6); words 6–7 are the field-table
// pointer + count (T is a one-field struct).  Satisfaction is NOT in the record (a
// distributed registry — spec type.layout.satisfaction).  The vtable any-block
// slot 1 points at the record.  (`i64` fields are the 64-bit host target's int
// width.)
func TestEmitTypeInfoRecordEmitted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out,
			"@__typeinfo.bn_S1_4_main1_1_T = weak_odr constant "
					"{ ptr, i64, i64, ptr, i64, i64, ptr, i64 } "
					"{ ptr null, i64 8, i64 8, ptr @__typeinfo_name.bn_S1_4_main1_1_T, "
					"i64 6, i64 6, ptr @__typefields.bn_S1_4_main1_1_T, i64 1 }") {
		return fail(
				"expected weak 8-word __typeinfo record for T (8/8, name main.T, "
						"KIND_STRUCT, 1 field)")
	}
	// The field table: one 8-word FieldEntry {name-ptr, name-len, offset, kind,
	// size, typeinfo-ptr, elem-kind, elem-size} for `x int` — name into the names
	// blob, KIND_INT (1), offset 0, size 8, null typeinfo-ptr (a scalar field has
	// no record), elem-kind/elem-size 0 (not an array/slice).
	if !contains(out,
			"@__typefields.bn_S1_4_main1_1_T = private constant "
					"{ ptr, i64, i64, i64, i64, ptr, i64, i64 } "
					"{ ptr @__typefieldnames.bn_S1_4_main1_1_T, i64 1, i64 0, i64 1, "
					"i64 8, ptr null, i64 0, i64 0 }") {
		return fail("expected the __typefields blob for T (field x: INT, off 0, size 8)")
	}
	if !contains(out, "@__typefieldnames.bn_S1_4_main1_1_T = private constant [1 x i8] c\"x\"") {
		return fail("expected the __typefieldnames blob holding the field name \"x\"")
	}
	// The name blob holds the type's canonical qualified name.
	if !contains(out,
			"@__typeinfo_name.bn_S1_4_main1_1_T = private constant "
					"[6 x i8] c\"main.T\"") {
		return fail("expected the __typeinfo name blob c\"main.T\"")
	}
	if !contains(out, "ptr @__typeinfo.bn_S1_4_main1_1_T") {
		return fail("expected vtable slot 1 to reference the __typeinfo record")
	}
	return ""
}

// For a type that needs destruction (a managed field), the `__typeinfo` record's
// word 0 carries the destructor HANDLE — the same `@__handle.<dtor>` the vtable
// any-block slot 0 holds (increment 2.2b-1) — not a null pointer.  `S` has a
// managed `@Inner` field, so it gets a dtor.
func TestEmitTypeInfoRecordDtor() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type Inner struct { x int }\n"
					"type S struct { p @Inner }\n"
					"func (s *S) foo() { }\n"
					"impl *S : I\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Record word 0 is a handle ref, not null (the exact mangled handle is the
	// same one the vtable slot 0 uses — asserted equal by construction via the
	// shared implDtorSlotSym helper; here we check the record's word 0 is filled).
	if !contains(out,
			"@__typeinfo.bn_S1_4_main1_1_S = weak_odr constant "
					"{ ptr, i64, i64, ptr, i64, i64, ptr, i64 } "
					"{ ptr @__handle.") {
		return fail("expected S's __typeinfo record word 0 to be the dtor handle")
	}
	return ""
}

// One weak 1-byte `__ifaceid.<J>` marker is emitted per canonical interface —
// the declared `I` and the universe `any` (spec §11.12 `iface.rtti`).  Only the
// marker's address is meaningful; a Phase-5 assertion `x.(*J)` and the
// satisfaction entries reference the same symbol.
func TestEmitIfaceIdMarker() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ifaceid.bn_S1_4_main1_1_I = weak_odr constant [1 x i8]") {
		return fail("expected a weak 1-byte __ifaceid marker for interface I")
	}
	// The universe `any` also gets a marker.
	if !contains(out, "@__ifaceid.bn_S0_1_3_any = weak_odr constant [1 x i8]") {
		return fail("expected an __ifaceid marker for the universe any")
	}
	return ""
}

// One weak `__satentry.<T,J>` record is emitted per (T, J) in m.Impls — the
// distributed satisfaction registry (spec §11.12 `iface.rtti`).  `impl *T : B`
// (B : A) yields entries for BOTH (T,B) AND its transitive ancestor (T,A), each
// recording {&TypeInfo(T), &IfaceId(J), &__ivt.<T>__<J>} (the sub-vtable at
// offset 0).
func TestEmitSatEntry() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface A { a() }\n"
					"interface B : A { b() }\n"
					"type T struct { x int }\n"
					"func (t *T) a() { }\n"
					"func (t *T) b() { }\n"
					"impl *T : B\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// The (T,B) entry is a managed reflect.SatEntryInfo NODE: 2-word header, then
	// {TypeInfo(T), IfaceId(B), __ivt.<T>__<B>}, then the cross-mode {TypeSym,
	// IfaceSym} {data,len} slices naming the NEUTRAL RTTI symbols (lengths 28/27).
	if !contains(out,
			"@__satentry.bn_V1_4_main1_T1_4_main1_B = weak_odr constant "
					"{ i64, i64, ptr, ptr, ptr, ptr, i64, ptr, i64 } { i64 -1073741824, i64 0, "
					"ptr @__typeinfo.bn_S1_4_main1_1_T, "
					"ptr @__ifaceid.bn_S1_4_main1_1_B, "
					"ptr @__ivt.bn_V1_4_main1_T1_4_main1_B, "
					"ptr @__satentry_typesym.bn_V1_4_main1_T1_4_main1_B, i64 28, "
					"ptr @__satentry_ifacesym.bn_V1_4_main1_T1_4_main1_B, i64 27 }") {
		return fail("expected the (T,B) satisfaction-entry node")
	}
	// The transitive-ancestor (T,A) entry is also emitted.
	if !contains(out,
			"@__satentry.bn_V1_4_main1_T1_4_main1_A = weak_odr constant "
					"{ i64, i64, ptr, ptr, ptr, ptr, i64, ptr, i64 } { i64 -1073741824, i64 0, "
					"ptr @__typeinfo.bn_S1_4_main1_1_T, "
					"ptr @__ifaceid.bn_S1_4_main1_1_A, "
					"ptr @__ivt.bn_V1_4_main1_T1_4_main1_A, "
					"ptr @__satentry_typesym.bn_V1_4_main1_T1_4_main1_A, i64 28, "
					"ptr @__satentry_ifacesym.bn_V1_4_main1_T1_4_main1_A, i64 27 }") {
		return fail("expected the transitive-ancestor (T,A) satisfaction-entry node")
	}
	// The symbol-name blobs are TU-local (LLVM private) and hold the NEUTRAL
	// __typeinfo.<T> / __ifaceid.<J> names — the strings the VM keys dataSym on.
	if !contains(out,
			"@__satentry_typesym.bn_V1_4_main1_T1_4_main1_B = private constant "
					"[28 x i8] c\"__typeinfo.bn_S1_4_main1_1_T\"") {
		return fail("expected the (T,B) type-sym blob holding __typeinfo.<T>")
	}
	if !contains(out,
			"@__satentry_ifacesym.bn_V1_4_main1_T1_4_main1_B = private constant "
					"[27 x i8] c\"__ifaceid.bn_S1_4_main1_1_B\"") {
		return fail("expected the (T,B) iface-sym blob holding __ifaceid.<B>")
	}
	// The package descriptor's SatEntries table RETAINS both nodes (points past
	// each header, +16) — so they survive dead-strip.
	if !contains(out,
			"__pkg_satentries = weak_odr constant { ptr, ptr } "
					"{ ptr getelementptr inbounds (i8, "
					"ptr @__satentry.bn_V1_4_main1_T1_4_main1_B, i64 16), ") {
		return fail("expected the descriptor's _pkg_satentries table to list the entries")
	}
	return ""
}

// A two-method impl produces a 4-slot vtable: slot 0 = dtor (or
// null), slot 1 = the type's *TypeInfo record, slots 2..3 = methods
// in the interface's method-declaration order.
func TestEmitImplVtableMultiMethod() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface RW { read() int; write() }\n"
					"type Pipe struct { x int }\n"
					"func (p *Pipe) read() int { return 0 }\n"
					"func (p *Pipe) write() { }\n"
					"impl *Pipe : RW\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main4_Pipe1_4_main2_RW") {
		return fail("expected vtable global")
	}
	if !contains(out,
			"weak_odr constant { ptr, ptr, ptr, ptr } { ptr null, ptr @__typeinfo.bn_S1_4_main1_4_Pipe,") {
		return fail(
				"expected 4-slot vtable (null dtor, *TypeInfo, methods)")
	}
	if !contains(out, "@bn_F1_4_main2_4_Pipe4_read") {
		return fail("expected read slot")
	}
	if !contains(out, "@bn_F1_4_main2_4_Pipe5_write") {
		return fail("expected write slot")
	}
	return ""
}

// A receiver type with managed fields gets a non-null dtor in
// slot 0 — the dtor is invoked by ZeroRefDestroy when an @Iface
// over the receiver hits refcount zero. Slice 2.5b cleanup wiring
// in emitManagedIfaceValueRefDec pairs with this slot.
//
// Slot 0 stores a HANDLE POINTER (`*BnFuncValue`), not the raw
// dtor fn pointer.  ZeroRefDestroy's `_call_dtor(dtor, ptr)` is
// lowered as OP_CALL_HANDLE, which reads `handle.vtable.call` and
// invokes `shim(null, ptr)`.  A raw fn pointer in slot 0 would
// make OP_CALL_HANDLE byte-pun-read the dtor's own machine code
// as if it were a {vtable, data} struct (LP64 / aa64 / x64 happen
// to exit cleanly after a random jump; arm32-baremetal loops).
// The pre-fix shape was masked in conformance/370 because the
// holder enters consume with refcount 2 and never decrements past
// 1, but a test that drives the iface refcount to 0 inside the
// callee would expose it.
func TestEmitImplVtableDtorSlotForManagedReceiver() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type Inner struct { v int }\n"
					"type T struct { p @Inner }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail("expected vtable global")
	}
	if !contains(out, "ptr @__handle.bn_F1_4_main1_8___dtor_T") {
		return fail(
				"expected @__ivt slot 0 = the dtor HANDLE pointer")
	}
	// Slot 1 is the type's *TypeInfo record — pinned positionally,
	// immediately after the non-null dtor handle, so a mis-emitted
	// managed-receiver any-block (a TypeInfo slot shifted over the dtor,
	// or dropped) is caught even when slot 0 is non-null.
	if !contains(out, "ptr @__handle.bn_F1_4_main1_8___dtor_T, ptr @__typeinfo.bn_S1_4_main1_1_T,") {
		return fail(
				"expected @__ivt slot 1 = the type's *TypeInfo right after the dtor handle")
	}
	if contains(out, "bitcast (void(i8*)* @bn_F1_4_main1_8___dtor_T to i8*)") {
		return fail(
				"@__ivt slot 0 must NOT bitcast raw dtor fn ptr — OP_CALL_HANDLE would crash")
	}
	// The handle the slot points at must actually be defined in
	// this TU (added to the seen list by addImplDtorsToSeen) — a
	// dangling reference would link-fail.
	if !contains(out, "@__handle.bn_F1_4_main1_8___dtor_T = weak_odr constant { ptr, ptr }") {
		return fail("expected @__handle.<dtor> definition for impl receiver")
	}
	if !contains(out, "@__shim.bn_F1_4_main1_8___dtor_T") {
		return fail(
				"expected @__shim.<dtor> for impl receiver — backs handle.vtable.call")
	}
	return ""
}

// A program with no impls emits no `__ivt.` globals.
func TestEmitImplVtableNoImpls() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if contains(out, "@__ivt.") {
		return fail("expected no impl vtable globals")
	}
	return ""
}

// Slice 2.3a-2 lowering: OP_IFACE_VALUE produces a `%BnIfaceValue`
// with field 0 = data ptr (bitcast i8*) and field 1 = vtable ptr
// (bitcast `[N x i8*]*`). This shape is what dispatch sites in
// Slice 2.3a-3 will read.
func TestEmitOpIfaceValueLowering() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar iv *I = &t\n"
					"\t_ = iv\n"
					"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "%BnIfaceValue = type { i8*, i8* }") {
		return fail("expected %BnIfaceValue type definition")
	}
	if !contains(out, "alloca %BnIfaceValue") {
		return fail("expected iv to alloca as %BnIfaceValue")
	}
	if !contains(out, "insertvalue %BnIfaceValue undef") {
		return fail(
				"expected insertvalue chain building the iface value")
	}
	if !contains(out, "[3 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail(
				"expected vtable bitcast against [3 x i8*]* form")
	}
	return ""
}

// OP_IFACE_VALUE whose data ptr is the address of a package global
// (`&g`) must bitcast the global symbol at its real pointer type,
// not reference a `%v-1` SSA id.  The global pseudo-instr has ID -1
// (lookupVar's global fallback), so the pre-fix lowering printed
// `bitcast i8* %v-1 to i8*` — an undefined value clang rejects.
// Conformance 495 pins the end-to-end run; this pins the emitted
// shape so a regression surfaces in the fast unit run.
func TestEmitOpIfaceValueFromGlobal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"var g T\n"
					"func main() {\n"
					"\tvar iv *I = &g\n"
					"\t_ = iv\n"
					"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if contains(out, "%v-1") {
		return fail(
				"global-ref data ptr must not emit the bogus %v-1 SSA id")
	}
	if !contains(out, "bitcast %bn_S1_4_main1_1_T* @bn_G1_4_main1_1_g to i8*") {
		return fail(
				"expected data ptr to bitcast the global at its real "
						"pointer type: `bitcast %bn_S1_4_main1_1_T* @bn_G1_4_main1_1_g to i8*`")
	}
	return ""
}

// DYNAMIC OP_IFACE_VALUE (empty StrVal, vtable in Args[1]) takes the vtable
// from a RUNTIME SSA value — interface-assertion recovery, RTTI Slice 2b — so
// emitIfaceValueLLVM must bitcast that Args[1] value (`%v<id>`) to i8*, and must
// NOT reference any `@__ivt` symbol or a `[N x i8*]*` vtable-array bitcast.
// This is driven directly through emitIfaceValueLLVM because no Binate source
// front-end yet produces the dynamic form (interface assertions land in Slice 5);
// m is unused by the dynamic branch (vtableSlotCount is static-only).
func TestEmitOpIfaceValueLoweringDynamicVtable() testing.TestResult {
	var out @strings.Builder = strings.NewBuilder()
	var m @ir.Module = ir.NewModule("\"main\"")
	// data ptr (id 1) and runtime vtable ptr (id 2), both raw *uint8.
	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = 1
	dataArg.Typ = types.MakePointerType(types.TypUint8())
	var vtArg @ir.Instr = make(ir.Instr)
	vtArg.ID = 2
	vtArg.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_IFACE_VALUE
	ins.Typ = types.MakeInterfaceValueType(nil)
	// StrVal left EMPTY -> dynamic form; Args = [data, vtable].
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dataArg
	ins.Args[1] = vtArg
	emitIfaceValueLLVM(out, m, ins)
	var s @[]char = buf.CopyStr(out.String())
	// The vtable slot must bitcast the runtime Args[1] SSA value (%v2), not point
	// at a static __ivt symbol.
	if !contains(s, "%v3.vt = bitcast i8* %v2 to i8*") {
		return fail("dynamic form should bitcast the Args[1] vtable value %v2 to i8*")
	}
	if contains(s, "@__ivt") {
		return fail("dynamic form must NOT reference a static __ivt vtable symbol")
	}
	if contains(s, "x i8*]*") {
		return fail("dynamic form must NOT bitcast a [N x i8*]* vtable array")
	}
	// The insertvalue chain that builds the %BnIfaceValue is still present.
	if !contains(s, "insertvalue %BnIfaceValue undef") {
		return fail("dynamic form should still build the %BnIfaceValue via insertvalue")
	}
	return ""
}

// `var iv *I` (no init) allocates a `%BnIfaceValue` slot but
// doesn't emit OP_IFACE_VALUE. Rules out a regression where the
// wrap path fires on the no-init branch.
//
// (The assertion checks for the vtable-bitcast symbol — the
// telltale of OP_IFACE_VALUE's WRAP emission.  After step-7 OP_LOAD
// fieldwise decomposition, the no-init read also emits an
// insertvalue chain on %BnIfaceValue, so the older check on
// "any insertvalue %BnIfaceValue" stopped distinguishing wrap from
// load.  The __ivt symbol is unique to WRAP.)
func TestEmitIfaceVarNoInit() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() {\n"
					"\tvar iv *I\n"
					"\t_ = iv\n"
					"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "alloca %BnIfaceValue") {
		return fail("expected iv to alloca as %BnIfaceValue")
	}
	// The impl always emits a `@__ivt.bn_V1_4_main1_T1_4_main1_I` global
	// declaration regardless of usage; the WRAP path additionally
	// emits a `bitcast [3 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I` to
	// load it into the iface-value data slot.  Pin on the bitcast
	// form, not the global itself.
	if contains(out, "[3 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail(
				"no-init iv should not emit the WRAP vtable bitcast")
	}
	return ""
}

// An `impl *T : Alias` where `Alias = Real` mangles on the
// canonical interface name (Real), not the alias-site reference.
// Both alias-site uses and target-site uses converge on the same
// vtable symbol — required for the cross-package "any TU may
// declare the impl" rule.
func TestEmitImplVtableAliasMangleOnCanonical() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface Real { foo() }\n"
					"interface Alias = Real\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : Alias\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main4_Real") {
		return fail(
				"impl on alias should mangle on canonical Real")
	}
	if contains(out, "@__ivt.bn_V1_4_main1_T1_4_main5_Alias") {
		return fail(
				"alias-named symbol must not be emitted")
	}
	return ""
}

// One impl satisfying two interfaces produces two distinct vtable
// globals, one per (impl, iface) pair.
func TestEmitImplVtableMultipleInterfaces() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface A { fa() }\n"
					"interface B { fb() }\n"
					"type T struct { x int }\n"
					"func (t *T) fa() { }\n"
					"func (t *T) fb() { }\n"
					"impl *T : A, B\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_A") {
		return fail("expected vtable for A")
	}
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_B") {
		return fail("expected vtable for B")
	}
	return ""
}

// `impl *T : Child` where
// `Child : Parent` emits two vtable globals — one for the
// directly-listed Child, one for the inherited Parent.  Child's
// vtable uses the concat layout: dtor, parent's full vtable
// inlined, child's own methods.
func TestEmitImplVtableExtendedConcatLayout() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface Closer { Close() }\n"
					"interface RC : Closer { Read() int }\n"
					"type F struct { x int }\n"
					"func (f *F) Close() { }\n"
					"func (f *F) Read() int { return 0 }\n"
					"impl *F : RC\n"
					"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Both vtables are emitted (Closer is registered transitively).
	if !contains(out, "@__ivt.bn_V1_4_main1_F1_4_main2_RC") {
		return fail("expected vtable for RC")
	}
	if !contains(out, "@__ivt.bn_V1_4_main1_F1_4_main6_Closer") {
		return fail("expected vtable for transitive Closer")
	}
	// RC vtable should be [6 x i8*]: dtor, *TypeInfo (RC any-block),
	// dtor, *TypeInfo (Closer nested any-block), Close (parent's own
	// method), Read (RC's own method).
	if !contains(out,
			"@__ivt.bn_V1_4_main1_F1_4_main2_RC = weak_odr constant { ptr, ptr, ptr, ptr, ptr, ptr }") {
		return fail("expected RC vtable to be 6 slots (concat layout)")
	}
	// Closer vtable is 3 slots: dtor + *TypeInfo + Close.
	if !contains(out, "@__ivt.bn_V1_4_main1_F1_4_main6_Closer = weak_odr constant { ptr, ptr, ptr }") {
		return fail("expected Closer vtable to be 3 slots")
	}
	return ""
}

// Dispatch through
// an inherited method on `*Child` GEPs into the parent's nested
// sub-vtable slot.  For RC : Closer with `rc.Close()`, the slot
// index is 4 (RC's any-block at 0-1, Closer's nested any-block at
// 2-3, Close at 4) — and the LLVM `getelementptr` reflects that
// directly.  Without the recursive findInterfaceMethod from Slice
// E.4, the dispatch would target slot 2 (correct for *Closer but
// wrong for *RC where Close has been pushed by the nested
// any-block).
func TestEmitImplVtableExtendedInheritedDispatchSlot() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"main\"\n"
					"interface Closer { Close() }\n"
					"interface RC : Closer { Read() int }\n"
					"type F struct { x int }\n"
					"func (f *F) Close() { }\n"
					"func (f *F) Read() int { return 0 }\n"
					"impl *F : RC\n"
					"func main() {\n"
					"\tvar f F\n"
					"\tvar rc *RC = &f\n"
					"\trc.Close()\n"
					"\tvar _ int = rc.Read()\n"
					"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Close is inherited, lands at slot 4 of RC's vtable.  The GEP into the
	// vtable slot array (to load the method handle) targets `%v<id>.vts`.
	if !contains(out, "getelementptr inbounds i8*, i8** %v") {
		return fail("expected dispatch GEP in output")
	}
	// At least one dispatch GEP must use i64 4 (the Close slot).
	if !contains(out, ".vts, i64 4") {
		return fail("expected RC.Close to dispatch at i64 4")
	}
	// And one must use i64 5 (the Read slot).
	if !contains(out, ".vts, i64 5") {
		return fail("expected RC.Read to dispatch at i64 5")
	}
	return ""
}
