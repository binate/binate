package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_impls.bn — emits a `[N+1 x i8*]` vtable global per
// (impl, interface) pair. Symbol form is the canonical
// `@__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>`
// (Slice 2.6 of plan-cross-package-interfaces.md). For same-package
// impls (today's only case), recv_pkg and iface_pkg both equal the
// impl declaration's package. Slot 0 is the receiver type's dtor
// (or i8* null if the type has no managed fields); slots 1..N+1 are
// the impl methods. Slice 2.3a-1 / 2.5 of plan-interface-syntax-
// revision.md.

// A single-method impl whose receiver has no managed fields
// produces a 2-slot vtable: { i8* null (no dtor), <method> }.
func TestEmitImplVtableSingleMethod() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail("expected vtable global @__ivt.bn_V1_4_main1_T1_4_main1_I")
	}
	if !contains(out, "weak_odr constant [2 x i8*] [i8* null,") {
		return fail(
			"expected 2-slot vtable starting with null dtor")
	}
	if !contains(out, "@bn_F1_4_main2_1_T3_foo") {
		return fail("expected method slot to bitcast bn_F1_4_main2_1_T3_foo")
	}
	return ""
}

// A two-method impl produces a 3-slot vtable: slot 0 = dtor (or
// null), slots 1..3 = methods in the interface's method-declaration
// order.
func TestEmitImplVtableMultiMethod() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface RW { read() int; write() }\n"
		"type Pipe struct { x int }\n"
		"func (p *Pipe) read() int { return 0 }\n"
		"func (p *Pipe) write() { }\n"
		"impl *Pipe : RW\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main4_Pipe1_4_main2_RW") {
		return fail("expected vtable global")
	}
	if !contains(out, "weak_odr constant [3 x i8*] [i8* null,") {
		return fail(
			"expected 3-slot vtable starting with null dtor")
	}
	if !contains(out, "@bn_F1_4_main2_4_Pipe4_read") {
		return fail("expected read slot")
	}
	if !contains(out, "@bn_F1_4_main2_4_Pipe5_write") {
		return fail("expected write slot")
	}
	return ""
}

// A receiver type with managed fields gets a non-null dtor in
// slot 0 — the dtor is invoked by ZeroRefDestroy when an @Iface
// over the receiver hits refcount zero. Slice 2.5b cleanup wiring
// in emitManagedIfaceValueRefDec pairs with this slot.
//
// Slot 0 stores a HANDLE POINTER (`*BnFuncValue`), not the raw
// dtor fn pointer.  ZeroRefDestroy's `_call_dtor(dtor, ptr)` is
// lowered as OP_CALL_HANDLE, which reads `handle.vtable.call` and
// invokes `shim(null, ptr)`.  A raw fn pointer in slot 0 would
// make OP_CALL_HANDLE byte-pun-read the dtor's own machine code
// as if it were a {vtable, data} struct (LP64 / aa64 / x64 happen
// to exit cleanly after a random jump; arm32-baremetal loops).
// The pre-fix shape was masked in conformance/370 because the
// holder enters consume with refcount 2 and never decrements past
// 1, but a test that drives the iface refcount to 0 inside the
// callee would expose it.
func TestEmitImplVtableDtorSlotForManagedReceiver() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type Inner struct { v int }\n"
		"type T struct { p @Inner }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail("expected vtable global")
	}
	if !contains(out,
			"i8* bitcast (%BnFuncValue* @__handle.bn_F1_4_main1_8___dtor_T to i8*)") {
		return fail(
			"expected @__ivt slot 0 = bitcast of dtor HANDLE pointer")
	}
	if contains(out,
			"bitcast (void(i8*)* @bn_F1_4_main1_8___dtor_T to i8*)") {
		return fail(
			"@__ivt slot 0 must NOT bitcast raw dtor fn ptr — OP_CALL_HANDLE would crash")
	}
	// The handle the slot points at must actually be defined in
	// this TU (added to the seen list by addImplDtorsToSeen) — a
	// dangling reference would link-fail.
	if !contains(out,
			"@__handle.bn_F1_4_main1_8___dtor_T = weak_odr constant { ptr, ptr }") {
		return fail("expected @__handle.<dtor> definition for impl receiver")
	}
	if !contains(out,
			"@__shim.bn_F1_4_main1_8___dtor_T") {
		return fail(
			"expected @__shim.<dtor> for impl receiver — backs handle.vtable.call")
	}
	return ""
}

// A program with no impls emits no `__ivt.` globals.
func TestEmitImplVtableNoImpls() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if contains(out, "@__ivt.") {
		return fail("expected no impl vtable globals")
	}
	return ""
}

// Slice 2.3a-2 lowering: OP_IFACE_VALUE produces a `%BnIfaceValue`
// with field 0 = data ptr (bitcast i8*) and field 1 = vtable ptr
// (bitcast `[N x i8*]*`). This shape is what dispatch sites in
// Slice 2.3a-3 will read.
func TestEmitOpIfaceValueLowering() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\t_ = iv\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "%BnIfaceValue = type { i8*, i8* }") {
		return fail("expected %BnIfaceValue type definition")
	}
	if !contains(out, "alloca %BnIfaceValue") {
		return fail("expected iv to alloca as %BnIfaceValue")
	}
	if !contains(out,
			"insertvalue %BnIfaceValue undef") {
		return fail(
			"expected insertvalue chain building the iface value")
	}
	if !contains(out, "[2 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail(
			"expected vtable bitcast against [2 x i8*]* form")
	}
	return ""
}

// OP_IFACE_VALUE whose data ptr is the address of a package global
// (`&g`) must bitcast the global symbol at its real pointer type,
// not reference a `%v-1` SSA id.  The global pseudo-instr has ID -1
// (lookupVar's global fallback), so the pre-fix lowering printed
// `bitcast i8* %v-1 to i8*` — an undefined value clang rejects.
// Conformance 495 pins the end-to-end run; this pins the emitted
// shape so a regression surfaces in the fast unit run.
func TestEmitOpIfaceValueFromGlobal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"var g T\n"
		"func main() {\n"
		"\tvar iv *I = &g\n"
		"\t_ = iv\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if contains(out, "%v-1") {
		return fail(
			"global-ref data ptr must not emit the bogus %v-1 SSA id")
	}
	if !contains(out, "bitcast %bn_S1_4_main1_1_T* @bn_G1_4_main1_1_g to i8*") {
		return fail(
			"expected data ptr to bitcast the global at its real "
			"pointer type: `bitcast %bn_S1_4_main1_1_T* @bn_G1_4_main1_1_g to i8*`")
	}
	return ""
}

// `var iv *I` (no init) allocates a `%BnIfaceValue` slot but
// doesn't emit OP_IFACE_VALUE. Rules out a regression where the
// wrap path fires on the no-init branch.
//
// (The assertion checks for the vtable-bitcast symbol — the
// telltale of OP_IFACE_VALUE's WRAP emission.  After step-7 OP_LOAD
// fieldwise decomposition, the no-init read also emits an
// insertvalue chain on %BnIfaceValue, so the older check on
// "any insertvalue %BnIfaceValue" stopped distinguishing wrap from
// load.  The __ivt symbol is unique to WRAP.)
func TestEmitIfaceVarNoInit() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar iv *I\n"
		"\t_ = iv\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "alloca %BnIfaceValue") {
		return fail("expected iv to alloca as %BnIfaceValue")
	}
	// The impl always emits a `@__ivt.bn_V1_4_main1_T1_4_main1_I` global
	// declaration regardless of usage; the WRAP path additionally
	// emits a `bitcast [2 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I` to
	// load it into the iface-value data slot.  Pin on the bitcast
	// form, not the global itself.
	if contains(out, "[2 x i8*]* @__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail(
			"no-init iv should not emit the WRAP vtable bitcast")
	}
	return ""
}

// An `impl *T : Alias` where `Alias = Real` mangles on the
// canonical interface name (Real), not the alias-site reference.
// Both alias-site uses and target-site uses converge on the same
// vtable symbol — required for the cross-package "any TU may
// declare the impl" rule (Slice 2.6 of plan-cross-package-
// interfaces.md).
func TestEmitImplVtableAliasMangleOnCanonical() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Real { foo() }\n"
		"interface Alias = Real\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : Alias\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main4_Real") {
		return fail(
			"impl on alias should mangle on canonical Real")
	}
	if contains(out, "@__ivt.bn_V1_4_main1_T1_4_main5_Alias") {
		return fail(
			"alias-named symbol must not be emitted")
	}
	return ""
}

// One impl satisfying two interfaces produces two distinct vtable
// globals, one per (impl, iface) pair.
func TestEmitImplVtableMultipleInterfaces() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface A { fa() }\n"
		"interface B { fb() }\n"
		"type T struct { x int }\n"
		"func (t *T) fa() { }\n"
		"func (t *T) fb() { }\n"
		"impl *T : A, B\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_A") {
		return fail("expected vtable for A")
	}
	if !contains(out, "@__ivt.bn_V1_4_main1_T1_4_main1_B") {
		return fail("expected vtable for B")
	}
	return ""
}

// plan-interface-embedding.md Slice E.3: `impl *T : Child` where
// `Child : Parent` emits two vtable globals — one for the
// directly-listed Child, one for the inherited Parent.  Child's
// vtable uses the concat layout: dtor, parent's full vtable
// inlined, child's own methods.
func TestEmitImplVtableExtendedConcatLayout() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n"
		"func main() { }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Both vtables are emitted (Closer is registered transitively).
	if !contains(out, "@__ivt.bn_V1_4_main1_F1_4_main2_RC") {
		return fail("expected vtable for RC")
	}
	if !contains(out, "@__ivt.bn_V1_4_main1_F1_4_main6_Closer") {
		return fail("expected vtable for transitive Closer")
	}
	// RC vtable should be [4 x i8*]: dtor, dtor (parent any-block),
	// Close (parent's own method), Read (RC's own method).
	if !contains(out,
			"@__ivt.bn_V1_4_main1_F1_4_main2_RC = weak_odr constant [4 x i8*]") {
		return fail("expected RC vtable to be 4 slots (concat layout)")
	}
	// Closer vtable is [2 x i8*]: dtor + Close.
	if !contains(out,
			"@__ivt.bn_V1_4_main1_F1_4_main6_Closer = weak_odr constant [2 x i8*]") {
		return fail("expected Closer vtable to be 2 slots")
	}
	return ""
}

// plan-interface-embedding.md Slice E.4 part 1: dispatch through
// an inherited method on `*Child` GEPs into the parent's nested
// sub-vtable slot.  For RC : Closer with `rc.Close()`, the slot
// index is 2 (RC's any-block at 0, Closer's nested any-block at
// 1, Close at 2) — and the LLVM `getelementptr` reflects that
// directly.  Without the recursive findInterfaceMethod from Slice
// E.4, the dispatch would target slot 1 (correct for *Closer but
// wrong for *RC where Close has been pushed by the nested
// any-block).
func TestEmitImplVtableExtendedInheritedDispatchSlot() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n"
		"func main() {\n"
		"\tvar f F\n"
		"\tvar rc *RC = &f\n"
		"\trc.Close()\n"
		"\tvar _ int = rc.Read()\n"
		"}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	// Close is inherited, lands at slot 2 of RC's vtable.
	if !contains(out,
			"getelementptr inbounds i8*, i8** %v") {
		return fail("expected dispatch GEP in output")
	}
	// At least one dispatch GEP must use i64 2 (the Close slot).
	if !contains(out, ".vt, i64 2") {
		return fail("expected RC.Close to dispatch at i64 2")
	}
	// And one must use i64 3 (the Read slot).
	if !contains(out, ".vt, i64 3") {
		return fail("expected RC.Read to dispatch at i64 3")
	}
	return ""
}
