package "pkg/binate/codegen"

import "pkg/builtins/testing"

// End-to-end coverage of the within-package inliner (pkg/binate/ir
// inline_calls.bn), which runs in RunOptPasses at level >= 1.  A tiny
// same-package scalar helper is inlined at -O1: its CALL disappears from the
// caller while its definition remains, so the helper symbol appears fewer times
// at -O1 than at -O0 (which keeps both the call and the definition).
// countSubstr lives in emit_bounds_test.bn.
func TestInlinerRemovesHelperCallAtO1() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func myaddfn(a int, b int) int { return a + b }\n"
			"func main() {\n"
			"\tvar x int = myaddfn(3, 4)\n"
			"\t_ = x\n"
			"}\n"
	var o0 @[]char = compileToLLVM(src) // level 0: no opt passes, no inlining
	var o1 @[]char = compileToLLVMOpt(src, 1) // level 1: inliner runs
	var n0 int = countSubstr(o0, "myaddfn(")
	var n1 int = countSubstr(o1, "myaddfn(")
	// -O0 keeps both the call and the definition of myaddfn (>= 2 references).
	if n0 < 2 {
		return fail("setup: at -O0 expected both the call and the definition of myaddfn")
	}
	// -O1 inlines the call away, leaving fewer references (the definition only).
	if n1 >= n0 {
		return fail("at -O1 the myaddfn call should be inlined away (fewer references than -O0)")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerSubstitutesParamAtO1 checks that inlining a param-taking helper
// splices its BODY (not just removes the call) with the caller's arg
// substituted: at -O1 the caller gains the helper's `add` (a + 100), so there
// are strictly MORE add instructions than at -O0 (where main only calls the
// helper and the single add lives once in the helper's define).
func TestInlinerSubstitutesParamAtO1() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func plus100(a int) int { return a + 100 }\n"
			"func main() {\n"
			"\tvar x int = plus100(5)\n"
			"\t_ = x\n"
			"}\n"
	var o0 @[]char = compileToLLVM(src)
	var o1 @[]char = compileToLLVMOpt(src, 1)
	// The call is gone at -O1.
	if countSubstr(o1, "plus100(") >= countSubstr(o0, "plus100(") {
		return fail("at -O1 the plus100 call should be inlined away")
	}
	// The body was spliced (the add now also appears in the caller).
	if countSubstr(o1, "= add ") <= countSubstr(o0, "= add ") {
		return fail("at -O1 the helper's `a + 100` add should be spliced into the caller")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerInlinesManagedParamFaultCallee (Inc 3b): a SMALL callee with a
// managed-ptr PARAM live at a div-by-zero check has a single-block non-empty pad
// (RefDec the param), so Inc 3b inlines it at -O1 — the owned-param entry-RefInc
// balances the cloned pad's RefDec.  The call disappears; only the definition of
// `atp(` remains.  (A managed param is NOT a special case: it inlines just like a
// managed local/temp — the only gate is the shared size threshold.)
func TestInlinerInlinesManagedParamFaultCallee() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Node struct { v int }\n"
			"func atp(p @Node, d int) int { return 10 / d }\n"
			"func main() {\n"
			"\tvar n @Node = make(Node)\n"
			"\tvar r int = atp(n, 2)\n"
			"\t_ = r\n"
			"}\n"
	var o1 @[]char = compileToLLVMOpt(src, 1)
	if countSubstr(o1, "atp(") != 1 {
		return fail("a small managed-param single-block-pad fault callee must be inlined at -O1 (Inc 3b)")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerInlinesSingleBlockPadFaultCallee (Inc 3b): a leaf callee that holds
// a managed-ptr LOCAL live at a div-by-zero check has a NON-empty but single-block
// fault pad (straight-line RefDec of the local, then unwind).  Inc 3b clones that
// pad into the caller and chains it into the call-site pad, so the callee IS
// inlined at -O1 — its call disappears (only the definition of `divlocal(` remains).
func TestInlinerInlinesSingleBlockPadFaultCallee() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Node struct { v int }\n"
			"func divlocal(d int) int {\n"
			"\tvar n @Node = make(Node)\n"
			"\t_ = n\n"
			"\treturn 10 / d\n"
			"}\n"
			"func main() {\n"
			"\tvar r int = divlocal(2)\n"
			"\t_ = r\n"
			"}\n"
	var o1 @[]char = compileToLLVMOpt(src, 1)
	// Inlined -> only the definition of divlocal remains (call gone) -> one match.
	if countSubstr(o1, "divlocal(") != 1 {
		return fail("a single-block non-empty-pad fault callee must be inlined at -O1 (Inc 3b)")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerInlinesMultiReturnCallee (Inc 4): a callee with two return sites
// (early return) is inlined at -O1 — the multi-block merge slot routes both
// returns' values to the caller.  The call disappears; only the definition of
// `classify(` remains.
func TestInlinerInlinesMultiReturnCallee() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func classify(x int) int {\n"
			"\tif x > 0 {\n"
			"\t\treturn x + 1\n"
			"\t}\n"
			"\treturn x - 1\n"
			"}\n"
			"func main() {\n"
			"\tvar r int = classify(5)\n"
			"\t_ = r\n"
			"}\n"
	var o1 @[]char = compileToLLVMOpt(src, 1)
	if countSubstr(o1, "classify(") != 1 {
		return fail("a multi-return callee must be inlined at -O1 (Inc 4)")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerInlinesStructReturnCallee (Inc 5a): a callee returning a by-value
// struct is inlined at -O1 (the aggregate return value flows through the merge
// slot / direct retVal like a scalar); its call disappears.
func TestInlinerInlinesStructReturnCallee() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Point struct { x int\n y int }\n"
			"func mkpt(a int, b int) Point {\n\tvar p Point\n\tp.x = a\n\tp.y = b\n\treturn p\n}\n"
			"func main() {\n\tvar q Point = mkpt(3, 4)\n\t_ = q\n}\n"
	var o1 @[]char = compileToLLVMOpt(src, 1)
	if countSubstr(o1, "mkpt(") != 1 {
		return fail("a by-value struct-return callee must be inlined at -O1 (Inc 5a)")
	}
	var pass testing.TestResult
	return pass
}

// TestInlinerInlinesMultiValueCallee (Inc 5b): a multi-value (int, int) callee is
// inlined at -O1 (its N return values packed into a tuple); its call disappears.
func TestInlinerInlinesMultiValueCallee() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func dm(x int) (int, int) { return x + 1, x - 1 }\n"
			"func main() {\n\tvar a int\n\tvar b int\n\ta, b = dm(5)\n\t_ = a\n\t_ = b\n}\n"
	var o1 @[]char = compileToLLVMOpt(src, 1)
	if countSubstr(o1, "dm(") != 1 {
		return fail("a multi-value callee must be inlined at -O1 (Inc 5b)")
	}
	var pass testing.TestResult
	return pass
}
