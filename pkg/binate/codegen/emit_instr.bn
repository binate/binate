package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitInstr dispatches a single IR instruction to the appropriate LLVM IR emitter.
// m is the module being emitted (consulted for OP_IFACE_VALUE vtable sizing).
func emitInstr(
		out *strings.Builder, m @ir.Module, instr @ir.Instr, strs *[]ir.StringConst,
		funcRetTypes *[]FuncRetType) {
	if instr.Op == iropcode.OP_SP_RESTORE {
		// Statement-end marker for the bytecode VM. LLVM-side no-op:
		// alloca'd temporaries are scoped to the LLVM function and
		// get DCE'd / SROA'd by the optimizer; there's no equivalent
		// of vm.Stack accumulation to reclaim. Return BEFORE the "  "
		// prefix so emit_debug.bn's addDbgToLastLine doesn't try to
		// attach a !dbg suffix to a phantom blank line.
		return
	}
	out.Write("  ")

	// Arithmetic / comparison families are op-RANGES (OP_ADD..OP_SHR,
	// OP_EQ..OP_GE), not single values, so they stay as range guards
	// ahead of the per-op switch below.
	if instr.Op >= iropcode.OP_ADD && instr.Op <= iropcode.OP_SHR {
		emitBinop(out, instr)
		return
	}
	if instr.Op >= iropcode.OP_EQ && instr.Op <= iropcode.OP_GE {
		emitCmp(out, instr)
		return
	}

	switch instr.Op {
	case iropcode.OP_CONST_INT:
		emitRef(out, instr.ID)
		out.Write(" = add ")
		out.Write(llvmType(instr.Typ))
		out.WriteByte(' ')
		stringutils.WriteInt64(out, instr.IntVal)
		out.Write(", 0\n")
		return
	case iropcode.OP_CONST_FLOAT:
		// LLVM accepts decimal floats but is picky: "1." must be
		// written "1.0". We fold the literal into a register via
		// `fadd <type> 0.0, literal` so the SSA shape matches
		// OP_CONST_INT's add-against-zero idiom.
		if floatSlotIsI32(instr.Typ) {
			// A decimal `float` (32-bit) constant must be EXACTLY
			// representable or LLVM rejects it ("floating point constant
			// invalid for type") — and most float32 literals are not.  So
			// materialize the value as a double (decimal is fine for double)
			// and fptrunc to float; LLVM does the round, matching how a
			// float32 literal is meant to be read (nearest-float of the
			// literal-as-double).
			emitRef(out, instr.ID)
			out.Write(".f64 = fadd double 0.0, ")
			out.Write(normalizeFloatLiteral(instr.StrVal))
			out.WriteByte('\n')
			emitRef(out, instr.ID)
			out.Write(" = fptrunc double ")
			emitRef(out, instr.ID)
			out.Write(".f64 to float\n")
			return
		}
		emitRef(out, instr.ID)
		out.Write(" = fadd ")
		out.Write(llvmType(instr.Typ))
		out.Write(" 0.0, ")
		out.Write(normalizeFloatLiteral(instr.StrVal))
		out.WriteByte('\n')
		return
	case iropcode.OP_CONST_BOOL:
		emitRef(out, instr.ID)
		out.Write(" = add i1 ")
		if instr.BoolVal {
			out.WriteByte('1')
		} else {
			out.WriteByte('0')
		}
		out.Write(", 0\n")
		return
	case iropcode.OP_CONST_STRING:
		var sid int = ir.FindStringID(strs, instr.StrVal)
		var slen int = len(instr.StrVal)
		emitRef(out, instr.ID)
		out.Write(" = getelementptr inbounds [")
		stringutils.WriteInt(out, slen)
		out.Write(" x i8], [")
		stringutils.WriteInt(out, slen)
		out.Write(" x i8]* @.str.")
		stringutils.WriteInt(out, sid)
		out.Write(", i64 0, i64 0\n")
		return
	case iropcode.OP_CONST_NIL:
		emitConstNil(out, instr)
		return
	case iropcode.OP_LAND, iropcode.OP_LOR:
		emitLogical(out, instr)
		return
	case iropcode.OP_NEG:
		emitRef(out, instr.ID)
		var negTyp @types.Type = unwrapNamed(instr.Typ)
		var isFloat bool = negTyp != nil &&
				(negTyp.Kind == types.TYP_FLOAT || negTyp.Kind == types.TYP_UNTYPED_FLOAT)
		if isFloat {
			out.Write(" = fneg ")
			out.Write(llvmType(instr.Typ))
			out.WriteByte(' ')
			emitRef(out, instr.Args[0].ID)
		} else {
			out.Write(" = sub ")
			out.Write(llvmType(instr.Typ))
			out.Write(" 0, ")
			emitRef(out, instr.Args[0].ID)
		}
		out.WriteByte('\n')
		return
	case iropcode.OP_NOT:
		emitRef(out, instr.ID)
		out.Write(" = xor i1 ")
		emitRef(out, instr.Args[0].ID)
		out.Write(", 1\n")
		return
	case iropcode.OP_BITNOT:
		emitRef(out, instr.ID)
		out.Write(" = xor ")
		out.Write(llvmType(instr.Typ))
		out.WriteByte(' ')
		emitRef(out, instr.Args[0].ID)
		out.Write(", -1\n")
		return
	case iropcode.OP_ALLOC:
		emitAlloc(out, instr)
		return
	case iropcode.OP_LOAD:
		// Aggregate-typed load: lower to per-scalar
		// GEP + load + insertvalue chain.  LLVM's ARM EABI backend
		// may lower a plain `load <T>, ptr` to `__aeabi_memcpy` for
		// large aggregates — threshold + behavior is LLVM-version-
		// dependent and not pinned by spec.  Decomposing here
		// removes that dependency (mirrors OP_STORE's aggregate
		// path; see emit_copy_ssa.bn and
		// explorations/plan-codegen-c-free-copies.md).
		if isAggregateForStore(instr.Typ) {
			emitAggregateLoadIntoSSAInstr(out, instr, instr.Args[0])
			return
		}
		emitRef(out, instr.ID)
		out.Write(" = load ")
		out.Write(llvmType(instr.Typ))
		out.Write(", ")
		out.Write(llvmType(instr.Typ))
		out.Write("* ")
		emitPtrRef(out, instr.Args[0])
		out.WriteByte('\n')
		return
	case iropcode.OP_GET_FIELD_PTR:
		emitGetFieldPtr(out, instr)
		return
	case iropcode.OP_GET_ELEM_PTR:
		emitGetElemPtr(out, instr)
		return
	case iropcode.OP_STORE:
		// Byval-param spill: the value (Args[1]) is a `ptr byval(<T>)`
		// param at the LLVM-IR level, not a struct value.  A plain
		// `store <T> <val>, ptr <slot>` type-mismatches.  Emit a
		// scalar-store sequence (one load+store per scalar leaf of
		// T's layout) instead — semantically equivalent to byval's
		// "callee gets its own copy" contract, and crucially
		// decomposed into scalars so the LLVM backend never lowers
		// the spill to `@llvm.memcpy` / `__aeabi_memcpy` (the
		// C-library dependency we don't carry on bare-metal).  See
		// explorations/plan-codegen-c-free-copies.md.
		if instr.Args[1].IsByvalParamRef && instr.Args[1].Typ != nil {
			// idTag must be unique per OP_STORE so emitted SSA
			// names don't collide; OP_STORE itself is a void
			// instr (ID = -1).  The dst alloca is fresh per
			// byval-spill (one alloca per param), so its ID is
			// unique within the function.
			emitFieldwiseCopyInstr(out, instr.Args[0], instr.Args[1], instr.Args[1].Typ, instr.Args[0].ID)
			return
		}
		// Aggregate-typed store: lower to per-scalar
		// extractvalue + GEP + store sequence.  Avoids LLVM's
		// `store <T> %v, ptr` lowering of large aggregates to
		// `__aeabi_memcpy` on ARM EABI (the C-library dependency
		// step 5 of plan-codegen-c-free-copies.md eliminates).
		if isAggregateForStore(instr.Args[1].Typ) {
			emitAggregateStoreFromSSAInstr(out, instr.Args[0], instr.Args[1])
			return
		}
		var valTyp @[]char = llvmType(instr.Args[1].Typ)
		out.Write("store ")
		out.Write(valTyp)
		out.WriteByte(' ')
		emitValRef(out, instr.Args[1])
		out.Write(", ")
		out.Write(valTyp)
		out.Write("* ")
		emitPtrRef(out, instr.Args[0])
		out.WriteByte('\n')
		return
	case iropcode.OP_JUMP:
		out.Write("br label %")
		out.Write(instr.Block1.Label)
		out.WriteByte('\n')
		return
	case iropcode.OP_BRANCH:
		out.Write("br i1 ")
		emitRef(out, instr.Args[0].ID)
		out.Write(", label %")
		out.Write(instr.Block1.Label)
		out.Write(", label %")
		out.Write(instr.Block2.Label)
		out.WriteByte('\n')
		return
	case iropcode.OP_RETURN:
		emitReturn(out, instr)
		return
	case iropcode.OP_UNREACHABLE:
		out.Write("unreachable\n")
		return
	case iropcode.OP_CALL:
		emitCall(out, instr, funcRetTypes)
		return
	case iropcode.OP_CALL_INDIRECT:
		emitCallIndirect(out, instr)
		return
	case iropcode.OP_CALL_HANDLE:
		emitCallHandle(out, instr)
		return
	case iropcode.OP_C_CALL:
		emitCCall(out, instr)
		return
	case iropcode.OP_EXTRACT:
		emitExtract(out, instr, funcRetTypes)
		return
	case iropcode.OP_CAST:
		emitCast(out, instr)
		return
	case iropcode.OP_BIT_CAST:
		emitBitCast(out, instr)
		return
	case iropcode.OP_MANAGED_TO_RAW:
		emitManagedToRawInstr(out, instr)
		return
	case iropcode.OP_MAKE:
		var sizeBytes int = typeSizeBytes(instr.TypeArg)
		emitRef(out, instr.ID)
		out.Write(" = call i8* @")
		out.Write(rtSym("Alloc"))
		out.Write("(")
		out.Write(intLL())
		out.WriteByte(' ')
		stringutils.WriteInt(out, sizeBytes)
		out.Write(")\n")
		return
	case iropcode.OP_MAKE_SLICE:
		emitMakeSliceInstr(out, instr)
		return
	case iropcode.OP_RODATA_ARRAY:
		emitStringToArrayInstr(out, instr)
		return
	// Phase 3: rodata composite-literal ops carry their byte
	// sequence on `instr.StrVal` directly.  emitStringToCharsCopy
	// inlines those bytes as i8 constants — no rodata-global lookup
	// or memcpy.
	case iropcode.OP_RODATA_MSLICE_COPY:
		var strLen int = len(instr.StrVal)
		emitStringToCharsCopy(out, instr, strLen)
		return
	case iropcode.OP_RODATA_MSLICE:
		var sid int = ir.FindStringID(strs, instr.StrVal)
		emitRef(out, instr.ID)
		out.Write(" = load %BnManagedSlice, %BnManagedSlice* @.str.")
		stringutils.WriteInt(out, sid)
		out.Write(".ms\n")
		return
	case iropcode.OP_RODATA_SLICE:
		var sid int = ir.FindStringID(strs, instr.StrVal)
		emitStringToRawSlice(out, instr, sid)
		return
	case iropcode.OP_BOX:
		emitBoxInstr(out, instr)
		return
	case iropcode.OP_DEREF:
		emitDerefInstr(out, instr)
		return
	case iropcode.OP_REFINC:
		emitRefIncInline(out, instr)
		return
	case iropcode.OP_REFDEC:
		emitRefDecInline(out, instr)
		return
	case iropcode.OP_FUNC_HANDLE:
		// Phase 4 of plan-uniform-native-fnptrs.md: returns a
		// *uint8 pointing at the static 16-byte {vtable, data}
		// handle bnc emits per function (see emitFuncValueHandle
		// in emit_funcvals.bn).  Consumed by OP_CALL_HANDLE via
		// handle.vtable.call(handle.data, args).
		emitRef(out, instr.ID)
		out.Write(" = bitcast %BnFuncValue* @__handle.")
		out.Write(mangle.FuncName(modulePkgName, instr.StrVal))
		out.Write(" to i8*\n")
		return
	case iropcode.OP_CALL_FUNC_VALUE:
		emitCallFuncValue(out, instr)
		return
	case iropcode.OP_FUNC_VALUE:
		// Build a 2-word {vtable, data} value:
		//   vtable = bitcast (%BnVtable* @__vt.<mangled> to i8*)
		//   data   = null  (Phase 1 non-capturing) or
		//   data   = bitcast (instr.Args[0] to i8*)  (B.2 capturing
		//            closure: Args[0] is the alloca'd closure-struct
		//            pointer).
		// emitFuncValueVtables (called at module emit time) ensured
		// @__vt.<mangled> exists as a weak_odr constant.
		var mangled @[]char = mangle.FuncName(modulePkgName, instr.StrVal)
		// %v.vt = bitcast %BnVtable* @__vt.<mangled> to i8*
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt = bitcast %BnVtable* @__vt.")
		out.Write(mangled)
		out.Write(" to i8*\n  ")
		// %v.0 = insertvalue %BnFuncValue undef, i8* %v.vt, 0
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".0 = insertvalue %BnFuncValue undef, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt, ")
		stringutils.WriteInt(out, types.FuncValueVtableIndex())
		out.Write("\n  ")
		// data slot: null for non-capturing, bitcast Args[0] for B.2.
		if len(instr.Args) == 0 {
			emitRef(out, instr.ID)
			out.Write(" = insertvalue %BnFuncValue %v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".0, i8* null, ")
			stringutils.WriteInt(out, types.FuncValueDataIndex())
			out.Write("\n")
		} else {
			var dataArg @ir.Instr = instr.Args[0]
			out.Write("%v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".dp = bitcast ")
			out.Write(llvmType(dataArg.Typ))
			out.WriteByte(' ')
			emitRef(out, dataArg.ID)
			out.Write(" to i8*\n  ")
			emitRef(out, instr.ID)
			out.Write(" = insertvalue %BnFuncValue %v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".0, i8* %v")
			stringutils.WriteInt(out, instr.ID)
			out.Write(".dp, ")
			stringutils.WriteInt(out, types.FuncValueDataIndex())
			out.Write("\n")
		}
		return
	case iropcode.OP_CALL_IFACE_METHOD:
		emitCallIfaceMethod(out, instr)
		return
	case iropcode.OP_IFACE_DTOR:
		emitIfaceDtor(out, instr)
		return
	case iropcode.OP_FUNC_VALUE_DTOR:
		emitFuncValueDtor(out, instr)
		return
	case iropcode.OP_IFACE_UPCAST:
		emitIfaceUpcast(out, instr)
		return
	case iropcode.OP_IFACE_VALUE:
		// Build a 2-word interface value:
		//   data    = bitcast (<srcType> %data to i8*)   ; field 0
		//   vtable  = bitcast ([N x i8*]* @<__ivt> to i8*) ; field 1
		// instr.Args[0] is the data ptr (raw or managed), instr.StrVal
		// is the mangled name of the `__ivt.<...>` global. The vtable
		// global itself is emitted by emitImplVtables (Slice 2.3a-1);
		// here we just point at it.
		var dataInstr @ir.Instr = instr.Args[0]
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dp = bitcast ")
		if dataInstr.IsGlobalRef {
			// The data ptr is a global's address (`@<mangled>`),
			// which has LLVM type `<pointee>*`.  llvmType collapses
			// a raw pointer to `i8*`, which would mismatch the
			// global symbol's real pointer type — so spell the
			// pointee type (TypeArg) explicitly and reference the
			// symbol via emitPtrRef rather than a nonexistent
			// `%v<id>` (the global pseudo-instr has ID -1).
			out.Write(llvmType(dataInstr.TypeArg))
			out.Write("* ")
			emitPtrRef(out, dataInstr)
		} else {
			out.Write(llvmType(dataInstr.Typ))
			out.WriteByte(' ')
			emitRef(out, dataInstr.ID)
		}
		out.Write(" to i8*\n  ")
		var nSlots int = vtableSlotCount(m, instr.StrVal)
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt = bitcast [")
		stringutils.WriteInt(out, nSlots)
		out.Write(" x i8*]* @")
		out.Write(instr.StrVal)
		out.Write(" to i8*\n  ")
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".0 = insertvalue %BnIfaceValue undef, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dp, ")
		stringutils.WriteInt(out, types.IfaceValueDataIndex())
		out.Write("\n  ")
		emitRef(out, instr.ID)
		out.Write(" = insertvalue %BnIfaceValue %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".0, i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".vt, ")
		stringutils.WriteInt(out, types.IfaceValueVtableIndex())
		out.Write("\n")
		return
	case iropcode.OP_BOUNDS_CHECK:
		out.Write("call void @")
		out.Write(rtSym("BoundsCheck"))
		out.Write("(")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[0].ID)
		out.Write(", ")
		out.Write(intLL())
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.Write(")\n")
		return
	case iropcode.OP_DIV_CHECK:
		// rt.DivCheck(dividend, divisor, signedMin, isSigned). Operands
		// are already 64-bit (IR-gen sign/zero-extends them); signedMin
		// is recovered from the carried width, isSigned from BoolVal.
		var dcSigned int = 0
		if instr.BoolVal {
			dcSigned = 1
		}
		var dcMin int64 = types.SignedMinForWidth(cast(int, instr.IntVal))
		out.Write("call void @")
		out.Write(rtSym("DivCheck"))
		out.Write("(i64 ")
		emitRef(out, instr.Args[0].ID)
		out.Write(", i64 ")
		emitRef(out, instr.Args[1].ID)
		out.Write(", i64 ")
		stringutils.WriteInt64(out, dcMin)
		out.Write(", ")
		out.Write(intLL())
		out.WriteByte(' ')
		stringutils.WriteInt(out, dcSigned)
		out.Write(")\n")
		return
	case iropcode.OP_SHIFT_CHECK:
		// rt.ShiftCheck(count): panic if the count is negative. The count
		// operand is already 64-bit (IR-gen sign-extends it).
		out.Write("call void @")
		out.Write(rtSym("ShiftCheck"))
		out.Write("(i64 ")
		emitRef(out, instr.Args[0].ID)
		out.Write(")\n")
		return
	}
	out.Write("; unhandled op ")
	stringutils.WriteInt(out, instr.Op)
	out.WriteByte('\n')
	return
}

// --- Extracted helpers ---
