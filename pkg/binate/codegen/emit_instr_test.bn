package "pkg/binate/codegen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the emitInstr dispatch (simple inline cases).

// OP_SP_RESTORE is a statement-end marker for the bytecode VM.
// LLVM-side semantics: pure no-op — alloca'd temporaries are
// already DCE'd / SROA'd by the optimizer, so no equivalent
// reclamation is needed. emitInstr must produce ZERO bytes for an
// OP_SP_RESTORE Instr (not even a "  " prefix or a blank line),
// otherwise emit_debug.bn's per-instruction !dbg-loc append would
// either attach to the previous line or generate a phantom blank
// line in debug output.
func TestEmitSPRestoreLLVMNoop() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var noArgs @[]@ir.Instr
	var f @ir.Func = ir.NewFunc("noop", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitSPRestore()
	b.EmitReturn(noArgs)
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var out @[]char = EmitModule(m)
	// Should contain the function definition + ret, but no
	// "; unhandled op" comment.
	if !contains(out, "ret void") {
		return fail("expected `ret void` in emitted IR")
	}
	if contains(out, "; unhandled op") {
		return fail("OP_SP_RESTORE should not emit `; unhandled op` comment")
	}
	if contains(out, "sp_restore") {
		return fail("OP_SP_RESTORE should produce no LLVM emission whatsoever")
	}
	return ""
}

func TestEmitConstInt() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\nfunc main() { println(42) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "add i64 42, 0") {
		return fail("expected const int emission")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitConstBool() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x bool = true }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "add i1 1, 0") {
		return fail("expected const bool emission")
	}
	var pass testing.TestResult
	return pass
}

// A non-constant signed integer divide emits a DivCheck guard call
// before the divide, with the type's signed MIN and isSigned=1 (i64 64
// → INT64_MIN on a 64-bit target).
func TestEmitDivCheckForSignedDivide() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc d(a int, b int) int { return a / b }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call void @bn_pkg__builtins__rt__DivCheck(i64 ") {
		return fail("expected DivCheck guard before signed divide")
	}
	if !contains(out, "-9223372036854775808, i64 1)") {
		return fail("expected INT64_MIN + isSigned=1 for a signed int divide")
	}
	return ""
}

// An unsigned divide passes isSigned=0 (the backend skips the MIN/-1
// check); the divide itself is still guarded against a zero divisor.
func TestEmitDivCheckForUnsignedDivide() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc d(a uint32, b uint32) uint32 { return a / b }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call void @bn_pkg__builtins__rt__DivCheck(i64 ") {
		return fail("expected DivCheck guard before unsigned divide")
	}
	if !contains(out, ", i64 0)") {
		return fail("expected isSigned=0 for an unsigned divide")
	}
	return ""
}

// Float `/` lowers to fdiv with no guard.
func TestEmitNoDivCheckForFloatDivide() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc d(a float64, b float64) float64 { return a / b }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "DivCheck") {
		return fail("float divide must not emit a DivCheck guard")
	}
	return ""
}

// A non-constant SIGNED shift count emits a ShiftCheck guard call before
// the shift — a negative count must trap at runtime.
func TestEmitShiftCheckForSignedCount() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc s(a int, n int) int { return a << n }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call void @bn_pkg__builtins__rt__ShiftCheck(i64 ") {
		return fail("expected a ShiftCheck guard before a signed-count shift")
	}
	return ""
}

// An UNSIGNED shift count can't be negative, so no ShiftCheck guard.
func TestEmitNoShiftCheckForUnsignedCount() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc s(a int, n uint) int { return a << n }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "ShiftCheck") {
		return fail("unsigned shift count must not emit a ShiftCheck guard")
	}
	return ""
}

// Float `!=` lowers to the UNORDERED `fcmp une` (true for NaN, per
// IEEE 754 / Go), NOT the ordered `fcmp one` — so it stays the exact
// complement of `==`.
func TestEmitFloatNotEqualUnordered() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc f(x float64, y float64) bool { return x != y }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fcmp une double") {
		return fail("float != must lower to unordered fcmp une")
	}
	if contains(out, "fcmp one double") {
		return fail("float != must NOT use the ordered fcmp one")
	}
	return ""
}

// Float `==` stays the ordered `fcmp oeq` (false for NaN).
func TestEmitFloatEqualOrdered() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nfunc f(x float64, y float64) bool { return x == y }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fcmp oeq double") {
		return fail("float == must lower to ordered fcmp oeq")
	}
	return ""
}

func TestEmitLoadStore() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\nfunc main() { var x int = 1; x = 2; println(x) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "store i64") {
		return fail("expected store emission")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitAddrOfGlobalAsValue pins the fix for `&G` (a top-level
// global's address) used in a VALUE-operand position (here a store
// value).  The IsGlobalRef pseudo has ID -1, so a value-operand
// emitter using emitRef would render the undefined `%v-1`; emitValRef
// must render the global symbol `@<mangled>` instead.  Conformance 551
// covers the other value positions (call arg, return, …) end-to-end.
func TestEmitAddrOfGlobalAsValue() testing.TestResult {
	setTarget64()
	var src *[]readonly char =
		"package \"main\"\nvar G int = 9\nfunc main() { var p *int = &G; p[0] = 1 }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "%v-1") {
		return fail("&G as a value emitted %v-1 (undefined IsGlobalRef pseudo)")
	}
	if !contains(out, "@bn_main__G") {
		return fail("expected global symbol @bn_main__G in emitted IR")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitJumpBranch() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { if true { println(1) } }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "br i1") {
		return fail("expected branch emission")
	}
	if !contains(out, "br label") {
		return fail("expected jump emission")
	}
	var pass testing.TestResult
	return pass
}

