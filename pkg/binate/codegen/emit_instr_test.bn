	if !contains(out, "sub i64 0,") {
		return fail("expected sub for negation")
	}
	var pass testing.TestResult
	return pass
}

func TestSliceElemPtrEmission() testing.TestResult {
	// Slice element pointer should emit getelementptr
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"type Point struct {\n"
		"\tX int\n"
		"\tY int\n"
		"}\n"
		"func main() {\n"
		"\tvar pts @[]Point = make_slice(Point, 1)\n"
		"\tpts[0] = Point{1, 2}\n"
		"\tpts[0].X = 99\n"
		"}\n")
	var src *[]readonly char = cb.Bytes()
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @ir.Module = ir.GenModule(file)

	var out @[]char = EmitModule(m)
	if !contains(out, "getelementptr") {
		return fail("expected getelementptr for slice element access")
	}
	var pass testing.TestResult
	return pass
}

func TestSliceExprStructEmission() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"type Item struct {\n"
		"\tVal int\n"
		"}\n"
		"func main() {\n"
		"\tvar items @[]Item = make_slice(Item, 2)\n"
		"\titems[0] = Item{1}\n"
		"\titems[1] = Item{2}\n"
		"\tvar sub *[]Item = items[0:1]\n"
		"\t_ = sub\n"
		"}\n")
	var src *[]readonly char = cb.Bytes()
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @ir.Module = ir.GenModule(file)

	var out @[]char = EmitModule(m)
	if !contains(out, "getelementptr") {
		return fail("expected getelementptr for struct slice expression")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitRefIncInline checks that OP_REFINC lowers to an inline
// nil-check + header load/add/store sequence, with no call to
// bn_pkg__builtins__rt__RefInc.
func TestEmitRefIncInline() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var ptr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	entry.EmitRefInc(ptr)

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if contains(out, "@bn_pkg__builtins__rt__RefInc(") {
		return fail("OP_REFINC should not lower to a call to bn_pkg__builtins__rt__RefInc")
	}
	if !contains(out, "icmp eq i8* ") {
		return fail("expected nil-check icmp")
	}
	if !contains(out, "ri.0.do:") {
		return fail("expected ri.0.do: label")
	}
	if !contains(out, "ri.0.skip:") {
		return fail("expected ri.0.skip: label")
	}
	if !contains(out, "i64 -16") {
		return fail("expected header offset -16")
	}
	if !contains(out, "load i64, i64*") {
		return fail("expected refcount load")
	}
	if !contains(out, "add i64 ") {
		return fail("expected refcount increment add")
	}
	if !contains(out, "store i64 ") {
		return fail("expected refcount store")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitRefDecInline checks that OP_REFDEC lowers to an inline
// nil-check + decrement + zero-check + slow-path call to
// bn_pkg__builtins__rt__ZeroRefDestroy. No call to bn_pkg__builtins__rt__RefDec.
func TestEmitRefDecInline() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var ptr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	entry.EmitRefDec(ptr)

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if contains(out, "@bn_pkg__builtins__rt__RefDec(") {
		return fail("OP_REFDEC should not lower to a call to bn_pkg__builtins__rt__RefDec")
	}
	if !contains(out, "icmp eq i8* ") {
		return fail("expected nil-check icmp")
	}
	if !contains(out, "rd.0.dec:") {
		return fail("expected rd.0.dec: label")
	}
	if !contains(out, "rd.0.destroy:") {
		return fail("expected rd.0.destroy: label")
	}
	if !contains(out, "rd.0.skip:") {
		return fail("expected rd.0.skip: label")
	}
	if !contains(out, "i64 -16") {
		return fail("expected header offset -16")
	}
	if !contains(out, "sub i64 ") {
		return fail("expected refcount decrement sub")
	}
	if !contains(out, "icmp eq i64 ") {
		return fail("expected zero-check on new refcount")
	}
	if !contains(out, "@bn_pkg__builtins__rt__ZeroRefDestroy(") {
		return fail("expected slow-path call to bn_pkg__builtins__rt__ZeroRefDestroy")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitRefDecInlineWithDtor verifies that OP_REFDEC with a dtor
// passes the dtor SSA reference (not `i8* null`) as the second arg
// to bn_pkg__builtins__rt__ZeroRefDestroy on the slow path.
func TestEmitRefDecInlineWithDtor() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var ptr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var dtor @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	entry.EmitRefDecDtor(ptr, dtor)

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "@bn_pkg__builtins__rt__ZeroRefDestroy(") {
		return fail("expected ZeroRefDestroy slow-path call")
	}
	// With-dtor form: second arg is an SSA register, not the literal
	// `i8* null` keyword. The no-dtor form would emit `i8* null)`.
	if contains(out, "@bn_pkg__builtins__rt__ZeroRefDestroy(i8* %v0, i8* null)") {
		return fail("dtor should be a register reference, not null")
	}
	if contains(out, ", i8* null)\n") {
		return fail("expected a register reference for dtor, got null")
	}
	var pass testing.TestResult
	return pass
}

func TestManagedSliceForInEmission() testing.TestResult {
	// for-in over @[]T uses extractvalue for len and data ptr,
	// then GEP for element access.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"main\"\n"
		"func main() {\n"
		"\tvar s @[]int = make_slice(int, 2)\n"
		"\ts[0] = 1\n"
		"\ts[1] = 2\n"
		"\tfor v in s { println(v) }\n"
		"}\n")
	var src *[]readonly char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue") {
		return fail("expected extractvalue for slice field access")
	}
	if !contains(out, "getelementptr") {
		return fail("expected getelementptr for slice element access")
	}
	var pass testing.TestResult
	return pass
}
