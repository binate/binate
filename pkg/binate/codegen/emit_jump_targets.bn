package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"

// jumpTargetError returns the internal error for f when one of its jumps or branches has
// a target that is not one of its blocks (irbuild.ForeignJumpError), or "".  The LLVM IR
// names a target by its function-local label, so such a target would reach f's own
// block of that label, or no block; emitFuncDbg panics with the error instead of
// emitting f.
func jumpTargetError(f @ir.Func) @[]char {
	var msg @[]char = irbuild.ForeignJumpError(f)
	if len(msg) == 0 { return "" }
	return buf.Concat("internal error: codegen: ", msg)
}
