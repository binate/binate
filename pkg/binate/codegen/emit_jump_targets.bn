package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"

// jumpTargetError returns the internal error for f when one of its jumps or branches has
// a target that is not one of its blocks (irbuild.ForeignJumpError), or "".  The LLVM IR
// names a target by its function-local label, so such a target would reach f's own
// block of that label, or no block; emitFuncDbg panics with the error instead of
// emitting f.
func jumpTargetError(f @ir.Func) @[]char {
	var msg @[]char = irbuild.ForeignJumpError(f)
	if len(msg) == 0 { return "" }
	return buf.Concat("internal error: codegen: ", msg)
}

// funcIRError returns the first internal error of f -- a phi predecessor (phiPredError), an
// operand (operandError) or a jump target (jumpTargetError) that is not one of f's -- or
// "".  emitFuncDbg panics with it instead of emitting f.
func funcIRError(f @ir.Func, values @irbuild.ModuleValues) @[]char {
	var msg @[]char = phiPredError(f)
	if len(msg) == 0 { msg = operandError(f, values) }
	if len(msg) == 0 { msg = jumpTargetError(f) }
	return msg
}

// operandError returns the internal error for f when one of its operands is not one of
// its own values (irbuild.ForeignOperandError; values is its module's
// irbuild.ModuleValues), or "".  The LLVM IR names an operand %v<id>, and ids restart at 0
// in every function, so another function's value would silently name f's value of that
// id; emitFuncDbg panics with the error instead of emitting f.
func operandError(f @ir.Func, values @irbuild.ModuleValues) @[]char {
	var msg @[]char = irbuild.ForeignOperandError(f, values)
	if len(msg) == 0 { return "" }
	return buf.Concat("internal error: codegen: ", msg)
}

// phiPredError returns the internal error for f when one of its phis has a predecessor
// that is not one of its blocks (irbuild.ForeignPhiPredError), or "".  The LLVM IR names
// a phi's predecessor by its function-local label (blockExitLabel), so such a
// predecessor would name f's own block of that label, or no block; emitFuncDbg panics
// with the error instead of emitting f.
func phiPredError(f @ir.Func) @[]char {
	var msg @[]char = irbuild.ForeignPhiPredError(f)
	if len(msg) == 0 { return "" }
	return buf.Concat("internal error: codegen: ", msg)
}
