package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for jumpTargetError and phiPredError: a function with a jump or branch whose
// target is not one of its blocks, or with a phi whose predecessor is not one, is an
// internal error, which emitFuncDbg panics with (so only the text, and EmitModule's
// taking a module whose targets are its own, can be observed here).

// llJumpFunc returns a function named name, `entry: jump body; body: branch then,
// other; then: return; other: return`, added to m (which keeps it alive while another
// function's jump names its blocks, as a module does in a compile), and its blocks.
func llJumpFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block) {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", name, noParams, noResults)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "body")
	bs[2] = ir.AddBlock(f, "then")
	bs[3] = ir.AddBlock(f, "other")
	var noVals @[]@ir.Instr
	irbuild.EmitJump(bs[0], bs[1])
	irbuild.EmitBranch(bs[1], irbuild.EmitConstBool(bs[1], true), bs[2], bs[3])
	irbuild.EmitReturn(bs[2], noVals)
	irbuild.EmitReturn(bs[3], noVals)
	m.AddFunc(f)
	return f, bs
}

// llTerm returns b's last instruction (its terminator).
func llTerm(b @ir.Block) @ir.Instr {
	return b.Instrs[len(b.Instrs) - 1]
}

// jumpErrorIs fails unless jumpTargetError(f) is want, prefixing the failure with what.
func jumpErrorIs(f @ir.Func, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var got @[]char = jumpTargetError(f)
	if seq(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(what, ": got error "), got))
}

// A module whose functions' targets are their own has no internal error, and EmitModule
// defines both functions.
func TestEmitModuleTakesOwnJumpTargets() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var g @ir.Func
	f, _ = llJumpFunc(m, "main.f")
	g, _ = llJumpFunc(m, "main.g")
	var r testing.TestResult = jumpErrorIs(f, "", "f's own targets")
	if len(r) > 0 { return r }
	r = jumpErrorIs(g, "", "g's own targets")
	if len(r) > 0 { return r }
	var out @[]char = EmitModule(m)
	if countSubstr(out, "define void @") != 2 { return "both functions should be defined" }
	if countSubstr(out, "br label %body.1") != 2 { return "each should jump to its body.1" }
	return ""
}

// A jump to another function's block -- here one whose label f also has, which the
// function-local label would silently name instead -- is an internal error.
func TestJumpTargetErrorOtherFunction() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var hb @[]@ir.Block
	_, hb = llJumpFunc(m, "main.h")
	llTerm(fb[0]).Block1 = hb[1]
	return jumpErrorIs(f,
			"internal error: codegen: a jump in main.f (block entry.0) has its target body.1 outside "
					"the function (a block of main.h)",
			"a jump to h's block")
}

// A jump with no target is an internal error (not a crash on the missing label).
func TestJumpTargetErrorNilTarget() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var none *ir.Block
	llTerm(fb[0]).Block1 = none
	return jumpErrorIs(f, "internal error: codegen: a jump in main.f (block entry.0) has no target",
			"a nil jump target")
}

// A branch whose else-block is another function's is an internal error.
func TestJumpTargetErrorForeignElseBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var hb @[]@ir.Block
	_, hb = llJumpFunc(m, "main.h")
	llTerm(fb[1]).Block2 = hb[3]
	return jumpErrorIs(f,
			"internal error: codegen: a branch in main.f (block body.1) has its else-block other.3 "
					"outside the function (a block of main.h)",
			"a foreign else-block")
}

// llPhiFunc returns a function named name, `entry: branch left, right; left: jump merge;
// right: jump merge; merge: p = phi [1, left], [2, right]; return p`, added to m (which
// keeps it alive while another function's phi names its blocks), its blocks and its phi.
func llPhiFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block, @ir.Instr) {
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, noParams, results)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "left")
	bs[2] = ir.AddBlock(f, "right")
	bs[3] = ir.AddBlock(f, "merge")
	irbuild.EmitBranch(bs[0], irbuild.EmitConstBool(bs[0], true), bs[1], bs[2])
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0].Block = bs[1]
	es[0].Val = irbuild.EmitConstInt(bs[1], 1, types.TypInt())
	es[1].Block = bs[2]
	es[1].Val = irbuild.EmitConstInt(bs[2], 2, types.TypInt())
	irbuild.EmitJump(bs[1], bs[3])
	irbuild.EmitJump(bs[2], bs[3])
	var p @ir.Instr = irbuild.EmitPhi(bs[3], types.TypInt(), es)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = p
	irbuild.EmitReturn(bs[3], rets)
	m.AddFunc(f)
	return f, bs, p
}

// phiErrorIs fails unless phiPredError(f) is want, prefixing the failure with what.
func phiErrorIs(f @ir.Func, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var got @[]char = phiPredError(f)
	if seq(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(what, ": got error "), got))
}

// A function whose phis name its own blocks has no internal error.
func TestPhiPredErrorNoneForOwnBlocks() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	f, _, _ = llPhiFunc(m, "main.f")
	return phiErrorIs(f, "", "f's own predecessors")
}

// A phi predecessor that is another function's block -- here one whose label f also
// has, which the function-local label would silently name instead -- is an internal
// error.
func TestPhiPredErrorOtherFunction() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var p @ir.Instr
	f, _, p = llPhiFunc(m, "main.f")
	var hb @[]@ir.Block
	_, hb, _ = llPhiFunc(m, "main.h")
	p.Phis[0].Block = hb[1]
	return phiErrorIs(f,
			"internal error: codegen: a phi in main.f (block merge.3) has its predecessor left.1 "
					"outside the function (a block of main.h)",
			"a predecessor in h")
}

// A phi entry with no predecessor is an internal error (not a crash on the missing
// label).
func TestPhiPredErrorNilPredecessor() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var p @ir.Instr
	f, _, p = llPhiFunc(m, "main.f")
	var none *ir.Block
	p.Phis[1].Block = none
	return phiErrorIs(f, "internal error: codegen: a phi in main.f (block merge.3) has no predecessor",
			"a nil predecessor")
}

// A phi predecessor that is one of the function's fault pads, which the LLVM backend
// never emits, is an internal error.
func TestPhiPredErrorFaultPad() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var p @ir.Instr
	f, _, p = llPhiFunc(m, "main.f")
	var pad @ir.Block = ir.AddFaultPad(f, "entry")
	irbuild.EmitUnwindReturn(pad)
	p.Phis[1].Block = pad
	return phiErrorIs(f,
			"internal error: codegen: a phi in main.f (block merge.3) has its predecessor entry.0 "
					"outside the function's blocks (a fault pad)",
			"a fault-pad predecessor")
}

// A branch to a block a pass dropped from f.Blocks -- one of f's, whose label no block
// emitted defines -- is an internal error, after a block is added to f.Blocks.
func TestJumpTargetErrorDroppedBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var kept @[]@ir.Block = make_slice(@ir.Block, 3)
	kept[0] = fb[0]
	kept[1] = fb[1]
	kept[2] = fb[2]
	f.Blocks = kept
	var noVals @[]@ir.Instr
	irbuild.EmitReturn(ir.AddBlock(f, "other"), noVals)
	return jumpErrorIs(f,
			"internal error: codegen: a branch in main.f (block body.1) has its else-block other.3 "
					"outside the function's blocks (a block dropped from them)",
			"a branch to a dropped block")
}

// A phi predecessor that is a block a pass dropped from f.Blocks is an internal error.
func TestPhiPredErrorDroppedBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb, _ = llPhiFunc(m, "main.f")
	var kept @[]@ir.Block = make_slice(@ir.Block, 3)
	kept[0] = fb[0]
	kept[1] = fb[2]
	kept[2] = fb[3]
	f.Blocks = kept
	return phiErrorIs(f,
			"internal error: codegen: a phi in main.f (block merge.3) has its predecessor left.1 "
					"outside the function's blocks (a block dropped from them)",
			"a dropped predecessor")
}
