package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for jumpTargetError: a function with a jump or branch whose target is not one of
// its blocks is an internal error, which emitFuncDbg panics with (so only the text, and
// EmitModule's taking a module whose targets are its own, can be observed here).

// llJumpFunc returns a function named name, `entry: jump body; body: branch then,
// other; then: return; other: return`, added to m (which keeps it alive while another
// function's jump names its blocks, as a module does in a compile), and its blocks.
func llJumpFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block) {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", name, noParams, noResults)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "body")
	bs[2] = ir.AddBlock(f, "then")
	bs[3] = ir.AddBlock(f, "other")
	var noVals @[]@ir.Instr
	irbuild.EmitJump(bs[0], bs[1])
	irbuild.EmitBranch(bs[1], irbuild.EmitConstBool(bs[1], true), bs[2], bs[3])
	irbuild.EmitReturn(bs[2], noVals)
	irbuild.EmitReturn(bs[3], noVals)
	m.AddFunc(f)
	return f, bs
}

// llTerm returns b's last instruction (its terminator).
func llTerm(b @ir.Block) @ir.Instr {
	return b.Instrs[len(b.Instrs) - 1]
}

// jumpErrorIs fails unless jumpTargetError(f) is want, prefixing the failure with what.
func jumpErrorIs(f @ir.Func, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var got @[]char = jumpTargetError(f)
	if seq(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(what, ": got error "), got))
}

// A module whose functions' targets are their own has no internal error, and EmitModule
// defines both functions.
func TestEmitModuleTakesOwnJumpTargets() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var g @ir.Func
	f, _ = llJumpFunc(m, "main.f")
	g, _ = llJumpFunc(m, "main.g")
	var r testing.TestResult = jumpErrorIs(f, "", "f's own targets")
	if len(r) > 0 { return r }
	r = jumpErrorIs(g, "", "g's own targets")
	if len(r) > 0 { return r }
	var out @[]char = EmitModule(m)
	if countSubstr(out, "define void @") != 2 { return "both functions should be defined" }
	if countSubstr(out, "br label %body.1") != 2 { return "each should jump to its body.1" }
	return ""
}

// A jump to another function's block -- here one whose label f also has, which the
// function-local label would silently name instead -- is an internal error.
func TestJumpTargetErrorOtherFunction() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var hb @[]@ir.Block
	_, hb = llJumpFunc(m, "main.h")
	llTerm(fb[0]).Block1 = hb[1]
	return jumpErrorIs(f,
			"internal error: codegen: a jump in main.f (block entry.0) has its target body.1 outside "
					"the function (a block of main.h)",
			"a jump to h's block")
}

// A jump with no target is an internal error (not a crash on the missing label).
func TestJumpTargetErrorNilTarget() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var none *ir.Block
	llTerm(fb[0]).Block1 = none
	return jumpErrorIs(f, "internal error: codegen: a jump in main.f (block entry.0) has no target",
			"a nil jump target")
}

// A branch whose else-block is another function's is an internal error.
func TestJumpTargetErrorForeignElseBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = llJumpFunc(m, "main.f")
	var hb @[]@ir.Block
	_, hb = llJumpFunc(m, "main.h")
	llTerm(fb[1]).Block2 = hb[3]
	return jumpErrorIs(f,
			"internal error: codegen: a branch in main.f (block body.1) has its else-block other.3 "
					"outside the function (a block of main.h)",
			"a foreign else-block")
}
