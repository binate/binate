package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// EmitLibInit's dispatcher must lower to `define void @bn_init()` — the mangler
// maps the DEFINITION name `<facade>.__bninit` to the reserved well-known
// bn_init (plan-ffi-export-detailed.md Phase 5a) — and each NON-own package init
// is registered as an extern `declare`.  contains / fail live in emit_test.bn.
func TestEmitLibInitLowersToBnInit() testing.TestResult {
	var m @ir.Module = ir.InitModule("\"ffiexp\"")
	m.PkgPath = "ffiexp"
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("rt.__init"))
	names = slices.Append[@[]char](names, buf.CopyStr("ffiexp.__init"))
	m.EmitLibInit(names)
	var out @[]char = EmitModule(m)
	// The dispatcher's DEFINITION is emitted under the reserved well-known symbol.
	if !contains(out, "define void @bn_init()") {
		return fail("EmitLibInit must lower to `define void @bn_init()`")
	}
	// A non-own package init is declared as an extern (so the cross-object call
	// resolves); the facade's own `__init` is skipped (defined locally).
	if !contains(out, "declare void @bn_F1_2_rt") {
		return fail("a non-own package init must be declared extern")
	}
	return ""
}
