package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// EmitLibInit's dispatcher must lower to `define void @bn_init()` — the mangler
// maps the DEFINITION name `<facade>.__bninit` to the reserved well-known
// bn_init — and each NON-own package init
// is registered as an extern `declare`.  contains / fail live in emit_test.bn.
func TestEmitLibInitLowersToBnInit() testing.TestResult {
	var m @ir.Module = ir.InitModule("\"ffiexp\"")
	m.PkgPath = "ffiexp"
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("rt.__init"))
	names = slices.Append[@[]char](names, buf.CopyStr("ffiexp.__init"))
	m.EmitLibInit(names)
	var out @[]char = EmitModule(m)
	// The dispatcher's DEFINITION is emitted under the reserved well-known symbol.
	if !contains(out, "define void @bn_init()") {
		return fail("EmitLibInit must lower to `define void @bn_init()`")
	}
	// A non-own package init is declared as an extern (so the cross-object call
	// resolves); the facade's own `__init` is skipped (defined locally).
	if !contains(out, "declare void @bn_F1_2_rt") {
		return fail("a non-own package init must be declared extern")
	}
	return ""
}

// bn_init is idempotency-guarded: its multi-block body (a net-new synthetic
// function shape) must lower to a run-once guard — a `__bninit_done` bool
// global, a conditional branch on its loaded value, and a `store i1 true` that
// marks it set before the init calls run.  This pins that the guard survives
// codegen (so a repeated bn_init() call is a no-op at the machine level).
func TestEmitLibInitIdempotencyGuardLowers() testing.TestResult {
	var m @ir.Module = ir.InitModule("\"ffiexp\"")
	m.PkgPath = "ffiexp"
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffiexp.__init"))
	m.EmitLibInit(names)
	var out @[]char = EmitModule(m)
	// The guard global is DEFINED in this module (not just referenced) under
	// the same mangled symbol the load/store reference.
	var guardSym @[]char = mangle.GlobalName("ffiexp", "__bninit_done")
	if !contains(out, buf.Concat("@", buf.Concat(guardSym, " = "))) {
		return fail("bn_init's __bninit_done guard global must be defined")
	}
	// The load and the store both reference that exact symbol as their pointer
	// operand (`i1* @<sym>`), so the guard read and write hit one cell.
	if !contains(out, buf.Concat("i1* @", guardSym)) {
		return fail("bn_init must load/store the __bninit_done guard by its symbol")
	}
	// entry conditionally branches on the loaded guard (i1 cond).
	if !contains(out, "br i1 ") {
		return fail("bn_init must conditionally branch on the guard")
	}
	// run materializes `true` (add i1 1, 0) and stores it to the guard before
	// the inits — so a re-entrant/repeat call sees it already set.
	if !contains(out, "add i1 1, 0") {
		return fail("bn_init must materialize `true` to mark the guard set")
	}
	if !contains(out, "store i1 ") {
		return fail("bn_init must store the guard value")
	}
	return ""
}
