package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for emit_lifetime.bn: llvm.lifetime markers on slots with a scope.

// siblingScopesSrc declares an array local in each of two sibling blocks.
func siblingScopesSrc() *[]readonly char {
	return "package \"main\"\n"
			"func use(k int) int {\n"
			"\tvar t int\n"
			"\t{\n\t\tvar a [8]int\n\t\ta[1] = k\n\t\tt = a[1]\n\t}\n"
			"\t{\n\t\tvar b [8]int\n\t\tb[2] = k\n\t\tt = t + b[2]\n\t}\n"
			"\treturn t\n"
			"}\n"
			"func main() {}\n"
}

// Each scoped local's lifetime starts at its declaration, before its zero-fill, and
// ends where its block is left and before the function's return; the module declares
// the intrinsics.
func TestLifetimeMarkersOnScopedLocals() testing.TestResult {
	var out @[]char = compileToLLVM(siblingScopesSrc())
	if !contains(out, "declare void @llvm.lifetime.start.p0(i64, ptr)\n") ||
			!contains(out, "declare void @llvm.lifetime.end.p0(i64, ptr)\n") {
		return fail("the module declares the lifetime intrinsics")
	}
	var use @[]char = llvmFuncBody(out, "use")
	if countOf(use, "call void @llvm.lifetime.start.p0(i64 -1, ptr %v") != 3 {
		return fail("t, a and b each start their lifetime")
	}
	// a and b where their blocks are left, then all three before the return.
	if countOf(use, "call void @llvm.lifetime.end.p0(i64 -1, ptr %v") != 5 {
		return fail("a and b end where their blocks are left, and t, a and b before the ret")
	}
	var ret int = indexOf(use, "\n  ret ")
	var lastEnd int = -1
	for i := 0; i + 30 < len(use); i++ {
		if use[i] == 'c' && contains(use[i:i + 30], "call void @llvm.lifetime.end") { lastEnd = i }
	}
	if ret < 0 || lastEnd < 0 || lastEnd > ret {
		return fail("the ends at the return come before the ret")
	}
	var start int = indexOf(use, "call void @llvm.lifetime.start.p0")
	var end int = indexOf(use, "call void @llvm.lifetime.end.p0")
	if start < 0 || end < start { return fail("a lifetime starts before it ends") }
	return ""
}

// placedCallSrc initializes a block-local struct returned in memory from a call.
func placedCallSrc() *[]readonly char {
	return "package \"main\"\n"
			"type Big struct { n int\n arr [40]int }\n"
			"func mk(k int) Big {\n"
			"\tvar b Big\n"
			"\tb.n = k\n"
			"\treturn b\n"
			"}\n"
			"func use(k int) int {\n"
			"\tvar t int\n"
			"\t{\n\t\tvar x Big = mk(k)\n\t\tt = x.n\n\t}\n"
			"\treturn t\n"
			"}\n"
			"func main() {}\n"
}

// A call writing its result straight into a local declared after it starts the
// local's lifetime on the line before the call, and the declaration starts it no
// second time.
func TestLifetimeStartsBeforePlacedCall() testing.TestResult {
	var use @[]char = llvmFuncBody(compileToLLVM(placedCallSrc()), "use")
	var call int = indexOf(use, "@bn_F1_4_main1_2_mk(")
	if call < 0 { return fail("setup: use calls mk") }
	var lineStart int = call
	for lineStart > 0 && use[lineStart - 1] != '\n' { lineStart = lineStart - 1 }
	var prev int = lineStart - 1
	for prev > 0 && use[prev - 1] != '\n' { prev = prev - 1 }
	if prev < 0 || !contains(use[prev:lineStart], "call void @llvm.lifetime.start.p0") {
		return fail("x's lifetime starts on the line before the call writing it")
	}
	if countOf(use, "call void @llvm.lifetime.start.p0") != 2 {
		return fail("t and x start once each: x's declaration starts it no second time")
	}
	return ""
}

// A module with no slot that has a scope declares no lifetime intrinsics.
func TestLifetimeDeclsOnlyWhenUsed() testing.TestResult {
	var out @[]char = compileToLLVM(
			"package \"main\"\nfunc f(k int) int { return k + 1 }\nfunc main() {}\n")
	if contains(out, "llvm.lifetime") { return fail("no scoped slot, no lifetime intrinsics") }
	return ""
}

// The local a function keeps in its caller's buffer (%v.retbuf) is no alloca and takes
// no lifetime markers.
func TestLifetimeNoMarkersOnRetbufLocal() testing.TestResult {
	var mk @[]char = llvmFuncBody(compileToLLVM(placedCallSrc()), "mk")
	if len(mk) == 0 { return fail("setup: mk is emitted") }
	if !contains(mk, "%v.retbuf") { return fail("setup: mk keeps b in its caller's buffer") }
	if contains(mk, "llvm.lifetime") {
		return fail("b, kept in the caller's buffer, takes no markers")
	}
	return ""
}

// loopExitsSrc leaves a loop body's block by continue, by break and by falling through.
func loopExitsSrc() *[]readonly char {
	return "package \"main\"\n"
			"func use(n int) int {\n"
			"\tvar t int\n"
			"\tfor i := 0; i < n; i++ {\n"
			"\t\tvar a [4]int\n"
			"\t\ta[0] = i\n"
			"\t\tif i == 1 { continue }\n"
			"\t\tif i == 3 { break }\n"
			"\t\tt = t + a[0]\n"
			"\t}\n"
			"\treturn t\n"
			"}\n"
			"func main() {}\n"
}

// A loop body's local starts each iteration and ends on every way out of the body:
// the fall-through, the continue and the break (and before the ret).
func TestLifetimeEndsOnLoopExits() testing.TestResult {
	var use @[]char = llvmFuncBody(compileToLLVM(loopExitsSrc()), "use")
	if countOf(use, "call void @llvm.lifetime.start.p0") != 3 { return fail("t, i and a each start") }
	// a: fall-through, continue, break; then t, i and a before the ret.
	if countOf(use, "call void @llvm.lifetime.end.p0") < 6 {
		return fail("a ends on the fall-through, the continue and the break, and all end at the ret")
	}
	return ""
}
