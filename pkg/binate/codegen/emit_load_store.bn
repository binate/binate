package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/std/strings"

// emitLoadInstr lowers an OP_LOAD: a memory-backed bulk value's private copy
// (emit_bulk_value.bn), an aggregate's per-leaf SSA load, or a scalar load.
func emitLoadInstr(out *strings.Builder, instr @ir.Instr) {
	if isBulkMem(instr) {
		emitBulkMemLoad(out, instr)
		return
	}
	// Aggregate-typed load: lower to per-scalar
	// GEP + load + insertvalue chain.  LLVM's ARM EABI backend
	// may lower a plain `load <T>, ptr` to `__aeabi_memcpy` for
	// large aggregates — threshold + behavior is LLVM-version-
	// dependent and not pinned by spec.  Decomposing here
	// removes that dependency (mirrors OP_STORE's aggregate
	// path; see emit_copy_ssa.bn).
	if isAggregateForStore(instr.Typ) {
		emitAggregateLoadIntoSSAInstr(out, instr, instr.Args[0])
		return
	}
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(llvmType(instr.Typ))
	out.Write(", ")
	out.Write(llvmType(instr.Typ))
	out.Write("* ")
	emitPtrRef(out, instr.Args[0])
	out.WriteByte('\n')
}

// emitStoreInstr lowers an OP_STORE: a byval-param spill, a memory-backed bulk
// value's copy (emit_bulk_value.bn), an aggregate's per-leaf SSA store, or a
// scalar store.
func emitStoreInstr(out *strings.Builder, instr @ir.Instr) {
	// Byval-param spill: the value (Args[1]) is a `ptr byval(<T>)`
	// param at the LLVM-IR level, not a struct value.  A plain
	// `store <T> <val>, ptr <slot>` type-mismatches.  Emit a
	// scalar-store sequence (one load+store per scalar leaf of
	// T's layout; one bulk copy, emitMemCopy, for a large T)
	// instead — semantically equivalent to byval's "callee gets
	// its own copy" contract, and decomposed so the LLVM backend
	// does not lower the spill to an `__aeabi_memcpy` call (on bare
	// metal, the runtime's byte loop).
	if instr.Args[1].IsByvalParamRef && instr.Args[1].Typ != nil {
		// The parameter's slot that IS its incoming copy has nothing to copy.
		if inPlaceParamID(instr.Args[0].ID) == instr.Args[1].ID { return }
		// idTag must be unique per OP_STORE so emitted SSA
		// names don't collide; OP_STORE itself is a void
		// instr (ID = -1).  The dst alloca is fresh per
		// byval-spill (one alloca per param), so its ID is
		// unique within the function.
		emitFieldwiseCopyInstr(out, instr.Args[0], instr.Args[1], instr.Args[1].Typ, instr.Args[0].ID)
		return
	}
	if isBulkMem(instr.Args[1]) {
		emitBulkMemStore(out, instr.Args[0], instr.Args[1])
		return
	}
	// Aggregate-typed store: lower to per-scalar
	// extractvalue + GEP + store sequence.  Avoids LLVM's
	// `store <T> %v, ptr` lowering of large aggregates to an
	// `__aeabi_memcpy` call on ARM EABI (on bare metal, the
	// runtime's byte loop).
	if isAggregateForStore(instr.Args[1].Typ) {
		emitAggregateStoreFromSSAInstr(out, instr.Args[0], instr.Args[1])
		return
	}
	var valTyp @[]char = llvmType(instr.Args[1].Typ)
	out.Write("store ")
	out.Write(valTyp)
	out.WriteByte(' ')
	emitValRef(out, instr.Args[1])
	out.Write(", ")
	out.Write(valTyp)
	out.Write("* ")
	emitPtrRef(out, instr.Args[0])
	out.WriteByte('\n')
}
