package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// loadStoreFunc returns a function with an int alloca `a` and a 4-leaf array
// alloca `r` (small — not bulk), for driving emitLoadInstr / emitStoreInstr.
func loadStoreFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, types.TypInt())
	var r @ir.Instr = irbuild.EmitAlloc(e, types.MakeArrayType(types.TypInt(), 4))
	return f, e, a, r
}

// A scalar load is one `load`; a scalar store one `store`.
func TestEmitLoadStoreInstrScalar() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var e @ir.Block
	var a @ir.Instr
	var r @ir.Instr
	f, e, a, r = loadStoreFunc()
	_ = r
	var v @ir.Instr = irbuild.EmitLoad(e, a, types.TypInt())
	irbuild.EmitStore(e, a, v)
	computeBulkMemValues(f, noFuncRetTypes())
	var sb @strings.Builder = strings.NewBuilder()
	emitLoadInstr(sb, v)
	var ld @[]char = buf.CopyStr(sb.String())
	if !contains(ld, " = load i64, i64* ") { return fail(buf.Concat("scalar load: ", ld)) }
	var sb2 @strings.Builder = strings.NewBuilder()
	emitStoreInstr(sb2, e.Instrs[len(e.Instrs) - 1])
	var st @[]char = buf.CopyStr(sb2.String())
	if !contains(st, "store i64 ") { return fail(buf.Concat("scalar store: ", st)) }
	return ""
}

// A small (non-bulk) aggregate load builds its SSA value per leaf, and the store
// of it writes it back per leaf — no runtime copy.
func TestEmitLoadStoreInstrSmallAggregate() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var e @ir.Block
	var a @ir.Instr
	var r @ir.Instr
	f, e, a, r = loadStoreFunc()
	_ = a
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 4)
	var v @ir.Instr = irbuild.EmitLoad(e, r, arr)
	irbuild.EmitStore(e, r, v)
	computeBulkMemValues(f, noFuncRetTypes())
	var sb @strings.Builder = strings.NewBuilder()
	emitLoadInstr(sb, v)
	emitStoreInstr(sb, e.Instrs[len(e.Instrs) - 1])
	var out @[]char = buf.CopyStr(sb.String())
	if !contains(out, "insertvalue") || !contains(out, "extractvalue") {
		return fail(buf.Concat("a small aggregate should load / store per leaf: ", out))
	}
	if contains(out, "MemCopy") { return fail("a small aggregate must not call rt.MemCopy") }
	return ""
}
