package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// SysV-AMD64 memory-class aggregate args (true LLVM `byval`)
// ============================================================
//
// A ≤16-byte aggregate ARGUMENT that does not fully fit in the remaining
// SysV-AMD64 argument registers (given its position) is MEMORY-classified: the
// WHOLE aggregate is passed by value on the outgoing stack, all-or-nothing
// (types.SysVArgInMemory / native argRegWordsStackWords).  The native x64
// backend already does this; clang emits a `byval(<T>)` parameter for it.
//
// The historical LLVM lowering coerced such an aggregate to a SPLITTABLE form
// (`[N x i64]` for a struct/array, the first-class `{i8*,i64}` / `{i8*,i8*}` for
// a slice / iface-value / func-value), which LLVM splits at a straddle — the
// first eightbyte in the last free GP reg, the rest on the stack — diverging
// from native (and the C ABI) at the native↔LLVM boundary.  For a memory-class
// argument codegen instead emits a TRUE `byval(<T>) align A` parameter, so LLVM
// lays the whole aggregate on the outgoing stack exactly as native + clang do.
//
// This is SysV-AMD64-only: AAPCS64 / AAPCS32 SPLIT a straddling aggregate and
// LLVM's coerced/first-class form splits the same way, so native and LLVM
// already agree there — codegen keeps coercing on those targets and consults the
// memory-class predicate only for the x64 target (aggMemClass gates on it).

// targetIsX64 reports whether the current target is x86-64 (SysV-AMD64), the
// only target where a straddling ≤16-byte aggregate is MEMORY-classified
// (all-or-nothing) rather than split.
func targetIsX64() bool {
	return types.GetTarget().Arch == types.ARCH_X64
}

// aggMemClass reports whether the aggregate at position `pos` of `argTypes`
// (which must already include any synthetic sret / data-ptr prefix, so the
// register positions match the native x64 walk) is a SysV memory-class aggregate
// on x64 — passed wholly on the stack by value.  Kind-agnostic: a named struct /
// array (coerced today) OR a slice / iface-value / func-value (2-word GP
// aggregate passed first-class today) — all of which straddle identically.
// False off x64 (AAPCS splits, so those targets already agree).
func aggMemClass(argTypes @[]@types.Type, pos int) bool {
	if !targetIsX64() { return false }
	if pos < 0 || pos >= len(argTypes) { return false }
	return types.SysVArgInMemory(argTypes, pos)
}

// largeAggByValue reports whether a >16-byte aggregate t (IsByvalParam) is passed BY
// VALUE, spelled `ptr byval(<T>)` — on x86-64 its bytes on the outgoing stack
// (SysV MEMORY class), on arm32 split across r0-r3 and the stack (AAPCS32; LLVM's
// ARM byval lowering places the words exactly as the by-value composite) — rather
// than as a plain pointer to a copy, which is AAPCS64's form.  The callee receives
// a pointer to its own copy either way.
func largeAggByValue(t @types.Type) bool {
	if !t.IsByvalParam() { return false }
	return targetIsX64() || types.GetTarget().PointerSize == 4
}

// aggPassedByval reports whether the aggregate at position pos of argTypes is
// passed `ptr byval(<T>)`: an x86-64 ≤16-byte memory-class straddle (aggMemClass)
// or a >16-byte aggregate on x86-64 / arm32 (largeAggByValue).  A shim or closure thunk
// forwards such an argument's incoming pointer with the byval spelling and must
// not `tail call` the underlying (anyInMem).
func aggPassedByval(argTypes @[]@types.Type, pos int) bool {
	if pos < 0 || pos >= len(argTypes) { return false }
	return aggMemClass(argTypes, pos) || largeAggByValue(argTypes[pos])
}

// aggArgFirstClassSmall reports whether t is a ≤16-byte aggregate that codegen
// passes FIRST-CLASS (a slice / iface-value / func-value — NOT a coerced named
// struct/array, NOT a >16 byval aggregate).  Such an arg has no coercion slot,
// so when it is memory-class it needs a byval spill slot allocated like the
// coerced path's — see emitAggCallAllocaDecls.
func aggArgFirstClassSmall(t @types.Type) bool {
	if t == nil { return false }
	if aggInRegCoercedKind(t) { return false }
	if t.IsByvalParam() { return false }
	return isAggregateArg(t)
}

// defineArgTypes builds the SysV argTypes list for f's DEFINE line: a leading
// pointer entry when f returns via sret (the sret buffer pointer rides RDI on
// SysV), then each declared param type.  Mirrors the native x64 callee walk
// (spillIncomingParams' paramTypes) so the register positions — and thus the
// memory-class decisions — agree.
func defineArgTypes(f @ir.Func, useSret bool) @[]@types.Type {
	var off int = 0
	if useSret { off = 1 }
	var ts @[]@types.Type = make_slice(@types.Type, len(f.Params) + off)
	if useSret { ts[0] = types.MakePointerType(types.TypUint8()) }
	for i := 0; i < len(f.Params); i++ {
		ts[i + off] = f.Params[i].Typ
	}
	return ts
}

// callArgTypes builds the SysV argTypes list for a direct OP_CALL: a leading
// pointer entry when the call passes an sret buffer in RDI (hasSretPrefix), then
// each argument's declared type.  Mirrors the native x64 caller walk
// (x64_call.bn emitCall's bigRet branch).
func callArgTypes(instr @ir.Instr, hasSretPrefix bool) @[]@types.Type {
	var off int = 0
	if hasSretPrefix { off = 1 }
	var ts @[]@types.Type = make_slice(@types.Type, len(instr.Args) + off)
	if hasSretPrefix { ts[0] = types.MakePointerType(types.TypUint8()) }
	for i := 0; i < len(instr.Args); i++ {
		ts[i + off] = instr.Args[i].Typ
	}
	return ts
}

// shimParamInMemory reports whether the func-value underlying's param i is a
// SysV memory-class aggregate, given whether the underlying call prepends an
// sret buffer pointer (sretPrefix — the aggregate-return C-sret shim does).  The
// shim receives every aggregate arg BY-ADDRESS, so a memory-class param is
// passed straight through to the underlying as `ptr byval(<T>) align 8` on the
// incoming pointer — no load, no split.
func shimParamInMemory(fvTyp @types.Type, sretPrefix bool, i int) bool {
	var off int = 0
	if sretPrefix {
		off = 1
	}
	var ts @[]@types.Type = make_slice(@types.Type, len(fvTyp.Params) + off)
	if sretPrefix {
		ts[0] = types.MakePointerType(types.TypUint8())
	}
	for k := 0; k < len(fvTyp.Params); k++ {
		ts[k + off] = fvTyp.Params[k].Type
	}
	return aggPassedByval(ts, i + off)
}

// shimInMemFlags returns, per func-value user arg, whether it is a SysV
// memory-class aggregate for a NON-capturing shim's underlying call (argTypes =
// [sret ptr?] + fvTyp.Params).  Passing a precomputed flag array to
// emitShimArgLoads / the underlying-arg loop decouples the shared shim emitters
// from the closure-vs-non-closure position math.
func shimInMemFlags(fvTyp @types.Type, sretPrefix bool) @[]bool {
	var flags @[]bool = make_slice(bool, len(fvTyp.Params))
	for i := 0; i < len(fvTyp.Params); i++ {
		flags[i] = shimParamInMemory(fvTyp, sretPrefix, i)
	}
	return flags
}

// closureInMemFlags returns the same per-user-arg memory-class flags for a
// CAPTURING closure shim.  The lifted underlying @<m>'s params are [captures...,
// user-args...], and its define-line (emitFuncDbg / defineArgTypes) byval's each
// memory-class one, so the shim must use the SAME positions: user arg i sits at
// f.Params[nCap + i] (nCap = the capture count = len(f.Params) - len(fvTyp.Params)).
func closureInMemFlags(f @ir.Func, fvTyp @types.Type, sretPrefix bool) @[]bool {
	var nCap int = len(f.Params) - len(fvTyp.Params)
	var argTypes @[]@types.Type = defineArgTypes(f, sretPrefix)
	var off int = 0
	if sretPrefix {
		off = 1
	}
	var flags @[]bool = make_slice(bool, len(fvTyp.Params))
	for i := 0; i < len(fvTyp.Params); i++ {
		flags[i] = aggPassedByval(argTypes, nCap + i + off)
	}
	return flags
}

// closureCaptureInMemFlags returns, per CAPTURE (the first NumCaptureParams
// params of the lifted closure @<m>), whether it is a SysV memory-class
// aggregate — the same position-aware decision the define-line byval's, but for
// the capture prefix rather than the trailing user args (closureInMemFlags).  A
// memory-class CAPTURE is passed straight through to the underlying as `ptr
// byval(<T>)` on its closure-struct field pointer; without this the shim would
// coerce it to a splittable `[N x iW]` (aggParamCoerced) while the underlying
// declares `byval`, a define/call ABI mismatch that miscompiles on x64 when a
// preceding capture prefix pushes the aggregate into the MEMORY class.
func closureCaptureInMemFlags(f @ir.Func, sretPrefix bool) @[]bool {
	var nCap int = f.NumCaptureParams
	var argTypes @[]@types.Type = defineArgTypes(f, sretPrefix)
	var off int = 0
	if sretPrefix {
		off = 1
	}
	var flags @[]bool = make_slice(bool, nCap)
	for i := 0; i < nCap; i++ {
		flags[i] = aggPassedByval(argTypes, i + off)
	}
	return flags
}

// anyInMem reports whether any of the shim's user args is memory-class (byval).
// A shim that passes a `byval` arg must NOT `tail call` the underlying: the
// byval copy lives in the shim's own frame, which a tail call would tear down
// before the callee reads it (a use-after-free crash) — so such a shim emits a
// regular `call`.
func anyInMem(inMemFlags @[]bool) bool {
	for i := 0; i < len(inMemFlags); i++ {
		if inMemFlags[i] {
			return true
		}
	}
	return false
}

// writeByvalMemType writes the DEFINITION / declaration spelling of a by-value
// memory parameter: `ptr byval(<T>) align <A>`.  On x86-64 A is 8 — SysV's
// MEMORY-class stack slot alignment, which clang also uses for every type Binate
// can express (types.AlignOf is bounded by 8), and the native x64 outgoing-args
// word alignment, so the LLVM and native stack slots agree.  On arm32 A is
// byvalArgAlign(t) (4 or 8): there it also decides whether the composite starts on
// an even core register (AAPCS32 C.3), exactly as for the by-value composite.
func writeByvalMemType(out *strings.Builder, t @types.Type) {
	var al int = 8
	if !targetIsX64() { al = byvalArgAlign(t) }
	out.Write("ptr byval(")
	out.Write(llvmType(t))
	out.Write(") align ")
	stringutils.WriteInt(out, al)
	return
}

// byvalArgAlign is the `align` of a by-value memory argument at a call site (and of
// an arm32 definition): t's alignment, at most 8, and on arm32 at least 4 — clang's
// AAPCS byval alignment.  LLVM's ARM byval lowering loads the r0-r3 part of the
// argument with word loads whatever the `align` says, so the pointer passed must be
// word-aligned (byvalSlotAlign, emitByvalRealign); an `align 4` composite starts on
// the next core register like a less-aligned one (AAPCS32 C.3).
func byvalArgAlign(t @types.Type) int {
	var al int = t.AlignOf()
	if al < 1 { al = 1 }
	if !targetIsX64() && al < 4 { al = 4 }
	if al > 8 { al = 8 }
	return al
}

// writeByvalSlotAlign writes `, align <A>` after the `alloca` of a slot a direct call
// may pass as a by-value memory argument of type t, when t's own alignment does not
// already make the slot as aligned as byvalArgAlign promises (arm32 only).
func writeByvalSlotAlign(out *strings.Builder, t @types.Type) {
	if !largeAggByValue(t) || targetIsX64() || t.AlignOf() >= byvalArgAlign(t) { return }
	out.Write(", align ")
	stringutils.WriteInt(out, byvalArgAlign(t))
}

// byvalSrcNeedsRealign reports whether a shim must copy a by-value memory argument
// of type t to a word-aligned temporary before passing it: on arm32 a pointer it does
// not own (a closure capture field, an incoming by-address argument) is only as
// aligned as t, and a less-than-word-aligned one would fault on the word loads LLVM
// makes from it (byvalArgAlign) on a strict-alignment target.
func byvalSrcNeedsRealign(t @types.Type) bool {
	return largeAggByValue(t) && !targetIsX64() && t.AlignOf() < byvalArgAlign(t)
}

// emitByvalRealign emits the word-aligned copy byvalSrcNeedsRealign calls for:
// `<dst> = alloca <T>, align <A>` and a bulk copy from src into it.  The output ends
// with the next line's indent.
func emitByvalRealign(out *strings.Builder, t @types.Type, dst *[]readonly char,
		src *[]readonly char) {
	out.Write(dst)
	out.Write(" = alloca ")
	out.Write(llvmType(t))
	writeByvalSlotAlign(out, t)
	out.WriteByte('\n')
	emitMemCopy(out, dst, src, t.SizeOf())
	out.Write("  ")
}

// writeByvalArgMemType writes the CALL-SITE spelling of a memory-class aggregate
// argument: `ptr byval(<T>) align <A>`, A = byvalArgAlign(t).  At a call site the
// `align` also promises the alignment of the pointer passed, which on x86-64 is only
// t's alignment for a capture field, a shim's incoming pointer or a private copy of a
// less-aligned type.  On x86-64 SysV still lays the copy in an 8-aligned stack slot
// whatever A is (LLVM's x86-64 convention passes byval with at least 8-byte
// alignment), so the callee's `align 8` view of its copy holds and the stack layout
// matches native; on arm32 A equals the definition's.
func writeByvalArgMemType(out *strings.Builder, t @types.Type) {
	out.Write("ptr byval(")
	out.Write(llvmType(t))
	out.Write(") align ")
	stringutils.WriteInt(out, byvalArgAlign(t))
	return
}

// writeMemByvalParamDefine writes a memory-class aggregate PARAM on a define
// line: `ptr byval(<T>) align 8 %vID.bv`.  The body's `%vID` (the aggregate
// value) is reconstructed from the byval pointer in the entry-block prologue
// (emitMemByvalParamReconstruct).
func writeMemByvalParamDefine(out *strings.Builder, id int, t @types.Type) {
	writeByvalMemType(out, t)
	out.WriteByte(' ')
	emitRef(out, id)
	out.Write(".bv")
	return
}

// emitMemByvalParamReconstruct emits the entry-block reconstruction of a
// memory-class aggregate param's `%S` value: the byval parameter `%vID.bv` is a
// pointer to the caller's on-stack copy, so `%vID = load <T>, ptr %vID.bv` binds
// the value the body references.  No alloca — the byval pointer IS the storage.
func emitMemByvalParamReconstruct(out *strings.Builder, id int, t @types.Type) {
	emitRef(out, id)
	out.Write(" = load ")
	out.Write(llvmType(t))
	out.Write(", ptr ")
	emitRef(out, id)
	out.Write(".bv\n  ")
	return
}

// emitMemByvalArgStore emits, BEFORE a call line, the store that fills a
// memory-class aggregate arg's byval copy: `store <T> <argval>, ptr
// %v<callID>.agA<i>`.  It reuses the same `.agA<i>` slot the coerced path
// allocates (an `[N x iW]` alloca of the same size — big enough and 8-aligned to
// hold the aggregate), so the alloca-hoist pass is unchanged; only what is
// stored and how the arg is spelled differ.  `arg` is the argument value SSA.
func emitMemByvalArgStore(out *strings.Builder, callID int, arg @ir.Instr, i int) {
	out.Write("store ")
	out.Write(llvmType(arg.Typ))
	out.WriteByte(' ')
	emitValRef(out, arg)
	out.Write(", ptr %v")
	stringutils.WriteInt(out, callID)
	out.Write(".agA")
	stringutils.WriteInt(out, i)
	out.Write("\n  ")
	return
}

// writeMemByvalArg writes a memory-class aggregate arg in a call's argument
// list: `ptr byval(<T>) align <A> %v<callID>.agA<i>` (the slot filled by
// emitMemByvalArgStore).  LLVM copies the pointee onto the outgoing stack,
// matching the native caller's memory placement.
func writeMemByvalArg(out *strings.Builder, callID int, t @types.Type, i int) {
	writeByvalArgMemType(out, t)
	out.Write(" %v")
	stringutils.WriteInt(out, callID)
	out.Write(".agA")
	stringutils.WriteInt(out, i)
	return
}

// writeCAbiParamType writes the platform C-ABI LLVM parameter type for a value of
// type `at` at position `pos` in the C argument sequence `argTypes` (which must
// include any synthetic leading entries — e.g. an sret buffer pointer — so the
// register cursor matches).  It is the shared source of truth for how the LLVM
// backend spells a C-boundary parameter, used by BOTH the __c_call declare
// (emit_ccall.bn) and the #[c_export] entry thunk (emit_cexport_thunk.bn):
//   - a >16-byte aggregate is `ptr byval(<T>)` on x86-64 (SysV MEMORY) and arm32
//     (AAPCS32 by value), a plain `ptr` on aarch64 (a pointer to a copy);
//   - a ≤16-byte aggregate that straddles the x86-64 register file after a
//     preceding arg is `ptr byval`;
//   - everything else is the coerced `[N x iW]` / plain scalar / pointer.
//
// NOTE: this spells an x86-64 SSE (float-containing) aggregate in the coerced GP
// `[N x iW]` form.  The __c_call path needs the SSE-SPLIT spelling to match its
// argument emitter, so it uses writeCCallParamType (emit_ccall.bn) instead; the
// #[c_export] thunk (emit_cexport_thunk.bn) still uses this GP form and its
// SSE-aggregate handling is a separate open item.
func writeCAbiParamType(out *strings.Builder, at @types.Type, argTypes @[]@types.Type, pos int) {
	if largeAggByValue(at) || aggMemClass(argTypes, pos) {
		writeByvalMemType(out, at)
	} else {
		writeParamTypeLLVM(out, at)
	}
}
