package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the SysV-AMD64 memory-class aggregate byval helpers
// (emit_mem_byval.bn): a ≤16-byte aggregate that straddles the reg/stack
// boundary is passed as a true LLVM `ptr byval(<T>) align 8` (whole aggregate on
// the outgoing stack, matching native + clang) rather than a splittable coerced
// value.  The end-to-end cross-backend agreement is pinned by conformance and
// the native↔LLVM flip harness; here we unit-test the type speller and the
// position-aware memory-class gate.

// twoI64Struct builds a named 16-byte {i64,i64} struct.
func twoI64Struct(name @[]char) @types.Type {
	return types.MakeStructType(name, fieldsTwo(types.TypInt64(), "a", types.TypInt64(), "b"))
}

// TestWriteByvalMemType checks the `ptr byval(<T>) align 8` spelling.
func TestWriteByvalMemType() testing.TestResult {
	setTarget64()
	var b @strings.Builder = strings.NewBuilder()
	writeByvalMemType(b, twoI64Struct("I2"))
	var got @[]readonly char = b.String()
	if !contains(got, "ptr byval(") {
		return fail("byval mem type must start with ptr byval(")
	}
	if !contains(got, ") align 8") {
		return fail("byval mem type must be align 8 (SysV outgoing-args word alignment)")
	}
	return ""
}

// TestAggMemClassX64 checks the position-aware memory-class gate on x64: a
// 16-byte struct that straddles (after a leading pointer + 4 i64 fill R9 alone)
// is memory-class; one that fits is not; and everything is inert off x64.
func TestAggMemClassX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var i64 @types.Type = types.TypInt64()
	var ptr @types.Type = types.MakePointerType(types.TypUint8())
	var i2 @types.Type = twoI64Struct("I2")

	// [ptr, i64,i64,i64,i64, I2]: I2 straddles R9 => memory-class.
	var straddle @[]@types.Type = make_slice(@types.Type, 6)
	straddle[0] = ptr
	straddle[1] = i64
	straddle[2] = i64
	straddle[3] = i64
	straddle[4] = i64
	straddle[5] = i2
	if !aggMemClass(straddle, 5) {
		return fail("a straddling 16-byte struct must be memory-class on x64")
	}

	// A raw slice (16-byte first-class 2-word GP aggregate) that straddles is
	// ALSO memory-class: aggMemClass is kind-agnostic, not struct/array-only, so
	// slices / iface- / func-values byval the same as a named struct.
	var slc @types.Type = types.MakeSliceType(types.TypInt())
	var slStraddle @[]@types.Type = make_slice(@types.Type, 6)
	slStraddle[0] = ptr
	slStraddle[1] = i64
	slStraddle[2] = i64
	slStraddle[3] = i64
	slStraddle[4] = i64
	slStraddle[5] = slc
	if !aggMemClass(slStraddle, 5) {
		return fail("a straddling raw slice must be memory-class on x64 (kind-agnostic)")
	}

	// [i64, I2]: I2 fits in RSI:RDX => not memory-class.
	var fits @[]@types.Type = make_slice(@types.Type, 2)
	fits[0] = i64
	fits[1] = i2
	if aggMemClass(fits, 1) {
		return fail("a fitting 16-byte struct must NOT be memory-class")
	}

	// Off x64 (aa64): memory-class byval is inert — AAPCS splits instead, so
	// codegen keeps coercing there.
	types.SetArch(types.ARCH_AA64)
	if aggMemClass(straddle, 5) {
		return fail("aggMemClass must be false off x64 (AAPCS splits)")
	}
	setTarget64()
	return ""
}

// On x86-64 a >16-byte by-value aggregate is SysV MEMORY class, as C passes it:
// the definition, a direct call and the func-value shim's forward all spell it
// `ptr byval(<T>) align 8`, and the shim CALLs the definition (no `tail call`: the
// byval copy is made in the shim's frame).
func TestEmitByvalLargeAggX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"type Big struct { a int; b int; c int }\n"
			"func sum(b Big) int { return b.a + b.b + b.c }\n"
			"func main() {\n"
			"\tvar x Big\n"
			"\tx.a = 1\n"
			"\tvar f *func(Big) int = sum\n"
			"\t_ = sum(x) + f(x)\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "@bn_F1_4_main1_3_sum(ptr byval(%bn_S1_4_main1_3_Big) align 8 %v0)") {
		return fail("the definition must take the >16-byte param `ptr byval(...) align 8`")
	}
	if !contains(out, "call i64 @bn_F1_4_main1_3_sum(ptr byval(%bn_S1_4_main1_3_Big) align 8 %v") {
		return fail("a direct call must pass the >16-byte arg `ptr byval(...) align 8`")
	}
	if !contains(out,
			"%r = call i64 @bn_F1_4_main1_3_sum(ptr byval(%bn_S1_4_main1_3_Big) align 8 %a0)") {
		return fail("the shim must forward its by-address arg `ptr byval(...) align 8 %a0` with a call")
	}
	return ""
}

// At a call site `align` also promises the alignment of the pointer passed, which
// for a 4-aligned [6]int32 is only 4 — from a direct call's slot, a func-value
// shim's incoming pointer, or a capture field at offset 4 behind an int32 capture.
// The call sites spell `align 4`; the definition keeps `align 8` (its stack copy
// is 8-aligned, as SysV places every byval argument).
func TestEmitByvalCallSiteAlignX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var src *[]readonly char = "package \"main\"\n"
			"func take(w [6]int32) int { return cast(int, w[1]) }\n"
			"func main() {\n"
			"\tvar arr [6]int32\n"
			"\tvar c int32 = 1\n"
			"\tvar f *func([6]int32) int = take\n"
			"\tvar g *func() int = func() int { return cast(int, c) + take(arr) }\n"
			"\t_ = take(arr) + f(arr) + g()\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "@bn_F1_4_main1_4_take(ptr byval([6 x i32]) align 8 %v0)") {
		return fail("the definition keeps `ptr byval([6 x i32]) align 8`")
	}
	if !contains(out, "call i64 @bn_F1_4_main1_4_take(ptr byval([6 x i32]) align 4 %v") {
		return fail("a direct call must spell the [6]int32 arg `align 4`")
	}
	if !contains(out, "@bn_F1_4_main1_4_take(ptr byval([6 x i32]) align 4 %a0)") {
		return fail("the shim must forward its incoming pointer `align 4`")
	}
	if !contains(out, "byval([6 x i32]) align 4 %cap1_ptr") {
		return fail("the closure shim must pass the capture field pointer `align 4`")
	}
	return ""
}
