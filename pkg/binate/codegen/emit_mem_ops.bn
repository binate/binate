package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Bulk zero-fill and copy.
//
// A large aggregate is zero-filled / copied by one operation, not per leaf
// (emit_copy.bn).  On a target without a C library (bare metal) that is a call
// to the runtime's rt.MemZero / rt.MemCopy (Binate, with an assembly rt.MemZero
// on aarch64), so the program needs no memset / memcpy.  On a hosted target it is the
// llvm.memset / llvm.memcpy intrinsic: clang understands those — it removes a
// copy into memory nothing reads, forwards a copy's bytes to a later load,
// splits a copied local into its fields, and emits a small one inline —
// whereas to clang an rt.MemCopy call is opaque.  What remains of the
// intrinsic after optimization may be a call to the C library's memcpy /
// memset, which a hosted target links anyway.  A copy whose regions may overlap
// (a whole store of a load reading its source in place) is rt.MemMove /
// llvm.memmove the same way.

// emitHosted reports whether the target has a C library (SetHosted).
var emitHosted bool

// SetHosted records whether the target has a C library, so that a bulk
// zero-fill / copy may be the llvm.memset / llvm.memcpy intrinsic (a hosted
// target) rather than a call to rt.MemZero / rt.MemCopy (bare metal).
func SetHosted(hosted bool) {
	emitHosted = hosted
}

// memIntrinsicSuffix returns the size-type suffix of the llvm.memcpy /
// llvm.memset intrinsic names for the target's int: `.i64` or `.i32`.
func memIntrinsicSuffix() @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.WriteByte('.')
	sb.Write(intLL())
	return buf.CopyStr(sb.String())
}

// emitMemZero emits the zero-fill of `size` bytes at the address dstRef, a
// line of its own.
func emitMemZero(out *strings.Builder, dstRef *[]readonly char, size int64) {
	if emitHosted {
		out.Write("  call void @llvm.memset.p0")
		out.Write(memIntrinsicSuffix())
		out.Write("(ptr ")
		out.Write(dstRef)
		out.Write(", i8 0, ")
	} else {
		out.Write("  call void @")
		out.Write(rtSym("MemZero"))
		out.Write("(i8* ")
		out.Write(dstRef)
		out.Write(", ")
	}
	out.Write(intLL())
	out.WriteByte(' ')
	stringutils.WriteInt64(out, size)
	if emitHosted { out.Write(", i1 false") }
	out.Write(")\n")
}

// emitMemCopy emits the copy of `size` bytes from the address srcRef to the
// address dstRef, a line of its own.  The two regions must not overlap.
func emitMemCopy(out *strings.Builder, dstRef *[]readonly char, srcRef *[]readonly char,
		size int64) {
	emitMemTransfer(out, "memcpy", "MemCopy", dstRef, srcRef, size)
}

// emitMemMove emits the copy of `size` bytes from the address srcRef to the
// address dstRef as if through a temporary, so the two regions may overlap: the
// llvm.memmove intrinsic on a hosted target, rt.MemMove on bare metal.
func emitMemMove(out *strings.Builder, dstRef *[]readonly char, srcRef *[]readonly char,
		size int64) {
	emitMemTransfer(out, "memmove", "MemMove", dstRef, srcRef, size)
}

// emitMemTransfer emits a call to the llvm.<intrinsic> intrinsic (hosted) or to the
// runtime's rt.<rtName> (bare metal) copying `size` bytes from srcRef to dstRef.
func emitMemTransfer(out *strings.Builder, intrinsic *[]readonly char, rtName *[]readonly char,
		dstRef *[]readonly char, srcRef *[]readonly char, size int64) {
	if emitHosted {
		out.Write("  call void @llvm.")
		out.Write(intrinsic)
		out.Write(".p0.p0")
		out.Write(memIntrinsicSuffix())
		out.Write("(ptr ")
		out.Write(dstRef)
		out.Write(", ptr ")
	} else {
		out.Write("  call void @")
		out.Write(rtSym(rtName))
		out.Write("(i8* ")
		out.Write(dstRef)
		out.Write(", i8* ")
	}
	out.Write(srcRef)
	out.Write(", ")
	out.Write(intLL())
	out.WriteByte(' ')
	stringutils.WriteInt64(out, size)
	if emitHosted { out.Write(", i1 false") }
	out.Write(")\n")
}

// emitMemIntrinsicDecls declares, on a hosted target, the llvm.memcpy,
// llvm.memmove and llvm.memset intrinsics emitMemCopy / emitMemMove / emitMemZero
// call.
func emitMemIntrinsicDecls(out *strings.Builder) {
	if !emitHosted { return }
	out.Write("declare void @llvm.memcpy.p0.p0")
	out.Write(memIntrinsicSuffix())
	out.Write("(ptr, ptr, ")
	out.Write(intLL())
	out.Write(", i1)\n")
	out.Write("declare void @llvm.memmove.p0.p0")
	out.Write(memIntrinsicSuffix())
	out.Write("(ptr, ptr, ")
	out.Write(intLL())
	out.Write(", i1)\n")
	out.Write("declare void @llvm.memset.p0")
	out.Write(memIntrinsicSuffix())
	out.Write("(ptr, i8, ")
	out.Write(intLL())
	out.Write(", i1)\n")
}
