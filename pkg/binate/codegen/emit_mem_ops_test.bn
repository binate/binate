package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// On a hosted target a bulk zero-fill / copy is the llvm.memset / llvm.memcpy
// intrinsic, sized by the target's int; without a C library it is a call to
// rt.MemZero / rt.MemCopy.
func TestEmitMemOpsHosted() testing.TestResult {
	setTarget64()
	SetHosted(true)
	var sb @strings.Builder = strings.NewBuilder()
	emitMemZero(sb, "%d", 100)
	emitMemCopy(sb, "%d", "%s", 100)
	var hosted64 @[]char = buf.CopyStr(sb.String())
	setTarget32()
	var sb2 @strings.Builder = strings.NewBuilder()
	emitMemCopy(sb2, "%d", "%s", 100)
	var hosted32 @[]char = buf.CopyStr(sb2.String())
	setTarget64()
	SetHosted(false)
	var sb3 @strings.Builder = strings.NewBuilder()
	emitMemZero(sb3, "%d", 100)
	emitMemCopy(sb3, "%d", "%s", 100)
	var bare @[]char = buf.CopyStr(sb3.String())
	if !contains(hosted64, "call void @llvm.memset.p0.i64(ptr %d, i8 0, i64 100, i1 false)") ||
			!contains(hosted64, "call void @llvm.memcpy.p0.p0.i64(ptr %d, ptr %s, i64 100, i1 false)") {
		return fail(buf.Concat("hosted LP64: the intrinsics: ", hosted64))
	}
	if !contains(hosted32, "call void @llvm.memcpy.p0.p0.i32(ptr %d, ptr %s, i32 100, i1 false)") {
		return fail(buf.Concat("hosted ILP32: the i32 intrinsic: ", hosted32))
	}
	if contains(bare, "@llvm.") || !contains(bare, rtSym("MemZero")) ||
			!contains(bare, rtSym("MemCopy")) {
		return fail(buf.Concat("bare metal: the rt calls: ", bare))
	}
	return ""
}

// A hosted module declares the two intrinsics; one without a C library does not.
func TestEmitMemIntrinsicDecls() testing.TestResult {
	setTarget64()
	SetHosted(true)
	var hosted @[]char = compileToLLVM("package \"main\"\nfunc main() {}\n")
	SetHosted(false)
	var bare @[]char = compileToLLVM("package \"main\"\nfunc main() {}\n")
	if !contains(hosted, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)") ||
			!contains(hosted, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)") {
		return fail("a hosted module declares llvm.memcpy and llvm.memset")
	}
	if contains(bare, "@llvm.memcpy") || contains(bare, "@llvm.memset") {
		return fail("a module without a C library declares neither")
	}
	return ""
}
