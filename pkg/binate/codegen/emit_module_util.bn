package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitCExportAliases emits an LLVM `alias` per `#[c_export("name")]` on f, so the
// function is reachable from C under each unmangled name in addition to its
// mangled `bn_` symbol (the mangled define is untouched).  The aliasee-type is a
// placeholder `i8`: LLVM does not require it to match the function type for a
// same-module alias (verified against clang across scalar / aggregate / sret /
// pointer-param returns), and the alias is only a symbol-table entry pointing at
// the function entry, which already carries the platform C ABI.  clang applies
// the target's symbol prefix (e.g. Mach-O's leading `_`) to the alias name just
// as it does to the function, so the C name resolves.  Externs have no body to
// alias.
func emitCExportAliases(out *strings.Builder, f @ir.Func) {
	if f.IsExtern {
		return
	}
	for i := 0; i < len(f.CExportNames); i++ {
		writeLLVMQuotedName(out, f.CExportNames[i])
		out.Write(" = alias i8, ptr @")
		out.Write(mangle.FuncName(modulePkgName, f.Name))
		out.WriteByte('\n')
	}
}

// writeLLVMQuotedName writes `name` as an LLVM quoted global identifier
// (`@"..."`).  `"`, `\`, and any non-printable-ASCII byte are emitted as LLVM's
// `\HH` hex escape, so an unusual (but permitted, per the permissive c_export
// name policy) name stays valid LLVM syntax instead of a clang parse error —
// matching the native backends, which accept arbitrary bytes in a symbol name.
func writeLLVMQuotedName(out *strings.Builder, name *[]readonly char) {
	out.Write("@\"")
	for i := 0; i < len(name); i++ {
		var c char = name[i]
		if c == cast(char, 34) || c == cast(char, 92) || c < ' ' || c > '~' {
			out.WriteByte(cast(char, 92)) // backslash
			out.WriteByte(hexNibbleUpper(cast(int, c) / 16))
			out.WriteByte(hexNibbleUpper(cast(int, c) % 16))
		} else {
			out.WriteByte(c)
		}
	}
	out.WriteByte(cast(char, 34)) // closing double-quote
}

// hexNibbleUpper returns the uppercase hex digit for n in [0, 15].
func hexNibbleUpper(n int) char {
	if n < 10 {
		return cast(char, cast(int, '0') + n)
	}
	return cast(char, cast(int, 'A') + (n - 10))
}

// FuncRetType records the LLVM return-type string for one mangled func
// name (Name) so call sites can spell the call correctly. IsSret marks
// callees that return their aggregate result via an X8/sret pointer
// instead of in registers.
type FuncRetType struct {
	Name    @[]char
	RetType @[]char
	IsSret  bool
}

// Struct type definitions for LLVM named types
type StructDef struct {
	Name        @[]char // Binate struct name (e.g., "Point")
	MangledName @[]char // mangled LLVM name, cached to avoid re-mangling on lookup
	Fields      @[]@types.Type // field types
	Typ         @types.Type // original struct type (for layout computation)
}

// moduleStructDefs accumulates StructDefs encountered during EmitModule
// so the module preamble can emit each named LLVM struct once. Reset at
// the start of every EmitModule call.
var moduleStructDefs @[]StructDef

// lookupRetType finds the LLVM return type string for a function by mangled name.
func lookupRetType(funcRetTypes *[]FuncRetType, name *[]readonly char) @[]char {
	for i := 0; i < len(funcRetTypes); i++ {
		if charsEqual(funcRetTypes[i].Name, name) {
			return funcRetTypes[i].RetType
		}
	}
	return ""
}

// lookupIsSret checks whether a function uses sret (indirect return) convention.
func lookupIsSret(funcRetTypes *[]FuncRetType, name *[]readonly char) bool {
	for i := 0; i < len(funcRetTypes); i++ {
		if charsEqual(funcRetTypes[i].Name, name) {
			return funcRetTypes[i].IsSret
		}
	}
	return false
}

// strBlobSym builds the LLVM symbol name `.str.<id>` for a string constant's
// byte blob (emitDataGlobal prepends `@`).
func strBlobSym(id int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".str.")
	stringutils.WriteInt(b, id)
	return buf.CopyStr(b.String())
}

// strMSSym builds the LLVM symbol name `.str.<id>.ms` for a string constant's
// static managed-slice header.
func strMSSym(id int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".str.")
	stringutils.WriteInt(b, id)
	b.Write(".ms")
	return buf.CopyStr(b.String())
}

// emitStringGlobal emits a string constant as a byte blob + a static
// managed-slice header, both via the shared ir.Build* builders so the layout
// matches the native backend and cannot drift.
func emitStringGlobal(out *strings.Builder, sc ir.StringConst) {
	// Byte blob `@.str.<id> = private unnamed_addr constant [N x i8] c"..."`.
	emitDataGlobal(out, irdata.BuildStringBlob(strBlobSym(sc.ID), sc.Data))
	// Static managed-slice header `@.str.<id>.ms` = { data, len, null, len }
	// aliasing the blob; an anonymous `{ ptr, iN, ptr, iN }` (was the named
	// %BnManagedSlice — its typed `load` consumers resolve identically under
	// opaque pointers).  LLVM keeps it private (resolved intra-module).
	emitDataGlobal(out,
			irdata.BuildStringMSHeader(strMSSym(sc.ID), strBlobSym(sc.ID), sc.Len, irdata.DG_LOCAL))
	return
}

// emitStringBytes writes string data as LLVM IR c"..." byte content, escaping special chars.
func emitStringBytes(out *strings.Builder, data *[]readonly char) {
	for i := 0; i < len(data); i++ {
		var c char = data[i]
		if c == '\n' {
			out.Write("\\0A")
		} else if c == '\r' {
			out.Write("\\0D")
		} else if c == '\t' {
			out.Write("\\09")
		} else if c == '"' {
			out.Write("\\22")
		} else if c == '\\' {
			out.Write("\\5C")
		} else if cast(int, c) < 32 || cast(int, c) > 126 {
			// Hex escape
			out.WriteByte('\\')
			stringutils.WriteHexByte(out, cast(int, c))
		} else {
			out.WriteByte(c)
		}
	}
	return
}

// writeComdatDecl emits a top-level `$<name> = comdat any` for a weak_odr
// symbol when COMDAT emission is enabled (ELF/COFF targets — Mach-O rejects
// COMDATs).  The matching definition carries a `comdat` keyword / `, comdat`
// so the linker keeps ONE copy across TUs; current GNU ld reports "multiple
// definition" for duplicate plain-weak defs, which a COMDAT group resolves.
func writeComdatDecl(out *strings.Builder, name *[]readonly char) {
	if emitUseComdat {
		out.Write("$")
		out.Write(name)
		out.Write(" = comdat any\n")
	}
}

// writeShimComdatDecl is writeComdatDecl for a `__shim.`-prefixed symbol (the
// func-value / closure / dtor shims), whose full name is `__shim.<mangled>`.
func writeShimComdatDecl(out *strings.Builder, mangled *[]readonly char) {
	if emitUseComdat {
		out.Write("$__shim.")
		out.Write(mangled)
		out.Write(" = comdat any\n")
	}
}

// writeComdatAttr emits the ` comdat` function-header keyword (after the fn
// attributes) when COMDAT emission is enabled.
func writeComdatAttr(out *strings.Builder) {
	if emitUseComdat {
		out.Write(" comdat")
	}
}
