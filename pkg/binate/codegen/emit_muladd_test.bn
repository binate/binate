package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Lowering tests for the fused multiply-add (OP_MADD / OP_MSUB).  They compile at
// -O1 so the iropt fuse-mul-add pass fires and the backend actually emits the
// fused form — at -O0 no OP_MADD is created and emitMulAdd never runs.  These
// pin, in particular, that the operation TYPE is present (a regression once
// emitted null bytes for the type because llvmType's managed result was held in a
// raw-slice local that dangled after the first use).

// `a*b + c` fuses; emitMulAdd emits `%v<id>.p = mul <ty> a, b` then
// `%v<id> = add <ty> %v<id>.p, c`.  The `.p = mul i64` substring pins both that
// fusion happened AND that the type is emitted correctly (not null bytes).
func TestEmitMaddLLVM() testing.TestResult {
	var out @[]char = compileToLLVMOpt(
			"package \"main\"\nfunc f(a int, b int, c int) int { return a * b + c }\n", 1)
	if !contains(out, ".p = mul i64 ") {
		return fail("expected a well-typed fused-multiply product `.p = mul i64` at -O1")
	}
	if !contains(out, " = add i64 ") {
		return fail("expected the fused add for OP_MADD")
	}
	return ""
}

// `c - a*b` fuses to OP_MSUB → `%v<id> = sub <ty> c, %v<id>.p`.
func TestEmitMsubLLVM() testing.TestResult {
	var out @[]char = compileToLLVMOpt(
			"package \"main\"\nfunc f(a int, b int, c int) int { return c - a * b }\n", 1)
	if !contains(out, ".p = mul i64 ") {
		return fail("expected a well-typed fused-multiply product `.p = mul i64` at -O1")
	}
	if !contains(out, " = sub i64 ") {
		return fail("expected the fused sub for OP_MSUB")
	}
	return ""
}

// Nothing fuses at -O0, so the fused product temp must be absent — the ordinary
// mul+add path is emitted instead (guards against the pass running unconditionally).
func TestNoFuseAtO0LLVM() testing.TestResult {
	var out @[]char = compileToLLVMOpt(
			"package \"main\"\nfunc f(a int, b int, c int) int { return a * b + c }\n", 0)
	if contains(out, ".p = mul") {
		return fail("no fusion should occur at -O0")
	}
	return ""
}
