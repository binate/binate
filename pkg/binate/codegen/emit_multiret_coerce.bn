package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Multi-return tuple RETURN-ABI bridge (register-returned tuples)
// ============================================================
//
// A multi-return tuple returned in registers (NOT sret) is built as the raw
// PACKED `<{T0, T1, …}>` aggregate (anonStructLL — byte layout matching
// types.FieldOffset, needed for the in-memory dtor/sret/copy paths).  But that
// packed form is WRONG as a first-class-aggregate RETURN type: LLVM gives each
// explicit `[N x i8]` padding member its OWN return register, and on AArch64 a
// `[N x i8]`-padded struct FIELD makes return legalization fall back to sret (x8).
// Either way the register layout diverges from what the NATIVE caller expects
// (which classifies the tuple as register-returned by word count and reads each
// field by position), so a native↔LLVM multi-return boundary corrupts / faults.
//
// The bridge reinterprets the raw packed tuple to a FLAT, padding-member-free
// boundary type at the ret/call boundary (store raw packed -> shared slot -> load
// flat -> ret/call flat; the two share bytes, so the reinterpret is lossless).  The
// flat boundary type (multiReturnCoercedLLTy) spells each field as its plain
// llvmType, EXCEPT on AArch64 AND arm32 (multiRetCoercionActive) where a struct/array
// field is `[N x iW]`-coerced (aggCoerceLLTy) to dodge the sret fallback above.  Two
// independent triggers put a tuple on the bridge: a coercible struct/array field
// (multiRetTypeHasCoercibleField, on those targets) or ANY padding member
// (multiRetHasPadding), on any arch.
//
// The func-value path does NOT use this bridge for its retbuf (memory, packed is
// correct there) — see writeFuncResultsLLVM — but the shim's UNDERLYING call spells
// the same flat boundary (multiRetResultsCoerced / multiReturnCoercedLLTyResults) so
// it agrees with the bridged callee `define`.

// multiRetCoercionActive reports whether register-returned multi-return tuples
// field-coerce a struct/array field to `[N x iW]` (W = the field's alignment-derived
// element size — aggCoerceElemBytes: i64 on LP64, and on ILP32 i64 for an 8-aligned
// field else i32) on the CURRENT target.  Active on every real backend (AArch64 /
// AAPCS64, arm32 / AAPCS32, x64 / SysV): an UNCOERCED struct/array field in a register-
// returned tuple makes LLVM's return lowering EXPAND that field differently than the
// native caller's per-field word collect, so the two disagree at the native<->LLVM
// boundary.  The divergence is per-target but the same class:
//   - aa64: a `[N x i8]`-padded struct member falls back to sret (x8).
//   - arm32: a nested struct whose leaves flatten to > 4 legalized parts is sret'd (an
//     r0 buffer) while native classifies register-return by word count — e.g. `(St,int)`
//     with St = `{bool,int,int}` → i1 + [3 x i8] + i32 + i32 = 6 parts (conformance 1119).
//   - x64: LLVM returns a first-class integer aggregate as ONE GP register PER i32/i64
//     LEAF (`{i32, P{i32,i32}}` → EAX, EDX, ECX), but native reads an 8-byte aggregate
//     field as ONE 8-byte word register — so the second leaf lands in the wrong register
//     (`(int32, P)` → P.y read from RDX-high instead of ECX → garbage; conformance 1138).
// Coercing each such field to `[N x iW]` (no sub-word / multi-leaf expansion) makes LLVM
// return it in exactly ceil(size/W) word registers, matching native's collect on all
// three.  (The separate padding-member bridge — multiRetHasPadding — applies on every
// arch and is NOT gated by this.)
func multiRetCoercionActive() bool {
	var arch int = types.GetTarget().Arch
	return arch == types.ARCH_AA64 || arch == types.ARCH_ARM32 || arch == types.ARCH_X64
}

// multiRetTypeHasCoercibleField reports whether the multi-return tuple `t` has at
// least one field that would be `[N x iW]`-coerced — i.e. a struct/array whose
// first-class LLVM form can diverge from the native word packing.  When false,
// the coerced spelling equals the raw one, so no coercion is emitted (a pure
// scalar/iface/float tuple like `(int, @Error)` is unaffected).
func multiRetTypeHasCoercibleField(t @types.Type) bool {
	if t == nil { return false }
	if !multiRetCoercionActive() { return false }
	for i := 0; i < len(t.Fields); i++ {
		if aggInRegCoercedKind(t.Fields[i].Type) { return true }
	}
	return false
}

// multiRetHasPadding reports whether the multi-return tuple `t` carries ANY
// explicit `[N x i8]` padding MEMBER in its PACKED LLVM emission (anonStructLL) —
// either a field preceded by alignment padding (StructLayout PaddingBefore > 0,
// e.g. the int64 in `(int32, int64)` at offset 8, or the `@Error` in `(bool,
// @Error)` at offset 4) OR trailing padding to the tuple's alignment (t.Trailing-
// Padding() > 0, e.g. the 4 bytes after `(int64, int32)`).  When such a tuple is
// register-returned as a first-class aggregate, LLVM gives each `[N x i8]` member
// its OWN return register — a leading/interior pad shifts a real field off the
// register the native caller reads it from, and even a trailing pad member makes
// LLVM's arm32 backend lower the return incompatibly with native's plain register
// layout (empirically: `(int64,int32)` → `<{i64,i32,[4 x i8]}>` hangs, while a pad-
// free `(f64,f64)` → `<{double,double}>` round-trips fine).  So a padded tuple must
// go through the flat-FCA reinterpret bridge on EVERY arch.  A tuple with NO padding
// members returns its raw packed form directly — its register layout matches native.
func multiRetHasPadding(t @types.Type) bool {
	if t == nil { return false }
	var layout @[]types.FieldLayout = t.StructLayout()
	for i := 0; i < len(layout); i++ {
		if layout[i].PaddingBefore > 0 { return true }
	}
	return t.TrailingPadding() > 0
}

// multiRetNeedsFlatFCA reports whether a register-returned multi-return tuple `t`
// must be reinterpreted to a flat (padding-member-free) FCA boundary type instead
// of returned as its raw PACKED form: true when it has a field the aa64 quirk
// coerces to `[N x iW]` (multiRetTypeHasCoercibleField) OR any padding member
// (multiRetHasPadding).  Either makes the raw packed FCA disagree with the native
// caller's per-field register layout.  A tuple with neither (only word-aligned
// fields, no trailing pad) returns its raw packed form directly.
func multiRetNeedsFlatFCA(t @types.Type) bool {
	return multiRetTypeHasCoercibleField(t) || multiRetHasPadding(t)
}

// funcMultiRetCoerced reports whether f returns a multi-value tuple that is
// register-returned (NOT sret) AND needs the flat-FCA boundary (multiRetNeedsFlatFCA
// — an aa64-coercible field, or any padding member on any arch), so its LLVM return
// type is the flat boundary tuple (multiReturnCoercedLLTy) reinterpreted from the
// raw packed build.  Combines the register-vs-sret decision (multiRetNeedsSret)
// with the flat-FCA test.
func funcMultiRetCoerced(f @ir.Func) bool {
	if len(f.Results) <= 1 || f.MultiReturnType == nil { return false }
	if multiRetNeedsSret(f) { return false }
	return multiRetNeedsFlatFCA(f.MultiReturnType)
}

// callMultiRetCoerced is the OP_CALL counterpart of funcMultiRetCoerced: the call's
// result tuple (ins.Typ) is a register-returned multi-return that needs the flat-FCA
// boundary, so the call line spells the flat boundary type and the result is
// reinterpreted back to the raw packed tuple for the downstream extracts.
func callMultiRetCoerced(ins @ir.Instr) bool {
	if ins == nil || !common.IsMultiReturnCall(ins) { return false }
	if callConvForTarget().MultiReturnTupleNeedsSret(ins.Typ) { return false }
	return multiRetNeedsFlatFCA(ins.Typ)
}

// multiRetResultsCoerced is the results-list counterpart of funcMultiRetCoerced
// (used by the func-value shim, whose signature is a @Type result list, not an
// @ir.Func): a register-returned multi-return that needs the flat-FCA boundary.
func multiRetResultsCoerced(results @[]@types.Type) bool {
	if len(results) <= 1 { return false }
	if multiRetResultsNeedSret(results) { return false }
	return multiRetNeedsFlatFCA(multiReturnTupleType(results))
}

// multiReturnCoercedLLTyResults writes the flat boundary tuple type for a results
// list (the func-value-shim counterpart of multiReturnCoercedLLTy).
func multiReturnCoercedLLTyResults(out *strings.Builder, results @[]@types.Type) {
	multiReturnCoercedLLTy(out, multiReturnTupleType(results))
}

// writeShimResultLLTy writes the result type a func-value / capturing-closure shim
// must spell for its underlying-call return, its %retbuf reinterpret, and its store:
// the flat coerced multi-return boundary (multiReturnCoercedLLTyResults) when
// `coerced` (a register-returned padded / aa64-coercible multi-return, per
// multiRetResultsCoerced), else the raw result type (writeFuncResultsLLVM).  BOTH
// shims MUST route through this so they agree with the underlying coerced `define`
// (funcMultiRetCoerced); if a shim spells the raw packed `<{…[N x i8]…}>` against a
// flat-boundary callee, the padding member claims its own return register and the
// wide field is read from the wrong slot — a silent miscompile (the closure shim
// carried exactly that divergence, since d72f7154 coerced the define + the
// func-value shim but not the closure shim).
func writeShimResultLLTy(out *strings.Builder, fvTyp @types.Type, coerced bool) {
	if coerced {
		multiReturnCoercedLLTyResults(out, fvTyp.Results)
	} else {
		writeFuncResultsLLVM(out, fvTyp)
	}
}

// multiReturnCoercedLLTy writes the flat (padding-member-free) LLVM boundary type
// for a register-returned multi-return tuple: `{ <field0>, <field1>, … }` — the
// FLAT `{...}` convention multi-returns use (see aggInRegCoercedKind's comment).
// The crucial property vs the raw PACKED tuple (anonStructLL) is the ABSENCE of
// explicit `[N x i8]` padding MEMBERS: those would each claim a first-class-return
// register and desync a native caller.  Each field is its plain llvmType, EXCEPT on
// aa64 AND arm32 (multiRetCoercionActive), where a struct/array field is spelled as
// its `[N x iW]` coerced form (aggCoerceLLTy) — dodging LLVM's sret fallback for such
// a field (the aa64 `[N x i8]`-padded-member quirk; the arm32 >4-legalized-parts
// rule); on x64 a struct field stays its `%name` (x64's own SysV eightbyte coercion
// handles it).  The `[N x iW]` element size is alignment-aware (aggCoerceElemBytes),
// so a WORD-MULTIPLE / 8-aligned coerced field lands at its raw FieldOffset — byte-
// identical to the raw tuple, and the return/call reinterprets through a shared slot
// are layout-exact.  CAVEAT: a SUB-WORD-sized aggregate field (SizeOf not a multiple
// of the coerced element width — e.g. `[3]int8` → `[1 x i32]`) is word-ROUNDED, which
// shifts a FOLLOWING sub-4-aligned field past its raw FieldOffset, so the reinterpret
// reads it from the wrong bytes.  That sub-word case is a PRE-EXISTING multi-return
// hole (it mismatched native under the raw form too, before this field was coerced);
// tracked in claude-todo.md, NOT introduced or fixed here.
func multiReturnCoercedLLTy(out *strings.Builder, t @types.Type) {
	out.WriteByte('{')
	for i := 0; i < len(t.Fields); i++ {
		if i > 0 { out.Write(", ") }
		out.WriteByte(' ')
		writeFlatMemberLLTy(out, t.Fields[i].Type)
	}
	out.Write(" }")
	return
}

// writeFlatMemberLLTy writes ONE multi-return field's flat boundary member type: its
// `[N x iW]` coerced form when it is a struct/array field on a coercing target
// (multiRetCoercionActive), else its plain llvmType.  The per-field building block of
// multiReturnCoercedLLTy AND the field-by-field bridge (emitMultiRetCoercedReturn's
// gather + emitScatterFlatValue) — using ONE spelling everywhere keeps the boundary
// type and its raw<->flat reinterpret provably in step.
func writeFlatMemberLLTy(out *strings.Builder, fldTyp @types.Type) {
	if multiRetCoercionActive() && aggInRegCoercedKind(fldTyp) {
		aggCoerceLLTy(out, fldTyp)
	} else {
		out.Write(llvmType(fldTyp))
	}
	return
}

// emitScatterFlatValue writes each field of the flat multi-return value `flatRef` (of
// tuple type `t`) to its RAW `types.FieldOffset` in the raw-layout buffer `dstRef` (a
// ptr), each with its flat member type (writeFlatMemberLLTy).  This is the flat->raw
// half of the field-by-field bridge: storing per-field at the raw offset — instead of a
// single whole-struct `store <flat>` — is what makes the reinterpret offset-faithful,
// because a coerced `[N x iW]` field whose LLVM alignment/size differs from its raw
// extent still lands at its true FieldOffset.  Fields are written in index order (ascending
// FieldOffset), so if a word-rounded sub-word aggregate field's store spills into the next
// field's byte, the later field's store overwrites it and the raw layout ends up exact.
// `pfx` disambiguates the SSA temps.  Shared by the direct/iface call-result bind
// (emitMultiRetCallResultBind) and the func-value + capturing-closure shims, so all three
// agree by construction.
func emitScatterFlatValue(out *strings.Builder, t @types.Type, flatRef *[]readonly char,
		dstRef *[]readonly char, pfx *[]readonly char) {
	for i := 0; i < len(t.Fields); i++ {
		out.Write("  %")
		out.Write(pfx)
		out.Write(".se")
		stringutils.WriteInt(out, i)
		out.Write(" = extractvalue ")
		multiReturnCoercedLLTy(out, t)
		out.WriteByte(' ')
		out.Write(flatRef)
		out.Write(", ")
		stringutils.WriteInt(out, i)
		out.Write("\n  %")
		out.Write(pfx)
		out.Write(".sp")
		stringutils.WriteInt(out, i)
		out.Write(" = getelementptr i8, ptr ")
		out.Write(dstRef)
		out.Write(", i32 ")
		stringutils.WriteInt(out, t.FieldOffset(i))
		out.Write("\n  store ")
		writeFlatMemberLLTy(out, t.Fields[i].Type)
		out.Write(" %")
		out.Write(pfx)
		out.Write(".se")
		stringutils.WriteInt(out, i)
		out.Write(", ptr %")
		out.Write(pfx)
		out.Write(".sp")
		stringutils.WriteInt(out, i)
		// align 1: a field at a non-word-aligned raw FieldOffset (e.g. a sub-word
		// aggregate coerced to [1 x i32] landing at an odd byte) is an UNALIGNED store;
		// without this the arm32 baremetal backend emits a natural-alignment store that
		// faults.  Correct-but-conservative on every target (multi-return is not hot).
		out.Write(", align 1\n")
	}
	return
}

// emitMultiRetCoercedReturn reinterprets the built raw tuple value
// `%v.ret.<seq>.<idx>` to the flat boundary return type through the function-scoped
// `%mrret.slot` (emitted once at entry by emitEntryAllocaDecls) and emits `ret {flat}`.
// It stores the raw packed tuple to the slot (raw FieldOffset layout) and then GATHERS
// the flat return value field-by-field, loading each field's flat member type from its
// RAW FieldOffset (NOT a single whole-struct load of the flat type — that would read a
// coerced `[N x iW]` field from wherever the flat type's own LLVM alignment placed it,
// which diverges from the raw offset for a non-word-aligned struct field; see
// multiReturnCoercedLLTy's CAVEAT).  `retName` is the fully-formed name of the last
// insertvalue result (the packed raw tuple); `retSeqTag` disambiguates the SSA temps
// across multiple returns in one function.
func emitMultiRetCoercedReturn(out *strings.Builder, instr @ir.Instr, retName @[]char,
		retSeqTag int) {
	out.Write("store ")
	out.Write(llvmType(instr.Typ))
	out.WriteByte(' ')
	out.Write(retName)
	out.Write(", ptr %mrret.slot\n")
	var t @types.Type = instr.Typ
	// Gather: build the flat value in %mrret.v<tag> from per-field raw-offset loads.
	for i := 0; i < len(t.Fields); i++ {
		out.Write("  %mrret.g")
		stringutils.WriteInt(out, retSeqTag)
		out.WriteByte('.')
		stringutils.WriteInt(out, i)
		out.Write(" = getelementptr i8, ptr %mrret.slot, i32 ")
		stringutils.WriteInt(out, t.FieldOffset(i))
		out.Write("\n  %mrret.c")
		stringutils.WriteInt(out, retSeqTag)
		out.WriteByte('.')
		stringutils.WriteInt(out, i)
		out.Write(" = load ")
		writeFlatMemberLLTy(out, t.Fields[i].Type)
		out.Write(", ptr %mrret.g")
		stringutils.WriteInt(out, retSeqTag)
		out.WriteByte('.')
		stringutils.WriteInt(out, i)
		// align 1: the field is loaded from its raw FieldOffset, which may be non-word-
		// aligned (a sub-word aggregate coerced to [1 x i32] at an odd byte); an
		// unannotated natural-alignment load faults on arm32 baremetal.  See the store
		// counterpart in emitScatterFlatValue.
		out.Write(", align 1\n  ")
		writeGatherAccName(out, retSeqTag, i, len(t.Fields))
		out.Write(" = insertvalue ")
		multiReturnCoercedLLTy(out, t)
		out.WriteByte(' ')
		if i == 0 {
			out.Write("undef")
		} else {
			writeGatherAccName(out, retSeqTag, i - 1, len(t.Fields))
		}
		out.Write(", ")
		writeFlatMemberLLTy(out, t.Fields[i].Type)
		out.Write(" %mrret.c")
		stringutils.WriteInt(out, retSeqTag)
		out.WriteByte('.')
		stringutils.WriteInt(out, i)
		out.Write(", ")
		stringutils.WriteInt(out, i)
		out.WriteByte('\n')
	}
	out.Write("  ret ")
	multiReturnCoercedLLTy(out, t)
	out.Write(" %mrret.v")
	stringutils.WriteInt(out, retSeqTag)
	out.WriteByte('\n')
	return
}

// writeGatherAccName writes the insertvalue accumulator name for gather field `i` of a
// tuple with `n` fields: the LAST field writes the final flat value `%mrret.v<tag>`
// (which emitMultiRetCoercedReturn returns), earlier fields write intermediates
// `%mrret.a<tag>.<i>`.
func writeGatherAccName(out *strings.Builder, retSeqTag int, i int, n int) {
	if i == n - 1 {
		out.Write("%mrret.v")
		stringutils.WriteInt(out, retSeqTag)
		return
	}
	out.Write("%mrret.a")
	stringutils.WriteInt(out, retSeqTag)
	out.WriteByte('.')
	stringutils.WriteInt(out, i)
	return
}

// emitMultiRetCallAllocaDecl hoists the `%v<callID>.mrRB` slot used by
// emitCall to reinterpret a flat-boundary multi-return call result back to the raw
// tuple the downstream extracts consume.  No-op unless the call is a bridged
// multi-return.
func emitMultiRetCallAllocaDecl(out *strings.Builder, instr @ir.Instr) {
	if !callMultiRetCoerced(instr) {
		return
	}
	emitRef(out, instr.ID)
	out.Write(".mrRB = alloca ")
	multiReturnCoercedLLTy(out, instr.Typ)
	out.WriteByte('\n')
	return
}

// emitMultiRetCallResultBind emits, AFTER a bridged multi-return call line, the
// reinterpret of the flat-boundary result `%v<callID>.mrR` back to the raw tuple
// `%v<callID>` (which the downstream extractvalue reads).  It SCATTERS each flat field
// to its raw FieldOffset in the entry-hoisted `.mrRB` slot (emitScatterFlatValue) — the
// field-by-field reinterpret that is offset-faithful for a coerced non-word-aligned
// struct field — then loads the raw tuple from the slot.
func emitMultiRetCallResultBind(out *strings.Builder, instr @ir.Instr) {
	var fb @strings.Builder = strings.NewBuilder()
	fb.Write("%v")
	stringutils.WriteInt(fb, instr.ID)
	fb.Write(".mrR")
	var db @strings.Builder = strings.NewBuilder()
	db.Write("%v")
	stringutils.WriteInt(db, instr.ID)
	db.Write(".mrRB")
	var pb @strings.Builder = strings.NewBuilder()
	pb.Write("v")
	stringutils.WriteInt(pb, instr.ID)
	pb.Write(".mrb")
	emitScatterFlatValue(out, instr.Typ, fb.String(), db.String(), pb.String())
	out.Write("  ")
	emitRef(out, instr.ID)
	out.Write(" = load ")
	out.Write(llvmType(instr.Typ))
	out.Write(", ptr %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".mrRB\n")
	return
}
