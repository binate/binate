package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the multi-return-tuple RETURN ABI: a register-returned multi-return
// must be returned as the FLAT (padding-member-free) first-class-aggregate boundary
// type, NOT its raw PACKED `<{ ... [N x i8] ... }>` layout.  Binate emits every
// tuple PACKED with explicit `[N x i8]` padding members so its in-memory byte
// layout (dtor field-GEP, sret buffer, struct copy) matches types.FieldOffset — but
// as a first-class-aggregate RETURN value each padding member claims its OWN return
// register, so a native caller reading an LLVM callee collects a wide field from the
// wrong register (silent corruption: an int64/managed field lands in the wrong
// register pair -> wrong value on x64/aa64, hang on arm32).  The fix reinterprets the
// raw packed tuple to the flat boundary type at the ret/call boundary (the coerced-
// bridge in emit_agg_coerce.bn).  Helpers (compileToLLVM, contains, fail) live in
// emit_test.bn.  These run on the host (LP64), where `(int32, int64)` is a 16-byte
// register-returned tuple with a `[4 x i8]` pad member before the 8-aligned int64.

// TestPaddedMultiReturnUsesFlatFCA: a `(int32, int64)` return — packed
// `<{ i32, [4 x i8], i64 }>`, the int64 8-aligned with a pad member before it — must
// be RETURNED as the flat `{ i32, i64 }` boundary (no pad member), reinterpreted
// from the raw packed build through the `%mrret.slot`.  Returning the raw packed
// `<{ i32, [4 x i8], i64 }>` directly (the regression) gives the pad member its own
// return register and pushes the int64 into the wrong register pair.
func TestPaddedMultiReturnUsesFlatFCA() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f() (int32, int64) { return cast(int32, 1), cast(int64, 2) }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a int32\n")
	cb.Write("\tvar b int64\n")
	cb.Write("\ta, b = f()\n")
	cb.Write("\tif b == cast(int64, 0) { println(cast(int, a)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "ret { i32,") {
		return fail("padded multi-return must ret the flat { i32, i64 } boundary (no pad member)")
	}
	if contains(out, "ret <{ i32,") {
		return fail("padded multi-return must NOT ret the raw packed <{ i32, [4 x i8], i64 }> FCA")
	}
	if !contains(out, "store <{ i32, [4 x i8], i64 }>") {
		return fail("expected the raw packed tuple stored to the %mrret.slot reinterpret bridge")
	}
	var pass testing.TestResult
	return pass
}

// TestUnpaddedMultiReturnStaysDirectPacked: a `(int64, int64)` return has NO
// padding member (both fields 8-aligned, no trailing pad), so its packed form
// `<{ i64, i64 }>` already matches the native per-field register layout and is
// returned DIRECTLY — no flat-FCA reinterpret bridge (no `%mrret.slot`).  Guards
// that the bridge fires ONLY for padded tuples, not every multi-return.
func TestUnpaddedMultiReturnStaysDirectPacked() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f() (int64, int64) { return cast(int64, 1), cast(int64, 2) }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a int64\n")
	cb.Write("\tvar b int64\n")
	cb.Write("\ta, b = f()\n")
	cb.Write("\tif b == cast(int64, 0) { println(cast(int, a)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "ret <{ i64, i64 }>") {
		return fail("unpadded multi-return should ret its raw packed <{ i64, i64 }> directly")
	}
	if contains(out, "%mrret.slot") {
		return fail("unpadded multi-return must NOT use the flat-FCA reinterpret bridge")
	}
	var pass testing.TestResult
	return pass
}

// TestTrailingPadMultiReturnUsesFlatFCA: a `(int64, int32)` return — packed
// `<{ i64, i32, [4 x i8] }>` with a TRAILING pad member (size 12 rounded to align 8)
// — must also ret the flat `{ i64, i32 }` boundary.  Exercises multiRetHasPadding's
// TrailingPadding() branch, which TestPaddedMultiReturnUsesFlatFCA (a PaddingBefore-
// only shape) leaves unexercised; this is the exact shape the coerce comment cites as
// the arm32 hang, so a regressor dropping the TrailingPadding() branch must go red.
func TestTrailingPadMultiReturnUsesFlatFCA() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f() (int64, int32) { return cast(int64, 1), cast(int32, 2) }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a int64\n")
	cb.Write("\tvar b int32\n")
	cb.Write("\ta, b = f()\n")
	cb.Write("\tif a == cast(int64, 0) { println(cast(int, b)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "ret { i64,") {
		return fail("trailing-pad multi-return must ret the flat { i64, i32 } boundary (no pad member)")
	}
	if contains(out, "ret <{ i64,") {
		return fail("trailing-pad multi-return must NOT ret the raw packed <{ i64, i32, [4 x i8] }> FCA")
	}
	var pass testing.TestResult
	return pass
}

// TestClosureShimPaddedMultiReturnCoerced: a CAPTURING closure returning a padded
// `(int32, int64)` multi-return must have its shim's underlying call spell the flat
// coerced `{ i32, i64 }` boundary — matching the coerced closure-body `define` — NOT
// the raw packed `<{ i32, [4 x i8], i64 }>`.  d72f7154 coerced the define and the
// FUNC-VALUE shim but not the capturing-closure shim (emitClosureShimAggregate), so a
// capturing closure returning (int32,int64) silently returned garbage for the int64
// (the padding member claimed a return register) until the closure shim was routed
// through the shared writeShimResultLLTy too.  The raw packed form legitimately
// appears in the define's `store … %mrret.slot` bridge, so this pins the CALL.
func TestClosureShimPaddedMultiReturnCoerced() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar n int32 = cast(int32, 1)\n")
	cb.Write("\tvar big int64 = cast(int64, 2)\n")
	cb.Write("\tvar cl @func() (int32, int64) = func() (int32, int64) { return n, big }\n")
	cb.Write("\tvar a int32\n")
	cb.Write("\tvar b int64\n")
	cb.Write("\ta, b = cl()\n")
	cb.Write("\tif b == cast(int64, 0) { println(cast(int, a)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "%r = call { i32,") {
		return fail("closure shim must call the flat { i32, i64 } coerced multi-return")
	}
	if contains(out, "%r = call <{ i32,") {
		return fail("closure shim must NOT call the raw packed <{ i32, [4 x i8], i64 }>")
	}
	var pass testing.TestResult
	return pass
}

// TestArm32StructFieldMultiReturnCoerced: on arm32 (ILP32, AAPCS32) a register-
// returned multi-return whose field is a nested STRUCT — `(St, int)` with
// St = `{bool,int,int}` (12B) — must field-coerce St to its `[3 x i32]` form for the
// flat return boundary, NOT return the raw packed `<{ %St, i32 }>`.  Uncoerced, LLVM's
// arm32 backend flattens St's `i1 + [3 x i8]` into more than 4 legalized return parts
// and returns the 16-byte tuple via sret (an r0 buffer), while the native caller
// classifies it as register-returned by word count (gpWords <= 4) and reads r0..r3 —
// the conformance/1119 crash.  Runs with the arm32 target so the ILP32 `[N x i32]`
// coercion path fires regardless of host arch.  (The host-LP64 tests above exercise
// the arch-independent padding-member bridge; this pins the arm32 struct-field one.)
func TestArm32StructFieldMultiReturnCoerced() testing.TestResult {
	setTargetArm32()
	// setTargetArm32 sets only the ILP32 sizes; the coercion gate keys on Arch, so
	// stamp ARCH_ARM32 (as cmd/bnc's arm32 path does).  setTarget64 below resets Arch
	// to the default (SetTarget clears every field) — no leak into later tests.
	types.SetArch(types.ARCH_ARM32)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type St struct { flag bool\n a int\n b int }\n")
	cb.Write("func mk(x int) (St, int) {\n")
	cb.Write("\tvar s St\n")
	cb.Write("\ts.a = x\n")
	cb.Write("\treturn s, x\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar s St\n")
	cb.Write("\tvar n int\n")
	cb.Write("\ts, n = mk(5)\n")
	cb.Write("\tif n == cast(int, 0) { println(s.a) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	setTarget64()
	if !contains(out, "{ [3 x i32],") {
		return fail("arm32 (St,int) multi-return must coerce St to the flat [3 x i32] boundary")
	}
	if contains(out, "ret <{") {
		return fail("arm32 struct-field multi-return must NOT ret the raw packed <{ %St, i32 }> FCA")
	}
	if !contains(out, "%mrret.slot") {
		return fail("expected the raw packed tuple stored to the %mrret.slot reinterpret bridge")
	}
	var pass testing.TestResult
	return pass
}
