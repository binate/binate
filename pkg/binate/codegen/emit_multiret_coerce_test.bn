package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the multi-return-tuple RETURN ABI: a register-returned multi-return
// must be returned as the FLAT (padding-member-free) first-class-aggregate boundary
// type, NOT its raw PACKED `<{ ... [N x i8] ... }>` layout.  Binate emits every
// tuple PACKED with explicit `[N x i8]` padding members so its in-memory byte
// layout (dtor field-GEP, sret buffer, struct copy) matches types.FieldOffset — but
// as a first-class-aggregate RETURN value each padding member claims its OWN return
// register, so a native caller reading an LLVM callee collects a wide field from the
// wrong register (silent corruption: an int64/managed field lands in the wrong
// register pair -> wrong value on x64/aa64, hang on arm32).  The fix reinterprets the
// raw packed tuple to the flat boundary type at the ret/call boundary (the coerced-
// bridge in emit_agg_coerce.bn).  Helpers (compileToLLVM, contains, fail) live in
// emit_test.bn.  These run on the host (LP64), where `(int32, int64)` is a 16-byte
// register-returned tuple with a `[4 x i8]` pad member before the 8-aligned int64.

// TestPaddedMultiReturnUsesFlatFCA: a `(int32, int64)` return — packed
// `<{ i32, [4 x i8], i64 }>`, the int64 8-aligned with a pad member before it — must
// be RETURNED as the flat `{ i32, i64 }` boundary (no pad member), reinterpreted
// from the raw packed build through the `%mrret.slot`.  Returning the raw packed
// `<{ i32, [4 x i8], i64 }>` directly (the regression) gives the pad member its own
// return register and pushes the int64 into the wrong register pair.
func TestPaddedMultiReturnUsesFlatFCA() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f() (int32, int64) { return cast(int32, 1), cast(int64, 2) }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a int32\n")
	cb.Write("\tvar b int64\n")
	cb.Write("\ta, b = f()\n")
	cb.Write("\tif b == cast(int64, 0) { println(cast(int, a)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "ret { i32,") {
		return fail("padded multi-return must ret the flat { i32, i64 } boundary (no pad member)")
	}
	if contains(out, "ret <{ i32,") {
		return fail("padded multi-return must NOT ret the raw packed <{ i32, [4 x i8], i64 }> FCA")
	}
	if !contains(out, "store <{ i32, [4 x i8], i64 }>") {
		return fail("expected the raw packed tuple stored to the %mrret.slot reinterpret bridge")
	}
	var pass testing.TestResult
	return pass
}

// TestUnpaddedMultiReturnStaysDirectPacked: a `(int64, int64)` return has NO
// padding member (both fields 8-aligned, no trailing pad), so its packed form
// `<{ i64, i64 }>` already matches the native per-field register layout and is
// returned DIRECTLY — no flat-FCA reinterpret bridge (no `%mrret.slot`).  Guards
// that the bridge fires ONLY for padded tuples, not every multi-return.
func TestUnpaddedMultiReturnStaysDirectPacked() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f() (int64, int64) { return cast(int64, 1), cast(int64, 2) }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a int64\n")
	cb.Write("\tvar b int64\n")
	cb.Write("\ta, b = f()\n")
	cb.Write("\tif b == cast(int64, 0) { println(cast(int, a)) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "ret <{ i64, i64 }>") {
		return fail("unpadded multi-return should ret its raw packed <{ i64, i64 }> directly")
	}
	if contains(out, "%mrret.slot") {
		return fail("unpadded multi-return must NOT use the flat-FCA reinterpret bridge")
	}
	var pass testing.TestResult
	return pass
}
