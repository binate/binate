package "pkg/binate/codegen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for operandError: a function with an operand that is not one of its own values is
// an internal error, which emitFuncDbg panics with (so only the text, and EmitModule's
// taking a module whose operands are its functions' own, can be observed here).

// llOperandFunc returns a function named name, `f(x int) int`, `entry: s = add x, 1; l =
// load &gx; t = add s, l; return t` -- x a parameter ref, &gx an address pseudo of m's
// global main.gx -- added to m, and its instructions s, l and t.
func llOperandFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Instr) {
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = make(ir.Param)
	ps[0].Name = "x"
	ps[0].Typ = types.TypInt()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, ps, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 3)
	vals[0] = irbuild.EmitBinop(entry, iropcode.OP_ADD, irbuild.NewParamRef(f, f.Params[0]),
			irbuild.EmitConstInt(entry, 1, types.TypInt()), types.TypInt())
	vals[1] = irbuild.EmitLoad(entry, irbuild.NewGlobalRef(m, "main.gx", types.TypInt()),
			types.TypInt())
	vals[2] = irbuild.EmitBinop(entry, iropcode.OP_ADD, vals[0], vals[1], types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = vals[2]
	irbuild.EmitReturn(entry, rets)
	m.AddFunc(f)
	return f, vals
}

// llOperandModule returns a new module holding the global main.gx (an int).
func llOperandModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var gx @ir.Global = make(ir.Global)
	gx.Name = "main.gx"
	gx.Typ = types.TypInt()
	m.AddGlobal(gx)
	return m
}

// operandErrorIs fails unless operandError(f, m's values) is want, prefixing the failure
// with what.
func operandErrorIs(f @ir.Func, m @ir.Module, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	var got @[]char = operandError(f, irbuild.NewModuleValues(m))
	if seq(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(what, ": got error "), got))
}

// A module whose functions' operands are their own -- a parameter, a constant, an
// instruction, the module's global -- has no internal error, and EmitModule defines both
// functions.
func TestEmitModuleTakesOwnOperands() testing.TestResult {
	setTarget64()
	var m @ir.Module = llOperandModule()
	var f @ir.Func
	var g @ir.Func
	f, _ = llOperandFunc(m, "main.f")
	g, _ = llOperandFunc(m, "main.g")
	var r testing.TestResult = operandErrorIs(f, m, "", "f's own operands")
	if len(r) > 0 { return r }
	r = operandErrorIs(g, m, "", "g's own operands")
	if len(r) > 0 { return r }
	var out @[]char = EmitModule(m)
	if countSubstr(out, "define i64 @") != 2 { return "both functions should be defined" }
	return ""
}

// An operand that is another function's instruction -- here one with the id of the
// function's own in its place, which its %v<id> would silently name instead -- is an
// internal error.
func TestOperandErrorOtherFunction() testing.TestResult {
	var m @ir.Module = llOperandModule()
	var f @ir.Func
	var fv @[]@ir.Instr
	f, fv = llOperandFunc(m, "main.f")
	var gv @[]@ir.Instr
	_, gv = llOperandFunc(m, "main.g")
	fv[2].Args[1] = gv[1]
	return operandErrorIs(f, m,
			"internal error: codegen: an add in main.f (block entry.0) has its operand 1 (v3) outside "
					"the function (an instruction of main.g)",
			"g's load")
}

// funcIRError, which emitFuncDbg panics with, is the operand's error for a function with an
// operand that is not one of its own values, and "" for one whose operands are its own.
func TestFuncIRErrorTakesOperandError() testing.TestResult {
	var m @ir.Module = llOperandModule()
	var f @ir.Func
	var fv @[]@ir.Instr
	f, fv = llOperandFunc(m, "main.f")
	var gv @[]@ir.Instr
	_, gv = llOperandFunc(m, "main.g")
	var values @irbuild.ModuleValues = irbuild.NewModuleValues(m)
	var got @[]char = funcIRError(f, values)
	if len(got) > 0 { return fail(buf.Concat("f's own operands: got error ", got)) }
	fv[2].Args[1] = gv[1]
	got = funcIRError(f, values)
	var want *[]readonly char = "internal error: codegen: an add in main.f (block entry.0) has its "
			"operand 1 (v3) outside the function (an instruction of main.g)"
	if seq(got, want) { return "" }
	return fail(buf.Concat("g's load: got error ", got))
}

// A function whose phis are eliminated is an internal error: its operands cannot be checked.
func TestOperandErrorAfterPhiElimination() testing.TestResult {
	var m @ir.Module = llOperandModule()
	var f @ir.Func
	f, _ = llOperandFunc(m, "main.f")
	f.PhisEliminated = true
	return operandErrorIs(f, m,
			"internal error: codegen: main.f has had its phis eliminated, after which its operands "
					"cannot be checked (they may read phis no block holds)",
			"f, its phis eliminated")
}

// A global-address pseudo of another module is an internal error.
func TestOperandErrorOtherModulesGlobal() testing.TestResult {
	var m @ir.Module = llOperandModule()
	var f @ir.Func
	var fv @[]@ir.Instr
	f, fv = llOperandFunc(m, "main.f")
	fv[1].Args[0] = irbuild.NewGlobalRef(llOperandModule(), "main.gx", types.TypInt())
	return operandErrorIs(f, m,
			"internal error: codegen: a load in main.f (block entry.0) has its operand 0, the address "
					"of main.gx, outside the module (not one of its global address pseudos)",
			"another module's pseudo")
}
