package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitBinop emits an arithmetic or bitwise binary operation (add, sub, mul, etc.).
func emitBinop(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = ")

	// Peel TYP_NAMED so a named distinct scalar (`type F float32`,
	// `type Celsius int`) selects float vs int and signed vs unsigned
	// from its underlying kind, not the bare TYP_NAMED (whose .Signed
	// is unset).
	var rt @types.Type = unwrapNamed(instr.Typ)
	var isFloat bool = rt != nil && (rt.Kind == types.TYP_FLOAT || rt.Kind == types.TYP_UNTYPED_FLOAT)

	var opName *[]readonly char
	if instr.Op == iropcode.OP_ADD {
		if isFloat { opName = "fadd" } else { opName = "add" }
	}
	if instr.Op == iropcode.OP_SUB {
		if isFloat { opName = "fsub" } else { opName = "sub" }
	}
	if instr.Op == iropcode.OP_MUL {
		if isFloat { opName = "fmul" } else { opName = "mul" }
	}
	if instr.Op == iropcode.OP_DIV {
		if isFloat {
			opName = "fdiv"
		} else if rt != nil && !rt.Signed {
			opName = "udiv"
		} else {
			opName = "sdiv"
		}
	}
	if instr.Op == iropcode.OP_REM {
		// Rejected by the type checker for floats, so only integer
		// remainder reaches here.
		if rt != nil && !rt.Signed {
			opName = "urem"
		} else {
			opName = "srem"
		}
	}
	if instr.Op == iropcode.OP_AND { opName = "and" }
	if instr.Op == iropcode.OP_OR { opName = "or" }
	if instr.Op == iropcode.OP_XOR { opName = "xor" }
	if instr.Op == iropcode.OP_SHL { opName = "shl" }
	if instr.Op == iropcode.OP_SHR {
		if rt != nil && !rt.Signed {
			opName = "lshr"
		} else {
			opName = "ashr"
		}
	}

	out.Write(opName)
	out.WriteByte(' ')
	out.Write(llvmType(instr.Typ))
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	emitRef(out, instr.Args[1].ID)
	out.WriteByte('\n')
	return
}

// emitCmp emits an icmp or fcmp comparison, with special handling for
// slice-vs-nil. Floating-point compares follow IEEE 754 / Go: `==` and
// the four relationals are ordered (`oeq`, `olt`, `ole`, `ogt`, `oge` —
// false when either operand is NaN), but `!=` is the UNORDERED `une`
// (true when either is NaN), so it stays the exact complement of `==`.
func emitCmp(out *strings.Builder, instr @ir.Instr) {
	// Peel TYP_NAMED so a named distinct scalar compares with the
	// float/int predicate and signedness of its underlying.
	var lhsTyp @types.Type = unwrapNamed(instr.Args[0].Typ)
	var rhsTyp @types.Type = unwrapNamed(instr.Args[1].Typ)
	var isFloat bool = lhsTyp != nil &&
			(lhsTyp.Kind == types.TYP_FLOAT || lhsTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Use unsigned predicates if either operand is unsigned
	var useUnsigned bool = false
	if !isFloat && lhsTyp != nil && !lhsTyp.Signed {
		if lhsTyp.IsInteger() {
			useUnsigned = true
		}
	}

	var pred *[]readonly char
	if instr.Op == iropcode.OP_EQ {
		if isFloat { pred = "oeq" } else { pred = "eq" }
	}
	if instr.Op == iropcode.OP_NE {
		// Unordered (`une`): NaN != x is true, keeping `!=` the exact
		// complement of `==` (`oeq`), per IEEE 754 / Go.
		if isFloat { pred = "une" } else { pred = "ne" }
	}
	if instr.Op == iropcode.OP_LT {
		if isFloat { pred = "olt" } else if useUnsigned { pred = "ult" } else { pred = "slt" }
	}
	if instr.Op == iropcode.OP_LE {
		if isFloat { pred = "ole" } else if useUnsigned { pred = "ule" } else { pred = "sle" }
	}
	if instr.Op == iropcode.OP_GT {
		if isFloat { pred = "ogt" } else if useUnsigned { pred = "ugt" } else { pred = "sgt" }
	}
	if instr.Op == iropcode.OP_GE {
		if isFloat { pred = "oge" } else if useUnsigned { pred = "uge" } else { pred = "sge" }
	}

	var lhsIsSlice bool = lhsTyp != nil &&
			(lhsTyp.Kind == types.TYP_SLICE || lhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var rhsIsNil bool = rhsTyp != nil && rhsTyp.Kind == types.TYP_NIL
	if lhsIsSlice && rhsIsNil {
		var sliceTypeName *[]readonly char = "%BnSlice"
		if lhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr = extractvalue ")
		out.Write(sliceTypeName)
		out.WriteByte(' ')
		emitRef(out, instr.Args[0].ID)
		out.Write(", 0\n  ")
		emitRef(out, instr.ID)
		out.Write(" = icmp ")
		out.Write(pred)
		out.Write(" i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr, null\n")
		return
	}
	var rhsIsSlice bool = rhsTyp != nil &&
			(rhsTyp.Kind == types.TYP_SLICE || rhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var lhsIsNil bool = lhsTyp != nil && lhsTyp.Kind == types.TYP_NIL
	if rhsIsSlice && lhsIsNil {
		var sliceTypeName *[]readonly char = "%BnSlice"
		if rhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr = extractvalue ")
		out.Write(sliceTypeName)
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.Write(", 0\n  ")
		emitRef(out, instr.ID)
		out.Write(" = icmp ")
		out.Write(pred)
		out.Write(" i8* null, %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr\n")
		return
	}

	emitRef(out, instr.ID)
	if isFloat {
		out.Write(" = fcmp ")
	} else {
		out.Write(" = icmp ")
	}
	out.Write(pred)
	out.WriteByte(' ')
	out.Write(llvmType(instr.Args[0].Typ))
	out.WriteByte(' ')
	emitValRef(out, instr.Args[0])
	out.Write(", ")
	emitValRef(out, instr.Args[1])
	out.WriteByte('\n')
	return
}

// emitLogical emits an i1 and/or for logical && and || operators.
func emitLogical(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = ")
	if instr.Op == iropcode.OP_LAND {
		out.Write("and")
	} else {
		out.Write("or")
	}
	out.Write(" i1 ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	emitRef(out, instr.Args[1].ID)
	out.WriteByte('\n')
	return
}
