package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// emitBinop emits an arithmetic or bitwise binary operation (add, sub, mul, etc.).
func emitBinop(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = ")

	// Peel TYP_NAMED so a named distinct scalar (`type F float32`,
	// `type Celsius int`) selects float vs int and signed vs unsigned
	// from its underlying kind, not the bare TYP_NAMED (whose .Signed
	// is unset).
	var rt @types.Type = unwrapNamed(instr.Typ)
	var isFloat bool = rt != nil &&
		(rt.Kind == types.TYP_FLOAT ||
			rt.Kind == types.TYP_UNTYPED_FLOAT)

	var opName *[]readonly char
	if instr.Op == ir.OP_ADD {
		if isFloat { opName = "fadd" } else { opName = "add" }
	}
	if instr.Op == ir.OP_SUB {
		if isFloat { opName = "fsub" } else { opName = "sub" }
	}
	if instr.Op == ir.OP_MUL {
		if isFloat { opName = "fmul" } else { opName = "mul" }
	}
	if instr.Op == ir.OP_DIV {
		if isFloat {
			opName = "fdiv"
		} else if rt != nil && !rt.Signed {
			opName = "udiv"
		} else {
			opName = "sdiv"
		}
	}
	if instr.Op == ir.OP_REM {
		// Rejected by the type checker for floats, so only integer
		// remainder reaches here.
		if rt != nil && !rt.Signed {
			opName = "urem"
		} else {
			opName = "srem"
		}
	}
	if instr.Op == ir.OP_AND { opName = "and" }
	if instr.Op == ir.OP_OR { opName = "or" }
	if instr.Op == ir.OP_XOR { opName = "xor" }
	if instr.Op == ir.OP_SHL { opName = "shl" }
	if instr.Op == ir.OP_SHR {
		if rt != nil && !rt.Signed {
			opName = "lshr"
		} else {
			opName = "ashr"
		}
	}

	out.Write(opName)
	out.WriteByte(' ')
	out.Write(llvmType(instr.Typ))
	out.WriteByte(' ')
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	emitRef(out, instr.Args[1].ID)
	out.WriteByte('\n')
	return
}

// emitCmp emits an icmp or fcmp comparison, with special handling for
// slice-vs-nil. Floating-point compares follow IEEE 754 / Go: `==` and
// the four relationals are ordered (`oeq`, `olt`, `ole`, `ogt`, `oge` —
// false when either operand is NaN), but `!=` is the UNORDERED `une`
// (true when either is NaN), so it stays the exact complement of `==`.
func emitCmp(out *strings.Builder, instr @ir.Instr) {
	// Peel TYP_NAMED so a named distinct scalar compares with the
	// float/int predicate and signedness of its underlying.
	var lhsTyp @types.Type = unwrapNamed(instr.Args[0].Typ)
	var rhsTyp @types.Type = unwrapNamed(instr.Args[1].Typ)
	var isFloat bool = lhsTyp != nil &&
		(lhsTyp.Kind == types.TYP_FLOAT ||
			lhsTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Use unsigned predicates if either operand is unsigned
	var useUnsigned bool = false
	if !isFloat && lhsTyp != nil && !lhsTyp.Signed {
		if lhsTyp.IsInteger() {
			useUnsigned = true
		}
	}

	var pred *[]readonly char
	if instr.Op == ir.OP_EQ {
		if isFloat { pred = "oeq" } else { pred = "eq" }
	}
	if instr.Op == ir.OP_NE {
		// Unordered (`une`): NaN != x is true, keeping `!=` the exact
		// complement of `==` (`oeq`), per IEEE 754 / Go.
		if isFloat { pred = "une" } else { pred = "ne" }
	}
	if instr.Op == ir.OP_LT {
		if isFloat { pred = "olt" } else if useUnsigned { pred = "ult" } else { pred = "slt" }
	}
	if instr.Op == ir.OP_LE {
		if isFloat { pred = "ole" } else if useUnsigned { pred = "ule" } else { pred = "sle" }
	}
	if instr.Op == ir.OP_GT {
		if isFloat { pred = "ogt" } else if useUnsigned { pred = "ugt" } else { pred = "sgt" }
	}
	if instr.Op == ir.OP_GE {
		if isFloat { pred = "oge" } else if useUnsigned { pred = "uge" } else { pred = "sge" }
	}

	var lhsIsSlice bool = lhsTyp != nil &&
		(lhsTyp.Kind == types.TYP_SLICE ||
			lhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var rhsIsNil bool = rhsTyp != nil && rhsTyp.Kind == types.TYP_NIL
	if lhsIsSlice && rhsIsNil {
		var sliceTypeName *[]readonly char = "%BnSlice"
		if lhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr = extractvalue ")
		out.Write(sliceTypeName)
		out.WriteByte(' ')
		emitRef(out, instr.Args[0].ID)
		out.Write(", 0\n  ")
		emitRef(out, instr.ID)
		out.Write(" = icmp ")
		out.Write(pred)
		out.Write(" i8* %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr, null\n")
		return
	}
	var rhsIsSlice bool = rhsTyp != nil &&
		(rhsTyp.Kind == types.TYP_SLICE ||
			rhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var lhsIsNil bool = lhsTyp != nil && lhsTyp.Kind == types.TYP_NIL
	if rhsIsSlice && lhsIsNil {
		var sliceTypeName *[]readonly char = "%BnSlice"
		if rhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr = extractvalue ")
		out.Write(sliceTypeName)
		out.WriteByte(' ')
		emitRef(out, instr.Args[1].ID)
		out.Write(", 0\n  ")
		emitRef(out, instr.ID)
		out.Write(" = icmp ")
		out.Write(pred)
		out.Write(" i8* null, %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".sptr\n")
		return
	}

	emitRef(out, instr.ID)
	if isFloat {
		out.Write(" = fcmp ")
	} else {
		out.Write(" = icmp ")
	}
	out.Write(pred)
	out.WriteByte(' ')
	out.Write(llvmType(instr.Args[0].Typ))
	out.WriteByte(' ')
	emitValRef(out, instr.Args[0])
	out.Write(", ")
	emitValRef(out, instr.Args[1])
	out.WriteByte('\n')
	return
}

// emitLogical emits an i1 and/or for logical && and || operators.
func emitLogical(out *strings.Builder, instr @ir.Instr) {
	emitRef(out, instr.ID)
	out.Write(" = ")
	if instr.Op == ir.OP_LAND {
		out.Write("and")
	} else {
		out.Write("or")
	}
	out.Write(" i1 ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", ")
	emitRef(out, instr.Args[1].ID)
	out.WriteByte('\n')
	return
}

// emitCast emits a type cast (sext/zext/trunc, ptrtoint/inttoptr, or identity).
func emitCast(out *strings.Builder, instr @ir.Instr) {
	// Peel TYP_NAMED: a cast to/from a named distinct scalar selects
	// fp/int conversion and width from the underlying.  typeBits (used
	// for srcBits/dstBits) and llvmType peel on their own; this peels
	// the local Kind== checks below.
	var srcTyp @types.Type = unwrapNamed(instr.Args[0].Typ)
	var dstTyp @types.Type = unwrapNamed(instr.TypeArg)

	// Source operand, IsGlobalRef-aware: `cast(int, &G)` of a global's
	// address renders the source as `@<mangled>`, not the nonexistent
	// `%v-1` (the IsGlobalRef pseudo has ID -1 and no SSA definition).
	// Mirrors emitBitCast; writeBuf is non-destructive, so the arms that
	// emit the source twice (same-size aggregate identity) stay correct.
	var srcRef @strings.Builder = strings.NewBuilder()
	emitValRef(srcRef, instr.Args[0])

	emitRef(out, instr.ID)

	var srcBits int = llvmTypeBits(instr.Args[0])
	var dstBits int = typeBits(dstTyp)

	// Check if source is a non-scalar type (slice, struct, etc.)
	// where "add X, 0" is not valid LLVM IR
	var srcIsAggregate bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_SLICE ||
			srcTyp.Kind == types.TYP_MANAGED_SLICE ||
			srcTyp.Kind == types.TYP_STRUCT)

	var srcIsPtr bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_POINTER || srcTyp.Kind == types.TYP_MANAGED_PTR)
	var dstIsPtr bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_POINTER || dstTyp.Kind == types.TYP_MANAGED_PTR)

	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Float ↔ float: fpext (widen) or fptrunc (narrow).
	if srcIsFloat && dstIsFloat {
		var srcW int = 64
		var dstW int = 64
		if srcTyp.Kind == types.TYP_FLOAT && srcTyp.Width > 0 { srcW = srcTyp.Width }
		if dstTyp.Kind == types.TYP_FLOAT && dstTyp.Width > 0 { dstW = dstTyp.Width }
		if srcW == dstW {
			// Same-width float-to-float: emit a no-op fadd X, 0.0.
			out.Write(" = fadd ")
			out.Write(llvmType(dstTyp))
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", 0.0\n")
			return
		}
		if srcW < dstW {
			out.Write(" = fpext ")
		} else {
			out.Write(" = fptrunc ")
		}
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Int → float: sitofp (signed) or uitofp (unsigned).
	if !srcIsFloat && dstIsFloat && !srcIsPtr {
		if isUnsigned(srcTyp) {
			out.Write(" = uitofp ")
		} else {
			out.Write(" = sitofp ")
		}
		out.Write(llvmTypeForBits(srcBits))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Float → int: fptosi (signed) or fptoui (unsigned). Truncates
	// towards zero (LLVM semantics).
	if srcIsFloat && !dstIsFloat && !dstIsPtr {
		if isUnsigned(dstTyp) {
			out.Write(" = fptoui ")
		} else {
			out.Write(" = fptosi ")
		}
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Pointer ↔ pointer: bitcast
	if srcIsPtr && dstIsPtr {
		out.Write(" = bitcast ")
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Pointer → int: ptrtoint
	if srcIsPtr && !dstIsPtr {
		out.Write(" = ptrtoint ")
		out.Write(llvmType(srcTyp))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	// Int → pointer: inttoptr
	if !srcIsPtr && dstIsPtr {
		out.Write(" = inttoptr ")
		out.Write(llvmTypeForBits(srcBits))
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(llvmType(dstTyp))
		out.WriteByte('\n')
		return
	}

	if srcBits == dstBits {
		if srcIsAggregate {
			// Non-scalar same-representation (e.g., *[]readonly char → *[]uint8):
			// both map to the same LLVM type — identity via select
			var tyLL @[]char = llvmType(srcTyp)
			out.Write(" = select i1 true, ")
			out.Write(tyLL)
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", ")
			out.Write(tyLL)
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.WriteByte('\n')
		} else {
			// Scalar same-size: identity via add 0
			out.Write(" = add ")
			out.Write(llvmType(dstTyp))
			out.WriteByte(' ')
			out.Write(srcRef.String())
			out.Write(", 0\n")
		}
		return
	}

	if srcBits < dstBits {
		if isUnsigned(srcTyp) {
			out.Write(" = zext ")
		} else {
			out.Write(" = sext ")
		}
	} else {
		out.Write(" = trunc ")
	}

	var srcLLVM @[]char = llvmTypeForBits(srcBits)
	out.Write(srcLLVM)
	out.WriteByte(' ')
	out.Write(srcRef.String())
	out.Write(" to ")
	out.Write(llvmType(dstTyp))
	out.WriteByte('\n')
	return
}

// emitBitCast emits a bitcast, ptrtoint, inttoptr, or identity for bit_cast.
func emitBitCast(out *strings.Builder, instr @ir.Instr) {
	// Peel TYP_NAMED so a bit_cast of a named distinct scalar selects
	// its pointer/float/int form from the underlying.
	var srcTyp @types.Type = unwrapNamed(instr.Args[0].Typ)
	var dstTyp @types.Type = unwrapNamed(instr.TypeArg)
	var srcLL @[]char = llvmType(srcTyp)
	var dstLL @[]char = llvmType(dstTyp)
	var srcIsPtr bool = isPointerType(srcTyp)
	var dstIsPtr bool = isPointerType(dstTyp)
	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Source operand, IsGlobalRef-aware: a bit_cast of a global's
	// address (e.g. `bit_cast(int, &G)`) renders the source as
	// `@<mangled>`, not the nonexistent `%v-1`.
	var srcRef @strings.Builder = strings.NewBuilder()
	emitValRef(srcRef, instr.Args[0])

	emitRef(out, instr.ID)

	if srcIsPtr && dstIsPtr {
		out.Write(" = bitcast ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcIsPtr && !dstIsPtr {
		out.Write(" = ptrtoint ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if !srcIsPtr && dstIsPtr {
		out.Write(" = inttoptr ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcIsFloat != dstIsFloat {
		// Int ↔ float same-size bit_cast: reinterprets bits, NOT a
		// numeric conversion. LLVM `bitcast` between scalars of the
		// same bit width handles this directly.
		out.Write(" = bitcast ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(" to ")
		out.Write(dstLL)
		out.WriteByte('\n')
	} else if srcTyp != nil && srcTyp.Kind == types.TYP_SLICE {
		// Raw-slice element retype (e.g. `*[]uint8` -> `*[]int8`): the
		// {ptr,len} representation is identical, so the reinterpret is a
		// no-op.  `add` is only valid for a scalar integer; for the
		// %BnSlice aggregate emit an identity `select` to produce the
		// result at the (same) target LLVM type.  The type checker
		// restricts a slice bit_cast to same-size non-managed elements,
		// so srcLL == dstLL here.
		out.Write(" = select i1 true, ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(", ")
		out.Write(srcLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.WriteByte('\n')
	} else {
		out.Write(" = add ")
		out.Write(dstLL)
		out.WriteByte(' ')
		out.Write(srcRef.String())
		out.Write(", 0\n")
	}
	return
}

// isPointerType returns true if the type is a raw or managed pointer.
func isPointerType(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR
}
