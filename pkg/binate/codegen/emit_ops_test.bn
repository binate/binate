package "pkg/binate/codegen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitBinop, emitCmp, emitLogical, emitCall, emitCast, emitBitCast.

func TestEmitBinopAdd() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { println(1 + 2) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "add i64") {
		return fail("expected add instruction")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitCmpLTUnsigned() testing.TestResult {
	// Positive untyped int literals use unsigned comparison
	var src *[]readonly char = "package \"main\"\nfunc main() { var x bool = 1 < 2 }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "icmp ult") {
		return fail("expected icmp ult for positive untyped int less-than")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitCmpLTSigned() testing.TestResult {
	// Negation produces signed int, so comparison is signed
	var src *[]readonly char = "package \"main\"\nfunc main() { var x bool = -1 < 2 }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "icmp slt") {
		return fail("expected icmp slt when operand is negated")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitLogicalAnd() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x bool = true && false }\n"
	var out @[]char = compileToLLVM(src)
	// Logical and uses short-circuit branching
	if !contains(out, "br i1") {
		return fail("expected branch for short-circuit and")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitCastIntWidth() testing.TestResult {
	// Cast a *variable* (not a literal) so the narrowing trunc is
	// actually emitted.  `cast(int8, <int-literal>)` is now
	// constant-narrowed at IR-gen (the literal lands at int8
	// directly — Phase B of plan-ir-gen-typed-literals.md), so a
	// literal operand emits no trunc.
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func main() { var y int = 42; ")
	cb.Write("var x int8 = cast(int8, y); _ = x }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "trunc i64") {
		return fail("expected trunc for narrowing cast")
	}
	var pass testing.TestResult
	return pass
}
// ============================================================
// Float codegen tests
// ============================================================

// A float literal lowers to `fadd <type> 0.0, <literal>`.
func TestEmitFloatConst() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x float64 = 3.14; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fadd double 0.0, 3.14") {
		return fail("expected 'fadd double 0.0, 3.14' for float literal")
	}
	var pass testing.TestResult
	return pass
}
// Float addition uses `fadd`, not `add`.
func TestEmitFloatAdd() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x float64 = 1.0 + 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fadd double") {
		return fail("expected 'fadd double' for float +")
	}
	var pass testing.TestResult
	return pass
}
// Float division uses `fdiv`, never `sdiv`/`udiv`.
func TestEmitFloatDiv() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x float64 = 6.0 / 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fdiv double") {
		return fail("expected 'fdiv double' for float /")
	}
	var pass testing.TestResult
	return pass
}
// Float comparison uses `fcmp` with ordered predicates.
func TestEmitFloatCmp() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var x bool = 1.0 < 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fcmp olt double") {
		return fail("expected 'fcmp olt double' for float <")
	}
	var pass testing.TestResult
	return pass
}
// Unary negation on floats uses `fneg`. Pipe the result through a
// function so nothing can be dead-stripped.
func TestEmitFloatNeg() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float64) float64 { return x }\n")
	cb.Write("func main() { use(-3.14) }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fneg double") {
		return fail("expected 'fneg double' for unary - on float")
	}
	var pass testing.TestResult
	return pass
}
// int → float64 cast uses `sitofp`.
func TestEmitCastIntToFloat() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float64) float64 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var i int = 5\n")
	cb.Write("  use(cast(float64, i))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "sitofp i64") {
		return fail("expected 'sitofp i64' for int → float cast")
	}
	var pass testing.TestResult
	return pass
}
// float → int cast uses `fptosi`.
func TestEmitCastFloatToInt() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x int) int { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float64 = 3.7\n")
	cb.Write("  use(cast(int, f))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fptosi double") {
		return fail("expected 'fptosi double' for float → int cast")
	}
	var pass testing.TestResult
	return pass
}
// float64 → float32 cast uses `fptrunc`.
func TestEmitCastFloat64To32() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float32) float32 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var d float64 = 3.14\n")
	cb.Write("  use(cast(float32, d))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fptrunc double") {
		return fail("expected 'fptrunc double' for narrowing float cast")
	}
	var pass testing.TestResult
	return pass
}
// float32 → float64 cast uses `fpext`.
func TestEmitCastFloat32To64() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float64) float64 { return x }\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float32 = cast(float32, 1.5)\n")
	cb.Write("  use(cast(float64, f))\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "fpext float") {
		return fail("expected 'fpext float' for widening float cast")
	}
	var pass testing.TestResult
	return pass
}
// float32 uses LLVM type 'float'.
func TestEmitFloat32Type() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func use(x float32) float32 { return x }\n")
	cb.Write("func main() { use(cast(float32, 1.0)) }\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "float ") {
		return fail("expected 'float' type in LLVM for float32")
	}
	var pass testing.TestResult
	return pass
}
