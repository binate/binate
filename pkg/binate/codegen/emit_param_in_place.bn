package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// On aarch64 a >16-byte by-value aggregate parameter (IsByvalParam) arrives as a
// pointer to a copy the callee owns: every caller passes one — a `.bv` / `.ap` slot
// or a private copy here, an argument region or a `__shimP` copy natively.  When
// common.InPlaceParamSlots allows it, the parameter's slot is that copy itself: the
// slot's alloca becomes the incoming pointer, and neither its zero-fill nor the entry
// copy of the parameter into it is emitted.

// curInPlaceParamID[id] is, for the function being emitted, the value ID of the
// parameter whose incoming copy the slot with value ID id is, or -1.
var curInPlaceParamID @[]int

// computeInPlaceParamSlots records f's in-place parameter slots (aarch64 only).
func computeInPlaceParamSlots(f @ir.Func) {
	clearInPlaceParamSlots()
	if !targetIsAA64() { return }
	var slots @[]int = common.InPlaceParamSlots(f)
	for id := 0; id < len(slots); id++ {
		if slots[id] < 0 { continue }
		var p @ir.Param = f.Params[slots[id]]
		if p.Typ.IsByvalParam() {
			slots[id] = p.ID
		} else {
			slots[id] = -1
		}
	}
	curInPlaceParamID = slots
}

// clearInPlaceParamSlots forgets the in-place slots of the function just emitted.
func clearInPlaceParamSlots() {
	var none @[]int
	curInPlaceParamID = none
}

// inPlaceParamID returns the value ID of the parameter whose incoming copy the slot
// with value ID id is, or -1.
func inPlaceParamID(id int) int {
	if id < 0 || id >= len(curInPlaceParamID) { return -1 }
	return curInPlaceParamID[id]
}

// emitInPlaceSlotDecl emits, in place of the slot's alloca, its definition as the
// incoming pointer of parameter paramID.
func emitInPlaceSlotDecl(out *strings.Builder, instr @ir.Instr, paramID int) {
	emitRef(out, instr.ID)
	out.Write(" = getelementptr i8, ptr %v")
	stringutils.WriteInt(out, paramID)
	out.Write(", i64 0\n")
}
