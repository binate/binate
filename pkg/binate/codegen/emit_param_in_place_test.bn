package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_param_in_place.bn: on aarch64 a >16-byte by-value parameter read
// only through its slot uses the incoming copy as the slot.

// inPlaceSrc is a function taking a 32-byte struct by value and writing to it.
func inPlaceSrc() *[]readonly char {
	return "package \"main\"\n"
			"type Q struct { a int\n b int\n c int\n d int }\n"
			"func bump(q Q) int {\n"
			"\tq.a = q.a + 1\n"
			"\treturn q.a + q.d\n"
			"}\n"
			"func main() {}\n"
}

// compileForArch compiles src for a 64-bit target of the given architecture.
func compileForArch(src *[]readonly char, arch int) @[]char {
	var saved types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	t.Arch = arch
	types.SetTarget(t)
	var out @[]char = compileToLLVM(src)
	types.SetTarget(saved)
	return out
}

// hasInPlaceSlotDecl reports whether out defines a slot as a parameter's incoming
// pointer: a `getelementptr i8, ptr %v<N>, i64 0` line (emitInPlaceSlotDecl).
func hasInPlaceSlotDecl(out *[]readonly char) bool {
	var pre *[]readonly char = " = getelementptr i8, ptr %v"
	for i := 0; i + len(pre) <= len(out); i++ {
		var j int = 0
		for j < len(pre) && out[i + j] == pre[j] { j++ }
		if j < len(pre) { continue }
		var k int = i + len(pre)
		for k < len(out) && out[k] >= '0' && out[k] <= '9' { k++ }
		var suf *[]readonly char = ", i64 0\n"
		var m int = 0
		for m < len(suf) && k + m < len(out) && out[k + m] == suf[m] { m++ }
		if m == len(suf) { return true }
	}
	return false
}

// On aarch64 the parameter's slot is the incoming pointer (a zero GEP of the `ptr`
// parameter in place of its alloca, with no zero-fill and no copy into it); on x86-64
// (the copy arrives on the stack as a byval) the slot stays an alloca.
func TestParamSlotInPlaceAA64() testing.TestResult {
	var aa @[]char = compileForArch(inPlaceSrc(), types.ARCH_AA64)
	if !hasInPlaceSlotDecl(aa) {
		return fail("aarch64: the parameter's slot must be its incoming pointer")
	}
	if contains(aa, ".fz0_dp") { return fail("aarch64: an in-place parameter slot gets no zero-fill") }
	var x @[]char = compileForArch(inPlaceSrc(), types.ARCH_X64)
	if hasInPlaceSlotDecl(x) { return fail("x86-64 keeps the parameter's own slot") }
	return ""
}
