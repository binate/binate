package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emit_param_in_place.bn: a >16-byte by-value parameter read only through
// its slot uses the incoming copy (the caller's on aarch64, the byval one elsewhere)
// as the slot.

// inPlaceSrc is a function taking a struct of five ints (over 16 bytes on every
// target) by value and writing to it.
func inPlaceSrc() *[]readonly char {
	return "package \"main\"\n"
			"type Q struct { a int\n b int\n c int\n d int\n e int }\n"
			"func bump(q Q) int {\n"
			"\tq.a = q.a + 1\n"
			"\treturn q.a + q.d\n"
			"}\n"
			"func main() {}\n"
}

// compileForArch compiles src for a target of the given architecture (ILP32 on
// arm32, 64-bit otherwise).
func compileForArch(src *[]readonly char, arch int) @[]char {
	var saved types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	if arch == types.ARCH_ARM32 {
		t.PointerSize = 4
		t.IntSize = 4
	}
	t.MaxAlign = 8
	t.Arch = arch
	types.SetTarget(t)
	var out @[]char = compileToLLVM(src)
	types.SetTarget(saved)
	return out
}

// hasInPlaceSlotDecl reports whether out defines a slot as a parameter's incoming
// pointer: a `getelementptr i8, ptr %v<N>, i64 0` line (emitInPlaceSlotDecl).
func hasInPlaceSlotDecl(out *[]readonly char) bool {
	var pre *[]readonly char = " = getelementptr i8, ptr %v"
	for i := 0; i + len(pre) <= len(out); i++ {
		var j int = 0
		for j < len(pre) && out[i + j] == pre[j] { j++ }
		if j < len(pre) { continue }
		var k int = i + len(pre)
		for k < len(out) && out[k] >= '0' && out[k] <= '9' { k++ }
		var suf *[]readonly char = ", i64 0\n"
		var m int = 0
		for m < len(suf) && k + m < len(out) && out[k + m] == suf[m] { m++ }
		if m == len(suf) { return true }
	}
	return false
}

// On aarch64 (a pointer to the caller's copy), x86-64 and arm32 (a byval copy) alike
// the parameter's slot is the incoming pointer: a zero GEP of the parameter in place
// of its alloca, with no zero-fill and no copy into it.
func TestParamSlotInPlace() testing.TestResult {
	var archs @[]int = make_slice(int, 3)
	archs[0] = types.ARCH_AA64
	archs[1] = types.ARCH_X64
	archs[2] = types.ARCH_ARM32
	for i := 0; i < len(archs); i++ {
		var out @[]char = compileForArch(inPlaceSrc(), archs[i])
		if !hasInPlaceSlotDecl(out) { return fail("the parameter's slot must be its incoming pointer") }
		if contains(out, ".fz0_dp") { return fail("an in-place parameter slot gets no zero-fill") }
	}
	return ""
}

// A closure capturing a Q: on x86-64 and arm32 the capture arrives as a byval copy the
// body owns, so its slot is that copy; on aarch64 it is a pointer into the closure
// record, which the body must not write, so its slot keeps a copy of its own.
func TestCaptureSlotInPlace() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"type Q struct { a int\n b int\n c int\n d int\n e int }\n"
			"func main() {\n"
			"\tvar w Q\n"
			"\tvar f *func() int = func() int {\n"
			"\t\tw.a = w.a + 1\n"
			"\t\treturn w.a + w.e\n"
			"\t}\n"
			"\t_ = f\n"
			"}\n"
	if !hasInPlaceSlotDecl(compileForArch(src, types.ARCH_X64)) {
		return fail("x86-64: a byval capture's slot must be its incoming copy")
	}
	if !hasInPlaceSlotDecl(compileForArch(src, types.ARCH_ARM32)) {
		return fail("arm32: a byval capture's slot must be its incoming copy")
	}
	if hasInPlaceSlotDecl(compileForArch(src, types.ARCH_AA64)) {
		return fail("aarch64: a capture's slot must not be the closure record")
	}
	return ""
}
