package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Phi-predecessor exit-label resolution for the LLVM backend.
//
// An LLVM phi names each incoming value's PREDECESSOR block.  The IR gives a phi
// its predecessors as IR blocks (PhiEntry.Block), but the LLVM backend splits any
// block that emits an inline nil-check / bounds-check diamond into a TRAILING
// sub-block (ri.<n>.skip / rd.<n>.skip for RefInc/RefDec, bc.<n>.ok for a bounds
// check) — so the block's terminator, and thus the real LLVM predecessor of any phi
// it feeds, is that trailing sub-block, not the block's own Label.  Emitting the IR
// label verbatim yields "PHI node entries do not match predecessors" (clang rejects
// it).  This is the LLVM backend's problem alone: the native backends and the VM run
// ir.EliminatePhis (phis -> OP_COPY moves) and never emit an LLVM phi, so they are
// unaffected.

// curBlocks / curBlockExitLabels are parallel per-function arrays (in f.Blocks
// order): curBlockExitLabels[i] is the label a successor's phi must name for the
// predecessor curBlocks[i].  Set by assignBlockExitLabels; read by blockExitLabel.
var curBlocks @[]@ir.Block

// curBlockExitLabels[i] is the exit label of curBlocks[i] (see curBlocks).
var curBlockExitLabels @[]@[]char

// curBlockExitSeqEnd is the tmpSeq value assignBlockExitLabels predicts the body
// emission will reach; assertExitSeqConsumed checks the emitter actually hit it,
// so a future block-splitting op that consumes tmpSeq without being mirrored here
// fails loud instead of silently corrupting phi predecessor labels again.
var curBlockExitSeqEnd int

// assignBlockExitLabels precomputes each block's phi-predecessor exit label for
// function f.  Called after `tmpSeq = 0` and BEFORE the body is emitted, so a
// back-edge phi (a loop header emitted before its latch) can still resolve the
// latch's exit label.  It mirrors the emitter's tmpSeq assignment exactly: the
// block-splitting ops are OP_REFINC / OP_REFDEC (trailing ri.<n>.skip / rd.<n>.skip
// — see emitRefIncInline / emitRefDecInline) and OP_BOUNDS_CHECK (trailing bc.<n>.ok
// — see emitBoundsCheckInline), one tmpSeq each, walked in the same block+instr
// order the body loop uses.  assertExitSeqConsumed catches any future splitting op
// that consumes tmpSeq without being mirrored here.
func assignBlockExitLabels(f @ir.Func) {
	curBlocks = f.Blocks
	var labels @[]@[]char
	var seq int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		var exit @[]char = b.Label
		for ii := 0; ii < len(b.Instrs); ii++ {
			var op int = b.Instrs[ii].Op
			if op == iropcode.OP_REFINC {
				exit = splitContLabel("ri.", seq, ".skip")
				seq = seq + 1
			} else if op == iropcode.OP_REFDEC {
				exit = splitContLabel("rd.", seq, ".skip")
				seq = seq + 1
			} else if op == iropcode.OP_BOUNDS_CHECK {
				exit = splitContLabel("bc.", seq, ".ok")
				seq = seq + 1
			}
		}
		labels = slices.Append[@[]char](labels, exit)
	}
	curBlockExitLabels = labels
	curBlockExitSeqEnd = seq
}

// splitContLabel builds "<prefix><seq><suffix>" (e.g. "ri.3.skip", "bc.7.ok"),
// matching the trailing sub-block label the inline emitter leaves active
// (emitRefIncInline / emitRefDecInline end on .skip; emitBoundsCheckInline on .ok).
func splitContLabel(prefix @[]char, seq int, suffix @[]char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(prefix)
	stringutils.WriteInt(b, seq)
	b.Write(suffix)
	return buf.CopyStr(b.String())
}

// blockExitLabel returns b's phi-predecessor exit label — the split terminal when
// b emitted a RefInc/RefDec or bounds-check diamond, else b.Label.  Linear scan of
// curBlocks by identity; the per-function block count is small.  Falls back to
// b.Label if b is not a current-function block (defensive — every phi predecessor is).
func blockExitLabel(b @ir.Block) @[]char {
	for k := 0; k < len(curBlocks); k++ {
		if same(curBlocks[k], b) {
			return curBlockExitLabels[k]
		}
	}
	return b.Label
}

// assertExitSeqConsumed fails loud if the body emission's tmpSeq diverged from
// what assignBlockExitLabels predicted — i.e. a split-generating op was added
// without mirroring it here, which would silently corrupt phi predecessor labels.
func assertExitSeqConsumed() {
	if tmpSeq != curBlockExitSeqEnd {
		panic(
				"codegen: phi exit-label pre-pass drifted from tmpSeq (a new block-splitting op must be mirror"
						"ed in assignBlockExitLabels)")
	}
}
