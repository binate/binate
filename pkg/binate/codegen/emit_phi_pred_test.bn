package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for phi-predecessor exit-label resolution (emit_phi_pred.bn).

// TestSplitContLabel checks splitContLabel builds the "<prefix><seq><suffix>" form
// the inline diamonds leave active (.skip for RefInc/RefDec, .ok for a bounds check).
func TestSplitContLabel() testing.TestResult {
	if !seq(splitContLabel("ri.", 3, ".skip"), "ri.3.skip") {
		return fail("expected ri.3.skip")
	}
	if !seq(splitContLabel("rd.", 0, ".skip"), "rd.0.skip") {
		return fail("expected rd.0.skip")
	}
	if !seq(splitContLabel("bc.", 7, ".ok"), "bc.7.ok") {
		return fail("expected bc.7.ok")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitPhiPredSplitBlock checks that when a phi's predecessor block emitted an
// inline RefInc/RefDec diamond (splitting it into ri.<n>.skip / rd.<n>.skip
// sub-blocks), the phi names that split TERMINAL as its predecessor — not the
// block's own label.  A `@[]int` param's entry RefInc splits `entry.0`, so the
// loop-header induction phi's incoming edge must come from `ri.<n>.skip`.  Emitting
// `%entry.0` verbatim is invalid LLVM ("PHI node entries do not match
// predecessors" — clang rejects it).
func TestEmitPhiPredSplitBlock() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func sum(s @[]int) int {\n"
			"\tvar t int = 0\n"
			"\tfor i := 0; i < len(s); i = i + 1 {\n"
			"\t\tt = t + s[i]\n"
			"\t}\n"
			"\treturn t\n"
			"}\n"
	var out @[]char = compileToLLVMOpt(src, 2)
	if !contains(out, "= phi ") {
		return fail("expected a phi (mem2reg should promote the induction var at -O2)")
	}
	// entry.0 split for the param RefInc, so no phi may name it as a predecessor.
	if contains(out, ", %entry.0 ]") {
		return fail("phi names the pre-split entry.0 label; must be the ri.<n>.skip split terminal")
	}
	// The induction phi's preheader edge must come from the split terminal.
	if !contains(out, ".skip ]") {
		return fail("expected a phi predecessor to be a split .skip terminal")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitPhiPredBoundsCheckSplit checks the bounds-check analogue of
// TestEmitPhiPredSplitBlock: when a phi's predecessor block emitted an inline
// bounds-check diamond (splitting it into bc.<n>.ok), the phi names that split
// TERMINAL — not the block's own label.  The then-branch `s[j]` (a raw-slice,
// loop-invariant index, so the check is not eliminated) splits the then-block to
// bc.<n>.ok, which is the direct predecessor of the join-point phi for t.
// Emitting the pre-split label yields "PHI node entries do not match predecessors"
// (clang rejects it).  Runs at -O1 so mem2reg produces the join phi.
func TestEmitPhiPredBoundsCheckSplit() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func f(s *[]int, j int, c bool) int {\n"
			"\tvar t int = 0\n"
			"\tif c {\n"
			"\t\tt = s[j]\n"
			"\t} else {\n"
			"\t\tt = 99\n"
			"\t}\n"
			"\treturn t\n"
			"}\n"
	var out @[]char = compileToLLVMOpt(src, 1)
	if !contains(out, "= phi ") {
		return fail("expected a join phi (mem2reg should promote t at -O1)")
	}
	if !contains(out, "bc.") {
		return fail("expected a surviving inline bounds check (raw-slice s[j] is not eliminable)")
	}
	// The phi's then-edge must name the bc.<n>.ok split terminal, not the
	// pre-split then-block label.  A phi entry ends "%<label> ]"; only the
	// bounds-check split leaves a ".ok" terminal (branches use "label %...ok").
	if !contains(out, ".ok ]") {
		return fail("phi must name the bc.<n>.ok split terminal as the then-branch predecessor")
	}
	var pass testing.TestResult
	return pass
}
