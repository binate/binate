package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the OP_PHI lowering (emit_instr.bn).  A phi lowers to an LLVM
// `phi <type> [ val, %pred ], ...` with one entry per predecessor.  Phase P
// adds this so a future SSA-promotion pass (mem2reg) can emit phis; nothing in
// the compiler emits OP_PHI yet, so these hand-build the IR.

// TestEmitPhiDiamond lowers a diamond CFG whose merge block joins two constants
// via a phi, and checks the emitted LLVM carries the phi over both predecessor
// labels.
func TestEmitPhiDiamond() testing.TestResult {
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "phitest", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")

	var cond @ir.Instr = entry.EmitConstBool(true)
	entry.EmitBranch(cond, thenB, elseB)

	var a @ir.Instr = thenB.EmitConstInt(10, types.TypInt())
	thenB.EmitJump(merge)
	var b @ir.Instr = elseB.EmitConstInt(20, types.TypInt())
	elseB.EmitJump(merge)

	var pe1 ir.PhiEntry
	pe1.Block = thenB
	pe1.Val = a
	var pe2 ir.PhiEntry
	pe2.Block = elseB
	pe2.Val = b
	var entries @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	entries[0] = pe1
	entries[1] = pe2
	var phi @ir.Instr = merge.EmitPhi(types.TypInt(), entries)

	var retVals @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retVals[0] = phi
	merge.EmitReturn(retVals)

	m.AddFunc(f)
	var out @[]char = EmitModule(m)
	if !contains(out, "= phi i64 ") {
		return fail("expected an LLVM 'phi i64' instruction")
	}
	// Both incoming edges: value operand + predecessor label (labels are
	// suffixed with the block index, so match the prefix).
	if !contains(out, ", %then.") {
		return fail("expected the 'then' predecessor label in the phi")
	}
	if !contains(out, ", %else.") {
		return fail("expected the 'else' predecessor label in the phi")
	}
	if !contains(out, "[ %v") {
		return fail("expected SSA value operands in the phi entries")
	}
	return ""
}
