package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// emitPackageDescriptor emits the per-package reflect descriptor — an immortal
// static-managed `reflect.Package` node holding the package name plus its
// Functions/Globals/Vtables tables (each a row of static-managed info nodes +
// a backing pointer array), and the generated `__Package()` accessor that
// returns it.
//
// The ENTIRE descriptor's byte layout — every rodata blob, info node, backing
// array, the descriptor node, and the name bytes — is built once by
// irdata.BuildPackageDescriptors (the single source of truth) and lowered through
// the shared emitDataGlobal, the SAME terms the native backend lowers, so the
// two backends cannot drift.  This LLVM gather only resolves the symbol names
// + payload scalars per row; it knows nothing of the byte layout.
//
// Emitted for every module; an unreferenced `__Package` (and its nodes + arrays
// + name) is dead-stripped by the linker, so unconditional emission is free.
func emitPackageDescriptor(out *strings.Builder, m @ir.Module) {
	var nameSym @[]char = mangle.GlobalName(modulePkgName, "_pkgname")
	var infoSym @[]char = mangle.GlobalName(modulePkgName, "_pkg_info")
	var funcSym @[]char = mangle.FuncName(modulePkgName, "__Package")
	var funcsArraySym @[]char = mangle.GlobalName(modulePkgName, "_pkg_funcs")
	var globalsArraySym @[]char = mangle.GlobalName(modulePkgName, "_pkg_globals")
	var vtablesArraySym @[]char = mangle.GlobalName(modulePkgName, "_pkg_vtables")
	var satentriesArraySym @[]char = mangle.GlobalName(modulePkgName, "_pkg_satentries")

	// Gather the table rows (LLVM-mangled symbol names + payload scalars), then
	// lay the whole descriptor through the shared builder + emitter.
	var funcs @[]@irdata.PkgFuncEntry = collectPackageFuncs(m, infoSym)
	var globals @[]@irdata.PkgGlobalEntry = collectPackageGlobals(m)
	var vtables @[]@irdata.PkgVtableEntry = collectPackageVtables(m)
	var satEntrySyms @[]@[]char = collectPackageSatEntries(m)

	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			STATIC_MANAGED_REFCOUNT, infoSym, nameSym, buf.CopyStr(modulePkgName), funcsArraySym, funcs,
			globalsArraySym, globals, vtablesArraySym, vtables, satentriesArraySym, satEntrySyms)
	for i := 0; i < len(dgs); i++ {
		emitDataGlobal(out, dgs[i])
	}

	// The per-package `_pkg_satfrag` graph node (decentralized satentry
	// enumeration) — emitted after the descriptor so this module's own
	// `_pkg_satentries` (which it points at) is already defined.
	emitPkgSatFrag(out, m, satentriesArraySym, len(satEntrySyms))

	// The __Package() accessor: returns the node's payload pointer (the
	// @reflect.Package value), past the 2-word managed header.
	out.Write("define ptr @")
	out.Write(funcSym)
	out.Write("()")
	writeFnDefineAttrs(out)
	out.Write(" {\nentry:\n  ret ptr ")
	staticManagedPayloadPtr(out, infoSym, packagePayloadTy())
	out.Write("\n}\n")
	return
}

// emitPkgSatFrag emits this package's `_pkg_satfrag` graph node: entriesPtr (=
// `satentriesArraySym` when `ownCount > 0`, else null) + ownCount, then symrefs
// to its DIRECT dependencies' `_pkg_satfrag` nodes.  Each dep frag is declared
// `external` (a STRONG undefined ref): every compiled package emits a node, so
// the ref always resolves; and a strong ref pulls the defining object from a
// static archive (the opaque-binary-distribution goal) and fails loud if a
// dependency ever emits no node, rather than silently dropping its satentries.
// No auto-declare pass exists for an undefined data symref, so each cross-object
// dep frag needs its own `external global` declaration here.  A dep equal to this
// module's own path is skipped — it would collide the extern decl with the definition.
func emitPkgSatFrag(out *strings.Builder, m @ir.Module, satentriesArraySym @[]char, ownCount int) {
	var fragSym @[]char = mangle.GlobalName(modulePkgName, "_pkg_satfrag")
	// Direct-dependency frag symbols, from this module's EFFECTIVE import set
	// (m.ImportAliasPaths — includes the compiler-injected rt/lang/expose-closure,
	// so e.g. a primitive's lang-provided satentries stay reachable), deduped so a
	// path reached via two aliases yields one edge + one external decl, and with
	// this module's own path skipped (a self-edge would redefine fragSym).
	var depFragSyms @[]@[]char
	for i := 0; i < len(m.ImportAliasPaths); i++ {
		if pathSeen(m.ImportAliasPaths, i) { continue }
		if charsEqual(m.ImportAliasPaths[i], modulePkgName) { continue }
		depFragSyms = slices.Append[@[]char](depFragSyms,
				mangle.GlobalName(m.ImportAliasPaths[i], "_pkg_satfrag"))
	}
	for i := 0; i < len(depFragSyms); i++ {
		out.Write("@")
		out.Write(depFragSyms[i])
		out.Write(" = external global i8\n")
	}
	var dgs @[]@irdata.DataGlobal = irdata.BuildPkgSatFrag(fragSym, satentriesArraySym, ownCount,
			depFragSyms)
	for i := 0; i < len(dgs); i++ {
		emitDataGlobal(out, dgs[i])
	}
	return
}

// pathSeen reports whether paths[idx] already appears at a lower index — a
// first-occurrence dedup so a package imported under two aliases yields one edge.
func pathSeen(paths @[]@[]char, idx int) bool {
	for i := 0; i < idx; i++ {
		if charsEqual(paths[i], paths[idx]) { return true }
	}
	return false
}

// collectPackageSatEntries gathers the SatEntries table's node symbols: the
// raw (LLVM, unprefixed) `__satentry.<T,J>` symbol per distinct (T, J) in the
// module (ir.CollectSatEntries) — the same nodes emitSatEntries emits.  The
// descriptor's backing array points at each (past its managed header).
func collectPackageSatEntries(m @ir.Module) @[]@[]char {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(m)
	var syms @[]@[]char
	for i := 0; i < len(descs); i++ {
		syms = slices.Append[@[]char](syms, descs[i].Sym)
	}
	return syms
}

// collectPackageFuncs gathers the reflect.FunctionInfo rows: one per
// `.bni`-exported, non-extern function (the same set codegen force-emits a
// func-value `__handle` for, so Value resolves) plus own-package struct dtors,
// and — last, when reflect was loaded (PackageAccessorSig set) — the
// compiler-synthesized `__Package` accessor itself, so reflection on any package
// surfaces its own `__Package`.  `infoSym` is the package node (each
// FunctionInfo's Pkg back-points at its payload).
func collectPackageFuncs(m @ir.Module, infoSym @[]char) @[]@irdata.PkgFuncEntry {
	var funcs @[]@irdata.PkgFuncEntry
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (IsStructDtor) + lang's primitive methods
		// (IsPrimitiveMethod, reached by direct call), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsPrimitiveMethod { continue }
		var fv @types.Type = lookupFuncValueType(m, f.Name)
		if fv == nil { continue }
		var mangled @[]char = mangle.FuncName(modulePkgName, f.Name)
		// f.Name is already the FULLY-QUALIFIED "pkg/path.Func" (NewFunc applies
		// mangle.QualifyName), the form the VM binder keys on — use it verbatim.
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs, funcEntry(infoSym, mangled, f.Name, fv))
	}
	// Self-list the `__Package` accessor (mirrors the native gather).  Name is
	// the FQ `<pkg>.__Package` (the VM lookup key); the mangled symbol routes the
	// same dotted name through FuncName to the descriptor funcSym.  Its
	// func-value triple is force-emitted by addPackageAccessorToSeen.
	if m.PackageAccessorSig != nil {
		var fvP @types.Type = m.PackageAccessorSig
		var nameP @[]char = mangle.QualifyName(modulePkgName, "__Package")
		var mangledP @[]char = mangle.FuncName(modulePkgName, nameP)
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs, funcEntry(infoSym, mangledP, nameP, fvP))
	}
	return funcs
}

// funcEntry builds one FunctionInfo row from a func-value type: the
// __fninfo/__fnname/__fnsig symbols off `mangled`, the @__handle.<mangled>
// Value target, and the VM-dispatch RetbufSize (the aggregate retbuf size, or
// 0 for a scalar/void return) + ParamSlots.
func funcEntry(infoSym @[]char, mangled *[]readonly char, name *[]readonly char,
		fv @types.Type) @irdata.PkgFuncEntry {
	return irdata.NewPkgFuncEntry(catSym(mangled, "__fninfo"), catSym(mangled, "__fnname"),
			buf.CopyStr(name), catSym(mangled, "__fnsig"), buf.CopyStr(fv.SigString()),
			catSym("__handle.", mangled), types.AggregateReturnSize(fv.Results), len(fv.Params))
}

// collectPackageGlobals gathers the reflect.GlobalInfo rows: one per
// `.bni`-exported, non-extern package-level global.  A package's OWN global
// carries a BARE g.Name; the VM keys lookupGlobalAddr on the FULLY-QUALIFIED
// form (what materializeGlobals stores), so the Name is qualified.  Addr is the
// global's own storage cell (a `var` cell — no managed header).
func collectPackageGlobals(m @ir.Module) @[]@irdata.PkgGlobalEntry {
	var globals @[]@irdata.PkgGlobalEntry
	for i := 0; i < len(m.Globals); i++ {
		var g @ir.Global = m.Globals[i]
		// Imported extern vars are owned by their defining package.
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var fqName @[]char = mangle.QualifyName(modulePkgName, g.Name)
		var globalSym @[]char = mangle.GlobalName(modulePkgName, g.Name)
		globals = slices.Append[@irdata.PkgGlobalEntry](globals,
				irdata.NewPkgGlobalEntry(catSym(globalSym, "__glinfo"), catSym(globalSym, "__glname"), fqName,
						globalSym))
	}
	return globals
}

// collectPackageVtables gathers the reflect.VtableInfo rows: one per NON-generic
// `impl` this package compiles.  Generic-impl instantiations are excluded
// (recvTypeIsGenericInst) — a bytecode importer re-lowers its own copy, so the
// native one is never consulted by name.  Name is the BARE canonical vtable
// name (the VM's findIfaceVtable / BC_IFACE_VALUE key); Addr/ShimAddr target the
// `@__ivt` / `@__ivtshim` globals directly (constant arrays, no header).
func collectPackageVtables(m @ir.Module) @[]@irdata.PkgVtableEntry {
	var vtables @[]@irdata.PkgVtableEntry
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		if recvTypeIsGenericInst(info.RecvTypeName) { continue }
		var vtName @[]char = implVtableName(info)
		var shimName @[]char = implShimVtableName(info)
		vtables = slices.Append[@irdata.PkgVtableEntry](vtables,
				irdata.NewPkgVtableEntry(catSym(vtName, "__vtinfo"), catSym(vtName, "__vtname"), vtName, vtName,
						shimName, vtableSlotCountForInfo(m, info)))
	}
	return vtables
}

// recvTypeIsGenericInst reports whether an impl's receiver type name is a
// monomorphized generic instantiation (the `__bn_inst__` marker).  Delegates to
// mangle.IsInstantiationName — the single source shared with the native gather.
func recvTypeIsGenericInst(recvName *[]readonly char) bool {
	return mangle.IsInstantiationName(recvName)
}

// catSym concatenates two (borrowed) name fragments into a fresh owned symbol —
// e.g. catSym(mangled, "__fninfo") or catSym("__handle.", mangled).
func catSym(a *[]readonly char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(a)
	cb.Write(b)
	return buf.CopyStr(cb.String())
}

// packagePayloadTy returns the reflect.Package payload LLVM type:
// { Name, Functions, Globals, Vtables, SatEntries } = five raw slices
// { ptr, <int> }.  Used by the __Package() accessor's payload GEP (the
// descriptor's byte layout itself lives in irdata.BuildPackageDescriptors).
func packagePayloadTy() @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("{ ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(" }")
	return buf.CopyStr(b.String())
}
