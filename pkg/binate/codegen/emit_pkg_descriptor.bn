package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/std/strings"

// emitPackageDescriptor emits the per-package reflect descriptor — an
// immortal static-managed `reflect.Package` node holding the package name
// plus its Functions/Globals/Vtables tables, and the generated `_Package()`
// accessor that returns it.  Phase B of notes-package-introspection.md.
//
// The descriptor NODE and the package-name bytes are built once by
// ir.BuildPackageDescriptor (the single source of truth for that layout) and
// lowered through the shared emitDataGlobal — the SAME terms the native
// backend lowers, so the two backends cannot drift (the bound this replaces:
// the old hand-rolled node layout duplicated here and in
// native/common/common_pkg_descriptor.bn).  The per-entry info-node tables +
// their backing arrays are still emitted by the per-kind emitters below; the
// node references the array symbols by name.
//
// Emitted for every module; an unreferenced `_Package` (and its node + name)
// is dead-stripped by the linker, so unconditional emission is free.
func emitPackageDescriptor(out *strings.Builder, m @ir.Module) {
	var nameSym @[]char = mangle.GlobalName(modulePkgName, "_pkgname")
	var infoSym @[]char = mangle.GlobalName(modulePkgName, "_pkg_info")
	var funcSym @[]char = mangle.FuncName(modulePkgName, "_Package")
	var funcsArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_funcs")
	var globalsArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_globals")
	var vtablesArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_vtables")

	// reflect.Package payload LLVM type — { Name, Functions, Globals, Vtables }
	// as four flattened raw slices — used by the per-kind info-node emitters'
	// Pkg back-pointer GEP and by the _Package() accessor's payload GEP.
	var payloadTyStr @[]char = packagePayloadTy()

	// Info-node tables + their backing arrays (still per-kind emitters); the
	// descriptor node references the array symbols by name.  A zero count
	// emits nothing and leaves that descriptor table slice { null, 0 }.
	var funcCount int = emitPackageFunctions(out, m, infoSym, payloadTyStr,
		funcsArraySym)
	var globalCount int = emitPackageGlobals(out, m, globalsArraySym)
	var vtableCount int = emitPackageVtables(out, m, vtablesArraySym)

	// The descriptor node + the package-name bytes, built once and lowered
	// through the shared emitDataGlobal.
	var dgs @[]@ir.DataGlobal = ir.BuildPackageDescriptor(
		STATIC_MANAGED_REFCOUNT, infoSym, nameSym, buf.CopyStr(modulePkgName),
		funcsArraySym, funcCount, globalsArraySym, globalCount,
		vtablesArraySym, vtableCount)
	for i := 0; i < len(dgs); i++ {
		emitDataGlobal(out, dgs[i])
	}

	// The _Package() accessor: returns the node's payload pointer (the
	// @reflect.Package value), past the 2-word managed header.
	out.Write("define ptr @")
	out.Write(funcSym)
	out.Write("() {\nentry:\n  ret ptr ")
	staticManagedPayloadPtr(out, infoSym, payloadTyStr)
	out.Write("\n}\n")
	return
}

// packagePayloadTy returns the reflect.Package payload LLVM type:
// { Name, Functions, Globals, Vtables } = four raw slices { ptr, <int> }.
func packagePayloadTy() @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("{ ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(", ptr, ")
	b.Write(intLL())
	b.Write(" }")
	return buf.CopyStr(b.String())
}
