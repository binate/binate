package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"

// emitPackageDescriptor emits the per-package reflect descriptor — an
// immortal static-managed `reflect.Package` node holding the package name,
// plus the generated `_Package()` accessor that returns it.  Phase B of
// notes-package-introspection.md / plan-static-managed-sentinel.md.
//
// Self-contained in codegen: the payload is just reflect.Package's layout
// — `{ ptr, <int> }` for the `Name *[]readonly char` raw slice — so no reflect
// type needs to be loaded here.  The type checker independently synthesizes
// the `_Package() @reflect.Package` signature (so `pkg._Package()` calls
// type-check) against the SAME mangled name; the two halves must agree on
// the symbol name and the payload layout.
//
// Emitted for every module.  Until the type-checker half lands (and after
// it, for any package whose `_Package` nobody calls), `_Package` is
// unreferenced and the linker — now dead-stripping — drops it together with
// the node and name string, so unconditional emission costs nothing for
// unused descriptors.
func emitPackageDescriptor(out *buf.Builder, m @ir.Module) {
	var nameLen int = len(modulePkgName)

	var nameSym @[]char = mangle.GlobalName(modulePkgName, "_pkgname")
	var infoSym @[]char = mangle.GlobalName(modulePkgName, "_pkg_info")
	var funcSym @[]char = mangle.FuncName(modulePkgName, "_Package")
	var funcsArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_funcs")
	var globalsArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_globals")
	var vtablesArraySym @[]char =
		mangle.GlobalName(modulePkgName, "_pkg_vtables")

	// reflect.Package payload LLVM type: { Name, Functions, Globals, Vtables }
	// — four raw slices, each a { data pointer, length } pair flattened into the
	// payload struct, so { ptr, <int>, ptr, <int>, ptr, <int>, ptr, <int> }.
	// Functions is the exported-function table; Globals the exported-global
	// table; Vtables the interface-impl vtable table — each emitted empty
	// {null, 0} until its emitter populates it (must stay in field order with
	// reflect.Package).
	var payloadTy @buf.Builder = buf.NewBuilder()
	payloadTy.Write("{ ptr, ")
	payloadTy.Write(intLL())
	payloadTy.Write(", ptr, ")
	payloadTy.Write(intLL())
	payloadTy.Write(", ptr, ")
	payloadTy.Write(intLL())
	payloadTy.Write(", ptr, ")
	payloadTy.Write(intLL())
	payloadTy.Write(" }")
	var payloadTyStr @[]char = buf.CopyStr(payloadTy.String())

	// 1. Package-name rodata bytes.
	out.Write("@")
	out.Write(nameSym)
	out.Write(" = private unnamed_addr constant [")
	buf.WriteInt(out, nameLen)
	out.Write(" x i8] ")
	if nameLen == 0 {
		out.Write("zeroinitializer")
	} else {
		out.Write("c\"")
		emitStringBytes(out, modulePkgName)
		out.Write("\"")
	}
	out.Write(", align 1\n")

	// 2. The exported-function FunctionInfo table (per-func static-managed
	//    nodes + the @<pkg>_pkg_funcs pointer array), emitted BEFORE the
	//    package node so Functions can point at the array.  funcCount == 0
	//    (no exported funcs) emits nothing and leaves Functions {null, 0}.
	var funcCount int = 0
	funcCount = emitPackageFunctions(out, m, infoSym, payloadTyStr,
		funcsArraySym)
	// The exported-global GlobalInfo table (static-managed nodes + the
	// @<pkg>_pkg_globals pointer array), emitted before the package node so
	// Globals can point at the array.  globalCount == 0 leaves Globals {null, 0}.
	var globalCount int = 0
	globalCount = emitPackageGlobals(out, m, globalsArraySym)
	// The interface-impl VtableInfo table (static-managed nodes + the
	// @<pkg>_pkg_vtables pointer array), emitted before the package node so
	// Vtables can point at the array.  vtableCount == 0 leaves Vtables {null, 0}.
	var vtableCount int = 0
	vtableCount = emitPackageVtables(out, m, vtablesArraySym)

	// 3. The reflect.Package payload init: { Name.data, Name.len,
	//    Functions.data, Functions.len, Globals.data, Globals.len } —
	//    Functions points at the array above when non-empty, else the empty
	//    raw slice {null, 0}; Globals is empty until the globals emitter
	//    populates it.
	var payloadInit @buf.Builder = buf.NewBuilder()
	payloadInit.Write("{ ptr @")
	payloadInit.Write(nameSym)
	payloadInit.Write(", ")
	payloadInit.Write(intLL())
	payloadInit.WriteByte(' ')
	buf.WriteInt(payloadInit, nameLen)
	if funcCount == 0 {
		payloadInit.Write(", ptr null, ")
		payloadInit.Write(intLL())
		payloadInit.Write(" 0")
	} else {
		payloadInit.Write(", ptr @")
		payloadInit.Write(funcsArraySym)
		payloadInit.Write(", ")
		payloadInit.Write(intLL())
		payloadInit.WriteByte(' ')
		buf.WriteInt(payloadInit, funcCount)
	}
	// Globals raw slice — points at the @<pkg>_pkg_globals array when the
	// package has exported globals, else the empty raw slice {null, 0}.
	if globalCount == 0 {
		payloadInit.Write(", ptr null, ")
		payloadInit.Write(intLL())
		payloadInit.Write(" 0")
	} else {
		payloadInit.Write(", ptr @")
		payloadInit.Write(globalsArraySym)
		payloadInit.Write(", ")
		payloadInit.Write(intLL())
		payloadInit.WriteByte(' ')
		buf.WriteInt(payloadInit, globalCount)
	}
	// Vtables raw slice — points at the @<pkg>_pkg_vtables array when the
	// package defines impls, else the empty raw slice {null, 0}.
	if vtableCount == 0 {
		payloadInit.Write(", ptr null, ")
		payloadInit.Write(intLL())
		payloadInit.Write(" 0 }")
	} else {
		payloadInit.Write(", ptr @")
		payloadInit.Write(vtablesArraySym)
		payloadInit.Write(", ")
		payloadInit.Write(intLL())
		payloadInit.WriteByte(' ')
		buf.WriteInt(payloadInit, vtableCount)
		payloadInit.Write(" }")
	}

	// 4. The immortal static-managed node (sentinel refcount header +
	//    the reflect.Package payload).
	emitStaticManagedGlobal(out, infoSym, payloadTyStr, buf.CopyStr(payloadInit.String()))

	// 5. The _Package() accessor: returns the node's payload pointer (the
	//    @reflect.Package value).
	out.Write("define ptr @")
	out.Write(funcSym)
	out.Write("() {\nentry:\n  ret ptr ")
	staticManagedPayloadPtr(out, infoSym, payloadTyStr)
	out.Write("\n}\n")
	return
}
