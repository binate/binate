package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_pkg_descriptor.bn — the per-package reflect descriptor
// (immortal static-managed reflect.Package node + generated __Package()
// accessor).  Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// EmitModule must, for every module, emit the package-name rodata, the
// immortal static-managed reflect.Package node (sentinel refcount header +
// { Name.data, Name.len } payload), and the __Package() accessor returning a
// pointer to the node's payload.  Host build → i64 header/length words.
func TestEmitPackageDescriptor() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)

	// Package-name rodata: package "main" -> 4 bytes "main".
	if !contains(out, " x i8] c\"main\"") {
		return fail("expected package-name rodata c\"main\"")
	}
	// Immortal static-managed reflect.Package node (now an irdata.DataGlobal whose
	// terms flatten the header + payload into one struct): { i64, i64 } header
	// (negative sentinel refcount + zero free-fn), then the { Name, Functions,
	// Globals, Vtables, SatEntries } raw-slice payload, all flattened to
	// { i64, i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64 }.
	if !contains(out,
			"weak_odr constant { i64, i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64, "
					"ptr, i64 } "
					"{ i64 -1073741824, i64 0, ptr @") {
		return fail("expected immortal reflect.Package node with sentinel header")
	}
	// The empty Functions, Globals, Vtables, SatEntries raw slices trail the Name
	// pair, and the flattened node closes with a single brace + explicit align.
	if !contains(out,
			", ptr null, i64 0, ptr null, i64 0, ptr null, i64 0, "
					"ptr null, i64 0 }, align 8") {
		return fail("expected empty Functions + Globals + Vtables + SatEntries slices")
	}
	// Generated __Package() accessor (mangled bn_F<pkg>1_9___Package).
	if !contains(out, "bn_F1_4_main1_9___Package() {") {
		return fail("expected generated __Package() accessor")
	}
	// Its body returns the node's payload pointer (GEP to field 2).
	if !contains(out,
			"ret ptr getelementptr inbounds ({ i64, i64, "
					"{ ptr, i64, ptr, i64, ptr, i64, ptr, i64, ptr, i64 } }") {
		return fail("expected __Package() to return the node payload pointer")
	}
	return ""
}

// On a 32-bit target the descriptor's header words and the Name length
// narrow to i32 (the data pointer stays an opaque `ptr`).  Drives
// emitPackageDescriptor directly with a 32-bit target and a known package
// name; mirrors the target-aware checks in emit_static_managed_test.bn.
func TestEmitPackageDescriptorILP32() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var savedPkg *[]readonly char = modulePkgName
	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 4
	types.SetTarget(t32)
	modulePkgName = "main"
	var b @strings.Builder = strings.NewBuilder()
	// Empty module — no exported funcs, so Functions stays {null, 0} and the
	// ILP32 layout check below sees the empty-table form.
	emitPackageDescriptor(b, ir.NewModule("\"main\""))
	var out @[]char = buf.CopyStr(b.String())
	types.SetTarget(saved)
	modulePkgName = savedPkg
	if !contains(out,
			"weak_odr constant { i32, i32, ptr, i32, ptr, i32, ptr, i32, ptr, i32, "
					"ptr, i32 } "
					"{ i32 -1073741824, i32 0, ptr @") {
		return fail("expected i32 header/length words on a 32-bit target")
	}
	if !contains(out, "[4 x i8] c\"main\"") {
		return fail("expected package-name rodata on a 32-bit target")
	}
	return ""
}

// A module with one exported func must emit: its qualified-name + signature
// rodata, a FunctionInfo node referencing the @__handle, and a 1-entry funcs
// pointer array the package node's Functions field points at.
func TestEmitPackageFunctionsPopulated() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/x"

	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	var p0 @ir.Param = make(ir.Param)
	p0.Typ = types.TypInt()
	params[0] = p0
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "Foo", params, results)
	// NewFunc here gets an empty pkgPath, so "Foo" stays unqualified; pin
	// f.Name explicitly to the fully-qualified form that agrees with
	// modulePkgName — what real emission produces.
	f.Name = "pkg/x.Foo"
	f.Exported = true
	m.AddFunc(f)

	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	// FUNCTION-QUALIFIED name rodata "pkg/x.Foo" (f.Name verbatim).
	if !contains(out, "c\"pkg/x.Foo\"") {
		return fail("expected qualified-name rodata pkg/x.Foo")
	}
	// Signature rodata "(int)(int)".
	if !contains(out, "c\"(int)(int)\"") {
		return fail("expected signature rodata (int)(int)")
	}
	// A 1-entry funcs pointer array (DataGlobal flattens it to a 1-field struct).
	if !contains(out, "_pkg_funcs = weak_odr constant { ptr }") {
		return fail("expected 1-entry funcs pointer array")
	}
	// The package node's Functions field points at the array (len 1), trailed
	// by the empty Globals, Vtables, SatEntries raw slices {null, 0}.
	if !contains(out,
			"_pkg_funcs, i64 1, ptr null, i64 0, ptr null, i64 0, "
					"ptr null, i64 0 }, align 8") {
		return fail("expected Package.Functions -> { @..._pkg_funcs, 1 } then empties")
	}
	// FunctionInfo.Value references the force-emitted handle.
	if !contains(out, "ptr @__handle.") {
		return fail("expected FunctionInfo.Value -> @__handle")
	}
	return ""
}

// With PackageAccessorSig set (as registerCurrentModulePackageAccessor does
// for every reflect-loaded module), the module self-lists its own __Package
// accessor as an extra FunctionInfo entry appended AFTER the exported funcs.
// A module with one export Foo therefore emits a 2-entry table whose added
// entry is `pkg/x.__Package` carrying the reflect.Package signature, its Value
// pointing at the force-emitted @__handle (emit_funcvals.bn).  Guards the
// self-listing path independently of the PackageAccessorSig==nil guard that
// the empty/populated tests exercise.
func TestEmitPackageFunctionsSelfListsPackage() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/x"

	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	var p0 @ir.Param = make(ir.Param)
	p0.Typ = types.TypInt()
	params[0] = p0
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "Foo", params, results)
	f.Name = "pkg/x.Foo"
	f.Exported = true
	m.AddFunc(f)

	// Synthesize the __Package accessor's func-value type: func() @reflect.Package
	// — a managed pointer to a struct named exactly as the real reflect.Package,
	// so SigString produces the same `@pkg/builtins/reflect.Package` spelling.
	var noFields @[]@types.Field
	var reflectStruct @types.Type = types.MakeStructType("pkg/builtins/reflect.Package", noFields)
	var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
	pkgResults[0] = types.MakeManagedPtrType(reflectStruct)
	var noParams @[]@types.Param
	m.PackageAccessorSig = types.MakeFuncValueType(noParams, pkgResults)

	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if !contains(out, "c\"pkg/x.__Package\"") {
		return fail("expected __Package self-entry qualified-name rodata")
	}
	if !contains(out, "c\"()(@pkg/builtins/reflect.Package)\"") {
		return fail("expected __Package self-entry sig rodata")
	}
	// Two entries: Foo + the appended __Package self-entry.
	if !contains(out, "_pkg_funcs = weak_odr constant { ptr, ptr }") {
		return fail("expected 2-entry funcs array (Foo + __Package)")
	}
	// __Package FunctionInfo Value references its force-emitted handle.
	if !contains(out, "@__handle.bn_F2_3_pkg1_x1_9___Package") {
		return fail("expected __Package Value -> @__handle.bn_F2_3_pkg1_x1_9___Package")
	}
	return ""
}

// A multi-return exported func's FunctionInfo carries the tuple-struct
// SizeOf as RetbufSize (the load-bearing VM scalar/aggregate discriminator):
// (int64, int64) -> 16.  Exercises types.AggregateReturnSize's multi-return path.
func TestEmitPackageFunctionsMultiReturn() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/x"
	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypInt64()
	results[1] = types.TypInt64()
	var f @ir.Func = ir.NewFunc("", "MR", noParams, results)
	f.Name = "pkg/x.MR"
	f.Exported = true
	m.AddFunc(f)
	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg
	// FunctionInfo node payload: ... Value(ptr), RetbufSize=16, ParamSlots=0,
	// Sig(ptr) ...  -> "i64 16, i64 0, ptr @".
	if !contains(out, ", i64 16, i64 0, ptr @") {
		return fail("expected multi-return RetbufSize 16 + ParamSlots 0")
	}
	return ""
}

// A module with NO exported funcs emits no funcs array and leaves the
// package node's Functions field empty {null, 0}.
func TestEmitPackageFunctionsEmpty() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/y"
	var m @ir.Module = ir.NewModule("\"pkg/y\"")
	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg
	if contains(out, "_pkg_funcs = weak_odr constant") {
		return fail("empty module should emit no funcs array")
	}
	if !contains(out, ", ptr null, i64 0 }, align 8") {
		return fail("empty module Functions should be {null, 0}")
	}
	return ""
}

// A module with one exported, non-extern global must emit its FULLY-QUALIFIED
// name rodata (the form lookupGlobalAddr keys on — a package's OWN global
// carries a BARE g.Name, which the gather must qualify) and a globals pointer
// array the package node's Globals field points at.
func TestEmitPackageGlobalsPopulated() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/x"

	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var g @ir.Global = make(ir.Global)
	g.Name = "Sentinel" // BARE, as a package's own global carries.
	g.Typ = types.TypInt()
	g.Exported = true
	m.AddGlobal(g)

	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	// GlobalInfo Name rodata is the FULLY-QUALIFIED "pkg/x.Sentinel" (the bare
	// g.Name qualified) — NOT the bare "Sentinel" — so a bytecode cross-package
	// read resolves through lookupGlobalAddr.
	if !contains(out, "c\"pkg/x.Sentinel\"") {
		return fail("expected fully-qualified global-name rodata pkg/x.Sentinel")
	}
	// The globals pointer array (the Globals field's backing store).
	if !contains(out, "_pkg_globals = weak_odr") {
		return fail("expected the _pkg_globals pointer array")
	}
	return ""
}

// An unexported own global and an imported extern global must NOT appear in the
// GlobalInfo table: only the package's OWN exported globals are injectable.
func TestEmitPackageGlobalsSkipsUnexportedAndExtern() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "pkg/x"

	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var g1 @ir.Global = make(ir.Global) // unexported own global
	g1.Name = "internalCount"
	g1.Typ = types.TypInt()
	g1.Exported = false
	m.AddGlobal(g1)
	var g2 @ir.Global = make(ir.Global) // imported extern (owned elsewhere)
	g2.Name = "pkg/y.Imported"
	g2.Typ = types.TypInt()
	g2.Exported = true
	g2.IsExtern = true
	m.AddGlobal(g2)

	var b @strings.Builder = strings.NewBuilder()
	emitPackageDescriptor(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if contains(out, "internalCount") {
		return fail("unexported global must not appear in the GlobalInfo table")
	}
	if contains(out, "pkg/y.Imported") {
		return fail("imported extern global must not appear in the GlobalInfo table")
	}
	// No exported own globals → no globals array emitted; Globals stays {null,0}.
	if contains(out, "_pkg_globals = weak_odr") {
		return fail("module with no exported own globals must emit no globals array")
	}
	return ""
}

// A module declaring an interface impl must emit BOTH the raw @__ivt vtable and
// the parallel @__ivtshim shim vtable, plus the VtableInfo table the package
// descriptor's Vtables field points at.
func TestEmitPackageVtables() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface Greeter { Greet() int }\n"
			"type G struct { v int }\n"
			"impl *G : Greeter\n"
			"func (g *G) Greet() int { return g.v }\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)

	// The raw impl vtable (native-to-native dispatch reads its raw fn slots).
	if !contains(out, "@__ivt.bn_") {
		return fail("expected raw impl vtable @__ivt.bn_")
	}
	// The parallel shim vtable (method slots hold @__handle handles) the VM
	// dispatches an injected native-only package's iface methods through.
	if !contains(out, "@__ivtshim.bn_") {
		return fail("expected parallel shim vtable @__ivtshim.bn_")
	}
	// The VtableInfo pointer array backing reflect.Package.Vtables.
	if !contains(out, "_pkg_vtables = weak_odr") {
		return fail("expected the _pkg_vtables pointer array")
	}
	return ""
}

// A module with NO impls leaves the descriptor's Vtables slice empty {null, 0}
// and emits no shim vtable.
func TestEmitPackageVtablesEmpty() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() {}\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "@__ivtshim.bn_") {
		return fail("a module with no impls must emit no shim vtable")
	}
	return ""
}
