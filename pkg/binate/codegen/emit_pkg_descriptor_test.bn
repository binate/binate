package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for emit_pkg_descriptor.bn — the per-package reflect descriptor
// (immortal static-managed reflect.Package node + generated _Package()
// accessor).  Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// EmitModule must, for every module, emit the package-name rodata, the
// immortal static-managed reflect.Package node (sentinel refcount header +
// { Name.data, Name.len } payload), and the _Package() accessor returning a
// pointer to the node's payload.  Host build → i64 header/length words.
func TestEmitPackageDescriptor() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func main() {}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)

	// Package-name rodata: package "main" -> 4 bytes "main".
	if !contains(out, " x i8] c\"main\"") {
		return fail("expected package-name rodata c\"main\"")
	}
	// Immortal static-managed reflect.Package node: header { i64, i64 }
	// with the negative sentinel refcount + zero free-fn, then the
	// { ptr, i64 } Name payload.
	if !contains(out,
			"weak_odr constant { i64, i64, { ptr, i64 } } { i64 -1073741824, i64 0, { ptr, i64 } { ptr @") {
		return fail("expected immortal reflect.Package node with sentinel header")
	}
	// Generated _Package() accessor (mangled bn_<pkg>___Package).
	if !contains(out, "___Package() {") {
		return fail("expected generated _Package() accessor")
	}
	// Its body returns the node's payload pointer (GEP to field 2).
	if !contains(out,
			"ret ptr getelementptr inbounds ({ i64, i64, { ptr, i64 } }") {
		return fail("expected _Package() to return the node payload pointer")
	}
	return ""
}
