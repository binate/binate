package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/types"

// FunctionInfo-table emission for the per-package reflect descriptor — B0
// step 3b-ii of plan-package-introspection-phase-b.md.  For each
// `.bni`-exported, non-extern function (the same set codegen's
// addExportedFuncsToSeen force-emits a func-value triple for), this emits an
// immortal static-managed `reflect.FunctionInfo` node, then an array of
// pointers to those nodes' payloads — the backing store for
// `reflect.Package.Functions` (a `*[]@FunctionInfo` raw slice).  The
// descriptor node (emit_pkg_descriptor.bn) points Functions.{data,len} at this
// array.  The hand-encoded `FunctionInfo` payload layout here MUST agree with
// reflect.bni and the native emitter (common_pkg_functions.bn).

// fnInfoPayloadTy returns the flattened LLVM type of a reflect.FunctionInfo
// payload: { Pkg(@Package=ptr), Name(*[]char=ptr+int), Value(*uint8=ptr),
// ResultSize(int), ParamSlots(int), Sig(*[]char=ptr+int) }.
func fnInfoPayloadTy() @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("{ ptr, ptr, ")
	cb.Write(intLL())
	cb.Write(", ptr, ")
	cb.Write(intLL())
	cb.Write(", ")
	cb.Write(intLL())
	cb.Write(", ptr, ")
	cb.Write(intLL())
	cb.Write(" }")
	return buf.CopyStr(cb.String())
}

// emitPackageFunctions emits the exported-function FunctionInfo nodes and the
// `funcsArraySym` pointer array for module `m`, and returns the buffer plus the
// entry count.  `infoSym` is the package descriptor node's symbol (each
// FunctionInfo's Pkg back-points at its payload), `pkgPayloadTy` the package
// payload's LLVM type (for that GEP).  The caller wires Functions = {
// @funcsArraySym, count }.  Emits nothing and returns 0 when the module has no
// exported functions (the array symbol is then unreferenced and Functions
// stays {null, 0}).
func emitPackageFunctions(out *buf.Builder, m @ir.Module,
		infoSym *[]readonly char, pkgPayloadTy *[]readonly char,
		funcsArraySym *[]readonly char) int {
	var fiTy @[]char = fnInfoPayloadTy()
	// The package node's payload pointer (the @Package the Pkg field holds).
	var pkgPtrBuf @buf.Builder = buf.NewBuilder()
	staticManagedPayloadPtr(pkgPtrBuf, infoSym, pkgPayloadTy)
	var pkgPtr @[]char = buf.CopyStr(pkgPtrBuf.String())

	var nodeSyms @[]@[]char
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (ir.Func.IsStructDtor), injectable when native-only.
		if !f.Exported && !f.IsStructDtor { continue }
		var fv @types.Type = lookupFuncValueType(m, f.Name)
		if fv == nil { continue }

		var mangled @[]char = mangle.FuncName(modulePkgName, f.Name)
		var nameSym @[]char = appendStr(mangled, "__fnname")
		var sigSym @[]char = appendStr(mangled, "__fnsig")
		var nodeSym @[]char = appendStr(mangled, "__fninfo")
		// f.Name is already the FULLY-QUALIFIED "pkg/path.Func" (NewFunc
		// applies mangle.QualifyName), which is exactly the form the VM
		// binder keys on — use it verbatim, do NOT re-qualify.
		var sig @[]char = fv.SigString()

		emitFnRodata(out, nameSym, f.Name)
		emitFnRodata(out, sigSym, sig)

		// FunctionInfo payload init: { Pkg, Name.data, Name.len, Value,
		// ResultSize, ParamSlots, Sig.data, Sig.len }.
		var init @buf.Builder = buf.NewBuilder()
		init.Write("{ ptr ")
		init.Write(pkgPtr)
		init.Write(", ptr @")
		init.Write(nameSym)
		init.Write(", ")
		init.Write(intLL())
		init.WriteByte(' ')
		buf.WriteInt(init, len(f.Name))
		init.Write(", ptr @__handle.")
		init.Write(mangled)
		init.Write(", ")
		init.Write(intLL())
		init.WriteByte(' ')
		buf.WriteInt(init, functionResultSize(fv))
		init.Write(", ")
		init.Write(intLL())
		init.WriteByte(' ')
		buf.WriteInt(init, len(fv.Params))
		init.Write(", ptr @")
		init.Write(sigSym)
		init.Write(", ")
		init.Write(intLL())
		init.WriteByte(' ')
		buf.WriteInt(init, len(sig))
		init.Write(" }")
		emitStaticManagedGlobal(out, nodeSym, fiTy, buf.CopyStr(init.String()))

		nodeSyms = appendCharSliceFV(nodeSyms, nodeSym)
	}

	// Self-list the compiler-synthesized `_Package` accessor as the LAST
	// entry so reflection on any package surfaces its own _Package.  Its
	// func-value triple is force-emitted by addPackageAccessorToSeen
	// (emit_funcvals.bn), so @__handle.<mangledP> resolves.  Guarded on
	// PackageAccessorSig — nil when reflect wasn't loaded for this module,
	// leaving the table as before.  The Name is the FQ `<pkg>._Package`
	// (the VM lookup key); the mangled symbol routes the same dotted name
	// through FuncName to bn_<path>___Package (== the descriptor funcSym).
	if m.PackageAccessorSig != nil {
		var fvP @types.Type = m.PackageAccessorSig
		var nameP @[]char = mangle.QualifyName(modulePkgName, "_Package")
		var mangledP @[]char = mangle.FuncName(modulePkgName, nameP)
		var nameSymP @[]char = appendStr(mangledP, "__fnname")
		var sigSymP @[]char = appendStr(mangledP, "__fnsig")
		var nodeSymP @[]char = appendStr(mangledP, "__fninfo")
		var sigP @[]char = fvP.SigString()

		emitFnRodata(out, nameSymP, nameP)
		emitFnRodata(out, sigSymP, sigP)

		var initP @buf.Builder = buf.NewBuilder()
		initP.Write("{ ptr ")
		initP.Write(pkgPtr)
		initP.Write(", ptr @")
		initP.Write(nameSymP)
		initP.Write(", ")
		initP.Write(intLL())
		initP.WriteByte(' ')
		buf.WriteInt(initP, len(nameP))
		initP.Write(", ptr @__handle.")
		initP.Write(mangledP)
		initP.Write(", ")
		initP.Write(intLL())
		initP.WriteByte(' ')
		buf.WriteInt(initP, functionResultSize(fvP))
		initP.Write(", ")
		initP.Write(intLL())
		initP.WriteByte(' ')
		buf.WriteInt(initP, len(fvP.Params))
		initP.Write(", ptr @")
		initP.Write(sigSymP)
		initP.Write(", ")
		initP.Write(intLL())
		initP.WriteByte(' ')
		buf.WriteInt(initP, len(sigP))
		initP.Write(" }")
		emitStaticManagedGlobal(out, nodeSymP, fiTy, buf.CopyStr(initP.String()))

		nodeSyms = appendCharSliceFV(nodeSyms, nodeSymP)
	}

	var count int = len(nodeSyms)
	if count == 0 { return 0 }

	// The funcs array: [count x ptr] of pointers to each node's payload.
	out.Write("@")
	out.Write(funcsArraySym)
	out.Write(" = weak_odr constant [")
	buf.WriteInt(out, count)
	out.Write(" x ptr] [")
	for i := 0; i < count; i++ {
		if i > 0 { out.Write(",") }
		out.Write(" ptr ")
		staticManagedPayloadPtr(out, nodeSyms[i], fiTy)
	}
	out.Write(" ]\n")
	return count
}

// functionResultSize returns the VM-dispatch ResultSize of a func-value type:
// 0 for void / no result, SizeOf the single result, or the multi-return tuple
// SizeOf.  This is the load-bearing scalar(<=8)/aggregate(>8) discriminator.
func functionResultSize(fv @types.Type) int {
	if fv == nil { return 0 }
	if len(fv.Results) == 0 { return 0 }
	if len(fv.Results) == 1 {
		if fv.Results[0] == nil { return 0 }
		return fv.Results[0].SizeOf()
	}
	var fields @[]@types.Field = make_slice(@types.Field, len(fv.Results))
	for i := 0; i < len(fv.Results); i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = fv.Results[i]
		fields[i] = fld
	}
	return types.MakeStructType("", fields).SizeOf()
}

// emitFnRodata emits a private rodata byte array `@<sym> = ... [N x i8]
// c"..."` for a FunctionInfo string field (qualified name / signature).
func emitFnRodata(out *buf.Builder, sym *[]readonly char,
		bytes *[]readonly char) {
	out.Write("@")
	out.Write(sym)
	out.Write(" = private unnamed_addr constant [")
	buf.WriteInt(out, len(bytes))
	out.Write(" x i8] ")
	if len(bytes) == 0 {
		out.Write("zeroinitializer")
	} else {
		out.Write("c\"")
		emitStringBytes(out, bytes)
		out.Write("\"")
	}
	out.Write(", align 1\n")
	return
}

// appendStr concatenates a suffix onto a @[]char, returning a fresh slice.
func appendStr(prefix @[]char, suffix *[]readonly char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(prefix)
	cb.Write(suffix)
	return buf.CopyStr(cb.String())
}

// appendCharSliceFV appends a @[]char to a @[]@[]char.
func appendCharSliceFV(dst @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(dst)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}
