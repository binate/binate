package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"

// GlobalInfo-table emission for the per-package reflect descriptor — the
// exported-global counterpart to emit_pkg_functions.bn.  For each
// `.bni`-exported, non-extern package-level global, this emits an immortal
// static-managed `reflect.GlobalInfo` node {Name, Addr}, then an array of
// pointers to those nodes' payloads — the backing store for
// `reflect.Package.Globals` (a `*[]@GlobalInfo` raw slice).  The descriptor
// node (emit_pkg_descriptor.bn) points Globals.{data,len} at this array.  The
// VM's RegisterPackageGlobals reads it to bind a native-only package's sentinel
// cells (e.g. `errors.NotFound`) for cross-mode pointer identity.  The
// hand-encoded payload layout here MUST agree with reflect.bni and the native
// emitter (common_pkg_globals.bn).

// globalInfoPayloadTy returns the flattened LLVM type of a reflect.GlobalInfo
// payload: { Name(*[]readonly char = ptr+int), Addr(*uint8 = ptr) }.
func globalInfoPayloadTy() @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("{ ptr, ")
	cb = cb.WriteStr(intLL())
	cb = cb.WriteStr(", ptr }")
	return cb.Bytes()
}

// emitPackageGlobals emits the exported-global GlobalInfo nodes and the
// `globalsArraySym` pointer array for module `m`, and returns the buffer plus
// the entry count.  The caller wires Globals = { @globalsArraySym, count }.
// Emits nothing and returns 0 when the module has no exported globals (the
// array symbol is then unreferenced and Globals stays {null, 0}).
func emitPackageGlobals(out buf.CharBuf, m @ir.Module,
		globalsArraySym *[]readonly char) (buf.CharBuf, int) {
	var giTy @[]char = globalInfoPayloadTy()
	var nodeSyms @[]@[]char
	for i := 0; i < len(m.Globals); i++ {
		var g @ir.Global = m.Globals[i]
		// Imported extern vars are owned by their defining package; only this
		// package's own exported globals get a descriptor entry.
		if g.IsExtern { continue }
		if !g.Exported { continue }

		// A package's OWN global has a BARE g.Name ("ConditionsUnmet"); the VM
		// keys lookupGlobalAddr on the FULLY-QUALIFIED form
		// ("pkg/std/errors.ConditionsUnmet") — exactly what materializeGlobals
		// stores via qualifyCallName — so qualify it for the GlobalInfo Name.
		// (QualifyName passes an already-dotted name through unchanged.)  The
		// storage symbol for Addr mangles from the same g.Name.
		var fqName @[]char = mangle.QualifyName(modulePkgName, g.Name)
		var globalSym @[]char = mangle.GlobalName(modulePkgName, g.Name)
		var nameSym @[]char = appendStr(globalSym, "__glname")
		var nodeSym @[]char = appendStr(globalSym, "__glinfo")

		out = emitFnRodata(out, nameSym, fqName)

		// GlobalInfo payload init: { Name.data, Name.len, Addr }.  Addr is the
		// global's storage symbol itself — a `var` cell, NOT a static-managed
		// node, so the relocation has no +header offset (cf. FunctionInfo.Value,
		// which targets a static-managed handle's payload).
		var init buf.CharBuf = buf.New()
		init = init.WriteStr("{ ptr @")
		init = init.WriteStr(nameSym)
		init = init.WriteStr(", ")
		init = init.WriteStr(intLL())
		init = init.WriteByte(' ')
		init = init.WriteInt(len(fqName))
		init = init.WriteStr(", ptr @")
		init = init.WriteStr(globalSym)
		init = init.WriteStr(" }")
		out = emitStaticManagedGlobal(out, nodeSym, giTy, init.Bytes())

		nodeSyms = appendCharSliceFV(nodeSyms, nodeSym)
	}

	var count int = len(nodeSyms)
	if count == 0 { return out, 0 }

	// The globals array: [count x ptr] of pointers to each node's payload.
	out = out.WriteStr("@")
	out = out.WriteStr(globalsArraySym)
	out = out.WriteStr(" = weak_odr constant [")
	out = out.WriteInt(count)
	out = out.WriteStr(" x ptr] [")
	for i := 0; i < count; i++ {
		if i > 0 { out = out.WriteStr(",") }
		out = out.WriteStr(" ptr ")
		out = staticManagedPayloadPtr(out, nodeSyms[i], giTy)
	}
	out = out.WriteStr(" ]\n")
	return out, count
}
