package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"

// VtableInfo-table emission for the per-package reflect descriptor — the
// interface-impl-vtable counterpart to emit_pkg_globals.bn.  For each
// NON-generic `impl` this package compiles (m.Impls), this emits an immortal
// static-managed `reflect.VtableInfo` node {Name, Addr}, then an array of
// pointers to those nodes' payloads — the backing store for
// `reflect.Package.Vtables` (a `*[]@VtableInfo` raw slice).  The descriptor
// node (emit_pkg_descriptor.bn) points Vtables.{data,len} at this array.  The
// VM's RegisterPackageVtables reads it so a bytecode-built interface value over
// a native-only package's struct resolves the impl vtable to its single native
// `@__ivt` instance (dispatchCompiledIfaceMethod) instead of fatally missing
// the un-lowered vm.IfaceVtables.  The hand-encoded payload layout here MUST
// agree with reflect.bni and the native emitter (common_pkg_vtables.bn).
//
// Generic-impl INSTANTIATIONS are excluded (recvTypeIsGenericInst): a generic
// struct monomorphizes at the importer's use site, so a bytecode user re-lowers
// its own copy of the vtable (found by findIfaceVtable) — the native one is
// never consulted by name.  This mirrors how emit_pkg_functions.bn excludes
// instantiation methods (their synthesized decls are unexported).

// vtableInfoPayloadTy returns the flattened LLVM type of a reflect.VtableInfo
// payload: { Name(*[]readonly char = ptr+int), Addr(*uint8 = ptr),
// ShimAddr(*uint8 = ptr) }.
func vtableInfoPayloadTy() @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("{ ptr, ")
	cb.Write(intLL())
	cb.Write(", ptr, ptr }")
	return buf.CopyStr(cb.String())
}

// recvTypeIsGenericInst reports whether an impl's receiver type name is a
// monomorphized generic instantiation (carries the `__bn_inst__` marker that
// instantiationMangledName emits).  Such impls are use-site-lowered by any
// bytecode importer, so they are not injected by name.
func recvTypeIsGenericInst(recvName *[]readonly char) bool {
	var marker *[]readonly char = "__bn_inst__"
	var n int = len(recvName)
	var mlen int = len(marker)
	if n < mlen { return false }
	for i := 0; i <= n - mlen; i++ {
		var match bool = true
		for j := 0; j < mlen; j++ {
			if recvName[i + j] != marker[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// emitPackageVtables emits the VtableInfo nodes and the `vtablesArraySym`
// pointer array for module `m`, and returns the entry count.  The caller wires
// Vtables = { @vtablesArraySym, count }.  Emits nothing and returns 0 when the
// module defines no (non-generic) impls (the array symbol is then unreferenced
// and Vtables stays {null, 0}).
func emitPackageVtables(out *buf.Builder, m @ir.Module,
		vtablesArraySym *[]readonly char) int {
	var viTy @[]char = vtableInfoPayloadTy()
	var nodeSyms @[]@[]char
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		// Generic-instantiation impls re-lower at the importer; skip them.
		if recvTypeIsGenericInst(info.RecvTypeName) { continue }

		// vtName is BOTH the mangled lookup key (the VtableInfo Name, what
		// BC_IFACE_VALUE / findIfaceVtable resolve) AND the symbol of the
		// `@__ivt` global emit_impls.bn defines for this impl — so Addr targets
		// `@<vtName>` directly with addend 0 (a constant array, no header).
		var vtName @[]char = implVtableName(info)
		var shimName @[]char = implShimVtableName(info)
		var nameSym @[]char = appendStr(vtName, "__vtname")
		var nodeSym @[]char = appendStr(vtName, "__vtinfo")

		emitFnRodata(out, nameSym, vtName)

		var init @buf.Builder = buf.NewBuilder()
		init.Write("{ ptr @")
		init.Write(nameSym)
		init.Write(", ")
		init.Write(intLL())
		init.WriteByte(' ')
		buf.WriteInt(init, len(vtName))
		init.Write(", ptr @")
		init.Write(vtName)
		init.Write(", ptr @")
		init.Write(shimName)
		init.Write(" }")
		emitStaticManagedGlobal(out, nodeSym, viTy, buf.CopyStr(init.String()))

		nodeSyms = appendCharSliceFV(nodeSyms, nodeSym)
	}

	var count int = len(nodeSyms)
	if count == 0 { return 0 }

	// The vtables array: [count x ptr] of pointers to each node's payload.
	out.Write("@")
	out.Write(vtablesArraySym)
	out.Write(" = weak_odr constant [")
	buf.WriteInt(out, count)
	out.Write(" x ptr] [")
	for i := 0; i < count; i++ {
		if i > 0 { out.Write(",") }
		out.Write(" ptr ")
		staticManagedPayloadPtr(out, nodeSyms[i], viTy)
	}
	out.Write(" ]\n")
	return count
}
