package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// ============================================================
// Inline refcount lowering
// ============================================================

// emitRefIncInline emits inline LLVM IR for OP_REFINC: a nil-checked
// fast path that loads the refcount header at ptr-16, increments it,
// and stores it back — replacing the call to bn_pkg__builtins__rt__RefInc.
//
// Generates a control-flow diamond using per-emission unique labels
// (seeded from tmpSeq). The active LLVM block on entry becomes the
// "predecessor" terminating with the nil-check branch; on return the
// active block is ri.<seq>.skip, so subsequent emissions in the same
// IR block fall into it.
//
// The "<int>" placeholder below is i64 under LP64, i32 under
// --target arm32-linux; the byte offset to the header is
// `-2*sizeof(int)` = -16 on 64-bit, -8 on 32-bit.
//
// A negative refcount marks immortal static-managed data
// (rt.STATIC_REFCOUNT): the .do block loads the count and branches to
// .skip without touching the header when it is negative, so the increment
// runs only in .live.
//
//   %ri.<seq>.null = icmp eq i8* <ptr>, null
//   br i1 %ri.<seq>.null, label %ri.<seq>.skip, label %ri.<seq>.do
// ri.<seq>.do:
//   %ri.<seq>.hdr8 = getelementptr i8, i8* <ptr>, i64 -<hdrBytes>
//   %ri.<seq>.hdr  = bitcast i8* %ri.<seq>.hdr8 to <int>*
//   %ri.<seq>.old  = load <int>, <int>* %ri.<seq>.hdr
//   %ri.<seq>.immortal = icmp slt <int> %ri.<seq>.old, 0
//   br i1 %ri.<seq>.immortal, label %ri.<seq>.skip, label %ri.<seq>.live
// ri.<seq>.live:
//   %ri.<seq>.new  = add <int> %ri.<seq>.old, 1
//   store <int> %ri.<seq>.new, <int>* %ri.<seq>.hdr
//   br label %ri.<seq>.skip
// ri.<seq>.skip:
func emitRefIncInline(out *strings.Builder, instr @ir.Instr) {
	var seq int = tmpSeq
	tmpSeq++
	// Nil check + branch (terminates the predecessor block).
	out.Write("%ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".null = icmp eq i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", null\n")
	out.Write("  br i1 %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".null, label %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip, label %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".do\n")
	// .do block: header arithmetic + load/add/store.
	out.Write("ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".do:\n")
	out.Write("  %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr8 = getelementptr i8, i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", i64 -")
	stringutils.WriteInt(out, managedHeaderBytes())
	out.Write("\n")
	out.Write("  %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr = bitcast i8* %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr8 to ")
	out.Write(intLL())
	out.Write("*\n")
	out.Write("  %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".old = load ")
	out.Write(intLL())
	out.Write(", ")
	out.Write(intLL())
	out.Write("* %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr\n")
	// Immortal (negative-refcount) static-managed data is never counted:
	// branch to .skip without writing the header.
	out.Write("  %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".immortal = icmp slt ")
	out.Write(intLL())
	out.Write(" %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".old, 0\n")
	out.Write("  br i1 %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".immortal, label %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip, label %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".live\n")
	// .live block: the actual increment.
	out.Write("ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".live:\n")
	out.Write("  %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".new = add ")
	out.Write(intLL())
	out.Write(" %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".old, 1\n")
	out.Write("  store ")
	out.Write(intLL())
	out.Write(" %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".new, ")
	out.Write(intLL())
	out.Write("* %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr\n")
	out.Write("  br label %ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip\n")
	// .skip block: subsequent IR-instructions emit here.
	out.Write("ri.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip:\n")
	return
}

// emitRefDecInline emits inline LLVM IR for OP_REFDEC: a nil-checked
// fast path that decrements the refcount, with a slow-path call to
// bn_pkg__builtins__rt__ZeroRefDestroy(ptr, dtor) when the count hits zero.
//
// The "<int>" placeholder below is i64 under LP64, i32 under
// --target arm32-linux; <hdrBytes> is -16 on 64-bit, -8 on 32-bit.
//
// A negative refcount marks immortal static-managed data
// (rt.STATIC_REFCOUNT): the .dec block loads the count and branches to
// .skip without touching the header when it is negative, so the decrement
// and the destroy dispatch run only in .live.
//
//   %rd.<seq>.null = icmp eq i8* <ptr>, null
//   br i1 %rd.<seq>.null, label %rd.<seq>.skip, label %rd.<seq>.dec
// rd.<seq>.dec:
//   %rd.<seq>.hdr8 = getelementptr i8, i8* <ptr>, i64 -<hdrBytes>
//   %rd.<seq>.hdr  = bitcast i8* %rd.<seq>.hdr8 to <int>*
//   %rd.<seq>.old  = load <int>, <int>* %rd.<seq>.hdr
//   %rd.<seq>.immortal = icmp slt <int> %rd.<seq>.old, 0
//   br i1 %rd.<seq>.immortal, label %rd.<seq>.skip, label %rd.<seq>.live
// rd.<seq>.live:
//   %rd.<seq>.new  = sub <int> %rd.<seq>.old, 1
//   store <int> %rd.<seq>.new, <int>* %rd.<seq>.hdr
//   %rd.<seq>.zero = icmp eq <int> %rd.<seq>.new, 0
//   br i1 %rd.<seq>.zero, label %rd.<seq>.destroy, label %rd.<seq>.skip
// rd.<seq>.destroy:
//   call void @bn_pkg__builtins__rt__ZeroRefDestroy(i8* <ptr>, i8* <dtor>)
//   br label %rd.<seq>.skip
// rd.<seq>.skip:
//
// Args[1] is the optional destructor pointer; if absent, null is
// passed. On return the active LLVM block is rd.<seq>.skip.
func emitRefDecInline(out *strings.Builder, instr @ir.Instr) {
	var seq int = tmpSeq
	tmpSeq++
	// Nil check + branch.
	out.Write("%rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".null = icmp eq i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", null\n")
	out.Write("  br i1 %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".null, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".dec\n")
	// .dec block: decrement, then dispatch on zero.
	out.Write("rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".dec:\n")
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr8 = getelementptr i8, i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", i64 -")
	stringutils.WriteInt(out, managedHeaderBytes())
	out.Write("\n")
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr = bitcast i8* %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr8 to ")
	out.Write(intLL())
	out.Write("*\n")
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".old = load ")
	out.Write(intLL())
	out.Write(", ")
	out.Write(intLL())
	out.Write("* %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr\n")
	// Immortal (negative-refcount) static-managed data is never counted or
	// destroyed: branch to .skip without writing the header.
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".immortal = icmp slt ")
	out.Write(intLL())
	out.Write(" %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".old, 0\n")
	out.Write("  br i1 %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".immortal, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".live\n")
	// .live block: decrement, then dispatch on zero.
	out.Write("rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".live:\n")
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".new = sub ")
	out.Write(intLL())
	out.Write(" %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".old, 1\n")
	out.Write("  store ")
	out.Write(intLL())
	out.Write(" %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".new, ")
	out.Write(intLL())
	out.Write("* %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".hdr\n")
	out.Write("  %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".zero = icmp eq ")
	out.Write(intLL())
	out.Write(" %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".new, 0\n")
	out.Write("  br i1 %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".zero, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".destroy, label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip\n")
	// .destroy block: slow-path call to ZeroRefDestroy(ptr, dtor).
	out.Write("rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".destroy:\n")
	out.Write("  call void @")
	out.Write(rtSym("ZeroRefDestroy"))
	out.Write("(i8* ")
	emitRef(out, instr.Args[0].ID)
	out.Write(", i8* ")
	if len(instr.Args) > 1 {
		emitRef(out, instr.Args[1].ID)
	} else {
		out.Write("null")
	}
	out.Write(")\n")
	out.Write("  br label %rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip\n")
	// .skip block: subsequent IR-instructions emit here.
	out.Write("rd.")
	stringutils.WriteInt(out, seq)
	out.Write(".skip:\n")
	return
}
