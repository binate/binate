package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the inline refcount lowering emitters
// (emitRefIncInline / emitRefDecInline in emit_refcount.bn).
// These exercise the OP_REFINC / OP_REFDEC nil-check + header-arith
// expansion that replaces the bn_pkg__builtins__rt__RefInc / bn_pkg__builtins__rt__RefDec call
// path. Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// TestEmitRefIncForManagedCopy checks that a managed-pointer copy in
// user code lowers to the inline RefInc form (no rt.RefInc call).
func TestEmitRefIncForManagedCopy() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type N struct { V int }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a @N = make(N)\n")
	cb.Write("\tvar b @N = a\n")
	cb.Write("\tprintln(b.V)\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)
	if contains(out, "@bn_pkg__builtins__rt__RefInc(") {
		return fail("RefInc should be inlined; no @bn_pkg__builtins__rt__RefInc call expected")
	}
	if !contains(out, "ri.") {
		return fail("expected inline RefInc labels (ri.<seq>.*)")
	}
	if !contains(out, "i64 -16") {
		return fail("expected inline header offset -16")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitRefcountImmortalBranch checks that the inline RefInc/RefDec
// lowerings emit the negative-refcount short-circuit (icmp slt ... 0 → skip,
// gated behind a .live block) so immortal static-managed nodes are never
// counted or destroyed. The managed-copy program below emits both an inline
// RefInc (the copy) and an inline RefDec (scope exit).
func TestEmitRefcountImmortalBranch() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type N struct { V int }\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar a @N = make(N)\n")
	cb.Write("\tvar b @N = a\n")
	cb.Write("\tprintln(b.V)\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var out @[]char = compileToLLVM(src)
	if !contains(out, ".immortal = icmp slt") {
		return fail("expected immortal-refcount check (icmp slt <int> ..., 0)")
	}
	if !contains(out, ".live:") {
		return fail("expected .live block guarding the count mutation")
	}
	var pass testing.TestResult
	return pass
}

// TestAnonTupleDtorFieldGepIndex pins the field-GEP index in an anonymous
// multi-return tuple's generated destructor.  A (bool, @Iface) return is an
// anonymous {i1, iface} tuple, emitted in the non-packed `{...}` LLVM form
// WITHOUT explicit padding fields — so the Binate field index IS the LLVM
// index.  The dtor field-accesses the iface (logical index 1) to RefDec it;
// the named-struct padding remap (structLLVMIndex) must NOT apply, or it
// overshoots to index 2 of a 2-field struct (an invalid getelementptr).
func TestAnonTupleDtorFieldGepIndex() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("interface E { m() int }\n")
	cb.Write("type Le struct { v int }\n")
	cb.Write("func (e *Le) m() int { return e.v }\n")
	cb.Write("impl *Le : E\n")
	cb.Write("func f(ok bool) (bool, @E) {\n")
	cb.Write("\tif ok { var none @E; return true, none }\n")
	cb.Write("\tvar le @Le = make(Le)\n")
	cb.Write("\tle.v = 1\n")
	cb.Write("\tvar e @E = le\n")
	cb.Write("\treturn false, e\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar b bool\n")
	cb.Write("\tvar e @E\n")
	cb.Write("\tb, e = f(false)\n")
	cb.Write("\tif b { println(1) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "getelementptr inbounds {i1, %BnIfaceValue}") {
		return fail("expected anon {bool, iface} tuple field GEP")
	}
	if !contains(out, "{i1, %BnIfaceValue}* %v2.sc, i32 0, i32 1") {
		return fail("anon-tuple iface field must GEP index 1")
	}
	if contains(out, "{i1, %BnIfaceValue}* %v2.sc, i32 0, i32 2") {
		return fail("anon-tuple field GEP overshot to index 2 (padding remap)")
	}
	var pass testing.TestResult
	return pass
}

// TestAnonTupleDtorFieldGepIndexManagedSlice is the managed-slice analogue of
// TestAnonTupleDtorFieldGepIndex: a (bool, @[]char) tuple's destructor accesses
// the managed-slice field (logical index 1) through a DIFFERENT genStructDtor
// branch (TYP_MANAGED_SLICE) than the iface case, so it independently exercises
// the anonymous-tuple field-GEP index (must be 1, not the padded remap's 2).
func TestAnonTupleDtorFieldGepIndexManagedSlice() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("func f(ok bool) (bool, @[]char) {\n")
	cb.Write("\tif ok { var none @[]char; return true, none }\n")
	cb.Write("\tvar s @[]char = make_slice(char, 3)\n")
	cb.Write("\treturn false, s\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar b bool\n")
	cb.Write("\tvar s @[]char\n")
	cb.Write("\tb, s = f(false)\n")
	cb.Write("\tif b { println(1) }\n")
	cb.Write("}\n")
	var out @[]char = compileToLLVM(buf.CopyStr(cb.String()))
	if !contains(out, "getelementptr inbounds {i1, %BnManagedSlice}") {
		return fail("expected anon {bool, @[]char} tuple field GEP")
	}
	if !contains(out, "{i1, %BnManagedSlice}* %v2.sc, i32 0, i32 1") {
		return fail("anon-tuple managed-slice field must GEP index 1")
	}
	if contains(out, "{i1, %BnManagedSlice}* %v2.sc, i32 0, i32 2") {
		return fail("anon-tuple field GEP overshot to index 2 (padding remap)")
	}
	var pass testing.TestResult
	return pass
}
