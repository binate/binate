package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/std/strings"

// emitSatFragPin pins THIS main module's `_pkg_satfrag` graph node in
// `@llvm.used` so the node — and, transitively, everything its initializer
// references (its own `_pkg_satentries` + the dependency-frag graph) — survives
// `-dead_strip` / `--gc-sections`.  A no-op unless a native-codegen driver
// requested the registry wiring (m.SatRegistryRequested), so the interp path —
// which lowers the main module to bytecode — never emits it (M5).  Emitted on
// the main module only; the `__entry` OP_DATA_SYM_ADDR reference to
// `_pkg_satfrag` (ir.EmitSatRegistryWiring) does NOT retain here, because its
// LLVM lowering is a no-op `bitcast i8* @sym to i8*` whose unused result LLVM
// folds away.  `@llvm.used` is the portable retain primitive; it lowers to
// Mach-O `.no_dead_strip` / ELF SHF_GNU_RETAIN.  (The native backends retain via
// that real LEA reloc instead — they have no `@llvm.used`.)
func emitSatFragPin(out *strings.Builder, m @ir.Module) {
	if !m.SatRegistryRequested { return }

	// Pin main's `_pkg_satfrag` — the graph node the runtime walk starts from.
	var fragSym @[]char = mangle.GlobalName(modulePkgName, "_pkg_satfrag")
	out.Write("@llvm.used = appending global [1 x ptr] [ptr @")
	out.Write(fragSym)
	out.Write("], section \"llvm.metadata\"\n")
	return
}
