package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_satfrag_pin.bn — the LLVM half of the decentralized satentry
// enumeration: pinning main's `_pkg_satfrag` graph node in `@llvm.used`.
// Helpers (contains, fail) live in emit_test.bn.  Each drives emitSatFragPin
// directly on a Builder + a hand-built Module (mirrors the direct-drive
// descriptor tests), setting modulePkgName as EmitModule would.

// A requested registry wiring pins this main module's `_pkg_satfrag` node in a
// single-element `@llvm.used` appending array so the node — and the graph it
// reaches — survives dead-strip.  No flat `_satentry_root` and no cross-object
// external-global dependency declaration are emitted.
func TestEmitSatFragPinRequested() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "main"
	var m @ir.Module = ir.NewModule("\"main\"")
	m.SatRegistryRequested = true

	var b @strings.Builder = strings.NewBuilder()
	emitSatFragPin(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if !contains(out, "@llvm.used = appending global [1 x ptr] [ptr @") {
		return fail("expected @llvm.used to pin the _pkg_satfrag node")
	}
	if !contains(out, "_pkg_satfrag], section") {
		return fail("expected the _pkg_satfrag node pinned in @llvm.used")
	}
	if contains(out, "_satentry_root") {
		return fail("the flat _satentry_root is gone — nothing should reference it")
	}
	if contains(out, "external global i8") {
		return fail("frag pinning emits no cross-object external dependency declaration")
	}
	return ""
}

// Without a registry request (the interp path, which never calls
// EmitSatRegistryWiring), emitSatFragPin is a no-op — it emits nothing (M5).
func TestEmitSatFragPinNotRequested() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "main"
	var m @ir.Module = ir.NewModule("\"main\"")
	// m.SatRegistryRequested stays false.

	var b @strings.Builder = strings.NewBuilder()
	emitSatFragPin(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if len(out) != 0 {
		return fail("a non-requested frag pin should emit nothing")
	}
	return ""
}
