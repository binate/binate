package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/std/strings"
import "pkg/stdx/slices"

// emitSatEntryRoot lays this module's whole-program SatEntry root (the LLVM
// half; the native half is native/common's EmitSatEntryRoot) — the `pairs`
// array + `root` header built once by irdata.BuildSatEntryRoot and lowered through
// the shared emitDataGlobal.  A no-op unless a native-codegen driver requested
// the root (m.SatRootRequested), so the interp path — which lowers the main
// module to bytecode — never emits it (M5).  Emitted on the main module only;
// the `__entry` OP_DATA_SYM_ADDR reference (ir.EmitSatEntryRoot) keeps it live.
//
// The root references each gathered package's `_pkg_satentries` array by symbol.
// This module's OWN `_pkg_satentries` is already defined by emitPackageDescriptor
// above; every OTHER (dependency) package's is defined in a different object, so
// it needs an `external global` declaration here — unlike EmitInitDispatcher's
// extern FUNCTIONS, no pass auto-declares an undefined data symref, so clang
// would otherwise reject `ptr @<sym>` with "use of undefined value".
func emitSatEntryRoot(out *strings.Builder, m @ir.Module) {
	if !m.SatRootRequested { return }

	var pkgSatSyms @[]@[]char
	var counts @[]int
	for i := 0; i < len(m.SatRootEntries); i++ {
		var e irdata.SatRootEntry = m.SatRootEntries[i]
		var sym @[]char = mangle.GlobalName(e.PkgPath, "_pkg_satentries")
		pkgSatSyms = slices.Append[@[]char](pkgSatSyms, sym)
		counts = slices.Append[int](counts, e.Count)
		// A dependency package's `_pkg_satentries` lives in another object;
		// declare it external.  Skip this module's own (defined above).
		if !e.IsOwn {
			out.Write("@")
			out.Write(sym)
			out.Write(" = external global i8\n")
		}
	}

	var rootSym @[]char = mangle.GlobalName(modulePkgName, "_satentry_root")
	var pairsSym @[]char = mangle.GlobalName(modulePkgName, "_satentry_root_pairs")
	var dgs @[]@irdata.DataGlobal = irdata.BuildSatEntryRoot(rootSym, pairsSym, pkgSatSyms, counts)
	for i := 0; i < len(dgs); i++ {
		emitDataGlobal(out, dgs[i])
	}

	// Pin the root in `@llvm.used` so it (and, transitively, everything its
	// initializer references — pairs → each `_pkg_satentries` → its `__satentry`
	// nodes) survives `-dead_strip` / `--gc-sections`.  The `__entry`
	// OP_DATA_SYM_ADDR reference (ir.EmitSatEntryRoot) does NOT retain here: its
	// LLVM lowering is a no-op `bitcast i8* @root to i8*` whose unused result
	// LLVM folds away.  `@llvm.used` is the portable retain primitive; it lowers
	// to Mach-O `.no_dead_strip` / ELF SHF_GNU_RETAIN.  (The native backends
	// retain via that real LEA reloc instead — they have no `@llvm.used`.)
	out.Write("@llvm.used = appending global [1 x ptr] [ptr @")
	out.Write(rootSym)
	out.Write("], section \"llvm.metadata\"\n")
	return
}
