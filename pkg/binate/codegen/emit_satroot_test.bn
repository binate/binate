package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_satroot.bn — the LLVM half of the whole-program SatEntry root.
// Helpers (contains, fail) live in emit_test.bn.  Each drives emitSatEntryRoot
// directly on a Builder + a hand-built Module (mirrors the direct-drive
// descriptor tests), setting modulePkgName as EmitModule would.

// satRootEntry builds one ir.SatRootEntry value.
func satRootEntry(pkgPath @[]char, count int, isOwn bool) ir.SatRootEntry {
	var e ir.SatRootEntry
	e.PkgPath = pkgPath
	e.Count = count
	e.IsOwn = isOwn
	return e
}

// A requested root with a dependency entry + this module's own entry must emit:
// an `external global` declaration for the dependency's `_pkg_satentries` (M4 —
// it lives in another object; the own one is defined by the descriptor and gets
// NO decl), the `_satentry_root` weak header + its `_satentry_root_pairs` array,
// and the `@llvm.used` pin that keeps the chain past dead-strip.
func TestEmitSatEntryRootPopulated() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "main"
	var m @ir.Module = ir.NewModule("\"main\"")
	m.SatRootRequested = true
	var entries @[]ir.SatRootEntry = make_slice(ir.SatRootEntry, 2)
	entries[0] = satRootEntry("pkg/dep", 3, false)
	entries[1] = satRootEntry("main", 2, true)
	m.SatRootEntries = entries

	var b @strings.Builder = strings.NewBuilder()
	emitSatEntryRoot(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	// The dependency's `_pkg_satentries` is cross-object → external declaration.
	if !contains(out, "_pkg_satentries = external global i8") {
		return fail("expected an external global decl for the dependency _pkg_satentries")
	}
	// The pairs array + the weak root header.
	if !contains(out, "_satentry_root_pairs = private constant") {
		return fail("expected the _satentry_root_pairs array")
	}
	if !contains(out, "_satentry_root = weak_odr constant { ptr, i64 }") {
		return fail("expected the weak _satentry_root header")
	}
	// The retain pin (LLVM cannot rely on the folded __entry bitcast).
	if !contains(out, "@llvm.used = appending global [1 x ptr] [ptr @") {
		return fail("expected @llvm.used to pin the root")
	}
	return ""
}

// With the root requested but no gathered package, the header is the empty slice
// `{ ptr null, i64 0 }` (C1 unconditional root), still pinned in @llvm.used, and
// no external declaration is emitted (there is no dependency to reference).
func TestEmitSatEntryRootEmpty() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "main"
	var m @ir.Module = ir.NewModule("\"main\"")
	m.SatRootRequested = true

	var b @strings.Builder = strings.NewBuilder()
	emitSatEntryRoot(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if contains(out, "external global i8") {
		return fail("empty root should reference no dependency, so no external decl")
	}
	if !contains(out, "_satentry_root = weak_odr constant { ptr, i64 } { ptr null, i64 0 }") {
		return fail("expected the empty { null, 0 } root header")
	}
	if !contains(out, "@llvm.used = appending global") {
		return fail("expected @llvm.used even for the empty root")
	}
	return ""
}

// Without a root request (the interp path, which never calls EmitSatEntryRoot),
// emitSatEntryRoot is a no-op — it emits nothing (M5).
func TestEmitSatEntryRootNotRequested() testing.TestResult {
	var savedPkg *[]readonly char = modulePkgName
	modulePkgName = "main"
	var m @ir.Module = ir.NewModule("\"main\"")
	// m.SatRootRequested stays false.

	var b @strings.Builder = strings.NewBuilder()
	emitSatEntryRoot(b, m)
	var out @[]char = buf.CopyStr(b.String())
	modulePkgName = savedPkg

	if len(out) != 0 {
		return fail("a non-requested root should emit nothing")
	}
	return ""
}
