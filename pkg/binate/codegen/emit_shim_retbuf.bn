package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/std/strings"

// emitShimCoercedResultToRetbuf writes a func-value / closure shim's register-returned
// result `%r` into the caller's `%retbuf` when the result is spelled in a coerced form,
// and reports whether it did.  The dispatch seam lets the callee write exactly the
// result's natural size through the retbuf — the bytes after it are the caller's — but
// a coerced form can be wider: a single aggregate's `[N x iW]` / x86-64 SSE pair, or a
// multi-value tuple (`coercedMR`) whose coerced struct / array fields are stored as
// whole words (emitTupleValueToSlot).  So the result is laid out in a local slot and
// copied into the retbuf leaf by leaf (emitFieldwiseCopy — exactly the result's
// bytes, no runtime call for a small result).  A raw result type is the natural layout
// byte for byte; the caller stores it whole (and this returns false).  `pfx` names the
// slot and the SSA temps.
func emitShimCoercedResultToRetbuf(out *strings.Builder, fvTyp @types.Type, coercedMR bool,
		pfx *[]readonly char) bool {
	var sb @strings.Builder = strings.NewBuilder()
	sb.WriteByte('%')
	sb.Write(pfx)
	sb.Write(".rslot")
	var slot @[]readonly char = sb.String()
	if coercedMR {
		var t @types.Type = multiReturnTupleType(fvTyp.Results)
		emitTupleSlotAlloca(out, slot, t)
		emitTupleValueToSlot(out, t, "%r", "", slot, pfx, true)
		emitFieldwiseCopy(out, "%retbuf", slot, t, 0)
		return true
	}
	if len(fvTyp.Results) == 1 && aggRetCoerced(fvTyp.Results[0]) {
		out.Write("  ")
		out.Write(slot)
		out.Write(" = alloca ")
		writeShimResultLLTy(out, fvTyp, false)
		out.Write(", align 8\n  store ")
		writeShimResultLLTy(out, fvTyp, false)
		out.Write(" %r, ptr ")
		out.Write(slot)
		out.WriteByte('\n')
		emitFieldwiseCopy(out, "%retbuf", slot, fvTyp.Results[0], 0)
		return true
	}
	return false
}
