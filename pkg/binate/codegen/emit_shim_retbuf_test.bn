package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitShimCoercedResultToRetbuf (emit_shim_retbuf.bn): a func-value or
// closure shim writes exactly the result's natural size through the caller's retbuf —
// the coerced result goes to a slot, then each scalar leaf is copied to the retbuf
// (emitFieldwiseCopy: `%v0.fc<i>_dp` is leaf i's retbuf address), and no leaf lies past
// the result.
// compileToLLVM / contains / fail live in emit_test.bn; setTarget64 / setTargetArm32 in
// emit_util_test.bn.

// shimRetbufSrc is a program taking `mk` as a func value; `results` is mk's result
// list and `body` its body.  S3 is a 12-byte struct of int32s, B3 a 3-byte one.
func shimRetbufSrc(results *[]readonly char, body *[]readonly char) @[]char {
	var b @[]char = make_slice(char, 0)
	b = appendChars(b,
			"package \"main\"\n"
					"type S3 struct { a int32\n\tb int32\n\tc int32 }\n"
					"type B3 struct { a int8\n\tb int8\n\tc int8 }\n"
					"func mk(x int32) ")
	b = appendChars(b, results)
	b = appendChars(b, " { ")
	b = appendChars(b, body)
	b = appendChars(b, " }\n"
			"func main() {\n"
			"\tvar f *func(int32) ")
	b = appendChars(b, results)
	b = appendChars(b, " = mk\n"
			"\t_ = f\n"
			"}\n")
	return b
}

// defineBodyWith returns the text of the first emitted LLVM function whose `define`
// line contains `needle`, through its closing `}`; empty when there is none.
func defineBodyWith(out *[]readonly char, needle *[]readonly char) @[]char {
	var i int = 0
	for i < len(out) {
		var j int = i
		for j < len(out) && out[j] != '\n' { j = j + 1 }
		var line *[]readonly char = out[i:j]
		if len(line) > 7 && contains(line[0:7], "define ") && contains(line, needle) {
			var k int = j + 1
			for k < len(out) {
				var m int = k
				for m < len(out) && out[m] != '\n' { m = m + 1 }
				if m - k == 1 && out[k] == '}' { return appendChars(make_slice(char, 0), out[i:m]) }
				k = m + 1
			}
			return appendChars(make_slice(char, 0), out[i:])
		}
		i = j + 1
	}
	return make_slice(char, 0)
}

// shimBody is the text of the module's func-value / closure shim (`@__shim.<m>`).
func shimBody(out *[]readonly char) @[]char {
	return defineBodyWith(out, "@__shim.")
}

// appendChars returns b followed by s.
func appendChars(b *[]readonly char, s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(b) + len(s))
	for i := 0; i < len(b); i++ {
		r[i] = b[i]
	}
	for i := 0; i < len(s); i++ {
		r[len(b) + i] = s[i]
	}
	return r
}

// (int32, S3) on aa64: S3 is coerced `[2 x i64]`, 16 bytes stored at offset 4 — 20
// bytes into a 16-byte retbuf.  The shim lays the fields out in a slot and copies the
// four int32 leaves (offsets 0, 4, 8, 12).
func TestShimTupleResultCopiesNaturalSizeAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var out @[]char = shimBody(
			compileToLLVM(shimRetbufSrc("(int32, S3)", "return x, S3{a: x, b: x, c: x}")))
	if !contains(out, "%shim.rslot = alloca [24 x i8], align 8") {
		return fail("the tuple shim must lay the result out in a slot of size + one word")
	}
	if !contains(out, "%v0.fc0_sp = getelementptr i8, ptr %shim.rslot, i32 0") {
		return fail("the tuple shim must copy the result out of its slot")
	}
	if !contains(out, "%v0.fc3_dp = getelementptr i8, ptr %retbuf, i32 12") ||
			contains(out, "%v0.fc4_") {
		return fail("the tuple shim must copy exactly the four int32 leaves into the retbuf")
	}
	if contains(out, ".sp1 = getelementptr i8, ptr %retbuf") {
		return fail("the tuple shim must not store fields straight into the retbuf")
	}
	return ""
}

// S3 alone on aa64 is returned as `[2 x i64]` (16 bytes) but is 12 bytes: the shim
// stores it to a slot and copies its three int32 leaves.
func TestShimSingleAggResultCopiesNaturalSizeAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var out @[]char = shimBody(compileToLLVM(shimRetbufSrc("S3", "return S3{a: x, b: x, c: x}")))
	if !contains(out, "%shim.rslot = alloca [2 x i64], align 8") {
		return fail("the single-aggregate shim must store the coerced result to a slot")
	}
	if !contains(out, "%v0.fc2_dp = getelementptr i8, ptr %retbuf, i32 8") ||
			contains(out, "%v0.fc3_") {
		return fail("the single-aggregate shim must copy exactly the three int32 leaves")
	}
	return ""
}

// A capturing closure returning (int32, S3) goes through the same slot and copy.
func TestClosureShimTupleResultCopiesNaturalSizeAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type S3 struct { a int32\n\tb int32\n\tc int32 }\n"
			"func mkc(k int32) @func(int32) (int32, S3) {\n"
			"\treturn func(x int32) (int32, S3) { return x, S3{a: k, b: k, c: k} }\n"
			"}\n"
			"func main() {\n"
			"\tvar f @func(int32) (int32, S3) = mkc(1)\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = shimBody(compileToLLVM(src))
	if !contains(out, "%v0.fc0_sp = getelementptr i8, ptr %cshim.rslot, i32 0") {
		return fail("the closure shim must copy the result out of its slot")
	}
	if !contains(out, "%v0.fc3_dp = getelementptr i8, ptr %retbuf, i32 12") ||
			contains(out, "%v0.fc4_") {
		return fail("the closure shim must copy exactly the four int32 leaves into the retbuf")
	}
	if contains(out, ".sp1 = getelementptr i8, ptr %retbuf") {
		return fail("the closure shim must not store fields straight into the retbuf")
	}
	return ""
}

// A capturing closure returning S3 alone: the coerced `[2 x i64]` goes through a slot.
func TestClosureShimSingleAggResultCopiesNaturalSizeAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var src *[]readonly char = "package \"main\"\n"
			"type S3 struct { a int32\n\tb int32\n\tc int32 }\n"
			"func mkc(k int32) @func(int32) S3 {\n"
			"\treturn func(x int32) S3 { return S3{a: k, b: x, c: k} }\n"
			"}\n"
			"func main() {\n"
			"\tvar f @func(int32) S3 = mkc(1)\n"
			"\t_ = f\n"
			"}\n"
	var out @[]char = shimBody(compileToLLVM(src))
	if !contains(out, "%cshim.rslot = alloca [2 x i64], align 8") {
		return fail("the closure shim must store the coerced single result to a slot")
	}
	if !contains(out, "%v0.fc2_dp = getelementptr i8, ptr %retbuf, i32 8") ||
			contains(out, "%v0.fc3_") {
		return fail("the closure shim must copy exactly the three int32 leaves")
	}
	return ""
}

// x86-64: S3 is returned as `[2 x i64]`-style GP words and V3 = {x, y, z float32} as the
// SSE pair `{ <2 x float>, float }` (16 bytes); both are 12 bytes, copied leaf by leaf.
func TestShimSingleAggResultCopiesNaturalSizeX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var gp @[]char = shimBody(compileToLLVM(shimRetbufSrc("S3", "return S3{a: x, b: x, c: x}")))
	var sse @[]char = shimBody(
			compileToLLVM(
					"package \"main\"\n"
							"type V3 struct { x float32\n\ty float32\n\tz float32 }\n"
							"func mk(x int32) V3 { return V3{x: 1.5, y: 2.5, z: 3.5} }\n"
							"func main() {\n"
							"\tvar f *func(int32) V3 = mk\n"
							"\t_ = f\n"
							"}\n"))
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(gp, "%shim.rslot = alloca") ||
			!contains(gp, "%v0.fc2_dp = getelementptr i8, ptr %retbuf, i32 8") || contains(gp, "%v0.fc3_") {
		return fail("x64: the GP-coerced S3 must reach the retbuf as exactly three int32 leaves")
	}
	if !contains(sse, "%shim.rslot = alloca { <2 x float>, float }") ||
			!contains(sse, "%v0.fc2_dp = getelementptr i8, ptr %retbuf, i32 8") ||
			contains(sse, "%v0.fc3_") {
		return fail("x64: the SSE-coerced V3 must reach the retbuf as exactly three float leaves")
	}
	return ""
}

// B3 on arm32 is returned as `[1 x i32]`: the shim copies its 3 bytes, not 4.
func TestShimSingleAggResultCopiesNaturalSizeArm32() testing.TestResult {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	var out @[]char = shimBody(compileToLLVM(shimRetbufSrc("B3", "return B3{a: 1, b: 2, c: 3}")))
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	if !contains(out, "%shim.rslot = alloca [1 x i32], align 8") {
		return fail("the arm32 shim must store the coerced 3-byte result to a slot")
	}
	if !contains(out, "%v0.fc2_dp = getelementptr i8, ptr %retbuf, i32 2") ||
			contains(out, "%v0.fc3_") {
		return fail("the arm32 shim must copy exactly the three int8 leaves into the retbuf")
	}
	return ""
}
