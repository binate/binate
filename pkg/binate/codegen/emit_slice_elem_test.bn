package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests that an element of a slice of structs, and a subslice of one, are
// addressed by the element's size and index: a field store goes through the
// element's address, a subslice's data pointer advances by its low bound's
// elements.  Each check follows the stored or advanced value back through the
// lines defining its operands.

// llvmLines returns body's lines, each without its indentation.
func llvmLines(body *[]readonly char) @[]@[]char {
	var n int = 1
	for i := 0; i < len(body); i++ {
		if body[i] == '\n' { n = n + 1 }
	}
	var lines @[]@[]char = make_slice(@[]char, n)
	var k int = 0
	var start int = 0
	for i := 0; i <= len(body); i++ {
		if i == len(body) || body[i] == '\n' {
			var s int = start
			for s < i && (body[s] == ' ' || body[s] == '\t') { s = s + 1 }
			lines[k] = buf.CopyStr(body[s:i])
			k = k + 1
			start = i + 1
		}
	}
	return lines
}

// hasPrefix reports whether s starts with p.
func hasPrefix(s *[]readonly char, p *[]readonly char) bool {
	return len(s) >= len(p) && seq(s[0:len(p)], p)
}

// cutPrefix returns s without its prefix p, and whether s has it.
func cutPrefix(s *[]readonly char, p *[]readonly char) (@[]char, bool) {
	if !hasPrefix(s, p) {
		var none @[]char
		return none, false
	}
	return buf.CopyStr(s[len(p):]), true
}

// splitAt returns the parts of s before and after the first sep, and whether s
// holds sep.
func splitAt(s *[]readonly char, sep *[]readonly char) (@[]char, @[]char, bool) {
	for i := 0; i + len(sep) <= len(s); i++ {
		if seq(s[i:i + len(sep)], sep) {
			return buf.CopyStr(s[0:i]), buf.CopyStr(s[i + len(sep):]), true
		}
	}
	var none @[]char
	return none, none, false
}

// defRHS returns what the line of lines defining the LLVM value v assigns it
// ("add i64 99, 0" for the line "%v16 = add i64 99, 0"), or "" when no line does.
func defRHS(lines @[]@[]char, v *[]readonly char) @[]char {
	var lhs @[]char = buf.Concat(v, " = ")
	for i := 0; i < len(lines); i++ {
		var rhs @[]char
		var ok bool
		rhs, ok = cutPrefix(lines[i], lhs)
		if ok { return rhs }
	}
	var none @[]char
	return none
}

// isConst reports whether lines define v as the integer constant text c.
func isConst(lines @[]@[]char, v *[]readonly char, c *[]readonly char) bool {
	return seq(defRHS(lines, v), buf.Concat(buf.Concat("add i64 ", c), ", 0"))
}

// throughBitcast returns the value v is a bitcast of, or v when it is none.
func throughBitcast(lines @[]@[]char, v *[]readonly char) @[]char {
	var rest @[]char
	var ok bool
	rest, ok = cutPrefix(defRHS(lines, v), "bitcast ")
	if !ok { return buf.CopyStr(v) }
	var from @[]char
	from, _, ok = splitAt(rest, " to ")
	if !ok { return buf.CopyStr(v) }
	var operand @[]char
	_, operand, ok = splitAt(from, " ")
	if !ok { return buf.CopyStr(v) }
	return operand
}

// llvmStructName returns the LLVM name of the struct type out declares for the
// type named name (`%bn_S1_4_main1_5_Point` for "Point"), or "".
func llvmStructName(out *[]readonly char, name *[]readonly char) @[]char {
	var lines @[]@[]char = llvmLines(out)
	var tail @[]char = buf.Concat(buf.Concat("_", name), " = type ")
	for i := 0; i < len(lines); i++ {
		var before @[]char
		var ok bool
		before, _, ok = splitAt(lines[i], tail)
		if ok && hasPrefix(before, "%") { return buf.Concat(before, buf.Concat("_", name)) }
	}
	var none @[]char
	return none
}

// storesFieldOfElem reports whether line stores 99 through field 1 of the
// struct (LLVM type p) at index 1 of a pointer:
//
//	%c = add i64 99, 0
//	%e = getelementptr p, p* %base, i64 %i        ; %i = add i64 1, 0
//	%f = getelementptr inbounds p, p* %e', i32 0, i32 1    ; %e' is %e, or a bitcast of it
//	store i64 %c, i64* %f
func storesFieldOfElem(lines @[]@[]char, line *[]readonly char, p *[]readonly char) bool {
	var rest @[]char
	var ok bool
	rest, ok = cutPrefix(line, "store i64 ")
	if !ok { return false }
	var c @[]char
	var f @[]char
	c, f, ok = splitAt(rest, ", i64* ")
	if !ok || !isConst(lines, c, "99") { return false }
	var pp @[]char = buf.Concat(buf.Concat(p, ", "), buf.Concat(p, "* "))
	var fieldBase @[]char
	fieldBase, ok = cutPrefix(defRHS(lines, f), buf.Concat("getelementptr inbounds ", pp))
	if !ok { return false }
	var e @[]char
	e, rest, ok = splitAt(fieldBase, ", ")
	if !ok || !seq(rest, "i32 0, i32 1") { return false }
	e = throughBitcast(lines, e)
	var elemIdx @[]char
	elemIdx, ok = cutPrefix(defRHS(lines, e), buf.Concat("getelementptr ", pp))
	if !ok { return false }
	var i @[]char
	_, i, ok = splitAt(elemIdx, ", i64 ")
	return ok && isConst(lines, i, "1")
}

// TestSliceElemPtrEmission checks that a field store into an element of a
// managed-slice of structs (`pts[1].Y = 99`) addresses the element by its index
// over the struct type, then the field within it.
func TestSliceElemPtrEmission() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type Point struct {\n"
			"\tX int\n"
			"\tY int\n"
			"}\n"
			"func main() {\n"
			"\tvar pts @[]Point = make_slice(Point, 2)\n"
			"\tpts[1].Y = 99\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	var p @[]char = llvmStructName(out, "Point")
	if len(p) == 0 { return fail("no LLVM struct type for Point") }
	var lines @[]@[]char = llvmLines(llvmFuncBody(out, "main"))
	for i := 0; i < len(lines); i++ {
		if storesFieldOfElem(lines, lines[i], p) {
			var pass testing.TestResult
			return pass
		}
	}
	return fail("pts[1].Y = 99: no store of 99 through field 1 of the Point at index 1")
}

// advancesByElems reports whether line advances a byte pointer by lo elements of
// size size, lo and size constants:
//
//	%n = mul i64 %lo, %size        ; %lo = add i64 <lo>, 0; %size = add i64 <size>, 0
//	%d = getelementptr i8, i8* %base, i64 %n
func advancesByElems(lines @[]@[]char, line *[]readonly char, lo *[]readonly char,
		size *[]readonly char) bool {
	var gep @[]char
	var ok bool
	_, gep, ok = splitAt(line, " = getelementptr i8, i8* ")
	if !ok { return false }
	var n @[]char
	_, n, ok = splitAt(gep, ", i64 ")
	if !ok { return false }
	var factors @[]char
	factors, ok = cutPrefix(defRHS(lines, n), "mul i64 ")
	if !ok { return false }
	var l @[]char
	var s @[]char
	l, s, ok = splitAt(factors, ", ")
	return ok && isConst(lines, l, lo) && isConst(lines, s, size)
}

// hasDifference reports whether lines compute hi - lo, both constants.
func hasDifference(lines @[]@[]char, hi *[]readonly char, lo *[]readonly char) bool {
	for i := 0; i < len(lines); i++ {
		var operands @[]char
		var ok bool
		_, operands, ok = splitAt(lines[i], " = sub i64 ")
		if !ok { continue }
		var h @[]char
		var l @[]char
		h, l, ok = splitAt(operands, ", ")
		if ok && isConst(lines, h, hi) && isConst(lines, l, lo) { return true }
	}
	return false
}

// TestSliceExprStructEmission checks that a subslice of a managed-slice of
// 24-byte structs (`items[1:3]`) advances the data pointer by one element's
// bytes and takes its length as hi - lo.
func TestSliceExprStructEmission() testing.TestResult {
	setTarget64()
	var src *[]readonly char = "package \"main\"\n"
			"type Item struct {\n"
			"\tA int\n"
			"\tB int\n"
			"\tC int\n"
			"}\n"
			"func main() {\n"
			"\tvar items @[]Item = make_slice(Item, 4)\n"
			"\tvar sub *[]Item = items[1:3]\n"
			"\t_ = sub\n"
			"}\n"
	var out @[]char = compileToLLVM(src)
	var lines @[]@[]char = llvmLines(llvmFuncBody(out, "main"))
	var advanced bool = false
	for i := 0; i < len(lines); i++ {
		if advancesByElems(lines, lines[i], "1", "24") { advanced = true }
	}
	if !advanced {
		return fail("items[1:3]: no data pointer advanced by 1 * 24 bytes")
	}
	if !hasDifference(lines, "3", "1") {
		return fail("items[1:3]: no length computed as 3 - 1")
	}
	var pass testing.TestResult
	return pass
}
