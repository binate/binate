package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A function's own sret parameter is declared as aligned as its result type, all its
// caller promises -- a C caller of a #[c_export] function aligns the buffer only to
// alignof(T), and so does a dispatch caller of a function value -- and the C entry, a
// call that hands the buffer on and the function-value and closure shims say no more.
// Q is five int32s: 20 bytes, returned through a buffer on every target, aligned to 4;
// mkT's five int32s come back from mkT in registers on aa64, but C takes them through
// a buffer, which the C entry is handed; nine's nine int32s come back through a buffer
// on every target, which its function value's shim is handed.  f2's q is both mk's
// result slot and the local f2 keeps in its own buffer.
var sretAlignSrc *[]readonly char = "package \"main\"\n"
		"type Q struct {\n a int32\n b int32\n c int32\n d int32\n e int32\n}\n"
		"#[c_export(\"mk_q\")]\n"
		"func mk(x int8) Q {\n\tvar q Q\n\tq.a = cast(int32, x)\n\treturn q\n}\n"
		"func pass(x int8) Q { return mk(x + 1) }\n"
		"func f2(x int8) Q {\n\tvar q Q\n\tq = mk(x)\n\tq.b = 2\n\treturn q\n}\n"
		"#[c_export(\"mk_t\")]\n"
		"func mkT(x int32) (int32, int32, int32, int32, int32) { return x, x, x, x, x }\n"
		"func clo(x int8) *func() Q { return func() Q { return mk(x) } }\n"
		"func nine() (int32, int32, int32, int32, int32, int32, int32, int32, int32) {\n"
		"\treturn 1, 2, 3, 4, 5, 6, 7, 8, 9\n}\n"
		"func main() {\n"
		"\tvar f *func(int8) Q = mk\n"
		"\t_ = f(1)\n"
		"\t_ = clo(2)()\n"
		"\tvar n *func() (int32, int32, int32, int32, int32, int32, int32, int32, int32) = nine\n"
		"\ta, _, _, _, _, _, _, _, _ := n()\n"
		"\t_ = a\n"
		"}\n"

func TestSretParamAlignIsTheResultTypes() testing.TestResult {
	var archs @[]int = make_slice(int, 3)
	archs[0] = types.ARCH_AA64
	archs[1] = types.ARCH_X64
	archs[2] = types.ARCH_ARM32
	for i := 0; i < len(archs); i++ {
		var out @[]char = compileForArch(sretAlignSrc, archs[i])
		if !contains(out, "_mk(ptr sret(%bn_S1_4_main1_1_Q) align 4 %v.retbuf") {
			return fail("mk's own sret parameter is align 4")
		}
		var pass @[]char = llvmFuncBody(out, "pass")
		if !contains(pass, "align 4 %v.retbuf, i") {
			return fail("pass hands its align-4 buffer on to mk as align 4")
		}
		if archs[i] == types.ARCH_AA64 && !contains(out, "align 4 %ca.sret") {
			return fail("the C entry's sret parameter is align 4")
		}
		if !contains(out, "align 4 %rb") { return fail("the shims forward their retbuf as align 4") }
		if contains(out, "sret(%bn_S1_4_main1_1_Q) align 8") || contains(out, "align 8 %ca.sret") ||
				contains(out, "align 8 %rb") {
			return fail("no buffer of an align-4 result is promised 8")
		}
	}
	return ""
}

// A function another package defines is declared as aligned as its definition says: a
// result of five int32s, align 4.
func TestSretExternDeclAlignIsTheResultTypes() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt32()
	}
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakeStructType("Q", fields)
	var f @ir.Func = ir.NewFunc("other", "mk", make_slice(@ir.Param, 0), results)
	f.IsExtern = true
	var m @ir.Module = ir.NewModule("main")
	m.AddFunc(f)
	var out @[]char = EmitModule(m)
	if !contains(out, "align 4)") || contains(out, "align 8)") {
		return fail("the declaration's sret parameter is align 4")
	}
	return ""
}
