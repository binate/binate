package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/strings"

// emitStackFrames lowers OP_STACK_FRAMES (pkg/std/debug's stacktrace capture).
// It seeds the walk with llvm.frameaddress(0) — the CURRENT function's frame,
// which is debug.Callers, so no extra library frame is recorded — extracts the
// {data,len} words of the *[]Frame buffer, and makes a single call to
// rt.CaptureNativeFrames, whose int result (the total recordable depth) is this
// instruction's value.  The leading "  " indent was already written by emitInstr.
func emitStackFrames(out *strings.Builder, instr @ir.Instr) {
	var skipID int = instr.Args[0].ID
	var bufID int = instr.Args[1].ID
	// fp = this function's frame (debug.Callers); the caller chain is walked from
	// here, so the library frame drops out naturally (no "+1" needed).
	emitRef(out, instr.ID)
	out.Write(".fp = call i8* @llvm.frameaddress.p0(i32 0)\n  ")
	// Split the *[]Frame raw-slice buffer into its {data, len} words.
	emitRef(out, instr.ID)
	out.Write(".data = extractvalue %BnSlice ")
	emitRef(out, bufID)
	out.Write(", 0\n  ")
	emitRef(out, instr.ID)
	out.Write(".len = extractvalue %BnSlice ")
	emitRef(out, bufID)
	out.Write(", 1\n  ")
	// total = rt.CaptureNativeFrames(fp, skip, data, len)
	emitRef(out, instr.ID)
	out.Write(" = call ")
	out.Write(intLL())
	out.Write(" @")
	out.Write(rtSym("CaptureNativeFrames"))
	out.Write("(i8* ")
	emitRef(out, instr.ID)
	out.Write(".fp, ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, skipID)
	out.Write(", i8* ")
	emitRef(out, instr.ID)
	out.Write(".data, ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, instr.ID)
	out.Write(".len)\n")
	return
}

// emitStackFramesDeclare emits the `@llvm.frameaddress.p0` declaration this
// module needs iff at least one of its functions captures a stack trace
// (OP_STACK_FRAMES).  Conditioned on presence so a module that never captures
// frames carries no unused declare.
func emitStackFramesDeclare(out *strings.Builder, m @ir.Module) {
	if !moduleUsesStackFrames(m) {
		return
	}
	out.Write("declare i8* @llvm.frameaddress.p0(i32)\n")
	return
}

// moduleUsesStackFrames reports whether any instruction in m is OP_STACK_FRAMES.
func moduleUsesStackFrames(m @ir.Module) bool {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				if blk.Instrs[k].Op == iropcode.OP_STACK_FRAMES {
					return true
				}
			}
		}
	}
	return false
}
