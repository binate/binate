package "pkg/binate/codegen"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitStackFrames (the OP_STACK_FRAMES lowering in emit_stackframes.bn).

// TestEmitStackFrames checks the LLVM shape of OP_STACK_FRAMES: the
// frameaddress(0) seed, the {data,len} extractvalues off the %BnSlice buffer,
// the call to rt.CaptureNativeFrames, and the module-level frameaddress declare
// (emitted because the module contains an OP_STACK_FRAMES).
func TestEmitStackFrames() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "capture", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	// skip and buf are plain int operands here: emitStackFrames references them
	// by SSA id (the buf `extractvalue %BnSlice` shape is fixed text), so the
	// assertions hold without materializing a real slice value.
	var skip @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var buf @ir.Instr = entry.EmitConstInt(1, types.TypInt())
	var sf @ir.Instr = entry.EmitStackFrames(skip, buf, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = sf
	entry.EmitReturn(retArgs)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "@llvm.frameaddress.p0(i32 0)") {
		return fail("expected frameaddress(0) seed")
	}
	if !contains(out, "extractvalue %BnSlice") {
		return fail("expected %BnSlice extractvalue for the buffer {data,len}")
	}
	if !contains(out, "CaptureNativeFrames") {
		return fail("expected call to rt.CaptureNativeFrames")
	}
	if !contains(out, "declare i8* @llvm.frameaddress.p0(i32)") {
		return fail("expected the frameaddress intrinsic declare")
	}
	return ""
}

// TestFramePointerAttrOnEveryDefine checks that a function definition carries
// the "frame-pointer"="all" attribute (writeFnDefineAttrs), even when it does
// NOT capture a stack trace.  The attribute forces every function to establish a
// real frame pointer, keeping the hardware FP chain unbroken so the from-code
// stacktrace (rt.CaptureNativeFrames) can walk it; a single frame that saved but
// did not establish its FP would truncate the walk.  The guarantee is
// module-wide, hence a plain function (no OP_STACK_FRAMES) must still carry it.
func TestFramePointerAttrOnEveryDefine() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "plain", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = c
	entry.EmitReturn(retArgs)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "@bn_F1_4_main1_5_plain() \"frame-pointer\"=\"all\" {") {
		return fail("every function define must carry frame-pointer=all")
	}
	return ""
}
