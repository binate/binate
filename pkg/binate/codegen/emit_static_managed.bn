package "pkg/binate/codegen"

import "pkg/binate/irdata"
import "pkg/std/strings"

// Static-managed object support — immortal managed data baked into the binary
// (e.g. the package-descriptor nodes) lays a 2-word managed header (Refcount,
// FreeFn) directly in front of a payload, with the Refcount set to the negative
// STATIC_MANAGED_REFCOUNT sentinel so every RefInc/RefDec path short-circuits:
// the node is never counted, never freed.  The node BYTES are laid by
// irdata.BuildPackageDescriptors (the backend-neutral DataGlobal builder); what
// remains here is the shared sentinel constant + the payload-pointer GEP the
// generated __Package() accessor returns (the @T value, past the header).

// STATIC_MANAGED_REFCOUNT mirrors rt.STATIC_REFCOUNT (ifaces/core/
// pkg/builtins/rt.bni): the sentinel Refcount stored in immortal
// static-managed headers.  A negative refcount marks an object that
// RefInc/RefDec must never count or free.  Mirrored here rather than
// imported because codegen does not const-fold a cross-package
// rt.STATIC_REFCOUNT reference — the same reason managedHeaderBytes()
// mirrors the header size.  Keep in sync with rt.bni.
const STATIC_MANAGED_REFCOUNT int = -1073741824

// writeStaticManagedWrapperTy writes the LLVM type of a static-managed
// global: the 2-word managed header (Refcount, FreeFn) flattened in front
// of the payload — `{ <int>, <int>, <payload> }`.  The payload sits at
// field index 2, exactly managedHeaderBytes() after the global's base: the
// header's int alignment is >= every descriptor payload's natural
// alignment, so no padding is inserted between header and payload, and
// `payload - managedHeaderBytes()` lands on the Refcount word as
// RefInc/RefDec expect.
func writeStaticManagedWrapperTy(out *strings.Builder, payloadLLTy *[]readonly char) {
	out.Write("{ ")
	out.Write(intLL())
	out.Write(", ")
	out.Write(intLL())
	out.Write(", ")
	out.Write(payloadLLTy)
	out.Write(" }")
	return
}

// staticManagedPayloadPtr writes the LLVM constant expression for the
// payload pointer of a static-managed node (laid by irdata.BuildPackageDescriptors)
// — a GEP to field 2, past the two header words.  The result is usable wherever
// an `@<payload>` value is expected; its managed header sits at
// `payload - managedHeaderBytes()`, exactly where RefInc/RefDec read the
// Refcount.  This is what the generated __Package() accessor returns.
func staticManagedPayloadPtr(out *strings.Builder, name *[]readonly char,
		payloadLLTy *[]readonly char) {
	out.Write("getelementptr inbounds (")
	writeStaticManagedWrapperTy(out, payloadLLTy)
	out.Write(", ptr @")
	out.Write(name)
	out.Write(", i32 0, i32 2)")
	return
}
