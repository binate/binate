package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_static_managed.bn — the static-managed object emitter
// that bakes immortal managed nodes (e.g. package descriptors) into the
// binary with the negative STATIC_MANAGED_REFCOUNT sentinel.  Shared
// helpers (setTarget64, contains, fail) live in the sibling codegen test
// files (same package).

// emitStaticManagedGlobal emits `@<name> = weak_odr constant
// { iN, iN, <payload> } { iN <sentinel>, iN 0, <payload> <init> }`.  On the
// LP64 host the header words are i64 and the sentinel is the negative
// STATIC_MANAGED_REFCOUNT.
func TestEmitStaticManagedGlobalLP64() testing.TestResult {
	setTarget64()
	var b @strings.Builder = strings.NewBuilder()
	emitStaticManagedGlobal(b, "_test.node", "%bn_S1_4_main1_1_T", "{ i64 7 }")
	var out @[]char = buf.CopyStr(b.String())
	if !contains(out,
			"@_test.node = weak_odr constant { i64, i64, %bn_S1_4_main1_1_T }") {
		return fail("expected header-prefixed wrapper type")
	}
	if !contains(out,
			"{ i64 -1073741824, i64 0, %bn_S1_4_main1_1_T { i64 7 } }") {
		return fail("expected sentinel refcount + zero freefn + payload init")
	}
	return ""
}

// staticManagedPayloadPtr emits a GEP to field 2 (past the two header
// words), yielding the @T payload pointer whose managed header sits
// managedHeaderBytes() back — 16 bytes on LP64.
func TestStaticManagedPayloadPtr() testing.TestResult {
	setTarget64()
	var b @strings.Builder = strings.NewBuilder()
	staticManagedPayloadPtr(b, "_test.node", "%bn_S1_4_main1_1_T")
	var out @[]char = buf.CopyStr(b.String())
	if !contains(out,
			"getelementptr inbounds ({ i64, i64, %bn_S1_4_main1_1_T }, ptr @_test.node, i32 0, i32 2)") {
		return fail("expected GEP to payload field (index 2)")
	}
	return ""
}

// On a 32-bit target the header words narrow to i32 (the sentinel still
// fits i32), so payload - 8 lands on the Refcount word.  Mirrors the
// target-aware checks in emit_funcvals_test.bn.
func TestEmitStaticManagedGlobalILP32() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 4
	types.SetTarget(t32)
	var b @strings.Builder = strings.NewBuilder()
	emitStaticManagedGlobal(b, "_test.node", "%bn_S1_4_main1_1_T", "{ i32 7 }")
	var out @[]char = buf.CopyStr(b.String())
	types.SetTarget(saved)
	if !contains(out, "weak_odr constant { i32, i32, %bn_S1_4_main1_1_T }") {
		return fail("expected i32 header words on a 32-bit target")
	}
	if !contains(out, "{ i32 -1073741824, i32 0,") {
		return fail("expected i32 sentinel header init on a 32-bit target")
	}
	return ""
}
