package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for emit_static_managed.bn — the static-managed payload-pointer GEP
// the generated __Package() accessor returns (the descriptor's static-managed
// node bytes themselves are laid by ir.BuildPackageDescriptors).  Shared
// helpers (setTarget64, contains, fail) live in the sibling codegen test files
// (same package).

// staticManagedPayloadPtr emits a GEP to field 2 (past the two header
// words), yielding the @T payload pointer whose managed header sits
// managedHeaderBytes() back — 16 bytes on LP64.
func TestStaticManagedPayloadPtr() testing.TestResult {
	setTarget64()
	var b @strings.Builder = strings.NewBuilder()
	staticManagedPayloadPtr(b, "_test.node", "%bn_S1_4_main1_1_T")
	var out @[]char = buf.CopyStr(b.String())
	if !contains(out,
			"getelementptr inbounds ({ i64, i64, %bn_S1_4_main1_1_T }, ptr @_test.node, i32 0, i32 2)") {
		return fail("expected GEP to payload field (index 2)")
	}
	return ""
}
