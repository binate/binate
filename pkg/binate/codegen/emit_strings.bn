package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// LLVM lowerings for string-related and rodata composite-literal IR ops.
// Extracted from emit_helpers.bn to keep that file under the 600-line cap.

// stringToArrayLen returns the element count of the `[N x i8]` slot an
// OP_RODATA_ARRAY alloca's: the declared array length, or the string
// length when the type carries none.  emitStringToArrayAllocDecl (the
// alloca-hoist pre-pass) and emitStringToArrayInstr (the in-place byte
// stores + load) must agree on it.
func stringToArrayLen(instr @ir.Instr) int {
	var arrLen int = 0
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_ARRAY {
		arrLen = instr.Typ.ArrayLen
	}
	if arrLen == 0 { arrLen = len(instr.StrVal) }
	return arrLen
}

// emitStringToArrayAllocDecl emits just the `%vID.tmp = alloca [N x i8]`
// for an OP_RODATA_ARRAY.  The alloca-hoist pre-pass calls this so a
// `var a [N]char = "..."` inside a loop body / if-branch gets its slot at
// the function entry block and doesn't leak native stack per execution
// (LLVM allocas in non-entry blocks aren't freed until function return).
func emitStringToArrayAllocDecl(out *strings.Builder, instr @ir.Instr) {
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".tmp = alloca [")
	stringutils.WriteInt(out, stringToArrayLen(instr))
	out.Write(" x i8]\n")
	return
}

// emitStringToArrayInstr emits the Stage 2c lowering for
// `var s [N]char = "..."`: it writes the literal bytes inline into the
// hoisted `.tmp` `[N x i8]` slot (`store i8 <byte>, ptr <gep>` per byte
// position) — zero-padding the tail when strLen < arrLen — and loads the
// result. The caller stores the array-typed result into the destination
// array-typed alloca.  (strLen > N is rejected at IR-gen time, so we only
// ever write up to `strLen` ≤ N source bytes here.)  The matching `.tmp`
// alloca is hoisted to the function entry block by
// emitStringToArrayAllocDecl.
//
// Inline byte-stores instead of `memcpy from rodata` keeps the runtime
// free of any libc memory primitive (the C-free target).  The source is
// a string LITERAL, so the bytes are baked into the IR as i8 constants — no rodata
// read at runtime.  The `sid` / `@.str.<sid>` rodata global still exists
// for OP_RODATA_SLICE-style accesses that need a runtime-readable buffer;
// this op no longer references it.
func emitStringToArrayInstr(out *strings.Builder, instr @ir.Instr) {
	var arrLen int = stringToArrayLen(instr)
	// The `.tmp` alloca is hoisted to the entry block by
	// emitStringToArrayAllocDecl; only the per-byte stores + load run
	// here (at the original location).  Inline byte stores: source bytes
	// for [0..strLen), zero-pad for [strLen..arrLen).
	var dstBuf @strings.Builder = strings.NewBuilder()
	dstBuf.Write("%v")
	stringutils.WriteInt(dstBuf, instr.ID)
	dstBuf.Write(".tmp")
	emitInlineByteStores(out, buf.CopyStr(dstBuf.String()), instr.StrVal, arrLen, instr.ID)
	// %vID = load [arrLen x i8], [arrLen x i8]* %vID.tmp
	out.Write("  ")
	emitRef(out, instr.ID)
	out.Write(" = load [")
	stringutils.WriteInt(out, arrLen)
	out.Write(" x i8], [")
	stringutils.WriteInt(out, arrLen)
	out.Write(" x i8]* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".tmp\n")
	return
}

// emitStringToRawSlice emits the raw-slice variant of a string→slice
// conversion: extract {data, len} from the static managed-slice header
// global @.str.SID.ms and pack into a `%BnSlice`.  Called for OP_RODATA_SLICE.
func emitStringToRawSlice(out *strings.Builder, instr @ir.Instr, sid int) {
	emitRef(out, instr.ID)
	out.Write(".full = load %BnManagedSlice, %BnManagedSlice* @.str.")
	stringutils.WriteInt(out, sid)
	out.Write(".ms\n  ")
	emitRef(out, instr.ID)
	out.Write(".d = extractvalue %BnManagedSlice ")
	emitRef(out, instr.ID)
	out.Write(".full, 0\n  ")
	emitRef(out, instr.ID)
	out.Write(".l = extractvalue %BnManagedSlice ")
	emitRef(out, instr.ID)
	out.Write(".full, 1\n  ")
	emitRef(out, instr.ID)
	out.Write(".s0 = insertvalue %BnSlice undef, i8* ")
	emitRef(out, instr.ID)
	out.Write(".d, 0\n  ")
	emitRef(out, instr.ID)
	out.Write(" = insertvalue %BnSlice ")
	emitRef(out, instr.ID)
	out.Write(".s0, ")
	out.Write(intLL())
	out.WriteByte(' ')
	emitRef(out, instr.ID)
	out.Write(".l, 1\n")
	return
}

// emitStringToCharsCopy emits the Stage 2b implicit-copy lowering for
// `@[]char = "..."`. Allocates a fresh managed-slice via
// `rt.MakeManagedSlice`, writes the literal bytes
// inline (`store i8 <byte>, ptr <gep>` per character) into the
// backing, and leaves the result %BnManagedSlice in `%vID`. The
// caller owns the allocation; its refcount is already 1
// (MakeManagedSlice sets it).
//
// strLen == 0: skip the inline byte-store loop.  MakeManagedSlice
// produces a zero-length slice whose data slot is rt's zero-byte
// sentinel; there's nothing to write.
//
// Inline byte-stores (instead of the previous `memcpy from rodata`)
// is the C-free-target piece: no libc memory primitive in
// generated code.
func emitStringToCharsCopy(out *strings.Builder, instr @ir.Instr, strLen int) {
	// MakeManagedSlice now uses sret; allocate a buffer and pass
	// its address.  The alloca is hoisted to entry by
	// emitStringToCharsCopyAllocDecl, parallel to OP_MAKE_SLICE's
	// .p alloca hoisting.  The resulting %vID.raw is `load
	// %BnManagedSlice` from that buffer.
	out.Write("call void @")
	out.Write(rtSym("MakeManagedSlice"))
	out.Write("(ptr sret(%BnManagedSlice) align 8 %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p, ")
	out.Write(intLL())
	out.Write(" 1, ")
	out.Write(intLL())
	out.WriteByte(' ')
	stringutils.WriteInt(out, strLen)
	out.Write(")\n  ")
	out.Write("%v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".raw = load %BnManagedSlice, %BnManagedSlice* %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".p\n  ")
	if strLen > 0 {
		// %vID.dst = extractvalue %BnManagedSlice %vID.raw, 0
		out.Write("%v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".dst = extractvalue %BnManagedSlice %v")
		stringutils.WriteInt(out, instr.ID)
		out.Write(".raw, 0\n  ")
		// Per-byte stores from the string literal into the
		// managed-slice backing.
		var dstBuf @strings.Builder = strings.NewBuilder()
		dstBuf.Write("%v")
		stringutils.WriteInt(dstBuf, instr.ID)
		dstBuf.Write(".dst")
		emitInlineByteStores(out, buf.CopyStr(dstBuf.String()), instr.StrVal, strLen, instr.ID)
	}
	// %vID = select i1 true, %BnManagedSlice %vID.raw, %BnManagedSlice %vID.raw
	// (passthrough — we need a single-SSA-value result named %vID)
	out.Write("  ")
	emitRef(out, instr.ID)
	out.Write(" = select i1 true, %BnManagedSlice %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".raw, %BnManagedSlice %v")
	stringutils.WriteInt(out, instr.ID)
	out.Write(".raw\n")
	return
}

// emitInlineByteStores writes `count` consecutive `store i8 <V>, ptr <gep>`
// instructions at byte offsets 0..count-1 from `dstRef`.  Byte values
// come from `data[0..min(count, len(data))]`; positions beyond
// `len(data)` are written as zero (used by the array-write zero-pad
// for `var s [N]char = "...short..."`).
//
// Bytes are baked into the IR as i8 constants — no runtime read of a
// rodata source.  Suitable for short literals (we cap the codebase's
// longest string at ~90 chars in practice); a future variant could
// emit an LLVM loop for very long literals.
func emitInlineByteStores(out *strings.Builder, dstRef *[]readonly char, data *[]readonly char,
		count int, idTag int) {
	for i := 0; i < count; i++ {
		var b int = 0
		if i < len(data) { b = cast(int, data[i]) }
		// gep
		out.Write("  %v")
		stringutils.WriteInt(out, idTag)
		out.Write(".sb")
		stringutils.WriteInt(out, i)
		out.Write("_p = getelementptr i8, ptr ")
		out.Write(dstRef)
		out.Write(", i32 ")
		stringutils.WriteInt(out, i)
		out.WriteByte('\n')
		// store
		out.Write("  store i8 ")
		stringutils.WriteInt(out, b)
		out.Write(", ptr %v")
		stringutils.WriteInt(out, idTag)
		out.Write(".sb")
		stringutils.WriteInt(out, i)
		out.Write("_p\n")
	}
	return
}
