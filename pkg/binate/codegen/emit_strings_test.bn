package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Smoke tests for the string / rodata composite-literal lowerings
// in emit_strings.bn.  These lowerings inline the literal bytes as
// i8 constants — no
// `@bn_F2_3_pkg4_libc1_6_Memcpy` call, no rodata-source GEP — keeping the
// generated runtime free of any libc memory primitive.

// emitStringToArrayInstr (`var s [N]char = "..."` and OP_RODATA_ARRAY)
// allocates a temp [N x i8] slot and writes the literal bytes inline.
func TestEmitStringToArray() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var s [5]char = \"abcde\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "alloca [5 x i8]") {
		return fail("expected alloca [5 x i8]")
	}
	if contains(out, "@bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("must not emit memcpy — bytes are inlined")
	}
	// 'a' == 97 — the first literal byte should appear as a constant.
	if !contains(out, "store i8 97, ptr ") {
		return fail("expected `store i8 97` for first literal byte")
	}
	return ""
}

// Array-write zero-pad tail: `[N]char = "<short>"` where the source
// string is shorter than the array dimension.  emitInlineByteStores'
// `if i < len(data)` branch writes the source bytes; the else branch
// writes zero.  Both must appear: actual chars for the prefix, zero
// for the tail.
func TestEmitStringToArrayZeroPadTail() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var s [5]char = \"ab\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "@bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("must not emit memcpy")
	}
	// 'a' == 97, 'b' == 98 — source bytes.
	if !contains(out, "store i8 97, ptr ") {
		return fail("expected `store i8 97` for 'a'")
	}
	if !contains(out, "store i8 98, ptr ") {
		return fail("expected `store i8 98` for 'b'")
	}
	// Three trailing zero-stores from the pad branch.
	if !contains(out, "store i8 0, ptr ") {
		return fail("expected zero-pad stores for `[5]char` tail")
	}
	return ""
}

// A long array's literal (`var s [20000]char = "hi"`) writes only the literal's bytes and
// zeroes the tail with one bulk zero-fill, and, memory-backed, is stored by one bulk copy
// from its `.tmp` slot: no store per byte of the tail, no SSA load of the array.  A short
// one (`[5]char`, TestEmitStringToArrayZeroPadTail) keeps its per-byte stores.
func TestEmitStringToArrayLongTail() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() { var s [20000]char = \"hi\"; _ = s[1] }\n"
	var out @[]char = compileToLLVM(src)
	if countSubstr(out, "store i8 ") != 2 {
		return fail("expected the two literal bytes' stores only")
	}
	// The zero-fill of the tail: llvm.memset hosted, rt.MemZero on bare metal.
	if !contains(out, ".tail = getelementptr i8, ptr %v") ||
			!contains(out, ".tail, i8 0, i64 19998") && !contains(out, ".tail, i64 19998)") {
		return fail("expected one bulk zero-fill of the 19998-byte tail")
	}
	if contains(out, "load [20000 x i8]") { return fail("the array must not be an SSA value") }
	return ""
}

// On arm32 a string literal's array passed as a by-value argument goes as its own `.tmp` slot,
// `ptr byval(...) align 4`, which LLVM loads in words: the slot is declared that aligned.
func TestEmitStringToArrayByvalAligned() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc f(s [17]char) int { return cast(int, s[0]) }\n"
			"func main() { _ = f(\"abcdefghijklmnopq\") }\n"
	var fn @[]char = llvmFuncBody(compileForArch(src, types.ARCH_ARM32), "main")
	if !contains(fn, ".tmp = alloca [17 x i8], align 4\n") ||
			!contains(fn, "byval([17 x i8]) align 4 %v") {
		return fail(buf.Concat("the literal's slot passed in place is word-aligned: ", fn))
	}
	return ""
}

// emitStringToCharsCopy (the copy via OP_RODATA_MSLICE_COPY) for
// `var s @[]char = "..."` allocates a fresh managed-slice and writes
// the literal bytes inline into the backing.
func TestEmitStringToCharsCopy() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var s @[]char = \"hello\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@bn_F3_3_pkg8_builtins2_rt1_16_MakeManagedSlice") {
		return fail("expected MakeManagedSlice for @[]char copy")
	}
	if contains(out, "@bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("must not emit memcpy — bytes are inlined")
	}
	// 'h' == 104 — first byte of "hello".
	if !contains(out, "store i8 104, ptr ") {
		return fail("expected `store i8 104` for 'h'")
	}
	return ""
}

// Empty-string lowering for @[]char emits MakeManagedSlice but no
// inline byte stores (strLen == 0).
func TestEmitStringToCharsCopyEmpty() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc f() @[]char { return \"\" }\n"
			"func main() { _ = f() }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@bn_F3_3_pkg8_builtins2_rt1_16_MakeManagedSlice") {
		return fail("expected MakeManagedSlice for empty @[]char")
	}
	if contains(out, "@bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("must not emit memcpy")
	}
	return ""
}

// Non-empty @[]char literal in a module that doesn't import pkg/libc:
// no implicit libc.Memcpy declare is emitted (no LLVM call site
// references the symbol).
// This also pins that the inline byte-store shape works in
// libc-free modules.
func TestEmitStringToCharsCopyNoImplicitMemcpyDecl() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc f() @[]char { return \"hi\" }\n"
			"func main() { _ = f() }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "call void @bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("must not call libc.Memcpy — inlined instead")
	}
	if contains(out, "declare void @bn_F2_3_pkg4_libc1_6_Memcpy") {
		return fail("implicit libc.Memcpy declare must be dropped")
	}
	// 'h' == 104, 'i' == 105.
	if !contains(out, "store i8 104, ptr ") {
		return fail("expected `store i8 104` for 'h'")
	}
	if !contains(out, "store i8 105, ptr ") {
		return fail("expected `store i8 105` for 'i'")
	}
	return ""
}

// emitStringToRawSlice (`var s *[]readonly char = "..."` via OP_RODATA_SLICE)
// extracts {data, len} from the static %BnManagedSlice global and packs
// them into a %BnSlice — no MakeManagedSlice call.  Unchanged by step
// 4 (this path doesn't memcpy; it just aliases the rodata global).
func TestEmitStringToRawSlice() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func main() { var s *[]readonly char = \"hi\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue %BnManagedSlice") {
		return fail("expected extractvalue from %BnManagedSlice global")
	}
	if !contains(out, "insertvalue %BnSlice") {
		return fail("expected insertvalue %BnSlice")
	}
	return ""
}
