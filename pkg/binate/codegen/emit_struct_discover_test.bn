package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for emit_struct_discover.bn: the named structs a module's types reach are
// discovered depth first, from a stack of their own.

// deepRing is how many structs the deep tests' rings hold: far past what a walk with a
// call per struct could hold on its stack.
const deepRing int = 100000

// structRing returns n structs S0 .. S<n-1>, each `struct { p *S<i+1>; v int }`, the
// last pointing back at the first.
func structRing(n int) @[]@types.Type {
	var ring @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		var noFields @[]@types.Field
		ring[i] = types.MakeStructType(buf.Concat("S", strconv.Itoa(i)), noFields)
	}
	for i := 0; i < n; i++ {
		ring[i].Fields = fieldsTwo(types.MakePointerType(ring[(i + 1) % n]), "p", types.TypInt(), "v")
	}
	return ring
}

// releaseRing breaks every pointer of a ring of structRing's, so the structs are freed
// one by one rather than a destruction nested per struct (or never, round the ring).
func releaseRing(ring *[]@types.Type) {
	for i := 0; i < len(ring); i++ {
		ring[i].Fields[0].Type.Elem = nil
	}
}

// globalModule returns a module holding one global, g, of type t.
func globalModule(t @types.Type) @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Global = make(ir.Global)
	g.Name = "g"
	g.Typ = t
	m.AddGlobal(g)
	return m
}

// structDefAt returns where the definition of struct name starts in out, or -1.
func structDefAt(out *[]readonly char, name *[]readonly char) int {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("%bn_S1_4_main1_")
	b.Write(strconv.Itoa(len(name)))
	b.Write("_")
	b.Write(name)
	b.Write(" = type")
	return indexOf(out, b.String())
}

// indexOf returns where needle first occurs in haystack, or -1.
func indexOf(haystack *[]readonly char, needle *[]readonly char) int {
	for i := 0; i + len(needle) <= len(haystack); i++ {
		if charsEqual(haystack[i:i + len(needle)], needle) { return i }
	}
	return -1
}

// A struct is defined when first reached, and its fields are looked at, each
// completely before the next: A { b B; c C } with B { d *D } defines A, B, D, C.
func TestStructDiscoveryDepthFirst() testing.TestResult {
	setTarget64()
	var noFields @[]@types.Field
	var d @types.Type = types.MakeStructType("D", fieldsTwo(types.TypInt(), "x", types.TypInt(), "y"))
	var c @types.Type = types.MakeStructType("C", fieldsTwo(types.TypInt(), "x", types.TypInt(), "y"))
	var b @types.Type = types.MakeStructType("B", noFields)
	b.Fields = fieldsTwo(types.MakePointerType(d), "d", types.TypInt(), "n")
	var a @types.Type = types.MakeStructType("A", fieldsTwo(b, "b", c, "c"))
	var out @[]char = EmitModule(globalModule(a))
	var at @[]int = make_slice(int, 4)
	at[0] = structDefAt(out, "A")
	at[1] = structDefAt(out, "B")
	at[2] = structDefAt(out, "D")
	at[3] = structDefAt(out, "C")
	for i := 0; i < 4; i++ {
		if at[i] < 0 { return fail("a struct is not defined") }
		if i > 0 && at[i] < at[i - 1] {
			return fail("the structs are not defined in the order A, B, D, C")
		}
	}
	return ""
}

// A ring of structs far longer than a stack could follow a struct per call defines
// every struct of the ring, in its order.
func TestDeepStructRingDiscovered() testing.TestResult {
	setTarget64()
	var ring @[]@types.Type = structRing(deepRing)
	var out @[]char = EmitModule(globalModule(ring[0]))
	releaseRing(ring)
	var first int = structDefAt(out, "S0")
	var next int = structDefAt(out, "S1")
	var last int = structDefAt(out, buf.Concat("S", strconv.Itoa(deepRing - 1)))
	if first < 0 || next < 0 || last < 0 { return fail("the ring's structs should be defined") }
	if !(first < next && next < last) {
		return fail("the ring's structs should be defined in its order")
	}
	return ""
}
