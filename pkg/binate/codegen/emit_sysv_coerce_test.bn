package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Unit tests for the x86-64 SysV SSE-eightbyte coercion SPELLERS
// (emit_sysv_coerce.bn): the per-eightbyte / return / split-param LLVM type
// strings.  These test the form -> LLVM-string mapping directly (independent of
// the dormant SysVSseInRegs() gate, which only decides WHETHER the wiring calls
// them); the full wired path is verified by a temporary gate-flip + Rosetta
// run (see explorations/plan-hfa-crossbackend.md).  Every string is matched
// against the clang x86_64 reference form.  setTarget64 fixes LP64 layout.
//
// Shared helpers (setTarget64, fieldsTwo, fieldsThree, fail, charsEqual) live in
// sibling codegen files (same package).

// sysvRetStr / sysvDefStr / sysvDeclStr render one speller into a string.
func sysvRetStr(t @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	sysvReturnLLTy(b, t)
	return buf.CopyStr(b.String())
}

func sysvDefStr(id int, t @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	sysvWriteDefineParams(b, id, t)
	return buf.CopyStr(b.String())
}

func sysvDeclStr(t @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	sysvWriteDeclareParamTypes(b, t)
	return buf.CopyStr(b.String())
}

// The RETURN/RESULT type is the first-class `{ eb0, eb1 }` aggregate (bare for
// one eightbyte), byte-for-byte what clang x86_64 returns for these structs.
func TestSysvReturnLLTy() testing.TestResult {
	setTarget64()
	var d2 @types.Type = types.MakeStructType("D2",
			fieldsTwo(types.TypFloat64(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvRetStr(d2), "{ double, double }") {
		return fail("D2 return should be { double, double }")
	}
	var f2 @types.Type = types.MakeStructType("F2",
			fieldsTwo(types.TypFloat32(), "a", types.TypFloat32(), "b"))
	if !charsEqual(sysvRetStr(f2), "<2 x float>") {
		return fail("F2 return should be bare <2 x float>")
	}
	var fd @types.Type = types.MakeStructType("FD",
			fieldsTwo(types.TypFloat32(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvRetStr(fd), "{ float, double }") {
		return fail("FD return should be { float, double }")
	}
	var di2 @types.Type = types.MakeStructType("DI2",
			fieldsTwo(types.TypFloat64(), "a", types.TypInt32(), "b"))
	if !charsEqual(sysvRetStr(di2), "{ double, i32 }") {
		return fail("DI2 return should be { double, i32 }")
	}
	var dc @types.Type = types.MakeStructType("Dc",
			fieldsTwo(types.TypFloat64(), "a", types.TypInt8(), "b"))
	if !charsEqual(sysvRetStr(dc), "{ double, i8 }") {
		return fail("Dc return should be { double, i8 }")
	}
	var f3 @types.Type = types.MakeStructType("F3",
			fieldsThree(
					types.TypFloat32(), "a", types.TypFloat32(), "b", types.TypFloat32(), "c"))
	if !charsEqual(sysvRetStr(f3), "{ <2 x float>, float }") {
		return fail("F3 return should be { <2 x float>, float }")
	}
	var a4f @types.Type = types.MakeArrayType(types.TypFloat32(), 4)
	if !charsEqual(sysvRetStr(a4f), "{ <2 x float>, <2 x float> }") {
		return fail("[4]f32 return should be { <2 x float>, <2 x float> }")
	}
	return ""
}

// An ARG/PARAM is SPLIT into one LLVM param per eightbyte on the define line
// (`<eb> %vID.ag<eb>`), matching clang's split-arg convention.
func TestSysvWriteDefineParams() testing.TestResult {
	setTarget64()
	var d2 @types.Type = types.MakeStructType("D2",
			fieldsTwo(types.TypFloat64(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvDefStr(5, d2), "double %v5.ag0, double %v5.ag1") {
		return fail("D2 param should split into two double params")
	}
	var f2 @types.Type = types.MakeStructType("F2",
			fieldsTwo(types.TypFloat32(), "a", types.TypFloat32(), "b"))
	if !charsEqual(sysvDefStr(5, f2), "<2 x float> %v5.ag0") {
		return fail("F2 param should be one <2 x float> param")
	}
	var di2 @types.Type = types.MakeStructType("DI2",
			fieldsTwo(types.TypFloat64(), "a", types.TypInt32(), "b"))
	if !charsEqual(sysvDefStr(7, di2), "double %v7.ag0, i32 %v7.ag1") {
		return fail("DI2 param should split into double + i32")
	}
	return ""
}

// The extern-declare split writes just the per-eightbyte TYPES (no names).
func TestSysvWriteDeclareParamTypes() testing.TestResult {
	setTarget64()
	var fd @types.Type = types.MakeStructType("FD",
			fieldsTwo(types.TypFloat32(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvDeclStr(fd), "float, double") {
		return fail("FD declare types should be float, double")
	}
	var d2 @types.Type = types.MakeStructType("D2",
			fieldsTwo(types.TypFloat64(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvDeclStr(d2), "double, double") {
		return fail("D2 declare types should be double, double")
	}
	return ""
}

// sysvPtrArgsStr / sysvPtrLoadsStr render the by-address shim/capture split
// helpers (used by the func-value/closure shim underlying-call, step 2c-funcval).
func sysvPtrArgsStr(destBase *[]readonly char, t @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	sysvWriteAggPtrArgs(b, destBase, t)
	return buf.CopyStr(b.String())
}

func sysvPtrLoadsStr(ptrName *[]readonly char, destBase *[]readonly char, t @types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	sysvEmitAggPtrLoads(b, ptrName, destBase, t)
	return buf.CopyStr(b.String())
}

// The by-address split ARG list writes `<eb0> <destBase>_e0, <eb1> <destBase>_e1`
// — the shim passes an aggregate that arrived by-address as split register args.
func TestSysvWriteAggPtrArgs() testing.TestResult {
	setTarget64()
	var d2 @types.Type = types.MakeStructType("D2",
			fieldsTwo(types.TypFloat64(), "a", types.TypFloat64(), "b"))
	if !charsEqual(sysvPtrArgsStr("%a0", d2), "double %a0_e0, double %a0_e1") {
		return fail("D2 by-address args should split to two doubles")
	}
	var f2 @types.Type = types.MakeStructType("F2",
			fieldsTwo(types.TypFloat32(), "a", types.TypFloat32(), "b"))
	if !charsEqual(sysvPtrArgsStr("%a0", f2), "<2 x float> %a0_e0") {
		return fail("F2 by-address arg should be one <2 x float>")
	}
	// A capture uses the %cap<i> dest base; a mixed SSE+INTEGER eightbyte splits.
	var di2 @types.Type = types.MakeStructType("DI2",
			fieldsTwo(types.TypFloat64(), "a", types.TypInt32(), "b"))
	if !charsEqual(sysvPtrArgsStr("%cap1", di2), "double %cap1_e0, i32 %cap1_e1") {
		return fail("DI2 capture args should be double %cap1_e0, i32 %cap1_e1")
	}
	return ""
}

// The by-address split LOADs read each eightbyte from `<ptr>+eb*8` (eb 0 is the
// bare pointer; eb 1 GEPs +8) into `<destBase>_e<eb>`.
func TestSysvEmitAggPtrLoads() testing.TestResult {
	setTarget64()
	var d2 @types.Type = types.MakeStructType("D2",
			fieldsTwo(types.TypFloat64(), "a", types.TypFloat64(), "b"))
	var out @[]char = sysvPtrLoadsStr("%a0", "%a0", d2)
	if !contains(out, "%a0_e0 = load double, ptr %a0\n") {
		return fail("eightbyte 0 loads double from the bare pointer")
	}
	if !contains(out, "%a0.e1 = getelementptr i8, ptr %a0, i64 8\n") {
		return fail("eightbyte 1 GEPs +8")
	}
	if !contains(out, "%a0_e1 = load double, ptr %a0.e1\n") {
		return fail("eightbyte 1 loads double from the +8 pointer")
	}
	return ""
}
