package "pkg/binate/codegen"

import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// x86-64 SysV #[c_export] entry-thunk parameter marshalling.
//
// A #[c_export] entry thunk (emit_cexport_thunk.bn) receives each param in the
// platform C-ABI form and forwards it in Binate's internal form.  For an x86-64
// <=16-byte aggregate the two conventions can classify the SAME param differently
// (register-class vs SysV MEMORY-class), so the four quadrants each need a distinct
// marshalling.  These helpers emit it — the SSE-split / reconstruct / load / forward
// sequences the thunk's declaration, reconstruction, and forward passes call.  They
// share the eightbyte primitives (sysvEbLLTy / sysvWriteEbPtr / sysvName) and the
// param-type spelling (writeParamTypeLLVM) with the call-site coercion in
// emit_sysv_coerce.bn.

// sysvWriteThunkSseParams writes the SSE-split param list WITH names for one x64
// SSE aggregate param i of a #[c_export] entry thunk: `<eb0> %ca<i>.ag0, <eb1>
// %ca<i>.ag1`.  The x64 C ABI and Binate's internal convention pass an
// in-register SSE aggregate identically (SSE-split in XMM), so the thunk uses
// this verbatim for BOTH its own param declaration and the forward to the mangled
// internal define (whose matching params are sysvWriteDefineParams) — a
// straight-through pass with no reconstruction.
func sysvWriteThunkSseParams(out *strings.Builder, i int, t @types.Type) {
	var n int = types.SysVNumEightbytes(t)
	for eb := 0; eb < n; eb++ {
		if eb > 0 { out.Write(", ") }
		sysvEbLLTy(out, t, eb)
		out.Write(" %ca")
		stringutils.WriteInt(out, i)
		out.Write(".ag")
		stringutils.WriteInt(out, eb)
	}
	return
}

// sysvWriteThunkSseSpill reconstructs a c_export-thunk x64 SSE aggregate param i
// that ARRIVES SSE-split (its eightbytes in XMM/GP registers per the C ABI) but
// must be FORWARDED to a MEMORY-class internal define as a `ptr byval`.  It allocas
// an `[N x i64]` slot and stores each incoming eightbyte `%ca<i>.ag<eb>` at its
// byte offset; the caller then forwards `ptr byval(<T>) %ca<i>.slot` (byval reads
// SizeOf(T) ≤ the slot).  This is the SSE analogue of the plain spill for a param
// that arrives coerced — same `.slot` name, so the byval-forward branch is shared.
func sysvWriteThunkSseSpill(out *strings.Builder, i int, t @types.Type) {
	var base @[]char = sysvName("%ca", i, ".slot")
	var n int = types.SysVNumEightbytes(t)
	out.Write("  ")
	out.Write(base)
	out.Write(" = alloca [")
	stringutils.WriteInt(out, n)
	out.Write(" x i64], align 8\n")
	for eb := 0; eb < n; eb++ {
		if eb > 0 {
			out.Write("  ")
			out.Write(base)
			out.Write(".e")
			stringutils.WriteInt(out, eb)
			out.Write(" = getelementptr i8, ptr ")
			out.Write(base)
			out.Write(", i64 ")
			stringutils.WriteInt(out, eb * 8)
			out.Write("\n")
		}
		out.Write("  store ")
		sysvEbLLTy(out, t, eb)
		out.Write(" %ca")
		stringutils.WriteInt(out, i)
		out.Write(".ag")
		stringutils.WriteInt(out, eb)
		out.Write(", ptr ")
		sysvWriteEbPtr(out, base, eb)
		out.Write("\n")
	}
	return
}

// sysvWriteThunkCMemSseLoad loads a c_export-thunk x64 aggregate param i that the C
// ABI passes MEMORY-class (arrives as `ptr byval %ca<i>` — e.g. an SSE-class
// aggregate the SysV XMM file was exhausted before, so it spilled to the stack) but
// the internal define takes SSE-SPLIT.  It loads each eightbyte from the byval
// pointer into `%ca<i>.ld<eb>` so the forward can pass them SSE-split
// (sysvWriteThunkCMemSseArgs) to match the internal define's per-eightbyte params.
// The complement of sysvWriteThunkSseSpill (which arrives SSE-split, forwards byval).
func sysvWriteThunkCMemSseLoad(out *strings.Builder, i int, t @types.Type) {
	var base @[]char = sysvName("%ca", i, "")
	var n int = types.SysVNumEightbytes(t)
	for eb := 0; eb < n; eb++ {
		if eb > 0 {
			out.Write("  ")
			out.Write(base)
			out.Write(".e")
			stringutils.WriteInt(out, eb)
			out.Write(" = getelementptr i8, ptr ")
			out.Write(base)
			out.Write(", i64 ")
			stringutils.WriteInt(out, eb * 8)
			out.Write("\n")
		}
		out.Write("  ")
		out.Write(base)
		out.Write(".ld")
		stringutils.WriteInt(out, eb)
		out.Write(" = load ")
		sysvEbLLTy(out, t, eb)
		out.Write(", ptr ")
		sysvWriteEbPtr(out, base, eb)
		out.Write("\n")
	}
	return
}

// sysvWriteThunkCMemSseArgs writes the forwarded SSE-split args for a param loaded
// by sysvWriteThunkCMemSseLoad: `<eb0> %ca<i>.ld0, <eb1> %ca<i>.ld1`.
func sysvWriteThunkCMemSseArgs(out *strings.Builder, i int, t @types.Type) {
	var n int = types.SysVNumEightbytes(t)
	for eb := 0; eb < n; eb++ {
		if eb > 0 { out.Write(", ") }
		sysvEbLLTy(out, t, eb)
		out.Write(" %ca")
		stringutils.WriteInt(out, i)
		out.Write(".ld")
		stringutils.WriteInt(out, eb)
	}
	return
}

// sysvWriteThunkCMemGpLoad materializes a c_export-thunk x64 GP aggregate param i that
// the C ABI passes MEMORY-class (arrives `ptr byval %ca<i>` — the GP file was exhausted)
// but the internal define takes REGISTER-class by value (a coerced `[N x i64]`).  It
// loads the NATURAL value (`llvmType`, SizeOf bytes — exactly the byval pointee, never
// an over-read) and restores it through an alloca of the internal param type
// (writeParamTypeLLVM), so a non-word-multiple struct's coerced `[N x i64]` load stays
// in-bounds — the same store-into-coerced-slot discipline as the normal call-site
// coercion (emitAggCallArgPreamble) and the spill path.  The forward then passes
// `%ca<i>.ld` by value (sysvWriteThunkCMemGpArg).  In practice only a 1-eightbyte GP
// struct/array reaches this quadrant: the C-vs-internal GP overshoot is capped at one
// word, so a 2-eightbyte aggregate (16-byte struct, slice, iface-/func-value) lands
// both-memory and rides the byval branch instead.  The code stays general (any
// writeParamTypeLLVM form), but that 1-eightbyte struct/array is the only live shape.
// The GP complement of sysvWriteThunkCMemSseLoad, which SSE-SPLITS into per-eightbyte
// values instead.
func sysvWriteThunkCMemGpLoad(out *strings.Builder, i int, t @types.Type) {
	out.Write("  %ca")
	stringutils.WriteInt(out, i)
	out.Write(".agp = alloca ")
	writeParamTypeLLVM(out, t)
	out.Write(", align 8\n  %ca")
	stringutils.WriteInt(out, i)
	out.Write(".nv = load ")
	out.Write(llvmType(t))
	out.Write(", ptr %ca")
	stringutils.WriteInt(out, i)
	out.Write("\n  store ")
	out.Write(llvmType(t))
	out.Write(" %ca")
	stringutils.WriteInt(out, i)
	out.Write(".nv, ptr %ca")
	stringutils.WriteInt(out, i)
	out.Write(".agp\n  %ca")
	stringutils.WriteInt(out, i)
	out.Write(".ld = load ")
	writeParamTypeLLVM(out, t)
	out.Write(", ptr %ca")
	stringutils.WriteInt(out, i)
	out.Write(".agp\n")
	return
}

// sysvWriteThunkCMemGpArg writes the forwarded by-value arg for a param loaded by
// sysvWriteThunkCMemGpLoad: `<internal-param-type> %ca<i>.ld`.
func sysvWriteThunkCMemGpArg(out *strings.Builder, i int, t @types.Type) {
	writeParamTypeLLVM(out, t)
	out.Write(" %ca")
	stringutils.WriteInt(out, i)
	out.Write(".ld")
	return
}
