package "pkg/binate/codegen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Helpers
// ============================================================

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func strToBytes(s *[]readonly char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = cast(uint8, s[i])
	}
	return r
}

func contains(haystack *[]readonly char, needle *[]readonly char) bool {
	if len(needle) > len(haystack) { return false }
	for i := 0; i <= len(haystack) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// compileToLLVM compiles Binate source to LLVM IR text.  Runs the
// type-checker first and records the populated Checker on the module
// (m.Checker, via GenModule) so IR-gen consults `Checker.ExprType(id)`
// for resolved types — needed by paths like capture analysis that depend on
// the side-table.
func compileToLLVM(src *[]readonly char) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var out @[]char = EmitModule(m)
	// Clear so subsequent tests in the same run don't inherit
	// this Checker's ExprTypes registry.
	return out
}

// compileToLLVMOpt is compileToLLVM but runs the IR opt passes (mem2reg etc.)
// at the given level first — needed for tests that must exercise emitted OP_PHIs
// (mem2reg is the only phi producer, gated at level >= 1).
func compileToLLVMOpt(src *[]readonly char, level int) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	ir.RunOptPasses(m, level)
	return EmitModule(m)
}

// ============================================================
// mangle tests (now in pkg/binate/mangle, tested via import)
// ============================================================

func TestMangleFuncNameMain() testing.TestResult {
	// `main` in pkg `main` mangles like any other free function
	// (no special case anymore — the C runtime calls `bn_entry`,
	// not the user's main directly).
	var r @[]char = mangle.FuncName("main", "main")
	if !seq(r, "bn_F1_4_main1_4_main") {
		return fail("expected bn_F1_4_main1_4_main")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameLocal() testing.TestResult {
	var r @[]char = mangle.FuncName("parser", "New")
	if !seq(r, "bn_F1_6_parser1_3_New") {
		return fail("expected bn_F1_6_parser1_3_New")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameQualified() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "parser.New")
	if !seq(r, "bn_F1_6_parser1_3_New") {
		return fail("expected bn_F1_6_parser1_3_New")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameNestedPkg() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "pkg/std/os.Write")
	if !seq(r, "bn_F3_3_pkg3_std2_os1_5_Write") {
		return fail("expected bn_F3_3_pkg3_std2_os1_5_Write")
	}
	var pass testing.TestResult
	return pass
}

