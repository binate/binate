package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/check"

import "pkg/binate/iropt"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// ============================================================
// Helpers
// ============================================================

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func strToBytes(s *[]readonly char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = cast(uint8, s[i])
	}
	return r
}

func contains(haystack *[]readonly char, needle *[]readonly char) bool {
	if len(needle) > len(haystack) { return false }
	for i := 0; i <= len(haystack) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// checkedFile type-checks file and returns its checker, stopping the run on a check
// error: IR-gen is defined only on a program that checks.
func checkedFile(file @ast.File) @check.Checker {
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var errs @[]check.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		panic(buf.Concat("a test program does not type-check: ", check.FormatCheckError(errs[0])))
	}
	return c
}

// compileToLLVM compiles Binate source to LLVM IR text: it type-checks the
// program (checkedFile) and generates it with the checker's records.
func compileToLLVM(src *[]readonly char) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	var m @ir.Module = irgen.GenModule(checkedFile(file), file)
	var out @[]char = EmitModule(m)
	return out
}

// compileToLLVMOpt is compileToLLVM but runs the IR opt passes (mem2reg etc.)
// at the given level first — needed for tests that must exercise emitted OP_PHIs
// (mem2reg is the only phi producer, gated at level >= 1).
func compileToLLVMOpt(src *[]readonly char, level int) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	var m @ir.Module = irgen.GenModule(checkedFile(file), file)
	iropt.RunOptPasses(m, level)
	return EmitModule(m)
}

// ============================================================
// mangle tests (pkg/binate/mangle, tested via import)
// ============================================================

func TestMangleFuncNameMain() testing.TestResult {
	// `main` in pkg `main` mangles like any other free function
	// (no special case — the startup code calls `bn_entry`,
	// not the user's main directly).
	var r @[]char = mangle.FuncName("main", "main")
	if !seq(r, "bn_F1_4_main1_4_main") {
		return fail("expected bn_F1_4_main1_4_main")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameLocal() testing.TestResult {
	var r @[]char = mangle.FuncName("parser", "New")
	if !seq(r, "bn_F1_6_parser1_3_New") {
		return fail("expected bn_F1_6_parser1_3_New")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameQualified() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "parser.New")
	if !seq(r, "bn_F1_6_parser1_3_New") {
		return fail("expected bn_F1_6_parser1_3_New")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameNestedPkg() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "pkg/std/os.Write")
	if !seq(r, "bn_F3_3_pkg3_std2_os1_5_Write") {
		return fail("expected bn_F3_3_pkg3_std2_os1_5_Write")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleGlobalName() testing.TestResult {
	var r @[]char = mangle.GlobalName("main", "count")
	if !seq(r, "bn_G1_4_main1_5_count") {
		return fail("expected bn_G1_4_main1_5_count")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleStructNameLocal() testing.TestResult {
	var r @[]char = mangle.StructName("parser", "Parser")
	if !seq(r, "bn_S1_6_parser1_6_Parser") {
		return fail("expected bn_S1_6_parser1_6_Parser")
	}
	var pass testing.TestResult
	return pass
}

func TestMangleStructNameQualified() testing.TestResult {
	var r @[]char = mangle.StructName("main", "ast.File")
	if !seq(r, "bn_S1_3_ast1_4_File") {
		return fail("expected bn_S1_3_ast1_4_File")
	}
	var pass testing.TestResult
	return pass
}
