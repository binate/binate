package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Type mapping
// ============================================================

// needsSret returns true if a C-extern return type needs an
// indirect return (sret) under the target's C ABI.  Binate's own
// IR-level struct returns use a register convention that LLVM
// legalizes consistently on both sides, so this only matters at
// the boundary with clang-compiled C externs (binate_runtime.c) —
// there, Binate's declaration must carry the same sret attribute
// clang's C frontend inserts, or the calling conventions diverge
// and the returned struct is read from the wrong place (garbage).
//
// The size threshold is target-specific:
//   - LP64 (x86-64 SysV, AArch64 AAPCS64): composites > 16 bytes
//     (two register-words) return via sret; up to 16 bytes go in
//     register pairs.
//   - ILP32 ARM (AAPCS32, arm-linux-gnueabihf): composites > 4
//     bytes (one word) return via sret.  Verified against clang:
//     an 8-byte struct already gets `sret` there, while a 4-byte
//     one returns in r0.
func needsSret(t @types.Type) bool {
	return types.NeedsSret(t)
}

// unwrapNamed peels TYP_NAMED wrappers down to the underlying concrete
// type.  A named distinct scalar (`type F float32`) reaches codegen as
// a TYP_NAMED carrying its name (kept that far for method dispatch in
// IR-gen); its LLVM layout and instruction selection are those of the
// underlying, so the Kind-based emitters peel it here before inspecting
// the kind / width / signedness.  Loops to handle named-over-named.
func unwrapNamed(t @types.Type) @types.Type {
	for t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	return t
}

// stripWrappers peels the transparent semantic wrappers — TYP_READONLY
// and TYP_NAMED — down to the representation type, the same set llvmType
// peels before choosing an LLVM type.  A Kind-dispatch that selects a
// representation (e.g. the global static-zero init token) must peel
// through this first, or a `readonly`/named wrapper falls through every
// representation branch: a named-over-aggregate global would pick its
// token from TYP_NAMED (matching nothing) and emit an invalid bare `0`
// against, e.g., `%BnIfaceValue`.  Interleaves both peels to a fixpoint,
// so wrapper order (`readonly @T` vs a named-over-readonly) doesn't matter.
func stripWrappers(t @types.Type) @types.Type {
	return types.StripWrappers(t)
}

// llvmType maps a Binate type to its LLVM IR type string.
func llvmType(t @types.Type) @[]char {
	if t == nil {
		return intLL()
	}
	// const is purely a semantic flag — unwrap for layout / LLVM
	// type purposes.
	if t.Kind == types.TYP_READONLY { return llvmType(t.Elem) }
	// A named distinct type has its underlying's layout.
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		return llvmType(t.Underlying)
	}
	if t.Kind == types.TYP_VOID { return "void" }
	if t.Kind == types.TYP_BOOL { return "i1" }
	if t.Kind == types.TYP_UNTYPED_BOOL { return "i1" }
	if t.Kind == types.TYP_NIL { return "i8*" }
	if t.Kind == types.TYP_POINTER { return "i8*" }
	if t.Kind == types.TYP_MANAGED_PTR { return "i8*" }
	if t.Kind == types.TYP_SLICE { return "%BnSlice" }
	if t.Kind == types.TYP_MANAGED_SLICE { return "%BnManagedSlice" }
	if t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return "%BnFuncValue"
	}
	if t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return "%BnIfaceValue"
	}

	if t.Kind == types.TYP_ARRAY {
		// [N]T → [N x llvmType(T)]
		var b @strings.Builder = strings.NewBuilder()
		b.Write("[")
		stringutils.WriteInt(b, t.ArrayLen)
		b.Write(" x ")
		b.Write(llvmType(t.Elem))
		b.Write("]")
		return buf.CopyStr(b.String())
	}

	if t.Kind == types.TYP_STRUCT {
		// Named struct → %bn_pkg__Name
		if len(t.Name) > 0 {
			var b @strings.Builder = strings.NewBuilder()
			b.Write("%")
			b.Write(mangle.StructName(modulePkgName,t.Name))
			return buf.CopyStr(b.String())
		}
		// Anonymous struct (e.g., multi-return) → inline {T1, T2, ...}
		if len(t.Fields) > 0 {
			return multiReturnType_fields(t.Fields)
		}
		return intLL()
	}

	// Integer types: use Width field. Width=64 maps to i64 explicitly
	// (for `int64` on any target); Width=0 (untyped, no concrete
	// width assigned) falls back to the target's Binate-int width.
	if t.Kind == types.TYP_INT || t.Kind == types.TYP_UNTYPED_INT {
		if t.Width == 8 { return "i8" }
		if t.Width == 16 { return "i16" }
		if t.Width == 32 { return "i32" }
		if t.Width == 64 { return "i64" }
		return intLL()
	}

	// Float types: 32 → float, 64 → double.
	if t.Kind == types.TYP_FLOAT {
		if t.Width == 32 { return "float" }
		return "double"
	}
	if t.Kind == types.TYP_UNTYPED_FLOAT { return "double" }

	return intLL()
}

// collectStructTypes scans the module's functions AND globals to discover
// named struct types that need an LLVM `%bn_pkg__Struct = type {…}` def.
func collectStructTypes(m @ir.Module) {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		// Scan function parameters
		if len(f.Params) > 0 {
			for p := 0; p < len(f.Params); p++ {
				discoverStructFromType(f.Params[p].Typ)
			}
		}
		// Scan function return types
		if len(f.Results) > 0 {
			for r := 0; r < len(f.Results); r++ {
				discoverStructFromType(f.Results[r])
			}
		}
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var instr @ir.Instr = blk.Instrs[k]
				// Scan all type references on this instruction
				discoverStructFromType(instr.Typ)
				discoverStructFromType(instr.TypeArg)
				if len(instr.Args) > 0 {
					for a := 0; a < len(instr.Args); a++ {
						discoverStructFromType(instr.Args[a].Typ)
						discoverStructFromType(instr.Args[a].TypeArg)
					}
				}
			}
		}
	}
	// Globals can reference a struct reached through no function — e.g. a
	// cross-package `var g StructType` whose struct is used only via the
	// global.  collectStructTypes runs before the global-emission loop, so
	// discovering here ensures the `%bn_pkg__Struct = type {…}` def is
	// printed before the `@g = global %bn_pkg__Struct` (or `external
	// global`) that references it — otherwise clang reports `use of
	// undefined type`.
	for i := 0; i < len(m.Globals); i++ {
		discoverStructFromType(m.Globals[i].Typ)
	}
}

// discoverStructFromType recursively discovers struct types from any type reference
func discoverStructFromType(t @types.Type) {
	if t == nil { return }
	// Peel const wrappers — const doesn't affect layout / struct
	// registration.
	if t.Kind == types.TYP_READONLY {
		discoverStructFromType(t.Elem)
		return
	}
	if t.Kind == types.TYP_STRUCT {
		addStructDef(t)
		return
	}
	if t.Kind == types.TYP_MANAGED_PTR || t.Kind == types.TYP_POINTER {
		discoverStructFromType(t.Elem)
		return
	}
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		discoverStructFromType(t.Elem)
		return
	}
	// A named distinct type is a transparent wrapper (`type Alias @Other`,
	// named-over-struct).  A named *struct* is already TYP_STRUCT, but a
	// named-over-struct flows as TYP_NAMED, so recurse into the underlying
	// to discover the wrapped struct.
	if t.Kind == types.TYP_NAMED {
		discoverStructFromType(t.Underlying)
		return
	}
	// [N]Struct must recurse into its element so the struct is declared
	// before an array-of-struct value (e.g. an array-typed global)
	// references it.
	if t.Kind == types.TYP_ARRAY {
		discoverStructFromType(t.Elem)
		return
	}
}

// structShapesMatch reports whether two struct types would emit the SAME
// LLVM type body — equal field count and each field's LLVM representation.
// Used by addStructDef's symbol-collision guard to tell a legitimate
// re-discovery of one struct (same body — dedup) from a genuine collision
// between two differently-shaped structs (different body — abort).
func structShapesMatch(a @types.Type, b @types.Type) bool {
	if len(a.Fields) != len(b.Fields) { return false }
	for i := 0; i < len(a.Fields); i++ {
		if !charsEqual(llvmType(a.Fields[i].Type), llvmType(b.Fields[i].Type)) {
			return false
		}
	}
	return true
}

// addStructDef registers a named struct type for LLVM type definition emission.
func addStructDef(t @types.Type) {
	// Truly anonymous — shouldn't happen, IR gen assigns
	// synthetic names.
	if len(t.Name) == 0 { return }
	// Check if already registered (by mangled LLVM name to catch
	// both "Foo" and "pkg.Foo" mapping to the same %bn_pkg__Foo)
	var mangledName @[]char = mangle.StructName(modulePkgName,t.Name)
	for i := 0; i < len(moduleStructDefs); i++ {
		if charsEqual(mangledName, moduleStructDefs[i].MangledName) {
			// Same mangled symbol.  Normally a re-discovery of the SAME
			// struct, so dedup.  But if the two disagree in SHAPE, two
			// distinct structs collide on one LLVM symbol — the cross-
			// package collision class Option B's struct-name
			// qualification eliminated (e.g. reflect.Package vs a
			// module's own Package before qualification).  Silently
			// keeping the first would give the later struct the first's
			// layout (an out-of-range field GEP / wrong-code).  This must
			// not happen post-qualification; abort loudly as a codegen
			// precondition rather than miscompile.
			if !structShapesMatch(t, moduleStructDefs[i].Typ) {
				panic("codegen: differently-shaped structs collide on one mangled symbol")
			}
			return
		}
	}
	// Register first (before recursing) to prevent infinite recursion
	var sd StructDef
	sd.Name = t.Name
	sd.MangledName = mangledName
	sd.Typ = t
	moduleStructDefs = slices.Append[StructDef](moduleStructDefs, sd)
	// Recurse for field types
	if len(t.Fields) > 0 {
		for i := 0; i < len(t.Fields); i++ {
			discoverStructFromType(t.Fields[i].Type)
		}
	}
}

// typeBits returns the bit width of a type for LLVM IR (e.g., 1 for
// bool, 64 for int64).  Must agree with llvmType for each Kind:
// untyped int falls back to the target's Binate-int width (i32 under
// arm32-linux), untyped float falls back to 64 (double), bool is 1.
// Mismatch with llvmType causes emitCast's bits-driven trunc /
// sext / zext path to emit nonsense against the actual IR-level
// value width.
func typeBits(t @types.Type) int {
	var targetIntBits int = types.GetTarget().IntSize * 8
	if t == nil { return targetIntBits }
	if t.Kind == types.TYP_READONLY { return typeBits(t.Elem) }
	if t.Kind == types.TYP_NAMED && t.Underlying != nil { return typeBits(t.Underlying) }
	if t.Kind == types.TYP_BOOL || t.Kind == types.TYP_UNTYPED_BOOL { return 1 }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT {
		if t.Width > 0 { return t.Width }
		return 64
	}
	if t.Width > 0 { return t.Width }
	return targetIntBits
}

// isUnsigned returns true if the type is unsigned (for choosing zext vs sext).
func isUnsigned(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_READONLY { return isUnsigned(t.Elem) }
	// A named distinct type's signedness is its underlying's —
	// MakeNamedType leaves .Signed false, so without this a
	// `type Celsius int` would read as unsigned (zext, udiv, ult).
	if t.Kind == types.TYP_NAMED && t.Underlying != nil { return isUnsigned(t.Underlying) }
	return !t.Signed
}

// multiReturnType_fields produces inline LLVM struct type from struct fields
func multiReturnType_fields(fields *[]@types.Field) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("{")
	for i := 0; i < len(fields); i++ {
		if i > 0 {
			b.Write(", ")
		}
		b.Write(llvmType(fields[i].Type))
	}
	b.Write("}")
	return buf.CopyStr(b.String())
}

// multiReturnType produces LLVM struct type like {i64, i64}
func multiReturnType(results *[]@types.Type) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("{")
	for i := 0; i < len(results); i++ {
		if i > 0 {
			b.Write(", ")
		}
		b.Write(llvmType(results[i]))
	}
	b.Write("}")
	return buf.CopyStr(b.String())
}

// multiReturnTypeFromArgs produces LLVM struct type from instruction args
func multiReturnType_args(args *[]@ir.Instr) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("{")
	for i := 0; i < len(args); i++ {
		if i > 0 {
			b.Write(", ")
		}
		b.Write(llvmType(args[i].Typ))
	}
	b.Write("}")
	return buf.CopyStr(b.String())
}
