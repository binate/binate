package "pkg/binate/codegen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

func TestEmitPackedStruct() testing.TestResult {
	// Generate a module from source that uses a struct
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("type Mixed struct {\n")
	cb.Write("\tA int8\n")
	cb.Write("\tB int\n")
	cb.Write("}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar m Mixed\n")
	cb.Write("\tm.A = cast(int8, 1)\n")
	cb.Write("\tm.B = 42\n")
	cb.Write("}\n")
	var src *[]readonly char = cb.String()
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @ir.Module = ir.GenModule(nil, file)

	var out @[]char = EmitModule(m)
	// Should be a packed struct with padding
	if !contains(out, "%bn_main__Mixed = type <{") {
		return fail("expected packed struct type def")
	}
	var pass testing.TestResult
	return pass
}

// needsSret's byte threshold is target-specific: a composite returns
// via sret when it exceeds one register-pair on LP64 (> 16 bytes) but
// only one word on ILP32 ARM (AAPCS32, > 4 bytes).  An 8-byte aggregate
// therefore srets on arm32 yet returns in registers on LP64 — the
// 5..16-byte window where the two targets diverge.  pkg/binate/vm's
// silent crash on builder-comp_arm32_linux lived in exactly this window:
// the definition used target-aware needsSret while a call site used a
// hardcoded `> 16`, so an 8-byte return was declared sret but called
// register-style.  A regression that dropped the target-awareness here
// would reintroduce that mismatch on the arm32 lane — which is CI-only,
// so it would pass amd64 and slip through.  This pins the threshold for
// every path (direct, iface-method, func-value) that routes through
// needsSret; the func-value path additionally has
// TestFuncValueUsesSretIsTargetAware.
func TestNeedsSretIsTargetAware() testing.TestResult {
	// 8-byte aggregate: two int32 fields (8 bytes on both targets,
	// since int32 is fixed-width — so the LP64-vs-arm32 divergence
	// is unambiguous and not an artifact of int's width).
	var f8 @[]@types.Field = make_slice(@types.Field, 2)
	var fa @types.Field = make(types.Field)
	fa.Name = "a"
	fa.Type = types.TypInt32()
	f8[0] = fa
	var fb @types.Field = make(types.Field)
	fb.Name = "b"
	fb.Type = types.TypInt32()
	f8[1] = fb
	var s8 @types.Type = types.MakeStructType("Pair32", f8)

	// 4-byte aggregate: a single int32 field — exactly one word.
	// Must NOT sret on arm32 (4 is not > 4) — the boundary the
	// AAPCS32 "returns in r0" case depends on.
	var f4 @[]@types.Field = make_slice(@types.Field, 1)
	var fc @types.Field = make(types.Field)
	fc.Name = "a"
	fc.Type = types.TypInt32()
	f4[0] = fc
	var s4 @types.Type = types.MakeStructType("Word32", f4)

	// >16-byte aggregate: a managed-slice is three words (24 bytes
	// LP64, 12 bytes arm32) — above both thresholds, sret on both.
	var sBig @types.Type = types.MakeManagedSliceType(types.TypInt())

	var saved types.TargetInfo = types.GetTarget()

	var t32 types.TargetInfo
	t32.PointerSize = 4
	t32.IntSize = 4
	t32.MaxAlign = 4
	types.SetTarget(t32)
	var arm32_8 bool = needsSret(s8)
	var arm32_4 bool = needsSret(s4)
	var arm32_big bool = needsSret(sBig)

	var t64 types.TargetInfo
	t64.PointerSize = 8
	t64.IntSize = 8
	t64.MaxAlign = 8
	types.SetTarget(t64)
	var lp64_8 bool = needsSret(s8)
	var lp64_4 bool = needsSret(s4)
	var lp64_big bool = needsSret(sBig)

	types.SetTarget(saved)

	if !arm32_8 { return fail("8-byte aggregate must use sret on arm32 (> 4)") }
	if lp64_8 { return fail("8-byte aggregate must NOT use sret on LP64 (<= 16)") }
	if arm32_4 { return fail("4-byte aggregate must NOT use sret on arm32 (== 4, not > 4)") }
	if lp64_4 { return fail("4-byte aggregate must NOT use sret on LP64") }
	if !arm32_big { return fail("managed-slice (12B > 4) must use sret on arm32") }
	if !lp64_big { return fail("managed-slice (24B > 16) must use sret on LP64") }
	var pass testing.TestResult
	return pass
}

// A named distinct scalar (`type F float32`, `type Celsius int8`)
// reaches codegen as a TYP_NAMED carrying its name; llvmType / typeBits
// / isUnsigned must peel to the underlying so it lowers with the right
// LLVM type, width, and signedness — not the int fallback (the named-
// float mis-lowering) or the unsigned-by-default a bare TYP_NAMED reads.
func TestLlvmTypeNamedScalarPeels() testing.TestResult {
	var nf @types.Type = types.MakeNamedType("F32")
	nf.Underlying = types.TypFloat32()
	if !charsEqual(llvmType(nf), "float") {
		return fail("named float32 must lower to LLVM `float`")
	}
	if typeBits(nf) != 32 {
		return fail("named float32 typeBits must be 32")
	}
	var ni @types.Type = types.MakeNamedType("Celsius")
	ni.Underlying = types.TypInt8()
	if !charsEqual(llvmType(ni), "i8") {
		return fail("named int8 must lower to LLVM `i8`")
	}
	if typeBits(ni) != 8 {
		return fail("named int8 typeBits must be 8")
	}
	if isUnsigned(ni) {
		return fail("named int8 must read as signed")
	}
	var nu @types.Type = types.MakeNamedType("Byte")
	nu.Underlying = types.TypUint8()
	if !isUnsigned(nu) {
		return fail("named uint8 must read as unsigned")
	}
	var pass testing.TestResult
	return pass
}

// A struct reachable ONLY through a package-level global (no function
// structShapesMatch backs addStructDef's symbol-collision guard: it must
// accept two structs with the SAME LLVM body (a legitimate re-discovery
// that dedups) and reject any shape difference (a genuine collision that
// aborts) — by field count and by each field's LLVM representation.
func TestStructShapesMatch() testing.TestResult {
	setTarget64()
	var fa @[]@types.Field = make_slice(@types.Field, 2)
	var fa0 @types.Field = make(types.Field)
	fa0.Name = "a"
	fa0.Type = types.TypInt32()
	fa[0] = fa0
	var fa1 @types.Field = make(types.Field)
	fa1.Name = "b"
	fa1.Type = types.TypInt32()
	fa[1] = fa1
	var sa @types.Type = types.MakeStructType("A", fa)
	// Same shape (two i32) under a different name -> match.
	var fb @[]@types.Field = make_slice(@types.Field, 2)
	var fb0 @types.Field = make(types.Field)
	fb0.Name = "x"
	fb0.Type = types.TypInt32()
	fb[0] = fb0
	var fb1 @types.Field = make(types.Field)
	fb1.Name = "y"
	fb1.Type = types.TypInt32()
	fb[1] = fb1
	var sb @types.Type = types.MakeStructType("B", fb)
	if !structShapesMatch(sa, sb) {
		return "two identical-LLVM-body structs must match"
	}
	// Different field count -> mismatch (the reflect.Package-vs-Package case).
	var fc @[]@types.Field = make_slice(@types.Field, 1)
	var fc0 @types.Field = make(types.Field)
	fc0.Name = "a"
	fc0.Type = types.TypInt32()
	fc[0] = fc0
	var sc @types.Type = types.MakeStructType("C", fc)
	if structShapesMatch(sa, sc) {
		return "different field counts must NOT match"
	}
	// Same count, different field LLVM type -> mismatch.
	var fd @[]@types.Field = make_slice(@types.Field, 2)
	var fd0 @types.Field = make(types.Field)
	fd0.Name = "a"
	fd0.Type = types.TypInt32()
	fd[0] = fd0
	var fd1 @types.Field = make(types.Field)
	fd1.Name = "b"
	fd1.Type = types.TypBool()
	fd[1] = fd1
	var sd @types.Type = types.MakeStructType("D", fd)
	if structShapesMatch(sa, sd) {
		return "differing field types must NOT match"
	}
	return ""
}

// references it) must still get its `%bn_main__Pt = type {…}` def emitted:
// collectStructTypes scans m.Globals, not just m.Funcs, and the struct-def
// emission precedes the `@g = global %bn_main__Pt` that needs it.  Without
// the global scan clang reports `use of undefined type`.
func TestStructTypeDiscoveredViaGlobal() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"type Pt struct { x int; y int }\n"
		"var g Pt\n"
		"func main() {}\n")
	if !contains(out, "%bn_main__Pt = type") {
		return fail("struct reachable only via a global must still be declared")
	}
	if !contains(out, "@bn_main__g = global %bn_main__Pt") {
		return fail("global must be typed as the discovered struct")
	}
	return ""
}

// An array-of-struct global exercises discoverStructFromType's TYP_ARRAY
// arm: the element struct must be discovered through the global, or the
// `[2 x %bn_main__Pt]` slot type references an undefined type.
func TestArrayOfStructTypeDiscoveredViaGlobal() testing.TestResult {
	var out @[]char = compileToLLVM(
		"package \"main\"\n"
		"type Pt struct { x int; y int }\n"
		"var g [2]Pt\n"
		"func main() {}\n")
	if !contains(out, "%bn_main__Pt = type") {
		return fail("array-of-struct global must declare the element struct")
	}
	if !contains(out, "@bn_main__g = global [2 x %bn_main__Pt]") {
		return fail("global must be typed as the array of the discovered struct")
	}
	return ""
}

// A named-over-struct global exercises discoverStructFromType's TYP_NAMED
// arm: the transparent name wrapper peels to the underlying struct, which
// must be declared (llvmType peels the name so the global's slot type is
// the underlying `%bn_main__Pt`; without the named-arm recursion that type
// is never emitted, and `%bn_main__Pt` is undefined).  Built by direct
// module construction with the underlying set explicitly — the minimal
// source pipeline does not resolve a named-over-struct's underlying the
// way the full loader-driven compiler does, so spelling it in source would
// not reach this arm.
func TestNamedStructTypeDiscoveredViaGlobal() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var st @types.Type = types.MakeStructType("Pt",
		fieldsTwo(types.TypInt(), "x", types.TypInt(), "y"))
	var named @types.Type = types.MakeNamedType("Q")
	named.Underlying = st
	var g @ir.Global = make(ir.Global)
	g.Name = "g"
	g.Typ = named
	m.AddGlobal(g)
	var out @[]char = EmitModule(m)
	if !contains(out, "%bn_main__Pt = type") {
		return fail("named-over-struct global must declare the underlying struct (TYP_NAMED arm)")
	}
	if !contains(out, "@bn_main__g = global %bn_main__Pt") {
		return fail("named-over-struct global must be typed as the underlying struct")
	}
	return ""
}
