package "pkg/binate/codegen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"

// ============================================================
// String helpers
// ============================================================

// emitRef appends %v<id> — using "v" prefix makes these named values
// so LLVM doesn't require sequential numbering.
func emitRef(dst buf.CharBuf, id int) buf.CharBuf {
	dst = dst.WriteStr("%v")
	dst = dst.WriteInt(id)
	return dst
}

// emitPtrRef emits a pointer reference — @name for globals, %vN for locals.
// IsGlobalRef (set by lookupVar's global-fallback path) is the
// definitive marker; ID==-1 alone would not distinguish a local
// alloca whose variable name happens to collide with a global.
func emitPtrRef(dst buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if instr.IsGlobalRef {
		dst = dst.WriteByte('@')
		dst = writeBuf(dst, mangle.GlobalName(modulePkgName,instr.StrVal))
		return dst
	}
	return emitRef(dst, instr.ID)
}

// emitValRef emits an instruction reference in a VALUE-operand position
// (a store value, return value, call argument, comparison operand, …).
// Identical to emitRef for ordinary instructions, but renders the
// IsGlobalRef pseudo — a global's address used as an rvalue, e.g.
// `var p *int = &G`, `f(&G)`, `return &G` — as `@<mangled>` rather than
// the nonexistent `%v-1` (the pseudo has ID -1 and no SSA definition).
// The address symbol `@<mangled>` is a valid LLVM value operand under
// opaque pointers, so no materialization instruction is needed.  Mirrors
// emitPtrRef, which handles the same pseudo in address-operand positions
// (load/store target, GEP base); the bytecode VM materializes it
// uniformly via a per-use LOAD_IMM (see vm/lower_func.bn).
func emitValRef(dst buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	return emitPtrRef(dst, instr)
}

// normalizeFloatLiteral produces an LLVM-acceptable decimal float
// constant from a Binate source literal. LLVM requires a decimal point
// with digits on either side (e.g. "1.0", not "1."; "0.5", not ".5");
// an exponent is fine but must follow a complete mantissa. This
// helper does the minimum text massage needed:
//   - ".5" / ".5e1" → "0.5" / "0.5e1"
//   - "1." / "1.e5" → "1.0" / "1.0e5"
//   - "1e5"         → "1.0e5"
//   - "3.14", "2.5e-3" → unchanged
func normalizeFloatLiteral(text *[]readonly char) buf.CharBuf {
	var out buf.CharBuf = buf.New()
	var n int = len(text)
	if n == 0 {
		out = out.WriteStr("0.0")
		return out
	}
	// Find the exponent marker, if any.
	var epos int = -1
	for i := 0; i < n; i++ {
		if text[i] == 'e' || text[i] == 'E' {
			epos = i
			break
		}
	}
	var mantEnd int = n
	if epos >= 0 { mantEnd = epos }

	// Prefix leading '.' with '0'.
	var start int = 0
	if mantEnd > 0 && text[0] == '.' {
		out = out.WriteByte('0')
	}
	// Find the decimal point within the mantissa.
	var dotPos int = -1
	for i := start; i < mantEnd; i++ {
		if text[i] == '.' {
			dotPos = i
			break
		}
	}
	// Copy the mantissa.
	for i := start; i < mantEnd; i++ {
		out = out.WriteByte(text[i])
	}
	// If there was no decimal point, add ".0". If the point was at the
	// end (or followed by the exponent with no digits), add "0".
	if dotPos < 0 {
		out = out.WriteStr(".0")
	} else if dotPos == mantEnd - 1 {
		out = out.WriteByte('0')
	}
	// Copy exponent verbatim.
	for i := mantEnd; i < n; i++ {
		out = out.WriteByte(text[i])
	}
	return out
}

// stripQuotes removes surrounding double quotes from a string if present.
func stripQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s)-1]
	}
	return s
}

// charsEqual compares two char slices for equality.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// llvmTypeBits returns the actual LLVM bit width of the value produced by an instruction.
func llvmTypeBits(instr @ir.Instr) int {
	return typeBits(instr.Typ)
}

// lastRawSeq tracks the most recent managed-to-raw conversion sequence number,
// so emitSliceRef can reference it.
var lastRawSeq int

// emitSliceRef emits a %BnSlice reference, using the last managed-to-raw temp if needed.
func emitSliceRef(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_MANAGED_SLICE {
		out = out.WriteStr("%BnSlice %raw.")
		out = out.WriteInt(lastRawSeq)
	} else {
		out = out.WriteStr("%BnSlice ")
		out = emitRef(out, instr.ID)
	}
	return out
}

// emitManagedToRaw extracts {data, len} from a %BnManagedSlice into a %BnSlice temp.
func emitManagedToRaw(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if instr.Typ == nil || instr.Typ.Kind != types.TYP_MANAGED_SLICE {
		return out
	}
	// Use tmpSeq for unique names — the same managed slice may be
	// converted multiple times (e.g., slice_len + slice_get on same slice).
	var seq int = tmpSeq
	tmpSeq++
	lastRawSeq = seq
	out = out.WriteStr("%raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".d = extractvalue %BnManagedSlice ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(", 0\n  ")
	out = out.WriteStr("%raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".l = extractvalue %BnManagedSlice ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".0 = insertvalue %BnSlice undef, i8* %raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".d, 0\n  ")
	out = out.WriteStr("%raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(" = insertvalue %BnSlice %raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".0, ")
	out = out.WriteStr(intLL())
	out = out.WriteStr(" %raw.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".l, 1\n  ")
	return out
}

// typeSizeBytes returns the byte size of a type (delegates to types.SizeOf).
func typeSizeBytes(t @types.Type) int {
	return t.SizeOf()
}

// llvmTypeForBits returns the LLVM integer type string for a given bit width.
func llvmTypeForBits(bits int) @[]char {
	if bits == 1 { return "i1" }
	if bits == 8 { return "i8" }
	if bits == 16 { return "i16" }
	if bits == 32 { return "i32" }
	return "i64"
}

// intLL returns the LLVM integer type string for the Binate `int`
// type at the current target — "i64" under LP64 (host), "i32" under
// --target arm32-linux.  Used pervasively in emitted IR: slice
// length fields, runtime function signatures, managed-allocation
// header words, pointer-sized integer conversions, etc.  On 64-bit
// targets the output matches the previous hardcoded "i64"
// literals, so there is no behavior change on host builds.
func intLL() @[]char {
	return llvmTypeForBits(types.GetTarget().IntSize * 8)
}

// managedHeaderBytes returns the size of the managed-allocation
// header in bytes (refcount + free_fn slot).  16 on 64-bit, 8 on
// 32-bit.  Used for the negative byte offset that walks back from
// a payload pointer to the header in emit_refcount.bn.
func managedHeaderBytes() int {
	return 2 * types.GetTarget().IntSize
}

// elemSizeOf returns byte size of a type for slice element sizing
func elemSizeOf(t @types.Type) int {
	return t.SizeOf()
}

// structLLVMIndex maps a Binate struct field index to the LLVM field index
// in the packed struct type, accounting for inserted padding fields.
func structLLVMIndex(t @types.Type, idx int) int {
	var layout @[]types.FieldLayout = t.StructLayout()
	if len(layout) == 0 { return idx }
	var llvmIdx int = 0
	for i := 0; i <= idx && i < len(layout); i++ {
		if layout[i].PaddingBefore > 0 { llvmIdx++ }
		if i == idx { return llvmIdx }
		llvmIdx++
	}
	return llvmIdx
}

// isCharElem checks if a SLICE_GET instruction is for char/byte elements
func isCharElem(instr @ir.Instr) bool {
	// Check the element type from TypeArg or result type
	if instr.TypeArg != nil && instr.TypeArg.Width == 8 {
		return true
	}
	// Check from the slice operand's type
	if len(instr.Args) > 0 {
		return isCharElemFromSlice(instr.Args[0])
	}
	return false
}

// isCharElemFromSlice checks if a slice instruction has 8-bit (char/byte) elements.
func isCharElemFromSlice(sliceInstr @ir.Instr) bool {
	if sliceInstr.Typ != nil && sliceInstr.Typ.Elem != nil && sliceInstr.Typ.Elem.Width == 8 {
		return true
	}
	return false
}

// isStructElem checks if an instruction's element type is a struct or slice aggregate.
func isStructElem(instr @ir.Instr) bool {
	if instr.Typ != nil && instr.Typ.Elem != nil {
		var k int = instr.Typ.Elem.Kind
		if k == types.TYP_STRUCT || k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
			return true
		}
	}
	return false
}

// isStructElemFromSlice checks if a slice instruction has struct/slice aggregate elements.
func isStructElemFromSlice(sliceInstr @ir.Instr) bool {
	if sliceInstr.Typ != nil && sliceInstr.Typ.Elem != nil {
		var k int = sliceInstr.Typ.Elem.Kind
		if k == types.TYP_STRUCT || k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
			return true
		}
	}
	return false
}

// isByvalParam reports whether an aggregate-typed parameter should be
// passed via `ptr byval(<T>) align 8` rather than as a struct value.
//
// Threshold = 16 bytes — same as SysV-AMD64's AggregateInRegMax /
// MEMORY-classification cutoff and AAPCS64's >16-byte indirect
// threshold.  Aggregates at or below 16 B fit in (up to) 2 registers
// on both target ABIs; LLVM's IR-level struct-value lowering covers
// that case fine.  Aggregates above 16 B trigger ABI divergence
// between LLVM's IR-level "spread" emission and the textbook
// per-target ABI; emitting `byval` opts into the textbook lowering
// on both arches.
//
// See explorations/plan-codegen-byval.md for the empirical evidence
// (clang's emission for the same struct shapes) that picked this
// threshold.
func isByvalParam(t @types.Type) bool {
	if t == nil { return false }
	// Mirror pkg/binate/native/common.IsAggregateTyp without taking a dep on it
	// (codegen is a sibling of native; both depend on pkg/ir and pkg/types).
	var k int = t.Kind
	if k != types.TYP_STRUCT &&
			k != types.TYP_ARRAY &&
			k != types.TYP_SLICE &&
			k != types.TYP_MANAGED_SLICE &&
			k != types.TYP_FUNC_VALUE &&
			k != types.TYP_MANAGED_FUNC_VALUE &&
			k != types.TYP_INTERFACE_VALUE &&
			k != types.TYP_INTERFACE_VALUE_MANAGED {
		return false
	}
	return t.SizeOf() > 16
}

// writeParamTypeLLVM emits the LLVM IR type for a function parameter.
// For aggregates that meet isByvalParam's threshold, this is
// `ptr byval(<T>) align 8` (LLVM lowers to the target's textbook
// indirect convention); otherwise the bare LLVM type.
//
// The corresponding call-site emitters (in emit_call.bn /
// emit_call_handle.bn / emit_call_indirect.bn / emit_impls.bn) use
// writeByvalArgLLVM to emit the matching argument shape.
func writeParamTypeLLVM(out buf.CharBuf, t @types.Type) buf.CharBuf {
	if isByvalParam(t) {
		// Use a plain `ptr` (no `byval` attribute) so LLVM lowers
		// the param as a regular pointer-in-register on both
		// targets.  LLVM's `byval` attribute lowers DIFFERENTLY
		// per arch: on x86_64 it lays the struct on caller's
		// outgoing stack (`movups` copies into rsp+0); on
		// AArch64 it ALSO lays the struct on stack via the
		// AAPCS-byval path (not the "pointer in next X reg"
		// that clang picks for plain `ptr` at the frontend).
		// Emitting plain `ptr` everywhere keeps the lowering
		// uniform — both arches pass the pointer in the next
		// free GP arg reg, matching the native backends'
		// IndirectLargeAggregates code path.  Caller is
		// responsible for the alloca + memcpy at the call site
		// (handled by writeByvalArgPreamble).
		return out.WriteStr("ptr")
	}
	return out.WriteStr(llvmType(t))
}

// writeByvalArgPreamble emits the `store` that fills a byval
// argument's spill slot, BEFORE the call line.  Call sites pass
// through this in a pre-emit loop (same shape as the existing
// width-cast pre-emit loop in emitCall).  The matching `alloca` for
// the slot is emitted in the function ENTRY block by
// emitByvalAllocDecls (hoisted by emitFuncDbg's pre-pass, like
// OP_ALLOC) — NOT at the call site.
//
// Hoisting the alloca matters because a call passing a byval arg
// from inside a loop body would otherwise allocate a fresh slot on
// every iteration: LLVM allocas in non-entry blocks aren't freed
// until function return, so the slots accumulate and bottom the
// host stack.  This bottomed the bni VM's host stack under the
// `-int` unit-test modes (execLoop passes a 48-byte BCInstr by
// value to ~13 helper calls per iteration).  See
// explorations/plan-codegen-byval-spill-hoist.md.
//
// LLVM `byval` semantics: caller has a memory location holding the
// struct value; pass its pointer as the arg.  Some call-site arg
// instructions in binate IR already have a backing alloca (the
// managed-copy pattern: alloca + memcpy + load), but others don't
// (sret-returning callees produce the struct value via a load
// from %vN.sret, which is an LLVM-only name with no IR-level
// Instr).  Always emitting a fresh store into the slot covers every
// case uniformly.  At -O2+ LLVM elides the redundant copy when the
// source is already a memory location.
//
// Slot names `%v<callID>.bv<i>` are a pure function of
// (instr.ID, arg index), so the entry-block alloca and this
// call-site store agree on the name without any extra plumbing.
func writeByvalArgPreamble(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	for i := 0; i < len(instr.Args); i++ {
		var arg @ir.Instr = instr.Args[i]
		if !isByvalParam(arg.Typ) { continue }
		out = out.WriteStr("store ")
		out = out.WriteStr(llvmType(arg.Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, arg.ID)
		out = out.WriteStr(", ptr %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bv")
		out = out.WriteInt(i)
		out = out.WriteStr("\n  ")
	}
	return out
}

// emitByvalAllocDecls emits ONLY the `alloca` line for each
// byval-eligible arg of a call instruction, for placement in the
// function entry block (called from emitFuncDbg's alloca-hoisting
// pre-pass alongside emitAllocDecl / emitSretAllocDecl).  The
// matching `store` into the slot stays at the call site
// (writeByvalArgPreamble).  Slot names `%v<callID>.bv<i>` match
// writeByvalArgPreamble exactly — both derive the name from
// (instr.ID, arg index) — so a single entry-block pre-pass and the
// call-site store agree without extra plumbing.  Returns out
// unchanged if the call has no byval args.
func emitByvalAllocDecls(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	for i := 0; i < len(instr.Args); i++ {
		var arg @ir.Instr = instr.Args[i]
		if !isByvalParam(arg.Typ) { continue }
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bv")
		out = out.WriteInt(i)
		out = out.WriteStr(" = alloca ")
		out = out.WriteStr(llvmType(arg.Typ))
		out = out.WriteByte('\n')
	}
	return out
}

// writeByvalArgLLVM emits one call-site argument for instr.Args[i].
// Handles the byval branch (`ptr byval(<T>) align 8 %v<callID>.bv<i>`)
// and the regular branch (`<T> <ref>` with optional width-cast naming),
// both factored out so emit_call / emit_call_handle / emit_call_indirect /
// emit_impls share the same arg-emission code.
//
// The byval-pointer reference always points at the
// writeByvalArgPreamble-allocated `%v<callID>.bv<i>` slot, so this
// function relies on the caller having emitted that preamble.
func writeByvalArgLLVM(out buf.CharBuf, instr @ir.Instr, i int) buf.CharBuf {
	var arg @ir.Instr = instr.Args[i]
	if isByvalParam(arg.Typ) {
		// Plain `ptr` — see writeParamTypeLLVM for why we don't
		// emit `byval` here even though the semantics are
		// byval-style (caller's alloca + memcpy is in the
		// preamble).
		out = out.WriteStr("ptr %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bv")
		out = out.WriteInt(i)
		return out
	}
	var argBits int = llvmTypeBits(arg)
	var declBits int = typeBits(arg.Typ)
	var targetBits int = declBits
	var argTyp @[]char = llvmType(arg.Typ)
	if targetBits != declBits {
		argTyp = llvmTypeForBits(targetBits)
	}
	out = out.WriteStr(argTyp)
	out = out.WriteByte(' ')
	if argBits != targetBits && argBits > 0 && targetBits > 0 {
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a")
		out = out.WriteInt(i)
	} else {
		out = emitValRef(out, arg)
	}
	return out
}
