package "pkg/binate/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// setTarget64 pins types' live target to a 64-bit configuration.
// pkg/binate/codegen tests emit LLVM IR strings that pin LP64-specific
// shapes (i64 for `int`, 16-byte slices, etc.); the lazy default
// would otherwise reflect the host on a 32-bit-host test runner.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// setTarget32 pins an ILP32 configuration (the arm32 targets) so a test can
// assert the 32-bit emit shapes (`i32` ints, 4-byte align).  A test that uses
// it should restore LP64 (setTarget64) before returning, since SetTarget is
// global and the other codegen tests assume LP64.
func setTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
}

// setTargetArm32 pins the REAL AAPCS32 arm32 configuration: ILP32 (PointerSize /
// IntSize 4) but MaxAlign=8 — unlike setTarget32's MaxAlign=4, an int64 / float64
// is 8-ALIGNED here, so an 8-aligned aggregate exercises the AAPCS §6.5 C.3
// even-register-pair coercion.  Use this (not setTarget32) whenever a test depends
// on an aggregate's 8-byte alignment.  Restore LP64 (setTarget64) before returning.
func setTargetArm32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// Tests for llvmTypeBits, typeSizeBytes, elemSizeOf, charsEqual, etc.

func TestCharsEqual() testing.TestResult {
	if !charsEqual("hello", "hello") { return fail("same strings") }
	if charsEqual("hello", "world") { return fail("different strings") }
	if charsEqual("abc", "ab") { return fail("different lengths") }
	var pass testing.TestResult
	return pass
}

func TestTypeSizeBytes() testing.TestResult {
	if typeSizeBytes(types.TypInt()) != 8 { return fail("int should be 8 bytes") }
	if typeSizeBytes(types.TypBool()) != 1 { return fail("bool should be 1 byte") }
	if typeSizeBytes(types.TypInt8()) != 1 { return fail("int8 should be 1 byte") }
	var pass testing.TestResult
	return pass
}

func TestElemSizeOf() testing.TestResult {
	// elemSizeOf returns SizeOf(t).  Use fixed-width types so the
	// assertion doesn't depend on TypInt's locked singleton state
	// (which varies with whether any earlier test in this package
	// called setTarget64 before ensureInit fired).
	if elemSizeOf(types.TypInt64()) != 8 { return fail("int64 should be 8") }
	if elemSizeOf(types.TypUint8()) != 1 { return fail("uint8 should be 1") }
	var pass testing.TestResult
	return pass
}

func TestStripQuotes() testing.TestResult {
	var r *[]readonly char = stripQuotes("\"hello\"")
	if !seq(r, "hello") { return fail("expected hello") }
	var pass testing.TestResult
	return pass
}

func TestStripQuotesNoQuotes() testing.TestResult {
	var r *[]readonly char = stripQuotes("hello")
	if !seq(r, "hello") { return fail("expected hello unchanged") }
	var pass testing.TestResult
	return pass
}

// normalizeFloatLiteral writes a literal's text as an LLVM decimal float, keeping a
// leading sign (a negated constant's text) — "-.5" is "-0.5", which LLVM accepts.
func TestNormalizeFloatLiteral() testing.TestResult {
	var ins @[]*[]readonly char = @[]*[]readonly char{".5", "1.", "1e5", "3.14", "-.5", "-.5e1", "-1.",
			"-0.0", "-.0"}
	var outs @[]*[]readonly char = @[]*[]readonly char{"0.5", "1.0", "1.0e5", "3.14", "-0.5", "-0.5e1",
			"-1.0", "-0.0", "-0.0"}
	for i := 0; i < len(ins); i++ {
		if !charsEqual(normalizeFloatLiteral(ins[i]), outs[i]) { return fail("a literal is normalized") }
	}
	return ""
}
