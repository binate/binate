package "pkg/binate/codegen"

import "pkg/builtins/testing"

// Tests for the value-instruction emitters in emit_value.bn (return / extract /
// managed-to-raw / make-slice / box).  Shared helpers (compileToLLVM, contains,
// fail) live in emit_helpers_test.bn — same package, same test build.

func TestEmitMultiReturn() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func f() (int, int) { return 1, 2 }\n"
			"func main() { a, b := f() }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "insertvalue") {
		return fail("expected insertvalue for multi-return packing")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitMakeSlice() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var s @[]int = make_slice(int, 5) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "bn_F3_3_pkg8_builtins2_rt1_16_MakeManagedSlice") {
		return fail("expected MakeManagedSlice call")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitBoxInstr() testing.TestResult {
	var src *[]readonly char = "package \"main\"\nfunc main() { var p *int = box(42) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "bn_F3_3_pkg8_builtins2_rt1_3_Box") {
		return fail("expected Box call")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitManagedToRaw() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"func f() *[]int {\n"
			"\tvar s @[]int = make_slice(int, 3)\n"
			"\treturn s\n"
			"}\n"
			"func main() { f() }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue %BnManagedSlice") {
		return fail("expected extractvalue from managed slice")
	}
	var pass testing.TestResult
	return pass
}
