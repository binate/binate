// Package constval evaluates integer and boolean constant expressions exactly
// (spec Ch.6).  An untyped integer constant is exact over the union range
// [-2^63, 2^64-1] (spec §6.4 const.expr.precision, const.expr.bitwise,
// const.expr.shift); an operator on typed constants is evaluated as it is for
// values of that type, so it wraps at the type's width.
//
// Evaluation is a pure function of the AST: the caller supplies what names
// refer to through an Env.  The type checker and IR generation (which folds
// again per generic instantiation, e.g. `sizeof(T)`) both evaluate through
// this package, so they cannot disagree about a constant's value.
package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/types"

// Value is a constant: an integer (N) or, when IsBool, a boolean (B).  Typ is
// its type, nil for an untyped constant.  A typed integer value always lies in
// its type's range.
type Value struct {
	IsBool bool
	N      bignum.Num
	B      bool
	Typ    @types.Type
}

// OK is the status of a successful evaluation.
const OK int = 0

// NOT_CONST is the status of an expression that is not a constant integer or
// boolean expression (or one this package does not fold, e.g. floating point).
const NOT_CONST int = 1

// NOT_KNOWN is the status of an expression that refers to a constant or a
// type layout not known yet (a forward reference during declaration
// collection); evaluating it again later may succeed.
const NOT_KNOWN int = 2

// DEPENDENT is the status of an expression whose value depends on a type
// parameter (`sizeof(T)` in a generic body): it is a constant of each
// instantiation, evaluated there.
const DEPENDENT int = 3

// POISONED is the status of an expression that refers to a constant whose own
// evaluation failed with an error already reported; callers report nothing
// more.
const POISONED int = 4

// ERR_OVERFLOW: an untyped result, or an integer literal, lies outside the
// union range [-2^63, 2^64-1].
const ERR_OVERFLOW int = 5

// ERR_DIV_ZERO: an integer division or remainder by zero.
const ERR_DIV_ZERO int = 6

// ERR_MIN_DIV: a signed division or remainder of the type's most-negative
// value by -1.
const ERR_MIN_DIV int = 7

// ERR_NEG_SHIFT: a negative shift count.
const ERR_NEG_SHIFT int = 8

// ERR_UNSAFE_SHIFT: an unsafe_shl / unsafe_shr of a typed value by a count at
// least the type's width, which is undefined.
const ERR_UNSAFE_SHIFT int = 9

// ERR_CAST_FIT: a `cast` of a constant whose value does not fit the target
// type (spec §8 conv.cast.const-not-laundered).
const ERR_CAST_FIT int = 10

// ERR_OPERAND_FIT: an untyped constant operand does not fit the type it takes
// (its typed peer's, or `int` as a bit_cast operand).
const ERR_OPERAND_FIT int = 11

// Env supplies what an expression refers to:
//   - Const(e) — the value of the constant that e (an identifier or a
//     package-qualified selector) names: OK; NOT_CONST when e does not name an
//     integer or boolean constant; NOT_KNOWN, DEPENDENT, or POISONED.
//   - Type(te) — the type a type expression (a sizeof / alignof operand, or a
//     conversion's target) denotes: OK with a type whose layout is known;
//     NOT_CONST when it does not resolve; NOT_KNOWN when its layout is not
//     known yet; DEPENDENT when it involves a type parameter.
//   - Len(e) — `len(e)`: OK with the typed `int` length when e is an array or
//     a string literal (spec §15 builtin.len); NOT_CONST otherwise; NOT_KNOWN or
//     DEPENDENT as for Type.
//   - Iota() — the current `iota`, and false outside a grouped const.
interface Env {
	Const(e @ast.Expr) (Value, int)
	Type(te @ast.TypeExpr) (@types.Type, int)
	Len(e @ast.Expr) (Value, int)
	Iota() (int, bool)
}

// Eval evaluates the constant expression e.  It returns the value and OK, or
// a non-OK status and the sub-expression it concerns (for an ERR_* status, the
// operation that failed).  The first failing operand, left to right, decides.
func Eval(env *Env, e @ast.Expr) (Value, int, @ast.Expr)

// Operands returns the sub-expressions whose values e's operation takes, in
// order: a unary or binary operator's operands, a cast's argument, or an
// unsafe_shl / unsafe_shr / unsafe_div / unsafe_rem's two arguments (none for
// a literal, a name, sizeof / alignof, or `len`, which the Env answers).
func Operands(e @ast.Expr) @[]@ast.Expr

// Step evaluates e's own operation from the values and statuses of its
// Operands (in order): the first non-OK operand status is the result's, else
// the operation is applied.  Eval is Step applied bottom-up; a caller that
// already holds the operands' values applies Step directly.
func Step(env *Env, e @ast.Expr, vals *[]Value, stats *[]int) (Value, int)

// Binary applies the binary operator op (a token kind: arithmetic, bitwise,
// shift, comparison, `&&` or `||`) to constants a and b.  An untyped operand
// of an operator with a typed operand takes that type and must fit it; a
// shift's result takes its value operand's type, and its count may be of any
// integer type.
func Binary(op int, a Value, b Value) (Value, int)

// Unary applies the unary operator op (`-`, `+`, `~`, or `!`) to a.
func Unary(op int, a Value) (Value, int)

// Shift applies `<<` or `>>` (op) to value a and count k; unchecked selects the
// unsafe_shl / unsafe_shr form, for which a typed value and a count at least
// its width is ERR_UNSAFE_SHIFT rather than an overshift.
func Shift(op int, a Value, k Value, unchecked bool) (Value, int)

// Convert returns integer constant a as a value of the integer type t — a
// `cast` — or ERR_CAST_FIT when a's value does not fit t; NOT_CONST when a is
// not an integer or t is not an integer type.
func Convert(a Value, t @types.Type) (Value, int)

// Reinterpret returns integer constant a's bits as a value of the integer
// type t — a `bit_cast`: a modulo 2^width, read at t's signedness.  An untyped
// a takes `int` first and must fit it (ERR_OPERAND_FIT); NOT_CONST when a is
// not an integer or t is not an integer type.
func Reinterpret(a Value, t @types.Type) (Value, int)

// IntKind returns the width in bits and the signedness of t when its
// underlying type (after named, alias and readonly wrappers) is an integer
// type; ok=false otherwise.
func IntKind(t @types.Type) (int, bool, bool)

// Fits reports whether n lies in the range of the integer type t.
func Fits(n bignum.Num, t @types.Type) bool
