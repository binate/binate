package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The test Env, and helpers that parse an expression, evaluate it, and check
// the result.

// testEnv resolves the integer and bool types by name (`T` is a type
// parameter, `Later` a type not laid out yet), `len` of ARR (an array of 7),
// and a few constants: U8MAX (uint8 255), U64MAX (uint64 2^64-1), S8MIN (int8
// -128), K (untyped 5, carried as an untyped-int type object), B (untyped
// true), LATER (not known yet), DEP (dependent), and POIS (poisoned).
type testEnv struct {
	iotaVal int
	inGroup bool
}

// Const resolves the test constants.
func (t *testEnv) Const(e @ast.Expr) (Value, int) {
	var v Value
	if types.CharEq(e.Name, "U8MAX") {
		return intValue(bignum.FromInt(255), types.TypUint8()), OK
	}
	if types.CharEq(e.Name, "U64MAX") {
		return intValue(bignum.FromUint64(cast(uint64, 0) - 1), types.TypUint64()), OK
	}
	if types.CharEq(e.Name, "S8MIN") {
		return intValue(bignum.FromInt(-128), types.TypInt8()), OK
	}
	if types.CharEq(e.Name, "K") {
		return intValue(bignum.FromInt(5), types.TypUntypedInt()), OK
	}
	if types.CharEq(e.Name, "B") {
		return boolValue(true), OK
	}
	if types.CharEq(e.Name, "LATER") {
		return v, NOT_KNOWN
	}
	if types.CharEq(e.Name, "DEP") {
		return v, DEPENDENT
	}
	if types.CharEq(e.Name, "POIS") {
		return v, POISONED
	}
	return v, NOT_CONST
}

// Type resolves a basic type by name.
func (t *testEnv) Type(te @ast.TypeExpr) (@types.Type, int) {
	var r @types.Type = basicType(te)
	if r != nil {
		return r, OK
	}
	if te != nil && types.CharEq(te.Name, "T") {
		return nil, DEPENDENT
	}
	if te != nil && types.CharEq(te.Name, "Later") {
		return nil, NOT_KNOWN
	}
	return nil, NOT_CONST
}

// basicType returns the integer, bool or float64 type te names, or nil.
func basicType(te @ast.TypeExpr) @types.Type {
	if te == nil || te.Kind != ast.TEXPR_NAMED {
		return nil
	}
	if types.CharEq(te.Name, "int8") { return types.TypInt8() }
	if types.CharEq(te.Name, "int16") { return types.TypInt16() }
	if types.CharEq(te.Name, "int32") { return types.TypInt32() }
	if types.CharEq(te.Name, "int64") { return types.TypInt64() }
	if types.CharEq(te.Name, "uint8") { return types.TypUint8() }
	if types.CharEq(te.Name, "uint16") { return types.TypUint16() }
	if types.CharEq(te.Name, "uint32") { return types.TypUint32() }
	if types.CharEq(te.Name, "uint64") { return types.TypUint64() }
	if types.CharEq(te.Name, "char") { return types.TypChar() }
	if types.CharEq(te.Name, "bool") { return types.TypBool() }
	if types.CharEq(te.Name, "float64") { return types.TypFloat64() }
	return nil
}

// Len is the length of ARR.
func (t *testEnv) Len(e @ast.Expr) (Value, int) {
	if e != nil && types.CharEq(e.Name, "ARR") {
		return intValue(bignum.FromInt(7), types.TypInt()), OK
	}
	var v Value
	return v, NOT_CONST
}

// Iota returns the configured iota.
func (t *testEnv) Iota() (int, bool) {
	return t.iotaVal, t.inGroup
}

impl *testEnv : Env

// fail reports a test failure.
func fail(msg @[]char) testing.TestResult {
	return msg
}

// toBytes copies s for the parser.
func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// parseSrc parses src as an expression.
func parseSrc(src *[]readonly char) @ast.Expr {
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	return p.ParseExpr()
}

// evalIn parses src as an expression and evaluates it in env.
func evalIn(env *testEnv, src *[]readonly char) (Value, int) {
	var e @ast.Expr = parseSrc(src)
	var ep *Env = env
	var v Value
	var st int
	var at @ast.Expr
	v, st, at = Eval(ep, e)
	_ = at
	return v, st
}

// evalSrc evaluates src outside any const group.
func evalSrc(src *[]readonly char) (Value, int) {
	var env testEnv
	return evalIn(&env, src)
}

// sameKind reports whether v's type is untyped (t nil) or an integer type of
// t's width and signedness.
func sameKind(v Value, t @types.Type) bool {
	if t == nil {
		return v.Typ == nil
	}
	var w1 int
	var s1 bool
	var ok1 bool
	w1, s1, ok1 = IntKind(v.Typ)
	var w2 int
	var s2 bool
	var ok2 bool
	w2, s2, ok2 = IntKind(t)
	return ok1 && ok2 && w1 == w2 && s1 == s2
}

// wantNum checks that src evaluates to the integer n of type t (nil: untyped).
func wantNum(src *[]readonly char, n bignum.Num, t @types.Type) testing.TestResult {
	var v Value
	var st int
	v, st = evalSrc(src)
	if st != OK || v.IsBool || !v.N.Equals(n) || !sameKind(v, t) {
		return fail(buf.CopyStr(src))
	}
	return ""
}

// wantInt checks that src evaluates to the integer n of type t (nil: untyped).
func wantInt(src *[]readonly char, n int64, t @types.Type) testing.TestResult {
	return wantNum(src, bignum.FromInt64(n), t)
}

// wantBool checks that src evaluates to the boolean b.
func wantBool(src *[]readonly char, b bool) testing.TestResult {
	var v Value
	var st int
	v, st = evalSrc(src)
	if st != OK || !v.IsBool || v.B != b {
		return fail(buf.CopyStr(src))
	}
	return ""
}

// wantStatus checks that src evaluates with status st.
func wantStatus(src *[]readonly char, st int) testing.TestResult {
	var v Value
	var got int
	v, got = evalSrc(src)
	_ = v
	if got != st {
		return fail(buf.CopyStr(src))
	}
	return ""
}

// also returns prev when it is a failure, else next: a chain of checks
// reports the first that fails.
func also(prev testing.TestResult, next testing.TestResult) testing.TestResult {
	if len(prev) > 0 {
		return prev
	}
	return next
}
