package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/token"
import "pkg/binate/types"

// Evaluation of a constant expression's AST: literals, `iota`, constant names
// (through the Env), the unary and binary operators, and the builtins that
// yield constants — sizeof / alignof, len of an array or string literal, cast /
// unsafe_cast / bit_cast to an integer type, and the constant forms of
// unsafe_shl / unsafe_shr / unsafe_div / unsafe_rem.

// Eval evaluates e, reporting the first failing sub-expression.
func Eval(env *Env, e @ast.Expr) (Value, int, @ast.Expr) {
	var v Value
	if e == nil {
		return v, NOT_CONST, e
	}
	if e.Kind == ast.EXPR_INT_LIT {
		var n bignum.Num
		var ok bool
		n, ok = bignum.ParseLiteral(e.Name)
		if !ok {
			return v, ERR_OVERFLOW, e
		}
		return intValue(n, nil), OK, e
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return intValue(bignum.FromInt(types.ParseCharLit(e.Name)), types.TypChar()), OK, e
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		return boolValue(boolLit(e)), OK, e
	}
	if e.Kind == ast.EXPR_IDENT && types.CharEq(e.Name, "iota") {
		var i int
		var inGroup bool
		i, inGroup = env.Iota()
		if inGroup {
			return intValue(bignum.FromInt(i), nil), OK, e
		}
	}
	var st int
	if e.Kind == ast.EXPR_IDENT || e.Kind == ast.EXPR_SELECTOR {
		v, st = env.Const(e)
		v.Typ = untypedToNil(v.Typ)
		return v, st, e
	}
	var at @ast.Expr
	if e.Kind == ast.EXPR_UNARY {
		var x Value
		x, st, at = Eval(env, e.X)
		if st != OK {
			return x, st, at
		}
		v, st = Unary(e.Op, x)
		return v, st, e
	}
	if e.Kind == ast.EXPR_BINARY {
		var x Value
		x, st, at = Eval(env, e.X)
		if st != OK {
			return x, st, at
		}
		var y Value
		y, st, at = Eval(env, e.Y)
		if st != OK {
			return y, st, at
		}
		v, st = Binary(e.Op, x, y)
		return v, st, e
	}
	if e.Kind == ast.EXPR_BUILTIN {
		return evalBuiltin(env, e)
	}
	return v, NOT_CONST, e
}

// boolLit returns a boolean literal's value, which the parser records either
// as the text "true" / "false" or in BoolVal.
func boolLit(e @ast.Expr) bool {
	if len(e.Name) > 0 {
		return types.CharEq(e.Name, "true")
	}
	return e.BoolVal
}

// evalBuiltin evaluates a builtin call that yields a constant.
func evalBuiltin(env *Env, e @ast.Expr) (Value, int, @ast.Expr) {
	var v Value
	var st int
	var at @ast.Expr
	if isOp(e.Op, token.SIZEOF) || isOp(e.Op, token.ALIGNOF) {
		var t @types.Type
		t, st = env.Type(e.TypeRef)
		if st != OK {
			return v, st, e
		}
		var n int = t.SizeOf()
		if isOp(e.Op, token.ALIGNOF) {
			n = t.AlignOf()
		}
		if n < 0 {
			// types' layout computes sizes in a host int, which a size of 2^31
			// or more overflows on a 32-bit host.
			panic("internal error: sizeof / alignof exceeds the host int range")
		}
		return intValue(bignum.FromInt(n), types.TypUint()), OK, e
	}
	if isOp(e.Op, token.LEN) {
		if len(e.Args) != 1 {
			return v, NOT_CONST, e
		}
		v, st = env.Len(e.Args[0])
		return v, st, e
	}
	if isOp(e.Op, token.CAST) || isOp(e.Op, token.UNSAFE_CAST) || isOp(e.Op, token.BIT_CAST) {
		if len(e.Args) != 1 {
			return v, NOT_CONST, e
		}
		var t @types.Type
		t, st = env.Type(e.TypeRef)
		if st != OK {
			return v, st, e
		}
		if !isInt(t) {
			return v, NOT_CONST, e
		}
		var x Value
		x, st, at = Eval(env, e.Args[0])
		if st != OK {
			return x, st, at
		}
		if x.IsBool {
			return v, NOT_CONST, e
		}
		if isOp(e.Op, token.BIT_CAST) {
			v, st = Reinterpret(x, t)
			return v, st, e
		}
		v, st = Convert(x, t)
		return v, st, e
	}
	var unsafeShl bool = isOp(e.Op, token.UNSAFE_SHL)
	var unsafeShr bool = isOp(e.Op, token.UNSAFE_SHR)
	var unsafeDiv bool = isOp(e.Op, token.UNSAFE_DIV)
	var unsafeRem bool = isOp(e.Op, token.UNSAFE_REM)
	if !unsafeShl && !unsafeShr && !unsafeDiv && !unsafeRem {
		return v, NOT_CONST, e
	}
	if len(e.Args) != 2 {
		return v, NOT_CONST, e
	}
	var x Value
	x, st, at = Eval(env, e.Args[0])
	if st != OK {
		return x, st, at
	}
	var y Value
	y, st, at = Eval(env, e.Args[1])
	if st != OK {
		return y, st, at
	}
	if unsafeShl {
		v, st = Shift(cast(int, token.SHL), x, y, true)
	} else if unsafeShr {
		v, st = Shift(cast(int, token.SHR), x, y, true)
	} else if unsafeDiv {
		v, st = Binary(cast(int, token.SLASH), x, y)
	} else {
		v, st = Binary(cast(int, token.PERCENT), x, y)
	}
	return v, st, e
}
