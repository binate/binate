package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/token"
import "pkg/binate/types"

// Evaluation of a constant expression's AST: literals, `iota`, constant names
// (through the Env), the unary and binary operators, and the builtins that
// yield constants — sizeof / alignof, len of an array or string literal, cast /
// unsafe_cast / bit_cast to an integer type, and the constant forms of
// unsafe_shl / unsafe_shr / unsafe_div / unsafe_rem.  Eval recurses over
// Operands and applies Step at each node; a caller that already holds the
// operands' values (the type checker, which checks bottom-up) applies Step
// directly.

// Eval evaluates e, reporting the first failing sub-expression.
func Eval(env *Env, e @ast.Expr) (Value, int, @ast.Expr) {
	var ops @[]@ast.Expr = Operands(e)
	var vals @[]Value = make_slice(Value, len(ops))
	var stats @[]int = make_slice(int, len(ops))
	for i := 0; i < len(ops); i++ {
		var v Value
		var st int
		var at @ast.Expr
		v, st, at = Eval(env, ops[i])
		if st != OK {
			return v, st, at
		}
		vals[i] = v
		stats[i] = st
	}
	var r Value
	var rst int
	r, rst = Step(env, e, vals, stats)
	return r, rst, e
}

// Operands returns the sub-expressions whose values e's operation takes.
func Operands(e @ast.Expr) @[]@ast.Expr {
	var none @[]@ast.Expr
	if e == nil {
		return none
	}
	if e.Kind == ast.EXPR_UNARY {
		var ops @[]@ast.Expr = make_slice(@ast.Expr, 1)
		ops[0] = e.X
		return ops
	}
	if e.Kind == ast.EXPR_BINARY {
		var ops @[]@ast.Expr = make_slice(@ast.Expr, 2)
		ops[0] = e.X
		ops[1] = e.Y
		return ops
	}
	if e.Kind == ast.EXPR_BUILTIN {
		if isOp(e.Op, token.CAST) || isOp(e.Op, token.UNSAFE_CAST) || isOp(e.Op, token.BIT_CAST) {
			if len(e.Args) != 1 {
				return none
			}
			var ops @[]@ast.Expr = make_slice(@ast.Expr, 1)
			ops[0] = e.Args[0]
			return ops
		}
		if isUnsafeArith(e.Op) && len(e.Args) == 2 {
			var ops @[]@ast.Expr = make_slice(@ast.Expr, 2)
			ops[0] = e.Args[0]
			ops[1] = e.Args[1]
			return ops
		}
	}
	return none
}

// isUnsafeArith reports whether op is unsafe_shl / unsafe_shr / unsafe_div /
// unsafe_rem.
func isUnsafeArith(op int) bool {
	return isOp(op, token.UNSAFE_SHL) || isOp(op, token.UNSAFE_SHR) || isOp(op, token.UNSAFE_DIV) ||
			isOp(op, token.UNSAFE_REM)
}

// Step evaluates e's own operation.
func Step(env *Env, e @ast.Expr, vals *[]Value, stats *[]int) (Value, int) {
	var v Value
	if e == nil {
		return v, NOT_CONST
	}
	for i := 0; i < len(stats); i++ {
		if stats[i] != OK {
			return vals[i], stats[i]
		}
	}
	if e.Kind == ast.EXPR_INT_LIT {
		var n bignum.Num
		var ok bool
		n, ok = bignum.ParseLiteral(e.Name)
		if !ok {
			return v, ERR_OVERFLOW
		}
		return intValue(n, nil), OK
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return intValue(bignum.FromInt(types.ParseCharLit(e.Name)), types.TypChar()), OK
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		return boolValue(boolLit(e)), OK
	}
	if e.Kind == ast.EXPR_IDENT && types.CharEq(e.Name, "iota") {
		var i int
		var inGroup bool
		i, inGroup = env.Iota()
		if inGroup {
			return intValue(bignum.FromInt(i), nil), OK
		}
	}
	var st int
	if e.Kind == ast.EXPR_IDENT || e.Kind == ast.EXPR_SELECTOR {
		v, st = env.Const(e)
		v.Typ = untypedToNil(v.Typ)
		return v, st
	}
	if e.Kind == ast.EXPR_UNARY && len(vals) == 1 {
		return Unary(e.Op, vals[0])
	}
	if e.Kind == ast.EXPR_BINARY && len(vals) == 2 {
		return Binary(e.Op, vals[0], vals[1])
	}
	if e.Kind == ast.EXPR_BUILTIN {
		return stepBuiltin(env, e, vals)
	}
	return v, NOT_CONST
}

// boolLit returns a boolean literal's value, which the parser records either
// as the text "true" / "false" or in BoolVal.
func boolLit(e @ast.Expr) bool {
	if len(e.Name) > 0 {
		return types.CharEq(e.Name, "true")
	}
	return e.BoolVal
}

// stepBuiltin evaluates a builtin call that yields a constant, given its
// operands' values (Operands order).
func stepBuiltin(env *Env, e @ast.Expr, vals *[]Value) (Value, int) {
	var v Value
	var st int
	if isOp(e.Op, token.SIZEOF) || isOp(e.Op, token.ALIGNOF) {
		var t @types.Type
		t, st = env.Type(e.TypeRef)
		if st != OK {
			return v, st
		}
		var n int = t.SizeOf()
		if isOp(e.Op, token.ALIGNOF) {
			n = t.AlignOf()
		}
		if n < 0 {
			// types' layout computes sizes in a host int, which a size of 2^31
			// or more overflows on a 32-bit host.
			panic("internal error: sizeof / alignof exceeds the host int range")
		}
		return intValue(bignum.FromInt(n), types.TypUint()), OK
	}
	if isOp(e.Op, token.LEN) {
		if len(e.Args) != 1 {
			return v, NOT_CONST
		}
		return env.Len(e.Args[0])
	}
	if isOp(e.Op, token.CAST) || isOp(e.Op, token.UNSAFE_CAST) || isOp(e.Op, token.BIT_CAST) {
		if len(vals) != 1 {
			return v, NOT_CONST
		}
		var t @types.Type
		t, st = env.Type(e.TypeRef)
		if st != OK {
			return v, st
		}
		if !isInt(t) || vals[0].IsBool {
			return v, NOT_CONST
		}
		if isOp(e.Op, token.BIT_CAST) {
			return Reinterpret(vals[0], t)
		}
		return Convert(vals[0], t)
	}
	if !isUnsafeArith(e.Op) || len(vals) != 2 {
		return v, NOT_CONST
	}
	if isOp(e.Op, token.UNSAFE_SHL) {
		return Shift(cast(int, token.SHL), vals[0], vals[1], true)
	}
	if isOp(e.Op, token.UNSAFE_SHR) {
		return Shift(cast(int, token.SHR), vals[0], vals[1], true)
	}
	if isOp(e.Op, token.UNSAFE_DIV) {
		return Binary(cast(int, token.SLASH), vals[0], vals[1])
	}
	return Binary(cast(int, token.PERCENT), vals[0], vals[1])
}
