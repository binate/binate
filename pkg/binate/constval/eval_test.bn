package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for Eval: the builtins that yield constants, and names and iota
// resolved through the Env.

// The constant forms of unsafe_shl / unsafe_shr fold like the shifts, except
// that a typed value's overshift is an error.
func TestUnsafeShifts() testing.TestResult {
	var r testing.TestResult = wantInt("unsafe_shl(cast(uint8, 1), 7)", 128, types.TypUint8())
	r = also(r, wantStatus("unsafe_shl(cast(uint8, 1), 8)", ERR_UNSAFE_SHIFT))
	r = also(r, wantStatus("unsafe_shr(-8, 0 - 1)", ERR_NEG_SHIFT))
	r = also(r, wantInt("unsafe_shl(-1, 3)", -8, nil))
	r = also(r, wantInt("unsafe_shr(-16, 2)", -4, nil))
	return also(r, wantStatus("unsafe_shl(1, 64)", ERR_OVERFLOW))
}

// A cast of a constant keeps its value, which must fit; bit_cast reinterprets.
func TestCasts() testing.TestResult {
	var r testing.TestResult = wantInt("cast(int8, cast(uint8, 200) + cast(uint8, 100))", 44,
			types.TypInt8())
	r = also(r, wantStatus("cast(int8, cast(uint8, 200))", ERR_CAST_FIT))
	r = also(r, wantStatus("cast(uint8, 0 - 1)", ERR_CAST_FIT))
	r = also(r, wantInt("bit_cast(uint8, cast(int8, -1))", 255, types.TypUint8()))
	r = also(r, wantInt("bit_cast(int8, cast(uint8, 200))", -56, types.TypInt8()))
	r = also(r,
			wantNum("bit_cast(uint64, 0 - 1)", bignum.FromUint64(cast(uint64, 0) - 1), types.TypUint64()))
	return also(r, wantStatus("cast(float64, 1)", NOT_CONST))
}

// sizeof / alignof are typed uint constants.
func TestSizeof() testing.TestResult {
	var r testing.TestResult = wantInt("sizeof(uint32)", 4, types.TypUint())
	r = also(r, wantInt("alignof(uint16)", 2, types.TypUint()))
	return also(r, wantInt("sizeof(uint32) * 2", 8, types.TypUint()))
}

// Names resolve through the Env: an unknown one is not a constant, a forward
// reference is not known yet, and `iota` is the group index.
func TestNamesAndIota() testing.TestResult {
	var r testing.TestResult = wantStatus("x + 1", NOT_CONST)
	r = also(r, wantStatus("LATER + 1", NOT_KNOWN))
	r = also(r, wantStatus("iota", NOT_CONST))
	var env testEnv
	env.iotaVal = 3
	env.inGroup = true
	var v Value
	var st int
	v, st = evalIn(&env, "1 << iota")
	if st != OK || !v.N.Equals(bignum.FromInt(8)) || v.Typ != nil {
		return fail("1 << iota (iota 3) should be the untyped 8")
	}
	return r
}

// bit_cast of an untyped operand takes `int` first, so a value no `int` holds
// is an error; typed operands reinterpret at 16 and 32 bits.
func TestBitCastWidths() testing.TestResult {
	var r testing.TestResult = wantInt("bit_cast(int16, cast(uint16, 0xFFFF))", -1, types.TypInt16())
	r = also(r, wantInt("bit_cast(uint32, cast(int32, -2))", 4294967294, types.TypUint32()))
	return also(r, wantStatus("bit_cast(uint64, 0xFFFFFFFFFFFFFFFF)", ERR_OPERAND_FIT))
}

// len of an array is a typed int constant.
func TestLen() testing.TestResult {
	var r testing.TestResult = wantInt("len(ARR) * 2", 14, types.TypInt())
	return also(r, wantStatus("len(x)", NOT_CONST))
}

// A dependent, poisoned, or not-yet-known operand gives its status; the first
// failing operand, left to right, decides.
func TestStatuses() testing.TestResult {
	var r testing.TestResult = wantStatus("sizeof(T) * 2", DEPENDENT)
	r = also(r, wantStatus("DEP + 1", DEPENDENT))
	r = also(r, wantStatus("POIS + 1", POISONED))
	r = also(r, wantStatus("sizeof(Later)", NOT_KNOWN))
	r = also(r, wantStatus("x + 1 / 0", NOT_CONST))
	r = also(r, wantStatus("1 / 0 + x", ERR_DIV_ZERO))
	return also(r, wantStatus("LATER + x", NOT_KNOWN))
}

// Step applies one operation to operand values the caller already holds (the
// type checker's bottom-up use); a non-OK operand status is the result's.
func TestStep() testing.TestResult {
	var e @ast.Expr = parseSrc("x + y")
	if len(Operands(e)) != 2 {
		return fail("x + y has two operands")
	}
	var vals @[]Value = make_slice(Value, 2)
	vals[0] = intValue(bignum.FromInt(200), types.TypUint8())
	vals[1] = intValue(bignum.FromInt(100), types.TypUint8())
	var stats @[]int = make_slice(int, 2)
	var env testEnv
	var ep *Env = &env
	var v Value
	var st int
	v, st = Step(ep, e, vals, stats)
	if st != OK || !v.N.Equals(bignum.FromInt(44)) {
		return fail("Step(x + y) with uint8 200 and 100 should be 44")
	}
	stats[1] = POISONED
	v, st = Step(ep, e, vals, stats)
	if st != POISONED {
		return fail("a poisoned operand should poison the result")
	}
	return ""
}
