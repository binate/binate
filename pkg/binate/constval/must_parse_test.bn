package "pkg/binate/constval"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Parsing a test's program: one that does not parse stops the test run.

// stopOnParseErrors stops the test run, naming p's first parse error, when p
// reported one: what the parser recovered is not the program the test means to
// check.  (A test that means to check source that does not parse calls the
// parser itself, and says so.)
func stopOnParseErrors(p @parser.Parser) {
	var errs @[]parser.ParseError = p.Errors()
	if len(errs) > 0 {
		testing.Println("a test's program does not parse:", parser.FormatParseError(errs[0]))
		panic("a test's program does not parse")
	}
}

// mustParseExpr parses p's expression, as at the REPL prompt
// (stopOnParseErrors).
func mustParseExpr(p @parser.Parser) @ast.Expr {
	var r @ast.Expr = p.ParseExpr()
	stopOnParseErrors(p)
	return r
}
