package "pkg/binate/constval"

import "pkg/binate/bignum"
import "pkg/binate/token"
import "pkg/binate/types"

// Operators on constants.  An untyped integer operation is exact over the
// union range (bignum) and reports ERR_OVERFLOW outside it.  An operation at an
// integer type works on the type's two's-complement bit pattern and wraps,
// exactly as it does for values of that type at run time.

// IntKind returns t's integer width and signedness.
func IntKind(t @types.Type) (int, bool, bool) {
	if t == nil {
		return 0, false, false
	}
	var p @types.Type = types.StripWrappers(t)
	if p == nil || p.Kind != types.TYP_INT {
		return 0, false, false
	}
	return p.SizeOf() * 8, p.Signed, true
}

// isInt reports whether t is an integer type.
func isInt(t @types.Type) bool {
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(t)
	_ = w
	_ = s
	return ok
}

// Fits reports whether n lies in t's range.
func Fits(n bignum.Num, t @types.Type) bool {
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(t)
	if !ok {
		return false
	}
	if s {
		return n.FitsSigned(w)
	}
	return n.FitsUnsigned(w)
}

// intValue returns the integer constant n of type t (nil: untyped).
func intValue(n bignum.Num, t @types.Type) Value {
	var v Value
	v.N = n
	v.Typ = t
	return v
}

// boolValue returns the untyped boolean constant b.
func boolValue(b bool) Value {
	var v Value
	v.IsBool = true
	v.B = b
	return v
}

// Convert is `cast(t, a)` of a constant.
func Convert(a Value, t @types.Type) (Value, int) {
	if a.IsBool || !isInt(t) {
		return a, NOT_CONST
	}
	if !Fits(a.N, t) {
		return a, ERR_CAST_FIT
	}
	return intValue(a.N, t), OK
}

// Reinterpret is `bit_cast(t, a)` of a constant: an untyped a takes `int`
// first (a bit_cast operand's default type), then its bits are read at t.
func Reinterpret(a Value, t @types.Type) (Value, int) {
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(t)
	if !ok || a.IsBool {
		return a, NOT_CONST
	}
	if a.Typ == nil && !Fits(a.N, types.TypInt()) {
		return a, ERR_OPERAND_FIT
	}
	return intValue(a.N.Wrap(w, s), t), OK
}

// untypedToNil returns t, or nil when t is an untyped type: a Value's Typ is
// nil for an untyped constant, whatever type object the Env's symbol carries.
func untypedToNil(t @types.Type) @types.Type {
	if t != nil && (t.Kind == types.TYP_UNTYPED_INT || t.Kind == types.TYP_UNTYPED_BOOL) {
		return nil
	}
	return t
}

// operandsAt returns the type an arithmetic, bitwise or comparison operator on
// a and b is evaluated at: the typed operand's (the left one's when both are
// typed; the checker has required them to be the same type), nil when neither
// is typed.  An untyped operand must fit that type.
func operandsAt(a Value, b Value) (@types.Type, int) {
	var t @types.Type = a.Typ
	if t == nil {
		t = b.Typ
	}
	if t == nil {
		return nil, OK
	}
	if !isInt(t) {
		return t, NOT_CONST
	}
	if (a.Typ == nil && !Fits(a.N, t)) || (b.Typ == nil && !Fits(b.N, t)) {
		return t, ERR_OPERAND_FIT
	}
	return t, OK
}

// isOp reports whether op is the token kind k.
func isOp(op int, k token.Type) bool {
	return op == cast(int, k)
}

// Binary applies a binary operator to two constants.
func Binary(op int, a Value, b Value) (Value, int) {
	if isOp(op, token.SHL) || isOp(op, token.SHR) {
		return Shift(op, a, b, false)
	}
	if isOp(op, token.LAND) || isOp(op, token.LOR) {
		if !a.IsBool || !b.IsBool {
			return a, NOT_CONST
		}
		if isOp(op, token.LAND) {
			return boolValue(a.B && b.B), OK
		}
		return boolValue(a.B || b.B), OK
	}
	if isComparison(op) {
		return compare(op, a, b)
	}
	if a.IsBool || b.IsBool {
		return a, NOT_CONST
	}
	var t @types.Type
	var st int
	t, st = operandsAt(a, b)
	if st != OK {
		return a, st
	}
	if t == nil {
		return untypedBinary(op, a.N, b.N)
	}
	return typedBinary(op, a.N, b.N, t)
}

// isComparison reports whether op is ==, !=, <, >, <= or >=.
func isComparison(op int) bool {
	return isOp(op, token.EQ) || isOp(op, token.NEQ) || isOp(op, token.LT) || isOp(op, token.GT) ||
			isOp(op, token.LEQ) || isOp(op, token.GEQ)
}

// compare applies a comparison.  Integer operands are compared by value: at a
// type, both values already lie in its range, so the numeric order is the
// type's order.
func compare(op int, a Value, b Value) (Value, int) {
	if a.IsBool != b.IsBool {
		return a, NOT_CONST
	}
	if a.IsBool {
		if isOp(op, token.EQ) {
			return boolValue(a.B == b.B), OK
		}
		if isOp(op, token.NEQ) {
			return boolValue(a.B != b.B), OK
		}
		return a, NOT_CONST
	}
	var t @types.Type
	var st int
	t, st = operandsAt(a, b)
	_ = t
	if st != OK {
		return a, st
	}
	var c int = a.N.Cmp(b.N)
	if isOp(op, token.EQ) {
		return boolValue(c == 0), OK
	}
	if isOp(op, token.NEQ) {
		return boolValue(c != 0), OK
	}
	if isOp(op, token.LT) {
		return boolValue(c < 0), OK
	}
	if isOp(op, token.GT) {
		return boolValue(c > 0), OK
	}
	if isOp(op, token.LEQ) {
		return boolValue(c <= 0), OK
	}
	return boolValue(c >= 0), OK
}

// untypedBinary applies an arithmetic or bitwise operator exactly.
func untypedBinary(op int, x bignum.Num, y bignum.Num) (Value, int) {
	var r bignum.Num
	var ok bool
	if isOp(op, token.PLUS) {
		r, ok = x.Add(y)
	} else if isOp(op, token.MINUS) {
		r, ok = x.Sub(y)
	} else if isOp(op, token.STAR) {
		r, ok = x.Mul(y)
	} else if isOp(op, token.SLASH) || isOp(op, token.PERCENT) {
		if y.IsZero() {
			return intValue(x, nil), ERR_DIV_ZERO
		}
		if isOp(op, token.SLASH) {
			r, ok = x.Div(y)
		} else {
			r, ok = x.Mod(y)
		}
	} else if isOp(op, token.AMP) {
		r, ok = x.And(y)
	} else if isOp(op, token.PIPE) {
		r, ok = x.Or(y)
	} else if isOp(op, token.CARET) {
		r, ok = x.Xor(y)
	} else {
		return intValue(x, nil), NOT_CONST
	}
	if !ok {
		return intValue(x, nil), ERR_OVERFLOW
	}
	return intValue(r, nil), OK
}

// typedBinary applies an arithmetic or bitwise operator at the integer type t
// (both operands lie in t's range): the result wraps to t's width.
func typedBinary(op int, x bignum.Num, y bignum.Num, t @types.Type) (Value, int) {
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(t)
	if !ok {
		return intValue(x, t), NOT_CONST
	}
	if isOp(op, token.SLASH) || isOp(op, token.PERCENT) {
		return typedDivide(op, x, y, w, s, t)
	}
	var xb uint64 = x.Bits()
	var yb uint64 = y.Bits()
	var r uint64
	if isOp(op, token.PLUS) {
		r = xb + yb
	} else if isOp(op, token.MINUS) {
		r = xb - yb
	} else if isOp(op, token.STAR) {
		r = xb * yb
	} else if isOp(op, token.AMP) {
		r = xb & yb
	} else if isOp(op, token.PIPE) {
		r = xb | yb
	} else if isOp(op, token.CARET) {
		r = xb ^ yb
	} else {
		return intValue(x, t), NOT_CONST
	}
	return intValue(bignum.FromBits(r, w, s), t), OK
}

// typedDivide applies `/` or `%` at a w-bit integer type: truncated toward
// zero, the remainder taking the dividend's sign.  A zero divisor, and a signed
// most-negative dividend with a -1 divisor, are errors (they panic at run time).
func typedDivide(op int, x bignum.Num, y bignum.Num, w int, s bool, t @types.Type) (Value, int) {
	if y.IsZero() {
		return intValue(x, t), ERR_DIV_ZERO
	}
	if s {
		var minW bignum.Num = bignum.FromBits(cast(uint64, 1) << cast(uint64, w - 1), w, true)
		var b int64 = y.ToInt64()
		if b == -1 && x.Equals(minW) {
			return intValue(x, t), ERR_MIN_DIV
		}
		var a int64 = x.ToInt64()
		if isOp(op, token.SLASH) {
			return intValue(bignum.FromInt64(a / b), t), OK
		}
		return intValue(bignum.FromInt64(a % b), t), OK
	}
	var ua uint64 = x.ToUint64()
	var ub uint64 = y.ToUint64()
	if isOp(op, token.SLASH) {
		return intValue(bignum.FromUint64(ua / ub), t), OK
	}
	return intValue(bignum.FromUint64(ua % ub), t), OK
}

// Shift applies a shift to value a and count k.  An untyped value is shifted
// exactly (spec §6.4 const.expr.shift); a typed one at its width, with
// `expr.shift.overshift` for a count at least the width.
func Shift(op int, a Value, k Value, unchecked bool) (Value, int) {
	if a.IsBool || k.IsBool {
		return a, NOT_CONST
	}
	if k.N.IsNegative() {
		return a, ERR_NEG_SHIFT
	}
	if a.Typ == nil {
		var r bignum.Num
		var ok bool
		if isOp(op, token.SHL) {
			r, ok = a.N.Shl(k.N)
		} else {
			r, ok = a.N.Shr(k.N)
		}
		if !ok {
			return a, ERR_OVERFLOW
		}
		return intValue(r, nil), OK
	}
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(a.Typ)
	if !ok {
		return a, NOT_CONST
	}
	var over bool = k.N.Magnitude >= cast(uint64, w)
	if over && unchecked {
		return a, ERR_UNSAFE_SHIFT
	}
	if isOp(op, token.SHL) {
		if over {
			return intValue(bignum.Zero(), a.Typ), OK
		}
		return intValue(bignum.FromBits(a.N.Bits() << k.N.Magnitude, w, s), a.Typ), OK
	}
	if over {
		if a.N.IsNegative() {
			return intValue(bignum.FromInt64(-1), a.Typ), OK
		}
		return intValue(bignum.Zero(), a.Typ), OK
	}
	if s {
		return intValue(bignum.FromInt64(a.N.ToInt64() >> k.N.Magnitude), a.Typ), OK
	}
	return intValue(bignum.FromUint64(a.N.ToUint64() >> k.N.Magnitude), a.Typ), OK
}

// Unary applies a unary operator to a constant.
func Unary(op int, a Value) (Value, int) {
	if isOp(op, token.NOT) {
		if !a.IsBool {
			return a, NOT_CONST
		}
		return boolValue(!a.B), OK
	}
	if a.IsBool {
		return a, NOT_CONST
	}
	if isOp(op, token.PLUS) {
		return a, OK
	}
	if a.Typ == nil {
		var r bignum.Num
		var ok bool
		if isOp(op, token.MINUS) {
			r, ok = a.N.Neg()
		} else if isOp(op, token.TILDE) {
			r, ok = a.N.Not()
		} else {
			return a, NOT_CONST
		}
		if !ok {
			return a, ERR_OVERFLOW
		}
		return intValue(r, nil), OK
	}
	var w int
	var s bool
	var ok bool
	w, s, ok = IntKind(a.Typ)
	if !ok {
		return a, NOT_CONST
	}
	var bits uint64
	if isOp(op, token.MINUS) {
		bits = cast(uint64, 0) - a.N.Bits()
	} else if isOp(op, token.TILDE) {
		bits = ~a.N.Bits()
	} else {
		return a, NOT_CONST
	}
	return intValue(bignum.FromBits(bits, w, s), a.Typ), OK
}
