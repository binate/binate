package "pkg/binate/constval"

import "pkg/binate/bignum"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the operators on constants: typed constants wrap at their type
// (spec §6.4 const.expr.typed), untyped ones are exact (const.expr.bitwise,
// const.expr.shift), and each error kind is reported.  The constants are
// written as source and evaluated, for readability.

// Arithmetic on typed constants wraps at the type, like values of the type.
func TestTypedArithmeticWraps() testing.TestResult {
	var r testing.TestResult = wantInt("cast(uint8, 200) + cast(uint8, 100)", 44, types.TypUint8())
	r = also(r, wantInt("cast(uint8, 1) - cast(uint8, 2)", 255, types.TypUint8()))
	r = also(r, wantInt("cast(int8, 127) + cast(int8, 1)", -128, types.TypInt8()))
	r = also(r, wantInt("cast(uint16, 300) * cast(uint16, 300)", 24464, types.TypUint16()))
	r = also(r, wantInt("U64MAX + cast(uint64, 1)", 0, types.TypUint64()))
	r = also(r,
			wantInt("cast(int64, 0x7FFFFFFFFFFFFFFF) + cast(int64, 1)", -9223372036854775807 - 1,
					types.TypInt64()))
	r = also(r, wantInt("U8MAX + 1", 0, types.TypUint8()))
	return also(r, wantInt("'a' - 'b'", 255, types.TypChar()))
}

// Unary `-` and `~` on a typed constant are taken at its width.
func TestTypedUnary() testing.TestResult {
	var r testing.TestResult = wantInt("~cast(uint8, 1)", 254, types.TypUint8())
	r = also(r, wantInt("-cast(int8, -128)", -128, types.TypInt8()))
	r = also(r, wantInt("-cast(uint8, 1)", 255, types.TypUint8()))
	r = also(r, wantInt("~cast(int8, 1)", -2, types.TypInt8()))
	return also(r, wantInt("~U64MAX", 0, types.TypUint64()))
}

// An untyped operand takes its typed peer's type and must fit it.
func TestUntypedOperandTakesPeerType() testing.TestResult {
	var r testing.TestResult = wantInt("cast(uint8, 1) + 255", 0, types.TypUint8())
	r = also(r, wantStatus("cast(uint8, 1) + 256", ERR_OPERAND_FIT))
	return also(r, wantStatus("cast(uint8, 1) + (0 - 1)", ERR_OPERAND_FIT))
}

// Typed division truncates; a zero divisor and MIN / -1 are errors.
func TestTypedDivision() testing.TestResult {
	var r testing.TestResult = wantInt("cast(int8, -7) / cast(int8, 2)", -3, types.TypInt8())
	r = also(r, wantInt("cast(int8, -7) % cast(int8, 2)", -1, types.TypInt8()))
	r = also(r, wantInt("U64MAX / cast(uint64, 2)", 9223372036854775807, types.TypUint64()))
	r = also(r, wantStatus("cast(uint8, 1) / cast(uint8, 0)", ERR_DIV_ZERO))
	r = also(r, wantStatus("cast(uint8, 1) % cast(uint8, 0)", ERR_DIV_ZERO))
	r = also(r, wantStatus("cast(int8, -128) / cast(int8, -1)", ERR_MIN_DIV))
	r = also(r, wantStatus("S8MIN % cast(int8, -1)", ERR_MIN_DIV))
	r = also(r, wantStatus("cast(int64, -9223372036854775807 - 1) / cast(int64, -1)", ERR_MIN_DIV))
	r = also(r, wantStatus("unsafe_div(cast(int8, 1), cast(int8, 0))", ERR_DIV_ZERO))
	return also(r, wantStatus("7 / 0", ERR_DIV_ZERO))
}

// A typed shift is taken at the value's width, with overshift; the count is
// exact and of any integer type.
func TestTypedShifts() testing.TestResult {
	var r testing.TestResult = wantInt("cast(uint8, 1) << 8", 0, types.TypUint8())
	r = also(r, wantInt("cast(uint8, 1) << 7", 128, types.TypUint8()))
	r = also(r, wantInt("cast(int8, 1) << 7", -128, types.TypInt8()))
	r = also(r, wantInt("cast(int8, -128) >> 7", -1, types.TypInt8()))
	r = also(r, wantInt("cast(int8, -128) >> 100", -1, types.TypInt8()))
	r = also(r, wantInt("cast(uint8, 128) >> 7", 1, types.TypUint8()))
	r = also(r, wantInt("cast(uint8, 1) << U64MAX", 0, types.TypUint8()))
	return also(r, wantStatus("cast(int8, 1) << (0 - 1)", ERR_NEG_SHIFT))
}

// Untyped constants stay exact over the union range.
func TestUntypedExact() testing.TestResult {
	var r testing.TestResult = wantInt("~1", -2, nil)
	r = also(r, wantInt("-2 | 1", -1, nil))
	r = also(r, wantInt("-1 >> 1000", -1, nil))
	r = also(r, wantNum("0xFFFFFFFFFFFFFFFF & ~1", bignum.FromUint64(cast(uint64, 0) - 2), nil))
	r = also(r, wantStatus("1 << 64", ERR_OVERFLOW))
	r = also(r, wantStatus("0xFFFFFFFFFFFFFFFF + 1", ERR_OVERFLOW))
	r = also(r, wantStatus("~0xFFFFFFFFFFFFFFFF", ERR_OVERFLOW))
	return also(r, wantStatus("0x10000000000000000", ERR_OVERFLOW))
}

// Comparisons give booleans: typed operands compare at their type.
func TestComparisonsAndBools() testing.TestResult {
	var r testing.TestResult = wantBool("cast(uint8, 200) + cast(uint8, 100) == 44", true)
	r = also(r, wantBool("~cast(uint64, 5) > 0", true))
	r = also(r, wantBool("~5 > 0", false))
	r = also(r, wantBool("B && !false", true))
	r = also(r, wantBool("cast(int8, -1) < cast(int8, 0) || false", true))
	return also(r, wantStatus("cast(int8, 1) < 256", ERR_OPERAND_FIT))
}

// The 16- and 32-bit types wrap, divide and complement at their own width.
func TestTypedWidths16And32() testing.TestResult {
	var r testing.TestResult = wantInt("cast(int16, 32767) + cast(int16, 1)", -32768, types.TypInt16())
	r = also(r, wantInt("cast(uint16, 0) - cast(uint16, 1)", 65535, types.TypUint16()))
	r = also(r, wantInt("cast(uint32, 0xFFFFFFFF) + cast(uint32, 2)", 1, types.TypUint32()))
	r = also(r, wantInt("cast(uint32, 7) * cast(uint32, 0x80000000)", 2147483648, types.TypUint32()))
	r = also(r, wantInt("~cast(uint32, 0)", 4294967295, types.TypUint32()))
	r = also(r, wantInt("-cast(int32, -2147483648)", -2147483648, types.TypInt32()))
	r = also(r, wantStatus("cast(int32, -2147483648) / cast(int32, -1)", ERR_MIN_DIV))
	r = also(r, wantStatus("cast(int16, -32768) % cast(int16, -1)", ERR_MIN_DIV))
	return also(r, wantStatus("cast(int64, -9223372036854775807 - 1) % cast(int64, -1)", ERR_MIN_DIV))
}

// Shifts at and around each width: the last bit, the width, and past it.
func TestTypedShiftBoundaries() testing.TestResult {
	var r testing.TestResult = wantInt("cast(int64, 1) << 63", -9223372036854775807 - 1,
			types.TypInt64())
	r = also(r, wantInt("cast(int64, 1) << 64", 0, types.TypInt64()))
	r = also(r, wantInt("cast(int16, 1) << 15", -32768, types.TypInt16()))
	r = also(r, wantInt("cast(int16, 1) << 16", 0, types.TypInt16()))
	r = also(r, wantInt("cast(int32, -1) >> 31", -1, types.TypInt32()))
	r = also(r, wantInt("cast(int32, -1) >> 32", -1, types.TypInt32()))
	r = also(r, wantInt("cast(uint32, 0x80000000) >> 31", 1, types.TypUint32()))
	r = also(r, wantInt("cast(uint64, 0x8000000000000000) >> 63", 1, types.TypUint64()))
	r = also(r, wantInt("U64MAX >> 63", 1, types.TypUint64()))
	r = also(r, wantInt("U64MAX >> 64", 0, types.TypUint64()))
	r = also(r, wantStatus("cast(uint8, 1) << cast(int8, -1)", ERR_NEG_SHIFT))
	return also(r, wantStatus("unsafe_shr(cast(int32, -1), 32)", ERR_UNSAFE_SHIFT))
}

// uint64 values of 2^63 and above divide and compare as unsigned.
func TestTypedUint64High() testing.TestResult {
	var r testing.TestResult = wantInt("U64MAX % cast(uint64, 10)", 5, types.TypUint64())
	r = also(r, wantInt("U64MAX / cast(uint64, 0x8000000000000000)", 1, types.TypUint64()))
	r = also(r, wantBool("U64MAX > cast(uint64, 0x8000000000000000)", true))
	return also(r, wantBool("cast(uint64, 0x8000000000000000) < cast(uint64, 1)", false))
}

// An operand whose type is not an integer type makes the expression not a
// constant, not an operand-fit error; an untyped-int type object is untyped.
func TestNonIntegerAndUntypedTypes() testing.TestResult {
	var r testing.TestResult = wantInt("K + 1", 6, nil)
	r = also(r, wantNum("K << 61", bignum.FromUint64(cast(uint64, 5) << 61), nil))
	return also(r, wantStatus("cast(float64, 1) + 1", NOT_CONST))
}
