package "pkg/binate/debug"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func TestSetVerbose() testing.TestResult {
	SetVerbose(false)
	if IsVerbose() { return fail("expected not verbose") }
	SetVerbose(true)
	if !IsVerbose() { return fail("expected verbose") }
	SetVerbose(false)
	return ""
}

func TestLogSilent() testing.TestResult {
	// When verbose is off, Log should be a no-op (no crash)
	SetVerbose(false)
	Log("this should not appear")
	return ""
}
