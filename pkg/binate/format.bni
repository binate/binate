// Package format is the Binate source formatter's printer library: it renders a
// parsed AST back to canonical source text.  cmd/bnfmt drives it; splitting it
// out keeps the printer unit-testable in isolation (as pkg/binate/lint is under
// cmd/bnlint).  It is built up across the printer steps; so far it renders type
// expressions (FormatType) and a file's package clause + import section
// (Format).  Statements, declarations, and general expressions land in later
// steps.
package "pkg/binate/format"

import "pkg/binate/ast"

// FormatType renders a type expression to canonical source text.
func FormatType(te @ast.TypeExpr) @[]readonly char

// FormatExpr renders an expression to canonical source text.  Parentheses are
// re-derived from operator precedence (redundant value parens dropped,
// precedence-required parens inserted).
func FormatExpr(e @ast.Expr) @[]readonly char

// FormatDecl renders a top-level declaration to canonical source text.  A
// function body (a statement block) is not emitted -- that is the
// statement-printer step; a signature-only (.bni) function is complete.
func FormatDecl(d @ast.Decl) @[]readonly char

// Format renders a parsed file back to canonical source text: package clause
// (with annotations), sorted imports, and top-level declarations.  Function
// bodies are not yet emitted, so ordinary .bn files (functions with bodies) do
// not round-trip in full yet; .bni interface files and body-free declarations
// do.
func Format(f @ast.File) @[]readonly char
