package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// An annotation block `#[entry, ...]` prints as a call's arguments do (printArgList):
// its entries are a list between its `[` and its `]`, re-filled onto one line when it
// fits, with a line break kept after a `[` that ends its line or forced by a line
// comment, and wrapped past the width cap, fill style, its continuation lines two tabs
// in -- with the comments in it where a list puts them.  An entry
// prints as the expression it reads as (annotationEntryExpr), so the comments in its
// name and among its arguments go where they go in a call.  The block's `[` and `]`,
// and an entry's `(`, are found in the file's bracket pairs.

// printAnnotationsBefore appends the annotation block annots of a declaration or
// package clause, whose `#` is at hash and whose keyword is at kw, and a newline,
// keeping the comments in the block there and those between it and the keyword: the
// ones on the line of its `]` trail it, and the others go on their own lines below
// it.  When the keyword shares that line, the comments on it are the declaration's
// own (its trailing comment, a long-line marker), so none trails the block.  The
// comments before the block are placed by its position (declStartPos, or the file's
// Pos).
func printAnnotationsBefore(b @strings.Builder, cc @commentCursor, annots @[]@ast.Annotation,
		hash token.Pos, kw token.Pos) {
	if len(annots) == 0 { return }
	writeAnnotationsLine(b, cc, annots, hash, kw)
	emitLeadingComments(b, cc, kw, 0, false)
	b.WriteByte('\n')
}

// printDeclAnnotations is printAnnotationsBefore for declaration d.
func printDeclAnnotations(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	printAnnotationsBefore(b, cc, d.Annotations, d.AnnotPos, d.Pos)
}

// writeAnnotationsLine appends the annotation block annots, whose `#` is at hash,
// and, when the keyword at kw is on a later line than its `]`, the comments after it
// on that line, which its layout leaves room for (trailingWidth); the caller has
// placed those before its `#`.  A block on one line that bears the `// LONG-LINE
// ALLOWED` marker there stays on it.
func writeAnnotationsLine(b @strings.Builder, cc @commentCursor, annots @[]@ast.Annotation,
		hash token.Pos, kw token.Pos) {
	var close token.Pos = annotationClose(hash)
	if close.Line == 0 || close.Line >= kw.Line {
		writeAnnotationBlock(b, annots, hash, 0)
		return
	}
	var marked bool = hash.Line == close.Line && hasLongLineMarker(cc, close.Line, kw)
	var prev bool = setWrapSuppressed(wrapSuppressed || marked)
	writeAnnotationBlock(b, annots, hash, trailingWidth(cc, close, kw))
	_ = setWrapSuppressed(prev)
	emitTrailingCommentBefore(b, cc, close, kw)
}

// annotationClose returns the position of the `]` of the annotation block whose `#`
// is at hash: the close paired with the first opener after it, its `[`.  The zero
// Pos when unknown.
func annotationClose(hash token.Pos) token.Pos {
	var none token.Pos
	if hash.Line == 0 { return none }
	return pairedClose(openAfter(hash))
}

// writeAnnotationBlock appends the annotation block annots, whose `#` is at hash (the
// zero Pos when unknown), followed on its line by tail bytes, with the comments in
// it: those after the `#` against it (writeExprGap), the others where a list puts
// them.  Its `[` opens the list; when the file's bracket pairs are not known (a
// declaration formatted alone, FormatDecl), the list is taken to open on its first
// entry's line.
func writeAnnotationBlock(b @strings.Builder, annots @[]@ast.Annotation, hash token.Pos, tail int) {
	var open token.Pos
	if hash.Line > 0 { open = openAfter(hash) }
	b.WriteByte('#')
	writeExprGap(b, claimGap(hash, open, hash))
	var elems @[]@ast.Expr = make_slice(@ast.Expr, len(annots))
	for i := 0; i < len(annots); i++ { elems[i] = annotationEntryExpr(annots[i]) }
	var openerLine int = open.Line
	if openerLine == 0 { openerLine = exprStartPos(elems[0]).Line }
	printArgList(b, elems, open, openerLine, false, '[', ']', open, true, tail)
}

// annotationEntryExpr returns annotation entry a as the expression it reads as: its
// name -- an identifier, or for a dotted name a chain of selectors, each at its
// segment's position (a.NamePos) -- called with its arguments when it has any, the
// call at its `(`, the first opener after the name.  A name whose segments'
// positions are not known is one identifier at a.Pos, and a call whose `(` is not
// known (no bracket pairs) is at the name's last segment.  An entry with an empty
// argument list (`name()`) prints as its name: its parentheses carry no meaning.
func annotationEntryExpr(a @ast.Annotation) @ast.Expr {
	var x @ast.Expr = nil
	var last token.Pos = a.Pos
	var segs int = 1
	for i := 0; i < len(a.Name); i++ {
		if a.Name[i] == '.' { segs = segs + 1 }
	}
	if len(a.NamePos) != segs {
		x = annotationIdent(a.Name, a.Pos)
	} else {
		var start int = 0
		var k int = 0
		for i := 0; i <= len(a.Name); i++ {
			if i < len(a.Name) && a.Name[i] != '.' { continue }
			last = a.NamePos[k]
			var seg @[]char = buf.CopyStr(a.Name[start:i])
			if x == nil {
				x = annotationIdent(seg, last)
			} else {
				var sel @ast.Expr = make(ast.Expr)
				sel.Kind = ast.EXPR_SELECTOR
				sel.Pos = last
				sel.X = x
				sel.Name = seg
				x = sel
			}
			k = k + 1
			start = i + 1
		}
	}
	if len(a.Args) == 0 { return x }
	var call @ast.Expr = make(ast.Expr)
	call.Kind = ast.EXPR_CALL
	call.Pos = openAfter(last)
	if call.Pos.Line == 0 { call.Pos = last }
	call.X = x
	call.Args = a.Args
	return call
}

// annotationIdent returns an identifier expression named name at pos.
func annotationIdent(name @[]char, pos token.Pos) @ast.Expr {
	var id @ast.Expr = make(ast.Expr)
	id.Kind = ast.EXPR_IDENT
	id.Pos = pos
	id.Name = name
	return id
}
