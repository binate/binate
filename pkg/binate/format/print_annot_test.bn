package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// An annotation block keeps the comments in it where they are -- after the `#`, after
// the `[`, between its entries, in an entry's dotted name and among its arguments,
// before the `]` -- as a call's argument list keeps them, and a comment after a `]`
// on a later line than its last entry's start trails the block.
func TestAnnotationBlockKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"#/* a */ [ // b\n"
			"\tbuild(/* c */ is(os, \"linux\")), /* d */ tool /* e */ . /* f */ lint, // g\n"
			"\tx(1, 2 /* h */) /* i */]\n"
			"func f() {}\n"
			"\n"
			"#[build(os ==\n"
			"\t\"linux\")] // j\n"
			"func g() {}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"#/* a */ [ // b\n"
			"\t\tbuild(/* c */ is(os, \"linux\")), /* d */ tool /* e */./* f */ lint, // g\n"
			"\t\tx(1, 2 /* h */) /* i */]\n"
			"func f() {}\n"
			"\n"
			"#[build(os == \"linux\")] // j\n"
			"func g() {}\n"
	return checkFormatGolden(src, want)
}

// An annotation block lays out as a call's arguments do: one the source wrapped is
// joined when it fits, a `[` that ends its line keeps its line break, one past the
// width cap wraps, and one on a line marked `// LONG-LINE ALLOWED` stays there.  The
// comment after its `]` counts in its line's width.
func TestAnnotationBlockLaysOutAsACallsArguments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\")),\n"
			"\tc_export(\"k\")]\n"
			"func f() {}\n"
			"\n"
			"#[\n"
			"\tbuild(is(os, \"linux\"))]\n"
			"func g() {}\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")), "
			"tool.lint(\"some argument text\")]\n"
			"func h() {}\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")), "
			"tool.lint(\"some argument text\")] // LONG-LINE ALLOWED\n"
			"func k() {}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\")), c_export(\"k\")]\n"
			"func f() {}\n"
			"\n"
			"#[\n"
			"\t\tbuild(is(os, \"linux\"))]\n"
			"func g() {}\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")),\n"
			"\t\ttool.lint(\"some argument text\")]\n"
			"func h() {}\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")), "
			"tool.lint(\"some argument text\")] // LONG-LINE ALLOWED\n"
			"func k() {}\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	var fits *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")), "
			"tool.lint(\"x\")] // why the gate\n"
			"func f() {}\n"
	r = checkFormatGolden(fits, fits)
	if len(r) > 0 { return r }
	var over *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")), "
			"tool.lint(\"x\")] // why the gates\n"
			"func f() {}\n"
	var wrapped *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\") || is(os, \"darwin\") || is(os, \"baremetal\")),\n"
			"\t\ttool.lint(\"x\")] // why the gates\n"
			"func f() {}\n"
	return checkFormatGolden(over, wrapped)
}

// The package clause's annotation block keeps its comments as a declaration's does.
func TestPackageAnnotationKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "#[build(is(os, \"linux\")), /* c */\n"
			"\tfoo] // d\n"
			"package \"p\"\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "#[build(is(os, \"linux\")), /* c */ foo] // d\n"
			"package \"p\"\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// An entry reads as its name -- a chain of selectors at its segments' positions --
// called with its arguments, at its name's last segment when the file's bracket
// pairs are not known; a name whose segments' positions are not known is one
// identifier.
func TestAnnotationEntryExpr() testing.TestResult {
	var a @ast.Annotation = parseDeclSrc("#[tool.lint(x)] func f()").Annotations[0]
	var e @ast.Expr = annotationEntryExpr(a)
	if e.Kind != ast.EXPR_CALL || len(e.Args) != 1 || !samePos(e.Pos, a.NamePos[1]) {
		return "tool.lint(x): a call of one argument, at lint"
	}
	var sel @ast.Expr = e.X
	if sel.Kind != ast.EXPR_SELECTOR || !streq(sel.Name, "lint") || !samePos(sel.Pos, a.NamePos[1]) {
		return "tool.lint(x): its name a selector lint, at lint"
	}
	if sel.X.Kind != ast.EXPR_IDENT || !streq(sel.X.Name, "tool") || !samePos(sel.X.Pos, a.Pos) {
		return "tool.lint(x): the selector's head an identifier tool, at tool"
	}
	var bare @ast.Annotation = make(ast.Annotation)
	*bare = *a
	var none @[]token.Pos
	bare.NamePos = none
	var whole @ast.Expr = annotationEntryExpr(bare).X
	if whole.Kind != ast.EXPR_IDENT || !streq(whole.Name, "tool.lint") || !samePos(whole.Pos, a.Pos) {
		return "tool.lint(x) with no segment positions: its name one identifier, at tool"
	}
	return ""
}

// An empty annotation block (`#[]`), which prints nothing, still holds its lines for its
// declaration: a doc comment above it stays against the declaration (a blank line before
// the block is kept), the comments in it and after it go on lines of their own before
// the keyword (keeping the source's blank lines among them and before the keyword), and
// a comment after its `#` is the declaration's, not the trailing comment of what
// precedes it on its line.
func TestEmptyAnnotationBlockHoldsItsLines() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc f\n"
			"#[]\n"
			"func f() {}\n"
			"\n"
			"// doc g\n"
			"#[ /* c */\n"
			"]\n"
			"var g int\n"
			"\n"
			"// doc h\n"
			"\n"
			"#[]\n"
			"const h = 1\n"
			"\n"
			"func k() {}; #[] /* e */ func m() {}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc f\n"
			"func f() {}\n"
			"\n"
			"// doc g\n"
			"/* c */\n"
			"var g int\n"
			"\n"
			"// doc h\n"
			"\n"
			"const h = 1\n"
			"\n"
			"func k() {}\n"
			"\n"
			"/* e */\n"
			"func m() {}\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	r = checkFormatGolden("#[ /* c */ ] package \"p\"\n\nimport \"a\"; #[] /* d */ func f() {}\n",
			"/* c */\npackage \"p\"\n\nimport \"a\"\n\n/* d */\nfunc f() {}\n")
	if len(r) > 0 { return r }
	var gaps *[]readonly char = "package \"p\"\n"
			"\n"
			"#[]\n"
			"// a\n"
			"\n"
			"// b\n"
			"func f() {}\n"
			"\n"
			"#[] // c\n"
			"\n"
			"func g() {}\n"
	var kept *[]readonly char = "package \"p\"\n"
			"\n"
			"// a\n"
			"\n"
			"// b\n"
			"func f() {}\n"
			"\n"
			"// c\n"
			"\n"
			"func g() {}\n"
	r = checkFormatGolden(gaps, kept)
	if len(r) > 0 { return r }
	// A `#` whose `[` is on a later line: the lines of the `[` and the `]` are the
	// block's, not blank ones, and a blank line before them is kept.
	var late *[]readonly char = "package \"p\"\n"
			"\n"
			"#\n"
			"/* c */\n"
			"[]\n"
			"func f() {}\n"
			"\n"
			"#\n"
			"/* d */\n"
			"\n"
			"[]\n"
			"func g() {}\n"
			"\n"
			"#\n"
			"/* e */\n"
			"[\n"
			"]\n"
			"func h() {}\n"
	var lateWant *[]readonly char = "package \"p\"\n"
			"\n"
			"/* c */\n"
			"func f() {}\n"
			"\n"
			"/* d */\n"
			"\n"
			"func g() {}\n"
			"\n"
			"/* e */\n"
			"func h() {}\n"
	return checkFormatGolden(late, lateWant)
}
