package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printArrayType appends array type te, followed on its last line by tail bytes: `[`,
// its length (printArrayLen), `]`, the comments after it (writeAfterClose) and its
// element type.
func printArrayType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	b.WriteByte('[')
	printArrayLen(b, te, tail)
	b.WriteByte(']')
	writeAfterClose(b, te, pairedClose(te.Pos))
	printTypeTail(b, te.Base, tail)
}

// printArrayLen appends an array type's length: `...` for an inferred length,
// otherwise the dimension expression in canonical source form.  A leaf length
// (`[3]T`, `[N]T`) prints as its raw text; a compound const expression
// (`[N+1]T`, `[cast(int, 5)]T`) is reproduced verbatim by the expression printer
// -- emitting a bare `[]` for a non-leaf dimension would corrupt the type
// (bare `[]T` does not parse — a raw slice is `*[]T`).  The comments after the `[`
// go there, and so do those before the `]`: after `...` a line comment can stand, and
// the `]` goes on at a continuation line; after a length, only block comments on one
// line, which those inside it that nothing prints join (claimAfterExpr).  The length
// goes on at a continuation line when it does not fit on the line with what follows it
// (writeLenGap), tail bytes after the type.
func printArrayLen(b @strings.Builder, te @ast.TypeExpr, tail int) {
	var close token.Pos = pairedClose(te.Pos)
	if te.LenInferred {
		var open @[]@token.Comment
		var shut @[]@token.Comment
		open, shut = splitAfter(claimTypeGap(te, te.Pos, close), te.Pos)
		writeLenGap(b, te, open, tail)
		b.Write("...")
		writeBreakingGap(b, shut)
		return
	}
	if te.Len == nil { return }
	writeLenGap(b, te, claimTypeGap(te, te.Pos, exprStartPos(te.Len)), tail)
	printExpr(b, te.Len)
	_ = writeInlineComments(b, claimAfterExpr(te.Len, false, close, typeGapKey(te)))
}

// writeLenGap writes the comments cs after array type te's `[`, against it, and what
// separates them from its length: a line break to a continuation line, two tabs in from
// the line's, when they need one or the length does not fit on the line (lenMoves), else
// a space after them.  The end of the comments is a chance for te to break
// (noteBreakChance).
func writeLenGap(b @strings.Builder, te @ast.TypeExpr, cs @[]@token.Comment, tail int) {
	var cont int = currentLineIndent(b) + 2
	var brk bool = writeGapComments(b, cs, cont, true)
	noteBreakChance(b)
	if !brk && lenMoves(b, te, len(cs) > 0, cont, tail) { brk = true }
	if brk {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else if len(cs) > 0 {
		b.WriteByte(' ')
	}
}

// lenMoves reports whether array type te's length, after its `[` and the comments after
// it (gapped when there are any), goes on at a continuation line, at column cont (a tab
// counts one), when what follows the `[` up to the element type's first break (typeHead)
// -- the length, the comments before and after the `]` (lenLead), and the element type,
// all of it with tail bytes after it when it cannot break, or up to the end of a line
// comment before that -- does not fit on the line.  A length that cannot break moves
// then; one that can moves as an index's element does: when that fits on the
// continuation line, or does not and its own first line does not fit on this one.  It
// stays with wrapping suppressed, and where the continuation line starts no further left.
func lenMoves(b @strings.Builder, te @ast.TypeExpr, gapped bool, cont int, tail int) bool {
	if wrapSuppressed { return false }
	var here int = lineWidth(b)
	if gapped { here = here + 1 }
	if here <= cont { return false }
	var lead int
	var ends bool
	lead, ends = lenLead(te)
	if !ends { lead = lead + typeHead(te.Base, tail) }
	if here + lead <= MAX_LINE_WIDTH { return false }
	if te.LenInferred || unbreakable(te.Len) || cont + lead <= MAX_LINE_WIDTH { return true }
	return here + firstLineLen(renderAt(te.Len, here, currentLineIndent(b), 0)) > MAX_LINE_WIDTH
}

// lenLead returns the width array type te's length takes on its line with the comments
// before its `]`, the `]` and the comments after it, or, when a comment before the `]`
// or one in the length needs a line break after it, the width up to the end of that
// comment's line, and true.
func lenLead(te @ast.TypeExpr) (int, bool) {
	var close token.Pos = pairedClose(te.Pos)
	if te.LenInferred {
		var shut @[]@token.Comment
		_, shut = splitAfter(claimTypeGap(te, te.Pos, close), te.Pos)
		var w int = 3
		for i := 0; i < len(shut); i++ {
			w = w + 1 + firstLineLen(shut[i].Text)
			if !isBlockComment(shut[i]) || hasNewline(shut[i].Text) { return w, true }
		}
		return w + 1 + afterCloseWidth(te), false
	}
	if te.Len == nil { return 1 + afterCloseWidth(te), false }
	var saved bool = wrapSuppressed
	wrapSuppressed = true
	var s @[]readonly char = renderAt(te.Len, 0, 0, 0)
	wrapSuppressed = saved
	if hasNewline(s) { return firstLineLen(s), true }
	var cs @[]@token.Comment = claimAfterExpr(te.Len, false, close, typeGapKey(te))
	return len(s) + inlineCommentsWidth(cs) + 1 + afterCloseWidth(te), false
}

// afterCloseWidth returns the width the comments after array type te's `]` take
// (writeAfterClose).
func afterCloseWidth(te @ast.TypeExpr) int {
	var cs @[]@token.Comment = claimInlineGap(pairedClose(te.Pos), typeStartPos(te.Base),
			typeGapKey(te))
	if len(cs) == 0 { return 0 }
	return inlineCommentsWidth(cs) + 1
}
