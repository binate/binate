package "pkg/binate/format"

import "pkg/builtins/testing"

// A type assertion's type leaves room for the `)` and what follows it: a generic
// type's arguments wrap for them, as they do for a type one byte longer, rather than
// the value moving to a continuation line of its own.
func TestTypeAssertTypeLeavesRoomForItsClose() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvvvvvvvvvvvvvvvv = yyyyyyyyy.(p.Box[Tttttttttttttttttttttttttttttttttttttttttttttttt"
			"ttt, Uuuuuuuuu])\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvvvvvvvvvvvvvvvv = yyyyyyyyy.(p.Box[Tttttttttttttttttttttttttttttttttttttttttttttttt"
			"ttt,\n"
			"\t\t\tUuuuuuuuu])\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A head leaves room for an asserted type only up to the type's first break, measured
// by width alone (typeShare): measured with the breaks its source has, a type whose
// arguments the first format wrapped was measured shorter by a second format, which then
// wrapped the head; and reserving the whole type kept the head's last argument on its
// line past the cap.
func TestTypeAssertHeadLeavesRoomToTheTypesFirstBreak() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := ffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbb).(p.Box[Ttttttttttttttttttttttttttttttt, Uuuuuuuuuuu])\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := ffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(p.Box[Ttttttttttttttttttttt"
			"tttttttttt,\n"
			"\t\t\t\t\tUuuuuuuuuuu])\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A head leaves room for the comments before a type assertion's `.` and after its `(`,
// which stay on its line with the type's first line, through a line comment there; left
// out, they took the line past the cap once the head reserved only the type's first
// line.
func TestTypeAssertHeadReservesTheCommentsAroundItsParen() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() int {\n"
			"\tg(ffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) /"
			"* cccccccccc */.(p.Box[ddddddddddddd, e]))\n"
			"\tif rrrrrrrrrrrrrrrrrrrrrr(gggggggggggggggggggggggggggggg, hhhhhhhhhhhhhhhhhhhhhhhh)."
			"(/* cc */ *[]p.Vec[www, zzzzzzzzzzzzzzz]) != nil {\n"
			"\t\tz()\n"
			"\t}\n"
			"\tg(aaaaaaaaaa(zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz, ddddddddddddddddddddddddddddddddddddd"
			"ddd).(/* ccccc */ p.Box[p.wwwwwwwwwwwww, a]))\n"
			"\treturn pppppppppppppp(zzzzzzzzzzzzzzzzzzzzzzzz, nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
			"nnnnn).( // lllllllllllllllll\n"
			"\t\t\tp.Box[ddddddd, eeeeeeeeee])\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() int {\n"
			"\tg(ffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) /* cccccccccc */.(p.Box[ddddddddddddd, e]))\n"
			"\tif rrrrrrrrrrrrrrrrrrrrrr(gggggggggggggggggggggggggggggg,\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhhhhh).(/* cc */ *[]p.Vec[www, zzzzzzzzzzzzzzz]) != nil {\n"
			"\t\tz()\n"
			"\t}\n"
			"\tg(aaaaaaaaaa(zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz,\n"
			"\t\t\tdddddddddddddddddddddddddddddddddddddddd).(/* ccccc */ p.Box[p.wwwwwwwwwwwww, a]"
			"))\n"
			"\treturn pppppppppppppp(zzzzzzzzzzzzzzzzzzzzzzzz,\n"
			"\t\t\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn).( // lllllllllllllllll\n"
			"\t\t\t\t\tp.Box[ddddddd, eeeeeeeeee])\n"
			"}\n"
	return checkFormatGolden(src, want)
}
