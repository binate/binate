package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// printBuiltin appends an EXPR_BUILTIN call — `name(...)` where name is the
// builtin keyword (token.TypeName of e.Op).  The argument list is the type
// operand (e.TypeRef, when present) followed by the value operands (e.Args), in
// that order: `make(T)`, `make_slice(T, n)`, `cast(T, e)`, `box(e)`,
// `len(e)`, `same(a, b)`, `sizeof(T)`, `_func_handle(f)`, etc.  __c_call and
// __c_global have a bespoke shape (a string-literal symbol operand) and are
// handled separately.
//
// `tail` is what follows the builtin on its line (a close delimiter, an operator).
//
// A builtin with a TYPE operand (`make`/`make_slice`/`cast`/`bit_cast`/
// `unsafe_cast`/`sizeof`/`alignof`) carries at most ONE value argument, which is
// therefore always the last
// element: it reserves `tail` plus this builtin's own `)` (`1 + tail`) so a
// wrappable trailing argument (a nested binary/call) sub-wraps rather than pushing
// the closing `)` past the cap.  A pure value-argument builtin (`box`/`len`/
// `present`/`same`/`unsafe_index`/`_func_handle`/...) may carry a non-last value
// argument (`same`/`unsafe_index` take two), so its list is fill-wrapped through
// printArgList exactly like printCall -- a non-last wrappable argument then reserves
// its separator and the list breaks between arguments rather than staying flat past
// the cap.
func printBuiltin(b @strings.Builder, e @ast.Expr, tail int) {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL {
		printCCall(b, e)
		return
	}
	if op == token.C_GLOBAL {
		printCGlobal(b, e)
		return
	}
	b.Write(token.TypeName(op))
	if e.TypeRef == nil {
		// No type operand: the head is the builtin keyword (on e.Pos.Line), and the
		// whole argument list wraps like a call's.
		printArgList(b, e.Args, e.Pos.Line, false, '(', ')', tail)
		return
	}
	// Type operand leads, followed by the at-most-one value argument (always last).
	b.WriteByte('(')
	printType(b, e.TypeRef)
	for i := 0; i < len(e.Args); i++ {
		b.Write(", ")
		printExprTail(b, e.Args[i], 1 + tail)
	}
	b.WriteByte(')')
}

// printCCall appends a `__c_call("sym", RetType, args...)` builtin, fill-wrapping
// the argument list when the source wrapped it or the single-line form would
// exceed the cap (mirroring printStrList, with a `__c_call(` head instead of a
// single open delimiter -- without this a long syscall wrapper collapses onto one
// over-cap line).  The symbol is stored quote-stripped in e.Name (re-quoted here);
// a nil TypeRef is the void return, spelled "void"; and the `...` variadic marker
// is reinserted whenever e.CVariadic — before the first variadic arg (at index
// e.CFixedArgs) when trailing args follow, or after the last arg when CFixedArgs ==
// len(Args) (a `...` written with zero trailing varargs).
func printCCall(b @strings.Builder, e @ast.Expr) {
	// The argument list's items -- the quoted symbol, the return type (or "void"),
	// then the value args with `...` before the first variadic one -- each with its
	// source line for the wrap-mode decision.
	var itemsV @vec.Vec[@listItem] = vec.New[@listItem]()
	var sym @strings.Builder = strings.NewBuilder()
	sym.WriteByte('"')
	sym.Write(e.Name)
	sym.WriteByte('"')
	itemsV.Push(textItem(sym.String(), e.Pos.Line))
	if e.TypeRef == nil {
		itemsV.Push(textItem("\"void\"", e.Pos.Line))
	} else {
		itemsV.Push(typeItem(e.TypeRef, false))
	}
	for i := 0; i < len(e.Args); i++ {
		if e.CVariadic && i == e.CFixedArgs {
			itemsV.Push(textItem("...", exprStartPos(e.Args[i]).Line))
		}
		itemsV.Push(exprItem(nil, e.Args[i]))
	}
	// A `...` with ZERO trailing args (CFixedArgs == len(Args)) has no arg to print
	// it before, so the in-loop marker never fired — reinsert it after the last arg
	// so the source round-trips (`__c_call("f", ret, x, ...)` reprints unchanged
	// instead of dropping the marker and silently becoming non-variadic).
	if e.CVariadic && e.CFixedArgs >= len(e.Args) {
		itemsV.Push(textItem("...", e.Pos.Line))
	}

	var items @[]@listItem = itemsV.Items()
	var n int = len(items)
	b.Write("__c_call(")
	if wrapSuppressed {
		printItemsOneLine(b, items, 1)
		b.WriteByte(')')
		return
	}
	var openerAlone bool = items[0].line != e.Pos.Line
	var sourceWrapped bool = openerAlone || items[0].line != items[n - 1].line
	var fits bool = !itemsHaveNewline(items) &&
			lineWidth(b) + itemsOneLineLen(items) + 1 <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		printItemsOneLine(b, items, 1)
	} else {
		// After the first element: a comma, or the `)` of a lone one.
		fillStrs(b, items, currentLineIndent(b) + 2,
				wrapOpenerAlone(b, openerAlone, len(items[0].text), 1), 1)
	}
	b.WriteByte(')')
}

// printCGlobal appends a `__c_global("sym", T)` builtin.  The symbol is stored
// quote-stripped in e.Name (re-quoted here); the type is always a real type in
// e.TypeRef (there is no "void" spelling), and there are no value arguments.
func printCGlobal(b @strings.Builder, e @ast.Expr) {
	b.Write("__c_global(")
	b.WriteByte('"')
	b.Write(e.Name)
	b.WriteByte('"')
	b.Write(", ")
	printType(b, e.TypeRef)
	b.WriteByte(')')
}
