package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printBuiltin appends an EXPR_BUILTIN call — `name(...)` where name is the
// builtin keyword (token.TypeName of e.Op).  The argument list is the type
// operand (e.TypeRef, when present) followed by the value operands (e.Args), in
// that order: `make(T)`, `make_slice(T, n)`, `cast(T, e)`, `box(e)`,
// `len(e)`, `same(a, b)`, `sizeof(T)`, `_func_handle(f)`, etc.  __c_call has a
// bespoke shape and is handled separately.
//
// `tail` is what follows the builtin on its line (a close delimiter, an operator);
// the LAST value argument reserves it plus this builtin's own `)` (`1 + tail`) so a
// wrappable trailing argument (a nested binary/call) sub-wraps rather than pushing
// the closing `)` past the cap.  (A non-last argument is followed by `, ` and is
// not the width-critical trailing element -- see claude-todo for that residual.)
func printBuiltin(b @strings.Builder, e @ast.Expr, tail int) {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL {
		printCCall(b, e)
		return
	}
	b.Write(token.TypeName(op))
	b.WriteByte('(')
	var wrote bool = false
	if e.TypeRef != nil {
		printType(b, e.TypeRef)
		wrote = true
	}
	for i := 0; i < len(e.Args); i++ {
		if wrote { b.Write(", ") }
		if i == len(e.Args) - 1 {
			printExprTail(b, e.Args[i], 1 + tail)
		} else {
			printExpr(b, e.Args[i])
		}
		wrote = true
	}
	b.WriteByte(')')
}

// printCCall appends a `__c_call("sym", RetType, args...)` builtin.  The symbol
// is stored quote-stripped in e.Name, so the quotes are re-added; a nil TypeRef
// is the void return, spelled "void"; and the `...` variadic marker is
// reinserted before the first variadic arg (at index e.CFixedArgs) when the call
// has variadic args (CFixedArgs < len(Args)).
func printCCall(b @strings.Builder, e @ast.Expr) {
	b.Write("__c_call(")
	b.WriteByte('"')
	b.Write(e.Name)
	b.WriteByte('"')
	b.Write(", ")
	if e.TypeRef == nil {
		b.Write("\"void\"")
	} else {
		printType(b, e.TypeRef)
	}
	for i := 0; i < len(e.Args); i++ {
		if e.CFixedArgs < len(e.Args) && i == e.CFixedArgs {
			b.Write(", ...")
		}
		b.Write(", ")
		printExpr(b, e.Args[i])
	}
	b.WriteByte(')')
}
