package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// activeOpeners holds the builtin calls' records of the file being formatted
// (ast.File.BuiltinOpeners), in source order; empty outside Format, and for a
// file parsed without comments.
var activeOpeners @[]@ast.BuiltinOpener

// builtinOpener returns the record of the builtin call e (found by its keyword's
// position, e.Pos), or nil when there is none.
func builtinOpener(e @ast.Expr) @ast.BuiltinOpener {
	return openerAt(activeOpeners, e.Pos)
}

// openerAt returns the record in openers (in source order) of the builtin call whose
// keyword is at pos, or nil when there is none.
func openerAt(openers *[]@ast.BuiltinOpener, pos token.Pos) @ast.BuiltinOpener {
	var lo int = 0
	var hi int = len(openers)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(openers[mid].Pos, pos) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < len(openers) && samePos(openers[lo].Pos, pos) { return openers[lo] }
	var none @ast.BuiltinOpener
	return none
}

// printBuiltin appends an EXPR_BUILTIN call — `name(...)` where name is the
// builtin keyword (token.TypeName of e.Op).  The argument list is the type
// operand (e.TypeRef, when present) followed by the value operands (e.Args), in
// that order: `make(T)`, `make_slice(T, n)`, `cast(T, e)`, `box(e)`,
// `len(e)`, `same(a, b)`, `sizeof(T)`, `_func_handle(f)`, etc.  __c_call and
// __c_global have a bespoke shape (a string-literal symbol operand) and are
// handled separately.
//
// `tail` is what follows the builtin on its line (a close delimiter, an operator).
//
// A builtin with a TYPE operand (`make`/`make_slice`/`cast`/`bit_cast`/
// `unsafe_cast`/`sizeof`/`alignof`) carries at most ONE value argument, which is
// therefore always the last
// element: it reserves `tail` plus this builtin's own `)` (`1 + tail`) so a
// wrappable trailing argument (a nested binary/call) sub-wraps rather than pushing
// the closing `)` past the cap.  A pure value-argument builtin (`box`/`len`/
// `present`/`same`/`unsafe_index`/`_func_handle`/...) may carry a non-last value
// argument (`same`/`unsafe_index` take two), so its list is fill-wrapped through
// printArgList exactly like printCall -- a non-last wrappable argument then reserves
// its separator and the list breaks between arguments rather than staying flat past
// the cap.
func printBuiltin(b @strings.Builder, e @ast.Expr, tail int) {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL {
		printCCall(b, e, tail)
		return
	}
	if op == token.C_GLOBAL {
		printCGlobal(b, e)
		return
	}
	b.Write(token.TypeName(op))
	if e.TypeRef == nil {
		// No type operand: the head is the builtin keyword, and the whole argument
		// list wraps like a call's, from its `(` (the keyword's line when the file
		// has no record of it).  The list's comments start after the keyword, so one
		// between it and the `(` goes after the `(`.
		var openerLine int = e.Pos.Line
		var rec @ast.BuiltinOpener = builtinOpener(e)
		var lparen token.Pos
		if rec != nil {
			openerLine = rec.LParen.Line
			lparen = rec.LParen
		}
		printArgList(b, e.Args, e.Pos, openerLine, false, '(', ')', lparen, false, tail)
		return
	}
	// Type operand leads, followed by the at-most-one value argument (always last).
	// The comments after the keyword, which go after the `(` as a value builtin's do,
	// and those before the value go there, keyed by the type's start, as a list's are
	// by its first element's (the keyword starts any list element the builtin begins);
	// one that needs a line break goes on at the current line's indent plus two.  The
	// block comments on one line before the `)`, paired with the `(` the file records,
	// stay there (argsCloserGap), after the last operand is rendered, for the lists in
	// it to claim their own comments.
	var key token.Pos = typeStartPos(e.TypeRef)
	var cont int = currentLineIndent(b) + 2
	var rec @ast.BuiltinOpener = builtinOpener(e)
	var lparen token.Pos
	if rec != nil { lparen = rec.LParen }
	b.WriteByte('(')
	writeGapSeparator(b, claimGap(e.Pos, key, key), cont, true, false)
	printType(b, e.TypeRef)
	var closing @[]@token.Comment
	if len(e.Args) == 0 { closing = claimInlineGap(key, pairedClose(lparen), key) }
	var lo token.Pos = key
	for i := 0; i < len(e.Args); i++ {
		var arg @ast.Expr = e.Args[i]
		var last bool = i == len(e.Args) - 1
		b.WriteByte(',')
		var start token.Pos = exprStartPos(arg)
		writeGapSeparator(b, claimGap(lo, start, key), cont, false, true)
		if last && !wrapSuppressed { closing = argsCloserGap(lparen, arg, key, true) }
		printExprTail(b, arg, 1 + inlineCommentsWidth(closing) + tail)
		if last && wrapSuppressed { closing = argsCloserGap(lparen, arg, key, true) }
		lo = start
	}
	_ = writeInlineComments(b, closing)
	b.WriteByte(')')
}

// printCCall appends a `__c_call("sym", RetType, args...)` builtin, fill-wrapping
// the argument list when the source wrapped it or the single-line form would
// exceed the cap (mirroring printStrList, with a `__c_call(` head instead of a
// single open delimiter -- without this a long syscall wrapper collapses onto one
// over-cap line).  The symbol is stored quote-stripped in e.Name (re-quoted here);
// a nil TypeRef is the void return, spelled "void"; and the `...` variadic marker
// is reinserted whenever e.CVariadic — before the first variadic arg (at index
// e.CFixedArgs) when trailing args follow, or after the last arg when CFixedArgs ==
// len(Args) (a `...` written with zero trailing varargs).  The last item reserves
// its `)` and tail, what follows the call on its line (a close, a trailing comment),
// as the other builtins' last operands do, and the block comments on one line
// before the `)`, which stay there (cCallCloserGap).
func printCCall(b @strings.Builder, e @ast.Expr, tail int) {
	listDepth = listDepth + 1
	printCCallIn(b, e, tail)
	listDepth = listDepth - 1
}

// printCCallIn is printCCall's body, its operands one list deeper (listDepth).
func printCCallIn(b @strings.Builder, e @ast.Expr, tail int) {
	// The argument list's items -- the quoted symbol, the return type (or "void"),
	// then the value args with `...` before the first variadic one -- each with its
	// source position for the wrap-mode decision and its comments.  The `(`, the
	// symbol's, the "void"'s and the `...`'s come from the file's record of the
	// call, and the list's comments then start after the keyword (one between it
	// and the `(` goes after the `(`); without a record, the keyword's position
	// stands in for the `(`, the symbol and "void", and the comments before the
	// first argument are not the list's.
	var opener token.Pos = e.Pos
	var gapOpener token.Pos
	var symPos token.Pos = e.Pos
	var voidPos token.Pos = e.Pos
	var dotsPos token.Pos
	var rec @ast.BuiltinOpener = builtinOpener(e)
	if rec != nil {
		opener = rec.LParen
		gapOpener = e.Pos
		if rec.Sym.Line > 0 { symPos = rec.Sym }
		if rec.Void.Line > 0 { voidPos = rec.Void }
		dotsPos = rec.Dots
	}
	var itemsV @vec.Vec[@listItem] = vec.New[@listItem]()
	var sym @strings.Builder = strings.NewBuilder()
	sym.WriteByte('"')
	sym.Write(e.Name)
	sym.WriteByte('"')
	// With a record the symbol is at its own position, so it keys the list.
	itemsV.Push(textItem(sym.String(), symPos, rec != nil && rec.Sym.Line > 0))
	if e.TypeRef == nil {
		itemsV.Push(textItem("\"void\"", voidPos, false))
	} else {
		itemsV.Push(typeItem(e.TypeRef, false))
	}
	for i := 0; i < len(e.Args); i++ {
		if e.CVariadic && i == e.CFixedArgs {
			var at token.Pos = exprStartPos(e.Args[i])
			if dotsPos.Line > 0 { at = dotsPos }
			itemsV.Push(textItem("...", at, false))
		}
		itemsV.Push(exprItem(nil, e.Args[i]))
	}
	// A `...` with ZERO trailing args (CFixedArgs == len(Args)) has no arg to print
	// it before, so the in-loop marker never fired — reinsert it after the last arg
	// so the source round-trips (`__c_call("f", ret, x, ...)` reprints unchanged
	// instead of dropping the marker and silently becoming non-variadic).
	if e.CVariadic && e.CFixedArgs >= len(e.Args) {
		var at token.Pos = e.Pos
		if dotsPos.Line > 0 { at = dotsPos }
		itemsV.Push(textItem("...", at, false))
	}

	var items @[]@listItem = itemsV.Items()
	var n int = len(items)
	// With wrapping suppressed the items print in place before the comments before
	// the `)` are claimed, as printStrList's do.
	var closing @[]@token.Comment
	if !wrapSuppressed { closing = cCallCloserGap(rec, items) }
	var last int = 1 + inlineCommentsWidth(closing) + tail
	b.Write("__c_call(")
	if wrapSuppressed {
		printItemsOneLine(b, items, gapOpener, false, last)
		_ = writeInlineComments(b, cCallCloserGap(rec, items))
		b.WriteByte(')')
		return
	}
	var openerAlone bool = !deepList() && items[0].line != opener.Line
	var sourceWrapped bool = openerAlone || !deepList() && items[0].line != items[n - 1].line
	var fits bool = !itemsHaveNewline(items) &&
			lineWidth(b) + itemsOneLineLen(items, gapOpener) + last <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		printItemsOneLine(b, items, gapOpener, false, last)
	} else {
		// After the first element: a comma (the symbol is never the last).
		var cont int = currentLineIndent(b) + 2
		var key token.Pos = listKey(items)
		var here int = lineWidth(b) + openerGapWidth(gapOpener, items[0].pos, key)
		var alone bool = openerAlone ||
				!itemFitsAt(items[0], 1, true, n == 1, 1, itemTrailWidth(items, 0, key), here,
						currentLineIndent(b), cont)
		fillStrs(b, items, cont, alone, last, gapOpener, false)
	}
	_ = writeInlineComments(b, closing)
	b.WriteByte(')')
}

// printCGlobal appends a `__c_global("sym", T)` builtin.  The symbol is stored
// quote-stripped in e.Name (re-quoted here); the type is always a real type in
// e.TypeRef (there is no "void" spelling), and there are no value arguments.
func printCGlobal(b @strings.Builder, e @ast.Expr) {
	b.Write("__c_global(")
	b.WriteByte('"')
	b.Write(e.Name)
	b.WriteByte('"')
	b.Write(", ")
	printType(b, e.TypeRef)
	b.WriteByte(')')
}
