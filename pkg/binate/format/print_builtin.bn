package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// printBuiltin appends an EXPR_BUILTIN call — `name(...)` where name is the
// builtin keyword (token.TypeName of e.Op).  The argument list is the type
// operand (e.TypeRef, when present) followed by the value operands (e.Args), in
// that order: `make(T)`, `make_slice(T, n)`, `cast(T, e)`, `box(e)`,
// `len(e)`, `same(a, b)`, `sizeof(T)`, `_func_handle(f)`, etc.  __c_call and
// __c_global have a bespoke shape (a string-literal symbol operand) and are
// handled separately.
//
// `tail` is what follows the builtin on its line (a close delimiter, an operator);
// the LAST value argument reserves it plus this builtin's own `)` (`1 + tail`) so a
// wrappable trailing argument (a nested binary/call) sub-wraps rather than pushing
// the closing `)` past the cap.  (A non-last argument is followed by `, ` and is
// not the width-critical trailing element -- see claude-todo for that residual.)
func printBuiltin(b @strings.Builder, e @ast.Expr, tail int) {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL {
		printCCall(b, e)
		return
	}
	if op == token.C_GLOBAL {
		printCGlobal(b, e)
		return
	}
	b.Write(token.TypeName(op))
	b.WriteByte('(')
	var wrote bool = false
	if e.TypeRef != nil {
		printType(b, e.TypeRef)
		wrote = true
	}
	for i := 0; i < len(e.Args); i++ {
		if wrote { b.Write(", ") }
		if i == len(e.Args) - 1 {
			printExprTail(b, e.Args[i], 1 + tail)
		} else {
			printExpr(b, e.Args[i])
		}
		wrote = true
	}
	b.WriteByte(')')
}

// printCCall appends a `__c_call("sym", RetType, args...)` builtin, fill-wrapping
// the argument list when the source wrapped it or the single-line form would
// exceed the cap (mirroring printStrList, with a `__c_call(` head instead of a
// single open delimiter -- without this a long syscall wrapper collapses onto one
// over-cap line).  The symbol is stored quote-stripped in e.Name (re-quoted here);
// a nil TypeRef is the void return, spelled "void"; and the `...` variadic marker
// is reinserted before the first variadic arg (at index e.CFixedArgs) when the
// call has variadic args (CFixedArgs < len(Args)).
func printCCall(b @strings.Builder, e @ast.Expr) {
	// Pre-render the argument list -- the quoted symbol, the return type (or
	// "void"), then the value args with `...` before the first variadic one --
	// recording each element's source line for the wrap-mode decision.
	var strs @[]@[]readonly char
	var lines @[]int
	var sym @strings.Builder = strings.NewBuilder()
	sym.WriteByte('"')
	sym.Write(e.Name)
	sym.WriteByte('"')
	strs = slices.Append[@[]readonly char](strs, sym.String())
	lines = slices.Append[int](lines, e.Pos.Line)
	var rt @strings.Builder = strings.NewBuilder()
	if e.TypeRef == nil {
		rt.Write("\"void\"")
		lines = slices.Append[int](lines, e.Pos.Line)
	} else {
		printType(rt, e.TypeRef)
		lines = slices.Append[int](lines, e.TypeRef.Pos.Line)
	}
	strs = slices.Append[@[]readonly char](strs, rt.String())
	for i := 0; i < len(e.Args); i++ {
		if e.CFixedArgs < len(e.Args) && i == e.CFixedArgs {
			strs = slices.Append[@[]readonly char](strs, "...")
			lines = slices.Append[int](lines, e.Args[i].Pos.Line)
		}
		var a @strings.Builder = strings.NewBuilder()
		printExpr(a, e.Args[i])
		strs = slices.Append[@[]readonly char](strs, a.String())
		lines = slices.Append[int](lines, e.Args[i].Pos.Line)
	}

	var n int = len(strs)
	b.Write("__c_call(")
	if wrapSuppressed {
		for i := 0; i < n; i++ {
			if i > 0 { b.Write(", ") }
			b.Write(strs[i])
		}
		b.WriteByte(')')
		return
	}
	var openerAlone bool = lines[0] != e.Pos.Line
	var sourceWrapped bool = openerAlone || lines[0] != lines[n - 1]
	var oneLine int = 0
	var anyMultiLine bool = false
	for i := 0; i < n; i++ {
		oneLine = oneLine + len(strs[i])
		if i > 0 { oneLine = oneLine + 2 }
		if hasNewline(strs[i]) { anyMultiLine = true }
	}
	var fits bool = !anyMultiLine && lineWidth(b) + oneLine + 1 <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		for i := 0; i < n; i++ {
			if i > 0 { b.Write(", ") }
			b.Write(strs[i])
		}
	} else {
		fillStrs(b, strs, currentLineIndent(b) + 2, wrapOpenerAlone(b, openerAlone, len(strs[0])), 1)
	}
	b.WriteByte(')')
}

// printCGlobal appends a `__c_global("sym", T)` builtin.  The symbol is stored
// quote-stripped in e.Name (re-quoted here); the type is always a real type in
// e.TypeRef (there is no "void" spelling), and there are no value arguments.
func printCGlobal(b @strings.Builder, e @ast.Expr) {
	b.Write("__c_global(")
	b.WriteByte('"')
	b.Write(e.Name)
	b.WriteByte('"')
	b.Write(", ")
	printType(b, e.TypeRef)
	b.WriteByte(')')
}
