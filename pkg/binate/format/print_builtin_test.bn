package "pkg/binate/format"

import "pkg/builtins/testing"

// Builtin calls round-trip through the token gate (checkExpr / parseExprSrc are
// defined in print_expr_test.bn, same package).

func TestPrintBuiltinsTypeAndValue() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("make(Foo)"); if len(r) > 0 { return r }
	r = checkExpr("make_slice(int, n)"); if len(r) > 0 { return r }
	r = checkExpr("cast(int, x)"); if len(r) > 0 { return r }
	r = checkExpr("bit_cast(uint32, f)"); if len(r) > 0 { return r }
	r = checkExpr("sizeof(Foo)"); if len(r) > 0 { return r }
	r = checkExpr("alignof(int)"); if len(r) > 0 { return r }
	r = checkExpr("cast(@[]int, p)"); if len(r) > 0 { return r }
	return ""
}

func TestPrintBuiltinsValueOnly() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("box(x)"); if len(r) > 0 { return r }
	r = checkExpr("len(s)"); if len(r) > 0 { return r }
	r = checkExpr("present(iv)"); if len(r) > 0 { return r }
	r = checkExpr("same(a, b)"); if len(r) > 0 { return r }
	r = checkExpr("unsafe_index(s, i)"); if len(r) > 0 { return r }
	r = checkExpr("box(a + b)"); if len(r) > 0 { return r }
	r = checkExpr("unsafe_div(a, b)"); if len(r) > 0 { return r }
	r = checkExpr("unsafe_rem(a, b)"); if len(r) > 0 { return r }
	r = checkExpr("unsafe_shl(x, 3)"); if len(r) > 0 { return r }
	r = checkExpr("unsafe_shr(x, 3)"); if len(r) > 0 { return r }
	r = checkExpr("_func_handle(f)"); if len(r) > 0 { return r }
	// The transitional `_raw_func_addr` alias canonicalizes to `_func_handle`.
	r = checkExprGolden("_raw_func_addr(f)", "_func_handle(f)")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintCCall() testing.TestResult {
	var r testing.TestResult
	// Void return (spelled "void"), no args.
	r = checkExpr("__c_call(\"abort\", \"void\")"); if len(r) > 0 { return r }
	// Typed return, fixed args.
	r = checkExpr("__c_call(\"write\", int, fd, buf, n)"); if len(r) > 0 { return r }
	// Variadic: the `...` marker separates fixed from variadic args.
	r = checkExpr("__c_call(\"printf\", int, fmt, ..., a, b)"); if len(r) > 0 { return r }
	return ""
}

// A builtin's LAST argument that is a wrappable binary reserves the builtin's
// closing `)` (printBuiltin forwards 1+tail to it), so it sub-wraps rather than
// pushing that `)` past the cap (the vm_exec_pure cast regression: the `^` binary
// inside `cast(int, ...)` fit flat but the trailing `)` tipped the line to 101).
// checkWrap is shared from print_wrap_test.bn (same package).
func TestPrintBuiltinLastArgBinarySubWraps() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tif cond {\n"
		"\t\tregs[instr.Dst] = cast(int, cast(uint32, regs[instr.Src1]) ^ "
		"(cast(uint32, 1) << cast(uint32, 31)))\n"
		"\t}\n"
		"}"
	return checkWrap(src)
}
