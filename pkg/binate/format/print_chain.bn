package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// printBinary renders a binary-operator chain (`a && b && c`, `x + y + z`),
// wrapping it when the source wrapped it or its single-line form would exceed the
// width cap; otherwise it stays on one line.  When wrapped, it breaks AFTER an
// operator (the operator ends the line) with continuation lines at +2 indent,
// fill-style -- matching house style (e.g. multi-line `if` conditions).  tail is
// what follows the expression on its last line.  The single-line form is tried
// from the chain's own column, its operands rendered where they would print
// (operandAt): a run of adjacent strings is written split or merged by where it
// lands.  Past STABLE_LIST_DEPTH nested lists, the source's wrapping is ignored
// (print_deep.bn).
//
// A chain prints the comments between its operands where the source put them, as
// a list does (claimGap, print_listcomments.bn), keyed by its first operator's
// position (chainKey): a block comment on one line before an operator stays there
// (a newline there would end the expression), and those after an operator follow
// it; a line comment there ends the line, and the next operand starts a
// continuation line (`if a && // c` / `b {`).  A gap is claimed after the operand
// before it is rendered, so a list inside that operand has claimed its own
// comments first; a comment inside the operand that nothing else prints goes
// after it.
func printBinary(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	chainPrints = chainPrints + 1
	if wrapSuppressed {
		printBinarySingle(b, e, exposed, tail)
		return
	}
	if (deepList() || !chainSourceWrapped(e)) && binarySingleFits(b, e, exposed, tail) {
		printBinarySingle(b, e, exposed, tail)
		return
	}
	printBinaryWrapped(b, e, exposed, tail)
}

// chainPrints counts printBinary's calls, for a test that bounds them.
var chainPrints int

// binarySingleFits reports whether `X op Y` (printBinarySingle) fits on b's
// current line, from its column, on one line with tail after it: never when a comment
// after the operator needs a line break after it (a line comment, or a block comment
// spanning lines).  Short of STABLE_LIST_DEPTH the source's line break there makes the
// chain wrap (chainSourceWrapped); past it, only this check does.
func binarySingleFits(b @strings.Builder, e @ast.Expr, exposed bool, tail int) bool {
	var p int = binopPrec(e.Op)
	var indent int = currentLineIndent(b)
	var col int = lineWidth(b)
	var x @[]readonly char = operandAt(e.X, p, e.Op, true, exposed, col, indent, 0)
	if hasNewline(x) { return false }
	var key token.Pos = chainKey(e, p)
	if inlineHold(e.Pos, exprStartPos(e.Y), key).Line > 0 { return false }
	var cw int = inlineCommentsWidth(chainGapBefore(e, p, key)) +
			inlineCommentsWidth(claimInlineGap(e.Pos, exprStartPos(e.Y), key))
	col = col + len(x) + cw + 2 + len(token.TypeName(cast(token.Type, e.Op)))
	var y @[]readonly char = operandAt(e.Y, p, e.Op, false, exposed, col, indent, tail)
	return !hasNewline(y) && col + len(y) + tail <= MAX_LINE_WIDTH
}

// operandAt returns chain operand e of parentOp (of precedence prec; the left one
// when isLeft) as printBinOperand prints it from column col of a line indented
// indent tabs, with tail after it -- from the rendering cache (renderAt), parens
// and all, except for an exposed operand, rendered afresh in its condition
// context.
func operandAt(e @ast.Expr, prec int, parentOp int, isLeft bool, exposed bool, col int, indent int,
		tail int) @[]readonly char {
	var paren bool = binOperandParens(e, prec, parentOp, isLeft)
	if exposed && !paren {
		var sb @strings.Builder = strings.NewBuilder()
		for i := 0; i < col; i++ {
			if i < indent { sb.WriteByte('\t') } else { sb.WriteByte(' ') }
		}
		printExprE(sb, e, true, tail)
		var s @[]readonly char = sb.String()
		var out @strings.Builder = strings.NewBuilder()
		out.Write(s[col:])
		return out.String()
	}
	if !paren { return renderAt(e, col, indent, tail) }
	var ob @strings.Builder = strings.NewBuilder()
	ob.WriteByte('(')
	ob.Write(renderAt(e, col + 1, indent, tail + 1))
	ob.WriteByte(')')
	return ob.String()
}

// flattenChain collects the operands, the between-operators and the operators'
// positions of the top-level left-associative chain of operators sharing
// precedence `prec`, in source order (`a op b op c` -> operands [a, b, c], ops
// [op, op]).  A sub-expression of a different precedence is one opaque operand
// (rendered, and parenthesized, as a whole).
func flattenChain(e @ast.Expr, prec int) (@vec.Vec[@ast.Expr], @vec.Vec[int], @vec.Vec[token.Pos]) {
	var operands @vec.Vec[@ast.Expr] = vec.New[@ast.Expr]()
	var ops @vec.Vec[int] = vec.New[int]()
	var at @vec.Vec[token.Pos] = vec.New[token.Pos]()
	// Do not flatten across a comparison operator: comparisons are
	// non-associative, so `X op Y` where op is a comparison is a single 2-operand
	// node (X stays one opaque operand, parenthesized if it is itself a
	// comparison), not a chain.
	if continuesChain(e, prec) {
		var lo @vec.Vec[@ast.Expr]
		var lp @vec.Vec[int]
		var la @vec.Vec[token.Pos]
		lo, lp, la = flattenChain(e.X, prec)
		operands = lo
		ops = lp
		at = la
	} else {
		operands.Push(e.X)
	}
	ops.Push(e.Op)
	at.Push(e.Pos)
	operands.Push(e.Y)
	return operands, ops, at
}

// continuesChain reports whether e's left operand continues e's chain of operators
// of precedence prec (flattenChain).
func continuesChain(e @ast.Expr, prec int) bool {
	return e.X != nil && e.X.Kind == ast.EXPR_BINARY && binopPrec(e.X.Op) == prec && !isCompareOp(e.Op)
}

// chainKey returns the key of the comments that the chain of operators of
// precedence prec ending in e prints: its first operator's position, which no list
// and no other chain shares.
func chainKey(e @ast.Expr, prec int) token.Pos {
	for continuesChain(e, prec) {
		e = e.X
	}
	return e.Pos
}

// opTail returns what follows operand i of a flattened chain keyed key on its line:
// the comments before operator i (before), ` op` and a line comment after the
// operator on its line, which a list leaves room for the same way (trailWidth).
func opTail(before @[]@token.Comment, operands @vec.Vec[@ast.Expr], ops @vec.Vec[int],
		at @vec.Vec[token.Pos], i int, key token.Pos) int {
	return inlineCommentsWidth(before) + 1 + len(token.TypeName(cast(token.Type, ops.Get(i)))) +
			trailWidth(at.Get(i), exprStartPos(operands.Get(i + 1)), key)
}

// chainGapBefore returns the comments before e's operator, from the start of the
// operand it follows, of the chain keyed key: block comments on one line, which
// continue the line (claimInlineGap).
func chainGapBefore(e @ast.Expr, prec int, key token.Pos) @[]@token.Comment {
	var x @ast.Expr = e.X
	if continuesChain(e, prec) { x = e.X.Y }
	return claimInlineGap(exprStartPos(x), e.Pos, key)
}

// chainSourceWrapped reports whether the operator chain's operands span more than
// one source line (the author wrapped it).
func chainSourceWrapped(e @ast.Expr) bool {
	var operands @vec.Vec[@ast.Expr]
	var ops @vec.Vec[int]
	var at @vec.Vec[token.Pos]
	operands, ops, at = flattenChain(e, binopPrec(e.Op))
	return operands.Get(0).Pos.Line != operands.Get(operands.Len() - 1).Pos.Line
}

// printBinaryWrapped fill-wraps a flattened operator chain: the first operand on
// the current line, then each ` op` appended and the following operand kept on the
// line if it fits or moved to a fresh +2 continuation line otherwise -- or, after a
// line comment, always moved.
func printBinaryWrapped(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	var prec int = binopPrec(e.Op)
	var operands @vec.Vec[@ast.Expr]
	var ops @vec.Vec[int]
	var at @vec.Vec[token.Pos]
	operands, ops, at = flattenChain(e, prec)
	var key token.Pos = at.Get(0)
	var cont int = currentLineIndent(b) + 2
	// operand[0] is followed on its line by the comments before ops[0], ` ops[0]`
	// and a line comment after it, so it reserves that width and sub-wraps if it is
	// itself a wrappable construct.
	var before @[]@token.Comment = claimAfterExpr(operands.Get(0), at.Get(0), key)
	printBinOperand(b, operands.Get(0), prec, ops.Get(0), true, exposed,
			opTail(before, operands, ops, at, 0, key))
	for i := 1; i < operands.Len(); i++ {
		_ = writeInlineComments(b, before)
		b.WriteByte(' ')
		b.Write(token.TypeName(cast(token.Type, ops.Get(i - 1))))
		var after @[]@token.Comment = claimGap(at.Get(i - 1), exprStartPos(operands.Get(i)), key)
		// otail is what lands on operand[i]'s line AFTER it: the comments before
		// the next operator, ` op` and a line comment after it, which
		// break-after-operator keeps on this operand's line, or -- for the last
		// operand -- the chain's own tail.  It reserves the break decision's width
		// AND is forwarded so a wrappable operand sub-wraps.
		var otail int = tail
		if i != operands.Len() - 1 {
			before = claimAfterExpr(operands.Get(i), at.Get(i), key)
			otail = opTail(before, operands, ops, at, i, key)
		}
		if writeGapComments(b, after, cont, false) {
			b.WriteByte('\n')
			writeIndent(b, cont)
		} else {
			var w int = binOperandWidth(b, operands.Get(i), prec, ops.Get(i - 1), exposed, otail) + otail
			if lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		printBinOperand(b, operands.Get(i), prec, ops.Get(i - 1), false, exposed, otail)
	}
}

// binOperandWidth returns the rendered width of a chain operand as a right operand
// of parentOp (its parenthesization in the chain), for the fill break decision:
// printed after b's current line and a space, where it would go, with tail after
// it (a run of adjacent strings is written split or merged by where it lands).
// The tail itself is not counted (the caller adds it).  An operand that spans
// lines there is measured by its whole rendering from column 0 with nothing after
// it, all its lines' bytes, unindented -- a measure that keeps a short multi-line
// operand (a function literal) on the line and breaks before a long one.
func binOperandWidth(b @strings.Builder, e @ast.Expr, prec int, parentOp int, exposed bool,
		tail int) int {
	var s @[]readonly char = operandAt(e, prec, parentOp, false, exposed, lineWidth(b) + 1,
			currentLineIndent(b), tail)
	if !hasNewline(s) { return len(s) }
	return len(operandAt(e, prec, parentOp, false, exposed, 0, 0, 0))
}
