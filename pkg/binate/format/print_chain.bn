package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// printBinary renders a binary-operator chain (`a && b && c`, `x + y + z`),
// wrapping it when the source wrapped it or its single-line form would exceed the
// width cap; otherwise it stays on one line.  When wrapped, it breaks AFTER an
// operator (the operator ends the line) with continuation lines at +2 indent,
// fill-style -- matching house style (e.g. multi-line `if` conditions).  tail is
// what follows the expression on its last line.  The single-line form is tried
// from the chain's own column, its operands rendered where they would print
// (operandAt): a run of adjacent strings is written split or merged by where it
// lands.
func printBinary(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if wrapSuppressed {
		printBinarySingle(b, e, exposed, tail)
		return
	}
	if !chainSourceWrapped(e) && binarySingleFits(b, e, exposed, tail) {
		printBinarySingle(b, e, exposed, tail)
		return
	}
	printBinaryWrapped(b, e, exposed, tail)
}

// binarySingleFits reports whether `X op Y` (printBinarySingle) fits on b's
// current line, from its column, on one line with tail after it.
func binarySingleFits(b @strings.Builder, e @ast.Expr, exposed bool, tail int) bool {
	var p int = binopPrec(e.Op)
	var indent int = currentLineIndent(b)
	var col int = lineWidth(b)
	var x @[]readonly char = operandAt(e.X, p, e.Op, true, exposed, col, indent, 0)
	if hasNewline(x) { return false }
	col = col + len(x) + 2 + len(token.TypeName(cast(token.Type, e.Op)))
	var y @[]readonly char = operandAt(e.Y, p, e.Op, false, exposed, col, indent, tail)
	return !hasNewline(y) && col + len(y) + tail <= MAX_LINE_WIDTH
}

// operandAt returns chain operand e of parentOp (of precedence prec; the left one
// when isLeft) as printBinOperand prints it from column col of a line indented
// indent tabs, with tail after it -- from the rendering cache (renderAt), parens
// and all, except for an exposed operand, rendered afresh in its condition
// context.
func operandAt(e @ast.Expr, prec int, parentOp int, isLeft bool, exposed bool, col int, indent int,
		tail int) @[]readonly char {
	var paren bool = binOperandParens(e, prec, parentOp, isLeft)
	if exposed && !paren {
		var sb @strings.Builder = strings.NewBuilder()
		for i := 0; i < col; i++ {
			if i < indent { sb.WriteByte('\t') } else { sb.WriteByte(' ') }
		}
		printExprE(sb, e, true, tail)
		var s @[]readonly char = sb.String()
		var out @strings.Builder = strings.NewBuilder()
		out.Write(s[col:])
		return out.String()
	}
	if !paren { return renderAt(e, col, indent, tail) }
	var ob @strings.Builder = strings.NewBuilder()
	ob.WriteByte('(')
	ob.Write(renderAt(e, col + 1, indent, tail + 1))
	ob.WriteByte(')')
	return ob.String()
}

// flattenChain collects the operands and the between-operators of the top-level
// left-associative chain of operators sharing precedence `prec`, in source order
// (`a op b op c` -> operands [a, b, c], ops [op, op]).  A sub-expression of a
// different precedence is one opaque operand (rendered, and parenthesized, as a
// whole).
func flattenChain(e @ast.Expr, prec int) (@vec.Vec[@ast.Expr], @vec.Vec[int]) {
	var operands @vec.Vec[@ast.Expr] = vec.New[@ast.Expr]()
	var ops @vec.Vec[int] = vec.New[int]()
	// Do not flatten across a comparison operator: comparisons are
	// non-associative, so `X op Y` where op is a comparison is a single 2-operand
	// node (X stays one opaque operand, parenthesized if it is itself a
	// comparison), not a chain.
	if e.X != nil && e.X.Kind == ast.EXPR_BINARY && binopPrec(e.X.Op) == prec && !isCompareOp(e.Op) {
		var lo @vec.Vec[@ast.Expr]
		var lp @vec.Vec[int]
		lo, lp = flattenChain(e.X, prec)
		operands = lo
		ops = lp
	} else {
		operands.Push(e.X)
	}
	ops.Push(e.Op)
	operands.Push(e.Y)
	return operands, ops
}

// chainSourceWrapped reports whether the operator chain's operands span more than
// one source line (the author wrapped it).
func chainSourceWrapped(e @ast.Expr) bool {
	var operands @vec.Vec[@ast.Expr]
	var ops @vec.Vec[int]
	operands, ops = flattenChain(e, binopPrec(e.Op))
	return operands.Get(0).Pos.Line != operands.Get(operands.Len() - 1).Pos.Line
}

// printBinaryWrapped fill-wraps a flattened operator chain: the first operand on
// the current line, then each ` op` appended and the following operand kept on the
// line if it fits or moved to a fresh +2 continuation line otherwise.
func printBinaryWrapped(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	var prec int = binopPrec(e.Op)
	var operands @vec.Vec[@ast.Expr]
	var ops @vec.Vec[int]
	operands, ops = flattenChain(e, prec)
	var cont int = currentLineIndent(b) + 2
	// operand[0] is followed by ` ops[0]` on its line, so it reserves that width
	// and sub-wraps if it is itself a wrappable construct.
	printBinOperand(b, operands.Get(0), prec, ops.Get(0), true, exposed,
			1 + len(token.TypeName(cast(token.Type, ops.Get(0)))))
	for i := 1; i < operands.Len(); i++ {
		b.WriteByte(' ')
		b.Write(token.TypeName(cast(token.Type, ops.Get(i - 1))))
		// otail is what lands on operand[i]'s line AFTER it: the next operator
		// (` op`), which break-after-operator keeps on this operand's line, or --
		// for the last operand -- the chain's own tail.  It reserves the break
		// decision's width AND is forwarded so a wrappable operand sub-wraps.
		var otail int = tail
		if i != operands.Len() - 1 {
			otail = 1 + len(token.TypeName(cast(token.Type, ops.Get(i))))
		}
		var w int = binOperandWidth(b, operands.Get(i), prec, ops.Get(i - 1), exposed, otail) + otail
		if lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont {
			b.WriteByte('\n')
			writeIndent(b, cont)
		} else {
			b.WriteByte(' ')
		}
		printBinOperand(b, operands.Get(i), prec, ops.Get(i - 1), false, exposed, otail)
	}
}

// binOperandWidth returns the rendered width of a chain operand as a right operand
// of parentOp (its parenthesization in the chain), for the fill break decision:
// printed after b's current line and a space, where it would go, with tail after
// it (a run of adjacent strings is written split or merged by where it lands).
// The tail itself is not counted (the caller adds it).  An operand that spans
// lines there is measured by its whole rendering from column 0 with nothing after
// it, all its lines' bytes, unindented -- a measure that keeps a short multi-line
// operand (a function literal) on the line and breaks before a long one.
func binOperandWidth(b @strings.Builder, e @ast.Expr, prec int, parentOp int, exposed bool,
		tail int) int {
	var s @[]readonly char = operandAt(e, prec, parentOp, false, exposed, lineWidth(b) + 1,
			currentLineIndent(b), tail)
	if !hasNewline(s) { return len(s) }
	return len(operandAt(e, prec, parentOp, false, exposed, 0, 0, 0))
}
