package "pkg/binate/format"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// A short boolean chain that fits stays on one line.
func TestChainFits() testing.TestResult {
	return checkLayout("func f() { if a && b && c { g() } }", "if a && b && c {")
}

// A long boolean condition wraps after operators (continuation at +2), stays
// within the cap, and is idempotent.
func TestChainWidthTriggered() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionOneAaaaaaaaaa && conditionTwoBbbbbbbbbb && "
			"conditionThreeCccccccccc && conditionFourDddddddddd && conditionFiveEeeeeeeeee {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	// Breaks after an operator onto a +2 continuation line.
	if !containsSub(out, "&&\n\t\t\t") {
		return tokDiff("chain wrap: no break-after-operator at +2", out, "&&<nl><tab><tab><tab>")
	}
	return ""
}

// A boolean condition the source wrapped stays wrapped (re-flowed) and idempotent.
func TestChainSourceWrapped() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionAaaaaaaaaaaaaaaaaaaa &&\n"
			"\t\t\tconditionBbbbbbbbbbbbbbbbbbbb {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A long assignment RHS that is an operator chain wraps.
func TestChainAssignment() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tvar total = firstTermAaaaaaaaaa + secondTermBbbbbbbbbb + thirdTermCccccccccc + "
			"fourthTermDddddddddd + fifthTermEeeeeeeeee + sixthTermFfffffffff\n"
			"}"
	return checkWrap(src)
}

// A boolean condition whose single-line form plus the block-opening ` {` would
// exceed 100 wraps so no line (including the ` {`) exceeds the cap (review
// findings 1/2: the condition reserves the ` {`).
func TestChainConditionBraceReserved() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionAaaaaaaaaaaaaa && conditionBbbbbbbbbbbbbb && "
			"conditionCcccccccccccc && conditionDddddddddddddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A `for` and a `switch` header condition likewise reserve the ` {`.
func TestChainForSwitchBraceReserved() testing.TestResult {
	var r testing.TestResult = checkWrap(
			"func f() {\n"
					"\tfor conditionAaaaaaaaaaaaaa && conditionBbbbbbbbbbbbbb && "
					"conditionCcccccccccccc && conditionDddddddddddddd {\n"
					"\t\tg()\n"
					"\t}\n"
					"}")
	if len(r) > 0 { return r }
	return checkWrap(
			"func f() {\n"
					"\tswitch tagAaaaaaaaaaaaaaaaaa + tagBbbbbbbbbbbbbbbbbb + "
					"tagCcccccccccccccccc + tagDdddddddddddddddddddd {\n"
					"\tcase 1: g()\n"
					"\t}\n"
					"}")
}

// A comparison of two sub-comparisons wraps without flattening (comparisons are
// non-associative), keeping every operand's parentheses (token-equal).
func TestChainCompareNonAssocWrap() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif (firstLongConditionAaaaaa == secondLongValueBbbbbb) != "
			"(thirdLongConditionCccccc == fourthLongValueDddddd) {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A mixed-precedence chain wraps at the lowest-precedence (top-level) operator,
// keeping tighter sub-expressions intact.
func TestChainMixedPrecedence() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif firstAaaaaaaaaa && secondBbbbbbbbbb || thirdCccccccccc && fourthDddddddddd "
			"|| fifthEeeeeeeeee && sixthFfffffffff {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A parenthesized inner &&-chain operand of a wrapped outer ||-chain reserves the
// trailing `)` and the following ` op`, so it sub-wraps instead of emitting flat
// past the cap at a deep indent (the operand fits the flat width, but an
// un-reserved `) ||` tail pushes it over 100).
func TestChainNestedOperandSubWraps() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif aaa {\n"
			"\t\tif bbb {\n"
			"\t\t\tif ccc {\n"
			"\t\t\t\tif (ins.Op == iropcode.OP_CALL_FUNC_VALUE && IsAggregateTyp(ins.Typ) && "
			"!IsMultiReturnCall(ins)) || (ins.Op == iropcode.OP_CALL_IFACE_METHOD && "
			"IsAggregateTyp(ins.Typ) && !IsMultiReturnCall(ins)) {\n"
			"\t\t\t\t\tg()\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A chain measures an operand, and tries its single-line form, from the column it would
// print at, with what follows it: a run of strings that fits split only from column 0, or
// only without the `)` after it, is merged and stays on the line -- as a reformat, which finds
// it merged, lays it out.
func TestChainOperandAtItsColumn() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx(\n"
			"\t) + \"a\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaa\" \""
			"aaaaaaaaaaaaaaaaaaaaaa\"\n"
			"\tg(yy + \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaa\")\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx() + \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaa\"\n"
			"\tg(yy + \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaa\")\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A chain nested 20 deep through parenthesized operands formats at once: each operand's
// measures come from the rendering cache, where rendered afresh at each level they cost about
// three times as much per level of nesting.
func TestNestedChainMeasuresCached() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := v19 + (v18 * (v17 + (v16 * (v15 + (v14 * (v13 + (v12 * (v11 + (v10 * (v09 + (v08 * ("
			"v07 + (v06 * (v05 + (v04 * (v03 + (v02 * (v01 + (v00 * (z))))))))))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := v19 +\n"
			"\t\t\t(v18 *\n"
			"\t\t\t\t\t(v17 +\n"
			"\t\t\t\t\t\t\t(v16 *\n"
			"\t\t\t\t\t\t\t\t\t(v15 +\n"
			"\t\t\t\t\t\t\t\t\t\t\t(v14 *\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t(v13 +\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v12 *\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v11 +\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v10 *\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v09 +\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v08 *\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v07 +\n"
			"\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(v06 * (v05 + (v04 * (v03 + (v02 * (v"
			"01 + (v00 * z)))))))))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An operand that spans lines where it would print (a function literal with its body expanded)
// is measured by its rendering from column 0 -- all its lines' bytes, none of the indentation
// they get there -- so at a deep indent it still stays after the chain's last operator.
func TestChainMultiLineOperandUnindented() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif c1 {\n"
			"\t\tif c2 {\n"
			"\t\t\tif c3 {\n"
			"\t\t\t\tif c4 {\n"
			"\t\t\t\t\tif c5 {\n"
			"\t\t\t\t\t\tif c6 {\n"
			"\t\t\t\t\t\t\tx := aaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + call(func() int {\n"
			"\t\t\t\t\t\t\t\treturn 1\n"
			"\t\t\t\t\t\t\t})\n"
			"\t\t\t\t\t\t}\n"
			"\t\t\t\t\t}\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// An operator chain prints the comments between its operands where the source put them: a
// block comment before or after an operator stays there, a line comment after one ends the line
// and the next operand starts a continuation line (an `if`'s condition and a list's element
// too), and an own-line one gets a line of its own; a comment inside an operand that nothing
// else prints goes after the operand.
func TestChainCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a bool, b bool) {\n"
			"\tif a && // c\n"
			"\t\tb {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tx := 1 + /* c */\n"
			"\t\t2 // d\n"
			"\tp = 1 + /* z */ 2\n"
			"\tq = 1 /* y */ + 2\n"
			"\tif a /* m */ && b /* n */ && c {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tr := aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb + // long\n"
			"\t\tcccccccccccccccccccccc + ddddddddddddd\n"
			"\ts := a +\n"
			"\t\t// own line\n"
			"\t\tb\n"
			"\tt := h(a + /* in */ b, c)\n"
			"\tu := h(a && // l\n"
			"\t\tb, c)\n"
			"\tv := (a + /* p */ b) * c\n"
			"\tw := a == /* e */ b\n"
			"\ty := -/* u */ x + z\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a bool, b bool) {\n"
			"\tif a && // c\n"
			"\t\t\tb {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tx := 1 + /* c */ 2 // d\n"
			"\tp = 1 + /* z */ 2\n"
			"\tq = 1 /* y */ + 2\n"
			"\tif a /* m */ && b /* n */ && c {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tr := aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb + // long\n"
			"\t\t\tcccccccccccccccccccccc + ddddddddddddd\n"
			"\ts := a +\n"
			"\t\t\t// own line\n"
			"\t\t\tb\n"
			"\tt := h(a + /* in */ b, c)\n"
			"\tu := h(a && // l\n"
			"\t\t\tb, c)\n"
			"\tv := (a + /* p */ b) * c\n"
			"\tw := a == /* e */ b\n"
			"\ty := -/* u */ x + z\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An operand leaves room on its line for the block comments before the operator after it, as
// for the operator, and for a line comment after the operator, as a list's element does: a
// wrappable operand wraps, or the operand moves to a continuation line, so that they fit.  A
// comment before an operator is the chain's, not the header's: its room is reserved once.
func TestChainLeavesRoomForCommentsAroundAnOperator() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif cast(int, hhhhhhhhhhhh(aaaaaaaaaaaa, bbbbbbbbbbbb, cccccccccccc, dddddddddddd)) /* first "
			"*/ !=\n"
			"\t\t\teeeeeeeeeeeeeeeee {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tx := kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk(aaaaaaaaaaaa, bbbbbbbbbbbb) /* "
			"second */ +\n"
			"\t\t\tyyyyy\n"
			"\ty := aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb + ccccc + // "
			"a line comment after\n"
			"\t\tddd\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb && ccccc && // "
			"a line comment after\n"
			"\t\tddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tz := kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk(aaaaaaaaaaaaaa, bbbbbbbbbbbb) + // a line "
			"comment after the first\n"
			"\t\tddd\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif cast(int, hhhhhhhhhhhh(aaaaaaaaaaaa, bbbbbbbbbbbb, cccccccccccc, dddddddddddd)) /* first "
			"*/ !=\n"
			"\t\t\teeeeeeeeeeeeeeeee {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tx := kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk(aaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbb) /* second */ + yyyyy\n"
			"\ty := aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb +\n"
			"\t\t\tccccc + // a line comment after\n"
			"\t\t\tddd\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb &&\n"
			"\t\t\tccccc && // a line comment after\n"
			"\t\t\tddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tz := kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk(aaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbb) + // a line comment after the first\n"
			"\t\t\tddd\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// leftChains returns a file whose statement nests d chains, of alternating precedence, in
// each other's left operands, wrapped, with a block comment before each operator.
func leftChains(d int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc f() {\n\tx := ")
	for i := 1; i < d; i++ { b.WriteByte('(') }
	b.Write("a")
	for i := 1; i <= d; i++ {
		if i % 2 == 1 { b.Write(" /* c */ *\n\t\tv") } else { b.Write(" /* c */ +\n\t\tv") }
		if i < d { b.WriteByte(')') }
	}
	b.Write("\n}\n")
	return b.String()
}

// A chain renders an operand once to let the lists in it claim their comments before it
// claims those before the operator after it, through the rendering cache: rendered afresh,
// chains nested 16 deep in each other's left operands would print about 2^16 times.
func TestChainCommentsNestedLeftPrintFew() testing.TestResult {
	var before int = chainPrints
	_ = Format(parseCollected(leftChains(16)))
	var n int = chainPrints - before
	if n <= 400 { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("chain prints, 16 deep: ")
	sb.Write(strconv.Itoa(n))
	sb.Write(" (bound 400)")
	return buf.CopyStr(sb.String())
}

// A wrapped chain keeps the author's parentheses around a left operand of its own
// precedence (printBinOperand), as a chain on one line does: one wrapped for its
// width, and one the source wrapped.
func TestChainWrappedKeepsLeftParens() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 2)
	srcs[0] = "func f() {\n"
			"\tx := (firstNumeratorAaaaaaaaaaaa / secondDivisorBbbbbbbbbbb) / thirdDivisorCccccccccc / "
			"fourthDivisorDddddddddd\n"
			"}"
	srcs[1] = "func f() {\n"
			"\tif (conditionAaaaaaaaaaaaaaaaaa && conditionBbbbbbbbbbbbbbbbbb) && "
			"conditionCcccccccccccc &&\n"
			"\t\t\tconditionDdddddddddddddddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	var wraps @[]*[]readonly char = make_slice(*[]readonly char, 2)
	wraps[0] = "Cccccccccc /\n"
	wraps[1] = "Ccccccccccccc &&\n"
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = checkWrap(srcs[i])
		if len(r) > 0 { return r }
		var out @[]readonly char = fmtFunc(srcs[i])
		if !containsSub(out, wraps[i]) {
			return tokDiff("wrapped chain: not wrapped there", srcs[i], out)
		}
	}
	return ""
}

// The comments around and inside a parenthesized left operand of a wrapped chain stay
// where they are, the line comments after its operators too, and so do the
// parentheses of a nested one and of one whose own chain wraps.
func TestChainWrappedParensKeepComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := ((firstNumeratorAaaaaaaaaaaa /* i1 */ / /* i2 */ secondDivisorBbbbbbbbbbb) "
			"/* m1 */ / /* m2 */ thirdDivisorCccccccccc) /* o1 */ / /* o2 */ "
			"fourthDivisorDddddddddd\n"
			"\tb := ((firstNumeratorAaaaaaaaaaaa / // i1\n"
			"\t\t\tsecondDivisorBbbbbbbbbbb) / // m1\n"
			"\t\t\tthirdDivisorCccccccccc) / // o1\n"
			"\t\t\tfourthDivisorDddddddddd\n"
			"\te := (firstNumeratorAaaaaaaaaaaa / secondDivisorBbbbbbbbbbb / "
			"thirdDivisorCccccccccc / fourthDivisorDdddddddddd / fifth) / sixth\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := ((firstNumeratorAaaaaaaaaaaa /* i1 */ / /* i2 */ secondDivisorBbbbbbbbbbb) "
			"/* m1 */ / /* m2 */\n"
			"\t\t\tthirdDivisorCccccccccc) /* o1 */ / /* o2 */ fourthDivisorDddddddddd\n"
			"\tb := ((firstNumeratorAaaaaaaaaaaa / // i1\n"
			"\t\t\tsecondDivisorBbbbbbbbbbb) / // m1\n"
			"\t\t\tthirdDivisorCccccccccc) / // o1\n"
			"\t\t\tfourthDivisorDddddddddd\n"
			"\te := (firstNumeratorAaaaaaaaaaaa / secondDivisorBbbbbbbbbbb / "
			"thirdDivisorCccccccccc /\n"
			"\t\t\tfourthDivisorDdddddddddd / fifth) / sixth\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Past STABLE_LIST_DEPTH a parenthesized left operand of a chain, a chain of its own,
// keeps a line comment after one of its operators in place.
func TestDeepChainParensKeepLineComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh((aa + // c3\n"
			"\t\t\tbb) - vfbadfgecbjhffhfahdcbeiavfbadfgecbjhffhfahdcbeia - "
			"kfekcjidcbbdggfcfcjaakcjidcbbdggfcfcjaa)))))))))))))\n"
			"\ty := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(((/* c2 */ aggcah + "
			"bdjiiahhafhjggidei) + // c9\n"
			"\t\t\tebhhcbebcfghhh) - vfbadfgecbjhffhfahdcbeia - "
			"kfekcjidcbbdggfcfcjaa)))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(\n"
			"\t\t\t(aa + // c3\n"
			"\t\t\t\t\tbb) - vfbadfgecbjhffhfahdcbeiavfbadfgecbjhffhfahdcbeia -\n"
			"\t\t\t\t\tkfekcjidcbbdggfcfcjaakcjidcbbdggfcfcjaa)))))))))))))\n"
			"\ty := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(/* c2 */\n"
			"\t\t\t((aggcah + bdjiiahhafhjggidei) + // c9\n"
			"\t\t\t\t\tebhhcbebcfghhh) - vfbadfgecbjhffhfahdcbeia - "
			"kfekcjidcbbdggfcfcjaa)))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}
