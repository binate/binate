package "pkg/binate/format"

import "pkg/builtins/testing"

// A short boolean chain that fits stays on one line.
func TestChainFits() testing.TestResult {
	return checkLayout("func f() { if a && b && c { g() } }", "if a && b && c {")
}

// A long boolean condition wraps after operators (continuation at +2), stays
// within the cap, and is idempotent.
func TestChainWidthTriggered() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionOneAaaaaaaaaa && conditionTwoBbbbbbbbbb && "
			"conditionThreeCccccccccc && conditionFourDddddddddd && conditionFiveEeeeeeeeee {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	// Breaks after an operator onto a +2 continuation line.
	if !containsSub(out, "&&\n\t\t\t") {
		return tokDiff("chain wrap: no break-after-operator at +2", out, "&&<nl><tab><tab><tab>")
	}
	return ""
}

// A boolean condition the source wrapped stays wrapped (re-flowed) and idempotent.
func TestChainSourceWrapped() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionAaaaaaaaaaaaaaaaaaaa &&\n"
			"\t\t\tconditionBbbbbbbbbbbbbbbbbbbb {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A long assignment RHS that is an operator chain wraps.
func TestChainAssignment() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tvar total = firstTermAaaaaaaaaa + secondTermBbbbbbbbbb + thirdTermCccccccccc + "
			"fourthTermDddddddddd + fifthTermEeeeeeeeee + sixthTermFfffffffff\n"
			"}"
	return checkWrap(src)
}

// A boolean condition whose single-line form plus the block-opening ` {` would
// exceed 100 wraps so no line (including the ` {`) exceeds the cap (review
// findings 1/2: the condition reserves the ` {`).
func TestChainConditionBraceReserved() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif conditionAaaaaaaaaaaaaa && conditionBbbbbbbbbbbbbb && "
			"conditionCcccccccccccc && conditionDddddddddddddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A `for` and a `switch` header condition likewise reserve the ` {`.
func TestChainForSwitchBraceReserved() testing.TestResult {
	var r testing.TestResult = checkWrap(
			"func f() {\n"
					"\tfor conditionAaaaaaaaaaaaaa && conditionBbbbbbbbbbbbbb && "
					"conditionCcccccccccccc && conditionDddddddddddddd {\n"
					"\t\tg()\n"
					"\t}\n"
					"}")
	if len(r) > 0 { return r }
	return checkWrap(
			"func f() {\n"
					"\tswitch tagAaaaaaaaaaaaaaaaaa + tagBbbbbbbbbbbbbbbbbb + "
					"tagCcccccccccccccccc + tagDdddddddddddddddddddd {\n"
					"\tcase 1: g()\n"
					"\t}\n"
					"}")
}

// A comparison of two sub-comparisons wraps without flattening (comparisons are
// non-associative), keeping every operand's parentheses (token-equal).
func TestChainCompareNonAssocWrap() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif (firstLongConditionAaaaaa == secondLongValueBbbbbb) != "
			"(thirdLongConditionCccccc == fourthLongValueDddddd) {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A mixed-precedence chain wraps at the lowest-precedence (top-level) operator,
// keeping tighter sub-expressions intact.
func TestChainMixedPrecedence() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif firstAaaaaaaaaa && secondBbbbbbbbbb || thirdCccccccccc && fourthDddddddddd "
			"|| fifthEeeeeeeeee && sixthFfffffffff {\n"
			"\t\tg()\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}

// A parenthesized inner &&-chain operand of a wrapped outer ||-chain reserves the
// trailing `)` and the following ` op`, so it sub-wraps instead of emitting flat
// past the cap at a deep indent (the common.bn nested-condition regression: the
// operand fit the flat width but the un-reserved `) ||` tail pushed it over 100).
func TestChainNestedOperandSubWraps() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif aaa {\n"
			"\t\tif bbb {\n"
			"\t\t\tif ccc {\n"
			"\t\t\t\tif (ins.Op == iropcode.OP_CALL_FUNC_VALUE && IsAggregateTyp(ins.Typ) && "
			"!IsMultiReturnCall(ins)) || (ins.Op == iropcode.OP_CALL_IFACE_METHOD && "
			"IsAggregateTyp(ins.Typ) && !IsMultiReturnCall(ins)) {\n"
			"\t\t\t\t\tg()\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}"
	return checkWrap(src)
}
