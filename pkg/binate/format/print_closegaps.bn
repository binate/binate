package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A list prints the comments before its close where they stand, as it does those
// between its elements (print_listcomments.bn): after its last element
// (`g(x, y /* c */)`), or, for a line comment, after a trailing comma, with the close
// on a line of its own (`2, // c` / `}`); in an empty list, between its brackets.
// The syntax tree keeps few closes' positions, so a close is found by its opener
// among the bracket pairs the parser records (ast.File.Brackets, pairedClose).  As a
// parameter list does with those before its `)`, the list takes, in source order,
// the comments from its last element's start to its close that nothing prints:
// those right before the close, those before a trailing comma, and those inside the
// element that no list in it prints.  They count in its layout (writeCloserGap,
// closerTail).  So the element is rendered first, for the lists in it to claim
// their own comments (argsCloserGap; an item list's items are rendered when built).
// A list that takes no trailing comma and ends in no spread (a builtin's operands)
// takes them only when each is a block comment on one line, as a line break after
// its last element would end the statement there; otherwise it leaves them all for
// after the statement (claimInlineGap), as the closes that take no list do
// (print_inlineclose.bn).

// activeBrackets holds the bracket pairs of the file being formatted
// (ast.File.Brackets), in the order of their openers; empty outside Format, and
// for a file parsed without comments.
var activeBrackets @[]token.Bracket

// bracketAfter returns the index in bs, bracket pairs in the order of their openers,
// of the first pair whose opener is at or after pos.
func bracketAfter(bs *[]token.Bracket, pos token.Pos) int {
	var lo int = 0
	var hi int = len(bs)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(bs[mid].Open, pos) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return lo
}

// pairedClose returns the position of the close paired with the opener at open, or
// the zero Pos when no pair opens there.
func pairedClose(open token.Pos) token.Pos {
	return pairedCloseIn(activeBrackets, open)
}

// pairedCloseIn is pairedClose among the bracket pairs bs.
func pairedCloseIn(bs *[]token.Bracket, open token.Pos) token.Pos {
	var k int = bracketAfter(bs, open)
	if k < len(bs) && samePos(bs[k].Open, open) { return bs[k].Close }
	var none token.Pos
	return none
}

// openAfter returns the position of the first opener after pos -- a function
// type's `(` after its start, a type assertion's after its `.` -- or the zero Pos
// when there is none.
func openAfter(pos token.Pos) token.Pos {
	return openAfterIn(activeBrackets, pos)
}

// openAfterIn is openAfter among the bracket pairs bs.
func openAfterIn(bs *[]token.Bracket, pos token.Pos) token.Pos {
	var k int = bracketAfter(bs, pos)
	if k < len(bs) && samePos(bs[k].Open, pos) { k = k + 1 }
	if k < len(bs) { return bs[k].Open }
	var none token.Pos
	return none
}

// emptyListComments returns the comments between an empty list's opener, at open,
// and the close paired with it, claimed for the list (keyed by its opener).
func emptyListComments(open token.Pos) @[]@token.Comment {
	return claimBeforeToken(pairedClose(open), open)
}

// commentsBetween reports whether a comment of the active cursor lies after lo and
// before hi.
func commentsBetween(lo token.Pos, hi token.Pos) bool {
	var cc @commentCursor = activeCursor
	if cc == nil || lo.Line == 0 || hi.Line == 0 { return false }
	var k int = firstAfter(cc, lo)
	return k < len(cc.comments) && posLess(cc.comments[k].Pos, hi)
}

// argsCloserGap returns the comments that an argument list keyed key, whose last
// element is last, prints before the close paired with the opener at open: those
// from the element's start to the close that nothing prints, claimed for the list
// -- when the close must follow the element on its line (inline), only when each is
// a block comment on one line (claimInlineGap).  Unless wrapping is suppressed, the
// element's one-line form is rendered first (flatWidth), for the lists in it to
// claim their own comments, as exprFitsAt does past STABLE_LIST_DEPTH; with
// wrapping suppressed the list has printed its elements in place already.
func argsCloserGap(open token.Pos, last @ast.Expr, key token.Pos, inline bool) @[]@token.Comment {
	var lo token.Pos = exprStartPos(last)
	var hi token.Pos = pairedClose(open)
	if !commentsBetween(lo, hi) {
		var none @[]@token.Comment
		return none
	}
	if !wrapSuppressed { _ = flatWidth(last) }
	if inline { return claimInlineGap(lo, hi, key) }
	return claimGap(lo, hi, key)
}

// itemsCloserGap is argsCloserGap for a list of items, whose items were rendered
// when they were built (exprItem, typeItem), so the lists in the last one have
// claimed their own comments already.
func itemsCloserGap(open token.Pos, items @[]@listItem, inline bool) @[]@token.Comment {
	var it @listItem = items[len(items) - 1]
	var hi token.Pos = pairedClose(open)
	if !commentsBetween(it.pos, hi) {
		var none @[]@token.Comment
		return none
	}
	if inline { return claimInlineGap(it.pos, hi, listKey(items)) }
	return claimGap(it.pos, hi, listKey(items))
}

// writeEmptyListGap writes the comments in an empty list, between its brackets
// (cs): against the opener, and, when one needs a line break after it, the close
// on a line of its own at the list's indent.
func writeEmptyListGap(b @strings.Builder, cs @[]@token.Comment) {
	var base int = currentLineIndent(b)
	if writeGapComments(b, cs, base + 2, true) {
		b.WriteByte('\n')
		writeIndent(b, base)
	}
}

// argsCloserTail is closerTail for an argument list, whose last element wraps to
// leave room for what follows it: endTail (the spread marker, the close and what
// follows it) and the comments before the close (cs) when they can stay on the
// line, or else the spread marker (spreadLen bytes) and what closerBreakTail
// counts.
func argsCloserTail(cs @[]@token.Comment, comma bool, spreadLen int, endTail int) int {
	if len(cs) == 0 { return endTail }
	if gapCommentsWidth(cs) >= 0 { return endTail + inlineCommentsWidth(cs) }
	return spreadLen + closerBreakTail(cs, comma)
}

// closerBreakTail returns the room the comments before a list's close (cs) take
// after its last element when the close goes on the next line (writeCloserGap):
// the trailing comma, when the list takes one (comma), and the comments that stay
// on the element's line after it (writeGapComments) -- the block comments on one
// line before the first that starts its own line or spans lines, and a line comment
// after them, which ends the line (a block comment that does not fit there moves to
// the next line).
func closerBreakTail(cs @[]@token.Comment, comma bool) int {
	var w int = 0
	if comma { w = 1 }
	for i := 0; i < len(cs); i++ {
		var c @token.Comment = cs[i]
		if c.OwnLine || hasNewline(c.Text) { return w }
		w = w + 1 + len(c.Text)
		if !isBlockComment(c) { return w }
	}
	return w
}

// writeBreakableCloserGap writes the comments cs before a close that follows a token
// after which a line may break -- the `:` of a slice with no high bound, a `__c_call`'s
// `...` -- as a list writes those before its close (writeCloserGap), the close on a
// line at base after one that needs a line break after it.  Block comments ending in a
// line comment, which stays on their line, begin a continuation line at cont when they
// do not fit on the token's line together (closerRunWidth): one at a time, a block
// comment that fit would stay, and the line comment after it run past the cap.
func writeBreakableCloserGap(b @strings.Builder, cs @[]@token.Comment, cont int, base int,
		tail int) {
	var run int = closerRunWidth(cs)
	if run > 0 && isBlockComment(cs[0]) && lineWidth(b) > cont && lineWidth(b) + run > MAX_LINE_WIDTH {
		b.WriteByte('\n')
		writeIndent(b, cont)
		_ = writeGapComments(b, cs, cont, true)
		b.WriteByte('\n')
		writeIndent(b, base)
		return
	}
	writeCloserGap(b, cs, false, cont, base, tail)
}

// closerRunWidth returns the width that the comments cs before such a close take on the
// line of the token before them when a line comment ends them there: the run of block
// comments and the line comment (lineEndWidth), after the space writeCloserGap writes
// before them -- measured alike whether the source put the block comments on a line of
// their own or not; else 0.
func closerRunWidth(cs @[]@token.Comment) int {
	var w int = lineEndWidth(cs)
	if w > 0 && isBlockComment(cs[0]) { w = w + 1 }
	return w
}
