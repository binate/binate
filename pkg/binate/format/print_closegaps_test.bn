package "pkg/binate/format"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// A comment before a list's close stays there and the output is stable: after a
// call's, an index's, a composite's, a type-argument list's and a function type's
// last element, after a spread, and in an empty list; a line comment after a
// trailing comma, or after a spread, which takes none, with the close on the next
// line.
func TestCloserCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var j *func(int, bool /* c */)\n"
			"\n"
			"func f() {\n"
			"\ta := g(x, n /* c */)\n"
			"\tb := s[n /* c */]\n"
			"\tc := T{1, 2 /* c */}\n"
			"\td := g[int /* c */](x)\n"
			"\te := len(n /* c */)\n"
			"\th := g(xs... /* c */)\n"
			"\ti := g(/* c */)\n"
			"\tk := T{/* c */}\n"
			"\tvar m p.Box[int /* c */]\n"
			"\te2 := g( // c\n"
			"\t)\n"
			"\tvar m2 p.Box[int, // c\n"
			"\t]\n"
			"\tzz := g(xs... // c\n"
			"\t)\n"
			"\tww := g(x, xs... /* c */)\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A line comment before a list's close goes after a trailing comma with the close
// on a line of its own, in a list that fills its lines as in one that keeps an
// element on each.
func TestCloserLineCommentsGoAfterATrailingComma() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := g(x,\n"
			"\t\tn, // c\n"
			"\t)\n"
			"\td := T{\n"
			"\t\t1,\n"
			"\t\t2, // c\n"
			"\t}\n"
			"\tk := T{\n"
			"\t\t1, // b\n"
			"\t\t2, // c\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := g(x, n, // c\n"
			"\t)\n"
			"\td := T{\n"
			"\t\t\t1, 2, // c\n"
			"\t}\n"
			"\tk := T{\n"
			"\t\t\t1, // b\n"
			"\t\t\t2, // c\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A builtin's operands take no trailing comma, and a line break after the last one
// would end the statement, so a line comment before the `)` -- inside the last
// operand, where nothing in it prints it -- goes after the statement with the
// comments beside it, and the output parses and is stable.  A block comment on one
// line alone stays before the `)`, and a call around the builtin takes the line
// comment after its trailing comma.
func TestCloserLineCommentInABuiltinGoesAfterTheStatement() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := len(y.(p. // c\n"
			"\t\tT))\n"
			"\tz := box(y.(p. /* b */ // c\n"
			"\t\tT))\n"
			"\tw := same(a, y.(p. // c\n"
			"\t\tT))\n"
			"\tv := len(y.(p. /* b */ T))\n"
			"\t_ = g(x, len(y.(p. // c\n"
			"\t\tT)))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := len(y.(p.T))\n"
			"\t// c\n"
			"\n"
			"\tz := box(y.(p.T))\n"
			"\t/* b */\n"
			"\t// c\n"
			"\n"
			"\tw := same(a, y.(p.T))\n"
			"\t// c\n"
			"\n"
			"\tv := len(y.(p.T) /* b */)\n"
			"\t_ = g(x, len(y.(p.T)), // c\n"
			"\t)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before a list's close counts in its layout: a block comment that would
// take the line past the limit wraps the list, and stays after the last element.
func TestCloserCommentsCountInTheLayout() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txx := gggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a comment */)\n"
			"\tyy := gggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, // a comment\n"
			"\t)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txx := gggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a comment */)\n"
			"\tyy := gggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, // a comment\n"
			"\t)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// The comments a list prints before its close keep their order with the others from
// its last element's start that nothing prints -- before a trailing comma, and inside
// a parenthesized expression, a builtin's operand, a slice's bound or a type
// assertion's type in the element -- in a call, a composite, an index and a type
// list; an empty function type's parameter list keeps its own.
func TestCloserCommentsKeepTheirOrder() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var m p.Box[int /* a */, /* b */]\n"
			"\n"
			"var e *func(*func(/* h */) int /* i */)\n"
			"\n"
			"func f() {\n"
			"\ta := g(x /* a */, /* b */)\n"
			"\tb := g(x /* a */, // b\n"
			"\t)\n"
			"\tc := T{\n"
			"\t\t1,\n"
			"\t\t2 /* a */, // b\n"
			"\t}\n"
			"\tx := s[i /* a */, /* b */]\n"
			"\ty := T{k: 1 /* a */, /* b */}\n"
			"\ta2 := g(x, (y /* a */) /* b */)\n"
			"\tb2 := g(x, make_slice(int, n /* a */) /* b */)\n"
			"\tc2 := g(x, s[1:n /* a */] /* b */)\n"
			"\td2 := g(x, y.(T /* a */) /* b */)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var m p.Box[int /* a */ /* b */]\n"
			"\n"
			"var e *func(*func(/* h */) int /* i */)\n"
			"\n"
			"func f() {\n"
			"\ta := g(x /* a */ /* b */)\n"
			"\tb := g(x, /* a */ // b\n"
			"\t)\n"
			"\tc := T{\n"
			"\t\t\t1, 2, /* a */ // b\n"
			"\t}\n"
			"\tx := s[i /* a */ /* b */]\n"
			"\ty := T{k: 1 /* a */ /* b */}\n"
			"\ta2 := g(x, y /* a */ /* b */)\n"
			"\tb2 := g(x, make_slice(int, n) /* a */ /* b */)\n"
			"\tc2 := g(x, s[1:n] /* a */ /* b */)\n"
			"\td2 := g(x, y.(T) /* a */ /* b */)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// readBackNest returns a file whose statement nests calls 13 deep around
// `hh(<58 q's>, f(<name>), f(x /* cccccccccccccccc */))`, each adding `, yyy)`, the
// eleventh `, yyy, // d` with its `)` on the next line.
func readBackNest(name *[]readonly char) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"p\"\n\nfunc g() {\n\t_ = ")
	for i := 0; i < 13; i++ { sb.Write("aa(") }
	sb.Write("hh(")
	for i := 0; i < 58; i++ { sb.WriteByte('q') }
	sb.Write(", f(")
	sb.Write(name)
	sb.Write("), f(x /* cccccccccccccccc */))")
	for i := 0; i < 13; i++ {
		if i == 10 {
			sb.Write(", yyy, // d\n)")
		} else {
			sb.Write(", yyy)")
		}
	}
	sb.Write("\n}\n")
	return sb.String()
}

// A layout read back renders a call with a comment before its close by a shape of
// its own, not that of the same call without the comment: here the layouts read back
// hold `f(x)` and `f(x /* c */)`, and the file lays out as it does with `f(z)` for
// the first.
func TestCloserCommentsInReadBackShapes() testing.TestResult {
	var withX @[]readonly char = Format(parseCollected(readBackNest("x")))
	var withZ @[]readonly char = Format(parseCollected(readBackNest("z")))
	var at int = indexOf(withZ, "f(z)")
	if at < 0 { return "f(z) missing from the output" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(withZ[:at])
	sb.Write("f(x)")
	sb.Write(withZ[at + 4:])
	if !streq(sb.String(), withX) { return tokDiff("f(x) lays out unlike f(z)", withX, sb.String()) }
	return checkFormatGolden(withX, withX)
}

// A block comment and a line comment after a trailing comma both stay on the last
// element's line, and the element leaves room for both: it moves to a continuation
// line rather than taking that line past the cap.
func TestCloserBlockThenLineCommentCount() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggg(xxxxxxxxxx,\n"
			"\t\tpppppppppppppppppppppppppppppppppppppppppppppp, /* aaaaaaa"
			"aaa */ // bbbbbbbbbbbbbbb\n"
			"\t)\n"
			"\tc := T{xxxxxxxxxx,\n"
			"\t\tpppppppppppppppppppppppppppppppppppppppppppppppp, /* aaaaa"
			"aaaaa */ // bbbbbbbbbbbbbbb\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggg(xxxxxxxxxx,\n"
			"\t\t\tpppppppppppppppppppppppppppppppppppppppppppppp, /* aaaaaa"
			"aaaa */ // bbbbbbbbbbbbbbb\n"
			"\t)\n"
			"\tc := T{xxxxxxxxxx,\n"
			"\t\t\tpppppppppppppppppppppppppppppppppppppppppppppppp, /* aaaa"
			"aaaaaa */ // bbbbbbbbbbbbbbb\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Past STABLE_LIST_DEPTH, where a list is measured by its elements' one-line forms
// (print_deep.bn), the comments before each close count in that form and stay in
// place, and the output is stable: calls nested 20 deep, each with a comment before
// its `)`.
func TestCloserCommentsPastStableListDepth() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"p\"\n\nfunc g() {\n\t_ = ")
	for i := 0; i < 20; i++ { sb.Write("f(") }
	sb.WriteByte('x')
	for i := 0; i < 20; i++ {
		sb.Write(", y /* c")
		sb.Write(strconv.Itoa(i))
		sb.Write(" */)")
	}
	sb.Write("\n}\n")
	var src @[]readonly char = sb.String()
	var out @[]readonly char = Format(parseCollected(src))
	for i := 0; i < 20; i++ {
		var want @strings.Builder = strings.NewBuilder()
		want.Write("y /* c")
		want.Write(strconv.Itoa(i))
		want.Write(" */)")
		if !containsSub(out, want.String()) { return buf.CopyStr(want.String()) }
	}
	return checkFormatGolden(src, out)
}

// pairedClose finds the close paired with an opener, and openAfter the first opener
// after a position, among the bracket pairs; neither finds what is not there.
func TestPairedCloseAndOpenAfter() testing.TestResult {
	var saved @[]token.Bracket = activeBrackets
	var bs @[]token.Bracket = make_slice(token.Bracket, 2)
	bs[0].Open.Line = 1
	bs[0].Open.Col = 5
	bs[0].Close.Line = 3
	bs[0].Close.Col = 1
	bs[1].Open.Line = 2
	bs[1].Open.Col = 7
	bs[1].Close.Line = 2
	bs[1].Close.Col = 9
	activeBrackets = bs
	var r testing.TestResult = checkBrackets()
	activeBrackets = saved
	return r
}

// checkBrackets checks pairedClose and openAfter against TestPairedCloseAndOpenAfter's
// pairs: (1:5, 3:1) and (2:7, 2:9).
func checkBrackets() testing.TestResult {
	var p token.Pos
	p.Line = 2
	p.Col = 7
	var c token.Pos = pairedClose(p)
	if c.Line != 2 || c.Col != 9 { return "the close of 2:7 is 2:9" }
	p.Col = 8
	if pairedClose(p).Line != 0 { return "no pair opens at 2:8" }
	p.Line = 1
	p.Col = 5
	var o token.Pos = openAfter(p)
	if o.Line != 2 || o.Col != 7 { return "the opener after 1:5 is 2:7" }
	p.Line = 2
	p.Col = 7
	if openAfter(p).Line != 0 { return "no opener after 2:7" }
	return ""
}
