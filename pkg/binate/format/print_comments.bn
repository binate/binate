package "pkg/binate/format"

import "pkg/binate/token"
import "pkg/std/strings"

// commentCursor walks a file's position-sorted comments (File.Comments, in source
// order) as the printer emits nodes, flushing each comment when the emission
// reaches its source position.  nil when there are no comments -- the standalone
// Format* entries and non-collecting parses -- in which case every emit helper is
// a no-op.
type commentCursor struct {
	comments @[]@token.Comment
	idx      int
}

// newCommentCursor returns a cursor over comments, or nil when there are none.
func newCommentCursor(comments @[]@token.Comment) @commentCursor {
	if len(comments) == 0 { return nil }
	var cc @commentCursor = make(commentCursor)
	cc.comments = comments
	cc.idx = 0
	return cc
}

// posLess reports whether a precedes b in source order (line, then column).
func posLess(a token.Pos, b token.Pos) bool {
	if a.Line != b.Line { return a.Line < b.Line }
	return a.Col < b.Col
}

// hasBlankGap reports whether the source had at least one blank line between
// prevEndLine and the next content emitted before nextPosLine (a pending comment,
// or the node at nextPosLine).  Preserving a single blank line where this holds
// (and only one, regardless of how many source blanks) collapses 2+ blanks to 1.
//
// A pending comment at or before prevEndLine is a STALE interior comment (one no
// node's end line consumed, e.g. a mid-argument `foo(a, // c`); it is not the
// next content, so the gap is measured to the node -- otherwise it would yield a
// negative gap and suppress a real blank.  Note the asymmetry a blank BEFORE a
// leading comment is preserved (measured to the comment), but a blank BETWEEN a
// leading comment and its statement is not (the comment→node sub-gap is not
// tracked) -- a minor fidelity gap, always idempotent.
func hasBlankGap(cc @commentCursor, prevEndLine int, nextPosLine int) bool {
	var nl int = nextEmitLine(cc, nextPosLine)
	if nl <= prevEndLine { nl = nextPosLine }
	return nl - prevEndLine > 1
}

// nextEmitLine returns the source line of whatever the printer emits next up to
// fallbackLine: the next pending comment's line if it precedes fallbackLine, else
// fallbackLine.  Blank-line preservation measures a source gap to this (a comment
// or the node), so an intervening comment without a blank line does not
// spuriously trigger a blank.  Returns fallbackLine when cc is nil.
func nextEmitLine(cc @commentCursor, fallbackLine int) int {
	if cc == nil { return fallbackLine }
	if cc.idx < len(cc.comments) {
		var cl int = cc.comments[cc.idx].Pos.Line
		if cl < fallbackLine { return cl }
	}
	return fallbackLine
}

// emitLeadingComments flushes every pending comment positioned before pos, each
// on its own line at the given indent (a leading / doc / dangling comment).
// Same-line trailing comments have already been consumed by emitTrailingComment
// right after their node, so the comments reaching here are own-line leading
// ones -- plus, as a fallback, any interior comment (e.g. mid-argument) that no
// node's end line matched: it is emitted own-line rather than being left to wedge
// the cursor and force every later comment to the end-of-file backstop.  Returns
// whether it emitted any (a caller placing a closing delimiter uses this to
// decide whether it needs a fresh line).  A no-op when cc is nil.
func emitLeadingComments(b @strings.Builder, cc @commentCursor, pos token.Pos, indent int) bool {
	if cc == nil { return false }
	var any bool = false
	for cc.idx < len(cc.comments) {
		var c @token.Comment = cc.comments[cc.idx]
		if !posLess(c.Pos, pos) { break }
		b.WriteByte('\n')
		writeIndent(b, indent)
		b.Write(c.Text)
		cc.idx = cc.idx + 1
		any = true
	}
	return any
}

// emitTrailingComment flushes comments on the SAME line as endPos (a
// just-emitted node's end), each as ` <text>` continuing the current line.  A
// no-op when cc is nil.
func emitTrailingComment(b @strings.Builder, cc @commentCursor, endPos token.Pos) {
	if cc == nil { return }
	for cc.idx < len(cc.comments) {
		var c @token.Comment = cc.comments[cc.idx]
		if c.OwnLine { break }
		if c.Pos.Line != endPos.Line { break }
		b.WriteByte(' ')
		b.Write(c.Text)
		cc.idx = cc.idx + 1
	}
}

// flushRemainingComments emits every comment still pending, each on its own line
// at the given indent.  The multiset-preservation backstop (§11.3): a comment the
// position-driven interleave did not place (e.g. mid-expression, or inside a
// function-literal body the expression printer does not thread the cursor
// through) is still emitted rather than dropped.  A no-op when cc is nil.
func flushRemainingComments(b @strings.Builder, cc @commentCursor, indent int) {
	if cc == nil { return }
	for cc.idx < len(cc.comments) {
		var c @token.Comment = cc.comments[cc.idx]
		b.WriteByte('\n')
		writeIndent(b, indent)
		b.Write(c.Text)
		cc.idx = cc.idx + 1
	}
}
