package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// commentCursor walks a file's position-sorted comments (File.Comments, in source
// order) as the printer emits nodes, flushing each comment when the emission
// reaches its source position.  nil when there are no comments -- the standalone
// Format* entries and non-collecting parses -- in which case every emit helper is
// a no-op.
type commentCursor struct {
	comments @[]@token.Comment
	idx      int
	// done marks the comments a function-literal body or a struct type printed
	// through a cursor of its own (innerCursor), or a list printed (claimGap); this
	// cursor skips them.  Empty until one is.
	done @[]bool
	// owner holds, for a comment a list printed, that list's key (its first
	// element's position; see print_listcomments.bn).  Empty until one is.
	owner @[]token.Pos
	// id tells this cursor from every other made in the process, for the
	// rendering cache (print_rendermemo.bn); never 0.
	id int
}

// cursorSerial is the id of the cursor made last.
var cursorSerial int = 0

// activeCursor is the cursor of the code being printed -- the file's, or the
// enclosing function-literal body's (printFuncLit) or struct type's (printType) --
// for the expression and type printers, which take no cursor.  nil outside Format
// and when there are no comments.
var activeCursor @commentCursor

// skipDone advances cc past the comments a function-literal body, a struct type or
// a list printed.
func skipDone(cc @commentCursor) {
	if len(cc.done) == 0 { return }
	for cc.idx < len(cc.comments) && cc.done[cc.idx] {
		cc.idx = cc.idx + 1
	}
}

// isDone reports whether comment k of cc was printed by a function-literal body, a
// struct type or a list.
func isDone(cc @commentCursor, k int) bool {
	return len(cc.done) > 0 && cc.done[k]
}

// literalBodyCursor returns a cursor over the comments inside function-literal
// body blk (between its braces), taken from activeCursor (innerCursor).
func literalBodyCursor(blk @ast.Stmt) @commentCursor {
	if blk == nil { return nil }
	return innerCursor(blk.Pos, blk.End)
}

// innerCursor returns a cursor over the comments between lo and hi -- inside a
// function literal's body, or a struct type the type printer reaches, which print
// them through a cursor of their own (the expression and type printers thread
// none) -- taken from activeCursor, and marks them done there so the enclosing
// printer does not emit them again; nil when there are none.  Each print of the
// node -- a width trial as much as the final layout -- gets a fresh cursor, and
// every layout prints the node exactly once, so marking them in a trial is
// harmless.  Only comments activeCursor has not emitted are taken -- those past its
// position, or before it but done (skipped, not emitted): one the enclosing
// printer has already emitted -- a trailing comment on the line a literal opens,
// after a statement joined to it by `;` -- stays where it was put.
func innerCursor(lo token.Pos, hi token.Pos) @commentCursor {
	var ac @commentCursor = activeCursor
	if ac == nil { return nil }
	// The comments are in source order: those in the span run from the first after
	// lo to the first not before hi.
	var first int = firstAfter(ac, lo)
	var n int = 0
	for k := first; k < len(ac.comments) && posLess(ac.comments[k].Pos, hi); k++ {
		if notEmitted(ac, k) { n = n + 1 }
	}
	if n == 0 { return nil }
	if len(ac.done) == 0 { ac.done = make_slice(bool, len(ac.comments)) }
	var cs @[]@token.Comment = make_slice(@token.Comment, n)
	var j int = 0
	for k := first; k < len(ac.comments) && posLess(ac.comments[k].Pos, hi); k++ {
		if notEmitted(ac, k) {
			cs[j] = ac.comments[k]
			j = j + 1
			ac.done[k] = true
		}
	}
	return newCommentCursor(cs)
}

// notEmitted reports whether comment k of cc has not been emitted by cc: it is
// past cc's position, or before it but done (skipped by skipDone).
func notEmitted(cc @commentCursor, k int) bool {
	return k >= cc.idx || isDone(cc, k)
}

// newCommentCursor returns a cursor over comments, or nil when there are none.
func newCommentCursor(comments @[]@token.Comment) @commentCursor {
	if len(comments) == 0 { return nil }
	var cc @commentCursor = make(commentCursor)
	cc.comments = comments
	cc.idx = 0
	cursorSerial = cursorSerial + 1
	cc.id = cursorSerial
	return cc
}

// cursorMark holds a statement's comment cursor's state and activeCursor's, for
// undoing what a trial print claimed through them (markCursors, resetCursors).
type cursorMark struct {
	stmt   @cursorState
	active @cursorState
}

// cursorState is a comment cursor's position, and its marks from there to the
// first comment past a node: all a print of the node can change, as it claims only
// the comments inside it (claimGap, innerCursor).
type cursorState struct {
	idx      int
	hi       int
	hasDone  bool
	done     @[]bool
	hasOwner bool
	owner    @[]token.Pos
}

// markCursors returns the state of cc and of activeCursor, for a print of a node
// ending at end.
func markCursors(cc @commentCursor, end token.Pos) @cursorMark {
	var m @cursorMark = make(cursorMark)
	m.stmt = saveCursor(cc, end)
	m.active = saveCursor(activeCursor, end)
	return m
}

// resetCursors puts cc and activeCursor back in the state markCursors returned.
func resetCursors(cc @commentCursor, m @cursorMark) {
	restoreCursor(cc, m.stmt)
	restoreCursor(activeCursor, m.active)
}

// saveCursor returns a copy of c's state for a print of a node ending at end; nil
// for a nil c.
func saveCursor(c @commentCursor, end token.Pos) @cursorState {
	if c == nil { return nil }
	var st @cursorState = make(cursorState)
	st.idx = c.idx
	st.hi = firstAfter(c, end)
	if st.hi < st.idx { st.hi = st.idx }
	st.hasDone = len(c.done) > 0
	if st.hasDone {
		st.done = make_slice(bool, st.hi - st.idx)
		for i := st.idx; i < st.hi; i++ { st.done[i - st.idx] = c.done[i] }
	}
	st.hasOwner = len(c.owner) > 0
	if st.hasOwner {
		st.owner = make_slice(token.Pos, st.hi - st.idx)
		for i := st.idx; i < st.hi; i++ { st.owner[i - st.idx] = c.owner[i] }
	}
	return st
}

// restoreCursor gives c the state st (saveCursor's copy of it) back.
func restoreCursor(c @commentCursor, st @cursorState) {
	if c == nil { return }
	c.idx = st.idx
	if st.hasDone {
		for i := st.idx; i < st.hi; i++ { c.done[i] = st.done[i - st.idx] }
	} else {
		var none @[]bool
		c.done = none
	}
	if st.hasOwner {
		for i := st.idx; i < st.hi; i++ { c.owner[i] = st.owner[i - st.idx] }
	} else {
		var none @[]token.Pos
		c.owner = none
	}
}

// posLess reports whether a precedes b in source order (line, then column).
func posLess(a token.Pos, b token.Pos) bool {
	if a.Line != b.Line { return a.Line < b.Line }
	return a.Col < b.Col
}

// stmtStartPos returns the position of s's first token, where its leading
// comments end and a blank line before it is measured to.  That is not always
// s.Pos: an assignment's or `++` / `--` statement's Pos is its operator's, and
// an expression statement's is its expression's (exprStartPos), so a comment
// inside a left operand that spans lines -- `func() { // c` … `}()` -- would be
// taken for one before the statement.
func stmtStartPos(s @ast.Stmt) token.Pos {
	var k int = s.Kind
	if k == ast.STMT_EXPR || k == ast.STMT_INC_DEC { return exprStartPos(s.X) }
	if (k == ast.STMT_ASSIGN || k == ast.STMT_SHORT_VAR) && len(s.Exprs) > 0 {
		return exprStartPos(s.Exprs[0])
	}
	return s.Pos
}

// exprStartPos returns the position of e's first token: that of its leftmost
// operand (exprLeftmost), or for a composite literal, whose Pos is its `{`, its
// type's (typeStartPos).
func exprStartPos(e @ast.Expr) token.Pos {
	var l @ast.Expr = exprLeftmost(e)
	if l.Kind == ast.EXPR_COMPOSITE && l.TypeRef != nil { return typeStartPos(l.TypeRef) }
	return l.Pos
}

// exprLeftmost returns the operand at e's left edge.  A call's, selector's,
// index's, slice's, type assertion's and binary expression's Pos is its
// operator's (`(`, `.`, `[`, `+`), after its left operand X, so the left edge is
// X's: `func() { … }()[0]` starts with its function literal.
func exprLeftmost(e @ast.Expr) @ast.Expr {
	for e.X != nil {
		var k int = e.Kind
		if k != ast.EXPR_CALL && k != ast.EXPR_SELECTOR && k != ast.EXPR_INSTANTIATE_OR_INDEX &&
				k != ast.EXPR_SLICE && k != ast.EXPR_TYPE_ASSERT && k != ast.EXPR_BINARY {
			break
		}
		e = e.X
	}
	return e
}

// typeStartPos returns the position of a type expression's first token.  A
// generic instantiation's Pos is its `[`, after the type it instantiates (Base),
// so its start is Base's.
func typeStartPos(te @ast.TypeExpr) token.Pos {
	for te.Kind == ast.TEXPR_INSTANTIATE && te.Base != nil {
		te = te.Base
	}
	return te.Pos
}

// hasBlankGap reports whether the source had at least one blank line between
// prevEndLine and the next content emitted before nextPosLine (a pending comment,
// or the node at nextPosLine).  Preserving a single blank line where this holds
// (and only one, regardless of how many source blanks) collapses 2+ blanks to 1.
//
// A pending comment at or before prevEndLine is a STALE interior comment (one no
// node's end line consumed, e.g. one after a binary operator, `a + // c`); it is
// not the next content, so the gap is measured to the node -- otherwise it would
// yield a negative gap and suppress a real blank.
//
// The gap is measured from the end of a block comment the printer placed after
// the previous node (trailingEndLine), so a node starting on that comment's last
// line gets no blank line.
func hasBlankGap(cc @commentCursor, prevEndLine int, nextPosLine int) bool {
	var prev int = trailingEndLine(cc, prevEndLine)
	var nl int = nextEmitLine(cc, nextPosLine)
	if nl <= prev { nl = nextPosLine }
	return nl - prev > 1
}

// trailingEndLine returns the line the source's content on line ends on: line, or
// the last line of an emitted comment that starts on it and spans lines -- a block
// comment after the node ending there (`x := 5 /* a` / `b */`), which the printer
// writes after that node, so the source's next line follows the comment's end.
func trailingEndLine(cc @commentCursor, line int) int {
	if cc == nil { return line }
	var end int = line
	for j := cc.idx - 1; j >= 0 && cc.comments[j].Pos.Line >= line; j-- {
		var c @token.Comment = cc.comments[j]
		if c.Pos.Line == line && c.End.Line > end { end = c.End.Line }
	}
	return end
}

// nextEmitLine returns the source line of whatever the printer emits next up to
// fallbackLine: the next pending comment's line if it precedes fallbackLine, else
// fallbackLine.  Blank-line preservation measures a source gap to this (a comment
// or the node), so an intervening comment without a blank line does not
// spuriously trigger a blank.  Returns fallbackLine when cc is nil.
func nextEmitLine(cc @commentCursor, fallbackLine int) int {
	if cc == nil { return fallbackLine }
	skipDone(cc)
	if cc.idx < len(cc.comments) {
		var cl int = cc.comments[cc.idx].Pos.Line
		if cl < fallbackLine { return cl }
	}
	return fallbackLine
}

// commentBefore reports whether the next pending comment is positioned before
// pos -- i.e. a comment falls inside the span the caller is about to emit.  A
// construct with an interior comment cannot be collapsed to a single line (the
// comment must be placed on its own line, or a `//` would swallow the rest).  A
// no-op-false when cc is nil or exhausted.
func commentBefore(cc @commentCursor, pos token.Pos) bool {
	if cc == nil { return false }
	skipDone(cc)
	if cc.idx >= len(cc.comments) { return false }
	return posLess(cc.comments[cc.idx].Pos, pos)
}

// emitLeadingComments flushes every pending comment positioned before pos, each
// on its own line at the given indent (a leading / doc / dangling comment).
// Same-line trailing comments have already been consumed by emitTrailingComment
// right after their node, so the comments reaching here are own-line leading
// ones -- plus, as a fallback, any interior comment (e.g. after a binary
// operator) that no node's end line matched: it is emitted own-line rather than
// being left to wedge the cursor and force every later comment to the
// end-of-file backstop.  Returns
// whether it emitted any (a caller placing a closing delimiter uses this to
// decide whether it needs a fresh line).  A no-op when cc is nil.
//
// blankBeforeNode preserves a single blank line the source placed between the
// LAST comment emitted and the node at pos: a section-divider comment sitting
// between two declarations (with a blank line before the next one) describes the
// group that follows, not that one declaration, so gluing it on as a doc comment
// changes its meaning.  Callers whose pos is a closing delimiter (a dangling
// comment before `}` / `)`) pass false -- a blank line there is stripped, as it
// is everywhere before a close.
func emitLeadingComments(b @strings.Builder, cc @commentCursor, pos token.Pos, indent int,
		blankBeforeNode bool) bool {
	if cc == nil { return false }
	var any bool = false
	var prevEndLine int = 0
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		if !posLess(c.Pos, pos) { break }
		// Preserve a single blank line the source placed between two adjacent
		// comment blocks (a file header / section divider separated from the doc
		// comment that follows), collapsing 2+ blanks to one.
		if any && c.Pos.Line - prevEndLine > 1 {
			b.WriteByte('\n')
		}
		b.WriteByte('\n')
		writeIndent(b, indent)
		b.Write(c.Text)
		prevEndLine = c.End.Line
		cc.idx = cc.idx + 1
		any = true
	}
	// Preserve a blank between the last comment and the node it precedes (the
	// caller supplies the node's own separator newline; this adds the extra one
	// that makes it a blank line).  See blankBeforeNode above.
	if any && blankBeforeNode && pos.Line - prevEndLine > 1 {
		b.WriteByte('\n')
	}
	return any
}

// emitTrailingComment flushes comments on the SAME line as endPos (a
// just-emitted node's end), each as ` <text>` continuing the current line.  A
// no-op when cc is nil.
func emitTrailingComment(b @strings.Builder, cc @commentCursor, endPos token.Pos) {
	var none token.Pos
	emitTrailingCommentBefore(b, cc, endPos, none)
}

// emitTrailingCommentBefore is emitTrailingComment limited to the comments before
// limit (unless it is the zero Pos), for a node that another can follow on its
// line: the comments from there on are the next node's.
func emitTrailingCommentBefore(b @strings.Builder, cc @commentCursor, endPos token.Pos,
		limit token.Pos) {
	if cc == nil { return }
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		if c.OwnLine { break }
		if c.Pos.Line != endPos.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		b.WriteByte(' ')
		b.Write(c.Text)
		cc.idx = cc.idx + 1
	}
}

// flushRemainingComments emits every comment still pending, each on its own line
// at the given indent.  The multiset-preservation backstop (§11.3): a comment the
// position-driven interleave did not place (e.g. mid-expression) is still emitted
// rather than dropped.  A no-op when cc is nil.
func flushRemainingComments(b @strings.Builder, cc @commentCursor, indent int) {
	if cc == nil { return }
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		b.WriteByte('\n')
		writeIndent(b, indent)
		b.Write(c.Text)
		cc.idx = cc.idx + 1
	}
}
