package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseCollected parses src with a comment-collecting parser (comments retained
// in File.Comments).
func parseCollected(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.NewCollecting(toBytes(src), "t.bn")
	return p.ParseFile()
}

// commentsMultisetEqual reports whether two comment lists hold the same multiset
// of comment texts (order-independent) -- the §11.3 preservation invariant.
func commentsMultisetEqual(a @[]@token.Comment, b @[]@token.Comment) bool {
	if len(a) != len(b) { return false }
	var used @[]bool = make_slice(bool, len(b))
	for i := 0; i < len(a); i++ {
		var found bool = false
		for j := 0; j < len(b); j++ {
			if !used[j] && streq(a[i].Text, b[j].Text) {
				used[j] = true
				found = true
				break
			}
		}
		if !found { return false }
	}
	return true
}

// commentDiff builds a failure message with the input/output comment counts and
// the formatter's output.
func commentDiff(want @[]@token.Comment, got @[]@token.Comment, output *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("comment multiset differs: in=")
	writeIntC(b, len(want))
	b.Write(" out=")
	writeIntC(b, len(got))
	b.Write(" output=`")
	b.Write(output)
	b.WriteByte('`')
	return buf.CopyStr(b.String())
}

func writeIntC(b @strings.Builder, v int) {
	if v < 0 { b.WriteByte(cast(uint8, 45)); writeIntC(b, -v); return }
	if v >= 10 { writeIntC(b, v / 10) }
	b.WriteByte(cast(uint8, 48 + (v % 10)))
}

// checkComments round-trips a commented source through Format and asserts BOTH
// that the code tokens are preserved (§11.1) and that the comment multiset is
// preserved (§11.3).
func checkComments(src *[]readonly char) testing.TestResult {
	var fin @ast.File = parseCollected(src)
	var out @[]readonly char = Format(fin)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	var fout @ast.File = parseCollected(out)
	if !commentsMultisetEqual(fin.Comments, fout.Comments) {
		return commentDiff(fin.Comments, fout.Comments, out)
	}
	return ""
}

func TestCommentsDocOnDecl() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"// doc for f\n"
		"func f() int { return 1 }\n"
	return checkComments(src)
}

func TestCommentsTrailing() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() int {\n"
		"\tx := 1 // init x\n"
		"\treturn x\n"
		"}\n"
	return checkComments(src)
}

func TestCommentsOwnLineInBlock() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\t// step one\n"
		"\tg()\n"
		"\t// step two\n"
		"\th()\n"
		"}\n"
	return checkComments(src)
}

func TestCommentsDanglingEmptyBlock() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\t// nothing yet\n"
		"}\n"
	return checkComments(src)
}

func TestCommentsBlockComment() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"/* a block comment */\n"
		"func f() int {\n"
		"\treturn 1 /* trailing block */\n"
		"}\n"
	return checkComments(src)
}

func TestCommentsMultipleDecls() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"// about x\n"
		"var x int = 1\n"
		"// about f\n"
		"func f() int {\n"
		"\t// body comment\n"
		"\treturn x\n"
		"}\n"
		"// about g\n"
		"func g() {}\n"
	return checkComments(src)
}

func TestCommentsInControlFlow() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tif x > 0 {\n"
		"\t\t// then\n"
		"\t\ta()\n"
		"\t} else {\n"
		"\t\t// else\n"
		"\t\tb()\n"
		"\t}\n"
		"\tswitch x {\n"
		"\tcase 1:\n"
		"\t\t// one\n"
		"\t\tc()\n"
		"\t}\n"
		"}\n"
	return checkComments(src)
}

// An interior (mid-argument) comment on a line that is no node's end line must
// not wedge the cursor and force all later comments to the backstop.
func TestCommentsInteriorNoWedge() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tx := foo(a, // interior\n"
		"\t\tb)\n"
		"\t// later own-line\n"
		"\ty := 2\n"
		"}\n"
	return checkComments(src)
}

// A comment inside a function-literal body is preserved (placed near its source
// by the enclosing block, not dropped).
func TestCommentsFuncLitBody() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tg(func() int {\n"
		"\t\t// inside the literal\n"
		"\t\treturn 1\n"
		"\t})\n"
		"\t// after the call\n"
		"\th()\n"
		"}\n"
	return checkComments(src)
}

// A dangling comment after the last case, before the switch's closing brace.
func TestCommentsSwitchDangling() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tswitch x {\n"
		"\tcase 1:\n"
		"\t\ta()\n"
		"\t\t// dangling in switch\n"
		"\t}\n"
		"}\n"
	return checkComments(src)
}

func TestCommentsHeaderBeforePackage() testing.TestResult {
	var src *[]readonly char =
		"// Copyright header\n"
		"package \"t\"\n"
		"func f() {}\n"
	return checkComments(src)
}

// A file-leading comment does not produce a spurious leading blank line.
func TestCommentsNoLeadingBlank() testing.TestResult {
	var src *[]readonly char =
		"// Copyright header\n"
		"package \"t\"\n"
		"func f() {}\n"
	var out @[]readonly char = Format(parseCollected(src))
	if len(out) == 0 || out[0] == '\n' {
		return tokDiff("output starts with a blank line", out, "")
	}
	if !containsSub(out, "// Copyright header\npackage \"t\"") {
		return tokDiff("header comment not at file top", out, "")
	}
	return ""
}

// A doc comment before a declaration lands immediately above it.
func TestCommentsDocPlacementGolden() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"// doc for f\n"
		"func f() int { return 1 }\n"
	var out @[]readonly char = Format(parseCollected(src))
	// The output contains "// doc for f\nfunc f()" (comment immediately above).
	if !containsSub(out, "// doc for f\nfunc f() int") {
		return tokDiff("doc comment not placed above func", out, "// doc for f\\nfunc f() int")
	}
	return ""
}

// Formatting composes idempotently across comments AND preserved blank lines.
func TestCommentsIdempotentWithBlanks() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"// doc for f\n"
		"func f() {\n"
		"\ta()\n"
		"\n"
		"\t// a note\n"
		"\tb()\n"
		"}\n"
	var out1 @[]readonly char = Format(parseCollected(src))
	var out2 @[]readonly char = Format(parseCollected(out1))
	if !streq(out1, out2) {
		return tokDiff("not idempotent with comments + blanks", out1, out2)
	}
	return ""
}

// A stale interior comment must not suppress a real source blank line before the
// following statement.
func TestCommentsInteriorPreservesBlank() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tx := foo(a, // interior\n"
		"\t\tb)\n"
		"\n"
		"\ty := 2\n"
		"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, "foo(a, b)\n\n") {
		return tokDiff("source blank dropped by stale interior comment", out, "foo(a, b)<nl><nl>")
	}
	return ""
}

// containsSub reports whether haystack contains needle as a substring.
func containsSub(haystack *[]readonly char, needle *[]readonly char) bool {
	if len(needle) == 0 { return true }
	for i := 0; i + len(needle) <= len(haystack); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}
