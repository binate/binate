package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A composite literal prints the comments inside it that its element list does not
// where the source put them: between its type and its `{` (`T /* c */{1}`), and
// around a keyed element's `:` (`k /* c */: /* d */ v`).  They are claimed by
// position, as a list's are (print_listcomments.bn), so every rendering prints them
// again, each gap after what precedes it has been rendered.  The type's gap is keyed
// by the `{` (the composite's Pos), an element's by its `:`, whose position the
// parser records (elementColon), as the comments' neighbouring tokens cannot give
// it: the parser keeps no position for a value's parentheses.  Before the `{` or the
// `:`, where a line break would end the type or the key, only block comments on one
// line can stand (claimInlineGap), and those inside the type or the key that nothing
// prints go there too, the type laid out with room for them and the `{`; after the
// `:` a line comment can stand as well, and the value goes on at a continuation line,
// two tabs in from the line's.

// printCompositeType writes composite e's type, then the block comments on one line
// between it and its `{` and those inside it that nothing prints (claimAfterType),
// laying the type out with room for them and the `{` after its last line.
func printCompositeType(b @strings.Builder, e @ast.Expr) {
	if e.TypeRef == nil { return }
	var cs @[]@token.Comment = claimAfterType(e.TypeRef, e.Pos, e.Pos)
	var typeTail int = 0
	if len(cs) > 0 { typeTail = inlineCommentsWidth(cs) + 1 }
	printTypeTail(b, e.TypeRef, typeTail)
	_ = writeInlineComments(b, cs)
}

// elementColon returns the position of the `:` between a composite element's key and
// its value: that of its record (ast.File.Headers), the last record before the
// value, when it is a `:`'s that lies after the key's start; the zero Pos when there
// is none, which places no comment.
func elementColon(key @ast.Expr, value @ast.Expr) token.Pos {
	var none token.Pos
	if key == nil || value == nil { return none }
	var at token.Pos = exprStartPos(value)
	var lo int = 0
	var hi int = len(activeHeads)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(activeHeads[mid].Pos, at) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 { return none }
	var colon token.Pos = activeHeads[lo - 1].Colon
	if colon.Line == 0 || !posLess(exprStartPos(key), colon) { return none }
	return colon
}

// writeKeyColon writes keyed item it's `:` after its key, which b ends with, and the
// comments around it: the block comments on one line before it, then those after
// it and a space, or a line break to a continuation line two tabs in after one that
// needs it (writeGapSeparator).
func writeKeyColon(b @strings.Builder, it @listItem) {
	if it.colon.Line == 0 {
		b.Write(": ")
		return
	}
	_ = writeInlineComments(b, claimInlineGap(exprStartPos(it.key), it.colon, it.colon))
	b.WriteByte(':')
	var cs @[]@token.Comment = claimGap(it.colon, exprStartPos(it.x), it.colon)
	if gapCommentsWidth(cs) >= 0 {
		_ = writeInlineComments(b, cs)
		b.WriteByte(' ')
		return
	}
	writeGapSeparator(b, cs, currentLineIndent(b) + 2, false, true)
}

// keyPrefix returns what goes before keyed item it's value: its key, rendered as kt,
// and what writeKeyColon writes after it.
func keyPrefix(it @listItem, kt @[]readonly char) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(kt)
	writeKeyColon(sb, it)
	return sb.String()
}

// keyColonWidth returns the width of what writeKeyColon writes for keyed item it on
// one line, or MAX_LINE_WIDTH + 1 when a comment there needs a line break after it.
func keyColonWidth(it @listItem) int {
	var s @[]readonly char = keyPrefix(it, "")
	if hasNewline(s) { return MAX_LINE_WIDTH + 1 }
	return len(s)
}
