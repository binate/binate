package "pkg/binate/format"

import "pkg/builtins/testing"

// The comments inside a composite literal stay where the source put them: between its type
// and its `{`, and before and after a keyed element's `:`, in its last element, in an array
// literal and in a key that is a composite itself.  A line comment after the `:` puts the
// value on a continuation line two tabs in, and a comment after the `:` of a value in
// parentheses stays before the `(`.
func TestCompositeCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := T{k: /* c */ v, w: 1}\n"
			"\ty := T{k /* c */: v, w: 1}\n"
			"\tz := T{a: 1, k: /* c */ v}\n"
			"\tq := T /* c */{1}\n"
			"\ts := T{k: // c\n"
			"\t\t\tv, w: 1}\n"
			"\tu := [2]int{0: /* d */ 1, 1 /* e */: 2}\n"
			"\tg := T{k: /* c */ (a + b) * c}\n"
			"\th := T{S{n: /* i */ 1}: /* j */ 2}\n"
			"}\n"
			"\n"
			"var vv = T{\n"
			"\t\tk: /* f */ 1, // g\n"
			"\t\tm /* h */: 2}\n"
	return checkFormatGolden(src, src)
}

// A comment inside a composite literal counts in its layout: one between the type and its
// `{`, or before or after a key's `:`, makes the element list wrap where it would fit
// without it, also past the depth where lists are laid out by width alone, and one before
// the `{` makes the type wrap so that it and the `{` fit.  A comment inside a qualified type
// name goes before the `{`.
func TestCompositeCommentsCountInTheLayout() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxxxxxxxxxxxxxxxxxx := Tttttttttttt /* a comment that counts */ {aaaaaaaaaaaa"
			"a, bbbbbbbbbbbbb, cccc}\n"
			"\tyyyyyyyyyyyyyyyyyyyy := Tttttttttttt{kkkkkkkkkkkk: /* a comment that counts */"
			" aaaaaaaaaaaaaaa, b: 1}\n"
			"\tzzzzzzzzzzzzzzzzzzzz := Tttttttttttt{kkkkkkkkkkkk /* a comment that counts */ "
			": aaaaaaaaaaaaaaa, b: 1}\n"
			"\tr := p./* c */ Box[int]{1}\n"
			"\tw := T{k: /* c */ v, // d\n"
			"\t\tm: 2}\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\tx := T{T{T{T{T{T{T{T{T{T{T{T{T{T{aaaaaaaaaaaaaaaaaaaa: 1, kkkkkkkk: /* a comme"
			"nt after the colon, long enough */ vvvvvvvvvvvvvvv, wwww: 1, xxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxxxxx: 2}}}}}}}}}}}}}}\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tx := Boxxxxxxxxxxxxx[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, BBBBBBBBBBBBBBBBBBBBBBBBB"
			"BBBBBBBBBBBBBB] /* c c c c c */ {1, 2}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxxxxxxxxxxxxxxxxxx := Tttttttttttt /* a comment that counts */{aaaaaaaaaaaaa"
			", bbbbbbbbbbbbb,\n"
			"\t\t\tcccc}\n"
			"\tyyyyyyyyyyyyyyyyyyyy := Tttttttttttt{kkkkkkkkkkkk: /* a comment that counts */"
			" aaaaaaaaaaaaaaa,\n"
			"\t\t\tb: 1}\n"
			"\tzzzzzzzzzzzzzzzzzzzz := Tttttttttttt{kkkkkkkkkkkk /* a comment that counts */:"
			" aaaaaaaaaaaaaaa,\n"
			"\t\t\tb: 1}\n"
			"\tr := p.Box[int] /* c */{1}\n"
			"\tw := T{k: /* c */ v, // d\n"
			"\t\t\tm: 2}\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\tx := T{T{T{T{T{T{T{T{T{T{T{T{T{\n"
			"\t\t\tT{aaaaaaaaaaaaaaaaaaaa: 1,\n"
			"\t\t\t\t\tkkkkkkkk: /* a comment after the colon, long enough */ vvvvvvvvvvvvvvv"
			", wwww: 1,\n"
			"\t\t\t\t\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx: 2}}}}}}}}}}}}}}\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tx := Boxxxxxxxxxxxxx[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA,\n"
			"\t\t\tBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB] /* c c c c c */{1, 2}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
