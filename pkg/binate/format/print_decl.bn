package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// FormatDecl renders a top-level declaration to canonical source text.  A
// function with a body (an ordinary `.bn` func, or a generic decl) prints the
// body block; a signature-only (.bni non-generic) func has a nil Body.
func FormatDecl(d @ast.Decl) @[]readonly char {
	resetRenderCache()
	var b @strings.Builder = strings.NewBuilder()
	printDecl(b, nil, d)
	dropRenderCache()
	return b.String()
}

// printDecl appends d's leading annotation block (if any) followed by the
// declaration itself (printDeclBody).  cc (may be nil) carries comment
// interleaving into a function body's statement block.
func printDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	printDeclTail(b, cc, d, 0)
}

// printDeclTail is printDecl for a declaration followed on its last line by tail
// bytes (printDeclBodyTail).
func printDeclTail(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	if d == nil { return }
	printAnnotationsBefore(b, cc, d.Annotations, d.Pos)
	printDeclBodyTail(b, cc, d, tail)
}

// printDeclBody appends the declaration d after its annotation block, dispatching
// on d.Kind.
func printDeclBody(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	printDeclBodyTail(b, cc, d, 0)
}

// printDeclBodyTail is printDeclBody for a declaration followed on its last line by
// tail bytes (the comments after it there, printDeclBodyTrailing), which the width
// checks of a variable's or a constant's value (or of its type, when it has none),
// of a declared type, of a signature with no body and of a one-line function body
// leave room for.
func printDeclBodyTail(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	var k int = d.Kind
	if k == ast.DECL_VAR {
		b.Write("var ")
		printValueSpec(b, d, tail)
		return
	}
	if k == ast.DECL_CONST {
		b.Write("const ")
		printValueSpec(b, d, tail)
		return
	}
	if k == ast.DECL_TYPE {
		b.Write("type ")
		printTypeSpec(b, cc, d, tail)
		return
	}
	if k == ast.DECL_FUNC {
		printFuncSig(b, d, tail)
		if d.Body != nil {
			b.WriteByte(' ')
			printBlockTail(b, cc, d.Body, 0, tail)
		}
		return
	}
	if k == ast.DECL_INTERFACE { printInterfaceDecl(b, cc, d); return }
	if k == ast.DECL_IMPL { printImplDecl(b, d); return }
	if k == ast.DECL_GROUP { printGroupDecl(b, cc, d); return }
	if k == ast.DECL_EXPOSE {
		// `expose "P"` whole-package re-export (§16.5.2); Name is the raw quoted
		// path literal.  Without this case the formatter would silently DROP the
		// decl, turning a forwarder `.bni` into an empty package.
		b.Write("expose ")
		b.Write(d.Name)
		return
	}
	// A declaration kind with no case here would otherwise be dropped from the
	// output without a word.
	panic("bnfmt: printDecl has no case for this declaration kind")
}

// printTypeDef appends a type definition followed on its last line by tail bytes,
// routing a struct through the cursor-aware struct printer with the declaration's
// cursor cc (so field comments interleave), and any other type -- or a struct when
// cc is nil (a group member's), which then takes its comments through a cursor of
// its own -- through printTypeTail.
func printTypeDef(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr, tail int) {
	if te != nil && te.Kind == ast.TEXPR_STRUCT && cc != nil {
		printStructType(b, cc, te, tail)
		return
	}
	printTypeTail(b, te, tail)
}

// printValueSpec appends a var/const spec body: `Name`, then ` Type` if typed,
// then ` = Value` if initialized, followed on its last line by tail bytes.  `var x
// = e` (no type), `var x T`, `var x T = e`, and a bare grouped-const member (`B`,
// repeating iota) all follow.
func printValueSpec(b @strings.Builder, d @ast.Decl, tail int) {
	b.Write(d.Name)
	if d.TypeRef != nil {
		b.WriteByte(' ')
		var typeTail int = tail
		if d.Value != nil { typeTail = 0 }
		printTypeTail(b, d.TypeRef, typeTail)
	}
	if d.Value != nil {
		printRhsValue(b, "=", d.Value, tail)
	}
}

// printTypeSpec appends a type spec body: `Name`, optional `[type params]`, then
// the definition -- ` = T` (alias), nothing (forward decl `type X`), or ` T` /
// ` struct { ... }` (distinct / named struct) -- followed on its last line by tail
// bytes.
func printTypeSpec(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	b.Write(d.Name)
	printTypeParams(b, d.TypeParams)
	if d.IsForward { return }
	if d.IsAlias {
		b.Write(" = ")
		printTypeDef(b, cc, d.TypeRef, tail)
		return
	}
	b.WriteByte(' ')
	printTypeDef(b, cc, d.TypeRef, tail)
}

// printFuncSig appends a function/method signature (no body):
// `func [(recv)] Name[typeparams](params) results`, followed on its line by tail
// bytes when there is no body.
func printFuncSig(b @strings.Builder, d @ast.Decl, tail int) {
	b.Write("func")
	if d.Recv != nil {
		b.Write(" (")
		printParamDecl(b, d.Recv)
		b.WriteByte(')')
	}
	b.WriteByte(' ')
	b.Write(d.Name)
	printTypeParams(b, d.TypeParams)
	var after int = tail
	if d.Body != nil { after = 2 }
	printParamList(b, d.Params, d.Pos.Line, sigSuffixLen(d.Results, after))
	printResults(b, d.Results, after)
}

// printInterfaceDecl appends `interface Name[tp] [: parents] { methods }`, or the
// alias form `interface Name = Ref`.  Methods print one per tab-indented line, with
// the comments inside the interface that cc (may be nil) carries, as a struct
// type's fields do (printStructMulti): an own-line comment above the method it
// precedes, a blank line between two methods kept (one, however many), the
// comments after a method on its line after it, its signature wrapping for them
// (printMethodTrailing), and those left before the `}` on lines of their own.
func printInterfaceDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	b.Write("interface ")
	b.Write(d.Name)
	printTypeParams(b, d.TypeParams)
	if d.IsAlias {
		b.Write(" = ")
		printType(b, d.TypeRef)
		return
	}
	if len(d.Interfaces) > 0 {
		b.Write(" : ")
		printTypeExprList(b, d.Interfaces)
	}
	b.Write(" {")
	var methods @[]@ast.Decl = d.Decls
	for i := 0; i < len(methods); i++ {
		var m @ast.Decl = methods[i]
		if i > 0 && hasBlankGap(cc, methods[i - 1].End.Line, m.Pos.Line) { b.WriteByte('\n') }
		emitLeadingComments(b, cc, m.Pos, 1, true)
		b.Write("\n\t")
		var limit token.Pos = d.End
		if i + 1 < len(methods) { limit = methods[i + 1].Pos }
		printMethodTrailing(b, cc, m, limit)
		emitTrailingCommentBefore(b, cc, m.End, limit)
	}
	// The comments left before the `}`, after the last method or in an interface
	// with none.
	var dangling bool = emitLeadingComments(b, cc, d.End, 1, false)
	if len(methods) > 0 || dangling { b.WriteByte('\n') }
	b.WriteByte('}')
}

// printMethodSig appends an interface method signature `Name(params) results` --
// like a function signature but with no `func` keyword, receiver, or type
// parameters (generic methods are out of scope) -- followed on its last line by
// tail bytes.
func printMethodSig(b @strings.Builder, m @ast.Decl, tail int) {
	b.Write(m.Name)
	printParamList(b, m.Params, m.Pos.Line, sigSuffixLen(m.Results, tail))
	printResults(b, m.Results, tail)
}

// printImplDecl appends `impl RecvType : Iface1, Iface2, ...`.
func printImplDecl(b @strings.Builder, d @ast.Decl) {
	b.Write("impl ")
	printType(b, d.TypeRef)
	b.Write(" : ")
	printTypeExprList(b, d.Interfaces)
}

// printTypeParams appends a generic type-parameter list `[T any, U any]`, or
// nothing when there are none.
func printTypeParams(b @strings.Builder, tps @[]@ast.TypeParam) {
	if len(tps) == 0 { return }
	b.WriteByte('[')
	for i := 0; i < len(tps); i++ {
		if i > 0 { b.Write(", ") }
		b.Write(tps[i].Name)
		if tps[i].Constraint != nil {
			b.WriteByte(' ')
			printType(b, tps[i].Constraint)
		}
	}
	b.WriteByte(']')
}

// printParamDecl appends one parameter `Name Type`, or `Name ...Type` when
// variadic (Type is the element type as written).
func printParamDecl(b @strings.Builder, pd @ast.ParamDecl) {
	b.Write(pd.Name)
	b.WriteByte(' ')
	if pd.Variadic { b.Write("...") }
	printType(b, pd.Type)
}

// printParamList emits a parenthesized parameter list `(a A, b B)`, wrapping it
// fill-style when the source wrapped it or it would exceed the width cap.
// openerLine is the source line of the enclosing signature (the `(` line);
// suffixLen reserves room for what follows `)` on that line (the results, and a
// body-opening ` {`).
func printParamList(b @strings.Builder, params @[]@ast.ParamDecl, openerLine int, suffixLen int) {
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	for i := 0; i < len(params); i++ {
		items.Push(paramItem(params[i]))
	}
	var none token.Pos
	printStrList(b, '(', ')', items.Items(), openerLine, none, suffixLen)
}

// sigSuffixLen returns the byte width of what a signature emits after its
// parameter list's `)` on that line: the results, plus the after bytes that follow
// them (` {` when a body follows, the comments after a signature with none), or the
// results' first line when they take several (a struct type), which those do not
// follow.  Used to reserve room so the last wrapped parameter's line does not
// overflow.
func sigSuffixLen(results @[]@ast.TypeExpr, after int) int {
	var sb @strings.Builder = strings.NewBuilder()
	printResults(sb, results, 0)
	var s @[]readonly char = sb.String()
	if hasNewline(s) { return firstLineLen(s) }
	return len(s) + after
}

// printResults appends a function's result list, followed on its last line by tail
// bytes: nothing for none, ` T` for a single result (printTypeTail), ` (T1, T2)` for
// two or more (wrapped fill-style when it would exceed the width cap with the tail
// after it).
func printResults(b @strings.Builder, results @[]@ast.TypeExpr, tail int) {
	var n int = len(results)
	if n == 0 { return }
	if n == 1 {
		b.WriteByte(' ')
		printTypeTail(b, results[0], tail)
		return
	}
	b.WriteByte(' ')
	var none token.Pos
	printTypeListWrapped(b, '(', ')', results, typeStartPos(results[0]).Line, none, tail)
}

// printTypeExprList appends a comma-separated list of type expressions.
func printTypeExprList(b @strings.Builder, list @[]@ast.TypeExpr) {
	for i := 0; i < len(list); i++ {
		if i > 0 { b.Write(", ") }
		printType(b, list[i])
	}
}

// printAnnotations appends a leading annotation block followed by a newline, or
// nothing when there are no annotations.
func printAnnotations(b @strings.Builder, annots @[]@ast.Annotation) {
	if len(annots) == 0 { return }
	writeAnnotationBlock(b, annots)
	b.WriteByte('\n')
}

// printAnnotationsBefore appends the annotation block of a declaration or package
// clause whose keyword is at kw, and a newline, keeping the comments between the
// block and the keyword there: one on the line of the block's last entry trails
// it (the AST records no `]` position), the others go on their own lines below
// it.  When the keyword shares that line, the comments on it are the
// declaration's own (its trailing comment, a long-line marker), so none trails
// the block.  The comments before the block are placed by its position
// (declStartPos, or the file's Pos).
func printAnnotationsBefore(b @strings.Builder, cc @commentCursor, annots @[]@ast.Annotation,
		kw token.Pos) {
	if len(annots) == 0 { return }
	writeAnnotationBlock(b, annots)
	var last token.Pos = annots[len(annots) - 1].Pos
	if last.Line < kw.Line { emitTrailingComment(b, cc, last) }
	emitLeadingComments(b, cc, kw, 0, false)
	b.WriteByte('\n')
}

// declStartPos returns the position d starts at: its annotation block's `#`
// when it has annotations, else d.Pos -- the keyword, after the block.  An
// empty block (`#[]`) prints nothing, so the declaration starts at its keyword.
func declStartPos(d @ast.Decl) token.Pos {
	if len(d.Annotations) > 0 && d.AnnotPos.Line > 0 { return d.AnnotPos }
	return d.Pos
}

// writeAnnotationBlock appends the annotation block `#[entry, ...]`.  Each entry
// is its (dotted) name plus an optional `(args)` list.
func writeAnnotationBlock(b @strings.Builder, annots @[]@ast.Annotation) {
	b.Write("#[")
	for i := 0; i < len(annots); i++ {
		if i > 0 { b.Write(", ") }
		b.Write(annots[i].Name)
		if len(annots[i].Args) > 0 {
			b.WriteByte('(')
			printExprList(b, annots[i].Args)
			b.WriteByte(')')
		}
	}
	b.WriteByte(']')
}
