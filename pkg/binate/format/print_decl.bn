package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatDecl renders a top-level declaration to canonical source text.  A
// function with a body (an ordinary `.bn` func, or a generic decl) prints the
// body block; a signature-only (.bni non-generic) func has a nil Body.
func FormatDecl(d @ast.Decl) @[]readonly char {
	resetRenderCache()
	var b @strings.Builder = strings.NewBuilder()
	printDecl(b, nil, d)
	dropRenderCache()
	return b.String()
}

// printDecl appends d's leading annotation block (if any) followed by the
// declaration itself (printDeclBody).  cc (may be nil) carries comment
// interleaving into a function body's statement block.
func printDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	printDeclTail(b, cc, d, 0)
}

// printDeclTail is printDecl for a declaration followed on its last line by tail
// bytes (printDeclBodyTail).
func printDeclTail(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	if d == nil { return }
	printDeclAnnotations(b, cc, d)
	printDeclBodyTail(b, cc, d, tail)
}

// printDeclBody appends the declaration d after its annotation block, dispatching
// on d.Kind.
func printDeclBody(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	printDeclBodyTail(b, cc, d, 0)
}

// printDeclBodyTail is printDeclBody for a declaration followed on its last line by
// tail bytes (the comments after it there, printDeclBodyTrailing), which the width
// checks of a variable's or a constant's value (or of its type, when it has none),
// of a declared type, of a signature with no body and of a one-line function body
// leave room for.
func printDeclBodyTail(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	var k int = d.Kind
	if k == ast.DECL_VAR || k == ast.DECL_CONST {
		printSingleValueSpec(b, d, tail)
		return
	}
	if k == ast.DECL_TYPE {
		var name token.Pos = signatureOf(d.Pos).Name
		var base int = currentLineIndent(b)
		b.Write("type")
		writeOpenGap(b, d.Pos, name, name, base + 2)
		printTypeSpec(b, cc, d, tail, base)
		return
	}
	if k == ast.DECL_FUNC {
		printFuncSig(b, d, tail)
		if d.Body != nil {
			b.WriteByte(' ')
			printBlockTail(b, cc, d.Body, 0, tail)
		}
		return
	}
	if k == ast.DECL_INTERFACE { printInterfaceDecl(b, cc, d, tail); return }
	if k == ast.DECL_IMPL { printImplDecl(b, d, tail); return }
	if k == ast.DECL_GROUP { printGroupDecl(b, cc, d, d.End); return }
	if k == ast.DECL_EXPOSE {
		// `expose "P"` whole-package re-export (§16.5.2); Name is the raw quoted
		// path literal.  Without this case the formatter would silently DROP the
		// decl, turning a forwarder `.bni` into an empty package.
		b.Write("expose ")
		b.Write(d.Name)
		return
	}
	// A declaration kind with no case here would otherwise be dropped from the
	// output without a word.
	panic("bnfmt: printDecl has no case for this declaration kind")
}

// printTypeDef appends a type definition followed on its last line by tail bytes,
// routing a struct through the cursor-aware struct printer with the declaration's
// cursor cc (so field comments interleave), or, when cc is nil (a group member's),
// a cursor of its own (printStructOwn) -- its fields and `}` indented from base,
// the indent of the declaration's line, which a comment in its header can end --
// and any other type through printTypeTail.
func printTypeDef(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr, tail int, base int) {
	if te != nil && te.Kind == ast.TEXPR_STRUCT {
		if cc != nil {
			printStructType(b, cc, te, tail, base)
		} else {
			printStructOwn(b, te, tail, base)
		}
		return
	}
	printTypeTail(b, te, tail)
}

// printTypeSpec appends a type spec body: `Name`, optional `[type params]`, then
// the definition -- ` = T` (alias), nothing (forward decl `type X`), or ` T` /
// ` struct { ... }` (distinct / named struct) -- followed on its last line by tail
// bytes, a struct indented from base, the indent of the declaration's line
// (printTypeDef).  The comments in its type-parameter list, the block comments on
// one line before that list and before a definition that is not an alias, and those
// around an alias's `=` go where the source put them, claimed as a signature's are
// (print_sig.bn), with its name's position as their key: before the `=`, after a name
// or a `]`, only block comments on one line can stand, and after it a line comment
// can, the type going on at a continuation line.  The syntax tree has no position for
// the `=`: the comments right after the token before it are those before it.
func printTypeSpec(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int, base int) {
	var rec @ast.Signature = signatureOf(d.Pos)
	b.Write(d.Name)
	var lo token.Pos = rec.Name
	if len(d.TypeParams) > 0 {
		if writeInlineComments(b, claimInlineGap(rec.Name, rec.TypeOpen, rec.Name)) { b.WriteByte(' ') }
		printSigTypeParams(b, d.TypeParams, rec, currentLineIndent(b) + 2)
		lo = rec.TypeClose
	}
	if d.IsForward { return }
	if d.IsAlias {
		var before @[]@token.Comment
		var after @[]@token.Comment
		before, after = splitAfter(claimGap(lo, typeStartPos(d.TypeRef), rec.Name), lo)
		_ = writeInlineComments(b, before)
		b.Write(" =")
		writeGapSeparator(b, after, currentLineIndent(b) + 2, false, true)
		printTypeDef(b, cc, d.TypeRef, tail, base)
		return
	}
	_ = writeInlineComments(b, claimInlineGap(lo, typeStartPos(d.TypeRef), rec.Name))
	b.WriteByte(' ')
	printTypeDef(b, cc, d.TypeRef, tail, base)
}

// printInterfaceDecl appends `interface Name[tp] [: parents] { methods }`, or the
// alias form `interface Name = Ref` followed on its last line by tail bytes, with
// the comments in its header where the source put them (printInterfaceHeader).
// Methods print one per tab-indented line, with
// the comments inside the interface that cc (may be nil) carries, as a struct
// type's fields do (printStructMulti): an own-line comment above the method it
// precedes, a blank line between two methods kept (one, however many), the
// comments after a method on its line after it, its signature wrapping for them,
// or kept whole on a `// LONG-LINE ALLOWED` line (printMethodTrailing), and those
// left before the `}` on lines of their own.  A marked line keeps the methods
// `;`-joined on it as written (markedMethodRunEnd, printMarkedMethods); one that
// cannot be kept prints one method per line, unmarked but for the last.
func printInterfaceDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl, tail int) {
	if !printInterfaceHeader(b, d, tail) { return }
	var methods @[]@ast.Decl = d.Decls
	// The methods before split are those of a marked line that could not be kept.
	var split int = 0
	var i int = 0
	for i < len(methods) {
		var m @ast.Decl = methods[i]
		if i > 0 && hasBlankGap(cc, methods[i - 1].End.Line, m.Pos.Line) { b.WriteByte('\n') }
		emitLeadingComments(b, cc, m.Pos, 1, true)
		b.Write("\n\t")
		var end int = i + 1
		if i >= split { end = markedMethodRunEnd(cc, d, i) }
		if end == i + 1 || !printMarkedMethods(b, cc, d, i, end) {
			if end > i + 1 { split = end }
			end = i + 1
			printMethodTrailing(b, cc, m, methodLimit(d, i))
		}
		emitTrailingCommentBefore(b, cc, methods[end - 1].End, methodLimit(d, end - 1))
		i = end
	}
	// The comments left before the `}`, after the last method or in an interface
	// with none.
	var dangling bool = emitLeadingComments(b, cc, d.End, 1, false)
	if len(methods) > 0 || dangling { b.WriteByte('\n') }
	b.WriteByte('}')
}

// methodLimit returns where method k of interface d ends: the next method's
// position, or the interface's end.
func methodLimit(d @ast.Decl, k int) token.Pos {
	if k + 1 < len(d.Decls) { return d.Decls[k + 1].Pos }
	return d.End
}

// sigSuffixLen returns the byte width of what a function type emits after its
// parameter list's `)` on that line, the list's `)` landing at column least at the
// least (closeLeast): the results, plus the after bytes that follow them (what follows
// the type), measured as the comment below says.  Used to reserve room so the last
// wrapped parameter's line does not overflow.  A function's signature measures its
// own (sigTailLen).  open is the results' `(`, as for printResults.
func sigSuffixLen(results @[]@ast.TypeExpr, open token.Pos, after int, least int) int {
	if len(results) == 0 { return after }
	var saved bool = wrapSuppressed
	var savedOne bool = structsOneLine
	wrapSuppressed = true
	structsOneLine = true
	var s @[]readonly char = resultsAt(results, open, 0, 0, 0)
	wrapSuppressed = saved
	structsOneLine = savedOne
	if hasNewline(s) { return firstLineLen(resultsAt(results, open, 0, 0, 0)) }
	if resultsFollowClose(len(s) + after, least) { return len(s) + after }
	return firstLineLen(resultsAt(results, open, MAX_LINE_WIDTH, 0, after))
}

// A parameter list leaves room after its `)` for the results, and for what follows
// them on their line (sigSuffixLen, sigTailLen).  Results that make one line with
// wrapping suppressed -- as the source wraps them or not, and, a function type's, with
// the structs in them on one line (structsOneLine), so that a second format, which
// reads them as the first printed them, leaves the room the first did -- get
// room for that line and what follows them when they can follow the `)` where it
// lands at the least (closeLeast, resultsFollowClose).  Results too wide for that wrap
// wherever the `)` lands, and get room for the first line they then take, rendered
// from the width cap's column, where each list in them leaves its opener alone.  And
// results that span lines even so (a struct type, a line comment) get room for their
// first line as the source wraps them, which what follows does not follow.

// resultsFollowClose reports whether w bytes of results, and what follows them, can
// follow a parameter list's `)` on its line when the `)` lands at column least.
func resultsFollowClose(w int, least int) bool {
	return least + 1 + w <= MAX_LINE_WIDTH
}

// closeLeast returns the leftmost column a parameter list's `)` lands at, for a list
// continued at column cont whose last entry renders, with wrapping suppressed, as
// last: right after it at cont when it is one line and cannot break (unbreakable), as
// it then goes on its line whole; else at cont, after a last line of that entry
// there.
func closeLeast(cont int, last *[]readonly char, unbreakable bool) int {
	if !unbreakable || hasNewline(last) { return cont }
	return cont + len(last)
}

// paramsCloseLeast is closeLeast for a signature's parameters, params.
func paramsCloseLeast(params @[]@ast.ParamDecl, cont int) int {
	if len(params) == 0 { return cont }
	var p @ast.ParamDecl = params[len(params) - 1]
	if p.Type == nil || !typeUnbreakable(p.Type) { return cont }
	var saved bool = wrapSuppressed
	wrapSuppressed = true
	var sb @strings.Builder = strings.NewBuilder()
	printParamDecl(sb, p, 0)
	wrapSuppressed = saved
	return closeLeast(cont, sb.String(), true)
}

// typesCloseLeast is closeLeast for function type te's parameter types.
func typesCloseLeast(te @ast.TypeExpr, cont int) int {
	var n int = len(te.ParamTypes)
	if n == 0 || !typeUnbreakable(te.ParamTypes[n - 1]) { return cont }
	var saved bool = wrapSuppressed
	wrapSuppressed = true
	var sb @strings.Builder = strings.NewBuilder()
	if te.VariadicParams { sb.Write("...") }
	printType(sb, te.ParamTypes[n - 1])
	wrapSuppressed = saved
	return closeLeast(cont, sb.String(), true)
}

// printResults appends a function type's result list, followed on its last line by
// tail bytes: nothing for none, ` T` for a single result (printTypeTail), and ` (T1,
// T2)` for two or more (wrapped fill-style when it would exceed the width cap with
// the tail after it), with the comments after their `(`, at open, and before their
// `)`, as a list's.  open is the zero Pos when unknown, or, for a single result, when
// its parentheses go; a single result that keeps them (keepsResultParens: a comment
// follows its `(`) prints as a list of one, ` (T)`.  A function's signature prints its
// own (printSigResults).
func printResults(b @strings.Builder, results @[]@ast.TypeExpr, open token.Pos, tail int) {
	var n int = len(results)
	if n == 0 { return }
	if n == 1 && open.Line == 0 {
		b.WriteByte(' ')
		printTypeTail(b, results[0], tail)
		return
	}
	b.WriteByte(' ')
	printTypeListWrapped(b, '(', ')', results, typeStartPos(results[0]).Line, open, false, tail)
}

// declStartPos returns the position d starts at: its annotation block's `#` when it
// has one, else d.Pos -- its keyword.  An empty block (`#[]`) prints nothing, but its
// lines are still the declaration's: a doc comment above it stays against the
// declaration, and a comment after its `#` is the declaration's, not the trailing
// comment of what precedes it.
func declStartPos(d @ast.Decl) token.Pos {
	if d.AnnotPos.Line > 0 { return d.AnnotPos }
	return d.Pos
}
