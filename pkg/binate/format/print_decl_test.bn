package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseDeclSrc parses a single top-level declaration (wrapped in a minimal .bni
// package) and returns it.  Interface mode (NewInterface) so function decls are
// signature-only (no body) -- the body printer is a later step.
func parseDeclSrc(src *[]readonly char) @ast.Decl {
	var full @strings.Builder = strings.NewBuilder()
	full.Write("package \"t\"\n")
	full.Write(src)
	full.WriteByte('\n')
	var p @parser.Parser = parser.NewInterface(toBytes(full.String()), "t.bni")
	var f @ast.File = p.ParseFile()
	if len(f.Decls) == 0 { return nil }
	return f.Decls[0]
}

// checkDecl round-trips a declaration through FormatDecl and asserts
// token-equality (§11.1).
func checkDecl(src *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil {
		return tokDiff("parse produced no decl", src, "")
	}
	var out @[]readonly char = FormatDecl(d)
	return assertTokenEq(src, out)
}

// checkDeclGolden asserts FormatDecl(parse(src)) equals want exactly -- for
// canonicalizations (e.g. a single-member var/type group collapsing) that
// reorder tokens and so are out of the token gate's scope.
func checkDeclGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil {
		return tokDiff("parse produced no decl", src, "")
	}
	var out @[]readonly char = FormatDecl(d)
	if !streq(out, want) {
		return tokDiff("decl format mismatch", out, want)
	}
	return ""
}

func TestFormatVarDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("var x int")
	if len(r) > 0 { return r }
	r = checkDecl("var x int = 5")
	if len(r) > 0 { return r }
	r = checkDecl("var x = 5")
	if len(r) > 0 { return r }
	r = checkDecl("var p *Foo")
	if len(r) > 0 { return r }
	r = checkDecl("var s @[]char = nil")
	if len(r) > 0 { return r }
	r = checkDecl("var x readonly int")
	if len(r) > 0 { return r }
	r = checkDecl("var cb *func(...int)")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatConstDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("const N int = 10")
	if len(r) > 0 { return r }
	r = checkDecl("const Pi = 3.14")
	if len(r) > 0 { return r }
	r = checkDecl("const M pkg.Size = 1")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatTypeDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("type Point struct { x int; y int }")
	if len(r) > 0 { return r }
	r = checkDecl("type Id = int")
	if len(r) > 0 { return r }
	r = checkDecl("type Handle *Node")
	if len(r) > 0 { return r }
	r = checkDecl("type Opaque")
	if len(r) > 0 { return r }
	r = checkDecl("type List[T any] struct { head @Node }")
	if len(r) > 0 { return r }
	// Distinct type over an array (D11 disambiguation: not a type-param list).
	r = checkDecl("type Row [3]int")
	if len(r) > 0 { return r }
	// Non-`any` type-param constraint, and a generic alias.
	r = checkDecl("type Sorted[T Orderable] struct { x int }")
	if len(r) > 0 { return r }
	r = checkDecl("type L[T any] = Vec[T]")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatFuncSig() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("func f(x int) int")
	if len(r) > 0 { return r }
	r = checkDecl("func g()")
	if len(r) > 0 { return r }
	r = checkDecl("func h(a int, b int) (int, error)")
	if len(r) > 0 { return r }
	r = checkDecl("func (r *T) Method(x int) bool")
	if len(r) > 0 { return r }
	r = checkDecl("func v(xs ...int) int")
	if len(r) > 0 { return r }
	// Fixed param(s) followed by a variadic (the common shape).
	r = checkDecl("func printf(fmt @[]char, args ...int) int")
	if len(r) > 0 { return r }
	// A variadic function-value type as a parameter.
	r = checkDecl("func apply(cb *func(...int)) int")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatInterfaceDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("interface Stringer { String() @[]char }")
	if len(r) > 0 { return r }
	r = checkDecl("interface Reader { Read(p *[]uint8) (int, error) }")
	if len(r) > 0 { return r }
	r = checkDecl("interface Empty {}")
	if len(r) > 0 { return r }
	r = checkDecl("interface S = Stringer")
	if len(r) > 0 { return r }
	r = checkDecl("interface RW : Reader, Writer { Close() bool }")
	if len(r) > 0 { return r }
	// Generic interface; extension with an empty body; a zero-result and a
	// two-result method together; a qualified alias target.
	r = checkDecl("interface Container[T any] { Get() T }")
	if len(r) > 0 { return r }
	r = checkDecl("interface Marker : Base {}")
	if len(r) > 0 { return r }
	r = checkDecl("interface I { Reset(); At(i int) (int, bool) }")
	if len(r) > 0 { return r }
	r = checkDecl("interface S2 = pkg.Stringer")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatImplDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("impl *Foo : Stringer")
	if len(r) > 0 { return r }
	r = checkDecl("impl @Bar : Reader, Writer")
	if len(r) > 0 { return r }
	// Qualified and generic-instantiated interface refs.
	r = checkDecl("impl *Foo : pkg.Iface")
	if len(r) > 0 { return r }
	r = checkDecl("impl @Bar : Container[int]")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatGroupDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("var ( a int; b int )")
	if len(r) > 0 { return r }
	r = checkDecl("const ( A int = 1; B int = 2 )")
	if len(r) > 0 { return r }
	r = checkDecl("type ( X int; Y struct { z int } )")
	if len(r) > 0 { return r }
	// A single-member var/type group collapses to a bare decl (parser-level);
	// a single-member const group stays a group (iota).
	r = checkDeclGolden("var ( x int )", "var x int")
	if len(r) > 0 { return r }
	r = checkDeclGolden("const ( X int = iota )", "const (\n\tX int = iota\n)")
	if len(r) > 0 { return r }
	// A grouped const with a bare repeating-iota member (neither type nor value).
	r = checkDecl("const ( A int = iota; B; C )")
	if len(r) > 0 { return r }
	// An empty group carries no keyword in the AST and declares nothing, so it
	// is dropped.
	r = checkDeclGolden("const ( )", "")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatAnnotatedDecl() testing.TestResult {
	var r testing.TestResult
	r = checkDecl("#[inline] var x int")
	if len(r) > 0 { return r }
	r = checkDecl("#[build(is(os, \"linux\"))] func f() int")
	if len(r) > 0 { return r }
	// Multiple entries in one block, mixing args and no-args.
	r = checkDecl("#[inline, cold] var y int")
	if len(r) > 0 { return r }
	r = checkDecl("#[build(is(os, \"linux\")), inline] func g() int")
	if len(r) > 0 { return r }
	// An empty-paren entry `foo()` canonicalizes to `foo` (the parser discards
	// the empty parens).
	r = checkDeclGolden("#[foo()] var z int", "#[foo]\nvar z int")
	if len(r) > 0 { return r }
	return ""
}

// A single parenthesized result canonicalizes to the unparenthesized form (the
// parser records no paren memory for a length-1 result list).
func TestFormatSingleParenResult() testing.TestResult {
	return checkDeclGolden("func f() (int)", "func f() int")
}

// parseIfaceFile parses a whole .bni file (signature-only funcs).
func parseIfaceFile(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.NewInterface(toBytes(src), "t.bni")
	return p.ParseFile()
}

// TestFormatIfaceFile round-trips a whole interface file (package + imports +
// declarations, including a group, an impl, and a per-decl annotation) through
// Format.
func TestFormatIfaceFile() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"import \"pkg/x\"\n"
			"\n"
			"type Point struct { x int; y int }\n"
			"\n"
			"var ( a int; b int )\n"
			"\n"
			"impl *Point : Stringer\n"
			"\n"
			"#[inline] func F(p @Point) int\n"
			"\n"
			"interface Stringer { String() @[]char }\n"
	var out @[]readonly char = Format(parseIfaceFile(src))
	return assertTokenEq(src, out)
}

// TestFormatPackageAnnotation round-trips a file whose package clause carries an
// annotation block (File.Annotations, emitted before `package`).
func TestFormatPackageAnnotation() testing.TestResult {
	var src *[]readonly char = "#[build(is(os, \"linux\"))] package \"t\"\n"
			"\n"
			"func F() int\n"
	var out @[]readonly char = Format(parseIfaceFile(src))
	return assertTokenEq(src, out)
}
