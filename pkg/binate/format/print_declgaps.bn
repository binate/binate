package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A var or const declaration prints the comments inside it that no expression or
// type in it prints where the source put them: after its keyword (`var /* c */ x`,
// `var // c` / `x int`), between its name and its type, before its `=` (`x int /* c
// */ = 1`) and after it (`x = // c` / `1`).  They are claimed by position, as a
// statement's are (print_stmtgaps.bn), keyed by the declaration's Pos -- its
// keyword's, or a group member's name's -- with the positions of its name and its
// `=` from the parser's record of the spec (ast.File.Headers); those before the `=`
// take the ones inside the type that no list in it prints.  Before the type and
// before `=`, where a line break would end the declaration, only block comments on
// one line can stand (claimInlineGap); after the keyword and after `=` a line comment
// can too, and what follows goes on at a continuation line: two tabs in after the
// keyword, as after a type declaration's, and one tab in after `=`, as a statement's
// value does.

// printSingleValueSpec appends a var or const declaration that is no group's
// member, its keyword and its spec (printValueSpec), followed on its last line by
// tail bytes.
func printSingleValueSpec(b @strings.Builder, d @ast.Decl, tail int) {
	if d.Kind == ast.DECL_VAR {
		b.Write("var")
	} else {
		b.Write("const")
	}
	writeOpenGap(b, d.Pos, headerOf(d.Pos).Binder, d.Pos, currentLineIndent(b) + 2)
	printValueSpec(b, d, tail)
}

// printValueSpec appends a var/const spec body: `Name`, then ` Type` if typed,
// then ` = Value` if initialized, followed on its last line by tail bytes, with the
// comments after its name, before its `=` (which its type leaves room for, with the
// ` =` after them) and after it.  `var x = e` (no type), `var x T`, `var x T = e`,
// and a bare grouped-const member (`B`, repeating iota) all follow.
func printValueSpec(b @strings.Builder, d @ast.Decl, tail int) {
	var rec @ast.Header = headerOf(d.Pos)
	b.Write(d.Name)
	if d.TypeRef == nil {
		if d.Value != nil {
			_ = writeInlineComments(b, claimInlineGap(rec.Binder, rec.Assign, d.Pos))
		}
	} else {
		_ = writeInlineComments(b, claimInlineGap(rec.Binder, typeStartPos(d.TypeRef), d.Pos))
		b.WriteByte(' ')
		if d.Value == nil {
			printTypeTail(b, d.TypeRef, tail)
		} else {
			var cs @[]@token.Comment = claimAfterType(d.TypeRef, rec.Assign, d.Pos)
			var typeTail int = 0
			if len(cs) > 0 { typeTail = inlineCommentsWidth(cs) + 2 }
			printTypeTail(b, d.TypeRef, typeTail)
			_ = writeInlineComments(b, cs)
		}
	}
	if d.Value != nil {
		printRhsWith(b, "=", claimGap(rec.Assign, exprStartPos(d.Value), d.Pos), d.Value, tail)
	}
}

// claimAfterType is claimAfterExpr for type te: the block comments on one line from
// its start to hi, after it and inside it where no list prints them, with te
// rendered first when a comment lies there, so that a list in it claims its own.
func claimAfterType(te @ast.TypeExpr, hi token.Pos, key token.Pos) @[]@token.Comment {
	var lo token.Pos = typeStartPos(te)
	if pendingWithin(lo, hi) {
		var scratch @strings.Builder = strings.NewBuilder()
		printType(scratch, te)
	}
	return claimInlineGap(lo, hi, key)
}
