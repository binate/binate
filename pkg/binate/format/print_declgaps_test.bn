package "pkg/binate/format"

import "pkg/builtins/testing"

// The comments inside a var or const declaration stay where the source put them: after its
// keyword, after its name, before its `=` and after it, in a function's body and in a group's
// member too, and after the `=` before a parenthesized value.  A line comment after the
// keyword continues the declaration two tabs in, and one after `=` puts the value on a
// continuation line one tab in.  A group's member keeps the comment between its name and a
// struct type in place, so its trailing comments align alike on every format.
func TestDeclCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var /* a */ x /* b */ int /* c */ = /* d */ 1 // e\n"
			"\n"
			"var y /* f */ = 2\n"
			"\n"
			"const z /* g */ int = 3\n"
			"\n"
			"var w = // h\n"
			"\t4\n"
			"\n"
			"var // i\n"
			"\t\tv int\n"
			"\n"
			"func f() {\n"
			"\tvar p /* j */ int = -/* k */ q // l\n"
			"\tvar r = /* m */ s\n"
			"\tconst t /* n */ = 1\n"
			"\tvar mid int = /* v */ (lo + hi) / 2\n"
			"\tvar q = // w\n"
			"\t\t(a + b) * c\n"
			"}\n"
			"\n"
			"var (\n"
			"\tm1 /* o */ int = 1   // p\n"
			"\tm22 int /* q */ = 22 // r\n"
			"\tm3 = /* s */ 3\n"
			")\n"
			"\n"
			"var (\n"
			"\tvs /* t */ struct {\n"
			"\t\ta int\n"
			"\t}\n"
			"\tvt int // u\n"
			")\n"
	return checkFormatGolden(src, src)
}

// A comment inside a declaration counts in its layout: one before `=` or after it makes the
// value wrap where it would otherwise fit, one too wide for the line with the value puts the
// value on a continuation line, and one before `=` makes a long type wrap to leave room for it
// and the ` =`.  A group's members' trailing comments align after the widest member with the
// comments inside it, on a `// LONG-LINE ALLOWED` line too.
func TestDeclCommentsCountInTheLayout() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar x int /* a comment that counts */ = ffffffffffff(aaaaaaaaaaaaaaa, bbbbbbbb"
			"bbbbbbbbbbbbbb, cc) // d\n"
			"\tvar y = /* a comment after the operator that counts */ gggggggggggggggggg(aaaa"
			"aaaaaaaaaaa, bb) // e\n"
			"\tvar zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz int = /* a comment too wide for the line "
			"with the value */ hhhh(a)\n"
			"}\n"
			"\n"
			"var (\n"
			"\ta /* f */ int = 1 // g\n"
			"\tbbbbbbbbbb int = 2 // h\n"
			")\n"
			"\n"
			"var y *func(Aaaaaaaaaaaaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, Cccc"
			"cccccc) int /* i */ = nil\n"
			"\n"
			"var (\n"
			"\ta = 1; bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* j */ = 2 "
			"// LONG-LINE ALLOWED\n"
			"\tx = 1 // k\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar x int /* a comment that counts */ = ffffffffffff(aaaaaaaaaaaaaaa, bbbbbbbb"
			"bbbbbbbbbbbbbb,\n"
			"\t\t\tcc) // d\n"
			"\tvar y = /* a comment after the operator that counts */ gggggggggggggggggg(aaaa"
			"aaaaaaaaaaa, bb) // e\n"
			"\tvar zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz int = /* a comment too wide for the line "
			"with the value */\n"
			"\t\thhhh(a)\n"
			"}\n"
			"\n"
			"var (\n"
			"\ta /* f */ int = 1  // g\n"
			"\tbbbbbbbbbb int = 2 // h\n"
			")\n"
			"\n"
			"var y *func(Aaaaaaaaaaaaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\tCccccccccc) int /* i */ = nil\n"
			"\n"
			"var (\n"
			"\ta = 1; bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* j */ = 2 "
			"// LONG-LINE ALLOWED\n"
			"\tx = 1                                                                         "
			"// k\n"
			")\n"
	return checkFormatGolden(src, want)
}
