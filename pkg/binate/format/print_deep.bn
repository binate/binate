package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/cmp"
import "pkg/std/containers/table"
import "pkg/std/hash"

// A fill decision whose layouts span lines is checked against a second format
// (fitsStably, print_stable.bn): the element's layout is read back and rendered at
// its two places, and the decisions in that rendering read their own elements back
// in turn.  A layout read back at a new place is new source, so the readings back
// multiply with the depth of nested lists, and the time with them.  Past
// STABLE_LIST_DEPTH nested lists the printer lays out by width alone: a list there
// ignores its source's breaks (an opener alone, elements on several lines), and so do
// the operator chains and string runs directly in its elements (deepList).  Such an
// element renders the same at a place whatever breaks its source has -- a first
// format and a second, reading the first's output, lay it out alike -- so its fill
// decisions need no check, and the readings back stop at that depth.  And there an
// element stays on its line only when its one-line form fits there, else it moves to
// a continuation line (deepFits): measured by that form, which is the same wherever
// it goes, an element is laid out at one place, not at each place every enclosing
// fill could put it.  An element holding a function literal, or a struct or
// function type, keeps the check and the measure (holdsBlock): a block's layout
// follows its source.

// STABLE_LIST_DEPTH is the depth of nested lists past which the printer lays out by
// width alone; written code nests far less deep.
const STABLE_LIST_DEPTH int = 12

// listDepth is the number of lists whose elements are being printed or measured.
var listDepth int

// deepList reports whether the elements being printed are in lists nested past
// STABLE_LIST_DEPTH, which lay out by width alone.
func deepList() bool {
	return listDepth > STABLE_LIST_DEPTH
}

// layOutByWidth makes the printer lay out by width alone, as past STABLE_LIST_DEPTH
// nested lists, and returns the listDepth to restore after.  A slice's head measures
// its bounds so (boundShare): the breaks in their source, which a format can add or
// remove -- a string run's split, a list's opener alone -- then do not change the
// measure, and a second format measures what the first printed as the first did.
func layOutByWidth() int {
	var saved int = listDepth
	if listDepth <= STABLE_LIST_DEPTH { listDepth = STABLE_LIST_DEPTH + 1 }
	return saved
}

// depthKey returns listDepth for a rendering's key, as one past STABLE_LIST_DEPTH
// once past it: a rendering depends on where in it the lists pass that depth.
func depthKey() int {
	if listDepth > STABLE_LIST_DEPTH + 1 { return STABLE_LIST_DEPTH + 1 }
	return listDepth
}

// deepFits reports whether element e, after prefix bytes of a key and what follows
// it (keyColonWidth), stays on its line from column here with tail bytes after it,
// in a list past STABLE_LIST_DEPTH: whether its one-line form fits there
// (flatWidth).
func deepFits(e @ast.Expr, prefix int, here int, tail int) bool {
	return here + prefix + flatWidth(e) + tail <= MAX_LINE_WIDTH
}

// flatWidth returns the width of e's one-line form, rendered with wrapping
// suppressed (a run of strings merged), or one past the width cap when that spans
// lines (a line comment in it).
func flatWidth(e @ast.Expr) int {
	var saved bool = wrapSuppressed
	wrapSuppressed = true
	var s @[]readonly char = renderAt(e, 0, 0, 0)
	wrapSuppressed = saved
	if hasNewline(s) { return MAX_LINE_WIDTH + 1 }
	return len(s)
}

// deepFlatList reports whether a list of elems past STABLE_LIST_DEPTH decides whether
// it fits on one line by its elements' one-line forms and the comments between them
// (argsFlatWidth): rendering each at its column there would render it again at the
// column of every enclosing list's one-line form.
func deepFlatList(elems *[]@ast.Expr) bool {
	if !deepList() { return false }
	for i := 0; i < len(elems); i++ {
		if holdsBlock(elems[i]) { return false }
	}
	return true
}

// argsFlatWidth returns the width of elems' one-line forms joined by `, `, with the
// comments after their list's opener (at opener) and between them, or
// MAX_LINE_WIDTH + 1 when one of those needs a line break after it.
func argsFlatWidth(elems *[]@ast.Expr, opener token.Pos) int {
	var w int = 2 * (len(elems) - 1)
	var key token.Pos = exprStartPos(elems[0])
	var lo token.Pos = opener
	for i := 0; i < len(elems); i++ {
		var start token.Pos = exprStartPos(elems[i])
		var cw int = gapCommentsWidth(claimGap(lo, start, key))
		if cw < 0 { return MAX_LINE_WIDTH + 1 }
		w = w + cw + flatWidth(elems[i])
		lo = start
	}
	return w
}

// blockHolders keeps holdsBlock's answer for each node asked about in the formatting
// under way.  Past STABLE_LIST_DEPTH an element is asked about at each of its
// renderings, and again by each list around it (deepFlatList), so walking its
// subtree for every question would cost its depth again each time.
var blockHolders @table.Table[@ast.Expr, bool, exprHasher, exprEq]

// blockWalks counts the nodes holdsBlock has walked, not answered from blockHolders.
var blockWalks int

// dropBlockHolders forgets holdsBlock's answers, and the nodes they hold, for a new
// formatting or after one.
func dropBlockHolders() {
	var none @table.Table[@ast.Expr, bool, exprHasher, exprEq]
	blockHolders = none
}

// holdsBlock reports whether e holds a function literal or a struct or function
// type, whose layout follows its source's breaks.  The answer is kept per node
// (blockHolders), and e's children are asked through holdsBlock, so each node is
// walked once.
func holdsBlock(e @ast.Expr) bool {
	if e == nil { return false }
	if blockHolders == nil {
		blockHolders = table.NewTable[@ast.Expr, bool, exprHasher, exprEq](exprHasher{}, exprEq{})
	}
	var holds bool
	var ok bool
	holds, ok = blockHolders.Get(e)
	if ok { return holds }
	blockWalks = blockWalks + 1
	holds = walkHoldsBlock(e)
	blockHolders.Put(e, holds)
	return holds
}

// walkHoldsBlock is holdsBlock for a node not yet answered: the node itself, then
// its children.
func walkHoldsBlock(e @ast.Expr) bool {
	if e.Kind == ast.EXPR_FUNC_LIT { return true }
	if holdsBlock(e.X) || holdsBlock(e.Y) || holdsBlock(e.Z) { return true }
	for i := 0; i < len(e.Args); i++ {
		if holdsBlock(e.Args[i]) { return true }
	}
	for i := 0; i < len(e.Elems); i++ {
		if holdsBlock(e.Elems[i].Key) || holdsBlock(e.Elems[i].Value) { return true }
	}
	return typeHoldsBlock(e.TypeRef)
}

// typeHoldsBlock is holdsBlock for a type expression: a struct or function type, or
// one holding either.
func typeHoldsBlock(t @ast.TypeExpr) bool {
	if t == nil { return false }
	if t.Kind == ast.TEXPR_STRUCT || t.Kind == ast.TEXPR_FUNC_VALUE ||
			t.Kind == ast.TEXPR_MANAGED_FUNC_VALUE || len(t.Fields) > 0 {
		return true
	}
	if typeHoldsBlock(t.Base) || holdsBlock(t.Len) { return true }
	return typesHoldBlock(t.ParamTypes) || typesHoldBlock(t.ResultTypes) || typesHoldBlock(t.TypeArgs)
}

// typesHoldBlock reports whether any of ts holds a block (typeHoldsBlock).
func typesHoldBlock(ts *[]@ast.TypeExpr) bool {
	for i := 0; i < len(ts); i++ {
		if typeHoldsBlock(ts[i]) { return true }
	}
	return false
}

// exprHasher hashes an expression node by its address, for blockHolders, which holds
// the node, so no other takes the address while its entry lasts.  A node's kind and
// position do not tell it apart: each text read back is parsed as `var _ = (text)`
// (rereadExpr), so the nodes on its first line sit where those of every other do.
type exprHasher struct {}

// Hash mixes e's address.
func (h exprHasher) Hash(e @ast.Expr) uint {
	var p uint = bit_cast(uint, bit_cast(*uint8, e))
	return p ^ (p >> 7)
}

impl exprHasher : hash.Hasher[@ast.Expr]

// exprEq is the identity equality paired with exprHasher.
type exprEq struct {}

// Equal reports whether a and b are the same node.
func (q exprEq) Equal(a @ast.Expr, b @ast.Expr) bool {
	return same(a, b)
}

impl exprEq : cmp.Eq[@ast.Expr]
