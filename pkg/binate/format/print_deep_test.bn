package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Past STABLE_LIST_DEPTH nested lists the printer lays out by width alone: a string run
// the source split across lines is written as one literal, an operator chain the source
// wrapped joins its line, and a list the source wrapped keeps its elements on its line,
// where they fit; at STABLE_LIST_DEPTH lists deep, the source's breaks stay.
func TestDeepListIgnoresSourceBreaks() testing.TestResult {
	var deep *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_ = f(f(f(f(f(f(f(f(f(f(f(f(f(\"aa\"\n"
			"\"bb\", a +\n"
			"b)))))))))))))\n"
			"}\n"
	var deepWant *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_ = f(f(f(f(f(f(f(f(f(f(f(f(f(\"aabb\", a + b)))))))))))))\n"
			"}\n"
	var r testing.TestResult = checkGolden(deep, deepWant)
	if len(r) > 0 { return r }
	r = checkGolden(deepWant, deepWant)
	if len(r) > 0 { return r }
	var atCap *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_ = f(f(f(f(f(f(f(f(f(f(f(f(\"aa\"\n"
			"\"bb\", a +\n"
			"b))))))))))))\n"
			"}\n"
	var atCapWant *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_ = f(f(f(f(f(f(f(f(f(f(f(f(\n"
			"\t\t\t\"aa\"\n"
			"\t\t\t\t\t\"bb\",\n"
			"\t\t\ta + b))))))))))))\n"
			"}\n"
	r = checkGolden(atCap, atCapWant)
	if len(r) > 0 { return r }
	return checkGolden(atCapWant, atCapWant)
}

// Past STABLE_LIST_DEPTH an element's fill is decided by its one-line form, and its
// layout is not read back: formatting calls nested 40 deep makes about 2.7 times the
// renderings of 32 deep, where reading the layouts back at every depth made them grow
// about 1.45 times a level (about 20 times over 8 levels).
func TestDeepListRendersGrowSlowly() testing.TestResult {
	var r32 int = rendersOf(deepCalls(32))
	var r40 int = rendersOf(deepCalls(40))
	if r40 <= 4 * r32 { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("renderings: calls 32 deep ")
	sb.Write(strconv.Itoa(r32))
	sb.Write(", 40 deep ")
	sb.Write(strconv.Itoa(r40))
	sb.Write(" (bound 4 times)")
	return buf.CopyStr(sb.String())
}

// holdsBlock finds a function literal, or a struct or function type, anywhere in an
// expression: an element holding one keeps the stability check past STABLE_LIST_DEPTH.
func TestDeepHoldsBlock() testing.TestResult {
	var f @ast.File = parseFileSrc(
			"package \"p\"\n\nvar a = f(g(1), h(x)[0])\n"
					"var b = f(g(func() {}))\nvar c = f(cast(struct{ x int }, y))\n"
					"var d = f(S[*func()]{})\n")
	if holdsBlock(f.Decls[0].Value) { return "f(g(1), h(x)[0]) holds no block" }
	if !holdsBlock(f.Decls[1].Value) { return "a function literal in an argument is a block" }
	if !holdsBlock(f.Decls[2].Value) { return "a struct type in a cast is a block" }
	if !holdsBlock(f.Decls[3].Value) { return "a function type in type arguments is a block" }
	return ""
}

// Past STABLE_LIST_DEPTH a chain with a line comment after one of its operators wraps
// there, as one the source wrapped does short of it: in a list's element, an operand,
// a call's argument, and an operand of another precedence.  A block comment there
// stays on the line.
func TestDeepChainKeepsLineComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := "
			"hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh("
			"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk, (da ^ // c4\n"
			"\t\t\td))))))))))))))\n"
			"\ty := "
			"hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh("
			"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk ^\n"
			"\t\t\t(da ^ // c5\n"
			"\t\t\td))))))))))))))\n"
			"\tz := "
			"hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh("
			"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk ^\n"
			"\t\t\tk(da ^ // c6\n"
			"\t\t\td))))))))))))))\n"
			"\tw := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(da ^ /* c7 */\n"
			"\t\t\td)))))))))))))\n"
			"\tv := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh((aggcah * bdjiiahhafhjggidei * // "
			"c8\n"
			"\t\t\tebhhcbebcfghhh) - vfbadfgecbjhffhfahdcbeia - "
			"kfekcjidcbbdggfcfcjaa)))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := "
			"hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh("
			"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk,\n"
			"\t\t\tda ^ // c4\n"
			"\t\t\t\t\td)))))))))))))\n"
			"\ty := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(\n"
			"\t\t\tkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk ^ (da ^ // c5\n"
			"\t\t\t\t\td))))))))))))))\n"
			"\tz := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(\n"
			"\t\t\tkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk ^ k(\n"
			"\t\t\t\t\tda ^ // c6\n"
			"\t\t\t\t\t\t\td))))))))))))))\n"
			"\tw := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(da ^ /* c7 */ d)))))))))))))\n"
			"\tv := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(\n"
			"\t\t\t(aggcah * bdjiiahhafhjggidei * // c8\n"
			"\t\t\t\t\tebhhcbebcfghhh) - vfbadfgecbjhffhfahdcbeia - "
			"kfekcjidcbbdggfcfcjaa)))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Past STABLE_LIST_DEPTH a chain whose line comment after an operator would pass the
// width cap on the one-line form's line wraps before the operand ahead of it, as one the
// source wrapped does (binarySingleFits).
func TestDeepChainWrapsBeforeALongLineComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaa, bbbbbbbbbbbb + cccccccccccc + "
			"// a long comment of about seventy-five characters in all, ok ok ok ok ok\n"
			"\t\t\tdddd)))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaa,\n"
			"\t\t\tbbbbbbbbbbbb +\n"
			"\t\t\t\t\tcccccccccccc + // a long comment of about seventy-five characters in "
			"all, ok ok ok ok ok\n"
			"\t\t\t\t\tdddd)))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}
