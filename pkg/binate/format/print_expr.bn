package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatExpr renders an expression to canonical source text.
func FormatExpr(e @ast.Expr) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	printExpr(b, e)
	return b.String()
}

// printStringLit appends a string literal.  A plain single literal is written
// verbatim (Name) when it fits; when it alone would exceed the cap at the current
// column (`tail` is what follows it on its line), it is SPLIT into adjacent
// literals across lines (splitStringLit) so the line stays legal -- the run
// concatenates to the same value, and round-trips as StrParts on a reprint.  A run
// of adjacent literals (`"a" "b"`, possibly split across lines) is re-emitted from
// its recorded parts, preserving the author's boundaries and line breaks:
// consecutive parts on the same source line are separated by a space, those on
// different lines by a break to a +2 continuation.  This keeps the author's
// meaningful split rather than re-flowing (and is token-exact: the same STRING
// tokens re-lex).
//
// The width cap is the hard invariant.  Adjacent literals the author wrote all on
// ONE line (`"a" "b"`) are semantically identical to the merged `"ab"` (3 bytes
// shorter per boundary), so when the space-split form would push the current line
// past the cap but the merge fits, emit the merge -- the visual split is the only
// thing lost, and the merged form re-lexes as one STRING (idempotent).  A
// genuinely-too-long run (merge also overflows) keeps the split (no merge would
// help; a LONG-LINE residual).  Cross-line splits are never merged: the author
// broke them precisely to fit, so preserving the breaks is what keeps them legal.
func printStringLit(b @strings.Builder, e @ast.Expr, tail int) {
	if len(e.StrParts) <= 1 {
		if wrapSuppressed || lineWidth(b) + len(e.Name) + tail <= MAX_LINE_WIDTH {
			b.Write(e.Name)
		} else {
			splitStringLit(b, e.Name, currentLineIndent(b) + 2, tail)
		}
		return
	}
	if strPartsAllSameLine(e.StrParts) {
		var col int = lineWidth(b)
		var splitFits bool = col + strPartsInlineWidth(e.StrParts) <= MAX_LINE_WIDTH
		// The space-split is emitted when it fits (or wrapping is suppressed -- an
		// author-marked line is preserved intact).  When it overflows: emit the merge
		// if THAT fits (shorter, semantically identical), else the run is too long for
		// this line even merged, so split the merged content across lines.
		if !wrapSuppressed && !splitFits {
			if col + len(e.Name) <= MAX_LINE_WIDTH {
				b.Write(e.Name)
			} else {
				splitStringLit(b, e.Name, currentLineIndent(b) + 2, tail)
			}
			return
		}
		for i := 0; i < len(e.StrParts); i++ {
			if i > 0 { b.WriteByte(' ') }
			b.Write(e.StrParts[i].Lit)
		}
		return
	}
	var cont int = currentLineIndent(b) + 2
	for i := 0; i < len(e.StrParts); i++ {
		if i > 0 {
			if e.StrParts[i].Pos.Line != e.StrParts[i - 1].Pos.Line {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		b.Write(e.StrParts[i].Lit)
	}
}

// strPartsAllSameLine reports whether every recorded part shares one source line
// (a `"a" "b"` run the author kept on one line), as opposed to a run split across
// lines to fit the width cap.
func strPartsAllSameLine(parts @[]@ast.StrPart) bool {
	for i := 1; i < len(parts); i++ {
		if parts[i].Pos.Line != parts[0].Pos.Line { return false }
	}
	return true
}

// strPartsInlineWidth returns the byte width of a same-line part run rendered
// space-separated (each part's literal plus one space between parts).
func strPartsInlineWidth(parts @[]@ast.StrPart) int {
	var w int = 0
	for i := 0; i < len(parts); i++ {
		w = w + len(parts[i].Lit)
		if i > 0 { w = w + 1 }
	}
	return w
}

// exprIsCrossLineStr reports whether e is an adjacent-string run the author split
// across source lines (so printStringLit emits it as multiple physical lines).
// A fill treats such an element as already-wrapped: the element after it starts a
// fresh continuation line rather than packing onto the string's deep +2
// continuation (which would sit at an indent the fill never planned).
func exprIsCrossLineStr(e @ast.Expr) bool {
	if e.Kind != ast.EXPR_STRING_LIT { return false }
	if len(e.StrParts) <= 1 { return false }
	return !strPartsAllSameLine(e.StrParts)
}

// escapeUnitLen returns the length of the source unit at content[i] within a
// string literal's body: 1 for a plain byte, or the full length of an escape
// sequence (2 for `\n`/`\t`/`\"`/..., 4 for `\xHH`, 6 for `\uHHHH`) -- the set in
// pkg/binate/types/escape.bn -- so a split never lands inside one (which would
// change the run's concatenated value or leave a dangling backslash).
func escapeUnitLen(content *[]readonly char, i int) int {
	if content[i] != '\\' { return 1 }
	if i + 1 >= len(content) { return 1 }
	var c char = content[i + 1]
	var n int = 2
	if c == 'x' { n = 4 }
	if c == 'u' { n = 6 }
	if i + n > len(content) { n = len(content) - i }
	return n
}

// stringSplitPoint returns the content index at which to end the current literal
// part: the furthest escape-unit boundary within `budget` bytes of `pos`,
// preferring a boundary right after a `\n` escape (a readable per-source-line
// break), and advancing by at least one unit so splitting always makes progress.
func stringSplitPoint(content *[]readonly char, pos int, budget int) int {
	var limit int = pos + budget
	if limit > len(content) { limit = len(content) }
	var best int = -1
	var bestNl int = -1
	var i int = pos
	for i < len(content) {
		var next int = i + escapeUnitLen(content, i)
		if next > limit { break }
		best = next
		if content[i] == '\\' && i + 1 < len(content) && content[i + 1] == 'n' {
			bestNl = next
		}
		i = next
	}
	if bestNl > pos { return bestNl }
	if best > pos { return best }
	// Budget too small for even one unit (a very deep indent, or a `\uHHHH` wider
	// than the remaining width): emit one unit anyway rather than loop forever -- a
	// rare LONG-LINE residual the formatter cannot resolve.
	return pos + escapeUnitLen(content, pos)
}

// splitStringLit emits a single string literal too wide for its line as a run of
// adjacent literals (`"part" "part"`), one per continuation line at `cont` tabs,
// splitting only at escape-unit boundaries so each part re-lexes to the same bytes
// and the run concatenates to the original value.  On a reprint the parts
// round-trip as StrParts and are preserved (cont matches the StrParts cross-line
// layout, currentLineIndent+2), so the split is idempotent.  `tail` is reserved on
// every part so a trailing `)` after the final part still fits.
func splitStringLit(b @strings.Builder, name *[]readonly char, cont int, tail int) {
	var content *[]readonly char = name[1 : len(name) - 1]
	var pos int = 0
	var first bool = true
	for pos < len(content) {
		var lineStart int = cont
		if first { lineStart = lineWidth(b) }
		var budget int = MAX_LINE_WIDTH - lineStart - 2 - tail
		if budget < 1 { budget = 1 }
		var end int = stringSplitPoint(content, pos, budget)
		if !first {
			b.WriteByte('\n')
			writeIndent(b, cont)
		}
		b.WriteByte('"')
		b.Write(content[pos:end])
		b.WriteByte('"')
		pos = end
		first = false
	}
}

// printExpr appends the canonical source form of e to b.  Parentheses are
// re-derived from operator precedence (redundant value parens dropped,
// precedence-required parens inserted).
func printExpr(b @strings.Builder, e @ast.Expr) {
	printExprE(b, e, false, 0)
}

// printExprTail prints e knowing that `tail` more bytes will follow it on its
// last line (an enclosing close delimiter, a trailing `.field`, ...).  A
// wrappable construct (call/index/composite) reserves that tail so its last line
// does not overflow the width cap.
func printExprTail(b @strings.Builder, e @ast.Expr, tail int) {
	printExprE(b, e, false, tail)
}

// printExprCond prints an expression in a control-clause condition context (the
// `if` / `for` / `switch` / for-in-iterator position), where a composite literal
// whose `{` is exposed to the clause's block-opening brace must be parenthesized
// (grammar D4) -- else the reprint is misparsed (the `{` reads as the block).
func printExprCond(b @strings.Builder, e @ast.Expr) {
	printExprE(b, e, true, 0)
}

// printExprCondTail is printExprCond with a known trailing width -- the ` {` (2)
// that a control clause appends after the condition -- so a wrapped or single-line
// condition reserves room for the block-opening brace and does not overflow.
func printExprCondTail(b @strings.Builder, e @ast.Expr, tail int) {
	printExprE(b, e, true, tail)
}

// printExprE is the recursive expression printer.  `exposed` drives the D4
// composite-in-condition rule: it is true while a composite literal's leading
// `{` would still reach the enclosing control clause's block brace -- it flows
// down the left edge, operands, and postfix heads, and is reset to false inside
// parentheses, call arguments, and index/slice brackets.  It is false in every
// ordinary (non-condition) context, where the output is unaffected.
func printExprE(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if e == nil { return }
	var k int = e.Kind
	if k == ast.EXPR_IDENT { b.Write(e.Name); return }
	if k == ast.EXPR_INT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_FLOAT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_STRING_LIT { printStringLit(b, e, tail); return }
	if k == ast.EXPR_CHAR_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			b.Write(e.Name)
		} else if e.BoolVal {
			b.Write("true")
		} else {
			b.Write("false")
		}
		return
	}
	if k == ast.EXPR_NIL_LIT { b.Write("nil"); return }
	if k == ast.EXPR_BINARY { printBinary(b, e, exposed, tail); return }
	if k == ast.EXPR_UNARY { printUnary(b, e, exposed, tail); return }
	if k == ast.EXPR_CALL { printCall(b, e, exposed, tail); return }
	if k == ast.EXPR_INSTANTIATE_OR_INDEX { printIndex(b, e, exposed, tail); return }
	if k == ast.EXPR_SLICE { printSlice(b, e, exposed); return }
	if k == ast.EXPR_SELECTOR { printSelector(b, e, exposed, tail); return }
	if k == ast.EXPR_COMPOSITE { printComposite(b, e, exposed, tail); return }
	if k == ast.EXPR_BUILTIN { printBuiltin(b, e, tail); return }
	if k == ast.EXPR_TYPE { printType(b, e.TypeRef); return }
	if k == ast.EXPR_FUNC_LIT { printFuncLit(b, e); return }
}

// binopPrec mirrors parser.binaryPrec: the precedence of a binary operator token
// (1 = loosest `||` … 9 = tightest `* / %`); 0 if not a binary operator.  All
// binary operators are left-associative.
func binopPrec(op int) int {
	var t token.Type = cast(token.Type, op)
	if t == token.LOR { return 1 }
	if t == token.LAND { return 2 }
	if t == token.EQ || t == token.NEQ || t == token.LT ||
			t == token.GT || t == token.LEQ || t == token.GEQ {
		return 3
	}
	if t == token.PIPE { return 4 }
	if t == token.CARET { return 5 }
	if t == token.AMP { return 6 }
	if t == token.SHL || t == token.SHR { return 7 }
	if t == token.PLUS || t == token.MINUS { return 8 }
	if t == token.STAR || t == token.SLASH || t == token.PERCENT { return 9 }
	return 0
}

// isCompareOp reports whether a binary operator is one of the six comparison
// operators.  They are NON-associative in Binate (`a < b < c` is a syntax error,
// per parser isCompareOp / continueBinaryExpr), so a same-precedence comparison
// operand of a comparison must be parenthesized -- unlike the left-associative
// operators, where a same-precedence left operand needs no parens.
func isCompareOp(op int) bool {
	var t token.Type = cast(token.Type, op)
	return t == token.EQ || t == token.NEQ || t == token.LT ||
			t == token.GT || t == token.LEQ || t == token.GEQ
}

// printBinarySingle appends `X op Y` on one line with single spaces around the
// operator, adding parentheses only where precedence and associativity require
// them.
func printBinarySingle(b @strings.Builder, e @ast.Expr, exposed bool) {
	var p int = binopPrec(e.Op)
	printBinOperand(b, e.X, p, e.Op, true, exposed, 0)
	b.WriteByte(' ')
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	b.WriteByte(' ')
	printBinOperand(b, e.Y, p, e.Op, false, exposed, 0)
}

// printBinOperand prints a binary operand, parenthesizing a lower-precedence
// binary child (looser-or-equal on the right, strictly looser on the left).  A
// non-binary operand binds tighter than any binary, so it is not parenthesized
// here.  `exposed` propagates to an un-parenthesized operand (both operands can
// reach an exposed `{`); a precedence-parenthesized operand is no longer exposed.
//
// An author-parenthesized binary operand keeps its parens even when precedence
// does not require them: the pair disambiguates a reader's view of the operator
// order (`1 << (64 - n)`), which Binate's C-like precedence makes non-obvious.
// This preservation is limited to binary operands -- parens around a primary or a
// single unary ("one thing inside") are dropped, and a top-level parenthesized
// binary (not an operand of another operator) is canonicalized away.
//
// `tail` is what will follow this operand on its line (the enclosing operator, a
// close delimiter): it is forwarded to the operand's printer -- plus 1 for the `)`
// this function writes when it parenthesizes -- so a wrappable operand (a nested
// chain, a builtin) reserves that width and sub-wraps instead of overflowing.
func printBinOperand(b @strings.Builder, e @ast.Expr, parentPrec int, parentOp int,
		isLeft bool, exposed bool, tail int) {
	var needParen bool = false
	if e != nil && e.Kind == ast.EXPR_BINARY {
		var cp int = binopPrec(e.Op)
		if isLeft {
			// A left operand of a left-associative operator needs parens only when
			// it binds strictly looser; but a comparison is non-associative, so a
			// same-precedence comparison left operand also needs parens (else it
			// re-parses as an illegal chain).
			needParen = cp < parentPrec ||
					(cp == parentPrec && isCompareOp(parentOp))
		} else {
			needParen = cp <= parentPrec
		}
		if e.Parenthesized { needParen = true }
	}
	if needParen {
		b.WriteByte('(')
		printExprTail(b, e, tail + 1)
		b.WriteByte(')')
	} else {
		printExprE(b, e, exposed, tail)
	}
}

// printUnary appends a prefix unary operator tight to its operand, parenthesizing
// a binary operand (which binds looser than any prefix unary).  `tail` (what
// follows the whole unary expression on its line, e.g. a control clause's ` {`) is
// forwarded to the operand -- plus 1 for the `)` when it parenthesizes -- so a
// wrappable operand (a `!f(args)` call condition) reserves it and sub-wraps.
func printUnary(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	// Keep a space between two adjacent prefix operators that would otherwise
	// merge into a single multi-char token: `- -x`, `+ +x`, `& &x`.
	if e.X != nil && e.X.Kind == ast.EXPR_UNARY &&
			unaryOpsCollide(e.Op, e.X.Op) {
		b.WriteByte(' ')
	}
	if e.X != nil && e.X.Kind == ast.EXPR_BINARY {
		b.WriteByte('(')
		printExprTail(b, e.X, tail + 1)
		b.WriteByte(')')
	} else {
		printExprE(b, e.X, exposed, tail)
	}
}

// unaryOpsCollide reports whether a prefix operator `outer` printed tight against
// a prefix operator `inner` would lex as one multi-char token (`--`/`++`/`&&`).
func unaryOpsCollide(outer int, inner int) bool {
	if outer != inner { return false }
	var t token.Type = cast(token.Type, outer)
	return t == token.MINUS || t == token.PLUS || t == token.AMP
}

// printCall appends `head(args)`, wrapping the argument list (fill style) when
// the source wrapped it or it would exceed the width cap; a spread call
// (`f(a...)`) appends `...` after the final argument.
func printCall(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printPostfixHead(b, e.X, exposed, 0)
	printArgList(b, e.Args, headLine(e.X), e.Spread, '(', ')', tail)
}

// printIndex appends `head[args]` (value index or generic instantiation),
// wrapping the argument list when needed.
func printIndex(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printPostfixHead(b, e.X, exposed, 0)
	printArgList(b, e.Args, headLine(e.X), false, '[', ']', tail)
}

// headLine returns the source line of a postfix form's head (the opener line used
// to decide the wrap mode), or 0 for a nil head.
func headLine(e @ast.Expr) int {
	if e == nil { return 0 }
	return e.Pos.Line
}

// printSlice appends `head[lo:hi]` with an elided missing bound.  (A slice has no
// wrappable list; a head that itself wraps is approximated with tail 0.)
func printSlice(b @strings.Builder, e @ast.Expr, exposed bool) {
	printPostfixHead(b, e.X, exposed, 0)
	b.WriteByte('[')
	if e.Z != nil { printExpr(b, e.Z) }
	b.WriteByte(':')
	if e.Y != nil { printExpr(b, e.Y) }
	b.WriteByte(']')
}

// printSelector appends `head.Name`.  The head is followed by `.Name` plus this
// selector's own tail, so a wrappable head reserves that combined width.
func printSelector(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printPostfixHead(b, e.X, exposed, 1 + len(e.Name) + tail)
	b.WriteByte('.')
	b.Write(e.Name)
}

// printPostfixHead prints the head of a postfix form, parenthesizing a binary or
// unary head (both bind looser than a postfix operator).  `exposed` propagates to
// an un-parenthesized head (the head is the postfix form's left edge); a
// parenthesized head is no longer exposed.  tail is what follows the whole postfix
// form on its last line (reserved by a wrappable head).
func printPostfixHead(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if e != nil && (e.Kind == ast.EXPR_BINARY || e.Kind == ast.EXPR_UNARY) {
		b.WriteByte('(')
		printExpr(b, e)
		b.WriteByte(')')
	} else {
		printExprE(b, e, exposed, tail)
	}
}

// printComposite appends `Type{elems}`, wrapping it in parentheses when `exposed`
// (D4: an exposed composite `{` in a condition would be misread as the control
// clause's block brace).  tail is what follows the composite on its last line.
func printComposite(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if exposed {
		b.WriteByte('(')
		printCompositeBody(b, e, 1 + tail)
		b.WriteByte(')')
		return
	}
	printCompositeBody(b, e, tail)
}

// printCompositeBody appends `Type{elems}`, wrapping the element list fill-style
// when the source wrapped it or it would exceed the width cap.  A keyed element
// prints `Key: Value`, a positional one just `Value`.  Elements sit inside `{}`
// and so are never exposed.
func printCompositeBody(b @strings.Builder, e @ast.Expr, tail int) {
	printType(b, e.TypeRef)
	printCompositeElems(b, e, tail)
}

// printExprList appends a comma-separated list of expressions (each inside the
// enclosing `()`/`[]`, so never exposed).
func printExprList(b @strings.Builder, list @[]@ast.Expr) {
	for i := 0; i < len(list); i++ {
		if i > 0 { b.Write(", ") }
		printExpr(b, list[i])
	}
}
