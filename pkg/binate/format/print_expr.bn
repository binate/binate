package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatExpr renders an expression to canonical source text.
func FormatExpr(e @ast.Expr) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	printExpr(b, e)
	return b.String()
}

// printExpr appends the canonical source form of e to b.  Parentheses are
// re-derived from operator precedence (the AST has no paren node): redundant
// value parens are dropped and precedence-required parens are (re)inserted, so
// the output is canonically parenthesized regardless of the source's parens.
//
// EXPR_FUNC_LIT is intentionally NOT handled here: a function literal's body is
// a statement block, so it is completed alongside the statement printer (a later
// step).  No value path reaches printExpr on a func literal yet.
func printExpr(b @strings.Builder, e @ast.Expr) {
	if e == nil { return }
	var k int = e.Kind
	if k == ast.EXPR_IDENT { b.Write(e.Name); return }
	if k == ast.EXPR_INT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_FLOAT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_STRING_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_CHAR_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			b.Write(e.Name)
		} else if e.BoolVal {
			b.Write("true")
		} else {
			b.Write("false")
		}
		return
	}
	if k == ast.EXPR_NIL_LIT { b.Write("nil"); return }
	if k == ast.EXPR_BINARY { printBinary(b, e); return }
	if k == ast.EXPR_UNARY { printUnary(b, e); return }
	if k == ast.EXPR_CALL { printCall(b, e); return }
	if k == ast.EXPR_INSTANTIATE_OR_INDEX { printIndex(b, e); return }
	if k == ast.EXPR_SLICE { printSlice(b, e); return }
	if k == ast.EXPR_SELECTOR { printSelector(b, e); return }
	if k == ast.EXPR_COMPOSITE { printComposite(b, e); return }
	if k == ast.EXPR_BUILTIN { printBuiltin(b, e); return }
	if k == ast.EXPR_TYPE { printType(b, e.TypeRef); return }
}

// binopPrec mirrors parser.binaryPrec: the precedence of a binary operator token
// (1 = loosest `||` … 9 = tightest `* / %`); 0 if not a binary operator.  All
// binary operators are left-associative.
func binopPrec(op int) int {
	var t token.Type = cast(token.Type, op)
	if t == token.LOR { return 1 }
	if t == token.LAND { return 2 }
	if t == token.EQ || t == token.NEQ || t == token.LT ||
			t == token.GT || t == token.LEQ || t == token.GEQ {
		return 3
	}
	if t == token.PIPE { return 4 }
	if t == token.CARET { return 5 }
	if t == token.AMP { return 6 }
	if t == token.SHL || t == token.SHR { return 7 }
	if t == token.PLUS || t == token.MINUS { return 8 }
	if t == token.STAR || t == token.SLASH || t == token.PERCENT { return 9 }
	return 0
}

// printBinary appends `X op Y` with single spaces around the operator, adding
// parentheses only where precedence and left-associativity require them: the
// left operand when it binds strictly looser, the right operand when it binds
// looser-or-equal (equal on the right would re-associate).
func printBinary(b @strings.Builder, e @ast.Expr) {
	var p int = binopPrec(e.Op)
	printBinOperand(b, e.X, p, true)
	b.WriteByte(' ')
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	b.WriteByte(' ')
	printBinOperand(b, e.Y, p, false)
}

// printBinOperand prints a binary operand, parenthesizing a lower-precedence
// binary child (looser-or-equal on the right, strictly looser on the left).  A
// non-binary operand (unary / postfix / primary) binds tighter than any binary,
// so it is never parenthesized here.
func printBinOperand(b @strings.Builder, e @ast.Expr, parentPrec int, isLeft bool) {
	var needParen bool = false
	if e != nil && e.Kind == ast.EXPR_BINARY {
		var cp int = binopPrec(e.Op)
		if isLeft {
			needParen = cp < parentPrec
		} else {
			needParen = cp <= parentPrec
		}
	}
	printParen(b, e, needParen)
}

// printUnary appends a prefix unary operator tight to its operand, parenthesizing
// a binary operand (which binds looser than any prefix unary).
func printUnary(b @strings.Builder, e @ast.Expr) {
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	// Keep a space between two adjacent prefix operators that would otherwise
	// merge into a single multi-char token: `- -x`, `+ +x`, `& &x` must not lex
	// as `--` (DEC), `++` (INC), `&&` (LAND).
	if e.X != nil && e.X.Kind == ast.EXPR_UNARY &&
			unaryOpsCollide(e.Op, e.X.Op) {
		b.WriteByte(' ')
	}
	printParen(b, e.X, e.X != nil && e.X.Kind == ast.EXPR_BINARY)
}

// unaryOpsCollide reports whether a prefix operator `outer` printed tight against
// a prefix operator `inner` would lex as one multi-char token instead of two
// prefix operators — the three doubled cases `--` / `++` / `&&`.  (`**`, `!!`,
// `~~` are not tokens, so those pairs need no space.)
func unaryOpsCollide(outer int, inner int) bool {
	if outer != inner { return false }
	var t token.Type = cast(token.Type, outer)
	return t == token.MINUS || t == token.PLUS || t == token.AMP
}

// printCall appends `head(args)`.  A spread call (`f(a...)`, e.Spread) appends
// `...` immediately after the final argument.
func printCall(b @strings.Builder, e @ast.Expr) {
	printPostfixHead(b, e.X)
	b.WriteByte('(')
	printExprList(b, e.Args)
	if e.Spread {
		b.Write("...")
	}
	b.WriteByte(')')
}

// printIndex appends `head[args]` — the `name[...]` form covering both value
// indexing and generic instantiation (the type checker disambiguates; the
// printed form is identical).
func printIndex(b @strings.Builder, e @ast.Expr) {
	printPostfixHead(b, e.X)
	b.WriteByte('[')
	printExprList(b, e.Args)
	b.WriteByte(']')
}

// printSlice appends `head[lo:hi]`; a missing bound (nil) is elided
// (`head[:hi]`, `head[lo:]`, `head[:]`).  X holds the head, Z the low bound, Y
// the high bound.
func printSlice(b @strings.Builder, e @ast.Expr) {
	printPostfixHead(b, e.X)
	b.WriteByte('[')
	if e.Z != nil { printExpr(b, e.Z) }
	b.WriteByte(':')
	if e.Y != nil { printExpr(b, e.Y) }
	b.WriteByte(']')
}

// printSelector appends `head.Name`.
func printSelector(b @strings.Builder, e @ast.Expr) {
	printPostfixHead(b, e.X)
	b.WriteByte('.')
	b.Write(e.Name)
}

// printPostfixHead prints the head of a postfix form (call / index / slice /
// selector), parenthesizing a binary or unary head — both bind looser than a
// postfix operator, so `(*p).f`, `(a + b).f`, `(-x)[i]` need the parens.
func printPostfixHead(b @strings.Builder, e @ast.Expr) {
	var needParen bool = e != nil &&
		(e.Kind == ast.EXPR_BINARY || e.Kind == ast.EXPR_UNARY)
	printParen(b, e, needParen)
}

// printComposite appends `Type{elems}` on a single line; a keyed element prints
// `Key: Value`, a positional one just `Value`.  (Multi-line layout is a later
// step.)
func printComposite(b @strings.Builder, e @ast.Expr) {
	printType(b, e.TypeRef)
	b.WriteByte('{')
	for i := 0; i < len(e.Elems); i++ {
		if i > 0 { b.Write(", ") }
		var el @ast.Element = e.Elems[i]
		if el.Key != nil {
			printExpr(b, el.Key)
			b.Write(": ")
		}
		printExpr(b, el.Value)
	}
	b.WriteByte('}')
}

// printExprList appends a comma-separated list of expressions.
func printExprList(b @strings.Builder, list @[]@ast.Expr) {
	for i := 0; i < len(list); i++ {
		if i > 0 { b.Write(", ") }
		printExpr(b, list[i])
	}
}

// printParen prints e, wrapping it in parentheses when wrap is true.
func printParen(b @strings.Builder, e @ast.Expr, wrap bool) {
	if wrap {
		b.WriteByte('(')
		printExpr(b, e)
		b.WriteByte(')')
	} else {
		printExpr(b, e)
	}
}
