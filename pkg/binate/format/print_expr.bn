package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatExpr renders an expression to canonical source text.
func FormatExpr(e @ast.Expr) @[]readonly char {
	resetRenderCache()
	var b @strings.Builder = strings.NewBuilder()
	printExpr(b, e)
	dropRenderCache()
	return b.String()
}

// printExpr appends the canonical source form of e to b.  Parentheses are
// re-derived from operator precedence (redundant value parens dropped,
// precedence-required parens inserted).
func printExpr(b @strings.Builder, e @ast.Expr) {
	printExprE(b, e, false, 0)
}

// printExprTail prints e knowing that `tail` more bytes will follow it on its
// last line (an enclosing close delimiter, a trailing `.field`, ...).  A
// wrappable construct (call/index/composite) reserves that tail so its last line
// does not overflow the width cap.  An element whose fill took a layout read back
// from a rendering prints that layout's text (printOverride, print_reread.bn).
func printExprTail(b @strings.Builder, e @ast.Expr, tail int) {
	if printOverride(b, e, tail) { return }
	printExprE(b, e, false, tail)
}

// printExprCond prints an expression in a control-clause condition context (the
// `if` / `for` / `switch` / for-in-iterator position), where a composite literal
// of a type name whose `{` is exposed to the clause's block-opening brace must be
// parenthesized (grammar D4) -- else the reprint is misparsed (the `{` reads as
// the block).
func printExprCond(b @strings.Builder, e @ast.Expr) {
	printExprE(b, e, true, 0)
}

// printExprCondTail is printExprCond with a known trailing width -- the ` {` (2)
// that a control clause appends after the condition -- so a wrapped or single-line
// condition reserves room for the block-opening brace and does not overflow.
func printExprCondTail(b @strings.Builder, e @ast.Expr, tail int) {
	printExprE(b, e, true, tail)
}

// printExprE is the recursive expression printer.  `exposed` drives the D4
// composite-in-condition rule: it is true while a composite literal's leading
// `{` would still reach the enclosing control clause's block brace -- it flows
// down the left edge, operands, and postfix heads, and is reset to false inside
// parentheses, call arguments, and index/slice brackets.  It is false in every
// ordinary (non-condition) context, where the output is unaffected.
func printExprE(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if e == nil { return }
	var k int = e.Kind
	if k == ast.EXPR_IDENT { b.Write(e.Name); return }
	if k == ast.EXPR_INT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_FLOAT_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_STRING_LIT { printStringLit(b, e, tail); return }
	if k == ast.EXPR_CHAR_LIT { b.Write(e.Name); return }
	if k == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			b.Write(e.Name)
		} else if e.BoolVal {
			b.Write("true")
		} else {
			b.Write("false")
		}
		return
	}
	if k == ast.EXPR_NIL_LIT { b.Write("nil"); return }
	if k == ast.EXPR_BINARY { printBinary(b, e, exposed, tail); return }
	if k == ast.EXPR_UNARY { printUnary(b, e, exposed, tail); return }
	if k == ast.EXPR_CALL { printCall(b, e, exposed, tail); return }
	if k == ast.EXPR_INSTANTIATE_OR_INDEX { printIndex(b, e, exposed, tail); return }
	if k == ast.EXPR_SLICE { printSlice(b, e, exposed, tail); return }
	if k == ast.EXPR_SELECTOR { printSelector(b, e, exposed, tail); return }
	if k == ast.EXPR_TYPE_ASSERT { printTypeAssert(b, e, exposed, tail); return }
	if k == ast.EXPR_COMPOSITE { printComposite(b, e, exposed, tail); return }
	if k == ast.EXPR_BUILTIN { printBuiltin(b, e, tail); return }
	if k == ast.EXPR_TYPE { printType(b, e.TypeRef); return }
	if k == ast.EXPR_FUNC_LIT { printFuncLit(b, e, tail); return }
	// An expression kind with no case here would otherwise be dropped from the
	// output without a word.
	panic("bnfmt: printExprE has no case for this expression kind")
}

// binopPrec mirrors parser.binaryPrec: the precedence of a binary operator token
// (1 = loosest `||` … 9 = tightest `* / %`); 0 if not a binary operator.  All
// binary operators are left-associative.
func binopPrec(op int) int {
	var t token.Type = cast(token.Type, op)
	if t == token.LOR { return 1 }
	if t == token.LAND { return 2 }
	if t == token.EQ || t == token.NEQ || t == token.LT || t == token.GT || t == token.LEQ ||
			t == token.GEQ {
		return 3
	}
	if t == token.PIPE { return 4 }
	if t == token.CARET { return 5 }
	if t == token.AMP { return 6 }
	if t == token.SHL || t == token.SHR { return 7 }
	if t == token.PLUS || t == token.MINUS { return 8 }
	if t == token.STAR || t == token.SLASH || t == token.PERCENT { return 9 }
	return 0
}

// isCompareOp reports whether a binary operator is one of the six comparison
// operators.  They are NON-associative in Binate (`a < b < c` is a syntax error,
// per parser isCompareOp / continueBinaryExpr), so a same-precedence comparison
// operand of a comparison must be parenthesized -- unlike the left-associative
// operators, where a same-precedence left operand needs no parens.
func isCompareOp(op int) bool {
	var t token.Type = cast(token.Type, op)
	return t == token.EQ || t == token.NEQ || t == token.LT || t == token.GT || t == token.LEQ ||
			t == token.GEQ
}

// printBinarySingle appends `X op Y` on one line with single spaces around the
// operator, adding parentheses only where precedence and associativity require
// them, and the block comments on one line around the operator (printBinary);
// tail is what follows Y on its line.  A comment after the operator that needs a
// line break after it -- which a rendering that wrapped the chain may have claimed
// -- is written there all the same, and Y starts a continuation line.
func printBinarySingle(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	var p int = binopPrec(e.Op)
	var key token.Pos = chainKey(e, p)
	// The continuation lines indent from the chain's first line, as a wrapped one's do,
	// not from where X ends.
	var cont int = currentLineIndent(b) + 2
	printBinOperand(b, e.X, p, e.Op, true, exposed, 0)
	_ = writeInlineComments(b, chainGapBefore(e, p, key))
	b.WriteByte(' ')
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	if writeGapComments(b, claimGap(e.Pos, exprStartPos(e.Y), key), cont, false) {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else {
		b.WriteByte(' ')
	}
	printBinOperand(b, e.Y, p, e.Op, false, exposed, tail)
}

// printBinOperand prints a binary operand, parenthesizing a lower-precedence
// binary child (looser-or-equal on the right, strictly looser on the left).  A
// non-binary operand binds tighter than any binary, so it is not parenthesized
// here.  `exposed` propagates to an un-parenthesized operand (both operands can
// reach an exposed `{`); a precedence-parenthesized operand is no longer exposed.
//
// An author-parenthesized binary operand keeps its parens even when precedence
// does not require them: the pair disambiguates a reader's view of the operator
// order (`1 << (64 - n)`), which Binate's C-like precedence makes non-obvious.
// This preservation is limited to binary operands -- parens around a primary or a
// single unary ("one thing inside") are dropped, and a top-level parenthesized
// binary (not an operand of another operator) is canonicalized away.
//
// `tail` is what will follow this operand on its line (the enclosing operator, a
// close delimiter): it is forwarded to the operand's printer -- plus 1 for the `)`
// this function writes when it parenthesizes -- so a wrappable operand (a nested
// chain, a builtin) reserves that width and sub-wraps instead of overflowing.
func printBinOperand(b @strings.Builder, e @ast.Expr, parentPrec int, parentOp int, isLeft bool,
		exposed bool, tail int) {
	if binOperandParens(e, parentPrec, parentOp, isLeft) {
		b.WriteByte('(')
		printExprTail(b, e, tail + 1)
		b.WriteByte(')')
	} else {
		printExprE(b, e, exposed, tail)
	}
}

// binOperandParens reports whether printBinOperand parenthesizes operand e of
// parentOp (of precedence parentPrec), the left one when isLeft.
func binOperandParens(e @ast.Expr, parentPrec int, parentOp int, isLeft bool) bool {
	if e == nil || e.Kind != ast.EXPR_BINARY { return false }
	if e.Parenthesized { return true }
	var cp int = binopPrec(e.Op)
	// A left operand of a left-associative operator needs parens only when it binds
	// strictly looser; but a comparison is non-associative, so a same-precedence
	// comparison left operand also needs parens (else it re-parses as an illegal
	// chain).
	if isLeft { return cp < parentPrec || (cp == parentPrec && isCompareOp(parentOp)) }
	return cp <= parentPrec
}

// printUnary appends a prefix unary operator tight to its operand, parenthesizing
// a binary operand (which binds looser than any prefix unary); an array literal
// at the left edge of a `*`'s operand takes parentheses of its own
// (printComposite), and so does the operand when comments lie between them
// (starHidesArray).  The comments between the operator and its operand go there
// (print_exprgaps.bn).  `tail` (what follows the whole unary expression on its line,
// e.g. a control clause's ` {`) is forwarded to the operand -- plus 1 for the `)`
// when it parenthesizes -- so a wrappable operand (a `!f(args)` call condition)
// reserves it and sub-wraps.
func printUnary(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	b.Write(token.TypeName(cast(token.Type, e.Op)))
	var cs @[]@token.Comment = claimUnaryGap(e)
	writeExprGap(b, cs)
	// Keep a space between two adjacent prefix operators that would otherwise
	// merge into a single multi-char token: `- -x`, `+ +x`, `& &x`.
	if len(cs) == 0 && e.X != nil && e.X.Kind == ast.EXPR_UNARY && unaryOpsCollide(e.Op, e.X.Op) {
		b.WriteByte(' ')
	}
	if e.X != nil && (e.X.Kind == ast.EXPR_BINARY || (len(cs) > 0 && starHidesArray(e.Op, e.X))) {
		b.WriteByte('(')
		printExprTail(b, e.X, tail + 1)
		b.WriteByte(')')
	} else {
		printExprE(b, e.X, exposed, tail)
	}
}

// unaryOpsCollide reports whether a prefix operator `outer` printed tight against
// a prefix operator `inner` would lex as one multi-char token (`--`/`++`/`&&`).
func unaryOpsCollide(outer int, inner int) bool {
	if outer != inner { return false }
	var t token.Type = cast(token.Type, outer)
	return t == token.MINUS || t == token.PLUS || t == token.AMP
}

// printCall appends `head(args)`, wrapping the argument list (fill style) when
// the source wrapped it or it would exceed the width cap; a spread call
// (`f(a...)`) appends `...` after the final argument.  The call's Pos is its `(`,
// the opener whose line decides the wrap mode -- not the head's first line, which
// differs when the head spans lines (`func() {` … `}(x)`).  A wrappable head
// reserves what follows it on its line (argsHeadTail).  The block comments before
// the `(` stay there (writeHeadGap).
func printCall(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printPostfixHead(b, e.X, exposed, argsHeadTail(e.Args, tail))
	writeHeadGap(b, e.X, e.Pos, e.Pos)
	printArgList(b, e.Args, e.Pos, e.Pos.Line, e.Spread, '(', ')', e.Pos, true, tail)
}

// argsHeadTail returns what follows a call's or index's head on its line, for the
// head to reserve: the opener, after which a list can break, or for an empty list
// the opener, the close and the form's tail.
func argsHeadTail(args @[]@ast.Expr, tail int) int {
	if len(args) == 0 { return 2 + tail }
	return 1
}

// printIndex appends `head[args]` (value index or generic instantiation),
// wrapping the argument list when needed.  The opener is the `[` (the Pos), as for
// printCall, and the block comments before it stay there.
func printIndex(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printPostfixHead(b, e.X, exposed, argsHeadTail(e.Args, tail))
	writeHeadGap(b, e.X, e.Pos, e.Pos)
	printArgList(b, e.Args, e.Pos, e.Pos.Line, false, '[', ']', e.Pos, true, tail)
}

// printSelector appends `head.Name`.  The head is followed by `.Name` plus this
// selector's own tail, so a wrappable head reserves that combined width.  The
// comments before the `.` stay there, and those after it -- right before the name,
// the selector's Pos -- go there.
func printSelector(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	printDotHead(b, e.X, exposed, 1 + len(e.Name) + tail)
	writeHeadGap(b, e.X, beforeTokenStart(e.Pos), e.Pos)
	b.WriteByte('.')
	writeExprGap(b, claimBeforeToken(e.Pos, e.Pos))
	b.Write(e.Name)
}

// printTypeAssert renders a type-assertion expression `x.(T)` (spec §11.12): the
// operand `e.X` (a postfix head, printDotHead), then `.(`, the recovery target
// `e.TypeRef`, and `)`.  A wrappable head reserves `.(T)` and the tail, and the type
// what follows it: the `)`, the comments before it and the tail (printTypeTail).  The
// comments before the `.` (its Pos) stay there, those from it to the type go after
// the `(`, and the block comments on one line before the `)` stay there
// (assertCloserGap).
func printTypeAssert(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	var tb @strings.Builder = strings.NewBuilder()
	printType(tb, e.TypeRef)
	var closing @[]@token.Comment = assertCloserGap(e)
	var after int = 1 + inlineCommentsWidth(closing) + tail
	printDotHead(b, e.X, exposed, 2 + lineShare(tb.String(), after))
	writeHeadGap(b, e.X, e.Pos, e.Pos)
	b.Write(".(")
	writeExprGap(b, claimGap(e.Pos, typeStartPos(e.TypeRef), e.Pos))
	printTypeTail(b, e.TypeRef, after)
	_ = writeInlineComments(b, closing)
	b.WriteByte(')')
}

// printPostfixHead prints the head of a postfix form, parenthesizing a binary or
// unary head or a raw-slice literal (each binds looser than a postfix operator:
// the grammar makes `*[]T{…}` a unary expression, so `*[]T{…}[0]` does not
// parse).  `exposed` propagates to an un-parenthesized head (the head is the
// postfix form's left edge); a parenthesized head is no longer exposed.  tail is
// what follows the whole postfix form on its last line (reserved by a wrappable
// head).
func printPostfixHead(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if e != nil && (e.Kind == ast.EXPR_BINARY || e.Kind == ast.EXPR_UNARY || isRawSliceLit(e)) {
		b.WriteByte('(')
		printExprTail(b, e, 1 + tail)
		b.WriteByte(')')
	} else {
		printExprE(b, e, exposed, tail)
	}
}

// printDotHead prints the head of a postfix form that begins with a `.` -- a
// selector, a type assertion, a type switch's `.(type)` -- as printPostfixHead
// does, and also parenthesizes a number literal that the `.` would lex differently
// after (dotRelexes): the lexer reads `1.` as a float, so `1.String()` does not
// parse.
func printDotHead(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if e != nil && dotRelexes(e) {
		b.WriteByte('(')
		printExprTail(b, e, 1 + tail)
		b.WriteByte(')')
		return
	}
	printPostfixHead(b, e, exposed, tail)
}

// dotRelexes reports whether a `.` written right after number literal e would lex
// differently: after an integer with no `0x`, `0o` or `0b` prefix it makes a float
// (`1.`), and after a float that ends in `.` the two dots lex apart (`1..y`).
func dotRelexes(e @ast.Expr) bool {
	var n int = len(e.Name)
	if e.Kind == ast.EXPR_FLOAT_LIT { return n > 0 && e.Name[n - 1] == '.' }
	if e.Kind != ast.EXPR_INT_LIT { return false }
	if n < 2 || e.Name[0] != '0' { return true }
	var c char = e.Name[1]
	return c != 'x' && c != 'X' && c != 'o' && c != 'O' && c != 'b' && c != 'B'
}

// isRawSliceLit reports whether e is a raw-slice literal, `*[]T{…}`.
func isRawSliceLit(e @ast.Expr) bool {
	return e.Kind == ast.EXPR_COMPOSITE && e.TypeRef != nil && e.TypeRef.Kind == ast.TEXPR_SLICE
}

// printComposite appends `Type{elems}`, wrapping it in parentheses when `exposed`
// and its type is a type name (D4: the `{` of such a composite in a condition
// would be read as the control clause's block brace), and when it is an array
// literal that follows a `*` (a dereference's, which printUnary writes tight to
// its operand): `*` then `[` begins a raw-slice literal (D3), so `*[2]T{…}[0]`
// does not parse.  tail is what follows the composite on its last line.
func printComposite(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	if (exposed && !bareInCondition(e)) || (isArrayLit(e) && followsStar(b)) {
		b.WriteByte('(')
		printCompositeBody(b, e, 1 + tail)
		b.WriteByte(')')
		return
	}
	printCompositeBody(b, e, tail)
}

// bareInCondition reports whether composite literal e is read bare in a control
// clause's condition: an array, slice or managed-slice literal, whose type is not
// an expression, so the `{` after it cannot begin the block (D4).
func bareInCondition(e @ast.Expr) bool {
	if e.TypeRef == nil { return false }
	var k int = e.TypeRef.Kind
	return k == ast.TEXPR_ARRAY || k == ast.TEXPR_SLICE || k == ast.TEXPR_MANAGED_SLICE
}

// isArrayLit reports whether composite literal e is an array literal, `[N]T{…}` or
// `[...]T{…}`.
func isArrayLit(e @ast.Expr) bool {
	return e.TypeRef != nil && e.TypeRef.Kind == ast.TEXPR_ARRAY
}

// followsStar reports whether the last byte written to b is a `*`.
func followsStar(b @strings.Builder) bool {
	var s @[]readonly char = b.String()
	return len(s) > 0 && s[len(s) - 1] == '*'
}

// printCompositeBody appends `Type{elems}`, with the comments between the type
// and `{` (printCompositeType), wrapping the element list fill-style when the
// source wrapped it or it would exceed the width cap.  A keyed element prints
// `Key: Value`, a positional one just `Value`.  Elements sit inside `{}` and so
// are never exposed.
func printCompositeBody(b @strings.Builder, e @ast.Expr, tail int) {
	printCompositeType(b, e)
	printCompositeElems(b, e, tail)
}

// printExprList appends a comma-separated list of expressions (each inside the
// enclosing `()`/`[]`, so never exposed).
func printExprList(b @strings.Builder, list @[]@ast.Expr) {
	for i := 0; i < len(list); i++ {
		if i > 0 { b.Write(", ") }
		printExpr(b, list[i])
	}
}
