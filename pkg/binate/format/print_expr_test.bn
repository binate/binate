package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// parseExprSrc parses a bare expression and returns the AST.  Uses the parser's
// ParseExpr REPL entry (New preloads the first token).  Shares toBytes /
// assertTokenEq / streq from the sibling test files (same package).
func parseExprSrc(src *[]readonly char) @ast.Expr {
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	return p.ParseExpr()
}

// checkExpr round-trips a canonically-parenthesized expression through
// FormatExpr and asserts token-equality (§11.1).  Valid only when the input is
// already canonically parenthesized (no redundant parens, all
// precedence-required parens present) so the printer preserves the token stream;
// redundant/omitted parens are a canonicalization covered by checkExprGolden.
func checkExpr(src *[]readonly char) testing.TestResult {
	var e @ast.Expr = parseExprSrc(src)
	if e == nil {
		return tokDiff("parse produced no expr", src, "")
	}
	var out @[]readonly char = FormatExpr(e)
	return assertTokenEq(src, out)
}

// checkExprGolden asserts FormatExpr(parse(src)) equals want exactly -- used
// where the printer re-derives parentheses (drops redundant / inserts required),
// which reorders tokens and so is out of the token gate's scope.
func checkExprGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var e @ast.Expr = parseExprSrc(src)
	if e == nil {
		return tokDiff("parse produced no expr", src, "")
	}
	var out @[]readonly char = FormatExpr(e)
	if !streq(out, want) {
		return tokDiff("expr format mismatch", out, want)
	}
	return ""
}

func TestPrintExprLiterals() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("x")
	if len(r) > 0 { return r }
	r = checkExpr("42")
	if len(r) > 0 { return r }
	r = checkExpr("3.14")
	if len(r) > 0 { return r }
	r = checkExpr("\"hi\"")
	if len(r) > 0 { return r }
	r = checkExpr("'a'")
	if len(r) > 0 { return r }
	r = checkExpr("true")
	if len(r) > 0 { return r }
	r = checkExpr("false")
	if len(r) > 0 { return r }
	r = checkExpr("nil")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprBinaryPrec() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("a + b * c")
	if len(r) > 0 { return r }
	r = checkExpr("a * b + c")
	if len(r) > 0 { return r }
	r = checkExpr("(a + b) * c")
	if len(r) > 0 { return r }
	r = checkExpr("a - b - c")
	if len(r) > 0 { return r }
	r = checkExpr("a - (b - c)")
	if len(r) > 0 { return r }
	r = checkExpr("a && b || c")
	if len(r) > 0 { return r }
	r = checkExpr("a || b && c")
	if len(r) > 0 { return r }
	r = checkExpr("a & b | c ^ d")
	if len(r) > 0 { return r }
	r = checkExpr("x << 2 + 1")
	if len(r) > 0 { return r }
	return ""
}

// Comparison operators are non-associative: a same-precedence comparison operand
// must keep its parentheses (dropping them re-parses as an illegal chain).  The
// token gate catches a dropped paren (token count differs).
func TestPrintExprCompareNonAssoc() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("(a == b) != (c == d)")
	if len(r) > 0 { return r }
	r = checkExpr("(a < b) == (c < d)")
	if len(r) > 0 { return r }
	r = checkExpr("(a == b) == c")
	if len(r) > 0 { return r }
	r = checkExpr("a == (b == c)")
	if len(r) > 0 { return r }
	r = checkExpr("(x.Kind == K) != (y.Kind == K)")
	if len(r) > 0 { return r }
	// A comparison whose operand is a lower-precedence op still parenthesizes.
	r = checkExpr("(a || b) == c")
	if len(r) > 0 { return r }
	return ""
}

// Adjacent string literals keep their boundaries (not merged into one literal):
// the token gate catches a merge (two STRING tokens would become one).
func TestPrintExprAdjacentStrings() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("\"a\" \"b\"")
	if len(r) > 0 { return r }
	r = checkExpr("\"foo\" \"bar\" \"baz\"")
	if len(r) > 0 { return r }
	// A plain single literal is unaffected.
	r = checkExpr("\"solo\"")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprCompare() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("a == b")
	if len(r) > 0 { return r }
	r = checkExpr("a < b && c >= d")
	if len(r) > 0 { return r }
	r = checkExpr("x != nil")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprUnary() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("-x")
	if len(r) > 0 { return r }
	r = checkExpr("!ok")
	if len(r) > 0 { return r }
	r = checkExpr("*p")
	if len(r) > 0 { return r }
	r = checkExpr("&x")
	if len(r) > 0 { return r }
	r = checkExpr("~m")
	if len(r) > 0 { return r }
	r = checkExpr("-a + b")
	if len(r) > 0 { return r }
	r = checkExpr("-(a + b)")
	if len(r) > 0 { return r }
	// Adjacent prefix operators that must keep a space, else they merge into a
	// single token (`--` DEC, `++` INC, `&&` LAND).
	r = checkExpr("- -x")
	if len(r) > 0 { return r }
	r = checkExpr("+ +x")
	if len(r) > 0 { return r }
	r = checkExpr("& &x")
	if len(r) > 0 { return r }
	// `* *p` / `! !b` / `~ ~m` do NOT collide, so they print tight.
	r = checkExprGolden("* *p", "**p")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprPostfix() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("f(x)")
	if len(r) > 0 { return r }
	r = checkExpr("f()")
	if len(r) > 0 { return r }
	r = checkExpr("g(a, b)")
	if len(r) > 0 { return r }
	r = checkExpr("g(a + b, -c)")
	if len(r) > 0 { return r }
	r = checkExpr("arr[i]")
	if len(r) > 0 { return r }
	r = checkExpr("s[1:2]")
	if len(r) > 0 { return r }
	r = checkExpr("s[:2]")
	if len(r) > 0 { return r }
	r = checkExpr("s[1:]")
	if len(r) > 0 { return r }
	r = checkExpr("s[:]")
	if len(r) > 0 { return r }
	r = checkExpr("p.x")
	if len(r) > 0 { return r }
	r = checkExpr("a.b.c")
	if len(r) > 0 { return r }
	r = checkExpr("(*p).x")
	if len(r) > 0 { return r }
	r = checkExpr("f().g")
	if len(r) > 0 { return r }
	r = checkExpr("f(a).b[i]")
	if len(r) > 0 { return r }
	// Binary-headed postfix requires parenthesizing the head.
	r = checkExpr("(a + b).f")
	if len(r) > 0 { return r }
	r = checkExpr("(a + b)[i]")
	if len(r) > 0 { return r }
	// Slice-spread call: the `...` on the final argument must survive.
	r = checkExpr("f(a...)")
	if len(r) > 0 { return r }
	r = checkExpr("f(a, b...)")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprComposite() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("Point{x: 1, y: 2}")
	if len(r) > 0 { return r }
	r = checkExpr("Foo{1, 2}")
	if len(r) > 0 { return r }
	r = checkExpr("Foo{}")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintExprInstantiate() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("Vec[int]")
	if len(r) > 0 { return r }
	r = checkExpr("f[int]")
	if len(r) > 0 { return r }
	r = checkExpr("f[@T]")
	if len(r) > 0 { return r }
	r = checkExpr("f[@[]int]")
	if len(r) > 0 { return r }
	r = checkExpr("f[*int]")
	if len(r) > 0 { return r }
	return ""
}

// Parens dropped as noise are re-derived: these assert the exact canonical
// output rather than token-equality (dropping a paren changes the token count).
// A paren around a primary/atom ("one thing inside") and a top-level parenthesized
// expression (not an operand of another operator) are dropped; nested layers
// collapse.
func TestPrintExprParenCanon() testing.TestResult {
	var r testing.TestResult
	r = checkExprGolden("((x))", "x")
	if len(r) > 0 { return r }
	r = checkExprGolden("(a + b)", "a + b")
	if len(r) > 0 { return r }
	r = checkExprGolden("(x)", "x")
	if len(r) > 0 { return r }
	r = checkExprGolden("(f(a))", "f(a)")
	if len(r) > 0 { return r }
	r = checkExprGolden("(-x) + y", "-x + y")
	if len(r) > 0 { return r }
	return ""
}

// Author parens around a BINARY operand are preserved even when precedence makes
// them redundant -- they disambiguate the operator order for a reader, which
// Binate's C-like precedence (`<<` looser than `+`/`-`, `|` loosest) makes
// non-obvious.  Preserved parens are token-exact, so checkExpr applies.
func TestPrintExprAuthorParens() testing.TestResult {
	var r testing.TestResult
	r = checkExpr("1 << (64 - n)")
	if len(r) > 0 { return r }
	r = checkExpr("(x << 63) | y")
	if len(r) > 0 { return r }
	r = checkExpr("a + (b * c)")
	if len(r) > 0 { return r }
	r = checkExpr("(a * b) + c")
	if len(r) > 0 { return r }
	r = checkExpr("m != (cast(uint64, 1) << 63)")
	if len(r) > 0 { return r }
	// Nested author layers collapse to a single preserved pair.
	r = checkExprGolden("((a + b)) * c", "(a + b) * c")
	if len(r) > 0 { return r }
	r = checkExprGolden("x + ((a - b))", "x + (a - b)")
	if len(r) > 0 { return r }
	return ""
}
