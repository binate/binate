package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// An expression prints the comments inside it that no list or operator chain
// prints where the source put them: after a prefix operator (`-/* c */ x`), before
// and after a selector's or a type assertion's `.` (`x /* c */ .y`, `x. // c` /
// `y`), after a slice's `[` and its `:`, and between a call's or an index's head and
// its `(` or `[` (a builtin with a type operand prints its operands' own,
// printBuiltin).  They are claimed by position, as a list's are
// (print_listcomments.bn), so every rendering prints them again, each gap after
// what precedes it has been rendered.  The key is a token of the expression's own
// that no list or chain keys by: a unary's operand's start (its operator can start a
// list's element), a selector's name, and the `.`, `[` or `(` of the others.  The
// syntax tree has no position for a selector's `.`: the comments after it are those
// right before its name (claimBeforeToken).  Before a `.`, a `(` or a `[`, where a
// line break would end the expression, only block comments on one line can stand
// (claimInlineGap), and those inside the head that no list prints go there too;
// after an operator, a `.`, a `[` or a `:` a line comment can stand as well, and the
// expression goes on at a continuation line, two tabs in from the line's.

// writeExprGap writes the comments cs of the gap after a token after which a line
// may break, glued to the token (writeGapComments), and what separates them from
// what follows: a space, or a line break to a continuation line when one needs it.
func writeExprGap(b @strings.Builder, cs @[]@token.Comment) {
	if len(cs) == 0 { return }
	var cont int = currentLineIndent(b) + 2
	if writeGapComments(b, cs, cont, true) {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else {
		b.WriteByte(' ')
	}
}

// writeHeadGap writes the block comments on one line between head x and hi, where
// the token that follows it (a `.`, `(` or `[`) or the comments after that begin,
// after x and inside it where no list prints them, keyed by key (claimInlineGap).
func writeHeadGap(b @strings.Builder, x @ast.Expr, hi token.Pos, key token.Pos) {
	if x == nil { return }
	_ = writeInlineComments(b, claimInlineGap(exprStartPos(x), hi, key))
}

// claimBeforeToken returns the comments right before the token at at -- those whose
// Before is at -- that the expression keyed key prints, as claimGap does for a gap
// whose start has no known position, and claims them.
func claimBeforeToken(at token.Pos, key token.Pos) @[]@token.Comment {
	var out @vec.Vec[@token.Comment] = vec.New[@token.Comment]()
	var cc @commentCursor = activeCursor
	if cc == nil || at.Line == 0 || key.Line == 0 { return out.Items() }
	for k := firstBefore(cc, at); k < len(cc.comments) && posLess(cc.comments[k].Pos, at); k++ {
		if claimHold.Line > 0 && !posLess(cc.comments[k].Pos, claimHold) { break }
		var owned bool = len(cc.owner) > 0 && samePos(cc.owner[k], key)
		if owned || (k >= cc.idx && !isDone(cc, k)) {
			claimComment(cc, k, key)
			out.Push(cc.comments[k])
		}
	}
	return out.Items()
}

// firstBefore returns the index of cc's first comment right before the token at at
// (whose Before is at), or that of the first comment after at when there is none.
func firstBefore(cc @commentCursor, at token.Pos) int {
	var k int = firstAfter(cc, at)
	for k > 0 && samePos(cc.comments[k - 1].Before, at) {
		k = k - 1
	}
	return k
}

// beforeTokenStart returns where the comments right before the token at at begin:
// the first one's position, or at when there are none.
func beforeTokenStart(at token.Pos) token.Pos {
	var cc @commentCursor = activeCursor
	if cc == nil || at.Line == 0 { return at }
	var k int = firstBefore(cc, at)
	if k < len(cc.comments) && posLess(cc.comments[k].Pos, at) { return cc.comments[k].Pos }
	return at
}

// claimUnaryGap claims the comments between prefix operator e and its operand.
func claimUnaryGap(e @ast.Expr) @[]@token.Comment {
	if e.X == nil {
		var none @[]@token.Comment
		return none
	}
	var start token.Pos = exprStartPos(e.X)
	return claimGap(e.Pos, start, start)
}

// starHidesArray reports whether a `*` (op) whose operand x is written after
// comments would hide from x's left edge, an array literal, the `*` it follows
// (followsStar): x then takes parentheses of its own, as `*` then `[` begins a
// raw-slice literal however many comments lie between them.
func starHidesArray(op int, x @ast.Expr) bool {
	if cast(token.Type, op) != token.STAR || x == nil { return false }
	var l @ast.Expr = exprLeftmost(x)
	return l.Kind == ast.EXPR_COMPOSITE && isArrayLit(l)
}
