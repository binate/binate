package "pkg/binate/format"

import "pkg/builtins/testing"

// The comments inside an expression that no list or chain prints stay where the source put
// them: after a prefix operator (with no space to keep two operators apart, and with
// parentheses around a `*`'s operand that begins with an array literal), before and after a
// selector's or a type assertion's `.`, before a call's `(` and an index's `[`, after a
// slice's `[` and `:`.  A line comment after an operator, a `.` or a `:` continues the
// expression on a continuation line, as it does after a binary operator.
func TestExprCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := -/* c */ y // d\n"
			"\tp = - // e\n"
			"\t\tq\n"
			"\tnn := - /* u */ -x\n"
			"\tst := */* t */ ([2]int{1, 2})[0]\n"
			"\tr := a /* f */ .b\n"
			"\ts := a. /* g */ b\n"
			"\tt := a. // h\n"
			"\t\tb\n"
			"\ts2 := f() /* g1 */ . /* g2 */ b\n"
			"\tt2 := f(). // h2\n"
			"\t\tb\n"
			"\taa := a /* x1 */ .b /* x2 */ .c(1) /* x3 */ .d\n"
			"\tu := v /* i */ .(T)\n"
			"\tw := v.( /* j */ T)\n"
			"\tk := m /* l */ [1]\n"
			"\tn := f /* o */ (1)\n"
			"\tz := s[ /* p */ 1: /* q */ 2]\n"
			"\ty2 := s[1: // r\n"
			"\t\t2]\n"
			"\ty3 := s[: /* s */ 2]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := -/* c */ y // d\n"
			"\tp = - // e\n"
			"\t\t\tq\n"
			"\tnn := -/* u */ -x\n"
			"\tst := */* t */ ([2]int{1, 2}[0])\n"
			"\tr := a /* f */.b\n"
			"\ts := a./* g */ b\n"
			"\tt := a. // h\n"
			"\t\t\tb\n"
			"\ts2 := f() /* g1 */./* g2 */ b\n"
			"\tt2 := f(). // h2\n"
			"\t\t\tb\n"
			"\taa := a /* x1 */.b /* x2 */.c(1) /* x3 */.d\n"
			"\tu := v /* i */.(T)\n"
			"\tw := v.(/* j */ T)\n"
			"\tk := m /* l */[1]\n"
			"\tn := f /* o */(1)\n"
			"\tz := s[/* p */ 1:/* q */ 2]\n"
			"\ty2 := s[1: // r\n"
			"\t\t\t2]\n"
			"\ty3 := s[:/* s */ 2]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// In a header the comments in a condition's unary operand or selector stay there, a line
// comment's continuation two tabs in from the header's line, and so do those of a switch's tag
// and its case labels.
func TestExprCommentsInHeaders() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif !/* a */ x {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaa && !// b\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb { // "
			"c\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch -/* d */ x {\n"
			"\tcase - /* e */ 1, a. /* f */ b:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := 0; i < s. // g\n"
			"\t\t\tn; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif !/* a */ x {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaa &&\n"
			"\t\t\t! // b\n"
			"\t\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb {"
			" // c\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch -/* d */ x {\n"
			"\tcase -/* e */ 1, a./* f */ b:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := 0; i < s. // g\n"
			"\t\t\tn; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// The comments inside a list's element stay there, and a line comment among them makes the list
// wrap; a statement whose inner comment stays in place leaves room for its trailing comment on
// its last line.  Past STABLE_LIST_DEPTH a line comment after a unary operator or a `.` does
// the same, and a `// LONG-LINE ALLOWED` line keeps a block comment in place.
func TestExprCommentsInListsAndDeepNests() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tqqqqqqqqqqqqq = -/* a */ fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, ccccccc"
			"ccccccccc) // a long trailing comment pushing\n"
			"\tx := h(aaaaaaaaaaaaaaa, - // b\n"
			"\t\tbbbbbbbbbbbbbbb, ccccccccccccccc)\n"
			"\ty := h(aaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccc"
			"ccc. /* c */ dddddddddddddddddddd)\n"
			"\tv := s[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: // d\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb]\n"
			"\tt := T{k: -/* e */ v, kk: a. // f\n"
			"\t\tb}\n"
			"\tu := aaaaaaaaaaaaaaaaaaa(-/* g */ bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccc"
			"cccccccccc.dddddddddddddddddddd) // LONG-LINE ALLOWED\n"
			"\tz := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaaaaaaaaaaaaaaaaaaaa, - // h\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)))))))))))))\n"
			"\tw := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaaaaaaaaaaaaaaaaaaaa, x. // i\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tqqqqqqqqqqqqq = -/* a */ fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccc) // a long trailing comment pushing\n"
			"\tx := h(aaaaaaaaaaaaaaa, - // b\n"
			"\t\t\tbbbbbbbbbbbbbbb, ccccccccccccccc)\n"
			"\ty := h(aaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccc./* c */ dddddddddddddddddd"
			"dd)\n"
			"\tv := s[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: // d\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb]\n"
			"\tt := T{k: -/* e */ v, kk: a. // f\n"
			"\t\t\tb}\n"
			"\tu := aaaaaaaaaaaaaaaaaaa(-/* g */ bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccc"
			"cccccccccc.dddddddddddddddddddd) // LONG-LINE ALLOWED\n"
			"\tz := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t- // h\n"
			"\t\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)))))))))))))\n"
			"\tw := hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(hh(aaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tx. // i\n"
			"\t\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A builtin with a type operand keeps the comments after its keyword, which go after its `(`,
// and those between its operands after the comma, as a value builtin and a call do; a line
// comment among them continues the operands on a line two tabs in.
func TestExprCommentsInTypeOperandBuiltins() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := bit_cast(*uint8, /* a */ y)\n"
			"\tx = bit_cast(/* b */ *int, y)\n"
			"\tx = cast(int /* c */, y)\n"
			"\tx = make(/* d */ T)\n"
			"\tx = cast /* e */ (int, y)\n"
			"\tx = cast( // f\n"
			"\t\tint, y)\n"
			"\tx = cast(int, // g\n"
			"\t\ty)\n"
			"\tf(cast(int, /* h */ y), z)\n"
			"\treturn bit_cast(*uint8, /* i */ bit_cast(/* j */ *int, &p)[0])\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := bit_cast(*uint8, /* a */ y)\n"
			"\tx = bit_cast(/* b */ *int, y)\n"
			"\tx = cast(int, /* c */ y)\n"
			"\tx = make(/* d */ T)\n"
			"\tx = cast(/* e */ int, y)\n"
			"\tx = cast( // f\n"
			"\t\t\tint, y)\n"
			"\tx = cast(int, // g\n"
			"\t\t\ty)\n"
			"\tf(cast(int, /* h */ y), z)\n"
			"\treturn bit_cast(*uint8, /* i */ bit_cast(/* j */ *int, &p)[0])\n"
			"}\n"
	return checkFormatGolden(src, want)
}
