package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"

// Where a statement or an expression starts.  The gap before an expression ends at
// the first token of it that bnfmt writes: the `(` of the parentheses the source puts
// around a node at its left edge, where bnfmt prints them too, which then print the
// comments after it (parenOpenGap); where bnfmt drops them, the comments after their
// `(` go with the gap before, before the expression.  Whether bnfmt prints a node in
// parentheses depends on what prints it (keptStart): an operator's operand, a
// unary's, a postfix form's head, a composite literal of a type name in a control
// clause's condition, or an array literal right after a `*`.

// stmtStartPos returns the position of s's first token, where its leading
// comments end and a blank line before it is measured to.  That is not always
// s.Pos: an assignment's or `++` / `--` statement's Pos is its operator's, and
// an expression statement's is its expression's (exprStartPos), so a comment
// inside a left operand that spans lines -- `func() { // c` … `}()` -- would be
// taken for one before the statement.
func stmtStartPos(s @ast.Stmt) token.Pos {
	var k int = s.Kind
	if k == ast.STMT_EXPR || k == ast.STMT_INC_DEC { return exprStartPos(s.X) }
	if (k == ast.STMT_ASSIGN || k == ast.STMT_SHORT_VAR) && len(s.Exprs) > 0 {
		return exprStartPos(s.Exprs[0])
	}
	return s.Pos
}

// stmtCondStartPos is stmtStartPos for s in a C-style loop's header, its init or
// post, whose expressions print as a condition's (printSimpleStmtCond, condStartPos).
func stmtCondStartPos(s @ast.Stmt) token.Pos {
	var k int = s.Kind
	if k == ast.STMT_EXPR || k == ast.STMT_INC_DEC { return condStartPos(s.X) }
	if (k == ast.STMT_ASSIGN || k == ast.STMT_SHORT_VAR) && len(s.Exprs) > 0 {
		return condStartPos(s.Exprs[0])
	}
	return s.Pos
}

// exprStartPos returns the position of e's first token that bnfmt writes, where what
// prints e writes no parentheses around it and it is not in a control clause's
// condition (keptStart).
func exprStartPos(e @ast.Expr) token.Pos {
	return keptStart(e, false, false, false)
}

// condStartPos is exprStartPos for e in a control clause's condition, where a
// composite literal of a type name at its left edge keeps its parentheses
// (compositeParens).
func condStartPos(e @ast.Expr) token.Pos {
	return keptStart(e, false, true, false)
}

// operandStartPos is exprStartPos for e, the right operand of operator op of
// precedence prec (binOperandParens), in a control clause's condition when exposed.
func operandStartPos(e @ast.Expr, prec int, op int, exposed bool) token.Pos {
	return keptStart(e, binOperandParens(e, prec, op, false), exposed, false)
}

// unaryOperandStart is exprStartPos for the operand of prefix operator e
// (unaryParens), in a control clause's condition when exposed.
func unaryOperandStart(e @ast.Expr, exposed bool) token.Pos {
	return keptStart(e.X, unaryParens(e), exposed, cast(token.Type, e.Op) == token.STAR)
}

// dotHeadStartPos is exprStartPos for e, the head of a postfix form that begins with
// a `.` (dotHeadParens), in a control clause's condition when exposed: a type
// switch's scrutinee.
func dotHeadStartPos(e @ast.Expr, exposed bool) token.Pos {
	return keptStart(e, dotHeadParens(e), exposed, false)
}

// keptStart returns the position of e's first token that bnfmt writes: the `(`
// (parenOpen) of the first node at e's left edge -- e, then each one's left operand
// (leftOperand) -- that the source parenthesizes and bnfmt prints in parentheses, or
// else e's first token inside them all (tokenStartPos).  kept says whether what
// prints e writes parentheses around it; one below e is printed in them by its
// parent's printer (childParens), and a composite literal by its own
// (compositeParens), exposed in a control clause's condition and afterStar right
// after a `*` until bnfmt writes a `(` at the left edge.
func keptStart(e @ast.Expr, kept bool, exposed bool, afterStar bool) token.Pos {
	var n @ast.Expr = e
	for n != nil {
		if !kept && n.Kind == ast.EXPR_COMPOSITE { kept = compositeParens(n, exposed, afterStar) }
		if kept {
			if n.Parenthesized {
				var open token.Pos = parenOpen(n)
				if open.Line > 0 { return open }
			}
			exposed = false
			afterStar = false
		}
		var x @ast.Expr = leftOperand(n)
		if x != nil { kept = childParens(n, x) }
		n = x
	}
	return tokenStartPos(e)
}

// childParens reports whether p's printer writes parentheses around x, its left
// operand (leftOperand): an operator's (binOperandParens), a selector's or a type
// assertion's head (dotHeadParens), or another postfix form's (postfixHeadParens).
func childParens(p @ast.Expr, x @ast.Expr) bool {
	var k int = p.Kind
	if k == ast.EXPR_BINARY { return binOperandParens(x, binopPrec(p.Op), p.Op, true) }
	if k == ast.EXPR_SELECTOR || k == ast.EXPR_TYPE_ASSERT { return dotHeadParens(x) }
	return postfixHeadParens(x)
}

// innerStartPos returns the position of the first token bnfmt writes inside the
// parentheses it prints around e: that of e's left operand (keptStart), or e's own
// first token when it has none.
func innerStartPos(e @ast.Expr) token.Pos {
	var x @ast.Expr = leftOperand(e)
	if x == nil { return tokenStartPos(e) }
	return keptStart(x, childParens(e, x), false, false)
}

// parenOpen returns the position of the `(` of the innermost of the parentheses the
// source puts around e: the innermost bracket pair around the span from e's first
// token inside them to its Pos (openAround) -- e's operator, name or literal, or its
// own `(`, `[` or `{`, which no bracket inside e holds.  Of nested layers (`((a +
// b))`), bnfmt prints one pair at most, so a comment between their `(`s goes with
// the gap before.  The zero Pos when the source does not parenthesize e or its
// bracket pairs are unknown.
func parenOpen(e @ast.Expr) token.Pos {
	if !e.Parenthesized {
		var none token.Pos
		return none
	}
	return openAround(tokenStartPos(e), e.Pos)
}

// tokenStartPos returns the position of e's first token other than a `(`: that of
// its leftmost operand (exprLeftmost), or for a composite literal, whose Pos is its
// `{`, its type's (typeStartPos).  A gap after e, or inside it, starts there, short
// of the comments after the `(`s before it, which those print (parenOpenGap).
func tokenStartPos(e @ast.Expr) token.Pos {
	var l @ast.Expr = exprLeftmost(e)
	if l.Kind == ast.EXPR_COMPOSITE && l.TypeRef != nil { return typeStartPos(l.TypeRef) }
	return l.Pos
}

// leftOperand returns the operand at e's left edge that its first token is in: a
// call's, index's, slice's, selector's, type assertion's or binary expression's X,
// whose Pos is its operator's (`(`, `[`, `.`, `+`) or, a selector's, its name's; nil
// for any other expression.
func leftOperand(e @ast.Expr) @ast.Expr {
	var k int = e.Kind
	if k == ast.EXPR_CALL || k == ast.EXPR_SELECTOR || k == ast.EXPR_INSTANTIATE_OR_INDEX ||
			k == ast.EXPR_SLICE || k == ast.EXPR_TYPE_ASSERT || k == ast.EXPR_BINARY {
		return e.X
	}
	return nil
}

// exprLeftmost returns the operand at e's left edge: its left operand's, and so on
// (leftOperand), so `func() { … }()[0]` starts with its function literal.
func exprLeftmost(e @ast.Expr) @ast.Expr {
	var x @ast.Expr = leftOperand(e)
	for x != nil {
		e = x
		x = leftOperand(e)
	}
	return e
}

// typeStartPos returns the position of a type expression's first token.  A
// generic instantiation's Pos is its `[`, after the type it instantiates (Base),
// so its start is Base's.
func typeStartPos(te @ast.TypeExpr) token.Pos {
	for te.Kind == ast.TEXPR_INSTANTIATE && te.Base != nil {
		te = te.Base
	}
	return te.Pos
}
