package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for where an expression starts (print_exprstart.bn): the comments after the
// `(` of the parentheses the source puts around it (parenOpenGap).

// A comment right after the `(` of parentheses the source puts around an expression,
// where bnfmt prints them too, stays after it: around an operator's operand, a unary's,
// a postfix form's head (a statement's start, a conversion's type), an array literal
// after a `*`, and a composite literal of a type name in a control clause's condition --
// an `if`'s, a loop's, its init and post statements included, and a switch's -- and a
// comment before such a pair's `)` stays before it in a call's arguments too.  So do
// those in a composite literal's only element and on a `// LONG-LINE ALLOWED` line.  Of
// nested layers bnfmt prints one pair, so a comment between their `(`s goes before it.
func TestOpenerCommentsOfKeptParensStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = (/* c */ a + b) * c\n"
			"\ty := -(/* c */ a + b)\n"
			"\tv := (/* c */ a + b)[0]\n"
			"\t(/* c */ a + b).f()\n"
			"\tg((/* c */ a + b) * c)\n"
			"\tv = x[(/* c */ a + b) * c]\n"
			"\ts := (/* c */ /* d */ a + b) * c\n"
			"\tw := (/* o */ (/* c */ a + b) * c).f\n"
			"\tn := ((/* c */ a + b)) * c\n"
			"\tm := (/* o */ (a + b)) * c\n"
			"\tt := (/* c */ *T)(y)\n"
			"\tu := *(/* c */ [2]int{1})\n"
			"\tq := *(/* c */ [2]int{1}[0])\n"
			"\tr := *(/* c */ [2]int{1})[0]\n"
			"\tp := a * (/* c */ b + c)\n"
			"\tg((a + b /* c */) * c)\n"
			"\tv = @[]int{(/* c */ a + b) * c}\n"
			"\tw = T{k: (/* c */ a + b) * c}\n"
			"\tx = a * (/* c */ b + c) // LONG-LINE ALLOWED\n"
			"\tif (/* c */ T{1}) == d {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif a == (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor x in (/* c */ T{1}).s {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor (/* c */ T{1}).f(); (/* c */ T{1}).ok; (/* c */ T{1}).f() {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor (/* c */ T{1}).ok {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; ; x = (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; ; x, y = 1, (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch (/* c */ T{1}).(type) {\n"
			"\t}\n"
			"\tswitch (/* c */ T{1}).k {\n"
			"\t}\n"
			"\treturn (/* c */ a + b) * c\n"
			"}\n"
			"\n"
			"var v = (/* c */ a + b) * c\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = (/* c */ a + b) * c\n"
			"\ty := -(/* c */ a + b)\n"
			"\tv := (/* c */ a + b)[0]\n"
			"\t(/* c */ a + b).f()\n"
			"\tg((/* c */ a + b) * c)\n"
			"\tv = x[(/* c */ a + b) * c]\n"
			"\ts := (/* c */ /* d */ a + b) * c\n"
			"\tw := (/* o */ (/* c */ a + b) * c).f\n"
			"\tn := (/* c */ a + b) * c\n"
			"\tm := /* o */ (a + b) * c\n"
			"\tt := (/* c */ *T)(y)\n"
			"\tu := *(/* c */ [2]int{1})\n"
			"\tq := *(/* c */ [2]int{1}[0])\n"
			"\tr := *(/* c */ [2]int{1})[0]\n"
			"\tp := a * (/* c */ b + c)\n"
			"\tg((a + b /* c */) * c)\n"
			"\tv = @[]int{(/* c */ a + b) * c}\n"
			"\tw = T{k: (/* c */ a + b) * c}\n"
			"\tx = a * (/* c */ b + c) // LONG-LINE ALLOWED\n"
			"\tif (/* c */ T{1}) == d {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif a == (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor x in (/* c */ T{1}).s {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor (/* c */ T{1}).f(); (/* c */ T{1}).ok; (/* c */ T{1}).f() {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor (/* c */ T{1}).ok {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; ; x = (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; ; x, y = 1, (/* c */ T{1}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch (/* c */ T{1}).(type) {\n"
			"\t}\n"
			"\tswitch (/* c */ T{1}).k {\n"
			"\t}\n"
			"\treturn (/* c */ a + b) * c\n"
			"}\n"
			"\n"
			"var v = (/* c */ a + b) * c\n"
	return checkFormatGolden(src, want)
}

// After a line comment, or a block comment spanning lines, right after a kept `(`, the
// expression in the parentheses goes on at a continuation line two tabs in from the
// line's, as after a call's `(`; one on a line of its own stays on one.  An operand of
// a wrapped operator chain keeps its comment the same way.
func TestOpenerCommentsOfKeptParensBreak() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tz := a * ( // c\n"
			"\t\tb + c)\n"
			"\tz = g(( // c\n"
			"\t\ta + b) * c)\n"
			"\tz = a * (\n"
			"\t\t// c\n"
			"\t\tb + c)\n"
			"\tz = (/* c\n"
			"\t*/ a + b) * d\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + "
			"(/* c */ b + c)\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + (/* c */ b + c) + "
			"dddddddddddddddddddddddddddddddddddddddd + e\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + ( // c\n"
			"\t\tb + c) + dddddddddddddddddddddddddddddddddddddddd + e\n"
			"\tr := *( // c\n"
			"\t\t[2]int{1})[0]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tz := a * ( // c\n"
			"\t\t\tb + c)\n"
			"\tz = g(( // c\n"
			"\t\t\ta + b) * c)\n"
			"\tz = a * (\n"
			"\t\t\t// c\n"
			"\t\t\tb + c)\n"
			"\tz = (/* c\n"
			"\t*/\n"
			"\t\t\ta + b) * d\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa +\n"
			"\t\t\t(/* c */ b + c)\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + (/* c */ b + c) +\n"
			"\t\t\tdddddddddddddddddddddddddddddddddddddddd + e\n"
			"\tx = aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + ( // c\n"
			"\t\t\tb + c) + dddddddddddddddddddddddddddddddddddddddd + e\n"
			"\tr := *( // c\n"
			"\t\t\t[2]int{1})[0]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Where bnfmt drops the parentheses, the comments after their `(` go before the
// expression, with the comments of the gap before it, as they would with no `(`.
func TestOpenerCommentsOfDroppedParensGoBefore() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tz := (/* c */ a).f\n"
			"\tx := ( // c\n"
			"\t\ta).f\n"
			"\tg(( // c\n"
			"\t\ta), b)\n"
			"\ty := -( // c\n"
			"\t\ta)\n"
			"\tw := ( // c\n"
			"\t\ta + b)\n"
			"\tv := (\n"
			"\t\t// c\n"
			"\t\ta).f\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tz := /* c */ a.f\n"
			"\tx := // c\n"
			"\t\ta.f\n"
			"\tg( // c\n"
			"\t\t\ta, b)\n"
			"\ty := - // c\n"
			"\t\t\ta\n"
			"\tw := // c\n"
			"\t\ta + b\n"
			"\tv :=\n"
			"\t\t// c\n"
			"\t\ta.f\n"
			"}\n"
	return checkFormatGolden(src, want)
}
