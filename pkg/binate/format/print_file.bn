package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// Format renders a parsed file back to canonical source text: the package clause
// (with any annotation block), the canonicalized/sorted import section, then the
// top-level declarations (including function bodies).
func Format(f @ast.File) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	// Comments are interleaved by source position when the file was parsed with a
	// comment-collecting parser (cc nil otherwise); leading comments (a file
	// header) precede the package clause.
	var cc @commentCursor = newCommentCursor(f.Comments)
	var saved @commentCursor = activeCursor
	activeCursor = cc
	if emitLeadingComments(b, cc, f.Pos, 0, true) {
		b.WriteByte('\n')
	}
	printAnnotationsBefore(b, cc, f.Annotations, f.PkgPos)
	printPackageClause(b, cc, f)
	var limit token.Pos
	if len(f.Decls) > 0 {
		limit = f.Decls[0].Pos
	}
	printImports(b, cc, f.Imports, limit)
	printDecls(b, cc, f.Decls)
	// Multiset backstop: flush any comment the interleave did not place
	// (package/import-area, mid-expression).
	flushRemainingComments(b, cc, 0)
	activeCursor = saved
	return finalizeFile(b.String())
}

// finalizeFile applies file hygiene to the accumulated output: it strips trailing
// spaces and tabs from every line, drops leading/trailing blank lines, and
// terminates with exactly one newline (scripts/hygiene/file-format.sh checks 1-3,
// whose trailing-whitespace rule is exactly `[ \t]+$`).  Per-line stripping is
// needed because a comment's captured text is emitted verbatim, so a `// note   `
// line comment (or trailing spaces/tabs on the interior lines of a `/* ... */`
// block) would otherwise keep its source trailing whitespace; the printer emits
// none of its own on code lines.  This cannot corrupt a string literal: a Binate
// string cannot span lines (the lexer ends it at a newline) and its closing `"`
// always follows any interior spaces, so string whitespace never reaches
// line-end.  A CRLF block comment's interior `\r`s are left as-is -- only spaces
// and tabs are stripped (matching file-format), and the lexer likewise keeps
// block-comment interior `\r`s (line comments never carry one -- the lexer drops
// a comment's trailing CRLF `\r` as the line terminator; see lexer/scan.bn).
func finalizeFile(s @[]readonly char) @[]readonly char {
	var n int = len(s)
	for n > 0 {
		var c char = s[n - 1]
		if c != '\n' && c != ' ' && c != '\t' && c != '\r' { break }
		n = n - 1
	}
	// Strip leading blank lines: a file-leading comment is emitted with a
	// preceding newline (emitLeadingComments always separates comments), which
	// would otherwise make the file start with a blank line.
	var start int = 0
	for start < n {
		var c char = s[start]
		if c != '\n' && c != '\r' { break }
		start = start + 1
	}
	// Copy s[start:n] line by line, dropping trailing spaces/tabs from each line.
	var b @strings.Builder = strings.NewBuilder()
	var lineStart int = start
	for i := start; i < n; i = i + 1 {
		if s[i] != '\n' { continue }
		b.Write(s[lineStart:rtrimEnd(s, lineStart, i)])
		b.WriteByte('\n')
		lineStart = i + 1
	}
	b.Write(s[lineStart:rtrimEnd(s, lineStart, n)])
	b.WriteByte('\n')
	return b.String()
}

// rtrimEnd returns the end index of s[lo:hi] after dropping trailing spaces and
// tabs (hi backed up over ' '/'\t') -- the per-line trailing-whitespace strip
// finalizeFile applies to each output line.
func rtrimEnd(s *[]readonly char, lo int, hi int) int {
	for hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t') {
		hi = hi - 1
	}
	return hi
}

// printDecls emits the top-level declarations, each preceded by a blank line
// (separating it from the package/import header or the prior declaration), with
// leading own-line comments before each declaration (above its annotation block,
// if any) and a trailing comment on its last line.
func printDecls(b @strings.Builder, cc @commentCursor, decls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		emitLeadingComments(b, cc, declStartPos(decls[i]), 0, true)
		b.WriteByte('\n')
		printDeclMaybeNoWrap(b, cc, decls[i])
		emitTrailingComment(b, cc, decls[i].End)
		b.WriteByte('\n')
	}
}

// printPackageClause emits `package "<path>"` and the comments after it on its
// line, up to the first import or declaration (one joined to the line by `;`
// owns the comments from its start on).  PkgName carries the quoted path string
// exactly as the lexer captured it (quotes included).
func printPackageClause(b @strings.Builder, cc @commentCursor, f @ast.File) {
	b.Write("package ")
	b.Write(f.PkgName)
	var next token.Pos
	if len(f.Imports) > 0 {
		next = f.Imports[0].DeclPos
	} else if len(f.Decls) > 0 {
		next = declStartPos(f.Decls[0])
	}
	emitTrailingCommentBefore(b, cc, f.PkgPos, next)
	b.WriteByte('\n')
}

// strLess reports whether a sorts before b under byte-wise lexicographic order.
func strLess(a *[]readonly char, b *[]readonly char) bool {
	var n int = len(a)
	if len(b) < n {
		n = len(b)
	}
	for i := 0; i < n; i++ {
		if a[i] != b[i] {
			return a[i] < b[i]
		}
	}
	return len(a) < len(b)
}
