package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"
import "pkg/std/vec"

// Format renders a parsed file back to canonical source text: the package clause
// (with any annotation block), the canonicalized/sorted import section, then the
// top-level declarations (including function bodies).
func Format(f @ast.File) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	// Comments are interleaved by source position when the file was parsed with a
	// comment-collecting parser (cc nil otherwise); leading comments (a file
	// header) precede the package clause.
	var cc @commentCursor = newCommentCursor(f.Comments)
	if emitLeadingComments(b, cc, f.Pos, 0, true) {
		b.WriteByte('\n')
	}
	printAnnotations(b, f.Annotations)
	printPackageClause(b, f)
	printImports(b, f.Imports)
	printDecls(b, cc, f.Decls)
	// Multiset backstop: flush any comment the interleave did not place
	// (package/import-area, mid-expression, function-literal bodies).
	flushRemainingComments(b, cc, 0)
	return finalizeFile(b.String())
}

// finalizeFile applies file hygiene to the accumulated output: it strips trailing
// spaces and tabs from every line, drops leading/trailing blank lines, and
// terminates with exactly one newline (scripts/hygiene/file-format.sh checks 1-3,
// whose trailing-whitespace rule is exactly `[ \t]+$`).  Per-line stripping is
// needed because a comment's captured text is emitted verbatim, so a `// note   `
// line comment (or trailing spaces/tabs on the interior lines of a `/* ... */`
// block) would otherwise keep its source trailing whitespace; the printer emits
// none of its own on code lines.  This cannot corrupt a string literal: a Binate
// string cannot span lines (the lexer ends it at a newline) and its closing `"`
// always follows any interior spaces, so string whitespace never reaches
// line-end.  A CRLF block comment's interior `\r`s are left as-is -- only spaces
// and tabs are stripped (matching file-format), and the lexer likewise keeps
// block-comment interior `\r`s (line comments never carry one -- the lexer drops
// a comment's trailing CRLF `\r` as the line terminator; see lexer/scan.bn).
func finalizeFile(s @[]readonly char) @[]readonly char {
	var n int = len(s)
	for n > 0 {
		var c char = s[n - 1]
		if c != '\n' && c != ' ' && c != '\t' && c != '\r' { break }
		n = n - 1
	}
	// Strip leading blank lines: a file-leading comment is emitted with a
	// preceding newline (emitLeadingComments always separates comments), which
	// would otherwise make the file start with a blank line.
	var start int = 0
	for start < n {
		var c char = s[start]
		if c != '\n' && c != '\r' { break }
		start = start + 1
	}
	// Copy s[start:n] line by line, dropping trailing spaces/tabs from each line.
	var b @strings.Builder = strings.NewBuilder()
	var lineStart int = start
	for i := start; i < n; i = i + 1 {
		if s[i] != '\n' { continue }
		b.Write(s[lineStart:rtrimEnd(s, lineStart, i)])
		b.WriteByte('\n')
		lineStart = i + 1
	}
	b.Write(s[lineStart:rtrimEnd(s, lineStart, n)])
	b.WriteByte('\n')
	return b.String()
}

// rtrimEnd returns the end index of s[lo:hi] after dropping trailing spaces and
// tabs (hi backed up over ' '/'\t') -- the per-line trailing-whitespace strip
// finalizeFile applies to each output line.
func rtrimEnd(s *[]readonly char, lo int, hi int) int {
	for hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t') {
		hi = hi - 1
	}
	return hi
}

// printDecls emits the top-level declarations, each preceded by a blank line
// (separating it from the package/import header or the prior declaration), with
// leading own-line comments before each declaration and a trailing comment on
// its last line.
func printDecls(b @strings.Builder, cc @commentCursor, decls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		emitLeadingComments(b, cc, decls[i].Pos, 0, true)
		b.WriteByte('\n')
		printDeclMaybeNoWrap(b, cc, decls[i])
		emitTrailingComment(b, cc, decls[i].End)
		b.WriteByte('\n')
	}
}

// printPackageClause emits `package "<path>"`.  PkgName carries the quoted path
// string exactly as the lexer captured it (quotes included).
func printPackageClause(b @strings.Builder, f @ast.File) {
	b.Write("package ")
	b.Write(f.PkgName)
	b.WriteByte('\n')
}

// printImports emits the import section: every import on its own line (a grouped
// `import (...)` collapses to per-line form), sorted within each blank-line-
// delimited run.  A blank line precedes the section and separates runs, matching
// house style and scripts/hygiene/file-format.sh check 4.
//
// The AST is form-agnostic (@[]@ast.ImportSpec records neither grouped-vs-per-
// line nor blank lines), so runs are recovered from source line gaps: two
// consecutive specs whose ImportSpec.Pos lines differ by more than one were
// separated by a blank line and start distinct runs.  (Annotations/comments
// between imports can perturb this heuristic; those are handled in later steps.)
func printImports(b @strings.Builder, imports @[]@ast.ImportSpec) {
	if len(imports) == 0 {
		return
	}
	b.WriteByte('\n')
	var runStart int = 0
	for i := 1; i <= len(imports); i++ {
		var boundary bool = false
		if i == len(imports) {
			boundary = true
		} else if imports[i].Pos.Line - imports[i - 1].Pos.Line > 1 {
			boundary = true
		}
		if boundary {
			if runStart > 0 {
				b.WriteByte('\n')
			}
			printImportRun(b, imports, runStart, i)
			runStart = i
		}
	}
}

// printImportRun emits imports[start:end] one-per-line, sorted by rendered line
// text (matching file-format.sh check 4, which orders on the whole `import ...`
// line).  Runs are small, so an insertion sort keeps it simple.
func printImportRun(b @strings.Builder, imports @[]@ast.ImportSpec, start int, end int) {
	var runV @vec.Vec[@ast.ImportSpec] = vec.New[@ast.ImportSpec]()
	for i := start; i < end; i++ {
		runV.Push(imports[i])
	}
	var run @[]@ast.ImportSpec = runV.Items()
	for i := 1; i < len(run); i++ {
		var j int = i
		for j > 0 && lineLess(run[j], run[j - 1]) {
			var tmp @ast.ImportSpec = run[j]
			run[j] = run[j - 1]
			run[j - 1] = tmp
			j--
		}
	}
	for i := 0; i < len(run); i++ {
		appendImport(b, run[i])
		b.WriteByte('\n')
	}
}

// appendImport writes an import's canonical line body (no trailing newline):
// `import "<path>"`, or `import <alias> "<path>"` when an alias is present.
func appendImport(b @strings.Builder, spec @ast.ImportSpec) {
	b.Write("import ")
	if len(spec.Alias) > 0 {
		b.Write(spec.Alias)
		b.WriteByte(' ')
	}
	b.Write(spec.Path)
}

// lineLess reports whether a's rendered import line sorts before b's, byte-wise
// -- the ordering file-format.sh check 4 enforces on the full line.
func lineLess(a @ast.ImportSpec, b @ast.ImportSpec) bool {
	return strLess(importLine(a), importLine(b))
}

// importLine renders an import spec to its canonical line (no trailing newline),
// used as the sort key.
func importLine(spec @ast.ImportSpec) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	appendImport(b, spec)
	return b.String()
}

// strLess reports whether a sorts before b under byte-wise lexicographic order.
func strLess(a *[]readonly char, b *[]readonly char) bool {
	var n int = len(a)
	if len(b) < n {
		n = len(b)
	}
	for i := 0; i < n; i++ {
		if a[i] != b[i] {
			return a[i] < b[i]
		}
	}
	return len(a) < len(b)
}
