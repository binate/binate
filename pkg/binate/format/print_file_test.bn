package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseFileSrc parses a whole source file and returns the AST.  Shares the
// toBytes helper defined in print_type_test.bn (same package).
func parseFileSrc(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	return mustParse(p)
}

// goldenDiff builds a failure message showing the printer's output against the
// expected text.
func goldenDiff(got *[]readonly char, want *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("format mismatch: got=`")
	b.Write(got)
	b.Write("` want=`")
	b.Write(want)
	b.WriteByte('`')
	return buf.CopyStr(b.String())
}

// checkGolden asserts Format(parse(src)) equals want exactly.  These cases use
// exact-bytes golden comparison rather than the token-equality gate (§11.1)
// because the canonicalization here (grouping collapse, sorting, blank-run
// layout) reorders tokens -- a stated normalization out of the gate's scope --
// and exact-bytes is a strictly stronger check anyway.
func checkGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var got @[]readonly char = Format(parseFileSrc(src))
	if !streq(got, want) {
		return goldenDiff(got, want)
	}
	return ""
}

// checkFileTokenEq round-trips an already-canonical file through Format and
// asserts token-equality (§11.1).  Valid only when Format preserves token order
// (input already one-per-line and sorted, so no reordering happens).
func checkFileTokenEq(src *[]readonly char) testing.TestResult {
	var out @[]readonly char = Format(parseFileSrc(src))
	return assertTokenEq(src, out)
}

// checkIdempotent asserts Format is a fixpoint: formatting its own output
// reproduces it (§11.2).
func checkIdempotent(src *[]readonly char) testing.TestResult {
	var out1 @[]readonly char = Format(parseFileSrc(src))
	var out2 @[]readonly char = Format(parseFileSrc(out1))
	if !streq(out1, out2) {
		return goldenDiff(out1, out2)
	}
	return ""
}

func TestFormatPackageOnly() testing.TestResult {
	var r testing.TestResult
	r = checkGolden("package \"pkg/x\"", "package \"pkg/x\"\n")
	if len(r) > 0 { return r }
	r = checkFileTokenEq("package \"pkg/x\"")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatCanonicalTokenEq() testing.TestResult {
	// An already-canonical file round-trips token-equal (no reordering).
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
	return checkFileTokenEq(src)
}

func TestFormatImportsSorted() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"import \"pkg/z\"\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/z\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatGroupedCollapsed() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"import (\n"
			"\t\"pkg/b\"\n"
			"\t\"pkg/a\"\n"
			")\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatImportAlias() testing.TestResult {
	// An unaliased path sorts before an aliased line: the rendered lines are
	// `import "pkg/a"` vs `import w "pkg/x"`, and '"' (0x22) < 'w'.
	var src *[]readonly char = "package \"m\"\n"
			"import w \"pkg/x\"\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import w \"pkg/x\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	r = checkFileTokenEq(want)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatImportRuns() testing.TestResult {
	// Two blank-separated runs, each independently sorted; the blank line
	// between them is preserved (recovered from the source line gap).
	var src *[]readonly char = "package \"m\"\n"
			"import \"pkg/z\"\n"
			"import \"pkg/y\"\n"
			"\n"
			"import \"pkg/b\"\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/y\"\n"
			"import \"pkg/z\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

// A single blank line between statements is preserved.
func TestFormatBlankLinePreserved() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\ta()\n"
			"\n"
			"\tb()\n"
			"}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if !containsSub(out, "a()\n\n\tb()") {
		return tokDiff("blank line not preserved", out, "a()<nl><nl><tab>b()")
	}
	return ""
}

// Multiple consecutive blank lines collapse to one.
func TestFormatBlankLineCollapsed() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\ta()\n"
			"\n"
			"\n"
			"\n"
			"\tb()\n"
			"}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if !containsSub(out, "a()\n\n\tb()") {
		return tokDiff("blanks not collapsed to one", out, "a()<nl><nl><tab>b()")
	}
	if containsSub(out, "a()\n\n\n\tb()") {
		return tokDiff("multiple blanks not collapsed", out, "(no double blank)")
	}
	return ""
}

// File hygiene: exactly one trailing newline, no trailing blank line.
func TestFormatFinalNewline() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if len(out) < 2 { return "output too short" }
	if out[len(out) - 1] != '\n' { return "no final newline" }
	if out[len(out) - 2] == '\n' { return "trailing blank line" }
	return ""
}

// Formatting is a fixpoint even with preserved blank lines.
func TestFormatIdempotentWithBlanks() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\ta()\n"
			"\n"
			"\tb()\n"
			"}\n"
	var out1 @[]readonly char = Format(parseFileSrc(src))
	var out2 @[]readonly char = Format(parseFileSrc(out1))
	if !streq(out1, out2) {
		return tokDiff("not idempotent", out1, out2)
	}
	return ""
}

// A method whose result is `Self` may end its line, followed by another method:
// a semicolon is inserted after `Self` as after a type name
// (lex.semicolon.insertion).  The formatter drops a single result's parentheses,
// and its output parses back to the same interface.
func TestFormatSelfResultLine() testing.TestResult {
	var src *[]readonly char = "package \"pkg/x\"\n\ninterface T {\n\tCopy() (Self)\n"
			"\tSame(o Self) bool\n}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if !containsSub(out, "Copy() Self\n") || !containsSub(out, "Same(o Self) bool") {
		return goldenDiff(out, "an interface with `Copy() Self` then `Same(o Self) bool`")
	}
	return checkIdempotent(src)
}

// Lines ending in a written `;` parse, and format as the same lines without it,
// at the top level and in a block — with no blank line where a semicolon was.
func TestFormatLineEndingSemicolons() testing.TestResult {
	var src *[]readonly char = "package \"pkg/x\"\n\nvar a int;\n\nfunc f() {\n\tg();\n\th();\n}\n"
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	mustParse(p)
	if len(p.Errors()) != 0 { return p.Errors()[0].Msg }
	return checkGolden(src, "package \"pkg/x\"\n\nvar a int\n\nfunc f() {\n\tg()\n\th()\n}\n")
}

// A package clause keeps the block comments between its keyword and its path where the source
// put them, and those after the path.
func TestPackageClauseKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package /* p */ /* q */ \"t\" // r\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package /* p */ /* q */ \"t\" // r\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// A line comment between `package` and the path puts the path on a continuation line, as in a
// declaration's header; the comment after the path stays on the path's line.
func TestPackageClauseLineCommentBeforeThePath() testing.TestResult {
	var src *[]readonly char = "package // c\n"
			"\"t\" // d\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package // c\n"
			"\t\t\"t\" // d\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// A path on a line after its `package` keyword keeps the comment after it on its line.
func TestPackagePathOnALaterLineKeepsItsComment() testing.TestResult {
	var src *[]readonly char = "package\n"
			"\"t\" // d\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package \"t\" // d\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// After an annotation block, and with an import joined to the line by `;`, the clause keeps its
// comments the same way.
func TestAnnotatedPackageClauseKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "#[build(os == \"l\")] package /* p */ \"t\" /* q */; import \"x\"\n"
	var want *[]readonly char = "#[build(os == \"l\")]\n"
			"package /* p */ \"t\" /* q */\n"
			"\n"
			"import \"x\"\n"
	return checkFormatGolden(src, want)
}

// A block comment over lines between `package` and the path puts the path on a continuation line.
func TestPackageClauseBlockCommentOverLines() testing.TestResult {
	var src *[]readonly char = "package /* a\n"
			"   b */ \"t\"\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package /* a\n"
			"   b */\n"
			"\t\t\"t\"\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// The path goes on at a continuation line when it does not fit after the block comments before it.
func TestPackagePathWrapsAfterItsComments() testing.TestResult {
	var src *[]readonly char = "package /* a block comment of some forty chars. */ /* a block comment "
			"of some forty chars. */ \"pkg/t\"\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package /* a block comment of some forty chars. */ /* a block comment"
			" of some forty chars. */\n"
			"\t\t\"pkg/t\"\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// A package clause on one line that bears the `// LONG-LINE ALLOWED` marker stays on it, past the
// cap, as a marked declaration does.
func TestMarkedPackageClauseStaysWhole() testing.TestResult {
	var src *[]readonly char = "package /* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx */ \"t\" // LONG-LINE ALLOWED\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package /* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx */ \"t\" // LONG-LINE ALLOWED\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}

// A package clause alone in its file keeps its comments: no import or declaration follows to end
// the ones after its path.
func TestPackageClauseAloneKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package /* p */ \"t\" // r\n"
	var r testing.TestResult = checkFormatGolden(src, src)
	if len(r) > 0 { return r }
	return checkFormatGolden("package // c\n\"t\" // d\n", "package // c\n\t\t\"t\" // d\n")
}

// The marker keeps a package clause whole only on one line: a clause whose path, bearing the
// marker, is on a later line is laid out as an unmarked one is.
func TestMarkedPathOnALaterLineStillWraps() testing.TestResult {
	var src *[]readonly char = "package /* a block comment of some forty chars. */ /* a block comment "
			"of some forty chars. */\n"
			"\"pkg/t\" // LONG-LINE ALLOWED\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package /* a block comment of some forty chars. */ /* a block comment"
			" of some forty chars. */\n"
			"\t\t\"pkg/t\" // LONG-LINE ALLOWED\n"
			"\n"
			"func f() {}\n"
	return checkFormatGolden(src, want)
}
