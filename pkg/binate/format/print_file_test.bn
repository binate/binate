package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseFileSrc parses a whole source file and returns the AST.  Shares the
// toBytes helper defined in print_type_test.bn (same package).
func parseFileSrc(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	return p.ParseFile()
}

// goldenDiff builds a failure message showing the printer's output against the
// expected text.
func goldenDiff(got *[]readonly char, want *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("format mismatch: got=`")
	b.Write(got)
	b.Write("` want=`")
	b.Write(want)
	b.WriteByte('`')
	return buf.CopyStr(b.String())
}

// checkGolden asserts Format(parse(src)) equals want exactly.  These cases use
// exact-bytes golden comparison rather than the token-equality gate (§11.1)
// because the canonicalization here (grouping collapse, sorting, blank-run
// layout) reorders tokens -- a stated normalization out of the gate's scope --
// and exact-bytes is a strictly stronger check anyway.
func checkGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var got @[]readonly char = Format(parseFileSrc(src))
	if !streq(got, want) {
		return goldenDiff(got, want)
	}
	return ""
}

// checkFileTokenEq round-trips an already-canonical file through Format and
// asserts token-equality (§11.1).  Valid only when Format preserves token order
// (input already one-per-line and sorted, so no reordering happens).
func checkFileTokenEq(src *[]readonly char) testing.TestResult {
	var out @[]readonly char = Format(parseFileSrc(src))
	return assertTokenEq(src, out)
}

// checkIdempotent asserts Format is a fixpoint: formatting its own output
// reproduces it (§11.2).
func checkIdempotent(src *[]readonly char) testing.TestResult {
	var out1 @[]readonly char = Format(parseFileSrc(src))
	var out2 @[]readonly char = Format(parseFileSrc(out1))
	if !streq(out1, out2) {
		return goldenDiff(out1, out2)
	}
	return ""
}

func TestFormatPackageOnly() testing.TestResult {
	var r testing.TestResult
	r = checkGolden("package \"pkg/x\"", "package \"pkg/x\"\n")
	if len(r) > 0 { return r }
	r = checkFileTokenEq("package \"pkg/x\"")
	if len(r) > 0 { return r }
	return ""
}

func TestFormatCanonicalTokenEq() testing.TestResult {
	// An already-canonical file round-trips token-equal (no reordering).
	var src *[]readonly char =
		"package \"m\"\n"
		"\n"
		"import \"pkg/a\"\n"
		"import \"pkg/b\"\n"
	return checkFileTokenEq(src)
}

func TestFormatImportsSorted() testing.TestResult {
	var src *[]readonly char =
		"package \"m\"\n"
		"import \"pkg/z\"\n"
		"import \"pkg/a\"\n"
	var want *[]readonly char =
		"package \"m\"\n"
		"\n"
		"import \"pkg/a\"\n"
		"import \"pkg/z\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatGroupedCollapsed() testing.TestResult {
	var src *[]readonly char =
		"package \"m\"\n"
		"import (\n"
		"\t\"pkg/b\"\n"
		"\t\"pkg/a\"\n"
		")\n"
	var want *[]readonly char =
		"package \"m\"\n"
		"\n"
		"import \"pkg/a\"\n"
		"import \"pkg/b\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatImportAlias() testing.TestResult {
	// An unaliased path sorts before an aliased line: the rendered lines are
	// `import "pkg/a"` vs `import w "pkg/x"`, and '"' (0x22) < 'w'.
	var src *[]readonly char =
		"package \"m\"\n"
		"import w \"pkg/x\"\n"
		"import \"pkg/a\"\n"
	var want *[]readonly char =
		"package \"m\"\n"
		"\n"
		"import \"pkg/a\"\n"
		"import w \"pkg/x\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	r = checkFileTokenEq(want)
	if len(r) > 0 { return r }
	return ""
}

func TestFormatImportRuns() testing.TestResult {
	// Two blank-separated runs, each independently sorted; the blank line
	// between them is preserved (recovered from the source line gap).
	var src *[]readonly char =
		"package \"m\"\n"
		"import \"pkg/z\"\n"
		"import \"pkg/y\"\n"
		"\n"
		"import \"pkg/b\"\n"
		"import \"pkg/a\"\n"
	var want *[]readonly char =
		"package \"m\"\n"
		"\n"
		"import \"pkg/y\"\n"
		"import \"pkg/z\"\n"
		"\n"
		"import \"pkg/a\"\n"
		"import \"pkg/b\"\n"
	var r testing.TestResult
	r = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkIdempotent(src)
	if len(r) > 0 { return r }
	return ""
}

// A single blank line between statements is preserved.
func TestFormatBlankLinePreserved() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\ta()\n"
		"\n"
		"\tb()\n"
		"}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if !containsSub(out, "a()\n\n\tb()") {
		return tokDiff("blank line not preserved", out, "a()<nl><nl><tab>b()")
	}
	return ""
}

// Multiple consecutive blank lines collapse to one.
func TestFormatBlankLineCollapsed() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\ta()\n"
		"\n"
		"\n"
		"\n"
		"\tb()\n"
		"}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if !containsSub(out, "a()\n\n\tb()") {
		return tokDiff("blanks not collapsed to one", out, "a()<nl><nl><tab>b()")
	}
	if containsSub(out, "a()\n\n\n\tb()") {
		return tokDiff("multiple blanks not collapsed", out, "(no double blank)")
	}
	return ""
}

// File hygiene: exactly one trailing newline, no trailing blank line.
func TestFormatFinalNewline() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {}\n"
	var out @[]readonly char = Format(parseFileSrc(src))
	if len(out) < 2 { return "output too short" }
	if out[len(out) - 1] != '\n' { return "no final newline" }
	if out[len(out) - 2] == '\n' { return "trailing blank line" }
	return ""
}

// Formatting is a fixpoint even with preserved blank lines.
func TestFormatIdempotentWithBlanks() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\ta()\n"
		"\n"
		"\tb()\n"
		"}\n"
	var out1 @[]readonly char = Format(parseFileSrc(src))
	var out2 @[]readonly char = Format(parseFileSrc(out1))
	if !streq(out1, out2) {
		return tokDiff("not idempotent", out1, out2)
	}
	return ""
}
