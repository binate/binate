package "pkg/binate/format"

import "pkg/builtins/testing"

// Comments inside a function literal's body are interleaved within the body, as
// a statement block's are: leading comments above their statement at the body's
// indent, a trailing comment after its line, and a comment after the opening `{`
// moved to its own line inside (as `if x { // c` is).  Neither a width trial nor
// a nested literal emits one twice or moves it out of its body.

// checkFormatGolden formats src through a comment-collecting parse (unlike
// checkGolden's) and asserts the output is exactly want, and that formatting it
// again leaves it unchanged.
func checkFormatGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var out @[]readonly char = Format(parseCollected(src))
	if !streq(out, want) {
		return tokDiff("format mismatch", out, want)
	}
	var again @[]readonly char = Format(parseCollected(out))
	if !streq(again, out) {
		return tokDiff("formatting the output again changed it", again, out)
	}
	return ""
}

func TestCommentsFuncLitInPlace() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tdefer func() { // why\n"
					"\t\tg()\n"
					"\t\t// before second\n"
					"\t\tg() // trailing second\n"
					"\t}()\n"
					"\th()\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tdefer func() {\n"
					"\t\t// why\n"
					"\t\tg()\n"
					"\t\t// before second\n"
					"\t\tg() // trailing second\n"
					"\t}()\n"
					"\th()\n"
					"}\n")
}

// A literal nested in another keeps its own comments; a literal that is a call's
// first argument stays on the call's line however long its commented body is.
func TestCommentsFuncLitNested() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\trun(func() {\n"
					"\t\t// outer\n"
					"\t\trun(func() {\n"
					"\t\t\t// inner\n"
					"\t\t\tg() // inner trailing\n"
					"\t\t})\n"
					"\t\tg() // outer trailing\n"
					"\t})\n"
					"\th()\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\trun(func() {\n"
					"\t\t// outer\n"
					"\t\trun(func() {\n"
					"\t\t\t// inner\n"
					"\t\t\tg() // inner trailing\n"
					"\t\t})\n"
					"\t\tg() // outer trailing\n"
					"\t})\n"
					"\th()\n"
					"}\n")
}

// indexOf returns the byte offset of the first occurrence of sub in s, or -1.
func indexOf(s *[]readonly char, sub *[]readonly char) int {
	for i := 0; i + len(sub) <= len(s); i++ {
		var k int = 0
		for k < len(sub) && s[i + k] == sub[k] {
			k++
		}
		if k == len(sub) { return i }
	}
	return -1
}

// A commented literal in a call too wide for one line goes through the argument
// list's width trials: its comment is emitted once, inside its body.
func TestCommentsFuncLitWrappedCall() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tregister(\"a fairly long registration name that pushes the call wide\", 123456789, func() {\n"
			"\t\t// in the wrapped literal\n"
			"\t\tg()\n"
			"\t})\n"
			"\th()\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	var lit int = indexOf(out, "func() {")
	var c int = indexOf(out, "// in the wrapped literal")
	var body int = indexOf(out, "g()")
	if lit < 0 || c < lit || body < c {
		return tokDiff("the comment is not inside the literal's body", out, "func() { // ... g()")
	}
	var again @[]readonly char = Format(parseCollected(out))
	if !streq(again, out) {
		return tokDiff("formatting the output again changed it", again, out)
	}
	return ""
}

// checkStable asserts that src's comment multiset and code tokens are preserved
// (checkComments) and that formatting the output again leaves it unchanged.
func checkStable(src *[]readonly char) testing.TestResult {
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	var again @[]readonly char = Format(parseCollected(out))
	if !streq(again, out) {
		return tokDiff("formatting the output again changed it", again, out)
	}
	return ""
}

// A comment on the line a literal opens, after a statement joined to the literal
// by `;` or after a case label, is emitted once: the enclosing printer has
// already placed it when the literal's body is printed.
func TestCommentsFuncLitAfterJoinedStmt() testing.TestResult {
	var r testing.TestResult = checkStable(
			"package \"t\"\n"
					"\n"
					"func f() { g(); h(func() { /* c */ }) }\n")
	if len(r) > 0 { return r }
	return checkStable(
			"package \"t\"\n"
					"\n"
					"func f(x int) {\n"
					"\tswitch x {\n"
					"\tcase 1: defer func() { // c1\n"
					"\t\t\tg()\n"
					"\t\t}()\n"
					"\t\th()\n"
					"\tcase 2: g(); defer func() { // c2\n"
					"\t\t\tg()\n"
					"\t\t}()\n"
					"\t\th()\n"
					"\t}\n"
					"}\n")
}

// A call's first argument that is a long operator chain is measured whole, so
// its layout is the same when the output is formatted again.
func TestFirstArgChainStable() testing.TestResult {
	return checkStable(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tsomeFunction(aaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb + "
					"cccccccccccccccccccccccccccc + ddddddddddddddddddddddd + eeeeeeee, x)\n"
					"}\n")
}

// A literal that the enclosing printer trial-prints before placing it -- a group
// member (its trailing-comment column) and a case whose body starts on the label
// line (the inline-case check) -- still prints its body's comments.
func TestCommentsFuncLitAfterTrial() testing.TestResult {
	var r testing.TestResult = checkStable(
			"package \"t\"\n"
					"\n"
					"var (\n"
					"\th1 = func() {\n"
					"\t\t// h1 body\n"
					"\t\tg() // h1 trail\n"
					"\t} // after h1\n"
					"\th2 = 3 // h2\n"
					")\n")
	if len(r) > 0 { return r }
	return checkStable(
			"package \"t\"\n"
					"\n"
					"func f(x int) {\n"
					"\tswitch x {\n"
					"\tcase 1: g()\n"
					"\tcase 2: h(func() { /* case two */ g() })\n"
					"\tcase 3: g()\n"
					"\t}\n"
					"}\n")
}
