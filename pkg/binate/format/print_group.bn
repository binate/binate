package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printGroupDecl appends a grouped `var`/`const`/`type` block, one spec per
// tab-indented line inside `( ... )`.  Comments interleave (own-line comments --
// section headers, docs -- above their member; trailing comments on the member's
// line); blank lines between members are preserved and reset the alignment run;
// within a run the trailing comments are aligned to a shared column (the run's
// widest member body + one space).  The keyword is recovered from the first
// member's kind (every member of a group shares it).  A `// LONG-LINE ALLOWED` line
// keeps its member, or the members `;`-joined on it, as written, with wrapping
// suppressed (markedMemberRunEnd, printMarkedMembers); one that cannot be kept
// prints one member per line, unmarked but for the last, whose marker it is.
// lastLimit is where the comments on the last member's last line stop being its:
// the group's end, or, when the marker after the `)` is the last member's
// (lastMemberMarked), where that line goes on to the next node (the zero Pos when it
// does not), so that member keeps its line.
func printGroupDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl, lastLimit token.Pos) {
	// An empty group (`const ()` / `var ()` / `type ()`) declares nothing and
	// carries no keyword in the AST (the keyword is recovered from the first
	// member, of which there are none), so drop it -- a meaning-preserving
	// canonicalization.  Preserving it would require the parser to record the
	// group's keyword on the DECL_GROUP node.
	if len(d.Decls) == 0 { return }
	var base int = currentLineIndent(b)
	var mi int = base + 1
	b.Write(groupKeyword(d))
	b.Write(" (")
	var members @[]@ast.Decl = d.Decls
	// The members before split are those of a marked line that could not be kept
	// but its last, whose marker it is: they print unmarked, one per line.
	var split int = 0
	var i int = 0
	for i < len(members) {
		var j int = groupRunEnd(members, i)
		var col int = groupRunCommentColumn(cc, d, i, j, mi, lastLimit)
		if i > 0 && hasBlankGap(cc, members[i - 1].End.Line, members[i].Pos.Line) {
			b.WriteByte('\n')
		}
		var k int = i
		for k < j {
			// A member's Pos is its name's: the comments before it lead it, and
			// those on its End's line trail it -- even for a member whose value or
			// struct body spans lines.
			emitLeadingComments(b, cc, members[k].Pos, mi, true)
			b.WriteByte('\n')
			writeIndent(b, mi)
			var end int = k
			if k >= split { end = markedMemberRunEnd(cc, d, k, lastLimit) }
			if end == k || !printMarkedMembers(b, cc, d, k, end) {
				if end > k + 1 { split = end - 1 }
				end = k + 1
				printGroupMemberTrailing(b, cc, d, k, col, mi, lastLimit)
			}
			emitTrailingCommentAt(b, cc, members[end - 1].End, col, memberLimit(d, end - 1, lastLimit))
			k = end
		}
		i = j
	}
	// A dangling comment after the last member, before the closing paren.
	emitLeadingComments(b, cc, d.End, mi, false)
	b.WriteByte('\n')
	writeIndent(b, base)
	b.WriteByte(')')
}

// groupKeyword returns the group's keyword, recovered from its first member's
// kind (all members share it).
func groupKeyword(d @ast.Decl) @[]readonly char {
	var mk int = d.Decls[0].Kind
	if mk == ast.DECL_CONST { return "const" }
	if mk == ast.DECL_TYPE { return "type" }
	return "var"
}

// printGroupMember appends a single member's spec body (no leading indent or
// trailing comment), a value followed on its last line by tail bytes.  A struct
// type in it takes the comments inside it through a cursor of its own
// (printTypeDef, printType), afresh each time, so the measured body is identical to
// the emitted one.
func printGroupMember(b @strings.Builder, m @ast.Decl, tail int) {
	if m.Kind == ast.DECL_TYPE {
		printTypeSpec(b, nil, m, tail, currentLineIndent(b))
	} else {
		printValueSpec(b, m, tail)
	}
}

// groupMemberBody renders a member's spec body to a string, used to measure the
// alignment column.
func groupMemberBody(m @ast.Decl) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	printGroupMember(sb, m, 0)
	return sb.String()
}

// groupRunEnd returns the end (exclusive) of the alignment run starting at i: the
// first member separated from its predecessor by a source line gap (a blank line
// or an own-line comment breaks the run).
func groupRunEnd(members @[]@ast.Decl, i int) int {
	var j int = i + 1
	for j < len(members) {
		// A gap of more than one line between the previous member's end and this
		// member's start means a blank line or an own-line comment intervened, and
		// breaks the run.
		if members[j].Pos.Line - members[j - 1].End.Line > 1 { break }
		j++
	}
	return j
}

// groupRunCommentColumn returns the byte column at which members[start:end] align
// their trailing comments -- the widest member body (at member indent mi) plus
// one space -- or 0 (no alignment, a single space) when a member body spans
// multiple lines (a shared column would be ill-defined) or when aligning to that
// column would push some member's line, with all the comments after it there, past
// MAX_LINE_WIDTH.  The
// members of a `// LONG-LINE ALLOWED` line (markedMemberRunEnd) are measured as one
// body, as printed (markedMembersBody), with the last one's trailing comments.
// lastLimit is printGroupDecl's.
func groupRunCommentColumn(cc @commentCursor, d @ast.Decl, start int, end int, mi int,
		lastLimit token.Pos) int {
	var members @[]@ast.Decl = d.Decls
	var maxBody int = 0
	var k int = start
	for k < end {
		var next int = markedMemberRunEnd(cc, d, k, lastLimit)
		var body @[]readonly char
		if next > k {
			body = markedMembersBody(cc, d, k, next)
		} else {
			body = groupMemberBody(members[k])
			next = k + 1
		}
		if hasNewline(body) { return 0 }
		if len(body) > maxBody { maxBody = len(body) }
		k = next
	}
	var col int = mi + maxBody + 1
	// If aligning any member's trailing comments to col would push them past the
	// width cap, drop alignment for the run (a single space instead), matching the
	// switch aligner's fallback.
	k = start
	for k < end {
		var last int = markedMemberRunEnd(cc, d, k, lastLimit) - 1
		if last < k { last = k }
		var w int = memberTrailWidth(cc, members[last], memberLimit(d, last, lastLimit))
		if w > 0 && col - 1 + w > MAX_LINE_WIDTH {
			return 0
		}
		k = last + 1
	}
	return col
}

// memberTrailWidth returns the width the comments after group member m on its last
// line, before limit (see memberLimit), take there (commentWidth), peeking the cursor
// without advancing it.  A `// LONG-LINE ALLOWED` among them counts, unlike in
// trailingWidth: padding a marked line to align its comments would only lengthen a
// line that may already run past the cap.
func memberTrailWidth(cc @commentCursor, m @ast.Decl, limit token.Pos) int {
	if cc == nil { return 0 }
	var from token.Pos = commentsFrom(m.Pos, m.End)
	var w int = 0
	for k := lineComments(cc, m.End.Line); k < len(cc.comments); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line != m.End.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		if !isDone(cc, k) && !posLess(c.Pos, from) { w = w + commentWidth(c) }
	}
	return w
}

// memberLimit returns where the comments on the last line of d's member k stop
// being its: the next member's start (`c = 1; d = 2 // c` -- the comment is d's),
// or, for the last member, lastLimit (printGroupDecl).
func memberLimit(d @ast.Decl, k int, lastLimit token.Pos) token.Pos {
	if k + 1 < len(d.Decls) { return d.Decls[k + 1].Pos }
	return lastLimit
}

// emitTrailingCommentAt flushes comments on the SAME line as endPos and before
// limit (unless it is the zero Pos), aligning the first one to byte column col
// (padding with spaces; at least one space if the line already reaches col).
// col == 0 falls back to a single leading space.  A no-op when cc is nil.
func emitTrailingCommentAt(b @strings.Builder, cc @commentCursor, endPos token.Pos, col int,
		limit token.Pos) {
	if cc == nil { return }
	var first bool = true
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		if c.OwnLine { break }
		if c.Pos.Line != endPos.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		if first && col > 0 {
			var cur int = lineWidth(b)
			if cur < col {
				for p := cur; p < col; p++ { b.WriteByte(' ') }
			} else {
				b.WriteByte(' ')
			}
		} else {
			b.WriteByte(' ')
		}
		b.Write(c.Text)
		cc.idx = cc.idx + 1
		first = false
	}
}
