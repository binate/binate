package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printGroupDecl appends a grouped `var`/`const`/`type` block, one spec per
// tab-indented line inside `( ... )`.  Comments interleave (own-line comments --
// section headers, docs -- above their member; trailing comments on the member's
// line); blank lines between members are preserved and reset the alignment run;
// within a run the trailing comments are aligned to a shared column (the run's
// widest member body + one space).  The keyword is recovered from the first
// member's kind (every member of a group shares it).
func printGroupDecl(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	// An empty group (`const ()` / `var ()` / `type ()`) declares nothing and
	// carries no keyword in the AST (the keyword is recovered from the first
	// member, of which there are none), so drop it -- a meaning-preserving
	// canonicalization.  Preserving it would require the parser to record the
	// group's keyword on the DECL_GROUP node.
	if len(d.Decls) == 0 { return }
	var base int = currentLineIndent(b)
	var mi int = base + 1
	b.Write(groupKeyword(d))
	b.Write(" (")
	var members @[]@ast.Decl = d.Decls
	var i int = 0
	for i < len(members) {
		var j int = groupRunEnd(members, i)
		var col int = groupRunCommentColumn(cc, members, i, j, mi)
		if i > 0 && hasBlankGap(cc, members[i - 1].End.Line, memberStartLine(members[i])) {
			b.WriteByte('\n')
		}
		for k := i; k < j; k++ {
			// Grouped const/var/type members share the keyword's Pos
			// (parseConstSpec / parseVarSpec / parseTypeSpec set d.Pos =
			// keywordPos), so member.Pos is useless for per-member layout.  Use the
			// member's start position (recovered from its type/value node) to place
			// leading comments, and its End for trailing ones -- correct even for a
			// member whose value/struct body spans multiple lines.
			emitLeadingComments(b, cc, memberStartPos(members[k]), mi, true)
			b.WriteByte('\n')
			writeIndent(b, mi)
			printGroupMember(b, members[k])
			emitTrailingCommentAt(b, cc, members[k].End, col)
		}
		i = j
	}
	// A dangling comment after the last member, before the closing paren.
	emitLeadingComments(b, cc, d.End, mi, false)
	b.WriteByte('\n')
	b.WriteByte(')')
}

// groupKeyword returns the group's keyword, recovered from its first member's
// kind (all members share it).
func groupKeyword(d @ast.Decl) @[]readonly char {
	var mk int = d.Decls[0].Kind
	if mk == ast.DECL_CONST { return "const" }
	if mk == ast.DECL_TYPE { return "type" }
	return "var"
}

// printGroupMember appends a single member's spec body (no leading indent or
// trailing comment).  A struct member reached here gets a nil cursor -- its
// internal field comments fall to the backstop (rare in a group); this also
// keeps the measured body identical to the emitted one.
func printGroupMember(b @strings.Builder, m @ast.Decl) {
	if m.Kind == ast.DECL_TYPE {
		printTypeSpec(b, nil, m)
	} else {
		printValueSpec(b, m)
	}
}

// groupMemberBody renders a member's spec body to a string, used to measure the
// alignment column.
func groupMemberBody(m @ast.Decl) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	printGroupMember(sb, m)
	return sb.String()
}

// groupRunEnd returns the end (exclusive) of the alignment run starting at i: the
// first member separated from its predecessor by a source line gap (a blank line
// or an own-line comment breaks the run).
func groupRunEnd(members @[]@ast.Decl, i int) int {
	var j int = i + 1
	for j < len(members) {
		// A gap of more than one line between the previous member's end and this
		// member's start means a blank line or an own-line comment intervened, and
		// breaks the run.
		if memberStartLine(members[j]) - members[j - 1].End.Line > 1 { break }
		j++
	}
	return j
}

// memberStartPos returns a grouped member's start position.  Because grouped
// members all carry the keyword's Pos, the real start is recovered from the
// member's first sub-node -- its type (which follows the name directly) or, for
// an untyped value member, its value expression.  A bare member (repeated iota,
// no type or value) is single-line, so its End is its start.
func memberStartPos(m @ast.Decl) token.Pos {
	if m.TypeRef != nil { return m.TypeRef.Pos }
	if m.Value != nil { return m.Value.Pos }
	return m.End
}

// memberStartLine returns the source line on which a grouped member starts.
func memberStartLine(m @ast.Decl) int {
	return memberStartPos(m).Line
}

// groupRunCommentColumn returns the byte column at which members[start:end] align
// their trailing comments -- the widest member body (at member indent mi) plus
// one space -- or 0 (no alignment, a single space) when a member body spans
// multiple lines (a shared column would be ill-defined) or when aligning to that
// column would push some member's `body + comment` line past MAX_LINE_WIDTH.
func groupRunCommentColumn(cc @commentCursor, members @[]@ast.Decl, start int, end int,
		mi int) int {
	var maxBody int = 0
	for k := start; k < end; k++ {
		var body @[]readonly char = groupMemberBody(members[k])
		if hasNewline(body) { return 0 }
		if len(body) > maxBody { maxBody = len(body) }
	}
	var col int = mi + maxBody + 1
	// If aligning any member's trailing comment to col would exceed the width
	// cap, drop alignment for the run (a single space instead), matching the
	// switch aligner's fallback.
	for k := start; k < end; k++ {
		var clen int = memberTrailingCommentLen(cc, members[k].End.Line)
		if clen > 0 && col + clen > MAX_LINE_WIDTH {
			return 0
		}
	}
	return col
}

// memberTrailingCommentLen returns the byte length of the trailing (same-line,
// non-own-line) comment on the given line, peeking the cursor without advancing
// it (0 when there is none).  Used to width-check the alignment column.
func memberTrailingCommentLen(cc @commentCursor, line int) int {
	if cc == nil { return 0 }
	for k := cc.idx; k < len(cc.comments); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line > line { break }
		if !c.OwnLine && c.Pos.Line == line { return len(c.Text) }
	}
	return 0
}

// emitTrailingCommentAt flushes comments on the SAME line as endPos, aligning the
// first one to byte column col (padding with spaces; at least one space if the
// line already reaches col).  col == 0 falls back to a single leading space.  A
// no-op when cc is nil.
func emitTrailingCommentAt(b @strings.Builder, cc @commentCursor, endPos token.Pos, col int) {
	if cc == nil { return }
	var first bool = true
	for cc.idx < len(cc.comments) {
		var c @token.Comment = cc.comments[cc.idx]
		if c.OwnLine { break }
		if c.Pos.Line != endPos.Line { break }
		if first && col > 0 {
			var cur int = lineWidth(b)
			if cur < col {
				for p := cur; p < col; p++ { b.WriteByte(' ') }
			} else {
				b.WriteByte(' ')
			}
		} else {
			b.WriteByte(' ')
		}
		b.Write(c.Text)
		cc.idx = cc.idx + 1
		first = false
	}
}
