package "pkg/binate/format"

import "pkg/builtins/testing"

// A `// LONG-LINE ALLOWED` after the `)` of a group on one line is its last member's: the group
// prints one member per line, and that member -- or the members `;`-joined with it -- keeps its
// line, at top level or in a block.  A marker after a declaration that follows the group on its
// line stays that declaration's, and another comment after the `)` stays there.
func TestOneLineGroupMarkerIsItsLastMembers() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var ( r = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccc) ) // LONG-LINE ALLOWED\n"
			"\n"
			"var ( a = 1; s = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) ) // LONG-LINE ALLOWED\n"
			"\n"
			"var ( c = 3 ); var t = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"\n"
			"var ( d = 4 ) // e\n"
			"\n"
			"func f() {\n"
			"\tvar ( u = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccc) ) // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tr = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccc) // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1; s = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"var (\n"
			"\tc = 3\n"
			")\n"
			"\n"
			"var t = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"\n"
			"var (\n"
			"\td = 4\n"
			") // e\n"
			"\n"
			"func f() {\n"
			"\tvar (\n"
			"\t\tu = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"\t)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A group whose `)` follows its last member on that member's line gives a marker after the `)`
// to that member, however many lines the group spans: a var or a type, at top level or in a
// block, with a block comment before the marker.  A marker after a statement that follows a
// group on its line stays that statement's.
func TestGroupCloseOnLastMemberLineGivesItTheMarker() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\te = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) ) // LONG-LINE ALLOWED\n"
			"\n"
			"var (\n"
			"\ta = 1\n"
			"\tb = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) ) /* c */ // LONG-LINE ALLOWED\n"
			"\n"
			"type ( G *func(aaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccccccccccccc, dddddddddddd) ) // LONG-LINE ALLOWED\n"
			"\n"
			"func f() {\n"
			"\tvar (\n"
			"\t\tu = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) ) // LONG-LINE ALLOWED\n"
			"\tvar ( v = 1 ); w := fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\te = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1\n"
			"\tb = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) /* c */ // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"type (\n"
			"\tG *func(aaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccccccccccccc, dddddddddddd) // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"func f() {\n"
			"\tvar (\n"
			"\t\tu = fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"\t)\n"
			"\tvar (\n"
			"\t\tv = 1\n"
			"\t)\n"
			"\tw := fffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Type members joined on a `// LONG-LINE ALLOWED` line keep it, each with the comment between
// its name and its type after it, and the run's next member aligns its comment with the
// marker.
func TestMarkedTypeMembersKeepTheCommentsAfterTheirNames() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type (\n"
			"\tA /* a */ int; B /* b */ int // LONG-LINE ALLOWED\n"
			"\tCc int // c\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type (\n"
			"\tA int /* a */; B int /* b */ // LONG-LINE ALLOWED\n"
			"\tCc int               // c\n"
			")\n"
	return checkFormatGolden(src, want)
}
