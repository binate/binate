package "pkg/binate/format"

import "pkg/builtins/testing"

// fmtFile formats a whole source file (comment-collecting parse) via Format.
func fmtFile(src *[]readonly char) @[]readonly char {
	return Format(parseCollected(src))
}

// checkGroup round-trips a whole file through Format asserting token-equality and
// comment-multiset preservation, that the output contains wantSub, and that
// formatting is idempotent.
func checkGroup(src *[]readonly char, wantSub *[]readonly char) testing.TestResult {
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFile(src)
	if !containsSub(out, wantSub) {
		return tokDiff("group: missing expected substring", out, wantSub)
	}
	var out2 @[]readonly char = fmtFile(out)
	if !streq(out, out2) {
		return tokDiff("group: not idempotent", out, out2)
	}
	return ""
}

// Trailing comments in a const group align to a shared column (widest body + 1).
func TestGroupTrailingCommentsAligned() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tA int = 1 // first\n"
			"\tBB = 2 // second\n"
			")\n"
	return checkGroup(src, "\tA int = 1 // first\n\tBB = 2    // second\n")
}

// An iota enum with bare members aligns their trailing comments.
func TestGroupIotaCommentsAligned() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tX int = iota // zero\n"
			"\tY // one\n"
			"\tZ // two\n"
			")\n"
	return checkGroup(src, "\tX int = iota // zero\n\tY            // one\n\tZ            // two\n")
}

// An own-line section comment inside a group is placed above its member and
// resets the alignment run.
func TestGroupSectionComment() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\t// group one\n"
			"\tA = 1 // a\n"
			"\tBBBB = 2 // b\n"
			")\n"
	return checkGroup(src, "\t// group one\n\tA = 1    // a\n\tBBBB = 2 // b\n")
}

// A blank line between members is preserved and resets the run (each run aligns
// independently).
func TestGroupBlankResetsRun() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tA = 1 // a\n"
			"\n"
			"\tBBBB = 2 // b\n"
			")\n"
	// Two runs: {A} aligns alone, blank, {BBBB} aligns alone.
	return checkGroup(src, "\tA = 1 // a\n\n\tBBBB = 2 // b\n")
}

// A group with no comments introduces no trailing whitespace.
func TestGroupNoTrailingWhitespace() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tA int = 1\n"
			"\tBB = 2\n"
			")\n"
	var out @[]readonly char = fmtFile(src)
	if containsSub(out, " \n") {
		return tokDiff("group emitted trailing whitespace", out, "<space><nl>")
	}
	return checkGroup(src, "\tA int = 1\n\tBB = 2\n")
}

// When aligning a run's trailing comments to the widest body would push a
// comment past 100 columns, alignment is dropped (a single space) so lines stay
// within the cap.
func TestGroupCommentWidthGuard() testing.TestResult {
	// A 50-char member name sets a wide body column; a 50-char comment on a short
	// member would then overflow when aligned, so alignment is dropped.
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA int = iota\n"
			"\tB // BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\n"
			")\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFile(src)
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("group comment width guard: a line exceeds 100", out, "")
	}
	// Alignment dropped: member B's comment has a single space before it.
	if !containsSub(out, "\tB // BBBB") {
		return tokDiff("group comment width guard: alignment not dropped", out, "\\tB // B...")
	}
	return ""
}

// A grouped member whose value spans multiple source lines does not inject a
// spurious blank line or hoist an interior comment above the member (the member
// start is recovered from its value/type position, not the shared keyword Pos).
func TestGroupMultiLineMemberNoSpuriousBlank() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tA = 1\n"
			"\tB = someFunc(\n"
			"\t\tx, // note\n"
			"\t)\n"
			")\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFile(src)
	// No blank line between A and B (the multi-line member's start line is used);
	// the source-wrapped call value is preserved wrapped.
	if !containsSub(out, "\tA = 1\n\tB = someFunc(") {
		return tokDiff("group multi-line member: spurious blank / wrong layout", out,
				"\\tA = 1<nl>\\tB = someFunc(")
	}
	return ""
}

// A dangling comment after the last member, before the closing paren, is placed.
func TestGroupDanglingComment() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tA = 1\n"
			"\t// trailing note\n"
			")\n"
	return checkGroup(src, "\tA = 1\n\t// trailing note\n)")
}

// Inside a function, a group's closing paren is indented like its keyword.
func TestGroupInFunctionClosingParen() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tconst (\n"
			"\t\tA = 1\n"
			"\t\tB = 2\n"
			"\t)\n"
			"\tif A > 0 {\n"
			"\t\tvar (\n"
			"\t\t\tx int = A\n"
			"\t\t\ty int = B // why\n"
			"\t\t)\n"
			"\t\t_ = x + y\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// Of two group members on a line, the first takes only the comments before the second: the
// trailing comment is the second's, and is aligned with its run.
func TestGroupMembersTakeTheirOwnComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tc = 1; d = 2 // tail\n"
			"\te = q(1)\n"
			")\n"
			"\n"
			"type (\n"
			"\tU int; V int // w\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tc = 1\n"
			"\td = 2    // tail\n"
			"\te = q(1)\n"
			")\n"
			"\n"
			"type (\n"
			"\tU int\n"
			"\tV int // w\n"
			")\n"
	return checkFormatGolden(src, want)
}

// A group member starts at its name: a comment between a member's name and its type or value
// is its trailing comment, not the previous member's or an own-line one above it.  A comment
// after the group's `)` stays after it.
func TestGroupMemberCommentsAfterNameAndBeforeClose() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tn /* o */ int\n"
			"\tm int; k /* o2 */ int\n"
			"\tr /* s */ = 2\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1\n"
			"\tb = 2 ) // c\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tn int /* o */\n"
			"\tm int\n"
			"\tk int /* o2 */\n"
			"\tr = 2 /* s */\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1\n"
			"\tb = 2\n"
			") // c\n"
	return checkFormatGolden(src, want)
}

// A group member on a `// LONG-LINE ALLOWED` line is printed as written, with wrapping suppressed
// -- in a var, const or type group, at top level or in a block -- and a one-line struct type in it
// keeps the comments in its lists.
func TestMarkedGroupMemberStaysOnItsLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tx = fffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccccccc"
			"ccccccccccc, ddddddd) // LONG-LINE ALLOWED\n"
			"\tyy = 2 // c\n"
			")\n"
			"\n"
			"const (\n"
			"\tK = 1 + aaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbb + cccccccccccccccccccccccc "
			"+ dddddddddddddddd // LONG-LINE ALLOWED\n"
			")\n"
			"\n"
			"type (\n"
			"\tS struct { f *func(int, /* c */ int) } // LONG-LINE ALLOWED\n"
			"\tT int\n"
			")\n"
			"\n"
			"func f() {\n"
			"\tvar (\n"
			"\t\tx = fffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccccc"
			"ccccccccccccc, ddddddd) // LONG-LINE ALLOWED\n"
			"\t\ty = 2\n"
			"\t)\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// The group members `;`-joined on a `// LONG-LINE ALLOWED` line stay joined, with the comments
// between them; the run aligns its trailing comments to the joined line's width, and the comment
// between them counts, though an earlier line's comments are still to be printed when the run is
// measured.
func TestMarkedLineKeepsJoinedGroupMembers() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tp = 1; q = 2 // LONG-LINE ALLOWED\n"
			"\trrrrrr = 3 // x\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1 // x\n"
			"\tp = 1 /* y */; q = 2 // LONG-LINE ALLOWED\n"
			"\tbb = 3 // z\n"
			")\n"
			"\n"
			"type (\n"
			"\tA int; B string // LONG-LINE ALLOWED\n"
			"\tC bool // q\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tp = 1; q = 2 // LONG-LINE ALLOWED\n"
			"\trrrrrr = 3   // x\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1                // x\n"
			"\tp = 1 /* y */; q = 2 // LONG-LINE ALLOWED\n"
			"\tbb = 3               // z\n"
			")\n"
			"\n"
			"type (\n"
			"\tA int; B string // LONG-LINE ALLOWED\n"
			"\tC bool          // q\n"
			")\n"
	return checkFormatGolden(src, want)
}

// A marked group member that cannot stay on its line (a function literal's body must expand, for a
// comment between its statements) prints as an unmarked one does, and the members joined on such a
// line print one per line, unmarked but for the last, which stays on its line if it can.
func TestMarkedGroupMemberThatCannotStayOnItsLineSplits() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tx = func() { a(); /* c */ b() } // LONG-LINE ALLOWED\n"
			"\ty = 2\n"
			")\n"
			"\n"
			"var (\n"
			"\tp = 1; x = func() { a(); /* c */ b() } // LONG-LINE ALLOWED\n"
			"\ty = 2\n"
			")\n"
			"\n"
			"var (\n"
			"\tx = func() { a(); /* c */ b() }; m = fffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbb"
			"bbbbbbbbbbbbbbbbbb, cccccccccccccccccccccccc, dddddddd); q = fffffffffffffffff(aaaaaaaaaaaa"
			"aaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccccccccc, dddddddd) // LONG-LINE "
			"ALLOWED\n"
			"\ty = 2\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tx = func() {\n"
			"\t\ta() /* c */\n"
			"\t\tb()\n"
			"\t} // LONG-LINE ALLOWED\n"
			"\ty = 2\n"
			")\n"
			"\n"
			"var (\n"
			"\tp = 1\n"
			"\tx = func() {\n"
			"\t\ta() /* c */\n"
			"\t\tb()\n"
			"\t} // LONG-LINE ALLOWED\n"
			"\ty = 2\n"
			")\n"
			"\n"
			"var (\n"
			"\tx = func() {\n"
			"\t\ta() /* c */\n"
			"\t\tb()\n"
			"\t}\n"
			"\tm = fffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccccccccccc, dddddddd)\n"
			"\tq = fffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccccccc"
			"ccccccccccc, dddddddd) // LONG-LINE ALLOWED\n"
			"\ty = 2\n"
			")\n"
	return checkFormatGolden(src, want)
}
