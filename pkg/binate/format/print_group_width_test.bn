package "pkg/binate/format"

import "pkg/builtins/testing"

// The group comment aligner's width check (groupRunCommentColumn).

// When aligning a run's trailing comments to the widest body would push a
// comment past 100 columns, alignment is dropped (a single space) so lines stay
// within the cap.
func TestGroupCommentWidthGuard() testing.TestResult {
	// A 50-char member name sets a wide body column; a 50-char comment on a short
	// member would then overflow when aligned, so alignment is dropped.
	var src *[]readonly char = "package \"t\"\n"
			"const (\n"
			"\tAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA int = iota\n"
			"\tB // BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\n"
			")\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFile(src)
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("group comment width guard: a line exceeds 100", out, "")
	}
	// Alignment dropped: member B's comment has a single space before it.
	if !containsSub(out, "\tB // BBBB") {
		return tokDiff("group comment width guard: alignment not dropped", out, "\\tB // B...")
	}
	return ""
}

// The width check measures every comment after a member, not only its first: a block comment
// before a long line comment does not take the run's alignment past 100 columns.  A comment
// between a type member's name and its type is part of the member, which the run's comments
// align after.  A marked line's comments count too, so its line is not padded further past the
// cap than it runs as written.
func TestGroupCommentWidthGuardMeasuresEveryComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tj = 1 /* j */ // cccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccccccccccccccccccccccccccccc\n"
			"\tkkkkkkkkkkkkkkkkkkkkkkkkkkkkk = 2 // k\n"
			")\n"
			"\n"
			"type (\n"
			"\tAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA int // x\n"
			"\tB /* c */ bool // yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1 /* zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz */ // LONG-LINE ALLOWED\n"
			"\tbbbbbbbbbbbbbbbbbbbb = 2 // b\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var (\n"
			"\tj = 1 /* j */ // cccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccccccccccccccccccccccccccccc\n"
			"\tkkkkkkkkkkkkkkkkkkkkkkkkkkkkk = 2 // k\n"
			")\n"
			"\n"
			"type (\n"
			"\tAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA int // x\n"
			"\tB /* c */ bool                               "
			"// yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\n"
			")\n"
			"\n"
			"var (\n"
			"\ta = 1 /* zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz */ // LONG-LINE ALLOWED\n"
			"\tbbbbbbbbbbbbbbbbbbbb = 2 // b\n"
			")\n"
	return checkFormatGolden(src, want)
}
