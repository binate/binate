package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// The header of a block statement -- an `if` with its `else`, a `for`, a switch, a
// `defer` -- and of a struct type prints the comments in it where the source put
// them: after the keyword, between its parts (around a loop's `;`s, its `,` and
// its `in`, a type switch's bound name, `:=` and `.(type)`, before an `else`),
// before the `{`, and after the `{` on its line.  Those before the `{` are claimed
// by position, as a list's are (print_listcomments.bn), keyed by the statement's
// position -- a struct type's by its `{`'s, as a list's element can start at its
// `struct` -- so each rendering prints them again, and the block does not take
// them as its own.  The positions its node does not keep come from the parser's
// record of the header (ast.File.Headers).  Where a newline would end the header
// -- after an expression, a name, a `)` or a `}` -- only block comments on one line
// can stand, and they stay on the line (claimInlineGap); those that a list in the
// expression before them does not print go there too, as in a list.  After a
// keyword, a `;`, a `,`, `in` or `:=`, a line comment can stand as well: the header
// goes on at a continuation line, two tabs in, or, when the `{` is next, the `{`
// starts a line of its own at the statement's indent.  The comments after the `{`
// on its line follow it there (emitBraceComments), and the header's last expression
// leaves room for them (braceTail, condTail).

// activeHeads holds the headers' records of the file being formatted
// (ast.File.Headers), in source order; empty outside Format, and for a file parsed
// without comments.
var activeHeads @[]@ast.Header

// headerOf returns the record of the header of the statement or struct type at pos
// (its Pos), or, when there is none, one of zero positions, which places no
// comment.
func headerOf(pos token.Pos) @ast.Header {
	var lo int = 0
	var hi int = len(activeHeads)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(activeHeads[mid].Pos, pos) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < len(activeHeads) && samePos(activeHeads[lo].Pos, pos) { return activeHeads[lo] }
	return make(ast.Header)
}

// writeOpenGap writes the comments between lo and hi that the header keyed key
// prints, where a line break may follow what precedes them (a keyword, a `;`, a
// `,`, `in` or `:=`), and what separates them from what follows: a space, or a line
// break to cont when one needs it (writeGapSeparator).
func writeOpenGap(b @strings.Builder, lo token.Pos, hi token.Pos, key token.Pos, cont int) {
	writeGapSeparator(b, claimGap(lo, hi, key), cont, false, true)
}

// claimAfterExpr returns the comments that the header keyed key prints between e
// (printed in a condition's context when cond) and hi, where what follows must
// continue the line: the block comments on one line from e's start to hi -- after
// e, and inside it where no list prints them (claimInlineGap).  When a comment lies
// there, e is rendered first, so that a list in it claims its own.
func claimAfterExpr(e @ast.Expr, cond bool, hi token.Pos, key token.Pos) @[]@token.Comment {
	var lo token.Pos = exprStartPos(e)
	if pendingWithin(lo, hi) {
		var scratch @strings.Builder = strings.NewBuilder()
		printExprE(scratch, e, cond, 0)
	}
	return claimInlineGap(lo, hi, key)
}

// claimAfterStmt is claimAfterExpr for simple statement s, a loop's init or post.
func claimAfterStmt(s @ast.Stmt, hi token.Pos, key token.Pos) @[]@token.Comment {
	var lo token.Pos = stmtStartPos(s)
	if pendingWithin(lo, hi) {
		var scratch @strings.Builder = strings.NewBuilder()
		printSimpleStmtCond(scratch, s)
	}
	return claimInlineGap(lo, hi, key)
}

// pendingWithin reports whether a comment that activeCursor has not emitted lies
// between lo and hi.
func pendingWithin(lo token.Pos, hi token.Pos) bool {
	var cc @commentCursor = activeCursor
	if cc == nil || lo.Line == 0 || hi.Line == 0 { return false }
	for k := firstAfter(cc, lo); k < len(cc.comments) && posLess(cc.comments[k].Pos, hi); k++ {
		if notEmitted(cc, k) { return true }
	}
	return false
}

// closeOf returns the position of block blk's `}`, the byte before its End.
func closeOf(blk @ast.Stmt) token.Pos {
	var p token.Pos = blk.End
	p.Col = p.Col - 1
	return p
}

// blockStart returns the position of what block blk prints first: its first
// statement's start, or its end when it prints none.
func blockStart(blk @ast.Stmt) token.Pos {
	var stmts @[]@ast.Stmt = printedStmts(blk.Stmts)
	if len(stmts) > 0 { return stmtStartPos(stmts[0]) }
	return blk.End
}

// braceTrailWidth returns the width that the comments of cc after the `{` at open on
// its line, before limit (what follows the `{` first, or the close), take there
// (commentWidth): those cc has not emitted, as a function literal's body takes its
// own from activeCursor once it prints (innerCursor).  0 when they hold the `//
// LONG-LINE ALLOWED` marker, or when cc is nil.
func braceTrailWidth(cc @commentCursor, open token.Pos, limit token.Pos) int {
	if cc == nil || open.Line == 0 { return 0 }
	var w int = 0
	for k := firstAfter(cc, open); k < len(cc.comments) && posLess(cc.comments[k].Pos, limit); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line != open.Line { break }
		if notEmitted(cc, k) {
			if containsMarker(c.Text) { return 0 }
			w = w + commentWidth(c)
		}
	}
	return w
}

// braceTail returns the room the last expression of a header leaves after it on its
// line: the comments cs written after it, the ` {` at open and the comments of cc
// after that on its line, before limit (braceTrailWidth), when room for those can
// help (withTrail; cont is the column the expression's continuation lines start
// at).
func braceTail(cc @commentCursor, cs @[]@token.Comment, open token.Pos, limit token.Pos,
		cont int) int {
	return withTrail(inlineCommentsWidth(cs) + 2, braceTrailWidth(cc, open, limit), cont)
}

// printBraceExpr appends x, the last expression of a header whose `{` is at open, in
// a condition's context, then the comments after it before the `{` and the space
// before that, leaving room for those and for the comments after the `{` on its
// line, before limit.
func printBraceExpr(b @strings.Builder, cc @commentCursor, x @ast.Expr, open token.Pos,
		limit token.Pos, key token.Pos, cont int) {
	var cs @[]@token.Comment = claimAfterExpr(x, true, open, key)
	printExprCondTail(b, x, braceTail(cc, cs, open, limit, cont))
	_ = writeInlineComments(b, cs)
	b.WriteByte(' ')
}

// emitBraceComments writes the comments of cc after the `{` at open on its line,
// before limit (what follows the `{` first, or the close), after it there, and
// reports whether it wrote any.  It claims them by position, keyed by open
// (claimGapIn), so that a comment still pending before them -- one in the header
// that no gap takes, which goes on the block's first line -- does not hold them
// back from the line whose width left room for them (braceTrailWidth).
func emitBraceComments(b @strings.Builder, cc @commentCursor, open token.Pos,
		limit token.Pos) bool {
	if cc == nil || open.Line == 0 { return false }
	var hi token.Pos = limit
	if hi.Line != open.Line {
		hi = open
		hi.Line = open.Line + 1
		hi.Col = 0
	}
	return writeInlineComments(b, claimGapIn(cc, open, hi, open))
}

// printIf appends `if cond { body }` with an optional `else` (a block) or `else if`
// (a chained if), the last block followed on its line by tail bytes, and the
// comments in its header (see above).  The condition is a control-clause context,
// so D4 composite-literal parens apply.
func printIf(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int, tail int) {
	var h @ast.Header = headerOf(s.Pos)
	var key token.Pos = s.Pos
	var cont int = indent + 2
	b.Write("if")
	writeOpenGap(b, s.Pos, exprStartPos(s.X), key, cont)
	printBraceExpr(b, cc, s.X, s.Body.Pos, blockStart(s.Body), key, cont)
	if s.Else == nil {
		printBlockTail(b, cc, s.Body, indent, tail)
		return
	}
	printBlock(b, cc, s.Body, indent)
	_ = writeInlineComments(b, claimInlineGap(closeOf(s.Body), h.Else, key))
	b.Write(" else")
	if s.Else.Kind == ast.STMT_IF {
		writeOpenGap(b, h.Else, s.Else.Pos, key, cont)
		printIf(b, cc, s.Else, indent, tail)
	} else {
		writeOpenGap(b, h.Else, s.Else.Pos, key, indent)
		printBlockTail(b, cc, s.Else, indent, tail)
	}
}

// printFor appends any of the for-loop forms: for-in (`for v in c` / `for k, v in
// c`), C-style (`for init; cond; post`), while-style (`for cond`), or infinite
// (`for`), with the comments in its header (see above).  The iterator, condition,
// AND the C-style init/post are all control-clause contexts: the parser reads no
// bare composite literal of a type name across the whole header, so an exposed
// one in any of them keeps its D4 parens.  tail bytes follow the body on its last
// line.
func printFor(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int, tail int) {
	var h @ast.Header = headerOf(s.Pos)
	var key token.Pos = s.Pos
	var cont int = indent + 2
	var limit token.Pos = blockStart(s.Body)
	b.Write("for")
	if s.ForVal != nil {
		var lo token.Pos = s.Pos
		if s.ForKey != nil {
			writeOpenGap(b, s.Pos, s.ForKey.Pos, key, cont)
			printExpr(b, s.ForKey)
			_ = writeInlineComments(b, claimInlineGap(s.ForKey.Pos, h.Comma, key))
			b.WriteByte(',')
			lo = h.Comma
		}
		writeOpenGap(b, lo, s.ForVal.Pos, key, cont)
		printExpr(b, s.ForVal)
		_ = writeInlineComments(b, claimInlineGap(s.ForVal.Pos, h.In, key))
		b.Write(" in")
		writeOpenGap(b, h.In, exprStartPos(s.X), key, cont)
		printBraceExpr(b, cc, s.X, s.Body.Pos, limit, key, cont)
	} else if s.Init != nil {
		printForClauses(b, cc, s, h, key, indent)
	} else if s.X != nil {
		writeOpenGap(b, s.Pos, exprStartPos(s.X), key, cont)
		printBraceExpr(b, cc, s.X, s.Body.Pos, limit, key, cont)
	} else {
		writeOpenGap(b, s.Pos, s.Body.Pos, key, indent)
	}
	printBlockTail(b, cc, s.Body, indent, tail)
}

// printForClauses appends a C-style loop's `init; cond; post` after its `for`, each
// part with the comments before and after it (h is the loop's header record, key
// its position), and what separates the last from the `{`: a space, or a line break
// to indent when a line comment before the `{` needs one.  An empty post statement
// (STMT_EMPTY, or none) takes no separator space, so `for ;; {` prints as `for ; ;
// {`, not with two spaces before `{`.
func printForClauses(b @strings.Builder, cc @commentCursor, s @ast.Stmt, h @ast.Header,
		key token.Pos, indent int) {
	var cont int = indent + 2
	var post bool = s.Post != nil && s.Post.Kind != ast.STMT_EMPTY
	var postCs @[]@token.Comment
	if post { postCs = claimAfterStmt(s.Post, s.Body.Pos, key) }
	if s.Init.Kind != ast.STMT_EMPTY {
		writeOpenGap(b, s.Pos, stmtStartPos(s.Init), key, cont)
		var cs @[]@token.Comment = claimAfterStmt(s.Init, h.Semi, key)
		printSimpleStmtCond(b, s.Init)
		_ = writeInlineComments(b, cs)
	} else {
		writeOpenGap(b, s.Pos, h.Semi, key, cont)
	}
	b.WriteByte(';')
	if s.X != nil {
		writeOpenGap(b, h.Semi, exprStartPos(s.X), key, cont)
		var cs @[]@token.Comment = claimAfterExpr(s.X, true, h.Semi2, key)
		printExprCondTail(b, s.X, inlineCommentsWidth(cs) + condTail(cc, s, postCs, cont))
		_ = writeInlineComments(b, cs)
	} else {
		writeOpenGap(b, h.Semi, h.Semi2, key, cont)
	}
	b.WriteByte(';')
	if post {
		writeOpenGap(b, h.Semi2, stmtStartPos(s.Post), key, cont)
		printSimpleStmtCond(b, s.Post)
		_ = writeInlineComments(b, postCs)
		b.WriteByte(' ')
	} else {
		writeOpenGap(b, h.Semi2, s.Body.Pos, key, indent)
	}
}

// condTail returns the room a C-style loop's condition leaves after it on its line,
// but for the comments claimed after it: `; `, or, when comments follow the loop's
// `{` on its line (braceTrailWidth), what follows the condition there up to them --
// `;`, the post statement with the comments after it (postCs) and ` {` -- and them,
// when room for them can help (withTrail; cont is the column the condition's
// continuation lines start at).  A post statement that spans lines leaves `; `.
func condTail(cc @commentCursor, s @ast.Stmt, postCs @[]@token.Comment, cont int) int {
	var w int = braceTrailWidth(cc, s.Body.Pos, blockStart(s.Body))
	if w == 0 { return 2 }
	var rest int = 3
	if s.Post != nil && s.Post.Kind != ast.STMT_EMPTY {
		var sb @strings.Builder = strings.NewBuilder()
		printSimpleStmtCond(sb, s.Post)
		var t @[]readonly char = sb.String()
		if hasNewline(t) { return 2 }
		rest = rest + 1 + len(t) + inlineCommentsWidth(postCs)
	}
	return withTrail(rest, w, cont)
}
