package "pkg/binate/format"

import "pkg/builtins/testing"

// The block comments on one line in a header stay where the source put them: after an `if`,
// `for`, `switch` or `defer` keyword, around an `else`, a loop's `;`s, its `,` and its `in`, a
// type switch's bound name, `:=` and `.(type)`, and before the `{` -- of a block kept on one
// line too.
func TestHeaderBlockCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f(x bool, n int, s @[]int, y any) {\n"
			"\tif /* a */ x /* b */ {\n"
			"\t\tg()\n"
			"\t} /* c */ else /* d */ if /* e */ x /* f */ {\n"
			"\t\tg()\n"
			"\t} else /* g */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor /* a */ i := 0 /* b */; /* c */ i < n /* d */; /* e */ i++ /* f */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor /* a */ k /* b */, /* c */ v /* d */ in /* e */ s /* f */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor /* a */ x /* b */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor /* a */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; /* a */ ; /* b */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch /* a */ n /* b */ {\n"
			"\tcase 1:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch /* a */ {\n"
			"\tcase x:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch /* a */ v /* b */ := /* c */ y /* d */.(type) /* e */ {\n"
			"\tcase int:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tdefer /* a */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif x /* a */ { g() }\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// The comments after a `{` on its line stay there: a block's, an `else`'s, a function's or a
// function literal's body's, a switch's, a `defer`'s and a struct type's, a field's included;
// an empty block's `}` then goes on a line of its own.
func TestHeaderCommentsAfterBraceStay() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"type S struct { // a\n"
			"\tf struct /* b */ { /* c */\n"
			"\t\ta int\n"
			"\t}\n"
			"}\n"
			"\n"
			"func f(x bool, n int) { // d\n"
			"\tif x { // e\n"
			"\t\tg()\n"
			"\t} else { /* f */\n"
			"\t\tg()\n"
			"\t}\n"
			"\t{ /* g\n"
			"\t h */\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch n { // i\n"
			"\tcase 1:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tdefer { // j\n"
			"\t\tg()\n"
			"\t}\n"
			"\th := func() { // k\n"
			"\t\tif x /* l */ { // m\n"
			"\t\t\tg()\n"
			"\t\t}\n"
			"\t}\n"
			"\th()\n"
			"\tif x { // n\n"
			"\t}\n"
			"}\n"
			"\n"
			"func e() { // o\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A line comment in a header where a newline may follow -- after a keyword or a `;` -- stays
// there, and the header goes on at a continuation line, or the `{` starts a line of its own at
// the statement's indent; so does an own-line comment there.
func TestHeaderLineCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f(x bool, n int) {\n"
			"\tif // a\n"
			"\t\t\tx {\n"
			"\t\tg()\n"
			"\t} else // b\n"
			"\t\t\tif x {\n"
			"\t\tg()\n"
			"\t} else // c\n"
			"\t{\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := 0; // d\n"
			"\t\t\ti < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := 0;\n"
			"\t\t\t// e\n"
			"\t\t\ti < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor // f\n"
			"\t{\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A type declaration's comments around its name, in its type parameters and before its type,
// and a struct type's before its `{`, stay where the source put them -- a group member's too.
func TestTypeDeclHeaderCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"type /* a */ S /* b */ [T /* c */ any, /* d */ U any] /* e */ struct /* f */ { // g\n"
			"\ta T\n"
			"}\n"
			"\n"
			"type (\n"
			"\tR /* h */ struct {\n"
			"\t\ta int\n"
			"\t}\n"
			"\tQ[T any] /* i */ int\n"
			")\n"
	return checkFormatGolden(src, src)
}

// A comment inside a condition that no list or operator chain prints (a unary operand's) goes
// before the `{`, as one inside a list's element goes after the element; one after the `{` of
// a block kept on one line expands it and stays after the `{`.
func TestHeaderCommentsInsideGoBeforeBrace() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f(x bool) {\n"
			"\tif !/* c */ x {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif x { /* d */ g() }\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f(x bool) {\n"
			"\tif !x /* c */ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif x { /* d */\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A header's last expression wraps to leave room for the comments after its `{` on that line
// -- a three-clause loop's condition for its post statement and them -- and so does a
// function's signature; but not for the `// LONG-LINE ALLOWED` marker, nor when wrapping cannot
// make room.
func TestHeaderLeavesRoomForBraceComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb && cccccccccccccccccc && ddddddd { "
			"// a comment here\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb && cccccccccccccccccc && ddd { // "
			"LONG-LINE ALLOWED\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb { // a comment far too long for any "
			"wrapping of the condition before it to leave room for it......\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
			"\n"
			"func ff() {\n"
			"\tfor i := 0; i < aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbb(ccccc, ddddd); i++ { // "
			"trailing comment here\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
			"\n"
			"func hhhhhhhhhhhhhhhhhhhhhhhhhh(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbb int) int { // "
			"xxxxxxxxxxxx\n"
			"\treturn 1\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb && cccccccccccccccccc &&\n"
			"\t\t\tddddddd { // a comment here\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb && cccccccccccccccccc && ddd { // "
			"LONG-LINE ALLOWED\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbb { // a comment far too long for any "
			"wrapping of the condition before it to leave room for it......\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
			"\n"
			"func ff() {\n"
			"\tfor i := 0; i < aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa &&\n"
			"\t\t\tbbbbbbbbbbbb(ccccc, ddddd); i++ { // trailing comment here\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
			"\n"
			"func hhhhhhhhhhhhhhhhhhhhhhhhhh(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbb int) int { // xxxxxxxxxxxx\n"
			"\treturn 1\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line comment after a loop's `,` or `in`, a type switch's `:=`, or a `switch`, `defer` or
// `struct` keyword stays there, the header going on at a continuation line, or the `{` on a
// line of its own.
func TestHeaderLineCommentsAfterKeywordsStay() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f(x bool, n int, s @[]int, y any) {\n"
			"\tfor k, // a\n"
			"\t\t\tv in s {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in // b\n"
			"\t\t\ts {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch v := // c\n"
			"\t\t\ty.(type) {\n"
			"\tcase int:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch // d\n"
			"\t\t\tn {\n"
			"\tcase 1:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tdefer // e\n"
			"\t{\n"
			"\t\tg()\n"
			"\t}\n"
			"\tvar w struct // f\n"
			"\t{\n"
			"\t\ta int\n"
			"\t}\n"
			"\t_ = w\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// The comments after a `{` stay on its line when an earlier comment in the header is left for
// the block's first line (a line comment inside a unary operand of the condition), so the room
// the header left for them holds on a second format; a comment inside a type switch's
// `.(type)` goes above its first case.
func TestHeaderBraceCommentsPassALeftComment() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif aaaaaaaaaaaaaaaaaaaa && !// c\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb { // t\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch y.( /* in */ type) {\n"
			"\tcase int:\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif aaaaaaaaaaaaaaaaaaaa &&\n"
			"\t\t\t!bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb { // t\n"
			"\t\t// c\n"
			"\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch y.(type) {\n"
			"\t/* in */\n"
			"\tcase int:\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A struct a type declaration defines indents from the declaration's line when a comment in its
// header puts the struct on a continuation line.
func TestTypeDeclStructIndentsFromItsLine() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"type // c\n"
			"\t\tS struct {\n"
			"\ta int\n"
			"}\n"
			"\n"
			"type G[T any, // h\n"
			"\t\tU any] struct {\n"
			"\ta T\n"
			"}\n"
	return checkFormatGolden(src, src)
}
