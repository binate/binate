package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// The header of an interface declaration or an impl keeps its comments where the source put
// them, keyed by the declaration's keyword (ast.Header, ast.Signature).  After the keyword, the
// `=`, the `:` and a parent's `,` a line comment can stand, what follows going on at a
// continuation line; the line breaks there after a block comment too when what follows, up to the
// next such place, does not fit after it, and after the `=` and between the parents whenever what
// follows does not fit.  After a name, a type or a `]` -- before the `=`, the `:` or the `{` --
// only block comments on one line can stand, as a line break there ends the declaration, so they
// count in the width of what they follow.  A comment before a parent's `,` goes after it, as in an
// argument list.

// printInterfaceHeader appends an interface declaration's header: `interface Name[tp]`, then
// ` = Ref` for an alias, followed on its last line by tail bytes, or the ` : parents` and the
// ` {`, and reports whether the declaration goes on (not an alias).
func printInterfaceHeader(b @strings.Builder, d @ast.Decl, tail int) bool {
	var rec @ast.Signature = signatureOf(d.Pos)
	var head @ast.Header = headerOf(d.Pos)
	var key token.Pos = d.Pos
	var cont int = currentLineIndent(b) + 2
	var hi token.Pos = head.Lbrace
	if d.IsAlias {
		hi = head.Assign
	} else if len(d.Interfaces) > 0 {
		hi = head.Colon
	}
	var named @[]@token.Comment
	var lo token.Pos = rec.Name
	if len(d.TypeParams) > 0 {
		named = claimInlineGap(rec.Name, rec.TypeOpen, key)
		lo = rec.TypeClose
	}
	var after @[]@token.Comment = claimInlineGap(lo, hi, key)
	var w int = len(d.Name) + typeParamsWidth(d, rec, named) + inlineCommentsWidth(after) + 2
	b.Write("interface")
	writeHeaderGap(b, claimGap(d.Pos, rec.Name, key), cont, w, false)
	b.Write(d.Name)
	if len(d.TypeParams) > 0 {
		if writeInlineComments(b, named) { b.WriteByte(' ') }
		printSigTypeParams(b, d.TypeParams, rec, currentLineIndent(b) + 2)
	}
	_ = writeInlineComments(b, after)
	if d.IsAlias {
		b.Write(" =")
		var ref @[]@token.Comment = claimGap(head.Assign, typeStartPos(d.TypeRef), key)
		writeHeaderGap(b, ref, cont, typeLineWidth(d.TypeRef) + tail, true)
		printTypeTail(b, d.TypeRef, tail)
		return false
	}
	var n int = len(d.Interfaces)
	if n > 0 {
		var closing @[]@token.Comment = claimAfterType(d.Interfaces[n - 1], head.Lbrace, key)
		b.Write(" :")
		printParentList(b, d.Interfaces, head.Colon, key, cont, inlineCommentsWidth(closing) + 2)
		_ = writeInlineComments(b, closing)
	}
	b.Write(" {")
	return true
}

// typeParamsWidth returns the width an interface's type parameters, with the comments named
// between its name and their `[`, take on the line of its name: none when it has none.
func typeParamsWidth(d @ast.Decl, rec @ast.Signature, named @[]@token.Comment) int {
	if len(d.TypeParams) == 0 { return 0 }
	var scratch @strings.Builder = strings.NewBuilder()
	printSigTypeParams(scratch, d.TypeParams, rec, 2)
	var w int = firstLineLen(scratch.String())
	if len(named) > 0 { w = w + inlineCommentsWidth(named) + 1 }
	return w
}

// printImplDecl appends `impl RecvType : Iface1, Iface2, ...`, followed on its last line by tail
// bytes (the declaration's trailing comments, after its last interface).
func printImplDecl(b @strings.Builder, d @ast.Decl, tail int) {
	var head @ast.Header = headerOf(d.Pos)
	var key token.Pos = d.Pos
	var cont int = currentLineIndent(b) + 2
	var before @[]@token.Comment = claimAfterType(d.TypeRef, head.Colon, key)
	var w int = typeLineWidth(d.TypeRef) + inlineCommentsWidth(before) + 2
	b.Write("impl")
	writeHeaderGap(b, claimGap(d.Pos, typeStartPos(d.TypeRef), key), cont, w, false)
	printType(b, d.TypeRef)
	_ = writeInlineComments(b, before)
	b.Write(" :")
	printParentList(b, d.Interfaces, head.Colon, key, cont, tail)
}

// printParentList appends the interfaces of an interface's parent list or an impl, ` I1, I2`,
// after its `:` at colon, followed on the last one's line by tail bytes, with the comments after
// the `:` and between them (claimed from one's start to the next's, so a comment before a `,` goes
// after it), keyed key.  An interface goes on at a continuation line at cont after a line comment,
// or when it does not fit on its line.
func printParentList(b @strings.Builder, list @[]@ast.TypeExpr, colon token.Pos, key token.Pos,
		cont int, tail int) {
	var lo token.Pos = colon
	for i := 0; i < len(list); i++ {
		if i > 0 { b.WriteByte(',') }
		var start token.Pos = typeStartPos(list[i])
		var end int = 1
		if i == len(list) - 1 { end = tail }
		writeHeaderGap(b, claimGap(lo, start, key), cont, typeLineWidth(list[i]) + end, true)
		printTypeTail(b, list[i], end)
		lo = start
	}
}

// writeHeaderGap writes the comments cs of a gap after which a line may break, and what
// separates them from what follows, w wide up to the next place a line may break: a line break
// to cont when they need one, or when what follows does not fit after them -- with cs empty only
// when free -- and a space otherwise.
func writeHeaderGap(b @strings.Builder, cs @[]@token.Comment, cont int, w int, free bool) {
	var full bool = !wrapSuppressed && (free || len(cs) > 0)
	if writeGapComments(b, cs, cont, false) || (full && lineWidth(b) + 1 + w > MAX_LINE_WIDTH) {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else {
		b.WriteByte(' ')
	}
}

// typeLineWidth returns the width of te's first line as printType writes it from the start of a
// line.
func typeLineWidth(te @ast.TypeExpr) int {
	var scratch @strings.Builder = strings.NewBuilder()
	printType(scratch, te)
	return firstLineLen(scratch.String())
}
