package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for print_ifacehead.bn: the headers of interface declarations and impls.

// An interface's header keeps its comments where the source put them: after its keyword, its
// name, a type parameter's `,` and its `]`, around its `:` and `=`, between its parents and
// before its `{`.  A line comment after the keyword, the `:`, the `=` or a parent's `,` puts
// what follows on a continuation line; a comment before a parent's `,` goes after it, as in an
// argument list.
func TestInterfaceHeaderKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"interface /* k */ I /* n */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface // after kw\n"
			"I {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface G[T any, /* tp */ U lang.Orderable] /* after ] */ : pkg.A[T], // c1\n"
			"\tB /* before { */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface X : // after colon\n"
			"\tA /* x */, B {\n"
			"}\n"
			"\n"
			"interface /* q */ Al /* r */ = /* s */ B\n"
			"\n"
			"interface Al2 = // after =\n"
			"\tpkg.B\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"interface /* k */ I /* n */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface // after kw\n"
			"\t\tI {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface G[T any, /* tp */ U lang.Orderable] /* after ] */ : pkg.A[T], // c1\n"
			"\t\tB /* before { */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface X : // after colon\n"
			"\t\tA, /* x */ B {}\n"
			"\n"
			"interface /* q */ Al /* r */ = /* s */ B\n"
			"\n"
			"interface Al2 = // after =\n"
			"\t\tpkg.B\n"
	return checkFormatGolden(src, want)
}

// An impl keeps its comments where the source put them: after its keyword, around its `:` and
// between its interfaces, a line comment after the keyword, the `:` or a `,` putting what follows
// on a continuation line; those after its last interface trail it.
func TestImplKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"impl /* i */ *T /* j */ : /* l */ I, /* m */ J\n"
			"\n"
			"impl // after impl\n"
			"*T : I\n"
			"\n"
			"impl *Box[int] : // after colon\n"
			"\tI, // after comma\n"
			"\tpkg.J[int]\n"
			"\n"
			"impl @readonly T /* j */ : I /* tail */ // line tail\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"impl /* i */ *T /* j */ : /* l */ I, /* m */ J\n"
			"\n"
			"impl // after impl\n"
			"\t\t*T : I\n"
			"\n"
			"impl *Box[int] : // after colon\n"
			"\t\tI, // after comma\n"
			"\t\tpkg.J[int]\n"
			"\n"
			"impl @readonly T /* j */ : I /* tail */ // line tail\n"
	return checkFormatGolden(src, want)
}

// The same in an interface file.
func TestInterfaceFileHeaderKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"interface /* k */ I /* n */ : /* c */ A {\n"
			"\tm() /* t */\n"
			"}\n"
			"\n"
			"impl /* i */ *T : /* l */ I // x\n"
			"\n"
			"interface Al /* r */ = B\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"interface /* k */ I /* n */ : /* c */ A {\n"
			"\tm() /* t */\n"
			"}\n"
			"\n"
			"impl /* i */ *T : /* l */ I // x\n"
			"\n"
			"interface Al /* r */ = B\n"
	return checkFormatGoldenIface(src, want)
}

// An interface's header breaks to a continuation line where a line comment could stand when what
// follows does not fit: after a block comment after its keyword, its `:` or a parent's `,`, and
// between its parents whenever the next does not fit, with the block comments before its `{`.
// Type parameters after a break continue from its line, as a type declaration's do.
func TestInterfaceHeaderWrapsAtItsBreaks() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne, /* a block comment of some forty chars. *"
			"/\n"
			"\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : /* a block comment of some forty chars. */ pkg.ParentInterfaceOne"
			",\n"
			"\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface /* a block comment of some forty chars. */ LongInterfaceName : pkg.ParentInterfaceOne"
			",\n"
			"\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne, pkg.ParentInterfaceTwo, pkg.ParentInterfa"
			"ceThree {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne, pkg.ParentInterfaceTwo /* before the brac"
			"e */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface // c\n"
			"G[T any, // d\n"
			"\tU any] {\n"
			"\tm()\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne, /* a block comment of some forty chars. *"
			"/\n"
			"\t\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : /* a block comment of some forty chars. */ pkg.ParentInterfaceOne"
			",\n"
			"\t\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface /* a block comment of some forty chars. */ LongInterfaceName : pkg.ParentInterfaceOne"
			",\n"
			"\t\tpkg.ParentInterfaceTwo {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne, pkg.ParentInterfaceTwo,\n"
			"\t\tpkg.ParentInterfaceThree {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface LongInterfaceName : pkg.ParentInterfaceOne,\n"
			"\t\tpkg.ParentInterfaceTwo /* before the brace */ {\n"
			"\tm()\n"
			"}\n"
			"\n"
			"interface // c\n"
			"\t\tG[T any, // d\n"
			"\t\t\t\tU any] {\n"
			"\tm()\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An alias goes on after its `=` at a continuation line when its target does not fit, with the
// block comments before the `=` on the line; an impl's interfaces wrap as an interface's parents
// do, the last leaving room for the declaration's trailing comments.
func TestAliasAndImplWrapAtTheirBreaks() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"interface LongInterfaceName[T any] /* a block comment of some forty chars. */ = pkg.ParentInter"
			"faceOne[T]\n"
			"\n"
			"interface LongInterfaceName = /* a block comment of some forty chars. */ pkg.ParentInterfaceOne"
			"[int]\n"
			"\n"
			"impl *readonly SomeLongReceiverTypeName : pkg.InterfaceOne, /* c */ pkg.InterfaceTwo[int] // tr"
			"ailing\n"
			"\n"
			"impl /* a block comment of some forty chars. */ *readonly SomeLongReceiverTypeName : pkg.Interf"
			"aceOne\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"interface LongInterfaceName[T any] /* a block comment of some forty chars. */ =\n"
			"\t\tpkg.ParentInterfaceOne[T]\n"
			"\n"
			"interface LongInterfaceName = /* a block comment of some forty chars. */ pkg.ParentInterfaceOne"
			"[int]\n"
			"\n"
			"impl *readonly SomeLongReceiverTypeName : pkg.InterfaceOne, /* c */\n"
			"\t\tpkg.InterfaceTwo[int] // trailing\n"
			"\n"
			"impl /* a block comment of some forty chars. */ *readonly SomeLongReceiverTypeName :\n"
			"\t\tpkg.InterfaceOne\n"
	return checkFormatGolden(src, want)
}
