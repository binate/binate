package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// importEntry is one import spec with the comments that travel with it when its
// run is sorted: inner, the comments between its declaration's start and its
// first token (printed on their own lines before `import`, or inline after it — a
// block comment ending on that token's line), mid, the block comments between its
// alias and its path (printed between them), and trail, the comments after it on
// its line (printed after it).
type importEntry struct {
	spec   @ast.ImportSpec
	inner  @vec.Vec[@token.Comment]
	inline @vec.Vec[@token.Comment]
	mid    @vec.Vec[@token.Comment]
	trail  @vec.Vec[@token.Comment]
}

// importPrinter is the state of printImports: the specs, the next run to sort,
// and where the source left off (the last line of the last spec or comment
// placed, 0 before the first).
type importPrinter struct {
	b           @strings.Builder
	cc          @commentCursor
	imports     @[]@ast.ImportSpec
	run         @vec.Vec[@importEntry]
	runBlank    bool
	prevEndLine int
}

// printImports emits the import section: every import on its own line (a grouped
// `import (...)` collapses to per-line form, each spec carrying the group's
// annotations), its annotations on the lines before it, sorted within each run.
// A run is a maximal sequence of imports with no blank line and no own-line
// comment between them: such a comment stays where the source put it (one in a
// group's header, before its first spec, goes before the group's imports), and
// only the imports between comments and blank lines are reordered.  A comment on
// an import's line, or between its annotations and its path, moves with it; one
// after the last import is left to what follows the section (as is one after a
// group's last spec, when the group is the last import).  A
// blank line follows the package clause, and one is kept wherever the source had
// one between imports and comments (2+ collapse to 1); a line holding only
// annotations, `import (` or `)` is not blank.  limit is the position of the
// first declaration (a comment from there on is not the import section's), or
// the zero Pos when there is none.
//
// Starts at the beginning of a line (after the package clause) and ends at the
// beginning of the line after the section.
func printImports(b @strings.Builder, cc @commentCursor, imports @[]@ast.ImportSpec,
		limit token.Pos) {
	if len(imports) == 0 {
		return
	}
	var ip @importPrinter = make(importPrinter)
	ip.b = b
	ip.cc = cc
	ip.imports = imports
	ip.run = vec.New[@importEntry]()
	for i := 0; i < len(imports); i++ {
		emitImportComments(ip, importCommentStart(imports, i), limit)
		var blank bool = ip.prevEndLine > 0 &&
				blankBetween(imports, ip.prevEndLine, importNextLine(ip, i))
		if blank {
			flushImportRun(ip)
		}
		if ip.run.Len() == 0 {
			ip.runBlank = blank
		}
		var next token.Pos = limit
		if i + 1 < len(imports) {
			next = importCommentStart(imports, i + 1)
		}
		var rp token.Pos = imports[i].RParen
		if rp.Line > 0 && (next.Line == 0 || posLess(rp, next)) {
			next = rp
		}
		var e @importEntry = takeImportEntry(cc, imports[i], next)
		ip.run.Push(e)
		ip.prevEndLine = importEndLine(e)
	}
	flushImportRun(ip)
	b.WriteByte('\n')
}

// emitImportComments emits, each on a line of its own, the pending comments
// positioned before pos (and before limit, unless it is the zero Pos), first
// sorting and emitting the run they end.  It stops at one ending on pos's line
// (`/* c */ import "p"`): that comment is the import's.
func emitImportComments(ip @importPrinter, pos token.Pos, limit token.Pos) {
	var cc @commentCursor = ip.cc
	if cc == nil { return }
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		if !posLess(c.Pos, pos) || c.End.Line == pos.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		flushImportRun(ip)
		if ip.prevEndLine > 0 && blankBetween(ip.imports, ip.prevEndLine, c.Pos.Line) {
			ip.b.WriteByte('\n')
		}
		ip.b.WriteByte('\n')
		ip.b.Write(c.Text)
		ip.prevEndLine = c.End.Line
		cc.idx = cc.idx + 1
	}
}

// flushImportRun emits the pending run, sorted by rendered import line (stable,
// so imports with equal lines keep their source order), each starting on a new
// line, after a blank line when the source had one before it; then starts an
// empty run.  Runs are small, so an insertion sort keeps it simple.
func flushImportRun(ip @importPrinter) {
	var run @[]@importEntry = ip.run.Items()
	if len(run) == 0 { return }
	for i := 1; i < len(run); i++ {
		var j int = i
		for j > 0 && lineLess(run[j].spec, run[j - 1].spec) {
			var tmp @importEntry = run[j]
			run[j] = run[j - 1]
			run[j - 1] = tmp
			j--
		}
	}
	if ip.runBlank {
		ip.b.WriteByte('\n')
	}
	for i := 0; i < len(run); i++ {
		printImportEntry(ip.b, run[i])
	}
	ip.run = vec.New[@importEntry]()
	ip.runBlank = false
}

// inGroupAfterFirst reports whether imports[i] is a grouped import's spec after
// its first, whose declaration (annotations and `import (`) precedes the group.
func inGroupAfterFirst(imports @[]@ast.ImportSpec, i int) bool {
	var spec @ast.ImportSpec = imports[i]
	return spec.RParen.Line > 0 && i > 0 && samePos(imports[i - 1].ImportPos, spec.ImportPos)
}

// importFirstLine returns the source line imports[i] starts on: its
// declaration's first, or its own for a grouped import's later spec.
func importFirstLine(imports @[]@ast.ImportSpec, i int) int {
	if inGroupAfterFirst(imports, i) {
		return imports[i].Pos.Line
	}
	return imports[i].DeclPos.Line
}

// importNextLine returns the first source line after the last placed item that
// imports[i] occupies: its first line, or its path's when a comment of its
// group's header was placed (that comment lies after the group's first line), or
// a pending comment's when one before the path is the import's (`/* a ... */
// import "p"`).
func importNextLine(ip @importPrinter, i int) int {
	var line int = importFirstLine(ip.imports, i)
	if ip.prevEndLine >= line {
		line = ip.imports[i].Pos.Line
	}
	var cc @commentCursor = ip.cc
	if cc != nil {
		skipDone(cc)
		if cc.idx < len(cc.comments) {
			var c @token.Comment = cc.comments[cc.idx]
			if c.Pos.Line < line && posLess(c.Pos, ip.imports[i].Pos) {
				line = c.Pos.Line
			}
		}
	}
	return line
}

// importCommentStart returns the position before which a comment is not
// imports[i]'s: its declaration's start, or, for a grouped spec, its own (a
// comment in a group's header belongs to the group, not its first spec).
func importCommentStart(imports @[]@ast.ImportSpec, i int) token.Pos {
	if imports[i].RParen.Line > 0 {
		return imports[i].Pos
	}
	return imports[i].DeclPos
}

// blankBetween reports whether some line strictly between lines from and to is
// blank in the source: holds no import's annotations, `import`, `(` or `)`.  The
// callers' from and to are the last and first lines of adjacent placed items,
// so no comment or import path lies between them.
func blankBetween(imports @[]@ast.ImportSpec, from int, to int) bool {
	for line := from + 1; line < to; line++ {
		var held bool = false
		for i := 0; i < len(imports) && !held; i++ {
			var s @ast.ImportSpec = imports[i]
			held = (s.DeclPos.Line <= line && line <= s.ImportPos.Line) || line == s.RParen.Line
		}
		if !held { return true }
	}
	return false
}

// samePos reports whether a and b are the same source position.
func samePos(a token.Pos, b token.Pos) bool {
	return a.Line == b.Line && a.Col == b.Col
}

// takeImportEntry builds spec's entry, taking from cc the comments that belong
// to it: those before its path (before or after its alias), and those after it
// on its line, short of next (the next import's start, the group's `)`, or the
// first declaration).  The caller has already emitted the comments before the
// spec's start.
func takeImportEntry(cc @commentCursor, spec @ast.ImportSpec, next token.Pos) @importEntry {
	var e @importEntry = make(importEntry)
	e.spec = spec
	e.inner = vec.New[@token.Comment]()
	e.inline = vec.New[@token.Comment]()
	e.mid = vec.New[@token.Comment]()
	e.trail = vec.New[@token.Comment]()
	if cc == nil {
		return e
	}
	for {
		skipDone(cc)
		if cc.idx >= len(cc.comments) { break }
		var c @token.Comment = cc.comments[cc.idx]
		if c.Pos.Line > spec.PathPos.Line { break }
		if next.Line > 0 && !posLess(c.Pos, next) { break }
		if posLess(spec.PathPos, c.Pos) {
			e.trail.Push(c)
		} else if posLess(spec.Pos, c.Pos) {
			// After the alias, before the path: a block comment (a line comment
			// would end the import there).
			e.mid.Push(c)
		} else if c.End.Line == spec.Pos.Line && isBlockComment(c) {
			e.inline.Push(c)
		} else {
			e.inner.Push(c)
		}
		cc.idx = cc.idx + 1
	}
	return e
}

// importEndLine returns the source line e ends on: its spec's, or a trailing
// block comment's last line.
func importEndLine(e @importEntry) int {
	var end int = e.spec.PathPos.Line
	var trail @[]@token.Comment = e.trail.Items()
	for i := 0; i < len(trail); i++ {
		if trail[i].End.Line > end {
			end = trail[i].End.Line
		}
	}
	return end
}

// printImportEntry emits a newline, then e's annotations and inner comments on
// lines of their own, then its import line (its inline comments after `import `,
// where they stay the import's when formatted again, and its mid comments after
// its alias) and trailing comments (no newline after).
func printImportEntry(b @strings.Builder, e @importEntry) {
	b.WriteByte('\n')
	printAnnotations(b, e.spec.Annotations)
	var inner @[]@token.Comment = e.inner.Items()
	for i := 0; i < len(inner); i++ {
		b.Write(inner[i].Text)
		b.WriteByte('\n')
	}
	b.Write("import ")
	var inline @[]@token.Comment = e.inline.Items()
	for i := 0; i < len(inline); i++ {
		b.Write(inline[i].Text)
		b.WriteByte(' ')
	}
	if len(e.spec.Alias) > 0 {
		b.Write(e.spec.Alias)
		b.WriteByte(' ')
		var mid @[]@token.Comment = e.mid.Items()
		for i := 0; i < len(mid); i++ {
			b.Write(mid[i].Text)
			b.WriteByte(' ')
		}
	}
	b.Write(e.spec.Path)
	var trail @[]@token.Comment = e.trail.Items()
	for i := 0; i < len(trail); i++ {
		b.WriteByte(' ')
		b.Write(trail[i].Text)
	}
}

// isBlockComment reports whether c is a `/* ... */` comment, which can sit
// within a line (a line comment would swallow the rest of it).
func isBlockComment(c @token.Comment) bool {
	return len(c.Text) >= 2 && c.Text[1] == '*'
}

// appendImport writes an import's canonical line body (no trailing newline):
// `import "<path>"`, or `import <alias> "<path>"` when an alias is present.
func appendImport(b @strings.Builder, spec @ast.ImportSpec) {
	b.Write("import ")
	appendImportBody(b, spec)
}

// appendImportBody writes what follows an import's `import `: `"<path>"`, or
// `<alias> "<path>"`.
func appendImportBody(b @strings.Builder, spec @ast.ImportSpec) {
	if len(spec.Alias) > 0 {
		b.Write(spec.Alias)
		b.WriteByte(' ')
	}
	b.Write(spec.Path)
}

// lineLess reports whether a's rendered import line sorts before b's, byte-wise
// on the whole `import ...` line (its annotations are not part of the key).
func lineLess(a @ast.ImportSpec, b @ast.ImportSpec) bool {
	return strLess(importLine(a), importLine(b))
}

// importLine renders an import spec to its canonical line (no trailing newline),
// used as the sort key.
func importLine(spec @ast.ImportSpec) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	appendImport(b, spec)
	return b.String()
}
