package "pkg/binate/format"

import "pkg/builtins/testing"

// An import's annotation block keeps the comments in it, and those after its `]` on
// that line trail it; they move with the import when its run is sorted.  Those
// before its `#` on that line go on lines of their own above it, as a declaration's
// do: after the `]` they would have no room on the block's line.  A grouped
// import's block goes on each of its imports without its comments, which are the
// group's: above its imports, or with the first when they share its line.
func TestImportAnnotationKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\")) /* c */] /* d */ import \"pkg/z\"\n"
			"#[build(is(os, \"darwin\")), // e\n"
			"\ttool.lint] // f\n"
			"import \"pkg/a\"\n"
			"import \"pkg/m\"\n"
			"\n"
			"#[build(is(os, \"linux\")), /* g */ tool.lint] // h\n"
			"import (\n"
			"\t\"pkg/c\"\n"
			"\t\"pkg/b\"\n"
			")\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"darwin\")), // e\n"
			"\t\ttool.lint] // f\n"
			"import \"pkg/a\"\n"
			"import \"pkg/m\"\n"
			"#[build(is(os, \"linux\")) /* c */]\n"
			"import /* d */ \"pkg/z\"\n"
			"\n"
			"/* g */\n"
			"// h\n"
			"#[build(is(os, \"linux\")), tool.lint]\n"
			"import \"pkg/b\"\n"
			"#[build(is(os, \"linux\")), tool.lint]\n"
			"import \"pkg/c\"\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	r = checkFormatGolden("package \"t\"\n\n#[a /* c */] import ( \"pkg/y\"; \"pkg/x\" )\n",
			"package \"t\"\n\n#[a]\nimport \"pkg/x\"\n#[a]\nimport /* c */ \"pkg/y\"\n")
	if len(r) > 0 { return r }
	var before *[]readonly char = "package \"t\"\n"
			"\n"
			"import (\"q\"); /* a long comment before the hash, which is followed on its line */ "
			"#[build(is(os, \"linux\"), lint)] // d\n"
			"import \"x\"\n"
			"/* e */ #[lint]\n"
			"import \"y\"\n"
	var above *[]readonly char = "package \"t\"\n"
			"\n"
			"import \"q\"\n"
			"/* a long comment before the hash, which is followed on its line */\n"
			"#[build(is(os, \"linux\"), lint)] // d\n"
			"import \"x\"\n"
			"/* e */\n"
			"#[lint]\n"
			"import \"y\"\n"
	return checkFormatGolden(before, above)
}

// The blank lines among the comments between an import's annotation block and its
// `import` are kept, as a declaration's are, and move with the import when its run
// is sorted; after an empty block, so is the one before `import`, the lines of that
// block not counted as blank.  Nor is the line of `import`, which a comment before
// the path can follow (an import with no block keeps the blank lines among those),
// or the first line of a comment that ends on the path's line, which prints inline.
func TestImportBlockKeepsTheBlankLinesAmongItsComments() testing.TestResult {
	var r testing.TestResult = checkFormatGolden(
			"package \"p\"\n\nimport \"z\"\n#[x]\n\n// e\n\n// f\n\nimport \"g\"\n",
			"package \"p\"\n\n#[x]\n// e\n\n// f\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	r = checkFormatGolden("package \"p\"\n\nimport \"z\"\n#[]\n// e\n\n// f\n\nimport \"g\"\n",
			"package \"p\"\n\n// e\n\n// f\n\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	r = checkFormatGolden(
			"package \"p\"\n\nimport \"z\"\n#[ // e\n\n// f\n]\n// h\nimport \"g\"\n",
			"package \"p\"\n\n// e\n\n// f\n// h\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	var lone *[]readonly char = "package \"p\"\n"
			"\n"
			"#[x]\n"
			"// a\n"
			"import\n"
			"// b\n"
			"\"pkg/a\"\n"
			"\n"
			"#[]\n"
			"// c\n"
			"\n"
			"import\n"
			"// d\n"
			"\"pkg/b\"\n"
			"\n"
			"import // e\n"
			"\n"
			"// f\n"
			"\"pkg/c\"\n"
	var loneWant *[]readonly char = "package \"p\"\n"
			"\n"
			"#[x]\n"
			"// a\n"
			"// b\n"
			"import \"pkg/a\"\n"
			"\n"
			"// c\n"
			"\n"
			"// d\n"
			"import \"pkg/b\"\n"
			"\n"
			"// e\n"
			"\n"
			"// f\n"
			"import \"pkg/c\"\n"
	r = checkFormatGolden(lone, loneWant)
	if len(r) > 0 { return r }
	var inl *[]readonly char = "package \"p\"\n"
			"\n"
			"#[]\n"
			"// e\n"
			"/* f\n"
			" */ import \"pkg/a\"\n"
			"\n"
			"#[]\n"
			"// g\n"
			"\n"
			"/* h\n"
			" */ import \"pkg/b\"\n"
	var inlWant *[]readonly char = "package \"p\"\n"
			"\n"
			"// e\n"
			"import /* f\n"
			" */ \"pkg/a\"\n"
			"\n"
			"// g\n"
			"\n"
			"import /* h\n"
			" */ \"pkg/b\"\n"
	return checkFormatGolden(inl, inlWant)
}
