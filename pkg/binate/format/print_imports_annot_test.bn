package "pkg/binate/format"

import "pkg/builtins/testing"

// An import's annotation block keeps the comments in it, and those after its `]` on
// that line trail it; they move with the import when its run is sorted.  Those
// before its `#` on that line go on lines of their own above it, as a declaration's
// do: after the `]` they would have no room on the block's line.  A grouped
// import's block goes on each of its imports without its comments, which are the
// group's: above its imports, or with the first when they share its line.
func TestImportAnnotationKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"linux\")) /* c */] /* d */ import \"pkg/z\"\n"
			"#[build(is(os, \"darwin\")), // e\n"
			"\ttool.lint] // f\n"
			"import \"pkg/a\"\n"
			"import \"pkg/m\"\n"
			"\n"
			"#[build(is(os, \"linux\")), /* g */ tool.lint] // h\n"
			"import (\n"
			"\t\"pkg/c\"\n"
			"\t\"pkg/b\"\n"
			")\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"#[build(is(os, \"darwin\")), // e\n"
			"\t\ttool.lint] // f\n"
			"import \"pkg/a\"\n"
			"import \"pkg/m\"\n"
			"#[build(is(os, \"linux\")) /* c */]\n"
			"import /* d */ \"pkg/z\"\n"
			"\n"
			"/* g */\n"
			"// h\n"
			"#[build(is(os, \"linux\")), tool.lint]\n"
			"import \"pkg/b\"\n"
			"#[build(is(os, \"linux\")), tool.lint]\n"
			"import \"pkg/c\"\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	r = checkFormatGolden("package \"t\"\n\n#[a /* c */] import ( \"pkg/y\"; \"pkg/x\" )\n",
			"package \"t\"\n\n#[a]\nimport \"pkg/x\"\n#[a]\nimport /* c */ \"pkg/y\"\n")
	if len(r) > 0 { return r }
	var before *[]readonly char = "package \"t\"\n"
			"\n"
			"import (\"q\"); /* a long comment before the hash, which is followed on its line */ "
			"#[build(is(os, \"linux\"), lint)] // d\n"
			"import \"x\"\n"
			"/* e */ #[lint]\n"
			"import \"y\"\n"
	var above *[]readonly char = "package \"t\"\n"
			"\n"
			"import \"q\"\n"
			"/* a long comment before the hash, which is followed on its line */\n"
			"#[build(is(os, \"linux\"), lint)] // d\n"
			"import \"x\"\n"
			"/* e */\n"
			"#[lint]\n"
			"import \"y\"\n"
	return checkFormatGolden(before, above)
}

// The blank lines among the comments between an import's annotation block and its
// `import` are kept, as a declaration's are, and move with the import when its run
// is sorted; after an empty block, so is the one before `import`, the lines of that
// block not counted as blank.  Nor is the line of `import`, which a comment before
// the path can follow (an import with no block keeps the blank lines among those),
// or the first line of a comment that ends on the path's line, which prints inline.
func TestImportBlockKeepsTheBlankLinesAmongItsComments() testing.TestResult {
	var r testing.TestResult = checkFormatGolden(
			"package \"p\"\n\nimport \"z\"\n#[x]\n\n// e\n\n// f\n\nimport \"g\"\n",
			"package \"p\"\n\n#[x]\n// e\n\n// f\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	r = checkFormatGolden("package \"p\"\n\nimport \"z\"\n#[]\n// e\n\n// f\n\nimport \"g\"\n",
			"package \"p\"\n\n// e\n\n// f\n\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	r = checkFormatGolden(
			"package \"p\"\n\nimport \"z\"\n#[ // e\n\n// f\n]\n// h\nimport \"g\"\n",
			"package \"p\"\n\n// e\n\n// f\n// h\nimport \"g\"\nimport \"z\"\n")
	if len(r) > 0 { return r }
	var lone *[]readonly char = "package \"p\"\n"
			"\n"
			"#[x]\n"
			"// a\n"
			"import\n"
			"// b\n"
			"\"pkg/a\"\n"
			"\n"
			"#[]\n"
			"// c\n"
			"\n"
			"import\n"
			"// d\n"
			"\"pkg/b\"\n"
			"\n"
			"import // e\n"
			"\n"
			"// f\n"
			"\"pkg/c\"\n"
	var loneWant *[]readonly char = "package \"p\"\n"
			"\n"
			"#[x]\n"
			"// a\n"
			"// b\n"
			"import \"pkg/a\"\n"
			"\n"
			"// c\n"
			"\n"
			"// d\n"
			"import \"pkg/b\"\n"
			"\n"
			"// e\n"
			"\n"
			"// f\n"
			"import \"pkg/c\"\n"
	r = checkFormatGolden(lone, loneWant)
	if len(r) > 0 { return r }
	var inl *[]readonly char = "package \"p\"\n"
			"\n"
			"#[]\n"
			"// e\n"
			"/* f\n"
			" */ import \"pkg/a\"\n"
			"\n"
			"#[]\n"
			"// g\n"
			"\n"
			"/* h\n"
			" */ import \"pkg/b\"\n"
	var inlWant *[]readonly char = "package \"p\"\n"
			"\n"
			"// e\n"
			"import /* f\n"
			" */ \"pkg/a\"\n"
			"\n"
			"// g\n"
			"\n"
			"import /* h\n"
			" */ \"pkg/b\"\n"
	return checkFormatGolden(inl, inlWant)
}

// A file parsed without comments records no token lines: a group's `)` line still
// holds part of its declaration, and the import after it joins its run.
func TestGroupedImportWithoutTokenLines() testing.TestResult {
	return checkGolden("package \"p\"\n\nimport (\n\"b\"\n)\nimport \"a\"\n",
			"package \"p\"\n\nimport \"a\"\nimport \"b\"\n")
}

// A grouped import's comments before its first import print above the run, as the
// group's, keeping the blank lines among them and after them: only the group's lines
// that hold a token -- of its block, also inside one with entries, its `import`, its
// `(` and its `)` -- are not blank ones.  With no comment of the group placed, no blank
// line is read in its declaration, as when it starts a line: not when an import before
// it ends on its first line either.
func TestGroupedImportKeepsTheBlankLinesAmongItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"q\"\n"
			"#[x]\n"
			"// a\n"
			"\n"
			"// a2\n"
			"\n"
			"import (\n"
			"// b\n"
			"\"y\"\n"
			"\"x\"\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"q\"\n"
			"// a\n"
			"\n"
			"// a2\n"
			"\n"
			"// b\n"
			"#[x]\n"
			"import \"x\"\n"
			"#[x]\n"
			"import \"y\"\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	var empty *[]readonly char = "package \"p\"\n"
			"\n"
			"#[]\n"
			"// a\n"
			"\n"
			"import (\n"
			"// b\n"
			"\n"
			"// c\n"
			"\"y\"\n"
			")\n"
	var emptyWant *[]readonly char = "package \"p\"\n"
			"\n"
			"// a\n"
			"\n"
			"// b\n"
			"\n"
			"// c\n"
			"import \"y\"\n"
	r = checkFormatGolden(empty, emptyWant)
	if len(r) > 0 { return r }
	var held *[]readonly char = "package \"p\"\n"
			"\n"
			"#\n"
			"// a\n"
			"[\n"
			"// b\n"
			"]\n"
			"import (\n"
			"\"y\"\n"
			")\n"
			"\n"
			"#[\n"
			"// c\n"
			"]\n"
			"// d\n"
			"import (\n"
			"\"x\"\n"
			")\n"
			"\n"
			"#[x]\n"
			"// e\n"
			"import\n"
			"(\n"
			"// f\n"
			"\"z\"\n"
			")\n"
	var heldWant *[]readonly char = "package \"p\"\n"
			"\n"
			"// a\n"
			"// b\n"
			"import \"y\"\n"
			"\n"
			"// c\n"
			"// d\n"
			"import \"x\"\n"
			"\n"
			"// e\n"
			"// f\n"
			"#[x]\n"
			"import \"z\"\n"
	r = checkFormatGolden(held, heldWant)
	if len(r) > 0 { return r }
	var shared *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"z\"; #[x]\n"
			"\n"
			"import (\n"
			"\"a\"\n"
			")\n"
			"\n"
			"import \"q\"; import (\n"
			"\n"
			"\"b\"\n"
			")\n"
			"\n"
			"import \"y\"; #[x] // c\n"
			"\n"
			"import (\n"
			"\"c\"\n"
			")\n"
			"\n"
			"import \"w\"\n"
			"#[x]\n"
			"// d\n"
			"\n"
			"import (\n"
			"\"d\"\n"
			")\n"
	var sharedWant *[]readonly char = "package \"p\"\n"
			"\n"
			"#[x]\n"
			"import \"a\"\n"
			"import \"z\"\n"
			"\n"
			"import \"b\"\n"
			"import \"q\"\n"
			"\n"
			"import \"y\"\n"
			"// c\n"
			"\n"
			"#[x]\n"
			"import \"c\"\n"
			"\n"
			"import \"w\"\n"
			"// d\n"
			"\n"
			"#[x]\n"
			"import \"d\"\n"
	r = checkFormatGolden(shared, sharedWant)
	if len(r) > 0 { return r }
	var inside *[]readonly char = "package \"p\"\n"
			"\n"
			"#[a, // c\n"
			"\n"
			"// d\n"
			"b(\n"
			"// e\n"
			"1),\n"
			"// f\n"
			"\n"
			"z]\n"
			"import (\n"
			"\"y\"\n"
			")\n"
	var insideWant *[]readonly char = "package \"p\"\n"
			"\n"
			"// c\n"
			"\n"
			"// d\n"
			"// e\n"
			"// f\n"
			"\n"
			"#[a, b(\n"
			"\t\t1), z]\n"
			"import \"y\"\n"
	return checkFormatGolden(inside, insideWant)
}

// An empty import group (`import ()`) prints nothing, and its comments print on lines
// of their own, keeping the blank lines among them and after them, as a group's before
// its first import do: only its lines that hold a token are not blank ones, also inside
// a block with entries.  So does one of them that ends on the next import's line, which
// is the group's too.  With none of its comments, no blank line is read in its
// declaration, its parentheses included, and the imports around it stay one run.
func TestEmptyImportGroupKeepsTheBlankLinesAmongItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"z\"\n"
			"#[x]\n"
			"// a\n"
			"\n"
			"// b\n"
			"\n"
			"import ()\n"
			"import \"y\"\n"
			"\n"
			"import \"q\"\n"
			"#[x, // c\n"
			"\n"
			"// d\n"
			"w]\n"
			"import ()\n"
			"import \"p\"\n"
			"\n"
			"import \"o\"\n"
			"#[x]\n"
			"\n"
			"import ()\n"
			"import \"n\"\n"
			"\n"
			"import \"m\"\n"
			"#[x]\n"
			"\n"
			"// e\n"
			"import ()\n"
			"import \"l\"\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"z\"\n"
			"// a\n"
			"\n"
			"// b\n"
			"\n"
			"import \"y\"\n"
			"\n"
			"import \"q\"\n"
			"// c\n"
			"\n"
			"// d\n"
			"import \"p\"\n"
			"\n"
			"import \"n\"\n"
			"import \"o\"\n"
			"\n"
			"import \"m\"\n"
			"\n"
			"// e\n"
			"import \"l\"\n"
	var r testing.TestResult = checkFormatGolden(src, want)
	if len(r) > 0 { return r }
	r = checkFormatGolden("package \"p\"\n\nimport \"b\"\nimport (\n\n)\nimport \"a\"\n",
			"package \"p\"\n\nimport \"a\"\nimport \"b\"\n")
	if len(r) > 0 { return r }
	return checkFormatGolden(
			"package \"p\"\n\nimport \"z\"\n#[x]\n\nimport ( /* c\n*/ ) ; import \"b\"\n",
			"package \"p\"\n\nimport \"z\"\n\n/* c\n*/\nimport \"b\"\n")
}
