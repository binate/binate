package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for what the import section spans (print_imports.bn): an empty group's
// lines, where the section ends before a declaration joined to its last import
// by `;`, and where an import ends before an import group joined to it.

// An empty `import ()` group prints nothing, and its lines are not blank lines:
// the imports around it are one run, sorted together.  A blank line before or
// after it is still one.
func TestFormatEmptyImportGroupNotBlank() testing.TestResult {
	var want *[]readonly char = "package \"p\"\n\nimport \"a\"\nimport \"b\"\n"
	var r testing.TestResult = checkImports("package \"p\"\n\nimport \"b\"\nimport ()\nimport \"a\"\n",
			want)
	if len(r) > 0 { return r }
	r = checkImports("package \"p\"\n\nimport \"b\"\nimport (\n)\nimport \"a\"\n", want)
	if len(r) > 0 { return r }
	r = checkImports("package \"p\"\n\nimport \"b\"\n#[build(x)]\nimport ()\nimport \"a\"\n", want)
	if len(r) > 0 { return r }
	var blank *[]readonly char = "package \"p\"\n\nimport \"b\"\n\nimport \"a\"\n"
	r = checkImports("package \"p\"\n\nimport \"b\"\n\nimport ()\nimport \"a\"\n", blank)
	if len(r) > 0 { return r }
	return checkImports("package \"p\"\n\nimport \"b\"\nimport ()\n\nimport \"a\"\n", blank)
}

// A comment in an empty group stays where it was, on a line of its own, with no
// blank line after it for the group's `)`; a blank line between two comments in
// it is kept.
func TestFormatEmptyImportGroupComment() testing.TestResult {
	var r testing.TestResult = checkImports(
			"package \"p\"\n\nimport \"b\"\nimport (\n// c1\n\n// c2\n)\nimport \"a\"\n",
			"package \"p\"\n\nimport \"b\"\n// c1\n\n// c2\nimport \"a\"\n")
	if len(r) > 0 { return r }
	return checkImports("package \"p\"\n\nimport \"b\"\nimport ( // c\n)\nimport \"a\"\n",
			"package \"p\"\n\nimport \"b\"\n// c\nimport \"a\"\n")
}

// A comment after the `#` of the annotation block of a declaration joined to the
// last import by `;` is the declaration's, not the import's trailing comment:
// the section ends where the declaration starts, at its `#`.  So is one after
// the `#` of a declaration joined to the package clause.
func TestFormatCommentInJoinedDeclAnnotation() testing.TestResult {
	var r testing.TestResult = checkImports(
			"package \"p\"\n\nimport \"a\"; #[x] /* c */ func f() {}\n",
			"package \"p\"\n\nimport \"a\"\n\n#[x]\n/* c */\nfunc f() {}\n")
	if len(r) > 0 { return r }
	r = checkImports("package \"p\"\n\nimport \"a\"; #[x(1, /* c */ 2)]\nfunc f() {}\n",
			"package \"p\"\n\nimport \"a\"\n\n#[x(1, 2)] /* c */\nfunc f() {}\n")
	if len(r) > 0 { return r }
	r = checkImports("package \"p\"\n\nimport \"a\"; #[ /* c */ x] func f() {}\n",
			"package \"p\"\n\nimport \"a\"\n\n#[x]\n/* c */\nfunc f() {}\n")
	if len(r) > 0 { return r }
	return checkImports("package \"p\"; #[ /* c */ x] func f() {}\n",
			"package \"p\"\n\n#[x]\n/* c */\nfunc f() {}\n")
}

// An import followed on its line by an import group takes only the comments before the group's
// declaration: one in the group's header, after its `(`, is the group's -- on its first
// import's line, or above it when it ends the line.
func TestFormatImportStopsAtNextImportDecl() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"a\"; import ( /* b */ \"c\" )\n"
			"import \"d\"; import ( // e\n"
			"\t\"f\"\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"import \"a\"\n"
			"import /* b */ \"c\"\n"
			"import \"d\"\n"
			"// e\n"
			"import \"f\"\n"
	return checkFormatGolden(src, want)
}
