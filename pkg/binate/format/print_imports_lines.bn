package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"

// The import section's lines (print_imports.bn): where an import's declaration and its
// comments start, which lines between the items placed are blank ones, and where the
// empty groups lie.

// importFirstLine returns the source line imports[i] starts on: its
// declaration's first, or its own for a grouped import's later spec.
func importFirstLine(imports @[]@ast.ImportSpec, i int) int {
	if inGroupAfterFirst(imports, i) {
		return imports[i].Pos.Line
	}
	return imports[i].DeclPos.Line
}

// importNextLine returns the first source line after the last placed item that
// imports[i] occupies: its first line, or its path's when the last item placed is a
// comment of its group's header, after its `#` (the blank lines from there to the
// path are kept, importHolds), or a pending comment's when one before the path is
// the import's (`/* a ... */ import "p"`).  When the last item placed is an import
// or a comment ending on its first line (`import "a"; #[x]`), no line after it is
// returned: no blank line is read in its declaration, as when it starts a line.
func importNextLine(ip @importPrinter, i int) int {
	var line int = importFirstLine(ip.imports, i)
	if ip.prevEndLine >= line && posLess(ip.imports[i].DeclPos, ip.lastComment) {
		line = ip.imports[i].Pos.Line
	}
	var cc @commentCursor = ip.cc
	if cc != nil {
		skipDone(cc)
		if cc.idx < len(cc.comments) {
			var c @token.Comment = cc.comments[cc.idx]
			if c.Pos.Line < line && posLess(c.Pos, ip.imports[i].Pos) { line = c.Pos.Line }
		}
	}
	return line
}

// importCommentStart returns the position before which a comment is not
// imports[i]'s: its declaration's start, or, for a grouped spec, its own (a
// comment in a group's header belongs to the group, not its first spec).
func importCommentStart(imports @[]@ast.ImportSpec, i int) token.Pos {
	if imports[i].RParen.Line > 0 {
		return imports[i].Pos
	}
	return imports[i].DeclPos
}

// blankBetween reports whether some line strictly between lines from and to is
// blank in the source: holds no part of an import's or an empty group's declaration
// (importHolds, emptyHolds).  The callers' from and to are the last and first lines
// of adjacent placed items, so no comment or import path lies between them; next is
// the position of the comment placed at to, or the zero Pos when an import is.
func blankBetween(ip @importPrinter, from int, to int, next token.Pos) bool {
	for line := from + 1; line < to; line++ {
		var held bool = false
		for i := 0; i < len(ip.imports) && !held; i++ {
			held = importHolds(ip.imports[i], line)
		}
		for i := 0; i < len(ip.empty) && !held; i++ {
			held = emptyHolds(ip, ip.empty[i], line, next)
		}
		if !held { return true }
	}
	return false
}

// emptyHolds reports whether blankBetween counts line as part of the empty group g's
// declaration rather than as a blank line.  The group prints nothing, and its
// comments print on lines of their own, as a group's before its first import do.
// Next to one of them -- the last comment placed, or next, the item after the line --
// only the group's lines that hold a token (holdsToken) count, keeping the blank
// lines among its comments and around them; otherwise every line from its `#` to its
// `)` does, so that no blank line is read inside a declaration that prints nothing.
func emptyHolds(ip @importPrinter, g @ast.EmptyImport, line int, next token.Pos) bool {
	if inEmptyGroup(g, ip.lastComment) || inEmptyGroup(g, next) {
		return g.DeclPos.Line <= line && line <= g.RParen.Line && holdsToken(line)
	}
	return g.DeclPos.Line <= line && line <= g.RParen.Line
}

// inEmptyGroup reports whether pos lies inside the empty group g's declaration.
func inEmptyGroup(g @ast.EmptyImport, pos token.Pos) bool {
	return posLess(g.DeclPos, pos) && posLess(pos, g.RParen)
}

// emptyGroupBetween reports whether an empty group lies, in whole or in part, between
// positions from and to: one that ends after from and starts before to.
func emptyGroupBetween(ip @importPrinter, from token.Pos, to token.Pos) bool {
	for i := 0; i < len(ip.empty); i++ {
		var g @ast.EmptyImport = ip.empty[i]
		if posLess(from, g.RParen) && posLess(g.DeclPos, to) { return true }
	}
	return false
}

// emptyGroupAfter returns where the first empty group after pos starts (its
// declaration's start), or the zero Pos when none does.  The empty groups are in
// source order.
func emptyGroupAfter(ip @importPrinter, pos token.Pos) token.Pos {
	var none token.Pos
	for i := 0; i < len(ip.empty); i++ {
		if posLess(pos, ip.empty[i].DeclPos) { return ip.empty[i].DeclPos }
	}
	return none
}

// importHolds reports whether blankBetween counts line as part of import spec s's
// declaration rather than as a blank line.  An ungrouped import's declaration prints
// as one entry, so every line from its `#` to its `import` counts.  A group's
// comments before its first import print on lines of their own above the run,
// keeping the blank lines among them and after them, so only the lines of the
// group's that hold a token (holdsToken) do -- of its annotation block, its
// `import`, `(`, imports and `)`.  A file parsed without comments records no token
// lines, and has no comments to place: there a group's lines from its `#` to its
// `import` count, and its `)`'s.
func importHolds(s @ast.ImportSpec, line int) bool {
	if s.RParen.Line == 0 { return s.DeclPos.Line <= line && line <= s.ImportPos.Line }
	if len(activeTokenLines) == 0 {
		return (s.DeclPos.Line <= line && line <= s.ImportPos.Line) || line == s.RParen.Line
	}
	return s.DeclPos.Line <= line && line <= s.RParen.Line && holdsToken(line)
}
