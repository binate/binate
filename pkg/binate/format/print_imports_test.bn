package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the import section (print_imports.bn): annotations, comments and
// sorting runs.

// checkImports formats src (parsed with comments) and asserts the output is want
// exactly, is a fixpoint, and keeps the source's comments.
func checkImports(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var fin @ast.File = parseCollected(src)
	var out @[]readonly char = Format(fin)
	if !streq(out, want) {
		return goldenDiff(out, want)
	}
	var fout @ast.File = parseCollected(out)
	var again @[]readonly char = Format(fout)
	if !streq(again, out) {
		return goldenDiff(again, out)
	}
	if !commentsMultisetEqual(fin.Comments, fout.Comments) {
		return commentDiff(fin.Comments, fout.Comments, out)
	}
	return ""
}

// Annotated imports with a comment above them come out byte-for-byte as written
// (conformance 737_build_import_select's pkg/sel/sel.bn).
func TestFormatAnnotatedImportsRoundTrip() testing.TestResult {
	var src *[]readonly char = "package \"pkg/sel\"\n"
			"\n"
			"// Conditional imports: only the matching helper is followed.\n"
			"#[build(is(arch, \"aarch64\"))]\n"
			"import \"pkg/sel_aa\"\n"
			"#[build(!is(arch, \"aarch64\"))]\n"
			"import \"pkg/sel_other\"\n"
			"\n"
			"#[build(is(arch, \"aarch64\"))]\n"
			"func Pick() *[]readonly char {\n"
			"\treturn sel_aa.Tag()\n"
			"}\n"
	return checkImports(src, src)
}

// A lone annotated import before a declaration (conformance
// 1370_build_gated_import_multi_file's pkg/sel/a.bn) round-trips.
func TestFormatLoneAnnotatedImportRoundTrip() testing.TestResult {
	var src *[]readonly char = "package \"pkg/sel\"\n"
			"\n"
			"#[build(is(arch, \"x64\") && is(arch, \"aarch64\"))]\n"
			"import \"pkg/never\"\n"
			"\n"
			"func A() int {\n"
			"\treturn 7\n"
			"}\n"
	return checkImports(src, src)
}

// An import's annotations move with it when its run is sorted, and an
// annotation on the import's own line goes on the line before it.
func TestFormatAnnotationTravelsWithImport() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"#[build(is(os, \"linux\"))] import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/a\"\n"
			"import \"pkg/z\"\n"
	return checkImports(src, want)
}

// A grouped import's annotations apply to every spec, so each collapsed import
// carries them.
func TestFormatAnnotatedGroupCollapsed() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import (\n"
			"\t\"pkg/b\"\n"
			"\t\"pkg/a\"\n"
			")\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/a\"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/b\"\n"
	return checkImports(src, want)
}

// An own-line comment between imports stays in place: the imports on either side
// of it are sorted separately, never across it.
func TestFormatImportCommentStaysInPlace() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"import \"pkg/y\"\n"
			"// the rest\n"
			"import \"pkg/b\"\n"
			"import \"pkg/a\"\n"
			"\n"
			"func f() {}\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/y\"\n"
			"import \"pkg/z\"\n"
			"// the rest\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
			"\n"
			"func f() {}\n"
	return checkImports(src, want)
}

// A comment above the first import stays above the import section, and blank
// lines around a comment between runs are kept.
func TestFormatImportSectionComments() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"// head\n"
			"import \"pkg/b\"\n"
			"import \"pkg/a\"\n"
			"\n"
			"// second run\n"
			"\n"
			"import \"pkg/d\"\n"
			"import \"pkg/c\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"// head\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
			"\n"
			"// second run\n"
			"\n"
			"import \"pkg/c\"\n"
			"import \"pkg/d\"\n"
	return checkImports(src, want)
}

// A comment on an import's line, or between its annotations and its path, moves
// with the import when its run is sorted.
func TestFormatImportTrailingCommentTravels() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\" // zed\n"
			"#[build(is(os, \"linux\"))]\n"
			"// why a\n"
			"import \"pkg/a\" /* ay */\n"
			"import \"pkg/m\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"// why a\n"
			"import \"pkg/a\" /* ay */\n"
			"import \"pkg/m\"\n"
			"import \"pkg/z\" // zed\n"
	return checkImports(src, want)
}

// A block comment on an import's line before its path, after `import` or before
// it, is the import's, not a barrier: it moves with the import when its run is
// sorted, inline after `import `.
func TestFormatImportCommentBeforePathTravels() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"import /* c */ \"pkg/b\"\n"
			"/* d */ import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import /* d */ \"pkg/a\"\n"
			"import /* c */ \"pkg/b\"\n"
			"import \"pkg/z\"\n"
	return checkImports(src, want)
}

// A grouped import's `import (` and `)` lines are not blank lines: a group and
// the imports around it form one run.
func TestFormatGroupJoinsRun() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import (\n"
			"\t\"pkg/c\"\n"
			"\t\"pkg/b\"\n"
			")\n"
			"import \"pkg/a\"\n"
			"import (\n"
			"\t\"pkg/d\"\n"
			")\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
			"import \"pkg/c\"\n"
			"import \"pkg/d\"\n"
	return checkImports(src, want)
}

// Comments in a group stay in place: a doc comment above it stays attached, one
// in its header goes before its imports, and one before its `)` ends the run.
func TestFormatGroupComments() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"// imports doc\n"
			"import (\n"
			"\t// first\n"
			"\t\"pkg/b\"\n"
			"\t\"pkg/a\"\n"
			"\t// tail in group\n"
			")\n"
			"import \"pkg/c\" // see\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"// imports doc\n"
			"// first\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
			"// tail in group\n"
			"import \"pkg/c\" // see\n"
	return checkImports(src, want)
}

// A comment between a grouped import's annotations and `import (` describes the
// group: it goes before the group's imports, which each carry the annotations.
// One after the closing `)` of the last import follows the section.
func TestFormatAnnotatedGroupHeaderComment() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"#[build(is(os, \"linux\"))]\n"
			"// linux only\n"
			"import (\n"
			"\t\"pkg/b\"\n"
			"\t\"pkg/a\"\n"
			") // end\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"// linux only\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/a\"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/b\"\n"
			"\n"
			"// end\n"
	return checkImports(src, want)
}

// An annotation block written over several lines starts the import: no blank
// line is read before it, and a doc comment above it stays attached.
func TestFormatMultiLineAnnotation() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"// doc\n"
			"#[\n"
			"build(is(os, \"linux\"))]\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"// doc\n"
			"#[build(is(os, \"linux\"))]\n"
			"import \"pkg/a\"\n"
	return checkImports(src, want)
}

// Build-gated imports bound to one alias keep their annotations and alias.
func TestFormatAnnotatedAliasedImports() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import sysi \"pkg/impl_linux\"\n"
			"#[build(!is(os, \"linux\"))]\n"
			"import sysi \"pkg/impl_other\"\n"
	return checkImports(src, src)
}

// A comment after a declaration that shares the last import's line is the
// declaration's, not the import's.
func TestFormatImportLineSharedWithDecl() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"; func f() { // c\n"
			"}\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"\n"
			"func f() {\n"
			"\t// c\n"
			"}\n"
	return checkImports(src, want)
}

// A block comment trailing an import over several lines ends it on its last
// line, and travels with it.
func TestFormatImportMultiLineTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\" /* one\n"
			"two */\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/z\" /* one\n"
			"two */\n"
	return checkImports(src, want)
}

// A line comment after an import's annotations, on their line, goes on a line of
// its own before `import` — placed inline it would swallow the path.
func TestFormatLineCommentAfterAnnotation() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"#[build(is(os, \"linux\"))] // why\n"
			"import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"#[build(is(os, \"linux\"))]\n"
			"// why\n"
			"import \"pkg/a\"\n"
			"import \"pkg/z\"\n"
	return checkImports(src, want)
}

// A blank line in a group ends a run there, a later spec's inline comment moves
// with it, and a blank line after a group's header comment is kept.
func TestFormatGroupBlankAndHeaderComment() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import (\n"
			"\t// header\n"
			"\n"
			"\t\"pkg/d\"\n"
			"\t/* c */ \"pkg/c\"\n"
			"\n"
			"\t\"pkg/b\"\n"
			"\t\"pkg/a\"\n"
			")\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"// header\n"
			"\n"
			"import /* c */ \"pkg/c\"\n"
			"import \"pkg/d\"\n"
			"\n"
			"import \"pkg/a\"\n"
			"import \"pkg/b\"\n"
	return checkImports(src, want)
}

// A block comment over several lines that ends where an import starts is the
// import's: no blank line is read in it, and the imports form one run.
func TestFormatMultiLineCommentBeforeImport() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import \"pkg/z\"\n"
			"/* a\n"
			"\n"
			"   b */ import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import /* a\n"
			"\n"
			"   b */ \"pkg/a\"\n"
			"import \"pkg/z\"\n"
	return checkImports(src, want)
}

// A comment after a group's `)`, on the line of the next import, is that
// import's.
func TestFormatCommentAfterGroupOnNextImport() testing.TestResult {
	var src *[]readonly char = "package \"m\"\n"
			"\n"
			"import (\n"
			"\t\"pkg/b\"\n"
			") /* c */; import \"pkg/a\"\n"
	var want *[]readonly char = "package \"m\"\n"
			"\n"
			"import /* c */ \"pkg/a\"\n"
			"import \"pkg/b\"\n"
	return checkImports(src, want)
}
