package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"

// A close that follows what precedes it on its line -- a slice's `]`, a type
// assertion's `)`, and that of a builtin with a type operand or of `__c_call` --
// prints the comments before it where they stand, as a list's close does
// (print_closegaps.bn), but only when each is a block comment on one line, as a
// line break before it would end the statement.  Otherwise it leaves them all for
// after the statement (claimInlineGap).  After the `:` of a slice with no high bound
// and after a `__c_call`'s `...` a line may break, so those print them all there, as
// a list does before its close (writeBreakableCloserGap).
// The close claims them once what precedes it has been rendered, for the lists in
// it to claim their own.

// sliceCloserGap returns the comments slice e prints before its `]`, keyed by its
// `[` (its Pos), from its last bound's start, or from the `[` when it has no bound
// (argsCloserGap): with a high bound, only block comments on one line; without one,
// all of them, after its `:`.
func sliceCloserGap(e @ast.Expr) @[]@token.Comment {
	if e.Y != nil { return argsCloserGap(e.Pos, e.Y, e.Pos, true) }
	if e.Z != nil { return argsCloserGap(e.Pos, e.Z, e.Pos, false) }
	return claimGap(e.Pos, pairedClose(e.Pos), e.Pos)
}

// assertCloserGap returns the comments type assertion e prints before its `)`,
// paired with the first opener after its `.` (its Pos), and keyed by the `.`: block
// comments on one line from its type's start (claimInlineGap).  The type has been
// rendered already, for the lists in it to claim their own comments.
func assertCloserGap(e @ast.Expr) @[]@token.Comment {
	return claimInlineGap(typeStartPos(e.TypeRef), pairedClose(openAfter(e.Pos)), e.Pos)
}

// cCallCloserGap returns the comments a `__c_call` with the record rec (nil when
// the file has none) and the items items prints before its `)`, from its last item's
// start (itemsCloserGap): block comments on one line, or all of them when that item is
// a `...` (afterDots) -- none when it has no position of its own (a `...` the record
// does not place stands at the keyword).
func cCallCloserGap(rec @ast.BuiltinOpener, items @[]@listItem, afterDots bool) @[]@token.Comment {
	if rec == nil || !posLess(rec.LParen, items[len(items) - 1].pos) {
		var none @[]@token.Comment
		return none
	}
	return itemsCloserGap(rec.LParen, items, !afterDots)
}
