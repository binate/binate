package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A close that follows what precedes it on its line -- a slice's `]`, a type
// assertion's `)`, the `)` of parentheses the source puts around an expression, and
// that of a builtin with a type operand, of `__c_call` or of `__c_global` -- prints
// the comments before it where they stand, as a list's close does
// (print_closegaps.bn), but only when each is a block comment on one line, as a line
// break before it would end the statement.  Otherwise it leaves them all for
// after the statement (claimInlineGap).  After the `:` of a slice with no high bound
// and after a `__c_call`'s `...` a line may break, so those print them all there, as
// a list does before its close (writeBreakableCloserGap).
// The close claims them once what precedes it has been rendered, for the lists in
// it to claim their own.  Where the printer drops the source's parentheses, the
// comments before their `)` are left to what follows the expression.

// sliceCloserGap returns the comments slice e prints before its `]`, keyed by its
// `[` (its Pos), from its last bound's start, or from the `[` when it has no bound
// (argsCloserGap): with a high bound, only block comments on one line; without one,
// all of them, after its `:`.
func sliceCloserGap(e @ast.Expr) @[]@token.Comment {
	if e.Y != nil { return argsCloserGap(e.Pos, e.Y, e.Pos, true) }
	if e.Z != nil { return argsCloserGap(e.Pos, e.Z, e.Pos, false) }
	return claimGap(e.Pos, pairedClose(e.Pos), e.Pos)
}

// assertCloserGap returns the comments type assertion e prints before its `)`,
// paired with the first opener after its `.` (its Pos), and keyed by the `.`: block
// comments on one line from its type's start (claimInlineGap).  The type has been
// rendered already, for the lists in it to claim their own comments.
func assertCloserGap(e @ast.Expr) @[]@token.Comment {
	return claimInlineGap(typeStartPos(e.TypeRef), pairedClose(openAfter(e.Pos)), e.Pos)
}

// cCallCloserGap returns the comments a `__c_call` or a `__c_global` with the record rec
// (nil when the file has none) and the items items prints before its `)`, from its last
// item's start (itemsCloserGap): block comments on one line, or all of them when that
// item is a `...` (afterDots) -- none when it has no position of its own (a `...` the
// record does not place stands at the keyword).
func cCallCloserGap(rec @ast.BuiltinOpener, items @[]@listItem, afterDots bool) @[]@token.Comment {
	if rec == nil || !posLess(rec.LParen, items[len(items) - 1].pos) {
		var none @[]@token.Comment
		return none
	}
	return itemsCloserGap(rec.LParen, items, !afterDots)
}

// parenCloserGap returns the comments that the `)` the printer writes around e takes
// from the source's: the parentheses the source puts around e (Parenthesized), keyed
// by their `(`, take the block comments on one line from e's start (argsCloserGap).
// The parser records no position for the pair: it is the innermost pair around the
// span from e's start to its Pos (openAround) -- e's operator, name or literal, or
// its own `(`, `[` or `{`, which no bracket inside e holds.  Of nested layers
// (`((a + b))`), one pair to the printer, that is the innermost, so a comment between
// two of their `)` goes after the printer's.  None for an expression the source does
// not parenthesize, and, without looking for the pair, when no comment follows e's
// start.
func parenCloserGap(e @ast.Expr) @[]@token.Comment {
	var none @[]@token.Comment
	if e == nil || !e.Parenthesized { return none }
	var cc @commentCursor = activeCursor
	var lo token.Pos = exprStartPos(e)
	if cc == nil || firstAfter(cc, lo) == len(cc.comments) { return none }
	var open token.Pos = openAround(lo, e.Pos)
	if open.Line == 0 { return none }
	return argsCloserGap(open, e, open, true)
}

// parenGapBefore returns the comments the `)` the printer writes around e takes
// (parenCloserGap) when they are claimed before e is printed: unless wrapping is
// suppressed, so that they count in e's layout, as a list's close does.  With
// wrapping suppressed they are claimed once e has been printed (writeParenClose).
func parenGapBefore(e @ast.Expr) @[]@token.Comment {
	if wrapSuppressed {
		var none @[]@token.Comment
		return none
	}
	return parenCloserGap(e)
}

// writeParenClose writes the `)` of the parentheses around e, which has been
// printed, after the comments before it: closing, from parenGapBefore, or with
// wrapping suppressed, those parenCloserGap claims now.
func writeParenClose(b @strings.Builder, e @ast.Expr, closing @[]@token.Comment) {
	if wrapSuppressed { closing = parenCloserGap(e) }
	_ = writeInlineComments(b, closing)
	b.WriteByte(')')
}

// printInParens appends e in the parentheses the printer writes around it, with the
// comments before the source's `)` before its own; tail is what follows the `)` on
// its line.
func printInParens(b @strings.Builder, e @ast.Expr, tail int) {
	b.WriteByte('(')
	var closing @[]@token.Comment = parenGapBefore(e)
	printExprTail(b, e, 1 + inlineCommentsWidth(closing) + tail)
	writeParenClose(b, e, closing)
}

// claimAfterParens is claimAfterExpr for e when what prints it writes parentheses
// around it (paren).  claimAfterExpr renders e alone, without them, so the comments
// before the source's `)` go to the parentheses first (parenCloserGap), once e has
// been rendered for the lists in it to claim their own; otherwise the gap after e
// would take them, to print after the `)`.
func claimAfterParens(e @ast.Expr, paren bool, hi token.Pos, key token.Pos) @[]@token.Comment {
	if paren && pendingWithin(exprStartPos(e), hi) {
		_ = renderAt(e, 0, 0, 0)
		_ = parenCloserGap(e)
	}
	return claimAfterExpr(e, hi, key)
}
