package "pkg/binate/format"

import "pkg/builtins/testing"

// A block comment on one line before a close that follows what precedes it on its
// line -- a slice's `]`, a type assertion's `)`, and that of a builtin with a type
// operand or of `__c_call` -- stays there, and the output is stable; one before a
// low bound's `:` goes after it.  The lists in the last operand keep their own, and a
// block comment inside a type goes before the close after it.
func TestCloserCommentsOfOtherClosesStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := s[i:n /* c */]\n"
			"\tb := s[i: /* c */]\n"
			"\tc := s[: /* c */]\n"
			"\td := s[i /* c */ :]\n"
			"\te := x.(T /* c */)\n"
			"\th := x.(*p.T /* c */)\n"
			"\tk := make_slice(int, n /* c */)\n"
			"\tm := cast(int, n /* c */)\n"
			"\tn2 := sizeof(T /* c */)\n"
			"\to := __c_call(\"f\", int, x /* c */)\n"
			"\tr := __c_call(\"f\", \"void\" /* c */)\n"
			"\tt := __c_call(\"f\", int, x, ... /* c */)\n"
			"\tu := cast(int, g(x /* c */))\n"
			"\tv := s[i:g(n /* c */)]\n"
			"\tw := x.(p.Box[int /* c */])\n"
			"\tz := x.(p. /* c */ T)\n"
			"\tz2 := cast(int, y.(p. /* c */ T))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := s[i:n /* c */]\n"
			"\tb := s[i: /* c */]\n"
			"\tc := s[: /* c */]\n"
			"\td := s[i: /* c */]\n"
			"\te := x.(T /* c */)\n"
			"\th := x.(*p.T /* c */)\n"
			"\tk := make_slice(int, n /* c */)\n"
			"\tm := cast(int, n /* c */)\n"
			"\tn2 := sizeof(T /* c */)\n"
			"\to := __c_call(\"f\", int, x /* c */)\n"
			"\tr := __c_call(\"f\", \"void\" /* c */)\n"
			"\tt := __c_call(\"f\", int, x, ... /* c */)\n"
			"\tu := cast(int, g(x /* c */))\n"
			"\tv := s[i:g(n /* c */)]\n"
			"\tw := x.(p.Box[int /* c */])\n"
			"\tz := x.(p.T /* c */)\n"
			"\tz2 := cast(int, y.(p.T /* c */))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line comment before such a close cannot stay there: a line break after what
// precedes the close would end the statement (or, after a `...`, the close would start
// a line).  It goes after the statement, as do the block comments beside it.
func TestCloserLineCommentsOfOtherClosesGoAfterTheStatement() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tb := x.(p. /* b */ // c\n"
			"\t\tT)\n"
			"\td := cast(int, y.(p. // c\n"
			"\t\tT))\n"
			"\te := __c_call(\"f\", int, x, ... // c\n"
			"\t)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tb := x.(p.T)\n"
			"\t/* b */\n"
			"\t// c\n"
			"\n"
			"\td := cast(int, y.(p.T))\n"
			"\t// c\n"
			"\n"
			"\te := __c_call(\"f\", int, x, ...)\n"
			"\t// c\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before such a close counts in the layout: one that would take the line
// past the limit wraps what comes before it, and stays before the close -- in a
// slice, its last bound, which moves to a continuation line after the `:` when it
// and the comment do not fit after it.  A slice's low bound leaves room for the `:`,
// and, with no high bound, for the comments after it and the `]`.
func TestCloserCommentsOfOtherClosesCount() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbb).(Ttttttttt"
			"ttttttttt /* ccccccc */)\n"
			"\t_ = cast(int, gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)"
			" /* cccccccc */)\n"
			"\t_ = __c_call(\"ffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbb "
			"/* cccccccc */)\n"
			"\tg(ssssssss[iiiiiiiiiiii:aaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + cccc "
			"/* dddddddddddddddd */])\n"
			"\tw := ssssssss[iiii:g0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy) /* cccccccccc"
			"cccccccccc */]\n"
			"\tw2 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy): /* cccccccccc"
			"cccccccccc */]\n"
			"\tw3 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyy):hhhhhhhhhhhhhh"
			"hhhhhhh]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(Tttttttttttttttttt /* ccccccc */)\n"
			"\t_ = cast(int, gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) /* cccccccc */)\n"
			"\t_ = __c_call(\"ffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbb /* cccccccc */)\n"
			"\tg(ssssssss[iiiiiiiiiiii:\n"
			"\t\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + cccc /* dddddddddddd"
			"dddd */])\n"
			"\tw := ssssssss[iiii:\n"
			"\t\t\tg0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy) /* ccccccccccccccccc"
			"ccc */]\n"
			"\tw2 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tyyyyyyyyyyyyyyyyyyyyyyyyyyyyy): /* cccccccccccccccccccc */]\n"
			"\tw3 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyy):\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhh]\n"
			"}\n"
	return checkFormatGolden(src, want)
}
