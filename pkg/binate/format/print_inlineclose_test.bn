package "pkg/binate/format"

import "pkg/builtins/testing"

// A block comment on one line before a close that follows what precedes it on its
// line -- a slice's `]`, a type assertion's `)`, and that of a builtin with a type
// operand or of `__c_call` -- stays there, and the output is stable; one before a
// low bound's `:` goes after it.  The lists and the types in the last operand keep
// their own.
func TestCloserCommentsOfOtherClosesStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := s[i:n /* c */]\n"
			"\tb := s[i: /* c */]\n"
			"\tc := s[: /* c */]\n"
			"\td := s[i /* c */ :]\n"
			"\te := x.(T /* c */)\n"
			"\th := x.(*p.T /* c */)\n"
			"\tk := make_slice(int, n /* c */)\n"
			"\tm := cast(int, n /* c */)\n"
			"\tn2 := sizeof(T /* c */)\n"
			"\to := __c_call(\"f\", int, x /* c */)\n"
			"\tr := __c_call(\"f\", \"void\" /* c */)\n"
			"\tt := __c_call(\"f\", int, x, ... /* c */)\n"
			"\tu := cast(int, g(x /* c */))\n"
			"\tv := s[i:g(n /* c */)]\n"
			"\tw := x.(p.Box[int /* c */])\n"
			"\tz := x.(p. /* c */ T)\n"
			"\tz2 := cast(int, y.(p. /* c */ T))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := s[i:n /* c */]\n"
			"\tb := s[i: /* c */]\n"
			"\tc := s[: /* c */]\n"
			"\td := s[i: /* c */]\n"
			"\te := x.(T /* c */)\n"
			"\th := x.(*p.T /* c */)\n"
			"\tk := make_slice(int, n /* c */)\n"
			"\tm := cast(int, n /* c */)\n"
			"\tn2 := sizeof(T /* c */)\n"
			"\to := __c_call(\"f\", int, x /* c */)\n"
			"\tr := __c_call(\"f\", \"void\" /* c */)\n"
			"\tt := __c_call(\"f\", int, x, ... /* c */)\n"
			"\tu := cast(int, g(x /* c */))\n"
			"\tv := s[i:g(n /* c */)]\n"
			"\tw := x.(p.Box[int /* c */])\n"
			"\tz := x.(p./* c */ T)\n"
			"\tz2 := cast(int, y.(p./* c */ T))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before such a close counts in the layout: one that would take the line
// past the limit wraps what comes before it, and stays before the close -- in a
// slice, its last bound, which moves to a continuation line after the `:` when it
// and the comment do not fit after it.  A slice's low bound leaves room for the `:`,
// and, with no high bound, for the comments after it and the `]`.
func TestCloserCommentsOfOtherClosesCount() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbb).(Ttttttttt"
			"ttttttttt /* ccccccc */)\n"
			"\t_ = cast(int, gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)"
			" /* cccccccc */)\n"
			"\t_ = __c_call(\"ffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbb "
			"/* cccccccc */)\n"
			"\tg(ssssssss[iiiiiiiiiiii:aaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + cccc "
			"/* dddddddddddddddd */])\n"
			"\tw := ssssssss[iiii:g0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy) /* cccccccccc"
			"cccccccccc */]\n"
			"\tw2 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy): /* cccccccccc"
			"cccccccccc */]\n"
			"\tw3 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyy):hhhhhhhhhhhhhh"
			"hhhhhhh]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\t_ = gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(Tttttttttttttttttt /* ccccccc */)\n"
			"\t_ = cast(int, gggggggggggggggggggg(aaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) /* cccccccc */)\n"
			"\t_ = __c_call(\"ffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbb /* cccccccc */)\n"
			"\tg(ssssssss[iiiiiiiiiiii:\n"
			"\t\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + cccc /* dddddddddddd"
			"dddd */])\n"
			"\tw := ssssssss[iiii:\n"
			"\t\t\tg0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyyyyyy) /* ccccccccccccccccc"
			"ccc */]\n"
			"\tw2 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tyyyyyyyyyyyyyyyyyyyyyyyyyyyyy): /* cccccccccccccccccccc */]\n"
			"\tw3 := ssssssss[g0(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyyyyyyy):\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhh]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// After a `__c_call`'s `...` a line may break, so the comments before its `)` stay
// there, a line comment too, with the `)` on the next line, as a list's close goes after
// a line comment (writeBreakableCloserGap); left for after the statement, they could
// print after comments a later list claimed.  The last item leaves room only for
// comments ending in a line comment, which stay on its line.
func TestCCallKeepsALineCommentAfterItsDots() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := __c_call(\"f\", int, x, ... // c\n"
			"\t)\n"
			"\tb := __c_call(\"f\", int, ... // c\n"
			"\t)\n"
			"\tc := __c_call(\"f\", int, x, ... /* b */ // c\n"
			"\t)\n"
			"\td := __c_call(\"f\", int, x, ...\n"
			"\t\t// c\n"
			"\t)\n"
			"\te := __c_call(\"f\", int, x, ... /* b */)\n"
			"\tg := __c_call(\"ffffffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbb"
			"bbbbbbbbbbbbbbbbbbb, ... // a trailing comment\n"
			"\t)\n"
			"\t_ = gggg(__c_call(\"f\", int, x, ... // c\n"
			"\t), z)\n"
			"\tk := __c_call(\"f\", int, aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbb, ... // ccccccc"
			"cccccccccccccccccc\n"
			"\t)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := __c_call(\"f\", int, x, ... // c\n"
			"\t)\n"
			"\tb := __c_call(\"f\", int, ... // c\n"
			"\t)\n"
			"\tc := __c_call(\"f\", int, x, ... /* b */ // c\n"
			"\t)\n"
			"\td := __c_call(\"f\", int, x, ...\n"
			"\t\t\t// c\n"
			"\t)\n"
			"\te := __c_call(\"f\", int, x, ... /* b */)\n"
			"\tg := __c_call(\"ffffffffffffffffffff\", int, aaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, ... // a trailing comment\n"
			"\t)\n"
			"\t_ = gggg(__c_call(\"f\", int, x, ... // c\n"
			"\t), z)\n"
			"\tk := __c_call(\"f\", int, aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t... // ccccccccccccccccccccccccc\n"
			"\t)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A block comment on one line before the `)` of parentheses the source puts around an
// expression stays there where the printer keeps them -- around a binary operand, a
// unary's operand, a postfix form's head (inside a condition too), a number literal
// before a `.` and an array literal after a `*` -- and the output is stable.  Of
// nested layers the printer keeps one pair, and a comment between two of their `)`
// goes after it.  Where the printer drops the parentheses, the comment goes where
// what follows the expression puts it.
func TestCloserCommentsOfKeptParensStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := (b + c /* c */) * d\n"
			"\te := g + (b + c /* c */)\n"
			"\th := -(b + c /* c */)\n"
			"\tk := g((b + c /* c */) * d, e)\n"
			"\tm := (b + (c + d /* c */)) * e\n"
			"\tn := ((b + c /* c */)) * d\n"
			"\to := ((b + c) /* c */) * d\n"
			"\tr := (b + c /* c */).x\n"
			"\tt := (-b /* c */)[0]\n"
			"\tu := (1 /* c */).String()\n"
			"\tv := (*[]int{1, 2} /* c */)[0]\n"
			"\tw := *([2]int{1, 2} /* c */)\n"
			"\tw2 := *([2]int{1, 2} /* c */)[0:1]\n"
			"\tw3 := *([2]int{1, 2} /* c */).(T)\n"
			"\tx := (b + c /* c */).(T)\n"
			"\ty := (b + c /* c */)[i:j]\n"
			"\tif (b + c /* c */) > d {\n"
			"\t}\n"
			"\tif (b + c /* c */).(T) == d {\n"
			"\t}\n"
			"\tswitch (b + c /* c */).(type) {\n"
			"\t}\n"
			"\tz := (b /* c */) * d\n"
			"\tz = g((b /* c */), c)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\ta := (b + c /* c */) * d\n"
			"\te := g + (b + c /* c */)\n"
			"\th := -(b + c /* c */)\n"
			"\tk := g((b + c /* c */) * d, e)\n"
			"\tm := (b + (c + d /* c */)) * e\n"
			"\tn := (b + c /* c */) * d\n"
			"\to := (b + c) /* c */ * d\n"
			"\tr := (b + c /* c */).x\n"
			"\tt := (-b /* c */)[0]\n"
			"\tu := (1 /* c */).String()\n"
			"\tv := (*[]int{1, 2} /* c */)[0]\n"
			"\tw := *([2]int{1, 2} /* c */)\n"
			"\tw2 := *([2]int{1, 2} /* c */)[0:1]\n"
			"\tw3 := *([2]int{1, 2} /* c */).(T)\n"
			"\tx := (b + c /* c */).(T)\n"
			"\ty := (b + c /* c */)[i:j]\n"
			"\tif (b + c /* c */) > d {}\n"
			"\tif (b + c /* c */).(T) == d {}\n"
			"\tswitch (b + c /* c */).(type) {\n"
			"\t}\n"
			"\tz := b /* c */ * d\n"
			"\tz = g(b, /* c */ c)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before such a `)` counts in the layout: the parenthesized operand wraps
// for it and the `)` to fit on its last line, whether or not the chain around it
// wraps, and the output is stable.
func TestCloserCommentsOfKeptParensCount() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* ccccccccccccc"
			"ccccc */) * d\n"
			"\tx = d * (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* ccccccccc"
			"ccccccccc */)\n"
			"\tx = -(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb + eeeeeeeeeeeee"
			"e /* cccccccccc */)\n"
			"\tg((aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* ccccccccccccccc"
			"cccccccc */) * d)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa +\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* cccccccccccccccccc */) * d\n"
			"\tx = d *\n"
			"\t\t\t(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa +\n"
			"\t\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* cccccccccccccccccc */)\n"
			"\tx = -(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb +\n"
			"\t\t\teeeeeeeeeeeeee /* cccccccccc */)\n"
			"\tg((aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa +\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* ccccccccccccccccccccccc */) * d)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// In a control clause's condition, where a composite literal of a type name keeps its
// parentheses, a block comment on one line before their `)` stays there too -- in an
// `if`, a `for`'s condition, post statement and range, a switch's tag and a type switch's
// head, in an operand of a chain, wrapped or not, and in the head of a selector, a type
// assertion, an index and a slice -- and the output is stable.
func TestCloserCommentsOfKeptParensInConditions() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif (T{1} /* c */) == d {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif d == (T{1} /* c */) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor (T{1} /* c */) == d {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := 0; (T{1} /* c */) == d; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor ; ; (T{1} /* c */).n++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor x in (T{1} /* c */) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif (T{1} /* c */).f == 1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif (T{1} /* c */).(I) != nil {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif (T{1} /* c */)[0] == 1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif (T{1} /* c */)[i:j] == nil {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch (T{1} /* c */).(type) {\n"
			"\t}\n"
			"\tswitch (T{1} /* c */) {\n"
			"\t}\n"
			"\tif (T{1} /* c */) ==\n"
			"\t\t\tdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa == b || (T{1} /* c */) == d ||\n"
			"\t\t\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}
