package "pkg/binate/format"

import "pkg/builtins/testing"

// An interface's methods take the comments inside it, as a struct's fields do: an own-line comment
// goes above the method it precedes, a comment after a method on its line after it (one between
// two of its parameters in their list), and the comments left before the `}` on lines of their own;
// a blank line between two methods is kept, as one; and a comment after the `{` goes on a line of
// its own, as a struct's does.
func TestInterfaceMethodsTakeTheirComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc for I\n"
			"interface I { // after the brace\n"
			"\t// doc for M\n"
			"\tM(a int) int\n"
			"\tN(a int, /* x */ b int) // n\n"
			"\n"
			"\n"
			"\t// after blanks\n"
			"\tO() (int, bool) /* o */ // o2\n"
			"\t// dangling before the close\n"
			"} // after I\n"
			"\n"
			"interface E {\n"
			"\t// nothing yet\n"
			"}\n"
			"\n"
			"interface L { M() /* m */; N() /* n */ }\n"
			"\n"
			"interface O { M() } // after O\n"
			"\n"
			"interface K { M()\n"
			"\n"
			"\tN() }\n"
			"\n"
			"interface X : I, K {\n"
			"\t// a section\n"
			"\n"
			"\tP() // p\n"
			"}\n"
			"\n"
			"interface C[T any] {\n"
			"\tGet() T // g\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc for I\n"
			"interface I {\n"
			"\t// after the brace\n"
			"\t// doc for M\n"
			"\tM(a int) int\n"
			"\tN(a int, /* x */ b int) // n\n"
			"\n"
			"\t// after blanks\n"
			"\tO() (int, bool) /* o */ // o2\n"
			"\t// dangling before the close\n"
			"} // after I\n"
			"\n"
			"interface E {\n"
			"\t// nothing yet\n"
			"}\n"
			"\n"
			"interface L {\n"
			"\tM() /* m */\n"
			"\tN() /* n */\n"
			"}\n"
			"\n"
			"interface O {\n"
			"\tM()\n"
			"} // after O\n"
			"\n"
			"interface K {\n"
			"\tM()\n"
			"\n"
			"\tN()\n"
			"}\n"
			"\n"
			"interface X : I, K {\n"
			"\t// a section\n"
			"\n"
			"\tP() // p\n"
			"}\n"
			"\n"
			"interface C[T any] {\n"
			"\tGet() T // g\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An interface in a `.bni` file takes its comments the same way.
func TestInterfaceFileMethodsTakeTheirComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc for I\n"
			"interface I {\n"
			"\t// doc for M\n"
			"\tM(a int) int // m\n"
			"\n"
			"\tN() // n\n"
			"\t// dangling before the close\n"
			"}\n"
			"\n"
			"func f(a int) int // f\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"// doc for I\n"
			"interface I {\n"
			"\t// doc for M\n"
			"\tM(a int) int // m\n"
			"\n"
			"\tN() // n\n"
			"\t// dangling before the close\n"
			"}\n"
			"\n"
			"func f(a int) int // f\n"
	return checkFormatGoldenIface(src, want)
}

// An interface method's signature wraps for the comments after it -- its parameters for its
// results and them, and its results for them -- but not for a comment too wide to fit even after a
// byte on a continuation line, nor for one bearing the `// LONG-LINE ALLOWED` marker.
func TestInterfaceMethodWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffffff(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int, ccccccccccccc int) (int, bool) /"
			"/ a trailing c\n"
			"\tGggggggggggggggg(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int) int // xxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n"
			"\tHhhhhhhhhhhhhhhh(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int, ccccccccccccc int) (int, bool) /"
			"/ LONG-LINE ALLOWED x\n"
			"\tJjjjjjjjjjjjjjjj(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int, ccccccccccccc int, ddddddddd int"
			") // a trailing c\n"
			"\tKkkkkkkk() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccc"
			"c) // a trailing comment\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffffff(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccc int) (int, bool) // a trailing c\n"
			"\tGggggggggggggggg(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int) int // xxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n"
			"\tHhhhhhhhhhhhhhhh(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int, ccccccccccccc int) (int, bool) /"
			"/ LONG-LINE ALLOWED x\n"
			"\tJjjjjjjjjjjjjjjj(aaaaaaaaaaaa int, bbbbbbbbbbbbbbb int, ccccccccccccc int,\n"
			"\t\t\tddddddddd int) // a trailing c\n"
			"\tKkkkkkkk() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tccccccccccc) // a trailing comment\n"
			"}\n"
	return checkFormatGolden(src, want)
}
