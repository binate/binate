package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A fill decision -- does the next element stay on the current line, or start a
// continuation line? -- measures an expression element as it would print at each
// place (exprFitsAt, itemFitsAt): rendered from the current column, and from the
// continuation lines' column, each with its line's indent and what follows the
// element (a comma, a close, and a line comment after it, which stays on its
// line).  It stays when it is one line from the current column and fits there,
// with what follows it; it moves when it is one line on a continuation line and
// fits there.  Otherwise it spans lines wherever it is printed (a function
// literal, a list or string the source wrapped, or one too wide for either line),
// and it stays when the first line of its rendering from the current column fits
// and is no shorter than the first line it has on a continuation line -- placed
// here, it is not broken earlier than it would be there (a function literal keeps
// its whole header, a string is not split shorter) -- and its later lines pass the
// cap no more than they would there (placed here, a composite's elements sit
// deeper).  But a string that spans lines and is not the list's last element
// never stays on the list's first line: its parts would continue at the list's own
// continuation indent, where the elements after it go.  And the element after one
// whose last line is deeper than the continuation indent starts a fresh
// continuation line rather than trailing that deep line.
//
// Measuring each rendering where it would print matters: a run of adjacent
// strings is written split where that fits and merged where it does not, so its
// width depends on its column.  A reformat finds the element as this formatting
// printed it and measures it the same way.  A type, parameter or text item is
// measured by its text on its own (types rarely wrap): whole when it is one line,
// else by its first line.

// lineShare returns the width an element rendered as text takes on the line it
// starts on: all of a one-line text and the tail after it (a comma, a close), or
// only the first line of one that spans lines -- what follows it is on its last.
func lineShare(text *[]readonly char, tail int) int {
	if hasNewline(text) { return firstLineLen(text) }
	return len(text) + tail
}

// exprFitsAt reports whether element e stays on the current line, at column here
// of a line indented indent tabs.  tail is what follows it on its last line (a
// comma, a close), last whether it is the list's last element, next the list's
// next element (nil for none, or when the list prints no comments) and key the
// list's key, for a line comment after e, which stays on its line and so adds to
// the tail (elemTrailTail); cont is the continuation lines' column (and indent).
func exprFitsAt(e @ast.Expr, tail int, last bool, next @ast.Expr, key token.Pos, here int,
		indent int, cont int) bool {
	var full int = elemTrailTail(e, tail, next, key, here, indent, cont)
	var shallow bool = !last && indent < cont && exprLeftmost(e).Kind == ast.EXPR_STRING_LIT
	return fitsPlacedOrMoved(renderAt(e, here, indent, full), renderAt(e, cont, cont, full), full,
			here, cont, shallow)
}

// elemTrailTail returns tail and the width of a line comment after list element e
// (before next, in the list keyed key and continued at cont; none when next is
// nil), which stays on e's last line: what follows e there, for e to be printed and
// measured with (withTrail).  The gap after e is claimed only once e is rendered
// (from column here of a line indented indent tabs), so a list inside e has
// claimed its own comments (print_listcomments.bn).
func elemTrailTail(e @ast.Expr, tail int, next @ast.Expr, key token.Pos, here int, indent int,
		cont int) int {
	if next == nil { return tail }
	_ = renderAt(e, here, indent, tail)
	return withTrail(tail, trailWidth(exprStartPos(e), exprStartPos(next), key), cont)
}

// withTrail returns tail with the width w of a line comment after an element of a
// list continued at column cont, when the comment can share the element's last
// line: when it fits there after one byte on a continuation line.  A comment
// wider leaves the line past the cap however the element is laid out, so the
// element is not wrapped or split for it.
func withTrail(tail int, w int, cont int) int {
	if cont + 1 + tail + w > MAX_LINE_WIDTH { return tail }
	return tail + w
}

// fitsPlacedOrMoved decides a fill (see above) from an element's rendering from
// the current column here (placed) and from the continuation column cont (moved),
// each with tail after it; shallow marks a string, not the list's last element, on
// a line whose continuation is the list's.
func fitsPlacedOrMoved(placed *[]readonly char, moved *[]readonly char, tail int, here int,
		cont int, shallow bool) bool {
	if !hasNewline(placed) && here + len(placed) + tail <= MAX_LINE_WIDTH { return true }
	if !hasNewline(moved) && cont + len(moved) + tail <= MAX_LINE_WIDTH { return false }
	if shallow { return false }
	var first int = firstLineLen(placed)
	if here + first > MAX_LINE_WIDTH || first < firstLineLen(moved) { return false }
	var rest int = laterLinesWidth(placed)
	return rest <= MAX_LINE_WIDTH || rest <= laterLinesWidth(moved)
}

// laterLinesWidth returns the width of the longest line of s after its first (s
// is a rendering whose later lines carry their own indent), 0 for one line.
func laterLinesWidth(s *[]readonly char) int {
	var w int = 0
	var start int = -1
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == '\n' {
			if start >= 0 && i - start > w { w = i - start }
			start = i + 1
		}
	}
	return w
}

// itemFitsAt is exprFitsAt for list item it, with extra the width of a line
// comment after it (the item's text, rendered when the list was built, has claimed
// its own lists' comments): an expression item is measured with it in its tail
// (withTrail).
func itemFitsAt(it @listItem, tail int, last bool, extra int, here int, indent int, cont int) bool {
	if it.x == nil {
		var w int = lineShare(it.text, tail)
		if !hasNewline(it.text) { w = w + extra }
		return here + w <= MAX_LINE_WIDTH
	}
	var full int = withTrail(tail, extra, cont)
	var shallow bool = !last && indent < cont && exprLeftmost(it.x).Kind == ast.EXPR_STRING_LIT
	return fitsPlacedOrMoved(itemRenderAt(it, here, indent, full), itemRenderAt(it, cont, cont, full),
			full, here, cont, shallow)
}

// itemRenderAt returns expression item it rendered from column col of a line
// indented indent tabs, with tail after it, from the rendering cache (renderAt),
// after its key's when it has one -- so a nest of keyed composites is rendered once
// per level and place, not afresh at each.
func itemRenderAt(it @listItem, col int, indent int, tail int) @[]readonly char {
	if it.key == nil { return renderAt(it.x, col, indent, tail) }
	var kt @[]readonly char = renderAt(it.key, col, indent, 0)
	if hasNewline(kt) { return it.text }
	var kb @strings.Builder = strings.NewBuilder()
	kb.Write(kt)
	kb.Write(": ")
	kb.Write(renderAt(it.x, col + len(kt) + 2, indent, tail))
	return kb.String()
}
