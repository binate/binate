package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for the fill decisions' measure of an element (print_lineshare.bn): the
// part of it that would share the current line.

// A later argument that spans lines is measured by its first line, the part on the
// current line: a call whose argument ends in a function literal stays after the
// enclosing call's `(` (measured whole, its long body put the `(` alone above it).
func TestFillMultiLineArgByFirstLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := g(s.Map(func(x int) int {\n"
			"\t\treturn x + "
			"a_rather_long_name_to_make_the_whole_body_text_exceed_the_line_width_ca"
			"p\n"
			"\t}))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := g(s.Map(func(x int) int {\n"
			"\t\treturn x + "
			"a_rather_long_name_to_make_the_whole_body_text_exceed_the_line_width_ca"
			"p\n"
			"\t}))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A string the author split across lines packs onto the call's line when its first
// part fits there, after the other arguments.
func TestFillCrossLineStringArgByFirstLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\taddCheckError(c, pos,\n"
			"\t\t\"the first part of a message the author split across lines, \"\n"
			"\t\t\t\"and its second part\")\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\taddCheckError(c, pos, \"the first part of a message the author split "
			"across lines, \"\n"
			"\t\t\t\"and its second part\")\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A statement's expression list measures its last element the same way: a call that
// wraps stays after `return`'s other values.
func TestFillStmtListByFirstLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\treturn l, cur,\n"
			"\t\texprFail(\n"
			"\t\t\t\"a long enough message that it needs to wrap where it sits after "
			"return\")\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\treturn l, cur, exprFail(\n"
			"\t\t\t\"a long enough message that it needs to wrap where it sits after "
			"return\")\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A composite's element that spans lines is measured by its first line: `T{` stays
// after the other elements.
func TestFillMultiLineItemByFirstLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = S{first_element_name, second_element_name, T{\n"
			"\tinner_one, inner_two, inner_three, inner_four, inner_five, "
			"inner_six}}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = S{first_element_name, second_element_name, T{\n"
			"\t\tinner_one, inner_two, inner_three, inner_four, inner_five, "
			"inner_six}}\n"
	return checkFormatGolden(src, want)
}

// An argument too wide for a continuation line wraps wherever it is printed, so it
// stays after the previous argument when the first line of its wrapped form fits
// there -- as a reformat, which sees it span lines, measures it.
func TestFillWrapsInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(a, g(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, "
			"ccccccccccccccccccccccccccccccccccccccccccccc))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(a, g(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tccccccccccccccccccccccccccccccccccccccccccccc))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A string too long for any line moves to a continuation line, where it is split
// later than it would be where it stands, and the next argument starts a fresh
// continuation line -- decided by how the string was printed, so the same as when
// a reformat finds it split in the source.
func TestFillAfterPrintedSplitString() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(a, "
			"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", z)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(a,\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n"
			"\t\t\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaa\",\n"
			"\t\t\tz)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// The element after one whose last line is deeper than the list's continuation
// lines starts a fresh continuation line rather than trailing that line: `z` after
// the call `k(...)`, whose arguments wrapped two levels past it.
func TestFillAfterDeepLastLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(\n"
			"\t\t\th(\n"
			"\t\t\t\t\tk(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", m(v)), z))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(\n"
			"\t\t\th(\n"
			"\t\t\t\t\tk(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n"
			"\t\t\t\t\t\t\tm(v)),\n"
			"\t\t\t\t\tz))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A run of adjacent strings on one line counts what follows it on its line (here
// `).z`): a split form that fits alone but not with that is merged, or split across
// lines where even merged it does not fit, as a single literal is -- so a reformat,
// which finds the run merged, lays it out the same way.
func TestStringRunCountsTail() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := f(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" "
			"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\").z\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := f(a,\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaa\").z\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A list element is printed and measured with the line comment after it, which stays on
// its line: a run of strings whose split form fits there only without the comment is
// merged, in a composite literal and in a call.
func TestElemTailCountsLineComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar v = T{\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaa\", // K3\n"
			"\t\t\tb}\n"
			"\tf(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaa\", // K4\n"
			"\t\t\tb)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar v = T{\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaa\", // K3\n"
			"\t\t\tb}\n"
			"\tf(a,\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaa\", // K4\n"
			"\t\t\tb)\n"
			"}\n"
	return checkFormatGolden(src, want)
}
