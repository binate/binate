package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests of the lines a wrappable list's layout is decided from: the opener is the
// delimiter itself, and an element starts at its first token (exprStartPos,
// typeStartPos), not at the operator or bracket its Pos records, when the head or
// the element spans lines.

// A call after a function literal's `}` and an index after a call that wraps keep
// their arguments on the opener's line, as does a call whose selector head is
// split after its `.`.
func TestListOpenerIsDelimiter() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tfunc(v int) {\n"
					"\t\tg(v)\n"
					"\t}(x)\n"
					"\tr := g(\n"
					"\t\t\ta)[i]\n"
					"\tx.\n"
					"\t\tf(a)\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tfunc(v int) {\n"
					"\t\tg(v)\n"
					"\t}(x)\n"
					"\tr := g(\n"
					"\t\t\ta)[i]\n"
					"\tx.f(a)\n"
					"}\n")
}

// A source list whose `(` is alone on its line after a function literal's `}`
// stays that way.
func TestListOpenerAloneAfterLiteral() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tfunc(v int) {\n"
			"\t\tg(v)\n"
			"\t}(\n"
			"\t\t\tx)\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A function literal called directly as the first argument of a call, a builtin
// or an index starts at `func`, on the opener's line.
func TestListFirstElemCalledLiteral() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\th(func() int {\n"
			"\t\treturn 1\n"
			"\t}(), y)\n"
			"\t_ = len(func() @[]int {\n"
			"\t\treturn s\n"
			"\t}())\n"
			"\t_ = m[func() int {\n"
			"\t\treturn 1\n"
			"\t}()]\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A first element whose call head is split after a `.` starts on the opener's
// line: in a call's arguments, a composite's elements and keys, and a case label.
func TestListFirstElemHeadSpansLines() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tg(x.\n"
					"\t\ty(a))\n"
					"\tu := T{a.\n"
					"\t\tb(), c}\n"
					"\tw := [3]int{a.\n"
					"\t\tb(): 1}\n"
					"\tswitch k {\n"
					"\tcase a.\n"
					"\t\tb(), c:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tg(x.y(a))\n"
					"\tu := T{a.b(), c}\n"
					"\tw := [3]int{a.b(): 1}\n"
					"\tswitch k {\n"
					"\tcase a.b(), c:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"}\n")
}

// A called function literal whose whole text is past the width cap still shares
// the opener's line: only its first line, up to `{`, is measured.
func TestListFirstElemLongCalledLiteral() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\th(func() int {\n"
			"\t\tvar a int = computeSomething(1, 2, 3)\n"
			"\t\tvar b int = computeSomething(4, 5, 6)\n"
			"\t\treturn a + b\n"
			"\t}(), y)\n"
			"\tg(func() @[]int {\n"
			"\t\tvar a int = computeSomething(1, 2, 3)\n"
			"\t\tvar b int = computeSomething(4, 5, 6)\n"
			"\t\treturn s\n"
			"\t}()[0], y)\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A first element that is a composite literal whose type spans lines starts at
// the type, not at its `{`.
func TestListFirstElemCompositeTypeSpansLines() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tg(pkg.\n"
					"\t\tT{1}, c)\n"
					"\tu := T{pkg.\n"
					"\t\tU{1}, c}\n"
					"\tg(Pair[int,\n"
					"\t\tint]{1, 2}, c)\n"
					"\tswitch k {\n"
					"\tcase pkg.\n"
					"\t\tT{1}, c:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tg(pkg.T{1}, c)\n"
					"\tu := T{pkg.U{1}, c}\n"
					"\tg(Pair[int, int]{1, 2}, c)\n"
					"\tswitch k {\n"
					"\tcase pkg.T{1}, c:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"}\n")
}

// In type position, an instantiation's `[` is its opener, and a type in a list
// starts at its first token: in type arguments, function-value parameters,
// results, a type case's label and a grouped member, which gains no blank line.
func TestListTypeStartsAtFirstToken() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"var c pkg.\n"
					"\tVec[int]\n"
					"\n"
					"var a Pair[pkg.\n"
					"\tVec[int], int]\n"
					"\n"
					"var fv *func(pkg.\n"
					"\tVec[int], int)\n"
					"\n"
					"var (\n"
					"\tx int\n"
					"\tm pkg.\n"
					"\t\tVec[int]\n"
					")\n"
					"\n"
					"func r() (pkg.\n"
					"\tVec[int], error) {\n"
					"\tswitch v := x.(type) {\n"
					"\tcase pkg.\n"
					"\t\tVec[int], int:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"\treturn nil, nil\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"var c pkg.Vec[int]\n"
					"\n"
					"var a Pair[pkg.Vec[int], int]\n"
					"\n"
					"var fv *func(pkg.Vec[int], int)\n"
					"\n"
					"var (\n"
					"\tx int\n"
					"\tm pkg.Vec[int]\n"
					")\n"
					"\n"
					"func r() (pkg.Vec[int], error) {\n"
					"\tswitch v := x.(type) {\n"
					"\tcase pkg.Vec[int], int:\n"
					"\t\tg()\n"
					"\t\th()\n"
					"\t}\n"
					"\treturn nil, nil\n"
					"}\n")
}
