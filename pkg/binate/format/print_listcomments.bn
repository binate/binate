package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// A delimited list -- a call's or index's arguments, a composite's elements, a
// parameter or type list, a case's labels, a `__c_call`'s operands -- prints the
// comments that lie in it: after its opener (when the opener's position is known)
// and between two of its elements (`h(x, // c` / `y)`).  A line comment on the
// line of what precedes it continues that line, an own-line one gets a line of its
// own, and the element after either starts a fresh line.  A block comment flows
// like an element: it continues the line when it fits there (wherever the source
// put it), else it starts a fresh line, and what follows it continues its line.  A
// block comment right after a delimiter is written against it (`h(/* c */ x)`).
//
// A list is rendered several times -- the trials that measure it, then its final
// layout -- so its comments are not taken from the cursor in turn.  A gap's
// comments are found by position (claimGap) and marked done there, with the list
// as their owner: the cursor's emitters skip them, and every rendering of the list
// prints them again (so a trial measures them, and a line comment makes the list
// wrap).  A gap is claimed only after the element before it has been rendered, in
// the same rendering: so a list inside that element has claimed its own comments,
// and a function literal there has taken its body's (literalBodyCursor), and the
// enclosing list leaves both alone.  A list is keyed by its first element's
// position -- a real token's, after the list's opener, so no enclosing list shares
// it (listKey).

// claimGap returns the comments strictly between lo and hi that the list keyed
// key prints -- those nothing has printed, and those it claimed in an earlier
// rendering -- and claims them.  None when there is no active cursor, when lo,
// hi or key is the zero Pos, or when lo is not before hi.
func claimGap(lo token.Pos, hi token.Pos, key token.Pos) @[]@token.Comment {
	var out @vec.Vec[@token.Comment] = vec.New[@token.Comment]()
	var cc @commentCursor = activeCursor
	if cc == nil || lo.Line == 0 || hi.Line == 0 || key.Line == 0 || !posLess(lo, hi) {
		return out.Items()
	}
	for k := firstAfter(cc, lo); k < len(cc.comments) && posLess(cc.comments[k].Pos, hi); k++ {
		var owned bool = len(cc.owner) > 0 && samePos(cc.owner[k], key)
		if owned || (k >= cc.idx && !isDone(cc, k)) {
			claimComment(cc, k, key)
			out.Push(cc.comments[k])
		}
	}
	return out.Items()
}

// firstAfter returns the index of cc's first comment positioned after pos (the
// comments are in source order).
func firstAfter(cc @commentCursor, pos token.Pos) int {
	var lo int = 0
	var hi int = len(cc.comments)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(pos, cc.comments[mid].Pos) {
			hi = mid
		} else {
			lo = mid + 1
		}
	}
	return lo
}

// claimComment marks comment k of cc done, owned by the list keyed key.
func claimComment(cc @commentCursor, k int, key token.Pos) {
	if len(cc.done) == 0 { cc.done = make_slice(bool, len(cc.comments)) }
	if len(cc.owner) == 0 { cc.owner = make_slice(token.Pos, len(cc.comments)) }
	cc.done[k] = true
	cc.owner[k] = key
}

// listKey returns the key of the item list items: the position of its first item
// with a node.  A text item (a `__c_call`'s quoted symbol or `"void"`) carries
// another token's position -- the `__c_call` keyword's, which an enclosing list
// whose element the `__c_call` is starts at -- so it is no key.  The zero Pos when
// every item is text; such a list has no gaps.
func listKey(items @[]@listItem) token.Pos {
	for i := 0; i < len(items); i++ {
		var it @listItem = items[i]
		if it.x != nil || it.te != nil || it.param != nil { return it.pos }
	}
	var none token.Pos
	return none
}

// writeGapComments writes a list gap's comments cs at b's position, each after a
// space or at the start of a line at cont: a line comment on the line of what
// precedes it continues that line, an own-line one starts a line, and a block
// comment continues the line when it fits there (or whenever wrapping is
// suppressed: a `// LONG-LINE ALLOWED` line).  When glue (right after a
// delimiter), a first block comment that continues the line goes against what
// precedes it.  Returns whether what follows must start a fresh line: after a line
// comment, or a block comment spanning lines.
func writeGapComments(b @strings.Builder, cs @[]@token.Comment, cont int, glue bool) bool {
	var brk bool = false
	for i := 0; i < len(cs); i++ {
		var c @token.Comment = cs[i]
		var block bool = isBlockComment(c)
		var fresh bool = brk || (!block && c.OwnLine) ||
				(block && !wrapSuppressed && lineWidth(b) + 1 + firstLineLen(c.Text) > MAX_LINE_WIDTH)
		if fresh {
			b.WriteByte('\n')
			writeIndent(b, cont)
		} else if !(glue && i == 0 && block) {
			b.WriteByte(' ')
		}
		b.Write(c.Text)
		brk = !block || hasNewline(c.Text)
	}
	return brk
}

// gapCommentsWidth returns the width that a list gap's comments cs add on one
// line (` <text>` each, or `<text> ` after a delimiter), or -1 when one needs a
// line break after it.
func gapCommentsWidth(cs @[]@token.Comment) int {
	var w int = 0
	for i := 0; i < len(cs); i++ {
		var c @token.Comment = cs[i]
		if !isBlockComment(c) || hasNewline(c.Text) { return -1 }
		w = w + 1 + len(c.Text)
	}
	return w
}

// openerGapWidth returns the width the comments after a list's opener (at opener;
// its first element starts at start, and the list is keyed key) take before the
// first element on the opener's line, for deciding whether that element fits
// there; MAX_LINE_WIDTH + 1 when one needs a line break after it.
func openerGapWidth(opener token.Pos, start token.Pos, key token.Pos) int {
	var w int = gapCommentsWidth(claimGap(opener, start, key))
	if w < 0 { return MAX_LINE_WIDTH + 1 }
	return w
}

// trailWidth returns the width on an element's line that the comment after it,
// in the gap from lo (the element's start) to hi (the next one's), of the list
// keyed key, takes there when it is a line comment, which stays on that line --
// for deciding whether the element fits there; 0 otherwise (a block comment
// moves to the next line when it does not fit).  The caller has rendered the
// element first, so that a list inside it has claimed its own comments.
func trailWidth(lo token.Pos, hi token.Pos, key token.Pos) int {
	var cs @[]@token.Comment = claimGap(lo, hi, key)
	if len(cs) == 0 || cs[0].OwnLine || isBlockComment(cs[0]) { return 0 }
	return 1 + len(cs[0].Text)
}

// itemTrailWidth is trailWidth for items[i] of the item list keyed key: 0 for the
// last item, and for one whose text spans lines (the comment is on its last).
func itemTrailWidth(items @[]@listItem, i int, key token.Pos) int {
	if i + 1 >= len(items) || hasNewline(items[i].text) { return 0 }
	return trailWidth(items[i].pos, items[i + 1].pos, key)
}

// writeGapSeparator writes the comments of the gap before an element (against
// what precedes them when glue) and what separates them from the element: a line
// break to cont when they need one, else a space when there were any (or always,
// when spaced: after a comma or `case`).
func writeGapSeparator(b @strings.Builder, cs @[]@token.Comment, cont int, glue bool, spaced bool) {
	if writeGapComments(b, cs, cont, glue) {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else if spaced || len(cs) > 0 {
		b.WriteByte(' ')
	}
}

// argsOneLine returns an argument list's one-line form: its elements joined by
// `, `, each rendered from its column in that form (renderAt -- a run of adjacent
// string literals is written merged where split it would pass the cap, so an
// element's width can depend on its column), with the comments after its opener
// (at opener) and between them.  It spans lines when an element does, or a
// comment needs a line break after it.  Where it fits on its line, it is what
// printArgsOneLine writes there: no element in it wraps where the whole fits.
func argsOneLine(elems @[]@ast.Expr, opener token.Pos) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	var key token.Pos = exprStartPos(elems[0])
	var lo token.Pos = opener
	for i := 0; i < len(elems); i++ {
		if i > 0 { sb.WriteByte(',') }
		var start token.Pos = exprStartPos(elems[i])
		writeGapSeparator(sb, claimGap(lo, start, key), 2, i == 0, i > 0)
		sb.Write(renderAt(elems[i], lineWidth(sb)))
		lo = start
	}
	return sb.String()
}

// printArgsOneLine writes an argument list's elements joined by `, ` with the
// comments after its opener (at opener) and between them; one that needs a line
// break continues the list on a line at the current indent plus two.
func printArgsOneLine(b @strings.Builder, elems @[]@ast.Expr, opener token.Pos) {
	var key token.Pos = exprStartPos(elems[0])
	var cont int = currentLineIndent(b) + 2
	var lo token.Pos = opener
	for i := 0; i < len(elems); i++ {
		if i > 0 { b.WriteByte(',') }
		var start token.Pos = exprStartPos(elems[i])
		writeGapSeparator(b, claimGap(lo, start, key), cont, i == 0, i > 0)
		printExpr(b, elems[i])
		lo = start
	}
}
