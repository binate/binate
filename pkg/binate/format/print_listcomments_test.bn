package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the comments inside a list -- after its opener and between its
// elements (print_listcomments.bn).

// checkListComments formats src (parsed with comments) and asserts the output is
// want exactly, keeps the code tokens and the comments, and is a fixpoint.
func checkListComments(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var fin @ast.File = parseCollected(src)
	var out @[]readonly char = Format(fin)
	if !streq(out, want) { return goldenDiff(out, want) }
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	var fout @ast.File = parseCollected(out)
	if !commentsMultisetEqual(fin.Comments, fout.Comments) {
		return commentDiff(fin.Comments, fout.Comments, out)
	}
	var again @[]readonly char = Format(fout)
	if !streq(again, out) { return goldenDiff(again, out) }
	return ""
}

// A comment after an argument stays after its comma, and the next argument starts a
// continuation line -- in a call statement, on a right-hand side, and in a left operand.
func TestListCommentAfterArgument() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x, // e\n"
			"\t\ty)\n"
			"\tz := h(x, // d\n"
			"\t\ty)\n"
			"\ta.b(x, // c\n"
			"\t\ty).c = 1\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x, // e\n"
			"\t\t\ty)\n"
			"\tz := h(x, // d\n"
			"\t\t\ty)\n"
			"\ta.b(x, // c\n"
			"\t\t\ty).c = 1\n"
			"}\n"
	return checkListComments(src, want)
}

// A block comment between two arguments stays inline, and the list on one line.
func TestListCommentBlockInline() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x, /* e */ y)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x, /* e */ y)\n"
			"}\n"
	return checkListComments(src, want)
}

// A block comment counts in the width of the one-line form: one that pushes it past
// the cap makes the list wrap.
func TestListCommentBlockMeasured() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, "
			"/* a comment long enough to push the line over */ y)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\t/* a comment long enough to push the line over */ y)\n"
			"}\n"
	return checkListComments(src, want)
}

// A comment after the opener stays there, and the first argument starts a continuation
// line.
func TestListCommentAfterOpener() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th( // c\n"
			"\t\tx, y)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th( // c\n"
			"\t\t\tx, y)\n"
			"}\n"
	return checkListComments(src, want)
}

// An own-line comment before an argument keeps a line of its own.
func TestListCommentOwnLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x,\n"
			"\t\t// before y\n"
			"\t\ty)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x,\n"
			"\t\t\t// before y\n"
			"\t\t\ty)\n"
			"}\n"
	return checkListComments(src, want)
}

// An own-line block comment flows like an element: it joins the line where it fits.
func TestListCommentOwnLineBlock() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x,\n"
			"\t\t/* c */\n"
			"\t\ty)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(x, /* c */ y)\n"
			"}\n"
	return checkListComments(src, want)
}

// A comment between a nested call's arguments is that call's, one between the outer
// call's is the outer call's: each prints once, where it lies.
func TestListCommentNested() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(g(a, // inner\n"
			"\t\tb), y)\n"
			"\th(g(a, b), // outer\n"
			"\t\ty)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(g(a, // inner\n"
			"\t\t\tb), y)\n"
			"\th(g(a, b), // outer\n"
			"\t\t\ty)\n"
			"}\n"
	return checkListComments(src, want)
}

// A comment after a function-literal argument is the list's, and one in the literal's
// body stays in the body.
func TestListCommentAfterFuncLit() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(func() {\n"
			"\t\t// body\n"
			"\t\ts()\n"
			"\t}, // after\n"
			"\t\ty)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(func() {\n"
			"\t\t// body\n"
			"\t\ts()\n"
			"\t}, // after\n"
			"\t\t\ty)\n"
			"}\n"
	return checkListComments(src, want)
}

// A comment between parameters stays there: a function literal's, and a
// declaration's.
func TestListCommentParams() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar g = func(a int, // c\n"
			"\t\tb int) {}\n"
			"}\n"
			"\n"
			"func k(a int, // d\n"
			"\tb int) {\n"
			"\ts()\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar g = func(a int, // c\n"
			"\t\t\tb int) {}\n"
			"}\n"
			"\n"
			"func k(a int, // d\n"
			"\t\tb int) {\n"
			"\ts()\n"
			"}\n"
	return checkListComments(src, want)
}

// A comment between the elements of a composite, a case's labels, a `__c_call`'s
// operands and a generic's type arguments stays there.
func TestListCommentItemLists() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar t = T{a, // c\n"
			"\t\tb}\n"
			"\tswitch v {\n"
			"\tcase a, // d\n"
			"\t\tb:\n"
			"\t\ts()\n"
			"\t}\n"
			"\t_ = __c_call(\"f\", int, a, // e\n"
			"\t\tb)\n"
			"\tm[int, // g\n"
			"\t\tstring](x)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar t = T{a, // c\n"
			"\t\t\tb}\n"
			"\tswitch v {\n"
			"\tcase a, // d\n"
			"\t\t\tb:\n"
			"\t\ts()\n"
			"\t}\n"
			"\t_ = __c_call(\"f\", int, a, // e\n"
			"\t\t\tb)\n"
			"\tm[int, // g\n"
			"\t\t\tstring](x)\n"
			"}\n"
	return checkListComments(src, want)
}

// A `__c_call` that is an enclosing list's first element keeps its comments to itself:
// its quoted symbol, at the `__c_call` keyword's position, is no list key, so the
// enclosing list does not print them again.
func TestListCommentCCallFirstElement() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(__c_call(\"w\", int, a, /* c */ b), x)\n"
			"\tvar t = T{__c_call(\"w\", int, a, // d\n"
			"\t\tb), z}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(__c_call(\"w\", int, a, /* c */ b), x)\n"
			"\tvar t = T{__c_call(\"w\", int, a, // d\n"
			"\t\t\tb), z}\n"
			"}\n"
	return checkListComments(src, want)
}

// A block comment after the opener counts in the first element's width: when the two do
// not fit after the opener, the element starts a continuation line.
func TestListCommentOpenerWidth() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh(/* a comment of "
			"about thirty */ aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, b)\n"
			"\thhhh(/* a comment */ "
			"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaa\", b)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh(/* a comment of "
			"about thirty */\n"
			"\t\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, b)\n"
			"\thhhh(/* a comment */\n"
			"\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaa\", b)\n"
			"}\n"
	return checkListComments(src, want)
}

// On a `// LONG-LINE ALLOWED` line a block comment in a list stays where it is, past the
// cap, and so does one in a case label.
func TestListCommentLongLineAllowed() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaa, /* cccccccccccccccc */ d) // LONG-LINE ALLOWED\n"
			"\tswitch v {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"/* cccccccc */ d: // LONG-LINE ALLOWED\n"
			"\t\ta()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaa, /* cccccccccccccccc */ d) // LONG-LINE ALLOWED\n"
			"\tswitch v {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"/* cccccccc */ d: // LONG-LINE ALLOWED\n"
			"\t\ta()\n"
			"\t}\n"
			"}\n"
	return checkListComments(src, want)
}

// A block comment right after a delimiter is written against it, and one after `case`
// one space from it.
func TestListCommentAfterDelimiter() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(/* c */ x)\n"
			"\tvar t = T{/* d */ a}\n"
			"\tswitch v {\n"
			"\tcase /* e */ 1:\n"
			"\t\ta()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th(/* c */ x)\n"
			"\tvar t = T{/* d */ a}\n"
			"\tswitch v {\n"
			"\tcase /* e */ 1:\n"
			"\t\ta()\n"
			"\t}\n"
			"}\n"
	return checkListComments(src, want)
}

// A line comment after a block comment on its line stays on that line -- here a fresh
// continuation line, the block comment not fitting after the comma -- as a reformat, which
// finds both on a line of their own, prints them.
func TestGapLineCommentAfterBlockComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaa, /* K2 */ // K6\n"
			"\t\t\tb)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaa,\n"
			"\t\t\t/* K2 */ // K6\n"
			"\t\t\tb)\n"
			"}\n"
	return checkFormatGolden(src, want)
}
