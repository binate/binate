package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// A listItem is one element of a list that printStrList, fillStrs and the case-
// label and `__c_call` printers lay out: an expression (a composite element's,
// with its key), a type, a parameter, or fixed text.  Its text, rendered at column
// 0, measures it and is written as is when it is one line.  An item whose text
// spans lines is printed again from its node, in place, because a function
// literal's body, a multi-line struct or a nested list that wraps indents from
// the line it starts on -- written from text rendered at column 0, its later lines
// would be indented as if that line were at column 0.  Printed in place, a nested
// list also wraps to fit where it lands, reserving what follows the item there.
type listItem struct {
	text @[]readonly char
	// line is the source line of the item's first token.
	line int
	// An item has one node: an expression x (after a composite element's key,
	// printed as `key: `), a type te (after `...` when dots, a variadic
	// function-value type's last parameter), or a parameter -- or none, for a text
	// item.
	key   @ast.Expr
	x     @ast.Expr
	te    @ast.TypeExpr
	dots  bool
	param @ast.ParamDecl
}

// exprItem returns the item for expression x, with a composite element's key
// (nil for none); its line is the key's first token's, else x's.
func exprItem(key @ast.Expr, x @ast.Expr) @listItem {
	var it @listItem = make(listItem)
	it.key = key
	it.x = x
	it.line = exprStartPos(x).Line
	if key != nil { it.line = exprStartPos(key).Line }
	it.text = renderItem(it)
	return it
}

// typeItem returns the item for type te, written after `...` when dots.
func typeItem(te @ast.TypeExpr, dots bool) @listItem {
	var it @listItem = make(listItem)
	it.te = te
	it.dots = dots
	it.line = typeStartPos(te).Line
	it.text = renderItem(it)
	return it
}

// paramItem returns the item for parameter p.
func paramItem(p @ast.ParamDecl) @listItem {
	var it @listItem = make(listItem)
	it.param = p
	it.line = p.Pos.Line
	it.text = renderItem(it)
	return it
}

// textItem returns an item of fixed one-line text, at source line line.
func textItem(text @[]readonly char, line int) @listItem {
	var it @listItem = make(listItem)
	it.text = text
	it.line = line
	return it
}

// renderItem renders the item's node at column 0, giving its text.
func renderItem(it @listItem) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	printItemNode(sb, it, 0)
	return sb.String()
}

// printItem writes it at b's current position: its text when that is one line,
// else its node printed in place (see listItem), with tail bytes reserved after
// its last line for what follows it there (a comma, the list's close).
func printItem(b @strings.Builder, it @listItem, tail int) {
	if !hasNewline(it.text) {
		b.Write(it.text)
		return
	}
	printItemNode(b, it, tail)
}

// printItemNode prints the item's node: a parameter, a type (after `...` when
// dots), or an expression (after `key: ` when it has a key), reserving tail bytes
// after an expression.
func printItemNode(b @strings.Builder, it @listItem, tail int) {
	if it.param != nil {
		printParamDecl(b, it.param)
		return
	}
	if it.te != nil {
		if it.dots { b.Write("...") }
		printType(b, it.te)
		return
	}
	if it.key != nil {
		printExpr(b, it.key)
		b.Write(": ")
	}
	printExprTail(b, it.x, tail)
}

// itemIsCrossLineStr reports whether the item's expression (after any key) is a
// string the author split across source lines (exprIsCrossLineStr).
func itemIsCrossLineStr(it @listItem) bool {
	return it.x != nil && exprIsCrossLineStr(it.x)
}

// itemsHaveNewline reports whether some item's text spans lines, so the list
// cannot sit on one line.
func itemsHaveNewline(items @[]@listItem) bool {
	for i := 0; i < len(items); i++ {
		if hasNewline(items[i].text) { return true }
	}
	return false
}

// itemsOneLineLen is the length of the items joined by `, ` on one line.
func itemsOneLineLen(items @[]@listItem) int {
	var n int = 0
	for i := 0; i < len(items); i++ {
		if i > 0 { n = n + 2 }
		n = n + len(items[i].text)
	}
	return n
}

// printItemsOneLine writes the items joined by `, `; tail is what follows the
// last item.
func printItemsOneLine(b @strings.Builder, items @[]@listItem, tail int) {
	for i := 0; i < len(items); i++ {
		if i > 0 { b.Write(", ") }
		var t int = 1
		if i == len(items) - 1 { t = tail }
		printItem(b, items[i], t)
	}
}
