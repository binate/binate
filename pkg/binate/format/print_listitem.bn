package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A listItem is one element of a list that printStrList, fillStrs, the case-label
// printer and printCCall (a `__c_call` or a `__c_global`) lay out: an expression (a
// composite element's, with its key), a type, a parameter, or fixed text.  Its text
// is it rendered at column 0.  An expression item is measured and printed in place,
// where it would go (print_lineshare.bn): a nested list wraps to fit where it lands,
// reserving what follows the item there, and a function literal's body, a multi-line
// struct or a wrapped list indents from the line it starts on.  A type, parameter or
// text item is measured by its one-line form (flat), or, a type or parameter that fits
// on neither of its lines, by its renderings laid out by width alone (nodeItemStays) --
// so a type in which the source wrapped a list, or this formatting did, is measured as
// one that it did not, and a second format puts it where the first did.  It is written
// as its text when that is one line and fits where it goes; otherwise a type or
// parameter is printed again in place, for the same reason, so a list in it wraps to
// fit there, reserving what follows the item.
type listItem struct {
	text @[]readonly char
	// flat is the width of a type, parameter or text item's one-line form: its text's,
	// or, when that spans lines, its rendering with wrapping suppressed; -1 when that
	// spans lines too (a comment in it needs a line break).
	flat int
	// pos is the source position of the item's first token, and line its line.
	pos  token.Pos
	line int
	// An item has one node: an expression x (after a composite element's key,
	// printed as `key: `), a type te (after `...` when dots, a variadic
	// function-value type's last parameter), or a parameter -- or none, for a text
	// item.
	key   @ast.Expr
	x     @ast.Expr
	te    @ast.TypeExpr
	dots  bool
	param @ast.ParamDecl
	// colon is the position of a keyed element's `:` (elementColon), the zero Pos
	// when it is unknown.
	colon token.Pos
	// keyed marks a text item at its own token's position, which can key the
	// list (listKey).
	keyed bool
}

// exprItem returns the item for expression x, with a composite element's key
// (nil for none); its line is the key's first token's, else x's.
func exprItem(key @ast.Expr, x @ast.Expr) @listItem {
	var it @listItem = make(listItem)
	it.key = key
	it.x = x
	it.pos = exprStartPos(x)
	if key != nil {
		it.pos = exprStartPos(key)
		it.colon = elementColon(key, x)
	}
	it.line = it.pos.Line
	it.text = renderItem(it)
	return it
}

// typeItem returns the item for type te, written after `...` when dots: it starts
// at the `...` when the comments after that give its position (variadicDots), so
// that those comments are the item's.
func typeItem(te @ast.TypeExpr, dots bool) @listItem {
	var it @listItem = make(listItem)
	it.te = te
	it.dots = dots
	it.pos = typeStartPos(te)
	if dots && variadicDots(it.pos).Line > 0 { it.pos = variadicDots(it.pos) }
	it.line = it.pos.Line
	it.text = renderItem(it)
	it.flat = flatItemWidth(it)
	return it
}

// paramItem returns the item for parameter p.
func paramItem(p @ast.ParamDecl) @listItem {
	var it @listItem = make(listItem)
	it.param = p
	it.pos = p.Pos
	it.line = p.Pos.Line
	it.text = renderItem(it)
	it.flat = flatItemWidth(it)
	return it
}

// textItem returns an item of fixed one-line text, at source position pos --
// its own token's when keyed.
func textItem(text @[]readonly char, pos token.Pos, keyed bool) @listItem {
	var it @listItem = make(listItem)
	it.text = text
	it.flat = len(text)
	it.pos = pos
	it.line = pos.Line
	it.keyed = keyed
	return it
}

// renderItem renders the item's node at column 0, giving its text.  An
// expression's rendering comes from the cache (renderAt), after its key's and the
// comments around its `:` when it has one (keyPrefix), and a type's or a parameter's
// from the type renderings kept (itemNodeAt, print_typememo.bn).
func renderItem(it @listItem) @[]readonly char {
	if it.x != nil && it.key == nil { return renderAt(it.x, 0, 0, 0) }
	if it.te != nil || it.param != nil { return itemNodeAt(it, 0, 0, 0) }
	var sb @strings.Builder = strings.NewBuilder()
	if it.x != nil {
		var kp @[]readonly char = keyPrefix(it, renderAt(it.key, 0, 0, 0))
		if !hasNewline(kp) {
			sb.Write(kp)
			sb.Write(renderAt(it.x, len(kp), 0, 0))
			return sb.String()
		}
	}
	printItemNode(sb, it, 0)
	return sb.String()
}

// flatItemWidth returns the width of type or parameter item it's one-line form (see
// listItem.flat): its text's when that is one line, else its rendering with wrapping
// suppressed and structs on one line (structsOneLine), rendered only then (a type
// rarely spans lines), or -1 when that spans lines too.
func flatItemWidth(it @listItem) int {
	if !hasNewline(it.text) { return len(it.text) }
	var saved bool = wrapSuppressed
	var savedOne bool = structsOneLine
	wrapSuppressed = true
	structsOneLine = true
	var s @[]readonly char = itemNodeAt(it, 0, 0, 0)
	wrapSuppressed = saved
	structsOneLine = savedOne
	if hasNewline(s) { return -1 }
	return len(s)
}

// printItem writes it at b's current position: an expression item, or a type or
// parameter whose text spans lines or does not fit on the line with tail bytes after
// it, its node printed in place (see listItem), with tail bytes reserved after its
// last line for what follows it there (a comma, the list's close); any other item
// its text.
func printItem(b @strings.Builder, it @listItem, tail int) {
	var node bool = it.te != nil || it.param != nil
	if it.x == nil && !hasNewline(it.text) &&
			(!node || lineWidth(b) + len(it.text) + tail <= MAX_LINE_WIDTH) {
		b.Write(it.text)
		return
	}
	printItemNode(b, it, tail)
}

// printItemNode prints the item's node: a parameter, a type (after `...` when
// dots), or an expression (after its key and `:`, with the comments around it,
// when it has a key), reserving tail bytes after it.
func printItemNode(b @strings.Builder, it @listItem, tail int) {
	if it.param != nil {
		printParamDecl(b, it.param, tail)
		return
	}
	if it.te != nil {
		if it.dots {
			printDotsType(b, it.te, tail)
		} else {
			printTypeTail(b, it.te, tail)
		}
		return
	}
	if it.key != nil {
		printExpr(b, it.key)
		writeKeyColon(b, it)
	}
	printExprTail(b, it.x, tail)
}

// itemsHaveNewline reports whether some item's text spans lines, so the list
// cannot sit on one line.
func itemsHaveNewline(items @[]@listItem) bool {
	for i := 0; i < len(items); i++ {
		if hasNewline(items[i].text) { return true }
	}
	return false
}

// itemsOneLineLen is the length of the items joined by `, ` on one line, with
// the comments after the opener (at opener) and between them; MAX_LINE_WIDTH + 1
// when one of those comments needs a line break after it.
func itemsOneLineLen(items @[]@listItem, opener token.Pos) int {
	var key token.Pos = listKey(items)
	var n int = 0
	var lo token.Pos = opener
	for i := 0; i < len(items); i++ {
		if i > 0 { n = n + 2 }
		var cs @[]@token.Comment = claimGap(lo, items[i].pos, key)
		lo = items[i].pos
		var w int = gapCommentsWidth(cs)
		if w < 0 { return MAX_LINE_WIDTH + 1 }
		n = n + w + len(items[i].text)
	}
	return n
}

// printItemsOneLine writes the items joined by `, `, with the comments after the
// opener (at opener) and between them; one that needs a line break continues the
// list on a line at the current indent plus two.  When spaced (after `case`), a
// space separates the opener from what follows it.  tail is what follows the last
// item.
func printItemsOneLine(b @strings.Builder, items @[]@listItem, opener token.Pos, spaced bool,
		tail int) {
	var key token.Pos = listKey(items)
	var cont int = currentLineIndent(b) + 2
	var lo token.Pos = opener
	for i := 0; i < len(items); i++ {
		if i > 0 { b.WriteByte(',') }
		var first bool = i == 0
		writeGapSeparator(b, claimGap(lo, items[i].pos, key), cont, first && !spaced, !first || spaced)
		lo = items[i].pos
		var t int = 1
		if i == len(items) - 1 { t = tail }
		printItem(b, items[i], t)
	}
}
