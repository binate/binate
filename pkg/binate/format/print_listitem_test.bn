package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests of a list element that spans lines -- a function literal, a split string,
// a nested list that wraps -- printed in a list laid out from list items (composite
// elements, case labels, `__c_call` arguments, parameters, types): its later lines
// indent from the line the element starts on.

// A function literal in a composite literal's elements, keyed or not, indents
// its body from the line it starts on.
func TestListItemFuncLitInComposite() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tvar s = S{f: func() {\n"
			"\t\tg()\n"
			"\t}}\n"
			"\tif c {\n"
			"\t\tt := [2]T{func() {\n"
			"\t\t\tg()\n"
			"\t\t}, func() {\n"
			"\t\t\th()\n"
			"\t\t}}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// So does one in a case label, alone or after another label, and in a
// `__c_call`'s arguments.
func TestListItemFuncLitInCaseLabelAndCCall() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase func() int {\n"
			"\t\treturn 1\n"
			"\t}():\n"
			"\t\tg()\n"
			"\tcase 2, func() int {\n"
			"\t\treturn 3\n"
			"\t}():\n"
			"\t\th()\n"
			"\t}\n"
			"\tv := __c_call(\"f\", int, func() {\n"
			"\t\tg()\n"
			"\t})\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A string split across lines in a composite literal's elements or a case label
// continues two levels past the line it starts on -- a case label's first item,
// which is not the label's last, on a continuation line of its own.
func TestListItemCrossLineStrInList() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tvar s = @[]@[]char{\"ccc\", \"aaa\"\n"
			"\t\t\t\"bbb\"}\n"
			"\tswitch x {\n"
			"\tcase\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\t\"c\":\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A parameter whose function-value type wraps continues two levels past the
// parameter's line, and a multi-line struct in a type list indents its fields
// from the line it starts on.
func TestListItemParamSpansLines() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func walk(\n"
			"\t\tctx @Ctx, rule *func(\n"
			"\t\t\t\t@Ctx, @ast.Expr)) {\n"
			"\tvar fv *func(struct {\n"
			"\t\ta int\n"
			"\t}, int)\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A multi-line element printed in place leaves room after its last line for what
// follows it in the list (here the outer composite's `}`): `zzzzz}` would end at
// byte 100 after `v17, `, but with that `}` it does not fit there.
func TestListItemReservesTail() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tif c {\n"
					"\t\treturn [1]S{T{\n"
					"\t\t\tv00, v01, v02, v03, v04, v05, v06, v07, v08, "
					"v09, v10, v11, v12, v13, v14, v15, v16, v17,\n"
					"\t\t\tzzzzz}}\n"
					"\t}\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f() {\n"
					"\tif c {\n"
					"\t\treturn [1]S{T{\n"
					"\t\t\t\tv00, v01, v02, v03, v04, v05, v06, v07, v08, "
					"v09, v10, v11, v12, v13, v14, v15, v16, v17,\n"
					"\t\t\t\tzzzzz}}\n"
					"\t}\n"
					"}\n")
}

// A string split across lines that is not its list's last element starts a
// continuation line of its own, where its parts continue deeper than the items
// after it, and the item after it starts a fresh continuation line, as a call's
// argument does, in a composite literal (keyed or not, opener alone or not in the
// source), a case label and a `__c_call`.
func TestListItemAfterCrossLineStr() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tvar s = @[]@[]char{\"aaa\"\n"
			"\t\t\t\"bbb\", \"ccc\"}\n"
			"\tvar t = T{a: \"aaa\"\n"
			"\t\t\t\"bbb\", b: 1}\n"
			"\tvar u = @[]@[]char{\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\", \"ccc\"}\n"
			"\tswitch x {\n"
			"\tcase \"aaa\"\n"
			"\t\t\t\"bbb\", \"ccc\":\n"
			"\t\th()\n"
			"\t}\n"
			"\t_ = __c_call(\"puts\", int, \"aaa\"\n"
			"\t\t\t\"bbb\", 3)\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tvar s = @[]@[]char{\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\t\"ccc\"}\n"
			"\tvar t = T{\n"
			"\t\t\ta: \"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\tb: 1}\n"
			"\tvar u = @[]@[]char{\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\t\"ccc\"}\n"
			"\tswitch x {\n"
			"\tcase\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\t\"ccc\":\n"
			"\t\th()\n"
			"\t}\n"
			"\t_ = __c_call(\"puts\", int,\n"
			"\t\t\t\"aaa\"\n"
			"\t\t\t\t\t\"bbb\",\n"
			"\t\t\t3)\n"
			"}\n"
	return checkFormatGolden(src, want)
}
