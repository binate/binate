package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printStmtMaybeNoWrap prints a statement, suppressing width-aware wrapping when
// the statement's line bears the `// LONG-LINE ALLOWED` marker, so a marked line
// is preserved intact instead of being reflowed.  An outer suppressed state is
// preserved when this statement is not itself marked.
func printStmtMaybeNoWrap(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	if hasLongLineMarker(cc, s.End.Line) {
		var prev bool = setWrapSuppressed(true)
		printStmt(b, cc, s, indent)
		setWrapSuppressed(prev)
	} else {
		printStmt(b, cc, s, indent)
	}
}

// printDeclMaybeNoWrap is printStmtMaybeNoWrap for a top-level or grouped
// declaration line bearing the marker.
func printDeclMaybeNoWrap(b @strings.Builder, cc @commentCursor, d @ast.Decl) {
	if hasLongLineMarker(cc, d.End.Line) {
		var prev bool = setWrapSuppressed(true)
		printDecl(b, cc, d)
		setWrapSuppressed(prev)
	} else {
		printDecl(b, cc, d)
	}
}

// wrapSuppressed disables width-aware wrapping while set, so a line the author
// marked `// LONG-LINE ALLOWED` is never reflowed/split.  It is set around the
// rendering of a single statement or declaration whose trailing comment bears the
// marker (see markedWrap), and cleared immediately after.  Formatting is
// single-threaded and a marked line is a leaf statement, so this scoped global
// needs no nesting discipline beyond set-then-clear.
var wrapSuppressed bool = false

// markedWrap runs a no-arg render body with wrapping suppressed when `marked`,
// restoring the previous state afterward.  Callers detect `marked` with
// hasLongLineMarker before emitting the statement/decl.
func setWrapSuppressed(v bool) bool {
	var prev bool = wrapSuppressed
	wrapSuppressed = v
	return prev
}

// hasLongLineMarker reports whether a pending same-line (trailing) comment on the
// given source line bears the `LONG-LINE ALLOWED` marker.  It only peeks the
// cursor -- it does not advance it (the comment is emitted normally as a trailing
// comment).  A no-op-false when cc is nil.
func hasLongLineMarker(cc @commentCursor, line int) bool {
	if cc == nil { return false }
	for k := cc.idx; k < len(cc.comments); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line > line { break }
		if !c.OwnLine && c.Pos.Line == line && containsMarker(c.Text) {
			return true
		}
	}
	return false
}

// containsMarker reports whether a comment's text contains `LONG-LINE ALLOWED`
// (the substring scripts/hygiene/line-length.sh recognizes to skip a line).
func containsMarker(text *[]readonly char) bool {
	var needle *[]readonly char = "LONG-LINE ALLOWED"
	var n int = len(needle)
	for i := 0; i + n <= len(text); i++ {
		var match bool = true
		for j := 0; j < n; j++ {
			if text[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}
