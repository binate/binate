package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printStmtMaybeNoWrap prints a statement, suppressing width-aware wrapping when
// the statement's line bears the `// LONG-LINE ALLOWED` marker, so a marked line
// is preserved intact instead of being reflowed.  An outer suppressed state is
// preserved when this statement is not itself marked.  limit is where the
// statement's line goes on to another node, if it does (hasLongLineMarker).
//
// Only a single-line statement is suppressed: the marker governs one physical
// line, so a multi-line statement (a block, a source-wrapped statement) whose
// End line happens to bear the marker must not have its whole body suppressed.
// For the same reason a marked statement that cannot stay on its line -- a block
// in it must expand, for a comment between its statements -- prints unmarked:
// the marker ends up on its last line only, and a second format, finding the
// statement on several lines, formats it unmarked too.
func printStmtMaybeNoWrap(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int,
		limit token.Pos) {
	if stmtStartPos(s).Line != s.End.Line || !hasLongLineMarker(cc, s.End.Line, limit) {
		printStmtTrailing(b, cc, s, indent, limit)
		return
	}
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, s.End)
	var prev bool = setWrapSuppressed(true)
	printStmt(trial, cc, s, indent)
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return }
	resetCursors(cc, mark)
	printStmtTrailing(b, cc, s, indent, limit)
}

// printDeclMaybeNoWrap is printStmtMaybeNoWrap for a single-line top-level
// declaration whose line bears the marker; limit is where its line goes on to the
// next declaration, if it does.  Its annotation block, which goes on a line of its
// own, is printed first: the marked line is the declaration's.
func printDeclMaybeNoWrap(b @strings.Builder, cc @commentCursor, d @ast.Decl, limit token.Pos) {
	if d.Pos.Line != d.End.Line || !hasLongLineMarker(cc, d.End.Line, limit) {
		printAnnotationsBefore(b, cc, d.Annotations, d.Pos)
		printDeclBodyTrailing(b, cc, d, limit)
		return
	}
	printAnnotationsBefore(b, cc, d.Annotations, d.Pos)
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, d.End)
	var prev bool = setWrapSuppressed(true)
	printDeclBody(trial, cc, d)
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return }
	resetCursors(cc, mark)
	printDeclBodyTrailing(b, cc, d, limit)
}

// printTrailingMaybeNoWrap is printStmtMaybeNoWrap for trail node n -- the type of
// a struct field, the signature of an interface method -- which starts on line
// start and ends at end: printTrailing (cont is the column its continuation lines
// start at), unless n is on one line and that line bears the marker before limit.
func printTrailingMaybeNoWrap(b @strings.Builder, cc @commentCursor, n @trailNode, start int,
		end token.Pos, limit token.Pos, cont int) {
	if start != end.Line || !hasLongLineMarker(cc, end.Line, limit) {
		printTrailing(b, cc, n, end, limit, cont)
		return
	}
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, end)
	var prev bool = setWrapSuppressed(true)
	printNodeTail(trial, cc, n, 0)
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return }
	resetCursors(cc, mark)
	printTrailing(b, cc, n, end, limit, cont)
}

// markedStmtRunEnd returns the index past the statements a `// LONG-LINE ALLOWED`
// line keeps together from stmts[i], `;`-joined as the source wrote them
// (printMarkedStmts): the source wrote stmts[i] and the ones after it on one line,
// each on that line alone, and the marker follows the last of them (before the next
// statement, or close).  One per line, only the last would keep the marker, and a
// second format would wrap the others.  Returns i + 1 when the line holds stmts[i]
// alone or the marker is not there.
func markedStmtRunEnd(cc @commentCursor, stmts @[]@ast.Stmt, i int, close token.Pos) int {
	var line int = stmtStartPos(stmts[i]).Line
	var j int = i
	for j < len(stmts) && stmtStartPos(stmts[j]).Line == line && stmts[j].End.Line == line {
		j = j + 1
	}
	if j < i + 2 || !hasLongLineMarker(cc, line, stmtLimit(stmts, j, close)) { return i + 1 }
	return j
}

// printMarkedStmts prints stmts[i:end] (markedStmtRunEnd) on the current line, with
// wrapping suppressed, and reports true; or prints nothing and reports false when
// one of them cannot stay on the line (a block in it must expand, for a comment
// between its statements).  The comments after the last are the caller's.
func printMarkedStmts(b @strings.Builder, cc @commentCursor, stmts @[]@ast.Stmt, i int, end int,
		indent int) bool {
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, stmts[end - 1].End)
	var prev bool = setWrapSuppressed(true)
	printJoinedStmts(trial, cc, stmts, i, end, indent)
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return true }
	resetCursors(cc, mark)
	return false
}

// printJoinedStmts prints stmts[i:end] `;`-joined, with the comments between them.
func printJoinedStmts(b @strings.Builder, cc @commentCursor, stmts @[]@ast.Stmt, i int, end int,
		indent int) {
	printStmt(b, cc, stmts[i], indent)
	for k := i + 1; k < end; k++ {
		emitTrailingCommentBefore(b, cc, stmts[k - 1].End, stmtStartPos(stmts[k]))
		b.Write("; ")
		printStmt(b, cc, stmts[k], indent)
	}
}

// markedDeclRunEnd is markedStmtRunEnd for top-level declarations joined by `;`.
func markedDeclRunEnd(cc @commentCursor, decls @[]@ast.Decl, i int) int {
	var line int = decls[i].Pos.Line
	if decls[i].End.Line != line { return i + 1 }
	var j int = i + 1
	for j < len(decls) && declStartPos(decls[j]).Line == line && decls[j].End.Line == line {
		j = j + 1
	}
	if j < i + 2 || !hasLongLineMarker(cc, line, declLimit(decls, j)) { return i + 1 }
	return j
}

// printMarkedDecls is printMarkedStmts for decls[i:end] (markedDeclRunEnd), after
// the annotation block of the first, which goes on a line of its own.  When the
// line cannot be kept, it prints that declaration alone, unmarked (the marker is
// the last one's), and reports false.
func printMarkedDecls(b @strings.Builder, cc @commentCursor, decls @[]@ast.Decl, i int,
		end int) bool {
	printAnnotationsBefore(b, cc, decls[i].Annotations, decls[i].Pos)
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, decls[end - 1].End)
	var prev bool = setWrapSuppressed(true)
	printDeclBody(trial, cc, decls[i])
	for k := i + 1; k < end; k++ {
		emitTrailingCommentBefore(trial, cc, decls[k - 1].End, declStartPos(decls[k]))
		trial.Write("; ")
		printDecl(trial, cc, decls[k])
	}
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return true }
	resetCursors(cc, mark)
	printDeclBodyTrailing(b, cc, decls[i], declStartPos(decls[i + 1]))
	return false
}

// markedMemberRunEnd is markedDeclRunEnd for the members of group d from members[i],
// one member a run too (it is kept on its line as a declaration is): the index past
// the members of the line that are on it alone, when a comment on the line before
// the next member (or the group's `)`) bears the marker; i when none does, or when
// members[i] goes on past the line.
func markedMemberRunEnd(cc @commentCursor, d @ast.Decl, i int) int {
	var members @[]@ast.Decl = d.Decls
	var line int = memberStartLine(members[i])
	if members[i].End.Line != line { return i }
	var j int = i + 1
	for j < len(members) && memberStartLine(members[j]) == line && members[j].End.Line == line {
		j = j + 1
	}
	if !hasLongLineMarker(cc, line, memberLimit(d, j - 1)) { return i }
	return j
}

// printMarkedMembers is printMarkedStmts for members[i:end] of group d
// (markedMemberRunEnd).
func printMarkedMembers(b @strings.Builder, cc @commentCursor, d @ast.Decl, i int, end int) bool {
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, d.Decls[end - 1].End)
	var prev bool = setWrapSuppressed(true)
	printJoinedMembers(trial, cc, d, i, end)
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return true }
	resetCursors(cc, mark)
	return false
}

// markedMembersBody renders members[i:end] of group d as printMarkedMembers prints
// them, leaving the cursors as they were: what the line holds before its trailing
// comments, used to measure the alignment column before the run is printed.  The
// cursor has not reached the line then, so the comments between the members are
// found by position (writeLineCommentsBetween).
func markedMembersBody(cc @commentCursor, d @ast.Decl, i int, end int) @[]readonly char {
	var members @[]@ast.Decl = d.Decls
	var sb @strings.Builder = strings.NewBuilder()
	var mark @cursorMark = markCursors(cc, members[end - 1].End)
	var prev bool = setWrapSuppressed(true)
	printGroupMember(sb, members[i], 0)
	for k := i + 1; k < end; k++ {
		writeLineCommentsBetween(sb, cc, memberStartPos(members[k - 1]), memberStartPos(members[k]))
		sb.Write("; ")
		printGroupMember(sb, members[k], 0)
	}
	setWrapSuppressed(prev)
	resetCursors(cc, mark)
	return sb.String()
}

// writeLineCommentsBetween appends ` <text>` for each comment of cc after lo and
// before hi, on lo's line, that nothing has claimed: the comments that
// emitTrailingCommentBefore emits after the node starting at lo, before the one at
// hi, once the cursor reaches them.
func writeLineCommentsBetween(b @strings.Builder, cc @commentCursor, lo token.Pos, hi token.Pos) {
	if cc == nil { return }
	for k := firstAfter(cc, lo); k < len(cc.comments) && posLess(cc.comments[k].Pos, hi); k++ {
		var c @token.Comment = cc.comments[k]
		if isDone(cc, k) || c.OwnLine || c.Pos.Line != lo.Line { continue }
		b.WriteByte(' ')
		b.Write(c.Text)
	}
}

// printJoinedMembers prints members[i:end] of group d `;`-joined, with the comments
// between them.
func printJoinedMembers(b @strings.Builder, cc @commentCursor, d @ast.Decl, i int, end int) {
	var members @[]@ast.Decl = d.Decls
	printGroupMember(b, members[i], 0)
	for k := i + 1; k < end; k++ {
		emitTrailingCommentBefore(b, cc, members[k - 1].End, memberStartPos(members[k]))
		b.Write("; ")
		printGroupMember(b, members[k], 0)
	}
}

// lineTrial returns a builder holding b's current line, to print a trial of what
// follows on it as it would print in b.
func lineTrial(b @strings.Builder) @strings.Builder {
	var t @strings.Builder = strings.NewBuilder()
	t.Write(currentLine(b))
	return t
}

// keepTrialLine appends to b what trial (made by lineTrial(b)) printed after b's
// current line, and reports true, when it stayed on that line; false otherwise.
func keepTrialLine(b @strings.Builder, trial @strings.Builder) bool {
	var s @[]readonly char = trial.String()
	var printed @[]readonly char = s[len(currentLine(b)):len(s)]
	if hasNewline(printed) { return false }
	b.Write(printed)
	return true
}

// wrapSuppressed disables width-aware wrapping while set, so a line the author
// marked `// LONG-LINE ALLOWED` is never reflowed/split.  It is set around the
// printing of what a marked line holds -- a statement, declaration or group
// member, the ones joined on it by `;`, a case written on it with its body, a case
// label, a struct field, an interface method -- and restored right after
// (setWrapSuppressed).  Formatting is single-threaded.
var wrapSuppressed bool = false

// setWrapSuppressed sets wrapSuppressed to v and returns its previous value, for the
// caller to restore.  Callers find a marked line with hasLongLineMarker.
func setWrapSuppressed(v bool) bool {
	var prev bool = wrapSuppressed
	wrapSuppressed = v
	return prev
}

// hasLongLineMarker reports whether a pending same-line (trailing) comment on the
// given source line, before limit (unless it is the zero Pos), bears the
// `LONG-LINE ALLOWED` marker: past the limit -- the next statement, the enclosing
// block's `}` -- the marker is another node's.  It only peeks the cursor -- it
// does not advance it (the comment is emitted normally as a trailing comment).  A
// no-op-false when cc is nil.
func hasLongLineMarker(cc @commentCursor, line int, limit token.Pos) bool {
	if cc == nil { return false }
	// Start at the line's first comment: a group measures its members' lines before
	// the cursor reaches them (groupRunCommentColumn), past the comments of the
	// lines before.
	var lineStart token.Pos
	lineStart.Line = line
	var first int = firstAfter(cc, lineStart)
	if first < cc.idx { first = cc.idx }
	for k := first; k < len(cc.comments); k++ {
		if isDone(cc, k) { continue }
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line > line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		if !c.OwnLine && c.Pos.Line == line && containsMarker(c.Text) {
			return true
		}
	}
	return false
}

// containsMarker reports whether a comment's text contains the exact marker
// `// LONG-LINE ALLOWED` (the substring scripts/hygiene/line-length.sh recognizes
// to skip a line).  Matching the `// ` prefix -- not the bare phrase -- avoids a
// false positive from a comment that merely mentions "LONG-LINE ALLOWED".
func containsMarker(text *[]readonly char) bool {
	var needle *[]readonly char = "// LONG-LINE ALLOWED"
	var n int = len(needle)
	for i := 0; i + n <= len(text); i++ {
		var match bool = true
		for j := 0; j < n; j++ {
			if text[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}
