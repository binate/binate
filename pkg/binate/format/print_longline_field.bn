package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// markedFieldRunEnd is markedStmtRunEnd for the fields of a struct whose `}` is at
// close, from fields[i]: the index past the fields `;`-joined on a `// LONG-LINE
// ALLOWED` line (printMarkedFields), or i + 1.
func markedFieldRunEnd(cc @commentCursor, fields @[]@ast.FieldDecl, i int, close token.Pos) int {
	var line int = fields[i].Pos.Line
	var j int = i
	for j < len(fields) && fields[j].Pos.Line == line && fields[j].Type.End.Line == line {
		j = j + 1
	}
	if j < i + 2 || !hasLongLineMarker(cc, line, fieldLimit(fields, j - 1, close)) { return i + 1 }
	return j
}

// printMarkedFields is printMarkedStmts for fields[i:end] of a struct
// (markedFieldRunEnd), after the name of the first, which the caller has printed.
func printMarkedFields(b @strings.Builder, cc @commentCursor, fields @[]@ast.FieldDecl, i int,
		end int) bool {
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, fields[end - 1].Type.End)
	var prev bool = setWrapSuppressed(true)
	printType(trial, fields[i].Type)
	for k := i + 1; k < end; k++ {
		emitTrailingCommentBefore(trial, cc, fields[k - 1].Type.End, fields[k].Pos)
		trial.Write("; ")
		printFieldDecl(trial, fields[k])
	}
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return true }
	resetCursors(cc, mark)
	return false
}

// markedFieldsLine returns the line of fields[i:end] (markedFieldRunEnd) at indent
// indent as printMarkedFields prints it, unpadded, without the comments after the
// last, leaving the cursors as they were: it takes several lines when they cannot
// stay on one.  The cursor has not reached the line then, so the comments between
// the fields are found by position (markedMembersBody).
func markedFieldsLine(cc @commentCursor, fields @[]@ast.FieldDecl, i int, end int,
		indent int) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	writeIndent(sb, indent)
	var mark @cursorMark = markCursors(cc, fields[end - 1].Type.End)
	var prev bool = setWrapSuppressed(true)
	printFieldDecl(sb, fields[i])
	for k := i + 1; k < end; k++ {
		writeLineCommentsBetween(sb, cc, fields[k - 1].Pos, fields[k].Pos)
		sb.Write("; ")
		printFieldDecl(sb, fields[k])
	}
	setWrapSuppressed(prev)
	resetCursors(cc, mark)
	return sb.String()
}

// fieldLineEnds returns, for each field of fields[start:end] (of a struct whose `}`
// is at close, at field indent fi) that printStructMulti starts a line with, the
// index past the fields on that line -- those `;`-joined on a `// LONG-LINE
// ALLOWED` line that stay on it (markedFieldRunEnd, markedFieldsLine), or the field
// alone, as is each field of a marked line that cannot stay -- and 0 for the
// others, at index k - start.
func fieldLineEnds(cc @commentCursor, fields @[]@ast.FieldDecl, start int, end int, fi int,
		close token.Pos) @[]int {
	var ends @[]int = make_slice(int, end - start)
	// The fields before split are those of a marked line that cannot stay on it.
	var split int = 0
	for k := start; k < end; k = ends[k - start] {
		var e int = k + 1
		if k >= split { e = markedFieldRunEnd(cc, fields, k, close) }
		if e > k + 1 && hasNewline(markedFieldsLine(cc, fields, k, e, fi)) {
			split = e
			e = k + 1
		}
		ends[k - start] = e
	}
	return ends
}

// markedMethodRunEnd is markedStmtRunEnd for the methods of interface d from
// methods[i]: the index past the methods `;`-joined on a `// LONG-LINE ALLOWED` line
// (printMarkedMethods), or i + 1.
func markedMethodRunEnd(cc @commentCursor, d @ast.Decl, i int) int {
	var methods @[]@ast.Decl = d.Decls
	var line int = methods[i].Pos.Line
	var j int = i
	for j < len(methods) && methods[j].Pos.Line == line && methods[j].End.Line == line {
		j = j + 1
	}
	if j < i + 2 || !hasLongLineMarker(cc, line, methodLimit(d, j - 1)) { return i + 1 }
	return j
}

// printMarkedMethods is printMarkedStmts for methods[i:end] of interface d
// (markedMethodRunEnd).
func printMarkedMethods(b @strings.Builder, cc @commentCursor, d @ast.Decl, i int, end int) bool {
	var methods @[]@ast.Decl = d.Decls
	var trial @strings.Builder = lineTrial(b)
	var mark @cursorMark = markCursors(cc, methods[end - 1].End)
	var prev bool = setWrapSuppressed(true)
	printMethodSig(trial, methods[i], 0)
	for k := i + 1; k < end; k++ {
		emitTrailingCommentBefore(trial, cc, methods[k - 1].End, methods[k].Pos)
		trial.Write("; ")
		printMethodSig(trial, methods[k], 0)
	}
	setWrapSuppressed(prev)
	if keepTrialLine(b, trial) { return true }
	resetCursors(cc, mark)
	return false
}
