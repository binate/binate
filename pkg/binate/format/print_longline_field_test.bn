package "pkg/binate/format"

import "pkg/builtins/testing"

// An interface method on a `// LONG-LINE ALLOWED` line is kept whole, however wide, as a
// declaration on one is; one the source wrote across lines wraps as usual, with the marker after
// its last line, as does one that cannot stay on one line (a struct type in it expands for a
// comment between its fields).  A marker after the interface's `}` is the interface's, not its last
// method's.
func TestMarkedInterfaceMethodStaysWhole() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG() int // g\n"
			"\tKkkkkkkkkkkkkk(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmmmmmmmmmmmm(p struct { aaaaaaaaaaaaaaaa int /* c */; bbbb int }, qqqqqqqqqqqqqqqqqq i"
			"nt) (int, bool) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG() int // g\n"
			"\tKkkkkkkkkkkkkk(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmmmmmmmmmmmm(p struct {\n"
			"\t\taaaaaaaaaaaaaaaa int /* c */\n"
			"\t\tbbbb             int\n"
			"\t}, qqqqqqqqqqqqqqqqqq int) (int, bool) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error)\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}

// A struct field on a `// LONG-LINE ALLOWED` line is kept whole, with a one-line struct type in it,
// unless that struct expands for a comment between its fields; one the source wrote across lines
// wraps as usual.  A run with a field kept whole past the cap does not pad its names, as for any
// field past the cap: the run measures the field as it prints.  A marker after the struct's `}` is
// the struct's, not its last field's.
func TestMarkedStructFieldStaysWhole() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) // LONG-LINE ALLOWED\n"
			"\tN struct { aaaaaaaaaaaaaaaaaaaaaaaa int; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccccccccccc"
			"ccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tM struct { aaaaaaaaaaaaaaaaaaaaaaaa int /* c */; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccc"
			"ccccccccccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tCccccccccccccccccc, Dddddddddddddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\ta    int // a\n"
			"\tlongname *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddddd"
			"d) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tbb   int\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) // LONG-LINE ALLOWED\n"
			"\tN struct { aaaaaaaaaaaaaaaaaaaaaaaa int; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccccccccccc"
			"ccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tM struct {\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaa int /* c */\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbb int\n"
			"\t\tcccccccccccccccccccccccc int\n"
			"\t\tdddd                     int\n"
			"\t} // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc,\n"
			"\t\t\tDddddddddddddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\ta int // a\n"
			"\tlongname *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddddd"
			"d) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tbb int\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc,\n"
			"\t\t\tDddddddddddddd) (int, bool, error)\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}
