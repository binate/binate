package "pkg/binate/format"

import "pkg/builtins/testing"

// An interface method on a `// LONG-LINE ALLOWED` line is kept whole, however wide, as a
// declaration on one is; one the source wrote across lines wraps as usual, with the marker after
// its last line, as does one that cannot stay on one line (a struct type in it expands for a
// comment between its fields).  A marker after the interface's `}` is the interface's, not its last
// method's.
func TestMarkedInterfaceMethodStaysWhole() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG() int // g\n"
			"\tKkkkkkkkkkkkkk(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmmmmmmmmmmmm(p struct { aaaaaaaaaaaaaaaa int /* c */; bbbb int }, qqqqqqqqqqqqqqqqqq i"
			"nt) (int, bool) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG() int // g\n"
			"\tKkkkkkkkkkkkkk(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmmmmmmmmmmmm(p struct {\n"
			"\t\taaaaaaaaaaaaaaaa int /* c */\n"
			"\t\tbbbb             int\n"
			"\t}, qqqqqqqqqqqqqqqqqq int) (int, bool) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error)\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}

// A struct field on a `// LONG-LINE ALLOWED` line is kept whole, with a one-line struct type in it,
// unless that struct expands for a comment between its fields; one the source wrote across lines
// wraps as usual.  A run with a field kept whole past the cap does not pad its names, as for any
// field past the cap: the run measures the field as it prints.  A marker after the struct's `}` is
// the struct's, not its last field's.
func TestMarkedStructFieldStaysWhole() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) // LONG-LINE ALLOWED\n"
			"\tN struct { aaaaaaaaaaaaaaaaaaaaaaaa int; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccccccccccc"
			"ccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tM struct { aaaaaaaaaaaaaaaaaaaaaaaa int /* c */; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccc"
			"ccccccccccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tCccccccccccccccccc, Dddddddddddddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\ta    int // a\n"
			"\tlongname *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddddd"
			"d) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tbb   int\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) // LONG-LINE ALLOWED\n"
			"\tN struct { aaaaaaaaaaaaaaaaaaaaaaaa int; bbbbbbbbbbbbbbbbbbbbbbbb int; ccccccccccccccccc"
			"ccccccc int; dddd int } // LONG-LINE ALLOWED\n"
			"\tM struct {\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaa int /* c */\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbb int\n"
			"\t\tcccccccccccccccccccccccc int\n"
			"\t\tdddd                     int\n"
			"\t} // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc,\n"
			"\t\t\tDddddddddddddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\ta int // a\n"
			"\tlongname *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddddd"
			"d) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tbb int\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc,\n"
			"\t\t\tDddddddddddddd) (int, bool, error)\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}

// Struct fields `;`-joined on a `// LONG-LINE ALLOWED` line are kept on it, however wide, with the
// comments between them, as statements are; an anonymous embed among them too, in a nested struct
// too, and from the line a field that spans lines ends on.  Only the first one's name is padded, so
// only its name counts for the run's padding, and the run measures the line whole, with its indent
// and the comments between them, and the comments after it as those after its last field: past the
// cap, it leaves the run unpadded.  A line that cannot be kept (a struct type in it expands for a
// comment between its fields) prints one field per line, the marker after the last and the comments
// between them after the fields they follow, and the run measures them so.  A marker after the
// struct's `}` is the struct's.
func TestMarkedJoinedFieldsStayJoined() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) /* f */; g int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type E struct {\n"
			"\tBase; F *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd"
			") (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error); pkg.Base // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\tcccc int\n"
			"\ta int /* x */; bbbbbbbb int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type P struct {\n"
			"\tcccc int\n"
			"\ta *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc) int; bbbbbbbbbbbbbbb"
			"bbbbbbbb int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type N struct {\n"
			"\tcccc int\n"
			"\ta *func(AAAAAAAAAAAAAAAAAAAA, BBBBBBBBBBBBBBBBBBBB, CCCCCCCCCC) int /* xxxxx */; b int /"
			"/ LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type O struct {\n"
			"\tcccc int\n"
			"\ta *func(AAAAAAAAAAAAAAAAAAAA, BBBBBBBBBBBBBBBBBBBB, CCCCCCCCCCCCCCCCC) int /* xxxxxxxxx "
			"*/; b int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\tM struct { aaaa int /* c */; bb int } /* m */; h int /* h */; gggggg int // LONG-LINE AL"
			"LOWED\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error); g int } // LONG-LINE ALLOWED\n"
			"\n"
			"type X struct {\n"
			"\tY struct {\n"
			"\t\ta int; F *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddd"
			"ddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\t}\n"
			"}\n"
			"\n"
			"type Y struct {\n"
			"\tM struct {\n"
			"\t\ta int\n"
			"\t}; g int; hhhh *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddd"
			"ddddddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error) /* f */; g int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type E struct {\n"
			"\tBase; F *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd"
			") (int, bool, error) // LONG-LINE ALLOWED\n"
			"\tG *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddddddd) (int"
			", bool, error); pkg.Base // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type R struct {\n"
			"\tcccc int\n"
			"\ta    int /* x */; bbbbbbbb int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type P struct {\n"
			"\tcccc int\n"
			"\ta *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc) int; bbbbbbbbbbbbbbb"
			"bbbbbbbb int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type N struct {\n"
			"\tcccc int\n"
			"\ta    *func(AAAAAAAAAAAAAAAAAAAA, BBBBBBBBBBBBBBBBBBBB, CCCCCCCCCC) int /* xxxxx */; b in"
			"t // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type O struct {\n"
			"\tcccc int\n"
			"\ta *func(AAAAAAAAAAAAAAAAAAAA, BBBBBBBBBBBBBBBBBBBB, CCCCCCCCCCCCCCCCC) int /* xxxxxxxxx "
			"*/; b int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\tM      struct {\n"
			"\t\taaaa int /* c */\n"
			"\t\tbb   int\n"
			"\t} /* m */\n"
			"\th      int /* h */\n"
			"\tgggggg int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"type Q struct {\n"
			"\tF *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc,\n"
			"\t\t\tDddddddddddddd) (int, bool, error)\n"
			"\tg int\n"
			"} // LONG-LINE ALLOWED\n"
			"\n"
			"type X struct {\n"
			"\tY struct {\n"
			"\t\ta int; F *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Ddddddddddd"
			"ddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"\t}\n"
			"}\n"
			"\n"
			"type Y struct {\n"
			"\tM struct {\n"
			"\t\ta int\n"
			"\t}\n"
			"\tg int; hhhh *func(Aaaaaaaaaaaaaaaaaa, Bbbbbbbbbbbbbbbbbb, Cccccccccccccccccc, Dddddddddd"
			"dddd) (int, bool, error) // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Interface methods `;`-joined on a `// LONG-LINE ALLOWED` line are kept on it, with the comments
// between them; a line that cannot be kept prints one method per line, the marker after the last
// and the comments between them after the methods they follow.  A marker after the interface's `}`
// is the interface's.
func TestMarkedJoinedMethodsStayJoined() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) /* f */; G() int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmm(p struct { aaaa int /* c */; bb int }) int /* m */; H() int /* h */; G() int // LON"
			"G-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error); G() int } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"interface W {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, ccccccccccccccccccc int) "
			"(int, bool, error) /* f */; G() int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface V {\n"
			"\tMmmm(p struct {\n"
			"\t\taaaa int /* c */\n"
			"\t\tbb   int\n"
			"\t}) int /* m */\n"
			"\tH() int /* h */\n"
			"\tG() int // LONG-LINE ALLOWED\n"
			"}\n"
			"\n"
			"interface U {\n"
			"\tFfffffffffffff(aaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\t\tccccccccccccccccccc int) (int, bool, error)\n"
			"\tG() int\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}
