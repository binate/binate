package "pkg/binate/format"

import "pkg/builtins/testing"

// The full single-line call used by the marked / unmarked contrast tests.
func longCallText() *[]readonly char {
	return "g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)"
}

// A line marked `// LONG-LINE ALLOWED` is NOT reflowed: a long call that would
// otherwise wrap stays on one line, the marker is preserved, and it is idempotent.
func TestNoReflowMarkedCall() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\tg(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // LONG-LINE ALLOWED\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, longCallText()) {
		return tokDiff("marked line was reflowed", out, longCallText())
	}
	var out2 @[]readonly char = Format(parseCollected(out))
	if !streq(out, out2) {
		return tokDiff("marked no-reflow not idempotent", out, out2)
	}
	return ""
}

// The same call WITHOUT the marker DOES wrap (contrast): the single-line form is
// gone and no line exceeds the cap.
func TestReflowUnmarkedCall() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tg(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)\n"
			"}"
	var out @[]readonly char = fmtFunc(src)
	if containsSub(out, longCallText()) {
		return tokDiff("unmarked long call was not wrapped", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("unmarked wrap: a line exceeds 100", out, "")
	}
	return ""
}

// A marked top-level declaration is likewise not reflowed.
func TestNoReflowMarkedDecl() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"var x = g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // LONG-LINE ALLOWED\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, longCallText()) {
		return tokDiff("marked decl was reflowed", out, longCallText())
	}
	return ""
}

// A trailing comment that merely MENTIONS the phrase (not the `// LONG-LINE
// ALLOWED` marker) does NOT suppress wrapping: the long call
// still wraps and no line exceeds the cap.
func TestNoReflowFalsePositive() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\tx := g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // mentions LONG-LINE ALLOWED\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if containsSub(out, longCallText()) {
		return tokDiff("marker-mention wrongly suppressed wrapping", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("false-positive suppression: a line exceeds 100", out, "")
	}
	return ""
}

// A marker on a multi-line construct's closing line (its End line) does NOT
// suppress wrapping for the whole body: a long call inside
// still wraps.
func TestNoReflowMultiLineNodeNotSuppressed() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\tif cond {\n"
			"\t\tx := g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)\n"
			"\t} // LONG-LINE ALLOWED\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if containsSub(out, longCallText()) {
		return tokDiff("marker on End line over-suppressed body wrapping", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("over-suppression: a line exceeds 100", out, "")
	}
	return ""
}

// A `// LONG-LINE ALLOWED` line keeps a block and a struct type the source wrote on one line
// there, past the cap: expanded, the marker would end up on the block's last line, and a
// reformat would wrap the line above it.
func TestMarkedLineKeepsOneLineBlockAndStruct() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() int { return bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbbbbbbbbbbb }) // LONG-LINE ALLOWED\n"
			"\tvar s struct { aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa int; cccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccccccccc int } // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// On a `// LONG-LINE ALLOWED` line, a one-line block whose comments sit in its lists is kept
// whole with them, past the cap: expanded, the marker would move to the block's last line,
// and a reformat would wrap the lines above it.  A comment between its statements, which only
// the expanded block places, still expands it, as a comment does a block on an unmarked line.
func TestMarkedLineKeepsBlockWithListComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() int { return h(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, /* c */ ccccccccccccccc"
			"ccccccccccccccccccccccccc) }) // LONG-LINE ALLOWED\n"
			"\tif ok { h(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, /* d */ ccccccccccccccccccccccccccccc"
			"ccccccccccc) } // LONG-LINE ALLOWED\n"
			"\tg(func() { a(); /* e */ b() }) // LONG-LINE ALLOWED\n"
			"\tg(func() int { return h(x, /* f */ y) })\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() int { return h(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, /* c */ ccccccccccccccc"
			"ccccccccccccccccccccccccc) }) // LONG-LINE ALLOWED\n"
			"\tif ok { h(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, /* d */ ccccccccccccccccccccccccccccc"
			"ccccccccccc) } // LONG-LINE ALLOWED\n"
			"\tg(func() {\n"
			"\t\ta() /* e */\n"
			"\t\tb()\n"
			"\t}) // LONG-LINE ALLOWED\n"
			"\tg(func() int {\n"
			"\t\treturn h(x, /* f */ y)\n"
			"\t})\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A marked line that cannot stay whole -- a block on it must expand, for a comment between
// its statements -- prints as an unmarked one does, the marker after its last `}`: kept
// whole, a block before that one would land on a line without the marker, which a second
// format expands.  A statement's trailing comments stop at the next statement and at its
// block's `}`.
func TestMarkedLineThatExpandsPrintsUnmarked() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() { if ok { h(a, /* d */ b) }; /* e */ c() }) // LONG-LINE ALLOWED\n"
			"\tif ok { h(a, /* d */ b) } else { k(); /* f */ z() } // LONG-LINE ALLOWED\n"
			"\tg(func() { k(func() { h(a, /* c */ b) }, /* q */ y); /* r */ z() }) // LONG-LINE ALLOWED"
			"\n"
			"\tif ok { h(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, ccccc"
			"cccccccccccccccccccccccccccccc) } else { k(); /* f */ z() } // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() {\n"
			"\t\tif ok {\n"
			"\t\t\th(a, /* d */ b)\n"
			"\t\t} /* e */\n"
			"\t\tc()\n"
			"\t}) // LONG-LINE ALLOWED\n"
			"\tif ok {\n"
			"\t\th(a, /* d */ b)\n"
			"\t} else {\n"
			"\t\tk() /* f */\n"
			"\t\tz()\n"
			"\t} // LONG-LINE ALLOWED\n"
			"\tg(func() {\n"
			"\t\tk(func() {\n"
			"\t\t\th(a, /* c */ b)\n"
			"\t\t}, /* q */ y) /* r */\n"
			"\t\tz()\n"
			"\t}) // LONG-LINE ALLOWED\n"
			"\tif ok {\n"
			"\t\th(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t\tccccccccccccccccccccccccccccccccccc)\n"
			"\t} else {\n"
			"\t\tk() /* f */\n"
			"\t\tz()\n"
			"\t} // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A marked declaration that cannot stay on its line -- a block in it must expand, for a comment
// between its statements -- prints as an unmarked one, as a statement does: kept whole, the `if`
// block would land on a line without the marker, which a second format expands.
func TestMarkedDeclarationThatExpandsPrintsUnmarked() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var g = func() { if ok { h(a, /* d */ b) }; /* e */ c() } // LONG-LINE ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var g = func() {\n"
			"\tif ok {\n"
			"\t\th(a, /* d */ b)\n"
			"\t} /* e */\n"
			"\tc()\n"
			"} // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}
