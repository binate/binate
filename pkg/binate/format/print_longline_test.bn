package "pkg/binate/format"

import "pkg/builtins/testing"

// The full single-line call used by the marked / unmarked contrast tests.
func longCallText() *[]readonly char {
	return "g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)"
}

// A line marked `// LONG-LINE ALLOWED` is NOT reflowed: a long call that would
// otherwise wrap stays on one line, the marker is preserved, and it is idempotent.
func TestNoReflowMarkedCall() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tg(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // LONG-LINE ALLOWED\n"
		"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, longCallText()) {
		return tokDiff("marked line was reflowed", out, longCallText())
	}
	var out2 @[]readonly char = Format(parseCollected(out))
	if !streq(out, out2) {
		return tokDiff("marked no-reflow not idempotent", out, out2)
	}
	return ""
}

// The same call WITHOUT the marker DOES wrap (contrast): the single-line form is
// gone and no line exceeds the cap.
func TestReflowUnmarkedCall() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tg(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)\n"
		"}"
	var out @[]readonly char = fmtFunc(src)
	if containsSub(out, longCallText()) {
		return tokDiff("unmarked long call was not wrapped", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("unmarked wrap: a line exceeds 100", out, "")
	}
	return ""
}

// A marked top-level declaration is likewise not reflowed.
func TestNoReflowMarkedDecl() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"var x = g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // LONG-LINE ALLOWED\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, longCallText()) {
		return tokDiff("marked decl was reflowed", out, longCallText())
	}
	return ""
}

// A trailing comment that merely MENTIONS the phrase (not the `// LONG-LINE
// ALLOWED` marker) does NOT suppress wrapping (review finding 5): the long call
// still wraps and no line exceeds the cap.
func TestNoReflowFalsePositive() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tx := g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee) // mentions LONG-LINE ALLOWED\n"
		"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if containsSub(out, longCallText()) {
		return tokDiff("marker-mention wrongly suppressed wrapping", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("false-positive suppression: a line exceeds 100", out, "")
	}
	return ""
}

// A marker on a multi-line construct's closing line (its End line) does NOT
// suppress wrapping for the whole body (review findings 3/4): a long call inside
// still wraps.
func TestNoReflowMultiLineNodeNotSuppressed() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tif cond {\n"
		"\t\tx := g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
		"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)\n"
		"\t} // LONG-LINE ALLOWED\n"
		"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if containsSub(out, longCallText()) {
		return tokDiff("marker on End line over-suppressed body wrapping", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("over-suppression: a line exceeds 100", out, "")
	}
	return ""
}
