package "pkg/binate/format"

import "pkg/builtins/testing"

// cappedLineLen measures a line whose comments at its end hold the
// `// LONG-LINE ALLOWED` marker up to those comments, without the blanks before them,
// and any other line whole -- a `//` or `/*` in a string or char literal starts no
// comment.
func TestCappedLineLen() testing.TestResult {
	if cappedLineLen("\tx := 1") != 7 { return "no comment" }
	if cappedLineLen("\tx := 1 // LONG-LINE ALLOWED") != 7 { return "the marker" }
	if cappedLineLen("\tx := 1 \t// LONG-LINE ALLOWED: x") != 7 { return "blanks, text after" }
	if cappedLineLen("// LONG-LINE ALLOWED") != 0 { return "the marker alone" }
	if cappedLineLen("\tx := 1 // LONG-LINE ALLOWE") != 27 { return "not the marker" }
	if cappedLineLen("\tx := 1 // see x // LONG-LINE ALLOWED") != 7 { return "text before it" }
	if cappedLineLen("\tx := 1 /* x */ // LONG-LINE ALLOWED") != 7 { return "a block comment before" }
	if cappedLineLen("\tx := 1 /* // LONG-LINE ALLOWED */") != 7 { return "in a block comment" }
	if cappedLineLen("\tx := 1 /* x */") != 15 { return "a block comment" }
	if cappedLineLen("\tx := \"// LONG-LINE ALLOWED\"") != 28 { return "in a string" }
	if cappedLineLen("\tx := \"a\\\"// b\" // LONG-LINE ALLOWED") != 15 { return "an escaped quote" }
	if cappedLineLen("\tc := '\"' // LONG-LINE ALLOWED") != 9 { return "a char literal" }
	if cappedLineLen("\tf(/* c */ x) // LONG-LINE ALLOWED") != 13 { return "a comment in the code" }
	return ""
}

// A `// LONG-LINE ALLOWED` line in a function literal argument is measured up to that
// comment, so `_ = h(func() {...} + q).field` stays as a first format prints it.
// Measured with the marker comment, the line's width depends on how its string run is
// written: a second format, finding it merged into one string, moved the literal
// below `h(` and split that string.
func TestMarkedRunLiteralArgStable() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){if c0{if c1{if c2{if c3{_=h(func(){_=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"+\n"
			"\"aaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaa"
			"aaaaaa\"// LONG-LINE ALLOWED\n"
			"}+qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq).field}}}}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\t_ = h(func() {\n"
			"\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\t\"aaaaaaaaaaaaaa\" +\n"
			"\t\t\t\t\t\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t} + qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq).field\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A fill measures a `// LONG-LINE ALLOWED` line up to that comment: the function literal
// stays after `k(`, the code on its marked line within the cap.  Measured with the
// marker comment, that line is past the cap there, and the literal moved below `k(`.
func TestFillMarkedLineToMarker() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){{{(k(func(){_=\"aaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaa\"+\n"
			"\"aaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaa\"\"aaaaaaaaaaa\"// LONG-LINE ALLOWED\n"
			"}))+1}}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t{\n"
			"\t\t{\n"
			"\t\t\tk(func() {\n"
			"\t\t\t\t_ = \"aaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaa\" + \"aaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaa"
			"\" \"aaaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t}) + 1\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A right-hand side measures a `// LONG-LINE ALLOWED` line up to that comment.  Measured
// with the marker comment, a second format split the marked line's string, leaving
// `"a"` on a line of its own.
func TestRhsMarkedLineToMarker() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){if c0{if c1{if c2{if c3{x=((func(){_=\"aaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaa"
			"a\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaa\"+\n"
			"\"aaaaaaaaaa\"\"aaaaaaaaa\"\"aaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaa\"// LONG-LINE ALLOWED\n"
			"}))}}}}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\tx = func() {\n"
			"\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\t\"aaaaaaaaaaa\" +\n"
			"\t\t\t\t\t\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t}\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line whose marker comment has text before the marker (`// see x // LONG-LINE
// ALLOWED`) is measured up to that comment, where the code before it is laid out to
// the cap.  Measured up to the marker, the line is wider than its code by that text,
// and a second format moved the value below `x =`.
func TestMarkedTextBeforeMarker() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){if c0{if c1{if c2{if c3{x=((func(){_=\"aaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaa\"\"aaaaaaaa\"+\n"
			"\"aaaaaaaaaaaaaa\"\"aaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaa\"\"aaaaaaaaaaaaa"
			"\"// see x // LONG-LINE ALLOWED\n"
			"}))}}}}}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\tx = func() {\n"
			"\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\t\"aaaaaaaa\" + \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaa\" // see x // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t}\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Marker text in a string literal marks nothing: the line is measured whole, and
// `m(...)` moves below `h(`.  Measured up to that text, both places' first lines came
// out alike, and `func() {` went to a continuation line instead.
func TestMarkerTextInStringNotMarker() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"if c0 {\n"
			"if c1 {\n"
			"if c2 {\n"
			"if c3 {\n"
			"if c4 {\n"
			"_ = h(m(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa// LONG-LINE ALLOWEDbbbbbbbbbbbbbbbbbbbbbbb\", func"
			"() {\n"
			"_ = 1\n"
			"})) + qqqqqqqqqqqq\n"
			"}\n"
			"}\n"
			"}\n"
			"}\n"
			"}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\tif c4 {\n"
			"\t\t\t\t\t\t_ = h(\n"
			"\t\t\t\t\t\t\t\tm(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa// LONG-LINE ALLOWEDbbbbbbbbbbbbbbbbbbbbb"
			"bb\", func() {\n"
			"\t\t\t\t\t\t\t\t\t_ = 1\n"
			"\t\t\t\t\t\t\t\t})) + qqqqqqqqqqqq\n"
			"\t\t\t\t\t}\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
