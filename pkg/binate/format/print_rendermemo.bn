package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/lang"
import "pkg/std/containers/hashmap"
import "pkg/std/strings"

// The printer measures an expression by rendering it where it would print -- from a
// column of a line with its indent, with what follows it (print_lineshare.bn) --
// and a list renders each element so, then prints it again in place.  Rendered
// afresh every time, an element nested d deep would be rendered 2^d times or more
// -- each level renders its elements to measure them, and each of those renders its
// own elements.  So a rendering is kept per node and place, for the formatting of
// one file: it depends only on the node, the column it starts at, its line's
// indent, what follows it, whether wrapping is suppressed, loneStays, how deep in
// nested lists it is (depthKey, print_deep.bn) and the comment cursor (the comments
// it prints are claimed by position, the same every time; see
// print_listcomments.bn), so every later measurement reads it.  A call or composite
// nested in lists is then rendered in place once for each enclosing list that
// wraps, and the time is polynomial in the depth.  (Not so for nested function
// literals: the statement trials in a literal's body are not cached, and each print
// of a literal is under a fresh cursor.  Nor for the layouts of nested calls that
// the fill decisions read back (print_reread.bn): a layout read back at another
// place is a new one, whose own decisions read their elements' layouts back in turn
// -- up to STABLE_LIST_DEPTH nested lists, past which nothing is read back;
// print_deep.bn.)
//
// A rendering is reused only under the comment cursor it was made under: it
// claimed its lists' comments in that cursor, so that cursor's emitters skip
// them.  A function literal's body, or a struct type, with comments gets a fresh
// cursor each time it is printed (innerCursor), and a rendering written there from
// another cursor would leave its comments unclaimed in the new one, which would
// print them again.

// renderKey identifies a node for the rendering cache: its kind and position, the
// column it is rendered from, its line's indent, what follows it there, whether
// wrapping was suppressed, loneStays, its depth in nested lists (depthKey), and the
// active comment cursor's id (0 for none).  Two nodes of a parsed file do not share
// a kind and a position, and the cache checks the node itself as well.  A node of a
// reading back without comments is kept by its shape instead (kind -1, line its
// shape; shapeOf), for every node of that shape.
type renderKey struct {
	cursor     int
	kind       int
	line       int
	col        int
	start      int
	indent     int
	tail       int
	suppressed bool
	loneStays  bool
	depth      int
}

// Hash mixes the key's fields.
func (a renderKey) Hash() uint {
	var h uint = cast(uint, a.line)
	h = h * 31 + cast(uint, a.col)
	h = h * 31 + cast(uint, a.kind)
	h = h * 31 + cast(uint, a.start)
	h = h * 31 + cast(uint, a.cursor)
	h = h * 31 + cast(uint, a.indent)
	h = h * 31 + cast(uint, a.tail)
	h = h * 31 + cast(uint, a.depth)
	if a.suppressed { h = h * 31 + 1 }
	if a.loneStays { h = h * 31 + 2 }
	return h
}

// Compare orders keys field by field.
func (a renderKey) Compare(b renderKey) int {
	if a.line != b.line { return cmpInt(a.line, b.line) }
	if a.col != b.col { return cmpInt(a.col, b.col) }
	if a.kind != b.kind { return cmpInt(a.kind, b.kind) }
	if a.start != b.start { return cmpInt(a.start, b.start) }
	if a.cursor != b.cursor { return cmpInt(a.cursor, b.cursor) }
	if a.indent != b.indent { return cmpInt(a.indent, b.indent) }
	if a.tail != b.tail { return cmpInt(a.tail, b.tail) }
	if a.depth != b.depth { return cmpInt(a.depth, b.depth) }
	if a.suppressed != b.suppressed { return cmpBool(a.suppressed, b.suppressed) }
	return cmpBool(a.loneStays, b.loneStays)
}

impl renderKey : lang.Hashable

// renderKeyAt returns the key of e rendered from column start of a line indented
// indent tabs, with tail bytes after it, under the current wrapping, loneStays and
// comment cursor.
func renderKeyAt(e @ast.Expr, start int, indent int, tail int) renderKey {
	var key renderKey
	key.kind = e.Kind
	key.line = e.Pos.Line
	key.col = e.Pos.Col
	key.start = start
	key.indent = indent
	key.tail = tail
	key.suppressed = wrapSuppressed
	key.loneStays = loneStays
	key.depth = depthKey()
	if activeCursor != nil { key.cursor = activeCursor.id }
	return key
}

// cmpInt returns -1, 0 or 1 as a is less than, equal to or greater than b.
func cmpInt(a int, b int) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// renderEntry is a cached rendering: the node it is of, and its text.
type renderEntry struct {
	node @ast.Expr
	text @[]readonly char
}

// renderCache holds the renderings of the file being formatted; nil outside a
// formatting.
var renderCache @hashmap.Map[renderKey, @renderEntry]

// resetRenderCache starts an empty cache, and drops the layouts the fill decisions
// took (dropOverrides), for a new formatting.
func resetRenderCache() {
	renderCache = hashmap.New[renderKey, @renderEntry]()
	dropOverrides()
}

// dropRenderCache releases the cache and the layouts the fill decisions took (and
// the nodes they hold) after a formatting.
func dropRenderCache() {
	var none @hashmap.Map[renderKey, @renderEntry]
	renderCache = none
	dropOverrides()
}

// renderCount counts the renderings renderAt has made afresh, not from a cache.
var renderCount int

// renderAt returns e rendered from column start of a line indented indent tabs
// (the tabs, then spaces, stand in for what precedes it on its line), with tail
// bytes after it, from the cache when it holds it -- by its shape, in a reading
// back without comments (shapeRenders).
func renderAt(e @ast.Expr, start int, indent int, tail int) @[]readonly char {
	if renderCache == nil { resetRenderCache() }
	var key renderKey = renderKeyAt(e, start, indent, tail)
	var cache @hashmap.Map[renderKey, @renderEntry] = renderCache
	var shape int = shapeOf(e)
	if shape > 0 {
		key.kind = -1
		key.line = shape
		key.col = 0
		if shapeRenders == nil { shapeRenders = hashmap.New[renderKey, @renderEntry]() }
		cache = shapeRenders
	}
	var got @renderEntry
	var ok bool
	got, ok = cache.Get(key)
	if ok && (shape > 0 || same(got.node, e)) { return got.text }
	renderCount = renderCount + 1
	var sb @strings.Builder = strings.NewBuilder()
	for i := 0; i < start; i++ {
		if i < indent { sb.WriteByte('\t') } else { sb.WriteByte(' ') }
	}
	printExprTail(sb, e, tail)
	var s @[]readonly char = sb.String()
	var ent @renderEntry = make(renderEntry)
	ent.node = e
	ent.text = s
	if start > 0 {
		var tb @strings.Builder = strings.NewBuilder()
		tb.Write(s[start:])
		ent.text = tb.String()
	}
	cache.Put(key, ent)
	return ent.text
}
