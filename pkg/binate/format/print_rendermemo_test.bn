package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the rendering cache (print_rendermemo.bn).

// deepCalls returns a file whose one statement nests d calls, each with the next
// as its first argument, on the opener's line, and its second argument on a line
// of its own.
func deepCalls(d int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc g() {\n\t_ = ")
	for i := 0; i < d; i++ { b.Write("f(") }
	b.WriteByte('x')
	for i := 0; i < d; i++ { b.Write(",\ny)") }
	b.Write("\n}\n")
	return b.String()
}

// deepComposites returns a file whose one variable nests d keyed composite
// literals, each spanning lines.
func deepComposites(d int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nvar v = ")
	for i := 0; i < d; i++ { b.Write("S{f: S{\n") }
	b.WriteByte('1')
	for i := 0; i < d; i++ { b.Write("}}") }
	b.WriteByte('\n')
	return b.String()
}

// checkFixpoint formats src and asserts that formatting the result again changes
// nothing.
func checkFixpoint(src *[]readonly char) testing.TestResult {
	var out @[]readonly char = Format(parseCollected(src))
	var again @[]readonly char = Format(parseCollected(out))
	if !streq(again, out) { return goldenDiff(again, out) }
	return ""
}

// Formatting time is polynomial in the nesting depth: calls nested 24 deep and
// keyed multi-line composites nested 16 deep -- depths at which rendering each
// level's elements afresh would take hours -- format, to a fixpoint.
func TestFormatDeepNesting() testing.TestResult {
	var r testing.TestResult = checkFixpoint(deepCalls(24))
	if len(r) > 0 { return r }
	return checkFixpoint(deepComposites(16))
}

// writeAs writes n `a`s.
func writeAs(b @strings.Builder, n int) {
	for i := 0; i < n; i++ { b.WriteByte('a') }
}

// An argument's one-line rendering is from its column in the list: a run of
// adjacent string literals that would pass the cap split there is written merged,
// so the list stays on one line, as it does formatted again.
func TestFormatArgsOneLineFromColumn() testing.TestResult {
	var src @strings.Builder = strings.NewBuilder()
	src.Write("package \"p\"\n\nfunc g() {\n\tf(a, ")
	for i := 0; i < 3; i++ {
		if i > 0 { src.WriteByte(' ') }
		src.WriteByte('"')
		writeAs(src, 30)
		src.WriteByte('"')
	}
	src.Write(")\n}\n")
	var want @strings.Builder = strings.NewBuilder()
	want.Write("package \"p\"\n\nfunc g() {\n\tf(a, \"")
	writeAs(want, 90)
	want.Write("\")\n}\n")
	var out @[]readonly char = Format(parseCollected(src.String()))
	if !streq(out, want.String()) { return goldenDiff(out, want.String()) }
	return checkFixpoint(src.String())
}

// A rendering made with lone elements kept on their openers' lines (loneStays) is cached
// apart from one made without: at the same place, its close at column 100 and two bytes
// after it, a call's lone name stays on the opener's line under loneStays and moves below
// it without.
func TestRenderCacheKeepsLoneStaysApart() testing.TestResult {
	var e @ast.Expr = parseExprSrc(
			"gggggggggggggggggggggggggggggggggggggggggggggggggg(ccccccccccccccccccccccccccccccccccccccccccc"
					"cccc)")
	resetRenderCache()
	loneStays = true
	var kept @[]readonly char = renderAt(e, 1, 1, 2)
	loneStays = false
	var moved @[]readonly char = renderAt(e, 1, 1, 2)
	dropRenderCache()
	if hasNewline(kept) { return tokDiff("the lone name moved under loneStays", kept, "") }
	if !hasNewline(moved) { return tokDiff("the lone name stayed without loneStays", moved, "") }
	return ""
}
