package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/lang"
import "pkg/std/containers/hashmap"
import "pkg/std/strings"

// A layout the printer chooses can carry breaks that a later format keeps as the
// author's -- an opener alone, a string run split across lines, a multi-line
// block, a wrapped list -- so a second format measures and prints the element
// with them.  To see what a second format makes of a rendering, the printer reads
// the rendering back (rereadExpr) and renders the result at a place
// (rereadRenderAt), as a second format would render it there, its own fill
// decisions checked in turn.  The element is read on its own, without the code
// around it, so this is close to a second format but not exact.  The fill
// decisions use it to keep to layouts a second format keeps (print_stable.bn).
//
// Such a layout can be one that no rendering of the element's own node gives --
// the breaks it has from being printed at another place -- so the printer can
// print a layout's text in place of the node (setOverride, printOverride).

// rereadExpr returns the file that the expression text (an element's rendering)
// parses to, as `var _ = (text)`, or nil when it does not parse.  The parentheses
// are the wrapper's: the expression is not marked parenthesized (only a binary
// operand prints by the mark, and a read-back expression is never one).
func rereadExpr(text *[]readonly char) @ast.File {
	var none @ast.File
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"p\"\nvar _ = (")
	sb.Write(text)
	sb.Write(")\n")
	var s @[]readonly char = sb.String()
	var src @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		src[i] = cast(uint8, s[i])
	}
	var pr @parser.Parser = parser.NewCollecting(src, "reread")
	var f @ast.File = pr.ParseFile()
	if len(pr.Errors()) > 0 || len(f.Decls) != 1 || f.Decls[0].Value == nil { return none }
	f.Decls[0].Value.Parenthesized = false
	return f
}

// rereadKey identifies a reading back (rereadRenderAt): the text, the column it is
// rendered from, its line's indent, what follows it, whether wrapping is
// suppressed, and loneStays.  An element's fill is decided at each place a rendering of what
// encloses it puts it, so the same layout is read back at the same place more than
// once.
type rereadKey struct {
	text       @[]readonly char
	start      int
	indent     int
	tail       int
	suppressed bool
	loneStays  bool
}

// Hash mixes the key's fields and the text's bytes.
func (a rereadKey) Hash() uint {
	var h uint = cast(uint, len(a.text))
	for i := 0; i < len(a.text); i++ {
		h = h * 31 + cast(uint, a.text[i])
	}
	h = h * 31 + cast(uint, a.start)
	h = h * 31 + cast(uint, a.indent)
	h = h * 31 + cast(uint, a.tail)
	if a.suppressed { h = h * 31 + 1 }
	if a.loneStays { h = h * 31 + 2 }
	return h
}

// Compare orders keys field by field, the texts byte by byte.
func (a rereadKey) Compare(b rereadKey) int {
	if a.start != b.start { return cmpInt(a.start, b.start) }
	if a.indent != b.indent { return cmpInt(a.indent, b.indent) }
	if a.tail != b.tail { return cmpInt(a.tail, b.tail) }
	if a.suppressed != b.suppressed { return cmpBool(a.suppressed, b.suppressed) }
	if a.loneStays != b.loneStays { return cmpBool(a.loneStays, b.loneStays) }
	if len(a.text) != len(b.text) { return cmpInt(len(a.text), len(b.text)) }
	for i := 0; i < len(a.text); i++ {
		if a.text[i] != b.text[i] { return cmpInt(cast(int, a.text[i]), cast(int, b.text[i])) }
	}
	return 0
}

impl rereadKey : lang.Hashable

// cmpBool orders false before true.
func cmpBool(a bool, b bool) int {
	if a == b { return 0 }
	if b { return -1 }
	return 1
}

// rereadEntry is a kept reading back: its rendering, and whether the text could
// be read back.
type rereadEntry struct {
	text @[]readonly char
	ok   bool
}

// rereads holds the readings back of the file being formatted.
var rereads @hashmap.Map[rereadKey, @rereadEntry]

// rereadRenderAt returns an element printed as text, read back and rendered from
// column start of a line indented indent tabs with tail bytes after it, as a
// second format would render it there, and whether the text parsed.  It is
// rendered with its own file's comments and builtin records, and its own
// rendering cache and overrides (its nodes' positions are its own file's).  Its
// fill decisions read their elements back in turn, smaller expressions each time.
func rereadRenderAt(text *[]readonly char, start int, indent int,
		tail int) (@[]readonly char, bool) {
	var empty @[]readonly char
	if rereads == nil { rereads = hashmap.New[rereadKey, @rereadEntry]() }
	var key rereadKey
	var tb @strings.Builder = strings.NewBuilder()
	tb.Write(text)
	key.text = tb.String()
	key.start = start
	key.indent = indent
	key.tail = tail
	key.suppressed = wrapSuppressed
	key.loneStays = loneStays
	var got @rereadEntry
	var have bool
	got, have = rereads.Get(key)
	if have { return got.text, got.ok }
	var ent @rereadEntry = make(rereadEntry)
	rereads.Put(key, ent)
	var f @ast.File = rereadExpr(text)
	if f == nil { return empty, false }
	var e @ast.Expr = f.Decls[0].Value
	savedCache := renderCache
	var savedCursor @commentCursor = activeCursor
	var savedOpeners @[]@ast.BuiltinOpener = activeOpeners
	savedOverrides := overrides
	var noOverrides @hashmap.Map[renderKey, @renderEntry]
	activeCursor = newCommentCursor(f.Comments)
	activeOpeners = f.BuiltinOpeners
	renderCache = hashmap.New[renderKey, @renderEntry]()
	overrides = noOverrides
	var s @[]readonly char = renderAt(e, start, indent, tail)
	renderCache = savedCache
	activeCursor = savedCursor
	activeOpeners = savedOpeners
	overrides = savedOverrides
	ent.text = s
	ent.ok = true
	return s, true
}

// rereadItemAt is rereadRenderAt for a list element whose text starts with prefix
// bytes (a one-line key and `: `) before its value, rendered after them: the value
// is read back and rendered after the prefix, and returned after it.
func rereadItemAt(text *[]readonly char, prefix int, start int, indent int,
		tail int) (@[]readonly char, bool) {
	if prefix == 0 { return rereadRenderAt(text, start, indent, tail) }
	var r @[]readonly char
	var ok bool
	r, ok = rereadRenderAt(text[prefix:], start + prefix, indent, tail)
	if !ok { return r, false }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(text[:prefix])
	sb.Write(r)
	return sb.String(), true
}

// overrides holds the layouts setOverride made elements', by node and place.
var overrides @hashmap.Map[renderKey, @renderEntry]

// dropOverrides forgets the readings back and the layouts setOverride made, for a
// new formatting.
func dropOverrides() {
	var none @hashmap.Map[renderKey, @renderEntry]
	overrides = none
	var noRereads @hashmap.Map[rereadKey, @rereadEntry]
	rereads = noRereads
}

// setOverride makes text e's layout from column start of a line indented indent
// tabs with tail bytes after it: printExprTail prints it there in place of e.  A
// fill decision measures e through renderAt, whose cache keeps e's own rendering,
// so it decides the same each time.
func setOverride(e @ast.Expr, start int, indent int, tail int, text @[]readonly char) {
	if overrides == nil { overrides = hashmap.New[renderKey, @renderEntry]() }
	var ent @renderEntry = make(renderEntry)
	ent.node = e
	ent.text = text
	overrides.Put(renderKeyAt(e, start, indent, tail), ent)
}

// printOverride writes the layout setOverride made e's at b's place, with tail
// bytes after it, reporting whether there was one.
func printOverride(b @strings.Builder, e @ast.Expr, tail int) bool {
	if overrides == nil { return false }
	var start int = lineWidth(b)
	var indent int = currentLineIndent(b)
	var got @renderEntry
	var ok bool
	got, ok = overrides.Get(renderKeyAt(e, start, indent, tail))
	if !ok || !same(got.node, e) { return false }
	// The text holds e's comments.  The decision that made it rendered e at this place,
	// under this comment cursor, and so claimed them: the printers around e skip
	// them.  (A cursor is put back only around a trial with wrapping suppressed,
	// whose renderings have keys of their own and make no overrides.)
	b.Write(got.text)
	return true
}

// textsEqual reports whether a and b hold the same bytes.
func textsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
