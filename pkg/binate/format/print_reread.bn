package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/lang"
import "pkg/std/containers/hashmap"
import "pkg/std/strings"

// A layout the printer chooses can carry breaks that a later format keeps as the
// author's -- an opener alone, a string run split across lines, a multi-line
// block, a wrapped list -- so a second format measures and prints the element
// with them.  To see what a second format makes of a rendering, the printer reads
// the rendering back (rereadExpr) and renders the result at a place
// (rereadRenderAt), as a second format would render it there, its own fill
// decisions checked in turn.  The element is read on its own, without the code
// around it, so this is close to a second format but not exact.  The fill
// decisions use it to keep to layouts a second format keeps (print_stable.bn).
//
// Such a layout can be one that no rendering of the element's own node gives --
// the breaks it has from being printed at another place -- so the printer can
// print a layout's text in place of the node (setOverride, printOverride).

// rereadExpr returns the file that the expression text (an element's rendering)
// parses to, as `var _ = (text)`, or nil when it does not parse.  The parentheses
// are the wrapper's: the expression is not marked parenthesized (only a binary
// operand prints by the mark, and a read-back expression is never one).
func rereadExpr(text *[]readonly char) @ast.File {
	var none @ast.File
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"p\"\nvar _ = (")
	sb.Write(text)
	sb.Write(")\n")
	var s @[]readonly char = sb.String()
	var src @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		src[i] = cast(uint8, s[i])
	}
	var pr @parser.Parser = parser.NewCollecting(src, "reread")
	var f @ast.File = pr.ParseFile()
	if len(pr.Errors()) > 0 || len(f.Decls) != 1 || f.Decls[0].Value == nil { return none }
	f.Decls[0].Value.Parenthesized = false
	return f
}

// rereadKey identifies a reading back (rereadRenderAt): the text, the column it is
// rendered from, its line's indent, what follows it, whether wrapping is
// suppressed, loneStays, and its depth in nested lists (depthKey).  An element's
// fill is decided at each place a rendering of what encloses it puts it, so the
// same layout is read back at the same place more than once.
type rereadKey struct {
	text       @[]readonly char
	start      int
	indent     int
	tail       int
	suppressed bool
	loneStays  bool
	depth      int
}

// Hash mixes the key's fields and the text's bytes.
func (a rereadKey) Hash() uint {
	var h uint = hashText(a.text)
	h = h * 31 + cast(uint, a.start)
	h = h * 31 + cast(uint, a.indent)
	h = h * 31 + cast(uint, a.tail)
	h = h * 31 + cast(uint, a.depth)
	if a.suppressed { h = h * 31 + 1 }
	if a.loneStays { h = h * 31 + 2 }
	return h
}

// Compare orders keys field by field, the texts byte by byte.
func (a rereadKey) Compare(b rereadKey) int {
	if a.start != b.start { return cmpInt(a.start, b.start) }
	if a.indent != b.indent { return cmpInt(a.indent, b.indent) }
	if a.tail != b.tail { return cmpInt(a.tail, b.tail) }
	if a.depth != b.depth { return cmpInt(a.depth, b.depth) }
	if a.suppressed != b.suppressed { return cmpBool(a.suppressed, b.suppressed) }
	if a.loneStays != b.loneStays { return cmpBool(a.loneStays, b.loneStays) }
	return cmpText(a.text, b.text)
}

impl rereadKey : lang.Hashable

// hashText mixes text's length and bytes.
func hashText(text *[]readonly char) uint {
	var h uint = cast(uint, len(text))
	for i := 0; i < len(text); i++ {
		h = h * 31 + cast(uint, text[i])
	}
	return h
}

// cmpText orders texts by length, then byte by byte.
func cmpText(a *[]readonly char, b *[]readonly char) int {
	if len(a) != len(b) { return cmpInt(len(a), len(b)) }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return cmpInt(cast(int, a[i]), cast(int, b[i])) }
	}
	return 0
}

// cmpBool orders false before true.
func cmpBool(a bool, b bool) int {
	if a == b { return 0 }
	if b { return -1 }
	return 1
}

// rereadEntry is a kept reading back: its rendering, and whether the text could
// be read back.
type rereadEntry struct {
	text @[]readonly char
	ok   bool
}

// rereads holds the readings back of the file being formatted.
var rereads @hashmap.Map[rereadKey, @rereadEntry]

// rereadFile is what a text read back parses to: its expression (nil when it does not
// parse) and its file's comment cursor and records, with the rendering cache, the
// overrides and the shapes (print_reread_shape.bn) of its nodes.  A text is read back
// at more than one place -- each enclosing rendering decides its fill at both of its
// places -- and its renderings share these, as a file's renderings do
// (print_rendermemo.bn): an element that prints at the same place under another
// place of the text is rendered once.
type rereadFile struct {
	expr      @ast.Expr
	cursor    @commentCursor
	openers   @[]@ast.BuiltinOpener
	sigs      @[]@ast.Signature
	heads     @[]@ast.Header
	cache     @hashmap.Map[renderKey, @renderEntry]
	overrides @hashmap.Map[renderKey, @renderEntry]
	ids       @hashmap.Map[nodeAt, int]
	deepIds   @hashmap.Map[nodeAt, int]
	// cids and cdeepIds are ids and deepIds for shapes with comments, and spans
	// the spans of the nodes numbered so (print_reread_cmts.bn).
	cids     @hashmap.Map[nodeAt, int]
	cdeepIds @hashmap.Map[nodeAt, int]
	spans    @hashmap.Map[nodeAt, @shapeSpan]
}

// activeReread is the reading back being rendered (nil for the file being formatted).
var activeReread @rereadFile

// rereadText is a text read back, as the key of what it parses to (rereadFile).
type rereadText struct {
	text @[]readonly char
}

// Hash mixes the text's bytes.
func (a rereadText) Hash() uint { return hashText(a.text) }

// Compare orders the texts byte by byte.
func (a rereadText) Compare(b rereadText) int { return cmpText(a.text, b.text) }

impl rereadText : lang.Hashable

// rereadFiles holds what the texts read back for the file being formatted parse to.
var rereadFiles @hashmap.Map[rereadText, @rereadFile]

// rereadFileOf returns what text parses to as an element read back (rereadExpr),
// parsing it the first time.
func rereadFileOf(text @[]readonly char) @rereadFile {
	if rereadFiles == nil { rereadFiles = hashmap.New[rereadText, @rereadFile]() }
	var key rereadText
	key.text = text
	var rf @rereadFile
	var have bool
	rf, have = rereadFiles.Get(key)
	if have { return rf }
	rf = make(rereadFile)
	rereadFiles.Put(key, rf)
	var f @ast.File = rereadExpr(text)
	if f == nil { return rf }
	rf.expr = f.Decls[0].Value
	rf.cursor = newCommentCursor(f.Comments)
	rf.openers = f.BuiltinOpeners
	rf.sigs = f.Signatures
	rf.heads = f.Headers
	rf.cache = hashmap.New[renderKey, @renderEntry]()
	rf.overrides = hashmap.New[renderKey, @renderEntry]()
	rf.ids = hashmap.New[nodeAt, int]()
	rf.deepIds = hashmap.New[nodeAt, int]()
	rf.cids = hashmap.New[nodeAt, int]()
	rf.cdeepIds = hashmap.New[nodeAt, int]()
	rf.spans = hashmap.New[nodeAt, @shapeSpan]()
	return rf
}

// rereadRenderAt returns an element printed as text -- a layout of orig, of the file
// being printed (nil for none) -- read back and rendered from column start of a line
// indented indent tabs with tail bytes after it, as a second format would render it
// there, and whether the text parsed.  It is rendered with its own file's comments,
// builtin, signature and header records, and its own rendering cache and overrides (its
// nodes' positions are its own file's), kept for every place it is rendered at
// (rereadFile); or, when it parses to orig's shape (sameShapeAs), as orig renders
// there.  Its fill decisions read their elements back in turn, smaller expressions
// each time.
func rereadRenderAt(text *[]readonly char, orig @ast.Expr, start int, indent int,
		tail int) (@[]readonly char, bool) {
	var empty @[]readonly char
	if rereads == nil { rereads = hashmap.New[rereadKey, @rereadEntry]() }
	var key rereadKey
	var tb @strings.Builder = strings.NewBuilder()
	tb.Write(text)
	key.text = tb.String()
	key.start = start
	key.indent = indent
	key.tail = tail
	key.suppressed = wrapSuppressed
	key.loneStays = loneStays
	key.depth = depthKey()
	var got @rereadEntry
	var have bool
	got, have = rereads.Get(key)
	if have { return got.text, got.ok }
	var ent @rereadEntry = make(rereadEntry)
	rereads.Put(key, ent)
	var rf @rereadFile = rereadFileOf(key.text)
	if rf.expr == nil { return empty, false }
	if orig != nil && sameShapeAs(rf, orig) {
		ent.text = renderAt(orig, start, indent, tail)
		ent.ok = true
		return ent.text, true
	}
	savedCache := renderCache
	var savedCursor @commentCursor = activeCursor
	var savedOpeners @[]@ast.BuiltinOpener = activeOpeners
	var savedSigs @[]@ast.Signature = activeSigs
	var savedHeads @[]@ast.Header = activeHeads
	savedHold := clearHold()
	savedOverrides := overrides
	var savedReread @rereadFile = activeReread
	activeReread = rf
	activeCursor = rf.cursor
	activeOpeners = rf.openers
	activeSigs = rf.sigs
	activeHeads = rf.heads
	renderCache = rf.cache
	overrides = rf.overrides
	var s @[]readonly char = renderAt(rf.expr, start, indent, tail)
	renderCache = savedCache
	activeCursor = savedCursor
	activeOpeners = savedOpeners
	activeSigs = savedSigs
	activeHeads = savedHeads
	claimHold = savedHold
	overrides = savedOverrides
	activeReread = savedReread
	ent.text = s
	ent.ok = true
	return s, true
}

// rereadItemAt is rereadRenderAt for a list element whose text starts with prefix
// bytes (a one-line key and what follows it, keyPrefix) before its value (a layout
// of orig), rendered after them: the value is read back and rendered after the
// prefix, and returned after it.
func rereadItemAt(text *[]readonly char, orig @ast.Expr, prefix int, start int, indent int,
		tail int) (@[]readonly char, bool) {
	if prefix == 0 { return rereadRenderAt(text, orig, start, indent, tail) }
	var r @[]readonly char
	var ok bool
	r, ok = rereadRenderAt(text[prefix:], orig, start + prefix, indent, tail)
	if !ok { return r, false }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(text[:prefix])
	sb.Write(r)
	return sb.String(), true
}

// overrides holds the layouts setOverride made elements', by node and place.
var overrides @hashmap.Map[renderKey, @renderEntry]

// dropOverrides forgets the readings back and the layouts setOverride made, for a
// new formatting.
func dropOverrides() {
	var none @hashmap.Map[renderKey, @renderEntry]
	overrides = none
	var noRereads @hashmap.Map[rereadKey, @rereadEntry]
	rereads = noRereads
	var noFiles @hashmap.Map[rereadText, @rereadFile]
	rereadFiles = noFiles
	dropShapes()
}

// setOverride makes text e's layout from column start of a line indented indent
// tabs with tail bytes after it: printExprTail prints it there in place of e.  A
// fill decision measures e through renderAt, whose cache keeps e's own rendering,
// so it decides the same each time.
func setOverride(e @ast.Expr, start int, indent int, tail int, text @[]readonly char) {
	if overrides == nil { overrides = hashmap.New[renderKey, @renderEntry]() }
	var ent @renderEntry = make(renderEntry)
	ent.node = e
	ent.text = text
	overrides.Put(renderKeyAt(e, start, indent, tail), ent)
}

// printOverride writes the layout setOverride made e's at b's place, with tail
// bytes after it, reporting whether there was one.
func printOverride(b @strings.Builder, e @ast.Expr, tail int) bool {
	if overrides == nil { return false }
	var start int = lineWidth(b)
	var indent int = currentLineIndent(b)
	var got @renderEntry
	var ok bool
	got, ok = overrides.Get(renderKeyAt(e, start, indent, tail))
	if !ok || !same(got.node, e) { return false }
	// The text holds e's comments.  The decision that made it rendered e at this place,
	// under this comment cursor, and so claimed them: the printers around e skip
	// them.  (A cursor is put back only around a trial with wrapping suppressed,
	// whose renderings have keys of their own and make no overrides.)
	b.Write(got.text)
	return true
}

// textsEqual reports whether a and b hold the same bytes.
func textsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
