package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/hashmap"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// A reading back with comments renders by shape too (shapeOf), its comments part of
// the shape: a node's shape spells out how many positions it has (its expressions',
// its types', its string run's parts', its builtin record's and its elements' `:`s)
// and each comment in its span -- from its first position to its last -- by its text,
// whether it starts its line, and where it and the tokens around it lie among those
// positions, with their lines relative to the node's.  Alike nodes then render alike,
// comments and all.  But a rendering also claims the comments it prints
// (claimComment), in its reading back's cursor, and a rendering shared from another
// reading back claimed them in that one's.  So a rendering made afresh records the
// claims it makes, each comment by its place in the node's span and each key by its
// place among the node's positions (endClaims), and one taken from the shared
// renderings makes the same claims in the reading back it is used in (replayClaims):
// the comments a node's rendering claims, and the keys it claims them by, follow from
// the node alone -- an enclosing gap takes only what the node leaves.  A rendering
// whose claims fall outside its node, or by a key that is none of its positions, is
// kept by node instead, as in a file, and so is an enclosing rendering that takes it
// from there (logUnplaced).

// shapeCmts holds the comments of the reading back whose shapes are being numbered
// with them (shapeOf), or none.
var shapeCmts @[]@token.Comment

// anchorAt is a position of a reading back, by its line and column.
type anchorAt struct {
	line int
	col  int
}

// shapeSpan is what a node of a reading back with comments spans: its positions, in
// source order, and the comments among them -- count of them, from first.
type shapeSpan struct {
	anchors @[]anchorAt
	first   int
	count   int
}

// anchorLess reports whether a comes before b.
func anchorLess(a anchorAt, b anchorAt) bool {
	if a.line != b.line { return a.line < b.line }
	return a.col < b.col
}

// pushAnchor adds pos to v, unless it is unset.
func pushAnchor(v @vec.Vec[anchorAt], pos token.Pos) {
	if pos.Line == 0 { return }
	var a anchorAt
	a.line = pos.Line
	a.col = pos.Col
	v.Push(a)
}

// spanOf returns the span of e, whose expressions have been numbered with comments:
// its positions -- its own, its types', its string run's parts', its builtin
// record's and its elements' `:`s, merged with its expressions' -- and the comments
// among them, keeping it in spans by node.
func spanOf(e @ast.Expr, openers *[]@ast.BuiltinOpener,
		spans @hashmap.Map[nodeAt, @shapeSpan]) @shapeSpan {
	var own @vec.Vec[anchorAt] = vec.New[anchorAt]()
	var kids @vec.Vec[@ast.Expr] = vec.New[@ast.Expr]()
	pushAnchor(own, e.Pos)
	for i := 0; i < len(e.StrParts); i++ { pushAnchor(own, e.StrParts[i].Pos) }
	addTypeAnchors(own, kids, e.TypeRef)
	if e.Kind == ast.EXPR_BUILTIN {
		var op @ast.BuiltinOpener = openerAt(openers, e.Pos)
		if op != nil {
			pushAnchor(own, op.LParen)
			pushAnchor(own, op.Sym)
			pushAnchor(own, op.Void)
			pushAnchor(own, op.Dots)
		}
	}
	for i := 0; i < len(e.Elems); i++ {
		pushAnchor(own, elementColon(e.Elems[i].Key, e.Elems[i].Value))
	}
	kids.Push(e.X)
	kids.Push(e.Y)
	kids.Push(e.Z)
	for i := 0; i < len(e.Args); i++ { kids.Push(e.Args[i]) }
	for i := 0; i < len(e.Elems); i++ {
		kids.Push(e.Elems[i].Key)
		kids.Push(e.Elems[i].Value)
	}
	var all @[]anchorAt = sortAnchors(own.Items())
	for i := 0; i < kids.Len(); i++ {
		var kid @ast.Expr = kids.Get(i)
		if kid == nil { continue }
		var ks @shapeSpan
		var have bool
		ks, have = spans.Get(nodeAtOf(kid))
		if have { all = mergeAnchors(all, ks.anchors) }
	}
	var sp @shapeSpan = make(shapeSpan)
	sp.anchors = all
	if len(all) == 0 {
		spans.Put(nodeAtOf(e), sp)
		return sp
	}
	sp.first = firstCommentFrom(all[0])
	var k int = sp.first
	for k < len(shapeCmts) && !anchorLess(all[len(all) - 1], anchorAtOf(shapeCmts[k].Pos)) {
		k = k + 1
	}
	sp.count = k - sp.first
	spans.Put(nodeAtOf(e), sp)
	return sp
}

// addTypeAnchors adds the positions of type t and the types in it to own, and its
// length expressions to kids.
func addTypeAnchors(own @vec.Vec[anchorAt], kids @vec.Vec[@ast.Expr], t @ast.TypeExpr) {
	if t == nil { return }
	pushAnchor(own, t.Pos)
	pushAnchor(own, t.End)
	if t.Len != nil { kids.Push(t.Len) }
	addTypeAnchors(own, kids, t.Base)
	for i := 0; i < len(t.ParamTypes); i++ { addTypeAnchors(own, kids, t.ParamTypes[i]) }
	for i := 0; i < len(t.ResultTypes); i++ { addTypeAnchors(own, kids, t.ResultTypes[i]) }
	for i := 0; i < len(t.TypeArgs); i++ { addTypeAnchors(own, kids, t.TypeArgs[i]) }
}

// anchorAtOf returns pos as an anchor.
func anchorAtOf(pos token.Pos) anchorAt {
	var a anchorAt
	a.line = pos.Line
	a.col = pos.Col
	return a
}

// sortAnchors returns as, a node's own few positions, in source order.
func sortAnchors(as *[]anchorAt) @[]anchorAt {
	var out @[]anchorAt = make_slice(anchorAt, len(as))
	for i := 0; i < len(as); i++ {
		var j int = i
		for j > 0 && anchorLess(as[i], out[j - 1]) {
			out[j] = out[j - 1]
			j = j - 1
		}
		out[j] = as[i]
	}
	return out
}

// mergeAnchors returns a and b, each in source order, merged.
func mergeAnchors(a *[]anchorAt, b *[]anchorAt) @[]anchorAt {
	var out @[]anchorAt = make_slice(anchorAt, len(a) + len(b))
	var i int = 0
	var j int = 0
	for k := 0; k < len(out); k++ {
		if j >= len(b) || i < len(a) && anchorLess(a[i], b[j]) {
			out[k] = a[i]
			i = i + 1
		} else {
			out[k] = b[j]
			j = j + 1
		}
	}
	return out
}

// firstCommentFrom returns the index of the first of shapeCmts not before a.
func firstCommentFrom(a anchorAt) int {
	var lo int = 0
	var hi int = len(shapeCmts)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if anchorLess(anchorAtOf(shapeCmts[mid].Pos), a) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return lo
}

// anchorRank returns the number of sp's positions before a, and whether a is one of
// them.
func anchorRank(sp @shapeSpan, a anchorAt) (int, bool) {
	var lo int = 0
	var hi int = len(sp.anchors)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if anchorLess(sp.anchors[mid], a) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	var at bool = lo < len(sp.anchors) && !anchorLess(a, sp.anchors[lo])
	return lo, at
}

// writeShapeComments writes the comments of span sp to sb, with their lines
// relative to base (none when the shape leaves out the lines, shapeNoLines): how
// many positions sp holds, as a claim's key is kept by its place among them (and
// past STABLE_LIST_DEPTH the shape leaves out a string run's parts, which are among
// them), then each comment's text, whether it starts its line, and where it and the
// tokens before and after it lie among sp's positions.
func writeShapeComments(sb @strings.Builder, sp @shapeSpan, base int) {
	sb.WriteByte('c')
	writeShapeInt(sb, len(sp.anchors))
	writeShapeInt(sb, sp.count)
	for k := sp.first; k < sp.first + sp.count; k++ {
		var c @token.Comment = shapeCmts[k]
		writeShapeText(sb, c.Text)
		writeShapeBool(sb,
				!isBlockComment(c) && c.OwnLine && (k == 0 || shapeCmts[k - 1].End.Line != c.Pos.Line))
		writeAnchorPlace(sb, sp, c.Pos, base)
		writeAnchorPlace(sb, sp, c.After, base)
		writeAnchorPlace(sb, sp, c.Before, base)
	}
}

// writeAnchorPlace writes where pos lies among sp's positions to sb, and its line
// relative to base.
func writeAnchorPlace(sb @strings.Builder, sp @shapeSpan, pos token.Pos, base int) {
	var rank int
	var at bool
	rank, at = anchorRank(sp, anchorAtOf(pos))
	writeShapeInt(sb, rank)
	writeShapeBool(sb, at)
	writeShapeLine(sb, pos, base)
}

// claimLog holds the claims made in claimLogCursor while renderings record them
// (startClaims): each comment's index and its key's line and column, or -1 for
// claims that cannot be logged (logUnplaced).
var claimLog @vec.Vec[int]

// claimLogCursor is the cursor whose claims are being recorded, or nil.
var claimLogCursor @commentCursor

// logClaim records the claim of comment k of cc by key, when cc's claims are being
// recorded (claimComment).
func logClaim(cc @commentCursor, k int, key token.Pos) {
	if claimLogCursor == nil || !same(cc, claimLogCursor) { return }
	claimLog.Push(k)
	claimLog.Push(key.Line)
	claimLog.Push(key.Col)
}

// logUnplaced makes the recording of the claims made in the reading back being
// rendered, if any, fail (endClaims): a rendering taken from the cache by node,
// whose claims had no places in its span, cannot log them again.
func logUnplaced() {
	if claimLogCursor == nil || !same(claimLogCursor, activeReread.cursor) { return }
	claimLog.Push(-1)
	claimLog.Push(0)
	claimLog.Push(0)
}

// claimMark is where a rendering's recording of its claims starts: the log's length
// then, and the cursor recorded before it.
type claimMark struct {
	at    int
	saved @commentCursor
}

// startClaims starts recording the claims a rendering in the reading back being
// rendered makes.
func startClaims() claimMark {
	if claimLog == nil { claimLog = vec.New[int]() }
	var m claimMark
	m.at = claimLog.Len()
	m.saved = claimLogCursor
	claimLogCursor = activeReread.cursor
	return m
}

// endClaims ends the recording m started of e's rendering and returns its claims,
// each a comment's place in e's span and its key's among e's positions, and whether
// all of them have such places.  A claim made again keeps its last key.  The log
// keeps the claims for an enclosing rendering's recording in the same cursor.
func endClaims(m claimMark, e @ast.Expr) (@[]int, bool) {
	var none @[]int
	var sp @shapeSpan
	var have bool
	sp, have = activeReread.spans.Get(nodeAtOf(e))
	var ok bool = have
	var last @[]int
	if have {
		last = make_slice(int, sp.count)
		for i := 0; i < sp.count; i++ { last[i] = -1 }
	}
	var n int = 0
	for i := m.at; ok && i < claimLog.Len(); i = i + 3 {
		var place int = claimLog.Get(i) - sp.first
		var key anchorAt
		key.line = claimLog.Get(i + 1)
		key.col = claimLog.Get(i + 2)
		var rank int
		var at bool
		rank, at = anchorRank(sp, key)
		if place < 0 || place >= sp.count || !at {
			ok = false
		} else {
			if last[place] < 0 { n = n + 1 }
			last[place] = rank
		}
	}
	if m.saved == nil || !same(m.saved, claimLogCursor) {
		for claimLog.Len() > m.at { _, _ = claimLog.Pop() }
	}
	claimLogCursor = m.saved
	if !ok { return none, false }
	var out @[]int = make_slice(int, 2 * n)
	var j int = 0
	for i := 0; i < len(last); i++ {
		if last[i] >= 0 {
			out[j] = i
			out[j + 1] = last[i]
			j = j + 2
		}
	}
	return out, true
}

// replayClaims makes claims, recorded of a rendering of a node of e's shape, in the
// reading back being rendered, for e.
func replayClaims(e @ast.Expr, claims *[]int) {
	if len(claims) == 0 { return }
	var sp @shapeSpan
	sp, _ = activeReread.spans.Get(nodeAtOf(e))
	if sp == nil { return }
	for i := 0; i < len(claims); i = i + 2 {
		var a anchorAt = sp.anchors[claims[i + 1]]
		var key token.Pos
		key.Line = a.line
		key.Col = a.col
		claimComment(activeReread.cursor, sp.first + claims[i], key)
	}
}
