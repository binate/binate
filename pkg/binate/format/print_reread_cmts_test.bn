package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// commentedNest returns a file whose one statement nests d calls, each spelled call,
// around a list whose last element is a chain the source breaks after its operator,
// with cmt (a comment, or nothing) between the operator and the break.
func commentedNest(d int, call *[]readonly char, cmt *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc f() {\n\tx := ")
	for i := 0; i < d; i++ { b.Write(call) }
	b.Write("kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk, (da ^")
	b.Write(cmt)
	b.Write("\n\t\t\td)")
	for i := 0; i < d; i++ { b.WriteByte(')') }
	b.Write("\n}\n")
	return b.String()
}

// rendersWithin adds to sb, as a failure, a nest whose renderings with a comment pass
// 5/4 of those without one.
func rendersWithin(sb @strings.Builder, name *[]readonly char, with int, without int) {
	if 4 * with <= 5 * without { return }
	if sb.Len() > 0 { sb.Write("; ") }
	sb.Write(name)
	sb.Write(": ")
	sb.Write(strconv.Itoa(with))
	sb.Write(" renderings with the comment, ")
	sb.Write(strconv.Itoa(without))
	sb.Write(" without")
}

// A comment inside nested calls costs about nothing in renderings: the readings back
// of the layouts that hold it share their renderings by shape, as those without
// comments do, and past STABLE_LIST_DEPTH a list's one-line form is measured by its
// elements' with the comments between them.  Calls nested 16 deep with a block comment
// in the innermost, and wrapping calls nested 6 deep with a block or a line comment,
// make at most 5/4 of the renderings they make without one.  With each reading back
// rendered afresh they make 2 to 4 times as many, and with the one-line forms past
// STABLE_LIST_DEPTH rendered at their columns the calls 16 deep make nearly 3 times.
func TestCommentedNestRendersAsUncommented() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	var deep int = rendersOf(commentedNest(16, "hh(", ""))
	rendersWithin(sb, "calls 16 deep", rendersOf(commentedNest(16, "hh(", " /* c */")), deep)
	var wide int = rendersOf(commentedNest(6, "hhhhhhhhhhhh(aaaaaaaa, ", ""))
	rendersWithin(sb, "wrapping calls 6 deep, a block comment",
			rendersOf(commentedNest(6, "hhhhhhhhhhhh(aaaaaaaa, ", " /* c */")), wide)
	rendersWithin(sb, "wrapping calls 6 deep, a line comment",
			rendersOf(commentedNest(6, "hhhhhhhhhhhh(aaaaaaaa, ", " // c")), wide)
	return buf.CopyStr(sb.String())
}

// deepShapeWithComments returns the shape, as numbered past STABLE_LIST_DEPTH and
// with its comments, of the expression text reads back to.
func deepShapeWithComments(text *[]readonly char) int {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(text)
	var rf @rereadFile = rereadFileOf(sb.String())
	var savedReread @rereadFile = activeReread
	var savedCmts @[]@token.Comment = shapeCmts
	activeReread = rf
	shapeCmts = rf.cursor.comments
	shapeNoLines = true
	var id int = numberShapes(rf.expr, rf.openers, rf.cdeepIds)
	shapeNoLines = false
	shapeCmts = savedCmts
	activeReread = savedReread
	return id
}

// Past STABLE_LIST_DEPTH a string run prints as one literal and its shape leaves out
// its parts, but their positions are among those a claim's key is kept by: string
// runs split at other places, before an operator a comment follows, give the
// enclosing chain another shape.  Laid out on other lines, it has the same shape.
func TestDeepShapeCountsStringParts() testing.TestResult {
	resetRenderCache()
	var a int = deepShapeWithComments("\"a\" \"b\" + \"cd\" + /* k */ y")
	var moved int = deepShapeWithComments("\"a\" \"b\" +\n\t\"cd\" + /* k */ y")
	var resplit int = deepShapeWithComments("\"ab\" + \"c\" \"d\" + /* k */ y")
	dropRenderCache()
	if a <= 0 || resplit <= 0 { return "a chain of string runs has a shape of its own" }
	if moved != a { return "a chain laid out on other lines has another shape" }
	if resplit == a { return "string runs split at other places leave the chain's shape alike" }
	return ""
}

// A rendering in a reading back with comments that is taken from the cache by node,
// where it is kept when its claims have no places in its span, makes the recording of
// an enclosing rendering's claims fail: the claims it made are not logged again.
func TestNodeCachedRenderingFailsRecording() testing.TestResult {
	resetRenderCache()
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("f(g(a), /* c */ b)")
	var rf @rereadFile = rereadFileOf(sb.String())
	var savedReread @rereadFile = activeReread
	var savedCursor @commentCursor = activeCursor
	activeReread = rf
	activeCursor = rf.cursor
	var inner @ast.Expr = rf.expr.Args[0]
	var ent @renderEntry = make(renderEntry)
	ent.node = inner
	ent.text = buf.CopyStr("kept by node")
	renderCache.Put(renderKeyAt(inner, 0, 0, 0), ent)
	var shaped bool = shapeOf(rf.expr) > 0
	var mark claimMark = startClaims()
	var got @[]readonly char = renderAt(inner, 0, 0, 0)
	var recorded bool
	_, recorded = endClaims(mark, rf.expr)
	activeCursor = savedCursor
	activeReread = savedReread
	dropRenderCache()
	if !shaped { return "the call has no shared shape" }
	if !streq(got, "kept by node") { return "the rendering was not taken from the cache by node" }
	if recorded {
		return "the enclosing rendering's recording left out the claims of one kept by node"
	}
	return ""
}
