package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/lang"
import "pkg/std/containers/hashmap"
import "pkg/std/strings"

// A layout read back parses to new nodes, rendered afresh at each place it is read
// back at, and the elements in it afresh in turn.  But the nodes are often alike: a
// layout keeps the breaks of the element's source wherever the element lays out as
// written, as a formatted file's elements do, and the layouts of an element read
// back at two places differ only where they break differently.  Alike nodes render
// alike: the printer reads a node's position only to compare its line with other
// positions' and to order it among comments, and finds a builtin call's record by
// its position.  So an expression's shape -- its kind, its name, operator, literals
// and the flags the parser sets, its children's shapes, and each position's line
// relative to its own, its builtin record's included -- is numbered (numberShapes):
//
//   - a reading back is rendered by shape, from renderings shared by every reading
//     back (shapeRenders, shapeOf) -- with comments, its shapes spell them out and
//     a shared rendering's claims are made again (print_reread_cmts.bn) -- and
//   - one that parses to the shape of the element it is a layout of renders as the
//     element does (sameShapeAs, rereadRenderAt).
//
// An expression holding what the printer finds through other records (a function
// literal, with its signature, or a function type) or a struct type has a shape of
// its own, shared with no other.

// nodeAt identifies a node of a parsed file by its kind and position: no two nodes
// of a file share them.
type nodeAt struct {
	kind int
	line int
	col  int
}

// Hash mixes the fields.
func (a nodeAt) Hash() uint {
	var h uint = cast(uint, a.line)
	h = h * 31 + cast(uint, a.col)
	return h * 31 + cast(uint, a.kind)
}

// Compare orders by line, column, then kind.
func (a nodeAt) Compare(b nodeAt) int {
	if a.line != b.line { return cmpInt(a.line, b.line) }
	if a.col != b.col { return cmpInt(a.col, b.col) }
	return cmpInt(a.kind, b.kind)
}

impl nodeAt : lang.Hashable

// nodeAtOf returns e's nodeAt.
func nodeAtOf(e @ast.Expr) nodeAt {
	var k nodeAt
	k.kind = e.Kind
	k.line = e.Pos.Line
	k.col = e.Pos.Col
	return k
}

// shapeIds numbers the shapes of the file being formatted and its readings back, by
// the text that spells each one out (numberShapes).
var shapeIds @hashmap.Map[rereadText, int]

// shapeFresh counts down the ids of the expressions whose shapes are their own.
var shapeFresh int

// fileShapes holds the shapes of the file being formatted's own nodes, numbered as
// a reading back is compared with one (sameShapeAs).
var fileShapes @hashmap.Map[nodeAt, int]

// shapeRenders holds the renderings of the shapes read back, shared by every
// reading back (shapeOf).
var shapeRenders @hashmap.Map[renderKey, @renderEntry]

// dropShapes forgets the shapes and their renderings, for a new formatting.
func dropShapes() {
	var noIds @hashmap.Map[rereadText, int]
	shapeIds = noIds
	shapeFresh = 0
	var noShapes @hashmap.Map[nodeAt, int]
	fileShapes = noShapes
	var noRenders @hashmap.Map[renderKey, @renderEntry]
	shapeRenders = noRenders
}

// shapeOf returns the shape of e, a node of the reading back being rendered, to key
// its renderings by, or 0 to key them by node: in the file being formatted, under a
// cursor other than its reading back's (a function literal's body's, whose renderings
// claim its comments there), and for a shape of its own.  A reading back's comments
// are part of its shapes (shapeCmts), numbered with ids of their own, as sameShapeAs
// numbers the same nodes without them.  Past STABLE_LIST_DEPTH nested lists, where
// the printer lays out by width alone (print_deep.bn), the shape leaves out its
// positions' lines (shapeNoLines): there a layout read back at any place renders as
// every other layout of the same node does, and they share their renderings.
func shapeOf(e @ast.Expr) int {
	if activeReread == nil { return 0 }
	var ids @hashmap.Map[nodeAt, int] = activeReread.ids
	var deepIds @hashmap.Map[nodeAt, int] = activeReread.deepIds
	var saved @[]@token.Comment = shapeCmts
	if activeReread.cursor != nil {
		if !same(activeCursor, activeReread.cursor) { return 0 }
		ids = activeReread.cids
		deepIds = activeReread.cdeepIds
		shapeCmts = activeReread.cursor.comments
	}
	var id int
	if deepList() {
		shapeNoLines = true
		id = numberShapes(e, activeReread.openers, deepIds)
		shapeNoLines = false
	} else {
		id = numberShapes(e, activeReread.openers, ids)
	}
	shapeCmts = saved
	if id < 0 { return 0 }
	return id
}

// shapeNoLines reports whether the shapes being numbered leave out their positions'
// lines (shapeOf).
var shapeNoLines bool

// sameShapeAs reports whether rf, a reading back without comments, parses to the
// shape of orig, a node of the file being printed: the file being formatted, or the
// reading back being rendered.
func sameShapeAs(rf @rereadFile, orig @ast.Expr) bool {
	if rf.cursor != nil { return false }
	var id int = numberShapes(rf.expr, rf.openers, rf.ids)
	if id <= 0 { return false }
	if activeReread != nil {
		return numberShapes(orig, activeReread.openers, activeReread.ids) == id
	}
	if fileShapes == nil { fileShapes = hashmap.New[nodeAt, int]() }
	return numberShapes(orig, activeOpeners, fileShapes) == id
}

// numberShapes returns the shape of e (0 for nil, negative for a shape of its own),
// numbering it and those of the expressions in it the first time, and keeping each
// in ids by node.  openers holds the builtin records of e's file.
func numberShapes(e @ast.Expr, openers *[]@ast.BuiltinOpener, ids @hashmap.Map[nodeAt, int]) int {
	if e == nil { return 0 }
	var id int
	var have bool
	id, have = ids.Get(nodeAtOf(e))
	if have { return id }
	var sb @strings.Builder = strings.NewBuilder()
	var shared bool = e.Kind != ast.EXPR_FUNC_LIT && e.DeclRef == nil
	if shapeNoLines { sb.WriteByte('D') }
	writeShapeInt(sb, e.Kind)
	writeShapeText(sb, e.Name)
	writeShapeInt(sb, e.Op)
	writeShapeInt(sb, e.CFixedArgs)
	writeShapeBool(sb, e.BoolVal)
	writeShapeBool(sb, e.Spread)
	writeShapeBool(sb, e.Parenthesized)
	writeShapeBool(sb, e.CVariadic)
	var base int = e.Pos.Line
	shared = writeShapeChild(sb, e.X, base, openers, ids) && shared
	shared = writeShapeChild(sb, e.Y, base, openers, ids) && shared
	shared = writeShapeChild(sb, e.Z, base, openers, ids) && shared
	writeShapeInt(sb, len(e.Args))
	for i := 0; i < len(e.Args); i++ {
		shared = writeShapeChild(sb, e.Args[i], base, openers, ids) && shared
	}
	writeShapeInt(sb, len(e.Elems))
	for i := 0; i < len(e.Elems); i++ {
		shared = writeShapeChild(sb, e.Elems[i].Key, base, openers, ids) && shared
		shared = writeShapeChild(sb, e.Elems[i].Value, base, openers, ids) && shared
	}
	shared = writeTypeShape(sb, e.TypeRef, base, openers, ids) && shared
	// A run is printed as one literal where the shape leaves out the lines.
	if !shapeNoLines {
		writeShapeInt(sb, len(e.StrParts))
		for i := 0; i < len(e.StrParts); i++ {
			writeShapeText(sb, e.StrParts[i].Lit)
			writeShapeLine(sb, e.StrParts[i].Pos, base)
		}
	}
	if e.Kind == ast.EXPR_BUILTIN { writeOpenerShape(sb, openerAt(openers, e.Pos), base) }
	if len(shapeCmts) > 0 {
		writeShapeComments(sb, spanOf(e, openers, activeReread.brackets, activeReread.spans), base)
	}
	if shared {
		id = shapeIdOf(sb.String())
	} else {
		shapeFresh = shapeFresh - 1
		id = shapeFresh
	}
	ids.Put(nodeAtOf(e), id)
	return id
}

// writeShapeChild numbers child (numberShapes) and writes its shape, and its line
// relative to base, to sb, reporting whether the shape is shared.
func writeShapeChild(sb @strings.Builder, child @ast.Expr, base int, openers *[]@ast.BuiltinOpener,
		ids @hashmap.Map[nodeAt, int]) bool {
	var id int = numberShapes(child, openers, ids)
	writeShapeInt(sb, id)
	if child != nil { writeShapeLine(sb, child.Pos, base) }
	return id >= 0
}

// writeTypeShape writes type expression t's shape to sb, its positions' lines
// relative to base, reporting whether it is shared (not a struct or function type,
// nor holding one).
func writeTypeShape(sb @strings.Builder, t @ast.TypeExpr, base int, openers *[]@ast.BuiltinOpener,
		ids @hashmap.Map[nodeAt, int]) bool {
	if t == nil {
		sb.WriteByte('n')
		return true
	}
	var shared bool = t.Kind != ast.TEXPR_STRUCT && t.Kind != ast.TEXPR_FUNC_VALUE &&
			t.Kind != ast.TEXPR_MANAGED_FUNC_VALUE && len(t.Fields) == 0
	writeShapeInt(sb, t.Kind)
	writeShapeLine(sb, t.Pos, base)
	writeShapeLine(sb, t.End, base)
	writeShapeText(sb, t.Name)
	writeShapeText(sb, t.Pkg)
	writeShapeBool(sb, t.LenInferred)
	writeShapeBool(sb, t.VariadicParams)
	shared = writeTypeShape(sb, t.Base, base, openers, ids) && shared
	shared = writeShapeChild(sb, t.Len, base, openers, ids) && shared
	shared = writeTypeShapes(sb, t.ParamTypes, base, openers, ids) && shared
	shared = writeTypeShapes(sb, t.ResultTypes, base, openers, ids) && shared
	return writeTypeShapes(sb, t.TypeArgs, base, openers, ids) && shared
}

// writeTypeShapes is writeTypeShape for a list of type expressions.
func writeTypeShapes(sb @strings.Builder, ts *[]@ast.TypeExpr, base int,
		openers *[]@ast.BuiltinOpener, ids @hashmap.Map[nodeAt, int]) bool {
	writeShapeInt(sb, len(ts))
	var shared bool = true
	for i := 0; i < len(ts); i++ {
		shared = writeTypeShape(sb, ts[i], base, openers, ids) && shared
	}
	return shared
}

// writeOpenerShape writes builtin record op's positions' lines relative to base to
// sb, or a mark for none.
func writeOpenerShape(sb @strings.Builder, op @ast.BuiltinOpener, base int) {
	if op == nil {
		sb.WriteByte('n')
		return
	}
	writeShapeLine(sb, op.LParen, base)
	writeShapeLine(sb, op.Sym, base)
	writeShapeLine(sb, op.Void, base)
	writeShapeLine(sb, op.Dots, base)
}

// shapeIdOf returns the shape spelled text, numbering it the first time.
func shapeIdOf(text @[]readonly char) int {
	if shapeIds == nil { shapeIds = hashmap.New[rereadText, int]() }
	var key rereadText
	key.text = text
	var id int
	var have bool
	id, have = shapeIds.Get(key)
	if have { return id }
	id = shapeIds.Len() + 1
	shapeIds.Put(key, id)
	return id
}

// writeShapeInt writes n and a separator to sb.
func writeShapeInt(sb @strings.Builder, n int) {
	if n < 0 {
		sb.WriteByte('-')
		n = -n
	}
	var digits [20]char
	var k int = 0
	for {
		digits[k] = '0' + cast(char, n % 10)
		k = k + 1
		n = n / 10
		if n == 0 { break }
	}
	for k > 0 {
		k = k - 1
		sb.WriteByte(digits[k])
	}
	sb.WriteByte(',')
}

// writeShapeText writes text, after its length, to sb.
func writeShapeText(sb @strings.Builder, text *[]readonly char) {
	writeShapeInt(sb, len(text))
	sb.Write(text)
}

// writeShapeBool writes b to sb.
func writeShapeBool(sb @strings.Builder, b bool) {
	if b { sb.WriteByte('t') } else { sb.WriteByte('f') }
}

// writeShapeLine writes pos's line relative to base to sb, or a mark for an unset
// position; nothing when the shape leaves out the lines (shapeNoLines).
func writeShapeLine(sb @strings.Builder, pos token.Pos, base int) {
	if shapeNoLines { return }
	if pos.Line == 0 {
		sb.WriteByte('u')
		return
	}
	writeShapeInt(sb, pos.Line - base)
}
