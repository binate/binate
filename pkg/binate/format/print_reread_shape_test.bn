package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/reflect"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the shapes of expressions read back (print_reread_shape.bn).

// rootShape returns the shape of the expression text reads back to.
func rootShape(text *[]readonly char) int {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(text)
	var rf @rereadFile = rereadFileOf(sb.String())
	return numberShapes(rf.expr, rf.openers, rf.ids)
}

// Layouts of an expression that differ only in their lines' indents have one
// shape, shared: their nodes differ only in their columns.
func TestShapeIgnoresIndents() testing.TestResult {
	resetRenderCache()
	var a int = rootShape("f(a,\n\t\tb)")
	var b int = rootShape("f(a,\n\t\t\t\tb)")
	dropRenderCache()
	if a <= 0 || a != b { return "layouts differing only in their indents have different shapes" }
	return ""
}

// Layouts that break differently, or hold other names or literals, have other
// shapes; a builtin call's record is part of its shape (the symbol of `__c_call`
// has its position only there).
func TestShapeKeepsLinesAndNames() testing.TestResult {
	resetRenderCache()
	var oneLine int = rootShape("f(a, b)")
	var broken int = rootShape("f(a,\n\tb)")
	var renamed int = rootShape("f(a, c)")
	var merged int = rootShape("f(\"x\" \"y\")")
	var split int = rootShape("f(\"x\"\n\t\"y\")")
	var symFirst int = rootShape("__c_call(\"sym\",\n\tint)")
	var symBelow int = rootShape("__c_call(\n\t\"sym\", int)")
	dropRenderCache()
	if oneLine == broken { return "a break leaves the shape alike" }
	if oneLine == renamed { return "a name leaves the shape alike" }
	if merged == split { return "a string run's break leaves the shape alike" }
	if symFirst == symBelow { return "a builtin record's line leaves the shape alike" }
	return ""
}

// An expression holding a function literal has a shape of its own, even beside a
// layout that differs only in its indents: the printer finds the literal's signature
// through a record of its own file.
func TestShapeOwnForFuncLit() testing.TestResult {
	resetRenderCache()
	var a int = rootShape("f(a,\n\t\tfunc() {})")
	var b int = rootShape("f(a,\n\t\t\t\tfunc() {})")
	dropRenderCache()
	if a >= 0 || b >= 0 || a == b { return "a function literal's enclosing call has a shared shape" }
	return ""
}

// A layout read back that parses to the element's own shape renders as the element
// does, from its rendering cache: nothing is rendered afresh.
func TestRereadOwnShapeIsElement() testing.TestResult {
	resetRenderCache()
	var e @ast.Expr = parseExprSrc("f(aaaa, bbbb)")
	var text @[]readonly char = renderAt(e, 8, 1, 0)
	var want @[]readonly char = renderAt(e, 20, 1, 0)
	var before int = renderCount
	var got @[]readonly char
	var ok bool
	got, ok = rereadRenderAt(text, e, 20, 1, 0)
	var made int = renderCount - before
	dropRenderCache()
	if !ok { return "the layout did not read back" }
	if made != 0 { return "reading back the element's own shape rendered it afresh" }
	if !streq(got, want) { return goldenDiff(got, want) }
	return ""
}

// Layouts that differ only in their lines' indents, read back at one place, are
// rendered once: the second is rendered from the first's renderings, by shape.
func TestRereadSharesShapes() testing.TestResult {
	resetRenderCache()
	var a @[]readonly char
	var b @[]readonly char
	var okA bool
	var okB bool
	a, okA = rereadRenderAt("f(aaaa,\n\t\tbbbb)", nil, 4, 1, 0)
	var before int = renderCount
	b, okB = rereadRenderAt("f(aaaa,\n\t\t\t\tbbbb)", nil, 4, 1, 0)
	var made int = renderCount - before
	dropRenderCache()
	if !okA || !okB { return "a layout did not read back" }
	if made != 0 { return "a layout of a shape read back before was rendered afresh" }
	if !streq(a, b) { return goldenDiff(b, a) }
	return ""
}

// A text read back at two places is parsed once: its renderings share its nodes.
func TestRereadFileParsedOnce() testing.TestResult {
	resetRenderCache()
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("f(a,\n\tb)")
	var a @rereadFile = rereadFileOf(sb.String())
	var b @rereadFile = rereadFileOf(sb.String())
	dropRenderCache()
	if !same(a, b) { return "a text read back again was parsed again" }
	return ""
}

// typeFields returns the names of the fields of the struct boxed in x,
// space-separated, in declaration order.
func typeFields(x *any) @[]readonly char {
	var ti *reflect.TypeInfo = reflect.TypeOf(x)
	var sb @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(ti.Fields); i++ {
		sb.Write(ti.Fields[i].Name)
		sb.WriteByte(' ')
	}
	return sb.String()
}

// A shape spells out every field the parser sets in an expression, a type
// expression, a composite element, a string part and a builtin record
// (numberShapes); the rest are the checker's.  A field added to one of them needs a
// place in the shape, or two layouts that differ in it would render alike.
func TestShapeFieldsPinned() testing.TestResult {
	var e ast.Expr
	var te ast.TypeExpr
	var el ast.Element
	var sp ast.StrPart
	var op ast.BuiltinOpener
	var got @[]@[]readonly char = make_slice(@[]readonly char, 5)
	got[0] = typeFields(&e)
	got[1] = typeFields(&te)
	got[2] = typeFields(&el)
	got[3] = typeFields(&sp)
	got[4] = typeFields(&op)
	var want @[]*[]readonly char = make_slice(*[]readonly char, 5)
	want[0] = "Kind Pos Name BoolVal Op X Y Z Args TypeRef Elems DeclRef ResolvedTypeID CFixedArgs "
			"CVariadic Spread Unchecked StrParts Parenthesized ImplicitAddr LitAddressed BorrowTemp "
			"FieldSel PredeclaredPanic ViaConstraint DenotedTypeID "
	want[1] = "Kind Pos End Name Pkg Base Len Fields LenVal LenKnown LenInferred ParamTypes "
			"ResultTypes VariadicParams TypeArgs DenotedTypeID "
	want[2] = "Key Value KeyVal KeyKnown "
	want[3] = "Lit Pos "
	want[4] = "Pos LParen Sym Void Dots "
	for i := 0; i < len(want); i++ {
		if !streq(got[i], want[i]) {
			return "an AST node type's fields changed: give the field a place in the shape"
		}
	}
	return ""
}
