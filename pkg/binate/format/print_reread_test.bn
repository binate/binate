package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for reading a rendering back (print_reread.bn).

// A layout read back is rendered with its own file's records of the builtin calls:
// `__c_call(` alone above its symbol stays alone there, as a second format keeps
// it.  Without the records, the symbol would count as on the keyword's line.
func TestRereadBuiltinOpenerAlone() testing.TestResult {
	var got @[]readonly char
	var ok bool
	got, ok = rereadRenderAt("__c_call(\n\t\t\t\"sym\", int)", 1, 1, 0)
	if !ok { return "the text did not read back" }
	var want *[]readonly char = "__c_call(\n\t\t\t\"sym\", int)"
	if !streq(got, want) { return goldenDiff(got, want) }
	return ""
}
