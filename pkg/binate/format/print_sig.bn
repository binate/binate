package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// A function's signature -- a declaration's, an interface method's or a function
// literal's -- prints the comments inside it where the source put them: between
// its own tokens (after `func`, around the name and the receiver, between the
// parameters' `)` and the results, after the results), in its lists (after the
// opener, between the elements and before the close) and between a parameter's
// name and its type.  It claims them by position, as a list does
// (print_listcomments.bn), so each rendering prints them again, and so the body
// does not take them as its own.  The positions of its delimiters come from the
// parser's record of the signature (ast.File.Signatures).  A comment inside a
// parameter's or a result's type, which no type printer places, goes in the list's
// gap after the type, as in any list.  Where what follows must continue the line
// -- after the name, a `)`, a `]` or a type, and before a result list's `)`, which
// takes no trailing comma -- the comments stay on it, and only block comments on
// one line can (claimInlineGap): a line comment there, which only a type can hold
// (`*// c`), is left pending with the comments beside it and the signature's later
// ones (claimHeldGap), for the body's first line or the line after a signature
// with none.

// activeSigs holds the signatures' records of the file being formatted
// (ast.File.Signatures), in source order; empty outside Format, and for a file
// parsed without comments.
var activeSigs @[]@ast.Signature

// signatureOf returns the record of the signature of the declaration at pos (its
// Pos), or, when there is none, one of zero positions, which places no comment.
func signatureOf(pos token.Pos) @ast.Signature {
	var lo int = 0
	var hi int = len(activeSigs)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if posLess(activeSigs[mid].Pos, pos) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < len(activeSigs) && samePos(activeSigs[lo].Pos, pos) { return activeSigs[lo] }
	return make(ast.Signature)
}

// printFuncSig appends a function/method signature (no body):
// `func [(recv)] Name[typeparams](params) results`, followed on its line by tail
// bytes when there is no body, and by what the body prints there when there is one,
// tail being what follows the body (funcBodyLen).
func printFuncSig(b @strings.Builder, d @ast.Decl, tail int) {
	var after int = tail
	if d.Body != nil { after = funcBodyLen(d, tail) }
	printFuncSigAfter(b, d, after)
}

// printFuncSigAfter is printFuncSig for a signature followed on its last line by
// after bytes.  The signature's own gaps are claimed with its `(` as their key,
// which no list's is.
func printFuncSigAfter(b @strings.Builder, d @ast.Decl, after int) {
	var rec @ast.Signature = signatureOf(d.Pos)
	var key token.Pos = rec.Open
	var cont int = currentLineIndent(b) + 2
	var savedHold token.Pos = clearHold()
	b.Write("func")
	if d.Recv != nil {
		writeGapSeparator(b, claimGap(d.Pos, rec.RecvOpen, key), cont, false, true)
		printReceiver(b, d.Recv, rec, cont)
		_ = writeInlineComments(b, claimHeldGap(rec.RecvClose, rec.Name, key))
		b.WriteByte(' ')
	} else {
		writeGapSeparator(b, claimGap(d.Pos, rec.Name, key), cont, false, true)
	}
	b.Write(d.Name)
	var lo token.Pos = rec.Name
	if len(d.TypeParams) > 0 {
		if writeInlineComments(b, claimHeldGap(rec.Name, rec.TypeOpen, key)) { b.WriteByte(' ') }
		printSigTypeParams(b, d.TypeParams, rec, cont)
		lo = rec.TypeClose
	}
	if writeInlineComments(b, claimHeldGap(lo, rec.Open, key)) { b.WriteByte(' ') }
	var next token.Pos
	if d.Body != nil { next = d.Body.Pos }
	printSigLists(b, d.Params, d.Results, rec, d.Pos.Line, next, after)
	claimHold = savedHold
}

// funcBodyLen returns the byte width that declaration d's body adds on the last line
// of its signature, tail being what follows the body: ` {}` and the tail when the
// body prints empty (emptyBody) and the signature leaves it no comment, ` {` and
// the comments after it on its line otherwise, when room for them can help
// (braceTail; a body printed on one line, `{ s }`, checks its own width).  The
// signature leaves its body comments only when a gap that must continue the line
// holds one that is not a block comment on one line -- with it, those that follow
// it in the signature (claimHeldGap) -- so it is rendered on trial only when it has
// such a comment.
func funcBodyLen(d @ast.Decl, tail int) int {
	if !emptyBody(d.Body) {
		return withTrail(2, braceTrailWidth(activeCursor, d.Body.Pos, blockStart(d.Body)), 2)
	}
	var cc @commentCursor = activeCursor
	if cc == nil { return 3 + tail }
	var lo int = firstAfter(cc, d.Pos)
	var hi int = lo
	var breaking bool = false
	for hi < len(cc.comments) && posLess(cc.comments[hi].Pos, d.Body.Pos) {
		var c @token.Comment = cc.comments[hi]
		if notEmitted(cc, hi) && (!isBlockComment(c) || hasNewline(c.Text)) { breaking = true }
		hi = hi + 1
	}
	if !breaking { return 3 + tail }
	var trial @strings.Builder = strings.NewBuilder()
	printFuncSigAfter(trial, d, 2)
	for k := lo; k < hi; k++ {
		if k >= cc.idx && !isDone(cc, k) { return 2 }
	}
	return 3 + tail
}

// emptyBody reports whether a function body has nothing of its own to print, so
// that it prints `{}`: no statement it prints (printedStmts), and no comment of
// activeCursor that the cursor has not emitted (those a function literal's body
// takes, innerCursor).  A declaration's body also prints the comments its
// signature leaves it (funcBodyLen).
func emptyBody(blk @ast.Stmt) bool {
	if len(printedStmts(blk.Stmts)) > 0 { return false }
	var cc @commentCursor = activeCursor
	if cc == nil { return true }
	var k int = firstAfter(cc, blk.Pos)
	for k < len(cc.comments) && posLess(cc.comments[k].Pos, blk.End) {
		if notEmitted(cc, k) { return false }
		k = k + 1
	}
	return true
}

// clearHold clears claimHold for the printing of a signature, or of another file
// (rereadRenderAt), returning the hold to put back when it is done.
func clearHold() token.Pos {
	var saved token.Pos = claimHold
	var none token.Pos
	claimHold = none
	return saved
}

// printReceiver appends a method's receiver `(r T)`, with the comments after its
// `(`, between its name and its type, and those inside its type and after it,
// which go before its `)` (it takes no trailing comma).
func printReceiver(b @strings.Builder, recv @ast.ParamDecl, rec @ast.Signature, cont int) {
	b.WriteByte('(')
	writeGapSeparator(b, claimGap(rec.RecvOpen, recv.Pos, rec.Open), cont, true, false)
	printParamDecl(b, recv)
	_ = writeInlineComments(b, claimHeldGap(recv.Pos, rec.RecvClose, rec.Open))
	b.WriteByte(')')
}

// printMethodSig appends an interface method signature `Name(params) results` --
// like a function signature but with no `func` keyword, receiver, or type
// parameters (generic methods are out of scope) -- followed on its last line by
// tail bytes.
func printMethodSig(b @strings.Builder, m @ast.Decl, tail int) {
	var rec @ast.Signature = signatureOf(m.Pos)
	var savedHold token.Pos = clearHold()
	b.Write(m.Name)
	if writeInlineComments(b, claimHeldGap(rec.Name, rec.Open, rec.Open)) { b.WriteByte(' ') }
	var none token.Pos
	printSigLists(b, m.Params, m.Results, rec, m.Pos.Line, none, tail)
	claimHold = savedHold
}

// printSigTypeParams appends a function's type-parameter list `[T any, U any]`,
// with the comments after its `[`, between its entries, between an entry's name
// and its constraint, and before its `]` (writeCloserGap: a line comment there
// after a trailing comma); a line comment before an entry puts the entry at the
// start of a line at cont.
func printSigTypeParams(b @strings.Builder, tps @[]@ast.TypeParam, rec @ast.Signature, cont int) {
	var key token.Pos = rec.TypeOpen
	var base int = currentLineIndent(b)
	b.WriteByte('[')
	var lo token.Pos = rec.TypeOpen
	for i := 0; i < len(tps); i++ {
		if i > 0 { b.WriteByte(',') }
		writeGapSeparator(b, claimGap(lo, tps[i].Pos, key), cont, i == 0, i > 0)
		b.Write(tps[i].Name)
		if tps[i].Constraint != nil {
			var cs token.Pos = typeStartPos(tps[i].Constraint)
			_ = writeInlineComments(b, claimInlineGap(tps[i].Pos, cs, cs))
			b.WriteByte(' ')
			printType(b, tps[i].Constraint)
		}
		lo = tps[i].Pos
	}
	writeCloserGap(b, claimGap(lo, rec.TypeClose, key), true, cont, base, 1)
	b.WriteByte(']')
}

// printSigLists appends a signature's parameter list and what follows it: the
// comments before its results, the results, and, when next (the `{` of a body) is
// given, the comments before it -- followed on the last line by after bytes.  line
// is the signature's first line, taken as its `(`'s when the parser recorded none.
func printSigLists(b @strings.Builder, params @[]@ast.ParamDecl, results @[]@ast.TypeExpr,
		rec @ast.Signature, line int, next token.Pos, after int) {
	var openerLine int = line
	if rec.Open.Line > 0 { openerLine = rec.Open.Line }
	printParamList(b, params, openerLine, rec, sigTailLen(rec, results, next, after))
	printSigResults(b, rec, results, next, after)
}

// printParamDecl appends one parameter `Name Type`, or `Name ...Type` when
// variadic (Type is the element type as written), with the block comments between
// its name and its type there (claimInlineGap, keyed by the type's start) -- before
// the `...`, whose position the AST does not keep, those after it included.
func printParamDecl(b @strings.Builder, pd @ast.ParamDecl) {
	b.Write(pd.Name)
	if pd.Type != nil {
		var ts token.Pos = typeStartPos(pd.Type)
		_ = writeInlineComments(b, claimInlineGap(pd.Pos, ts, ts))
	}
	b.WriteByte(' ')
	if pd.Variadic { b.Write("...") }
	printType(b, pd.Type)
}

// printParamList emits a parenthesized parameter list `(a A, b B)`, wrapping it
// fill-style when the source wrapped it or it would exceed the width cap, with the
// comments in it (printStrList), those before its `)` included: it takes a
// trailing comma, so a line comment there can go after one (writeCloserGap).  An
// empty one keeps the comments between its parentheses.  openerLine is the source
// line of its `(`; suffixLen reserves room for what follows `)` on that line (the
// results, and a body-opening ` {`).
func printParamList(b @strings.Builder, params @[]@ast.ParamDecl, openerLine int,
		rec @ast.Signature, suffixLen int) {
	if len(params) == 0 {
		var base int = currentLineIndent(b)
		b.WriteByte('(')
		if writeGapComments(b, claimGap(rec.Open, rec.Close, rec.Open), base + 2, true) {
			b.WriteByte('\n')
			writeIndent(b, base)
		}
		b.WriteByte(')')
		return
	}
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	// The items render as they print, one list deeper (listDepth).
	listDepth = listDepth + 1
	for i := 0; i < len(params); i++ {
		items.Push(paramItem(params[i]))
	}
	listDepth = listDepth - 1
	var closing @[]@token.Comment = claimGap(params[len(params) - 1].Pos, rec.Close,
			listKey(items.Items()))
	printStrList(b, '(', ')', items.Items(), openerLine, rec.Open, closing, true, suffixLen)
}

// sigTailLen returns the byte width of what a signature emits after its parameter
// list's `)` on that line (printSigResults): the comments and results, plus the
// after bytes that follow them (` {` when a body follows, the comments after a
// signature with none), or the first line of what spans several (a struct type, a
// wrapped result list), which those do not follow.  Used to reserve room so the
// last wrapped parameter's line does not overflow.
func sigTailLen(rec @ast.Signature, results @[]@ast.TypeExpr, next token.Pos, after int) int {
	var sb @strings.Builder = strings.NewBuilder()
	printSigResults(sb, rec, results, next, 0)
	var s @[]readonly char = sb.String()
	if hasNewline(s) { return firstLineLen(s) }
	return len(s) + after
}

// printSigResults appends what follows a signature's parameter list, followed on
// its last line by tail bytes: the comments between its `)` and the results, the
// results -- nothing for none, ` T` for a single result (whose parentheses, when
// written, go), ` (T1, T2)` for two or more, wrapped fill-style when they would
// exceed the width cap with the tail after them -- and, when next (a body's `{`) is
// given, the comments before it.  A single result is rendered before the comments
// inside it are claimed, so that a list in it claims its own first.
func printSigResults(b @strings.Builder, rec @ast.Signature, results @[]@ast.TypeExpr,
		next token.Pos, tail int) {
	var key token.Pos = rec.Open
	var n int = len(results)
	if n == 0 {
		if next.Line > 0 { _ = writeInlineComments(b, claimHeldGap(rec.Close, next, key)) }
		return
	}
	var head token.Pos = typeStartPos(results[0])
	if n > 1 { head = rec.ResultOpen }
	_ = writeInlineComments(b, claimHeldGap(rec.Close, head, key))
	b.WriteByte(' ')
	if n == 1 {
		var t @ast.TypeExpr = results[0]
		var hi token.Pos = next
		if hi.Line == 0 { hi = rec.ResultClose }
		if hi.Line == 0 { hi = t.End }
		var scratch @strings.Builder = strings.NewBuilder()
		printType(scratch, t)
		var cs @[]@token.Comment = claimHeldGap(typeStartPos(t), hi, key)
		printTypeTail(b, t, tail + inlineCommentsWidth(cs))
		_ = writeInlineComments(b, cs)
		return
	}
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	// The items render as they print, one list deeper (listDepth).
	listDepth = listDepth + 1
	for i := 0; i < n; i++ {
		items.Push(typeItem(results[i], false))
	}
	listDepth = listDepth - 1
	var closing @[]@token.Comment = claimHeldGap(items.Items()[n - 1].pos, rec.ResultClose,
			listKey(items.Items()))
	var cs @[]@token.Comment
	if next.Line > 0 { cs = claimHeldGap(rec.ResultClose, next, key) }
	printStrList(b, '(', ')', items.Items(), typeStartPos(results[0]).Line, rec.ResultOpen, closing,
			false, tail + inlineCommentsWidth(cs))
	_ = writeInlineComments(b, cs)
}
