package "pkg/binate/format"

import "pkg/builtins/testing"

// A function's signature keeps the comments in it where the source put them -- before and after
// its name, around its receiver, in its type-parameter, parameter and result lists, between a
// parameter's name and its type, between its `)` and its results, after them and before its body's
// `{` -- and its body, which does not take them, stays on one line.
func TestSignatureKeepsItsCommentsInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func /* a */ f1(a int) int {\n"
			"\treturn a\n"
			"}\n"
			"\n"
			"func f2 /* b */ (a /* c */ int, b int /* d */) /* e */ int /* f */ {\n"
			"\treturn a\n"
			"}\n"
			"\n"
			"func (/* g */ r @T /* h */) /* i */ f3() (int, /* j */ bool /* k */) /* l */ {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f4[/* m */ T /* n */ any, U any /* o */](/* p */) {}\n"
			"\n"
			"func f5(a int) /* q */ int { return a }\n"
	return checkFormatGolden(src, src)
}

// A line comment in a signature stays where the source put it -- after `func`, after an opener and
// after a trailing comma before a parameter or type-parameter list's close, which then starts a
// line -- and one inside a parameter's type stays there, the type going on at a continuation
// line.
func TestSignatureKeepsItsLineComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func // a\n"
			"\t\tf1() {}\n"
			"\n"
			"func f2( // b\n"
			"\t\ta int) {}\n"
			"\n"
			"func f3(a int, // c\n"
			") {}\n"
			"\n"
			"func f4[T any, // d\n"
			"\t\tU any]() {}\n"
			"\n"
			"func f5[T any, // e\n"
			"]() {}\n"
			"\n"
			"func f6() ( // f\n"
			"\t\tint, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f7( // g\n"
			") {}\n"
			"\n"
			"func f8(a *// h\n"
			"\tint, b *// i\n"
			"\tint) {\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func // a\n"
			"\t\tf1() {}\n"
			"\n"
			"func f2( // b\n"
			"\t\ta int) {}\n"
			"\n"
			"func f3(a int, // c\n"
			") {}\n"
			"\n"
			"func f4[T any, // d\n"
			"\t\tU any]() {}\n"
			"\n"
			"func f5[T any, // e\n"
			"]() {}\n"
			"\n"
			"func f6() ( // f\n"
			"\t\tint, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f7( // g\n"
			") {}\n"
			"\n"
			"func f8(a * // h\n"
			"\t\tint, b * // i\n"
			"\t\t\t\tint) {}\n"
	return checkFormatGolden(src, want)
}

// A signature with no body -- a `.bni` function's, an interface method's -- keeps the comments in
// it where the source put them too, the comments after it following it.
func TestSignatureKeepsItsCommentsInAnInterfaceFile() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(a int) /* a */ int\n"
			"\n"
			"func f2(a /* b */ int) (int, bool) // c\n"
			"\n"
			"interface I {\n"
			"\tM(a int) /* d */ int\n"
			"\tN( // e\n"
			"\t\t\ta int) /* f */\n"
			"}\n"
	return checkFormatGoldenIface(src, src)
}

// A function literal's signature keeps the comments in it where the source put them, in a
// statement and as an argument of a call.
func TestFuncLitSignatureKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg := func(a int) /* a */ int {\n"
			"\t\treturn a\n"
			"\t}\n"
			"\th(func(a /* b */ int) {}, g)\n"
			"\th(g, func(/* c */) {})\n"
			"\tk := func /* d */ (a int) {}\n"
			"\t_ = k\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A signature wraps to keep the comments in it within the cap: a parameter list for a comment
// before its `)` or before the results, and a comment before the `)` that does not fit on the
// last parameter's line goes after a trailing comma, the `)` then starting a line; a result
// list's, which takes no trailing comma, stays on its last line.
func TestSignatureWrapsForItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int /* a long block comment he"
			"re */) int {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbbb int /* a long block comment here */) {\n"
			"}\n"
			"\n"
			"func f3() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a long b"
			"lock comment */) {\n"
			"\treturn 1, 2\n"
			"}\n"
			"\n"
			"func f4(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbb int) /* a comment before the results */ "
			"(int, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"interface J {\n"
			"\tMmmmmmmmmmmmmmmmmmmm(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbb int) /* a comment */ (int"
			", bool)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int /* a long block comment here */) int {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int,\n"
			"\t\t/* a long block comment here */\n"
			") {}\n"
			"\n"
			"func f3() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a long block comment */) {\n"
			"\treturn 1, 2\n"
			"}\n"
			"\n"
			"func f4(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbb int) /* a comment before the results */ (int, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"interface J {\n"
			"\tMmmmmmmmmmmmmmmmmmmm(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbb int) /* a comment */ (int, bool)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before a parameter or type-parameter list's close stays on its line only when the
// close and what follows it there fit too; otherwise it goes after a trailing comma, and the close
// starts a line of its own.
func TestSignatureCommentBeforeTheCloseKeepsTheCloseWithinTheCap() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\tthirdParameterName @AnotherLongTypeName /* nil for none at all zzzzzzzzzz */) @pkg.ResultType"
			"Name {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int,\n"
			"\tsecondParameterName @SomeType, thirdParameterName @AnotherType /* nil for none */) @pkg.Resul"
			"t {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g[T any,\n"
			"\tU any, /* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxx */\n"
			"](x T) T {\n"
			"\treturn x\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\t\tthirdParameterName @AnotherLongTypeName, /* nil for none at all zzzzzzzzzz */\n"
			") @pkg.ResultTypeName {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\t\tthirdParameterName @AnotherType /* nil for none */) @pkg.Result {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g[T any, U any,\n"
			"\t\t/* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx *"
			"/\n"
			"](x T) T {\n"
			"\treturn x\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// On a `// LONG-LINE ALLOWED` line a comment before a list's close stays where the source put it:
// no trailing comma goes in for it.
func TestMarkedSignatureKeepsItsCommentsBeforeTheClose() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface I {\n"
			"\tLoooooooooooooooooooooooooooong(aaaaaaaaaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbb int /*"
			" y */) int // LONG-LINE ALLOWED\n"
			"\tM1(a int /* c1 */) int; M2(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"b int /* c2 */) int // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGoldenIface(src, src)
}

// A parameter list that starts on its `(`'s line keeps to it when the `(` is not on the `func`
// keyword's: a source that wrapped before the `(` did not wrap the list.
func TestSignatureParametersStartFromTheirOpenersLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f[T any,\n"
			"\tU any](x T) T {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func (\n"
			"\tr @T) g(x int) int {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func\n"
			"h(x int) int {\n"
			"\treturn x\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f[T any, U any](x T) T {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func (r @T) g(x int) int {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func h(x int) int {\n"
			"\treturn x\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A signature whose body prints `{}` leaves room on its last line for that and for what follows
// it there -- a comment, a function literal's enclosing close -- which the body's ` {` alone does
// not take.
func TestSignatureLeavesRoomForAnEmptyBody() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(firstParameterName int, secondParameterName int, thirdParameterName int, fourthParamXY i"
			"nt) {\n"
			"}\n"
			"\n"
			"func g(firstParameterName int, secondParameterName int, thirdParameterName int, fourthPara int)"
			" {} // c\n"
			"\n"
			"func h() {\n"
			"\tx(func(firstParameterName int, secondParameterName int, thirdParameterName int, fourtABCDEF i"
			"nt) {\n"
			"\t})\n"
			"\tvar w = func(firstParameterName int, secondParameterName int, thirdParameterName int, foABCD "
			"int) {\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\tfourthParamXY int) {}\n"
			"\n"
			"func g(firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\tfourthPara int) {} // c\n"
			"\n"
			"func h() {\n"
			"\tx(func(firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\t\tfourtABCDEF int) {})\n"
			"\tvar w = func(firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\t\tfoABCD int) {}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line comment in a signature's result type stays there, and the result goes on at a
// continuation line, the parameters wrapping to leave room for the comment; one in its
// type-parameter list stays there too.  Either way the body prints `{}`.
func TestSignatureLeavesRoomForWhatItsBodyPrintsAfterItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func k(firstParameterName int, secondParameterName int, thirdParameterName int, fourABCD int) *"
			"// c\n"
			"int {\n"
			"}\n"
			"\n"
			"func k2(firstParameterName int, secondParameterName int, thirdParameterName int, fourABCDE int)"
			" *// c\n"
			"int {\n"
			"}\n"
			"\n"
			"func m[T any, // c\n"
			"\tU any](firstParameterName int, secondParameterName int, thirdParameterName int, fourthParXY i"
			"nt) {\n"
			"}\n"
			"\n"
			"func n[T any, // c\n"
			"\tU any](firstParameterName int, secondParameterName int, thirdParameterName int, fourthParX in"
			"t) {\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func k(firstParameterName int, secondParameterName int, thirdParameterName int, fourABCD int) *"
			" // c\n"
			"\t\tint {}\n"
			"\n"
			"func k2(firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\tfourABCDE int) * // c\n"
			"\t\t\t\tint {}\n"
			"\n"
			"func m[T any, // c\n"
			"\t\tU any](firstParameterName int, secondParameterName int, thirdParameterName int,\n"
			"\t\t\t\tfourthParXY int) {}\n"
			"\n"
			"func n[T any, // c\n"
			"\t\tU any](firstParameterName int, secondParameterName int, thirdParameterName int, fourthParX "
			"int) {}\n"
	return checkFormatGolden(src, want)
}

// A signature's single result in parentheses keeps them when a comment follows its `(`,
// which only the `(` can hold in place, and prints as a list of one: a line comment there
// stays, the result going on at a continuation line, in a function, a method and a
// function literal.  The parentheses go otherwise, with a comment before the `)` after
// the result.  A result in two pairs of parentheses prints in one, and stays so.
func TestSingleResultKeepsItsParensForACommentAfterThem() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() ( // c\n"
			"\tint) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2() (/* c */ int) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f3() (int /* c */) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f4() (( // c\n"
			"\tint)) {\n"
			"}\n"
			"\n"
			"func (r *T) m() ( // c\n"
			"\tint) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\tx := func() ( // c\n"
			"\t\tint) { return 1 }\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() ( // c\n"
			"\t\tint) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2() (/* c */ int) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f3() int /* c */ {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f4() ( // c\n"
			"\t\tint) {}\n"
			"\n"
			"func (r *T) m() ( // c\n"
			"\t\tint) {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\tx := func() ( // c\n"
			"\t\t\tint) { return 1 }\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An interface method's single result in parentheses keeps them when a comment follows
// its `(`, as does a body-less function's in an interface file.
func TestSingleResultKeepsItsParensInAnInterfaceFile() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface I {\n"
			"\tm() ( // c\n"
			"\t\tint)\n"
			"\tm2() (int /* d */)\n"
			"}\n"
			"\n"
			"func f() ( // c\n"
			"\tint)\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"interface I {\n"
			"\tm() ( // c\n"
			"\t\t\tint)\n"
			"\tm2() int /* d */\n"
			"}\n"
			"\n"
			"func f() ( // c\n"
			"\t\tint)\n"
	return checkFormatGoldenIface(src, want)
}
