package "pkg/binate/format"

import "pkg/builtins/testing"

// A function's signature keeps the comments in it where the source put them -- before and after
// its name, around its receiver, in its type-parameter, parameter and result lists, between a
// parameter's name and its type, between its `)` and its results, after them and before its body's
// `{` -- and its body, which does not take them, stays on one line.
func TestSignatureKeepsItsCommentsInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func /* a */ f1(a int) int {\n"
			"\treturn a\n"
			"}\n"
			"\n"
			"func f2 /* b */ (a /* c */ int, b int /* d */) /* e */ int /* f */ {\n"
			"\treturn a\n"
			"}\n"
			"\n"
			"func (/* g */ r @T /* h */) /* i */ f3() (int, /* j */ bool /* k */) /* l */ {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f4[/* m */ T /* n */ any, U any /* o */](/* p */) {}\n"
			"\n"
			"func f5(a int) /* q */ int { return a }\n"
	return checkFormatGolden(src, src)
}

// A line comment in a signature stays where the source put it -- after `func`, after an opener and
// after a trailing comma before a parameter or type-parameter list's close, which then starts a
// line -- and one inside a parameter's type goes after the comma that follows it, a trailing one
// for the last.
func TestSignatureKeepsItsLineComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func // a\n"
			"\t\tf1() {}\n"
			"\n"
			"func f2( // b\n"
			"\t\ta int) {}\n"
			"\n"
			"func f3(a int, // c\n"
			") {}\n"
			"\n"
			"func f4[T any, // d\n"
			"\t\tU any]() {}\n"
			"\n"
			"func f5[T any, // e\n"
			"]() {}\n"
			"\n"
			"func f6() ( // f\n"
			"\t\tint, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f7( // g\n"
			") {}\n"
			"\n"
			"func f8(a *// h\n"
			"\tint, b *// i\n"
			"\tint) {\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func // a\n"
			"\t\tf1() {}\n"
			"\n"
			"func f2( // b\n"
			"\t\ta int) {}\n"
			"\n"
			"func f3(a int, // c\n"
			") {}\n"
			"\n"
			"func f4[T any, // d\n"
			"\t\tU any]() {}\n"
			"\n"
			"func f5[T any, // e\n"
			"]() {}\n"
			"\n"
			"func f6() ( // f\n"
			"\t\tint, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"func f7( // g\n"
			") {}\n"
			"\n"
			"func f8(a *int, // h\n"
			"\t\tb *int, // i\n"
			") {}\n"
	return checkFormatGolden(src, want)
}

// A signature with no body -- a `.bni` function's, an interface method's -- keeps the comments in
// it where the source put them too, the comments after it following it.
func TestSignatureKeepsItsCommentsInAnInterfaceFile() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(a int) /* a */ int\n"
			"\n"
			"func f2(a /* b */ int) (int, bool) // c\n"
			"\n"
			"interface I {\n"
			"\tM(a int) /* d */ int\n"
			"\tN( // e\n"
			"\t\t\ta int) /* f */\n"
			"}\n"
	return checkFormatGoldenIface(src, src)
}

// A function literal's signature keeps the comments in it where the source put them, in a
// statement and as an argument of a call.
func TestFuncLitSignatureKeepsItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg := func(a int) /* a */ int {\n"
			"\t\treturn a\n"
			"\t}\n"
			"\th(func(a /* b */ int) {}, g)\n"
			"\th(g, func(/* c */) {})\n"
			"\tk := func /* d */ (a int) {}\n"
			"\t_ = k\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A signature wraps to keep the comments in it within the cap: a parameter list for a comment
// before its `)` or before the results, and a comment before the `)` that does not fit on the
// last parameter's line goes after a trailing comma, the `)` then starting a line; a result
// list's, which takes no trailing comma, stays on its last line.
func TestSignatureWrapsForItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int /* a long block comment he"
			"re */) int {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbbb int /* a long block comment here */) {\n"
			"}\n"
			"\n"
			"func f3() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a long b"
			"lock comment */) {\n"
			"\treturn 1, 2\n"
			"}\n"
			"\n"
			"func f4(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbb int) /* a comment before the results */ "
			"(int, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"interface J {\n"
			"\tMmmmmmmmmmmmmmmmmmmm(aaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbb int) /* a comment */ (int"
			", bool)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f1(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int /* a long block comment here */) int {\n"
			"\treturn 1\n"
			"}\n"
			"\n"
			"func f2(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb int,\n"
			"\t\t/* a long block comment here */\n"
			") {}\n"
			"\n"
			"func f3() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb /* a long block comment */) {\n"
			"\treturn 1, 2\n"
			"}\n"
			"\n"
			"func f4(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbb int) /* a comment before the results */ (int, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"\n"
			"interface J {\n"
			"\tMmmmmmmmmmmmmmmmmmmm(aaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbb int) /* a comment */ (int, bool)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line comment inside a receiver's type, a lone result's or a result list's last has no place
// in the signature -- a newline after it would end the signature, and neither takes a trailing
// comma -- so it goes on the body's first line, and the signature's later comments follow it there,
// in their order.
func TestSignatureLeavesALineCommentInAReceiverOrResultTypeToTheBody() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func (r *// a\n"
			"\tT) f1(x /* b */ int) /* c */ {\n"
			"}\n"
			"\n"
			"func f2() *// d\n"
			"\tint {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func f3() (int, *// e\n"
			"\tbool) /* f */ {\n"
			"\treturn 1, nil\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func (r *T) f1(x int) {\n"
			"\t// a\n"
			"\t/* b */\n"
			"\t/* c */\n"
			"}\n"
			"\n"
			"func f2() *int {\n"
			"\t// d\n"
			"\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func f3() (int, *bool) {\n"
			"\t// e\n"
			"\t/* f */\n"
			"\treturn 1, nil\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment before a parameter or type-parameter list's close stays on its line only when the
// close and what follows it there fit too; otherwise it goes after a trailing comma, and the close
// starts a line of its own.
func TestSignatureCommentBeforeTheCloseKeepsTheCloseWithinTheCap() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\tthirdParameterName @AnotherLongTypeName /* nil for none at all zzzzzzzzzz */) @pkg.ResultType"
			"Name {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int,\n"
			"\tsecondParameterName @SomeType, thirdParameterName @AnotherType /* nil for none */) @pkg.Resul"
			"t {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g[T any,\n"
			"\tU any, /* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxx */\n"
			"](x T) T {\n"
			"\treturn x\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\t\tthirdParameterName @AnotherLongTypeName, /* nil for none at all zzzzzzzzzz */\n"
			") @pkg.ResultTypeName {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r @Receiver) doSomethingUseful(firstParameterName int, secondParameterName @SomeType,\n"
			"\t\tthirdParameterName @AnotherType /* nil for none */) @pkg.Result {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g[T any, U any,\n"
			"\t\t/* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx *"
			"/\n"
			"](x T) T {\n"
			"\treturn x\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// On a `// LONG-LINE ALLOWED` line a comment before a list's close stays where the source put it:
// no trailing comma goes in for it.
func TestMarkedSignatureKeepsItsCommentsBeforeTheClose() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"interface I {\n"
			"\tLoooooooooooooooooooooooooooong(aaaaaaaaaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbb int /*"
			" y */) int // LONG-LINE ALLOWED\n"
			"\tM1(a int /* c1 */) int; M2(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"b int /* c2 */) int // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGoldenIface(src, src)
}

// A parameter list that starts on its `(`'s line keeps to it when the `(` is not on the `func`
// keyword's: a source that wrapped before the `(` did not wrap the list.
func TestSignatureParametersStartFromTheirOpenersLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f[T any,\n"
			"\tU any](x T) T {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func (\n"
			"\tr @T) g(x int) int {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func\n"
			"h(x int) int {\n"
			"\treturn x\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f[T any, U any](x T) T {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func (r @T) g(x int) int {\n"
			"\treturn x\n"
			"}\n"
			"\n"
			"func h(x int) int {\n"
			"\treturn x\n"
			"}\n"
	return checkFormatGolden(src, want)
}
