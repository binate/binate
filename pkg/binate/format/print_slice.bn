package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// printSlice appends `head[lo:hi]` with an elided missing bound.  A slice with a high
// bound breaks after its `:`, as an operator chain after an operator: the high bound
// moves to a continuation line, two tabs in from the line the slice starts on, when
// it does not fit after the `:` (writeSliceBreak); it is measured and printed one
// list deeper (listDepth, print_deep.bn), as a list's elements are.  So a wrappable
// head reserves only `[lo:` (to the first line of a low bound that spans lines) and a
// line comment after the `:`, which stays on its line with the block comments before
// it (lineEndWidth); and the low bound reserves the `:` and those comments.  A
// slice without a high bound cannot break: its head reserves the whole `[lo:]` and
// the tail, and its low bound the `:`, the `]`, the comments before it and the tail.
// The high bound reserves what follows it: the `]`, the comments before it and the
// tail.  The comments before the `[` stay there, and those after it go there, before
// the low bound: the head reserves both, and they go with the low bound to a
// continuation line when it does not fit after them (writeSliceOpenGap).  Those from the
// low bound's start to the high bound's go after the `:` (claimColonGap), and the
// block comments on one line before the `]` stay there (sliceCloserGap) -- without a
// high bound, all the comments after the low bound's start go after the `:`, and one
// that needs a line break after it puts the `]` on the next line; all are keyed by the
// `[` (its Pos).
func printSlice(b @strings.Builder, e @ast.Expr, exposed bool, tail int) {
	var closing @[]@token.Comment
	if !wrapSuppressed { closing = sliceCloserGap(e) }
	var hiTail int = 1 + inlineCommentsWidth(closing) + tail
	var breaks bool = e.Y != nil && !wrapSuppressed
	var base int = currentLineIndent(b)
	var cont int = base + 2
	// Without a high bound, a comment before the `]` that needs a line break after it
	// ends the `:`'s line, and the `]` and the tail go on the next (writeCloserGap).
	var ends bool = e.Y == nil && gapCommentsWidth(closing) < 0
	// The comments before the `[` are claimed once the head is rendered, so that a list
	// in it claims its own first (claimAfterExpr).
	var before @[]@token.Comment = claimAfterExpr(e.X, e.Pos, e.Pos)
	var open @[]@token.Comment
	if e.Z != nil { open = claimGap(e.Pos, exprStartPos(e.Z), e.Pos) }
	var after @[]@token.Comment
	var suffix int = hiTail - 1
	var colon int = 1 + hiTail
	if breaks {
		// The low bound is rendered first, so that a list in it claims its own comments
		// (claimAfterExpr); sliceSuffixWidth renders it the same way (boundShare).
		if e.Z != nil { _ = boundShare(e.Z) }
		after = claimColonGap(e)
		suffix = withTrail(0, lineEndWidth(after), cont)
		colon = 1 + suffix
	}
	if ends {
		// Only a run that ends in a line comment, which stays on the `:`'s line: block
		// comments go on to the next line when they do not fit, and measured otherwise,
		// with the source's lines, a second format finding them moved would differ.
		suffix = 0
		if closerRunWidth(closing) > 0 { suffix = withTrail(0, closerRunWidth(closing), cont) }
		colon = 1 + suffix
	}
	printPostfixHead(b, e.X, exposed,
			inlineCommentsWidth(before) + sliceSuffixWidth(e, open, breaks || ends, suffix))
	_ = writeInlineComments(b, before)
	b.WriteByte('[')
	if e.Z != nil {
		writeSliceOpenGap(b, e.Z, open, cont, colon)
		printExprTail(b, e.Z, colon)
	}
	b.WriteByte(':')
	if breaks {
		listDepth = listDepth + 1
		writeSliceBreak(b, e.Y, after, cont, hiTail)
		printExprTail(b, e.Y, hiTail)
		listDepth = listDepth - 1
	} else if e.Y != nil {
		writeExprGap(b, claimColonGap(e))
		printExprTail(b, e.Y, hiTail)
	}
	if wrapSuppressed { closing = sliceCloserGap(e) }
	if e.Y == nil {
		writeBreakableCloserGap(b, closing, cont, base, 1 + tail)
	} else {
		_ = writeInlineComments(b, closing)
	}
	b.WriteByte(']')
}

// claimColonGap returns the comments that slice e prints after its `:` -- those from
// its low bound's start (its `[`, without one) to its high bound's -- and claims
// them.
func claimColonGap(e @ast.Expr) @[]@token.Comment {
	var lo token.Pos = e.Pos
	if e.Z != nil { lo = exprStartPos(e.Z) }
	return claimGap(lo, exprStartPos(e.Y), e.Pos)
}

// gluedCommentsWidth returns the width that the comments cs of a gap take on the line
// of the token before them, written glued to it (writeGapComments): through a line
// comment, or the first line of a block comment spanning lines, and none from a line
// comment the source put on a line of its own.
func gluedCommentsWidth(cs @[]@token.Comment) int {
	var w int = 0
	for i := 0; i < len(cs); i++ {
		var c @token.Comment = cs[i]
		var block bool = isBlockComment(c)
		if !block && c.OwnLine && (i == 0 || cs[i - 1].End.Line != c.Pos.Line) { return w }
		if i > 0 || !block { w = w + 1 }
		w = w + firstLineLen(c.Text)
		if !block || hasNewline(c.Text) { return w }
	}
	return w
}

// lineEndWidth returns the width that the comments cs after a slice's `:` take on its
// line when a line comment ends it there, with the block comments on one line before
// it (gluedCommentsWidth), as withTrail measures a line comment after a list's
// element; else 0: block comments alone go on to the high bound's line when they do
// not fit.
func lineEndWidth(cs @[]@token.Comment) int {
	for i := 0; i < len(cs); i++ {
		var c @token.Comment = cs[i]
		if !isBlockComment(c) {
			if c.OwnLine && (i == 0 || cs[i - 1].End.Line != c.Pos.Line) { return 0 }
			return gluedCommentsWidth(cs)
		}
		if hasNewline(c.Text) { return 0 }
	}
	return 0
}

// sliceSuffixWidth returns the width of what follows slice e's head on its line,
// with tail after it: the `[`, the comments open after it and `lo:` when its line can
// end after the `:` (the slice breaks there, or a comment there ends the line), else
// `[lo:hi]` -- either only to the end of a line comment after the `[`, or of the first
// line of a bound that can break (boundShare).
func sliceSuffixWidth(e @ast.Expr, open @[]@token.Comment, breaks bool, tail int) int {
	var gw int = gapCommentsWidth(open)
	if gw < 0 { return 1 + gluedCommentsWidth(open) }
	var w int = 1 + gw
	if e.Z != nil {
		var lo @[]readonly char = boundShare(e.Z)
		if hasNewline(lo) { return w + firstLineLen(lo) }
		w = w + len(lo)
	}
	w = w + 1
	if breaks { return w + tail }
	if e.Y != nil {
		var hi @[]readonly char = boundShare(e.Y)
		if hasNewline(hi) { return w + firstLineLen(hi) }
		w = w + len(hi)
	}
	return w + 1 + tail
}

// boundShare returns slice bound e rendered as it breaks wherever it can: from past
// the width cap, where each list leaves its opener alone, each operator chain breaks
// after its first operator, each slice after its `:` and each string run after its
// first byte, laid out by width alone (layOutByWidth).  A head reserves the first line
// of that (sliceSuffixWidth), as a call's head reserves only its `(`: rendered from
// column 0, or with the source's breaks, a bound can span lines where it prints that
// fits where it is measured, and a second format, reading back the breaks the first
// printed, would then measure it otherwise.
func boundShare(e @ast.Expr) @[]readonly char {
	var depth int = layOutByWidth()
	var s @[]readonly char = renderAt(e, MAX_LINE_WIDTH, 0, 0)
	listDepth = depth
	return s
}

// writeSliceOpenGap writes the comments cs after a slice's `[` and what separates them
// from its low bound lo, which tail bytes follow, as writeExprGap does -- after a line
// break to a continuation line at cont when they are block comments on one line that
// stay on the `[`'s line but lo then does not fit after them, measured as the head
// measures it (boundShare): by width alone, the same whatever breaks the source has.
func writeSliceOpenGap(b @strings.Builder, lo @ast.Expr, cs @[]@token.Comment, cont int, tail int) {
	var gw int = gapCommentsWidth(cs)
	var here int = lineWidth(b) + gw
	if gw > 0 && !wrapSuppressed && lineWidth(b) > cont && here <= MAX_LINE_WIDTH &&
			here + lineShare(boundShare(lo), tail) > MAX_LINE_WIDTH {
		b.WriteByte('\n')
		writeIndent(b, cont)
	}
	writeExprGap(b, cs)
}

// writeSliceBreak writes the comments cs after a slice's `:`, glued to it, and what
// separates them from its high bound hi, which tail bytes follow: a line break to a
// continuation line at cont after a line comment, or when the fill decision moves hi
// there (exprFitsAt, print_lineshare.bn); otherwise a space after comments, or
// nothing.  Block comments ending in a line comment, which stays on their line, begin
// that continuation line when they do not fit on the `:`'s line together
// (lineEndWidth): one at a time, a block comment that fits would stay, and the line
// comment run past the cap.
func writeSliceBreak(b @strings.Builder, hi @ast.Expr, cs @[]@token.Comment, cont int, tail int) {
	var here int = lineWidth(b)
	if len(cs) > 0 {
		var run int = lineEndWidth(cs)
		if run > 0 && isBlockComment(cs[0]) && here > cont && here + run > MAX_LINE_WIDTH {
			b.WriteByte('\n')
			writeIndent(b, cont)
		}
		if writeGapComments(b, cs, cont, true) {
			b.WriteByte('\n')
			writeIndent(b, cont)
			return
		}
		here = lineWidth(b) + 1
	}
	var none token.Pos
	if !exprFitsAt(hi, tail, false, true, tail, nil, none, here, currentLineIndent(b), cont) {
		b.WriteByte('\n')
		writeIndent(b, cont)
		return
	}
	if len(cs) > 0 { b.WriteByte(' ') }
}
