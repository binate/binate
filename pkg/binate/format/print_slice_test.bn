package "pkg/binate/format"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// A slice whose high bound does not fit after its `:` breaks there: the high bound
// moves to a continuation line, two tabs in from the line the slice starts on, and
// the head and the low bound wrap only for what comes before the break.  A line
// comment after the `:` stays on its line, and the head wraps for it; a block comment
// there that does not fit goes on to the high bound's line.
func TestSliceBreaksAfterItsColon() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := xxxxxxxxxx[g0(bbbbbbbbbbbbbbbbbbbbbbbb, yyyyyyyyyyyyyyyyyyyy).(T /* c5xxxxxxxxx"
			"xxxxxxxxxxxxxxxx */):bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb]\n"
			"\tx := ssssssss[iiiiiiiiiiii:aaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb"
			" + cccccccccccccccccccccc]\n"
			"\ty := gggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiiiiiii:hhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tz := ssssssss[gggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb):hhhhhhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tw := ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss[:hhhhhhhhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\ta := ssssssss[iiiiiiiiiiii:/* c */ hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tb := gggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiii"
			"iiii: // cccccccccc\n"
			"\t\thhhhhhh]\n"
			"\tb2 := gggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiii"
			"iiii:/* cccccccc */ hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := xxxxxxxxxx[g0(bbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tyyyyyyyyyyyyyyyyyyyy).(T /* c5xxxxxxxxxxxxxxxxxxxxxxxxx */):\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb]\n"
			"\tx := ssssssss[iiiiiiiiiiii:\n"
			"\t\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbb + cccccccccccccccccccc"
			"cc]\n"
			"\ty := gggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiiiiiii:\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tz := ssssssss[gggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb):\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tw := ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss[:\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\ta := ssssssss[iiiiiiiiiiii:/* c */\n"
			"\t\t\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"\tb := gggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiiiiiii: // cccccccccc\n"
			"\t\t\thhhhhhh]\n"
			"\tb2 := gggggggg(aaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)[iiiiiiii"
			"iiii:\n"
			"\t\t\t/* cccccccc */ hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A slice keeps its high bound after the `:` when it fits there, and when it spans
// lines wherever it prints, wrapping itself.  A slice with no high bound cannot
// break, and its low bound wraps for what follows it: the `:` too.
func TestSliceKeepsItsHighBoundWhenItFits() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th := s[i:j]\n"
			"\tc := ssssssss[iiiiiiiiiiii:hhhhhhhhhhhhhhhhhhhhhhhhhhhhhh(aaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccccc)]\n"
			"\tg(gxxxxxxxxxxxxxxxxxxxxxxxxxx[hxxxxxx + gxxxxxxxxx + pxxxxxxxx: /* ccccccc */]) // t"
			"tttttttttttttttt\n"
			"\te := ssssssss[aaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbb + ccccccccccccccccccccccc:]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\th := s[i:j]\n"
			"\tc := ssssssss[iiiiiiiiiiii:hhhhhhhhhhhhhhhhhhhhhhhhhhhhhh(aaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccccc)]\n"
			"\tg(gxxxxxxxxxxxxxxxxxxxxxxxxxx[hxxxxxx + gxxxxxxxxx +\n"
			"\t\t\tpxxxxxxxx: /* ccccccc */]) // ttttttttttttttttt\n"
			"\te := ssssssss[aaaaaaaaaaaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbb +\n"
			"\t\t\tccccccccccccccccccccccc:]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A slice that is a list's lone element breaks after its `:` for what follows the
// list, as a call there wraps, rather than moving below the list's opener; and a
// slice in an element that moves to a continuation line breaks there too.
func TestSliceBreaksInAList() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tgggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg(cccccccccccccccccccc["
			"iiiiii:jjjjjj]) // a trailing cc\n"
			"\tg(aaaaaaaaaaaaaaaaaaaa{ffffffff}, zzzzzzzzzzzzz(hhhhh(func() { return bbbbbbbbbbbbbb"
			"bbbbbbbbbbbbb })[ddddddddddddd:hhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]()))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tgggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg(cccccccccccccccccccc["
			"iiiiii:\n"
			"\t\t\tjjjjjj]) // a trailing cc\n"
			"\tg(aaaaaaaaaaaaaaaaaaaa{ffffffff},\n"
			"\t\t\tzzzzzzzzzzzzz(hhhhh(func() { return bbbbbbbbbbbbbbbbbbbbbbbbbbb })[ddddddddddddd"
			":\n"
			"\t\t\t\t\thhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]()))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// The head leaves room for the comments before the slice's `[` and after it, which
// stay on its line before the low bound, but not for a block comment after the `:`,
// which goes on to the high bound's line when it does not fit: reserved, it could
// keep the head from wrapping and leave the line past the cap.  A line comment after
// the `:` stays on its line, with the block comments before it, so the head leaves
// room for them all.
func TestSliceReservesTheCommentsAroundItsOpener() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxx)[bxxxxxxxxx: /* cccccccccccccccccccc */ dxxxxxxxxxxxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxxxxx)[bxxxxxxxxx /* cccccccccccccccccccc */:dxxxxxxxxxxxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, exxxxxxxxxxxxxxxxxxxxxxxxxx) /* ccccccccccccc"
			"ccccccc */[bxxxxxxxxx:dxxxxxxxxxxxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxx, exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[/* ccccc */ sxxxxxxxx"
			"xxxxxxxxxxxxxxxxxxxxx:dxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxx, exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[bxxxxxxxxx:/* cc"
			"cccccccccc */ // llllllll\n"
			"\t\tdxxxxxxxxxxxxxxxxxxx]\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\texxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[bxxxxxxxxx:\n"
			"\t\t\t/* cccccccccccccccccccc */ dxxxxxxxxxxxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\texxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[bxxxxxxxxx:\n"
			"\t\t\t/* cccccccccccccccccccc */ dxxxxxxxxxxxxxxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\texxxxxxxxxxxxxxxxxxxxxxxxxx) /* cccccccccccccccccccc */[bxxxxxxxxx:dxxxxxxxxxxxx"
			"xxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\texxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[/* ccccc */ sxxxxxxxxxxxxxxxxxxxxxxxxxxxxx:dxx"
			"xxxxxxx]\n"
			"\tv := g(hxxxxxxxxxxxxxxxxxxx,\n"
			"\t\t\texxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)[bxxxxxxxxx:/* cccccccccccc */ // llllllll"
			"\n"
			"\t\t\tdxxxxxxxxxxxxxxxxxxx]\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// nestedHighBounds returns a file whose one statement nests d slices, each the high
// bound of the one around it, in a call's first argument.
func nestedHighBounds(d int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc f() {\n\tg(")
	for i := 0; i < d; i++ { b.Write("xxxx[aaaa:") }
	b.WriteByte('z')
	for i := 0; i < d; i++ { b.WriteByte(']') }
	b.Write(", w)\n}\n")
	return b.String()
}

// A slice's high bound is measured and printed one list deeper, so past
// STABLE_LIST_DEPTH nested slices its fill is decided by its one-line form: formatting
// high bounds nested 40 deep makes few more renderings than 32 deep.  Each measured
// at both places it can print, every level renders those below it again at each.
func TestSliceHighBoundsNestedRenderSlowly() testing.TestResult {
	var r32 int = rendersOf(nestedHighBounds(32))
	var r40 int = rendersOf(nestedHighBounds(40))
	if 4 * r40 <= 5 * r32 { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("renderings: high bounds 32 deep ")
	sb.Write(strconv.Itoa(r32))
	sb.Write(", 40 deep ")
	sb.Write(strconv.Itoa(r40))
	sb.Write(" (bound 5/4 times)")
	return buf.CopyStr(sb.String())
}
