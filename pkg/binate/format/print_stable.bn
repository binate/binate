package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// A fill decision (fitsPlacedOrMoved) measures an element's renderings at the two
// places it can print, and a second format measures the element as this one printed
// it, with the breaks that layout has, which it keeps (print_reread.bn).  So the two
// can decide differently, and formatting a formatted file would change it.  Mostly
// the element moves because its rendering placed breaks earlier inside than its
// moved one (an inner opener alone, a function literal moved to stay on one line, a
// string split at the deeper column); a second format keeps the breaks printed at
// the moved place, the two renderings then start alike, and the element moves back.
//
// So a decision whose renderings span lines is checked against what a second format
// would do (fitsStably): a layout holds when, read back and rendered at both places,
// it gives the same decision and prints the same (holdsPlaced, holdsMoved).  When
// the decision's layout does not hold, the other place's is taken; when neither
// holds, a layout read back from one place and rendered at the other -- what a
// second format would print there -- is tried, and the element prints as that text
// (setOverride).  A right-hand side moved to a continuation line is checked the same
// way (rhsInlineHolds).  Reading an element back on its own, without the code around
// it, makes this a close model of a second format, not an exact one.

// layoutWidth returns the width of the widest line of text, an element rendered
// from column start with tail bytes after its last line.
func layoutWidth(text *[]readonly char, start int, tail int) int {
	var w int = 0
	var lineStart int = 0
	var col int = start
	for i := 0; i <= len(text); i++ {
		if i == len(text) || text[i] == '\n' {
			var lw int = col + i - lineStart
			if i == len(text) { lw = lw + tail }
			if lw > w { w = lw }
			lineStart = i + 1
			col = 0
		}
	}
	return w
}

// holdsPlaced reports whether text, an element printed at here (of a line indented
// indent tabs; cont is its fill's other place), read back and rendered at both
// places, stays there and prints the same.  prefix, tail and shallow are as for
// fitsStably.
func holdsPlaced(text *[]readonly char, prefix int, tail int, here int, indent int, cont int,
		shallow bool) bool {
	var m @[]readonly char
	var p @[]readonly char
	var ok bool
	m, ok = rereadItemAt(text, prefix, cont, cont, tail)
	if !ok || !fitsPlacedOrMoved(text, m, tail, here, cont, shallow) { return false }
	p, ok = rereadItemAt(text, prefix, here, indent, tail)
	return ok && textsEqual(p, text)
}

// holdsMoved reports whether text, an element printed moved to cont (from here, of a
// line indented indent tabs), read back and rendered at both places, moves again and
// prints the same.  A list's first element moves by leaving its opener alone, which
// a second format keeps (first).
func holdsMoved(text *[]readonly char, prefix int, first bool, tail int, here int, indent int,
		cont int, shallow bool) bool {
	var m @[]readonly char
	var p @[]readonly char
	var ok bool
	if !first {
		p, ok = rereadItemAt(text, prefix, here, indent, tail)
		if !ok || fitsPlacedOrMoved(p, text, tail, here, cont, shallow) { return false }
	}
	m, ok = rereadItemAt(text, prefix, cont, cont, tail)
	return ok && textsEqual(m, text)
}

// fitsStably decides the fill of element e, as fitsPlacedOrMoved does from its
// renderings placed (from column here of a line indented indent tabs) and moved (to
// the continuation lines' column cont), each with tail bytes after it, but takes a
// layout that holds: the decision's, else the other place's, else -- printed in
// place of e -- placed read back and rendered moved, or moved read back and
// rendered placed, the decision's place first.  A layout other than the decision's
// is not taken when it runs past the cap further than the decision's would, and
// one read back is not taken when e prints with another tail than it is measured
// with (!exact): printExprTail would not find it there.  When none is taken, the
// decision stands.  The renderings start with prefix bytes of a key and `: ` before
// e (0 for none); first marks a list's first element, and shallow is as for
// fitsPlacedOrMoved.
func fitsStably(e @ast.Expr, prefix int, first bool, exact bool, placed *[]readonly char,
		moved *[]readonly char, tail int, here int, indent int, cont int, shallow bool) bool {
	var d bool = fitsPlacedOrMoved(placed, moved, tail, here, cont, shallow)
	// One-line layouts have no breaks for a second format to keep.
	if !hasNewline(placed) && !hasNewline(moved) { return d }
	if d && holdsPlaced(placed, prefix, tail, here, indent, cont, shallow) { return true }
	if !d && holdsMoved(moved, prefix, first, tail, here, indent, cont, shallow) { return false }
	var limit int = layoutWidth(placed, here, tail)
	if !d { limit = layoutWidth(moved, cont, tail) }
	if limit < MAX_LINE_WIDTH { limit = MAX_LINE_WIDTH }
	if d && layoutWidth(moved, cont, tail) <= limit &&
			holdsMoved(moved, prefix, first, tail, here, indent, cont, shallow) {
		return false
	}
	if !d && layoutWidth(placed, here, tail) <= limit &&
			holdsPlaced(placed, prefix, tail, here, indent, cont, shallow) {
		return true
	}
	if !exact { return d }
	var m2 @[]readonly char
	var p2 @[]readonly char
	var okm bool
	var okp bool
	m2, okm = rereadItemAt(placed, prefix, cont, cont, tail)
	p2, okp = rereadItemAt(moved, prefix, here, indent, tail)
	var m2Holds bool = okm && layoutWidth(m2, cont, tail) <= limit &&
			holdsMoved(m2, prefix, first, tail, here, indent, cont, shallow)
	var p2Holds bool = okp && layoutWidth(p2, here, tail) <= limit &&
			holdsPlaced(p2, prefix, tail, here, indent, cont, shallow)
	if p2Holds && (d || !m2Holds) {
		setOverride(e, here + prefix, indent, tail, p2[prefix:])
		return true
	}
	if m2Holds {
		setOverride(e, cont + prefix, cont, tail, m2[prefix:])
		return false
	}
	return d
}

// rhsInlineHolds reports whether value, the right-hand side of operator opName
// after b's text, which printRhsValue would move to a continuation line, should
// stay inline instead: read back from there, it renders inline within the cap, as a
// second format would put it -- with its lone names and literals on their openers'
// lines too (rhsInlineFits) -- and that inline layout read back prints the same.  It
// then makes that inline layout the value's (setOverride).  tail bytes follow the
// value.
func rhsInlineHolds(b @strings.Builder, opName *[]readonly char, value @ast.Expr, tail int) bool {
	var cont int = currentLineIndent(b) + 1
	var text @[]readonly char = renderAt(value, cont, cont, tail)
	var start int = lineWidth(b) + 2 + len(opName)
	var indent int = currentLineIndent(b)
	var i2 @[]readonly char
	var i3 @[]readonly char
	var ok bool
	i2, ok = rereadRenderAt(text, start, indent, tail)
	if !ok || layoutWidth(i2, start, tail) > MAX_LINE_WIDTH { return false }
	if hasLoneUnbreakable(value) {
		var saved bool = loneStays
		loneStays = true
		var kept @[]readonly char
		kept, ok = rereadRenderAt(text, start, indent, tail)
		loneStays = saved
		if !ok || layoutWidth(kept, start, tail) > MAX_LINE_WIDTH { return false }
	}
	i3, ok = rereadRenderAt(i2, start, indent, tail)
	if !ok || !textsEqual(i3, i2) { return false }
	setOverride(value, start, indent, tail, i2)
	return true
}
