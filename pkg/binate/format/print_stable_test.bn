package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for the fill decisions' check against a second format (print_stable.bn): each
// source used to format to a layout that formatting it again changed.

// An argument whose rendering after the previous one breaks earlier inside than its
// rendering on a continuation line (`zzz(` alone over its argument) stays after it.
// Moved, a second format reads the moved layout's breaks, renders it alike after the
// previous argument and moves it back (`g(a{f},` / `zzz(hhhhh(func() {` formatted
// again to `g(a{f}, zzz(hhhhh(func() {`); placed, the opener alone holds.
func TestStableArgNotMovedBack() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func f(){g(aaaaaaaaaaaaaaaaaaaa{ffffffff},zzzzzzzzzzzzz(hhhhh(func(){return bbbbbbbbbbbbbbbbbbb"
			"bbbbbbbb})[ddddddddddddd:hhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]()))}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(aaaaaaaaaaaaaaaaaaaa{ffffffff}, zzzzzzzzzzzzz(\n"
			"\t\t\thhhhh(func() {\n"
			"\t\t\t\treturn bbbbbbbbbbbbbbbbbbbbbbbbbbb\n"
			"\t\t\t})[ddddddddddddd:hhhhhhhhhhhhhhhhhhhhhhhhhhhhhh]()))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// When the decision's layout does not hold, the other place's is taken: the
// `__c_call` moves below `pkg{`, where a second format keeps it.  After `pkg{`, a
// second format would move the call holding it to a line of its own (`x(` alone
// after the outer call's `(`).
func TestStableOtherPlace() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){((__c_call(\"sym\",a,(97334))))(x(func(){},pkg{__c_call(\"sym\",int,S{\"aaaaaaaaaaaaaa"
			"aaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaa\"},"
			"int{})}))}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t__c_call(\"sym\", a, 97334)(x(func() {}, pkg{\n"
			"\t\t\t__c_call(\"sym\", int,\n"
			"\t\t\t\t\tS{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\"aa\"},\n"
			"\t\t\t\t\tint{})}))\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// When neither place's layout holds, a layout read back from one and rendered at the
// other is printed: the composite moves to a continuation line with its string run
// split as it is after `f(value,`, read back and resized there -- which a second
// format keeps.
func TestStableLayoutReadBack() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){_(((f[int](p,func(){}))),cast(int,f(value,S{(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\""
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")},func(y int){lo"
			"ngFunctionName()})))\n"
			"{(func(y int){Call((a),qqqqqqqqqqqq[\"aaaaaaaaaaaaaaaaaaaaaaa\"])})}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_(f[int](p, func() {}), cast(int, f(value,\n"
			"\t\t\tS{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaa\"\n"
			"\t\t\t\t\t\"aaaaaaaaaaaaaaaa\"},\n"
			"\t\t\tfunc(y int) { longFunctionName() })))\n"
			"\t{ func(y int) { Call(a, qqqqqqqqqqqq[\"aaaaaaaaaaaaaaaaaaaaaaa\"]) } }\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A case label is checked the same way: `__c_call(` stays after `case xx,`, printed
// as its moved layout reads back there.
func TestStableCaseLabelReadBack() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){switch{case xx,__c_call(\"sym\",int,longFunctionName()[len(f(pfield,\"aaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaa\",81513).x)],func(){(qqqqqqqqqqqqqqqqqqq)},qqqqqqqqqqqqqqq):"
			"}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tswitch {\n"
			"\tcase xx, __c_call(\"sym\", int, longFunctionName()[\n"
			"\t\t\tlen(f(pfield, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaa\", 81513).x)],\n"
			"\t\t\tfunc() { qqqqqqqqqqqqqqqqqqq }, qqqqqqqqqqqqqqq):\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A keyed element is checked by its value, rendered after its key: the keyed call
// moves below `_{`, where a second format keeps it.
func TestStableKeyedValue() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){_{kkkkkkkkkkkkkkkkk:f(obj,T{\"aaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaa"
			"aaaaa\"\"aaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})()[someLongerName],Pair[int]{}[xx],fun"
			"c(y int){}}((f))}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t_{\n"
			"\t\t\tkkkkkkkkkkkkkkkkk: f(obj,\n"
			"\t\t\t\t\tT{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\"aa\"})()[someLongerName],\n"
			"\t\t\tPair[int]{}[xx], func(y int) {}}(f)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A right-hand side that a second format, reading it moved to a continuation line,
// would put back after `=` stays there.
func TestStableRhsInline() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"var v=Call(\"aaaaaaaaaaa\",f(__c_call(\"sym\",int,\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaa"
			"\"\"aaaaaaa\"\"aaaaaaaaaaaaaaaaa\"))[pkg(((qqqqqqqqqqqqqqqqqqqqqqqq)),func(y int){x()},int{})])"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var v = Call(\"aaaaaaaaaaa\",\n"
			"\t\tf(__c_call(\"sym\", int, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"\"))[\n"
			"\t\t\t\tpkg(qqqqqqqqqqqqqqqqqqqqqqqq, func(y int) { x() }, int{})])\n"
	return checkFormatGolden(src, want)
}

// A list's first element moved below its opener stays moved however it measures
// again: a second format keeps an opener alone, so the moved layout holds.
func TestStableFirstElementMoved() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func f(){g(T{\"ecdgaebhghhgagcghgbcghhgagaeeeahcddfdbafdafacfhcbbeghheehcegbdfgcffdfbfffefggfab"
			"chchfgedddffecehbhbebhcefhfhcfghebhcfc\"},T{xxxxxxxxxxxxxxx()}())}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(\n"
			"\t\t\tT{\"ecdgaebhghhgagcghgbcghhgagaeeeahcddfdbafdafacfhcbbeghheehcegbdfgcffdfbfffefggfabchchf"
			"gedddffe\"\n"
			"\t\t\t\t\t\"cehbhbebhcefhfhcfghebhcfc\"},\n"
			"\t\t\tT{xxxxxxxxxxxxxxx()}())\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A layout is read back with the fill decisions inside it checked too, as a second
// format checks them, so the argument of `x(`, with the `__c_call` that wraps inside
// it, starts below `x(`, where a second format puts it.
func TestStableNestedChecked() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){(func(y int){x=func(y int){}})\n"
			"if(x(f(\"aaaaaaaaaaaaaaaaaaaaaaaaaaa\",__c_call(\"sym\",int,longFunctionName(),g(cast(int,\"aaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"a\"),m(),f().x))),func(){T{}[qqqqqqqqqqqqqqqqqqqqqqqqq]}(g((pkg()),f[int](func(){}),pkg{(int)})"
			"))){}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tfunc(y int) { x = func(y int) {} }\n"
			"\tif x(\n"
			"\t\t\tf(\"aaaaaaaaaaaaaaaaaaaaaaaaaaa\", __c_call(\"sym\", int, longFunctionName(),\n"
			"\t\t\t\t\tg(cast(int, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\"aaaaaaaaaaaa\"), m(), f().x))),\n"
			"\t\t\tfunc() { T{}[qqqqqqqqqqqqqqqqqqqqqqqqq] }(g(pkg(), f[int](func() {}), pkg{int}))) {}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A list's element before the last is checked with the decisions inside it checked:
// `_(…)`, so rendered, starts with a longer line on a continuation line than after
// `ee(`, so it moves below `ee(`, as a second format would move it.
func TestStableNotLastChecked() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"func g(){ee(_(((f[int](p,func(){}))),cast(int,f(value,S{(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")},func(y int"
			"){longFunctionName()}))), x)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tee(\n"
			"\t\t\t_(f[int](p, func() {}), cast(int, f(value,\n"
			"\t\t\t\t\tS{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\"aaaaaaaaaaaaaaaaaa\"},\n"
			"\t\t\t\t\tfunc(y int) { longFunctionName() }))),\n"
			"\t\t\tx)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A layout printed in place of an element holds the element's comments, which then
// print once: the function literal's `// c5` in the label printed as its moved
// layout reads back after `case xx,`.
func TestStableCommentInReadBack() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"func g(){switch{case xx,__c_call(\"sym\",int,longFunctionName()[len(f(pfield,\"aaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaa\",81513).x)],func(){(qqqqqqqqqqqqqqqqqqq) // c5\n"
			"},qqqqqqqqqqqqqqq):\n"
			"}}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tswitch {\n"
			"\tcase xx, __c_call(\"sym\", int, longFunctionName()[\n"
			"\t\t\tlen(f(pfield, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaa\", 81513).x)], func()"
			" {\n"
			"\t\t\t\tqqqqqqqqqqqqqqqqqqq // c5\n"
			"\t\t\t}, qqqqqqqqqqqqqqq):\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A layout other than the decision's is measured by the lines the width cap applies
// to: the literal's `// LONG-LINE ALLOWED` line does not count, so it moves below `h(`,
// where a second format keeps it.  Left after `h(`, with its first string run split
// for that place, a second format would move it.
func TestStableMarkedLineNotCounted() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\tx = h(func() {\n"
			"\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaa\"\"aaaaaaaaaaa"
			"aaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" +\n"
			"\t\t\t\t\t\t\t\"aaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaa\"\"aaaaaaa\"\"aaaaaaaaaaaaaaaa"
			"a\"\"aaaaaaaaaaaaaaaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t}) + 1\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tif c0 {\n"
			"\t\tif c1 {\n"
			"\t\t\tif c2 {\n"
			"\t\t\t\tif c3 {\n"
			"\t\t\t\t\tx = h(\n"
			"\t\t\t\t\t\t\tfunc() {\n"
			"\t\t\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\t\t\t\"aaaaaaaaaaaaaaaaa\" +\n"
			"\t\t\t\t\t\t\t\t\t\t\"aaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaa\" \"aaaaaaa\" \"aaaaaaa"
			"aaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t\t\t}) + 1\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A list's lone element with something after its close (`h(func() {...}() + "y")()`)
// is measured with less after it than it prints with, and takes a layout read back as
// well when neither place's holds: here the binary stays after `h(`, printed as its
// layout below `h(` reads back there, which a second format keeps.
func TestStableLoneArgReadBack() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){{{{{{{{h(func(){_=\"aaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaa\"\"aaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaa\"+\n"
			"\"aaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaa\"\"aa"
			"aaaaaaaaaaa\"\"aaaaaaaaaaaa\"// LONG-LINE ALLOWED\n"
			"}()+\"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
			"yyyyyyyyyyy\")()}}}}}}}}"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\t{\n"
			"\t\t{\n"
			"\t\t\t{\n"
			"\t\t\t\t{\n"
			"\t\t\t\t\t{\n"
			"\t\t\t\t\t\t{\n"
			"\t\t\t\t\t\t\t{\n"
			"\t\t\t\t\t\t\t\th(func() {\n"
			"\t\t\t\t\t\t\t\t\t_ = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n"
			"\t\t\t\t\t\t\t\t\t\t\t\"aaaaaaaaa\" +\n"
			"\t\t\t\t\t\t\t\t\t\t\t\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" // LONG-LINE ALLOWED\n"
			"\t\t\t\t\t\t\t\t}() +\n"
			"\t\t\t\t\t\t\t\t\t\t\"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
			"yyyyyyyyyyyyyyyyyyyyyyyyyyy\")()\n"
			"\t\t\t\t\t\t\t}\n"
			"\t\t\t\t\t\t}\n"
			"\t\t\t\t\t}\n"
			"\t\t\t\t}\n"
			"\t\t\t}\n"
			"\t\t}\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A layout read back is not taken when, with what follows it as it prints, it puts a
// line the width cap applies to past it, though the decision's layout has a
// `// LONG-LINE ALLOWED` line wider still: the decision's layout stands, and only the
// marked line runs past the cap.
func TestStableReadBackKeepsTheCap() testing.TestResult {
	var src *[]readonly char = "package\"p\"\n"
			"func g(){if c0{if c1{if c2{if c3{h(k(func(){x:=\"aaaaaaaaaaaaa\"\"aaaaa\"\"aaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\"aaaaaaaaaaaaaaaa\"\"aaaaaaaaaaa\"\"aaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaa\"+\n"
			"\"aaaaaaaaaaaaa\"\"aaaaaaaaaaa\"\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"// LONG-LINE A"
			"LLOWED\n"
			"},\"zzzzzzzzzzzzzz\"\n"
			"\"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
			"yyyyyyyy\"))+1}}}}}"
	var out @[]readonly char = Format(parseCollected(src))
	var lineStart int = 0
	for i := 0; i <= len(out); i++ {
		if i == len(out) || out[i] == '\n' {
			if i - lineStart > MAX_LINE_WIDTH && !containsMarker(out[lineStart:i]) {
				return "a line without the marker runs past the cap"
			}
			lineStart = i + 1
		}
	}
	return ""
}
