package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatStmt renders a statement to canonical source text at indentation depth 0
// (nested blocks indent relative to that).
func FormatStmt(s @ast.Stmt) @[]readonly char {
	resetRenderCache()
	var b @strings.Builder = strings.NewBuilder()
	printStmt(b, nil, s, 0)
	dropRenderCache()
	return b.String()
}

// writeIndent appends n tab characters.
func writeIndent(b @strings.Builder, n int) {
	for i := 0; i < n; i++ {
		b.WriteByte('\t')
	}
}

// currentLineIndent returns the number of leading tabs on the builder's current
// (last) line -- the indentation depth at which the caller is emitting.  Used to
// indent a function literal's body, which is reached through the expression
// printer (which does not thread an indent) but must nest under the statement it
// appears in.
func currentLineIndent(b @strings.Builder) int {
	var s @[]readonly char = b.String()
	var n int = len(s)
	var lineStart int = 0
	for i := n - 1; i >= 0; i-- {
		if s[i] == '\n' {
			lineStart = i + 1
			break
		}
	}
	var indent int = 0
	for i := lineStart; i < n; i++ {
		if s[i] != '\t' { break }
		indent = indent + 1
	}
	return indent
}

// printBlock appends a brace-delimited statement block.  A block the source
// kept on one line is re-emitted single-line (`{ s1; s2 }`) when it has no
// interior comment and the rendering fits within MAX_LINE_WIDTH at the current
// column, or on a `// LONG-LINE ALLOWED` line (wrapSuppressed), which is kept
// whole -- with its comments, when they all sit in its lists, which print them
// (expanded, the marker would end up on the block's last line, unmarking the
// lines above it); otherwise it expands to one statement per line
// (printBlockMulti).
func printBlock(b @strings.Builder, cc @commentCursor, blk @ast.Stmt, indent int) {
	printBlockTail(b, cc, blk, indent, 0)
}

// printBlockTail is printBlock for a block followed on its last line by tail
// bytes (a function literal's enclosing close, a comma, the comments after a
// statement), which its single-line form must leave room for.
func printBlockTail(b @strings.Builder, cc @commentCursor, blk @ast.Stmt, indent int, tail int) {
	var commented bool = commentInBlock(cc, blk) || commentBefore(cc, blk.End)
	if blk.Pos.Line == blk.End.Line && (wrapSuppressed || !commented) {
		var scratch @strings.Builder = strings.NewBuilder()
		printBlockSingleTrial(scratch, blk, indent)
		var s @[]readonly char = scratch.String()
		// The trial's lists claim the comments in their gaps; one they leave (between
		// statements) is placed only by printBlockMulti.
		if !hasNewline(s) && !commentBefore(cc, blk.End) &&
				(wrapSuppressed || lineWidth(b) + len(s) + tail <= MAX_LINE_WIDTH) {
			b.Write(s)
			return
		}
	}
	printBlockMulti(b, cc, blk, indent)
}

// commentInBlock reports whether a comment of cc lies inside blk -- one its lists
// print as well as one they leave.  A list claims its comments whenever it
// renders (claimGap), so the cursor holds them as pending or as claimed depending
// on whether a measurement rendered the block's statement before it prints; the
// block's layout does not depend on which.  With no cursor (a measurement's
// rendering) it looks in activeCursor, the cursor of the code being printed, so a
// measurement sees the layout the block prints in; false when there is none.
func commentInBlock(cc @commentCursor, blk @ast.Stmt) bool {
	var c @commentCursor = cc
	if c == nil { c = activeCursor }
	if c == nil { return false }
	var k int = firstAfter(c, blk.Pos)
	return k < len(c.comments) && posLess(c.comments[k].Pos, blk.End)
}

// printBlockSingleTrial renders blk on a single physical line -- `{ s1; s2 }`,
// or `{}` when empty -- with only the comments its lists print (claimGap); the
// caller checks none is left.  Statements go through the deciding printStmt,
// so a nested construct that must expand injects a newline; the caller detects
// that and falls back to the multi-line form.
func printBlockSingleTrial(b @strings.Builder, blk @ast.Stmt, indent int) {
	var stmts @[]@ast.Stmt = printedStmts(blk.Stmts)
	b.WriteByte('{')
	for i := 0; i < len(stmts); i++ {
		if i == 0 {
			b.WriteByte(' ')
		} else {
			b.Write("; ")
		}
		printStmt(b, nil, stmts[i], indent)
	}
	if len(stmts) > 0 {
		b.WriteByte(' ')
	}
	b.WriteByte('}')
}

// printedStmts returns the statements of list the printer emits: all but the
// empty ones (a written `;;`), which print as nothing -- left in, one would still
// get its own line, a blank line the source does not have, or a `; ` separator.
func printedStmts(list @[]@ast.Stmt) @[]@ast.Stmt {
	var n int = 0
	for i := 0; i < len(list); i++ {
		if list[i].Kind != ast.STMT_EMPTY { n = n + 1 }
	}
	if n == len(list) { return list }
	var out @[]@ast.Stmt = make_slice(@ast.Stmt, n)
	var k int = 0
	for i := 0; i < len(list); i++ {
		if list[i].Kind != ast.STMT_EMPTY {
			out[k] = list[i]
			k = k + 1
		}
	}
	return out
}

// printBlockMulti appends a block with each statement on its own line indented
// one level past `indent`, with leading own-line comments before it and a
// trailing comment on its last line, and the comments after the `{` on its line
// after it there.  A dangling comment (one with no following statement) is flushed
// before the closing brace.  An empty block with no comments prints `{}`.
func printBlockMulti(b @strings.Builder, cc @commentCursor, blk @ast.Stmt, indent int) {
	var stmts @[]@ast.Stmt = printedStmts(blk.Stmts)
	b.WriteByte('{')
	var opened bool = emitBraceComments(b, cc, blk.Pos, blockStart(blk))
	printStmtLines(b, cc, stmts, indent + 1, blk.End)
	var dangling bool = emitLeadingComments(b, cc, blk.End, indent + 1, false)
	if len(stmts) > 0 || dangling || opened {
		b.WriteByte('\n')
		writeIndent(b, indent)
	}
	b.WriteByte('}')
}

// printStmtLines appends stmts at indent, each on a line of its own after a newline,
// with the own-line comments before it, a blank line the source has before it, and
// the comments after it on its line, before the next statement or close (the
// enclosing `}`, or the next case): the source can go on past a statement on its
// line, and the comments from the next node on are not the statement's.  A `//
// LONG-LINE ALLOWED` line of several statements is kept as written
// (printMarkedStmts); one that cannot be prints one statement per line, as an
// unmarked line does, the marker after the last.
func printStmtLines(b @strings.Builder, cc @commentCursor, stmts @[]@ast.Stmt, indent int,
		close token.Pos) {
	// The statements before split are those of a marked line that could not be kept.
	var split int = 0
	var i int = 0
	for i < len(stmts) {
		if i > 0 && hasBlankGap(cc, stmts[i - 1].End.Line, stmtStartPos(stmts[i]).Line) {
			b.WriteByte('\n')
		}
		emitLeadingComments(b, cc, stmtStartPos(stmts[i]), indent, true)
		b.WriteByte('\n')
		writeIndent(b, indent)
		var j int = i + 1
		var end int = j
		if i >= split { end = markedStmtRunEnd(cc, stmts, i, close) }
		if end > j && printMarkedStmts(b, cc, stmts, i, end, indent) {
			j = end
		} else {
			if end > j { split = end }
			printStmtMaybeNoWrap(b, cc, stmts[i], indent, stmtLimit(stmts, j, close))
		}
		emitTrailingCommentBefore(b, cc, stmts[j - 1].End, stmtLimit(stmts, j, close))
		i = j
	}
}

// stmtLimit returns where the comments of the statement before stmts[j] end: at the
// start of stmts[j], or at close (the enclosing `}`, or the next case) when there is
// none.
func stmtLimit(stmts @[]@ast.Stmt, j int, close token.Pos) token.Pos {
	if j < len(stmts) { return stmtStartPos(stmts[j]) }
	return close
}

// printStmt appends a single statement's text (no leading indentation or trailing
// newline -- the enclosing block supplies those).  Nested blocks indent relative
// to `indent`.  cc (may be nil) carries comment interleaving into nested blocks.
func printStmt(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	printStmtTail(b, cc, s, indent, 0)
}

// printStmtTail is printStmt for a statement followed on its last line by tail
// bytes (the comments after it there, printStmtTrailing), which its width checks
// leave room for.  A switch ends on a `}` of its own.
func printStmtTail(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int, tail int) {
	if s == nil { return }
	var k int = s.Kind
	if k == ast.STMT_EXPR { printExprTail(b, s.X, tail); return }
	if k == ast.STMT_ASSIGN { printAssign(b, s, tail); return }
	if k == ast.STMT_SHORT_VAR { printShortVar(b, s, tail); return }
	if k == ast.STMT_INC_DEC {
		printIncDec(b, s, false, tail)
		return
	}
	if k == ast.STMT_RETURN { printReturn(b, s, tail); return }
	if k == ast.STMT_BREAK { b.Write("break"); return }
	if k == ast.STMT_CONTINUE { b.Write("continue"); return }
	if k == ast.STMT_IF { printIf(b, cc, s, indent, tail); return }
	if k == ast.STMT_FOR { printFor(b, cc, s, indent, tail); return }
	if k == ast.STMT_SWITCH { printSwitch(b, cc, s, indent); return }
	if k == ast.STMT_TYPE_SWITCH { printTypeSwitch(b, cc, s, indent); return }
	if k == ast.STMT_BLOCK { printBlockTail(b, cc, s, indent, tail); return }
	if k == ast.STMT_DECL {
		if s.DeclRef != nil {
			printAnnotationsBefore(b, cc, s.DeclRef.Annotations, s.DeclRef.Pos)
			printDeclBodyTail(b, cc, s.DeclRef, tail)
		}
		return
	}
	if k == ast.STMT_DEFER {
		b.Write("defer")
		writeOpenGap(b, s.Pos, s.Body.Pos, s.Pos, indent)
		printBlockTail(b, cc, s.Body, indent, tail)
		return
	}
	if k == ast.STMT_EMPTY { return }
	// A statement kind with no case here would otherwise be dropped from the
	// output without a word -- silently deleting code.
	panic("bnfmt: printStmt has no case for this statement kind")
}

// printSimpleStmtCond prints a simple statement (a C-style for loop's init or
// post) with its expressions in the header's no-composite-literal context, so an
// exposed composite literal of a type name keeps its D4 parens, and the comments
// inside it (print_stmtgaps.bn).  Covers the simple-statement kinds the for-clause
// can produce (expr / assign / short-var / inc-dec / empty).
func printSimpleStmtCond(b @strings.Builder, s @ast.Stmt) {
	if s == nil { return }
	var k int = s.Kind
	if k == ast.STMT_EXPR { printExprCond(b, s.X); return }
	if k == ast.STMT_ASSIGN || k == ast.STMT_SHORT_VAR {
		var cont int = currentLineIndent(b) + 2
		var op *[]readonly char = ":="
		if k == ast.STMT_ASSIGN { op = token.TypeName(cast(token.Type, s.Op)) }
		printLhs(b, s.Exprs, s.Pos, true, cont)
		writeOpGap(b, op, claimGap(s.Pos, exprStartPos(s.Exprs2[0]), s.Pos), cont)
		var none token.Pos
		printExprListGaps(b, s.Exprs2, none, true, cont)
		return
	}
	if k == ast.STMT_INC_DEC {
		printIncDec(b, s, true, 0)
		return
	}
	if k == ast.STMT_EMPTY { return }
	panic("bnfmt: printSimpleStmtCond has no case for this statement kind")
}

// printAssign appends `lhs op rhs` -- op is `=` or a compound assignment
// (`+=`, `<<=`, ...); both sides are comma-separated expression lists.  A
// single-value RHS wraps onto a `+1` continuation when it overflows; a
// multi-value RHS fills.  The comments inside it go where the source put them
// (print_stmtgaps.bn).  tail bytes follow it on its last line.
func printAssign(b @strings.Builder, s @ast.Stmt, tail int) {
	var op *[]readonly char = token.TypeName(cast(token.Type, s.Op))
	printLhs(b, s.Exprs, s.Pos, false, currentLineIndent(b) + 2)
	if len(s.Exprs2) == 1 {
		printRhsGap(b, op, s.Pos, s.Exprs2[0], tail)
	} else {
		printValuesGap(b, op, s.Pos, s.Exprs2, tail)
	}
}

// printShortVar appends `names := rhs`, wrapping the RHS like printAssign.
func printShortVar(b @strings.Builder, s @ast.Stmt, tail int) {
	printLhs(b, s.Exprs, s.Pos, false, currentLineIndent(b) + 2)
	if len(s.Exprs2) == 1 {
		printRhsGap(b, ":=", s.Pos, s.Exprs2[0], tail)
	} else {
		printValuesGap(b, ":=", s.Pos, s.Exprs2, tail)
	}
}

// printReturn appends `return` with optional results: a single result stays on the
// `return` line (self-wrapping if it can), a multi-value list fills onto `+1`
// continuations with the first value kept on the `return` line.  The block comments
// on one line after `return` stay there (a line break would end the statement), and
// those between the results go there.  tail bytes follow it on its last line.
func printReturn(b @strings.Builder, s @ast.Stmt, tail int) {
	b.Write("return")
	if len(s.Exprs) > 0 {
		var cont int = currentLineIndent(b) + 1
		_ = writeInlineComments(b, claimInlineGap(s.Pos, exprStartPos(s.Exprs[0]), s.Pos))
		b.WriteByte(' ')
		printValueListWrapped(b, s.Exprs, tail, cont)
	}
}

// printFuncLit appends `func(params) results { body }` for a function literal in
// expression position, with tail bytes after it on its last line, and the comments
// in its signature (print_sig.bn).  The body indents under the statement the
// literal appears in (recovered from the builder's current line).
func printFuncLit(b @strings.Builder, e @ast.Expr, tail int) {
	var d @ast.Decl = e.DeclRef
	var rec @ast.Signature = signatureOf(e.Pos)
	var savedHold token.Pos = clearHold()
	b.Write("func")
	writeGapSeparator(b, claimGap(e.Pos, rec.Open, rec.Open), currentLineIndent(b) + 2, false, false)
	var next token.Pos
	var after int = 0
	if d.Body != nil {
		next = d.Body.Pos
		// A body that prints empty is followed on the signature's line by the tail,
		// another by its `{` and the comments after that on its line.  Unlike a
		// declaration's (funcBodyLen), it gets none of the comments the signature
		// leaves pending: its cursor takes only those inside it.
		after = withTrail(2, braceTrailWidth(activeCursor, d.Body.Pos, blockStart(d.Body)),
				currentLineIndent(b) + 2)
		if emptyBody(d.Body) { after = 3 + tail }
	}
	printSigLists(b, d.Params, d.Results, rec, e.Pos.Line, next, after)
	claimHold = savedHold
	if d.Body != nil {
		b.WriteByte(' ')
		// The body interleaves its own comments, as a statement block does, through
		// a cursor of its own (the expression printer threads none); it is the
		// active cursor for a literal nested inside.
		var local @commentCursor = literalBodyCursor(d.Body)
		var saved @commentCursor = activeCursor
		activeCursor = local
		// The body's statements are laid out as they print, whatever measure the
		// literal is under: a right-hand side keeps the lone elements of its own
		// lists on their lines to decide whether it stays inline (rhsInlineFits),
		// not those of the statements of a literal in it.
		var savedLone bool = loneStays
		loneStays = false
		printBlockTail(b, local, d.Body, currentLineIndent(b), tail)
		loneStays = savedLone
		activeCursor = saved
	}
}
