package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatStmt renders a statement to canonical source text at indentation depth 0
// (nested blocks indent relative to that).
func FormatStmt(s @ast.Stmt) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	printStmt(b, nil, s, 0)
	return b.String()
}

// writeIndent appends n tab characters.
func writeIndent(b @strings.Builder, n int) {
	for i := 0; i < n; i++ {
		b.WriteByte('\t')
	}
}

// currentLineIndent returns the number of leading tabs on the builder's current
// (last) line -- the indentation depth at which the caller is emitting.  Used to
// indent a function literal's body, which is reached through the expression
// printer (which does not thread an indent) but must nest under the statement it
// appears in.
func currentLineIndent(b @strings.Builder) int {
	var s @[]readonly char = b.String()
	var n int = len(s)
	var lineStart int = 0
	for i := n - 1; i >= 0; i-- {
		if s[i] == '\n' {
			lineStart = i + 1
			break
		}
	}
	var indent int = 0
	for i := lineStart; i < n; i++ {
		if s[i] != '\t' { break }
		indent = indent + 1
	}
	return indent
}

// printBlock appends a brace-delimited statement block.  A block the source
// kept on one line is re-emitted single-line (`{ s1; s2 }`) when it has no
// interior comment and the rendering fits within MAX_LINE_WIDTH at the current
// column; otherwise it expands to one statement per line (printBlockMulti).
func printBlock(b @strings.Builder, cc @commentCursor, blk @ast.Stmt, indent int) {
	if blk.Pos.Line == blk.End.Line && !commentBefore(cc, blk.End) {
		var scratch @strings.Builder = strings.NewBuilder()
		printBlockSingleTrial(scratch, blk, indent)
		var s @[]readonly char = scratch.String()
		if !hasNewline(s) && lineWidth(b) + len(s) <= MAX_LINE_WIDTH {
			b.Write(s)
			return
		}
	}
	printBlockMulti(b, cc, blk, indent)
}

// printBlockSingleTrial renders blk on a single physical line -- `{ s1; s2 }`,
// or `{}` when empty -- with no interleaved comments (the caller only tries this
// when the span is comment-free).  Statements go through the deciding printStmt,
// so a nested construct that must expand injects a newline; the caller detects
// that and falls back to the multi-line form.
func printBlockSingleTrial(b @strings.Builder, blk @ast.Stmt, indent int) {
	b.WriteByte('{')
	for i := 0; i < len(blk.Stmts); i++ {
		if i == 0 {
			b.WriteByte(' ')
		} else {
			b.Write("; ")
		}
		printStmt(b, nil, blk.Stmts[i], indent)
	}
	if len(blk.Stmts) > 0 {
		b.WriteByte(' ')
	}
	b.WriteByte('}')
}

// printBlockMulti appends a block with each statement on its own line indented
// one level past `indent`, with leading own-line comments before it and a
// trailing comment on its last line.  A dangling comment (one with no following
// statement) is flushed before the closing brace.  An empty block with no
// comments prints `{}`.
func printBlockMulti(b @strings.Builder, cc @commentCursor, blk @ast.Stmt, indent int) {
	b.WriteByte('{')
	for i := 0; i < len(blk.Stmts); i++ {
		if i > 0 && hasBlankGap(cc, blk.Stmts[i - 1].End.Line, blk.Stmts[i].Pos.Line) {
			b.WriteByte('\n')
		}
		emitLeadingComments(b, cc, blk.Stmts[i].Pos, indent + 1)
		b.WriteByte('\n')
		writeIndent(b, indent + 1)
		printStmtMaybeNoWrap(b, cc, blk.Stmts[i], indent + 1)
		emitTrailingComment(b, cc, blk.Stmts[i].End)
	}
	var dangling bool = emitLeadingComments(b, cc, blk.End, indent + 1)
	if len(blk.Stmts) > 0 || dangling {
		b.WriteByte('\n')
		writeIndent(b, indent)
	}
	b.WriteByte('}')
}

// printStmt appends a single statement's text (no leading indentation or trailing
// newline -- the enclosing block supplies those).  Nested blocks indent relative
// to `indent`.  cc (may be nil) carries comment interleaving into nested blocks.
func printStmt(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	if s == nil { return }
	var k int = s.Kind
	if k == ast.STMT_EXPR { printExpr(b, s.X); return }
	if k == ast.STMT_ASSIGN { printAssign(b, s); return }
	if k == ast.STMT_SHORT_VAR { printShortVar(b, s); return }
	if k == ast.STMT_INC_DEC {
		printExpr(b, s.X)
		b.Write(token.TypeName(cast(token.Type, s.Op)))
		return
	}
	if k == ast.STMT_RETURN { printReturn(b, s); return }
	if k == ast.STMT_BREAK { b.Write("break"); return }
	if k == ast.STMT_CONTINUE { b.Write("continue"); return }
	if k == ast.STMT_IF { printIf(b, cc, s, indent); return }
	if k == ast.STMT_FOR { printFor(b, cc, s, indent); return }
	if k == ast.STMT_SWITCH { printSwitch(b, cc, s, indent); return }
	if k == ast.STMT_BLOCK { printBlock(b, cc, s, indent); return }
	if k == ast.STMT_DECL {
		if s.DeclRef != nil { printDecl(b, cc, s.DeclRef) }
		return
	}
	// STMT_EMPTY prints nothing.
}

// printSimpleStmtCond prints a simple statement (a C-style for loop's init or
// post) with its expressions in the header's no-composite-literal context, so an
// exposed composite keeps its D4 parens.  Covers the simple-statement kinds the
// for-clause can produce (expr / assign / short-var / inc-dec / empty).
func printSimpleStmtCond(b @strings.Builder, s @ast.Stmt) {
	if s == nil { return }
	var k int = s.Kind
	if k == ast.STMT_EXPR { printExprCond(b, s.X); return }
	if k == ast.STMT_ASSIGN {
		printExprListCond(b, s.Exprs)
		b.WriteByte(' ')
		b.Write(token.TypeName(cast(token.Type, s.Op)))
		b.WriteByte(' ')
		printExprListCond(b, s.Exprs2)
		return
	}
	if k == ast.STMT_SHORT_VAR {
		printExprListCond(b, s.Exprs)
		b.Write(" := ")
		printExprListCond(b, s.Exprs2)
		return
	}
	if k == ast.STMT_INC_DEC {
		printExprCond(b, s.X)
		b.Write(token.TypeName(cast(token.Type, s.Op)))
		return
	}
	// STMT_EMPTY prints nothing.
}

// printExprListCond prints a comma-separated expression list in exposed
// (control-clause) context, so an exposed composite in any element is D4-parened.
func printExprListCond(b @strings.Builder, list @[]@ast.Expr) {
	for i := 0; i < len(list); i++ {
		if i > 0 { b.Write(", ") }
		printExprCond(b, list[i])
	}
}

// printAssign appends `lhs op rhs` -- op is `=` or a compound assignment
// (`+=`, `<<=`, ...); both sides are comma-separated expression lists.
func printAssign(b @strings.Builder, s @ast.Stmt) {
	printExprList(b, s.Exprs)
	b.WriteByte(' ')
	b.Write(token.TypeName(cast(token.Type, s.Op)))
	b.WriteByte(' ')
	printExprList(b, s.Exprs2)
}

// printShortVar appends `names := rhs`.
func printShortVar(b @strings.Builder, s @ast.Stmt) {
	printExprList(b, s.Exprs)
	b.Write(" := ")
	printExprList(b, s.Exprs2)
}

// printReturn appends `return` with optional space-separated results.
func printReturn(b @strings.Builder, s @ast.Stmt) {
	b.Write("return")
	if len(s.Exprs) > 0 {
		b.WriteByte(' ')
		printExprList(b, s.Exprs)
	}
}

// printIf appends `if cond { body }` with an optional `else` (a block) or
// `else if` (a chained if).  The condition is a control-clause context, so D4
// composite-literal parens apply.
func printIf(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	b.Write("if ")
	printExprCond(b, s.X)
	b.WriteByte(' ')
	printBlock(b, cc, s.Body, indent)
	if s.Else != nil {
		b.Write(" else ")
		if s.Else.Kind == ast.STMT_IF {
			printStmt(b, cc, s.Else, indent)
		} else {
			printBlock(b, cc, s.Else, indent)
		}
	}
}

// printFor appends any of the for-loop forms: for-in (`for v in c` / `for k, v in
// c`), C-style (`for init; cond; post`), while-style (`for cond`), or infinite
// (`for`).  The iterator, condition, AND the C-style init/post are all
// control-clause contexts: the parser suppresses bare composites across the whole
// header, so an exposed composite in any of them keeps its D4 parens.
func printFor(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	b.Write("for")
	if s.ForVal != nil {
		b.WriteByte(' ')
		if s.ForKey != nil {
			printExpr(b, s.ForKey)
			b.Write(", ")
		}
		printExpr(b, s.ForVal)
		b.Write(" in ")
		printExprCond(b, s.X)
		b.WriteByte(' ')
	} else if s.Init != nil {
		b.WriteByte(' ')
		printSimpleStmtCond(b, s.Init)
		b.Write("; ")
		if s.X != nil { printExprCond(b, s.X) }
		b.Write("; ")
		if s.Post != nil { printSimpleStmtCond(b, s.Post) }
		b.WriteByte(' ')
	} else if s.X != nil {
		b.WriteByte(' ')
		printExprCond(b, s.X)
		b.WriteByte(' ')
	} else {
		b.WriteByte(' ')
	}
	printBlock(b, cc, s.Body, indent)
}

// printFuncLit appends `func(params) results { body }` for a function literal in
// expression position.  The body indents under the statement the literal appears
// in (recovered from the builder's current line).
func printFuncLit(b @strings.Builder, e @ast.Expr) {
	var d @ast.Decl = e.DeclRef
	b.Write("func")
	printParamList(b, d.Params, e.Pos.Line, sigSuffixLen(d.Results, d.Body != nil))
	printResults(b, d.Results)
	if d.Body != nil {
		b.WriteByte(' ')
		// nil cursor: the expression printer does not thread comments, so a
		// comment inside a function-literal body is not interleaved within the
		// body.  It is not lost: the enclosing block's next emitLeadingComments
		// flushes it (own-line, at the enclosing indent) once emission passes its
		// position -- near its source, not scrambled to the end-of-file backstop.
		printBlock(b, nil, d.Body, currentLineIndent(b))
	}
}
