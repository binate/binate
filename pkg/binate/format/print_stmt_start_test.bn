package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests of where a statement starts (stmtStartPos / exprStartPos): at its first
// token, not at the operator its Pos records, when its left operand spans lines.

// Through `++`, an index, a type assertion, a slice and a binary operand, a
// statement whose left operand is a function literal called directly keeps the
// literal's comments in place and gains no blank line.
func TestStmtStartThroughOperators() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tg()\n"
			"\tfunc() @[]int {\n"
			"\t\treturn s // c1\n"
			"\t}()[0]++\n"
			"\tfunc() *any {\n"
			"\t\treturn a // c2\n"
			"\t}().(I).M()\n"
			"\tfunc() @[]int {\n"
			"\t\treturn s // c3\n"
			"\t}()[1:].M()\n"
			"\t(func() T {\n"
			"\t\treturn t // c4\n"
			"\t}() + y).M()\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A grouped member whose value is a function literal called directly starts at
// `func`: the literal's comment stays in it, and no blank line is added.
func TestStmtStartGroupedMember() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"var (\n"
			"\ta = 1\n"
			"\tb = func() int {\n"
			"\t\treturn 2 // two\n"
			"\t}()\n"
			")\n"
	return checkFormatGolden(src, src)
}

// A case body statement that starts on the label line keeps the case on one
// line, though its Pos (the `=`) is on the next line.
func TestStmtStartCaseOnLabelLine() testing.TestResult {
	return checkFormatGolden(
			"package \"t\"\n"
					"\n"
					"func f(v int) {\n"
					"\tswitch v {\n"
					"\tcase 1: x.\n"
					"\t\ty = 2\n"
					"\t}\n"
					"}\n",
			"package \"t\"\n"
					"\n"
					"func f(v int) {\n"
					"\tswitch v {\n"
					"\tcase 1: x.y = 2\n"
					"\t}\n"
					"}\n")
}

// A `// LONG-LINE ALLOWED` marker after a directly called function literal's
// `}()` governs that line only: a long call inside the literal still wraps.
func TestStmtStartLongLineMarker() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\tfunc() {\n"
			"\t\tx := g(argOneAaaaaaaaaaaaaa, argTwoBbbbbbbbbbbbbb, argThreeCcccccccccccc, "
			"argFourDddddddddddddd, argFiveEeeeeeeeeeeeee)\n"
			"\t}() // LONG-LINE ALLOWED\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if containsSub(out, longCallText()) {
		return tokDiff("a marker after `}()` suppressed wrapping inside the literal", out, "")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("a line exceeds the width cap", out, "")
	}
	return ""
}
