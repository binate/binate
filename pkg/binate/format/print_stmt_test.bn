package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseFuncSrc parses a whole top-level function (with a body) and returns it.
// Ordinary (.bn) mode via parser.New so the body is present.
func parseFuncSrc(src *[]readonly char) @ast.Decl {
	var full @strings.Builder = strings.NewBuilder()
	full.Write("package \"t\"\n")
	full.Write(src)
	full.WriteByte('\n')
	var p @parser.Parser = parser.New(toBytes(full.String()), "t.bn")
	var f @ast.File = mustParse(p)
	if len(f.Decls) == 0 { return nil }
	return f.Decls[0]
}

// checkFunc round-trips a whole function (signature + body) through FormatDecl
// and asserts token-equality (§11.1).  Statement inputs must be canonically
// parenthesized (as expressions are).
func checkFunc(src *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseFuncSrc(src)
	if d == nil {
		return tokDiff("parse produced no func", src, "")
	}
	var out @[]readonly char = FormatDecl(d)
	return assertTokenEq(src, out)
}

func TestStmtBasics() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { return 1 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() {}")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { x := 1; y := 2; return x + y }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() (int, int) { return 1, 2 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { g() }")
	if len(r) > 0 { return r }
	return ""
}

// A `defer` statement with a block round-trips, short on one line or long over
// several; the block sits after `defer` like an `if`'s.
func TestStmtDeferBlock() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { defer { g() }; defer { g(); h() }; g() }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if x { defer { o.Close() } } }")
	if len(r) > 0 { return r }
	r = checkFunc(
			"func f() { defer { h(aaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb); "
					"cccccccccccccccccccccccc(dddddddddddddddddddddddd) } }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtAssign() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { a = b }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { a += 1 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { a <<= 2 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { a, b = b, a }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { i++ }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { j-- }")
	if len(r) > 0 { return r }
	// All ten compound assignments route through token.TypeName.
	r = checkFunc("func f() { a -= 1; b *= 2; c /= 3; d %= 4 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { e &= 5; g |= 6; h ^= 7; i >>= 8 }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtIf() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if x > 0 { return 1 } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if x { a() } else { b() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if x { a() } else if y { b() } else { c() } }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtFor() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { for { break } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for i < n { i++ } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for i := 0; i < n; i++ { g(i) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for ; i < n; { i++ } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in xs { g(v) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for k, v in m { h(k, v) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for { continue } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in xs.items { g(v) } }")
	if len(r) > 0 { return r }
	// Empty init / cond / post (STMT_EMPTY through the for-clause).
	r = checkFunc("func f() { for i := 0;; i++ { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for ;; { break } }")
	if len(r) > 0 { return r }
	return ""
}

// checkFuncGolden formats a whole function (signature + body) and asserts the
// output is exactly want.
func checkFuncGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseFuncSrc(src)
	if d == nil {
		return tokDiff("parse produced no func", src, "")
	}
	var out @[]readonly char = FormatDecl(d)
	if !streq(out, want) {
		return tokDiff("func format mismatch", out, want)
	}
	return ""
}

// A for-clause header prints byte-exactly: one space after each `;` that a clause
// follows, and none before `{` beyond the single separator (an empty post
// statement adds no second space).
func TestStmtForClauseSpacing() testing.TestResult {
	var r testing.TestResult
	r = checkFuncGolden("func f() { for ;; { break } }", "func f() { for ; ; { break } }")
	if len(r) > 0 { return r }
	r = checkFuncGolden("func f() { for ; i < n; { i++ } }", "func f() { for ; i < n; { i++ } }")
	if len(r) > 0 { return r }
	r = checkFuncGolden("func f() { for i := 0;; i++ { g() } }",
			"func f() { for i := 0; ; i++ { g() } }")
	if len(r) > 0 { return r }
	return checkFuncGolden("func f() { for i := 0; i < n; i++ { g() } }",
			"func f() { for i := 0; i < n; i++ { g() } }")
}

func TestStmtSwitch() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { switch x { case 1: a(); case 2, 3: b(); default: c() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch { case x > 0: a(); default: b() } }")
	if len(r) > 0 { return r }
	// Empty switch, an empty-body case, and a multi-statement case body.
	r = checkFunc("func f() { switch x {} }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch x { case 1: case 2: a(); b(); default: } }")
	if len(r) > 0 { return r }
	return ""
}

// A bare `;` in a block is a STMT_EMPTY (prints nothing).
func TestStmtEmpty() testing.TestResult {
	return checkFunc("func f() { ; }")
}

func TestStmtLocalDecl() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { var x int = 5; const N = 10 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { var p *Node = nil }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtNestedBlock() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { { x := 1; g(x) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if a { if b { c() } } }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtFuncLit() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { g(func() int { return 1 }) }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { var cb = func(x int) { h(x) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { apply(func(a int, b int) int { return a + b }) }")
	if len(r) > 0 { return r }
	// A func literal whose body contains another func literal.
	r = checkFunc("func f() { g(func() int { return h(func() int { return 1 }) }) }")
	if len(r) > 0 { return r }
	return ""
}

// D4: a composite literal exposed to a control-clause's block brace must be
// parenthesized so it isn't misparsed as the block.  These cover the exposed
// composite reached as a binary operand, a selector head, and a unary operand,
// across every control-clause context that threads it (if / for-in / while /
// C-style cond+init+post / switch tag).
func TestStmtD4CompositeCondition() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if (Point{x: 1}).x > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if a == (Point{x: 1}) { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if -(Point{x: 1}).x > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if (Point{}).x + (Foo{}).y > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for (Point{}).ok { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in (Point{x: 1}).items { g(v) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch (Point{}).tag { case 1: a() } }")
	if len(r) > 0 { return r }
	// C-style init, cond, and post are all no-composite contexts.
	r = checkFunc("func f() { for x := (P{}); (Q{}).ok; y = (R{}) { g() } }")
	if len(r) > 0 { return r }
	return ""
}

// D4 negative: a composite inside a call argument / index bracket / builtin
// call's operands / function literal's body / another literal's elements is
// already protected by the enclosing bracket and must NOT get extra parens (else
// the reprint differs from a minimal canonical source).
func TestStmtD4NotExposed() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if g(Point{x: 1}) != nil { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if arr[Point{x: 1}] != nil { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if len(Point{x: 1}) > 0 { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for cast(int, Point{x: 1}) < n { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch __c_call(\"g\", int, Point{x: 1}) { case 1: h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if m[a, Point{x: 1}] != nil { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if func() bool { return Point{x: 1}.ok }() { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if [2]Point{Point{x: 1}} == w { h() } }")
	if len(r) > 0 { return r }
	return ""
}

// The parentheses bnfmt drops around a header leave a composite literal in it
// inside a bracket of its own -- a builtin call's, a function literal's body, an
// index -- so what it writes parses.
func TestStmtD4BracketParensDropped() testing.TestResult {
	var r testing.TestResult = checkHeaderParensDropped("len(S{1})")
	if len(r) > 0 { return r }
	r = checkHeaderParensDropped("cast(int, S{1})")
	if len(r) > 0 { return r }
	r = checkHeaderParensDropped("__c_call(\"sym\", int, S{1})")
	if len(r) > 0 { return r }
	r = checkHeaderParensDropped("func() bool { return S{1}.ok }()")
	if len(r) > 0 { return r }
	return checkHeaderParensDropped("m[a, S{1}]")
}

// An array, slice or managed-slice literal is read bare in a header (D4 leaves out
// only a literal of a type name), so bnfmt writes one in each header position with
// no parentheses, also where the source has them, and what it writes formats to
// itself.  A literal of a generic or another package's type keeps them, and so
// does a raw-slice literal that a postfix operator follows (the grammar makes it
// a unary expression) and an array literal that a `*` precedes (`*[` begins a
// raw-slice literal).
func TestStmtD4ArrayAndSliceLiteralsBare() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif (@[]int{1})[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif w == ([2]int{1, 2}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in ([2]int{1, 2}) {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor v in ([...]int{1}) {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor v in (*[]int{1}) {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tif (*[]int{1})[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in (*[]int{1, 2})[1:] {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tif *([2]*int{p, q})[0] == 1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in *([1]*[]int{s})[0] {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor ([2]bool{true})[i] {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif a {\n"
			"\t\tg()\n"
			"\t} else if (@[]int{1})[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch (@[]int{1})[i] {\n"
			"\tcase 1:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor x := (@[]int{1}); len(x) > 0; x = (@[]int{}) {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif @[]int{1}[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif w == [2]int{1, 2} {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in [2]int{1, 2} {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor v in [...]int{1} {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor v in *[]int{1} {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tif (*[]int{1})[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in (*[]int{1, 2})[1:] {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tif *([2]*int{p, q})[0] == 1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor v in *([1]*[]int{s})[0] {\n"
			"\t\tg(v)\n"
			"\t}\n"
			"\tfor [2]bool{true}[i] {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tif a {\n"
			"\t\tg()\n"
			"\t} else if @[]int{1}[0] > 0 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch @[]int{1}[i] {\n"
			"\tcase 1:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor x := @[]int{1}; len(x) > 0; x = @[]int{} {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var r testing.TestResult = checkGolden(src, want)
	if len(r) > 0 { return r }
	r = checkGolden(want, want)
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if (Vec[int]{}).n > 0 { g() } }")
	if len(r) > 0 { return r }
	return checkFunc("func f() { if (pkg.T{}).ok { g() } }")
}

// checkHeaderParensDropped checks that bnfmt drops the parentheses around x, an
// `if` header, and that what it writes formats to itself (so it parses).
func checkHeaderParensDropped(x *[]readonly char) testing.TestResult {
	var src @strings.Builder = strings.NewBuilder()
	src.Write("package \"t\"\n\nfunc f() {\n\tif (")
	src.Write(x)
	src.Write(") {\n\t\tg()\n\t}\n}\n")
	var want @strings.Builder = strings.NewBuilder()
	want.Write("package \"t\"\n\nfunc f() {\n\tif ")
	want.Write(x)
	want.Write(" {\n\t\tg()\n\t}\n}\n")
	var r testing.TestResult = checkGolden(src.String(), want.String())
	if len(r) > 0 { return r }
	return checkGolden(want.String(), want.String())
}

// A whole ordinary .bn file (function with a body) round-trips through
// Format end to end.
func TestFormatWholeBnFile() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func add(a int, b int) int {\n"
			"\treturn a + b\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	var out @[]readonly char = Format(mustParse(p))
	return assertTokenEq(src, out)
}

// An empty statement (a written `;;`) prints as nothing -- no line of its own in
// a multi-line block or case body, no `; ` separator on a single line -- and a
// block of nothing else prints `{}`.
func TestFormatEmptyStatementsDropped() testing.TestResult {
	var r testing.TestResult = checkGolden("package \"pkg/x\"\n\nfunc f() {\n\tg();;\n\th();;\n}\n",
			"package \"pkg/x\"\n\nfunc f() {\n\tg()\n\th()\n}\n")
	if len(r) > 0 { return r }
	r = checkGolden("package \"pkg/x\"\n\nfunc f() {\n\t;\n}\n", "package \"pkg/x\"\n\nfunc f() {}\n")
	if len(r) > 0 { return r }
	// A line holding only `;` between statements keeps the source's vertical
	// spacing: it formats as a blank line.
	r = checkGolden("package \"pkg/x\"\n\nfunc f() {\n\tg()\n\t;\n\th()\n}\n",
			"package \"pkg/x\"\n\nfunc f() {\n\tg()\n\n\th()\n}\n")
	if len(r) > 0 { return r }
	r = checkGolden("package \"pkg/x\"\n\nfunc f() { g();; h() }\n",
			"package \"pkg/x\"\n\nfunc f() { g(); h() }\n")
	if len(r) > 0 { return r }
	return checkGolden(
			"package \"pkg/x\"\n\nfunc f(x int) {\n\tswitch x {\n\tcase 1:\n\t\tg();;\n"
					"\t\th()\n\tcase 2: g();;\n\t}\n}\n",
			"package \"pkg/x\"\n\nfunc f(x int) {\n\tswitch x {\n\tcase 1:\n\t\tg()\n\t\th()\n"
					"\tcase 2: g()\n\t}\n}\n")
}

// Of two statements on a line, the first takes only the comments before the second: a comment
// inside the second's list stays in it, in a function body as in a nested block.
func TestBlockStatementsTakeTheirOwnComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = f(); g(/* c */ y)\n"
			"\tif ok { a(); g(/* d */ y) } else { b() }\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx = f()\n"
			"\tg(/* c */ y)\n"
			"\tif ok {\n"
			"\t\ta()\n"
			"\t\tg(/* d */ y)\n"
			"\t} else { b() }\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A one-line block holding a comment expands, also when that comment sits in a list in it -- which
// claims it whenever it renders -- and a measurement of the block's statement has rendered it
// before the block prints (the one-line form of a case that expands), or renders the block with no
// cursor (that of a case it would stay on one line in).
func TestOneLineBlockWithAListCommentExpandsAfterAMeasurement() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: if c { xxxxxxxxx(aa /* in */, hhhhhhhhhhhhhhhhhhhhhh, cccccccccccccccccccc) }; if"
			" hhhhhhhh { xxxxx(ggggggggg) }\n"
			"\tcase 2: if c { f(a /* c1 */, b) }\n"
			"\t}\n"
			"\tif c { xxxxxxxxx(aa /* in */, hhhhhhhhhhhhhhhhhhhhhh, cccccccccccccccccccc) }\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:\n"
			"\t\tif c {\n"
			"\t\t\txxxxxxxxx(aa, /* in */ hhhhhhhhhhhhhhhhhhhhhh, cccccccccccccccccccc)\n"
			"\t\t}\n"
			"\t\tif hhhhhhhh { xxxxx(ggggggggg) }\n"
			"\tcase 2:\n"
			"\t\tif c {\n"
			"\t\t\tf(a, /* c1 */ b)\n"
			"\t\t}\n"
			"\t}\n"
			"\tif c {\n"
			"\t\txxxxxxxxx(aa, /* in */ hhhhhhhhhhhhhhhhhhhhhh, cccccccccccccccccccc)\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
