package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// parseFuncSrc parses a whole top-level function (with a body) and returns it.
// Ordinary (.bn) mode via parser.New so the body is present.
func parseFuncSrc(src *[]readonly char) @ast.Decl {
	var full @strings.Builder = strings.NewBuilder()
	full.Write("package \"t\"\n")
	full.Write(src)
	full.WriteByte('\n')
	var p @parser.Parser = parser.New(toBytes(full.String()), "t.bn")
	var f @ast.File = p.ParseFile()
	if len(f.Decls) == 0 { return nil }
	return f.Decls[0]
}

// checkFunc round-trips a whole function (signature + body) through FormatDecl
// and asserts token-equality (§11.1).  Statement inputs must be canonically
// parenthesized (as expressions are).
func checkFunc(src *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseFuncSrc(src)
	if d == nil {
		return tokDiff("parse produced no func", src, "")
	}
	var out @[]readonly char = FormatDecl(d)
	return assertTokenEq(src, out)
}

func TestStmtBasics() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { return 1 }"); if len(r) > 0 { return r }
	r = checkFunc("func f() {}"); if len(r) > 0 { return r }
	r = checkFunc("func f() { x := 1; y := 2; return x + y }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() (int, int) { return 1, 2 }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { g() }"); if len(r) > 0 { return r }
	return ""
}

func TestStmtAssign() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { a = b }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { a += 1 }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { a <<= 2 }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { a, b = b, a }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { i++ }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { j-- }"); if len(r) > 0 { return r }
	// All ten compound assignments route through token.TypeName.
	r = checkFunc("func f() { a -= 1; b *= 2; c /= 3; d %= 4 }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { e &= 5; g |= 6; h ^= 7; i >>= 8 }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtIf() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if x > 0 { return 1 } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { if x { a() } else { b() } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { if x { a() } else if y { b() } else { c() } }")
	if len(r) > 0 { return r }
	return ""
}

func TestStmtFor() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { for { break } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for i < n { i++ } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for i := 0; i < n; i++ { g(i) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for ; i < n; { i++ } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in xs { g(v) } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for k, v in m { h(k, v) } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for { continue } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in xs.items { g(v) } }"); if len(r) > 0 { return r }
	// Empty init / cond / post (STMT_EMPTY through the for-clause).
	r = checkFunc("func f() { for i := 0;; i++ { g() } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for ;; { break } }"); if len(r) > 0 { return r }
	return ""
}

func TestStmtSwitch() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { switch x { case 1: a(); case 2, 3: b(); default: c() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch { case x > 0: a(); default: b() } }")
	if len(r) > 0 { return r }
	// Empty switch, an empty-body case, and a multi-statement case body.
	r = checkFunc("func f() { switch x {} }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { switch x { case 1: case 2: a(); b(); default: } }")
	if len(r) > 0 { return r }
	return ""
}

// A bare `;` in a block is a STMT_EMPTY (prints nothing).
func TestStmtEmpty() testing.TestResult {
	return checkFunc("func f() { ; }")
}

func TestStmtLocalDecl() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { var x int = 5; const N = 10 }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { var p *Node = nil }"); if len(r) > 0 { return r }
	return ""
}

func TestStmtNestedBlock() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { { x := 1; g(x) } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { if a { if b { c() } } }"); if len(r) > 0 { return r }
	return ""
}

func TestStmtFuncLit() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { g(func() int { return 1 }) }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { var cb = func(x int) { h(x) } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { apply(func(a int, b int) int { return a + b }) }")
	if len(r) > 0 { return r }
	// A func literal whose body contains another func literal.
	r = checkFunc("func f() { g(func() int { return h(func() int { return 1 }) }) }")
	if len(r) > 0 { return r }
	return ""
}

// D4: a composite literal exposed to a control-clause's block brace must be
// parenthesized so it isn't misparsed as the block.  These cover the exposed
// composite reached as a binary operand, a selector head, and a unary operand,
// across every control-clause context that threads it (if / for-in / while /
// C-style cond+init+post / switch tag).
func TestStmtD4CompositeCondition() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if (Point{x: 1}).x > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if a == (Point{x: 1}) { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if -(Point{x: 1}).x > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if (Point{}).x + (Foo{}).y > 0 { g() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { for (Point{}).ok { g() } }"); if len(r) > 0 { return r }
	r = checkFunc("func f() { for v in (Point{x: 1}).items { g(v) } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { switch (Point{}).tag { case 1: a() } }")
	if len(r) > 0 { return r }
	// C-style init, cond, and post are all no-composite contexts.
	r = checkFunc("func f() { for x := (P{}); (Q{}).ok; y = (R{}) { g() } }")
	if len(r) > 0 { return r }
	return ""
}

// D4 negative: a composite inside a call argument / index bracket is already
// protected by the enclosing ()/[] and must NOT get extra parens (else the
// reprint differs from a minimal canonical source).
func TestStmtD4NotExposed() testing.TestResult {
	var r testing.TestResult
	r = checkFunc("func f() { if g(Point{x: 1}) != nil { h() } }")
	if len(r) > 0 { return r }
	r = checkFunc("func f() { if arr[Point{x: 1}] != nil { h() } }")
	if len(r) > 0 { return r }
	return ""
}

// A whole ordinary .bn file (function with a body) now round-trips through
// Format end to end.
func TestFormatWholeBnFile() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"\n"
		"func add(a int, b int) int {\n"
		"\treturn a + b\n"
		"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "t.bn")
	var out @[]readonly char = Format(p.ParseFile())
	return assertTokenEq(src, out)
}
