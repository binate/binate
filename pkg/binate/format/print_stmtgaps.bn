package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A simple statement prints the comments inside it that no expression in it prints
// where the source put them: between its left-hand expressions, before its operator
// (`x /* c */ = y`, `i /* c */++`), after it (`x = /* c */ y`, `x := // c` / `y`),
// after `return`, and between its values.  They are claimed by position, as a list's
// are (print_listcomments.bn): a list of left-hand expressions or of values is keyed
// by its first element's start, as a list is, the gaps around the operator by the
// operator's position (the statement's Pos), and the gap after `return` by the
// keyword's.  Before the operator and after `return`, where a line break would end
// the statement, only block comments on one line can stand (claimInlineGap); after
// the operator a line comment can too, and what follows goes on at a continuation
// line: one tab in for a statement's value, as a value too wide for its line does,
// and two in a loop's header, as the header's other parts do.

// printExprListGaps writes a comma-separated expression list with the comments
// between its elements, and those after opener (the zero Pos for none) before the
// first, in a control clause's context when cond; one that needs a line break goes
// on at a line indented cont tabs.
func printExprListGaps(b @strings.Builder, list @[]@ast.Expr, opener token.Pos, cond bool,
		cont int) {
	var key token.Pos = exprStartPos(list[0])
	var lo token.Pos = opener
	for i := 0; i < len(list); i++ {
		if i > 0 { b.WriteByte(',') }
		var start token.Pos = exprStartPos(list[i])
		writeGapSeparator(b, claimGap(lo, start, key), cont, i == 0, i > 0)
		if cond {
			printExprCond(b, list[i])
		} else {
			printExpr(b, list[i])
		}
		lo = start
	}
}

// printLhs writes an assignment's left-hand expressions with the comments between
// them, continued at cont, and after them the block comments on one line before its
// operator at op.
func printLhs(b @strings.Builder, list @[]@ast.Expr, op token.Pos, cond bool, cont int) {
	var none token.Pos
	printExprListGaps(b, list, none, cond, cont)
	_ = writeInlineComments(b, claimInlineGap(exprStartPos(list[len(list) - 1]), op, op))
}

// printIncDec writes `x++` or `x--` for statement s, with the block comments on one
// line before its operator, which x reserves room for with the operator and tail;
// x in a control clause's context, reserving nothing, when cond.
func printIncDec(b @strings.Builder, s @ast.Stmt, cond bool, tail int) {
	var op *[]readonly char = token.TypeName(cast(token.Type, s.Op))
	var cs @[]@token.Comment = claimAfterExpr(s.X, s.Pos, s.Pos)
	if cond {
		printExprCond(b, s.X)
	} else {
		printExprTail(b, s.X, len(op) + inlineCommentsWidth(cs) + tail)
	}
	_ = writeInlineComments(b, cs)
	b.Write(op)
}

// writeOpGap writes ` <op>` and the comments cs after it, and what separates them
// from what follows: a space, or a line break to cont when one needs it
// (writeGapSeparator).
func writeOpGap(b @strings.Builder, opName *[]readonly char, cs @[]@token.Comment, cont int) {
	b.WriteByte(' ')
	b.Write(opName)
	writeGapSeparator(b, cs, cont, false, true)
}

// printRhsGap writes ` <op> <value>` for a single value after the operator at op
// (printRhsValue), with the comments between them: block comments on one line that
// fit on the operator's line go with the operator, so the value's layout counts them;
// otherwise the value goes on after them, at a continuation line one tab in when one
// needs a line break after it, and one that does not fit starts that line
// (writeGapComments).
func printRhsGap(b @strings.Builder, opName *[]readonly char, op token.Pos, value @ast.Expr,
		tail int) {
	printRhsWith(b, opName, claimGap(op, exprStartPos(value), op), value, tail)
}

// printRhsWith is printRhsGap with the comments after the operator, cs, claimed.
func printRhsWith(b @strings.Builder, opName *[]readonly char, cs @[]@token.Comment,
		value @ast.Expr, tail int) {
	if len(cs) == 0 {
		printRhsValue(b, opName, value, tail)
		return
	}
	if gapCommentsWidth(cs) >= 0 &&
			(wrapSuppressed || lineWidth(b) + 1 + len(opName) + inlineCommentsWidth(cs) <= MAX_LINE_WIDTH) {
		var ob @strings.Builder = strings.NewBuilder()
		ob.Write(opName)
		_ = writeInlineComments(ob, cs)
		printRhsValue(b, ob.String(), value, tail)
		return
	}
	writeOpGap(b, opName, cs, currentLineIndent(b) + 1)
	printExprTail(b, value, tail)
}

// printValuesGap writes ` <op> <values>` for a list of values after the operator at
// op (printValueListWrapped), with the comments after the operator: the values go on
// at a continuation line one tab in after one that needs a line break, or when the
// first value does not fit after them, and wrap there.
func printValuesGap(b @strings.Builder, opName *[]readonly char, op token.Pos, values @[]@ast.Expr,
		tail int) {
	var cont int = currentLineIndent(b) + 1
	var cs @[]@token.Comment = claimGap(op, exprStartPos(values[0]), op)
	b.WriteByte(' ')
	b.Write(opName)
	if len(cs) == 0 {
		b.WriteByte(' ')
	} else if writeGapComments(b, cs, cont, false) ||
			!wrapSuppressed && lineWidth(b) + 2 + firstLineLen(exprSingleLine(values[0])) > MAX_LINE_WIDTH {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else {
		b.WriteByte(' ')
	}
	printValueListWrapped(b, values, tail, cont)
}
