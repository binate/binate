package "pkg/binate/format"

import "pkg/builtins/testing"

// The comments inside a simple statement stay where the source put them: between its left-hand
// expressions, before its operator (`++` and `--` too), after its operator, after `return`,
// and between its values, in a loop's header too.  A line comment after the operator puts the
// value on a continuation line, one tab in for a statement and two in a header; one between the
// left-hand expressions continues them on a line two tabs in, and one between the values wraps
// them at their continuation, one tab in.
func TestStmtCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() int {\n"
			"\tx /* a */ = y // b\n"
			"\tx = /* c */ y // d\n"
			"\tx = // e\n"
			"\t\ty\n"
			"\tx, /* f */ y = 1, /* g */ 2\n"
			"\ta, // h\n"
			"\t\tb := 1, 2\n"
			"\tp, q = // i\n"
			"\t\t1, 2\n"
			"\tx /* j */ += 1\n"
			"\ti /* k */ ++\n"
			"\tv := /* l */ fffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccccc)\n"
			"\tw := // m\n"
			"\t\tfffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccccc"
			"ccccccccccccc)\n"
			"\tfor i := /* n */ 0; i < n; i /* o */ ++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := // p\n"
			"\t\t\t0; i < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i, j := 0, /* q */ 1; i < n; i, j = i+1, /* r */ j+1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tub, /* s */ uok := ua.(/* t */ *Named)\n"
			"\treturn /* u */ a, /* v */ b\n"
			"}\n"
			"\n"
			"func g() (int, int) {\n"
			"\treturn a, // w\n"
			"\t\tb\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() int {\n"
			"\tx /* a */ = y // b\n"
			"\tx = /* c */ y // d\n"
			"\tx = // e\n"
			"\t\ty\n"
			"\tx, /* f */ y = 1, /* g */ 2\n"
			"\ta, // h\n"
			"\t\t\tb := 1, 2\n"
			"\tp, q = // i\n"
			"\t\t1, 2\n"
			"\tx /* j */ += 1\n"
			"\ti /* k */++\n"
			"\tv := /* l */ fffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb, "
			"cccccccccccccccccc)\n"
			"\tw := // m\n"
			"\t\tfffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccccc"
			"ccccccccccccc)\n"
			"\tfor i := /* n */ 0; i < n; i /* o */++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i := // p\n"
			"\t\t\t0; i < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tfor i, j := 0, /* q */ 1; i < n; i, j = i + 1, /* r */ j + 1 {\n"
			"\t\tg()\n"
			"\t}\n"
			"\tub, /* s */ uok := ua.(/* t */ *Named)\n"
			"\treturn /* u */ a, /* v */ b\n"
			"}\n"
			"\n"
			"func g() (int, int) {\n"
			"\treturn a, // w\n"
			"\t\tb\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A block comment after a statement's operator stays with the operator, and the value's layout
// counts it: the value moves to a continuation line, or wraps, as it would if the comment were
// part of the line, and stays inline on a `// LONG-LINE ALLOWED` line.  When the operator's line
// cannot hold the comments, the value goes on after them at its continuation line, which a
// comment that does not fit starts; a comment before `++` counts in its operand's room; and a
// line comment after the operator does not deepen the values' own continuation lines.
func TestStmtCommentsCountInTheLayout() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvvvvvvvvvvvvvvvvvvvvvv := /* a long comment, as long as it gets */ identifiert"
			"hatcannotwrapatallever\n"
			"\twwwwwwwwwwwwwwww := /* a long comment */ ffffffffffff(aaaaaaaaaaaaaaaaaaaaa, b"
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbb)\n"
			"\txx = /* c */ yy // LONG-LINE ALLOWED\n"
			"\taaaaaaaaaaaa, bbbbbbbbbbbbbb, cccccccccccccc = ffffffffffffffff(), /* d */ ggg"
			"ggggggggggggggggggg(), hhhhhhhhh()\n"
			"\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa[bbbbbbb"
			"bbbbbbbbbbbbbbbbb] /* c */ ++\n"
			"\txxxxxxxxxx = /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccccccccc */ yyyy\n"
			"\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxx := /* c */ /* d */ g(aaaa, bbbb)\n"
			"\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, zz ="
			" /* c */ aaaaaaaaaaaa, g(bbbbbbbbbbbbbbbb, cccc)\n"
			"\tx, y = // l\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbb, ccccccccccccccc\n"
			"\tfor i, j := // m\n"
			"\t\t\t0, // n\n"
			"\t\t\t1; i < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvvvvvvvvvvvvvvvvvvvvvv := /* a long comment, as long as it gets */\n"
			"\t\tidentifierthatcannotwrapatallever\n"
			"\twwwwwwwwwwwwwwww := /* a long comment */ ffffffffffff(aaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)\n"
			"\txx = /* c */ yy // LONG-LINE ALLOWED\n"
			"\taaaaaaaaaaaa, bbbbbbbbbbbbbb, cccccccccccccc = ffffffffffffffff(), /* d */\n"
			"\t\tgggggggggggggggggggggg(), hhhhhhhhh()\n"
			"\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa[\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbb] /* c */++\n"
			"\txxxxxxxxxx =\n"
			"\t\t/* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccc */ yyyy\n"
			"\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxx := /* c */\n"
			"\t\t/* d */ g(aaaa, bbbb)\n"
			"\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, zz ="
			" /* c */\n"
			"\t\taaaaaaaaaaaa, g(bbbbbbbbbbbbbbbb, cccc)\n"
			"\tx, y = // l\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbb,\n"
			"\t\tccccccccccccccc\n"
			"\tfor i, j := // m\n"
			"\t\t\t0, // n\n"
			"\t\t\t1; i < n; i++ {\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
