package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// Statement/declaration-level width-aware wrapping.  A bare `=`/`:=`/`return`
// followed by a value (or value list) has no bracket to sub-wrap through, so a
// long RHS that is not itself a self-wrapping construct (a call/composite/binary
// wraps on its own) would otherwise spill past the cap on one line.  These helpers
// wrap the RHS onto a `+1` continuation (a single value) or fill the value list.
//
// The wrap decision is WIDTH-ONLY, not source-keyed: the formatter deliberately
// collapses a source-wrapped-but-fitting statement RHS to one line (a statement
// continuation is a pure width device, unlike a bracketed list whose opener marks
// a nesting level), so wrapping only when the single-line form overflows keeps the
// output stable and idempotent.  The continuation indent is `+1` (not the bracket
// engine's `+2`): a bare operator opens no nesting level, matching house style.

// currentLine returns the builder's current (last) line -- the text after the last
// newline -- used to seed a trial scratch at the real column/indent so a value's
// own wrapping is measured as it would land in the real builder.
func currentLine(b @strings.Builder) @[]readonly char {
	var s @[]readonly char = b.String()
	var start int = 0
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] == '\n' {
			start = i + 1
			break
		}
	}
	return s[start:len(s)]
}

// longestLineWidth returns the byte length of the longest line in s (the metric
// the width cap applies).  A production twin of the test helper longestLine, used
// to measure a trial rendering that may itself span lines.
func longestLineWidth(s *[]readonly char) int {
	var maxLen int = 0
	var cur int = 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			if cur > maxLen { maxLen = cur }
			cur = 0
		} else {
			cur = cur + 1
		}
	}
	if cur > maxLen { maxLen = cur }
	return maxLen
}

// writeRhsInline writes ` <op> <value>` with the value on the current line (it
// self-wraps if it is a wrappable construct).
func writeRhsInline(b @strings.Builder, opName *[]readonly char, value @ast.Expr) {
	b.WriteByte(' ')
	b.Write(opName)
	b.WriteByte(' ')
	printExprTail(b, value, 0)
}

// rhsInlineLongest returns the longest line width of ` <op> <value>` rendered
// inline at the real column (the value self-wrapping), by seeding a scratch with
// the builder's current line.
func rhsInlineLongest(b @strings.Builder, opName *[]readonly char, value @ast.Expr) int {
	var sc @strings.Builder = strings.NewBuilder()
	sc.Write(currentLine(b))
	sc.WriteByte(' ')
	sc.Write(opName)
	sc.WriteByte(' ')
	printExprTail(sc, value, 0)
	return longestLineWidth(sc.String())
}

// rhsContLongest returns the longest line width of the `+1`-continuation form: the
// operator ends the head line, the value renders on a fresh line one tab deeper.
func rhsContLongest(b @strings.Builder, opName *[]readonly char, value @ast.Expr) int {
	var sc @strings.Builder = strings.NewBuilder()
	sc.Write(currentLine(b))
	sc.WriteByte(' ')
	sc.Write(opName)
	sc.WriteByte('\n')
	writeIndent(sc, currentLineIndent(b) + 1)
	printExprTail(sc, value, 0)
	return longestLineWidth(sc.String())
}

// printRhsValue emits ` <op> <value>` for a single-value RHS (`=`, `:=`, `+=`, ...),
// wrapping only when the single-line form overflows: it keeps the value inline when
// the value self-wraps to fit (a call/composite/binary/cross-line string), and puts
// an atomic value (a plain string/ident that cannot self-wrap) on a `+1`
// continuation.  A value too wide even on the continuation is left inline (a
// LONG-LINE residual the formatter cannot resolve without splitting the value).
// Precondition: the head (`Name Type`, or the LHS list) is written; lineWidth(b) is
// the pre-operator column.  Not used for `return` (a line break there re-parses via
// semicolon insertion) -- see printValueListWrapped.
func printRhsValue(b @strings.Builder, opName *[]readonly char, value @ast.Expr) {
	if wrapSuppressed {
		writeRhsInline(b, opName, value)
		return
	}
	var col int = lineWidth(b)
	var single @[]readonly char = exprSingleLine(value)
	if !hasNewline(single) && col + 2 + len(opName) + len(single) <= MAX_LINE_WIDTH {
		writeRhsInline(b, opName, value)
		return
	}
	if rhsInlineLongest(b, opName, value) <= MAX_LINE_WIDTH {
		writeRhsInline(b, opName, value)
		return
	}
	if rhsContLongest(b, opName, value) <= MAX_LINE_WIDTH {
		b.WriteByte(' ')
		b.Write(opName)
		b.WriteByte('\n')
		writeIndent(b, currentLineIndent(b) + 1)
		printExprTail(b, value, 0)
		return
	}
	writeRhsInline(b, opName, value)
}

// printValueListWrapped emits a comma-separated value list (a `return` result list
// or a multi-value assign/short-var RHS), wrapping fill-style at a `+1` continuation
// when the single-line form overflows.  The first value stays on the head line
// (mode B): a line break after `return` (or a lone first value) would re-parse via
// semicolon insertion, and mode B is valid for `=`/`:=` too.  Precondition: the head
// (`return `, or the LHS + operator) is written.
func printValueListWrapped(b @strings.Builder, elems @[]@ast.Expr) {
	if wrapSuppressed {
		printExprList(b, elems)
		return
	}
	var single @[]readonly char = exprListSingleLine(elems)
	if !hasNewline(single) && lineWidth(b) + len(single) <= MAX_LINE_WIDTH {
		printExprList(b, elems)
		return
	}
	fillExprList(b, elems, currentLineIndent(b) + 1, false, 0)
}

// exprListSingleLine renders a comma-separated expression list to a string, used to
// width-test whether the list fits on one line.
func exprListSingleLine(elems @[]@ast.Expr) @[]readonly char {
	var sc @strings.Builder = strings.NewBuilder()
	printExprList(sc, elems)
	return sc.String()
}
