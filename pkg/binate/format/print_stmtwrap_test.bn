package "pkg/binate/format"

import "pkg/builtins/testing"

// Statement/declaration RHS wrapping.  checkWrap / fmtFunc / containsSub / tokDiff
// are shared from the sibling test files (same package).

// A single-value RHS that overflows and cannot self-wrap (a plain string literal)
// moves to a +1 continuation, the operator ending the head line.
func TestWrapVarDeclAtomicRhsToPlus1() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tvar msg *[]readonly char = \"a fairly long plain string literal that overflows "
			"the width cap by enough here\"\n"
			"}"
	return checkWrap(src)
}

// A multi-value return list that overflows fills onto +1 continuations, the first
// value staying on the `return` line (mode B -- a break after `return` re-parses
// via semicolon insertion).
func TestWrapReturnListFills() testing.TestResult {
	var src *[]readonly char = "func f() (bool, bool, bool) {\n"
			"\treturn falseValueHere, \"a fairly long build-constraint error message that goes "
			"right here now\", trueVal\n"
			"}"
	return checkWrap(src)
}

// A single-value RHS that IS a self-wrapping construct (a call) stays inline and
// wraps its own arguments rather than moving to a +1 continuation.
func TestWrapVarDeclCallRhsStaysInline() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tvar out @[]char = someFunctionName(argAaaaaaaaaaaaa, argBbbbbbbbbbbbb, "
			"argCcccccccccccc, argDdddddddd)\n"
			"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "= someFunctionName(") {
		return tokDiff("self-wrapping call RHS was pushed to a continuation", out, "")
	}
	return ""
}
