package "pkg/binate/format"

import "pkg/builtins/testing"

// Statement/declaration RHS wrapping.  checkWrap / fmtFunc / containsSub / tokDiff
// are shared from the sibling test files (same package).

// A single-value RHS that overflows and cannot self-wrap (an identifier) moves to
// a continuation line one tab deeper than its statement, at any depth, the
// operator ending the head line.
func TestWrapRhsAtomicToPlus1() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"var top = vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\n"
			"func f() {\n"
			"\tmsg := vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\tif c {\n"
			"\t\tvar s = vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"var top =\n"
			"\tvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\n"
			"func f() {\n"
			"\tmsg :=\n"
			"\t\tvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\tif c {\n"
			"\t\tvar s =\n"
			"\t\t\tvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// When the head spans lines, the continuation is one tab deeper than the line the
// head ends on, not the statement.
func TestWrapRhsContinuesFromHeadsLastLine() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif c {\n"
			"\t\tm[\"kkkkkkkkkkkkkkkkkkkk\"\n"
			"\t\t\t\t\"jjjjjjjjjjjjjjjjjjjj\"] = vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tif c {\n"
			"\t\tm[\"kkkkkkkkkkkkkkkkkkkk\"\n"
			"\t\t\t\t\"jjjjjjjjjjjjjjjjjjjj\"] =\n"
			"\t\t\t\t\tvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
			"vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A multi-value return list that overflows fills onto +1 continuations, the first
// value staying on the `return` line (mode B -- a break after `return` re-parses
// via semicolon insertion).
func TestWrapReturnListFills() testing.TestResult {
	var src *[]readonly char = "func f() (bool, bool, bool) {\n"
			"\treturn falseValueHere, \"a fairly long build-constraint error message that goes "
			"right here now\", trueVal\n"
			"}"
	return checkWrap(src)
}

// A single-value RHS that IS a self-wrapping construct (a call) stays inline and
// wraps its own arguments rather than moving to a +1 continuation.
func TestWrapVarDeclCallRhsStaysInline() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tvar out @[]char = someFunctionName(argAaaaaaaaaaaaa, argBbbbbbbbbbbbb, "
			"argCcccccccccccc, argDdddddddd)\n"
			"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "= someFunctionName(") {
		return tokDiff("self-wrapping call RHS was pushed to a continuation", out, "")
	}
	return ""
}
