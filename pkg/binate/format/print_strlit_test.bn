package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for printing string literals (printStringLit, splitStringLit).

// An empty string literal that ends past the cap is written whole (it cannot be split):
// on a right-hand side it moves to a continuation line, and as an argument it stays one.
func TestEmptyStringLitPastCapKept() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
			"nnnnnnnnnnnnnnnnnnnnnnnnnn = \"\"\n"
			"\tx(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaa, \"\")\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
			"nnnnnnnnnnnnnnnnnnnnnnnnnn =\n"
			"\t\t\"\"\n"
			"\tx(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t\"\")\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A string split across lines reserves what follows it (here `.y)`) only on its last part's
// line: each earlier part fills its line, so the run stays after `f(a, ` -- as a reformat,
// which finds the parts split, measures them.
func TestSplitStringTailOnLastPart() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaa\".y)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaa\"\n"
			"\t\t\t\"a\".y)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Where the rest of a string fits its line only without what follows it -- here a line
// comment that stays on the line -- the string ends before its last unit, which takes a line
// of its own with the comment, once: it is not cut into parts as short as the comment leaves
// room for.
func TestSplitStringFinalPartOnce() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = [2]T{\n"
			"\tT{x, \"hello world\"}, // ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccccccccc\n"
			"\tT{y, \"z\"},\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = [2]T{\n"
			"\t\tT{x, \"hello worl\"\n"
			"\t\t\t\t\"d\"}, // cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccccc\n"
			"\t\tT{y, \"z\"}}\n"
	return checkFormatGolden(src, want)
}
