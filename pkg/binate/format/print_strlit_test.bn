package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests for printing string literals (printStringLit, splitStringLit, printCommentedRun).

// An empty string literal that ends past the cap is written whole (it cannot be split):
// on a right-hand side it moves to a continuation line, and as an argument it stays one.
func TestEmptyStringLitPastCapKept() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
			"nnnnnnnnnnnnnnnnnnnnnnnnnn = \"\"\n"
			"\tx(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaa, \"\")\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
			"nnnnnnnnnnnnnnnnnnnnnnnnnn =\n"
			"\t\t\"\"\n"
			"\tx(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t\"\")\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A string split across lines reserves what follows it (here `.y)`) only on its last part's
// line: each earlier part fills its line, so the run stays after `f(a, ` -- as a reformat,
// which finds the parts split, measures them.
func TestSplitStringTailOnLastPart() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" \"aaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaa\".y)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tf(a, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaa\"\n"
			"\t\t\t\"a\".y)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// Where the rest of a string fits its line only without what follows it -- here a line
// comment that stays on the line -- the string ends before its last unit, which takes a line
// of its own with the comment, once: it is not cut into parts as short as the comment leaves
// room for.
func TestSplitStringFinalPartOnce() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = [2]T{\n"
			"\tT{x, \"hello world\"}, // ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccccccccc\n"
			"\tT{y, \"z\"},\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var t = [2]T{\n"
			"\t\tT{x, \"hello worl\"\n"
			"\t\t\t\t\"d\"}, // cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccccc\n"
			"\t\tT{y, \"z\"}}\n"
	return checkFormatGolden(src, want)
}

// A comment between the parts of a run of adjacent string literals stays between them -- a
// block comment on the parts' line, a line comment, an own-line comment, a block comment over
// lines, one before a break the source has -- in a statement or an argument list, and the run
// keeps its line breaks: a part after a line comment, or after a block comment over lines,
// starts a line.
func TestStringRunKeepsCommentsBetweenItsParts() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := \"x\" /* d */ \"y\"\n"
			"\tx = \"a\" /* 1 */ \"b\" /* 2 */ \"c\"\n"
			"\tx = \"a\" \"b\" /* c */ \"c\" \"d\"\n"
			"\tx = \"a\"\n"
			"\t\t// c\n"
			"\t\t\"b\"\n"
			"\tx = \"a\" /* c */\n"
			"\t\t\"b\"\n"
			"\tx = \"a\"\n"
			"\t\t\"b\" /* c */ \"c\"\n"
			"\tx = \"a\" /* x\n"
			"\t   y */ \"b\"\n"
			"\tn := len(\"a\" // c\n"
			"\t\t\"b\") /* d */ + 1\n"
			"\tg(/* o */ \"a\" /* m */ \"b\", c)\n"
			"\tg(a, \"x\" // c\n"
			"\t\t\"y\", b)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tx := \"x\" /* d */ \"y\"\n"
			"\tx = \"a\" /* 1 */ \"b\" /* 2 */ \"c\"\n"
			"\tx = \"a\" \"b\" /* c */ \"c\" \"d\"\n"
			"\tx = \"a\"\n"
			"\t\t\t// c\n"
			"\t\t\t\"b\"\n"
			"\tx = \"a\" /* c */\n"
			"\t\t\t\"b\"\n"
			"\tx = \"a\"\n"
			"\t\t\t\"b\" /* c */ \"c\"\n"
			"\tx = \"a\" /* x\n"
			"\t   y */\n"
			"\t\t\t\"b\"\n"
			"\tn := len(\"a\" // c\n"
			"\t\t\t\"b\") /* d */ + 1\n"
			"\tg(/* o */ \"a\" /* m */ \"b\", c)\n"
			"\tg(a,\n"
			"\t\t\t\"x\" // c\n"
			"\t\t\t\t\t\"y\",\n"
			"\t\t\tb)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A line comment between the parts of a run in a signature's result, a receiver's type, an
// interface method's result or a function value's result stays there, as does a comment after it
// in the same type: one the result's trial render claims is printed by its final render.
func TestStringRunCommentInASignatureType() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() [len(\"a\" // c\n"
			"\t\"b\") + /* d */ 1]T {\n"
			"}\n"
			"\n"
			"func g() [len(\"a\" // c\n"
			"\t\"b\") + len(\"x\" /* d */ \"y\")]T /* e */ {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r [len(\"a\" // c\n"
			"\t\"b\")]T) m() {\n"
			"}\n"
			"\n"
			"interface I {\n"
			"\tm() [len(\"a\" // c\n"
			"\t\t\"b\") + /* d */ 1]T\n"
			"}\n"
			"\n"
			"var y *func() [len(\"a\" // c\n"
			"\t\"b\") + /* d */ 1]T = nil\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() [len(\"a\" // c\n"
			"\t\t\"b\") + /* d */ 1]T {}\n"
			"\n"
			"func g() [len(\"a\" // c\n"
			"\t\t\"b\") + len(\"x\" /* d */ \"y\")]T /* e */ {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func (r [len(\"a\" // c\n"
			"\t\t\"b\")]T) m() {}\n"
			"\n"
			"interface I {\n"
			"\tm() [len(\"a\" // c\n"
			"\t\t\t\"b\") + /* d */ 1]T\n"
			"}\n"
			"\n"
			"var y *func() [len(\"a\" // c\n"
			"\t\t\"b\") + /* d */ 1]T = nil\n"
	return checkFormatGolden(src, want)
}

// A body-less function's result in an interface file keeps a line comment between the parts of a
// run, and the comment after it.
func TestStringRunCommentInAnInterfaceFile() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() [len(\"a\" // c\n"
			"\t\"b\") + /* d */ 1]T\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() [len(\"a\" // c\n"
			"\t\t\"b\") + /* d */ 1]T\n"
	return checkFormatGoldenIface(src, want)
}

// A run with comments between its parts is not merged, so it keeps the cap by moving a part to a
// continuation line -- one that does not fit after the comment before it (the last with what
// follows the run, here `)`), and one after a comment that does not fit after the part before
// it, which starts a line itself -- and by splitting a part too wide for its line, as a single
// literal is, with room for a line comment after it.  A `// LONG-LINE ALLOWED` line keeps its run
// as it is.  Past STABLE_LIST_DEPTH nested lists a run without comments merges, and one with them
// keeps no line break of its source between its parts, so a second format lays it out alike.
func TestStringRunWithCommentsKeepsTheCap() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxxx := \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c */ \"bbbbbbbbb"
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"\n"
			"\txxxxx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaaaaaaaaaaaaa\" /* c */ \"b\"\n"
			"\txxxxx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aa\" /* c */ \"b\"\n"
			"\tx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c"
			" */ \"b\" \"c\"\n"
			"\tg(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c *"
			"/ \"bbbb\")\n"
			"\tx = \"a\" /* c */ \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" /* d */ \"c\"\n"
			"\tx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c */ \"bbbb"
			"bbbbbbbbbbbbbbbbbbbbbbbbbb\" // LONG-LINE ALLOWED\n"
			"\tx = \"a\" // c\n"
			"\t\t\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bb\" // d\n"
			"\t\t\"c\"\n"
			"\tg(y, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"\" // comment here\n"
			"\t\t\"b\")\n"
			"\tg(g(g(g(g(g(g(g(g(g(g(g(g(g(\"a\" /* c */ \"b\"))))))))))))))\n"
			"\tg(g(g(g(g(g(g(g(g(g(g(g(g(g(\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\" /* c */ \"yyyyyyyyyyy"
			"yyyyyyyyyyyyyyyyyyy\"))))))))))))))\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxxx := \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c */\n"
			"\t\t\t\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"\n"
			"\txxxxx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aaaaaa\"\n"
			"\t\t\t\"aaaaaaaaaaa\" /* c */ \"b\"\n"
			"\txxxxx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
			"aa\"\n"
			"\t\t\t/* c */\n"
			"\t\t\t\"b\"\n"
			"\tx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c"
			" */ \"b\"\n"
			"\t\t\t\"c\"\n"
			"\tg(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c *"
			"/\n"
			"\t\t\t\"bbbb\")\n"
			"\tx = \"a\" /* c */\n"
			"\t\t\t\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbb\"\n"
			"\t\t\t\"bbbbbbbbbbbbbbbbbbbbbbbbb\" /* d */ \"c\"\n"
			"\tx = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" /* c */ \"bbbb"
			"bbbbbbbbbbbbbbbbbbbbbbbbbb\" // LONG-LINE ALLOWED\n"
			"\tx = \"a\" // c\n"
			"\t\t\t\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbb\"\n"
			"\t\t\t\"b\" // d\n"
			"\t\t\t\"c\"\n"
			"\tg(y, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\""
			"\n"
			"\t\t\t\"a\" // comment here\n"
			"\t\t\t\"b\")\n"
			"\tg(g(g(g(g(g(g(g(g(g(g(g(g(g(\"a\" /* c */ \"b\"))))))))))))))\n"
			"\tg(\n"
			"\t\t\tg(g(g(g(g(g(g(g(g(\n"
			"\t\t\t\t\tg(g(g(g(\n"
			"\t\t\t\t\t\t\t\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\" /* c */\n"
			"\t\t\t\t\t\t\t\t\t\"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\"))))))))))))))\n"
			"}\n"
	return checkFormatGolden(src, want)
}
