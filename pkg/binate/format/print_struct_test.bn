package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/std/strings"

// checkStructGolden formats a type declaration (parsed in .bni mode, so no body)
// and asserts the output equals want exactly, that it is token-equal to the
// input, and that formatting is idempotent.
func checkStructGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	if !streq(out, want) {
		return tokDiff("struct format mismatch", out, want)
	}
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	var d2 @ast.Decl = parseDeclSrc(out)
	var out2 @[]readonly char = FormatDecl(d2)
	if !streq(out, out2) {
		return tokDiff("struct format not idempotent", out, out2)
	}
	return ""
}

// A multi-line struct aligns field types in a column; the shortest name is
// space-padded so the types share a column.
func TestStructAlignBasic() testing.TestResult {
	var src *[]readonly char = "type Pos struct {\n"
			"\tFile @[]char\n"
			"\tLine int\n"
			"\tCol int\n"
			"}"
	var want *[]readonly char = "type Pos struct {\n"
			"\tFile @[]char\n"
			"\tLine int\n"
			"\tCol  int\n"
			"}"
	return checkStructGolden(src, want)
}

// A blank line between fields breaks the alignment run: each run's types align
// independently, and the blank line is preserved.
func TestStructAlignRunReset() testing.TestResult {
	var src *[]readonly char = "type T struct {\n"
			"\tA int\n"
			"\tB int\n"
			"\n"
			"\tLonger int\n"
			"}"
	var want *[]readonly char = "type T struct {\n"
			"\tA int\n"
			"\tB int\n"
			"\n"
			"\tLonger int\n"
			"}"
	return checkStructGolden(src, want)
}

// A struct the source kept on one line stays single-line.
func TestStructSingleLinePreserved() testing.TestResult {
	return checkStructGolden("type P struct { x int; y int }", "type P struct { x int; y int }")
}

// A single-line struct whose rendering would exceed 100 columns is expanded (and
// then aligned), with every resulting line within the cap.
func TestStructWidthCapExpands() testing.TestResult {
	var src *[]readonly char = "type Big struct { aaaaaaaaaa int; bbbbbbbbbb int; cccccccccc int; "
			"dddddddddd int; eeeeeeeeee int; ffffffffff int; gggggggggg int }"
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if !containsSub(out, "struct {\n\t") {
		return tokDiff("width cap: struct not expanded", out, "struct {\\n\\t")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("width cap: a struct line exceeds 100", out, "")
	}
	return ""
}

// When aligning a run's field types to the widest name would push a narrow-named
// field's long type past 100 columns, alignment is dropped for the run (a single
// space) so every line stays within the cap.
func TestStructAlignWidthGuard() testing.TestResult {
	// A 90-char type name: aligned to the 20-char name column it would be
	// 1+20+1+90 = 112 > 100; unaligned it is 1+1+1+90 = 93.
	var longType *[]readonly char = "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA"
			"AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA"
	var b @strings.Builder = strings.NewBuilder()
	b.Write("type T struct {\n\taaaaaaaaaaaaaaaaaaaa int\n\tb ")
	b.Write(longType)
	b.Write("\n}")
	var out @[]readonly char = FormatDecl(parseDeclSrc(b.String()))
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("struct align width guard: a line exceeds 100", out, "")
	}
	// Alignment dropped: field `b` has a single space before its type.
	if !containsSub(out, "\tb AAAAAAAAAA") {
		return tokDiff("struct align width guard: alignment not dropped", out, "\\tb A...")
	}
	return ""
}

// An own-line comment inside a struct is placed above its field (via the threaded
// cursor) and breaks the alignment run.
func TestStructCommentInterleaved() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"type T struct {\n"
			"\t// leading comment\n"
			"\tA int\n"
			"\tB int\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, "\t// leading comment\n\tA int") {
		return tokDiff("struct comment not placed above field", out,
				"<tab>// leading comment<nl><tab>A int")
	}
	return ""
}

// Of two struct fields on a line, the first takes only the comments before the second, and the
// last only those before the struct's `}`: one after it is the declaration's.
func TestStructFieldsTakeTheirOwnComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tf int; g int // h\n"
			"\tk int; m int } // after\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tf int\n"
			"\tg int // h\n"
			"\tk int\n"
			"\tm int\n"
			"} // after\n"
	return checkFormatGolden(src, want)
}

// A struct type in a variable's, a field's or a parameter's type, or in an expression, prints the
// comments inside it in place, as one in a type declaration does: one between its fields expands
// it, and the comments after its `}` stay there.
func TestNestedStructTypesTakeTheirComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var w struct { /* z */\n"
			"\tx int\n"
			"} // after w\n"
			"\n"
			"var a = 1; var v struct { /* y */\n"
			"\tx int\n"
			"} // after v\n"
			"\n"
			"var s struct {\n"
			"\ta int // a\n"
			"\tb struct {\n"
			"\t\t// lead\n"
			"\t\tc int // c\n"
			"\t} // b\n"
			"\td int\n"
			"}\n"
			"\n"
			"func f(s struct { a int /* c */ }, t int) {\n"
			"\tvar u struct { a int /* d */ }\n"
			"\tx := sizeof(struct { a int /* e */; b int })\n"
			"\tg(func() { var q struct { /* f */ a int }; h(q) })\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var w struct {\n"
			"\t/* z */\n"
			"\tx int\n"
			"} // after w\n"
			"\n"
			"var a = 1\n"
			"\n"
			"var v struct {\n"
			"\t/* y */\n"
			"\tx int\n"
			"} // after v\n"
			"\n"
			"var s struct {\n"
			"\ta int // a\n"
			"\tb struct {\n"
			"\t\t// lead\n"
			"\t\tc int // c\n"
			"\t} // b\n"
			"\td int\n"
			"}\n"
			"\n"
			"func f(s struct {\n"
			"\ta int /* c */\n"
			"}, t int) {\n"
			"\tvar u struct {\n"
			"\t\ta int /* d */\n"
			"\t}\n"
			"\tx := sizeof(struct {\n"
			"\t\ta int /* e */\n"
			"\t\tb int\n"
			"\t})\n"
			"\tg(func() {\n"
			"\t\tvar q struct {\n"
			"\t\t\t/* f */\n"
			"\t\t\ta int\n"
			"\t\t}\n"
			"\t\th(q)\n"
			"\t})\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// On a `// LONG-LINE ALLOWED` line, a one-line struct type whose comments sit in its lists is kept
// whole with them, past the cap, as a block is.  A comment between its fields expands it, and the
// line prints as an unmarked one does, the marker after the `}`.
func TestMarkedLineKeepsStructWithListComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar s struct { f *func(int, /* c */ int); g int; hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhhhhhh int } // LONG-LINE ALLOWED\n"
			"\tvar t struct { f *func(int, int) /* e */; g int } // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tvar s struct { f *func(int, /* c */ int); g int; hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh"
			"hhhhhhhhhhhhhhhhhhhhhhhhhhhh int } // LONG-LINE ALLOWED\n"
			"\tvar t struct {\n"
			"\t\tf *func(int, int) /* e */\n"
			"\t\tg int\n"
			"\t} // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A multi-line struct type is measured by its first line, which is what follows it there: a
// signature's results do not wrap its parameters for the struct's later lines, and a field's type
// does not turn off its run's alignment.
func TestStructTypeMeasuredByItsFirstLine() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func ffff(aaaaaaaaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbb int, c int) struct {\n"
			"\tx int\n"
			"\ty int\n"
			"} {\n"
			"\treturn y\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\ta int\n"
			"\tbbbbbb struct {\n"
			"\t\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx int\n"
			"\t\ty int\n"
			"\t}\n"
			"\tc int\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func ffff(aaaaaaaaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbb int, c int) struct {\n"
			"\tx int\n"
			"\ty int\n"
			"} {\n"
			"\treturn y\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\ta      int\n"
			"\tbbbbbb struct {\n"
			"\t\txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx int\n"
			"\t\ty                                                                      int\n"
			"\t}\n"
			"\tc      int\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A struct type a member of a type group defines prints the comments inside it in place, as one
// in a type declaration does, and so do the struct types in it.
func TestTypeGroupMemberStructTakesItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type (\n"
			"\tG struct {\n"
			"\t\ta struct { b int /* c1 */ }\n"
			"\t\td int // c2\n"
			"\t\te struct { f int /* c3 */ }\n"
			"\t}\n"
			"\tH int\n"
			")\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type (\n"
			"\tG struct {\n"
			"\t\ta struct {\n"
			"\t\t\tb int /* c1 */\n"
			"\t\t}\n"
			"\t\td int // c2\n"
			"\t\te struct {\n"
			"\t\t\tf int /* c3 */\n"
			"\t\t}\n"
			"\t}\n"
			"\tH int\n"
			")\n"
	return checkFormatGolden(src, want)
}
