package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/std/strings"

// checkStructGolden formats a type declaration (parsed in .bni mode, so no body)
// and asserts the output equals want exactly, that it is token-equal to the
// input, and that formatting is idempotent.
func checkStructGolden(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	if !streq(out, want) {
		return tokDiff("struct format mismatch", out, want)
	}
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	var d2 @ast.Decl = parseDeclSrc(out)
	var out2 @[]readonly char = FormatDecl(d2)
	if !streq(out, out2) {
		return tokDiff("struct format not idempotent", out, out2)
	}
	return ""
}

// A multi-line struct aligns field types in a column; the shortest name is
// space-padded so the types share a column.
func TestStructAlignBasic() testing.TestResult {
	var src *[]readonly char = "type Pos struct {\n"
			"\tFile @[]char\n"
			"\tLine int\n"
			"\tCol int\n"
			"}"
	var want *[]readonly char = "type Pos struct {\n"
			"\tFile @[]char\n"
			"\tLine int\n"
			"\tCol  int\n"
			"}"
	return checkStructGolden(src, want)
}

// A blank line between fields breaks the alignment run: each run's types align
// independently, and the blank line is preserved.
func TestStructAlignRunReset() testing.TestResult {
	var src *[]readonly char = "type T struct {\n"
			"\tA int\n"
			"\tB int\n"
			"\n"
			"\tLonger int\n"
			"}"
	var want *[]readonly char = "type T struct {\n"
			"\tA int\n"
			"\tB int\n"
			"\n"
			"\tLonger int\n"
			"}"
	return checkStructGolden(src, want)
}

// A struct the source kept on one line stays single-line.
func TestStructSingleLinePreserved() testing.TestResult {
	return checkStructGolden("type P struct { x int; y int }", "type P struct { x int; y int }")
}

// A single-line struct whose rendering would exceed 100 columns is expanded (and
// then aligned), with every resulting line within the cap.
func TestStructWidthCapExpands() testing.TestResult {
	var src *[]readonly char = "type Big struct { aaaaaaaaaa int; bbbbbbbbbb int; cccccccccc int; "
			"dddddddddd int; eeeeeeeeee int; ffffffffff int; gggggggggg int }"
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if !containsSub(out, "struct {\n\t") {
		return tokDiff("width cap: struct not expanded", out, "struct {\\n\\t")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("width cap: a struct line exceeds 100", out, "")
	}
	return ""
}

// When aligning a run's field types to the widest name would push a narrow-named
// field's long type past 100 columns, alignment is dropped for the run (a single
// space) so every line stays within the cap.
func TestStructAlignWidthGuard() testing.TestResult {
	// A 90-char type name: aligned to the 20-char name column it would be
	// 1+20+1+90 = 112 > 100; unaligned it is 1+1+1+90 = 93.
	var longType *[]readonly char = "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA"
			"AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA" "AAAAAAAAAA"
	var b @strings.Builder = strings.NewBuilder()
	b.Write("type T struct {\n\taaaaaaaaaaaaaaaaaaaa int\n\tb ")
	b.Write(longType)
	b.Write("\n}")
	var out @[]readonly char = FormatDecl(parseDeclSrc(b.String()))
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("struct align width guard: a line exceeds 100", out, "")
	}
	// Alignment dropped: field `b` has a single space before its type.
	if !containsSub(out, "\tb AAAAAAAAAA") {
		return tokDiff("struct align width guard: alignment not dropped", out, "\\tb A...")
	}
	return ""
}

// An own-line comment inside a struct is placed above its field (via the threaded
// cursor) and breaks the alignment run.
func TestStructCommentInterleaved() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"type T struct {\n"
			"\t// leading comment\n"
			"\tA int\n"
			"\tB int\n"
			"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, "\t// leading comment\n\tA int") {
		return tokDiff("struct comment not placed above field", out,
				"<tab>// leading comment<nl><tab>A int")
	}
	return ""
}
