package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// printSwitch appends `switch [tag] { <cases> }`.  Case labels align with the
// `switch`; case bodies indent one level past it.  A case the source kept on one
// line (`case X: stmt`) is preserved single-line; the bodies of consecutive
// single-line cases are aligned in a column per run (a run breaks at a blank
// line, an interleaved comment, or an expanded case).  The width checks of both
// count the comments after them on their lines (caseInlineEligible,
// caseRunColumn).  The tag is a control-clause context (D4).
func printSwitch(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	b.Write("switch ")
	if s.X != nil {
		printExprCondTail(b, s.X, 2)
		b.WriteByte(' ')
	}
	printSwitchCases(b, cc, s, indent)
}

// printTypeSwitch appends `switch [v :=] x.(type) { <cases> }` (§14.10) — the
// type-switch header (a `v :=` binder when s.Binder is non-empty; the scrutinee
// s.X reconstructed with its `.(type)` tail) then the shared case machinery,
// whose `case *A, @B:` labels the generalized printCaseLabel renders.  The
// scrutinee cannot be a composite literal (parseTypeSwitchTail forbids it), so no
// exposed-`{` guard is needed.
func printTypeSwitch(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	b.Write("switch ")
	if len(s.Binder) > 0 {
		b.Write(s.Binder)
		b.Write(" := ")
	}
	printExpr(b, s.X)
	b.Write(".(type) ")
	printSwitchCases(b, cc, s, indent)
}

// printSwitchCases emits a switch's `{ <cases> }` block — the case run/expanded
// loop shared by the expression-switch (printSwitch) and type-switch
// (printTypeSwitch) forms, which differ only in their header and case labels.
func printSwitchCases(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int) {
	b.WriteByte('{')
	var cases @[]@ast.CaseClause = s.Cases
	var i int = 0
	for i < len(cases) {
		// A blank line the source placed before this case is preserved (and also
		// resets the alignment run, which caseRunEnd already stops at).
		if i > 0 && hasBlankGap(cc, caseEndLine(cases[i - 1]), cases[i].Pos.Line) {
			b.WriteByte('\n')
		}
		var limit token.Pos = caseLimit(cases, i, s.End)
		if caseInlineEligible(cc, cases[i], indent, limit) {
			var j int = caseRunEnd(cc, cases, i, indent, s.End)
			printCaseRun(b, cc, cases, i, j, indent, s.End)
			i = j
		} else if caseLineMarked(cc, cases[i], limit) {
			printCaseMarked(b, cc, cases[i], indent, limit)
			i = i + 1
		} else {
			printCaseExpanded(b, cc, cases[i], indent, limit)
			i = i + 1
		}
	}
	// Dangling comments after the last case, before the switch's closing brace.
	emitLeadingComments(b, cc, s.End, indent, false)
	b.WriteByte('\n')
	writeIndent(b, indent)
	b.WriteByte('}')
}

// caseEndLine returns the source line on which a case clause ends: its last body
// statement's end line, or the label's last line (its `:`'s) for an empty body.
func caseEndLine(cl @ast.CaseClause) int {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var n int = len(body)
	if n == 0 { return cl.Colon.Line }
	return body[n - 1].End.Line
}

// printCaseLabel writes a case's label -- `case <exprs>:` (expression switch),
// `case <targets>:` (type switch, e.g. `case *A, @B:`), or `default:` -- on one
// physical line (no wrapping), unless a comment in it ends its line.  Used where a
// single-line width is needed (caseLabelWidth) or is known to fit (a
// single-line-eligible case run).
func printCaseLabel(b @strings.Builder, cl @ast.CaseClause) {
	if len(cl.Types) == 0 && len(cl.Exprs) == 0 {
		b.Write("default:")
		return
	}
	printCaseLabelSingle(b, cl, caseLabelItems(cl))
}

// caseLabelItems returns a case's label items: an expression case's Exprs or a
// type case's AssertTargetList.  Shared by printCaseLabelWrapped's fill-wrap
// logic.
func caseLabelItems(cl @ast.CaseClause) @[]@listItem {
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	for i := 0; i < len(cl.Types); i++ {
		items.Push(typeItem(cl.Types[i], false))
	}
	for i := 0; i < len(cl.Exprs); i++ {
		items.Push(exprItem(nil, cl.Exprs[i]))
	}
	return items.Items()
}

// printCaseLabelWrapped writes a case's label, fill-wrapping the expression list
// when the source wrapped it or the single-line `case a, b, c:` form would exceed
// the cap.  The case-label list is the one comma-list with no width-aware wrapper,
// so a long multi-label case (token.bn's IDENT/INT/... run) collapsed to an
// over-cap line.  It mirrors printStrList but with a `case ` head instead of an
// open delimiter and a single `:` reservation instead of a close delimiter, and
// reuses fillStrs for the fill.  `default:` and a single-label case are not fill-
// wrapped (a label that itself spans lines, a function literal, is printed in
// place), nor is any label while wrapSuppressed (a `// LONG-LINE ALLOWED` marker,
// honored by the caller).  The label is followed on its last line by tail bytes
// (the comments after it there, printCaseLabelTrailing), which its width checks
// leave room for.
func printCaseLabelWrapped(b @strings.Builder, cl @ast.CaseClause, tail int) {
	// A default clause has neither an expression list nor an AssertTargetList.
	if len(cl.Exprs) == 0 && len(cl.Types) == 0 {
		b.Write("default:")
		return
	}
	var items @[]@listItem = caseLabelItems(cl)
	var n int = len(items)
	if wrapSuppressed || n == 1 {
		printCaseLabelSingle(b, cl, items)
		return
	}
	var openerAlone bool = items[0].line != cl.Pos.Line
	var sourceWrapped bool = openerAlone || items[0].line != items[n - 1].line
	// The single-line form is the `case ` head (5), the `, `-joined list, and the
	// trailing `:` (1).
	var fits bool = !itemsHaveNewline(items) &&
			lineWidth(b) + 5 + itemsOneLineLen(items, cl.Pos) + 1 + tail <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		printCaseLabelSingle(b, cl, items)
		return
	}
	// Wrap.  Mode is keyed on source layout (openerAlone), falling back to opener-
	// alone when the first label does not fit after the 5-byte `case ` head
	// (itemFitsAt).
	var key token.Pos = listKey(items)
	var here int = currentLineIndent(b) + 5 + openerGapWidth(cl.Pos, items[0].pos, key)
	var alone bool = openerAlone ||
			!itemFitsAt(items[0], 1, false, itemTrailWidth(items, 0, key), here, currentLineIndent(b),
					currentLineIndent(b) + 2)
	b.Write("case")
	fillStrs(b, items, currentLineIndent(b) + 2, alone, 1 + tail, cl.Pos, true)
	b.WriteByte(':')
}

// printCaseLabelSingle writes `case a, b, c:` for cl with its labels items joined
// on one line (a label that itself spans lines is printed in place), with the
// comments after `case` and between them.
func printCaseLabelSingle(b @strings.Builder, cl @ast.CaseClause, items @[]@listItem) {
	b.Write("case")
	printItemsOneLine(b, items, cl.Pos, true, 1)
	b.WriteByte(':')
}

// caseLabelWidth returns the byte width of a case's rendered label.
func caseLabelWidth(cl @ast.CaseClause) int {
	var sb @strings.Builder = strings.NewBuilder()
	printCaseLabel(sb, cl)
	return len(sb.String())
}

// renderCaseBody renders a case's body statements joined by `; ` (with no
// comments) into a fresh string -- used to measure the single-line form and to
// detect a nested construct forcing it multi-line.
func renderCaseBody(cl @ast.CaseClause, indent int) @[]readonly char {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var sb @strings.Builder = strings.NewBuilder()
	for j := 0; j < len(body); j++ {
		if j > 0 { sb.Write("; ") }
		printStmt(sb, nil, body[j], indent + 1)
	}
	return sb.String()
}

// caseInlineEligible reports whether a case can be kept on one line: the source
// wrote every body statement on the label line, the body renders as a single
// physical line, and the whole `case X: body` fits within the width cap at the
// switch's indent, with the label on one line too (a comment in it can end its
// line).  (An empty body is eligible: `case X:` alone.)  The comments after it on
// its line, before limit (caseLimit), count toward the cap as well, unless
// expanded the case would not fit them either (caseExpandedFits): a case they take
// past the cap is expanded when that keeps every line of it within the cap.
func caseInlineEligible(cc @commentCursor, cl @ast.CaseClause, indent int, limit token.Pos) bool {
	var stmts @[]@ast.Stmt = printedStmts(cl.Body)
	for j := 0; j < len(stmts); j++ {
		if stmtStartPos(stmts[j]).Line != cl.Pos.Line { return false }
	}
	var body @[]readonly char = renderCaseBody(cl, indent)
	if hasNewline(body) { return false }
	var label @strings.Builder = strings.NewBuilder()
	printCaseLabel(label, cl)
	if hasNewline(label.String()) { return false }
	var w int = indent + caseLabelWidth(cl)
	if len(body) > 0 { w = w + 1 + len(body) }
	if w > MAX_LINE_WIDTH { return false }
	// Measured after the label and the body have rendered, so the comments their
	// lists print are claimed and left out.
	return w + caseTrailWidth(cc, cl, limit) <= MAX_LINE_WIDTH ||
			!caseExpandedFits(cc, cl, indent, limit)
}

// caseTrailWidth returns the width the comments a one-line case cl writes after its
// body (printCaseBodyInline), before limit, take there: those after its `case` on
// the line it ends on that its label's and body's lists do not print
// (trailingWidth; 0 when they hold the `// LONG-LINE ALLOWED` marker).
func caseTrailWidth(cc @commentCursor, cl @ast.CaseClause, limit token.Pos) int {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var end token.Pos = cl.Colon
	if len(body) > 0 { end = body[len(body) - 1].End }
	return trailingWidth(cc, commentsFrom(cl.Pos, end), limit)
}

// commentsFrom returns where the comments that follow a node from start to end on
// its last line are counted from (trailingWidth): start, when it is on end's line,
// else the start of that line -- its comments the node's lists do not print are
// emitted after it (emitTrailingCommentBefore).
func commentsFrom(start token.Pos, end token.Pos) token.Pos {
	if start.Line == end.Line { return start }
	var lineStart token.Pos
	lineStart.Line = end.Line
	return lineStart
}

// caseExpandedFits reports whether case cl at indent indent, expanded
// (printCaseExpanded), keeps every line within the cap with the comments the
// one-line case writes after its body, before limit (caseTrailWidth), after its
// last statement -- or after its label, with no body -- room left for them as
// printTrailing leaves it.  That is where a second format finds them when the case
// keeps its line, so it decides as this one does; expanded, a comment after the
// label or between statements goes there instead.  Its statements are measured
// with no cursor, as renderCaseBody renders them.
func caseExpandedFits(cc @commentCursor, cl @ast.CaseClause, indent int, limit token.Pos) bool {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var w int = caseTrailWidth(cc, cl, limit)
	var lw int = 0
	if len(body) == 0 { lw = w }
	var sb @strings.Builder = strings.NewBuilder()
	writeIndent(sb, indent)
	printCaseLabelWrapped(sb, cl, withTrail(0, lw, indent + 2))
	if !fitsWithTrail(sb, lw) { return false }
	for j := 0; j < len(body); j++ {
		var sw int = 0
		if j == len(body) - 1 { sw = w }
		sb = strings.NewBuilder()
		writeIndent(sb, indent + 1)
		printStmtTail(sb, nil, body[j], indent + 1, withTrail(0, sw, indent + 2))
		if !fitsWithTrail(sb, sw) { return false }
	}
	return true
}

// fitsWithTrail reports whether every line b holds is within the cap with w bytes
// after its last.
func fitsWithTrail(b @strings.Builder, w int) bool {
	return longestLineWidth(b.String()) <= MAX_LINE_WIDTH && lineWidth(b) + w <= MAX_LINE_WIDTH
}

// caseLineMarked reports whether case cl was written on one line with its body,
// and bears the `// LONG-LINE ALLOWED` marker after it, before limit (caseLimit):
// the line is then kept as written (printCaseMarked).  Expanded, the case would put
// its label and each statement on a line of their own, and only the last
// statement's would keep the marker.
func caseLineMarked(cc @commentCursor, cl @ast.CaseClause, limit token.Pos) bool {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	if len(body) == 0 || body[len(body) - 1].End.Line != cl.Pos.Line { return false }
	return hasLongLineMarker(cc, cl.Pos.Line, limit)
}

// printCaseMarked prints case cl (caseLineMarked) on a line of its own, with
// wrapping suppressed: its label, the comments after it, its body `;`-joined with
// the comments between them, and the comments after it before limit.  When the
// label or a statement cannot stay on the line (a block that must expand, for a
// comment between its statements), it prints the case expanded instead.
func printCaseMarked(b @strings.Builder, cc @commentCursor, cl @ast.CaseClause, indent int,
		limit token.Pos) {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	emitLeadingComments(b, cc, cl.Pos, indent, true)
	var trial @strings.Builder = strings.NewBuilder()
	writeIndent(trial, indent)
	var mark @cursorMark = markCursors(cc, body[len(body) - 1].End)
	var prev bool = setWrapSuppressed(true)
	printCaseLabel(trial, cl)
	emitTrailingCommentBefore(trial, cc, cl.Colon, stmtStartPos(body[0]))
	trial.WriteByte(' ')
	printJoinedStmts(trial, cc, body, 0, len(body), indent + 1)
	setWrapSuppressed(prev)
	var s @[]readonly char = trial.String()
	if !hasNewline(s) {
		b.WriteByte('\n')
		b.Write(s)
		emitTrailingCommentBefore(b, cc, body[len(body) - 1].End, limit)
		return
	}
	resetCursors(cc, mark)
	printCaseExpanded(b, cc, cl, indent, limit)
}

// caseRunEnd returns the end (exclusive) of the single-line alignment run
// starting at i: it stops at the first case that is not inline-eligible or that
// is separated from its predecessor by a source line gap (a blank line or an
// own-line comment).  close is the switch's `}`.
func caseRunEnd(cc @commentCursor, cases @[]@ast.CaseClause, i int, indent int,
		close token.Pos) int {
	var j int = i + 1
	for j < len(cases) {
		if !caseInlineEligible(cc, cases[j], indent, caseLimit(cases, j, close)) { break }
		if cases[j].Pos.Line - caseEndLine(cases[j - 1]) > 1 { break }
		j++
	}
	return j
}

// caseRunColumn returns the body-alignment column for cases[start:end] -- the
// widest label in the run -- or -1 when aligning to it would push some case's
// body past the width cap, or the comments after it (caseTrailWidth) when they fit
// unaligned, in which case bodies are emitted with a single space after the label
// (no alignment) to keep every line within the cap.  close is the switch's `}`.
func caseRunColumn(cc @commentCursor, cases @[]@ast.CaseClause, start int, end int, indent int,
		close token.Pos) int {
	var maxLabel int = 0
	for k := start; k < end; k++ {
		var lw int = caseLabelWidth(cases[k])
		if lw > maxLabel { maxLabel = lw }
	}
	for k := start; k < end; k++ {
		var bodyLen int = len(renderCaseBody(cases[k], indent))
		if bodyLen == 0 { continue }
		var w int = indent + 1 + bodyLen
		var cw int = caseTrailWidth(cc, cases[k], caseLimit(cases, k, close))
		if w + caseLabelWidth(cases[k]) + cw > MAX_LINE_WIDTH { cw = 0 }
		if w + maxLabel + cw > MAX_LINE_WIDTH { return -1 }
	}
	return maxLabel
}

// caseLimit returns where case i of a switch whose `}` is at close ends: the next
// case's position, or close.  A comment on a line the source went on past the
// case is not the case's.
func caseLimit(cases @[]@ast.CaseClause, i int, close token.Pos) token.Pos {
	if i + 1 < len(cases) { return cases[i + 1].Pos }
	return close
}

// printCaseRun emits cases[start:end] as single-line cases with their bodies
// aligned to a shared column (caseRunColumn); close is the switch's `}`.
func printCaseRun(b @strings.Builder, cc @commentCursor, cases @[]@ast.CaseClause, start int,
		end int, indent int, close token.Pos) {
	var col int = caseRunColumn(cc, cases, start, end, indent, close)
	for k := start; k < end; k++ {
		var cl @ast.CaseClause = cases[k]
		var limit token.Pos = caseLimit(cases, k, close)
		emitLeadingComments(b, cc, cl.Pos, indent, true)
		b.WriteByte('\n')
		writeIndent(b, indent)
		printCaseLabel(b, cl)
		if len(printedStmts(cl.Body)) > 0 {
			var lw int = caseLabelWidth(cl)
			if col >= 0 {
				for p := lw; p < col; p++ { b.WriteByte(' ') }
			}
			b.WriteByte(' ')
			printCaseBodyInline(b, cc, cl, indent, limit)
		} else {
			// Empty body: a same-line trailing comment still needs placing.
			emitTrailingCommentBefore(b, cc, cl.Colon, limit)
		}
	}
}

// printCaseBodyInline writes a case's body statements `; `-joined on the current
// line (rendered with no cursor, matching the eligibility trial), then places a
// same-line trailing comment, before limit (caseLimit), after the last statement.
func printCaseBodyInline(b @strings.Builder, cc @commentCursor, cl @ast.CaseClause, indent int,
		limit token.Pos) {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	for j := 0; j < len(body); j++ {
		if j > 0 { b.Write("; ") }
		printStmt(b, nil, body[j], indent + 1)
	}
	emitTrailingCommentBefore(b, cc, body[len(body) - 1].End, limit)
}

// printCaseExpanded emits a case whose body spans multiple lines: the label on
// its own line, then each body statement one level deeper, with own-line and
// trailing comments, before limit (caseLimit), and preserved blank lines.
func printCaseExpanded(b @strings.Builder, cc @commentCursor, cl @ast.CaseClause, indent int,
		limit token.Pos) {
	emitLeadingComments(b, cc, cl.Pos, indent, true)
	b.WriteByte('\n')
	writeIndent(b, indent)
	// A `// LONG-LINE ALLOWED` marker on the label line suppresses wrapping, matching
	// statement-level printStmtMaybeNoWrap; otherwise the label fill-wraps, leaving
	// room for the comments after it.
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var labelEnd token.Pos = limit
	if len(body) > 0 { labelEnd = stmtStartPos(body[0]) }
	var marked bool = hasLongLineMarker(cc, cl.Pos.Line, labelEnd)
	var prev bool = false
	if marked { prev = setWrapSuppressed(true) }
	printCaseLabelTrailing(b, cc, cl, indent, labelEnd)
	if marked { setWrapSuppressed(prev) }
	// A same-line comment after the label (e.g. the LONG-LINE marker itself) stays
	// on the label's last line, after its `:` -- otherwise it relocates to its own
	// line, and on a reprint hasLongLineMarker no longer sees it, so a marked label
	// would wrap (breaking idempotence).  One after a first statement on that line
	// is the statement's.
	emitTrailingCommentBefore(b, cc, cl.Colon, labelEnd)
	printStmtLines(b, cc, body, indent + 1, limit)
}
