package "pkg/binate/format"

import "pkg/builtins/testing"

// Consecutive single-line cases keep their bodies on the label line and align
// the bodies in a shared column (widest label + one space).
func TestSwitchInlineAligned() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return 1\n"
		"\tcase BB: return 2\n"
		"\t}\n"
		"}"
	return checkLayout(src, "\tcase A:  return 1\n\tcase BB: return 2\n")
}

// A `default` clause participates in single-line alignment like any case.
func TestSwitchInlineDefault() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return 1\n"
		"\tdefault: return 0\n"
		"\t}\n"
		"}"
	return checkLayout(src, "\tcase A:  return 1\n\tdefault: return 0\n")
}

// A multi-value case label aligns by its full rendered width.
func TestSwitchInlineMultiValue() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A, B: return 1\n"
		"\tcase C: return 2\n"
		"\t}\n"
		"}"
	return checkLayout(src, "\tcase A, B: return 1\n\tcase C:    return 2\n")
}

// A blank line between cases is preserved and resets the alignment run: each run
// aligns independently.
func TestSwitchBlankResetsRun() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return 1\n"
		"\n"
		"\tcase BBBB: return 2\n"
		"\t}\n"
		"}"
	// Run 1 = {A} aligns alone (one space); blank; run 2 = {BBBB} aligns alone.
	return checkLayout(src,
		"\tcase A: return 1\n\n\tcase BBBB: return 2\n")
}

// An expanded (multi-line) case breaks the run: the single-line cases on either
// side align independently, and the multi-line case keeps its expanded body.
func TestSwitchExpandedBreaksRun() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return 1\n"
		"\tcase B:\n"
		"\t\tg()\n"
		"\t\th()\n"
		"\tcase CCCC: return 2\n"
		"\t}\n"
		"}"
	var r testing.TestResult = checkLayout(src, "\tcase A: return 1\n")
	if len(r) > 0 { return r }
	// The expanded case's body stays on its own indented lines.
	return checkLayout(src, "\tcase B:\n\t\tg()\n\t\th()\n\tcase CCCC: return 2\n")
}

// A source multi-line case is not collapsed.
func TestSwitchMultiLinePreserved() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A:\n"
		"\t\treturn 1\n"
		"\t}\n"
		"}"
	return checkLayout(src, "\tcase A:\n\t\treturn 1\n")
}

// A single-line case whose body would exceed 100 columns is expanded.
func TestSwitchInlineWidthCap() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return aaaaaaaaaa + bbbbbbbbbb + cccccccccc + dddddddddd + "
		"eeeeeeeeee + ffffffffff + gggggggggg\n"
		"\t}\n"
		"}"
	var out @[]readonly char = fmtFunc(src)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if !containsSub(out, "\tcase A:\n\t\treturn") {
		return tokDiff("switch width cap: case not expanded", out, "case A:<nl><tab><tab>return")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("switch width cap: a line exceeds 100", out, "")
	}
	return ""
}

// An own-line comment between cases is placed above the following case and
// resets the alignment run; the comment multiset is preserved.
func TestSwitchCommentBetweenCases() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"func f() {\n"
		"\tswitch t {\n"
		"\tcase A: return 1\n"
		"\t// a note\n"
		"\tcase BBBB: return 2\n"
		"\t}\n"
		"}\n"
	var r testing.TestResult = checkComments(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = Format(parseCollected(src))
	if !containsSub(out, "\tcase A: return 1\n\t// a note\n\tcase BBBB: return 2") {
		return tokDiff("switch comment not placed / run not reset", out,
			"case A: return 1<nl>// a note<nl>case BBBB: return 2")
	}
	return ""
}
