package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// renderCaseBody renders a case's body statements joined by `; ` (with no
// comments) into a fresh string -- used to measure the single-line form and to
// detect a nested construct forcing it multi-line.
func renderCaseBody(cl @ast.CaseClause, indent int) @[]readonly char {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var sb @strings.Builder = strings.NewBuilder()
	for j := 0; j < len(body); j++ {
		if j > 0 { sb.Write("; ") }
		printStmt(sb, nil, body[j], indent + 1)
	}
	return sb.String()
}

// caseInlineEligible reports whether a case can be kept on one line: the source
// wrote every body statement on the label line, the body renders as a single
// physical line, and the whole `case X: body` fits within the width cap at the
// switch's indent, with the label on one line too (a comment in it can end its
// line).  (An empty body is eligible: `case X:` alone.)  The comments it writes on
// its line, before limit (caseLimit), count toward the cap as well (caseTrailWidth),
// unless expanded the case would not fit them either (caseExpandedFits): a case they
// take past the cap is expanded when that keeps every line of it within the cap.
func caseInlineEligible(cc @commentCursor, cl @ast.CaseClause, indent int, limit token.Pos) bool {
	var stmts @[]@ast.Stmt = printedStmts(cl.Body)
	for j := 0; j < len(stmts); j++ {
		if stmtStartPos(stmts[j]).Line != cl.Pos.Line { return false }
	}
	var body @[]readonly char = renderCaseBody(cl, indent)
	if hasNewline(body) { return false }
	var label @strings.Builder = strings.NewBuilder()
	printCaseLabel(label, cl)
	if hasNewline(label.String()) { return false }
	var w int = indent + caseLabelWidth(cl)
	if len(body) > 0 { w = w + 1 + len(body) }
	if w > MAX_LINE_WIDTH { return false }
	// Measured after the label and the body have rendered, so the comments their
	// lists print are claimed and left out.
	return w + caseTrailWidth(cc, cl, -1, limit) <= MAX_LINE_WIDTH ||
			!caseExpandedFits(cc, cl, indent, limit)
}

// caseTrailWidth returns the width the comments one-line case cl writes on its line
// (printCaseRun), before limit (caseLimit), take there: those after its label (k =
// -1) and after each statement k (caseCommentWidth), for k from from on; 0 when one
// of the comments it writes holds the `// LONG-LINE ALLOWED` marker, which exempts
// its line from the cap.
func caseTrailWidth(cc @commentCursor, cl @ast.CaseClause, from int, limit token.Pos) int {
	var w int = 0
	for k := -1; k < len(printedStmts(cl.Body)); k++ {
		cw, marked := caseCommentWidth(cc, cl, k, limit)
		if marked { return 0 }
		if k >= from { w = w + cw }
	}
	return w
}

// caseCommentWidth returns the width the comments one-line case cl writes after its
// label (k < 0) or after its statement k take there (commentWidth), and whether one
// of them holds the `// LONG-LINE ALLOWED` marker: those on the line the label or
// the statement ends on, from the case's or the statement's start there
// (commentsFrom), before the next statement, or limit (caseLimit) after the last --
// where printCaseRun writes them.  It peeks the cursor without advancing it; the
// comments the label's and the statements' lists print are claimed, and left out.
func caseCommentWidth(cc @commentCursor, cl @ast.CaseClause, k int, limit token.Pos) (int, bool) {
	if cc == nil { return 0, false }
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	var start token.Pos = cl.Pos
	var end token.Pos = cl.Colon
	if k >= 0 {
		start = stmtStartPos(body[k])
		end = body[k].End
	}
	var to token.Pos = limit
	if k + 1 < len(body) { to = stmtStartPos(body[k + 1]) }
	var from token.Pos = commentsFrom(start, end)
	var w int = 0
	var marked bool = false
	for j := lineComments(cc, end.Line); j < len(cc.comments); j++ {
		var c @token.Comment = cc.comments[j]
		if c.Pos.Line != end.Line { break }
		if to.Line > 0 && !posLess(c.Pos, to) { break }
		if !isDone(cc, j) && !posLess(c.Pos, from) {
			w = w + commentWidth(c)
			marked = marked || containsMarker(c.Text)
		}
	}
	return w, marked
}

// commentsFrom returns where the comments that follow a node from start to end on
// its last line are counted from (trailingWidth): start, when it is on end's line,
// else the start of that line -- its comments the node's lists do not print are
// emitted after it (emitTrailingCommentBefore).
func commentsFrom(start token.Pos, end token.Pos) token.Pos {
	if start.Line == end.Line { return start }
	var lineStart token.Pos
	lineStart.Line = end.Line
	return lineStart
}

// caseExpandedFits reports whether case cl at indent indent, expanded
// (printCaseExpanded), keeps every line within the cap with the comments the
// one-line case writes, before limit (caseLimit), where the expanded case writes
// them (caseCommentWidth): those after its label after the label's last line, and
// those after a statement after it -- room left for them as printTrailing leaves
// it.  A second format of a case that keeps its line finds them where it wrote
// them, so it decides as this one does.  Its statements are measured with no
// cursor, as renderCaseBody renders them.
func caseExpandedFits(cc @commentCursor, cl @ast.CaseClause, indent int, limit token.Pos) bool {
	var body @[]@ast.Stmt = printedStmts(cl.Body)
	lw, _ := caseCommentWidth(cc, cl, -1, limit)
	var sb @strings.Builder = strings.NewBuilder()
	writeIndent(sb, indent)
	printCaseLabelWrapped(sb, cl, withTrail(0, lw, indent + 2))
	if !fitsWithTrail(sb, lw) { return false }
	for j := 0; j < len(body); j++ {
		sw, _ := caseCommentWidth(cc, cl, j, limit)
		sb = strings.NewBuilder()
		writeIndent(sb, indent + 1)
		printStmtTail(sb, nil, body[j], indent + 1, withTrail(0, sw, indent + 2))
		if !fitsWithTrail(sb, sw) { return false }
	}
	return true
}

// fitsWithTrail reports whether every line b holds is within the cap with w bytes
// after its last.
func fitsWithTrail(b @strings.Builder, w int) bool {
	return longestLineWidth(b.String()) <= MAX_LINE_WIDTH && lineWidth(b) + w <= MAX_LINE_WIDTH
}

// caseRunColumn returns the body-alignment column for cases[start:end] -- the
// widest label in the run, with the comments after it (casePrefixWidth) -- or -1
// when padding some case to it would take past the width cap its line through its
// last statement (with the comments between its statements), or the comments after
// that (caseTrailWidth) when they fit unaligned, in which case bodies are emitted
// with a single space after the label and its comments (no alignment) to keep every
// line within the cap.  close is the switch's `}`.
func caseRunColumn(cc @commentCursor, cases @[]@ast.CaseClause, start int, end int, indent int,
		close token.Pos) int {
	var col int = 0
	for k := start; k < end; k++ {
		var pw int = casePrefixWidth(cc, cases[k], caseLimit(cases, k, close))
		if pw > col { col = pw }
	}
	for k := start; k < end; k++ {
		var n int = len(printedStmts(cases[k].Body))
		if n == 0 { continue }
		var limit token.Pos = caseLimit(cases, k, close)
		var pw int = casePrefixWidth(cc, cases[k], limit)
		var w int = indent + pw + 1 + len(renderCaseBody(cases[k], indent))
		for j := 0; j < n - 1; j++ {
			mw, _ := caseCommentWidth(cc, cases[k], j, limit)
			w = w + mw
		}
		var cw int = caseTrailWidth(cc, cases[k], n - 1, limit)
		if w + cw > MAX_LINE_WIDTH { cw = 0 }
		if col > pw && w + col - pw + cw > MAX_LINE_WIDTH { return -1 }
	}
	return col
}

// casePrefixWidth returns the width of one-line case cl's label with the comments
// after it, before limit (caseLimit), which its body follows (printCaseRun): its
// label alone when it has no body, as the comments after it then end its line.
func casePrefixWidth(cc @commentCursor, cl @ast.CaseClause, limit token.Pos) int {
	var w int = caseLabelWidth(cl)
	if len(printedStmts(cl.Body)) == 0 { return w }
	lw, _ := caseCommentWidth(cc, cl, -1, limit)
	return w + lw
}
