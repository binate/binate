package "pkg/binate/format"

import "pkg/builtins/testing"

// A case written on one line with its body expands when the comments after it take it past the
// cap, and expanded keeps them within it: a comment between its statements goes after the first,
// and a statement wraps for the comment after it, also when the source wrote it over two lines.
func TestOneLineCaseExpandsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: yyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbb"
			"bb) // long c\n"
			"\tcase 2: aaaaaaaaaaaaaaaaaa() /* between */; yyyyyyyyyyyyyyyy := ffffffffffffffffffff(aaaa"
			"aaaaaaaaaaaaaaa) // c\n"
			"\tcase 3: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment too long for it\n"
			"\tcase 4: aaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\tcccccccccccccccccccccccccccccc) // a comment that fits only expanded\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:\n"
			"\t\tyyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbb) //"
			" long c\n"
			"\tcase 2:\n"
			"\t\taaaaaaaaaaaaaaaaaa() /* between */\n"
			"\t\tyyyyyyyyyyyyyyyy := ffffffffffffffffffff(aaaaaaaaaaaaaaaaaaa) // c\n"
			"\tcase 3:\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t\tcc) // a comment too long for it\n"
			"\tcase 4:\n"
			"\t\taaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t\tcccccccccccccccccccccccccccccc) // a comment that fits only expanded\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A case written on one line with its body keeps it when expanded it would not fit the comment
// after it either -- and its run still aligns its body, which fits; the comment after a statement
// the source wrote over two lines is on its last line -- or when the comment bears the `// LONG-
// LINE ALLOWED` marker.  A case with no body keeps its line too when its one label cannot wrap to
// make room for its comment, and the next case's body still aligns with it.
func TestOneLineCaseKeepsItsLineWhenExpandingCannotFitItsComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: g() // a comment far too long to fit anywhere, even after a single byte on a cont"
			"inuation line of it\n"
			"\tcase 10000000: h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaa(bbbbbbb,\n"
			"\t\tccc) // a comment far too long to fit anywhere, even after a single byte on a continuat"
			"ion line of it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccc) "
			"// LONG-LINE ALLOWED here\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: // a comment this one label cannot"
			" wrap to make room for\n"
			"\tcase 2: g()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:        g() // a comment far too long to fit anywhere, even after a single byte on"
			" a continuation line of it\n"
			"\tcase 10000000: h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaa(bbbbbbb, ccc) // a comment far too long to fit anywhere, even after a si"
			"ngle byte on a continuation line of it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccc) "
			"// LONG-LINE ALLOWED here\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: // a comment this one label cannot"
			" wrap to make room for\n"
			"\tcase 2:                                                g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A run of one-line cases does not align their bodies when that would take a case's comment past
// the cap.
func TestCaseRunAlignsBodiesOnlyWhereTheCommentsStillFit() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment\n"
			"\tcase 10000000: g()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment\n"
			"\tcase 10000000: g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An expanded case's labels wrap to keep the comment after them within the cap, and so do those of
// a case with no body, which then no longer aligns the next case's body with them.
func TestCaseLabelWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccccccccccccccc: /"
			"/ a long comment\n"
			"\t\tg()\n"
			"\tcase dddddddddddddddddddd, eeeeeeeeeeeeeeeeeeeeeeeeeee, ffffffffffffffffffffffffffffff: /"
			"/ a long comment here\n"
			"\tcase 2: g()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccccccccccccccccc: // a long comment\n"
			"\t\tg()\n"
			"\tcase dddddddddddddddddddd, eeeeeeeeeeeeeeeeeeeeeeeeeee,\n"
			"\t\t\tffffffffffffffffffffffffffffff: // a long comment here\n"
			"\tcase 2: g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A case kept on one line with its body keeps its comments where the source put them: after its
// label, between its statements and after them, also when its last statement ends on a later
// source line, and in a statement's header (print_header.bn).  A comment after the label counts
// as part of it for the run's alignment.
func TestOneLineCaseKeepsItsCommentsInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: a() /* c */; b()\n"
			"\tcase 2: /* l */ a()\n"
			"\tcase 3: a() /* c */; b() // t\n"
			"\tdefault: /* d */ h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 5: a()\n"
			"\tcase 6: a() /* x */; b(c,\n"
			"\t\td) // e\n"
			"\tcase 77: a()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: if x /* i */ { a() }; b()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:          a() /* c */; b()\n"
			"\tcase 2: /* l */  a()\n"
			"\tcase 3:          a() /* c */; b() // t\n"
			"\tdefault: /* d */ h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 5:  a()\n"
			"\tcase 6:  a() /* x */; b(c, d) // e\n"
			"\tcase 77: a()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: if x /* i */ { a() }; b()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A one-line case's width checks measure its comments where it writes them: a case they take past
// the cap expands when expanded each fits after its label or its statement, and keeps its line
// when one does not -- after a label or a first statement that cannot wrap for it.
func TestOneLineCaseMeasuresItsCommentsWhereItWritesThem() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: /* after the label */ g(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"b) // after it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 2: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa() /* ccccccccc"
			"ccccccccccccccccccc */; b()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa /*"
			" cccccccccc */: g() // d\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: /* after the label */\n"
			"\t\tg(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) // after it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 2: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa() /* ccccccccc"
			"ccccccccccccccccccc */; b()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: /"
			"* cccccccccc */ g() // d\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A case kept on one line past the cap, or on a `// LONG-LINE ALLOWED` line, prints its body as
// its width checks measured it, though the comments before a statement push it right: the
// statement does not wrap, and a block in it stays on the line.
func TestOneLineCaseKeptPastTheCapPrintsItsBodyAsMeasured() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccc */ f(aaaa, bbbb)\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccc */ f(aaaa, bbbb) // LONG-LINE ALLOWED\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: a() /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc */; if x "
			"{ b() }; g() // ttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
			"tttttttttttttt\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// A run of one-line cases does not align their bodies when that would take past the cap a case's
// code after a comment between its statements, or lengthen a line its label's comment takes past
// the cap.
func TestCaseRunDoesNotPadALinePastTheCapForItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: a() /* cccccccccccccccccccc */; f(aaaa, bbbb); g() // ttttttttttttttttttttttttttttttt"
			"tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt\n"
			"\tcase 22222222222222222222222222222222222222222222222222: g()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: /* ccccccccccccccccccccccccc */ xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxx() // tttttttttttttttttttttttttttttttttttt\n"
			"\tcase 22222222222222222222222222222222222222222222222222: g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, src)
}
