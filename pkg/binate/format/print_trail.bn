package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A statement, a declaration or a group member is followed on its last line by the
// comments after it on the line it ends on (emitTrailingCommentBefore), which stay
// there however it is laid out.  Its width checks leave room for them, as a tail,
// so it wraps to keep them within the cap -- unless that cannot help: when they do
// not fit even after a byte on a continuation line (withTrail), or when the
// layout with room for them still does not fit them on its last line (one that
// cannot wrap enough); and not when they hold the `// LONG-LINE ALLOWED` marker,
// which allows the line past the cap (a statement that spans lines, or one a
// marked line cannot keep, prints unmarked but for its last line).  Whether the
// room is kept is decided on the layout that has it, which a second format finds
// as this one printed it -- not on the one without, which this one replaces.
//
// Which comments follow it is known only once it is printed: one inside it that
// no list prints is still pending at its end, and the comments after it then go
// on lines of their own (emitTrailingCommentBefore stops at it), or, on its last
// line, it goes along with them.  So when a comment is pending on the line it
// ends on, it prints in a trial, with room for the comments after its end
// (trailingWidth); then it prints again with room for what does follow it
// (pendingTrailWidth), when that differs, or with none, when the room does not
// fit them.  A second print claims the comments the trial claimed -- a list
// claims its own by position, however it is laid out (print_listcomments.bn) --
// and it reuses the renderings the trial cached, which do not claim them again: so
// the trial's claims stay, and only the cursors' positions are put back
// (markPositions).

// trailNode is a node printTrailing prints: a statement of a block indented indent
// tabs, a top-level declaration after its annotation block, or a group member.
type trailNode struct {
	stmt   @ast.Stmt
	decl   @ast.Decl
	member @ast.Decl
	indent int
}

// printNodeTail prints n followed on its last line by tail bytes.
func printNodeTail(b @strings.Builder, cc @commentCursor, n @trailNode, tail int) {
	if n.stmt != nil {
		printStmtTail(b, cc, n.stmt, n.indent, tail)
	} else if n.decl != nil {
		printDeclBodyTail(b, cc, n.decl, tail)
	} else {
		printGroupMember(b, n.member, tail)
	}
}

// printStmtTrailing is printStmt for a statement of a block indented indent tabs,
// with room for the comments that follow it on its last line, before limit (the
// next node on its line, or the enclosing close).
func printStmtTrailing(b @strings.Builder, cc @commentCursor, s @ast.Stmt, indent int,
		limit token.Pos) {
	var n @trailNode = make(trailNode)
	n.stmt = s
	n.indent = indent
	printTrailing(b, cc, n, s.End, limit, indent + 1)
}

// printDeclBodyTrailing is printStmtTrailing for top-level declaration d after its
// annotation block (printDeclBody).
func printDeclBodyTrailing(b @strings.Builder, cc @commentCursor, d @ast.Decl, limit token.Pos) {
	var n @trailNode = make(trailNode)
	n.decl = d
	printTrailing(b, cc, n, d.End, limit, 1)
}

// printGroupMemberTrailing is printStmtTrailing for member k of group d, at member
// indent mi, in a run that aligns its comments at column col
// (groupRunCommentColumn).  A run aligns them at a column only when each member's
// first comment fits there after the member's one-line body (memberTrailingCommentLen),
// and the member then prints with no room for them.
func printGroupMemberTrailing(b @strings.Builder, cc @commentCursor, d @ast.Decl, k int, col int,
		mi int) {
	var n @trailNode = make(trailNode)
	n.member = d.Decls[k]
	if col > 0 {
		printNodeTail(b, cc, n, 0)
		return
	}
	printTrailing(b, cc, n, n.member.End, memberLimit(d, k), mi + 1)
}

// printTrailing prints n, which ends at end, with room for the comments that
// follow it on that line before limit (see above); cont is the column its
// continuation lines start at.
func printTrailing(b @strings.Builder, cc @commentCursor, n @trailNode, end token.Pos,
		limit token.Pos, cont int) {
	if !commentOnLine(cc, end.Line, limit) {
		printNodeTail(b, cc, n, 0)
		return
	}
	var mark @cursorPos = markPositions(cc)
	var w int = trailingWidth(cc, end, limit)
	var tail int = withTrail(0, w, cont)
	var trial @strings.Builder = lineTrial(b)
	printNodeTail(trial, cc, n, tail)
	var got int = pendingTrailWidth(cc, end, limit)
	if got != w {
		resetPositions(cc, mark)
		w = got
		tail = withTrail(0, w, cont)
		trial = lineTrial(b)
		printNodeTail(trial, cc, n, tail)
	}
	if tail > 0 && lineWidth(trial) + w > MAX_LINE_WIDTH {
		resetPositions(cc, mark)
		trial = lineTrial(b)
		printNodeTail(trial, cc, n, 0)
	}
	appendTrial(b, trial)
}

// appendTrial appends to b what trial (made by lineTrial(b)) printed after b's
// current line.
func appendTrial(b @strings.Builder, trial @strings.Builder) {
	var t @[]readonly char = trial.String()
	b.Write(t[len(currentLine(b)):len(t)])
}

// cursorPos holds the positions of a statement's comment cursor and of
// activeCursor (markPositions, resetPositions).
type cursorPos struct {
	stmt   int
	active int
}

// markPositions returns the positions of cc and of activeCursor (-1 for a nil one).
func markPositions(cc @commentCursor) @cursorPos {
	var p @cursorPos = make(cursorPos)
	p.stmt = -1
	p.active = -1
	if cc != nil { p.stmt = cc.idx }
	if activeCursor != nil { p.active = activeCursor.idx }
	return p
}

// resetPositions puts cc and activeCursor back at the positions markPositions
// returned, leaving the comments claimed since claimed.
func resetPositions(cc @commentCursor, p @cursorPos) {
	if cc != nil { cc.idx = p.stmt }
	if activeCursor != nil { activeCursor.idx = p.active }
}

// lineComments returns the index of cc's first comment from the given source line
// on that cc has not emitted (those before its position): the line's first, when
// it has one.
func lineComments(cc @commentCursor, line int) int {
	var lineStart token.Pos
	lineStart.Line = line
	var first int = firstAfter(cc, lineStart)
	if first < cc.idx { first = cc.idx }
	return first
}

// commentOnLine reports whether a comment cc has not emitted is pending on the
// given source line, before limit (unless it is the zero Pos).
func commentOnLine(cc @commentCursor, line int, limit token.Pos) bool {
	if cc == nil { return false }
	for k := lineComments(cc, line); k < len(cc.comments); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line != line { return false }
		if limit.Line > 0 && !posLess(c.Pos, limit) { return false }
		if !isDone(cc, k) { return true }
	}
	return false
}

// trailingWidth returns the width the pending comments after end on its line,
// before limit (unless it is the zero Pos), take there (commentWidth); 0 when
// they hold the `// LONG-LINE ALLOWED` marker.
func trailingWidth(cc @commentCursor, end token.Pos, limit token.Pos) int {
	var w int = 0
	for k := lineComments(cc, end.Line); k < len(cc.comments); k++ {
		var c @token.Comment = cc.comments[k]
		if c.Pos.Line != end.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		if !isDone(cc, k) && !posLess(c.Pos, end) {
			if containsMarker(c.Text) { return 0 }
			w = w + commentWidth(c)
		}
	}
	return w
}

// pendingTrailWidth returns the width the comments emitTrailingCommentBefore would
// now write after a node ending at end, before limit, take on its line
// (commentWidth; 0 when they hold the marker): it peeks the cursor, as that walks
// it.
func pendingTrailWidth(cc @commentCursor, end token.Pos, limit token.Pos) int {
	var w int = 0
	for k := cc.idx; k < len(cc.comments); k++ {
		if isDone(cc, k) { continue }
		var c @token.Comment = cc.comments[k]
		if c.OwnLine || c.Pos.Line != end.Line { break }
		if limit.Line > 0 && !posLess(c.Pos, limit) { break }
		if containsMarker(c.Text) { return 0 }
		w = w + commentWidth(c)
	}
	return w
}

// commentWidth returns the width trailing comment c takes on its line: the space
// before it and its text, up to the end of its first line (the rest of a block
// comment that spans lines goes on the lines after), without the blanks that end
// it there, which the output drops (finalizeFile).
func commentWidth(c @token.Comment) int {
	return 1 + rtrimEnd(c.Text, 0, firstLineLen(c.Text))
}
