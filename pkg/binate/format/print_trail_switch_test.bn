package "pkg/binate/format"

import "pkg/builtins/testing"

// A case written on one line with its body expands when the comments after it take it past the
// cap, and expanded keeps them within it: a comment between its statements goes after the first,
// and a statement wraps for the comment after it.
func TestOneLineCaseExpandsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: yyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbb"
			"bb) // long c\n"
			"\tcase 2: aaaaaaaaaaaaaaaaaa() /* between */; yyyyyyyyyyyyyyyy := ffffffffffffffffffff(aaaa"
			"aaaaaaaaaaaaaaa) // c\n"
			"\tcase 3: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment too long for it\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:\n"
			"\t\tyyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbb) //"
			" long c\n"
			"\tcase 2:\n"
			"\t\taaaaaaaaaaaaaaaaaa() /* between */\n"
			"\t\tyyyyyyyyyyyyyyyy := ffffffffffffffffffff(aaaaaaaaaaaaaaaaaaa) // c\n"
			"\tcase 3:\n"
			"\t\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t\tcc) // a comment too long for it\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A case written on one line with its body keeps it when expanded it would not fit the comment
// after it either -- and its run still aligns its body, which fits; the comment after a statement
// the source wrote over two lines is on its last line -- or when the comment bears the `// LONG-
// LINE ALLOWED` marker.
func TestOneLineCaseKeepsItsLineWhenExpandingCannotFitItsComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: g() // a comment far too long to fit anywhere, even after a single byte on a cont"
			"inuation line of it\n"
			"\tcase 10000000: h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaa(bbbbbbb,\n"
			"\t\tccc) // a comment far too long to fit anywhere, even after a single byte on a continuat"
			"ion line of it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccc) "
			"// LONG-LINE ALLOWED here\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:        g() // a comment far too long to fit anywhere, even after a single byte on"
			" a continuation line of it\n"
			"\tcase 10000000: h()\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaa(bbbbbbb, ccc) // a comment far too long to fit anywhere, even after a si"
			"ngle byte on a continuation line of it\n"
			"\t}\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccc) "
			"// LONG-LINE ALLOWED here\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A run of one-line cases does not align their bodies when that would take a case's comment past
// the cap.
func TestCaseRunAlignsBodiesOnlyWhereTheCommentsStillFit() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment\n"
			"\tcase 10000000: g()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cc) // a c"
			"omment\n"
			"\tcase 10000000: g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// An expanded case's labels wrap to keep the comment after them within the cap, and so do those of
// a case with no body, which then no longer aligns the next case's body with them.
func TestCaseLabelWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccccccccccccccc: /"
			"/ a long comment\n"
			"\t\tg()\n"
			"\tcase dddddddddddddddddddd, eeeeeeeeeeeeeeeeeeeeeeeeeee, ffffffffffffffffffffffffffffff: /"
			"/ a long comment here\n"
			"\tcase 2: g()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccccccccccccccccc: // a long comment\n"
			"\t\tg()\n"
			"\tcase dddddddddddddddddddd, eeeeeeeeeeeeeeeeeeeeeeeeeee,\n"
			"\t\t\tffffffffffffffffffffffffffffff: // a long comment here\n"
			"\tcase 2: g()\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
