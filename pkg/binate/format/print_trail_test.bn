package "pkg/binate/format"

import "pkg/binate/parser"
import "pkg/builtins/testing"

// checkFormatGoldenIface is checkFormatGolden for a .bni source.
func checkFormatGoldenIface(src *[]readonly char, want *[]readonly char) testing.TestResult {
	var p @parser.Parser = parser.NewInterfaceCollecting(toBytes(src), "t.bni")
	var out @[]readonly char = Format(mustParse(p))
	if !streq(out, want) {
		return tokDiff("format mismatch", out, want)
	}
	var q @parser.Parser = parser.NewInterfaceCollecting(toBytes(out), "t.bni")
	var again @[]readonly char = Format(mustParse(q))
	if !streq(again, out) {
		return tokDiff("formatting the output again changed it", again, out)
	}
	return ""
}

// A statement wraps to keep the comments after it on its last line within the cap -- a call, a
// single value, a value list, a `return`, a `var` and an increment -- measured without the blanks
// that end a comment, which the output drops; but not for a comment too wide to fit even after a
// byte on a continuation line, nor when the layout with room for them still does not fit them.
func TestStatementWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() (int, int) {\n"
			"\tqqqqqqqqqq = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) // a long tr"
			"ailing comment that pushes it\n"
			"\txxxxxxxxxxxxxxxx = yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy // a long trailing comment that pu"
			"shes it past the cap\n"
			"\tgggggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc) // a long tr"
			"ailing comment pushing\n"
			"\ta, b = ffffffffffffffffffff(aaaaaaaaaaaaaa), gggggggggggggggggggggggg(bbbbbbbbbbbbbbbbbb)"
			" // a trailing comment\n"
			"\tvar vvvvvvvvvvvv int = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) //"
			" a long trailing comment\n"
			"\ttttttttttttttttttttt[ffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbb)"
			"]++ // a comment\n"
			"\tzzzzzzzzz = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, ccccccccccccccc) /* b */ // two"
			" comments after\n"
			"\tx := 1 // a comment far too long to fit anywhere even after a single byte on a continuati"
			"on line of this statement\n"
			"\tx := gggggggggggggggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbb) // ab"
			"cdefghijkl   \n"
			"\ttotal := base + computeTheAdjustedOffsetForTheCurrentFrameAndSlot(frame) // the adjusted "
			"offset, see the ABI notes\n"
			"\treturn ffffffffffffffffffffffffffffff(aaaaaaaaaaaaaa), ggggggggggggggggggggggg(bbbbbbbbbb"
			"bb) // a trailing comment\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() (int, int) {\n"
			"\tqqqqqqqqqq = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccc) // a long trailing comment that pushes it\n"
			"\txxxxxxxxxxxxxxxx =\n"
			"\t\tyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy // a long trailing comment that pushes it past the "
			"cap\n"
			"\tgggggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccc) // a long trailing comment pushing\n"
			"\ta, b = ffffffffffffffffffff(aaaaaaaaaaaaaa),\n"
			"\t\tgggggggggggggggggggggggg(bbbbbbbbbbbbbbbbbb) // a trailing comment\n"
			"\tvar vvvvvvvvvvvv int = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccc) // a long trailing comment\n"
			"\ttttttttttttttttttttt[ffffffffffffffff(aaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbb)]++ // a comment\n"
			"\tzzzzzzzzz = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\t\tccccccccccccccc) /* b */ // two comments after\n"
			"\tx := 1 // a comment far too long to fit anywhere even after a single byte on a continuati"
			"on line of this statement\n"
			"\tx := gggggggggggggggggggggggggggggggg(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbb) // ab"
			"cdefghijkl\n"
			"\ttotal := base + computeTheAdjustedOffsetForTheCurrentFrameAndSlot(frame) // the adjusted "
			"offset, see the ABI notes\n"
			"\treturn ffffffffffffffffffffffffffffff(aaaaaaaaaaaaaa),\n"
			"\t\tggggggggggggggggggggggg(bbbbbbbbbbbb) // a trailing comment\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A one-line block -- the last of an `if` chain, a `for`'s, a `defer`'s, a function literal's --
// expands to keep the comments after its statement within the cap, and a statement joined to
// another on its line wraps for its own.
func TestBlockExpandsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif xxxxxxxxxxxxxxxxxxxxx { return } // a long trailing comment that pushes the line past "
			"the cap, really\n"
			"\tfor i := 0; i < nnnnnnnnnnnnnnnnnnn; i++ { ssssssssssssssssss(i) } // a long trailing com"
			"ment past the cap\n"
			"\tdefer { cccccccccccccccccccccccccccccccc(dddddddddddddddddddddddd) } // a long trailing c"
			"omment past cap\n"
			"\tif a { b() } else { eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee(fffffffffffffffffffff"
			") } // a long comment\n"
			"\tif a { b() } else if c { d() } else { eeeeeeeeeeeeeeeeeeeeeeee(fffffffffffffffffffff) } /"
			"/ a long comment\n"
			"\tkkkkkkkkkkkk := func() { aaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) } // a lo"
			"ng trailing comment\n"
			"\taaaaaa(); qqqqqqqqqq = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) //"
			" a long trailing comment\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tif xxxxxxxxxxxxxxxxxxxxx {\n"
			"\t\treturn\n"
			"\t} // a long trailing comment that pushes the line past the cap, really\n"
			"\tfor i := 0; i < nnnnnnnnnnnnnnnnnnn; i++ {\n"
			"\t\tssssssssssssssssss(i)\n"
			"\t} // a long trailing comment past the cap\n"
			"\tdefer {\n"
			"\t\tcccccccccccccccccccccccccccccccc(dddddddddddddddddddddddd)\n"
			"\t} // a long trailing comment past cap\n"
			"\tif a { b() } else {\n"
			"\t\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee(fffffffffffffffffffff)\n"
			"\t} // a long comment\n"
			"\tif a { b() } else if c { d() } else {\n"
			"\t\teeeeeeeeeeeeeeeeeeeeeeee(fffffffffffffffffffff)\n"
			"\t} // a long comment\n"
			"\tkkkkkkkkkkkk := func() {\n"
			"\t\taaaaaaaaaaaaaaaaaa(bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)\n"
			"\t} // a long trailing comment\n"
			"\taaaaaa()\n"
			"\tqqqqqqqqqq = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\t\tcccccccccccccccc) // a long trailing comment\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A top-level declaration and a group member, in a function too, wrap to keep the comments after
// them within the cap, and a one-line function body expands; a member of a run whose comments
// align at a column, where they fit, does not.
func TestDeclarationWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var gggggggggggg int = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) // a"
			" long trailing comment\n"
			"\n"
			"const kkkkkkkkkkkkkkkk = aaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbb + ccccccccccc"
			"c // a long trailing comment\n"
			"\n"
			"var (\n"
			"\tm1 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc, ddddddddd) // a long"
			" trailing comment\n"
			"\tm2 = 2 // short\n"
			")\n"
			"\n"
			"var (\n"
			"\tn1 = 1 // aligned\n"
			"\tn22 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb) // a comment that fits after the memb"
			"er's body\n"
			")\n"
			"\n"
			"func g() {\n"
			"\tvar (\n"
			"\t\tm1 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc, ddddddddd) // a lo"
			"ng trailing comment\n"
			"\t\tm2 = 2 // short\n"
			"\t)\n"
			"}\n"
			"\n"
			"func h() int { return fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) } // "
			"a long trailing\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var gggggggggggg int = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb,\n"
			"\t\tcccccccccccccccc) // a long trailing comment\n"
			"\n"
			"const kkkkkkkkkkkkkkkk = aaaaaaaaaaaaaaaaaaaa + bbbbbbbbbbbbbbbbbbbbbbbbbbbbb +\n"
			"\t\tcccccccccccc // a long trailing comment\n"
			"\n"
			"var (\n"
			"\tm1 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc,\n"
			"\t\t\tddddddddd) // a long trailing comment\n"
			"\tm2 = 2 // short\n"
			")\n"
			"\n"
			"var (\n"
			"\tn1 = 1                                              // aligned\n"
			"\tn22 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb) // a comment that fits after the memb"
			"er's body\n"
			")\n"
			"\n"
			"func g() {\n"
			"\tvar (\n"
			"\t\tm1 = fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc,\n"
			"\t\t\t\tddddddddd) // a long trailing comment\n"
			"\t\tm2 = 2 // short\n"
			"\t)\n"
			"}\n"
			"\n"
			"func h() int {\n"
			"\treturn fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc)\n"
			"} // a long trailing\n"
	return checkFormatGolden(src, want)
}

// A signature with no body wraps its parameters to keep the comment after it within the cap.
func TestSignatureWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func Fffffffffffffffff(aaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int, cccccccccccc int) int //"
			" a trailing comment\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func Fffffffffffffffff(aaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbb int,\n"
			"\t\tcccccccccccc int) int // a trailing comment\n"
	return checkFormatGoldenIface(src, want)
}

// A comment inside a statement that no list prints decides what follows it: one on an earlier line
// holds the comments after the statement off its line, so it leaves no room for them, and one on
// its last line goes after it with them, so it leaves room for both; one a list prints changes
// nothing.  The comments a list claimed in the first print, in a function literal's body too,
// print once.
func TestTrailingCommentsAfterAnInnerComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tqqqqqqqqqq = 1 + /* c */\n"
			"\t\tfffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc) // a long trailing comm"
			"ent pushing\n"
			"\tpppppppppppp = 1 + /* z */ ffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb"
			") // a long\n"
			"\trrrrrrrrrrrr = gggggggggggg(Tttt{/* k */ aaaaaaaaaaaaaaaaaaaaa}, bbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbb) /* m */ // n\n"
			"\tpppppppppp = 1 + /* z */ fffffffffff(Tttt{/* k */ aaaaaaaaaaaaaaaaa}, bbbbbbbbbbbbbbbbbbb"
			"bbbb) // a long\n"
			"\tpppppppppp = 1 + /* z */ fffffffffff(gggggg(aaaaaaaaaaaa, /* k */ bbbbbbbbbbbb), cccccccc"
			"ccccccccc) // long\n"
			"\tpppppppppp = 1 + /* z */ fffffffffff(func() { aaaaaa() /* in */; bbbbbbbb() }, cccccccccc"
			"ccccccc, dddddddddddddddddddddddddddddddd, eeeeeeeeeeeeeeeeeeeeee) // a long comment\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tqqqqqqqqqq = 1 + fffffffff(aaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbb, cccccccccccccccc)\n"
			"\t/* c */\n"
			"\t// a long trailing comment pushing\n"
			"\tpppppppppppp = 1 +\n"
			"\t\t\tffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbb) /* z */ // a long\n"
			"\trrrrrrrrrrrr = gggggggggggg(Tttt{/* k */ aaaaaaaaaaaaaaaaaaaaa},\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) /* m */ // n\n"
			"\tpppppppppp = 1 +\n"
			"\t\t\tfffffffffff(Tttt{/* k */ aaaaaaaaaaaaaaaaa}, bbbbbbbbbbbbbbbbbbbbbbb) /* z */ // a lo"
			"ng\n"
			"\tpppppppppp = 1 +\n"
			"\t\t\tfffffffffff(gggggg(aaaaaaaaaaaa, /* k */ bbbbbbbbbbbb), ccccccccccccccccc) /* z */ //"
			" long\n"
			"\tpppppppppp = 1 +\n"
			"\t\t\tfffffffffff(func() {\n"
			"\t\t\t\taaaaaa() /* in */\n"
			"\t\t\t\tbbbbbbbb()\n"
			"\t\t\t}, ccccccccccccccccc, dddddddddddddddddddddddddddddddd,\n"
			"\t\t\t\t\teeeeeeeeeeeeeeeeeeeeee) /* z */ // a long comment\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A `// LONG-LINE ALLOWED` marker after a statement allows its line past the cap, so the statement
// does not wrap for it, as it does for a plain comment.
func TestTrailingMarkerLeavesNoRoom() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxx = yyyy +\n"
			"\t\tffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccc) // a pla"
			"in comment, no marker\n"
			"\txxxx = yyyy +\n"
			"\t\tffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccccc) // LONG-"
			"LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\txxxx = yyyy +\n"
			"\t\t\tffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\t\t\tcccccccccccccccccc) // a plain comment, no marker\n"
			"\txxxx = yyyy + ffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccccccc"
			"cc) // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A declaration that cannot stay on the `// LONG-LINE ALLOWED` line it shares with the next one --
// a function literal in it expands for a comment between its statements -- prints alone, unmarked,
// and wraps to keep the comments after it within the cap.
func TestMarkedLineDeclarationThatCannotStayWrapsForTheCommentsAfterIt() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var aaaa = gggg(func() int { x := 1 /* in */; return x }, bbbbbbbbbbbbbbbbbbbbbbbb, ccccccc"
			"ccccccccccccc) /* after aaaa, a long comment that runs on and on */; var b = 2 // LONG-LINE"
			" ALLOWED\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var aaaa = gggg(func() int {\n"
			"\tx := 1 /* in */\n"
			"\treturn x\n"
			"}, bbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\tcccccccccccccccccccc) /* after aaaa, a long comment that runs on and on */\n"
			"\n"
			"var b = 2 // LONG-LINE ALLOWED\n"
	return checkFormatGolden(src, want)
}

// A statement in a case's body wraps to keep the comment after it within the cap.
func TestCaseBodyStatementWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:\n"
			"\t\tyyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbb"
			"b) // long c\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tswitch x {\n"
			"\tcase 1:\n"
			"\t\tyyyyyyyyyyyyyyyyy := ffffffffffffffffffffffff(aaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t\tbbbbbbbbbbbbbbbbbbbb) // long c\n"
			"\t}\n"
			"}\n"
	return checkFormatGolden(src, want)
}
