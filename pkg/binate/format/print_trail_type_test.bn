package "pkg/binate/format"

import "pkg/builtins/testing"

// A variable declared with only a type, a type declaration and a group member wrap the type for
// the comment after it, as a variable with a value wraps the value: a function type's parameters,
// an instantiation's type arguments, the same through a pointer, and the parameters of a function
// type's one result; a local variable too.
func TestTypedOnlyDeclarationWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var V *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int"
			") int // trailing comment\n"
			"\n"
			"var Vzz vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			" int] // trailing comment\n"
			"\n"
			"var Vp *vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			" int] // trailing comment\n"
			"\n"
			"var Vr *func() *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			" int) int // trailing comment\n"
			"\n"
			"type T *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, in"
			"t) int // trailing comment\n"
			"\n"
			"type (\n"
			"\tU *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int) "
			"int // a trailing comment\n"
			"\tW int\n"
			")\n"
			"\n"
			"func f() {\n"
			"\tvar L *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, i"
			"nt) int // trailing c\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var V *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"var Vzz vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			"\n"
			"\t\tint] // trailing comment\n"
			"\n"
			"var Vp *vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			"\n"
			"\t\tint] // trailing comment\n"
			"\n"
			"var Vr *func() *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			"\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"type T *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"type (\n"
			"\tU *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\t\tint) int // a trailing comment\n"
			"\tW int\n"
			")\n"
			"\n"
			"func f() {\n"
			"\tvar L *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\t\tint) int // trailing c\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A type inside an array, a raw or managed slice, a managed pointer, a `readonly` type or
// parentheses -- right up to the cap -- wraps for the comment after them, as a managed function
// type does.
func TestTypeWrapsForItsTrailingCommentInsideAnotherType() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var Va [4]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int)"
			" int // trailing comment\n"
			"\n"
			"var Vm @vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			" int] // trailing comment\n"
			"\n"
			"var Vs *[]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int)"
			" int // trailing comment\n"
			"\n"
			"var Vt @[]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int)"
			" int // trailing comment\n"
			"\n"
			"var Vc *[]readonly vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int"
			", int] // trailing comment\n"
			"\n"
			"var Vf @func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, in"
			"t) int // trailing comment\n"
			"\n"
			"var Vq (*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int) i"
			"nt) // cccc\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var Va [4]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"var Vm @vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			"\n"
			"\t\tint] // trailing comment\n"
			"\n"
			"var Vs *[]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"var Vt @[]*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"var Vc *[]readonly vec.Vec[int, int, int, int, int, int, int, int, int, int, int, int, int"
			",\n"
			"\t\tint] // trailing comment\n"
			"\n"
			"var Vf @func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int // trailing comment\n"
			"\n"
			"var Vq (*func(int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) int) // cccc\n"
	return checkFormatGolden(src, want)
}

// A function type's parameters wrap to leave room for its results after them, which stay whole.
func TestFuncTypeParamsLeaveRoomForTheResults() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var Vxx *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, i"
			"nt, int) int\n"
			"\n"
			"var Vyy *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, i"
			"nt) (int, int)\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var Vxx *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, i"
			"nt,\n"
			"\t\tint) int\n"
			"\n"
			"var Vyy *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,\n"
			"\t\tint) (int, int)\n"
	return checkFormatGolden(src, want)
}

// A function's result type leaves room for the ` {` of the body after it, in a declaration and in a
// function literal.
func TestResultTypeLeavesRoomForTheBodyAfterIt() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func makeC(ba int) @func(int, int, int, int, int, int, int, int, int, int, int, int, int, "
			"int, int, int) int {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\th(func(b int) @func(int, int, int, int, int, int, int, int, int, int, int, int, int, int"
			", int, int) int {\n"
			"\t\treturn nil\n"
			"\t})\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func makeC(\n"
			"\t\tba int) @func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, in"
			"t,\n"
			"\t\t\t\tint) int {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func g() {\n"
			"\th(func(\n"
			"\t\t\tb int) @func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, i"
			"nt,\n"
			"\t\t\t\t\tint) int {\n"
			"\t\t\t\t\t\treturn nil\n"
			"\t\t\t\t\t})\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A struct field's type wraps for the comment after it.
func TestStructFieldTypeWrapsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, "
			"int) int // c\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tF *func(int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int,"
			"\n"
			"\t\t\tint) int // c\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A run of struct fields does not pad their names when that would take a field's comment past the
// cap -- unless the comment does not fit after the field unpadded either, or follows a struct type,
// whose last line the padding does not move.
func TestStructRunAlignsNamesOnlyWhereTheCommentsStillFit() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\ta int // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxaaaaaaaaa"
			"aaaaaaaaaa\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\ta int // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxaaaaaaaaa"
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
			"\n"
			"type U struct {\n"
			"\ta struct {\n"
			"\t\tx int\n"
			"\t} // a comment after the struct type of a field, on a line the padding does not move\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\ta int // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxaaaaaaaaa"
			"aaaaaaaaaa\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\ta                    int // xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
			"xxxxxxxxxxaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
			"\n"
			"type U struct {\n"
			"\ta                    struct {\n"
			"\t\tx int\n"
			"\t} // a comment after the struct type of a field, on a line the padding does not move\n"
			"\tbbbbbbbbbbbbbbbbbbbb int\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A run of struct fields measures each field as it prints, after its name and with room for what
// follows it: a field whose type wraps for that -- a function type for its results, an
// instantiation for its comment, a struct type that expands for one -- pads its first line, as it
// does when formatted again.
func TestStructRunMeasuresAFieldAsItPrints() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\taveryveryverylongname int\n"
			"\tf *func(int) RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR"
			"RRRRRRRRRRRRR\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\taveryveryverylongname int\n"
			"\tf vec.Vec[RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR] // a "
			"comment here\n"
			"}\n"
			"\n"
			"type U struct {\n"
			"\taveryveryverylongname int\n"
			"\tc struct { p int; q int; r int; s int; t int; u int; v int; w int; x int; yyyyyyy int } "
			"// a comment here\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\taveryveryverylongname int\n"
			"\tf                     *func(\n"
			"\t\t\tint) RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR"
			"RRRRRRRRR\n"
			"}\n"
			"\n"
			"type T struct {\n"
			"\taveryveryverylongname int\n"
			"\tf                     vec.Vec[\n"
			"\t\t\tRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR] // a commen"
			"t here\n"
			"}\n"
			"\n"
			"type U struct {\n"
			"\taveryveryverylongname int\n"
			"\tc                     struct {\n"
			"\t\tp       int\n"
			"\t\tq       int\n"
			"\t\tr       int\n"
			"\t\ts       int\n"
			"\t\tt       int\n"
			"\t\tu       int\n"
			"\t\tv       int\n"
			"\t\tw       int\n"
			"\t\tx       int\n"
			"\t\tyyyyyyy int\n"
			"\t} // a comment here\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A struct type kept on one line expands when the comment after it would take it past the cap.
func TestOneLineStructExpandsForItsTrailingComment() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var Vss struct { a int; b int; c int; d int; e int; f int; g int; h int; i int; jjjjjjjjjj"
			" int } // cc\n"
			"\n"
			"type Q struct { a int; b int; c int; d int; e int; f int; g int; h int; i int; jjjjjjjjjjj"
			"j int } // cc\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var Vss struct {\n"
			"\ta          int\n"
			"\tb          int\n"
			"\tc          int\n"
			"\td          int\n"
			"\te          int\n"
			"\tf          int\n"
			"\tg          int\n"
			"\th          int\n"
			"\ti          int\n"
			"\tjjjjjjjjjj int\n"
			"} // cc\n"
			"\n"
			"type Q struct {\n"
			"\ta            int\n"
			"\tb            int\n"
			"\tc            int\n"
			"\td            int\n"
			"\te            int\n"
			"\tf            int\n"
			"\tg            int\n"
			"\th            int\n"
			"\ti            int\n"
			"\tjjjjjjjjjjjj int\n"
			"} // cc\n"
	return checkFormatGolden(src, want)
}

// A function's several results wrap to leave room for what follows them: in a function type, the
// comment after it; in a declaration and a function literal with no parameters to wrap, the ` {`
// of the body.
func TestSeveralResultsLeaveRoomForWhatFollowsThem() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var V *func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, ccccccccc"
			"cc) // a trailing comment\n"
			"\n"
			"func f() {\n"
			"\tvar W *func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccc"
			"ccc) // a trailing c\n"
			"}\n"
			"\n"
			"func gggggggg() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbb) {\n"
			"\treturn nil, nil\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tx := func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
			"bbbbbbbbb) {\n"
			"\t\treturn nil, nil\n"
			"\t}\n"
			"\tg(x)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var V *func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\tccccccccccc) // a trailing comment\n"
			"\n"
			"func f() {\n"
			"\tvar W *func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,\n"
			"\t\t\tccccccccccc) // a trailing c\n"
			"}\n"
			"\n"
			"func gggggggg() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) {\n"
			"\treturn nil, nil\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tx := func() (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) {\n"
			"\t\t\t\treturn nil, nil\n"
			"\t\t\t}\n"
			"\tg(x)\n"
			"}\n"
	return checkFormatGolden(src, want)
}
