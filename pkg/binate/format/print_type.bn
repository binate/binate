package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// FormatType renders a type expression to canonical source text.  This is the
// step-4 slice of the formatter's printer (type expressions only); statements,
// declarations, and general expressions land in later steps.
func FormatType(te @ast.TypeExpr) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	printType(b, te)
	return b.String()
}

// printType appends the source form of te to b, recursing into nested types.
func printType(b @strings.Builder, te @ast.TypeExpr) {
	if te == nil { return }
	var k int = te.Kind
	if k == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 {
			b.Write(te.Pkg)
			b.WriteByte('.')
		}
		b.Write(te.Name)
		return
	}
	if k == ast.TEXPR_POINTER {
		b.WriteByte('*')
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_MANAGED {
		b.WriteByte('@')
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_SLICE {
		b.Write("*[]")
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_MANAGED_SLICE {
		b.Write("@[]")
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_ARRAY {
		b.WriteByte('[')
		printArrayLen(b, te)
		b.WriteByte(']')
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_PAREN {
		b.WriteByte('(')
		printType(b, te.Base)
		b.WriteByte(')')
		return
	}
	if k == ast.TEXPR_CONST {
		// `readonly T` -- the type-expression read-only modifier.
		b.Write("readonly ")
		printType(b, te.Base)
		return
	}
	if k == ast.TEXPR_SELF {
		b.Write("Self")
		return
	}
	if k == ast.TEXPR_STRUCT {
		// A struct reached through printType (nested in another type, or in an
		// expression) has no comment cursor -- any interior comment falls to the
		// backstop.  A struct in a type declaration is printed via printTypeDef,
		// which threads the cursor so field comments interleave.
		printStructType(b, nil, te)
		return
	}
	if k == ast.TEXPR_FUNC_VALUE {
		b.WriteByte('*')
		printFuncType(b, te)
		return
	}
	if k == ast.TEXPR_MANAGED_FUNC_VALUE {
		b.WriteByte('@')
		printFuncType(b, te)
		return
	}
	if k == ast.TEXPR_INSTANTIATE {
		printType(b, te.Base)
		printTypeArgs(b, te.Base, te.TypeArgs)
		return
	}
	// TEXPR_TYPE_PARAM is checker-only (never produced by a fresh parse); fall
	// back to the name so an unexpected node still emits something.
	b.Write(te.Name)
}

// printArrayLen appends an array type's length: `...` for an inferred length,
// or a leaf length expression (an integer literal or an identifier).  Complex
// length expressions (e.g. `[N+1]T`) await the expression printer, a later
// step.
func printArrayLen(b @strings.Builder, te @ast.TypeExpr) {
	if te.LenInferred {
		b.Write("...")
		return
	}
	var e @ast.Expr = te.Len
	if e == nil { return }
	// EXPR_INT_LIT and EXPR_IDENT carry their raw text in Name.
	b.Write(e.Name)
}

// printStructType appends a struct type.  A struct the source kept on one line
// (and whose rendering fits within MAX_LINE_WIDTH, with no interior comment)
// prints single-line `struct { a A; b B }`; otherwise it prints multi-line, one
// field per line, with field types aligned in a column per run (a run breaks at
// a blank line or an interleaved comment).  cc (may be nil) interleaves own-line
// comments between fields.
func printStructType(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr) {
	if structFitsSingleLine(b, cc, te) {
		printStructInline(b, te)
		return
	}
	printStructMulti(b, cc, te)
}

// structFitsSingleLine reports whether te can be kept on one line: the source
// wrote it on one line, it has no interior comment to place, and the single-line
// rendering fits within the width cap at the current column.
func structFitsSingleLine(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr) bool {
	if te.Pos.Line != te.End.Line { return false }
	if commentBefore(cc, te.End) { return false }
	var scratch @strings.Builder = strings.NewBuilder()
	printStructInline(scratch, te)
	var s @[]readonly char = scratch.String()
	return !hasNewline(s) && lineWidth(b) + len(s) <= MAX_LINE_WIDTH
}

// printStructInline appends the single-line struct form `struct { <field>;
// <field> }` (`struct {}` when empty).  An anonymous embed field has an empty
// Name -- just its type.
func printStructInline(b @strings.Builder, te @ast.TypeExpr) {
	b.Write("struct {")
	for i := 0; i < len(te.Fields); i++ {
		var fd @ast.FieldDecl = te.Fields[i]
		if i == 0 {
			b.WriteByte(' ')
		} else {
			b.Write("; ")
		}
		if len(fd.Name) > 0 {
			b.Write(fd.Name)
			b.WriteByte(' ')
		}
		printType(b, fd.Type)
	}
	if len(te.Fields) > 0 {
		b.WriteByte(' ')
	}
	b.WriteByte('}')
}

// printStructMulti appends a multi-line struct: `struct {` then each field on
// its own line one level deeper than the `struct` keyword, then `}` back at the
// keyword's indent.  Fields are grouped into alignment runs (broken by a blank
// line or interleaved comment, detected as a source line gap); within a run the
// names are space-padded so the types start in a shared column.
func printStructMulti(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr) {
	var indent int = currentLineIndent(b)
	var fi int = indent + 1
	b.Write("struct {")
	var fields @[]@ast.FieldDecl = te.Fields
	var i int = 0
	for i < len(fields) {
		var j int = structRunEnd(fields, i)
		var w int = structRunColumn(fields, i, j, fi)
		if i > 0 && hasBlankGap(cc, fields[i - 1].Type.End.Line, fields[i].Pos.Line) {
			b.WriteByte('\n')
		}
		for k := i; k < j; k++ {
			emitStructField(b, cc, fields[k], fi, w)
		}
		i = j
	}
	// Dangling comments after the last field, before the closing brace.
	emitLeadingComments(b, cc, te.End, fi, false)
	b.WriteByte('\n')
	writeIndent(b, indent)
	b.WriteByte('}')
}

// structRunEnd returns the end (exclusive) of the alignment run starting at i:
// the first field separated from its predecessor by a source line gap (a blank
// line or an own-line comment breaks the run).
func structRunEnd(fields @[]@ast.FieldDecl, i int) int {
	var j int = i + 1
	for j < len(fields) {
		if fields[j].Pos.Line - fields[j - 1].Type.End.Line > 1 { break }
		j++
	}
	return j
}

// structRunColumn returns the name-padding width for the alignment run
// fields[start:end] -- the widest field name -- or -1 (no alignment: a single
// space between name and type) when padding to that width would push some
// field's `name type` line past MAX_LINE_WIDTH, mirroring the switch and group
// aligners' width-safe fallback.
func structRunColumn(fields @[]@ast.FieldDecl, start int, end int, fi int) int {
	var w int = 0
	for k := start; k < end; k++ {
		if len(fields[k].Name) > w { w = len(fields[k].Name) }
	}
	for k := start; k < end; k++ {
		if len(fields[k].Name) == 0 { continue }
		if fi + w + 1 + fieldTypeWidth(fields[k].Type) > MAX_LINE_WIDTH {
			return -1
		}
	}
	return w
}

// fieldTypeWidth returns the byte length of a field type's rendered form (used
// to width-check the alignment column).
func fieldTypeWidth(te @ast.TypeExpr) int {
	var sb @strings.Builder = strings.NewBuilder()
	printType(sb, te)
	return len(sb.String())
}

// emitStructField appends one field line: any own-line comments above it, then
// the tab indent, the name padded to nameWidth, the type, and a same-line
// trailing comment.  An anonymous embed (empty name) emits just its type.
func emitStructField(b @strings.Builder, cc @commentCursor, fd @ast.FieldDecl, indent int,
		nameWidth int) {
	emitLeadingComments(b, cc, fd.Pos, indent, true)
	b.WriteByte('\n')
	writeIndent(b, indent)
	if len(fd.Name) > 0 {
		b.Write(fd.Name)
		for p := len(fd.Name); p < nameWidth; p++ { b.WriteByte(' ') }
		b.WriteByte(' ')
	}
	printType(b, fd.Type)
	emitTrailingComment(b, cc, fd.Type.End)
}

// printFuncType appends the `func(<params>) <results>` body of a function-value
// type; the caller emits the leading `*` or `@` sigil.  A single result is
// unparenthesized; two or more are parenthesized.
func printFuncType(b @strings.Builder, te @ast.TypeExpr) {
	b.Write("func")
	// printFuncParamTypes re-emits the `...` marker for a variadic function-value
	// type `func(...T)`, else the reprint silently becomes fixed-arity, and wraps
	// the list when it would exceed the width cap.
	printFuncParamTypes(b, te)
	var nr int = len(te.ResultTypes)
	if nr == 1 {
		b.WriteByte(' ')
		printType(b, te.ResultTypes[0])
	} else if nr > 1 {
		b.WriteByte(' ')
		printTypeListWrapped(b, '(', ')', te.ResultTypes, te.ResultTypes[0].Pos.Line, 0)
	}
}
