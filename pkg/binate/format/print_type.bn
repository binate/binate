package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// FormatType renders a type expression to canonical source text.
func FormatType(te @ast.TypeExpr) @[]readonly char {
	resetRenderCache()
	var b @strings.Builder = strings.NewBuilder()
	printType(b, te)
	dropRenderCache()
	return b.String()
}

// printType appends the source form of te to b, recursing into nested types.
func printType(b @strings.Builder, te @ast.TypeExpr) {
	printTypeTail(b, te, 0)
}

// printTypeTail is printType for a type followed on its last line by tail bytes
// (the comments after a variable's type, a field's or a type declaration's, or
// what follows a result type there).  The tail goes to the part the type ends
// with, whose width checks leave room for it: a function type's results, which
// its parameters leave room for too, an instantiation's type arguments, or a
// struct type's one-line form.
func printTypeTail(b @strings.Builder, te @ast.TypeExpr, tail int) {
	if te == nil { return }
	var k int = te.Kind
	if k == ast.TEXPR_NAMED {
		if len(te.Pkg) > 0 {
			b.Write(te.Pkg)
			b.WriteByte('.')
		}
		b.Write(te.Name)
		return
	}
	if k == ast.TEXPR_POINTER {
		b.WriteByte('*')
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_MANAGED {
		b.WriteByte('@')
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_SLICE {
		b.Write("*[]")
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_MANAGED_SLICE {
		b.Write("@[]")
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_ARRAY {
		b.WriteByte('[')
		printArrayLen(b, te)
		b.WriteByte(']')
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_PAREN {
		b.WriteByte('(')
		printTypeTail(b, te.Base, tail + 1)
		b.WriteByte(')')
		return
	}
	if k == ast.TEXPR_CONST {
		// `readonly T` -- the type-expression read-only modifier.
		b.Write("readonly ")
		printTypeTail(b, te.Base, tail)
		return
	}
	if k == ast.TEXPR_SELF {
		b.Write("Self")
		return
	}
	if k == ast.TEXPR_STRUCT {
		// A struct reached through printType (a variable's, a field's or a
		// parameter's type, or one in an expression) prints the comments inside it
		// through a cursor of its own (innerCursor), as a function literal's body
		// does; it is the active cursor for the types in it.  A struct a type
		// declaration defines is printed via printTypeDef, with the declaration's
		// cursor when it has one.
		var local @commentCursor = innerCursor(te.Pos, te.End)
		var saved @commentCursor = activeCursor
		activeCursor = local
		printStructType(b, local, te, tail)
		activeCursor = saved
		return
	}
	if k == ast.TEXPR_FUNC_VALUE {
		b.WriteByte('*')
		printFuncType(b, te, tail)
		return
	}
	if k == ast.TEXPR_MANAGED_FUNC_VALUE {
		b.WriteByte('@')
		printFuncType(b, te, tail)
		return
	}
	if k == ast.TEXPR_INSTANTIATE {
		printType(b, te.Base)
		printTypeArgs(b, te, tail)
		return
	}
	// TEXPR_TYPE_PARAM is checker-only (never produced by a fresh parse); print
	// its name.
	if k == ast.TEXPR_TYPE_PARAM {
		b.Write(te.Name)
		return
	}
	panic("bnfmt: printType has no case for this type-expression kind")
}

// printArrayLen appends an array type's length: `...` for an inferred length,
// otherwise the dimension expression in canonical source form.  A leaf length
// (`[3]T`, `[N]T`) prints as its raw text; a compound const expression
// (`[N+1]T`, `[cast(int, 5)]T`) is reproduced verbatim by the expression printer
// -- emitting a bare `[]` for a non-leaf dimension would corrupt the type
// (bare `[]T` does not parse — a raw slice is `*[]T`).
func printArrayLen(b @strings.Builder, te @ast.TypeExpr) {
	if te.LenInferred {
		b.Write("...")
		return
	}
	if te.Len == nil { return }
	printExpr(b, te.Len)
}

// printStructType appends a struct type.  A struct the source kept on one line
// (and whose rendering fits within MAX_LINE_WIDTH, with no interior comment, or
// that is on a `// LONG-LINE ALLOWED` line -- structFitsSingleLine) prints
// single-line `struct { a A; b B }`, followed by tail bytes; otherwise it
// prints multi-line, one field per line, with field types aligned in a column per
// run (a run breaks at a blank line or an interleaved comment).  cc (may be nil)
// interleaves own-line comments between fields.
func printStructType(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr, tail int) {
	if structFitsSingleLine(b, cc, te, tail) {
		printStructInline(b, te)
		return
	}
	printStructMulti(b, cc, te)
}

// structFitsSingleLine reports whether te can be kept on one line: the source
// wrote it on one line, it has no interior comment to place, and the single-line
// rendering fits within the width cap at the current column, with tail bytes
// after it; or it is on a
// `// LONG-LINE ALLOWED` line (wrapSuppressed), which keeps it whole, with its
// comments when they all sit in its lists, which print them (expanded, the marker
// would end up after its `}`, unmarking the lines above it), as it does a block.
func structFitsSingleLine(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr, tail int) bool {
	if te.Pos.Line != te.End.Line { return false }
	if !wrapSuppressed && commentBefore(cc, te.End) { return false }
	var scratch @strings.Builder = strings.NewBuilder()
	printStructInline(scratch, te)
	var s @[]readonly char = scratch.String()
	// The trial's lists claim the comments in their gaps; one they leave (between
	// fields) is placed only by printStructMulti.
	return !hasNewline(s) && !commentBefore(cc, te.End) &&
			(wrapSuppressed || lineWidth(b) + len(s) + tail <= MAX_LINE_WIDTH)
}

// printStructInline appends the single-line struct form `struct { <field>;
// <field> }` (`struct {}` when empty).  An anonymous embed field has an empty
// Name -- just its type.
func printStructInline(b @strings.Builder, te @ast.TypeExpr) {
	b.Write("struct {")
	for i := 0; i < len(te.Fields); i++ {
		var fd @ast.FieldDecl = te.Fields[i]
		if i == 0 {
			b.WriteByte(' ')
		} else {
			b.Write("; ")
		}
		if len(fd.Name) > 0 {
			b.Write(fd.Name)
			b.WriteByte(' ')
		}
		printType(b, fd.Type)
	}
	if len(te.Fields) > 0 {
		b.WriteByte(' ')
	}
	b.WriteByte('}')
}

// printStructMulti appends a multi-line struct: `struct {` then each field on
// its own line one level deeper than the `struct` keyword, then `}` back at the
// keyword's indent.  Fields are grouped into alignment runs (broken by a blank
// line or interleaved comment, detected as a source line gap); within a run the
// names are space-padded so the types start in a shared column.
func printStructMulti(b @strings.Builder, cc @commentCursor, te @ast.TypeExpr) {
	var indent int = currentLineIndent(b)
	var fi int = indent + 1
	b.Write("struct {")
	var fields @[]@ast.FieldDecl = te.Fields
	var i int = 0
	for i < len(fields) {
		var j int = structRunEnd(fields, i)
		var w int = structRunColumn(cc, fields, i, j, fi, te.End)
		if i > 0 && hasBlankGap(cc, fields[i - 1].Type.End.Line, fields[i].Pos.Line) {
			b.WriteByte('\n')
		}
		for k := i; k < j; k++ {
			emitStructField(b, cc, fields[k], fi, w, fieldLimit(fields, k, te.End))
		}
		i = j
	}
	// Dangling comments after the last field, before the closing brace.
	emitLeadingComments(b, cc, te.End, fi, false)
	b.WriteByte('\n')
	writeIndent(b, indent)
	b.WriteByte('}')
}

// structRunEnd returns the end (exclusive) of the alignment run starting at i:
// the first field separated from its predecessor by a source line gap (a blank
// line or an own-line comment breaks the run).
func structRunEnd(fields @[]@ast.FieldDecl, i int) int {
	var j int = i + 1
	for j < len(fields) {
		if fields[j].Pos.Line - fields[j - 1].Type.End.Line > 1 { break }
		j++
	}
	return j
}

// structRunColumn returns the name-padding width for the alignment run
// fields[start:end], at field indent fi, of a struct whose `}` is at close -- the
// widest field name -- or -1 (no alignment: a single space between name and type)
// when padding to that width would push the first line of some field (fieldLine),
// with the comments after it there (fieldTrailWidth), past MAX_LINE_WIDTH,
// mirroring the switch and group aligners' width-safe fallback.  Comments that do
// not fit after the field unpadded either do not keep the run from aligning.
func structRunColumn(cc @commentCursor, fields @[]@ast.FieldDecl, start int, end int, fi int,
		close token.Pos) int {
	var w int = 0
	for k := start; k < end; k++ {
		if len(fields[k].Name) > w { w = len(fields[k].Name) }
	}
	for k := start; k < end; k++ {
		if len(fields[k].Name) == 0 { continue }
		var s @[]readonly char = fieldLine(cc, fields[k], fi, fieldLimit(fields, k, close))
		var lw int = firstLineLen(s)
		var cw int = fieldTrailWidth(cc, fields, k, close, s)
		if lw + cw > MAX_LINE_WIDTH { cw = 0 }
		if lw + w - len(fields[k].Name) + cw > MAX_LINE_WIDTH { return -1 }
	}
	return w
}

// fieldLine returns the lines of field fd at indent indent as emitStructField prints
// it unpadded, without the comments after it before limit, which its type leaves
// room for (printFieldTypeTrailing).  Padding moves its first line only.  Measured
// at column 0 and with no room instead, a type that wraps where it prints would be
// measured whole, and, once formatted again, wrapped, by a first line that may
// leave room to pad: the run would align only on a second format.  The cursors are
// left where they were (markPositions).
func fieldLine(cc @commentCursor, fd @ast.FieldDecl, indent int, limit token.Pos) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	writeIndent(sb, indent)
	sb.Write(fd.Name)
	sb.WriteByte(' ')
	var mark @cursorPos = markPositions(cc)
	printFieldTypeTrailing(sb, cc, fd, indent, limit)
	resetPositions(cc, mark)
	return sb.String()
}

// fieldTrailWidth returns the width the comments after field k of a struct whose
// `}` is at close take on its line (trailingWidth), after its lines s (fieldLine):
// 0 when s takes several lines, as they then follow its last, which the alignment
// does not pad.
func fieldTrailWidth(cc @commentCursor, fields @[]@ast.FieldDecl, k int, close token.Pos,
		s *[]readonly char) int {
	if hasNewline(s) { return 0 }
	return trailingWidth(cc, fields[k].Type.End, fieldLimit(fields, k, close))
}

// fieldLimit returns where field k of a struct whose `}` is at close ends: the next
// field's position, or close.
func fieldLimit(fields @[]@ast.FieldDecl, k int, close token.Pos) token.Pos {
	if k + 1 < len(fields) { return fields[k + 1].Pos }
	return close
}

// emitStructField appends one field line: any own-line comments above it, then
// the tab indent, the name padded to nameWidth, the type, with room for the
// same-line trailing comments before limit (the next field's start, or the
// struct's end; printFieldTypeTrailing), and those comments.  An anonymous embed
// (empty name) emits just its type.
func emitStructField(b @strings.Builder, cc @commentCursor, fd @ast.FieldDecl, indent int,
		nameWidth int, limit token.Pos) {
	emitLeadingComments(b, cc, fd.Pos, indent, true)
	b.WriteByte('\n')
	writeIndent(b, indent)
	if len(fd.Name) > 0 {
		b.Write(fd.Name)
		for p := len(fd.Name); p < nameWidth; p++ { b.WriteByte(' ') }
		b.WriteByte(' ')
	}
	printFieldTypeTrailing(b, cc, fd, indent, limit)
	emitTrailingCommentBefore(b, cc, fd.Type.End, limit)
}

// printFuncType appends the `func(<params>) <results>` body of a function-value
// type, followed on its last line by tail bytes (printTypeTail); the caller emits
// the leading `*` or `@` sigil.  A single result is unparenthesized; two or more
// are parenthesized (printResults).
func printFuncType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	b.Write("func")
	// printFuncParamTypes re-emits the `...` marker for a variadic function-value
	// type `func(...T)`, else the reprint silently becomes fixed-arity, and wraps
	// the list when it would exceed the width cap with the results and the tail
	// after it.
	printFuncParamTypes(b, te, sigSuffixLen(te.ResultTypes, tail))
	printResults(b, te.ResultTypes, tail)
}
