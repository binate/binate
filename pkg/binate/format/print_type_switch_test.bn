package "pkg/binate/format"

import "pkg/builtins/testing"

// Type-switch formatting (printTypeSwitch, print_switch.bn / §14.10).  checkLayout
// re-parses the formatted output and asserts it is token-equivalent to the input
// (so nothing is dropped) AND idempotent, then checks
// the expected layout substring.

// A binder type switch reconstructs `v := x.(type)` and renders per-case
// AssertTargetList labels.
func TestTypeSwitchBinder() testing.TestResult {
	var src *[]readonly char = "func f(x *I) {\n"
			"\tswitch v := x.(type) {\n"
			"\tcase *A:\n"
			"\t\treturn\n"
			"\tdefault:\n"
			"\t\treturn\n"
			"\t}\n"
			"}"
	return checkLayout(src, "switch v := x.(type) {")
}

// The binderless form drops the `v :=` head.
func TestTypeSwitchBinderless() testing.TestResult {
	var src *[]readonly char = "func f(x *I) {\n"
			"\tswitch x.(type) {\n"
			"\tcase *A:\n"
			"\t\treturn\n"
			"\t}\n"
			"}"
	return checkLayout(src, "switch x.(type) {")
}

// A multi-target case label renders each AssertTarget, recovery kind and all.
func TestTypeSwitchMultiTarget() testing.TestResult {
	var src *[]readonly char = "func f(x *I) {\n"
			"\tswitch x.(type) {\n"
			"\tcase *A, @B:\n"
			"\t\treturn\n"
			"\t}\n"
			"}"
	return checkLayout(src, "case *A, @B:")
}

// Single-line type-switch cases align their bodies in a shared column, like an
// expression switch.
func TestTypeSwitchInlineAligned() testing.TestResult {
	var src *[]readonly char = "func f(x *I) {\n"
			"\tswitch x.(type) {\n"
			"\tcase *A: return 1\n"
			"\tcase *BB: return 2\n"
			"\t}\n"
			"}"
	return checkLayout(src, "\tcase *A:  return 1\n\tcase *BB: return 2\n")
}

// The scrutinee is the head of the `.(type)` postfix (the grammar takes a
// PostfixExpr there) in the header's D4 context, so it keeps the parentheses
// around a binary, unary or raw-slice scrutinee and around a literal of a type
// name at its left edge, or a decimal integer (`1.` lexes as a float); an array
// literal, or a literal inside a call, needs none.
func TestTypeSwitchScrutineeParens() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tswitch (S{1}).(type) {\n"
			"\t}\n"
			"\tswitch v := (pkg.T{}).(type) {\n"
			"\t}\n"
			"\tswitch (S{1}).x.(type) {\n"
			"\t}\n"
			"\tswitch (a + b).(type) {\n"
			"\t}\n"
			"\tswitch (*p).(type) {\n"
			"\t}\n"
			"\tswitch v := (*[]any{1}).(type) {\n"
			"\t}\n"
			"\tswitch [1]any{1}[0].(type) {\n"
			"\t}\n"
			"\tswitch f(S{1}).(type) {\n"
			"\t}\n"
			"\tswitch (1).(type) {\n"
			"\t}\n"
			"}\n"
	return checkGolden(src, src)
}

// A scrutinee leaves room for what follows it on its line -- `.(type) {` and the
// comments around it -- so one that would end past the width cap wraps.
func TestTypeSwitchScrutineeLeavesRoom() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tswitch v := ffffffffff(aaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(type) {\n"
			"\tcase *A:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch v := (aaaaaaaaaa + "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(type) {\n"
			"\tcase *A:\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var want *[]readonly char = "package \"t\"\n"
			"\n"
			"func f() {\n"
			"\tswitch v := ffffffffff(aaaaaaaaaa,\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(type) {\n"
			"\tcase *A:\n"
			"\t\tg()\n"
			"\t}\n"
			"\tswitch v := (aaaaaaaaaa +\n"
			"\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb).(type) {\n"
			"\tcase *A:\n"
			"\t\tg()\n"
			"\t}\n"
			"}\n"
	var r testing.TestResult = checkGolden(src, want)
	if len(r) > 0 { return r }
	return checkGolden(want, want)
}
