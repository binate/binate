package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/lexer"
import "pkg/binate/parser"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

// toBytes copies a char slice into an owned byte slice for the lexer/parser.
func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// streq compares two char slices for equality.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// normTokens lexes src into its significant token stream, applying the
// normalization the token-equality gate uses: drop every SEMICOLON (ASI or
// explicit), drop a COMMA immediately before a closing ) ] } (a trailing comma),
// and collapse a run of adjacent STRING tokens into one merged literal (a
// source-preserving formatter may split one long string into several, or keep an
// author split; they concatenate to the same value).  Two sources that lex to the
// same normalized stream are equivalent modulo whitespace, ASI, trailing commas,
// and adjacent-string boundaries.
func normTokens(src *[]readonly char) @[]@token.Token {
	var l @lexer.Lexer = lexer.New(toBytes(src), "")
	var raw @[]@token.Token
	for {
		var t token.Token = l.Next()
		if t.Typ == token.EOF { break }
		if t.Typ == token.SEMICOLON { continue }
		raw = slices.Append[@token.Token](raw, box(t))
	}
	var noComma @[]@token.Token
	for i := 0; i < len(raw); i++ {
		if raw[i].Typ == token.COMMA && i + 1 < len(raw) {
			var nt token.Type = raw[i + 1].Typ
			if nt == token.RPAREN || nt == token.RBRACKET || nt == token.RBRACE {
				continue
			}
		}
		noComma = slices.Append[@token.Token](noComma, raw[i])
	}
	var out @[]@token.Token
	for i := 0; i < len(noComma); i++ {
		if noComma[i].Typ != token.STRING {
			out = slices.Append[@token.Token](out, noComma[i])
			continue
		}
		// Merge the maximal run of STRING tokens: strip each literal's quotes,
		// concatenate the bodies, and re-quote (the value of `"a" "b"` is `"ab"`).
		var merged @strings.Builder = strings.NewBuilder()
		merged.WriteByte('"')
		var j int = i
		for j < len(noComma) && noComma[j].Typ == token.STRING {
			var lit @[]readonly char = noComma[j].Lit
			merged.Write(lit[1:len(lit) - 1])
			j++
		}
		merged.WriteByte('"')
		var tok token.Token
		tok.Typ = token.STRING
		tok.Lit = buf.CopyStr(merged.String())
		out = slices.Append[@token.Token](out, box(tok))
		i = j - 1
	}
	return out
}

// assertTokenEq is the safety-net gate: it fails unless input and output lex to
// the same normalized token stream (same types and literal text, in order).
func assertTokenEq(input *[]readonly char, output *[]readonly char) testing.TestResult {
	var a @[]@token.Token = normTokens(input)
	var b @[]@token.Token = normTokens(output)
	if len(a) != len(b) {
		return tokDiff("token count differs", input, output)
	}
	for i := 0; i < len(a); i++ {
		if a[i].Typ != b[i].Typ || !streq(a[i].Lit, b[i].Lit) {
			return tokDiff("token stream differs", input, output)
		}
	}
	return ""
}

// tokDiff builds a failure message showing the input and the printer's output.
func tokDiff(msg *[]readonly char, input *[]readonly char, output *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(msg)
	b.Write(": in=`")
	b.Write(input)
	b.Write("` out=`")
	b.Write(output)
	b.WriteByte('`')
	return buf.CopyStr(b.String())
}

// parseTypeOf parses `var x <src>` and returns the declared type expression --
// the parser has no exported type-only entry, so a var decl is the vehicle.
func parseTypeOf(src *[]readonly char) @ast.TypeExpr {
	var full @strings.Builder = strings.NewBuilder()
	full.Write("package \"t\"\nvar x ")
	full.Write(src)
	full.WriteByte('\n')
	var text @[]readonly char = full.String()
	var p @parser.Parser = parser.New(toBytes(text), "t.bn")
	var f @ast.File = p.ParseFile()
	if len(f.Decls) == 0 { return nil }
	return f.Decls[0].TypeRef
}

// checkType round-trips a type through parse -> FormatType and asserts the
// printer's output is token-equal to the input.
func checkType(src *[]readonly char) testing.TestResult {
	var te @ast.TypeExpr = parseTypeOf(src)
	if te == nil {
		return tokDiff("parse produced no type", src, "")
	}
	var out @[]readonly char = FormatType(te)
	return assertTokenEq(src, out)
}

func TestPrintTypeNamed() testing.TestResult {
	var r testing.TestResult
	r = checkType("int")
	if len(r) > 0 { return r }
	r = checkType("token.Type")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypePointersAndSlices() testing.TestResult {
	var r testing.TestResult
	r = checkType("*int")
	if len(r) > 0 { return r }
	r = checkType("@Foo")
	if len(r) > 0 { return r }
	r = checkType("*[]int")
	if len(r) > 0 { return r }
	r = checkType("@[]char")
	if len(r) > 0 { return r }
	r = checkType("@[]*int")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypeArray() testing.TestResult {
	var r testing.TestResult
	r = checkType("[3]int")
	if len(r) > 0 { return r }
	r = checkType("[N]char")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypeReadonlyAndParen() testing.TestResult {
	var r testing.TestResult
	r = checkType("readonly int")
	if len(r) > 0 { return r }
	r = checkType("*readonly char")
	if len(r) > 0 { return r }
	r = checkType("*([3]int)")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypeFuncValue() testing.TestResult {
	var r testing.TestResult
	r = checkType("*func(int, char) int")
	if len(r) > 0 { return r }
	r = checkType("@func()")
	if len(r) > 0 { return r }
	r = checkType("@func(int) (int, *int)")
	if len(r) > 0 { return r }
	// Variadic function-value type: the `...` marker must survive.
	r = checkType("*func(...int)")
	if len(r) > 0 { return r }
	r = checkType("@func(char, ...int) int")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypeStruct() testing.TestResult {
	var r testing.TestResult
	r = checkType("struct { x int; y char }")
	if len(r) > 0 { return r }
	r = checkType("struct {}")
	if len(r) > 0 { return r }
	return ""
}

func TestPrintTypeInstantiate() testing.TestResult {
	var r testing.TestResult
	r = checkType("Vec[int]")
	if len(r) > 0 { return r }
	r = checkType("Map[int, char]")
	if len(r) > 0 { return r }
	return ""
}
