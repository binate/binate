package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/strings"

// A type prints the comments inside it that no list in it prints where the source
// put them, as an expression does (print_exprgaps.bn): around a qualified name's `.`
// (`p /* c */.T`, `p./* c */ T`), after a pointer's `*` or `@` (`*/* c */ T`) and
// after `readonly`, inside a slice's brackets (`*[/* c */]T`), around an array's
// length (`[/* c */ 3 /* d */]T`), after a slice's or an array's `]` (`[3] /* c */
// T`), inside a parenthesized type, before an instantiation's `[` (`Box /* c
// */[int]`), and around a function value's `func` and before its results (`*/* c */
// func /* d */(int) /* e */ int`).  They are claimed by position, so every rendering
// prints them again, keyed by a token of the type's own (typeGapKey): neither its
// start, by which a list or a builtin whose first element the type is keys its gaps,
// taking from there the comments the type leaves, nor its End, where a composite
// literal's `{`, which keys the comments it takes from the type's start, can stand.
// The syntax tree has no position for a qualified name's `.` or a function value's
// `func`: the comments right after the token before them (token.Comment.After) are
// those before them.  After a name, a `]` or a `)`, where a line break would end the
// type, only block comments on one line can stand (claimInlineGap); after a `*`, an
// `@`, a `readonly`, a `.`, a `[`, a `(`, a `func` or a `...` a line comment can stand
// as well, and the type goes on at a continuation line, two tabs in from the line's --
// as it does after the block comments there when what follows them does not fit on the
// line (writeTypeGap, writeLenGap).
// The syntax tree has no position for a variadic parameter's `...` either: the
// comments right before its type (token.Comment.Before) are those after it, and their
// After is its position (variadicDots).

// typeGapKey returns the key te's gaps are claimed by: an instantiation's `[` (its
// Pos), the start of the type a prefix or parentheses apply to, a qualified name's
// `.` (qualifiedDot), or a function value's `(`.
func typeGapKey(te @ast.TypeExpr) token.Pos {
	if te.Kind == ast.TEXPR_INSTANTIATE { return te.Pos }
	if te.Base != nil { return typeStartPos(te.Base) }
	if te.Kind == ast.TEXPR_NAMED { return qualifiedDot(te) }
	return openAfterType(te)
}

// qualifiedDot returns the position of qualified name te's `.`, which the syntax tree
// does not record, from the first comment inside the name: the token after it when it
// is right after the package's name, else the token before it.  The zero Pos when
// none lies there, as there is none to claim.
func qualifiedDot(te @ast.TypeExpr) token.Pos {
	var none token.Pos
	var cc @commentCursor = activeCursor
	if cc == nil || len(te.Pkg) == 0 || te.Pos.Line == 0 { return none }
	var k int = firstAfter(cc, te.Pos)
	if k >= len(cc.comments) || !posLess(cc.comments[k].Pos, te.End) { return none }
	var c @token.Comment = cc.comments[k]
	if samePos(c.After, te.Pos) { return c.Before }
	return c.After
}

// openAfterType returns the first opener after te's start (openAfter) -- a slice's
// `[` after its `*` or `@`, a function value's `(` -- or the zero Pos when te has no
// position.
func openAfterType(te @ast.TypeExpr) token.Pos {
	var none token.Pos
	if te.Pos.Line == 0 { return none }
	return openAfter(te.Pos)
}

// claimTypeGap returns the comments of te strictly between lo and hi, claimed by
// its key (typeGapKey).
func claimTypeGap(te @ast.TypeExpr, lo token.Pos, hi token.Pos) @[]@token.Comment {
	return claimGap(lo, hi, typeGapKey(te))
}

// claimBaseGap returns the comments of te from lo to the start of the type its
// prefix applies to.
func claimBaseGap(te @ast.TypeExpr, lo token.Pos) @[]@token.Comment {
	return claimTypeGap(te, lo, typeStartPos(te.Base))
}

// splitAfter splits cs, a gap's comments in source order, into those right after
// the token at at (whose After is at) and the rest.
func splitAfter(cs @[]@token.Comment, at token.Pos) (@[]@token.Comment, @[]@token.Comment) {
	var n int = 0
	for n < len(cs) && samePos(cs[n].After, at) { n++ }
	return cs[:n], cs[n:]
}

// writeBreakingGap writes the comments cs of a gap after a token after which a line
// may break, before a token written against them (a `(`, a `]`): each after a space,
// and a line break to a continuation line after one that needs it.
func writeBreakingGap(b @strings.Builder, cs @[]@token.Comment) {
	var cont int = currentLineIndent(b) + 2
	if writeGapComments(b, cs, cont, false) {
		b.WriteByte('\n')
		writeIndent(b, cont)
	}
}

// writeTypeGap writes the comments cs of a gap in type te after a token after which a line
// may break (against the token when glue), and what separates them from what follows: a
// line break to a continuation line, two tabs in from the line's, when one needs it or
// when what follows them does not fit after them up to its first break with tail bytes
// after it (typeHeadFrom: the rest of te, which started at column start of this line, or,
// when start is -1, te itself, written after the gap), and the continuation line starts
// further left; else a space after them, or always when spaced.  The end of the comments
// is a chance for te to break (noteBreakChance).
func writeTypeGap(b @strings.Builder, cs @[]@token.Comment, te @ast.TypeExpr, start int, tail int,
		glue bool, spaced bool) {
	var cont int = currentLineIndent(b) + 2
	// Where what follows the gap starts in te's one-line form.
	var from int = 0
	if start >= 0 {
		from = lineWidth(b) - start + gapCommentsWidth(cs)
		if !glue { from = from + 1 }
	}
	var brk bool = writeGapComments(b, cs, cont, glue)
	if len(cs) > 0 { noteBreakChance(b) }
	if !brk && len(cs) > 0 && !wrapSuppressed && lineWidth(b) + 1 > cont {
		brk = lineWidth(b) + 1 + typeHeadFrom(te, tail, from) - from > MAX_LINE_WIDTH
	}
	if brk {
		b.WriteByte('\n')
		writeIndent(b, cont)
	} else if spaced || len(cs) > 0 {
		b.WriteByte(' ')
	}
}

// printNamedType appends a named type, followed on its line by tail bytes, with the
// comments around a qualified name's `.`: those right after the package's name before
// it, those after it before the type's name.  Its End bounds them, the position past its
// name.
func printNamedType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	if len(te.Pkg) == 0 {
		b.Write(te.Name)
		return
	}
	var before @[]@token.Comment
	var after @[]@token.Comment
	before, after = splitAfter(claimTypeGap(te, te.Pos, te.End), te.Pos)
	var start int = lineWidth(b)
	b.Write(te.Pkg)
	_ = writeInlineComments(b, before)
	b.WriteByte('.')
	writeTypeGap(b, after, te, start, tail, true, false)
	b.Write(te.Name)
}

// printSliceType appends slice type te -- `*[]T` or `@[]T`, at its `*` or `@` --
// followed on its last line by tail bytes, with the comments after its `*` or `@`
// (writeTypeGap), those between its brackets, against the `[` (writeEmptyListGap),
// and those after its `]` (writeAfterClose).
func printSliceType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	var start int = lineWidth(b)
	if te.Kind == ast.TEXPR_SLICE {
		b.WriteByte('*')
	} else {
		b.WriteByte('@')
	}
	var open token.Pos = openAfterType(te)
	writeTypeGap(b, claimTypeGap(te, te.Pos, open), te, start, tail, true, false)
	b.WriteByte('[')
	var close token.Pos = pairedClose(open)
	writeEmptyListGap(b, claimTypeGap(te, open, close))
	b.WriteByte(']')
	writeAfterClose(b, te, close)
	printTypeTail(b, te.Base, tail)
}

// writeAfterClose writes the comments of slice or array type te between its `]` (at
// close) and its element type, each after a space, and a space after them: block
// comments on one line, as a line break after the `]` would end the type
// (claimInlineGap).
func writeAfterClose(b @strings.Builder, te @ast.TypeExpr, close token.Pos) {
	var cs @[]@token.Comment = claimInlineGap(close, typeStartPos(te.Base), typeGapKey(te))
	if writeInlineComments(b, cs) { b.WriteByte(' ') }
}

// printParenType appends parenthesized type te, followed on its last line by tail
// bytes, with the comments after its `(` (writeTypeGap) and those before its `)`,
// which, with those inside the type in it that nothing prints, stay there when each
// is a block comment on one line (claimAfterType).
func printParenType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	var start int = lineWidth(b)
	b.WriteByte('(')
	writeTypeGap(b, claimBaseGap(te, te.Pos), te, start, tail, true, false)
	var cs @[]@token.Comment = claimAfterType(te.Base, pairedClose(te.Pos), typeGapKey(te))
	printTypeTail(b, te.Base, tail + 1 + inlineCommentsWidth(cs))
	_ = writeInlineComments(b, cs)
	b.WriteByte(')')
}

// resultsOpen returns the `(` of function value te's results, whose parameters'
// `)` is at close: the first opener after that when it has two or more, or a
// single result in parentheses that keeps them (keepsResultParens); the zero Pos
// otherwise, or when close is unknown.
func resultsOpen(te @ast.TypeExpr, close token.Pos) token.Pos {
	var none token.Pos
	if len(te.ResultTypes) == 0 || close.Line == 0 { return none }
	var open token.Pos = openAfter(close)
	if len(te.ResultTypes) > 1 || keepsResultParens(open, te.ResultTypes[0]) { return open }
	return none
}

// keepsResultParens reports whether single result t, whose results' `(` may be at
// open, keeps its parentheses: when it has them and a comment lies between the `(`
// and t, which only an opener can keep in place (a line comment there could go
// nowhere else on the line).  The parentheses go otherwise.
func keepsResultParens(open token.Pos, t @ast.TypeExpr) bool {
	var start token.Pos = typeStartPos(t)
	return open.Line > 0 && posLess(open, start) && commentsBetween(open, start)
}

// resultsStart returns where function value te's results begin: at their `(`, at
// open, when they print one, or at the single result's start; the zero Pos when it
// has none.
func resultsStart(te @ast.TypeExpr, open token.Pos) token.Pos {
	if len(te.ResultTypes) == 1 && open.Line == 0 { return typeStartPos(te.ResultTypes[0]) }
	return open
}

// variadicDots returns the position of the `...` before a variadic parameter's type,
// which starts at ts: the After of the comments right before the type, or the zero
// Pos when none lies there, as there is none to claim.
func variadicDots(ts token.Pos) token.Pos {
	var none token.Pos
	var cc @commentCursor = activeCursor
	if cc == nil || ts.Line == 0 { return none }
	var k int = firstBefore(cc, ts)
	if k >= len(cc.comments) || !posLess(cc.comments[k].Pos, ts) { return none }
	return cc.comments[k].After
}

// printDotsType appends a variadic parameter's `...` and its type te, with the
// comments between them, keyed by the type's start: after the `...` a line comment
// can stand, and the type goes on at a continuation line.  tail bytes follow the
// type on its last line.
func printDotsType(b @strings.Builder, te @ast.TypeExpr, tail int) {
	b.Write("...")
	if te == nil { return }
	var ts token.Pos = typeStartPos(te)
	var cs @[]@token.Comment = claimGap(variadicDots(ts), ts, ts)
	writeTypeGap(b, cs, te, -1, tail, false, false)
	printTypeTail(b, te, tail)
}
