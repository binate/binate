package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests of a type breaking after the block comments in it (writeTypeGap).

// A type goes on at a continuation line after the block comments following its `@`, a
// variadic parameter's `...`, its `*` or its `(` when what follows them, up to its first
// break, does not fit after them on the line -- measured from where they end, also once
// they have gone on at a continuation line themselves.  A chain of such prefixes fills
// its lines: the comments of each are a chance to break.
func TestTypeBreaksAfterItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var vvvv @ /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */ Tttttttt\n"
			"\n"
			"var v *func(int, ... /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccccc */ int)\n"
			"\n"
			"var w *func(int, * /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccccccc */ int)\n"
			"\n"
			"var x *func(int, ( /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccc */ Tttt))\n"
			"\n"
			"var ooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo readonly /* ccc"
			"ccccc */ Ttttt\n"
			"\n"
			"var xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx */* c */ */* c */ */"
			"* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c *"
			"/ */* c */ Tttt\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var vvvv @/* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"c */\n"
			"\t\tTttttttt\n"
			"\n"
			"var v *func(int, ...\n"
			"\t\t/* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"c */\n"
			"\t\tint)\n"
			"\n"
			"var w *func(int,\n"
			"\t\t*/* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */\n"
			"\t\t\t\tint)\n"
			"\n"
			"var x *func(int,\n"
			"\t\t(/* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc *"
			"/\n"
			"\t\t\t\tTttt))\n"
			"\n"
			"var ooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo readonly\n"
			"\t\t/* cccccccc */ Ttttt\n"
			"\n"
			"var xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx */* c */ */* c */\n"
			"\t\t*/* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ */* c */ *"
			"\n"
			"\t\t\t\t/* c */ */* c */ Tttt\n"
	return checkFormatGolden(src, want)
}

// So does a parameter's, after the comments following its `...`, its `readonly`, a
// slice's `*`, a qualified name's `.`, its `@`, its `*` or a function value's `*`, with
// room for the `)` and what follows it on its line -- with no results, all of that
// follows it (sigTailLen) -- and for the `[` after an instantiation's qualified name.
func TestParamTypeBreaksAfterItsComments() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int, b ... /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccc */ int) {}\n"
			"\n"
			"func g(a int, b readonly /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccccc */ *[]int) {}\n"
			"\n"
			"func h(a int, b * /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccc */ []int) {}\n"
			"\n"
			"func i(a int, b p. /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cccccccccc */ Tttt) {}\n"
			"\n"
			"func j(a int, b @ /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccc */ Tttt) {}\n"
			"\n"
			"func k(a int, b * /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccc */ Tttt) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func l(a int, b p. /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccc */ Box[int]) {}\n"
			"\n"
			"func m(a int, b * /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccccccccc */ func(int)) {}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int,\n"
			"\t\tb ... /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc */"
			"\n"
			"\t\t\t\tint) {}\n"
			"\n"
			"func g(a int,\n"
			"\t\tb readonly /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */\n"
			"\t\t\t\t*[]int) {}\n"
			"\n"
			"func h(a int,\n"
			"\t\tb */* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc *"
			"/\n"
			"\t\t\t\t[]int) {}\n"
			"\n"
			"func i(a int,\n"
			"\t\tb p./* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc "
			"*/\n"
			"\t\t\t\tTttt) {}\n"
			"\n"
			"func j(a int,\n"
			"\t\tb @/* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc *"
			"/\n"
			"\t\t\t\tTttt) {}\n"
			"\n"
			"func k(a int,\n"
			"\t\tb */* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc *"
			"/\n"
			"\t\t\t\tTttt) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func l(a int,\n"
			"\t\tb p./* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			" */\n"
			"\t\t\t\tBox[int]) {}\n"
			"\n"
			"func m(a int,\n"
			"\t\tb */* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			" */\n"
			"\t\t\t\tfunc(int)) {}\n"
	return checkFormatGolden(src, want)
}

// A last parameter that can break after a comment in it -- after its `*`, after its
// `...` or after a qualified name's `.` -- leaves the results room to follow its `)` on
// one line, as a parameter that can break elsewhere does (paramsCloseLeast).
func TestParamTypeWithACommentLeavesRoomForResults() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int, b * /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"ccccc */ Tttt) (int, bool) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func g(a int, b ... /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */ int) (int, bool) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func h(a int, b p. /* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */ Tttt) (int, bool) {\n"
			"\treturn\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int,\n"
			"\t\tb */* ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc */\n"
			"\t\t\t\tTttt) (int, bool) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func g(a int, b ... /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"cc */\n"
			"\t\tint) (int, bool) {\n"
			"\treturn\n"
			"}\n"
			"\n"
			"func h(a int, b p./* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
			"c */\n"
			"\t\tTttt) (int, bool) {\n"
			"\treturn\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A slice type cannot break at the comments between its brackets or after its `]`
// (typeUnbreakable), so a last parameter of one goes on its line whole and its `)` lands
// right after it (paramsCloseLeast): where the results then cannot follow the `)` even on
// a continuation line, the parameters need not leave them room, and stay on the
// signature's line.
func TestSliceParamWithACommentCannotBreakThere() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a T, b *[/* c */]AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA) (Aaaa, Bbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbb) {}\n"
			"\n"
			"func g(a T, b *[]/* c */AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA) (Aaaa, Bbbbbbbbbbbbbbbbbb"
			"bbbbbbbbbbbb) {}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a T, b *[/* c */]AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA) (Aaaa,\n"
			"\t\tBbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) {}\n"
			"\n"
			"func g(a T, b *[] /* c */ AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA) (Aaaa,\n"
			"\t\tBbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) {}\n"
	return checkFormatGolden(src, want)
}
