package "pkg/binate/format"

import "pkg/builtins/testing"

// The comments inside a type stay where the source put them: around a qualified name's `.`,
// after a pointer's or a slice's `*` or `@` and after `readonly`, inside a slice's brackets and
// after its `]`, around an array's length and after its `]`, inside parentheses and before an
// instantiation's `[`.  Before a `.` or a `[` and after a `]` a line break would end the type;
// after a `.` a line comment can stand, and the type goes on at a continuation line.
func TestTypeCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var a p./* a */ T = 1\n"
			"var b p /* b */ .T\n"
			"var c */* c */ T\n"
			"var d @ /* d */ T\n"
			"var e * /* e1 */ [ /* e2 */ ]T\n"
			"var f *[] /* f */ T\n"
			"var g @ /* g1 */ [ /* g2 */ ] /* g3 */ T\n"
			"var i [ /* i */ 3]T\n"
			"var j [N + 1 /* j */]T\n"
			"var k [3] /* k */ T\n"
			"var l readonly /* l */ T\n"
			"var m ( /* m1 */ T /* m2 */)\n"
			"var o Box /* o */ [int]\n"
			"var u *[]p. // u\n"
			"\tT\n"
			"var v @[]p. /* v */ T = nil // w\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var a p./* a */ T = 1\n"
			"\n"
			"var b p /* b */.T\n"
			"\n"
			"var c */* c */ T\n"
			"\n"
			"var d @/* d */ T\n"
			"\n"
			"var e */* e1 */ [/* e2 */]T\n"
			"\n"
			"var f *[] /* f */ T\n"
			"\n"
			"var g @/* g1 */ [/* g2 */] /* g3 */ T\n"
			"\n"
			"var i [/* i */ 3]T\n"
			"\n"
			"var j [N + 1 /* j */]T\n"
			"\n"
			"var k [3] /* k */ T\n"
			"\n"
			"var l readonly /* l */ T\n"
			"\n"
			"var m (/* m1 */ T /* m2 */)\n"
			"\n"
			"var o Box /* o */[int]\n"
			"\n"
			"var u *[]p. // u\n"
			"\t\tT\n"
			"\n"
			"var v @[]p./* v */ T = nil // w\n"
	return checkFormatGolden(src, want)
}

// A function value's comments stay around its `func`, between its parameters and before its
// results, and its parameter list opens at its `(`, which a comment can put on a later line than
// its `*` or `@`.
func TestFuncTypeCommentsStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var a */* a1 */ func /* a2 */ ( /* a3 */ int, /* a4 */ bool) /* a5 */ (int, bool /* a6 */)\n"
			"var b *func(int) /* b */ int\n"
			"var c *func( // c\n"
			"\tint) int\n"
			"var d @func // d\n"
			"\t(int)\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var a */* a1 */ func /* a2 */(/* a3 */ int, /* a4 */ bool) /* a5 */ (int, bool /* a6 */)\n"
			"\n"
			"var b *func(int) /* b */ int\n"
			"\n"
			"var c *func( // c\n"
			"\t\tint) int\n"
			"\n"
			"var d @func // d\n"
			"\t\t(int)\n"
	return checkFormatGolden(src, want)
}

// The comments inside the types of declarations, struct fields, receivers, parameters, results,
// type switch cases, builtin operands, type assertions and composite literals' heads stay there,
// a qualified name's in a generic composite's head included, and print once where the head ends
// right at the `{`.
func TestTypeCommentsInDeclarations() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type A p./* a */ T\n"
			"\n"
			"type B = p./* b */ T\n"
			"\n"
			"type C[K p./* c */ Q] struct {\n"
			"\tx K\n"
			"}\n"
			"\n"
			"type S struct {\n"
			"\taa p./* s1 */ T\n"
			"\tbbbbbb *[] /* s2 */ int // s3\n"
			"}\n"
			"\n"
			"func (r */* d */ T) m(a */* e */ T) */* f */ T {\n"
			"\tswitch v := q.(type) {\n"
			"\tcase p./* g */ T:\n"
			"\t\th(v)\n"
			"\t}\n"
			"\tk := make_slice(*/* h */ p.Box[ /* i */ int], 3)\n"
			"\tm := Vec[p./* j */ T]{}\n"
			"\tn := p./* k */ Box[int]{1}\n"
			"\to := p./* p */ T{1}\n"
			"\tfs := [1]*func /* q */() int{f}\n"
			"\tz := [... /* l */]int{1, 2}\n"
			"\tw := [ // n\n"
			"\t\t...]int{1}\n"
			"\treturn x.(p./* o */ T)\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type A p./* a */ T\n"
			"\n"
			"type B = p./* b */ T\n"
			"\n"
			"type C[K p./* c */ Q] struct {\n"
			"\tx K\n"
			"}\n"
			"\n"
			"type S struct {\n"
			"\taa     p./* s1 */ T\n"
			"\tbbbbbb *[] /* s2 */ int // s3\n"
			"}\n"
			"\n"
			"func (r */* d */ T) m(a */* e */ T) */* f */ T {\n"
			"\tswitch v := q.(type) {\n"
			"\tcase p./* g */ T:\n"
			"\t\th(v)\n"
			"\t}\n"
			"\tk := make_slice(*/* h */ p.Box[/* i */ int], 3)\n"
			"\tm := Vec[p./* j */ T]{}\n"
			"\tn := p./* k */ Box[int]{1}\n"
			"\to := p./* p */ T{1}\n"
			"\tfs := [1]*func /* q */() int{f}\n"
			"\tz := [... /* l */]int{1, 2}\n"
			"\tw := [ // n\n"
			"\t\t\t...]int{1}\n"
			"\treturn x.(p./* o */ T)\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A comment inside a type counts in the width of its line: the signature wraps where the
// comment after the slice's `]` takes it past the cap.
func TestTypeCommentsCountInWidth() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(aaaaaaaaaaaaaaaaaaaaaaaa int, bbbbbbbbbbbbbbbbbbbbbbbbbb *[] /* cccccccccc */ int) (int,"
			" bool) {\n"
			"\treturn 0, false\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(aaaaaaaaaaaaaaaaaaaaaaaa int,\n"
			"\t\tbbbbbbbbbbbbbbbbbbbbbbbbbb *[] /* cccccccccc */ int) (int, bool) {\n"
			"\treturn 0, false\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A function value's parameter list opens at its `(`: with a line break after `func`, the list
// does not wrap as though its opener stood alone on its line.
func TestFuncTypeParamsOpenAtTheirParen() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"var d *func\n"
			"(int) int\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"var d *func(int) int\n"
	return checkFormatGolden(src, want)
}

// A line comment inside a receiver's, a parameter's or a result's type stays there, and the type
// goes on at a continuation line, two tabs in from the line's; the signature's later comments
// stay where they are.
func TestTypeLineCommentsInSignaturesStayInPlace() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func (r *// a\n"
			"\tT) f1(x /* b */ int) /* c */ {\n"
			"}\n"
			"\n"
			"func f2() *// d\n"
			"\tint {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func f3() (int, *// e\n"
			"\tbool) /* f */ {\n"
			"\treturn 1, nil\n"
			"}\n"
			"\n"
			"func f8(a *// h\n"
			"\t[]int) {\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type T struct {\n"
			"\tx int\n"
			"}\n"
			"\n"
			"func (r * // a\n"
			"\t\tT) f1(x /* b */ int) /* c */ {}\n"
			"\n"
			"func f2() * // d\n"
			"\t\tint {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func f3() (int, * // e\n"
			"\t\tbool) /* f */ {\n"
			"\treturn 1, nil\n"
			"}\n"
			"\n"
			"func f8(a * // h\n"
			"\t\t[]int) {}\n"
	return checkFormatGolden(src, want)
}

// A function value's single result in parentheses keeps them when a comment follows its
// `(`, as a signature's does -- in a variable's type, a signature's result and parameter,
// an array length and a result list.  So no comment after it is left for after the
// statement or the signature, nor is one after it in an array length lost.
func TestFuncValueSingleResultKeepsItsParensForACommentAfterThem() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tvar y *func() ( // c\n"
			"\t\tint) /* d */ = nil\n"
			"\tvar z *func() (/* c */ int) = nil\n"
			"\tvar w *func() (int) = nil\n"
			"}\n"
			"\n"
			"func h() *func() ( // c\n"
			"\tint) {\n"
			"}\n"
			"\n"
			"func k(a *func() ( // c\n"
			"\tint)) {\n"
			"}\n"
			"\n"
			"func m() [sizeof(*func() ( // c\n"
			"\tint)) + /* d */ 1]T {\n"
			"}\n"
			"\n"
			"func n() (int, *func() ( // c\n"
			"\tint) /* d */) /* e */ {\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func g() {\n"
			"\tvar y *func() ( // c\n"
			"\t\t\tint) /* d */ = nil\n"
			"\tvar z *func() (/* c */ int) = nil\n"
			"\tvar w *func() int = nil\n"
			"}\n"
			"\n"
			"func h() *func() ( // c\n"
			"\t\tint) {}\n"
			"\n"
			"func k(a *func() ( // c\n"
			"\t\tint)) {}\n"
			"\n"
			"func m() [sizeof(*func() ( // c\n"
			"\t\tint)) + /* d */ 1]T {}\n"
			"\n"
			"func n() (int, *func() ( // c\n"
			"\t\tint) /* d */) /* e */ {}\n"
	return checkFormatGolden(src, want)
}
