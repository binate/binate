package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// A type that breaks takes the line it starts on up to its first chance to break: after
// the opener of its first list that is not empty (a type-argument list, a function
// type's parameters or results), after an array's `[` and the comments after it
// (print_arraytype.bn), after a struct's `{`, or after the block comments in a gap it can
// break at (writeTypeGap) -- or up to the end of a line comment in it.  What precedes a
// type on its line, or the gap before the rest of a type, can leave room for that much
// (typeHead, typeHeadFrom).  A type's one-line form is rendered with wrapping suppressed
// and structs on one line, and its first chance is noted as it is written there
// (noteBreakChance): a measure that rendered the type where it goes would render a type
// nesting d arrays, each measured at the two places it can go, 2^d times.

// chanceOf is the builder whose first chance to break is being noted (flatType), nil when
// there is none.
var chanceOf @strings.Builder

// chanceFrom is the offset in chanceOf from which a chance counts: one before it lies in
// the part of the type before the gap being measured from (typeHeadFrom).
var chanceFrom int = 0

// chanceAt is the offset in chanceOf of its first chance to break from chanceFrom, -1
// until one is noted.  An offset, not a column: a chance after a line comment is on a
// later line.
var chanceAt int = -1

// noteBreakChance notes b's current offset as its first chance to break, when b is the
// builder flatType renders into, the offset is past chanceFrom and no chance has been
// noted.
func noteBreakChance(b @strings.Builder) {
	if chanceAt < 0 && chanceOf != nil && same(b, chanceOf) && b.Len() >= chanceFrom {
		chanceAt = b.Len()
	}
}

// flatType returns te's one-line form, rendered with wrapping suppressed and structs on
// one line (it spans lines when a comment in it needs a line break), and the offset of
// its first chance to break there from offset from, -1 when it has none.
func flatType(te @ast.TypeExpr, from int) (@[]readonly char, int) {
	var savedOf @strings.Builder = chanceOf
	var savedFrom int = chanceFrom
	var savedAt int = chanceAt
	var saved bool = wrapSuppressed
	var savedOne bool = structsOneLine
	var sb @strings.Builder = strings.NewBuilder()
	chanceOf = sb
	chanceFrom = from
	chanceAt = -1
	wrapSuppressed = true
	structsOneLine = true
	printTypeTail(sb, te, 0)
	var at int = chanceAt
	chanceOf = savedOf
	chanceFrom = savedFrom
	chanceAt = savedAt
	wrapSuppressed = saved
	structsOneLine = savedOne
	return sb.String(), at
}

// headOf returns the width a type whose one-line form is text, with its first chance to
// break at offset at (flatType), takes on the line it starts on: up to that chance, or to
// the end of the first line when that comes first, or, when it can break nowhere, all of
// it with tail bytes after it.
func headOf(text *[]readonly char, at int, tail int) int {
	var first int = firstLineLen(text)
	if at >= 0 && at <= first { return at }
	if first < len(text) { return first }
	return len(text) + tail
}

// typeHead returns the width te takes on the line it starts on (headOf), with tail bytes
// after it when it can break nowhere.
func typeHead(te @ast.TypeExpr, tail int) int {
	return typeHeadFrom(te, tail, 0)
}

// typeHeadFrom is typeHead for the rest of te from offset from of its one-line form, the
// end of a gap it can break at: the width of te from its start to where the rest breaks
// at its first chance.
func typeHeadFrom(te @ast.TypeExpr, tail int, from int) int {
	var text @[]readonly char
	var at int
	text, at = flatType(te, from)
	return headOf(text, at, tail)
}
