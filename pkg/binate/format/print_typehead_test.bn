package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests of a type's width up to its first chance to break (print_typehead.bn).

// checkTypeHead reports whether type src takes want bytes on the line it starts on with
// tail bytes after it (typeHead).
func checkTypeHead(src *[]readonly char, tail int, want int) testing.TestResult {
	var te @ast.TypeExpr = parseTypeOf(src)
	if te == nil { return tokDiff("parse produced no type", src, "") }
	var got int = typeHead(te, tail)
	if got == want { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("typeHead(")
	sb.Write(src)
	sb.Write(") = ")
	sb.Write(strconv.Itoa(got))
	sb.Write(", want ")
	sb.Write(strconv.Itoa(want))
	return buf.CopyStr(sb.String())
}

// A type that can break takes its line up to the opener of its first list that is not
// empty, an array's `[` or a struct's `{`; one that cannot, all of it and the tail.
func TestTypeHeadStopsAtTheFirstBreak() testing.TestResult {
	var r testing.TestResult = checkTypeHead("p.Tttt", 5, 11)
	if len(r) == 0 { r = checkTypeHead("*readonly Tttt", 2, 16) }
	if len(r) == 0 { r = checkTypeHead("Box[Aaaa, Bbbb]", 5, 4) }
	if len(r) == 0 { r = checkTypeHead("*[]Box[Aaaa]", 5, 7) }
	if len(r) == 0 { r = checkTypeHead("*func(Aaaa) Bbbb", 5, 6) }
	if len(r) == 0 { r = checkTypeHead("@func() (Aaaa, Bbbb)", 5, 9) }
	if len(r) == 0 { r = checkTypeHead("@func() Bbbb", 5, 17) }
	if len(r) == 0 { r = checkTypeHead("[3]Tttt", 5, 1) }
	if len(r) == 0 { r = checkTypeHead("struct { a int }", 5, 8) }
	if len(r) == 0 { r = checkTypeHead("struct {}", 5, 14) }
	return r
}
