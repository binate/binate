package "pkg/binate/format"

import "pkg/builtins/testing"

// Tests of a type or parameter in a list (a signature's parameters, a function value's,
// type arguments) laid out where it goes: one that does not fit on its line wraps a list
// in it to fit there, leaving room for what follows it.

// A parameter, or a function value's parameter type, that fits on neither the line it
// starts on nor a continuation line wraps a list in it: where it starts when its first line
// is no shorter there (as an expression in a list does), else on a continuation line.  One
// that cannot break goes to a continuation line, as it does not fit with what follows it.
// One whose list a first format wrapped is measured as one that it did not, so a second
// format lays it out alike.
func TestTypeItemWrapsWhereItGoes() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn Box[Aa"
			"aa, p.Bbbb], yyyyyyyyyyyy int) (int, bool) {}\n"
			"\n"
			"func g(nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn p.Map[Kkkkkkkkkkkk, "
			"*func(int, Vvvvvvvvvv) bool], yyyyyyyyyyyy int) (int, bool) {}\n"
			"\n"
			"func (r *R) m(nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn p.Bbbbbbbbbbbbbbbbbb"
			"bb) Box[Int, Bool] {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tif x {\n"
			"\t\ty := cast(*func(int, *func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, Bbbbbbbb], "
			"*func(Cccccccc, Dddddd) int) Eeeee), z)\n"
			"\t\t_ = y\n"
			"\t}\n"
			"}\n"
			"\n"
			"func k(a int, "
			"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn ...*func(Box[Aaaaaaaa, "
			"Bbbbbbbb], *func(Cccccccc, Dddddd) int) Eeeee) {}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn Box[Aa"
			"aa,\n"
			"\t\tp.Bbbb], yyyyyyyyyyyy int) (int, bool) {}\n"
			"\n"
			"func g(nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn p.Map[Kkkkkkkkkkkk,\n"
			"\t\t*func(int, Vvvvvvvvvv) bool], yyyyyyyyyyyy int) (int, bool) {}\n"
			"\n"
			"func (r *R) m(\n"
			"\t\tnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn p.Bbbbbbbbbbbbbbbbbbbb) Box[In"
			"t,\n"
			"\t\t\t\tBool] {\n"
			"\treturn nil\n"
			"}\n"
			"\n"
			"func h() {\n"
			"\tif x {\n"
			"\t\ty := cast(*func(int, *func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, Bbbbbbbb],\n"
			"\t\t\t\t*func(Cccccccc, Dddddd) int) Eeeee), z)\n"
			"\t\t_ = y\n"
			"\t}\n"
			"}\n"
			"\n"
			"func k(a int, nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn ...*func(\n"
			"\t\tBox[Aaaaaaaa, Bbbbbbbb], *func(Cccccccc, Dddddd) int) Eeeee) {}\n"
	return checkFormatGolden(src, want)
}

// A type after a line comment, past a variadic parameter's `...` or a `readonly`, leaves
// room for what follows it on its last line: the parameter list's `)` and the body.
func TestTypeItemLeavesRoomForWhatFollows() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(x ... // d\n"
			"\t*func(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) int) {}\n"
			"\n"
			"func g(x readonly // d\n"
			"\t*func(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) int) {}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(x ... // d\n"
			"\t\t*func(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) int) {}\n"
			"\n"
			"func g(x readonly // d\n"
			"\t\t*func(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,\n"
			"\t\t\t\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) int) {}\n"
	return checkFormatGolden(src, want)
}

// Results too wide to follow the parameters' `)` on any line wrap wherever it lands, so the
// parameters leave room only for the `(` they start with; and the results of a function type
// or a signature that wrap leave the same room on a second format, which reads them wrapped.
func TestResultsTooWideToFollowTheClose() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int, b int) (Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, "
			"Bbbbbbbbbbbbbbbbbbbb], int) {}\n"
			"\n"
			"func g(a int, p *func(Cccccccc, "
			"Dddddd) int) (Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, "
			"Bbbbbbbbbbbbbbbbbbbb], int) {}\n"
			"\n"
			"type F = *func(*func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, Bbbbbbbb], "
			"*func(Cccccccc, "
			"Dddddd) int) Eeeee) *func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, "
			"Bbbbbbbb], *func(Cccccccc, Dddddd) int) Eeeee\n"
			"\n"
			"func e(a int, p *func(Cccccccc, "
			"Dddddd) int) *func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, "
			"Bbbbbbbb], *func(Cccccccc, Dddddd) int) Eeeee {\n"
			"\treturn nil\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f(a int, b int) (\n"
			"\t\tBox[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, Bbbbbbbbbbbbbbbbbbbb], "
			"int) {}\n"
			"\n"
			"func g(a int, p *func(Cccccccc, Dddddd) int) (\n"
			"\t\tBox[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, Bbbbbbbbbbbbbbbbbbbb], "
			"int) {}\n"
			"\n"
			"type F = *func(*func(Box[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, Bbbbbbbb],\n"
			"\t\t*func(Cccccccc, Dddddd) int) Eeeee) *func(\n"
			"\t\t\t\tBox[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaaaa, Bbbbbbbb],\n"
			"\t\t\t\t*func(Cccccccc, Dddddd) int) Eeeee\n"
			"\n"
			"func e(a int, p *func(Cccccccc, Dddddd) int) *func(\n"
			"\t\tBox[AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA, Bbbbbbbb],\n"
			"\t\t*func(Cccccccc, Dddddd) int) Eeeee {\n"
			"\treturn nil\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// The parameters' `)` lands no further left than past a last parameter that cannot
// break, so results that cannot follow it there wrap, leaving the parameters on their
// line; and results that span lines with wrapping suppressed (a line comment in them)
// leave room for their first line as the source wraps them.
func TestResultsRoomPastTheLastParameter() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func h(a int, nnnnnnnnnnnnnnnn int) *func(*func(Aaaaaaaa, Bbbbbbbbbbbb) Cccc) *func(Dddddddd, "
			"Eeeeeeeeee) Ffff {}\n"
			"\n"
			"func g() {\n"
			"\tx := f(a, func(a int, nnnnnnnnnnnnnnnn int) *func(*func(Aaaaaaaa, "
			"Bbbbbbbbbbbb) Cccc) *func(Dddddddd, Eeeeeeeeee) Ffff { return })\n"
			"}\n"
			"\n"
			"func f(a int) (NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"
			", *func(Aaaaaaaa, // c\n"
			"\tBbbbbbbbbbb) int) {\n"
			"\treturn nil, 0\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func h(a int, nnnnnnnnnnnnnnnn int) *func(\n"
			"\t\t*func(Aaaaaaaa, Bbbbbbbbbbbb) Cccc) *func(Dddddddd, Eeeeeeeeee) Ffff {}\n"
			"\n"
			"func g() {\n"
			"\tx := f(a, func(a int, nnnnnnnnnnnnnnnn int) *func(\n"
			"\t\t\t*func(Aaaaaaaa, Bbbbbbbbbbbb) Cccc) *func(Dddddddd, Eeeeeeeeee) Ffff { return })\n"
			"}\n"
			"\n"
			"func f(a int) (NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"
			",\n"
			"\t\t*func(Aaaaaaaa, // c\n"
			"\t\t\t\tBbbbbbbbbbb) int) {\n"
			"\treturn nil, 0\n"
			"}\n"
	return checkFormatGolden(src, want)
}

// A struct in a function type's results is measured by its one-line form in a second
// format too, though the first expanded it for the comment in it, which only its
// printing places over lines: both leave it the same room.
func TestFuncTypeStructResultMeasuredAlikeTwice() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tc *func(struct { a Eeeeeeeeeeee; b Vec[int] }, Vec[A, Dd]) (@func(int, ...p.Cccccc) A, "
			"struct { a Dd; b /* c8 */ Bbbb })\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tc *func(struct { a Eeeeeeeeeeee; b Vec[int] },\n"
			"\t\t\tVec[A, Dd]) (@func(int, ...p.Cccccc) A, struct {\n"
			"\t\t\t\ta          Dd\n"
			"\t\t\t\tb /* c8 */ Bbbb\n"
			"\t\t\t})\n"
			"}\n"
	return checkFormatGolden(src, want)
}
