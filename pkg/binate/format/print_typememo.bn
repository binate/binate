package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/hashmap"
import "pkg/std/strings"

// A type or parameter in a list is measured by its renderings (print_lineshare.bn: its
// one-line form, and, when that fits nowhere, its renderings at the two places it can
// go), and a function type's parameters leave room for its results, measured by theirs
// (sigSuffixLen).  Each of those renders the lists inside it, whose types are measured
// the same way, so a type of d nested function types or type-argument lists rendered
// afresh each time would be rendered k^d times, k the renderings a level makes.  So, as
// an expression's are (print_rendermemo.bn), these renderings are kept per node and
// place for the formatting of one file, under the key an expression's has (renderKey:
// the column, the indent, what follows, whether wrapping is suppressed, loneStays, the
// depth in nested lists and the comment cursor), with a kind of their own
// (TYPE_RENDER_ITEM and the others below) and the node's position.  Only a node with no
// comment inside it is kept: a rendering claims the comments it prints in its cursor,
// and a trial whose claims are undone (markCursors) would leave a later reading of the
// kept text with those comments unclaimed.  Nor is a node whose end is not known
// (knownEnd), as the comments inside it are not.

// The kinds of a kept type rendering: a type item, one written after `...`, a parameter,
// and a function type's results.
const (
	TYPE_RENDER_ITEM int = -2
	TYPE_RENDER_DOTS int = -3
	TYPE_RENDER_PARAM int = -4
	TYPE_RENDER_RESULTS int = -5
)

// typeRenderEntry is a kept type rendering: the node it is of (a type -- the first of
// a function type's results for those -- or a parameter) and its text.
type typeRenderEntry struct {
	te    @ast.TypeExpr
	param @ast.ParamDecl
	text  @[]readonly char
}

// typeRenders holds the type renderings of the file being formatted; nil outside a
// formatting.
var typeRenders @hashmap.Map[renderKey, @typeRenderEntry]

// typeRenderCount counts the type renderings made afresh, not from typeRenders.
var typeRenderCount int

// resetTypeRenders starts typeRenders empty, for a new formatting.
func resetTypeRenders() {
	typeRenders = hashmap.New[renderKey, @typeRenderEntry]()
}

// dropTypeRenders releases typeRenders after a formatting.
func dropTypeRenders() {
	var none @hashmap.Map[renderKey, @typeRenderEntry]
	typeRenders = none
}

// typeRenderKey returns the key of a type rendering of the given kind, of the node at
// pos, from column start of a line indented indent tabs with tail bytes after it.
func typeRenderKey(kind int, pos token.Pos, start int, indent int, tail int) renderKey {
	var key renderKey
	key.kind = kind
	key.line = pos.Line
	key.col = pos.Col
	key.start = start
	key.indent = indent
	key.tail = tail
	key.suppressed = wrapSuppressed
	key.oneLine = structsOneLine
	key.loneStays = loneStays
	key.depth = depthKey()
	if activeCursor != nil { key.cursor = activeCursor.id }
	return key
}

// knownEnd returns te's End, or the zero Pos when it is not known: a type the parser
// converts from an expression (a composite literal's type and its type arguments) has
// an End no further than its Pos, as an expression records no end.
func knownEnd(te @ast.TypeExpr) token.Pos {
	var none token.Pos
	if !posLess(te.Pos, te.End) { return none }
	return te.End
}

// spanHoldsComment reports whether a comment of activeCursor lies between lo and hi;
// true when hi is unknown (the zero Pos), as the span is then not known to hold none.
func spanHoldsComment(lo token.Pos, hi token.Pos) bool {
	var cc @commentCursor = activeCursor
	if cc == nil { return false }
	if hi.Line == 0 { return true }
	var k int = firstAfter(cc, lo)
	return k < len(cc.comments) && posLess(cc.comments[k].Pos, hi)
}

// keptTypeRender returns the kept rendering under key of te or param, when there is
// one.
func keptTypeRender(key renderKey, te @ast.TypeExpr,
		param @ast.ParamDecl) (@[]readonly char, bool) {
	var none @[]readonly char
	if typeRenders == nil { return none, false }
	var got @typeRenderEntry
	var ok bool
	got, ok = typeRenders.Get(key)
	if !ok || !same(got.te, te) || !same(got.param, param) { return none, false }
	return got.text, true
}

// keepTypeRender keeps text, the rendering of te or param, under key.
func keepTypeRender(key renderKey, te @ast.TypeExpr, param @ast.ParamDecl, text @[]readonly char) {
	if typeRenders == nil { return }
	var ent @typeRenderEntry = make(typeRenderEntry)
	ent.te = te
	ent.param = param
	ent.text = text
	typeRenders.Put(key, ent)
}

// afterPrefix returns s, a rendering written after start bytes standing in for what
// precedes it on its line, without them.
func afterPrefix(s *[]readonly char, start int) @[]readonly char {
	var tb @strings.Builder = strings.NewBuilder()
	tb.Write(s[start:])
	return tb.String()
}

// itemNodeAt returns type or parameter item it printed from column start of a line
// indented indent tabs (printItemNode), with tail bytes after it, kept when it holds no
// comment.
func itemNodeAt(it @listItem, start int, indent int, tail int) @[]readonly char {
	var key renderKey
	var keep bool
	if it.param != nil {
		var end token.Pos = it.param.Pos
		if it.param.Type != nil { end = knownEnd(it.param.Type) }
		key = typeRenderKey(TYPE_RENDER_PARAM, it.param.Pos, start, indent, tail)
		keep = !spanHoldsComment(it.param.Pos, end)
	} else {
		var kind int = TYPE_RENDER_ITEM
		if it.dots { kind = TYPE_RENDER_DOTS }
		key = typeRenderKey(kind, it.te.Pos, start, indent, tail)
		keep = !spanHoldsComment(it.pos, knownEnd(it.te))
	}
	if keep {
		var kept @[]readonly char
		var ok bool
		kept, ok = keptTypeRender(key, it.te, it.param)
		if ok { return kept }
	}
	typeRenderCount = typeRenderCount + 1
	var sb @strings.Builder = strings.NewBuilder()
	writeLinePrefix(sb, start, indent)
	printItemNode(sb, it, tail)
	var text @[]readonly char = afterPrefix(sb.String(), start)
	if keep { keepTypeRender(key, it.te, it.param, text) }
	return text
}

// resultsAt returns a function type's results (printResults; open is their `(`)
// printed from column start of a line indented indent tabs, with tail bytes after them,
// kept when they hold no comment.
func resultsAt(results @[]@ast.TypeExpr, open token.Pos, start int, indent int,
		tail int) @[]readonly char {
	var none @ast.ParamDecl
	var first @ast.TypeExpr = results[0]
	var key renderKey = typeRenderKey(TYPE_RENDER_RESULTS, first.Pos, start, indent, tail)
	var lo token.Pos = typeStartPos(first)
	var hi token.Pos = knownEnd(results[len(results) - 1])
	if open.Line > 0 {
		lo = open
		hi = pairedClose(open)
	}
	var keep bool = !spanHoldsComment(lo, hi)
	if keep {
		var kept @[]readonly char
		var ok bool
		kept, ok = keptTypeRender(key, first, none)
		if ok { return kept }
	}
	typeRenderCount = typeRenderCount + 1
	var sb @strings.Builder = strings.NewBuilder()
	writeLinePrefix(sb, start, indent)
	printResults(sb, results, open, tail)
	var text @[]readonly char = afterPrefix(sb.String(), start)
	if keep { keepTypeRender(key, first, none, text) }
	return text
}
