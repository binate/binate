package "pkg/binate/format"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for the type renderings kept (print_typememo.bn).

// nestedResults returns a file whose parameter's type and variable's type nest d
// function types, each the first of the next one's results.
func nestedResults(d int) @[]readonly char {
	var t @strings.Builder = strings.NewBuilder()
	for i := 0; i < d; i++ { t.Write("*func(Bbbbbbbbbbbbbbbb, Cccccccccccc) (") }
	t.Write("Aaaaaaaaaaaa")
	for i := 0; i < d; i++ { t.Write(", Dddddddd)") }
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc f(nnnnnnnnnnnnnnnnnnnn ")
	b.Write(t.String())
	b.Write(", y int) (int, bool) {}\n\nvar v ")
	b.Write(t.String())
	b.WriteByte('\n')
	return b.String()
}

// nestedTypeArgs returns a file whose variable's type nests d instantiations, each the
// first type argument of the next.
func nestedTypeArgs(d int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nvar v ")
	for i := 0; i < d; i++ { b.Write("Boxxxxxxxxxxx[") }
	b.Write("Aaaaaaaaaaaa")
	for i := 0; i < d; i++ { b.Write(", Bbbbbbbbbbbbbbbbb]") }
	b.WriteByte('\n')
	return b.String()
}

// typeRendersOf returns the type renderings made afresh formatting src
// (typeRenderCount).
func typeRendersOf(src *[]readonly char) int {
	var before int = typeRenderCount
	_ = Format(parseCollected(src))
	return typeRenderCount - before
}

// Formatting types that nest function types in their results, or instantiations in
// their type arguments, past the cap makes few type renderings afresh -- about 600 for
// function types 10 deep and 210 for instantiations 16 deep: each level measures the
// one inside it at a few places, and those measures, kept, are read again each time the
// level is printed or measured.  Rendered afresh, the counts grow by a factor of
// several per level.
func TestFormatDeepTypesRenders() testing.TestResult {
	var resultsBound int = 900
	var argsBound int = 320
	var results int = typeRendersOf(nestedResults(10))
	var args int = typeRendersOf(nestedTypeArgs(16))
	if results <= resultsBound && args <= argsBound { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("type renderings: function types 10 deep ")
	sb.Write(strconv.Itoa(results))
	sb.Write(" (bound ")
	sb.Write(strconv.Itoa(resultsBound))
	sb.Write("), instantiations 16 deep ")
	sb.Write(strconv.Itoa(args))
	sb.Write(" (bound ")
	sb.Write(strconv.Itoa(argsBound))
	sb.WriteByte(')')
	return buf.CopyStr(sb.String())
}

// The deep types format the same a second time.
func TestFormatDeepTypesFixpoint() testing.TestResult {
	var r testing.TestResult = checkFixpoint(nestedResults(10))
	if len(r) > 0 { return r }
	return checkFixpoint(nestedTypeArgs(16))
}

// A type holding a comment is not kept: a marked line of struct fields is measured
// (markedFieldsLine) with the claims of the comments it prints undone after, and then
// printed; read from a kept rendering, the field's type would print its comment with
// none claimed, and the comment would print again after the type.
func TestTypeRenderKeepsNoCommentedType() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"type S struct {\n"
			"\tf *func(Box[/* c */ Aaaa], int); g int // LONG-LINE ALLOWED\n"
			"\th int\n"
			"}\n"
	return checkFormatGolden(src, src)
}

// Nor is a type whose end is not known: a composite literal's type, converted from
// expressions, ends no further than its start, so the comment in its type argument lies
// past that end.  Each marked line's statements are printed on trial with wrapping
// suppressed, and as they cannot stay joined (a function literal's body must expand),
// the trial's claims are undone and the last statement is printed on trial again; read
// from a rendering kept from the first trial, its type would print the comment with
// none claimed, and the comment would print again before the `]`.
func TestTypeRenderKeepsNoConvertedType() testing.TestResult {
	var src *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() { a(); /* k */ b() }); x := Foo[A, Vec[/* c */ B]]{} // LONG-LINE ALLOWED\n"
			"\tg(func() { a(); /* k */ b() }); y := Foo[A, * /* d */ T]{} // LONG-LINE ALLOWED\n"
			"}\n"
	var want *[]readonly char = "package \"p\"\n"
			"\n"
			"func f() {\n"
			"\tg(func() {\n"
			"\t\ta() /* k */\n"
			"\t\tb()\n"
			"\t})\n"
			"\tx := Foo[A, Vec[/* c */ B]]{} // LONG-LINE ALLOWED\n"
			"\tg(func() {\n"
			"\t\ta() /* k */\n"
			"\t\tb()\n"
			"\t})\n"
			"\ty := Foo[A, */* d */ T]{} // LONG-LINE ALLOWED\n"
			"}\n"
	return checkFormatGolden(src, want)
}
