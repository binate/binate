package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"

// unbreakable reports whether e prints on one line wherever it starts: a name, a
// literal other than a string, an empty composite, a type of names; a selector,
// prefix operator, type assertion, slice or empty call on such operands; a builtin
// whose operands are a type and such values.  It has no list, operator, block or
// string run to break at, so it cannot leave room for what follows it on its last
// line.
func unbreakable(e @ast.Expr) bool {
	if e == nil { return true }
	var k int = e.Kind
	if k == ast.EXPR_IDENT || k == ast.EXPR_INT_LIT || k == ast.EXPR_FLOAT_LIT ||
			k == ast.EXPR_CHAR_LIT || k == ast.EXPR_BOOL_LIT || k == ast.EXPR_NIL_LIT {
		return true
	}
	if k == ast.EXPR_SELECTOR || k == ast.EXPR_UNARY { return unbreakable(e.X) }
	if k == ast.EXPR_CALL { return len(e.Args) == 0 && unbreakable(e.X) }
	if k == ast.EXPR_TYPE_ASSERT { return unbreakable(e.X) && typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_SLICE { return unbreakable(e.X) && unbreakable(e.Z) && unbreakable(e.Y) }
	if k == ast.EXPR_COMPOSITE { return len(e.Elems) == 0 && typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_TYPE { return typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_BUILTIN { return builtinUnbreakable(e) }
	return false
}

// builtinUnbreakable is unbreakable for a builtin: one with a type operand prints
// `name(T, x)` with no list to break, and one without, like a call, only when it has
// no arguments.  `__c_call` fills its arguments as a list.
func builtinUnbreakable(e @ast.Expr) bool {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL { return false }
	if e.TypeRef == nil { return len(e.Args) == 0 }
	if !typeUnbreakable(e.TypeRef) { return false }
	for i := 0; i < len(e.Args); i++ {
		if !unbreakable(e.Args[i]) { return false }
	}
	return true
}

// loneStays, while set, measures a list's lone element that cannot break with only
// its close after it (printArgList, printStrList), so a rendering keeps it on its
// opener's line whatever follows the close.  A right-hand side is measured so to
// decide whether it stays inline (rhsInlineFits).
var loneStays bool = false

// hasLoneUnbreakable reports whether e holds a list that loneStays measures
// differently -- a call's, an index's, a builtin's or a composite's with one element,
// which cannot break (unbreakable) -- outside the bodies of the function literals in
// it, which print outside loneStays (printFuncLit).
func hasLoneUnbreakable(e @ast.Expr) bool {
	if e == nil { return false }
	var k int = e.Kind
	if k == ast.EXPR_FUNC_LIT { return false }
	var argList bool = k == ast.EXPR_CALL || k == ast.EXPR_INSTANTIATE_OR_INDEX ||
			k == ast.EXPR_BUILTIN && e.TypeRef == nil && cast(token.Type, e.Op) != token.C_CALL
	if argList && len(e.Args) == 1 && unbreakable(e.Args[0]) { return true }
	if k == ast.EXPR_COMPOSITE && len(e.Elems) == 1 && unbreakable(e.Elems[0].Value) &&
			(e.Elems[0].Key == nil || unbreakable(e.Elems[0].Key)) {
		return true
	}
	if hasLoneUnbreakable(e.X) || hasLoneUnbreakable(e.Y) || hasLoneUnbreakable(e.Z) {
		return true
	}
	for i := 0; i < len(e.Args); i++ {
		if hasLoneUnbreakable(e.Args[i]) { return true }
	}
	for i := 0; i < len(e.Elems); i++ {
		if hasLoneUnbreakable(e.Elems[i].Key) || hasLoneUnbreakable(e.Elems[i].Value) {
			return true
		}
	}
	return false
}

// itemUnbreakable is unbreakable for a list item: an expression, after a composite
// element's key, that cannot break.
func itemUnbreakable(it @listItem) bool {
	return it.x != nil && unbreakable(it.x) && (it.key == nil || unbreakable(it.key))
}

// typeUnbreakable is unbreakable for a type: a name, or a pointer, slice, read-only
// or parenthesized type of one.
func typeUnbreakable(te @ast.TypeExpr) bool {
	if te == nil { return true }
	var k int = te.Kind
	if k == ast.TEXPR_NAMED || k == ast.TEXPR_SELF { return true }
	if k == ast.TEXPR_POINTER || k == ast.TEXPR_MANAGED || k == ast.TEXPR_SLICE ||
			k == ast.TEXPR_MANAGED_SLICE || k == ast.TEXPR_CONST || k == ast.TEXPR_PAREN {
		return typeUnbreakable(te.Base)
	}
	return false
}
