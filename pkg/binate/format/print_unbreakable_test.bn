package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// unbreakableDecls parses src's var declarations and returns their values.
func unbreakableDecls(src *[]readonly char) @[]@ast.Expr {
	var f @ast.File = parseFileSrc(src)
	var es @[]@ast.Expr = make_slice(@ast.Expr, len(f.Decls))
	for i := 0; i < len(f.Decls); i++ {
		es[i] = f.Decls[i].Value
	}
	return es
}

// What prints on one line wherever it starts is unbreakable: a name, a number, nil,
// an empty composite of a named type, a selector or prefix operator on a name, a
// type assertion to a pointer to a name, a slice with name and number bounds, a
// call with no arguments, a builtin of a type and a name.  What has a list, an
// operator, a string or a block to break at is not.
func TestUnbreakable() testing.TestResult {
	var yes @[]@ast.Expr = unbreakableDecls(
			"package \"p\"\nvar a = x\nvar b = 1\nvar c = nil\nvar d = T{}\nvar e = -x.y\n"
					"var f = v.(*T)\nvar g = s[1:n]\nvar h = f()\nvar i = cast(*[]T, x)\n")
	for i := 0; i < len(yes); i++ {
		if !unbreakable(yes[i]) { return "a value of the first group is unbreakable" }
	}
	var no @[]@ast.Expr = unbreakableDecls(
			"package \"p\"\nvar a = f(x)\nvar b = \"s\"\nvar c = a + b\nvar d = T{1}\n"
					"var e = len(x)\nvar f = func() {}\nvar g = cast(struct{ x int }, y)\n")
	for i := 0; i < len(no); i++ {
		if unbreakable(no[i]) { return "no value of the second group is unbreakable" }
	}
	return ""
}

// hasLoneUnbreakable finds a list of one element that cannot break -- a call's or
// a composite's, at the top or nested -- and not one of two, one whose element can
// break, or one in a function literal's body.
func TestHasLoneUnbreakable() testing.TestResult {
	var yes @[]@ast.Expr = unbreakableDecls(
			"package \"p\"\nvar a = f(x)\nvar b = T{1}\nvar c = g(f(x), y)\nvar d = s[i]\n")
	for i := 0; i < len(yes); i++ {
		if !hasLoneUnbreakable(yes[i]) { return "a value of the first group holds one" }
	}
	var no @[]@ast.Expr = unbreakableDecls(
			"package \"p\"\nvar a = f(x, y)\nvar b = f(a + b)\nvar c = func() { f(x) }\n"
					"var d = x\n")
	for i := 0; i < len(no); i++ {
		if hasLoneUnbreakable(no[i]) { return "no value of the second group holds one" }
	}
	return ""
}
