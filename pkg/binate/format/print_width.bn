package "pkg/binate/format"

import "pkg/std/strings"

// MAX_LINE_WIDTH is the hard column cap (scripts/hygiene/line-length.sh).  A
// construct the formatter would otherwise keep on one line is expanded to
// multiple lines when a single-line rendering would exceed this width.  Width is
// counted in bytes with tabs as one byte each, matching the hygiene check
// (`awk length`); there is no tab-stop expansion.
const MAX_LINE_WIDTH int = 100

// lineWidth returns the byte length of the builder's current (last) line -- the
// column at which the next byte would be written.  This is the width metric the
// line-length hygiene check applies (bytes; a tab counts as one).
func lineWidth(b @strings.Builder) int {
	var s @[]readonly char = b.String()
	var n int = len(s)
	var start int = 0
	for i := n - 1; i >= 0; i-- {
		if s[i] == '\n' {
			start = i + 1
			break
		}
	}
	return n - start
}

// hasNewline reports whether s contains a line break -- used to detect that a
// trial single-line rendering was forced multi-line by a nested construct (a
// long inner block, a mid-list wrap), in which case the enclosing construct
// cannot be kept on one line.
func hasNewline(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			return true
		}
	}
	return false
}
