package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// fmtFunc formats a whole top-level function (signature + body) via FormatDecl.
func fmtFunc(src *[]readonly char) @[]readonly char {
	var d @ast.Decl = parseFuncSrc(src)
	if d == nil { return "" }
	return FormatDecl(d)
}

// longestLine returns the byte length of the longest line in s (the metric
// scripts/hygiene/line-length.sh caps at 100).
func longestLine(s *[]readonly char) int {
	var maxLen int = 0
	var cur int = 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			if cur > maxLen { maxLen = cur }
			cur = 0
		} else {
			cur = cur + 1
		}
	}
	if cur > maxLen { maxLen = cur }
	return maxLen
}

// checkLayout formats src (a func) and asserts token-equality, that the output
// contains wantSub, and that formatting is idempotent.
func checkLayout(src *[]readonly char, wantSub *[]readonly char) testing.TestResult {
	var out @[]readonly char = fmtFunc(src)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if !containsSub(out, wantSub) {
		return tokDiff("layout: missing expected substring", out, wantSub)
	}
	var out2 @[]readonly char = fmtFunc(out)
	if !streq(out, out2) {
		return tokDiff("layout: not idempotent", out, out2)
	}
	return ""
}

// A block the source kept on one line stays single-line.
func TestLayoutSingleLineIfPreserved() testing.TestResult {
	return checkLayout("func f() { if x { return 1 } }", "if x { return 1 }")
}

// A func body written on one line stays on one line.
func TestLayoutSingleLineFuncBody() testing.TestResult {
	return checkLayout("func f() int { return 1 }", "func f() int { return 1 }")
}

// A multi-statement single-line block keeps its `; `-joined form.
func TestLayoutMultiStmtSingleLine() testing.TestResult {
	return checkLayout("func f() { x := 1; y := 2; return x + y }", "{ x := 1; y := 2; return x + y }")
}

// `else` (and `else if`) branches stay inline when the source did.
func TestLayoutSingleLineElse() testing.TestResult {
	return checkLayout("func f() { if x { a() } else { b() } }", "if x { a() } else { b() }")
}

// Nested single-line blocks are preserved.
func TestLayoutNestedSingleLine() testing.TestResult {
	return checkLayout("func f() { if x { if y { g() } } }", "if x { if y { g() } }")
}

// A block the source wrote across multiple lines is NOT collapsed.
func TestLayoutMultiLineIfPreserved() testing.TestResult {
	var src *[]readonly char = "func f() {\n"
			"\tif x {\n"
			"\t\treturn 1\n"
			"\t}\n"
			"}"
	return checkLayout(src, "if x {\n")
}

// A single-line block whose rendering would exceed 100 columns is force-expanded,
// and every resulting line stays within the cap.
func TestLayoutWidthCapExpands() testing.TestResult {
	var src *[]readonly char = "func f() { return aaaaaaaaaa + bbbbbbbbbb + cccccccccc + "
			"dddddddddd + eeeeeeeeee + ffffffffff + gggggggggg }"
	var out @[]readonly char = fmtFunc(src)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	// The single-line rendering exceeds 100, so the body must have expanded.
	if !containsSub(out, "func f() {\n") {
		return tokDiff("width cap: body not expanded", out, "func f() {\\n")
	}
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("width cap: a line still exceeds 100", out, "")
	}
	var out2 @[]readonly char = fmtFunc(out)
	if !streq(out, out2) {
		return tokDiff("width cap: not idempotent", out, out2)
	}
	return ""
}

// A short single-line block just under the cap stays on one line (boundary of
// the width check).
func TestLayoutWidthCapBoundary() testing.TestResult {
	return checkLayout("func f() { return aaaaaaaaaa + bbbbbbbbbb + cccccccccc }",
			"{ return aaaaaaaaaa + bbbbbbbbbb + cccccccccc }")
}
