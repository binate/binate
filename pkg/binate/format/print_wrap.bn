package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// printArgList emits a call/index argument list between the `open` and `close`
// delimiters (the head is already written, so lineWidth(b) is the opener column).
// It wraps when the source wrapped the list or the single-line form would exceed
// MAX_LINE_WIDTH; otherwise it stays on one line.  openerLine is the source line
// of the `open` delimiter, which decides the wrap MODE: if the first element
// started on a later line than the opener, the wrapped form keeps `(` alone on its
// line (elements fill continuation lines); if the first element started on the
// opener line, the wrapped form starts elements on the opener line and fills
// continuations.  Distinguishing the mode by the first element's line makes the
// output stable -- re-parsing a wrapped list reproduces the same mode.  An
// element's line is its first token's (exprStartPos), not its Pos, which for a
// call such as `func() {` … `}()` is the `(` on its last line.  The comments
// after opener (the delimiter, or a builtin's keyword before it) and between the
// elements are the list's (see print_listcomments.bn).
func printArgList(b @strings.Builder, elems @[]@ast.Expr, opener token.Pos, openerLine int,
		spread bool, open char, close char, tail int) {
	b.WriteByte(open)
	if len(elems) == 0 {
		b.WriteByte(close)
		return
	}
	if wrapSuppressed {
		printArgsOneLine(b, elems, opener)
		if spread { b.Write("...") }
		b.WriteByte(close)
		return
	}
	var firstLine int = exprStartPos(elems[0]).Line
	var openerAlone bool = firstLine != openerLine
	var spansLines bool = firstLine != exprStartPos(elems[len(elems) - 1]).Line
	var sourceWrapped bool = openerAlone || spansLines
	var closeLen int = 1
	if spread { closeLen = closeLen + 3 }
	// closeLen + tail is what follows the last element: the spread marker, this
	// list's close, and whatever encloses this list (a nested list's close, a
	// trailing selector).
	var endTail int = closeLen + tail
	// A list the source kept on one line stays there when its one-line form
	// (argsOneLine) fits.  An element that spans lines on its own, or a comment
	// that ends its line, makes that form multi-line, which forces the list to
	// wrap.
	var s @[]readonly char
	if !sourceWrapped { s = argsOneLine(elems, opener, lineWidth(b), currentLineIndent(b), endTail) }
	if !sourceWrapped && !hasNewline(s) && lineWidth(b) + len(s) + endTail <= MAX_LINE_WIDTH {
		b.Write(s)
	} else {
		// The first element shares the opener's line with what follows it there: a
		// comma or the close -- or, for a lone string literal or a lone element that
		// cannot break (unbreakable), everything after the list (endTail), which it
		// cannot reserve itself (a lone element that wraps -- a call, a composite --
		// reserves that tail as it wraps) -- measured as print_lineshare.bn describes.
		// An opener the source put alone stays alone, whatever the first element's
		// width.  A lone element that wraps, with something after the close, is
		// measured with less after it than it prints with (exact).
		var cont int = currentLineIndent(b) + 2
		var alone bool = openerAlone
		if !openerAlone {
			var after int = 1
			if len(elems) == 1 &&
					(elems[0].Kind == ast.EXPR_STRING_LIT || !loneStays && unbreakable(elems[0])) {
				after = endTail
			}
			var start0 token.Pos = exprStartPos(elems[0])
			var here int = lineWidth(b) + openerGapWidth(opener, start0, start0)
			var next @ast.Expr
			if len(elems) > 1 { next = elems[1] }
			alone = !exprFitsAt(elems[0], after, true, len(elems) == 1, len(elems) > 1 || after == endTail,
					next, start0, here, currentLineIndent(b), cont)
		}
		fillExprList(b, elems, cont, alone, endTail, opener, true)
	}
	if spread { b.Write("...") }
	b.WriteByte(close)
}

// unbreakable reports whether e prints on one line wherever it starts: a name, a
// literal other than a string, an empty composite, a type of names; a selector,
// prefix operator, type assertion, slice or empty call on such operands; a builtin
// whose operands are a type and such values.  It has no list, operator, block or
// string run to break at, so it cannot leave room for what follows it on its last
// line.
func unbreakable(e @ast.Expr) bool {
	if e == nil { return true }
	var k int = e.Kind
	if k == ast.EXPR_IDENT || k == ast.EXPR_INT_LIT || k == ast.EXPR_FLOAT_LIT ||
			k == ast.EXPR_CHAR_LIT || k == ast.EXPR_BOOL_LIT || k == ast.EXPR_NIL_LIT {
		return true
	}
	if k == ast.EXPR_SELECTOR || k == ast.EXPR_UNARY { return unbreakable(e.X) }
	if k == ast.EXPR_CALL { return len(e.Args) == 0 && unbreakable(e.X) }
	if k == ast.EXPR_TYPE_ASSERT { return unbreakable(e.X) && typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_SLICE { return unbreakable(e.X) && unbreakable(e.Z) && unbreakable(e.Y) }
	if k == ast.EXPR_COMPOSITE { return len(e.Elems) == 0 && typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_TYPE { return typeUnbreakable(e.TypeRef) }
	if k == ast.EXPR_BUILTIN { return builtinUnbreakable(e) }
	return false
}

// builtinUnbreakable is unbreakable for a builtin: one with a type operand prints
// `name(T, x)` with no list to break, and one without, like a call, only when it has
// no arguments.  `__c_call` fills its arguments as a list.
func builtinUnbreakable(e @ast.Expr) bool {
	var op token.Type = cast(token.Type, e.Op)
	if op == token.C_CALL { return false }
	if e.TypeRef == nil { return len(e.Args) == 0 }
	if !typeUnbreakable(e.TypeRef) { return false }
	for i := 0; i < len(e.Args); i++ {
		if !unbreakable(e.Args[i]) { return false }
	}
	return true
}

// loneStays, while set, measures a list's lone element that cannot break with only
// its close after it (printArgList, printStrList), so a rendering keeps it on its
// opener's line whatever follows the close.  A right-hand side is measured so to
// decide whether it stays inline (rhsInlineFits).
var loneStays bool = false

// hasLoneUnbreakable reports whether e holds a list that loneStays measures
// differently -- a call's, an index's, a builtin's or a composite's with one element,
// which cannot break (unbreakable) -- outside the bodies of the function literals in
// it, which print outside loneStays (printFuncLit).
func hasLoneUnbreakable(e @ast.Expr) bool {
	if e == nil { return false }
	var k int = e.Kind
	if k == ast.EXPR_FUNC_LIT { return false }
	var argList bool = k == ast.EXPR_CALL || k == ast.EXPR_INSTANTIATE_OR_INDEX ||
			k == ast.EXPR_BUILTIN && e.TypeRef == nil && cast(token.Type, e.Op) != token.C_CALL
	if argList && len(e.Args) == 1 && unbreakable(e.Args[0]) { return true }
	if k == ast.EXPR_COMPOSITE && len(e.Elems) == 1 && unbreakable(e.Elems[0].Value) &&
			(e.Elems[0].Key == nil || unbreakable(e.Elems[0].Key)) {
		return true
	}
	if hasLoneUnbreakable(e.X) || hasLoneUnbreakable(e.Y) || hasLoneUnbreakable(e.Z) {
		return true
	}
	for i := 0; i < len(e.Args); i++ {
		if hasLoneUnbreakable(e.Args[i]) { return true }
	}
	for i := 0; i < len(e.Elems); i++ {
		if hasLoneUnbreakable(e.Elems[i].Key) || hasLoneUnbreakable(e.Elems[i].Value) {
			return true
		}
	}
	return false
}

// itemUnbreakable is unbreakable for a list item: an expression, after a composite
// element's key, that cannot break.
func itemUnbreakable(it @listItem) bool {
	return it.x != nil && unbreakable(it.x) && (it.key == nil || unbreakable(it.key))
}

// typeUnbreakable is unbreakable for a type: a name, or a pointer, slice, read-only
// or parenthesized type of one.
func typeUnbreakable(te @ast.TypeExpr) bool {
	if te == nil { return true }
	var k int = te.Kind
	if k == ast.TEXPR_NAMED || k == ast.TEXPR_SELF { return true }
	if k == ast.TEXPR_POINTER || k == ast.TEXPR_MANAGED || k == ast.TEXPR_SLICE ||
			k == ast.TEXPR_MANAGED_SLICE || k == ast.TEXPR_CONST || k == ast.TEXPR_PAREN {
		return typeUnbreakable(te.Base)
	}
	return false
}

// fillExprList emits elems fill-style: elements packed onto lines separated by
// `, `, breaking before an element that would push the line past MAX_LINE_WIDTH,
// with continuation lines at `cont` tabs.  When forceBreakFirst, the first element
// begins on a fresh continuation line (the opener delimiter sits alone above);
// otherwise the first element continues the opener's line.  endTail is what
// follows the LAST element on its line (the spread marker, this list's close, and
// any enclosing suffix); the last element both reserves it for its break decision
// and receives it as its own tail so a nested wrappable element sub-wraps.  A
// non-last element is followed by a comma, so it gets tail 1, and the width of a
// line comment after that comma, which stays on its line.  No trailing comma.
// With gaps, the list prints its comments after the opener (at opener) and
// between the elements, and an element after one that ends its line starts a
// fresh continuation line (see print_listcomments.bn).
func fillExprList(b @strings.Builder, elems @[]@ast.Expr, cont int, forceBreakFirst bool,
		endTail int, opener token.Pos, gaps bool) {
	var none token.Pos
	var key token.Pos
	if gaps { key = exprStartPos(elems[0]) }
	var lo token.Pos = opener
	var prevDeep bool = false
	for i := 0; i < len(elems); i++ {
		var isLast bool = i == len(elems) - 1
		var elemTail int = 1
		if isLast { elemTail = endTail }
		var start token.Pos = none
		if gaps { start = exprStartPos(elems[i]) }
		var cs @[]@token.Comment = claimGap(lo, start, key)
		lo = start
		if i == 0 {
			var brk bool = writeGapComments(b, cs, cont, true)
			if forceBreakFirst || brk {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else if len(cs) > 0 {
				b.WriteByte(' ')
			}
		} else {
			b.WriteByte(',')
			var brk bool = writeGapComments(b, cs, cont, false)
			// After an element whose last line is deeper than `cont` (a string split
			// across lines, a nested list's continuation), start this element on a
			// fresh continuation line at `cont` rather than trailing that line.
			var fresh bool = brk || prevDeep
			if !fresh && lineWidth(b) > cont {
				// A line comment after the element stays on its line: it is reserved.
				var nx @ast.Expr
				if gaps && !isLast { nx = elems[i + 1] }
				fresh = !exprFitsAt(elems[i], elemTail, false, isLast, true, nx, key, lineWidth(b) + 1,
						currentLineIndent(b), cont)
			}
			if fresh {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		var next @ast.Expr
		if gaps && !isLast { next = elems[i + 1] }
		printExprTail(b, elems[i],
				elemTrailTail(elems[i], elemTail, next, key, lineWidth(b), currentLineIndent(b), cont))
		prevDeep = currentLineIndent(b) > cont
	}
}

// firstLineLen is the length of s up to its first newline (all of s when it has
// none): the part of a multi-line rendering that shares the line it starts on.
func firstLineLen(s *[]readonly char) int {
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' { return i }
	}
	return len(s)
}

// exprSingleLine renders an expression on its own (at column 0, nothing after
// it), for a right-hand side's one-line check; the rendering is cached
// (renderAt).
func exprSingleLine(e @ast.Expr) @[]readonly char {
	return renderAt(e, 0, 0, 0)
}

// printCompositeElems emits a composite literal's `{ ... }` element list (the
// type is already written), wrapping fill-style when the source wrapped it or it
// would exceed the width cap.  A keyed element renders `Key: Value`; the element's
// source line is its key's (or value's) first token's line (exprStartPos), and the
// opener `{`'s line is the composite's position.
func printCompositeElems(b @strings.Builder, e @ast.Expr, tail int) {
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	for i := 0; i < len(e.Elems); i++ {
		items.Push(exprItem(e.Elems[i].Key, e.Elems[i].Value))
	}
	printStrList(b, '{', '}', items.Items(), e.Pos.Line, e.Pos, tail)
}

// printTypeListWrapped emits a delimited comma-separated type list between `open`
// and `close`, wrapping fill-style when the source wrapped it or it would exceed
// the cap.  openerLine is the delimiter's source line, and opener its position
// (the zero Pos when unknown); suffixLen reserves room after `close`.  A type's
// line is its first token's (typeStartPos).
func printTypeListWrapped(b @strings.Builder, open char, close char, types @[]@ast.TypeExpr,
		openerLine int, opener token.Pos, suffixLen int) {
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	for i := 0; i < len(types); i++ {
		items.Push(typeItem(types[i], false))
	}
	printStrList(b, open, close, items.Items(), openerLine, opener, suffixLen)
}

// printTypeArgs emits an instantiation's `[T1, T2]` type-argument list (its base
// is already written), wrapping when the source wrapped it or it would exceed the
// cap with tail bytes after it.  The instantiation's Pos is its opener `[`.
func printTypeArgs(b @strings.Builder, te @ast.TypeExpr, tail int) {
	printTypeListWrapped(b, '[', ']', te.TypeArgs, te.Pos.Line, te.Pos, tail)
}

// printFuncParamTypes emits a function-value type's `(T1, T2)` parameter-type
// list (the leading `func` is already written), wrapping when it would exceed the
// cap with suffixLen bytes after it (the results, and what follows them).  A
// variadic function-value type keeps its `...` marker on the last entry.
func printFuncParamTypes(b @strings.Builder, te @ast.TypeExpr, suffixLen int) {
	var items @vec.Vec[@listItem] = vec.New[@listItem]()
	var np int = len(te.ParamTypes)
	for i := 0; i < np; i++ {
		items.Push(typeItem(te.ParamTypes[i], te.VariadicParams && i == np - 1))
	}
	var none token.Pos
	printStrList(b, '(', ')', items.Items(), te.Pos.Line, none, suffixLen)
}

// printStrList emits a bracketed comma-separated list of items between `open`
// and `close`, wrapping fill-style when the source wrapped the list or its
// single-line form would exceed the width cap.  Each item's source line
// (openerLine is the delimiter's line) decides whether to wrap and, when wrapping,
// whether the opener stands alone (mode A) or the first element continues the
// opener line (mode B).  suffixLen reserves room after the closing delimiter (e.g.
// a func signature's ` results {`) so it does not overflow.  Items are measured
// as print_lineshare.bn describes: an expression as it would print where it would
// go, a type or parameter by its text.  The comments after the opener (at opener,
// the zero Pos when unknown) and between the items are the list's (see
// print_listcomments.bn).
func printStrList(b @strings.Builder, open char, close char, items @[]@listItem, openerLine int,
		opener token.Pos, suffixLen int) {
	b.WriteByte(open)
	var n int = len(items)
	if n == 0 {
		b.WriteByte(close)
		return
	}
	if wrapSuppressed {
		printItemsOneLine(b, items, opener, false, 1 + suffixLen)
		b.WriteByte(close)
		return
	}
	var openerAlone bool = items[0].line != openerLine
	var sourceWrapped bool = openerAlone || items[0].line != items[n - 1].line
	// An element that itself spans lines (a nested wrapped value) cannot sit on a
	// single line, so the list must wrap.
	var fits bool = !itemsHaveNewline(items) &&
			lineWidth(b) + itemsOneLineLen(items, opener) + 1 + suffixLen <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		printItemsOneLine(b, items, opener, false, 1 + suffixLen)
	} else {
		// After the first element: a comma, or, for a lone element, the close and
		// suffix -- but under loneStays the close alone for one that cannot break,
		// measured with less after it than it prints with (exact).
		var after int = 1
		if n == 1 && !(loneStays && itemUnbreakable(items[0])) { after = 1 + suffixLen }
		var key token.Pos = listKey(items)
		var cont int = currentLineIndent(b) + 2
		var here int = lineWidth(b) + openerGapWidth(opener, items[0].pos, key)
		var alone bool = openerAlone ||
				!itemFitsAt(items[0], after, true, n == 1, n > 1 || after == 1 + suffixLen,
						itemTrailWidth(items, 0, key), here, currentLineIndent(b), cont)
		fillStrs(b, items, cont, alone, 1 + suffixLen, opener, false)
	}
	b.WriteByte(close)
}

// fillStrs packs items fill-style onto continuation lines at `cont` tabs,
// breaking before an item that does not fit (itemFitsAt) or that follows a string
// printed across lines; the last item reserves `trailingLen` for the closing
// context, and a non-last item reserves one byte for the trailing comma it bears
// when the next item breaks (else a packed item ending at column 100 would push
// that comma to 101), and the width of a line comment after that comma, which
// stays on its line -- both in that decision and when the item is printed in
// place.  forceBreakFirst puts the first item on a fresh line (opener alone).  No
// trailing comma.  The comments after the opener (at opener, the zero Pos when
// unknown) and between the items are printed as fillExprList prints them.  When
// spaced (after `case`), a space separates the opener from what follows it on its
// line.
func fillStrs(b @strings.Builder, items @[]@listItem, cont int, forceBreakFirst bool,
		trailingLen int, opener token.Pos, spaced bool) {
	var key token.Pos = listKey(items)
	var lo token.Pos = opener
	var prevDeep bool = false
	for i := 0; i < len(items); i++ {
		var itemTail int = 1
		if i == len(items) - 1 { itemTail = trailingLen }
		var cs @[]@token.Comment = claimGap(lo, items[i].pos, key)
		lo = items[i].pos
		if i == 0 {
			var brk bool = writeGapComments(b, cs, cont, !spaced)
			if forceBreakFirst || brk {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else if spaced || len(cs) > 0 {
				b.WriteByte(' ')
			}
		} else {
			b.WriteByte(',')
			var brk bool = writeGapComments(b, cs, cont, false)
			// As in fillExprList, an item after one whose last line is deeper than
			// `cont` starts a fresh continuation line at `cont`.
			var fresh bool = brk || prevDeep
			if !fresh && lineWidth(b) > cont {
				fresh = !itemFitsAt(items[i], itemTail, false, i == len(items) - 1, true,
						itemTrailWidth(items, i, key), lineWidth(b) + 1, currentLineIndent(b), cont)
			}
			if fresh {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		printItem(b, items[i], withTrail(itemTail, itemTrailWidth(items, i, key), cont))
		prevDeep = currentLineIndent(b) > cont
	}
}
