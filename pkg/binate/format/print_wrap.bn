package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"

// printArgList emits a call/index argument list between the `open` and `close`
// delimiters (the head is already written, so lineWidth(b) is the opener column).
// It wraps when the source wrapped the list or the single-line form would exceed
// MAX_LINE_WIDTH; otherwise it stays on one line.  openerLine is the source line
// of the head/callee (used to decide the wrap MODE): if the first element was on
// a later line than the opener, the wrapped form keeps `(` alone on its line
// (elements fill continuation lines); if the first element shared the opener line,
// the wrapped form starts elements on the opener line and fills continuations.
// Distinguishing the mode by the first element's line makes the output stable --
// re-parsing a wrapped list reproduces the same mode.
func printArgList(b @strings.Builder, elems @[]@ast.Expr, openerLine int, spread bool,
		open char, close char) {
	b.WriteByte(open)
	if len(elems) == 0 {
		b.WriteByte(close)
		return
	}
	var openerAlone bool = elems[0].Pos.Line != openerLine
	var spansLines bool = elems[0].Pos.Line != elems[len(elems) - 1].Pos.Line
	var sourceWrapped bool = openerAlone || spansLines
	// Single-line trial (rendered at column 0 in a scratch, then offset by the
	// real opener column).  A nested element that itself must wrap makes the
	// scratch multi-line, which also forces this list to wrap.
	var scratch @strings.Builder = strings.NewBuilder()
	printExprList(scratch, elems)
	var s @[]readonly char = scratch.String()
	var closeLen int = 1
	if spread { closeLen = closeLen + 3 }
	var fits bool = !hasNewline(s) && lineWidth(b) + len(s) + closeLen <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		b.Write(s)
	} else {
		fillExprList(b, elems, currentLineIndent(b) + 2, openerAlone, closeLen)
	}
	if spread { b.Write("...") }
	b.WriteByte(close)
}

// fillExprList emits elems fill-style: elements packed onto lines separated by
// `, `, breaking before an element that would push the line past MAX_LINE_WIDTH,
// with continuation lines at `cont` tabs.  When forceBreakFirst, the first element
// begins on a fresh continuation line (the opener delimiter sits alone above);
// otherwise the first element continues the opener's line.  trailingLen reserves
// room on the LAST element's line for what follows the list (the closing
// delimiter, and a `...` spread marker) so that suffix does not overflow the cap.
// No trailing comma.
func fillExprList(b @strings.Builder, elems @[]@ast.Expr, cont int, forceBreakFirst bool,
		trailingLen int) {
	for i := 0; i < len(elems); i++ {
		if i == 0 {
			if forceBreakFirst {
				b.WriteByte('\n')
				writeIndent(b, cont)
			}
		} else {
			b.WriteByte(',')
			var w int = len(exprSingleLine(elems[i]))
			if i == len(elems) - 1 { w = w + trailingLen }
			if lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		printExpr(b, elems[i])
	}
}

// exprSingleLine renders an expression to a string, used to measure its width
// for fill break decisions.
func exprSingleLine(e @ast.Expr) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	printExpr(sb, e)
	return sb.String()
}

// printStrList emits a bracketed comma-separated list of pre-rendered element
// strings between `open` and `close`, wrapping fill-style when the source wrapped
// the list or its single-line form would exceed the width cap.  elemLines is each
// element's source line (openerLine is the delimiter's line) -- used to decide
// whether to wrap and, when wrapping, whether the opener stands alone (mode A) or
// the first element continues the opener line (mode B).  suffixLen reserves room
// after the closing delimiter (e.g. a func signature's ` results {`) so it does
// not overflow.  This string form does not sub-wrap a nested element; callers use
// it for element kinds (params, type args, composite elements) that rarely nest.
func printStrList(b @strings.Builder, open char, close char, elemStrs @[]@[]readonly char,
		elemLines @[]int, openerLine int, suffixLen int) {
	b.WriteByte(open)
	var n int = len(elemStrs)
	if n == 0 {
		b.WriteByte(close)
		return
	}
	var openerAlone bool = elemLines[0] != openerLine
	var sourceWrapped bool = openerAlone || elemLines[0] != elemLines[n - 1]
	var oneLine int = 0
	for i := 0; i < n; i++ {
		oneLine = oneLine + len(elemStrs[i])
		if i > 0 { oneLine = oneLine + 2 }
	}
	var fits bool = lineWidth(b) + oneLine + 1 + suffixLen <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		for i := 0; i < n; i++ {
			if i > 0 { b.Write(", ") }
			b.Write(elemStrs[i])
		}
	} else {
		fillStrs(b, elemStrs, currentLineIndent(b) + 2, openerAlone, 1 + suffixLen)
	}
	b.WriteByte(close)
}

// fillStrs packs pre-rendered element strings fill-style onto continuation lines
// at `cont` tabs, breaking before an element that would exceed the cap; the last
// element reserves `trailingLen` for the closing context.  forceBreakFirst puts
// the first element on a fresh line (opener alone).  No trailing comma.
func fillStrs(b @strings.Builder, elemStrs @[]@[]readonly char, cont int,
		forceBreakFirst bool, trailingLen int) {
	for i := 0; i < len(elemStrs); i++ {
		if i == 0 {
			if forceBreakFirst {
				b.WriteByte('\n')
				writeIndent(b, cont)
			}
		} else {
			b.WriteByte(',')
			var w int = len(elemStrs[i])
			if i == len(elemStrs) - 1 { w = w + trailingLen }
			if lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		b.Write(elemStrs[i])
	}
}
