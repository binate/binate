package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/std/strings"
import "pkg/stdx/containers/vec"

// printArgList emits a call/index argument list between the `open` and `close`
// delimiters (the head is already written, so lineWidth(b) is the opener column).
// It wraps when the source wrapped the list or the single-line form would exceed
// MAX_LINE_WIDTH; otherwise it stays on one line.  openerLine is the source line
// of the head/callee (used to decide the wrap MODE): if the first element was on
// a later line than the opener, the wrapped form keeps `(` alone on its line
// (elements fill continuation lines); if the first element shared the opener line,
// the wrapped form starts elements on the opener line and fills continuations.
// Distinguishing the mode by the first element's line makes the output stable --
// re-parsing a wrapped list reproduces the same mode.
func printArgList(b @strings.Builder, elems @[]@ast.Expr, openerLine int, spread bool, open char,
		close char, tail int) {
	b.WriteByte(open)
	if len(elems) == 0 {
		b.WriteByte(close)
		return
	}
	if wrapSuppressed {
		printExprList(b, elems)
		if spread { b.Write("...") }
		b.WriteByte(close)
		return
	}
	var openerAlone bool = elems[0].Pos.Line != openerLine
	var spansLines bool = elems[0].Pos.Line != elems[len(elems) - 1].Pos.Line
	var sourceWrapped bool = openerAlone || spansLines
	// Single-line trial (rendered at column 0 in a scratch, then offset by the
	// real opener column).  A nested element that itself must wrap makes the
	// scratch multi-line, which also forces this list to wrap.
	var scratch @strings.Builder = strings.NewBuilder()
	printExprList(scratch, elems)
	var s @[]readonly char = scratch.String()
	var closeLen int = 1
	if spread { closeLen = closeLen + 3 }
	// closeLen + tail is what follows the last element: the spread marker, this
	// list's close, and whatever encloses this list (a nested list's close, a
	// trailing selector).
	var endTail int = closeLen + tail
	var fits bool = !hasNewline(s) && lineWidth(b) + len(s) + endTail <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		b.Write(s)
	} else {
		fillExprList(b, elems, currentLineIndent(b) + 2,
				wrapOpenerAlone(b, openerAlone, len(exprSingleLine(elems[0]))), endTail)
	}
	if spread { b.Write("...") }
	b.WriteByte(close)
}

// wrapOpenerAlone decides whether a wrapped list puts its opener delimiter alone
// on its line (mode A).  A source-opener-alone list always does.  A
// width-triggered wrap of a source-single-line list normally keeps the first
// element on the opener line (mode B), but falls back to mode A when the first
// element would not fit there -- otherwise mode B's first line would overflow the
// cap while mode A (element on a fresh +2 continuation line) fits.  Idempotent:
// the mode-A output re-parses as opener-alone, so the second format picks mode A
// directly without re-evaluating this.
func wrapOpenerAlone(b @strings.Builder, openerAlone bool, firstElemLen int) bool {
	if openerAlone { return true }
	// +1 for the minimum that follows the first element on the opener line in
	// mode B: a separating comma (more elements) or the closing delimiter (a lone
	// element).  Without it the first line can overflow by exactly that byte.
	return lineWidth(b) + firstElemLen + 1 > MAX_LINE_WIDTH
}

// fillExprList emits elems fill-style: elements packed onto lines separated by
// `, `, breaking before an element that would push the line past MAX_LINE_WIDTH,
// with continuation lines at `cont` tabs.  When forceBreakFirst, the first element
// begins on a fresh continuation line (the opener delimiter sits alone above);
// otherwise the first element continues the opener's line.  endTail is what
// follows the LAST element on its line (the spread marker, this list's close, and
// any enclosing suffix); the last element both reserves it for its break decision
// and receives it as its own tail so a nested wrappable element sub-wraps.  A
// non-last element is followed by a comma, so it gets tail 1.  No trailing comma.
func fillExprList(b @strings.Builder, elems @[]@ast.Expr, cont int, forceBreakFirst bool,
		endTail int) {
	for i := 0; i < len(elems); i++ {
		var isLast bool = i == len(elems) - 1
		var elemTail int = 1
		if isLast { elemTail = endTail }
		if i == 0 {
			if forceBreakFirst {
				b.WriteByte('\n')
				writeIndent(b, cont)
			}
		} else {
			b.WriteByte(',')
			var w int = len(exprSingleLine(elems[i])) + elemTail
			// A preceding cross-line string left the builder on its deep +2
			// continuation; start this element on a fresh continuation line at
			// `cont` instead of packing onto that continuation.
			if exprIsCrossLineStr(elems[i - 1]) ||
					(lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont) {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		printExprTail(b, elems[i], elemTail)
	}
}

// exprSingleLine renders an expression to a string, used to measure its width
// for fill break decisions.
func exprSingleLine(e @ast.Expr) @[]readonly char {
	var sb @strings.Builder = strings.NewBuilder()
	printExpr(sb, e)
	return sb.String()
}

// printCompositeElems emits a composite literal's `{ ... }` element list (the
// type is already written), wrapping fill-style when the source wrapped it or it
// would exceed the width cap.  A keyed element renders `Key: Value`; the element's
// source line is its key's (or value's) line, and the opener `{`'s line is the
// composite's position.
func printCompositeElems(b @strings.Builder, e @ast.Expr, tail int) {
	var strs @vec.Vec[@[]readonly char] = vec.New[@[]readonly char]()
	var lines @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(e.Elems); i++ {
		var el @ast.Element = e.Elems[i]
		var sb @strings.Builder = strings.NewBuilder()
		if el.Key != nil {
			printExpr(sb, el.Key)
			sb.Write(": ")
		}
		printExpr(sb, el.Value)
		strs.Push(sb.String())
		var ln int = el.Value.Pos.Line
		if el.Key != nil { ln = el.Key.Pos.Line }
		lines.Push(ln)
	}
	printStrList(b, '{', '}', strs.Items(), lines.Items(), e.Pos.Line, tail)
}

// printTypeListWrapped emits a delimited comma-separated type list between `open`
// and `close`, wrapping fill-style when the source wrapped it or it would exceed
// the cap.  openerLine is the delimiter's source line; suffixLen reserves room
// after `close`.
func printTypeListWrapped(b @strings.Builder, open char, close char, types @[]@ast.TypeExpr,
		openerLine int, suffixLen int) {
	var strs @vec.Vec[@[]readonly char] = vec.New[@[]readonly char]()
	var lines @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(types); i++ {
		var sb @strings.Builder = strings.NewBuilder()
		printType(sb, types[i])
		strs.Push(sb.String())
		lines.Push(types[i].Pos.Line)
	}
	printStrList(b, open, close, strs.Items(), lines.Items(), openerLine, suffixLen)
}

// printTypeArgs emits a `[T1, T2]` type-argument list (the base is already
// written), wrapping when the source wrapped it or it would exceed the cap.  The
// opener `[`'s line is the base type's line.
func printTypeArgs(b @strings.Builder, base @ast.TypeExpr, typeArgs @[]@ast.TypeExpr) {
	printTypeListWrapped(b, '[', ']', typeArgs, base.Pos.Line, 0)
}

// printFuncParamTypes emits a function-value type's `(T1, T2)` parameter-type
// list (the leading `func` is already written), wrapping when it would exceed the
// cap.  A variadic function-value type keeps its `...` marker on the last entry.
func printFuncParamTypes(b @strings.Builder, te @ast.TypeExpr) {
	var strs @vec.Vec[@[]readonly char] = vec.New[@[]readonly char]()
	var lines @vec.Vec[int] = vec.New[int]()
	var np int = len(te.ParamTypes)
	for i := 0; i < np; i++ {
		var sb @strings.Builder = strings.NewBuilder()
		if te.VariadicParams && i == np - 1 { sb.Write("...") }
		printType(sb, te.ParamTypes[i])
		strs.Push(sb.String())
		lines.Push(te.ParamTypes[i].Pos.Line)
	}
	printStrList(b, '(', ')', strs.Items(), lines.Items(), te.Pos.Line, 0)
}

// printStrList emits a bracketed comma-separated list of pre-rendered element
// strings between `open` and `close`, wrapping fill-style when the source wrapped
// the list or its single-line form would exceed the width cap.  elemLines is each
// element's source line (openerLine is the delimiter's line) -- used to decide
// whether to wrap and, when wrapping, whether the opener stands alone (mode A) or
// the first element continues the opener line (mode B).  suffixLen reserves room
// after the closing delimiter (e.g. a func signature's ` results {`) so it does
// not overflow.  This string form does not sub-wrap a nested element; callers use
// it for element kinds (params, type args, composite elements) that rarely nest.
func printStrList(b @strings.Builder, open char, close char, elemStrs @[]@[]readonly char,
		elemLines @[]int, openerLine int, suffixLen int) {
	b.WriteByte(open)
	var n int = len(elemStrs)
	if n == 0 {
		b.WriteByte(close)
		return
	}
	if wrapSuppressed {
		for i := 0; i < n; i++ {
			if i > 0 { b.Write(", ") }
			b.Write(elemStrs[i])
		}
		b.WriteByte(close)
		return
	}
	var openerAlone bool = elemLines[0] != openerLine
	var sourceWrapped bool = openerAlone || elemLines[0] != elemLines[n - 1]
	var oneLine int = 0
	var anyMultiLine bool = false
	for i := 0; i < n; i++ {
		oneLine = oneLine + len(elemStrs[i])
		if i > 0 { oneLine = oneLine + 2 }
		if hasNewline(elemStrs[i]) { anyMultiLine = true }
	}
	// A pre-rendered element that itself spans lines (a nested wrapped value)
	// cannot sit on a single line, so the list must wrap.
	var fits bool = !anyMultiLine && lineWidth(b) + oneLine + 1 + suffixLen <= MAX_LINE_WIDTH
	if !sourceWrapped && fits {
		for i := 0; i < n; i++ {
			if i > 0 { b.Write(", ") }
			b.Write(elemStrs[i])
		}
	} else {
		fillStrs(b, elemStrs, currentLineIndent(b) + 2, wrapOpenerAlone(b, openerAlone, len(elemStrs[0])),
				1 + suffixLen)
	}
	b.WriteByte(close)
}

// fillStrs packs pre-rendered element strings fill-style onto continuation lines
// at `cont` tabs, breaking before an element that would exceed the cap; the last
// element reserves `trailingLen` for the closing context, and a non-last element
// reserves one byte for the trailing comma it bears when the next element breaks
// (else a packed element ending at column 100 would push that comma to 101).
// forceBreakFirst puts the first element on a fresh line (opener alone).  No
// trailing comma.
func fillStrs(b @strings.Builder, elemStrs @[]@[]readonly char, cont int, forceBreakFirst bool,
		trailingLen int) {
	for i := 0; i < len(elemStrs); i++ {
		if i == 0 {
			if forceBreakFirst {
				b.WriteByte('\n')
				writeIndent(b, cont)
			}
		} else {
			b.WriteByte(',')
			var w int = len(elemStrs[i])
			if i == len(elemStrs) - 1 { w = w + trailingLen } else { w = w + 1 }
			if lineWidth(b) + 1 + w > MAX_LINE_WIDTH && lineWidth(b) > cont {
				b.WriteByte('\n')
				writeIndent(b, cont)
			} else {
				b.WriteByte(' ')
			}
		}
		b.Write(elemStrs[i])
	}
}
