package "pkg/binate/format"

import "pkg/builtins/testing"
import "pkg/std/strings"

// A lone argument that does not fit on its call's opener line together with what
// follows the list -- `) {` after an `if` condition -- breaks after the opener, rather
// than staying there to be split (a split literal reformats differently: the output
// would not be a fixed point).  (checkWrap is in print_wrap_test.bn, fmtFunc in
// print_width_test.bn, containsSub in print_comments_test.bn.)

// loneLitIfSrc is `func f() bool { if rejects("…") { return false }; return true }`,
// written out, with the literal n bytes long, quotes included, and its first line
// `\tif rejects(LIT) {` 15 + n bytes.
func loneLitIfSrc(n int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("func f() bool {\n\tif rejects(")
	b.Write(loneLit(n))
	b.Write(") {\n\t\treturn false\n\t}\n\treturn true\n}\n")
	return b.String()
}

// loneLit is a string literal n bytes long, quotes included, with a `\n` escape
// after its first 20 characters.
func loneLit(n int) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("\"aaaaaaaaaaaaaaaaaaaa\\n")
	for i := 0; i < n - 24; i++ { b.WriteByte('b') }
	b.WriteByte('"')
	return b.String()
}

// One and two bytes over the cap (88 the first width over it even counting only the
// close), the literal goes whole onto a continuation line, and stays there.
func TestWrapLoneLiteralBreaksAfterOpener() testing.TestResult {
	for n := 86; n <= 88; n++ {
		var src @[]readonly char = loneLitIfSrc(n)
		var r testing.TestResult = checkWrap(src)
		if len(r) != 0 { return r }
		var out @[]readonly char = fmtFunc(src)
		var want @strings.Builder = strings.NewBuilder()
		want.Write("rejects(\n\t\t\t")
		want.Write(loneLit(n))
		want.Write(") {")
		if !containsSub(out, want.String()) {
			return tokDiff("lone literal not on its own line", out, "")
		}
	}
	return ""
}

// A literal that fits beside the opener with `) {` stays there, unsplit.
func TestWrapLoneLiteralFitsStays() testing.TestResult {
	var src @[]readonly char = loneLitIfSrc(87 - 2)
	var r testing.TestResult = checkWrap(src)
	if len(r) != 0 { return r }
	var want @strings.Builder = strings.NewBuilder()
	want.Write("\tif rejects(")
	want.Write(loneLit(85))
	want.Write(") {")
	if !containsSub(fmtFunc(src), want.String()) { return "a fitting literal moved" }
	return ""
}

// A lone argument that wraps itself -- a call -- keeps its first line on the opener
// line, the call reserving what follows the list as it wraps.
func TestWrapLoneCallStaysOnOpenerLine() testing.TestResult {
	var src *[]readonly char = "func f() bool {\n\tif len(EmitElfExec(secs, cast(uint64, 0x400000), "
			"EM_X86_64, buf.Concat(dir, \"/link_exec_multi\"))) != 0 {\n\t\treturn false\n\t}\n"
			"\treturn true\n}\n"
	var r testing.TestResult = checkWrap(src)
	if len(r) != 0 { return r }
	if !containsSub(fmtFunc(src), "\tif len(EmitElfExec(secs,") {
		return "a lone call left the opener line"
	}
	return ""
}

// loneTrailSrc is a file holding `func f() {` / `\tggg…<open><elem><close> // a trailing cc` /
// `}`, the name padded so that the close ends at column 100; with moved, the element
// starts a continuation line after the opener.
func loneTrailSrc(open *[]readonly char, elem *[]readonly char, close *[]readonly char,
		moved bool) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"p\"\n\nfunc f() {\n\t")
	for i := 0; i < 99 - len(open) - len(elem) - len(close); i++ { b.WriteByte('g') }
	b.Write(open)
	if moved { b.Write("\n\t\t\t") }
	b.Write(elem)
	b.Write(close)
	b.Write(" // a trailing cc\n}\n")
	return b.String()
}

// checkLoneTrail checks that the lone elem moves below its opener, where the
// comment after the close fits.
func checkLoneTrail(open *[]readonly char, elem *[]readonly char,
		close *[]readonly char) testing.TestResult {
	return checkFormatGolden(loneTrailSrc(open, elem, close, false),
			loneTrailSrc(open, elem, close, true))
}

// A lone element that cannot break -- a name, a literal, a prefix operator, selector, type
// assertion, slice or empty call on names, an empty composite -- moves below its opener
// when what follows the list does not fit after it there: it cannot leave room for that
// itself, as a call or a composite does as it wraps.  Measured with the close alone after
// it, it would stay, and the comment would run past the cap.
func TestWrapLoneUnbreakableLeavesRoomAfterClose() testing.TestResult {
	var r testing.TestResult = checkLoneTrail("(", "cccccccccccccccccccccccccccccccccccc", ")")
	if len(r) == 0 { r = checkLoneTrail("(", "111111111111111111111111111111111111", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "1.25", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "'x'", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "true", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "nil", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "aaaa.cccccccccccccccccccccccccccccccccccc", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "-cccccccccccccccccccccccccccccccccccc", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "&cccccccccccccccccccccccccccccccccccc", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "!cccccccccccccccccccccccccccccccccccc", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "*cccccccccccccccccccccccccccccccccccc", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "cccccccccccccccccccc.(Tttttttttttt)", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "cccccccccccccccccccc[iiiiii:jjjjjj]", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "cccccccccccccccccccc[iiiiii:]", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "cccccccccccccccccccccccccccccccccccc()", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "Ccccccccccccccccccccccccccccccc{}", ")") }
	return r
}

// So does a type of names, and a builtin whose operands are a type and such values.
func TestWrapLoneUnbreakableTypeOrBuiltin() testing.TestResult {
	var r testing.TestResult = checkLoneTrail("[", "@Cccccccccccccccccccccccccccccccccccc", "]()")
	if len(r) == 0 { r = checkLoneTrail("[", "*Cccccccccccccccccccccccccccccccccccc", "]()") }
	if len(r) == 0 { r = checkLoneTrail("[", "*[]Cccccccccccccccccccccccccccccccccccc", "]()") }
	if len(r) == 0 { r = checkLoneTrail("[", "@[]Cccccccccccccccccccccccccccccccccccc", "]()") }
	if len(r) == 0 { r = checkLoneTrail("[", "readonly Cccccccccccccccccccccccccccc", "]()") }
	if len(r) == 0 { r = checkLoneTrail("(", "sizeof(Cccccccccccccccccccccccccccc)", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "cast(int, cccccccccccccccccccccccccc)", ")") }
	if len(r) == 0 { r = checkLoneTrail("(", "__c_global(\"symbolname\", int)", ")") }
	return r
}

// An index's lone name moves below the `[` for what follows the `]`: an `++` (on the
// opener's line, the statement is 102 wide), and the close and comment of a call
// holding it.
func TestWrapLoneUnbreakableIndex() testing.TestResult {
	var r testing.TestResult = checkFormatGolden(
			"package \"p\"\n\nfunc f() {\n"
					"\tffffffffffffffffffffffffffffffffffffffffffffffff["
					"ccccccccccccccccccccccccccccccccccccccccccccccccc]++\n}\n",
			"package \"p\"\n\nfunc f() {\n"
					"\tffffffffffffffffffffffffffffffffffffffffffffffff[\n"
					"\t\t\tccccccccccccccccccccccccccccccccccccccccccccccccc]++\n}\n")
	if len(r) != 0 { return r }
	return checkFormatGolden(
			"package \"p\"\n\nfunc f() {\n"
					"\tgggg(fffffffffffffffffffffffffffffffffffffffffff["
					"ccccccccccccccccccccccccccccccccccccccccccccccccc]) // a trailing cc\n}\n",
			"package \"p\"\n\nfunc f() {\n"
					"\tgggg(\n"
					"\t\t\tfffffffffffffffffffffffffffffffffffffffffff[\n"
					"\t\t\t\t\tccccccccccccccccccccccccccccccccccccccccccccccccc]) // a trailing cc\n}\n")
}

// A right-hand side that fits inline only by putting a lone name below its opener goes
// whole to a continuation line, where it fits on one line (rhsInlineFits), and stays
// there: read back from there, it fits inline again only so (rhsInlineHolds).
func TestWrapLoneNameRightHandSideMovesWhole() testing.TestResult {
	return checkFormatGolden(
			"package \"p\"\n\nfunc f() {\n"
					"\tx = ffffffffffffffffffffffffffffffffffffffffffff["
					"ccccccccccccccccccccccccccccccccccccccccccccccccc].z\n}\n",
			"package \"p\"\n\nfunc f() {\n"
					"\tx =\n"
					"\t\tffffffffffffffffffffffffffffffffffffffffffff["
					"ccccccccccccccccccccccccccccccccccccccccccccccccc].z\n}\n")
}

// So does one that fits inline only by putting a composite's lone element below its `{`,
// keyed or not.
func TestWrapLoneElementRightHandSideMovesWhole() testing.TestResult {
	var r testing.TestResult = checkFormatGolden(
			"package \"p\"\n\nfunc f() {\n"
					"\tx = TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT{"
					"mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm}.zz\n}\n",
			"package \"p\"\n\nfunc f() {\n"
					"\tx =\n"
					"\t\tTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT{"
					"mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm}.zz\n}\n")
	if len(r) != 0 { return r }
	return checkFormatGolden(
			"package \"p\"\n\nfunc f() {\n"
					"\tx = TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT{kkk: "
					"mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm}.zz\n}\n",
			"package \"p\"\n\nfunc f() {\n"
					"\tx =\n"
					"\t\tTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT{kkk: "
					"mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm}.zz\n}\n")
}

// The statements of a function literal in a right-hand side are laid out as they print:
// the right-hand side keeps the lone elements of its own lists on their lines to decide
// whether it stays inline (rhsInlineFits), not those of the literal's statements.
func TestWrapLoneNameInLiteralOfRightHandSide() testing.TestResult {
	return checkFormatGolden(
			"package \"p\"\n\nfunc a() {\n\tx = g(func() {\n"
					"\t\tqq.f(hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh("
					"cccccccccccccccccccc)) // c\n\t})\n}\n",
			"package \"p\"\n\nfunc a() {\n\tx = g(func() {\n"
					"\t\tqq.f(hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh(\n"
					"\t\t\t\tcccccccccccccccccccc)) // c\n\t})\n}\n")
}
