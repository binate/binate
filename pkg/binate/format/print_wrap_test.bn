package "pkg/binate/format"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// checkWrap formats a function, asserting token-equality, that no line exceeds
// 100 columns, and that formatting is idempotent (the key wrapping invariants).
func checkWrap(src *[]readonly char) testing.TestResult {
	var out @[]readonly char = fmtFunc(src)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("wrap: a line exceeds 100", out, "")
	}
	var out2 @[]readonly char = fmtFunc(out)
	if !streq(out, out2) {
		return tokDiff("wrap: not idempotent", out, out2)
	}
	return ""
}

// A single-line call that fits stays on one line.
func TestWrapCallFits() testing.TestResult {
	return checkLayout("func f() { g(a, b, c) }", "g(a, b, c)")
}

// A single-line call that would exceed 100 wraps (fill style, starting on the
// opener line), stays within the cap, and is idempotent.
func TestWrapCallWidthTriggered() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tsomeFunction(aaaaaaaaaa, bbbbbbbbbb, cccccccccc, dddddddddd, "
		"eeeeeeeeee, ffffffffff, gggggggggg, hhhhhhhhhh)\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	// Mode B: first args stay on the opener line, continuation at +2 indent.
	if !containsSub(out, "\tsomeFunction(aaaaaaaaaa,") {
		return tokDiff("width-triggered wrap: not mode B", out, "opener-line start")
	}
	if !containsSub(out, "\n\t\t\t") {
		return tokDiff("width-triggered wrap: no +2 continuation", out, "")
	}
	return ""
}

// A call the source wrapped with the opener alone stays wrapped that way (mode A)
// even though the arguments would fit on one line.
func TestWrapCallSourceWrappedModeA() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tg(\n"
		"\t\taaaaaaaaaa,\n"
		"\t\tbbbbbbbbbb,\n"
		"\t)\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	// Opener `(` sits alone; the first element is on a continuation line.
	if !containsSub(out, "\tg(\n\t\t\t") {
		return tokDiff("source-wrapped mode A: opener not alone", out, "g(<nl>...")
	}
	return ""
}

// A call the source wrapped with the first argument on the opener line stays in
// that mode (mode B) and is idempotent.
func TestWrapCallSourceWrappedModeB() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tg(aaaaaaaaaa,\n"
		"\t\tbbbbbbbbbb)\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "\tg(aaaaaaaaaa,") {
		return tokDiff("source-wrapped mode B: opener line not kept", out, "")
	}
	return ""
}

// A generic instantiation / index list wraps like a call.
func TestWrapIndexWidthTriggered() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = someMap[keyTypeAaaaaaaaaa, valueTypeBbbbbbbbbb, extraCcccccccccc, "
		"moreDdddddddddd, evenEeeeeeeeee]\n"
		"}"
	return checkWrap(src)
}

// A short parameter list stays on one line.
func TestWrapParamsFit() testing.TestResult {
	return checkLayout("func f(a int, b int) { g() }", "func f(a int, b int) {")
}

// A signature the source wrapped (opener alone, one per line) is re-flowed to
// fill style (mode A): the opener `(` stays alone and params fill continuation
// lines at +2 indent.
func TestWrapParamsSourceWrappedModeA() testing.TestResult {
	var src *[]readonly char =
		"func emitThing(\n"
		"\tout *strings.Builder,\n"
		"\tinstr @ir.Instr,\n"
		"\tname *[]readonly char,\n"
		") {\n"
		"\tg()\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "func emitThing(\n\t\tout *strings.Builder,") {
		return tokDiff("params mode A: opener not alone / not filled at +2", out, "")
	}
	return ""
}

// A single-line signature that exceeds 100 columns wraps fill-style (mode B):
// the first params stay on the signature line, the rest fill continuations.
func TestWrapParamsWidthTriggered() testing.TestResult {
	var src *[]readonly char =
		"func manyParams(aaaaaaaaaa int, bbbbbbbbbb int, cccccccccc int, "
		"dddddddddd int, eeeeeeeeee int, ffffffffff int) {\n"
		"\tg()\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "func manyParams(aaaaaaaaaa int,") {
		return tokDiff("params width wrap: not mode B", out, "")
	}
	return ""
}

// A function-literal parameter list wraps like a signature's.
func TestWrapFuncLitParams() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar h = func(firstParamAaaaaaa int, secondParamBbbbbb int, thirdParamCccccc int, "
		"fourthParamDddddd int) int { return 0 }\n"
		"}"
	return checkWrap(src)
}

// A composite literal that fits stays on one line.
func TestWrapCompositeFits() testing.TestResult {
	return checkLayout("func f() { var x = P{a: 1, b: 2} }", "P{a: 1, b: 2}")
}

// A struct literal the source wrote one-per-line (opener `{` alone) is re-flowed
// fill-style (mode A) and is idempotent.
func TestWrapCompositeSourceWrapped() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = Point{\n"
		"\t\tX: 1,\n"
		"\t\tY: 2,\n"
		"\t}\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "Point{\n\t\t\t") {
		return tokDiff("composite mode A: opener not alone", out, "Point{<nl>...")
	}
	return ""
}

// A single-line composite literal that exceeds 100 columns wraps.
func TestWrapCompositeWidthTriggered() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = Config{alphaField: 1, betaField: 2, gammaField: 3, deltaField: 4, "
		"epsilonField: 5, zetaField: 6}\n"
		"}"
	return checkWrap(src)
}

// A type-level generic instantiation with a long argument list wraps.
func TestWrapTypeArgs() testing.TestResult {
	var src *[]readonly char =
		"type Alias = SomeGenericType[FirstArgAaaaaaaaaa, SecondArgBbbbbbbbbb, "
		"ThirdArgCccccccccc, FourthArgDddddddddd, FifthArgEeeeeeeeee]\n"
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("type-arg wrap: a line exceeds 100", out, "")
	}
	var out2 @[]readonly char = FormatDecl(parseDeclSrc(out))
	if !streq(out, out2) {
		return tokDiff("type-arg wrap: not idempotent", out, out2)
	}
	return ""
}

// Mode-A fallback (review findings 3/7/10): a width-triggered call wrap whose
// first argument would not fit on the opener line falls back to mode A so no line
// exceeds 100.
func TestWrapCallModeAFallback() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = someReceiver.someMethodWithAReasonablyLongName("
		"firstArgumentValueThatIsIntentionallyQuiteLongToOverflow, b)\n"
		"}"
	return checkWrap(src)
}

// Mode-A fallback (finding 4): a single wide composite element wraps to a fresh
// continuation line rather than overflowing the opener line.
func TestWrapSingleWideElement() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = SomeType{aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
		"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb}\n"
		"}"
	return checkWrap(src)
}

// Mode-A fallback (finding 2): a nested composite whose element is too wide for
// the opener line wraps to +2 and stays within the cap.
func TestWrapNestedComposite() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = Outer{keyeeeeeeeeeeeeee: Inner{aaaaaaaaaaaa: 1, bbbbbbbbbbbb: 2, "
		"cccccccccccc: 3, dddddddddddd: 4}}\n"
		"}"
	return checkWrap(src)
}

// Mode-A fallback (finding 9): a signature whose first parameter is too long for
// the opener line wraps to mode A.
func TestWrapParamsModeAFallback() testing.TestResult {
	var src *[]readonly char =
		"func manyParams(firstParameterNameXxxxxx "
		"firstParameterTypeThatIsIntentionallyLongEnoughToOverflowZz, second int) {\n"
		"\tg()\n"
		"}"
	return checkWrap(src)
}

// A long string the author split across lines (adjacent literals) to stay within
// the cap is preserved split -- not merged into one over-100 line.
func TestStringPartsLineBreakPreserved() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = \"a fairly long first part of the message that is right here \"\n"
		"\t\t\"and then the second part continuing on the following line\"\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "that is right here \"\n") {
		return tokDiff("string split across lines not preserved", out, "")
	}
	return ""
}

// Adjacent literals the author kept on one line stay on one line (fits).
func TestStringPartsSameLine() testing.TestResult {
	return checkLayout("func f() { var x = \"a\" \"b\" }", "var x = \"a\" \"b\"")
}

// A same-line adjacent-string run whose SPLIT form would exceed the cap but whose
// MERGE fits is emitted merged: the cap is the hard invariant and the space-split
// is semantically identical to the merge (adjacent-literal concatenation), so
// only the visual split is lost.  Merging changes the token count, so this is a
// golden check (no token-equality): the merged form has no `" "` between literals,
// stays within the cap, and is idempotent.  (40+40 char bodies: merge = 99, split
// = 102 at this indent.)
func TestStringPartsSameLineOverflowMerges() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x @[]char = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" "
		"\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"\n"
		"}"
	var out @[]readonly char = fmtFunc(src)
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("same-line overflow not merged (line exceeds 100)", out, "")
	}
	if containsSub(out, "\" \"") {
		return tokDiff("same-line overflow kept split instead of merging", out, "")
	}
	var out2 @[]readonly char = fmtFunc(out)
	if !streq(out, out2) {
		return tokDiff("same-line merge not idempotent", out, out2)
	}
	return ""
}

// A cross-line adjacent-string run as a NON-LAST call argument keeps its author
// line breaks, and the following arguments start on a fresh continuation line
// rather than packing onto the string's deep +2 continuation (Finding 2).  Every
// line stays within the cap and the layout is idempotent.
func TestStringPartsCrossLineInFill() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tfoo(\"first part of a long string that goes on \"\n"
		"\t\t\"and continues onto the second line here\", secondArgumentNameHere, third)\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "the second line here\",\n") {
		return tokDiff("siblings packed onto the cross-line string's continuation", out, "")
	}
	return ""
}

// A nested single-argument call reserves the ENCLOSING close delimiter, so it
// sub-wraps instead of overflowing by one byte (review finding 1).
func TestWrapNestedCallEnclosingClose() testing.TestResult {
	var src *[]readonly char =
		"func h() {\n"
		"\tf(g(aaaaaaaa, bbbbbbbb, cccccccc, dddddddd, eeeeeeee, ffffffff, gggggggg, "
		"hhhhhhhh, iiiiiiiixxxxxx))\n"
		"}"
	return checkWrap(src)
}

// A trailing selector after a width-wrapped composite is reserved, so the last
// line does not overflow (review finding 5).
func TestWrapCompositeTrailingSelector() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvar x = Config{aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, "
		"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, cccccccccccc}.Field\n"
		"}"
	return checkWrap(src)
}

// checkDeclWrap formats a declaration (`.bni` mode) and asserts token-equality,
// no line over 100, and idempotence.
func checkDeclWrap(src *[]readonly char) testing.TestResult {
	var d @ast.Decl = parseDeclSrc(src)
	if d == nil { return tokDiff("parse produced no decl", src, "") }
	var out @[]readonly char = FormatDecl(d)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("decl wrap: a line exceeds 100", out, "")
	}
	var out2 @[]readonly char = FormatDecl(parseDeclSrc(out))
	if !streq(out, out2) {
		return tokDiff("decl wrap: not idempotent", out, out2)
	}
	return ""
}

// A long multi-result list wraps (review findings 6/11): printResults now wraps.
func TestWrapResults() testing.TestResult {
	var src *[]readonly char =
		"func f() (ResultTypeAaaaaaaaaaaaa, ResultTypeBbbbbbbbbbbbb, "
		"ResultTypeCcccccccccccc, ResultTypeDddddddddddddd, ResultTypeEeeeeeeeeeeee) {\n"
		"\tg()\n"
		"}"
	return checkWrap(src)
}

// A function-value type with a long parameter-type list wraps (finding 8), and
// keeps a variadic marker if present.
func TestWrapFuncTypeParams() testing.TestResult {
	var src *[]readonly char =
		"var h *func(TypeAaaaaaaaaaaaaaaaaa, TypeBbbbbbbbbbbbbbbbbb, "
		"TypeCccccccccccccccccc, TypeDddddddddddddddddd, TypeEeeeeeeeeeeeeeeeee) "
		"TypeResultFfffffff\n"
	return checkDeclWrap(src)
}

// An interface method with a long result list wraps (finding 12).
func TestWrapMethodResults() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n"
		"interface I {\n"
		"\tm() (ResultTypeAaaaaaaaaaaa, ResultTypeBbbbbbbbbbbb, ResultTypeCccccccccccc, "
		"ResultTypeDddddddddddddd, ResultTypeEeeeeeeeeeee)\n"
		"}\n"
	var f @ast.File = parseIfaceFile(src)
	var out @[]readonly char = Format(f)
	var r testing.TestResult = assertTokenEq(src, out)
	if len(r) > 0 { return r }
	if longestLine(out) > MAX_LINE_WIDTH {
		return tokDiff("method results wrap: a line exceeds 100", out, "")
	}
	return ""
}

// A spread call wraps and keeps the `...` after the final argument.
func TestWrapSpreadCall() testing.TestResult {
	var src *[]readonly char =
		"func f() {\n"
		"\tvariadicFunction(firstArgAaaaaaaaaa, secondArgBbbbbbbbbb, thirdArgCcccccccccc, "
		"restSliceDddddddddd...)\n"
		"}"
	var r testing.TestResult = checkWrap(src)
	if len(r) > 0 { return r }
	var out @[]readonly char = fmtFunc(src)
	if !containsSub(out, "...)") {
		return tokDiff("spread wrap: `...` marker lost", out, "...)")
	}
	return ""
}
