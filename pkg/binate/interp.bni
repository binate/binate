// Package interp is the embeddable whole-program interpreter surface: the
// load / type-check / IR-gen / VM-lower / register machinery that drives a
// Binate program through the bytecode VM, factored out of cmd/bni so a host
// (the CLI shell, a test harness, a future wasm worker) can reuse it without
// the CLI's argv / stdout / os.Exit coupling.  See plan-embeddable-interp.md.
//
// Increment 1a: the shared machinery moves here (errors as values — nothing
// here calls os.Exit), with cmd/bni's runProgram / runTests / runRepl calling
// these entry points.  Increment 1b adds the @Interp facade
// (New / LoadProgram / RunMain / RunFunc) over them.
package "pkg/binate/interp"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/builtins/reflect"

// RegisterPkgImports registers a loaded package's import information (struct
// types, func sigs/externs, generic decls, imported impls) for IR-gen of that
// package, plus the implicit rt / bootstrap / lang imports.
func RegisterPkgImports(ldr @loader.Loader, pkg @loader.Package, gc @ir.GenCtx)

// RegisterMainImports is RegisterPkgImports for the synthetic main package
// (driven off the merged main file's import list rather than a @loader.Package).
func RegisterMainImports(ldr @loader.Loader, file @ast.File, gc @ir.GenCtx)

// TypecheckAll type-checks every loaded package and a main file, returning the
// populated Checker plus formatted check errors (empty = ok).  Errors as
// values — never exits.
func TypecheckAll(ldr @loader.Loader, mainFile @ast.File) (@types.Checker, @[]@[]char)

// TypecheckPackages type-checks the loaded packages with no main file (the
// --test path).  Errors as values.
func TypecheckPackages(ldr @loader.Loader) (@types.Checker, @[]@[]char)

// EnsureBootstrapLoaded force-loads pkg/bootstrap (the print/println builtin
// lowers to direct calls into it regardless of user imports).
func EnsureBootstrapLoaded(ldr @loader.Loader)

// EnsureLangLoaded force-loads pkg/builtins/lang so universe-primitive methods
// (myInt.String()) resolve without an explicit import.
func EnsureLangLoaded(ldr @loader.Loader)

// RegisterStandardExterns binds the host's standard builtin-package
// surface into the VM: the `_Package()` descriptor accessors, rt's and
// reflect's auto-enumerated functions, and the VM's own cross-mode
// trampolines.  Host policy (which packages); the VM owns only the
// registration mechanism.  The pure-C pkg/bootstrap surface is separate
// (RegisterPureCExterns); the pkg/std set is InjectStdlibExterns.
func RegisterStandardExterns(vmInst @vm.VM)

// RegisterPureCExterns binds the C-shaped pkg/bootstrap surface (I/O + format
// helpers) into the VM.  Callable only from native code (the CLI shell), not a
// bytecode test context.
func RegisterPureCExterns(vmInst @vm.VM)

// InjectStdlibExterns injects the compiled native-only stdlib packages the VM
// can't interpret (the __c_call packages), exempting any that are --test
// targets (then lowered to bytecode instead).
func InjectStdlibExterns(vmInst @vm.VM, targets @[]@[]char)

// IsNativeOnlyInVM reports whether an entire package is skipped when lowering
// (run as injected compiled externs instead) — rt / bootstrap and the
// native-only pkg/std set.  This is the fixed-config predicate for the test
// runner (its injected set is always stdPkgs); the @Interp run path derives its
// own lowering skip from the inject-set New was given.
func IsNativeOnlyInVM(pkgPath *[]readonly char) bool

// PkgIsTestTarget reports whether pkgPath is one of the --test target packages.
func PkgIsTestTarget(pkgPath *[]readonly char, targets @[]@[]char) bool

// Interp is the embeddable whole-program interpreter facade over the entry
// points above: create with New, configure search paths, LoadProgram, then
// RunMain / RunFunc.  All state on the struct (no process-globals), so multiple
// instances run independently in one process.  See plan-embeddable-interp.md.
// Opaque to consumers — driven through its methods (the full struct is in
// interp.bn); same-package code uses the fields directly.
type Interp

// StandardPackages returns the default inject-set for New: the pkg/std packages
// as their compiled `@reflect.Package` descriptors (the swappable standard
// library, NOT the engine substrate).  Exposed so an embedder starts from this
// slice and replaces/wraps an entry to override library behavior.
func StandardPackages() @[]@reflect.Package

// New creates an interpreter with a stackSize-byte VM and a host-build-config
// loader.  The engine substrate (rt + reflect + the bootstrap C surface + the
// VM trampolines) is always installed; `pkgs` is the swappable standard-library
// set of `@reflect.Package` descriptors to inject — pass an empty (nil) slice
// for the default (StandardPackages), or a customized/wrapped set to override
// library behavior.  Add search paths before LoadProgram.
func New(stackSize int, pkgs @[]@reflect.Package) @Interp

// AddRoot adds a project root to both the interface and impl search paths.
func (it @Interp) AddRoot(dir @[]char)

// AddBniPath adds an interface (.bni) search directory.
func (it @Interp) AddBniPath(dir @[]char)

// AddImplPath adds an implementation (.bn) search directory.
func (it @Interp) AddImplPath(dir @[]char)

// LoadProgram loads / type-checks / IR-gens / lowers a whole program (the
// parsed source files of `main` + its transitive imports) into the VM, ending
// before main runs.  Returns load / type-check errors (empty = ok).
func (it @Interp) LoadProgram(files @[]@ast.File) @[]@[]char

// RunMain runs main.__entry (package init + main.main), returning its result
// code and any run error (empty = ok).
func (it @Interp) RunMain() (int, @[]@[]char)

// RunFunc runs the package-init dispatcher once, then the named qualified
// function with int args, returning its result code.  Alternative to RunMain.
func (it @Interp) RunFunc(qualName @[]char, args @[]int) (int, @[]@[]char)
