package "pkg/binate/interp"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/binate/vm"

// CallIfaceMethod calls method `methodName` on the interface value `recv` (a Value
// holding a marshaled @I result from RunFuncTyped) with typed args, returning typed
// results — completing the interface-value round-trip (e.g. `.Error()` on a
// returned @errors.Error).  It resolves the method's absolute vtable slot from the
// interface's (pkg, name) + method name via the retained DispatchModule, marshals
// args the same way RunFuncTyped does, dispatches through the VM's host-facing
// CallIfaceMethod, and unmarshals the results.
//
// The receiver Value is UNTOUCHED (borrowed) — the caller still owns and Releases
// it.  Each returned Value arrives +1-owned; the caller Releases each.  A run fault
// (nil receiver in the VM, a recoverable fault in the method) is returned as the
// error bundle.  Interface-typed method args and a variadic method are rejected
// (they need the arg-direction substitution / packing the host cannot supply).
func (it @Interp) CallIfaceMethod(recv Value, methodName *[]readonly char,
		args @[]Value) (@[]Value, @[]@[]char) {
	if it.DispatchModule == nil {
		return emptyValues(), oneErr("interp: CallIfaceMethod needs a loaded program")
	}
	if recv.Typ == nil {
		return emptyValues(), oneErr("interp: nil receiver")
	}
	var ifaceTyp @types.Type = types.StripWrappers(recv.Typ)
	if ifaceTyp.Kind != types.TYP_INTERFACE_VALUE_MANAGED &&
			ifaceTyp.Kind != types.TYP_INTERFACE_VALUE {
		return emptyValues(), oneErr("interp: receiver is not an interface value")
	}
	if ifaceTyp.Elem == nil {
		return emptyValues(), oneErr("interp: interface type carries no identity")
	}
	var ifacePkg @[]char = ifaceTyp.Elem.Pkg
	var ifaceName @[]char = ifaceTyp.Elem.Name

	var slot int
	var resultTypes @[]@types.Type
	var paramTypes @[]@types.Type
	var isVariadic bool
	slot, resultTypes, paramTypes, isVariadic = ir.FindInterfaceMethodSlot(it.DispatchModule, ifacePkg,
			ifaceName, methodName)
	if slot < 0 {
		return emptyValues(), oneErr("interp: interface method not found")
	}
	if isVariadic {
		return emptyValues(), oneErr("interp: variadic interface method not yet supported")
	}
	if len(args) > 6 {
		return emptyValues(), oneErr("interp: interface method with more than 6 args not supported")
	}
	for pi := 0; pi < len(paramTypes); pi++ {
		if !supportedParamType(paramTypes[pi]) {
			return emptyValues(), oneErr("interp: interface method parameter type not yet supported")
		}
	}
	// Result guard, split single-vs-multi exactly like RunFuncTyped: a SINGLE result
	// must pass the stricter supportedResultType (its by-address/scalar agreement
	// check rejects a small anonymous struct, which is classified by-address but
	// returned as a scalar with a size-0 retbuf — a by-address unpack would then read
	// an empty retbuf).  Every multi-return slot is inline in the retbuf, so the
	// per-slot check need only be marshalable.
	if len(resultTypes) == 1 {
		if !supportedResultType(resultTypes[0]) {
			return emptyValues(), oneErr("interp: interface method result type not yet supported")
		}
	} else {
		for ri := 0; ri < len(resultTypes); ri++ {
			if !supportedResultMarshalType(resultTypes[ri]) {
				return emptyValues(), oneErr("interp: interface method result type not yet supported")
			}
		}
	}
	if types.AggregateReturnSize(resultTypes) > 64 {
		return emptyValues(), oneErr("interp: interface method aggregate return too large (> 64 bytes)")
	}

	// Marshal args identically to RunFuncTyped (scalar low-word / aggregate by
	// address).  marshalArgs consumes @types.Param, so wrap the resolved types.
	var params @[]@types.Param = make_slice(@types.Param, len(paramTypes))
	for i := 0; i < len(paramTypes); i++ {
		var p @types.Param = make(types.Param)
		p.Type = paramTypes[i]
		params[i] = p
	}
	var argSlots @[]int = marshalArgs(params, args)

	var retSize int = types.AggregateReturnSize(resultTypes)
	var retbuf @[]uint8
	var retbufPtr *uint8
	if retSize > 0 {
		retbuf = make_slice(uint8, retSize)
		retbufPtr = &retbuf[0]
	}
	// scalar64 is a register-pair return only on an ILP32 host (false on the LP64
	// interp): a bare 64-bit scalar rides the one-word scalar path there.
	var retWord int = it.Vm.CallIfaceMethod(bit_cast(int, &recv.Bytes[0]), slot, retSize, false,
			argSlots, retbufPtr)
	if it.Vm.Status == vm.VM_STATUS_FAULTED {
		return emptyValues(), oneErr(it.Vm.FaultMsg)
	}
	return unmarshalResults(resultTypes, retWord, retbuf), noErrs()
}
