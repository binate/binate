package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A source with an interface (a scalar method and an aggregate-return method) and
// a bytecode impl, plus a maker that returns the interface value.
var ifaceMethodSrc *[]readonly char = "package \"test\"\n"
		"interface Named { name() @[]char; size() int }\n"
		"type Boxed struct { s @[]char; n int }\n"
		"func (b @Boxed) name() @[]char { return b.s }\n"
		"func (b @Boxed) size() int { return b.n }\n"
		"impl @Boxed : Named\n"
		"func mk(s @[]char, n int) @Named {\n"
		"	var b @Boxed = make(Boxed)\n"
		"	b.s = s\n"
		"	b.n = n\n"
		"	return b\n"
		"}\n"

// The .Error()-shape round-trip: RunFuncTyped returns an @Named, then
// CallIfaceMethod invokes its aggregate-return method name() and gets the @[]char.
func TestInterpCallIfaceMethodAggregate() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMethodSrc)
	var arg @[]char = make_slice(char, 2)
	arg[0] = 'h'
	arg[1] = 'i'
	var args @[]Value = make_slice(Value, 2)
	args[0] = StringValue(arg)
	args[1] = IntValue(5)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	var noArgs @[]Value
	var mr @[]Value
	var me @[]@[]char
	mr, me = it.CallIfaceMethod(r[0], "name", noArgs)
	if len(me) > 0 { return fail(me[0]) }
	if len(mr) != 1 { return fail("name() should return one @[]char") }
	var got @[]char = mr[0].AsString()
	var ok bool = len(got) == 2 && got[0] == 'h' && got[1] == 'i'
	mr[0].Release()
	r[0].Release()
	args[0].Release()
	if !ok { return fail("name() should return the boxed string 'hi'") }
	return ""
}

// A scalar-return interface method.
func TestInterpCallIfaceMethodScalar() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMethodSrc)
	var arg @[]char = make_slice(char, 1)
	var args @[]Value = make_slice(Value, 2)
	args[0] = StringValue(arg)
	args[1] = IntValue(37)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	var noArgs @[]Value
	var mr @[]Value
	var me @[]@[]char
	mr, me = it.CallIfaceMethod(r[0], "size", noArgs)
	if len(me) > 0 { return fail(me[0]) }
	var got int = mr[0].AsInt()
	mr[0].Release()
	r[0].Release()
	args[0].Release()
	if got != 37 { return fail("size() should return 37") }
	return ""
}

// The whole round-trip (marshal result, call method, unmarshal) must balance.
func TestInterpCallIfaceMethodBalance() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMethodSrc)
	ifaceMethodScope(it)
	var base int = rt.LiveBlocks()
	ifaceMethodScope(it)
	if rt.LiveBlocks() != base {
		return fail("iface method round-trip did not balance")
	}
	return ""
}

func ifaceMethodScope(it @Interp) {
	var arg @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 2)
	args[0] = StringValue(arg)
	args[1] = IntValue(1)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(r) == 1 {
		var noArgs @[]Value
		var mr @[]Value
		var me @[]@[]char
		mr, me = it.CallIfaceMethod(r[0], "name", noArgs)
		for i := 0; i < len(mr); i++ {
			mr[i].Release()
		}
		r[0].Release()
	}
	args[0].Release()
	args[1].Release()
}

// An unknown method name is a clean error, not a crash.
func TestInterpCallIfaceMethodUnknown() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMethodSrc)
	var arg @[]char = make_slice(char, 1)
	var args @[]Value = make_slice(Value, 2)
	args[0] = StringValue(arg)
	args[1] = IntValue(0)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	var noArgs @[]Value
	var mr @[]Value
	var me @[]@[]char
	mr, me = it.CallIfaceMethod(r[0], "nonesuch", noArgs)
	var rejected bool = len(me) > 0 && len(mr) == 0
	r[0].Release()
	args[0].Release()
	if !rejected { return fail("an unknown interface method should be rejected") }
	return ""
}

// A by-value struct method result round-trips: an interface method's struct result
// is aggregate-returned (retbuf'd) by the shim, so it does NOT hit the small-anon-
// struct retSize-0 shape a direct function can.  (The single-result guard uses the
// stricter supportedResultType regardless, to stay aligned with RunFuncTyped.)
func TestInterpCallIfaceMethodStructResult() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type P struct { a int }\n"
					"interface I { m() P }\n"
					"type Boxed struct { x int }\n"
					"func (b @Boxed) m() P { var p P; p.a = 9; return p }\n"
					"impl @Boxed : I\n"
					"func mk() @I { var b @Boxed = make(Boxed); return b }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	var mr @[]Value
	var me @[]@[]char
	mr, me = it.CallIfaceMethod(r[0], "m", noArgs)
	if len(me) > 0 { return fail(me[0]) }
	if len(mr) != 1 { return fail("m() should return one struct") }
	var got int = structFieldInt(mr[0], 0)
	mr[0].Release()
	r[0].Release()
	if got != 9 { return fail("m().a should be 9") }
	return ""
}

// A method whose signature mentions Self cannot be called through an interface
// value (spec iface.self.object-safety), so the host call refuses it with a clean
// error before marshaling anything; the interface's Self-free method still runs.
func TestInterpCallIfaceMethodSelfRejected() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"interface Eqer { equal(o Self) bool; size() int }\n"
					"type B struct { n int }\n"
					"func (b @B) equal(o @B) bool { return b.n == o.n }\n"
					"func (b @B) size() int { return b.n }\n"
					"impl @B : Eqer\n"
					"func mk(n int) @Eqer {\n"
					"	var b @B = make(B)\n"
					"	b.n = n\n"
					"	return b\n"
					"}\n")
	var args @[]Value = make_slice(Value, 1)
	args[0] = IntValue(4)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	var mr @[]Value
	var me @[]@[]char
	mr, me = it.CallIfaceMethod(r[0], "equal", args)
	var rejected bool = len(me) == 1 && len(mr) == 0 &&
			types.CharEq(me[0],
					"interp: interface method uses Self and cannot be called through an interface value")
	var noArgs @[]Value
	var sr @[]Value
	var se @[]@[]char
	sr, se = it.CallIfaceMethod(r[0], "size", noArgs)
	var sizeOk bool = len(se) == 0 && len(sr) == 1 && sr[0].AsInt() == 4
	if len(sr) == 1 { sr[0].Release() }
	r[0].Release()
	if !rejected { return fail("a Self-using interface method should be rejected") }
	if !sizeOk { return fail("the Self-free size() should still return 4") }
	return ""
}

// A method declared on a parent interface is found through the child interface
// value's type (its signature from the parent) and dispatched at its slot in the
// child's vtable.
func TestInterpCallIfaceMethodInherited() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"interface Sized { size() int }\n"
					"interface Labeled : Sized { label() int }\n"
					"type B struct { n int }\n"
					"func (b @B) size() int { return b.n }\n"
					"func (b @B) label() int { return b.n * 10 }\n"
					"impl @B : Labeled\n"
					"func mk(n int) @Labeled {\n"
					"	var b @B = make(B)\n"
					"	b.n = n\n"
					"	return b\n"
					"}\n")
	var args @[]Value = make_slice(Value, 1)
	args[0] = IntValue(6)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	var noArgs @[]Value
	var sr @[]Value
	var se @[]@[]char
	sr, se = it.CallIfaceMethod(r[0], "size", noArgs)
	var sizeOk bool = len(se) == 0 && len(sr) == 1 && sr[0].AsInt() == 6
	if len(sr) == 1 { sr[0].Release() }
	var lr @[]Value
	var le @[]@[]char
	lr, le = it.CallIfaceMethod(r[0], "label", noArgs)
	var labelOk bool = len(le) == 0 && len(lr) == 1 && lr[0].AsInt() == 60
	if len(lr) == 1 { lr[0].Release() }
	r[0].Release()
	if len(se) > 0 { return fail(se[0]) }
	if !sizeOk { return fail("the inherited size() should return 6") }
	if !labelOk { return fail("the own label() should return 60") }
	return ""
}

// A method result over 64 bytes (20 ints and a @[]char: 192 bytes on LP64, 96 on ILP32)
// comes back whole through CallIfaceMethod, and its round trip balances.
func TestInterpCallIfaceMethodLargeStructResult() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type W struct { f0 int; f1 int; f2 int; f3 int; f4 int; f5 int; f6 int; f7 int; "
					"f8 int; f9 int; f10 int; f11 int; f12 int; f13 int; f14 int; f15 int; f16 int; "
					"f17 int; f18 int; f19 int; s @[]char }\n"
					"interface I { m() W }\n"
					"type Boxed struct { s @[]char }\n"
					"func (b @Boxed) m() W { var w W; w.f0 = 3; w.f19 = 4; w.s = b.s; return w }\n"
					"impl @Boxed : I\n"
					"func mk(s @[]char) @I { var b @Boxed = make(Boxed); b.s = s; return b }\n")
	_ = largeIfaceResultScope(it)
	var base int = rt.LiveBlocks()
	var got int = largeIfaceResultScope(it)
	if got == -1 { return fail("mk should return one interface value") }
	if got == -2 { return fail("m() should return one struct") }
	if got != 7 { return fail("m()'s struct should hold 3 in f0 and 4 in f19") }
	if rt.LiveBlocks() != base { return fail("the large method result's round trip did not balance") }
	return ""
}

// largeIfaceResultScope calls m() on mk's interface value, releases every value, and
// returns f0 + f19 of m()'s struct: -1 when mk fails, -2 when m() fails.
func largeIfaceResultScope(it @Interp) int {
	var name @[]char = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	r, e := it.RunFuncTyped("test", "mk", args)
	args[0].Release()
	if len(e) > 0 || len(r) != 1 { return -1 }
	var noArgs @[]Value
	mr, me := it.CallIfaceMethod(r[0], "m", noArgs)
	r[0].Release()
	if len(me) > 0 || len(mr) != 1 { return -2 }
	var got int = structFieldInt(mr[0], 0) + structFieldInt(mr[0], 19)
	mr[0].Release()
	return got
}

// Methods taking a struct that holds a @[]char: big's frame does not fit the test VM's
// 1 MiB stack, boom indexes past its slice once it has started, and nilI returns a nil
// interface value.
var ownedIfaceArgSrc *[]readonly char = "package \"test\"\n"
		"type W struct { f0 int; s @[]char }\n"
		"interface I { take(w W) int; big(w W) int; boom(w W) int }\n"
		"type Taker struct { n int }\n"
		"func (t @Taker) take(w W) int { return w.f0 + len(w.s) }\n"
		"func (t @Taker) big(w W) int { var a [300000]int; a[w.f0] = len(w.s); return a[w.f0] }\n"
		"func (t @Taker) boom(w W) int { var a @[]int = make_slice(int, 1); return a[w.f0] + len(w.s) }\n"
		"impl @Taker : I\n"
		"func mkI() @I { return make(Taker) }\n"
		"func nilI() @I { var i @I; return i }\n"
		"func mkW(s @[]char) W { var w W; w.f0 = 3; w.s = s; return w }\n"

// A method owns its struct parameter and destroys it, so CallIfaceMethod hands it a copy
// holding its own reference to the struct's string, as a Binate caller does: after the
// call (each Value released once) the string has the references it had before.
func TestInterpCallIfaceMethodOwnedArgIsACopy() testing.TestResult {
	var it @Interp = loadSelfContained(ownedIfaceArgSrc)
	var name @[]char = make_slice(char, 2)
	var held @[]char = name
	var backing *uint8 = bit_cast(*rt.ManagedSlice, &name).Refptr
	var before int = rt.Refcount(backing)
	got, err := ownedIfaceArgScope(it, "mkI", "take", name)
	if len(err) > 0 { return fail(buf.Concat("take(mkW(name)) failed: ", err)) }
	if got != 5 { return fail("take(mkW(name)) should be 3 + 2") }
	if rt.Refcount(backing) != before || len(held) != 2 {
		return fail("passing mkW's struct to take dropped a reference the struct Value owned")
	}
	return ""
}

// A call that would not start its method -- on a nil interface value, or big, whose frame
// does not fit the VM's stack -- is refused before any struct copy is made: the string
// has the references it had before.
func TestInterpCallIfaceMethodOwnedArgNotStarted() testing.TestResult {
	var it @Interp = loadSelfContained(ownedIfaceArgSrc)
	var name @[]char = make_slice(char, 2)
	var held @[]char = name
	var backing *uint8 = bit_cast(*rt.ManagedSlice, &name).Refptr
	var before int = rt.Refcount(backing)
	_, nilErr := ownedIfaceArgScope(it, "nilI", "take", name)
	if !seqHas(nilErr, "nil interface value") {
		return fail(buf.Concat("take on a nil interface value should be refused: ", nilErr))
	}
	_, bigErr := ownedIfaceArgScope(it, "mkI", "big", name)
	if !seqHas(bigErr, "stack overflow") {
		return fail(buf.Concat("big's frame should not fit the stack: ", bigErr))
	}
	if rt.Refcount(backing) != before || len(held) != 2 {
		return fail("a call refused before its method started changed the string's references")
	}
	return ""
}

// A method that faults after it starts (boom indexes past its slice) has released its
// parameter, the copy, and CallIfaceMethod releases nothing more: the string has the
// references it had before.
func TestInterpCallIfaceMethodOwnedArgFaultInside() testing.TestResult {
	var it @Interp = loadSelfContained(ownedIfaceArgSrc)
	var name @[]char = make_slice(char, 2)
	var held @[]char = name
	var backing *uint8 = bit_cast(*rt.ManagedSlice, &name).Refptr
	var before int = rt.Refcount(backing)
	_, boomErr := ownedIfaceArgScope(it, "mkI", "boom", name)
	if !seqHas(boomErr, "out of bounds") {
		return fail(buf.Concat("boom should index past its slice: ", boomErr))
	}
	if rt.Refcount(backing) != before || len(held) != 2 {
		return fail("a method that faulted inside changed the string's references")
	}
	return ""
}

// ownedIfaceArgScope calls method on recvFn's interface value with mkW(name), releases
// every value, and returns the method's int result and the call's error.
func ownedIfaceArgScope(it @Interp, recvFn *[]readonly char, method *[]readonly char,
		name @[]char) (int, @[]char) {
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	w, we := it.RunFuncTyped("test", "mkW", args)
	args[0].Release()
	var noArgs @[]Value
	i, ie := it.RunFuncTyped("test", recvFn, noArgs)
	if len(we) > 0 || len(w) != 1 || len(ie) > 0 || len(i) != 1 {
		return 0, buf.CopyStr("mkW or the receiver's function failed")
	}
	var targs @[]Value = make_slice(Value, 1)
	targs[0] = w[0]
	r, re := it.CallIfaceMethod(i[0], method, targs)
	w[0].Release()
	i[0].Release()
	var got int = 0
	if len(r) == 1 { got = r[0].AsInt() }
	for k := 0; k < len(r); k++ { r[k].Release() }
	if len(re) > 0 { return got, re[0] }
	var none @[]char
	return got, none
}

// seqHas reports whether s contains sub.
func seqHas(s *[]readonly char, sub *[]readonly char) bool {
	for k := 0; k + len(sub) <= len(s); k++ {
		if seq(s[k:k + len(sub)], sub) { return true }
	}
	return false
}
