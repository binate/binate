package "pkg/binate/interp"

import "pkg/binate/ast"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/std/vec"

// TypecheckAll type-checks every loaded package and a main file, returning the
// populated Checker (IR-gen consumes it) plus any check errors as formatted
// strings (empty slice = ok).  Errors-as-values: unlike the CLI's old
// typecheckAll this does NOT exit on error — the caller (CLI shell prints +
// exits; an embedder handles them however it likes) owns that decision.
func TypecheckAll(ldr @loader.Loader, mainFile @ast.File) (@types.Checker, @[]@[]char) {
	var c @types.Checker = types.NewChecker()
	// Interpreted context: reject `__c_call` at the frontend (injected packages
	// load interface-only, so only interpreted code's own `__c_call` is seen).
	c.Interpreted = true
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	if mainFile != nil {
		c.Check(mainFile)
	}
	return c, formatCheckErrors(c)
}

// TypecheckDriver type-checks the loaded packages plus a DRIVER package: its merged
// files are registered under pkgPath via CheckPackage (a lookupPackage-able scope), so
// Checker.PackageType(pkgPath, fn) resolves it for RunFuncTyped.  This is the difference
// from TypecheckAll, which checks the entry file via Check (a main program — NOT a
// lookup-able package scope).  A driver is a callable library package, not a main program.
func TypecheckDriver(ldr @loader.Loader, driverMerged @ast.File, driverFiles @[]@ast.File,
		pkgPath @[]char) (@types.Checker, @[]@[]char) {
	var c @types.Checker = types.NewChecker()
	c.Interpreted = true
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	c.CheckPackage(pkgPath, driverMerged, driverFiles, nil)
	return c, formatCheckErrors(c)
}

// TypecheckPackages type-checks the loaded packages with no main file (the
// --test path).  Errors-as-values, same contract as TypecheckAll.
func TypecheckPackages(ldr @loader.Loader) (@types.Checker, @[]@[]char) {
	var c @types.Checker = types.NewChecker()
	// Interpreted context: reject `__c_call` at the frontend (the --test runner
	// loads native-only DEPENDENCIES interface-only via NativeOnlyInterfacePaths,
	// so only a non-injected package's own `__c_call` is seen — e.g. a __c_call
	// package run as its own --test target).
	c.Interpreted = true
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	return c, formatCheckErrors(c)
}

// formatCheckErrors returns the checker's accumulated errors as formatted
// strings (empty = none) — the shared CheckerErrors -> FormatCheckError loop
// both typecheck entry points return to the caller.
func formatCheckErrors(c @types.Checker) @[]@[]char {
	var out @vec.Vec[@[]char] = vec.New[@[]char]()
	var errs @[]types.CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		out.Push(types.FormatCheckError(errs[i]))
	}
	return out.Items()
}

// EnsureLangLoaded loads pkg/builtins/lang into the loader if not already
// present, so calling a method on a universe primitive (myInt.String())
// resolves without the caller importing lang — the VM analogue of the
// cmd/bnc force-load.
func EnsureLangLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/lang") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/lang\""
	syntheticImports = appendImportSpec(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}

// EnsureReflectLoaded loads pkg/builtins/reflect into the loader if not already
// present, the VM analogue of cmd/bnc's ensureReflectLoaded.  The compiler
// synthesizes a `__Package() @reflect.Package` accessor for EVERY package, and
// IR-gen only registers it (setting Module.PackageAccessorSig, which drives the
// VM's bytecode descriptor emission) when reflect's Package type is resolvable.
// Force-loading reflect makes that hold even for a package that doesn't import
// reflect, so `<pkg>.__Package()` works under the VM without an explicit import.
func EnsureReflectLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/reflect") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/reflect\""
	syntheticImports = appendImportSpec(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}
