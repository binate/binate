package "pkg/binate/interp"

import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/builtins/testing"

// TestFormatCheckErrorsEmpty pins the empty path both typecheck entry points
// return on success: a fresh checker that has checked nothing has no errors, so
// formatCheckErrors yields an empty list (the errors-as-values contract — no
// process exit, an empty bundle means "ok").  The full load -> check pipeline
// is exercised end-to-end by the conformance VM modes (every program runs
// through TypecheckAll).
func TestFormatCheckErrorsEmpty() testing.TestResult {
	var c @types.Checker = types.NewChecker()
	var errs @[]@[]char = formatCheckErrors(c)
	if len(errs) != 0 {
		return fail("a fresh checker should yield no formatted errors")
	}
	return ""
}

// TypecheckPackages runs in an interpreted context (the --test runner), so it
// must set Checker.Interpreted — the flag checkCCall keys the "__c_call cannot be
// interpreted" error on.  Without it a __c_call --test target would reach
// lowering and hit lower_instr's default-arm abort instead of a clean type error.
// An empty loader suffices: the flag is set before any package is walked.
func TestTypecheckPackagesSetsInterpreted() testing.TestResult {
	var ldr @loader.Loader = loader.NewLoader()
	var c @types.Checker
	var errs @[]@[]char
	c, errs = TypecheckPackages(ldr)
	if len(errs) != 0 {
		return fail("an empty loader should type-check with no errors")
	}
	if !c.Interpreted() {
		return fail("TypecheckPackages must set Checker.Interpreted (the --test path is interpreted)")
	}
	return ""
}
