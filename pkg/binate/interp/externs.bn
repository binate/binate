package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/binate/vm"
import "pkg/bootstrap"
import "pkg/builtins/lang"
import "pkg/builtins/reflect"
import "pkg/builtins/rt"
import "pkg/builtins/startup"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/math"
import "pkg/std/math/big"
import "pkg/std/os"
import "pkg/std/os/process"
import "pkg/std/os/sys"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/std/time"
import "pkg/stdx/containers/vec"
import testingsys "pkg/builtins/testing/sys"

// RegisterStandardExterns binds the host's standard builtin-package
// surface into the VM: the builtin packages' `__Package()` descriptor
// accessors, rt's auto-enumerated functions (the runtime the VM can't
// interpret), reflect's (empty today), and the VM's own cross-mode
// trampolines.  This is HOST POLICY — which packages to register — kept
// here rather than in the VM, which owns only the registration MECHANISM
// (vm.RegisterPackageFunctions / vm.RegisterVmTrampolines).  The pure-C
// pkg/bootstrap surface is registered separately by RegisterPureCExterns
// (native-only); the pkg/std library set by the host's inject-set — New
// injects it via injectPackageSet, the test runner via InjectStdlibExterns
// (which adds the --test-target exemption).
func RegisterStandardExterns(vmInst @vm.VM) {
	registerPackageDescriptorExterns(vmInst)
	// Inject the substrate builtins (builtinPkgs) as their one native instance —
	// functions + exported globals + impl vtables + sat entries.  rt's functions
	// are the runtime the VM can't interpret; startup's `args` cell (behind Args())
	// binds to the single native instance os.Args() re-exports; reflect is
	// interface-only (empty today) but enumerating it keeps the set uniform.  No
	// --test-target exemption here: injectPackageSet is the run-path shape (the
	// --test path's exemption lives in runTests' lowering skip +
	// NativeOnlyInterfacePaths).
	// Register lang's NATIVE RTTI identity symbols (__typeinfo.<T> + __ifaceid.<J>)
	// BEFORE injecting it, so both the injection's own satentry keys
	// (RegisterPackageSatEntries' ensureIfaceIdSym) AND a user type's lowered
	// satentry (lowerImplVtables' ensureIfaceIdSym) coalesce to the NATIVE ifaceid —
	// the one an injected-native `arg.(*lang.Stringer)` presents.  Without this,
	// ensureIfaceIdSym would MATERIALIZE a VM-canonical ifaceid that the native
	// assertion misses, so a user type implementing a lang interface (resolved via
	// the rt.SatLookup -> lookupSatEntry fallback) fails even though lang is injected.
	// (A lang scalar is unaffected either way: it HITs native g_satTable directly.)
	vm.RegisterPackageRttiSyms(vmInst, lang.__Package())
	injectPackageSet(vmInst, builtinPackages())
	vm.RegisterVmTrampolines(vmInst)
}

// registerPackageDescriptorExterns binds each builtin package's
// compiler-synthesized `__Package() @reflect.Package` accessor so
// interpreted code can call `pkg.__Package()`.  These accessors are
// codegen-only (no `.bn` body) and NOT `.bni`-exported, so they never
// appear in any package's own Functions table — they cannot be
// auto-enumerated and must be hand-bound.  They are also load-bearing for
// the enumeration itself: vm.RegisterPackageFunctions reaches
// `<pkg>.__Package()` through these bindings when it runs as bytecode in
// an outer VM.
func registerPackageDescriptorExterns(vmInst @vm.VM) {
	const scalar int = 0
	var rtPkg *func() @reflect.Package = rt.__Package
	vmInst.RegisterExtern("pkg/builtins/rt.__Package", bit_cast(*uint8, &rtPkg), scalar,
			bit_cast(int, _func_handle(rt.__Package)))
	var btPkg *func() @reflect.Package = bootstrap.__Package
	vmInst.RegisterExtern("pkg/bootstrap.__Package", bit_cast(*uint8, &btPkg), scalar,
			bit_cast(int, _func_handle(bootstrap.__Package)))
	var reflectPkg *func() @reflect.Package = reflect.__Package
	vmInst.RegisterExtern("pkg/builtins/reflect.__Package", bit_cast(*uint8, &reflectPkg), scalar,
			bit_cast(int, _func_handle(reflect.__Package)))
	var startupPkg *func() @reflect.Package = startup.__Package
	vmInst.RegisterExtern("pkg/builtins/startup.__Package", bit_cast(*uint8, &startupPkg), scalar,
			bit_cast(int, _func_handle(startup.__Package)))
	var testingPkg *func() @reflect.Package = testing.__Package
	vmInst.RegisterExtern("pkg/builtins/testing.__Package", bit_cast(*uint8, &testingPkg), scalar,
			bit_cast(int, _func_handle(testing.__Package)))
	var testingSysPkg *func() @reflect.Package = testingsys.__Package
	vmInst.RegisterExtern("pkg/builtins/testing/sys.__Package", bit_cast(*uint8, &testingSysPkg),
			scalar, bit_cast(int, _func_handle(testingsys.__Package)))
	var langPkg *func() @reflect.Package = lang.__Package
	vmInst.RegisterExtern("pkg/builtins/lang.__Package", bit_cast(*uint8, &langPkg), scalar,
			bit_cast(int, _func_handle(lang.__Package)))
}

// RegisterPureCExterns registers the C-shaped externs (the C-only
// pkg/bootstrap surface) that have no Binate `.bn` body.  CALLABLE
// ONLY FROM NATIVE CODE (cmd/bni's main): BC_FUNC_VALUE on a function
// with no `.bn` body fails LookupFunc when run as bytecode, so test
// contexts that exercise this from bytecode would crash here.
// cmd/bni's main is always native, so the registrations succeed at
// runtime; conformance tests indirectly verify behavior via real
// cmd/bni runs.
func RegisterPureCExterns(vmInst @vm.VM) {
	registerBootstrapExterns(vmInst)
}

// stdPkg pairs a native-only pkg/std package's import path (the key
// the lowering skip matches — IsNativeOnlyInVM) with a thunk to its compiler-
// synthesized `__Package()` descriptor accessor (what injection enumerates —
// InjectStdlibExterns).  ONE table feeds both, so adding a native-only pkg/std
// package is a single edit; a path that appears in the lowering skip but not
// the injection (or vice versa) is the split-brain bug — a bytecode + native
// instance pair, or a __c_call dispatch with no native target — that
// consolidating the set into one table removes.
type stdPkg struct {
	// path is the package import path, e.g. "pkg/std/errors".
	path *[]readonly char
	// descriptor is the compiler-synthesized `__Package()` accessor, invoked at
	// injection time to enumerate the package's functions/globals/vtables.
	descriptor *func() @reflect.Package
}

// stdPkgs is the single source of truth for the pkg/std packages injected into
// the VM as the one compiled (native) instance: lowered-skipped as a dependency
// (IsNativeOnlyInVM) and injected (InjectStdlibExterns).  EVERY pkg/std package
// belongs here.  A single native instance gives cross-mode sentinel IDENTITY
// (errors.Is / io.IsEOF resolve to the same native objects across the boundary)
// and native-ABI fidelity (iface dispatch flows through the compiled marshaling
// shims); and for a __c_call package (pkg/std/os) it means every method runs as
// the linked native impl, so an INDIRECT __c_call wrapper such as os.cLseek is
// reached natively rather than as an un-injectable bytecode call.  (On the
// interp run path + REPL an injected package also loads interface-only —
// Loader.InterfaceOnly — so os's `.bn` is not even parsed there, and its
// native-only __c_call funcs never reach the interpreted-mode type check.)  ONE
// table feeds both the lowering skip and the injection, so a
// path in one but not the other (the split-brain bug) cannot arise.
// stdlib-injected.sh enforces that every pkg/std .bni appears here.
//
// The substrate builtins (builtinPkgs — rt / reflect / startup) are ALSO injected
// wholesale but are not pkg/std; they live in their own single-source-of-truth
// table (builtinPkgs, injected via RegisterStandardExterns).  pkg/bootstrap is
// substrate too but is C-shaped with no `.bn` body, so it injects via
// registerBootstrapExterns and IsNativeOnlyInVM names it explicitly.
func stdPkgs() @[]stdPkg {
	return @[]stdPkg{
			stdPkg{path: "pkg/std/errors", descriptor: errors.__Package},
			stdPkg{path: "pkg/std/io", descriptor: io.__Package},
			stdPkg{path: "pkg/std/os", descriptor: os.__Package},
			stdPkg{path: "pkg/std/os/process", descriptor: process.__Package},
			stdPkg{path: "pkg/std/os/sys", descriptor: sys.__Package},
			stdPkg{path: "pkg/std/strconv", descriptor: strconv.__Package},
			stdPkg{path: "pkg/std/math", descriptor: math.__Package},
			stdPkg{path: "pkg/std/math/big", descriptor: big.__Package},
			stdPkg{path: "pkg/std/strings", descriptor: strings.__Package},
			stdPkg{path: "pkg/std/time", descriptor: time.__Package}}
}

// builtinPkgs is the single source of truth for the pkg/builtins packages
// injected into the VM as their one compiled (native) instance — the substrate
// analog of stdPkgs.  Like stdPkgs it feeds BOTH the lowering skip
// (IsNativeOnlyInVM) and the injection (RegisterStandardExterns), plus the
// interface-only load set, so a package can never be lowered-and-injected as a
// split pair.  It reuses the stdPkg (path, descriptor) pair type.  These are
// runtime floor: rt (alloc/refcount, __c_call), reflect (introspection,
// interface-only), and startup (entry glue — the c_export'd `main`/argv capture,
// and the shared `args` cell os.Args() re-exports; injecting it binds the cell to
// the single native instance, so a bytecode program's os.Args() and the host's
// agree).
//
// pkg/bootstrap is ALSO substrate but is C-shaped with no `.bn` body, so it
// injects via registerBootstrapExterns / RegisterPureCExterns and is named
// explicitly (not here).  testing is injected too — it exports TestResult (an
// alias for the canonical testing/sys.TestResult) plus Print/Println, whose bodies
// run as the injected native instance (so their `sys.WriteStdout` sink and
// `lang.Stringer` dispatch are the linked native impls).  testing/sys is injected
// alongside it — a `__c_call` package (its per-target WriteStdout writes to fd 1 /
// the semihost console), so like pkg/std/os it must be the native instance rather
// than lowered to un-interpretable bytecode.  Still NOT injected: `lang`
// (its primitive-impl methods — int.String, ... — are reached by DIRECT calls,
// but injection binds externs only from the descriptor Functions table, which
// omits impl methods; injecting it therefore needs those methods registered as
// externs, a real follow-up — see claude-todo.md) and `build` (compile-time-only
// constants/types, no runtime surface).
func builtinPkgs() @[]stdPkg {
	return @[]stdPkg{
			stdPkg{path: "pkg/builtins/rt", descriptor: rt.__Package},
			stdPkg{path: "pkg/builtins/reflect", descriptor: reflect.__Package},
			stdPkg{path: "pkg/builtins/startup", descriptor: startup.__Package},
			stdPkg{path: "pkg/builtins/testing/sys", descriptor: testingsys.__Package},
			stdPkg{path: "pkg/builtins/testing", descriptor: testing.__Package},
			stdPkg{path: "pkg/builtins/lang", descriptor: lang.__Package}}
}

// builtinPackages evaluates each builtinPkgs descriptor to its one compiled
// `@reflect.Package` instance — the injection input for RegisterStandardExterns
// (the substrate analog of StandardPackages for stdPkgs).
func builtinPackages() @[]@reflect.Package {
	var entries @[]stdPkg = builtinPkgs()
	var pkgs @[]@reflect.Package = make_slice(@reflect.Package, len(entries))
	for i := 0; i < len(entries); i++ {
		var descriptor *func() @reflect.Package = entries[i].descriptor
		pkgs[i] = descriptor()
	}
	return pkgs
}

// pkgSetHasPath reports whether pkgPath names one of the (path, descriptor)
// entries in pkgs — the membership test IsNativeOnlyInVM / isCompiled run over
// builtinPkgs and stdPkgs.
func pkgSetHasPath(pkgs @[]stdPkg, pkgPath *[]readonly char) bool {
	for i := 0; i < len(pkgs); i++ {
		if streq(pkgs[i].path, pkgPath) {
			return true
		}
	}
	return false
}

// IsNativeOnlyInVM reports whether an ENTIRE package is skipped when lowering
// the program (as a DEPENDENCY — the main package is always lowered, so a
// package's own Test* still run when it IS the program under test).  This is the
// FIXED-CONFIG predicate for the test runner (cmd/bni --test), whose injected
// set is always builtinPkgs + stdPkgs; the @Interp run path instead derives its
// lowering skip from the actual inject-set it was given (Interp.isCompiled).  The
// substrate builtins (builtinPkgs) + bootstrap have no bytecode-runnable surface
// the VM needs to lower — rt/bootstrap are native (__c_call), startup's entry
// glue is compiled-only, reflect is interface-only.  EVERY pkg/std package
// (stdPkgs) is injected wholesale, not
// lowered: a single native instance gives cross-mode sentinel IDENTITY (a
// bytecode program and an injected compiled package root errors in the SAME
// sentinel objects, so `errors.Is` pointer identity matches across the boundary)
// and, for a __c_call package like pkg/std/os, makes every method run as the
// linked native impl — their functions are injected (RegisterPackageFunctions),
// exported globals bound to native storage (RegisterPackageGlobals), impl vtables
// bound to the native instance (RegisterPackageVtables), and interface-satisfaction
// entries recorded in the VM's registry (RegisterPackageSatEntries).
func IsNativeOnlyInVM(pkgPath *[]readonly char) bool {
	if streq(pkgPath, "pkg/bootstrap") {
		return true
	}
	return pkgSetHasPath(builtinPkgs(), pkgPath) || pkgSetHasPath(stdPkgs(), pkgPath)
}

// InjectStdlibExterns injects every pkg/std package (stdPkgs) as its one
// compiled instance by enumerating each one's `__Package()` descriptor
// (package-level injection, the same path RegisterStandardExterns uses for rt):
// functions + any exported globals + impl vtables, so cross-package
// reads/dispatch resolve to the single native instance (errors.Is / io.IsEOF
// sentinel identity) and a __c_call package's methods (pkg/std/os) run as the
// linked native impl.  The host links these packages natively, so
// `<pkg>.__Package()` is a real symbol returning the compiled descriptor.  Each
// package is skipped when it is itself a --test target — then it's lowered to
// bytecode so its own Test* run, and injecting it too would split it into a
// bytecode + native instance pair (the lowering skip in runTests has the
// symmetric exemption).
func InjectStdlibExterns(vmInst @vm.VM, targets @[]@[]char) {
	var pkgs @[]stdPkg = stdPkgs()
	for i := 0; i < len(pkgs); i++ {
		var descriptor *func() @reflect.Package = pkgs[i].descriptor
		injectPure(vmInst, targets, pkgs[i].path, descriptor())
	}
}

// injectPure injects one native-only package's functions + exported globals +
// interface-impl vtables + interface-satisfaction entries, unless the package is
// itself a --test target (then it is lowered to bytecode, not injected — see
// InjectStdlibExterns).  RegisterPackageGlobals / RegisterPackageVtables /
// RegisterPackageSatEntries are no-ops for a package with no exported globals /
// no impls.
func injectPure(vmInst @vm.VM, targets @[]@[]char, pkgPath *[]readonly char, p @reflect.Package) {
	if PkgIsTestTarget(pkgPath, targets) { return }
	vm.RegisterPackageFunctions(vmInst, p)
	vm.RegisterPackageGlobals(vmInst, p)
	vm.RegisterPackageVtables(vmInst, p)
	vm.RegisterPackageSatEntries(vmInst, p)
}

// PkgIsTestTarget reports whether pkgPath is one of the `--test` target
// packages (cli.Filenames).  A native-only stdlib package that is itself under
// test must be lowered + run as bytecode, not injected, so both the lowering
// skip and the injection guard on this.
func PkgIsTestTarget(pkgPath *[]readonly char, targets @[]@[]char) bool {
	for i := 0; i < len(targets); i++ {
		if streq(targets[i], pkgPath) {
			return true
		}
	}
	return false
}

// NativeOnlyInterfacePaths returns the packages the --test runner loads
// INTERFACE-ONLY: the native-only set (rt + bootstrap + every pkg/std package,
// i.e. IsNativeOnlyInVM), minus any that are themselves --test targets.  cmd/bni
// sets Loader.InterfaceOnly to this so an injected DEPENDENCY's native-only
// `__c_call` impl is never parsed/checked/lowered on the --test path — the
// symmetric analog of how @Interp.New loads its inject-set interface-only.  A
// native-only package that IS a --test target is excluded (kept out of the list)
// so its `.bn` still loads and its own Test* run as bytecode; combined with the
// --test typecheck setting Checker.Interpreted, a `__c_call` in such a target
// (or in any non-injected package) then surfaces as a clean frontend type error
// rather than a lower_instr default-arm abort.
func NativeOnlyInterfacePaths(targets @[]@[]char) @[]@[]char {
	var out @vec.Vec[@[]char] = vec.New[@[]char]()
	appendNonTargetPaths(out, builtinPkgs(), targets)
	if !PkgIsTestTarget("pkg/bootstrap", targets) {
		out.Push("pkg/bootstrap")
	}
	appendNonTargetPaths(out, stdPkgs(), targets)
	return out.Items()
}

// appendNonTargetPaths pushes each pkgs entry's path onto out unless that package
// is a --test target (which must load its `.bn` so its own Test* run).  Each path
// is a *[]readonly char into a static table, so it is copied into an owned
// @[]char for the managed InterfaceOnly list.
func appendNonTargetPaths(out @vec.Vec[@[]char], pkgs @[]stdPkg, targets @[]@[]char) {
	for i := 0; i < len(pkgs); i++ {
		// pkg/builtins/lang is injected (native exec) but must load FULLY, not
		// interface-only: its primitive impls (`impl int : Stringer`, …) are pure
		// Binate (no `__c_call`) and the CHECKER needs them to accept a primitive
		// method call / a primitive -> lang-interface assignment.  Unlike os (whose
		// __c_call impls can't be interpreted, hence interface-only), lang's .bn is
		// safe to parse; it is only lowering-skipped (IsNativeOnlyInVM), not
		// interface-only.  So it is the one builtinPkgs entry excluded here.
		if streq(pkgs[i].path, "pkg/builtins/lang") {
			continue
		}
		if !PkgIsTestTarget(pkgs[i].path, targets) {
			out.Push(buf.CopyStr(pkgs[i].path))
		}
	}
}

// StandardPackages returns the default inject-set for New: the pkg/std packages
// (stdPkgs), each as its one compiled `@reflect.Package` descriptor.  This is
// the swappable "standard library" — NOT the engine substrate (rt / reflect /
// bootstrap / the VM trampolines), which New always installs regardless.  An
// embedder customizes by starting from this slice and replacing an entry with a
// wrapped descriptor (a copy of e.g. os.__Package() with selected FunctionInfo
// values overridden), so the override is a first-class value that composes —
// it can be handed to a nested interpreter's New too, rather than living in one
// VM's flat registry where a re-injection would resolve back to the original.
func StandardPackages() @[]@reflect.Package {
	var entries @[]stdPkg = stdPkgs()
	var pkgs @[]@reflect.Package = make_slice(@reflect.Package, len(entries))
	for i := 0; i < len(entries); i++ {
		var descriptor *func() @reflect.Package = entries[i].descriptor
		pkgs[i] = descriptor()
	}
	return pkgs
}

// injectPackageSet injects each `@reflect.Package` in the host-chosen set as its
// one compiled instance: functions + exported globals + impl vtables +
// satisfaction entries.  This is the run-path injection New uses (no --test-target
// exemption — that lives in InjectStdlibExterns / injectPure, which the test
// runner drives instead).
func injectPackageSet(vmInst @vm.VM, pkgs @[]@reflect.Package) {
	for i := 0; i < len(pkgs); i++ {
		vm.RegisterPackageFunctions(vmInst, pkgs[i])
		vm.RegisterPackageGlobals(vmInst, pkgs[i])
		vm.RegisterPackageVtables(vmInst, pkgs[i])
		vm.RegisterPackageSatEntries(vmInst, pkgs[i])
	}
}

// registerBootstrapExterns binds pkg/bootstrap into the registry.
// bootstrap is native-only in the VM (cmd/bni skips lowering it), so every
// bytecode-reachable symbol is registered here: the print/println lowering's
// I/O sink (Write), and the format helpers
// (formatInt/Int64/Uint/Bool/Float).  (General file I/O moved to pkg/std/os;
// bootstrap's Open/Read/Close/Stat/ReadDir surface was retired, as was
// bootstrap.Args — argv now reaches a program through os.Args() / startup.Args(),
// which cmd/bni sets via os.SetArgs before running it; os is injected, so the
// interpreter and the program share it, and a nested cmd/bni does not recurse on
// the parent's argv.  Rationale: explorations/design-os-args-vm.md.)
func registerBootstrapExterns(vmInst @vm.VM) {
	const scalar int = 0

	// Slice-arg pure-C externs (Write's buffer).  The
	// aggregate-arg shim convention (emit_funcvals.bn — `i8*` +
	// dereference) handles the slice / managed-slice arguments through the
	// registry's int-args dispatch shape: args[i] carries the slice's
	// address; the shim loads before calling the underlying.
	var btWrite *func(int, *[]readonly uint8) int = bootstrap.Write
	vmInst.RegisterExtern("pkg/bootstrap.Write", bit_cast(*uint8, &btWrite), scalar,
			bit_cast(int, _func_handle(bootstrap.Write)))

	// Format helpers.  bootstrap is native-only in the VM (cmd/bni skips
	// lowering it), so these formerly-bytecode helpers must be registered
	// too — print/println lower to formatInt64 + Write.  All five return
	// int (scalar).  formatFloat's float64 arg rides the all-int shim
	// ABI (see plan-float-arg-shim.md).
	var btFormatInt *func(int, *[]uint8) int = bootstrap.formatInt
	vmInst.RegisterExtern("pkg/bootstrap.formatInt", bit_cast(*uint8, &btFormatInt), scalar,
			bit_cast(int, _func_handle(bootstrap.formatInt)))
	var btFormatInt64 *func(int64, *[]uint8) int = bootstrap.formatInt64
	vmInst.RegisterExtern("pkg/bootstrap.formatInt64", bit_cast(*uint8, &btFormatInt64), scalar,
			bit_cast(int, _func_handle(bootstrap.formatInt64)))
	var btFormatUint *func(uint64, *[]uint8) int = bootstrap.formatUint
	vmInst.RegisterExtern("pkg/bootstrap.formatUint", bit_cast(*uint8, &btFormatUint), scalar,
			bit_cast(int, _func_handle(bootstrap.formatUint)))
	var btFormatBool *func(bool, *[]uint8) int = bootstrap.formatBool
	vmInst.RegisterExtern("pkg/bootstrap.formatBool", bit_cast(*uint8, &btFormatBool), scalar,
			bit_cast(int, _func_handle(bootstrap.formatBool)))
	var btFormatFloat *func(float64, *[]uint8) int = bootstrap.formatFloat
	vmInst.RegisterExtern("pkg/bootstrap.formatFloat", bit_cast(*uint8, &btFormatFloat), scalar,
			bit_cast(int, _func_handle(bootstrap.formatFloat)))
}
