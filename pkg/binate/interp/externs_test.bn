package "pkg/binate/interp"

import "pkg/binate/vm"
import "pkg/builtins/testing"

// Smoke test for RegisterStandardExterns: it owns the host's
// builtin-package policy (descriptors + rt/reflect auto-enumeration +
// the VM trampolines), so a fresh VM gains rt's functions after the call.
// Spot-check rt.Alloc / rt.Refcount (enumerated from rt's Functions
// table) and a VM trampoline (hand-bound).  bootstrap is NOT bound here —
// that's RegisterPureCExterns.
func TestRegisterStandardExternsBindsBuiltins() testing.TestResult {
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	if len(vmInst.Externs) != 0 {
		return "fresh VM should have empty Externs"
	}
	RegisterStandardExterns(vmInst)
	if vmInst.LookupExtern("pkg/builtins/rt.Alloc") < 0 {
		return "pkg/builtins/rt.Alloc missing — RegisterStandardExterns didn't enumerate rt"
	}
	if vmInst.LookupExtern("pkg/builtins/rt.Refcount") < 0 {
		return "pkg/builtins/rt.Refcount missing"
	}
	if vmInst.LookupExtern("pkg/binate/vm.TrampolineScalar") < 0 {
		return "vm.TrampolineScalar missing — RegisterStandardExterns didn't register trampolines"
	}
	return ""
}

// TestRegisterPureCExternsBindsBootstrap pins that RegisterPureCExterns binds the
// pkg/bootstrap surface print/println depend on.  After the standard-externs
// cleanup this is the SOLE path that registers bootstrap, so a missing binding
// here would otherwise surface only via conformance or the cross-package repl
// test, never in interp's own suite.  The Args binding resolves to the
// progArgsAfterDash override (not the raw bootstrap.Args) BY CONSTRUCTION — this
// is the single binding site — and the recursive builder-comp-int-int
// conformance mode exercises that override (it would infinite-recurse without
// it).  Registration works in this bytecode test context even though the
// bootstrap functions are extern-only: only BC_FUNC_VALUE *dispatch* on a
// no-body function fails as bytecode, not RegisterExtern.
func TestRegisterPureCExternsBindsBootstrap() testing.TestResult {
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	RegisterPureCExterns(vmInst)
	if vmInst.LookupExtern("pkg/bootstrap.Write") < 0 {
		return "pkg/bootstrap.Write not bound (print/println lower to it)"
	}
	if vmInst.LookupExtern("pkg/bootstrap.formatInt") < 0 {
		return "pkg/bootstrap.formatInt not bound (print of int lowers to it)"
	}
	if vmInst.LookupExtern("pkg/bootstrap.formatFloat") < 0 {
		return "pkg/bootstrap.formatFloat not bound"
	}
	if vmInst.LookupExtern("pkg/bootstrap.Args") < 0 {
		return "pkg/bootstrap.Args not bound (the progArgsAfterDash override)"
	}
	return ""
}

// argsAfterDash returns elements after the first `--`.  Empty input
// → empty result; no `--` → empty; `--` at end → empty; `--` in the
// middle → suffix.  Multiple `--` → only the first one matters.
func TestArgsAfterDashEmpty() testing.TestResult {
	var input @[]@[]char
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 { return "empty input should yield empty output" }
	return ""
}

func TestArgsAfterDashNoSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "b")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 {
		return "no `--` should yield empty output"
	}
	return ""
}

func TestArgsAfterDashSeparatorAtEnd() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "--")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 {
		return "`--` at end should yield empty output"
	}
	return ""
}

func TestArgsAfterDashMiddleSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "flag")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "x")
	input = appendCharSlice(input, "y")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 2 { return "expected 2 elements after `--`" }
	if !streq(out[0], "x") { return "element 0 should be `x`" }
	if !streq(out[1], "y") { return "element 1 should be `y`" }
	return ""
}

func TestArgsAfterDashLeadingSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "a")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 1 { return "expected 1 element after leading `--`" }
	if !streq(out[0], "a") { return "element 0 should be `a`" }
	return ""
}

func TestArgsAfterDashOnlyFirstSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "b")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "c")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 3 { return "expected 3 elements after first `--`" }
	if !streq(out[0], "b") { return "element 0 should be `b`" }
	if !streq(out[1], "--") { return "element 1 should be `--`" }
	if !streq(out[2], "c") { return "element 2 should be `c`" }
	return ""
}

// NativeOnlyInterfacePaths is the --test interface-only set: rt + bootstrap +
// every pkg/std package (== IsNativeOnlyInVM's set), minus any --test targets.
// (PkgIsTestTarget doubles as the "is path in this slice?" membership check.)
func TestNativeOnlyInterfacePathsNoTargets() testing.TestResult {
	var noTargets @[]@[]char
	var out @[]@[]char = NativeOnlyInterfacePaths(noTargets)
	if len(out) != 2 + len(stdPkgs()) {
		return "expected rt + bootstrap + every stdPkg when nothing is a target"
	}
	if !PkgIsTestTarget("pkg/builtins/rt", out) {
		return "rt should be interface-only when it is not a --test target"
	}
	if !PkgIsTestTarget("pkg/bootstrap", out) {
		return "bootstrap should be interface-only when it is not a --test target"
	}
	if !PkgIsTestTarget("pkg/std/os", out) {
		return "pkg/std/os (a __c_call stdlib pkg) should be interface-only"
	}
	if !PkgIsTestTarget("pkg/std/errors", out) {
		return "pkg/std/errors should be interface-only"
	}
	return ""
}

func TestNativeOnlyInterfacePathsExcludesStdTarget() testing.TestResult {
	var targets @[]@[]char
	targets = appendCharSlice(targets, "pkg/std/os")
	var out @[]@[]char = NativeOnlyInterfacePaths(targets)
	// os is under test → it must load its .bn (so its own Test* run), so it is
	// EXCLUDED from interface-only; the rest of the native-only set stays.
	if PkgIsTestTarget("pkg/std/os", out) {
		return "a --test target must be excluded from the interface-only set"
	}
	if !PkgIsTestTarget("pkg/std/errors", out) {
		return "a non-target stdlib pkg should stay interface-only"
	}
	if !PkgIsTestTarget("pkg/builtins/rt", out) {
		return "rt should stay interface-only when it is not the target"
	}
	if len(out) != (2 + len(stdPkgs())) - 1 {
		return "excluding one target should drop exactly one entry"
	}
	return ""
}

func TestNativeOnlyInterfacePathsExcludesRtTarget() testing.TestResult {
	var targets @[]@[]char
	targets = appendCharSlice(targets, "pkg/builtins/rt")
	var out @[]@[]char = NativeOnlyInterfacePaths(targets)
	if PkgIsTestTarget("pkg/builtins/rt", out) {
		return "rt as a --test target must be excluded from interface-only"
	}
	if !PkgIsTestTarget("pkg/bootstrap", out) {
		return "bootstrap should stay interface-only when rt is the target"
	}
	return ""
}

func TestNativeOnlyInterfacePathsExcludesBootstrapTarget() testing.TestResult {
	var targets @[]@[]char
	targets = appendCharSlice(targets, "pkg/bootstrap")
	var out @[]@[]char = NativeOnlyInterfacePaths(targets)
	if PkgIsTestTarget("pkg/bootstrap", out) {
		return "bootstrap as a --test target must be excluded from interface-only"
	}
	if !PkgIsTestTarget("pkg/builtins/rt", out) {
		return "rt should stay interface-only when bootstrap is the target"
	}
	return ""
}
