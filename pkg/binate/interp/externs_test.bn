package "pkg/binate/interp"

import "pkg/binate/vm"
import "pkg/builtins/testing"

// Smoke test for RegisterStandardExterns: it owns the host's
// builtin-package policy (descriptors + rt/reflect auto-enumeration +
// the VM trampolines), so a fresh VM gains rt's functions after the call.
// Spot-check rt.Alloc / rt.Refcount (enumerated from rt's Functions
// table) and a VM trampoline (hand-bound).  bootstrap is NOT bound here —
// that's RegisterPureCExterns.
func TestRegisterStandardExternsBindsBuiltins() testing.TestResult {
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	if len(vmInst.Externs) != 0 {
		return "fresh VM should have empty Externs"
	}
	RegisterStandardExterns(vmInst)
	if vmInst.LookupExtern("pkg/builtins/rt.Alloc") < 0 {
		return "pkg/builtins/rt.Alloc missing — RegisterStandardExterns didn't enumerate rt"
	}
	if vmInst.LookupExtern("pkg/builtins/rt.Refcount") < 0 {
		return "pkg/builtins/rt.Refcount missing"
	}
	if vmInst.LookupExtern("pkg/binate/vm.TrampolineScalar") < 0 {
		return "vm.TrampolineScalar missing — RegisterStandardExterns didn't register trampolines"
	}
	return ""
}

// argsAfterDash returns elements after the first `--`.  Empty input
// → empty result; no `--` → empty; `--` at end → empty; `--` in the
// middle → suffix.  Multiple `--` → only the first one matters.
func TestArgsAfterDashEmpty() testing.TestResult {
	var input @[]@[]char
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 { return "empty input should yield empty output" }
	return ""
}

func TestArgsAfterDashNoSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "b")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 {
		return "no `--` should yield empty output"
	}
	return ""
}

func TestArgsAfterDashSeparatorAtEnd() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "--")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 0 {
		return "`--` at end should yield empty output"
	}
	return ""
}

func TestArgsAfterDashMiddleSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "flag")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "x")
	input = appendCharSlice(input, "y")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 2 { return "expected 2 elements after `--`" }
	if !streq(out[0], "x") { return "element 0 should be `x`" }
	if !streq(out[1], "y") { return "element 1 should be `y`" }
	return ""
}

func TestArgsAfterDashLeadingSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "a")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 1 { return "expected 1 element after leading `--`" }
	if !streq(out[0], "a") { return "element 0 should be `a`" }
	return ""
}

func TestArgsAfterDashOnlyFirstSeparator() testing.TestResult {
	var input @[]@[]char
	input = appendCharSlice(input, "a")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "b")
	input = appendCharSlice(input, "--")
	input = appendCharSlice(input, "c")
	var out @[]@[]char = argsAfterDash(input)
	if len(out) != 3 { return "expected 3 elements after first `--`" }
	if !streq(out[0], "b") { return "element 0 should be `b`" }
	if !streq(out[1], "--") { return "element 1 should be `--`" }
	if !streq(out[2], "c") { return "element 2 should be `c`" }
	return ""
}
