package "pkg/binate/interp"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irgen"
import "pkg/binate/loader"

// pathInList reports whether `p` is present in `list`.
func pathInList(list @[]@[]char, p *[]readonly char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], p) { return true }
	}
	return false
}

// registerGenericBodyExternDeps registers func sigs/externs, consts and vars
// for EVERY transitively-loaded package whose code a consumer lowers itself
// (irgen.ReLoweredAtConsumer: a generic declaration, or a constant expression
// re-lowered at each use) and for its imports — the packages that code may name;
// the package itself when the consumer reaches it (Loader.ImportClosure), as the
// consumer can instantiate its generics without importing it (through a type
// another package's declaration names).  The VM needs
// these too: even though it resolves symbols via its runtime registry, the
// call's RESULT TYPE is fixed at IR-gen time, and without the callee's real
// signature a struct-returning transitive call is lowered as a scalar
// (garbage).  Scanning ALL generic-bearing loaded packages (not just the
// consumer's direct imports) reaches calls two or more import-levels below the
// consumer: genlib.Sum[T] instantiates mid.F[T], whose body calls deep.G() —
// deep is registered because mid (also generic-bearing) is scanned.  selfPath
// is the package being compiled; its own funcs are SKIPPED so the per-package
// extern registration doesn't shadow/duplicate that package's real signatures.
// Mirrors cmd/bnc/compile_imports.bn:registerGenericBodyExternDeps.
func registerGenericBodyExternDeps(ldr @loader.Loader, directPaths @[]@[]char,
		selfPath *[]readonly char, gc @irgen.GenCtx) {
	var paths @[]@[]char
	var files @[]@ast.File
	var reach @[]@[]char = ldr.ImportClosure(directPaths)
	for i := 0; i < len(ldr.Order); i++ {
		var p @[]char = ldr.Order[i]
		var pf @ast.File = collectPkgFile(ldr, p)
		var dp @loader.Package = ldr.GetPackage(p)
		if pf == nil || dp == nil || !irgen.ReLoweredAtConsumer(pf, dp.BNI) { continue }
		if pathInList(reach, p) && !streq(p, selfPath) && !pathInList(directPaths, p) &&
				!pathInList(paths, p) {
			paths = appendCharSlice(paths, p)
			files = appendFilePtr(files, pf)
		}
		for j := 0; j < len(dp.Imports); j++ {
			var q @[]char = dp.Imports[j]
			if streq(q, selfPath) { continue }
			if pathInList(directPaths, q) { continue }
			if pathInList(paths, q) { continue }
			var qf @ast.File = collectPkgFile(ldr, q)
			if qf == nil { continue }
			paths = appendCharSlice(paths, q)
			files = appendFilePtr(files, qf)
		}
	}
	// A forwarder among these only `expose`s its home, so a body reaching members
	// through it calls the HOME's funcs and upcasts via the HOME's impls: declare
	// the expose closure too (less what is already registered and selfPath).
	var exclude @[]@[]char = appendCharSlice(directPaths, buf.CopyStr(selfPath))
	for i := 0; i < len(paths); i++ {
		exclude = appendCharSlice(exclude, paths[i])
	}
	var closure @[]@[]char = ldr.ExposeClosure(paths, exclude)
	for i := 0; i < len(closure); i++ {
		var cf @ast.File = collectPkgFile(ldr, closure[i])
		if cf == nil { continue }
		paths = appendCharSlice(paths, closure[i])
		files = appendFilePtr(files, cf)
	}
	if len(paths) > 0 {
		irgen.RegisterGenericBodyDeps(paths, files, gc)
		// Also wire these transitive packages' impls (vtables) so a
		// monomorphized generic body can upcast to one of their interfaces.
		irgen.RegisterImportedImpls(paths, files, gc)
	}
}

// RegisterPkgImports registers import information for IR gen.
func RegisterPkgImports(ldr @loader.Loader, pkg @loader.Package, gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, gc)
	var paths @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(
					ldr, pkg.Imports[j])
			if depFile != nil {
				paths = appendCharSlice(paths, pkg.Imports[j])
				files = appendFilePtr(files, depFile)
			}
		}
	}
	if !streq(pkg.Path, "pkg/builtins/rt") {
		appendRtImport(ldr, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/builtins/lang") {
		appendLangImport(ldr, &paths, &files)
	}
	appendExposeClosure(ldr, pkg.Imports, &paths, &files)
	irgen.RegisterImports(paths, files, gc)
	registerGenericBodyExternDeps(ldr, pkg.Imports, pkg.Path, gc)
}

// RegisterMainImports registers imports for the main package.
func RegisterMainImports(ldr @loader.Loader, file @ast.File, gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, gc)
	var paths @[]@[]char
	var files @[]@ast.File
	var imports @[]@[]char
	for i := 0; i < len(file.Imports); i++ {
		imports = appendCharSlice(imports, unquote(file.Imports[i].Path))
	}
	for j := 0; j < len(imports); j++ {
		var depFile @ast.File = collectPkgFile(ldr, imports[j])
		if depFile != nil {
			paths = appendCharSlice(paths, imports[j])
			files = appendFilePtr(files, depFile)
		}
	}
	appendRtImport(ldr, &paths, &files)
	appendLangImport(ldr, &paths, &files)
	appendExposeClosure(ldr, imports, &paths, &files)
	irgen.RegisterImports(paths, files, gc)
	registerGenericBodyExternDeps(ldr, imports, "main", gc)
}

// appendExposeClosure registers the transitive expose-closure of the module's
// direct imports: for a direct import that is a forwarder (exposes P), P's
// funcs/consts/vars are declared under P's home path so a resolved-home
// reference `pkg/P.X` through the forwarder resolves.  Uses collectPkgFile (the
// same source as direct imports); the already-built `paths` is the exclude set.
func appendExposeClosure(ldr @loader.Loader, roots @[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	var closure @[]@[]char = ldr.ExposeClosure(roots, *paths)
	for i := 0; i < len(closure); i++ {
		var f @ast.File = collectPkgFile(ldr, closure[i])
		if f != nil {
			*paths = appendCharSlice(*paths, closure[i])
			*files = appendFilePtr(*files, f)
		}
	}
}

// appendRtImport adds pkg/builtins/rt as an implicit import if not already
// present.
func appendRtImport(ldr @loader.Loader, paths *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*paths); i++ {
		if streq((*paths)[i], "pkg/builtins/rt") { return }
	}
	var rtPkg @loader.Package = ldr.GetPackage(
			"pkg/builtins/rt")
	if rtPkg == nil { return }
	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*paths = appendCharSlice(*paths, "pkg/builtins/rt")
	*files = appendFilePtr(*files, rtFile)
}

// appendLangImport adds pkg/builtins/lang as an implicit import if not
// already present.  The compiler force-loads lang (ensureLangLoaded) so
// `myInt.String()` resolves without the caller importing lang; a module
// that calls such a method then needs lang's signatures registered so
// the cross-package call resolves in the IR.  Mirrors
// appendRtImport (and cmd/bnc/compile_imports.bn:appendLangImport).
func appendLangImport(ldr @loader.Loader, paths *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*paths); i++ {
		if streq((*paths)[i], "pkg/builtins/lang") { return }
	}
	var langPkg @loader.Package = ldr.GetPackage(
			"pkg/builtins/lang")
	if langPkg == nil { return }
	var langFile @ast.File
	if langPkg.Merged != nil {
		langFile = langPkg.Merged
	} else if langPkg.BNI != nil {
		langFile = langPkg.BNI
	}
	if langFile == nil { return }
	*paths = appendCharSlice(*paths, "pkg/builtins/lang")
	*files = appendFilePtr(*files, langFile)
}

// registerAllStructTypes registers struct types from all loaded
// packages so the IR gen can resolve cross-package struct types.
// Uses irgen.RegisterStructTypes which registers names across all
// packages first (qualified), then populates fields. This way
// cross-package field references like `Pos token.Pos` in ast.bni
// resolve to the actual Pos struct.
func registerAllStructTypes(ldr @loader.Loader, gc @irgen.GenCtx) {
	if len(ldr.Order) == 0 { return }
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(ldr.Order); i++ {
		var depFile @ast.File = collectPkgFile(
				ldr, ldr.Order[i])
		if depFile != nil {
			paths = appendCharSlice(paths, ldr.Order[i])
			files = appendFilePtr(files, depFile)
		}
	}
	// paths[k] carries each package's import path; the registries
	// use it directly for qualification so two same-last-segment
	// packages get distinct entries.  Only RegisterImports adds to the
	// module's import list.
	irgen.RegisterStructTypes(paths, files, gc)
	irgen.RegisterAllInterfaces(paths, files, gc)
	// Stash generic decls for EVERY transitively-loaded package, not just the
	// consumer's direct imports, so a cross-package generic body that
	// instantiates another package's generic (transitive import) can
	// monomorphize it.  Generic decls are in-memory only (no IR emission), so
	// registering them broadly is cheap.  Mirrors cmd/bnc/compile_imports.bn.
	irgen.RegisterGenericDecls(paths, files, gc)
}

// collectPkgFile returns the .bni file (or merged .bn) for a loaded
// package — whichever the loader populated from the -I/-L search paths —
// or nil if the package carries no file.
func collectPkgFile(ldr @loader.Loader, pkgPath *[]readonly char) @ast.File {
	var pkg @loader.Package = ldr.GetPackage(
			pkgPath)
	if pkg == nil { return nil }
	// Prefer merged (.bni + .bn) so IR-gen can distinguish bodied
	// (locally-defined) from unbodied (extern) decls — needed for
	// the sret ABI hint on aggregate-returning externs.
	if pkg.Merged != nil { return pkg.Merged }
	if pkg.BNI != nil { return pkg.BNI }
	return nil
}

// unquote removes surrounding quotes from a string.
func unquote(s *[]readonly char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return buf.CopyStr(s[1:len(s) - 1])
	}
	return buf.CopyStr(s)
}
