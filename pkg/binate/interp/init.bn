package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/binate/vm"

// Init runs the loaded packages' initializers — every lowered package's
// top-level `var` initializers, dependencies first — through the `main.__init_all`
// dispatcher LoadProgram / LoadCallable emitted.  It runs them at most once: a
// second Init is a no-op, so package state set by earlier calls survives.  The
// host calls it after loading and before RunFunc / RunFuncTyped (RunMain calls it
// itself).  Errors are returned as values (empty = ok): nothing loaded, or a
// recoverable fault in an initializer — which a later Init reports again, since
// the packages stay only partly initialized until a Reinit completes.
func (it @Interp) Init() @[]@[]char {
	if it.Initialized {
		return initFaultErr(it)
	}
	return it.runInitializers()
}

// Reinit runs the loaded packages' initializers again.  Each initialized global
// releases its old value as the initializer stores the new one.  Errors are
// returned as for Init; a Reinit that completes clears an earlier fault.
func (it @Interp) Reinit() @[]@[]char {
	return it.runInitializers()
}

// runInitializers calls the `main.__init_all` dispatcher.  It marks the
// interpreter initialized BEFORE the call, as bn_init sets its guard before
// running the initializers, so a later Init never starts them over; a fault
// part-way is recorded in InitFault instead.
func (it @Interp) runInitializers() @[]@[]char {
	if it.Vm.LookupFunc("main.__init_all") < 0 {
		return oneErr("interp: nothing to initialize (LoadProgram / LoadCallable not run)")
	}
	it.Initialized = true
	var none @[]char
	it.InitFault = none
	var noArgs @[]int
	it.Vm.CallFunc("main.__init_all", noArgs)
	if it.Vm.Status == vm.VM_STATUS_FAULTED {
		it.InitFault = buf.CopyStr(it.Vm.FaultMsg)
	}
	return initFaultErr(it)
}

// initFaultErr reports the fault the last run of the initializers stopped on,
// if any.
func initFaultErr(it @Interp) @[]@[]char {
	if len(it.InitFault) == 0 {
		return noErrs()
	}
	return oneErr(
			buf.Concat("interp: package initialization faulted (Reinit to retry): ", it.InitFault))
}

// callReadiness is the check RunFunc / RunFuncTyped make before calling into the
// loaded packages: Init has run, and the initializers completed.
func (it @Interp) callReadiness() @[]@[]char {
	if !it.Initialized {
		return oneErr("interp: Init not run (call Init after loading, before calling into the program)")
	}
	return initFaultErr(it)
}
