package "pkg/binate/interp"

import "pkg/binate/check"

import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Tests for Init / Reinit (init.bn) and the init contract of RunMain, RunFunc
// and RunFuncTyped.

// lowerInitDispatcher lowers a `main.__init_all` dispatcher — what LoadProgram /
// LoadCallable emit — that runs m's package init if m has one, so a test that
// builds its interpreter by hand can run Init.
func lowerInitDispatcher(it @Interp, m @ir.Module) {
	var names @[]@[]char
	if m.HasPackageInit() {
		names = appendCharSlice(names, ir.PackageInitName(m.PkgPath))
	}
	var initMod @ir.Module = irgen.InitModule("\"main\"")
	initMod.PkgPath = "main"
	initMod.Checker = m.Checker
	irbuild.EmitInitDispatcher(initMod, names)
	it.Vm.LowerModule(initMod)
}

// counterSrc is a package with an initialized global that inc advances.
func counterSrc() *[]readonly char {
	return "package \"test\"\n"
			"var n int = 5\n"
			"func inc() int { n = n + 1; return n }\n"
}

// callInc runs test.inc through RunFuncTyped and returns its result, or -1 with
// the first error.
func callInc(it @Interp) (int, @[]char) {
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "inc", noArgs)
	if len(e) > 0 {
		return -1, e[0]
	}
	var v int = r[0].AsInt()
	r[0].Release()
	var none @[]char
	return v, none
}

// Package state set by one call survives into the next: the initializers run
// once, at Init, not before every call.
func TestInitRunsInitializersOnce() testing.TestResult {
	var it @Interp = loadSelfContained(counterSrc())
	var v int
	var e @[]char
	v, e = callInc(it)
	if len(e) > 0 || v != 6 { return fail("first call should see the initialized n = 5 and give 6") }
	v, e = callInc(it)
	if v != 7 { return fail("second call should keep n from the first and give 7") }
	if len(it.Init()) > 0 { return fail("a second Init should succeed") }
	v, e = callInc(it)
	if v != 8 { return fail("a second Init must not re-run the initializers") }
	return ""
}

// Reinit runs the initializers again.
func TestReinitResetsPackageState() testing.TestResult {
	var it @Interp = loadSelfContained(counterSrc())
	var v int
	var e @[]char
	v, e = callInc(it)
	v, e = callInc(it)
	if v != 7 { return fail("two calls should give 7") }
	if len(it.Reinit()) > 0 { return fail("Reinit should succeed") }
	v, e = callInc(it)
	if len(e) > 0 || v != 6 { return fail("after Reinit n should be back to 5, so inc gives 6") }
	return ""
}

// RunFuncTyped and RunFunc only call: before Init they report an error and run
// nothing.
func TestCallBeforeInitIsAnError() testing.TestResult {
	var it @Interp = loadSelfContainedNoInit(counterSrc())
	var v int
	var e @[]char
	v, e = callInc(it)
	if len(e) == 0 { return fail("RunFuncTyped before Init should be an error") }
	var noArgs @[]int
	var rc int
	var errs @[]@[]char
	rc, errs = it.RunFunc("test.inc", noArgs)
	if len(errs) == 0 { return fail("RunFunc before Init should be an error") }
	if len(it.Init()) > 0 { return fail("Init should succeed") }
	v, e = callInc(it)
	if len(e) > 0 || v != 6 { return fail("after Init the first call should give 6") }
	rc, errs = it.RunFunc("test.inc", noArgs)
	if len(errs) > 0 || rc != 7 { return fail("RunFunc after Init should give 7") }
	return ""
}

// Init and Reinit with nothing loaded report an error.
func TestInitNothingLoaded() testing.TestResult {
	var it @Interp = New(64 * 1024, StandardPackages())
	if len(it.Init()) == 0 { return fail("Init with nothing loaded should be an error") }
	if len(it.Reinit()) == 0 { return fail("Reinit with nothing loaded should be an error") }
	return ""
}

// loadMainProgram builds an @Interp holding a self-contained package main and
// its init dispatcher, the way LoadProgram leaves it (without running anything).
func loadMainProgram(src *[]readonly char) @Interp {
	var p @parser.Parser = parser.New(strToBytes(src), "main.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	var noFiles @[]@ast.File
	var noBni @ast.File
	c.CheckPackage("main", file, noFiles, noBni)
	var m @ir.Module = irgen.GenModule(c, file)
	var it @Interp = New(1024 * 1024, StandardPackages())
	it.Vm.LowerModule(m)
	lowerInitDispatcher(it, m)
	it.Checker = c
	it.DispatchModule = m
	return it
}

// mainCounterSrc is a program whose main advances an initialized global.
func mainCounterSrc() *[]readonly char {
	return "package \"main\"\n"
			"var n int = 5\n"
			"func bump() int { n = n + 1; return n }\n"
			"func get() int { return n }\n"
			"func main() { n = n + 1 }\n"
}

// RunMain runs Init itself when the host has not.
func TestRunMainRunsInit() testing.TestResult {
	var it @Interp = loadMainProgram(mainCounterSrc())
	var errs @[]@[]char
	_, errs = it.RunMain()
	if len(errs) > 0 { return fail("RunMain should succeed") }
	var noArgs @[]int
	var rc int
	rc, errs = it.RunFunc("main.get", noArgs)
	if len(errs) > 0 || rc != 6 { return fail("main should have advanced the initialized n = 5 to 6") }
	return ""
}

// After the host's Init (and calls that change package state), RunMain does
// not run the initializers again.
func TestRunMainAfterInitKeepsState() testing.TestResult {
	var it @Interp = loadMainProgram(mainCounterSrc())
	if len(it.Init()) > 0 { return fail("Init should succeed") }
	var noArgs @[]int
	var rc int
	var errs @[]@[]char
	rc, errs = it.RunFunc("main.bump", noArgs)
	if len(errs) > 0 || rc != 6 { return fail("bump should give 6") }
	_, errs = it.RunMain()
	if len(errs) > 0 { return fail("RunMain should succeed") }
	rc, errs = it.RunFunc("main.get", noArgs)
	if len(errs) > 0 || rc != 7 {
		return fail("RunMain must not re-run the initializers: n should be 7")
	}
	return ""
}

// managedInitSrc has initialized managed globals: a managed pointer, and a
// raw-slice literal whose hidden backing holds managed elements.
func managedInitSrc() *[]readonly char {
	return "package \"test\"\n"
			"type Box struct { b @int }\n"
			"func mkbox(v int) Box { var x Box; x.b = box(v); return x }\n"
			"var gp @int = box(7)\n"
			"var gBoxes *[]readonly Box = *[]readonly Box{mkbox(100), mkbox(200)}\n"
			"func total() int { return *gp + *gBoxes[0].b + *gBoxes[1].b }\n"
}

// Reinit releases what the previous run of the initializers stored: a managed
// global's old value and the old managed elements of a package-level raw-slice
// literal's backing.
func TestReinitReleasesManagedGlobals() testing.TestResult {
	var it @Interp = loadSelfContained(managedInitSrc())
	if len(it.Reinit()) > 0 { return fail("Reinit should succeed") }
	var base int = rt.LiveBlocks()
	if len(it.Reinit()) > 0 { return fail("Reinit should succeed") }
	if rt.LiveBlocks() != base {
		return fail("Reinit must release the managed values the previous run stored")
	}
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "total", noArgs)
	if len(e) > 0 || len(r) != 1 { return fail("total should run after Reinit") }
	var v int = r[0].AsInt()
	r[0].Release()
	if v != 307 { return fail("the reinitialized globals should hold 7, 100 and 200") }
	return ""
}

// faultingInitSrc's initializer for q divides by zero on its first run only
// (calls, which has no initializer, counts the runs).
func faultingInitSrc() *[]readonly char {
	return "package \"test\"\n"
			"var zero int = 0\n"
			"var calls int\n"
			"func check() int { calls = calls + 1; if calls == 1 { return 10 / zero }; return 1 }\n"
			"var q int = check()\n"
			"func get() int { return q }\n"
			"func divz() int { return 10 / zero }\n"
}

// A fault in an initializer is reported by Init, and again by a later Init;
// calls are refused while the packages are partly initialized, and a Reinit
// that completes clears the fault.
func TestInitFaultIsReportedUntilReinit() testing.TestResult {
	var it @Interp = loadSelfContainedNoInit(faultingInitSrc())
	if len(it.Init()) == 0 { return fail("Init should report the initializer's fault") }
	if len(it.Init()) == 0 { return fail("a later Init should report the fault again") }
	var noArgs @[]int
	var errs @[]@[]char
	_, errs = it.RunFunc("test.get", noArgs)
	if len(errs) == 0 { return fail("RunFunc after a faulted Init should be an error") }
	var noVals @[]Value
	var r @[]Value
	r, errs = it.RunFuncTyped("test", "get", noVals)
	if len(errs) == 0 { return fail("RunFuncTyped after a faulted Init should be an error") }
	if len(it.Reinit()) > 0 { return fail("the second run of the initializers should complete") }
	if len(it.Init()) > 0 { return fail("after a completed Reinit, Init should report no fault") }
	var rc int
	rc, errs = it.RunFunc("test.get", noArgs)
	if len(errs) > 0 || rc != 1 { return fail("after a completed Reinit, get should give 1") }
	return ""
}

// RunFunc reports a recoverable fault in the function it calls.
func TestRunFuncReportsFault() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\nvar zero int = 0\nfunc divz() int { return 10 / zero }\n")
	var noArgs @[]int
	var errs @[]@[]char
	_, errs = it.RunFunc("test.divz", noArgs)
	if len(errs) == 0 { return fail("RunFunc should report the division fault") }
	return ""
}
