package "pkg/binate/interp"

import "pkg/binate/buildcfg"
import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/builtins/testing"

// New lays types out for the host it runs on -- its sizes, arch and float ABI (hard on
// an arm32 linux host) -- whatever target was set before.
func TestNewSetsHostTarget() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	cfg, ok := buildcfg.ConfigForTargetKey("arm32-baremetal")
	if !ok { return fail("arm32-baremetal must be a key") }
	types.SetTarget(buildcfg.TargetFor(cfg))
	var it @Interp = New(64 * 1024, StandardPackages())
	if it == nil { return fail("New returned nil") }
	var t types.TargetInfo = types.GetTarget()
	if t.PointerSize != cast(int, sizeof(*uint8)) || t.IntSize != cast(int, sizeof(int)) {
		return fail("New must lay types out with the host's sizes")
	}
	var arch int = types.ARCH_AA64
	if build.Arch == build.ARCH_X64 { arch = types.ARCH_X64 }
	if build.Arch == build.ARCH_ARM32 { arch = types.ARCH_ARM32 }
	if t.Arch != arch { return fail("New must set the host's arch") }
	var floatABI int = types.FLOAT_ABI_DEFAULT
	if build.Arch == build.ARCH_ARM32 && build.OS == build.OS_LINUX { floatABI = types.FLOAT_ABI_HARD }
	if t.FloatABI != floatABI { return fail("New must set the host's float ABI") }
	return ""
}
