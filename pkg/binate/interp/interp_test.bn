package "pkg/binate/interp"

import "pkg/builtins/reflect"
import "pkg/builtins/testing"

// hasPath reports whether dir is present in a loader search-path list.
func hasPath(paths @[]@[]char, dir *[]readonly char) bool {
	for i := 0; i < len(paths); i++ {
		if seq(paths[i], dir) { return true }
	}
	return false
}

// TestNewStructure pins what New wires up: a VM and a loader, with the loader's
// interface search path seeded with "." (the NewLoader(".") default the host
// extends via AddRoot / AddBniPath).
func TestNewStructure() testing.TestResult {
	var it @Interp = New(64 * 1024, StandardPackages())
	if it.Vm == nil { return fail("New should create a VM") }
	if it.Ldr == nil { return fail("New should create a loader") }
	if !hasPath(it.Ldr.BniPath, ".") {
		return fail("New's loader should seed \".\" in the bni search path")
	}
	return ""
}

// TestRunMainNotLoaded pins the errors-as-values contract: RunMain on a fresh
// interpreter (no LoadProgram, so no main.__entry) returns an error rather than
// crashing, and rc 0.
func TestRunMainNotLoaded() testing.TestResult {
	var it @Interp = New(64 * 1024, StandardPackages())
	var rc int
	var errs @[]@[]char
	rc, errs = it.RunMain()
	if len(errs) == 0 {
		return fail("RunMain with nothing loaded should return an error, not crash")
	}
	if rc != 0 {
		return fail("RunMain's error path should return rc 0")
	}
	return ""
}

// TestTwoInterpInstancesIsolated proves two @Interp instances are fully
// independent — distinct VM + loader objects with independent search-path state
// — so they run in one process without cross-contamination.  This is the
// facade-level form of the inc-5 / 5d-4 reentrancy the carriers guarantee; the
// full run-a-program-twice path (which needs real search paths) is covered
// in-process by vm/vm_reentrancy_test over the same carriers.
func TestTwoInterpInstancesIsolated() testing.TestResult {
	var a @Interp = New(64 * 1024, StandardPackages())
	var b @Interp = New(64 * 1024, StandardPackages())
	a.AddBniPath("/aaa")
	b.AddBniPath("/bbb")
	if same(a.Ldr, b.Ldr) {
		return fail("two New() calls must give distinct loaders")
	}
	if same(a.Vm, b.Vm) {
		return fail("two New() calls must give distinct VMs")
	}
	if !hasPath(a.Ldr.BniPath, "/aaa") {
		return fail("instance a should hold its own /aaa")
	}
	if hasPath(a.Ldr.BniPath, "/bbb") {
		return fail("instance a must NOT see b's /bbb")
	}
	if !hasPath(b.Ldr.BniPath, "/bbb") {
		return fail("instance b should hold its own /bbb")
	}
	if hasPath(b.Ldr.BniPath, "/aaa") {
		return fail("instance b must NOT see a's /aaa")
	}
	return ""
}

// TestNewEmptyPkgsDefaultsToStandard pins the empty/nil → default contract: a
// New with an empty inject-set registers the same externs as one given
// StandardPackages() explicitly (so embedders can pass nil for "just the
// standard library").
func TestNewEmptyPkgsDefaultsToStandard() testing.TestResult {
	var empty @[]@reflect.Package
	var itDefault @Interp = New(64 * 1024, empty)
	var itExplicit @Interp = New(64 * 1024, StandardPackages())
	if len(itDefault.Vm.Externs) != len(itExplicit.Vm.Externs) {
		return fail("empty pkgs should default to StandardPackages (same extern count)")
	}
	if len(itDefault.Vm.Externs) == 0 {
		return fail("the default set should register externs")
	}
	return ""
}

// TestNewCustomPkgsRespected proves New injects the GIVEN set, not the default:
// a reduced one-package set registers strictly fewer externs than the full
// standard set (same engine substrate in both, fewer library functions).  This
// is the seam an embedder uses to swap/wrap the standard library.
func TestNewCustomPkgsRespected() testing.TestResult {
	var std @[]@reflect.Package = StandardPackages()
	if len(std) < 2 {
		return fail("expected the standard set to hold multiple packages")
	}
	var custom @[]@reflect.Package = make_slice(@reflect.Package, 1)
	custom[0] = std[0]
	var itCustom @Interp = New(64 * 1024, custom)
	var itFull @Interp = New(64 * 1024, std)
	if len(itCustom.Vm.Externs) >= len(itFull.Vm.Externs) {
		return fail("a reduced one-package set should register fewer externs "
			"than the full standard set — the given set must be honored")
	}
	return ""
}
