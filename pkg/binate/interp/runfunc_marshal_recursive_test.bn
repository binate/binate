package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// A recursive type is judged marshalable by its parts, without walking it
// forever: a named managed slice of itself, a struct holding a managed slice of
// itself — and a struct that may carry an interface field only as a result is
// still rejected where it recurs as a slice element (no interface there).
func TestMarshalableRecursiveTypes() testing.TestResult {
	var tree @types.Type = types.MakeNamedType("main.Tree")
	tree.Underlying = types.MakeManagedSliceType(tree)
	if !supportedMarshalType(tree) { return fail("Tree (@[]Tree) is marshalable") }
	var noFields @[]@types.Field
	var node @types.Type = types.MakeStructType("main.Node", noFields)
	var kids @types.Field = make(types.Field)
	kids.Name = "kids"
	kids.Type = types.MakeManagedSliceType(node)
	node.Fields = @[]@types.Field{kids}
	if !supportedMarshalType(node) { return fail("Node { kids @[]Node } is marshalable") }
	var r @types.Type = types.MakeStructType("main.R", noFields)
	var iv @types.Field = make(types.Field)
	iv.Name = "i"
	iv.Type = types.MakeManagedInterfaceValueType(types.MakeInterfaceType("main", "I"))
	var rk @types.Field = make(types.Field)
	rk.Name = "kids"
	rk.Type = types.MakeManagedSliceType(r)
	r.Fields = @[]@types.Field{iv, rk}
	if supportedResultMarshalType(r) {
		return fail("R { i @I; kids @[]R }: an R element of the slice may not carry an @I")
	}
	return ""
}

// deepRing is how many structs the deep test's rings hold: far past what the call
// stack could follow with a call per part.
const deepRing int = 100000

// ringMarshalable builds a ring of n structs S0 .. S<n-1>, each `struct { p @[]S<i+1>;
// v int }`, the last holding a managed-slice of the first -- the struct at index bad,
// if it is one, also holding a raw slice of int, which is not marshalable -- and
// returns whether S0 is marshalable.  It breaks the ring before it returns, so its
// structs are freed one by one rather than a destruction nested per struct (or never,
// round the ring).
func ringMarshalable(n int, bad int) bool {
	var ring @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		var noFields @[]@types.Field
		ring[i] = types.MakeStructType(buf.Concat("S", strconv.Itoa(i)), noFields)
	}
	for i := 0; i < n; i++ {
		var nf int = 2
		if i == bad { nf = 3 }
		var fs @[]@types.Field = make_slice(@types.Field, nf)
		fs[0] = make(types.Field)
		fs[0].Name = "p"
		fs[0].Type = types.MakeManagedSliceTypeUncached(ring[(i + 1) % n])
		fs[1] = make(types.Field)
		fs[1].Name = "v"
		fs[1].Type = types.TypInt()
		if i == bad {
			fs[2] = make(types.Field)
			fs[2].Name = "raw"
			fs[2].Type = types.MakeSliceType(types.TypInt())
		}
		ring[i].Fields = fs
	}
	var ok bool = supportedMarshalType(ring[0])
	for i := 0; i < n; i++ {
		ring[i].Fields[0].Type.Elem = nil
	}
	return ok
}

// A ring of structs joined by managed-slice fields, far longer than the call stack
// could follow with a call per part, is marshalable when every struct's fields are,
// and not when one struct holds a raw slice.
func TestDeepStructRingMarshalable() testing.TestResult {
	if !ringMarshalable(deepRing, -1) {
		return fail("a ring of marshalable structs should be marshalable")
	}
	if ringMarshalable(deepRing, deepRing - 1) {
		return fail("a ring with a struct holding a raw slice should not be marshalable")
	}
	return ""
}

// Each part is checked once however many ways it is reached: a chain of 64 structs,
// each with two managed-slice fields of the next, reaches the last by 2^63 paths.
func TestSharedPartsCheckedOnce() testing.TestResult {
	var noFields @[]@types.Field
	var next @types.Type = types.MakeStructType("C63", noFields)
	var v @types.Field = make(types.Field)
	v.Name = "v"
	v.Type = types.TypInt()
	next.Fields = @[]@types.Field{v}
	for i := 62; i >= 0; i-- {
		var c @types.Type = types.MakeStructType(buf.Concat("C", strconv.Itoa(i)), noFields)
		var a @types.Field = make(types.Field)
		a.Name = "a"
		a.Type = types.MakeManagedSliceTypeUncached(next)
		var b @types.Field = make(types.Field)
		b.Name = "b"
		b.Type = types.MakeManagedSliceTypeUncached(next)
		c.Fields = @[]@types.Field{a, b}
		next = c
	}
	if !supportedMarshalType(next) { return fail("the chain of structs should be marshalable") }
	return ""
}
