package "pkg/binate/interp"

import "pkg/binate/types"
import "pkg/builtins/testing"

// A recursive type is judged marshalable by its parts, without walking it
// forever: a named managed slice of itself, a struct holding a managed slice of
// itself — and a struct that may carry an interface field only as a result is
// still rejected where it recurs as a slice element (no interface there).
func TestMarshalableRecursiveTypes() testing.TestResult {
	var tree @types.Type = types.MakeNamedType("main.Tree")
	tree.Underlying = types.MakeManagedSliceType(tree)
	if !supportedMarshalType(tree) { return fail("Tree (@[]Tree) is marshalable") }
	var noFields @[]@types.Field
	var node @types.Type = types.MakeStructType("main.Node", noFields)
	var kids @types.Field = make(types.Field)
	kids.Name = "kids"
	kids.Type = types.MakeManagedSliceType(node)
	node.Fields = @[]@types.Field{kids}
	if !supportedMarshalType(node) { return fail("Node { kids @[]Node } is marshalable") }
	var r @types.Type = types.MakeStructType("main.R", noFields)
	var iv @types.Field = make(types.Field)
	iv.Name = "i"
	iv.Type = types.MakeManagedInterfaceValueType(types.MakeInterfaceType("main", "I"))
	var rk @types.Field = make(types.Field)
	rk.Name = "kids"
	rk.Type = types.MakeManagedSliceType(r)
	r.Fields = @[]@types.Field{iv, rk}
	if supportedResultMarshalType(r) {
		return fail("R { i @I; kids @[]R }: an R element of the slice may not carry an @I")
	}
	return ""
}
