package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/binate/vm"

// RunFuncTyped calls the package-level function `pkgPath.funcName` (pkgPath is
// the FULL import path, e.g. "pkg/std/strconv") with typed arguments and returns
// typed results.  Where RunFunc takes int args and returns one scalar word, this
// marshals managed / aggregate values (via the checker's resolved param/result
// types) in both directions.  It runs the package-init dispatcher once (like
// RunFunc), then the function.  Errors (function not found, a recoverable run
// fault) are returned as the second value (empty = ok).
//
// The caller OWNS the returned Values and MUST call Release() on each once done
// (a returned managed value arrives +1-owned).  The passed-in arg Values are
// untouched by the call — the caller still owns and Releases them.
//
// Supported today: scalar (int/int64/bool), @[]char, nested @[]@[]char, and
// by-value struct values (fields themselves supported), as args and as results —
// including a multi-return tuple, so long as the whole retbuf is <= 64 bytes.
// Interface-value / func-value results are a later Stage-C increment.
func (it @Interp) RunFuncTyped(pkgPath *[]readonly char, funcName *[]readonly char,
		args @[]Value) (@[]Value, @[]@[]char) {
	var sig @types.Type = it.Checker.PackageType(pkgPath, funcName)
	if sig == nil {
		return emptyValues(), oneErr("interp: function not found in the type checker")
	}
	if sig.Kind != types.TYP_FUNC {
		return emptyValues(), oneErr("interp: named symbol is not a function")
	}
	// Guard every param and result against a not-yet-marshalable type rather than
	// fall through to a nil-retbuf crash or an unaccounted-managed-field leak.
	for pi := 0; pi < len(sig.Params); pi++ {
		if !supportedParamType(sig.Params[pi].Type) {
			return emptyValues(), oneErr("interp: parameter type not yet supported (Stage C)")
		}
	}
	if len(sig.Results) == 1 {
		// A single result: the by-address/scalar classification must agree with
		// how it is actually returned (supportedResultType — see its comment).
		if !supportedResultType(sig.Results[0]) {
			return emptyValues(), oneErr("interp: result type not yet supported (Stage C)")
		}
	} else {
		// A multi-return tuple is ALWAYS returned via the retbuf, every slot laid
		// out inline at its tuple offset — so the single-result by-address/scalar
		// agreement check does not apply; each slot need only be marshalable (a
		// slot may be an interface value, e.g. the @errors.Error of a (T, @Error)).
		for ri := 0; ri < len(sig.Results); ri++ {
			if !supportedResultMarshalType(sig.Results[ri]) {
				return emptyValues(), oneErr("interp: result type not yet supported (Stage C)")
			}
		}
	}
	// The retbuf must fit CallFuncAggregate's copy window (a multi-@[]char tuple
	// can exceed it); a wider aggregate return is a later increment.
	if types.AggregateReturnSize(sig.Results) > 64 {
		return emptyValues(), oneErr("interp: aggregate return too large (> 64 bytes)")
	}
	var dotted @[]char = buf.Concat(pkgPath, ".")
	var qual @[]char = buf.Concat(dotted, funcName)
	if it.Vm.LookupFunc(qual) < 0 {
		return emptyValues(), oneErr("interp: function not lowered into the VM")
	}
	// Run package init once, mirroring RunFunc — a called function may read
	// package globals.
	if it.Vm.LookupFunc("main.__init_all") >= 0 {
		var noInitArgs @[]int
		it.Vm.CallFunc("main.__init_all", noInitArgs)
	}

	var argSlots @[]int = marshalArgs(sig.Params, args)
	var retSize int = types.AggregateReturnSize(sig.Results)
	var retbuf @[]uint8
	var retbufPtr *uint8
	if retSize > 0 {
		retbuf = make_slice(uint8, retSize)
		retbufPtr = &retbuf[0]
	}
	var retWord int = it.Vm.CallFuncAggregate(qual, argSlots, retbufPtr, retSize)
	if it.Vm.Status == vm.VM_STATUS_FAULTED {
		return emptyValues(), oneErr(it.Vm.FaultMsg)
	}
	return unmarshalResults(sig.Results, retWord, retbuf), noErrs()
}

// marshalArgs lays each arg Value into the VM's flat arg-slot sequence: a scalar
// rides one slot holding its low word; an aggregate (managed-slice/struct/...)
// rides one by-address slot holding the address of the Value's image (the VM
// reads a multi-word arg by address, matching lower_call.bn).  One slot per arg
// on a 64-bit host; a 64-bit-scalar arg on an ILP32 host needs two slots — a
// Stage-C follow-up (the interp runs LP64 in CI).
func marshalArgs(params @[]@types.Param, args @[]Value) @[]int {
	var slots @[]int = make_slice(int, len(args))
	for i := 0; i < len(args); i++ {
		var pt @types.Type
		if i < len(params) {
			pt = params[i].Type
		} else {
			pt = args[i].Typ
		}
		if isByAddressType(pt) {
			slots[i] = bit_cast(int, &args[i].Bytes[0])
		} else {
			// Scalar: zero-extend the value's low SizeOf bytes into the slot.  A
			// sub-word scalar (bool = 1 byte) must NOT carry the Bytes buffer's
			// uninitialized slack bytes — the VM tests the full register word, so a
			// full-word read of a 1-byte buffer could see BoolValue(false) as true.
			var word int = 0
			var wb *uint8 = bit_cast(*uint8, &word)
			var sz int = args[i].Typ.SizeOf()
			var wsz int = cast(int, sizeof(int))
			if sz > wsz { sz = wsz }
			for j := 0; j < sz; j++ {
				wb[j] = args[i].Bytes[j]
			}
			slots[i] = word
		}
	}
	return slots
}

// resultLayout builds the anonymous struct whose fields are `results`.  This is
// the SAME construction AggregateReturnSize and the VM's packMultiReturn derive
// the tuple layout from, so resultLayout(results).FieldOffset(i) is byte-identical
// to where slot i lives in the retbuf.
func resultLayout(results @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(results))
	for i := 0; i < len(results); i++ {
		var f @types.Field = make(types.Field)
		f.Type = results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// unmarshalTuple splits a multi-return retbuf into one Value per result.  A
// multi-return is ALWAYS returned via the retbuf with each slot laid out INLINE
// at its tuple offset (packMultiReturn already dereferenced aggregate registers),
// so slot i is results[i].SizeOf() bytes at resultLayout(results).FieldOffset(i).
// Each managed slot arrives +1-owned — copy without RefInc; Release drops each.
func unmarshalTuple(results @[]@types.Type, retbuf @[]uint8) @[]Value {
	var layout @types.Type = resultLayout(results)
	var out @[]Value = make_slice(Value, len(results))
	for i := 0; i < len(results); i++ {
		var v Value
		v.Typ = results[i]
		var off int = layout.FieldOffset(i)
		var sz int = results[i].SizeOf()
		v.Bytes = make_slice(uint8, sz)
		var j int = 0
		for j < sz {
			v.Bytes[j] = retbuf[off + j]
			j = j + 1
		}
		out[i] = v
	}
	return out
}

// unmarshalResults rebuilds Values from a call result: void → empty; a single
// scalar → the returned word (low SizeOf bytes); a single aggregate → a copy of
// the retbuf image; a multi-return → a per-slot split of the retbuf tuple.  Every
// image already carries the callee's transferred +1 (the Value owns it — do NOT
// RefInc on receipt).
func unmarshalResults(results @[]@types.Type, retWord int, retbuf @[]uint8) @[]Value {
	if len(results) == 0 {
		return emptyValues()
	}
	if len(results) > 1 {
		return unmarshalTuple(results, retbuf)
	}
	var rt0 @types.Type = results[0]
	var out @[]Value = make_slice(Value, 1)
	var v Value
	v.Typ = rt0
	var sz int = rt0.SizeOf()
	v.Bytes = make_slice(uint8, sz)
	if isByAddressType(rt0) {
		var j int = 0
		for j < sz {
			v.Bytes[j] = retbuf[j]
			j = j + 1
		}
	} else {
		// Copy the low min(sz, word) bytes of the return word; a truncated
		// int64 on an ILP32 host keeps its high bytes zero (the scalar-path
		// truncation, documented).
		var wbytes *uint8 = bit_cast(*uint8, &retWord)
		var wordSz int = cast(int, sizeof(int))
		var n int = sz
		if n > wordSz {
			n = wordSz
		}
		var j int = 0
		for j < n {
			v.Bytes[j] = wbytes[j]
			j = j + 1
		}
	}
	out[0] = v
	return out
}

// marshalableType reports whether RunFuncTyped can marshal a value of type t: a
// scalar; a managed-slice whose element is itself marshalable (@[]char, @[]@[]char);
// or a struct (SizeOf <= 64) every field of which is marshalable.  Arrays, raw
// slices, func values, and managed-pointer values are later increments.
//
// The predicate must admit *exactly* the set releaseImage can fully free — never
// wider (an over-wide admit leaks or reads garbage).  A managed single/double-word
// value (@T / @func) is NOT a marshalable scalar: it needs a cross-mode dtor
// handle, so the scalar arm rejects anything NeedsDestruction rather than treating
// a bare managed pointer word as a harmless scalar.
//
// allowIface widens the set to include a managed interface VALUE (@I), which
// releaseImage drops via the slot-0 dtor handle SI-4 substituted into the retbuf.
// It is true only for a RESULT (top-level or struct-nested): an iface PARAM is
// move-model and would need the reverse (native-handle -> VM-index) vtable
// translation that does not exist, and an iface as a managed-slice ELEMENT is
// never substituted by collectIfaceVtOffsets (which does not recurse into slice
// backings), so both stay rejected.
func marshalableType(t @types.Type, allowIface bool) bool {
	if t == nil {
		return false
	}
	var st @types.Type = types.StripWrappers(t)
	if allowIface &&
			(st.Kind == types.TYP_INTERFACE_VALUE_MANAGED || st.Kind == types.TYP_INTERFACE_VALUE) {
		return true
	}
	if !isByAddressType(st) {
		// Single-word by-value type.  Admit only a genuine (non-managed) scalar that
		// fits in a register word — a managed word (@T / @func, all NeedsDestruction)
		// would leak, and an over-word-size non-managed value does not fit a slot.
		if st.NeedsDestruction() {
			return false
		}
		return st.SizeOf() <= cast(int, sizeof(int))
	}
	if st.Kind == types.TYP_STRUCT {
		// A by-value struct rides the retbuf; CallFuncAggregate's copy window caps
		// it at 64 bytes, and every field must itself be marshalable so
		// releaseImage's field walk stays total.  Fields inherit allowIface (a
		// struct result may carry an iface field; a struct param may not).
		if st.SizeOf() > 64 {
			return false
		}
		for i := 0; i < len(st.Fields); i++ {
			if !marshalableType(st.Fields[i].Type, allowIface) {
				return false
			}
		}
		return true
	}
	if st.Kind == types.TYP_MANAGED_SLICE {
		// The element must itself be marshalable/releasable, recursively — but NEVER
		// an interface (allowIface=false): collectIfaceVtOffsets does not descend
		// into slice backings, so a @[]@I element word would go unsubstituted.
		return marshalableType(st.Elem, false)
	}
	return false // raw slice / array — a later increment
}

// supportedMarshalType is the non-interface predicate (params, slice elements).
func supportedMarshalType(t @types.Type) bool {
	return marshalableType(t, false)
}

// supportedResultMarshalType additionally admits an interface-value result.
func supportedResultMarshalType(t @types.Type) bool {
	return marshalableType(t, true)
}

// supportedParamType reports whether RunFuncTyped can pass a value of type t as a
// call ARGUMENT.  Beyond supportedMarshalType, a by-address argument must ALSO be
// one the VM takes by address (IsAggregateArg): a small struct (<= one word) is
// coerced in-register by the ABI, so marshalArgs' by-address hand-off of &Bytes[0]
// would mismatch the callee — reject that classifier disagreement.
func supportedParamType(t @types.Type) bool {
	if !supportedMarshalType(t) {
		return false
	}
	if isByAddressType(t) {
		return types.IsAggregateArg(t)
	}
	return true
}

// supportedResultType reports whether RunFuncTyped can unpack a single RESULT of
// type t.  Beyond supportedMarshalType, a by-address result must ALSO actually be
// returned via the retbuf (IsAggregateReturnTyp): a small anonymous struct is
// classified by-address by isByAddressType but returned as a SCALAR (retbuf size
// 0), so unmarshalResults would read an empty retbuf — reject that disagreement.
func supportedResultType(t @types.Type) bool {
	if !supportedResultMarshalType(t) {
		return false
	}
	if isByAddressType(t) {
		return types.IsAggregateReturnTyp(t)
	}
	return true
}

// isByAddressType reports whether a value of type t is passed / returned by
// address (a multi-word aggregate the VM references by pointer) rather than in a
// register word.  Peels named / readonly wrappers first (an ABI decision must see
// through them).  A managed or unmanaged interface value is a 2-word aggregate, so
// it too rides the retbuf by address.  Func-value aggregates remain Stage C.
func isByAddressType(t @types.Type) bool {
	if t == nil {
		return false
	}
	var st @types.Type = types.StripWrappers(t)
	var k int = st.Kind
	if k == types.TYP_MANAGED_SLICE {
		return true
	}
	if k == types.TYP_SLICE {
		return true
	}
	if k == types.TYP_STRUCT {
		return true
	}
	if k == types.TYP_ARRAY {
		return true
	}
	if k == types.TYP_INTERFACE_VALUE_MANAGED {
		return true
	}
	if k == types.TYP_INTERFACE_VALUE {
		return true
	}
	return false
}

// emptyValues returns a fresh empty result slice.
func emptyValues() @[]Value {
	var e @[]Value
	return e
}

// noErrs returns the empty (ok) error bundle.
func noErrs() @[]@[]char {
	var e @[]@[]char
	return e
}

// oneErr returns a single-message error bundle.
func oneErr(msg @[]char) @[]@[]char {
	return appendCharSlice(noErrs(), msg)
}
