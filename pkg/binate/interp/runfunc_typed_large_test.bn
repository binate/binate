package "pkg/binate/interp"

import "pkg/binate/buf"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A struct of 20 ints and a @[]char -- 192 bytes on LP64, 96 on ILP32, over 64 bytes on
// both -- as a RunFuncTyped result and argument.
var largeStructSrc *[]readonly char = "package \"test\"\n"
		"type W struct {\n"
		"	f0 int\n"
		"	f1 int\n"
		"	f2 int\n"
		"	f3 int\n"
		"	f4 int\n"
		"	f5 int\n"
		"	f6 int\n"
		"	f7 int\n"
		"	f8 int\n"
		"	f9 int\n"
		"	f10 int\n"
		"	f11 int\n"
		"	f12 int\n"
		"	f13 int\n"
		"	f14 int\n"
		"	f15 int\n"
		"	f16 int\n"
		"	f17 int\n"
		"	f18 int\n"
		"	f19 int\n"
		"	s @[]char\n"
		"}\n"
		"func mk(s @[]char) W { var w W; w.f0 = 3; w.f19 = 4; w.s = s; return w }\n"
		"func total(w W) int { return w.f0 + w.f19 + len(w.s) }\n"

// A struct holding a @[]char, for the owned-argument fault tests: big's frame does not fit
// the test VM's 1 MiB stack, and boom indexes past its slice once it has started.
var ownedFaultSrc *[]readonly char = "package \"test\"\n"
		"type W struct { f0 int; s @[]char }\n"
		"func mk(s @[]char) W { var w W; w.f0 = 3; w.s = s; return w }\n"
		"func big(w W) int { var a [300000]int; a[w.f0] = len(w.s); return a[w.f0] }\n"
		"func boom(w W) int { var a @[]int = make_slice(int, 1); return a[w.f0] + len(w.s) }\n"

// A struct over 64 bytes comes back whole from RunFuncTyped and goes back in as an
// argument: its first and last int fields keep their values, and total sees them and its
// @[]char.
func TestRunFuncTypedLargeStruct() testing.TestResult {
	var it @Interp = loadSelfContained(largeStructSrc)
	var got int = largeStructScope(it, make_slice(char, 2))
	if got == -1 { return fail("mk should return one struct") }
	if got == -2 { return fail("mk's struct should hold 3 in f0 and 4 in f19") }
	if got == -3 { return fail("total should take mk's struct") }
	if got != 9 { return fail("total(mk(\"ok\")) should be 3 + 4 + 2") }
	return ""
}

// The large struct's round trip balances: its @[]char field is released once.
func TestRunFuncTypedLargeStructBalance() testing.TestResult {
	var it @Interp = loadSelfContained(largeStructSrc)
	_ = largeStructScope(it, make_slice(char, 2))
	var base int = rt.LiveBlocks()
	_ = largeStructScope(it, make_slice(char, 2))
	if rt.LiveBlocks() != base { return fail("the large struct's round trip did not balance") }
	return ""
}

// total owns its struct parameter and destroys it, so RunFuncTyped hands it a copy
// holding its own reference to the string, as a Binate caller does: the call drops that
// one, not the reference mk's struct Value owns, and after the round trip (each Value
// released once) the string has the references it had before.
func TestRunFuncTypedOwnedArgIsACopy() testing.TestResult {
	var it @Interp = loadSelfContained(largeStructSrc)
	var name @[]char = make_slice(char, 2)
	var held @[]char = name
	var backing *uint8 = bit_cast(*rt.ManagedSlice, &name).Refptr
	var before int = rt.Refcount(backing)
	if largeStructScope(it, name) != 9 { return fail("total(mk(name)) should be 3 + 4 + 2") }
	if rt.Refcount(backing) != before || len(held) != 2 {
		return fail("passing mk's struct to total dropped a reference the struct Value owned")
	}
	return ""
}

// largeStructScope calls mk with name, a 2-char string, and total with mk's result,
// releases every value, and returns total's result: -1 when mk fails, -2 when its struct
// is not what mk built, -3 when total fails.
func largeStructScope(it @Interp, name @[]char) int {
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	r, e := it.RunFuncTyped("test", "mk", args)
	args[0].Release()
	if len(e) > 0 || len(r) != 1 { return -1 }
	if structFieldInt(r[0], 0) != 3 || structFieldInt(r[0], 19) != 4 {
		r[0].Release()
		return -2
	}
	var targs @[]Value = make_slice(Value, 1)
	targs[0] = r[0]
	r2, e2 := it.RunFuncTyped("test", "total", targs)
	r[0].Release()
	if len(e2) > 0 || len(r2) != 1 { return -3 }
	var got int = r2[0].AsInt()
	r2[0].Release()
	return got
}

// A call that would not start its function -- big's frame does not fit the VM's stack --
// is refused before any struct copy is made; one that faults inside its function (boom
// indexes past its slice) has released its parameter, the copy.  Either way the string
// has the references it had before.
func TestRunFuncTypedOwnedArgFaults() testing.TestResult {
	var it @Interp = loadSelfContained(ownedFaultSrc)
	var name @[]char = make_slice(char, 2)
	var held @[]char = name
	var backing *uint8 = bit_cast(*rt.ManagedSlice, &name).Refptr
	var before int = rt.Refcount(backing)
	var bigErr @[]char = ownedArgFaultScope(it, "big", name)
	if !textHas(bigErr, "stack overflow") {
		return fail(buf.Concat("big's frame should not fit the stack: ", bigErr))
	}
	if rt.Refcount(backing) != before {
		return fail("a call refused before it started changed the string's references")
	}
	var boomErr @[]char = ownedArgFaultScope(it, "boom", name)
	if !textHas(boomErr, "out of bounds") {
		return fail(buf.Concat("boom should index past its slice: ", boomErr))
	}
	if rt.Refcount(backing) != before || len(held) != 2 {
		return fail("a call that faulted inside its function released its struct copy wrongly")
	}
	return ""
}

// ownedArgFaultScope calls fn with mk(name)'s struct, releases every value, and returns
// the call's error ("" when it succeeded; "mk failed" when mk did).
func ownedArgFaultScope(it @Interp, fn *[]readonly char, name @[]char) @[]char {
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	w, we := it.RunFuncTyped("test", "mk", args)
	args[0].Release()
	if len(we) > 0 || len(w) != 1 { return buf.CopyStr("mk failed") }
	var targs @[]Value = make_slice(Value, 1)
	targs[0] = w[0]
	r, re := it.RunFuncTyped("test", fn, targs)
	w[0].Release()
	for i := 0; i < len(r); i++ { r[i].Release() }
	if len(re) == 0 { return buf.CopyStr("") }
	return re[0]
}

// textHas reports whether s contains sub.
func textHas(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if seq(s[i:i + len(sub)], sub) { return true }
	}
	return false
}
