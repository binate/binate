package "pkg/binate/interp"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// ---- marshaling helpers (pure) ----

func TestIsByAddressType() testing.TestResult {
	if isByAddressType(types.TypInt()) { return fail("int is not by-address") }
	if isByAddressType(types.TypBool()) { return fail("bool is not by-address") }
	if !isByAddressType(types.MakeManagedSliceType(types.TypChar())) {
		return fail("@[]char is by-address")
	}
	return ""
}

func TestMarshalArgsScalarAndAddress() testing.TestResult {
	var params @[]@types.Param = make_slice(@types.Param, 2)
	var p0 @types.Param = make(types.Param)
	p0.Type = types.TypInt()
	var p1 @types.Param = make(types.Param)
	p1.Type = types.MakeManagedSliceType(types.TypChar())
	params[0] = p0
	params[1] = p1
	var s @[]char = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(9)
	args[1] = StringValue(s)
	var slots @[]int = marshalArgs(params, args)
	var ok bool = len(slots) == 2 && slots[0] == 9 && slots[1] == bit_cast(int, &args[1].Bytes[0])
	args[1].Release()
	if !ok { return fail("marshalArgs: scalar value + aggregate address") }
	return ""
}

// ---- end-to-end RunFuncTyped over a self-contained package ----

// strToBytes copies readonly source text into an owned byte buffer for the parser.
func strToBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// loadSelfContained builds an @Interp whose VM holds a single import-free package
// "test" (so no search paths are needed) with the checker retained — enough to
// exercise RunFuncTyped.  CheckPackage (not Check) registers the package scope so
// RunFuncTyped's Checker.PackageType lookup resolves.
func loadSelfContained(src *[]readonly char) @Interp {
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	var noFiles @[]@ast.File
	var noBni @ast.File
	c.CheckPackage("test", file, noFiles, noBni)
	var m @ir.Module = ir.GenModule(c, file)
	var it @Interp = New(1024 * 1024, StandardPackages())
	it.Vm.LowerModule(m)
	it.Checker = c
	return it
}

func TestRunFuncTypedAddScalar() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func add(a int, b int) int { return a + b }\n")
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(20)
	args[1] = IntValue(22)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "add", args)
	if len(errs) > 0 { return fail(errs[0]) }
	if len(results) != 1 { return fail("add should return one result") }
	if results[0].AsInt() != 42 { return fail("add(20, 22) should be 42") }
	results[0].Release()
	return ""
}

// Per-call refcount balance for the all-scalar path (measured on a warmed-up
// second call, so it asserts the per-call marshaling leaks/double-frees nothing).
func TestRunFuncTypedAddRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func add(a int, b int) int { return a + b }\n")
	addScope(it)
	var base int = rt.LiveBlocks()
	addScope(it)
	if rt.LiveBlocks() != base { return fail("add (all-scalar) call did not balance") }
	return ""
}

func addScope(it @Interp) {
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(1)
	args[1] = IntValue(2)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "add", args)
	if len(results) == 1 {
		results[0].Release()
	}
	args[0].Release()
	args[1].Release()
}

// A @[]char argument marshaled by-address and a @[]char result unpacked from the
// retbuf — the aggregate round-trip.
func TestRunFuncTypedEchoString() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(s @[]char) @[]char { return s }\n")
	var arg @[]char = make_slice(char, 2)
	arg[0] = 'h'
	arg[1] = 'i'
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "echo", args)
	if len(errs) > 0 { return fail(errs[0]) }
	if len(results) != 1 { return fail("echo should return one result") }
	var got @[]char = results[0].AsString()
	var ok bool = len(got) == 2 && got[0] == 'h' && got[1] == 'i'
	results[0].Release()
	args[0].Release()
	if !ok { return fail("echo should return its input string") }
	return ""
}

// The aggregate round-trip must not leak or double-free.
func TestRunFuncTypedEchoRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(s @[]char) @[]char { return s }\n")
	echoScope(it)
	var base int = rt.LiveBlocks()
	echoScope(it)
	if rt.LiveBlocks() != base {
		return fail("echo arg/result marshaling did not balance the refcount")
	}
	return ""
}

func echoScope(it @Interp) {
	var arg @[]char = make_slice(char, 4)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "echo", args)
	if len(results) == 1 {
		results[0].Release()
	}
	args[0].Release()
	// `arg`'s own reference is dropped at scope exit; the backing frees then.
}

// A bool argument: false must marshal as false even though its 1-byte image sits
// in a word-sized slot with uninitialized slack — the scalar arg marshals only
// SizeOf bytes, zero-extended (regression for the sub-word full-word-read bug).
func TestRunFuncTypedBoolArg() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func flag(b bool) int { if b { return 1 } else { return 0 } }\n")
	var argsF @[]Value = make_slice(Value, 1)
	argsF[0] = BoolValue(false)
	var rF @[]Value
	var eF @[]@[]char
	rF, eF = it.RunFuncTyped("test", "flag", argsF)
	if len(eF) > 0 { return fail(eF[0]) }
	if rF[0].AsInt() != 0 { return fail("flag(false) should be 0") }
	rF[0].Release()

	var argsT @[]Value = make_slice(Value, 1)
	argsT[0] = BoolValue(true)
	var rT @[]Value
	var eT @[]@[]char
	rT, eT = it.RunFuncTyped("test", "flag", argsT)
	if len(eT) > 0 { return fail(eT[0]) }
	if rT[0].AsInt() != 1 { return fail("flag(true) should be 1") }
	rT[0].Release()
	return ""
}

// structFieldInt reads the int field at index idx from a struct Value's image.
func structFieldInt(v Value, idx int) int {
	var st @types.Type = types.StripWrappers(v.Typ)
	var p *int = bit_cast(*int, bit_cast(int, &v.Bytes[0]) + st.FieldOffset(idx))
	return p[0]
}

// A by-value struct with only scalar fields is now marshaled (SI-1): the retbuf
// image round-trips each field at its offset.
func TestRunFuncTypedAcceptsScalarStruct() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type P struct { a int; b int }\n"
					"func mk() P { var p P; p.a = 5; p.b = 37; return p }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one struct result") }
	if structFieldInt(r[0], 0) != 5 { return fail("P.a should be 5") }
	if structFieldInt(r[0], 1) != 37 { return fail("P.b should be 37") }
	r[0].Release()
	return ""
}

// A struct with a managed (@[]char) field: the image carries the field's +1, and
// releaseImage's struct walk RefDecs it — value round-trips and n reads back.
func TestRunFuncTypedStructReturnValue() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type S struct { name @[]char; n int }\n"
					"func mk(s @[]char) S { var r S; r.name = s; r.n = 7; return r }\n")
	var name @[]char = make_slice(char, 2)
	name[0] = 'o'
	name[1] = 'k'
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one struct") }
	if structFieldInt(r[0], 1) != 7 { return fail("S.n should be 7") }
	var st @types.Type = types.StripWrappers(r[0].Typ)
	var nm *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, bit_cast(int, &r[0].Bytes[0]) +
			st.FieldOffset(0))
	var ok bool = nm.Len == 2
	r[0].Release()
	args[0].Release()
	if !ok { return fail("S.name should carry the 2-char input") }
	return ""
}

// The struct-with-managed-field round-trip must not leak or double-free: exactly
// one RefDec on the returned image's @[]char field.
func TestRunFuncTypedStructReturnRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type S struct { name @[]char; n int }\n"
					"func mk(s @[]char) S { var r S; r.name = s; r.n = 7; return r }\n")
	structReturnScope(it)
	var base int = rt.LiveBlocks()
	structReturnScope(it)
	if rt.LiveBlocks() != base {
		return fail("struct-with-managed-field result did not balance the refcount")
	}
	return ""
}

func structReturnScope(it @Interp) {
	var name @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
}

// A struct with a managed-pointer (@Node) field is still unsupported (its cross-
// mode dtor handle lands in Stage C SI-5): it must be REJECTED, not admitted and
// leaked — the tightened scalar arm rejects the @Node field.
func TestRunFuncTypedRejectsManagedPtrField() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Node struct { v int }\n"
					"type Holder struct { node @Node; tag int }\n"
					"func mk() Holder { var h Holder; return h }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("a struct with a @Node field should be rejected (Stage C SI-5)") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A managed-slice of a managed-POINTER element (@[]@Node) must be REJECTED: its
// backing frees fine but each element needs its own RefDec, which releaseImage
// does not yet do — admitting it would leak every element.  (Gated on the
// element's NeedsDestruction, not isByAddressType — @Node is not by-address.)
func TestRunFuncTypedRejectsSliceOfManagedPtr() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Node struct { v int }\n"
					"func mk() @[]@Node { var xs @[]@Node; return xs }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("@[]@Node result should be rejected (would leak elements)") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A SMALL (<= one word) anonymous-struct result must be REJECTED, not crash: it
// is classified by-address but returned as a scalar (retbuf size 0), so a
// by-address unpack would read an empty retbuf (index-out-of-bounds).
func TestRunFuncTypedRejectsSmallAnonStructResult() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func mk() struct { a char; b char } { var p struct { a char; b char }; return p }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("small anon-struct result should be rejected, not crash") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A large (> one word) struct passed as an ARGUMENT round-trips: marshalArgs
// hands it over by-address (matching IsAggregateArg) and the callee reads its
// fields.  mk() builds the struct, sum(P) adds its fields back.
func TestRunFuncTypedStructParamRoundTrip() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type P struct { a int; b int }\n"
					"func mk() P { var p P; p.a = 11; p.b = 31; return p }\n"
					"func sum(p P) int { return p.a + p.b }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	var sumArgs @[]Value = make_slice(Value, 1)
	sumArgs[0] = r[0]
	var r2 @[]Value
	var e2 @[]@[]char
	r2, e2 = it.RunFuncTyped("test", "sum", sumArgs)
	if len(e2) > 0 { return fail(e2[0]) }
	var got int = r2[0].AsInt()
	r2[0].Release()
	r[0].Release()
	if got != 42 { return fail("struct param round-trip: sum should be 42") }
	return ""
}
