package "pkg/binate/interp"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// ---- marshaling helpers (pure) ----

func TestIsByAddressType() testing.TestResult {
	if isByAddressType(types.TypInt()) { return fail("int is not by-address") }
	if isByAddressType(types.TypBool()) { return fail("bool is not by-address") }
	if !isByAddressType(types.MakeManagedSliceType(types.TypChar())) {
		return fail("@[]char is by-address")
	}
	return ""
}

func TestMarshalArgsScalarAndAddress() testing.TestResult {
	var params @[]@types.Param = make_slice(@types.Param, 2)
	var p0 @types.Param = make(types.Param)
	p0.Type = types.TypInt()
	var p1 @types.Param = make(types.Param)
	p1.Type = types.MakeManagedSliceType(types.TypChar())
	params[0] = p0
	params[1] = p1
	var s @[]char = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(9)
	args[1] = StringValue(s)
	var slots @[]int = marshalArgs(params, args)
	var ok bool = len(slots) == 2 && slots[0] == 9 && slots[1] == bit_cast(int, &args[1].Bytes[0])
	args[1].Release()
	if !ok { return fail("marshalArgs: scalar value + aggregate address") }
	return ""
}

// ---- end-to-end RunFuncTyped over a self-contained package ----

// strToBytes copies readonly source text into an owned byte buffer for the parser.
func strToBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// loadSelfContained builds an @Interp whose VM holds a single import-free package
// "test" (so no search paths are needed) with the checker retained — enough to
// exercise RunFuncTyped.  CheckPackage (not Check) registers the package scope so
// RunFuncTyped's Checker.PackageType lookup resolves.
func loadSelfContained(src *[]readonly char) @Interp {
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	var noFiles @[]@ast.File
	var noBni @ast.File
	c.CheckPackage("test", file, noFiles, noBni)
	var m @ir.Module = ir.GenModule(c, file)
	var it @Interp = New(1024 * 1024, StandardPackages())
	it.Vm.LowerModule(m)
	it.Checker = c
	return it
}

func TestRunFuncTypedAddScalar() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func add(a int, b int) int { return a + b }\n")
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(20)
	args[1] = IntValue(22)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "add", args)
	if len(errs) > 0 { return fail(errs[0]) }
	if len(results) != 1 { return fail("add should return one result") }
	if results[0].AsInt() != 42 { return fail("add(20, 22) should be 42") }
	results[0].Release()
	return ""
}

// Per-call refcount balance for the all-scalar path (measured on a warmed-up
// second call, so it asserts the per-call marshaling leaks/double-frees nothing).
func TestRunFuncTypedAddRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func add(a int, b int) int { return a + b }\n")
	addScope(it)
	var base int = rt.LiveBlocks()
	addScope(it)
	if rt.LiveBlocks() != base { return fail("add (all-scalar) call did not balance") }
	return ""
}

func addScope(it @Interp) {
	var args @[]Value = make_slice(Value, 2)
	args[0] = IntValue(1)
	args[1] = IntValue(2)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "add", args)
	if len(results) == 1 {
		results[0].Release()
	}
	args[0].Release()
	args[1].Release()
}

// A @[]char argument marshaled by-address and a @[]char result unpacked from the
// retbuf — the aggregate round-trip.
func TestRunFuncTypedEchoString() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(s @[]char) @[]char { return s }\n")
	var arg @[]char = make_slice(char, 2)
	arg[0] = 'h'
	arg[1] = 'i'
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "echo", args)
	if len(errs) > 0 { return fail(errs[0]) }
	if len(results) != 1 { return fail("echo should return one result") }
	var got @[]char = results[0].AsString()
	var ok bool = len(got) == 2 && got[0] == 'h' && got[1] == 'i'
	results[0].Release()
	args[0].Release()
	if !ok { return fail("echo should return its input string") }
	return ""
}

// The aggregate round-trip must not leak or double-free.
func TestRunFuncTypedEchoRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(s @[]char) @[]char { return s }\n")
	echoScope(it)
	var base int = rt.LiveBlocks()
	echoScope(it)
	if rt.LiveBlocks() != base {
		return fail("echo arg/result marshaling did not balance the refcount")
	}
	return ""
}

func echoScope(it @Interp) {
	var arg @[]char = make_slice(char, 4)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "echo", args)
	if len(results) == 1 {
		results[0].Release()
	}
	args[0].Release()
	// `arg`'s own reference is dropped at scope exit; the backing frees then.
}

// A bool argument: false must marshal as false even though its 1-byte image sits
// in a word-sized slot with uninitialized slack — the scalar arg marshals only
// SizeOf bytes, zero-extended (regression for the sub-word full-word-read bug).
func TestRunFuncTypedBoolArg() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func flag(b bool) int { if b { return 1 } else { return 0 } }\n")
	var argsF @[]Value = make_slice(Value, 1)
	argsF[0] = BoolValue(false)
	var rF @[]Value
	var eF @[]@[]char
	rF, eF = it.RunFuncTyped("test", "flag", argsF)
	if len(eF) > 0 { return fail(eF[0]) }
	if rF[0].AsInt() != 0 { return fail("flag(false) should be 0") }
	rF[0].Release()

	var argsT @[]Value = make_slice(Value, 1)
	argsT[0] = BoolValue(true)
	var rT @[]Value
	var eT @[]@[]char
	rT, eT = it.RunFuncTyped("test", "flag", argsT)
	if len(eT) > 0 { return fail(eT[0]) }
	if rT[0].AsInt() != 1 { return fail("flag(true) should be 1") }
	rT[0].Release()
	return ""
}

// structFieldInt reads the int field at index idx from a struct Value's image.
func structFieldInt(v Value, idx int) int {
	var st @types.Type = types.StripWrappers(v.Typ)
	var p *int = bit_cast(*int, bit_cast(int, &v.Bytes[0]) + st.FieldOffset(idx))
	return p[0]
}

// A by-value struct with only scalar fields is now marshaled (SI-1): the retbuf
// image round-trips each field at its offset.
func TestRunFuncTypedAcceptsScalarStruct() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type P struct { a int; b int }\n"
					"func mk() P { var p P; p.a = 5; p.b = 37; return p }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one struct result") }
	if structFieldInt(r[0], 0) != 5 { return fail("P.a should be 5") }
	if structFieldInt(r[0], 1) != 37 { return fail("P.b should be 37") }
	r[0].Release()
	return ""
}

// A struct with a managed (@[]char) field: the image carries the field's +1, and
// releaseImage's struct walk RefDecs it — value round-trips and n reads back.
func TestRunFuncTypedStructReturnValue() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type S struct { name @[]char; n int }\n"
					"func mk(s @[]char) S { var r S; r.name = s; r.n = 7; return r }\n")
	var name @[]char = make_slice(char, 2)
	name[0] = 'o'
	name[1] = 'k'
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one struct") }
	if structFieldInt(r[0], 1) != 7 { return fail("S.n should be 7") }
	var st @types.Type = types.StripWrappers(r[0].Typ)
	var nm *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, bit_cast(int, &r[0].Bytes[0]) +
			st.FieldOffset(0))
	var ok bool = nm.Len == 2
	r[0].Release()
	args[0].Release()
	if !ok { return fail("S.name should carry the 2-char input") }
	return ""
}

// The struct-with-managed-field round-trip must not leak or double-free: exactly
// one RefDec on the returned image's @[]char field.
func TestRunFuncTypedStructReturnRefcountBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type S struct { name @[]char; n int }\n"
					"func mk(s @[]char) S { var r S; r.name = s; r.n = 7; return r }\n")
	structReturnScope(it)
	var base int = rt.LiveBlocks()
	structReturnScope(it)
	if rt.LiveBlocks() != base {
		return fail("struct-with-managed-field result did not balance the refcount")
	}
	return ""
}

func structReturnScope(it @Interp) {
	var name @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
}

// A struct with a managed-pointer (@Node) field is still unsupported (its cross-
// mode dtor handle lands in Stage C SI-5): it must be REJECTED, not admitted and
// leaked — the tightened scalar arm rejects the @Node field.
func TestRunFuncTypedRejectsManagedPtrField() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Node struct { v int }\n"
					"type Holder struct { node @Node; tag int }\n"
					"func mk() Holder { var h Holder; return h }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("a struct with a @Node field should be rejected (Stage C SI-5)") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A managed-slice of a managed-POINTER element (@[]@Node) must be REJECTED: its
// backing frees fine but each element needs its own RefDec, which releaseImage
// does not yet do — admitting it would leak every element.  (Gated on the
// element's NeedsDestruction, not isByAddressType — @Node is not by-address.)
func TestRunFuncTypedRejectsSliceOfManagedPtr() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Node struct { v int }\n"
					"func mk() @[]@Node { var xs @[]@Node; return xs }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("@[]@Node result should be rejected (would leak elements)") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A SMALL (<= one word) anonymous-struct result must be REJECTED, not crash: it
// is classified by-address but returned as a scalar (retbuf size 0), so a
// by-address unpack would read an empty retbuf (index-out-of-bounds).
func TestRunFuncTypedRejectsSmallAnonStructResult() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func mk() struct { a char; b char } { var p struct { a char; b char }; return p }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) == 0 { return fail("small anon-struct result should be rejected, not crash") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// A large (> one word) struct passed as an ARGUMENT round-trips: marshalArgs
// hands it over by-address (matching IsAggregateArg) and the callee reads its
// fields.  mk() builds the struct, sum(P) adds its fields back.
func TestRunFuncTypedStructParamRoundTrip() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type P struct { a int; b int }\n"
					"func mk() P { var p P; p.a = 11; p.b = 31; return p }\n"
					"func sum(p P) int { return p.a + p.b }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	var sumArgs @[]Value = make_slice(Value, 1)
	sumArgs[0] = r[0]
	var r2 @[]Value
	var e2 @[]@[]char
	r2, e2 = it.RunFuncTyped("test", "sum", sumArgs)
	if len(e2) > 0 { return fail(e2[0]) }
	var got int = r2[0].AsInt()
	r2[0].Release()
	r[0].Release()
	if got != 42 { return fail("struct param round-trip: sum should be 42") }
	return ""
}

// A struct whose field is itself a STRUCT holding a managed slice exercises
// releaseImage's two-level struct->struct->managed-slice recursion and the
// cross-level FieldOffset composition (the other struct tests only reach a
// directly-managed field).  Value round-trips and the refcount balances.
func TestRunFuncTypedNestedStructManaged() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Inner struct { name @[]char }\n"
					"type Outer struct { inner Inner; n int }\n"
					"func mk(s @[]char) Outer { var o Outer; o.inner.name = s; o.n = 3; return o }\n")
	var name @[]char = make_slice(char, 2)
	name[0] = 'h'
	name[1] = 'i'
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	// Outer.n is the field after the nested Inner; read it via FieldOffset(1).
	if structFieldInt(r[0], 1) != 3 { return fail("Outer.n should be 3") }
	r[0].Release()
	args[0].Release()
	return ""
}

func TestRunFuncTypedNestedStructManagedBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type Inner struct { name @[]char }\n"
					"type Outer struct { inner Inner; n int }\n"
					"func mk(s @[]char) Outer { var o Outer; o.inner.name = s; o.n = 3; return o }\n")
	nestedStructScope(it)
	var base int = rt.LiveBlocks()
	nestedStructScope(it)
	if rt.LiveBlocks() != base {
		return fail("nested-struct managed field did not balance the refcount")
	}
	return ""
}

func nestedStructScope(it @Interp) {
	var name @[]char = make_slice(char, 4)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(name)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
}

// ---- SI-2: nested managed-slice (@[]@[]char) marshaling ----

var nestedSliceSrc *[]readonly char = "package \"test\"\n"
		"func mk() @[]@[]char {\n"
		"	var xs @[]@[]char = make_slice(@[]char, 2)\n"
		"	xs[0] = make_slice(char, 3)\n"
		"	xs[1] = make_slice(char, 5)\n"
		"	return xs\n"
		"}\n"

// A @[]@[]char result round-trips its outer length and each inner length.
func TestRunFuncTypedNestedSliceValue() testing.TestResult {
	var it @Interp = loadSelfContained(nestedSliceSrc)
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one @[]@[]char") }
	var got @[]@[]char = r[0].AsStringSlice()
	var ok bool = len(got) == 2 && len(got[0]) == 3 && len(got[1]) == 5
	r[0].Release()
	if !ok { return fail("nested-slice structure should round-trip (2; 3, 5)") }
	return ""
}

// Sole-owned @[]@[]char result: Release is the last reference, so releaseImage's
// element loop frees each inner slice then the outer backing.  Balance = base.
func TestRunFuncTypedNestedSliceBalance() testing.TestResult {
	var it @Interp = loadSelfContained(nestedSliceSrc)
	nestedSliceScope(it)
	var base int = rt.LiveBlocks()
	nestedSliceScope(it)
	if rt.LiveBlocks() != base { return fail("@[]@[]char result did not balance") }
	return ""
}

func nestedSliceScope(it @Interp) {
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(r) == 1 {
		r[0].Release()
	}
}

// The last-reference guard, directly: a @[]@[]char arg aliased with the result
// gives the outer backing three owners (xs, arg Value, result Value).  Releasing
// the result is NOT the last reference, so the INNER slices must survive — their
// refcount is unchanged across that Release.  Without the guard the result's
// Release would free the inner backings early, leaving xs/arg dangling (a
// use-after-free a live-block balance check is blind to, since the redundant
// RefDecs on an already-freed block don't move the live count).
func TestRunFuncTypedNestedSliceLastRefGuard() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(x @[]@[]char) @[]@[]char { return x }\n")
	var xs @[]@[]char = make_slice(@[]char, 2)
	xs[0] = make_slice(char, 3)
	xs[1] = make_slice(char, 2)
	var xs0 *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &xs[0])
	var innerRcBefore int = rt.Refcount(xs0.Refptr)

	var args @[]Value = make_slice(Value, 1)
	args[0] = StringSliceValue(xs)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "echo", args)
	if len(e) > 0 { return fail(e[0]) }
	r[0].Release() // NOT the last reference to the outer backing
	var innerRcAfter int = rt.Refcount(xs0.Refptr)
	args[0].Release()
	if innerRcAfter != innerRcBefore {
		return fail("non-last Release freed an inner slice (last-reference guard broken)")
	}
	return ""
}

// The aliased echo must also not leak: the whole nest returns to baseline once
// every owner (xs, arg, result) is released.
func TestRunFuncTypedNestedSliceEchoBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func echo(x @[]@[]char) @[]@[]char { return x }\n")
	nestedEchoScope(it)
	var base int = rt.LiveBlocks()
	nestedEchoScope(it)
	if rt.LiveBlocks() != base {
		return fail("@[]@[]char echo did not balance")
	}
	return ""
}

func nestedEchoScope(it @Interp) {
	var xs @[]@[]char = make_slice(@[]char, 2)
	xs[0] = make_slice(char, 3)
	xs[1] = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringSliceValue(xs)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "echo", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
	// xs (last owner) is dropped at scope exit and frees the whole nest.
}

// A struct field that is a @[]@[]char exercises struct->managed-slice->element
// recursion in releaseImage.  Balance = base.
func TestRunFuncTypedStructOfNestedSliceBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type S struct { rows @[]@[]char; n int }\n"
					"func mk() S {\n"
					"	var s S\n"
					"	s.rows = make_slice(@[]char, 1)\n"
					"	s.rows[0] = make_slice(char, 4)\n"
					"	s.n = 9\n"
					"	return s\n"
					"}\n")
	structOfNestedScope(it)
	var base int = rt.LiveBlocks()
	structOfNestedScope(it)
	if rt.LiveBlocks() != base { return fail("struct of @[]@[]char did not balance") }
	return ""
}

func structOfNestedScope(it @Interp) {
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", noArgs)
	if len(r) == 1 {
		r[0].Release()
	}
}

// ---- SI-3: multi-return tuple split ----

// A (int, @[]char) multi-return: each slot is read from its inline tuple offset,
// the scalar from slot 0 and the managed slice from slot 1.
func TestRunFuncTypedMultiReturnValue() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func split() (int, @[]char) {\n"
					"	var s @[]char = make_slice(char, 2)\n"
					"	s[0] = 'h'\n"
					"	s[1] = 'i'\n"
					"	return 7, s\n"
					"}\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "split", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 2 { return fail("split should return two results") }
	if r[0].AsInt() != 7 { return fail("result 0 should be 7") }
	var s @[]char = r[1].AsString()
	var ok bool = len(s) == 2 && s[0] == 'h' && s[1] == 'i'
	r[0].Release()
	r[1].Release()
	if !ok { return fail("result 1 should be \"hi\"") }
	return ""
}

// A (@[]char, int) multi-return puts the managed slot FIRST (offset 0) and the
// scalar after it — verifying the split reads each slot at its own tuple offset,
// not a fixed order.
func TestRunFuncTypedMultiReturnManagedFirst() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func split() (@[]char, int) {\n"
					"	var s @[]char = make_slice(char, 3)\n"
					"	return s, 42\n"
					"}\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "split", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 2 { return fail("split should return two results") }
	if r[1].AsInt() != 42 { return fail("result 1 should be 42") }
	var slen int = len(r[0].AsString())
	r[0].Release()
	r[1].Release()
	if slen != 3 { return fail("result 0 should be a 3-char slice") }
	return ""
}

// The managed slot of a multi-return arrives +1-owned and Release drops it once.
func TestRunFuncTypedMultiReturnBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func split() (int, @[]char) {\n"
					"	var s @[]char = make_slice(char, 4)\n"
					"	return 1, s\n"
					"}\n")
	multiReturnScope(it)
	var base int = rt.LiveBlocks()
	multiReturnScope(it)
	if rt.LiveBlocks() != base { return fail("multi-return did not balance") }
	return ""
}

func multiReturnScope(it @Interp) {
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "split", noArgs)
	for i := 0; i < len(r); i++ {
		r[i].Release()
	}
}

// A zero-size struct slot (struct{}) is admitted in a multi-return (unlike a
// single result), producing a Value with an empty Bytes image.  Release() must
// not fault on &Bytes[0] of that empty slice — it owns nothing.
func TestRunFuncTypedMultiReturnZeroSizeSlot() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type E struct {}\n"
					"func f() (E, int) { var e E; return e, 5 }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "f", noArgs)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 2 { return fail("f should return two results") }
	if r[1].AsInt() != 5 { return fail("result 1 should be 5") }
	r[0].Release() // zero-size slot: must not fault
	r[1].Release()
	return ""
}

// A multi-return whose retbuf exceeds CallFuncAggregate's 64-byte window must be
// REJECTED, not read past the window: three @[]char slots are 96 bytes.
func TestRunFuncTypedRejectsOversizedTuple() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"func big() (@[]char, @[]char, @[]char) {\n"
					"	var a @[]char = make_slice(char, 1)\n"
					"	var b @[]char = make_slice(char, 1)\n"
					"	var c @[]char = make_slice(char, 1)\n"
					"	return a, b, c\n"
					"}\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "big", noArgs)
	if len(e) == 0 { return fail("a > 64-byte tuple result should be rejected") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// ---- SI-5a: interface-value RESULT marshaling + Release ----

var ifaceResultSrc *[]readonly char = "package \"test\"\n"
		"interface Holder { get() @[]char }\n"
		"type Boxed struct { s @[]char }\n"
		"func (b @Boxed) get() @[]char { return b.s }\n"
		"impl @Boxed : Holder\n"
		"func mk(s @[]char) @Holder { var b @Boxed = make(Boxed); b.s = s; return b }\n"

// A function returning @Holder marshals its result as a 2-word managed interface
// value.
func TestRunFuncTypedIfaceResultShape() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceResultSrc)
	var arg @[]char = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 1 { return fail("mk should return one @Holder") }
	if types.StripWrappers(r[0].Typ).Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return fail("result should be a managed interface value")
	}
	if len(r[0].Bytes) != 2 * cast(int, sizeof(int)) {
		return fail("a managed interface value image should be two words")
	}
	r[0].Release()
	args[0].Release()
	return ""
}

// Releasing the @Holder result runs the receiver (Boxed) dtor through the slot-0
// handle, freeing Boxed.s and the Boxed itself, so the live-block count balances.
func TestRunFuncTypedIfaceResultBalance() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceResultSrc)
	ifaceResultScope(it)
	var base int = rt.LiveBlocks()
	ifaceResultScope(it)
	if rt.LiveBlocks() != base {
		return fail("iface result did not balance (dtor didn't run?)")
	}
	return ""
}

func ifaceResultScope(it @Interp) {
	var arg @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
}

// An interface value as a PARAM stays rejected (move-model / needs reverse vtable
// translation that does not exist), even though it is now admitted as a result.
func TestRunFuncTypedRejectsIfaceParam() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"interface Holder { get() int }\n"
					"type Boxed struct { n int }\n"
					"func (b @Boxed) get() int { return b.n }\n"
					"impl @Boxed : Holder\n"
					"func take(h @Holder) int { return h.get() }\n")
	var noArgs @[]Value
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "take", noArgs)
	if len(e) == 0 { return fail("an interface param should be rejected (Stage C)") }
	if len(r) != 0 { return fail("a rejected call should return no results") }
	return ""
}

// The motivating shape: a multi-return whose slot is an interface value — the
// (T, @Error) case.  Slot 0 (int) reads inline; slot 1 (@Holder) is the iface.
var ifaceMultiSrc *[]readonly char = "package \"test\"\n"
		"interface Holder { get() @[]char }\n"
		"type Boxed struct { s @[]char }\n"
		"func (b @Boxed) get() @[]char { return b.s }\n"
		"impl @Boxed : Holder\n"
		"func mk2(s @[]char) (int, @Holder) {\n"
		"	var b @Boxed = make(Boxed)\n"
		"	b.s = s\n"
		"	return 7, b\n"
		"}\n"

func TestRunFuncTypedIfaceMultiReturnValue() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMultiSrc)
	var arg @[]char = make_slice(char, 2)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk2", args)
	if len(e) > 0 { return fail(e[0]) }
	if len(r) != 2 { return fail("mk2 should return two results") }
	if r[0].AsInt() != 7 { return fail("result 0 should be 7") }
	if types.StripWrappers(r[1].Typ).Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return fail("result 1 should be a managed interface value")
	}
	r[0].Release()
	r[1].Release()
	args[0].Release()
	return ""
}

func TestRunFuncTypedIfaceMultiReturnBalance() testing.TestResult {
	var it @Interp = loadSelfContained(ifaceMultiSrc)
	ifaceMultiScope(it)
	var base int = rt.LiveBlocks()
	ifaceMultiScope(it)
	if rt.LiveBlocks() != base { return fail("(int, @Holder) did not balance") }
	return ""
}

func ifaceMultiScope(it @Interp) {
	var arg @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk2", args)
	for i := 0; i < len(r); i++ {
		r[i].Release()
	}
	args[0].Release()
}

// A by-value struct with an interface FIELD exercises releaseImage's
// struct->interface recursion (SI-4 substitutes the nested-struct iface word).
func TestRunFuncTypedStructOfIfaceBalance() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"interface Holder { get() @[]char }\n"
					"type Boxed struct { s @[]char }\n"
					"func (b @Boxed) get() @[]char { return b.s }\n"
					"impl @Boxed : Holder\n"
					"type Wrap struct { h @Holder; n int }\n"
					"func mk3(s @[]char) Wrap {\n"
					"	var w Wrap\n"
					"	var b @Boxed = make(Boxed)\n"
					"	b.s = s\n"
					"	w.h = b\n"
					"	w.n = 4\n"
					"	return w\n"
					"}\n")
	structOfIfaceScope(it)
	var base int = rt.LiveBlocks()
	structOfIfaceScope(it)
	if rt.LiveBlocks() != base { return fail("struct with an @Holder field did not balance") }
	return ""
}

func structOfIfaceScope(it @Interp) {
	var arg @[]char = make_slice(char, 3)
	var args @[]Value = make_slice(Value, 1)
	args[0] = StringValue(arg)
	var r @[]Value
	var e @[]@[]char
	r, e = it.RunFuncTyped("test", "mk3", args)
	if len(r) == 1 {
		r[0].Release()
	}
	args[0].Release()
}
