package "pkg/binate/interp"

import "pkg/binate/types"
import "pkg/builtins/testing"

// A zero-size struct argument takes its dispatch slot like any other aggregate (docs/abi
// 03 §3.3), with no bytes behind it: RunFuncTyped passes it, and the argument after it
// reads back right.
func TestRunFuncTypedZeroSizeArg() testing.TestResult {
	var it @Interp = loadSelfContained(
			"package \"test\"\n"
					"type E struct { }\n"
					"func f(a int, e E, b int) int { return a * 100 + b }\n")
	var noFields @[]@types.Field
	var z Value
	z.Typ = types.MakeStructType("E", noFields)
	z.Bytes = make_slice(uint8, 0)
	var args @[]Value = make_slice(Value, 3)
	args[0] = IntValue(7)
	args[1] = z
	args[2] = IntValue(9)
	var results @[]Value
	var errs @[]@[]char
	results, errs = it.RunFuncTyped("test", "f", args)
	if len(errs) > 0 { return fail(errs[0]) }
	if len(results) != 1 { return fail("f should return one result") }
	if results[0].AsInt() != 709 { return fail("f(7, E{}, 9) should be 709") }
	results[0].Release()
	return ""
}
