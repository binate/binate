package "pkg/binate/interp"

import "pkg/binate/ast"

// Small generic helpers used by the interp machinery (import registration,
// extern setup, typecheck).  Independent copies of the same trivial utilities
// the cmd/bni CLI shell keeps for its own argv/test-discovery code — the
// substantive load/compile/lower machinery lives only here, but a 5-line
// string/slice helper is not worth cross-package coupling.

// streq compares two char slices for byte-equality.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// appendCharSlice appends one @[]char to a managed slice of them.
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendFilePtr appends an AST file pointer to a managed slice.
func appendFilePtr(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImportSpec appends an import spec to a managed slice.
func appendImportSpec(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
