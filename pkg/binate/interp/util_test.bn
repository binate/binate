package "pkg/binate/interp"

import "pkg/builtins/testing"

// TestStreq pins the byte-equality helper (length-mismatch and content paths).
func TestStreq() testing.TestResult {
	if !streq("abc", "abc") { return fail("equal slices should be streq") }
	if streq("abc", "abd") { return fail("differing content should not be streq") }
	if streq("ab", "abc") { return fail("different lengths should not be streq") }
	if !streq("", "") { return fail("two empty slices should be streq") }
	return ""
}

// TestAppendCharSlice pins the @[]@[]char append helper (grows by one, preserves
// order, copies the prior entries).
func TestAppendCharSlice() testing.TestResult {
	var s @[]@[]char
	s = appendCharSlice(s, "a")
	s = appendCharSlice(s, "bb")
	if len(s) != 2 { return fail("expected 2 entries after two appends") }
	if !seq(s[0], "a") { return fail("entry 0 should be a") }
	if !seq(s[1], "bb") { return fail("entry 1 should be bb") }
	return ""
}
