package "pkg/binate/interp"

import "pkg/binate/types"
import "pkg/builtins/rt"

// The Value struct (a host-side box for one marshaled value across the interp's
// compiled-host <-> bytecode-VM boundary) is defined in interp.bni — external
// consumers need its layout to hold @[]Value by value.  Marshaling is a pure
// refcount problem, not a representation one: rt is one shared native instance,
// so a Value's bytes ARE the VM's bytes.

// IntValue boxes a host-word int.
func IntValue(n int) Value {
	var v Value
	v.Typ = types.TypInt()
	v.Bytes = make_slice(uint8, v.Typ.SizeOf())
	var p *int = bit_cast(*int, &v.Bytes[0])
	p[0] = n
	return v
}

// Int64Value boxes an int64 (8 bytes on every target).
func Int64Value(n int64) Value {
	var v Value
	v.Typ = types.TypInt64()
	v.Bytes = make_slice(uint8, 8)
	var p *int64 = bit_cast(*int64, &v.Bytes[0])
	p[0] = n
	return v
}

// BoolValue boxes a bool as one byte (0/1).
func BoolValue(b bool) Value {
	var v Value
	v.Typ = types.TypBool()
	v.Bytes = make_slice(uint8, 1)
	if b {
		v.Bytes[0] = 1
	} else {
		v.Bytes[0] = 0
	}
	return v
}

// copyManagedSliceHeader copies the 4-word managed-slice header from src to dst
// and takes an owned +1 on the (now shared) backing, so dst is a valid managed
// slice independent of src.  The single primitive behind boxing a managed-slice
// as a Value and reconstructing one from a Value.
func copyManagedSliceHeader(dst *rt.ManagedSlice, src *rt.ManagedSlice) {
	dst.Data = src.Data
	dst.Len = src.Len
	dst.Refptr = src.Refptr
	dst.BackingLen = src.BackingLen
	if dst.Refptr != nil {
		rt.RefInc(dst.Refptr)
	}
}

// managedSliceValue boxes a managed-slice value of type typ whose 4-word header
// is at src, taking an OWNED +1 on the backing so the Value is independent of the
// source slice (the callee's entry-RefInc / exit-RefDec on a param is then
// net-zero over this owned reference).  For a nested slice (@[]@[]char) the inner
// elements are owned by the shared backing — releaseImage frees them only when
// this is the last reference (its last-reference guard).  Release() drops the ref.
func managedSliceValue(typ @types.Type, src *rt.ManagedSlice) Value {
	var v Value
	v.Typ = typ
	v.Bytes = make_slice(uint8, typ.SizeOf())
	copyManagedSliceHeader(bit_cast(*rt.ManagedSlice, &v.Bytes[0]), src)
	return v
}

// StringValue boxes a @[]char argument.
func StringValue(s @[]char) Value {
	return managedSliceValue(types.MakeManagedSliceType(types.TypChar()),
			bit_cast(*rt.ManagedSlice, &s))
}

// StringSliceValue boxes a @[]@[]char argument (a managed-slice of managed
// slices).  Only the outer backing is +1'd; the inner slices ride it.
func StringSliceValue(s @[]@[]char) Value {
	return managedSliceValue(types.MakeManagedSliceType(types.MakeManagedSliceType(types.TypChar())),
			bit_cast(*rt.ManagedSlice, &s))
}

// AsInt reads a host-word int result/value.
func (v Value) AsInt() int {
	var p *int = bit_cast(*int, &v.Bytes[0])
	return p[0]
}

// AsInt64 reads an int64 result/value.
func (v Value) AsInt64() int64 {
	var p *int64 = bit_cast(*int64, &v.Bytes[0])
	return p[0]
}

// AsBool reads a bool result/value.
func (v Value) AsBool() bool {
	return v.Bytes[0] != 0
}

// AsString reconstructs a @[]char sharing the Value's backing, taking a +1 on it
// so the returned slice owns its own reference (the Value keeps its own — the
// two are released independently).  Valid only for a managed-slice Value.
func (v Value) AsString() @[]char {
	var result @[]char
	copyManagedSliceHeader(bit_cast(*rt.ManagedSlice, &result),
			bit_cast(*rt.ManagedSlice, &v.Bytes[0]))
	return result
}

// AsStringSlice reconstructs a @[]@[]char sharing the Value's backing (a +1 on
// the outer backing).  Valid only for a @[]@[]char Value.
func (v Value) AsStringSlice() @[]@[]char {
	var result @[]@[]char
	copyManagedSliceHeader(bit_cast(*rt.ManagedSlice, &result),
			bit_cast(*rt.ManagedSlice, &v.Bytes[0]))
	return result
}

// Release drops the managed references this Value owns.  Call exactly once per
// Value produced by a constructor or RunFuncTyped, after the last use — a second
// Release double-frees.  A no-op for scalar (int/bool) Values.
func (v Value) Release() {
	if v.Typ == nil {
		return
	}
	if len(v.Bytes) == 0 {
		// A zero-size image (e.g. a struct{} multi-return slot) owns nothing, and
		// &v.Bytes[0] would fault the bounds check — nothing to release.
		return
	}
	releaseImage(v.Typ, &v.Bytes[0])
}

// releaseImage RefDecs every managed reference in the value image of type t at
// ptr, exactly once each — the host-side mirror of the compiler's struct /
// managed-slice / interface destructors (gen_dtor_emit_bodies.bn,
// emitManagedIfaceValueRefDec).  It NEVER RefIncs: a marshaled result arrives with
// each managed reference already +1-owned by the host (the callee transferred
// ownership into the returned image), so Release is the sole drop.  Only shapes
// the marshal predicate admits reach here, which keeps this walk total: a
// non-managed field bottoms out via NeedsDestruction, a managed-slice recurses
// into its elements (last-reference-guarded), a struct field recurses, and a
// managed interface value RefDecs its data through the slot-0 dtor handle.
// (Managed-pointer and func-value references are still rejected by the predicate —
// their per-element dtor is a cross-mode handle releaseImage does not yet fetch;
// an iface as a managed-slice ELEMENT is likewise rejected, since SI-4 does not
// substitute slice-backing vtable words.)
func releaseImage(t @types.Type, ptr *uint8) {
	var st @types.Type = types.StripWrappers(t)
	if !st.NeedsDestruction() {
		return
	}
	if st.Kind == types.TYP_MANAGED_SLICE {
		var ms *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, ptr)
		if ms.Refptr == nil {
			return
		}
		// If the element itself owns managed references (@[]@[]char, @[]struct{…}),
		// free them — but ONLY when this is the last reference to the backing
		// (Refcount == 1), mirroring the compiler's genManagedSliceDtor isLast
		// guard: another owner still needs the elements otherwise.  Iterate the
		// BACKING (Refptr), not Data — a subslice's Data points into the middle of
		// the backing, while the dtor must visit every allocated element.
		var elem @types.Type = types.StripWrappers(st.Elem)
		if elem.NeedsDestruction() && rt.Refcount(ms.Refptr) == 1 {
			var stride int = elem.SizeOf()
			for i := 0; i < ms.BackingLen; i++ {
				var ep *uint8 = bit_cast(*uint8, bit_cast(int, ms.Refptr) + i * stride)
				releaseImage(elem, ep)
			}
		}
		var noDtor *uint8
		rt.RefDec(ms.Refptr, noDtor) // backing freed here iff its refcount hits 0
		return
	}
	if st.Kind == types.TYP_STRUCT {
		for i := 0; i < len(st.Fields); i++ {
			var ft @types.Type = st.Fields[i].Type
			if !ft.NeedsDestruction() {
				continue
			}
			var fptr *uint8 = bit_cast(*uint8, bit_cast(int, ptr) + st.FieldOffset(i))
			releaseImage(ft, fptr)
		}
		return
	}
	if st.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		// A managed interface value {data, vtable}: RefDec the DATA word (index 0),
		// running the receiver dtor fetched from vtable slot 0 — the host-side
		// mirror of the compiler's emitManagedIfaceValueRefDec.  SI-4 substituted
		// that vtable word to a native handle-vtable, so slot 0 is a func-value
		// dtor handle; rt.RefDec invokes it (via _call_dtor -> OP_CALL_HANDLE) when
		// the refcount hits zero — freeing the receiver's own managed fields — then
		// frees the data.  An empty iface (null data) is a no-op, guarded on data
		// first exactly like the compiler (else it would deref a null vtable).
		var words *int = bit_cast(*int, ptr)
		var dataPtr int = words[types.IfaceValueDataIndex()]
		if dataPtr == 0 {
			return
		}
		var vtword int = words[types.IfaceValueVtableIndex()]
		var dtorHandle *uint8
		if vtword != 0 {
			dtorHandle = bit_cast(*uint8, bit_cast(*int, vtword)[0])
		}
		rt.RefDec(bit_cast(*uint8, dataPtr), dtorHandle)
		return
	}
}
