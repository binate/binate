package "pkg/binate/interp"

import "pkg/binate/types"
import "pkg/builtins/rt"

// The Value struct (a host-side box for one marshaled value across the interp's
// compiled-host <-> bytecode-VM boundary) is defined in interp.bni — external
// consumers need its layout to hold @[]Value by value.  Marshaling is a pure
// refcount problem, not a representation one: rt is one shared native instance,
// so a Value's bytes ARE the VM's bytes.

// IntValue boxes a host-word int.
func IntValue(n int) Value {
	var v Value
	v.Typ = types.TypInt()
	v.Bytes = make_slice(uint8, v.Typ.SizeOf())
	var p *int = bit_cast(*int, &v.Bytes[0])
	p[0] = n
	return v
}

// Int64Value boxes an int64 (8 bytes on every target).
func Int64Value(n int64) Value {
	var v Value
	v.Typ = types.TypInt64()
	v.Bytes = make_slice(uint8, 8)
	var p *int64 = bit_cast(*int64, &v.Bytes[0])
	p[0] = n
	return v
}

// BoolValue boxes a bool as one byte (0/1).
func BoolValue(b bool) Value {
	var v Value
	v.Typ = types.TypBool()
	v.Bytes = make_slice(uint8, 1)
	if b {
		v.Bytes[0] = 1
	} else {
		v.Bytes[0] = 0
	}
	return v
}

// StringValue boxes a @[]char argument, taking an OWNED +1 on its backing so the
// Value's 4-word image is a valid managed slice independent of the caller's `s`
// (the callee's entry-RefInc / exit-RefDec on the param is then net-zero over
// this owned reference — the backing can't be freed out from under the Value
// during the call).  Release() drops the reference.
func StringValue(s @[]char) Value {
	var v Value
	v.Typ = types.MakeManagedSliceType(types.TypChar())
	v.Bytes = make_slice(uint8, v.Typ.SizeOf())
	var src *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &s)
	var dst *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &v.Bytes[0])
	dst.Data = src.Data
	dst.Len = src.Len
	dst.Refptr = src.Refptr
	dst.BackingLen = src.BackingLen
	if dst.Refptr != nil {
		rt.RefInc(dst.Refptr)
	}
	return v
}

// AsInt reads a host-word int result/value.
func (v Value) AsInt() int {
	var p *int = bit_cast(*int, &v.Bytes[0])
	return p[0]
}

// AsInt64 reads an int64 result/value.
func (v Value) AsInt64() int64 {
	var p *int64 = bit_cast(*int64, &v.Bytes[0])
	return p[0]
}

// AsBool reads a bool result/value.
func (v Value) AsBool() bool {
	return v.Bytes[0] != 0
}

// AsString reconstructs a @[]char sharing the Value's backing, taking a +1 on it
// so the returned slice owns its own reference (the Value keeps its own — the
// two are released independently).  Valid only for a managed-slice Value.
func (v Value) AsString() @[]char {
	var result @[]char
	var src *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &v.Bytes[0])
	var dst *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &result)
	dst.Data = src.Data
	dst.Len = src.Len
	dst.Refptr = src.Refptr
	dst.BackingLen = src.BackingLen
	if dst.Refptr != nil {
		rt.RefInc(dst.Refptr)
	}
	return result
}

// Release drops the managed references this Value owns.  Call exactly once per
// Value produced by a constructor or RunFuncTyped, after the last use — a second
// Release double-frees.  A no-op for scalar (int/bool) Values.  Today it handles
// managed slices (@[]char); struct / @[]@[]char element recursion lands with the
// Stage-C aggregate marshaling.
func (v Value) Release() {
	if v.Typ == nil {
		return
	}
	if v.Typ.Kind == types.TYP_MANAGED_SLICE {
		var ms *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &v.Bytes[0])
		if ms.Refptr != nil {
			var noDtor *uint8
			rt.RefDec(ms.Refptr, noDtor)
		}
	}
}
