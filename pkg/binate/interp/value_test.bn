package "pkg/binate/interp"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// ---- Value round-trips (pure — no VM) ----

func TestIntValueRoundTrip() testing.TestResult {
	if IntValue(42).AsInt() != 42 { return fail("IntValue(42).AsInt() should be 42") }
	if IntValue(-7).AsInt() != -7 { return fail("IntValue(-7).AsInt() should be -7") }
	return ""
}

func TestInt64ValueRoundTrip() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40)
	if Int64Value(big).AsInt64() != big { return fail("Int64Value round-trip") }
	return ""
}

func TestBoolValueRoundTrip() testing.TestResult {
	if !BoolValue(true).AsBool() { return fail("BoolValue(true) should be true") }
	if BoolValue(false).AsBool() { return fail("BoolValue(false) should be false") }
	return ""
}

func TestStringValueRoundTrip() testing.TestResult {
	var s @[]char = make_slice(char, 3)
	s[0] = 'a'
	s[1] = 'b'
	s[2] = 'c'
	var v Value = StringValue(s)
	var got @[]char = v.AsString()
	var ok bool = len(got) == 3 && got[0] == 'a' && got[1] == 'b' && got[2] == 'c'
	v.Release()
	if !ok { return fail("StringValue/AsString should preserve the bytes") }
	return ""
}

// StringValue takes +1, Release drops it: a scope that boxes an owned @[]char and
// releases the box returns the live-allocation count to baseline — neither a leak
// (rc stuck high) nor a double-free (which trips RefDec's at-zero abort).
func TestStringValueRefcountBalance() testing.TestResult {
	var base int = rt.LiveBlocks()
	stringValueScope()
	if rt.LiveBlocks() != base {
		return fail("StringValue + Release did not balance the backing refcount")
	}
	return ""
}

func stringValueScope() {
	var s @[]char = make_slice(char, 5)
	var v Value = StringValue(s)
	v.Release()
	// s's own reference is dropped at scope exit; the backing frees then.
}

// A @[]Value (managed slice of a struct with a managed Bytes field) frees its
// elements' Bytes on scope exit, and a single local Value frees its Bytes.
func TestValueSliceElementFree() testing.TestResult {
	var base int = rt.LiveBlocks()
	valueSliceScope()
	if rt.LiveBlocks() != base { return fail("@[]Value did not free element Bytes") }
	return ""
}

func valueSliceScope() {
	var vs @[]Value = make_slice(Value, 2)
	vs[0] = IntValue(1)
	vs[1] = IntValue(2)
}

func TestSingleValueFree() testing.TestResult {
	var base int = rt.LiveBlocks()
	singleValueScope()
	if rt.LiveBlocks() != base { return fail("local Value did not free its Bytes") }
	return ""
}

func singleValueScope() {
	var v Value = IntValue(7)
	if v.AsInt() != 7 { return }
}
