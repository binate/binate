package "pkg/binate/interp"

import "pkg/builtins/reflect"

// FuncOverride (the per-function replacement descriptor) is defined in interp.bni.
// Replacement is the embedder's own function's FunctionInfo, obtained from its
// package's `__Package().Functions` table — where the compiler emitted the
// callable `Value` handle and the VM-dispatch metadata (RetbufSize / ParamSlots /
// Sig).  Replacement.Name is ignored; WrapPackage rebinds it under TargetName.

// WrappedPackage owns a runtime-built `@reflect.Package` descriptor and the
// managed backing its raw-slice `Functions` view borrows.  The compiler emits
// every package's descriptor as immortal static data with rodata-backed tables;
// a host overriding selected functions must build the `Functions` table at
// runtime instead, and `@reflect.Package` (all raw-slice fields) owns none of its
// table backings — so this struct holds the new table alive for the descriptor's
// life.
//
// LIFETIME: keep the WrappedPackage alive across every `New(...)` call that
// consumes its descriptor.  `New` copies each binding out during injection
// (vm.RegisterExtern copies the name + handle), so the WrappedPackage may be
// dropped once the last consuming `New` has returned — it need not outlive the
// resulting `@Interp`.  Do NOT write `set[i] = interp.WrapPackage(...).Package()`:
// the temporary WrappedPackage would be freed at the end of that statement,
// leaving the descriptor's borrowed `Functions` view dangling before `New` reads
// it.  Bind the WrappedPackage to a named local first.
type WrappedPackage struct {
	// Pkg is the wrapped descriptor; place it in a New inject-set (in the base
	// package's slot).  Consumers read it through Package().
	Pkg @reflect.Package
	// funcs owns the backing Pkg.Functions borrows (a mix of the base package's
	// immortal FunctionInfo nodes and the runtime-built override nodes).
	funcs @[]@reflect.FunctionInfo
}

// Package returns the wrapped descriptor to place in a New inject-set (in the
// base package's slot).  KEEP the WrappedPackage alive across every New that
// consumes it — see the WrappedPackage lifetime note.
func (w @WrappedPackage) Package() @reflect.Package {
	return w.Pkg
}

// WrapPackage returns a copy of `base` whose `Functions` table has each entry
// whose fully-qualified name matches a `FuncOverride.TargetName` replaced by that
// override's callable value + dispatch metadata (rebound under the target name),
// leaving `Globals` / `Vtables` / `SatEntries` shared with `base` (they point at
// base's immortal static tables).  Injecting the result (via New) therefore binds
// the target names to the replacements while every other function, global, and
// vtable resolves exactly as the base package's.
//
// An override whose TargetName matches no `base` function is a programmer error
// (the host named a function the package does not export, e.g. a typo) and
// panics, rather than silently leaving the base binding in place — which would be
// a subtle "my override did nothing" bug.
func WrapPackage(base @reflect.Package, overrides @[]FuncOverride) @WrappedPackage {
	var baseFns *[]@reflect.FunctionInfo = base.Functions
	var n int = len(baseFns)
	var funcs @[]@reflect.FunctionInfo = make_slice(@reflect.FunctionInfo, n)
	// used[oi] records that overrides[oi] matched a base function; any that did
	// not is a bad TargetName (checked after the walk).
	var used @[]bool = make_slice(bool, len(overrides))
	for i := 0; i < n; i++ {
		var fi @reflect.FunctionInfo = baseFns[i]
		var oi int = findOverride(overrides, fi.Name)
		if oi >= 0 {
			funcs[i] = overrideInfo(fi.Name, overrides[oi].Replacement)
			used[oi] = true
		} else {
			funcs[i] = fi
		}
	}
	for oi := 0; oi < len(overrides); oi++ {
		if !used[oi] {
			// Unmatched: either the name is not an exported function of base, or an
			// earlier override already claimed it (a duplicate TargetName) — both
			// leave this one never applied, and both are programmer errors.
			panic(
					"interp.WrapPackage: an override's TargetName names no unique "
							"exported function of the base package (unknown name, or a "
							"duplicate of another override's TargetName)")
		}
	}
	var w @WrappedPackage = make(WrappedPackage)
	w.funcs = funcs
	var pkg @reflect.Package = make(reflect.Package)
	pkg.Name = base.Name
	// The raw Functions view borrows funcs' first two words; w.funcs holds the
	// managed backing alive for the descriptor's life (see the lifetime note).
	// bnlint:allow managed-to-raw-assign - w.funcs owns funcs; it outlives the borrow
	pkg.Functions = funcs
	pkg.Globals = base.Globals
	pkg.Vtables = base.Vtables
	pkg.SatEntries = base.SatEntries
	w.Pkg = pkg
	return w
}

// findOverride returns the index in overrides whose TargetName equals name, or -1.
func findOverride(overrides @[]FuncOverride, name *[]readonly char) int {
	for i := 0; i < len(overrides); i++ {
		if streq(overrides[i].TargetName, name) {
			return i
		}
	}
	return -1
}

// overrideInfo builds a FunctionInfo that binds `name` (the target function's
// fully-qualified name, so RegisterExtern rebinds THAT name) to the replacement's
// callable value and VM-dispatch metadata.  Pkg is left nil — the descriptor
// readers (vm.RegisterPackage*) ignore FunctionInfo.Pkg.
func overrideInfo(name *[]readonly char, repl @reflect.FunctionInfo) @reflect.FunctionInfo {
	var fi @reflect.FunctionInfo = make(reflect.FunctionInfo)
	fi.Name = name
	fi.Value = repl.Value
	fi.RetbufSize = repl.RetbufSize
	fi.ParamSlots = repl.ParamSlots
	fi.Sig = repl.Sig
	return fi
}
