// Package ir defines the intermediate representation (IR) used between parsing
// and code generation. It provides SSA-form instructions, basic blocks, functions,
// and modules, along with an IR generator that lowers ASTs to IR.
package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/irdata"
import "pkg/binate/irsym"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/strings"
import "pkg/std/table"
import "pkg/std/vec"

// ============================================================
// IR Data Structures
// ============================================================

// Module is one compilation's IR — its functions, signatures, globals, type
// descriptors, collected strings, and impl/vtable info — plus the FuncSigIndex
// name→FuncSigs map.  Created only via NewModule.
type Module struct {
	Name @[]char
	// PkgPath is this module's package path (e.g. "pkg/geom"), used to
	// qualify bare same-package names.  It is the module-scoped home for
	// what was the ir.currentModulePkgPath package-global — set by the gen
	// entry points (GeneratePackage / GenModule).  Empty before gen and for
	// the universe/synthetic case.  Per-module so two compilations don't
	// share it.
	PkgPath @[]char
	// Funcs is the module's function list and the view every consumer reads.  It
	// is a live sub-slice view of FuncsVec's backing (FuncsVec.Items()), which
	// AddFunc refreshes after each Push so it always reflects the current
	// functions and len(Funcs) is the live count; Funcs and FuncsVec share
	// backing, so mutating an element through either is visible in both.
	Funcs @[]@Func
	// FuncsVec is the gen-time builder behind Funcs: AddFunc Pushes onto it
	// (amortized O(1)) rather than reallocating Funcs on every append -- a
	// grow-by-one slices.Append reallocates and copies the whole slice each call,
	// so building the table (a self-hosting compile registers thousands of funcs
	// one at a time) was O(n^2) in allocations + copies, a top driver of bni load
	// time.  AddFunc is the single writer; consumers read the Funcs view.  Seeded
	// by NewModule.
	FuncsVec @vec.Vec[@Func]
	Globals  @[]@Global
	Types    @[]@irdata.TypeDef
	Strings  @[]StringConst // collected string constants (populated by FinalizeStrings)
	Impls    @[]@irdata.ImplInfo // per-(impl, interface) vtable info — local impls
	// declared in this TU (Slice 2.3a-1). Codegen
	// emits a vtable global for each.
	// ImportedImpls: impls declared in imported packages, registered so
	// IR-gen's vtable-name lookup at use sites in this TU resolves
	// across package boundaries. Codegen does NOT emit vtables for these — the
	// owning TU's compile already emits them with weak_odr linkage,
	// and the linker resolves the cross-TU reference.
	ImportedImpls @[]@irdata.ImplInfo
	// TypeInfos is this module's per-TYPE RTTI registry: one TypeInfoEntry per
	// boxable concrete type (a type with ≥1 local impl), deduped by
	// TypeInfoName symbol.  It is the single per-type home for the content of
	// each `__typeinfo.<T>` record (size/align/name/dtor) — CollectTypeInfoDescs
	// iterates THIS (not m.Impls), so those per-type facts live in one per-type
	// place instead of redundantly on every (type,iface) ImplInfo row ("design
	// D").  Populated by registerTypeInfo alongside local ImplInfo creation.
	TypeInfos @[]@irdata.TypeInfoEntry
	// PackageAccessorSig: the func-value type of this module's
	// compiler-synthesized `__Package() @reflect.Package` accessor,
	// stashed by IR-gen (registerCurrentModulePackageAccessor) so the
	// backends can self-list __Package in the per-package reflect
	// Functions table without re-deriving the reflect.Package type
	// (which lives in the type checker, unavailable to the backends).
	// Both backends read this one object, so the __Package FunctionInfo
	// entry's Sig / RetbufSize are identical by construction.  nil when
	// the reflect type was not loaded for this compilation (then no
	// self-entry is emitted).
	PackageAccessorSig @types.Type
	// Checker is the type-Checker that produced this module's typed AST.
	// IR-gen consults it for per-expression resolved types
	// (Checker.ExprType(id)), pending-decl checks, and the reflect package
	// type.  Per-module (was the ir.currentChecker package-global) so two
	// compilations in one process don't share checker state — set by the
	// gen entry points (GeneratePackage / GenModule / the REPL GenDecl path)
	// and copied onto each GenContext.  Nil-safe: IR-gen falls back to the
	// legacy parseIntLit path when nil (test helpers that skip type-check).
	Checker @types.Checker
	// OptLevel is the IR optimization level this compilation will run
	// (`iropt.RunOptPasses(mod, OptLevel)`), mirrored from the driving GenCtx by
	// GeneratePackage so context-light cleanup emitters that only have @Func
	// (emitManagedSliceRefDec and friends) can gate the SROA-forwardable cleanup
	// reshape at OptLevel >= 1 the same way emitManagedStructPtrDtor gates on
	// GenCtx.OptLevel.  Defaults to 0 (the GenModule / test / REPL paths never set
	// a nonzero level), so those keep the -O0 by-address cleanup shape.
	OptLevel int
	// Consts / Structs / FuncSigs / GlobalVars / TypeAliases are this
	// module's IR-gen lookup tables — the module-scoped home for what were
	// the ir.moduleConsts / moduleStructs / moduleFuncs / moduleGlobals /
	// moduleTypeAliases package-globals.  They accumulate across the
	// RegisterImport → GeneratePackage → dtor/copy-gen sequence (all of
	// which share this @Module), and stay distinct from the IR-OUTPUT
	// Funcs / Globals / Types fields above (those hold emitted IR; these
	// hold gen-time signatures/layouts consulted while emitting it).
	// Per-module so two compilations in one process don't share gen state.
	Consts  @[]irsym.ModuleConst
	Structs @[]irsym.ModuleStruct
	// FuncSigs accumulates every function signature seen while generating this
	// module (locals, methods, imported externs, generic instantiations,
	// func-literals).  A vec.Vec (amortized doubling) rather than a raw slice
	// rebuilt per append: IR-gen registers thousands of sigs one at a time, so
	// `slices.Append` (which reallocates and copies the whole slice every call)
	// made building the table O(n^2) in allocations + copies — a top driver of
	// bni's load-time allocation.  registerFuncSig is the single writer.
	FuncSigs @vec.Vec[irdata.FuncSig]
	// FuncSigIndex is a name→FuncSigs-index map so the lookupFunc* /
	// funcSigRegistered / setOrAppendFuncSig paths are O(1) instead of O(n) streq
	// scans (the IR-gen callee-sig lookups were O(n²) over the whole loaded
	// program).  Every FuncSigs append funnels through registerFuncSig, which keeps
	// the index in lockstep and keeps the FIRST index for a duplicate Name
	// (matching the prior first-match scan).  Keyed by *[]readonly char borrowing
	// each sig's Name, whose char backing the FuncSigs vec keeps alive.  Seeded by
	// NewModule.
	FuncSigIndex @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]
	GlobalVars   @[]irsym.ModuleGlobal
	TypeAliases  @[]irsym.ModuleTypeAlias
	// ImportAliasNames / ImportAliasPaths are this module's import-alias
	// map — parallel arrays mapping a source-level alias short-name to the
	// full package path.  resolveImportPkg consults them to expand an alias
	// to the full-path mangling form; RecordImportPath / pushFileImports
	// populate them.  Module-scoped home for what were the
	// ir.importAliasNames / importAliasPaths package-globals, so two
	// compilations in one process don't share alias state.
	ImportAliasNames @[]@[]char
	ImportAliasPaths @[]@[]char
	// CurrentImportAlias is the import alias whose declarations are
	// currently being registered, or whose monomorphized generic body is
	// being emitted — set and restored around the import-registration and
	// generic-instantiation passes so an unqualified name resolves under
	// the defining package.  Module-scoped home for the
	// ir.currentImportAlias package-global.
	CurrentImportAlias @[]char
	// Interfaces is this module's interface registry (seeded with universe
	// `any` at NewModule; accumulates this module's own + imported interfaces
	// during gen).  Module-scoped home for the ir.moduleInterfaces
	// package-global, so two compilations don't share interface state.
	// Read by the dispatch / vtable-layout
	// helpers and the exported Iface* queries the VM consults.
	Interfaces @[]irsym.ModuleInterface
	// MethodValueWrappers holds the qualified names of the synthesized
	// `T.M`-method-value wrapper Funcs emitted for this module, for dedup
	// across multiple uses of the same selector form.  Module-scoped home for
	// the ir.methodValueWrappers package-global — per-module so a REPL
	// mid-session import's GeneratePackage no
	// longer wipes the session module's synthesized wrappers.
	MethodValueWrappers @[]@[]char
	// PendingMsDtors / PendingStructDtors are the IR-gen work-lists of
	// managed-slice and struct/array types discovered needing dtors (and, for
	// structs/arrays, copies) during this module's function-body emission —
	// drained after body-gen by generateNonStructDtors / generateCopies (file
	// load) or EnsureReplBodyHelpers (REPL).  PendingMsDtorNames /
	// PendingStructDtorNames are the precomputed dtor-name lists kept parallel
	// to them, giving registerPendingMsDtor / registerPendingStructDtor O(1)
	// name-dedup without re-mangling every stored entry on each call (the
	// per-entry re-mangle was the IR-gen OOM driver).  Each pair grows and
	// resets in lockstep.  Module-scoped home for what were the
	// ir.pending{Ms,Struct}Dtor{,Name}s package-globals, so two compilations
	// in one process accumulate dtor work on their own module rather than a
	// shared global.
	PendingMsDtors         @[]@types.Type
	PendingStructDtors     @[]@types.Type
	PendingMsDtorNames     @[]@[]char
	PendingStructDtorNames @[]@[]char
	// PendingMpDtors are managed-POINTER types (`@T`) discovered needing a
	// `__dtor_mp_<T>` helper — the drop of a managed pointer to a managed value
	// (`@(@T)`, e.g. `box(mp)` for `mp @Node`) RefDecs the pointee through this
	// helper.  Same drain/dedup discipline as PendingMsDtors (with its parallel
	// PendingMpDtorNames name-list).
	PendingMpDtors     @[]@types.Type
	PendingMpDtorNames @[]@[]char
	// NeedsFuncValueDtor records that the module references the managed-func-value
	// dtor `__dtor_func` — the drop of a managed pointer to a managed func-value
	// (`@(@func())`, e.g. `box(f)` for a `@func()`) RefDecs the captured record
	// through it.  Unlike ms/mp/struct dtors it is a single signature-INDEPENDENT
	// body (dtorNameForType(`@func()`) is always `__dtor_func`), so a boolean flag
	// suffices instead of a per-type work-list.
	NeedsFuncValueDtor bool
	// NeedsIfaceValueDtor is the analogue for the managed-iface-value dtor
	// `__dtor_interface` — the drop of a `@(@I)` (e.g. `box(iv)` for a `@Greeter`)
	// RefDecs the iface value's data slot through it.  Also a single
	// interface-INDEPENDENT body (the receiver dtor is fetched from the value's own
	// vtable), so a boolean flag.
	NeedsIfaceValueDtor bool
	// SatRegistryRequested gates the satisfaction-registry wiring: a
	// BuildSatRegistry call over a root module's `__pkg_satfrag` graph node, plus
	// the LLVM frag pin (codegen.emitSatFragPin).  Set by EmitBnInit, which every
	// compiled artifact runs — a whole program (bn_init called by bn_entry) and a
	// `--library` build (the facade's bn_init) — but NOT the interp path, which
	// lowers the main module to bytecode where walking a native `__pkg_satfrag`
	// graph over native `__pkg_satentries` is meaningless, so the interp path never
	// sees it.
	SatRegistryRequested bool
}

type Global struct {
	Name @[]char
	Typ  @types.Type
	Init @Instr // constant initializer (nil = zero)
	// IsExtern marks an imported extern global (a `.bni`-declared
	// `var X T` from another package).  Codegen emits `external global`
	// with no initializer; Name is the DEFINING package's dotted
	// qualname (e.g. `pkg/x.Count`) so GlobalName mangles the decl /
	// reference to the owner's symbol, matching its definition.
	IsExtern bool
	// Exported marks a global declared in the package's `.bni` interface
	// (the export signal, set by the loader).  Drives the reflect
	// descriptor's exported-global table (the GlobalInfo emitter), which
	// the VM's RegisterPackageGlobals consumes to inject a native-only
	// package's sentinel cells for cross-mode pointer identity.
	Exported bool
}

type Func struct {
	// Name is the canonical fully-qualified name for the function
	// (e.g., "asm.New", "geom.Point.M", "main.main"). For
	// already-qualified entries (cross-package imports, methods)
	// it's stored verbatim; for intra-package free functions it's
	// "<pkgShort>.<Name>" with the qualifier added by NewFunc using
	// the current module-gen context. Backends and IR-internal
	// lookups all key off this single canonical name.
	Name @[]char
	// ModulePkgPath is the package path the func was generated in (e.g.
	// "pkg/geom"), cached at NewFunc so the @Block emit methods qualify
	// bare same-package call targets via b.Func.ModulePkgPath instead of an
	// ambient package-global — letting hundreds of EmitCall/EmitFuncValue
	// sites stay unchanged while the global goes away.  Empty for funcs created
	// outside any module-gen context (e.g.
	// imported externs registered before GeneratePackage sets the path).
	ModulePkgPath   @[]char
	Params          @[]@Param
	Results         @[]@types.Type
	MultiReturnType @types.Type // anonymous struct for multi-return (nil if <= 1 result)
	Blocks          @[]@Block
	// FaultPads holds VM-only cleanup landing pad blocks (recoverable faults).
	// Kept OFF Blocks so the compiled backends
	// — which iterate Blocks — never emit them; only the VM lowers them.  Each
	// pad RefDecs the live managed set at a fault point and ends with
	// OP_UNWIND_RETURN.  Empty until IR-gen emits pads (Inc 2a-1).
	FaultPads @[]@Block
	// PadEmitMode, while true, redirects AddBlock to append to FaultPads instead
	// of Blocks — set by emitPadCleanup so the (possibly branching) cleanup of a
	// fault landing pad stays entirely off Func.Blocks.
	PadEmitMode bool
	IsExtern    bool
	// ExternalDef marks a `.bni`-exported function whose Binate-ABI definition is
	// provided by a LINKED object (a hand-written `.s`, e.g. aarch64 rt.MemZero)
	// rather than a Binate body compiled here — because the body is `#[build]`-gated
	// off on this arch.  Such a func is `IsExtern` (declare-only, opt-skipped, no
	// `define` to collide with the linked symbol), exactly like an imported decl, so
	// every consumer that skips `IsExtern` is unaffected.  The one difference: unlike
	// an imported decl, its OWNING package must still list it in the reflect Functions
	// table + force-emit its func-value triple, so the bytecode VM's
	// RegisterPackageFunctions can bind it (otherwise an interpreted caller of, say,
	// rt.MemZero on aarch64 dies "extern not found").  The descriptor / triple
	// emitters therefore treat `IsExtern && !ExternalDef` as skip, `ExternalDef` as
	// include.  Injected during gen from the package's `.bni` surface (GeneratePackage).
	ExternalDef bool
	IsLinkOnce  bool // linkonce_odr: deduplicated by linker (for dtors)
	// IsStructDtor marks an own-package managed-struct dtor (`__dtor_<T>`).
	// Such dtors are NOT .bni-exported, but a cross-package bytecode RefDec of
	// a `@T` value calls them BY NAME — which misses if T's package is injected
	// native-only (not lowered).  So they are force-emitted a func-value handle
	// and listed in the reflect Functions table alongside exported funcs, so
	// RegisterPackageFunctions injects them and the name resolves.  Set only
	// for a package's OWN struct dtors, not element dtors (`__dtor_ms_…` etc.,
	// which a caller names locally and copies itself) nor anon/pending ones.
	IsStructDtor bool
	// IsStructCopy marks an own-package managed-struct copy helper (`__copy_<T>`),
	// the RefInc-emitting counterpart of IsStructDtor.  Like a dtor it is NOT
	// .bni-exported, but an INTERPRETED cross-package caller (a bnld -driver script
	// building a by-value struct value of an injected package's type, e.g. a
	// link.ScriptItem) copies it BY NAME — which misses if the defining package is
	// injected native-only.  So such copies are force-emitted a func-value handle and
	// listed in the reflect Functions table alongside dtors, so RegisterPackageFunctions
	// injects them and the name resolves.  Set only for a package's OWN struct copies.
	IsStructCopy bool
	// IsPrimitiveMethod marks a method whose receiver is a universe primitive
	// (int/float/bool family — the pkg/builtins/lang carve-out that owns primitive
	// impls).  Such methods are NOT .bni-exported, but a bytecode program reaches
	// them by DIRECT call (primitiveQualifiedName -> `pkg/builtins/lang.int.String`),
	// not via a vtable — so when lang is injected native-only they must be listed in
	// the reflect Functions table (like IsStructDtor) and force-emitted a func-value
	// handle, so RegisterPackageFunctions binds them and the direct-call name
	// resolves.  Only lang defines primitive methods, so this only grows lang's
	// descriptor.
	IsPrimitiveMethod bool
	Exported          bool // declared in the package's .bni (exported surface)
	NextID            int // next SSA value ID
	Line              int // source line of the func decl (1-based; 0 for synthetic)
	// CExportNames holds the C symbol name(s) from `#[c_export("...")]` on this
	// function's decl (empty for the common no-export case).  A backend emits,
	// per name, an ADDITIONAL unmangled symbol aliasing the function's entry —
	// the mangled `bn_` name is unchanged.  A list because `#[c_export("a",
	// "b")]` exports one function under several C names.
	CExportNames @[]@[]char

	// IsClosure marks this Func as a closure-lifted function-literal
	// body.  When true:
	//   - Params[0:NumCaptureParams] are the captures, prepended
	//     to the user-declared params so the body can reference
	//     them by name as local variables.
	//   - Params[NumCaptureParams:] are the user-declared params,
	//     which form the function-value's user-visible signature.
	//   - The per-shape `__shim.<mangled>` emitted by backends
	//     must read the captures out of the closure-struct
	//     pointer it receives in the `data` arg, then call the
	//     underlying function with (captures..., user_args...).
	//   - ClosureStruct holds the struct type whose fields back
	//     each capture in source order.
	IsClosure        bool
	NumCaptureParams int
	ClosureStruct    @types.Type

	// IsManagedFuncValue marks a closure literal whose user-visible
	// function-value type is @func(...) rather than the default
	// *func(...).  When true:
	//   - The closure struct is heap-allocated (EmitMake) at the
	//     literal site, NOT stack-alloc'd in the enclosing frame.
	//   - The data slot of the resulting OP_FUNC_VALUE carries the
	//     heap-allocated managed pointer; its lifetime is owned by
	//     the @func value itself, not by the enclosing frame.
	//   - emitFuncValueVtable populates the vtable's dtor slot
	//     with the closure-struct dtor symbol so the @func value's
	//     RefDec at scope end runs the dtor (which RefDec's each
	//     managed capture).
	// Always false for IsClosure=false (non-capturing literals never
	// need a heap-alloc'd data slot — their data is nil regardless
	// of the *func / @func flavour).
	IsManagedFuncValue bool
	// ClosureStructDtorName is the canonical name of the closure
	// struct's destructor (empty if the closure struct has no managed
	// fields).  Compiled puts the dtor in the func-value vtable slot;
	// the bytecode VM instead carries this name on the lowered VMFunc so
	// it can run the dtor on the heap closure struct when the @func
	// value's COMPILED_CLOSURE record is freed — otherwise the struct
	// and its captured managed values leak (the VM RefDec's the rec, not
	// the struct it points at).
	ClosureStructDtorName @[]char
	// Mod is a RAW back-reference to the @Module this func is generated into,
	// set right after NewFunc by genFuncWithPrependedParams (the sole body-gen
	// path whose cleanup emission registers pending dtors).  Raw (`*Module`,
	// not `@Module`) to break the Module⇄Func refcount cycle — the module owns
	// its funcs via Funcs @[]@Func, so a managed back-ref would leak the whole
	// module graph (mirrors @Block.Func *Func).  registerPendingMsDtor /
	// registerPendingStructDtor reach the module's pending-dtor lists through
	// it so the work-list is per-module, not a
	// process-global.  Nil for funcs created outside a module-gen body pass
	// (dtor/copy/thunk generators, imported externs, test funcs) — those never
	// register pending dtors, so the registrar aborts if it ever sees a nil
	// Mod rather than silently dropping a registration (which would leak).
	Mod *Module
}

type Param struct {
	Name @[]char
	Typ  @types.Type
	ID   int
}

type Block struct {
	Label @[]char
	// Instrs is the block's instruction list — the ONLY view the backends and the
	// VM read.  During IR generation it is a live sub-slice view of InstrsVec's
	// backing (`InstrsVec.Items()`), which addInstr refreshes after each Push so it
	// always reflects the current instructions and `len(Instrs)` is the live count.
	// Instrs and InstrsVec share backing, so mutating an element through either
	// (e.g. gen setting a Line) is visible in both.
	Instrs @[]@Instr
	// InstrsVec is the gen-time builder behind Instrs: addInstr Pushes onto it
	// (amortized O(1)) rather than reallocating Instrs on every append — a plain
	// grow-by-one append is O(n) per call, so building a block was O(n²).  Backends
	// and the VM never read it; Instrs is the consumer-facing view.  Seeded by
	// AddBlock / AddFaultPad; a hand-built Block (e.g. a backend unit test that sets
	// Instrs directly) leaves it nil, which is safe because only addInstr — reached
	// solely through the gen path off AddBlock — touches it.
	InstrsVec @vec.Vec[@Instr]
	// Func is the function this block belongs to. Raw pointer
	// (not @Func) to break the parent→child→parent cycle that
	// would otherwise leak refcounts: Func owns Blocks via
	// `Func.Blocks @[]@Block`; the back-pointer here is safe
	// because a Block can't outlive its owning Func.
	Func *Func
	// NilCheckedSlots records, within THIS block, the source-slot SSA ids whose
	// non-nil-ness the opt-in nil-check pass has already established and not since
	// invalidated — so a repeated deref of the same pointer (`p.x + p.y`) emits
	// ONE OP_NIL_CHECK (intra-block dedup elision).
	// A gen-time-only field (backends ignore it); empty unless GenCtx.EmitNilChecks
	// is on.  addInstr clears it on any op that isn't provably nil-check-preserving
	// (a store / call / destructor — anything that could reassign a slot or run
	// user code), so a stale entry can never survive a reassignment (soundness).
	NilCheckedSlots @[]int
}

type Instr struct {
	ID  int // SSA value ID (-1 for void)
	Op  int
	Typ @types.Type // result type

	// Operands (usage depends on Op)
	Args   @[]@Instr // input values
	Block1 @Block // branch target / then
	Block2 @Block // else / continue

	// Phi entries
	Phis @[]PhiEntry

	// Immediates.  IntVal is int64 (not host `int`) so a program
	// integer constant — which may be 64-bit regardless of the
	// compiler's host word size — is stored as a fixed-width bit
	// pattern, reinterpreted by the instruction's type.
	IntVal  int64
	StrVal  @[]char
	BoolVal bool
	Index   int
	// IfaceUpcastSlotOffset is meaningful only for OP_IFACE_UPCAST: the
	// target (parent) interface's vtable slot offset (in slots) within the
	// source interface's concat-vtable, precomputed at IR-gen time by
	// EmitIfaceUpcast (via IfaceParentSlotOffset) so the compiled backends
	// (LLVM / x64 / aarch64) don't need the interface registry at emit
	// time — their per-instruction emitters have no @Module in hand.  -1
	// marks an invalid upcast (target not an ancestor of source); backends
	// abort on it rather than emit a negative vtable GEP.
	IfaceUpcastSlotOffset int

	// Type operand
	TypeArg @types.Type

	// CFixedArgs is meaningful only for OP_C_CALL: the count of fixed
	// (named) arguments — Args[CFixedArgs:] are the variadic args.  This
	// is the fixed/variadic SPLIT POINT, not the is-variadic flag (a `...`
	// with zero trailing args leaves CFixedArgs == len(Args)); use
	// CVariadic to ask whether the call is variadic.
	CFixedArgs int

	// CVariadic is meaningful only for OP_C_CALL: true iff a `...` marker
	// was written, regardless of trailing arg count — the authoritative
	// is-variadic flag every backend must use for the C-boundary ABI
	// (replaces the `CFixedArgs < len(Args)` inference, which misclassifies
	// a zero-trailing-vararg call as non-variadic).  See ast.bni's
	// CallExpr.CVariadic.
	CVariadic bool

	// RetbufSize is meaningful for the cross-mode call ops
	// (OP_CALL_FUNC_VALUE / OP_CALL_HANDLE / OP_CALL_IFACE_METHOD): the
	// aggregate retbuf byte size (rounded to N*8) when the callee returns
	// via a retbuf, or 0 for a scalar return.  Stamped at IR-gen from the
	// callee's result list (where it is available) via
	// types.AggregateReturnSize, since the VM's cross-mode shim dispatch
	// cannot recover it from the lowered (collapsed) result type.  A
	// nonzero value is itself the scalar-vs-aggregate discriminator.
	RetbufSize int

	// PadBlock is the VM-only cleanup landing pad for a potentially-faulting op
	// (OP_BOUNDS_CHECK / OP_DIV_CHECK / OP_SHIFT_CHECK / OP_NIL_CHECK and the call
	// ops): a raw back-ref (like Block.Func) into the owning Func.FaultPads,
	// resolved to a bytecode PC by VM lowering to build VMFunc.FaultTable.  nil
	// means this op is not a recoverable-fault site.
	PadBlock *Block

	// Source position (for debug info)
	Line int

	// IsGlobalRef marks the pseudo-Instr produced by lookupVar's
	// fallback-to-global path — distinguishes it from a real local
	// alloca that happens to have the same name as a package-level
	// global (which can occur for parameters, e.g.
	// `func MakeAliasType(name @[]char, target @Type)` where the
	// `target` parameter shadows pkg/binate/types' `var target TargetInfo`).
	// Backends use this to route the reference to global storage
	// instead of the local stack slot.
	IsGlobalRef bool

	// ParamIndex marks an OP_ALLOC that holds a function parameter
	// (1-based; 0 = not a param). Set by genFunc when allocating
	// the per-param stack slot. Used by the LLVM backend's debug-info
	// path to emit `arg: <N>` on the param's DILocalVariable, so
	// lldb shows it as a function argument rather than a local.
	ParamIndex int

	// IsByvalParamRef marks a placeholder Instr that references a
	// byval-eligible aggregate parameter (set by genFunc on the
	// paramRef passed to the entry-block EmitStore-into-paramSlot).
	// LLVM-IR lowering for OP_STORE checks this flag and emits a
	// scalar-store sequence (one load+store per scalar leaf, via
	// emitFieldwiseCopy) from the byval pointer to the slot
	// alloca instead of a `store <T> <val>, ptr <slot>` (which
	// would type-mismatch — the byval-param's LLVM IR type is
	// `ptr`, not the struct type).
	IsByvalParamRef bool

	// CEntryThunk marks an OP_C_ENTRY whose target has a narrow GP integer/bool
	// parameter, so the native backend references the weak `__centry.<mangled>`
	// adaptation thunk instead of the mangled entry.  Set by the native EmitObject
	// pre-pass; the LLVM backend ignores it.  See pkg/binate/native/common.
	CEntryThunk bool
}

type PhiEntry struct {
	Block @Block
	Val   @Instr
}

// ============================================================
// Module
// ============================================================

// NewModule creates a new IR module with the given name.
func NewModule(name @[]char) @Module

// AddFunc adds a function to the module.
func (m @Module) AddFunc(f @Func)

// AddGlobal adds a global variable to the module.
func (m @Module) AddGlobal(g @Global)

// CEntryTargetFunc returns the top-level function named `name` (an OP_C_ENTRY
// StrVal) as an @Func — the real one if defined here, else a synthetic @Func
// carrying an imported signature's params/results — or (nil, false) if unknown.
// Used by pkg/binate/native/common for the native __c_entry thunk; see the impl.
func CEntryTargetFunc(m @Module, name *[]readonly char) (@Func, bool)

// ============================================================
// Function
// ============================================================

// NewFunc creates a new function.  pkgPath qualifies a bare name (and is
// cached on the func as ModulePkgPath so the emit methods qualify bare
// call targets); pass "" for an already-qualified or context-free name.
func NewFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func

// NewExternFunc creates a new extern (declaration-only) function.
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func

// AddBlock appends a new basic block with the given label to the function.
func AddBlock(f @Func, label *[]readonly char) @Block

// AddFaultPad appends a VM-only cleanup landing pad block to Func.FaultPads (not
// Blocks), so the compiled backends never emit it and only the VM lowers pads.
func AddFaultPad(f @Func, label *[]readonly char) @Block

// ============================================================
// Param
// ============================================================

// NewParam creates a new function parameter and assigns it an SSA ID.
func NewParam(f @Func, name @[]char, typ @types.Type) @Param

// ============================================================
// Block
// ============================================================

// Emit instructions into a block. Each returns the instruction (for use
// as an operand in subsequent instructions).

// IfaceOwnMethodNames returns the OWN methods of the interface
// (pkg, name) in declaration order — the same list IR-gen
// records during DECL_INTERFACE collection.  Empty for unknown
// or alias-target-missing entries.  `m` names the module whose
// interface registry the (pkg, name) lookup keys on — shared by
// the Iface* query family below.
func IfaceOwnMethodNames(m @Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// IfaceParentPkgs / IfaceParentNames are parallel arrays naming
// each parent interface of (pkg, name) in declaration order
// (`interface X : P1, P2`).  Empty for non-extending interfaces
// or unknown lookups.  Slice E.3.
func IfaceParentPkgs(m @Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

func IfaceParentNames(m @Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// IfaceFullVtableSize returns the number of slots a `(R, X)`
// vtable occupies under the concat layout:
//   size(X) = 2 (any-block: dtor + *TypeInfo)
//           + sum(size(P) for P in X.Parents)
//           + len(X's own methods)
// Returns 0 if the interface isn't registered.  Slice E.3.
func IfaceFullVtableSize(m @Module, pkg *[]readonly char, name *[]readonly char) int

// IfaceParentSlotOffset returns the absolute slot index at which
// target's full vtable starts within src's concat vtable, or -1
// if target is not a (transitive) parent of src.  Used to lower
// OP_IFACE_UPCAST.  Slice E.4 part 2b.
func IfaceParentSlotOffset(m @Module, srcPkg *[]readonly char, srcName *[]readonly char,
		targetPkg *[]readonly char, targetName *[]readonly char) int

// ============================================================
// String Constants
// ============================================================

type StringConst struct {
	ID   int
	Data @[]char
	Len  int
}

// FinalizeStrings collects string constants and stores them on the module.
func (m @Module) FinalizeStrings()

// FindStringID returns the ID of a string constant matching data, or -1 if not found.
func FindStringID(strings *[]StringConst, data *[]readonly char) int

// ============================================================
// Static-data / RTTI gather (per-module)
// ============================================================
//
// The static-data BYTE layout (DataGlobal + the Build* record builders) lives
// in the @Module-free leaf package pkg/binate/irdata.  These Collect* passes
// WALK a module to decide which records each backend must emit — the half that
// genuinely needs @Module, kept here so irdata stays a leaf (no ir import).

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit — one per TypeInfoEntry in the per-type registry (m.TypeInfos), each
// with that type's size/align/name read (at codegen) off the entry's held
// RecvTyp.  Each backend iterates it and emits irdata.BuildTypeInfo(desc).
func CollectTypeInfoDescs(m @Module) @[]@irdata.TypeInfoDesc

// CollectIfaceIdSyms returns the distinct IfaceId marker symbols module `m` must
// emit — one per canonical interface in m.Interfaces (aliases skipped, `any`
// included), deduped.  Each backend iterates it and emits irdata.BuildIfaceId(sym).
func CollectIfaceIdSyms(m @Module) @[]@[]char

// CollectSatEntries returns the distinct satisfaction entries module `m` must
// emit — one per `(RecvPkg, RecvTypeName, IfacePkg, IfaceName)` across m.Impls
// (which already includes every transitive ancestor), deduped by entry symbol.
// Each backend iterates it and emits irdata.BuildSatEntry(desc).
func CollectSatEntries(m @Module) @[]@irdata.SatEntryDesc

// LookupVtableSlotName returns the symbol name a vtable slot for
// `methodFuncName` should point at: the iv-dispatch thunk's name when
// methodFuncName resolves to a value-receiver method, or methodFuncName itself
// otherwise.  Single source of truth for the codegen vtable emitter and the VM
// vtable-lowering pass.
func LookupVtableSlotName(m @Module, methodFuncName @[]char) @[]char

// ============================================================
// Helpers
// ============================================================

// IsTerminator reports whether the instruction is a block terminator.
func (instr @Instr) IsTerminator() bool

// ============================================================
// Module init/entry emission
// ============================================================
// These @Module methods build the synthetic init/entry functions drivers wire
// up; the AST-driven generation that decides WHAT to emit lives in irgen.

// HasMainFunc reports whether the module defines the program entry `main.main`
// (the user's `func main` in package "main").  Program-assembly drivers call
// this on the main module before emitting the entry (EmitBnEntry) to reject a
// program with no entry — a link/program-emit failure, not a per-package
// compile error.
func (m @Module) HasMainFunc() bool

// IsMainPackage reports whether the module's package is named "main" — the
// name a program's entry package must have (§17.3).  Program-assembly drivers
// check this before HasMainFunc to reject a mis-named entry package precisely.
func (m @Module) IsMainPackage() bool

// HasPackageInit reports whether `m` contains a `<m_pkg>.__init`
// function (one was emitted by IR-gen of var initializers).
// Used by drivers to decide whether to include the package in
// the dispatcher's call list.
func (m @Module) HasPackageInit() bool

// PackageInitName returns the qualified name `<pkgShort>.__init`
// — helper for drivers building the dispatcher's call list.
func PackageInitName(pkgShort *[]readonly char) @[]char

// ============================================================
// Shared IR-construction utilities (used by irgen)
// ============================================================

// LookupModuleFunc returns the @Func with the given name in
// m.Funcs, or nil.  Public so codegen / vm can reuse it
// (pkg/binate/codegen has its own private copy from before this
// helper existed; that copy can be dropped opportunistically).
func LookupModuleFunc(m @Module, name *[]readonly char) @Func

// AddBlock creates a new basic block with a unique label and appends it to the
// function.  While f.PadEmitMode is set (during a fault landing pad's cleanup,
// which can branch), the block is routed to Func.FaultPads instead of Blocks so
// the compiled backends never see it — see AddFaultPad.
func AddBlock(f @Func, label *[]readonly char) @Block

// NewFunc creates a new function with parameters and result types, assigning IDs to params.
// f.Name is the canonical fully-qualified name: `name` qualified with
// `pkgPath` (the defining module's package path) via mangle.QualifyName.
// An empty `pkgPath` (a name built outside any module-gen context) leaves
// `name` unchanged, and QualifyName is idempotent on an already-dotted
// `name` (cross-package refs, methods, qualified dtors), so those pass
// through too.  f.ModulePkgPath caches `pkgPath` so the @Block emit
// methods qualify bare call targets off the func (b.Func.ModulePkgPath).
func NewFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func

// NewExternFunc creates an extern function declaration (no body, no param IDs).
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func

// NewParam creates a new function parameter and assigns it a unique ID.
func NewParam(f @Func, name @[]char, typ @types.Type) @Param

// NewModule creates a new IR module with the given name.
func NewModule(name @[]char) @Module

// NewInstr allocates a typed instruction with a unique ID.
func NewInstr(f *Func, op int, typ @types.Type) @Instr

// PeelToRepr peels a type to its in-memory representation (through transparent
// wrappers and named aliases) for IR-level structural comparison.
func PeelToRepr(t @types.Type) @types.Type

// StripConstForIR drops the readonly/const qualifier from a type for IR value
// typing (the IR is const-agnostic; const-ness is a source-level check).
func StripConstForIR(t @types.Type) @types.Type

// AllocValueID allocates and returns the next unique SSA value ID for `f`
// (post-increments Func.NextID).  Used by IR-construction and passes that mint
// new SSA values.
func AllocValueID(f *Func) int

// NewVoidInstr allocates a void instruction (ID -1, no result value) with the
// given opcode; the caller fills in operands.
func NewVoidInstr(op int) @Instr

// NewParamRef builds the by-ID placeholder @Instr that stands for parameter `p`:
// an operand whose ID equals p's ID, which every backend resolves to the incoming
// argument (LLVM `%v<id>` / the VM+native param slot) straight from the function
// signature.  It is only ever an operand — never appended to a block as a def.
//
// Its opcode is OP_PARAM, NOT OP_CONST_INT.  A distinct opcode is load-bearing:
// the shared IR-level SSA passes read `.Op` (mem2reg / load-forwarding forward the
// placeholder as a param-slot load's reaching value; bceConstIndex / bceLoop
// inspect the resulting operand).  Spelled OP_CONST_INT — enum value 0, default
// IntVal 0 — those passes mistook a parameter for the integer constant 0 and
// dropped bounds checks (a silent -O1 out-of-bounds miscompile); OP_PARAM keeps a
// parameter from ever looking like a constant.
//
// IsByvalParamRef is set for a byval-aggregate param so that an OP_STORE of this
// ref into its slot lowers as a memcpy from the `ptr byval(<T>)` incoming pointer
// rather than a value store.  The flag is consumed ONLY by the store emitter, so
// it is inert on a ref that is instead loaded-through or forwarded (e.g. an
// interface-thunk's byval pass-through).
func NewParamRef(p @Param) @Instr

// Internal: build fixed-size Args slices
func MakeArgs1(a @Instr) @[]@Instr

// MakeArgs2 builds a 2-element instruction argument slice.
func MakeArgs2(a @Instr, b @Instr) @[]@Instr

// AddFaultPad appends a VM-only cleanup landing pad block to the function's
// FaultPads list — NOT Blocks — so the compiled backends (which iterate Blocks)
// never emit it; only the VM lowers pads and branches to them on a recoverable
// fault.
func AddFaultPad(f @Func, label *[]readonly char) @Block

// RegisterFuncSig appends `sig` to mod.FuncSigs and records Name→index in
// mod.FuncSigIndex, keeping the first index per Name.  It is the single funnel for
// every FuncSigs append, so the index never goes stale.
func RegisterFuncSig(mod @Module, sig irdata.FuncSig)

// FuncSigIndexLookup returns the FuncSigs index for `name`, or -1 if absent.
func FuncSigIndexLookup(mod @Module, name *[]readonly char) int

// RegisterTypeInfo records the boxable type (recvPkg, recvName) — its base
// value type `recvTyp` and qualified dtor `dtorName` — in m.TypeInfos, keyed
// (deduped) by receiver identity, which is exactly its mangle.TypeInfoName
// symbol.  Called alongside every local ImplInfo creation, so a type with N
// interface rows registers once (the first wins; every row of a type shares the
// same recvTyp object and dtorName, so first-wins is exact).  This is the
// per-type home ("design D") that replaced the per-(type,iface) RecvTyp field.
func RegisterTypeInfo(m @Module, recvPkg *[]readonly char, recvName *[]readonly char,
		recvTyp @types.Type, dtorName @[]char)

// ManagedStructLeafEligible reports whether t (peeled) is a struct with at least
// one managed field, EVERY managed field of which has a forwardable inline
// cleanup: a LEAF managed scalar RefDec'd via load+RefDec (managed pointer, managed
// func-value, managed iface-value), a managed slice `@[]T` of ANY element (its
// -O1+ field cleanup is extract-refptr + RefDec, or extract-refptr/backinglen +
// call __dtor_ms_elems for a managed element — never a field-ptr bitcast), OR a
// nested managed-containing struct that is ITSELF leaf-eligible (its cleanup
// recurses to inline per-field RefDecs on the field-ptr — see isLeafManagedField /
// emitStructFieldRefDecs).  A field that is an array with managed elements makes t
// INELIGIBLE — its cleanup is a by-address elem-dtor call that would pin the split
// field slot (arrays are not SROA'd).  BOTH the cleanup-shape choice (gen, at -O1+)
// and the SROA candidate gate use this predicate, so the inline cleanup and the
// split agree on exactly which structs.  Distinct from sroaAggregateContainsManaged
// (which excludes ANY managed content): this ADMITS the leaf-managed subset
// (recursively).
func ManagedStructLeafEligible(t @types.Type) bool

// PeelToUnderlying peels alias, readonly, and named-distinct wrappers to
// the underlying type, so EmitSame / EmitPresent dispatch on the real
// reference kind.
func PeelToUnderlying(t @types.Type) @types.Type

// BlockIndexIn returns i with f.Blocks[i] == target (reference identity), or -1.
func BlockIndexIn(f @Func, target @Block) int

// CanonicalIfaceName resolves an interface (pkg, name) through the
// alias chain and returns the chain tail's name. If the input
// doesn't refer to a registered interface, returns a fresh copy of
// the input name — at worst the symbol mangles on the impl-site
// reference.
func CanonicalIfaceName(m @Module, pkg *[]readonly char, name *[]readonly char) @[]char

// CanonicalIfacePkg returns the canonical package short-name for
// the chain-tail of (pkg, name). Used by the vtable
// mangling (`__ivt.bn_V...`)
// to ensure aliases collapse to the underlying interface's
// package. If lookup fails, returns the input pkg unchanged.
func CanonicalIfacePkg(m @Module, pkg *[]readonly char, name *[]readonly char) @[]char

// LookupModuleInterface returns the cached method-name list for the
// interface (pkg, name), or an empty slice if not found. Follows
// alias chains. Lookup is keyed on (Pkg, Name).
func LookupModuleInterface(m @Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// ResolveModuleInterface returns the index in m.Interfaces of
// the entry for (pkg, name), following any alias chain. Returns -1
// on not-found or cycle (defensive cap at 32 hops). Lookup is
// keyed on (Pkg, Name) so cross-package interface refs
// resolve to the imported package's entry without colliding with
// a same-named local interface.
func ResolveModuleInterface(m @Module, pkg *[]readonly char, name *[]readonly char) int

// ThunkNameForMethod returns the qualified IR-level name for
// the iv-dispatch thunk of a value-receiver method.  Input is
// the method's qualified name `<recvPkg>.<recvName>.<method>`;
// output inserts `__bn_thunk_` before the method part:
// `<recvPkg>.<recvName>.__bn_thunk_<method>`.  The `__bn_`
// prefix marks compiler-generated names.
func ThunkNameForMethod(methodFuncName *[]readonly char) @[]char

// LookupModuleInterfaceIndex returns the index of the entry in
// m.Interfaces matching (pkg, name), or -1 if absent. No alias-
// chain resolution.  The pkg argument is expanded from an import
// alias to the full package path (resolveImportPkg) so a use-site
// reference written with the short alias matches the interface's
// full-path-keyed registry entry (full-path mangling — see
// pkg/binate/mangle).
func LookupModuleInterfaceIndex(m @Module, pkg *[]readonly char, name *[]readonly char) int

// ResolveImportPkg maps an import alias to its full package path via
// m's import-alias map (m.ImportAliasNames / m.ImportAliasPaths — parallel
// arrays keyed alias short-name -> full path).  Returns a copy of the input
// unchanged when it isn't a known import alias — covering same-package
// references, names that are already full paths, and the universe package.
// This is the single point where the short source-level alias becomes the
// full path in the IR namespace (full-path mangling; see pkg/binate/mangle).
func ResolveImportPkg(m @Module, alias *[]readonly char) @[]char

// IRViolation is one structural defect found by VerifyFunc.
type IRViolation struct {
	FuncName   @[]char
	BlockIndex int
	BlockLabel @[]char
	InstrIndex int
	Code       int
	Msg        @[]char
}

// RegisterPendingFuncValueDtor flags that the module needs the managed-func-value
// dtor `__dtor_func` emitted (drop of a `@(@func())`).  One signature-independent
// body, so a boolean flag rather than a per-type work-list.
func RegisterPendingFuncValueDtor(f @Func)

// RegisterPendingIfaceValueDtor flags that the module needs the managed-iface-value
// dtor `__dtor_interface` emitted (drop of a `@(@I)`).  One interface-independent
// body, so a boolean flag rather than a per-type work-list.
func RegisterPendingIfaceValueDtor(f @Func)

// RegisterPendingMpDtor records a managed-POINTER type `@T` that needs a
// `__dtor_mp_<T>` helper — mirrors registerPendingMsDtor.  Used when the drop of a
// `@(@T)` (a managed pointer to a managed value) references the pointee's mp-dtor.
func RegisterPendingMpDtor(f @Func, mpTyp @types.Type)

// RegisterPendingMsDtor records a managed-slice type that needs a dtor.  The
// work-list lives on the func's module (f.Mod) — see registerPendingStructDtor
// for the back-ref + nil-abort rationale.
func RegisterPendingMsDtor(f @Func, msTyp @types.Type)

// RegisterPendingStructDtor records a struct/array type that needs dtor and
// copy functions generated. This handles types discovered during scope cleanup
// that aren't in Module.Structs (e.g., array types used as local variables).
// The work-list lives on the func's module (f.Mod), reached via the raw
// back-ref set at body-gen creation; f.Mod is non-nil for every func whose
// body runs scope cleanup, so a nil Mod is an IR-gen bug (a registering func
// created off the genFuncWithPrependedParams path) — abort rather than drop
// the registration silently, which would leak the type's dtor.
func RegisterPendingStructDtor(f @Func, typ @types.Type)

// Structural IR verifier (verify.bn)
// ============================================================
