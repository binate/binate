// Package ir defines the intermediate representation (IR) used between parsing
// and code generation. It provides SSA-form instructions, basic blocks, functions,
// and modules, along with an IR generator that lowers ASTs to IR.
package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
// ============================================================
// IR Data Structures
// ============================================================

// ModuleConst is one entry in a module's gen-time const lookup table:
// IR-gen records every named const so later expressions resolve an
// identifier to its compile-time value.  Kind selects which value field
// is live (see the CONST_* constants in the implementation).
type ModuleConst struct {
	Name    @[]char
	Val     int          // integer / iota value (Kind == CONST_INT)
	BoolVal bool         // bool-literal value (Kind == CONST_BOOL)
	FltText @[]char      // float-literal raw text (Kind == CONST_FLT)
	Expr    @ast.Expr    // float const-EXPRESSION (Kind == CONST_EXPR),
	                     // re-lowered via genExpr at each read site
	Kind    int          // constant family — see the CONST_* constants
	Typ     @types.Type  // declared type (nil means untyped/iota)
}

// FuncSig is one entry in a module's gen-time function-signature lookup
// table: it lets a call site recover the result types (especially
// MultiReturnType for a multi-return call).
type FuncSig struct {
	Name            @[]char
	Params          @[]@types.Type
	Results         @[]@types.Type
	MultiReturnType @types.Type
	// IsVariadic marks a callee whose final parameter is variadic (`name
	// ...T`).  IR-gen re-resolves param types from the AST (not the checker's
	// resolved Type), so this flag — and the `*[]T` derivation of the variadic
	// param's Params entry — are set at every FuncSig-build site from the AST's
	// variadic marker.  A call site reads it to decide whether to pack trailing
	// args / forward a spread into the single `*[]T` trailing argument.
	IsVariadic bool
}

// ModuleStruct is one entry in a module's gen-time struct-type lookup
// table, so composite literals and field accesses can recover the layout.
type ModuleStruct struct {
	Name   @[]char
	Fields @[]@types.Field
	Typ    @types.Type
	// IsInstantiation marks a monomorphized generic struct (from
	// ensureInstantiatedStruct).  Its Name is qualified by the generic's
	// DEFINING package, not the consumer module, so the dtor/copy-helper
	// driver must DEFINE its helpers locally (IsLinkOnce) in every consumer
	// rather than treat the defining-pkg prefix as cross-package and emit an
	// extern declaration (which nobody defines — the defining package never
	// instantiates it).  Mirrors the generic-func IsLinkOnce merge.
	IsInstantiation bool
}

// ModuleGlobal is one entry in a module's gen-time top-level-`var` lookup
// table, so name lookups in function bodies resolve to a global when no
// local of the same name exists.
type ModuleGlobal struct {
	Name @[]char
	Typ  @types.Type
	Init int // initial value (integer only for now)
	// IsExtern marks an imported extern var (a `.bni`-declared `var X T`
	// from another package, registered during RegisterImport).  Name is
	// the defining-package dotted qualname; gen_module materializes it as
	// an `IsExtern` ir.Global (an `external global` decl) rather than a
	// definition, and gen_selector resolves a qualified read against it.
	IsExtern bool
	// Exported mirrors the decl's `.bni`-membership export flag, carried
	// onto the materialized ir.Global so the reflect descriptor's
	// exported-global table can list it.
	Exported bool
}

// ModuleTypeAlias is one entry in a module's gen-time `type T = U` lookup
// table, so subsequent type references resolve correctly.
type ModuleTypeAlias struct {
	Name @[]char
	Typ  @types.Type
}

// ModuleInterface is one entry in a module's interface registry
// (@Module.Interfaces): an interface's method-name list (declaration order),
// the flattened result/param type tables (MethodResultsFlat/Counts,
// MethodParamsFlat/Counts — so a 0-/1-/>=2-result method's dispatch builds
// the right result shape), the alias chain (AliasTarget/Pkg for
// `interface X = Y`), and the parent list (ParentPkgs/ParentNames for
// `interface X : P`).  Built during GeneratePackage/GenModule's first pass
// (collectInterfaceFromDecl), seeded with universe `any` per module; consumed
// by impl-collection and the use-site dispatch / vtable-layout helpers (incl.
// the exported Iface* queries the VM's cross-mode vtable lowering reads).
type ModuleInterface struct {
	// Pkg: short package name where the interface is declared
	// ("main" / "greeter" / etc.). Cross-package references match
	// on (Pkg, Name); same-package references use Pkg = current
	// module's pkgShort. Slice 2.7 of plan-cross-package-interfaces.md.
	Pkg         @[]char
	Name        @[]char
	MethodNames @[]@[]char
	// MethodParamsFlat holds every method's param types concatenated in
	// method order; MethodParamCounts[j] is method j's param count (method
	// j's params are MethodParamsFlat[off..off+count], off = sum of earlier
	// counts).  Flat (not @[]@[]@Type) because a managed-slice-of-managed-
	// slice STRUCT FIELD trips a missing nested cross-package element dtor in
	// the current BUILDER.  Interface dispatch needs these to apply the same
	// arg coercions the regular call path does.
	MethodParamsFlat  @[]@types.Type
	MethodParamCounts @[]int
	// MethodParamVariadic[j] marks method j as having a variadic final
	// parameter (`name ...T`), parallel to MethodParamCounts.  At an interface
	// vtable dispatch, variadic-ness is erased at the ABI (spec §10.3): the
	// caller packs/spreads to a plain `*[]T` before the single indirection, so
	// this tells genInterfaceMethodCall whether to do so.  `@[]bool` (per-method
	// scalar), not a nested managed-slice, to stay BUILDER-safe.
	MethodParamVariadic @[]bool
	// MethodResultsFlat / MethodResultCounts: every method's RESULT types
	// flattened in method order, parallel to MethodParamsFlat/Counts.  The
	// CR-2 SEAM field — DEFINED by IR-gen, CONSUMED read-only by the codegen /
	// native backends for >=2-result tuple layout.
	MethodResultsFlat  @[]@types.Type
	MethodResultCounts @[]int
	// AliasTarget (Slice 2.4): for `interface X = Y`, the target's name;
	// lookups follow the chain on read.  Empty for non-alias entries.
	// AliasTargetPkg names a cross-package alias target's package.
	AliasTarget    @[]char
	AliasTargetPkg @[]char
	// ParentPkgs / ParentNames (plan-interface-embedding.md Slice E.3):
	// parallel arrays naming each parent interface this one extends, in
	// declaration order.  Empty for interfaces that don't extend.
	ParentPkgs  @[]@[]char
	ParentNames @[]@[]char
}

type Module struct {
	Name    @[]char
	// PkgPath is this module's package path (e.g. "pkg/geom"), used to
	// qualify bare same-package names.  It is the module-scoped home for
	// what was the ir.currentModulePkgPath package-global — set by the gen
	// entry points (GeneratePackage / GenModule).  Empty before gen and for
	// the universe/synthetic case.  Per-module so two compilations don't
	// share it (plan-embeddable-vm.md inc 5).
	PkgPath @[]char
	Funcs   @[]@Func
	Globals @[]@Global
	Types   @[]@TypeDef
	Strings @[]StringConst   // collected string constants (populated by FinalizeStrings)
	Impls   @[]@ImplInfo     // per-(impl, interface) vtable info — local impls
	                         // declared in this TU (Slice 2.3a-1). Codegen
	                         // emits a vtable global for each.
	// ImportedImpls: impls declared in imported packages, registered so
	// IR-gen's vtable-name lookup at use sites in this TU resolves
	// across package boundaries (Slice 2.8 of plan-cross-package-
	// interfaces.md). Codegen does NOT emit vtables for these — the
	// owning TU's compile already emits them with weak_odr linkage,
	// and the linker resolves the cross-TU reference.
	ImportedImpls @[]@ImplInfo
	// PackageAccessorSig: the func-value type of this module's
	// compiler-synthesized `__Package() @reflect.Package` accessor,
	// stashed by IR-gen (registerCurrentModulePackageAccessor) so the
	// backends can self-list __Package in the per-package reflect
	// Functions table without re-deriving the reflect.Package type
	// (which lives in the type checker, unavailable to the backends).
	// Both backends read this one object, so the __Package FunctionInfo
	// entry's Sig / RetbufSize are identical by construction.  nil when
	// the reflect type was not loaded for this compilation (then no
	// self-entry is emitted).
	PackageAccessorSig @types.Type
	// Checker is the type-Checker that produced this module's typed AST.
	// IR-gen consults it for per-expression resolved types
	// (Checker.ExprType(id)), pending-decl checks, and the reflect package
	// type.  Per-module (was the ir.currentChecker package-global) so two
	// compilations in one process don't share checker state — set by the
	// gen entry points (GeneratePackage / GenModule / the REPL GenDecl path)
	// and copied onto each GenContext.  Nil-safe: IR-gen falls back to the
	// legacy parseIntLit path when nil (test helpers that skip type-check).
	Checker @types.Checker
	// Consts / Structs / FuncSigs / GlobalVars / TypeAliases are this
	// module's IR-gen lookup tables — the module-scoped home for what were
	// the ir.moduleConsts / moduleStructs / moduleFuncs / moduleGlobals /
	// moduleTypeAliases package-globals.  They accumulate across the
	// RegisterImport → GeneratePackage → dtor/copy-gen sequence (all of
	// which share this @Module), and stay distinct from the IR-OUTPUT
	// Funcs / Globals / Types fields above (those hold emitted IR; these
	// hold gen-time signatures/layouts consulted while emitting it).
	// Per-module so two compilations in one process don't share gen state
	// (plan-embeddable-vm.md inc 5).
	Consts      @[]ModuleConst
	Structs     @[]ModuleStruct
	FuncSigs    @[]FuncSig
	GlobalVars  @[]ModuleGlobal
	TypeAliases @[]ModuleTypeAlias
	// ImportAliasNames / ImportAliasPaths are this module's import-alias
	// map — parallel arrays mapping a source-level alias short-name to the
	// full package path.  resolveImportPkg consults them to expand an alias
	// to the full-path mangling form; RecordImportPath / pushFileImports
	// populate them.  Module-scoped home for what were the
	// ir.importAliasNames / importAliasPaths package-globals, so two
	// compilations in one process don't share alias state
	// (plan-embeddable-vm.md inc 5).
	ImportAliasNames @[]@[]char
	ImportAliasPaths @[]@[]char
	// CurrentImportAlias is the import alias whose declarations are
	// currently being registered, or whose monomorphized generic body is
	// being emitted — set and restored around the import-registration and
	// generic-instantiation passes so an unqualified name resolves under
	// the defining package.  Module-scoped home for the
	// ir.currentImportAlias package-global.
	CurrentImportAlias @[]char
	// Interfaces is this module's interface registry (seeded with universe
	// `any` at NewModule; accumulates this module's own + imported interfaces
	// during gen).  Module-scoped home for the ir.moduleInterfaces
	// package-global, so two compilations don't share interface state
	// (plan-embeddable-vm.md inc 5d-2).  Read by the dispatch / vtable-layout
	// helpers and the exported Iface* queries the VM consults.
	Interfaces @[]ModuleInterface
	// MethodValueWrappers holds the qualified names of the synthesized
	// `T.M`-method-value wrapper Funcs emitted for this module, for dedup
	// across multiple uses of the same selector form.  Module-scoped home for
	// the ir.methodValueWrappers package-global (plan-embeddable-vm.md inc
	// 5d-3) — per-module so a REPL mid-session import's GeneratePackage no
	// longer wipes the session module's synthesized wrappers.
	MethodValueWrappers @[]@[]char
	// PendingMsDtors / PendingStructDtors are the IR-gen work-lists of
	// managed-slice and struct/array types discovered needing dtors (and, for
	// structs/arrays, copies) during this module's function-body emission —
	// drained after body-gen by generateNonStructDtors / generateCopies (file
	// load) or EnsureReplBodyHelpers (REPL).  PendingMsDtorNames /
	// PendingStructDtorNames are the precomputed dtor-name lists kept parallel
	// to them, giving registerPendingMsDtor / registerPendingStructDtor O(1)
	// name-dedup without re-mangling every stored entry on each call (the
	// per-entry re-mangle was the IR-gen OOM driver).  Each pair grows and
	// resets in lockstep.  Module-scoped home for what were the
	// ir.pending{Ms,Struct}Dtor{,Name}s package-globals, so two compilations
	// in one process accumulate dtor work on their own module rather than a
	// shared global (plan-embeddable-vm.md inc 5d).
	PendingMsDtors         @[]@types.Type
	PendingStructDtors     @[]@types.Type
	PendingMsDtorNames     @[]@[]char
	PendingStructDtorNames @[]@[]char
}

// ImplInfo captures the data needed to emit a single interface
// vtable: the receiver's named type, the interface, and (in
// interface method order) the qualified function name to put in
// each slot. One ImplInfo per (impl, interface) pair — an
// `impl T : I1, I2` produces two ImplInfo entries. Codegen walks
// m.Impls and emits a `@__ivt.<recvTypeName>.<ifaceName>` constant
// global per entry. See plan-interface-syntax-revision.md and
// claude-discussion-detailed-notes.md § 6.
type ImplInfo struct {
	// RecvPkg / IfacePkg: short package names (e.g., "main") of the
	// receiver type's defining package and the interface's defining
	// package, respectively. Vtable mangling uses these so two TUs
	// referencing the same canonical (R, I) pair agree on the
	// `__ivt.<...>` symbol regardless of where the `impl R : I`
	// declaration lives. Today both equal the impl declaration's
	// package (impls must be same-package); kept as separate fields
	// so cross-package work (plan-cross-package-interfaces.md) can
	// populate them differently. Slice 2.6.
	RecvPkg      @[]char
	RecvTypeName @[]char
	IfacePkg     @[]char
	// IfaceName is the canonical (alias-resolved) interface name —
	// not the impl-site reference. `impl *T : MyAlias` where
	// `interface MyAlias = pkg.Real` stores `Real` here, so vtable
	// names and lookups across alias chains agree. Slice 2.6.
	IfaceName    @[]char
	// MethodFuncs holds the qualified IR-level function name for
	// each interface method, in the interface's method-declaration
	// order. Codegen bitcasts each to i8* for storage in the i8*
	// vtable array; dispatch sites bitcast back to the right
	// signature when extracting a slot.
	MethodFuncs @[]@[]char
	// DtorFuncName: qualified dtor name for the receiver's struct
	// type, or empty if the type doesn't need destruction. Used
	// for the vtable's slot-0 dtor (Slice 2.5 of plan-interface-
	// syntax-revision.md): when @Iface goes out of scope and the
	// data refcount hits zero, ZeroRefDestroy invokes this dtor
	// to RefDec any managed fields before rt.Free.
	DtorFuncName @[]char
}

type Global struct {
	Name @[]char
	Typ  @types.Type
	Init @Instr          // constant initializer (nil = zero)
	// IsExtern marks an imported extern global (a `.bni`-declared
	// `var X T` from another package).  Codegen emits `external global`
	// with no initializer; Name is the DEFINING package's dotted
	// qualname (e.g. `pkg/x.Count`) so GlobalName mangles the decl /
	// reference to the owner's symbol, matching its definition.
	IsExtern bool
	// Exported marks a global declared in the package's `.bni` interface
	// (the export signal, set by the loader).  Drives the reflect
	// descriptor's exported-global table (the GlobalInfo emitter), which
	// the VM's RegisterPackageGlobals consumes to inject a native-only
	// package's sentinel cells for cross-mode pointer identity.
	Exported bool
}

type TypeDef struct {
	Name @[]char
	Typ  @types.Type
}

type Func struct {
	// Name is the canonical fully-qualified name for the function
	// (e.g., "asm.New", "geom.Point.M", "main.main"). For
	// already-qualified entries (cross-package imports, methods)
	// it's stored verbatim; for intra-package free functions it's
	// "<pkgShort>.<Name>" with the qualifier added by NewFunc using
	// the current module-gen context. Backends and IR-internal
	// lookups all key off this single canonical name.
	Name            @[]char
	// ModulePkgPath is the package path the func was generated in (e.g.
	// "pkg/geom"), cached at NewFunc so the @Block emit methods qualify
	// bare same-package call targets via b.Func.ModulePkgPath instead of an
	// ambient package-global — letting hundreds of EmitCall/EmitFuncValue
	// sites stay unchanged while the global goes away (plan-embeddable-vm.md
	// inc 5).  Empty for funcs created outside any module-gen context (e.g.
	// imported externs registered before GeneratePackage sets the path).
	ModulePkgPath   @[]char
	Params          @[]@Param
	Results         @[]@types.Type
	MultiReturnType @types.Type    // anonymous struct for multi-return (nil if <= 1 result)
	Blocks          @[]@Block
	IsExtern        bool
	IsLinkOnce      bool           // linkonce_odr: deduplicated by linker (for dtors)
	// IsStructDtor marks an own-package managed-struct dtor (`__dtor_<T>`).
	// Such dtors are NOT .bni-exported, but a cross-package bytecode RefDec of
	// a `@T` value calls them BY NAME — which misses if T's package is injected
	// native-only (not lowered).  So they are force-emitted a func-value handle
	// and listed in the reflect Functions table alongside exported funcs, so
	// RegisterPackageFunctions injects them and the name resolves.  Set only
	// for a package's OWN struct dtors, not element dtors (`__dtor_ms_…` etc.,
	// which a caller names locally and copies itself) nor anon/pending ones.
	IsStructDtor    bool
	IsCExtern       bool           // C-implemented extern (needs sret for large struct returns)
	Exported        bool           // declared in the package's .bni (exported surface)
	NextID          int            // next SSA value ID
	Line            int            // source line of the func decl (1-based; 0 for synthetic)

	// IsClosure marks this Func as a closure-lifted function-literal
	// body (B.2 of plan-function-values-phase-2.md).  When true:
	//   - Params[0:NumCaptureParams] are the captures, prepended
	//     to the user-declared params so the body can reference
	//     them by name as local variables.
	//   - Params[NumCaptureParams:] are the user-declared params,
	//     which form the function-value's user-visible signature.
	//   - The per-shape `__shim.<mangled>` emitted by backends
	//     must read the captures out of the closure-struct
	//     pointer it receives in the `data` arg, then call the
	//     underlying function with (captures..., user_args...).
	//   - ClosureStruct holds the struct type whose fields back
	//     each capture in source order.
	IsClosure        bool
	NumCaptureParams int
	ClosureStruct    @types.Type

	// IsManagedFuncValue marks a closure literal whose user-visible
	// function-value type is @func(...) rather than the default
	// *func(...).  B.3b of plan-function-values-phase-2.md.  When
	// true:
	//   - The closure struct is heap-allocated (EmitMake) at the
	//     literal site, NOT stack-alloc'd in the enclosing frame.
	//   - The data slot of the resulting OP_FUNC_VALUE carries the
	//     heap-allocated managed pointer; its lifetime is owned by
	//     the @func value itself, not by the enclosing frame.
	//   - emitFuncValueVtable populates the vtable's dtor slot
	//     with the closure-struct dtor symbol so the @func value's
	//     RefDec at scope end runs the dtor (which RefDec's each
	//     managed capture).
	// Always false for IsClosure=false (non-capturing literals never
	// need a heap-alloc'd data slot — their data is nil regardless
	// of the *func / @func flavour).
	IsManagedFuncValue bool
	// ClosureStructDtorName is the canonical name of the closure
	// struct's destructor (empty if the closure struct has no managed
	// fields).  Compiled puts the dtor in the func-value vtable slot;
	// the bytecode VM instead carries this name on the lowered VMFunc so
	// it can run the dtor on the heap closure struct when the @func
	// value's COMPILED_CLOSURE record is freed — otherwise the struct
	// and its captured managed values leak (the VM RefDec's the rec, not
	// the struct it points at).
	ClosureStructDtorName @[]char
	// Mod is a RAW back-reference to the @Module this func is generated into,
	// set right after NewFunc by genFuncWithPrependedParams (the sole body-gen
	// path whose cleanup emission registers pending dtors).  Raw (`*Module`,
	// not `@Module`) to break the Module⇄Func refcount cycle — the module owns
	// its funcs via Funcs @[]@Func, so a managed back-ref would leak the whole
	// module graph (mirrors @Block.Func *Func).  registerPendingMsDtor /
	// registerPendingStructDtor reach the module's pending-dtor lists through
	// it so the work-list is per-module (plan-embeddable-vm.md inc 5d), not a
	// process-global.  Nil for funcs created outside a module-gen body pass
	// (dtor/copy/thunk generators, imported externs, test funcs) — those never
	// register pending dtors, so the registrar aborts if it ever sees a nil
	// Mod rather than silently dropping a registration (which would leak).
	Mod *Module
}

type Param struct {
	Name @[]char
	Typ  @types.Type
	ID   int
}

type Block struct {
	Label  @[]char
	Instrs @[]@Instr
	// Func is the function this block belongs to. Raw pointer
	// (not @Func) to break the parent→child→parent cycle that
	// would otherwise leak refcounts: Func owns Blocks via
	// `Func.Blocks @[]@Block`; the back-pointer here is safe
	// because a Block can't outlive its owning Func.
	Func *Func
}

type Instr struct {
	ID      int           // SSA value ID (-1 for void)
	Op      int
	Typ     @types.Type   // result type

	// Operands (usage depends on Op)
	Args    @[]@Instr     // input values
	Block1  @Block        // branch target / then
	Block2  @Block        // else / continue

	// Phi entries
	Phis    @[]PhiEntry

	// Immediates.  IntVal is int64 (not host `int`) so a program
	// integer constant — which may be 64-bit regardless of the
	// compiler's host word size — is stored as a fixed-width bit
	// pattern, reinterpreted by the instruction's type.
	IntVal  int64
	StrVal  @[]char
	BoolVal bool
	Index   int
	// IfaceUpcastSlotOffset is meaningful only for OP_IFACE_UPCAST: the
	// target (parent) interface's vtable slot offset (in slots) within the
	// source interface's concat-vtable, precomputed at IR-gen time by
	// EmitIfaceUpcast (via IfaceParentSlotOffset) so the compiled backends
	// (LLVM / x64 / aarch64) don't need the interface registry at emit
	// time — their per-instruction emitters have no @Module in hand.  -1
	// marks an invalid upcast (target not an ancestor of source); backends
	// abort on it rather than emit a negative vtable GEP.
	IfaceUpcastSlotOffset int

	// Type operand
	TypeArg @types.Type

	// CFixedArgs is meaningful only for OP_C_CALL: the count of fixed
	// (named) arguments.  The call is variadic iff CFixedArgs <
	// len(Args).  See explorations/plan-c-call.md.
	CFixedArgs int

	// RetbufSize is meaningful for the cross-mode call ops
	// (OP_CALL_FUNC_VALUE / OP_CALL_HANDLE / OP_CALL_IFACE_METHOD): the
	// aggregate retbuf byte size (rounded to N*8) when the callee returns
	// via a retbuf, or 0 for a scalar return.  Stamped at IR-gen from the
	// callee's result list (where it is available) via
	// types.AggregateReturnSize, since the VM's cross-mode shim dispatch
	// cannot recover it from the lowered (collapsed) result type.  A
	// nonzero value is itself the scalar-vs-aggregate discriminator.
	RetbufSize int

	// Source position (for debug info)
	Line int

	// IsGlobalRef marks the pseudo-Instr produced by lookupVar's
	// fallback-to-global path — distinguishes it from a real local
	// alloca that happens to have the same name as a package-level
	// global (which can occur for parameters, e.g.
	// `func MakeAliasType(name @[]char, target @Type)` where the
	// `target` parameter shadows pkg/binate/types' `var target TargetInfo`).
	// Backends use this to route the reference to global storage
	// instead of the local stack slot.
	IsGlobalRef bool

	// ParamIndex marks an OP_ALLOC that holds a function parameter
	// (1-based; 0 = not a param). Set by genFunc when allocating
	// the per-param stack slot. Used by the LLVM backend's debug-info
	// path to emit `arg: <N>` on the param's DILocalVariable, so
	// lldb shows it as a function argument rather than a local.
	ParamIndex int

	// IsByvalParamRef marks a placeholder Instr that references a
	// byval-eligible aggregate parameter (set by genFunc on the
	// paramRef passed to the entry-block EmitStore-into-paramSlot).
	// LLVM-IR lowering for OP_STORE checks this flag and emits a
	// scalar-store sequence (one load+store per scalar leaf, via
	// emitFieldwiseCopy) from the byval pointer to the slot
	// alloca instead of a `store <T> <val>, ptr <slot>` (which
	// would type-mismatch — the byval-param's LLVM IR type is
	// `ptr`, not the struct type).
	IsByvalParamRef bool
}

type PhiEntry struct {
	Block @Block
	Val   @Instr
}

// ============================================================
// Module
// ============================================================

// NewModule creates a new IR module with the given name.
func NewModule(name @[]char) @Module
// AddFunc adds a function to the module.
func (m @Module) AddFunc(f @Func)
// AddGlobal adds a global variable to the module.
func (m @Module) AddGlobal(g @Global)
// AddTypeDef adds a type definition to the module.
func (m @Module) AddTypeDef(td @TypeDef)

// ============================================================
// Function
// ============================================================

// NewFunc creates a new function.  pkgPath qualifies a bare name (and is
// cached on the func as ModulePkgPath so the emit methods qualify bare
// call targets); pass "" for an already-qualified or context-free name.
func NewFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func
// NewExternFunc creates a new extern (declaration-only) function.
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func
// AddBlock appends a new basic block with the given label to the function.
func AddBlock(f @Func, label *[]readonly char) @Block

// ============================================================
// Param
// ============================================================

// NewParam creates a new function parameter and assigns it an SSA ID.
func NewParam(f @Func, name @[]char, typ @types.Type) @Param

// ============================================================
// Block
// ============================================================

// Emit instructions into a block. Each returns the instruction (for use
// as an operand in subsequent instructions).

// Constants
// EmitConstInt emits an integer constant from a host-`int` value
// (sizes, lengths, indices, small constants).  Widens to the int64
// IntVal slot.  For a program literal whose value may exceed the
// host word, use EmitConstInt64.
func (b @Block) EmitConstInt(val int, typ @types.Type) @Instr

// EmitConstInt64 emits an integer constant from a fixed-width int64
// value — the literal-value path, where the constant may be 64-bit
// regardless of the compiler's host word size.
func (b @Block) EmitConstInt64(val int64, typ @types.Type) @Instr
// EmitConstFloat emits a floating-point constant from its raw literal
// text; backends parse the text at lowering time.
func (b @Block) EmitConstFloat(text @[]char, typ @types.Type) @Instr
// EmitConstBool emits a boolean constant.
func (b @Block) EmitConstBool(val bool) @Instr
// EmitConstString emits a string literal constant.
func (b @Block) EmitConstString(val @[]char) @Instr
// EmitConstNil emits a typed nil constant.
func (b @Block) EmitConstNil(typ @types.Type) @Instr

// Binary operations
// EmitBinop emits a binary operation (arithmetic, bitwise, comparison, or logical).
func (b @Block) EmitBinop(op int, lhs @Instr, rhs @Instr, typ @types.Type) @Instr

// Unary operations
// EmitUnary emits a unary operation (negation, logical not, or bitwise not).
func (b @Block) EmitUnary(op int, arg @Instr, typ @types.Type) @Instr

// Memory
// EmitAlloc emits a stack allocation for the given element type.
func (b @Block) EmitAlloc(elemTyp @types.Type) @Instr
// EmitLoad emits a load from a pointer.
func (b @Block) EmitLoad(ptr @Instr, typ @types.Type) @Instr
// EmitStore emits a store of a value to a pointer.
func (b @Block) EmitStore(ptr @Instr, val @Instr)
// EmitGetFieldPtr emits a struct field pointer access by field index.
func (b @Block) EmitGetFieldPtr(ptr @Instr, index int, fieldTyp @types.Type) @Instr
// EmitGetElemPtr emits an array/slice element pointer access by index.
func (b @Block) EmitGetElemPtr(ptr @Instr, index @Instr, elemTyp @types.Type) @Instr

// Managed pointers
// EmitBox emits a box operation that wraps a value in a managed pointer.
func (b @Block) EmitBox(val @Instr, ptrTyp @types.Type) @Instr
// EmitMake emits a make operation that allocates a zero-initialized managed value.
func (b @Block) EmitMake(typ @types.Type) @Instr
// EmitMakeSlice emits a make_slice operation that allocates a managed-slice.
func (b @Block) EmitMakeSlice(elemTyp @types.Type, length @Instr) @Instr
// EmitDeref emits a dereference of a pointer to load the pointed-to value.
func (b @Block) EmitDeref(ptr @Instr, elemTyp @types.Type) @Instr
// EmitNilCheck emits a nil check that panics if the pointer is nil.
func (b @Block) EmitNilCheck(ptr @Instr)
// EmitRefInc emits OP_REFINC: an inline refcount increment that backends
// lower to a nil-check + header load/add/store (no rt.RefInc call).
func (b @Block) EmitRefInc(ptr @Instr)
// EmitRefDec emits OP_REFDEC: an inline-fast-path refcount decrement
// for a managed pointer with no destructor. Backends inline the fast
// path; the slow path calls rt.ZeroRefDestroy(ptr, null).
func (b @Block) EmitRefDec(ptr @Instr)
// EmitRefDecDtor emits OP_REFDEC with a destructor. Same lowering as
// EmitRefDec; the slow-path call is rt.ZeroRefDestroy(ptr, dtor).
func (b @Block) EmitRefDecDtor(ptr @Instr, dtor @Instr)

// Slices & arrays (lowered to primitive ops: extract, GEP, load/store)
func (b @Block) EmitSliceLen(slice @Instr) @Instr
// EmitSliceGet emits a read from a slice element at the given index.
func (b @Block) EmitSliceGet(slice @Instr, index @Instr, elemTyp @types.Type) @Instr
// EmitSliceSet emits a write to a slice element at the given index.
func (b @Block) EmitSliceSet(slice @Instr, index @Instr, val @Instr, elemTyp @types.Type)
// EmitSliceExpr emits a subslice expression (s[lo:hi]).
func (b @Block) EmitSliceExpr(slice @Instr, lo @Instr, hi @Instr, typ @types.Type) @Instr
// EmitBoundsCheck emits a bounds check that panics if index is out of range.
func (b @Block) EmitBoundsCheck(index @Instr, length @Instr)

// Rodata composite-literal constructors. Each carries its byte
// sequence on the resulting Instr's StrVal.
// EmitRodataMSlice — `@[]readonly T` aliasing a static rodata global.
func (b @Block) EmitRodataMSlice(bytes @[]char, sliceTyp @types.Type) @Instr
// EmitRodataSlice — `*[]readonly T` aliasing a static rodata global.
func (b @Block) EmitRodataSlice(bytes @[]char, sliceTyp @types.Type) @Instr
// EmitRodataArray — `[N]T` initialized via memcpy from rodata, zero-padded.
func (b @Block) EmitRodataArray(bytes @[]char, arrayTyp @types.Type) @Instr
// EmitRodataMSliceCopy — owned `@[]T` whose backing is allocated and
// memcpy'd from rodata (Stage 2b semantics).
func (b @Block) EmitRodataMSliceCopy(bytes @[]char, sliceTyp @types.Type) @Instr

// Control flow
// EmitJump emits an unconditional jump to the target block.
func (b @Block) EmitJump(target @Block)
// EmitBranch emits a conditional branch on cond to thenBlk or elseBlk.
func (b @Block) EmitBranch(cond @Instr, thenBlk @Block, elseBlk @Block)
// EmitReturn emits a return with the given values.
func (b @Block) EmitReturn(vals @[]@Instr)
// EmitUnreachable emits an unreachable terminator.
func (b @Block) EmitUnreachable()

// SSA
// EmitPhi emits a phi node that merges values from predecessor blocks.
func (b @Block) EmitPhi(typ @types.Type, entries @[]PhiEntry) @Instr

// Calls
// EmitCall emits a direct function call.
func (b @Block) EmitCall(name @[]char, args @[]@Instr, resultTyp @types.Type) @Instr
// EmitCallIndirect emits an indirect call through fnPtr (*uint8).
// The signature is reconstructed from resultTyp and the arg Instrs' types.
func (b @Block) EmitCallIndirect(fnPtr @Instr, args @[]@Instr, resultTyp @types.Type) @Instr
// EmitFuncValue emits a function-value construction op for a named
// function. resultTyp must be TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE.
// The result is a 2-word value referencing the function's vtable
// (with data_ptr nil in compiled mode, or pointing at the VM closure
// record in VM mode — see plan-function-values.md).
func (b @Block) EmitFuncValue(name @[]char, resultTyp @types.Type) @Instr
// EmitFuncValueWithData emits a function-value construction op
// whose data slot is the given pointer.  Used by capturing
// function-literal codegen (B.2 of plan-function-values-phase-2.md);
// `data` is a pointer to the alloca'd closure struct.  The
// underlying function must have IsClosure=true so the per-shape
// shim emitter knows to read captures out of data.
func (b @Block) EmitFuncValueWithData(name @[]char, data @Instr, resultTyp @types.Type) @Instr
// EmitIfaceValue emits an OP_IFACE_VALUE for interface-value
// construction. dataPtr is the source pointer (placed in slot 0);
// vtableName is the mangled name of the selected `@__ivt.<...>`
// global; resultTyp is TYP_INTERFACE_VALUE or
// TYP_INTERFACE_VALUE_MANAGED. See plan-interface-syntax-
// revision.md (Slice 2.3a-2).
func (b @Block) EmitIfaceValue(dataPtr @Instr,
	vtableName @[]char, resultTyp @types.Type) @Instr
// EmitCallIfaceMethod emits an OP_CALL_IFACE_METHOD for interface
// method dispatch. iv is the interface value; args are the user
// arguments; methodIdx is the slot in the interface's method-
// declaration order; resultTyp is the method's return type. See
// plan-interface-syntax-revision.md (Slice 2.3a-3).
func (b @Block) EmitCallIfaceMethod(iv @Instr,
	args @[]@Instr, methodIdx int, resultTyp @types.Type) @Instr
// EmitIfaceDtor emits an OP_IFACE_DTOR that loads slot 0 (the
// receiver's dtor) of iv's vtable. Used by @Iface scope-exit
// cleanup so refcount-zero invokes the receiver type's struct
// destructor. The result has type *uint8 — same shape as
// EmitFuncHandle — and feeds into EmitRefDecDtor.
func (b @Block) EmitIfaceDtor(iv @Instr) @Instr
// EmitFuncValueDtor emits an OP_FUNC_VALUE_DTOR that loads slot 0
// (the closure-struct dtor) of fv's vtable.  Used by @func scope-
// exit cleanup so the @func variable's RefDec on its data slot
// invokes the closure-struct's dtor (which RefDec's each managed
// capture) before freeing the heap-allocated closure struct.  Same
// shape as EmitIfaceDtor — result type is *uint8 and feeds straight
// into EmitRefDecDtor.  B.3b commit 2 of plan-function-values-
// phase-2.md.
func (b @Block) EmitFuncValueDtor(fv @Instr) @Instr
// EmitIfaceUpcast emits an OP_IFACE_UPCAST that rebuilds an
// interface value with the source's data ptr and the target
// interface's vtable.  Used to lower `*Child → *Parent` /
// `@Child → @Parent` upcasts (plan-interface-embedding.md Slice
// E.4 part 2b).  targetVtableName is the `__ivt.<...>` global
// for the target.  Also precomputes the parent vtable slot offset onto
// the instr's IfaceUpcastSlotOffset (so backends need no iface registry
// at emit time — see that field).  m identifies the module whose
// interface registry the precompute keys on.
func (b @Block) EmitIfaceUpcast(m @Module, src @Instr,
	targetVtableName @[]char, resultTyp @types.Type) @Instr
// IfaceMethodCount returns the number of methods declared on the
// interface (pkg, name) — follows alias chains; returns 0 if the
// interface isn't registered in the per-module interface registry
// (built up by GeneratePackage and registerImportFieldsAndFuncs).
// Slice 2.8: codegen uses this to size imported-vtable
// declarations.  m names the module whose interface registry the
// (pkg, name) lookup keys on (shared by the Iface* query family
// below).
func IfaceMethodCount(m @Module, pkg *[]readonly char,
	name *[]readonly char) int
// IfaceOwnMethodNames returns the OWN methods of the interface
// (pkg, name) in declaration order — the same list IR-gen
// records during DECL_INTERFACE collection.  Empty for unknown
// or alias-target-missing entries.  plan-interface-embedding.md
// Slice E.3.
func IfaceOwnMethodNames(m @Module, pkg *[]readonly char,
	name *[]readonly char) @[]@[]char
// IfaceParentPkgs / IfaceParentNames are parallel arrays naming
// each parent interface of (pkg, name) in declaration order
// (`interface X : P1, P2`).  Empty for non-extending interfaces
// or unknown lookups.  Slice E.3.
func IfaceParentPkgs(m @Module, pkg *[]readonly char,
	name *[]readonly char) @[]@[]char
func IfaceParentNames(m @Module, pkg *[]readonly char,
	name *[]readonly char) @[]@[]char
// IfaceFullVtableSize returns the number of slots a `(R, X)`
// vtable occupies under the concat layout:
//   size(X) = 1 (any-block) + sum(size(P) for P in X.Parents)
//                           + len(X's own methods)
// Returns 0 if the interface isn't registered.  Slice E.3.
func IfaceFullVtableSize(m @Module, pkg *[]readonly char,
	name *[]readonly char) int
// IfaceAncestorClosure walks the ancestor closure of (pkg, name)
// via the Parents relation and returns deduped canonical names
// in DFS preorder.  The interface itself is NOT included — only
// its strict ancestors.  Call IfaceAncestorClosurePkgs with the
// same args for the parallel pkgs slice.
func IfaceAncestorClosure(m @Module, pkg *[]readonly char,
	name *[]readonly char) @[]@[]char
func IfaceAncestorClosurePkgs(m @Module, pkg *[]readonly char,
	name *[]readonly char) @[]@[]char
// IfaceParentSlotOffset returns the absolute slot index at which
// target's full vtable starts within src's concat vtable, or -1
// if target is not a (transitive) parent of src.  Used to lower
// OP_IFACE_UPCAST.  Slice E.4 part 2b.
func IfaceParentSlotOffset(m @Module, srcPkg *[]readonly char,
	srcName *[]readonly char,
	targetPkg *[]readonly char,
	targetName *[]readonly char) int
// EmitCallFuncValue emits a call through a function value. fnVal's
// type must be TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE; resultTyp is
// the return type derived from the function-value type.
func (b @Block) EmitCallFuncValue(fnVal @Instr,
	args @[]@Instr, resultTyp @types.Type) @Instr

// Conversions
// EmitCast emits a numeric type cast.
func (b @Block) EmitCast(val @Instr, targetTyp @types.Type) @Instr
// EmitBitCast emits a reinterpret (bit) cast to the target type.
func (b @Block) EmitBitCast(val @Instr, targetTyp @types.Type) @Instr

// Struct
// EmitStructLit emits a struct literal construction from field values.
func (b @Block) EmitStructLit(fields @[]@Instr, structTyp @types.Type) @Instr
// EmitExtract emits an extraction of a single value from a multi-return result.
func (b @Block) EmitExtract(multi @Instr, index int, typ @types.Type) @Instr

// Lifetime
// EmitSPRestore emits a statement-end marker that lets the VM reclaim
// vm.Stack temporaries pushed during the statement (aggregate return
// copy-backs, BC_MAKE_SLICE / BC_STRING_COPY* / BC_FUNC_VALUE pushes).
// No-op in the LLVM and native backends. See the OP_SP_RESTORE comment
// above for the full rationale.
func (b @Block) EmitSPRestore()

// ============================================================
// String Constants
// ============================================================

type StringConst struct {
	ID   int
	Data @[]char
	Len  int
}

// CollectStrings gathers all string constants from the module and assigns IDs.
func (m @Module) CollectStrings() @[]StringConst
// FinalizeStrings collects string constants and stores them on the module.
func (m @Module) FinalizeStrings()
// FindStringID returns the ID of a string constant matching data, or -1 if not found.
func FindStringID(strings *[]StringConst, data *[]readonly char) int

// ============================================================
// Static data manifest (DataGlobal)
// ============================================================
//
// A backend-neutral description of one named static blob.  Both the LLVM
// and native backends lower a DataGlobal through a single emitDataGlobal,
// so the byte layout is described ONCE and cannot drift between backends —
// the unification that replaces the per-kind, per-backend static-data
// emitters (string constants, package globals, vtables, the __Package
// reflect descriptor).  See plan-codegen-data-global.md / todo #119.

// DataTerm kinds — which payload field of a DataTerm is meaningful.
const (
	DT_BYTES  int = 0   // raw bytes (Bytes)
	DT_INT    int = 1   // fixed-width little-endian integer (Width bytes, IntVal)
	DT_SYMREF int = 2   // pointer to another symbol Sym (+ Addend); empty Sym = null
	DT_ZERO   int = 3   // Width zero bytes (padding / uninitialized)
)

// DataGlobal linkage kinds — mapped to each backend's spelling by
// emitDataGlobal (LLVM linkage keyword / native symbol binding).
const (
	DG_WEAK   int = 0   // LLVM weak_odr  / native weak  — ODR-dedup across TUs
	DG_LOCAL  int = 1   // LLVM private   / native local — TU-private
	DG_GLOBAL int = 2   // LLVM (external def) / native global — strong
)

// DataTerm is one element of a DataGlobal's contiguous initializer.
// Exactly one payload field is meaningful, selected by Kind.
type DataTerm struct {
	Kind   int
	Bytes  @[]uint8   // DT_BYTES
	Width  int        // DT_INT: byte width (1/2/4/8) ; DT_ZERO: byte count
	IntVal uint64     // DT_INT: value (bit_cast a signed value in)
	Sym    @[]char    // DT_SYMREF: target symbol (already mangled)
	Addend int        // DT_SYMREF: addend added to the resolved address
}

// DataGlobal is a backend-neutral named static blob: an Init sequence of
// terms laid out contiguously, with linkage + alignment + a read-only
// (rodata/constant vs data/mutable) hint.
type DataGlobal struct {
	Name        @[]char
	Linkage     int          // DG_*
	Align       int          // byte alignment (>= 1)
	ReadOnly    bool         // true -> rodata / LLVM `constant`
	UnnamedAddr bool         // true -> LLVM `unnamed_addr` (address not significant;
	                         // lets LLVM merge identical constants).  Native: no-op.
	Init        @[]@DataTerm
}

// DataBytes / DataInt / DataSymref / DataZero construct the four DataTerm
// kinds; NewDataGlobal makes a DataGlobal with an empty Init (append terms
// via slices.Append).  See ir/data_global.bn.
func DataBytes(bytes @[]uint8) @DataTerm
func DataInt(width int, val uint64) @DataTerm
func DataSymref(sym @[]char, addend int) @DataTerm
func DataZero(n int) @DataTerm
func NewDataGlobal(name @[]char, linkage int, align int, ro bool) @DataGlobal

// BuildFuncValue builds the [vtable, handle] DataGlobal pair for one function
// value: `@__vt` = { dtor, call } and `@__handle` = { vtable, data=null }, both
// weak.  The gather supplies the symbol names + the call target (shim, or the
// function itself for a universal trampoline) + the closure-struct dtor handle
// (dtorSym empty -> null dtor slot).  See ir/data_funcval.bn.
func BuildFuncValue(vtSym @[]char, dtorSym @[]char, callSym @[]char,
	handleSym @[]char) @[]@DataGlobal

// BuildImplVtable builds one interface-impl vtable (`@__ivt` raw or
// `@__ivtshim` shim) from its ordered slot symbols (empty entry -> null slot),
// weak.  The gather walks the iface hierarchy to produce the slots.  See
// ir/data_impl_vtable.bn.
func BuildImplVtable(vtSym @[]char, slots @[]@[]char) @DataGlobal

// BuildStringBlob builds the read-only byte blob (bare `[N x i8]`, no NUL,
// private unnamed_addr, align 1) for a string constant.  See ir/data_strings.bn.
func BuildStringBlob(blobSym @[]char, data @[]char) @DataGlobal

// BuildStringMSHeader builds the static managed-slice `.ms` header { data, len,
// null refptr, backing_len=len } aliasing a string blob, with caller-chosen
// linkage (LLVM private / native weak).  See ir/data_strings.bn.
func BuildStringMSHeader(msSym @[]char, blobSym @[]char, length int,
	linkage int) @DataGlobal

// BuildGlobalVar builds the DataGlobal for one package-level `var` (mutable,
// strong, `size` zero bytes, `align`).  See ir/data_globalvar.bn.
func BuildGlobalVar(sym @[]char, size int, align int) @DataGlobal

// BuildPackageDescriptor builds the DataGlobals for the per-package
// reflect.Package descriptor node + its name bytes (the single source of
// truth for that layout; both backends lower the result via emitDataGlobal).
// See ir/data_pkg_descriptor.bn.
func BuildPackageDescriptor(refcount int, infoSym @[]char, nameSym @[]char,
	nameBytes @[]uint8, funcsSym @[]char, funcCount int,
	globalsSym @[]char, globalCount int, vtablesSym @[]char,
	vtableCount int) @[]@DataGlobal

// Per-package reflect-descriptor info-table entries.  Each backend's gather
// pass computes its own (format-prefixed) symbol names + the backend-neutral
// payload scalars for one table row, then BuildPackageDescriptors lays the
// row's rodata + static-managed node bytes ONCE — so the FunctionInfo /
// GlobalInfo / VtableInfo node layout cannot drift between backends.  All
// owned-slice fields must outlive the returned DataGlobals (the caller copies
// borrowed source strings in).

// PkgFuncEntry is one reflect.FunctionInfo row: the __fninfo node + __fnname /
// __fnsig rodata symbols, the fully-qualified Name + signature bytes, the
// @__handle.<mangled> function-value block (the Value target), and the
// precomputed VM-dispatch RetbufSize / ParamSlots.
type PkgFuncEntry struct {
	NodeSym    @[]char
	NameSym    @[]char
	Name       @[]char
	SigSym     @[]char
	Sig        @[]char
	HandleSym  @[]char
	RetbufSize int
	ParamSlots int
}

// PkgGlobalEntry is one reflect.GlobalInfo row: the __glinfo node + __glname
// rodata symbols, the fully-qualified Name bytes, and the global's storage
// cell symbol (the Addr target — a raw `var` cell, no managed header).
type PkgGlobalEntry struct {
	NodeSym    @[]char
	NameSym    @[]char
	Name       @[]char
	StorageSym @[]char
}

// PkgVtableEntry is one reflect.VtableInfo row: the __vtinfo node + __vtname
// rodata symbols, the bare vtable Name bytes (the VM's findIfaceVtable key),
// and the @__ivt / @__ivtshim vtable globals (the Addr / ShimAddr targets —
// raw constant arrays, no managed header).
type PkgVtableEntry struct {
	NodeSym   @[]char
	NameSym   @[]char
	Name      @[]char
	VtableSym @[]char
	ShimSym   @[]char
	// SlotCount is the @__ivt / @__ivtshim slot count (dtor + concat method set);
	// emitted as reflect.VtableInfo.SlotCount so the VM can bound each vtable's
	// extent for the offset>0 upcast shim range-lookup.
	SlotCount int
}

// NewPkgFuncEntry / NewPkgGlobalEntry / NewPkgVtableEntry construct an entry
// from its fields (so callers don't hand-assemble the struct).  See
// ir/data_pkg_funcs.bn, ir/data_pkg_globals.bn, ir/data_pkg_vtables.bn.
func NewPkgFuncEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
	sigSym @[]char, sig @[]char, handleSym @[]char, retbufSize int,
	paramSlots int) @PkgFuncEntry
func NewPkgGlobalEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
	storageSym @[]char) @PkgGlobalEntry
func NewPkgVtableEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
	vtableSym @[]char, shimSym @[]char, slotCount int) @PkgVtableEntry

// BuildPackageDescriptors builds the FULL ordered DataGlobal list for a
// module's reflect.Package descriptor: per func/global/vtable entry its rodata
// + static-managed info node, then each table's backing pointer array, then
// the descriptor node + name bytes (BuildPackageDescriptor's pair) LAST.  The
// emission order matches the per-backend gather order, so the native object is
// byte-identical to the pre-DataGlobal layout (modulo symbol-name prefixes).
// The single source of truth for the whole descriptor's byte layout; both
// backends lower the result via emitDataGlobal.  See ir/data_pkg_descriptor.bn.
func BuildPackageDescriptors(refcount int, infoSym @[]char, nameSym @[]char,
	nameBytes @[]char, funcsSym @[]char, funcs @[]@PkgFuncEntry,
	globalsSym @[]char, globals @[]@PkgGlobalEntry, vtablesSym @[]char,
	vtables @[]@PkgVtableEntry) @[]@DataGlobal

// LookupModuleFunc returns the @Func with the given name in m.Funcs,
// or nil.  Public so codegen / vm can resolve names without
// duplicating the linear scan.
func LookupModuleFunc(m @Module, name *[]readonly char) @Func

// LookupVtableSlotName returns the symbol name a vtable slot for
// `methodFuncName` should point at: the iv-dispatch thunk's name
// when methodFuncName resolves to a value-receiver method, or
// methodFuncName itself otherwise.  Single source of truth for
// the codegen vtable emitter and the VM vtable-lowering pass.
// See plan-primitives-impl-interfaces.md § "Interface-value
// dispatch and value receivers".
func LookupVtableSlotName(m @Module, methodFuncName @[]char) @[]char

// ============================================================
// Helpers
// ============================================================

// IsTerminator reports whether the instruction is a block terminator.
func (instr @Instr) IsTerminator() bool

// ============================================================
// IR Generation
// ============================================================

// GenModule lowers an AST file into a complete IR module, recording `c`
// as the module's type-Checker (m.Checker).
func GenModule(c @types.Checker, file @ast.File) @Module
// InitModule creates a new empty module for incremental IR generation.
// Callers set m.Checker (the type-Checker that produced the typed AST)
// before any GeneratePackage / GenDecl on the module so IR-gen can
// consult per-expression resolved types; nil is safe (legacy fallback).
func InitModule(name @[]char) @Module
// AliasMapSnapshot captures a module's ImportAliasNames/Paths for
// SaveAliasMapState / RestoreAliasMapState — used to bracket a scope that
// temporarily overlays a different package's imports on the module's alias
// map (monomorphized generic-body emission; the per-file import overlay) and
// restore it afterward.
type AliasMapSnapshot struct {
	Names @[]@[]char
	Paths @[]@[]char
}

// SaveAliasMapState captures m's import-alias map (m.ImportAliasNames /
// m.ImportAliasPaths) into a snapshot, without applying any overlay.
func SaveAliasMapState(m @Module) AliasMapSnapshot

// RestoreAliasMapState writes a snapshot back over m's import-alias map.
// Paired with SaveAliasMapState to restore the map after a temporary import
// overlay (the generic-instantiation passes and overlayFileImports).  m is
// the module whose alias map is restored.
func RestoreAliasMapState(m @Module, snap AliasMapSnapshot)

// RecordImportPath maps an import alias to its full package path so
// cross-package symbols mangle under the importee's path. Normally
// invoked from RegisterImports' Pass 0; exposed for callers that
// need to seed the alias map directly.  m is the module whose alias
// map the (alias, path) pair is recorded into.
func RecordImportPath(m @Module, alias *[]readonly char,
	path *[]readonly char)
// GenCtx is the per-compilation transient IR-generation context: the
// state scoped to one compilation (a package's full
// register-imports → register-self-types → GeneratePackage sweep, or a
// REPL session) rather than to a single function (that is the
// package-private GenContext).  The caller creates one per compilation
// and threads it through every gen entry point below, so the import
// pre-passes and GeneratePackage share one context.  Reentrancy carrier
// (plan-embeddable-vm.md inc 5): it carries what used to be process-global
// ambient IR-gen state so two sequential or interleaved compilations in
// one process don't share it.
type GenCtx struct {
	// Mod is the IR Module being populated by this compilation.
	// nil outside any module-gen context.
	Mod @Module
	// PkgPath is the package path used to qualify bare same-package
	// names during this gen phase.  It is phase-scoped, NOT always
	// Mod.PkgPath: GeneratePackage / GenModule set it from the module's
	// path, RegisterSelfTypes sets it from the .bni's path for the
	// duration of that pass, and the import pre-passes leave it empty.
	PkgPath @[]char
	// AnonStructCounter assigns synthetic `__anon_<n>` names to anonymous
	// struct types during this compilation.
	AnonStructCounter int
	// FuncLitCounter assigns synthetic `__funclit_<n>` ids to lifted
	// function literals (and `__mv_local_..._<n>` method-value closures)
	// during this compilation.  Reset at the start of each
	// GeneratePackage / GenModule (resetFuncLitState) so each package's
	// ids start at 0.
	FuncLitCounter int
	// CurrentTypeParamNames / CurrentTypeParamTypes are the active
	// generic-instantiation substitution context: while IR-gen emits a
	// specialized instantiation `f[T1, ...]`, Names lists the AST-level
	// type-param names and Types the parallel concrete @types.Type to
	// substitute (resolveTypeExpr consults them).  Empty outside any
	// instantiation; saved/restored around each ensureInstantiated*.
	CurrentTypeParamNames @[]@[]char
	CurrentTypeParamTypes @[]@types.Type
	// EmittedInstantiations records every monomorphized generic
	// instantiation already emitted this compilation, keyed by mangled
	// name, so a call site emits one IR func per unique `f[T](...)`.
	EmittedInstantiations @[]@[]char
	// GenericDecls / GenericDeclPkgs are the parallel per-compilation
	// registry of generic function AST decls and each decl's defining
	// package (current module's pkg for local decls, the import alias for
	// imported ones); lookupGenericDeclPkg disambiguates by both.
	GenericDecls @[]@ast.Decl
	GenericDeclPkgs @[]@[]char
	// GenericTypeDecls / GenericTypeDeclPkgs: same, for generic struct decls.
	GenericTypeDecls @[]@ast.Decl
	GenericTypeDeclPkgs @[]@[]char
	// GenericIfaceDecls / GenericIfaceDeclPkgs: same, for generic interface decls.
	GenericIfaceDecls @[]@ast.Decl
	GenericIfaceDeclPkgs @[]@[]char
	// GenericDeclFiles / GenericTypeDeclFiles / GenericIfaceDeclFiles record,
	// parallel to the matching decl registries above, the AST file each generic
	// decl was defined in — so its body's package-qualified references are
	// lowered against THAT file's imports at the (later, possibly cross-package)
	// instantiation site, not the consumer's alias map.  Without this a generic
	// body that calls `dep.X()` / names `dep.T` (dep imported by the generic's
	// package, not the consumer) mis-resolves: dangling symbol or wrong-package
	// layout.  See lookupGenericDeclFile and ensureInstantiated*.
	GenericDeclFiles @[]@ast.File
	GenericTypeDeclFiles @[]@ast.File
	GenericIfaceDeclFiles @[]@ast.File
	// InitOverlay{Files,Merged,Base} drive a per-STATEMENT import overlay while
	// lowering the synthetic package `__init` body.  That body COMBINES every
	// file's top-level `var x = expr` initializers into one function, so a single
	// merged overlay mis-resolves a cross-file same-alias initializer (file a:
	// `import dep "pkg/p1"; var A = dep.V()`; file b: `import dep "pkg/p2"; var B
	// = dep.V()` — both `dep` collapse to one package).  When InitOverlayMerged
	// is non-nil, genBlock switches the overlay to each init statement's own file
	// (by `Pos.File`, via declImportFile(Files, Merged, ...) restored onto Base)
	// before lowering it — the @init analogue of the GenericDeclFiles fix above.
	InitOverlayFiles @[]@ast.File
	InitOverlayMerged @ast.File
	InitOverlayBase AliasMapSnapshot
}
// NewGenCtx creates a per-compilation gen context bound to module m,
// seeding PkgPath from m.PkgPath (empty when m is nil or its path isn't
// set yet — e.g. during import registration before GeneratePackage).
func NewGenCtx(m @Module) @GenCtx
// RegisterImport registers a single imported package for IR generation.
// path is the import path (e.g. "pkg/binate/loader") — used to seed the
// alias→path map; for a cmd package whose declared name is "main"
// the path is what the importee compiles under (e.g. "cmd/bnc"), not
// file.PkgName, so passing it explicitly avoids the "main"-derived
// misqualification.
func RegisterImport(alias @[]char, path *[]readonly char,
		file @ast.File, gc @GenCtx)
// RegisterImports registers multiple imported packages for IR
// generation. paths is parallel to aliases (same length, same order)
// and carries each import's path (see RegisterImport).
func RegisterImports(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx)
// RegisterStructTypes registers struct types from imported packages
// into the type system. paths is parallel to aliases and used
// DIRECTLY for qualified-name construction (so two packages sharing
// a last-segment short alias still get distinct qualifiers).
func RegisterStructTypes(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx)
// RegisterAllInterfaces registers DECL_INTERFACE entries from
// every loaded package (including transitive deps), so cross-
// package alias-chain resolution works even when the importing
// TU doesn't reference the alias's underlying interface package
// directly. Slice 2.9 of plan-cross-package-interfaces.md.
// paths is parallel to aliases and used directly for the
// interface's Pkg field (so two packages sharing a last-segment
// short alias still record distinct interfaces).
func RegisterAllInterfaces(aliases @[]@[]char, paths @[]@[]char,
	files *[]@ast.File, gc @GenCtx)
// RegisterFuncExterns registers ONLY function/method signatures + extern
// Funcs for the given packages (keyed by full path via `paths`), deduped
// against already-registered sigs.  For packages a monomorphized cross-package
// generic body may CALL but that the consumer does not directly import: their
// structs/interfaces are registered transitively (RegisterStructTypes /
// RegisterAllInterfaces), so only the func externs — the `declare`s the body's
// calls need to link — are missing.  Without these, a generic body calling
// `dep.V()` from a package the consumer does not import emits a call to an
// undeclared symbol (LLVM "use of undefined value"); the VM is unaffected.
func RegisterFuncExterns(aliases @[]@[]char, paths @[]@[]char,
	files *[]@ast.File, gc @GenCtx)
// RegisterGenericDecls stashes generic func/struct/interface decls for the
// given packages (keyed by full path via `paths`), deduped via the
// lookupGeneric*DeclPkg checks.  RegisterImport stashes generic decls only
// for the consumer's DIRECT imports; a generic body that instantiates ANOTHER
// package's generic (a transitive, not direct, import) needs that package's
// generic decl available to monomorphize it.  Registers ONLY generic decls;
// non-generic structs/sigs/consts/interfaces are handled elsewhere
// (RegisterStructTypes / RegisterImports / RegisterFuncExterns).
func RegisterGenericDecls(aliases @[]@[]char, paths @[]@[]char,
	files *[]@ast.File, gc @GenCtx)
// RegisterImportedImpls collects the given packages' impls into
// gc.Mod.ImportedImpls (deduped), so a generic body monomorphized at the
// consumer can upcast a receiver to an interface defined in a TRANSITIVELY-
// imported package — the upcast needs the imported impl's vtable symbol wired.
// collectImportedImplsFromDecl otherwise runs only over direct imports; without
// this a transitive-package upcast inside a monomorphized generic body produced
// a nil vtable (SIGSEGV).
func RegisterImportedImpls(aliases @[]@[]char, paths @[]@[]char,
	files *[]@ast.File, gc @GenCtx)
// RegisterSelfTypes registers struct types from the package's own .bni
// file.  `c` is the type-Checker (for pending-decl / const resolution);
// `gc` is the per-compilation context whose Mod is the module
// GeneratePackage will fill (self structs/aliases land in its per-module
// tables).  Sets gc.PkgPath to the .bni's package path for the duration
// of the pass, then restores it.
func RegisterSelfTypes(c @types.Checker, bniFile @ast.File, gc @GenCtx)
// GeneratePackage lowers an AST file into IR and adds it to the module
// gc.Mod, recording `c` as that module's type-Checker (Mod.Checker) for
// per-expression resolved types.  `files` are the package's per-file impl
// ASTs (loader.Package.Files); they make imports FILE-scoped (each decl's
// qualifiers resolve against its own file's imports).  Pass an empty slice for
// a single-file / synthetic module to fall back to the merged-imports overlay.
// Sets gc.Mod.PkgPath (and gc.PkgPath) from the module's name.
func GeneratePackage(c @types.Checker, file @ast.File, gc @GenCtx,
	files @[]@ast.File)
// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point.  `gc` supplies the module
// context (incl. gc.Mod.Checker); requires the surrounding module state
// to already be initialized via a prior GenModule / GeneratePackage call.
func GenSyntheticFunc(gc @GenCtx, name @[]char, body @[]@ast.Stmt) @Func

// GenDecl IR-gens a single top-level declaration against the
// existing module gc.Mod and registers it for subsequent IR
// references.  REPL entry point for Tier 2.  Returns "" on
// success or a diagnostic message on a not-yet-supported kind.
// First cut: DECL_FUNC only (no methods, no type / var / const).
func GenDecl(d @ast.Decl, gc @GenCtx) @[]char

// GenConstMember registers a single resolved const-group
// member in moduleConsts using the given iota position.  REPL
// entry point for retryPending when a previously-parked const
// inside a `const ( ... )` group resolves: pass the member's
// IotaIdx (captured at park time and stored on the PendingDecl)
// so the value reflects its source-order position.
func GenConstMember(d @ast.Decl, gc @GenCtx, iotaIdx int)

// EnsureReplBodyHelpers drains managed-aggregate types registered
// during the most-recent prompt body's IR-gen into freshly-emitted
// `__dtor_<T>` / `__copy_<T>` helpers appended to `m.Funcs`,
// dedup'd against helpers already present.  Resets the pending
// lists on return.  Caller (REPL driver) is responsible for
// lowering the new entries: capture `helpersStart := len(m.Funcs)`
// before the call and lower `m.Funcs[helpersStart:]` afterwards.
// Lower helpers BEFORE the body that references them so the
// body's eager `CallCache` fill resolves every helper name.
//
// Counterpart to the in-decl `ensureReplStructHelpers` path that
// runs from `GenDecl` when a fresh `type` decl introduces a
// managed-field struct: together they cover both ways a prompt
// entry can introduce a new aggregate shape (typing the struct,
// or typing a body that uses an `@[]T` shape).
func EnsureReplBodyHelpers(m @Module)

// EmitInitDispatcher emits a synthetic `<m_pkg>.__init_all`
// function into `m` that calls each name in `packageInitNames`
// (typically the per-package `<pkg>.__init` functions, in
// dependency order).  Always emits the function even with an
// empty list, so the entry wrapper can call it unconditionally.
// Driver entry point for `cmd/bnc`.
func (m @Module) EmitInitDispatcher(packageInitNames @[]@[]char)

// EmitMainEntry emits a synthetic `<m_pkg>.__entry` function
// into `m` that runs `<m_pkg>.__init_all()` then calls
// `main.main()`.  Mangler routes its qualified name to the
// `bn_entry` linker symbol — the C runtime's sole entry into
// Binate.  Driver entry point for `cmd/bnc` on the main module
// (call after EmitInitDispatcher).
func (m @Module) EmitMainEntry()

// HasMainFunc reports whether the module defines the program entry `main.main`
// (the user's `func main` in package "main").  Program-assembly drivers call
// this on the main module before EmitMainEntry to reject a program with no
// entry — a link/program-emit failure, not a per-package compile error.
func (m @Module) HasMainFunc() bool

// IsMainPackage reports whether the module's package is named "main" — the
// name a program's entry package must have (§17.3).  Program-assembly drivers
// check this before HasMainFunc to reject a mis-named entry package precisely.
func (m @Module) IsMainPackage() bool

// MakeInitAssignStmt builds an `<d.Name> = <d.Value>` AST
// assignment for a `var x T = expr` declaration.  Caller is
// expected to wrap the result (alone or with peers) in a
// stmt list and pass it to GenSyntheticFunc — this is the
// one-shot synthetic the REPL uses to run a fresh prompt-level
// var's initializer right after registering the global.
//
// Caller must guarantee `d.Kind == DECL_VAR && d.Value != nil`
// and that d.Name is not the blank identifier.
func MakeInitAssignStmt(d @ast.Decl) @ast.Stmt

// HasPackageInit reports whether `m` contains a `<m_pkg>.__init`
// function (one was emitted by IR-gen of var initializers).
// Used by drivers to decide whether to include the package in
// the dispatcher's call list.
func (m @Module) HasPackageInit() bool

// PackageInitName returns the qualified name `<pkgShort>.__init`
// — helper for drivers building the dispatcher's call list.
func PackageInitName(pkgShort @[]char) @[]char

// ============================================================
// Structural IR verifier (verify.bn)
// ============================================================

// IR-verifier violation codes.  Each names a way a FINALIZED basic block
// can be structurally malformed; VerifyFunc reports the code of each
// defect it finds so callers/tests can match on a stable value rather
// than prose.  These catch the "ctx.CurBlock desync" bug class, where
// IR-gen emits instructions into an already-terminated block (producing a
// second terminator, or a non-terminator after the terminator) and
// silently drops the displaced stores/statements.
const (
	VERR_EMPTY_BLOCK      int = 1 // block has no instructions
	VERR_MISSING_TERM     int = 2 // block has no terminator
	VERR_TWO_TERMS        int = 3 // block has more than one terminator
	VERR_INSTR_AFTER_TERM int = 4 // a non-terminator follows the terminator
	VERR_BAD_SUCCESSOR    int = 5 // a successor is not a block of this func
	VERR_NIL_SUCCESSOR    int = 6 // a jump/branch is missing a target/cond
)

// IRViolation is one structural defect found by VerifyFunc.  BlockIndex /
// InstrIndex locate it within the func (InstrIndex is -1 when it pertains
// to the whole block, e.g. an empty block or a successor fault); Code is
// one of the VERR_* constants; Msg is a human-readable description.
type IRViolation struct {
	FuncName   @[]char
	BlockIndex int
	BlockLabel @[]char
	InstrIndex int
	Code       int
	Msg        @[]char
}

// VerifyFunc returns the structural IR defects in `f` (an empty result
// means well-formed).  It checks, per block, that there is exactly one
// terminator and it is the last instruction, and that each jump/branch
// successor is non-nil and a member of `f.Blocks`.  Must be called on a
// FINALIZED func (post-genFunc): a half-built func transiently has
// empty/unterminated blocks.  Extern/bodyless funcs return no violations.
// It does NOT check reachability or SSA dominance (see verify.bn).
func VerifyFunc(f @Func) @[]IRViolation

// VerifyFuncOK reports whether `f` has zero structural defects.
func VerifyFuncOK(f @Func) bool

// VerifyModule returns the structural IR defects across all non-extern
// funcs in `m`, each tagged with its func name.
func VerifyModule(m @Module) @[]IRViolation

// SetVerifyIR toggles the genFunc-finalization structural assertion (off
// by default).  When on, genFunc aborts the compile with diagnostics if it
// finalizes a malformed func — turning a silent IR-gen miscompile into a
// loud, located failure.  Drivers/CI opt in via this process-global flag.
func SetVerifyIR(on bool)
