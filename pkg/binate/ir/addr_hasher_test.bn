package "pkg/binate/ir"

import "pkg/builtins/testing"

// Tests for AddrHasher (addr_hasher.bn).

// Aligned addresses differ only above their low bits; the hash must still
// spread them across a table's low bits (which is what the table masks).
func TestAddrHasherSpreadsAlignedAddresses() testing.TestResult {
	var h AddrHasher
	var seen @[]bool = make_slice(bool, 16)
	var distinct int = 0
	for i := 0; i < 16; i++ {
		var slot int = cast(int, h.Hash(0x10000 + i * 64) & cast(uint, 15))
		if !seen[slot] {
			seen[slot] = true
			distinct = distinct + 1
		}
	}
	if distinct < 8 { return fail("16 aligned addresses should land in at least 8 of 16 slots") }
	if h.Hash(0x1234) != h.Hash(0x1234) { return fail("the hash must be deterministic") }
	return ""
}
