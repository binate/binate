package "pkg/binate/ir"

import "pkg/binate/types"

// BoxedType returns the type of the value an OP_BOX boxes (see the declaration).
func BoxedType(bi @Instr) @types.Type {
	if bi == nil { return nil }
	var t @types.Type = types.StripWrappers(bi.Typ)
	if t == nil || t.Kind != types.TYP_MANAGED_PTR { return nil }
	return t.Elem
}
