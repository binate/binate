package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for BoxedType (box_source.bn).

// The boxed type is the element of the box's managed result type, even when the
// operand is a slot's address; a non-managed result has none.
func TestBoxedType() testing.TestResult {
	var s @types.Type = fpbStruct()
	var ps @types.Type = types.MakePointerType(s)
	var bi @Instr = fpbInstr(iropcode.OP_BOX, types.MakeManagedPtrType(ps), nil)
	bi.Args = make_slice(@Instr, 1)
	bi.Args[0] = fpbInstr(iropcode.OP_ALLOC, types.MakePointerType(s), s)
	var t @types.Type = BoxedType(bi)
	if t == nil || !t.Identical(ps) { return "BoxedType must be *S" }
	var notBox @Instr = fpbInstr(iropcode.OP_BOX, types.MakePointerType(s), nil)
	if BoxedType(notBox) != nil { return "a non-managed result has no boxed type" }
	return ""
}
