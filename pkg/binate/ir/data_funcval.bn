package "pkg/binate/ir"

import "pkg/binate/types"

// Function-value backing-global layout — the per-function `@__vt` vtable +
// `@__handle` function-value block each OP_FUNC_VALUE / OP_FUNC_HANDLE
// reference needs.  The single source of truth both backends lower through
// emitDataGlobal, so the two cannot drift on byte layout.  Each backend's
// gather resolves its own (format-prefixed) symbol names + the call target
// (the per-function shim, or — for a universal trampoline on LLVM — the
// function itself) + the closure-struct dtor handle (or empty for a
// non-capturing value) and hands them here.
//
// `@__vt`   = { dtor, call }      (BnVtable layout): dtor is the closure-struct
//             dtor's HANDLE (or null), call is the shim / trampoline target.
// `@__handle` = { vtable, data }  (BnFuncValue layout): vtable points at the
//             `@__vt` above, data is null (non-capturing static handle).
// Both are two pointer-sized words, weak (LLVM weak_odr / native weak) so
// cross-TU duplicates dedupe at link time.

// BuildFuncValue builds the [vtable, handle] DataGlobal pair for one function
// value.  dtorSym empty -> the vtable's dtor slot is a null pointer.
func BuildFuncValue(vtSym @[]char, dtorSym @[]char, callSym @[]char,
		handleSym @[]char) @[]@DataGlobal {
	var w int = types.GetTarget().IntSize

	var vt @DataGlobal = NewDataGlobal(vtSym, DG_WEAK, w, true)
	vt.Init = appendTerm(vt.Init, DataSymref(dtorSym, 0))
	vt.Init = appendTerm(vt.Init, DataSymref(callSym, 0))

	var handle @DataGlobal = NewDataGlobal(handleSym, DG_WEAK, w, true)
	handle.Init = appendTerm(handle.Init, DataSymref(vtSym, 0))
	// data slot: null pointer (a non-capturing static handle owns no closure).
	handle.Init = appendTerm(handle.Init, DataSymref("", 0))

	var out @[]@DataGlobal = make_slice(@DataGlobal, 2)
	out[0] = vt
	out[1] = handle
	return out
}
