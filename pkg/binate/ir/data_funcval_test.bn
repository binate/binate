package "pkg/binate/ir"

import "pkg/builtins/testing"

// BuildFuncValue lays the [vtable, handle] pair: vtable { dtor, call }, handle
// { vtable, data=null }, both weak.  Pin the term structure for a capturing
// value (dtor present).  pinTarget64 (data_pkg_descriptor_test.bn) fixes the
// word width.
func TestBuildFuncValue() testing.TestResult {
	pinTarget64()
	var dgs @[]@DataGlobal = BuildFuncValue("_vt", "_dtor", "_shim", "_h")
	if len(dgs) != 2 { return "expected [vtable, handle]" }

	var vt @DataGlobal = dgs[0]
	if vt.Linkage != DG_WEAK { return "vtable should be weak" }
	if !vt.ReadOnly { return "vtable should be read-only" }
	if len(vt.Init) != 2 { return "vtable should have 2 terms (dtor, call)" }
	if vt.Init[0].Kind != DT_SYMREF || len(vt.Init[0].Sym) == 0 {
		return "vtable dtor slot should symref the dtor handle"
	}
	if vt.Init[1].Kind != DT_SYMREF || vt.Init[1].Addend != 0 {
		return "vtable call slot should symref the shim (addend 0)"
	}

	var h @DataGlobal = dgs[1]
	if h.Linkage != DG_WEAK { return "handle should be weak" }
	if len(h.Init) != 2 { return "handle should have 2 terms (vtable, data)" }
	if h.Init[0].Kind != DT_SYMREF || len(h.Init[0].Sym) == 0 {
		return "handle slot 0 should symref the vtable"
	}
	// data slot: a null pointer (empty-Sym symref).
	if h.Init[1].Kind != DT_SYMREF || len(h.Init[1].Sym) != 0 {
		return "handle data slot should be a null symref"
	}
	return ""
}

// A non-capturing value (empty dtorSym) gets a null dtor slot.
func TestBuildFuncValueNoDtor() testing.TestResult {
	pinTarget64()
	var none @[]char
	var dgs @[]@DataGlobal = BuildFuncValue("_vt", none, "_shim", "_h")
	var vt @DataGlobal = dgs[0]
	if vt.Init[0].Kind != DT_SYMREF || len(vt.Init[0].Sym) != 0 {
		return "non-capturing vtable dtor slot should be a null symref"
	}
	return ""
}
