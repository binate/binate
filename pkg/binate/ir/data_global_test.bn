package "pkg/binate/ir"

import "pkg/builtins/testing"

// TestDataTermConstructors pins that each constructor sets Kind + its own
// payload field (and leaves the others at their zero value).
func TestDataTermConstructors() testing.TestResult {
	var bs @[]uint8 = make_slice(uint8, 3)
	bs[0] = cast(uint8, 1)
	bs[1] = cast(uint8, 2)
	bs[2] = cast(uint8, 3)
	var b @DataTerm = DataBytes(bs)
	if b.Kind != DT_BYTES { return "DataBytes: wrong Kind" }
	if len(b.Bytes) != 3 { return "DataBytes: wrong byte count" }

	var n @DataTerm = DataInt(8, cast(uint64, 42))
	if n.Kind != DT_INT { return "DataInt: wrong Kind" }
	if n.Width != 8 { return "DataInt: wrong Width" }
	if n.IntVal != cast(uint64, 42) { return "DataInt: wrong IntVal" }

	var s @DataTerm = DataSymref("foo", 16)
	if s.Kind != DT_SYMREF { return "DataSymref: wrong Kind" }
	if len(s.Sym) != 3 { return "DataSymref: wrong Sym" }
	if s.Addend != 16 { return "DataSymref: wrong Addend" }

	var z @DataTerm = DataZero(8)
	if z.Kind != DT_ZERO { return "DataZero: wrong Kind" }
	if z.Width != 8 { return "DataZero: wrong Width (byte count)" }
	return ""
}

// TestNewDataGlobal pins NewDataGlobal's field wiring + empty Init.
func TestNewDataGlobal() testing.TestResult {
	var dg @DataGlobal = NewDataGlobal("g", DG_WEAK, 8, true)
	if len(dg.Name) != 1 { return "NewDataGlobal: wrong Name" }
	if dg.Linkage != DG_WEAK { return "NewDataGlobal: wrong Linkage" }
	if dg.Align != 8 { return "NewDataGlobal: wrong Align" }
	if !dg.ReadOnly { return "NewDataGlobal: ReadOnly should be true" }
	if len(dg.Init) != 0 { return "NewDataGlobal: Init should be empty" }
	return ""
}
