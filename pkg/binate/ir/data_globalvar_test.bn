package "pkg/binate/ir"

import "pkg/builtins/testing"

// BuildGlobalVar lays a package-level var's storage: one DT_ZERO of `size`
// bytes, strong (DG_GLOBAL) + mutable (not read-only), with the given align.
func TestBuildGlobalVar() testing.TestResult {
	var dg @DataGlobal = BuildGlobalVar("bn_G_x", 8, 8)
	if dg.Linkage != DG_GLOBAL { return "a global var should be strong (DG_GLOBAL)" }
	if dg.ReadOnly { return "a global var is mutable, not read-only" }
	if dg.Align != 8 { return "global var should carry the passed align" }
	if len(dg.Init) != 1 { return "global var storage should be a single term" }
	if dg.Init[0].Kind != DT_ZERO || dg.Init[0].Width != 8 {
		return "global var storage should be `size` zero bytes (DT_ZERO)"
	}
	return ""
}
