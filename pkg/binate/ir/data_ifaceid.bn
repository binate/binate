package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/stdx/slices"

// Per-module gather of the per-interface identity markers (`__ifaceid.<J>`)
// each backend emits via irdata.BuildIfaceId.  The marker layout lives in
// pkg/binate/irdata (data_ifaceid.bn); this side walks the module's interface
// set to decide WHICH markers to emit.

// CollectIfaceIdSyms returns the distinct IfaceId marker symbols module `m` must
// emit — one per canonical interface in m.Interfaces (the universe `any`
// included).  Alias entries (`interface X = Y`) are skipped: they have no
// identity of their own, and Y (the canonical tail) is registered separately and
// gets its own marker.  Deduped by symbol string.  Each backend iterates this
// list and emits irdata.BuildIfaceId(sym) through its own data-global lowering;
// weak linkage coalesces the same interface emitted from several TUs.
func CollectIfaceIdSyms(m @Module) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(m.Interfaces); i++ {
		if len(m.Interfaces[i].AliasTarget) > 0 { continue }
		var sym @[]char = mangle.IfaceIdName(m.Interfaces[i].Pkg, m.Interfaces[i].Name)
		if ifaceIdSymSeen(out, sym) { continue }
		out = slices.Append[@[]char](out, sym)
	}
	return out
}

// CollectLookupIfaceIdSyms returns the distinct IfaceId marker symbols module m's
// code looks a box up with: the interface operand of each satisfaction lookup
// (OP_SAT_LOOKUP, an interface-target assertion's), in the order the functions
// first reach them.  The package descriptor lists them (reflect.Package.IfaceIds)
// so a bytecode-VM host binds each to the native marker; a satisfaction entry the
// VM registers for a type of its own is then keyed on the address this code
// presents.  The operand is always the marker's address (OP_DATA_SYM_ADDR); any
// other is an internal error, since the lookup's key could then not be named.
func CollectLookupIfaceIdSyms(m @Module) @[]@[]char {
	var out @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @Instr = blk.Instrs[ii]
				if instr.Op != iropcode.OP_SAT_LOOKUP { continue }
				var id @Instr = instr.Args[1]
				if id.Op != iropcode.OP_DATA_SYM_ADDR {
					panic("internal error: a satisfaction lookup's interface operand is no marker's address")
				}
				if ifaceIdSymSeen(out, id.StrVal) { continue }
				out = slices.Append[@[]char](out, id.StrVal)
			}
		}
	}
	return out
}

// ifaceIdSymSeen reports whether symbol `s` already appears in `syms`.
func ifaceIdSymSeen(syms @[]@[]char, s *[]readonly char) bool {
	for i := 0; i < len(syms); i++ {
		if irutil.CharEq(syms[i], s) { return true }
	}
	return false
}
