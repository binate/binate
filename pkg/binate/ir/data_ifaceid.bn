package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/stdx/slices"

// Per-module gather of the per-interface identity markers (`__ifaceid.<J>`)
// each backend emits via irdata.BuildIfaceId.  The marker layout lives in
// pkg/binate/irdata (data_ifaceid.bn); this side walks the module's interface
// set to decide WHICH markers to emit.

// CollectIfaceIdSyms returns the distinct IfaceId marker symbols module `m` must
// emit — one per canonical interface in m.Interfaces (the universe `any`
// included).  Alias entries (`interface X = Y`) are skipped: they have no
// identity of their own, and Y (the canonical tail) is registered separately and
// gets its own marker.  Deduped by symbol string.  Each backend iterates this
// list and emits irdata.BuildIfaceId(sym) through its own data-global lowering;
// weak linkage coalesces the same interface emitted from several TUs.
func CollectIfaceIdSyms(m @Module) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(m.Interfaces); i++ {
		if len(m.Interfaces[i].AliasTarget) > 0 { continue }
		var sym @[]char = mangle.IfaceIdName(m.Interfaces[i].Pkg, m.Interfaces[i].Name)
		if ifaceIdSymSeen(out, sym) { continue }
		out = slices.Append[@[]char](out, sym)
	}
	return out
}

// ifaceIdSymSeen reports whether symbol `s` already appears in `syms`.
func ifaceIdSymSeen(syms @[]@[]char, s *[]readonly char) bool {
	for i := 0; i < len(syms); i++ {
		if charEq(syms[i], s) { return true }
	}
	return false
}
