package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/stdx/slices"

// Per-interface identity markers (`__ifaceid.<J>`) — one weak, address-only
// 1-byte marker per interface program-wide (spec §11.12 `iface.rtti`).  A
// satisfaction entry stores `&IfaceId(J)` and a type assertion `x.(*J)`
// references the same symbol, so pointer-equality within a mode decides
// satisfaction.  Weak / ODR-coalesced, so every TU that names J agrees on one
// address.  Emitted by a module-level pass (mirroring emitTypeInfos) in each
// backend; nothing READS them until the Phase-5 assertion lowering, so they are
// inert (an unreferenced marker is dead-stripped until the satisfaction entries
// and reader arrive).

// BuildIfaceId builds the weak, read-only 1-byte marker named `sym`
// (mangle.IfaceIdName).  Its content is a single zero byte — a materialized
// rodata byte (DataBytes, not DataZero, so it lands in rodata rather than BSS on
// every backend); only the marker's ADDRESS is meaningful.
func BuildIfaceId(sym @[]char) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(sym, DG_WEAK, 1, true)
	var one @[]uint8 = make_slice(uint8, 1)
	dg.Init = appendTerm(dg.Init, DataBytes(one))
	return dg
}

// CollectIfaceIdSyms returns the distinct IfaceId marker symbols module `m` must
// emit — one per canonical interface in m.Interfaces (the universe `any`
// included).  Alias entries (`interface X = Y`) are skipped: they have no
// identity of their own, and Y (the canonical tail) is registered separately and
// gets its own marker.  Deduped by symbol string.  Each backend iterates this
// list and emits BuildIfaceId(sym) through its own data-global lowering; weak
// linkage coalesces the same interface emitted from several TUs.
func CollectIfaceIdSyms(m @Module) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(m.Interfaces); i++ {
		if len(m.Interfaces[i].AliasTarget) > 0 { continue }
		var sym @[]char =
			mangle.IfaceIdName(m.Interfaces[i].Pkg, m.Interfaces[i].Name)
		if ifaceIdSymSeen(out, sym) { continue }
		out = slices.Append[@[]char](out, sym)
	}
	return out
}

// ifaceIdSymSeen reports whether symbol `s` already appears in `syms`.
func ifaceIdSymSeen(syms @[]@[]char, s @[]char) bool {
	for i := 0; i < len(syms); i++ {
		if charEq(syms[i], s) { return true }
	}
	return false
}
