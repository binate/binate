package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/irsym"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// CollectIfaceIdSyms returns one symbol per canonical interface — the universe
// `any` (seeded by NewModule) plus each declared interface — with alias entries
// skipped and duplicates deduped.
func TestCollectIfaceIdSyms() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	// NewModule seeds `any`.  Add I, an alias A = I (skipped), K, and a
	// duplicate I (deduped).
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, mkIfaceMI("main", "I", ""))
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, mkIfaceMI("main", "A", "I"))
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, mkIfaceMI("main", "K", ""))
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, mkIfaceMI("main", "I", ""))

	var syms @[]@[]char = CollectIfaceIdSyms(m)
	// any (seeded first), I, K — alias A skipped, duplicate I deduped.
	if len(syms) != 3 {
		return "expected 3 distinct IfaceId syms (any, I, K)"
	}
	if !irutil.CharEq(syms[1], mangle.IfaceIdName("main", "I")) {
		return "second sym should be IfaceId(main.I)"
	}
	if !irutil.CharEq(syms[2], mangle.IfaceIdName("main", "K")) {
		return "third sym should be IfaceId(main.K)"
	}
	// The alias A must not appear.
	for i := 0; i < len(syms); i++ {
		if irutil.CharEq(syms[i], mangle.IfaceIdName("main", "A")) {
			return "alias A should be skipped"
		}
	}
	return ""
}

// mkIfaceMI builds a minimal irsym.ModuleInterface with the (pkg, name) identity
// CollectIfaceIdSyms keys on and an optional alias target (empty = non-alias).
func mkIfaceMI(pkg @[]char, name @[]char, aliasTarget @[]char) irsym.ModuleInterface {
	var mi irsym.ModuleInterface
	mi.Pkg = pkg
	mi.Name = name
	mi.AliasTarget = aliasTarget
	return mi
}

// CollectLookupIfaceIdSyms lists the interface operand of each satisfaction
// lookup across the module's functions, in first-use order and deduped, and
// nothing else a function takes the address of.
func TestCollectLookupIfaceIdSyms() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	var symJ @[]char = mangle.IfaceIdName("main", "J")
	var symK @[]char = mangle.IfaceIdName("main", "K")
	var f1 @Func = NewFunc("main", "f1", make_slice(@Param, 0), make_slice(@types.Type, 0))
	var b1 @Block = AddBlock(f1, "entry")
	b1.Instrs = make_slice(@Instr, 4)
	b1.Instrs[0] = lookupOf(f1, symJ)
	b1.Instrs[1] = lookupOf(f1, symK)
	b1.Instrs[2] = lookupOf(f1, symJ)
	b1.Instrs[3] = dataSymAddrOf(f1, mangle.IfaceIdName("main", "L"))
	var f2 @Func = NewFunc("main", "f2", make_slice(@Param, 0), make_slice(@types.Type, 0))
	var b2 @Block = AddBlock(f2, "entry")
	b2.Instrs = make_slice(@Instr, 1)
	b2.Instrs[0] = lookupOf(f2, symK)
	m.Funcs = slices.Append[@Func](m.Funcs, f1)
	m.Funcs = slices.Append[@Func](m.Funcs, f2)

	var syms @[]@[]char = CollectLookupIfaceIdSyms(m)
	if len(syms) != 2 { return "expected the 2 distinct looked-up markers (J, K)" }
	if !irutil.CharEq(syms[0], symJ) { return "first sym should be IfaceId(main.J)" }
	if !irutil.CharEq(syms[1], symK) { return "second sym should be IfaceId(main.K)" }
	return ""
}

// lookupOf builds an OP_SAT_LOOKUP in f whose interface operand is the address
// of the marker sym.
func lookupOf(f @Func, sym @[]char) @Instr {
	var lk @Instr = NewInstr(f, iropcode.OP_SAT_LOOKUP, types.MakePointerType(types.TypUint8()))
	lk.Args = make_slice(@Instr, 2)
	lk.Args[0] = NewInstr(f, iropcode.OP_CONST_NIL, types.MakePointerType(types.TypUint8()))
	lk.Args[1] = dataSymAddrOf(f, sym)
	return lk
}

// dataSymAddrOf builds an OP_DATA_SYM_ADDR of sym in f.
func dataSymAddrOf(f @Func, sym @[]char) @Instr {
	var a @Instr = NewInstr(f, iropcode.OP_DATA_SYM_ADDR, types.MakePointerType(types.TypUint8()))
	a.StrVal = sym
	a.TypeArg = types.TypUint8()
	return a
}
