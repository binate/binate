package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// BuildIfaceId lays a weak, read-only 1-byte marker whose single zero byte is
// materialized (DT_BYTES, so it lands in rodata rather than BSS); only its
// address matters.
func TestBuildIfaceId() testing.TestResult {
	var dg @DataGlobal = BuildIfaceId("_ifid")
	if dg.Linkage != DG_WEAK { return "IfaceId marker should be weak" }
	if !dg.ReadOnly { return "IfaceId marker should be read-only" }
	if len(dg.Init) != 1 { return "IfaceId marker should be a single term" }
	if dg.Init[0].Kind != DT_BYTES || len(dg.Init[0].Bytes) != 1 {
		return "IfaceId marker should be exactly one byte"
	}
	if dg.Init[0].Bytes[0] != cast(uint8, 0) {
		return "IfaceId marker byte should be zero"
	}
	return ""
}

// CollectIfaceIdSyms returns one symbol per canonical interface — the universe
// `any` (seeded by NewModule) plus each declared interface — with alias entries
// skipped and duplicates deduped.
func TestCollectIfaceIdSyms() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	// NewModule seeds `any`.  Add I, an alias A = I (skipped), K, and a
	// duplicate I (deduped).
	m.Interfaces = slices.Append[ModuleInterface](m.Interfaces, mkIfaceMI("main", "I", ""))
	m.Interfaces = slices.Append[ModuleInterface](m.Interfaces, mkIfaceMI("main", "A", "I"))
	m.Interfaces = slices.Append[ModuleInterface](m.Interfaces, mkIfaceMI("main", "K", ""))
	m.Interfaces = slices.Append[ModuleInterface](m.Interfaces, mkIfaceMI("main", "I", ""))

	var syms @[]@[]char = CollectIfaceIdSyms(m)
	// any (seeded first), I, K — alias A skipped, duplicate I deduped.
	if len(syms) != 3 {
		return "expected 3 distinct IfaceId syms (any, I, K)"
	}
	if !charEq(syms[1], mangle.IfaceIdName("main", "I")) {
		return "second sym should be IfaceId(main.I)"
	}
	if !charEq(syms[2], mangle.IfaceIdName("main", "K")) {
		return "third sym should be IfaceId(main.K)"
	}
	// The alias A must not appear.
	for i := 0; i < len(syms); i++ {
		if charEq(syms[i], mangle.IfaceIdName("main", "A")) {
			return "alias A should be skipped"
		}
	}
	return ""
}

// mkIfaceMI builds a minimal ModuleInterface with the (pkg, name) identity
// CollectIfaceIdSyms keys on and an optional alias target (empty = non-alias).
func mkIfaceMI(pkg @[]char, name @[]char, aliasTarget @[]char) ModuleInterface {
	var mi ModuleInterface
	mi.Pkg = pkg
	mi.Name = name
	mi.AliasTarget = aliasTarget
	return mi
}
