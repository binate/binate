package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/stdx/slices"

// BuildPackageDescriptors builds the FULL ordered DataGlobal list for a
// module's reflect.Package descriptor — every static blob a package's
// reflection surface needs, laid out ONCE so the LLVM and native backends
// cannot drift.  The emission order matches both backends' gather order so the
// native object is byte-identical to the pre-DataGlobal layout (modulo
// symbol-name prefixes): for each table (funcs, then globals, then vtables) a
// per-entry [name rodata, (sig rodata,) info node] run followed by that
// table's backing pointer array (emitted only when non-empty), and finally the
// descriptor node + name bytes.  The backend gather passes supply the entries
// (their own format-prefixed symbol names + the backend-neutral payload
// scalars); this lays the bytes.
func BuildPackageDescriptors(refcount int, infoSym @[]char, nameSym @[]char, nameBytes @[]char,
		funcsSym @[]char, funcs @[]@PkgFuncEntry, globalsSym @[]char, globals @[]@PkgGlobalEntry,
		vtablesSym @[]char, vtables @[]@PkgVtableEntry, satentriesSym @[]char,
		satEntrySyms @[]@[]char) @[]@DataGlobal {
	// w is the int-sized word width (header words + slice lengths); hdr is the
	// managed-header byte size (2 words), the addend an info-node's PAYLOAD
	// pointer (the backing-array entries + a FunctionInfo's Pkg field) carries
	// to skip the header.  hdr = 2*w assumes PointerSize == IntSize (every
	// current target) — same assumption BuildPackageDescriptor documents.
	var w int = types.GetTarget().IntSize
	var hdr int = 2 * w
	var out @[]@DataGlobal

	// Functions table: per entry [name rodata, sig rodata, node], then array.
	var fNodeSyms @[]@[]char
	for i := 0; i < len(funcs); i++ {
		var e @PkgFuncEntry = funcs[i]
		out = appendDataGlobal(out, buildRodata(e.NameSym, e.Name))
		out = appendDataGlobal(out, buildRodata(e.SigSym, e.Sig))
		out = appendDataGlobal(out, buildFuncInfoNode(refcount, w, hdr, infoSym, e))
		fNodeSyms = appendSymName(fNodeSyms, e.NodeSym)
	}
	if len(funcs) > 0 {
		out = appendDataGlobal(out, buildPtrArray(funcsSym, fNodeSyms, hdr, w))
	}

	// Globals table: per entry [name rodata, node], then array.
	var gNodeSyms @[]@[]char
	for i := 0; i < len(globals); i++ {
		var e @PkgGlobalEntry = globals[i]
		out = appendDataGlobal(out, buildRodata(e.NameSym, e.Name))
		out = appendDataGlobal(out, buildGlobalInfoNode(refcount, w, e))
		gNodeSyms = appendSymName(gNodeSyms, e.NodeSym)
	}
	if len(globals) > 0 {
		out = appendDataGlobal(out, buildPtrArray(globalsSym, gNodeSyms, hdr, w))
	}

	// Vtables table: per entry [name rodata, node], then array.
	var vNodeSyms @[]@[]char
	for i := 0; i < len(vtables); i++ {
		var e @PkgVtableEntry = vtables[i]
		out = appendDataGlobal(out, buildRodata(e.NameSym, e.Name))
		out = appendDataGlobal(out, buildVtableInfoNode(refcount, w, e))
		vNodeSyms = appendSymName(vNodeSyms, e.NodeSym)
	}
	if len(vtables) > 0 {
		out = appendDataGlobal(out, buildPtrArray(vtablesSym, vNodeSyms, hdr, w))
	}

	// SatEntries table: a backing pointer array over the (separately-emitted)
	// __satentry.<T,J> nodes.  Each node is a weak reflect.SatEntryInfo emitted by
	// emitSatEntries (co-located with the vtables/typeinfos); the descriptor just
	// LISTS them (at node + hdr, past the managed header) so the __Package root
	// retains them and the runtime can aggregate them across packages.
	if len(satEntrySyms) > 0 {
		out = appendDataGlobal(out, buildPtrArray(satentriesSym, satEntrySyms, hdr, w))
	}

	// The descriptor node + package-name bytes go LAST (after the tables they
	// reference by symbol), reusing BuildPackageDescriptor's pair.
	var tail @[]@DataGlobal = BuildPackageDescriptor(refcount, infoSym, nameSym, nameBytes, funcsSym,
			len(funcs), globalsSym, len(globals), vtablesSym, len(vtables), satentriesSym, len(satEntrySyms))
	for i := 0; i < len(tail); i++ {
		out = appendDataGlobal(out, tail[i])
	}
	return out
}

// buildRodata builds a private (LLVM `private`) read-only byte blob — a
// FunctionInfo/GlobalInfo/VtableInfo Name or Sig string, referenced only by its
// own node, so align-1 and TU-local.
func buildRodata(sym @[]char, bytes @[]char) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(sym, DG_LOCAL, 1, true)
	dg.Init = appendTerm(dg.Init, DataBytes(bytes))
	return dg
}

// buildPtrArray builds a reflect.Package table's backing pointer array: one
// word-sized pointer per info node, to that node's PAYLOAD (node + hdr).  Weak
// (LLVM weak_odr), matching the descriptor node + the LLVM emitter's array.
func buildPtrArray(sym @[]char, nodeSyms @[]@[]char, hdr int, w int) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(sym, DG_WEAK, w, true)
	for i := 0; i < len(nodeSyms); i++ {
		dg.Init = appendTerm(dg.Init, DataSymref(nodeSyms[i], hdr))
	}
	return dg
}

// appendDataGlobal appends one built DataGlobal to the orchestrator's output.
func appendDataGlobal(dst @[]@DataGlobal, dg @DataGlobal) @[]@DataGlobal {
	return slices.Append[@DataGlobal](dst, dg)
}

// appendSymName appends one info-node symbol to a table's node-symbol list
// (later lowered into the table's backing pointer array).
func appendSymName(dst @[]@[]char, s @[]char) @[]@[]char {
	return slices.Append[@[]char](dst, s)
}

// BuildPackageDescriptor builds the DataGlobals for the per-package
// reflect.Package descriptor NODE + its name bytes — the single source of
// truth for that layout, which both the LLVM and native backends lower
// through emitDataGlobal so they cannot drift.  (The _pkg_funcs /
// _pkg_globals / _pkg_vtables backing arrays + the per-entry info nodes are
// emitted separately and referenced here by symbol name.)
//
// One immortal static-managed object: a 2-word header { refcount = the
// negative static sentinel, freefn = 0 } followed by the reflect.Package
// payload — four raw slices { data, len }: Name -> nameSym, then Functions /
// Globals / Vtables, each pointing at its backing-array symbol when its count
// > 0 else the empty slice { null, 0 }.  The per-backend `__Package()` accessor
// returns node + 2 words (the payload pointer).  Returns [node, name].
//
// refcount is the caller's static-managed sentinel (mirrored across the
// codegen / native copies); passing it keeps the value in one place per call
// rather than adding a third mirror here.
func BuildPackageDescriptor(refcount int, infoSym @[]char, nameSym @[]char, nameBytes @[]uint8,
		funcsSym @[]char, funcCount int, globalsSym @[]char, globalCount int, vtablesSym @[]char,
		vtableCount int, satentriesSym @[]char, satEntryCount int) @[]@DataGlobal {
	// w is the int-sized word width for the header / slice-length terms.  The
	// raw-slice DATA fields are DataSymrefs (pointer-sized: LLVM `ptr` / native
	// WordSize).  This assumes PointerSize == IntSize, which holds for every
	// current Binate target (LP64 8/8, ILP32 4/4); a target with
	// PointerSize != IntSize would mis-space the { data, len } pairs and needs
	// an explicit pointer-width term here.
	var w int = types.GetTarget().IntSize

	var node @DataGlobal = NewDataGlobal(infoSym, DG_WEAK, w, true)
	// Managed header: refcount sentinel, null freefn.
	node.Init = appendTerm(node.Init, DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	// reflect.Package payload: Name, Functions, Globals, Vtables raw slices.
	node.Init = appendTerm(node.Init, DataSymref(nameSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(nameBytes))))
	appendTableSlice(node, funcsSym, funcCount, w)
	appendTableSlice(node, globalsSym, globalCount, w)
	appendTableSlice(node, vtablesSym, vtableCount, w)
	appendTableSlice(node, satentriesSym, satEntryCount, w)

	var name @DataGlobal = NewDataGlobal(nameSym, DG_LOCAL, w, true)
	name.Init = appendTerm(name.Init, DataBytes(nameBytes))

	var out @[]@DataGlobal = make_slice(@DataGlobal, 2)
	out[0] = node
	out[1] = name
	return out
}

// appendTableSlice appends one reflect.Package table field — a raw slice
// { data, len }: a symref to arraySym + the count when count > 0, else the
// empty slice { null, 0 }.
func appendTableSlice(node @DataGlobal, arraySym @[]char, count int, w int) {
	if count > 0 {
		node.Init = appendTerm(node.Init, DataSymref(arraySym, 0))
		node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, count)))
	} else {
		node.Init = appendTerm(node.Init, DataSymref("", 0))
		node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	}
	return
}

// appendTerm returns terms with t appended.
func appendTerm(terms @[]@DataTerm, t @DataTerm) @[]@DataTerm {
	return slices.Append[@DataTerm](terms, t)
}
