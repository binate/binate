package "pkg/binate/ir"

// reflect.FunctionInfo node layout for the per-package descriptor — the single
// source of truth both backends lower through emitDataGlobal (the LLVM and
// native gather passes only compute the symbol names + payload scalars; the
// byte layout lives here, so it cannot drift).  See data_pkg_descriptor.bn for
// the surrounding rodata + backing-array emission and BuildPackageDescriptors.

// NewPkgFuncEntry builds a reflect.FunctionInfo descriptor row.  name / sig
// must be owned (the returned entry retains them for the node + rodata blobs).
func NewPkgFuncEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
		sigSym @[]char, sig @[]char, handleSym @[]char, retbufSize int,
		paramSlots int) @PkgFuncEntry {
	var e @PkgFuncEntry = make(PkgFuncEntry)
	e.NodeSym = nodeSym
	e.NameSym = nameSym
	e.Name = name
	e.SigSym = sigSym
	e.Sig = sig
	e.HandleSym = handleSym
	e.RetbufSize = retbufSize
	e.ParamSlots = paramSlots
	return e
}

// buildFuncInfoNode lays one immortal static-managed reflect.FunctionInfo node:
// the 2-word managed header { refcount sentinel, null FreeFn } then the 8-word
// payload { Pkg, Name(data,len), Value, RetbufSize, ParamSlots, Sig(data,len) }
// (matching reflect.bni).  Pkg points at the package descriptor node's PAYLOAD
// (infoSym + hdr, hdr = the managed-header size 2*w); Value / Name.data /
// Sig.data are direct symrefs (no header).  Weak (LLVM weak_odr) so an
// instantiation's node, emitted into every consumer, merges at link time.
func buildFuncInfoNode(refcount int, w int, hdr int, infoSym @[]char,
		e @PkgFuncEntry) @DataGlobal {
	var node @DataGlobal = NewDataGlobal(e.NodeSym, DG_WEAK, w, true)
	node.Init = appendTerm(node.Init,
		DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	node.Init = appendTerm(node.Init, DataSymref(infoSym, hdr))
	node.Init = appendTerm(node.Init, DataSymref(e.NameSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(e.Name))))
	node.Init = appendTerm(node.Init, DataSymref(e.HandleSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, e.RetbufSize)))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, e.ParamSlots)))
	node.Init = appendTerm(node.Init, DataSymref(e.SigSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(e.Sig))))
	return node
}
