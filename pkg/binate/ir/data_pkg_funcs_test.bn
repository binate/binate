package "pkg/binate/ir"

import "pkg/builtins/testing"

// buildFuncInfoNode lays the 2-word managed header then the 8-word
// reflect.FunctionInfo payload { Pkg, Name(data,len), Value, RetbufSize,
// ParamSlots, Sig(data,len) }.  Pin the term count, the Pkg back-pointer's
// header addend (hdr = 16 on a 64-bit word), and the scalar payload fields.
func TestBuildFuncInfoNode() testing.TestResult {
	var e @PkgFuncEntry = NewPkgFuncEntry("n__fninfo", "n__fnname", "Foo", "n__fnsig", "(int)(int)",
			"__handle.n", 0, 1)
	var node @DataGlobal = buildFuncInfoNode(-1073741824, 8, 16, "_info", e)

	if node.Linkage != DG_WEAK { return "FunctionInfo node should be weak" }
	if !node.ReadOnly { return "FunctionInfo node should be read-only" }
	// 2 header words + 8 payload words.
	if len(node.Init) != 10 { return "node should have 10 terms" }
	// term 2 = Pkg -> the package node PAYLOAD (infoSym + header size 16).
	if node.Init[2].Kind != DT_SYMREF || node.Init[2].Addend != 16 {
		return "Pkg should symref _info + 16 (managed-header size)"
	}
	// term 4 = Name.len = len("Foo") = 3.
	if node.Init[4].IntVal != cast(uint64, 3) { return "Name.len should be 3" }
	// term 5 = Value -> the handle directly (addend 0).
	if node.Init[5].Kind != DT_SYMREF || node.Init[5].Addend != 0 {
		return "Value should symref the handle (addend 0)"
	}
	// term 6 = RetbufSize (0), term 7 = ParamSlots (1).
	if node.Init[6].IntVal != cast(uint64, 0) { return "RetbufSize should be 0" }
	if node.Init[7].IntVal != cast(uint64, 1) { return "ParamSlots should be 1" }
	return ""
}
