package "pkg/binate/ir"

// reflect.GlobalInfo node layout for the per-package descriptor — the single
// source of truth both backends lower through emitDataGlobal.  See
// data_pkg_descriptor.bn for the surrounding emission.

// NewPkgGlobalEntry builds a reflect.GlobalInfo descriptor row.  name must be
// owned (the returned entry retains it for the node + rodata blob).
func NewPkgGlobalEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
		storageSym @[]char) @PkgGlobalEntry {
	var e @PkgGlobalEntry = make(PkgGlobalEntry)
	e.NodeSym = nodeSym
	e.NameSym = nameSym
	e.Name = name
	e.StorageSym = storageSym
	return e
}

// buildGlobalInfoNode lays one immortal static-managed reflect.GlobalInfo node:
// the 2-word managed header then the { Name(data,len), Addr } payload (matching
// reflect.bni).  Addr targets the global's `var` storage cell directly (addend
// 0 — no managed header, unlike FunctionInfo.Value).
func buildGlobalInfoNode(refcount int, w int, e @PkgGlobalEntry) @DataGlobal {
	var node @DataGlobal = NewDataGlobal(e.NodeSym, DG_WEAK, w, true)
	node.Init = appendTerm(node.Init, DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	node.Init = appendTerm(node.Init, DataSymref(e.NameSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(e.Name))))
	node.Init = appendTerm(node.Init, DataSymref(e.StorageSym, 0))
	return node
}
