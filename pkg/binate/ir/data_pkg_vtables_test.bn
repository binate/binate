package "pkg/binate/ir"

import "pkg/builtins/testing"

// buildVtableInfoNode lays the 2-word managed header then the 5-word
// reflect.VtableInfo payload { Name(data,len), Addr, ShimAddr, SlotCount }.  Addr
// / ShimAddr target the @__ivt / @__ivtshim constant arrays directly (addend 0);
// SlotCount is the vtable's slot count (the VM's upcast extent bound).
func TestBuildVtableInfoNode() testing.TestResult {
	var e @PkgVtableEntry = NewPkgVtableEntry("v__vtinfo", "v__vtname",
		"__ivt.x", "v_ivt", "v_ivtshim", 3)
	var node @DataGlobal = buildVtableInfoNode(-1073741824, 8, e)

	if node.Linkage != DG_WEAK { return "VtableInfo node should be weak" }
	// 2 header words + Name(data,len) + Addr + ShimAddr + SlotCount = 7 terms.
	if len(node.Init) != 7 { return "node should have 7 terms" }
	// term 3 = Name.len = len("__ivt.x") = 7.
	if node.Init[3].IntVal != cast(uint64, 7) { return "Name.len should be 7" }
	// term 4 = Addr (@__ivt), term 5 = ShimAddr (@__ivtshim), both addend 0.
	if node.Init[4].Kind != DT_SYMREF || node.Init[4].Addend != 0 {
		return "Addr should symref @__ivt (addend 0)"
	}
	if node.Init[5].Kind != DT_SYMREF || node.Init[5].Addend != 0 {
		return "ShimAddr should symref @__ivtshim (addend 0)"
	}
	// term 6 = SlotCount = 3.
	if node.Init[6].IntVal != cast(uint64, 3) { return "SlotCount should be 3" }
	return ""
}
