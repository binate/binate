package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Distributed interface-satisfaction entries (`__satentry.<T,J>`) — the
// registry an interface assertion `x.(*J)` scans (spec §11.12 `iface.rtti`,
// `type.layout.satisfaction`).  Because `impl` may live in any package (no
// orphan rule), no TU sees a type's complete impl set, so satisfaction is NOT a
// per-type table in TypeInfo; instead each `impl T : J` site emits one weak
// per-`(T, J)` entry (for J and every transitive ancestor — already flattened
// into m.Impls), keyed on `(T, J)` and ODR-coalesced exactly like the
// `__ivt.<T>__<J>` sub-vtable it references.  Each entry records
// `{&TypeInfo(T), &IfaceId(J), &__ivt.<T>__<J>}`; the Phase-5 reader looks up
// `(dynamic-type, IfaceId)` and, on a hit, forms `{data, vtable(T, J)}`.
// Nothing READS the entries until Phase 5, and nothing REFERENCES them until the
// retention pass (3c: the reflect package descriptor) — so an emitted entry is
// dead-stripped meanwhile (inert, harmless).

// BuildSatEntry builds the weak satisfaction-entry record named `desc.Sym`
// (mangle.SatEntryName): three pointer-sized words `{&TypeInfo, &IfaceId,
// &sub-vtable}`.  Weak so duplicate emissions across TUs (every TU with the
// impl visible) coalesce to one — its three referents are all deterministic,
// co-emitted symbols, so the entries stay byte-identical.  Read-only but
// relocatable (three symrefs) → rodata_relro.
func BuildSatEntry(desc @SatEntryDesc) @DataGlobal {
	var w int = types.GetTarget().IntSize
	var dg @DataGlobal = NewDataGlobal(desc.Sym, DG_WEAK, w, true)
	dg.Init = appendTerm(dg.Init, DataSymref(desc.TypeInfoSym, 0))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.IfaceIdSym, 0))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.SubvtabSym, 0))
	return dg
}

// CollectSatEntries returns the distinct satisfaction entries module `m` must
// emit — one per `(RecvPkg, RecvTypeName, IfacePkg, IfaceName)` row across
// m.Impls (which collectImplsFromDecl already expanded to include every
// transitive ancestor and the `(T, any)` box rows), deduped by the entry
// symbol.  The three referents are keyed identically to the same-TU records:
// `TypeInfoName` (co-emitted by CollectTypeInfoDescs), `IfaceIdName` (by
// CollectIfaceIdSyms), and `ImplVtableName` — the standalone `__ivt.<T>__<J>` at
// offset 0 (co-emitted by emitImplVtables for the same m.Impls row), which
// begins with J's any-block and so IS the sub-vtable a `@J`/`*J` value carries.
func CollectSatEntries(m @Module) @[]@SatEntryDesc {
	var out @[]@SatEntryDesc
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		var sym @[]char = mangle.SatEntryName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		if satEntrySeen(out, sym) { continue }
		var desc @SatEntryDesc = make(SatEntryDesc)
		desc.Sym = sym
		desc.TypeInfoSym = mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName)
		desc.IfaceIdSym = mangle.IfaceIdName(info.IfacePkg, info.IfaceName)
		desc.SubvtabSym = mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		out = slices.Append[@SatEntryDesc](out, desc)
	}
	return out
}

// satEntrySeen reports whether an entry with symbol `s` already appears.
func satEntrySeen(descs @[]@SatEntryDesc, s @[]char) bool {
	for i := 0; i < len(descs); i++ {
		if charEq(descs[i].Sym, s) { return true }
	}
	return false
}
