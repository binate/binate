package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/stdx/slices"

// Per-module gather of the distributed interface-satisfaction entries
// (`__satentry.<T,J>`) each backend emits via irdata.BuildSatEntry.  The node
// layout lives in pkg/binate/irdata (data_satentry.bn); this side walks m.Impls
// (which collectImplsFromDecl already expanded to include every transitive
// ancestor and the `(T, any)` box rows) to decide which entries to emit.

// CollectSatEntries returns the distinct satisfaction entries module `m` must
// emit — one per `(RecvPkg, RecvTypeName, IfacePkg, IfaceName)` row across
// m.Impls, deduped by the entry symbol.  The three referents are keyed
// identically to the same-TU records: `TypeInfoName` (co-emitted by
// CollectTypeInfoDescs), `IfaceIdName` (by CollectIfaceIdSyms), and
// `ImplVtableName` — the standalone `__ivt.<T>__<J>` at offset 0 (co-emitted by
// emitImplVtables for the same m.Impls row), which begins with J's any-block and
// so IS the sub-vtable a `@J`/`*J` value carries.
func CollectSatEntries(m @Module) @[]@irdata.SatEntryDesc {
	var out @[]@irdata.SatEntryDesc
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		var sym @[]char = mangle.SatEntryName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		if satEntrySeen(out, sym) { continue }
		var desc @irdata.SatEntryDesc = make(irdata.SatEntryDesc)
		desc.Sym = sym
		desc.TypeInfoSym = mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName)
		desc.IfaceIdSym = mangle.IfaceIdName(info.IfacePkg, info.IfaceName)
		desc.SubvtabSym = mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		out = slices.Append[@irdata.SatEntryDesc](out, desc)
	}
	return out
}

// satEntrySeen reports whether an entry with symbol `s` already appears.
func satEntrySeen(descs @[]@irdata.SatEntryDesc, s @[]char) bool {
	for i := 0; i < len(descs); i++ {
		if charEq(descs[i].Sym, s) { return true }
	}
	return false
}
