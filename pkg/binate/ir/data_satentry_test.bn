package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// BuildSatEntry lays a weak, read-only 3-pointer record
// `{&TypeInfo, &IfaceId, &sub-vtable}`.  pinTarget64 fixes the word width.
func TestBuildSatEntry() testing.TestResult {
	pinTarget64()
	var desc @SatEntryDesc = make(SatEntryDesc)
	desc.Sym = "_sat"
	desc.TypeInfoSym = "_ti"
	desc.IfaceIdSym = "_iid"
	desc.SubvtabSym = "_ivt"
	var dg @DataGlobal = BuildSatEntry(desc)
	if dg.Linkage != DG_WEAK { return "SatEntry should be weak" }
	if !dg.ReadOnly { return "SatEntry should be read-only" }
	if len(dg.Init) != 3 { return "SatEntry should have 3 pointer words" }
	if dg.Init[0].Kind != DT_SYMREF || !charEq(dg.Init[0].Sym, "_ti") {
		return "word 0 should be a symref to &TypeInfo"
	}
	if dg.Init[1].Kind != DT_SYMREF || !charEq(dg.Init[1].Sym, "_iid") {
		return "word 1 should be a symref to &IfaceId"
	}
	if dg.Init[2].Kind != DT_SYMREF || !charEq(dg.Init[2].Sym, "_ivt") {
		return "word 2 should be a symref to &sub-vtable"
	}
	return ""
}

// CollectSatEntries returns one entry per distinct (T, J) row in m.Impls — which
// already includes transitive ancestors (impl T:B where B:A yields rows (T,B)
// AND (T,A)) — deduped, each referencing the co-emitted TypeInfo(T) / IfaceId(J)
// / __ivt.<T>__<J> by their canonical symbols.
func TestCollectSatEntries() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	// impl T:B (B:A) → m.Impls holds (T,B) and (T,A); add a duplicate (T,B).
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoSat("main", "T", "main", "B"))
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoSat("main", "T", "main", "A"))
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoSat("main", "T", "main", "B"))

	var descs @[]@SatEntryDesc = CollectSatEntries(m)
	if len(descs) != 2 {
		return "expected 2 distinct entries ((T,B), (T,A); duplicate (T,B) deduped)"
	}
	// descs[0] = (T,B): all four symbols keyed identically to the co-emitted globals.
	if !charEq(descs[0].Sym, mangle.SatEntryName("main", "T", "main", "B")) {
		return "entry symbol should be SatEntryName(T,B)"
	}
	if !charEq(descs[0].TypeInfoSym, mangle.TypeInfoName("main", "T")) {
		return "entry should reference TypeInfoName(T)"
	}
	if !charEq(descs[0].IfaceIdSym, mangle.IfaceIdName("main", "B")) {
		return "entry should reference IfaceIdName(B)"
	}
	if !charEq(descs[0].SubvtabSym, mangle.ImplVtableName("main", "T", "main", "B")) {
		return "entry sub-vtable should be ImplVtableName(T,B) (the standalone __ivt at offset 0)"
	}
	// descs[1] = (T,A) — the transitive ancestor entry.
	if !charEq(descs[1].IfaceIdSym, mangle.IfaceIdName("main", "A")) {
		return "ancestor entry should reference IfaceIdName(A)"
	}
	if !charEq(descs[1].SubvtabSym, mangle.ImplVtableName("main", "T", "main", "A")) {
		return "ancestor entry sub-vtable should be ImplVtableName(T,A)"
	}
	return ""
}

// mkImplInfoSat builds a minimal ImplInfo carrying the (recv, iface) identity
// CollectSatEntries keys on.
func mkImplInfoSat(recvPkg @[]char, recvType @[]char, ifacePkg @[]char,
		ifaceName @[]char) @ImplInfo {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = recvPkg
	info.RecvTypeName = recvType
	info.IfacePkg = ifacePkg
	info.IfaceName = ifaceName
	return info
}
