package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Satisfaction-registry helper — the compiled-codegen side of the decentralized
// `__pkg_satfrag` graph.  emitBuildSatRegistryCall injects the runtime registry
// fill (a walk of the build root's `__pkg_satfrag` node) into `bn_init`; the
// `&__pkg_satfrag` LEA it emits also keeps the node — and thus the `__satentry`
// chain — alive under dead-strip (spec §11.12 `iface.rtti`).

// emitBuildSatRegistryCall appends to `blk` the two instructions that fill the
// runtime satisfaction registry by walking `m`'s `__pkg_satfrag` graph node: an
// OP_DATA_SYM_ADDR LEA of `&__pkg_satfrag` and the BuildSatRegistry call taking
// it.  The LEA is a real use, so it also keeps the node — and thus the
// `__satentry` chain — alive under dead-strip (native retains via this reloc;
// LLVM additionally pins it in `@llvm.used` via codegen.emitSatFragPin, gated on
// m.SatRegistryRequested).  Sole caller is EmitBnInit, which places it in
// `bn_init` ahead of the package inits that may use the registry, and sets
// m.SatRegistryRequested.  Compiled (native + LLVM) path only — the interp never
// emits bn_init (it builds its registry host-side).
func emitBuildSatRegistryCall(blk @Block, m @Module) {
	var rootAddr @Instr = blk.EmitDataSymAddr(mangle.GlobalName(m.PkgPath, "__pkg_satfrag"),
			types.TypUint8())
	blk.EmitCall("pkg/builtins/rt.BuildSatRegistry", makeArgs1(rootAddr), types.TypVoid())
}

// findFuncNamed returns the module Func whose qualified name is `name`, or nil.
func findFuncNamed(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

// CEntryTargetFunc returns the top-level function whose canonical qualified name
// is `name` (e.g. an OP_C_ENTRY StrVal) as an @Func, and true; or (nil, false)
// if the module knows no such function.  If the function is DEFINED in this
// module its real @Func is returned; if it is only IMPORTED (a cross-package
// __c_entry target, present as a FuncSig but not a defined Func) a SYNTHETIC
// @Func carrying the imported signature's params, results, and multi-return type
// is returned — enough for the native __c_entry thunk to classify narrow GP
// arguments and sret returns.  Used by pkg/binate/native/common to build the
// weak `__centry.<mangled>` adaptation thunk (and to decide thunk-vs-degenerate)
// by name without reaching into ir's internals.
func CEntryTargetFunc(m @Module, name *[]readonly char) (@Func, bool) {
	var f @Func = findFuncNamed(m, name)
	if f != nil {
		return f, true
	}
	var idx int = funcSigIndexLookup(m, name)
	if idx < 0 {
		var none @Func
		return none, false
	}
	var sig FuncSig = m.FuncSigs.Get(idx)
	var params @[]@Param = make_slice(@Param, len(sig.Params))
	for i := 0; i < len(sig.Params); i++ {
		params[i] = make(Param)
		params[i].Typ = sig.Params[i]
	}
	var tf @Func = NewFunc("", buf.CopyStr(name), params, sig.Results)
	tf.MultiReturnType = sig.MultiReturnType
	return tf, true
}
