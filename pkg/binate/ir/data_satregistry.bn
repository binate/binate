package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/binate/types"

// Satisfaction-registry wiring — the native-codegen driver side of the
// decentralized `_pkg_satfrag` graph.  This side records the request on the
// module and wires `__entry` to fill the runtime registry by walking the graph
// from THIS (main) module's `_pkg_satfrag` node, whose `&_pkg_satfrag` LEA also
// keeps the node — and thus the `__satentry` chain — alive under dead-strip
// (spec §11.12 `iface.rtti`).

// EmitSatRegistryWiring records the registry request and wires `__entry` to fill
// the runtime satisfaction registry from main's `_pkg_satfrag` graph node — see
// the ir.bni contract.
func (m @Module) EmitSatRegistryWiring() {
	m.SatRegistryRequested = true

	// Reference the graph from `__entry` (the always-live program entry).  The
	// bare (unprefixed) mangled name matches what the backends' OP_DATA_SYM_ADDR
	// lowering re-prefixes and what they name the `_pkg_satfrag` DataGlobal.  A
	// non-main compile has no `__entry` — nothing to wire.
	var entryName @[]char = qualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = findFuncNamed(m, entryName)
	if f == nil { return }
	if len(f.Blocks) == 0 { return }
	var blk @Block = f.Blocks[0]

	// M3: build the runtime satisfaction registry as `__entry`'s FIRST statement,
	// strictly before the `__init_all()` call EmitMainEntry emitted — an interface
	// assertion can run in a top-level variable initializer, which executes inside
	// `__init_all`, so the registry must already be filled.  BuildSatRegistry walks
	// the decentralized `_pkg_satfrag` graph from THIS (main) module's node; that
	// call's `&_pkg_satfrag` argument is a real LEA, so it also USES the node
	// (native `-dead_strip` retains the graph via it; LLVM pins it in `@llvm.used`
	// — see codegen.emitSatFragPin).  The two emits append after the `return`
	// terminator, so rotate them to the front (before `__init_all`).  Native-codegen
	// -only (this whole function is, per M5 — the interp path never calls it).
	var rootAddr @Instr = blk.EmitDataSymAddr(mangle.GlobalName(m.PkgPath, "_pkg_satfrag"),
			types.TypUint8())
	blk.EmitCall("pkg/builtins/rt.BuildSatRegistry", makeArgs1(rootAddr), types.TypVoid())
	rotateLastInstrsToFront(blk, 2)
	return
}

// rotateLastInstrsToFront moves the last `k` instructions of `blk` to the front,
// preserving their order.  Used to place the M3 registry-fill (appended after
// the block's existing body) ahead of the `__init_all` call.
func rotateLastInstrsToFront(blk @Block, k int) {
	var n int = len(blk.Instrs)
	if k <= 0 || k >= n { return }
	// Build the rotated order, then write it back through InstrsVec (the source of
	// truth) and refresh the Instrs view — so the builder stays authoritative even
	// though nothing appends to this block after wiring.  `out` is captured in full
	// before any Set, so the fact that Instrs aliases the builder's backing is
	// harmless.
	var out @[]@Instr = make_slice(@Instr, n)
	for i := 0; i < k; i++ {
		out[i] = blk.Instrs[n - k + i]
	}
	for i := 0; i < n - k; i++ {
		out[k + i] = blk.Instrs[i]
	}
	for i := 0; i < n; i++ {
		blk.InstrsVec.Set(i, out[i])
	}
	blk.Instrs = blk.InstrsVec.Items()
}

// findFuncNamed returns the module Func whose qualified name is `name`, or nil.
func findFuncNamed(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

// FuncParamTypesByName returns the parameter types of the top-level function
// whose canonical qualified name is `name` (e.g. an OP_C_ENTRY StrVal), and
// true; or (nil, false) if the module knows no such function.  It searches the
// module's defined/extern funcs first, then its imported func-signature table —
// a cross-package callback that this module only imports is registered as a
// FuncSig, not always a defined Func.  Used by the native __c_entry narrow-arg
// gate (pkg/binate/native/common) to inspect a callback target's ABI shape by
// name without reaching into ir's internals.
func FuncParamTypesByName(m @Module, name *[]readonly char) (@[]@types.Type, bool) {
	var f @Func = findFuncNamed(m, name)
	if f != nil {
		var pts @[]@types.Type = make_slice(@types.Type, len(f.Params))
		for i := 0; i < len(f.Params); i++ {
			pts[i] = f.Params[i].Typ
		}
		return pts, true
	}
	var idx int = funcSigIndexLookup(m, name)
	if idx >= 0 {
		return m.FuncSigs.Get(idx).Params, true
	}
	var none @[]@types.Type
	return none, false
}
