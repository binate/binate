package "pkg/binate/ir"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/buf"

// findFuncNamed returns the module Func whose qualified name is `name`, or nil.
func findFuncNamed(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.Streq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

// CEntryTargetFunc returns the top-level function whose canonical qualified name
// is `name` (e.g. an OP_C_ENTRY StrVal) as an @Func, and true; or (nil, false)
// if the module knows no such function.  If the function is DEFINED in this
// module its real @Func is returned; if it is only IMPORTED (a cross-package
// __c_entry target, present as a FuncSig but not a defined Func) a SYNTHETIC
// @Func carrying the imported signature's params, results, and multi-return type
// is returned — enough for the native __c_entry thunk to classify narrow GP
// arguments and sret returns.  Used by pkg/binate/native/common to build the
// weak `__centry.<mangled>` adaptation thunk (and to decide thunk-vs-degenerate)
// by name without reaching into ir's internals.
func CEntryTargetFunc(m @Module, name *[]readonly char) (@Func, bool) {
	var f @Func = findFuncNamed(m, name)
	if f != nil {
		return f, true
	}
	var idx int = FuncSigIndexLookup(m, name)
	if idx < 0 {
		var none @Func
		return none, false
	}
	var sig irdata.FuncSig = m.FuncSigs.Get(idx)
	var params @[]@Param = make_slice(@Param, len(sig.Params))
	for i := 0; i < len(sig.Params); i++ {
		params[i] = make(Param)
		params[i].Typ = sig.Params[i]
	}
	var tf @Func = NewFunc("", buf.CopyStr(name), params, sig.Results)
	tf.MultiReturnType = sig.MultiReturnType
	return tf, true
}
