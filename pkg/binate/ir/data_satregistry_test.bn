package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// EmitSatRegistryWiring records the native-codegen registry request on the
// module and injects a BuildSatRegistry call (walking main's `_pkg_satfrag`
// graph node) as `__entry`'s FIRST statement — its `&_pkg_satfrag`
// OP_DATA_SYM_ADDR LEA both feeds the call and keeps the node live.
func TestEmitSatRegistryWiring() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	m.PkgPath = "main"
	// EmitMainEntry builds `main.__entry` = [call __init_all, call main.main,
	// return]; EmitSatRegistryWiring then edits it.
	m.EmitMainEntry()
	m.EmitSatRegistryWiring()

	if !m.SatRegistryRequested { return "EmitSatRegistryWiring should set SatRegistryRequested" }

	var f @Func = LookupModuleFunc(m, "main.__entry")
	if f == nil { return "EmitMainEntry should have built main.__entry" }
	if len(f.Blocks) == 0 { return "__entry should have a block" }
	var instrs @[]@Instr = f.Blocks[0].Instrs
	if len(instrs) < 2 { return "__entry block too short" }
	// The registry wiring is rotated to the front: the `_pkg_satfrag` LEA
	// (OP_DATA_SYM_ADDR) is the first statement, ahead of the `__init_all` call.
	if instrs[0].Op != iropcode.OP_DATA_SYM_ADDR {
		return "the _pkg_satfrag LEA (OP_DATA_SYM_ADDR) should be __entry's first statement"
	}
	return ""
}
