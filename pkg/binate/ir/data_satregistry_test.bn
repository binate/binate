package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// EmitSatRegistryWiring records the native-codegen registry request on the
// module and injects a BuildSatRegistry call (walking main's `_pkg_satfrag`
// graph node) as `__entry`'s FIRST statement — its `&_pkg_satfrag`
// OP_DATA_SYM_ADDR LEA both feeds the call and keeps the node live.
func TestEmitSatRegistryWiring() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	m.PkgPath = "main"
	// EmitMainEntry builds `main.__entry` = [call __init_all, call main.main,
	// return]; EmitSatRegistryWiring then edits it.
	m.EmitMainEntry()
	m.EmitSatRegistryWiring()

	if !m.SatRegistryRequested { return "EmitSatRegistryWiring should set SatRegistryRequested" }

	var f @Func = LookupModuleFunc(m, "main.__entry")
	if f == nil { return "EmitMainEntry should have built main.__entry" }
	if len(f.Blocks) == 0 { return "__entry should have a block" }
	var instrs @[]@Instr = f.Blocks[0].Instrs
	if len(instrs) < 2 { return "__entry block too short" }
	// The registry wiring is rotated to the front: the `_pkg_satfrag` LEA
	// (OP_DATA_SYM_ADDR) is the first statement, ahead of the `__init_all` call.
	if instrs[0].Op != iropcode.OP_DATA_SYM_ADDR {
		return "the _pkg_satfrag LEA (OP_DATA_SYM_ADDR) should be __entry's first statement"
	}
	return ""
}

// CEntryTargetFunc resolves a DEFINED function to its real @Func by canonical
// qualified name (the findFuncNamed branch).
func TestCEntryTargetFuncDefined() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	var ps @[]@Param = make_slice(@Param, 2)
	ps[0] = make(Param)
	ps[0].Typ = types.MakePointerType(types.TypUint8())
	ps[1] = make(Param)
	ps[1].Typ = types.TypInt32()
	var noResults @[]@types.Type
	var def @Func = NewFunc("main", "cmp", ps, noResults)
	m.AddFunc(def)

	var got @Func
	var found bool
	got, found = CEntryTargetFunc(m, "main.cmp")
	if !found { return "expected to find main.cmp" }
	if got != def { return "should return the defined func itself" }
	if len(got.Params) != 2 { return "expected 2 params" }
	if got.Params[1].Typ.SizeOf() != 4 { return "second param should be int32 (size 4)" }
	return ""
}

// CEntryTargetFunc SYNTHESIZES an @Func for an IMPORTED function present only as
// a FuncSig (the funcSigIndexLookup branch) — the cross-package __c_entry target
// path — carrying the signature's params and results.
func TestCEntryTargetFuncImportedSig() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	var sig FuncSig
	sig.Name = "other.handler"
	var sp @[]@types.Type = make_slice(@types.Type, 1)
	sp[0] = types.TypInt8()
	sig.Params = sp
	var sr @[]@types.Type = make_slice(@types.Type, 1)
	sr[0] = types.TypInt32()
	sig.Results = sr
	registerFuncSig(m, sig)

	var got @Func
	var found bool
	got, found = CEntryTargetFunc(m, "other.handler")
	if !found { return "expected to find imported sig other.handler" }
	if !seq(got.Name, "other.handler") { return "synthetic func should keep the name" }
	if len(got.Params) != 1 { return "expected 1 param" }
	if got.Params[0].Typ.SizeOf() != 1 { return "param should be int8 (size 1)" }
	if len(got.Results) != 1 { return "expected 1 result" }
	if got.Results[0].SizeOf() != 4 { return "result should be int32 (size 4)" }
	return ""
}

// CEntryTargetFunc reports not-found for a name the module knows as neither a
// Func nor a FuncSig.
func TestCEntryTargetFuncUnknown() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	var got @Func
	var found bool
	got, found = CEntryTargetFunc(m, "main.nope")
	if found { return "unknown name should not be found" }
	if got != nil { return "unknown name should yield a nil func" }
	return ""
}
