package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Whole-program SatEntry root — the compiler-synthesized `{ptr,len}[]` array
// that spans every package's `_pkg_satentries` backing array (spec §11.12
// `iface.rtti`; plan-type-assertions-execution.md §U.2a).  Its job is to hand
// the Phase-5 interface-assertion reader a BOUNDED enumerable set of every
// `__satentry.<T,J>` node in the program: `impl` may live in any package (no
// orphan rule), so no single TU sees a type's whole impl set, and the reader
// must scan across packages.  Rooting the array from `__entry` also keeps the
// `__satentry` chain (root → pairs → each `_pkg_satentries` → its nodes) alive
// under `--gc-sections` / `-dead_strip` even when reflection is unused — but
// that retention is a bonus; the enumerable set is the point.
//
// The root is a two-DataGlobal pair: a `pairs` array of `{&<pkg>._pkg_satentries,
// count}` — one per package with ≥1 `__satentry` — and a `root` raw-slice header
// `{&pairs, N}` (the symbol `__entry` references).  The per-pair `count` is
// required because a `_pkg_satentries` array carries no length prefix.

// BuildSatEntryRoot lays the root's two DataGlobals — see the ir.bni contract.
func BuildSatEntryRoot(rootSym @[]char, pairsSym @[]char, pkgSatSyms @[]@[]char,
		counts @[]int) @[]@DataGlobal {
	// w is the int-sized word width for the header's length term and each pair's
	// count.  The pair/header DATA fields are pointer-sized DataSymrefs; this
	// assumes PointerSize == IntSize (every current Binate target) — the same
	// assumption BuildPackageDescriptor documents.
	var w int = types.GetTarget().IntSize
	var n int = len(pkgSatSyms)
	var out @[]@DataGlobal

	// pairs: N × { &_pkg_satentries (symref), count (int) }.  Emitted only when
	// non-empty; referenced solely by the header in the same TU, so DG_LOCAL.
	// The cross-TU symrefs make it relocatable → EmitDataGlobal routes it to
	// rodata_relro.
	if n > 0 {
		var pairs @DataGlobal = NewDataGlobal(pairsSym, DG_LOCAL, w, true)
		for i := 0; i < n; i++ {
			pairs.Init = appendTerm(pairs.Init, DataSymref(pkgSatSyms[i], 0))
			pairs.Init = appendTerm(pairs.Init, DataInt(w, cast(uint64, counts[i])))
		}
		out = slices.Append[@DataGlobal](out, pairs)
	}

	// root header: the raw slice { data, len } — { &pairs, N }, or { null, 0 }
	// when N == 0 (still emitted, so the C1 unconditional-root invariant holds).
	// DG_WEAK: this is the OP_DATA_SYM_ADDR target `__entry` references, and that
	// lowering promotes its symbol's binding (a weak def resists the demotion).
	var root @DataGlobal = NewDataGlobal(rootSym, DG_WEAK, w, true)
	if n > 0 {
		root.Init = appendTerm(root.Init, DataSymref(pairsSym, 0))
	} else {
		root.Init = appendTerm(root.Init, DataSymref("", 0))
	}
	root.Init = appendTerm(root.Init, DataInt(w, cast(uint64, n)))
	out = slices.Append[@DataGlobal](out, root)
	return out
}

// EmitSatEntryRoot records the root request and wires `__entry` to reference it
// — see the ir.bni contract.
func (m @Module) EmitSatEntryRoot(entries @[]SatRootEntry) {
	m.SatRootRequested = true
	m.SatRootEntries = entries

	// Reference the root from `__entry` (the always-live program entry).  This is
	// the NATIVE-backend retention mechanism: OP_DATA_SYM_ADDR lowers to a real
	// LEA/ADRP reloc in `__entry`'s machine code, so the linker's dead-strip
	// retains root → pairs → each `_pkg_satentries` → its `__satentry` nodes.
	// The LLVM backend cannot rely on this — its OP_DATA_SYM_ADDR lowering is a
	// no-op `bitcast i8* @root to i8*` whose unused result LLVM folds away,
	// dropping the reference — so codegen.emitSatEntryRoot additionally pins the
	// root in `@llvm.used` (the portable retain primitive).  The bare
	// (unprefixed) mangled name matches what the backends' OP_DATA_SYM_ADDR
	// lowering re-prefixes and what they name the root DataGlobal.  A non-main
	// compile has no `__entry` — nothing to root.
	var entryName @[]char = qualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = findFuncNamed(m, entryName)
	if f == nil { return }
	if len(f.Blocks) == 0 { return }
	var blk @Block = f.Blocks[0]

	// OP_DATA_SYM_ADDR materializes &root into a register whose result is unused
	// — the reference alone is what dead-strip sees.  It appends AFTER the
	// block's `return` terminator, so swap it before the return to keep the block
	// well-formed (terminator last).
	blk.EmitDataSymAddr(mangle.GlobalName(m.PkgPath, "_satentry_root"), types.TypUint8())
	var n int = len(blk.Instrs)
	if n >= 2 {
		var tmp @Instr = blk.Instrs[n - 1]
		blk.Instrs[n - 1] = blk.Instrs[n - 2]
		blk.Instrs[n - 2] = tmp
	}
	return
}

// findFuncNamed returns the module Func whose qualified name is `name`, or nil.
func findFuncNamed(m @Module, name @[]char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}
