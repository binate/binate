package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Whole-program SatEntry-root driver side.  The root's byte layout lives in
// pkg/binate/irdata (BuildSatEntryRoot); this side records the native-codegen
// request on the module and wires `__entry` to reference the root so the
// `__satentry` chain survives dead-strip (spec §11.12 `iface.rtti`).

// EmitSatEntryRoot records the root request and wires `__entry` to reference it
// — see the ir.bni contract.
func (m @Module) EmitSatEntryRoot(entries @[]irdata.SatRootEntry) {
	m.SatRootRequested = true
	m.SatRootEntries = entries

	// Reference the root from `__entry` (the always-live program entry).  This is
	// the NATIVE-backend retention mechanism: OP_DATA_SYM_ADDR lowers to a real
	// LEA/ADRP reloc in `__entry`'s machine code, so the linker's dead-strip
	// retains root → pairs → each `_pkg_satentries` → its `__satentry` nodes.
	// The LLVM backend cannot rely on this — its OP_DATA_SYM_ADDR lowering is a
	// no-op `bitcast i8* @root to i8*` whose unused result LLVM folds away,
	// dropping the reference — so codegen.emitSatEntryRoot additionally pins the
	// root in `@llvm.used` (the portable retain primitive).  The bare
	// (unprefixed) mangled name matches what the backends' OP_DATA_SYM_ADDR
	// lowering re-prefixes and what they name the root DataGlobal.  A non-main
	// compile has no `__entry` — nothing to root.
	var entryName @[]char = qualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = findFuncNamed(m, entryName)
	if f == nil { return }
	if len(f.Blocks) == 0 { return }
	var blk @Block = f.Blocks[0]

	// M3: build the runtime satisfaction registry from the root as `__entry`'s
	// FIRST statement, strictly before the `__init_all()` call EmitMainEntry
	// emitted — an interface assertion can run in a top-level variable
	// initializer, which executes inside `__init_all`, so the registry must
	// already be filled.  `rt.BuildSatRegistry(&_satentry_root)` also USES the
	// root (dead-strip retains it), but the unused reference below is KEPT so the
	// Slice-3 retention contract holds unchanged for the no-assertion case.  The
	// two emits append after the `return` terminator, so rotate them to the
	// front (before `__init_all`).  Native-codegen-only (this whole function is,
	// per M5 — the interp path never calls it).
	var rootAddr @Instr = blk.EmitDataSymAddr(mangle.GlobalName(m.PkgPath, "_satentry_root"),
			types.TypUint8())
	blk.EmitCall("pkg/builtins/rt.BuildSatRegistry", makeArgs1(rootAddr), types.TypVoid())
	rotateLastInstrsToFront(blk, 2)

	// OP_DATA_SYM_ADDR materializes &root into a register whose result is unused
	// — the reference alone is what dead-strip sees.  It appends AFTER the
	// block's `return` terminator, so swap it before the return to keep the block
	// well-formed (terminator last).
	blk.EmitDataSymAddr(mangle.GlobalName(m.PkgPath, "_satentry_root"), types.TypUint8())
	var n int = len(blk.Instrs)
	if n >= 2 {
		var tmp @Instr = blk.Instrs[n - 1]
		blk.Instrs[n - 1] = blk.Instrs[n - 2]
		blk.Instrs[n - 2] = tmp
	}
	return
}

// rotateLastInstrsToFront moves the last `k` instructions of `blk` to the front,
// preserving their order.  Used to place the M3 registry-fill (appended after
// the block's existing body) ahead of the `__init_all` call.
func rotateLastInstrsToFront(blk @Block, k int) {
	var n int = len(blk.Instrs)
	if k <= 0 || k >= n { return }
	var out @[]@Instr = make_slice(@Instr, n)
	for i := 0; i < k; i++ {
		out[i] = blk.Instrs[n - k + i]
	}
	for i := 0; i < n - k; i++ {
		out[k + i] = blk.Instrs[i]
	}
	blk.Instrs = out
}

// findFuncNamed returns the module Func whose qualified name is `name`, or nil.
func findFuncNamed(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}
