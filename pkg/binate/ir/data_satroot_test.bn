package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// EmitSatEntryRoot records the native-codegen root request on the module and
// injects an OP_DATA_SYM_ADDR reference to `<pkg>._satentry_root` into `__entry`
// (just before its return terminator, via the append-then-swap) so the linker's
// dead-strip retains the root.  The root's byte layout (BuildSatEntryRoot) is
// tested in the irdata package.
func TestEmitSatEntryRoot() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	m.PkgPath = "main"
	// EmitMainEntry builds `main.__entry` = [call __init_all, call main.main,
	// return]; EmitSatEntryRoot then edits it.
	m.EmitMainEntry()

	var e irdata.SatRootEntry
	e.PkgPath = "pkg/dep"
	e.Count = 3
	e.IsOwn = false
	var entries @[]irdata.SatRootEntry = make_slice(irdata.SatRootEntry, 1)
	entries[0] = e
	m.EmitSatEntryRoot(entries)

	if !m.SatRootRequested { return "EmitSatEntryRoot should set SatRootRequested" }
	if len(m.SatRootEntries) != 1 { return "EmitSatEntryRoot should stash the gather entries" }

	var f @Func = LookupModuleFunc(m, "main.__entry")
	if f == nil { return "EmitMainEntry should have built main.__entry" }
	if len(f.Blocks) == 0 { return "__entry should have a block" }
	var instrs @[]@Instr = f.Blocks[0].Instrs
	var n int = len(instrs)
	if n < 2 { return "__entry block too short" }
	// Terminator (return) stays last; the root reference sits immediately before
	// it.  The reference materializes the root's address into an unused register
	// — the reloc alone is what dead-strip sees.
	if instrs[n - 2].Op != iropcode.OP_DATA_SYM_ADDR {
		return "the root reference (OP_DATA_SYM_ADDR) should sit before __entry's return"
	}
	return ""
}
