package "pkg/binate/ir"

import "pkg/binate/types"

// String-constant static data layout — the byte blob each distinct string
// literal (and rodata composite-literal byte sequence) lowers to, plus the
// static managed-slice (`.ms`) header that aliases it.  The single source of
// truth both backends lower through emitDataGlobal, so neither the blob bytes
// nor the header layout can drift.  Each backend resolves its own symbol names
// and linkage (the byte blob is local; the `.ms` carries a relocation so on the
// native backend it must be a reachable symbol-table entry — see the callers).

// BuildStringBlob builds the read-only byte blob for a string constant: a bare
// `[N x i8]` of EXACTLY the literal's bytes — NO NUL terminator, since Binate
// strings are length-prefixed, not C-strings — `private` + `unnamed_addr` (so
// LLVM may merge identical constants), align 1.  Reloc-free, so it lands in
// rodata on the native backend.
func BuildStringBlob(blobSym @[]char, data @[]char) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(blobSym, DG_LOCAL, 1, true)
	dg.UnnamedAddr = true
	dg.Init = appendTerm(dg.Init, DataBytes(data))
	return dg
}

// BuildStringMSHeader builds the static managed-slice (`.ms`) header that aliases
// a string constant's byte blob: the 4-word { data, len, backing_refptr,
// backing_len } layout — data = a pointer to `blobSym`, backing_refptr = null
// (immortal — RefInc/RefDec no-op on null), backing_len = len (the backing IS
// the blob, `length` bytes).  Read-only; word widths follow the target
// (`IntSize`), so it is ILP32-correct.  The header carries a relocation (the
// data pointer), so it lands in `data` on the native backend (a relocatable
// read-only blob can't live in Mach-O `__TEXT,__const`) — and because a `data`
// symbol reached from text must be a symbol-table entry, the native caller
// passes a reachable `linkage` (DG_WEAK) + a module-qualified name; LLVM keeps
// it private (DG_LOCAL), which its codegen resolves intra-module.  A consumer
// reading only the first two words gets the {data, len} a raw slice needs.
func BuildStringMSHeader(msSym @[]char, blobSym @[]char, length int, linkage int) @DataGlobal {
	var w int = types.GetTarget().IntSize
	var dg @DataGlobal = NewDataGlobal(msSym, linkage, w, true)
	dg.Init = appendTerm(dg.Init, DataSymref(blobSym, 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, length)))
	dg.Init = appendTerm(dg.Init, DataSymref("", 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, length)))
	return dg
}
