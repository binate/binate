package "pkg/binate/ir"

// String-constant static data layout — the byte blob each distinct string
// literal (and rodata composite-literal byte sequence) lowers to.  The single
// source of truth both backends lower through emitDataGlobal, so the blob bytes
// cannot drift.  Each backend resolves its own blob symbol name (LLVM
// `.str.<id>`, native `Lstr_<id>`).

// BuildStringBlob builds the read-only byte blob for a string constant: a bare
// `[N x i8]` of EXACTLY the literal's bytes — NO NUL terminator, since Binate
// strings are length-prefixed, not C-strings — `private` + `unnamed_addr` (so
// LLVM may merge identical constants), align 1.  Reloc-free, so it lands in
// rodata on the native backend.
func BuildStringBlob(blobSym @[]char, data @[]char) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(blobSym, DG_LOCAL, 1, true)
	dg.UnnamedAddr = true
	dg.Init = appendTerm(dg.Init, DataBytes(data))
	return dg
}
