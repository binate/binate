package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// pinTarget32 fixes an ILP32 target (pointer/int width 4) for the duration of a
// test.  Tests that need LP64 call pinTarget64 (data_pkg_descriptor_test.bn);
// SetTarget is global, so an ILP32 test restores LP64 before returning.
func pinTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
}

// BuildStringBlob lays a string constant's bytes as a bare read-only byte blob:
// a single DT_BYTES term holding EXACTLY the literal's bytes (no NUL), private
// (DG_LOCAL), unnamed_addr, align 1.
func TestBuildStringBlob() testing.TestResult {
	var data @[]char = "hi"
	var dg @DataGlobal = BuildStringBlob("Lstr_0", data)

	if dg.Linkage != DG_LOCAL { return "string blob should be private/local" }
	if !dg.ReadOnly { return "string blob should be read-only" }
	if !dg.UnnamedAddr { return "string blob should be unnamed_addr" }
	if dg.Align != 1 { return "string blob should be align 1" }
	if len(dg.Init) != 1 { return "string blob should be a single term" }
	if dg.Init[0].Kind != DT_BYTES { return "string blob term should be DT_BYTES" }
	// Exactly the 2 literal bytes — no trailing NUL.
	if len(dg.Init[0].Bytes) != 2 {
		return "blob should be exactly the literal bytes (no NUL)"
	}
	if dg.Init[0].Bytes[0] != cast(uint8, 'h') ||
			dg.Init[0].Bytes[1] != cast(uint8, 'i') {
		return "blob bytes should match the literal"
	}
	return ""
}

// BuildStringMSHeader lays the static managed-slice header { data, len, null
// refptr, backing_len=len } aliasing a string blob: 4 terms, read-only,
// caller-chosen linkage, word width = target IntSize.  pinTarget64
// (data_pkg_descriptor_test.bn) fixes the word width at 8.
func TestBuildStringMSHeader() testing.TestResult {
	pinTarget64()
	var dg @DataGlobal = BuildStringMSHeader("Lstrms_0", "Lstr_0", 5, DG_WEAK)

	if dg.Linkage != DG_WEAK { return "ms header should carry the passed linkage" }
	if !dg.ReadOnly { return "ms header should be read-only" }
	if dg.Align != 8 { return "ms header should be IntSize-aligned (8 on LP64)" }
	if len(dg.Init) != 4 { return "ms header should have 4 words" }
	// word 0: data = symref to the blob (addend 0).
	if dg.Init[0].Kind != DT_SYMREF || len(dg.Init[0].Sym) == 0 ||
			dg.Init[0].Addend != 0 {
		return "word 0 should symref the byte blob"
	}
	// word 1: len.
	if dg.Init[1].Kind != DT_INT || dg.Init[1].Width != 8 ||
			dg.Init[1].IntVal != cast(uint64, 5) {
		return "word 1 should be len"
	}
	// word 2: backing_refptr = null (empty symref).
	if dg.Init[2].Kind != DT_SYMREF || len(dg.Init[2].Sym) != 0 {
		return "word 2 should be a null refptr"
	}
	// word 3: backing_len = len.
	if dg.Init[3].Kind != DT_INT || dg.Init[3].IntVal != cast(uint64, 5) {
		return "word 3 (backing_len) should equal len"
	}
	return ""
}

// On an ILP32 target the .ms header's word width follows IntSize=4: a 16-byte
// (4-word × 4) header, align 4, with both int terms width 4 — guarding the
// `types.GetTarget().IntSize` derivation against a hardcoded-8 regression.
func TestBuildStringMSHeaderILP32() testing.TestResult {
	pinTarget32()
	var dg @DataGlobal = BuildStringMSHeader("Lstrms_0", "Lstr_0", 5, DG_WEAK)
	var ok bool = dg.Align == 4 &&
		len(dg.Init) == 4 &&
		dg.Init[1].Kind == DT_INT && dg.Init[1].Width == 4 &&
		dg.Init[3].Kind == DT_INT && dg.Init[3].Width == 4
	pinTarget64()
	if !ok {
		return "ILP32 .ms header should be align 4 with width-4 int terms"
	}
	return ""
}
