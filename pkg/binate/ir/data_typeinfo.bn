package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/stdx/slices"

// Per-module gather of the per-type RTTI records (`__typeinfo.<T>`) each
// backend emits via irdata.BuildTypeInfo.  The record layout lives in
// pkg/binate/irdata (data_typeinfo.bn); this side walks m.Impls to decide which
// records to emit and reads each type's layout (size/align/name/dtor) off the
// held RecvTyp at codegen.

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit — one per distinct (RecvPkg, RecvTypeName) across m.Impls (every
// concrete type with a local impl is boxable, so gets a TypeInfo) — each
// carrying that type's size/align, read HERE (at codegen) off the ImplInfo's
// held RecvTyp.  Deduped by symbol string.  Each backend iterates this list and
// emits irdata.BuildTypeInfo(desc) through its own data-global lowering; the
// weak linkage coalesces the same type emitted from several TUs.  Keyed on the
// same (RecvPkg, RecvTypeName) as the `__ivt` slot-1 reference, so the emitted
// record and the vtable pointer to it agree.
func CollectTypeInfoDescs(m @Module) @[]@irdata.TypeInfoDesc {
	var out @[]@irdata.TypeInfoDesc
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		var sym @[]char = mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName)
		if typeInfoDescSeen(out, sym) { continue }
		// Read the type's layout HERE (codegen), off the held RecvTyp — by now
		// the in-place field population has run, so SizeOf is correct (at
		// collection it would read an empty struct → 0).  The nil-guard is
		// defensive: a real receiver holds a non-nil laid-out type, but were
		// RecvTyp ever nil, SizeOf(nil) returns ptrSize() — a plausible-WRONG
		// size — so guard to 0 rather than borrow a pointer's width.
		var size int = 0
		var align int = 0
		var name @[]char
		if info.RecvTyp != nil {
			size = info.RecvTyp.SizeOf()
			align = info.RecvTyp.AlignOf()
			// The record's name is the type's canonical, path-qualified name
			// (unambiguous across packages, TU-invariant) — read off the held
			// RecvTyp at codegen, like size/align.
			name = info.RecvTyp.QualifiedTypeName()
		}
		var desc @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
		desc.Sym = sym
		desc.Size = size
		desc.Align = align
		desc.Name = name
		// Carry the receiver's qualified dtor name (a per-type fact — every
		// (R, *) row for R holds the same DtorFuncName).  Each backend resolves
		// it into the word-0 handle slot (DtorSym) via its own dtor-slot helper,
		// gated on module presence exactly like the vtable slot-0 dtor; empty
		// here for a type that needs no destruction.
		desc.DtorFuncName = info.DtorFuncName
		// Neutral name-blob symbol (each backend prefixes it into NameSym, like
		// Sym); keyed on the receiver type like the record symbol.
		desc.NameSym = mangle.TypeInfoNameBlobName(info.RecvPkg, info.RecvTypeName)
		out = slices.Append[@irdata.TypeInfoDesc](out, desc)
	}
	return out
}

// typeInfoDescSeen reports whether a desc with symbol `s` already appears.
func typeInfoDescSeen(descs @[]@irdata.TypeInfoDesc, s @[]char) bool {
	for i := 0; i < len(descs); i++ {
		if charEq(descs[i].Sym, s) { return true }
	}
	return false
}
