package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Per-type RTTI record (`__typeinfo.<T>`) — the static `TypeInfo` a type
// assertion reads to recover an interface value's dynamic type (spec
// §7.13.14 `type.layout.typeinfo`, §11.12 `iface.rtti`).  One per concrete
// type program-wide (weak, ODR-coalesced); its ADDRESS is the identity a
// concrete assertion compares.  The `*TypeInfo` pointer lives in every
// interface vtable's any-block slot 1 (§7.13.8).
//
// Fixed 7-word layout (word = target int size), in emission order:
//   word 0: destructor handle (*void; null if the type needs none)
//   word 1: size  (SizeOf, bytes)
//   word 2: align (AlignOf, bytes)
//   word 3: name pointer (*readonly char into static storage)
//   word 4: name length
//   word 5: satisfaction-table length
//   word 6: satisfaction-table pointer (*SatEntry)
//
// The size/align words carry the type's layout (increment 2.2a) and word 0 the
// destructor handle (increment 2.2b-1); the remaining pointer words (name,
// satisfaction table) are still null placeholders (later increments).  Nothing
// READS a TypeInfo yet (assertions are not lowered until Phase 5), so beyond
// the record's distinct address only the size/align/dtor are meaningful so far.
// The 7-word layout is fixed so later increments fill the remaining fields
// without shifting offsets.  The reader-side offset contract will live in
// pkg/binate/types when Phase 5 introduces readers.
//
// The word-0 dtor is the SAME destructor handle the vtable any-block slot 0
// carries — each backend resolves desc.DtorSym via the same helper it uses for
// that slot, so the two stay byte-identical (and the record coalesces cleanly
// across TUs: a type's need-for-destruction is a TU-invariant fact, so every TU
// emitting the weak record agrees on whether word 0 is a handle or null).

// TYPEINFO_WORDS is the fixed field count of a TypeInfo record.
const TYPEINFO_WORDS int = 7

// BuildTypeInfo builds the static `TypeInfo` record named `sym`
// (mangle.TypeInfoName).  Weak so duplicate emissions across TUs coalesce
// to one record — hence one identity — per type program-wide.
//
// The record interleaves pointer-sized words (dtor, name-ptr, sat-ptr) with
// `IntSize`-wide scalar words (size, align, name-len, sat-len).  This is
// byte-consistent across the LLVM and native emitters only because
// `PointerSize == IntSize` on every current target (LP64 8/8, ILP32 4/4) —
// the same assumption BuildPackageDescriptor relies on.  A future target
// with `PointerSize != IntSize` would need explicit per-word widths here.
func BuildTypeInfo(desc @TypeInfoDesc) @DataGlobal {
	var w int = types.GetTarget().IntSize
	var dg @DataGlobal = NewDataGlobal(desc.Sym, DG_WEAK, w, true)
	var nullSym @[]char
	// word 0: destructor handle (desc.DtorSym; empty → a null slot, keeping the
	// record reloc-free — and in rodata rather than rodata_relro — for a type
	// that needs no destruction).
	dg.Init = appendTerm(dg.Init, DataSymref(desc.DtorSym, 0))
	// words 1-2: size, align (the type's layout).
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, desc.Size))))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, desc.Align))))
	// word 3: name pointer (null placeholder).
	dg.Init = appendTerm(dg.Init, DataSymref(nullSym, 0))
	// word 4: name length.
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, 0)))
	// word 5: satisfaction-table length.
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, 0)))
	// word 6: satisfaction-table pointer (null placeholder).
	dg.Init = appendTerm(dg.Init, DataSymref(nullSym, 0))
	return dg
}

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit — one per distinct (RecvPkg, RecvTypeName) across m.Impls (every
// concrete type with a local impl is boxable, so gets a TypeInfo) — each
// carrying that type's size/align, read HERE (at codegen) off the ImplInfo's
// held RecvTyp.  Deduped by symbol string.  Each backend iterates this list
// and emits BuildTypeInfo(desc) through its own data-global lowering; the
// weak linkage coalesces the same type emitted from several TUs (its
// size/align are a layout fact, identical across TUs, so the records stay
// byte-identical).  Keyed on the same (RecvPkg, RecvTypeName) as the `__ivt`
// slot-1 reference, so the emitted record and the vtable pointer to it agree.
func CollectTypeInfoDescs(m @Module) @[]@TypeInfoDesc {
	var out @[]@TypeInfoDesc
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		var sym @[]char = mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName)
		if typeInfoDescSeen(out, sym) { continue }
		// Read the type's layout HERE (codegen), off the held RecvTyp — by
		// now the in-place field population has run, so SizeOf is correct
		// (at collection it would read an empty struct → 0).  The nil-guard
		// is defensive: a real receiver holds a non-nil laid-out type (see
		// recvBaseValueType), but were RecvTyp ever nil, SizeOf(nil) returns
		// ptrSize() — a plausible-WRONG size — so guard to 0 rather than let
		// a should-never-happen nil silently borrow a pointer's width.
		var size int = 0
		var align int = 0
		if info.RecvTyp != nil {
			size = info.RecvTyp.SizeOf()
			align = info.RecvTyp.AlignOf()
		}
		var desc @TypeInfoDesc = make(TypeInfoDesc)
		desc.Sym = sym
		desc.Size = size
		desc.Align = align
		// Carry the receiver's qualified dtor name (a per-type fact — every
		// (R, *) row for R holds the same DtorFuncName).  Each backend resolves
		// it into the word-0 handle slot (DtorSym) via its own dtor-slot helper,
		// gated on module presence exactly like the vtable slot-0 dtor; empty
		// here for a type that needs no destruction.
		desc.DtorFuncName = info.DtorFuncName
		out = slices.Append[@TypeInfoDesc](out, desc)
	}
	return out
}

// typeInfoDescSeen reports whether a desc with symbol `s` already appears.
func typeInfoDescSeen(descs @[]@TypeInfoDesc, s @[]char) bool {
	for i := 0; i < len(descs); i++ {
		if charEq(descs[i].Sym, s) { return true }
	}
	return false
}
