package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The write end of the per-type RTTI registry (`__typeinfo.<T>` records):
// RegisterTypeInfo, called at every local ImplInfo creation so each boxable type has
// one per-type home (m.TypeInfos) for its record content.  The read end,
// irgather.CollectTypeInfoDescs, decides which records each backend emits; the
// record byte layout lives in pkg/binate/irdata.

// RegisterTypeInfo records the boxable type (recvPkg, recvName) — its base
// value type `recvTyp` and qualified dtor `dtorName` — in m.TypeInfos, keyed
// (deduped) by receiver identity, which is exactly its mangle.TypeInfoName
// symbol.  Called alongside every local ImplInfo creation, so a type with N
// interface rows registers once (the first wins; every row of a type shares the
// same recvTyp object and dtorName, so first-wins is exact).  This is the
// per-type home ("design D") that replaced the per-(type,iface) RecvTyp field.
func RegisterTypeInfo(m @Module, recvPkg *[]readonly char, recvName *[]readonly char,
		recvTyp @types.Type, dtorName @[]char) {
	for i := 0; i < len(m.TypeInfos); i++ {
		var e @irdata.TypeInfoEntry = m.TypeInfos[i]
		if e == nil { continue }
		// Dedup on the (RecvPkg, RecvTypeName) pair — equivalent to keying on
		// mangle.TypeInfoName (a pure function of the pair), without re-mangling
		// every stored entry on each call.
		if irutil.CharEq(e.RecvPkg, recvPkg) && irutil.CharEq(e.RecvTypeName, recvName) {
			return
		}
	}
	var e @irdata.TypeInfoEntry = make(irdata.TypeInfoEntry)
	e.RecvPkg = buf.CopyStr(recvPkg)
	e.RecvTypeName = buf.CopyStr(recvName)
	e.RecvTyp = recvTyp
	e.DtorFuncName = dtorName
	m.TypeInfos = slices.Append[@irdata.TypeInfoEntry](m.TypeInfos, e)
}
