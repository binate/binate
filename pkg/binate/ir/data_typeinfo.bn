package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The two ends of the per-type RTTI registry (`__typeinfo.<T>` records).
// registerTypeInfo is the WRITE end — called at every local ImplInfo creation
// so each boxable type has one per-type home (m.TypeInfos) for its record
// content.  CollectTypeInfoDescs is the READ end — each backend emits
// irdata.BuildTypeInfo over its result.  The record BYTE layout lives in
// pkg/binate/irdata (data_typeinfo.bn); this side decides which records exist
// and reads each type's layout (size/align/name/dtor) off the held RecvTyp at
// codegen.

// registerTypeInfo records the boxable type (recvPkg, recvName) — its base
// value type `recvTyp` and qualified dtor `dtorName` — in m.TypeInfos, keyed
// (deduped) by receiver identity, which is exactly its mangle.TypeInfoName
// symbol.  Called alongside every local ImplInfo creation, so a type with N
// interface rows registers once (the first wins; every row of a type shares the
// same recvTyp object and dtorName, so first-wins is exact).  This is the
// per-type home ("design D") that replaced the per-(type,iface) RecvTyp field.
func registerTypeInfo(m @Module, recvPkg @[]char, recvName @[]char, recvTyp @types.Type,
		dtorName @[]char) {
	for i := 0; i < len(m.TypeInfos); i++ {
		var e @TypeInfoEntry = m.TypeInfos[i]
		if e == nil { continue }
		// Dedup on the (RecvPkg, RecvTypeName) pair — equivalent to keying on
		// mangle.TypeInfoName (a pure function of the pair), without re-mangling
		// every stored entry on each call.
		if charEq(e.RecvPkg, recvPkg) && charEq(e.RecvTypeName, recvName) {
			return
		}
	}
	var e @TypeInfoEntry = make(TypeInfoEntry)
	e.RecvPkg = buf.CopyStr(recvPkg)
	e.RecvTypeName = buf.CopyStr(recvName)
	e.RecvTyp = recvTyp
	e.DtorFuncName = dtorName
	m.TypeInfos = slices.Append[@TypeInfoEntry](m.TypeInfos, e)
}

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit: the registered per-type entries (m.TypeInfos) PLUS the transitive closure
// of struct types reachable from any of them as a by-value field, an array/slice
// ELEMENT, or a pointer POINTEE (force-emit, so a field's typeinfo pointer targets
// a real, locally-defined weak record — reflection recurses/follows through it).
// Each carries that type's size/align/name/kind/field-table read HERE (at codegen)
// off the held RecvTyp.
//
// This is a DETERMINISTIC PURE function of m.TypeInfos: a worklist seeded from
// m.TypeInfos in order, expanded in field-declaration order, deduped by
// TypeInfoName symbol — so every one of its ~5 backend call sites (LLVM
// emit/collectDefined, 3 native, VM) sees the byte-identical set.  That
// consistency is load-bearing: the LLVM backend calls it once to emit weak
// definitions and once to suppress redundant `external` decls, and the two must
// agree or a force-emitted record gets both a def and an extern decl (a
// redefinition error).  It does NOT mutate m.TypeInfos (which stays pure); the
// force-emitted entries live only in the local worklist.  Pointer pointees make
// the reachability graph potentially CYCLIC (`type Node struct { next *Node }`),
// so termination relies on the symSeen dedup dropping a re-add — NOT on the graph
// being acyclic (by-value/array nesting alone is, but pointers break that).
func CollectTypeInfoDescs(m @Module) @[]@irdata.TypeInfoDesc {
	var out @[]@irdata.TypeInfoDesc
	var seen @[]@[]char
	// Local worklist seeded from the registered entries (in order); force-emitted
	// field-type entries are appended here, never to m.TypeInfos.
	var wl @[]@TypeInfoEntry
	for i := 0; i < len(m.TypeInfos); i++ {
		if m.TypeInfos[i] != nil {
			wl = slices.Append[@TypeInfoEntry](wl, m.TypeInfos[i])
		}
	}
	for i := 0; i < len(wl); i++ {
		var e @TypeInfoEntry = wl[i]
		var sym @[]char = mangle.TypeInfoName(e.RecvPkg, e.RecvTypeName)
		// Dedup by record symbol: a field type that also has its own registered
		// entry (or is shared by several structs / reached via a diamond) is
		// emitted exactly once.  A registered entry always wins — the seed loop
		// enqueues all of m.TypeInfos before any field type — so its real dtor
		// (from the ImplInfo) survives over a force-emit-derived one.
		if symSeen(seen, sym) { continue }
		seen = slices.Append[@[]char](seen, sym)
		out = slices.Append[@irdata.TypeInfoDesc](out, buildTypeInfoDesc(m, e))
		// Force-emit the struct type each field recurses into (its records carry
		// field tables too).  Anonymous / alias struct fields yield no entry
		// (fieldStructEntry → nil) and render a placeholder — a structural mangler
		// for anon structs is a separate follow-up.
		var st @types.Type = structReprOf(e.RecvTyp)
		if st != nil {
			for j := 0; j < len(st.Fields); j++ {
				// Force-emit the record a field recurses into — the field's own
				// struct, the element struct of an array/slice-of-structs, or the
				// pointee struct of a pointer field.  A self-referential pointer
				// (`type Node struct { next *Node }`) re-enqueues Node, which the
				// symSeen dedup drops, so the closure still terminates.
				var fe @TypeInfoEntry = fieldStructEntry(m, recordTypeForField(st.Fields[j].Type))
				if fe != nil {
					wl = slices.Append[@TypeInfoEntry](wl, fe)
				}
			}
		}
	}
	return out
}

// buildTypeInfoDesc builds one per-type record desc from a (registered or
// force-emitted) entry, reading the type's layout HERE (codegen), off the held
// RecvTyp — by now the in-place field population has run, so SizeOf is correct.
// The nil-guard is defensive: a real receiver holds a non-nil laid-out type, but
// were RecvTyp ever nil, SizeOf(nil) returns ptrSize() — a plausible-WRONG size —
// so guard to 0 rather than borrow a pointer's width.
func buildTypeInfoDesc(m @Module, e @TypeInfoEntry) @irdata.TypeInfoDesc {
	var size int = 0
	var align int = 0
	var name @[]char
	if e.RecvTyp != nil {
		size = e.RecvTyp.SizeOf()
		align = e.RecvTyp.AlignOf()
		// The record's name is the type's canonical, path-qualified name
		// (unambiguous across packages, TU-invariant).
		name = e.RecvTyp.QualifiedTypeName()
	}
	var desc @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
	desc.Sym = mangle.TypeInfoName(e.RecvPkg, e.RecvTypeName)
	desc.Size = size
	desc.Align = align
	desc.Name = name
	// Carry the receiver's qualified dtor name.  Each backend resolves it into
	// the word-0 handle slot (DtorSym); empty for a type needing no destruction.
	desc.DtorFuncName = e.DtorFuncName
	desc.NameSym = mangle.TypeInfoNameBlobName(e.RecvPkg, e.RecvTypeName)
	// KIND (record word 5) + field table.  FieldsSym/NamesSym are neutral (each
	// backend prefixes them like NameSym), set only for a struct with fields.
	if e.RecvTyp != nil {
		desc.Kind = typeKind(e.RecvTyp)
		var st @types.Type = structReprOf(e.RecvTyp)
		if st != nil && len(st.Fields) > 0 {
			desc.Fields = collectFieldDescs(m, st)
			desc.FieldsSym = mangle.TypeFieldsName(e.RecvPkg, e.RecvTypeName)
			desc.NamesSym = mangle.TypeFieldNamesName(e.RecvPkg, e.RecvTypeName)
		}
	}
	return desc
}

// fieldStructName derives the (pkg, name) that keys a struct field type's record.
// A NAMED struct uses its nominal name (receiverBaseTypeName + splitQualName,
// empty-pkg → this module); an ANONYMOUS struct uses the reserved STRUCTURAL
// identity `pkg/builtins/rt.__nameless_<lp>` (namelessAnySrcName) so its record is
// TU-invariant.  Either way the field's typeinfo pointer is byte-identical to the
// record force-emit produces (ODR-safe weak coalescing) — and, for a boxed anon
// struct, to what the box side keys on.  Returns ok=false only for a non-struct
// field or a struct with no derivable repr (an alias — receiverBaseTypeName yields
// no name), which gets a null typeinfo pointer and renders as a placeholder.
func fieldStructName(m @Module, ft @types.Type) (@[]char, @[]char, bool) {
	var empty @[]char
	if typeKind(ft) != irdata.KIND_STRUCT {
		return empty, empty, false
	}
	var bn @[]char = receiverBaseTypeName(ft)
	if len(bn) == 0 {
		return empty, empty, false
	}
	// An anonymous struct type carries a per-OCCURRENCE synthetic name
	// (`__anon_<N>`, gen_type_resolve.bn) — occurrence-ordered, so neither
	// structural nor TU-invariant.  Key its record on the reserved STRUCTURAL
	// identity instead (`pkg/builtins/rt.__nameless_<lp>`, namelessAnySrcName →
	// mangleTypeArg's struct arm), a pure function of its field names + types, so two
	// TUs' identical anon structs coalesce to one record and the field renders its
	// fields (decision 7).  The box side (wrapAsIfaceValue) keys a top-level boxed
	// anon struct on the SAME derivation, so the two agree.
	if isAnonStructName(bn) {
		var st @types.Type = structReprOf(ft)
		if st == nil {
			return empty, empty, false
		}
		var apkg @[]char
		var aname @[]char
		apkg, aname = splitQualName(namelessAnySrcName(st))
		return apkg, aname, true
	}
	var pkg @[]char
	var name @[]char
	pkg, name = splitQualName(bn)
	if len(pkg) == 0 {
		pkg = m.PkgPath
	}
	return pkg, name, true
}

// isAnonStructName reports whether a struct type's name is a compiler-synthesized
// anonymous-struct name (`__anon_<N>`) rather than a user-written nominal name.
func isAnonStructName(name *[]readonly char) bool {
	var pfx *[]readonly char = "__anon_"
	if len(name) < len(pfx) { return false }
	for i := 0; i < len(pfx); i++ {
		if name[i] != pfx[i] { return false }
	}
	return true
}

// fieldStructEntry builds a synthetic force-emit entry for the struct type a field
// recurses into — a by-value struct field, an array/slice element, or a pointer
// pointee — so its record + field table exist and the field's typeinfo pointer
// resolves; nil for a non-struct / un-nameable field.
//
// The dtor is left NULL: a force-emitted record is REFLECTION-ONLY (it lets fmt
// render the type), never a destruction path — cleanup always runs the dtor
// directly via compiler-emitted RefDec or the vtable any-block's own slot, never
// through the record's word-0.  Deriving the dtor here (as a box would) is not just
// unnecessary but WRONG across packages: the dtor is a `@__handle.…__dtor_T` global
// defined only in T's own TU, so a force-emit reaching a DIFFERENT package's type
// (e.g. a `*ir.FuncSig` field compiled into pkg/binate/repl) would reference an
// undefined handle → "use of undefined value" at compile time.  Nulling it also
// aligns native/LLVM with the VM, which already leaves force-emit record dtors null
// (the record's identity/size/name/kind/fields are all it needs).  A type that is
// genuinely boxed keeps its real dtor via its own m.TypeInfos entry, which the seed
// loop enqueues first so symSeen keeps it over this reflection-only one.
func fieldStructEntry(m @Module, ft @types.Type) @TypeInfoEntry {
	var pkg @[]char
	var name @[]char
	var ok bool
	pkg, name, ok = fieldStructName(m, ft)
	if !ok { return nil }
	var st @types.Type = structReprOf(ft)
	var e @TypeInfoEntry = make(TypeInfoEntry)
	e.RecvPkg = pkg
	e.RecvTypeName = name
	e.RecvTyp = st
	e.DtorFuncName = ""
	return e
}

// symSeen reports whether `sym` is already in the emitted-set `seen`.
func symSeen(seen @[]@[]char, sym *[]readonly char) bool {
	for i := 0; i < len(seen); i++ {
		if charEq(seen[i], sym) { return true }
	}
	return false
}

// collectFieldDescs builds the per-field metadata for a struct type's field
// table (declaration order): each field's source name, byte offset, KIND_* tag,
// and type size.  For a by-value NAMED struct field it also sets the per-field
// typeinfo pointer (mangle.TypeInfoName of the field type) — the record is
// force-emitted by CollectTypeInfoDescs, so the pointer resolves and reflection
// recurses into the nested struct.  Non-struct fields, and anonymous / alias
// struct fields (no nameable record), leave it null (a placeholder).
func collectFieldDescs(m @Module, st @types.Type) @[]@irdata.FieldInfoDesc {
	var out @[]@irdata.FieldInfoDesc
	for i := 0; i < len(st.Fields); i++ {
		var f @types.Field = st.Fields[i]
		var fd @irdata.FieldInfoDesc = make(irdata.FieldInfoDesc)
		fd.Name = f.Name
		fd.Offset = st.FieldOffset(i)
		fd.Kind = typeKind(f.Type)
		if f.Type != nil {
			fd.Size = f.Type.SizeOf()
		}
		// An array/slice field records its ELEMENT's kind + size (so a reader can
		// stride over and interpret the elements); a pointer field records its
		// POINTEE's kind + size (so a reader can follow it and interpret the target).
		if fd.Kind == irdata.KIND_ARRAY || fd.Kind == irdata.KIND_SLICE || fd.Kind == irdata.KIND_PTR {
			var elem @types.Type = elemTypeOf(f.Type)
			if elem != nil {
				fd.ElemKind = typeKind(elem)
				fd.ElemSize = elem.SizeOf()
			}
		}
		// The record to recurse into for this field's value/elements: the field's
		// own record (a struct field) or its element's record (an array/slice of
		// named structs); empty otherwise.  Force-emitted by CollectTypeInfoDescs.
		var rpkg @[]char
		var rname @[]char
		var ok bool
		rpkg, rname, ok = fieldStructName(m, recordTypeForField(f.Type))
		if ok {
			fd.TypeInfoSym = mangle.TypeInfoName(rpkg, rname)
		}
		out = slices.Append[@irdata.FieldInfoDesc](out, fd)
	}
	return out
}

// peelToRepr strips readonly / alias / named wrappers to a type's underlying
// REPRESENTATION — the kind whose bytes a reflective reader interprets (a named
// struct → its struct, a `type Money int` → int).
func peelToRepr(t @types.Type) @types.Type {
	var s @types.Type = t
	for s != nil {
		if s.Kind == types.TYP_READONLY { s = s.Elem; continue }
		if s.Kind == types.TYP_ALIAS { s = s.Target; continue }
		if s.Kind == types.TYP_NAMED { s = s.Underlying; continue }
		break
	}
	return s
}

// structReprOf returns t's underlying struct type (peeling readonly/alias/named),
// or nil if t is not a struct.
func structReprOf(t @types.Type) @types.Type {
	var s @types.Type = peelToRepr(t)
	if s != nil && s.Kind == types.TYP_STRUCT { return s }
	return nil
}

// elemTypeOf returns the "inner" type a reflective reader steps into: the element
// of an array or (raw/managed) slice, or the POINTEE of a (raw/managed) pointer —
// all spelled `.Elem` — peeling readonly/alias/named wrappers first; nil otherwise.
// A pointer's pointee is the reader's next step exactly as an element is, so both
// ride the same FieldEntry element slots (ElemKind/ElemSize + word-5 record).
func elemTypeOf(t @types.Type) @types.Type {
	var s @types.Type = peelToRepr(t)
	if s == nil { return nil }
	if s.Kind == types.TYP_ARRAY || s.Kind == types.TYP_SLICE || s.Kind == types.TYP_MANAGED_SLICE ||
			s.Kind == types.TYP_POINTER || s.Kind == types.TYP_MANAGED_PTR {
		return s.Elem
	}
	return nil
}

// recordTypeForField returns the type whose `__typeinfo` record a field recurses
// into (for reflection rendering): a struct field → the field type itself; an
// array/slice field → its element type; a pointer field → its pointee type (a
// struct element/pointee gets a record; a non-struct one is filtered downstream by
// fieldStructName/fieldStructEntry); anything else → nil.
func recordTypeForField(fieldTyp @types.Type) @types.Type {
	if fieldTyp == nil { return nil }
	var k int = typeKind(fieldTyp)
	if k == irdata.KIND_STRUCT { return fieldTyp }
	if k == irdata.KIND_ARRAY || k == irdata.KIND_SLICE || k == irdata.KIND_PTR {
		return elemTypeOf(fieldTyp)
	}
	return nil
}

// typeKind maps a type to its KIND_* discriminator (record word 5 / a field's
// kind), on the underlying representation.  Signedness splits int/uint; a
// char/uint8-element slice is KIND_STRING (rendered as text) while a bare
// char/uint8 is KIND_UINT (a number, like Go `byte`).
func typeKind(t @types.Type) int {
	var s @types.Type = peelToRepr(t)
	if s == nil { return irdata.KIND_OTHER }
	if s.Kind == types.TYP_INT || s.Kind == types.TYP_UNTYPED_INT {
		if s.Signed { return irdata.KIND_INT }
		return irdata.KIND_UINT
	}
	if s.Kind == types.TYP_FLOAT || s.Kind == types.TYP_UNTYPED_FLOAT { return irdata.KIND_FLOAT }
	if s.Kind == types.TYP_BOOL || s.Kind == types.TYP_UNTYPED_BOOL { return irdata.KIND_BOOL }
	if s.Kind == types.TYP_SLICE || s.Kind == types.TYP_MANAGED_SLICE {
		if isCharElem(s.Elem) { return irdata.KIND_STRING }
		return irdata.KIND_SLICE
	}
	if s.Kind == types.TYP_STRUCT { return irdata.KIND_STRUCT }
	if s.Kind == types.TYP_ARRAY { return irdata.KIND_ARRAY }
	if s.Kind == types.TYP_POINTER || s.Kind == types.TYP_MANAGED_PTR { return irdata.KIND_PTR }
	if s.Kind == types.TYP_INTERFACE_VALUE || s.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return irdata.KIND_IFACE
	}
	if s.Kind == types.TYP_FUNC_VALUE || s.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return irdata.KIND_FUNC
	}
	return irdata.KIND_OTHER
}

// isCharElem reports whether a slice element type is char/uint8 (an 8-bit
// unsigned integer) — the test that makes a char-slice render as text.
func isCharElem(el @types.Type) bool {
	var e @types.Type = peelToRepr(el)
	return e != nil && e.Kind == types.TYP_INT && e.Width == 8 && !e.Signed
}
