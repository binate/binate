package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The two ends of the per-type RTTI registry (`__typeinfo.<T>` records).
// registerTypeInfo is the WRITE end — called at every local ImplInfo creation
// so each boxable type has one per-type home (m.TypeInfos) for its record
// content.  CollectTypeInfoDescs is the READ end — each backend emits
// irdata.BuildTypeInfo over its result.  The record BYTE layout lives in
// pkg/binate/irdata (data_typeinfo.bn); this side decides which records exist
// and reads each type's layout (size/align/name/dtor) off the held RecvTyp at
// codegen.

// registerTypeInfo records the boxable type (recvPkg, recvName) — its base
// value type `recvTyp` and qualified dtor `dtorName` — in m.TypeInfos, keyed
// (deduped) by receiver identity, which is exactly its mangle.TypeInfoName
// symbol.  Called alongside every local ImplInfo creation, so a type with N
// interface rows registers once (the first wins; every row of a type shares the
// same recvTyp object and dtorName, so first-wins is exact).  This is the
// per-type home ("design D") that replaced the per-(type,iface) RecvTyp field.
func registerTypeInfo(m @Module, recvPkg @[]char, recvName @[]char, recvTyp @types.Type,
		dtorName @[]char) {
	for i := 0; i < len(m.TypeInfos); i++ {
		var e @TypeInfoEntry = m.TypeInfos[i]
		if e == nil { continue }
		// Dedup on the (RecvPkg, RecvTypeName) pair — equivalent to keying on
		// mangle.TypeInfoName (a pure function of the pair), without re-mangling
		// every stored entry on each call.
		if charEq(e.RecvPkg, recvPkg) && charEq(e.RecvTypeName, recvName) {
			return
		}
	}
	var e @TypeInfoEntry = make(TypeInfoEntry)
	e.RecvPkg = buf.CopyStr(recvPkg)
	e.RecvTypeName = buf.CopyStr(recvName)
	e.RecvTyp = recvTyp
	e.DtorFuncName = dtorName
	m.TypeInfos = slices.Append[@TypeInfoEntry](m.TypeInfos, e)
}

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit — one per TypeInfoEntry in the per-type registry (already deduped at
// registration, so no symbol-dedup pass here), each carrying that type's
// size/align/name read HERE (at codegen) off the entry's held RecvTyp.  Each
// backend iterates this list and emits irdata.BuildTypeInfo(desc) through its
// own data-global lowering; the weak linkage coalesces the same type emitted
// from several TUs.  Keyed on the same (RecvPkg, RecvTypeName) as the `__ivt`
// slot-1 reference, so the emitted record and the vtable pointer to it agree.
func CollectTypeInfoDescs(m @Module) @[]@irdata.TypeInfoDesc {
	var out @[]@irdata.TypeInfoDesc
	for i := 0; i < len(m.TypeInfos); i++ {
		var e @TypeInfoEntry = m.TypeInfos[i]
		if e == nil { continue }
		// Read the type's layout HERE (codegen), off the held RecvTyp — by now
		// the in-place field population has run, so SizeOf is correct (at
		// registration it would read an empty struct → 0).  The nil-guard is
		// defensive: a real receiver holds a non-nil laid-out type, but were
		// RecvTyp ever nil, SizeOf(nil) returns ptrSize() — a plausible-WRONG
		// size — so guard to 0 rather than borrow a pointer's width.
		var size int = 0
		var align int = 0
		var name @[]char
		if e.RecvTyp != nil {
			size = e.RecvTyp.SizeOf()
			align = e.RecvTyp.AlignOf()
			// The record's name is the type's canonical, path-qualified name
			// (unambiguous across packages, TU-invariant) — read off the held
			// RecvTyp at codegen, like size/align.
			name = e.RecvTyp.QualifiedTypeName()
		}
		var desc @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
		desc.Sym = mangle.TypeInfoName(e.RecvPkg, e.RecvTypeName)
		desc.Size = size
		desc.Align = align
		desc.Name = name
		// Carry the receiver's qualified dtor name.  Each backend resolves it
		// into the word-0 handle slot (DtorSym) via its own dtor-slot helper,
		// gated on module presence exactly like the vtable slot-0 dtor; empty
		// here for a type that needs no destruction.
		desc.DtorFuncName = e.DtorFuncName
		// Neutral name-blob symbol (each backend prefixes it into NameSym, like
		// Sym); keyed on the receiver type like the record symbol.
		desc.NameSym = mangle.TypeInfoNameBlobName(e.RecvPkg, e.RecvTypeName)
		// KIND (record word 5) + field table — per-type facts read off RecvTyp
		// HERE (codegen), like size/align.  A struct records each field's
		// name/offset/kind/size; the per-field typeinfo pointer stays null until
		// reflection recurses into nested records (a later phase), so this pass
		// emits NO cross-record references.  FieldsSym/NamesSym are neutral (each
		// backend prefixes them like NameSym), set only for a struct with fields.
		if e.RecvTyp != nil {
			desc.Kind = typeKind(e.RecvTyp)
			var st @types.Type = structReprOf(e.RecvTyp)
			if st != nil && len(st.Fields) > 0 {
				desc.Fields = collectFieldDescs(st)
				desc.FieldsSym = mangle.TypeFieldsName(e.RecvPkg, e.RecvTypeName)
				desc.NamesSym = mangle.TypeFieldNamesName(e.RecvPkg, e.RecvTypeName)
			}
		}
		out = slices.Append[@irdata.TypeInfoDesc](out, desc)
	}
	return out
}

// collectFieldDescs builds the per-field metadata for a struct type's field
// table (declaration order): each field's source name, byte offset, KIND_*
// tag, and type size.  The per-field typeinfo pointer is left empty (null) —
// P1 does not reference nested records.
func collectFieldDescs(st @types.Type) @[]@irdata.FieldInfoDesc {
	var out @[]@irdata.FieldInfoDesc
	for i := 0; i < len(st.Fields); i++ {
		var f @types.Field = st.Fields[i]
		var fd @irdata.FieldInfoDesc = make(irdata.FieldInfoDesc)
		fd.Name = f.Name
		fd.Offset = st.FieldOffset(i)
		fd.Kind = typeKind(f.Type)
		if f.Type != nil {
			fd.Size = f.Type.SizeOf()
		}
		out = slices.Append[@irdata.FieldInfoDesc](out, fd)
	}
	return out
}

// peelToRepr strips readonly / alias / named wrappers to a type's underlying
// REPRESENTATION — the kind whose bytes a reflective reader interprets (a named
// struct → its struct, a `type Money int` → int).
func peelToRepr(t @types.Type) @types.Type {
	var s @types.Type = t
	for s != nil {
		if s.Kind == types.TYP_READONLY { s = s.Elem; continue }
		if s.Kind == types.TYP_ALIAS { s = s.Target; continue }
		if s.Kind == types.TYP_NAMED { s = s.Underlying; continue }
		break
	}
	return s
}

// structReprOf returns t's underlying struct type (peeling readonly/alias/named),
// or nil if t is not a struct.
func structReprOf(t @types.Type) @types.Type {
	var s @types.Type = peelToRepr(t)
	if s != nil && s.Kind == types.TYP_STRUCT { return s }
	return nil
}

// typeKind maps a type to its KIND_* discriminator (record word 5 / a field's
// kind), on the underlying representation.  Signedness splits int/uint; a
// char/uint8-element slice is KIND_STRING (rendered as text) while a bare
// char/uint8 is KIND_UINT (a number, like Go `byte`).
func typeKind(t @types.Type) int {
	var s @types.Type = peelToRepr(t)
	if s == nil { return irdata.KIND_OTHER }
	if s.Kind == types.TYP_INT || s.Kind == types.TYP_UNTYPED_INT {
		if s.Signed { return irdata.KIND_INT }
		return irdata.KIND_UINT
	}
	if s.Kind == types.TYP_FLOAT || s.Kind == types.TYP_UNTYPED_FLOAT { return irdata.KIND_FLOAT }
	if s.Kind == types.TYP_BOOL || s.Kind == types.TYP_UNTYPED_BOOL { return irdata.KIND_BOOL }
	if s.Kind == types.TYP_SLICE || s.Kind == types.TYP_MANAGED_SLICE {
		if isCharElem(s.Elem) { return irdata.KIND_STRING }
		return irdata.KIND_SLICE
	}
	if s.Kind == types.TYP_STRUCT { return irdata.KIND_STRUCT }
	if s.Kind == types.TYP_ARRAY { return irdata.KIND_ARRAY }
	if s.Kind == types.TYP_POINTER || s.Kind == types.TYP_MANAGED_PTR { return irdata.KIND_PTR }
	if s.Kind == types.TYP_INTERFACE_VALUE || s.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return irdata.KIND_IFACE
	}
	if s.Kind == types.TYP_FUNC_VALUE || s.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return irdata.KIND_FUNC
	}
	return irdata.KIND_OTHER
}

// isCharElem reports whether a slice element type is char/uint8 (an 8-bit
// unsigned integer) — the test that makes a char-slice render as text.
func isCharElem(el @types.Type) bool {
	var e @types.Type = peelToRepr(el)
	return e != nil && e.Kind == types.TYP_INT && e.Width == 8 && !e.Signed
}
