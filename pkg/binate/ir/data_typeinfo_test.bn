package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// BuildTypeInfo lays the fixed 7-word RTTI record (dtor, size, align,
// name-ptr, name-len, sat-len, sat-ptr) plus, when the desc carries a name, a
// sibling name blob — returned as [record, name-blob].  The size/align words
// carry the desc's layout (increment 2.2a); word 0 carries the destructor
// handle desc.DtorSym (increment 2.2b-1); words 3–4 carry the name pointer
// (desc.NameSym) + byte length (increment 2.2b-2); the sat-ptr/sat-len words
// are still zero/null placeholders.  Weak so duplicate emissions coalesce to
// one record per type program-wide.  pinTarget64 (data_pkg_descriptor_test.bn)
// fixes the word width.
func TestBuildTypeInfo() testing.TestResult {
	pinTarget64()
	var desc @TypeInfoDesc = make(TypeInfoDesc)
	desc.Sym = "_ti"
	desc.Size = 24
	desc.Align = 8
	desc.DtorSym = "_dtorhandle"
	desc.Name = "main.T"
	desc.NameSym = "_ti_name"
	var dgs @[]@DataGlobal = BuildTypeInfo(desc)
	// [record, name-blob] — the name is non-empty, so the blob is emitted.
	if len(dgs) != 2 { return "expected [record, name-blob] when desc has a name" }
	var ti @DataGlobal = dgs[0]

	if ti.Linkage != DG_WEAK { return "TypeInfo should be weak" }
	if !ti.ReadOnly { return "TypeInfo should be read-only" }
	if len(ti.Init) != TYPEINFO_WORDS {
		return "expected a 7-word TypeInfo record"
	}
	// Word 0 carries desc.DtorSym as a symref.
	if ti.Init[0].Kind != DT_SYMREF || !charEq(ti.Init[0].Sym, "_dtorhandle") {
		return "word 0 (dtor) should be a symref to desc.DtorSym"
	}
	// Word 3 is the name pointer (symref to desc.NameSym); word 4 its byte length.
	if ti.Init[3].Kind != DT_SYMREF || !charEq(ti.Init[3].Sym, "_ti_name") {
		return "word 3 (name pointer) should be a symref to desc.NameSym"
	}
	if ti.Init[4].Kind != DT_INT || ti.Init[4].IntVal != cast(uint64, 6) {
		return "word 4 (name-len) should be the name's byte length (len(\"main.T\")=6)"
	}
	// Word 6 (sat-table pointer) is still a null symref.
	if ti.Init[6].Kind != DT_SYMREF || len(ti.Init[6].Sym) != 0 {
		return "word 6 (sat-table pointer) should be a null symref"
	}
	// Size / align words carry the desc's layout at 1, 2.
	if ti.Init[1].Kind != DT_INT || ti.Init[1].IntVal != cast(uint64, 24) {
		return "word 1 (size) should carry desc.Size"
	}
	if ti.Init[2].Kind != DT_INT || ti.Init[2].IntVal != cast(uint64, 8) {
		return "word 2 (align) should carry desc.Align"
	}
	// sat-len is still a zero placeholder at 5.
	if ti.Init[5].Kind != DT_INT { return "word 5 (sat-len) should be an int" }
	// The name blob carries the name bytes.
	var blob @DataGlobal = dgs[1]
	if blob.Linkage != DG_LOCAL { return "name blob should be TU-local" }
	if len(blob.Init) != 1 || blob.Init[0].Kind != DT_BYTES {
		return "name blob should be a single byte-run term"
	}
	if !charEq(blob.Init[0].Bytes, "main.T") {
		return "name blob should hold the name bytes"
	}
	return ""
}

// BuildTypeInfo with an empty DtorSym / empty Name (a type that needs no
// destruction and carries no name) lays a NULL word-0 and word-3 slot and emits
// NO name blob, keeping the record reloc-free — the list is just [record].
func TestBuildTypeInfoNullDtor() testing.TestResult {
	pinTarget64()
	var desc @TypeInfoDesc = make(TypeInfoDesc)
	desc.Sym = "_ti"
	desc.Size = 8
	desc.Align = 8
	var dgs @[]@DataGlobal = BuildTypeInfo(desc)
	if len(dgs) != 1 { return "expected just [record] when desc has no name" }
	var ti @DataGlobal = dgs[0]
	if ti.Init[0].Kind != DT_SYMREF || len(ti.Init[0].Sym) != 0 {
		return "word 0 (dtor) should be a null symref when DtorSym is empty"
	}
	if ti.Init[3].Kind != DT_SYMREF || len(ti.Init[3].Sym) != 0 {
		return "word 3 (name) should be a null symref when Name is empty"
	}
	if ti.Init[4].Kind != DT_INT || ti.Init[4].IntVal != cast(uint64, 0) {
		return "word 4 (name-len) should be 0 when Name is empty"
	}
	return ""
}

// CollectTypeInfoDescs returns one distinct record per distinct (RecvPkg,
// RecvTypeName) across m.Impls — several impls of the same type yield a
// single record (a type has exactly one RTTI record) — and each reads its
// size/align off the ImplInfo's held RecvTyp.  A nil RecvTyp yields size 0
// (the null-guard): SizeOf(nil) would return ptrSize() — a plausible-WRONG
// size — so the guard must produce 0, not silently borrow a pointer width.
func TestCollectTypeInfoDescs() testing.TestResult {
	pinTarget64()
	var m @Module = NewModule("\"main\"")
	// T (RecvTyp int → size 8) has two rows → deduped; U (uint8 → size 1);
	// V has a nil RecvTyp → size 0 via the guard.
	m.Impls = slices.Append[@ImplInfo](m.Impls,
		mkImplInfoTI("main", "T", types.TypInt(), "main.__dtor_T"))
	m.Impls = slices.Append[@ImplInfo](m.Impls,
		mkImplInfoTI("main", "T", types.TypInt(), "main.__dtor_T"))
	m.Impls = slices.Append[@ImplInfo](m.Impls,
		mkImplInfoTI("main", "U", types.TypUint8(), "main.__dtor_U"))
	var nilTyp @types.Type
	var noDtor @[]char
	m.Impls = slices.Append[@ImplInfo](m.Impls,
		mkImplInfoTI("main", "V", nilTyp, noDtor))

	var descs @[]@TypeInfoDesc = CollectTypeInfoDescs(m)
	if len(descs) != 3 {
		return "expected 3 distinct descs (T deduped, U, V)"
	}
	// descs[0]=T (int: 8/8), [1]=U (uint8: 1/1), [2]=V (nil → 0).
	if descs[0].Size != 8 || descs[0].Align != 8 {
		return "desc for T should read size 8 / align 8 off RecvTyp"
	}
	if descs[1].Size != 1 {
		return "desc for U should read size 1 off RecvTyp"
	}
	if descs[2].Size != 0 {
		return "desc for V (nil RecvTyp) should be size 0, not SizeOf(nil)"
	}
	// The per-type dtor name is carried onto the desc (T's rows set it; the
	// backends resolve it into the word-0 handle).  V (no dtor) stays empty.
	if !charEq(descs[0].DtorFuncName, "main.__dtor_T") {
		return "desc for T should carry its DtorFuncName"
	}
	if len(descs[2].DtorFuncName) != 0 {
		return "desc for V (no dtor) should carry an empty DtorFuncName"
	}
	// The record's name is the type's canonical QualifiedTypeName, read off the
	// held RecvTyp (T = int); V (nil RecvTyp) carries an empty name via the guard.
	if !charEq(descs[0].Name, "int") {
		return "desc for T (int) should carry the canonical name \"int\""
	}
	if len(descs[2].Name) != 0 {
		return "desc for V (nil RecvTyp) should carry an empty name"
	}
	// The neutral name-blob symbol is set for every type (backends prefix it).
	if len(descs[0].NameSym) == 0 {
		return "desc for T should carry a name-blob symbol"
	}
	return ""
}

// mkImplInfoTI builds a minimal ImplInfo carrying the receiver identity
// CollectTypeInfoDescs keys on, the held RecvTyp it reads size/align off, and
// the per-type dtor name (dtorName) it carries onto the desc.
func mkImplInfoTI(recvPkg @[]char, recvType @[]char,
		recvTyp @types.Type, dtorName @[]char) @ImplInfo {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = recvPkg
	info.RecvTypeName = recvType
	info.RecvTyp = recvTyp
	info.DtorFuncName = dtorName
	return info
}
