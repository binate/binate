package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"

// RegisterTypeInfo keeps one entry per receiver (pkg, name): a type with several impls
// registers once, the first registration winning, and another receiver gets its own.
func TestRegisterTypeInfoOnePerReceiver() testing.TestResult {
	var m @Module = NewModule("p")
	RegisterTypeInfo(m, "p", "T", types.TypInt(), "p.__dtor_T")
	RegisterTypeInfo(m, "p", "T", types.TypBool(), "p.__other")
	if len(m.TypeInfos) != 1 { return "a second registration of p.T should not add an entry" }
	if m.TypeInfos[0].RecvTyp.Kind != types.TYP_INT {
		return "the first registration's type should win"
	}
	if !irutil.CharEq(m.TypeInfos[0].DtorFuncName, "p.__dtor_T") {
		return "the first registration's dtor should win"
	}
	RegisterTypeInfo(m, "p", "U", types.TypInt(), "p.__dtor_U")
	RegisterTypeInfo(m, "q", "T", types.TypInt(), "q.__dtor_T")
	if len(m.TypeInfos) != 3 { return "another receiver, by name or by package, gets its own entry" }
	var e @irdata.TypeInfoEntry = m.TypeInfos[1]
	if !irutil.CharEq(e.RecvPkg, "p") || !irutil.CharEq(e.RecvTypeName, "U") {
		return "the second entry should record p.U"
	}
	e = m.TypeInfos[2]
	if !irutil.CharEq(e.RecvPkg, "q") || !irutil.CharEq(e.RecvTypeName, "T") {
		return "the third entry should record q.T"
	}
	return ""
}
