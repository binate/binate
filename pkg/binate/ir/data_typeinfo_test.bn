package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"

// RegisterTypeInfo dedups by receiver identity (a type has exactly one RTTI
// record even with several impls), and CollectTypeInfoDescs then reads each
// record's size/align/name off the entry's held RecvTyp.  A nil RecvTyp yields
// size 0 (the null-guard): Size(nil) would return ptrSize() — a
// plausible-WRONG size — so the guard must produce 0, not silently borrow a
// pointer width.
func TestCollectTypeInfoDescs() testing.TestResult {
	pinTarget64()
	var m @Module = NewModule("\"main\"")
	// T (RecvTyp int → size 8) registered twice → deduped to one entry;
	// U (uint8 → size 1); V has a nil RecvTyp → size 0 via the guard.
	RegisterTypeInfo(m, "main", "T", types.TypInt(), "main.__dtor_T")
	RegisterTypeInfo(m, "main", "T", types.TypInt(), "main.__dtor_T")
	RegisterTypeInfo(m, "main", "U", types.TypUint8(), "main.__dtor_U")
	var nilTyp @types.Type
	var noDtor @[]char
	RegisterTypeInfo(m, "main", "V", nilTyp, noDtor)

	if len(m.TypeInfos) != 3 {
		return "expected 3 registry entries (T deduped, U, V)"
	}

	var descs @[]@irdata.TypeInfoDesc = CollectTypeInfoDescs(m)
	if len(descs) != 3 {
		return "expected 3 distinct descs (T deduped, U, V)"
	}
	// descs[0]=T (int: 8/8), [1]=U (uint8: 1/1), [2]=V (nil → 0).
	if descs[0].Size != 8 || descs[0].Align != 8 {
		return "desc for T should read size 8 / align 8 off RecvTyp"
	}
	if descs[1].Size != 1 {
		return "desc for U should read size 1 off RecvTyp"
	}
	if descs[2].Size != 0 {
		return "desc for V (nil RecvTyp) should be size 0, not Size(nil)"
	}
	// The per-type dtor name is carried onto the desc (T's registration sets it;
	// the backends resolve it into the word-0 handle).  V (no dtor) stays empty.
	if !irutil.CharEq(descs[0].DtorFuncName, "main.__dtor_T") {
		return "desc for T should carry its DtorFuncName"
	}
	if len(descs[2].DtorFuncName) != 0 {
		return "desc for V (no dtor) should carry an empty DtorFuncName"
	}
	// The record's name is the type's canonical QualifiedTypeName, read off the
	// held RecvTyp (T = int); V (nil RecvTyp) carries an empty name via the guard.
	if !irutil.CharEq(descs[0].Name, "int") {
		return "desc for T (int) should carry the canonical name \"int\""
	}
	if len(descs[2].Name) != 0 {
		return "desc for V (nil RecvTyp) should carry an empty name"
	}
	// The neutral name-blob symbol is set for every type (backends prefix it).
	if len(descs[0].NameSym) == 0 {
		return "desc for T should carry a name-blob symbol"
	}
	return ""
}

// A readonly variant's record (receiver name irutil.ReadonlyVariantName(T)) is a
// distinct registry entry from T's, and displays as `readonly <T's name>`.
func TestCollectTypeInfoDescsReadonlyVariant() testing.TestResult {
	pinTarget64()
	var m @Module = NewModule("\"main\"")
	RegisterTypeInfo(m, "main", "T", types.TypInt(), "main.__dtor_T")
	RegisterTypeInfo(m, "main", irutil.ReadonlyVariantName("T"), types.TypInt(), "main.__dtor_T")
	var descs @[]@irdata.TypeInfoDesc = CollectTypeInfoDescs(m)
	if len(descs) != 2 {
		return "expected 2 descs (T and its readonly variant)"
	}
	if !irutil.CharEq(descs[0].Name, "int") {
		return "T's record should carry the plain name"
	}
	if !irutil.CharEq(descs[1].Name, "readonly int") {
		return "the variant's record should display as `readonly <name>`"
	}
	if !irutil.CharEq(descs[1].DtorFuncName, "main.__dtor_T") {
		return "the variant's record should carry T's destructor"
	}
	return ""
}

// A raw-origin variant's record (irutil.RawVariantName(T)) is a distinct registry
// entry that displays as T's own name; the readonly variant of it as `readonly
// <T's name>`.  Each names the record of its box's dynamic type -- T's, or T's
// readonly variant's -- which is emitted after it, naming itself.
func TestCollectTypeInfoDescsRawVariant() testing.TestResult {
	pinTarget64()
	var m @Module = NewModule("\"main\"")
	var raw @[]char = irutil.RawVariantName("T")
	RegisterTypeInfo(m, "main", raw, types.TypInt(), "main.__dtor_T")
	RegisterTypeInfo(m, "main", irutil.ReadonlyVariantName(raw), types.TypInt(), "main.__dtor_T")
	var descs @[]@irdata.TypeInfoDesc = CollectTypeInfoDescs(m)
	if len(descs) != 4 {
		return "expected 4 descs (the two raw-origin variants and the records they name)"
	}
	if !irutil.CharEq(descs[0].Name, "int") || !irutil.CharEq(descs[1].Name, "readonly int") {
		return "the raw-origin variant should read `<name>`, its readonly one `readonly <name>`"
	}
	var t @[]char = mangle.TypeInfoName("main", "T")
	var roT @[]char = mangle.TypeInfoName("main", irutil.ReadonlyVariantName("T"))
	if !irutil.CharEq(descs[2].Sym, t) || !irutil.CharEq(descs[3].Sym, roT) {
		return "T's record and its readonly variant's should be emitted after the variants"
	}
	if !irutil.CharEq(descs[0].CanonicalSym, t) || !irutil.CharEq(descs[1].CanonicalSym, roT) {
		return "a raw-origin variant's record should name its box's dynamic type's"
	}
	if !irutil.CharEq(descs[2].CanonicalSym, t) || !irutil.CharEq(descs[3].CanonicalSym, roT) {
		return "a type's own record should name itself"
	}
	if !irutil.CharEq(descs[2].DtorFuncName, "main.__dtor_T") {
		return "a record emitted for a variant should keep the variant's destructor"
	}
	if !irutil.CharEq(descs[2].OriginVariantSym, descs[0].Sym) ||
			!irutil.CharEq(descs[3].OriginVariantSym, descs[1].Sym) {
		return "a record should name the raw-origin variant whose canonical record it is"
	}
	if len(descs[0].OriginVariantSym) != 0 || len(descs[1].OriginVariantSym) != 0 {
		return "a raw-origin variant's record has no raw-origin variant"
	}
	return ""
}
