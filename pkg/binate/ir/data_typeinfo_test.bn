package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/builtins/testing"

// registerTypeInfo dedups by receiver identity (a type has exactly one RTTI
// record even with several impls), and CollectTypeInfoDescs then reads each
// record's size/align/name off the entry's held RecvTyp.  A nil RecvTyp yields
// size 0 (the null-guard): SizeOf(nil) would return ptrSize() — a
// plausible-WRONG size — so the guard must produce 0, not silently borrow a
// pointer width.
func TestCollectTypeInfoDescs() testing.TestResult {
	pinTarget64()
	var m @Module = NewModule("\"main\"")
	// T (RecvTyp int → size 8) registered twice → deduped to one entry;
	// U (uint8 → size 1); V has a nil RecvTyp → size 0 via the guard.
	registerTypeInfo(m, "main", "T", types.TypInt(), "main.__dtor_T")
	registerTypeInfo(m, "main", "T", types.TypInt(), "main.__dtor_T")
	registerTypeInfo(m, "main", "U", types.TypUint8(), "main.__dtor_U")
	var nilTyp @types.Type
	var noDtor @[]char
	registerTypeInfo(m, "main", "V", nilTyp, noDtor)

	if len(m.TypeInfos) != 3 {
		return "expected 3 registry entries (T deduped, U, V)"
	}

	var descs @[]@irdata.TypeInfoDesc = CollectTypeInfoDescs(m)
	if len(descs) != 3 {
		return "expected 3 distinct descs (T deduped, U, V)"
	}
	// descs[0]=T (int: 8/8), [1]=U (uint8: 1/1), [2]=V (nil → 0).
	if descs[0].Size != 8 || descs[0].Align != 8 {
		return "desc for T should read size 8 / align 8 off RecvTyp"
	}
	if descs[1].Size != 1 {
		return "desc for U should read size 1 off RecvTyp"
	}
	if descs[2].Size != 0 {
		return "desc for V (nil RecvTyp) should be size 0, not SizeOf(nil)"
	}
	// The per-type dtor name is carried onto the desc (T's registration sets it;
	// the backends resolve it into the word-0 handle).  V (no dtor) stays empty.
	if !charEq(descs[0].DtorFuncName, "main.__dtor_T") {
		return "desc for T should carry its DtorFuncName"
	}
	if len(descs[2].DtorFuncName) != 0 {
		return "desc for V (no dtor) should carry an empty DtorFuncName"
	}
	// The record's name is the type's canonical QualifiedTypeName, read off the
	// held RecvTyp (T = int); V (nil RecvTyp) carries an empty name via the guard.
	if !charEq(descs[0].Name, "int") {
		return "desc for T (int) should carry the canonical name \"int\""
	}
	if len(descs[2].Name) != 0 {
		return "desc for V (nil RecvTyp) should carry an empty name"
	}
	// The neutral name-blob symbol is set for every type (backends prefix it).
	if len(descs[0].NameSym) == 0 {
		return "desc for T should carry a name-blob symbol"
	}
	return ""
}
