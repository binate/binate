package "pkg/binate/ir"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// BuildTypeInfo lays the fixed 7-word RTTI record (dtor, size, align,
// name-ptr, name-len, sat-len, sat-ptr).  Increment 2.1 emits every field
// zero/null — the pointer words as null symrefs, the scalar words as zero
// ints — so only the record's address (the type identity) is meaningful.
// Weak so duplicate emissions coalesce to one record per type program-wide.
// pinTarget64 (data_pkg_descriptor_test.bn) fixes the word width.
func TestBuildTypeInfo() testing.TestResult {
	pinTarget64()
	var ti @DataGlobal = BuildTypeInfo("_ti")

	if ti.Linkage != DG_WEAK { return "TypeInfo should be weak" }
	if !ti.ReadOnly { return "TypeInfo should be read-only" }
	if len(ti.Init) != TYPEINFO_WORDS {
		return "expected a 7-word TypeInfo record"
	}
	// Pointer words (dtor, name-ptr, sat-ptr) are null symrefs at 0, 3, 6.
	if ti.Init[0].Kind != DT_SYMREF || len(ti.Init[0].Sym) != 0 {
		return "word 0 (dtor) should be a null symref"
	}
	if ti.Init[3].Kind != DT_SYMREF || len(ti.Init[3].Sym) != 0 {
		return "word 3 (name pointer) should be a null symref"
	}
	if ti.Init[6].Kind != DT_SYMREF || len(ti.Init[6].Sym) != 0 {
		return "word 6 (sat-table pointer) should be a null symref"
	}
	// Scalar words (size, align, name-len, sat-len) are zero ints at 1,2,4,5.
	if ti.Init[1].Kind != DT_INT || ti.Init[1].IntVal != cast(uint64, 0) {
		return "word 1 (size) should be a zero int"
	}
	if ti.Init[2].Kind != DT_INT { return "word 2 (align) should be an int" }
	if ti.Init[4].Kind != DT_INT { return "word 4 (name-len) should be an int" }
	if ti.Init[5].Kind != DT_INT { return "word 5 (sat-len) should be an int" }
	return ""
}

// CollectTypeInfoSyms returns one distinct __typeinfo symbol per distinct
// (RecvPkg, RecvTypeName) across m.Impls — several impls of the same type
// (e.g. `impl T : Closer` + `impl T : Reader`, which register two ImplInfo
// rows) yield a single TypeInfo symbol, since a type has exactly one RTTI
// record.
func TestCollectTypeInfoSyms() testing.TestResult {
	var m @Module = NewModule("\"main\"")
	// Two rows for receiver T, one for receiver U → 2 distinct symbols.
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoTI("main", "T"))
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoTI("main", "T"))
	m.Impls = slices.Append[@ImplInfo](m.Impls, mkImplInfoTI("main", "U"))

	var syms @[]@[]char = CollectTypeInfoSyms(m)
	if len(syms) != 2 {
		return "expected 2 distinct TypeInfo symbols (T deduped, U)"
	}
	if charEq(syms[0], syms[1]) {
		return "the two collected symbols should differ (T vs U)"
	}
	return ""
}

// mkImplInfoTI builds a minimal ImplInfo carrying just the receiver
// identity CollectTypeInfoSyms keys on.
func mkImplInfoTI(recvPkg @[]char, recvType @[]char) @ImplInfo {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = recvPkg
	info.RecvTypeName = recvType
	return info
}
