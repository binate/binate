package "pkg/binate/ir"

import "pkg/binate/irutil"
import "pkg/binate/types"

// FieldPtrBaseType returns the aggregate an OP_GET_FIELD_PTR's base points at
// (see the declaration).
func FieldPtrBaseType(base @Instr) @types.Type {
	if base == nil {
		return nil
	}
	// A slot (OP_ALLOC / OP_MAKE, a global's address) carries its allocated type
	// as TypeArg.  Other ops use TypeArg for something else — a bit_cast's or
	// cast's is its target type, the pointer type itself — which is never an
	// aggregate, so it falls through to the pointee below.
	var ta @types.Type = irutil.PeelTransparent(base.TypeArg)
	if isFieldPtrAggregate(ta) {
		return ta
	}
	// Otherwise the base's static pointer type names the pointee.  Peel it first:
	// a named pointer type (`type P *S`) carries its Elem on its underlying type.
	var pt @types.Type = irutil.PeelTransparent(base.Typ)
	if pt != nil && (pt.Kind == types.TYP_POINTER || pt.Kind == types.TYP_MANAGED_PTR) {
		var el @types.Type = irutil.PeelTransparent(pt.Elem)
		if isFieldPtrAggregate(el) {
			return el
		}
	}
	return nil
}

// isFieldPtrAggregate reports whether t (peeled of names / aliases / readonly)
// is a type whose fields OP_GET_FIELD_PTR addresses: a struct (or a named type
// carrying its fields directly), or a (managed-)slice header.
func isFieldPtrAggregate(t @types.Type) bool {
	if t == nil {
		return false
	}
	if t.Kind == types.TYP_NAMED {
		return len(t.Fields) > 0
	}
	return t.Kind == types.TYP_STRUCT || t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE
}
