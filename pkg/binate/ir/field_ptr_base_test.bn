package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for FieldPtrBaseType (field_ptr_base.bn).

// fpbStruct is `struct { a int; b int }` named S.
func fpbStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Name = "a"
	fs[0].Type = types.TypInt()
	fs[1] = make(types.Field)
	fs[1].Name = "b"
	fs[1].Type = types.TypInt()
	return types.MakeStructType("S", fs)
}

// fpbInstr is a bare op-typed instruction in a scratch function.
func fpbInstr(op int, typ @types.Type, typeArg @types.Type) @Instr {
	var f @Func = NewFunc("", "t", make_slice(@Param, 0), make_slice(@types.Type, 0))
	var i @Instr = NewInstr(f, op, typ)
	i.TypeArg = typeArg
	return i
}

func TestFieldPtrBaseTypeSlot() testing.TestResult {
	var s @types.Type = fpbStruct()
	var a @Instr = fpbInstr(iropcode.OP_ALLOC, types.MakePointerType(s), s)
	if FieldPtrBaseType(a) != s { return fail("a slot's pointee is its allocated type") }
	return ""
}

// A bit_cast's TypeArg is its target type (the pointer), not the pointee.
func TestFieldPtrBaseTypeBitCastToManaged() testing.TestResult {
	var s @types.Type = fpbStruct()
	var mp @types.Type = types.MakeManagedPtrType(s)
	var c @Instr = fpbInstr(iropcode.OP_BIT_CAST, mp, mp)
	if FieldPtrBaseType(c) != s { return fail("bit_cast(@S, p) points at S") }
	return ""
}

func TestFieldPtrBaseTypeLoadOfPointer() testing.TestResult {
	var s @types.Type = fpbStruct()
	var l @Instr = fpbInstr(iropcode.OP_LOAD, types.MakePointerType(s), nil)
	if FieldPtrBaseType(l) != s { return fail("a loaded *S points at S") }
	return ""
}

// A named pointer type carries its Elem on its underlying pointer type.
func TestFieldPtrBaseTypeNamedPointer() testing.TestResult {
	var s @types.Type = fpbStruct()
	var p @types.Type = types.MakeNamedType("P")
	p.Underlying = types.MakeManagedPtrType(s)
	var l @Instr = fpbInstr(iropcode.OP_LOAD, p, nil)
	if FieldPtrBaseType(l) != s { return fail("a value of `type P @S` points at S") }
	return ""
}

func TestFieldPtrBaseTypeSliceSlot() testing.TestResult {
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	var a @Instr = fpbInstr(iropcode.OP_ALLOC, types.MakePointerType(ms), ms)
	var t @types.Type = FieldPtrBaseType(a)
	if t == nil || t.Kind != types.TYP_MANAGED_SLICE {
		return fail("a managed-slice slot points at its header")
	}
	return ""
}

func TestFieldPtrBaseTypeNoAggregate() testing.TestResult {
	var l @Instr = fpbInstr(iropcode.OP_LOAD, types.MakePointerType(types.TypInt()), nil)
	if FieldPtrBaseType(l) != nil { return fail("*int points at no aggregate") }
	if FieldPtrBaseType(nil) != nil { return fail("nil base") }
	return ""
}
