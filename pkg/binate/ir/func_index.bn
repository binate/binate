package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/irutil"
import "pkg/std/containers/table"

// A module's functions by name (Module.FuncIndex), so LookupModuleFunc costs time
// independent of how many there are.

// LookupModuleFunc returns the first @Func with the given name in m.Funcs, or nil
// (see ir.bni): through m.FuncIndex, built again when it does not cover m.Funcs.  A hit
// whose function has another name is an internal error: Funcs was changed in place
// without DropFuncIndex.
func LookupModuleFunc(m @Module, name *[]readonly char) @Func {
	if m == nil { return nil }
	syncFuncIndex(m)
	i, found := m.FuncIndex.Get(name)
	if !found { return nil }
	if !irutil.Streq(m.Funcs[i].Name, name) {
		panic("internal error: Module.Funcs changed in place without DropFuncIndex")
	}
	return m.Funcs[i]
}

// DropFuncIndex drops m's index of Funcs (see ir.bni).
func DropFuncIndex(m @Module) {
	var none @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]
	m.FuncIndex = none
	var noFuncs @[]@Func
	m.FuncIndexFor = noFuncs
}

// syncFuncIndex builds m.FuncIndex over m.Funcs again unless it covers this very list
// (FuncIndexFor), the first index of each name.
func syncFuncIndex(m @Module) {
	if m.FuncIndex != nil && same(m.FuncIndexFor, m.Funcs) { return }
	m.FuncIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(m.Funcs); i++ {
		_, _ = m.FuncIndex.GetOrPut(m.Funcs[i].Name, i)
	}
	m.FuncIndexFor = m.Funcs
}
