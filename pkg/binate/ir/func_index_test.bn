package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for func_index.bn.

// namedFunc returns a function named name, with no parameters or results.
func namedFunc(name *[]readonly char) @Func {
	var noParams @[]@Param
	var noResults @[]@types.Type
	return NewFunc("", buf.CopyStr(name), noParams, noResults)
}

// A lookup finds the first function of a name; one added after the index was built;
// none popped by an undo; a renamed one under its new name once the index is
// dropped; and the first of a name after an element is replaced in place and the
// index dropped.
func TestLookupModuleFunc() testing.TestResult {
	var m @Module = NewModule("m")
	var a1 @Func = namedFunc("a")
	var b @Func = namedFunc("b")
	var a2 @Func = namedFunc("a")
	m.AddFunc(a1)
	m.AddFunc(b)
	m.AddFunc(a2)
	if LookupModuleFunc(m, "a") != a1 || LookupModuleFunc(m, "z") != nil {
		return "the first a, no z"
	}
	var c @Func = namedFunc("c")
	m.AddFunc(c)
	if LookupModuleFunc(m, "c") != c { return "c, added after the index was built" }
	_, _ = m.FuncsVec.Pop()
	m.Funcs = m.FuncsVec.Items()
	if LookupModuleFunc(m, "c") != nil { return "no c once popped" }
	b.Name = buf.CopyStr("bb")
	DropFuncIndex(m)
	if LookupModuleFunc(m, "bb") != b || LookupModuleFunc(m, "b") != nil {
		return "b under its new name"
	}
	var d @Func = namedFunc("d")
	m.Funcs[0] = d
	DropFuncIndex(m)
	if LookupModuleFunc(m, "a") != a2 || LookupModuleFunc(m, "d") != d {
		return "a2 and d, once a1's slot holds d"
	}
	return ""
}

// After functions are popped in place (as the REPL's undo does, though it also drops
// the index) and as many pushed back, in the same backing, a lookup finds the new
// ones: the first AddFunc after the pop dropped the old index, so it is never current
// again.
func TestLookupModuleFuncAfterPopAndRegrow() testing.TestResult {
	var m @Module = NewModule("m")
	m.AddFunc(namedFunc("a"))
	m.AddFunc(namedFunc("b"))
	if LookupModuleFunc(m, "b") == nil { return "b" }
	_, _ = m.FuncsVec.Pop()
	m.Funcs = m.FuncsVec.Items()
	var c @Func = namedFunc("c")
	m.AddFunc(c)
	if LookupModuleFunc(m, "c") != c || LookupModuleFunc(m, "b") != nil {
		return "c, pushed where b was; no b"
	}
	var other @[]@Func = make_slice(@Func, 1)
	var x @Func = namedFunc("x")
	other[0] = x
	m.Funcs = other
	if LookupModuleFunc(m, "x") != x { return "x, in the list assigned" }
	var y @Func = namedFunc("y")
	m.AddFunc(y)
	if LookupModuleFunc(m, "y") != y || LookupModuleFunc(m, "x") != nil {
		return "y, added to FuncsVec, whose view Funcs is again; no x"
	}
	return ""
}
