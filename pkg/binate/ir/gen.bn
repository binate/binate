package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// IR Generation: AST → IR Module
//
// Currently supports: function declarations, println/print of
// string/int/bool literals, return statements, integer arithmetic,
// variable declarations, assignments, if/else, for loops.
// ============================================================

// ModuleConst.Kind selects which constant family a top-level const holds,
// and thus which Emit* a read site dispatches to.  The non-int families
// exist because `evalConstExpr` is integer-only: without a typed read-site
// dispatch, a non-int top-level const fell through to EmitConstInt(0) —
// both the wrong value and (e.g. an `i1` branch on a bool) malformed LLVM
// IR.  Each family stashes its literal in its own ModuleConst slot so read
// sites in gen_expr / gen_selector emit the matching constant: integers in
// `Val`, bools in `BoolVal`, floats in `FltText` (raw literal text, parsed
// by the backend), float const-expressions re-lowered from `Expr`.  Consts
// are scalar-only (the checker rejects non-scalar const types), so there is
// no string / composite family.  CONST_INT is the zero value, so producers
// that only populate `Val` (the common int / iota case) need no explicit
// Kind assignment.
const (
	CONST_INT  = 0  // integer / iota → EmitConstInt(Val)
	CONST_BOOL = 1  // bool literal → EmitConstBool(BoolVal)
	CONST_FLT  = 2  // float literal → EmitConstFloat(FltText, Typ)
	CONST_EXPR = 3  // float const-EXPRESSION → genExpr(Expr) at read site
)

// The per-module IR-gen lookup tables — ModuleConst / FuncSig /
// ModuleStruct / ModuleGlobal / ModuleTypeAlias and the @Module.Consts /
// FuncSigs / Structs / GlobalVars / TypeAliases fields that hold them —
// are declared in ir.bni: they are field types of the exported @Module, so
// two compilations in one process accumulate gen state on their own module
// rather than a shared global (plan-embeddable-vm.md inc 5).

// Pending managed-slice dtor types — collected during IR gen, generated after.
var pendingMsDtors @[]@types.Type

// Pending struct/array types that need dtors and copies — collected during
// scope cleanup emission, generated after function IR gen.
var pendingStructDtors @[]@types.Type

// pendingMsDtorNames is the precomputed dtor-name list kept parallel to
// pendingMsDtors so the registration dedup compares the incoming name (built
// once) against the stored names via hasName, instead of re-spelling every
// existing entry's name on every call. That per-entry re-mangle was
// O(functions × pending-types) name allocations — the IR-gen OOM driver. Grows
// and resets in lockstep with pendingMsDtors (registerPendingMsDtor appends
// both; InitModule and the REPL drain clear both).
var pendingMsDtorNames @[]@[]char

// pendingStructDtorNames is the precomputed dtor-name list kept parallel to
// pendingStructDtors, with the same O(1)-dedup role as pendingMsDtorNames; it
// grows and resets in lockstep with pendingStructDtors.
var pendingStructDtorNames @[]@[]char

// Package alias for current RegisterImport context (for resolving unqualified types)
var currentImportAlias @[]char

// importAliasNames / importAliasPaths form a parallel map from an
// import's local alias (the last path segment, e.g. `buf`) to its
// full package path (e.g. `pkg/binate/buf`).  Populated via RecordImportPath
// (and a file-based fallback), consulted by resolveImportPkg so
// cross-package qualified names carry the full path — which is what
// lets the mangler distinguish two packages that share a last-segment
// name (full-path mangling; see pkg/binate/mangle).  Reset per module in
// InitModule.  importAliasNames holds the alias keys.
var importAliasNames @[]@[]char
// importAliasPaths holds the full-path values parallel to
// importAliasNames (same length, same order).
var importAliasPaths @[]@[]char

// resolveImportPkg maps an import alias to its full package path.
// Returns a copy of the input unchanged when it isn't a known
// import alias — covering same-package references, names that are
// already full paths, and the universe package.  This is the single
// point where the short source-level alias becomes the full path in
// the IR namespace.
func resolveImportPkg(alias *[]readonly char) @[]char {
	for i := 0; i < len(importAliasNames); i++ {
		if streq(importAliasNames[i], alias) {
			return importAliasPaths[i]
		}
	}
	return buf.CopyStr(alias)
}

// NewGenCtx creates a per-compilation gen context bound to module m,
// seeding PkgPath from m.PkgPath (empty when m is nil or its path isn't
// set yet — e.g. during import registration before GeneratePackage).
// Callers that resolve against a different package (RegisterSelfTypes)
// set gc.PkgPath explicitly after.
func NewGenCtx(m @Module) @GenCtx {
	var gc @GenCtx = make(GenCtx)
	gc.Mod = m
	if m != nil {
		gc.PkgPath = m.PkgPath
	}
	return gc
}

// Generic-instantiation substitution context.  When IR-gen is
// emitting the body of a specialized instantiation `f[T1, T2,
// ...]`, currentTypeParamNames lists the AST-level type-param
// names (`["T", "U"]`) and currentTypeParamTypes carries the
// concrete @types.Type the IR-gen layer should substitute for
// each.  resolveTypeExpr consults them: a TEXPR_NAMED whose name
// matches an entry returns the corresponding concrete @Type.
// Empty / nil outside any generic instantiation.  Per
// plan-generics.md Slice 4a.
var currentTypeParamNames @[]@[]char
// currentTypeParamTypes is the parallel concrete-@Type list for
// currentTypeParamNames (same length, same order); index i maps
// the source-text name to its substituted IR-layer type.
var currentTypeParamTypes @[]@types.Type

// emittedInstantiations records every monomorphized generic
// instantiation already emitted for the current module, keyed by
// mangled name.  Lookups happen at every generic-call site to
// dedupe — `id[int](5)` called from two places emits one IR func.
// Reset at the start of GeneratePackage / GenModule alongside the
// other per-module state.
var emittedInstantiations @[]@[]char

// genericDecls is the per-module registry of generic AST decls.
// Populated alongside Module.FuncSigs during signature registration
// (gen_module.bn) — once filled, IR-gen call sites can ask
// "does name N refer to a generic decl in this package?" without
// re-walking the file list.  Indexed in registration order.
var genericDecls @[]@ast.Decl

// genericDeclPkgs is a parallel array carrying each decl's
// defining package's short-name — current module's pkgShort for
// same-package decls, the import alias for imported decls
// (Slice 7 of plan-generics.md).  The pkg-aware lookup
// lookupGenericDeclPkg uses both to disambiguate.
var genericDeclPkgs @[]@[]char

// genericTypeDecls is the per-module registry of generic struct
// AST decls.  Populated during struct-type registration; used at
// TEXPR_INSTANTIATE resolution time so the IR layer can find
// the source AST and substitute fields per Slice 5c of
// plan-generics.md.
var genericTypeDecls @[]@ast.Decl

// genericTypeDeclPkgs is the parallel pkg-pairing for
// genericTypeDecls (Slice 7 of plan-generics.md).
var genericTypeDeclPkgs @[]@[]char

// genericIfaceDecls is the per-module registry of generic
// interface AST decls.  Populated by collectInterfaceFromDecl
// when a DECL_INTERFACE carries TypeParams; used by
// ensureInstantiatedInterface to materialize a per-(decl, args)
// ModuleInterface entry with the type-params substituted in
// method signatures.  Slice 6c of plan-generics.md.
var genericIfaceDecls @[]@ast.Decl

// genericIfaceDeclPkgs is the parallel pkg-pairing for
// genericIfaceDecls (Slice 7 of plan-generics.md).
var genericIfaceDeclPkgs @[]@[]char

// qualifyForCurrentModule returns the canonical fully-qualified form
// of a function name in the current module's context. Pass-through
// for already-dotted names (cross-package references, methods,
// qualified-dtor names like "ast.__dtor_File"). Bare names get
// "<gc.PkgPath>." prepended. Outside any module-gen context (gc.PkgPath
// empty), bare names are returned unchanged so legacy bare-name lookups
// still match.
//
// Used to normalize both sides of the IR-internal name namespace:
// Module.FuncSigs[i].Name (storage) and the input to lookupFunc*
// (consumption). Once both sides are normalized, the duplication that
// used to live in each backend (modulePkgName + bare-name dance) lives
// in IR alone.
func qualifyForCurrentModule(gc @GenCtx, name @[]char) @[]char {
	return qualifyForPkgPath(gc.PkgPath, name)
}

// qualifyForPkgPath is the package-path-parameterized core of
// qualifyForCurrentModule: it prepends `<pkgPath>.` to a bare name, and
// passes an already-dotted name (or an empty pkgPath) through unchanged.
// Sites that hold a concrete package path — the @Block emit methods
// (`b.Func.ModulePkgPath`) and the @Module init helpers (`m.PkgPath`) —
// call it directly instead of reading the ambient package-global, which
// is how the global's readers are being retired (plan-embeddable-vm.md
// inc 5).
func qualifyForPkgPath(pkgPath @[]char, name @[]char) @[]char {
	if len(pkgPath) == 0 { return name }
	return mangle.QualifyName(pkgPath, name)
}

// lookupTypeAlias searches Module.TypeAliases for a type alias by name.
// lookupStructIdx returns the index of a struct in Module.Structs, or -1
// if not found.  Own-module structs are registered under their fully-
// qualified name (pkg/path.Name), so a bare lookup key is qualified to
// the current module first — mirroring lookupFuncParams.  A key that is
// already qualified (an imported struct's dotted name) passes through
// unchanged (QualifyName is idempotent on a dotted name); an empty
// current module leaves the key bare.
func lookupStructIdx(gc @GenCtx, name *[]readonly char) int {
	var qname @[]char = qualifyForCurrentModule(gc, buf.CopyStr(name))
	for i := 0; i < len(gc.Mod.Structs); i++ {
		if streq(gc.Mod.Structs[i].Name, qname) {
			return i
		}
	}
	// Synthetic structs (anonymous / closure / multi-return tuples) are
	// registered UNQUALIFIED, so fall back to the bare name when the
	// qualifier changed it and the qualified form wasn't found.  Named
	// (user) structs are always registered qualified, so they never
	// reach this fallback — no false bare match.
	if !streq(qname, name) {
		for i := 0; i < len(gc.Mod.Structs); i++ {
			if streq(gc.Mod.Structs[i].Name, name) {
				return i
			}
		}
	}
	return -1
}

// lookupFieldIndex returns the field index within a struct, or -1 if not found.
func lookupFieldIndex(gc @GenCtx, si int, fieldName *[]readonly char) int {
	var styp @types.Type = gc.Mod.Structs[si].Typ
	if styp == nil || len(styp.Fields) == 0 { return -1 }
	for i := 0; i < len(styp.Fields); i++ {
		if streq(styp.Fields[i].Name, fieldName) {
			return i
		}
	}
	return -1
}

// lookupFieldType returns the type of a named struct field, defaulting to int.
func lookupFieldType(gc @GenCtx, si int, fieldName *[]readonly char) @types.Type {
	var styp @types.Type = gc.Mod.Structs[si].Typ
	if styp == nil || len(styp.Fields) == 0 { return types.TypInt() }
	for i := 0; i < len(styp.Fields); i++ {
		if streq(styp.Fields[i].Name, fieldName) {
			return styp.Fields[i].Type
		}
	}
	return types.TypInt()
}

// lookupFuncParams returns the parameter types for a function in gc.Mod.FuncSigs.
// Normalizes the input name so callers passing either bare or qualified
// forms find the same entry (storage is always qualified post-Step-4).
func lookupFuncParams(gc @GenCtx, name *[]readonly char) @[]@types.Type {
	var qname @[]char = qualifyForCurrentModule(gc, buf.CopyStr(name))
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, qname) {
			return gc.Mod.FuncSigs[i].Params
		}
	}
	var empty @[]@types.Type
	return empty
}

// lookupFuncResults returns the result types for a function in gc.Mod.FuncSigs.
func lookupFuncResults(gc @GenCtx, name *[]readonly char) @[]@types.Type {
	var qname @[]char = qualifyForCurrentModule(gc, buf.CopyStr(name))
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, qname) {
			return gc.Mod.FuncSigs[i].Results
		}
	}
	var empty @[]@types.Type
	return empty
}

// lookupFuncMultiReturnType returns the multi-return struct type for a function, or nil.
func lookupFuncMultiReturnType(gc @GenCtx, name *[]readonly char) @types.Type {
	var qname @[]char = qualifyForCurrentModule(gc, buf.CopyStr(name))
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, qname) {
			return gc.Mod.FuncSigs[i].MultiReturnType
		}
	}
	return nil
}

// setOrAppendFuncSig stores `sig` in gc.Mod.FuncSigs, replacing any
// existing entry with the same Name (in place) or appending a new
// one if no match.  Used by `GenDecl` so that re-typing a func at
// the REPL prompt updates the IR-side sig table (otherwise the
// FIRST-match `lookupFunc*` paths would still see the stale sig).
func setOrAppendFuncSig(gc @GenCtx, sig FuncSig) {
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, sig.Name) {
			gc.Mod.FuncSigs[i] = sig
			return
		}
	}
	gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)
}

// lookupFuncExists returns true if a function signature exists in gc.Mod.FuncSigs.
func lookupFuncExists(gc @GenCtx, name *[]readonly char) bool {
	var qname @[]char = qualifyForCurrentModule(gc, buf.CopyStr(name))
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, qname) {
			return true
		}
	}
	return false
}

// lookupConst searches gc.Mod.Consts for a constant by name, returning (value, type, found).
func lookupConst(gc @GenCtx, name *[]readonly char) (int, @types.Type, bool) {
	for i := 0; i < len(gc.Mod.Consts); i++ {
		if streq(gc.Mod.Consts[i].Name, name) {
			return gc.Mod.Consts[i].Val, gc.Mod.Consts[i].Typ, true
		}
	}
	return 0, nil, false
}

// lookupConstBool returns the boolean value of a registered CONST_BOOL by
// name (the second result is false if the name isn't a registered boolean
// const).  evalConstBool uses it to fold a bool-const reference inside
// another const's logical expression — e.g. `const C bool = !A`.
func lookupConstBool(gc @GenCtx, name *[]readonly char) (bool, bool) {
	for i := 0; i < len(gc.Mod.Consts); i++ {
		if streq(gc.Mod.Consts[i].Name, name) {
			if gc.Mod.Consts[i].Kind == CONST_BOOL {
				return gc.Mod.Consts[i].BoolVal, true
			}
			return false, false
		}
	}
	return false, false
}

// InitModule creates a new module and clears IR gen state.
// Call RegisterImport for each dependency before calling GeneratePackage.
