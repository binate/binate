package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Index and slice expressions
// ============================================================

// emitIndexBoundsCheck emits OP_BOUNDS_CHECK for `index` against the
// collection's runtime length (compile-time for arrays, EmitSliceLen for
// slices). Pointer indexing is skipped — pointers don't carry a length and
// are inherently unchecked. Other kinds (e.g., a non-collection collection
// reaching this helper) are also skipped to stay conservative.
func emitIndexBoundsCheck(ctx @GenContext, b @Block, collection @Instr, index @Instr) {
	if collection == nil || collection.Typ == nil { return }
	// Peel transparent wrappers FIRST, then classify off the peeled type: the
	// wrapper's own Kind is TYP_NAMED, so a named array (`type Row [3]int`)
	// would be mis-skipped and — worse — a named slice (`type Buf @[]int`)
	// index would go UNCHECKED (memory-unsafe) if classified off the raw
	// collection.Typ.  A (named or plain) pointer carries no length, so skip it.
	var collSt @types.Type = peelTransparent(collection.Typ)
	if collSt == nil || collSt.Kind == types.TYP_POINTER { return }
	var length @Instr = nil
	if collSt.Kind == types.TYP_ARRAY {
		length = b.EmitConstInt(collSt.ArrayLen, types.TypInt())
	} else if isSliceType(collSt) {
		length = b.EmitSliceLen(collection)
	} else {
		return
	}
	genBoundsCheck(ctx, b, index, length)
}

// genBoundsCheck emits an OP_BOUNDS_CHECK guard and, for the recoverable-fault
// VM, attaches its cleanup landing pad (plan-rt-fault-cleanup-pads.md) so a
// bounds fault unwinds without leaking; the compiled backends ignore the pad and
// stay fatal.  All EmitBoundsCheck sites go through here.  Param names idx/ln
// keep the internal emit from matching the call-site rewrites.
func genBoundsCheck(ctx @GenContext, b @Block, idx @Instr, ln @Instr) {
	b.EmitBoundsCheck(idx, ln)
	attachFaultPad(ctx, b)
}

// genIndex generates IR for an index expression (array, pointer, or slice
// element access). When `checked` is true, emits a runtime bounds check
// before the access. The unsafe_index builtin passes false to opt out.
func genIndex(ctx @GenContext, b @Block, e @ast.Expr, checked bool) @Instr {
	// e.X = the collection, e.Args[0] = the index.
	// Multi-arg `e.Args` is the instantiation shape — type checker
	// rejects it for now (Slice 2+ work); reaching genIndex with
	// len(Args) != 1 would mean a stale AST.

	// Nested-ARRAY base (`a[i][j]`): genExpr(e.X) would load the inner
	// array `a[i]` as an r-value with no backing pointer, and the
	// array/slice fallbacks below would then GEP/SliceGet a non-pointer
	// (invalid IR).  Load through an in-place element pointer instead.
	// Detected by TYPE so e.X (and its index) isn't generated twice.  A
	// nested SLICE base needs no special case — its loaded value carries
	// the backing pointer, so the standard path works.
	if len(e.Args) == 1 && isNestedArrayBase(ctx, e) {
		var elemPtr @Instr = genIndexPtr(ctx, b, e)
		b = ctx.CurBlock
		if elemPtr != nil && elemPtr.Typ != nil && elemPtr.Typ.Elem != nil {
			return b.EmitLoad(elemPtr, elemPtr.Typ.Elem)
		}
	}

	var collection @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	var index @Instr = genExpr(ctx, b, e.Args[0])
	b = ctx.CurBlock

	if checked {
		emitIndexBoundsCheck(ctx, b, collection, index)
	}

	// Peel transparent wrappers (readonly / named-distinct / alias) so a
	// named array (`var r Row` where `type Row [3]int`) — or a `readonly`
	// one — reaches the TYP_ARRAY arm and its element type / length come
	// from the underlying array, not the wrapper (whose `.Elem` is the
	// array itself).  Without this a TYP_NAMED-over-TYP_ARRAY falls through
	// to the slice path and emits invalid IR.
	var collSt @types.Type = nil
	if collection.Typ != nil { collSt = peelTransparent(collection.Typ) }

	// Determine element type
	var elemTyp @types.Type = types.TypInt()
	if collSt != nil && collSt.Elem != nil {
		elemTyp = collSt.Elem
	}

	if collSt != nil && collSt.Kind == types.TYP_ARRAY {
		// Array indexing: GEP into the alloca holding the array.
		// The simple case is a local: `arr[i]` where `arr` is an
		// EXPR_IDENT we can look up directly. The struct-field
		// case `t.name[i]` (where `name [N]T` is a field) needs
		// `genSelectorPtr` to get a pointer to the field; that's
		// the array-typed slot we GEP into.
		var arrPtr @Instr = nil
		if e.X.Kind == ast.EXPR_IDENT {
			arrPtr = lookupVar(ctx, e.X.Name)
		} else if e.X.Kind == ast.EXPR_SELECTOR {
			arrPtr = genSelectorPtr(ctx, b, e.X)
			b = ctx.CurBlock
		} else if e.X.Kind == ast.EXPR_UNARY && e.X.Op == cast(int, token.STAR) {
			// `(*p)[i]`: p is a pointer-to-array, so p itself IS the array's
			// backing address — GEP through it.  `collection` above loaded the
			// array as a VALUE (no backing storage), which the slice fallback
			// would then SliceGet as a non-pointer (invalid IR).
			arrPtr = genExpr(ctx, b, e.X.X)
			b = ctx.CurBlock
		}
		if arrPtr != nil {
			var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, index, elemTyp)
			return b.EmitLoad(elemPtr, elemTyp)
		}
		// No backing storage: an r-value array (a call result `getArr()[i]`, or
		// another computed array value).  Materialize the array VALUE into an
		// alloca and GEP the element — mirrors the struct-value-call-result
		// materialization in genSelector.  Without it the array value falls to the
		// slice path below and is mis-lowered as a {ptr,len} slice (`[N x T]` used
		// as `[N x i64]` — invalid IR).  The temp borrows the call result's refs,
		// which genExpr already registered for end-of-statement cleanup.
		var arrTmp @Instr = b.EmitAlloc(collection.Typ)
		b.EmitStore(arrTmp, collection)
		var rvElemPtr @Instr = b.EmitGetElemPtr(arrTmp, index, elemTyp)
		return b.EmitLoad(rvElemPtr, elemTyp)
	}

	if collSt != nil && collSt.Kind == types.TYP_POINTER {
		// Pointer indexing: GEP on raw pointer, then load.  collSt is peeled so
		// a named pointer reaches this arm instead of falling to the slice path.
		var elemPtr @Instr = b.EmitGetElemPtr(collection, index, elemTyp)
		return b.EmitLoad(elemPtr, elemTyp)
	}

	// Slice indexing: call runtime
	return b.EmitSliceGet(collection, index, elemTyp)
}

// genIndexPtr returns a pointer to an array element (for field access on indexed structs)
func genIndexPtr(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	if e.X == nil || len(e.Args) != 1 { return nil }
	var index @Instr = genExpr(ctx, b, e.Args[0])
	b = ctx.CurBlock

	if e.X.Kind == ast.EXPR_IDENT {
		var arrPtr @Instr = lookupVar(ctx, e.X.Name)
		var arrTyp @types.Type = lookupVarType(ctx, e.X.Name)
		if arrPtr != nil && arrTyp != nil {
			// Peel transparent wrappers so a named array (`type Row [3]int`)
			// — or a readonly one — is recognized; element type / length come
			// from the underlying array.  arrPtr (the variable's alloca) is
			// the array's backing regardless of the wrapper, so GEP through it.
			var arrUnd @types.Type = peelTransparent(arrTyp)
			if arrUnd != nil && arrUnd.Kind == types.TYP_ARRAY {
				var elemTyp @types.Type = arrUnd.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var lenInstr @Instr = b.EmitConstInt(arrUnd.ArrayLen, types.TypInt())
				genBoundsCheck(ctx, b, index, lenInstr)
				return b.EmitGetElemPtr(arrPtr, index, elemTyp)
			}
			// Pointer indexing: load pointer value, GEP on it.  Use arrUnd (the
			// peeled type from the array check above) so a named-distinct pointer
			// (`type P *int`) reaches this arm; un-peeled its Kind is TYP_NAMED, so
			// it would fall through the slice/array arms (which miss it too),
			// genIndexPtr returns nil, and genLValueAddr hands back the loaded
			// element VALUE as its address — a wild pointer (SIGSEGV on write).
			if arrUnd != nil && arrUnd.Kind == types.TYP_POINTER {
				var ptrVal @Instr = b.EmitLoad(arrPtr, arrUnd)
				var elemTyp @types.Type = arrUnd.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				return b.EmitGetElemPtr(ptrVal, index, elemTyp)
			}
			// Slice element: GEP a typed pointer to the element in-place,
			// for ANY element type (scalar or struct).  Gating this on a
			// struct element type makes &s[i] on a scalar-element slice
			// fall through to nil; genUnary then re-lowers s[i] as an
			// r-value and hands back the loaded element as if it were a
			// pointer — a wild pointer that SIGSEGVs on write-through.
			// Peel transparent wrappers (named-distinct / alias / readonly) so a
			// named slice (`type RBuf *[]int`) — which the checker accepts here
			// via peelNamedBounded in checkIndexExpr — is recognized; its backing
			// is a plain slice regardless of the wrapper, so load + GEP through it.
			// Un-peeled, isSliceType(named) is false and this arm falls through to
			// the same wild-pointer SIGSEGV.
			var arrSt @types.Type = peelTransparent(arrTyp)
			if isSliceType(arrSt) && arrSt != nil && arrSt.Elem != nil {
				var sliceVal @Instr = b.EmitLoad(arrPtr, arrSt)
				var lenInstr @Instr = b.EmitSliceLen(sliceVal)
				genBoundsCheck(ctx, b, index, lenInstr)
				return b.EmitSliceElemPtr(sliceVal, index, arrSt.Elem)
			}
		}
	}
	// Selector base: e.g., c.Items[i] where c.Items is a selector
	if e.X.Kind == ast.EXPR_SELECTOR {
		var collTyp @types.Type = getSelectorType(ctx, e.X)
		// Peel transparent wrappers so a named-array field (`type Row [3]int`)
		// — or a readonly one — is recognized; the field pointer (arrPtr) is
		// the array's backing regardless of the wrapper.
		var collArr @types.Type = peelTransparent(collTyp)
		if collArr != nil && collArr.Kind == types.TYP_ARRAY {
			// Array field: get pointer to the array field, then GEP for element
			var arrPtr @Instr = genSelectorPtr(ctx, b, e.X)
			b = ctx.CurBlock
			if arrPtr != nil {
				var elemTyp @types.Type = collArr.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var lenInstr @Instr = b.EmitConstInt(collArr.ArrayLen, types.TypInt())
				genBoundsCheck(ctx, b, index, lenInstr)
				return b.EmitGetElemPtr(arrPtr, index, elemTyp)
			}
		}
		// Slice-field element: same as the IDENT slice arm, for ANY
		// element type — see the wild-pointer note there.  Peel transparent
		// wrappers (named-distinct / alias / readonly) so the element type
		// (and stride) comes from the underlying slice, and so a named slice
		// FIELD (`type RBuf *[]int`) is recognized rather than falling through.
		var collSt @types.Type = peelTransparent(collTyp)
		if collSt != nil && isSliceType(collSt) && collSt.Elem != nil {
			var sliceVal @Instr = genExpr(ctx, b, e.X)
			b = ctx.CurBlock
			var lenInstr @Instr = b.EmitSliceLen(sliceVal)
			genBoundsCheck(ctx, b, index, lenInstr)
			return b.EmitSliceElemPtr(sliceVal, index, collSt.Elem)
		}
	}
	// Deref-of-pointer-to-array base, e.g. `(*p)[i]` (and the inner `(*p)[i]`
	// of a nested `(*p)[i][j]`): p IS the array's backing address, so GEP
	// through the pointer value.  Without this the r-value fallback below loads
	// the array as a value (no backing) and returns nil → invalid IR / dropped
	// store.
	if e.X.Kind == ast.EXPR_UNARY && e.X.Op == cast(int, token.STAR) {
		var ptrVal @Instr = genExpr(ctx, b, e.X.X)
		b = ctx.CurBlock
		if ptrVal != nil && ptrVal.Typ != nil && ptrVal.Typ.Kind == types.TYP_POINTER &&
				ptrVal.Typ.Elem != nil {
			// peelTransparent (not just readonly) so `*Row` where
			// `type Row [3]int` recognizes the pointee as an array.
			var arrSt @types.Type = peelTransparent(ptrVal.Typ.Elem)
			if arrSt != nil && arrSt.Kind == types.TYP_ARRAY {
				var elemTyp @types.Type = arrSt.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var lenInstr @Instr = b.EmitConstInt(arrSt.ArrayLen, types.TypInt())
				genBoundsCheck(ctx, b, index, lenInstr)
				return b.EmitGetElemPtr(ptrVal, index, elemTyp)
			}
		}
		return nil
	}
	// Nested-index base, e.g. `a[i][j]`: recurse for an in-place pointer
	// to the inner element `a[i]`, then index THAT.  Without this the
	// outer `&...` falls through and genUnary hands back the loaded inner
	// r-value as a pointer — a wild pointer (SIGSEGV) or invalid IR.  An
	// array inner element is stored in place, so GEP its pointer directly;
	// a slice / raw-pointer inner element is a value carrying its own
	// backing, so load it first and index through the value.
	if e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var basePtr @Instr = genIndexPtr(ctx, b, e.X)
		b = ctx.CurBlock
		if basePtr == nil || basePtr.Typ == nil || basePtr.Typ.Kind != types.TYP_POINTER ||
				basePtr.Typ.Elem == nil {
			return nil
		}
		// peelTransparent (not just readonly) so a nested named-array inner
		// element (`type Row [3]int` as the element of an outer array) is
		// recognized as an array and GEP'd in place.
		var innerSt @types.Type = peelTransparent(basePtr.Typ.Elem)
		if innerSt == nil { return nil }
		if innerSt.Kind == types.TYP_ARRAY {
			var elemTyp @types.Type = innerSt.Elem
			if elemTyp == nil { elemTyp = types.TypInt() }
			var lenInstr @Instr = b.EmitConstInt(innerSt.ArrayLen, types.TypInt())
			genBoundsCheck(ctx, b, index, lenInstr)
			return b.EmitGetElemPtr(basePtr, index, elemTyp)
		}
		if isSliceType(innerSt) && innerSt.Elem != nil {
			var sliceVal @Instr = b.EmitLoad(basePtr, innerSt)
			var lenInstr @Instr = b.EmitSliceLen(sliceVal)
			genBoundsCheck(ctx, b, index, lenInstr)
			return b.EmitSliceElemPtr(sliceVal, index, innerSt.Elem)
		}
		if innerSt.Kind == types.TYP_POINTER && innerSt.Elem != nil {
			var ptrVal @Instr = b.EmitLoad(basePtr, innerSt)
			return b.EmitGetElemPtr(ptrVal, index, innerSt.Elem)
		}
		return nil
	}
	// R-value base that carries its own backing, e.g. `&get()[i]` where
	// get() returns a slice (or raw pointer): evaluate it and GEP into the
	// backing.  IDENT / SELECTOR bases are handled above; this is for the
	// remaining kinds (call results, etc.).  The caller borrows the
	// backing — for a managed-slice temp the standard end-of-statement
	// cleanup keeps refcounting honest (the backing must stay live via
	// another owner, else it is a user use-after-free, not a compiler
	// bug).  An r-value array has no stable address, so it returns nil.
	if e.X.Kind != ast.EXPR_IDENT && e.X.Kind != ast.EXPR_SELECTOR {
		var baseVal @Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		if baseVal != nil && baseVal.Typ != nil {
			// Peel transparent wrappers (named-distinct / alias / readonly) so a
			// named slice returned by a call (`type RBuf *[]int`) is recognized;
			// EmitSliceLen/EmitSliceElemPtr read the value's fields, so the peeled
			// element type just supplies the GEP stride.
			var baseSt @types.Type = peelTransparent(baseVal.Typ)
			if baseSt != nil && isSliceType(baseSt) && baseSt.Elem != nil {
				var lenInstr @Instr = b.EmitSliceLen(baseVal)
				genBoundsCheck(ctx, b, index, lenInstr)
				return b.EmitSliceElemPtr(baseVal, index, baseSt.Elem)
			}
			// baseSt is peeled, so a named-distinct pointer returned by a call
			// (`type P *int`) reaches this arm rather than falling through
			// (genIndexPtr → nil, then the loaded pointer VALUE is used as the
			// element address — a wild pointer).
			if baseSt != nil && baseSt.Kind == types.TYP_POINTER && baseSt.Elem != nil {
				return b.EmitGetElemPtr(baseVal, index, baseSt.Elem)
			}
			// R-value ARRAY (a call result `getArr()[i]`): no backing storage, so
			// materialize the array VALUE into an alloca and GEP the element.  This
			// returns the element pointer a nested / field read `getArr()[i].f` /
			// `getArr()[i].a.b` needs (genSelector / genSelectorPtr ask genIndexPtr
			// for it), evaluating the base call exactly ONCE — without it those
			// paths re-`genExpr` the base (a double side-effecting call) or hit the
			// unresolved-selector panic.  READ-only: the checker rejects a write /
			// `*T`-method through a non-addressable r-value-array element (see
			// isAddressable), so this is never an assignment lvalue where the store
			// would land in the discarded copy.  The temp borrows the call result's
			// genExpr-registered refs.
			var baseArr @types.Type = peelTransparent(baseVal.Typ)
			if baseArr != nil && baseArr.Kind == types.TYP_ARRAY {
				var aElem @types.Type = baseArr.Elem
				if aElem == nil { aElem = types.TypInt() }
				var lenI @Instr = b.EmitConstInt(baseArr.ArrayLen, types.TypInt())
				genBoundsCheck(ctx, b, index, lenI)
				var aTmp @Instr = b.EmitAlloc(baseVal.Typ)
				b.EmitStore(aTmp, baseVal)
				return b.EmitGetElemPtr(aTmp, index, aElem)
			}
		}
	}
	return nil
}
