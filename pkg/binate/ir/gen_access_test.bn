// `unsafe_index(s, i)` is the documented opt-out and must NOT emit
// OP_BOUNDS_CHECK. Same lowering as s[i] except for the check.
func TestUnsafeIndexSkipsBoundsCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() int {\n"
					"\tvar s *[]int = make_slice(int, 3)\n"
					"\treturn unsafe_index(s, 1)\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("unsafe_index must not emit iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

// Pointer indexing (`p[i]` for `var p *T`) has no length and is inherently
// unchecked. Must NOT emit OP_BOUNDS_CHECK.
func TestPointerIndexSkipsBoundsCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo(p *int) int {\n"
					"\treturn p[2]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("pointer index must not emit iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[lo:hi]` with both endpoints explicit emits two OP_BOUNDS_CHECK ops:
// one for `hi ≤ len` and one for `lo ≤ hi`.
func TestGenSliceExprEmitsBoundsChecks() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() *[]int {\n"
					"\tvar s *[]int = make_slice(int, 5)\n"
					"\treturn s[1:3]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) != 2 {
		return fail("s[lo:hi] should emit 2 iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[:hi]` with implicit lo (==0) skips the lo check.
func TestGenSliceExprImplicitLoSkipsLoCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() *[]int {\n"
					"\tvar s *[]int = make_slice(int, 5)\n"
					"\treturn s[:3]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Only the hi-vs-len check runs when lo is implicit.
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("s[:hi] should emit exactly 1 iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[lo:]` with implicit hi (==len) skips the hi check.
func TestGenSliceExprImplicitHiSkipsHiCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() *[]int {\n"
					"\tvar s *[]int = make_slice(int, 5)\n"
					"\treturn s[2:]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Only the lo-vs-hi check runs when hi is implicit.
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("s[lo:] should emit exactly 1 iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

