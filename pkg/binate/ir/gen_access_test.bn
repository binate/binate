func TestGenIndexPtrSliceOfStructs() testing.TestResult {
	// sliceOfStructs[i].field = value should produce
	// extract + GEP
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct {\n\tX int\n\tY int\n}\n"
					"func foo() {\n"
					"\tvar pts *[]Point = make_slice(Point, 1)\n"
					"\tpts[0] = Point{1, 2}\n"
					"\tpts[0].X = 99\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var foundGEP bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_GET_ELEM_PTR {
				foundGEP = true
			}
		}
	}
	if !foundGEP { return fail("slice-of-structs index assign should emit GEP") }
	return ""
}

// ============================================================
// Phase 3 rodata composite-literal fast path
// ============================================================

// genManagedSliceLit with all-const-byte elements + const-uint8 element
// type emits OP_RODATA_MSLICE directly (no MakeSlice + N stores).
func TestGenManagedSliceLitConstBytesEmitsRodataMSlice() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() @[]readonly char {\n"
					"\treturn @[]readonly char{'a', 'b', 'c'}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 1 {
		return fail("expected exactly 1 iropcode.OP_RODATA_MSLICE")
	}
	if countOp(m.Funcs[0], iropcode.OP_MAKE_SLICE) != 0 {
		return fail("iropcode.OP_MAKE_SLICE should NOT fire on the fast path")
	}
	return ""
}

// Same idea for raw-slice composite literals.
func TestGenRawSliceLitConstBytesEmitsRodataSlice() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() *[]readonly char {\n"
					"\treturn *[]readonly char{'X', 'Y'}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_SLICE) != 1 {
		return fail("expected exactly 1 iropcode.OP_RODATA_SLICE")
	}
	if countOp(m.Funcs[0], iropcode.OP_MAKE_SLICE) != 0 {
		return fail("iropcode.OP_MAKE_SLICE should NOT fire on the fast path")
	}
	return ""
}

// Mixed char + small-int literals also qualify (values 0..255, uint8 elem).
func TestGenManagedSliceLitMixedByteLiteralsTakesFastPath() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() @[]readonly char {\n"
					"\treturn @[]readonly char{72, 'i', 33}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 1 {
		return fail("expected iropcode.OP_RODATA_MSLICE for mixed byte literals")
	}
	return ""
}

// Negative: non-byte element type (e.g. @[]readonly int) does NOT take the
// fast path. Falls through to MakeSlice + N stores.
func TestGenManagedSliceLitNonByteElemNoFastPath() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() @[]readonly int {\n"
					"\treturn @[]readonly int{1, 2, 3}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 0 {
		return fail("@[]readonly int should NOT take the fast path")
	}
	if countOp(m.Funcs[0], iropcode.OP_MAKE_SLICE) < 1 {
		return fail("expected iropcode.OP_MAKE_SLICE for the slow path")
	}
	return ""
}

// Negative: non-const elem type (`@[]char`, mutable) bypasses the fast
// path even with all-byte literals — aliasing rodata would let writes
// hit read-only memory.
func TestGenManagedSliceLitMutableNoFastPath() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() @[]char {\n"
					"\treturn @[]char{'a', 'b', 'c'}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 0 {
		return fail("mutable @[]char should NOT take the fast path")
	}
	if countOp(m.Funcs[0], iropcode.OP_MAKE_SLICE) < 1 {
		return fail("expected iropcode.OP_MAKE_SLICE for mutable composite")
	}
	return ""
}

// Negative: runtime element (`y` is a parameter) blocks the fast path.
func TestGenManagedSliceLitRuntimeElemNoFastPath() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo(y char) @[]readonly char {\n"
					"\treturn @[]readonly char{'a', y, 'c'}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 0 {
		return fail("runtime-elem composite should NOT take fast path")
	}
	return ""
}

// ============================================================
// Phase 3.2 EmitStringToChars dispatch
// ============================================================

// `var s @[]readonly char = "hello"` lowers to OP_RODATA_MSLICE
// (zero-copy alias of the static %BnManagedSlice global).
func TestStringToManagedConstSliceEmitsRodataMSlice() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc foo() @[]readonly char {\n\treturn \"hello\"\n"
			"}\n"
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE) != 1 {
		return fail("expected iropcode.OP_RODATA_MSLICE for string→@[]readonly char")
	}
	return ""
}

// genArrayLit must convert string-literal elements to managed-slice
// values when the array's element type is char-slice — same as the
// var-decl / assignment paths.  Without this, the per-element store
// only writes the bare data pointer (8 bytes) into the 32-byte
// managed-slice slot and the slot's len reads back as 0.  Repro:
// conformance/365_array_managed_elem_lit.bn.
func TestArrayLitManagedElemEmitsRodataMSliceCopy() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() {\n"
					"\tvar arr [3]@[]char = [3]@[]char{\"a\", \"b\", \"c\"}\n"
					"\t_ = arr\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Each string element triggers EmitStringToChars → for @[]char
	// (mutable element backing), that's OP_RODATA_MSLICE_COPY.
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE_COPY) != 3 {
		return fail("expected 3 iropcode.OP_RODATA_MSLICE_COPY (one per element)")
	}
	return ""
}

// Same conversion is needed for indexed-assign into an array slot
// of char-slice element type.  Without it, the refcount path's
// extractvalue runs on a bare i8* (LLVM IR error) and the store
// writes only the pointer half of the slot.  Repro:
// conformance/366_array_managed_elem_assign.bn.
func TestArrayIndexAssignManagedElemEmitsRodataMSliceCopy() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() {\n"
					"\tvar arr [3]@[]char\n"
					"\tarr[0] = \"hi\"\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE_COPY) != 1 {
		return fail("expected 1 iropcode.OP_RODATA_MSLICE_COPY for arr[0] = string-literal")
	}
	return ""
}

// genManagedSliceLit must apply the same string→char-slice
// conversion that the array / var-decl / assignment / struct-init
// paths apply.  Pre-fix: `@[]@[]char{"a","b","c"}` stored only the
// 8-byte data pointer of each string literal into the 32-byte
// managed-slice element slots and the elements read back as len=0.
// Repro: conformance/374_mslice_mslice_char_lit.bn.
func TestManagedSliceLitCharElemEmitsRodataMSliceCopy() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() {\n"
					"\tvar args @[]@[]char = @[]@[]char{\"a\", \"b\", \"c\"}\n"
					"\t_ = args\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// One OP_RODATA_MSLICE_COPY per string-literal element.
	if countOp(m.Funcs[0], iropcode.OP_RODATA_MSLICE_COPY) != 3 {
		return fail("expected 3 iropcode.OP_RODATA_MSLICE_COPY (one per element)")
	}
	return ""
}

// Fresh element (make_slice = OP_MAKE_SLICE = isFreshManagedSlice)
// inside `@[]@[]char{...}` must be `consumeTemp`'d — its refcount
// transfers to the slice slot, not RefDec'd at end of statement.
// Pre-fix: the temp cleanup RefDec'd each call/make_slice result,
// dropping the header to 0 and freeing the data while the slot
// still pointed at it.  Post-fix: foo's body has 0 OP_REFDEC (the
// per-element dtor work runs from the args dtor at scope exit,
// emitted as a separate function); only the args-header RefInc
// shows up in the body itself.  Repro:
// conformance/474_mslice_mslice_char_lit_call_elem.bn.
func TestManagedSliceLitFreshElemConsumesTemp() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() {\n"
					"\tvar args @[]@[]char = @[]@[]char{\n"
					"\t\tmake_slice(char, 1), make_slice(char, 1)}\n"
					"\t_ = args\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_REFDEC) != 0 {
		return fail(
				"expected 0 iropcode.OP_REFDEC in foo (element temps consumed, "
						"args's RefDec goes via the args-dtor call at scope "
						"exit, not iropcode.OP_REFDEC); any other count means the "
						"element temps weren't consumed")
	}
	return ""
}

// Non-fresh element — loaded from a local variable — must RefInc
// (slot takes its own reference) instead of consume.  Pre-fix:
// no per-element RefInc; the local's eventual scope-exit RefDec
// would zero the shared header.  Post-fix: 3 OP_REFINC in foo —
// (1) `var s`'s axiom-3 RefInc, (2) the per-element RefInc from
// `emitManagedSliceRefInc(val)` in genManagedSliceLit's non-fresh
// branch, (3) `var args`'s axiom-3 RefInc on the result.
func TestManagedSliceLitNonFreshElemRefIncs() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() {\n"
					"\tvar s @[]char = make_slice(char, 1)\n"
					"\tvar args @[]@[]char = @[]@[]char{s}\n"
					"\t_ = args\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Exactly one RefInc: the non-fresh mslice-lit element `s` (a borrowed
	// var load) is RefInc'd so `args` co-owns its backing.  The two var-decl
	// initializers — `make_slice(...)` and the slice literal itself — are
	// FRESH producers, so emitStoreManagedSlot MOVES them into their slots
	// (consumeTemp, no RefInc) rather than copy-then-clean.  Fewer than one
	// would mean the non-fresh element path failed to RefInc.
	if countOp(m.Funcs[0], iropcode.OP_REFINC) != 1 {
		return fail(
				"expected exactly 1 iropcode.OP_REFINC in foo (the non-fresh mslice-lit "
						"element); fresh var-decl initializers are moved, not RefInc'd")
	}
	return ""
}
