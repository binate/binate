package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// --- Bounds check emission ---
// (countOp helper lives in ir_test.bn)

// `s[i]` on a slice should emit OP_BOUNDS_CHECK before the load.
func TestGenIndexSliceEmitsBoundsCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() int {\n"
					"\tvar s *[]int = make_slice(int, 3)\n"
					"\treturn s[1]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) < 1 {
		return fail("s[i] should emit iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

// `arr[i]` on a fixed-size array should emit OP_BOUNDS_CHECK against the
// compile-time length.
func TestGenIndexArrayEmitsBoundsCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"func foo() int {\n"
					"\tvar a [4]int\n"
					"\treturn a[2]\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], iropcode.OP_BOUNDS_CHECK) < 1 {
		return fail("arr[i] should emit iropcode.OP_BOUNDS_CHECK")
	}
	return ""
}

