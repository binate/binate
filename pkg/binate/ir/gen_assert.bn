package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Expression-form concrete type-assertion lowering (`x.(*T)` / `x.(@T)`, spec
// §11.12 `iface.assert`).  The interface value's vtable-slot-1 `*TypeInfo` is
// compared against the static `&__typeinfo.<T>`: a HIT recovers the boxed data
// pointer per the recovery kind, a MISS aborts via `rt.AssertFail` (the
// expression form has no comma-ok escape).  Concrete pointer / slice targets and
// value-recovery (`x.(int)` scalars and `x.(S)` value structs / arrays — a borrow
// load through the box's data pointer) go through here; an interface target routes
// to a runtime satisfaction lookup (genInterfaceAssert).

// genTypeAssert lowers an EXPR_TYPE_ASSERT.  Returns the recovered value (typed
// `*T` or `@T`), leaving IR-gen positioned in the HIT continuation block (the
// MISS paths abort, so there is no merge / phi).
func genTypeAssert(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var recoveredTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
	// An interface target `x.(*J)` recovers an interface value via a runtime
	// satisfaction lookup, not a static `*TypeInfo` compare (gen_assert_iface).
	if isInterfaceValueRecovery(recoveredTyp) {
		return genInterfaceAssert(ctx, b, e, recoveredTyp)
	}
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())

	var iv @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	var f @Func = ctx.Func

	// The vtable word (interface value index 1).  A null vtable is the `unset`
	// state (spec iface.assert.absent — test the vtable word FIRST): no dynamic
	// type, a guaranteed miss.
	var vtable @Instr = b.EmitExtract(iv, types.IfaceValueVtableIndex(), rawPtr)
	var vtNull @Instr = b.EmitBinop(iropcode.OP_EQ, vtable, b.EmitConstNil(rawPtr), types.TypBool())
	var unsetBlk @Block = AddBlock(f, "assert.unset")
	var checkBlk @Block = AddBlock(f, "assert.checktype")
	b.EmitBranch(vtNull, unsetBlk, checkBlk)

	// The asserted type's `__typeinfo.<T>` symbol (typeInfoSymFor) and the
	// panic message's qualified `<T>`.
	var tiSym @[]char = typeInfoSymFor(ctx, recoveredTyp)
	var targetName @[]char = assertBaseType(recoveredTyp).QualifiedTypeName()

	// checkBlk: read the dynamic `*TypeInfo` (vtable slot 1) and compare it
	// against `&__typeinfo.<T>` — a nominal identity compare (§11.12: exact type).
	var slot1 @Instr = checkBlk.EmitIfaceTypeInfo(iv)
	var want @Instr = checkBlk.EmitDataSymAddr(tiSym, types.TypUint8())
	var wrong @Instr = checkBlk.EmitBinop(iropcode.OP_NE, slot1, want, types.TypBool())
	var wrongBlk @Block = AddBlock(f, "assert.wrong")
	var hitBlk @Block = AddBlock(f, "assert.hit")
	checkBlk.EmitBranch(wrong, wrongBlk, hitBlk)

	// unsetBlk: no dynamic type → the panic's `<dyn>` is the literal "<unset>".
	emitAssertFail(ctx, unsetBlk, assertNameConst(ctx, unsetBlk, "<unset>"), targetName)
	unsetBlk.EmitUnreachable()

	// wrongBlk: read the dynamic type's own name from its TypeInfo record.
	emitAssertFail(ctx, wrongBlk, readTypeInfoName(ctx, wrongBlk, slot1), targetName)
	wrongBlk.EmitUnreachable()

	// hitBlk: recover the boxed pointer and continue here.
	ctx.CurBlock = hitBlk
	return recoverPointer(ctx, hitBlk, iv, recoveredTyp)
}

// typeInfoSymFor derives the asserted type's `__typeinfo.<T>` symbol EXACTLY as
// the boxing side does, so the compared `&__typeinfo.<T>` matches the vtable
// slot-1 pointer a box carries:
//   - NAMED target: gen_iface.wrapAsIfaceValue's receiverBaseTypeName →
//     splitQualName path, same-package names defaulting to the module path.
//   - SLICE target (`*[]T` / `@[]T`, §11.12 `iface.assert.slice`): the box's
//     name-less structural identity (namelessAnySrcName → the reserved
//     `pkg/builtins/rt.__nameless_<lp>`).  Both sides run the SAME
//     mangleTypeArg on structurally-identical, element-`readonly`-preserving
//     slice Types, so the symbols are byte-identical — the single correctness
//     crux of the slice HIT.
//
// It ALSO EMITS that `__typeinfo.<T>` record in this module (ensureAnyImplInfo),
// so a `case T:` / `x.(T)` whose T is never boxed ANYWHERE in the program still
// links: the `&__typeinfo.<T>` compare needs the symbol to exist even though,
// with no box of T, it can never match.  The record is weak, so it coalesces with
// any box site's identical one (ensureAnyImplInfo uses the same (recvPkg, recvName,
// recvTyp) the box side derives).  Before this, the match site only REFERENCED the
// symbol — fine when the same program also boxed T, but an undefined-symbol link
// error otherwise (which fmt hits: it matches char-slice / scalar spellings a
// caller may never box).
func typeInfoSymFor(ctx @GenContext, recoveredTyp @types.Type) @[]char {
	var recvPkg @[]char
	var recvName @[]char
	if recoveredTyp != nil &&
			(recoveredTyp.Kind == types.TYP_SLICE || recoveredTyp.Kind == types.TYP_MANAGED_SLICE) {
		// namelessAnySrcName is always `pkg/builtins/rt.`-qualified, so no
		// module-path default.
		recvPkg, recvName = splitQualName(namelessAnySrcName(recoveredTyp))
		if ctx.Gc.Mod != nil {
			ensureAnyImplInfo(ctx.Gc.Mod, recvPkg, recvName, recoveredTyp)
		}
		return mangle.TypeInfoName(recvPkg, recvName)
	}
	recvPkg, recvName = splitQualName(receiverBaseTypeName(recoveredTyp))
	if len(recvPkg) == 0 {
		recvPkg = ctx.Gc.PkgPath
	}
	if ctx.Gc.Mod != nil {
		ensureAnyImplInfo(ctx.Gc.Mod, recvPkg, recvName, assertBaseType(recoveredTyp))
	}
	return mangle.TypeInfoName(recvPkg, recvName)
}

// assertBaseType peels the recovery kind (`*`/`@`) and any element `readonly`
// off the recovered type to reach the asserted named base T.
func assertBaseType(t @types.Type) @types.Type {
	var b @types.Type = t
	if b.Kind == types.TYP_POINTER || b.Kind == types.TYP_MANAGED_PTR {
		b = b.Elem
	}
	if b != nil && b.Kind == types.TYP_READONLY {
		b = b.Elem
	}
	return b
}

// readTypeInfoName reads the dynamic type's name out of its TypeInfo record
// (`ti`, a raw `*uint8`): word 3 is the name pointer, word 4 the byte length
// (irdata.BuildTypeInfo layout).  Builds a `*[]readonly char` slice from them.
func readTypeInfoName(ctx @GenContext, b @Block, ti @Instr) @Instr {
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var namePtr @Instr = b.EmitLoad(
			b.EmitGetElemPtr(ti, b.EmitConstInt(3, types.TypInt()), rawPtr), rawPtr)
	var nameLen @Instr = b.EmitLoad(
			b.EmitGetElemPtr(ti, b.EmitConstInt(4, types.TypInt()), types.TypInt()), types.TypInt())
	var charSlice @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	return emitMakeRawSlice(ctx, b, charSlice, namePtr, nameLen)
}

// assertNameConst materializes a compile-time name string as a `*[]readonly char`
// slice value (the panic message's `<dyn>` for the unset case, or a `<T>`).
func assertNameConst(ctx @GenContext, b @Block, name @[]char) @Instr {
	var charSlice @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	return coerceArg(ctx, b, b.EmitConstString(name), charSlice)
}

// emitAssertFail emits `rt.AssertFail(dyn, "<targetName>")` — the failed-assertion
// panic.  `dyn` is an already-built `*[]readonly char` slice; the target name is
// a compile-time string.  Caller adds the trailing unreachable.
func emitAssertFail(ctx @GenContext, b @Block, dyn @Instr, targetName @[]char) {
	var target @Instr = assertNameConst(ctx, b, targetName)
	b.EmitCall("pkg/builtins/rt.AssertFail", makeArgs2(dyn, target), types.TypVoid())
}

// emitRecoveredValue extracts the boxed value from interface value `iv` as the
// asserted target type.  The box's data slot holds the payload's ADDRESS for
// every recovery kind EXCEPT a pointer target: for a POINTER target (`*T`/`@T`)
// the data slot IS that pointer, extracted verbatim.  For a SLICE target it holds
// `&s` (a pointer to the slice header — a name-less slice is boxed by its
// address), and for a VALUE-RECOVERY target (`x.(int)`, a scalar) it holds a
// pointer to the boxed value — so both LOAD the value through it (one extra
// indirection).  No refcount here — the caller decides ownership (a HIT-block
// borrow vs an owned expression temp); a scalar has none regardless.
func emitRecoveredValue(b @Block, iv @Instr, recoveredTyp @types.Type) @Instr {
	if recoveredTyp != nil && recoveredTyp.Kind != types.TYP_POINTER &&
			recoveredTyp.Kind != types.TYP_MANAGED_PTR {
		var dataPtr @Instr = b.EmitExtract(iv, types.IfaceValueDataIndex(),
				types.MakePointerType(recoveredTyp))
		return b.EmitLoad(dataPtr, recoveredTyp)
	}
	return b.EmitExtract(iv, types.IfaceValueDataIndex(), recoveredTyp)
}

// recoverPointer recovers the boxed value as the asserted target type for the
// EXPRESSION form (`x.(T)`), owning any managed reference (released at
// end-of-statement).
//   - `*T` / `*[]T`: a raw borrow — verbatim / loaded, no refcount, no temp.
//   - scalar `T` (int/bool/float): the loaded value — a plain copy, no refcount.
//   - `@T`: a retained reference — RefInc + register (`@`-hit = +1 then released).
//   - `@[]T`: the loaded slice value owns +1 on the (still-live) backing —
//     emitManagedSliceRefInc + register, mirroring `@T` (the box is a raw-`*any`
//     borrow that shares no reference, so recovery acquires a NEW one).
func recoverPointer(ctx @GenContext, b @Block, iv @Instr, recoveredTyp @types.Type) @Instr {
	var val @Instr = emitRecoveredValue(b, iv, recoveredTyp)
	if recoveredTyp.Kind == types.TYP_MANAGED_PTR {
		b.EmitRefInc(val)
		registerTemp(ctx, val)
	} else if recoveredTyp.Kind == types.TYP_MANAGED_SLICE {
		emitManagedSliceRefInc(ctx.Func, b, val)
		registerTemp(ctx, val)
	}
	return val
}
