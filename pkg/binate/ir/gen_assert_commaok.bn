package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// Comma-ok concrete type-assertion lowering (`v, ok := x.(*T)` / `x.(@T)`, spec
// §11.12 `iface.assert` in the two-result form).  Unlike the expression form
// (gen_assert.genTypeAssert, which panics on a miss), this yields a two-field
// {recovered, ok} value: a HIT gives {boxed pointer, true}; any MISS — an unset
// (null) vtable or a wrong dynamic type — gives {nil, false}.
//
// The recovered pointer is a BORROW (no RefInc): the destructure site
// (genShortVar / genMultiAssign) copy-RefInc's the extracted component for its
// target (Axiom 3), balanced by that target's scope-exit release.  Registering
// an owned temp here instead would be WRONG — the hit block's recovered value
// is undefined on the miss path, so an unconditional end-of-statement RefDec of
// it would release a garbage pointer.  So: no RefInc, no temp registration; the
// {recovered, ok} struct is a plain value the destructure consumes.
//
// The struct is materialized with the standard alloca-merge idiom (EmitAlloc +
// per-branch EmitGetFieldPtr/store + EmitLoad at the merge) rather than a struct
// literal: OP_STRUCT_LIT is not lowered by the LLVM/native backends.

// genTypeAssertCommaOk lowers a comma-ok EXPR_TYPE_ASSERT to a {recovered, ok}
// struct value (field 0 = recovered `*T`/`@T`, field 1 = bool), leaving IR-gen
// positioned in the merge block.  The result is shaped for genShortVar /
// genMultiAssign's TYP_STRUCT destructure (multiReturnFieldTypes + EmitExtract).
func genTypeAssertCommaOk(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var recoveredTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var structTyp @types.Type = commaOkAssertStructType(recoveredTyp)

	var iv @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	var f @Func = ctx.Func
	var slot @Instr = b.EmitAlloc(structTyp)

	// The vtable word (interface value index 1).  A null vtable is the `unset`
	// state (spec iface.assert.absent): no dynamic type, a guaranteed miss.
	var vtable @Instr = b.EmitExtract(iv, types.IfaceValueVtableIndex(), rawPtr)
	var vtNull @Instr = b.EmitBinop(iropcode.OP_EQ, vtable, b.EmitConstNil(rawPtr), types.TypBool())
	var missBlk @Block = AddBlock(f, "assert.ok.miss")
	var checkBlk @Block = AddBlock(f, "assert.ok.check")
	b.EmitBranch(vtNull, missBlk, checkBlk)

	// checkBlk: compare the dynamic `*TypeInfo` (vtable slot 1) against
	// `&__typeinfo.<T>` — a nominal identity compare (§11.12: exact type).
	var slot1 @Instr = loadVtableSlot(checkBlk, vtable, 1, rawPtr)
	var want @Instr = checkBlk.EmitDataSymAddr(typeInfoSymFor(ctx, recoveredTyp), types.TypUint8())
	var wrong @Instr = checkBlk.EmitBinop(iropcode.OP_NE, slot1, want, types.TypBool())
	var hitBlk @Block = AddBlock(f, "assert.ok.hit")
	checkBlk.EmitBranch(wrong, missBlk, hitBlk)

	var mergeBlk @Block = AddBlock(f, "assert.ok.merge")

	// missBlk (reached from a null vtable OR a wrong type): {nil, false}.
	storeCommaOkResult(missBlk, slot, recoveredTyp, missBlk.EmitConstNil(recoveredTyp),
			missBlk.EmitConstBool(false))
	missBlk.EmitJump(mergeBlk)

	// hitBlk: recover the boxed data pointer (a borrow — no RefInc) and flag ok.
	var recovered @Instr = hitBlk.EmitExtract(iv, types.IfaceValueDataIndex(), recoveredTyp)
	storeCommaOkResult(hitBlk, slot, recoveredTyp, recovered, hitBlk.EmitConstBool(true))
	hitBlk.EmitJump(mergeBlk)

	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(slot, structTyp)
}

// commaOkAssertStructType builds the anonymous {recovered, bool} result struct
// for a comma-ok assertion — the shape makeMultiReturnStructType produces for a
// two-result function, so the existing multi-return destructure handles it.
func commaOkAssertStructType(recoveredTyp @types.Type) @types.Type {
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = recoveredTyp
	results[1] = types.TypBool()
	return makeMultiReturnStructType(results)
}

// storeCommaOkResult writes the recovered value (field 0) and ok flag (field 1)
// into the {recovered, ok} struct at `slot` (an anonymous-struct alloca, whose
// Binate field indices are the LLVM indices — no padding remap).
func storeCommaOkResult(b @Block, slot @Instr, recoveredTyp @types.Type, recovered @Instr,
		ok @Instr) {
	b.EmitStore(b.EmitGetFieldPtr(slot, 0, recoveredTyp), recovered)
	b.EmitStore(b.EmitGetFieldPtr(slot, 1, types.TypBool()), ok)
}

// genMultiValueSource evaluates the single RHS of a multi-target assignment
// (`a, b := rhs` / `a, b = rhs`).  A 2-target comma-ok type assertion
// synthesizes a {recovered, ok} struct (genTypeAssertCommaOk — no panic); every
// other RHS is an ordinary multi-return expression (a call), evaluated normally.
func genMultiValueSource(ctx @GenContext, b @Block, e @ast.Expr, nTargets int) @Instr {
	if nTargets == 2 && e.Kind == ast.EXPR_TYPE_ASSERT {
		return genTypeAssertCommaOk(ctx, b, e)
	}
	return genExpr(ctx, b, e)
}
