package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Comma-ok concrete type-assertion lowering (gen_assert_commaok.bn / Slice 4b).
// Reuses assertGenModule (interface I + `impl *T : I`).  These double as the
// refcount golden for the borrow model: the assertion lowering itself performs
// NO refcount churn (the recovered pointer is a borrow), so a `*T` comma-ok —
// where the destructure's copy is a no-op too — is entirely churn-free, while a
// `@T` comma-ok's only acquire is the destructure's copy for the retained
// target (NOT a second RefInc in the hit block, which would RefDec a garbage
// pointer on the miss path).

// A comma-ok assertion still materializes `&__typeinfo.<T>` (OP_DATA_SYM_ADDR)
// for the nominal-identity compare — exactly one, as the expression form does.
func TestGenCommaOkEmitsTypeInfoCompare() testing.TestResult {
	var m @Module = assertGenModule("func borrow(rv *I) { a, ok := rv.(*T)\n_ = a\n_ = ok }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_DATA_SYM_ADDR) != 1 {
		return fail("comma-ok assertion should emit one OP_DATA_SYM_ADDR (&__typeinfo.<T>)")
	}
	return ""
}

// `*T` comma-ok is entirely churn-free: the lowering borrows (no RefInc) and the
// raw-pointer destructure copies nothing — so zero RefInc AND zero RefDec.  A
// nonzero count here would mean the hit block RefInc'd (the broken owned model).
func TestGenCommaOkBorrowNoChurn() testing.TestResult {
	var m @Module = assertGenModule("func borrow(rv *I) { a, ok := rv.(*T)\n_ = a\n_ = ok }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_REFINC) != 0 {
		return fail("*T comma-ok must not RefInc (borrow, no churn)")
	}
	if countOp(fn, iropcode.OP_REFDEC) != 0 {
		return fail("*T comma-ok must not RefDec (borrow, no churn)")
	}
	return ""
}

// `@T` comma-ok acquires the retained target exactly via the destructure's
// copy-RefInc, balanced by the target's scope-exit release.
func TestGenCommaOkRetainAcquires() testing.TestResult {
	var m @Module = assertGenModule("func retain(mv @I) { m, ok := mv.(@T)\n_ = m\n_ = ok }\n")
	var fn @Func = assertNamedFunc(m, "test.retain")
	if fn == nil { return fail("retain func not found") }
	if countOp(fn, iropcode.OP_REFINC) < 1 {
		return fail("@T comma-ok must acquire the retained target (destructure copy-RefInc)")
	}
	if countOp(fn, iropcode.OP_REFDEC) < 1 {
		return fail("@T comma-ok target must be released at scope exit")
	}
	return ""
}
