package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Interface-target type-assertion lowering (`x.(*J)` / `x.(@J)`, spec §11.12).
// Unlike a CONCRETE target — a pointer compare of the dynamic `*TypeInfo`
// against a static `&__typeinfo.<T>` (gen_assert.genTypeAssert) — an interface
// target does a runtime satisfaction lookup: does the scrutinee's dynamic type
// implement J?  It reads the dynamic `*TypeInfo` (vtable slot 1, EmitIfaceType
// Info), materializes `&__ifaceid.<J>` (EmitDataSymAddr), queries the
// satisfaction registry (EmitSatLookup / OP_SAT_LOOKUP), and on a HIT assembles
// the recovered interface value `{data, subvtable}` with the sub-vtable the
// lookup returned (EmitIfaceValueDyn).  A MISS is a null vtable (unset
// scrutinee) OR a null lookup result (type doesn't implement J).
//
// Both the compiled backends (native itab-hash via rt.SatLookup) and the
// bytecode VM (its own @VM registry via lookupSatEntry — the native hash is
// never built there) run this path: each op — OP_SAT_LOOKUP, OP_DATA_SYM_ADDR,
// OP_IFACE_TYPEINFO, dynamic OP_IFACE_VALUE — carries a VM lowering (RTTI Slice
// 5b), so interface-target assertions run in every mode.

// isInterfaceValueRecovery reports whether a recovered assert-target type is an
// interface value (`*J` / `@J`) rather than a concrete pointer (`*T` / `@T`).
func isInterfaceValueRecovery(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// ifaceIdSymFor derives the `__ifaceid.<J>` symbol for the target interface,
// keyed on its `(Pkg, Name)` exactly as the boxing side (gen_iface) and the
// emit side (CollectSatEntries: IfaceIdName(IfacePkg, IfaceName)) do, so the
// assertion's `&__ifaceid.<J>` matches the emitted marker.
func ifaceIdSymFor(jType @types.Type) @[]char {
	return mangle.IfaceIdName(jType.Pkg, jType.Name)
}

// genInterfaceAssert lowers an EXPRESSION-form interface-target assertion.
// Returns the recovered interface value (`*J` borrow / `@J` retain), leaving
// IR-gen positioned in the HIT block (the MISS paths abort — no merge).
func genInterfaceAssert(ctx @GenContext, b @Block, e @ast.Expr, recoveredTyp @types.Type) @Instr {
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var jType @types.Type = recoveredTyp.Elem

	var iv @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	var f @Func = ctx.Func

	// vtable null (unset scrutinee, spec iface.assert.absent) → guaranteed miss.
	var vtable @Instr = b.EmitExtract(iv, types.IfaceValueVtableIndex(), rawPtr)
	var vtNull @Instr = b.EmitBinop(iropcode.OP_EQ, vtable, b.EmitConstNil(rawPtr), types.TypBool())
	var unsetBlk @Block = AddBlock(f, "iassert.unset")
	var lookupBlk @Block = AddBlock(f, "iassert.lookup")
	b.EmitBranch(vtNull, unsetBlk, lookupBlk)

	// lookupBlk: dynamic `*TypeInfo` (vtable slot 1) + `rt.SatLookup(ti,
	// &__ifaceid.<J>)` → sub-vtable or null.
	var slot1 @Instr = lookupBlk.EmitIfaceTypeInfo(iv)
	var ifaceIdAddr @Instr = lookupBlk.EmitDataSymAddr(ifaceIdSymFor(jType), types.TypUint8())
	var subvt @Instr = lookupBlk.EmitSatLookup(slot1, ifaceIdAddr)
	var subNull @Instr = lookupBlk.EmitBinop(iropcode.OP_EQ, subvt, lookupBlk.EmitConstNil(rawPtr),
			types.TypBool())
	var wrongBlk @Block = AddBlock(f, "iassert.wrong")
	var hitBlk @Block = AddBlock(f, "iassert.hit")
	lookupBlk.EmitBranch(subNull, wrongBlk, hitBlk)

	var targetName @[]char = jType.QualifiedTypeName()

	// unsetBlk: no dynamic type → `<unset>`.  wrongBlk: the dynamic type's own name.
	emitAssertFail(ctx, unsetBlk, assertNameConst(ctx, unsetBlk, "<unset>"), targetName)
	unsetBlk.EmitUnreachable()
	emitAssertFail(ctx, wrongBlk, readTypeInfoName(ctx, wrongBlk, slot1), targetName)
	wrongBlk.EmitUnreachable()

	// hitBlk: assemble {data, subvtable} and recover it.
	ctx.CurBlock = hitBlk
	return recoverInterfaceValue(ctx, hitBlk, iv, subvt, recoveredTyp)
}

// recoverInterfaceValue assembles the recovered `{data, subvtable}` interface
// value in `b`.  `*J` is a bare borrow.  For `@J` the recovered value must own a
// reference: RefInc the boxed data and register the FRESH result iface value as
// an end-of-statement temp — NOT the raw `data`, whose `*uint8` type matches no
// cleanup predicate (`emitTempCleanupBody`), so registering it is a silent
// no-op that leaks the RefInc when the result is discarded.  Registering the
// `@J`-typed result makes cleanup RefDec it: a discard (`_ = x.(@J)`) releases
// the ref, while an assign / return / arg consumes-or-copies the fresh value
// (either way net +1 owned by the target, released at its scope exit).
func recoverInterfaceValue(ctx @GenContext, b @Block, iv @Instr, subvt @Instr,
		recoveredTyp @types.Type) @Instr {
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var data @Instr = b.EmitExtract(iv, types.IfaceValueDataIndex(), rawPtr)
	if recoveredTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		b.EmitRefInc(data)
	}
	var result @Instr = b.EmitIfaceValueDyn(data, subvt, recoveredTyp)
	// The recovered iface value is built on the VM stack (BC_IFACE_VALUE_DYN
	// grows vm.SP), so the enclosing statement must emit an OP_SP_RESTORE to
	// reclaim it — mark it SP-growing exactly as the boxing / upcast paths do
	// for their OP_IFACE_VALUE.  Without this, a `x.(*J)` in a loop leaks a
	// stack slot per iteration and eventually overflows vm.Stack.
	noteSPGrowingResult(ctx, result)
	if recoveredTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		registerTemp(ctx, result)
	}
	return result
}

// genInterfaceAssertCommaOk lowers a comma-ok interface-target assertion to a
// {recovered, ok} struct (the alloca-merge idiom, like the concrete comma-ok):
// HIT → {iface value, true}; any MISS → {nil interface value, false}.  Borrow
// model — no RefInc in the hit block; the destructure copy-retains the target.
func genInterfaceAssertCommaOk(ctx @GenContext, b @Block, e @ast.Expr,
		recoveredTyp @types.Type) @Instr {
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var jType @types.Type = recoveredTyp.Elem
	var structTyp @types.Type = commaOkAssertStructType(recoveredTyp)

	var iv @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	var f @Func = ctx.Func
	var slot @Instr = b.EmitAlloc(structTyp)

	var vtable @Instr = b.EmitExtract(iv, types.IfaceValueVtableIndex(), rawPtr)
	var vtNull @Instr = b.EmitBinop(iropcode.OP_EQ, vtable, b.EmitConstNil(rawPtr), types.TypBool())
	var missBlk @Block = AddBlock(f, "iassert.ok.miss")
	var lookupBlk @Block = AddBlock(f, "iassert.ok.lookup")
	b.EmitBranch(vtNull, missBlk, lookupBlk)

	var slot1 @Instr = lookupBlk.EmitIfaceTypeInfo(iv)
	var ifaceIdAddr @Instr = lookupBlk.EmitDataSymAddr(ifaceIdSymFor(jType), types.TypUint8())
	var subvt @Instr = lookupBlk.EmitSatLookup(slot1, ifaceIdAddr)
	var subNull @Instr = lookupBlk.EmitBinop(iropcode.OP_EQ, subvt, lookupBlk.EmitConstNil(rawPtr),
			types.TypBool())
	var hitBlk @Block = AddBlock(f, "iassert.ok.hit")
	lookupBlk.EmitBranch(subNull, missBlk, hitBlk)

	var mergeBlk @Block = AddBlock(f, "iassert.ok.merge")

	// missBlk: a nil interface value {nil, nil} + false.  Assembled via the
	// dynamic constructor (EmitConstNil does not build a 2-word iface value).
	var nilData @Instr = missBlk.EmitConstNil(rawPtr)
	var nilVt @Instr = missBlk.EmitConstNil(rawPtr)
	var nilIface @Instr = missBlk.EmitIfaceValueDyn(nilData, nilVt, recoveredTyp)
	storeCommaOkResult(missBlk, slot, recoveredTyp, nilIface, missBlk.EmitConstBool(false))
	missBlk.EmitJump(mergeBlk)

	// hitBlk: {data, subvtable} + true.  Borrow — no RefInc (the destructure copies).
	var data @Instr = hitBlk.EmitExtract(iv, types.IfaceValueDataIndex(), rawPtr)
	var ivResult @Instr = hitBlk.EmitIfaceValueDyn(data, subvt, recoveredTyp)
	storeCommaOkResult(hitBlk, slot, recoveredTyp, ivResult, hitBlk.EmitConstBool(true))
	hitBlk.EmitJump(mergeBlk)

	// Both branches build an iface value on the VM stack (BC_IFACE_VALUE_DYN
	// grows vm.SP); the statement's result is the merge LOAD, not an
	// OP_IFACE_VALUE, so mark the SP-growing branch values directly so an
	// OP_SP_RESTORE is emitted to reclaim the growth (else a comma-ok assertion
	// in a loop leaks a stack slot per iteration).
	noteSPGrowingResult(ctx, nilIface)
	noteSPGrowingResult(ctx, ivResult)

	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(slot, structTyp)
}
