package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Interface-target type-assertion lowering (gen_assert_iface.bn / Slice 5a).
// These double as the refcount golden: recovering `@J` retains (RefInc) the
// boxed data, `*J` borrows (no churn).  Both forms call rt.SatLookup and
// assemble the result via the dynamic OP_IFACE_VALUE.

// assertIfaceModule builds a module with two interfaces I and J, a type T that
// implements BOTH, plus the caller-supplied `body`.  `iv.(*J)` recovers a J
// interface value from an I interface value.
func assertIfaceModule(body *[]readonly char) @Module {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"interface J { bar() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"func (t *T) bar() { }\n"
					"impl *T : I\n"
					"impl *T : J\n")
	cb.Write(body)
	return genFromSource(buf.CopyStr(cb.String()))
}

// An interface-target assertion materializes `&__ifaceid.<J>` (OP_DATA_SYM_ADDR)
// and assembles the recovered value with the dynamic OP_IFACE_VALUE.
func TestGenIfaceAssertEmitsLookupAndAssembly() testing.TestResult {
	var m @Module = assertIfaceModule("func borrow(iv *I) *J { return iv.(*J) }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_DATA_SYM_ADDR) != 1 {
		return fail("interface assertion should emit one OP_DATA_SYM_ADDR (&__ifaceid.<J>)")
	}
	if countOp(fn, iropcode.OP_IFACE_VALUE) < 1 {
		return fail("interface assertion should assemble a result iface value (OP_IFACE_VALUE)")
	}
	return ""
}

// `*J` is a BORROW — no refcount churn for the recovery.
func TestGenIfaceAssertBorrowNoRefInc() testing.TestResult {
	var m @Module = assertIfaceModule("func borrow(iv *I) *J { return iv.(*J) }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_REFINC) != 0 {
		return fail("*J borrow must not RefInc (no churn)")
	}
	return ""
}

// `@J` RETAINS — the recovered managed interface value's boxed data is RefInc'd.
func TestGenIfaceAssertRetainRefIncs() testing.TestResult {
	var m @Module = assertIfaceModule("func retain(iv @I) @J { return iv.(@J) }\n")
	var fn @Func = assertNamedFunc(m, "test.retain")
	if fn == nil { return fail("retain func not found") }
	if countOp(fn, iropcode.OP_REFINC) < 1 {
		return fail("@J retain must RefInc the recovered boxed data")
	}
	return ""
}
