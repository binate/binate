package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Concrete type-assertion lowering (gen_assert.bn / Slice 4).  These double as
// the refcount golden: `@T` retains (RefInc), `*T` borrows (no churn).

// assertGenModule builds a module with an interface I + `impl *T : I`, plus the
// caller-supplied `body` (the function(s) under test).
func assertGenModule(body *[]readonly char) @Module {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n")
	cb.Write(body)
	return genFromSource(buf.CopyStr(cb.String()))
}

// assertNamedFunc returns the module func with fully-qualified name `name`.
func assertNamedFunc(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if charEq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

// A concrete assertion materializes `&__typeinfo.<T>` (OP_DATA_SYM_ADDR) for the
// nominal-identity compare against the interface value's vtable slot 1.
func TestGenAssertEmitsTypeInfoCompare() testing.TestResult {
	var m @Module = assertGenModule("func borrow(rv *I) *T { return rv.(*T) }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_DATA_SYM_ADDR) != 1 {
		return fail("assertion should emit one OP_DATA_SYM_ADDR (&__typeinfo.<T>)")
	}
	return ""
}

// `*T` is a BORROW — no refcount churn (no OP_REFINC for the recovery).
func TestGenAssertBorrowNoRefInc() testing.TestResult {
	var m @Module = assertGenModule("func borrow(rv *I) *T { return rv.(*T) }\n")
	var fn @Func = assertNamedFunc(m, "test.borrow")
	if fn == nil { return fail("borrow func not found") }
	if countOp(fn, iropcode.OP_REFINC) != 0 {
		return fail("*T borrow must not RefInc (no churn)")
	}
	return ""
}

// `@T` RETAINS — the recovered managed pointer is RefInc'd (+1, released at end
// of statement by the registered temp).
func TestGenAssertRetainRefIncs() testing.TestResult {
	var m @Module = assertGenModule("func retain(mv @I) @T { return mv.(@T) }\n")
	var fn @Func = assertNamedFunc(m, "test.retain")
	if fn == nil { return fail("retain func not found") }
	if countOp(fn, iropcode.OP_REFINC) < 1 {
		return fail("@T retain must RefInc the recovered pointer")
	}
	return ""
}
