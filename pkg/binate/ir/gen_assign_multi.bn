package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// emitIndexStore stores a value into a slice or array element, RefDec'ing
// the overwritten managed element first (Axiom 5).  Used by multi-return
// assignment to handle LHS index expressions; the new value's copy-RefInc
// is the caller's job (emitManagedValueCopyRefInc).  Returns the possibly-
// updated block.
func emitIndexStore(ctx @GenContext, b @Block, lhs @ast.Expr, collection @Instr, index @Instr,
		val @Instr) @Block {
	emitIndexBoundsCheck(ctx, b, collection, index)
	// Peel transparent wrappers so a named array (`type Row [3]int`) — or a
	// readonly one — reaches the array store arm and its element type comes
	// from the underlying array, not the wrapper (whose `.Elem` is nil).
	var collSt @types.Type = nil
	if collection.Typ != nil { collSt = peelTransparent(collection.Typ) }
	if collSt != nil && collSt.Kind == types.TYP_ARRAY {
		var arrPtr @Instr = nil
		// Recover the array's ADDRESS by base kind, mirroring the single-assign
		// (genAssign) and parallel-assign (resolveParallelIndexTarget) paths.  The
		// passed-in `collection` is a loaded COPY of the array, so storing to it drops
		// the write; the store must target the array's real storage.  Without a
		// matching arm arrPtr stays nil and the element store is silently DROPPED (a
		// multi-return `t.arr[i], y = f()` / `(*p)[i], y = f()` no-ops the write).
		if lhs.X.Kind == ast.EXPR_IDENT {
			arrPtr = lookupVar(ctx, lhs.X.Name)
		} else if lhs.X.Kind == ast.EXPR_SELECTOR {
			// `t.arr[i]` / `p.arr[i]` — address the array field.  genSelectorPtr can
			// split the block (a type-assertion base), so re-sync.  forDeref=true:
			// the element is stored into below (a deref).
			arrPtr = genSelectorPtr(ctx, b, lhs.X, true)
			b = ctx.CurBlock
		} else if lhs.X.Kind == ast.EXPR_UNARY && lhs.X.Op == cast(int, token.STAR) {
			// `(*p)[i]` — p (a pointer-to-array) IS the array's backing address.
			arrPtr = genExpr(ctx, b, lhs.X.X)
			b = ctx.CurBlock
		}
		if arrPtr != nil {
			var elemTyp @types.Type = collSt.Elem
			if elemTyp == nil { elemTyp = types.TypInt() }
			var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, index, elemTyp)
			b = emitElemPtrStore(ctx, b, elemPtr, val, elemTyp)
		}
	} else if collSt != nil && collSt.Kind == types.TYP_POINTER {
		var elemTyp @types.Type = collSt.Elem
		if elemTyp == nil { elemTyp = types.TypInt() }
		// Raw pointer carries no length (no bounds check) — nil-check the store
		// deref (opt-in; plan-nil-check-opt-in.md).
		emitNilCheckIfEnabled(ctx, b, collection)
		var elemPtr @Instr = b.EmitGetElemPtr(collection, index, elemTyp)
		b = emitElemPtrStore(ctx, b, elemPtr, val, elemTyp)
	} else {
		// Slice or managed-slice.  Element type from the PEELED collSt, not the
		// raw collection.Typ: a named-distinct slice is TYP_NAMED with a nil
		// `.Elem`, so the un-peeled read would default to TypInt and mis-stride a
		// non-int named element.
		var elemTyp @types.Type = types.TypInt()
		if collSt != nil && collSt.Elem != nil {
			elemTyp = collSt.Elem
		}
		if needsStructCopy(elemTyp) {
			// Managed struct/array element: two-slot save-copy-destroy.  A
			// slice element has no direct slot pointer, so copy the new
			// value's managed fields via a fresh slot (emitStructCopy) and
			// release the old element's via another (emitStructDtor), then
			// write the value back.  emitStructCopy/emitStructDtor lower to
			// the type's generated __copy_/__dtor_ helpers, so all field
			// kinds (incl. @Iface) and nested aggregates are covered.
			var oldElem @Instr = b.EmitSliceGet(collection, index, elemTyp)
			var oldSlot @Instr = b.EmitAlloc(elemTyp)
			b.EmitStore(oldSlot, oldElem)
			var newSlot @Instr = b.EmitAlloc(elemTyp)
			b.EmitStore(newSlot, val)
			emitStructCopy(ctx.Func, b, newSlot, elemTyp)
			emitStructDtor(ctx.Func, b, oldSlot, elemTyp)
			b.EmitSliceSet(collection, index, val, elemTyp)
		} else {
			if isManagedScalarType(elemTyp) {
				var oldElem @Instr = b.EmitSliceGet(collection, index, elemTyp)
				b = emitManagedValueRefDec(ctx.Func, b, oldElem, elemTyp)
			}
			val = ensureWidth(ctx, b, val, elemTyp)
			b.EmitSliceSet(collection, index, val, elemTyp)
		}
	}
	return b
}

// emitElemPtrStore stores val into an array/pointer element at elemPtr,
// honoring Axiom 5: a managed struct element gets save-copy-destroy (copy
// RefIncs the new aggregate's managed fields, the dtor releases the old
// element's), a managed scalar gets old-value RefDec, plain elements a
// bare store.  Returns the possibly-updated block.
func emitElemPtrStore(ctx @GenContext, b @Block, elemPtr @Instr, val @Instr,
		elemTyp @types.Type) @Block {
	if needsStructCopy(elemTyp) {
		var tmpSlot @Instr = b.EmitAlloc(elemTyp)
		var oldElem @Instr = b.EmitLoad(elemPtr, elemTyp)
		b.EmitStore(tmpSlot, oldElem)
		b.EmitStore(elemPtr, val)
		emitStructCopy(ctx.Func, b, elemPtr, elemTyp)
		emitStructDtor(ctx.Func, b, tmpSlot, elemTyp)
		return b
	}
	if isManagedScalarType(elemTyp) {
		var oldElem @Instr = b.EmitLoad(elemPtr, elemTyp)
		b = emitManagedValueRefDec(ctx.Func, b, oldElem, elemTyp)
	}
	val = ensureWidth(ctx, b, val, elemTyp)
	b.EmitStore(elemPtr, val)
	return b
}

// genMultiAssign lowers a multi-value assignment `q, r, ... = call(...)`:
// it evaluates the call once, then for each LHS target extracts its
// component, copy-RefIncs a managed value for the target, and stores it
// (RefDec'ing any overwritten managed value, Axiom 5).  A blank `_` target
// discards its component — the call-result temp's dtor frees it at end of
// statement.
func genMultiAssign(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	// A 2-target comma-ok type assertion (`v, ok = x.(*T)`) yields a synthesized
	// {recovered, ok} struct rather than a call result.
	var val @Instr = genMultiValueSource(ctx, b, stmt.Exprs2[0], len(stmt.Exprs))
	b = ctx.CurBlock
	var retTypes @[]@types.Type
	if val.Op == iropcode.OP_CALL {
		retTypes = lookupFuncResults(ctx.Gc, val.StrVal)
	}
	// A func-value or interface-method call has no name to look up, but its
	// multi-return result is packed as a struct whose fields carry the
	// per-result types — derive them so a sub-word / managed component gets
	// a correctly-typed slot.  Without this, elemTyp below defaults to int
	// and `a, b = fv()` / `a, b = iv.m()` with a non-int component stores a
	// mistyped value (invalid IR; a managed component also skips its
	// Axiom-3 RefInc).  Mirrors genShortVar's fallback for the `:=` form.
	if len(retTypes) == 0 && val.Typ != nil && val.Typ.Kind == types.TYP_STRUCT {
		retTypes = multiReturnFieldTypes(val.Typ)
	}
	for i := 0; i < len(stmt.Exprs); i++ {
		// A prior target may have split the block — a managed @func/@Iface
		// IDENT target's old-value RefDec (emitManagedValueRefDec) does, and
		// updates only the local b, not ctx.CurBlock.  Re-sync so a later
		// SELECTOR target's `b = ctx.CurBlock` (read after genSelectorPtr,
		// which — unlike genExpr — does not sync ctx.CurBlock) lands on the
		// live continuation, not the stale terminated block.  Without this
		// the field store emits into a dead block and is silently dropped.
		ctx.CurBlock = b
		var lhs @ast.Expr = stmt.Exprs[i]
		// A blank-identifier target (`_, n = f()`) discards its
		// component: nothing owns it, so do NOT copy-retain it.  The
		// call-result temp's dtor RefDec's the owned ref at end of
		// statement, freeing it; an Axiom-3 RefInc here would have no
		// matching RefDec and leak.  (The single-value `_ = g()` path
		// skips the RefInc the same way, via its nil-ptr guard below.)
		if lhs.Kind == ast.EXPR_IDENT && isBlank(lhs.Name) {
			continue
		}
		var elemTyp @types.Type = types.TypInt()
		if len(retTypes) > 0 && i < len(retTypes) {
			elemTyp = retTypes[i]
		}
		var extracted @Instr = b.EmitExtract(val, i, elemTyp)
		// Axiom 3: the extracted value is a COPY borrowed from the
		// owned call-result temp (whose dtor RefDec's it at end of
		// statement), so RefInc it for the target that now co-owns it.
		// Covers @T / @[]T / @func / @Iface; struct/array aggregates are
		// RefInc'd by emitStructCopy at the store instead.
		emitManagedValueCopyRefInc(ctx.Func, b, extracted, elemTyp)
		if lhs.Kind == ast.EXPR_IDENT {
			var ptr @Instr = lookupVar(ctx, lhs.Name)
			if ptr != nil {
				var varTyp @types.Type = lookupVarType(ctx, lhs.Name)
				if varTyp != nil && needsStructCopy(varTyp) {
					// Axiom 5: save-copy-destroy for a managed struct.
					var tmpSlot @Instr = b.EmitAlloc(varTyp)
					var oldVal @Instr = b.EmitLoad(ptr, varTyp)
					b.EmitStore(tmpSlot, oldVal)
					b.EmitStore(ptr, extracted)
					emitStructCopy(ctx.Func, b, ptr, varTyp)
					emitStructDtor(ctx.Func, b, tmpSlot, varTyp)
				} else {
					// Axiom 5: RefDec the overwritten managed value
					// before storing the new one (RefInc'd above).
					if isManagedScalarType(varTyp) {
						var oldVal @Instr = b.EmitLoad(ptr, varTyp)
						b = emitManagedValueRefDec(ctx.Func, b, oldVal, varTyp)
					}
					// Coerce to the destination width for symmetry with the
					// SELECTOR arm below (and the single-assign arms).  A no-op
					// today — a multi-return component is already typed at the
					// declared result width — but keeps the arm robust if that
					// extract-width == slot-width invariant ever changes.
					if varTyp != nil {
						extracted = ensureWidth(ctx, b, extracted, varTyp)
					}
					b.EmitStore(ptr, extracted)
				}
			}
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			// s[i] = extracted: slice/array index assignment.  A nested-ARRAY target
			// (`a[j][i]`) has no backing pointer for the loaded inner array, so
			// emitIndexStore's array arm would DROP the store; resolve the element
			// pointer in-place via genIndexPtr instead (see gen_control.bn /
			// resolveParallelIndexTarget).  Checked by TYPE first so lhs.X isn't
			// generated twice.
			if len(lhs.Args) == 1 && isNestedArrayBase(ctx, lhs) {
				// Store target off a nested-array element — deref => true.
				var elemPtr @Instr = genIndexPtr(ctx, b, lhs, true)
				b = ctx.CurBlock
				if elemPtr != nil && elemPtr.Typ != nil && elemPtr.Typ.Elem != nil {
					b = emitArrayElemStore(ctx, b, elemPtr, extracted, elemPtr.Typ.Elem)
				}
			} else {
				var collection @Instr = genExpr(ctx, b, lhs.X)
				b = ctx.CurBlock
				var index @Instr = genExpr(ctx, b, lhs.Args[0])
				b = ctx.CurBlock
				b = emitIndexStore(ctx, b, lhs, collection, index, extracted)
			}
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			// s.field = extracted: struct field assignment (store => forDeref=true)
			var fieldPtr @Instr = genSelectorPtr(ctx, b, lhs, true)
			b = ctx.CurBlock
			if fieldPtr != nil {
				var fieldTyp @types.Type = getSelectorType(ctx, lhs)
				if fieldTyp != nil && needsStructCopy(fieldTyp) {
					// Axiom 5: save-copy-destroy for a managed struct
					// field — copy RefIncs the new aggregate's managed
					// fields, the dtor releases the old field's.
					var tmpSlot @Instr = b.EmitAlloc(fieldTyp)
					var oldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
					b.EmitStore(tmpSlot, oldVal)
					b.EmitStore(fieldPtr, extracted)
					emitStructCopy(ctx.Func, b, fieldPtr, fieldTyp)
					emitStructDtor(ctx.Func, b, tmpSlot, fieldTyp)
				} else {
					// Axiom 5: RefDec the overwritten managed field first.
					if isManagedScalarType(fieldTyp) {
						var oldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
						b = emitManagedValueRefDec(ctx.Func, b, oldVal, fieldTyp)
					}
					if fieldTyp != nil {
						extracted = ensureWidth(ctx, b, extracted, fieldTyp)
					}
					b.EmitStore(fieldPtr, extracted)
				}
			}
		} else if lhs.Kind == ast.EXPR_UNARY && lhs.Op == cast(int, token.STAR) {
			// *p = extracted: store through a dereferenced pointer.  Without this
			// arm the deref target was silently DROPPED (no store emitted) — a
			// pre-existing miscompile for BOTH plain and named pointers.  ptrVal IS
			// the slot pointer, so this mirrors the SELECTOR arm's Axiom-5
			// save-copy-destroy / RefDec-old logic with ptrVal as the destination.
			// Peel the pointer type (named-distinct) and accept a managed pointer.
			var ptrVal @Instr = genExpr(ctx, b, lhs.X)
			b = ctx.CurBlock
			var derefTyp @types.Type = nil
			var pk @types.Type = nil
			if ptrVal.Typ != nil { pk = peelTransparent(ptrVal.Typ) }
			if pk != nil && (pk.Kind == types.TYP_POINTER || pk.Kind == types.TYP_MANAGED_PTR) {
				derefTyp = pk.Elem
			}
			if derefTyp != nil && needsStructCopy(derefTyp) {
				var tmpSlot @Instr = b.EmitAlloc(derefTyp)
				var oldVal @Instr = b.EmitLoad(ptrVal, derefTyp)
				b.EmitStore(tmpSlot, oldVal)
				b.EmitStore(ptrVal, extracted)
				emitStructCopy(ctx.Func, b, ptrVal, derefTyp)
				emitStructDtor(ctx.Func, b, tmpSlot, derefTyp)
			} else {
				if isManagedScalarType(derefTyp) {
					var oldVal @Instr = b.EmitLoad(ptrVal, derefTyp)
					b = emitManagedValueRefDec(ctx.Func, b, oldVal, derefTyp)
				}
				if derefTyp != nil {
					extracted = ensureWidth(ctx, b, extracted, derefTyp)
				}
				b.EmitStore(ptrVal, extracted)
			}
		}
	}
	return b
}
