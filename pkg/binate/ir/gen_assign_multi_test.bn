package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Unit tests for multi-value assignment lowering (genMultiAssign /
// emitIndexStore).  End-to-end refcount behavior is pinned by conformance
// 570-572; these assert the IR shape: binding a managed component copy-
// RefIncs it where a blank `_` target does not, so the bound form emits
// strictly more OP_REFINC — for both @T and @func — and an index target
// refcounts the overwritten element.

// countOpInFunc counts instructions with op across all of fn's blocks.
func countOpInFunc(fn @Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op { n = n + 1 }
		}
	}
	return n
}

// ptrMultiAssignSrc builds foo doing `<target>, n = pair()` where pair
// returns (@Node, int); target is "a" (a managed param) or "_".
func ptrMultiAssignSrc(target *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { Val int }\n")
	cb.Write("func foo(a @Node) int {\n")
	cb.Write("\tvar n int = 0\n")
	cb.Write("\t")
	cb.Write(target)
	cb.Write(", n = pair()\n")
	cb.Write("\treturn n\n}\n")
	cb.Write("func pair() (@Node, int) { return make(Node), 7 }\n")
	return buf.CopyStr(cb.String())
}

// A bound @T multi-assign component is copy-RefInc'd; a blank `_` is not.
func TestMultiAssignBlankSkipsPtrCopyRefInc() testing.TestResult {
	var bound @Module = genFromSource(ptrMultiAssignSrc("a"))
	var blank @Module = genFromSource(ptrMultiAssignSrc("_"))
	var bInc int = countOpInFunc(bound.Funcs[0], iropcode.OP_REFINC)
	var nInc int = countOpInFunc(blank.Funcs[0], iropcode.OP_REFINC)
	if bInc <= nInc {
		return fail(
				"a bound @T multi-assign component must copy-RefInc, unlike `_`")
	}
	return ""
}

// funcMultiAssignSrc builds foo doing `<target>, n = makeF()` where makeF
// returns (@func(int) int, int).
func funcMultiAssignSrc(target *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo(g @func(int) int) int {\n")
	cb.Write("\tvar n int = 0\n")
	cb.Write("\t")
	cb.Write(target)
	cb.Write(", n = makeF()\n")
	cb.Write("\treturn n\n}\n")
	cb.Write("func makeF() (@func(int) int, int) {\n")
	cb.Write("\tvar f @func(int) int = nil\n")
	cb.Write("\treturn f, 7\n}\n")
	return buf.CopyStr(cb.String())
}

// The @func arm: a bound @func multi-assign component is copy-RefInc'd,
// unlike a blank `_` (previously @func had no copy-RefInc arm at all, so
// the closure record was freed early — a use-after-free on invoke).
func TestMultiAssignFuncValueCopyRefInc() testing.TestResult {
	var bound @Module = genFromSource(funcMultiAssignSrc("g"))
	var blank @Module = genFromSource(funcMultiAssignSrc("_"))
	var bInc int = countOpInFunc(bound.Funcs[0], iropcode.OP_REFINC)
	var nInc int = countOpInFunc(blank.Funcs[0], iropcode.OP_REFINC)
	if bInc <= nInc {
		return fail(
				"a bound @func multi-assign component must copy-RefInc, unlike `_`")
	}
	return ""
}

// An index target (`s[i], n = f()`) RefDec's the overwritten element and
// copy-RefIncs the new one (emitIndexStore).
func TestMultiAssignIndexStoreRefcounts() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { Val int }\n")
	cb.Write("func foo(s @[]@Node) int {\n")
	cb.Write("\tvar n int = 0\n")
	cb.Write("\ts[0], n = pair()\n")
	cb.Write("\treturn n\n}\n")
	cb.Write("func pair() (@Node, int) { return make(Node), 7 }\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = m.Funcs[0]
	if countOpInFunc(fn, iropcode.OP_REFINC) < 1 {
		return fail("index multi-assign must copy-RefInc the new element")
	}
	if countOpInFunc(fn, iropcode.OP_REFDEC) < 1 {
		return fail("index multi-assign must RefDec the overwritten element")
	}
	return ""
}

// containsSub reports whether hay contains needle as a substring.
func containsSub(hay *[]readonly char, needle *[]readonly char) bool {
	if len(needle) == 0 { return true }
	if len(needle) > len(hay) { return false }
	var last int = len(hay) - len(needle)
	for i := 0; i <= last; i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if hay[i + j] != needle[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// funcByName returns the module function whose name contains want, or nil.
func funcByName(m @Module, want *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if containsSub(m.Funcs[i].Name, want) { return m.Funcs[i] }
	}
	return nil
}

// hasCallTo reports whether fn emits an OP_CALL whose callee name contains
// substr.  A managed-aggregate save-copy-destroy store calls the type's
// generated `__copy_` helper (the complete acquire — all field kinds incl.
// @Iface, and nested aggregates); a field-by-field reimplementation or a
// plain store would not.
func hasCallTo(fn @Func, substr *[]readonly char) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_CALL && containsSub(blk.Instrs[j].StrVal, substr) {
				return true
			}
		}
	}
	return false
}

// A managed-aggregate managed-SLICE element target (`s[i], n = f()`) save-
// copy-destroys via the type's generated __copy_/__dtor_ helpers (complete
// for @Iface fields + nested aggregates).  Pins that the slice arm calls
// __copy_, NOT the removed field-by-field emitStructElemRefcount (which
// omitted @Iface fields).
func TestMultiAssignSliceAggregateCopies() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { Val int }\n")
	cb.Write("type Wrap struct { b @Node }\n")
	cb.Write("func foo(s @[]Wrap) int {\n")
	cb.Write("\tvar n int = 0\n")
	cb.Write("\ts[0], n = pair()\n")
	cb.Write("\treturn n\n}\n")
	cb.Write("func pair() (Wrap, int) {\n")
	cb.Write("\tvar w Wrap\n\tw.b = make(Node)\n\treturn w, 7\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = funcByName(m, "foo")
	if fn == nil { return fail("foo not found in module") }
	if !hasCallTo(fn, "__copy_") {
		return fail(
				"aggregate slice-element multi-assign must call the __copy_ helper")
	}
	return ""
}

// funcValueCallMultiAssignSrc builds foo doing `<target>, n = fv()` where fv
// is a FUNC-VALUE whose call returns (@func(int) int, int).  Unlike makeF()
// above (a direct OP_CALL whose result types come from lookupFuncResults), a
// func-value call is OP_CALL_FUNC_VALUE — and an interface dispatch is
// OP_CALL_IFACE_METHOD — neither of which has a callee NAME to look up, so
// genMultiAssign must recover the per-component types from the multi-return
// tuple struct (multiReturnFieldTypes).
func funcValueCallMultiAssignSrc(target *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo(g @func(int) int) int {\n")
	cb.Write("\tvar fv @func() (@func(int) int, int) = makeF\n")
	cb.Write("\tvar n int = 0\n")
	cb.Write("\t")
	cb.Write(target)
	cb.Write(", n = fv()\n")
	cb.Write("\treturn n\n}\n")
	cb.Write("func makeF() (@func(int) int, int) {\n")
	cb.Write("\tvar f @func(int) int = nil\n")
	cb.Write("\treturn f, 7\n}\n")
	return buf.CopyStr(cb.String())
}

// Regression: the `=` (assignment) form of a multi-bind whose RHS is a
// FUNC-VALUE call (OP_CALL_FUNC_VALUE) — equally an interface dispatch
// (OP_CALL_IFACE_METHOD) — has no callee name, so genMultiAssign must
// recover per-component types from the multi-return tuple struct.  Without
// that fallback every component defaulted to int: a managed component
// skipped its copy-RefInc (latent UAF) and a sub-word component mis-typed
// its slot (invalid IR).  The `:=` form (genShortVar) already had the
// fallback; the `=` form (genMultiAssign) did not.  The bound @func
// component must copy-RefInc, unlike a blank `_`.
func TestMultiAssignFuncValueCallCopyRefInc() testing.TestResult {
	var bound @Module = genFromSource(funcValueCallMultiAssignSrc("g"))
	var blank @Module = genFromSource(funcValueCallMultiAssignSrc("_"))
	var bInc int = countOpInFunc(bound.Funcs[0], iropcode.OP_REFINC)
	var nInc int = countOpInFunc(blank.Funcs[0], iropcode.OP_REFINC)
	if bInc <= nInc {
		return fail(
				"func-value-call multi-assign must copy-RefInc the bound @func component")
	}
	return ""
}
