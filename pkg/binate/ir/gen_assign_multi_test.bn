package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Unit tests for multi-value assignment lowering (genMultiAssign /
// emitIndexStore).  End-to-end refcount behavior is pinned by conformance
// 570-572; these assert the IR shape: binding a managed component copy-
// RefIncs it where a blank `_` target does not, so the bound form emits
// strictly more OP_REFINC — for both @T and @func — and an index target
// refcounts the overwritten element.

// countOpInFunc counts instructions with op across all of fn's blocks.
func countOpInFunc(fn @Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op { n = n + 1 }
		}
	}
	return n
}

// ptrMultiAssignSrc builds foo doing `<target>, n = pair()` where pair
// returns (@Node, int); target is "a" (a managed param) or "_".
func ptrMultiAssignSrc(target *[]readonly char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { Val int }\n")
	cb = cb.WriteStr("func foo(a @Node) int {\n")
	cb = cb.WriteStr("\tvar n int = 0\n")
	cb = cb.WriteStr("\t")
	cb = cb.WriteStr(target)
	cb = cb.WriteStr(", n = pair()\n")
	cb = cb.WriteStr("\treturn n\n}\n")
	cb = cb.WriteStr("func pair() (@Node, int) { return make(Node), 7 }\n")
	return cb.Bytes()
}

// A bound @T multi-assign component is copy-RefInc'd; a blank `_` is not.
func TestMultiAssignBlankSkipsPtrCopyRefInc() testing.TestResult {
	var bound @Module = genFromSource(ptrMultiAssignSrc("a"))
	var blank @Module = genFromSource(ptrMultiAssignSrc("_"))
	var bInc int = countOpInFunc(bound.Funcs[0], OP_REFINC)
	var nInc int = countOpInFunc(blank.Funcs[0], OP_REFINC)
	if bInc <= nInc {
		return fail(
			"a bound @T multi-assign component must copy-RefInc, unlike `_`")
	}
	return ""
}

// funcMultiAssignSrc builds foo doing `<target>, n = makeF()` where makeF
// returns (@func(int) int, int).
func funcMultiAssignSrc(target *[]readonly char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func foo(g @func(int) int) int {\n")
	cb = cb.WriteStr("\tvar n int = 0\n")
	cb = cb.WriteStr("\t")
	cb = cb.WriteStr(target)
	cb = cb.WriteStr(", n = makeF()\n")
	cb = cb.WriteStr("\treturn n\n}\n")
	cb = cb.WriteStr("func makeF() (@func(int) int, int) {\n")
	cb = cb.WriteStr("\tvar f @func(int) int = nil\n")
	cb = cb.WriteStr("\treturn f, 7\n}\n")
	return cb.Bytes()
}

// The @func arm: a bound @func multi-assign component is copy-RefInc'd,
// unlike a blank `_` (previously @func had no copy-RefInc arm at all, so
// the closure record was freed early — a use-after-free on invoke).
func TestMultiAssignFuncValueCopyRefInc() testing.TestResult {
	var bound @Module = genFromSource(funcMultiAssignSrc("g"))
	var blank @Module = genFromSource(funcMultiAssignSrc("_"))
	var bInc int = countOpInFunc(bound.Funcs[0], OP_REFINC)
	var nInc int = countOpInFunc(blank.Funcs[0], OP_REFINC)
	if bInc <= nInc {
		return fail(
			"a bound @func multi-assign component must copy-RefInc, unlike `_`")
	}
	return ""
}

// An index target (`s[i], n = f()`) RefDec's the overwritten element and
// copy-RefIncs the new one (emitIndexStore).
func TestMultiAssignIndexStoreRefcounts() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { Val int }\n")
	cb = cb.WriteStr("func foo(s @[]@Node) int {\n")
	cb = cb.WriteStr("\tvar n int = 0\n")
	cb = cb.WriteStr("\ts[0], n = pair()\n")
	cb = cb.WriteStr("\treturn n\n}\n")
	cb = cb.WriteStr("func pair() (@Node, int) { return make(Node), 7 }\n")
	var m @Module = genFromSource(cb.Bytes())
	var fn @Func = m.Funcs[0]
	if countOpInFunc(fn, OP_REFINC) < 1 {
		return fail("index multi-assign must copy-RefInc the new element")
	}
	if countOpInFunc(fn, OP_REFDEC) < 1 {
		return fail("index multi-assign must RefDec the overwritten element")
	}
	return ""
}
