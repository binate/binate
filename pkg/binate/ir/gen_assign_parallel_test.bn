package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Unit tests for parallel-assignment lowering (genParallelAssign).  These pin
// the IR shape; end-to-end values and refcount balance are in conformance
// 777-782.  The regression guard is TestParallelAssignEmitsStores: before the
// fix, a matched-arity multi-expression assignment type-checked clean but
// genAssign matched neither lowering arm and emitted NO store IR — both writes
// silently dropped.  countOpInFunc / funcByName / hasCallTo / fail /
// genFromSource are shared package test helpers.

// paScalarSrc builds `func foo() { var a int = 0; var b int = 0; <body> }`.
func paScalarSrc(body *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo() {\n")
	cb.Write("\tvar a int = 0\n")
	cb.Write("\tvar b int = 0\n")
	cb.Write("\t")
	cb.Write(body)
	cb.Write("\n}\n")
	return buf.CopyStr(cb.String())
}

// A matched-arity multi-expression assignment emits its stores: `a, b = 1, 2`
// adds the two writes (over the two var-init writes alone) that the pre-fix
// fall-through dropped entirely.
func TestParallelAssignEmitsStores() testing.TestResult {
	var with @Module = genFromSource(paScalarSrc("a, b = 1, 2"))
	var base @Module = genFromSource(paScalarSrc(""))
	var fw @Func = funcByName(with, "foo")
	var fb @Func = funcByName(base, "foo")
	if fw == nil || fb == nil { return fail("foo not found") }
	if countOpInFunc(fw, OP_STORE) < countOpInFunc(fb, OP_STORE) + 2 {
		return fail("parallel assignment `a, b = 1, 2` must emit both stores")
	}
	return ""
}

// paManagedSwapSrc builds `func foo(a @Node, b @Node) { <t>, b = b, a }`,
// where t is the first LHS target ("a" or the blank "_").
func paManagedSwapSrc(t *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { Val int }\n")
	cb.Write("func foo(a @Node, b @Node) {\n")
	cb.Write("\t")
	cb.Write(t)
	cb.Write(", b = b, a\n}\n")
	return buf.CopyStr(cb.String())
}

// A managed swap acquires BOTH right-hand values up front (Axiom 3 copy-
// RefInc), before either old slot is released — the discipline that makes
// `a, b = b, a` of two @T a correct swap rather than a use-after-free.  So a
// managed swap emits at least the two acquiring RefIncs; the scalar swap emits
// none.
func TestParallelAssignManagedSwapAcquires() testing.TestResult {
	var managed @Module = genFromSource(paManagedSwapSrc("a"))
	var scalar @Module = genFromSource(paScalarSrc("a, b = b, a"))
	var fm @Func = funcByName(managed, "foo")
	var fs @Func = funcByName(scalar, "foo")
	if fm == nil || fs == nil { return fail("foo not found") }
	if countOpInFunc(fm, OP_REFINC) < 2 {
		return fail("managed swap must acquire both values up front")
	}
	if countOpInFunc(fs, OP_REFINC) != 0 {
		return fail("scalar swap must emit no refcounting")
	}
	return ""
}

// A blank target acquires nothing: `_, b = b, a` copy-RefIncs fewer values
// than `a, b = b, a` (the `_` half is evaluated for effect but not stored, so
// it must not be RefInc'd — an unmatched acquire would leak).
func TestParallelAssignBlankSkipsAcquire() testing.TestResult {
	var bound @Module = genFromSource(paManagedSwapSrc("a"))
	var blank @Module = genFromSource(paManagedSwapSrc("_"))
	var fbnd @Func = funcByName(bound, "foo")
	var fblk @Func = funcByName(blank, "foo")
	if fbnd == nil || fblk == nil { return fail("foo not found") }
	if countOpInFunc(fbnd, OP_REFINC) <= countOpInFunc(fblk, OP_REFINC) {
		return fail("a blank parallel-assign target must not be acquired")
	}
	return ""
}

// A managed-struct VALUE swap moves each acquired copy into its slot through
// the type's generated copy/destroy helpers: phase 1 acquires via `__copy_`
// (RefInc the fields), phase 2 releases the overwritten occupant via
// `__dtor_`.  Their presence pins the save-copy-destroy move path (a plain
// store would emit neither, leaking/UAF-ing the managed field).
func TestParallelAssignStructSwapCopiesAndDtors() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Inner struct { V int }\n")
	cb.Write("type Holder struct { Obj @Inner }\n")
	cb.Write("func foo(a Holder, b Holder) {\n")
	cb.Write("\ta, b = b, a\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = funcByName(m, "foo")
	if fn == nil { return fail("foo not found") }
	if !hasCallTo(fn, "__copy_") {
		return fail("managed-struct swap must acquire via __copy_")
	}
	if !hasCallTo(fn, "__dtor_") {
		return fail("managed-struct swap must release old via __dtor_")
	}
	return ""
}
