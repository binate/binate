package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Binary-expression lowering + integer-width handling
// ============================================================

// genBinary generates IR for a binary expression, with short-circuit for && and ||.
func genBinary(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Phase A4 of plan-ir-gen-typed-literals.md: if the type
	// checker folded this binop to a literal value (foldIntArith
	// / foldIntBitwise wrote HasLitVal on the result type), emit
	// a single OP_CONST_INT for the folded value and skip the
	// binop IR.  Folds through typed-const operand references
	// too — pkg/binate/types now stores HasLitVal/LitMag/LitSign on
	// iota'd const symbols, so `keyword_start + 1` folds to the
	// correct iota + 1 rather than the literal-1 value
	// commonType used to inherit.
	//
	// Mirrors genExprInner's `ctx.CurBlock = b` pre-amble so
	// callers landing `b = ctx.CurBlock` after the call see the
	// same block they passed in.
	if ctx.Checker != nil && e.ResolvedTypeID != 0 {
		var t @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
		if t != nil && t.HasLitVal && t.Kind == types.TYP_UNTYPED_INT {
			ctx.CurBlock = b
			var v int64 = bignumToInt(t.LitMag, t.LitSign)
			if v < -2147483648 || v > 2147483647 {
				return b.EmitConstInt64(v, types.TypInt64())
			}
			return b.EmitConstInt64(v, types.TypUntypedInt())
		}
	}

	var op int = tokenToOp(e.Op)

	// Short-circuit evaluation for && and ||
	if op == iropcode.OP_LAND {
		return genShortCircuitAnd(ctx, b, e)
	}
	if op == iropcode.OP_LOR {
		return genShortCircuitOr(ctx, b, e)
	}

	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	// Phase B of plan-ir-gen-typed-literals.md: when one operand
	// is a typed integer and the other is an integer literal,
	// emit the literal directly at the typed operand's type so
	// the binop result stays in that type (instead of widening
	// up to int64 via the literal's magnitude-promoted TypInt64).
	// This is what flips `x & 0xFFFFFFFF` (x: uint32) from a
	// uint32-widened-to-int64 binop into a clean uint32 binop —
	// the original ror32-mask bug from claude-todo.md.
	var rhs @Instr = genIntLitWithHint(ctx, b, e.Y, lhs.Typ)
	if rhs == nil {
		rhs = genExpr(ctx, b, e.Y)
	}
	b = ctx.CurBlock
	// Symmetric: if the RHS we got was a typed int and the LHS
	// was an untyped literal we've already generated, redo the
	// LHS with the RHS's type as the hint.  The double-pass is
	// regrettable; the cleaner shape would pass hints through
	// genExpr itself, but that's a wider refactor.
	if e.X != nil && e.X.Kind == ast.EXPR_INT_LIT && lhs.Typ != nil &&
			(lhs.Typ.Kind == types.TYP_UNTYPED_INT || lhs.Typ == types.TypInt64()) {
		var narrowed @Instr = genIntLitWithHint(ctx, b, e.X, rhs.Typ)
		if narrowed != nil {
			lhs = narrowed
		}
	}

	// A comparison whose operand the checker should have rejected must never reach
	// the scalar compare below: for `==`/`!=`, a slice / interface value / function
	// value (no primitive equality); for a relational op, any non-numeric operand
	// (no defined order).  Reaching IR-gen means one slipped past the checker — the
	// generic type-param comparison inference gap (an imported, forward-referenced,
	// or transitively-reached generic body is not re-checked, so e.g.
	// `Box[*[]int]`'s `b.v == o.v` or `less[SomeStruct]` arrives here).  On LLVM
	// clang rejects the resulting `icmp` on a non-integer operand; the VM would
	// SILENTLY emit a garbage compare.  Fail loud and backend-neutral instead.
	if op >= iropcode.OP_EQ && op <= iropcode.OP_GE {
		assertComparableScalarCompare(op, lhs, rhs)
	}

	// Aggregate equality (struct / array == / !=): compared field/element-wise
	// (gen_eq_aggregate.bn), NOT via the scalar widen-then-single-compare path
	// below — which is meaningless, and would emit an invalid aggregate-operand
	// compare, for a struct / array operand.  The checker has already verified
	// the operand type is transitively comparable.  Operands are mutually
	// assignable, so lhs.Typ classifies the pair.
	if op == iropcode.OP_EQ || op == iropcode.OP_NE {
		var aggTyp @types.Type = aggregateEqType(lhs.Typ)
		if aggTyp != nil {
			return genAggregateEq(ctx, b, op, lhs, rhs, aggTyp)
		}
	}

	// Determine the wider type for mixed-width arithmetic (e.g., char + int)
	var resultTyp @types.Type = widenType(lhs.Typ, rhs.Typ)
	// A shift is asymmetric: the result type is the LEFT (value) operand's
	// type, NOT the symmetric widenType.  The count may be any integer type
	// and must not influence the result type — widenType would pick the
	// count's type for a value narrower than the count (`int64 << int` ->
	// int in 32-bit-int modes, silently truncating the int64) or for a wider
	// count.  The count is reconciled to the value width by the ensureWidth
	// below (a count wider than the value is truncated to it).
	if op == iropcode.OP_SHL || op == iropcode.OP_SHR {
		resultTyp = lhs.Typ
		// A genuinely-NEGATIVE untyped-int const value operand must shift as
		// SIGNED (`>>` -> ashr), but its untyped-int type reads UNSIGNED, so
		// the shift lowering (gen_shift.bn keys ashr/lshr off resultTyp's
		// Signed flag) would emit lshr of the two's-complement bit pattern —
		// a silent wrong value (`(0 - 16) >> n` computes (2^64-16) >> n, not
		// -4).  Recover the GENUINE value sign from the checker's folded-
		// literal metadata (LitSign on the value operand's resolved type) —
		// NOT lhs.IntVal, which can't tell a negative const from a positive
		// one >= 2^63 — and retag resultTyp to signed int so ashr is chosen.
		// A positive untyped const (LitSign false, incl. a legitimate >= 2^63
		// operand) keeps untyped/lshr, which is correct.
		if resultTyp != nil && resultTyp.Kind == types.TYP_UNTYPED_INT && ctx.Checker != nil &&
				e.X != nil && e.X.ResolvedTypeID != 0 {
			var lt @types.Type = ctx.Checker.ExprType(e.X.ResolvedTypeID)
			if lt != nil && lt.HasLitVal && lt.LitSign {
				resultTyp = types.TypInt()
			}
		}
	}
	// Give an untyped-int CONST operand its reconciled concrete type BEFORE the
	// ensureWidth widening below — not after.  Two reasons:
	//   1. Width (arm32 / any 32-bit-int target): widening an untyped operand
	//      via a cast first materializes it at its untyped (target-int) width
	//      and ZERO-extends, dropping the high word of a NEGATIVE value
	//      (`int64 == 0 - 42` was wrongly false — the const-expr lost its sign
	//      bits).  Retagged in place, the full-width constant is emitted
	//      directly, so no cast and no zero-extension occur.
	//   2. Signedness (every target): ensureWidth leaves an equal-width untyped
	//      operand UNCHANGED (still unsigned), so a relational op read it
	//      unsigned (`4096 < xe` against a negative `xe`).
	// Untyped operands are always freshly-emitted constants, so retagging in
	// place is safe; and the shift-overshift predicates below read a runtime
	// (typed, non-untyped) count in its own type, which this does not disturb.
	if resultTyp != nil && resultTyp.IsInteger() {
		if lhs.Typ != nil && lhs.Typ.Kind == types.TYP_UNTYPED_INT {
			lhs.Typ = resultTyp
		}
		if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_UNTYPED_INT {
			rhs.Typ = resultTyp
		}
	}
	lhs = ensureWidth(ctx, b, lhs, resultTyp)
	// A constant shift count >= the value width must be caught BEFORE the
	// ensureWidth below truncates it into range (where the post-truncation
	// guard would miss it) — see emitConstOvershiftOrNil.  No-op for non-shift
	// ops and for an in-range / non-constant count.
	var constOvershift @Instr = emitConstOvershiftOrNil(b, op, lhs, rhs, resultTyp)
	if constOvershift != nil {
		return constOvershift
	}
	// A RUNTIME shift count needs its overshift predicate (count < width)
	// computed from its ORIGINAL value, BEFORE the ensureWidth below truncates
	// a count of a type WIDER than the value into the value width — that
	// truncation discards the high bits that reveal an overshift (a uint16
	// count of 261 would otherwise read as its 8-bit residue 5 and shift a
	// uint8 by 5 instead of yielding 0).  The predicate reads the count in its
	// OWN type, so its magnitude and signedness are honored.  nil unless this
	// is an integer shift with a non-safe-constant count.
	var shiftInrange @Instr = emitShiftInrangeOrNil(b, op, rhs, resultTyp)
	// A signed runtime count may be negative; a shift count must be
	// non-negative, so guard it with a runtime panic (the original count,
	// before the ensureWidth below, so a negative wider count isn't truncated
	// to a non-negative residue first).
	emitShiftCheckGuard(b, op, rhs, shiftInrange)
	rhs = ensureWidth(ctx, b, rhs, resultTyp)

	// Comparison ops return bool
	if op >= iropcode.OP_EQ {
		if op <= iropcode.OP_GE {
			return b.EmitBinop(op, lhs, rhs, types.TypBool())
		}
	}

	// Integer shift by a count >= the operand width must yield the spec'd
	// value (0 for a logical shift, sign-fill for arithmetic >>), not the
	// hardware-masked result. An in-range constant count can't overshift, so it
	// lowers to a plain shift; anything else gets the guard, using the
	// pre-truncation overshift predicate computed above.
	if op == iropcode.OP_SHL || op == iropcode.OP_SHR {
		if shiftInrange != nil {
			return emitGuardedShift(b, op, lhs, rhs, resultTyp, shiftInrange)
		}
	}

	// Integer divide / remainder: guard against the divide-by-zero and
	// signed MIN/-1 faults with an OP_DIV_CHECK before the divide.  Float
	// `/` is IEEE (no panic); `unsafe_div` / `unsafe_rem` lower without
	// this guard.  Shared with the compound-assignment path so `a / b`
	// and `a /= b` are guarded identically.
	emitDivCheckGuard(b, op, lhs, rhs, resultTyp)

	return b.EmitBinop(op, lhs, rhs, resultTyp)
}

// assertComparableScalarCompare panics if a scalar comparison is about to be
// emitted on an operand the checker should have rejected.  For `==` / `!=`
// (op OP_EQ / OP_NE): a slice, interface value, or function value has no primitive
// equality (comparable structs / arrays fork to genAggregateEq before reaching
// here; its leaves are guarded in emitFieldEq).  For a relational op
// (OP_LT..OP_GE): only numeric operands have a defined order, so ANY non-numeric
// operand is rejected — this includes structs / arrays, which the eq-only
// genAggregateEq fork does NOT catch for `<`/`>`/…, plus pointers and bools.  A
// firing means a comparison slipped past the checker (the generic type-param
// comparison inference gap); the alternative is a backend miscompile (LLVM emits
// an invalid `icmp`; the VM silently emits a garbage compare).  A nil operand is
// exempt: a nil-comparison is judged by the OTHER operand (the checker's nil rule),
// and internal `x == nil` presence checks must keep working.
func assertComparableScalarCompare(op int, lhs @Instr, rhs @Instr) {
	if lhs == nil || rhs == nil || lhs.Typ == nil || rhs.Typ == nil {
		return
	}
	if isNilTypedInstr(lhs) || isNilTypedInstr(rhs) {
		return
	}
	if op == iropcode.OP_EQ || op == iropcode.OP_NE {
		if isNonComparableAggregate(lhs.Typ) || isNonComparableAggregate(rhs.Typ) {
			panic(
					"internal error: an == / != reached IR-gen with a slice, "
							"interface-value, or function-value operand -- these have no "
							"primitive equality, so the checker should have rejected it.  A "
							"generic type-param comparison slipped past the instantiation "
							"re-check (imported / forward-referenced / transitively-reached "
							"generic body) -- see gen_binary.bn")
		}
		return
	}
	if !lhs.Typ.IsNumeric() || !rhs.Typ.IsNumeric() {
		panic(
				"internal error: a relational op (< / > / <= / >=) reached IR-gen "
						"with a non-numeric operand (pointer / bool / slice / interface / "
						"function / struct / array) -- ordering is defined only for numeric "
						"operands, so the checker should have rejected it.  A generic "
						"type-param comparison slipped past the instantiation re-check -- "
						"see gen_binary.bn")
	}
}

// isNonComparableAggregate reports whether a comparison on an operand of type t
// would compare a value with no primitive equality/order: a raw or managed slice,
// an interface value, or a function value.  Peels named / readonly / alias
// wrappers to the comparability-determining kind.  Pointers and structs/arrays are
// NOT included (pointers compare by address; comparable aggregates lower
// field/element-wise via genAggregateEq).
func isNonComparableAggregate(t @types.Type) bool {
	var p @types.Type = peelToUnderlying(t)
	if p == nil {
		return false
	}
	var k int = p.Kind
	return k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_INTERFACE_VALUE ||
			k == types.TYP_INTERFACE_VALUE_MANAGED || k == types.TYP_FUNC_VALUE ||
			k == types.TYP_MANAGED_FUNC_VALUE
}

// isNilTypedInstr reports whether x is the nil literal (TYP_NIL).
func isNilTypedInstr(x @Instr) bool {
	return x != nil && x.Typ != nil && x.Typ.Kind == types.TYP_NIL
}

// emitDivCheckGuard emits an OP_DIV_CHECK before an integer OP_DIV /
// OP_REM (the divisor analogue of the bounds check); a no-op for any
// other op or a non-integer result.  Operands are widened to 64-bit so
// the guard sees uniform operands on every target.  Shared by the
// binary-expression and compound-assignment lowering so `a / b` and
// `a /= b` are guarded identically.
//
// resultTyp is whatever widenType produced — a plain int, a sized int,
// or a named distinct type wrapping one.  typeWidth and typeIsSigned
// both peel TYP_NAMED, so the guard sees the true width and signedness
// (a bare TYP_NAMED reads `.Signed` false, which would mis-guard a
// named *signed* sub-word's MIN/-1 overflow as unsigned).
func emitDivCheckGuard(b @Block, op int, lhs @Instr, rhs @Instr, resultTyp @types.Type) {
	if op != iropcode.OP_DIV && op != iropcode.OP_REM {
		return
	}
	if resultTyp == nil || !resultTyp.IsInteger() {
		return
	}
	var dividend @Instr = ensureInt64ForCheck(b, lhs)
	var divisor @Instr = ensureInt64ForCheck(b, rhs)
	b.EmitDivCheck(dividend, divisor, typeWidth(resultTyp), typeIsSigned(resultTyp))
}

// ensureInt64ForCheck widens a divide operand to 64-bit (sext for a
// signed source, zext for unsigned, per EmitCast's signedness rule) so
// the divide-fault guard receives uniform 64-bit operands on every
// target.  A no-op when the operand is already 64-bit (int on a 64-bit
// target, or int64), so the common case adds no cast.
func ensureInt64ForCheck(b @Block, val @Instr) @Instr {
	if typeWidth(val.Typ) >= 64 {
		return val
	}
	return b.EmitCast(val, types.TypInt64())
}

// genShortCircuitAnd implements short-circuit evaluation for a && b:
// Allocates a result bool (default false), evaluates LHS. If LHS is true,
// evaluates RHS and stores result. Otherwise skips RHS (result stays false).
func genShortCircuitAnd(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Alloca for result in current block, default false
	var resultPtr @Instr = b.EmitAlloc(types.TypBool())
	b.EmitStore(resultPtr, b.EmitConstBool(false))

	// Evaluate LHS — clean up any managed temps before branching
	var savedTemps int = len(ctx.Temps)
	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock // LHS might have changed block (nested short-circuit)
	b = emitTempCleanupSince(ctx, b, savedTemps)

	// Create RHS and merge blocks
	var rhsBlk @Block = AddBlock(ctx.Func, "land.rhs")
	var mergeBlk @Block = AddBlock(ctx.Func, "land.merge")

	// Branch: if LHS true → evaluate RHS, else → merge (result is false)
	b.EmitBranch(lhs, rhsBlk, mergeBlk)

	// RHS block: evaluate RHS, clean up temps, store to result, jump to merge
	var savedTemps2 int = len(ctx.Temps)
	var rhs @Instr = genExpr(ctx, rhsBlk, e.Y)
	rhsBlk = ctx.CurBlock // RHS might have changed block
	rhsBlk = emitTempCleanupSince(ctx, rhsBlk, savedTemps2)
	rhsBlk.EmitStore(resultPtr, rhs)
	rhsBlk.EmitJump(mergeBlk)

	// Merge block: load result
	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(resultPtr, types.TypBool())
}

// genShortCircuitOr implements short-circuit evaluation for a || b:
// Allocates a result bool (default true), evaluates LHS. If LHS is false,
// evaluates RHS and stores result. Otherwise skips RHS (result stays true).
func genShortCircuitOr(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Alloca for result in current block, default true
	var resultPtr @Instr = b.EmitAlloc(types.TypBool())
	b.EmitStore(resultPtr, b.EmitConstBool(true))

	// Evaluate LHS — clean up any managed temps before branching
	var savedTemps int = len(ctx.Temps)
	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	b = emitTempCleanupSince(ctx, b, savedTemps)

	// Create RHS and merge blocks
	var rhsBlk @Block = AddBlock(ctx.Func, "lor.rhs")
	var mergeBlk @Block = AddBlock(ctx.Func, "lor.merge")

	// Branch: if LHS true → merge (result is true), else → evaluate RHS
	b.EmitBranch(lhs, mergeBlk, rhsBlk)

	// RHS block: evaluate RHS, clean up temps, store to result, jump to merge
	var savedTemps2 int = len(ctx.Temps)
	var rhs @Instr = genExpr(ctx, rhsBlk, e.Y)
	rhsBlk = ctx.CurBlock
	rhsBlk = emitTempCleanupSince(ctx, rhsBlk, savedTemps2)
	rhsBlk.EmitStore(resultPtr, rhs)
	rhsBlk.EmitJump(mergeBlk)

	// Merge block: load result
	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(resultPtr, types.TypBool())
}

// widenType returns the wider of two integer types (or int as default)
func widenType(a @types.Type, b @types.Type) @types.Type {
	// If both are bool, keep bool
	if a != nil && a.Kind == types.TYP_BOOL && b != nil && b.Kind == types.TYP_BOOL {
		return types.TypBool()
	}
	// Floats: any pair involving a float resolves to a FLOAT type, and must
	// never fall through to the integer-width logic below — which has no float
	// case and returns TypInt() for e.g. (untyped-float, float32), turning a
	// float add/mul into an INTEGER add with fptosi operand coercions (the
	// float32-arithmetic miscompile: `sum + d` where sum is untyped-float(double)
	// and d is float32 lowered to `fptosi d; add i64`).  A CONCRETE typed float
	// wins — plain float32/float64 OR a named type whose underlying is float
	// (`type Temp float32`) — and an untyped literal peer coerces to it (this is
	// also what keeps `a * 1000.0` at float32 rather than promoting a to double).
	// IsFloat() peels named types, so exclude the untyped-float kind here so an
	// untyped float doesn't "win"; two untyped floats then default to
	// untyped-float.  (Testing bare Kind==TYP_FLOAT instead would miss a named
	// float, leaving `Temp op 2.0` computed in double — the wrong value once it
	// round-trips through the float32 storage.)  Mirrors the checker's commonType.
	// The checker has already rejected genuinely-mismatched pairs (int+float,
	// float32+float64), so the pairs reaching here are float+sameFloat,
	// float+untyped, or untyped-float+untyped.
	if a != nil && a.IsFloat() && a.Kind != types.TYP_UNTYPED_FLOAT { return a }
	if b != nil && b.IsFloat() && b.Kind != types.TYP_UNTYPED_FLOAT { return b }
	if (a != nil && a.Kind == types.TYP_UNTYPED_FLOAT) ||
			(b != nil && b.Kind == types.TYP_UNTYPED_FLOAT) {
		return types.TypUntypedFloat()
	}
	// Untyped int adopts the other operand's type.
	// If both are untyped, default to int.
	var aUntyped bool = a != nil && a.Kind == types.TYP_UNTYPED_INT
	var bUntyped bool = b != nil && b.Kind == types.TYP_UNTYPED_INT
	if aUntyped && bUntyped {
		return types.TypUntypedInt()
	}
	if aUntyped && b != nil && b.IsInteger() {
		return b
	}
	if bUntyped && a != nil && a.IsInteger() {
		return a
	}
	var aw int = typeWidth(a)
	var bw int = typeWidth(b)
	if aw >= bw {
		if a != nil && a.Kind == types.TYP_INT { return a }
		if aw == bw && a != nil { return a }
		return types.TypInt()
	}
	if b != nil && b.Kind == types.TYP_INT { return b }
	if b != nil { return b }
	return types.TypInt()
}

// typeWidth returns the bit width of a type for IR-level width
// comparisons.  Must agree with codegen's llvmType for the same
// type — under --target arm32-linux or arm32-baremetal,
// `int` and untyped-int both lower to i32 (4 bytes), so they must
// report 32 here.  Earlier the fallback for nil / Width=0 was a
// hardcoded 64, which silently dropped ensureWidth casts when an
// untyped-int operand met a 32-bit `int` on arm32 — the resulting
// IR then had two operands of mismatched LLVM widths.
func typeWidth(t @types.Type) int {
	var targetIntBits int = types.GetTarget().IntSize * 8
	if t == nil { return targetIntBits }
	if t.Kind == types.TYP_NAMED && t.Underlying != nil { return typeWidth(t.Underlying) }
	if t.Kind == types.TYP_BOOL || t.Kind == types.TYP_UNTYPED_BOOL { return 1 }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT {
		if t.Width > 0 { return t.Width }
		return 64
	}
	if t.Width > 0 { return t.Width }
	return targetIntBits
}

// ensureWidth casts val to targetTyp if their widths differ
func ensureWidth(ctx @GenContext, b @Block, val @Instr, targetTyp @types.Type) @Instr {
	var valW int = typeWidth(val.Typ)
	var targetW int = typeWidth(targetTyp)
	if valW == targetW { return val }
	return b.EmitCast(val, targetTyp)
}

// coerceScalarWidth narrows an UNTYPED scalar literal value to a typed
// integer-or-float target by width (via ensureWidth).  It is a no-op for
// an already-typed or non-scalar value, so it is safe to apply at any
// scalar pass/store/return site without disturbing slices, structs,
// interface/function values, nil, or already-typed expressions.
//
// Shared by the call-arg, composite-field, and return positions so an
// untyped-float(64) literal lands at a float32 slot's width — emitted as
// the same fptrunc the var-init path already produces (gen_stmt.bn's
// unconditional ensureWidth).  Without it those positions pass / store /
// return a 64-bit double into a 32-bit float slot, emitting invalid
// `ret float <double>` IR or a width-mismatched store.  Restricted to
// untyped literals (narrower than var-init's unconditional ensureWidth)
// so it never silently narrows a typed expression the checker accepted.
func coerceScalarWidth(ctx @GenContext, b @Block, val @Instr, targetTyp @types.Type) @Instr {
	if val == nil || val.Typ == nil || targetTyp == nil { return val }
	if val.Typ.Kind == types.TYP_UNTYPED_INT && targetTyp.IsInteger() {
		return ensureWidth(ctx, b, val, targetTyp)
	}
	if val.Typ.Kind == types.TYP_UNTYPED_FLOAT && targetTyp.IsFloat() {
		return ensureWidth(ctx, b, val, targetTyp)
	}
	return val
}
