package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// TestGenBinopFoldsTwoLiteralOperands verifies Phase A4: when both
// operands of a binop are direct integer literals, the type
// checker's bignum fold is consumed and a single OP_CONST_INT is
// emitted for the folded value — no underlying OP_MUL / OP_ADD /
// etc.  This is what makes `var c int64 = 2147483648 * 2` round-
// trip cleanly on 32-bit targets (the multiply happened in
// bignum at type-check, well before LLVM width concerns).
func TestGenBinopFoldsTwoLiteralOperands() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var c int64 = 2147483648 * 2; _ = c }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFold @Instr = nil
	var foundMul bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 4294967296 {
			foundFold = ins
		}
		if ins.Op == iropcode.OP_MUL { foundMul = true }
	}
	if foundFold == nil {
		return fail("expected iropcode.OP_CONST_INT for folded value 4294967296")
	}
	if foundMul {
		return fail("iropcode.OP_MUL should be elided when both operands fold")
	}
	return ""
}

// TestGenBinopLiteralLhsAdoptsRhsType verifies the symmetric Phase
// B case: when the LHS is a literal and the RHS is typed (e.g.
// `0xFFFFFFFF & x` where x : uint32), the literal still lands at
// the typed operand's type.
func TestGenBinopLiteralLhsAdoptsRhsType() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint32 = 1; _ = 0xFFFFFFFF & x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundLit @Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 4294967295 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil { return fail("no iropcode.OP_CONST_INT for 0xFFFFFFFF") }
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_INT || foundLit.Typ.Width != 32 ||
			foundLit.Typ.Signed {
		return fail("0xFFFFFFFF as LHS of uint32 binop should land at uint32")
	}
	return ""
}

func TestGenArithmetic() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() { _ = 2 + 3 }\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @Block = m.Funcs[0].Blocks[0]
	// `_ = 2 + 3` should emit const 2, const 3, and an OP_ADD; we
	// only assert the add fires (the discard's exact shape is
	// incidental).
	var foundAdd bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_ADD { foundAdd = true }
	}
	if !foundAdd { return fail("no add instruction found") }
	return ""
}

// --- Integer divide-fault guard (OP_DIV_CHECK) ---

// firstOp returns the first instruction in fn with the given op, or
// nil if none.
func firstOp(fn @Func, op int) @Instr {
	for i := 0; i < len(fn.Blocks); i++ {
		var b @Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op { return b.Instrs[j] }
		}
	}
	return nil
}

// A non-constant integer divide emits an OP_DIV_CHECK guard before the
// divide, with signedness on BoolVal and the resolved operand width on
// IntVal (signed int → BoolVal true, positive width).
func TestIntDivideEmitsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc d(a int, b int) int { return a / b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) < 1 {
		return fail("a / b should emit iropcode.OP_DIV_CHECK")
	}
	var dc @Instr = firstOp(m.Funcs[0], iropcode.OP_DIV_CHECK)
	if dc == nil { return fail("no iropcode.OP_DIV_CHECK instr") }
	if !dc.BoolVal { return fail("signed divide → BoolVal true") }
	if dc.IntVal <= cast(int64, 0) { return fail("width should be positive") }
	return ""
}

// Remainder shares the guard.
func TestIntRemainderEmitsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc r(a int, b int) int { return a % b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) < 1 {
		return fail("a % b should emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// An unsigned divide guards with BoolVal false and the narrow width, so
// the backend skips the signed MIN/-1 check.
func TestUnsignedDivideDivCheckIsUnsigned() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc d(a uint32, b uint32) uint32 { return a / b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var dc @Instr = firstOp(m.Funcs[0], iropcode.OP_DIV_CHECK)
	if dc == nil { return fail("uint32 divide should emit iropcode.OP_DIV_CHECK") }
	if dc.BoolVal { return fail("unsigned divide → BoolVal false") }
	if dc.IntVal != cast(int64, 32) { return fail("uint32 width should be 32") }
	return ""
}

// Float `/` is IEEE (yields ±Inf/NaN, no panic) — no guard.
func TestFloatDivideSkipsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc d(a float64, b float64) float64 { return a / b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("float divide must not emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// unsafe_div is the guard-free opt-out: it emits OP_DIV but NO
// OP_DIV_CHECK.
func TestUnsafeDivSkipsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc d(a int, b int) int { return unsafe_div(a, b) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV) < 1 {
		return fail("unsafe_div should emit iropcode.OP_DIV")
	}
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("unsafe_div must NOT emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// unsafe_rem likewise emits OP_REM with no guard.
func TestUnsafeRemSkipsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc r(a int, b int) int { return unsafe_rem(a, b) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_REM) < 1 {
		return fail("unsafe_rem should emit iropcode.OP_REM")
	}
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("unsafe_rem must NOT emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// Compound divide-assignment `a /= b` must be guarded exactly like
// `a = a / b` — the guard lives in the shared emitDivCheckGuard, called
// from both the binary-expr and compound-assign lowering.
func TestCompoundDivAssignEmitsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc d(a int, b int) int { a /= b; return a }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) < 1 {
		return fail("a /= b should emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// `a %= b` likewise.
func TestCompoundRemAssignEmitsDivCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc r(a int, b int) int { a %= b; return a }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) < 1 {
		return fail("a %= b should emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// A divide on a NAMED distinct integer type is still guarded, so a
// runtime zero divisor is caught.  widenType returns the named operand
// type (it is NOT collapsed to plain int), and the divide guard reads its
// true width + signedness via typeWidth / typeIsSigned (which peel
// TYP_NAMED) — so a named sub-word signed MIN/-1 divide is correctly
// trapped too (see TestWidenTypePreservesNamedSubWordWidthAndSign).
func TestNamedTypeDivideEmitsDivCheck() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\ntype Count int\nfunc d(a Count, b Count) Count { return a / b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) < 1 {
		return fail("named-type divide should still emit iropcode.OP_DIV_CHECK")
	}
	return ""
}

// b43a0057 makes the divide-overflow guard see a named sub-word integer's
// true width and signedness via typeWidth / typeIsSigned (which peel
// TYP_NAMED).  widenType returns the named operand type for equal-width
// operands; this pins that a named int8 keeps width 8 + signed, so a
// `MIN / -1` divide is correctly guarded — it previously read width 64 /
// unsigned off the bare TYP_NAMED, letting the overflow escape.
func TestWidenTypePreservesNamedSubWordWidthAndSign() testing.TestResult {
	var i8 @types.Type = types.MakeNamedType("I8")
	i8.Underlying = types.TypInt8()
	var w @types.Type = widenType(i8, i8)
	if typeWidth(w) != 8 {
		return fail("widenType(I8,I8) must keep width 8")
	}
	if !typeIsSigned(w) {
		return fail("widenType(I8,I8) must keep signed=true")
	}
	return ""
}

// TestGenUint32MaskLiteralNarrowsToUint32 verifies that a literal
// whose value fits uint32 but not int32 (the classic 0xFFFFFFFF /
// UINT32_MAX case) takes its type from its uint32 binop partner
// when used as `x & 0xFFFFFFFF` in a uint32 context.  Before the
// Phase B binop-operand hint propagation, the literal was promoted
// to TypInt64 by the magnitude heuristic, widening the binop to
// int64 and breaking surrounding uint32-typed signatures (LLVM
// "ret i64 in i32-result function" error — bit the pkg/binate/asm/arm32
// ror32 helper).  This test now uses genFromSourceWithChecker so
// the Phase A3 path can supply the bignum value AND the binop
// can see its operand types.
func TestGenUint32MaskLiteralNarrowsToUint32() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint32 = 1; _ = x & 0xFFFFFFFF }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundLit @Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 4294967295 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil {
		return fail("no iropcode.OP_CONST_INT for 0xFFFFFFFF")
	}
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_INT || foundLit.Typ.Width != 32 ||
			foundLit.Typ.Signed {
		return fail("0xFFFFFFFF in uint32 context should land at uint32")
	}
	return ""
}

func TestGenFloatArith() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var x float64 = 1.5 + 2.5\n")
	cb.Write("  _ = x\n")
	cb.Write("}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFloatAdd bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_ADD && ins.Typ != nil &&
				(ins.Typ.Kind == types.TYP_FLOAT || ins.Typ.Kind == types.TYP_UNTYPED_FLOAT) {
			foundFloatAdd = true
		}
	}
	if !foundFloatAdd {
		return fail("no float-typed iropcode.OP_ADD found")
	}
	return ""
}

// moduleHasFloat32Cast reports whether any function's entry block emits
// an OP_CAST whose result type is float32 — the fptrunc that narrows an
// untyped-float(64) literal to single precision.  coerceScalarWidth
// emits it at the call-arg / composite-field / return positions; without
// that the double flows into the float32 slot uncast.
func moduleHasFloat32Cast(m @Module) bool {
	for i := 0; i < len(m.Funcs); i++ {
		if len(m.Funcs[i].Blocks) == 0 { continue }
		var blk @Block = m.Funcs[i].Blocks[0]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CAST && ins.Typ != nil && ins.Typ.Kind == types.TYP_FLOAT &&
					ins.Typ.Width == 32 {
				return true
			}
		}
	}
	return false
}

// An untyped-float literal passed to a float32 PARAMETER narrows to
// single precision (coerceArg → coerceScalarWidth).
func TestCoerceArgNarrowsFloatLiteralToFloat32() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc take(x float32) {}\nfunc main() { take(0.5) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if !moduleHasFloat32Cast(m) {
		return fail("call-arg: untyped-float 0.5 should fptrunc to float32 (iropcode.OP_CAST)")
	}
	return ""
}

// An untyped-float literal stored into a float32 FIELD narrows to single
// precision (genCompositeLit → coerceScalarWidth before the field store).
func TestCompositeFieldNarrowsFloatLiteralToFloat32() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\ntype S struct { f float32 }\n"
					"func main() { var s S = S{0.5}; _ = s }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if !moduleHasFloat32Cast(m) {
		return fail("field: untyped-float 0.5 should fptrunc to float32 (iropcode.OP_CAST)")
	}
	return ""
}

// An untyped-float literal RETURNED at float32 narrows to single
// precision (genReturnStmt → coerceScalarWidth), instead of emitting an
// invalid `ret float <double>`.
func TestReturnNarrowsFloatLiteralToFloat32() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc f() float32 { return 0.5 }\n"
					"func main() { _ = f() }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if !moduleHasFloat32Cast(m) {
		return fail("return: untyped-float 0.5 should fptrunc to float32 (iropcode.OP_CAST)")
	}
	return ""
}

// isNonComparableAggregate is the IR-gen comparability guard's classifier: it
// flags the operand types that have no primitive equality/order — slices,
// interface values, function values — and passes scalars and pointers.  Pinning
// the classification keeps the panic guard (which turns the generic type-param
// comparison inference gap from a silent VM miscompile into a loud failure) from
// either missing a bad operand or false-positiving on a legitimate one.
func TestIsNonComparableAggregateClassifies() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	// No primitive equality/order → flagged.
	if !isNonComparableAggregate(types.MakeSliceType(types.TypInt())) {
		return fail("raw slice *[]int must be flagged non-comparable")
	}
	if !isNonComparableAggregate(types.MakeManagedSliceType(types.TypInt())) {
		return fail("managed slice @[]int must be flagged non-comparable")
	}
	if !isNonComparableAggregate(
			types.MakeInterfaceValueType(types.MakeInterfaceType("pkg/foo", "Reader"))) {
		return fail("interface value must be flagged non-comparable")
	}
	if !isNonComparableAggregate(types.MakeFuncValueType(noParams, noResults)) {
		return fail("function value must be flagged non-comparable")
	}
	// Scalars and pointers compare fine (by value / by address) → not flagged.
	if isNonComparableAggregate(types.TypInt()) {
		return fail("int must not be flagged")
	}
	if isNonComparableAggregate(types.TypBool()) {
		return fail("bool must not be flagged")
	}
	if isNonComparableAggregate(types.MakePointerType(types.TypInt())) {
		return fail("*int must not be flagged")
	}
	if isNonComparableAggregate(types.MakeManagedPtrType(types.TypInt())) {
		return fail("@int must not be flagged")
	}
	return ""
}
