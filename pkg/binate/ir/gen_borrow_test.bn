package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the value-borrow helpers in gen_borrow.bn (isBorrowableValueSource,
// defaultedBorrowType, borrowTempNeedsCleanup).  genBorrowSourceAddr needs a
// GenContext and is covered through the compile/conformance paths.

// isBorrowableValueSource: a genuine value (scalar) is borrowable; a pointer /
// managed pointer is not (it is boxed directly, not by taking its address).
func TestIsBorrowableValueSource() testing.TestResult {
	if !isBorrowableValueSource(types.TypInt()) {
		return "a scalar value should be borrowable"
	}
	if isBorrowableValueSource(types.MakePointerType(types.TypInt())) {
		return "*int should NOT be borrowable (boxed directly)"
	}
	if isBorrowableValueSource(types.MakeManagedPtrType(types.TypInt())) {
		return "@int should NOT be borrowable (boxed directly)"
	}
	return ""
}

// defaultedBorrowType: an untyped constant defaults to its concrete type; a
// concrete type passes through unchanged.
func TestDefaultedBorrowType() testing.TestResult {
	var d @types.Type = defaultedBorrowType(types.TypUntypedInt())
	if d == nil || d.Kind != types.TYP_INT {
		return "untyped int should default to int"
	}
	var c @types.Type = defaultedBorrowType(types.TypBool())
	if c == nil || c.Kind != types.TYP_BOOL {
		return "a concrete bool should pass through unchanged"
	}
	return ""
}

// borrowTempNeedsCleanup: a managed slice temp owns a reference (needs RefDec); a
// scalar temp is pointer-free (no cleanup).
func TestBorrowTempNeedsCleanup() testing.TestResult {
	if !borrowTempNeedsCleanup(types.MakeManagedSliceType(types.TypInt())) {
		return "@[]int temp should need cleanup"
	}
	if borrowTempNeedsCleanup(types.TypInt()) {
		return "an int temp should NOT need cleanup"
	}
	return ""
}
