package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// genFFIBuiltin lowers the foreign-function-boundary builtins that let Binate
// reach C: __c_call (call a verbatim C symbol), __c_global (the address of a C
// global), and __c_entry (the address of a C entry of a declared Binate function,
// for handing it to C as a callback).  Returns (result, true) when it handled e's
// op, else (nil, false) so genBuiltin's dispatch continues.  Split out of
// gen_builtin.bn to keep that file under the length cap; the grouping mirrors the
// checker's check_c_interop.bn.  All three are compiled-mode only — the checker
// rejects them under Interpreted, so the VM never lowers them.
func genFFIBuiltin(ctx @GenContext, b @Block, e @ast.Expr) (@Instr, bool) {
	if e.Op == cast(int, token.C_CALL) {
		// __c_call("sym", RetType, args...): a verbatim C call.  Lower each
		// argument, then emit OP_C_CALL carrying the raw symbol.  Args are
		// scalars/pointers (the type checker rejects anything needing refcount
		// handling), so no per-arg copy/RefInc here.  A nil TypeRef is the "void"
		// spelling: a nil result type, which EmitCCall lowers to an OP_C_CALL with
		// no SSA result.
		var retTyp @types.Type = nil
		if e.TypeRef != nil {
			retTyp = resolveTypeExpr(ctx.Gc, e.TypeRef)
		}
		var args @[]@Instr
		for i := 0; i < len(e.Args); i++ {
			var arg @Instr = genExpr(ctx, b, e.Args[i])
			b = ctx.CurBlock
			args = slices.Append[@Instr](args, arg)
		}
		return b.EmitCCall(e.Name, args, retTyp, e.CFixedArgs), true
	}
	if e.Op == cast(int, token.C_GLOBAL) {
		// __c_global("sym", T): the address of the external C global as a raw *T.
		// No arg-lowering (there are no value args) and no registerTemp (the result
		// is a raw pointer to foreign storage — no refcount).  The pointee type T
		// rides TypeArg; the result type is *T.
		var pointeeTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
		return b.EmitCGlobal(e.Name, pointeeTyp), true
	}
	if e.Op == cast(int, token.C_ENTRY) {
		// __c_entry(f): the address of a C entry of the declared function f as a raw
		// *uint8 (spec §16.9 pkg.centry).  The operand is a function-reference
		// expression (Ident or pkg-qualified Selector) the checker already validated
		// (pkg.centry.eligible); extract its name — the same shape as RAW_FUNC_ADDR
		// — and emit OP_C_ENTRY, which the backends resolve to f's C entry.  No
		// arg-lowering (there is no value operand) and no registerTemp (a code
		// address borrows no managed value).
		if len(e.Args) >= 1 {
			var arg @ast.Expr = e.Args[0]
			var name @[]char
			if arg.Kind == ast.EXPR_IDENT {
				name = arg.Name
			}
			if arg.Kind == ast.EXPR_SELECTOR && arg.X != nil && arg.X.Kind == ast.EXPR_IDENT {
				name = buildQualNameHomed(ctx.Gc.Mod, arg.X.Name, arg.Name)
			}
			return b.EmitCEntry(name), true
		}
		// The checker requires exactly one function-reference argument, so this is
		// unreachable; guard against a silent EmitConstInt(0) fall-through anyway.
		panic("internal error: __c_entry reached codegen with no argument")
	}
	var none @Instr
	return none, false
}
