package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// findOpFFI returns the first instruction in m with opcode op, or nil.
func findOpFFI(m @Module, op int) @Instr {
	for fi := 0; fi < len(m.Funcs); fi++ {
		for bi := 0; bi < len(m.Funcs[fi].Blocks); bi++ {
			var blk @Block = m.Funcs[fi].Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				if blk.Instrs[ii].Op == op {
					return blk.Instrs[ii]
				}
			}
		}
	}
	return nil
}

// __c_entry(f) lowers (via genFFIBuiltin) to an OP_C_ENTRY instr carrying f's
// (qualified) name, with a raw-pointer (*uint8) result — a code address.
func TestGenFFICEntryEmitsOpCEntry() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"main\"\nfunc g(x int32) int32 { return x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	var ce @Instr = findOpFFI(m, iropcode.OP_C_ENTRY)
	if ce == nil {
		return fail("__c_entry should lower to OP_C_ENTRY")
	}
	if ce.Typ == nil || ce.Typ.Kind != types.TYP_POINTER {
		return fail("OP_C_ENTRY result must be a raw pointer (*uint8)")
	}
	if len(ce.StrVal) == 0 {
		return fail("OP_C_ENTRY must carry the function name on StrVal")
	}
	return ""
}

// __c_call lowers (via the same genFFIBuiltin helper) to OP_C_CALL — the sibling
// FFI builtin, confirming the shared dispatch routes each op correctly.
func TestGenFFICCallEmitsOpCCall() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"main\"\n"
					"func f() int32 { return __c_call(\"abs\", int32, cast(int32, -1)) }\n")
	if findOpFFI(m, iropcode.OP_C_CALL) == nil {
		return fail("__c_call should lower to OP_C_CALL")
	}
	return ""
}
