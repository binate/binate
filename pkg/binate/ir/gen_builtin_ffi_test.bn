package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// findOpFFI returns the first instruction in m with opcode op, or nil.
func findOpFFI(m @Module, op int) @Instr {
	for fi := 0; fi < len(m.Funcs); fi++ {
		for bi := 0; bi < len(m.Funcs[fi].Blocks); bi++ {
			var blk @Block = m.Funcs[fi].Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				if blk.Instrs[ii].Op == op {
					return blk.Instrs[ii]
				}
			}
		}
	}
	return nil
}

// __c_entry(f) lowers (via genFFIBuiltin) to an OP_C_ENTRY instr carrying f's
// (qualified) name, with a raw-pointer (*uint8) result — a code address.
func TestGenFFICEntryEmitsOpCEntry() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"main\"\nfunc g(x int32) int32 { return x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	var ce @Instr = findOpFFI(m, iropcode.OP_C_ENTRY)
	if ce == nil {
		return fail("__c_entry should lower to OP_C_ENTRY")
	}
	if ce.Typ == nil || ce.Typ.Kind != types.TYP_POINTER {
		return fail("OP_C_ENTRY result must be a raw pointer (*uint8)")
	}
	if len(ce.StrVal) == 0 {
		return fail("OP_C_ENTRY must carry the function name on StrVal")
	}
	return ""
}

// __c_call lowers (via the same genFFIBuiltin helper) to OP_C_CALL — the sibling
// FFI builtin, confirming the shared dispatch routes each op correctly.
func TestGenFFICCallEmitsOpCCall() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"main\"\n"
					"func f() int32 { return __c_call(\"abs\", int32, cast(int32, -1)) }\n")
	if findOpFFI(m, iropcode.OP_C_CALL) == nil {
		return fail("__c_call should lower to OP_C_CALL")
	}
	return ""
}

// ============================================================
// __c_call argument ownership discipline
// ============================================================
//
// A __c_call argument is marshaled through the SAME coerceArg path a regular
// Binate call uses, so it carries the ordinary parameter-ownership contract
// (§18.5 mem.param): a by-value struct with managed fields is COPIED (the copy
// RefIncs the managed fields, via a `__copy_<T>` call) so the C callee owns a
// distinct reference it must RefDec by hand; a plain (no-managed-field) struct is
// merely loaded to a value with no copy/refcount traffic.  These check the IR
// shape of that discipline (the end-to-end value/layout correctness lives in
// e2e/c-call-aggregate-args.sh).

// ccallFunc returns the first module function that contains an OP_C_CALL, or a
// nil @Func if none does.
func ccallFunc(m @Module) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if countOp(m.Funcs[i], iropcode.OP_C_CALL) > 0 {
			return m.Funcs[i]
		}
	}
	var none @Func
	return none
}

// ffiSubstr reports whether needle occurs in hay (byte-exact).  A tiny local
// helper so the ownership check can look for a `__copy_` call target without a
// cross-package string dependency.
func ffiSubstr(hay *[]readonly char, needle *[]readonly char) bool {
	if len(needle) == 0 { return true }
	for i := 0; i + len(needle) <= len(hay); i++ {
		var ok bool = true
		for j := 0; j < len(needle); j++ {
			if hay[i + j] != needle[j] { ok = false }
		}
		if ok { return true }
	}
	return false
}

// ffiHasCopyCall reports whether fn contains a call to a `__copy_<T>` helper —
// the signal that an argument was copied (its managed fields RefInc'd) before
// the call.
func ffiHasCopyCall(fn @Func) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && ffiSubstr(ins.StrVal, "__copy") {
				return true
			}
		}
	}
	return false
}

// A struct-by-value __c_call argument WITH a managed field is copied: coerceArg
// emits a `__copy_<T>` call that RefIncs the managed field, delivering the C
// callee its own reference (which C must RefDec by hand, per mem.param).  Without
// the copy the callee's eventual release would drop the caller's reference.
func TestCCallStructManagedFieldArgCopies() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"type Inner struct { x int }\n"
					"type S struct { p @Inner }\n"
					"func f(s S) { __c_call(\"g\", \"void\", s) }\n")
	var fn @Func = ccallFunc(m)
	if fn == nil { return fail("no function with an OP_C_CALL was generated") }
	if !ffiHasCopyCall(fn) {
		return fail(
				"a struct-with-managed-field __c_call arg must emit a __copy_<T> "
						"call (copy + RefInc delivery), so C owns a reference to RefDec")
	}
	return ""
}

// A PLAIN struct-by-value __c_call argument (no managed field) is passed with no
// copy and no refcount traffic — just an aggregate load to a value.  A spurious
// __copy_ call here would be churn the mem.param contract does not call for.
func TestCCallPlainStructArgNoCopy() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"type P struct { x int; y int }\n"
					"func f(p P) { __c_call(\"g\", \"void\", p) }\n")
	var fn @Func = ccallFunc(m)
	if fn == nil { return fail("no function with an OP_C_CALL was generated") }
	if countOp(fn, iropcode.OP_C_CALL) != 1 {
		return fail("expected exactly one OP_C_CALL")
	}
	if ffiHasCopyCall(fn) {
		return fail(
				"a plain (no-managed-field) struct __c_call arg must NOT be "
						"copied — it is passed by value with no refcount traffic")
	}
	return ""
}
