package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the builtin-keyword expression generation in gen_builtin.bn
// (sizeof / alignof).  Shared compileToLLVM/contains/fail helpers live in the
// gen_*_test.bn files (same package).

// sizeof(T) lowers to OP_CONST_INT with T's byte size.
func TestGenSizeofInt() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var s uint = sizeof(int)\n")
	cb.Write("  _ = s\n")
	cb.Write("}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @Block = m.Funcs[0].Blocks[0]
	// Expect an OP_CONST_INT equal to the host's sizeof(int) — 8 on
	// LP64, 4 on a 32-bit host.
	var expected int64 = cast(int64, sizeof(int))
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == expected { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT sizeof(int) bytes") }
	return ""
}

// alignof(bool) = 1 (bool is 1 byte, aligned to 1).
func TestGenAlignofBool() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var a uint = alignof(bool)\n")
	cb.Write("  _ = a\n")
	cb.Write("}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @Block = m.Funcs[0].Blocks[0]
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 1 { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT 1 for alignof(bool)") }
	return ""
}

// sizeof of a raw slice = 2 words (data ptr + length).
func TestGenSizeofSlice() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var s uint = sizeof(*[]int)\n")
	cb.Write("  _ = s\n")
	cb.Write("}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @Block = m.Funcs[0].Blocks[0]
	// 2 * host pointer size = 16 on LP64, 8 on a 32-bit host.
	var expected int64 = cast(int64, 2 * cast(int, sizeof(*uint8)))
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == expected { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT 2*sizeof(ptr) for sizeof(*[]int)") }
	return ""
}
