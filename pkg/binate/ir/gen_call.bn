package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Function call lowering
// ============================================================
//
// Dispatch order (genCall):
//
//   1. print/println/panic builtins (special-cased here because
//      they don't have a regular function symbol).  Keyword builtins
//      (len, make, cast, ...) are handled in genExpr/genBuiltin and
//      never reach genCall.
//   2. Function-value call where the callee is a SELECTOR / INDEX
//      whose value is a function-value type. Must come before
//      method-call dispatch — otherwise `op.Fn(args)` would route
//      to a non-existent <Type>__<Field> method symbol.
//   3. Method call: SELECTOR with a value receiver in scope.
//   4. Function-value call where the callee is an IDENT bound to
//      a function-value-typed local.
//   5. Direct function call by name (with package qualification
//      for SELECTOR forms like `pkg.Func`).
//
// Method-call lowering lives in gen_method.bn. This file is the
// generic-call + function-value-call dispatch.

// coerceArg applies the call-argument coercions to an already-evaluated arg
// against its parameter type, returning the possibly-replaced value.  Shared
// by every call site that marshals args to a typed signature (genCall,
// genMethodCall, and interface-method dispatch) so the coercion set stays in
// one place — divergence here is what let interface dispatch silently skip
// the managed->raw conversion (and others), shifting later args.  Pure
// post-evaluation: the caller does the genExpr / genExprOrFuncRef itself, so
// each site keeps its own evaluation rule.  `paramTyp` is nil for an arg with
// no matching param (variadic tail / over-supplied) — then it's a no-op.  The
// coercions emit into `b` without splitting it, so the caller's block stays
// current.
func coerceArg(ctx @GenContext, b @Block, arg @Instr, paramTyp @types.Type) @Instr {
	if paramTyp == nil { return arg }
	// Classify the param against its PEELED representation type (named-distinct /
	// alias / readonly stripped).  isSliceType / peelReadonly see through readonly
	// but NOT named-distinct, so an un-peeled gate SKIPS the slice coercions below
	// for a named-distinct slice param (`type Str *[]readonly char`) — the checker
	// accepts the call, but the callee then reads a bare string pointer / an
	// un-narrowed managed slice as a {data,len,...} aggregate (a silent garbage
	// value).  Named-distinct is layout-transparent, so the peeled slice type
	// drives the same materialization.
	var pt @types.Type = peelTransparent(paramTyp)
	// String literal -> *[]readonly char / @[]char when the param is a slice.
	// Gating on the bare paramTyp.Kind passed the bare string-literal pointer
	// where the callee reads a {data,len,...} aggregate by address.
	if arg.Op == iropcode.OP_CONST_STRING && isSliceType(pt) {
		arg = b.EmitStringToChars(arg, pt)
		noteSPGrowingResult(ctx, arg)
	}
	// nil -> the param's slice type (zeroed BnSlice/BnManagedSlice).
	if arg.Op == iropcode.OP_CONST_NIL && isSliceType(pt) {
		arg.Typ = pt
	}
	// @[]T -> *[]T when the param is a raw slice.  The managed-slice temp stays
	// in the cleanup list — it's borrowed by the raw slice during the call and
	// RefDec'd at end of statement.
	if pt != nil && pt.Kind == types.TYP_SLICE && isManagedSliceType(arg.Typ) {
		arg = b.EmitManagedToRaw(arg)
	}
	// RefInc managed fields for a struct/array arg passed by value, so the
	// callee's scope cleanup dtor's its own parameter copy without dropping
	// the caller's.
	if needsStructCopy(paramTyp) {
		if isStructOrArrayAlloc(arg) {
			var tmpPtr @Instr = arg
			emitStructCopy(ctx.Func, b, tmpPtr, paramTyp)
			arg = b.EmitLoad(tmpPtr, arg.TypeArg)
		} else {
			var tmpSlot @Instr = b.EmitAlloc(paramTyp)
			b.EmitStore(tmpSlot, arg)
			emitStructCopy(ctx.Func, b, tmpSlot, paramTyp)
			arg = b.EmitLoad(tmpSlot, paramTyp)
		}
	} else if isAggregateAllocToLoad(arg, paramTyp) {
		// A PLAIN (no-managed-field) struct/array passed BY VALUE arrives as an
		// OP_ALLOC pointer (a composite literal `T{...}`, or a by-value aggregate
		// var/global); load the VALUE so the callee receives the aggregate, not
		// the alloca POINTER (which it would read field-by-field as garbage on
		// LLVM + native; the VM tolerates it).  No RefInc/copy — there are no
		// managed fields.  A pointer param (`f(&x)`) doesn't match
		// isAggregateAllocToLoad, so its address is still passed as-is.
		arg = b.EmitLoad(arg, arg.TypeArg)
	}
	// Move model for a managed interface-value argument: the callee param
	// carries no entry RefInc and RefDec's at scope exit, so the caller hands
	// it exactly one ref.  A fresh @Iface (a box or call result) is MOVED in
	// via consumeTemp — its ref transfers and it is NOT cleaned post-call
	// (which the bytecode VM can't do for a 2-word value on transient vm.SP).
	// A borrowed @Iface (a load) is RefInc'd so the callee's release doesn't
	// drop the caller's own reference.
	if isManagedIfaceValueType(paramTyp) && isManagedIfaceValueType(arg.Typ) {
		if isFreshManagedIfaceValue(arg) {
			consumeTemp(ctx, arg)
		} else {
			emitManagedIfaceValueRefInc(ctx.Func, b, arg)
		}
	}
	// Narrow an untyped scalar LITERAL argument to the param's width
	// (e.g. an untyped-float 0.5 passed to a float32 param fptruncs to
	// single precision).  No-op for already-typed / non-scalar args.
	arg = coerceScalarWidth(ctx, b, arg, paramTyp)
	return arg
}

// genCall generates IR for a function call, including builtins (println, print, panic).
func genCall(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Check for print/println builtins
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		if streq(e.X.Name, "println") {
			return genPrintCall(ctx, b, e, true)
		}
		if streq(e.X.Name, "print") {
			return genPrintCall(ctx, b, e, false)
		}
		if streq(e.X.Name, "panic") {
			return genPanicCall(ctx, b, e)
		}
	}

	// Generic-instantiation call (plan-generics.md Slice 4a):
	// callee is an EXPR_INSTANTIATE_OR_INDEX whose head identifier
	// resolves to a generic decl registered on gc.GenericDecls.  Route
	// to genCallInstantiate, which ensures the specialized IR func
	// exists and emits a direct call to the mangled name.  Must
	// come before the func-value-call branch below — the
	// instantiation's result is a TYP_FUNC, not a TYP_FUNC_VALUE.
	//
	// Slice 7: also recognize the package-qualified form
	// `pkg.Id[int](...)` (e.X.X is EXPR_SELECTOR), looking up the
	// generic decl in the imported package's registry slot via
	// lookupGenericDeclPkg.
	if e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X.X != nil &&
			e.X.X.Kind == ast.EXPR_IDENT {
		var gd @ast.Decl
		var defAlias @[]char
		// Inside a monomorphized body emitted for an imported package
		// (CurrentImportAlias set), a bare generic head names THAT
		// package's generic — resolve it there and propagate the alias
		// so the nested instantiation's own body resolves correctly
		// too (handles arbitrary nesting depth).
		if len(ctx.Gc.Mod.CurrentImportAlias) > 0 {
			gd = lookupGenericDeclPkg(ctx.Gc, ctx.Gc.Mod.CurrentImportAlias, e.X.X.Name)
			if gd != nil { defAlias = ctx.Gc.Mod.CurrentImportAlias }
		}
		if gd == nil {
			gd = lookupGenericDecl(ctx.Gc, e.X.X.Name)
		}
		if gd != nil {
			return genCallInstantiate(ctx, b, e, gd, defAlias)
		}
	}
	if e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X.X != nil &&
			e.X.X.Kind == ast.EXPR_SELECTOR && e.X.X.X != nil && e.X.X.X.Kind == ast.EXPR_IDENT {
		// Cross-package generic `pkg.Gen[...]`: resolve the source alias
		// `pkg` to its full path — generic decls stash under the full path
		// (a same-final-segment alias would otherwise miss / mis-resolve).
		var genPkg @[]char = homedQualifier(ctx.Gc.Mod, e.X.X.X.Name, e.X.X.Name)
		var gd @ast.Decl = lookupGenericDeclPkg(ctx.Gc, genPkg, e.X.X.Name)
		if gd != nil {
			// The body was written in `pkg`'s namespace, so pass its full
			// path as the defining package for its unqualified references.
			return genCallInstantiate(ctx, b, e, gd, genPkg)
		}
	}

	// Function-value call (struct-field / index / nested-selector form):
	// callee is a SELECTOR / INDEX whose value is of TYP_FUNC_VALUE /
	// TYP_MANAGED_FUNC_VALUE. Must check before method-call dispatch
	// so that calling a function-value-typed field doesn't get routed
	// to a non-existent <Type>__<Field> method symbol.  peelReadonly so a
	// `readonly *func` callee is still classified as a func-value call (its
	// Kind is the wrapper) rather than falling through to a direct symbol
	// call on an undefined name.
	if e.X != nil && (e.X.Kind == ast.EXPR_SELECTOR || e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX) {
		var calleeTyp @types.Type = peelReadonly(getSelectorType(ctx, e.X))
		if calleeTyp != nil &&
				(calleeTyp.Kind == types.TYP_FUNC_VALUE || calleeTyp.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			return genFuncValueCallExpr(ctx, b, e, calleeTyp)
		}
	}

	// Method call: obj.M(args). Detected when the callee is a SELECTOR
	// whose receiver is a value expression (not a package alias).
	// (Stage 5b of plan-receivers.md.) For receivers of interface-
	// value type, route to the vtable-dispatch path instead of the
	// regular named-type method-call path. Slice 2.3a-3 of plan-
	// interface-syntax-revision.md.
	if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR {
		if isMethodCallSel(ctx, e.X) {
			if isInterfaceMethodCall(ctx, e.X) {
				return genInterfaceMethodCall(ctx, b, e)
			}
			return genMethodCall(ctx, b, e)
		}
	}

	// Function-value call: callee is an Ident resolving to a local
	// variable of TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE. Emit
	// OP_CALL_FUNC_VALUE; backends dispatch mode-specifically (see
	// plan-function-values.md "VM-mode vtables — Phase 1").  peelReadonly so
	// a `readonly *func` local is dispatched as a func-value call, not a
	// direct call on an undefined symbol named after the variable.
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var localTyp @types.Type = peelReadonly(lookupVarType(ctx, e.X.Name))
		if localTyp != nil &&
				(localTyp.Kind == types.TYP_FUNC_VALUE || localTyp.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			return genFuncValueCall(ctx, b, e, localTyp)
		}
	}

	// Immediately-invoked function literal `(func(...){...})(args)`: the
	// callee is a func LITERAL, not a name.  genFuncValueCallExpr genExpr's it
	// — which lifts + emits the synthetic function and yields its func value —
	// then dispatches OP_CALL_FUNC_VALUE.  Without this the literal falls
	// through to the direct-by-name path below, which references the lifted
	// symbol (`bn_F..._`) but never emits its definition (an undefined-symbol
	// link/clang error).
	if e.X != nil && e.X.Kind == ast.EXPR_FUNC_LIT {
		var litTyp @types.Type = nil
		if ctx.Checker != nil && e.X.ResolvedTypeID != 0 {
			// peelTransparent (not just readonly): a literal resolved against a
			// named func-value hint (`type Fn @func(...)`) is TYP_NAMED, whose
			// underlying is the func-value type this dispatch keys on.
			litTyp = peelTransparent(ctx.Checker.ExprType(e.X.ResolvedTypeID))
		}
		if litTyp != nil &&
				(litTyp.Kind == types.TYP_FUNC_VALUE || litTyp.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			return genImmediateFuncLitCall(ctx, b, e, litTyp)
		}
	}

	// Function-value call whose callee is a CALL RESULT: `obj.Get()(args)` /
	// `f()(args)`, where the inner call returns a func value.  funcRefName yields
	// "" for a non-name callee, so without this it falls through to the direct-by-
	// name path and emits a direct call on a malformed empty symbol (`bn_F..._`)
	// that is never defined.  genFuncValueCallExpr genExpr's the callee (running
	// the inner call once) and dispatches the resulting func value indirectly.
	if e.X != nil && e.X.Kind == ast.EXPR_CALL && ctx.Checker != nil && e.X.ResolvedTypeID != 0 {
		var calleeTyp @types.Type = peelReadonly(ctx.Checker.ExprType(e.X.ResolvedTypeID))
		if calleeTyp != nil &&
				(calleeTyp.Kind == types.TYP_FUNC_VALUE || calleeTyp.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			return genFuncValueCallExpr(ctx, b, e, calleeTyp)
		}
	}

	// Resolve function name (qualified for package calls). For both
	// `pkg.Func` and method expressions `T.M`, funcRefName produces
	// the right qualified form — pkg.Func and <pkg>.T.M respectively.
	var name @[]char
	if e.X != nil && (e.X.Kind == ast.EXPR_IDENT || e.X.Kind == ast.EXPR_SELECTOR) {
		name = funcRefName(ctx.Gc, e.X)
	}

	var paramTypes @[]@types.Type = lookupFuncParams(ctx.Gc, name)
	// A variadic callee packs its trailing individual args into the single *[]T
	// variadic argument (func.variadic.pack), or forwards a spread operand's
	// {data,len} directly (func.variadic.spread); a non-variadic callee binds
	// positionally.  buildCallArgs handles all three.
	var args @[]@Instr = buildCallArgs(ctx, b, e.Args, paramTypes, lookupFuncIsVariadic(ctx.Gc, name),
			e.Spread)
	b = ctx.CurBlock

	// Look up return type from function signature
	var resultTyp @types.Type = types.TypInt()
	var results @[]@types.Type = lookupFuncResults(ctx.Gc, name)
	var funcFound bool = lookupFuncExists(ctx.Gc, name)
	if funcFound && len(results) == 0 {
		resultTyp = types.TypVoid()
	} else if len(results) == 1 {
		resultTyp = results[0]
	} else if len(results) > 1 {
		// Multi-return: use the callee's anonymous struct type
		var mrt @types.Type = lookupFuncMultiReturnType(ctx.Gc, name)
		if mrt != nil {
			resultTyp = mrt
		} else {
			resultTyp = makeMultiReturnStructType(results)
		}
	}
	// Compiler-internal indirect-call magics.  Two dispatch shapes:
	//   * `_call_dtor` / `_call_free_fn`: Args[0] is a function-value
	//     HANDLE POINTER (result of `_raw_func_addr(F)` /
	//     `_func_handle(F)`, or — for `_call_dtor` — the dtor handle
	//     emitManagedPtrRefDec now emits via EmitFuncHandle).  Lowers
	//     to OP_CALL_HANDLE.  Phase 4 of plan-uniform-native-fnptrs.md.
	//   * `_call_shim_scalar` / `_call_shim_aggregate`:
	//     Args[0] is a SHIM/raw-fn ADDRESS directly; the next arg is the
	//     closure-data / receiver argument; the rest are user args.  Lowers
	//     to OP_CALL_INDIRECT — pkg/binate/vm internal dispatch
	//     (dispatchExternBinding / dispatchNativeIndirect /
	//     dispatchCompiledIfaceMethod) already splits the handle into
	//     shim+data before invoking these.
	// In all cases the .bni declarations are type-checking shapes
	// only — there are no callable symbols to link against.
	if streq(name, "_call_dtor") || streq(name, "pkg/builtins/rt._call_dtor") ||
			streq(name, "_call_free_fn") || streq(name, "pkg/builtins/rt._call_free_fn") {
		assertShimHandleScalarResult(results)
		if len(args) >= 1 {
			var handle @Instr = args[0]
			var callArgs @[]@Instr = make_slice(@Instr, len(args) - 1)
			for i := 0; i < len(callArgs); i++ {
				callArgs[i] = args[i + 1]
			}
			return b.EmitCallHandle(handle, callArgs, resultTyp)
		}
	}
	if streq(name, "_call_shim_scalar") || streq(name, "pkg/builtins/rt._call_shim_scalar") ||
			streq(name, "_call_shim_scalar64") || streq(name, "pkg/builtins/rt._call_shim_scalar64") ||
			streq(name, "_call_shim_aggregate") || streq(name, "pkg/builtins/rt._call_shim_aggregate") {
		assertShimHandleScalarResult(results)
		if len(args) >= 1 {
			var fnPtr @Instr = args[0]
			var callArgs @[]@Instr = make_slice(@Instr, len(args) - 1)
			for i := 0; i < len(callArgs); i++ {
				callArgs[i] = args[i + 1]
			}
			return b.EmitCallIndirect(fnPtr, callArgs, resultTyp)
		}
	}

	var result @Instr = b.EmitCall(name, args, resultTyp)
	// Call-site cleanup pad (Plan 2): if the callee faults, the unwind pops back
	// here and RefDecs the caller's live managed set at this call before continuing
	// up.  Tagged BEFORE registerManagedCallResult so the pad excludes the
	// not-yet-produced result (which anyway reads nil on a fault).  Every call needs
	// a pad — even with nothing to clean — so the unwind can relay through this frame.
	attachFaultPad(ctx, b)
	registerManagedCallResult(ctx, result, resultTyp)
	return result
}

// assertShimHandleScalarResult guards the compiler-internal indirect-call magics
// (_call_dtor / _call_free_fn / _call_shim_scalar{,64} / _call_shim_aggregate):
// their .bni signatures return at most one value, so the resultTyp handed to
// EmitCallHandle / EmitCallIndirect is scalar or void — never a multi-return
// tuple (makeMultiReturnStructType, built only when len(results) > 1).  The
// shims/handles physically cannot multi-return, so this holds by construction;
// enforce it here rather than let a mis-shaped anonymous-tuple result reach the
// backend collect silently.  A firing means the magic's declared signature grew
// a second result (or a caller mislabeled a real multi-return call as a magic).
func assertShimHandleScalarResult(results *[]@types.Type) {
	if len(results) > 1 {
		panic(
				"internal error: a compiler-internal indirect-call magic "
						"(_call_dtor / _call_shim_*) carries a multi-return result -- these "
						"shim/handle ops are scalar/void by construction (compiler bug)")
	}
}

// genFuncValueCall lowers `f(args)` where f is a local of type
// TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE. Loads the function value
// from f's storage and delegates to genFuncValueCallWithFn.
func genFuncValueCall(ctx @GenContext, b @Block, e @ast.Expr, fnTyp @types.Type) @Instr {
	var ptr @Instr = lookupVar(ctx, e.X.Name)
	var fnVal @Instr = b.EmitLoad(ptr, fnTyp)
	b = ctx.CurBlock
	return genFuncValueCallWithFn(ctx, b, e, fnTyp, fnVal)
}

// genFuncValueCallExpr lowers `<expr>(args)` where <expr> is any
// non-Ident expression (struct field, index, nested selector, etc.)
// of function-value type. genExpr the callee — for a struct field
// SELECTOR, that yields the loaded function value — then delegate.
func genFuncValueCallExpr(ctx @GenContext, b @Block, e @ast.Expr, fnTyp @types.Type) @Instr {
	var fnVal @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	return genFuncValueCallWithFn(ctx, b, e, fnTyp, fnVal)
}

// genImmediateFuncLitCall lowers an IIFE — `(func(...) R { ... })(args)` — whose
// callee is a func LITERAL.  Like genFuncValueCallExpr it genExpr's the literal
// (lifting + emitting the synthetic function, and heap-allocating the closure
// record for a CAPTURING @func literal), then dispatches the call.  Unlike the
// selector / ident func-value paths — where a var or field OWNS the value — the
// literal callee is a fresh temporary with no owner, so a managed (@func)
// callee is registered for end-of-statement RefDec.  That releases the heap
// closure record and, via its dtor, every managed value it captured; without it
// a capturing IIFE leaks.  A non-capturing @func has null data and the RefDec
// no-ops; a raw *func closure is stack-allocated and needs none.
func genImmediateFuncLitCall(ctx @GenContext, b @Block, e @ast.Expr, fnTyp @types.Type) @Instr {
	var fnVal @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	if isManagedFuncValueType(fnVal.Typ) {
		registerTemp(ctx, fnVal)
	}
	return genFuncValueCallWithFn(ctx, b, e, fnTyp, fnVal)
}

// genFuncValueCallWithFn: shared back end for the two entry points.
// fnVal is the already-loaded function value; e.Args are the user
// args. Result type comes from fnTyp.Results.
func genFuncValueCallWithFn(ctx @GenContext, b @Block, e @ast.Expr, fnTyp @types.Type,
		fnVal @Instr) @Instr {
	// Evaluate + coerce args via genExprOrFuncRef + coerceArg, exactly like
	// the other call sites (genCall / genMethodCall / iface dispatch).
	// Routing through coerceArg adds the by-value struct-copy RefInc this
	// path used to omit — without it a managed-field struct arg under-RefInc'd
	// the callee's parameter copy (the callee's scope dtor then dropped the
	// caller's ref → UAF) and the uncoerced multi-word value emitted an
	// invalid LLVM cast.
	// At this indirect boundary variadic-ness is erased to a plain *[]T:
	// buildCallArgs packs the trailing args into the single *[]T BEFORE
	// EmitCallFuncValue, so the shim/slot receives an ordinary raw slice
	// (func.variadic.identity ABI).  fnTyp carries the variadic flag because IR's
	// resolveTypeExpr / the func-value-type builders mark it (D-G).
	var ptypes @[]@types.Type
	for i := 0; i < len(fnTyp.Params); i++ {
		var pt @types.Type = nil
		if fnTyp.Params[i] != nil { pt = fnTyp.Params[i].Type }
		ptypes = slices.Append[@types.Type](ptypes, pt)
	}
	var args @[]@Instr = buildCallArgs(ctx, b, e.Args, ptypes, funcTypeIsVariadic(fnTyp), e.Spread)
	b = ctx.CurBlock

	// Determine return type.
	var resultTyp @types.Type = types.TypVoid()
	if len(fnTyp.Results) == 1 {
		resultTyp = fnTyp.Results[0]
	} else if len(fnTyp.Results) > 1 {
		resultTyp = makeMultiReturnStructType(fnTyp.Results)
	}

	var result @Instr = b.EmitCallFuncValue(fnVal, args, resultTyp)
	attachFaultPad(ctx, b) // call-site cleanup pad (Plan 2); see genCall's EmitCall site
	registerManagedCallResult(ctx, result, resultTyp)
	return result
}
