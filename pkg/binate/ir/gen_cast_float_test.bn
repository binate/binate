package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// TestIsFloatToIntCast pins the predicate that routes a cast through the
// saturating lowering: only float-source / int-target qualifies.
func TestIsFloatToIntCast() testing.TestResult {
	if !isFloatToIntCast(types.TypFloat64(), types.TypInt()) {
		return fail("f64 -> int must be a float->int cast")
	}
	if !isFloatToIntCast(types.TypFloat32(), types.TypInt8()) {
		return fail("f32 -> int8 must be a float->int cast")
	}
	if isFloatToIntCast(types.TypInt(), types.TypInt8()) {
		return fail("int -> int8 is not a float->int cast")
	}
	if isFloatToIntCast(types.TypFloat64(), types.TypFloat32()) {
		return fail("float -> float is not a float->int cast")
	}
	if isFloatToIntCast(types.TypInt(), types.TypFloat64()) {
		return fail("int -> float is not a float->int cast")
	}
	return ""
}

// TestSatBoundText pins the saturation-threshold constants: 2^(N-1) / 2^N
// (and their negatives / 0) as exact decimal text per width and signedness.
func TestSatBoundText() testing.TestResult {
	if !streq(satMaxBoundText(8, true), "128.0") {
		return fail("signed int8 max bound is 128.0")
	}
	if !streq(satMaxBoundText(32, true), "2147483648.0") {
		return fail("signed int32 max bound is 2147483648.0")
	}
	if !streq(satMaxBoundText(64, false), "18446744073709551616.0") {
		return fail("unsigned uint64 max bound is 2^64")
	}
	if !streq(satMinBoundText(8, true), "-128.0") {
		return fail("signed int8 min bound is -128.0")
	}
	if !streq(satMinBoundText(16, false), "0.0") {
		return fail("unsigned min bound is 0.0")
	}
	return ""
}

// hasGuardOps reports whether any function in m emits the three float->int
// saturation-guard comparisons: the ordered `>= MAX` (OP_GE), ordered
// `< MIN` (OP_LT), and the unordered NaN check `x != x` (OP_NE).
func hasGuardOps(m @Module) (bool, bool, bool) {
	var hasGE bool = false
	var hasLT bool = false
	var hasNE bool = false
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var op int = blk.Instrs[ii].Op
				if op == OP_GE { hasGE = true }
				if op == OP_LT { hasLT = true }
				if op == OP_NE { hasNE = true }
			}
		}
	}
	return hasGE, hasLT, hasNE
}

// TestFloatToIntCastEmitsSaturationGuard verifies that a float->int cast
// lowers to the branchless saturation guard (not a bare OP_CAST), so every
// backend + the VM inherits the saturate+NaN->0 behavior.
func TestFloatToIntCastEmitsSaturationGuard() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
		"package \"test\"\nfunc f(x float64) int8 { return cast(int8, x) }\n")
	var hasGE bool
	var hasLT bool
	var hasNE bool
	hasGE, hasLT, hasNE = hasGuardOps(m)
	if !hasGE { return fail("float->int cast must emit `>= MAX` (OP_GE)") }
	if !hasLT { return fail("float->int cast must emit `< MIN` (OP_LT)") }
	if !hasNE { return fail("float->int cast must emit `x != x` NaN check (OP_NE)") }
	return ""
}

// TestIntToIntCastHasNoSaturationGuard verifies an int->int cast stays a
// plain conversion — the float NaN check (OP_NE on the operand) is unique to
// the saturating path and must NOT appear.
func TestIntToIntCastHasNoSaturationGuard() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
		"package \"test\"\nfunc g(x int32) int8 { return cast(int8, x) }\n")
	var hasNE bool
	var ge bool
	var lt bool
	ge, lt, hasNE = hasGuardOps(m)
	_ = ge
	_ = lt
	if hasNE { return fail("int->int cast must not emit the float NaN guard") }
	return ""
}
