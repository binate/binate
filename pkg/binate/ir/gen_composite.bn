package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// IR generation for composite literals — `T{...}`.  genCompositeLit handles
// the struct form (positional or keyed fields) and dispatches the array /
// raw-slice / managed-slice forms to genArrayLit / genRawSliceLit /
// genManagedSliceLit (below).

// genCompositeLit generates IR for a composite literal (struct or array).
func genCompositeLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	if e.TypeRef == nil {
		return b.EmitConstInt(0, types.TypInt())
	}

	// Array composite literal: [N]T{...}
	if e.TypeRef.Kind == ast.TEXPR_ARRAY {
		return genArrayLit(ctx, b, e)
	}

	// Managed-slice composite literal: @[]T{...}
	if e.TypeRef.Kind == ast.TEXPR_MANAGED_SLICE {
		return genManagedSliceLit(ctx, b, e)
	}

	// Raw-slice composite literal: *[]readonly T{...}
	if e.TypeRef.Kind == ast.TEXPR_SLICE {
		return genRawSliceLit(ctx, b, e)
	}

	var typeName @[]char = e.TypeRef.Name
	var si int = lookupStructIdx(typeName)
	if si < 0 {
		return b.EmitConstInt(0, types.TypInt())
	}

	var structPtr @Instr = b.EmitAlloc(moduleStructs[si].Typ)

	// Initialize all fields: from keyed or positional elements, or zero
	var fields @[]@types.Field = moduleStructs[si].Fields
	var isKeyed bool = len(e.Elems) > 0 && e.Elems[0].Key != nil
	for i := 0; i < len(fields); i++ {
		var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fields[i].Type)
		var val @Instr = nil
		if isKeyed {
			// Keyed: find element by field name
			for j := 0; j < len(e.Elems); j++ {
				if e.Elems[j].Key != nil && streq(e.Elems[j].Key.Name, fields[i].Name) {
					val = genExprOrFuncRef(ctx, b,
						e.Elems[j].Value, fields[i].Type)
					b = ctx.CurBlock
				}
			}
		} else {
			// Positional: use element at index i if available
			if i < len(e.Elems) {
				val = genExprOrFuncRef(ctx, b,
					e.Elems[i].Value, fields[i].Type)
				b = ctx.CurBlock
			}
		}
		if val == nil {
			// Zero-initialize: use nil for slices/pointers, 0 for scalars
			if isNillableType(fields[i].Type) {
				val = b.EmitConstNil(fields[i].Type)
			} else {
				val = b.EmitConstInt(0, fields[i].Type)
			}
		}
		// String literal assigned to a char-slice field (*[]readonly char
		// OR @[]char): convert OP_CONST_STRING to a proper slice
		// value (raw → OP_RODATA_SLICE, managed → OP_RODATA_MSLICE_COPY).
		// Without this, the managed-slice arm below tries to extract
		// the refptr from a bare i8*, the per-field RefInc and the
		// store both go wrong, and the Name field reads back as zero.
		var ft @types.Type = fields[i].Type
		if isCharSliceType(ft) {
			if val.Op == OP_CONST_STRING {
				val = b.EmitStringToChars(val, fields[i].Type)
				noteSPGrowingResult(ctx, val)
			}
		}
		// String literal assigned to [N]char field: load rodata array.
		if isCharArrayType(ft) {
			if val.Op == OP_CONST_STRING {
				val = b.EmitRodataArray(val.StrVal, fields[i].Type)
				noteSPGrowingResult(ctx, val)
			}
		}
		// @[]T → *[]T conversion for raw slice field
		if ft.Kind == types.TYP_SLICE && val.Typ != nil && val.Typ.Kind == types.TYP_MANAGED_SLICE {
			// Temp stays in cleanup — RefDec at end of statement
			val = b.EmitManagedToRaw(val)
		}
		// If the value is a struct alloca (from nested composite lit), load it first
		if val.Op == OP_ALLOC && val.TypeArg != nil && val.TypeArg.Kind == types.TYP_STRUCT {
			val = b.EmitLoad(val, val.TypeArg)
		}
		// Narrow an untyped scalar LITERAL field value to the field's
		// width (e.g. an untyped-float 0.5 into a float32 field fptruncs
		// to single precision).  No-op for managed / struct / nil values.
		val = coerceScalarWidth(ctx, b, val, fields[i].Type)
		// Acquire-and-store through the shared dispatcher.  isInit: a fresh
		// field slot, no old value to release.  A fresh producer — including
		// an OP_CONST_NIL zero-init — is moved (consumeTemp), so no RefInc /
		// OP_EXTRACT runs on a nil constant (which the bytecode VM mis-lowers).
		b = emitStoreManagedSlot(ctx, b, fieldPtr, val, fields[i].Type, true)
	}

	return structPtr
}

// ============================================================
// Array literal
// ============================================================

// genArrayLit generates IR for an array literal expression, allocating and storing each element.
func genArrayLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var arrTyp @types.Type = resolveTypeExpr(e.TypeRef)
	var arrPtr @Instr = b.EmitAlloc(arrTyp)

	var elemTyp @types.Type = arrTyp.Elem
	if elemTyp == nil {
		elemTyp = types.TypInt()
	}

	// Store each element
	for i := 0; i < len(e.Elems); i++ {
		var idx @Instr = b.EmitConstInt(i, types.TypInt())
		var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, idx, elemTyp)
		var val @Instr = genExpr(ctx, b, e.Elems[i].Value)
		b = ctx.CurBlock
		// Narrow an untyped scalar literal element to the element width
		// (e.g. an untyped-float 0.5 in [N]float32{...} fptruncs to single
		// precision) — without it an 8-byte store hits a 4-byte slot.
		// No-op for managed / struct / string values handled below.
		val = coerceScalarWidth(ctx, b, val, elemTyp)
		// Same conversions other store sites apply: a string literal
		// stored into a char-slice element needs the full managed-
		// slice header (data, len, refptr, backing_len), not just
		// the bare data pointer that OP_CONST_STRING carries.  Without
		// this, the slot's len reads back as 0 — silent wrong output.
		if isCharSliceType(elemTyp) && val.Op == OP_CONST_STRING {
			val = b.EmitStringToChars(val, elemTyp)
			noteSPGrowingResult(ctx, val)
		}
		// Nested composite-lit: a struct/array composite literal returns
		// its alloca POINTER.  When the array element type is the aggregate
		// itself (not a pointer to it), load the value before storing —
		// otherwise EmitStore writes the alloca pointer (8 bytes) into the
		// aggregate-sized slot.  Covers both struct elements and inner-array
		// elements (`[N][M]T{...}`); mirrors gen_control.bn's array-index-
		// assign branch.
		if isAggregateAllocToLoad(val, elemTyp) {
			val = b.EmitLoad(val, val.TypeArg)
		}
		// Acquire-and-store through the shared dispatcher: the array co-owns
		// each managed element (its scope-exit dtor RefDec's it).  isInit: a
		// freshly-alloc'd slot, no old value to release.  A fresh producer —
		// including an OP_CONST_NIL zero-init — is moved (consumeTemp), so no
		// RefInc / OP_EXTRACT runs on a nil constant.
		b = emitStoreManagedSlot(ctx, b, elemPtr, val, elemTyp, true)
	}

	return arrPtr
}

// genRawSliceLit generates IR for a raw-slice composite literal
// `*[]readonly T{e0, e1, ...}`. Stack-allocates an `[N]T` backing,
// stores each element, then builds a `%BnSlice{data, N}` view of
// the stack array. The view's lifetime is the enclosing scope —
// the language's existing raw-slice-borrow rules keep this honest
// (you can't return or otherwise escape a raw slice).
//
// Phase 3 fast path: when the element type is `const uint8` and
// every element is a compile-time char/int literal that fits in a
// byte, emit `OP_RODATA_SLICE` directly so codegen can alias a
// shared static rodata global (zero-copy, zero stack frame use).
func genRawSliceLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var sliceTyp @types.Type = resolveTypeExpr(e.TypeRef)
	var elemTyp @types.Type = sliceTyp.Elem
	if elemTyp == nil {
		elemTyp = types.TypInt()
	}
	// Length-0 ⟹ no backing: an empty `*[]T{}` is the nil-equivalent
	// {null, 0}, not a view over a freshly-allocated [0]T backing.
	if len(e.Elems) == 0 {
		return b.EmitConstNil(sliceTyp)
	}
	var bytes @[]char
	var ok bool
	bytes, ok = collectConstByteElems(e, elemTyp)
	if ok {
		return b.EmitRodataSlice(bytes, sliceTyp)
	}
	var n int = len(e.Elems)
	// 1. Allocate a stack `[N]T` backing.
	var arrTyp @types.Type = types.MakeArrayType(elemTyp, n)
	var arrPtr @Instr = b.EmitAlloc(arrTyp)
	for i := 0; i < n; i++ {
		var idx @Instr = b.EmitConstInt(i, types.TypInt())
		var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, idx, elemTyp)
		var val @Instr = genExpr(ctx, b, e.Elems[i].Value)
		b = ctx.CurBlock
		// Narrow an untyped scalar literal element to the element width
		// (e.g. an untyped-float 0.5 in *[]float32{...} fptruncs to single
		// precision) — without it codegen stores an 8-byte double through
		// a 4-byte float slot (memory corruption).
		val = coerceScalarWidth(ctx, b, val, elemTyp)
		b.EmitStore(elemPtr, val)
	}
	// 2. Build a %BnSlice {data, N} view via alloca + field stores.
	var sliceAlloca @Instr = b.EmitAlloc(sliceTyp)
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = b.EmitBitCast(arrPtr, rawPtrTyp)
	var ptrField @Instr = b.EmitGetFieldPtr(sliceAlloca, 0, rawPtrTyp)
	b.EmitStore(ptrField, dataPtr)
	var lenInstr @Instr = b.EmitConstInt(n, types.TypInt())
	var lenField @Instr = b.EmitGetFieldPtr(sliceAlloca, 1, types.TypInt())
	b.EmitStore(lenField, lenInstr)
	return b.EmitLoad(sliceAlloca, sliceTyp)
}

// genManagedSliceLit generates IR for a managed-slice composite
// literal `@[]T{e0, e1, ...}`. Allocates a fresh backing via
// `MakeManagedSlice(sizeof(T), N)`, stores each element, and
// returns the resulting %BnManagedSlice. Refcount-wise the result
// is fresh (refcount=1) — same as `make_slice(T, N)` followed by
// element initialization.
//
// Phase 3 fast path: same const-byte detection as genRawSliceLit
// — when applicable, emit `OP_RODATA_MSLICE` so codegen aliases a
// shared static `%BnManagedSlice` global instead of running the
// MakeSlice + N stores at runtime.
func genManagedSliceLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var sliceTyp @types.Type = resolveTypeExpr(e.TypeRef)
	var elemTyp @types.Type = sliceTyp.Elem
	if elemTyp == nil {
		elemTyp = types.TypInt()
	}
	var bytes @[]char
	var ok bool
	bytes, ok = collectConstByteElems(e, elemTyp)
	if ok {
		return b.EmitRodataMSlice(bytes, sliceTyp)
	}
	var n int = len(e.Elems)
	var nInstr @Instr = b.EmitConstInt(n, types.TypInt())
	var slice @Instr = b.EmitMakeSlice(elemTyp, nInstr)
	noteSPGrowingResult(ctx, slice)

	// Store each element via slice-set semantics: extract data ptr,
	// GEP to the element, store.
	for i := 0; i < n; i++ {
		var idx @Instr = b.EmitConstInt(i, types.TypInt())
		var val @Instr = genExpr(ctx, b, e.Elems[i].Value)
		b = ctx.CurBlock
		// Narrow an untyped scalar literal element to the element width
		// (e.g. an untyped-float 0.5 in @[]float32{...} fptruncs to single
		// precision).  No-op for managed / struct / string values below.
		val = coerceScalarWidth(ctx, b, val, elemTyp)
		// Same conversion the var-decl / array-lit / array-index-
		// assign / struct-field-init paths apply: a string literal
		// stored into a char-slice element needs the full managed-
		// slice header, not the bare data pointer of OP_CONST_STRING.
		// Without this, an `@[]@[]char{"a","b",...}` literal stores
		// 8-byte pointers into 32-byte slots and the slot's len
		// reads back as 0 (silent empty output).
		if isCharSliceType(elemTyp) && val.Op == OP_CONST_STRING {
			val = b.EmitStringToChars(val, elemTyp)
			noteSPGrowingResult(ctx, val)
		}
		// Acquire each managed element so the slice owns its reference (its
		// scope-exit dtor RefDec's it); a fresh producer transfers ownership
		// via consumeTemp instead.  A managed slice has no persistent slot
		// pointer, so this can't route through emitStoreManagedSlot like the
		// array / struct literals — a managed-aggregate element instead copies
		// into a throwaway slot to RefInc its fields (EmitSliceSet then writes
		// the same bytes into the element).
		if isManagedScalarType(elemTyp) {
			emitAcquireManagedScalar(ctx, b, val, elemTyp)
		} else if needsStructCopy(elemTyp) {
			var copySlot @Instr = b.EmitAlloc(elemTyp)
			b.EmitStore(copySlot, val)
			emitStructCopy(ctx.Func, b, copySlot, elemTyp)
		}
		b.EmitSliceSet(slice, idx, val, elemTyp)
	}
	return slice
}

// collectConstByteElems returns the byte sequence of a composite
// literal whose target element type is `const uint8` and whose every
// element is a compile-time char/int literal that fits in [0, 255].
// Returns (bytes, true) on success; (nil, false) when the literal
// doesn't qualify (different element type, mixed/runtime elements,
// or out-of-range int literals).
func collectConstByteElems(e @ast.Expr, elemTyp @types.Type) (@[]char, bool) {
	if !isConstByteElemType(elemTyp) {
		var none @[]char
		return none, false
	}
	var n int = len(e.Elems)
	var bytes @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		var v @ast.Expr = e.Elems[i].Value
		if v == nil {
			var none @[]char
			return none, false
		}
		var b int
		if v.Kind == ast.EXPR_CHAR_LIT {
			b = parseCharLit(v.Name)
		} else if v.Kind == ast.EXPR_INT_LIT {
			b = parseIntLit(v.Name)
			if b < 0 || b > 255 {
				var none @[]char
				return none, false
			}
		} else {
			var none @[]char
			return none, false
		}
		bytes[i] = cast(char, b)
	}
	return bytes, true
}

// isConstByteElemType reports whether `elemTyp` is `const uint8`
// (or any const-wrapped 8-bit unsigned int after alias peeling).
// The const wrapper is required: aliasing rodata is sound only for
// read-only views.
func isConstByteElemType(elemTyp @types.Type) bool {
	for elemTyp != nil && elemTyp.Kind == types.TYP_ALIAS {
		elemTyp = elemTyp.Target
	}
	if elemTyp == nil { return false }
	if elemTyp.Kind != types.TYP_READONLY { return false }
	var inner @types.Type = elemTyp.Elem
	for inner != nil && inner.Kind == types.TYP_ALIAS {
		inner = inner.Target
	}
	if inner == nil { return false }
	return inner.Kind == types.TYP_INT && inner.Width == 8 && !inner.Signed
}
