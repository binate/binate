package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_composite.bn.  genCompositeLit handles struct
// composites (lookupStructIdx + per-field init) and dispatches the
// array / raw-slice / managed-slice forms to genArrayLit /
// genRawSliceLit / genManagedSliceLit (same file).  End-to-end
// struct-lit behavior is also covered by TestGeneratePackageStructLitInit
// in gen_module_test.bn; these tests pin the dispatch branches and the
// per-element managed-value acquire each constructor performs.

// Keyed struct literal: each field gets initialized with the
// matching keyed element. The field-store sequence is observable
// as OP_STORE instructions with OP_CONST_INT values matching the
// keyed values.
func TestGenCompositeLitKeyedStruct() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pt struct { x int; y int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var p Pt = Pt{x: 10, y: 20}\n")
	cb.Write("  _ = p\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil { return fail("test.main not found") }
	var saw10 bool = false
	var saw20 bool = false
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 2 && ins.Args[1].Op == iropcode.OP_CONST_INT {
				if ins.Args[1].IntVal == 10 { saw10 = true }
				if ins.Args[1].IntVal == 20 { saw20 = true }
			}
		}
	}
	if !saw10 { return fail("missing field-store of x = 10") }
	if !saw20 { return fail("missing field-store of y = 20") }
	return ""
}

// Positional struct literal: elements without keys initialize
// fields by position. Same observable shape as keyed init —
// OP_STORE of constants — but the per-field branch in
// genCompositeLit takes the !isKeyed path.
func TestGenCompositeLitPositionalStruct() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pt struct { x int; y int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var p Pt = Pt{7, 9}\n")
	cb.Write("  _ = p\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil { return fail("test.main not found") }
	var saw7 bool = false
	var saw9 bool = false
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 2 && ins.Args[1].Op == iropcode.OP_CONST_INT {
				if ins.Args[1].IntVal == 7 { saw7 = true }
				if ins.Args[1].IntVal == 9 { saw9 = true }
			}
		}
	}
	if !saw7 { return fail("missing field-store of x = 7") }
	if !saw9 { return fail("missing field-store of y = 9") }
	return ""
}

// A struct field-init with an inner ARRAY composite literal (`S{ arr:
// [2]int{...} }`) must store the array VALUE — the loaded array — into the
// field slot, not the inner alloca POINTER.  The store guard used to fire
// only for TYP_STRUCT element allocas, so an inner-array alloca's 8-byte
// pointer was stored raw into the array-sized slot (garbage).  CR-2 Plan-1
// Round-2 (struct-field-init sibling of Defect 6): assert no OP_STORE takes
// an OP_ALLOC-of-array directly as its stored value.
func TestGenCompositeArrayFieldLoadsValue() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type S struct { arr [2]int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var x S = S{ arr: [2]int{9, 10} }\n")
	cb.Write("  _ = x\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil { return fail("test.main not found") }
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 2 {
				var v @Instr = ins.Args[1]
				if v.Op == iropcode.OP_ALLOC && v.TypeArg != nil && v.TypeArg.Kind == types.TYP_ARRAY {
					return fail("inner-array alloca pointer stored "
							"directly (not loaded) into the field slot")
				}
			}
		}
	}
	return ""
}

// Partial struct literal: missing fields zero-initialize. A `Pt{x: 5}`
// initializer must still emit a store for `y` with the zero value.
func TestGenCompositeLitMissingFieldZeros() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pt struct { x int; y int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var p Pt = Pt{x: 5}\n")
	cb.Write("  _ = p\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil { return fail("test.main not found") }
	// Should see two OP_STORE pairs: one for x = 5, one for y = 0.
	var saw5 bool = false
	var sawZero bool = false
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 2 && ins.Args[1].Op == iropcode.OP_CONST_INT {
				if ins.Args[1].IntVal == 5 { saw5 = true }
				if ins.Args[1].IntVal == 0 { sawZero = true }
			}
		}
	}
	if !saw5 { return fail("expected x = 5 store") }
	if !sawZero { return fail("expected y = 0 zero-init store") }
	return ""
}

// Struct literal with a managed-slice (@[]char) field initialized
// from a string literal.  Pre-fix: the per-field string→@[]char
// conversion only fired for raw-slice (`*[]readonly char`) fields,
// so the @[]char field's RefInc tried to extract refptr from a
// bare i8* (LLVM IR error) and the store wrote 8 bytes into the
// 32-byte slot.  Post-fix: EmitStringToChars dispatches to
// OP_RODATA_MSLICE_COPY for the managed-slice field, and the
// store writes the full header.  Repros (end-to-end):
// conformance/367_array_struct_managed_field_lit.bn and
// conformance/371_array_struct_managed_field_assign.bn.
func TestGenCompositeLitStructManagedCharField() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pair struct { Name @[]char; Val int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var p Pair = Pair{\"hi\", 1}\n")
	cb.Write("  _ = p\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil { return fail("test.main not found") }
	// EmitStringToChars on @[]char produces OP_RODATA_MSLICE_COPY.
	if countOp(mainFn, iropcode.OP_RODATA_MSLICE_COPY) != 1 {
		return fail("expected 1 iropcode.OP_RODATA_MSLICE_COPY for Name field")
	}
	return ""
}

// genArrayLit must acquire each managed-AGGREGATE array element via the
// generated __copy_ helper: `[N]Wrap{...}` co-owns each element's managed
// fields, balanced by the array's scope-exit dtor.  Pre-fix the element
// store was bare (no acquire) — under-retaining → double-free.
// funcByName / hasCallTo / countOpInFunc live in gen_assign_multi_test.bn.
func TestArrayLitAggregateAcquires() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"type Wrap struct { b @Node }\n"
					"func foo() {\n"
					"\tvar w Wrap\n\tw.b = make(Node)\n"
					"\tvar arr [2]Wrap = [2]Wrap{w, w}\n\t_ = arr\n}\n")
	var fn @Func = funcByName(m, "foo")
	if fn == nil { return fail("foo not found") }
	if !hasCallTo(fn, "__copy_") {
		return fail("array literal of an aggregate must call __copy_ per element")
	}
	return ""
}

// genManagedSliceLit must acquire each managed-aggregate slice element via
// __copy_ — `@[]Wrap{...}` had no needsStructCopy arm pre-fix.
func TestManagedSliceLitAggregateAcquires() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"type Wrap struct { b @Node }\n"
					"func foo() {\n"
					"\tvar w Wrap\n\tw.b = make(Node)\n"
					"\tvar s @[]Wrap = @[]Wrap{w, w}\n\t_ = s\n}\n")
	var fn @Func = funcByName(m, "foo")
	if fn == nil { return fail("foo not found") }
	if !hasCallTo(fn, "__copy_") {
		return fail("managed-slice literal of an aggregate must call __copy_")
	}
	return ""
}

// genArrayLit must acquire managed-SCALAR elements too (not just
// aggregates): `[2]@Node{a, a}` RefInc's each element.  Pre-fix genArrayLit
// had NO managed-element acquire of any kind.  Baseline-delta (identical
// params, no literal) isolates the literal's RefIncs.
func TestArrayLitScalarElemAcquires() testing.TestResult {
	var stored @Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"func foo(a @Node) { var arr [2]@Node = [2]@Node{a, a}; _ = arr }\n")
	var base @Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"func foo(a @Node) { _ = a }\n")
	var fs @Func = funcByName(stored, "foo")
	var fb @Func = funcByName(base, "foo")
	if fs == nil { return fail("foo not found (stored)") }
	if fb == nil { return fail("foo not found (baseline)") }
	if countOpInFunc(fs, iropcode.OP_REFINC) <= countOpInFunc(fb, iropcode.OP_REFINC) {
		return fail("array literal must RefInc each managed-ptr element")
	}
	return ""
}

// genManagedSliceLit must acquire an `@func` element (the arm it omitted) —
// without it a fresh closure element is freed at end of statement, a UAF on
// invoke.  Compare a two-element vs one-element @func slice literal: both
// build a managed slice (identical backing-refptr RefInc, which a no-slice
// baseline would NOT have — that masks the per-element acquire), so the delta
// isolates the per-element @func acquire.
func TestManagedSliceLitFuncElemAcquires() testing.TestResult {
	var two @Module = genFromSource(
			"package \"test\"\n"
					"func foo(g @func(int) int) {\n"
					"\tvar s @[]@func(int) int = @[]@func(int) int{g, g}\n\t_ = s\n}\n")
	var one @Module = genFromSource(
			"package \"test\"\n"
					"func foo(g @func(int) int) {\n"
					"\tvar s @[]@func(int) int = @[]@func(int) int{g}\n\t_ = s\n}\n")
	var f2 @Func = funcByName(two, "foo")
	var f1 @Func = funcByName(one, "foo")
	if f2 == nil { return fail("foo not found (two)") }
	if f1 == nil { return fail("foo not found (one)") }
	if countOpInFunc(f2, iropcode.OP_REFINC) <= countOpInFunc(f1, iropcode.OP_REFINC) {
		return fail("managed-slice literal must acquire each @func element")
	}
	return ""
}

// genCompositeLit must acquire an `@func` STRUCT FIELD (the sibling arm it
// omitted) — the same closure-record UAF class as the array / slice literals.
func TestStructLitFuncFieldAcquires() testing.TestResult {
	var stored @Module = genFromSource(
			"package \"test\"\n"
					"type S struct { f @func(int) int }\n"
					"func foo(g @func(int) int) { var s S = S{g}; _ = s }\n")
	var base @Module = genFromSource(
			"package \"test\"\n"
					"type S struct { f @func(int) int }\n"
					"func foo(g @func(int) int) { _ = g }\n")
	var fs @Func = funcByName(stored, "foo")
	var fb @Func = funcByName(base, "foo")
	if fs == nil { return fail("foo not found (stored)") }
	if fb == nil { return fail("foo not found (baseline)") }
	if countOpInFunc(fs, iropcode.OP_REFINC) <= countOpInFunc(fb, iropcode.OP_REFINC) {
		return fail("struct literal must acquire an @func field")
	}
	return ""
}
