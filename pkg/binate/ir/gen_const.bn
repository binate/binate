package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Top-level const and global-var registration: global var type
// inference and the const producers (single + grouped, incl.
// iota).  Const-expression evaluation, literal classification,
// and float/bool folding live in gen_const_fold.bn.

// resolveGlobalVarType returns the type for a top-level
// `var` declaration.  When `d.TypeRef` is set, it's the
// resolved declared type.  When it's nil (untyped — `var x =
// expr`), the type is inferred from the initializer literal:
//
//   var x = 42        → int
//   var x = 1.5       → float64
//   var x = true      → bool
//   var x = 'a'       → char
//   var x = "hello"   → @[]readonly char
//
// Returns nil for non-literal initializers (function calls,
// arithmetic, etc.) — caller surfaces a "type required" error.
// The type checker handles those for LOCAL vars via its full
// expression machinery; mirroring that for top-level vars
// would require threading the checker through IR-gen, which
// isn't worth the surface for the common-case literal init.
func resolveGlobalVarType(gc @GenCtx, d @ast.Decl) @types.Type {
	if d.TypeRef != nil {
		return resolveTypeExpr(gc, d.TypeRef)
	}
	if d.Value == nil { return nil }
	var e @ast.Expr = d.Value
	if e.Kind == ast.EXPR_INT_LIT { return types.TypInt() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypFloat64() }
	if e.Kind == ast.EXPR_STRING_LIT {
		return types.MakeManagedSliceType(
			types.MakeReadonlyType(types.TypUint8()))
	}
	return nil
}

// genConst registers a single constant declaration in Module.Consts.
// For a bare top-level `const X int = <expr>`, iota is 0 (no group).
// classifyConstLit handles the non-integer literal cases (string, bool,
// float) — setting Kind + the matching value slot, bypassing the
// integer-only evalConstExpr — so read sites emit the matching
// OP_CONST_* rather than a zero-int placeholder.
func genConst(gc @GenCtx, c @types.Checker, d @ast.Decl) {
	if d.Value == nil { return }
	var mc ModuleConst
	mc.Name = buf.CopyStr(d.Name)
	if d.TypeRef != nil {
		mc.Typ = resolveTypeExpr(gc, d.TypeRef)
	}
	if classifyConstLit(&mc, d.Value) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	// Prefer the boolean value the checker recorded on the initializer's type
	// (the HasBoolVal carrier attachConstBoolVal stamps).  This keeps IR-gen in
	// lockstep with the checker for a relational comparison of unsigned operands
	// >= 2^63 — evalConstBool's host-int fold compares those SIGNED (a silent
	// miscompile).  Falls back to classifyConstBoolExpr when nothing was stamped.
	if c != nil && d.Value.ResolvedTypeID != 0 {
		var t @types.Type = c.ExprType(d.Value.ResolvedTypeID)
		if t != nil && t.IsConstStamp && t.HasBoolVal {
			mc.BoolVal = t.BoolVal
			mc.Kind = CONST_BOOL
			gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
			return
		}
	}
	if classifyConstBoolExpr(gc, &mc, d.Value, 0) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	if classifyConstFloatExpr(gc, &mc, d.Value, 0) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	var val int
	var ok bool
	// Prefer the value the checker recorded on the initializer's type (the
	// HasLitVal carrier attachConstLitVal stamps).  This keeps IR-gen in
	// lockstep with the checker for /, %, >> over an unsigned operand >= 2^63 —
	// evalConstExpr's host-int fold would fold those SIGNED (a silent
	// miscompile).  Falls back to evalConstExpr when no value was recorded.
	if c != nil && d.Value.ResolvedTypeID != 0 {
		var t @types.Type = c.ExprType(d.Value.ResolvedTypeID)
		if t != nil && t.IsConstStamp && t.HasLitVal {
			val = cast(int, bignumToInt(t.LitMag, t.LitSign))
			ok = true
		}
	}
	if !ok {
		val, ok = evalConstExpr(gc, d.Value, 0)
	}
	if !ok { return }
	mc.Val = val
	gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
}

// exprUsesIota reports whether e references `iota`, so a bare const-group
// member repeating e must be re-evaluated at its own iota rather than
// reusing the preceding explicit member's folded value/stamp.
func exprUsesIota(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return streq(e.Name, "iota") }
	if e.Kind == ast.EXPR_UNARY { return exprUsesIota(e.X) }
	if e.Kind == ast.EXPR_BINARY {
		if exprUsesIota(e.X) { return true }
		return exprUsesIota(e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		for i := 0; i < len(e.Args); i++ {
			if exprUsesIota(e.Args[i]) { return true }
		}
	}
	return false
}

// genConstGroup registers a group of iota constants in Module.Consts.
// Skips parked members (the REPL's Tier 3 forward-ref machinery
// marks individual const members as pending when their value
// expression references undefined names — see plan-repl-tier3-
// pending-types.md Stage 1 (c)).  iotaVal still increments
// across the parked positions so resolved members get the
// correct positional iota — the same value retry will give
// the parked member when it eventually lands via GenConstMember.
func genConstGroup(gc @GenCtx, c @types.Checker, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Go-style iota-repeat: a bare const-group member repeats the closest
	// PRECEDING member's initializer EXPRESSION and TYPE, re-evaluated with
	// its own iota — so `const ( B0 int = 1 << iota; B1; B2 )` yields 1,2,4
	// (the bit-flag idiom), not plain iota 1,1,2.  prevExpr / prevTyp carry
	// that spec across bare members; in a mixed-type group a bare member
	// therefore inherits the PRECEDING member's type, not the first
	// member's.
	var prevExpr @ast.Expr = nil
	var prevTyp @types.Type = nil
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			if c != nil &&
					c.IsPendingDecl(cd.Name) {
				// Parked member.  Still increment iotaVal so
				// the next resolved member's iota reflects
				// source position.  retryPending's
				// GenConstMember path will register this
				// member when its dep arrives, using the same
				// iotaVal (preserved on the PendingDecl).
				iotaVal = iotaVal + 1
				continue
			}
			var mc ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			// Effective type: the member's own type if it has one, else the
			// preceding member's (inherited across bare members).
			var memberTyp @types.Type = prevTyp
			if cd.TypeRef != nil {
				memberTyp = resolveTypeExpr(gc, cd.TypeRef)
			}
			prevTyp = memberTyp
			// A bare member repeats prevExpr; an explicit member updates
			// it.  valExpr is the expression to evaluate at this position.
			var valExpr @ast.Expr = cd.Value
			if valExpr == nil {
				valExpr = prevExpr
			} else {
				prevExpr = cd.Value
			}
			// An EXPLICIT member (cd.Value != nil) prefers the checker's
			// signedness-aware stamp on its OWN node (HasLitVal / HasBoolVal,
			// like genConst) — so a grouped `Q uint64 = U / D` (U >= 2^63) folds
			// UNSIGNED, where evalConstExpr below would fold it as a signed host
			// int.  A BARE member re-uses prevExpr's shared node, whose stamp
			// belongs to the explicit member, so it keeps the host-int fold.
			// A BARE member that repeats a NON-iota expression has the SAME
			// value as the explicit member it repeats, so it reuses that
			// member's stamp on the shared prevExpr node (the checker restores
			// prevExpr's stamp after the bare re-check) — otherwise a bare
			// repeat of `U / D` (U >= 2^63) folds signed via the host int.  An
			// IOTA-using repeat is re-evaluated below at THIS member's iota.
			var stamped bool = false
			var stampExpr @ast.Expr = nil
			if cd.Value != nil {
				stampExpr = cd.Value
			} else if valExpr != nil && !exprUsesIota(valExpr) {
				stampExpr = valExpr
			}
			if stampExpr != nil && c != nil && stampExpr.ResolvedTypeID != 0 {
				var st @types.Type = c.ExprType(stampExpr.ResolvedTypeID)
				if st != nil && st.IsConstStamp && st.HasBoolVal {
					mc.BoolVal = st.BoolVal
					mc.Kind = CONST_BOOL
					stamped = true
				} else if st != nil && st.IsConstStamp && st.HasLitVal {
					mc.Val = cast(int, bignumToInt(st.LitMag, st.LitSign))
					stamped = true
				}
			}
			if !stamped {
				if valExpr != nil {
					if !classifyConstLit(&mc, valExpr) &&
							!classifyConstBoolExpr(gc, &mc, valExpr, iotaVal) &&
							!classifyConstFloatExpr(gc, &mc, valExpr, iotaVal) {
						var v int
						var ok bool
						v, ok = evalConstExpr(gc, valExpr, iotaVal)
						if ok {
							mc.Val = v
						} else {
							mc.Val = iotaVal
						}
					}
				} else {
					// First member is bare (no expression to repeat): plain iota.
					mc.Val = iotaVal
				}
			}
			mc.Typ = memberTyp
			gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
