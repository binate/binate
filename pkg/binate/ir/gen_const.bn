package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Top-level const and global-var registration: global var type
// inference and the const producers (single + grouped, incl.
// iota).  Const-expression evaluation, literal classification,
// and float/bool folding live in gen_const_fold.bn.

// resolveGlobalVarType returns the type for a top-level
// `var` declaration.  When `d.TypeRef` is set, it's the
// resolved declared type.  When it's nil (untyped — `var x =
// expr`), the type is inferred from the initializer literal:
//
//   var x = 42        → int
//   var x = 1.5       → float64
//   var x = true      → bool
//   var x = 'a'       → char
//   var x = "hello"   → @[]readonly char
//
// For a FUNCTION-VALUE initializer — a bare function reference
// (`var G = add1`), a generic-function instantiation (`var G =
// glib.Ident[int]`), or another func-value variable including one of a
// NAMED func-value type (`type Fn @func(int)int; var base Fn = add1;
// var G = base`) — the type is the underlying func-value, derived from
// the checker's resolved initializer type and stripped of any named
// wrapper (see below).  Returns nil for other non-literal initializers.
func resolveGlobalVarType(gc @GenCtx, d @ast.Decl) @types.Type {
	if d.TypeRef != nil {
		return resolveTypeExpr(gc, d.TypeRef)
	}
	if d.Value == nil { return nil }
	var e @ast.Expr = d.Value
	if e.Kind == ast.EXPR_INT_LIT { return types.TypInt() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypFloat64() }
	if e.Kind == ast.EXPR_STRING_LIT {
		return types.MakeManagedSliceType(
				types.MakeReadonlyType(types.TypUint8()))
	}
	// Function-value initializer: a bare func reference (`var G = add1`) or a
	// generic-function instantiation (`var G = glib.Ident[int]`) decays to
	// `@func`, exactly as for a LOCAL `var f = add` (checker defaultType).
	// IR-gen can't re-derive it here — the same-package func-signature registry
	// isn't populated until a later pass than this one — but the checker already
	// resolved the initializer, stamping its type on `Expr.ResolvedTypeID`, so
	// read that and apply the same TYP_FUNC → @func decay.  (ResolvedTypeID holds
	// the RAW `func(...)` type, not the decayed one; the package-symbol type IS
	// decayed but the `main` package is checked single-file and never registered,
	// so that scope isn't queryable — the expr type is.)  Without this the global
	// registers as an opaque scalar and its `__init` assignment lowers the
	// reference to a zero placeholder (no OP_FUNC_VALUE) — a silent miscompile
	// clang then rejects.  A non-func-value non-literal init keeps the prior nil.
	// Guarded so the no-checker paths (single-file test gen) fall back unchanged.
	if gc.Mod != nil && gc.Mod.Checker != nil && e.ResolvedTypeID != 0 {
		var t @types.Type = gc.Mod.Checker.ExprType(e.ResolvedTypeID)
		if t != nil {
			// Strip NAMED / alias / readonly wrappers to the underlying, exactly as
			// resolveTypeExpr does for an EXPLICIT declared type: IR-gen represents a
			// named non-struct type by its underlying, so `var base Fn = add1` (Fn:
			// `type Fn @func(int)int`) registers a stripped @func slot.  An inferred
			// `var G = base` reads the checker's view of `base`, which is the NAMED
			// `Fn` (TYP_NAMED-over-@func); without stripping it here the kind-check
			// misses, the slot registers as an opaque 8-byte scalar, and __init's
			// 16-byte func-value store overruns it WHILE the call `G(x)` mis-lowers
			// to a direct symbol call on a nonexistent `@bn_F..._G`.  Stripping makes
			// the inferred form register the same @func slot the explicit form does.
			var u @types.Type = peelTransparent(t)
			if u != nil {
				if u.Kind == types.TYP_FUNC {
					return types.MakeManagedFuncValueType(u.Params, u.Results)
				}
				if u.Kind == types.TYP_FUNC_VALUE || u.Kind == types.TYP_MANAGED_FUNC_VALUE {
					return u
				}
			}
		}
	}
	return nil
}

// constValueFitsSignedTarget reports whether a folded const integer value
// `val` fits its declared SIGNED integer target's range.  This is a DEFENSIVE
// guard, not the live check: the type-checker (untypedIntLitFitsTarget ->
// bignum.FitsSigned) is the authoritative gate and rejects every out-of-range
// const BEFORE IR-gen runs, so this only matters if a future checker-bypass
// const path reaches genConst/genConstGroup -- in which case the producer
// aborts loudly rather than silently storing a host-int-WRAPPED value (e.g.
// `1 << 31` for an int32 target would otherwise truncate to INT32_MIN at
// codegen, diverging from the abstract value 2^31 the checker computes in
// bignum and rejects).
//
// For a 64-bit signed target the compiler's host int IS that width, so a value
// that overflowed 2^63 has already become an indistinguishable wrapped bit
// pattern (a valid int64) by the time it reaches here -- only the checker's
// bignum can detect that case -- so this returns true (no-op) for width >= 64,
// leaving the checker authoritative there.
func constValueFitsSignedTarget(val int64, typ @types.Type) bool {
	if typ == nil { return true }
	var d @types.Type = typ.ResolveAlias()
	// Peel readonly / named wrappers to the underlying primitive: a named int
	// (`type Flags int32`) carries the real width / signedness on Underlying.
	var i int = 0
	for d != nil && i < 8 {
		if d.Kind == types.TYP_READONLY { d = d.Elem; i = i + 1; continue }
		if d.Kind == types.TYP_NAMED && d.Underlying != nil {
			d = d.Underlying
			i = i + 1
			continue
		}
		break
	}
	if d == nil || d.Kind != types.TYP_INT || !d.Signed { return true }
	var w int = d.Width
	if w <= 0 || w >= 64 { return true }
	// Compute bounds in int64: `1 << (w-1)` for w up to 63 (and even w==32 on
	// an ILP32 host) overflows a host int, so the shift and hi/lo must be int64.
	var hi int64 = (cast(int64, 1) << (w - 1)) - 1
	var lo int64 = 0 - (cast(int64, 1) << (w - 1))
	return val >= lo && val <= hi
}

// genLocalGroupDecl lowers a func-local grouped declaration (DECL_GROUP) per
// member kind (a group is homogeneous — the keyword fixes the member kind) and
// returns the possibly-advanced block:
//   - const group → genConstGroup registers every member (with iota /
//     bare-repeat) in Module.Consts; reads resolve via emitModuleConstByName
//     (genFunc truncates these per function), so no per-member var slot is
//     needed.  This is why a member may use `iota`, which has no runtime
//     lowering — its value is folded at registration time.
//   - var group → materialize each member like a single local var, threading
//     the block through ctx.CurBlock (an initializer may split blocks).
//   - type group → func-local `type` decls are rejected by the checker
//     (decl.type.package-only), so this never reaches IR-gen; nothing to do.
func genLocalGroupDecl(ctx @GenContext, b @Block, d @ast.Decl) @Block {
	if len(d.Decls) == 0 { return b }
	if d.Decls[0].Kind == ast.DECL_CONST {
		genConstGroup(ctx.Gc, ctx.Checker, d)
		return b
	}
	var mb @Block = b
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m.Kind == ast.DECL_VAR {
			ctx.CurBlock = mb
			genDecl(ctx, mb, m)
			mb = ctx.CurBlock
		}
	}
	return mb
}

// genConst registers a single constant declaration in Module.Consts.
// For a bare top-level `const X int = <expr>`, iota is 0 (no group).
// classifyConstLit handles the non-integer literal cases (string, bool,
// float) — setting Kind + the matching value slot, bypassing the
// integer-only evalConstExpr — so read sites emit the matching
// OP_CONST_* rather than a zero-int placeholder.
func genConst(gc @GenCtx, c @types.Checker, d @ast.Decl) {
	if d.Value == nil { return }
	var mc ModuleConst
	mc.Name = buf.CopyStr(d.Name)
	if d.TypeRef != nil {
		mc.Typ = resolveTypeExpr(gc, d.TypeRef)
	}
	if classifyConstLit(&mc, d.Value) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	// Prefer the boolean value the checker recorded on the initializer's type
	// (the HasBoolVal carrier attachConstBoolVal stamps).  This keeps IR-gen in
	// lockstep with the checker for a relational comparison of unsigned operands
	// >= 2^63 — evalConstBool's host-int fold compares those SIGNED (a silent
	// miscompile).  Falls back to classifyConstBoolExpr when nothing was stamped.
	if c != nil && d.Value.ResolvedTypeID != 0 {
		var t @types.Type = c.ExprType(d.Value.ResolvedTypeID)
		if t != nil && t.IsConstStamp && t.HasBoolVal {
			mc.BoolVal = t.BoolVal
			mc.Kind = CONST_BOOL
			gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
			return
		}
	}
	if classifyConstBoolExpr(gc, &mc, d.Value, 0) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	if classifyConstFloatExpr(gc, &mc, d.Value, 0) {
		gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
		return
	}
	var val int64
	var ok bool
	// Prefer the value the checker recorded on the initializer's type (the
	// HasLitVal carrier attachConstLitVal stamps).  This keeps IR-gen in
	// lockstep with the checker for /, %, >> over an unsigned operand >= 2^63 —
	// evalConstExpr's host-int fold would fold those SIGNED (a silent
	// miscompile).  bignumToInt is int64-exact, so a stamped 64-bit const keeps
	// its full value on every host.  Falls back to evalConstExpr (host int) when
	// no value was recorded — a bare-repeat member, which the checker also folds
	// host-int, so the two stay consistent.
	if c != nil && d.Value.ResolvedTypeID != 0 {
		var t @types.Type = c.ExprType(d.Value.ResolvedTypeID)
		if t != nil && t.IsConstStamp && t.HasLitVal {
			val = bignumToInt(t.LitMag, t.LitSign)
			ok = true
		}
	}
	if !ok {
		var ev int
		ev, ok = evalConstExpr(gc, d.Value, 0)
		val = cast(int64, ev)
	}
	if !ok { return }
	mc.Val = val
	if !constValueFitsSignedTarget(mc.Val, mc.Typ) {
		panic(
				"internal error: const value overflows its signed target type -- "
						"the type-checker fit gate (untypedIntLitFitsTarget) was bypassed "
						"(compiler bug)")
	}
	gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
}

// exprUsesIota reports whether e references `iota`, so a bare const-group
// member repeating e must be re-evaluated at its own iota rather than
// reusing the preceding explicit member's folded value/stamp.
func exprUsesIota(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return streq(e.Name, "iota") }
	if e.Kind == ast.EXPR_UNARY { return exprUsesIota(e.X) }
	if e.Kind == ast.EXPR_BINARY {
		if exprUsesIota(e.X) { return true }
		return exprUsesIota(e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		for i := 0; i < len(e.Args); i++ {
			if exprUsesIota(e.Args[i]) { return true }
		}
	}
	return false
}

// genConstGroup registers a group of iota constants in Module.Consts.
// Skips parked members (the REPL's Tier 3 forward-ref machinery
// marks individual const members as pending when their value
// expression references undefined names — see plan-repl-tier3-
// pending-types.md Stage 1 (c)).  iotaVal still increments
// across the parked positions so resolved members get the
// correct positional iota — the same value retry will give
// the parked member when it eventually lands via GenConstMember.
func genConstGroup(gc @GenCtx, c @types.Checker, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Go-style iota-repeat: a bare const-group member repeats the closest
	// PRECEDING member's initializer EXPRESSION and TYPE, re-evaluated with
	// its own iota — so `const ( B0 int = 1 << iota; B1; B2 )` yields 1,2,4
	// (the bit-flag idiom), not plain iota 1,1,2.  prevExpr / prevTyp carry
	// that spec across bare members; in a mixed-type group a bare member
	// therefore inherits the PRECEDING member's type, not the first
	// member's.
	var prevExpr @ast.Expr = nil
	var prevTyp @types.Type = nil
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			if c != nil && c.IsPendingDecl(cd.Name) {
				// Parked member.  Still increment iotaVal so
				// the next resolved member's iota reflects
				// source position.  retryPending's
				// GenConstMember path will register this
				// member when its dep arrives, using the same
				// iotaVal (preserved on the PendingDecl).
				iotaVal = iotaVal + 1
				continue
			}
			var mc ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			// Effective type: the member's own type if it has one, else the
			// preceding member's (inherited across bare members).
			var memberTyp @types.Type = prevTyp
			if cd.TypeRef != nil {
				memberTyp = resolveTypeExpr(gc, cd.TypeRef)
			}
			prevTyp = memberTyp
			// A bare member repeats prevExpr; an explicit member updates
			// it.  valExpr is the expression to evaluate at this position.
			var valExpr @ast.Expr = cd.Value
			if valExpr == nil {
				valExpr = prevExpr
			} else {
				prevExpr = cd.Value
			}
			// An EXPLICIT member (cd.Value != nil) prefers the checker's
			// signedness-aware stamp on its OWN node (HasLitVal / HasBoolVal,
			// like genConst) — so a grouped `Q uint64 = U / D` (U >= 2^63) folds
			// UNSIGNED, where evalConstExpr below would fold it as a signed host
			// int.  A BARE member re-uses prevExpr's shared node, whose stamp
			// belongs to the explicit member, so it keeps the host-int fold.
			// A BARE member that repeats a NON-iota expression has the SAME
			// value as the explicit member it repeats, so it reuses that
			// member's stamp on the shared prevExpr node (the checker restores
			// prevExpr's stamp after the bare re-check) — otherwise a bare
			// repeat of `U / D` (U >= 2^63) folds signed via the host int.  An
			// IOTA-using repeat is re-evaluated below at THIS member's iota.
			var stamped bool = false
			var stampExpr @ast.Expr = nil
			if cd.Value != nil {
				stampExpr = cd.Value
			} else if valExpr != nil && !exprUsesIota(valExpr) {
				stampExpr = valExpr
			}
			if stampExpr != nil && c != nil && stampExpr.ResolvedTypeID != 0 {
				var st @types.Type = c.ExprType(stampExpr.ResolvedTypeID)
				if st != nil && st.IsConstStamp && st.HasBoolVal {
					mc.BoolVal = st.BoolVal
					mc.Kind = CONST_BOOL
					stamped = true
				} else if st != nil && st.IsConstStamp && st.HasLitVal {
					mc.Val = bignumToInt(st.LitMag, st.LitSign)
					stamped = true
				}
			}
			if !stamped {
				if valExpr != nil {
					if !classifyConstLit(&mc, valExpr) && !classifyConstBoolExpr(gc, &mc, valExpr, iotaVal) &&
							!classifyConstFloatExpr(gc, &mc, valExpr, iotaVal) {
						var v int
						var ok bool
						v, ok = evalConstExpr(gc, valExpr, iotaVal)
						if ok {
							mc.Val = cast(int64, v)
						} else {
							mc.Val = cast(int64, iotaVal)
						}
					}
				} else {
					// First member is bare (no expression to repeat): plain iota.
					mc.Val = cast(int64, iotaVal)
				}
			}
			mc.Typ = memberTyp
			// Defensive (see constValueFitsSignedTarget): a bool/float member's
			// mc.Typ is non-integer, so the guard no-ops for those.
			if !constValueFitsSignedTarget(mc.Val, mc.Typ) {
				panic(
						"internal error: grouped const value overflows its signed "
								"target type -- the type-checker fit gate was bypassed "
								"(compiler bug)")
			}
			gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
