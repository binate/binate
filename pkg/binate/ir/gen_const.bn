package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Top-level const and global-var registration: global var type
// inference and the const producers (single + grouped, incl.
// iota).  Const-expression evaluation, literal classification,
// and float/bool folding live in gen_const_fold.bn.

// resolveGlobalVarType returns the type for a top-level
// `var` declaration.  When `d.TypeRef` is set, it's the
// resolved declared type.  When it's nil (untyped — `var x =
// expr`), the type is inferred from the initializer literal:
//
//   var x = 42        → int
//   var x = 1.5       → float64
//   var x = true      → bool
//   var x = 'a'       → char
//   var x = "hello"   → @[]readonly char
//
// Returns nil for non-literal initializers (function calls,
// arithmetic, etc.) — caller surfaces a "type required" error.
// The type checker handles those for LOCAL vars via its full
// expression machinery; mirroring that for top-level vars
// would require threading the checker through IR-gen, which
// isn't worth the surface for the common-case literal init.
func resolveGlobalVarType(d @ast.Decl) @types.Type {
	if d.TypeRef != nil {
		return resolveTypeExpr(d.TypeRef)
	}
	if d.Value == nil { return nil }
	var e @ast.Expr = d.Value
	if e.Kind == ast.EXPR_INT_LIT { return types.TypInt() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypFloat64() }
	if e.Kind == ast.EXPR_STRING_LIT {
		return types.MakeManagedSliceType(
			types.MakeReadonlyType(types.TypUint8()))
	}
	return nil
}

// genConst registers a single constant declaration in moduleConsts.
// For a bare top-level `const X int = <expr>`, iota is 0 (no group).
// classifyConstLit handles the non-integer literal cases (string, bool,
// float) — setting Kind + the matching value slot, bypassing the
// integer-only evalConstExpr — so read sites emit the matching
// OP_CONST_* rather than a zero-int placeholder.
func genConst(d @ast.Decl) {
	if d.Value == nil { return }
	var mc ModuleConst
	mc.Name = buf.CopyStr(d.Name)
	if d.TypeRef != nil {
		mc.Typ = resolveTypeExpr(d.TypeRef)
	}
	if classifyConstLit(&mc, d.Value) {
		moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
		return
	}
	if classifyConstBoolExpr(&mc, d.Value, 0) {
		moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
		return
	}
	if classifyConstFloatExpr(&mc, d.Value, 0) {
		moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
		return
	}
	var val int
	var ok bool
	val, ok = evalConstExpr(d.Value, 0)
	if !ok { return }
	mc.Val = val
	moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
}

// genConstGroup registers a group of iota constants in moduleConsts.
// Skips parked members (the REPL's Tier 3 forward-ref machinery
// marks individual const members as pending when their value
// expression references undefined names — see plan-repl-tier3-
// pending-types.md Stage 1 (c)).  iotaVal still increments
// across the parked positions so resolved members get the
// correct positional iota — the same value retry will give
// the parked member when it eventually lands via GenConstMember.
func genConstGroup(c @types.Checker, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Go-style iota-repeat: a bare const-group member repeats the closest
	// PRECEDING member's initializer EXPRESSION and TYPE, re-evaluated with
	// its own iota — so `const ( B0 int = 1 << iota; B1; B2 )` yields 1,2,4
	// (the bit-flag idiom), not plain iota 1,1,2.  prevExpr / prevTyp carry
	// that spec across bare members; in a mixed-type group a bare member
	// therefore inherits the PRECEDING member's type, not the first
	// member's.
	var prevExpr @ast.Expr = nil
	var prevTyp @types.Type = nil
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			if c != nil &&
					c.IsPendingDecl(cd.Name) {
				// Parked member.  Still increment iotaVal so
				// the next resolved member's iota reflects
				// source position.  retryPending's
				// GenConstMember path will register this
				// member when its dep arrives, using the same
				// iotaVal (preserved on the PendingDecl).
				iotaVal = iotaVal + 1
				continue
			}
			var mc ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			// Effective type: the member's own type if it has one, else the
			// preceding member's (inherited across bare members).
			var memberTyp @types.Type = prevTyp
			if cd.TypeRef != nil {
				memberTyp = resolveTypeExpr(cd.TypeRef)
			}
			prevTyp = memberTyp
			// A bare member repeats prevExpr; an explicit member updates
			// it.  valExpr is the expression to evaluate at this position.
			var valExpr @ast.Expr = cd.Value
			if valExpr == nil {
				valExpr = prevExpr
			} else {
				prevExpr = cd.Value
			}
			if valExpr != nil {
				if !classifyConstLit(&mc, valExpr) &&
						!classifyConstBoolExpr(&mc, valExpr, iotaVal) &&
						!classifyConstFloatExpr(&mc, valExpr, iotaVal) {
					var v int
					var ok bool
					v, ok = evalConstExpr(valExpr, iotaVal)
					if ok {
						mc.Val = v
					} else {
						mc.Val = iotaVal
					}
				}
			} else {
				// First member is bare (no expression to repeat): plain iota.
				mc.Val = iotaVal
			}
			mc.Typ = memberTyp
			moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
