package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Compile-time evaluation and classification of const
// initializers: integer / boolean const-expression folding,
// literal-kind classification, float-const text extraction, and
// iota substitution.  The producers that consume these
// (genConst / genConstGroup) live in gen_const.bn.

// evalConstExpr evaluates a compile-time constant integer expression
// against the current iota counter and the already-registered entries
// in moduleConsts.  Returns (value, ok); ok=false signals that the
// expression can't be reduced (e.g. references a non-integer const, an
// unsupported AST kind, or a forward reference not yet in
// moduleConsts).  Callers fall back to `iotaVal` on !ok to preserve
// the pre-fix bare-iota behavior so a regression doesn't quietly
// produce a different wrong value than before.
//
// Supports the const-expression forms used by pkg/binate/asm/aarch64 and
// pkg/binate/token's constant tables: literal ints, bare iota, references to
// previously-registered consts (bare or `pkg.Name`-qualified), unary
// minus, and the integer binary ops (+, -, *, /, %, |, ^, &, <<, >>).
// The reason this exists at all: `D0 int = iota + 32` and similar in
// pkg/binate/asm/aarch64.bni were silently truncated to `iotaVal` (so D0=0
// instead of 32), which gave bnc the wrong values for `aarch64.D16` /
// `aarch64.D17`, which in turn made `FP_SCRATCH_A` / `FP_SCRATCH_B`
// both 0, so emitFloatBinop's two FMOVs targeted the same Dn —
// causing `1.5 + 2.5` to compute `2.5 + 2.5 = 5.0`.  The bug only
// became externally visible once the
// builder-comp_native_aa64-comp_native_aa64 mode ran tests through a
// self-hosted bnc binary; under bootstrap interp the Go-side const
// evaluator handles all of these forms directly.
func evalConstExpr(e @ast.Expr, iotaVal int) (int, bool) {
	if e == nil { return 0, false }
	if e.Kind == ast.EXPR_INT_LIT { return parseIntLit(e.Name), true }
	if e.Kind == ast.EXPR_CHAR_LIT { return parseCharLit(e.Name), true }
	if e.Kind == ast.EXPR_IDENT {
		if streq(e.Name, "iota") { return iotaVal, true }
		var v int
		var t @types.Type
		var ok bool
		v, t, ok = lookupConst(e.Name)
		// t is unused (we only care about the integer value); read it
		// to satisfy any unused-binding diagnostics.
		if t == nil { t = nil }
		if ok { return v, true }
		// While processing an imported package's .bni consts, sibling
		// references appear unqualified ("WORDS") but are registered
		// under the import-qualified name ("pkg/x.WORDS").  Retry with
		// the current import alias so e.g. `const SIZE int = WORDS * 8`
		// in pkg/x.bni evaluates correctly when consumed from pkg/y.
		if len(currentImportAlias) > 0 {
			var qn @[]char = buildQualName(currentImportAlias, e.Name)
			v, t, ok = lookupConst(qn)
			if t == nil { t = nil }
			if ok { return v, true }
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return 0, false }
		var qn @[]char = buildQualName(e.X.Name, e.Name)
		var v int
		var t @types.Type
		var ok bool
		v, t, ok = lookupConst(qn)
		if t == nil { t = nil }
		if ok { return v, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_UNARY {
		var x int
		var ok bool
		x, ok = evalConstExpr(e.X, iotaVal)
		if !ok { return 0, false }
		if e.Op == cast(int, token.MINUS) { return -x, true }
		if e.Op == cast(int, token.PLUS) { return x, true }
		if e.Op == cast(int, token.TILDE) { return -x - 1, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_BINARY {
		var lhs int
		var lok bool
		lhs, lok = evalConstExpr(e.X, iotaVal)
		if !lok { return 0, false }
		var rhs int
		var rok bool
		rhs, rok = evalConstExpr(e.Y, iotaVal)
		if !rok { return 0, false }
		if e.Op == cast(int, token.PLUS)    { return lhs + rhs, true }
		if e.Op == cast(int, token.MINUS)   { return lhs - rhs, true }
		if e.Op == cast(int, token.STAR)    { return lhs * rhs, true }
		if e.Op == cast(int, token.SLASH) {
			if rhs == 0 { return 0, false }
			return lhs / rhs, true
		}
		if e.Op == cast(int, token.PERCENT) {
			if rhs == 0 { return 0, false }
			return lhs - (lhs / rhs) * rhs, true
		}
		if e.Op == cast(int, token.AMP)     { return lhs & rhs, true }
		if e.Op == cast(int, token.PIPE)    { return lhs | rhs, true }
		if e.Op == cast(int, token.CARET)   { return lhs ^ rhs, true }
		if e.Op == cast(int, token.SHL)     { return lhs << rhs, true }
		if e.Op == cast(int, token.SHR)     { return lhs >> rhs, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_BUILTIN {
		if e.Op == cast(int, token.SIZEOF) {
			var t @types.Type = resolveTypeExpr(e.TypeRef)
			if t == nil { return 0, false }
			return t.SizeOf(), true
		}
		if e.Op == cast(int, token.ALIGNOF) {
			var t @types.Type = resolveTypeExpr(e.TypeRef)
			if t == nil { return 0, false }
			return t.AlignOf(), true
		}
		if e.Op == cast(int, token.CAST) {
			// Integer cast over a constant operand: pass the value through
			// unchanged.  The checker rejects an out-of-range constant cast
			// (checkCastConstFits, in value and array-dim position; a cast of a
			// constant does not launder it), so a cast that folds here is
			// (almost always) in range and passthrough exact.  Non-integer casts
			// (float → int etc.) aren't supported — the operand doesn't fold.
			// (EXCEPTION: the checker folds const arithmetic exactly in bignum
			// but has no bignum bitwise ops, so a cast over a const BITWISE/shift
			// expression whose magnitude is >= 2^63 can slip through out of range
			// — pkg/binate/types h-bitwise.)
			if len(e.Args) == 0 { return 0, false }
			return evalConstExpr(e.Args[0], iotaVal)
		}
		if e.Op == cast(int, token.BIT_CAST) {
			// bit_cast reinterprets the operand's bits as the target type:
			// truncate + sign-extend to the target width via the SAME helper
			// the type checker uses (types.ReinterpretBitCast), so the folded
			// value AGREES with the checker exactly — a bit_cast const reads
			// identically in both, and a bit_cast that reinterprets a positive
			// source into a negative shift count is rejected at compile time
			// instead of overshifting to 0 here.
			if len(e.Args) == 0 { return 0, false }
			var v int
			var ok bool
			v, ok = evalConstExpr(e.Args[0], iotaVal)
			if !ok { return 0, false }
			return types.ReinterpretBitCast(v, resolveTypeExpr(e.TypeRef)), true
		}
		return 0, false
	}
	return 0, false
}

// boolLitValue extracts the boolean value from an EXPR_BOOL_LIT node.
// The parser records the literal either as the text "true"/"false" in
// Name or directly in BoolVal, so both forms are handled — matching how
// the expression path lowers a bool literal in genExpr.
func boolLitValue(e @ast.Expr) bool {
	if len(e.Name) > 0 { return streq(e.Name, "true") }
	return e.BoolVal
}

// floatConstText returns the raw float-literal text for a const
// initializer that is a float literal — bare, or negated via unary
// minus.  `-1.5` parses as EXPR_UNARY(MINUS) over EXPR_FLOAT_LIT, so the
// sign is folded back into the text the backend parses (otherwise a
// negative float const falls through to the integer-only evalConstExpr,
// is dropped, and reads back as 0.0).  ok=false when the initializer is
// not a (possibly-negated) float literal.
func floatConstText(e @ast.Expr) (@[]char, bool) {
	var none @[]char
	if e == nil { return none, false }
	if e.Kind == ast.EXPR_FLOAT_LIT { return e.Name, true }
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.MINUS) &&
			e.X != nil && e.X.Kind == ast.EXPR_FLOAT_LIT {
		var b @strings.Builder = strings.NewBuilder()
		b.WriteByte('-')
		b.Write(e.X.Name)
		return buf.CopyStr(b.String()), true
	}
	return none, false
}

// classifyConstLit populates mc.Kind and the matching value slot when a
// const initializer is a bool or (possibly-negated) float literal, and
// reports whether it matched.  Centralizes the non-integer scalar
// literal recognition shared by every const producer (single + group,
// in-package + imported); callers fall back to the integer evalConstExpr
// path when it returns false.  Consts are scalar-only, so there is no
// string case (string-typed const decls are rejected by the type
// checker).
func classifyConstLit(mc *ModuleConst, e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_BOOL_LIT {
		mc.BoolVal = boolLitValue(e)
		mc.Kind = CONST_BOOL
		return true
	}
	var fltText @[]char
	var isFlt bool
	fltText, isFlt = floatConstText(e)
	if isFlt {
		mc.FltText = fltText
		mc.Kind = CONST_FLT
		return true
	}
	return false
}

// evalConstBool folds a compile-time constant BOOLEAN expression to
// (value, ok): a bool literal, a comparison of two constant integers
// (==, !=, <, >, <=, >=), or the logical operators && / || over bool
// operands and ! of one.  Comparison operands go through the integer
// evalConstExpr, so `1 < 2`, `N == 3`, `A <= B` fold; float-operand
// comparisons are not handled here (they need a float evaluator).
// ok=false for anything it can't fold — the caller then tries the
// integer evaluator.
func evalConstBool(e @ast.Expr, iotaVal int) (bool, bool) {
	if e == nil { return false, false }
	if e.Kind == ast.EXPR_BOOL_LIT { return boolLitValue(e), true }
	if e.Kind == ast.EXPR_IDENT {
		// A reference to another boolean const (`const C bool = !A`).
		var b bool
		var ok bool
		b, ok = lookupConstBool(e.Name)
		if ok { return b, true }
		// Imported sibling consts appear unqualified while their package's
		// .bni is processed — retry under the import alias (mirrors
		// evalConstExpr).
		if len(currentImportAlias) > 0 {
			b, ok = lookupConstBool(buildQualName(currentImportAlias, e.Name))
			if ok { return b, true }
		}
		return false, false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		// Package-qualified boolean const (`pkg.Flag`).
		if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return false, false }
		return lookupConstBool(buildQualName(e.X.Name, e.Name))
	}
	if e.Kind == ast.EXPR_UNARY {
		if e.Op == cast(int, token.NOT) {
			var x bool
			var ok bool
			x, ok = evalConstBool(e.X, iotaVal)
			if !ok { return false, false }
			return !x, true
		}
		return false, false
	}
	if e.Kind == ast.EXPR_BINARY {
		if e.Op == cast(int, token.LAND) || e.Op == cast(int, token.LOR) {
			var l bool
			var lok bool
			l, lok = evalConstBool(e.X, iotaVal)
			if !lok { return false, false }
			var r bool
			var rok bool
			r, rok = evalConstBool(e.Y, iotaVal)
			if !rok { return false, false }
			if e.Op == cast(int, token.LAND) { return l && r, true }
			return l || r, true
		}
		var li int
		var lok2 bool
		li, lok2 = evalConstExpr(e.X, iotaVal)
		if !lok2 { return false, false }
		var ri int
		var rok2 bool
		ri, rok2 = evalConstExpr(e.Y, iotaVal)
		if !rok2 { return false, false }
		if e.Op == cast(int, token.EQ)  { return li == ri, true }
		if e.Op == cast(int, token.NEQ) { return li != ri, true }
		if e.Op == cast(int, token.LT)  { return li < ri, true }
		if e.Op == cast(int, token.GT)  { return li > ri, true }
		if e.Op == cast(int, token.LEQ) { return li <= ri, true }
		if e.Op == cast(int, token.GEQ) { return li >= ri, true }
		return false, false
	}
	return false, false
}

// classifyConstBoolExpr sets mc to a CONST_BOOL when e folds to a
// constant boolean (comparison / bool logic), returning whether it did.
// Runs after classifyConstLit (which handles a bare bool literal) and
// before the integer evalConstExpr in every const producer, so a const
// whose initializer is a comparison (`const T bool = 1 < 2`) registers
// as a bool rather than being dropped and read back as int 0.
func classifyConstBoolExpr(mc *ModuleConst, e @ast.Expr, iotaVal int) bool {
	var v bool
	var ok bool
	v, ok = evalConstBool(e, iotaVal)
	if !ok { return false }
	mc.BoolVal = v
	mc.Kind = CONST_BOOL
	return true
}

// isFloatExpr reports whether e is a floating-point EXPRESSION — built
// from at least one float literal through the unary/binary operators
// (`0.5 * 0.5`, `-1.5 + 2.0`).  A bare/negated float LITERAL is handled
// earlier by classifyConstLit, so this gate fires only for genuine float
// arithmetic.  Gating on the presence of a float literal (rather than on
// the const's declared float type) keeps an int-valued initializer
// assigned to a float const (`const Q float64 = 2 / 1`) on the integer
// path, where it belongs.
func isFloatExpr(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_FLOAT_LIT { return true }
	// A reference to an already-registered float const (CONST_FLT /
	// CONST_EXPR) makes its containing expression float — so
	// `const C float64 = A + B` (no float literal) is recognized rather
	// than falling to the integer path and reading back int 0.
	if e.Kind == ast.EXPR_IDENT { return isFloatConstIdent(e.Name) }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil &&
			e.X.Kind == ast.EXPR_IDENT {
		return isFloatConstIdent(buildQualName(e.X.Name, e.Name))
	}
	if e.Kind == ast.EXPR_UNARY { return isFloatExpr(e.X) }
	if e.Kind == ast.EXPR_BINARY {
		return isFloatExpr(e.X) || isFloatExpr(e.Y)
	}
	return false
}

// isFloatConstIdent reports whether name resolves to a float const
// already registered in moduleConsts (CONST_FLT or CONST_EXPR).
func isFloatConstIdent(name *[]readonly char) bool {
	for i := 0; i < len(moduleConsts); i++ {
		if streq(moduleConsts[i].Name, name) {
			return moduleConsts[i].Kind == CONST_FLT ||
				moduleConsts[i].Kind == CONST_EXPR
		}
	}
	return false
}

// substituteIota returns a copy of e with every `iota` identifier
// replaced by the integer literal iotaVal.  A float const-EXPRESSION is
// stashed as a CONST_EXPR AST and re-lowered at the read site, where
// `iota` is not in scope (it would lower to 0); baking the group
// member's iota into the stored AST keeps the re-lowered value correct
// (e.g. `1.5 * cast(float64, iota)` for member 2 becomes `1.5 *
// cast(float64, 2)`).  Only the node kinds a float const-expr can
// contain are deep-copied; other kinds pass through unchanged.
func substituteIota(e @ast.Expr, iotaVal int) @ast.Expr {
	if e == nil { return e }
	if e.Kind == ast.EXPR_IDENT {
		if streq(e.Name, "iota") {
			var lit @ast.Expr = make(ast.Expr)
			lit.Kind = ast.EXPR_INT_LIT
			lit.Name = strconv.Itoa(iotaVal)
			lit.Pos = e.Pos
			return lit
		}
		return e
	}
	if e.Kind == ast.EXPR_UNARY {
		var nu @ast.Expr = make(ast.Expr)
		nu.Kind = e.Kind
		nu.Op = e.Op
		nu.Pos = e.Pos
		nu.X = substituteIota(e.X, iotaVal)
		return nu
	}
	if e.Kind == ast.EXPR_BINARY {
		var nb @ast.Expr = make(ast.Expr)
		nb.Kind = e.Kind
		nb.Op = e.Op
		nb.Pos = e.Pos
		nb.X = substituteIota(e.X, iotaVal)
		nb.Y = substituteIota(e.Y, iotaVal)
		return nb
	}
	if e.Kind == ast.EXPR_BUILTIN {
		var nc @ast.Expr = make(ast.Expr)
		nc.Kind = e.Kind
		nc.Op = e.Op
		nc.Pos = e.Pos
		nc.TypeRef = e.TypeRef
		var args @[]@ast.Expr
		for i := 0; i < len(e.Args); i++ {
			args = slices.Append[@ast.Expr](args,
				substituteIota(e.Args[i], iotaVal))
		}
		nc.Args = args
		return nc
	}
	return e
}

// classifyConstFloatExpr records a float const-EXPRESSION as CONST_EXPR,
// stashing the AST so the read site re-lowers it (genExpr) and the
// backend computes the value at runtime.  The float-const path carries
// decimal text through a decimal-only parser and OP_CONST_FLOAT holds no
// bits, so a compile-time-folded result can't be re-encoded as text
// exactly; emitting the expression yields the exact IEEE result — the
// same way a LOCAL float const materializes (genDecl's var-init path).
// Returns whether it matched.
func classifyConstFloatExpr(mc *ModuleConst, e @ast.Expr, iotaVal int) bool {
	if !isFloatExpr(e) { return false }
	mc.Expr = substituteIota(e, iotaVal)
	mc.Kind = CONST_EXPR
	return true
}
