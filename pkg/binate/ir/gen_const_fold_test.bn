package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for const-expression evaluation and folding
// (evalConstExpr / evalConstBool) in gen_const_fold.bn.

// Pin the literal-int base case: `42` → 42, ok=true.
func TestEvalConstExprIntLit() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), mkIntLitExpr("42"), 0)
	if !ok { return fail("int lit eval failed") }
	if v != 42 { return fail("int lit value wrong") }
	return ""
}

// The bare-iota identifier should resolve to the supplied
// iotaVal.  Pins the const-group counter contract.
func TestEvalConstExprBareIota() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), mkIdentExpr("iota"), 5)
	if !ok { return fail("iota eval failed") }
	if v != 5 { return fail("iota didn't return iotaVal") }
	return ""
}

// `iota + 32` — the pattern pkg/binate/asm/aarch64.bni uses for D0..D31.
// Pre-fix, this returned iotaVal alone (e.g. 0 for D0), making
// FP_SCRATCH_A / B collide.  Post-fix, with iotaVal=16 it should
// return 48 (= D16's intended value).
func TestEvalConstExprIotaPlusOffset() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.PLUS), mkIdentExpr("iota"), mkIntLitExpr("32"))
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 16)
	if !ok { return fail("iota+32 eval failed") }
	if v != 48 { return fail("iota+32 with iota=16 should yield 48") }
	return ""
}

// `sizeof(int8)` evaluates at compile time.  Pre-extension, the
// const evaluator silently dropped EXPR_BUILTIN — so a const init
// like `const HEADER_SIZE int = sizeof(int)` resolved to 0.  Pin
// the working post-extension behavior with a target-independent
// type (int8 is always 1 byte).
func TestEvalConstExprSizeofInt8() testing.TestResult {
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.SIZEOF), mkNamedTypeExpr("int8"), emptyExprList())
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 0)
	if !ok { return fail("sizeof(int8) eval failed") }
	if v != 1 { return fail("sizeof(int8) should be 1") }
	return ""
}

// `alignof(int32)` — target-independent (4 on every supported
// target).
func TestEvalConstExprAlignofInt32() testing.TestResult {
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.ALIGNOF), mkNamedTypeExpr("int32"),
			emptyExprList())
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 0)
	if !ok { return fail("alignof(int32) eval failed") }
	if v != 4 { return fail("alignof(int32) should be 4") }
	return ""
}

// `cast(int, 42)` — over a constant operand, value passes
// through.  pkg/builtins/rt's `HEADER_SIZE int = HEADER_WORDS * cast(int,
// sizeof(int))` shape requires this.
func TestEvalConstExprCastPassThrough() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, mkIntLitExpr("42"))
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.CAST), mkNamedTypeExpr("int"), args)
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 0)
	if !ok { return fail("cast(int, 42) eval failed") }
	if v != 42 { return fail("cast pass-through value wrong") }
	return ""
}

// `bit_cast(int, 7)` — same pass-through behavior as cast.
func TestEvalConstExprBitCastPassThrough() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, mkIntLitExpr("7"))
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.BIT_CAST), mkNamedTypeExpr("int"), args)
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 0)
	if !ok { return fail("bit_cast(int, 7) eval failed") }
	if v != 7 { return fail("bit_cast pass-through value wrong") }
	return ""
}

// 2 * cast(int, sizeof(int8)) — the exact shape pkg/builtins/rt.HEADER_SIZE
// uses (but with a target-independent type so the expected value
// pins).  Combines binary + builtin + cast in one expression.
func TestEvalConstExprCompositeWithSizeof() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args,
			mkBuiltinExpr(cast(int, token.SIZEOF), mkNamedTypeExpr("int8"), emptyExprList()))
	var inner @ast.Expr = mkBuiltinExpr(cast(int, token.CAST), mkNamedTypeExpr("int"), args)
	var e @ast.Expr = mkBinaryExpr(cast(int, token.STAR), mkIntLitExpr("2"), inner)
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 0)
	if !ok { return fail("2 * cast(int, sizeof(int8)) eval failed") }
	if v != 2 { return fail("composite should be 2") }
	return ""
}

// `1 << iota` — pattern used for bitflag constants.  Pre-fix this
// also degraded to iotaVal.
func TestEvalConstExprShlIota() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.SHL), mkIntLitExpr("1"), mkIdentExpr("iota"))
	var v int
	var ok bool
	v, ok = evalConstExpr(NewGenCtx(nil), e, 4)
	if !ok { return fail("1<<iota eval failed") }
	if v != 16 { return fail("1<<4 should yield 16") }
	return ""
}

// An identifier referencing a previously-registered const in the
// module's Consts table should resolve to that value.  Required so
// `const FP_SCRATCH_A int = aarch64.D16` — a single-decl const
// whose value is a SelectorExpr — finds D16 in the Consts table.
func TestEvalConstExprIdentFromModuleConsts() testing.TestResult {
	// Register a fake const, then look it up by IDENT name.
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mc ModuleConst
	mc.Name = "ANSWER"
	mc.Val = 42
	m.Consts = slices.Append[ModuleConst](m.Consts, mc)
	var v int
	var ok bool
	v, ok = evalConstExpr(gc, mkIdentExpr("ANSWER"), 0)
	if !ok { return fail("ident from the Consts table failed") }
	if v != 42 { return fail("ANSWER should be 42") }
	return ""
}

// EXPR_SELECTOR `pkg.NAME` must build the qualified name and
// look it up in the module's Consts table.  The exact path that
// resolves `aarch64.D16` inside `const FP_SCRATCH_A int = aarch64.D16`.
func TestEvalConstExprQualifiedSelector() testing.TestResult {
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mc ModuleConst
	mc.Name = "fake.X"
	mc.Val = 99
	m.Consts = slices.Append[ModuleConst](m.Consts, mc)
	var sel @ast.Expr = make(ast.Expr)
	sel.Kind = ast.EXPR_SELECTOR
	sel.X = mkIdentExpr("fake")
	sel.Name = "X"
	var v int
	var ok bool
	v, ok = evalConstExpr(gc, sel, 0)
	if !ok { return fail("selector eval failed") }
	if v != 99 { return fail("fake.X should resolve to 99") }
	return ""
}

// Unknown identifier returns (0, false).  Caller (genConstGroup,
// registerImportConstGroup) then falls back to iotaVal, matching
// the pre-fix bare-iota behavior so a new unsupported expression
// shape produces the previous wrong value rather than a different
// one.
func TestEvalConstExprUnknownIdent() testing.TestResult {
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var v int
	var ok bool
	v, ok = evalConstExpr(gc, mkIdentExpr("NOT_REGISTERED_ANYWHERE"), 3)
	if ok { return fail("unknown ident should return ok=false") }
	if v != 0 { return fail("unknown ident should yield 0") }
	return ""
}

// mkBoolLitExpr builds an EXPR_BOOL_LIT recording "true"/"false" in Name,
// per the parser convention (see mkConstBoolDecl in gen_const_test.bn).
func mkBoolLitExpr(value bool) @ast.Expr {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = ast.EXPR_BOOL_LIT
	if value {
		v.Name = "true"
	} else {
		v.Name = "false"
	}
	return v
}

// mkNotExpr builds a `!x` unary expression.
func mkNotExpr(x @ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_UNARY
	e.Op = cast(int, token.NOT)
	e.X = x
	return e
}

// evalConstBool folds NOT / LAND / LOR over boolean literals.
func TestEvalConstBoolLiteralLogic() testing.TestResult {
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var a @ast.Expr = mkBoolLitExpr(true)
	var b @ast.Expr = mkBoolLitExpr(false)
	var v bool
	var ok bool
	v, ok = evalConstBool(gc, mkBinaryExpr(cast(int, token.LAND), a, b), 0)
	if !ok || v { return fail("true && false should fold to false") }
	v, ok = evalConstBool(gc, mkBinaryExpr(cast(int, token.LOR), a, b), 0)
	if !ok || !v { return fail("true || false should fold to true") }
	v, ok = evalConstBool(gc, mkNotExpr(a), 0)
	if !ok || v { return fail("!true should fold to false") }
	return ""
}

// evalConstBool resolves a reference to another boolean const — the
// `const C bool = !A` case that previously misfolded to int 0.
func TestEvalConstBoolConstRef() testing.TestResult {
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mc ModuleConst
	mc.Name = "A"
	mc.Kind = CONST_BOOL
	mc.BoolVal = false
	m.Consts = slices.Append[ModuleConst](m.Consts, mc)
	var v bool
	var ok bool
	v, ok = evalConstBool(gc, mkNotExpr(mkIdentExpr("A")), 0)
	if !ok || !v { return fail("!A (A=false) should fold to true") }
	return ""
}

// constValueFitsSignedTarget is the defensive guard genConst/genConstGroup use
// to fail loud (instead of silently host-int-wrapping) if a checker bypass ever
// lets a signed-overflow const reach IR-gen.  The checker is the live gate, so
// this only pins the guard's LOGIC (the producers panic on a false result).
func TestConstValueFitsSignedTargetGuard() testing.TestResult {
	// int32: boundaries fit; 2^31 (the `1<<31` overflow) does NOT.
	if !constValueFitsSignedTarget(2147483647, types.TypInt32()) {
		return fail("INT32_MAX must fit int32")
	}
	if !constValueFitsSignedTarget(0 - 2147483648, types.TypInt32()) {
		return fail("INT32_MIN must fit int32")
	}
	if constValueFitsSignedTarget(2147483648, types.TypInt32()) {
		return fail("2^31 must NOT fit int32 (the 1<<31 sign-bit overflow case)")
	}
	// int8 boundaries.
	if !constValueFitsSignedTarget(127, types.TypInt8()) {
		return fail("127 must fit int8")
	}
	if !constValueFitsSignedTarget(0 - 128, types.TypInt8()) {
		return fail("-128 must fit int8")
	}
	if constValueFitsSignedTarget(128, types.TypInt8()) {
		return fail("128 must NOT fit int8")
	}
	// A 64-bit signed target is a host-bounded no-op: the host int IS that
	// width, so an overflowed 2^63 is already an indistinguishable wrapped bit
	// pattern -- only the checker's bignum sees it (always returns true here).
	if !constValueFitsSignedTarget(2147483648, types.TypInt64()) {
		return fail("width-64 signed target must be a no-op (always fits)")
	}
	// Unsigned target: not a SIGNED target, so a no-op.
	if !constValueFitsSignedTarget(2147483648, types.TypUint32()) {
		return fail("unsigned target must be a no-op (always fits)")
	}
	// nil target: no-op.
	if !constValueFitsSignedTarget(123, nil) {
		return fail("nil target must be a no-op")
	}
	return ""
}
