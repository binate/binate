package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/slices"

// ============================================================
// resolveGlobalVarType — direct coverage
// ============================================================
//
// Exercises the literal-init inference helper independently of
// the GeneratePackage / GenDecl drivers that consume it.  The
// integration-level tests (TestGenDeclVarUntypedLiteralAccepted,
// 352_global_var_untyped conformance) cover most kinds, but the
// EXPR_FLOAT_LIT branch had no end-to-end exerciser, and a
// direct test pins the per-kind mapping for future readers.

func TestResolveGlobalVarTypeIntLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_INT_LIT, "42")
	var t @types.Type = resolveGlobalVarType(d)
	if t == nil { return fail("int lit: expected non-nil") }
	if t.Kind != types.TYP_INT { return fail("int lit: wrong kind") }
	return ""
}

func TestResolveGlobalVarTypeBoolLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_BOOL_LIT, "true")
	var t @types.Type = resolveGlobalVarType(d)
	if t == nil { return fail("bool lit: expected non-nil") }
	if t.Kind != types.TYP_BOOL { return fail("bool lit: wrong kind") }
	return ""
}

func TestResolveGlobalVarTypeCharLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_CHAR_LIT, "A")
	var t @types.Type = resolveGlobalVarType(d)
	if t == nil { return fail("char lit: expected non-nil") }
	// char is uint8.
	if t.Kind != types.TYP_INT { return fail("char lit: wrong kind") }
	if t.Width != 8 { return fail("char lit: wrong width") }
	return ""
}

func TestResolveGlobalVarTypeFloatLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_FLOAT_LIT, "1.5")
	var t @types.Type = resolveGlobalVarType(d)
	if t == nil { return fail("float lit: expected non-nil") }
	if t.Kind != types.TYP_FLOAT {
		return fail("float lit: wrong kind")
	}
	return ""
}

func TestResolveGlobalVarTypeStringLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_STRING_LIT, "hi")
	var t @types.Type = resolveGlobalVarType(d)
	if t == nil { return fail("string lit: expected non-nil") }
	// Default is @[]const char — managed-slice of const-uint8.
	if t.Kind != types.TYP_MANAGED_SLICE {
		return fail("string lit: expected managed-slice default")
	}
	return ""
}

func TestResolveGlobalVarTypeNonLiteralReturnsNil() testing.TestResult {
	// `var x = a + b` — initializer is EXPR_BINARY, not a
	// recognized literal kind.  Must return nil so the caller
	// surfaces a "type required" diagnostic instead of silently
	// inferring something wrong.
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_BINARY, "")
	var t @types.Type = resolveGlobalVarType(d)
	if t != nil {
		return fail("non-literal init: expected nil (caller errors)")
	}
	return ""
}

func TestResolveGlobalVarTypeNoInitReturnsNil() testing.TestResult {
	// `var x` (no type, no initializer) is malformed at the
	// var-decl parse level, but the helper must not crash.
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = "x"
	var t @types.Type = resolveGlobalVarType(d)
	if t != nil { return fail("no init: expected nil") }
	return ""
}

// mkUntypedVarDecl builds `var x = <lit>` with no TypeRef and a
// synthetic Value of the requested kind.
func mkUntypedVarDecl(kind int, name @[]char) @ast.Decl {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = kind
	v.Name = name
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = "x"
	d.Value = v
	return d
}

// ============================================================
// evalConstExpr — direct coverage of the const-expression
// evaluator.  Pins the cases that pkg/binate/asm/aarch64.bni's
// `D0 int = iota + 32` (and friends) actually need: literal
// ints, bare iota, qualified selectors, and binary arithmetic.
//
// Pre-fix, the genConstGroup / registerImportConstGroup paths
// only handled EXPR_INT_LIT and silently fell back to the raw
// iota counter for everything else — so `D0 int = iota + 32`
// became 0, then 1, ..., 31 instead of 32..63.  That made
// FP_SCRATCH_A and FP_SCRATCH_B both resolve to 0 in a self-
// hosted bnc (`FP_SCRATCH_A int = aarch64.D16` got iotaVal=0
// from the non-group path), so emitFloatBinop's two FMOVs
// targeted the same Dn register and `1.5 + 2.5` computed
// `2.5 + 2.5 = 5.0`.
// ============================================================

func mkIntLitExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INT_LIT
	e.Name = s
	return e
}

func mkIdentExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Name = s
	return e
}

func mkBinaryExpr(op int, x @ast.Expr, y @ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BINARY
	e.Op = op
	e.X = x
	e.Y = y
	return e
}

// Pin the literal-int base case: `42` → 42, ok=true.
func TestEvalConstExprIntLit() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalConstExpr(mkIntLitExpr("42"), 0)
	if !ok { return fail("int lit eval failed") }
	if v != 42 { return fail("int lit value wrong") }
	return ""
}

// The bare-iota identifier should resolve to the supplied
// iotaVal.  Pins the const-group counter contract.
func TestEvalConstExprBareIota() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalConstExpr(mkIdentExpr("iota"), 5)
	if !ok { return fail("iota eval failed") }
	if v != 5 { return fail("iota didn't return iotaVal") }
	return ""
}

// `iota + 32` — the pattern pkg/binate/asm/aarch64.bni uses for D0..D31.
// Pre-fix, this returned iotaVal alone (e.g. 0 for D0), making
// FP_SCRATCH_A / B collide.  Post-fix, with iotaVal=16 it should
// return 48 (= D16's intended value).
func TestEvalConstExprIotaPlusOffset() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.PLUS),
		mkIdentExpr("iota"),
		mkIntLitExpr("32"))
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 16)
	if !ok { return fail("iota+32 eval failed") }
	if v != 48 { return fail("iota+32 with iota=16 should yield 48") }
	return ""
}

// emptyExprList returns a freshly-typed nil-value @[]@ast.Expr —
// useful for builtin exprs (sizeof / alignof) that take no Args.
// Bootstrap rejects bare `nil` in `@[]T` parameter position.
func emptyExprList() @[]@ast.Expr {
	var empty @[]@ast.Expr
	return empty
}

// Named-type expr helper for the sizeof / alignof tests below.
func mkNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

// Builtin-call expr (sizeof / alignof / cast / bit_cast) helper.
func mkBuiltinExpr(op int, typeRef @ast.TypeExpr, args @[]@ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Op = op
	e.TypeRef = typeRef
	e.Args = args
	return e
}

// `sizeof(int8)` evaluates at compile time.  Pre-extension, the
// const evaluator silently dropped EXPR_BUILTIN — so a const init
// like `const HEADER_SIZE int = sizeof(int)` resolved to 0.  Pin
// the working post-extension behavior with a target-independent
// type (int8 is always 1 byte).
func TestEvalConstExprSizeofInt8() testing.TestResult {
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.SIZEOF),
		mkNamedTypeExpr("int8"), emptyExprList())
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 0)
	if !ok { return fail("sizeof(int8) eval failed") }
	if v != 1 { return fail("sizeof(int8) should be 1") }
	return ""
}

// `alignof(int32)` — target-independent (4 on every supported
// target).
func TestEvalConstExprAlignofInt32() testing.TestResult {
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.ALIGNOF),
		mkNamedTypeExpr("int32"), emptyExprList())
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 0)
	if !ok { return fail("alignof(int32) eval failed") }
	if v != 4 { return fail("alignof(int32) should be 4") }
	return ""
}

// `cast(int, 42)` — over a constant operand, value passes
// through.  pkg/rt's `HEADER_SIZE int = HEADER_WORDS * cast(int,
// sizeof(int))` shape requires this.
func TestEvalConstExprCastPassThrough() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, mkIntLitExpr("42"))
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.CAST),
		mkNamedTypeExpr("int"), args)
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 0)
	if !ok { return fail("cast(int, 42) eval failed") }
	if v != 42 { return fail("cast pass-through value wrong") }
	return ""
}

// `bit_cast(int, 7)` — same pass-through behavior as cast.
func TestEvalConstExprBitCastPassThrough() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, mkIntLitExpr("7"))
	var e @ast.Expr = mkBuiltinExpr(cast(int, token.BIT_CAST),
		mkNamedTypeExpr("int"), args)
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 0)
	if !ok { return fail("bit_cast(int, 7) eval failed") }
	if v != 7 { return fail("bit_cast pass-through value wrong") }
	return ""
}

// 2 * cast(int, sizeof(int8)) — the exact shape pkg/rt.HEADER_SIZE
// uses (but with a target-independent type so the expected value
// pins).  Combines binary + builtin + cast in one expression.
func TestEvalConstExprCompositeWithSizeof() testing.TestResult {
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, mkBuiltinExpr(cast(int, token.SIZEOF),
		mkNamedTypeExpr("int8"), emptyExprList()))
	var inner @ast.Expr = mkBuiltinExpr(cast(int, token.CAST),
		mkNamedTypeExpr("int"), args)
	var e @ast.Expr = mkBinaryExpr(cast(int, token.STAR),
		mkIntLitExpr("2"), inner)
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 0)
	if !ok { return fail("2 * cast(int, sizeof(int8)) eval failed") }
	if v != 2 { return fail("composite should be 2") }
	return ""
}

// `1 << iota` — pattern used for bitflag constants.  Pre-fix this
// also degraded to iotaVal.
func TestEvalConstExprShlIota() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.SHL),
		mkIntLitExpr("1"),
		mkIdentExpr("iota"))
	var v int
	var ok bool
	v, ok = evalConstExpr(e, 4)
	if !ok { return fail("1<<iota eval failed") }
	if v != 16 { return fail("1<<4 should yield 16") }
	return ""
}

// An identifier referencing a previously-registered const in
// moduleConsts should resolve to that value.  Required so
// `const FP_SCRATCH_A int = aarch64.D16` — a single-decl const
// whose value is a SelectorExpr — finds D16 in moduleConsts.
func TestEvalConstExprIdentFromModuleConsts() testing.TestResult {
	// Register a fake const, then look it up by IDENT name.
	var mc ModuleConst
	mc.Name = "ANSWER"
	mc.Val = 42
	moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
	var v int
	var ok bool
	v, ok = evalConstExpr(mkIdentExpr("ANSWER"), 0)
	if !ok { return fail("ident from moduleConsts failed") }
	if v != 42 { return fail("ANSWER should be 42") }
	return ""
}

// EXPR_SELECTOR `pkg.NAME` must build the qualified name and
// look it up in moduleConsts.  The exact path that resolves
// `aarch64.D16` inside `const FP_SCRATCH_A int = aarch64.D16`.
func TestEvalConstExprQualifiedSelector() testing.TestResult {
	var mc ModuleConst
	mc.Name = "fake.X"
	mc.Val = 99
	moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
	var sel @ast.Expr = make(ast.Expr)
	sel.Kind = ast.EXPR_SELECTOR
	sel.X = mkIdentExpr("fake")
	sel.Name = "X"
	var v int
	var ok bool
	v, ok = evalConstExpr(sel, 0)
	if !ok { return fail("selector eval failed") }
	if v != 99 { return fail("fake.X should resolve to 99") }
	return ""
}

// Unknown identifier returns (0, false).  Caller (genConstGroup,
// registerImportConstGroup) then falls back to iotaVal, matching
// the pre-fix bare-iota behavior so a new unsupported expression
// shape produces the previous wrong value rather than a different
// one.
func TestEvalConstExprUnknownIdent() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalConstExpr(mkIdentExpr("NOT_REGISTERED_ANYWHERE"), 3)
	if ok { return fail("unknown ident should return ok=false") }
	if v != 0 { return fail("unknown ident should yield 0") }
	return ""
}
