package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// emitArrayElemStore stores `rhs` through `elemPtr` (a pointer to an array
// element of type `elemTyp`), applying the same string-literal conversion,
// struct-alloca load, and managed acquire-before-release discipline as a
// direct `a[i] = rhs`.  Shared by the IDENT/SELECTOR array arm and the
// nested-array arm of genAssign.
func emitArrayElemStore(ctx @GenContext, b @Block, elemPtr @Instr, rhs @Instr,
		elemTyp @types.Type) @Block {
	if isCharSliceType(elemTyp) && rhs.Op == iropcode.OP_CONST_STRING {
		rhs = b.EmitStringToChars(rhs, elemTyp)
		noteSPGrowingResult(ctx, rhs)
	}
	// A struct/array-alloca RHS stored into a value slot of that same
	// aggregate kind is loaded to a value first; a pointer slot takes the
	// alloca pointer directly.  Covers inner-array elements too, so a whole-
	// inner-array store `a[i] = [M]T{...}` copies the array value, not the
	// alloca pointer.
	if isAggregateAllocToLoad(rhs, elemTyp) {
		rhs = b.EmitLoad(rhs, rhs.TypeArg)
	}
	// Managed element / struct-with-managed-fields: acquire-before-release
	// store via the shared dispatcher (so a self-alias `a[i] = a[i]` can't
	// RefDec the value to zero before RefInc'ing it back).
	if isManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
		return emitStoreManagedSlot(ctx, b, elemPtr, rhs, elemTyp, false)
	}
	rhs = ensureWidth(ctx, b, rhs, elemTyp)
	b.EmitStore(elemPtr, rhs)
	return b
}

// isCompoundAssign reports whether `stmt` is a compound assignment
// (`a += b`, `a *= b`, …) rather than a plain `a = b`.
func isCompoundAssign(stmt @ast.Stmt) bool {
	return stmt.Op != 0 && stmt.Op != cast(int, token.ASSIGN)
}

// emitCompoundBinop returns `cur OP rhs` for the compound assignment
// `stmt` (`a OP= b`), emitting the divide-fault guard for `/=` / `%=`
// first.  `cur` is the current value of the lvalue, loaded by the caller
// however that lvalue form requires (a slot load, or EmitSliceGet for a
// slice element); `typ` is the lvalue's type.  Every lvalue arm of
// genAssign must route a compound assignment through this — applying it
// only in the IDENT arm silently dropped the operator for `a[i] += x`,
// `p.f += x`, `*p += x`, etc., storing the bare RHS.
func emitCompoundBinop(ctx @GenContext, b @Block, stmt @ast.Stmt, cur @Instr, rhs @Instr,
		typ @types.Type) @Instr {
	var op int = compoundToIROp(stmt.Op)
	// The result must be produced at the lvalue type `typ`.  `cur` is loaded
	// at `typ` already, but `rhs` can arrive at a different width — only the
	// IDENT lvalue arm width-coerces it before calling here, so a sub-word
	// element/field/deref target keeps an untyped-int count at int64 (e.g.
	// `a[0] <<= 40`).  Match both operands to `typ`, mirroring genBinaryExpr's
	// ensureWidth, so neither the emitted op nor the overshift guard's icmp
	// below mixes widths (a width-mismatched icmp/shl is invalid IR).
	var shiftInrange @Instr = nil
	if typ != nil {
		cur = ensureWidth(ctx, b, cur, typ)
		// A constant count >= the value width must be caught before the rhs
		// ensureWidth truncates it into range (`a[0] uint8 <<= 256` -> 0, not
		// the masked no-op) — mirrors genBinaryExpr; see emitConstOvershiftOrNil.
		var constOvershift @Instr = emitConstOvershiftOrNil(b, op, cur, rhs, typ)
		if constOvershift != nil {
			return constOvershift
		}
		// Likewise compute the RUNTIME overshift predicate from the original,
		// pre-ensureWidth count so a wider count's high bits aren't truncated
		// away before the guard — see emitShiftInrangeOrNil.
		shiftInrange = emitShiftInrangeOrNil(b, op, rhs, typ)
		// Negative-shift-count guard on the original (pre-ensureWidth) count —
		// see emitShiftCheckGuard.
		emitShiftCheckGuard(ctx, b, op, rhs, shiftInrange)
		rhs = ensureWidth(ctx, b, rhs, typ)
	}
	// A compound shift-assign must honor the overshift spec (0 for a logical
	// `<<=` / `>>=`, sign-fill for an arithmetic `>>=`) just like the
	// expression form in genBinaryExpr; routing through emitGuardedShift is
	// what makes `var y uint32 = 1; y <<= 40` yield 0 rather than the
	// hardware-masked `1 << (40 & 31)` = 256.  An in-range constant count
	// can't overshift, so it falls through to the plain EmitBinop fast path.
	if op == iropcode.OP_SHL || op == iropcode.OP_SHR {
		if shiftInrange != nil {
			return emitGuardedShift(b, op, cur, rhs, typ, shiftInrange)
		}
	}
	emitDivCheckGuard(ctx, b, op, cur, rhs, typ)
	return b.EmitBinop(op, cur, rhs, typ)
}

// genAssign generates IR for assignment statements (single, multi, index, selector, deref LHS).
func genAssign(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	// Multi-assign: q, r = call(...)
	if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == 1 {
		return genMultiAssign(ctx, b, stmt)
	}
	// Parallel assign: a, b = e1, e2 (incl. the swap a, b = b, a).  Matched
	// arity (>1 each); the checker rejects unequal multi-expression counts.
	if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == len(stmt.Exprs) {
		return genParallelAssign(ctx, b, stmt)
	}
	if len(stmt.Exprs) == 1 && len(stmt.Exprs2) == 1 {
		var lhs @ast.Expr = stmt.Exprs[0]
		// Determine LHS type up front so the function-reference-to-
		// function-value coercion can run inside genExprOrFuncRef.
		var lhsTypHint @types.Type = nil
		if lhs.Kind == ast.EXPR_IDENT {
			lhsTypHint = lookupVarType(ctx, lhs.Name)
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			lhsTypHint = getSelectorType(ctx, lhs)
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			// `s[i] = rhs`: hint the rhs with the collection's
			// element type so genExprOrFuncRef does the iv-lifting
			// (`*T → *I`) / func-ref-to-func-value coercion when
			// the slot expects them.  Per plan-pointers-to-iface-
			// values.md Slice P.4.
			lhsTypHint = getIndexElemType(ctx, lhs)
		}
		var rhs @Instr = genExprOrFuncRef(ctx, b, stmt.Exprs2[0], lhsTypHint)
		b = ctx.CurBlock
		if lhs.Kind == ast.EXPR_IDENT {
			var ptr @Instr = lookupVar(ctx, lhs.Name)
			if ptr != nil {
				// Ensure value width matches variable type
				var varTyp @types.Type = lookupVarType(ctx, lhs.Name)
				// String literal assigned to *[]readonly char or @[]char: convert via string_to_chars
				if isCharSliceType(varTyp) {
					if rhs.Op == iropcode.OP_CONST_STRING {
						rhs = b.EmitStringToChars(rhs, varTyp)
						noteSPGrowingResult(ctx, rhs)
					}
				}
				// nil assigned to slice: re-emit as nil slice (zeroed BnSlice/BnManagedSlice)
				if varTyp != nil && (varTyp.Kind == types.TYP_SLICE || varTyp.Kind == types.TYP_MANAGED_SLICE) {
					if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
						rhs = b.EmitConstNil(varTyp)
					}
				}
				// For a COMPOUND assignment the operand is reconciled to the
				// lvalue width inside emitCompoundBinop — and only AFTER the
				// shift overshift / negative-count guards have read the count at
				// its own width.  Pre-truncating it here would feed those guards
				// a narrowed residue (a uint16 count 261 -> uint8 5), so a wide
				// count's overshift / negative-ness would be mis-read as in-range
				// (the other compound lvalue arms already pass the raw operand).
				// So coerce here only for a plain `=` assignment.
				if varTyp != nil && !isCompoundAssign(stmt) {
					rhs = ensureWidth(ctx, b, rhs, varTyp)
				}
				// Compound assignment (+=, -=, etc.)
				if isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(ptr, varTyp), rhs, varTyp)
				}
				// @[]T → *[]T conversion
				if varTyp != nil && varTyp.Kind == types.TYP_SLICE && rhs.Typ != nil &&
						rhs.Typ.Kind == types.TYP_MANAGED_SLICE {
					// Temp stays in cleanup — RefDec at end of statement
					rhs = b.EmitManagedToRaw(rhs)
				}
				// A struct/array composite literal (or aggregate temp) arrives as
				// an OP_ALLOC pointer to its data; load the aggregate VALUE so the
				// store copies the contents, not the pointer (else `a = [N]T{...}`
				// / `a = other` stores the pointer and the slot keeps its old
				// contents).  Gate on the DESTINATION being that aggregate, like
				// the index arms: `&aggregateGlobal` also presents as an
				// OP_ALLOC-shaped (IsGlobalRef) rhs, but a pointer destination
				// (`var p *T = &g`, `p = &g`) must store the address as-is — the
				// dest-type-blind isStructOrArrayAlloc would load its first word
				// and store 0.
				if isAggregateAllocToLoad(rhs, varTyp) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// Axiom 5: assignment = copy-then-destroy, centralized in the
				// shared dispatcher (acquire the new value before releasing the
				// old occupant; a nil / non-managed varTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, ptr, rhs, varTyp, false)
			}
		} else if lhs.Kind == ast.EXPR_UNARY && lhs.Op == cast(int, token.STAR) {
			// *p = val: store through dereferenced pointer
			var ptrVal @Instr = genExpr(ctx, b, lhs.X)
			var derefTyp @types.Type = nil
			if ptrVal.Typ != nil && ptrVal.Typ.Kind == types.TYP_POINTER {
				derefTyp = ptrVal.Typ.Elem
			}
			// For a plain `=`, coerce the RHS to the pointee width — an untyped
			// literal or wider value must not be stored at its OWN width through
			// the pointer (`*pUint8 = 99` otherwise emits a 4-byte word store,
			// clobbering 3 neighbor bytes and Data-Aborting on strict-alignment
			// targets, e.g. arm32 bare-metal).  Mirrors the IDENT / SELECTOR arms'
			// ensureWidth.  Guarded on `!isCompoundAssign` like the IDENT arm: a
			// compound `*p <<= count` reconciles to derefTyp inside
			// emitCompoundBinop below, and pre-truncating the count here would feed
			// its overshift / negative-count guards a narrowed residue.
			if derefTyp != nil && !isCompoundAssign(stmt) {
				rhs = ensureWidth(ctx, b, rhs, derefTyp)
			}
			// Compound `*p += x`: read-modify-write through the pointer.
			if derefTyp != nil && isCompoundAssign(stmt) {
				rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(ptrVal, derefTyp), rhs, derefTyp)
			}
			// nil coercion for dereferenced slice/managed-slice/managed-ptr
			if isSliceType(derefTyp) || isManagedPtrType(derefTyp) {
				if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
					rhs = b.EmitConstNil(derefTyp)
				}
			}
			// Aggregate composite-literal/temp RHS arrives as an OP_ALLOC
			// pointer; load the value so the store copies contents.  Gated on the
			// deref'd destination being that aggregate (see the ident arm above).
			if isAggregateAllocToLoad(rhs, derefTyp) {
				rhs = b.EmitLoad(rhs, rhs.TypeArg)
			}
			// Axiom 5: deref assignment = copy-then-destroy, via the shared
			// dispatcher (a nil / non-managed derefTyp falls through to a
			// plain store).
			b = emitStoreManagedSlot(ctx, b, ptrVal, rhs, derefTyp, false)
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			// p.x = val: store through field pointer
			var fieldPtr @Instr = genSelectorPtr(ctx, b, lhs)
			if fieldPtr != nil {
				var fieldTyp @types.Type = getSelectorType(ctx, lhs)
				// If RHS is a struct/array alloca, load the value before storing —
				// dest-type-gated so `p.f = &aggregateGlobal` (a pointer field)
				// stores the address, not its loaded first word (see the ident
				// arm above).
				if isAggregateAllocToLoad(rhs, fieldTyp) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// String literal assigned to *[]readonly char or @[]char field: convert via string_to_chars
				if isCharSliceType(fieldTyp) {
					if rhs.Op == iropcode.OP_CONST_STRING {
						rhs = b.EmitStringToChars(rhs, fieldTyp)
						noteSPGrowingResult(ctx, rhs)
					}
				}
				// nil assigned to slice/managed-slice/managed-ptr field: coerce to proper type
				if isSliceType(fieldTyp) || isManagedPtrType(fieldTyp) {
					if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
						rhs = b.EmitConstNil(fieldTyp)
					}
				}
				// @[]T → *[]T conversion for raw slice field
				if fieldTyp != nil && fieldTyp.Kind == types.TYP_SLICE && rhs.Typ != nil &&
						rhs.Typ.Kind == types.TYP_MANAGED_SLICE {
					// Temp stays in cleanup — RefDec at end of statement
					rhs = b.EmitManagedToRaw(rhs)
				}
				// Compound `p.f += x`: read-modify-write through the field
				// pointer.
				if fieldTyp != nil && isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(fieldPtr, fieldTyp), rhs, fieldTyp)
				}
				// Width-adjust a non-managed field value (a no-op for the
				// managed kinds) before the store; emitStoreManagedSlot stores
				// the value as-is.
				if fieldTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, fieldTyp)
				}
				// Axiom 5: field assignment = copy-then-destroy, via the shared
				// dispatcher (a nil / non-managed fieldTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, fieldPtr, rhs, fieldTyp, false)
			}
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			// s[i] = v: slice or array index assignment.
			//
			// Nested-ARRAY target (`a[i][j] = v`): genExpr(lhs.X) would
			// load the inner array `a[i]` as an r-value with no backing
			// pointer, so the array arm below can't recover an element
			// pointer and would silently DROP the store.  Store through an
			// in-place element pointer (genIndexPtr) instead.  Detected by
			// TYPE so lhs.X (and its index) isn't generated twice.  Nested
			// SLICE targets need no special case (the loaded slice value
			// carries the backing pointer).
			if len(lhs.Args) == 1 && isNestedArrayBase(ctx, lhs) {
				var elemPtr @Instr = genIndexPtr(ctx, b, lhs)
				b = ctx.CurBlock
				if elemPtr != nil && elemPtr.Typ != nil && elemPtr.Typ.Elem != nil {
					if isCompoundAssign(stmt) {
						rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(elemPtr, elemPtr.Typ.Elem), rhs,
								elemPtr.Typ.Elem)
					}
					b = emitArrayElemStore(ctx, b, elemPtr, rhs, elemPtr.Typ.Elem)
					return b
				}
			}
			var collection @Instr = genExpr(ctx, b, lhs.X)
			b = ctx.CurBlock
			var index @Instr = genExpr(ctx, b, lhs.Args[0])
			b = ctx.CurBlock
			emitIndexBoundsCheck(ctx, b, collection, index)

			// Peel transparent wrappers so a named array (`var r Row` where
			// `type Row [3]int`) — or a readonly one — reaches the array
			// store arm and its element type comes from the underlying array,
			// not the wrapper (whose `.Elem` is nil).  Without this `r[0] = v`
			// falls through to the slice path and emits invalid IR.
			var collSt @types.Type = nil
			if collection.Typ != nil { collSt = peelTransparent(collection.Typ) }

			if collSt != nil && collSt.Kind == types.TYP_ARRAY {
				// Array: GEP + store
				var arrPtr @Instr = nil
				if lhs.X.Kind == ast.EXPR_IDENT {
					arrPtr = lookupVar(ctx, lhs.X.Name)
				}
				if arrPtr == nil && lhs.X.Kind == ast.EXPR_SELECTOR {
					arrPtr = genSelectorPtr(ctx, b, lhs.X)
					b = ctx.CurBlock
				}
				if arrPtr == nil && lhs.X.Kind == ast.EXPR_UNARY && lhs.X.Op == cast(int, token.STAR) {
					// `(*p)[i] = v`: p (a pointer-to-array) is the array's backing
					// address; GEP through it.  `collection` above loaded a COPY of
					// the array, so without this the store lands on the copy and is
					// silently dropped.
					arrPtr = genExpr(ctx, b, lhs.X.X)
					b = ctx.CurBlock
				}
				if arrPtr != nil {
					var elemTyp @types.Type = collSt.Elem
					if elemTyp == nil { elemTyp = types.TypInt() }
					var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, index, elemTyp)
					if isCompoundAssign(stmt) {
						rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(elemPtr, elemTyp), rhs, elemTyp)
					}
					b = emitArrayElemStore(ctx, b, elemPtr, rhs, elemTyp)
				}
			} else if collSt != nil && collSt.Kind == types.TYP_POINTER {
				// Pointer: GEP + store.  A managed element obeys Axiom 5
				// (RefInc new / RefDec old) exactly like the TYP_ARRAY arm
				// above — the raw pointer only excuses tracking the *block*'s
				// lifetime, not balancing the managed values *inside* the
				// slot.  (The multi-assign sibling does the same via
				// emitElemPtrStore.)  collSt is the peeled type so a named
				// pointer reaches this arm with a non-nil element type.
				var elemTyp @types.Type = collSt.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var elemPtr @Instr = b.EmitGetElemPtr(collection, index, elemTyp)
				// Aggregate (struct OR array) alloca from a nested composite
				// lit: load the VALUE, else the alloca POINTER is stored raw.
				if isAggregateAllocToLoad(rhs, elemTyp) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// Compound `p[i] += x`: read-modify-write through the
				// element pointer.
				if isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, b.EmitLoad(elemPtr, elemTyp), rhs, elemTyp)
				}
				// Managed pointer element: same acquire-before-release store
				// as the array arm (the raw pointer only excuses tracking the
				// block's lifetime, not balancing the managed values inside the
				// slot).  Routing through the dispatcher also fixes the
				// self-alias `p[i] = p[i]` UAF the old release-then-acquire
				// ordering had.
				if isManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
					b = emitStoreManagedSlot(ctx, b, elemPtr, rhs, elemTyp, false)
				} else {
					rhs = ensureWidth(ctx, b, rhs, elemTyp)
					b.EmitStore(elemPtr, rhs)
				}
			} else {
				// Element type comes from the PEELED slice type (collSt), not the
				// raw collection.Typ: a named-distinct slice (`type Buf @[]int`)
				// has Kind TYP_NAMED with a nil `.Elem` (its body hangs off
				// `.Underlying`), so reading `.Elem` off the wrapper yields nil.
				// EmitSliceSet would then build a GEP whose result element type is
				// nil — LLVM defaults a nil-element GEP to i64 and limps along
				// (latent wrong-stride for a non-8-byte named element), but the
				// native backend's ElemSizeOf reports 0, emitGetElemPtr early-
				// returns on `elemSize <= 0` without assigning the GEP's result
				// register, and the dropped GEP leaves the store's address slot
				// uninitialized (SIGSEGV).  The array arm above already peels.
				var collElem @types.Type = nil
				if collSt != nil { collElem = collSt.Elem }
				// String literal assigned to *[]readonly char or @[]char element: convert via string_to_chars
				if collElem != nil {
					if isCharSliceType(collElem) {
						if rhs.Op == iropcode.OP_CONST_STRING {
							rhs = b.EmitStringToChars(rhs, collElem)
							noteSPGrowingResult(ctx, rhs)
						}
					}
				}
				// If RHS is an aggregate alloca (struct OR array, from a nested
				// composite lit) AND the slot holds that aggregate by value, load
				// the VALUE before storing.  For slots holding pointers (e.g.
				// *[]*Item, *[]@Item) the element type isn't the aggregate, so
				// isAggregateAllocToLoad is false and the alloca pointer is stored
				// directly.
				if isAggregateAllocToLoad(rhs, collElem) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// Refcounting for managed slice elements
				if isManagedScalarType(collElem) {
					// Acquire the new value BEFORE releasing the old element.
					// This slice-set path has no slot pointer (EmitSliceGet /
					// EmitSliceSet), so it can't route through
					// emitStoreManagedSlot like the array/pointer arms, but it
					// shares the same discipline: a self-alias `s[i] = s[i]` of
					// a managed @T RefIncs the value first, so the RefDec of the
					// old occupant can't free it mid-store (the old hand-rolled
					// arms released first — a use-after-free).
					emitAcquireManagedScalar(ctx, b, rhs, collElem)
					var oldElem @Instr = b.EmitSliceGet(collection, index, collElem)
					b = emitManagedValueRefDec(ctx.Func, b, oldElem, collElem)
				}
				if collElem != nil && needsStructCopy(collElem) {
					// Struct element with managed fields: save old,
					// copy new (after store), dtor old.
					var oldElem @Instr = b.EmitSliceGet(collection, index, collElem)
					var oldSlot @Instr = b.EmitAlloc(collElem)
					b.EmitStore(oldSlot, oldElem)
					var newSlot @Instr = b.EmitAlloc(collElem)
					b.EmitStore(newSlot, rhs)
					emitStructCopy(ctx.Func, b, newSlot, collElem)
					emitStructDtor(ctx.Func, b, oldSlot, collElem)
				}
				// Slice: call runtime set
				var setElemTyp @types.Type = collElem
				// Compound `s[i] += x`: read-modify-write through the
				// runtime get/set (no element pointer for a slice).
				if setElemTyp != nil && isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, b.EmitSliceGet(collection, index, setElemTyp), rhs,
							setElemTyp)
				}
				if setElemTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, setElemTyp)
				}
				b.EmitSliceSet(collection, index, rhs, setElemTyp)
			}
		}
	}
	return b
}
