package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// emitArrayElemStore stores `rhs` through `elemPtr` (a pointer to an array
// element of type `elemTyp`), applying the same string-literal conversion,
// struct-alloca load, and managed acquire-before-release discipline as a
// direct `a[i] = rhs`.  Shared by the IDENT/SELECTOR array arm and the
// nested-array arm of genAssign.
func emitArrayElemStore(ctx @GenContext, b @Block, elemPtr @Instr,
		rhs @Instr, elemTyp @types.Type) @Block {
	if isCharSliceType(elemTyp) && rhs.Op == OP_CONST_STRING {
		rhs = b.EmitStringToChars(rhs, elemTyp)
		noteSPGrowingResult(ctx, rhs)
	}
	// A struct-alloca RHS stored into a struct slot is loaded to a value
	// first; a pointer slot takes the alloca pointer directly.
	if rhs.Op == OP_ALLOC && rhs.TypeArg != nil &&
			rhs.TypeArg.Kind == types.TYP_STRUCT {
		if elemTyp.Kind == types.TYP_STRUCT {
			rhs = b.EmitLoad(rhs, rhs.TypeArg)
		}
	}
	// Managed element / struct-with-managed-fields: acquire-before-release
	// store via the shared dispatcher (so a self-alias `a[i] = a[i]` can't
	// RefDec the value to zero before RefInc'ing it back).
	if isManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
		return emitStoreManagedSlot(ctx, b, elemPtr, rhs, elemTyp, false)
	}
	rhs = ensureWidth(ctx, b, rhs, elemTyp)
	b.EmitStore(elemPtr, rhs)
	return b
}

// genAssign generates IR for assignment statements (single, multi, index, selector, deref LHS).
func genAssign(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	// Multi-assign: q, r = call(...)
	if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == 1 {
		return genMultiAssign(ctx, b, stmt)
	}
	if len(stmt.Exprs) == 1 && len(stmt.Exprs2) == 1 {
		var lhs @ast.Expr = stmt.Exprs[0]
		// Determine LHS type up front so the function-reference-to-
		// function-value coercion can run inside genExprOrFuncRef.
		var lhsTypHint @types.Type = nil
		if lhs.Kind == ast.EXPR_IDENT {
			lhsTypHint = lookupVarType(ctx, lhs.Name)
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			lhsTypHint = getSelectorType(ctx, lhs)
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			// `s[i] = rhs`: hint the rhs with the collection's
			// element type so genExprOrFuncRef does the iv-lifting
			// (`*T → *I`) / func-ref-to-func-value coercion when
			// the slot expects them.  Per plan-pointers-to-iface-
			// values.md Slice P.4.
			lhsTypHint = getIndexElemType(ctx, lhs)
		}
		var rhs @Instr = genExprOrFuncRef(ctx, b, stmt.Exprs2[0], lhsTypHint)
		b = ctx.CurBlock
		if lhs.Kind == ast.EXPR_IDENT {
			var ptr @Instr = lookupVar(ctx, lhs.Name)
			if ptr != nil {
				// Ensure value width matches variable type
				var varTyp @types.Type = lookupVarType(ctx, lhs.Name)
				// String literal assigned to *[]readonly char or @[]char: convert via string_to_chars
				if isCharSliceType(varTyp) {
					if rhs.Op == OP_CONST_STRING {
						rhs = b.EmitStringToChars(rhs, varTyp)
						noteSPGrowingResult(ctx, rhs)
					}
				}
				// nil assigned to slice: re-emit as nil slice (zeroed BnSlice/BnManagedSlice)
				if varTyp != nil && (varTyp.Kind == types.TYP_SLICE || varTyp.Kind == types.TYP_MANAGED_SLICE) {
					if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
						rhs = b.EmitConstNil(varTyp)
					}
				}
				if varTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, varTyp)
				}
				// Compound assignment (+=, -=, etc.)
				if stmt.Op != 0 && stmt.Op != cast(int, token.ASSIGN) {
					var typ @types.Type = lookupVarType(ctx, lhs.Name)
					var cur @Instr = b.EmitLoad(ptr, typ)
					var op int = compoundToIROp(stmt.Op)
					// `a /= b` / `a %= b` need the divide-fault guard just
					// like `a = a / b` — same shared helper.
					emitDivCheckGuard(b, op, cur, rhs, typ)
					rhs = b.EmitBinop(op, cur, rhs, typ)
				}
				// @[]T → *[]T conversion
				if varTyp != nil && varTyp.Kind == types.TYP_SLICE && rhs.Typ != nil &&
						rhs.Typ.Kind == types.TYP_MANAGED_SLICE {
					// Temp stays in cleanup — RefDec at end of statement
					rhs = b.EmitManagedToRaw(rhs)
				}
				// A struct/array composite literal (or other aggregate temp)
				// arrives as an OP_ALLOC pointer to its data; load the aggregate
				// value so the store copies the contents, not the pointer.  The
				// selector arm does the same; without it a whole-array/struct
				// `=` assignment (`a = [N]T{...}`, `a = other`) silently stores
				// the pointer and the slot keeps its old contents.
				if isStructOrArrayAlloc(rhs) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// Axiom 5: assignment = copy-then-destroy, centralized in the
				// shared dispatcher (acquire the new value before releasing the
				// old occupant; a nil / non-managed varTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, ptr, rhs, varTyp, false)
			}
		} else if lhs.Kind == ast.EXPR_UNARY && lhs.Op == cast(int, token.STAR) {
			// *p = val: store through dereferenced pointer
			var ptrVal @Instr = genExpr(ctx, b, lhs.X)
			var derefTyp @types.Type = nil
			if ptrVal.Typ != nil && ptrVal.Typ.Kind == types.TYP_POINTER {
				derefTyp = ptrVal.Typ.Elem
			}
			// nil coercion for dereferenced slice/managed-slice/managed-ptr
			if isSliceType(derefTyp) || isManagedPtrType(derefTyp) {
				if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
					rhs = b.EmitConstNil(derefTyp)
				}
			}
			// Aggregate composite-literal/temp RHS arrives as an OP_ALLOC
			// pointer; load the value so the store copies contents (see the
			// ident arm above).
			if isStructOrArrayAlloc(rhs) {
				rhs = b.EmitLoad(rhs, rhs.TypeArg)
			}
			// Axiom 5: deref assignment = copy-then-destroy, via the shared
			// dispatcher (a nil / non-managed derefTyp falls through to a
			// plain store).
			b = emitStoreManagedSlot(ctx, b, ptrVal, rhs, derefTyp, false)
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			// p.x = val: store through field pointer
			var fieldPtr @Instr = genSelectorPtr(ctx, b, lhs)
			if fieldPtr != nil {
				// If RHS is a struct/array alloca, load the value before storing
				if isStructOrArrayAlloc(rhs) {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// String literal assigned to *[]readonly char or @[]char field: convert via string_to_chars
				var fieldTyp @types.Type = getSelectorType(ctx, lhs)
				if isCharSliceType(fieldTyp) {
					if rhs.Op == OP_CONST_STRING {
						rhs = b.EmitStringToChars(rhs, fieldTyp)
						noteSPGrowingResult(ctx, rhs)
					}
				}
				// nil assigned to slice/managed-slice/managed-ptr field: coerce to proper type
				if isSliceType(fieldTyp) || isManagedPtrType(fieldTyp) {
					if rhs.Typ != nil && rhs.Typ.Kind == types.TYP_NIL {
						rhs = b.EmitConstNil(fieldTyp)
					}
				}
				// @[]T → *[]T conversion for raw slice field
				if fieldTyp != nil && fieldTyp.Kind == types.TYP_SLICE &&
					rhs.Typ != nil && rhs.Typ.Kind == types.TYP_MANAGED_SLICE {
					// Temp stays in cleanup — RefDec at end of statement
					rhs = b.EmitManagedToRaw(rhs)
				}
				// Width-adjust a non-managed field value (a no-op for the
				// managed kinds) before the store; emitStoreManagedSlot stores
				// the value as-is.
				if fieldTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, fieldTyp)
				}
				// Axiom 5: field assignment = copy-then-destroy, via the shared
				// dispatcher (a nil / non-managed fieldTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, fieldPtr, rhs, fieldTyp, false)
			}
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			// s[i] = v: slice or array index assignment.
			//
			// Nested-ARRAY target (`a[i][j] = v`): genExpr(lhs.X) would
			// load the inner array `a[i]` as an r-value with no backing
			// pointer, so the array arm below can't recover an element
			// pointer and would silently DROP the store.  Store through an
			// in-place element pointer (genIndexPtr) instead.  Detected by
			// TYPE so lhs.X (and its index) isn't generated twice.  Nested
			// SLICE targets need no special case (the loaded slice value
			// carries the backing pointer).
			if len(lhs.Args) == 1 && isNestedArrayBase(ctx, lhs) {
				var elemPtr @Instr = genIndexPtr(ctx, b, lhs)
				b = ctx.CurBlock
				if elemPtr != nil && elemPtr.Typ != nil &&
						elemPtr.Typ.Elem != nil {
					b = emitArrayElemStore(ctx, b, elemPtr, rhs,
						elemPtr.Typ.Elem)
					return b
				}
			}
			var collection @Instr = genExpr(ctx, b, lhs.X)
			b = ctx.CurBlock
			var index @Instr = genExpr(ctx, b, lhs.Args[0])
			b = ctx.CurBlock
			emitIndexBoundsCheck(ctx, b, collection, index)

			if collection.Typ != nil && collection.Typ.Kind == types.TYP_ARRAY {
				// Array: GEP + store
				var arrPtr @Instr = nil
				if lhs.X.Kind == ast.EXPR_IDENT {
					arrPtr = lookupVar(ctx, lhs.X.Name)
				}
				if arrPtr == nil && lhs.X.Kind == ast.EXPR_SELECTOR {
					arrPtr = genSelectorPtr(ctx, b, lhs.X)
					b = ctx.CurBlock
				}
				if arrPtr != nil {
					var elemTyp @types.Type = collection.Typ.Elem
					if elemTyp == nil { elemTyp = types.TypInt() }
					var elemPtr @Instr = b.EmitGetElemPtr(arrPtr, index, elemTyp)
					b = emitArrayElemStore(ctx, b, elemPtr, rhs, elemTyp)
				}
			} else if collection.Typ != nil && collection.Typ.Kind == types.TYP_POINTER {
				// Pointer: GEP + store.  A managed element obeys Axiom 5
				// (RefInc new / RefDec old) exactly like the TYP_ARRAY arm
				// above — the raw pointer only excuses tracking the *block*'s
				// lifetime, not balancing the managed values *inside* the
				// slot.  (The multi-assign sibling does the same via
				// emitElemPtrStore.)
				var elemTyp @types.Type = collection.Typ.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var elemPtr @Instr = b.EmitGetElemPtr(collection, index, elemTyp)
				if rhs.Op == OP_ALLOC && rhs.TypeArg != nil && rhs.TypeArg.Kind == types.TYP_STRUCT {
					rhs = b.EmitLoad(rhs, rhs.TypeArg)
				}
				// Managed pointer element: same acquire-before-release store
				// as the array arm (the raw pointer only excuses tracking the
				// block's lifetime, not balancing the managed values inside the
				// slot).  Routing through the dispatcher also fixes the
				// self-alias `p[i] = p[i]` UAF the old release-then-acquire
				// ordering had.
				if isManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
					b = emitStoreManagedSlot(ctx, b, elemPtr, rhs,
						elemTyp, false)
				} else {
					rhs = ensureWidth(ctx, b, rhs, elemTyp)
					b.EmitStore(elemPtr, rhs)
				}
			} else {
				// String literal assigned to *[]readonly char or @[]char element: convert via string_to_chars
				if collection.Typ != nil && collection.Typ.Elem != nil {
					var elemTyp @types.Type = collection.Typ.Elem
					if isCharSliceType(elemTyp) {
						if rhs.Op == OP_CONST_STRING {
							rhs = b.EmitStringToChars(rhs, elemTyp)
							noteSPGrowingResult(ctx, rhs)
						}
					}
				}
				// If RHS is a struct alloca AND the slot holds a struct value,
				// load the value before storing. For slots holding pointers
				// (e.g. *[]*Item, *[]@Item), store the alloca pointer directly.
				if rhs.Op == OP_ALLOC && rhs.TypeArg != nil && rhs.TypeArg.Kind == types.TYP_STRUCT {
					var slotElem @types.Type = nil
					if collection.Typ != nil { slotElem = collection.Typ.Elem }
					if slotElem != nil && slotElem.Kind == types.TYP_STRUCT {
						rhs = b.EmitLoad(rhs, rhs.TypeArg)
					}
				}
				// Refcounting for managed slice elements
				var collElem @types.Type = nil
				if collection.Typ != nil { collElem = collection.Typ.Elem }
				if isManagedScalarType(collElem) {
					// Acquire the new value BEFORE releasing the old element.
					// This slice-set path has no slot pointer (EmitSliceGet /
					// EmitSliceSet), so it can't route through
					// emitStoreManagedSlot like the array/pointer arms, but it
					// shares the same discipline: a self-alias `s[i] = s[i]` of
					// a managed @T RefIncs the value first, so the RefDec of the
					// old occupant can't free it mid-store (the old hand-rolled
					// arms released first — a use-after-free).
					emitAcquireManagedScalar(ctx, b, rhs, collElem)
					var oldElem @Instr = b.EmitSliceGet(collection, index, collElem)
					b = emitManagedValueRefDec(ctx.Func, b, oldElem, collElem)
				}
				if collElem != nil && needsStructCopy(collElem) {
					// Struct element with managed fields: save old,
					// copy new (after store), dtor old.
					var oldElem @Instr = b.EmitSliceGet(collection, index, collElem)
					var oldSlot @Instr = b.EmitAlloc(collElem)
					b.EmitStore(oldSlot, oldElem)
					var newSlot @Instr = b.EmitAlloc(collElem)
					b.EmitStore(newSlot, rhs)
					emitStructCopy(ctx.Func, b, newSlot, collElem)
					emitStructDtor(ctx.Func, b, oldSlot, collElem)
				}
				// Slice: call runtime set
				var setElemTyp @types.Type = collElem
				if setElemTyp == nil && collection.Typ != nil {
					setElemTyp = collection.Typ.Elem
				}
				if setElemTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, setElemTyp)
				}
				b.EmitSliceSet(collection, index, rhs, setElemTyp)
			}
		}
	}
	return b
}
