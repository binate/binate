package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Copy function naming
// ============================================================

// copyNameForType returns the copy function name for a given type.
// Naming scheme mirrors dtorNameForType with "__copy_" prefix:
//   struct Pos          → "__copy_Pos"
//   [5]@Node            → "__copy_arr5_mp_Node"
// Only called for types where NeedsDestruction is true.
func copyNameForType(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__copy_")
	dtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// qualifiedCopyNameForType handles cross-package references.
// For a type with qualified struct name "ast.File", produces "ast.__copy_File".
// For local types, same as copyNameForType.
func qualifiedCopyNameForType(t @types.Type) @[]char {
	t = t.ResolveAlias()
	// For struct types with qualified names, split on dot
	if t.Kind == types.TYP_STRUCT && hasDot(t.Name) {
		var pkg *[]readonly char = dotPrefix(t.Name)
		var base *[]readonly char = dotSuffix(t.Name)
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(pkg)
		cb.Write(".__copy_")
		cb.Write(base)
		return buf.CopyStr(cb.String())
	}
	// For array types, the inner struct might be qualified
	if t.Kind == types.TYP_ARRAY {
		var inner @types.Type = innermostStructType(t)
		if inner != nil && hasDot(inner.Name) {
			var pkg *[]readonly char = dotPrefix(inner.Name)
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(pkg)
			cb.Write(".")
			cb.Write("__copy_")
			dtorTypeSuffix(cb, t)
			return buf.CopyStr(cb.String())
		}
	}
	return copyNameForType(t)
}

// elemCopyName returns the copy symbol to CALL for a managed-slice element,
// array element, or struct field of type t — the copy-side counterpart of
// elemDtorName.  A struct-by-value's copy fn lives in the struct's defining
// package (qualifiedCopyNameForType); a managed-slice / array element's copy fn
// is the generic element-walk that the copy generator emits LOCALLY (weak_odr)
// under the unqualified copyNameForType name, so it must be called by that
// local name.  Qualifying it (which qualifiedCopyNameForType does for an array
// whose innermost struct is cross-package) references a never-emitted symbol.
func elemCopyName(t @types.Type) @[]char {
	var rt @types.Type = t.ResolveAlias()
	if rt.Kind == types.TYP_MANAGED_SLICE || rt.Kind == types.TYP_ARRAY {
		return copyNameForType(rt)
	}
	return qualifiedCopyNameForType(t)
}

// copyName returns "__copy_<structName>" for a struct type.
func copyName(structName *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__copy_")
	cb.Write(structName)
	return buf.CopyStr(cb.String())
}

// qualifiedCopyName handles cross-package struct names.
func qualifiedCopyName(structName *[]readonly char) @[]char {
	var dotIdx int = -1
	for i := 0; i < len(structName); i++ {
		if structName[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx < 0 {
		return copyName(structName)
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(structName[0:dotIdx])
	cb.Write(".__copy_")
	cb.Write(structName[dotIdx+1:len(structName)])
	return buf.CopyStr(cb.String())
}
