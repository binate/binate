package "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Copy function generation
// ============================================================

// generateCopies generates copy functions for all types that need
// destruction in the current module. Called after struct fields are populated.
// Mirrors generateDtors but emits RefInc instead of RefDec.
func generateCopies(m @Module) {
	// Full package path (see generateDtors) so the local-vs-extern
	// classification matches the full-path prefix of qualified
	// struct names.
	var modPkg @[]char = mangle.PkgPathFromQuoted(m.Name)

	// Track generated copy names to avoid duplicates
	var generated @[]@[]char

	// Pass 1: local struct copies (unqualified names, including anonymous)
	for i := 0; i < len(moduleStructs); i++ {
		var ms ModuleStruct = moduleStructs[i]
		if ms.Typ == nil { continue }
		if hasDot(ms.Name) { continue }
		if !ms.Typ.NeedsDestruction() { continue }
		var cname @[]char = copyNameForType(ms.Typ)
		if !hasName(generated, cname) {
			var copyFunc @Func = genStructCopyWithName(m.PkgPath, cname, ms.Typ)
			m.AddFunc(copyFunc)
			generated = slices.Append[@[]char](generated, cname)
		}
	}

	// Pass 2: qualified struct names
	for i := 0; i < len(moduleStructs); i++ {
		var ms ModuleStruct = moduleStructs[i]
		if ms.Typ == nil { continue }
		if !hasDot(ms.Name) { continue }
		if !ms.Typ.NeedsDestruction() { continue }

		var pkg *[]readonly char = dotPrefix(ms.Name)
		var base *[]readonly char = dotSuffix(ms.Name)

		if streq(pkg, modPkg) && !hasName(generated, copyName(base)) {
			var cname @[]char = copyName(base)
			var copyFunc @Func = genStructCopyWithName(m.PkgPath, cname, ms.Typ)
			m.AddFunc(copyFunc)
			generated = slices.Append[@[]char](generated, cname)
		} else if !streq(pkg, modPkg) {
			declareExternCopy(m, qualifiedCopyName(ms.Name))
		}
	}

	// Pass 3: array copy functions for arrays with destructible elements
	// (found in struct fields of local types)
	for i := 0; i < len(moduleStructs); i++ {
		var ms ModuleStruct = moduleStructs[i]
		if ms.Typ == nil { continue }
		if !ms.Typ.NeedsDestruction() { continue }
		var isLocal bool = !hasDot(ms.Name)
		if hasDot(ms.Name) {
			if streq(dotPrefix(ms.Name), modPkg) {
				isLocal = true
			}
		}
		if !isLocal { continue }
		for j := 0; j < len(ms.Typ.Fields); j++ {
			var ft @types.Type = ms.Typ.Fields[j].Type.ResolveAlias()
			if ft.Kind == types.TYP_ARRAY && ft.Elem.NeedsDestruction() {
				generated = ensureArrayCopy(m, ft, generated)
			}
		}
	}

	// From pending struct/array registrations (scope cleanup during function gen)
	for i := 0; i < len(pendingStructDtors); i++ {
		var pst @types.Type = pendingStructDtors[i]
		if pst.Kind == types.TYP_ARRAY && pst.Elem.NeedsDestruction() {
			generated = ensureArrayCopy(m, pst, generated)
		}
		if pst.Kind == types.TYP_STRUCT && pst.NeedsDestruction() {
			// Cross-package struct copy helpers belong to the defining
			// package — declare extern, skip local generation.  Mirrors
			// the gen_dtor_emit.bn pass-3 gate (and the pass-2 logic
			// above for moduleStructs).  Without this, consumer-side
			// copy helpers under the wrong-shape mangled name silently
			// collide on Mach-O strict-symbol semantics, mirroring the
			// dtor-vt cluster bug for copies.  Dedup via
			// funcAlreadyDeclared so we don't repeat pass-2's extern
			// declaration.
			if hasDot(pst.Name) &&
					!streq(dotPrefix(pst.Name), modPkg) {
				var extName @[]char = qualifiedCopyName(pst.Name)
				if !funcAlreadyDeclared(m, extName) {
					declareExternCopy(m, extName)
				}
				continue
			}
			var cname @[]char = copyNameForType(pst)
			if !hasName(generated, cname) {
				var copyFunc @Func = genStructCopyWithName(m.PkgPath, cname, pst)
				m.AddFunc(copyFunc)
				generated = slices.Append[@[]char](generated, cname)
			}
			for j := 0; j < len(pst.Fields); j++ {
				var ft @types.Type = pst.Fields[j].Type.ResolveAlias()
				if ft.Kind == types.TYP_ARRAY && ft.Elem.NeedsDestruction() {
					generated = ensureArrayCopy(m, ft, generated)
				}
			}
		}
	}
}

// ensureArrayCopy ensures an array copy function exists for the given type.
func ensureArrayCopy(m @Module, arrTyp @types.Type, generated @[]@[]char) @[]@[]char {
	var name @[]char = copyNameForType(arrTyp)
	if hasName(generated, name) { return generated }
	// If element type needs a copy too (nested array), ensure it
	var elemTyp @types.Type = arrTyp.Elem
	if elemTyp != nil {
		if elemTyp.Kind == types.TYP_ARRAY && elemTyp.Elem.NeedsDestruction() {
			generated = ensureArrayCopy(m, elemTyp, generated)
		}
	}
	var copyFunc @Func = genArrayCopy(m.PkgPath, name, arrTyp)
	m.AddFunc(copyFunc)
	generated = slices.Append[@[]char](generated, name)
	return generated
}

// declareExternCopy adds an extern function declaration for a cross-package copy.
func declareExternCopy(m @Module, name @[]char) {
	var ptrParam @Param = make(Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@Param = make_slice(@Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type
	var ef @Func = NewExternFunc(m.PkgPath, name, params, noResults)
	m.AddFunc(ef)
}

// ============================================================
// Struct copy function generation
// ============================================================

// genStructCopy generates a copy function for a struct type.
// For each field that NeedsDestruction:
//   - @T: load managed ptr, RefInc
//   - @[]T: load managed-slice, extract backing refptr, RefInc
//   - struct, [N]T: get field pointer, call field type's copy function
func genStructCopy(pkgPath @[]char, structName *[]readonly char, structTyp @types.Type) @Func {
	return genStructCopyWithName(pkgPath, copyName(structName), structTyp)
}

// genStructCopyWithName generates a copy function with an explicit name for a struct type.
func genStructCopyWithName(pkgPath @[]char, name @[]char, structTyp @types.Type) @Func {
	var ptrParam @Param = make(Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@Param = make_slice(@Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @Func = NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var b @Block = AddBlock(f, "entry")

	// Reference to parameter 0
	var rawPtr @Instr = make(Instr)
	rawPtr.ID = f.Params[0].ID
	rawPtr.Typ = f.Params[0].Typ
	rawPtr.Op = OP_CONST_INT

	// Bitcast to struct pointer
	var structPtrTyp @types.Type = types.MakePointerType(structTyp)
	var structPtr @Instr = b.EmitBitCast(rawPtr, structPtrTyp)

	for i := 0; i < len(structTyp.Fields); i++ {
		var fieldTyp @types.Type = structTyp.Fields[i].Type
		if !fieldTyp.NeedsDestruction() { continue }
		fieldTyp = fieldTyp.ResolveAlias()

		if fieldTyp.Kind == types.TYP_MANAGED_PTR {
			// @T field: load the managed pointer, RefInc
			var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fieldTyp)
			var fieldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
			b.EmitRefInc(fieldVal)
		} else if fieldTyp.Kind == types.TYP_MANAGED_SLICE {
			// @[]T field: load managed-slice, extract backing refptr, RefInc
			var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fieldTyp)
			var fieldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
			var refptr @Instr = b.EmitExtract(fieldVal, 2, types.MakeManagedPtrType(nil))
			b.EmitRefInc(refptr)
		} else if fieldTyp.Kind == types.TYP_MANAGED_FUNC_VALUE {
			// @func field: RefInc the data slot (slot 1 — the capture
			// record / shared ClosureRec) so the copy owns a ref.
			var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fieldTyp)
			var fieldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
			emitManagedFuncValueRefInc(f, b, fieldVal)
		} else if fieldTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
			// @Iface field: RefInc the data slot (field 0) so the copy
			// owns a ref.
			var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fieldTyp)
			var fieldVal @Instr = b.EmitLoad(fieldPtr, fieldTyp)
			emitManagedIfaceValueRefInc(f, b, fieldVal)
		} else {
			// struct, [N]T stored inline: get field pointer, call copy
			var fieldPtr @Instr = b.EmitGetFieldPtr(structPtr, i, fieldTyp)
			var fieldRawPtr @Instr = b.EmitBitCast(fieldPtr, types.MakePointerType(types.TypUint8()))
			emitDtorOrCopyCall(f, b, elemCopyName(fieldTyp), fieldRawPtr)
		}
	}

	var noRetVals @[]@Instr
	b.EmitReturn(noRetVals)
	return f
}

// ============================================================
// Array copy function generation
// ============================================================

// genArrayCopy generates a copy function for an array type [N]T.
// It iterates N elements and calls element copy on each.
func genArrayCopy(pkgPath @[]char, name @[]char, arrTyp @types.Type) @Func {
	var ptrParam @Param = make(Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@Param = make_slice(@Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @Func = NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @Block = AddBlock(f, "entry")

	// Reference to parameter 0
	var rawPtr @Instr = make(Instr)
	rawPtr.ID = f.Params[0].ID
	rawPtr.Typ = f.Params[0].Typ
	rawPtr.Op = OP_CONST_INT

	var elemTyp @types.Type = arrTyp.Elem
	var arrLen int = arrTyp.ArrayLen

	// Loop counter via alloca
	var iSlot @Instr = entry.EmitAlloc(types.TypInt())
	var zero @Instr = entry.EmitConstInt(0, types.TypInt())
	entry.EmitStore(iSlot, zero)

	var loopCond @Block = AddBlock(f, "arr_copy_cond")
	entry.EmitJump(loopCond)

	// Loop condition: i < N
	var iv @Instr = loopCond.EmitLoad(iSlot, types.TypInt())
	var lenConst @Instr = loopCond.EmitConstInt(arrLen, types.TypInt())
	var cmp @Instr = loopCond.EmitBinop(OP_LT, iv, lenConst, types.TypBool())
	var loopBody @Block = AddBlock(f, "arr_copy_body")
	var exitBlock @Block = AddBlock(f, "arr_copy_exit")
	loopCond.EmitBranch(cmp, loopBody, exitBlock)

	// Loop body: compute element address, call element copy
	var one @Instr = loopBody.EmitConstInt(1, types.TypInt())
	var elemSize @Instr = loopBody.EmitConstInt(elemTyp.SizeOf(), types.TypInt())
	var offset @Instr = loopBody.EmitBinop(OP_MUL, iv, elemSize, types.TypInt())
	var elemAddr @Instr = loopBody.EmitGetElemPtr(rawPtr, offset, types.TypUint8())
	var elemRawPtr @Instr = loopBody.EmitBitCast(elemAddr, types.MakePointerType(types.TypUint8()))

	if elemTyp.Kind == types.TYP_MANAGED_PTR {
		// Element is @T — load the pointer, RefInc
		var elemPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedElemPtr @Instr = loopBody.EmitBitCast(elemAddr, elemPtrTyp)
		var elem @Instr = loopBody.EmitLoad(typedElemPtr, elemTyp)
		loopBody.EmitRefInc(elem)
	} else if elemTyp.Kind == types.TYP_MANAGED_SLICE {
		// Element is @[]T — load the managed-slice, extract backing refptr, RefInc
		var elemPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedElemPtr @Instr = loopBody.EmitBitCast(elemAddr, elemPtrTyp)
		var elem @Instr = loopBody.EmitLoad(typedElemPtr, elemTyp)
		var refptr @Instr = loopBody.EmitExtract(elem, 2, types.MakeManagedPtrType(nil))
		loopBody.EmitRefInc(refptr)
	} else if elemTyp.Kind == types.TYP_MANAGED_FUNC_VALUE {
		// Element is @func — load it and RefInc its data slot (slot 1).
		var elemPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedElemPtr @Instr = loopBody.EmitBitCast(elemAddr, elemPtrTyp)
		var elem @Instr = loopBody.EmitLoad(typedElemPtr, elemTyp)
		emitManagedFuncValueRefInc(f, loopBody, elem)
	} else if elemTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		// Element is @Iface — load it and RefInc its data slot (field 0).
		var elemPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedElemPtr @Instr = loopBody.EmitBitCast(elemAddr, elemPtrTyp)
		var elem @Instr = loopBody.EmitLoad(typedElemPtr, elemTyp)
		emitManagedIfaceValueRefInc(f, loopBody, elem)
	} else {
		// Element is struct or [N]T — call element type's copy function
		emitDtorOrCopyCall(f, loopBody, elemCopyName(elemTyp), elemRawPtr)
	}

	// Increment counter, loop back
	var iNext @Instr = loopBody.EmitBinop(OP_ADD, iv, one, types.TypInt())
	loopBody.EmitStore(iSlot, iNext)
	loopBody.EmitJump(loopCond)

	// Exit
	var noRetVals @[]@Instr
	exitBlock.EmitReturn(noRetVals)
	return f
}
