package "pkg/binate/ir"

import "pkg/binate/ast"

// IR-gen for defer statements (§14.13).
//
// Lowering (fixed frame slots, per proposal-defer §6): a function-entry pre-pass
// allocates, per lexical defer, an armed bool + typed operand slots in the entry
// block (nil/false-initialized), registering the managed operand slots in
// ctx.Vars so the existing whole-function cleanup (emitDecForManagedLocals) and
// the VM fault pads (emitPadCleanup) release them.  Executing the defer stores
// its eagerly-evaluated, call-ready operands and sets armed.  Each function exit
// runs the pending deferred calls LIFO (armed-gated) BEFORE the whole-function
// managed-local release.  A VM-isolated fault runs the operand releases but no
// deferred calls (stmt.defer.no-abort).
//
// The lowering is added incrementally; until it lands, genDeferStmt aborts
// loudly rather than silently dropping the deferred call (the checker has
// already accepted only valid defers, so only a valid defer can reach here).

// genDeferStmt lowers a STMT_DEFER.
func genDeferStmt(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	panic("defer codegen not yet implemented")
}
