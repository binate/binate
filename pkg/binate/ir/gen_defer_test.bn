package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// IR-gen unit tests for defer (§14.13).  These pin the structural invariants of
// the lowering; runtime behavior is covered by the conformance suite
// (conformance/12*_defer_*).

// deferFindFunc returns the module function whose Name equals `name`, or nil.
func deferFindFunc(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, name) {
			return m.Funcs[i]
		}
	}
	return nil
}

// deferCountCalls counts direct OP_CALL instructions to symbol `sym` across all
// blocks of `f`.
func deferCountCalls(f @Func, sym *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, sym) {
				n = n + 1
			}
		}
	}
	return n
}

// deferHasOp reports whether `f` contains any instruction with opcode `op`.
func deferHasOp(f @Func, op int) bool {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op {
				return true
			}
		}
	}
	return false
}

// A single `defer g()` emits exactly one deferred call to g (run once at exit),
// plus the armed-flag conditional branch that gates it.
func TestGenDeferEmitsGuardedCall() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\nfunc f() { defer g() }\n")
	var f @Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if deferCountCalls(f, "test.g") != 1 {
		return fail("expected exactly one deferred call to test.g")
	}
	// The armed flag is gated by a conditional branch before the call.
	if !deferHasOp(f, iropcode.OP_BRANCH) {
		return fail("expected an armed-flag conditional branch")
	}
	return ""
}

// Two defers each emit their own guarded call (both run at exit, LIFO).
func TestGenDeferTwoCalls() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\nfunc f() { defer g()\ndefer g() }\n")
	var f @Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if deferCountCalls(f, "test.g") != 2 {
		return fail("expected two deferred calls to test.g")
	}
	return ""
}

// A defer whose statement did not execute is still safe: the armed flag is
// false-initialized at entry (an OP_CONST_BOOL store), so an early exit sweeps a
// nil no-op slot rather than stack garbage.
func TestGenDeferArmedFlagInitialized() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\n"
					"func f(c bool) { if c { defer g() } }\n")
	var f @Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if !deferHasOp(f, iropcode.OP_CONST_BOOL) {
		return fail("expected a false-init of the armed flag (OP_CONST_BOOL)")
	}
	if deferCountCalls(f, "test.g") != 1 {
		return fail("expected one guarded deferred call to test.g")
	}
	return ""
}
