package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"

// ============================================================
// Destructor naming
// ============================================================

// dtorNameForType returns the dtor function name for a given type.
// Naming scheme:
//   struct Node        → "__dtor_Node"
//   @Node              → "__dtor_mp_Node"  (managed pointer)
//   @[]@Node           → "__dtor_ms_mp_Node" (managed-slice of managed ptr)
//   @[]@[]@Node        → "__dtor_ms_ms_mp_Node" (recursive)
//   [5]@Node           → "__dtor_arr5_mp_Node" (array)
// Only called for types where NeedsDestruction is true.
func dtorNameForType(t @types.Type) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("__dtor_")
	dtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// dtorTypeSuffix appends the type-encoding suffix for a dtor/copy function name.
func dtorTypeSuffix(cb *buf.Builder, t @types.Type) {
	t = t.ResolveAlias()
	// A named distinct type's dtor/copy is its underlying's (identical
	// layout and managed fields), so name it by the underlying —
	// `@[]Celsius` shares `__dtor_ms_int` with `@[]int` rather than
	// emitting `ms_unknown` (which would collide across distinct named
	// scalar element types).
	if t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		dtorTypeSuffix(cb, t.Underlying)
		return
	}
	if t.Kind == types.TYP_STRUCT {
		if len(t.Name) > 0 {
			// Leaf only: an own-module struct's Name is now path-
			// qualified (pkg/foo.Node), but the element-dtor suffix
			// must stay the bare leaf ("Node") so the symbol is
			// byte-identical to before qualification (e.g.
			// __dtor_ms_Node, not __dtor_ms_pkg/foo.Node).
			cb.Write(dotSuffix(t.Name))
		} else {
			anonStructSuffix(cb, t)
		}
		return
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		cb.Write("mp_")
		dtorTypeSuffix(cb, t.Elem)
		return
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		cb.Write("ms_")
		dtorTypeSuffix(cb, t.Elem)
		return
	}
	if t.Kind == types.TYP_ARRAY {
		cb.Write("arr")
		buf.WriteInt(cb, t.ArrayLen)
		cb.WriteByte('_')
		dtorTypeSuffix(cb, t.Elem)
		return
	}
	// A managed interface value (@Iface) and a managed func value (@func)
	// each get ONE suffix — NOT a per-interface or per-signature one.  Their
	// element dtor/copy bodies (in genManagedSliceDtor / the copy generator)
	// are type-INDEPENDENT: an @Iface element RefDec's via the dtor fetched
	// from its own runtime vtable, an @func element via emitManagedFuncValueRefDec;
	// so a single `__dtor_ms_<tok>` (and `__copy_`) body is correct for every
	// interface / signature.  The tokens must be injective against EVERY other
	// kind — including user struct names, which the TYP_STRUCT arm above emits
	// verbatim.  Use the reserved keywords `interface` / `func`: a struct can
	// never be named a keyword, so `@[]@I` and `@[]structNamed_interface` can't
	// collide (a bare `iv` / `fv` WOULD — they are legal identifiers — producing
	// one `__dtor_ms_iv` body for two structurally-different slices, the leak /
	// SIGSEGV the adversarial review found).  No other kind maps to these tokens
	// (a non-managed *func / bare interface is not destructible, so never reaches
	// here).
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		cb.Write("interface")
		return
	}
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		cb.Write("func")
		return
	}
	// Primitive types (used in managed-slice naming, e.g., @[]@[]char → ms_ms_uint8)
	if t.Kind == types.TYP_INT {
		cb.Write(t.Name)
		return
	}
	if t.Kind == types.TYP_BOOL {
		cb.Write("bool")
		return
	}
	cb.Write("unknown")
}

// anonStructSuffix builds a dtor name suffix for an anonymous struct
// from its field type sequence. E.g., struct{X int; P @Node} → "anon_int_mp_Node".
// If the result would exceed 128 characters, uses a hash instead.
func anonStructSuffix(cb *buf.Builder, t @types.Type) {
	// First, build the full suffix to check length
	var full @buf.Builder = buf.NewBuilder()
	full.Write("anon")
	for i := 0; i < len(t.Fields); i++ {
		full.WriteByte('_')
		dtorTypeSuffix(full, t.Fields[i].Type)
	}
	var fullStr @[]char = buf.CopyStr(full.String())
	if len(fullStr) <= 128 {
		cb.Write(fullStr)
		return
	}
	// Hash fallback for very long names
	cb.Write("anon_h")
	var hash uint32 = hashStr(fullStr)
	writeHex(cb, hash)
}

// hashStr computes the 32-bit FNV-1a hash of a string.  The
// accumulator is uint32 so the arithmetic wraps mod 2^32 on every
// target: an `int` accumulator would not fit the 0x811C9DC5 offset
// basis on a 32-bit host, and on a 64-bit host would never wrap at
// 2^32 — yielding a host-dependent hash and therefore host-dependent
// mangled names.  uint32 makes it deterministic everywhere.
func hashStr(s *[]readonly char) uint32 {
	var h uint32 = 2166136261 // FNV-1a offset basis (0x811C9DC5)
	for i := 0; i < len(s); i++ {
		h = h ^ cast(uint32, s[i])
		h = h * 16777619 // FNV-1a prime (0x01000193)
	}
	return h
}

// writeHex writes a uint32 as lowercase hex.  uint32 (not int) so it
// can render the full range of hashStr's output on a 32-bit host.
func writeHex(cb *buf.Builder, val uint32) {
	if val == 0 {
		cb.WriteByte('0')
		return
	}
	// Build hex digits in reverse
	var digits [16]uint8
	var n int = 0
	var v uint32 = val
	for v > 0 {
		var d int = cast(int, v & 15)
		if d < 10 {
			digits[n] = cast(uint8, '0') + cast(uint8, d)
		} else {
			digits[n] = cast(uint8, 'a') + cast(uint8, d - 10)
		}
		n = n + 1
		v = v >> 4
	}
	for i := n - 1; i >= 0; i = i - 1 {
		cb.WriteByte(digits[i])
	}
}

// qualifiedDtorNameForType handles cross-package references.
// For a type with qualified struct name "ast.File", produces "ast.__dtor_File".
// For local types, same as dtorNameForType.
func qualifiedDtorNameForType(t @types.Type) @[]char {
	t = t.ResolveAlias()
	// For struct types with qualified names, split on dot
	if t.Kind == types.TYP_STRUCT && hasDot(t.Name) {
		var pkg *[]readonly char = dotPrefix(t.Name)
		var base *[]readonly char = dotSuffix(t.Name)
		var cb @buf.Builder = buf.NewBuilder()
		cb.Write(pkg)
		cb.Write(".__dtor_")
		cb.Write(base)
		return buf.CopyStr(cb.String())
	}
	// For managed-ptr/slice/array, the inner struct might be qualified
	if t.Kind == types.TYP_MANAGED_PTR || t.Kind == types.TYP_MANAGED_SLICE {
		var inner @types.Type = innermostStructType(t)
		if inner != nil && hasDot(inner.Name) {
			var pkg *[]readonly char = dotPrefix(inner.Name)
			var cb @buf.Builder = buf.NewBuilder()
			cb.Write(pkg)
			cb.Write(".")
			cb.Write("__dtor_")
			dtorTypeSuffix(cb, t)
			return buf.CopyStr(cb.String())
		}
	}
	return dtorNameForType(t)
}

// elemDtorName returns the dtor symbol to CALL for a managed-slice element,
// array element, or struct field of type t.  A struct-by-value's dtor lives
// in the struct's defining package, so it is named via qualifiedDtorNameForType
// (possibly cross-package -> `pkg.__dtor_T`).  But a managed-slice / array
// element's dtor is the GENERIC element-walk that ensureMsDtor / ensureArrayDtor
// emit LOCALLY (weak_odr) under the unqualified dtorNameForType name — no
// package defines a qualified copy of it.  Qualifying such a call (which
// qualifiedDtorNameForType does whenever the innermost struct is cross-package,
// e.g. a `@[]@[]@pkg.T` field naming `pkg.__dtor_ms_ms_mp_pkg.T`) references a
// symbol that is never emitted: clang "use of undefined value".  Calling the
// local name resolves to the weak_odr definition this module generated.
func elemDtorName(t @types.Type) @[]char {
	var rt @types.Type = t.ResolveAlias()
	if rt.Kind == types.TYP_MANAGED_SLICE || rt.Kind == types.TYP_ARRAY {
		return dtorNameForType(rt)
	}
	return qualifiedDtorNameForType(t)
}

// innermostStructType finds the struct type at the bottom of a type chain.
func innermostStructType(t @types.Type) @types.Type {
	t = t.ResolveAlias()
	if t.Kind == types.TYP_STRUCT { return t }
	if t.Kind == types.TYP_MANAGED_PTR ||
			t.Kind == types.TYP_MANAGED_SLICE ||
			t.Kind == types.TYP_ARRAY {
		if t.Elem != nil { return innermostStructType(t.Elem) }
	}
	return nil
}

// ============================================================
// Backward-compatible names (used by emitManagedPtrRefDec)
// ============================================================

// dtorName returns "__dtor_<structName>" for a struct type (legacy).
func dtorName(structName *[]readonly char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("__dtor_")
	cb.Write(structName)
	return buf.CopyStr(cb.String())
}

// qualifiedDtorName handles cross-package struct names (legacy).
func qualifiedDtorName(structName *[]readonly char) @[]char {
	var dotIdx int = -1
	for i := 0; i < len(structName); i++ {
		if structName[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx < 0 {
		return dtorName(structName)
	}
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(structName[0:dotIdx])
	cb.Write(".__dtor_")
	cb.Write(structName[dotIdx+1:len(structName)])
	return buf.CopyStr(cb.String())
}
