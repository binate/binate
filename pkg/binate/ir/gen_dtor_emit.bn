package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Destructor generation
// ============================================================

// isInjectableStructDtor reports whether a struct's dtor should be marked
// IsStructDtor (listed in the reflect Functions table for cross-mode injection).
// True for a USER-declared struct — a cross-package bytecode RefDec of a `@T`
// names `<pkg>.__dtor_T`, which must resolve when T's package is native-only.
// False for a SYNTHESIZED struct (closure `__closure_…`, anonymous, multi-
// return): its dtor is never named cross-package AND it already has a force-
// emitted shim, so flagging it would re-emit (duplicate) that shim.  Synthesized
// struct bases are `__`-prefixed; user identifiers never are.
func isInjectableStructDtor(structName *[]readonly char) bool {
	var base *[]readonly char = dotSuffix(structName)
	return len(base) >= 2 && !(base[0] == '_' && base[1] == '_')
}

// generateDtors generates destructor functions for all types that need
// destruction in the current module. Called after struct fields are populated.
func generateDtors(m @Module) {
	// Full package path so it matches the full-path prefix of
	// qualified struct names (e.g. `pkg/binate/ast`); the local-vs-extern
	// classification below compares dotPrefix(ms.Name) against it.
	var modPkg @[]char = mangle.PkgPathFromQuoted(m.Name)

	// Track generated dtor names to avoid duplicates
	var generated @[]@[]char

	// Pass 1: local struct dtors (unqualified names, including anonymous)
	for i := 0; i < len(m.Structs); i++ {
		var ms ModuleStruct = m.Structs[i]
		if ms.Typ == nil { continue }
		if hasDot(ms.Name) { continue }
		if !ms.Typ.NeedsDestruction() { continue }
		var dname @[]char = dtorNameForType(ms.Typ)
		if !hasName(generated, dname) {
			var dtorFunc @Func = genStructDtorWithName(m.PkgPath, dname, ms.Typ)
			if isInjectableStructDtor(ms.Name) {
				dtorFunc.IsStructDtor = true
			}
			m.AddFunc(dtorFunc)
			generated = slices.Append[@[]char](generated, dname)
		}
	}

	// Pass 2: qualified struct names
	for i := 0; i < len(m.Structs); i++ {
		var ms ModuleStruct = m.Structs[i]
		if ms.Typ == nil { continue }
		if !hasDot(ms.Name) { continue }
		if !ms.Typ.NeedsDestruction() { continue }

		var pkg *[]readonly char = dotPrefix(ms.Name)
		var base *[]readonly char = dotSuffix(ms.Name)

		if streq(pkg, modPkg) && !hasName(generated, dtorName(base)) {
			var dname @[]char = dtorName(base)
			var dtorFunc @Func = genStructDtorWithName(m.PkgPath, dname, ms.Typ)
			if isInjectableStructDtor(ms.Name) {
				dtorFunc.IsStructDtor = true
			}
			m.AddFunc(dtorFunc)
			generated = slices.Append[@[]char](generated, dname)
		} else if !streq(pkg, modPkg) {
			if ms.IsInstantiation {
				// A monomorphized generic struct from another package: DEFINE
				// its dtor here (the defining package never instantiates it),
				// qualified by the defining pkg so the definition matches the
				// reference, and IsLinkOnce (set by genStructDtorWithName) so
				// every consumer's copy merges — the generic-func merge pattern.
				var qn @[]char = qualifiedDtorName(ms.Name)
				if !hasName(generated, qn) {
					var dtorFunc @Func = genStructDtorWithName(
							buf.CopyStr(pkg), dtorName(base), ms.Typ)
					if isInjectableStructDtor(ms.Name) {
						dtorFunc.IsStructDtor = true
					}
					m.AddFunc(dtorFunc)
					generated = slices.Append[@[]char](generated, qn)
				}
			} else {
				declareExternDtor(m, qualifiedDtorName(ms.Name))
			}
		}
	}

	// Pass 3: scan all generated dtor functions and local code for
	// managed-slice and managed-ptr types that need their own dtors.
	// We collect types from struct fields, then generate dtors for them.
	generateNonStructDtors(m, modPkg, generated)
}

// generateNonStructDtors generates dtors for managed-slice types found in
// struct fields and in m.PendingMsDtors (collected during function IR gen).
func generateNonStructDtors(m @Module, modPkg @[]char, generated @[]@[]char) {
	// From LOCAL struct fields only (skip cross-package structs)
	for i := 0; i < len(m.Structs); i++ {
		var ms ModuleStruct = m.Structs[i]
		if ms.Typ == nil { continue }
		if !ms.Typ.NeedsDestruction() { continue }
		// Skip cross-package structs — their dtors are in their own package.
		// An instantiated generic struct counts as local: its dtor is defined
		// here (IsLinkOnce), so its managed-slice/array field dtors must be too.
		var isLocal bool = !hasDot(ms.Name)
		if hasDot(ms.Name) {
			if streq(dotPrefix(ms.Name), modPkg) {
				isLocal = true
			}
		}
		if ms.IsInstantiation { isLocal = true }
		if !isLocal { continue }
		for j := 0; j < len(ms.Typ.Fields); j++ {
			// peelTransparent (not ResolveAlias) so a NAMED managed-slice or
			// array field is classified by its underlying kind and its element
			// dtor helper is registered — otherwise the emit-site call to that
			// helper (gen_dtor_emit_bodies.bn) is left undefined.
			var ft @types.Type = peelTransparent(ms.Typ.Fields[j].Type)
			if ft.Kind == types.TYP_MANAGED_SLICE {
				generated = ensureMsDtor(m, ft, generated)
			}
			// A `@(@[]T)` field (a managed pointer to a managed slice — e.g.
			// `Box[@[]int]`'s `p @T`): its drop RefDecs through the pointee's
			// managed-slice dtor (emitManagedPtrRefDec's managed-slice arm), so ensure
			// that dtor exists.  The field isn't itself a managed slice, so the arm
			// above misses it, and the struct dtor is generated with a module-less
			// func so it can't register the dtor at emit time.
			if ft.Kind == types.TYP_MANAGED_PTR && ft.Elem != nil &&
					peelTransparent(ft.Elem).Kind == types.TYP_MANAGED_SLICE {
				generated = ensureMsDtor(m, peelTransparent(ft.Elem), generated)
			}
			if ft.Kind == types.TYP_ARRAY && ft.Elem.NeedsDestruction() {
				generated = ensureArrayDtor(m, ft, generated)
			}
		}
	}

	// From pending registrations (emitManagedSliceRefDec during function gen)
	for i := 0; i < len(m.PendingMsDtors); i++ {
		generated = ensureMsDtor(m, m.PendingMsDtors[i], generated)
	}

	// From pending struct/array registrations (scope cleanup during function gen)
	for i := 0; i < len(m.PendingStructDtors); i++ {
		var pst @types.Type = m.PendingStructDtors[i]
		if pst.Kind == types.TYP_ARRAY && pst.Elem.NeedsDestruction() {
			generated = ensureArrayDtor(m, pst, generated)
		}
		// Generate struct dtor if not already generated (e.g., anonymous
		// structs from multi-return that aren't in Module.Structs).
		if pst.Kind == types.TYP_STRUCT && pst.NeedsDestruction() {
			// An instantiated generic struct is always in m.Structs, where
			// pass 2 already DEFINED its dtor locally (IsLinkOnce) under the
			// defining-pkg name.  Skip it here so we don't also declare it
			// extern (declare + define of one symbol is a conflict).
			if moduleStructIsInstantiation(m, pst.Name) {
				continue
			}
			// Cross-package struct dtors belong to the defining
			// package (which already emits them as `pkg/X.__dtor_T`,
			// the mangled __dtor helper).  Generating a local
			// duplicate here via `dtorNameForType` would produce
			// `__dtor_pkg/X.T`, a *different* mangled symbol from a
			// *different* IR name — distinct from the OP_FUNC_HANDLE reference
			// (which `qualifiedDtorName` aligns with the defining
			// package's shape).  The mismatch leaves the local
			// duplicate unused, weak-collides with the defining
			// package's `__vt` on Mach-O strict-symbol semantics,
			// and breaks the macOS aa64 self-host lane.  Mirror
			// the pass-2 (Module.Structs) cross-package gate: declare
			// the extern, skip generation.  Pass 2 may have already
			// declared the same extern from a moduleStruct entry —
			// gate via funcAlreadyDeclared so we don't redefine the
			// LLVM `declare` line.
			if hasDot(pst.Name) && !streq(dotPrefix(pst.Name), modPkg) {
				var extName @[]char = qualifiedDtorName(pst.Name)
				if !funcAlreadyDeclared(m, extName) {
					declareExternDtor(m, extName)
				}
				continue
			}
			var dname @[]char = dtorNameForType(pst)
			if !hasName(generated, dname) {
				var dtorFunc @Func = genStructDtorWithName(m.PkgPath, dname, pst)
				m.AddFunc(dtorFunc)
				generated = slices.Append[@[]char](generated, dname)
			}
			for j := 0; j < len(pst.Fields); j++ {
				// peelTransparent (not ResolveAlias): see ms.Typ.Fields loop above.
				var ft @types.Type = peelTransparent(pst.Fields[j].Type)
				if ft.Kind == types.TYP_MANAGED_SLICE {
					generated = ensureMsDtor(m, ft, generated)
				}
				// A `@(@[]T)` field (see the local-structs walk above): its drop
				// RefDecs through the pointee ms-dtor; ensure it — the struct dtor is
				// emitted with a module-less func so it can't register at emit time.
				if ft.Kind == types.TYP_MANAGED_PTR && ft.Elem != nil &&
						peelTransparent(ft.Elem).Kind == types.TYP_MANAGED_SLICE {
					generated = ensureMsDtor(m, peelTransparent(ft.Elem), generated)
				}
				if ft.Kind == types.TYP_ARRAY && ft.Elem.NeedsDestruction() {
					generated = ensureArrayDtor(m, ft, generated)
				}
			}
		}
	}
}

// ensureMsDtor ensures a managed-slice dtor exists for the given type,
// recursively generating dtors for nested managed-slice element types.
func ensureMsDtor(m @Module, msTyp @types.Type, generated @[]@[]char) @[]@[]char {
	var name @[]char = dtorNameForType(msTyp)
	if hasName(generated, name) { return generated }
	// Ensure the element's dtor exists first — genManagedSliceDtor's body calls
	// it (by its LOCAL name, via elemDtorName).  A managed-slice element recurses
	// here; an ARRAY element needs ensureArrayDtor (mirrors ensureArrayDtor's own
	// element recursion).  Without the array arm, `@[]([N]@T)` named a local
	// __dtor_arrN_... it never emitted — clang "use of undefined value".  A
	// struct element's dtor comes from the module-structs / pending-dtor pass,
	// not from here.
	// peelTransparent (not the raw .Elem): a NAMED-distinct transparent wrapper
	// element (`type Buf @[]@T`) must be classified by its UNDERLYING kind, else
	// the TYP_MANAGED_SLICE / TYP_ARRAY recursion below is skipped and the inner
	// element helper is never emitted -- the outer body still calls it (by the
	// wrapper's underlying name, since dtorNameForType peels NAMED), so the call
	// references a symbol no pass produces (undefined value / VM extern not found).
	// Mirrors the peelTransparent the struct field-walk already applies.
	var elemTyp @types.Type = peelTransparent(msTyp.Elem)
	if elemTyp != nil && elemTyp.Kind == types.TYP_MANAGED_SLICE {
		generated = ensureMsDtor(m, elemTyp, generated)
	}
	// A `@(@[]T)` element (a managed pointer to a managed slice): its per-element
	// drop RefDecs through the pointee's ms-dtor (emitManagedPtrRefDec), so ensure
	// that dtor — the element isn't itself a managed slice, so the arm above misses it.
	if elemTyp != nil && elemTyp.Kind == types.TYP_MANAGED_PTR && elemTyp.Elem != nil &&
			peelTransparent(elemTyp.Elem).Kind == types.TYP_MANAGED_SLICE {
		generated = ensureMsDtor(m, peelTransparent(elemTyp.Elem), generated)
	}
	if elemTyp != nil && elemTyp.Kind == types.TYP_ARRAY && elemTyp.Elem != nil &&
			elemTyp.Elem.NeedsDestruction() {
		generated = ensureArrayDtor(m, elemTyp, generated)
	}
	var dtorFunc @Func = genManagedSliceDtor(m.PkgPath, name, msTyp)
	m.AddFunc(dtorFunc)
	generated = slices.Append[@[]char](generated, name)
	return generated
}

// ensureArrayDtor ensures an array dtor exists for the given type.
func ensureArrayDtor(m @Module, arrTyp @types.Type, generated @[]@[]char) @[]@[]char {
	var name @[]char = dtorNameForType(arrTyp)
	if hasName(generated, name) { return generated }
	// If element type needs a dtor too (nested array, managed-slice, etc.), ensure
	// it.  peelTransparent (not the raw .Elem) so a NAMED-distinct wrapper element
	// is classified by its underlying kind and the recursion is not skipped -- see
	// ensureMsDtor's element-peel note.
	var elemTyp @types.Type = peelTransparent(arrTyp.Elem)
	if elemTyp != nil {
		if elemTyp.Kind == types.TYP_MANAGED_SLICE {
			generated = ensureMsDtor(m, elemTyp, generated)
		}
		// A `@(@[]T)` element (see ensureMsDtor's note): ensure the pointee ms-dtor.
		if elemTyp.Kind == types.TYP_MANAGED_PTR && elemTyp.Elem != nil &&
				peelTransparent(elemTyp.Elem).Kind == types.TYP_MANAGED_SLICE {
			generated = ensureMsDtor(m, peelTransparent(elemTyp.Elem), generated)
		}
		if elemTyp.Kind == types.TYP_ARRAY && elemTyp.Elem.NeedsDestruction() {
			generated = ensureArrayDtor(m, elemTyp, generated)
		}
	}
	var dtorFunc @Func = genArrayDtor(m.PkgPath, name, arrTyp)
	m.AddFunc(dtorFunc)
	generated = slices.Append[@[]char](generated, name)
	return generated
}

// declareExternDtor adds an extern function declaration for a cross-package dtor.
func declareExternDtor(m @Module, name @[]char) {
	var ptrParam @Param = make(Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@Param = make_slice(@Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type
	var ef @Func = NewExternFunc(m.PkgPath, name, params, noResults)
	m.AddFunc(ef)
}

// ============================================================
// Indirect call helper
// ============================================================

// emitDtorOrCopyCall emits a direct call to a type-specific dtor or
// copy function on a field / element pointer: `<name>(arg)`.  Named
// vague-ly because both gen_dtor_emit.bn and gen_copy_emit.bn share
// it.  Misleadingly used to be called "emitIndirectCall" and took an
// OP_FUNC_ADDR instr that the body then unpacked via `.StrVal` —
// purely as a name carrier — but that produced a dead OP_FUNC_ADDR
// instr in the IR for every dtor/copy call.  Direct OP_CALL is what
// every dtor / copy invocation has actually been all along.
func emitDtorOrCopyCall(f @Func, b @Block, name @[]char, arg @Instr, moduleLocal bool) {
	var args @[]@Instr = make_slice(@Instr, 1)
	args[0] = arg
	// A module-local synthetic helper (a managed-slice / array element-walk dtor
	// or copy) is emitted weak_odr into the current module under its package, so
	// it must be called by its bare name (EmitCallLocal) rather than qualified
	// with the enclosing func's home package (EmitCall) -- see EmitCallLocal.
	if moduleLocal {
		b.EmitCallLocal(name, args, types.TypVoid())
	} else {
		b.EmitCall(name, args, types.TypVoid())
	}
}

// ============================================================
// Utility functions
// ============================================================

// shortPkgName extracts the short package name from a quoted path (e.g., "pkg/binate/ir" -> "ir").
func shortPkgName(name @[]char) @[]char {
	var start int = 0
	var end int = len(name)
	if end > 0 && name[0] == '"' { start = 1 }
	if end > 1 && name[end - 1] == '"' { end = end - 1 }
	var lastSlash int = -1
	for i := start; i < end; i++ {
		if name[i] == '/' { lastSlash = i }
	}
	if lastSlash >= 0 {
		return name[lastSlash + 1:end]
	}
	return name[start:end]
}

// dotPrefix returns the substring before the first dot (e.g., "ast.File" -> "ast").
func dotPrefix(s *[]readonly char) *[]readonly char {
	for i := 0; i < len(s); i++ {
		if s[i] == '.' { return s[0:i] }
	}
	return s
}

// dotSuffix returns the substring after the first dot (e.g., "ast.File" -> "File").
func dotSuffix(s *[]readonly char) *[]readonly char {
	for i := 0; i < len(s); i++ {
		if s[i] == '.' { return s[i + 1:len(s)] }
	}
	return s
}

// hasDot returns true if the string contains a dot character.
func hasDot(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == '.' { return true }
	}
	return false
}

// hasName returns true if the name exists in the given list.
func hasName(names @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if streq(names[i], name) { return true }
	}
	return false
}

// funcAlreadyDeclared reports whether `name` already appears in
// m.Funcs (as either a defined function or an extern declaration).
// Used by the cross-package dtor/copy-skip gate to avoid emitting a
// second `declare void @bn_…(i8*)` line when an earlier pass — or
// emitManagedSliceRefDec's transitive walk — has already declared
// the same extern.  LLVM treats a duplicate declaration as an
// invalid redefinition.
func funcAlreadyDeclared(m @Module, name *[]readonly char) bool {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return true }
	}
	return false
}

// moduleStructIsInstantiation reports whether the module struct registered
// under `name` is a monomorphized generic instantiation (whose dtor/copy
// helpers are defined locally as IsLinkOnce, keyed on the defining package).
// Used by the pending-dtor / pending-copy passes, which see raw types without
// the ModuleStruct.IsInstantiation flag.
func moduleStructIsInstantiation(m @Module, name *[]readonly char) bool {
	for i := 0; i < len(m.Structs); i++ {
		if streq(m.Structs[i].Name, name) {
			return m.Structs[i].IsInstantiation
		}
	}
	return false
}
