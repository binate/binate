// ============================================================
// Managed func-value destructor generation tests
// ============================================================

// genManagedFuncValueDtor emits the signature-independent `__dtor_func` body: load
// the `@func()` at the cell and RefDec its capture record.
func TestGenManagedFuncValueDtorName() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if !charsEqual(dtorFn.Name, "__dtor_func") {
		return fail("func-value dtor name should be __dtor_func")
	}
	return ""
}

func TestGenManagedFuncValueDtorIsLinkOnce() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if !dtorFn.IsLinkOnce {
		return fail("func-value dtor should be link-once (coalesced across modules)")
	}
	return ""
}

// emitManagedFuncValueRefDec guards the closure-dtor fetch behind a null-data check,
// so the body splits into extra blocks with the RETURN on the continuation, and
// fetches the dtor via OP_FUNC_VALUE_DTOR.
func TestGenManagedFuncValueDtorSplitsAndReturns() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if len(dtorFn.Blocks) < 2 {
		return fail("func-value dtor should split (null-data guard) into extra blocks")
	}
	if countOp(dtorFn, iropcode.OP_RETURN) < 1 {
		return fail("func-value dtor should have iropcode.OP_RETURN")
	}
	if countOp(dtorFn, iropcode.OP_FUNC_VALUE_DTOR) < 1 {
		return fail("func-value dtor should fetch the closure dtor (OP_FUNC_VALUE_DTOR)")
	}
	return ""
}

// ============================================================
// Managed iface-value destructor generation tests
// ============================================================

// genManagedIfaceValueDtor emits the interface-independent `__dtor_interface` body:
// load the `@I` at the cell and RefDec its data slot.
func TestGenManagedIfaceValueDtorName() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if !charsEqual(dtorFn.Name, "__dtor_interface") {
		return fail("iface-value dtor name should be __dtor_interface")
	}
	return ""
}

func TestGenManagedIfaceValueDtorIsLinkOnce() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if !dtorFn.IsLinkOnce {
		return fail("iface-value dtor should be link-once (coalesced across modules)")
	}
	return ""
}

// emitManagedIfaceValueRefDec guards the vtable-dtor fetch behind a null-data check,
// so the body splits into extra blocks with the RETURN on the continuation.
func TestGenManagedIfaceValueDtorSplitsAndReturns() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if len(dtorFn.Blocks) < 2 {
		return fail("iface-value dtor should split (null-data guard) into extra blocks")
	}
	if countOp(dtorFn, iropcode.OP_RETURN) < 1 {
		return fail("iface-value dtor should have iropcode.OP_RETURN")
	}
	return ""
}
