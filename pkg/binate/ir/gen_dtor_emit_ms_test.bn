package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Managed-pointer / func-value / iface-value / managed-slice destructor body
// tests — companion to gen_dtor_emit_ms.bn (whose bodies these exercise).

// ============================================================
// Managed-slice destructor generation tests
// ============================================================

func TestGenManagedSliceDtorName() testing.TestResult {
	var innerTyp @types.Type = types.MakeStructType("Node", noFields)
	var mpTyp @types.Type = types.MakeManagedPtrType(innerTyp)
	var msTyp @types.Type = types.MakeManagedSliceType(mpTyp)

	var dtorFn @Func = genManagedSliceDtor("", "__dtor_ms_mp_Node", msTyp)
	if !charsEqual(dtorFn.Name, "__dtor_ms_mp_Node") {
		return fail("managed-slice dtor name wrong")
	}
	return ""
}

func TestGenManagedSliceDtorIsLinkOnce() testing.TestResult {
	var innerTyp @types.Type = types.MakeStructType("Node", noFields)
	var mpTyp @types.Type = types.MakeManagedPtrType(innerTyp)
	var msTyp @types.Type = types.MakeManagedSliceType(mpTyp)

	var dtorFn @Func = genManagedSliceDtor("", "__dtor_ms_mp_Node", msTyp)
	if !dtorFn.IsLinkOnce {
		return fail("managed-slice dtor should be IsLinkOnce")
	}
	return ""
}

// For a destruction-needing element the by-address __dtor_<T> DELEGATES the
// element loop to the scalar-arg __dtor_ms_elems_<T> helper: it has no loop of its
// own (no OP_LT), just a call to the helper.  The loop lives in the elems helper
// (TestGenManagedSliceElemsDtorLoopStructure).
func TestGenManagedSliceDtorDelegatesToElems() testing.TestResult {
	var innerTyp @types.Type = types.MakeStructType("Node", noFields)
	var mpTyp @types.Type = types.MakeManagedPtrType(innerTyp)
	var msTyp @types.Type = types.MakeManagedSliceType(mpTyp)

	var dtorFn @Func = genManagedSliceDtor("", "__dtor_ms_mp_Node", msTyp)
	if countOp(dtorFn, iropcode.OP_LT) != 0 {
		return fail("by-address managed-slice dtor should delegate — no inline loop (OP_LT)")
	}
	if countOp(dtorFn, iropcode.OP_CALL) < 1 {
		return fail("by-address managed-slice dtor should call the __dtor_ms_elems_<T> helper")
	}
	return ""
}

// The scalar-arg __dtor_ms_elems_<T> helper carries the refcount==1-guarded element
// loop: at least 5 blocks (entry, init, cond, body, exit), a conditional OP_BRANCH,
// and an OP_LT loop condition.
func TestGenManagedSliceElemsDtorLoopStructure() testing.TestResult {
	var innerTyp @types.Type = types.MakeStructType("Node", noFields)
	var mpTyp @types.Type = types.MakeManagedPtrType(innerTyp)
	var msTyp @types.Type = types.MakeManagedSliceType(mpTyp)

	var elemsFn @Func = genManagedSliceElemsDtor("", "__dtor_ms_elems_mp_Node", msTyp)
	if len(elemsFn.Blocks) < 5 {
		return fail("elems helper should have >=5 blocks (entry/init/cond/body/exit)")
	}
	if countOp(elemsFn, iropcode.OP_BRANCH) < 1 {
		return fail("elems helper should have a conditional iropcode.OP_BRANCH")
	}
	if countOp(elemsFn, iropcode.OP_LT) < 1 {
		return fail("elems helper should have iropcode.OP_LT for the loop condition")
	}
	return ""
}

func TestGenManagedSliceDtorSimpleElem() testing.TestResult {
	// @[]int: elements don't need destruction, so just RefDec backing
	var msTyp @types.Type = types.MakeManagedSliceType(types.TypInt())

	var dtorFn @Func = genManagedSliceDtor("", "__dtor_ms_int", msTyp)
	// Should have only 1 block (entry) since no loop needed
	if len(dtorFn.Blocks) != 1 {
		return fail("managed-slice dtor for @[]int should have 1 block")
	}
	// Should have OP_REFDEC
	var decCount int = countOp(dtorFn, iropcode.OP_REFDEC)
	if decCount < 1 {
		return fail("managed-slice dtor for @[]int should have iropcode.OP_REFDEC")
	}
	return ""
}

// ============================================================
// Managed func-value destructor generation tests
// ============================================================

// genManagedFuncValueDtor emits the signature-independent `__dtor_func` body: load
// the `@func()` at the cell and RefDec its capture record.
func TestGenManagedFuncValueDtorName() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if !charsEqual(dtorFn.Name, "__dtor_func") {
		return fail("func-value dtor name should be __dtor_func")
	}
	return ""
}

func TestGenManagedFuncValueDtorIsLinkOnce() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if !dtorFn.IsLinkOnce {
		return fail("func-value dtor should be link-once (coalesced across modules)")
	}
	return ""
}

// emitManagedFuncValueRefDec guards the closure-dtor fetch behind a null-data check,
// so the body splits into extra blocks with the RETURN on the continuation, and
// fetches the dtor via OP_FUNC_VALUE_DTOR.
func TestGenManagedFuncValueDtorSplitsAndReturns() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var dtorFn @Func = genManagedFuncValueDtor("", "__dtor_func", fvTyp)
	if len(dtorFn.Blocks) < 2 {
		return fail("func-value dtor should split (null-data guard) into extra blocks")
	}
	if countOp(dtorFn, iropcode.OP_RETURN) < 1 {
		return fail("func-value dtor should have iropcode.OP_RETURN")
	}
	if countOp(dtorFn, iropcode.OP_FUNC_VALUE_DTOR) < 1 {
		return fail("func-value dtor should fetch the closure dtor (OP_FUNC_VALUE_DTOR)")
	}
	return ""
}

// ============================================================
// Managed iface-value destructor generation tests
// ============================================================

// genManagedIfaceValueDtor emits the interface-independent `__dtor_interface` body:
// load the `@I` at the cell and RefDec its data slot.
func TestGenManagedIfaceValueDtorName() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if !charsEqual(dtorFn.Name, "__dtor_interface") {
		return fail("iface-value dtor name should be __dtor_interface")
	}
	return ""
}

func TestGenManagedIfaceValueDtorIsLinkOnce() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if !dtorFn.IsLinkOnce {
		return fail("iface-value dtor should be link-once (coalesced across modules)")
	}
	return ""
}

// emitManagedIfaceValueRefDec guards the vtable-dtor fetch behind a null-data check,
// so the body splits into extra blocks with the RETURN on the continuation.
func TestGenManagedIfaceValueDtorSplitsAndReturns() testing.TestResult {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var dtorFn @Func = genManagedIfaceValueDtor("", "__dtor_interface", ivTyp)
	if len(dtorFn.Blocks) < 2 {
		return fail("iface-value dtor should split (null-data guard) into extra blocks")
	}
	if countOp(dtorFn, iropcode.OP_RETURN) < 1 {
		return fail("iface-value dtor should have iropcode.OP_RETURN")
	}
	return ""
}
