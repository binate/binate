package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// ============================================================
// Destructor naming tests
// ============================================================

func TestDtorNameStruct() testing.TestResult {
	var t @types.Type = types.MakeStructType("Node", noFields)
	var name @[]char = dtorNameForType(t)
	if !charsEqual(name, "__dtor_Node") {
		return fail("expected __dtor_Node")
	}
	return ""
}

func TestDtorNameManagedPtr() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var t @types.Type = types.MakeManagedPtrType(inner)
	var name @[]char = dtorNameForType(t)
	if !charsEqual(name, "__dtor_mp_Node") {
		return fail("expected __dtor_mp_Node")
	}
	return ""
}

func TestDtorNameManagedSlice() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var t @types.Type = types.MakeManagedSliceType(mpT)
	var name @[]char = dtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_mp_Node") {
		return fail("expected __dtor_ms_mp_Node")
	}
	return ""
}

func TestDtorNameArray() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var t @types.Type = types.MakeArrayType(mpT, 5)
	var name @[]char = dtorNameForType(t)
	if !charsEqual(name, "__dtor_arr5_mp_Node") {
		return fail("expected __dtor_arr5_mp_Node")
	}
	return ""
}

func TestDtorNameNestedManagedSlice() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var ms1 @types.Type = types.MakeManagedSliceType(mpT)
	var t @types.Type = types.MakeManagedSliceType(ms1)
	var name @[]char = dtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_ms_mp_Node") {
		return fail("expected __dtor_ms_ms_mp_Node")
	}
	return ""
}

// @[]@Iface and @[]@func encode their element with the reserved keywords
// `interface` / `func`, NOT the bare identifiers `iv` / `fv`.  A struct named
// `iv` / `fv` is a legal user type whose TYP_STRUCT suffix is its verbatim name,
// so `iv` / `fv` element tokens would collide with `@[]structNamed_iv` on
// __dtor_ms_iv (and __copy_ms_iv) — the name-keyed dtor dedup would emit one
// body for two structurally-different slices.  Keywords can never be struct
// names, so the collision is impossible.
func TestDtorNameIfaceFuncNoStructCollision() testing.TestResult {
	var noTypeParams @[]@types.Param
	var noTypeResults @[]@types.Type
	var ifaceSlice @types.Type = types.MakeManagedSliceType(
		types.MakeManagedInterfaceValueType(nil))
	var funcSlice @types.Type = types.MakeManagedSliceType(
		types.MakeManagedFuncValueType(noTypeParams, noTypeResults))
	var ivStructSlice @types.Type = types.MakeManagedSliceType(
		types.MakeStructType("iv", noFields))
	if !charsEqual(dtorNameForType(ifaceSlice), "__dtor_ms_interface") {
		return fail("@[]@Iface dtor name should be __dtor_ms_interface")
	}
	if !charsEqual(dtorNameForType(funcSlice), "__dtor_ms_func") {
		return fail("@[]@func dtor name should be __dtor_ms_func")
	}
	if !charsEqual(copyNameForType(ifaceSlice), "__copy_ms_interface") {
		return fail("@[]@Iface copy name should be __copy_ms_interface")
	}
	if charsEqual(dtorNameForType(ifaceSlice), dtorNameForType(ivStructSlice)) {
		return fail("@[]@Iface must not collide with @[]struct-named-iv")
	}
	return ""
}

// ============================================================
// Qualified dtor naming
// ============================================================

func TestQualifiedDtorNameLocal() testing.TestResult {
	var name @[]char = qualifiedDtorName("Node")
	if !charsEqual(name, "__dtor_Node") {
		return fail("expected __dtor_Node")
	}
	return ""
}

func TestQualifiedDtorNameCrossPkg() testing.TestResult {
	var name @[]char = qualifiedDtorName("ast.File")
	if !charsEqual(name, "ast.__dtor_File") {
		return fail("expected ast.__dtor_File")
	}
	return ""
}

// ============================================================
// Hash and hex helpers
// ============================================================

func TestWriteHexZero() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	writeHex(cb, 0)
	var s @[]char = buf.CopyStr(cb.String())
	if !charsEqual(s, "0") {
		return fail("expected 0")
	}
	return ""
}

func TestWriteHex255() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	writeHex(cb, 255)
	var s @[]char = buf.CopyStr(cb.String())
	if !charsEqual(s, "ff") {
		return fail("expected ff")
	}
	return ""
}

// A uint32 with the high bit set (> INT32_MAX) is exactly what
// hashStr can produce and what an `int` writeHex could not render on
// a 32-bit host.  0x811C9DC5 is the FNV offset basis.
func TestWriteHexLarge() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	writeHex(cb, cast(uint32, 0x811C9DC5))
	if !charsEqual(buf.CopyStr(cb.String()), "811c9dc5") {
		return fail("expected 811c9dc5")
	}
	return ""
}

func TestHashStrDeterministic() testing.TestResult {
	var h1 uint32 = hashStr("hello")
	var h2 uint32 = hashStr("hello")
	if h1 != h2 {
		return fail("hash should be deterministic")
	}
	return ""
}

func TestHashStrDifferent() testing.TestResult {
	var h1 uint32 = hashStr("hello")
	var h2 uint32 = hashStr("world")
	if h1 == h2 {
		return fail("different strings should hash differently")
	}
	return ""
}

// Pin the exact FNV-1a 32-bit values so the hash stays
// host-independent: a uint32 accumulator wraps mod 2^32 on every
// target, where an int accumulator would diverge by host int width.
// Reference vectors: "hello" = 0x4F9F2CAB, "world" = 0x37A3E893,
// "" = the offset basis 0x811C9DC5.
func TestHashStrKnownVectors() testing.TestResult {
	if hashStr("hello") != cast(uint32, 0x4F9F2CAB) {
		return fail("FNV-1a of \"hello\" should be 0x4F9F2CAB")
	}
	if hashStr("world") != cast(uint32, 0x37A3E893) {
		return fail("FNV-1a of \"world\" should be 0x37A3E893")
	}
	if hashStr("") != cast(uint32, 0x811C9DC5) {
		return fail("FNV-1a of \"\" should be the offset basis")
	}
	return ""
}
