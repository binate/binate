package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Expression generation
// ============================================================

// genExpr generates IR for an expression, propagating source line info.
func genExpr(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var result @Instr = genExprInner(ctx, b, e)
	if result != nil && e != nil && e.Pos.Line > 0 {
		result.Line = e.Pos.Line
	}
	return result
}

// emitModuleConstByName emits the module-level constant named `name`,
// dispatching on its scalar family (bool → EmitConstBool, float →
// EmitConstFloat, const-expression → re-lower its stashed AST, int →
// EmitConstInt).  Returns nil if no module const has that exact name.
// Walks Module.Consts directly rather than going through lookupConst,
// which only carries the integer Val.
func emitModuleConstByName(ctx @GenContext, b @Block, name *[]readonly char) @Instr {
	for i := 0; i < len(ctx.Gc.Mod.Consts); i++ {
		if !streq(ctx.Gc.Mod.Consts[i].Name, name) { continue }
		if ctx.Gc.Mod.Consts[i].Kind == CONST_BOOL {
			return b.EmitConstBool(ctx.Gc.Mod.Consts[i].BoolVal)
		}
		if ctx.Gc.Mod.Consts[i].Kind == CONST_FLT {
			var ftyp @types.Type = ctx.Gc.Mod.Consts[i].Typ
			if ftyp == nil { ftyp = types.TypUntypedFloat() }
			return b.EmitConstFloat(ctx.Gc.Mod.Consts[i].FltText, ftyp)
		}
		// A const-EXPRESSION re-lowers its stashed AST so the backend
		// computes the value (the float-const path can't carry a folded
		// result as exact text).  Mirrors how a local float const
		// materializes via genDecl's var-init path.
		if ctx.Gc.Mod.Consts[i].Kind == CONST_EXPR {
			return genExpr(ctx, b, ctx.Gc.Mod.Consts[i].Expr)
		}
		var ctyp @types.Type = ctx.Gc.Mod.Consts[i].Typ
		if ctyp == nil { ctyp = types.TypUntypedInt() }
		// EmitConstInt64: Val is int64, so a 64-bit named const emits its full
		// value (EmitConstInt would narrow through a host int on ILP32).
		return b.EmitConstInt64(ctx.Gc.Mod.Consts[i].Val, ctyp)
	}
	return nil
}

// genExprInner dispatches expression generation by AST node kind.
func genExprInner(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	ctx.CurBlock = b
	if e.Kind == ast.EXPR_INT_LIT {
		// Phase A3 of plan-ir-gen-typed-literals.md: prefer the
		// type checker's bignum value (LitMag/LitSign on the
		// resolved Type) over re-parsing the literal text via
		// parseIntLit.  Same result for all values parseIntLit
		// handles correctly; more robust at the int64-min /
		// uint64 boundary.  Falls back to parseIntLit when the
		// checker isn't available (e.g. genFromSource tests that
		// skip type-check, until A3-test-helper migration).
		var v int64 = exprIntLitValue(ctx.Checker, e)
		return b.EmitConstInt64(v, types.TypUntypedInt())
	}

	if e.Kind == ast.EXPR_FLOAT_LIT {
		return b.EmitConstFloat(e.Name, types.TypUntypedFloat())
	}

	if e.Kind == ast.EXPR_STRING_LIT {
		return b.EmitConstString(unescapeStr(e.Name))
	}

	if e.Kind == ast.EXPR_CHAR_LIT {
		return b.EmitConstInt(types.ParseCharLit(e.Name), types.TypUint8())
	}

	if e.Kind == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			return b.EmitConstBool(streq(e.Name, "true"))
		}
		return b.EmitConstBool(e.BoolVal)
	}

	if e.Kind == ast.EXPR_NIL_LIT {
		return b.EmitConstNil(types.TypNil())
	}

	if e.Kind == ast.EXPR_IDENT {
		var ptr @Instr = lookupVar(ctx, e.Name)
		if ptr != nil {
			var typ @types.Type = lookupVarType(ctx, e.Name)
			return b.EmitLoad(ptr, typ)
		}
		// Module-level constant.  Inside a monomorphized generic body
		// emitted for an imported package (CurrentImportAlias set), a
		// bare const name is registered under the defining-package
		// qualified name, so try that first — otherwise the bare lookup
		// misses and the value silently becomes the zero placeholder
		// below (e.g. `x * SCALE` → `x * 0`).
		if len(ctx.Gc.Mod.CurrentImportAlias) > 0 {
			var qc @Instr = emitModuleConstByName(ctx, b,
					buildQualName(ctx.Gc.Mod, ctx.Gc.Mod.CurrentImportAlias, e.Name))
			if qc != nil { return qc }
		}
		var c @Instr = emitModuleConstByName(ctx, b, e.Name)
		if c != nil { return c }
		// Unknown ident — return a zero placeholder
		return b.EmitConstInt(0, types.TypInt())
	}

	if e.Kind == ast.EXPR_BINARY {
		var folded @Instr = tryFoldOversizedConst(ctx.Checker, b, e)
		if folded != nil { return folded }
		return genBinary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_UNARY {
		var folded @Instr = tryFoldOversizedConst(ctx.Checker, b, e)
		if folded != nil { return folded }
		return genUnary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_CALL {
		return genCall(ctx, b, e)
	}

	if e.Kind == ast.EXPR_BUILTIN {
		return genBuiltin(ctx, b, e)
	}

	if e.Kind == ast.EXPR_SELECTOR {
		// B.4 of plan-function-values-phase-2.md: a selector
		// whose resolved type is a function-value AND whose
		// X-side is a value (not a known type / package) is a
		// method value `x.M`.  Route to the method-value handler
		// which synthesizes a per-(method, receiver-shape) wrapper
		// + closure struct.
		if isMethodValueSelector(ctx.Gc, ctx.Checker, e) {
			return genMethodValue(ctx, b, e)
		}
		return genSelector(ctx, b, e)
	}

	if e.Kind == ast.EXPR_COMPOSITE {
		return genCompositeLit(ctx, b, e)
	}

	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return genIndex(ctx, b, e, true) // checked
	}

	if e.Kind == ast.EXPR_SLICE {
		return genSliceExpr(ctx, b, e)
	}

	if e.Kind == ast.EXPR_FUNC_LIT {
		return genFuncLit(ctx, b, e)
	}
	if e.Kind == ast.EXPR_TYPE_ASSERT {
		return genTypeAssert(ctx, b, e)
	}

	// Unsupported expression
	return b.EmitConstInt(0, types.TypInt())
}

// genLValueAddr emits the ADDRESS of an addressable lvalue expression `x`
// (`x` itself, NOT `&x`): its storage pointer, with no load of the value.  It
// is the dispatch the address-of operator uses (genUnary's `&` arm delegates
// here) and that the implicit interface value-borrow reuses to take `&x` where
// the source carried no explicit `&`.  The caller must have established `x` is
// addressable (the type-checker's isAddressable); a non-addressable `x` falls
// through to genExpr, which yields the value, not an address.
func genLValueAddr(ctx @GenContext, b @Block, x @ast.Expr) @Instr {
	// &ident: the variable's alloca pointer directly.
	if x.Kind == ast.EXPR_IDENT {
		var ptr @Instr = lookupVar(ctx, x.Name)
		if ptr != nil {
			return ptr
		}
	}
	// &arr[i]: pointer to the element (GEP, not loaded value).
	if x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var ptr @Instr = genIndexPtr(ctx, b, x)
		if ptr != nil {
			return ptr
		}
	}
	// &s.field / &p.field / &globalStruct.field: delegate to genSelectorPtr,
	// which covers value structs, managed-ptr-to-struct, raw-ptr-to-struct, and
	// indexed element struct fields.  Returns the field pointer (a GEP), NOT the
	// loaded field value.
	if x.Kind == ast.EXPR_SELECTOR {
		var ptr @Instr = genSelectorPtr(ctx, b, x)
		if ptr != nil {
			return ptr
		}
	}
	// &(*p): the address of a dereference is the pointer itself (`&*p == p`).
	// Without this the fallthrough returns the LOADED VALUE of *p as if it were
	// a pointer, so a write-through (`*pd = x`) stores to a garbage address.
	if x.Kind == ast.EXPR_UNARY && x.Op == cast(int, token.STAR) {
		return genExpr(ctx, b, x.X)
	}
	return genExpr(ctx, b, x)
}

// genUnary generates IR for unary expressions (&, *, -, !, ~).
func genUnary(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Address-of: &x returns the alloca pointer directly
	if e.Op == cast(int, token.AMP) {
		return genLValueAddr(ctx, b, e.X)
	}
	// Dereference: *p loads the pointer value, then loads through it.
	// Handles raw and managed pointers identically at the IR-gen level
	// — the deref produces an rvalue of the pointed-to type either
	// way.  Refcount semantics for the @T case stay on the *operand*
	// (the @T variable still owns its ref); the deref is a value
	// load, not an ownership transfer.  Required so that iv-method
	// dispatch routes correctly through `(*p).Foo()` when p is
	// `@(*Iface)` / `@(@Iface)` — otherwise the load is sized as
	// `i64` and the receiver carries the wrong type, failing the
	// `iv.Typ.Elem == nil` guard in genInterfaceMethodCall.
	if e.Op == cast(int, token.STAR) {
		var ptrVal @Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		// Determine pointed-to type from the pointer's type
		var elemTyp @types.Type = types.TypInt()
		if ptrVal.Typ != nil &&
				(ptrVal.Typ.Kind == types.TYP_POINTER || ptrVal.Typ.Kind == types.TYP_MANAGED_PTR) &&
				ptrVal.Typ.Elem != nil {
			elemTyp = ptrVal.Typ.Elem
		} else if e.X.Kind == ast.EXPR_IDENT {
			var varTyp @types.Type = lookupVarType(ctx, e.X.Name)
			if varTyp != nil && (varTyp.Kind == types.TYP_POINTER || varTyp.Kind == types.TYP_MANAGED_PTR) &&
					varTyp.Elem != nil {
				elemTyp = varTyp.Elem
			}
		}
		return b.EmitLoad(ptrVal, elemTyp)
	}

	var arg @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	if e.Op == cast(int, token.PLUS) {
		// Unary + is a numeric no-op — the operand value is the result.
		return arg
	}
	if e.Op == cast(int, token.MINUS) {
		// Preserve the operand's EXACT numeric type so the backend negates at
		// the right width and signedness — floats use FP negation, and an
		// integer's width must be kept (sub-word too, not just int64).  OP_NEG
		// lowers to `sub <Typ> 0, arg`, so a hardcoded host-int Typ over a
		// sub-word arg emits invalid IR (`sub i64 %i8`) and a host-width
		// negation reads the wrong value (-1 as uint8 must be 255, not host
		// -1; -9223372036854775808 against i32 silently turns into 0 — see
		// emitPrintInt / conformance 423).  This is the exact analog of the
		// `~` (OP_BITNOT) result-type fix below — both peel a named-distinct
		// wrapper (`peelTransparent`) so `type Small uint8` negates at i8, not
		// host i64; llvmType unwraps the named type to its underlying width.
		// For an untyped-int literal (arg.Typ carries no Width) the checker's
		// resolved type supplies the concrete width.
		var negTyp @types.Type = types.TypInt()
		if arg.Typ != nil && arg.Typ.IsFloat() {
			negTyp = arg.Typ
		} else if arg.Typ != nil && peelTransparent(arg.Typ).Kind == types.TYP_INT {
			negTyp = arg.Typ
		} else if ctx.Checker != nil && e.ResolvedTypeID != 0 {
			var t @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
			if t != nil && t.Kind == types.TYP_INT {
				negTyp = t
			}
		}
		return b.EmitUnary(iropcode.OP_NEG, arg, negTyp)
	}
	if e.Op == cast(int, token.NOT) {
		return b.EmitUnary(iropcode.OP_NOT, arg, types.TypBool())
	}
	if e.Op == cast(int, token.TILDE) {
		// `~` (bitwise complement) preserves the operand's type exactly — no
		// widening. The result type must therefore be the operand's own type,
		// not a hardcoded `int`: OP_BITNOT lowers to `xor <Typ> arg, -1`
		// (emit_instr.bn), so a hardcoded i64 `Typ` over a sub-word arg emits
		// invalid IR (`xor i64 %i8`), and a hardcoded signed `Typ` over an
		// unsigned operand makes a directly-consumed `>>` pick an arithmetic
		// shift instead of logical.
		var bnTyp @types.Type = arg.Typ
		if bnTyp == nil {
			bnTyp = types.TypInt()
		}
		return b.EmitUnary(iropcode.OP_BITNOT, arg, bnTyp)
	}
	return arg
}
