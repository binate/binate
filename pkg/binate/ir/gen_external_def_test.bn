package "pkg/binate/ir"

import "pkg/builtins/testing"

// nameIsCompilerInternalFunc gates a bodyless exported func out of the
// ExternalDef descriptor path iff its name is `_`-prefixed (the compiler's own
// intrinsics: rt._call_*, debug._stack_frames — lowered inline, no linkable
// symbol).  A publicly-named external impl (rt.MemZero, reflect.TypeOf) is NOT
// compiler-internal and DOES get a descriptor.
func TestNameIsCompilerInternalFunc() testing.TestResult {
	if !nameIsCompilerInternalFunc("_call_dtor") {
		return fail("a _-prefixed name (rt._call_dtor) must be compiler-internal")
	}
	if !nameIsCompilerInternalFunc("_stack_frames") {
		return fail("a _-prefixed name (debug._stack_frames) must be compiler-internal")
	}
	if nameIsCompilerInternalFunc("MemZero") {
		return fail("a public name (rt.MemZero) must NOT be compiler-internal")
	}
	if nameIsCompilerInternalFunc("TypeOf") {
		return fail("a public name (reflect.TypeOf) must NOT be compiler-internal")
	}
	if nameIsCompilerInternalFunc("") {
		return fail("an empty name must not be treated as compiler-internal")
	}
	return ""
}
