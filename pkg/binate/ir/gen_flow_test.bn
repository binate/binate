package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

func TestGenIfElse() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() { if true { println(1) }")
	cb.Write(" else { println(2) } }\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	// Should have multiple blocks: entry + if.then + if.merge +
	// if.else
	var nBlocks int = len(m.Funcs[0].Blocks)
	if nBlocks < 3 {
		return fail(buf.Concat(
				"expected >=3 blocks, got ", strconv.Itoa(nBlocks)))
	}
	// Check entry has a branch
	var entry @Block = m.Funcs[0].Blocks[0]
	var lastInstr @Instr = entry.Instrs[len(entry.Instrs) - 1]
	if lastInstr.Op != iropcode.OP_BRANCH { return fail("entry should end with branch") }
	return ""
}

func TestGenForLoop() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {")
	cb.Write(" for i := 0; i < 5; i++ { println(i) } }\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	// Should have blocks: entry, for.cond, for.body,
	// for.post, for.exit
	var nBlocks int = len(m.Funcs[0].Blocks)
	if nBlocks < 5 {
		return fail(buf.Concat(
				"expected >=5 blocks, got ", strconv.Itoa(nBlocks)))
	}
	return ""
}

func TestGenSwitchStmt() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nfunc main() {\n")
	cb.Write("\tvar x int = 1\n\tswitch x {\n")
	cb.Write("\tcase 1:\n\t\tprintln(10)\n")
	cb.Write("\tcase 2:\n\t\tprintln(20)\n")
	cb.Write("\tcase 3:\n\t\tprintln(30)\n\t}\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	if len(mainFn.Blocks) < 4 {
		return fail(
				buf.Concat(
						"expected >=4 blocks for switch, got ", strconv.Itoa(len(mainFn.Blocks))))
	}
	var branchCount int = 0
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_BRANCH {
				branchCount = branchCount + 1
			}
		}
	}
	if branchCount < 2 {
		return fail(
				buf.Concat(
						"expected >=2 branches for switch cases, got ", strconv.Itoa(branchCount)))
	}
	return ""
}

// A sub-word integer tag with an untyped integer-literal case must compare
// at the tag's width: the case operand of the OP_EQ is narrowed to the tag
// type rather than left at the untyped-int host width.  The regression left
// it untyped (i64), yielding a width-mismatched icmp that clang rejected
// (claude-todo: switch subword-tag untyped-case codegen).
func TestGenSwitchSubwordCaseWidth() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nfunc main() {\n")
	cb.Write("\tvar c char = cast(char, 9)\n\tswitch c {\n")
	cb.Write("\tcase 64:\n\t\tprintln(1)\n")
	cb.Write("\tdefault:\n\t\tprintln(0)\n\t}\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	var found bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != iropcode.OP_EQ { continue }
			if len(ins.Args) < 2 { continue }
			var tagOp @Instr = ins.Args[0]
			var caseOp @Instr = ins.Args[1]
			if tagOp.Typ == nil || caseOp.Typ == nil {
				return fail("switch OP_EQ operand has nil type")
			}
			if caseOp.Typ.Kind == types.TYP_UNTYPED_INT {
				return fail("switch case operand left untyped (host width) — not narrowed to the tag")
			}
			if tagOp.Typ.Width != caseOp.Typ.Width {
				return fail("switch OP_EQ operand width mismatch (tag vs case)")
			}
			found = true
		}
	}
	if !found { return fail("expected an OP_EQ comparing the tag to a case value") }
	return ""
}

func TestGenForShortCircuitBackedge() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nfunc main() {\n")
	cb.Write("\tvar x int = 0\n")
	cb.Write("\tfor x == 1 || x == 2 {\n")
	cb.Write("\t\tx = x + 1\n\t}\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	if len(mainFn.Blocks) < 5 {
		return fail(buf.Concat(
				"expected >=5 blocks, got ", strconv.Itoa(len(mainFn.Blocks))))
	}
	var condLabel *[]readonly char
	var postTarget *[]readonly char
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		var isForLabel bool = len(blk.Label) >= 8 && blk.Label[0] == 'f' && blk.Label[1] == 'o' &&
				blk.Label[2] == 'r' && blk.Label[3] == '.'
		if isForLabel && blk.Label[4] == 'c' {
			// bnlint:allow managed-to-raw-assign - live @Block field; outlives the read
			condLabel = blk.Label
		}
		if isForLabel && blk.Label[4] == 'p' {
			if len(blk.Instrs) > 0 {
				var last @Instr = blk.Instrs[len(blk.Instrs) - 1]
				if last.Op == iropcode.OP_JUMP && last.Block1 != nil {
					// bnlint:allow managed-to-raw-assign - live @Instr field; outlives the read
					postTarget = last.Block1.Label
				}
			}
		}
	}
	if len(condLabel) == 0 { return fail("no for.cond block found") }
	if len(postTarget) == 0 { return fail("no for.post jump target found") }
	if !charsEqual(postTarget, condLabel) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("for.post jumps to '")
		cb.Write(postTarget)
		cb.Write("' but should jump to '")
		cb.Write(condLabel)
		cb.Write("'")
		return buf.CopyStr(cb.String())
	}
	return ""
}

func TestDeclShortCircuitBlock() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo(x *[]int) int {\n")
	cb.Write("\tvar empty bool = len(x) == 0 || x[0] == 0\n")
	cb.Write("\tif empty { return 0 }\n")
	cb.Write("\treturn x[0]\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	if len(fn.Blocks) < 3 {
		return fail(buf.Concat(
				"expected >=3 blocks from || decl, got ", strconv.Itoa(len(fn.Blocks))))
	}
	var unreachableCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_UNREACHABLE {
				unreachableCount = unreachableCount + 1
			}
		}
	}
	if unreachableCount > 0 {
		return fail(
				buf.Concat(
						"unexpected unreachable instructions: ", strconv.Itoa(unreachableCount)))
	}
	return ""
}

func TestDeclAfterIfBlock() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo(x int) int {\n")
	cb.Write("\tif x == 0 { return -1 }\n")
	cb.Write("\tvar s *[]int\n\treturn 42\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var retCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_RETURN {
				retCount = retCount + 1
			}
		}
	}
	if retCount < 2 {
		return fail(buf.Concat(
				"expected 2 returns, got ", strconv.Itoa(retCount)))
	}
	return ""
}

// A managed local declared in a for-loop body BEFORE a `break` must be RefDec'd
// on the break path too, not only on the normal per-iteration fall-off —
// otherwise it leaks (STMT_BREAK formerly emitted a bare jump with no scope
// cleanup).  So `f` has TWO REFDEC sites for the single managed local `x`: the
// fall-off and the break path.  Pre-fix there was only one (the break leaked).
func TestBreakInLoopRefDecsManagedLocal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { v int }\n")
	cb.Write("func f(n int) {\n")
	cb.Write("\tfor i := 0; i < n; i = i + 1 {\n")
	cb.Write("\t\tvar x @Node = make(Node)\n")
	cb.Write("\t\tif i == 0 { break }\n")
	cb.Write("\t\t_ = x\n")
	cb.Write("\t}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.f") { fn = m.Funcs[i] }
	}
	if fn == nil { return fail("expected 'f' function") }
	var decCount int = countOp(fn, iropcode.OP_REFDEC)
	if decCount < 2 {
		return fail("break path must RefDec the managed local (expected >=2 REFDEC)")
	}
	return ""
}

// The break path must RefDec EVERY managed local in scope at the break, not just
// the last one.  With two managed locals `x` and `y` declared before the break,
// there are four REFDEC sites: the break path RefDecs both (2) and the normal
// fall-off RefDecs both (2).  If the break path covered only one local the count
// would be 3, so `>= 4` pins that the whole body scope is released on break.
func TestBreakInLoopRefDecsTwoManagedLocals() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { v int }\n")
	cb.Write("func f(n int) {\n")
	cb.Write("\tfor i := 0; i < n; i = i + 1 {\n")
	cb.Write("\t\tvar x @Node = make(Node)\n")
	cb.Write("\t\tvar y @Node = make(Node)\n")
	cb.Write("\t\tif i == 0 { break }\n")
	cb.Write("\t\t_ = x\n")
	cb.Write("\t\t_ = y\n")
	cb.Write("\t}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.f") { fn = m.Funcs[i] }
	}
	if fn == nil { return fail("expected 'f' function") }
	var decCount int = countOp(fn, iropcode.OP_REFDEC)
	if decCount < 4 {
		return fail("break path must RefDec both managed locals (expected >=4 REFDEC)")
	}
	return ""
}

// continue must likewise RefDec a managed local declared before it in the body.
func TestContinueInLoopRefDecsManagedLocal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Node struct { v int }\n")
	cb.Write("func f(n int) {\n")
	cb.Write("\tfor i := 0; i < n; i = i + 1 {\n")
	cb.Write("\t\tvar x @Node = make(Node)\n")
	cb.Write("\t\tif i == 0 { continue }\n")
	cb.Write("\t\t_ = x\n")
	cb.Write("\t}\n}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	var fn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.f") { fn = m.Funcs[i] }
	}
	if fn == nil { return fail("expected 'f' function") }
	var decCount int = countOp(fn, iropcode.OP_REFDEC)
	if decCount < 2 {
		return fail("continue path must RefDec the managed local (expected >=2 REFDEC)")
	}
	return ""
}
