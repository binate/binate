package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/builtins/testing"

func TestGenIfElse() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() { if true { println(1) }")
	cb = cb.WriteStr(" else { println(2) } }\n")
	var m @Module = genFromSource(cb.Bytes())
	// Should have multiple blocks: entry + if.then + if.merge +
	// if.else
	var nBlocks int = len(m.Funcs[0].Blocks)
	if nBlocks < 3 {
		return fail(buf.Concat(
			"expected >=3 blocks, got ",
			bootstrap.Itoa(nBlocks)))
	}
	// Check entry has a branch
	var entry @Block = m.Funcs[0].Blocks[0]
	var lastInstr @Instr = entry.Instrs[len(entry.Instrs)-1]
	if lastInstr.Op != OP_BRANCH { return fail("entry should end with branch") }
	return ""
}

func TestGenForLoop() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {")
	cb = cb.WriteStr(" for i := 0; i < 5; i++ { println(i) } }\n")
	var m @Module = genFromSource(cb.Bytes())
	// Should have blocks: entry, for.cond, for.body,
	// for.post, for.exit
	var nBlocks int = len(m.Funcs[0].Blocks)
	if nBlocks < 5 {
		return fail(buf.Concat(
			"expected >=5 blocks, got ",
			bootstrap.Itoa(nBlocks)))
	}
	return ""
}

func TestGenSwitchStmt() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\nfunc main() {\n")
	cb = cb.WriteStr("\tvar x int = 1\n\tswitch x {\n")
	cb = cb.WriteStr("\tcase 1:\n\t\tprintln(10)\n")
	cb = cb.WriteStr("\tcase 2:\n\t\tprintln(20)\n")
	cb = cb.WriteStr("\tcase 3:\n\t\tprintln(30)\n\t}\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	if len(mainFn.Blocks) < 4 {
		return fail(buf.Concat(
			"expected >=4 blocks for switch, got ",
			bootstrap.Itoa(len(mainFn.Blocks))))
	}
	var branchCount int = 0
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == OP_BRANCH {
				branchCount = branchCount + 1
			}
		}
	}
	if branchCount < 2 {
		return fail(buf.Concat(
			"expected >=2 branches for switch cases, got ",
			bootstrap.Itoa(branchCount)))
	}
	return ""
}

func TestGenForShortCircuitBackedge() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\nfunc main() {\n")
	cb = cb.WriteStr("\tvar x int = 0\n")
	cb = cb.WriteStr("\tfor x == 1 || x == 2 {\n")
	cb = cb.WriteStr("\t\tx = x + 1\n\t}\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	if len(mainFn.Blocks) < 5 {
		return fail(buf.Concat(
			"expected >=5 blocks, got ",
			bootstrap.Itoa(len(mainFn.Blocks))))
	}
	var condLabel *[]const char
	var postTarget *[]const char
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		var isForLabel bool = len(blk.Label) >= 8 &&
			blk.Label[0] == 'f' &&
			blk.Label[1] == 'o' &&
			blk.Label[2] == 'r' &&
			blk.Label[3] == '.'
		if isForLabel && blk.Label[4] == 'c' {
			condLabel = blk.Label
		}
		if isForLabel && blk.Label[4] == 'p' {
			if len(blk.Instrs) > 0 {
				var last @Instr = blk.Instrs[len(blk.Instrs)-1]
				if last.Op == OP_JUMP && last.Block1 != nil {
					postTarget = last.Block1.Label
				}
			}
		}
	}
	if len(condLabel) == 0 { return fail("no for.cond block found") }
	if len(postTarget) == 0 { return fail("no for.post jump target found") }
	if !charsEqual(postTarget, condLabel) {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("for.post jumps to '")
		cb = cb.WriteStr(postTarget)
		cb = cb.WriteStr("' but should jump to '")
		cb = cb.WriteStr(condLabel)
		cb = cb.WriteStr("'")
		return cb.Bytes()
	}
	return ""
}

func TestDeclShortCircuitBlock() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func foo(x *[]int) int {\n")
	cb = cb.WriteStr("\tvar empty bool = len(x) == 0 || x[0] == 0\n")
	cb = cb.WriteStr("\tif empty { return 0 }\n")
	cb = cb.WriteStr("\treturn x[0]\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	if len(fn.Blocks) < 3 {
		return fail(buf.Concat(
			"expected >=3 blocks from || decl, got ",
			bootstrap.Itoa(len(fn.Blocks))))
	}
	var unreachableCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == OP_UNREACHABLE {
				unreachableCount = unreachableCount + 1
			}
		}
	}
	if unreachableCount > 0 {
		return fail(buf.Concat(
			"unexpected unreachable instructions: ",
			bootstrap.Itoa(unreachableCount)))
	}
	return ""
}

func TestDeclAfterIfBlock() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func foo(x int) int {\n")
	cb = cb.WriteStr("\tif x == 0 { return -1 }\n")
	cb = cb.WriteStr("\tvar s *[]int\n\treturn 42\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var retCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == OP_RETURN {
				retCount = retCount + 1
			}
		}
	}
	if retCount < 2 {
		return fail(buf.Concat(
			"expected 2 returns, got ",
			bootstrap.Itoa(retCount)))
	}
	return ""
}
