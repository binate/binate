package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Function generation
// ============================================================

// isByvalParam mirrors pkg/codegen.isByvalParam: an aggregate-typed
// param > 16 B is passed via `ptr byval(<T>) align 8` in LLVM IR,
// which means the IR-level param IS the pointer to the struct.  The
// codegen side renders the param type that way; the IR generator
// here (gen_func.bn) skips the standard alloca + store-param-into-
// slot pattern, treating the param's own SSA ID as the slot pointer.
//
// Threshold = 16 bytes — matches SysV-AMD64's AggregateInRegMax /
// MEMORY-classification cutoff and AAPCS64's >16-byte indirect
// threshold.  See explorations/plan-codegen-byval.md.
//
// Duplicated here (rather than imported) because pkg/codegen and
// pkg/ir are siblings (both depend on pkg/types) — the threshold +
// type-kind set are a stable ABI fact, not a moving target.
func isByvalParam(t @types.Type) bool {
	if t == nil { return false }
	var k int = t.Kind
	if k != types.TYP_STRUCT &&
			k != types.TYP_ARRAY &&
			k != types.TYP_SLICE &&
			k != types.TYP_MANAGED_SLICE &&
			k != types.TYP_FUNC_VALUE &&
			k != types.TYP_MANAGED_FUNC_VALUE &&
			k != types.TYP_INTERFACE_VALUE &&
			k != types.TYP_INTERFACE_VALUE_MANAGED {
		return false
	}
	return t.SizeOf() > 16
}

// makeMultiReturnStructType creates an anonymous struct type for multi-return.
// Fields are named _0, _1, ... with types matching the return types.
func makeMultiReturnStructType(results *[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(results))
	for i := 0; i < len(results); i++ {
		var f @types.Field = make(types.Field)
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('_')
		cb = cb.WriteInt(i)
		f.Name = cb.Bytes()
		f.Type = results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// genFunc generates a complete IR function from a function declaration AST node.
func genFunc(d @ast.Decl) @Func {
	var noPrepended @[]@Param
	return genFuncWithPrependedParams(d, noPrepended)
}

// genFuncWithPrependedParams is the body of genFunc, parameterized
// by an additional list of params to prepend before the
// d.Params-derived ones.  Used by closure-literal codegen (B.2 of
// plan-function-values-phase-2.md): captures are pre-resolved
// Params built from Decl.Captures + the checker's ExprTypes
// side-table, prepended here so the lifted body's defineVarParam
// pass naturally registers their names as local variables.
// Phase 1 / non-closure callers pass nil.
func genFuncWithPrependedParams(d @ast.Decl,
		prepended @[]@Param) @Func {
	// Build params
	var params @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc(d.Name, params, noResults)
	f.Line = d.Pos.Line

	// Prepended params are already fully-built (Name + Typ + ID
	// assigned via NewParam-by-the-caller).  Re-bind their owner
	// to this Func by re-issuing IDs through NewParam, which is
	// the only way to get monotonically-correct IDs scoped to f.
	for i := 0; i < len(prepended); i++ {
		var pp @Param = prepended[i]
		var np @Param = NewParam(f, pp.Name, pp.Typ)
		params = slices.Append[@Param](params, np)
	}

	if len(d.Params) > 0 {
		for i := 0; i < len(d.Params); i++ {
			var pd @ast.ParamDecl = d.Params[i]
			var pt @types.Type = resolveTypeExpr(pd.Type)
			var p @Param = NewParam(f, pd.Name, pt)
			params = slices.Append[@Param](params, p)
		}
	}
	if len(params) > 0 {
		f.Params = params
	}

	// Build results
	if len(d.Results) > 0 {
		var results @[]@types.Type
		for i := 0; i < len(d.Results); i++ {
			results = slices.Append[@types.Type](results, resolveTypeExpr(d.Results[i]))
		}
		f.Results = results
		// For multi-return, create an anonymous struct type
		if len(results) > 1 {
			f.MultiReturnType = makeMultiReturnStructType(results)
		}
	}

	// If no body, mark as extern (declaration only, e.g. C stub in .bni)
	if d.Body == nil {
		f.IsExtern = true
		return f
	}

	// Generate body
	if d.Body != nil {
		var entry @Block = AddBlock(f, "entry")

		// Allocate stack slots for parameters.  Every param gets an
		// alloca (the slot) and a store-of-param-into-slot.  For
		// byval-eligible aggregate params, the LLVM IR-level param
		// is a `ptr byval(<T>)` pointer; the pkg/codegen emitter
		// recognises ParamIndex > 0 + isByvalParam(slot.TypeArg)
		// and substitutes a memcpy from the byval pointer to the
		// alloca for the store, so callee gets its own copy per
		// byval semantics.  Native backends still see a uniform
		// alloca + store and stash incoming bytes through it.
		var paramSlots @[]@Instr
		for i := 0; i < len(f.Params); i++ {
			var slot @Instr = entry.EmitAlloc(f.Params[i].Typ)
			// Tag the slot with its 1-based parameter index so the
			// LLVM debug-info path can emit `arg: <N>` on the
			// DILocalVariable.
			slot.ParamIndex = i + 1
			// Store param value into slot
			// We emit a placeholder — the param reference is by ID
			var paramRef @Instr = make(Instr)
			paramRef.ID = f.Params[i].ID
			paramRef.Typ = f.Params[i].Typ
			paramRef.Op = OP_CONST_INT // placeholder; LLVM emitter uses ID
			// Byval params arrive as `ptr byval(<T>)` at the LLVM
			// IR level — flag the placeholder so OP_STORE's emit
			// turns the store-into-alloca into a memcpy from the
			// byval pointer instead.  Native backends ignore the
			// flag; their spillIncomingParams handles byval params
			// directly off the arg reg / incoming stack slot.
			if isByvalParam(f.Params[i].Typ) {
				paramRef.IsByvalParamRef = true
			}
			entry.EmitStore(slot, paramRef)
			paramSlots = slices.Append[@Instr](paramSlots, slot)
		}

		var ctx @GenContext = make(GenContext)
		ctx.Func = f
		ctx.ParamSlots = paramSlots
		ctx.CurBlock = entry

		// Register params as named variables (marked as params so slices aren't freed)
		for i := 0; i < len(f.Params); i++ {
			defineVarParam(ctx, f.Params[i].Name, paramSlots[i], f.Params[i].Typ)
		}

		// Increment refcount for managed pointer/slice params (callee owns a reference)
		for i := 0; i < len(f.Params); i++ {
			if isManagedPtrType(f.Params[i].Typ) {
				var ptrVal @Instr = entry.EmitLoad(paramSlots[i], f.Params[i].Typ)
				entry.EmitRefInc(ptrVal)
			}
			if isManagedSliceType(f.Params[i].Typ) {
				var sliceVal @Instr = entry.EmitLoad(paramSlots[i], f.Params[i].Typ)
				emitManagedSliceRefInc(f, entry, sliceVal)
			}
			if isManagedFuncValueType(f.Params[i].Typ) {
				var fvVal @Instr = entry.EmitLoad(paramSlots[i], f.Params[i].Typ)
				emitManagedFuncValueRefInc(f, entry, fvVal)
			}
			// NOTE: managed interface-value params get NO entry RefInc.
			// They use the move model: the caller moves a fresh @Iface
			// arg into the call (consumeTemp) or RefInc's a borrowed one
			// at the call site (genCall / genMethod), and the param's
			// scope-exit RefDec releases that single ref.  An entry RefInc
			// would require the caller to retain+clean its arg COPY after
			// the call, which the bytecode VM cannot do for a 2-word
			// iface value passed on transient vm.SP (the call reclaims it).
		}

		// Local consts declared in the body are appended to moduleConsts
		// (so resolveTypeExpr / evalConstExpr can read their compile-time
		// value for an array dimension `[N]int`).  Save the length now and
		// truncate after the body so a function's local consts don't leak
		// into sibling functions; save/restore nests correctly for inner
		// func literals.
		var savedConstLen int = len(moduleConsts)
		genBlock(ctx, entry, d.Body)
		moduleConsts = moduleConsts[:savedConstLen]

		// If block isn't terminated, add return or unreachable
		var isVoid bool = len(f.Results) == 0
		if len(entry.Instrs) == 0 || !entry.Instrs[len(entry.Instrs)-1].IsTerminator() {
			if isVoid {
				var noRetExprs *[]@ast.Expr
				entry = emitDecForManagedLocals(ctx, entry, noRetExprs)
				var noRetVals @[]@Instr
				entry.EmitReturn(noRetVals)
			} else {
				entry.EmitUnreachable()
			}
		}
		// Also check all blocks
		for i := 0; i < len(f.Blocks); i++ {
			var blk @Block = f.Blocks[i]
			if len(blk.Instrs) == 0 || !blk.Instrs[len(blk.Instrs)-1].IsTerminator() {
				if isVoid {
					var noRetExprs2 *[]@ast.Expr
					blk = emitDecForManagedLocals(ctx, blk, noRetExprs2)
					var noRetVals2 @[]@Instr
					blk.EmitReturn(noRetVals2)
				} else {
					blk.EmitUnreachable()
				}
			}
		}
	}

	// Structural IR check (off by default; toggle via SetVerifyIR).  When
	// on, aborts the compile with diagnostics if this finalized func is
	// malformed — turning a silent IR-gen miscompile (e.g. a ctx.CurBlock
	// desync that strands stores in a terminated block) into a loud,
	// located failure.
	verifyFuncOrAbort(f)
	return f
}

// GenContext holds state during IR generation for one function.
type GenContext struct {
	Func       @Func
	Vars       @[]VarSlot      // named variable → alloca'd pointer
	ParamSlots @[]@Instr       // param index → alloca'd pointer
	BreakTo    @Block          // current break target
	ContinueTo @Block          // current continue target
	CurBlock   @Block          // tracks current block (updated by short-circuit eval)
	Temps      @[]@Instr       // managed temporaries to RefDec at end of statement
	StmtGrewSP bool            // any vm.SP-growing IR op emitted this statement?
	                           // Set by IR-gen when emitting OP_CALL / CALL_INDIRECT /
	                           // CALL_FUNC_VALUE returning an aggregate, OP_MAKE_SLICE,
	                           // OP_FUNC_VALUE, OP_RODATA_MSLICE_COPY, OP_RODATA_ARRAY.
	                           // Read + cleared by emitTempCleanup at end of statement;
	                           // when true, the cleanup emits OP_SP_RESTORE so the
	                           // bytecode VM reclaims vm.Stack bytes the statement
	                           // accumulated. The return-path cleanup
	                           // (emitTempCleanupForReturn) MUST NOT emit OP_SP_RESTORE
	                           // — doing so would truncate the about-to-be-returned
	                           // aggregate's bytes before BC_RETURN's copy-back fires.
	                           // LLVM and native backends treat OP_SP_RESTORE as a no-op.
}

// VarSlot tracks a name → SSA-pointer binding for a function-local variable
// or parameter. Ptr is the OP_ALLOC instruction whose result holds the
// variable's address; Typ is the variable's declared type. IsParam
// distinguishes parameters (whose slice values aren't freed by the
// epilogue, since they came from the caller).
type VarSlot struct {
	Name    *[]readonly char
	Ptr     @Instr
	Typ     @types.Type
	IsParam bool // true for function parameters (don't free slices)
}

// lookupLocalVar searches only function-local variables and params, NOT globals.
func lookupLocalVar(ctx @GenContext, name *[]readonly char) @Instr {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if streq(ctx.Vars[i].Name, name) {
			return ctx.Vars[i].Ptr
		}
	}
	return nil
}

// lookupVar searches locals (most recent first) then globals for a variable's alloca.
func lookupVar(ctx @GenContext, name *[]readonly char) @Instr {
	// Search backwards for most recent definition (shadowing)
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if streq(ctx.Vars[i].Name, name) {
			return ctx.Vars[i].Ptr
		}
	}
	// Fall back to global variables
	for i := 0; i < len(moduleGlobals); i++ {
		if streq(moduleGlobals[i].Name, name) {
			// Return a pseudo-instruction representing the global pointer
			var g @Instr = make(Instr)
			g.ID = -1
			g.Op = OP_ALLOC
			g.StrVal = moduleGlobals[i].Name
			g.Typ = types.MakePointerType(moduleGlobals[i].Typ)
			g.TypeArg = moduleGlobals[i].Typ
			g.IsGlobalRef = true
			return g
		}
	}
	return nil
}

// lookupImportedGlobalPtr returns an IsGlobalRef pointer to an imported
// extern var (a `.bni`-declared `var X T` registered under its dotted
// defining-pkg qualname during RegisterImport), or nil if qualName isn't
// one.  Parallels lookupVar's same-package global fallback, but the
// pointer carries the DOTTED name so codegen's GlobalName mangles it to
// the owner's symbol (matching its definition), not the importing
// module's package path.  Used for reads (lookupImportedGlobalRead) and
// for write / address-of lvalues (genSelectorPtr).
func lookupImportedGlobalPtr(qualName *[]readonly char) @Instr {
	for i := 0; i < len(moduleGlobals); i++ {
		if !streq(moduleGlobals[i].Name, qualName) { continue }
		var gp @Instr = make(Instr)
		gp.ID = -1
		gp.Op = OP_ALLOC
		gp.StrVal = moduleGlobals[i].Name
		gp.Typ = types.MakePointerType(moduleGlobals[i].Typ)
		gp.TypeArg = moduleGlobals[i].Typ
		gp.IsGlobalRef = true
		return gp
	}
	return nil
}

// lookupImportedGlobalRead loads the value of an imported extern var
// (the read form of lookupImportedGlobalPtr; nil if qualName isn't one).
func lookupImportedGlobalRead(b @Block, qualName *[]readonly char) @Instr {
	var gp @Instr = lookupImportedGlobalPtr(qualName)
	if gp == nil { return nil }
	return b.EmitLoad(gp, gp.TypeArg)
}

// genImportedVarLvalue returns the IsGlobalRef pointer for a package-
// qualified imported var used as an lvalue (`&pkg.X` / `pkg.X = v`), or
// nil if e isn't such a selector.  e.X must be a package alias (lookupVar
// misses); the pointer carries the dotted defining-pkg name so codegen
// mangles it to the owner's symbol.  The genSelectorPtr counterpart to
// lookupImportedGlobalRead.
func genImportedVarLvalue(ctx @GenContext, e @ast.Expr) @Instr {
	if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return nil }
	if lookupVar(ctx, e.X.Name) != nil { return nil }
	return lookupImportedGlobalPtr(buildQualName(e.X.Name, e.Name))
}

// lookupVarType returns the declared type of a variable (local or global).
func lookupVarType(ctx @GenContext, name *[]readonly char) @types.Type {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if streq(ctx.Vars[i].Name, name) {
			return ctx.Vars[i].Typ
		}
	}
	// Fall back to global variables
	for i := 0; i < len(moduleGlobals); i++ {
		if streq(moduleGlobals[i].Name, name) {
			return moduleGlobals[i].Typ
		}
	}
	return nil
}

// defineVar adds a local variable to the current scope in the GenContext.
func defineVar(ctx @GenContext, name *[]readonly char, ptr @Instr, typ @types.Type) {
	// Tag the alloca with the variable name for debug info
	if ptr != nil && ptr.Op == OP_ALLOC && len(ptr.StrVal) == 0 {
		ptr.StrVal = buf.CopyStr(name)
	}
	var slot VarSlot
	slot.Name = name
	slot.Ptr = ptr
	slot.Typ = typ
	slot.IsParam = false
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}

// defineVarParam adds a function parameter variable to the scope (marked as param for cleanup).
func defineVarParam(ctx @GenContext, name *[]readonly char, ptr @Instr, typ @types.Type) {
	// Tag the alloca with the variable name for debug info
	if ptr != nil && ptr.Op == OP_ALLOC && len(ptr.StrVal) == 0 {
		ptr.StrVal = buf.CopyStr(name)
	}
	var slot VarSlot
	slot.Name = name
	slot.Ptr = ptr
	slot.Typ = typ
	slot.IsParam = true
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}
