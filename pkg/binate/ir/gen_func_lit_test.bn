package "pkg/binate/ir"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// IR-gen tests for gen_func_lit.bn (Slice A.7.b of
// plan-function-values): a function literal `func(...) {...}` is
// lifted to a synthetic top-level function whose name is
// `__funclit_<n>` (counter per package), and the literal's
// expression position becomes an OP_FUNC_VALUE pointing at that
// name. The end-to-end function-value path is exercised by
// gen_func_value_test.bn — these tests pin lifting behavior
// (synthetic name, counter, function shape).

// charsEq lives in gen_method_test.bn (shared across pkg/binate/ir tests).

// intToChars: 0 → "0" (the special-case branch).
func TestIntToCharsZero() testing.TestResult {
	var s @[]char = intToChars(0)
	if !charsEq(s, "0") { return fail("intToChars(0) should be \"0\"") }
	return ""
}

// intToChars: single-digit non-zero.
func TestIntToCharsSingleDigit() testing.TestResult {
	var s @[]char = intToChars(7)
	if !charsEq(s, "7") { return fail("intToChars(7) should be \"7\"") }
	return ""
}

// intToChars: multi-digit. Pins the digit-collection-then-reverse
// order — getting the loop wrong would yield "21" for 12.
func TestIntToCharsMultiDigit() testing.TestResult {
	var s @[]char = intToChars(123)
	if !charsEq(s, "123") {
		return fail("intToChars(123) should be \"123\" (not reversed)")
	}
	return ""
}

// synthFuncLitName: counter index becomes the suffix.
func TestSynthFuncLitName() testing.TestResult {
	if !charsEq(synthFuncLitName(0), "__funclit_0") {
		return fail("synthFuncLitName(0) should be \"__funclit_0\"")
	}
	if !charsEq(synthFuncLitName(42), "__funclit_42") {
		return fail("synthFuncLitName(42) should be \"__funclit_42\"")
	}
	return ""
}

// appendU8 on an empty slice returns a 1-byte slice with the
// given byte.
func TestAppendU8Empty() testing.TestResult {
	var s @[]uint8
	var r @[]uint8 = slices.Append[uint8](s, cast(uint8, 65))
	if len(r) != 1 { return fail("len after appendU8 on empty == 1") }
	if r[0] != cast(uint8, 65) { return fail("first byte == 'A'") }
	return ""
}

// appendU8 grows: existing bytes preserved, new byte at end.
func TestAppendU8Grows() testing.TestResult {
	var s @[]uint8 = make_slice(uint8, 2)
	s[0] = cast(uint8, 1)
	s[1] = cast(uint8, 2)
	var r @[]uint8 = slices.Append[uint8](s, cast(uint8, 3))
	if len(r) != 3 { return fail("len after grow == 3") }
	if r[0] != cast(uint8, 1) { return fail("byte 0 preserved") }
	if r[1] != cast(uint8, 2) { return fail("byte 1 preserved") }
	if r[2] != cast(uint8, 3) { return fail("byte 2 == new") }
	return ""
}

// A single function literal lifts to a top-level function named
// __funclit_0 — the marker subsequent backends look for to
// distinguish lifted literals from user-named functions.
func TestGenFuncLitLifts() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var f *func(int) int = func(x int) int { return x }\n")
	src = concatChars(src, "  _ = f\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var lifted @Func = findFunc(m, "main.__funclit_0")
	if lifted == nil {
		return fail("expected lifted function named main.__funclit_0")
	}
	return ""
}

// The literal's expression position becomes OP_FUNC_VALUE pointing
// at the lifted name — without this, the binding site would get a
// placeholder zero.
func TestGenFuncLitEmitsFuncValue() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var f *func(int) int = func(x int) int { return x }\n")
	src = concatChars(src, "  _ = f\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main.main")
	if mainFn == nil { return fail("main not found") }
	if countOp(mainFn, OP_FUNC_VALUE) < 1 {
		return fail("expected OP_FUNC_VALUE for the literal")
	}
	return ""
}

// Two literals in the same package get distinct names —
// __funclit_0 and __funclit_1 — confirming the per-package
// counter advances.
func TestGenFuncLitCounterAdvances() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var f *func(int) int = func(x int) int { return x }\n")
	src = concatChars(src, "  var g *func(int) int = func(y int) int { return y + y }\n")
	src = concatChars(src, "  _ = f\n  _ = g\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	if findFunc(m, "main.__funclit_0") == nil {
		return fail("expected main.__funclit_0")
	}
	if findFunc(m, "main.__funclit_1") == nil {
		return fail("expected main.__funclit_1 (counter must advance)")
	}
	return ""
}
