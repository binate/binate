package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for gen_func.bn — function-level IR generation: genFunc,
// makeMultiReturnStructType, lookupVar / defineVar / lookupLocalVar
// (variable-scope lookup), and parameter handling. Statement-level
// tests stay in gen_stmt_test.bn. The genFromSource helper lives
// in ir_test.bn (same package).

// genFunc on a function with parameters records the parameter types
// and result type on the produced @Func.
func TestGenFuncParams() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func add(a int, b int) int { return a + b }\n")
	cb.Write("func main() { println(add(3, 4)) }\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if len(m.Funcs) != 2 {
		return fail(buf.Concat(
			"expected 2 funcs, got ",
			strconv.Itoa(len(m.Funcs))))
	}
	var addFunc @Func = m.Funcs[0]
	if !seq(addFunc.Name, "test.add") { return fail("first func should be test.add") }
	if len(addFunc.Params) != 2 { return fail("add should have 2 params") }
	if len(addFunc.Results) != 1 { return fail("add should have 1 result") }
	return ""
}

// Block-scoped `var x` shadows the outer `var x`. Each shadowed
// binding must produce its own OP_ALLOC — the variable-scope
// machinery (defineVar / lookupLocalVar / pushScope etc.) is what
// keeps the bindings distinct.
func TestGenScopeShadow() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nfunc main() {\n")
	cb.Write("\tvar x int = 1\n\t{\n")
	cb.Write("\t\tvar x int = 2\n\t\tprintln(x)\n")
	cb.Write("\t}\n\tprintln(x)\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var entry @Block = m.Funcs[0].Blocks[0]
	// Should have 2 allocs (outer x, inner x)
	var allocCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_ALLOC { allocCount = allocCount + 1 }
	}
	if allocCount < 2 {
		return fail(buf.Concat(
			"expected >=2 allocs for shadowed vars, got ",
			strconv.Itoa(allocCount)))
	}
	return ""
}

// makeMultiReturnStructType builds an anonymous struct with fields
// named _0 / _1 / ... matching the result types in order. The
// downstream multi-return lowering keys off this exact field-name
// convention.
func TestMultiReturnStructType() testing.TestResult {
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypInt()
	results[1] = types.TypBool()
	var st @types.Type = makeMultiReturnStructType(results)
	if st == nil { return fail("nil struct type") }
	if st.Kind != types.TYP_STRUCT { return fail("expected TYP_STRUCT") }
	if len(st.Fields) != 2 { return fail("expected 2 fields") }
	if !streq(st.Fields[0].Name, "_0") { return fail("field 0 should be _0") }
	if !streq(st.Fields[1].Name, "_1") { return fail("field 1 should be _1") }
	if st.Fields[0].Type.Kind != types.TYP_INT { return fail("field 0 should be int") }
	if st.Fields[1].Type.Kind != types.TYP_BOOL { return fail("field 1 should be bool") }
	return ""
}

// genFunc on a multi-return function sets MultiReturnType on the
// produced @Func — required by the lowering pipeline to know the
// packed-struct shape for return-value reads.
func TestMultiReturnFuncHasStructType() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc divmod(a int, b int) (int, int) { return a / b, a % b }\n"
	var p @parser.Parser = parser.New(cast(*[]uint8, src), "test")
	var file @ast.File = p.ParseFile()
	if len(file.Decls) == 0 { return fail("no decls") }
	var f @Func = genFunc(file.Decls[0])
	if f.MultiReturnType == nil { return fail("MultiReturnType should be set") }
	if len(f.MultiReturnType.Fields) != 2 { return fail("expected 2 fields") }
	return ""
}
