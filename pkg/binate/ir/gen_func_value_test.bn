package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// IR-gen tests for Slice A.5 of plan-function-values: a bare
// function reference (Ident / pkg.Name) is coerced into an
// OP_FUNC_VALUE at every site where it may legitimately flow into
// a function-value-typed slot — call args, return values, single-
// assign LHS, composite-literal fields. Without the coercion,
// genExpr on a function-name Ident returns a placeholder zero,
// producing broken LLVM IR / runtime null-deref crashes.

// instrCountInFunc counts how many instructions `fn` has whose
// Op matches `op` (across all blocks).
func instrCountInFunc(fn @Func, op int) int {
	return countOp(fn, op)
}

// Function reference as call argument: `apply(double, ...)` where
// apply takes `*func(int) int` should emit OP_FUNC_VALUE for
// `double` before the OP_CALL.
func TestFuncValueArgCoercion() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func double(x int) int { return x * 2 }\n")
	src = concatChars(src, "func apply(f *func(int) int, x int) int { return f(x) }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var r int = apply(double, 5)\n")
	src = concatChars(src, "  _ = r\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for `double` arg coercion")
	}
	if instrCountInFunc(mainFn, iropcode.OP_CALL) < 1 {
		return fail("expected iropcode.OP_CALL for apply()")
	}
	return ""
}

// Function reference as return value: `return double` from a
// function-value-returning function should emit OP_FUNC_VALUE.
func TestFuncValueReturnCoercion() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func double(x int) int { return x * 2 }\n")
	src = concatChars(src, "func pickDouble() *func(int) int { return double }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	var pickFn @Func = findFunc(m, "pickDouble")
	if pickFn == nil { return fail("pickDouble func not found") }
	if instrCountInFunc(pickFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for `return double`")
	}
	return ""
}

// Function reference assigned to a struct field of function-value
// type: `op.Fn = add` should emit OP_FUNC_VALUE before the store.
func TestFuncValueFieldAssignCoercion() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func add(a int, b int) int { return a + b }\n")
	src = concatChars(src, "type Op struct {\n")
	src = concatChars(src, "  Fn *func(int, int) int\n")
	src = concatChars(src, "}\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var op Op\n")
	src = concatChars(src, "  op.Fn = add\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for field-assign coercion")
	}
	return ""
}

// Function reference inside a keyed struct composite literal:
// `Op{Fn: add}` should emit OP_FUNC_VALUE for the field.
func TestFuncValueCompositeLitCoercion() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func add(a int, b int) int { return a + b }\n")
	src = concatChars(src, "type Op struct {\n")
	src = concatChars(src, "  Fn *func(int, int) int\n")
	src = concatChars(src, "}\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var op Op = Op{Fn: add}\n")
	src = concatChars(src, "  _ = op\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for composite-lit field")
	}
	return ""
}

// Calling through a struct field of function-value type:
// `op.Fn(3, 4)` must dispatch through OP_CALL_FUNC_VALUE, not
// fall into method-call dispatch (which would mint a non-existent
// `<Type>__<Field>` symbol).
func TestFuncValueFieldCallDispatch() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func add(a int, b int) int { return a + b }\n")
	src = concatChars(src, "type Op struct {\n")
	src = concatChars(src, "  Fn *func(int, int) int\n")
	src = concatChars(src, "}\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var op Op\n")
	src = concatChars(src, "  op.Fn = add\n")
	src = concatChars(src, "  var r int = op.Fn(3, 4)\n")
	src = concatChars(src, "  _ = r\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_CALL_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_CALL_FUNC_VALUE for op.Fn(...)")
	}
	return ""
}

// Pass-through: a function-value local passed as another
// function-value argument should NOT emit a fresh OP_FUNC_VALUE
// — the loaded value flows through directly. Regression guard
// against over-eager coercion.
func TestFuncValuePassThroughNoExtraEmit() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func double(x int) int { return x * 2 }\n")
	src = concatChars(src, "func apply(f *func(int) int, x int) int { return f(x) }\n")
	src = concatChars(src, "func indirect(f *func(int) int, x int) int { return apply(f, x) }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	var indFn @Func = findFunc(m, "indirect")
	if indFn == nil { return fail("indirect func not found") }
	// No fresh OP_FUNC_VALUE: f is already a function value; passing
	// it through as an arg uses the loaded value directly.
	if instrCountInFunc(indFn, iropcode.OP_FUNC_VALUE) != 0 {
		return fail("pass-through should not emit a fresh iropcode.OP_FUNC_VALUE")
	}
	return ""
}

// A generic-function instantiation used as an rvalue is a function
// reference too — isFuncRefExpr rejects the EXPR_INSTANTIATE_OR_INDEX
// shape, so a dedicated path emits OP_FUNC_VALUE for it.  Inferred var:
// `var f = Ident[int]` decays to @func and constructs the func value.
func TestGenericFuncValueInferredVar() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func Ident[T any](x T) T { return x }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var f = Ident[int]\n")
	src = concatChars(src, "  var r int = f(9)\n")
	src = concatChars(src, "  _ = r\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSourcePkg(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for `var f = Ident[int]`")
	}
	// The call through f dispatches as a func-value call, not a direct
	// symbol call (which would mint an undefined `main.f`).
	if instrCountInFunc(mainFn, iropcode.OP_CALL_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_CALL_FUNC_VALUE for f(9)")
	}
	return ""
}

// Short var: `f := Ident[int]` takes the same inferred-@func path.
func TestGenericFuncValueShortVar() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func Ident[T any](x T) T { return x }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  f := Ident[int]\n")
	src = concatChars(src, "  var r int = f(9)\n")
	src = concatChars(src, "  _ = r\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSourcePkg(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for `f := Ident[int]`")
	}
	return ""
}

// Explicit func-value type: `var f @func(int) int = Ident[int]` routes
// through genExprOrFuncRef's instantiate-as-func-value branch.
func TestGenericFuncValueExplicitType() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func Ident[T any](x T) T { return x }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var f @func(int) int = Ident[int]\n")
	src = concatChars(src, "  var r int = f(9)\n")
	src = concatChars(src, "  _ = r\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSourcePkg(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE for explicit-type instantiate")
	}
	return ""
}

// False-positive guard: an ordinary index whose head is a local var must NOT be
// treated as a generic-function instantiation.  Here a local `F` array shadows
// the same-named generic function, so `F[0]` is an array index — the
// lookupVarType guard in genericFuncInstanceName makes it fall through, emitting
// no spurious OP_FUNC_VALUE.  Regression guard for that load-bearing guard.
func TestGenericFuncValueShadowVarNotMistaken() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func F[T any](x T) T { return x }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var F [3]int\n")
	src = concatChars(src, "  var y int = F[0]\n")
	src = concatChars(src, "  _ = y\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSourcePkg(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("main func not found") }
	if instrCountInFunc(mainFn, iropcode.OP_FUNC_VALUE) != 0 {
		return fail("a local-var index must not emit a spurious OP_FUNC_VALUE")
	}
	return ""
}
