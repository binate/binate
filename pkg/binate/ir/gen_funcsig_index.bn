package "pkg/binate/ir"

// Open-addressing name→index map over Module.FuncSigs, mirroring
// pkg/binate/vm's func / extern / datasym indices.  It replaces the O(n) linear
// `streq` scans in lookupFunc* / setOrAppendFuncSig / funcSigRegistered with
// O(1) amortized probes: IR-gen's per-callee signature lookups were O(n²) over
// the whole loaded program (the `streq` + FuncSig copy/dtor churn that
// dominated bni's load profile).
//
// The index keeps the FIRST index recorded for a given Name (an insert is a
// no-op once the Name is present), so a lookup returns exactly what the prior
// first-match linear scan returned — preserving first-wins semantics even
// though the raw append sites do not dedup and FuncSigs can hold a Name twice.
// Storage is unchanged: registerFuncSig still appends every sig to FuncSigs;
// only the index dedups.
//
// Linear probing; capacity (Mask+1) is a power of two; the bucket for a name is
// `hash & Mask`.  Lazy-initialized on first insert (a zero-valued Module has
// Mask==0 / Count==0 / empty buckets) and resized at 75% load so a probe always
// meets an empty slot.  Hash: djb2 over the bytes — cheap and well-distributed
// for the short qualified names ("pkg.Func", "T.Method") callee resolution
// sees.  An empty Name (`len == 0`) marks a free slot; real qualified names are
// never empty.

// initialFuncSigIndexCap is the starting bucket count for a freshly initialized
// FuncSig index — a power of two large enough that most single packages never
// resize.
const initialFuncSigIndexCap int = 256

// funcSigHash returns a djb2 hash of `name`.  The sign is not meaningful;
// callers mask with `Mask` (a power-of-two minus one) to get a bucket, which
// yields a value in [0, Mask] regardless of sign.
func funcSigHash(name *[]readonly char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// registerFuncSig appends `sig` to mod.FuncSigs and records Name→index in the
// open-addressing index.  It is the single funnel for every FuncSigs append, so
// the index never goes stale.
func registerFuncSig(mod @Module, sig FuncSig) {
	var idx int = mod.FuncSigs.Len()
	mod.FuncSigs.Push(sig)
	funcSigIndexInsert(mod, sig.Name, idx)
}

// funcSigIndexInsert records `name -> idx`, lazy-initializing the bucket table
// on first call and resizing at 75% load.  A Name already present is left at
// its first recorded index (see file header).
func funcSigIndexInsert(mod @Module, name @[]char, idx int) {
	if mod.FuncSigIndexMask == 0 {
		mod.FuncSigIndexBuckets = make_slice(FuncSigIndexEntry, initialFuncSigIndexCap)
		mod.FuncSigIndexMask = initialFuncSigIndexCap - 1
	}
	funcSigIndexInsertInto(mod.FuncSigIndexBuckets, mod.FuncSigIndexMask, name, idx, mod)
	// Resize at 75% load: count*4 > capacity*3.
	if mod.FuncSigIndexCount * 4 > (mod.FuncSigIndexMask + 1) * 3 {
		funcSigIndexResize(mod)
	}
}

// funcSigIndexInsertInto performs one insert into the given buckets/mask,
// bumping mod.FuncSigIndexCount only on a fresh insert.  A duplicate Name keeps
// its first index (Count unchanged), so lookups stay first-match.
func funcSigIndexInsertInto(buckets @[]FuncSigIndexEntry, mask int, name @[]char, idx int,
		mod @Module) {
	var bucket int = funcSigHash(name) & mask
	var probes int = 0
	for probes <= mask {
		var pos int = (bucket + probes) & mask
		if len(buckets[pos].Name) == 0 {
			buckets[pos].Name = name
			buckets[pos].Idx = idx
			mod.FuncSigIndexCount = mod.FuncSigIndexCount + 1
			return
		}
		if streq(buckets[pos].Name, name) {
			return
		}
		probes = probes + 1
	}
	// Unreachable: the 75%-load resize guarantees a free slot.
}

// funcSigIndexResize doubles the bucket capacity and rehashes every populated
// entry.  O(N), called rarely (logarithmic in inserts).
func funcSigIndexResize(mod @Module) {
	var oldBuckets @[]FuncSigIndexEntry = mod.FuncSigIndexBuckets
	var newCap int = (mod.FuncSigIndexMask + 1) * 2
	mod.FuncSigIndexBuckets = make_slice(FuncSigIndexEntry, newCap)
	mod.FuncSigIndexMask = newCap - 1
	mod.FuncSigIndexCount = 0
	for i := 0; i < len(oldBuckets); i++ {
		if len(oldBuckets[i].Name) > 0 {
			funcSigIndexInsertInto(mod.FuncSigIndexBuckets, mod.FuncSigIndexMask, oldBuckets[i].Name,
					oldBuckets[i].Idx, mod)
		}
	}
}

// funcSigIndexLookup returns the FuncSigs index for `name`, or -1 if absent.
// O(1) amortized.
func funcSigIndexLookup(mod @Module, name *[]readonly char) int {
	if mod.FuncSigIndexMask == 0 { return -1 }
	var bucket int = funcSigHash(name) & mod.FuncSigIndexMask
	var probes int = 0
	for probes <= mod.FuncSigIndexMask {
		var pos int = (bucket + probes) & mod.FuncSigIndexMask
		if len(mod.FuncSigIndexBuckets[pos].Name) == 0 {
			return -1
		}
		if streq(mod.FuncSigIndexBuckets[pos].Name, name) {
			return mod.FuncSigIndexBuckets[pos].Idx
		}
		probes = probes + 1
	}
	return -1
}
