package "pkg/binate/ir"

// Name→index map over Module.FuncSigs (mod.FuncSigIndex), so IR-gen's per-callee
// signature lookups (lookupFunc* / setOrAppendFuncSig / funcSigRegistered) are
// O(1) instead of an O(n) linear streq scan — the streq + FuncSig copy/dtor churn
// that once dominated bni's load profile (the lookups were O(n²) over the whole
// loaded program).
//
// It is a stdlib `table.Table` (the shared open-addressing engine) parameterized by
// the ZERO-SIZE trait-type policies FuncSigHasher / FuncSigEq (declared in ir.bni,
// bodies here) — NOT a hand-rolled table, and NOT mapfn (whose FnHasher dispatches
// every probe through a runtime `*func`, an INDIRECT call the backend can't inline:
// ~3-5% slower on the load).  Because the policies are zero-size and their
// Hash/Equal are methods, `t.h.Hash(k)` / `t.e.Equal(a, b)` monomorphize to DIRECT
// (inlinable) calls — the same code a hand-inlined map emits, at parity, while still
// sharing the stdlib probe/grow/resize logic.
//
// The map keeps the FIRST index recorded for a given Name — registerFuncSig Puts
// only when the Name is absent — so a lookup returns exactly what the prior
// first-match linear scan returned, even though the raw append sites do not dedup
// and FuncSigs can hold a Name twice.  Keyed by *[]readonly char borrowing each
// registered sig's Name; the FuncSigs vec keeps that char backing alive (a
// managed-slice backing is refcount-shared, so it survives vec growth), so the
// borrowed key never dangles.

// funcSigHash is the djb2 hash of `name` — FuncSigHasher.Hash delegates to it (and
// the still-hand-rolled string interner in strings.bn reuses it).  The arithmetic
// wraps (two's complement), fine for a hash; Hash and the probe use the same
// function, so it stays consistent.
func funcSigHash(name *[]readonly char) uint {
	var h uint = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(uint, name[i])
	}
	return h
}

// FuncSigHasher.Hash — the zero-size hashing policy's method (type + impl in ir.bni).
func (h FuncSigHasher) Hash(k *[]readonly char) uint {
	return funcSigHash(k)
}

// FuncSigEq.Equal — the zero-size equality policy's method (type + impl in ir.bni).
func (e FuncSigEq) Equal(a *[]readonly char, b *[]readonly char) bool {
	return streq(a, b)
}

// registerFuncSig appends `sig` to mod.FuncSigs and records Name→index in
// mod.FuncSigIndex, keeping the first index per Name.  It is the single funnel for
// every FuncSigs append, so the index never goes stale.
func registerFuncSig(mod @Module, sig FuncSig) {
	var idx int = mod.FuncSigs.Len()
	mod.FuncSigs.Push(sig)
	// GetOrPut records idx only if Name is absent (first-wins) — a single probe,
	// versus the Has-then-Put pair this replaces.  The returned value/flag are
	// unused: we only want the first index kept.
	_, _ = mod.FuncSigIndex.GetOrPut(sig.Name, idx)
}

// funcSigIndexLookup returns the FuncSigs index for `name`, or -1 if absent.
func funcSigIndexLookup(mod @Module, name *[]readonly char) int {
	var idx int
	var ok bool
	idx, ok = mod.FuncSigIndex.Get(name)
	if ok {
		return idx
	}
	return -1
}
