package "pkg/binate/ir"

import "pkg/builtins/testing"

// fsiName builds a distinct 2-char name for index i (base-26: "aa", "ab", …),
// so a resize test can register many collision-free entries without an
// int→string helper.  Valid for i in [0, 676).
func fsiName(i int) @[]char {
	var s @[]char = make_slice(char, 2)
	s[0] = cast(char, cast(int, 'a') + (i / 26))
	s[1] = cast(char, cast(int, 'a') + (i % 26))
	return s
}

// A fresh module's index (seeded empty by NewModule) reports every name as
// absent, and registering then looking up round-trips to the append index.
func TestFuncSigIndexEmptyAndBasic() testing.TestResult {
	var m @Module = NewModule("m")
	if funcSigIndexLookup(m, "nope") != -1 {
		return fail("fresh module index must miss")
	}
	var a FuncSig
	a.Name = "pkg.A"
	registerFuncSig(m, a)
	var b FuncSig
	b.Name = "pkg.B"
	registerFuncSig(m, b)
	if funcSigIndexLookup(m, "pkg.A") != 0 {
		return fail("pkg.A must map to index 0")
	}
	if funcSigIndexLookup(m, "pkg.B") != 1 {
		return fail("pkg.B must map to index 1")
	}
	if funcSigIndexLookup(m, "pkg.C") != -1 {
		return fail("unregistered pkg.C must miss")
	}
	return ""
}

// A Name appended twice keeps its FIRST index (the raw append sites do not
// dedup, and the prior linear scan returned the first match).  FuncSigs still
// grows by two — storage is unchanged; only the index dedups.
func TestFuncSigIndexDuplicateKeepsFirst() testing.TestResult {
	var m @Module = NewModule("m")
	var first FuncSig
	first.Name = "dup"
	first.IsVariadic = false
	registerFuncSig(m, first)
	var second FuncSig
	second.Name = "dup"
	second.IsVariadic = true
	registerFuncSig(m, second)
	if m.FuncSigs.Len() != 2 {
		return fail("both dup appends must land in FuncSigs storage")
	}
	if funcSigIndexLookup(m, "dup") != 0 {
		return fail("dup must resolve to its FIRST index (0)")
	}
	if m.FuncSigs.Get(funcSigIndexLookup(m, "dup")).IsVariadic {
		return fail("lookup must return the first (non-variadic) dup entry")
	}
	return ""
}

// setOrAppendFuncSig replaces in place on a matching Name (no growth) and
// appends a fresh one otherwise; the index resolves to the (single) live entry
// either way.
func TestFuncSigIndexSetOrAppendReplaces() testing.TestResult {
	var m @Module = NewModule("m")
	var gc @GenCtx = NewGenCtx(m)
	var s1 FuncSig
	s1.Name = "S"
	s1.IsVariadic = false
	setOrAppendFuncSig(gc, s1)
	var s2 FuncSig
	s2.Name = "S"
	s2.IsVariadic = true
	setOrAppendFuncSig(gc, s2)
	if m.FuncSigs.Len() != 1 {
		return fail("setOrAppendFuncSig must replace S in place, not grow")
	}
	var idx int = funcSigIndexLookup(m, "S")
	if idx != 0 || !m.FuncSigs.Get(idx).IsVariadic {
		return fail("S must resolve to the replaced (variadic) entry")
	}
	return ""
}

// Registering past the 75%-load threshold resizes and rehashes; every entry
// must still resolve to its append index, and a never-registered name must
// still miss.  300 entries force several of table.Table's grow-and-rehash steps.
func TestFuncSigIndexResizeRehashesAll() testing.TestResult {
	var m @Module = NewModule("m")
	var n int = 300
	for i := 0; i < n; i++ {
		var sig FuncSig
		sig.Name = fsiName(i)
		registerFuncSig(m, sig)
	}
	for i := 0; i < n; i++ {
		if funcSigIndexLookup(m, fsiName(i)) != i {
			return fail("every name must resolve to its append index after resize")
		}
	}
	// A name outside the generated set (index n) must miss.
	if funcSigIndexLookup(m, fsiName(n)) != -1 {
		return fail("an unregistered name must miss after resize")
	}
	return ""
}
