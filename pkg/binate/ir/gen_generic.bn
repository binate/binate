package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Generic-instantiation IR generation — Slice 4a of
// plan-generics.md.  Monomorphizes each unique `f[T1, T2, ...]`
// call site to a specialized IR func with the type-params
// substituted for concrete @types.Type instances.  Constraint-
// method dispatch inside the body is Slice 4b territory; this
// slice covers unconstrained `[T any]` generics where the body
// uses T purely as a value carrier.

// lookupGenericDeclFile returns the AST file a stashed generic decl was defined
// in (gc.GenericDeclFiles / GenericTypeDeclFiles / GenericIfaceDeclFiles,
// parallel to the matching decl registries), or nil.  Used to resolve the
// generic body's package-qualified references against the defining file's
// imports at the instantiation site, not the consumer's alias map.
func lookupGenericDeclFile(gc @GenCtx, d @ast.Decl) @ast.File {
	for i := 0; i < len(gc.GenericDecls); i++ {
		if same(gc.GenericDecls[i], d) {
			return gc.GenericDeclFiles[i]
		}
	}
	for i := 0; i < len(gc.GenericTypeDecls); i++ {
		if same(gc.GenericTypeDecls[i], d) {
			return gc.GenericTypeDeclFiles[i]
		}
	}
	for i := 0; i < len(gc.GenericIfaceDecls); i++ {
		if same(gc.GenericIfaceDecls[i], d) {
			return gc.GenericIfaceDeclFiles[i]
		}
	}
	var none @ast.File
	return none
}

// ensureInstantiated emits the specialized IR func for `(d,
// args)` if it isn't already registered on m.  Returns the
// mangled name (which the call site uses as the call target).
//
// definingAlias is the import alias of the package `d` was
// declared in (empty for a same-package generic).  The body is
// emitted into the CONSUMER's module but was written in the
// defining package's namespace, so its unqualified references —
// struct/interface/const type names, same-package helper calls —
// must resolve against that package, not the consumer.  We install
// definingAlias as CurrentImportAlias for the duration of genFunc
// so every bare-name resolver (resolveTypeExpr, gen_iface,
// gen_const_fold, funcRefName) keys on the right package.  Without
// it a `@Box[T]` / `@Pair` parameter resolves to the TypInt
// fallback and the struct argument is silently received as zero.
func ensureInstantiated(gc @GenCtx, d @ast.Decl, args @[]@types.Type,
		definingAlias @[]char) @[]char {
	var name @[]char = instantiationMangledName(gc, d, definingAlias, args)
	if instantiationAlreadyEmitted(gc, name) {
		return name
	}
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, name)

	// Push type-param substitution context: walk the AST decl's
	// type-param list, snapshotting names and concrete types in
	// parallel so resolveTypeExpr's TEXPR_NAMED branch can replace
	// them while genFunc emits the body.
	var savedNames @[]@[]char = gc.CurrentTypeParamNames
	var savedTypes @[]@types.Type = gc.CurrentTypeParamTypes
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		newNames = slices.Append[@[]char](newNames, d.TypeParams[i].Name)
		if i < len(args) {
			newTypes = slices.Append[@types.Type](newTypes, args[i])
		} else {
			newTypes = slices.Append[@types.Type](newTypes, types.TypVoid())
		}
	}
	gc.CurrentTypeParamNames = newNames
	gc.CurrentTypeParamTypes = newTypes

	// genFunc consumes d.Name for the func's own Name.  We need
	// the mangled name on the IR func instead, so build the func
	// from a synthetic Decl that shares everything with d except
	// Name (and TypeParams, which the IR layer no longer needs).
	var synth @ast.Decl = make(ast.Decl)
	synth.Kind = d.Kind
	synth.Pos = d.Pos
	synth.Name = stripCurrentModuleQualifier(name)
	synth.Recv = d.Recv
	synth.Params = d.Params
	synth.Results = d.Results
	synth.Body = d.Body
	synth.TypeRef = d.TypeRef
	synth.Value = d.Value
	synth.IsAlias = d.IsAlias

	// Resolve the body's references against the package/file d was declared
	// in: CurrentImportAlias covers UNQUALIFIED same-package names, and the
	// defining file's import overlay covers QUALIFIED `dep.X` refs (dep being
	// the generic's own import, which the consumer need not have) — without the
	// overlay those mangle against the consumer's alias map (dangling symbol).
	var savedImportAlias @[]char = gc.Mod.CurrentImportAlias
	var aliasSnap AliasMapSnapshot = SaveAliasMapState(gc.Mod)
	var defFile @ast.File = lookupGenericDeclFile(gc, d)
	if defFile != nil {
		overlayFileImports(gc.Mod, aliasSnap, defFile)
	}
	gc.Mod.CurrentImportAlias = definingAlias
	var f @Func = genFunc(gc, gc.Mod.Checker, synth)
	RestoreAliasMapState(gc.Mod, aliasSnap)
	gc.Mod.CurrentImportAlias = savedImportAlias
	// genFunc qualifies the func's symbol by the CONSUMER module (gc.PkgPath);
	// override it with the defining-package-qualified `name` so two
	// same-final-segment packages' instantiations don't collide, and emit it
	// IsLinkOnce so every consumer's copy of one instantiation merges to a
	// single definition at link/VM time (the dtor/copy-helper pattern).
	f.Name = buf.CopyStr(name)
	f.IsLinkOnce = true
	gc.Mod.AddFunc(f)
	// Append the generated func to Module.FuncSigs (signature
	// registry) so subsequent call sites can resolve it like any
	// other top-level function.  Keyed on the same defining-package-qualified
	// name so call-site resolution finds this instantiation.
	var sig FuncSig
	sig.Name = buf.CopyStr(name)
	sig.Params = typesOfParams(f.Params)
	sig.Results = f.Results
	// Instantiation does not change variadic-ness (the last param stays `...T`),
	// so carry the generic decl's flag onto the instantiation's FuncSig — else
	// lookupFuncIsVariadic misses it and genCall binds a variadic `f[int](1,2,3)`
	// as too many positional args.  f.Params already holds the *[]T body type.
	sig.IsVariadic = declIsVariadic(d)
	if len(sig.Results) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sig.Results)
	}
	gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)

	gc.CurrentTypeParamNames = savedNames
	gc.CurrentTypeParamTypes = savedTypes
	return name
}

// instantiationAlreadyEmitted reports whether `name` is already in
// the gc.EmittedInstantiations cache for the current module.
func instantiationAlreadyEmitted(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		if streq(gc.EmittedInstantiations[i], name) { return true }
	}
	return false
}

// stripCurrentModuleQualifier removes the leading `<pkg>.`
// prefix that qualifyForCurrentModule prepends.  genFunc and
// downstream re-qualify, so the synthetic decl's Name must be
// the bare identifier piece.
func stripCurrentModuleQualifier(qual *[]readonly char) @[]char {
	for i := 0; i < len(qual); i++ {
		if qual[i] == '.' {
			return buf.CopyStr(qual[i + 1:])
		}
	}
	return buf.CopyStr(qual)
}

// typesOfParams projects an @[]@Param slice to @[]@types.Type
// for the FuncSig.Params shape used during sig registration.
func typesOfParams(ps @[]@Param) @[]@types.Type {
	var out @[]@types.Type
	for i := 0; i < len(ps); i++ {
		out = slices.Append[@types.Type](out, ps[i].Typ)
	}
	return out
}

// typeArgExprToType converts a parsed-as-Expr type argument to the
// IR-layer @types.Type.  Mirrors typeArgFromExpr in the type
// checker, which the IR gen can't share because it has no
// Checker — instead we synthesize an ast.TypeExpr matching the
// expression's shape and feed it through the IR-gen
// resolveTypeExpr.  Accepts the same forms as Slice 2b's
// type-arg parsing: EXPR_IDENT and EXPR_UNARY(STAR, X).
func typeArgExprToType(gc @GenCtx, e @ast.Expr) @types.Type {
	if e == nil { return types.TypVoid() }
	var te @ast.TypeExpr = exprToTypeExpr(e)
	if te == nil { return types.TypVoid() }
	return resolveTypeExpr(gc, te)
}

// exprToTypeExpr synthesizes an ast.TypeExpr from an ast.Expr
// in the type-arg shape.  Returns nil for shapes the IR gen
// doesn't know how to interpret (the type checker rejected
// these in Slice 2b already; we mirror the same set).
func exprToTypeExpr(e @ast.Expr) @ast.TypeExpr {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_TYPE {
		// Parser already produced the TypeExpr (parseBracketTypeArg)
		// for `@T` / `@[]T` / `*[]T` forms; hand it straight through.
		return e.TypeRef
	}
	if e.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.Name = e.Name
		return te
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @ast.TypeExpr = exprToTypeExpr(e.X)
		if inner == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_POINTER
		te.Pos = e.Pos
		te.Base = inner
		return te
	}
	return nil
}

// lookupGenericDecl returns the same-package generic AST decl
// registered under `name`, or nil if no such decl exists.
// Defaults to gc.PkgPath — for cross-package
// (Slice 7) lookups, call lookupGenericDeclPkg explicitly.
func lookupGenericDecl(gc @GenCtx, name *[]readonly char) @ast.Decl {
	return lookupGenericDeclPkg(gc, gc.PkgPath, name)
}

// lookupGenericDeclPkg returns the generic AST decl registered
// under (pkg, name), or nil.  Slice 7 of plan-generics.md:
// imported generic decls land in the same registry but pkg
// disambiguates a local `Id[T]` from an imported `genlib.Id[T]`.
func lookupGenericDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericDecls); i++ {
		if !streq(gc.GenericDecls[i].Name, name) { continue }
		if i < len(gc.GenericDeclPkgs) && !charEq(gc.GenericDeclPkgs[i], pkg) {
			continue
		}
		return gc.GenericDecls[i]
	}
	return nil
}

// lookupGenericTypeDeclPkg is the pkg-aware variant.  Slice 7.
func lookupGenericTypeDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericTypeDecls); i++ {
		if !streq(gc.GenericTypeDecls[i].Name, name) { continue }
		if i < len(gc.GenericTypeDeclPkgs) && !charEq(gc.GenericTypeDeclPkgs[i], pkg) {
			continue
		}
		return gc.GenericTypeDecls[i]
	}
	return nil
}

// lookupGenericIfaceDecl returns the same-package generic
// interface AST decl registered under `name`, or nil.
// Slice 6c counterpart to lookupGenericTypeDeclPkg.
func lookupGenericIfaceDecl(gc @GenCtx, name *[]readonly char) @ast.Decl {
	return lookupGenericIfaceDeclPkg(gc, gc.PkgPath, name)
}

// lookupGenericIfaceDeclPkg is the pkg-aware variant.  Slice 7.
func lookupGenericIfaceDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericIfaceDecls); i++ {
		if !streq(gc.GenericIfaceDecls[i].Name, name) { continue }
		if i < len(gc.GenericIfaceDeclPkgs) && !charEq(gc.GenericIfaceDeclPkgs[i], pkg) {
			continue
		}
		return gc.GenericIfaceDecls[i]
	}
	return nil
}

// ensureInstantiatedInterface materializes a per-(decl, args)
// ModuleInterface entry under the mangled name (e.g.
// `Container__bn_inst__int`), substituting the type-params in
// each method's result type.  Idempotent — repeated calls return
// the same mangled name and don't double-register.  The entry is
// keyed (Pkg) on the generic's DEFINING package — the resolved full
// path of the package where the generic interface decl lives, passed
// as definingPkg — NOT the consuming module's package.  This makes a
// library-side impl's vtable symbol match between the library TU
// (which emits the vtable) and consumers (which reference it): both
// key the instantiated iface under the same defining package.  For a
// same-package instantiation definingPkg == gc.PkgPath, so the keying
// is unchanged.
//
// Method names match the source AST.  Result types are walked
// with the type-param substitution context active so a `get() T`
// method on `Container[int]` registers as returning TypInt.
//
// The extension clause is recorded too: a generic interface's
// parents (`interface WideBox[T] : Box[T]`) are resolved under the
// same substitution context (so `Box[T]` becomes `Box[int]`) via
// collectInterfaceParents, and recorded on ParentPkgs / ParentNames.
// Without this, the instantiated source interface of a parent-upcast
// (`@WideBox[int]` -> `@Box[int]`) would have no parent recorded, so
// collectImplsFromDecl's ancestor walk would not emit the inherited
// (R, parent) vtable and IfaceParentSlotOffset / the VM name-swap
// would fail to resolve the upcast — a silent codegen failure on
// otherwise-valid code.  Aliases on generic interfaces are still
// unsupported in the surface.
func ensureInstantiatedInterface(gc @GenCtx, d @ast.Decl, args @[]@types.Type,
		definingPkg @[]char) @[]char {
	// instantiationMangledName prefixes the pkg
	// (`test.Container__bn_inst__int`) since it was built for
	// function symbols; ModuleInterface keeps Name bare with Pkg
	// stored separately, so strip the qualifier here.
	var name @[]char = stripCurrentModuleQualifier(
			instantiationMangledName(gc, d, definingPkg, args))
	var existing int = lookupModuleInterfaceIndex(
			gc.Mod, definingPkg, name)
	if existing >= 0 {
		return name
	}
	// Push type-param substitution context so resolveTypeExpr's
	// TEXPR_NAMED branch maps T → args[i] when walking method
	// result types.
	var savedNames @[]@[]char = gc.CurrentTypeParamNames
	var savedTypes @[]@types.Type = gc.CurrentTypeParamTypes
	var savedImportAlias @[]char = gc.Mod.CurrentImportAlias
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		newNames = slices.Append[@[]char](newNames, d.TypeParams[i].Name)
		if i < len(args) {
			newTypes = slices.Append[@types.Type](newTypes, args[i])
		} else {
			newTypes = slices.Append[@types.Type](newTypes, types.TypVoid())
		}
	}
	gc.CurrentTypeParamNames = newNames
	gc.CurrentTypeParamTypes = newTypes
	// Resolve the generic's method/parent signatures against the DEFINING
	// package, not the consumer's: a cross-package instantiation
	// (`@gen.Holder[int]` used in main) must resolve a bare same-package result
	// type in the generic's methods (`boxed() Thing`, Thing gen-local) to
	// `gen.Thing`, not `main.Thing` — the latter misses and degrades to int,
	// silently miscompiling the aggregate return.  For a same-package
	// instantiation definingPkg == gc.PkgPath, so this is unchanged there.
	gc.Mod.CurrentImportAlias = buf.CopyStr(definingPkg)
	// Resolve the method/parent signatures under the generic's DEFINING-file
	// imports so a qualified method type `dep.Thing` (param/result/parent
	// ref) binds to the generic's own `dep`, not the consumer's alias map —
	// which would pick the wrong type (wrong dispatch ABI / vtable shape).
	// Mirrors the checker's populateInstantiatedInterface and the struct path.
	var aliasSnap AliasMapSnapshot = SaveAliasMapState(gc.Mod)
	var defFile @ast.File = lookupGenericDeclFile(gc, d)
	if defFile != nil {
		overlayFileImports(gc.Mod, aliasSnap, defFile)
	}

	var mi ModuleInterface
	mi.Pkg = buf.CopyStr(definingPkg)
	mi.Name = buf.CopyStr(name)
	// Register an identity stub BEFORE resolving methods / parents so a
	// self-referential method type or a transitively self-reaching
	// parent chain finds this in-progress entry instead of recursing
	// forever (mirrors collectInterfaceFromDecl's self-stub).
	var selfIdx int = len(gc.Mod.Interfaces)
	gc.Mod.Interfaces = slices.Append[ModuleInterface](gc.Mod.Interfaces, mi)
	for i := 0; i < len(d.Decls); i++ {
		var mdecl @ast.Decl = d.Decls[i]
		if mdecl == nil || mdecl.Kind != ast.DECL_FUNC {
			continue
		}
		mi.MethodNames = slices.Append[@[]char](mi.MethodNames, buf.CopyStr(mdecl.Name))
		// Result + param types under the same type-param substitution context,
		// so a generic interface method's `T`-typed results/params instantiate
		// too.  Results flattened like params (parallel to the registry loop).
		for j := 0; j < len(mdecl.Results); j++ {
			mi.MethodResultsFlat = slices.Append[@types.Type](
					mi.MethodResultsFlat, resolveTypeExpr(gc, mdecl.Results[j]))
		}
		mi.MethodResultCounts = slices.Append[int](mi.MethodResultCounts, len(mdecl.Results))
		for j := 0; j < len(mdecl.Params); j++ {
			mi.MethodParamsFlat = slices.Append[@types.Type](
					mi.MethodParamsFlat, irResolveParamType(gc, mdecl.Params[j]))
		}
		mi.MethodParamCounts = slices.Append[int](mi.MethodParamCounts, len(mdecl.Params))
		mi.MethodParamVariadic = slices.Append[bool](mi.MethodParamVariadic, declIsVariadic(mdecl))
	}
	// Record the extension clause under the active substitution context
	// so a generic parent ref (`Box[T]`) instantiates to the concrete
	// parent (`Box[int]`).  Then overwrite the identity stub with the
	// now-complete entry (methods + parents).
	mi.ParentPkgs, mi.ParentNames = collectInterfaceParents(gc, d, definingPkg, definingPkg)
	gc.Mod.Interfaces[selfIdx] = mi

	RestoreAliasMapState(gc.Mod, aliasSnap)
	gc.CurrentTypeParamNames = savedNames
	gc.CurrentTypeParamTypes = savedTypes
	gc.Mod.CurrentImportAlias = savedImportAlias
	return name
}

// ensureInstantiatedStruct registers the instantiation
// `(d, args)` as a fresh module-level struct if not already
// present, with a mangled name (`List__bn_inst__int`) so
// repeated uses share the same registered struct.  Fields are
// resolved with the type-param substitution context active so
// composite-T types like `*T` become `*int` etc.  Returns the
// instantiated @types.Type.  Per plan-generics.md Slice 5c.
func ensureInstantiatedStruct(gc @GenCtx, d @ast.Decl, definingPkg @[]char,
		args @[]@types.Type) @types.Type {
	// Key the instantiated struct (and thus its dtor/copy-helper symbols) on
	// the generic's DEFINING package, so two same-final-segment packages'
	// Box[int] don't collide in the module struct registry.  The struct is
	// marked IsInstantiation so the dtor/copy driver DEFINES its helpers
	// locally as IsLinkOnce in every consumer (the defining package never
	// instantiates it) — mirroring the generic-func merge.
	var name @[]char = instantiationMangledName(gc, d, definingPkg, args)
	var si int = lookupStructIdx(gc, name)
	if si >= 0 {
		return gc.Mod.Structs[si].Typ
	}
	// Pre-register an empty struct entry so recursive references
	// inside the body (e.g. `type Node[T any] struct { next
	// @Node[T] }`) resolve back to this entry instead of looping.
	var ms ModuleStruct
	ms.Name = buf.CopyStr(name)
	var noFields @[]@types.Field
	ms.Typ = types.MakeStructType(name, noFields)
	ms.IsInstantiation = true
	// Record the instantiation context so this struct's generic-receiver methods
	// can be emitted lazily at a use site (ensureMethodsForInstName), not here —
	// this can run in pass 1/2 (a global-var / field / alias type) before the
	// method registry or other FuncSigs exist.
	ms.InstDecl = d
	ms.InstDefPkg = buf.CopyStr(definingPkg)
	ms.InstArgs = args
	gc.Mod.Structs = slices.Append[ModuleStruct](gc.Mod.Structs, ms)
	si = len(gc.Mod.Structs) - 1

	// Push the type-param substitution context so resolveTypeExpr's
	// TEXPR_NAMED branch substitutes T → args[i] when walking
	// field types.
	var savedNames @[]@[]char = gc.CurrentTypeParamNames
	var savedTypes @[]@types.Type = gc.CurrentTypeParamTypes
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		newNames = slices.Append[@[]char](newNames, d.TypeParams[i].Name)
		if i < len(args) {
			newTypes = slices.Append[@types.Type](newTypes, args[i])
		} else {
			newTypes = slices.Append[@types.Type](newTypes, types.TypVoid())
		}
	}
	gc.CurrentTypeParamNames = newNames
	gc.CurrentTypeParamTypes = newTypes

	// Resolve field types under the generic's DEFINING-file imports so a
	// qualified field type `dep.Thing` binds to the generic's own `dep`, not
	// the consumer's alias map (which would pick the wrong struct → wrong
	// layout/GEP).  Mirrors the checker's populateInstantiatedStruct.
	var aliasSnap AliasMapSnapshot = SaveAliasMapState(gc.Mod)
	var defFile @ast.File = lookupGenericDeclFile(gc, d)
	if defFile != nil {
		overlayFileImports(gc.Mod, aliasSnap, defFile)
	}
	var fields @[]@types.Field
	if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
		for j := 0; j < len(d.TypeRef.Fields); j++ {
			var fd @ast.FieldDecl = d.TypeRef.Fields[j]
			var f @types.Field = make(types.Field)
			f.Name = fd.Name
			f.Type = resolveTypeExpr(gc, fd.Type)
			fields = slices.Append[@types.Field](fields, f)
		}
	}
	RestoreAliasMapState(gc.Mod, aliasSnap)
	gc.CurrentTypeParamNames = savedNames
	gc.CurrentTypeParamTypes = savedTypes

	// Populate the pre-registered entry's fields.
	var typ @types.Type = gc.Mod.Structs[si].Typ
	typ.Fields = fields
	gc.Mod.Structs[si].Fields = fields
	// NB: this instantiation's methods are NOT emitted here — see the InstDecl
	// context recorded above and ensureMethodsForInstName, called from the
	// method-call / boxing use sites (pass 2), where the method registry and all
	// other FuncSigs are in place.
	return typ
}

// genCallInstantiate handles the IR-gen for an EXPR_CALL whose
// callee is an EXPR_INSTANTIATE_OR_INDEX with a generic head
// (the Slice 2b type-checker validated this; here we emit code).
// Steps: convert the bracketed exprs to concrete @types.Type,
// ensure the specialized IR func is emitted, then emit a regular
// call to the mangled name.  Returns the call's @Instr (the
// loaded return value if any).
//
// definingAlias is the package alias `d` was declared in (empty for
// a same-package generic) — threaded into ensureInstantiated so the
// monomorphized body resolves its unqualified references against the
// defining package, not the consumer.  The type ARGUMENTS, by
// contrast, are resolved here in the CONSUMER's context (they were
// written at the consumer call site).
func genCallInstantiate(ctx @GenContext, b @Block, e @ast.Expr, d @ast.Decl,
		definingAlias @[]char) @Instr {
	var head @ast.Expr = e.X // EXPR_INSTANTIATE_OR_INDEX
	var args @[]@types.Type
	for i := 0; i < len(head.Args); i++ {
		args = slices.Append[@types.Type](args, typeArgExprToType(ctx.Gc, head.Args[i]))
	}
	if ctx.Gc.Mod == nil { return nil }
	var name @[]char = ensureInstantiated(ctx.Gc, d, args, definingAlias)
	// Emit the user-args call.  We piggyback on the regular
	// direct-call machinery by synthesizing a callee Expr that
	// looks like a plain identifier with the mangled name.
	var fakeCallee @ast.Expr = make(ast.Expr)
	fakeCallee.Kind = ast.EXPR_IDENT
	fakeCallee.Pos = head.Pos
	fakeCallee.Name = name
	var newCall @ast.Expr = make(ast.Expr)
	newCall.Kind = ast.EXPR_CALL
	newCall.Pos = e.Pos
	newCall.X = fakeCallee
	newCall.Args = e.Args
	// Preserve a trailing spread (`f[int](s...)`) — the synthesized direct call
	// re-derives pack-vs-spread from Spread, so dropping it would silently pack a
	// spread operand as a single element.
	newCall.Spread = e.Spread
	return genExpr(ctx, b, newCall)
}
