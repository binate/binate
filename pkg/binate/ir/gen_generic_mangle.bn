package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// Mangled-name construction for generic instantiation, split out of
// gen_generic.bn for file-length hygiene.  instantiationMangledName builds
// the per-(decl, type-args) IR symbol; mangleTypeArg renders one type arg as
// an identifier-safe token.  Consumed by ensureInstantiated* in gen_generic.bn
// and the type-instantiation paths (same package).

// instantiationMangledName returns the unique IR-level name for
// a specific (generic_decl, type_args) instantiation.  Mangling
// scheme (Q2-style placeholder; can be canonicalized later):
//   `<original-qualified-name>__bn_inst__<arg1>_<arg2>...`
// Each `arg_i` is `mangleTypeArg(t)` — primitives use their
// type name, pointers prepend `ptr_`, etc.  Stable across
// repeated calls so cache lookups work.
// definingPkg is the package path the generic decl was DECLARED in; the
// instantiation symbol is qualified by it (not the consumer module) so two
// same-final-segment packages' instantiations of the same decl name get
// distinct symbols, and so all consumers of one instantiation share ONE
// symbol the linker/VM merges (the instantiation Func is emitted IsLinkOnce —
// see ensureInstantiated).  An empty definingPkg means own-package (qualify by
// the consumer, the pre-existing behavior — leaves own-package names unchanged).
func instantiationMangledName(gc @GenCtx, d @ast.Decl, definingPkg @[]char,
		args @[]@types.Type) @[]char {
	var defPkg @[]char = definingPkg
	if len(defPkg) == 0 { defPkg = gc.PkgPath }
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(qualifyForPkgPath(defPkg, d.Name))
	cb.Write("__bn_inst")
	for i := 0; i < len(args); i++ {
		cb.Write("__")
		cb.Write(mangleTypeArg(args[i]))
	}
	return buf.CopyStr(cb.String())
}

// mangleTypeArg produces a stable per-type token for use in the
// instantiation mangled name.  Slice 4a handles primitives,
// named types, and raw pointers; broader shapes (managed, slice,
// nested instantiations) land later as the surface grows.
func mangleTypeArg(t @types.Type) @[]char {
	if t == nil { return "nil" }
	if t.Kind == types.TYP_POINTER {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("ptr_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("mptr_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_SLICE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("slc_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("mslc_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_READONLY {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("ro_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_INTERFACE_VALUE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("iv_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("miv_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	// Array: the length is part of the type's identity (`[3]T` ≠ `[4]T`), so
	// fold both the length and the element into the token.
	if t.Kind == types.TYP_ARRAY {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("arr")
		stringutils.WriteInt(cb, t.ArrayLen)
		cb.Write("_")
		cb.Write(mangleTypeArg(t.Elem))
		return buf.CopyStr(cb.String())
	}
	// Function / function-value types: recurse over the signature so two
	// distinct signatures (and the func vs raw/managed func-value spellings)
	// get distinct tokens.  Without this they all reach the default branch's
	// `<unknown>` / `func(...)` placeholder and collapse to one symbol — an
	// identifier-invalid, non-injective token (the type-arg analog of the
	// same-segment collision conformance/792 fixed on the package axis).
	if t.Kind == types.TYP_FUNC {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("fn_")
		cb.Write(mangleFuncSig(t))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_FUNC_VALUE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("fv_")
		cb.Write(mangleFuncSig(t))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("mfv_")
		cb.Write(mangleFuncSig(t))
		return buf.CopyStr(cb.String())
	}
	// Default: use the type's printable name (primitives, named
	// structs, etc.), folding both '.' and '/' to "__" so the token
	// is identifier-safe.  A cross-package named type's TypeName is
	// the full path plus member (`pkg/binate/ast.File`); both separators
	// must be folded here, because the def and call sites mangle the
	// instance name through different mangle.FuncName paths and only
	// one folds the raw token.  The instance name is `<consumer-
	// pkg>.<token>`: the call site keeps the whole dotted name and
	// hits writeBnDotted (folds '.' and '/'), while the definition
	// has the leading `<pkg>.` stripped by stripCurrentModuleQualifier
	// and hits the non-dotted path, which folds only the pkgPath and
	// writes the token verbatim.  A surviving '.' or '/' in the token
	// therefore desyncs the two symbols (and a '/' is not even a valid
	// identifier char in the object format).  Folding both here leaves
	// the instance name's only separator as the leading package dot,
	// so both sides resolve consistently.
	var name @[]char = t.QualifiedTypeName()
	var cb @strings.Builder = strings.NewBuilder()
	mangle.WriteFoldedName(cb, name)
	return buf.CopyStr(cb.String())
}

// mangleFuncSig renders a function / func-value signature as an identifier-safe,
// recursion-stable token: the param count, each param's mangleTypeArg token,
// then the result count and each result's token.  The counts bound the lists so
// two signatures differing only in arity (e.g. `func(int)` vs `func(int, int)`)
// don't collide.
func mangleFuncSig(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("p")
	stringutils.WriteInt(cb, len(t.Params))
	for i := 0; i < len(t.Params); i++ {
		cb.Write("_")
		cb.Write(mangleTypeArg(t.Params[i].Type))
	}
	cb.Write("_r")
	stringutils.WriteInt(cb, len(t.Results))
	for i := 0; i < len(t.Results); i++ {
		cb.Write("_")
		cb.Write(mangleTypeArg(t.Results[i]))
	}
	return buf.CopyStr(cb.String())
}
