package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Mangled-name construction for generic instantiation, split out of
// gen_generic.bn for file-length hygiene.  instantiationMangledName builds
// the per-(decl, type-args) IR symbol; mangleTypeArg renders one type arg as
// a length-prefix TypeArg token (the self-delimiting type-arg sub-language
// shared with mangle's Demangle).  Consumed by ensureInstantiated* in
// gen_generic.bn and the type-instantiation paths (same package).

// instantiationMangledName returns the unique IR-level name for a specific
// (generic_decl, type_args) instantiation.  Mangling scheme:
//   `<original-qualified-name>__bn_inst__<lp-ArgList>`
// where `<lp-ArgList>` is `<argcount> "_" TypeArg{argcount}` (each TypeArg
// produced by mangleTypeArg).  The IR name keeps the leading `<pkg>.` so
// downstream FuncName/StructName recover the package; the `__bn_inst__`
// marker (still literal, so recvTypeIsGenericInst keeps detecting it) splits
// the decl name from the self-delimiting ArgList, which FuncName/StructName
// pass straight into the bn_I / bn_T body.  Stable across repeated calls so
// cache lookups work.
// definingPkg is the package path the generic decl was DECLARED in; the
// instantiation symbol is qualified by it (not the consumer module) so two
// same-final-segment packages' instantiations of the same decl name get
// distinct symbols, and so all consumers of one instantiation share ONE
// symbol the linker/VM merges (the instantiation Func is emitted IsLinkOnce —
// see ensureInstantiated).  An empty definingPkg means own-package (qualify by
// the consumer, the pre-existing behavior — leaves own-package names unchanged).
func instantiationMangledName(gc @GenCtx, d @ast.Decl, definingPkg @[]char,
		args @[]@types.Type) @[]char {
	var defPkg @[]char = definingPkg
	if len(defPkg) == 0 { defPkg = gc.PkgPath }
	var tokens @[]@[]char
	for i := 0; i < len(args); i++ {
		tokens = slices.Append[@[]char](tokens, mangleTypeArg(args[i]))
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(qualifyForPkgPath(defPkg, d.Name))
	cb.Write("__bn_inst__")
	mangle.LpWriteArgList(cb, tokens)
	return buf.CopyStr(cb.String())
}

// mangleTypeArg produces a length-prefix TypeArg token for one type arg, the
// inverse of which mangle.Demangle recovers.  Composite types recurse over
// their element / signature; a named or primitive type is the `N`-tag leaf
// (built from its fully-qualified name).  Every token is identifier-safe and
// injective — distinct types always yield distinct tokens.
func mangleTypeArg(t @types.Type) @[]char {
	if t == nil {
		// Defensive: an unresolved type should never reach mangling, but emit a
		// distinct, demanglable leaf rather than an invalid token if it does.
		return mangle.LpTypeArgNamedRaw("nil")
	}
	if t.Kind == types.TYP_POINTER {
		return mangle.LpTypeArgPtr(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		return mangle.LpTypeArgMptr(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_SLICE {
		return mangle.LpTypeArgSlice(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		return mangle.LpTypeArgMslice(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_READONLY {
		return mangle.LpTypeArgReadonly(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_INTERFACE_VALUE {
		return mangle.LpTypeArgIfaceVal(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return mangle.LpTypeArgMIfaceVal(mangleTypeArg(t.Elem))
	}
	if t.Kind == types.TYP_ARRAY {
		// The length is part of the type's identity (`[3]T` ≠ `[4]T`).
		return mangle.LpTypeArgArray(t.ArrayLen, mangleTypeArg(t.Elem))
	}
	// Function / function-value types: encode the signature so two distinct
	// signatures (and the func vs raw/managed func-value spellings) get
	// distinct tokens.
	if t.Kind == types.TYP_FUNC {
		return mangle.LpTypeArgFunc(mangleParamTypes(t.Params),
			mangleResultTypes(t.Results))
	}
	if t.Kind == types.TYP_FUNC_VALUE {
		return mangle.LpTypeArgFuncVal(mangleParamTypes(t.Params),
			mangleResultTypes(t.Results))
	}
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return mangle.LpTypeArgMFuncVal(mangleParamTypes(t.Params),
			mangleResultTypes(t.Results))
	}
	// Named / primitive leaf: the `N`-tag carries the fully-qualified name
	// (package path + leaf), so a type literally named like a constructor tag
	// (e.g. "ptr") can never be misread as a constructor — Finding A.
	return mangle.LpTypeArgNamedRaw(t.QualifiedTypeName())
}

// mangleParamTypes / mangleResultTypes render a signature's parameter and
// result types as the pre-encoded TypeArg list a func-type Sig consumes.
func mangleParamTypes(params @[]@types.Param) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(params); i++ {
		out = slices.Append[@[]char](out, mangleTypeArg(params[i].Type))
	}
	return out
}

// mangleResultTypes renders a signature's result types as a TypeArg list.
func mangleResultTypes(results @[]@types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(results); i++ {
		out = slices.Append[@[]char](out, mangleTypeArg(results[i]))
	}
	return out
}
