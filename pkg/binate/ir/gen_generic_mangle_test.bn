package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Unit tests for the generic-instantiation mangling helpers
// (gen_generic_mangle.bn): mangleTypeArg + instantiationMangledName.

// mangleTypeArg on a primitive type returns its source-level name.
func TestMangleTypeArgPrimitive() testing.TestResult {
	if !streq(mangleTypeArg(types.TypInt()), "int") {
		return "TypInt() should mangle as 'int'"
	}
	if !streq(mangleTypeArg(types.TypBool()), "bool") {
		return "TypBool() should mangle as 'bool'"
	}
	return ""
}
// mangleTypeArg on a pointer prepends `ptr_`.
func TestMangleTypeArgPointer() testing.TestResult {
	var t @types.Type = types.MakePointerType(types.TypInt())
	if !streq(mangleTypeArg(t), "ptr_int") {
		return "*int should mangle as 'ptr_int'"
	}
	return ""
}
// mangleTypeArg on a managed pointer prepends `mptr_`.
func TestMangleTypeArgManagedPointer() testing.TestResult {
	var t @types.Type = types.MakeManagedPtrType(types.TypInt())
	if !streq(mangleTypeArg(t), "mptr_int") {
		return "@int should mangle as 'mptr_int'"
	}
	return ""
}
// mangleTypeArg on a slice prepends `slc_`, and the recursive
// call rewraps in turn — `*[]*int` should mangle as
// `slc_ptr_int`.
func TestMangleTypeArgSlice() testing.TestResult {
	var inner @types.Type = types.MakePointerType(types.TypInt())
	var t @types.Type = types.MakeSliceType(inner)
	if !streq(mangleTypeArg(t), "slc_ptr_int") {
		return "*[]*int should mangle as 'slc_ptr_int'"
	}
	return ""
}
// mangleTypeArg on a managed slice prepends `mslc_`.
func TestMangleTypeArgManagedSlice() testing.TestResult {
	var t @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !streq(mangleTypeArg(t), "mslc_int") {
		return "@[]int should mangle as 'mslc_int'"
	}
	return ""
}
// mangleTypeArg on nil returns "nil" — defensive fallback.
func TestMangleTypeArgNil() testing.TestResult {
	if !streq(mangleTypeArg(nil), "nil") {
		return "nil should mangle as 'nil'"
	}
	return ""
}
// mangleTypeArg on a cross-package named type must NOT leak the dot
// from its qualified name into the token.  A struct named
// `things.Thing` mangles to `things__Thing`, not `things.Thing` —
// an embedded dot would route the instance name through
// mangle.FuncName's package-prefix-dropping (writeBnDotted) path,
// desyncing the instantiated function's definition and call-site
// symbols.  Regression for the cross-package type-arg mangling fix.
func TestMangleTypeArgCrossPkgNamed() testing.TestResult {
	var noFields @[]@types.Field
	var t @types.Type = types.MakeStructType("things.Thing", noFields)
	if !streq(mangleTypeArg(t), "things__Thing") {
		return "things.Thing should mangle dot-free as 'things__Thing'"
	}
	// And under @ / * wrappers (the appendXxxPtr migration shape).
	if !streq(mangleTypeArg(types.MakeManagedPtrType(t)),
			"mptr_things__Thing") {
		return "@things.Thing should mangle as 'mptr_things__Thing'"
	}
	if !streq(mangleTypeArg(types.MakePointerType(t)),
			"ptr_things__Thing") {
		return "*things.Thing should mangle as 'ptr_things__Thing'"
	}
	return ""
}
// mangleTypeArg on a full-path cross-package named type must fold the
// slash too, not just the dot.  Post full-path-mangling, a cross-
// package type's TypeName is the full path plus member (`pkg/binate/ast.File`,
// produced by resolveImportPkg + buildQualName).  A surviving '/' in
// the token desyncs the instance's definition symbol (non-dotted
// FuncName path, which writes the token verbatim — slash kept) from
// its call symbol (writeBnDotted path — slash folded to "__"), and a
// raw '/' isn't a valid identifier char in the object format anyway.
func TestMangleTypeArgFullPathCrossPkg() testing.TestResult {
	var noFields @[]@types.Field
	var t @types.Type = types.MakeStructType("pkg/binate/ast.File", noFields)
	if !streq(mangleTypeArg(t), "pkg__binate__ast__File") {
		return "pkg/binate/ast.File should mangle as 'pkg__binate__ast__File'"
	}
	if !streq(mangleTypeArg(types.MakeManagedPtrType(t)),
			"mptr_pkg__binate__ast__File") {
		return "@pkg/binate/ast.File should mangle as 'mptr_pkg__binate__ast__File'"
	}
	return ""
}
// instantiationMangledName stitches the qualified decl name, the
// `__bn_inst` marker, and each arg's mangle.  Two args produce
// two `__<arg>` segments.
func TestInstantiationMangledNameTwoArgs() testing.TestResult {
	var gc @GenCtx = NewGenCtx(nil)
	gc.PkgPath = "test"
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "pair"
	var args @[]@types.Type
	args = slices.Append[@types.Type](args, types.TypInt())
	args = slices.Append[@types.Type](args, types.TypBool())
	// Empty definingPkg => own-package (qualified by gc.PkgPath="test").
	var name @[]char = instantiationMangledName(gc, d, "", args)
	if !streq(name, "test.pair__bn_inst__int__bool") {
		return "expected test.pair__bn_inst__int__bool"
	}
	// A cross-package defining path qualifies by THAT package, so two
	// same-final-segment packages' instantiations don't collide.
	var xname @[]char = instantiationMangledName(gc, d, "pkg/aa/gen", args)
	if !streq(xname, "pkg/aa/gen.pair__bn_inst__int__bool") {
		return "expected pkg/aa/gen.pair__bn_inst__int__bool"
	}
	return ""
}

// mangleTypeArg renders an ARRAY arg with its length AND element, so [3]int,
// [4]int and [3]bool all get distinct, identifier-safe tokens (previously the
// length+element collapsed to the `[...]` placeholder).
func TestMangleTypeArgArray() testing.TestResult {
	var a3i @types.Type = types.MakeArrayType(types.TypInt(), 3)
	if !streq(mangleTypeArg(a3i), "arr3_int") {
		return "[3]int should mangle as 'arr3_int'"
	}
	if streq(mangleTypeArg(a3i),
			mangleTypeArg(types.MakeArrayType(types.TypInt(), 4))) {
		return "[3]int and [4]int must mangle differently"
	}
	if streq(mangleTypeArg(a3i),
			mangleTypeArg(types.MakeArrayType(types.TypBool(), 3))) {
		return "[3]int and [3]bool must mangle differently"
	}
	return ""
}

// A func-value arg recurses over its signature, so two DISTINCT signatures get
// distinct, identifier-safe tokens.  Before this, func/array/etc. args reached
// QualifiedTypeName's `<unknown>` / `func(...)` placeholder and collapsed to one
// non-injective, identifier-INVALID symbol (which also hard-errors on LLVM) —
// the type-arg analog of the same-segment collision conformance/792 fixed on
// the package axis.
func TestMangleTypeArgFuncValueInjective() testing.TestResult {
	var fvA @types.Type = oneArgFV(types.TypInt(), types.TypBool())   // *func(int) bool
	var fvB @types.Type = oneArgFV(types.TypBool(), types.TypInt())   // *func(bool) int
	var ta @[]char = mangleTypeArg(fvA)
	if !streq(ta, "fv_p1_int_r1_bool") {
		return "*func(int) bool should mangle as 'fv_p1_int_r1_bool'"
	}
	if streq(ta, mangleTypeArg(fvB)) {
		return "distinct func-value signatures must mangle differently"
	}
	if hasNonIdentChar(ta) {
		return "func-value token must be identifier-safe"
	}
	return ""
}

// The func / raw-func-value / managed-func-value spellings get distinct
// prefixes (fn_ / fv_ / mfv_) even for the same signature.
func TestMangleTypeArgFuncSpellingsDistinct() testing.TestResult {
	var ps @[]@types.Param = oneParam(types.TypInt())
	var rs @[]@types.Type = oneResult(types.TypBool())
	var fn @[]char = mangleTypeArg(types.MakeFuncType(ps, rs))
	var fv @[]char = mangleTypeArg(types.MakeFuncValueType(ps, rs))
	var mfv @[]char = mangleTypeArg(types.MakeManagedFuncValueType(ps, rs))
	if streq(fn, fv) || streq(fn, mfv) || streq(fv, mfv) {
		return "func / func-value / managed-func-value must mangle distinctly"
	}
	if !streq(fn, "fn_p1_int_r1_bool") {
		return "func(int) bool should mangle as 'fn_p1_int_r1_bool'"
	}
	return ""
}

// A managed-SLICE arg keeps its `mslc_` token (regression guard: a refactor
// once dropped this branch, sending @[]uint8 to the default branch where it
// became the identifier-invalid `@[]uint8` and broke the LLVM compile).
func TestMangleTypeArgManagedSliceNested() testing.TestResult {
	var ms @types.Type = types.MakeManagedSliceType(
		types.MakeManagedSliceType(types.TypInt()))
	if !streq(mangleTypeArg(ms), "mslc_mslc_int") {
		return "@[]@[]int should mangle as 'mslc_mslc_int'"
	}
	if hasNonIdentChar(mangleTypeArg(ms)) {
		return "managed-slice token must be identifier-safe"
	}
	return ""
}

// oneParam / oneResult / oneArgFV build a one-param, one-result func value.
func oneParam(t @types.Type) @[]@types.Param {
	var p @types.Param = make(types.Param)
	p.Type = t
	var ps @[]@types.Param
	ps = slices.Append[@types.Param](ps, p)
	return ps
}
func oneResult(t @types.Type) @[]@types.Type {
	var rs @[]@types.Type
	rs = slices.Append[@types.Type](rs, t)
	return rs
}
func oneArgFV(param @types.Type, result @types.Type) @types.Type {
	return types.MakeFuncValueType(oneParam(param), oneResult(result))
}

// hasNonIdentChar reports whether s contains a char outside [A-Za-z0-9_].
func hasNonIdentChar(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		var ok bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
			(c >= '0' && c <= '9') || c == '_'
		if !ok { return true }
	}
	return false
}
