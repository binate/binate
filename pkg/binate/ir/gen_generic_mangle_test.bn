package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Unit tests for the generic-instantiation mangling helpers
// (gen_generic_mangle.bn): mangleTypeArg + instantiationMangledName.  Tokens
// are now the length-prefix type-arg sub-language: a named/primitive leaf is
// `N<pkgPath><Ident>` (a primitive has the empty 0-segment package), and a
// constructor prepends its one-char tag (p=*, m=@, s=*[], M=@[], etc.).  Each
// token is spot-checked against mangle.Demangle (via demangledLeaf) so the
// expected strings stay well-formed, not hand-guessed.

// mangleTypeArg on a primitive type yields the empty-package `N` leaf.
func TestMangleTypeArgPrimitive() testing.TestResult {
	if !streq(mangleTypeArg(types.TypInt()), "N0_3_int") {
		return "TypInt() should mangle as 'N0_3_int'"
	}
	if !streq(mangleTypeArg(types.TypBool()), "N0_4_bool") {
		return "TypBool() should mangle as 'N0_4_bool'"
	}
	return ""
}

// mangleTypeArg on a pointer prepends the `p` constructor tag.
func TestMangleTypeArgPointer() testing.TestResult {
	var t @types.Type = types.MakePointerType(types.TypInt())
	if !streq(mangleTypeArg(t), "pN0_3_int") {
		return "*int should mangle as 'pN0_3_int'"
	}
	return ""
}

// mangleTypeArg on a managed pointer prepends the `m` tag.
func TestMangleTypeArgManagedPointer() testing.TestResult {
	var t @types.Type = types.MakeManagedPtrType(types.TypInt())
	if !streq(mangleTypeArg(t), "mN0_3_int") {
		return "@int should mangle as 'mN0_3_int'"
	}
	return ""
}

// mangleTypeArg on a slice prepends `s`, and the recursive call rewraps
// in turn — `*[]*int` mangles as `spN0_3_int`.
func TestMangleTypeArgSlice() testing.TestResult {
	var inner @types.Type = types.MakePointerType(types.TypInt())
	var t @types.Type = types.MakeSliceType(inner)
	if !streq(mangleTypeArg(t), "spN0_3_int") {
		return "*[]*int should mangle as 'spN0_3_int'"
	}
	return ""
}

// mangleTypeArg on a managed slice prepends the `M` tag.
func TestMangleTypeArgManagedSlice() testing.TestResult {
	var t @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !streq(mangleTypeArg(t), "MN0_3_int") {
		return "@[]int should mangle as 'MN0_3_int'"
	}
	return ""
}

// mangleTypeArg on nil yields the `nil` leaf — defensive fallback.
func TestMangleTypeArgNil() testing.TestResult {
	if !streq(mangleTypeArg(nil), "N0_3_nil") {
		return "nil should mangle as 'N0_3_nil'"
	}
	return ""
}

// mangleTypeArg on a cross-package named type splits its qualified name into
// the package path and leaf and emits the `N` leaf.  A struct named
// `things.Thing` → `N1_6_things5_Thing` (package [things], leaf Thing).  The
// length prefixes make this injective: no fold of '.'/'_' can collide it with
// another package-qualified name (the old scheme's Finding A).
func TestMangleTypeArgCrossPkgNamed() testing.TestResult {
	var noFields @[]@types.Field
	var t @types.Type = types.MakeStructType("things.Thing", noFields)
	if !streq(mangleTypeArg(t), "N1_6_things5_Thing") {
		return "things.Thing should mangle as 'N1_6_things5_Thing'"
	}
	if !demanglesToNamed(mangleTypeArg(t)) {
		return "things.Thing token must demangle to a named leaf"
	}
	// And under @ / * wrappers.
	if !streq(mangleTypeArg(types.MakeManagedPtrType(t)), "mN1_6_things5_Thing") {
		return "@things.Thing should mangle as 'mN1_6_things5_Thing'"
	}
	if !streq(mangleTypeArg(types.MakePointerType(t)), "pN1_6_things5_Thing") {
		return "*things.Thing should mangle as 'pN1_6_things5_Thing'"
	}
	return ""
}

// mangleTypeArg on a full-path cross-package named type splits the full
// "/"-path into segments.  `pkg/binate/ast.File` → package [pkg, binate, ast],
// leaf File → `N3_3_pkg6_binate3_ast4_File`.
func TestMangleTypeArgFullPathCrossPkg() testing.TestResult {
	var noFields @[]@types.Field
	var t @types.Type = types.MakeStructType("pkg/binate/ast.File", noFields)
	if !streq(mangleTypeArg(t), "N3_3_pkg6_binate3_ast4_File") {
		return "pkg/binate/ast.File should mangle as 'N3_3_pkg6_binate3_ast4_File'"
	}
	if !streq(mangleTypeArg(types.MakeManagedPtrType(t)), "mN3_3_pkg6_binate3_ast4_File") {
		return "@pkg/binate/ast.File should mangle as 'mN3_3_pkg6_binate3_ast4_File'"
	}
	return ""
}

// instantiationMangledName stitches the qualified decl name, the
// `__bn_inst__` marker, and the lp ArgList (argcount + concatenated, self-
// delimiting TypeArgs).  Two int/bool args → `2_N0_3_intN0_4_bool`.
func TestInstantiationMangledNameTwoArgs() testing.TestResult {
	var gc @GenCtx = NewGenCtx(nil)
	gc.PkgPath = "test"
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "pair"
	var args @[]@types.Type
	args = slices.Append[@types.Type](args, types.TypInt())
	args = slices.Append[@types.Type](args, types.TypBool())
	// Empty definingPkg => own-package (qualified by gc.PkgPath="test").
	var name @[]char = instantiationMangledName(gc, d, "", args)
	if !streq(name, "test.pair__bn_inst__2_N0_3_intN0_4_bool") {
		return "expected test.pair__bn_inst__2_N0_3_intN0_4_bool"
	}
	// A cross-package defining path qualifies by THAT package, so two
	// same-final-segment packages' instantiations don't collide.
	var xname @[]char = instantiationMangledName(gc, d, "pkg/aa/gen", args)
	if !streq(xname, "pkg/aa/gen.pair__bn_inst__2_N0_3_intN0_4_bool") {
		return "expected pkg/aa/gen.pair__bn_inst__2_N0_3_intN0_4_bool"
	}
	// The FuncName symbol of this instantiation must be a well-formed bn_I
	// the demangler recovers — the def/call cross-mode contract.
	if !instSymRoundTrips("pkg/aa/gen", xname) {
		return "instantiation FuncName must demangle as an inst-func"
	}
	return ""
}

// mangleTypeArg renders an ARRAY arg with its length AND element, so [3]int,
// [4]int and [3]bool all get distinct tokens.  `[3]int` → `a3_N0_3_int`.
func TestMangleTypeArgArray() testing.TestResult {
	var a3i @types.Type = types.MakeArrayType(types.TypInt(), 3)
	if !streq(mangleTypeArg(a3i), "a3_N0_3_int") {
		return "[3]int should mangle as 'a3_N0_3_int'"
	}
	if streq(mangleTypeArg(a3i), mangleTypeArg(types.MakeArrayType(types.TypInt(), 4))) {
		return "[3]int and [4]int must mangle differently"
	}
	if streq(mangleTypeArg(a3i), mangleTypeArg(types.MakeArrayType(types.TypBool(), 3))) {
		return "[3]int and [3]bool must mangle differently"
	}
	return ""
}

// An ANONYMOUS struct mangles STRUCTURALLY over its ordered (field-name, field-type)
// pairs — `S<fc>_(Ident TypeArg){fc}` — so it is TU-invariant (independent of its
// occurrence-ordered `__anon_<N>` IR name), while a NAMED struct keeps the nominal
// leaf.
func TestMangleTypeArgAnonStruct() testing.TestResult {
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt()
	var fy @types.Field = make(types.Field)
	fy.Name = "y"
	fy.Type = types.TypBool()
	var flds @[]@types.Field
	flds = slices.Append[@types.Field](flds, fx)
	flds = slices.Append[@types.Field](flds, fy)
	// struct { x int; y bool } -> "S2_" + Ident("x")="1_x" + N0_3_int + "1_y" + N0_4_bool.
	var anon @types.Type = types.MakeStructType("__anon_0", flds)
	if !streq(mangleTypeArg(anon), "S2_1_xN0_3_int1_yN0_4_bool") {
		return "anon struct{x int; y bool} should mangle structurally"
	}
	// A DIFFERENT occurrence name with the SAME structure mangles IDENTICALLY
	// (TU-invariance): the token keys on structure, not the __anon_<N> counter.
	if !streq(mangleTypeArg(anon), mangleTypeArg(types.MakeStructType("__anon_9", flds))) {
		return "identical structure must mangle identically regardless of __anon_<N>"
	}
	// Field names and field types are both part of identity.
	var flds2 @[]@types.Field
	flds2 = slices.Append[@types.Field](flds2, fx)
	var fz @types.Field = make(types.Field)
	fz.Name = "z"
	fz.Type = types.TypBool()
	flds2 = slices.Append[@types.Field](flds2, fz)
	if streq(mangleTypeArg(anon), mangleTypeArg(types.MakeStructType("__anon_1", flds2))) {
		return "a differing field name must mangle differently"
	}
	// A NAMED struct with the same fields uses the nominal leaf, NOT the struct arm.
	if streq(mangleTypeArg(anon), mangleTypeArg(types.MakeStructType("main.Pt", flds))) {
		return "a named struct must not use the structural struct arm"
	}
	return ""
}

// A func-value arg encodes its signature, so two DISTINCT signatures get
// distinct, identifier-safe tokens.  `*func(int) bool` →
// `Fp1_N0_3_intr1_N0_4_bool` (F = *func value, then the Sig).
func TestMangleTypeArgFuncValueInjective() testing.TestResult {
	var fvA @types.Type = oneArgFV(types.TypInt(), types.TypBool()) // *func(int) bool
	var fvB @types.Type = oneArgFV(types.TypBool(), types.TypInt()) // *func(bool) int
	var ta @[]char = mangleTypeArg(fvA)
	if !streq(ta, "Fp1_N0_3_intr1_N0_4_bool") {
		return "*func(int) bool should mangle as 'Fp1_N0_3_intr1_N0_4_bool'"
	}
	if streq(ta, mangleTypeArg(fvB)) {
		return "distinct func-value signatures must mangle differently"
	}
	if hasNonIdentChar(ta) {
		return "func-value token must be identifier-safe"
	}
	return ""
}

// The func / raw-func-value / managed-func-value spellings get distinct tags
// (f / F / g) even for the same signature.
func TestMangleTypeArgFuncSpellingsDistinct() testing.TestResult {
	var ps @[]@types.Param = oneParam(types.TypInt())
	var rs @[]@types.Type = oneResult(types.TypBool())
	var fn @[]char = mangleTypeArg(types.MakeFuncType(ps, rs))
	var fv @[]char = mangleTypeArg(types.MakeFuncValueType(ps, rs))
	var mfv @[]char = mangleTypeArg(types.MakeManagedFuncValueType(ps, rs))
	if streq(fn, fv) || streq(fn, mfv) || streq(fv, mfv) {
		return "func / func-value / managed-func-value must mangle distinctly"
	}
	if !streq(fn, "fp1_N0_3_intr1_N0_4_bool") {
		return "func(int) bool should mangle as 'fp1_N0_3_intr1_N0_4_bool'"
	}
	return ""
}

// A managed-SLICE arg keeps its `M` tag, recursing over its element.
// `@[]@[]int` → `MMN0_3_int`.
func TestMangleTypeArgManagedSliceNested() testing.TestResult {
	var ms @types.Type = types.MakeManagedSliceType(
			types.MakeManagedSliceType(types.TypInt()))
	if !streq(mangleTypeArg(ms), "MMN0_3_int") {
		return "@[]@[]int should mangle as 'MMN0_3_int'"
	}
	if hasNonIdentChar(mangleTypeArg(ms)) {
		return "managed-slice token must be identifier-safe"
	}
	return ""
}

// mangleTypeArg renders the readonly wrapper and the raw/managed
// interface-value wrappers with their own tags (r / i / j), recursing over
// the wrapped type.
func TestMangleTypeArgReadonlyAndIfaceValue() testing.TestResult {
	if !streq(mangleTypeArg(types.MakeReadonlyType(types.TypInt())), "rN0_3_int") {
		return "readonly int should mangle as 'rN0_3_int'"
	}
	// readonly recurses over its element: readonly *int -> rpN0_3_int.
	if !streq(mangleTypeArg(types.MakeReadonlyType(
			types.MakePointerType(types.TypInt()))), "rpN0_3_int") {
		return "readonly *int should mangle as 'rpN0_3_int'"
	}
	var iface @types.Type = types.MakeInterfaceType("pkg/foo", "Reader")
	var iv @[]char = mangleTypeArg(types.MakeInterfaceValueType(iface))
	var miv @[]char = mangleTypeArg(types.MakeManagedInterfaceValueType(iface))
	// The interface element's leaf name is "Reader" (display name); the `i`/`j`
	// tag distinguishes raw vs managed interface value.
	if !streq(iv, "iN0_6_Reader") {
		return "*Reader (interface value) should mangle as 'iN0_6_Reader'"
	}
	if !streq(miv, "jN0_6_Reader") {
		return "@Reader (managed interface value) should mangle as 'jN0_6_Reader'"
	}
	if streq(iv, miv) {
		return "raw vs managed interface-value must mangle distinctly"
	}
	if hasNonIdentChar(iv) || hasNonIdentChar(miv) {
		return "interface-value tokens must be identifier-safe"
	}
	return ""
}

// A signature is distinguished by ARITY — the param count and the
// params-vs-results split are baked into the lp Sig (`p<pc>_…r<rc>_…`), so two
// signatures differing only in arity yield distinct mangles.
func TestMangleFuncSigArity() testing.TestResult {
	var noRes @[]@types.Type
	var pIntInt @[]@types.Param = oneParam(types.TypInt())
	pIntInt = slices.Append[@types.Param](pIntInt, mkParam(types.TypInt()))
	// func(int) vs func(int, int) — differing param arity.
	var f1 @[]char = mangleTypeArg(types.MakeFuncType(oneParam(types.TypInt()), noRes))
	var f2 @[]char = mangleTypeArg(types.MakeFuncType(pIntInt, noRes))
	if streq(f1, f2) {
		return "func(int) and func(int, int) must mangle differently"
	}
	// func() bool vs func(bool) — same token (bool) on opposite sides.
	var noParams @[]@types.Param
	var fResBool @[]char = mangleTypeArg(
			types.MakeFuncType(noParams, oneResult(types.TypBool())))
	var fParamBool @[]char = mangleTypeArg(
			types.MakeFuncType(oneParam(types.TypBool()), noRes))
	if streq(fResBool, fParamBool) {
		return "func() bool and func(bool) must mangle differently"
	}
	return ""
}

// mkParam builds a single Param of the given type.  oneParam / oneResult /
// oneArgFV build a one-param, one-result func value.
func mkParam(t @types.Type) @types.Param {
	var p @types.Param = make(types.Param)
	p.Type = t
	return p
}

func oneParam(t @types.Type) @[]@types.Param {
	var ps @[]@types.Param
	ps = slices.Append[@types.Param](ps, mkParam(t))
	return ps
}

func oneResult(t @types.Type) @[]@types.Type {
	var rs @[]@types.Type
	rs = slices.Append[@types.Type](rs, t)
	return rs
}

func oneArgFV(param @types.Type, result @types.Type) @types.Type {
	return types.MakeFuncValueType(oneParam(param), oneResult(result))
}

// hasNonIdentChar reports whether s contains a char outside [A-Za-z0-9_].
func hasNonIdentChar(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		var ok bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
				c == '_'
		if !ok { return true }
	}
	return false
}

// demanglesToNamed wraps token as the sole arg of an inst-func symbol and
// checks the demangler recovers that one arg verbatim — a well-formedness
// spot-check that the token is a valid TypeArg.
func demanglesToNamed(token *[]readonly char) bool {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("main.F__bn_inst__1_")
	b.Write(token)
	var sym @[]char = mangle.FuncName("main", b.String())
	var d @mangle.DemangledName
	var ok bool
	d, ok = mangle.Demangle(sym)
	if !ok || d.Kind != mangle.KIND_INST_FUNC || len(d.Args) != 1 {
		return false
	}
	return streq(d.Args[0], token)
}

// instSymRoundTrips checks that FuncName(pkgPath, instName) is a well-formed
// bn_I symbol the demangler recovers as an inst-func.
func instSymRoundTrips(pkgPath *[]readonly char, instName *[]readonly char) bool {
	var sym @[]char = mangle.FuncName(pkgPath, instName)
	var d @mangle.DemangledName
	var ok bool
	d, ok = mangle.Demangle(sym)
	return ok && d.Kind == mangle.KIND_INST_FUNC
}
