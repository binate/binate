package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Builds a `Cursor[T]` instantiation TypeExpr (head Cursor, one type-arg T).
func makeCursorInst() @ast.TypeExpr {
	var head @ast.TypeExpr = make(ast.TypeExpr)
	head.Kind = ast.TEXPR_NAMED
	head.Name = "Cursor"
	var arg @ast.TypeExpr = make(ast.TypeExpr)
	arg.Kind = ast.TEXPR_NAMED
	arg.Name = "T"
	var inst @ast.TypeExpr = make(ast.TypeExpr)
	inst.Kind = ast.TEXPR_INSTANTIATE
	inst.Base = head
	inst.TypeArgs = slicesOfOne(arg)
	return inst
}

// slicesOfOne wraps a single TypeExpr in a fresh @[]@ast.TypeExpr.
func slicesOfOne(te @ast.TypeExpr) @[]@ast.TypeExpr {
	var out @[]@ast.TypeExpr = make_slice(@ast.TypeExpr, 1)
	out[0] = te
	return out
}

// receiverGenericInstBase peels a `*Cursor[T]` receiver to its TEXPR_INSTANTIATE.
func TestReceiverGenericInstBasePointer() testing.TestResult {
	var recv @ast.TypeExpr = make(ast.TypeExpr)
	recv.Kind = ast.TEXPR_POINTER
	recv.Base = makeCursorInst()
	var base @ast.TypeExpr = receiverGenericInstBase(recv)
	if base == nil { return "expected non-nil instantiation base" }
	if base.Kind != ast.TEXPR_INSTANTIATE { return "expected TEXPR_INSTANTIATE base" }
	if base.Base == nil || !streq(base.Base.Name, "Cursor") {
		return "expected head named Cursor"
	}
	return ""
}

// A managed receiver `@Cursor[T]` also peels to the instantiation.
func TestReceiverGenericInstBaseManaged() testing.TestResult {
	var recv @ast.TypeExpr = make(ast.TypeExpr)
	recv.Kind = ast.TEXPR_MANAGED
	recv.Base = makeCursorInst()
	if receiverGenericInstBase(recv) == nil {
		return "expected non-nil instantiation base for managed receiver"
	}
	return ""
}

// A plain named receiver `*Box` is not a generic instantiation.
func TestReceiverGenericInstBasePlain() testing.TestResult {
	var named @ast.TypeExpr = make(ast.TypeExpr)
	named.Kind = ast.TEXPR_NAMED
	named.Name = "Box"
	var recv @ast.TypeExpr = make(ast.TypeExpr)
	recv.Kind = ast.TEXPR_POINTER
	recv.Base = named
	if receiverGenericInstBase(recv) != nil {
		return "plain named receiver should not be a generic instantiation"
	}
	return ""
}

// isGenericReceiverMethod is true for a method whose receiver is `*Cursor[T]`.
func TestIsGenericReceiverMethodTrue() testing.TestResult {
	var recv @ast.ParamDecl = make(ast.ParamDecl)
	recv.Name = "it"
	recv.Type = make(ast.TypeExpr)
	recv.Type.Kind = ast.TEXPR_POINTER
	recv.Type.Base = makeCursorInst()
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Next"
	d.Recv = recv
	if !isGenericReceiverMethod(d) {
		return "expected generic-receiver method to be recognized"
	}
	return ""
}

// isGenericReceiverMethod is false for a method on a plain (non-generic) type.
func TestIsGenericReceiverMethodPlain() testing.TestResult {
	var named @ast.TypeExpr = make(ast.TypeExpr)
	named.Kind = ast.TEXPR_NAMED
	named.Name = "Box"
	var recv @ast.ParamDecl = make(ast.ParamDecl)
	recv.Name = "b"
	recv.Type = make(ast.TypeExpr)
	recv.Type.Kind = ast.TEXPR_POINTER
	recv.Type.Base = named
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	d.Recv = recv
	if isGenericReceiverMethod(d) {
		return "plain-type method should not be a generic-receiver method"
	}
	return ""
}

// isGenericReceiverMethod is false for a free function (no receiver).
func TestIsGenericReceiverMethodFreeFunc() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Sum"
	if isGenericReceiverMethod(d) {
		return "free function should not be a generic-receiver method"
	}
	return ""
}

// genericMethodRecvName returns the generic base name of a `*Cursor[T]` method.
func TestGenericMethodRecvName() testing.TestResult {
	var recv @ast.ParamDecl = make(ast.ParamDecl)
	recv.Name = "c"
	recv.Type = make(ast.TypeExpr)
	recv.Type.Kind = ast.TEXPR_POINTER
	recv.Type.Base = makeCursorInst()
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Next"
	d.Recv = recv
	if !streq(genericMethodRecvName(d), "Cursor") {
		return "expected generic base name 'Cursor'"
	}
	return ""
}

// joinMethodName appends `.<method>` to a struct instantiation name — the exact
// key the direct-call site derives, so emitted body and call site agree.
func TestJoinMethodName() testing.TestResult {
	var got @[]char = joinMethodName("main.Box__bn_inst__int", "Get")
	if !streq(got, "main.Box__bn_inst__int.Get") {
		return "expected 'main.Box__bn_inst__int.Get'"
	}
	return ""
}

// nameIsGenericInst detects the `__bn_inst__` instantiation marker anywhere in
// the name, and rejects ordinary (non-instantiated) type names.
func TestNameIsGenericInst() testing.TestResult {
	if !nameIsGenericInst("Box__bn_inst__int") {
		return "expected instantiation name to be detected"
	}
	if !nameIsGenericInst("Pair__bn_inst__2_int_bool") {
		return "expected multi-arg instantiation name to be detected"
	}
	if nameIsGenericInst("Box") {
		return "plain type name should not be an instantiation"
	}
	if nameIsGenericInst("") {
		return "empty name should not be an instantiation"
	}
	return ""
}
