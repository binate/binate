package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// ensureInstantiatedStruct registers a monomorphized struct once per (decl,
// args), records its instantiation context (IsInstantiation + InstDecl/InstArgs,
// consumed by ensureMethodsForInstName for lazy method emission), and dedups
// repeat calls to the same Type.  An empty generic struct is used so no field
// resolution (and thus no checker) is needed.
func TestEnsureInstantiatedStructDedupAndRecord() testing.TestResult {
	var m @Module = NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	// type Box[T any] struct {}
	var tp @ast.TypeParam = make(ast.TypeParam)
	tp.Name = "T"
	var tps @[]@ast.TypeParam
	tps = slices.Append[@ast.TypeParam](tps, tp)
	var structTe @ast.TypeExpr = make(ast.TypeExpr)
	structTe.Kind = ast.TEXPR_STRUCT
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_TYPE
	d.Name = "Box"
	d.TypeParams = tps
	d.TypeRef = structTe
	var args @[]@types.Type
	args = slices.Append[@types.Type](args, types.TypInt())

	var t1 @types.Type = ensureInstantiatedStruct(gc, d, "test", args)
	if t1 == nil {
		return "expected non-nil instantiated type"
	}
	var count1 int = len(gc.Mod.Structs)
	var t2 @types.Type = ensureInstantiatedStruct(gc, d, "test", args)
	if t2 == nil {
		return "expected non-nil on repeat call"
	}
	if len(gc.Mod.Structs) != count1 {
		return "repeat instantiation should dedup, not register a second struct"
	}
	var si int = lookupStructIdx(gc, t1.Name)
	if si < 0 {
		return "instantiated struct not found by name"
	}
	if !gc.Mod.Structs[si].IsInstantiation {
		return "expected IsInstantiation flag"
	}
	if gc.Mod.Structs[si].InstDecl == nil {
		return "expected InstDecl recorded for lazy method emission"
	}
	if len(gc.Mod.Structs[si].InstArgs) != 1 {
		return "expected InstArgs recorded"
	}
	return ""
}
