package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/irsym"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// RegisterModuleGlobalVar appends mg to m.GlobalVars, recording its index under its
// name unless an earlier entry has the same name (a lookup finds the first).
func RegisterModuleGlobalVar(m @Module, mg irsym.ModuleGlobal) {
	if m.GlobalVarsVec == nil || !same(m.GlobalVars, m.GlobalVarsVec.Items()) {
		// GlobalVars was replaced, or the builder never made: it restarts from it.
		m.GlobalVarsVec = vec.New[irsym.ModuleGlobal]()
		for i := 0; i < len(m.GlobalVars); i++ {
			m.GlobalVarsVec.Push(m.GlobalVars[i])
		}
		m.GlobalVars = m.GlobalVarsVec.Items()
	}
	syncGlobalVarIndex(m)
	var idx int = m.GlobalVarsVec.Len()
	m.GlobalVarsVec.Push(mg)
	m.GlobalVars = m.GlobalVarsVec.Items()
	_, _ = m.GlobalVarIndex.GetOrPut(mg.Name, idx)
	m.GlobalVarIndexFor = m.GlobalVars
}

// GlobalVarIndexLookup returns the index in m.GlobalVars of the first entry named
// name, or -1.  It never replaces m.GlobalVars, so a write through m.GlobalVars
// indexed by its result lands in the list it indexes.
func GlobalVarIndexLookup(m @Module, name *[]readonly char) int {
	syncGlobalVarIndex(m)
	var idx int
	var ok bool
	idx, ok = m.GlobalVarIndex.Get(name)
	if ok {
		return idx
	}
	return -1
}

// DropGlobalVarIndex drops m's index of GlobalVars (see ir.bni).
func DropGlobalVarIndex(m @Module) {
	var none @table.Table[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq]
	m.GlobalVarIndex = none
}

// syncGlobalVarIndex rebuilds m.GlobalVarIndex over m.GlobalVars unless it was built
// over this very list (GlobalVarIndexFor).
func syncGlobalVarIndex(m @Module) {
	if m.GlobalVarIndex != nil && same(m.GlobalVarIndexFor, m.GlobalVars) {
		return
	}
	m.GlobalVarIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(m.GlobalVars); i++ {
		_, _ = m.GlobalVarIndex.GetOrPut(m.GlobalVars[i].Name, i)
	}
	m.GlobalVarIndexFor = m.GlobalVars
}
