package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/builtins/testing"

// Tests for RegisterModuleGlobalVar / GlobalVarIndexLookup / DropGlobalVarIndex:
// Module.GlobalVars grows through its vec builder, a name is found through the index,
// and both stay right when a writer truncates GlobalVars or renames an entry in place.

// namedGlobalVar returns a module global entry named name.
func namedGlobalVar(name *[]readonly char) irsym.ModuleGlobal {
	var mg irsym.ModuleGlobal
	mg.Name = buf.CopyStr(name)
	return mg
}

// Registered entries are the list, in order, and each name finds its first entry; a
// truncation (the REPL's rollback) drops a name and keeps the rest; a renamed entry,
// its index dropped, is found under its new name and not its old.
func TestGlobalVarIndex() testing.TestResult {
	var m @Module = NewModule("m")
	if GlobalVarIndexLookup(m, "a") != -1 { return fail("a fresh module finds nothing") }
	RegisterModuleGlobalVar(m, namedGlobalVar("a"))
	RegisterModuleGlobalVar(m, namedGlobalVar("b"))
	RegisterModuleGlobalVar(m, namedGlobalVar("a"))
	if len(m.GlobalVars) != 3 { return fail("three entries") }
	if GlobalVarIndexLookup(m, "a") != 0 || GlobalVarIndexLookup(m, "b") != 1 {
		return fail("each name finds its first entry")
	}
	m.GlobalVars = m.GlobalVars[:1]
	if GlobalVarIndexLookup(m, "b") != -1 || GlobalVarIndexLookup(m, "a") != 0 {
		return fail("a truncation drops b and keeps a")
	}
	RegisterModuleGlobalVar(m, namedGlobalVar("c"))
	if GlobalVarIndexLookup(m, "c") != 1 || len(m.GlobalVars) != 2 {
		return fail("a name registered after the truncation finds its new index")
	}
	m.GlobalVars[0].Name = buf.CopyStr("a#1")
	DropGlobalVarIndex(m)
	if GlobalVarIndexLookup(m, "a") != -1 || GlobalVarIndexLookup(m, "a#1") != 0 {
		return fail("a renamed entry is found under its new name")
	}
	return ""
}
