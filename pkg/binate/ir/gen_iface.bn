package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// IR-gen use-site helpers for interface values: resolving `*X` / `@X`
// type expressions to interface-value types, and lifting `*T` / `@T`
// source values into `*Iface` / `@Iface` interface values (boxing). The
// interface-method dispatch path (`iv.method(args)`) lives in
// gen_iface_dispatch.bn; the module-build-time interface registry and
// impl-collection live in gen_impl.bn.

// instantiatedIfaceLookupPkg resolves the DEFINING package for a generic-
// interface-decl lookup keyed by an instantiated head `base` (`Container[int]`).
// A pkg-qualified head (`pkg.Container[int]`) resolves its alias to the full
// path; a BARE head defaults to the enclosing import alias when one is active
// and to the current package otherwise.  The alias fallback is load-bearing for
// cross-package interface VALUES: an imported `.bni` signature
// (`func Make() @Holder[int]`) is written in the DEFINING package's own file, so
// its bare `Holder[int]` head names THAT package's generic, not the consumer's —
// without the fallback the lookup misses and `@Holder[int]` degrades to a plain
// managed pointer (a 1-word `i8*` instead of the 2-word interface value), which
// then extractvalue-crashes at the dispatch site.  Mirrors the generic-struct
// resolver in gen_type_resolve.bn.
func instantiatedIfaceLookupPkg(gc @GenCtx, base @ast.TypeExpr) @[]char {
	if len(base.Pkg) > 0 {
		// homedQualifier, not resolveImportPkg: a generic interface reached
		// through an `expose` forwarder (`fwd.Holder[int]`) has its decl
		// registered under the HOME package; keying (and thus the instance's
		// identity/mangling) on the home keeps `fwd.Holder[int]` == the home
		// spelling.  Byte-identical for a non-exposed reference.
		return homedQualifier(gc.Mod, base.Pkg, base.Name)
	}
	if len(gc.Mod.CurrentImportAlias) > 0 {
		return gc.Mod.CurrentImportAlias
	}
	return gc.PkgPath
}

// isInterfaceTypeExpr reports whether te is a TEXPR_NAMED naming a
// declared interface visible to this module. Used by
// resolveTypeExpr's `*X` / `@X` arms to choose between regular
// pointer and interface-value lowering. Bare references look up by
// (gc.PkgPath, name); qualified references (Slice 2.7)
// look up by (te.Pkg, te.Name) — the imported package's interfaces
// are registered into the module's interface registry by RegisterImport.
func isInterfaceTypeExpr(gc @GenCtx, te @ast.TypeExpr) bool {
	if te == nil { return false }
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// Slice 6c-full: `Container[int]` is an interface iff the
		// head names a generic interface decl visible to this
		// module — bare-name (current pkg) or pkg-qualified
		// (`pkg.Container[int]`, Slice 7c).
		if te.Base == nil { return false }
		if te.Base.Kind != ast.TEXPR_NAMED { return false }
		return lookupGenericIfaceDeclPkg(gc, instantiatedIfaceLookupPkg(gc, te.Base), te.Base.Name) != nil
	}
	if te.Kind != ast.TEXPR_NAMED { return false }
	// Plan §6: universe `any` is the implicit universal interface,
	// registered with Pkg="" by registerUniverseAny.  Bare references
	// (te.Pkg empty) should resolve there before we fall back to
	// gc.PkgPath, otherwise a same-named local interface
	// in the current package would shadow it (no such interface
	// exists today, but the lookup order should still be principled).
	if len(te.Pkg) == 0 {
		var emptyPkg @[]char
		if lookupModuleInterfaceIndex(gc.Mod, emptyPkg, te.Name) >= 0 {
			return true
		}
		if lookupModuleInterfaceIndex(gc.Mod, gc.PkgPath, te.Name) >= 0 {
			return true
		}
		// While an imported / being-collected package's decls are
		// processed, a bare interface name belongs to THAT package, not
		// the consumer's gc.PkgPath.  CurrentImportAlias names
		// it — set by registerImportFieldsAndFuncs (for an imported
		// `.bni`'s `func New(...) @Error`) and by collectInterfaceFromDecl
		// (so a self-referential `Unwrap() @Error` resolves in the
		// cross-package RegisterAllInterfaces pre-pass, where
		// gc.PkgPath is not yet the interface's own package).
		// Without this the name misses the registry and `@Error` degrades
		// to a managed pointer — an ABI mismatch at the call/dispatch site.
		if len(gc.Mod.CurrentImportAlias) > 0 {
			return lookupModuleInterfaceIndex(gc.Mod, gc.Mod.CurrentImportAlias, te.Name) >= 0
		}
		return false
	}
	// homedQualifier, not resolveImportPkg: an interface reached through an
	// `expose` forwarder (`*fwd.Valuer`) is registered only under its HOME
	// package, so key on the home (byte-identical for a non-exposed reference).
	return lookupModuleInterfaceIndex(gc.Mod, homedQualifier(gc.Mod, te.Pkg, te.Name), te.Name) >= 0
}

// ifaceTypeForName builds a placeholder TYP_INTERFACE Type for the
// named interface, with no method-set populated (IR-gen doesn't
// need method signatures yet — only the kind-and-name surface for
// downstream type identity / comparison). The full types.Type
// graph for cross-module method-set lookup belongs to the type
// checker; this helper exists only to give resolveTypeExpr a
// well-shaped Elem for *Iface / @Iface forms.
//
// Slice 2.7 sets Pkg so cross-package iface refs preserve their
// canonical (Pkg, Name) identity through IR-gen lookups. Bare refs
// default to gc.PkgPath (the module being generated).
func ifaceTypeForName(gc @GenCtx, te @ast.TypeExpr) @types.Type {
	if te == nil { return nil }
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// Slice 6c-full / Slice 7c: instantiate the named generic
		// iface (current-pkg or imported via pkg.Container[int])
		// and reference it under its mangled name
		// (`<pkg>.Container__bn_inst__int`).  Mangled-name pkg uses
		// the generic's DEFINING package (lookupPkg) so a cross-package
		// library-side impl resolves: the library TU keys its vtable
		// under the same defining package, and the consumer's reference
		// here matches it.  weak_odr vtables are single-owner (emitted
		// only by the defining package's TU), so there is no cross-
		// consumer link conflict.  For a same-package instantiation
		// lookupPkg == gc.PkgPath, so the keying is unchanged.
		if te.Base == nil { return nil }
		// The decl LOOKUP keys on the raw alias/path (matching however the
		// GenericIfaceDecls registry stashed it — short in the imported-.bni
		// pass, full via RegisterGenericDecls), but the interface IDENTITY
		// (mi.Pkg + the produced type's Pkg) must be the canonical FULL path so
		// it agrees with the impl/vtable side (which keys on resolveImportPkg's
		// full path) — otherwise a bare-head site would stamp Pkg="gen" while
		// the qualified use-site stamps "pkg/gen", a split that only survives
		// today because dispatch canonicalizes but Identical does not.
		var lookupPkg @[]char = instantiatedIfaceLookupPkg(gc, te.Base)
		var d @ast.Decl = lookupGenericIfaceDeclPkg(gc, lookupPkg, te.Base.Name)
		if d == nil { return nil }
		var canonPkg @[]char = resolveImportPkg(gc.Mod, lookupPkg)
		var argTypes @[]@types.Type
		for i := 0; i < len(te.TypeArgs); i++ {
			argTypes = slices.Append[@types.Type](argTypes, resolveTypeExpr(gc, te.TypeArgs[i]))
		}
		var instName @[]char = ensureInstantiatedInterface(gc, d, argTypes, canonPkg)
		return types.MakeInterfaceType(
				buf.CopyStr(canonPkg), instName)
	}
	// Plan §6: same universe-`any` fallback as isInterfaceTypeExpr.
	// If the bare name resolves to a universe entry (Pkg=""), keep
	// the empty Pkg on the produced TYP_INTERFACE so downstream
	// canonical-identity comparisons across modules agree.
	if len(te.Pkg) == 0 {
		var emptyPkg @[]char
		if lookupModuleInterfaceIndex(gc.Mod, emptyPkg, te.Name) >= 0 {
			return types.MakeInterfaceType(emptyPkg, buf.CopyStr(te.Name))
		}
		if lookupModuleInterfaceIndex(gc.Mod, gc.PkgPath, te.Name) >= 0 {
			return types.MakeInterfaceType(
					buf.CopyStr(gc.PkgPath), buf.CopyStr(te.Name))
		}
		// Same active-package fallback as isInterfaceTypeExpr: a bare
		// name during import / interface collection resolves under
		// CurrentImportAlias.  Key the produced interface type on the
		// RESOLVED full path so its identity matches the full-path-keyed
		// registry.
		if len(gc.Mod.CurrentImportAlias) > 0 &&
				lookupModuleInterfaceIndex(gc.Mod, gc.Mod.CurrentImportAlias, te.Name) >= 0 {
			return types.MakeInterfaceType(
					resolveImportPkg(gc.Mod, gc.Mod.CurrentImportAlias), buf.CopyStr(te.Name))
		}
		return types.MakeInterfaceType(
				buf.CopyStr(gc.PkgPath), buf.CopyStr(te.Name))
	}
	// Resolve the package qualifier to its full path (via the HOME package for
	// an `expose`d interface — byte-identical for a non-exposed reference) so
	// the interface type's identity matches the full-path-keyed registry
	// (ParentPkgs, impl IfacePkg) — IfaceParentSlotOffset and the upcast
	// lowering compare against it.  Full-path mangling — see pkg/binate/mangle.
	return types.MakeInterfaceType(homedQualifier(gc.Mod, te.Pkg, te.Name), buf.CopyStr(te.Name))
}

// wrapAsIfaceValue is the IR-gen helper that lifts a `*T` / `@T`
// source value into a `*Iface` interface value. Looks up the
// matching impl by (source's named type, interface's name) and
// emits OP_IFACE_VALUE pointing at its vtable. Returns nil if no
// matching impl is found in this module — caller falls through to
// the unwrapped value (the type-checker would have errored, but
// IR-gen stays defensive). Slice 2.3a-2 of plan-interface-syntax-
// revision.md.
//
// srcExprTyp is the UN-STRIPPED checker type of the boxed source expression
// (the caller's `Checker.ExprType(expr.ResolvedTypeID)`), or nil.  It matters
// only for a name-less box
// into `*any`: IR instruction types have `readonly` peeled (stripConstForIR,
// ir.bn:164), but the structural identity of a name-less dynamic type MUST keep
// element-`readonly` — else `*[]readonly char` and `*[]char` share one identity
// and a `case *[]char:` would recover a readonly slice as MUTABLE
// (plan-slice-type-identity.md §10).  When present it supplies the readonly-
// bearing element type for that identity; nil falls back to the stripped
// `val.Typ` (fine for every non-readonly source).
func wrapAsIfaceValue(ctx @GenContext, b @Block, val @Instr, dstTyp @types.Type,
		srcExprTyp @types.Type) @Instr {
	if val == nil || dstTyp == nil { return nil }
	if dstTyp.Kind != types.TYP_INTERFACE_VALUE && dstTyp.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return nil
	}
	if ctx.Gc.Mod == nil { return nil }
	if val.Typ == nil { return nil }
	// Source must be pointer-shaped — interface values borrow (or
	// own, for the managed variant) a pointer in their data slot.
	// A value-typed source (e.g. a loaded struct) would bitcast to
	// i8* nonsensically; leave them to a clear type-checker error
	// rather than producing undef LLVM IR.
	if val.Typ.Kind != types.TYP_POINTER && val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	// @Iface (managed): only @T sources are admitted (type-checker
	// rejects *T → @Iface; defensive guard here).
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED && val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	var iface @types.Type = dstTyp.Elem
	if iface == nil { return nil }
	// boxedElem is the boxed dynamic type (val.Typ is *T/@T; .Elem is T), used
	// below as the (T, any) record's recvTyp.  For a name-less box it is upgraded
	// to the UN-STRIPPED element (readonly-bearing) so the record's structural
	// identity AND its name reflect element-`readonly`.
	var boxedElem @types.Type = val.Typ.Elem
	var srcName @[]char = receiverBaseTypeName(val.Typ)
	// A managed `@any` that OWNS a managed POINTEE — the pointee of its data
	// pointer (boxedElem) is itself a managed slice (`@(@[]T)`, §9) or a managed
	// pointer (`@(@T)`) — keys on that pointee's STRUCTURAL identity and drops it
	// through the pointee's own `__dtor_ms` / `__dtor_mp`, NOT through
	// receiverBaseTypeName's fully-peeled leaf.  A NOMINAL leaf (`@(@Node)`) would
	// otherwise peel both `@`s to "Node", which (a) collides with a plain `@Node`
	// box's (recvPkg,"Node",any) row and (b) selects Node's STRUCT dtor — cleaning a
	// Node at the cell address and leaking the `@Node`.  So take the structural path
	// whenever the pointee is managed, even for a nominal leaf.  Peel a named-
	// distinct / readonly / alias wrapper (`type H @Node`, `type S @[]int`,
	// `readonly @[]int`) to the underlying managed kind first: a wrapped pointee is
	// structurally the same managed ptr / slice and must take the SAME owning path,
	// else it falls to the nominal branch with a null / mis-selected slot-0 dtor and
	// LEAKS the pointee by one per box.  An array-of-managed pointee (`@([N]@Node)`)
	// is owning the same way — its slot-0 dtor is the array dtor (`__dtor_arr<N>_...`).
	var peeledElem @types.Type = peelTransparent(boxedElem)
	var mgdManagedPointee bool = dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED &&
			isUniverseAny(iface) && peeledElem != nil &&
			(peeledElem.Kind == types.TYP_MANAGED_SLICE || peeledElem.Kind == types.TYP_MANAGED_PTR ||
					peeledElem.Kind == types.TYP_MANAGED_FUNC_VALUE ||
					peeledElem.Kind == types.TYP_INTERFACE_VALUE_MANAGED ||
					(peeledElem.Kind == types.TYP_ARRAY && peeledElem.Elem != nil &&
							peeledElem.Elem.NeedsDestruction()))
	if len(srcName) == 0 || mgdManagedPointee {
		// A pointer to a name-less type (a slice / array / func-value pointee)
		// has no nominal identity for the (T, any) box row, but boxing it into a
		// RAW `*any` must still produce a well-formed 2-word iface value {data,
		// vtable} — otherwise a later type-compare loads `vtable[1]` off a
		// garbage word and segfaults instead of missing cleanly (the slice-box
		// crash; plan-slice-type-identity.md §2).  Route it through the
		// universe-`any` synthesis below under a reserved STRUCTURAL identity
		// (namelessAnySrcName) so each distinct spelling gets its own real,
		// weak-coalesced `__ivt` / `__typeinfo`.
		// A RAW iface BORROWS, so its any-block slot-0 dtor is never called (stays
		// null).  A managed `@any` OWNS its data and drops it through slot 0:
		//   - a managed SLICE / PTR pointee has a real owning dtor
		//     (`__dtor_ms_<elem>` / `__dtor_mp_<T>`, RefDec the backing / pointee) to
		//     place in slot 0 (plan-slice-type-identity.md §9 for the slice case);
		//   - a name-less BORROWING pointee (a raw slice, `@(*[]T)`) owns only the
		//     cell — freed by the any-drop's RefDec — so a null slot 0 is correct;
		//   - an array-of-managed pointee (`@([N]@Node)`) drops via the array dtor
		//     (`__dtor_arr<N>_<elem>`, iterate + RefDec each element);
		//   - a name-less pointee that needs destruction but is none of the above (a
		//     managed func-value / anonymous managed struct pointee) still bails;
		//     deferred (FU4 Part B).
		var rawNamelessBox bool = dstTyp.Kind == types.TYP_INTERFACE_VALUE &&
				isBoxableNamelessType(val.Typ)
		var mgdOwning bool = mgdManagedPointee
		var mgdBorrow bool = dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED && len(srcName) == 0 &&
				boxedElem != nil && !boxedElem.NeedsDestruction()
		if isUniverseAny(iface) && (rawNamelessBox || mgdOwning || mgdBorrow) {
			// Key BOTH the identity and the record on a CANONICAL element type that
			// carries element-`readonly` AND fully-qualified named leaves — the two
			// things a slice-assertion match must agree with (a `case @[]T:` target
			// keys on resolveTypeExpr's type, which has both).  Neither of the two
			// available element types alone is complete:
			//   - val.Typ.Elem (the IR type): fully-QUALIFIED named leaves, but the
			//     IR strips `readonly` (stripConstForIR, ir.bn:164).
			//   - srcExprTyp.Elem (the checker type, Chunk 2a): preserves `readonly`,
			//     but leaves named leaves UNqualified / package-dropped.
			// mergeQualifiedReadonly re-inserts the checker type's `readonly` wrappers
			// onto the IR type's qualified structure, so `@[]readonly char` keeps its
			// `r` tag AND `@[]Point` / `@[]time.Point` get the qualified, non-colliding
			// name the match side expects (plan-slice-type-identity.md §10).
			//
			// FAIL LOUD if the caller supplied no un-stripped type: silently using the
			// stripped IR type would drop `readonly` and open the write-through-readonly
			// hole.  Unreachable for a real compiled box (the checker always stamps a
			// resolved type on the box source, so srcExprTyp is a pointer with a
			// non-nil pointee) — so this is a compiler-bug guard, never a production path.
			if srcExprTyp == nil || srcExprTyp.Elem == nil {
				panic(
						"internal error: a name-less type boxed into `*any` reached "
								"wrapAsIfaceValue with no un-stripped source type -- element "
								"`readonly` would be dropped from the box's structural "
								"identity, which a slice-assertion HIT could then recover as "
								"mutable (compiler bug: the box source expression has no "
								"resolved checker type) -- see plan-slice-type-identity.md "
								"§10 and gen_iface.bn")
			}
			boxedElem = mergeQualifiedReadonly(val.Typ.Elem, srcExprTyp.Elem)
			srcName = namelessAnySrcName(boxedElem)
			// Emit the pointee's real owning dtor so ensureAnyImplInfo's slot-0
			// reference (dtorNameForType) resolves to a body -- else a managed `@any`
			// box finds a null slot 0 and leaks the pointee.  A raw `*any` box and a
			// borrowing pointee (raw slice) drop no data, so they need no body (slot 0
			// stays null).  Register the PEELED managed kind, not the wrapper:
			// genManagedSliceDtor/genManagedPtrDtor read `.Elem` directly, and a
			// TYP_READONLY wrapper's `.Elem` is the underlying managed slice/ptr (not
			// its element), so registering the wrapper would emit a second,
			// element-iterating body under the same readonly-collapsed dtor name -- a
			// duplicate-symbol link failure.  (A named-distinct slice/ptr carries a
			// usable `.Elem`, so only the readonly wrapper actually miscompiles, but
			// peeling is correct for all wrappers.)
			if mgdOwning {
				var regTyp @types.Type = peelTransparent(boxedElem)
				if regTyp.Kind == types.TYP_MANAGED_SLICE {
					registerPendingMsDtor(ctx.Func, regTyp)
				} else if regTyp.Kind == types.TYP_MANAGED_PTR {
					registerPendingMpDtor(ctx.Func, regTyp)
				} else if regTyp.Kind == types.TYP_MANAGED_FUNC_VALUE {
					// func-value pointee (`@(@func())`): the single `__dtor_func` body.
					registerPendingFuncValueDtor(ctx.Func)
				} else if regTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
					// iface-value pointee (`@(@I)`): the single `__dtor_interface` body.
					registerPendingIfaceValueDtor(ctx.Func)
				} else {
					// array-of-managed pointee (`@([N]@Node)`): the struct-dtor work-list
					// drain routes an array type through ensureArrayDtor / genArrayDtor.
					registerPendingStructDtor(ctx.Func, regTyp)
				}
			}
		} else if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED && isUniverseAny(iface) &&
				boxedElem != nil && boxedElem.NeedsDestruction() {
			// A managed `@any` box of a name-less pointee that NEEDS destruction but is
			// none of the owning kinds above (an ANONYMOUS managed struct pointee) has no
			// owning slot-0 dtor wired yet: admitting it with a null slot 0 would leak,
			// and bailing to `return nil` makes the caller extractvalue an i8* -> invalid
			// LLVM.  Fail loud rather than emit a leaking or invalid interface value.  (A
			// NAMED struct pointee takes the nominal path with its own struct dtor and
			// never reaches here.)
			panic(
					"internal error: boxing a managed pointer to an anonymous managed "
							"struct into `@any` is not yet supported -- its owning slot-0 "
							"dtor is unwired; the compiler declines rather than emit a "
							"leaking or invalid interface value -- see gen_iface.bn")
		} else {
			return nil
		}
	}
	// If the source is a generic instantiation, emit its methods now (no-op
	// otherwise) so the vtable's MethodFuncs (synthesized just below) resolve to
	// emitted bodies rather than dangling symbols.
	ensureMethodsForInstName(ctx.Gc, srcName)
	// Slice 2.8: split qualified receiver names (`hello.Hello`)
	// into (pkg="hello", name="Hello") so the lookup against the
	// importing module's m.ImportedImpls (where RecvPkg / RecvTypeName
	// are stored as separate canonical components) matches. For
	// same-package receivers srcName is bare and recvPkg defaults to
	// gc.PkgPath. iface.Pkg / iface.Name come from the
	// destination iface Type (Slice 2.7).
	var recvPkg @[]char
	var recvName @[]char
	recvPkg, recvName = splitQualName(srcName)
	if len(recvPkg) == 0 {
		recvPkg = buf.CopyStr(ctx.Gc.PkgPath)
	}
	var vtable @[]char = findImplVtableName(ctx.Gc.Mod, recvPkg, recvName, iface.Pkg, iface.Name)
	if len(vtable) == 0 {
		// Plan §6: universe `any` has no user-written `impl T : any`.
		// Synthesize one on demand the first time a (T, any) pair
		// shows up at a construction site — the dtor comes from T,
		// the method set is empty.  After this, findImplVtableName
		// resolves the canonical mangled name, the normal vtable-
		// emission path in pkg/binate/codegen/emit_impls.bn produces
		// `__ivt.bn_V...` as a `[2 x i8*]` global (the two-word
		// any-block: T's dtor in slot 0, T's *TypeInfo in slot 1),
		// and OP_IFACE_VALUE lowering bitcasts it into the iv as usual.
		if isUniverseAny(iface) {
			// boxedElem is the boxed dynamic type (val.Typ.Elem, upgraded to the
			// un-stripped readonly-bearing element for a name-less box) — the
			// recvTyp for this any-boxed type's TypeInfo.
			ensureAnyImplInfo(ctx.Gc.Mod, recvPkg, recvName, boxedElem)
			vtable = findImplVtableName(ctx.Gc.Mod, recvPkg, recvName, iface.Pkg, iface.Name)
		} else if nameIsGenericInst(recvName) {
			// A monomorphized generic receiver (`@Box[int]`) boxing into an
			// interface value: the parameterized impl (`impl @Box[T] : Getter[T]`)
			// left no static vtable row (its receiver name is empty pre-
			// instantiation), so synthesize the concrete (recv-inst, iface) row
			// on demand — the checker already verified the impl.
			ensureGenericImplInfo(ctx.Gc.Mod, recvPkg, recvName, iface.Pkg, iface.Name, val.Typ.Elem)
			vtable = findImplVtableName(ctx.Gc.Mod, recvPkg, recvName, iface.Pkg, iface.Name)
		}
		if len(vtable) == 0 { return nil }
	}
	// @Iface owns its data ref — RefInc the source pointer so the
	// iv's data slot has its own count; when the iv is dropped,
	// scope cleanup RefDecs it. Slice 2.3b of plan-interface-
	// syntax-revision.md.
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		b.EmitRefInc(val)
	}
	return b.EmitIfaceValue(val, vtable, dstTyp)
}
