package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// IR-gen use-site helpers for interface values: dispatch
// (`iv.method(args)`), `*X` / `@X` resolution to interface-value
// types, and lifting `*T` / `@T` source values into `*Iface` /
// `@Iface` interface values. The module-build-time interface
// registry and impl-collection live in gen_impl.bn; this file
// contains the consumers IR-gen reaches for during expression
// generation.

// isInterfaceMethodCall reports whether sel.X resolves to an
// interface value at IR-gen time — peeks at the receiver
// expression's type via getSelectorType / lookupVarType without
// re-evaluating it. Used by genCall to route SELECTOR callees with
// interface-value receivers to the vtable-dispatch path. Slice
// 2.3a-3 of plan-interface-syntax-revision.md.
//
// Pointer-to-iv smoothing (plan-pointers-to-iface-values.md Slice
// P.3): a receiver of kind `**I` / `*@I` / `@(*I)` / `@(@I)` also
// routes here.  `genInterfaceMethodCall` emits the load to recover
// the iv before dispatching.  The type-checker accepts the same
// shape via the smoothing rule in `tryMethodCall`.
func isInterfaceMethodCall(ctx @GenContext, sel @ast.Expr) bool {
	if sel == nil || sel.X == nil { return false }
	var recvTyp @types.Type = nil
	if sel.X.Kind == ast.EXPR_IDENT {
		recvTyp = lookupVarType(ctx, sel.X.Name)
	} else if sel.X.Kind == ast.EXPR_SELECTOR ||
		sel.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX ||
		sel.X.Kind == ast.EXPR_UNARY {
		recvTyp = getSelectorType(ctx, sel.X)
	}
	if recvTyp == nil { return false }
	if recvTyp.Kind == types.TYP_INTERFACE_VALUE ||
			recvTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return true
	}
	if (recvTyp.Kind == types.TYP_POINTER ||
			recvTyp.Kind == types.TYP_MANAGED_PTR) &&
			recvTyp.Elem != nil &&
			(recvTyp.Elem.Kind == types.TYP_INTERFACE_VALUE ||
			 recvTyp.Elem.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		return true
	}
	return false
}

// genInterfaceMethodCall lowers `iv.method(args)` where iv is a
// TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED to an
// OP_CALL_IFACE_METHOD instruction. Looks up the method's slot
// index + return type via the per-module interface registry.
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
//
// Pointer-to-iv smoothing (Slice P.3): when sel.X produces a
// pointer-to-iv value, emit the load to recover the iv before
// dispatch.  The type-checker's smoothing rule guarantees this
// only fires when the user wrote `p.M()` for a pointer-to-iv `p`.
func genInterfaceMethodCall(ctx @GenContext, b @Block,
		e @ast.Expr) @Instr {
	var sel @ast.Expr = e.X
	var iv @Instr = genExpr(ctx, b, sel.X)
	b = ctx.CurBlock
	if iv != nil && iv.Typ != nil &&
			(iv.Typ.Kind == types.TYP_POINTER ||
			 iv.Typ.Kind == types.TYP_MANAGED_PTR) &&
			iv.Typ.Elem != nil &&
			(iv.Typ.Elem.Kind == types.TYP_INTERFACE_VALUE ||
			 iv.Typ.Elem.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		iv = b.EmitLoad(iv, iv.Typ.Elem)
	}
	if iv == nil || iv.Typ == nil ||
		iv.Typ.Elem == nil {
		return b.EmitConstInt(0, types.TypInt())
	}
	var ifacePkg @[]char = iv.Typ.Elem.Pkg
	var ifaceName @[]char = iv.Typ.Elem.Name
	var idx int
	var resultTyp @types.Type
	idx, resultTyp = findInterfaceMethod(ifacePkg, ifaceName, sel.Name)
	if idx < 0 {
		return b.EmitConstInt(0, types.TypInt())
	}
	if resultTyp == nil { resultTyp = types.TypVoid() }
	var args @[]@Instr
	for i := 0; i < len(e.Args); i++ {
		var arg @Instr = genExpr(ctx, b, e.Args[i])
		b = ctx.CurBlock
		args = slices.Append[@Instr](args, arg)
	}
	return b.EmitCallIfaceMethod(iv, args, idx,
		resultTyp)
}

// findInterfaceMethod returns the (absolute vtable slot, return
// type) of the named method on (ifacePkg, ifaceName), or (-1, nil)
// if not found.  The slot is 0-based into the canonical (R, I)
// vtable layout: slot 0 = dtor (any-block), slots 1.. populated by
// the concat layout (each parent's full vtable inlined, then own
// methods).  For a non-extended interface, slot = j + 1 where j is
// the method's 0-based position in MethodNames — exactly what the
// pre-E.4 callers assumed once you account for the dtor at slot 0.
// For an extended interface, the slot may land inside a nested
// parent sub-vtable; the recursive walk computes that statically.
//
// plan-interface-embedding.md Slice E.4.  Follows alias chains
// (Slice 2.4); cross-package lookups (Slice 2.7) require ifacePkg
// to be the canonical package.
func findInterfaceMethod(ifacePkg *[]readonly char,
		ifaceName *[]readonly char,
		methodName *[]readonly char) (int, @types.Type) {
	// Bootstrap rejects `return f(...)` for a multi-return outer
	// (see bootstrap-subset.md); destructure explicitly.
	var slot int
	var rt @types.Type
	slot, rt = findInterfaceMethodFromBase(ifacePkg, ifaceName,
		methodName, 0)
	return slot, rt
}

// findInterfaceMethodFromBase walks the recursive vtable structure
// of (ifacePkg, ifaceName), treating `base` as the offset where
// this interface's full vtable starts.  Returns the absolute slot
// index (in the outermost vtable) of the matching method, plus
// the method's declared return type.
func findInterfaceMethodFromBase(ifacePkg *[]readonly char,
		ifaceName *[]readonly char,
		methodName *[]readonly char,
		base int) (int, @types.Type) {
	var idx int = resolveModuleInterface(ifacePkg, ifaceName)
	if idx < 0 { return -1, nil }
	var mi ModuleInterface = moduleInterfaces[idx]
	// Slot `base` is this interface's any-block (dtor).  Parent
	// sub-vtables follow, then own methods.
	var cursor int = base + 1
	for i := 0; i < len(mi.ParentPkgs); i++ {
		var pSlot int
		var pRT @types.Type
		pSlot, pRT = findInterfaceMethodFromBase(mi.ParentPkgs[i],
			mi.ParentNames[i], methodName, cursor)
		if pSlot >= 0 { return pSlot, pRT }
		cursor = cursor + IfaceFullVtableSize(mi.ParentPkgs[i],
			mi.ParentNames[i])
	}
	for j := 0; j < len(mi.MethodNames); j++ {
		if charEq(mi.MethodNames[j], methodName) {
			var rt @types.Type = nil
			if j < len(mi.MethodResults) {
				rt = mi.MethodResults[j]
			}
			return cursor + j, rt
		}
	}
	return -1, nil
}

// isInterfaceTypeExpr reports whether te is a TEXPR_NAMED naming a
// declared interface visible to this module. Used by
// resolveTypeExpr's `*X` / `@X` arms to choose between regular
// pointer and interface-value lowering. Bare references look up by
// (currentModulePkgPath, name); qualified references (Slice 2.7)
// look up by (te.Pkg, te.Name) — the imported package's interfaces
// are registered into moduleInterfaces by RegisterImport.
func isInterfaceTypeExpr(te @ast.TypeExpr) bool {
	if te == nil { return false }
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// Slice 6c-full: `Container[int]` is an interface iff the
		// head names a generic interface decl visible to this
		// module — bare-name (current pkg) or pkg-qualified
		// (`pkg.Container[int]`, Slice 7c).
		if te.Base == nil { return false }
		if te.Base.Kind != ast.TEXPR_NAMED { return false }
		var lookupPkg @[]char
		if len(te.Base.Pkg) > 0 {
			lookupPkg = te.Base.Pkg
		} else {
			lookupPkg = currentModulePkgPath
		}
		return lookupGenericIfaceDeclPkg(lookupPkg,
			te.Base.Name) != nil
	}
	if te.Kind != ast.TEXPR_NAMED { return false }
	// Plan §6: universe `any` is the implicit universal interface,
	// registered with Pkg="" by registerUniverseAny.  Bare references
	// (te.Pkg empty) should resolve there before we fall back to
	// currentModulePkgPath, otherwise a same-named local interface
	// in the current package would shadow it (no such interface
	// exists today, but the lookup order should still be principled).
	if len(te.Pkg) == 0 {
		var emptyPkg @[]char
		if lookupModuleInterfaceIndex(emptyPkg, te.Name) >= 0 {
			return true
		}
		if lookupModuleInterfaceIndex(currentModulePkgPath,
				te.Name) >= 0 {
			return true
		}
		// While an imported / being-collected package's decls are
		// processed, a bare interface name belongs to THAT package, not
		// the consumer's currentModulePkgPath.  currentImportAlias names
		// it — set by registerImportFieldsAndFuncs (for an imported
		// `.bni`'s `func New(...) @Error`) and by collectInterfaceFromDecl
		// (so a self-referential `Unwrap() @Error` resolves in the
		// cross-package RegisterAllInterfaces pre-pass, where
		// currentModulePkgPath is not yet the interface's own package).
		// Without this the name misses the registry and `@Error` degrades
		// to a managed pointer — an ABI mismatch at the call/dispatch site.
		if len(currentImportAlias) > 0 {
			return lookupModuleInterfaceIndex(currentImportAlias,
				te.Name) >= 0
		}
		return false
	}
	return lookupModuleInterfaceIndex(te.Pkg, te.Name) >= 0
}

// ifaceTypeForName builds a placeholder TYP_INTERFACE Type for the
// named interface, with no method-set populated (IR-gen doesn't
// need method signatures yet — only the kind-and-name surface for
// downstream type identity / comparison). The full types.Type
// graph for cross-module method-set lookup belongs to the type
// checker; this helper exists only to give resolveTypeExpr a
// well-shaped Elem for *Iface / @Iface forms.
//
// Slice 2.7 sets Pkg so cross-package iface refs preserve their
// canonical (Pkg, Name) identity through IR-gen lookups. Bare refs
// default to currentModulePkgPath (the module being generated).
func ifaceTypeForName(te @ast.TypeExpr) @types.Type {
	if te == nil { return nil }
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// Slice 6c-full / Slice 7c: instantiate the named generic
		// iface (current-pkg or imported via pkg.Container[int])
		// and reference it under its mangled name
		// (`<pkg>.Container__bn_inst__int`).  Mangled-name pkg
		// uses currentModulePkgPath so the instantiated entry
		// lands in the consumer's namespace (no link conflict
		// across consumers).
		if te.Base == nil { return nil }
		var lookupPkg @[]char
		if len(te.Base.Pkg) > 0 {
			lookupPkg = te.Base.Pkg
		} else {
			lookupPkg = currentModulePkgPath
		}
		var d @ast.Decl = lookupGenericIfaceDeclPkg(lookupPkg,
			te.Base.Name)
		if d == nil { return nil }
		var argTypes @[]@types.Type
		for i := 0; i < len(te.TypeArgs); i++ {
			argTypes = slices.Append[@types.Type](argTypes,
				resolveTypeExpr(te.TypeArgs[i]))
		}
		var instName @[]char = ensureInstantiatedInterface(d,
			argTypes)
		return types.MakeInterfaceType(
			buf.CopyStr(currentModulePkgPath), instName)
	}
	// Plan §6: same universe-`any` fallback as isInterfaceTypeExpr.
	// If the bare name resolves to a universe entry (Pkg=""), keep
	// the empty Pkg on the produced TYP_INTERFACE so downstream
	// canonical-identity comparisons across modules agree.
	if len(te.Pkg) == 0 {
		var emptyPkg @[]char
		if lookupModuleInterfaceIndex(emptyPkg, te.Name) >= 0 {
			return types.MakeInterfaceType(emptyPkg,
				buf.CopyStr(te.Name))
		}
		if lookupModuleInterfaceIndex(currentModulePkgPath,
				te.Name) >= 0 {
			return types.MakeInterfaceType(
				buf.CopyStr(currentModulePkgPath),
				buf.CopyStr(te.Name))
		}
		// Same active-package fallback as isInterfaceTypeExpr: a bare
		// name during import / interface collection resolves under
		// currentImportAlias.  Key the produced interface type on the
		// RESOLVED full path so its identity matches the full-path-keyed
		// registry.
		if len(currentImportAlias) > 0 &&
				lookupModuleInterfaceIndex(currentImportAlias,
					te.Name) >= 0 {
			return types.MakeInterfaceType(
				resolveImportPkg(currentImportAlias),
				buf.CopyStr(te.Name))
		}
		return types.MakeInterfaceType(
			buf.CopyStr(currentModulePkgPath), buf.CopyStr(te.Name))
	}
	// Resolve the package qualifier to its full path so the
	// interface type's identity matches the full-path-keyed registry
	// (ParentPkgs, impl IfacePkg) — IfaceParentSlotOffset and the
	// upcast lowering compare against it.  Full-path mangling — see
	// pkg/binate/mangle.
	return types.MakeInterfaceType(resolveImportPkg(te.Pkg),
		buf.CopyStr(te.Name))
}

// wrapAsIfaceValue is the IR-gen helper that lifts a `*T` / `@T`
// source value into a `*Iface` interface value. Looks up the
// matching impl by (source's named type, interface's name) and
// emits OP_IFACE_VALUE pointing at its vtable. Returns nil if no
// matching impl is found in this module — caller falls through to
// the unwrapped value (the type-checker would have errored, but
// IR-gen stays defensive). Slice 2.3a-2 of plan-interface-syntax-
// revision.md.
func wrapAsIfaceValue(ctx @GenContext, b @Block, val @Instr,
		dstTyp @types.Type) @Instr {
	if val == nil || dstTyp == nil { return nil }
	if dstTyp.Kind != types.TYP_INTERFACE_VALUE &&
		dstTyp.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return nil
	}
	if currentModule == nil { return nil }
	if val.Typ == nil { return nil }
	// Source must be pointer-shaped — interface values borrow (or
	// own, for the managed variant) a pointer in their data slot.
	// A value-typed source (e.g. a loaded struct) would bitcast to
	// i8* nonsensically; leave them to a clear type-checker error
	// rather than producing undef LLVM IR.
	if val.Typ.Kind != types.TYP_POINTER &&
		val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	// @Iface (managed): only @T sources are admitted (type-checker
	// rejects *T → @Iface; defensive guard here).
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED &&
		val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	var iface @types.Type = dstTyp.Elem
	if iface == nil { return nil }
	var srcName @[]char = receiverBaseTypeName(val.Typ)
	if len(srcName) == 0 { return nil }
	// Slice 2.8: split qualified receiver names (`hello.Hello`)
	// into (pkg="hello", name="Hello") so the lookup against the
	// importing module's m.ImportedImpls (where RecvPkg / RecvTypeName
	// are stored as separate canonical components) matches. For
	// same-package receivers srcName is bare and recvPkg defaults to
	// currentModulePkgPath. iface.Pkg / iface.Name come from the
	// destination iface Type (Slice 2.7).
	var recvPkg @[]char
	var recvName @[]char
	recvPkg, recvName = splitQualName(srcName)
	if len(recvPkg) == 0 {
		recvPkg = buf.CopyStr(currentModulePkgPath)
	}
	var vtable @[]char = findImplVtableName(currentModule,
		recvPkg, recvName, iface.Pkg, iface.Name)
	if len(vtable) == 0 {
		// Plan §6: universe `any` has no user-written `impl T : any`.
		// Synthesize one on demand the first time a (T, any) pair
		// shows up at a construction site — the dtor comes from T,
		// the method set is empty.  After this, findImplVtableName
		// resolves the canonical mangled name, the normal vtable-
		// emission path in pkg/binate/codegen/emit_impls.bn produces
		// `__ivt.bn_<T_pkg>__<T>__any` as a `[1 x i8*]` global with
		// T's dtor in slot 0, and OP_IFACE_VALUE lowering bitcasts
		// it into the iv as usual.
		if isUniverseAny(iface) {
			ensureAnyImplInfo(currentModule, recvPkg, recvName)
			vtable = findImplVtableName(currentModule, recvPkg,
				recvName, iface.Pkg, iface.Name)
		}
		if len(vtable) == 0 { return nil }
	}
	// @Iface owns its data ref — RefInc the source pointer so the
	// iv's data slot has its own count; when the iv is dropped,
	// scope cleanup RefDecs it. Slice 2.3b of plan-interface-
	// syntax-revision.md.
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		b.EmitRefInc(val)
	}
	return b.EmitIfaceValue(val, vtable, dstTyp)
}

// isUniverseAny reports whether `iface` is the universe `any`
// interface (TYP_INTERFACE with Pkg="" and Name="any").  Used by
// wrapAsIfaceValue to recognize when to synthesize an ImplInfo on
// the fly (plan §6).
func isUniverseAny(iface @types.Type) bool {
	if iface == nil { return false }
	if iface.Kind != types.TYP_INTERFACE { return false }
	if len(iface.Pkg) != 0 { return false }
	return charEq(iface.Name, "any")
}

// ensureAnyImplInfo appends a (recvPkg.recvName, any) ImplInfo to
// m.Impls if no entry for that pair already exists.  The synthesized
// info carries the receiver's dtor in DtorFuncName (or empty if T
// has no dtor) and an empty MethodFuncs (since `any` has no methods).
// Codegen's vtable emitter then produces `__ivt.bn_<recvPkg>__-
// <recvName>__any` as `[1 x i8*]` with slot 0 = dtor or null.
func ensureAnyImplInfo(m @Module, recvPkg @[]char,
		recvName @[]char) {
	var emptyPkg @[]char
	var anyName @[]char = "any"
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		if !charEq(info.RecvPkg, recvPkg) { continue }
		if !charEq(info.RecvTypeName, recvName) { continue }
		if !charEq(info.IfacePkg, emptyPkg) { continue }
		if !charEq(info.IfaceName, anyName) { continue }
		return
	}
	var dtorName @[]char = implDtorFuncName(recvPkg, recvName)
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = buf.CopyStr(recvPkg)
	info.RecvTypeName = buf.CopyStr(recvName)
	info.IfacePkg = emptyPkg
	info.IfaceName = buf.CopyStr(anyName)
	info.DtorFuncName = dtorName
	m.Impls = slices.Append[@ImplInfo](m.Impls, info)
}

// splitQualName splits a possibly-qualified IR-gen identifier
// (`pkg.Name`) into its components. For unqualified inputs, returns
// empty pkg + the input as name. Used by wrapAsIfaceValue to
// recover the receiver's canonical (pkg, name) pair from
// IR-gen's qualified-form Type.Name (`hello.Hello`) so cross-
// package impl-table lookup matches. Slice 2.8.
func splitQualName(name *[]readonly char) (@[]char, @[]char) {
	var emptyPkg @[]char
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			var pkg @[]char = make_slice(char, i)
			for j := 0; j < i; j++ { pkg[j] = name[j] }
			var rest @[]char = make_slice(char, len(name) - i - 1)
			for j := 0; j < len(rest); j++ {
				rest[j] = name[i + 1 + j]
			}
			return pkg, rest
		}
	}
	return emptyPkg, buf.CopyStr(name)
}

// receiverBaseTypeName extracts the underlying named-type name
// from a pointer / managed-pointer / const-wrapped type expression
// resolved by IR-gen. Mirrors types.ReceiverBaseNamed but accepts
// IR-gen's representation where struct types may live as TYP_STRUCT
// directly (with Name populated) rather than wrapped in TYP_NAMED.
func receiverBaseTypeName(t @types.Type) @[]char {
	var empty @[]char
	if t == nil { return empty }
	if t.Kind == types.TYP_POINTER ||
		t.Kind == types.TYP_MANAGED_PTR ||
		t.Kind == types.TYP_READONLY {
		return receiverBaseTypeName(t.Elem)
	}
	if t.Kind == types.TYP_NAMED || t.Kind == types.TYP_STRUCT {
		return t.Name
	}
	// Universe primitives carry the stdlib carve-out
	// (`pkg/builtins/lang`) qualifier per plan-primitives-impl-
	// interfaces.md, so the downstream splitQualName / impl-
	// table lookup matches the (RecvPkg=std, RecvName=int)
	// form the impl was registered under.
	if isUniversePrimitive(t) && len(t.Name) > 0 {
		return primitiveQualifiedName(t.Name)
	}
	return empty
}
