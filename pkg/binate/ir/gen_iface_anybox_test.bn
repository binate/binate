package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the any-block support helpers in gen_iface_anybox.bn.  The pure name /
// identity helpers (splitQualName, receiverBaseTypeName, isUniverseAny) are pinned
// directly here; ensureAnyImplInfo's (T, any) row synthesis is exercised end-to-end
// by the any-box conformance tests (1077 / 1101 / 1109 ...).  fail lives in the
// package's other test files.

// splitQualName splits `pkg.Name` into its components and passes an unqualified
// name through with an empty package.
func TestSplitQualName() testing.TestResult {
	var pkg @[]char
	var name @[]char
	pkg, name = splitQualName("hello.Hello")
	if !streq(pkg, "hello") {
		return fail("splitQualName should split the package off `hello.Hello`")
	}
	if !streq(name, "Hello") {
		return fail("splitQualName should keep `Hello` as the bare name")
	}
	pkg, name = splitQualName("Plain")
	if len(pkg) != 0 {
		return fail("an unqualified name should have an empty package")
	}
	if !streq(name, "Plain") {
		return fail("an unqualified name should pass through unchanged")
	}
	return ""
}

// receiverBaseTypeName peels pointer / managed-pointer wrappers to the nominal
// leaf, and returns empty for a name-less (slice) leaf or nil.
func TestReceiverBaseTypeName() testing.TestResult {
	var noFields @[]@types.Field
	var node @types.Type = types.MakeStructType("Node", noFields)
	if !streq(receiverBaseTypeName(types.MakeManagedPtrType(node)), "Node") {
		return fail("receiverBaseTypeName should peel `@Node` to `Node`")
	}
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	if len(receiverBaseTypeName(types.MakeManagedPtrType(ms))) != 0 {
		return fail("a managed-slice pointee is name-less -> empty")
	}
	if len(receiverBaseTypeName(nil)) != 0 {
		return fail("nil -> empty")
	}
	return ""
}

// isUniverseAny recognizes only the universe `any` (Pkg="", Name="any").
func TestIsUniverseAny() testing.TestResult {
	var emptyPkg @[]char
	if !isUniverseAny(types.MakeInterfaceType(emptyPkg, "any")) {
		return fail("the universe any (Pkg empty, Name=any) should match")
	}
	if isUniverseAny(types.MakeInterfaceType("pkg", "Foo")) {
		return fail("a named user interface should not match")
	}
	if isUniverseAny(types.MakeInterfaceType(emptyPkg, "Foo")) {
		return fail("Pkg empty but Name != any should not match")
	}
	if isUniverseAny(nil) {
		return fail("nil should not match")
	}
	return ""
}
