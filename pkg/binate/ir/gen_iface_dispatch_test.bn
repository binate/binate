package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_iface_dispatch.bn — interface-method dispatch IR-gen:
// `iv.method(args)` lowering to OP_CALL_IFACE_METHOD, and
// findInterfaceMethod slot / result-type resolution (own, inherited, and
// multi-result methods). Helpers (genFromSourcePkg, findFunc, countOp,
// fail) live in ir_test.bn.

// Slice 2.3a-3 IR shape: `iv.foo()` lowers to OP_CALL_IFACE_METHOD
// with the iv as Args[0] and the slot index as Index. Without this
// op the dispatch would fall through to the regular method-call
// path, which doesn't know how to route through a vtable.
func TestGenImplDispatchEmitsCallIface() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\tiv.foo()\n"
		"}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, OP_CALL_IFACE_METHOD) < 1 {
		return fail("expected OP_CALL_IFACE_METHOD for iv.foo()")
	}
	return ""
}

// Multi-method interface: each method gets the correct absolute
// vtable slot — slot 0 is the dtor (any-block), methods start at
// slot 1.  plan-interface-embedding.md Slice E.4 made
// findInterfaceMethod return the absolute slot (post-dtor) so
// codegen / VM can drop their `+1` adjustments.
func TestGenImplDispatchSlotIndices() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface AB { a() int; b() int }\n"
		"type T struct { x int }\n"
		"func (t *T) a() int { return 1 }\n"
		"func (t *T) b() int { return 2 }\n"
		"impl *T : AB\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *AB = &t\n"
		"\tvar _ int = iv.a()\n"
		"\tvar _ int = iv.b()\n"
		"}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	var sawA bool = false
	var sawB bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op != OP_CALL_IFACE_METHOD { continue }
			if instr.Index == 1 { sawA = true }
			if instr.Index == 2 { sawB = true }
		}
	}
	if !sawA { return fail("expected dispatch with slot 1 (a)") }
	if !sawB { return fail("expected dispatch with slot 2 (b)") }
	return ""
}

// findInterfaceMethod returns absolute vtable slot indices for
// inherited methods.  For `interface RC : Closer { Read() int }`
// where `Closer { Close() }`, the RC vtable layout (Slice E.3
// concat) is:
//   slot 0 = dtor (RC's any-block)
//   slot 1 = dtor (Closer's nested any-block)
//   slot 2 = Close (Closer's own method)
//   slot 3 = Read  (RC's own method)
// plan-interface-embedding.md Slice E.4 part 1.
func TestFindInterfaceMethodInherited() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n")
	// IR-gen populates moduleInterfaces as a side effect.
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	// Closer's own method at slot 1 (post-dtor).
	var closerSlot int
	var rt @[]@types.Type
	closerSlot, rt, _ = findInterfaceMethod(m, "test", "Closer", "Close")
	if closerSlot != 1 {
		return fail("Closer.Close should be at slot 1")
	}
	// RC's inherited method lands at slot 2 of RC's vtable
	// (RC's any-block + Closer's nested any-block + Close).
	var inheritedSlot int
	inheritedSlot, rt, _ = findInterfaceMethod(m, "test", "RC", "Close")
	if inheritedSlot != 2 {
		return fail("RC.Close (inherited) should be at slot 2")
	}
	// RC's own method follows the inlined Closer vtable.
	var ownSlot int
	ownSlot, rt, _ = findInterfaceMethod(m, "test", "RC", "Read")
	if ownSlot != 3 {
		return fail("RC.Read (own) should be at slot 3")
	}
	// Unknown method returns -1.
	var missSlot int
	missSlot, rt, _ = findInterfaceMethod(m, "test", "RC", "nope")
	if missSlot != -1 {
		return fail("nonexistent method should return -1")
	}
	if len(rt) == 0 { return "" }  // rt always reassigned; pin it as used
	return ""
}

// findInterfaceMethod returns the FULL result-type list for a method, so a
// >=2-result interface method (`mr() (int, int)`) can dispatch as a tuple
// rather than the void the old single-result store produced (CR-2 Plan-1
// Defect 3 — the SEAM: MethodResultsFlat / MethodResultCounts).
func TestFindInterfaceMethodMultiResult() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Multi { mr() (int, int) }\n"
		"type Impl struct { n int }\n"
		"func (im *Impl) mr() (int, int) { return 1, 2 }\n"
		"impl *Impl : Multi\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	var slot int
	var results @[]@types.Type
	slot, results, _ = findInterfaceMethod(m, "test", "Multi", "mr")
	if slot < 0 { return fail("Multi.mr should be found") }
	if len(results) != 2 {
		return fail("expected 2 result types from Multi.mr (the SEAM)")
	}
	return ""
}
