package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_iface_extends.bn — extension-aware iface query
// helpers (IfaceParentPkgs / IfaceParentNames / IfaceFullVtableSize
// / IfaceAncestorClosure[Pkgs] / appendAncestors).

// IfaceFullVtableSize should add up the recursive structure: each
// nested interface contributes 2 (its two-word any-block: dtor +
// *TypeInfo) + sum(parent sizes) + len(own methods).  Diamond layouts
// (Closer reached from RC via two paths in a multi-extension chain)
// inflate the size by design — the parent's full vtable is inlined at
// each occurrence.
func TestIfaceFullVtableSize() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Closer { Close() }\n")
	cb.Write("interface Reader { Read() int }\n")
	cb.Write("interface RC : Closer, Reader { Bonus() }\n")
	// Run codegen for its side effect of populating
	// the module's Interfaces; the returned Module isn't inspected here.
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	// Closer: 2 (any-block) + 0 (no parents) + 1 (Close) = 3.
	if IfaceFullVtableSize(m, "test", "Closer") != 3 {
		return fail("Closer vtable size should be 3")
	}
	// Reader: same shape = 3.
	if IfaceFullVtableSize(m, "test", "Reader") != 3 {
		return fail("Reader vtable size should be 3")
	}
	// RC: 2 (any-block) + 3 (Closer) + 3 (Reader) + 1 (Bonus) = 9.
	if IfaceFullVtableSize(m, "test", "RC") != 9 {
		return fail("RC vtable size should be 9")
	}
	return ""
}

// IfaceParentSlotOffset is the lynchpin of OP_IFACE_UPCAST: it
// returns the absolute slot at which target's full vtable starts
// within src's concat-laid-out vtable, so `*Child → *Parent` is
// codegen'd as a +(offset*8) byte adjustment on the vtable
// pointer.  Both the LLVM backend (emit_iface_upcast.bn) and the
// native AArch64 backend (arm64_dispatch.bn) depend on the offset
// being correct — an off-by-one would dispatch the wrong slot.
// Diamond layout: RC : Closer, Reader { Bonus() } gives slots 0-1 =
// RC's any-block, slot 2 = Closer's any-block (offset 2), slot 5 =
// Reader's any-block (offset 2 + 3).
func TestIfaceParentSlotOffsetDiamond() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Closer { Close() }\n")
	cb.Write("interface Reader { Read() int }\n")
	cb.Write("interface RC : Closer, Reader { Bonus() }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	// RC → Closer: Closer's any-block starts at slot 2 (right after
	// RC's own two-word any-block at slots 0-1).
	if IfaceParentSlotOffset(m, "test", "RC", "test", "Closer") != 2 {
		return fail("RC → Closer should be slot 2")
	}
	// RC → Reader: 2 (RC's any-block) + 3 (Closer's full sub-vtable:
	// 2 any-block + 1 method) = slot 5.
	if IfaceParentSlotOffset(m, "test", "RC", "test", "Reader") != 5 {
		return fail("RC → Reader should be slot 5")
	}
	return ""
}

// IfaceParentSlotOffset returns -1 when target isn't a (transitive)
// parent of src (and isn't the same interface, which now resolves to 0).
// That is an INVALID upcast; the upcast lowerings (emit_iface_upcast.bn /
// {aarch64,x64}_dispatch.bn) now hard-assert offset >= 0 (panic) rather
// than feeding -1 to a vtable GEP, so a -1 here is a should-never-happen
// internal error the lowerings turn loud.
func TestIfaceParentSlotOffsetNotAParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A { Foo() }\n")
	cb.Write("interface B { Bar() }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	if IfaceParentSlotOffset(m, "test", "A", "test", "B") != -1 {
		return fail("A → B (unrelated) should be -1")
	}
	return ""
}

// IfaceParentSlotOffset returns 0 for the SAME canonical interface.  A
// managed<->raw decay (`@X -> *X`) routes through the upcast path because
// ifaceValueTypesAgree distinguishes managed vs raw on Kind, but X's
// vtable IS the target's — no slot adjustment.  Before the same-interface
// case was added this returned -1 (X is not its own parent), which the
// lowerings fed to a vtable GEP as a -1 index (silent corruption; now an
// assert).
func TestIfaceParentSlotOffsetSameInterfaceIsZero() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A { Foo() }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	if IfaceParentSlotOffset(m, "test", "A", "test", "A") != 0 {
		return fail("A → A (same interface) should be 0, not -1")
	}
	return ""
}

// Multi-level chain: GrandChild : Child, Child : Parent.  The
// recursive walk should find Parent at slot 4 of GrandChild
// (slots 0-1 = GrandChild's any-block, slots 2-3 = Child's any-block,
// slot 4 = Parent's any-block inlined inside Child's sub-vtable).
func TestIfaceParentSlotOffsetTransitive() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface Parent { P() }\n")
	cb.Write("interface Child : Parent { C() }\n")
	cb.Write("interface GrandChild : Child { G() }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if m == nil { return fail("genFromSourcePkg returned nil") }
	if IfaceParentSlotOffset(m, "test", "GrandChild", "test", "Child") != 2 {
		return fail("GrandChild → Child should be slot 2")
	}
	if IfaceParentSlotOffset(m, "test", "GrandChild", "test", "Parent") != 4 {
		return fail("GrandChild → Parent should be slot 4 (inside Child sub-block)")
	}
	if IfaceParentSlotOffset(m, "test", "Child", "test", "Parent") != 2 {
		return fail("Child → Parent should be slot 2")
	}
	return ""
}
