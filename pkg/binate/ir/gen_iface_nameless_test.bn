package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for namelessAnySrcName (gen_iface.bn): the reserved STRUCTURAL
// identity a name-less dynamic type gets when boxed into a raw `*any`.  Each
// distinct spelling must get a distinct `pkg/builtins/rt.__nameless_<lp>` name
// (so a later phase's slice-assertion HIT keys on the right record), while
// `char` ≡ `uint8` ≡ `byte` (one singleton) collapse to a single identity.

// The reserved, package-qualified prefix pins the record to a FIXED package
// (so it coalesces program-wide) and marks it compiler-reserved / un-spellable.
func TestNamelessAnySrcNameFormat() testing.TestResult {
	// @[]int  →  M (managed-slice) + N0_3_int (int leaf).
	var t @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !streq(namelessAnySrcName(t), "pkg/builtins/rt.__nameless_MN0_3_int") {
		return "@[]int should map to 'pkg/builtins/rt.__nameless_MN0_3_int'"
	}
	return ""
}

// Managed-vs-raw and element type are part of the identity — distinct spellings
// map to distinct names (the exact-match distinctness the feature requires).
func TestNamelessAnySrcNameDistinct() testing.TestResult {
	var mSliceInt @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypInt()))
	var rSliceInt @[]char = namelessAnySrcName(types.MakeSliceType(types.TypInt()))
	var mSliceBool @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypBool()))
	if streq(mSliceInt, rSliceInt) {
		return "@[]int and *[]int must have DISTINCT identities (managed vs raw)"
	}
	if streq(mSliceInt, mSliceBool) {
		return "@[]int and @[]bool must have DISTINCT identities (element type)"
	}
	return ""
}

// char ≡ uint8 ≡ byte is one singleton type, so `@[]char` and `@[]byte` collapse
// to a single identity — while staying distinct from a genuinely different
// element (`@[]int`).
func TestNamelessAnySrcNameAliasCollapse() testing.TestResult {
	var mSliceChar @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypChar()))
	var mSliceByte @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypByte()))
	var mSliceInt @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypInt()))
	if !streq(mSliceChar, mSliceByte) {
		return "@[]char and @[]byte must COLLAPSE to one identity (same singleton)"
	}
	if streq(mSliceChar, mSliceInt) {
		return "@[]char and @[]int must be DISTINCT"
	}
	return ""
}

// A readonly element is part of the identity: `@[]readonly int` ≠ `@[]int` (the
// `r` constructor tag wraps the element).  This pins the mangler; a REAL box
// site preserves it end-to-end too — wrapAsIfaceValue keys the identity on the
// source expression's un-stripped checker type, so element-`readonly` survives
// the IR's layout-transparent strip (conformance 1076).
func TestNamelessAnySrcNameReadonly() testing.TestResult {
	var roElem @types.Type = types.MakeReadonlyType(types.TypInt())
	var mSliceRoInt @[]char = namelessAnySrcName(types.MakeManagedSliceType(roElem))
	var mSliceInt @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypInt()))
	if streq(mSliceRoInt, mSliceInt) {
		return "@[]readonly int and @[]int must be DISTINCT (readonly is part of identity)"
	}
	return ""
}

// The array length and each name-less KIND are part of the identity too:
// `[3]int` ≠ `[4]int`, and an array ≠ a slice of the same element.
func TestNamelessAnySrcNameArray() testing.TestResult {
	var a3 @[]char = namelessAnySrcName(types.MakeArrayType(types.TypInt(), 3))
	var a4 @[]char = namelessAnySrcName(types.MakeArrayType(types.TypInt(), 4))
	var mSliceInt @[]char = namelessAnySrcName(types.MakeManagedSliceType(types.TypInt()))
	if streq(a3, a4) {
		return "[3]int and [4]int must be DISTINCT (array length is part of identity)"
	}
	if streq(a3, mSliceInt) {
		return "[3]int and @[]int must be DISTINCT (array vs slice)"
	}
	return ""
}

// Nesting recurses through the structural mangling: `@[]@[]int` doubles the
// managed-slice tag and stays distinct from `@[]int`.
func TestNamelessAnySrcNameNested() testing.TestResult {
	var inner @types.Type = types.MakeManagedSliceType(types.TypInt())
	var t @types.Type = types.MakeManagedSliceType(inner)
	if !streq(namelessAnySrcName(t), "pkg/builtins/rt.__nameless_MMN0_3_int") {
		return "@[]@[]int should map to 'pkg/builtins/rt.__nameless_MMN0_3_int'"
	}
	if streq(namelessAnySrcName(t), namelessAnySrcName(inner)) {
		return "@[]@[]int and @[]int must be DISTINCT"
	}
	return ""
}
