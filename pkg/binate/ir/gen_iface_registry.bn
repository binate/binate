package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Module-local interface registry: name → ordered method-name
// list, plus result-type / alias / parent metadata.  Built up
// during GeneratePackage / GenModule's first pass via
// collectInterfaceFromDecl; consumed by impl-collection
// (gen_impl.bn) and the use-site dispatch helpers
// (gen_iface.bn, gen_iface_extends.bn).  Slice 2.3a-1 of
// plan-interface-syntax-revision.md introduced the registry;
// Slices 2.4 / 2.7 / E.3 added the alias / cross-package /
// parent fields.

// ModuleInterface caches an interface's method-name list (in
// declaration order) so collectImplVtables can populate vtable
// slots without re-walking the interface's AST. Module-local
// because Slice 2.3a-1 only handles same-package impls; cross-
// package interface refs are deferred. MethodResultsFlat /
// MethodResultCounts store every method's result types (flattened in
// method order), so genInterfaceMethodCall types the dispatch result for
// 0-, 1-, and >=2-result methods alike — a >=2-result method builds the
// tuple struct rather than the void call the old single-result store
// produced (which made the multi-assign `extractvalue` against void).
type ModuleInterface struct {
	// Pkg: short package name where the interface is declared
	// ("main" / "greeter" / etc.). Cross-package references match
	// on (Pkg, Name); same-package references use Pkg = current
	// module's pkgShort. Slice 2.7 of plan-cross-package-
	// interfaces.md.
	Pkg           @[]char
	Name          @[]char
	MethodNames   @[]@[]char
	// MethodParamsFlat holds every method's param types concatenated in
	// method order; MethodParamCounts[j] is method j's param count.  So
	// method j's params are MethodParamsFlat[off..off+count] where off =
	// sum(MethodParamCounts[<j]).  Flat (not @[]@[]@Type) because a managed-
	// slice-of-managed-slice STRUCT FIELD trips a missing nested cross-
	// package element dtor in the current BUILDER; this keeps the shape at
	// @[]@Type — the flat shape used throughout, known-good.  Interface
	// dispatch needs these to apply the same arg coercions (managed->raw
	// slice, string->chars, struct-copy RefInc, iface move/RefInc) the
	// regular call path applies — without it a managed-slice arg to a
	// raw-slice param is passed at the wrong width, shifting later args.
	MethodParamsFlat  @[]@types.Type
	MethodParamCounts @[]int
	// MethodResultsFlat / MethodResultCounts hold every method's RESULT
	// types flattened in method order, exactly parallel to MethodParamsFlat /
	// MethodParamCounts (method j's results are MethodResultsFlat[rOff ..
	// rOff+count]).  A 0- or >=2-result method needs all of them; the old
	// single-result store kept nil for those, so a >=2-result iface dispatch
	// built a void call.  This is the CR-2 SEAM field — DEFINED here,
	// CONSUMED read-only by the codegen / native backends for tuple layout.
	MethodResultsFlat  @[]@types.Type
	MethodResultCounts @[]int
	// AliasTarget (Slice 2.4): for `interface X = Y` aliases,
	// holds the target interface's name. Lookups follow the
	// chain on read so dispatch + vtable lookup work uniformly
	// through either name. Empty for non-alias entries. For
	// cross-package alias targets, AliasTargetPkg names the
	// target's package; both fields together identify the
	// canonical underlying interface.
	AliasTarget    @[]char
	AliasTargetPkg @[]char
	// ParentPkgs / ParentNames (plan-interface-embedding.md Slice
	// E.3): parallel arrays naming each parent interface this one
	// extends, in declaration order. ParentPkgs[i] / ParentNames[i]
	// identify a single parent under the same (Pkg, Name) keying
	// used elsewhere. Empty for interfaces that don't extend.
	ParentPkgs  @[]@[]char
	ParentNames @[]@[]char
}

// moduleInterfaces is the per-module interface registry built up
// during GeneratePackage / GenModule's first pass. Indexed by name
// via lookupModuleInterface; reset by InitModule between modules
// so test runs and successive packages stay isolated.
var moduleInterfaces @[]ModuleInterface

// registerUniverseAny seeds moduleInterfaces with the universe `any`
// interface (Pkg="", Name="any", empty method set).  Called from
// InitModule right after the moduleInterfaces clear, so every module
// starts with `any` already visible to isInterfaceTypeExpr /
// ifaceTypeForName / lookupModuleInterface.  Plan §6 of
// plan-interface-syntax-revision.md — the implicit universal
// interface that every type satisfies.
func registerUniverseAny() {
	var mi ModuleInterface
	var emptyPkg @[]char
	mi.Pkg = emptyPkg
	mi.Name = "any"
	moduleInterfaces = slices.Append[ModuleInterface](moduleInterfaces, mi)
}

// collectInterfaceFromDecl records a DECL_INTERFACE's method names
// (in source order — matches the slot ordering codegen uses for
// the vtable global). Alias forms (`interface X = Y`) record the
// target name only; methods are read via alias-following lookups
// (lookupModuleInterface / findInterfaceMethod). pkgShort is the
// short package name where this interface is declared; same-package
// (Slice 2.3a-1) callers pass the module package path, RegisterImport
// (Slice 2.7) passes the import's alias.  file is the AST file the
// decl was parsed from — recorded alongside a stashed generic decl so
// ensureInstantiatedInterface can resolve the deferred method
// signatures against the generic's own imports (see genericIfaceDeclFiles).
func collectInterfaceFromDecl(gc @GenCtx, d @ast.Decl, pkgShort *[]readonly char,
		file @ast.File) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}
	// Generic interface decls (TypeParams non-empty): stash the
	// AST decl in gc.GenericIfaceDecls for use sites
	// (ensureInstantiatedInterface) and impl-collection
	// (collectImplsFromDecl's TEXPR_INSTANTIATE branch) to find.
	// Per plan-generics.md Slice 6c, each instantiation needs its
	// own ModuleInterface with substituted method types — that
	// happens lazily.  Registering the bare generic decl under
	// the source-text name with unresolved T-typed methods would
	// create stale data that downstream vtable / impl-satisfaction
	// passes would mis-interpret.
	if len(d.TypeParams) > 0 {
		gc.GenericIfaceDecls = slices.Append[@ast.Decl](gc.GenericIfaceDecls, d)
		gc.GenericIfaceDeclPkgs = slices.Append[@[]char](
			gc.GenericIfaceDeclPkgs, buf.CopyStr(pkgShort))
		gc.GenericIfaceDeclFiles = slices.Append[@ast.File](
			gc.GenericIfaceDeclFiles, file)
		return
	}
	// Resolve the declaring package to its full path so the
	// interface identity matches full-path use-site references and
	// the vtable mangling (full-path mangling — see pkg/binate/mangle).
	// (The generic-decl registry above keeps the raw alias, which it
	// queries with the same alias — a separate, internally-consistent
	// namespace.)
	var rpkg @[]char = resolveImportPkg(pkgShort)
	var mi ModuleInterface
	mi.Pkg = buf.CopyStr(rpkg)
	mi.Name = buf.CopyStr(d.Name)
	if d.IsAlias {
		// Slice 2.4: interface alias. Target is a TEXPR_NAMED
		// produced by parseInterfaceRef; copy its Name into
		// AliasTarget so lookups can follow. For cross-package
		// alias targets (Slice 2.7), also store the target's
		// package; otherwise default to this interface's own
		// package (alias to a same-package iface).
		if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_NAMED {
			mi.AliasTarget = buf.CopyStr(d.TypeRef.Name)
			if len(d.TypeRef.Pkg) > 0 {
				mi.AliasTargetPkg = resolveImportPkg(d.TypeRef.Pkg)
			} else {
				mi.AliasTargetPkg = buf.CopyStr(rpkg)
			}
		}
		moduleInterfaces = slices.Append[ModuleInterface](
			moduleInterfaces, mi)
		return
	}
	// Register this interface's identity (Pkg + Name) in the registry
	// BEFORE resolving its method and parent signatures.  A method
	// whose return type is this very interface — a self-reference like
	// `Unwrap() @Error` — resolves that type via resolveTypeExpr →
	// isInterfaceTypeExpr, which consults moduleInterfaces; with no
	// entry the lookup misses and `@Error` degrades to a managed
	// pointer (MakeManagedPtrType).  The dispatch shim would then carry
	// an `i8*` return while the method body returns a `%BnIfaceValue`,
	// an in-module ABI mismatch.  The fully-populated entry overwrites
	// this stub at the end.
	var selfIdx int = len(moduleInterfaces)
	moduleInterfaces = slices.Append[ModuleInterface](
		moduleInterfaces, mi)
	// Resolve method and parent signatures with the active-package
	// context pointing at this interface's own package, so a self-
	// referential return type (`Unwrap() @Error`) resolves against the
	// stub above even in the cross-package RegisterAllInterfaces pre-
	// pass — there gc.PkgPath is not yet this package, and
	// isInterfaceTypeExpr / ifaceTypeForName fall back to
	// currentImportAlias for a bare name.
	var savedImportAlias @[]char = currentImportAlias
	currentImportAlias = buf.CopyStr(pkgShort)
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC {
			continue
		}
		mi.MethodNames = slices.Append[@[]char](mi.MethodNames,
			buf.CopyStr(m.Name))
		// Resolve result + param types in the SAME loop (same
		// currentImportAlias context, after the self-stub append) so a
		// self-referential result/param type resolves to this interface, not
		// a degraded managed pointer.  Results flattened like params so a
		// 0- or >=2-result method carries all its types.
		for j := 0; j < len(m.Results); j++ {
			mi.MethodResultsFlat = slices.Append[@types.Type](
				mi.MethodResultsFlat, resolveTypeExpr(gc, m.Results[j]))
		}
		mi.MethodResultCounts = slices.Append[int](mi.MethodResultCounts,
			len(m.Results))
		for j := 0; j < len(m.Params); j++ {
			mi.MethodParamsFlat = slices.Append[@types.Type](
				mi.MethodParamsFlat, resolveTypeExpr(gc, m.Params[j].Type))
		}
		mi.MethodParamCounts = slices.Append[int](mi.MethodParamCounts,
			len(m.Params))
	}
	// plan-interface-embedding.md Slice E.3: record this interface's
	// parents (in declaration order).  collectInterfaceParents handles
	// both plain (`: Parent`) and instantiated-generic (`: Container[int]`)
	// parent refs.
	mi.ParentPkgs, mi.ParentNames = collectInterfaceParents(gc, d, rpkg,
		pkgShort)
	currentImportAlias = savedImportAlias
	// Overwrite the identity stub appended above with the now-complete
	// entry (method names/results, parents).
	moduleInterfaces[selfIdx] = mi
}

// collectInterfaceParents resolves d's extension clause (d.Interfaces)
// to parallel (pkg, name) arrays for ModuleInterface.ParentPkgs /
// ParentNames, in declaration order.  Each parent ref is either a
// TEXPR_NAMED (`: Parent` / `: pkg.Parent`) or a TEXPR_INSTANTIATE
// (`: Container[int]`); the latter is instantiated lazily via
// ensureInstantiatedInterface and recorded under its mangled name so
// the concat-vtable layout (Slice E.4) and the ancestor-closure walk
// in collectImplsFromDecl reach the right (R, I) pair.  rpkg is the
// declaring interface's resolved package (used for same-package parent
// refs); pkgShort is the alias used to look up same-package generic
// parent decls.  Callers set currentImportAlias and (for generic
// instantiation) the type-param substitution context before calling, so
// resolveTypeExpr resolves type-args correctly — `Container[T]` inside
// `WideBox[int]` resolves to `Container[int]`.
func collectInterfaceParents(gc @GenCtx, d @ast.Decl, rpkg *[]readonly char,
		pkgShort *[]readonly char) (@[]@[]char, @[]@[]char) {
	var parentPkgs @[]@[]char
	var parentNames @[]@[]char
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var parentPkg @[]char
		var parentName @[]char
		if ref.Kind == ast.TEXPR_NAMED {
			if len(ref.Pkg) > 0 {
				parentPkg = resolveImportPkg(ref.Pkg)
			} else {
				parentPkg = buf.CopyStr(rpkg)
			}
			parentName = buf.CopyStr(ref.Name)
		} else if ref.Kind == ast.TEXPR_INSTANTIATE {
			// Slice 7c: parent ref may be qualified
			// (`interface Sub : pkg.Container[int]`); use
			// lookupGenericIfaceDeclPkg with the right alias.
			if ref.Base == nil { continue }
			if ref.Base.Kind != ast.TEXPR_NAMED { continue }
			var lookupPkg @[]char
			if len(ref.Base.Pkg) > 0 {
				lookupPkg = resolveImportPkg(ref.Base.Pkg)
			} else {
				lookupPkg = buf.CopyStr(pkgShort)
			}
			var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc,
				lookupPkg, ref.Base.Name)
			if gd == nil { continue }
			var argTypes @[]@types.Type
			for ai := 0; ai < len(ref.TypeArgs); ai++ {
				argTypes = slices.Append[@types.Type](argTypes,
					resolveTypeExpr(gc, ref.TypeArgs[ai]))
			}
			parentPkg = buf.CopyStr(rpkg)
			parentName = ensureInstantiatedInterface(gc, gd, argTypes)
		} else {
			continue
		}
		parentPkgs = slices.Append[@[]char](parentPkgs, parentPkg)
		parentNames = slices.Append[@[]char](parentNames, parentName)
	}
	return parentPkgs, parentNames
}

// resolveModuleInterface returns the index in moduleInterfaces of
// the entry for (pkg, name), following any alias chain. Returns -1
// on not-found or cycle (defensive cap at 32 hops). Slice 2.7
// keys lookup on (Pkg, Name) so cross-package interface refs
// resolve to the imported package's entry without colliding with
// a same-named local interface.
func resolveModuleInterface(pkg *[]readonly char,
		name *[]readonly char) int {
	var found int = lookupModuleInterfaceIndex(pkg, name)
	if found < 0 { return -1 }
	var curPkg @[]char = buf.CopyStr(pkg)
	var curName @[]char = buf.CopyStr(name)
	for hop := 0; hop < 32; hop++ {
		var alias @[]char = moduleInterfaces[found].AliasTarget
		if len(alias) == 0 { return found }
		curPkg = moduleInterfaces[found].AliasTargetPkg
		curName = alias
		found = lookupModuleInterfaceIndex(curPkg, curName)
		if found < 0 { return -1 }
	}
	return -1
}

// canonicalIfaceName resolves an interface (pkg, name) through the
// alias chain and returns the chain tail's name. If the input
// doesn't refer to a registered interface, returns a fresh copy of
// the input name — at worst the symbol mangles on the impl-site
// reference. Slice 2.6 / 2.7.
func canonicalIfaceName(pkg *[]readonly char,
		name *[]readonly char) @[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		return buf.CopyStr(name)
	}
	return buf.CopyStr(moduleInterfaces[idx].Name)
}

// canonicalIfacePkg returns the canonical package short-name for
// the chain-tail of (pkg, name). Used by Slice 2.6's vtable
// mangling (`__ivt.bn_<recv_pkg>__<recv>__<iface_pkg>__<iface>`)
// to ensure aliases collapse to the underlying interface's
// package. If lookup fails, returns the input pkg unchanged.
func canonicalIfacePkg(pkg *[]readonly char,
		name *[]readonly char) @[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		return buf.CopyStr(pkg)
	}
	return buf.CopyStr(moduleInterfaces[idx].Pkg)
}

// lookupModuleInterfaceIndex returns the index of the entry in
// moduleInterfaces matching (pkg, name), or -1 if absent. No alias-
// chain resolution.  The pkg argument is expanded from an import
// alias to the full package path (resolveImportPkg) so a use-site
// reference written with the short alias matches the interface's
// full-path-keyed registry entry (full-path mangling — see
// pkg/binate/mangle).
func lookupModuleInterfaceIndex(pkg *[]readonly char,
		name *[]readonly char) int {
	var fpkg @[]char = resolveImportPkg(pkg)
	for i := 0; i < len(moduleInterfaces); i++ {
		if !charEq(moduleInterfaces[i].Pkg, fpkg) { continue }
		if !charEq(moduleInterfaces[i].Name, name) { continue }
		return i
	}
	return -1
}

// lookupModuleInterface returns the cached method-name list for the
// interface (pkg, name), or an empty slice if not found. Follows
// alias chains. Slice 2.7 keys lookup on (Pkg, Name).
func lookupModuleInterface(pkg *[]readonly char,
		name *[]readonly char) @[]@[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		var empty @[]@[]char
		return empty
	}
	return moduleInterfaces[idx].MethodNames
}

// IfaceMethodCount returns the number of methods declared on the
// interface identified by canonical (pkg, name), following alias
// chains. Returns 0 if the interface isn't registered. Used by
// codegen (Slice 2.8) to size the array type when declaring an
// imported vtable as `external constant [N+1 x i8*]`.
func IfaceMethodCount(pkg *[]readonly char,
		name *[]readonly char) int {
	return len(lookupModuleInterface(pkg, name))
}

// IfaceOwnMethodNames returns the OWN method names of the
// interface (pkg, name), in declaration order — the same list
// IR-gen records during DECL_INTERFACE collection.  Inherited
// methods are not included; walk parents (via IfaceParentPkgs /
// IfaceParentNames) for the full set.
func IfaceOwnMethodNames(pkg *[]readonly char,
		name *[]readonly char) @[]@[]char {
	return lookupModuleInterface(pkg, name)
}
