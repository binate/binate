package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_iface.bn — IR-gen use-site behavior for interface
// values: `*X` / `@X` resolution to interface-value types, and lifting
// `*T` / `@T` source values into `*Iface`. The dispatch
// (`iv.method(args)`) tests live in gen_iface_dispatch_test.bn; the
// collection-side tests (build-time interface registry + impl walking)
// live in gen_impl_test.bn. Helpers (genFromSource, genFromSourcePkg,
// fail) live in ir_test.bn.

// Slice 2.3a-2 IR shape: `var iv *I = &t` produces an OP_IFACE_VALUE
// instruction wrapping the source pointer with the impl's vtable
// global. Without this op the slot would be filled with a bare i8*
// rather than the 2-word {data, vtable} interface value.
func TestGenImplWrapEmitsIfaceValue() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar iv *I = &t\n"
					"\t_ = iv\n"
					"}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, iropcode.OP_IFACE_VALUE) < 1 {
		return fail(
				"expected iropcode.OP_IFACE_VALUE for *Iface construction")
	}
	return ""
}

// Slice 2.3a-2 IR shape: an interface-name in `*X` / `@X` position
// resolves to TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED, not
// TYP_POINTER / TYP_MANAGED_PTR. The slot's LLVM type then comes
// out as `%BnIfaceValue` (16 bytes) rather than a single i8*.
func TestGenImplResolveStarIfaceType() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar iv *I = &t\n"
					"\t_ = iv\n"
					"}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	// At least one alloca with TypeArg == TYP_INTERFACE_VALUE
	// (the iv slot). If resolveTypeExpr produced TYP_POINTER, this
	// search would fail.
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_ALLOC && instr.TypeArg != nil &&
					instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return ""
			}
		}
	}
	return fail("no alloca with TYP_INTERFACE_VALUE element")
}

// `*X` where X is a struct (not an interface) keeps the regular
// pointer kind — the interface-aware arm only fires for declared
// interface names. Guards against an over-broad match.
func TestGenImplResolveStarStructStaysPointer() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type T struct { x int }\n"
					"func main() {\n"
					"\tvar t T\n"
					"\tvar p *T = &t\n"
					"\t_ = p\n"
					"}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_ALLOC && instr.TypeArg != nil &&
					instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return fail(
						"*T over a struct should NOT be TYP_INTERFACE_VALUE")
			}
		}
	}
	return ""
}
