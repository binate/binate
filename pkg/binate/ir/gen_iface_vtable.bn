package "pkg/binate/ir"

import "pkg/binate/mangle"

// Vtable-name lookup for IR-gen.  Use sites (wrapAsIfaceValue in
// gen_iface.bn, OP_IFACE_VALUE construction elsewhere) read these to
// spell the canonical `__ivt.<...>` global that codegen's emit_impls.bn
// defines for each (impl, interface) pair.  The symbol itself is built
// by mangle.ImplVtableName (the single source of truth, shared with
// codegen and the VM); this file does the lookup/match against m.Impls.

// findImplVtableName searches m.Impls and m.ImportedImpls for an
// entry matching the canonical (recvPkg, recvName, ifacePkg,
// ifaceName), returning the mangled `__ivt.<...>` global name
// codegen emits for that impl. The query is canonicalized through
// the alias chain so a use-site referencing an alias matches an
// impl declared on the alias's target (or vice versa). Returns
// empty if no match — IR-gen's caller (genDecl interface-value
// path) treats that as "no impl" and falls back to a placeholder.
// Slice 2.3a-2 of plan-interface-syntax-revision.md; Slices 2.6 /
// 2.7 canonicalized the symbol form on
// (recv_pkg, recv_name, iface_pkg, iface_name); Slice 2.8 widened
// the search to imported impls so cross-package use sites (where
// the impl lives in a different TU) can produce the canonical
// symbol that the linker resolves to the imported TU's weak_odr
// vtable, and split the receiver lookup into (pkg, name) so
// imported recv names (which arrive qualified through IR-gen's
// type-resolution path) match the bare-name form stored on
// ImplInfo.
func findImplVtableName(m @Module, recvPkg *[]readonly char,
		recvName *[]readonly char,
		ifacePkg *[]readonly char,
		ifaceName *[]readonly char) @[]char {
	var canonName @[]char = canonicalIfaceName(m, ifacePkg, ifaceName)
	var canonPkg @[]char = canonicalIfacePkg(m, ifacePkg, ifaceName)
	var sym @[]char = findImplVtableNameIn(m.Impls, recvPkg,
		recvName, canonPkg, canonName)
	if len(sym) > 0 { return sym }
	return findImplVtableNameIn(m.ImportedImpls, recvPkg,
		recvName, canonPkg, canonName)
}

// findImplVtableNameIn scans a single ImplInfo collection for a
// matching (recvPkg, recvName, canonical iface) entry and returns
// the mangled vtable symbol, or empty if no match.
func findImplVtableNameIn(infos @[]@ImplInfo,
		recvPkg *[]readonly char,
		recvName *[]readonly char,
		canonPkg *[]readonly char,
		canonName *[]readonly char) @[]char {
	for i := 0; i < len(infos); i++ {
		var info @ImplInfo = infos[i]
		if info == nil { continue }
		if !charEq(info.RecvPkg, recvPkg) { continue }
		if !charEq(info.RecvTypeName, recvName) { continue }
		if !charEq(info.IfacePkg, canonPkg) { continue }
		if !charEq(info.IfaceName, canonName) { continue }
		return buildImplVtableSymbol(info)
	}
	var empty @[]char
	return empty
}

// buildImplVtableSymbol formats the canonical vtable symbol for an
// ImplInfo by delegating to mangle.ImplVtableName — the single source
// of truth shared with codegen (emit_impls.bn) and the VM. Slice 2.6.
func buildImplVtableSymbol(info @ImplInfo) @[]char {
	return mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName,
		info.IfacePkg, info.IfaceName)
}
