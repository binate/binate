package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_iface_vtable.bn — vtable-name lookup and mangling.
// Use-site behavior (wrapAsIfaceValue, OP_IFACE_VALUE emission) is
// tested in gen_iface_test.bn via genFromSourcePkg; the helpers here
// get direct unit coverage so a mangling regression surfaces without
// having to decode an LLVM IR string.

// buildImplVtableSymbol formats `__ivt.bn_<recvPkg>__<recvName>__-
// <ifacePkg>__<ifaceName>` from an ImplInfo. The shape is codegen's
// contract (pkg/binate/codegen/emit_impls.bn re-derives the same name
// through ImplInfo fields), so any rename here must move in lockstep.
func TestBuildImplVtableSymbol() testing.TestResult {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = "greeter"
	info.RecvTypeName = "Hello"
	info.IfacePkg = "main"
	info.IfaceName = "Greeter"
	var got @[]char = buildImplVtableSymbol(info)
	var want @[]char = "__ivt.bn_greeter__Hello__main__Greeter"
	if !charsEqualOpt(got, want) {
		var b @strings.Builder = strings.NewBuilder()
		b.Write("got `")
		b.Write(got)
		b.Write("`, want `")
		b.Write(want)
		b.Write("`")
		return fail(buf.CopyStr(b.String()))
	}
	return ""
}

// buildImplVtableSymbol must accept the empty-pkg form used for the
// universe `any` interface (plan §6).  __ivt.bn_main__Box____any
// (note the doubled __ around the empty iface pkg) is the canonical
// shape ensureAnyImplInfo / emitImplVtables produce.
func TestBuildImplVtableSymbolEmptyIfacePkg() testing.TestResult {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "Box"
	var emptyPkg @[]char
	info.IfacePkg = emptyPkg
	info.IfaceName = "any"
	var got @[]char = buildImplVtableSymbol(info)
	var want @[]char = "__ivt.bn_main__Box____any"
	if !charsEqualOpt(got, want) {
		var b @strings.Builder = strings.NewBuilder()
		b.Write("got `")
		b.Write(got)
		b.Write("`, want `")
		b.Write(want)
		b.Write("`")
		return fail(buf.CopyStr(b.String()))
	}
	return ""
}

// findImplVtableNameIn returns the mangled name for a match,
// matching on all four canonical fields.  Mismatch on any one
// returns empty.
func TestFindImplVtableNameInMatch() testing.TestResult {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var infos @[]@ImplInfo = make_slice(@ImplInfo, 1)
	infos[0] = info
	var got @[]char = findImplVtableNameIn(infos, "main", "T",
		"main", "I")
	var want @[]char = "__ivt.bn_main__T__main__I"
	if !charsEqualOpt(got, want) {
		return fail("expected matching vtable name")
	}
	// Wrong receiver name → empty.
	var miss @[]char = findImplVtableNameIn(infos, "main", "Other",
		"main", "I")
	if len(miss) != 0 {
		return fail("expected empty on receiver mismatch")
	}
	// Wrong iface name → empty.
	miss = findImplVtableNameIn(infos, "main", "T", "main", "J")
	if len(miss) != 0 {
		return fail("expected empty on iface mismatch")
	}
	return ""
}
