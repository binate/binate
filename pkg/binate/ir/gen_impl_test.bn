package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_impl.bn — collects DECL_INTERFACE method names and
// then walks DECL_IMPL entries to populate m.Impls. Slice 2.3a-1 of
// plan-interface-syntax-revision.md. Helpers (genFromSource,
// genFromSourcePkg, fail) live in ir_test.bn.

// A single `impl T : I` produces one ImplInfo with one slot pointing
// at the impl's matching method.
func TestGenImplSingle() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 1 { return fail("expected 1 impl info") }
	var info @ImplInfo = m.Impls[0]
	if !charsEqualOpt(info.RecvTypeName, "T") {
		return fail("RecvTypeName should be T")
	}
	if !charsEqualOpt(info.IfaceName, "I") {
		return fail("IfaceName should be I")
	}
	if len(info.MethodFuncs) != 1 {
		return fail("expected 1 method slot")
	}
	if !charsEqualOpt(info.MethodFuncs[0], "test.T.foo") {
		return fail("MethodFuncs[0] should be `test.T.foo`")
	}
	return ""
}

// `impl T : I1, I2` produces one ImplInfo per interface.
func TestGenImplMultipleInterfaces() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface A { fa() }\n"
		"interface B { fb() }\n"
		"type T struct { x int }\n"
		"func (t *T) fa() { }\n"
		"func (t *T) fb() { }\n"
		"impl *T : A, B\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 2 {
		return fail("expected 2 impl infos")
	}
	if !charsEqualOpt(m.Impls[0].IfaceName, "A") {
		return fail("first impl should be for A")
	}
	if !charsEqualOpt(m.Impls[1].IfaceName, "B") {
		return fail("second impl should be for B")
	}
	return ""
}

// A multi-method interface puts methods in the slot order they were
// declared in the interface.
func TestGenImplMethodOrder() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface RW { read() int; write() }\n"
		"type Pipe struct { x int }\n"
		"func (p *Pipe) read() int { return 0 }\n"
		"func (p *Pipe) write() { }\n"
		"impl *Pipe : RW\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 1 { return fail("expected 1 impl") }
	var mfs @[]@[]char = m.Impls[0].MethodFuncs
	if len(mfs) != 2 { return fail("expected 2 method slots") }
	if !charsEqualOpt(mfs[0], "test.Pipe.read") {
		return fail("slot 0 should be read")
	}
	if !charsEqualOpt(mfs[1], "test.Pipe.write") {
		return fail("slot 1 should be write")
	}
	return ""
}

// A program with no impls leaves m.Impls empty.
func TestGenImplNone() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() { }\n"
	var m @Module = genFromSourcePkg(src)
	if len(m.Impls) != 0 {
		return fail("expected no impls")
	}
	return ""
}

// plan-interface-embedding.md Slice E.3: `impl *T : Child` where
// `Child : Closer` produces TWO ImplInfo entries — one for the
// listed interface and one for each ancestor.  The child's
// MethodFuncs holds only its own methods (Read here); the
// parent's entry holds the parent's own methods (Close).  Used
// by codegen to emit both vtables, with the (T, Child) vtable
// inlining the parent's slot values in the concat layout.
func TestGenImplExtendedRegistersAncestor() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 2 {
		return fail("expected 2 impl infos (RC + inherited Closer)")
	}
	// The directly-listed interface comes first.
	if !charsEqualOpt(m.Impls[0].IfaceName, "RC") {
		return fail("first impl should be for RC")
	}
	if len(m.Impls[0].MethodFuncs) != 1 {
		return fail("RC impl should hold 1 own method (Read)")
	}
	if !charsEqualOpt(m.Impls[0].MethodFuncs[0], "test.F.Read") {
		return fail("RC slot 0 should be test.F.Read")
	}
	// The ancestor is registered transitively.
	if !charsEqualOpt(m.Impls[1].IfaceName, "Closer") {
		return fail("second impl should be for Closer")
	}
	if len(m.Impls[1].MethodFuncs) != 1 {
		return fail("Closer impl should hold 1 own method (Close)")
	}
	if !charsEqualOpt(m.Impls[1].MethodFuncs[0], "test.F.Close") {
		return fail("Closer slot 0 should be test.F.Close")
	}
	return ""
}

// Slice 6c-full of plan-generics.md: `impl T : Container[int]`
// instantiates the named generic interface lazily and uses its
// mangled name (`Container__bn_inst__int`) as the iface key.
// The receiver type-name carries through to ImplInfo unchanged.
func TestGenImplOnGenericInterface() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"impl IntBox : Container[int]\n"
		"func (b IntBox) get() int { return b.v }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 1 {
		return fail("expected 1 impl info (Container[int])")
	}
	var info @ImplInfo = m.Impls[0]
	if !charsEqualOpt(info.RecvTypeName, "IntBox") {
		return fail("RecvTypeName should be IntBox")
	}
	if !charsEqualOpt(info.IfaceName,
			"Container__bn_inst__int") {
		var emsg @strings.Builder = strings.NewBuilder()
		emsg.Write(
			"IfaceName: want Container__bn_inst__int, got ")
		emsg.Write(info.IfaceName)
		return buf.CopyStr(emsg.String())
	}
	if len(info.MethodFuncs) != 1 {
		return fail("expected 1 method slot")
	}
	if !charsEqualOpt(info.MethodFuncs[0], "test.IntBox.get") {
		return fail("MethodFuncs[0] should be test.IntBox.get")
	}
	return ""
}

// Two impls on different instantiations of the same generic
// interface produce two separate ImplInfos under distinct
// mangled iface names — `Container[int]` and `Container[*int]`
// don't collide.
func TestGenImplOnGenericIfaceMultiInst() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"type PtrBox struct { v *int }\n"
		"impl IntBox : Container[int]\n"
		"impl PtrBox : Container[*int]\n"
		"func (b IntBox) get() int { return b.v }\n"
		"func (b PtrBox) get() *int { return b.v }\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 2 {
		return fail("expected 2 impl infos")
	}
	if !charsEqualOpt(m.Impls[0].IfaceName,
			"Container__bn_inst__int") {
		return fail(
			"Impls[0].IfaceName should be Container__bn_inst__int")
	}
	if !charsEqualOpt(m.Impls[1].IfaceName,
			"Container__bn_inst__ptr_int") {
		return fail(
			"Impls[1].IfaceName should be Container__bn_inst__ptr_int")
	}
	return ""
}

// User writing `impl T : Child, Parent` explicitly is not
// double-registered — the ancestor closure dedup catches it.
func TestGenImplExtendedListedRedundantParent() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n")
	// Closer redundantly listed alongside RC.
	cb.Write("impl *F : RC, Closer\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 2 {
		return fail("expected 2 impl infos (deduped, not 3)")
	}
	return ""
}
