package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// pushFileImports snapshots the alias map and overlays file's own
// imports (alias=shortName(path), path=path) so the file's type and
// interface refs resolve via THAT FILE'S aliases — not whichever
// alias happened to win the global first-wins dedup across broadly-
// loaded packages.  Each file's imports unambiguously bind aliases
// within that file by source-level constraint; the map collision
// only arises from CONFLATING different files' aliases.  Pop with
// popFileImports.
func pushFileImports(file @ast.File) AliasMapSnapshot {
	var snap AliasMapSnapshot
	snap.Names = importAliasNames
	snap.Paths = importAliasPaths
	if file == nil { return snap }
	for i := 0; i < len(file.Imports); i++ {
		var p @[]char = unquote(file.Imports[i].Path)
		var alias @[]char = lastPathSegment(p)
		RecordImportPath(alias, p)
	}
	return snap
}

// popFileImports restores the alias map from a pushFileImports
// snapshot.
func popFileImports(snap AliasMapSnapshot) {
	importAliasNames = snap.Names
	importAliasPaths = snap.Paths
}

// SaveAliasMapState captures the current importAliasNames /
// importAliasPaths state without applying any overlay.  REPL
// session use (Tier 5 mid-session imports): the driver wraps
// per-package InitModule loops between Save / Restore so the
// session's main alias map survives the wipe each per-package
// InitModule does.
func SaveAliasMapState() AliasMapSnapshot {
	var snap AliasMapSnapshot
	snap.Names = importAliasNames
	snap.Paths = importAliasPaths
	return snap
}

// RestoreAliasMapState writes back a snapshot from
// SaveAliasMapState.  Sibling of popFileImports but without
// the pop-by-snapshot file-imports overlay assumption — the
// REPL driver pairs this with RecordImportPath calls to
// extend the restored map with new aliases.
func RestoreAliasMapState(snap AliasMapSnapshot) {
	importAliasNames = snap.Names
	importAliasPaths = snap.Paths
}

// lastPathSegment is the local copy of cmd/bnc's shortName — IR
// needs it for pushFileImports and avoids the cmd-only dependency.
func lastPathSegment(p *[]readonly char) @[]char {
	var last int = 0
	for i := 0; i < len(p); i++ {
		if p[i] == '/' { last = i + 1 }
	}
	return buf.CopyStr(p[last:])
}

// unquote strips surrounding quotes (delegates to mangle's helper).
func unquote(s *[]readonly char) @[]char {
	return mangle.PkgPathFromQuoted(s)
}

// RecordImportPath maps an import alias to its full package path
// (the import path, e.g. `bni` → `cmd/bni`), so cross-package
// qualified names expand to the full path used by the importee's
// own compilation (see resolveImportPkg).  First write wins, so a
// caller that knows the true import path should call this before
// any file-based fallback runs.  No-op for an empty path.
//
// The path must be the IMPORT PATH, not the file's declared package
// name: a cmd package declares `package "main"` but is imported by
// its path (`cmd/bni`), and the importee compiles under that path —
// so a `file.PkgName`-based mapping (`bni → main`) would mis-qualify
// its symbols and collide with the importer's own `main`.
func RecordImportPath(alias *[]readonly char, path *[]readonly char) {
	if len(path) == 0 { return }
	for i := 0; i < len(importAliasNames); i++ {
		if streq(importAliasNames[i], alias) { return }
	}
	importAliasNames = slices.Append[@[]char](importAliasNames,
		buf.CopyStr(alias))
	importAliasPaths = slices.Append[@[]char](importAliasPaths,
		buf.CopyStr(path))
}

// RegisterImports registers multiple imported packages with cross-
// package type resolution.  paths[k] is the import path for
// aliases[k] (e.g. "pkg/binate/loader") — passed explicitly rather than
// derived from file.PkgName so a cmd's `package "main"` still
// qualifies under its import path.
func RegisterImports(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, mod @Module) {
	// Pass 0: record alias → full-path mappings before any
	// buildQualName call so cross-package names expand correctly.
	for k := 0; k < len(aliases); k++ {
		RecordImportPath(aliases[k], paths[k])
	}
	// Pass 1: register all struct type names from all imports.
	// Generic struct decls (TypeParams non-empty) stash in
	// genericTypeDecls under the import alias instead; per-(decl,
	// args) instantiations land in moduleStructs lazily at use
	// sites.  Slice 7 of plan-generics.md.
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				if len(d.TypeParams) > 0 {
					if lookupGenericTypeDeclPkg(alias,
							d.Name) == nil {
						genericTypeDecls = slices.Append[@ast.Decl](
							genericTypeDecls, d)
						genericTypeDeclPkgs = slices.Append[@[]char](
							genericTypeDeclPkgs,
							buf.CopyStr(alias))
					}
					continue
				}
				var qualName @[]char = buildQualName(alias, d.Name)
				// Only add if not already registered
				if lookupStructIdx(qualName) < 0 {
					var ms ModuleStruct
					ms.Name = qualName
					var noFields @[]@types.Field
					ms.Typ = types.MakeStructType(qualName, noFields)
					moduleStructs = slices.Append[ModuleStruct](moduleStructs, ms)
				}
			}
		}
	}

	// Pass 2: populate struct fields, register functions and
	// constants.  pushFileImports installs the imported file's own
	// imports so cross-package refs inside it (impls naming aliases
	// the imported file imports — e.g. hello's `impl *Hello :
	// aliases.Hello` referencing pkg/aliases — and method signatures'
	// types) resolve via THAT FILE'S aliases, not the importing
	// module's.
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		var snap AliasMapSnapshot = pushFileImports(file)
		currentImportAlias = alias
		registerImportFieldsAndFuncs(alias, file, mod)
		popFileImports(snap)
	}
	var emptyAlias @[]char
	currentImportAlias = emptyAlias
}

// registerImportFieldsAndFuncs does the second pass of import registration:
// populates struct fields and registers function signatures.
// Assumes all struct names are already registered.
func registerImportFieldsAndFuncs(alias *[]readonly char, file @ast.File, mod @Module) {
	// Slice 2.7: register imported interfaces in moduleInterfaces
	// under the import alias's pkg, so `*alias.Iface` /
	// `@alias.Iface` use sites resolve and findInterfaceMethod /
	// findImplVtableName see the imported method set.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(d, alias)
		}
	}

	// Slice 2.8: register imported impls so cross-package iv
	// constructions in this TU can find the vtable's mangled name.
	// The vtable global itself was emitted by the imported
	// package's TU (with weak_odr linkage); we just need
	// findImplVtableName to recognize the (R, I) pair and produce
	// the same canonical symbol.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_IMPL {
			collectImportedImplsFromDecl(d, alias, mod)
		}
	}

	// Populate struct fields
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var qualName @[]char = buildQualName(alias, d.Name)
			var si int = lookupStructIdx(qualName)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(fd.Type)
					fields = slices.Append[@types.Field](fields, f)
				}
				var existTyp @types.Type = moduleStructs[si].Typ
				existTyp.Fields = fields
			}
		}
	}

	// Register type aliases
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.IsAlias && d.TypeRef != nil {
			var qualName @[]char = buildQualName(alias, d.Name)
			var ta ModuleTypeAlias
			ta.Name = qualName
			ta.Typ = resolveTypeExpr(d.TypeRef)
			moduleTypeAliases = slices.Append[ModuleTypeAlias](moduleTypeAliases, ta)
		}
	}

	// Register function and method signatures, and add extern funcs
	// to the module so cross-package calls resolve.  Generic decls
	// (TypeParams non-empty) carry their body in the imported .bni
	// — stash them under the import alias so call-site
	// monomorphization at the consumer can look them up via
	// lookupGenericDeclPkg.  Slice 7 of plan-generics.md.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			if d.Recv == nil &&
					lookupGenericDeclPkg(alias, d.Name) == nil {
				genericDecls = slices.Append[@ast.Decl](genericDecls, d)
				genericDeclPkgs = slices.Append[@[]char](
					genericDeclPkgs, buf.CopyStr(alias))
			}
			continue
		}
		var qualName @[]char
		var sigParams @[]@types.Type
		var extParams @[]@Param
		if d.Recv != nil {
			// Method: name as "<pkgPath>.<TypeName>.<MethodName>";
			// receiver is Params[0].  Resolve the import alias to the
			// full package path so the registered name matches the
			// call-site form (genMethodCall qualifies the receiver's
			// full-path-resolved type name).
			qualName = methodQualName(resolveImportPkg(alias), d)
			var rt @types.Type = resolveTypeExpr(d.Recv.Type)
			sigParams = slices.Append[@types.Type](sigParams, rt)
			var rp @Param = make(Param)
			rp.Name = d.Recv.Name
			rp.Typ = rt
			extParams = slices.Append[@Param](extParams, rp)
		} else {
			qualName = buildQualName(alias, d.Name)
		}
		for j := 0; j < len(d.Params); j++ {
			var pt @types.Type = resolveTypeExpr(d.Params[j].Type)
			sigParams = slices.Append[@types.Type](sigParams, pt)
			var p @Param = make(Param)
			p.Name = d.Params[j].Name
			p.Typ = pt
			extParams = slices.Append[@Param](extParams, p)
		}

		var sig FuncSig
		sig.Name = qualName
		sig.Params = sigParams
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		moduleFuncs = slices.Append[FuncSig](moduleFuncs, sig)

		var ef @Func = NewExternFunc(qualName, extParams, sigResults)
		// pkg/bootstrap functions with no body are true C externs
		// (defined in binate_runtime.c) and need C ABI for big-struct
		// returns (sret). Functions with bodies are pure-Binate and
		// use Binate ABI (struct return by value); marking them
		// IsCExtern would cause an ABI mismatch at the call site.
		if streq(alias, "bootstrap") && d.Body == nil { ef.IsCExtern = true }
		mod.AddFunc(ef)
	}

	// Every package has a compiler-generated `_Package() @reflect.Package`
	// accessor (Phase B / codegen's emit_pkg_descriptor.bn).  It is not
	// declared in the .bni, so register it here as an imported extern: a
	// cross-package `pkg._Package()` call then resolves (lookupFuncResults)
	// and codegen emits the matching `declare`; the imported package's own
	// compile emits the body.
	var reflectPkgTy @types.Type
	if currentChecker != nil {
		reflectPkgTy = currentChecker.PackageType("pkg/builtins/reflect", "Package")
	}
	if reflectPkgTy != nil {
		var pkgQual @[]char = buildQualName(alias, "_Package")
		var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
		pkgResults[0] = types.MakeManagedPtrType(reflectPkgTy)
		var pkgSig FuncSig
		pkgSig.Name = pkgQual
		pkgSig.Results = pkgResults
		moduleFuncs = slices.Append[FuncSig](moduleFuncs, pkgSig)
		var pkgNoParams @[]@Param
		mod.AddFunc(NewExternFunc(pkgQual, pkgNoParams, pkgResults))
	}

	// Register constants
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			if d.Value != nil {
				var qualName @[]char = buildQualName(alias, d.Name)
				var mc ModuleConst
				mc.Name = qualName
				if d.TypeRef != nil {
					mc.Typ = resolveTypeExpr(d.TypeRef)
				}
				if d.Value.Kind == ast.EXPR_STRING_LIT {
					mc.StrVal = unescapeStr(d.Value.Name)
					mc.Kind = CONST_STR
					moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
				} else if d.Value.Kind == ast.EXPR_BOOL_LIT {
					mc.BoolVal = boolLitValue(d.Value)
					mc.Kind = CONST_BOOL
					moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
				} else {
					var fltText @[]char
					var isFlt bool
					fltText, isFlt = floatConstText(d.Value)
					if isFlt {
						mc.FltText = fltText
						mc.Kind = CONST_FLT
						moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
					} else {
						var v int
						var ok bool
						v, ok = evalConstExpr(d.Value, 0)
						if ok {
							mc.Val = v
							moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
						}
					}
				}
			}
		}
		if d.Kind == ast.DECL_GROUP {
			registerImportConstGroup(alias, d)
		}
	}
}

// registerImportConstGroup registers a group of iota constants from an imported package.
func registerImportConstGroup(alias *[]readonly char, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Resolve the group's type (if any)
	var groupTyp @types.Type = nil
	if len(d.Decls) > 0 && d.Decls[0].TypeRef != nil {
		groupTyp = resolveTypeExpr(d.Decls[0].TypeRef)
	}
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			var qualName @[]char = buildQualName(alias, cd.Name)
			var mc ModuleConst
			mc.Name = qualName
			if cd.Value != nil {
				if !classifyConstLit(&mc, cd.Value) {
					var v int
					var ok bool
					v, ok = evalConstExpr(cd.Value, iotaVal)
					if ok {
						mc.Val = v
					} else {
						mc.Val = iotaVal
					}
				}
			} else {
				mc.Val = iotaVal
			}
			if cd.TypeRef != nil {
				mc.Typ = resolveTypeExpr(cd.TypeRef)
			} else {
				mc.Typ = groupTyp
			}
			moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
