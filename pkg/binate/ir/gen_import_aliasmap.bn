package "pkg/binate/ir"

import "pkg/binate/ast"

// pushFileImports snapshots the alias map and overlays file's own
// imports (alias=shortName(path), path=path) so the file's type and
// interface refs resolve via THAT FILE'S aliases — not whichever
// alias happened to win the global first-wins dedup across broadly-
// loaded packages.  Each file's imports unambiguously bind aliases
// within that file by source-level constraint; the map collision
// only arises from CONFLATING different files' aliases.  Pop with
// popFileImports.
func pushFileImports(m @Module, file @ast.File) AliasMapSnapshot {
	var snap AliasMapSnapshot
	snap.Names = m.ImportAliasNames
	snap.Paths = m.ImportAliasPaths
	if file == nil { return snap }
	for i := 0; i < len(file.Imports); i++ {
		var p @[]char = unquote(file.Imports[i].Path)
		// Use the import's explicit alias when present (`import a
		// "pkg/x"` is referred to as `a`, not the path's last segment);
		// otherwise the last segment is the implicit alias.
		var alias @[]char = file.Imports[i].Alias
		if len(alias) == 0 {
			alias = lastPathSegment(p)
		}
		RecordImportPath(m, alias, p)
	}
	return snap
}

// popFileImports restores the alias map from a pushFileImports
// snapshot.
func popFileImports(m @Module, snap AliasMapSnapshot) {
	m.ImportAliasNames = snap.Names
	m.ImportAliasPaths = snap.Paths
}

// SaveAliasMapState captures m's import-alias map (m.ImportAliasNames /
// m.ImportAliasPaths) into a snapshot without applying any overlay.  Paired
// with RestoreAliasMapState to bracket a temporary import overlay: the
// monomorphized generic-body emission in gen_generic.bn (a generic's defining-
// package imports overlay the consumer module's map while its body is gen'd)
// and the per-file overlay in overlayFileImports.
func SaveAliasMapState(m @Module) AliasMapSnapshot {
	var snap AliasMapSnapshot
	snap.Names = m.ImportAliasNames
	snap.Paths = m.ImportAliasPaths
	return snap
}

// RestoreAliasMapState writes back a snapshot from SaveAliasMapState over m's
// import-alias map.  Sibling of popFileImports but without the pop-by-snapshot
// file-imports overlay assumption — the generic-instantiation passes /
// overlayFileImports pair it with SaveAliasMapState to restore the map after a
// temporary overlay.
func RestoreAliasMapState(m @Module, snap AliasMapSnapshot) {
	m.ImportAliasNames = snap.Names
	m.ImportAliasPaths = snap.Paths
}
