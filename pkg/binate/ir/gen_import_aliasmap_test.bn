package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// TestAliasMapSaveRestoreRoundTrip covers SaveAliasMapState / RestoreAliasMapState:
// a Save captures the current alias map, a later RecordImportPath grows it (via a
// fresh slice, leaving the snapshot's slice intact), and a Restore rewinds the map
// to exactly the saved state — the bracket the generic-body emission relies on.
func TestAliasMapSaveRestoreRoundTrip() testing.TestResult {
	var m @Module = NewModule("test")
	RecordImportPath(m, "a", "pkg/a")
	if len(m.ImportAliasNames) != 1 { return fail("setup: expected 1 alias") }
	var snap AliasMapSnapshot = SaveAliasMapState(m)
	RecordImportPath(m, "b", "pkg/b")
	if len(m.ImportAliasNames) != 2 { return fail("expected 2 aliases after adding b") }
	RestoreAliasMapState(m, snap)
	if len(m.ImportAliasNames) != 1 { return fail("restore should drop b") }
	if !streq(m.ImportAliasNames[0], "a") { return fail("restored alias should be a") }
	if len(m.ImportAliasPaths) != 1 || !streq(m.ImportAliasPaths[0], "pkg/a") {
		return fail("restored path should be pkg/a")
	}
	return ""
}

// TestPushPopFileImportsRoundTrip covers pushFileImports / popFileImports: pushing a
// file's imports overlays its aliases (the implicit alias is the path's last
// segment) onto the module's map, and popping with the returned snapshot restores
// the prior map exactly.
func TestPushPopFileImportsRoundTrip() testing.TestResult {
	var p @parser.Parser = parser.New(strToBytes("package \"test\"\nimport \"pkg/foo/bar\"\n"), "test")
	var file @ast.File = p.ParseFile()
	var m @Module = NewModule("test")
	var snap AliasMapSnapshot = pushFileImports(m, file)
	if len(m.ImportAliasNames) != 1 { return fail("pushFileImports should overlay 1 alias") }
	if !streq(m.ImportAliasNames[0], "bar") {
		return fail("implicit alias should be last path segment")
	}
	if !streq(m.ImportAliasPaths[0], "pkg/foo/bar") { return fail("overlaid path wrong") }
	popFileImports(m, snap)
	if len(m.ImportAliasNames) != 0 { return fail("popFileImports should restore the empty map") }
	return ""
}
