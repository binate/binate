package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Imported-const registration: reading the checker's stamp and folding an
// imported const group (including iota implicit-repeat) into ModuleConsts.
// Split out of gen_import.bn.

// importConstStampVal returns the signedness-aware folded value the checker
// stamped on an imported const's initializer (defineBniConst), read via
// gc.Mod.Checker.ExprType — so an imported `Q uint64 = U / D` (U >= 2^63) reads
// the UNSIGNED 4, not the host-int evalConstExpr re-fold's signed -4.  ok=false
// when there's no stamp (a bare iota member, an un-stamped form, or no checker);
// the caller then folds via evalConstExpr.
func importConstStampVal(gc @GenCtx, e @ast.Expr) (int64, bool) {
	if gc.Mod.Checker == nil || e == nil || e.ResolvedTypeID == 0 {
		return 0, false
	}
	var st @types.Type = gc.Mod.Checker.ExprType(e.ResolvedTypeID)
	if st != nil && st.IsConstStamp && st.HasLitVal {
		// int64-exact (bignumToInt), so an imported 64-bit const keeps its value.
		return bignumToInt(st.LitMag, st.LitSign), true
	}
	return 0, false
}

// importConstUntypedTyp returns the concrete IR type an UNTYPED imported const
// must carry so a reference's int->float cast picks the right conversion on EVERY
// backend, or nil to leave it untyped.  A nil mc.Typ defaults to TypUntypedInt at
// the read site, which the two backends disagree on for a high-bit-set value:
// LLVM's isUnsigned = !Signed reads it UNSIGNED (uitofp), the VM/native predicate
// (Kind==TYP_INT && !Signed) reads it SIGNED.  So, mirroring the in-package
// genConst / genConstGroup stamp and keyed off the checker's LitSign (NOT the
// int64 bit pattern, which can't tell a negative from a >= 2^63 magnitude):
//   - a NEGATIVE magnitude -> signed (TypInt in-int32, TypInt64 larger), else LLVM
//     uitofp reads it as a huge POSITIVE float;
//   - a non-negative magnitude >= 2^63 -> unsigned TypUint64, else the VM/native
//     backends sign-convert it to a huge NEGATIVE float;
//   - a non-negative value in-int32 -> nil (both conversions agree).
func importConstUntypedTyp(gc @GenCtx, e @ast.Expr) @types.Type {
	if gc.Mod.Checker == nil || e == nil || e.ResolvedTypeID == 0 {
		return nil
	}
	var st @types.Type = gc.Mod.Checker.ExprType(e.ResolvedTypeID)
	if st == nil || !st.IsConstStamp || !st.HasLitVal {
		return nil
	}
	var v int64 = bignumToInt(st.LitMag, st.LitSign)
	if st.LitSign && st.LitMag != cast(uint64, 0) {
		if v >= -2147483648 {
			return types.TypInt()
		}
		return types.TypInt64()
	}
	if !st.LitSign && v < 0 {
		return types.TypUint64()
	}
	return nil
}

// registerImportConstGroup registers a group of iota constants from an imported package.
func registerImportConstGroup(gc @GenCtx, alias *[]readonly char, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	var prevExpr @ast.Expr = nil
	// Resolve the group's type (if any)
	var groupTyp @types.Type = nil
	if len(d.Decls) > 0 && d.Decls[0].TypeRef != nil {
		groupTyp = resolveTypeExpr(gc, d.Decls[0].TypeRef)
	}
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			var qualName @[]char = buildQualName(gc.Mod, alias, cd.Name)
			var mc irsym.ModuleConst
			mc.Name = qualName
			if cd.Value != nil {
				var sv int64
				var sok bool
				sv, sok = importConstStampVal(gc, cd.Value)
				if sok {
					mc.Val = sv
				} else if !classifyConstLit(&mc, cd.Value) &&
						!classifyConstBoolExpr(gc, &mc, cd.Value, iotaVal) &&
						!classifyConstFloatExpr(gc, &mc, cd.Value, iotaVal) {
					var v int
					var ok bool
					v, ok = evalConstExpr(gc, cd.Value, iotaVal)
					if ok {
						mc.Val = cast(int64, v)
					} else {
						mc.Val = cast(int64, iotaVal)
					}
				}
			} else if prevExpr != nil {
				// Bare implicit-repeat member: re-fold the previous explicit
				// member's initializer at THIS iota.  Its stamp holds the
				// OWNER's iota value, so skip importConstStampVal and re-fold —
				// matching the checker's bni_scope.bn export so an importer sees
				// `1 << iota` repeated, not the bare iota ordinal.
				if !classifyConstLit(&mc, prevExpr) && !classifyConstBoolExpr(gc, &mc, prevExpr, iotaVal) &&
						!classifyConstFloatExpr(gc, &mc, prevExpr, iotaVal) {
					var v int
					var ok bool
					v, ok = evalConstExpr(gc, prevExpr, iotaVal)
					if ok {
						mc.Val = cast(int64, v)
					} else {
						mc.Val = cast(int64, iotaVal)
					}
				}
			} else {
				mc.Val = cast(int64, iotaVal)
			}
			if cd.Value != nil {
				prevExpr = cd.Value
			}
			if cd.TypeRef != nil {
				mc.Typ = resolveTypeExpr(gc, cd.TypeRef)
			} else {
				mc.Typ = groupTyp
			}
			// prevExpr is now this member's value-defining expression (its own for
			// an explicit member, the owner's for a bare repeat) — stamp an untyped
			// negative / >= 2^63 member's concrete type, as the single-const path does.
			if mc.Typ == nil {
				mc.Typ = importConstUntypedTyp(gc, prevExpr)
			}
			gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
