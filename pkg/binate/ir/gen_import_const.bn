package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Imported-const registration: reading the checker's stamp and folding an
// imported const group (including iota implicit-repeat) into ModuleConsts.
// Split out of gen_import.bn.

// importConstStampVal returns the signedness-aware folded value the checker
// stamped on an imported const's initializer (defineBniConst), read via
// gc.Mod.Checker.ExprType — so an imported `Q uint64 = U / D` (U >= 2^63) reads
// the UNSIGNED 4, not the host-int evalConstExpr re-fold's signed -4.  ok=false
// when there's no stamp (a bare iota member, an un-stamped form, or no checker);
// the caller then folds via evalConstExpr.
func importConstStampVal(gc @GenCtx, e @ast.Expr) (int, bool) {
	if gc.Mod.Checker == nil || e == nil || e.ResolvedTypeID == 0 {
		return 0, false
	}
	var st @types.Type = gc.Mod.Checker.ExprType(e.ResolvedTypeID)
	if st != nil && st.IsConstStamp && st.HasLitVal {
		return cast(int, bignumToInt(st.LitMag, st.LitSign)), true
	}
	return 0, false
}

// registerImportConstGroup registers a group of iota constants from an imported package.
func registerImportConstGroup(gc @GenCtx, alias *[]readonly char, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	var prevExpr @ast.Expr = nil
	// Resolve the group's type (if any)
	var groupTyp @types.Type = nil
	if len(d.Decls) > 0 && d.Decls[0].TypeRef != nil {
		groupTyp = resolveTypeExpr(gc, d.Decls[0].TypeRef)
	}
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			var qualName @[]char = buildQualName(gc.Mod, alias, cd.Name)
			var mc ModuleConst
			mc.Name = qualName
			if cd.Value != nil {
				var sv int
				var sok bool
				sv, sok = importConstStampVal(gc, cd.Value)
				if sok {
					mc.Val = sv
				} else if !classifyConstLit(&mc, cd.Value) &&
						!classifyConstBoolExpr(gc, &mc, cd.Value, iotaVal) &&
						!classifyConstFloatExpr(gc, &mc, cd.Value, iotaVal) {
					var v int
					var ok bool
					v, ok = evalConstExpr(gc, cd.Value, iotaVal)
					if ok {
						mc.Val = v
					} else {
						mc.Val = iotaVal
					}
				}
			} else if prevExpr != nil {
				// Bare implicit-repeat member: re-fold the previous explicit
				// member's initializer at THIS iota.  Its stamp holds the
				// OWNER's iota value, so skip importConstStampVal and re-fold —
				// matching the checker's bni_scope.bn export so an importer sees
				// `1 << iota` repeated, not the bare iota ordinal.
				if !classifyConstLit(&mc, prevExpr) &&
						!classifyConstBoolExpr(gc, &mc, prevExpr, iotaVal) &&
						!classifyConstFloatExpr(gc, &mc, prevExpr, iotaVal) {
					var v int
					var ok bool
					v, ok = evalConstExpr(gc, prevExpr, iotaVal)
					if ok {
						mc.Val = v
					} else {
						mc.Val = iotaVal
					}
				}
			} else {
				mc.Val = iotaVal
			}
			if cd.Value != nil {
				prevExpr = cd.Value
			}
			if cd.TypeRef != nil {
				mc.Typ = resolveTypeExpr(gc, cd.TypeRef)
			} else {
				mc.Typ = groupTyp
			}
			gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
