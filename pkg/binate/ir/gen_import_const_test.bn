package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_import_const.bn (registerImportConstGroup): imported iota
// const groups, including the `1<<iota` implicit-repeat case.  strToBytes lives
// in ir_test.bn (same package).

func TestRegisterImportsIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/binate/token\"\nconst (\n")
	cb.Write("\tEOF int = iota\n\tIDENT\n")
	cb.Write("\tINT\n\tSTRING\n)\n")
	cb.Write("func Name(t int) *[]readonly char\n")
	var src @[]char = buf.CopyStr(cb.String())
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "token.bni")
	var file @ast.File = p.ParseFile()

	var aliases @[]@[]char = @[]@[]char{"token"}
	var paths @[]@[]char = @[]@[]char{"pkg/binate/token"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImports(aliases, paths, files, NewGenCtx(m))
	var gc @GenCtx = NewGenCtx(m)

	var ev int
	var ef bool
	ev, _, ef = lookupConst(gc, "pkg/binate/token.EOF")
	if !ef || ev != 0 { return fail("expected EOF=0") }

	var iv int
	var iff bool
	iv, _, iff = lookupConst(gc, "pkg/binate/token.IDENT")
	if !iff || iv != 1 { return fail("expected IDENT=1") }

	var nv int
	var nf bool
	nv, _, nf = lookupConst(gc, "pkg/binate/token.INT")
	if !nf || nv != 2 { return fail("expected INT=2") }

	var sv int
	var sf bool
	sv, _, sf = lookupConst(gc, "pkg/binate/token.STRING")
	if !sf || sv != 3 { return fail("expected STRING=3") }
	return ""
}

// TestRegisterImportsShiftIotaConsts pins the cross-package implicit-repeat
// fix where it actually bit: a `1 << iota` group whose bare members must REPEAT
// the shift (1, 2, 4, 8), not collapse to the bare iota ordinal (0, 1, 2, 3).
// The plain `= iota` group above can't distinguish the bug (ordinal == value).
func TestRegisterImportsShiftIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/binate/flags\"\nconst (\n")
	cb.Write("\tF0 int = 1 << iota\n\tF1\n")
	cb.Write("\tF2\n\tF3\n)\n")
	cb.Write("func Name(t int) *[]readonly char\n")
	var src @[]char = buf.CopyStr(cb.String())
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "flags.bni")
	var file @ast.File = p.ParseFile()

	var aliases @[]@[]char = @[]@[]char{"flags"}
	var paths @[]@[]char = @[]@[]char{"pkg/binate/flags"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImports(aliases, paths, files, NewGenCtx(m))
	var gc @GenCtx = NewGenCtx(m)

	var v0 int
	var f0 bool
	v0, _, f0 = lookupConst(gc, "pkg/binate/flags.F0")
	if !f0 || v0 != 1 { return fail("expected F0=1 (1<<0)") }

	var v1 int
	var f1 bool
	v1, _, f1 = lookupConst(gc, "pkg/binate/flags.F1")
	if !f1 || v1 != 2 { return fail("expected F1=2 (1<<1), not the iota ordinal 1") }

	var v2 int
	var f2 bool
	v2, _, f2 = lookupConst(gc, "pkg/binate/flags.F2")
	if !f2 || v2 != 4 { return fail("expected F2=4 (1<<2), not the iota ordinal 2") }

	var v3 int
	var f3 bool
	v3, _, f3 = lookupConst(gc, "pkg/binate/flags.F3")
	if !f3 || v3 != 8 { return fail("expected F3=8 (1<<3), not the iota ordinal 3") }
	return ""
}
