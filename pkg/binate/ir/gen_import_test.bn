package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

func TestRegisterImportsIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"pkg/binate/token\"\nconst (\n")
	cb = cb.WriteStr("\tEOF int = iota\n\tIDENT\n")
	cb = cb.WriteStr("\tINT\n\tSTRING\n)\n")
	cb = cb.WriteStr("func Name(t int) *[]readonly char\n")
	var src @[]char = cb.Bytes()
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "token.bni")
	var file @ast.File = p.ParseFile()

	var aliases @[]@[]char = @[]@[]char{"token"}
	var paths @[]@[]char = @[]@[]char{"pkg/binate/token"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImports(aliases, paths, files, m)

	var ev int
	var et @types.Type
	var ef bool
	ev, et, ef = lookupConst("pkg/binate/token.EOF")
	if !ef || ev != 0 { return fail("expected EOF=0") }

	var iv int
	var it @types.Type
	var iff bool
	iv, it, iff = lookupConst("pkg/binate/token.IDENT")
	if !iff || iv != 1 { return fail("expected IDENT=1") }

	var nv int
	var nt @types.Type
	var nf bool
	nv, nt, nf = lookupConst("pkg/binate/token.INT")
	if !nf || nv != 2 { return fail("expected INT=2") }

	var sv int
	var st @types.Type
	var sf bool
	sv, st, sf = lookupConst("pkg/binate/token.STRING")
	if !sf || sv != 3 { return fail("expected STRING=3") }
	return ""
}

// qualifiedReflectPackageType must give the synthetic `_Package()`
// descriptor's reflect.Package result type a PATH-QUALIFIED struct name, so
// codegen mangles it to the reflect package's own symbol
// (bn_pkg__builtins__reflect__Package) rather than the CONSUMING module's
// prefix.  currentChecker.PackageType returns the reflect scope's type with
// a BARE struct name ("Package"); used verbatim it mangles as
// `bn_<consuming-pkg>__Package` and collides (first-wins struct-def dedup)
// with any same-named struct the compiling module defines — notably
// pkg/binate/loader's own 5-field `type Package`, whose def then takes the
// 1-field reflect shape and an out-of-range field GEP (the bni build break).
func TestQualifiedReflectPackageTypeQualifiesName() testing.TestResult {
	// Mimic what PackageType returns for reflect.Package: a TYP_NAMED whose
	// underlying is a one-field struct carrying the BARE name "Package".
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Name"
	f0.Type = types.MakeSliceType(types.TypChar())
	fields[0] = f0
	var underlying @types.Type = types.MakeStructType("Package", fields)
	var named @types.Type = types.MakeNamedType("Package")
	named.Underlying = underlying

	var got @types.Type = qualifiedReflectPackageType(named)
	if got.Kind != types.TYP_STRUCT {
		return fail("qualifiedReflectPackageType must return a TYP_STRUCT")
	}
	if !charsEqual(got.Name, "pkg/builtins/reflect.Package") {
		return fail("must carry the path-qualified name `pkg/builtins/reflect.Package`")
	}
	if len(got.Fields) != 1 {
		return fail("must preserve the canonical reflect.Package fields")
	}
	return ""
}

// Defensive: a bare TYP_STRUCT input (no TYP_NAMED wrapper) is still
// qualified — the helper must not depend on the wrapper being present.
func TestQualifiedReflectPackageTypeFromBareStruct() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Name"
	f0.Type = types.MakeSliceType(types.TypChar())
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Package", fields)

	var got @types.Type = qualifiedReflectPackageType(st)
	if !charsEqual(got.Name, "pkg/builtins/reflect.Package") {
		return fail("bare-struct input must also be path-qualified")
	}
	return ""
}
