package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

func TestRegisterImportsIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"pkg/binate/token\"\nconst (\n")
	cb.Write("\tEOF int = iota\n\tIDENT\n")
	cb.Write("\tINT\n\tSTRING\n)\n")
	cb.Write("func Name(t int) *[]readonly char\n")
	var src @[]char = buf.CopyStr(cb.String())
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "token.bni")
	var file @ast.File = p.ParseFile()

	var aliases @[]@[]char = @[]@[]char{"token"}
	var paths @[]@[]char = @[]@[]char{"pkg/binate/token"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImports(aliases, paths, files, NewGenCtx(m))
	var gc @GenCtx = NewGenCtx(m)

	var ev int
	var et @types.Type
	var ef bool
	ev, et, ef = lookupConst(gc, "pkg/binate/token.EOF")
	if !ef || ev != 0 { return fail("expected EOF=0") }

	var iv int
	var it @types.Type
	var iff bool
	iv, it, iff = lookupConst(gc, "pkg/binate/token.IDENT")
	if !iff || iv != 1 { return fail("expected IDENT=1") }

	var nv int
	var nt @types.Type
	var nf bool
	nv, nt, nf = lookupConst(gc, "pkg/binate/token.INT")
	if !nf || nv != 2 { return fail("expected INT=2") }

	var sv int
	var st @types.Type
	var sf bool
	sv, st, sf = lookupConst(gc, "pkg/binate/token.STRING")
	if !sf || sv != 3 { return fail("expected STRING=3") }
	return ""
}

// reflect.Package's struct name is now path-qualified by the checker
// (Option B step 3), so the IR uses the checker's PackageType type
// directly for the synthetic `_Package()` descriptor — no rebuild helper.
// The qualified-name behavior is covered end-to-end by conformance 525 /
// 532 (reflect package descriptor + accessor).

// registerImportFieldsAndFuncs registers an imported package's compiler-
// synthesized `_Package()` accessor only when the module's Checker is set
// (it needs reflect.Package's type via reflectPackageStructType).  This pins
// the BEFORE/AFTER ordering inc 4 introduced: a driver MUST set m.Checker
// before import registration, or a cross-package `pkg._Package()` call
// silently fails to resolve.  (A cmd/bnc test-runner regression that shipped
// in inc 4 was exactly a missing pre-registration m.Checker assignment.)
func TestImportPackageAccessorRequiresChecker() testing.TestResult {
	// Minimal pkg/builtins/reflect so the checker's
	// PackageType("pkg/builtins/reflect", "Package") resolves.
	var rp @parser.Parser = parser.NewInterface(strToBytes(
		"package \"pkg/builtins/reflect\"\ntype Package struct { Name int }\n"),
		"reflect.bni")
	var reflectFile @ast.File = rp.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.LoadPackageInterface("pkg/builtins/reflect", reflectFile)

	// The imported package whose _Package accessor we probe for.
	var ip @parser.Parser = parser.NewInterface(strToBytes(
		"package \"pkg/foo\"\nfunc Bar()\n"), "foo.bni")
	var fooFile @ast.File = ip.ParseFile()
	var aliases @[]@[]char = @[]@[]char{"foo"}
	var paths @[]@[]char = @[]@[]char{"pkg/foo"}

	// Nil Checker → _Package accessor is NOT registered (the skip branch).
	var m1 @Module = InitModule("\"main\"")
	m1.Checker = nil
	var files1 @[]@ast.File = make_slice(@ast.File, 1)
	files1[0] = fooFile
	RegisterImports(aliases, paths, files1, NewGenCtx(m1))
	if lookupFuncExists(NewGenCtx(m1), "pkg/foo._Package") {
		return fail("nil checker: imported _Package must NOT be registered")
	}

	// Checker set (reflect loaded) → _Package accessor IS registered.
	var m2 @Module = InitModule("\"main\"")
	m2.Checker = c
	var files2 @[]@ast.File = make_slice(@ast.File, 1)
	files2[0] = fooFile
	RegisterImports(aliases, paths, files2, NewGenCtx(m2))
	if !lookupFuncExists(NewGenCtx(m2), "pkg/foo._Package") {
		return fail("checker set: imported _Package must be registered")
	}
	return ""
}
