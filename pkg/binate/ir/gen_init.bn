package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Synthetic per-package init function generation.  When a package
// has any top-level `var x T = expr` decls with non-nil
// initializers, IR-gen emits a `<pkg>.__init` function whose body
// runs each `x = expr` assignment in source declaration order.
// The driver (cmd/bni for VM mode, an init dispatcher for
// compiled mode) is responsible for calling it before main.
//
// Without this, top-level `var x int = 42` silently zero-inits
// because the VM/compiled-mode lowering path doesn't consume the
// `mg.Init` field that IR-gen previously stored — it only ever
// captured int literals anyway.  Routing initializers through
// genAssign (via a synthetic stmt list) gets the full expression
// evaluator for free.

// initFuncName returns the qualified name of the per-package init
// function for the current module-gen context.  Always
// `<gc.PkgPath>.__init`.
func initFuncName(gc @GenCtx) @[]char {
	return qualifyForCurrentModule(gc, "__init")
}

// hasInitDecls reports whether `decls` (typically file.Decls)
// contains at least one `var x T = expr` with a non-nil
// initializer expression — i.e., whether emitting an init
// function for the package is worth the work.
func hasInitDecls(decls *[]@ast.Decl) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_VAR { continue }
		if d.Value == nil { continue }
		if isBlankName(d.Name) { continue }
		return true
	}
	return false
}

// isBlankName returns true for the blank identifier `_`.
// Blank-named vars don't bind into scope, so their initializer
// has no addressable target — skip them.
func isBlankName(name *[]readonly char) bool {
	return len(name) == 1 && name[0] == cast(char, 95)  // '_'
}

// buildInitBody walks `decls` and produces a stmt list of
// `<name> = <value>` assignments, one per global with a non-nil
// initializer.  When `order` is non-empty (the checker's dependency
// order — see types.VarInitOrder / plan-var-init-dependency-order.md),
// the assignments are emitted in that order, so each initializer's
// package-var dependencies run first regardless of filename/source
// position.  An empty `order` falls back to source order, which still
// gives intra-file ordering for `var b int = a + 1` after
// `var a int = 5`.
//
// The emit is defensive: after emitting the ordered names, any init-var
// NOT named in `order` is appended in source order.  A well-formed order
// lists exactly the init-var set, so this only fires if the checker and
// IR-gen ever disagree on that set — and then it emits the initializer
// rather than silently dropping it (a lost init is a miscompile; a
// mis-ordered one is at worst a zero-value read).
func buildInitBody(decls *[]@ast.Decl, order @[]@[]char) @[]@ast.Stmt {
	var stmts @[]@ast.Stmt
	var emitted @[]@[]char
	for i := 0; i < len(order); i++ {
		if nameInInitList(emitted, order[i]) { continue }
		var d @ast.Decl = findInitVarDecl(decls, order[i])
		if d == nil { continue }
		stmts = slices.Append[@ast.Stmt](stmts, MakeInitAssignStmt(d))
		emitted = slices.Append[@[]char](emitted, order[i])
	}
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_VAR { continue }
		if d.Value == nil { continue }
		if isBlankName(d.Name) { continue }
		if nameInInitList(emitted, d.Name) { continue }
		stmts = slices.Append[@ast.Stmt](stmts, MakeInitAssignStmt(d))
	}
	return stmts
}

// findInitVarDecl returns the top-level init-var decl named `name` in
// `decls` (Kind DECL_VAR, non-nil Value, non-blank), or nil.  Matches the
// init-var predicate the checker's dependency-order pass uses, so the
// ordered names resolve to exactly the emitted set.
func findInitVarDecl(decls *[]@ast.Decl, name @[]char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_VAR { continue }
		if d.Value == nil { continue }
		if isBlankName(d.Name) { continue }
		if streq(d.Name, name) { return d }
	}
	return nil
}

// nameInInitList reports whether `name` is present in `list`.
func nameInInitList(list @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], name) { return true }
	}
	return false
}

// MakeInitAssignStmt builds an `<d.Name> = <d.Value>` assignment
// statement.  Single-LHS, single-RHS, plain `=` (not `:=` or any
// op-assign).  Public so the REPL can build a one-shot synthetic
// to run a freshly-declared global's initializer right after
// registering it.
func MakeInitAssignStmt(d @ast.Decl) @ast.Stmt {
	var lhs @ast.Expr = make(ast.Expr)
	lhs.Kind = ast.EXPR_IDENT
	lhs.Name = d.Name
	lhs.Pos = d.Pos
	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_ASSIGN
	s.Pos = d.Pos
	s.Op = cast(int, token.ASSIGN)
	s.Exprs = slices.Append[@ast.Expr](s.Exprs, lhs)
	s.Exprs2 = slices.Append[@ast.Expr](s.Exprs2, d.Value)
	return s
}

// generatePackageInit emits a `<pkg>.__init` function for the
// module if `decls` has any non-trivial var initializers, and
// adds it to `m`.  No-op (returns without touching `m`) when
// there are no initializers — empty inits aren't worth a
// round-trip through the call cache.
//
// Caller must have set up Module.GlobalVars etc. via the surrounding
// GeneratePackage / GenModule pass — the synthetic body's
// identifier lookups go through the global path.
func generatePackageInit(gc @GenCtx, decls *[]@ast.Decl, m @Module) {
	if !hasInitDecls(decls) { return }
	// The checker records a dependency order for the package's top-level
	// init-vars (empty when < 2 init-vars or on the REPL path); buildInitBody
	// falls back to source order for an empty order.  Nil-safe: a module built
	// without a Checker (some unit tests) emits in source order.
	var order @[]@[]char
	if m.Checker != nil {
		order = m.Checker.VarInitOrder(gc.PkgPath)
	}
	var body @[]@ast.Stmt = buildInitBody(decls, order)
	// Use buf.CopyStr so the synthetic Decl owns its name slice.
	var name @[]char = "__init"
	var f @Func = GenSyntheticFunc(gc, name, body)
	// Register the init's qualified name in Module.FuncSigs so any
	// caller lowered later (e.g. the compiled-mode init
	// dispatcher) can resolve it the usual way.
	var sig FuncSig
	sig.Name = initFuncName(gc)
	var emptyParams @[]@types.Type
	var emptyResults @[]@types.Type
	sig.Params = emptyParams
	sig.Results = emptyResults
	setOrAppendFuncSig(gc, sig)
	m.AddFunc(f)
}

// EmitInitDispatcher emits a synthetic `<m_pkg>.__init_all`
// function into `m` that calls each package's init in order.
// `packageInitNames` is the list of qualified `<pkg>.__init`
// names to invoke (typically built by cmd/bnc from its
// dependency-walk loop, ending with the main package's own
// `<main>.__init` if present).
//
// Always emits the function — even with an empty list — so the
// entry wrapper (`<m_pkg>.__entry`, see EmitMainEntry) can call
// it unconditionally without a runtime existence check.
//
// The dispatcher's qualified name is `<m.PkgPath>.__init_all` (m.PkgPath
// is set on the module being generated by GeneratePackage / GenModule).
func (m @Module) EmitInitDispatcher(packageInitNames @[]@[]char) {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = qualifyForPkgPath(m.PkgPath, "__init_all")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)
	var entry @Block = AddBlock(f, "entry")
	var emptyArgs @[]@Instr
	// Register each `<pkg>.__init` as an extern in this module so
	// codegen emits a `declare void @bn_F...()` line (the package init function).
	// Without this, clang errors with "use of undefined value" on
	// the call below — the synthetic init names aren't in any
	// source `import` and so RegisterImport doesn't pick them up.
	// Skip the calling module's own `<m_pkg>.__init` (it's defined
	// locally; declaring it as extern would conflict).
	var ownInit @[]char = qualifyForPkgPath(m.PkgPath, "__init")
	for i := 0; i < len(packageInitNames); i++ {
		if !streq(packageInitNames[i], ownInit) {
			var ef @Func = NewExternFunc(m.PkgPath, packageInitNames[i],
				emptyParams, emptyResults)
			m.AddFunc(ef)
		}
		// Pass through QualifyName: each name already includes
		// the package prefix, so no re-qualification happens.
		entry.EmitCall(packageInitNames[i],
			emptyArgs, types.TypVoid())
	}
	var noVals @[]@Instr
	entry.EmitReturn(noVals)
	m.AddFunc(f)
}

// EmitMainEntry emits a synthetic `<m_pkg>.__entry` function
// that runs `<m_pkg>.__init_all()` and then calls
// `main.main()`.  Mangler routes the qualified name
// `main.__entry` to the linker symbol `bn_entry` — the C
// runtime's sole entry point into Binate, which keeps all
// entry-time semantics (init, eventually panic / signal setup)
// inside Binate behind one stable symbol.
//
// Caller (cmd/bnc on the main package) must have already
// emitted the init dispatcher via EmitInitDispatcher; the body
// here calls it unconditionally.
func (m @Module) EmitMainEntry() {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = qualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)
	var entry @Block = AddBlock(f, "entry")
	var emptyArgs @[]@Instr
	entry.EmitCall(qualifyForPkgPath(m.PkgPath, "__init_all"),
		emptyArgs, types.TypVoid())
	entry.EmitCall("main.main", emptyArgs, types.TypVoid())
	var noVals @[]@Instr
	entry.EmitReturn(noVals)
	m.AddFunc(f)
}

// HasMainFunc reports whether this module defines the program entry point —
// the func `main.main` that EmitMainEntry's `__entry` wrapper calls.  A program
// with no entry can't be caught per-package at COMPILE time (Binate compiles
// one package at a time, and any package may be compiled independently), so
// program-assembly drivers call this on the main module and reject a missing
// entry (§17.3.1).  The `--test` runner synthesizes its own `func main`, so
// this holds for it too.
//
// The check is the LITERAL `main.main` — exactly the symbol EmitMainEntry
// emits a call to — not `qualifyForPkgPath(m.PkgPath, "main")`: a program whose
// entry package is (wrongly) not named "main" would otherwise define
// `<pkg>.main` and pass this check while `__entry` still calls the undefined
// `main.main`, trading a clean rejection for a raw link error.
func (m @Module) HasMainFunc() bool {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, "main.main") { return true }
	}
	return false
}

// IsMainPackage reports whether this module's package is named "main" — the
// name a program's entry package must have (§17.3 `prog.main.package`).  A
// program assembled from a differently-named entry package defines
// `<pkg>.main`, but EmitMainEntry calls the literal `main.main`, so
// program-assembly drivers reject a non-"main" entry package with a message
// naming the real cause (rather than the less-precise "no main function").
func (m @Module) IsMainPackage() bool {
	return streq(m.PkgPath, "main")
}


// HasPackageInit reports whether `m` contains a `<m_pkg>.__init`
// function (one was emitted by generatePackageInit).  Used by
// drivers that need to decide whether to include the package in
// the dispatcher's call list.
func (m @Module) HasPackageInit() bool {
	var initName @[]char = qualifyForPkgPath(m.PkgPath, "__init")
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, initName) { return true }
	}
	return false
}


// PackageInitName returns the qualified name `<pkg>.__init` for the
// given package.  Helper for drivers building the dispatcher's call
// list.  pkg may be a short name or a full path — QualifyName
// short-names it internally (full-path migration — see pkg/binate/mangle).
func PackageInitName(pkg @[]char) @[]char {
	return mangle.QualifyName(pkg, "__init")
}
