package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the synthetic var-init / dispatcher / entry-wrapper
// generators in gen_init.bn.

// ============================================================
// Per-package init function (generatePackageInit)
// ============================================================

// TestGeneratePackageEmitsInit verifies that a package with at
// least one `var x T = expr` decl gets a synthetic `<pkg>.__init`
// function added to its module.
func TestGeneratePackageEmitsInit() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var x int = 42\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if !hasFuncNamed(m, "test.__init") {
		return fail("expected synthetic test.__init in module Funcs")
	}
	return ""
}

// TestGeneratePackageSkipsInitWhenNoneNeeded verifies that a
// package without any initialized var decls does NOT get a
// synthetic init (saves a no-op call cycle).
func TestGeneratePackageSkipsInitWhenNoneNeeded() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var x int\n")            // no initializer
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if hasFuncNamed(m, "test.__init") {
		return fail("expected NO synthetic test.__init when no initializers")
	}
	return ""
}

// A blank-identifier package var (`var _ = expr`) runs its initializer for
// side effects — so it DOES produce a synthetic __init — but binds no name, so
// it gets no global storage slot (two `_` slots would collide on one mangled
// symbol).
func TestGeneratePackageInitEmitsBlank() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var _ int = 42\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	if !hasFuncNamed(m, "test.__init") {
		return fail("blank-init should produce a synthetic test.__init (side effects)")
	}
	for i := 0; i < len(m.GlobalVars); i++ {
		if isBlankName(m.GlobalVars[i].Name) {
			return fail("blank var must not get a global storage slot")
		}
	}
	return ""
}

// ============================================================
// HasPackageInit / PackageInitName helpers
// ============================================================

func TestHasPackageInitTrue() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var x int = 1\n")
	cb.Write("func main() {}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if !m.HasPackageInit() {
		return fail("HasPackageInit should be true when init was emitted")
	}
	return ""
}

func TestHasPackageInitFalse() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {}\n")
	var m @Module = genFromSource(buf.CopyStr(cb.String()))
	if m.HasPackageInit() {
		return fail("HasPackageInit should be false when no init emitted")
	}
	return ""
}

func TestPackageInitName() testing.TestResult {
	if !seq(PackageInitName("foo"), "foo.__init") {
		return fail("expected foo.__init")
	}
	return ""
}

// ============================================================
// EmitInitDispatcher
// ============================================================

// TestEmitInitDispatcherEmpty verifies that the dispatcher is
// emitted even with no packages — the entry wrapper calls it
// unconditionally, so it must always exist.
func TestEmitInitDispatcherEmpty() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	m.PkgPath = "main"
	var noNames @[]@[]char
	m.EmitInitDispatcher(noNames)
	if !hasFuncNamed(m, "main.__init_all") {
		return fail("expected main.__init_all even with empty list")
	}
	return ""
}

// TestEmitInitDispatcherCallsAllInOrder verifies that the
// dispatcher emits one OP_CALL per name in order.
func TestEmitInitDispatcherCallsAllInOrder() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	m.PkgPath = "main"
	var names @[]@[]char
	names = appendCharSliceLocal(names, "foo.__init")
	names = appendCharSliceLocal(names, "bar.__init")
	m.EmitInitDispatcher(names)
	var f @Func = lookupFunc(m, "main.__init_all")
	if f == nil { return fail("dispatcher not found") }
	if len(f.Blocks) == 0 { return fail("dispatcher has no blocks") }
	var entry @Block = f.Blocks[0]
	// Two OP_CALL instructions, in order, then OP_RETURN.
	var calls @[]@[]char
	for i := 0; i < len(entry.Instrs); i++ {
		var instr @Instr = entry.Instrs[i]
		if instr.Op == iropcode.OP_CALL {
			calls = appendCharSliceLocal(calls, instr.StrVal)
		}
	}
	if len(calls) != 2 {
		return fail("expected 2 iropcode.OP_CALL in dispatcher")
	}
	if !seq(calls[0], "foo.__init") {
		return fail("first call should be foo.__init")
	}
	if !seq(calls[1], "bar.__init") {
		return fail("second call should be bar.__init")
	}
	return ""
}

// ============================================================
// EmitMainEntry
// ============================================================

// TestEmitMainEntry verifies the wrapper's body calls
// `<m_pkg>.__init_all` first and `main.main` second, in that
// order — and that it lives under the qualified name
// `main.__entry` so the mangler routes it to `bn_entry`.
func TestEmitMainEntry() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	m.PkgPath = "main"
	m.EmitMainEntry()
	var f @Func = lookupFunc(m, "main.__entry")
	if f == nil { return fail("main.__entry not emitted") }
	if len(f.Blocks) == 0 { return fail("entry has no blocks") }
	var entry @Block = f.Blocks[0]
	var calls @[]@[]char
	for i := 0; i < len(entry.Instrs); i++ {
		var instr @Instr = entry.Instrs[i]
		if instr.Op == iropcode.OP_CALL {
			calls = appendCharSliceLocal(calls, instr.StrVal)
		}
	}
	if len(calls) != 2 {
		return fail("expected 2 iropcode.OP_CALL in entry wrapper")
	}
	if !seq(calls[0], "main.__init_all") {
		return fail("first call should be main.__init_all")
	}
	if !seq(calls[1], "main.main") {
		return fail("second call should be main.main")
	}
	return ""
}

// ============================================================
// MakeInitAssignStmt — direct coverage
// ============================================================

// TestMakeInitAssignStmt verifies the public REPL helper that
// builds `<name> = <value>` for a one-shot synthetic.  Asserts
// the AST shape: STMT_ASSIGN with single LHS / RHS, plain
// `=` op (token.ASSIGN), and the LHS is an EXPR_IDENT carrying
// the decl's name.  generatePackageInit's tests exercise this
// indirectly through buildInitBody; this pins the exact AST
// the REPL one-shot path constructs.
func TestMakeInitAssignStmt() testing.TestResult {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = ast.EXPR_INT_LIT
	v.Name = "42"
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = "x"
	d.Value = v

	var s @ast.Stmt = MakeInitAssignStmt(d)
	if s == nil { return fail("MakeInitAssignStmt returned nil") }
	if s.Kind != ast.STMT_ASSIGN { return fail("wrong stmt kind") }
	if s.Op != cast(int, token.ASSIGN) { return fail("wrong op") }
	if len(s.Exprs) != 1 || len(s.Exprs2) != 1 {
		return fail("expected 1 LHS + 1 RHS")
	}
	if s.Exprs[0].Kind != ast.EXPR_IDENT {
		return fail("LHS must be an ident")
	}
	if !seq(s.Exprs[0].Name, "x") {
		return fail("LHS ident must be the var's name")
	}
	if s.Exprs2[0] != v {
		return fail("RHS must be the original Value expr")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

func hasFuncNamed(m @Module, name *[]readonly char) bool {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, name) { return true }
	}
	return false
}

func lookupFunc(m @Module, name *[]readonly char) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

func appendCharSliceLocal(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
