package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the iv-dispatch receiver-thunk pass
// (plan-primitives-impl-interfaces.md § "Interface-value
// dispatch and value receivers"): a value-receiver method
// gets a synthesized `*readonly T` → load → call wrapper that
// vtable slots point at, so iv dispatch's pointer-shape ABI
// matches the called function.

// nameLooksLikeMethod recognizes the
// `<pkgShort>.<TypeName>.<MethodName>` shape.
func TestNameLooksLikeMethodTrue() testing.TestResult {
	if !nameLooksLikeMethod("test.Counter.Inc") {
		return fail("expected method shape to be recognized")
	}
	return ""
}

// Free function names (single dot) are NOT treated as methods.
func TestNameLooksLikeMethodFreeFunc() testing.TestResult {
	if nameLooksLikeMethod("test.helper") {
		return fail("free func name should not look like a method")
	}
	return ""
}

// Names with no dots aren't methods either.
func TestNameLooksLikeMethodBare() testing.TestResult {
	if nameLooksLikeMethod("bare") {
		return fail("unqualified name should not look like a method")
	}
	return ""
}

// thunkNameForMethod inserts the `__bn_thunk_` prefix before
// the final dot-separated component.
func TestThunkNameForMethod() testing.TestResult {
	var name @[]char = thunkNameForMethod("pkg/builtins/lang.int.String")
	if !seq(name, "pkg/builtins/lang.int.__bn_thunk_String") {
		return fail("thunk name format unexpected")
	}
	return ""
}

// needsRecvThunk: positive — value-receiver method.
func TestNeedsRecvThunkValueReceiver() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Counter struct { n int }\n"
			"func (c Counter) Get() int { return c.n }\n"
	var m @Module = genFromSource(src)
	var f @Func = LookupModuleFunc(m, "test.Counter.Get")
	if f == nil { return fail("expected test.Counter.Get in m.Funcs") }
	if !needsRecvThunk(f) {
		return fail("value-receiver method should need a thunk")
	}
	return ""
}

// needsRecvThunk: negative — pointer-receiver method.
func TestNeedsRecvThunkPointerReceiver() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Counter struct { n int }\n"
			"func (c *Counter) Inc() { c.n = c.n + 1 }\n"
	var m @Module = genFromSource(src)
	var f @Func = LookupModuleFunc(m, "test.Counter.Inc")
	if f == nil { return fail("expected test.Counter.Inc in m.Funcs") }
	if needsRecvThunk(f) {
		return fail("pointer-receiver method should NOT need a thunk")
	}
	return ""
}

// needsRecvThunk: negative — managed-pointer-receiver method.
func TestNeedsRecvThunkManagedReceiver() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Counter struct { n int }\n"
			"func (c @Counter) GetMgd() int { return c.n }\n"
	var m @Module = genFromSource(src)
	var f @Func = LookupModuleFunc(m, "test.Counter.GetMgd")
	if f == nil { return fail("expected test.Counter.GetMgd in m.Funcs") }
	if needsRecvThunk(f) {
		return fail("managed-receiver method should NOT need a thunk")
	}
	return ""
}

// needsRecvThunk: negative — free function (single dot in name).
func TestNeedsRecvThunkFreeFunction() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Counter struct { n int }\n"
			"func helper(c Counter) int { return c.n }\n"
	var m @Module = genFromSource(src)
	var f @Func = LookupModuleFunc(m, "test.helper")
	if f == nil { return fail("expected test.helper in m.Funcs") }
	if needsRecvThunk(f) {
		return fail("free function should NOT get a thunk")
	}
	return ""
}

// generateIvDispatchThunks adds a thunk to m.Funcs for each
// value-receiver method.
func TestGenerateIvDispatchThunksAddsThunk() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { Get() int }\n"
			"type Counter struct { n int }\n"
			"func (c Counter) Get() int { return c.n }\n"
			"impl Counter : I\n"
	var m @Module = genFromSource(src)
	var thunk @Func = LookupModuleFunc(m, "test.Counter.__bn_thunk_Get")
	if thunk == nil {
		return fail("expected test.Counter.__bn_thunk_Get in m.Funcs")
	}
	if len(thunk.Params) == 0 {
		return fail("thunk should have at least one param")
	}
	if thunk.Params[0].Typ == nil || thunk.Params[0].Typ.Kind != types.TYP_POINTER {
		return fail("thunk's first param should be a pointer")
	}
	return ""
}

// LookupVtableSlotName returns the thunk's name when one
// exists, otherwise returns the input unchanged.
func TestLookupVtableSlotNameValueReceiver() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { Get() int }\n"
			"type Counter struct { n int }\n"
			"func (c Counter) Get() int { return c.n }\n"
			"impl Counter : I\n"
	var m @Module = genFromSource(src)
	var slot @[]char = LookupVtableSlotName(m, "test.Counter.Get")
	if !seq(slot, "test.Counter.__bn_thunk_Get") {
		return fail("slot name should resolve to thunk")
	}
	return ""
}

func TestLookupVtableSlotNamePointerReceiver() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { Inc() }\n"
			"type Counter struct { n int }\n"
			"func (c *Counter) Inc() { c.n = c.n + 1 }\n"
			"impl *Counter : I\n"
	var m @Module = genFromSource(src)
	var slot @[]char = LookupVtableSlotName(m, "test.Counter.Inc")
	if !seq(slot, "test.Counter.Inc") {
		return fail("slot name should resolve to original")
	}
	return ""
}

// LookupModuleFunc returns nil for misses.
func TestLookupModuleFuncMiss() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	if LookupModuleFunc(m, "no.such.func") != nil {
		return fail("expected nil for missing name")
	}
	return ""
}
