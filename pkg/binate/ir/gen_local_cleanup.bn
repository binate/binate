package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Whole-function managed-local cleanup — the RefDec sequence a return (or a
// recoverable fault) emits over ALL of ctx.Vars — and the VM-only cleanup
// landing pad that reuses it.  The per-type
// RefDec emitters, the temp-list cleanup, and the scope-partial
// emitDecForScopeVars live in gen_util_refcount.bn.

// emitDecForManagedLocals emits cleanup for all managed locals.
// Axiom 2: always dtor. No skip for returned locals — the return
// path always RefInc's (axiom 3), so the dtor balances.
func emitDecForManagedLocals(ctx @GenContext, b @Block, retExprs *[]@ast.Expr) @Block {
	for i := 0; i < len(ctx.Vars); i++ {
		var slot VarSlot = ctx.Vars[i]
		// Peel IR-transparent wrappers like emitDecForScopeVars (see there): a
		// named-managed local must load and clean up via its underlying type.
		var st @types.Type = peelTransparent(slot.Typ)
		var needsCleanup bool = isManagedPtrType(st) || isManagedSliceType(st) ||
				isManagedIfaceValueType(st) || isManagedFuncValueType(st) || needsStructCopy(st)
		if !needsCleanup { continue }
		if isManagedPtrType(st) {
			var ptrVal @Instr = b.EmitLoad(slot.Ptr, st)
			emitManagedPtrRefDec(ctx.Func, b, ptrVal)
		}
		if isManagedSliceType(st) {
			var sliceVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedSliceRefDec(ctx.Func, b, sliceVal)
		}
		if isManagedIfaceValueType(st) {
			var ivVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedIfaceValueRefDec(ctx.Func, b, ivVal)
		}
		if isManagedFuncValueType(st) {
			var fvVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedFuncValueRefDec(ctx.Func, b, fvVal)
		}
		if needsStructCopy(st) {
			emitStructDtor(ctx.Func, b, slot.Ptr, st)
		}
	}
	return b
}

// emitPadCleanup emits, into pad block `p`, the RefDec cleanup for every managed
// value live at the current program point — all managed ctx.Vars locals plus all
// ctx.Temps temporaries — WITHOUT clearing either registry (the normal
// scope/statement cleanup still runs later).  This is exactly the cleanup an
// early return would emit here, packaged as a reusable fault landing pad.  A
// managed slice / iface-value / func-value RefDec can BRANCH into new blocks, so
// this runs under ctx.Func.PadEmitMode = true, which routes AddBlock into
// Func.FaultPads — keeping every pad block off Func.Blocks so the compiled
// backends never see them.  Returns the pad's EXIT block (where the caller
// appends EmitUnwindReturn).
func emitPadCleanup(ctx @GenContext, p @Block) @Block {
	// noRet = nil: on a FAULT (unlike a return) no value has been produced, so
	// every managed local is still live and must be RefDec'd — emitDecForManagedLocals
	// already RefDecs the whole ctx.Vars (Axiom 2), so passing no return exprs is
	// exactly right (there are no returned locals to skip).
	var noRet *[]@ast.Expr
	// PadEmitMode is set ONLY here and reset unconditionally below; it does NOT
	// nest, because pad cleanup emits only RefDec / dtor-call / null-guard-branch
	// ops — none of which is a faulting op, so none re-enters attachFaultPad ->
	// emitPadCleanup.  Any block a branching RefDec creates during this window
	// (AddBlock -> AddFaultPad) therefore stays in Func.FaultPads.
	ctx.Func.PadEmitMode = true
	p = emitDecForManagedLocals(ctx, p, noRet)
	p = emitTempRefDecs(ctx, p)
	ctx.Func.PadEmitMode = false
	return p
}

// attachFaultPad tags the block's most-recently-emitted (faulting) instruction
// with a fresh VM-only cleanup landing pad that RefDecs the live managed set at
// this point, so a recoverable VM fault at that op unwinds without leaking.
// Only the VM consumes it (Instr.PadBlock -> VMFunc.FaultTable); the compiled
// backends stay fatal and never see the pad.  Call right after a guard emit
// (EmitBoundsCheck, ...).
func attachFaultPad(ctx @GenContext, b @Block) {
	if len(b.Instrs) == 0 { return }
	var faultOp @Instr = b.Instrs[len(b.Instrs) - 1]
	var entry @Block = AddFaultPad(ctx.Func, "fault_pad")
	var padExit @Block = emitPadCleanup(ctx, entry)
	padExit.EmitUnwindReturn()
	faultOp.PadBlock = entry
}

// isProvablyNonNil reports whether ptr's defining IR op yields a value that is
// unconditionally non-nil, so an OP_NIL_CHECK before a deref of it can be elided
// (elision (a), "non-nil by construction").  Only ops
// whose result is non-nil REGARDLESS of their operands qualify — a fresh
// allocation: OP_ALLOC (a stack-slot address) or OP_BOX / OP_MAKE / OP_MAKE_SLICE
// (heap).  Base-relative address ops (OP_GET_FIELD_PTR / OP_GET_ELEM_PTR —
// `base ± offset`) are deliberately NOT included: they are non-nil only when
// their base is, which the dominating-check dedup (elision (b), a later
// increment) captures precisely.  Elision is purely an optimization — an
// un-elided check of a non-nil pointer simply passes at run time — so a
// conservative predicate here is always safe.
func isProvablyNonNil(ptr @Instr) bool {
	if ptr == nil { return false }
	if ptr.Op == iropcode.OP_ALLOC { return true }
	if ptr.Op == iropcode.OP_BOX { return true }
	if ptr.Op == iropcode.OP_MAKE { return true }
	if ptr.Op == iropcode.OP_MAKE_SLICE { return true }
	return false
}

// emitNilCheckIfEnabled emits an OP_NIL_CHECK on ptr, tagged with a recoverable
// cleanup pad, immediately before a deref of ptr — but ONLY when nil-checking is
// enabled for this compilation (ctx.Gc.EmitNilChecks) and ptr is not already
// provably non-nil (isProvablyNonNil).  With the flag off it is a no-op, so the
// emitted IR is byte-for-byte the pre-feature form.  Call right before the
// load / store that derefs ptr, on the current block: it appends the check (and
// pad) to b and does NOT change ctx.CurBlock, so the caller's following deref
// still lands in b.
func emitNilCheckIfEnabled(ctx @GenContext, b @Block, ptr @Instr) {
	if !ctx.Gc.EmitNilChecks { return }
	if isProvablyNonNil(ptr) { return }
	// Intra-block dedup (N2d): if this pointer's source has already been
	// established non-nil in this block (and nothing since could have reassigned
	// it — addInstr clears the set on any store/call/dtor), skip the redundant
	// check.  `p.x + p.y` thus emits one OP_NIL_CHECK, not two.  A negative key is
	// the shared void/global-ref sentinel (-1) — NOT a unique source id — so it
	// never dedups and never pollutes the set (distinct globals must each check).
	var key int = nilDedupKey(ptr)
	if key >= 0 && intSliceContains(b.NilCheckedSlots, key) { return }
	b.EmitNilCheck(ptr)
	attachFaultPad(ctx, b)
	if key >= 0 {
		b.NilCheckedSlots = slices.Append[int](b.NilCheckedSlots, key)
	}
}

// nilDedupKey returns the intra-block dedup key for a pointer being nil-checked
// (N2d): for a LOAD, the SOURCE address/slot's SSA id — so two loads of the same
// variable (`p.x` then `p.y`) share a key and the second check is elided; for any
// other value, the value's own SSA id (a reused SSA pointer value).  Keying on the
// load SOURCE rather than the (fresh each access) loaded value is what makes the
// common `p.x + p.y` redundancy dedup; addInstr invalidates the key on any store
// to that slot, so a reassigned `p` correctly re-checks.
func nilDedupKey(ptr @Instr) int {
	// Key on the load's SOURCE only when that source is a genuine, STABLE slot —
	// an OP_ALLOC (a local / param / global-address pseudo).  Two loads of the
	// same variable (`p.x`, `p.y`) then share the alloca's id and the second check
	// is elided.  Crucially, if the source is any OTHER value — e.g. a call result
	// in `**f()`, where the checked pointer `f()` is ALSO the inner load's source —
	// keying on the source id would collide `f()`'s key (checked as a value) with
	// `*f()`'s (an INDEPENDENT pointer) and wrongly elide the inner check.  Those
	// non-alloca-sourced loads key on the load's OWN id, so each is checked.
	// The `ID >= 0` guard is essential: a global-variable address is synthesized
	// as an OP_ALLOC pseudo with the SHARED void sentinel id -1 (not a unique
	// per-variable id), so keying on it would collide DISTINCT globals (`g1.x`,
	// `g2.x`).  Requiring a real (non-negative, monotonically-unique) alloca id
	// restricts source-keying to genuine local/param slots; globals fall through
	// to the load's own unique id (no dedup, but no false collision).
	if ptr.Op == iropcode.OP_LOAD && len(ptr.Args) > 0 && ptr.Args[0] != nil &&
			ptr.Args[0].Op == iropcode.OP_ALLOC && ptr.Args[0].ID >= 0 {
		return ptr.Args[0].ID
	}
	return ptr.ID
}

// intSliceContains reports whether v is in s.
func intSliceContains(s *[]readonly int, v int) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == v { return true }
	}
	return false
}

// emitDerefNilCheck is emitNilCheckIfEnabled gated on `forDeref` — the caller's
// signal that the pointer being followed WILL be dereferenced (a load/store
// through it), not merely address-computed.  Address-of a field/element
// (`&p.field`, `&p[i]`) computes `base + offset` WITHOUT touching memory, so
// per the "deref only" design it must NOT fault on a nil
// base; the address-of callers pass forDeref=false.  Deref callers (reads,
// stores, `(*p)++`, method receivers via a load) pass true.  A pointer FOLLOWED
// to continue a chain (`p.a.b` loads `p.a` to reach `.b`) is always a deref, so
// genSelectorPtr's recursion passes true regardless of the outermost context.
func emitDerefNilCheck(ctx @GenContext, b @Block, ptr @Instr, forDeref bool) {
	if !forDeref { return }
	emitNilCheckIfEnabled(ctx, b, ptr)
}
