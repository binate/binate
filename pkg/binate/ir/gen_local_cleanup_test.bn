package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_local_cleanup.bn.  noParams / noResults / fail are shared ir
// test helpers.  The populated (real live-set) pad case is covered end-to-end by
// pkg/binate/vm's lower_fault_pad_test.bn (source -> IR-gen -> lowering).

// emitDecForManagedLocals over a scope with no managed locals emits nothing and
// returns the same block — the whole-function cleanup a return (or a fault pad)
// runs is a no-op when there is nothing managed to release.
func TestEmitDecForManagedLocalsEmptyIsNoop() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var noRet *[]@ast.Expr
	var out @Block = emitDecForManagedLocals(ctx, b, noRet)
	if out != b {
		return fail("no-locals cleanup should return the same block")
	}
	if len(b.Instrs) != 0 {
		return fail("no-locals cleanup should emit nothing")
	}
	return ""
}

// attachFaultPad tags the block's last instruction with a VM-only cleanup pad
// (in Func.FaultPads, NOT Func.Blocks) terminated by OP_UNWIND_RETURN.
func TestAttachFaultPadCreatesTaggedPad() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var idx @Instr = b.EmitConstInt(0, types.TypInt())
	var ln @Instr = b.EmitConstInt(1, types.TypInt())
	b.EmitBoundsCheck(idx, ln)
	var beforeBlocks int = len(f.Blocks)

	attachFaultPad(ctx, b)

	if len(f.FaultPads) != 1 {
		return fail("attachFaultPad should create exactly one FaultPad block")
	}
	if len(f.Blocks) != beforeBlocks {
		return fail("the pad must NOT be appended to Func.Blocks")
	}
	var pad @Block = f.FaultPads[0]
	if len(pad.Instrs) == 0 {
		return fail("the pad should carry instructions")
	}
	var last @Instr = pad.Instrs[len(pad.Instrs) - 1]
	if last.Op != iropcode.OP_UNWIND_RETURN {
		return fail("the pad must end with OP_UNWIND_RETURN")
	}
	// The tagged (bounds-check) op carries the pad entry as its PadBlock.
	var chk @Instr = b.Instrs[len(b.Instrs) - 1]
	if chk.PadBlock == nil {
		return fail("the faulting op should be tagged with its pad block")
	}
	// PadEmitMode must be reset after emitPadCleanup so later blocks route normally.
	if f.PadEmitMode {
		return fail("PadEmitMode must be reset after attachFaultPad")
	}
	return ""
}
