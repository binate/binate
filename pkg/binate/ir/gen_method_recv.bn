package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"

// applyReceiverConversion converts the receiver Instr to match the
// method's declared receiver type when the type checker accepted a
// smoothing case. Conversions:
//
//   src *T or @T,  dst T (value)        → load (deref to value)
//   src T (value), dst *T               → take the address of the receiver's
//                                         storage (an addressable lvalue: an
//                                         ident's slot, a field selector, an
//                                         indexed element); temp only for a
//                                         non-addressable receiver.
//   src @T,        dst *T               → reinterpret (both i8*)
//   matching shapes                     → identity (no op)
//
// Other combinations either match exactly (no conversion needed) or
// were rejected by the type checker (e.g., `*T → @T` is never allowed).
func applyReceiverConversion(ctx @GenContext, b @Block, recv @Instr, dstTyp @types.Type,
		srcExpr @ast.Expr) @Instr {
	if recv == nil || recv.Typ == nil || dstTyp == nil {
		return recv
	}
	var srcTyp @types.Type = recv.Typ

	// Identity: same kind, same base name. (Const wrappers are
	// transparent at this layer.)  Checked on the UN-peeled type so a method on
	// the named pointer itself (`func (p PS) m()`, dstTyp == PS) still matches and
	// passes recv through.
	if recvShapeMatches(srcTyp, dstTyp) {
		return recv
	}

	// Classify the conversion arms below off the PEELED source shape: a
	// named-distinct pointer (`type PS *S`) is TYP_NAMED, so an un-peeled Kind
	// check would miss the pointer->value load AND `isNamedTypeKind(PS)` (true for
	// any TYP_NAMED) would wrongly take the value->pointer arm — passing the raw
	// pointer as a value receiver (garbage) for `(*ps).m()`.
	var psrc @types.Type = peelTransparent(srcTyp)
	if psrc == nil { psrc = srcTyp }

	// src is a pointer/managed-pointer, dst is a value (or named-struct
	// value): load (deref) the pointed-to struct.
	if psrc.Kind == types.TYP_POINTER || psrc.Kind == types.TYP_MANAGED_PTR {
		if isNamedTypeKind(dstTyp) {
			return b.EmitLoad(recv, dstTyp)
		}
	}

	// src is a value (named struct), dst is a raw pointer: pass the ADDRESS of
	// the receiver's storage so the callee's mutations through the pointer land
	// on the caller's object.  genSelectorPtr yields that address for an
	// ident's own slot or a field selector such as the nested-cursor field
	// `sc.tc` — exactly as an assignment target is addressed; genIndexPtr yields
	// it for a bare slice/array element `arr[i]` (which genSelectorPtr covers
	// only under a further selector, `arr[i].f`).  Copying into a temp instead
	// would silently drop the callee's writes: a `*Cursor` receiver's Next()
	// that advances `it.i` would never advance `sc.tc.i`, so an iteration over a
	// projecting cursor loops forever.  A non-addressable receiver (a call
	// result, arithmetic) has no storage — both helpers return nil — so
	// materialize a temp there: the callee still gets a valid pointer, and
	// writes to a temporary are moot anyway.
	if isNamedTypeKind(srcTyp) && psrc.Kind != types.TYP_POINTER &&
			psrc.Kind != types.TYP_MANAGED_PTR && dstTyp.Kind == types.TYP_POINTER {
		if srcExpr != nil {
			// Taking the receiver's ADDRESS to pass to a pointer-receiver method
			// (`&recv`) — address-of, not a deref here, so forDeref=false; the
			// method derefs the receiver internally (checked there if enabled).
			var addr @Instr = genSelectorPtr(ctx, b, srcExpr, false)
			b = ctx.CurBlock
			if addr == nil && srcExpr.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
				// Receiver ADDRESS (see the genSelectorPtr call above) => forDeref=false.
				addr = genIndexPtr(ctx, b, srcExpr, false)
				b = ctx.CurBlock
			}
			if addr != nil {
				return addr
			}
		}
		var tmp @Instr = b.EmitAlloc(srcTyp)
		b.EmitStore(tmp, recv)
		return tmp
	}

	// src is @T (managed pointer), dst is *T (raw pointer): both lower
	// to i8* in LLVM, so this is a reinterpret. Set the IR-level type
	// so downstream passes see the expected pointer kind.
	if psrc.Kind == types.TYP_MANAGED_PTR && dstTyp.Kind == types.TYP_POINTER {
		recv.Typ = dstTyp
		return recv
	}

	return recv
}

// recvShapeMatches reports whether two types have the same receiver
// shape — same kind (value/pointer/managed) on the same base named
// type. Used as the "no conversion needed" fast path.
func recvShapeMatches(a @types.Type, b @types.Type) bool {
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if isNamedTypeKind(a) {
		return charsEqualOpt(a.Name, b.Name)
	}
	if a.Kind == types.TYP_POINTER || a.Kind == types.TYP_MANAGED_PTR {
		if a.Elem == nil || b.Elem == nil {
			return false
		}
		return isNamedTypeKind(a.Elem) && isNamedTypeKind(b.Elem) &&
				charsEqualOpt(a.Elem.Name, b.Elem.Name)
	}
	return false
}

// charsEqualOpt is a byte-equality check that accepts empty as no-match
// (avoids matching two unnamed anonymous types).
func charsEqualOpt(a @[]char, b @[]char) bool {
	if len(a) == 0 || len(b) == 0 {
		return false
	}
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// baseNamedTypeName returns the name of the base named type, walking
// one level through *T / @T wrappers (matching the type checker's
// auto-deref rule). Note that IR-gen represents named structs as
// TYP_STRUCT with Name set, not TYP_NAMED — distinct from the type
// checker's representation. Returns empty string if the type isn't a
// named type (or a wrapper around one).
func baseNamedTypeName(t @types.Type) @[]char {
	if t == nil {
		return ""
	}
	if isNamedTypeKind(t) && len(t.Name) > 0 {
		return t.Name
	}
	if isUniversePrimitive(t) && len(t.Name) > 0 {
		return primitiveQualifiedName(t.Name)
	}
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR {
		if t.Elem != nil && isNamedTypeKind(t.Elem) && len(t.Elem.Name) > 0 {
			return t.Elem.Name
		}
		if t.Elem != nil && isUniversePrimitive(t.Elem) && len(t.Elem.Name) > 0 {
			return primitiveQualifiedName(t.Elem.Name)
		}
	}
	return ""
}

// isNamedTypeKind reports whether t.Kind is one that carries a name
// (TYP_NAMED for distinct named types, TYP_STRUCT for named structs in
// IR-gen).
func isNamedTypeKind(t @types.Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == types.TYP_NAMED || t.Kind == types.TYP_STRUCT
}

// isUniversePrimitive reports whether t is a universe-scope
// primitive (int / float / bool family).  Used at call sites
// to recognize that the method's owning package is the
// stdlib carve-out (`pkg/builtins/lang`) rather than a regular user
// package; mirrors the type-checker's predicate.
func isUniversePrimitive(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_INT { return true }
	if t.Kind == types.TYP_FLOAT { return true }
	if t.Kind == types.TYP_BOOL { return true }
	return false
}

// primitiveQualifiedName returns the call-site name of a
// primitive, qualified with the carve-out package's full path.
// pkg/builtins/lang owns the canonical impls for primitives,
// so a method on `int`
// is mangled as `pkg/builtins/lang.int.<Method>` everywhere — this is what
// the call-site qualifier produces for a method on a value of
// primitive type, matching pkg/builtins/lang's own impl registration.
func primitiveQualifiedName(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("pkg/builtins/lang.")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}

// buildMethodQualName constructs the IR-level qualified method name.
// If typeName is already qualified (contains a dot — e.g.
// "pkg/binate/buf.CharBuf" for an imported type), use it as-is and just
// append the method name.  Otherwise (local type, e.g. "Point"),
// prepend the current module's full package path.
//
// pkg is the full package path.  Imported-type method calls carry
// the full-path-qualified type name (resolved via buildQualName), so
// the local-type definition prepends the same full path and the two
// agree on the IR function-table key.  See pkg/binate/mangle.
func buildMethodQualName(pkg @[]char, typeName @[]char, methodName *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	if typeNameIsQualified(typeName) {
		cb.Write(typeName)
	} else {
		cb.Write(pkg)
		cb.WriteByte('.')
		cb.Write(typeName)
	}
	cb.WriteByte('.')
	cb.Write(methodName)
	return buf.CopyStr(cb.String())
}

// typeNameIsQualified reports whether typeName contains a dot (i.e.,
// it's already qualified as "<pkg>.<Name>").
func typeNameIsQualified(typeName @[]char) bool {
	for i := 0; i < len(typeName); i++ {
		if typeName[i] == '.' {
			return true
		}
	}
	return false
}
