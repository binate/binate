package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// makeNamedTypeExpr is a tiny helper for building ast.TypeExpr in tests.
func makeNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

func makePointerTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_POINTER
	te.Base = base
	return te
}

func makeManagedTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_MANAGED
	te.Base = base
	return te
}

func makeConstTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_CONST
	te.Base = base
	return te
}

// charsEq compares two managed-char-slices for byte equality.
func charsEq(a @[]char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func TestRecvTypeNameValue() testing.TestResult {
	var te @ast.TypeExpr = makeNamedTypeExpr("Point")
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for value receiver"
	}
	return ""
}

func TestRecvTypeNamePointer() testing.TestResult {
	var te @ast.TypeExpr = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *Point receiver"
	}
	return ""
}

func TestRecvTypeNameManaged() testing.TestResult {
	var te @ast.TypeExpr = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	if !charsEq(recvTypeName(te), "Node") {
		return "expected 'Node' for @Node receiver"
	}
	return ""
}

func TestRecvTypeNameConstPointer() testing.TestResult {
	// *readonly Point: TEXPR_POINTER → TEXPR_CONST → TEXPR_NAMED
	var te @ast.TypeExpr = makePointerTypeExpr(makeConstTypeExpr(makeNamedTypeExpr("Point")))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *readonly Point receiver"
	}
	return ""
}

func TestMethodQualNamePointer() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Translate"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "p"
	pd.Type = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	d.Recv = pd
	if !charsEq(methodQualName("geom", d), "geom.Point.Translate") {
		return "expected 'geom.Point.Translate'"
	}
	return ""
}

// genMethod must carry the method declaration's Exported flag onto the
// lowered @Func.  Exported-ness (set by the loader's markBniExportedFuncs
// when the method appears in the package's .bni) is what puts a method into
// the package's reflect Functions table and force-emits its func-value
// triple; before this, genMethod built a fresh Decl without copying
// d.Exported, so every method was Exported=false and silently dropped from
// reflection (e.g. pkg/std/os.File.Write was missing until injected).
func TestGenMethodCarriesExported() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	d.Exported = true
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "c"
	pd.Type = makePointerTypeExpr(makeNamedTypeExpr("Counter"))
	d.Recv = pd

	var gc @GenCtx = NewGenCtx(NewModule("util"))
	var f @Func = genMethod(gc, nil, d, "util")
	if !f.Exported {
		return "exported method must carry d.Exported onto the lowered func"
	}

	// An unexported method (not in the .bni) stays unexported.
	d.Exported = false
	var f2 @Func = genMethod(gc, nil, d, "util")
	if f2.Exported {
		return "non-.bni method must stay unexported"
	}
	return ""
}

// genMethod flags a method whose receiver is a universe primitive
// (int/float/bool family) as IsPrimitiveMethod.  Those methods are reached by
// DIRECT call (`pkg/builtins/lang.int.String`), not a vtable, so once
// pkg/builtins/lang is injected native-only the flag is what lists them in the
// reflect Functions table + force-emits their func-value handle (mirroring
// IsStructDtor).  The flag is receiver-driven, not module-driven; only the lang
// carve-out declares primitive-receiver methods, so a regular user method (here
// a *Point pointer receiver, which resolves to a pointer type, never a
// primitive) must NOT be flagged.
func TestGenMethodFlagsPrimitiveReceiver() testing.TestResult {
	// Value receiver on `int` — a universe primitive → flagged.
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "String"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "x"
	pd.Type = makeNamedTypeExpr("int")
	d.Recv = pd

	var gc @GenCtx = NewGenCtx(NewModule("pkg/builtins/lang"))
	var f @Func = genMethod(gc, nil, d, "pkg/builtins/lang")
	if !f.IsPrimitiveMethod {
		return "a universe-primitive (int) value receiver must set IsPrimitiveMethod"
	}

	// Pointer receiver on a named type — a regular user method → not flagged.
	var d2 @ast.Decl = make(ast.Decl)
	d2.Kind = ast.DECL_FUNC
	d2.Name = "Translate"
	var pd2 @ast.ParamDecl = make(ast.ParamDecl)
	pd2.Name = "p"
	pd2.Type = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	d2.Recv = pd2

	var gc2 @GenCtx = NewGenCtx(NewModule("geom"))
	var f2 @Func = genMethod(gc2, nil, d2, "geom")
	if f2.IsPrimitiveMethod {
		return "a *Point (non-primitive) receiver must NOT set IsPrimitiveMethod"
	}
	return ""
}

func TestMethodQualNameValue() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "c"
	pd.Type = makeNamedTypeExpr("Counter")
	d.Recv = pd
	if !charsEq(methodQualName("util", d), "util.Counter.Get") {
		return "expected 'util.Counter.Get'"
	}
	return ""
}

func TestMethodQualNameManaged() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Val"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "n"
	pd.Type = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	d.Recv = pd
	if !charsEq(methodQualName("graph", d), "graph.Node.Val") {
		return "expected 'graph.Node.Val'"
	}
	return ""
}
