package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/stdx/slices"

// IR generation for method values `x.M` (B.4 of plan-function-
// values-phase-2.md).  A method value binds a specific receiver
// instance to a method: the result is a function value whose
// signature is the method's signature MINUS the receiver, and
// invoking the function value calls M(boundReceiver, args...).
//
// Mechanism: per (method, receiver-shape) we synthesize a wrapper
// Func whose body forwards (receiver, user_args) to the
// underlying method.  The wrapper is marked IsClosure with one
// capture (the receiver) so the B.2 closure machinery — IR-gen
// alloca + store of the capture struct, OP_FUNC_VALUE-with-data,
// per-shape shim in each backend — does all the work.  No new
// backend code is needed; B.4 leverages B.2.
//
// B.4 status:
//   - Receiver kind T  + x type T  → capture T (works for any T).
//   - Receiver kind *T + x type *T → capture *T.
//   - Receiver kind @T (managed)   → gated to B.3 (CAP_MANAGED).
//   - Cross-kind smoothing (e.g. method takes *T, x is T) is not
//     yet supported — type-checker accepts only same-kind today.

// (The synthesized `T.M`-method-value wrapper dedup cache lives on
// @Module.MethodValueWrappers — a list of qualified wrapper names — so it's
// per-module rather than a package-global; see ir.bni.)

// isMethodValueSelector reports whether the EXPR_SELECTOR `e`
// resolves to a method value (B.4) rather than a struct field
// access or method expression.  Discriminators:
//   1. Resolved type must be a function-value type.
//   2. e.X must not be a recognized type name (that would be the
//      method-expression form T.M, handled separately).
//   3. e.X's type must have a METHOD named e.Name (not a field
//      of function-value type — fields take precedence, and the
//      type-checker has already routed that through the field
//      path).
func isMethodValueSelector(gc @GenCtx, c @types.Checker, e @ast.Expr) bool {
	if e == nil || c == nil { return false }
	if e.ResolvedTypeID == 0 { return false }
	var t @types.Type = c.ExprType(e.ResolvedTypeID)
	if t == nil { return false }
	if t.Kind != types.TYP_FUNC_VALUE && t.Kind != types.TYP_MANAGED_FUNC_VALUE {
		return false
	}
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		if lookupStructIdx(gc, e.X.Name) >= 0 {
			return false // T.M — method expression (struct receiver)
		}
		// A named-distinct scalar receiver (`type Celsius int`) isn't in
		// the struct registry; recognize `Celsius.M` as a method
		// EXPRESSION (not a bound value) by the method symbol's existence,
		// so it is not mis-routed to genMethodValue (null receiver data ->
		// SIGSEGV).  A real method VALUE `x.M` has e.X a VARIABLE, for
		// which no <pkg>.x.M method symbol exists.
		if lookupFuncExists(gc, buildMethodQualName(gc.PkgPath, e.X.Name, e.Name)) {
			return false // T.M — method expression (named-scalar receiver)
		}
	}
	// Check that e.X's type actually has a method named e.Name.
	// Without this guard, struct field access of a function-
	// value-typed field (e.g. `op.Fn` where Op has field Fn
	// *func(...) int) would mistakenly route here.
	if e.X == nil || e.X.ResolvedTypeID == 0 {
		return false
	}
	var xt @types.Type = c.ExprType(e.X.ResolvedTypeID)
	if xt == nil { return false }
	var recvBase @types.Type = xt.ReceiverBaseNamed()
	if recvBase == nil { return false }
	var m @types.Method = recvBase.LookupMethod(e.Name)
	if m == nil { return false }
	return true
}

// genMethodValue lowers `x.M` where M is a method on x's type.
// Returns the OP_FUNC_VALUE-with-data Instr that produces the
// 16-byte function value at runtime.
func genMethodValue(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Pull the receiver type from the type-checker's per-expr
	// registry — checker stored the receiver type at e.X's
	// ResolvedTypeID.
	var recvTyp @types.Type = nil
	if ctx.Checker != nil && e.X != nil && e.X.ResolvedTypeID != 0 {
		recvTyp = ctx.Checker.ExprType(e.X.ResolvedTypeID)
	}
	if recvTyp == nil {
		return b.EmitConstInt(0, types.TypInt())
	}

	// Locate the method.
	var recvBase @types.Type = recvTyp.ReceiverBaseNamed()
	if recvBase == nil {
		return b.EmitConstInt(0, types.TypInt())
	}
	var m @types.Method = recvBase.LookupMethod(e.Name)
	if m == nil || m.FuncType == nil {
		return b.EmitConstInt(0, types.TypInt())
	}

	// Compute the underlying method's qualified name in IR terms.  The method
	// symbol lives in the RECEIVER's DEFINING package, whose full path is carried
	// by the receiver's IR-gen type Name (buildQualName-resolved at the receiver's
	// declaration) — NOT by the checker's recvBase.Name, which is UNQUALIFIED
	// ("Box").  Using recvBase.Name made buildMethodQualName prepend ctx.Gc.PkgPath
	// (the importer, e.g. "main") → a reference to a nonexistent `main.Box.get`
	// symbol, a cross-package link failure.  Resolve the IR-gen receiver type
	// WITHOUT evaluating e.X (it is captured separately, once, by genCapturedRecv
	// below — a second genExpr here would double-evaluate a side-effecting
	// receiver).  A local receiver's name has no dot, so buildMethodQualName still
	// prepends this module's package, unchanged.
	var recvIRTyp @types.Type = methodValueRecvIRType(ctx, e.X)
	var recvTypeName @[]char = ""
	if recvIRTyp != nil {
		recvTypeName = baseNamedTypeName(recvIRTyp)
	}
	if len(recvTypeName) == 0 {
		recvTypeName = recvBase.Name
	}
	// A method VALUE on a generic instantiation references the monomorphized
	// method body just like a direct call — emit it now (a no-op otherwise) so
	// the wrapper's EmitCall below resolves to a defined symbol, not a dangling
	// one.  Mirrors genMethodCall / wrapAsIfaceValue: method bodies are emitted
	// lazily at every use site, not when the struct was laid out.
	ensureMethodsForInstName(ctx.Gc, recvTypeName)
	var methodQName @[]char = buildMethodQualName(
			ctx.Gc.PkgPath, recvTypeName, e.Name)

	// The closure struct holds the receiver in the form the
	// METHOD declares (not the form `e.X` was written as).  Per
	// plan-function-values-phase-2.md §"Method values x.M":
	//   * method takes `*T`, x is `T` → captured `*T = &x`
	//   * method takes `T`, x is `*T` or `@T` → captured `T` copy
	//   * method takes `@T`, x is `@T` → captured `@T` (RefInc'd)
	//   * etc.
	// `capturedTyp` is the captured form, computed below.  When it
	// differs from `recvTyp` (smoothing applies), `genCapturedRecv`
	// emits the appropriate address-of / deref at the construction
	// site.  Wrapper sig + closure-struct field + dedup key all
	// reflect the captured form, so two call sites with different
	// `e.X` types that smooth to the same captured form share one
	// wrapper.
	var capturedTyp @types.Type = m.FuncType.Params[0].Type

	// A NON-IDENT value receiver on a pointer-receiver method (`mk().M`,
	// `obj.f.M`, `arr[i].M` where the element is a value) has no stable address
	// to capture as `*T`: taking &(a temporary) would dangle past the closure
	// (the old code stored the VALUE into the `*T` slot as a wild pointer →
	// SIGSEGV).  Instead capture the value BY VALUE — a copy the closure owns —
	// and let the wrapper (synthMethodValueWrapper) alloca + address it for the
	// synchronous method call.  This mirrors applyReceiverConversion's non-ident
	// value→pointer path, i.e. the method-CALL semantics (`mk().M()` already
	// materializes a copy), so the method VALUE now matches.  An IDENT receiver
	// keeps the existing `&slot` capture (address the original local).
	if e.X != nil && e.X.Kind != ast.EXPR_IDENT && capturedTyp != nil &&
			capturedTyp.Kind == types.TYP_POINTER && capturedTyp.Elem != nil && recvTyp != nil &&
			recvTyp.Identical(capturedTyp.Elem) {
		// Capture ANY value receiver by value — register-returned OR sret
		// (> 16-byte, by-address), managed-field or not.  The closure store below
		// copies the receiver's bytes into the field (loading first if it arrived
		// as an aggregate alloca) and, for a struct with MANAGED fields, RefInc's
		// the copy's fields (emitStructCopy) so the closure owns its own reference
		// — balanced by the closure dtor's RefDec.  An sret call result is a
		// struct-typed value that EmitStore's aggregate lowering handles (LLVM
		// loads it and stores field-wise; native memcpys); the wrapper then
		// receives it as a byval param (see synthMethodValueWrapper's byval flag).
		capturedTyp = recvTyp
	}

	// For a generic-instantiation receiver, capturedTyp's base still carries the
	// checker's RAW name (`Box[int]`) — mangled into the closure struct / wrapper
	// sig it becomes an invalid LLVM identifier (`%bn_S..._Box[int]`).  Swap the
	// base for the IR-gen instantiated struct (`Box__bn_inst__int`, from the
	// receiver's IR-gen type), keeping the pointer/managed/value wrapper.  No-op
	// for a non-generic receiver.
	capturedTyp = remapCapturedBaseToIR(capturedTyp, recvIRTyp)

	// Synthesize (or reuse) the wrapper Func.  Dedup by (method,
	// captured-form) — two call sites with smoothing into the
	// same captured form reuse one wrapper.
	var wrapperName @[]char = methodValueWrapperName(
			methodQName, capturedTyp)
	var have bool = false
	for i := 0; i < len(ctx.Gc.Mod.MethodValueWrappers); i++ {
		if streq(ctx.Gc.Mod.MethodValueWrappers[i], wrapperName) {
			have = true
		}
	}
	if !have {
		synthMethodValueWrapper(ctx.Gc, wrapperName, methodQName, capturedTyp, m)
		ctx.Gc.Mod.MethodValueWrappers = slices.Append[@[]char](
				ctx.Gc.Mod.MethodValueWrappers, wrapperName)
	}

	// User-visible function-value type: method's params minus
	// the receiver.
	var userParams @[]@types.Param = make_slice(@types.Param, len(m.FuncType.Params) - 1)
	for i := 1; i < len(m.FuncType.Params); i++ {
		userParams[i - 1] = m.FuncType.Params[i]
	}
	var fnValTyp @types.Type = types.MakeFuncValueType(userParams, m.FuncType.Results)

	// At the selector site: allocate a closure struct {receiver},
	// store the evaluated receiver (possibly converted by
	// smoothing) into it, emit OP_FUNC_VALUE-with-data pointing
	// at the wrapper.  A managed captured form (@T, @[]T) is RefInc'd
	// before the store (emitCaptureRefInc, mirroring gen_func_lit's B.3a
	// flow); a by-value struct with MANAGED fields is stored then RefInc'd
	// in place (emitStructCopy); either way the closure owns its own
	// reference, and the closure struct + closure-local are registered for
	// cleanup so the synthesized struct-dtor RefDec's it at frame end.
	var closureStruct @types.Type = buildMethodValueClosureStruct(ctx.Gc.PkgPath, wrapperName,
			capturedTyp)
	var closurePtr @Instr = b.EmitAlloc(closureStruct)
	var recvVal @Instr = genCapturedRecv(ctx, b, e.X, recvTyp, capturedTyp)
	var fieldPtr @Instr = b.EmitGetFieldPtr(closurePtr, 0, capturedTyp)
	if needsStructCopy(capturedTyp) {
		// By-value capture of a struct with managed fields (949): copy the
		// bytes, then RefInc the copy's managed fields so the closure owns its
		// own reference (the closure dtor RefDec's them at frame end).  The
		// mkX() call-result temp is itself registered for end-of-statement
		// RefDec (registerManagedCallResult's needsStructCopy branch), so the
		// net effect is +1 ref for the closure — the same acquire discipline
		// emitStoreManagedSlot's isInit aggregate path uses for var-init.
		b.EmitStore(fieldPtr, recvVal)
		emitStructCopy(ctx.Func, b, fieldPtr, capturedTyp)
	} else {
		// A plain struct that arrived as an aggregate alloca (a
		// composite-literal temp, `Pt{...}.M`) must be LOADED to a value before
		// the store — EmitStore of the alloca POINTER would mistype the field
		// (`store %S %ptr`).  (A call-result / field value receiver arrives as a
		// struct-typed value (register or sret), so this is a no-op there.)  Mirrors gen_call's
		// isAggregateAllocToLoad arg path.
		if isAggregateAllocToLoad(recvVal, capturedTyp) {
			recvVal = b.EmitLoad(recvVal, capturedTyp)
		}
		emitCaptureRefInc(ctx, b, recvVal, capturedTyp)
		b.EmitStore(fieldPtr, recvVal)
	}
	if closureStruct.NeedsDestruction() {
		registerClosureStructForCleanup(ctx.Gc, closureStruct)
		// method-value wrappers are dedup'd by wrapper name,
		// so reuse the per-(method, recv-shape) wrapper name as
		// the local registration key — buffer reuse across the
		// same closure shape is fine because each call site has
		// its own alloca; only the dtor + ctx.Vars entry need to
		// be unique per call site, which the synthetic name
		// `__mv_local_<wrapperName>_<litCounter>` guarantees.
		var n int = ctx.Gc.FuncLitCounter
		ctx.Gc.FuncLitCounter = ctx.Gc.FuncLitCounter + 1
		registerMethodValueLocalForCleanup(ctx, closurePtr, closureStruct, n)
	}
	var fv @Instr = b.EmitFuncValueWithData(wrapperName, closurePtr, fnValTyp)
	noteSPGrowingResult(ctx, fv)
	return fv
}

// registerMethodValueLocalForCleanup is the method-value-site
// equivalent of `registerClosureLocalForCleanup` in gen_func_lit.bn:
// it registers the alloca'd method-value closure struct in the
// enclosing function's ctx.Vars so the standard frame-end
// emitDecForManagedLocals pass invokes the struct dtor on it.  The
// synthetic name `__mv_local_<n>` is per-gc.FuncLitCounter id so it's
// unique within the enclosing function (we share the counter with
// genFuncLit; values are namespaced by the `__mv_local_` prefix).
func registerMethodValueLocalForCleanup(ctx @GenContext, closurePtr @Instr,
		closureStruct @types.Type, n int) {
	var nameBuf @strings.Builder = strings.NewBuilder()
	nameBuf.Write("__mv_local_")
	nameBuf.Write(strconv.Itoa(n))
	defineVar(ctx, buf.CopyStr(nameBuf.String()), closurePtr, closureStruct)
}

// methodValueWrapperName builds a stable name for the per-(method,
// receiver-shape) wrapper.  Including the receiver-type discriminator
// lets the same method support multiple receiver-shape wrappers (e.g.
// both `c.Add` with c:Counter and `(&c).Add` with c:*Counter, once
// smoothing lands).
func methodValueWrapperName(methodQName @[]char, recvTyp @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(methodQName)
	cb.Write("__methodval_")
	cb.Write(receiverShapeTag(recvTyp))
	return buf.CopyStr(cb.String())
}

// receiverShapeTag returns a short tag distinguishing receiver
// shape — `v` for value, `p` for raw pointer, `m` for managed
// pointer.  Drives the per-(method, captured-form) wrapper
// dedup: two call sites whose smoothings settle on the same
// captured form share one wrapper.
func receiverShapeTag(t @types.Type) @[]char {
	if t == nil { return "v" }
	var rt @types.Type = t.ResolveAlias()
	if rt == nil { return "v" }
	if rt.Kind == types.TYP_POINTER { return "p" }
	if rt.Kind == types.TYP_MANAGED_PTR { return "m" }
	return "v"
}

// buildMethodValueClosureStruct synthesizes the closure struct
// type {receiver}.  IR-gen for closure-struct field offset uses
// the standard struct layout machinery, same as B.2.
//
// The struct Name has two hard requirements:
//   1. Dot- and slash-free.  generateDtors' Pass 2 splits a dot-bearing struct
//      Name on the FIRST dot and treats the prefix as a package path — so
//      "__closure_main.Counter.Sum__methodval_v" would be mis-classified as
//      cross-package (pkg "__closure_main" != modPkg "main"), declared extern,
//      and never defined here; and a raw '/' in an LLVM type name is malformed.
//   2. UNIQUE per distinct wrapper.  A cross-package wrapperName embeds the
//      receiver's package path, so an ad-hoc '/'+'.'→'_' char fold would ALIAS
//      distinct receiver types onto one struct symbol (`pkg/a/b.C` and
//      `pkg/a.b_C` both fold to `__closure_pkg_a_b_C_...`) → a differently-
//      shaped-struct collision at codegen (the exact cross-package symbol-
//      collision class the mangler otherwise prevents).
// Deriving the Name from the wrapper's length-prefix-MANGLED symbol
// (mangle.FuncName) satisfies both: the mangled form is a flat, dot/slash-free
// identifier whose length prefixes keep every segment boundary distinct, so it
// stays in the unqualified-local dtor regime AND never aliases.
func buildMethodValueClosureStruct(pkgPath @[]char, wrapperName @[]char,
		recvTyp @types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fld @types.Field = make(types.Field)
	fld.Name = "recv"
	fld.Type = recvTyp
	fields[0] = fld
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__closure_")
	cb.Write(mangle.FuncName(pkgPath, wrapperName))
	return types.MakeStructType(buf.CopyStr(cb.String()), fields)
}

// synthMethodValueWrapper hand-builds the wrapper Func.  Its
// params are [receiver, user_args...]; body is a single block
// that calls the underlying method with all params and returns
// the result.  Marked IsClosure so the B.2 closure machinery
// emits the per-shape shim in each backend.
func synthMethodValueWrapper(gc @GenCtx, wrapperName @[]char, methodQName @[]char,
		recvTyp @types.Type, m @types.Method) {
	var noResults @[]@types.Type
	var emptyParams @[]@Param
	var f @Func = NewFunc(gc.PkgPath, wrapperName, emptyParams, noResults)
	f.Line = 0 // synthetic

	// Receiver param + each user param.
	var params @[]@Param
	var recvParam @Param = NewParam(f, "recv", recvTyp)
	params = slices.Append[@Param](params, recvParam)
	for i := 1; i < len(m.FuncType.Params); i++ {
		var up @Param = NewParam(f, m.FuncType.Params[i].Name, m.FuncType.Params[i].Type)
		params = slices.Append[@Param](params, up)
	}
	f.Params = params
	f.Results = m.FuncType.Results
	if len(m.FuncType.Results) > 1 {
		f.MultiReturnType = makeMultiReturnStructType(m.FuncType.Results)
	}
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = buildMethodValueClosureStruct(gc.PkgPath, wrapperName, recvTyp)

	// Body: a single entry block with the forward call.  Mirror
	// genFunc's param-handling: alloca + store each param into a
	// slot so the VM's reg machinery (which expects param values
	// to land in regs[paramID] after the entry-block stores) sees
	// the same shape it sees for normal user-written functions.
	// Then load each slot to produce the arg Instrs for the
	// underlying call.
	var entry @Block = AddBlock(f, "entry")
	var paramSlots @[]@Instr = make_slice(@Instr, len(params))
	for i := 0; i < len(params); i++ {
		var slot @Instr = entry.EmitAlloc(params[i].Typ)
		slot.ParamIndex = i + 1
		var pr @Instr = make(Instr)
		pr.ID = params[i].ID
		pr.Typ = params[i].Typ
		pr.Op = iropcode.OP_CONST_INT // placeholder; emitters key off ID
		// A byval-eligible aggregate param (a > 16-byte struct receiver, e.g. an
		// sret-returned value receiver captured by value) arrives as a
		// `ptr byval(<T>)` at the LLVM IR level, so the store into its slot must
		// be a memcpy from that pointer — NOT a value store, which mistypes it
		// (`store %S %ptr`).  Flag the placeholder exactly as genFunc's param
		// prologue does; native backends ignore the flag (spillIncomingParams
		// handles byval params directly off the incoming arg/stack slot).
		if params[i].Typ.IsByvalParam() {
			pr.IsByvalParamRef = true
		}
		entry.EmitStore(slot, pr)
		paramSlots[i] = slot
	}
	var args @[]@Instr = make_slice(@Instr, len(params))
	for i := 0; i < len(params); i++ {
		args[i] = entry.EmitLoad(paramSlots[i], params[i].Typ)
	}
	// Materialize-capture bridge: when the closure captured the receiver BY
	// VALUE (a non-ident value receiver on a pointer-receiver method — see
	// genMethodValue), `recvTyp` is the VALUE type but the method still takes
	// `*T`.  Alloca the captured value in the wrapper frame and pass its address
	// (valid for this synchronous call).  Mirrors applyReceiverConversion's
	// value→pointer path.  A no-op for a directly-captured `*T` / `@T` receiver
	// (recvTyp is a pointer kind, not named), which passes through unchanged.
	var methodRecvTyp @types.Type = m.FuncType.Params[0].Type
	if len(args) > 0 && recvTyp != nil && methodRecvTyp != nil && isNamedTypeKind(recvTyp) &&
			methodRecvTyp.Kind == types.TYP_POINTER {
		var recvSlot @Instr = entry.EmitAlloc(recvTyp)
		entry.EmitStore(recvSlot, args[0])
		args[0] = recvSlot
	}
	if len(m.FuncType.Results) == 0 {
		// Void return.
		var voidArgs @[]@Instr
		entry.EmitCall(methodQName, args, types.TypVoid())
		entry.EmitReturn(voidArgs)
	} else if len(m.FuncType.Results) == 1 {
		var callResult @Instr = entry.EmitCall(methodQName, args, m.FuncType.Results[0])
		var retVals @[]@Instr = make_slice(@Instr, 1)
		retVals[0] = callResult
		entry.EmitReturn(retVals)
	} else {
		// Multi-return forward: extract each result field from the
		// packed call-result tuple and re-return them as N separate
		// values through EmitReturnTyped — mirroring gen_return.bn's
		// `return f(...)` path (genReturnStmt).  Handing EmitReturn a
		// SINGLE packed-struct arg instead would misroute the native
		// backends' OP_RETURN to the single-aggregate handler, which
		// getOperand's the tuple as a POINTER; but a multi-return call
		// result keeps its bytes DIRECTLY in the spill slot (see
		// common.SpillHoldsAggregatePointer), so that handler
		// dereferences the first field's value as an address → SIGSEGV.
		// The extracted N-value shape routes to emitMultiReturnPack /
		// the ≤64-byte tuple packers instead, which read each field at
		// its spill offset.
		var callResult @Instr = entry.EmitCall(methodQName, args, f.MultiReturnType)
		var retVals @[]@Instr = make_slice(@Instr, len(m.FuncType.Results))
		for i := 0; i < len(m.FuncType.Results); i++ {
			var fldTyp @types.Type = m.FuncType.Results[i]
			if callResult.Typ != nil && i < len(callResult.Typ.Fields) {
				fldTyp = callResult.Typ.Fields[i].Type
			}
			retVals[i] = entry.EmitExtract(callResult, i, fldTyp)
		}
		entry.EmitReturnTyped(retVals, f.MultiReturnType)
	}

	// Register the FuncSig so any cross-package call-site
	// lookups resolve the synthetic name.
	registerMethodValueWrapperSig(gc, f)
	gc.Mod.AddFunc(f)
}

// registerMethodValueWrapperSig adds a FuncSig entry to
// Module.FuncSigs for the wrapper.  Mirrors
// registerLiftedFuncSigWithCaptures (gen_func_lit.bn).
func registerMethodValueWrapperSig(gc @GenCtx, f @Func) {
	var sig FuncSig
	sig.Name = qualifyForCurrentModule(gc, f.Name)
	var sigParams @[]@types.Type
	for j := 0; j < len(f.Params); j++ {
		sigParams = slices.Append[@types.Type](sigParams, f.Params[j].Typ)
	}
	sig.Params = sigParams
	sig.Results = f.Results
	if len(f.Results) > 1 {
		sig.MultiReturnType = f.MultiReturnType
	}
	gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)
}
