package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// ============================================================
// Method-value receiver handling
// ============================================================
//
// Resolving the receiver's IR-gen type (for the method symbol's package
// qualification) and smoothing the evaluated receiver into the closure's
// captured form.  Split out of gen_method_value.bn.

// methodValueRecvIRType resolves the IR-gen type of a method-value receiver
// expression WITHOUT emitting code (the receiver is evaluated separately, once,
// by genCapturedRecv — a second genExpr here would double-evaluate a
// side-effecting receiver).  Its Name carries the full-path-qualified type name
// that buildMethodQualName needs to target the method's DEFINING package (the
// checker's type Name is unqualified).  Covers the addressable receiver forms a
// method value is taken on: an ident (variable, via its declared IR-gen type)
// and a selector (field, via getSelectorType).  Returns nil for other receiver
// shapes, whose caller falls back to the checker's unqualified name.
func methodValueRecvIRType(ctx @GenContext, xExpr @ast.Expr) @types.Type {
	if xExpr == nil {
		return nil
	}
	if xExpr.Kind == ast.EXPR_IDENT {
		return lookupVarType(ctx, xExpr.Name)
	}
	if xExpr.Kind == ast.EXPR_SELECTOR {
		return getSelectorType(ctx, xExpr)
	}
	if xExpr.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// An index-result receiver (`arr[i].M`): the element type carries the
		// qualified name (getIndexElemType, the same resolver getSelectorType
		// uses for a nested index).
		return getIndexElemType(ctx, xExpr)
	}
	if xExpr.Kind == ast.EXPR_CALL {
		// A call-result receiver (`f().M`): the callee's registered single
		// return type carries the qualified name.  funcRefName resolves the
		// callee's defining package; lookupFuncResults gives the IR-gen result
		// types — the same path genCall uses to type a call.  (A method value on
		// a value-returning callee with a pointer receiver additionally needs
		// address-of-temp capture — see genCapturedRecv's EXPR_IDENT-only T→*T
		// arm — but a pointer/managed-returning callee, the common case,
		// captures fine.)
		// A generic-function-instantiation callee (`mkbox[int](...).M`): funcRefName
		// can't name a `Gen[T]` head, so resolve the instantiation's result type
		// directly (else the receiver type is nil → the raw `Box[int]` name).
		if xExpr.X != nil && xExpr.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			var it @types.Type = instantiatedCalleeResultType(ctx, xExpr)
			if it != nil {
				return it
			}
		}
		var callee @[]char = funcRefName(ctx.Gc, xExpr.X)
		if len(callee) > 0 && lookupFuncExists(ctx.Gc, callee) {
			var results @[]@types.Type = lookupFuncResults(ctx.Gc, callee)
			if len(results) == 1 {
				return results[0]
			}
		}
		return nil
	}
	// Any other receiver shape falls back to the checker's unqualified name —
	// still mis-mangled for a cross-package receiver (a latent gap).
	return nil
}

// genCapturedRecv evaluates the receiver expression `xExpr` and
// converts the result to the captured form expected by the
// closure struct's `recv` field.  Smoothing per plan-function-
// values-phase-2.md §"Method values x.M":
//
//   * recvTyp.Identical(capturedTyp) — no conversion, plain
//     genExpr.  Covers same-shape paths (T+T, *T+*T, @T+@T).
//   * recvTyp is T, capturedTyp is *T — take address-of x.  For
//     EXPR_IDENT this is `lookupVar(ctx, x.Name)`, the alloca'd
//     stack slot itself (Binate's address-of-local pattern;
//     mirrors genUnary's `&x` path).  Other addressable shapes
//     (struct field, indexed slot) aren't yet wired here.
//   * recvTyp is *T or @T, capturedTyp is T — load through the
//     pointer to materialise the T copy.
//   * recvTyp is @T, capturedTyp is *T — bitcast managed-ptr to
//     raw pointer; the @T's refcount is unaffected (raw doesn't
//     refcount), so the captured raw pointer's lifetime piggy-
//     backs on the @T variable that produced it.
//
// When the smoothing case isn't recognised, fall back to plain
// genExpr — IR-gen / backend will catch any remaining mismatch
// downstream.  Type-checker is the gate on which shapes are
// valid at the source level.
func genCapturedRecv(ctx @GenContext, b @Block, xExpr @ast.Expr, recvTyp @types.Type,
		capturedTyp @types.Type) @Instr {
	if recvTyp.Identical(capturedTyp) {
		return genExpr(ctx, b, xExpr)
	}
	// T → *T: take address.  EXPR_IDENT case — the alloca'd
	// stack slot for the local IS its *T address.
	if capturedTyp != nil && capturedTyp.Kind == types.TYP_POINTER &&
			recvTyp.Identical(capturedTyp.Elem) {
		if xExpr.Kind == ast.EXPR_IDENT {
			var slot @Instr = lookupVar(ctx, xExpr.Name)
			if slot != nil {
				// The alloca's runtime value IS the pointer; tag
				// the Instr with *T so downstream uses (the
				// EmitStore into the closure struct) treat it as
				// `*T`-typed.
				var ptr @Instr = make(Instr)
				ptr.ID = slot.ID
				ptr.Op = slot.Op
				ptr.Typ = capturedTyp
				return ptr
			}
		}
	}
	// *T → T / @T → T: load through the pointer.  e.X is
	// pointer-typed; deref produces the value.
	if capturedTyp != nil && recvTyp != nil &&
			(recvTyp.Kind == types.TYP_POINTER || recvTyp.Kind == types.TYP_MANAGED_PTR) &&
			recvTyp.Elem != nil && recvTyp.Elem.Identical(capturedTyp) {
		var ptrVal @Instr = genExpr(ctx, b, xExpr)
		// Re-sync: an assert receiver (`a.(*T).Method`) splits the block in genExpr.
		b = ctx.CurBlock
		return b.EmitLoad(ptrVal, capturedTyp)
	}
	// @T → *T: bitcast managed-ptr to raw pointer.  Same
	// underlying address; the captured raw pointer doesn't
	// participate in refcounting.
	if capturedTyp != nil && capturedTyp.Kind == types.TYP_POINTER && recvTyp != nil &&
			recvTyp.Kind == types.TYP_MANAGED_PTR && recvTyp.Elem != nil && capturedTyp.Elem != nil &&
			recvTyp.Elem.Identical(capturedTyp.Elem) {
		var mptr @Instr = genExpr(ctx, b, xExpr)
		// Re-sync: an assert receiver (`a.(@T).Method`) splits the block in genExpr.
		b = ctx.CurBlock
		return b.EmitBitCast(mptr, capturedTyp)
	}
	// Unrecognised: fall back to plain genExpr.  Downstream type
	// mismatch is the user's signal that the shape isn't yet
	// supported.
	return genExpr(ctx, b, xExpr)
}

// isManagedReceiverType reports whether recvTyp is a managed
// pointer / managed-slice / etc. — these need refcount machinery
// (B.3) that isn't part of B.4's first cut.
func isManagedReceiverType(t @types.Type) bool {
	if t == nil { return false }
	var rt @types.Type = t.ResolveAlias()
	if rt == nil { return false }
	if rt.Kind == types.TYP_MANAGED_PTR { return true }
	if rt.Kind == types.TYP_MANAGED_SLICE { return true }
	return false
}

// nameHasBracket reports whether a type name carries the checker's RAW generic-
// instantiation spelling (a '[', e.g. `Box[int]`), which is not a valid mangled
// IR/LLVM identifier.
func nameHasBracket(name *[]readonly char) bool {
	for i := 0; i < len(name); i++ {
		if name[i] == '[' {
			return true
		}
	}
	return false
}

// remapCapturedBaseToIR swaps a method-value captured-receiver type's base named
// type for the IR-gen instantiated struct (peeled from the receiver's IR-gen
// type) when the base carries the checker's RAW generic-instantiation spelling
// (`Box[int]`).  The method's receiver type comes from the CHECKER
// (`m.FuncType.Params[0].Type`), whose instantiation name is the raw source
// spelling; the closure struct / wrapper sig mangled from it would be the invalid
// LLVM identifier `%bn_S..._Box[int]` (the '[' is illegal).  The receiver's IR-gen
// type names the same struct `Box__bn_inst__int`.  Keeps captured's pointer /
// managed / value wrapper; no-op for a non-generic (or unavailable) receiver.
func remapCapturedBaseToIR(capturedTyp @types.Type, recvIRTyp @types.Type) @types.Type {
	if capturedTyp == nil || recvIRTyp == nil {
		return capturedTyp
	}
	var base @types.Type = peelToNamedBase(capturedTyp)
	if base == nil || !nameHasBracket(base.Name) {
		return capturedTyp
	}
	var irBase @types.Type = peelToNamedBase(recvIRTyp)
	if irBase == nil {
		return capturedTyp
	}
	if capturedTyp.Kind == types.TYP_POINTER {
		return types.MakePointerType(irBase)
	}
	if capturedTyp.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(irBase)
	}
	return irBase
}

// instantiatedCalleeResultType resolves the IR-gen result type of a call whose
// callee is a generic-function INSTANTIATION (`mkbox[int](...)`), for a method
// value on the call result (`mkbox[int](55).Get`).  funcRefName only names plain
// idents / selectors — it returns "" for a `Gen[T]` head — so without this the
// receiver's IR-gen type is nil, and the closure struct / method symbol fall back
// to the checker's RAW `Box[int]` name (invalid LLVM identifier / VM extern
// `main.Box[int].Get`).  Ensure the specialized func is emitted (deduped via
// EmittedInstantiations, so genCapturedRecv's later call is a no-op) to get its
// mangled name, then read its single result type — mirroring genCall's
// instantiate branch.  Returns nil for a non-generic / unresolvable callee.
func instantiatedCalleeResultType(ctx @GenContext, callExpr @ast.Expr) @types.Type {
	var head @ast.Expr = callExpr.X
	if head == nil || head.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || head.X == nil {
		return nil
	}
	var gd @ast.Decl
	var defAlias @[]char
	if head.X.Kind == ast.EXPR_IDENT {
		if len(ctx.Gc.Mod.CurrentImportAlias) > 0 {
			gd = lookupGenericDeclPkg(ctx.Gc, ctx.Gc.Mod.CurrentImportAlias, head.X.Name)
			if gd != nil {
				defAlias = ctx.Gc.Mod.CurrentImportAlias
			}
		}
		if gd == nil {
			gd = lookupGenericDecl(ctx.Gc, head.X.Name)
		}
	} else if head.X.Kind == ast.EXPR_SELECTOR && head.X.X != nil && head.X.X.Kind == ast.EXPR_IDENT {
		defAlias = resolveImportPkg(ctx.Gc.Mod, head.X.X.Name)
		gd = lookupGenericDeclPkg(ctx.Gc, defAlias, head.X.Name)
	}
	if gd == nil {
		return nil
	}
	var args @[]@types.Type = make_slice(@types.Type, len(head.Args))
	for i := 0; i < len(head.Args); i++ {
		args[i] = typeArgExprToType(ctx.Gc, head.Args[i])
	}
	var name @[]char = ensureInstantiated(ctx.Gc, gd, args, defAlias)
	var results @[]@types.Type = lookupFuncResults(ctx.Gc, name)
	if len(results) == 1 {
		return results[0]
	}
	return nil
}
