package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// registerVarGlobals registers a Module global for a package var decl or every
// var member of a `var ( ... )` group — so grouped vars get storage exactly
// like top-level ones (groups don't nest; recurse defensively).  A blank var
// (`var _ = f()`) binds no name and gets NO global: its initializer runs for
// side effects only (buildInitBody emits it as an expression statement), and a
// per-`_` global would collide every blank on one mangled symbol.  A group's
// const members are skipped (Kind != DECL_VAR) — they're handled by
// genConstGroup.
func registerVarGlobals(gc @GenCtx, d @ast.Decl) {
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			registerVarGlobals(gc, d.Decls[i])
		}
		return
	}
	if d.Kind != ast.DECL_VAR { return }
	if isBlankName(d.Name) { return }
	var mg irsym.ModuleGlobal
	mg.Name = buf.CopyStr(d.Name)
	mg.Typ = resolveGlobalVarType(gc, d)
	mg.Exported = d.Exported
	if d.Value != nil && d.Value.Kind == ast.EXPR_INT_LIT {
		mg.Init = parseIntLit(d.Value.Name)
	}
	gc.Mod.GlobalVars = slices.Append[irsym.ModuleGlobal](gc.Mod.GlobalVars, mg)
}

// InitModule creates a new module for an IR-generation run.  All gen state is
// per-@Module now — the Consts / Structs / FuncSigs / GlobalVars / TypeAliases
// / Interfaces tables, the import-alias map, CurrentImportAlias, AND the
// pending-dtor work-lists (Pending{Ms,Struct}Dtors + *Names) all come back
// empty from NewModule (Interfaces seeded with universe `any`), accumulating
// only on this module, so two compilations in one process don't share state.
// Nothing to reset here.
func InitModule(name @[]char) @Module {
	return NewModule(name)
}

// GeneratePackage generates a package's IR into gc.Mod.  It records the
// type-Checker and the resolved package path on the module, then runs the
// ordered declaration passes: a struct-name pre-pass (names registered before
// interface collection, so an interface method returning a later-declared
// struct resolves to the real type rather than the int fallback), then
// constants / globals / type aliases / interfaces, then impls, struct fields,
// function and method signatures, global emission, and finally function and
// method bodies.  It closes by synthesizing the per-package var-init,
// global-teardown, destructor, copy, and iv-dispatch-thunk functions.  Imports
// are resolved per file: each decl overlays its own file's import aliases onto
// the base snapshot, so a qualifier binds to the file that wrote it (falling
// back to a single merged overlay for single-file / synthetic / REPL packages).
func GeneratePackage(c @types.Checker, file @ast.File, gc @GenCtx, files @[]@ast.File) {
	// gc is the per-compilation context the caller threaded in (one gc per
	// package, shared with the import pre-passes and RegisterSelfTypes).
	// gc.Mod is the module this pass fills.
	var m @Module = gc.Mod
	// Record the type-Checker on the module so IR-gen helpers (and each
	// GenContext) can consult per-expression resolved types.  Per-module:
	// no process-global checker, so two compilations don't share state.
	m.Checker = c
	// Source the package short-name from the IR Module's name, not
	// file.PkgName. They usually agree, but for cmd/* packages they
	// don't: file.PkgName is "main" (the source declaration), while
	// m.Name carries the import path "cmd/bni" / "cmd/bnc" / etc.
	// Backends (codegen, vm, native) all use the module identity
	// for linker symbols, so IR-gen must qualify with the same name
	// or the auto-emitted helpers (__copy_X, __dtor_X) end up with a
	// definition `bn_F`-mangled under "main" but a caller `bn_F`-mangled
	// under "bni" — different symbols, link error.
	// Module-scoped home for the path: read by NewFunc (f.ModulePkgPath),
	// the @Block emit methods, the @Module init helpers, and gc.PkgPath.
	m.PkgPath = mangle.PkgPathFromQuoted(m.Name)
	// Mirror the opt level onto the module so context-light cleanup emitters
	// (emitManagedSliceRefDec) can gate the -O1+ reshape via f.Mod (see Module.OptLevel).
	m.OptLevel = gc.OptLevel
	// Bind the threaded gc's phase-scoped package path to this module's
	// now-resolved path (it was empty during the import pre-passes, before
	// m.PkgPath was set).  Threaded through genFunc/genMethod into
	// @GenContext.Gc; context-light helpers reach the module via gc.Mod.
	gc.PkgPath = m.PkgPath
	resetFuncLitState(gc)
	// Resolve cross-package references via the importing file's aliases.
	// With per-file ASTs (`files`), imports are FILE-scoped: each decl pass
	// below overlays just its decl's file's imports onto `aliasSnap` (the base
	// snapshot), so a qualifier `dep` binds to THAT file's `import dep "..."`
	// — not whichever file won the merged first-wins dedup.  Without per-file
	// ASTs (single-file / synthetic / REPL main), fall back to overlaying the
	// merged file's imports once (one file can't collide).  Restored before
	// returning.
	var fileScoped bool = len(files) > 0
	var aliasSnap AliasMapSnapshot
	if fileScoped {
		aliasSnap = SaveAliasMapState(gc.Mod)
	} else {
		aliasSnap = pushFileImports(gc.Mod, file)
	}
	// Struct-name pre-pass: register every non-generic struct NAME up
	// front (empty fields; filled in the field pass below).  This must
	// precede interface collection in the first pass — an interface
	// method whose result is a struct declared LATER in the file
	// (`interface B { get() Pair }` before `type Pair struct {...}`)
	// must resolve to the real struct type, not resolveTypeExpr's int
	// fallback; otherwise the OP_CALL_IFACE_METHOD return type degrades
	// to int and the vtable-dispatched aggregate return is miscompiled
	// (first field correct, later fields garbage).  Interface collection
	// stays interleaved in the first pass below so its ordering relative
	// to globals / type aliases — which may themselves be typed as
	// interfaces — is unchanged.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT &&
				len(d.TypeParams) == 0 {
			if lookupStructIdx(gc, d.Name) < 0 {
				var qn @[]char = qualifyForCurrentModule(gc, d.Name)
				var msName irsym.ModuleStruct
				msName.Name = qn
				var noFieldsPre @[]@types.Field
				msName.Typ = types.MakeStructType(qn, noFieldsPre)
				gc.Mod.Structs = slices.Append[irsym.ModuleStruct](
						gc.Mod.Structs, msName)
			}
		}
	}
	// First pass: collect constants, globals, type declarations,
	// and (Slice 2.3a-1) interface method-name lists for impl
	// vtable wiring downstream.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(gc.Mod, aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_CONST {
			genConst(gc, m.Checker, d)
		}
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(gc, m.Checker, d)
			registerVarGlobals(gc, d)
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				// Generic struct decl: stash the AST for use
				// sites to instantiate against.  Don't register a
				// Module.Structs entry — the decl itself doesn't
				// produce a struct; only its instantiations do.
				gc.GenericTypeDecls = slices.Append[@ast.Decl](
						gc.GenericTypeDecls, d)
				gc.GenericTypeDeclPkgs = slices.Append[@[]char](
						gc.GenericTypeDeclPkgs, buf.CopyStr(gc.PkgPath))
				gc.GenericTypeDeclFiles = slices.Append[@ast.File](
						gc.GenericTypeDeclFiles, declImportFile(files, file, d.Pos.File))
			}
			// Non-generic struct names are registered in the
			// struct-name pre-pass above.
		}
		if isNonStructTypeDecl(d) {
			var ta irsym.ModuleTypeAlias
			ta.Name = buf.CopyStr(d.Name)
			ta.Typ = typeDeclEntryType(gc, ta.Name, d)
			gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		}
		if d.Kind == ast.DECL_VAR {
			registerVarGlobals(gc, d)
		}
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, gc.PkgPath, declImportFile(files, file, d.Pos.File))
		}
	}
	// Impls pass: now that DECL_INTERFACE entries are registered,
	// walk DECL_IMPL entries and append ImplInfo records to m.Impls.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(gc.Mod, aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_IMPL {
			collectImplsFromDecl(gc, d, gc.PkgPath, m)
		}
	}

	// Second pass: populate struct fields on the existing type objects.
	// Generic struct decls are skipped — their fields stay in AST
	// form until an instantiation site resolves them (Slice 5c).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(gc.Mod, aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				continue
			}
			var si int = lookupStructIdx(gc, d.Name)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(gc, fd.Type)
					fields = slices.Append[@types.Field](fields, f)
				}
				var typ @types.Type = gc.Mod.Structs[si].Typ
				typ.Fields = fields
				gc.Mod.Structs[si].Fields = fields
			}
		}
	}

	// Third pass: register function and method signatures.
	// Generic decls (TypeParams non-empty) don't get IR signatures
	// directly — one specialized IR func is emitted per unique
	// `f[T1, ...]` instantiation site.  We
	// register the generic decl in the gc.GenericDecls table so call
	// sites can find it; the actual IR-gen happens lazily via
	// ensureInstantiated when a call lands.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(gc.Mod, aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
			gc.GenericDeclPkgs = slices.Append[@[]char](
					gc.GenericDeclPkgs, buf.CopyStr(gc.PkgPath))
			gc.GenericDeclFiles = slices.Append[@ast.File](
					gc.GenericDeclFiles, declImportFile(files, file, d.Pos.File))
			continue
		}
		if isGenericReceiverMethod(d) {
			// Method on a generic type — stash for per-instantiation emission
			// (ensureInstantiatedMethods), not at declaration time.
			stashGenericMethodDecl(gc, d, gc.PkgPath, declImportFile(files, file, d.Pos.File))
			continue
		}
		if d.Recv != nil {
			registerFuncSig(gc.Mod, methodSig(gc, gc.PkgPath, d))
			continue
		}
		var sig FuncSig
		sig.Name = qualifyForCurrentModule(gc, d.Name)
		var sigParams @[]@types.Type
		for j := 0; j < len(d.Params); j++ {
			sigParams = slices.Append[@types.Type](sigParams, irResolveParamType(gc, d.Params[j]))
		}
		sig.Params = sigParams
		sig.IsVariadic = declIsVariadic(d)
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(gc, d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		registerFuncSig(gc.Mod, sig)
	}

	// Register the current module's compiler-synthesized `__Package()`
	// accessor so an unqualified `__Package()` call resolves and lowers.
	registerCurrentModulePackageAccessor(gc, m.Checker)

	// Add globals to module.  Imported extern vars (IsExtern, registered
	// during RegisterImport with a dotted defining-pkg name) become
	// `external global` decls; same-package vars become definitions.
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		var g @Global = make(Global)
		g.Name = gc.Mod.GlobalVars[i].Name
		g.Typ = gc.Mod.GlobalVars[i].Typ
		g.IsExtern = gc.Mod.GlobalVars[i].IsExtern
		g.Exported = gc.Mod.GlobalVars[i].Exported
		m.AddGlobal(g)
	}

	// Generate function and method bodies.  Generic decls are
	// skipped — IR emission for generics happens at instantiation
	// (Slice 4); declaration-time emission would produce IR
	// referencing unresolved TYP_TYPE_PARAM types.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(gc.Mod, aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			continue
		}
		if isGenericReceiverMethod(d) {
			// Method on a generic type — emitted per instantiation
			// (ensureInstantiatedMethods), not at declaration time.
			continue
		}
		if d.Recv != nil {
			m.AddFunc(genMethod(gc, m.Checker, d, gc.PkgPath))
		} else {
			m.AddFunc(genFunc(gc, m.Checker, d))
		}
	}

	// Generate the per-package var-initializer function if any
	// top-level `var x T = expr` decls exist.  No-op otherwise.
	// Driver (cmd/bni / cmd/bnc dispatcher) calls it before main.
	//
	// The init combines every file's initializers into ONE synthetic body.  A
	// single package-wide overlay would mis-resolve a cross-file same-alias
	// initializer (`var x = dep.Foo()` where `dep` aliases different packages in
	// different files).  So instead arm a per-STATEMENT overlay: genBlock
	// switches the import map to each init statement's own file (by Pos.File)
	// before lowering it.  (Single-file / non-file-scoped packages can't collide
	// — keep the one-shot merged overlay there.)
	if fileScoped {
		gc.InitOverlayFiles = files
		gc.InitOverlayMerged = file
		gc.InitOverlayBase = aliasSnap
	} else {
		overlayFileImports(gc.Mod, aliasSnap, file)
	}
	generatePackageInit(gc, file.Decls, m)
	gc.InitOverlayMerged = nil
	// Restore the package-wide merged overlay for the synthetic passes that
	// follow (dtors / copies / iv-dispatch thunks) — the per-statement init
	// overlay above left the map at the last initializer's file.
	if fileScoped {
		overlayFileImports(gc.Mod, aliasSnap, file)
	}

	// Synthesize the VM-teardown function (RefDecs each managed global's
	// content) BEFORE generateDtors, so the dtors its body references get
	// generated — a managed global is destroyed nowhere else.
	addGlobalTeardownFunc(m)

	// Generate destructor functions (after user functions, so we know all
	// managed-slice types that need dtors from scope cleanup sites)
	generateDtors(m)

	// Generate copy functions (symmetric to dtors — RefInc on struct copy)
	generateCopies(m)

	// Generate iv-dispatch receiver thunks for value-receiver impls.
	// Vtable slots reference these thunks instead of the value-receiver
	// methods directly; the thunks adapt the iv data-pointer ABI.
	generateIvDispatchThunks(m)
	popFileImports(gc.Mod, aliasSnap)
}
