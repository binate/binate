package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// InitModule creates a new module and resets all IR generation global state.
// Slice 2.7 also resets moduleInterfaces here (early, at module
// creation) rather than later in GeneratePackage: imports are
// registered into moduleInterfaces by registerImportFieldsAndFuncs
// AFTER InitModule but BEFORE GeneratePackage, so a later clear would
// wipe those contributions.
func InitModule(name @[]char) @Module {
	// The per-module Consts / Structs / FuncSigs / GlobalVars / TypeAliases
	// tables need no reset here — NewModule returns them empty, and they
	// accumulate only on this module (plan-embeddable-vm.md inc 5).
	var emptyPendingMs @[]@types.Type
	pendingMsDtors = emptyPendingMs
	var emptyPendingStructs @[]@types.Type
	pendingStructDtors = emptyPendingStructs
	var emptyPendingNames @[]@[]char
	pendingMsDtorNames = emptyPendingNames
	pendingStructDtorNames = emptyPendingNames
	var emptyInterfaces @[]ModuleInterface
	moduleInterfaces = emptyInterfaces
	registerUniverseAny()
	var emptyAliasNames @[]@[]char
	importAliasNames = emptyAliasNames
	var emptyAliasPaths @[]@[]char
	importAliasPaths = emptyAliasPaths
	return NewModule(name)
}

// RegisterAllInterfaces registers DECL_INTERFACE entries from every
// loaded package (including transitive dependencies that the
// importing TU doesn't reference directly). Slice 2.9 of plan-cross-
// package-interfaces.md: when an importing TU's IR-gen processes
// an imported package's DECL_IMPL whose iface ref points at a
// transitive package's alias (e.g., `impl *Hello : aliases.Hello`
// where the importing TU imports neither aliases nor greeter
// directly), canonicalIfacePkg / canonicalIfaceName must still
// resolve the alias chain — which requires the alias's underlying
// interface to be in moduleInterfaces. Same pattern as
// RegisterStructTypes for transitive struct visibility.
func RegisterAllInterfaces(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx) {
	// Cross-package pre-pass: per-package paths (paths[k]) drive
	// qualification, so gc carries no module-of-its-own path here
	// (gc.PkgPath is empty — the importing module isn't GeneratePackage'd
	// yet).  gc.Mod is the importing module, so interface-method type
	// resolution sees the cross-package structs RegisterStructTypes
	// registered into that same module.
	// paths[k] is the import path of aliases[k]; passing it as the
	// pkg for interface registration ensures two same-last-segment
	// packages' interfaces don't collide on the alias slot.  The
	// per-file pushFileImports installs the file's own imports so
	// alias-target resolution inside collectInterfaceFromDecl
	// (`interface X = pkg.Y` referencing pkg by source alias)
	// resolves via THIS FILE'S imports — not whichever alias
	// happened to win the global first-wins dedup.
	for k := 0; k < len(aliases); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		var snap AliasMapSnapshot = pushFileImports(file)
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind != ast.DECL_INTERFACE { continue }
			if lookupModuleInterfaceIndex(gc.Mod, path, d.Name) >= 0 {
				continue
			}
			collectInterfaceFromDecl(gc, d, path, file)
		}
		popFileImports(snap)
	}
}

// RegisterStructTypes registers struct type names and populates fields from
// the given packages, without registering function signatures. Used to make
// transitive dependency struct types available for field type resolution.
func RegisterStructTypes(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx) {
	// Cross-package pre-pass (empty gc.PkgPath; see RegisterAllInterfaces).
	// gc.Mod is the importing module: this pass populates that module's
	// per-module Structs / TypeAliases tables (formerly the shared globals).
	// Qualified-name construction uses paths[k] DIRECTLY (via
	// buildQualName, which is a no-op on a non-alias prefix), so two
	// packages sharing a last-segment short alias get distinct
	// qualifiers (`pkg/alpha/widget.X` vs `pkg/beta/widget.X`)
	// instead of colliding under the alias map.  Crucially, we do
	// NOT populate the alias map here — that's the importing
	// module's RegisterImports' job (its direct imports unambiguously
	// bind aliases for that module's source).  Otherwise the broad
	// registration's first-wins dedup would clobber the importing
	// module's correct alias→path entries.
	// Pass 1: register all struct type names
	for k := 0; k < len(aliases); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				var qualName @[]char = buildQualName(path, d.Name)
				if lookupStructIdx(gc, qualName) < 0 {
					var ms ModuleStruct
					ms.Name = qualName
					var noFields @[]@types.Field
					ms.Typ = types.MakeStructType(qualName, noFields)
					gc.Mod.Structs = slices.Append[ModuleStruct](gc.Mod.Structs, ms)
				}
			}
		}
	}

	// Register type aliases from all packages
	for k := 0; k < len(aliases); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if isNonStructTypeDecl(d) {
				var qualName @[]char = buildQualName(path, d.Name)
				if lookupTypeAlias(gc, qualName) == nil {
					var ta ModuleTypeAlias
					ta.Name = qualName
					ta.Typ = typeDeclEntryType(gc, qualName, d)
					gc.Mod.TypeAliases = slices.Append[ModuleTypeAlias](gc.Mod.TypeAliases, ta)
				}
			}
		}
	}

	// Pass 2: populate struct fields only.  pushFileImports installs
	// the file's own imports so cross-package field types in the
	// imported file (referencing other packages by source alias)
	// resolve via THIS FILE'S imports — not whichever alias
	// happened to win the global first-wins dedup.
	// currentImportAlias is set to the *source* alias (for
	// resolveTypeExpr's "try current import alias prefix" fallback
	// in fields that reference unqualified same-package types).
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		var snap AliasMapSnapshot = pushFileImports(file)
		currentImportAlias = alias
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				var qualName @[]char = buildQualName(path, d.Name)
				var si int = lookupStructIdx(gc, qualName)
				if si >= 0 {
					var existTyp @types.Type = gc.Mod.Structs[si].Typ
					if len(existTyp.Fields) == 0 {
						var fields @[]@types.Field
						for j := 0; j < len(d.TypeRef.Fields); j++ {
							var fd @ast.FieldDecl = d.TypeRef.Fields[j]
							var f @types.Field = make(types.Field)
							f.Name = fd.Name
							f.Type = resolveTypeExpr(gc, fd.Type)
							fields = slices.Append[@types.Field](fields, f)
						}
						existTyp.Fields = fields
					}
				}
			}
		}
		popFileImports(snap)
	}
	var emptyAlias @[]char
	currentImportAlias = emptyAlias
}

// RegisterImports registers multiple imported packages with proper cross-package type resolution.
// It does struct name registration across ALL packages first, then populates fields and functions.
// This ensures that types referenced across packages (e.g., ir.Instr referencing types.Type)
// are resolved correctly regardless of import order.
func GeneratePackage(c @types.Checker, file @ast.File, gc @GenCtx,
		files @[]@ast.File) {
	// gc is the per-compilation context the caller threaded in (one gc per
	// package, shared with the import pre-passes and RegisterSelfTypes).
	// gc.Mod is the module this pass fills.
	var m @Module = gc.Mod
	// Record the type-Checker on the module so IR-gen helpers (and each
	// GenContext) can consult per-expression resolved types.  Per-module:
	// no process-global checker, so two compilations don't share state.
	m.Checker = c
	// Source the package short-name from the IR Module's name, not
	// file.PkgName. They usually agree, but for cmd/* packages they
	// don't: file.PkgName is "main" (the source declaration), while
	// m.Name carries the import path "cmd/bni" / "cmd/bnc" / etc.
	// Backends (codegen, vm, native) all use the module identity
	// for linker symbols, so IR-gen must qualify with the same name
	// or the auto-emitted helpers (__copy_X, __dtor_X) end up with
	// "bn_main____copy_X" definitions but "bn_bni____copy_X"
	// callers — link error.
	// Module-scoped home for the path: read by NewFunc (f.ModulePkgPath),
	// the @Block emit methods, the @Module init helpers, and gc.PkgPath.
	m.PkgPath = mangle.PkgPathFromQuoted(m.Name)
	// Bind the threaded gc's phase-scoped package path to this module's
	// now-resolved path (it was empty during the import pre-passes, before
	// m.PkgPath was set).  Threaded through genFunc/genMethod into
	// @GenContext.Gc; context-light helpers reach the module via gc.Mod.
	gc.PkgPath = m.PkgPath
	resetFuncLitState(gc)
	// Resolve cross-package references via the importing file's aliases.
	// With per-file ASTs (`files`), imports are FILE-scoped: each decl pass
	// below overlays just its decl's file's imports onto `aliasSnap` (the base
	// snapshot), so a qualifier `dep` binds to THAT file's `import dep "..."`
	// — not whichever file won the merged first-wins dedup.  Without per-file
	// ASTs (single-file / synthetic / REPL main), fall back to overlaying the
	// merged file's imports once (one file can't collide).  Restored before
	// returning.
	var fileScoped bool = len(files) > 0
	var aliasSnap AliasMapSnapshot
	if fileScoped {
		aliasSnap = SaveAliasMapState()
	} else {
		aliasSnap = pushFileImports(file)
	}
	// Struct-name pre-pass: register every non-generic struct NAME up
	// front (empty fields; filled in the field pass below).  This must
	// precede interface collection in the first pass — an interface
	// method whose result is a struct declared LATER in the file
	// (`interface B { get() Pair }` before `type Pair struct {...}`)
	// must resolve to the real struct type, not resolveTypeExpr's int
	// fallback; otherwise the OP_CALL_IFACE_METHOD return type degrades
	// to int and the vtable-dispatched aggregate return is miscompiled
	// (first field correct, later fields garbage).  Interface collection
	// stays interleaved in the first pass below so its ordering relative
	// to globals / type aliases — which may themselves be typed as
	// interfaces — is unchanged.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil &&
				d.TypeRef.Kind == ast.TEXPR_STRUCT &&
				len(d.TypeParams) == 0 {
			if lookupStructIdx(gc, d.Name) < 0 {
				var qn @[]char =
					qualifyForCurrentModule(gc, buf.CopyStr(d.Name))
				var msName ModuleStruct
				msName.Name = qn
				var noFieldsPre @[]@types.Field
				msName.Typ = types.MakeStructType(qn, noFieldsPre)
				gc.Mod.Structs = slices.Append[ModuleStruct](
					gc.Mod.Structs, msName)
			}
		}
	}
	// First pass: collect constants, globals, type declarations,
	// and (Slice 2.3a-1) interface method-name lists for impl
	// vtable wiring downstream.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_CONST {
			genConst(gc, m.Checker, d)
		}
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(gc, m.Checker, d)
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				// Generic struct decl: stash the AST for use
				// sites to instantiate against (Slice 5c of
				// plan-generics.md).  Don't register a
				// Module.Structs entry — the decl itself doesn't
				// produce a struct; only its instantiations do.
				gc.GenericTypeDecls = slices.Append[@ast.Decl](
					gc.GenericTypeDecls, d)
				gc.GenericTypeDeclPkgs = slices.Append[@[]char](
					gc.GenericTypeDeclPkgs,
					buf.CopyStr(gc.PkgPath))
				gc.GenericTypeDeclFiles = slices.Append[@ast.File](
					gc.GenericTypeDeclFiles,
					declImportFile(files, file, d.Pos.File))
			}
			// Non-generic struct names are registered in the
			// struct-name pre-pass above.
		}
		if isNonStructTypeDecl(d) {
			var ta ModuleTypeAlias
			ta.Name = buf.CopyStr(d.Name)
			ta.Typ = typeDeclEntryType(gc, ta.Name, d)
			gc.Mod.TypeAliases = slices.Append[ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		}
		if d.Kind == ast.DECL_VAR {
			var mg ModuleGlobal
			mg.Name = buf.CopyStr(d.Name)
			mg.Typ = resolveGlobalVarType(gc, d)
			mg.Exported = d.Exported
			if d.Value != nil && d.Value.Kind == ast.EXPR_INT_LIT {
				mg.Init = parseIntLit(d.Value.Name)
			}
			gc.Mod.GlobalVars = slices.Append[ModuleGlobal](gc.Mod.GlobalVars, mg)
		}
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, gc.PkgPath,
				declImportFile(files, file, d.Pos.File))
		}
	}
	// Impls pass: now that DECL_INTERFACE entries are registered,
	// walk DECL_IMPL entries and append ImplInfo records to m.Impls.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_IMPL {
			collectImplsFromDecl(gc, d, gc.PkgPath, m)
		}
	}

	// Second pass: populate struct fields on the existing type objects.
	// Generic struct decls are skipped — their fields stay in AST
	// form until an instantiation site resolves them (Slice 5c).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				continue
			}
			var si int = lookupStructIdx(gc, d.Name)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(gc, fd.Type)
					fields = slices.Append[@types.Field](fields, f)
				}
				var typ @types.Type = gc.Mod.Structs[si].Typ
				typ.Fields = fields
				gc.Mod.Structs[si].Fields = fields
			}
		}
	}

	// Third pass: register function and method signatures.
	// Generic decls (TypeParams non-empty) don't get IR signatures
	// directly — Slice 4 of plan-generics.md emits one specialized
	// IR func per unique `f[T1, ...]` instantiation site.  We
	// register the generic decl in the gc.GenericDecls table so call
	// sites can find it; the actual IR-gen happens lazily via
	// ensureInstantiated when a call lands.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
			gc.GenericDeclPkgs = slices.Append[@[]char](
				gc.GenericDeclPkgs,
				buf.CopyStr(gc.PkgPath))
			gc.GenericDeclFiles = slices.Append[@ast.File](
				gc.GenericDeclFiles, declImportFile(files, file, d.Pos.File))
			continue
		}
		if d.Recv != nil {
			gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, methodSig(gc, gc.PkgPath, d))
			continue
		}
		var sig FuncSig
		sig.Name = qualifyForCurrentModule(gc, buf.CopyStr(d.Name))
		var sigParams @[]@types.Type
		for j := 0; j < len(d.Params); j++ {
			sigParams = slices.Append[@types.Type](sigParams, resolveTypeExpr(gc, d.Params[j].Type))
		}
		sig.Params = sigParams
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(gc, d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)
	}

	// Register the current module's compiler-synthesized `_Package()`
	// accessor so an unqualified `_Package()` call resolves and lowers.
	registerCurrentModulePackageAccessor(gc, m.Checker)

	// Add globals to module.  Imported extern vars (IsExtern, registered
	// during RegisterImport with a dotted defining-pkg name) become
	// `external global` decls; same-package vars become definitions.
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		var g @Global = make(Global)
		g.Name = gc.Mod.GlobalVars[i].Name
		g.Typ = gc.Mod.GlobalVars[i].Typ
		g.IsExtern = gc.Mod.GlobalVars[i].IsExtern
		g.Exported = gc.Mod.GlobalVars[i].Exported
		m.AddGlobal(g)
	}

	// Generate function and method bodies.  Generic decls are
	// skipped — IR emission for generics happens at instantiation
	// (Slice 4); declaration-time emission would produce IR
	// referencing unresolved TYP_TYPE_PARAM types.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if fileScoped {
			overlayFileImports(aliasSnap, declImportFile(files, file, d.Pos.File))
		}
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			continue
		}
		if d.Recv != nil {
			m.AddFunc(genMethod(gc, m.Checker, d, gc.PkgPath))
		} else {
			m.AddFunc(genFunc(gc, m.Checker, d))
		}
	}

	// Generate the per-package var-initializer function if any
	// top-level `var x T = expr` decls exist.  No-op otherwise.
	// Driver (cmd/bni / cmd/bnc dispatcher) calls it before main.
	//
	// The init combines every file's initializers into ONE synthetic body, so
	// there is no single file scope to lower it under; overlay the merged
	// imports (package-wide) so qualified initializers resolve, matching the
	// non-file-scoped path.  KNOWN RESIDUAL: a same-alias-different-package
	// collision specifically in a package-level `var x = dep.Foo()` across
	// files mis-resolves here (see plan-file-scoped-imports.md).
	if fileScoped {
		overlayFileImports(aliasSnap, file)
	}
	generatePackageInit(gc, file.Decls, m)

	// Generate destructor functions (after user functions, so we know all
	// managed-slice types that need dtors from scope cleanup sites)
	generateDtors(m)

	// Generate copy functions (symmetric to dtors — RefInc on struct copy)
	generateCopies(m)

	// Generate iv-dispatch receiver thunks for value-receiver impls.
	// Vtable slots reference these thunks instead of the value-receiver
	// methods directly; the thunks adapt the iv data-pointer ABI.
	// See plan-primitives-impl-interfaces.md § "Interface-value
	// dispatch and value receivers".
	generateIvDispatchThunks(m)
	popFileImports(aliasSnap)
}
