package "pkg/binate/ir"

import "pkg/binate/irsym"
import "pkg/std/vec"

// RegisterModuleConst appends mc to m.Consts.
func RegisterModuleConst(m @Module, mc irsym.ModuleConst) {
	syncModuleConsts(m)
	m.ConstsVec.Push(mc)
	m.Consts = m.ConstsVec.Items()
}

// TruncateModuleConsts cuts m.Consts back to its first n entries; n must not
// exceed its length.
func TruncateModuleConsts(m @Module, n int) {
	if n > len(m.Consts) {
		panic("ir.TruncateModuleConsts: n is past the end of Consts")
	}
	syncModuleConsts(m)
	for m.ConstsVec.Len() > n {
		_, _ = m.ConstsVec.Pop()
	}
	m.Consts = m.ConstsVec.Items()
}

// syncModuleConsts restarts m.ConstsVec from m.Consts unless m.Consts is still the
// vec's view.
func syncModuleConsts(m @Module) {
	if m.ConstsVec != nil && same(m.Consts, m.ConstsVec.Items()) {
		return
	}
	m.ConstsVec = vec.New[irsym.ModuleConst]()
	for i := 0; i < len(m.Consts); i++ {
		m.ConstsVec.Push(m.Consts[i])
	}
	m.Consts = m.ConstsVec.Items()
}
