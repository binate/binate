package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/builtins/testing"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Tests for RegisterModuleConst / TruncateModuleConsts: Module.Consts grows through
// its vec builder, is cut back in place, and stays right when a writer replaces it.

// namedConst returns a module constant entry named name with value v.
func namedConst(name *[]readonly char, v int) irsym.ModuleConst {
	var mc irsym.ModuleConst
	mc.Name = buf.CopyStr(name)
	mc.Val = cast(int64, v)
	return mc
}

// Registered constants are the list, in order, through one builder; a truncation
// cuts it back, and later registrations follow the kept entries on the same
// builder.
func TestModuleConstsRegisterAndTruncate() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleConst(m, namedConst("a", 1))
	var v0 @vec.Vec[irsym.ModuleConst] = m.ConstsVec
	for i := 0; i < 40; i++ {
		RegisterModuleConst(m, namedConst("b", i))
	}
	if len(m.Consts) != 41 || m.Consts[0].Val != 1 || m.Consts[40].Val != 39 {
		return fail("41 entries in order")
	}
	if !same(m.ConstsVec, v0) || !same(m.Consts, m.ConstsVec.Items()) {
		return fail("registrations keep one builder, with Consts its view")
	}
	TruncateModuleConsts(m, 1)
	RegisterModuleConst(m, namedConst("c", 7))
	if len(m.Consts) != 2 || m.Consts[1].Val != 7 || !same(m.ConstsVec, v0) {
		return fail("a truncation cuts the list in place and the next entry follows the kept one")
	}
	TruncateModuleConsts(m, 2)
	if len(m.Consts) != 2 { return fail("a truncation to the current length keeps the list") }
	return ""
}

// A constant appended to Consts directly, or a list a writer replaced, is taken
// up by the next registration; a field written in place through Consts is kept.
func TestModuleConstsAfterDirectWrites() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleConst(m, namedConst("a", 1))
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, namedConst("d", 4))
	RegisterModuleConst(m, namedConst("e", 5))
	if len(m.Consts) != 3 || m.Consts[1].Val != 4 || m.Consts[2].Val != 5 {
		return fail("a registration follows a directly appended entry")
	}
	m.Consts[0].Local = true
	RegisterModuleConst(m, namedConst("f", 6))
	if !m.Consts[0].Local { return fail("an in-place write is kept") }
	var bare @Module = make(Module)
	RegisterModuleConst(bare, namedConst("g", 8))
	TruncateModuleConsts(bare, 0)
	if len(bare.Consts) != 0 { return fail("a bare module registers and truncates") }
	return ""
}
