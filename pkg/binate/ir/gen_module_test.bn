package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"
import "pkg/stdx/slices"

func TestInitModule() testing.TestResult {
	var m @Module = InitModule("\"pkg/helper\"")
	if m == nil { return fail("InitModule returned nil") }
	if !seq(m.Name, "\"pkg/helper\"") { return fail("wrong module name") }
	return ""
}

func TestGeneratePackage() testing.TestResult {
	var m @Module = InitModule("\"pkg/helper\"")

	var src *[]readonly char = "package \"pkg/helper\"\nfunc Double(x int) int {\n\treturn x + x\n}\n"
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()

	GeneratePackage(nil, file, NewGenCtx(m), make_slice(@ast.File, 0))

	if len(m.Funcs) == 0 {
		return fail("expected function in module")
	}
	var f @Func = m.Funcs[0]
	if !seq(f.Name, "pkg/helper.Double") { return fail("expected function named helper.Double") }
	if f.IsExtern { return fail("should not be extern") }
	if len(f.Blocks) == 0 { return fail("expected blocks") }
	return ""
}

func TestGeneratePackageWithImport() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	// Register an import first
	var bniSrc *[]readonly char = "package \"pkg/helper\"\nfunc Double(x int) int\n"
	var bp @parser.Parser = parser.NewInterface(strToBytes(bniSrc), "helper.bni")
	var bniFile @ast.File = bp.ParseFile()
	RegisterImport("helper", "pkg/helper", bniFile, NewGenCtx(m))

	// Generate main package that calls imported function
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n")
	cb.Write("import \"pkg/helper\"\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar x int = helper.Double(21)\n")
	cb.Write("\tprintln(x)\n}\n")
	var mainSrc @[]char = buf.CopyStr(cb.String())
	var mp @parser.Parser = parser.New(strToBytes(mainSrc), "main.bn")
	var mainFile @ast.File = mp.ParseFile()
	GeneratePackage(nil, mainFile, NewGenCtx(m), make_slice(@ast.File, 0))

	// Should have extern func + main func
	if len(m.Funcs) < 2 { return fail("expected at least 2 funcs (1 extern + 1 main)") }

	// Find main function
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "main.main") {
			mainFn = m.Funcs[i]
		}
	}
	if mainFn == nil { return fail("expected main function") }

	// Check for a call instruction with qualified name
	var foundCall bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		for j := 0; j < len(mainFn.Blocks[i].Instrs); j++ {
			var instr @Instr = mainFn.Blocks[i].Instrs[j]
			if instr.Op == iropcode.OP_CALL && seq(instr.StrVal, "pkg/helper.Double") {
				foundCall = true
			}
		}
	}
	if !foundCall { return fail("expected call to helper.Double") }
	return ""
}

func TestTypeAliasLocal() testing.TestResult {
	// A type alias in the package should resolve correctly
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Result = @[]char\n")
	cb.Write("func check() Result {\n")
	cb.Write("\tvar r @[]char = make_slice(char, 3)\n")
	cb.Write("\treturn r\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourcePkg(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var f @Func = m.Funcs[0]
	if len(f.Results) == 0 {
		return fail("expected return type")
	}
	if f.Results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type")
	}
	return ""
}

func TestTypeAliasImported() testing.TestResult {
	// A type alias from an imported package should resolve via qualified name
	var m @Module = InitModule("\"main\"")

	var bniSrc *[]readonly char =
		"package \"pkg/mylib\"\ntype Result = @[]char\nfunc MakeResult() Result\n"
	var bp @parser.Parser = parser.NewInterface(strToBytes(bniSrc), "mylib.bni")
	var bniFile @ast.File = bp.ParseFile()
	RegisterImport("mylib", "pkg/mylib", bniFile, NewGenCtx(m))

	// Check that the function sig has the right return type
	var results @[]@types.Type = lookupFuncResults(NewGenCtx(m), "pkg/mylib.MakeResult")
	if len(results) == 0 {
		return fail("expected return type in func sig")
	}
	if results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type in func sig")
	}
	return ""
}

func TestGeneratePackageStructLitInit() testing.TestResult {
	// GeneratePackage must populate ModuleStruct.Fields so that
	// genCompositeLit can initialize struct literal field values.
	// Regression: only Typ.Fields was set, so composites were zeroinitializer.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pt struct {\n\tx int\n\ty int\n}\n")
	cb.Write("func main() {\n")
	cb.Write("\tvar p Pt = Pt{x: 10, y: 20}\n")
	cb.Write("\tprintln(p.x)\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourcePkg(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	// Look for OP_STORE instructions that store non-zero values (the field inits)
	var foundFieldStore bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_STORE && len(instr.Args) >= 2 {
				// Check if the stored value (Args[1]) is a constant 10 or 20
				if instr.Args[1].Op == iropcode.OP_CONST_INT {
					if instr.Args[1].IntVal == 10 || instr.Args[1].IntVal == 20 {
						foundFieldStore = true
					}
				}
			}
		}
	}
	if !foundFieldStore {
		return fail("no store of field values 10 or 20 found — struct literal init missing")
	}
	return ""
}


// TestGeneratePackageQualifiesByModuleName guards against the
// regression where IR-gen sourced its qualifier from file.PkgName
// instead of m.Name. They normally agree, but for cmd/* packages
// they don't: a cmd has source `package "main"` (file.PkgName) yet
// its module identity is the import path "cmd/foo" (m.Name).
// Backends mangle linker symbols off the module identity, so IR-gen
// must qualify with that same name. If it qualifies with file.PkgName
// instead, auto-emitted helpers (__copy_X, __dtor_X) end up with
// "main.__copy_X" definitions but "foo.__copy_X" callers — link
// error in every cmd/* binary.
func TestGeneratePackageQualifiesByModuleName() testing.TestResult {
	var m @Module = InitModule("\"cmd/foo\"")
	var src *[]readonly char =
		"package \"main\"\nfunc main() {}\n"
	var p @parser.Parser = parser.New(strToBytes(src), "main.bn")
	var file @ast.File = p.ParseFile()
	GeneratePackage(nil, file, NewGenCtx(m), make_slice(@ast.File, 0))
	// The main func must be qualified as "cmd/foo.main" (sourced
	// from m.Name, the full module path), not "main.main"
	// (file.PkgName).
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "cmd/foo.main") { mainFn = m.Funcs[i] }
	}
	if mainFn == nil {
		// Surface the actual names emitted to make diagnosis easy.
		var msg @strings.Builder = strings.NewBuilder()
		msg.Write("expected func 'cmd/foo.main' (qualified by m.Name); got: ")
		for i := 0; i < len(m.Funcs); i++ {
			if i > 0 { msg.Write(", ") }
			msg.Write(m.Funcs[i].Name)
		}
		return fail(buf.CopyStr(msg.String()))
	}
	return ""
}

// TestGenCtxPerCompilationModuleIsolation pins the inc-5 @GenCtx
// invariant: each GenModule call gets its own per-compilation gen
// context (gc), so a function literal lifted mid-stream registers into
// THAT compilation's module via gc.Mod — not whichever module a
// process-global last pointed at.  Two independent compilations of
// distinct packages must therefore keep their lifted funcs, and their
// type-Checkers, separate.  (Before @GenCtx + m.Checker, the
// `currentModule` / `currentChecker` process-globals were the shared
// state this rules out — the embeddability blocker plan-embeddable-vm.md
// exists to remove.)
func TestGenCtxPerCompilationModuleIsolation() testing.TestResult {
	var srcA *[]readonly char =
		"package \"a\"\n"
		"func fa() {\n"
		"  var f *func(int) int = func(x int) int { return x }\n"
		"  _ = f\n}\n"
	var srcB *[]readonly char =
		"package \"b\"\n"
		"func fb() {\n"
		"  var g *func(int) int = func(y int) int { return y + y }\n"
		"  _ = g\n}\n"
	var mA @Module = genFromSourceWithChecker(srcA)
	var mB @Module = genFromSourceWithChecker(srcB)

	// Distinct modules, each recording its own non-nil type-Checker.
	if mA == mB { return fail("expected distinct module instances") }
	if mA.Checker == nil || mB.Checker == nil {
		return fail("each module must record its own Checker")
	}
	if mA.Checker == mB.Checker {
		return fail("modules must not share a Checker (no process-global)")
	}

	// Each compilation's lifted func-literal landed in its OWN module:
	// a.__funclit_0 in mA, b.__funclit_0 in mB — and neither bled into
	// the other (a shared currentModule would have cross-registered them).
	if findFunc(mA, "a.__funclit_0") == nil {
		return fail("mA is missing its lifted a.__funclit_0")
	}
	if findFunc(mB, "b.__funclit_0") == nil {
		return fail("mB is missing its lifted b.__funclit_0")
	}
	if findFunc(mA, "b.__funclit_0") != nil {
		return fail("mB's lifted func leaked into mA")
	}
	if findFunc(mB, "a.__funclit_0") != nil {
		return fail("mA's lifted func leaked into mB")
	}
	return ""
}

// Per-module isolation of the five gen-time lookup tables (inc 5b): an
// entry written into one compilation's @Module (Consts / Structs /
// FuncSigs / GlobalVars / TypeAliases) must be invisible to a second
// compilation's gc.  This is the reentrancy guarantee the multi-package
// compile loop in cmd/bnc relies on — each package gets its own module,
// and InitModule no longer clears shared globals.  A lookup helper that
// read a stale shared global instead of gc.Mod would make m2's gc see
// m1's entries here.
func TestGenCtxRegistryIsolation() testing.TestResult {
	var m1 @Module = NewModule("m1")
	var m2 @Module = NewModule("m2")
	var gc1 @GenCtx = NewGenCtx(m1)
	var gc2 @GenCtx = NewGenCtx(m2)

	// Const.
	var mc ModuleConst
	mc.Name = "K"
	mc.Val = 7
	m1.Consts = slices.Append[ModuleConst](m1.Consts, mc)
	var cv int
	var ct @types.Type
	var cfound bool
	cv, ct, cfound = lookupConst(gc1, "K")
	if !cfound || cv != 7 { return fail("const K must resolve in m1") }
	cv, ct, cfound = lookupConst(gc2, "K")
	if cfound { return fail("const K leaked into m2") }

	// Struct.
	var ms ModuleStruct
	ms.Name = "S"
	ms.Typ = types.MakeStructType("S", noFields)
	m1.Structs = slices.Append[ModuleStruct](m1.Structs, ms)
	if lookupStructIdx(gc1, "S") < 0 { return fail("struct S must resolve in m1") }
	if lookupStructIdx(gc2, "S") >= 0 { return fail("struct S leaked into m2") }

	// Func signature.
	var sig FuncSig
	sig.Name = "F"
	m1.FuncSigs = slices.Append[FuncSig](m1.FuncSigs, sig)
	if !lookupFuncExists(gc1, "F") { return fail("func F must resolve in m1") }
	if lookupFuncExists(gc2, "F") { return fail("func F leaked into m2") }

	// Type alias.
	var ta ModuleTypeAlias
	ta.Name = "A"
	ta.Typ = types.TypInt()
	m1.TypeAliases = slices.Append[ModuleTypeAlias](m1.TypeAliases, ta)
	if lookupTypeAlias(gc1, "A") == nil { return fail("alias A must resolve in m1") }
	if lookupTypeAlias(gc2, "A") != nil { return fail("alias A leaked into m2") }

	// Global var (looked up via the imported-global path, which reads
	// gc.Mod.GlobalVars).
	var mg ModuleGlobal
	mg.Name = "pkg.G"
	mg.Typ = types.TypInt()
	m1.GlobalVars = slices.Append[ModuleGlobal](m1.GlobalVars, mg)
	if lookupImportedGlobalPtr(gc1, "pkg.G") == nil {
		return fail("global pkg.G must resolve in m1")
	}
	if lookupImportedGlobalPtr(gc2, "pkg.G") != nil {
		return fail("global pkg.G leaked into m2")
	}
	return ""
}
