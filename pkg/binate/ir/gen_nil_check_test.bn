package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for opt-in nil-pointer-deref checking.
// The GenCtx.EmitNilChecks flag gates whether IR-gen emits an OP_NIL_CHECK +
// recoverable cleanup pad before each pointer deref; isProvablyNonNil /
// emitNilCheckIfEnabled (gen_local_cleanup.bn) implement the gating + elision,
// and genUnary's `*p` deref is the first wired site (N2a).  Shared test helpers
// (strToBytes, fail, findFunc, findOp, countOp, noParams, noResults,
// genFromSourcePkg) live in ir_test.bn — same package.

// genPkgNilChecks gens a package from source with nil-checking ENABLED — the
// same path as genFromSourcePkg but with gc.EmitNilChecks set before
// GeneratePackage.  (genFromSource* leave the flag at its default false.)
func genPkgNilChecks(src *[]readonly char) @Module {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @Module = InitModule(file.PkgName)
	var gc @GenCtx = NewGenCtx(m)
	gc.EmitNilChecks = true
	GeneratePackage(nil, file, gc, make_slice(@ast.File, 0))
	return gc.Mod
}

// ---- helper-level: emitNilCheckIfEnabled + isProvablyNonNil ----

// With the flag on and a could-be-nil pointer (a value whose defining op is not
// in the provably-non-nil set — isProvablyNonNil keys off Op only), emitNilCheck-
// IfEnabled appends an OP_NIL_CHECK tagged with a recoverable cleanup pad.
func TestEmitNilCheckIfEnabledOnEmitsCheck() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil)
	ctx.Gc.EmitNilChecks = true
	var ptr @Instr = b.EmitConstInt(0, types.TypInt())
	emitNilCheckIfEnabled(ctx, b, ptr)
	if len(b.Instrs) == 0 { return fail("expected an OP_NIL_CHECK to be emitted") }
	var last @Instr = b.Instrs[len(b.Instrs) - 1]
	if last.Op != iropcode.OP_NIL_CHECK { return fail("last instr should be OP_NIL_CHECK") }
	if last.PadBlock == nil { return fail("the nil-check must be tagged with a recoverable pad") }
	if len(f.FaultPads) != 1 { return fail("expected exactly one fault pad") }
	return ""
}

// With the flag OFF, emitNilCheckIfEnabled is a no-op: no OP_NIL_CHECK, no pad —
// so default-off gen is byte-for-byte the pre-feature IR.
func TestEmitNilCheckIfEnabledOffEmitsNothing() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil) // EmitNilChecks defaults false
	var ptr @Instr = b.EmitConstInt(0, types.TypInt())
	emitNilCheckIfEnabled(ctx, b, ptr)
	if len(b.Instrs) != 1 { return fail("flag off must emit no OP_NIL_CHECK") }
	if len(f.FaultPads) != 0 { return fail("flag off must create no fault pad") }
	return ""
}

// Even with the flag on, a provably-non-nil pointer (OP_ALLOC — a stack-slot
// address) is elided: no OP_NIL_CHECK (elision (a), non-nil by construction).
func TestEmitNilCheckIfEnabledElidesProvablyNonNil() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil)
	ctx.Gc.EmitNilChecks = true
	var ptr @Instr = b.EmitAlloc(types.TypInt()) // OP_ALLOC -> provably non-nil
	emitNilCheckIfEnabled(ctx, b, ptr)
	if findOp(f, iropcode.OP_NIL_CHECK) != nil {
		return fail("a provably-non-nil (OP_ALLOC) pointer deref must elide the nil-check")
	}
	if len(f.FaultPads) != 0 { return fail("an elided check must create no fault pad") }
	return ""
}

// ---- integration: genUnary `*p` deref site (N2a wiring) ----

// With nil-checking enabled, `*p` (p a raw-pointer parameter, loaded from its
// slot — not provably non-nil) emits exactly one OP_NIL_CHECK, tagged with a pad.
func TestGenDerefEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc use(p *int) int { return *p }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 1 {
		return fail("`*p` with nil-checks on should emit exactly one OP_NIL_CHECK")
	}
	var nc @Instr = findOp(f, iropcode.OP_NIL_CHECK)
	if nc.PadBlock == nil { return fail("the deref nil-check must carry a recoverable pad") }
	return ""
}

// The SAME source with nil-checking OFF (the default gen path) emits no
// OP_NIL_CHECK — proving the flag gates emission and default-off is unchanged.
func TestGenDerefNoNilCheckWhenDisabled() testing.TestResult {
	var m @Module = genFromSourcePkg(
			"package \"test\"\nfunc use(p *int) int { return *p }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("nil-checks off must emit no OP_NIL_CHECK")
	}
	return ""
}

// `*(&x)` derefs the address of a local — an OP_ALLOC, provably non-nil — so
// even with nil-checks on the deref site elides the check (elision (a)).
func TestGenDerefElidesForAddressOfLocal() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc use() int { var x int = 5; return *(&x) }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	// The deref must actually happen (an OP_LOAD through the alloca) — so a
	// count of 0 nil-checks means "checked deref elided", not "no deref at all".
	if findOp(f, iropcode.OP_LOAD) == nil {
		return fail("`*(&x)` must still emit an OP_LOAD (the deref)")
	}
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("`*(&x)` (address of a local) must elide the nil-check")
	}
	return ""
}

// ---- field derefs: read (genSelector) + write (genSelectorPtr) + address-of ----

// A field READ through a managed pointer (`return p.x`, p a @Pt param) emits a
// nil-check on the followed pointer (genSelector's read path, N2b grind).
func TestGenFieldReadEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int }\nfunc rd(p @Pt) int { return p.x }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) < 1 {
		return fail("`p.x` read with nil-checks on should emit an OP_NIL_CHECK")
	}
	return ""
}

// The same read with nil-checks OFF emits none (default gen unchanged).
func TestGenFieldReadNoNilCheckWhenDisabled() testing.TestResult {
	var m @Module = genFromSourcePkg(
			"package \"test\"\ntype Pt struct { x int }\nfunc rd(p @Pt) int { return p.x }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("nil-checks off must emit no OP_NIL_CHECK for a field read")
	}
	return ""
}

// A field WRITE through a managed pointer (`p.x = 5`) emits a nil-check on the
// followed pointer (genSelectorPtr's forDeref=true store path).
func TestGenFieldWriteEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int }\nfunc wr(p @Pt) { p.x = 5 }\n")
	var f @Func = findFunc(m, "wr")
	if f == nil { return fail("no wr func") }
	if countOp(f, iropcode.OP_NIL_CHECK) < 1 {
		return fail("`p.x = 5` write with nil-checks on should emit an OP_NIL_CHECK")
	}
	return ""
}

// Taking a field ADDRESS (`&p.x`) is not a deref, so even with nil-checks on it
// emits NO check (deref-only semantics — genLValueAddr passes forDeref=false).
func TestGenFieldAddressOfNoNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int }\nfunc ad(p @Pt) *int { return &p.x }\n")
	var f @Func = findFunc(m, "ad")
	if f == nil { return fail("no ad func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("`&p.x` (address-of) must NOT emit a nil-check (deref-only)")
	}
	return ""
}

// A field read/write on a VALUE struct (`s.x`, s a local value) follows no
// pointer, so no nil-check even with the flag on.
func TestGenValueStructFieldNoNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int }\nfunc vs() int { var s Pt; return s.x }\n")
	var f @Func = findFunc(m, "vs")
	if f == nil { return fail("no vs func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("a value-struct field access must emit no nil-check")
	}
	return ""
}

// ---- index derefs: raw-pointer read (genIndex) + write (genIndexPtr) ----

// A raw-pointer index READ (`p[3]`, p a *int) nil-checks the pointer — a raw
// pointer carries no length, so the deref is otherwise unguarded (N2c).
func TestGenPtrIndexReadEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc rd(p *int) int { return p[3] }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) < 1 {
		return fail("`p[3]` read (raw pointer) with nil-checks on should emit an OP_NIL_CHECK")
	}
	return ""
}

// The same read with nil-checks OFF emits none.
func TestGenPtrIndexReadNoNilCheckWhenDisabled() testing.TestResult {
	var m @Module = genFromSourcePkg(
			"package \"test\"\nfunc rd(p *int) int { return p[3] }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("nil-checks off must emit no OP_NIL_CHECK for a pointer index read")
	}
	return ""
}

// A raw-pointer index WRITE (`p[3] = 5`) nil-checks the pointer (genIndexPtr
// forDeref=true store path).
func TestGenPtrIndexWriteEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc wr(p *int) { p[3] = 5 }\n")
	var f @Func = findFunc(m, "wr")
	if f == nil { return fail("no wr func") }
	if countOp(f, iropcode.OP_NIL_CHECK) < 1 {
		return fail("`p[3] = 5` write (raw pointer) with nil-checks on should emit an OP_NIL_CHECK")
	}
	return ""
}

// Taking a raw-pointer element ADDRESS (`&p[3]`) is not a deref, so no check
// even with nil-checks on (deref-only — genLValueAddr passes forDeref=false).
func TestGenPtrIndexAddressOfNoNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc ad(p *int) *int { return &p[3] }\n")
	var f @Func = findFunc(m, "ad")
	if f == nil { return fail("no ad func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("`&p[3]` (address-of) must NOT emit a nil-check (deref-only)")
	}
	return ""
}

// Array (`a[2]`, a a value array) and slice (`s[2]`) indexing follow no user
// pointer — an array base is an alloca; a slice's bounds check catches nil —
// so no nil-check even with the flag on.
func TestGenArrayAndSliceIndexNoNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc ar() int { var a [4]int; return a[2] }\n"
					"func sl(s *[]int) int { return s[2] }\n")
	var af @Func = findFunc(m, "ar")
	var sf @Func = findFunc(m, "sl")
	if af == nil || sf == nil { return fail("missing ar/sl func") }
	if countOp(af, iropcode.OP_NIL_CHECK) != 0 {
		return fail("value-array indexing must emit no nil-check")
	}
	if countOp(sf, iropcode.OP_NIL_CHECK) != 0 {
		return fail("slice indexing (bounds-checked) must emit no nil-check")
	}
	return ""
}

// A raw-pointer index store via the MULTI-ASSIGN path (`p[0], y = src()`) goes
// through emitIndexStore (not gen_control's single-assign arm), so exercise that
// distinct store path's nil-check too.
func TestGenPtrIndexMultiAssignStoreEmitsNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc src() (int, int) { return 1, 2 }\n"
					"func wr2(p *int) { var y int; p[0], y = src(); _ = y }\n")
	var f @Func = findFunc(m, "wr2")
	if f == nil { return fail("no wr2 func") }
	if countOp(f, iropcode.OP_NIL_CHECK) < 1 {
		return fail("`p[0], y = src()` (raw pointer, multi-assign) should emit an OP_NIL_CHECK")
	}
	return ""
}

// unsafe_index opts out of ALL index guards (bounds AND nil), so even with
// nil-checks on, `unsafe_index(p, i)` on a raw pointer emits NO nil-check — the
// caller has asserted the access is safe.
func TestGenUnsafeIndexSkipsNilCheck() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc ui(p *int) int { return unsafe_index(p, 3) }\n")
	var f @Func = findFunc(m, "ui")
	if f == nil { return fail("no ui func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("unsafe_index must emit NO nil-check (fully unchecked)")
	}
	return ""
}

// ---- N2d: intra-block dedup elision ----

// `p.x + p.y` derefs the SAME pointer twice in one block with nothing that could
// reassign it between — so it emits ONE nil-check, not two (dedup fires).
func TestGenNilCheckDedupsRepeatedFieldRead() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func rd(p @Pt) int { return p.x + p.y }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 1 {
		return fail("`p.x + p.y` should emit exactly ONE nil-check (intra-block dedup)")
	}
	return ""
}

// `p[0] + p[1]` (raw pointer) derefs the same pointer twice — one check.
func TestGenNilCheckDedupsRepeatedIndexRead() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc rd(p *int) int { return p[0] + p[1] }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 1 {
		return fail("`p[0] + p[1]` should emit exactly ONE nil-check (intra-block dedup)")
	}
	return ""
}

// SOUNDNESS: a CALL between the two derefs (`p.x + f() + p.y`, mid-expression,
// no store) could reassign a global/escaped pointer, so it INVALIDATES the dedup
// set — the second deref re-checks.  Two nil-checks, not one.
func TestGenNilCheckCallInvalidatesDedup() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func snk() int { return 0 }\n"
					"func rd(p @Pt) int { return p.x + snk() + p.y }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 2 {
		return fail("a call between derefs must invalidate dedup — expected TWO nil-checks")
	}
	return ""
}

// SOUNDNESS: a store between derefs (here the `var a =` store) invalidates the
// dedup set, so the later `p.y` re-checks.  Two nil-checks.
func TestGenNilCheckStoreInvalidatesDedup() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func rd(p @Pt) int { var a int = p.x; var b int = p.y; return a + b }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 2 {
		return fail("a store between derefs must invalidate dedup — expected TWO nil-checks")
	}
	return ""
}

// SOUNDNESS: dedup is INTRA-block — a deref in a conditional block does not
// establish non-nil in the join block, so `if c { ...p.x... }; ...p.y...`
// re-checks in the join.  Two nil-checks.
func TestGenNilCheckDedupIsIntraBlock() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func rd(p @Pt, c bool) int { var a int = 0\n"
					"if c { a = p.x }\nreturn a + p.y }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 2 {
		return fail("dedup must not cross blocks — expected TWO nil-checks")
	}
	return ""
}

// SOUNDNESS (regression for the load-source key collision): a double-deref of a
// NON-load pointer — `**f()`, f returning `*(*int)` — must nil-check BOTH the
// call result `f()` AND the loaded inner pointer `*f()`.  They are independent
// pointers; keying the inner load on its source (the call) would have collided
// with the call's own key and wrongly elided the inner check (a nil `*f()` would
// then SEGV instead of recovering).  Requires TWO nil-checks.
func TestGenNilCheckDoubleDerefOfCallNotFalseDeduped() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nvar gv *int\n"
					"func f() *(*int) { return &gv }\n"
					"func g() int { return **f() }\n")
	var fn @Func = findFunc(m, "g")
	if fn == nil { return fail("no g func") }
	if countOp(fn, iropcode.OP_NIL_CHECK) != 2 {
		return fail("`**f()` must nil-check both f() and *f() (no false dedup) — expected TWO")
	}
	return ""
}

// SOUNDNESS (regression for the global-sentinel key collision): distinct GLOBAL
// pointer variables are each synthesized as an OP_ALLOC pseudo carrying the
// shared void id -1, so they must NOT source-key (which would collide them).
// `g1.x + g2.x` are independent globals and each must nil-check — TWO checks.
func TestGenNilCheckDistinctGlobalsNotFalseDeduped() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"var g1 @Pt\nvar g2 @Pt\n"
					"func rd() int { return g1.x + g2.x }\n")
	var f @Func = findFunc(m, "rd")
	if f == nil { return fail("no rd func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 2 {
		return fail("distinct globals `g1.x + g2.x` must each nil-check — expected TWO")
	}
	return ""
}
