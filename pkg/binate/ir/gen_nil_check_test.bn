package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for opt-in nil-pointer-deref checking (plan-nil-check-opt-in.md, N2).
// The GenCtx.EmitNilChecks flag gates whether IR-gen emits an OP_NIL_CHECK +
// recoverable cleanup pad before each pointer deref; isProvablyNonNil /
// emitNilCheckIfEnabled (gen_local_cleanup.bn) implement the gating + elision,
// and genUnary's `*p` deref is the first wired site (N2a).  Shared test helpers
// (strToBytes, fail, findFunc, findOp, countOp, noParams, noResults,
// genFromSourcePkg) live in ir_test.bn — same package.

// genPkgNilChecks gens a package from source with nil-checking ENABLED — the
// same path as genFromSourcePkg but with gc.EmitNilChecks set before
// GeneratePackage.  (genFromSource* leave the flag at its default false.)
func genPkgNilChecks(src *[]readonly char) @Module {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @Module = InitModule(file.PkgName)
	var gc @GenCtx = NewGenCtx(m)
	gc.EmitNilChecks = true
	GeneratePackage(nil, file, gc, make_slice(@ast.File, 0))
	return gc.Mod
}

// ---- helper-level: emitNilCheckIfEnabled + isProvablyNonNil ----

// With the flag on and a could-be-nil pointer (a value whose defining op is not
// in the provably-non-nil set — isProvablyNonNil keys off Op only), emitNilCheck-
// IfEnabled appends an OP_NIL_CHECK tagged with a recoverable cleanup pad.
func TestEmitNilCheckIfEnabledOnEmitsCheck() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil)
	ctx.Gc.EmitNilChecks = true
	var ptr @Instr = b.EmitConstInt(0, types.TypInt())
	emitNilCheckIfEnabled(ctx, b, ptr)
	if len(b.Instrs) == 0 { return fail("expected an OP_NIL_CHECK to be emitted") }
	var last @Instr = b.Instrs[len(b.Instrs) - 1]
	if last.Op != iropcode.OP_NIL_CHECK { return fail("last instr should be OP_NIL_CHECK") }
	if last.PadBlock == nil { return fail("the nil-check must be tagged with a recoverable pad") }
	if len(f.FaultPads) != 1 { return fail("expected exactly one fault pad") }
	return ""
}

// With the flag OFF, emitNilCheckIfEnabled is a no-op: no OP_NIL_CHECK, no pad —
// so default-off gen is byte-for-byte the pre-feature IR.
func TestEmitNilCheckIfEnabledOffEmitsNothing() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil) // EmitNilChecks defaults false
	var ptr @Instr = b.EmitConstInt(0, types.TypInt())
	emitNilCheckIfEnabled(ctx, b, ptr)
	if len(b.Instrs) != 1 { return fail("flag off must emit no OP_NIL_CHECK") }
	if len(f.FaultPads) != 0 { return fail("flag off must create no fault pad") }
	return ""
}

// Even with the flag on, a provably-non-nil pointer (OP_ALLOC — a stack-slot
// address) is elided: no OP_NIL_CHECK (elision (a), non-nil by construction).
func TestEmitNilCheckIfEnabledElidesProvablyNonNil() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = NewGenCtx(nil)
	ctx.Gc.EmitNilChecks = true
	var ptr @Instr = b.EmitAlloc(types.TypInt()) // OP_ALLOC -> provably non-nil
	emitNilCheckIfEnabled(ctx, b, ptr)
	if findOp(f, iropcode.OP_NIL_CHECK) != nil {
		return fail("a provably-non-nil (OP_ALLOC) pointer deref must elide the nil-check")
	}
	if len(f.FaultPads) != 0 { return fail("an elided check must create no fault pad") }
	return ""
}

// ---- integration: genUnary `*p` deref site (N2a wiring) ----

// With nil-checking enabled, `*p` (p a raw-pointer parameter, loaded from its
// slot — not provably non-nil) emits exactly one OP_NIL_CHECK, tagged with a pad.
func TestGenDerefEmitsNilCheckWhenEnabled() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc use(p *int) int { return *p }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 1 {
		return fail("`*p` with nil-checks on should emit exactly one OP_NIL_CHECK")
	}
	var nc @Instr = findOp(f, iropcode.OP_NIL_CHECK)
	if nc.PadBlock == nil { return fail("the deref nil-check must carry a recoverable pad") }
	return ""
}

// The SAME source with nil-checking OFF (the default gen path) emits no
// OP_NIL_CHECK — proving the flag gates emission and default-off is unchanged.
func TestGenDerefNoNilCheckWhenDisabled() testing.TestResult {
	var m @Module = genFromSourcePkg(
			"package \"test\"\nfunc use(p *int) int { return *p }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("nil-checks off must emit no OP_NIL_CHECK")
	}
	return ""
}

// `*(&x)` derefs the address of a local — an OP_ALLOC, provably non-nil — so
// even with nil-checks on the deref site elides the check (elision (a)).
func TestGenDerefElidesForAddressOfLocal() testing.TestResult {
	var m @Module = genPkgNilChecks(
			"package \"test\"\nfunc use() int { var x int = 5; return *(&x) }\n")
	var f @Func = findFunc(m, "use")
	if f == nil { return fail("no use func") }
	// The deref must actually happen (an OP_LOAD through the alloca) — so a
	// count of 0 nil-checks means "checked deref elided", not "no deref at all".
	if findOp(f, iropcode.OP_LOAD) == nil {
		return fail("`*(&x)` must still emit an OP_LOAD (the deref)")
	}
	if countOp(f, iropcode.OP_NIL_CHECK) != 0 {
		return fail("`*(&x)` (address of a local) must elide the nil-check")
	}
	return ""
}
