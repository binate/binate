package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// genPanicCall lowers `panic(msg)` to a call to pkg/builtins/rt.Panic followed
// by an unreachable terminator (routing through rt.Panic — no value formatting,
// no backend-specific panic op, so it aborts loudly on every backend).
func TestGenPanicCall() testing.TestResult {
	var m @Module = genFromSource("package \"test\"\nfunc main() { panic(\"boom\") }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundPanicCall bool = false
	var foundUnreachable bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, "pkg/builtins/rt.Panic") {
			foundPanicCall = true
		}
		if ins.Op == iropcode.OP_UNREACHABLE {
			foundUnreachable = true
		}
	}
	if !foundPanicCall {
		return fail("panic should lower to a call to pkg/builtins/rt.Panic")
	}
	if !foundUnreachable {
		return fail("panic should end in an OP_UNREACHABLE terminator")
	}
	return ""
}
