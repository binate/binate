package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Smoke tests for the print/println builtin's IR-gen lowering.
// (Coarser-grained behavioral coverage lives in gen_expr_test.bn /
// gen_stmt_test.bn; the conformance suite validates end-to-end
// output across all execution modes.)

func TestGenPrintIntCallsFormatInt() testing.TestResult {
	// println(42) should dispatch through bootstrap.formatInt
	// (NOT through any bn_print_int — that shim is gone).
	var m @Module = genFromSource("package \"test\"\nfunc main() { println(42) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFormatInt bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL &&
				seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatInt") {
			foundFormatInt = true
		}
	}
	if !foundFormatInt {
		return fail("println(int) should call bootstrap.formatInt")
	}
	return ""
}

// TestGenPrintUintCastsToUint64 verifies that println(uintN) widens
// the argument to uint64 before calling bootstrap.formatUint.  The
// helper's declared param is uint64 — without an explicit cast the
// IR-to-LLVM call signature would not match on targets where `int`
// is i32 (e.g. arm32-baremetal), causing the linker to reject the
// module or the call ABI to corrupt the slice arg (manifested as
// "runtime error: index out of bounds: 0 (len 0)" in conformance
// tests 148/149/151/152).  See emitPrintInt in gen_print.bn.
func TestGenPrintUintCastsToUint64() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc main() { var x uint32 = 1; println(x) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var formatUintArg @Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL &&
				seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatUint") {
			formatUintArg = entry.Instrs[i].Args[0]
		}
	}
	if formatUintArg == nil {
		return fail("println(uint32) should call bootstrap.formatUint")
	}
	if formatUintArg.Op != iropcode.OP_CAST {
		return fail("formatUint arg should be an iropcode.OP_CAST")
	}
	if formatUintArg.TypeArg == nil || formatUintArg.TypeArg.Kind != types.TYP_INT ||
			formatUintArg.TypeArg.Width != 64 || formatUintArg.TypeArg.Signed {
		return fail("formatUint arg cast target should be uint64")
	}
	return ""
}

// TestGenPrintSmallSignedCastsToInt verifies that println of a
// narrower signed int (e.g. int8) widens to the target's `int`
// width before calling bootstrap.formatInt.  Same root-cause as
// TestGenPrintUintCastsToUint64, signed side.
func TestGenPrintSmallSignedCastsToInt() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc main() { var x int8 = 1; println(x) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var formatIntArg @Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL &&
				seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatInt") {
			formatIntArg = entry.Instrs[i].Args[0]
		}
	}
	if formatIntArg == nil {
		return fail("println(int8) should call bootstrap.formatInt")
	}
	if formatIntArg.Op != iropcode.OP_CAST {
		return fail("formatInt arg should be an iropcode.OP_CAST")
	}
	if formatIntArg.TypeArg == nil || formatIntArg.TypeArg.Kind != types.TYP_INT ||
			!formatIntArg.TypeArg.Signed {
		return fail("formatInt arg cast target should be signed int")
	}
	return ""
}

// TestGenPrintInt64RoutesToFormatInt64 verifies that println(int64)
// goes through bootstrap.formatInt64 — NOT formatInt — so the full
// 64-bit range round-trips on 32-bit targets (formatInt takes the
// target's `int`, which is i32 on arm32; truncating int64 there
// turns int64-min into 0 and int64-max into -1 ≡ 4294967295).  See
// conformance tests 422/423 and the emitPrintInt branching in
// gen_print.bn.
func TestGenPrintInt64RoutesToFormatInt64() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc main() { var x int64 = 1; println(x) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFormatInt64 bool = false
	var foundFormatInt bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL {
			if seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatInt64") {
				foundFormatInt64 = true
			}
			if seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatInt") {
				foundFormatInt = true
			}
		}
	}
	if !foundFormatInt64 {
		return fail("println(int64) should call bootstrap.formatInt64")
	}
	if foundFormatInt {
		return fail("println(int64) should NOT also call bootstrap.formatInt")
	}
	return ""
}

func TestGenPrintStringCallsWriteDirectly() testing.TestResult {
	// println("hi") should call bootstrap.Write directly with no
	// format step — strings are already byte sequences.
	var m @Module = genFromSource("package \"test\"\nfunc main() { println(\"hi\") }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundWrite bool = false
	var foundFormatInt bool = false
	var foundFormatBool bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL {
			if seq(entry.Instrs[i].StrVal, "pkg/bootstrap.Write") {
				foundWrite = true
			}
			if seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatInt") {
				foundFormatInt = true
			}
			if seq(entry.Instrs[i].StrVal, "pkg/bootstrap.formatBool") {
				foundFormatBool = true
			}
		}
	}
	if !foundWrite { return fail("println(string) should call bootstrap.Write") }
	if foundFormatInt { return fail("string path should not call formatInt") }
	if foundFormatBool { return fail("string path should not call formatBool") }
	return ""
}
