package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Refcounting type / instruction predicates
// ============================================================
//
// Pure classifiers used throughout the refcount machinery (copy/dtor/
// scope-cleanup in gen_util_refcount.bn and the assignment paths in
// gen_control.bn etc.): "is this type a managed kind?", "is this
// instruction a fresh (refcount-already-1) construction?".

// isManagedPtrType returns true if t is @T (managed pointer), peeling any
// IR-transparent wrapper first (a `readonly @T` / named-`@T` is still a
// managed pointer for every lowering decision).
func isManagedPtrType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	return t.Kind == types.TYP_MANAGED_PTR
}

// isManagedSliceType returns true if t is @[]T (managed slice), peeling any
// IR-transparent wrapper first — `readonly @[]T` AND a named-distinct
// `type Buf @[]T` are both still managed slices that own a refcount the
// caller must RefInc/RefDec.  Mirrors isManagedPtrType: peeling only readonly
// (not named) made a `var b Buf = ...` local fail every scope-cleanup
// classifier, so its backing was never RefDec'd — a silent leak.
func isManagedSliceType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	return t.Kind == types.TYP_MANAGED_SLICE
}

// isManagedIfaceValueType returns true if t is @Iface (managed interface
// value), peeling any IR-transparent wrapper first (mirrors isManagedPtrType /
// isManagedSliceType) so a named-distinct or readonly-wrapped @Iface is still
// recognized for refcount cleanup.
func isManagedIfaceValueType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	return t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// isIfaceValueKind reports whether the ALREADY-PEELED t is an interface value —
// raw `*I` (TYP_INTERFACE_VALUE) or managed `@I` (TYP_INTERFACE_VALUE_MANAGED).
// Used by the cast-lowering backstop that rejects a cast to/from an interface value.
func isIfaceValueKind(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// isBitCastRejectedAggregateKind reports whether the ALREADY-PEELED t is an aggregate
// bit_cast cannot reinterpret (managed slice / struct / array / func-value / interface
// value) — mirrors the checker's types.isBitCastRejectedAggregate.  Used by the
// bit_cast-lowering backstop that catches a generic `bit_cast(T, x)` whose T
// substitutes to such a type (the definition-time checker saw an abstract T).
func isBitCastRejectedAggregateKind(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_STRUCT ||
			t.Kind == types.TYP_ARRAY || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE || t.Kind == types.TYP_INTERFACE_VALUE ||
			t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// isManagedFuncValueType returns true if t is @func(...) (managed function
// value), peeling any IR-transparent wrapper first (mirrors isManagedPtrType /
// isManagedSliceType).  Note: IR-gen represents a named-distinct func-value
// type transparently as its underlying @func (typeDeclEntryType strips the
// TYP_NAMED), so the named case rarely reaches here — but peeling keeps the
// predicate uniform with the other managed-scalar classifiers.
func isManagedFuncValueType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	return t.Kind == types.TYP_MANAGED_FUNC_VALUE
}

// isManagedScalarType returns true for the four managed VALUE types the
// refcount machinery handles inline at a store site — @T, @[]T, @func(...),
// and @Iface — as opposed to struct/array aggregates (which copy/destroy
// via emitStructCopy / emitStructDtor).  Drives copy-RefInc of a new value
// and RefDec of the overwritten old value in the assignment paths.
func isManagedScalarType(t @types.Type) bool {
	return isManagedPtrType(t) || isManagedSliceType(t) || isManagedFuncValueType(t) ||
			isManagedIfaceValueType(t)
}

// isSliceType returns true if t is *[]T or @[]T (any slice type),
// including a `readonly`-wrapped one — readonly is erased in IR, so a
// `readonly []T` is a slice for every lowering decision.  Peels outer
// readonly like isCharArrayType.
func isSliceType(t @types.Type) bool {
	for t != nil && t.Kind == types.TYP_READONLY { t = t.Elem }
	if t == nil { return false }
	return t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE
}

// peelReadonly strips any outer `readonly` wrappers, returning the
// underlying type.  A `readonly @[]T` carries the inner @[]T in its Elem,
// so reading `.Elem` on the readonly directly yields the slice — NOT the
// element type T.  Peel first when you need the slice's own fields
// (e.g. its element type for an element-pointer GEP).
func peelReadonly(t @types.Type) @types.Type {
	for t != nil && t.Kind == types.TYP_READONLY { t = t.Elem }
	return t
}

// peelTransparent strips every IR-transparent type wrapper — `readonly`
// (`.Elem`), named-distinct `type X ...` (`.Underlying`), and alias
// `type X = ...` (`.Target`) — to a fixpoint, returning the underlying
// represented type.  All three change a type's *meaning*, not its runtime
// layout, so any representation/dispatch decision (slot type, struct-field
// GEP, the managed/raw-ptr-to-struct predicates below) must see through them.
// A missed peel leaves a `readonly @Box` / named-`@Box` failing every
// Kind-test, so a field read falls through to the literal-0 fallback in
// genSelector (silent data corruption).
func peelTransparent(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else if t.Kind == types.TYP_ALIAS && t.Target != nil {
			t = t.Target
		} else {
			return t
		}
	}
	return t
}

// isCharSliceType reports whether t is a char slice — *[]char or @[]char —
// through any transparent wrapper: an outer `readonly`, a distinct named type
// (`type Str @[]char`), or an alias, all stripped by peelTransparent.  The
// callers are string-literal → {ptr,len} materialization gates (gen_stmt /
// gen_composite / gen_control / gen_return / gen_print); a missed peel leaves
// the gate false, so the raw string data pointer is stored into the slice slot
// with a garbage length word — and for a managed destination it is RefInc'd as
// if it were a 4-word header (`extractvalue i8* ...`, invalid IR).  A distinct
// named char-slice destination must materialize exactly like its underlying
// @[]char, hence the peel.  (An element `readonly` is peeled separately below
// for the char-width test.)
func isCharSliceType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	if t.Kind != types.TYP_SLICE && t.Kind != types.TYP_MANAGED_SLICE {
		return false
	}
	var elem @types.Type = t.Elem
	for elem != nil && elem.Kind == types.TYP_READONLY { elem = elem.Elem }
	return elem != nil && elem.Width == 8
}

// isCharArrayType returns true if t is [N]char or [N]readonly char through any
// transparent wrapper (an outer `readonly`, a distinct named `type Arr [N]char`,
// or an alias), all stripped by peelTransparent — so the string-literal → array
// materialization gate (gen_stmt / gen_composite) fires for a distinct named
// char-array destination just as it does for the underlying [N]char.  (An
// element `readonly` is peeled separately below for the char-width test.)
func isCharArrayType(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil { return false }
	if t.Kind != types.TYP_ARRAY { return false }
	var elem @types.Type = t.Elem
	for elem != nil && elem.Kind == types.TYP_READONLY { elem = elem.Elem }
	return elem != nil && elem.Width == 8
}

// isNillableType returns true if t can hold nil.
func isNillableType(t @types.Type) bool {
	if t == nil { return false }
	var k int = t.Kind
	return k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE || k == types.TYP_MANAGED_PTR ||
			k == types.TYP_POINTER
}

// isStructOrArrayAlloc returns true if instr is an alloca for a struct or array.
func isStructOrArrayAlloc(instr @Instr) bool {
	if instr.Op != iropcode.OP_ALLOC { return false }
	if instr.TypeArg == nil { return false }
	return instr.TypeArg.Kind == types.TYP_STRUCT || instr.TypeArg.Kind == types.TYP_ARRAY
}

// isAggregateAllocToLoad reports whether `val` is an alloca holding a
// struct/array VALUE that must be loaded before it is stored into an element
// slot of that same aggregate kind.  A composite literal (`S{...}` /
// `[M]T{...}`) returns the alloca POINTER; storing it raw would write the
// 8-byte pointer into the aggregate-sized slot.  The element-type match is
// what distinguishes a value slot (load) from a pointer-to-aggregate slot
// (store the pointer as-is).  Covers struct AND array elements — the array
// case is the nested-array literal `[N][M]T{...}` and the whole-inner-array
// store `a[i] = [M]T{...}`, which the struct-only guard used to miss (storing
// the inner alloca pointer into the inner-array slot → garbage).
func isAggregateAllocToLoad(val @Instr, elemTyp @types.Type) bool {
	if val == nil || val.Op != iropcode.OP_ALLOC || val.TypeArg == nil || elemTyp == nil {
		return false
	}
	// Peel IR-transparent wrappers (readonly / named / alias) on both the source
	// alloca's element type and the destination type before matching kinds: a
	// `readonly S` / named-struct slot still holds the aggregate BY VALUE and
	// must load (a `var G readonly S = S{...}` global init stores the alloca
	// pointer otherwise), while a pointer destination still doesn't match and
	// stores the address as-is.
	var src @types.Type = peelTransparent(val.TypeArg)
	var dest @types.Type = peelTransparent(elemTyp)
	if src == nil || dest == nil { return false }
	if src.Kind == types.TYP_STRUCT && dest.Kind == types.TYP_STRUCT {
		return true
	}
	if src.Kind == types.TYP_ARRAY && dest.Kind == types.TYP_ARRAY {
		return true
	}
	return false
}

// isManagedPtrToStruct returns true if t is @T where T is a struct, peeling
// any IR-transparent wrapper first so `readonly @Box` / named-`@Box` is still
// recognized (callers must read the struct off the PEELED type's `.Elem` — see
// peelTransparent — not the raw `t.Elem`, which is the wrapper's inner).
func isManagedPtrToStruct(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil || t.Kind != types.TYP_MANAGED_PTR || t.Elem == nil {
		return false
	}
	var e @types.Type = peelTransparent(t.Elem)
	return e != nil && e.Kind == types.TYP_STRUCT
}

// isRawPtrToStruct returns true if t is *T where T is a struct, peeling any
// IR-transparent wrapper first (mirrors isManagedPtrToStruct).
func isRawPtrToStruct(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil || t.Kind != types.TYP_POINTER || t.Elem == nil {
		return false
	}
	var e @types.Type = peelTransparent(t.Elem)
	return e != nil && e.Kind == types.TYP_STRUCT
}

// isFreshManagedPtr returns true if the instruction creates a new managed
// pointer (make/box/call), meaning refcount is already 1.
func isFreshManagedPtr(instr @Instr) bool {
	if instr == nil { return false }
	if instr.Op == iropcode.OP_CONST_NIL { return true }
	if instr.Op == iropcode.OP_BOX { return true }
	if instr.Op == iropcode.OP_MAKE { return true }
	if instr.Op == iropcode.OP_CALL && instr.Typ != nil && isManagedPtrType(instr.Typ) {
		return true
	}
	return false
}

// isFreshManagedSlice returns true if the instruction creates a new managed
// slice (make_slice), meaning refcount is already 1.
func isFreshManagedSlice(instr @Instr) bool {
	if instr == nil { return false }
	if instr.Op == iropcode.OP_CONST_NIL { return true }
	if instr.Op == iropcode.OP_MAKE_SLICE { return true }
	if instr.Op == iropcode.OP_CALL && instr.Typ != nil && isManagedSliceType(instr.Typ) {
		return true
	}
	return false
}

// isFreshManagedFuncValue returns true if the instruction creates a new
// managed func value (a func-value construction, nil, or a call returning
// one), meaning its data slot's refcount is already accounted for and a
// copy-site store must consumeTemp rather than RefInc.  Mirrors
// isFreshManagedPtr / isFreshManagedSlice.
func isFreshManagedFuncValue(instr @Instr) bool {
	if instr == nil { return false }
	if instr.Op == iropcode.OP_CONST_NIL { return true }
	if instr.Op == iropcode.OP_FUNC_VALUE { return true }
	// A call returning an @func value already owns its result (Axiom 3
	// retains it for the caller), so it is a fresh producer to MOVE, not a
	// borrow to RefInc — for a direct call (OP_CALL), an @func-value call
	// (OP_CALL_FUNC_VALUE), or an interface-method dispatch
	// (OP_CALL_IFACE_METHOD).
	if instr.Typ != nil && isManagedFuncValueType(instr.Typ) {
		if instr.Op == iropcode.OP_CALL { return true }
		if instr.Op == iropcode.OP_CALL_FUNC_VALUE { return true }
		if instr.Op == iropcode.OP_CALL_IFACE_METHOD { return true }
	}
	return false
}

// isFreshManagedIfaceValue returns true if the instruction produces a new
// managed interface value whose data slot is already refcount-1 (a fresh
// box, nil, or a call returning one), so a copy-site store must consumeTemp
// (move) rather than RefInc (copy).  A NON-fresh interface value is a
// borrowed load of an existing variable/field/element, which the consumer
// must RefInc.  Mirrors isFreshManagedFuncValue; OP_IFACE_VALUE is the
// boxing op (the @func analogue is OP_FUNC_VALUE).
func isFreshManagedIfaceValue(instr @Instr) bool {
	if instr == nil { return false }
	if instr.Op == iropcode.OP_CONST_NIL { return true }
	if instr.Op == iropcode.OP_IFACE_VALUE { return true }
	// A call returning an @Iface value already owns its result (Axiom 3
	// retains it for the caller), so it is a fresh producer to MOVE, not a
	// borrow to RefInc — for a direct call (OP_CALL), an @func-value call
	// (OP_CALL_FUNC_VALUE), or an interface-method dispatch
	// (OP_CALL_IFACE_METHOD).
	if instr.Typ != nil && isManagedIfaceValueType(instr.Typ) {
		if instr.Op == iropcode.OP_CALL { return true }
		if instr.Op == iropcode.OP_CALL_FUNC_VALUE { return true }
		if instr.Op == iropcode.OP_CALL_IFACE_METHOD { return true }
	}
	return false
}

// isFreshManagedValue dispatches to the per-kind freshness predicate for
// the managed-scalar type t — true iff instr is a fresh producer of that
// kind (a value whose refcount is already accounted for, so a copy-site
// MOVES it rather than RefInc'ing a borrow).  False for a non-managed-
// scalar t: aggregates never move (they always emitStructCopy), and
// non-managed types have no acquire.  The single freshness oracle for
// emitAcquireManagedScalar / emitStoreManagedSlot, so the four scalar
// kinds can't diverge on the move-vs-copy decision.
func isFreshManagedValue(instr @Instr, t @types.Type) bool {
	if isManagedPtrType(t) { return isFreshManagedPtr(instr) }
	if isManagedSliceType(t) { return isFreshManagedSlice(instr) }
	if isManagedFuncValueType(t) { return isFreshManagedFuncValue(instr) }
	if isManagedIfaceValueType(t) { return isFreshManagedIfaceValue(instr) }
	return false
}
