package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Type query helpers
// ============================================================

func TestIsSliceType() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.TypInt())
	if !isSliceType(t) {
		return fail("*[]int should be a slice type")
	}
	return ""
}

func TestIsSliceTypeManagedSlice() testing.TestResult {
	var t @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !isSliceType(t) {
		return fail("@[]int should be a slice type")
	}
	return ""
}

func TestIsSliceTypeNonSlice() testing.TestResult {
	if isSliceType(types.TypInt()) {
		return fail("int should not be a slice type")
	}
	return ""
}

func TestIsCharSliceType() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.TypChar())
	if !isCharSliceType(t) {
		return fail("*[]readonly char should be char slice")
	}
	return ""
}

func TestIsCharSliceTypeNotChar() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.TypInt())
	if isCharSliceType(t) {
		return fail("*[]int should not be char slice")
	}
	return ""
}

// *[]readonly char must match — element is char wrapped in TYP_READONLY.
// Without the const peel in isCharSliceType, the .Width check on the
// TYP_READONLY wrapper returns 0 and this fails. Regression test for
// the bug that caused conformance/086 to emit zero-length slices.
func TestIsCharSliceTypeConstElem() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	if !isCharSliceType(t) {
		return fail("*[]readonly char should be char slice")
	}
	return ""
}

// @[]readonly char is also a char slice.
func TestIsCharSliceTypeManagedConstElem() testing.TestResult {
	var t @types.Type = types.MakeManagedSliceType(types.MakeReadonlyType(types.TypChar()))
	if !isCharSliceType(t) {
		return fail("@[]readonly char should be char slice")
	}
	return ""
}

// *[]readonly int is NOT a char slice — the const wrapper peels but
// the underlying element is still int (64-bit), not char.
func TestIsCharSliceTypeConstNotChar() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypInt()))
	if isCharSliceType(t) {
		return fail("*[]readonly int should not be char slice")
	}
	return ""
}

// An OUTER readonly wrapper must peel: `readonly *[]int` is still a
// slice.  These predicates are called with the variable's declared
// type (not the stripConstForIR-normalized Instr type), so a
// `readonly`-wrapped slice target reaches them un-normalized.
func TestIsSliceTypeReadonlyOuter() testing.TestResult {
	var t @types.Type = types.MakeReadonlyType(types.MakeSliceType(types.TypInt()))
	if !isSliceType(t) {
		return fail("readonly *[]int should be a slice type")
	}
	return ""
}

// `readonly @[]int` is still a managed slice — it owns a refcount the
// caller must RefInc/RefDec, so isManagedSliceType must see through the
// outer readonly or the backing leaks (or double-frees).
func TestIsManagedSliceTypeReadonlyOuter() testing.TestResult {
	var t @types.Type = types.MakeReadonlyType(types.MakeManagedSliceType(types.TypInt()))
	if !isManagedSliceType(t) {
		return fail("readonly @[]int should be a managed slice type")
	}
	return ""
}

// `readonly *[]readonly char` (the read-only string-global shape) is a
// char slice.  Without the outer peel, string-literal init stores a
// bare pointer with a garbage length word.
func TestIsCharSliceTypeReadonlyOuter() testing.TestResult {
	var t @types.Type = types.MakeReadonlyType(
		types.MakeSliceType(types.MakeReadonlyType(types.TypChar())))
	if !isCharSliceType(t) {
		return fail("readonly *[]readonly char should be char slice")
	}
	return ""
}

// A bare `readonly int` is not a slice — peeling the outer readonly
// leaves a scalar.
func TestIsSliceTypeReadonlyScalar() testing.TestResult {
	var t @types.Type = types.MakeReadonlyType(types.TypInt())
	if isSliceType(t) {
		return fail("readonly int should not be a slice type")
	}
	return ""
}

func TestIsNillableTypeSlice() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.TypInt())
	if !isNillableType(t) {
		return fail("*[]int should be nillable")
	}
	return ""
}

func TestIsNillableTypeManagedPtr() testing.TestResult {
	var t @types.Type = types.MakeManagedPtrType(types.TypInt())
	if !isNillableType(t) {
		return fail("@int should be nillable")
	}
	return ""
}

func TestIsNillableTypeInt() testing.TestResult {
	if isNillableType(types.TypInt()) {
		return fail("int should not be nillable")
	}
	return ""
}

func TestIsManagedPtrToStruct() testing.TestResult {
	var s @types.Type = types.MakeStructType("Node", noFields)
	var t @types.Type = types.MakeManagedPtrType(s)
	if !isManagedPtrToStruct(t) {
		return fail("@Node should be managed-ptr-to-struct")
	}
	return ""
}

func TestIsManagedPtrToStructNonStruct() testing.TestResult {
	var t @types.Type = types.MakeManagedPtrType(types.TypInt())
	if isManagedPtrToStruct(t) {
		return fail("@int should not be managed-ptr-to-struct")
	}
	return ""
}

// ============================================================
// Fresh allocation detection
// ============================================================

func TestIsFreshManagedPtrNil() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var instr @Instr = b.EmitConstNil(types.MakeManagedPtrType(nil))
	if !isFreshManagedPtr(instr) {
		return fail("nil should be fresh managed ptr")
	}
	return ""
}

func TestIsFreshManagedPtrMake() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var s @types.Type = types.MakeStructType("S", noFields)
	var instr @Instr = b.EmitMake(s)
	if !isFreshManagedPtr(instr) {
		return fail("make should be fresh managed ptr")
	}
	return ""
}

func TestIsFreshManagedSliceMakeSlice() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var n @Instr = b.EmitConstInt(10, types.TypInt())
	var instr @Instr = b.EmitMakeSlice(types.TypInt(), n)
	if !isFreshManagedSlice(instr) {
		return fail("make_slice should be fresh managed slice")
	}
	return ""
}
