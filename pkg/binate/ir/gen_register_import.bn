package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// RegisterImport processes an imported package's AST (from .bni or
// merged .bn) and registers its types, function signatures, and
// constants for cross-package resolution.  alias is the short
// package name (e.g., "parser"), file is the parsed .bni/.bn AST.
//
// The sibling helper registerImportFieldsAndFuncs (in gen_import.bn)
// is the second-pass variant that runs against an already-registered
// set of struct names — used by the multi-file RegisterImports plural
// entry point.  registerImportConstGroup (also in gen_import.bn) is
// shared between both paths for iota-group constants.
func RegisterImport(alias @[]char, path *[]readonly char,
		file @ast.File, gc @GenCtx) {
	if file == nil || len(file.Decls) == 0 { return }
	// gc is the threaded per-compilation context; gc.PkgPath is empty here
	// (gc.Mod not yet GeneratePackage'd) — qualification uses the explicit
	// import path.
	RecordImportPath(gc.Mod, alias, path)
	gc.Mod.CurrentImportAlias = alias

	// First pass: register struct type names (for self-referential types).
	// Generic struct decls (TypeParams non-empty) instead get stashed
	// in gc.GenericTypeDecls under the import alias — instantiations
	// register lazily into Module.Structs at use sites (Slice 7 of
	// plan-generics.md).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				gc.GenericTypeDecls = slices.Append[@ast.Decl](
					gc.GenericTypeDecls, d)
				gc.GenericTypeDeclPkgs = slices.Append[@[]char](
					gc.GenericTypeDeclPkgs, buf.CopyStr(alias))
				gc.GenericTypeDeclFiles = slices.Append[@ast.File](
					gc.GenericTypeDeclFiles, file)
				continue
			}
			var qualName @[]char = buildQualName(gc.Mod, alias, d.Name)
			var ms ModuleStruct
			ms.Name = qualName
			var noFields2 @[]@types.Field
			ms.Typ = types.MakeStructType(qualName, noFields2)
			gc.Mod.Structs = slices.Append[ModuleStruct](gc.Mod.Structs, ms)
		}
	}

	// Second pass: populate struct fields on the existing type objects
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 { continue }
			var qualName @[]char = buildQualName(gc.Mod, alias, d.Name)
			var si int = lookupStructIdx(gc, qualName)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(gc, fd.Type)
					fields = slices.Append[@types.Field](fields, f)
				}
				// Break chained assignment for compiled mode compatibility
				var typ @types.Type = gc.Mod.Structs[si].Typ
				typ.Fields = fields
				gc.Mod.Structs[si].Fields = fields
			}
		}
	}

	// Register type aliases
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isNonStructTypeDecl(d) {
			var qualName @[]char = buildQualName(gc.Mod, alias, d.Name)
			var ta ModuleTypeAlias
			ta.Name = qualName
			ta.Typ = typeDeclEntryType(gc, qualName, d)
			gc.Mod.TypeAliases = slices.Append[ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		}
	}

	// Register function and method signatures, and add extern funcs.
	// Generic decls (TypeParams non-empty) carry their body in the
	// imported .bni — register the AST under the import alias so
	// cross-package instantiation at the consumer's call site can
	// look it up via lookupGenericDeclPkg.  Slice 7 of
	// plan-generics.md (Q7 DECIDED 2026-05-21: source-text bodies
	// in .bni).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			if d.Recv == nil &&
					lookupGenericDeclPkg(gc, alias, d.Name) == nil {
				// Methods can't be generic in Slice 1 surface;
				// guard against any future extension producing
				// generic methods that the IR side doesn't yet
				// know how to monomorphize cross-pkg.
				gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
				gc.GenericDeclPkgs = slices.Append[@[]char](
					gc.GenericDeclPkgs, buf.CopyStr(alias))
				gc.GenericDeclFiles = slices.Append[@ast.File](
					gc.GenericDeclFiles, file)
			}
			continue
		}
		var qualName @[]char
		var sigParams @[]@types.Type
		var extParams @[]@Param
		if d.Recv != nil {
			qualName = methodQualName(alias, d)
			var rt @types.Type = resolveTypeExpr(gc, d.Recv.Type)
			sigParams = slices.Append[@types.Type](sigParams, rt)
			var rp @Param = make(Param)
			rp.Name = d.Recv.Name
			rp.Typ = rt
			extParams = slices.Append[@Param](extParams, rp)
		} else {
			qualName = buildQualName(gc.Mod, alias, d.Name)
		}
		for j := 0; j < len(d.Params); j++ {
			var pt @types.Type = resolveTypeExpr(gc, d.Params[j].Type)
			sigParams = slices.Append[@types.Type](sigParams, pt)
			var p @Param = make(Param)
			p.Name = d.Params[j].Name
			p.Typ = pt
			extParams = slices.Append[@Param](extParams, p)
		}

		var sig FuncSig
		sig.Name = qualName
		sig.Params = sigParams
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(gc, d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)

		var ef @Func = NewExternFunc(gc.PkgPath, qualName, extParams, sigResults)
		// pkg/bootstrap functions with no body are true C externs
		// (defined in binate_runtime.c) and need C ABI for big-struct
		// returns (sret). Functions with bodies are pure-Binate and
		// use Binate ABI (struct return by value); marking them
		// IsCExtern would cause an ABI mismatch at the call site.
		if streq(alias, "pkg/bootstrap") && d.Body == nil { ef.IsCExtern = true }
		gc.Mod.AddFunc(ef)
	}

	// Register constants
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			if d.Value != nil {
				var v int
				var ok bool
				v, ok = importConstStampVal(gc, d.Value)
				if !ok {
					v, ok = evalConstExpr(gc, d.Value, 0)
				}
				if ok {
					var qualName @[]char = buildQualName(gc.Mod, alias, d.Name)
					var mc ModuleConst
					mc.Name = qualName
					mc.Val = v
					if d.TypeRef != nil {
						mc.Typ = resolveTypeExpr(gc, d.TypeRef)
					}
					gc.Mod.Consts = slices.Append[ModuleConst](gc.Mod.Consts, mc)
				}
			}
		}
		if d.Kind == ast.DECL_GROUP {
			registerImportConstGroup(gc, alias, d)
		}
		// Slice 2.7: register imported interfaces in
		// the module's interface registry under the import alias's pkg, so
		// `*alias.Iface` / `@alias.Iface` use sites resolve and
		// findInterfaceMethod / findImplVtableName see the
		// imported interface's method set.
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, alias, file)
		}
	}
	var emptyAlias @[]char
	gc.Mod.CurrentImportAlias = emptyAlias
}

// RegisterFuncExterns registers ONLY function/method signatures + extern Funcs
// for the given packages, keyed by full path (`paths`), deduped against
// already-registered sigs.  For packages a monomorphized cross-package generic
// body may CALL but that the consumer does not directly import: their
// structs/interfaces are already registered transitively (RegisterStructTypes /
// RegisterAllInterfaces), so only the func externs — the `declare`s the body's
// calls need to link — are missing.  Mirrors RegisterImport's func loop but
// omits structs/consts/interfaces (already registered) and the alias-map
// population (the consumer resolves these qualifiers via the generic's
// defining-file overlay, not its own import map).  pushFileImports installs each
// package's own imports so a func's cross-package param/result types resolve.
func RegisterFuncExterns(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx) {
	for k := 0; k < len(aliases); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		var snap AliasMapSnapshot = pushFileImports(gc.Mod, file)
		var savedAlias @[]char = gc.Mod.CurrentImportAlias
		gc.Mod.CurrentImportAlias = aliases[k]
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind != ast.DECL_FUNC { continue }
			// Generic decls have no direct symbol — they're instantiated
			// lazily at use sites; skip (a monomorphized body, not an extern).
			if len(d.TypeParams) > 0 { continue }
			var qualName @[]char
			var sigParams @[]@types.Type
			var extParams @[]@Param
			if d.Recv != nil {
				qualName = methodQualName(path, d)
				var rt @types.Type = resolveTypeExpr(gc, d.Recv.Type)
				sigParams = slices.Append[@types.Type](sigParams, rt)
				var rp @Param = make(Param)
				rp.Name = d.Recv.Name
				rp.Typ = rt
				extParams = slices.Append[@Param](extParams, rp)
			} else {
				qualName = buildQualName(gc.Mod, path, d.Name)
			}
			// Dedup: skip if this sig is already registered (a direct import,
			// or a previously-processed extern-dep package) — a second extern
			// Func would emit a duplicate `declare`.
			if funcSigRegistered(gc, qualName) { continue }
			for j := 0; j < len(d.Params); j++ {
				var pt @types.Type = resolveTypeExpr(gc, d.Params[j].Type)
				sigParams = slices.Append[@types.Type](sigParams, pt)
				var p @Param = make(Param)
				p.Name = d.Params[j].Name
				p.Typ = pt
				extParams = slices.Append[@Param](extParams, p)
			}
			var sig FuncSig
			sig.Name = qualName
			sig.Params = sigParams
			var sigResults @[]@types.Type
			for j := 0; j < len(d.Results); j++ {
				sigResults = slices.Append[@types.Type](sigResults,
					resolveTypeExpr(gc, d.Results[j]))
			}
			sig.Results = sigResults
			if len(sigResults) > 1 {
				sig.MultiReturnType = makeMultiReturnStructType(sigResults)
			}
			gc.Mod.FuncSigs = slices.Append[FuncSig](gc.Mod.FuncSigs, sig)
			var ef @Func = NewExternFunc(gc.PkgPath, qualName, extParams, sigResults)
			// A pkg/bootstrap C extern (no body) needs C ABI for big-struct
			// returns; matches RegisterImport's IsCExtern hint.
			if streq(path, "pkg/bootstrap") && d.Body == nil { ef.IsCExtern = true }
			gc.Mod.AddFunc(ef)
		}
		gc.Mod.CurrentImportAlias = savedAlias
		popFileImports(gc.Mod, snap)
	}
}

// RegisterGenericDecls stashes the generic FUNC / generic STRUCT / generic
// INTERFACE decls of the given packages into gc.Generic*Decls/Pkgs/Files,
// keyed by full path (`paths`), deduped via the lookupGeneric*DeclPkg checks.
// RegisterImport only stashes generic decls for the consumer's DIRECT imports;
// a generic body that instantiates ANOTHER package's generic (e.g.
// genlib.Sum[T] -> mid.F[T], where mid is a transitive, not direct, import)
// needs mid's generic decl available to monomorphize mid.F[int].  Generic
// decls are in-memory only (no `.ll` emission — instantiations register lazily
// at use sites), so registering them across the whole transitive closure is
// cheap and safe.  Mirrors RegisterImport's stash blocks; registers ONLY
// generic things (non-generic structs/sigs/consts/ifaces are handled by
// RegisterStructTypes / RegisterImports / RegisterFuncExterns).
func RegisterGenericDecls(aliases @[]@[]char, paths @[]@[]char,
		files *[]@ast.File, gc @GenCtx) {
	for k := 0; k < len(aliases); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if len(d.TypeParams) == 0 { continue }
			// Generic struct: DECL_TYPE + TEXPR_STRUCT (mirror RegisterImport).
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil &&
					d.TypeRef.Kind == ast.TEXPR_STRUCT {
				if lookupGenericTypeDeclPkg(gc, path, d.Name) == nil {
					gc.GenericTypeDecls = slices.Append[@ast.Decl](
						gc.GenericTypeDecls, d)
					gc.GenericTypeDeclPkgs = slices.Append[@[]char](
						gc.GenericTypeDeclPkgs, buf.CopyStr(path))
					gc.GenericTypeDeclFiles = slices.Append[@ast.File](
						gc.GenericTypeDeclFiles, file)
				}
				continue
			}
			// Generic interface: DECL_INTERFACE + TypeParams.
			if d.Kind == ast.DECL_INTERFACE {
				if lookupGenericIfaceDeclPkg(gc, path, d.Name) == nil {
					gc.GenericIfaceDecls = slices.Append[@ast.Decl](
						gc.GenericIfaceDecls, d)
					gc.GenericIfaceDeclPkgs = slices.Append[@[]char](
						gc.GenericIfaceDeclPkgs, buf.CopyStr(path))
					gc.GenericIfaceDeclFiles = slices.Append[@ast.File](
						gc.GenericIfaceDeclFiles, file)
				}
				continue
			}
			// Generic func (non-method — methods can't be generic in the
			// Slice 1 surface, matching RegisterImport's d.Recv == nil guard).
			if d.Kind == ast.DECL_FUNC && d.Recv == nil {
				if lookupGenericDeclPkg(gc, path, d.Name) == nil {
					gc.GenericDecls = slices.Append[@ast.Decl](
						gc.GenericDecls, d)
					gc.GenericDeclPkgs = slices.Append[@[]char](
						gc.GenericDeclPkgs, buf.CopyStr(path))
					gc.GenericDeclFiles = slices.Append[@ast.File](
						gc.GenericDeclFiles, file)
				}
			}
		}
	}
}

// funcSigRegistered reports whether a func sig named qualName is already in
// gc.Mod.FuncSigs (so RegisterFuncExterns doesn't emit a duplicate extern /
// `declare`).  Direct name match — qualName is already the full-path form.
func funcSigRegistered(gc @GenCtx, qualName *[]readonly char) bool {
	for i := 0; i < len(gc.Mod.FuncSigs); i++ {
		if streq(gc.Mod.FuncSigs[i].Name, qualName) { return true }
	}
	return false
}

// Per-file import overlay for the CURRENT module: overlayFileImports +
// declImportFile let GeneratePackage resolve each decl's qualifiers against
// its own file's imports.  Split out of gen_import.bn to keep it under the
// file-length limit.

// overlayFileImports resets the alias map to `base` then overlays just ONE
// file's imports, so the current module's qualifiers resolve per-file: a
// qualifier `dep` in file F binds to F's `import dep "..."`, not whichever
// file won the merged first-wins dedup.  F's own imports are AUTHORITATIVE:
// any base entry whose alias F also rebinds is dropped before F's imports are
// recorded, so F wins even when `base` already carries a DIFFERENT package
// under the same short alias.  This matters because RecordImportPath is
// first-wins: the generic-instantiation sites (ensureInstantiated*) pass a
// `base` captured at the USE site, which carries the CONSUMER's short aliases;
// without the drop, a consumer `import dep "pkg/other"` would defeat the
// generic's own `import dep "pkg/dep"`, binding a qualified field/method type
// to the WRONG package (wrong layout/GEP — silent miscompile).  For the per-decl
// callers in GeneratePackage `base` is the clean post-RegisterImports snapshot
// (full-path entries, no short aliases), so the drop is a no-op there.
func overlayFileImports(m @Module, base AliasMapSnapshot, f @ast.File) {
	if f == nil {
		RestoreAliasMapState(m, base)
		return
	}
	// Rebuild from base, dropping entries F will rebind, into FRESH arrays (do
	// not mutate base's backing — callers restore from the same snapshot).
	var keptNames @[]@[]char
	var keptPaths @[]@[]char
	for i := 0; i < len(base.Names); i++ {
		if !fileRebindsAlias(f, base.Names[i]) {
			keptNames = slices.Append[@[]char](keptNames, base.Names[i])
			keptPaths = slices.Append[@[]char](keptPaths, base.Paths[i])
		}
	}
	m.ImportAliasNames = keptNames
	m.ImportAliasPaths = keptPaths
	for i := 0; i < len(f.Imports); i++ {
		var p @[]char = unquote(f.Imports[i].Path)
		var alias @[]char = f.Imports[i].Alias
		if len(alias) == 0 {
			alias = lastPathSegment(p)
		}
		RecordImportPath(m, alias, p)
	}
}

// fileRebindsAlias reports whether file f has an import whose (explicit, or
// implicit last-segment) alias equals `alias` — i.e. whether overlaying f
// should drop a base entry for `alias` so f's own import wins.
func fileRebindsAlias(f @ast.File, alias *[]readonly char) bool {
	for i := 0; i < len(f.Imports); i++ {
		var a @[]char = f.Imports[i].Alias
		if len(a) == 0 {
			a = lastPathSegment(unquote(f.Imports[i].Path))
		}
		if streq(a, alias) { return true }
	}
	return false
}

// fileByPath returns the AST file whose source path equals `path` (a decl's
// Pos.File), or nil.  ParseFile sets File.Pos to the source file, so this
// matches a merged decl back to the file it was parsed from.
func fileByPath(files @[]@ast.File, path *[]readonly char) @ast.File {
	for i := 0; i < len(files); i++ {
		if files[i] != nil && streq(files[i].Pos.File, path) {
			return files[i]
		}
	}
	return nil
}

// declImportFile returns the file whose imports govern the decl at `path`: its
// own per-file impl AST when known, else `merged`.  The fallback covers the
// .bni-prepended decls (interfaces / impls / externs from the package's own
// interface): their Pos.File is the .bni, not a .bn in `files`, and their
// qualified types resolve against the .bni's imports — which `merged` carries
// (the loader merges .bni imports into merged.Imports).
func declImportFile(files @[]@ast.File, merged @ast.File,
		path *[]readonly char) @ast.File {
	var f @ast.File = fileByPath(files, path)
	if f != nil {
		return f
	}
	return merged
}
