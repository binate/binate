package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

func TestRegisterImportFunc() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	// Parse a .bni-like source with a function declaration
	var src *[]readonly char = "package \"pkg/helper\"\nfunc Add(a int, b int) int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("helper", "pkg/helper", file, m)

	// The module should have an extern function
	if len(m.Funcs) == 0 {
		return fail("expected extern function in module")
	}
	var f @Func = m.Funcs[0]
	if !seq(f.Name, "pkg/helper.Add") { return fail("expected qualified name helper.Add") }
	if !f.IsExtern { return fail("expected extern function") }
	if len(f.Params) != 2 { return fail("expected 2 params") }
	if len(f.Results) != 1 { return fail("expected 1 result") }
	return ""
}

func TestRegisterImportStruct() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/geom\"\ntype Point struct {\n\tX int\n\tY int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("geom", "pkg/geom", file, m)

	// The struct type should be registered with qualified name
	var si int = lookupStructIdx(NewGenCtx(m), "pkg/geom.Point")
	if si < 0 { return fail("expected struct geom.Point registered") }
	if len(m.Structs[si].Fields) != 2 {
		return fail("expected 2 fields")
	}
	return ""
}

func TestRegisterImportConst() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/vals\"\nconst MAX int = 100\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("vals", "pkg/vals", file, m)

	var v int
	var found bool
	var vt @types.Type
	v, vt, found = lookupConst(NewGenCtx(m), "pkg/vals.MAX")
	if !found { return fail("expected constant vals.MAX") }
	if v != 100 { return fail("expected value 100") }
	return ""
}

func TestRegisterImportIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/color\"\nconst (\n\tRED int = iota\n\tGREEN\n\tBLUE\n)\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("color", "pkg/color", file, m)

	var rv int
	var rt @types.Type
	var rf bool
	rv, rt, rf = lookupConst(NewGenCtx(m), "pkg/color.RED")
	if !rf || rv != 0 { return fail("expected RED=0") }

	var gv int
	var gt @types.Type
	var gf bool
	gv, gt, gf = lookupConst(NewGenCtx(m), "pkg/color.GREEN")
	if !gf || gv != 1 { return fail("expected GREEN=1") }

	var bv int
	var bt @types.Type
	var bf bool
	bv, bt, bf = lookupConst(NewGenCtx(m), "pkg/color.BLUE")
	if !bf || bv != 2 { return fail("expected BLUE=2") }
	return ""
}
