package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

func TestRegisterImportFunc() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	// Parse a .bni-like source with a function declaration
	var src *[]readonly char = "package \"pkg/helper\"\nfunc Add(a int, b int) int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("helper", "pkg/helper", file, NewGenCtx(m))

	// The module should have an extern function
	if len(m.Funcs) == 0 {
		return fail("expected extern function in module")
	}
	var f @Func = m.Funcs[0]
	if !seq(f.Name, "pkg/helper.Add") { return fail("expected qualified name helper.Add") }
	if !f.IsExtern { return fail("expected extern function") }
	if len(f.Params) != 2 { return fail("expected 2 params") }
	if len(f.Results) != 1 { return fail("expected 1 result") }
	return ""
}

// A TRANSITIVE .bni const (`const SZ int = a.VAL`, pkg/b imports pkg/a) is
// registered with the cross-package value (7) via the CHECKER STAMP — not via
// IR-gen re-resolving pkg/a through pkg/b's local alias (which would fail when
// the top-level importer doesn't import pkg/a).  This is the IR-gen half of the
// lockstep: the shared checker folds + stamps SZ on the .bni AST, and
// RegisterImport's importConstStampVal reads that stamp.  Drives the real
// channel (shared checker + the SAME parsed AST), not a pre-seeded const table.
func TestRegisterImportTransitiveConstViaStamp() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	// Parse each .bni ONCE; the same AST objects are stamped by the checker and
	// read by RegisterImport (the stamp rides on the shared AST node).
	var pa @parser.Parser = parser.NewInterface(
		strToBytes("package \"pkg/a\"\nconst VAL int = 7\n"), "a.bni")
	var fa @ast.File = pa.ParseFile()
	var pb @parser.Parser = parser.NewInterface(
		strToBytes("package \"pkg/b\"\nimport \"pkg/a\"\nconst SZ int = a.VAL\n"), "b.bni")
	var fb @ast.File = pb.ParseFile()

	// The shared checker folds a.VAL and stamps b.SZ (load pkg/a first).
	var c @types.Checker = types.NewChecker()
	c.LoadPackageInterface("pkg/a", fa)
	c.LoadPackageInterface("pkg/b", fb)
	m.Checker = c

	// Register ONLY pkg/b — modelling "main imports only pkg/b", so pkg/a's
	// consts are NOT in the module.  The transitive b.SZ can then be registered
	// ONLY via the checker stamp (importConstStampVal); without it, IR-gen's
	// evalConstExpr fallback would look up the unregistered pkg/a.VAL and drop
	// b.SZ.  (Registering pkg/a here too would make this test vacuous — the
	// fallback would find pkg/a.VAL and pass even without the stamp.)
	RegisterImport("b", "pkg/b", fb, NewGenCtx(m))

	var v int
	var found bool
	v, _, found = lookupConst(NewGenCtx(m), "pkg/b.SZ")
	if !found { return fail("expected transitive const pkg/b.SZ to be registered via the stamp") }
	if v != 7 { return fail("pkg/b.SZ should be the transitive value 7") }
	return ""
}

func TestRegisterImportStruct() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/geom\"\ntype Point struct {\n\tX int\n\tY int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("geom", "pkg/geom", file, NewGenCtx(m))

	// The struct type should be registered with qualified name
	var si int = lookupStructIdx(NewGenCtx(m), "pkg/geom.Point")
	if si < 0 { return fail("expected struct geom.Point registered") }
	if len(m.Structs[si].Fields) != 2 {
		return fail("expected 2 fields")
	}
	return ""
}

func TestRegisterImportConst() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/vals\"\nconst MAX int = 100\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("vals", "pkg/vals", file, NewGenCtx(m))

	var v int
	var found bool
	v, _, found = lookupConst(NewGenCtx(m), "pkg/vals.MAX")
	if !found { return fail("expected constant vals.MAX") }
	if v != 100 { return fail("expected value 100") }
	return ""
}

func TestRegisterImportIotaConsts() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	var src *[]readonly char = "package \"pkg/color\"\nconst (\n\tRED int = iota\n\tGREEN\n\tBLUE\n)\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "test.bni")
	var file @ast.File = p.ParseFile()

	RegisterImport("color", "pkg/color", file, NewGenCtx(m))

	var rv int
	var rf bool
	rv, _, rf = lookupConst(NewGenCtx(m), "pkg/color.RED")
	if !rf || rv != 0 { return fail("expected RED=0") }

	var gv int
	var gf bool
	gv, _, gf = lookupConst(NewGenCtx(m), "pkg/color.GREEN")
	if !gf || gv != 1 { return fail("expected GREEN=1") }

	var bv int
	var bf bool
	bv, _, bf = lookupConst(NewGenCtx(m), "pkg/color.BLUE")
	if !bf || bv != 2 { return fail("expected BLUE=2") }
	return ""
}

// RegisterStructTypes (the cross-package struct pre-pass) writes the
// IMPORTING module's per-module Structs table — inc 5b gave it a mod
// param.  A struct from a registered package must land in m.Structs
// under its full-path-qualified name, and must NOT be visible from an
// unrelated module (per-module isolation).
func TestRegisterStructTypesPopulatesImportingModule() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	var src *[]readonly char = "package \"pkg/shapes\"\ntype Circle struct {\n\tR int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "shapes.bni")
	var file @ast.File = p.ParseFile()
	var aliases @[]@[]char = @[]@[]char{"pkg/shapes"}
	var paths @[]@[]char = @[]@[]char{"pkg/shapes"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file

	RegisterStructTypes(aliases, paths, files, NewGenCtx(m))

	if lookupStructIdx(NewGenCtx(m), "pkg/shapes.Circle") < 0 {
		return fail("RegisterStructTypes must register pkg/shapes.Circle into m.Structs")
	}
	if lookupStructIdx(NewGenCtx(NewModule("other")), "pkg/shapes.Circle") >= 0 {
		return fail("registered struct must not be visible from an unrelated module")
	}
	return ""
}
