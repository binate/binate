package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the REPL / incremental IR-gen entry points in
// gen_repl.bn (GenDecl + GenSyntheticFunc).  Each test
// establishes module state via genFromSource (a normal pass on
// a tiny program), then exercises the per-decl path as if the
// REPL prompt called it.

// ============================================================
// GenDecl
// ============================================================

// TestGenDeclFunc verifies that a single func decl lowered via
// GenDecl appends a function with the expected name to the
// existing module's Funcs slice and returns no error message.
func TestGenDeclFunc() testing.TestResult {
	// Establish module state with a normal pass first.
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialFuncs int = len(m.Funcs)

	// Parse and lower a new func decl as if it came from the prompt.
	var declSrc *[]readonly char = "func double(x int) int { return x * 2 }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }
	if len(m.Funcs) != initialFuncs + 1 {
		return fail("module Funcs did not grow by exactly one")
	}
	// New func is added with the current module's qualifier.
	var found bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.double") { found = true }
	}
	if !found { return fail("new func 'test.double' not in module Funcs") }
	return ""
}

// TestGenDeclStructType verifies that a `type T struct {...}`
// decl with no managed fields registers in moduleStructs so
// subsequent IR-gen of expressions referencing T resolves
// against the new type.
func TestGenDeclStructType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var declSrc *[]readonly char = "type Point struct { X int; Y int }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl rejected struct type") }
	if lookupStructIdx("Point") < 0 {
		return fail("Point not registered in moduleStructs")
	}
	return ""
}

// TestGenDeclManagedFieldStructAccepted verifies that a struct
// containing a managed field is now accepted at the prompt:
// registered in moduleStructs, AND a `__dtor_<T>` plus
// `__copy_<T>` (and a `__dtor_` for the field's managed-slice
// type) are emitted into m.Funcs.
func TestGenDeclManagedFieldStructAccepted() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialFuncs int = len(m.Funcs)

	var declSrc *[]readonly char = "type Bag struct { items @[]int }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 {
		return fail("managed-field struct should be accepted now")
	}
	if lookupStructIdx("Bag") < 0 {
		return fail("Bag not registered in moduleStructs")
	}
	if len(m.Funcs) <= initialFuncs {
		return fail("expected helper funcs added to m.Funcs")
	}
	// Spot-check: Bag's struct dtor + copy must both be present.
	// Names are qualified by NewFunc with currentModulePkgPath
	// ("test"), so the linker symbols read as `test.__dtor_Bag`
	// / `test.__copy_Bag`.
	var sawDtor bool = false
	var sawCopy bool = false
	for i := initialFuncs; i < len(m.Funcs); i++ {
		var nm @[]char = m.Funcs[i].Name
		if seq(nm, "test.__dtor_Bag") { sawDtor = true }
		if seq(nm, "test.__copy_Bag") { sawCopy = true }
	}
	if !sawDtor { return fail("expected test.__dtor_Bag in m.Funcs") }
	if !sawCopy { return fail("expected test.__copy_Bag in m.Funcs") }
	return ""
}

// TestGenDeclManagedFieldStructDedupsFieldDtor verifies that
// declaring two structs with the same managed-slice field type
// only emits the field's __dtor_ once.  Without dedup against
// m.Funcs, the second decl would re-emit the field's dtor.
func TestGenDeclManagedFieldStructDedupsFieldDtor() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	// Decl 1 — first struct with @[]int field.
	var d1Src *[]readonly char = "type Bag struct { items @[]int }"
	var p1 @parser.Parser = parser.New(strToBytes(d1Src), "<repl>")
	var d1 @ast.Decl = p1.ParseTopLevelDecl()
	if len(GenDecl(d1, m)) > 0 { return fail("decl 1 rejected") }
	var afterFirst int = len(m.Funcs)

	// Decl 2 — second struct with the same @[]int field type.
	// Must emit __dtor_Box + __copy_Box only; the @[]int
	// helpers were already added by decl 1 and must NOT
	// re-appear.
	var d2Src *[]readonly char = "type Box struct { items @[]int }"
	var p2 @parser.Parser = parser.New(strToBytes(d2Src), "<repl>")
	var d2 @ast.Decl = p2.ParseTopLevelDecl()
	if len(GenDecl(d2, m)) > 0 { return fail("decl 2 rejected") }

	// Newly-added funcs from decl 2 must be Box-only — no
	// re-emission of the shared @[]int dtor / copy.  Names
	// are qualified by NewFunc.
	for i := afterFirst; i < len(m.Funcs); i++ {
		var nm @[]char = m.Funcs[i].Name
		if !seq(nm, "test.__dtor_Box") &&
				!seq(nm, "test.__copy_Box") {
			return fail("decl 2 emitted an unexpected helper (dedup miss)")
		}
	}
	return ""
}

// TestGenDeclMethod verifies that a method declaration at the
// prompt is registered in moduleFuncs under the qualified
// `<pkg>.<TypeName>.<Method>` form, and that the body is added
// to m.Funcs.  Mirrors what the file-load path does for
// methods, just collapsed into one pass.
func TestGenDeclMethod() testing.TestResult {
	// Establish a module with `type Point struct {...}` so the
	// receiver type resolves.  Two-step: first load a tiny
	// module + register the type via GenDecl, then add the method.
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	var typeDecl *[]readonly char = "type Point struct { X int; Y int }"
	var pt @parser.Parser = parser.New(strToBytes(typeDecl), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	if td == nil { return fail("type ParseTopLevelDecl returned nil") }
	if len(GenDecl(td, m)) > 0 { return fail("type GenDecl rejected") }

	var initialFuncs int = len(m.Funcs)
	var declSrc *[]readonly char = "func (p *Point) Sum() int { return p.X + p.Y }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	if d.Recv == nil { return fail("expected method (Recv != nil)") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl rejected method") }
	if len(m.Funcs) != initialFuncs + 1 {
		return fail("expected one new func added for the method")
	}
	// The method's qualified name follows the file-load convention.
	var found bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.Point.Sum") { found = true }
	}
	if !found {
		return fail("expected test.Point.Sum in m.Funcs")
	}
	return ""
}

// TestGenDeclTypeNamedNonStruct verifies `type Celsius int`
// (a named distinct non-struct type) registers a TYP_NAMED in
// moduleTypeAliases carrying its name and integer underlying — so
// resolveTypeExpr returns the named identity (method dispatch keys off
// the name) and the underlying scalar layout (lowering peels it).  It
// must NOT register as a struct.
func TestGenDeclTypeNamedNonStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialStructs int = len(moduleStructs)

	var declSrc *[]readonly char = "type Celsius int"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl rejected named non-struct") }
	var t @types.Type = lookupTypeAlias("Celsius")
	if t == nil {
		return fail("Celsius not registered in moduleTypeAliases")
	}
	if t.Kind != types.TYP_NAMED {
		return fail("Celsius must register as a TYP_NAMED")
	}
	if t.Underlying == nil || !t.Underlying.IsInteger() {
		return fail("Celsius underlying must be the integer type")
	}
	// A named non-struct is not a struct registration.
	if len(moduleStructs) != initialStructs {
		return fail("named non-struct must not register in moduleStructs")
	}
	return ""
}

// TestGenDeclTypeAlias verifies `type Result = @[]char` registers
// in moduleTypeAliases so identifiers referencing it during IR-gen
// resolve via lookupTypeAlias.
func TestGenDeclTypeAlias() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var declSrc *[]readonly char = "type Result = @[]char"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl rejected type alias") }
	if lookupTypeAlias("Result") == nil {
		return fail("Result not registered in moduleTypeAliases")
	}
	return ""
}

// TestGenDeclConst registers a single const via GenDecl and confirms
// the value is reachable through lookupConst (the same hook genIdent
// uses to resolve identifiers in subsequent IR-gen).
func TestGenDeclConst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialFuncs int = len(m.Funcs)

	var declSrc *[]readonly char = "const K int = 42"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }
	if len(m.Funcs) != initialFuncs {
		return fail("const decl must not append a func to the module")
	}

	var cval int
	var ctyp @types.Type
	var cfound bool
	cval, ctyp, cfound = lookupConst("K")
	if !cfound { return fail("const K not registered in moduleConsts") }
	if cval != 42 { return fail("const K has wrong value") }
	if ctyp == nil { return fail("typed const K should carry a non-nil type") }
	return ""
}

// TestGenDeclVar registers a single typed var via GenDecl and
// confirms it appears in moduleGlobals (so subsequent IR-gen of
// expressions referring to it route through the global path) and
// in m.Globals (so VM lowering can materialize it).
func TestGenDeclVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialGlobals int = len(m.Globals)

	var declSrc *[]readonly char = "var counter int"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }

	if len(m.Globals) != initialGlobals + 1 {
		return fail("m.Globals must grow by exactly one")
	}
	var added @Global = m.Globals[len(m.Globals) - 1]
	if !seq(added.Name, "counter") {
		return fail("new global must be named counter")
	}

	// moduleGlobals is the lookup target for IR-gen of subsequent
	// expressions; verify the entry is there too.
	var found bool = false
	for i := 0; i < len(moduleGlobals); i++ {
		if seq(moduleGlobals[i].Name, "counter") { found = true }
	}
	if !found {
		return fail("counter not registered in moduleGlobals")
	}
	return ""
}

// TestGenDeclVarUntypedLiteralAccepted verifies the literal-
// initializer path: `var x = 5` infers int and registers the
// global without requiring an explicit type.
func TestGenDeclVarUntypedLiteralAccepted() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var declSrc *[]readonly char = "var x = 5"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 {
		return fail("untyped var with literal init should be accepted")
	}
	return ""
}

// TestGenDeclVarUntypedNonLiteralRejected verifies that an
// untyped var with a non-literal initializer is still rejected
// — type inference for non-literal top-level inits would
// require threading the type checker through IR-gen.  Out of
// scope for the literal-init common case.
func TestGenDeclVarUntypedNonLiteralRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	// `var x = 1 + 2` has no TypeRef and a non-literal init.
	var declSrc *[]readonly char = "var x = 1 + 2"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	var msg @[]char = GenDecl(d, m)
	if len(msg) == 0 {
		return fail("expected diagnostic for non-literal-init untyped var")
	}
	return ""
}

// TestGenDeclMethodRedefinesInPlace verifies that re-typing a
// method via GenDecl updates moduleFuncs in place rather than
// appending — same property as the free-func path, keyed on the
// method's qualified `<pkg>.<TypeName>.<Method>` name.  The stale
// @Func left in m.Funcs is harmless (only the new @Func gets
// re-lowered; vm.Funcs is rebound by name).  This is the IR half
// of the Tier 4 method-redefinition follow-up.
func TestGenDeclMethodRedefinesInPlace() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	// Register the receiver type.
	var typeDecl *[]readonly char = "type Point struct { X int; Y int }"
	var pt @parser.Parser = parser.New(strToBytes(typeDecl), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	if td == nil { return fail("type ParseTopLevelDecl returned nil") }
	if len(GenDecl(td, m)) > 0 { return fail("type GenDecl rejected") }

	// First-time method definition.
	var d1Src *[]readonly char = "func (p *Point) Sum() int { return p.X + p.Y }"
	var pp1 @parser.Parser = parser.New(strToBytes(d1Src), "<repl>")
	var d1 @ast.Decl = pp1.ParseTopLevelDecl()
	if len(GenDecl(d1, m)) > 0 { return fail("first GenDecl rejected") }
	if countModuleFuncsByName("test.Point.Sum") != 1 {
		return fail("expected exactly 1 moduleFuncs entry for test.Point.Sum after first def")
	}

	// Redefinition with the same sig.
	var d2Src *[]readonly char = "func (p *Point) Sum() int { return p.X * 2 + p.Y * 3 }"
	var pp2 @parser.Parser = parser.New(strToBytes(d2Src), "<repl>")
	var d2 @ast.Decl = pp2.ParseTopLevelDecl()
	if len(GenDecl(d2, m)) > 0 { return fail("second GenDecl rejected") }
	if countModuleFuncsByName("test.Point.Sum") != 1 {
		return fail("moduleFuncs grew on method redef; expected in-place replace")
	}
	return ""
}

// TestGenDeclFuncRedefinesInPlace verifies that re-typing a func
// via GenDecl updates moduleFuncs in place rather than appending,
// so FIRST-match `lookupFunc*` paths see the new signature.  The
// stale @Func entry left in m.Funcs is harmless (only the new
// @Func gets re-lowered; vm.Funcs is rebound by name).
func TestGenDeclFuncRedefinesInPlace() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() int { return 1 }\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	// helper from the loaded file is in moduleFuncs once, qualified.
	var initialEntries int = countModuleFuncsByName("test.helper")
	if initialEntries != 1 {
		return fail("expected exactly 1 moduleFuncs entry for test.helper before redef")
	}

	// Redefine helper at the prompt with the same sig.
	var declSrc *[]readonly char = "func helper() int { return 99 }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }

	// moduleFuncs still has exactly one test.helper entry — replaced
	// in place, NOT appended.
	if countModuleFuncsByName("test.helper") != 1 {
		return fail("moduleFuncs grew on redef; expected in-place replace")
	}
	return ""
}

// countModuleFuncsByName returns how many entries in moduleFuncs
// have the given (already-qualified) name.
func countModuleFuncsByName(qname *[]readonly char) int {
	var count int = 0
	for i := 0; i < len(moduleFuncs); i++ {
		if seq(moduleFuncs[i].Name, qname) { count = count + 1 }
	}
	return count
}

// TestGenDeclConstGroup registers a grouped const via GenDecl
// (single-line form) and confirms each member is reachable.
func TestGenDeclConstGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	var declSrc *[]readonly char = "const ( A = 10; B = 20 )"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	if d.Kind != ast.DECL_GROUP {
		return fail("expected DECL_GROUP for multi-member const block")
	}

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }

	var av int
	var at @types.Type
	var af bool
	av, at, af = lookupConst("A")
	if !af || av != 10 { return fail("const A not registered with value 10") }
	var bv int
	var bt @types.Type
	var bf bool
	bv, bt, bf = lookupConst("B")
	if !bf || bv != 20 { return fail("const B not registered with value 20") }
	return ""
}

// ============================================================
// GenSyntheticFunc
// ============================================================

// TestGenSyntheticFunc verifies that a stmt list lowered through
// GenSyntheticFunc produces a callable IR function with the
// expected name and a non-empty entry block.  The surrounding
// module state is established by genFromSource on a tiny program
// first, mirroring the REPL pattern (load module, then evaluate
// prompt entries against it).
func TestGenSyntheticFunc() testing.TestResult {
	// Establish module state via a normal GenModule pass.
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	genFromSource(src)
	// Parse a tiny stmt list and lower it as a synthetic func.
	var stmtSrc *[]readonly char = "var x int = 5; x = x + 1"
	var p @parser.Parser = parser.New(strToBytes(stmtSrc), "repl")
	var ss @[]@ast.Stmt = p.ParseStmtList()
	if len(p.Errors()) != 0 {
		return fail("parse error in stmt list")
	}
	var f @Func = GenSyntheticFunc("__repl_0", ss)
	if f == nil { return fail("GenSyntheticFunc returned nil") }
	if !seq(f.Name, "test.__repl_0") { return fail("wrong synthetic name") }
	if len(f.Blocks) == 0 { return fail("expected at least entry block") }
	if len(f.Blocks[0].Instrs) == 0 {
		return fail("entry block has no instructions")
	}
	return ""
}

// ============================================================
// EnsureReplBodyHelpers
// ============================================================

// TestEnsureReplBodyHelpersNoopWhenNothingPending verifies that
// the drain is a no-op (no helpers appended) when no body has
// registered any pending managed-aggregate types since the last
// drain.  Models the "user types a stmt that doesn't touch any
// managed shape" prompt entry.
func TestEnsureReplBodyHelpersNoopWhenNothingPending() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialFuncs int = len(m.Funcs)
	EnsureReplBodyHelpers(m)
	if len(m.Funcs) != initialFuncs {
		return fail("EnsureReplBodyHelpers added funcs with no pending registrations")
	}
	return ""
}

// TestEnsureReplBodyHelpersBodyIntroducesManagedSlice verifies
// the core Tier 2 follow-up: a prompt-typed func body that uses
// an `@[]T` shape whose element type is destructible has its
// dtor emitted by the drain.  Without this fix, the body's
// end-of-statement RefDec called a `__dtor_ms_mp_Bag` symbol
// that didn't exist.  `@[]int` doesn't exercise the bug because
// `int` isn't destructible — RefDec on the backing alone is
// sufficient there, so no `__dtor_ms_int` is needed.
func TestEnsureReplBodyHelpersBodyIntroducesManagedSlice() testing.TestResult {
	// Loaded module defines a struct with a managed field so
	// `@Bag` is destructible; the body uses `@[]@Bag` which
	// requires `__dtor_ms_mp_Bag` (RefDec the `@Bag` ptr on each
	// slot at slice-free time).
	var src *[]readonly char =
		"package \"test\"\ntype Bag struct { items @[]int }\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	var declSrc *[]readonly char =
		"func f() { var s @[]@Bag = make_slice(@Bag, 3) }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	if len(GenDecl(d, m)) > 0 { return fail("GenDecl rejected") }

	var afterBody int = len(m.Funcs)
	EnsureReplBodyHelpers(m)
	if len(m.Funcs) <= afterBody {
		return fail("expected at least one helper appended for @[]@Bag")
	}
	// The drain emitted `__dtor_ms_mp_Bag` (qualified by NewFunc
	// to `test.__dtor_ms_mp_Bag`).  Spot-check the linker name.
	var foundDtor bool = false
	for i := afterBody; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.__dtor_ms_mp_Bag") {
			foundDtor = true
		}
	}
	if !foundDtor {
		return fail("expected test.__dtor_ms_mp_Bag helper in m.Funcs")
	}
	return ""
}

// TestEnsureReplBodyHelpersDedupsAgainstExisting verifies that
// a second prompt entry using the same `@[]T` shape doesn't
// re-emit a duplicate dtor — the drain checks against
// `collectExistingHelperNames(m)`, so the helper that landed
// for the first entry is recognized and skipped.  Uses
// `@[]@Bag` (destructible element) so the drain has actual
// work to dedup; `@[]int` would be a no-op both times.
func TestEnsureReplBodyHelpersDedupsAgainstExisting() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Bag struct { items @[]int }\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	// Entry 1: emit @[]@Bag dtor.
	var d1Src *[]readonly char =
		"func f() { var s @[]@Bag = make_slice(@Bag, 2) }"
	var p1 @parser.Parser = parser.New(strToBytes(d1Src), "<repl>")
	var d1 @ast.Decl = p1.ParseTopLevelDecl()
	if len(GenDecl(d1, m)) > 0 { return fail("entry 1 rejected") }
	EnsureReplBodyHelpers(m)

	// Entry 2: another body, same @[]@Bag shape.  GenDecl appends
	// the new func body to m.Funcs (exactly one entry); the
	// follow-up drain must NOT add anything because the helper is
	// already present from entry 1.
	var d2Src *[]readonly char =
		"func g() { var t @[]@Bag = make_slice(@Bag, 4) }"
	var p2 @parser.Parser = parser.New(strToBytes(d2Src), "<repl>")
	var d2 @ast.Decl = p2.ParseTopLevelDecl()
	if len(GenDecl(d2, m)) > 0 { return fail("entry 2 rejected") }
	var afterSecondBody int = len(m.Funcs)
	EnsureReplBodyHelpers(m)
	if len(m.Funcs) != afterSecondBody {
		return fail("expected dedup against existing @[]@Bag helper (drain re-emitted)")
	}
	return ""
}

// TestEnsureReplBodyHelpersResetsPendingLists verifies the
// drain clears `pendingMsDtors` / `pendingStructDtors` so the
// next prompt entry starts clean.  Otherwise stale entries
// would survive across prompt turns and re-trigger
// dedup'd-no-op ensure* calls forever.  Uses `@[]@Bag` so the
// body IR-gen actually populates `pendingMsDtors` (a managed
// slice of a non-destructible primitive doesn't).
func TestEnsureReplBodyHelpersResetsPendingLists() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Bag struct { items @[]int }\nfunc main() {}\n"
	var m @Module = genFromSource(src)

	var declSrc *[]readonly char =
		"func f() { var s @[]@Bag = make_slice(@Bag, 3) }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if len(GenDecl(d, m)) > 0 { return fail("GenDecl rejected") }
	if len(pendingMsDtors) == 0 {
		return fail("expected pendingMsDtors populated by body IR-gen")
	}
	EnsureReplBodyHelpers(m)
	if len(pendingMsDtors) != 0 {
		return fail("pendingMsDtors not reset by drain")
	}
	if len(pendingStructDtors) != 0 {
		return fail("pendingStructDtors not reset by drain")
	}
	return ""
}
