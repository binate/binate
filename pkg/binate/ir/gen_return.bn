package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Return statement lowering
// ============================================================
//
// genReturnStmt handles STMT_RETURN. Two shapes are supported:
//
//   - `return v1, ..., vN` — one expression per declared result.
//     Per-expr literal-shape coercions (OP_CONST_NIL → retTyp,
//     OP_CONST_STRING → string_to_chars, untyped-int width
//     adjustment) and the @[]T → *[]T conversion fire here.
//
//   - `return f(...)` — single expression for a multi-return
//     outer. The type checker validates that f's results match
//     the outer's declared results (per-result AssignableTo).
//     IR-gen emits one OP_CALL + one OP_EXTRACT per result; the
//     literal-shape coercions don't apply (call results aren't
//     literals), but the @[]T → *[]T conversion is still
//     applied per extracted value to match the per-expr path.
//
// After either shape produces `vals`, the shared tail handles
// ownership transfer (Axiom 3 RefInc, struct copy for managed
// fields), local cleanup, and the actual EmitReturn /
// EmitReturnTyped emission.

func genReturnStmt(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	if len(stmt.Exprs) == 0 {
		// Dec all managed ptr locals before void return
		var noRetExprs *[]@ast.Expr
		b = emitDecForManagedLocals(ctx, b, noRetExprs)
		var noRetVals @[]@Instr
		b.EmitReturn(noRetVals)
		return b
	}

	var vals @[]@Instr
	if len(stmt.Exprs) == 1 && len(ctx.Func.Results) > 1 {
		// Single-expression return for a multi-return function:
		// `return f(...)` where f returns the matching tuple.
		// The existing RefInc/copy and temp-cleanup machinery
		// below handles ownership transfer (extracted managed
		// values live in the call's struct temp, the
		// return-RefInc loop bumps for the caller, the temp dtor
		// decs at end-of-statement).
		var mr @Instr = genExpr(ctx, b, stmt.Exprs[0])
		b = ctx.CurBlock
		for i := 0; i < len(ctx.Func.Results); i++ {
			var resTyp @types.Type = ctx.Func.Results[i]
			var srcTyp @types.Type = resTyp
			if mr.Typ != nil && i < len(mr.Typ.Fields) {
				srcTyp = mr.Typ.Fields[i].Type
			}
			var val @Instr = b.EmitExtract(mr, i, srcTyp)
			// Convert @[]T to *[]T if the outer return is raw.  Peel the
			// declared result: a named raw-slice result (`type RS *[]int`)
			// has Kind TYP_NAMED, so an unpeeled test skips the conversion
			// and a 4-word @[]T is returned in a 2-word raw-slice slot
			// (invalid `ret %BnManagedSlice` against a %BnSlice result type).
			if peelTransparent(resTyp).Kind == types.TYP_SLICE &&
				isManagedSliceType(val.Typ) {
				val = b.EmitManagedToRaw(val)
			}
			vals = slices.Append[@Instr](vals, val)
		}
	} else {
		for i := 0; i < len(stmt.Exprs); i++ {
			var retTypHint @types.Type = nil
			if i < len(ctx.Func.Results) {
				retTypHint = ctx.Func.Results[i]
			}
			var val @Instr = genExprOrFuncRef(
				ctx, b, stmt.Exprs[i], retTypHint)
			b = ctx.CurBlock
			if i < len(ctx.Func.Results) {
				var retTyp @types.Type = ctx.Func.Results[i]
				if val.Op == OP_CONST_NIL && val.Typ != nil &&
						val.Typ.Kind == types.TYP_NIL {
					val.Typ = retTyp
				}
				// Convert string literal to *[]readonly char/@[]char.
				// TODO: string → *[]readonly char is dubious (mutable
				// view of read-only data); string → *[]readonly char
				// would be safe. @[]char is ok since
				// StringToChars copies.
				if isCharSliceType(retTyp) {
					if val.Op == OP_CONST_STRING {
						val = b.EmitStringToChars(val, retTyp)
						noteSPGrowingResult(ctx, val)
					}
				}
				// Convert @[]T to *[]T if function returns raw slice.  Peel
				// the declared result first — a named raw-slice result has
				// Kind TYP_NAMED, so an unpeeled test would skip the
				// conversion and emit an invalid `ret %BnManagedSlice`
				// against the %BnSlice result type.
				if peelTransparent(retTyp).Kind == types.TYP_SLICE &&
					isManagedSliceType(val.Typ) {
					// Temp stays in cleanup — RefDec at end of stmt.
					val = b.EmitManagedToRaw(val)
				}
				// Untyped scalar literals adopt the return type's width
				// (untyped int → integer, untyped float → float; e.g. an
				// untyped-float 0.5 returned at float32 fptruncs to single
				// precision rather than emitting `ret float <double>`).
				val = coerceScalarWidth(ctx, b, val, retTyp)
			}
			// Load struct/array value from alloca before returning
			// — but ONLY when the function returns the struct/array
			// value itself, not a pointer to it.  `return &h` for a
			// function declared as `*T` keeps the alloca pointer as
			// the SSA value; loading it would turn the pointer into
			// the struct value and produce `ret %T %loaded` against
			// a `define ptr` signature.  Surfaced by the .bni-
			// forward-decl + .bn-struct-body pattern in
			// plan-type-decls.md Phase 3b: cross-package opaque
			// callers see the function as returning `ptr`, the body
			// sees the full struct, and only the `return &local`
			// shape mismatches at LLVM emit time.
			if isStructOrArrayAlloc(val) {
				// Peel the declared result type before the struct/array
				// kind test: a named result (`func f() Row` over
				// `type Row [3]int`) has Kind TYP_NAMED, so an unpeeled
				// test skips the load and returns the alloca POINTER where
				// the by-value array/struct is expected (silent garbage).
				var retTyp @types.Type = nil
				if i < len(ctx.Func.Results) {
					retTyp = peelTransparent(ctx.Func.Results[i])
				}
				var retIsStructOrArray bool = retTyp != nil &&
					(retTyp.Kind == types.TYP_STRUCT ||
					 retTyp.Kind == types.TYP_ARRAY)
				if retIsStructOrArray {
					val = b.EmitLoad(val, val.TypeArg)
				}
			}
			vals = slices.Append[@Instr](vals, val)
		}
	}

	// Axiom 3: always RefInc return values (slow path). Scope cleanup
	// always RefDec's (no skip for returned locals).
	for ri := 0; ri < len(vals); ri++ {
		var rv @Instr = vals[ri]
		if rv.Typ != nil && isManagedPtrType(rv.Typ) {
			b.EmitRefInc(rv)
		}
		if rv.Typ != nil && isManagedSliceType(rv.Typ) {
			emitManagedSliceRefInc(ctx.Func, b, rv)
		}
		// @func: hand the caller an owned ref.  isFresh-guarded — a fresh
		// returned literal / call result is not a temp, so always-RefInc
		// would over-retain (the scope cleanup that balances it only
		// RefDec's named locals); consumeTemp transfers the existing ref.
		// A returned @func local RefInc's (the caller's copy) and is
		// balanced by the local's scope-end RefDec.
		if rv.Typ != nil && isManagedFuncValueType(rv.Typ) {
			if isFreshManagedFuncValue(rv) {
				consumeTemp(ctx, rv)
			} else {
				emitManagedFuncValueRefInc(ctx.Func, b, rv)
			}
		}
		// A fresh @Iface (a wrapAsIfaceValue box or a call result) already
		// owns its data ref and is NOT a registered cleanup temp, so it is
		// moved out via consumeTemp; a borrowed load (named local, param,
		// field) is retained for the caller with RefInc, balanced by the
		// local's scope-exit RefDec.  (Unlike @T / @[]T above, whose fresh
		// values are always registered temps, so they RefInc
		// unconditionally and let temp-cleanup balance.)
		if rv.Typ != nil && isManagedIfaceValueType(rv.Typ) {
			if isFreshManagedIfaceValue(rv) {
				consumeTemp(ctx, rv)
			} else {
				emitManagedIfaceValueRefInc(ctx.Func, b, rv)
			}
		}
		// Struct/array with managed fields: always copy (slow path).
		// Copy RefInc's managed fields for the caller's ownership.
		// Scope dtor will RefDec them on the local.
		if rv.Typ != nil && needsStructCopy(rv.Typ) {
			var tmpSlot @Instr = b.EmitAlloc(rv.Typ)
			b.EmitStore(tmpSlot, rv)
			emitStructCopy(ctx.Func, b, tmpSlot, rv.Typ)
		}
	}
	// Dec managed ptr locals before returning.
	b = emitDecForManagedLocals(ctx, b, stmt.Exprs)
	b = emitTempCleanupForReturn(ctx, b)
	if ctx.Func.MultiReturnType != nil {
		b.EmitReturnTyped(vals, ctx.Func.MultiReturnType)
	} else {
		b.EmitReturn(vals)
	}
	return b
}
