package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// genSelectorPtr returns the pointer to a struct field (for nested access or
// assignment).  `forDeref` says whether the returned address WILL be dereferenced
// (load/store) rather than merely address-computed (`&p.field`): when true, each
// pointer this function FOLLOWS to reach the field is nil-checked before the GEP
// (opt-in nil-checking, plan-nil-check-opt-in.md; a no-op unless
// GenCtx.EmitNilChecks is on).  Address-of callers pass false so `&nilp.field`
// stays a bare address computation (never a fault).  The recursion always passes
// true: a nested base (`p.a` in `p.a.b`) is loaded through to continue the chain,
// which is a deref regardless of the outermost context.
func genSelectorPtr(ctx @GenContext, b @Block, e @ast.Expr, forDeref bool) @Instr {
	if e.Kind == ast.EXPR_IDENT {
		return lookupVar(ctx, e.Name)
	}
	if e.Kind == ast.EXPR_SELECTOR {
		// Package-qualified imported var lvalue: `&pkg.X` / `pkg.X = v`.
		var ivp @Instr = genImportedVarLvalue(ctx, e)
		if ivp != nil { return ivp }
		if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
			var ptr @Instr = lookupVar(ctx, e.X.Name)
			if ptr != nil {
				var varTyp @types.Type = peelTransparent(lookupVarType(ctx, e.X.Name))
				if varTyp != nil && varTyp.Kind == types.TYP_STRUCT {
					var si int = lookupStructIdx(ctx.Gc, varTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						return b.EmitGetFieldPtr(ptr, idx, ftyp)
					}
				}
				// Managed pointer: p.x where p is @Struct
				if isManagedPtrToStruct(varTyp) {
					var structTyp @types.Type = peelTransparent(varTyp.Elem)
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var mptr @Instr = b.EmitLoad(ptr, varTyp)
						mptr.TypeArg = structTyp
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, mptr, forDeref)
						return b.EmitGetFieldPtr(mptr, idx, ftyp)
					}
				}
				// Raw pointer: p.x where p is *Struct
				if isRawPtrToStruct(varTyp) {
					var structTyp @types.Type = peelTransparent(varTyp.Elem)
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var rptr @Instr = b.EmitLoad(ptr, varTyp)
						rptr.TypeArg = structTyp
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, rptr, forDeref)
						return b.EmitGetFieldPtr(rptr, idx, ftyp)
					}
				}
			}
		}
		// Index selector: e.X is index expression (e.g., arr[i].field = val)
		if e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			var elemPtr @Instr = genIndexPtr(ctx, b, e.X)
			// Re-sync: a type-assertion in the index base (`x.(*T).arr[i].field`)
			// splits the block inside genIndexPtr (the assert's MISS-abort branch),
			// leaving the recovered element pointer in the HIT continuation; the
			// GEP/store below must land there, not the stale pre-branch block (else
			// the store is emitted after a terminator and dropped, or fails to
			// dominate its use).  A no-op for non-splitting bases.
			b = ctx.CurBlock
			if elemPtr != nil {
				var elemTyp @types.Type = peelTransparent(getIndexElemType(ctx, e.X))
				if elemTyp != nil && elemTyp.Kind == types.TYP_STRUCT {
					var si int = lookupStructIdx(ctx.Gc, elemTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						return b.EmitGetFieldPtr(elemPtr, idx, ftyp)
					}
				}
				// Managed-ptr element: load the pointer, then GEP for field
				if isManagedPtrToStruct(elemTyp) {
					var mptr @Instr = b.EmitLoad(elemPtr, elemTyp)
					var structTyp @types.Type = peelTransparent(elemTyp.Elem)
					mptr.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, mptr, forDeref)
						return b.EmitGetFieldPtr(mptr, idx, ftyp)
					}
				}
				// Raw-ptr element: load the pointer, then GEP for field
				if isRawPtrToStruct(elemTyp) {
					var rptr @Instr = b.EmitLoad(elemPtr, elemTyp)
					var structTyp @types.Type = peelTransparent(elemTyp.Elem)
					rptr.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, rptr, forDeref)
						return b.EmitGetFieldPtr(rptr, idx, ftyp)
					}
				}
			}
			// Fallback for slices: evaluate index, handle managed/raw ptr elem
			if elemPtr == nil {
				var val @Instr = genExpr(ctx, b, e.X)
				b = ctx.CurBlock
				if isManagedPtrToStruct(val.Typ) {
					var structTyp @types.Type = peelTransparent(val.Typ).Elem
					val.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, val, forDeref)
						return b.EmitGetFieldPtr(val, idx, ftyp)
					}
				}
				if isRawPtrToStruct(val.Typ) {
					var structTyp @types.Type = peelTransparent(val.Typ).Elem
					val.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, val, forDeref)
						return b.EmitGetFieldPtr(val, idx, ftyp)
					}
				}
			}
		}
		// Composite-literal base: the field pointer for `Point{...}.field`,
		// used by a nested read like `Line{...}.p.x`.  genCompositeBasePtr
		// returns the struct's alloca pointer (and registers it for cleanup
		// when it has managed fields); GEP the field off it.
		if e.X != nil && e.X.Kind == ast.EXPR_COMPOSITE {
			var sp @Instr = genCompositeBasePtr(ctx, b, e.X)
			b = ctx.CurBlock
			if sp != nil {
				var structTyp @types.Type = peelTransparent(sp.TypeArg)
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					return b.EmitGetFieldPtr(sp, idx, ftyp)
				}
			}
		}
		// Nested: e.X is also a selector
		if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR {
			// forDeref=true: the inner field is LOADED THROUGH to reach `.Name`
			// (a chain deref), even when the outermost use is address-of.
			var innerPtr @Instr = genSelectorPtr(ctx, b, e.X, true)
			// Re-sync: a type-assertion further down the chain (`x.(*T).a.b`) splits
			// the block inside the recursive genSelectorPtr (the assert's MISS-abort
			// branch), so the GEP/load below must emit into the HIT continuation, not
			// the stale pre-branch block.  A no-op for non-splitting bases.
			b = ctx.CurBlock
			if innerPtr != nil {
				var innerTyp @types.Type = peelTransparent(getSelectorType(ctx, e.X))
				if innerTyp != nil && innerTyp.Kind == types.TYP_STRUCT {
					var si int = lookupStructIdx(ctx.Gc, innerTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						return b.EmitGetFieldPtr(innerPtr, idx, ftyp)
					}
				}
				// Managed pointer: inner selector returns @T, deref and access field
				if isManagedPtrToStruct(innerTyp) {
					var structTyp @types.Type = peelTransparent(innerTyp.Elem)
					var mptr @Instr = b.EmitLoad(innerPtr, innerTyp)
					mptr.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, mptr, forDeref)
						return b.EmitGetFieldPtr(mptr, idx, ftyp)
					}
				}
				// Raw pointer: inner selector returns *T, deref and access field
				if isRawPtrToStruct(innerTyp) {
					var structTyp @types.Type = peelTransparent(innerTyp.Elem)
					var rptr @Instr = b.EmitLoad(innerPtr, innerTyp)
					rptr.TypeArg = structTyp
					var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
					if si >= 0 {
						var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
						var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
						emitDerefNilCheck(ctx, b, rptr, forDeref)
						return b.EmitGetFieldPtr(rptr, idx, ftyp)
					}
				}
			}
		}
		// Explicit-deref base: `(*P).field` — address the field THROUGH the
		// pointer P (P is @T / *T), never a copy.  This is the lvalue path, so a
		// write must hit the pointee: materializing a struct value into a temp
		// (as the value read does) would silently store to a throwaway copy —
		// `(*bx).f = v` would be lost.  `&(*P) == P`, so evaluate P (the pointer
		// operand) and GEP the field off it.  Covers a pointer VARIABLE and a
		// deref of a pointer-returning call (`(*mkptr()).f`) alike.
		if e.X != nil && e.X.Kind == ast.EXPR_UNARY && e.X.Op == cast(int, token.STAR) {
			var ptrVal @Instr = genExpr(ctx, b, e.X.X)
			b = ctx.CurBlock
			if isManagedPtrToStruct(ptrVal.Typ) || isRawPtrToStruct(ptrVal.Typ) {
				var structTyp @types.Type = peelTransparent(ptrVal.Typ).Elem
				ptrVal.TypeArg = structTyp
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					emitDerefNilCheck(ctx, b, ptrVal, forDeref)
					return b.EmitGetFieldPtr(ptrVal, idx, ftyp)
				}
			}
		}
		// Call base: `getBox().p.x`.  A POINTER-returning call (`@T`/`*T` ctor) is
		// addressed through the pointer.  A BY-VALUE struct call result is a
		// non-addressable temporary: materialize it into an alloca and GEP the
		// field.  This resolves the nested READ `getStruct().sub.y` that
		// genSelector's Case-2 path asks genSelectorPtr to address (else the
		// unresolved-selector panic).  The copy shares the call result's refs, and
		// the result is registered for cleanup by genExpr, so the read needs no
		// separate registration (balance verified — conformance/1058).
		//
		// The checker rejects the ASSIGNMENT forms `getStruct().field = v` /
		// `&getStruct().field` (a store there would land in the discarded copy),
		// so those never reach here.  One writable-lvalue path DOES still reach it:
		// a pointer-receiver method call `getStruct().field.ptrMethod()`
		// (gen_method.bn takes the receiver address via genSelectorPtr).  There the
		// mutation lands in the discarded copy — a PRE-EXISTING silent no-op (the
		// parent materialized an equivalent temp in gen_method.bn for the same
		// outcome; this branch does not worsen it), tracked separately in
		// claude-todo.md.
		if e.X != nil && (e.X.Kind == ast.EXPR_CALL || e.X.Kind == ast.EXPR_BUILTIN) {
			var val @Instr = genExpr(ctx, b, e.X)
			b = ctx.CurBlock
			if isManagedPtrToStruct(val.Typ) || isRawPtrToStruct(val.Typ) {
				var structTyp @types.Type = peelTransparent(val.Typ).Elem
				val.TypeArg = structTyp
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					emitDerefNilCheck(ctx, b, val, forDeref)
					return b.EmitGetFieldPtr(val, idx, ftyp)
				}
			} else if val.Typ != nil && peelTransparent(val.Typ).Kind == types.TYP_STRUCT {
				var structTyp @types.Type = peelTransparent(val.Typ)
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var tmpAlloc @Instr = b.EmitAlloc(val.Typ)
					b.EmitStore(tmpAlloc, val)
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					return b.EmitGetFieldPtr(tmpAlloc, idx, ftyp)
				}
			}
		}
		// Type-assertion base: `x.(*T).field` / `x.(@T).field` (pointer recovery)
		// and `x.(S).field` (value recovery).  For a POINTER recovery the field is
		// addressed through the recovered pointer, so `x.(*T).field = v` stores into
		// the boxed pointee (a real lvalue) -- without this arm genSelectorPtr returns
		// nil and the store is silently DROPPED.  For a VALUE recovery the recovered
		// struct is a non-addressable temporary: the checker rejects the assignment
		// form `x.(S).field = v` as non-addressable, so this branch is reached only
		// for reads / method-receivers (a chained `x.(S).f1.f2`), where the
		// alloca+store+GEP throwaway-copy lvalue is correct (mirrors the by-value
		// call-result arm above).
		if e.X != nil && e.X.Kind == ast.EXPR_TYPE_ASSERT {
			var val @Instr = genExpr(ctx, b, e.X)
			b = ctx.CurBlock
			if isManagedPtrToStruct(val.Typ) || isRawPtrToStruct(val.Typ) {
				var structTyp @types.Type = peelTransparent(val.Typ).Elem
				val.TypeArg = structTyp
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					emitDerefNilCheck(ctx, b, val, forDeref)
					return b.EmitGetFieldPtr(val, idx, ftyp)
				}
			} else if val.Typ != nil && peelTransparent(val.Typ).Kind == types.TYP_STRUCT {
				var structTyp @types.Type = peelTransparent(val.Typ)
				var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
				if si >= 0 {
					var tmpAlloc @Instr = b.EmitAlloc(val.Typ)
					b.EmitStore(tmpAlloc, val)
					var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
					var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
					return b.EmitGetFieldPtr(tmpAlloc, idx, ftyp)
				}
			}
		}
	}
	return nil
}
