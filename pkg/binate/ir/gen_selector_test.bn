package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// genSelector's final fallback (no selector arm matched — e.g. an unresolved
// `pkg.Name` at a value site) must ABORT loudly (emit a call to rt.Panic), not
// silently return const-0 (a wrong-VALUE miscompile).  The fallback is an
// internal-error catch-all: reaching it means an IR-gen resolution gap (a
// compiler bug).  Conformance 875 and 876 cover the formerly-reachable valid-
// code path — a function reference as a composite-literal element, now lowered
// via genExprOrFuncRef instead of falling through here.  This unit test drives
// genSelector directly with a hand-built unresolved selector (a state the
// end-to-end checker would reject) to lock the abort against a regression to
// silent const-0.
func TestGenSelectorUnresolvedAborts() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	var gc @GenCtx = NewGenCtx(m)
	var noParams @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc("main", "t", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = gc
	ctx.CurBlock = entry
	// `unknownpkg.Foo` — the base ident is neither a local var nor a registered
	// const, so no arm resolves and the fallback fires.
	var base @ast.Expr = make(ast.Expr)
	base.Kind = ast.EXPR_IDENT
	base.Name = "unknownpkg"
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_SELECTOR
	e.X = base
	e.Name = "Foo"
	genSelector(ctx, entry, e)
	var foundPanic bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CALL && containsSub(entry.Instrs[i].StrVal, "rt.Panic") {
			foundPanic = true
		}
	}
	if !foundPanic {
		return fail("unresolved selector must emit an rt.Panic abort, not silent const-0")
	}
	return ""
}

func TestGenSelfRefStruct() testing.TestResult {
	// A struct type that references itself via managed pointer
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Node struct {\n\tval int\n"
					"\tnext @Node\n}\n"
					"func main() {\n"
					"\tvar n @Node = make(Node)\n"
					"\tn.val = 42\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("expected main func") }
	// main should have an OP_MAKE instruction
	var makeInstr @Instr = findOp(mainFn, iropcode.OP_MAKE)
	if makeInstr == nil { return fail("expected iropcode.OP_MAKE in main") }
	// The TypeArg should be a struct type with 2 fields
	if makeInstr.TypeArg == nil { return fail("iropcode.OP_MAKE should have TypeArg") }
	if makeInstr.TypeArg.Kind != types.TYP_STRUCT { return fail("TypeArg should be struct") }
	var nFields int = len(makeInstr.TypeArg.Fields)
	if nFields != 2 {
		return fail(buf.Concat(
				"expected 2 fields, got ", strconv.Itoa(nFields)))
	}
	// Second field should be a managed pointer
	var f2 @types.Type = makeInstr.TypeArg.Fields[1].Type
	if f2 == nil { return fail("field 2 type is nil") }
	if f2.Kind != types.TYP_MANAGED_PTR { return fail("field 2 should be managed ptr") }
	return ""
}

func TestGenSelfRefStructFieldAccess() testing.TestResult {
	// Accessing fields on a self-referential struct
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Node struct {\n\tval int\n"
					"\tnext @Node\n}\n"
					"func main() {\n"
					"\tvar n @Node = make(Node)\n"
					"\tn.val = 42\n\t_ = n.val\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("expected main func") }
	// Should have GET_FIELD_PTR instructions for field access
	var gfp int = countOp(mainFn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 2 {
		return fail(buf.Concat(
				"expected >=2 GET_FIELD_PTR, got ", strconv.Itoa(gfp)))
	}
	return ""
}

func TestGenStringToCharsOnFieldAssign() testing.TestResult {
	// Phase 3.2: assigning a string literal to a *[]readonly char field
	// emits OP_RODATA_SLICE (not OP_STRING_TO_CHARS).
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Buf struct {\n\tname *[]readonly char\n}\n"
					"func main() {\n"
					"\tvar b Buf\n\tb.name = \"hello\"\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var stc @Instr = findOp(m.Funcs[0], iropcode.OP_RODATA_SLICE)
	if stc == nil {
		return fail(
				"expected iropcode.OP_RODATA_SLICE for field assignment")
	}
	return ""
}

func TestGenStructWithSliceField() testing.TestResult {
	// Struct with a slice field: make_slice and len should work
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Buf struct {\n\tdata *[]int\n}\n"
					"func main() {\n\tvar b Buf\n"
					"\tvar d @[]int = make_slice(int, 1)\n"
					"\td[0] = 1\n\tb.data = d\n"
					"\t_ = len(b.data)\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	// Should generate MAKE_SLICE and EXTRACT (lowered from SLICE_LEN)
	var msInstr @Instr = findOp(m.Funcs[0], iropcode.OP_MAKE_SLICE)
	if msInstr == nil { return fail("expected iropcode.OP_MAKE_SLICE for slice through struct") }
	var extractInstr @Instr = findOp(m.Funcs[0], iropcode.OP_EXTRACT)
	if extractInstr == nil { return fail("expected iropcode.OP_EXTRACT for len through struct field") }
	return ""
}

func TestNestedManagedSelectorPtr() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Inner struct { Value int }\n")
	src = concatChars(src, "type Outer struct { Inner @Inner\n  Tag int }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var o @Outer = make(Outer)\n")
	src = concatChars(src, "  o.Inner = make(Inner)\n")
	src = concatChars(src, "  o.Inner.Value = 100\n")
	src = concatChars(src, "  _ = o.Inner.Value\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	var foundStore bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var b @Block = mainFn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			var instr @Instr = b.Instrs[j]
			if instr.Op == iropcode.OP_STORE {
				if len(instr.Args) >= 2 {
					if instr.Args[1].Op == iropcode.OP_CONST_INT && instr.Args[1].IntVal == 100 {
						foundStore = true
					}
				}
			}
		}
	}
	if !foundStore {
		return fail("no store of 100 found — nested managed selector ptr broken")
	}
	return ""
}

func TestFieldAssignRefcount() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Inner struct { X int }\n")
	src = concatChars(src, "type Outer struct { Ptr @Inner }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var o @Outer = make(Outer)\n")
	src = concatChars(src, "  var a @Inner = make(Inner)\n")
	src = concatChars(src, "  o.Ptr = a\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	var incCount int = 0
	var decCount int = 0
	for i := 0; i < len(mainFn.Blocks); i++ {
		var b @Block = mainFn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == iropcode.OP_REFINC { incCount = incCount + 1 }
			if b.Instrs[j].Op == iropcode.OP_REFDEC { decCount = decCount + 1 }
		}
	}
	if incCount < 1 { return fail("expected at least 1 iropcode.OP_REFINC for field assignment") }
	if decCount < 1 { return fail("expected at least 1 iropcode.OP_REFDEC for field assignment") }
	return ""
}

func TestArrayElemFieldAccess() testing.TestResult {
	// arr[i].Field where arr is [N]@T — should generate GET_FIELD_PTR after loading managed ptr
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Node struct { Val int }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var arr [2]@Node\n")
	src = concatChars(src, "  arr[0] = make(Node)\n")
	src = concatChars(src, "  arr[0].Val = 42\n")
	src = concatChars(src, "  _ = arr[0].Val\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	// Should have GET_FIELD_PTR for .Val access
	var gfp int = countOp(mainFn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(buf.Concat(
				"expected >=1 GET_FIELD_PTR, got ", strconv.Itoa(gfp)))
	}
	return ""
}

func TestSelectorBaseArrayAssign() testing.TestResult {
	// cont.Items[i] = v where Items is an array field
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Node struct { Val int }\n")
	src = concatChars(src, "type Container struct { Items [2]@Node }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var c @Container = make(Container)\n")
	src = concatChars(src, "  c.Items[0] = make(Node)\n")
	src = concatChars(src, "  _ = c.Items[0].Val\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	// Should have OP_STORE for the array element assignment
	var storeCount int = countOp(mainFn, iropcode.OP_STORE)
	if storeCount < 2 {
		return fail(buf.Concat(
				"expected >=2 iropcode.OP_STORE, got ", strconv.Itoa(storeCount)))
	}
	return ""
}

// Field access through a NESTED array index base (`a[i][j].field`) must
// resolve the element type by recursing the nested-index base in
// getIndexElemType.  Without the recursion the type is nil, so both the
// read (genSelector) folds to a const-0 and the write (genSelectorPtr)
// returns a dropped nil lvalue — i.e. NO GET_FIELD_PTR for either.  CR-2
// Plan-1 Round-2, a sibling of Defect 1 (missing nested-index type
// resolution rather than a missing wrapper peel).
func TestNestedIndexFieldAccess() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type S struct { a int }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var a [1][2]S\n")
	src = concatChars(src, "  a[0][1].a = 7\n")
	src = concatChars(src, "  _ = a[0][1].a\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	// The write target and the read each need a GET_FIELD_PTR (not a const-0
	// read / a dropped nil lvalue) -> at least 2.
	var gfp int = countOp(mainFn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 2 {
		return fail(
				buf.Concat(
						"expected >=2 GET_FIELD_PTR for a[0][1].a write+read "
								"(nested-index field access folded to const-0?), got ",
						strconv.Itoa(gfp)))
	}
	return ""
}

// Chained field access through a raw pointer to struct
// (e.g., `o.Typ.Val` where `o` is `*Outer` and `Typ` is `@Inner`):
// genSelector's nested-selector path must recognize that `o.Typ`
// has type `@Inner` (via getSelectorType) so that the outer `.Val`
// lowers to load+GEP rather than falling through to the constant-0
// fallback.
func TestRawPtrChainedFieldAccess() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Inner struct { Val int }\n"
					"type Outer struct { Typ @Inner }\n"
					"func read(o *Outer) int {\n"
					"\treturn o.Typ.Val\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "read")
	if fn == nil { return fail("expected read func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 2 {
		return fail(buf.Concat(
				"expected >=2 GET_FIELD_PTR (one per deref), got ", strconv.Itoa(gfp)))
	}
	return ""
}

// Reading a field through an element of a raw-pointer slice
// (e.g., `items[i].Val` where `items` is `*[]*Item`): the
// index-selector path must recognize the raw-pointer element
// type and emit load+GEP+load rather than the fallback.
func TestRawPtrSliceElemRead() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Item struct { Val int }\n"
					"func first(items *[]*Item) int {\n"
					"\treturn items[0].Val\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "first")
	if fn == nil { return fail("expected first func") }
	// Proper field access emits a GET_FIELD_PTR; the const-0
	// fallback emits none.
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(buf.Concat(
				"expected >=1 GET_FIELD_PTR for items[0].Val, got ", strconv.Itoa(gfp)))
	}
	return ""
}

// Field access through an explicit deref of a raw pointer:
// `(*p).x` where `p` is `*T`.  Without the EXPR_UNARY-STAR base
// case in `genSelector`, the read fell through to the const-0
// fallback (no GET_FIELD_PTR emitted).  Conformance 456 pins the
// runtime value; this test pins the IR shape directly so a
// regression in any single compiled mode surfaces in the IR-layer
// unit run.
func TestGenExplicitDerefRawPtrFieldRead() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type T struct { x int }\n"
					"func read(p *T) int {\n"
					"\treturn (*p).x\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "read")
	if fn == nil { return fail("expected read func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(buf.Concat(
				"expected >=1 GET_FIELD_PTR for (*p).x, got ", strconv.Itoa(gfp)))
	}
	return ""
}

// Same shape with a managed pointer: `(*mp).x` where `mp` is `@T`.
// The deref load returns a struct value, which routes through the
// struct-value branch of the EXPR_UNARY-STAR case (alloca + store
// + GEP + load).
func TestGenExplicitDerefManagedPtrFieldRead() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type T struct { x int }\n"
					"func read(mp @T) int {\n"
					"\treturn (*mp).x\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "read")
	if fn == nil { return fail("expected read func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(buf.Concat(
				"expected >=1 GET_FIELD_PTR for (*mp).x, got ", strconv.Itoa(gfp)))
	}
	return ""
}

// Field read through a `readonly @Box` view: `readonly` is an IR-transparent
// wrapper, so genSelector must peel it before its Kind-dispatch.  Without the
// peel every arm misses and the read falls through to the const-0 fallback
// (no GET_FIELD_PTR) — silent data corruption (CR-2 Plan-1 Defect 1).  The
// alias and named-distinct wrapper variants are runtime-pinned by conformance
// 660 / the readonly field-read matrix (they need full checker type
// resolution that the parser-only genFromSource here does not run).
func TestGenReadonlyManagedPtrFieldRead() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func read(p @Box) int {\n"
					"\tvar rp readonly @Box = p\n"
					"\treturn rp.v\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "read")
	if fn == nil { return fail("expected read func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(
				buf.Concat(
						"expected >=1 GET_FIELD_PTR for readonly rp.v (got the "
								"const-0 fallback?), got ",
						strconv.Itoa(gfp)))
	}
	return ""
}

// Field read through an INNER-pointee-wrapped pointer: `@readonly Box`
// and `*readonly Box`.  Here the outer kind is a plain pointer, so
// peeling the VARIABLE type (Defect 1) removes nothing — genSelector
// must peel the wrapper off the POINTEE (`varTyp.Elem`) before the
// struct-index lookup, or the `.Name` is "" and every arm misses,
// folding the read to the const-0 fallback (no GET_FIELD_PTR).  CR-2
// Plan-1 Round-2, inner-pointee sibling of Defect 1.
func TestGenInnerReadonlyPtrFieldRead() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func read(p @readonly Box, q *readonly Box) int {\n"
					"\treturn p.v + q.v\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "read")
	if fn == nil { return fail("expected read func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 2 {
		return fail(
				buf.Concat(
						"expected >=2 GET_FIELD_PTR for @readonly/*readonly Box "
								"field reads (got the const-0 fallback?), got ",
						strconv.Itoa(gfp)))
	}
	return ""
}

// Address-of a field through an inner-pointee-wrapped pointer drives
// genSelectorPtr (the lvalue path), whose IDENT managed-ptr arm has the
// same un-peeled-pointee bug.  `&p.v` must yield a real GET_FIELD_PTR,
// not a dropped nil lvalue (which lowers to a const-0 pointer → SIGSEGV).
func TestGenInnerReadonlyPtrFieldAddr() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func addr(p @readonly Box) *readonly int {\n"
					"\treturn &p.v\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "addr")
	if fn == nil { return fail("expected addr func") }
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(
				buf.Concat(
						"expected >=1 GET_FIELD_PTR for &p.v through @readonly Box "
								"(got a dropped nil lvalue?), got ",
						strconv.Itoa(gfp)))
	}
	return ""
}

// Taking the address of a field through a raw-pointer slice element
// (exercises genSelectorPtr's index path for raw-pointer elements).
func TestRawPtrSliceElemFieldPtr() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Item struct { Val int }\n"
					"func setv(items *[]*Item, v int) {\n"
					"\titems[0].Val = v\n"
					"}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "setv")
	if fn == nil { return fail("expected setv func") }
	// Write must use a GET_FIELD_PTR for the store target.
	var gfp int = countOp(fn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail(
				buf.Concat(
						"expected >=1 GET_FIELD_PTR for items[0].Val=, got ", strconv.Itoa(gfp)))
	}
	return ""
}

// A field read off a composite-literal rvalue must emit a real field load
// (GET_FIELD_PTR), not the constant-0 fallback the selector used to hit
// for an unhandled composite base.
func TestGenCompositeRvalueFieldAccess() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct {\n\tx int\n\ty int\n}\n"
					"func main() {\n\t_ = Point{x: 3, y: 4}.x\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("expected main func") }
	var gfp int = countOp(mainFn, iropcode.OP_GET_FIELD_PTR)
	if gfp < 1 {
		return fail("composite-rvalue field read must emit GET_FIELD_PTR, not const-0")
	}
	return ""
}
