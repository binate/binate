package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// getSelectorType returns the resolved type of a selector expression
func getSelectorType(ctx @GenContext, e @ast.Expr) @types.Type {
	if e.Kind == ast.EXPR_IDENT {
		return lookupVarType(ctx, e.Name)
	}
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return getIndexElemType(ctx, e)
	}
	// Composite-literal base: its type is its declared head, so a nested
	// selector like `Line{...}.p.x` can resolve `.p`'s struct type.
	if e.Kind == ast.EXPR_COMPOSITE {
		if e.TypeRef != nil {
			return peelTransparent(resolveTypeExpr(ctx.Gc, e.TypeRef))
		}
		return nil
	}
	// Call-result base (`obj.Get().f`, `f().field`): the call's result type
	// isn't in any var/field table, so take the checker's resolved type of the
	// call expression.  Without this, a selector/index whose base is a call
	// result — or a func-value callee reached through one (`obj.Get().f(x)`) —
	// resolves to nil, dropping into a direct-by-name call on a malformed empty
	// symbol (or crashing genSelector's nested-selector arm on the nil base).
	if e.Kind == ast.EXPR_CALL {
		if ctx.Checker != nil && e.ResolvedTypeID != 0 {
			return peelTransparent(ctx.Checker.ExprType(e.ResolvedTypeID))
		}
		return nil
	}
	// `*x` deref — when x has type *T or @T, *x has type T. Used
	// so iface-value method dispatch routes correctly for receivers
	// reached through a pointer-to-iface-value (e.g. `(*p).Foo()`
	// where p is `**Iface`). Without this case the receiver type
	// stays unknown, and genCall falls through to the direct-call
	// path which builds an empty-named method symbol.
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @types.Type = getSelectorType(ctx, e.X)
		if inner == nil { return nil }
		if inner.Kind == types.TYP_POINTER || inner.Kind == types.TYP_MANAGED_PTR {
			return inner.Elem
		}
		return nil
	}
	if e.Kind == ast.EXPR_SELECTOR {
		// Package-qualified imported var: `pkg.X` where `pkg` is an
		// import alias (not a local).  Resolve to the imported var's
		// declared type so a nested lvalue (`pkg.X.field`) can find the
		// field — without this getSelectorType resolves `pkg` as a
		// (nonexistent) variable and returns nil, dropping the field
		// store.  Consts / funcs return nil from lookupImportedGlobalPtr
		// and fall through unchanged.
		if e.X != nil && e.X.Kind == ast.EXPR_IDENT && lookupVar(ctx, e.X.Name) == nil {
			var gp @Instr = lookupImportedGlobalPtr(ctx.Gc, buildQualName(ctx.Gc.Mod, e.X.Name, e.Name))
			if gp != nil { return gp.TypeArg }
		}
		if e.X != nil {
			var baseTyp @types.Type = getSelectorType(ctx, e.X)
			if baseTyp == nil { return nil }
			// Direct struct field
			if baseTyp.Kind == types.TYP_STRUCT {
				var si int = lookupStructIdx(ctx.Gc, baseTyp.Name)
				if si >= 0 {
					return lookupFieldType(ctx.Gc, si, e.Name)
				}
			}
			// Managed pointer to struct: @T has fields accessible through deref
			if isManagedPtrToStruct(baseTyp) {
				var si int = lookupStructIdx(ctx.Gc, peelTransparent(peelTransparent(baseTyp).Elem).Name)
				if si >= 0 {
					return lookupFieldType(ctx.Gc, si, e.Name)
				}
			}
			// Raw pointer to struct: *T has fields accessible through deref
			if isRawPtrToStruct(baseTyp) {
				var si int = lookupStructIdx(ctx.Gc, peelTransparent(peelTransparent(baseTyp).Elem).Name)
				if si >= 0 {
					return lookupFieldType(ctx.Gc, si, e.Name)
				}
			}
		}
	}
	return nil
}
