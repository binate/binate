package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// getSelectorType must resolve a package-qualified imported var
// (`pkg.X`) to the var's declared type — otherwise a nested lvalue
// store (`pkg.X.field = v`) is silently dropped because genSelectorPtr
// can't determine the inner type (conformance 561 covers the full
// write end-to-end).  Before the fix getSelectorType resolved the
// import alias `pkg` as a (nonexistent) variable and returned nil.
func TestGetSelectorTypeQualifiedImportedVar() testing.TestResult {
	var m @Module = InitModule("\"main\"")
	var src *[]readonly char =
		"package \"pkg/store\"\ntype Node struct {\n\tV int\n}\nvar G @Node\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "store.bni")
	var file @ast.File = p.ParseFile()
	// Both import-registration passes: RegisterImport records the alias
	// + struct names; registerImportFieldsAndFuncs registers struct
	// fields and the extern `var G` into m.GlobalVars.
	RegisterImport("store", "pkg/store", file, NewGenCtx(m))
	registerImportFieldsAndFuncs(NewGenCtx(m), "store", file, m)

	var ctx @GenContext = make(GenContext)
	// getSelectorType resolves the imported var through ctx.Gc.Mod's
	// GlobalVars table, so bind the context to the module the import
	// registration populated.
	ctx.Gc = NewGenCtx(m)

	// `store.G` resolves to the imported var's type, @Node (managed ptr).
	var idStore @ast.Expr = make(ast.Expr)
	idStore.Kind = ast.EXPR_IDENT
	idStore.Name = "store"
	var selG @ast.Expr = make(ast.Expr)
	selG.Kind = ast.EXPR_SELECTOR
	selG.X = idStore
	selG.Name = "G"
	var tG @types.Type = getSelectorType(ctx, selG)
	if tG == nil {
		return fail("getSelectorType(store.G) returned nil (561 regression)")
	}
	if tG.Kind != types.TYP_MANAGED_PTR {
		return fail("expected store.G to resolve to a managed ptr (@Node)")
	}
	if tG.Elem == nil {
		return fail("expected store.G's managed-ptr type to have an element")
	}
	return ""
}
