package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// RegisterSelfTypes registers type definitions from a package's own
// .bni file: struct types, type aliases, and constants that are
// declared in the .bni but not redefined in the .bn files.  The
// .bn-side compiler still has to see them so cross-file references
// inside the same package resolve at IR-gen.
func RegisterSelfTypes(c @types.Checker, bniFile @ast.File) {
	if bniFile == nil { return }

	// Per-compilation gen context for this .bni's self-types.
	// RegisterSelfTypes runs BEFORE GeneratePackage (no module in hand),
	// but self structs must register under the package's own path — the
	// SAME fully-qualified name GeneratePackage will later use — so seed
	// gc.PkgPath from the .bni's package name (GeneratePackage re-sets the
	// module to the same value), keeping qualifyForCurrentModule /
	// lookupStructIdx consistent.
	var gc @GenCtx = NewGenCtx(nil)
	gc.PkgPath = mangle.PkgPathFromQuoted(bniFile.PkgName)

	// Pass 1: register struct type names (so self-references resolve)
	for i := 0; i < len(bniFile.Decls); i++ {
		var d @ast.Decl = bniFile.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if lookupStructIdx(gc, d.Name) < 0 {
				var qn @[]char =
					qualifyForCurrentModule(gc, buf.CopyStr(d.Name))
				var ms ModuleStruct
				ms.Name = qn
				var noFields3 @[]@types.Field
				ms.Typ = types.MakeStructType(qn, noFields3)
				moduleStructs = slices.Append[ModuleStruct](moduleStructs, ms)
			}
		}
	}

	// Pass 2: populate struct fields, register type aliases and constants
	for i := 0; i < len(bniFile.Decls); i++ {
		var d @ast.Decl = bniFile.Decls[i]

		// Struct field population
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var si int = lookupStructIdx(gc, d.Name)
			if si >= 0 && len(d.TypeRef.Fields) > 0 {
				var styp @types.Type = moduleStructs[si].Typ
				if len(styp.Fields) == 0 {
					var fields @[]@types.Field
					for j := 0; j < len(d.TypeRef.Fields); j++ {
						var f @types.Field = make(types.Field)
						f.Name = d.TypeRef.Fields[j].Name
						f.Type = resolveTypeExpr(gc, d.TypeRef.Fields[j].Type)
						fields = slices.Append[@types.Field](fields, f)
					}
					styp.Fields = fields
					moduleStructs[si].Fields = fields
				}
			}
		}

		// Type aliases and named distinct non-struct types
		// (e.g., the alias `type X = int`, the distinct `type Type int`).
		if isNonStructTypeDecl(d) {
			// Check if already registered
			var aliasFound bool = false
			for j := 0; j < len(moduleTypeAliases); j++ {
				if charEq(moduleTypeAliases[j].Name, d.Name) {
					aliasFound = true
				}
			}
			if !aliasFound {
				var ta ModuleTypeAlias
				ta.Name = buf.CopyStr(d.Name)
				ta.Typ = typeDeclEntryType(gc, ta.Name, d)
				moduleTypeAliases = slices.Append[ModuleTypeAlias](moduleTypeAliases, ta)
			}
		}

		// Constants
		if d.Kind == ast.DECL_CONST {
			genConst(gc, d)
		}
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(gc, c, d)
		}
	}
}
