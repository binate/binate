package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// RegisterSelfTypes covers the same shape registrations as
// RegisterImport, but for the package's OWN .bni file (no `alias.`
// qualifier on the resulting names).  These tests pin the
// unqualified-name path; gen_import_test.bn covers the qualified
// import side.

// TestRegisterSelfTypesStruct verifies a struct type from a
// package's own .bni lands in the module's Structs table under its
// bare name (no `alias.` prefix) and gets its fields populated.
func TestRegisterSelfTypesStruct() testing.TestResult {
	var src *[]readonly char = "package \"pkg/self\"\ntype Pt struct {\n\tX int\n\tY int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	var m @Module = NewModule("test")
	RegisterSelfTypes(nil, file, m)

	// RegisterSelfTypes registers self-types qualified by the .bni's
	// package path, so look up with a matching gc.PkgPath on the same module.
	var gc @GenCtx = NewGenCtx(m)
	gc.PkgPath = "pkg/self"
	var si int = lookupStructIdx(gc, "Pt")
	if si < 0 { return fail("expected struct Pt registered as pkg/self.Pt") }
	if len(m.Structs[si].Fields) != 2 {
		return fail("expected 2 fields on Pt")
	}
	return ""
}

// TestRegisterSelfTypesAlias verifies a type alias from the
// package's own .bni lands in the module's TypeAliases table.
func TestRegisterSelfTypesAlias() testing.TestResult {
	var src *[]readonly char = "package \"pkg/self\"\ntype TokenKind = int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	var m @Module = NewModule("test")
	RegisterSelfTypes(nil, file, m)

	var found bool = false
	for i := 0; i < len(m.TypeAliases); i++ {
		if seq(m.TypeAliases[i].Name, "TokenKind") {
			found = true
		}
	}
	if !found { return fail("expected TokenKind alias under bare name") }
	return ""
}

// TestRegisterSelfTypesNilBniFile verifies the guard for a nil
// bniFile (package with no .bni — only .bn source) returns
// silently rather than dereferencing nil.
func TestRegisterSelfTypesNilBniFile() testing.TestResult {
	var m @Module = NewModule("test")
	RegisterSelfTypes(nil, nil, m)
	return ""
}
