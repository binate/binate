package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// RegisterSelfTypes covers the same shape registrations as
// RegisterImport, but for the package's OWN .bni file (no `alias.`
// qualifier on the resulting names).  These tests pin the
// unqualified-name path; gen_import_test.bn covers the qualified
// import side.

// TestRegisterSelfTypesStruct verifies a struct type from a
// package's own .bni lands in moduleStructs under its bare name
// (no `alias.` prefix) and gets its fields populated.
func TestRegisterSelfTypesStruct() testing.TestResult {
	var src *[]const char = "package \"pkg/self\"\ntype Pt struct {\n\tX int\n\tY int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	RegisterSelfTypes(file)

	var si int = lookupStructIdx("Pt")
	if si < 0 { return fail("expected struct Pt registered under bare name") }
	if len(moduleStructs[si].Fields) != 2 {
		return fail("expected 2 fields on Pt")
	}
	return ""
}

// TestRegisterSelfTypesAlias verifies a type alias from the
// package's own .bni lands in moduleTypeAliases.
func TestRegisterSelfTypesAlias() testing.TestResult {
	var src *[]const char = "package \"pkg/self\"\ntype TokenKind = int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	RegisterSelfTypes(file)

	var found bool = false
	for i := 0; i < len(moduleTypeAliases); i++ {
		if seq(moduleTypeAliases[i].Name, "TokenKind") {
			found = true
		}
	}
	if !found { return fail("expected TokenKind alias under bare name") }
	return ""
}

// TestRegisterSelfTypesNilBniFile verifies the guard for a nil
// bniFile (package with no .bni — only .bn source) returns
// silently rather than dereferencing nil.
func TestRegisterSelfTypesNilBniFile() testing.TestResult {
	RegisterSelfTypes(nil)
	return ""
}
