package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Integer shift lowering: overshift handling + the negative-count guard
// ============================================================
//
// A shift's result type is the LEFT (value) operand's; the count may be any
// integer type.  Three concerns live here, shared by the expression
// (genBinary) and compound-assignment (emitCompoundBinop) shift paths:
//   - overshift (count >= width): the spec defines it as 0 / sign-fill, not
//     the hardware's count-masking (emitConstOvershiftOrNil for a constant
//     count, emitShiftInrangeOrNil + emitGuardedShift for a runtime count);
//   - a negative count: a programmer error that traps at runtime
//     (emitShiftCheckGuard).

// isSafeConstShiftCount reports whether the shift count is a compile-time
// constant in [0, width) — so the shift cannot overshift and needs no
// guard. Variable counts (and out-of-range constants) go through
// emitGuardedShift.
func isSafeConstShiftCount(count @Instr, width int) bool {
	if count == nil || count.Op != iropcode.OP_CONST_INT {
		return false
	}
	return count.IntVal >= cast(int64, 0) && count.IntVal < cast(int64, width)
}

// emitShiftInrangeOrNil computes the overshift guard's in-range predicate
// `count < width` from the count's ORIGINAL value — i.e. BEFORE the count is
// width-reconciled to the value type — reading it in its OWN type.  A count of
// a type WIDER than the value thus keeps the high bits that reveal an overshift
// (truncating to the value width first would hide them: a uint16 261 would read
// as its 8-bit residue 5), and the count's signedness is honored (a uint8 200
// is 200, not -56).  Returns nil unless this is an integer shift with a
// non-safe-constant count — the only case that reaches emitGuardedShift; the
// constant >= width case is handled earlier by emitConstOvershiftOrNil, and a
// safe constant in [0, width) lowers to a plain shift.  The caller passes the
// result straight to emitGuardedShift.  width (<= 64) is representable in any
// integer type >= 8 bits, so the constant fits the count's type.
func emitShiftInrangeOrNil(b @Block, op int, count @Instr, resultTyp @types.Type) @Instr {
	if op != iropcode.OP_SHL && op != iropcode.OP_SHR {
		return nil
	}
	if resultTyp == nil || !resultTyp.IsInteger() {
		return nil
	}
	var w int = typeWidth(resultTyp)
	if isSafeConstShiftCount(count, w) {
		return nil
	}
	var ct @types.Type = count.Typ
	if ct == nil || ct.Kind == types.TYP_UNTYPED_INT {
		ct = resultTyp
	}
	var wConst @Instr = b.EmitConstInt(w, ct)
	return b.EmitBinop(iropcode.OP_LT, count, wConst, types.TypBool())
}

// emitConstOvershiftOrNil handles a shift whose count is a compile-time
// CONSTANT >= the value's bit width.  ensureWidth truncates such a wide
// constant into the value width BEFORE the post-truncation overshift guard
// (isSafeConstShiftCount / emitGuardedShift) can see it — a uint8 `v << 256`
// would otherwise shift by `256 & 7 = 0` and wrongly leave v unchanged (1, not
// the spec's 0) — so the overshift is caught here from the count's ORIGINAL
// value.  Returns the spec'd overshift result (0 for a logical `<<` / unsigned
// `>>`; sign-fill `lhs >> (W-1)` for a signed `>>`, identical to what
// emitGuardedShift produces for a runtime overshift), or nil when `count` is
// not a compile-time `>= width` overshift (the caller then proceeds with
// ensureWidth + the runtime guard, which still covers a non-constant or
// negative count).  `lhs` must already be width-coerced to resultTyp; `count`
// is the ORIGINAL (pre-ensureWidth) count instruction.
func emitConstOvershiftOrNil(b @Block, op int, lhs @Instr, count @Instr,
		resultTyp @types.Type) @Instr {
	if op != iropcode.OP_SHL && op != iropcode.OP_SHR {
		return nil
	}
	if resultTyp == nil || !resultTyp.IsInteger() {
		return nil
	}
	if count == nil || count.Op != iropcode.OP_CONST_INT {
		return nil
	}
	var w int = typeWidth(resultTyp)
	// Compare the count's MAGNITUDE unsigned: a huge positive constant (>= 2^63)
	// is stored as a signed-negative IntVal, so a signed `IntVal < w` test would
	// miss its overshift (`x << 0x8000000000000000` would run as the masked
	// `x << 0` instead of the spec's 0).  A genuinely negative count is rejected
	// at compile time (checkShiftCountNonNegative) and never reaches here, so a
	// negative IntVal here is always such a huge positive overshift.
	if cast(uint64, count.IntVal) < cast(uint64, w) {
		// In-range [0, W) — the fast path / runtime guard handles it unchanged.
		return nil
	}
	if op == iropcode.OP_SHR && typeIsSigned(resultTyp) {
		var wm1 @Instr = b.EmitConstInt(w - 1, resultTyp)
		return b.EmitBinop(iropcode.OP_SHR, lhs, wm1, resultTyp)
	}
	return b.EmitConstInt(0, resultTyp)
}

// emitGuardedShift lowers an integer shift so a count >= the operand
// width honors the language spec — 0 for a logical `<<` / `>>`, sign-fill
// for an arithmetic `>>` — rather than the hardware's count-masking (see
// the CRITICAL integer-shift-overshift entry in claude-todo.md). It is
// branchless and built from existing ops, so every backend inherits the
// behavior without per-backend shift logic.
//
//   maskIn = all-ones if count < width, else 0
//   logical:    (lhs <shift> (count & (W-1))) & maskIn
//   arithmetic: lhs >> ((count & maskIn) | ((W-1) & ~maskIn))   [clamp to W-1]
func emitGuardedShift(b @Block, op int, lhs @Instr, rhs @Instr, resultTyp @types.Type,
		inrange @Instr) @Instr {
	var w int = typeWidth(resultTyp)
	// `inrange` (count < width) is computed by the caller from the count's
	// ORIGINAL value at the count's own width (emitShiftInrangeOrNil), so a
	// count of a type wider than the value isn't truncated into range before
	// the test.  `rhs` here is the width-reconciled count, used only for the
	// in-range mask + shift: an in-range count (< width) loses nothing in the
	// reconciliation, and an overshift is zeroed / sign-filled by maskIn
	// regardless of rhs's masked value.
	// maskIn = 0 - (cast(inrange) & 1): all-ones when in range, else 0.
	// The `& 1` makes it robust to the bool->int cast's zext/sext choice.
	var inrangeInt @Instr = b.EmitCast(inrange, resultTyp)
	var one @Instr = b.EmitConstInt(1, resultTyp)
	var inrangeBit @Instr = b.EmitBinop(iropcode.OP_AND, inrangeInt, one, resultTyp)
	var zero @Instr = b.EmitConstInt(0, resultTyp)
	var maskIn @Instr = b.EmitBinop(iropcode.OP_SUB, zero, inrangeBit, resultTyp)
	var wm1 @Instr = b.EmitConstInt(w - 1, resultTyp)

	if op == iropcode.OP_SHR && typeIsSigned(resultTyp) {
		// Arithmetic >>: clamp the count to min(count, W-1) so an
		// overshift sign-fills (lhs >> (W-1)) instead of masking.
		var allOnes @Instr = b.EmitConstInt(0 - 1, resultTyp)
		var notMask @Instr = b.EmitBinop(iropcode.OP_XOR, maskIn, allOnes, resultTyp)
		var lo @Instr = b.EmitBinop(iropcode.OP_AND, rhs, maskIn, resultTyp)
		var hi @Instr = b.EmitBinop(iropcode.OP_AND, wm1, notMask, resultTyp)
		var clamped @Instr = b.EmitBinop(iropcode.OP_OR, lo, hi, resultTyp)
		return b.EmitBinop(iropcode.OP_SHR, lhs, clamped, resultTyp)
	}

	// Logical (`<<`, or unsigned `>>`): mask the count into range, shift,
	// then zero the result when the original count overflowed.
	var safeCount @Instr = b.EmitBinop(iropcode.OP_AND, rhs, wm1, resultTyp)
	var shifted @Instr = b.EmitBinop(op, lhs, safeCount, resultTyp)
	return b.EmitBinop(iropcode.OP_AND, shifted, maskIn, resultTyp)
}

// emitShiftCheckGuard emits a runtime negative-shift-count guard
// (OP_SHIFT_CHECK) before a guarded shift whose count is of a SIGNED type — a
// shift count must be non-negative (a constant negative count is rejected at
// compile time; a runtime negative count panics, matching Go).  count is the
// ORIGINAL, pre-width-reconciliation count, sign-extended to 64-bit so a
// negative count of any width is seen.  A no-op for an unsigned count (can't be
// negative), a non-shift op, or a safe constant count (shiftInrange nil — no
// guarded path).  `unsafe_shl` / `unsafe_shr` route around this guard.
func emitShiftCheckGuard(ctx @GenContext, b @Block, op int, count @Instr, shiftInrange @Instr) {
	if op != iropcode.OP_SHL && op != iropcode.OP_SHR {
		return
	}
	if shiftInrange == nil {
		return
	}
	if count.Typ == nil || !typeIsSigned(count.Typ) {
		return
	}
	var c64 @Instr = ensureInt64ForCheck(b, count)
	b.EmitShiftCheck(c64)
	attachFaultPad(ctx, b) // recoverable negative-shift pad (Plan 2); see genBoundsCheck
}
