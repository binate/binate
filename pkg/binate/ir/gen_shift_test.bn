package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A variable-count integer shift gets the overshift guard (so a count
// >= width yields 0 / sign-fill, not the hardware-masked result). The
// in-range compare (OP_LT) is the guard's marker.
func TestVariableShiftEmitsOvershiftGuard() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(x uint64, n uint64) uint64 { return x >> n }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_LT) < 1 {
		return fail("variable-count shift should emit the overshift guard (iropcode.OP_LT)")
	}
	if countOp(m.Funcs[0], iropcode.OP_SHR) < 1 {
		return fail("shift should still emit iropcode.OP_SHR")
	}
	return ""
}

// An in-range constant count can't overshift, so it stays a plain shift
// with no guard.
func TestConstInRangeShiftSkipsGuard() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(x uint64) uint64 { return x >> 4 }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_LT) != 0 {
		return fail("const-in-range shift should be a plain shift (no guard)")
	}
	if countOp(m.Funcs[0], iropcode.OP_SHR) < 1 {
		return fail("const-in-range shift should emit iropcode.OP_SHR")
	}
	return ""
}

// A SIGNED runtime shift count emits the negative-shift-count guard
// (OP_SHIFT_CHECK) — a negative count must trap at runtime.
func TestSignedShiftCountEmitsShiftCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(x int, n int) int { return x << n }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_SHIFT_CHECK) < 1 {
		return fail("signed-count shift should emit the negative-count guard (iropcode.OP_SHIFT_CHECK)")
	}
	return ""
}

// An UNSIGNED shift count can't be negative, so no OP_SHIFT_CHECK guard.
func TestUnsignedShiftCountSkipsShiftCheck() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(x int, n uint) int { return x << n }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_SHIFT_CHECK) != 0 {
		return fail("unsigned-count shift must not emit iropcode.OP_SHIFT_CHECK")
	}
	return ""
}

// Smoke check that a compound shift-assign emits the guards on the compound
// path at all (a signed runtime `<<=` → the negative-count guard OP_SHIFT_CHECK
// + the overshift guard OP_LT).  This is a same-width count, so it does NOT
// distinguish the fixed compiler from the pre-truncation bug (both emit the
// ops; the bug only changes WHICH count value feeds them) — the behavioral
// regression guard for that is conformance/793 (wide negative count) and the
// `<<=`/`>>=` wide-overshift cases in shift-runtime-wide-overshift.bn.
func TestCompoundSignedShiftEmitsGuards() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(n int) {\n  var x int = 1\n  x <<= n\n  _ = x\n}\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_SHIFT_CHECK) < 1 {
		return fail("compound signed-count shift-assign should emit iropcode.OP_SHIFT_CHECK")
	}
	if countOp(m.Funcs[0], iropcode.OP_LT) < 1 {
		return fail("compound shift-assign should emit the overshift guard (iropcode.OP_LT)")
	}
	return ""
}

// unsafe_shl is the opt-out: a bare OP_SHL with NO overshift guard (OP_LT)
// and NO negative-count check (OP_SHIFT_CHECK), even for a signed runtime
// count that the checked `<<` would guard on both counts.
func TestUnsafeShlSkipsGuards() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\nfunc f(x int, n int) int { return unsafe_shl(x, n) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if countOp(m.Funcs[0], iropcode.OP_SHIFT_CHECK) != 0 {
		return fail("unsafe_shl must not emit iropcode.OP_SHIFT_CHECK")
	}
	if countOp(m.Funcs[0], iropcode.OP_LT) != 0 {
		return fail("unsafe_shl must not emit the overshift guard (iropcode.OP_LT)")
	}
	if countOp(m.Funcs[0], iropcode.OP_SHL) < 1 {
		return fail("unsafe_shl should emit a bare iropcode.OP_SHL")
	}
	return ""
}

// A genuinely-negative untyped-int const value operand of a runtime-count
// `>>` must shift as SIGNED: the emitted OP_SHR carries a signed (not
// untyped-int) result type, so the backend selects ashr rather than lshr.
// `(0 - 16) >> n` is -4, not (2^64-16) >> n.
func TestNegativeUntypedConstShrIsSigned() testing.TestResult {
	// genFromSourceWithChecker (not genFromSource): the fix reads the
	// checker's folded-literal sign, so the test needs a real type-check.
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc f(n int) int { return (0 - 16) >> n }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var fn @Func = m.Funcs[0]
	var found bool = false
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @Instr = blk.Instrs[ii]
			if ins.Op != iropcode.OP_SHR { continue }
			if ins.Typ == nil { return fail("OP_SHR has nil result type") }
			if ins.Typ.Kind == types.TYP_UNTYPED_INT {
				return fail("negative untyped-const >> stayed untyped (-> lshr); want signed")
			}
			if !ins.Typ.Signed {
				return fail("negative untyped-const >> must have a SIGNED result type (-> ashr)")
			}
			found = true
		}
	}
	if !found { return fail("expected an OP_SHR for the runtime-count shift") }
	return ""
}
