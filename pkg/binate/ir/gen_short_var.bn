package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// multiReturnFieldTypes returns the per-result types packed into a multi-
// return result struct (the fields makeMultiReturnStructType built).  Used to
// recover the result types of a func-value / interface-method call, which —
// unlike a named free-function call — can't be found via lookupFuncResults.
func multiReturnFieldTypes(t @types.Type) @[]@types.Type {
	var out @[]@types.Type = make_slice(@types.Type, len(t.Fields))
	for i := 0; i < len(t.Fields); i++ {
		out[i] = t.Fields[i].Type
	}
	return out
}

// genShortVar generates IR for short variable declarations (x := expr or x, y := call()).
func genShortVar(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	if len(stmt.Exprs) >= 1 && len(stmt.Exprs2) >= 1 {
		// Multi-assign: q, r := call(...)
		if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == 1 {
			var val @Instr = genExpr(ctx, b, stmt.Exprs2[0])
			b = ctx.CurBlock
			var retTypes @[]@types.Type
			if val.Op == OP_CALL {
				retTypes = lookupFuncResults(ctx.Gc, val.StrVal)
			}
			// A func-value or interface-method call has no name to look
			// up, but its multi-return result is packed as a struct whose
			// fields carry the per-result types — derive them so a sub-word
			// result gets a correctly-typed slot.  Without this, elemTyp
			// below defaults to int and `a, b := fv()` for a `@func() (...,
			// uint16)` stores an i16 value into an i64 slot (invalid IR).
			if len(retTypes) == 0 && val.Typ != nil &&
					val.Typ.Kind == types.TYP_STRUCT {
				retTypes = multiReturnFieldTypes(val.Typ)
			}
			for i := 0; i < len(stmt.Exprs); i++ {
				var name @[]char = stmt.Exprs[i].Name
				var elemTyp @types.Type = types.TypInt()
				if len(retTypes) > 0 && i < len(retTypes) {
					elemTyp = retTypes[i]
				}
				// Blank identifier: still emit the extract (for
				// managed-value dtor correctness on the anonymous
				// multi-return struct) but don't allocate a name.
				var extracted @Instr = b.EmitExtract(val, i, elemTyp)
				if isBlank(name) {
					continue
				}
				var ptr @Instr = b.EmitAlloc(elemTyp)
				b.EmitStore(ptr, extracted)
				// Axiom 3 acquire (mirrors genMultiAssign): the extracted
				// component is a BORROW from the call-result temp, whose
				// dtor RefDec's it at end of statement; the new var is
				// RefDec'd again at scope exit (defineVar registers it as a
				// managed local).  Without an acquire that is 0 acquires / 2
				// releases — a double-free.  Managed scalars copy-RefInc; a
				// managed aggregate's fields are RefInc'd by emitStructCopy
				// (the slot is fresh, so no old value to dtor).
				emitManagedValueCopyRefInc(ctx.Func, b, extracted, elemTyp)
				if needsStructCopy(elemTyp) {
					emitStructCopy(ctx.Func, b, ptr, elemTyp)
				}
				defineVar(ctx, name, ptr, elemTyp)
			}
			return b
		}
		// Single assign
		var name @[]char = stmt.Exprs[0].Name
		// Blank: evaluate RHS for side effects, don't bind.
		if isBlank(name) {
			genExpr(ctx, b, stmt.Exprs2[0])
			return ctx.CurBlock
		}
		// Inferred bare func reference (`f := add`): the checker decays a
		// TYP_FUNC reference to @func (defaultType, managed-by-default); emit
		// the @func value directly rather than letting genExpr treat `add` as a
		// bare ident (which mis-lowers `f(...)` to a direct `main.f` symbol).
		// Mirrors genDecl's `var f = add` handling.
		if isFuncRefExpr(stmt.Exprs2[0]) {
			var refName @[]char = funcRefName(ctx.Gc, stmt.Exprs2[0])
			// A local/global VAR of the same name shadows the function (the
			// checker resolves to the var), so only synthesize when no such var
			// is in scope — otherwise this is an ordinary value load.
			if lookupVarType(ctx, refName) == nil &&
					lookupFuncExists(ctx.Gc, refName) {
				var fvTyp @types.Type =
					managedFuncValueTypeForName(ctx.Gc, refName)
				var fptr @Instr = b.EmitAlloc(fvTyp)
				var fval @Instr = b.EmitFuncValue(refName, fvTyp)
				noteSPGrowingResult(ctx, fval)
				b.EmitStore(fptr, fval)
				defineVar(ctx, name, fptr, fvTyp)
				return ctx.CurBlock
			}
		}
		var val @Instr = genExpr(ctx, b, stmt.Exprs2[0])
		b = ctx.CurBlock
		// If the RHS is a struct/array composite literal, the result is already
		// an alloca that IS the new variable's storage, so bind it directly.  An
		// IsGlobalRef pseudo also presents as an OP_ALLOC of a struct/array, but
		// it is an ADDRESS value (`q := &aggregateGlobal`), not fresh storage —
		// binding it directly would alias the global at the pointee (struct/array)
		// type instead of inferring `*T`.  Route it through the else branch, which
		// allocates a `*T` slot and stores the address.
		if isStructOrArrayAlloc(val) && !val.IsGlobalRef {
			defineVar(ctx, name, val, val.TypeArg)
		} else {
			// Infer type from RHS; default untyped int to int
			var typ @types.Type = types.TypInt()
			if val.Typ != nil {
				typ = val.Typ
				if typ.Kind == types.TYP_UNTYPED_INT {
					typ = types.TypInt()
				}
				if typ.Kind == types.TYP_UNTYPED_BOOL {
					typ = types.TypBool()
				}
			}
			// String literal default type is @[]readonly char (matches the
			// type-checker's defaultStringLitType). Convert the
			// OP_CONST_STRING value to a managed-slice view of rodata.
			if stmt.Exprs2[0].Kind == ast.EXPR_STRING_LIT {
				typ = types.MakeManagedSliceType(
					types.MakeReadonlyType(types.TypUint8()))
				if val.Op == OP_CONST_STRING {
					val = b.EmitStringToChars(val, typ)
					noteSPGrowingResult(ctx, val)
				}
			}
			// Acquire-and-store through the shared dispatcher: the four
			// managed-scalar kinds move-a-fresh-producer or RefInc-a-borrow,
			// and a managed struct/array gets its fields RefInc'd via
			// emitStructCopy — the arm the single-bind path previously lacked.
			// Without it, `tgt := src` of a managed-struct-by-value stored the
			// raw bytes without acquiring, so both src and tgt RefDec'd the
			// shared field at scope exit (a double-free).  isInit: a fresh
			// slot, no old value to release.
			var ptr @Instr = b.EmitAlloc(typ)
			b = emitStoreManagedSlot(ctx, b, ptr, val, typ, true)
			defineVar(ctx, name, ptr, typ)
		}
	}
	return b
}
