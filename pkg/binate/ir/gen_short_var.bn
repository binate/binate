package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// genShortVar generates IR for short variable declarations (x := expr or x, y := call()).
func genShortVar(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	if len(stmt.Exprs) >= 1 && len(stmt.Exprs2) >= 1 {
		// Multi-assign: q, r := call(...)
		if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == 1 {
			var val @Instr = genExpr(ctx, b, stmt.Exprs2[0])
			b = ctx.CurBlock
			var retTypes @[]@types.Type
			if val.Op == OP_CALL {
				retTypes = lookupFuncResults(val.StrVal)
			}
			for i := 0; i < len(stmt.Exprs); i++ {
				var name @[]char = stmt.Exprs[i].Name
				var elemTyp @types.Type = types.TypInt()
				if len(retTypes) > 0 && i < len(retTypes) {
					elemTyp = retTypes[i]
				}
				// Blank identifier: still emit the extract (for
				// managed-value dtor correctness on the anonymous
				// multi-return struct) but don't allocate a name.
				var extracted @Instr = b.EmitExtract(val, i, elemTyp)
				if isBlank(name) {
					continue
				}
				var ptr @Instr = b.EmitAlloc(elemTyp)
				b.EmitStore(ptr, extracted)
				// Axiom 3 acquire (mirrors genMultiAssign): the extracted
				// component is a BORROW from the call-result temp, whose
				// dtor RefDec's it at end of statement; the new var is
				// RefDec'd again at scope exit (defineVar registers it as a
				// managed local).  Without an acquire that is 0 acquires / 2
				// releases — a double-free.  Managed scalars copy-RefInc; a
				// managed aggregate's fields are RefInc'd by emitStructCopy
				// (the slot is fresh, so no old value to dtor).
				emitManagedValueCopyRefInc(ctx.Func, b, extracted, elemTyp)
				if needsStructCopy(elemTyp) {
					emitStructCopy(ctx.Func, b, ptr, elemTyp)
				}
				defineVar(ctx, name, ptr, elemTyp)
			}
			return b
		}
		// Single assign
		var name @[]char = stmt.Exprs[0].Name
		// Blank: evaluate RHS for side effects, don't bind.
		if isBlank(name) {
			genExpr(ctx, b, stmt.Exprs2[0])
			return ctx.CurBlock
		}
		var val @Instr = genExpr(ctx, b, stmt.Exprs2[0])
		b = ctx.CurBlock
		// If the RHS is a struct/array composite literal, the result is already an alloca
		if isStructOrArrayAlloc(val) {
			defineVar(ctx, name, val, val.TypeArg)
		} else {
			// Infer type from RHS; default untyped int to int
			var typ @types.Type = types.TypInt()
			if val.Typ != nil {
				typ = val.Typ
				if typ.Kind == types.TYP_UNTYPED_INT {
					typ = types.TypInt()
				}
				if typ.Kind == types.TYP_UNTYPED_BOOL {
					typ = types.TypBool()
				}
			}
			// String literal default type is @[]readonly char (matches the
			// type-checker's defaultStringLitType). Convert the
			// OP_CONST_STRING value to a managed-slice view of rodata.
			if stmt.Exprs2[0].Kind == ast.EXPR_STRING_LIT {
				typ = types.MakeManagedSliceType(
					types.MakeReadonlyType(types.TypUint8()))
				if val.Op == OP_CONST_STRING {
					val = b.EmitStringToChars(val, typ)
					noteSPGrowingResult(ctx, val)
				}
			}
			// Inc refcount if copying a managed pointer (not a fresh creation)
			if isManagedPtrType(typ) {
				if isFreshManagedPtr(val) {
					consumeTemp(ctx, val)
				} else {
					b.EmitRefInc(val)
				}
			}
			// Inc refcount if copying a managed slice (not a fresh creation)
			if isManagedSliceType(typ) {
				if isFreshManagedSlice(val) {
					consumeTemp(ctx, val)
				} else {
					emitManagedSliceRefInc(ctx.Func, b, val)
				}
			}
			// Inc refcount if copying an @func (not a fresh creation)
			if isManagedFuncValueType(typ) {
				if isFreshManagedFuncValue(val) {
					consumeTemp(ctx, val)
				} else {
					emitManagedFuncValueRefInc(ctx.Func, b, val)
				}
			}
			// Same handoff for a managed interface value.
			if isManagedIfaceValueType(typ) {
				if isFreshManagedIfaceValue(val) {
					consumeTemp(ctx, val)
				} else {
					emitManagedIfaceValueRefInc(ctx.Func, b, val)
				}
			}
			var ptr @Instr = b.EmitAlloc(typ)
			b.EmitStore(ptr, val)
			defineVar(ctx, name, ptr, typ)
		}
	}
	return b
}
