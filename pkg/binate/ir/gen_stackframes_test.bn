package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// buildStackFramesArgs makes a 2-element arg slice (skip, buf) in a fresh block
// for the tryEmitStackFrames tests.  Both are plain int consts — tryEmitStackFrames
// does not inspect arg types, only forwards them to EmitStackFrames.
func buildStackFramesArgs(entry @Block) @[]@Instr {
	var skip @Instr = entry.EmitConstInt(0, types.TypInt())
	var buf @Instr = entry.EmitConstInt(1, types.TypInt())
	var args @[]@Instr = make_slice(@Instr, 2)
	args[0] = skip
	args[1] = buf
	return args
}

// TestTryEmitStackFramesBareInDebug: the bare `_stack_frames` matches while the
// compiling package is pkg/std/debug, emitting OP_STACK_FRAMES.
func TestTryEmitStackFramesBareInDebug() testing.TestResult {
	var noParams @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc("pkg/std/debug", "Callers", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var args @[]@Instr = buildStackFramesArgs(entry)
	var r @Instr = tryEmitStackFrames(entry, "pkg/std/debug", "_stack_frames", args, types.TypInt())
	if r == nil { return fail("bare _stack_frames in pkg/std/debug should match") }
	if r.Op != iropcode.OP_STACK_FRAMES { return fail("should emit OP_STACK_FRAMES") }
	return ""
}

// TestTryEmitStackFramesQualified: the fully-qualified name matches regardless of
// the compiling package.
func TestTryEmitStackFramesQualified() testing.TestResult {
	var noParams @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc("pkg/other", "user", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var args @[]@Instr = buildStackFramesArgs(entry)
	var r @Instr = tryEmitStackFrames(
			entry, "pkg/other", "pkg/std/debug._stack_frames", args, types.TypInt())
	if r == nil { return fail("qualified pkg/std/debug._stack_frames should match") }
	if r.Op != iropcode.OP_STACK_FRAMES { return fail("should emit OP_STACK_FRAMES") }
	return ""
}

// TestTryEmitStackFramesBareGatedOut: the bare name in a DIFFERENT package is NOT
// hijacked — the helper returns nil so genCall emits an ordinary call.
func TestTryEmitStackFramesBareGatedOut() testing.TestResult {
	var noParams @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc("pkg/other", "user", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var args @[]@Instr = buildStackFramesArgs(entry)
	var r @Instr = tryEmitStackFrames(entry, "pkg/other", "_stack_frames", args, types.TypInt())
	if r != nil { return fail("bare _stack_frames outside pkg/std/debug must NOT match") }
	return ""
}
