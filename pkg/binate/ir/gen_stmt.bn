package "pkg/binate/ir"

import "pkg/binate/ast"

// annotateBlockInstrs sets the Line field on all instructions in a block
// that don't already have a line number set.
func annotateBlockInstrs(b @Block, line int) {
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Line == 0 {
			b.Instrs[i].Line = line
		}
	}
}

// ============================================================
// Statement generation
// ============================================================

// genBlock generates IR for a block statement, managing variable scope and cleanup.
func genBlock(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	return genBlockEx(ctx, b, stmt, false)
}

// genBlockEx is genBlock with control over the NORMAL (fall-off) scope-exit
// cleanup.  skipFalloffCleanup=true suppresses the block's own
// emitDecForScopeVars + ctx.Vars truncation on a fall-off exit, leaving this
// block's managed locals live in ctx.Vars for the caller to release.  It is used
// for the OUTERMOST function-body block when the function has defers: the
// function-exit epilogue must run the deferred calls (emitPendingDefers) while
// the body's function-scope locals are still live, then release everything
// (stmt.defer.exit) — the same order the `return` path already gives.  The
// terminated-exit path (a `return` in the body handles its own full release) is
// unchanged.  Nested blocks always use the default (skipFalloffCleanup=false).
func genBlockEx(ctx @GenContext, b @Block, stmt @ast.Stmt, skipFalloffCleanup bool) @Block {
	if stmt.Kind == ast.STMT_BLOCK {
		// Per-statement import overlay for the synthetic package `__init` body:
		// its statements come from different files (each file's top-level var
		// initializers), so each must be lowered under ITS file's imports, not a
		// merged map (see GenCtx.InitOverlay*).  Capture and disable for nested
		// blocks (a single initializer's own statements share its file), and
		// only the outermost __init block switches per statement.
		var ovMerged @ast.File = ctx.Gc.InitOverlayMerged
		if ovMerged != nil {
			ctx.Gc.InitOverlayMerged = nil
		}
		// Save scope depth to restore on exit
		var savedVarLen int = len(ctx.Vars)
		var cur @Block = b
		for i := 0; i < len(stmt.Stmts); i++ {
			if ovMerged != nil {
				overlayFileImports(ctx.Gc.Mod, ctx.Gc.InitOverlayBase,
						declImportFile(ctx.Gc.InitOverlayFiles, ovMerged, stmt.Stmts[i].Pos.File))
			}
			var stmtLine int = stmt.Stmts[i].Pos.Line
			cur = genStmt(ctx, cur, stmt.Stmts[i])
			// Annotate instructions emitted by this statement with its line number
			if stmtLine > 0 {
				annotateBlockInstrs(cur, stmtLine)
			}
			// If block is terminated (return/break/continue), stop
			if len(cur.Instrs) > 0 && cur.Instrs[len(cur.Instrs) - 1].IsTerminator() {
				// Don't emit scope cleanup here — return already handles its own dec,
				// and break/continue jump to blocks that will handle cleanup
				ctx.Vars = ctx.Vars[:savedVarLen]
				return cur
			}
		}
		// Normal scope exit: dec managed ptr vars declared in this scope — unless
		// the caller defers it (skipFalloffCleanup), keeping this block's locals
		// live in ctx.Vars so the function-exit epilogue can run deferred calls
		// before releasing them.
		if !skipFalloffCleanup {
			cur = emitDecForScopeVars(ctx, cur, savedVarLen)
			ctx.Vars = ctx.Vars[:savedVarLen]
		}
		return cur
	}
	return genStmt(ctx, b, stmt)
}

// genStmt dispatches statement generation by AST node kind.
func genStmt(ctx @GenContext, b @Block, stmt @ast.Stmt) @Block {
	if stmt.Kind == ast.STMT_EXPR {
		genExpr(ctx, b, stmt.X)
		b = ctx.CurBlock
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_RETURN {
		return genReturnStmt(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_DECL {
		ctx.CurBlock = b
		genDecl(ctx, b, stmt.DeclRef)
		b = ctx.CurBlock
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_ASSIGN {
		b = genAssign(ctx, b, stmt)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_SHORT_VAR {
		b = genShortVar(ctx, b, stmt)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_IF {
		return genIf(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_FOR {
		return genFor(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_INC_DEC {
		return genIncDec(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_BREAK {
		if ctx.BreakTo != nil {
			// RefDec the managed locals declared since the break target's
			// scope (Vars[BreakVarLen:]) — the target block doesn't (genBlock /
			// genCaseBody drop them without a dec on this terminator), so
			// without it a managed local before the break leaks.
			b = emitDecForScopeVars(ctx, b, ctx.BreakVarLen)
			b.EmitJump(ctx.BreakTo)
		}
		return b
	}

	if stmt.Kind == ast.STMT_CONTINUE {
		if ctx.ContinueTo != nil {
			b = emitDecForScopeVars(ctx, b, ctx.ContinueVarLen)
			b.EmitJump(ctx.ContinueTo)
		}
		return b
	}

	if stmt.Kind == ast.STMT_EMPTY {
		return b
	}

	if stmt.Kind == ast.STMT_BLOCK {
		return genBlock(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_SWITCH {
		return genSwitch(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_TYPE_SWITCH {
		return genTypeSwitch(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_DEFER {
		return genDeferStmt(ctx, b, stmt)
	}

	// Unsupported statement — skip
	return b
}
