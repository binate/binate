package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/irsym"
import "pkg/std/table"
import "pkg/std/vec"

// RegisterModuleStruct appends ms to m.Structs, recording its index under its name
// unless an earlier entry has the same name (a lookup finds the first).
func RegisterModuleStruct(m @Module, ms irsym.ModuleStruct) {
	if m.StructsVec == nil || !same(m.Structs, m.StructsVec.Items()) {
		// Structs was replaced, or the builder never made: it restarts from Structs.
		m.StructsVec = vec.New[irsym.ModuleStruct]()
		for i := 0; i < len(m.Structs); i++ {
			m.StructsVec.Push(m.Structs[i])
		}
		m.Structs = m.StructsVec.Items()
	}
	syncStructIndex(m)
	var idx int = m.StructsVec.Len()
	m.StructsVec.Push(ms)
	m.Structs = m.StructsVec.Items()
	_, _ = m.StructIndex.GetOrPut(ms.Name, idx)
	m.StructIndexFor = m.Structs
}

// StructIndexLookup returns the index in m.Structs of the first struct named name,
// or -1.  It never replaces m.Structs, so a write through m.Structs indexed by its
// result lands in the list it indexes.
func StructIndexLookup(m @Module, name *[]readonly char) int {
	syncStructIndex(m)
	var idx int
	var ok bool
	idx, ok = m.StructIndex.Get(name)
	if ok {
		return idx
	}
	return -1
}

// syncStructIndex rebuilds m.StructIndex over m.Structs unless it was built over
// this very list (StructIndexFor).
func syncStructIndex(m @Module) {
	if m.StructIndex != nil && same(m.StructIndexFor, m.Structs) {
		return
	}
	m.StructIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(m.Structs); i++ {
		_, _ = m.StructIndex.GetOrPut(m.Structs[i].Name, i)
	}
	m.StructIndexFor = m.Structs
}
