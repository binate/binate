package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/builtins/testing"
import "pkg/std/vec"
import "pkg/stdx/slices"

// Tests for RegisterModuleStruct / StructIndexLookup: Module.Structs grows through
// its vec builder, a name is found through the index, and both stay right when a
// writer replaces Structs.

// namedStruct returns a module struct entry named name.
func namedStruct(name *[]readonly char) irsym.ModuleStruct {
	var ms irsym.ModuleStruct
	ms.Name = buf.CopyStr(name)
	return ms
}

// Registered structs are the list, in order, and each name finds its index; a name
// registered twice finds its first entry, and an unknown name finds nothing.
func TestStructIndexRegisterAndLookup() testing.TestResult {
	var m @Module = NewModule("m")
	if StructIndexLookup(m, "pkg.A") != -1 { return fail("a fresh module finds nothing") }
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	RegisterModuleStruct(m, namedStruct("pkg.B"))
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	if len(m.Structs) != 3 { return fail("three entries") }
	if StructIndexLookup(m, "pkg.A") != 0 || StructIndexLookup(m, "pkg.B") != 1 {
		return fail("each name finds its first entry")
	}
	if StructIndexLookup(m, "pkg.C") != -1 { return fail("an unknown name finds nothing") }
	return ""
}

// A field written in place through Structs survives later registrations, which
// keep Structs a view of the same entries.
func TestStructIndexInPlaceWriteSurvives() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	m.Structs[0].IsInstantiation = true
	for i := 0; i < 40; i++ {
		RegisterModuleStruct(m, namedStruct("pkg.B"))
	}
	if !m.Structs[0].IsInstantiation { return fail("the in-place write is kept") }
	return ""
}

// After Structs is truncated (the REPL's rollback), a dropped name finds nothing, a
// kept one still finds its entry, and a new registration lands right after the
// kept entries.
func TestStructIndexAfterTruncation() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	RegisterModuleStruct(m, namedStruct("pkg.B"))
	m.Structs = m.Structs[:1]
	if StructIndexLookup(m, "pkg.B") != -1 { return fail("a dropped name finds nothing") }
	if StructIndexLookup(m, "pkg.A") != 0 { return fail("a kept name finds its entry") }
	RegisterModuleStruct(m, namedStruct("pkg.C"))
	if len(m.Structs) != 2 || StructIndexLookup(m, "pkg.C") != 1 {
		return fail("a new entry follows the kept ones")
	}
	return ""
}

// A Module made without NewModule (no builder or index yet) registers and looks up
// its structs too.
func TestStructIndexBareModule() testing.TestResult {
	var m @Module = make(Module)
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	if len(m.Structs) != 1 || StructIndexLookup(m, "pkg.A") != 0 { return fail("a bare module") }
	return ""
}

// Registrations keep one builder and keep Structs its view (the amortized path,
// with no rebuild), and lookups never replace Structs, even when it is stale.
func TestStructIndexFastPathAndPureLookups() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	var v0 @vec.Vec[irsym.ModuleStruct] = m.StructsVec
	for i := 0; i < 40; i++ {
		RegisterModuleStruct(m, namedStruct("pkg.B"))
	}
	if !same(m.StructsVec, v0) || !same(m.Structs, m.StructsVec.Items()) {
		return fail("registrations keep one builder, with Structs its view")
	}
	m.Structs = m.Structs[:2]
	var cut @[]irsym.ModuleStruct = m.Structs
	if StructIndexLookup(m, "pkg.B") != 1 || !same(m.Structs, cut) {
		return fail("a lookup on a truncated list leaves it in place")
	}
	return ""
}

// A struct appended to Structs directly (as some tests do) is found by name, and a
// registration after it lands after it.
func TestStructIndexAfterDirectAppend() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	m.Structs = slices.Append[irsym.ModuleStruct](m.Structs, namedStruct("pkg.D"))
	if StructIndexLookup(m, "pkg.D") != 1 { return fail("a directly appended struct is found") }
	RegisterModuleStruct(m, namedStruct("pkg.E"))
	if len(m.Structs) != 3 || StructIndexLookup(m, "pkg.E") != 2 ||
			StructIndexLookup(m, "pkg.A") != 0 {
		return fail("a registration lands after the appended entry")
	}
	return ""
}

// A name dropped by truncation (the REPL's rollback) and registered again (the
// prompt redefining it) is found at its new index.
func TestStructIndexReregisterAfterTruncation() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleStruct(m, namedStruct("pkg.A"))
	RegisterModuleStruct(m, namedStruct("pkg.B"))
	RegisterModuleStruct(m, namedStruct("pkg.C"))
	m.Structs = m.Structs[:1]
	RegisterModuleStruct(m, namedStruct("pkg.C"))
	if len(m.Structs) != 2 || StructIndexLookup(m, "pkg.C") != 1 ||
			StructIndexLookup(m, "pkg.B") != -1 {
		return fail("the re-registered name is found at its new index")
	}
	return ""
}
