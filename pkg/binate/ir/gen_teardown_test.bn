package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the synthetic global-teardown generator in gen_teardown.bn: a
// module gets a `<pkg>.__vm_teardown_globals` function iff it has a managed
// global whose content needs RefDec'ing at VM shutdown.

// TestTeardownEmittedForManagedPtrGlobal: a `var g @Foo` global (managed
// pointer) produces the teardown function.
func TestTeardownEmittedForManagedPtrGlobal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Foo struct { x int }\n")
	cb.Write("var g @Foo\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourceWithChecker(src)
	if !hasFuncNamed(m, "test.__vm_teardown_globals") {
		return fail("expected test.__vm_teardown_globals for a managed-ptr global")
	}
	return ""
}

// TestTeardownEmittedForManagedSliceGlobal: a `var s @[]int` global (managed
// slice) also produces the teardown function.
func TestTeardownEmittedForManagedSliceGlobal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var s @[]int\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourceWithChecker(src)
	if !hasFuncNamed(m, "test.__vm_teardown_globals") {
		return fail("expected test.__vm_teardown_globals for a managed-slice global")
	}
	return ""
}

// TestNoTeardownForPlainGlobals: a package whose globals are all non-managed
// (a plain `int`) gets NO teardown function — nothing owns content to release.
func TestNoTeardownForPlainGlobals() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("var n int = 7\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourceWithChecker(src)
	if hasFuncNamed(m, "test.__vm_teardown_globals") {
		return fail("expected NO teardown function when no managed globals")
	}
	return ""
}

// TestNoTeardownWithoutGlobals: a package with no globals at all gets no
// teardown function.
func TestNoTeardownWithoutGlobals() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @Module = genFromSourceWithChecker(src)
	if hasFuncNamed(m, "test.__vm_teardown_globals") {
		return fail("expected NO teardown function when there are no globals")
	}
	return ""
}
