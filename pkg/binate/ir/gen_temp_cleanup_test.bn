package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the temporary-value cleanup helpers in gen_temp_cleanup.bn.  The
// register/consume bookkeeping is pinned directly here; the emit* cleanup helpers
// (which RefDec the live temps at statement / scope / return boundaries) are
// exercised end-to-end by the gen_dtor tests and conformance.  fail lives in the
// package's other test files.

// registerTemp appends to ctx.Temps; consumeTemp removes exactly the matching entry
// (by Instr.ID), leaving the rest — so a temp whose ownership moved into a slot is
// not also RefDec'd at end-of-statement.  Consuming an absent id is a no-op.
func TestRegisterAndConsumeTemp() testing.TestResult {
	var ctx @GenContext = make(GenContext)
	var i0 @Instr = make(Instr)
	i0.ID = 1
	var i1 @Instr = make(Instr)
	i1.ID = 2
	registerTemp(ctx, i0)
	registerTemp(ctx, i1)
	if len(ctx.Temps) != 2 {
		return fail("registerTemp should append both temps")
	}
	consumeTemp(ctx, i0)
	if len(ctx.Temps) != 1 {
		return fail("consumeTemp should remove exactly the matching temp")
	}
	if ctx.Temps[0].ID != 2 {
		return fail("consumeTemp should leave the non-matching temp (id 2)")
	}
	consumeTemp(ctx, i0)
	if len(ctx.Temps) != 1 {
		return fail("consumeTemp of an absent id should be a no-op")
	}
	return ""
}

// When a statement's own expression terminates the block — a `panic(...)` or
// other noreturn call emits OP_UNREACHABLE — its managed temps are dead.
// emitTempCleanup must NOT emit a RefDec into the terminated block: a managed
// RefDec branches (null-check), so it would give the block a SECOND terminator,
// i.e. malformed IR (which the structural verifier flags, and which silently
// drops code without --verify-ir).  Regression for the ctx.CurBlock-desync class:
// an inline managed temp (e.g. a strings.Builder panic message) after a switch.
func TestEmitTempCleanupSkipsTerminatedBlock() testing.TestResult {
	var ctx @GenContext = make(GenContext)
	var noParams @[]@Param
	var noResults @[]@types.Type
	var f @Func = NewFunc("", "t", noParams, noResults)
	var b @Block = AddBlock(f, "switch.exit")
	b.EmitUnreachable() // the statement's noreturn expr terminated the block
	var tmp @Instr = make(Instr)
	tmp.ID = 1
	tmp.Typ = types.MakeManagedSliceType(types.TypChar()) // a live managed temp
	registerTemp(ctx, tmp)
	var nBefore int = len(b.Instrs)
	var out @Block = emitTempCleanup(ctx, b)
	if out != b {
		return fail("emitTempCleanup should return the same terminated block")
	}
	if len(b.Instrs) != nBefore {
		return fail("emitTempCleanup must emit NOTHING into a terminated block")
	}
	if len(ctx.Temps) != 0 {
		return fail("emitTempCleanup must still clear ctx.Temps")
	}
	return ""
}
