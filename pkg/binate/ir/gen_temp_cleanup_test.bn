package "pkg/binate/ir"

import "pkg/builtins/testing"

// Tests for the temporary-value cleanup helpers in gen_temp_cleanup.bn.  The
// register/consume bookkeeping is pinned directly here; the emit* cleanup helpers
// (which RefDec the live temps at statement / scope / return boundaries) are
// exercised end-to-end by the gen_dtor tests and conformance.  fail lives in the
// package's other test files.

// registerTemp appends to ctx.Temps; consumeTemp removes exactly the matching entry
// (by Instr.ID), leaving the rest — so a temp whose ownership moved into a slot is
// not also RefDec'd at end-of-statement.  Consuming an absent id is a no-op.
func TestRegisterAndConsumeTemp() testing.TestResult {
	var ctx @GenContext = make(GenContext)
	var i0 @Instr = make(Instr)
	i0.ID = 1
	var i1 @Instr = make(Instr)
	i1.ID = 2
	registerTemp(ctx, i0)
	registerTemp(ctx, i1)
	if len(ctx.Temps) != 2 {
		return fail("registerTemp should append both temps")
	}
	consumeTemp(ctx, i0)
	if len(ctx.Temps) != 1 {
		return fail("consumeTemp should remove exactly the matching temp")
	}
	if ctx.Temps[0].ID != 2 {
		return fail("consumeTemp should leave the non-matching temp (id 2)")
	}
	consumeTemp(ctx, i0)
	if len(ctx.Temps) != 1 {
		return fail("consumeTemp of an absent id should be a no-op")
	}
	return ""
}
