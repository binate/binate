package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen.bn: package-level globals and lookup functions.

func TestLookupStructIdxNotFound() testing.TestResult {
	// A fresh module's Structs table is empty, so lookup returns -1.
	var m @Module = NewModule("test")
	var idx int = lookupStructIdx(NewGenCtx(m), "Nonexistent")
	if idx != -1 { return fail("expected -1 for missing struct") }
	return ""
}

func TestLookupFuncExistsNotFound() testing.TestResult {
	var m @Module = NewModule("test")
	if lookupFuncExists(NewGenCtx(m), "Nonexistent") { return fail("expected false") }
	return ""
}
