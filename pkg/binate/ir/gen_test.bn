package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen.bn: package-level globals and lookup functions.

func TestLookupStructIdxNotFound() testing.TestResult {
	// With empty moduleStructs, lookup should return -1
	var emptyStructs @[]ModuleStruct
	moduleStructs = emptyStructs
	var idx int = lookupStructIdx(NewGenCtx(nil), "Nonexistent")
	if idx != -1 { return fail("expected -1 for missing struct") }
	return ""
}

func TestLookupFuncExistsNotFound() testing.TestResult {
	var emptyFuncs @[]FuncSig
	moduleFuncs = emptyFuncs
	if lookupFuncExists(NewGenCtx(nil), "Nonexistent") { return fail("expected false") }
	return ""
}
