package "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/irsym"
import "pkg/std/table"
import "pkg/std/vec"

// RegisterModuleTypeAlias appends ta to m.TypeAliases, recording its index under its
// name unless an earlier entry has the same name (a lookup finds the first).
func RegisterModuleTypeAlias(m @Module, ta irsym.ModuleTypeAlias) {
	if m.TypeAliasesVec == nil || !same(m.TypeAliases, m.TypeAliasesVec.Items()) {
		// TypeAliases was replaced, or the builder never made: it restarts from it.
		m.TypeAliasesVec = vec.New[irsym.ModuleTypeAlias]()
		for i := 0; i < len(m.TypeAliases); i++ {
			m.TypeAliasesVec.Push(m.TypeAliases[i])
		}
		m.TypeAliases = m.TypeAliasesVec.Items()
	}
	syncTypeAliasIndex(m)
	var idx int = m.TypeAliasesVec.Len()
	m.TypeAliasesVec.Push(ta)
	m.TypeAliases = m.TypeAliasesVec.Items()
	_, _ = m.TypeAliasIndex.GetOrPut(ta.Name, idx)
	m.TypeAliasIndexFor = m.TypeAliases
}

// TypeAliasIndexLookup returns the index in m.TypeAliases of the first entry named
// name, or -1.  It never replaces m.TypeAliases, so a write through m.TypeAliases
// indexed by its result lands in the list it indexes.
func TypeAliasIndexLookup(m @Module, name *[]readonly char) int {
	syncTypeAliasIndex(m)
	var idx int
	var ok bool
	idx, ok = m.TypeAliasIndex.Get(name)
	if ok {
		return idx
	}
	return -1
}

// syncTypeAliasIndex rebuilds m.TypeAliasIndex over m.TypeAliases unless it was built
// over this very list (TypeAliasIndexFor).
func syncTypeAliasIndex(m @Module) {
	if m.TypeAliasIndex != nil && same(m.TypeAliasIndexFor, m.TypeAliases) {
		return
	}
	m.TypeAliasIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(m.TypeAliases); i++ {
		_, _ = m.TypeAliasIndex.GetOrPut(m.TypeAliases[i].Name, i)
	}
	m.TypeAliasIndexFor = m.TypeAliases
}
