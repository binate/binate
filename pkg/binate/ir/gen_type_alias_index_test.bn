package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for RegisterModuleTypeAlias / TypeAliasIndexLookup: Module.TypeAliases grows
// through its vec builder, a name is found through the index, and both stay right when
// a writer replaces TypeAliases.

// namedAlias returns a module type-alias entry named name.
func namedAlias(name *[]readonly char) irsym.ModuleTypeAlias {
	var ta irsym.ModuleTypeAlias
	ta.Name = buf.CopyStr(name)
	return ta
}

// Registered entries are the list, in order, and each name finds its index; a name
// registered twice finds its first entry, and an unknown name finds nothing.
func TestTypeAliasIndexRegisterAndLookup() testing.TestResult {
	var m @Module = NewModule("m")
	if TypeAliasIndexLookup(m, "pkg.A") != -1 { return fail("a fresh module finds nothing") }
	RegisterModuleTypeAlias(m, namedAlias("pkg.A"))
	RegisterModuleTypeAlias(m, namedAlias("pkg.B"))
	RegisterModuleTypeAlias(m, namedAlias("pkg.A"))
	if len(m.TypeAliases) != 3 { return fail("three entries") }
	if TypeAliasIndexLookup(m, "pkg.A") != 0 || TypeAliasIndexLookup(m, "pkg.B") != 1 {
		return fail("each name finds its first entry")
	}
	if TypeAliasIndexLookup(m, "pkg.C") != -1 { return fail("an unknown name finds nothing") }
	return ""
}

// After TypeAliases is truncated (the REPL's rollback), a dropped name finds nothing, a
// kept one still finds its entry, and a name registered again finds its new index.
func TestTypeAliasIndexAfterTruncation() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleTypeAlias(m, namedAlias("pkg.A"))
	RegisterModuleTypeAlias(m, namedAlias("pkg.B"))
	RegisterModuleTypeAlias(m, namedAlias("pkg.C"))
	m.TypeAliases = m.TypeAliases[:1]
	if TypeAliasIndexLookup(m, "pkg.B") != -1 { return fail("a dropped name finds nothing") }
	if TypeAliasIndexLookup(m, "pkg.A") != 0 { return fail("a kept name finds its entry") }
	RegisterModuleTypeAlias(m, namedAlias("pkg.C"))
	if len(m.TypeAliases) != 2 || TypeAliasIndexLookup(m, "pkg.C") != 1 {
		return fail("the re-registered name is found at its new index")
	}
	return ""
}

// An entry appended to TypeAliases directly (as some tests do) is found by name, and a
// registration after it lands after it; a Module made without NewModule registers too.
func TestTypeAliasIndexDirectAppendAndBareModule() testing.TestResult {
	var m @Module = NewModule("m")
	RegisterModuleTypeAlias(m, namedAlias("pkg.A"))
	m.TypeAliases = slices.Append[irsym.ModuleTypeAlias](m.TypeAliases, namedAlias("pkg.D"))
	if TypeAliasIndexLookup(m, "pkg.D") != 1 { return fail("a directly appended entry is found") }
	RegisterModuleTypeAlias(m, namedAlias("pkg.E"))
	if len(m.TypeAliases) != 3 || TypeAliasIndexLookup(m, "pkg.E") != 2 ||
			TypeAliasIndexLookup(m, "pkg.A") != 0 {
		return fail("a registration lands after the appended entry")
	}
	var bare @Module = make(Module)
	RegisterModuleTypeAlias(bare, namedAlias("pkg.A"))
	if len(bare.TypeAliases) != 1 || TypeAliasIndexLookup(bare, "pkg.A") != 0 {
		return fail("a bare module")
	}
	return ""
}
