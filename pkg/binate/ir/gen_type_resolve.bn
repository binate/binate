package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Type resolution (syntax TypeExpr → types.Type)
// ============================================================
//
// resolveTypeExpr and its helpers (ifaceValueTypesAgree,
// findAnonStruct), split out of gen_util.bn for file-length hygiene.
// Inside a monomorphized generic body emitted for an imported
// package, an unqualified type head keys on the defining-package
// alias (currentImportAlias) — see ensureInstantiated.

// ifaceValueTypesAgree reports whether two iface-value types
// wrap the same canonical interface.  Both sides are resolved
// through the alias chain (canonicalIfacePkg / canonicalIfaceName)
// before comparing, so an interface and a re-export alias of it
// (`interface Greeter = inner.Greeter`) agree — they ARE the same
// interface, with an identical vtable layout, so no OP_IFACE_UPCAST
// (vtable base adjustment) is wanted.  Comparing the raw (Pkg, Name)
// instead treats the alias as a distinct interface, emits a spurious
// upcast, and IfaceParentSlotOffset then returns -1 (the alias is not
// a PARENT of its target) — used as a GEP offset that walks the
// vtable pointer one slot BEFORE its base, so the dispatched method
// slot loads the dtor word and the call jumps through null.  Kind
// differences (raw vs managed) flow through here as "not the
// same" — those go through the upcast path too (managed-to-raw
// decay across the same interface).
func ifaceValueTypesAgree(a @types.Type, b @types.Type) bool {
	if a == nil || b == nil { return false }
	if a.Kind != b.Kind { return false }
	if a.Elem == nil || b.Elem == nil { return false }
	if a.Elem.Kind != types.TYP_INTERFACE { return false }
	if b.Elem.Kind != types.TYP_INTERFACE { return false }
	var aPkg @[]char = canonicalIfacePkg(a.Elem.Pkg, a.Elem.Name)
	var aName @[]char = canonicalIfaceName(a.Elem.Pkg, a.Elem.Name)
	var bPkg @[]char = canonicalIfacePkg(b.Elem.Pkg, b.Elem.Name)
	var bName @[]char = canonicalIfaceName(b.Elem.Pkg, b.Elem.Name)
	return charEq(aPkg, bPkg) && charEq(aName, bName)
}

// resolveTypeExpr resolves a syntax-level TypeExpr to the corresponding types.Type.
func resolveTypeExpr(gc @GenCtx, te @ast.TypeExpr) @types.Type {
	if te == nil {
		return types.TypVoid()
	}
	if te.Kind == ast.TEXPR_NAMED {
		// Generic-instantiation substitution (plan-generics.md
		// Slice 4a).  When IR-gen is emitting the body of an
		// instantiated generic, a bare type-param reference like
		// `T` must resolve to the concrete type the caller
		// supplied — not to the fallback TypInt() at the end of
		// this function, which would silently miscompile.
		if len(te.Pkg) == 0 {
			for i := 0; i < len(gc.CurrentTypeParamNames); i++ {
				if streq(te.Name, gc.CurrentTypeParamNames[i]) {
					return gc.CurrentTypeParamTypes[i]
				}
			}
		}
		// Check for package-qualified type (e.g., ast.File)
		if len(te.Pkg) > 0 {
			var qualName @[]char = buildQualName(te.Pkg, te.Name)
			var si int = lookupStructIdx(gc, qualName)
			if si >= 0 {
				return gc.Mod.Structs[si].Typ
			}
			// Check type aliases
			var aliasTyp @types.Type = lookupTypeAlias(gc, qualName)
			if aliasTyp != nil {
				return aliasTyp
			}
			return types.TypInt() // fallback
		}
		if streq(te.Name, "int") { return types.TypInt() }
		if streq(te.Name, "uint") { return types.TypUint() }
		if streq(te.Name, "int8") { return types.TypInt8() }
		if streq(te.Name, "int16") { return types.TypInt16() }
		if streq(te.Name, "int32") { return types.TypInt32() }
		if streq(te.Name, "int64") { return types.TypInt64() }
		if streq(te.Name, "uint8") { return types.TypUint8() }
		if streq(te.Name, "uint16") { return types.TypUint16() }
		if streq(te.Name, "uint32") { return types.TypUint32() }
		if streq(te.Name, "uint64") { return types.TypUint64() }
		if streq(te.Name, "float32") { return types.TypFloat32() }
		if streq(te.Name, "float64") { return types.TypFloat64() }
		if streq(te.Name, "byte") { return types.TypByte() }
		if streq(te.Name, "bool") { return types.TypBool() }
		if streq(te.Name, "char") { return types.TypChar() }
		// Check module-level struct types
		var si int = lookupStructIdx(gc, te.Name)
		if si >= 0 {
			return gc.Mod.Structs[si].Typ
		}
		// Check local type aliases
		var localAlias @types.Type = lookupTypeAlias(gc, te.Name)
		if localAlias != nil {
			return localAlias
		}
		// Try with current import alias prefix
		if len(currentImportAlias) > 0 {
			var qualName @[]char = buildQualName(
				currentImportAlias, te.Name)
			si = lookupStructIdx(gc, qualName)
			if si >= 0 {
				return gc.Mod.Structs[si].Typ
			}
			var prefixedAlias @types.Type = lookupTypeAlias(gc, qualName)
			if prefixedAlias != nil {
				return prefixedAlias
			}
		}
		return types.TypInt() // fallback
	}
	if te.Kind == ast.TEXPR_INSTANTIATE {
		// Generic struct instantiation (Slice 5c of
		// plan-generics.md): look up the generic decl, resolve
		// each type arg, then register / fetch the per-(decl,
		// args) instantiated struct via ensureInstantiatedStruct.
		//
		// Slice 7b: also accept pkg-qualified heads
		// (`pkg.Vec[int]`); lookupGenericTypeDeclPkg keys on the
		// import alias.
		if te.Base != nil && te.Base.Kind == ast.TEXPR_NAMED {
			var lookupPkg @[]char
			if len(te.Base.Pkg) > 0 {
				// Resolve the source alias to the full path — generic decls
				// stash under the full path, so a raw source alias misses
				// (and a same-final-segment alias would resolve to the wrong one).
				lookupPkg = resolveImportPkg(te.Base.Pkg)
			} else if len(currentImportAlias) > 0 {
				// Inside a monomorphized generic body emitted for an
				// imported package, an unqualified generic-struct head
				// (`Box[T]`) names the defining package's generic, not
				// one in the consumer module — key the lookup on the
				// defining alias (see ensureInstantiated).
				lookupPkg = currentImportAlias
			} else {
				lookupPkg = gc.PkgPath
			}
			var d @ast.Decl = lookupGenericTypeDeclPkg(gc, lookupPkg,
				te.Base.Name)
			if d != nil {
				var argTypes @[]@types.Type
				for i := 0; i < len(te.TypeArgs); i++ {
					argTypes = slices.Append[@types.Type](argTypes,
						resolveTypeExpr(gc, te.TypeArgs[i]))
				}
				return ensureInstantiatedStruct(gc, d, argTypes)
			}
		}
		return types.TypInt()
	}
	if te.Kind == ast.TEXPR_PAREN {
		return resolveTypeExpr(gc, te.Base)
	}
	if te.Kind == ast.TEXPR_CONST {
		// Stage 0 of the const rollout: wrap the resolved inner type
		// with TYP_READONLY. const is transparent to layout and most
		// queries, so the rest of IR gen doesn't need to know.
		return types.MakeReadonlyType(resolveTypeExpr(gc, te.Base))
	}
	if te.Kind == ast.TEXPR_SLICE {
		return types.MakeSliceType(resolveTypeExpr(gc, te.Base))
	}
	if te.Kind == ast.TEXPR_POINTER {
		// `*Iface` (raw interface value) — base resolves to the
		// declared interface name. Per Slice 2.0 of plan-interface-
		// syntax-revision.md, the bare interface name isn't a usable
		// type expression; only `*Iface` / `@Iface` are. IR-gen's
		// type resolver detects the form via the per-module
		// interface registry and produces TYP_INTERFACE_VALUE so
		// codegen can emit `%BnIfaceValue` for the slot.
		if isInterfaceTypeExpr(gc, te.Base) {
			return types.MakeInterfaceValueType(
				ifaceTypeForName(gc, te.Base))
		}
		return types.MakePointerType(resolveTypeExpr(gc, te.Base))
	}
	if te.Kind == ast.TEXPR_MANAGED {
		// `@Iface` (managed interface value) — same recognition as
		// TEXPR_POINTER's interface-value path, producing
		// TYP_INTERFACE_VALUE_MANAGED.
		if isInterfaceTypeExpr(gc, te.Base) {
			return types.MakeManagedInterfaceValueType(
				ifaceTypeForName(gc, te.Base))
		}
		return types.MakeManagedPtrType(resolveTypeExpr(gc, te.Base))
	}
	if te.Kind == ast.TEXPR_MANAGED_SLICE {
		return types.MakeManagedSliceType(resolveTypeExpr(gc, te.Base))
	}
	if te.Kind == ast.TEXPR_ARRAY {
		var arrLen int = 0
		if te.Len != nil {
			// te.Len is a full expression: a literal (`[3]int`), a const
			// ident (`[N]int`), or a constant expression (`[N+1]int`).
			// evalConstExpr resolves const idents (via lookupConst) and
			// folds the arithmetic; parseIntLit on the raw ident text
			// would read 'N' as a bogus digit.  Fall back to parseIntLit
			// only when the expression is not const-evaluable.
			var v int
			var ok bool
			v, ok = evalConstExpr(gc, te.Len, 0)
			if ok {
				arrLen = v
			} else {
				arrLen = parseIntLit(te.Len.Name)
			}
		}
		return types.MakeArrayType(resolveTypeExpr(gc, te.Base), arrLen)
	}
	if te.Kind == ast.TEXPR_FUNC_VALUE ||
		te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		// Function-value type. The signature (Params/Results) is
		// only load-bearing for vtable type generation downstream;
		// here we just build the right Type kind so SizeOf returns
		// 16 and emitConstNil / lowerStore route through the
		// multi-word path.
		var params @[]@types.Param
		for i := 0; i < len(te.ParamTypes); i++ {
			var p @types.Param = make(types.Param)
			p.Type = resolveTypeExpr(gc, te.ParamTypes[i])
			params = slices.Append[@types.Param](params, p)
		}
		var results @[]@types.Type
		for i := 0; i < len(te.ResultTypes); i++ {
			results = slices.Append[@types.Type](results,
				resolveTypeExpr(gc, te.ResultTypes[i]))
		}
		if te.Kind == ast.TEXPR_FUNC_VALUE {
			return types.MakeFuncValueType(params, results)
		}
		return types.MakeManagedFuncValueType(params, results)
	}
	if te.Kind == ast.TEXPR_STRUCT {
		var fields @[]@types.Field
		for i := 0; i < len(te.Fields); i++ {
			var fd @ast.FieldDecl = te.Fields[i]
			var f @types.Field = make(types.Field)
			f.Name = fd.Name
			f.Type = resolveTypeExpr(gc, fd.Type)
			fields = slices.Append[@types.Field](fields, f)
		}
		// Check if identical anonymous struct already registered
		var existing @types.Type = findAnonStruct(gc, fields)
		if existing != nil {
			return existing
		}
		// Assign synthetic name for codegen
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("__anon_")
		stringutils.WriteInt(cb, gc.AnonStructCounter)
		gc.AnonStructCounter = gc.AnonStructCounter + 1
		var synthName @[]char = buf.CopyStr(cb.String())
		var anonTyp @types.Type = types.MakeStructType(synthName, fields)
		var ms ModuleStruct
		ms.Name = synthName
		ms.Typ = anonTyp
		ms.Fields = fields
		gc.Mod.Structs = slices.Append[ModuleStruct](gc.Mod.Structs, ms)
		return anonTyp
	}
	return types.TypVoid()
}

// findAnonStruct looks for an existing anonymous struct in gc.Mod.Structs
// with identical field names and types.
func findAnonStruct(gc @GenCtx, fields @[]@types.Field) @types.Type {
	for i := 0; i < len(gc.Mod.Structs); i++ {
		var ms ModuleStruct = gc.Mod.Structs[i]
		if ms.Typ == nil { continue }
		if ms.Typ.Kind != types.TYP_STRUCT { continue }
		// Only match synthetic anonymous names
		if len(ms.Name) < 7 { continue }
		if ms.Name[0] != '_' || ms.Name[1] != '_' { continue }
		if len(ms.Typ.Fields) != len(fields) { continue }
		var match bool = true
		for j := 0; j < len(fields); j++ {
			if !streq(ms.Typ.Fields[j].Name, fields[j].Name) {
				match = false
			}
			if !ms.Typ.Fields[j].Type.Identical(fields[j].Type) {
				match = false
			}
		}
		if match { return ms.Typ }
	}
	return nil
}
