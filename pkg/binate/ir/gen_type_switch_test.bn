package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Type-switch IR lowering (gen_type_switch.bn / Slice 6).  Reuses assertGenModule
// (gen_assert_test.bn): an interface I { foo() }, a concrete `type T struct { x
// int }`, and `impl *T : I`.

// A concrete case does a nominal `*TypeInfo` identity compare, so its comma-ok
// assert materializes `&__typeinfo.<T>` (OP_DATA_SYM_ADDR) — the same machinery a
// `v, ok := x.(*T)` uses, reached through genTypeSwitch's first-match chain.
func TestGenTypeSwitchConcreteCompare() testing.TestResult {
	var m @Module = assertGenModule(
			"func f(rv *I) int { switch rv.(type) { case *T: return 1; default: return 0 } }\n")
	var fn @Func = assertNamedFunc(m, "test.f")
	if fn == nil { return fail("f not found") }
	if countOp(fn, iropcode.OP_DATA_SYM_ADDR) != 1 {
		return fail("a concrete type-switch case should materialize one &__typeinfo.<T>")
	}
	return ""
}

// genTypeSwitch reclaims the vm.SP growth of each case's assert (and roots its
// scrutinee) — it emits OP_SP_RESTORE on the case-body and miss paths.
func TestGenTypeSwitchEmitsSPRestore() testing.TestResult {
	var m @Module = assertGenModule(
			"func f(rv *I) int { switch rv.(type) { case *T: return 1; default: return 0 } }\n")
	var fn @Func = assertNamedFunc(m, "test.f")
	if fn == nil { return fail("f not found") }
	if countOp(fn, iropcode.OP_SP_RESTORE) < 1 {
		return fail("a type switch should emit OP_SP_RESTORE to reclaim its assert growth")
	}
	return ""
}

// A managed `@T` binder acquires (RefInc) the recovered value into its case-scope
// slot and releases it (RefDec) at the case's exit — the leak-safe binder.  A
// concrete-only switch over a raw `*I` (below) has neither, so the churn here is
// attributable to the `@`-binder + managed scrutinee.
func TestGenTypeSwitchManagedBinderRefcount() testing.TestResult {
	var m @Module = assertGenModule(
			"func f(mv @I) { switch v := mv.(type) { case @T: _ = v; default: } }\n")
	var fn @Func = assertNamedFunc(m, "test.f")
	if fn == nil { return fail("f not found") }
	if countOp(fn, iropcode.OP_REFINC) < 1 {
		return fail("an @T binder should RefInc the recovered value into its slot")
	}
	if countOp(fn, iropcode.OP_REFDEC) < 1 {
		return fail("an @T binder should RefDec at the case scope exit")
	}
	return ""
}

// A concrete `*T` binder is a borrow: no refcount churn from the binder (a raw
// `*I` scrutinee is also unmanaged, so the whole switch is RefInc/RefDec-free).
func TestGenTypeSwitchRawBinderNoChurn() testing.TestResult {
	var m @Module = assertGenModule(
			"func f(rv *I) { switch v := rv.(type) { case *T: _ = v; default: } }\n")
	var fn @Func = assertNamedFunc(m, "test.f")
	if fn == nil { return fail("f not found") }
	if countOp(fn, iropcode.OP_REFINC) != 0 {
		return fail("a raw *T binder over a raw *I scrutinee should not RefInc")
	}
	if countOp(fn, iropcode.OP_REFDEC) != 0 {
		return fail("a raw *T binder over a raw *I scrutinee should not RefDec")
	}
	return ""
}
