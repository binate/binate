package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// Type-declaration resolution for IR-gen: the Module.TypeAliases entry
// type for a non-struct `DECL_TYPE`, plus the TYP_NAMED peelers IR-gen's
// ad-hoc Kind / width / signedness decisions go through.

// lookupTypeAlias returns the registered gc.Mod.TypeAliases `.Typ` for a
// non-struct type-decl `name`, or nil if not registered.
func lookupTypeAlias(gc @GenCtx, name *[]readonly char) @types.Type {
	for i := 0; i < len(gc.Mod.TypeAliases); i++ {
		if streq(gc.Mod.TypeAliases[i].Name, name) {
			return gc.Mod.TypeAliases[i].Typ
		}
	}
	return nil
}

// typeDeclEntryType resolves the Module.TypeAliases `.Typ` for a
// non-struct `DECL_TYPE` named `name`.  An alias (`type X = U`)
// collapses to its underlying type `U` — it has no distinct identity.
// A distinct type (`type X U`) becomes a `TYP_NAMED` carrying `name`
// with `.Underlying = U`, mirroring the checker (check_decl.bn), so the
// named identity survives into IR-gen (method dispatch keys off the
// name via baseNamedTypeName) and the correct scalar layout survives
// into lowering (llvmType / typeBits / the VM and native backends peel
// `.Underlying`).  `name` must be the same string used as the lookup
// key — bare for the current package / REPL / self-types, qualified for
// imported and transitive packages — so def-side and call-side method
// keys agree (exactly as named structs are keyed).  The one exception
// is a distinct func-value type (see the inline comment): it strips to
// its underlying because func values carry no IR-level nominal identity.
func typeDeclEntryType(gc @GenCtx, name @[]char, d @ast.Decl) @types.Type {
	if d.IsAlias {
		return resolveTypeExpr(gc, d.TypeRef)
	}
	var under @types.Type = resolveTypeExpr(gc, d.TypeRef)
	// A named-distinct func-value type (`type Fn @func(...)`) is represented
	// transparently in IR-gen as its underlying func value.  Func values have
	// no nominal identity at the IR level (no per-name mangling), and every
	// func-value consumer — construction, call dispatch, copy, dtor, refcount —
	// keys off the func-value kind; a TYP_NAMED wrapper would make each of them
	// mis-handle it (treat the call as a direct global, skip the dtor, etc.).
	// The checker keeps the nominal TYP_NAMED for assignability; IR-gen needs
	// only the layout/kind, which the underlying carries.
	if under != nil && (under.Kind == types.TYP_FUNC_VALUE ||
			under.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		return under
	}
	var named @types.Type = types.MakeNamedType(name)
	named.Underlying = under
	return named
}

// peelNamed strips TYP_NAMED wrappers down to the underlying concrete
// type so IR-gen's ad-hoc Kind / width / signedness decisions see the
// real scalar.  (The types-level IsFloat / IsInteger / IsBool / SizeOf
// already peel; codegen has its own unwrapNamed.  This is for the
// remaining `Kind ==` / `.Signed` checks in IR-gen.)  Loops to handle
// named-over-named.
func peelNamed(t @types.Type) @types.Type {
	for t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	return t
}

// typeIsSigned reports whether t — peeling any TYP_NAMED wrapper — is a
// signed integer.  MakeNamedType leaves `.Signed` false, so reading
// `.Signed` off a bare TYP_NAMED would mis-classify a named *signed*
// type (`type S int8`) as unsigned.
func typeIsSigned(t @types.Type) bool {
	t = peelNamed(t)
	return t != nil && t.Signed
}

// isNonStructTypeDecl reports whether `d` is a non-generic `DECL_TYPE`
// whose body is NOT a struct literal — i.e. an alias or a distinct
// scalar/composite-reference type that belongs in Module.TypeAliases.
// (Struct type decls are registered separately as Module.Structs; a
// `type X = SomeStruct` alias still lands here because IsAlias decls
// always collapse to their target regardless of its kind.)
func isNonStructTypeDecl(d @ast.Decl) bool {
	if d.Kind != ast.DECL_TYPE || d.TypeRef == nil {
		return false
	}
	if len(d.TypeParams) != 0 {
		return false
	}
	if d.IsAlias {
		return true
	}
	return d.TypeRef.Kind != ast.TEXPR_STRUCT
}
