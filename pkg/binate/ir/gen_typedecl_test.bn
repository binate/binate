package "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_typedecl.bn: the TYP_NAMED peelers and the non-struct
// type-decl predicate.

// peelNamed strips a single and a nested TYP_NAMED wrapper down to the
// underlying concrete type.
func TestPeelNamedStripsToUnderlying() testing.TestResult {
	var named @types.Type = types.MakeNamedType("Celsius")
	named.Underlying = types.TypInt8()
	var base @types.Type = peelNamed(named)
	if base == nil || base.Kind != types.TYP_INT {
		return fail("named int8 must peel to the int kind")
	}
	// Named-over-named peels all the way.
	var outer @types.Type = types.MakeNamedType("Outer")
	outer.Underlying = named
	if peelNamed(outer).Kind != types.TYP_INT {
		return fail("named-over-named must peel to the base")
	}
	// A bare (non-named) type peels to itself.
	if peelNamed(types.TypBool()).Kind != types.TYP_BOOL {
		return fail("a non-named type must peel to itself")
	}
	return ""
}

// A named func-value type (`type Fn @func(...)`) peels to its underlying
// func value — the property the B2 named-func-value handling relies on so
// every func-value consumer sees the func-value kind, not a TYP_NAMED.
func TestPeelNamedFuncValue() testing.TestResult {
	var emptyParams @[]@types.Param = make_slice(@types.Param, 0)
	var emptyResults @[]@types.Type = make_slice(@types.Type, 0)
	var fv @types.Type = types.MakeManagedFuncValueType(emptyParams, emptyResults)
	var named @types.Type = types.MakeNamedType("Fn")
	named.Underlying = fv
	if peelNamed(named).Kind != types.TYP_MANAGED_FUNC_VALUE {
		return fail("named @func must peel to TYP_MANAGED_FUNC_VALUE")
	}
	return ""
}

// typeIsSigned reads signedness through the TYP_NAMED wrapper, since
// MakeNamedType leaves `.Signed` false on the wrapper itself.
func TestTypeIsSignedPeelsNamed() testing.TestResult {
	var s @types.Type = types.MakeNamedType("S")
	s.Underlying = types.TypInt8()
	if !typeIsSigned(s) {
		return fail("named int8 must read as signed")
	}
	var u @types.Type = types.MakeNamedType("B")
	u.Underlying = types.TypUint8()
	if typeIsSigned(u) {
		return fail("named uint8 must NOT read as signed")
	}
	return ""
}

// isNonStructTypeDecl accepts aliases and distinct non-struct type decls,
// rejecting struct decls (registered separately) and generic decls.
func TestIsNonStructTypeDecl() testing.TestResult {
	// Distinct non-struct (`type Fn @func(...)`) → true.
	var dDistinct @ast.Decl = make(ast.Decl)
	dDistinct.Kind = ast.DECL_TYPE
	var teFunc @ast.TypeExpr = make(ast.TypeExpr)
	teFunc.Kind = ast.TEXPR_MANAGED_FUNC_VALUE
	dDistinct.TypeRef = teFunc
	if !isNonStructTypeDecl(dDistinct) {
		return fail("distinct non-struct type decl must be accepted")
	}
	// Struct decl → false (registered as a moduleStruct, not an alias).
	var dStruct @ast.Decl = make(ast.Decl)
	dStruct.Kind = ast.DECL_TYPE
	var teStruct @ast.TypeExpr = make(ast.TypeExpr)
	teStruct.Kind = ast.TEXPR_STRUCT
	dStruct.TypeRef = teStruct
	if isNonStructTypeDecl(dStruct) {
		return fail("a distinct struct type decl must NOT be a non-struct alias")
	}
	// An alias to a struct still lands here (IsAlias collapses to target).
	dStruct.IsAlias = true
	if !isNonStructTypeDecl(dStruct) {
		return fail("an alias decl must be accepted regardless of target kind")
	}
	return ""
}
