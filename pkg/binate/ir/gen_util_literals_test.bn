package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// unescapeStr tests
// ============================================================

func TestUnescapeStrSimple() testing.TestResult {
	var s @[]char = unescapeStr("\"hello\"")
	if len(s) != 5 { return fail("expected len 5") }
	if s[0] != 'h' { return fail("expected h") }
	return ""
}

func TestUnescapeStrNewline() testing.TestResult {
	var s @[]char = unescapeStr("\"a\\nb\"")
	if len(s) != 3 { return fail("expected len 3") }
	if s[1] != '\n' { return fail("expected newline") }
	return ""
}

func TestUnescapeStrHex() testing.TestResult {
	var s @[]char = unescapeStr("\"\\x41\"")
	if len(s) != 1 { return fail("expected len 1") }
	if s[0] != 'A' { return fail("expected A") }
	return ""
}

func TestUnescapeStrEscapedQuote() testing.TestResult {
	var s @[]char = unescapeStr("\"a\\\"b\"")
	if len(s) != 3 { return fail("expected len 3") }
	if s[1] != '"' { return fail("expected quote") }
	return ""
}

// `\'` is a valid escape in a string literal too (shared escape set).
func TestUnescapeStrEscapedSingleQuote() testing.TestResult {
	var s @[]char = unescapeStr("\"a\\'b\"")
	if len(s) != 3 { return fail("expected len 3") }
	if s[1] != '\'' { return fail("expected single quote") }
	return ""
}

// `\u` <= U+007F encodes to one ASCII byte.
func TestUnescapeStrUnicodeAscii() testing.TestResult {
	var s @[]char = unescapeStr("\"\\u0041\"")
	if len(s) != 1 { return fail("expected len 1") }
	if cast(int, s[0]) != 0x41 { return fail("expected 0x41") }
	return ""
}

// U+00E9 (é) is a two-byte UTF-8 sequence C3 A9.
func TestUnescapeStrUnicodeTwoByte() testing.TestResult {
	var s @[]char = unescapeStr("\"\\u00e9\"")
	if len(s) != 2 { return fail("expected len 2") }
	if cast(int, s[0]) != 0xC3 { return fail("expected 0xC3") }
	if cast(int, s[1]) != 0xA9 { return fail("expected 0xA9") }
	return ""
}

// U+20AC (€) is a three-byte UTF-8 sequence E2 82 AC.
func TestUnescapeStrUnicodeThreeByte() testing.TestResult {
	var s @[]char = unescapeStr("\"\\u20ac\"")
	if len(s) != 3 { return fail("expected len 3") }
	if cast(int, s[0]) != 0xE2 { return fail("expected 0xE2") }
	if cast(int, s[1]) != 0x82 { return fail("expected 0x82") }
	if cast(int, s[2]) != 0xAC { return fail("expected 0xAC") }
	return ""
}

// `\u` adjacent to ordinary text keeps the surrounding bytes intact.
func TestUnescapeStrUnicodeEmbedded() testing.TestResult {
	var s @[]char = unescapeStr("\"a\\u00e9b\"")
	if len(s) != 4 { return fail("expected len 4 (a + 2 bytes + b)") }
	if s[0] != 'a' { return fail("expected a") }
	if cast(int, s[1]) != 0xC3 { return fail("expected 0xC3") }
	if cast(int, s[2]) != 0xA9 { return fail("expected 0xA9") }
	if s[3] != 'b' { return fail("expected b") }
	return ""
}

// ============================================================
// streq / charEq tests
// ============================================================

func TestStreqSame() testing.TestResult {
	if !streq("hello", "hello") {
		return fail("same strings should be equal")
	}
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") {
		return fail("different strings should not be equal")
	}
	return ""
}

func TestStreqDifferentLen() testing.TestResult {
	if streq("hi", "hello") {
		return fail("different lengths should not be equal")
	}
	return ""
}

// ============================================================
// buildQualName tests
// ============================================================

func TestBuildQualName() testing.TestResult {
	var m @Module = InitModule("test")
	var name @[]char = buildQualName(m, "pkg", "Func")
	if !charsEqual(name, "pkg.Func") {
		return fail("expected pkg.Func")
	}
	return ""
}

// TestBuildQualNameHomedByteIdentical: with no stamped resolved-home (here: no
// checker on the module), buildQualNameHomed is BYTE-IDENTICAL to buildQualName.
// This is the Phase-4 acceptance property — resolved-home mangling diverges only
// for an expose-injected member, so every existing (non-expose) reference mangles
// exactly as before.
func TestBuildQualNameHomedByteIdentical() testing.TestResult {
	var m @Module = InitModule("test") // m.Checker == nil -> home lookup skipped
	var plain @[]char = buildQualName(m, "pkg", "Func")
	var homed @[]char = buildQualNameHomed(m, "pkg", "Func")
	if !charsEqual(homed, plain) {
		return fail("buildQualNameHomed must equal buildQualName without a stamped home")
	}
	if !charsEqual(homed, "pkg.Func") {
		return fail("expected pkg.Func")
	}
	return ""
}

// ============================================================
// hexVal tests
// ============================================================

func TestHexValDigit() testing.TestResult {
	if hexVal('0') != 0 { return fail("0 should be 0") }
	if hexVal('9') != 9 { return fail("9 should be 9") }
	return ""
}

func TestHexValLower() testing.TestResult {
	if hexVal('a') != 10 { return fail("a should be 10") }
	if hexVal('f') != 15 { return fail("f should be 15") }
	return ""
}

func TestHexValUpper() testing.TestResult {
	if hexVal('A') != 10 { return fail("A should be 10") }
	if hexVal('F') != 15 { return fail("F should be 15") }
	return ""
}

// ============================================================
// parseIntLit negative
// ============================================================

func TestParseIntLitNegative() testing.TestResult {
	var v int = parseIntLit("-42")
	if v != -42 { return fail("expected -42") }
	return ""
}

func TestParseIntLitEmpty() testing.TestResult {
	var v int = parseIntLit("")
	if v != 0 { return fail("expected 0 for empty") }
	return ""
}

// ============================================================
// bignumToInt tests (Phase A3 of plan-ir-gen-typed-literals.md)
// ============================================================

func TestBignumToIntZero() testing.TestResult {
	if bignumToInt(cast(uint64, 0), false) != 0 {
		return fail("(0, false) should give 0")
	}
	if bignumToInt(cast(uint64, 0), true) != 0 {
		return fail("(0, true) should give 0 (no negative zero)")
	}
	return ""
}

func TestBignumToIntPositive() testing.TestResult {
	if bignumToInt(cast(uint64, 42), false) != 42 {
		return fail("(42, false) should give 42")
	}
	if bignumToInt(cast(uint64, 2147483648), false) != 2147483648 {
		return fail("(2^31, false) should give 2147483648")
	}
	return ""
}

func TestBignumToIntNegative() testing.TestResult {
	if bignumToInt(cast(uint64, 7), true) != -7 {
		return fail("(7, true) should give -7")
	}
	if bignumToInt(cast(uint64, 2147483648), true) != -2147483648 {
		return fail("(2^31, true) should give int32-min as int64")
	}
	return ""
}

// Int64-min is the boundary that parseIntLit handles via overflow
// wrap; bignumToInt handles it via cast-then-subtract.  Both
// should produce the same value.
func TestBignumToIntInt64Min() testing.TestResult {
	// Magnitude = 2^63 = 9223372036854775808, sign = true → int64-min.
	var mag uint64 = cast(uint64, 1) << cast(uint64, 63)
	var v int64 = bignumToInt(mag, true)
	// int64-min, built as int64 so the literal fits on a 32-bit host.
	var expected int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	if v != expected {
		return fail("(2^63, true) should give int64-min")
	}
	return ""
}

// ============================================================
// Phase B helpers
// ============================================================

func TestIsTypedIntAcceptsTypedInts() testing.TestResult {
	if !isTypedInt(types.TypInt()) {
		return fail("int should be a typed int")
	}
	if !isTypedInt(types.TypInt64()) {
		return fail("int64 should be a typed int")
	}
	if !isTypedInt(types.TypUint32()) {
		return fail("uint32 should be a typed int")
	}
	if !isTypedInt(types.TypUint8()) {
		return fail("uint8 should be a typed int")
	}
	return ""
}

func TestIsTypedIntRejectsUntypedAndOther() testing.TestResult {
	if isTypedInt(types.TypUntypedInt()) {
		return fail("untyped int should not be a typed int")
	}
	if isTypedInt(nil) {
		return fail("nil should not be a typed int")
	}
	if isTypedInt(types.TypBool()) {
		return fail("bool should not be a typed int")
	}
	return ""
}

// needsHintNarrowing fires for any typed integer whose shape
// (width OR signedness) differs from the untyped-int default
// (host's `int` — signed, host-int-width).  On a 64-bit host,
// `int` is the only typed-int that DOESN'T need narrowing.
// `int64` on a 64-bit host also matches (same width + signed),
// so it skips narrowing too.  uint{8,16,32,64} all differ
// (unsigned), as do int{8,16,32}.
func TestNeedsHintNarrowing() testing.TestResult {
	if needsHintNarrowing(types.TypInt()) {
		return fail("target=int should NOT need narrowing")
	}
	// int64 matches the target int's width+signedness only on a 64-bit
	// target; on a 32-bit target int64 IS narrower-incompatible with the
	// target-int default, so it DOES need narrowing.  Read the width from
	// the SAME source needsHintNarrowing uses (GetTarget().IntSize*8) — NOT
	// the compile-time `sizeof(int)`, which folds to the test binary's own
	// width and diverges from the ambient layout target on the arm32_linux lane.
	var targetIntBits int = 8 * types.GetTarget().IntSize
	if targetIntBits == 64 {
		if needsHintNarrowing(types.TypInt64()) {
			return fail("int64 must NOT need narrowing on a 64-bit target")
		}
	} else {
		if !needsHintNarrowing(types.TypInt64()) {
			return fail("int64 SHOULD need narrowing on a 32-bit target")
		}
	}
	if !needsHintNarrowing(types.TypUint64()) {
		return fail("target=uint64 SHOULD need narrowing (signedness differs)")
	}
	if !needsHintNarrowing(types.TypUint32()) {
		return fail("target=uint32 SHOULD need narrowing")
	}
	if !needsHintNarrowing(types.TypInt8()) {
		return fail("target=int8 SHOULD need narrowing")
	}
	return ""
}

func TestIntFitsInTypeUint32() testing.TestResult {
	var u32 @types.Type = types.TypUint32()
	if !intFitsInType(0, u32) { return fail("0 fits uint32") }
	if !intFitsInType(4294967295, u32) {
		return fail("UINT32_MAX fits uint32")
	}
	if intFitsInType(-1, u32) { return fail("-1 doesn't fit uint32") }
	if intFitsInType(4294967296, u32) {
		return fail("UINT32_MAX+1 doesn't fit uint32")
	}
	return ""
}

func TestIntFitsInTypeInt8() testing.TestResult {
	var i8 @types.Type = types.TypInt8()
	if !intFitsInType(0, i8) { return fail("0 fits int8") }
	if !intFitsInType(127, i8) { return fail("INT8_MAX fits int8") }
	if !intFitsInType(-128, i8) { return fail("INT8_MIN fits int8") }
	if intFitsInType(128, i8) {
		return fail("INT8_MAX+1 doesn't fit int8")
	}
	if intFitsInType(-129, i8) {
		return fail("INT8_MIN-1 doesn't fit int8")
	}
	return ""
}
