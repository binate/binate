package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/std/os"
import "pkg/stdx/slices"

// ============================================================
// Refcounting helpers
// ============================================================

// emitManagedValueCopyRefInc RefIncs a managed VALUE being copied into a
// destination — the multi-assign / Axiom-3 model, where the source is a
// borrow (e.g. a field extracted from an owned call-result temp whose dtor
// independently RefDec's it at end of statement).  Always the copy model
// (RefInc, never consumeTemp), since an extracted aggregate field can't be
// move-consumed.  No-op for non-managed-scalar types (struct/array
// aggregates are RefInc'd by emitStructCopy at the store).
func emitManagedValueCopyRefInc(f @Func, b @Block, val @Instr, t @types.Type) {
	if isManagedPtrType(t) {
		b.EmitRefInc(val)
	} else if isManagedSliceType(t) {
		emitManagedSliceRefInc(f, b, val)
	} else if isManagedFuncValueType(t) {
		emitManagedFuncValueRefInc(f, b, val)
	} else if isManagedIfaceValueType(t) {
		emitManagedIfaceValueRefInc(f, b, val)
	}
}

// emitManagedValueRefDec RefDec's a managed VALUE of type t — the old
// value overwritten at an assignment store site (Axiom 5: copy-then-
// destroy).  No-op for non-managed-scalar types.  Returns the possibly-
// updated block (the slice / func / iface RefDecs split the block for a
// null-guard).
func emitManagedValueRefDec(f @Func, b @Block, val @Instr, t @types.Type) @Block {
	if isManagedPtrType(t) {
		emitManagedPtrRefDec(f, b, val)
		return b
	} else if isManagedSliceType(t) {
		return emitManagedSliceRefDec(f, b, val)
	} else if isManagedFuncValueType(t) {
		return emitManagedFuncValueRefDec(f, b, val)
	} else if isManagedIfaceValueType(t) {
		return emitManagedIfaceValueRefDec(f, b, val)
	}
	return b
}

// needsStructCopy returns true if t is a struct or array type that needs a
// copy function call (i.e., has managed fields/elements that need RefInc on copy).
// Does NOT return true for @T or @[]T — those are handled inline.
func needsStructCopy(t @types.Type) bool {
	if t == nil { return false }
	// peelTransparent (readonly + named + alias), NOT ResolveAlias + one named
	// level: this predicate gates the copy-in (acquire) side, and the release
	// side (emitDecForScopeVars) peels via peelTransparent — they must agree, or
	// a by-value `readonly S` skips copy-in yet still runs its dtor → an
	// unbalanced RefDec → premature free / UAF.
	t = peelTransparent(t)
	if t.Kind == types.TYP_STRUCT { return t.NeedsDestruction() }
	if t.Kind == types.TYP_ARRAY { return t.NeedsDestruction() }
	return false
}

// emitStructCopy emits a copy function call on a struct/array at the given
// pointer. This RefInc's all managed fields in the copy.
func emitStructCopy(f @Func, b @Block, ptr @Instr, typ @types.Type) {
	// peelTransparent so a readonly/multi-level-named `typ` reaches the underlying
	// struct/array — keeping the registered body, the copy name, and needsStructCopy
	// (which now also peelTransparent's) in agreement.
	typ = peelTransparent(typ)
	registerPendingStructDtor(f, typ)
	var rawPtr @Instr = b.EmitBitCast(ptr, types.MakePointerType(types.TypUint8()))
	// elemCopyName, not qualifiedCopyNameForType: a top-level ARRAY copy uses
	// the LOCAL (weak_odr) name ensureArrayCopy emits — qualifiedCopyNameForType
	// would qualify a cross-package [N]@pkg.T to `pkg.__copy_arrN_...`, a symbol
	// no package defines (undefined-value compile error).  A struct stays
	// defining-package-qualified.
	var copyN @[]char = elemCopyName(typ)
	var copyArgs @[]@Instr = make_slice(@Instr, 1)
	copyArgs[0] = rawPtr
	b.EmitCall(copyN, copyArgs, types.TypVoid())
}

// emitStructDtor emits a destructor call on a struct/array at the given
// pointer. This RefDec's all managed fields.
func emitStructDtor(f @Func, b @Block, ptr @Instr, typ @types.Type) {
	// peelTransparent (see emitStructCopy) — keep the copy and dtor sides peeling
	// identically so their names / registered bodies agree.
	typ = peelTransparent(typ)
	registerPendingStructDtor(f, typ)
	var rawPtr @Instr = b.EmitBitCast(ptr, types.MakePointerType(types.TypUint8()))
	// elemDtorName for symmetry with emitStructCopy: a struct stays
	// defining-package-qualified, an array uses the local name.  Behavior-
	// preserving today (qualifiedDtorNameForType has no array-qualifying arm,
	// so a top-level array was already local), but it keeps the copy and dtor
	// name-selection identical and guards the dtor side from a future array arm.
	var dtorN @[]char = elemDtorName(typ)
	var dtorArgs @[]@Instr = make_slice(@Instr, 1)
	dtorArgs[0] = rawPtr
	b.EmitCall(dtorN, dtorArgs, types.TypVoid())
}

// registerPendingStructDtor records a struct/array type that needs dtor and
// copy functions generated. This handles types discovered during scope cleanup
// that aren't in Module.Structs (e.g., array types used as local variables).
// The work-list lives on the func's module (f.Mod), reached via the raw
// back-ref set at body-gen creation; f.Mod is non-nil for every func whose
// body runs scope cleanup, so a nil Mod is an IR-gen bug (a registering func
// created off the genFuncWithPrependedParams path) — abort rather than drop
// the registration silently, which would leak the type's dtor.
func registerPendingStructDtor(f @Func, typ @types.Type) {
	if f.Mod == nil {
		println("ir: registerPendingStructDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	var name @[]char = dtorNameForType(typ)
	if hasName(f.Mod.PendingStructDtorNames, name) { return }
	f.Mod.PendingStructDtors = slices.Append[@types.Type](f.Mod.PendingStructDtors, typ)
	f.Mod.PendingStructDtorNames = slices.Append[@[]char](f.Mod.PendingStructDtorNames, name)
}

// emitManagedPtrRefDec emits RefDec for a managed pointer value, passing the
// pointee's struct destructor if the pointee type needs destruction.
// Uses OP_FUNC_HANDLE (handle pointer end-to-end — the proper Phase 4
// shape from plan-uniform-native-fnptrs.md, replacing the
// transitional OP_FUNC_ADDR/idx-form stop-gap):
//
//   * Native: lowered to `&__handle.F` cast to i8*.  ZeroRefDestroy
//     calls _call_dtor(handle, ptr) → OP_CALL_HANDLE dispatches via
//     handle.vtable.call.
//   * Bytecode: BC_FUNC_HANDLE returns a *uint8 pointing at the
//     function's 16-byte {vtable, data} handle.
//     BC_REFDEC_INLINE_FAST's slow path inspects handle.data:
//     DATA_KIND_VM_CLOSURE_REC → recover FnIdx and do iterative push
//     (flat-stack, no host recursion); otherwise → cross-mode shim
//     call (bounded by the cross-mode chain, not the dtor field
//     graph).
//
// This makes dtor refs interop-correct: a managed value created in
// native that crosses into a bytecode VM (or vice-versa) can have
// its dtor resolved through the handle without depending on
// per-VM-instance function indices.
func emitManagedPtrRefDec(f @Func, b @Block, ptrVal @Instr) {
	var elemTyp @types.Type
	if ptrVal.Typ != nil {
		elemTyp = ptrVal.Typ.Elem
	}
	if elemTyp != nil {
		if elemTyp.Kind == types.TYP_STRUCT {
			if elemTyp.NeedsDestruction() {
				var dtor @Instr = b.EmitFuncHandle(qualifiedDtorName(elemTyp.Name))
				b.EmitRefDecDtor(ptrVal, dtor)
				return
			}
		} else if peelTransparent(elemTyp).Kind == types.TYP_MANAGED_SLICE {
			// A managed pointer to a managed SLICE (`@(@[]T)`, e.g. `box(s)` for
			// `s @[]char`; also a named-distinct `@(Buf)` for `type Buf @[]char`):
			// when the cell's refcount hits zero the pointee's backing must be
			// RefDec'd (and its managed elements cleaned) — the managed-slice dtor does
			// exactly that (it loads the 4-word header at the cell pointer and RefDec's
			// the backing).  Without this the cell frees but the backing leaks (box now
			// retains it — see the box arm in gen_builtin.bn).  Peel the pointee so a
			// named-distinct wrapper releases the SAME ms-dtor the box arm's RefInc
			// acquired (else acquire peels but release doesn't → a silent leak).
			var ms @types.Type = peelTransparent(elemTyp)
			// Register the ms-dtor so generateDtors emits it — but ONLY when a module
			// is present.  This runs both during user-function IR-gen (f.Mod set, e.g.
			// a box-result local's scope drop) AND while GENERATING a dtor body whose
			// `@(@[]T)` field / element it drops (f.Mod nil — a synthesized dtor func).
			// In the latter case the dtor-emission passes (generateNonStructDtors /
			// ensureMsDtor / ensureArrayDtor) already ensured the pointee ms-dtor, so
			// skip the module-less registration.
			if f.Mod != nil {
				registerPendingMsDtor(f, ms)
			}
			var dtor @Instr = b.EmitFuncHandle(dtorNameForType(ms))
			b.EmitRefDecDtor(ptrVal, dtor)
			return
		} else if peelTransparent(elemTyp).Kind == types.TYP_MANAGED_PTR {
			// A managed pointer to a managed POINTER (`@(@T)`, e.g. `box(mp)` for
			// `mp @Node`): when the cell's refcount hits zero the pointee `@T` must be
			// RefDec'd (running T's dtor) — the mp-dtor does exactly that (load the @T
			// at the cell, RefDec it).  Without this the cell frees but the pointee
			// leaks (box now retains it).  Peel so a named-distinct wrapper releases the
			// SAME mp-dtor the box arm's RefInc acquired.  Register only with a module
			// (synthesized dtor bodies have the pointee ensured by the emission passes).
			var mp @types.Type = peelTransparent(elemTyp)
			if f.Mod != nil {
				registerPendingMpDtor(f, mp)
			}
			var dtor @Instr = b.EmitFuncHandle(dtorNameForType(mp))
			b.EmitRefDecDtor(ptrVal, dtor)
			return
		} else if peelTransparent(elemTyp).Kind == types.TYP_ARRAY {
			// A managed pointer to an array-of-managed (`@([N]@Node)`, e.g. `box(arr)`
			// for an array with managed elements): when the cell's refcount hits zero
			// each managed element must be RefDec'd — the array dtor
			// (`__dtor_arr<N>_<elem>`, genArrayDtor) iterates and does exactly that.
			// Without this the cell frees but the elements leak (box already RefIncs
			// them via emitStructCopy).  Register via the struct-dtor work-list, whose
			// drain routes an array type through ensureArrayDtor; a synthesized
			// (module-less) dtor body has the array dtor ensured by the emission passes.
			// A plain array (no managed elements) falls through to a bare RefDec.
			var arr @types.Type = peelTransparent(elemTyp)
			if arr.Elem != nil && arr.Elem.NeedsDestruction() {
				if f.Mod != nil {
					registerPendingStructDtor(f, arr)
				}
				var dtor @Instr = b.EmitFuncHandle(dtorNameForType(arr))
				b.EmitRefDecDtor(ptrVal, dtor)
				return
			}
		}
	}
	b.EmitRefDec(ptrVal)
}

// registerPendingMsDtor records a managed-slice type that needs a dtor.  The
// work-list lives on the func's module (f.Mod) — see registerPendingStructDtor
// for the back-ref + nil-abort rationale.
func registerPendingMsDtor(f @Func, msTyp @types.Type) {
	if f.Mod == nil {
		println("ir: registerPendingMsDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	var name @[]char = dtorNameForType(msTyp)
	if hasName(f.Mod.PendingMsDtorNames, name) { return }
	f.Mod.PendingMsDtors = slices.Append[@types.Type](f.Mod.PendingMsDtors, msTyp)
	f.Mod.PendingMsDtorNames = slices.Append[@[]char](f.Mod.PendingMsDtorNames, name)
}

// registerPendingMpDtor records a managed-POINTER type `@T` that needs a
// `__dtor_mp_<T>` helper — mirrors registerPendingMsDtor.  Used when the drop of a
// `@(@T)` (a managed pointer to a managed value) references the pointee's mp-dtor.
func registerPendingMpDtor(f @Func, mpTyp @types.Type) {
	if f.Mod == nil {
		println("ir: registerPendingMpDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	var name @[]char = dtorNameForType(mpTyp)
	if hasName(f.Mod.PendingMpDtorNames, name) { return }
	f.Mod.PendingMpDtors = slices.Append[@types.Type](f.Mod.PendingMpDtors, mpTyp)
	f.Mod.PendingMpDtorNames = slices.Append[@[]char](f.Mod.PendingMpDtorNames, name)
}

// emitManagedSliceRefInc extracts the refptr (field 2) and increments it.
func emitManagedSliceRefInc(f @Func, b @Block, sliceVal @Instr) {
	var refptr @Instr = b.EmitExtract(sliceVal, 2, types.MakeManagedPtrType(nil))
	b.EmitRefInc(refptr)
}

// emitManagedIfaceValueRefInc RefInc's the data slot (field 0) of an
// @Iface value — the inverse of emitManagedIfaceValueRefDec.  Used when
// a managed interface value is returned (Axiom 3: retain it for the
// caller so the source local's scope-exit RefDec doesn't free it).
// EmitRefInc null-checks the data, so an empty or boxed-nil iface (null
// data) is a no-op.
func emitManagedIfaceValueRefInc(f @Func, b @Block, ivVal @Instr) {
	var dataPtr @Instr = b.EmitExtract(ivVal, 0, types.MakeManagedPtrType(nil))
	b.EmitRefInc(dataPtr)
}

// emitManagedIfaceValueRefDec cleans up the data slot (field 0) of
// an @Iface value — pairs with the OP_REFINC emitted at @Iface
// construction (Slice 2.3b). The dtor extracted from the vtable's
// slot 0 (Slice 2.5 reserved the slot; Slice 2.5b wires it up here)
// is passed through OP_REFDEC, so when the receiver's refcount hits
// zero the receiver type's struct destructor runs and any managed
// fields inside the receiver get cleaned up. If the receiver has
// no dtor, slot 0 is null / 0 and OP_REFDEC's slow path falls
// through to plain rt.Free.
func emitManagedIfaceValueRefDec(f @Func, b @Block, ivVal @Instr) @Block {
	var dataPtr @Instr = b.EmitExtract(ivVal, 0, types.MakeManagedPtrType(nil))
	// An empty interface value (no concrete impl — see `present`) has a
	// null data slot AND a null vtable.  Unlike slices / managed-ptrs,
	// whose dtor is statically known and whose OP_REFDEC already short-
	// circuits a null pointer, the iface dtor is fetched from the vtable
	// at runtime (EmitIfaceDtor derefs vtable[0]) — so it must not run
	// when empty, or it would load through a null vtable.  Guard the
	// whole cleanup on data being present; an empty iface is then a
	// no-op, matching how every other managed type cleans up.
	var nullp @Instr = b.EmitConstNil(types.MakeManagedPtrType(nil))
	var cond @Instr = b.EmitBinop(iropcode.OP_NE, dataPtr, nullp, types.TypBool())
	var thenBlk @Block = AddBlock(f, "ivrd.present")
	var mergeBlk @Block = AddBlock(f, "ivrd.merge")
	b.EmitBranch(cond, thenBlk, mergeBlk)
	var dtor @Instr = thenBlk.EmitIfaceDtor(ivVal)
	thenBlk.EmitRefDecDtor(dataPtr, dtor)
	thenBlk.EmitJump(mergeBlk)
	return mergeBlk
}

// emitManagedSliceRefDec cleans up a managed-slice value. If the element type
// needs destruction, stores the value to a temp alloca and calls the dtor.
// Otherwise just RefDec's the backing refptr.
func emitManagedSliceRefDec(f @Func, b @Block, sliceVal @Instr) @Block {
	var refptr @Instr = b.EmitExtract(sliceVal, 2, types.MakeManagedPtrType(nil))

	var elemTyp @types.Type
	if sliceVal.Typ != nil {
		elemTyp = sliceVal.Typ.Elem
	}
	if elemTyp == nil || !elemTyp.NeedsDestruction() {
		b.EmitRefDec(refptr)
		return b
	}

	registerPendingMsDtor(f, sliceVal.Typ)
	var msSlot @Instr = b.EmitAlloc(sliceVal.Typ)
	b.EmitStore(msSlot, sliceVal)
	var rawSlot @Instr = b.EmitBitCast(msSlot, types.MakePointerType(types.TypUint8()))
	var dtorN @[]char = dtorNameForType(sliceVal.Typ)
	var dtorArgs @[]@Instr = make_slice(@Instr, 1)
	dtorArgs[0] = rawSlot
	b.EmitCall(dtorN, dtorArgs, types.TypVoid())
	return b
}

// emitManagedFuncValueRefDec cleans up the data slot (slot 1) of an
// @func value — pairs with the EmitMake-then-OP_FUNC_VALUE shape
// genFuncLit emits for capturing @func literals (B.3b commit 2).
// The vtable's dtor slot (populated by emitFuncValueVtable for
// IsManagedFuncValue closures) is extracted and passed through
// OP_REFDEC_DTOR — when the data's refcount hits zero the closure-
// struct dtor runs, RefDec's each managed capture, and then
// rt.Free releases the closure struct itself.  If the closure
// struct has no managed fields the dtor slot is null and the
// runtime falls through to plain rt.Free.
//
// The dtor fetch + RefDec are guarded on data != null.  A zero-
// initialized @func value is {vtable=null, data=null} — e.g. a managed
// struct's @func field right after make() zeroes it, or the old value an
// @func field assignment dtor's before overwriting — and the unguarded
// OP_FUNC_VALUE_DTOR would load vtable[0] off the null vtable and fault.
// When data is null there is nothing to release anyway (a non-capturing
// literal also has data=null); when data is non-null the value is a live
// capturing closure whose vtable is valid, so the dtor load only ever
// runs on a good vtable.  Returns the continuation block (the guard
// splits the current block).
func emitManagedFuncValueRefDec(f @Func, b @Block, fvVal @Instr) @Block {
	var dataPtr @Instr = b.EmitExtract(fvVal, 1, types.MakeManagedPtrType(nil))
	var nilData @Instr = b.EmitConstNil(types.MakeManagedPtrType(nil))
	var dataIsNull @Instr = b.EmitBinop(iropcode.OP_EQ, dataPtr, nilData, types.TypBool())
	var decBlock @Block = AddBlock(f, "fv_refdec")
	var contBlock @Block = AddBlock(f, "fv_refdec_cont")
	b.EmitBranch(dataIsNull, contBlock, decBlock)
	var dtor @Instr = decBlock.EmitFuncValueDtor(fvVal)
	decBlock.EmitRefDecDtor(dataPtr, dtor)
	decBlock.EmitJump(contBlock)
	return contBlock
}

// emitManagedFuncValueRefInc RefInc's the data slot (slot 1) of an @func
// value — the ACQUIRE counterpart of emitManagedFuncValueRefDec.  Used
// at every copy site (var-init, assignment, param entry, return, struct/
// array/slice copy) so a stored/copied @func owns a ref to its capture
// record (or shared per-callee ClosureRec), balancing the scope-end /
// dtor RefDec.  Without this acquire, copying an @func into a field or
// returning it drops the only owning ref (use-after-free).
func emitManagedFuncValueRefInc(f @Func, b @Block, fvVal @Instr) {
	var dataPtr @Instr = b.EmitExtract(fvVal, 1, types.MakeManagedPtrType(nil))
	b.EmitRefInc(dataPtr)
}

// emitDecForScopeVars emits cleanup for managed vars declared since savedVarLen.
func emitDecForScopeVars(ctx @GenContext, b @Block, savedVarLen int) @Block {
	for i := savedVarLen; i < len(ctx.Vars); i++ {
		var slot VarSlot = ctx.Vars[i]
		// Peel IR-transparent wrappers (readonly / named-distinct / alias) so a
		// named-managed-slice / -iface / -ptr local (`type Buf @[]T; var b Buf`)
		// loads with the underlying type — its `.Elem` drives the element-dtor
		// decision in emitManagedSliceRefDec, and a bare TYP_NAMED carries no
		// `.Elem` (so element dtors would be skipped → leak).  The load type must
		// be the peeled type for the same reason: EmitLoad records it on the
		// value the RefDec helpers inspect.
		var st @types.Type = peelTransparent(slot.Typ)
		if isManagedPtrType(st) {
			var ptrVal @Instr = b.EmitLoad(slot.Ptr, st)
			emitManagedPtrRefDec(ctx.Func, b, ptrVal)
		}
		if isManagedSliceType(st) {
			var sliceVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedSliceRefDec(ctx.Func, b, sliceVal)
		}
		if isManagedIfaceValueType(st) {
			var ivVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedIfaceValueRefDec(ctx.Func, b, ivVal)
		}
		if isManagedFuncValueType(st) {
			var fvVal @Instr = b.EmitLoad(slot.Ptr, st)
			b = emitManagedFuncValueRefDec(ctx.Func, b, fvVal)
		}
		if needsStructCopy(st) {
			emitStructDtor(ctx.Func, b, slot.Ptr, st)
		}
	}
	return b
}
