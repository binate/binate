package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the refcount emit/temp/scope helpers in gen_util_refcount.bn.
// The pure type/instr predicates (and their tests) live in
// gen_refcount_pred{,_test}.bn; the emit helpers (struct copy/dtor, scope
// cleanup) are exercised end-to-end by the gen_copy / gen_dtor tests and
// conformance.  needsStructCopy — the gate that decides whether an
// aggregate gets a copy/dtor call (and the predicate the @func/@Iface
// NeedsDestruction work pivots on) — is pinned directly here.
// fail / noFields live in the package's other test files.

// needsStructCopy is false for nil, non-aggregate types, and the
// inline-handled managed kinds (@T / @[]T).
func TestNeedsStructCopyNonAggregate() testing.TestResult {
	if needsStructCopy(nil) {
		return fail("nil should not need a struct copy")
	}
	if needsStructCopy(types.TypInt()) {
		return fail("int should not need a struct copy")
	}
	if needsStructCopy(types.MakeManagedPtrType(types.TypInt())) {
		return fail("@T is handled inline, not via a struct copy")
	}
	return ""
}

// A struct with a destructible (managed) field needs a copy/dtor.
func TestNeedsStructCopyStructWithManagedField() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(
		types.MakeStructType("Inner", noFields))
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Outer", fields)
	if !needsStructCopy(st) {
		return fail("a struct with a managed field needs a struct copy")
	}
	return ""
}

// A struct whose fields are all plain (non-managed) needs no copy/dtor.
func TestNeedsStructCopyPlainStruct() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "X"
	f0.Type = types.TypInt()
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Plain", fields)
	if needsStructCopy(st) {
		return fail("a struct with only plain fields needs no struct copy")
	}
	return ""
}

// emitManagedFuncValueRefDec must guard the closure-dtor fetch + RefDec
// behind a data != null check: a zero-initialized @func value is
// {vtable=null, data=null}, and the unguarded vtable[0] load (via
// OP_FUNC_VALUE_DTOR) would fault on the null vtable.  Pins the guarded
// shape — an equality compare and a conditional branch, with the dtor
// fetch and RefDec reachable on the non-null path — and the block split
// (the helper returns a fresh continuation block, so the function gains
// extra blocks beyond the entry it was handed).
func TestEmitFuncValueRefDecGuardsNullData() testing.TestResult {
	var noTypeParams @[]@types.Param
	var noTypeResults @[]@types.Type
	var fnTyp @types.Type =
		types.MakeManagedFuncValueType(noTypeParams, noTypeResults)
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var slot @Instr = entry.EmitAlloc(fnTyp)
	var fvVal @Instr = entry.EmitLoad(slot, fnTyp)
	var cont @Block = emitManagedFuncValueRefDec(f, entry, fvVal)
	var noRet @[]@Instr
	cont.EmitReturn(noRet)
	if countOp(f, OP_EQ) < 1 {
		return fail("expected a data==null compare (OP_EQ) in the guard")
	}
	if countOp(f, OP_BRANCH) < 1 {
		return fail("expected a conditional branch guarding the dtor load")
	}
	if countOp(f, OP_FUNC_VALUE_DTOR) < 1 {
		return fail("expected OP_FUNC_VALUE_DTOR (closure-dtor fetch)")
	}
	if countOp(f, OP_REFDEC) < 1 {
		return fail("expected OP_REFDEC on the capture record")
	}
	if len(f.Blocks) < 2 {
		return fail("guard should split the block (extra blocks added)")
	}
	return ""
}
