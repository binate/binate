package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_variadic.bn: buildCallArgs + emitVariadicTail pack a variadic
// call's trailing INDIVIDUAL arguments into a single raw slice *[]T that views a
// caller-side stack backing array (func.variadic.pack).  The load-bearing
// observable: N individual trailing args become ONE slice argument at the call,
// materialized by an OP_ALLOC backing + per-element OP_STOREs.  End-to-end
// behavior is covered by conformance spec/10-functions/171.  Helpers
// `genFromSourcePkg` / `seq` / `fail` live in ir_test.bn.

// mainFuncOf returns the "test.main" function of a generated module, or nil.
func mainFuncOf(m @Module) @Func {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { return m.Funcs[i] }
	}
	return nil
}

// A variadic call `sum(1, 2, 3)` packs the three individual args into ONE *[]int
// slice argument, materialized by an OP_ALLOC stack backing plus a per-element
// store of each value.
func TestVariadicPackSingleSliceArg() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func sum(xs ...int) int { return len(xs) }\n")
	cb.Write("func main() {\n")
	cb.Write("  var r int = sum(1, 2, 3)\n")
	cb.Write("  _ = r\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = mainFuncOf(m)
	if mainFn == nil { return fail("test.main not found") }
	var callInstr @Instr = nil
	var sawAlloc bool = false
	var sawMakeSlice bool = false
	var saw1 bool = false
	var saw2 bool = false
	var saw3 bool = false
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, "test.sum") {
				callInstr = ins
			}
			if ins.Op == iropcode.OP_ALLOC { sawAlloc = true }
			if ins.Op == iropcode.OP_MAKE_SLICE { sawMakeSlice = true }
			if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 2 && ins.Args[1].Op == iropcode.OP_CONST_INT {
				if ins.Args[1].IntVal == 1 { saw1 = true }
				if ins.Args[1].IntVal == 2 { saw2 = true }
				if ins.Args[1].IntVal == 3 { saw3 = true }
			}
		}
	}
	if callInstr == nil { return fail("no OP_CALL to test.sum") }
	// THE key property: three individual args become ONE packed slice arg.
	if len(callInstr.Args) != 1 {
		return fail("variadic call must pass exactly one packed slice argument")
	}
	if !sawAlloc { return fail("pack must EmitAlloc a stack backing array") }
	// Zero-heap: the backing is a stack alloca, never a heap OP_MAKE_SLICE.
	if sawMakeSlice {
		return fail("pack must NOT emit OP_MAKE_SLICE (no heap allocation)")
	}
	if !saw1 || !saw2 || !saw3 {
		return fail("pack must store each element (1, 2, 3) into the backing")
	}
	return ""
}

// An empty variadic call `sum()` passes the empty slice {null, 0}
// (OP_CONST_NIL) as its single slice argument — no backing array.
func TestVariadicPackEmpty() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func sum(xs ...int) int { return len(xs) }\n")
	cb.Write("func main() {\n")
	cb.Write("  var r int = sum()\n")
	cb.Write("  _ = r\n")
	cb.Write("}\n")
	var m @Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFn @Func = mainFuncOf(m)
	if mainFn == nil { return fail("test.main not found") }
	var callInstr @Instr = nil
	var sawNil bool = false
	for bi := 0; bi < len(mainFn.Blocks); bi++ {
		var blk @Block = mainFn.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, "test.sum") {
				callInstr = ins
			}
			if ins.Op == iropcode.OP_CONST_NIL { sawNil = true }
		}
	}
	if callInstr == nil { return fail("no OP_CALL to test.sum") }
	if len(callInstr.Args) != 1 {
		return fail("empty variadic call must pass one {null,0} slice argument")
	}
	if !sawNil { return fail("empty pack must EmitConstNil for {null, 0}") }
	return ""
}
