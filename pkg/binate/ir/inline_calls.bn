package "pkg/binate/ir"

import "pkg/stdx/slices"

// ============================================================
// Within-package function inliner
// ============================================================
//
// An -O1+ IR pass (run FIRST in RunOptPasses, before mem2reg) that clones a
// small same-package callee's body into the caller at a direct OP_CALL site,
// deleting the call — the native<->clang codegen-gap closer (clang inlines
// small same-package callees within a TU; the native backend inlines nothing).
//
// Refcount correctness needs NO reconstruction: refcounts are explicit
// OP_REFINC/OP_REFDEC void instrs and self-balancing per side (callee entry-
// RefIncs a managed param and scope-exit-RefDecs it; Axiom-3 RefIncs each
// managed return value; the caller already has an end-of-statement OP_REFDEC of
// the call result).  A faithful clone-and-substitute — preserving the callee's
// RefInc/RefDec instrs verbatim and substituting the caller's arg for each param
// — composes with the caller's existing result-RefDec to stay refcount-exact.
// (Design + adversarial review: explorations/plan-within-package-inliner.md.)
//
// Because operands are OBJECT references (not integer IDs), cloning is an
// object->object remap + a per-clone ID renumber (value-producing clones get a
// fresh nextID(caller); void clones keep ID -1).  verify.bn does NOT check ID
// uniqueness or operand scope and is not run after opt, so a missed renumber
// miscompiles SILENTLY on the VM/native — the pass ships its own post-condition
// assertion (assertInlinedFuncWellFormed).
//
// Scope: a same-package callee returning a scalar, a by-value data aggregate
// (struct / slice / managed-slice / array riding sret/retbuf), OR
// multiple values (packed into a tuple at each return), whose body
// references only its params and its own in-callee values.  Single-block callees
// splice in place; multi-block callees split the caller block and clone
// the callee's CFG (inline_multiblock.bn), with MULTIPLE return sites
// merged through a return-value alloca slot.  Faulting ops are allowed
// with an EMPTY cleanup pad (the cloned fault op reuses the caller's
// call-site pad) or a single-block NON-empty pad (the pad is cloned and
// chained into the call-site pad by fixupInlinedPads).  NON-leaf callees are
// inlined too: a body's own DIRECT OP_CALLs are cloned along and exposed to
// a fixpoint re-scan for transitive inlining, guarded against call cycles
// (inline_recursion.bn) and code blow-up (the per-function growth budget).

// InlineSizeThreshold is the maximum instruction count (including the terminator)
// of a callee body for it to be inlined.  Conservative to start; tuneable — a
// bigger value inlines larger callees at the cost of code growth.
const InlineSizeThreshold int = 15

// InlineGrowthFactor / InlineGrowthFloor together bound per-function code growth
// from transitive inlining: a function is inlined into only until its
// instruction count reaches max(InlineGrowthFloor, origSize * InlineGrowthFactor);
// past that, remaining call sites are left as real calls.  Generous by design —
// a backstop against pathological DAG blow-up (diamond re-inlining), NOT a knob
// for the common case, which the per-callee InlineSizeThreshold and the
// recursion guard already bound.  A hit is not logged (the IR pass does no I/O —
// it is BUILDER-compiled); TestInlineGrowthBudget demonstrates the cap.
const (
	InlineGrowthFactor int = 4
	InlineGrowthFloor int = 256
)

// InlineRoundCap bounds the fixpoint re-scan as a defensive backstop
// against a logic error — normal termination is a round that inlines nothing.
const InlineRoundCap int = 100000

// inlineCalls inlines qualifying direct calls throughout the module.  The
// recursion analysis is computed once up front (a module-wide direct-call-cycle
// scan) and consulted for every candidate so a callee on a cycle is never
// inlined (otherwise the transitive re-scan would loop forever).
func inlineCalls(m @Module) {
	var ia @inlineAnalysis = computeRecursiveFuncs(m)
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @Func = m.Funcs[fi]
		if f.IsExtern {
			continue
		}
		inlineCallsInFunc(m, f, ia)
	}
}

// funcInstrCount returns f's total instruction count over its Blocks (fault pads
// excluded — the growth budget bounds emitted code, and a callee charges its
// block-instr count, matching inlinableCallee's `total`).
func funcInstrCount(f @Func) int {
	var total int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		total = total + len(f.Blocks[bi].Instrs)
	}
	return total
}

// inlineCallsInFunc inlines every qualifying OP_CALL in f.  A NON-leaf callee
// brings its own calls along when cloned, so the two phases run under a
// FIXPOINT loop: inlining a body exposes fresh call sites that the next round
// re-scans (transitive inlining).  Termination is guaranteed by the recursion
// guard (no callee on a direct-call cycle is ever inlined, so expansion follows
// the finite acyclic remainder) and bounded by the per-function growth budget;
// InlineRoundCap is a defensive backstop.  Every inlined call's result uses are
// retargeted to its cloned return value in ONE final whole-function sweep after
// all rounds (the caller's end-of-statement result-RefDec may sit in a later
// block, and a later round's clone can chain onto an earlier round's — chaseRepl
// resolves the chain).
func inlineCallsInFunc(m @Module, f @Func, ia @inlineAnalysis) {
	// Per-function code-growth budget: stop inlining into f once it
	// reaches this size, leaving any remaining sites as real calls.
	var origSize int = funcInstrCount(f)
	var budget int = origSize * InlineGrowthFactor
	if budget < InlineGrowthFloor {
		budget = InlineGrowthFloor
	}
	var curSize int = origSize
	var anyInlined bool = false
	// Parallel lists: an inlined call's result ID -> its cloned return value,
	// accumulated across ALL rounds and applied together in the final sweep.
	var callIDs @[]int
	var retVals @[]@Instr
	for round := 0; round < InlineRoundCap; round = round + 1 {
		var roundInlined bool = false
		// Phase 1: single-block callees — a per-block instruction splice, no CFG
		// change (the cloned body replaces the call in-place).
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @Block = f.Blocks[bi]
			var changed bool = false
			var kept @[]@Instr
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @Instr = blk.Instrs[ii]
				var callee @Func = inlinableCallee(m, f, ia, instr)
				if callee == nil || len(callee.Blocks) != 1 {
					kept = slices.Append[@Instr](kept, instr)
					continue
				}
				if curSize + funcInstrCount(callee) > budget {
					kept = slices.Append[@Instr](kept, instr)
					continue // growth budget hit — leave it a real call
				}
				// Splice the cloned body in place of the call (before it); drop the
				// call (its own fault pad is orphaned — never branched to, safe).
				var body @[]@Instr
				var retVal @Instr
				body, retVal = cloneInlinedBody(f, callee, instr)
				for bj := 0; bj < len(body); bj++ {
					kept = slices.Append[@Instr](kept, body[bj])
				}
				if instr.ID >= 0 {
					callIDs = slices.Append[int](callIDs, instr.ID)
					retVals = slices.Append[@Instr](retVals, retVal)
				}
				curSize = curSize + funcInstrCount(callee)
				changed = true
				roundInlined = true
				anyInlined = true
			}
			if changed {
				blk.Instrs = kept
			}
		}
		// Phase 2: multi-block callees — a CFG split, one at a time (f.Blocks
		// shifts as blocks are added, so re-scan for the next site each time).
		// Only sites that fit the remaining budget are returned.
		for {
			var sbi int
			var sii int
			var scallee @Func
			sbi, sii, scallee = findMultiBlockSite(m, f, ia, budget - curSize)
			if sbi < 0 {
				break
			}
			var call @Instr = f.Blocks[sbi].Instrs[sii]
			var retVal @Instr = inlineMultiBlockSite(f, sbi, sii, scallee, call)
			if call.ID >= 0 {
				callIDs = slices.Append[int](callIDs, call.ID)
				retVals = slices.Append[@Instr](retVals, retVal)
			}
			curSize = curSize + funcInstrCount(scallee)
			roundInlined = true
			anyInlined = true
		}
		if !roundInlined {
			break // a full round inlined nothing — fixpoint reached
		}
	}
	if !anyInlined {
		return
	}
	// Whole-function use-replacement: every use of an inlined call's result
	// becomes its cloned return value.  cap = the post-clone f.NextID.  A
	// returned value CAN itself be a replacement key — e.g. `a(b())` where `a`
	// returns its param, so a's retVal is b's (original) result — so the chain is
	// followed transitively by chaseRepl (acyclic: a retVal is either a fresh
	// clone, which is never a key, or an earlier call's result that resolves in
	// turn).
	var cap int = f.NextID
	var replByID @[]@Instr = make_slice(@Instr, cap)
	for k := 0; k < len(callIDs); k++ {
		if retVals[k] != nil {
			replByID[callIDs[k]] = retVals[k]
		}
	}
	rewriteUsesInBlocks(f.Blocks, replByID, cap)
	// FaultPads too: a MANAGED call result live at a fault (e.g. `mk().v + a[i]`
	// where mk()'s @T temp is live across the a[i] bounds check) is RefDec'd by
	// the fault pad, so the pad references the call-result instr — which the
	// splice deletes.  Without rewriting the pad, that reference dangles: a silent
	// RefDec of a stale value pre-assertion, a loud assertOperandsInScope panic
	// after.  The pads carry no inlined instrs of their own, only such references.
	rewriteUsesInBlocks(f.FaultPads, replByID, cap)
	assertInlinedFuncWellFormed(f)
}

// findMultiBlockSite returns the (block index, instr index, callee) of the first
// inlinable MULTI-block call in f whose body fits within `maxCharge` instrs (the
// remaining growth budget), or (-1, -1, nil).  Used by Phase 2's re-scanning
// loop (single-block callees are handled by Phase 1); the budget filter makes
// the loop terminate once the remaining budget can't fit any multi-block callee.
func findMultiBlockSite(m @Module, f @Func, ia @inlineAnalysis, maxCharge int) (int, int, @Func) {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var callee @Func = inlinableCallee(m, f, ia, blk.Instrs[ii])
			if callee != nil && len(callee.Blocks) > 1 && funcInstrCount(callee) <= maxCharge {
				return bi, ii, callee
			}
		}
	}
	return -1, -1, nil
}

// cloneInlinedBody clones callee's single block (minus the terminal OP_RETURN)
// into fresh instrs with the caller's args substituted for the callee's params,
// and returns (cloned body instrs in order, cloned return value or nil for a
// void return).  Value-producing clones get fresh caller IDs; void clones keep
// ID -1.  Operand remap and param substitution are keyed by the callee's dense
// ID space: index [0, len(Params)) is a param placeholder -> the caller's arg;
// index [len(Params), callee.NextID) is an in-block value -> its clone.
func cloneInlinedBody(f @Func, callee @Func, call @Instr) (@[]@Instr, @Instr) {
	var cblk @Block = callee.Blocks[0]
	var n int = len(cblk.Instrs)
	var cap int = callee.NextID
	var remap @[]@Instr = make_slice(@Instr, cap)
	// Pre-map each param placeholder ID -> the caller's argument object.
	for i := 0; i < len(callee.Params); i++ {
		remap[callee.Params[i].ID] = call.Args[i]
	}
	var body @[]@Instr
	var retVal @Instr = nil
	for ii := 0; ii < n; ii++ {
		var src @Instr = cblk.Instrs[ii]
		if ii == n - 1 {
			// Terminal OP_RETURN: not cloned; capture the (remapped) return value.
			// A MULTI-value return packs its N remapped values into a
			// tuple whose OP_EXTRACT'ing uses the sweep then reads.
			if len(src.Args) > 1 {
				var vals @[]@Instr = make_slice(@Instr, len(src.Args))
				for vi := 0; vi < len(src.Args); vi++ {
					vals[vi] = remapOperand(src.Args[vi], remap, cap)
				}
				var bi @[]@Instr
				bi, retVal = buildTupleInstrs(f, vals, callee.Results)
				for bj := 0; bj < len(bi); bj++ {
					body = slices.Append[@Instr](body, bi[bj])
				}
			} else if len(src.Args) == 1 {
				retVal = remapOperand(src.Args[0], remap, cap)
			}
			break
		}
		var c @Instr = cloneInstr(f, src, remap, cap, call.PadBlock)
		if src.ID >= 0 {
			remap[src.ID] = c
		}
		body = slices.Append[@Instr](body, c)
	}
	// Clone + chain any non-empty callee fault pads now that remap covers every
	// cloned callee value the pads' RefDecs reference; empty-pad fault
	// ops already reuse call.PadBlock and are left untouched.
	fixupInlinedPads(f, body, remap, cap, call.PadBlock)
	return body, retVal
}

// cloneInstr allocates a fresh instr copying src's scalar/type/payload fields,
// remapping its operands, and assigning a fresh caller ID (or -1 for a void
// instr).  Param-slot markers (ParamIndex / IsByvalParamRef) are deliberately
// NOT copied — the clone is an ordinary local, not the caller's "argument N"
// (they default to 0 / false on a fresh instr; keeping them would emit bogus
// `arg: N` DWARF at -O1 -g for a managed-param accessor).  Single-block leaf callees have no
// Block1/Block2/Phis/PadBlock (single block, leaf, no faults), so those
// reference fields are left nil.
func cloneInstr(f @Func, src @Instr, remap @[]@Instr, cap int, callSitePad *Block) @Instr {
	var c @Instr = cloneInstrFields(f, src, callSitePad)
	for k := 0; k < len(c.Args); k++ {
		c.Args[k] = remapOperand(c.Args[k], remap, cap)
	}
	return c
}

// cloneInstrFields copies src's scalar/type/payload fields into a fresh instr
// with a fresh caller ID (or -1 for a void instr), and a SHALLOW copy of its
// Args (same operand objects — the caller remaps them).  It does NOT copy
// Block1/Block2/Phis/PadBlock (the caller sets CFG edges; inlinable callees
// have no phis/pads) nor the param-slot markers ParamIndex/IsByvalParamRef
// (deliberately cleared so an inlined local isn't emitted as the caller's
// "argument N" in DWARF — they default to 0/false on a fresh instr).  Shared by
// the single-block splice (cloneInstr, one-pass remap) and the multi-block
// two-pass clone (inline_multiblock.bn, which remaps Args + CFG edges after all
// clones exist).
func cloneInstrFields(f @Func, src @Instr, callSitePad *Block) @Instr {
	var c @Instr = make(Instr)
	c.Op = src.Op
	c.Typ = src.Typ
	c.IntVal = src.IntVal
	c.StrVal = src.StrVal
	c.BoolVal = src.BoolVal
	c.Index = src.Index
	c.IfaceUpcastSlotOffset = src.IfaceUpcastSlotOffset
	c.TypeArg = src.TypeArg
	c.CFixedArgs = src.CFixedArgs
	c.RetbufSize = src.RetbufSize
	c.Line = src.Line
	c.IsGlobalRef = src.IsGlobalRef
	// A cloned faulting op (bounds/div/shift/nil check) needs its cleanup pad
	// wired for the merged frame.  EMPTY callee pad -> reuse the caller's
	// call-site pad directly (nothing callee-side to preserve).
	// NON-EMPTY pad -> leave PadBlock pointing at the CALLEE pad as a marker;
	// fixupInlinedPads (run after the body clone, when remap is complete) clones
	// it into the caller and chains it into callSitePad.  A non-faulting
	// op keeps PadBlock nil.
	if src.PadBlock != nil {
		if isEmptyPad(src.PadBlock) {
			c.PadBlock = callSitePad
		} else {
			c.PadBlock = src.PadBlock
		}
	}
	if src.ID >= 0 {
		c.ID = nextID(f)
	} else {
		c.ID = -1
	}
	if len(src.Args) > 0 {
		var na @[]@Instr = make_slice(@Instr, len(src.Args))
		for k := 0; k < len(src.Args); k++ {
			na[k] = src.Args[k]
		}
		c.Args = na
	}
	return c
}

// remapOperand maps a callee operand to its clone / substituted arg via the
// dense ID-keyed remap; returns the operand unchanged if not a remap key
// (defensive — inlinableCallee has already rejected non-remappable operands).
func remapOperand(a @Instr, remap @[]@Instr, cap int) @Instr {
	if a == nil {
		return nil
	}
	if a.ID >= 0 && a.ID < cap && remap[a.ID] != nil {
		return remap[a.ID]
	}
	return a
}

// assertInlinedFuncWellFormed fails loud if inlining left the func's SSA ID
// space malformed: every value-producing instr in f.Blocks must have a UNIQUE
// ID in [0, f.NextID).  This guards the highest-severity remap bug — a missed
// clone renumber, which collides two live values onto one frame/register slot
// and miscompiles SILENTLY on the VM/native (verify.bn checks neither ID
// uniqueness nor operand scope and is not run after opt).  It also checks operand
// SCOPE (every operand across f.Blocks/f.FaultPads is defined in f) — catching a
// dangling clone / merge-slot / pad operand — though not the stronger DOMINANCE
// property (every operand dominates its use).  Dominance is currently safe by
// construction: the multi-return merge slot lives in the pre-call region and its
// load in the continuation, all dominance-valid, and no cloned value crosses a
// merge without going through the slot.
func assertInlinedFuncWellFormed(f @Func) {
	var seen @[]bool = make_slice(bool, f.NextID)
	assertUniqueIDs(f, f.Blocks, seen)
	// Cloned fault pads live in FaultPads (not f.Blocks); their pad-internal
	// value clones must also carry unique dense IDs, or a VM register/frame slot
	// collision miscompiles SILENTLY (verify.bn scans neither FaultPads nor IDs).
	assertUniqueIDs(f, f.FaultPads, seen)
	assertPadRefsResolvable(f)
	assertOperandsInScope(f)
}
