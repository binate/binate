package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// intResults1 builds a one-result (int) result list for a test func.
func intResults1() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt()
	return r
}

// countOpInBlock counts instructions with opcode `op` in `blk`.
func countOpInBlock(blk @Block, op int) int {
	var n int = 0
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i].Op == op {
			n = n + 1
		}
	}
	return n
}

// TestInlineSimpleNoParamCall: `func k() int { return 42 }` called by
// `func caller() int { return k() }` — the call is spliced away, the const 42
// lands in the caller, and the return is retargeted to it.
func TestInlineSimpleNoParamCall() testing.TestResult {
	var noParams @[]@Param
	var callee @Func = NewFunc("", "k", noParams, intResults1())
	var cb @Block = AddBlock(callee, "entry")
	var c42 @Instr = cb.EmitConstInt(42, types.TypInt())
	cb.EmitReturn(oneRet(c42))

	var caller @Func = NewFunc("", "caller", noParams, intResults1())
	var eb @Block = AddBlock(caller, "entry")
	var noArgs @[]@Instr
	var callRes @Instr = eb.EmitCall("k", noArgs, types.TypInt())
	eb.EmitReturn(oneRet(callRes))

	var m @Module = NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_CALL) != 1 {
		return fail("setup: expected one call")
	}
	inlineCalls(m)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_CALL) != 0 {
		return fail("the call should be inlined away")
	}
	if countOpInBlock(caller.Blocks[0], iropcode.OP_CONST_INT) < 1 {
		return fail("the callee body (const 42) should be spliced into the caller")
	}
	// The return's value must be retargeted to the spliced const, not the
	// deleted call result.
	var last @Instr = caller.Blocks[0].Instrs[len(caller.Blocks[0].Instrs) - 1]
	if last.Op != iropcode.OP_RETURN || len(last.Args) < 1 {
		return fail("expected a return with a value")
	}
	if last.Args[0].Op != iropcode.OP_CONST_INT || last.Args[0].IntVal != cast(int64, 42) {
		return fail("return value should be retargeted to the spliced const 42")
	}
	return ""
}

// countCallsTo counts OP_CALLs in `blk` whose target name is `name`.
func countCallsTo(blk @Block, name *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i].Op == iropcode.OP_CALL && seq(blk.Instrs[i].StrVal, name) {
			n = n + 1
		}
	}
	return n
}

// TestInlineNonLeafCalleeInlined: a single-block callee `k3` that itself
// contains a direct call (to `someOther`, which is NOT a module func, so it stays
// a call) IS inlined — its body, including the cloned `someOther` call, is spliced
// into the caller.  After inlining, the caller has no `k3` call but does carry the
// cloned `someOther` call.  (`someOther` doesn't resolve, so it isn't further
// inlined; it exercises "a non-leaf body's own call is cloned verbatim".)
func TestInlineNonLeafCalleeInlined() testing.TestResult {
	var noParams @[]@Param
	var callee @Func = NewFunc("", "k3", noParams, intResults1())
	var cb @Block = AddBlock(callee, "entry")
	var noArgs @[]@Instr
	var inner @Instr = cb.EmitCall("someOther", noArgs, types.TypInt())
	cb.EmitReturn(oneRet(inner))

	var caller @Func = NewFunc("", "caller3", noParams, intResults1())
	var eb @Block = AddBlock(caller, "entry")
	var callRes @Instr = eb.EmitCall("k3", noArgs, types.TypInt())
	eb.EmitReturn(oneRet(callRes))

	var m @Module = NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	inlineCalls(m)
	if countCallsTo(caller.Blocks[0], "k3") != 0 {
		return fail("a non-leaf callee must be inlined (its k3 call should be gone)")
	}
	if countCallsTo(caller.Blocks[0], "someOther") != 1 {
		return fail("the non-leaf body's own call must be cloned into the caller")
	}
	return ""
}
