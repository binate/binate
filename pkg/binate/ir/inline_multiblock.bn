package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Within-package function inliner — Inc 2 (multi-block callees)
// ============================================================
//
// Inlining a multi-block callee needs CFG surgery the single-block splice
// (inline_calls.bn) avoids: split the caller block at the OP_CALL, clone the
// callee's whole block set into fresh caller blocks, jump the pre-call part to
// the cloned entry, and route the callee's return(s) to a continuation block
// holding the post-call instrs.  The pass runs BEFORE mem2reg, so no phis exist
// in either function — there is no phi-predecessor rewiring, which is what makes
// this tractable.  Scope: leaf, ≤1 scalar result.  MULTIPLE return sites (Inc 4)
// merge through a return-value alloca SLOT rather than a phi (keeping the
// pre-mem2reg alloca/store/load shape); fault pads are cloned + chained by
// fixupInlinedPads (Inc 3b).

// calleeBlockIndex returns the index of block b within callee.Blocks, or -1.
// Used to map a callee CFG edge (Block1/Block2) to its cloned block.
func calleeBlockIndex(callee @Func, b @Block) int {
	for i := 0; i < len(callee.Blocks); i++ {
		if callee.Blocks[i] == b {
			return i
		}
	}
	return -1
}

// inlineMultiBlockSite inlines the multi-block callee at f.Blocks[bi].Instrs[ii]
// (the OP_CALL `call`), returning the cloned return value (nil for a void
// return).  Preconditions (guaranteed by inlinableCallee): callee is leaf,
// no-fault, has exactly one OP_RETURN, every block ends in JUMP/BRANCH/RETURN,
// and every value operand is a param or an in-callee value.
func inlineMultiBlockSite(f @Func, bi int, ii int, callee @Func, call @Instr) @Instr {
	var callerBlk @Block = f.Blocks[bi]
	// Continuation block C: the caller instrs AFTER the call (including the
	// caller block's original terminator).  Built first so the cloned return
	// can jump to it.
	var cont @Block = AddBlock(f, "inlcont")
	var contInstrs @[]@Instr
	for j := ii + 1; j < len(callerBlk.Instrs); j++ {
		contInstrs = slices.Append[@Instr](contInstrs, callerBlk.Instrs[j])
	}
	cont.Instrs = contInstrs
	// One fresh cloned block per callee block (index-aligned with callee.Blocks),
	// so a CFG edge callee.Blocks[j] maps to clonedBlocks[j].
	var nb int = len(callee.Blocks)
	var clonedBlocks @[]@Block = make_slice(@Block, nb)
	for cbj := 0; cbj < nb; cbj++ {
		clonedBlocks[cbj] = AddBlock(f, "inl")
	}
	// Value/param remap, keyed by the callee's dense ID space: [0, nParams) =
	// param placeholder -> caller arg; [nParams, NextID) = in-callee value ->
	// its clone (filled in pass A).
	var cap int = callee.NextID
	var valRemap @[]@Instr = make_slice(@Instr, cap)
	for p := 0; p < len(callee.Params); p++ {
		valRemap[callee.Params[p].ID] = call.Args[p]
	}
	// Pass A: clone every callee instr (fields + fresh ID for values, -1 for
	// void); operands/CFG edges are remapped in pass B (cross-block references
	// need every clone to exist first).  A cloned OP_RETURN is created as-is here
	// and rewritten to an OP_JUMP in pass B.
	for cbj := 0; cbj < nb; cbj++ {
		var cblk @Block = callee.Blocks[cbj]
		var built @[]@Instr
		for k := 0; k < len(cblk.Instrs); k++ {
			var src @Instr = cblk.Instrs[k]
			var c @Instr = cloneInstrFields(f, src, call.PadBlock)
			if src.ID >= 0 {
				valRemap[src.ID] = c
			}
			built = slices.Append[@Instr](built, c)
		}
		clonedBlocks[cbj].Instrs = built
	}
	// Pass B: remap operands (Args) + CFG edges (Block1/Block2) on every clone,
	// and convert each cloned OP_RETURN into a jump to the continuation C.  With
	// EXACTLY ONE return site the (remapped) return value flows straight to the
	// call-result uses.  With MULTIPLE return sites (Inc 4) the values are merged
	// through a fresh return SLOT (alloca): each return stores its value then
	// jumps, and C loads the slot.  The slot keeps the pre-mem2reg alloca/store/
	// load shape (no phi introduced at inline time; mem2reg promotes it later) and
	// is dominance-safe — it lives in the caller's pre-call region, which
	// dominates every cloned block and C.
	var returnCount int = 0
	for cbj := 0; cbj < nb; cbj++ {
		var lb @Block = callee.Blocks[cbj]
		if lb.Instrs[len(lb.Instrs) - 1].Op == iropcode.OP_RETURN {
			returnCount = returnCount + 1
		}
	}
	var mergeSlot bool = returnCount > 1 && len(callee.Results) >= 1
	// The merged value's type: a single result directly, or (Inc 5b) the packed
	// multi-return tuple.
	var slotResultType @types.Type = nil
	if len(callee.Results) == 1 {
		slotResultType = callee.Results[0]
	} else if len(callee.Results) > 1 {
		slotResultType = makeMultiReturnStructType(callee.Results)
	}
	var slot @Instr = nil
	if mergeSlot {
		// A managed-typed slot is a raw scratch cell: OP_STORE/OP_LOAD are pure bit
		// copies (no implicit refcount), and the value's +1 flows store -> load ->
		// caller unchanged.  This relies on Binate's explicit-refcount model — a
		// backend must NOT implicitly RefDec a managed alloca slot at frame
		// teardown; if one ever did, this scratch slot would be double-freed.  For
		// a MULTI-value callee the slot holds the packed tuple (Inc 5b).
		slot = newInstr(f, iropcode.OP_ALLOC, types.MakePointerType(slotResultType))
		slot.TypeArg = slotResultType
	}
	var retVal @Instr = nil
	for cbj := 0; cbj < nb; cbj++ {
		var cblk @Block = callee.Blocks[cbj]
		var cloned @Block = clonedBlocks[cbj]
		for k := 0; k < len(cblk.Instrs); k++ {
			var src @Instr = cblk.Instrs[k]
			var c @Instr = cloned.Instrs[k]
			for a := 0; a < len(c.Args); a++ {
				c.Args[a] = remapOperand(c.Args[a], valRemap, cap)
			}
			if src.Op == iropcode.OP_RETURN {
				var rv @Instr = nil
				if len(src.Args) > 1 {
					// Multi-value (Inc 5b): pack the remapped return values (c.Args,
					// already remapped above) into a tuple, spliced in BEFORE the
					// soon-converted OP_RETURN (the block's last instr) so it
					// dominates.  rv is then the single tuple value.
					var bi @[]@Instr
					bi, rv = buildTupleInstrs(f, c.Args, callee.Results)
					var rebuilt @[]@Instr
					for j := 0; j < len(cloned.Instrs) - 1; j++ {
						rebuilt = slices.Append[@Instr](rebuilt, cloned.Instrs[j])
					}
					for j := 0; j < len(bi); j++ {
						rebuilt = slices.Append[@Instr](rebuilt, bi[j])
					}
					rebuilt = slices.Append[@Instr](rebuilt, c)
					cloned.Instrs = rebuilt
				} else if len(src.Args) == 1 {
					rv = remapOperand(src.Args[0], valRemap, cap)
				}
				if mergeSlot {
					// store rv -> slot, then jump to C.  OP_RETURN is the block's
					// last instr, so appending the jump makes it the terminator.
					c.Op = iropcode.OP_STORE
					c.Typ = nil
					c.ID = -1
					c.Args = makeArgs2(slot, rv)
					c.Block1 = nil
					var jmp @Instr = newVoidInstr(iropcode.OP_JUMP)
					jmp.Block1 = cont
					cloned.Instrs = slices.Append[@Instr](cloned.Instrs, jmp)
				} else {
					// Single return -> its value IS the call result directly;
					// multi-return void -> just jump (retVal stays nil).
					if rv != nil {
						retVal = rv
					}
					c.Op = iropcode.OP_JUMP
					var noArgs @[]@Instr
					c.Args = noArgs
					c.Block1 = cont
				}
			} else {
				c.Block1 = remapBlock(src.Block1, callee, clonedBlocks)
				c.Block2 = remapBlock(src.Block2, callee, clonedBlocks)
			}
		}
	}
	// For multiple return sites with a result, C loads the merged slot as the
	// call's value (rewritten into the post-call uses by the whole-function
	// sweep).  Prepend it so it dominates C's post-call instrs.
	if mergeSlot {
		var ld @Instr = newInstr(f, iropcode.OP_LOAD, slotResultType)
		ld.Args = makeArgs1(slot)
		var newCont @[]@Instr
		newCont = slices.Append[@Instr](newCont, ld)
		for j := 0; j < len(cont.Instrs); j++ {
			newCont = slices.Append[@Instr](newCont, cont.Instrs[j])
		}
		cont.Instrs = newCont
		retVal = ld
	}
	// Clone + chain any non-empty callee fault pads across all cloned blocks
	// (Inc 3b), now that valRemap covers every cloned callee value the pads'
	// RefDecs reference; empty-pad fault ops already reuse call.PadBlock.
	var allCloned @[]@Instr
	for cbj := 0; cbj < nb; cbj++ {
		var cb @Block = clonedBlocks[cbj]
		for k := 0; k < len(cb.Instrs); k++ {
			allCloned = slices.Append[@Instr](allCloned, cb.Instrs[k])
		}
	}
	fixupInlinedPads(f, allCloned, valRemap, cap, call.PadBlock)
	// Rewire the caller block: keep the pre-call instrs, add the return slot (for
	// a multi-return result), then jump to the cloned entry.  The call (at ii) and
	// the post-call instrs (now in C) are removed.
	var pre @[]@Instr
	for j := 0; j < ii; j++ {
		pre = slices.Append[@Instr](pre, callerBlk.Instrs[j])
	}
	if slot != nil {
		pre = slices.Append[@Instr](pre, slot)
	}
	var entryJump @Instr = newVoidInstr(iropcode.OP_JUMP)
	entryJump.Block1 = clonedBlocks[0]
	pre = slices.Append[@Instr](pre, entryJump)
	callerBlk.Instrs = pre
	return retVal
}

// remapBlock maps a callee CFG target to its cloned block; nil stays nil.
func remapBlock(b @Block, callee @Func, clonedBlocks @[]@Block) @Block {
	if b == nil {
		return nil
	}
	var idx int = calleeBlockIndex(callee, b)
	if idx < 0 {
		return b // defensive: not a callee block (shouldn't happen)
	}
	return clonedBlocks[idx]
}

// buildTupleInstrs emits the packing of `vals` (already remapped to caller-space
// values) into a fresh multi-return tuple-struct value (Inc 5b): an OP_ALLOC of
// the tuple type, an OP_GET_FIELD_PTR + OP_STORE per field, and a final OP_LOAD.
// Returns the instrs to splice in and the load (the tuple value).  A multi-value
// call result is only ever consumed by OP_EXTRACT(callresult, i) (no whole-tuple
// flow), so setting the call's retVal to this tuple lets the existing use-sweep
// (replByID[callID] = tuple) leave those extracts reading a valid tuple.  Store/
// load are bit copies (no implicit refcount), so each return value's +1 rides
// through exactly as the retbuf would — faithful to the un-inlined ABI.
func buildTupleInstrs(f @Func, vals @[]@Instr, fieldTypes @[]@types.Type) (@[]@Instr, @Instr) {
	var tupleType @types.Type = makeMultiReturnStructType(fieldTypes)
	var out @[]@Instr
	var slot @Instr = newInstr(f, iropcode.OP_ALLOC, types.MakePointerType(tupleType))
	slot.TypeArg = tupleType
	out = slices.Append[@Instr](out, slot)
	for i := 0; i < len(vals); i++ {
		var fp @Instr = newInstr(f, iropcode.OP_GET_FIELD_PTR, types.MakePointerType(fieldTypes[i]))
		fp.Args = makeArgs1(slot)
		fp.Index = i
		out = slices.Append[@Instr](out, fp)
		var st @Instr = newVoidInstr(iropcode.OP_STORE)
		st.Args = makeArgs2(fp, vals[i])
		out = slices.Append[@Instr](out, st)
	}
	var ld @Instr = newInstr(f, iropcode.OP_LOAD, tupleType)
	ld.Args = makeArgs1(slot)
	out = slices.Append[@Instr](out, ld)
	return out, ld
}
