package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the inliner's fault-pad helpers (inline_pads.bn).  The
// realistic clone-and-chain path is covered end-to-end by the VM leak tests
// (pkg/binate/vm vm_inline_leak_test.bn) and codegen (emit_inline_test.bn); these
// pin the structural predicates directly.  Shared helpers: NewFunc / AddFaultPad
// / intResults1 (inline_calls_test.bn + ir_phi_elim_test.bn), fail.

// TestIsEmptyPad: a pad that is exactly one OP_UNWIND_RETURN is empty; a pad with
// any preceding cleanup instr is not.
func TestIsEmptyPad() testing.TestResult {
	var noParams @[]@Param
	var f @Func = NewFunc("", "iep", noParams, intResults1())
	var empty @Block = AddFaultPad(f, "empty")
	empty.EmitUnwindReturn()
	if !isEmptyPad(empty) {
		return fail("a pad of just OP_UNWIND_RETURN must be empty")
	}
	var nonempty @Block = AddFaultPad(f, "ne")
	var c @Instr = nonempty.EmitConstInt(0, types.TypInt())
	_ = c
	nonempty.EmitUnwindReturn()
	if isEmptyPad(nonempty) {
		return fail("a pad with a preceding cleanup instr must not be empty")
	}
	return ""
}

// TestPadSingleBlockInlinable: a single straight-line block ending in
// OP_UNWIND_RETURN with remappable operands is inlinable; a pad ending
// in a branch (a multi-block cleanup) is rejected.
func TestPadSingleBlockInlinable() testing.TestResult {
	var noParams @[]@Param
	var f @Func = NewFunc("", "psb", noParams, intResults1())
	var sb @Block = AddFaultPad(f, "sb")
	var c @Instr = sb.EmitConstInt(0, types.TypInt())
	_ = c
	sb.EmitUnwindReturn()
	if !padSingleBlockInlinable(sb, f) {
		return fail("a single-block pad ending in OP_UNWIND_RETURN must be inlinable")
	}
	var mb @Block = AddFaultPad(f, "mb")
	var tgt @Block = AddFaultPad(f, "tgt")
	mb.EmitJump(tgt)
	if padSingleBlockInlinable(mb, f) {
		return fail("a pad ending in a branch (multi-block cleanup) must be rejected")
	}
	return ""
}

// TestFaultPadHandle: faultPadHandle recovers the managed @Block for a raw
// *Block back-ref by payload-address identity across f.FaultPads.
func TestFaultPadHandle() testing.TestResult {
	var noParams @[]@Param
	var f @Func = NewFunc("", "fph", noParams, intResults1())
	var p0 @Block = AddFaultPad(f, "p0")
	var p1 @Block = AddFaultPad(f, "p1")
	_ = p0
	var got @Block = faultPadHandle(f, p1)
	if bit_cast(int, got) != bit_cast(int, p1) {
		return fail("faultPadHandle must return the @Block matching the raw back-ref")
	}
	return ""
}
