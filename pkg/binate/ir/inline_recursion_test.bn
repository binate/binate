package "pkg/binate/ir"

import "pkg/builtins/testing"

// Unit coverage of the inliner's recursion guard (inline_recursion.bn).  These
// drive markCycleTargets directly with hand-built adjacency so the DFS
// back-edge-target marking — the property that breaks every call cycle for
// inlining — is checked in isolation, apart from the end-to-end termination test
// in the vm package.  The guarantee tested: every cycle has >=1 marked node, and
// no acyclic node is ever marked.

// e0 / e1 / e2 build a node's out-edge list (0, 1, or 2 direct-call targets).
func e0() @[]int {
	return make_slice(int, 0)
}

func e1(a int) @[]int {
	var e @[]int = make_slice(int, 1)
	e[0] = a
	return e
}

func e2(a int, b int) @[]int {
	var e @[]int = make_slice(int, 2)
	e[0] = a
	e[1] = b
	return e
}

// anyMarked reports whether any node in [lo, hi) is marked recursive.
func anyMarked(recur @[]bool, lo int, hi int) bool {
	for i := lo; i < hi; i++ {
		if recur[i] {
			return true
		}
	}
	return false
}

// TestMarkCycleTargetsDAG: a pure DAG (0->1->2 plus a diamond 0->{1,2}, {1,2}->3)
// has no cycle, so NOTHING is marked.
func TestMarkCycleTargetsDAG() testing.TestResult {
	var adj @[]@[]int = make_slice(@[]int, 4)
	adj[0] = e2(1, 2)
	adj[1] = e1(3)
	adj[2] = e1(3)
	adj[3] = e0()
	var recur @[]bool = markCycleTargets(adj, 4)
	if anyMarked(recur, 0, 4) {
		return fail("a DAG must have no cycle-marked nodes")
	}
	return ""
}

// TestMarkCycleTargetsSelfLoop: a direct self-edge 0->0 marks node 0.
func TestMarkCycleTargetsSelfLoop() testing.TestResult {
	var adj @[]@[]int = make_slice(@[]int, 1)
	adj[0] = e1(0)
	var recur @[]bool = markCycleTargets(adj, 1)
	if !recur[0] {
		return fail("a self-loop node must be marked recursive")
	}
	return ""
}

// TestMarkCycleTargetsTwoCycle: 0<->1.  At least one of the two is marked (the
// guarantee that breaks the cycle); both are genuine cycle members.
func TestMarkCycleTargetsTwoCycle() testing.TestResult {
	var adj @[]@[]int = make_slice(@[]int, 2)
	adj[0] = e1(1)
	adj[1] = e1(0)
	var recur @[]bool = markCycleTargets(adj, 2)
	if !anyMarked(recur, 0, 2) {
		return fail("a 2-cycle must mark at least one member")
	}
	return ""
}

// TestMarkCycleTargetsEntryPlusCycle: 0 -> 1 -> 2 -> 1 (a 1<->2 cycle entered
// from the acyclic node 0).  Node 0 is NOT on any cycle and must stay unmarked;
// at least one of {1,2} is marked.
func TestMarkCycleTargetsEntryPlusCycle() testing.TestResult {
	var adj @[]@[]int = make_slice(@[]int, 3)
	adj[0] = e1(1)
	adj[1] = e1(2)
	adj[2] = e1(1)
	var recur @[]bool = markCycleTargets(adj, 3)
	if recur[0] {
		return fail("the acyclic entry node 0 must not be marked")
	}
	if !anyMarked(recur, 1, 3) {
		return fail("the 1<->2 cycle must mark at least one member")
	}
	return ""
}
