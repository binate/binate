package "pkg/binate/ir"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/std/table"
import "pkg/std/vec"
import "pkg/stdx/slices"

// ============================================================
// Module
// ============================================================

// NewModule creates a new IR module with the given name.
func NewModule(name @[]char) @Module {
	var m @Module = make(Module)
	m.Name = name
	// Every Module flows through here (InitModule delegates to it), so this is
	// the one place FuncSigs' backing vector is created — a zero Module has a
	// nil FuncSigs that would fault on the first Push/Get.
	m.FuncSigs = vec.New[irdata.FuncSig]()
	// Likewise seed the Funcs builder here (the one Module-creation funnel) — a
	// zero Module has a nil FuncsVec that would fault on AddFunc's first Push.
	m.FuncsVec = vec.New[@Func]()
	// Seed the FuncSigs name→index table with the zero-size direct-dispatch policies
	// (FuncSigHasher/FuncSigEq), keyed by *[]readonly char borrows of each sig's Name.
	m.FuncSigIndex = table.NewTable[*[]readonly char, int, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	// Seed the per-module interface registry with universe `any` so every
	// module starts with it visible to isInterfaceTypeExpr / ifaceTypeForName /
	// lookupModuleInterface (Plan §6).  Was InitModule's registerUniverseAny
	// on the old moduleInterfaces package-global.
	registerUniverseAny(m)
	return m
}

// AddFunc appends a function to the module's function list.
func (m @Module) AddFunc(f @Func) {
	// Push onto the amortized-growth builder and refresh the consumer-facing view
	// (Items() is an O(1) sub-slice sharing the builder's backing), keeping
	// m.Funcs current after every append without the O(n)-per-append realloc a
	// grow-by-one slice append would cost.
	m.FuncsVec.Push(f)
	m.Funcs = m.FuncsVec.Items()
}

// AddGlobal appends a global variable to the module.
func (m @Module) AddGlobal(g @Global) {
	m.Globals = slices.Append[@Global](m.Globals, g)
}

// AddTypeDef appends a type definition to the module.
func (m @Module) AddTypeDef(td @irdata.TypeDef) {
	m.Types = slices.Append[@irdata.TypeDef](m.Types, td)
}

// ============================================================
// Function
// ============================================================

// NewFunc creates a new function with parameters and result types, assigning IDs to params.
// f.Name is the canonical fully-qualified name: `name` qualified with
// `pkgPath` (the defining module's package path) via mangle.QualifyName.
// An empty `pkgPath` (a name built outside any module-gen context) leaves
// `name` unchanged, and QualifyName is idempotent on an already-dotted
// `name` (cross-package refs, methods, qualified dtors), so those pass
// through too.  f.ModulePkgPath caches `pkgPath` so the @Block emit
// methods qualify bare call targets off the func (b.Func.ModulePkgPath).
func NewFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func {
	var f @Func = make(Func)
	if len(pkgPath) > 0 {
		f.Name = mangle.QualifyName(pkgPath, name)
	} else {
		f.Name = name
	}
	// Cache the module path so the emit methods qualify bare call targets
	// off the func (b.Func.ModulePkgPath) rather than the package-global.
	f.ModulePkgPath = pkgPath
	f.Params = params
	f.Results = results
	f.IsExtern = false
	f.NextID = 0
	for i := 0; i < len(params); i++ {
		params[i].ID = f.NextID
		f.NextID = f.NextID + 1
	}
	return f
}

// NewExternFunc creates an extern function declaration (no body, no param IDs).
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func {
	var f @Func = make(Func)
	if len(pkgPath) > 0 {
		f.Name = mangle.QualifyName(pkgPath, name)
	} else {
		f.Name = name
	}
	f.ModulePkgPath = pkgPath
	f.Params = params
	f.Results = results
	// A multi-return extern needs its result-tuple type, exactly as a local func
	// gets it (gen_func.bn) — codegen's sret decision (FuncReturnsBigMultiReturn)
	// reads f.MultiReturnType, so leaving it nil makes a cross-module call emit
	// the register-FCA convention while the defining module sret's the callee: an
	// ABI mismatch that corrupts a stack-spilled param on x64 (session.bn:193).
	if len(results) > 1 {
		f.MultiReturnType = irutil.MakeMultiReturnStructType(results)
	}
	f.IsExtern = true
	f.NextID = 0
	return f
}

// AddBlock creates a new basic block with a unique label and appends it to the
// function.  While f.PadEmitMode is set (during a fault landing pad's cleanup,
// which can branch), the block is routed to Func.FaultPads instead of Blocks so
// the compiled backends never see it — see AddFaultPad.
func AddBlock(f @Func, label *[]readonly char) @Block {
	if f.PadEmitMode {
		return AddFaultPad(f, label)
	}
	var b @Block = make(Block)
	b.InstrsVec = vec.New[@Instr]()
	// Make labels unique: "{label}.{blockIndex}"
	var qn @strings.Builder = strings.NewBuilder()
	qn.Write(label)
	qn.WriteByte('.')
	stringutils.WriteInt(qn, len(f.Blocks))
	b.Label = buf.CopyStr(qn.String())
	b.Func = f
	f.Blocks = slices.Append[@Block](f.Blocks, b)
	return b
}

// AddFaultPad appends a VM-only cleanup landing pad block to the function's
// FaultPads list — NOT Blocks — so the compiled backends (which iterate Blocks)
// never emit it; only the VM lowers pads and branches to them on a recoverable
// fault.
func AddFaultPad(f @Func, label *[]readonly char) @Block {
	var b @Block = make(Block)
	b.InstrsVec = vec.New[@Instr]()
	var qn @strings.Builder = strings.NewBuilder()
	qn.Write(label)
	qn.WriteByte('.')
	stringutils.WriteInt(qn, len(f.FaultPads))
	b.Label = buf.CopyStr(qn.String())
	b.Func = f
	f.FaultPads = slices.Append[@Block](f.FaultPads, b)
	return b
}

// ============================================================
// Param
// ============================================================

// NewParam creates a new function parameter and assigns it a unique ID.
func NewParam(f @Func, name @[]char, typ @types.Type) @Param {
	var p @Param = make(Param)
	p.Name = name
	p.Typ = typ
	p.ID = f.NextID
	f.NextID = f.NextID + 1
	return p
}

// NewParamRef builds the by-ID placeholder @Instr that stands for parameter `p`:
// an operand whose ID equals p's ID, which every backend resolves to the incoming
// argument (LLVM `%v<id>` / the VM+native param slot) straight from the function
// signature.  It is only ever an operand — never appended to a block as a def.
//
// Its opcode is OP_PARAM, NOT OP_CONST_INT.  A distinct opcode is load-bearing:
// the shared IR-level SSA passes read `.Op` (mem2reg / load-forwarding forward the
// placeholder as a param-slot load's reaching value; bceConstIndexFunc / bceLoopFunc
// inspect the resulting operand).  Spelled OP_CONST_INT — enum value 0, default
// IntVal 0 — those passes mistook a parameter for the integer constant 0 and
// dropped bounds checks (a silent -O1 out-of-bounds miscompile); OP_PARAM keeps a
// parameter from ever looking like a constant.
//
// IsByvalParamRef is set for a byval-aggregate param so that an OP_STORE of this
// ref into its slot lowers as a memcpy from the `ptr byval(<T>)` incoming pointer
// rather than a value store.  The flag is consumed ONLY by the store emitter, so
// it is inert on a ref that is instead loaded-through or forwarded (e.g. an
// interface-thunk's byval pass-through).
func NewParamRef(p @Param) @Instr {
	var ref @Instr = make(Instr)
	ref.ID = p.ID
	ref.Typ = p.Typ
	ref.Op = iropcode.OP_PARAM
	ref.IsByvalParamRef = p.Typ.IsByvalParam()
	return ref
}

// ============================================================
// Internal: allocate an instruction
// ============================================================

// AllocValueID allocates and returns the next unique instruction ID for the function.
func AllocValueID(f *Func) int {
	var id int = f.NextID
	f.NextID = f.NextID + 1
	return id
}

// StripConstForIR peels TYP_READONLY wrappers (through aliases) so that
// the IR / codegen never see const — const is a type-system-only
// concept that doesn't affect layout or instruction selection.
// Strips recursively through pointer, slice, and array element types
// so that the result has no const anywhere.
func StripConstForIR(t @types.Type) @types.Type {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS { t = t.Target }
		if t != nil && t.Kind == types.TYP_READONLY { t = t.Elem }
	}
	if t == nil { return t }
	if t.Kind == types.TYP_POINTER {
		return types.MakePointerType(StripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(StripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_SLICE {
		return types.MakeSliceType(StripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		return types.MakeManagedSliceType(StripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_ARRAY {
		return types.MakeArrayType(StripConstForIR(t.Elem), t.ArrayLen)
	}
	return t
}

// NewInstr allocates a typed instruction with a unique ID.
func NewInstr(f *Func, op int, typ @types.Type) @Instr {
	var instr @Instr = make(Instr)
	instr.ID = AllocValueID(f)
	instr.Op = op
	instr.Typ = StripConstForIR(typ)
	return instr
}

// NewVoidInstr allocates a void instruction (ID -1, no result value).
func NewVoidInstr(op int) @Instr {
	var instr @Instr = make(Instr)
	instr.ID = -1
	instr.Op = op
	return instr
}

// Internal: build fixed-size Args slices
func MakeArgs1(a @Instr) @[]@Instr {
	var s @[]@Instr = make_slice(@Instr, 1)
	s[0] = a
	return s
}

// MakeArgs2 builds a 2-element instruction argument slice.
func MakeArgs2(a @Instr, b @Instr) @[]@Instr {
	var s @[]@Instr = make_slice(@Instr, 2)
	s[0] = a
	s[1] = b
	return s
}
