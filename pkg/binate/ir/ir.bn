package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/std/table"
import "pkg/std/vec"
import "pkg/stdx/slices"

// ============================================================
// Module
// ============================================================

// NewModule creates a new IR module with the given name.
func NewModule(name @[]char) @Module {
	var m @Module = make(Module)
	m.Name = name
	// Every Module flows through here (InitModule delegates to it), so this is
	// the one place FuncSigs' backing vector is created — a zero Module has a
	// nil FuncSigs that would fault on the first Push/Get.
	m.FuncSigs = vec.New[FuncSig]()
	// Likewise seed the Funcs builder here (the one Module-creation funnel) — a
	// zero Module has a nil FuncsVec that would fault on AddFunc's first Push.
	m.FuncsVec = vec.New[@Func]()
	// Seed the FuncSigs name→index table with the zero-size direct-dispatch policies
	// (FuncSigHasher/FuncSigEq), keyed by *[]readonly char borrows of each sig's Name.
	m.FuncSigIndex = table.NewTable[*[]readonly char, int, FuncSigHasher, FuncSigEq](
			FuncSigHasher{}, FuncSigEq{})
	// Seed the per-module interface registry with universe `any` so every
	// module starts with it visible to isInterfaceTypeExpr / ifaceTypeForName /
	// lookupModuleInterface (Plan §6).  Was InitModule's registerUniverseAny
	// on the old moduleInterfaces package-global.
	registerUniverseAny(m)
	return m
}

// AddFunc appends a function to the module's function list.
func (m @Module) AddFunc(f @Func) {
	// Push onto the amortized-growth builder and refresh the consumer-facing view
	// (Items() is an O(1) sub-slice sharing the builder's backing), keeping
	// m.Funcs current after every append without the O(n)-per-append realloc a
	// grow-by-one slice append would cost.
	m.FuncsVec.Push(f)
	m.Funcs = m.FuncsVec.Items()
}

// AddGlobal appends a global variable to the module.
func (m @Module) AddGlobal(g @Global) {
	m.Globals = slices.Append[@Global](m.Globals, g)
}

// AddTypeDef appends a type definition to the module.
func (m @Module) AddTypeDef(td @TypeDef) {
	m.Types = slices.Append[@TypeDef](m.Types, td)
}

// ============================================================
// Function
// ============================================================

// NewFunc creates a new function with parameters and result types, assigning IDs to params.
// f.Name is the canonical fully-qualified name: `name` qualified with
// `pkgPath` (the defining module's package path) via mangle.QualifyName.
// An empty `pkgPath` (a name built outside any module-gen context) leaves
// `name` unchanged, and QualifyName is idempotent on an already-dotted
// `name` (cross-package refs, methods, qualified dtors), so those pass
// through too.  f.ModulePkgPath caches `pkgPath` so the @Block emit
// methods qualify bare call targets off the func (b.Func.ModulePkgPath).
func NewFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func {
	var f @Func = make(Func)
	if len(pkgPath) > 0 {
		f.Name = mangle.QualifyName(pkgPath, name)
	} else {
		f.Name = name
	}
	// Cache the module path so the emit methods qualify bare call targets
	// off the func (b.Func.ModulePkgPath) rather than the package-global.
	f.ModulePkgPath = pkgPath
	f.Params = params
	f.Results = results
	f.IsExtern = false
	f.NextID = 0
	for i := 0; i < len(params); i++ {
		params[i].ID = f.NextID
		f.NextID = f.NextID + 1
	}
	return f
}

// NewExternFunc creates an extern function declaration (no body, no param IDs).
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@Param, results @[]@types.Type) @Func {
	var f @Func = make(Func)
	if len(pkgPath) > 0 {
		f.Name = mangle.QualifyName(pkgPath, name)
	} else {
		f.Name = name
	}
	f.ModulePkgPath = pkgPath
	f.Params = params
	f.Results = results
	// A multi-return extern needs its result-tuple type, exactly as a local func
	// gets it (gen_func.bn) — codegen's sret decision (FuncReturnsBigMultiReturn)
	// reads f.MultiReturnType, so leaving it nil makes a cross-module call emit
	// the register-FCA convention while the defining module sret's the callee: an
	// ABI mismatch that corrupts a stack-spilled param on x64 (session.bn:193).
	if len(results) > 1 {
		f.MultiReturnType = makeMultiReturnStructType(results)
	}
	f.IsExtern = true
	f.NextID = 0
	return f
}

// AddBlock creates a new basic block with a unique label and appends it to the
// function.  While f.PadEmitMode is set (during a fault landing pad's cleanup,
// which can branch), the block is routed to Func.FaultPads instead of Blocks so
// the compiled backends never see it — see AddFaultPad.
func AddBlock(f @Func, label *[]readonly char) @Block {
	if f.PadEmitMode {
		return AddFaultPad(f, label)
	}
	var b @Block = make(Block)
	b.InstrsVec = vec.New[@Instr]()
	// Make labels unique: "{label}.{blockIndex}"
	var qn @strings.Builder = strings.NewBuilder()
	qn.Write(label)
	qn.WriteByte('.')
	stringutils.WriteInt(qn, len(f.Blocks))
	b.Label = buf.CopyStr(qn.String())
	b.Func = f
	f.Blocks = slices.Append[@Block](f.Blocks, b)
	return b
}

// AddFaultPad appends a VM-only cleanup landing pad block to the function's
// FaultPads list — NOT Blocks — so the compiled backends (which iterate Blocks)
// never emit it; only the VM lowers pads and branches to them on a recoverable
// fault.
func AddFaultPad(f @Func, label *[]readonly char) @Block {
	var b @Block = make(Block)
	b.InstrsVec = vec.New[@Instr]()
	var qn @strings.Builder = strings.NewBuilder()
	qn.Write(label)
	qn.WriteByte('.')
	stringutils.WriteInt(qn, len(f.FaultPads))
	b.Label = buf.CopyStr(qn.String())
	b.Func = f
	f.FaultPads = slices.Append[@Block](f.FaultPads, b)
	return b
}

// ============================================================
// Param
// ============================================================

// NewParam creates a new function parameter and assigns it a unique ID.
func NewParam(f @Func, name @[]char, typ @types.Type) @Param {
	var p @Param = make(Param)
	p.Name = name
	p.Typ = typ
	p.ID = f.NextID
	f.NextID = f.NextID + 1
	return p
}

// newParamRef builds the by-ID placeholder @Instr that stands for parameter `p`:
// an operand whose ID equals p's ID, which every backend resolves to the incoming
// argument (LLVM `%v<id>` / the VM+native param slot) straight from the function
// signature.  It is only ever an operand — never appended to a block as a def.
//
// Its opcode is OP_PARAM, NOT OP_CONST_INT.  A distinct opcode is load-bearing:
// the shared IR-level SSA passes read `.Op` (mem2reg / load-forwarding forward the
// placeholder as a param-slot load's reaching value; bceConstIndex / bceLoop
// inspect the resulting operand).  Spelled OP_CONST_INT — enum value 0, default
// IntVal 0 — those passes mistook a parameter for the integer constant 0 and
// dropped bounds checks (a silent -O1 out-of-bounds miscompile); OP_PARAM keeps a
// parameter from ever looking like a constant.
//
// IsByvalParamRef is set for a byval-aggregate param so that an OP_STORE of this
// ref into its slot lowers as a memcpy from the `ptr byval(<T>)` incoming pointer
// rather than a value store.  The flag is consumed ONLY by the store emitter, so
// it is inert on a ref that is instead loaded-through or forwarded (e.g. an
// interface-thunk's byval pass-through).
func newParamRef(p @Param) @Instr {
	var ref @Instr = make(Instr)
	ref.ID = p.ID
	ref.Typ = p.Typ
	ref.Op = iropcode.OP_PARAM
	ref.IsByvalParamRef = p.Typ.IsByvalParam()
	return ref
}

// ============================================================
// Internal: allocate an instruction
// ============================================================

// nextID allocates and returns the next unique instruction ID for the function.
func nextID(f *Func) int {
	var id int = f.NextID
	f.NextID = f.NextID + 1
	return id
}

// stripConstForIR peels TYP_READONLY wrappers (through aliases) so that
// the IR / codegen never see const — const is a type-system-only
// concept that doesn't affect layout or instruction selection.
// Strips recursively through pointer, slice, and array element types
// so that the result has no const anywhere.
func stripConstForIR(t @types.Type) @types.Type {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS { t = t.Target }
		if t != nil && t.Kind == types.TYP_READONLY { t = t.Elem }
	}
	if t == nil { return t }
	if t.Kind == types.TYP_POINTER {
		return types.MakePointerType(stripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(stripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_SLICE {
		return types.MakeSliceType(stripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		return types.MakeManagedSliceType(stripConstForIR(t.Elem))
	}
	if t.Kind == types.TYP_ARRAY {
		return types.MakeArrayType(stripConstForIR(t.Elem), t.ArrayLen)
	}
	return t
}

// newInstr allocates a typed instruction with a unique ID.
func newInstr(f *Func, op int, typ @types.Type) @Instr {
	var instr @Instr = make(Instr)
	instr.ID = nextID(f)
	instr.Op = op
	instr.Typ = stripConstForIR(typ)
	return instr
}

// newVoidInstr allocates a void instruction (ID -1, no result value).
func newVoidInstr(op int) @Instr {
	var instr @Instr = make(Instr)
	instr.ID = -1
	instr.Op = op
	return instr
}

// addInstr appends an instruction to a basic block.
func addInstr(b @Block, instr @Instr) {
	// Push onto the amortized-growth builder and refresh the consumer-facing view
	// (Items() is an O(1) sub-slice sharing the builder's backing), keeping
	// b.Instrs current after every append without the O(n)-per-append realloc a
	// grow-by-one slice append would cost.
	b.InstrsVec.Push(instr)
	b.Instrs = b.InstrsVec.Items()
	// Nil-check dedup invalidation: an op that is
	// not provably nil-check-preserving — a store (reassigns a slot), a call /
	// destructor (runs user code that could reassign a global or escaped local),
	// or anything unknown — clears this block's established-non-nil set, so a later
	// deref of a pointer that MIGHT have been reassigned re-checks (soundness).
	// Gated on a non-empty set so it is a pure no-op when nil-checking is off (the
	// set is only ever populated when GenCtx.EmitNilChecks is on).
	if len(b.NilCheckedSlots) > 0 && !nilDedupPreservingOp(instr.Op) {
		var cleared @[]int
		b.NilCheckedSlots = cleared
	}
}

// nilDedupPreservingOp reports whether appending `op` to a block leaves the
// established-non-nil set (Block.NilCheckedSlots) valid — i.e. `op` cannot
// reassign a pointer variable's slot and runs no user code.  It is a CONSERVATIVE
// whitelist of provably-pure ops: anything not listed (a store, any call, any
// destructor, or a future/unknown op) returns false and INVALIDATES the set, so
// dedup can never elide a check that a reassignment made necessary.  (See N2d.)
func nilDedupPreservingOp(op int) bool {
	switch op {
	case iropcode.OP_CONST_INT, iropcode.OP_CONST_FLOAT, iropcode.OP_CONST_BOOL,
			iropcode.OP_CONST_STRING, iropcode.OP_CONST_NIL:
		return true
	// Arithmetic / comparison / logic — pure (a divide/shift trap is a branch,
	// not a slot reassignment).
	case iropcode.OP_ADD, iropcode.OP_SUB, iropcode.OP_MUL, iropcode.OP_DIV, iropcode.OP_REM,
			iropcode.OP_AND, iropcode.OP_OR, iropcode.OP_XOR, iropcode.OP_SHL, iropcode.OP_SHR,
			iropcode.OP_EQ, iropcode.OP_NE, iropcode.OP_LT, iropcode.OP_LE, iropcode.OP_GT, iropcode.OP_GE,
			iropcode.OP_LAND, iropcode.OP_LOR, iropcode.OP_NEG, iropcode.OP_NOT, iropcode.OP_BITNOT:
		return true
	// Reads / address arithmetic / conversions — pure (a load reads; a GEP or a
	// cast computes a value; none reassigns a variable's slot).
	case iropcode.OP_LOAD, iropcode.OP_GET_FIELD_PTR, iropcode.OP_GET_ELEM_PTR, iropcode.OP_CAST,
			iropcode.OP_BIT_CAST:
		return true
	// Guards — pure (a fault is a branch, not a reassignment).
	case iropcode.OP_NIL_CHECK, iropcode.OP_BOUNDS_CHECK, iropcode.OP_DIV_CHECK,
			iropcode.OP_SHIFT_CHECK:
		return true
	// Refcount INCREMENT — pure (no destructor, no user code).  OP_REFDEC is
	// deliberately NOT here: it may run a destructor (user code).
	case iropcode.OP_REFINC:
		return true
	}
	return false
}

// Internal: build fixed-size Args slices
func makeArgs1(a @Instr) @[]@Instr {
	var s @[]@Instr = make_slice(@Instr, 1)
	s[0] = a
	return s
}

// makeArgs2 builds a 2-element instruction argument slice.
func makeArgs2(a @Instr, b @Instr) @[]@Instr {
	var s @[]@Instr = make_slice(@Instr, 2)
	s[0] = a
	s[1] = b
	return s
}

// ============================================================
// Constants
// ============================================================

// EmitConstInt emits an integer constant instruction from a host-`int`
// value, widening it into the int64 IntVal slot.
func (b @Block) EmitConstInt(val int, typ @types.Type) @Instr {
	return b.EmitConstInt64(cast(int64, val), typ)
}

// EmitConstInt64 emits an integer constant instruction from a
// fixed-width int64 value (the literal-value path).
func (b @Block) EmitConstInt64(val int64, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CONST_INT, typ)
	instr.IntVal = val
	addInstr(b, instr)
	return instr
}

// EmitConstFloat emits a floating-point constant instruction. The
// raw literal text is stored in StrVal; backends parse it at lowering
// time. Typ is the resolved float type (TYP_UNTYPED_FLOAT until
// context types it to float32/float64).
func (b @Block) EmitConstFloat(text @[]char, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CONST_FLOAT, typ)
	instr.StrVal = text
	addInstr(b, instr)
	return instr
}

// EmitConstBool emits a boolean constant instruction.
func (b @Block) EmitConstBool(val bool) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CONST_BOOL, types.TypBool())
	instr.BoolVal = val
	addInstr(b, instr)
	return instr
}

// EmitConstString emits a string constant instruction. The result's
// type is `*readonly uint8` — a raw pointer to the rodata bytes; callers
// dispatch on `instr.Op == OP_CONST_STRING` to detect string-literal
// origins (the type alone is not load-bearing — `*readonly uint8` could
// arise from other sources too).
func (b @Block) EmitConstString(val @[]char) @Instr {
	var f *Func = b.Func
	var byteTyp @types.Type = types.MakePointerType(
			types.MakeReadonlyType(types.TypUint8()))
	var instr @Instr = newInstr(f, iropcode.OP_CONST_STRING, byteTyp)
	instr.StrVal = val
	addInstr(b, instr)
	return instr
}

// EmitConstNil emits a nil constant of the given type.
func (b @Block) EmitConstNil(typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CONST_NIL, typ)
	addInstr(b, instr)
	return instr
}

// ============================================================
// Binary operations
// ============================================================

// EmitBinop emits a binary operation (arithmetic, comparison, logical).
func (b @Block) EmitBinop(op int, lhs @Instr, rhs @Instr, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, op, typ)
	instr.Args = makeArgs2(lhs, rhs)
	addInstr(b, instr)
	return instr
}

// ============================================================
// Unary operations
// ============================================================

// EmitUnary emits a unary operation (negation, not, bitwise not).
func (b @Block) EmitUnary(op int, arg @Instr, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, op, typ)
	instr.Args = makeArgs1(arg)
	addInstr(b, instr)
	return instr
}

// ============================================================
// Memory
// ============================================================

// EmitAlloc emits a stack allocation (alloca) for the given element type.
func (b @Block) EmitAlloc(elemTyp @types.Type) @Instr {
	var f *Func = b.Func
	elemTyp = stripConstForIR(elemTyp)
	var instr @Instr = newInstr(f, iropcode.OP_ALLOC, types.MakePointerType(elemTyp))
	instr.TypeArg = elemTyp
	addInstr(b, instr)
	return instr
}

// EmitLoad emits a load from a pointer, producing a value of the given type.
func (b @Block) EmitLoad(ptr @Instr, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_LOAD, typ)
	instr.Args = makeArgs1(ptr)
	addInstr(b, instr)
	return instr
}

// EmitStore emits a store of a value into a pointer location.
func (b @Block) EmitStore(ptr @Instr, val @Instr) {
	var instr @Instr = newVoidInstr(iropcode.OP_STORE)
	instr.Args = makeArgs2(ptr, val)
	addInstr(b, instr)
}

// EmitGetFieldPtr emits a pointer to a struct field at the given index.
func (b @Block) EmitGetFieldPtr(ptr @Instr, index int, fieldTyp @types.Type) @Instr {
	var f *Func = b.Func
	fieldTyp = stripConstForIR(fieldTyp)
	var instr @Instr = newInstr(f, iropcode.OP_GET_FIELD_PTR, types.MakePointerType(fieldTyp))
	instr.Args = makeArgs1(ptr)
	instr.Index = index
	addInstr(b, instr)
	return instr
}

// EmitGetElemPtr emits a pointer to an array/slice element at a dynamic index.
func (b @Block) EmitGetElemPtr(ptr @Instr, index @Instr, elemTyp @types.Type) @Instr {
	var f *Func = b.Func
	elemTyp = stripConstForIR(elemTyp)
	var instr @Instr = newInstr(f, iropcode.OP_GET_ELEM_PTR, types.MakePointerType(elemTyp))
	instr.Args = makeArgs2(ptr, index)
	addInstr(b, instr)
	return instr
}
