package "pkg/binate/ir"

// countOpInFunc counts instructions with op across all of fn's blocks.
func countOpInFunc(fn @Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op { n = n + 1 }
		}
	}
	return n
}
