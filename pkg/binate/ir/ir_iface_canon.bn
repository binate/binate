package "pkg/binate/ir"

import "pkg/binate/irutil"
import "pkg/binate/types"

// An interface alias is the interface it names (`interface PA = P`), so a type
// spelled through one is the type spelled with the aliased interface.  Wherever
// a type's identity is its spelling — an instantiation's mangled type arguments,
// the structural key of a name-less boxed type (`*[]*PA` boxed into `any`) —
// the type is first rewritten with every interface it names resolved to the
// tail of its alias chain (CanonicalIfaceType).

// CanonicalIfaceType returns t with every interface it names — directly or
// under pointer, managed-pointer, slice, managed-slice, array, readonly,
// interface-value, function-type or anonymous-struct structure — replaced by the
// tail of its alias chain (CanonicalIfacePkg / CanonicalIfaceName); t itself
// when none changes.  Named types, named structs included, are left as they
// are: their identity is their name.  An anonymous struct's is its field types
// (it is keyed structurally), so they are resolved too.
func CanonicalIfaceType(m @Module, t @types.Type) @types.Type {
	if t == nil || m == nil { return t }
	if t.Kind == types.TYP_INTERFACE {
		var pkg @[]char = CanonicalIfacePkg(m, t.Pkg, t.Name)
		var name @[]char = CanonicalIfaceName(m, t.Pkg, t.Name)
		if irutil.CharEq(pkg, t.Pkg) && irutil.CharEq(name, t.Name) { return t }
		return types.MakeInterfaceType(pkg, name)
	}
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return canonicalIfaceFuncType(m, t)
	}
	if t.Kind == types.TYP_STRUCT && irutil.IsAnonStructName(t.Name) {
		return canonicalIfaceAnonStruct(m, t)
	}
	var elem @types.Type = CanonicalIfaceType(m, t.Elem)
	if same(elem, t.Elem) { return t }
	if t.Kind == types.TYP_INTERFACE_VALUE { return types.MakeInterfaceValueType(elem) }
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return types.MakeManagedInterfaceValueType(elem)
	}
	if t.Kind == types.TYP_POINTER { return types.MakePointerType(elem) }
	if t.Kind == types.TYP_MANAGED_PTR { return types.MakeManagedPtrType(elem) }
	if t.Kind == types.TYP_SLICE { return types.MakeSliceType(elem) }
	if t.Kind == types.TYP_MANAGED_SLICE { return types.MakeManagedSliceType(elem) }
	if t.Kind == types.TYP_READONLY { return types.MakeReadonlyType(elem) }
	if t.Kind == types.TYP_ARRAY && !t.ArrayLenDependent {
		return types.MakeArrayType(elem, t.ArrayLen)
	}
	return t
}

// CanonicalIfaceTypes is CanonicalIfaceType over ts, reporting whether any
// changed — ts itself when none does.
func CanonicalIfaceTypes(m @Module, ts @[]@types.Type) (@[]@types.Type, bool) {
	var out @[]@types.Type
	var changed bool = false
	for i := 0; i < len(ts); i++ {
		var c @types.Type = CanonicalIfaceType(m, ts[i])
		if same(c, ts[i]) { continue }
		if !changed {
			out = make_slice(@types.Type, len(ts))
			for j := 0; j < len(ts); j++ { out[j] = ts[j] }
			changed = true
		}
		out[i] = c
	}
	if !changed { return ts, false }
	return out, true
}

// canonicalIfaceFuncType is CanonicalIfaceType for a function or function-value
// type: its parameter and result types, each parameter keeping its name and
// variadic flag.
func canonicalIfaceFuncType(m @Module, t @types.Type) @types.Type {
	var changed bool = false
	var params @[]@types.Param = make_slice(@types.Param, len(t.Params))
	for i := 0; i < len(t.Params); i++ {
		var p @types.Param = t.Params[i]
		var pt @types.Type = CanonicalIfaceType(m, p.Type)
		if same(pt, p.Type) {
			params[i] = p
			continue
		}
		changed = true
		var np @types.Param = make(types.Param)
		np.Name = p.Name
		np.Type = pt
		np.IsVariadic = p.IsVariadic
		params[i] = np
	}
	var results @[]@types.Type
	var resultsChanged bool
	results, resultsChanged = CanonicalIfaceTypes(m, t.Results)
	if !changed && !resultsChanged { return t }
	if t.Kind == types.TYP_FUNC_VALUE { return types.MakeFuncValueType(params, results) }
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return types.MakeManagedFuncValueType(params, results)
	}
	return types.MakeFuncType(params, results)
}

// canonicalIfaceAnonStruct is CanonicalIfaceType for an anonymous struct: its
// field types, each field keeping its name, under the same struct name.
func canonicalIfaceAnonStruct(m @Module, t @types.Type) @types.Type {
	var changed bool = false
	var fields @[]@types.Field = make_slice(@types.Field, len(t.Fields))
	for i := 0; i < len(t.Fields); i++ {
		var f @types.Field = t.Fields[i]
		var ft @types.Type = CanonicalIfaceType(m, f.Type)
		if same(ft, f.Type) {
			fields[i] = f
			continue
		}
		changed = true
		var nf @types.Field = make(types.Field)
		nf.Name = f.Name
		nf.Type = ft
		fields[i] = nf
	}
	if !changed { return t }
	return types.MakeStructType(t.Name, fields)
}
