package "pkg/binate/ir"

import "pkg/binate/irsym"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// canonModule returns a module registering pkg/b's interface P and pkg/a's
// alias Q of it (`interface Q = b.P`).
func canonModule() @Module {
	var m @Module = NewModule("\"main\"")
	var p irsym.ModuleInterface
	p.Pkg = "pkg/b"
	p.Name = "P"
	var q irsym.ModuleInterface
	q.Pkg = "pkg/a"
	q.Name = "Q"
	q.AliasTarget = "P"
	q.AliasTargetPkg = "pkg/b"
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, p)
	m.Interfaces = slices.Append[irsym.ModuleInterface](m.Interfaces, q)
	return m
}

// ifaceValOf returns the raw interface-value type `*<pkg>.<name>`.
func ifaceValOf(pkg @[]char, name @[]char) @types.Type {
	return types.MakeInterfaceValueType(types.MakeInterfaceType(pkg, name))
}

// isIfaceValOf reports whether t is `*<pkg>.<name>`.
func isIfaceValOf(t @types.Type, pkg *[]readonly char, name *[]readonly char) bool {
	return t != nil && t.Kind == types.TYP_INTERFACE_VALUE && t.Elem != nil &&
			irutil.CharEq(t.Elem.Pkg, pkg) && irutil.CharEq(t.Elem.Name, name)
}

// An interface named through an alias resolves to the aliased interface,
// directly and nested under slice and anonymous-struct structure.
func TestCanonicalIfaceTypeResolvesAlias() testing.TestResult {
	var m @Module = canonModule()
	if !isIfaceValOf(CanonicalIfaceType(m, ifaceValOf("pkg/a", "Q")), "pkg/b", "P") {
		return "*a.Q should resolve to *b.P"
	}
	var s @types.Type = CanonicalIfaceType(m, types.MakeSliceType(ifaceValOf("pkg/a", "Q")))
	if s.Kind != types.TYP_SLICE || !isIfaceValOf(s.Elem, "pkg/b", "P") {
		return "*[]*a.Q should resolve to *[]*b.P"
	}
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f @types.Field = make(types.Field)
	f.Name = "q"
	f.Type = ifaceValOf("pkg/a", "Q")
	fields[0] = f
	var st @types.Type = CanonicalIfaceType(m, types.MakeStructType("__anon_3", fields))
	if !irutil.CharEq(st.Name, "__anon_3") || !isIfaceValOf(st.Fields[0].Type, "pkg/b", "P") {
		return "an anonymous struct's field *a.Q should resolve to *b.P under the same name"
	}
	return ""
}

// A type naming no alias comes back as the same object; the list form reports
// whether anything changed.
func TestCanonicalIfaceTypesUnchanged() testing.TestResult {
	var m @Module = canonModule()
	var direct @types.Type = ifaceValOf("pkg/b", "P")
	if !same(CanonicalIfaceType(m, direct), direct) { return "*b.P should come back unchanged" }
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = direct
	var changed bool
	_, changed = CanonicalIfaceTypes(m, ts)
	if changed { return "[int, *b.P] should not change" }
	ts[1] = ifaceValOf("pkg/a", "Q")
	var out @[]@types.Type
	out, changed = CanonicalIfaceTypes(m, ts)
	if !changed || !isIfaceValOf(out[1], "pkg/b", "P") || !same(out[0], ts[0]) {
		return "[int, *a.Q] should become [int, *b.P]"
	}
	return ""
}
