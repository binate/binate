package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/builtins/testing"

// An impl row's method function is named for the receiver's base type, so a
// readonly variant row's vtable slots name the same functions as T's row.
func TestImplMethodFuncName() testing.TestResult {
	if !irutil.CharEq(ImplMethodFuncName("pkg/a", "T", "Get"), "pkg/a.T.Get") {
		return "a base row's method should be <pkg>.<T>.<method>"
	}
	if !irutil.CharEq(ImplMethodFuncName("pkg/a", irutil.ReadonlyVariantName("T"), "Get"),
			"pkg/a.T.Get") {
		return "a readonly variant row's method should name T's method"
	}
	return ""
}
