package "pkg/binate/ir"

import "pkg/binate/iropcode"

// ============================================================
// Helpers
// ============================================================

// IsTerminator returns true if the instruction ends a basic block
// (jump, branch, return, unreachable).
func (instr @Instr) IsTerminator() bool {
	switch instr.Op {
	case iropcode.OP_JUMP, iropcode.OP_BRANCH, iropcode.OP_RETURN, iropcode.OP_UNREACHABLE,
			iropcode.OP_UNWIND_RETURN:
		return true
	}
	return false
}
