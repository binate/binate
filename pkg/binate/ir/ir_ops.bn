package "pkg/binate/ir"

import "pkg/binate/types"

// ============================================================
// Slices & arrays
// ============================================================

// EmitSliceLen extracts the length field from a slice value.
func (b @Block) EmitSliceLen(slice @Instr) @Instr {
	// Lower to primitive: extract len field (field 1) from slice struct.
	return b.EmitExtract(slice, 1, types.TypInt())
}

// EmitIfacePresent lowers `present(iv)`: an interface value is a 2-word
// {data, vtable} aggregate, and is "present" (holds a concrete impl)
// iff its vtable word (field 1) is non-null.  Honest about typed-nil —
// boxing a nil `*T` still fills the vtable, so the result is true.
// Interface values are not nillable (see claude-notes.md:1141), so this
// is the only emptiness test; it reuses the generic extract + compare
// primitives (no dedicated op, so every backend lowers it for free).
func (b @Block) EmitIfacePresent(iv @Instr) @Instr {
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var vtable @Instr = b.EmitExtract(iv, 1, rawPtrTyp)
	var nullp @Instr = b.EmitConstNil(rawPtrTyp)
	return b.EmitBinop(OP_NE, vtable, nullp, types.TypBool())
}

// EmitPresent lowers `present(x)` for every sensible type — "does x hold
// something / is it set?".  Per kind: an interface value is present iff
// its vtable word is set (field 1 — {data, vtable}); a function value iff
// its vtable word is set (field 0 — {vtable, data}); a pointer iff
// non-null; a slice iff non-empty (len > 0 — a length-0 slice has no
// backing per the invariant, so len>0 is exactly "holds something").
// Value types are never operands (the checker rejects them).
func (b @Block) EmitPresent(x @Instr, typ @types.Type) @Instr {
	var t @types.Type = peelToUnderlying(typ)
	if t != nil && (t.Kind == types.TYP_INTERFACE_VALUE ||
			t.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		return b.EmitIfacePresent(x)
	}
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var nullp @Instr = b.EmitConstNil(rawPtrTyp)
	if t != nil && (t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		var vtable @Instr = b.EmitExtract(x, 0, rawPtrTyp)
		return b.EmitBinop(OP_NE, vtable, nullp, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_POINTER ||
			t.Kind == types.TYP_MANAGED_PTR) {
		var xp @Instr = b.EmitBitCast(x, rawPtrTyp)
		return b.EmitBinop(OP_NE, xp, nullp, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_SLICE ||
			t.Kind == types.TYP_MANAGED_SLICE) {
		var n @Instr = b.EmitSliceLen(x)
		var zero @Instr = b.EmitConstInt(0, types.TypInt())
		return b.EmitBinop(OP_GT, n, zero, types.TypBool())
	}
	// The checker guarantees one of the above; default to false.
	return b.EmitConstBool(false)
}

// peelToUnderlying peels alias, readonly, and named-distinct wrappers to
// the underlying type, so EmitSame / EmitPresent dispatch on the real
// reference kind.
func peelToUnderlying(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return t
		}
	}
	return t
}

// EmitSame lowers `same(a, other)`: reference identity for the type the
// checker already validated (pointer, interface value, or slice — both
// operands the same type).  A pointer compares as one word; an interface
// value compares both {data, vtable} words; a slice compares its view
// {data, len}.  Built from extract + OP_EQ + OP_LAND (OP_LAND is the
// non-short-circuit bool-and), so every backend lowers it for free (cf.
// EmitIfacePresent).
func (b @Block) EmitSame(a @Instr, other @Instr, typ @types.Type) @Instr {
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var t @types.Type = peelToUnderlying(typ)
	if t != nil && (t.Kind == types.TYP_POINTER ||
			t.Kind == types.TYP_MANAGED_PTR) {
		return b.EmitBinop(OP_EQ, a, other, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_INTERFACE_VALUE ||
			t.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		var da @Instr = b.EmitExtract(a, 0, rawPtrTyp)
		var db @Instr = b.EmitExtract(other, 0, rawPtrTyp)
		var dataEq @Instr = b.EmitBinop(OP_EQ, da, db, types.TypBool())
		var va @Instr = b.EmitExtract(a, 1, rawPtrTyp)
		var vb @Instr = b.EmitExtract(other, 1, rawPtrTyp)
		var vtblEq @Instr = b.EmitBinop(OP_EQ, va, vb, types.TypBool())
		return b.EmitBinop(OP_LAND, dataEq, vtblEq, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_SLICE ||
			t.Kind == types.TYP_MANAGED_SLICE) {
		var sa @Instr = b.EmitExtract(a, 0, rawPtrTyp)
		var sb @Instr = b.EmitExtract(other, 0, rawPtrTyp)
		var dataEq @Instr = b.EmitBinop(OP_EQ, sa, sb, types.TypBool())
		var la @Instr = b.EmitExtract(a, 1, types.TypInt())
		var lb @Instr = b.EmitExtract(other, 1, types.TypInt())
		var lenEq @Instr = b.EmitBinop(OP_EQ, la, lb, types.TypBool())
		return b.EmitBinop(OP_LAND, dataEq, lenEq, types.TypBool())
	}
	// The checker guarantees one of the above; fall back to a one-word
	// compare rather than emitting nothing.
	return b.EmitBinop(OP_EQ, a, other, types.TypBool())
}

// EmitSliceGet loads an element from a slice at the given index.
func (b @Block) EmitSliceGet(slice @Instr, index @Instr, elemTyp @types.Type) @Instr {
	// Lower to primitives: extract data ptr (i8*), GEP by index, load.
	// The codegen's GEP handler bitcasts i8* to *elemType automatically.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = b.EmitExtract(slice, 0, rawPtrTyp)
	var elemPtr @Instr = b.EmitGetElemPtr(dataPtr, index, elemTyp)
	return b.EmitLoad(elemPtr, elemTyp)
}

// EmitSliceSet stores a value into a slice element at the given index.
func (b @Block) EmitSliceSet(slice @Instr, index @Instr, val @Instr, elemTyp @types.Type) {
	// Lower to primitives: extract data ptr, GEP by index, store.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = b.EmitExtract(slice, 0, rawPtrTyp)
	var elemPtr @Instr = b.EmitGetElemPtr(dataPtr, index, elemTyp)
	b.EmitStore(elemPtr, val)
}

// EmitSliceElemPtr returns a pointer to a slice element (no load).
func (b @Block) EmitSliceElemPtr(slice @Instr, index @Instr, elemTyp @types.Type) @Instr {
	// Lower to primitives: extract data ptr, GEP by index (returns pointer, no load).
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = b.EmitExtract(slice, 0, rawPtrTyp)
	return b.EmitGetElemPtr(dataPtr, index, elemTyp)
}

// EmitSliceExpr emits a subslice operation (s[lo:hi]) as a zero-copy view adjustment.
func (b @Block) EmitSliceExpr(slice @Instr, lo @Instr, hi @Instr, typ @types.Type) @Instr {
	// Lower to primitives: zero-copy view adjustment.
	// Raw slice result: {data + lo * elemSize, hi - lo}
	// Managed slice result: {data + lo * elemSize, hi - lo, refptr, backingLen}
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = b.EmitExtract(slice, 0, rawPtrTyp)

	// Compute new data pointer: data + lo * elemSize (byte-level GEP on i8*).
	// We use byte arithmetic to avoid LLVM type mismatches — the codegen's
	// GEP handler for raw pointers emits an internal bitcast that produces a
	// typed pointer (e.g., i64*), but slice field 0 expects i8*.
	var elemTyp @types.Type = typ.Elem
	var elemSize @Instr = b.EmitConstInt(elemTyp.SizeOf(), types.TypInt())
	var byteOffset @Instr = b.EmitBinop(OP_MUL, lo, elemSize, types.TypInt())
	var newData @Instr = b.EmitGetElemPtr(dataPtr, byteOffset, types.TypUint8())

	// Compute new length: hi - lo
	var newLen @Instr = b.EmitBinop(OP_SUB, hi, lo, types.TypInt())

	// Length-0 ⟹ no backing (claude-notes.md "Nil slices" / "Length-0 ⟹
	// no backing"): a length-0 subslice is the nil-equivalent {null, 0}
	// (raw) / {null, 0, null, 0} (managed) — it carries no backing pointer
	// and, managed, does not pin the backing.  newLen is already 0 in the
	// empty case; null out data (and managed refptr/backingLen) so empty
	// and "nil" slices are indistinguishable.  Branchless: `keep` is 1 when
	// non-empty, 0 when empty, and maskPointer / `* keep` null the fields
	// when empty.  A branch here would need block-splitting — EmitSliceExpr
	// is a @Block method with no GenContext.  The unconditional RefInc the
	// caller (genSliceExpr) then applies hits a null refptr → no-op, so the
	// refcount stays balanced (dtor RefDec(null) is a no-op too).
	var zero @Instr = b.EmitConstInt(0, types.TypInt())
	var nonEmpty @Instr = b.EmitBinop(OP_NE, newLen, zero, types.TypBool())
	var keep @Instr = b.EmitCast(nonEmpty, types.TypInt())
	newData = b.maskPointer(newData, keep, rawPtrTyp)

	// Build result slice via alloca + field stores + load
	var sliceAlloca @Instr = b.EmitAlloc(typ)
	var f0 @Instr = b.EmitGetFieldPtr(sliceAlloca, 0, rawPtrTyp)
	b.EmitStore(f0, newData)
	var f1 @Instr = b.EmitGetFieldPtr(sliceAlloca, 1, types.TypInt())
	b.EmitStore(f1, newLen)

	if typ.Kind == types.TYP_MANAGED_SLICE {
		// Preserve backing refptr and backingLen from original — but null
		// them for a length-0 result (no backing, per the invariant above).
		var refptr @Instr = b.EmitExtract(slice, 2, rawPtrTyp)
		var backingLen @Instr = b.EmitExtract(slice, 3, types.TypInt())
		refptr = b.maskPointer(refptr, keep, rawPtrTyp)
		backingLen = b.EmitBinop(OP_MUL, backingLen, keep, types.TypInt())
		var f2 @Instr = b.EmitGetFieldPtr(sliceAlloca, 2, rawPtrTyp)
		b.EmitStore(f2, refptr)
		var f3 @Instr = b.EmitGetFieldPtr(sliceAlloca, 3, types.TypInt())
		b.EmitStore(f3, backingLen)
	}

	return b.EmitLoad(sliceAlloca, typ)
}

// maskPointer returns p when keep == 1 and null when keep == 0 (keep ∈
// {0, 1}).  Branchless: reinterpret the pointer as a word-size int (`int`
// is pointer-width) and multiply by keep — ×1 is identity, ×0 yields
// null.  Mirrors rt's bit_cast(int, ptr) address arithmetic, so it lowers
// on every backend.  Used to null a length-0 slice's data / refptr.
func (b @Block) maskPointer(p @Instr, keep @Instr, ptrTyp @types.Type) @Instr {
	var pInt @Instr = b.EmitBitCast(p, types.TypInt())
	var masked @Instr = b.EmitBinop(OP_MUL, pInt, keep, types.TypInt())
	return b.EmitBitCast(masked, ptrTyp)
}

// EmitBoundsCheck emits a runtime bounds check that panics if index >= length.
func (b @Block) EmitBoundsCheck(index @Instr, length @Instr) {
	var instr @Instr = newVoidInstr(OP_BOUNDS_CHECK)
	instr.Args = makeArgs2(index, length)
	addInstr(b, instr)
}

// EmitDivCheck emits a runtime divide-fault guard before an integer
// OP_DIV / OP_REM. dividend and divisor must already be sign/zero-
// extended to 64-bit. width is the operand type's resolved bit width
// and signed its signedness — carried on IntVal / BoolVal so each
// backend can recover the type's signed MIN for the MIN/-1 check.
func (b @Block) EmitDivCheck(dividend @Instr, divisor @Instr,
		width int, signed bool) {
	var instr @Instr = newVoidInstr(OP_DIV_CHECK)
	instr.Args = makeArgs2(dividend, divisor)
	instr.IntVal = cast(int64, width)
	instr.BoolVal = signed
	addInstr(b, instr)
}


// ============================================================
// Strings
// ============================================================

// EmitStringToChars converts a string constant to a char slice
// (*[]readonly char, @[]char, or @[]readonly char). Phase 3.2 dispatch:
//
//   read-only managed-slice target (`@[]readonly char`)
//     → OP_RODATA_MSLICE   (zero-copy alias of static global)
//   read-only raw-slice target (`*[]readonly char`)
//     → OP_RODATA_SLICE    (zero-copy alias of {data, len} prefix)
//   mutable managed-slice target (`@[]char`, Stage 2b)
//     → OP_RODATA_MSLICE_COPY  (alloc + memcpy from static global)
//
// All three ops are non-string-specific; the same lowering applies
// to user-written const-byte composite literals (3.1).
func (b @Block) EmitStringToChars(str @Instr, sliceTyp @types.Type) @Instr {
	if stringToCharsNeedsImplicitCopy(sliceTyp) {
		return b.EmitRodataMSliceCopy(str.StrVal, sliceTyp)
	}
	var resolved @types.Type = sliceTyp
	for resolved != nil && resolved.Kind == types.TYP_ALIAS {
		resolved = resolved.Target
	}
	if resolved != nil && resolved.Kind == types.TYP_READONLY {
		resolved = resolved.Elem
	}
	for resolved != nil && resolved.Kind == types.TYP_ALIAS {
		resolved = resolved.Target
	}
	if resolved != nil && resolved.Kind == types.TYP_MANAGED_SLICE {
		return b.EmitRodataMSlice(str.StrVal, sliceTyp)
	}
	return b.EmitRodataSlice(str.StrVal, sliceTyp)
}

// stringToCharsNeedsImplicitCopy reports whether a string → slice
// conversion with target `sliceTyp` must allocate a fresh managed
// backing and memcpy the bytes in (Stage 2b rule for `@[]char`).
// Alias-the-static-global is correct for every other target:
//   *[]readonly char   : caller can only read, rodata is fine.
//   @[]char         : OWNED + MUTABLE; alias would let a write
//                     target the rodata page → copy.
//   @[]readonly char   : caller can only read, rodata is fine.
func stringToCharsNeedsImplicitCopy(sliceTyp @types.Type) bool {
	if sliceTyp == nil { return false }
	for sliceTyp != nil && sliceTyp.Kind == types.TYP_ALIAS {
		sliceTyp = sliceTyp.Target
	}
	if sliceTyp == nil { return false }
	// Outer const: permissive wrt capability — the holder is const.
	if sliceTyp.Kind == types.TYP_READONLY {
		return stringToCharsNeedsImplicitCopy(sliceTyp.Elem)
	}
	// Only managed-slices get the implicit copy; raw slices must
	// already be *[]readonly char by Stage 2a (ratchet), so no copy.
	if sliceTyp.Kind != types.TYP_MANAGED_SLICE { return false }
	var elem @types.Type = sliceTyp.Elem
	for elem != nil && elem.Kind == types.TYP_ALIAS { elem = elem.Target }
	if elem == nil { return false }
	// Element const → caller can only read → alias is fine.
	if elem.Kind == types.TYP_READONLY { return false }
	// @[]char with a plain char element → needs copy.
	return true
}

// EmitRodataMSlice emits a managed-slice composite literal that aliases
// a static rodata global. Used when the entire literal is compile-time
// constant bytes and the target is `@[]readonly T` (read-only view —
// aliasing rodata is sound). `bytes` is the byte sequence to embed.
func (b @Block) EmitRodataMSlice(bytes @[]char, sliceTyp @types.Type) @Instr {
	// Length-0 ⟹ no backing: an empty literal/string is the nil-equivalent
	// {null,0,null,0}, never a header aliasing an empty rodata global.
	if len(bytes) == 0 {
		return b.EmitConstNil(sliceTyp)
	}
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_RODATA_MSLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataSlice emits a raw-slice composite literal aliasing a static
// rodata global. Same byte-sequence shape as EmitRodataMSlice; codegen
// extracts the {data, len} prefix into a `*[]readonly T` value.
func (b @Block) EmitRodataSlice(bytes @[]char, sliceTyp @types.Type) @Instr {
	// Length-0 ⟹ no backing: empty raw literal/string → nil-equivalent.
	if len(bytes) == 0 {
		return b.EmitConstNil(sliceTyp)
	}
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_RODATA_SLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataArray emits an array literal initialized from rodata
// bytes. Allocates an `[N]T` buffer (size from arrayTyp.ArrayLen),
// memcpys `min(len(bytes), N)` bytes from a static global, and
// zero-pads the tail. Result is the array value (codegen materializes
// it through an alloca + memcpy + load).
func (b @Block) EmitRodataArray(bytes @[]char, arrayTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_RODATA_ARRAY, arrayTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataMSliceCopy emits a managed-slice that owns a fresh copy
// of `bytes`: MakeManagedSlice(elemSize=1, len=N) + memcpy from the
// static rodata global. Refcount 1, independent of rodata. Used for
// `@[]char = "..."` (Stage 2b implicit copy) and any mutable
// managed-slice composite literal whose elements are compile-time
// const bytes.
func (b @Block) EmitRodataMSliceCopy(bytes @[]char, sliceTyp @types.Type) @Instr {
	// (No length-0 guard needed: this lowers to MakeManagedSlice(1, len),
	// which already returns the nil-equivalent {null,0,null,0} for len 0 —
	// the copy path is compliant with length-0 ⟹ no backing as-is.)
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_RODATA_MSLICE_COPY, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}


// ============================================================
// Helpers
// ============================================================

// OpName returns the human-readable name for an IR opcode.
func OpName(op int) *[]readonly char {
	switch op {
	case OP_CONST_INT:           return "const_int"
	case OP_CONST_BOOL:          return "const_bool"
	case OP_CONST_STRING:        return "const_string"
	case OP_CONST_NIL:           return "const_nil"
	case OP_ADD:                 return "add"
	case OP_SUB:                 return "sub"
	case OP_MUL:                 return "mul"
	case OP_DIV:                 return "div"
	case OP_REM:                 return "rem"
	case OP_AND:                 return "and"
	case OP_OR:                  return "or"
	case OP_XOR:                 return "xor"
	case OP_SHL:                 return "shl"
	case OP_SHR:                 return "shr"
	case OP_EQ:                  return "eq"
	case OP_NE:                  return "ne"
	case OP_LT:                  return "lt"
	case OP_LE:                  return "le"
	case OP_GT:                  return "gt"
	case OP_GE:                  return "ge"
	case OP_LAND:                return "land"
	case OP_LOR:                 return "lor"
	case OP_NEG:                 return "neg"
	case OP_NOT:                 return "not"
	case OP_BITNOT:              return "bitnot"
	case OP_ALLOC:               return "alloc"
	case OP_LOAD:                return "load"
	case OP_STORE:               return "store"
	case OP_GET_FIELD_PTR:       return "get_field_ptr"
	case OP_GET_ELEM_PTR:        return "get_elem_ptr"
	case OP_BOX:                 return "box"
	case OP_MAKE:                return "make"
	case OP_MAKE_SLICE:          return "make_slice"
	case OP_DEREF:               return "deref"
	case OP_NIL_CHECK:           return "nil_check"
	case OP_REFINC:              return "refinc"
	case OP_REFDEC:              return "refdec"
	case OP_BOUNDS_CHECK:        return "bounds_check"
	case OP_DIV_CHECK:           return "div_check"
	case OP_RODATA_MSLICE:       return "rodata_mslice"
	case OP_RODATA_SLICE:        return "rodata_slice"
	case OP_RODATA_ARRAY:        return "rodata_array"
	case OP_RODATA_MSLICE_COPY:  return "rodata_mslice_copy"
	case OP_JUMP:                return "jump"
	case OP_BRANCH:              return "branch"
	case OP_RETURN:              return "return"
	case OP_PANIC:               return "panic"
	case OP_PHI:                 return "phi"
	case OP_CALL:                return "call"
	case OP_CALL_INDIRECT:       return "call_indirect"
	case OP_C_CALL:              return "c_call"
	case OP_FUNC_VALUE:          return "func_value"
	case OP_CALL_FUNC_VALUE:     return "call_func_value"
	case OP_CALL_HANDLE:         return "call_handle"
	case OP_FUNC_HANDLE:         return "func_handle"
	case OP_FUNC_VALUE_DTOR:     return "func_value_dtor"
	case OP_CAST:                return "cast"
	case OP_BIT_CAST:            return "bit_cast"
	case OP_MANAGED_TO_RAW:      return "managed_to_raw"
	case OP_STRUCT_LIT:          return "struct_lit"
	case OP_EXTRACT:             return "extract"
	case OP_IFACE_VALUE:         return "iface_value"
	case OP_CALL_IFACE_METHOD:   return "call_iface_method"
	case OP_IFACE_DTOR:          return "iface_dtor"
	case OP_IFACE_UPCAST:        return "iface_upcast"
	case OP_UNREACHABLE:         return "unreachable"
	case OP_SP_RESTORE:          return "sp_restore"
	default:                     return "unknown"
	}
}

// IsTerminator returns true if the instruction ends a basic block (jump, branch, return, panic).
func (instr @Instr) IsTerminator() bool {
	switch instr.Op {
	case OP_JUMP, OP_BRANCH, OP_RETURN, OP_PANIC, OP_UNREACHABLE:
		return true
	}
	return false
}
