package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// PeelToUnderlying peels alias, readonly, and named-distinct wrappers to
// the underlying type, so EmitSame / EmitPresent dispatch on the real
// reference kind.
func PeelToUnderlying(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else if t.Kind == types.TYP_READONLY {
			t = t.Elem
		} else if t.Kind == types.TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return t
		}
	}
	return t
}

// ============================================================
// Helpers
// ============================================================

// IsTerminator returns true if the instruction ends a basic block
// (jump, branch, return, unreachable).
func (instr @Instr) IsTerminator() bool {
	switch instr.Op {
	case iropcode.OP_JUMP, iropcode.OP_BRANCH, iropcode.OP_RETURN, iropcode.OP_UNREACHABLE,
			iropcode.OP_UNWIND_RETURN:
		return true
	}
	return false
}

// BlockIndexIn returns i with f.Blocks[i] == target (reference identity),
// or -1 if target is not a block of f.
func BlockIndexIn(f @Func, target *Block) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return i
		}
	}
	return -1
}
