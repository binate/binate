package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// IR-op emitters for control flow, SSA (phi), calls, conversions,
// struct construction/extraction, and lifetime markers. Extracted
// from ir_ops.bn so that file stays under the file-length hard cap.
// All emitters are methods on @Block; the free-function shims are
// kept for backwards compatibility during the Emit-API migration.

// ============================================================
// Control flow
// ============================================================

// EmitJump emits an unconditional branch to the target block.
func (b @Block) EmitJump(target @Block) {
	var instr @Instr = newVoidInstr(iropcode.OP_JUMP)
	instr.Block1 = target
	addInstr(b, instr)
}

// EmitBranch emits a conditional branch on cond to then/else blocks.
func (b @Block) EmitBranch(cond @Instr, thenBlk @Block, elseBlk @Block) {
	var instr @Instr = newVoidInstr(iropcode.OP_BRANCH)
	instr.Args = makeArgs1(cond)
	instr.Block1 = thenBlk
	instr.Block2 = elseBlk
	addInstr(b, instr)
}

// EmitReturn emits a return instruction with the given values.
func (b @Block) EmitReturn(vals @[]@Instr) {
	var instr @Instr = newVoidInstr(iropcode.OP_RETURN)
	instr.Args = vals
	addInstr(b, instr)
}

// EmitReturnTyped emits a return with an explicit multi-return struct type.
func (b @Block) EmitReturnTyped(vals @[]@Instr, retTyp @types.Type) {
	var instr @Instr = newVoidInstr(iropcode.OP_RETURN)
	instr.Args = vals
	instr.Typ = retTyp
	addInstr(b, instr)
}

// EmitUnreachable emits an unreachable terminator (marks dead code paths).
func (b @Block) EmitUnreachable() {
	var instr @Instr = newVoidInstr(iropcode.OP_UNREACHABLE)
	addInstr(b, instr)
}

// ============================================================
// SSA
// ============================================================

// EmitPhi emits a phi node that merges values from different predecessor blocks.
func (b @Block) EmitPhi(typ @types.Type, entries @[]PhiEntry) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_PHI, typ)
	instr.Phis = entries
	addInstr(b, instr)
	return instr
}

// ============================================================
// Calls
// ============================================================

// EmitCall emits a direct function call by name with the given arguments.
// Normalizes `name` through qualifyForCurrentModule so call sites see a
// fully-qualified name in instr.StrVal regardless of whether the caller
// passed a bare or qualified form. Backends can rely on the qualified
// form alone — no need to combine with their own modulePkgName state.
func (b @Block) EmitCall(name @[]char, args @[]@Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CALL, resultTyp)
	instr.StrVal = qualifyForPkgPath(f.ModulePkgPath, name)
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitCallLocal emits a direct call to a MODULE-LOCAL symbol by its exact
// name, WITHOUT qualifying it with the enclosing function's package.  It is
// for the synthetic weak_odr element/backing dtor & copy helpers (`__dtor_ms_*`,
// `__dtor_arr*`, and the `__copy_` twins) that ensureMsDtor / ensureArrayDtor
// emit into whatever module needs them, under that module's package.  A plain
// EmitCall would qualify the bare name with `f.ModulePkgPath` — which, for a
// cross-package GENERIC instantiation whose struct/element dtor is attributed to
// the generic's HOME package but emitted into the CONSUMER's module, is the home
// package, not the module that defines the helper.  That names a symbol no module
// emits (compiled: undefined value; VM: extern not found).  Leaving the name bare
// lets codegen mangle it with the current module's package, resolving to this
// module's weak_odr copy — where the def actually lands.
func (b @Block) EmitCallLocal(name @[]char, args @[]@Instr, resultTyp @types.Type) @Instr {
	var instr @Instr = newInstr(b.Func, iropcode.OP_CALL, resultTyp)
	instr.StrVal = name
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitCCall emits a `__c_call` to a verbatim C symbol.  Unlike EmitCall,
// the symbol is stored on StrVal WITHOUT mangling (it names a real C
// symbol like `abs`, not a mangled Binate `bn_F...` func symbol).  fixedArgs is the
// count of fixed (named) arguments; the call is variadic iff fixedArgs <
// len(args).  resultTyp is the return type (nil/void => no result).
func (b @Block) EmitCCall(symbol @[]char, args @[]@Instr, resultTyp @types.Type,
		fixedArgs int) @Instr {
	// A void return (resultTyp == nil — the "void" spelling) is genuinely
	// result-less: emit the ID -1 form so every backend's result-collection
	// skips it (the LLVM `call void` arm; the native `ins.ID < 0` guard)
	// rather than materializing a phantom result into an unallocated slot.
	var instr @Instr
	if resultTyp == nil {
		instr = newVoidInstr(iropcode.OP_C_CALL)
	} else {
		instr = newInstr(b.Func, iropcode.OP_C_CALL, resultTyp)
	}
	instr.StrVal = symbol
	instr.Args = args
	instr.CFixedArgs = fixedArgs
	addInstr(b, instr)
	return instr
}

// EmitCGlobal emits `__c_global("sym", T)` — an OP_C_GLOBAL whose result is the
// ADDRESS of the external C global `sym`, a raw *pointeeTyp.  StrVal holds the
// VERBATIM C symbol (no mangling, like EmitCCall); Typ is *T (the SSA result
// type) and TypeArg is T (the pointee, so backends can declare the external
// global / size the reference).  No Args, and the raw-pointer result is never
// registered as a managed temp (no refcount header on foreign storage).
func (b @Block) EmitCGlobal(symbol @[]char, pointeeTyp @types.Type) @Instr {
	var ptrTyp @types.Type = types.MakePointerType(pointeeTyp)
	var instr @Instr = newInstr(b.Func, iropcode.OP_C_GLOBAL, ptrTyp)
	instr.StrVal = symbol
	instr.TypeArg = pointeeTyp
	addInstr(b, instr)
	return instr
}

// EmitDataSymAddr emits an OP_DATA_SYM_ADDR whose result is the ADDRESS of a
// LOCAL Binate data global named by its already-MANGLED symbol `sym` (e.g.
// `__typeinfo.bn_…` / `__ifaceid.bn_…`), a raw *pointeeTyp.  Like EmitCGlobal it
// carries the pointee type on TypeArg (so LLVM can spell the `bitcast <T>*
// @<sym>`) and takes no Args, but the symbol is a Binate mangled name reached by
// a plain local address (not the verbatim GOT-indirect C symbol of EmitCGlobal).
// The compiled backends resolve the symbol via the linker; the VM lowers this to
// BC_DATA_SYM_ADDR, which resolves it at exec against the materialized
// data-symbol table (lookupDataSymAddr — RTTI Slice 5b).
func (b @Block) EmitDataSymAddr(sym @[]char, pointeeTyp @types.Type) @Instr {
	var ptrTyp @types.Type = types.MakePointerType(pointeeTyp)
	var instr @Instr = newInstr(b.Func, iropcode.OP_DATA_SYM_ADDR, ptrTyp)
	instr.StrVal = sym
	instr.TypeArg = pointeeTyp
	addInstr(b, instr)
	return instr
}

// EmitCallIndirect emits an indirect function call through fnPtr.
// fnPtr must have type *uint8 (the canonical raw-function-pointer type).
// The signature is reconstructed from resultTyp (return type) and the
// argument operands' types — each arg Instr carries its Typ. The result
// Instr's Args layout is `[fnPtr, args...]`.
func (b @Block) EmitCallIndirect(fnPtr @Instr, args @[]@Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CALL_INDIRECT, resultTyp)
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = fnPtr
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// EmitFuncValue emits a function-value construction op for a named
// function. resultTyp must be TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE
// (the destination's declared type, since the construction is
// type-driven). The function name is stored on StrVal — qualified
// `pkg.name` for cross-package, bare for same-package.  No Args:
// the produced value's data slot is nil (Phase 1 non-capturing
// shape).  Use EmitFuncValueWithData for capturing closures.
func (b @Block) EmitFuncValue(name @[]char, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_FUNC_VALUE, resultTyp)
	instr.StrVal = qualifyForPkgPath(f.ModulePkgPath, name)
	addInstr(b, instr)
	return instr
}

// EmitFuncValueWithData emits a function-value construction op
// whose data slot is the given pointer.  Used by capturing
// function-literal codegen — the data points at the alloca'd (or
// heap-allocated) closure struct.  The underlying function named by `name` must
// have Func.IsClosure=true so the per-shape `__shim.<mangled>`
// emitter reads the captures out of data.
func (b @Block) EmitFuncValueWithData(name @[]char, data @Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_FUNC_VALUE, resultTyp)
	instr.StrVal = qualifyForPkgPath(f.ModulePkgPath, name)
	var args @[]@Instr = make_slice(@Instr, 1)
	args[0] = data
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitFuncValueDtor emits an OP_FUNC_VALUE_DTOR that loads slot 0
// of the function value's vtable — the closure-struct dtor for an
// @func capturing closure (or null for a non-capturing literal /
// the *func form, in which case the runtime falls through to plain
// rt.Free).  Same shape as EmitIfaceDtor; the only difference is
// which slot of the 2-word value carries the vtable
// (BnFuncValue = {vtable, data} so slot 0; BnIfaceValue = {data,
// vtable} so slot 1).
func (b @Block) EmitFuncValueDtor(fv @Instr) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_FUNC_VALUE_DTOR,
			types.MakePointerType(types.TypUint8()))
	instr.Args = makeArgs1(fv)
	addInstr(b, instr)
	return instr
}

// EmitCallFuncValue emits a call through a function value. fnVal must
// be of type TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE. The Args layout
// on the resulting Instr is `[fnVal, args...]`; resultTyp is the
// return type (from fnVal.Typ.Results).
func (b @Block) EmitCallFuncValue(fnVal @Instr, args @[]@Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CALL_FUNC_VALUE, resultTyp)
	// Stamp the cross-mode aggregate retbuf size from the func value's own
	// result list (the VM dispatch can't recover it from the lowered type).
	// Peel any readonly / named-distinct wrapper to reach the func-value
	// type that carries .Results.
	var ftyp @types.Type = types.StripWrappers(fnVal.Typ)
	if ftyp != nil {
		instr.RetbufSize = types.AggregateReturnSize(ftyp.Results)
	}
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = fnVal
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// ============================================================
// Conversions
// ============================================================

// EmitCast emits a type cast (sign/zero extend, truncate).
func (b @Block) EmitCast(val @Instr, targetTyp @types.Type) @Instr {
	var f *Func = b.Func
	targetTyp = stripConstForIR(targetTyp)
	var instr @Instr = newInstr(f, iropcode.OP_CAST, targetTyp)
	instr.Args = makeArgs1(val)
	instr.TypeArg = targetTyp
	addInstr(b, instr)
	return instr
}

// EmitBitCast emits a bitwise reinterpret cast (no value change, type only).
func (b @Block) EmitBitCast(val @Instr, targetTyp @types.Type) @Instr {
	var f *Func = b.Func
	targetTyp = stripConstForIR(targetTyp)
	var instr @Instr = newInstr(f, iropcode.OP_BIT_CAST, targetTyp)
	instr.Args = makeArgs1(val)
	instr.TypeArg = targetTyp
	addInstr(b, instr)
	return instr
}

// EmitFuncHandle emits a reference to a named function's static handle
// as an i8* value.  Result points at a 16-byte {vtable_ptr, data_ptr}
// block — either the bnc-emitted static `@__handle.F` or a runtime-
// allocated heap handle (for bytecode-only functions).  Consumed by
// OP_CALL_HANDLE (`_call_free_fn` lowering).
func (b @Block) EmitFuncHandle(funcName @[]char) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_FUNC_HANDLE, types.MakePointerType(types.TypUint8()))
	instr.StrVal = qualifyForPkgPath(f.ModulePkgPath, funcName)
	addInstr(b, instr)
	return instr
}

// EmitCallHandle emits a call through a function-value handle pointer.
// handle must be a *uint8 pointing at a 16-byte {vtable_ptr, data_ptr}
// structure (the result of EmitFuncHandle).  Backends load the handle's
// vtable.call and data, then dispatch as `call(data, args)`.  Args
// layout: `[handle, user_args...]`.  resultTyp is the return type
// (use TypVoid for void-returning calls; nil also accepted as void).
func (b @Block) EmitCallHandle(handle @Instr, args @[]@Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CALL_HANDLE, resultTyp)
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = handle
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// EmitManagedToRaw converts a managed-slice (@[]T) to a raw slice (*[]T).
func (b @Block) EmitManagedToRaw(val @Instr) @Instr {
	var f *Func = b.Func
	// @[]T → *[]T: extract {data, len} prefix
	var rawTyp @types.Type = types.MakeSliceType(val.Typ.Elem)
	var instr @Instr = newInstr(f, iropcode.OP_MANAGED_TO_RAW, rawTyp)
	instr.Args = makeArgs1(val)
	addInstr(b, instr)
	return instr
}

// ============================================================
// Struct
// ============================================================

// EmitStructLit emits a struct literal value from field values.
func (b @Block) EmitStructLit(fields @[]@Instr, structTyp @types.Type) @Instr {
	var f *Func = b.Func
	structTyp = stripConstForIR(structTyp)
	var instr @Instr = newInstr(f, iropcode.OP_STRUCT_LIT, structTyp)
	instr.Args = fields
	instr.TypeArg = structTyp
	addInstr(b, instr)
	return instr
}

// EmitExtract extracts a field from a struct/multi-return value by index.
func (b @Block) EmitExtract(multi @Instr, index int, typ @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_EXTRACT, typ)
	instr.Args = makeArgs1(multi)
	instr.Index = index
	addInstr(b, instr)
	return instr
}

// ============================================================
// Lifetime
// ============================================================

// EmitSPRestore emits a statement-end marker that lets the VM
// reclaim vm.Stack temporaries pushed during the statement
// (aggregate return copy-backs, BC_MAKE_SLICE / BC_STRING_COPY*
// / BC_FUNC_VALUE pushes). No-op in the LLVM and native backends.
// Void instruction (no result, no operands).
func (b @Block) EmitSPRestore() {
	var instr @Instr = newVoidInstr(iropcode.OP_SP_RESTORE)
	addInstr(b, instr)
}
