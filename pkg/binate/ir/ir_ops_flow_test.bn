package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Smoke tests for the @Block emitters defined in ir_ops_flow.bn
// (control flow, SSA, calls, conversions, struct, lifetime).
// Broader coverage of these emitters lives in ir_ops_test.bn and
// the gen_*_test.bn suites; this file exists primarily to satisfy
// the per-file test-coverage check after the ir_ops.bn split.

func TestFlowEmitJumpMethod() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var target @Block = AddBlock(f, "target")
	entry.EmitJump(target)
	if len(entry.Instrs) != 1 { return fail("expected 1 instr") }
	if entry.Instrs[0].Op != iropcode.OP_JUMP { return fail("op should be iropcode.OP_JUMP") }
	return ""
}

func TestFlowEmitReturnMethod() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	if b.Instrs[0].Op != iropcode.OP_RETURN { return fail("op should be iropcode.OP_RETURN") }
	if !b.Instrs[0].IsTerminator() { return fail("return should be terminator") }
	return ""
}

func TestFlowEmitCallMethod() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var c @Instr = b.EmitCall("callee", noArgs, types.TypInt())
	if c.Op != iropcode.OP_CALL { return fail("op should be iropcode.OP_CALL") }
	return ""
}

// EmitDataSymAddr produces an OP_DATA_SYM_ADDR carrying the mangled symbol on
// StrVal and the pointee on TypeArg (like OP_C_GLOBAL), with no Args and a
// pointer result type.
func TestEmitDataSymAddrShape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var g @Instr = b.EmitDataSymAddr("__typeinfo.bn_test", types.TypUint8())
	if g.Op != iropcode.OP_DATA_SYM_ADDR { return fail("op should be OP_DATA_SYM_ADDR") }
	if !seq(g.StrVal, "__typeinfo.bn_test") { return fail("mangled symbol must ride StrVal") }
	if g.TypeArg == nil { return fail("pointee type must ride TypeArg") }
	if len(g.Args) != 0 { return fail("OP_DATA_SYM_ADDR takes no Args") }
	if g.Typ == nil { return fail("result type must be the *pointee pointer") }
	return ""
}
