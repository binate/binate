package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Interface-value ops (OP_IFACE_VALUE / OP_CALL_IFACE_METHOD /
// OP_IFACE_DTOR). Split out of ir_ops.bn alongside Slice 2.5b so
// that file stays close to its soft length limit.
// ============================================================

// EmitIfaceValue emits an interface-value construction. dataPtr is
// the source pointer being placed in the data slot (raw or managed —
// the IR layer treats it as i8*-shaped; codegen bitcasts to i8* at
// the construction site). vtableName is the mangled name of the
// `@__ivt.<...>` global selected at type-check time. resultTyp is
// TYP_INTERFACE_VALUE or TYP_INTERFACE_VALUE_MANAGED. Slice 2.3a-2
// of plan-interface-syntax-revision.md.
//
// An EMPTY vtableName selects the DYNAMIC-vtable form instead (the
// vtable comes from a runtime register operand, Args[1]); that form
// is built via EmitIfaceValueDyn — this static helper always sets a
// non-empty StrVal and a 1-element Args.
func (b @Block) EmitIfaceValue(dataPtr @Instr, vtableName @[]char, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_IFACE_VALUE, resultTyp)
	instr.StrVal = vtableName
	var args @[]@Instr = make_slice(@Instr, 1)
	args[0] = dataPtr
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitIfaceValueDyn emits an interface-value construction whose vtable
// is a RUNTIME value in a register, not a static `@__ivt.<...>` symbol.
// It is the same OP_IFACE_VALUE op as EmitIfaceValue, but with StrVal
// left EMPTY: an empty StrVal is what selects the dynamic-vtable form,
// where Args[1] holds the runtime vtable pointer (Args = [data, vtable]).
// Used by interface-assertion recovery (RTTI Slice 5), where the vtable
// to install is recovered from the satisfaction registry at runtime
// rather than known at type-check time. NATIVE BACKENDS ONLY for now —
// the bytecode VM fails loud on the dynamic form (see vm/lower_call.bn).
func (b @Block) EmitIfaceValueDyn(dataPtr @Instr, vtablePtr @Instr, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_IFACE_VALUE, resultTyp)
	// StrVal left EMPTY => dynamic vtable from Args[1]; Args = [data, vtable].
	var args @[]@Instr = make_slice(@Instr, 2)
	args[0] = dataPtr
	args[1] = vtablePtr
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitCallIfaceMethod emits an interface method dispatch. iv must be
// of type TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED.
// methodIdx is the 0-based slot in the interface's method-declaration
// order; resultTyp is the method's return type (TypVoid for void).
// Args layout on the resulting Instr: `[iv, args...]` — same shape
// as EmitCallFuncValue for symmetry. Slice 2.3a-3 of
// plan-interface-syntax-revision.md.
func (b @Block) EmitCallIfaceMethod(iv @Instr, args @[]@Instr, methodIdx int,
		resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_CALL_IFACE_METHOD, resultTyp)
	instr.Index = methodIdx
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = iv
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// EmitIfaceDtor emits an OP_IFACE_DTOR that loads slot 0 of iv's
// vtable — the receiver type's struct destructor (or null / 0 if
// the type has no dtor). The result is a *uint8, matching
// EmitFuncHandle's shape, so it can be passed straight to
// EmitRefDecDtor for @Iface scope-exit cleanup. Slice 2.5b of
// plan-interface-syntax-revision.md.
func (b @Block) EmitIfaceDtor(iv @Instr) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_IFACE_DTOR, types.MakePointerType(types.TypUint8()))
	instr.Args = makeArgs1(iv)
	addInstr(b, instr)
	return instr
}

// EmitIfaceUpcast emits an OP_IFACE_UPCAST that rebuilds an
// interface value with the source's data ptr and the target
// interface's vtable.  Used to lower `*Child → *Parent` /
// `@Child → @Parent` upcasts (plan-interface-embedding.md Slice
// E.4 part 2b).  targetVtableName names the `__ivt.<...>` global
// that the receiver type's transitive impl emission (Slice E.3)
// guarantees exists for every reachable ancestor.  resultTyp is
// TYP_INTERFACE_VALUE or TYP_INTERFACE_VALUE_MANAGED of the
// target interface.
func (b @Block) EmitIfaceUpcast(m @Module, src @Instr, targetVtableName @[]char,
		resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_IFACE_UPCAST, resultTyp)
	instr.StrVal = targetVtableName
	instr.Args = makeArgs1(src)
	// Precompute the parent-interface vtable slot offset here, while the
	// interface registry is in hand, so the compiled backends can read it
	// off the instr instead of querying the registry at emit time (their
	// per-instruction emitters carry no module).  Read instr.Typ.Elem (the
	// const-stripped result type newInstr stored), NOT the raw resultTyp:
	// that is exactly the type the backends used to read, so the offset is
	// identical even if a future caller passes a const/alias-wrapped result
	// type.  -1 (invalid upcast) flows through to the backends' abort check.
	// Equivalence relies on m's interface registry being complete here:
	// EmitIfaceUpcast runs during GeneratePackage, by which point m's own +
	// imported interfaces are registered (each module carries its own
	// m.Interfaces), and lazy generic-iface instantiation only appends — so
	// the ancestor chain an upcast sees at lower time matches what the backend
	// saw at emit.
	instr.IfaceUpcastSlotOffset = 0
	if src.Typ != nil && src.Typ.Elem != nil && instr.Typ != nil && instr.Typ.Elem != nil {
		instr.IfaceUpcastSlotOffset = IfaceParentSlotOffset(m, src.Typ.Elem.Pkg, src.Typ.Elem.Name,
				instr.Typ.Elem.Pkg, instr.Typ.Elem.Name)
	}
	addInstr(b, instr)
	return instr
}
