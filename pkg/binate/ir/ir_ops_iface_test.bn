package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the leaf op-emitters in ir_ops_iface.bn. End-to-end
// type-check + IR-gen for these ops is exercised by the iface
// conformance tests (354+) and by gen_impl_test.bn; these unit
// tests pin the op-shape produced by each Emit* helper.

func TestEmitIfaceValueOpShape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var dataPtr @Instr = b.EmitConstInt(0, types.TypInt())
	var iv @Instr = b.EmitIfaceValue(dataPtr, "vt", types.MakeInterfaceValueType(nil))
	if iv.Op != iropcode.OP_IFACE_VALUE { return fail("op wrong") }
	if len(iv.Args) != 1 { return fail("expected 1 arg (data)") }
	if iv.Args[0] != dataPtr { return fail("data arg wrong") }
	if !seq(iv.StrVal, "vt") {
		return fail("vtable name not preserved on StrVal")
	}
	return ""
}

// EmitIfaceValueDyn yields the SAME OP_IFACE_VALUE op as EmitIfaceValue, but
// selects the dynamic-vtable form: StrVal is left EMPTY (that empty StrVal is
// what backends read to take the vtable from a register), and Args carries
// [data, vtable] (len 2) instead of [data] (len 1).  Used by interface-
// assertion recovery (RTTI Slice 5).
func TestEmitIfaceValueDynOpShape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var dataPtr @Instr = b.EmitConstInt(0, types.TypInt())
	var vtablePtr @Instr = b.EmitConstInt(1, types.TypInt())
	var iv @Instr = b.EmitIfaceValueDyn(dataPtr, vtablePtr, types.MakeInterfaceValueType(nil))
	if iv.Op != iropcode.OP_IFACE_VALUE { return fail("op wrong") }
	if len(iv.StrVal) != 0 {
		return fail("dynamic form must leave StrVal EMPTY (that selects the register vtable)")
	}
	if len(iv.Args) != 2 { return fail("expected 2 args (data, vtable)") }
	if iv.Args[0] != dataPtr { return fail("data must be Args[0]") }
	if iv.Args[1] != vtablePtr { return fail("vtable must be Args[1]") }
	return ""
}

func TestEmitCallIfaceMethodOpShape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var dataPtr @Instr = b.EmitConstInt(0, types.TypInt())
	var iv @Instr = b.EmitIfaceValue(dataPtr, "vt", types.MakeInterfaceValueType(nil))
	var arg @Instr = b.EmitConstInt(7, types.TypInt())
	var callArgs @[]@Instr = make_slice(@Instr, 1)
	callArgs[0] = arg
	var call @Instr = b.EmitCallIfaceMethod(iv, callArgs, 2, types.TypInt())
	if call.Op != iropcode.OP_CALL_IFACE_METHOD { return fail("op wrong") }
	if call.Index != 2 {
		return fail("method-slot index not preserved on Index")
	}
	if len(call.Args) != 2 { return fail("expected [iv, arg] args") }
	if call.Args[0] != iv { return fail("iv must be Args[0]") }
	if call.Args[1] != arg { return fail("user arg must be Args[1]") }
	return ""
}

func TestEmitIfaceDtorOpShape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var dataPtr @Instr = b.EmitConstInt(0, types.TypInt())
	var iv @Instr = b.EmitIfaceValue(dataPtr, "vt", types.MakeManagedInterfaceValueType(nil))
	var dtor @Instr = b.EmitIfaceDtor(iv)
	if dtor.Op != iropcode.OP_IFACE_DTOR { return fail("op wrong") }
	if len(dtor.Args) != 1 { return fail("expected 1 arg (iv)") }
	if dtor.Args[0] != iv { return fail("iv must be Args[0]") }
	if dtor.Typ == nil || dtor.Typ.Kind != types.TYP_POINTER {
		return fail("dtor result must be a pointer (i8*)")
	}
	return ""
}
