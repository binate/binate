package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Managed pointers
// ============================================================

// EmitBox emits a box instruction that wraps a value into a managed pointer.
func (b @Block) EmitBox(val @Instr, ptrTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_BOX, ptrTyp)
	instr.Args = makeArgs1(val)
	addInstr(b, instr)
	return instr
}

// EmitMake emits a make instruction that allocates a managed struct (@T).
func (b @Block) EmitMake(typ @types.Type) @Instr {
	var f *Func = b.Func
	typ = stripConstForIR(typ)
	var instr @Instr = newInstr(f, iropcode.OP_MAKE, types.MakeManagedPtrType(typ))
	instr.TypeArg = typ
	addInstr(b, instr)
	return instr
}

// EmitMakeSlice emits a make_slice instruction that allocates a managed-slice (@[]T).
func (b @Block) EmitMakeSlice(elemTyp @types.Type, length @Instr) @Instr {
	var f *Func = b.Func
	elemTyp = stripConstForIR(elemTyp)
	var msTyp @types.Type = types.MakeManagedSliceType(elemTyp)
	var instr @Instr = newInstr(f, iropcode.OP_MAKE_SLICE, msTyp)
	instr.TypeArg = elemTyp
	instr.Args = makeArgs1(length)
	addInstr(b, instr)
	return instr
}

// EmitDeref emits a managed pointer dereference, producing the pointee value.
func (b @Block) EmitDeref(ptr @Instr, elemTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, iropcode.OP_DEREF, elemTyp)
	instr.Args = makeArgs1(ptr)
	addInstr(b, instr)
	return instr
}

// EmitNilCheck emits a nil-check op (OP_NIL_CHECK) that traps if the pointer is nil.
// In the VM a nil pointer raises a RECOVERABLE user-code fault (Plan 2); compiled code
// treats it as a no-op (opt-in nil-checking is a VM/REPL recovery aid).  Emitted before
// a deref only when nil-checking is enabled (GenCtx.EmitNilChecks).  Returns the
// check instr so a caller can tag it with a cleanup pad (attachFaultPad).
func (b @Block) EmitNilCheck(ptr @Instr) @Instr {
	var instr @Instr = newVoidInstr(iropcode.OP_NIL_CHECK)
	instr.Args = makeArgs1(ptr)
	addInstr(b, instr)
	return instr
}

// EmitRefInc emits an inline reference count increment (OP_REFINC) for
// a managed pointer. Backends lower it to an inline nil-check + header
// load/add/store (no rt.RefInc call).
func (b @Block) EmitRefInc(ptr @Instr) {
	var instr @Instr = newVoidInstr(iropcode.OP_REFINC)
	instr.Args = makeArgs1(ptr)
	addInstr(b, instr)
}

// EmitRefDec emits an inline-fast-path refcount decrement (OP_REFDEC)
// for a managed pointer with no destructor. Backends lower the fast
// path inline (nil-check + header load/sub/store); on refcount zero
// they call rt.ZeroRefDestroy(ptr, null).
func (b @Block) EmitRefDec(ptr @Instr) {
	var instr @Instr = newVoidInstr(iropcode.OP_REFDEC)
	instr.Args = makeArgs1(ptr)
	addInstr(b, instr)
}

// EmitRefDecDtor emits an inline-fast-path refcount decrement (OP_REFDEC)
// that calls dtor on free. Same lowering shape as EmitRefDec, but the
// slow-path call is rt.ZeroRefDestroy(ptr, dtor).
func (b @Block) EmitRefDecDtor(ptr @Instr, dtor @Instr) {
	var instr @Instr = newVoidInstr(iropcode.OP_REFDEC)
	instr.Args = makeArgs2(ptr, dtor)
	addInstr(b, instr)
}
