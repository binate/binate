package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Control flow tests
// ============================================================

func TestEmitJump() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b1 @Block = AddBlock(f, "entry")
	var b2 @Block = AddBlock(f, "next")
	b1.EmitJump(b2)
	if len(b1.Instrs) != 1 { return fail("expected 1 instr") }
	if b1.Instrs[0].Op != OP_JUMP { return fail("op wrong") }
	return ""
}

func TestEmitBranch() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var thenBlk @Block = AddBlock(f, "then")
	var elseBlk @Block = AddBlock(f, "else")
	var cond @Instr = entry.EmitConstBool(true)
	entry.EmitBranch(cond, thenBlk, elseBlk)
	var br @Instr = entry.Instrs[1]
	if br.Op != OP_BRANCH { return fail("op wrong") }
	if len(br.Args) != 1 { return fail("expected 1 arg (cond)") }
	return ""
}

func TestEmitReturn() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var val @Instr = b.EmitConstInt(0, types.TypInt())
	var retArgs @[]@Instr = make_slice(@Instr, 1)
	retArgs[0] = val
	b.EmitReturn(retArgs)
	if b.Instrs[1].Op != OP_RETURN { return fail("op wrong") }
	return ""
}

func TestEmitReturnVoid() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	if b.Instrs[0].Op != OP_RETURN { return fail("op wrong") }
	if len(b.Instrs[0].Args) != 0 { return fail("void return should have no args") }
	return ""
}

// ============================================================
// Call tests
// ============================================================

func TestEmitCall() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var arg @Instr = b.EmitConstInt(1, types.TypInt())
	var callArgs @[]@Instr = make_slice(@Instr, 1)
	callArgs[0] = arg
	var result @Instr = b.EmitCall("add", callArgs, types.TypInt())
	if result.Op != OP_CALL { return fail("op wrong") }
	if len(result.Args) != 1 { return fail("expected 1 arg") }
	return ""
}

func TestEmitCallIndirect() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @Instr = b.EmitConstNil(rawPtrTyp)
	var arg @Instr = b.EmitConstInt(42, types.TypInt())
	var callArgs @[]@Instr = make_slice(@Instr, 1)
	callArgs[0] = arg
	var result @Instr = b.EmitCallIndirect(fnPtr, callArgs, types.TypInt())
	if result.Op != OP_CALL_INDIRECT { return fail("op wrong") }
	if len(result.Args) != 2 { return fail("expected 2 args (fnPtr + 1 call arg)") }
	if result.Args[0].ID != fnPtr.ID { return fail("Args[0] should be fnPtr") }
	if result.Args[1].ID != arg.ID { return fail("Args[1] should be call arg") }
	return ""
}

func TestEmitCallIndirectVoid() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @Instr = b.EmitConstNil(rawPtrTyp)
	var result @Instr = b.EmitCallIndirect(fnPtr, noArgs, types.TypVoid())
	if result.Op != OP_CALL_INDIRECT { return fail("op wrong") }
	if len(result.Args) != 1 { return fail("expected just fnPtr arg") }
	if result.Typ == nil || result.Typ.Kind != types.TYP_VOID {
		return fail("expected void return type")
	}
	return ""
}

// ============================================================
// Helper tests
// ============================================================

func TestOpName() testing.TestResult {
	if !seq(OpName(OP_ADD), "add") { return fail("add wrong") }
	if !seq(OpName(OP_RETURN), "return") { return fail("return wrong") }
	if !seq(OpName(OP_CALL), "call") { return fail("call wrong") }
	if !seq(OpName(OP_CALL_INDIRECT), "call_indirect") { return fail("call_indirect wrong") }
	if !seq(OpName(OP_CONST_INT), "const_int") { return fail("const_int wrong") }
	if !seq(OpName(OP_REFINC), "refinc") { return fail("refinc wrong") }
	if !seq(OpName(OP_REFDEC), "refdec") { return fail("refdec wrong") }
	if !seq(OpName(OP_SP_RESTORE), "sp_restore") { return fail("sp_restore wrong") }
	if !seq(OpName(999), "unknown") { return fail("unknown wrong") }
	return ""
}

// EmitSPRestore appends a void OP_SP_RESTORE instruction to the
// block. No operands, no result type — backends interpret it as a
// statement-end marker (VM resets vm.SP back to frame end; LLVM and
// native are no-ops). Bytecode-VM-side coverage lives with the
// lowering and execLoop arm in pkg/vm.
func TestEmitSPRestore() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitSPRestore()
	if len(b.Instrs) != 1 { return fail("expected 1 instr in block") }
	var instr @Instr = b.Instrs[0]
	if instr.Op != OP_SP_RESTORE { return fail("op should be OP_SP_RESTORE") }
	if instr.ID != -1 { return fail("OP_SP_RESTORE should be void (ID == -1)") }
	if len(instr.Args) != 0 { return fail("OP_SP_RESTORE should have no args") }
	if instr.IsTerminator() { return fail("OP_SP_RESTORE should NOT be a terminator") }
	return ""
}

func TestIsTerminator() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var val @Instr = b.EmitConstInt(0, types.TypInt())
	if val.IsTerminator() { return fail("const should not be terminator") }
	b.EmitReturn(noArgs)
	if !b.Instrs[1].IsTerminator() { return fail("return should be terminator") }
	return ""
}

// ============================================================
// Slice tests
// ============================================================

func TestEmitSliceOps() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @Instr = b.EmitConstNil(sliceTyp)
	var slen @Instr = b.EmitSliceLen(s)
	if slen.Op != OP_EXTRACT { return fail("len should lower to extract") }
	var idx @Instr = b.EmitConstInt(0, types.TypInt())
	var elem @Instr = b.EmitSliceGet(s, idx, types.TypInt())
	// EmitSliceGet now lowers to extract + GEP + load
	if elem.Op != OP_LOAD { return fail("get should lower to load") }
	return ""
}

func TestEmitSliceSet() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @Instr = b.EmitConstNil(sliceTyp)
	var idx @Instr = b.EmitConstInt(0, types.TypInt())
	var val @Instr = b.EmitConstInt(42, types.TypInt())
	b.EmitSliceSet(s, idx, val, types.TypInt())
	// Should lower to: extract(0) + get_elem_ptr + store
	var extract @Instr = b.Instrs[3]
	if extract.Op != OP_EXTRACT { return fail("expected extract for data ptr") }
	var gep @Instr = b.Instrs[4]
	if gep.Op != OP_GET_ELEM_PTR { return fail("expected GEP") }
	var store @Instr = b.Instrs[5]
	if store.Op != OP_STORE { return fail("expected store") }
	return ""
}

func TestEmitSliceExpr() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @Instr = b.EmitConstNil(sliceTyp)
	var lo @Instr = b.EmitConstInt(1, types.TypInt())
	var hi @Instr = b.EmitConstInt(5, types.TypInt())
	var se @Instr = b.EmitSliceExpr(s, lo, hi, sliceTyp)
	// EmitSliceExpr now lowers to extract + GEP + sub + alloca + stores + load
	if se.Op != OP_LOAD { return fail("slice_expr should lower to load") }
	return ""
}

func TestEmitBoundsCheck() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var idx @Instr = b.EmitConstInt(3, types.TypInt())
	var length @Instr = b.EmitConstInt(10, types.TypInt())
	b.EmitBoundsCheck(idx, length)
	var bc @Instr = b.Instrs[2]
	if bc.Op != OP_BOUNDS_CHECK { return fail("op wrong") }
	if bc.ID != -1 { return fail("bounds_check should be void") }
	if len(bc.Args) != 2 { return fail("expected 2 args") }
	return ""
}

func TestEmitSliceElemPtr() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @Instr = b.EmitConstNil(sliceTyp)
	var idx @Instr = b.EmitConstInt(0, types.TypInt())
	var ep @Instr = b.EmitSliceElemPtr(s, idx, types.TypInt())
	// EmitSliceElemPtr now lowers to extract + GEP
	if ep.Op != OP_GET_ELEM_PTR { return fail("should lower to GEP") }
	return ""
}

// ============================================================
// String conversion tests
// ============================================================

// Phase 3.3: EmitStringToArray was deleted; OP_RODATA_ARRAY is the
// op for string→[N]char and is constructed via EmitRodataArray.
func TestEmitRodataArray() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var arrayTyp @types.Type = types.MakeArrayType(types.TypChar(), 5)
	var ra @Instr = b.EmitRodataArray("hello", arrayTyp)
	if ra.Op != OP_RODATA_ARRAY { return fail("op wrong") }
	if len(ra.StrVal) != 5 { return fail("expected 5 bytes on StrVal") }
	return ""
}

// ============================================================
// Conversion tests
// ============================================================

func TestEmitCast() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var val @Instr = b.EmitConstInt(65, types.TypInt())
	var casted @Instr = b.EmitCast(val, types.TypUint8())
	if casted.Op != OP_CAST { return fail("op wrong") }
	return ""
}

func TestEmitBitCast() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var val @Instr = b.EmitConstInt(42, types.TypInt())
	var bc @Instr = b.EmitBitCast(val, types.TypUint64())
	if bc.Op != OP_BIT_CAST { return fail("op wrong") }
	if len(bc.Args) != 1 { return fail("expected 1 arg") }
	if bc.TypeArg == nil { return fail("TypeArg should not be nil") }
	return ""
}

// ============================================================
// Struct tests
// ============================================================

func TestEmitStructLit() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var structTyp @types.Type = types.TypInt() // placeholder
	var f1 @Instr = b.EmitConstInt(10, types.TypInt())
	var f2 @Instr = b.EmitConstInt(20, types.TypInt())
	var fields @[]@Instr = make_slice(@Instr, 2)
	fields[0] = f1
	fields[1] = f2
	var lit @Instr = b.EmitStructLit(fields, structTyp)
	if lit.Op != OP_STRUCT_LIT { return fail("op wrong") }
	if len(lit.Args) != 2 { return fail("expected 2 fields") }
	return ""
}

func TestEmitExtract() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var multi @Instr = b.EmitCall("multi_ret", noArgs, types.TypInt())
	var extracted @Instr = b.EmitExtract(multi, 0, types.TypInt())
	if extracted.Op != OP_EXTRACT { return fail("op wrong") }
	if extracted.Index != 0 { return fail("index wrong") }
	return ""
}

// ============================================================
// SSA / Phi tests
// ============================================================

func TestEmitPhi() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b1 @Block = AddBlock(f, "left")
	var b2 @Block = AddBlock(f, "right")
	var merge @Block = AddBlock(f, "merge")
	var val1 @Instr = b1.EmitConstInt(1, types.TypInt())
	var val2 @Instr = b2.EmitConstInt(2, types.TypInt())
	var pe1 PhiEntry
	pe1.Block = b1
	pe1.Val = val1
	var pe2 PhiEntry
	pe2.Block = b2
	pe2.Val = val2
	var phiEntries @[]PhiEntry = make_slice(PhiEntry, 2)
	phiEntries[0] = pe1
	phiEntries[1] = pe2
	var phi @Instr = merge.EmitPhi(types.TypInt(), phiEntries)
	if phi.Op != OP_PHI { return fail("op wrong") }
	if len(phi.Phis) != 2 { return fail("expected 2 phi entries") }
	return ""
}

// ============================================================
// Panic / Unreachable tests
// ============================================================

func TestEmitPanic() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var msg @Instr = b.EmitConstString("oops")
	b.EmitPanic(msg)
	var p @Instr = b.Instrs[1]
	if p.Op != OP_PANIC { return fail("op wrong") }
	if p.ID != -1 { return fail("panic should be void") }
	if !p.IsTerminator() { return fail("panic should be terminator") }
	return ""
}

func TestEmitUnreachable() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitUnreachable()
	var u @Instr = b.Instrs[0]
	if u.Op != OP_UNREACHABLE { return fail("op wrong") }
	if u.ID != -1 { return fail("unreachable should be void") }
	if !u.IsTerminator() { return fail("unreachable should be terminator") }
	return ""
}
