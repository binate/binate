package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for EliminatePhis (ir_phi_elim.bn) — the shared SSA-destruction pass.

func blockHasPhi(b @Block) bool {
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == iropcode.OP_PHI {
			return true
		}
	}
	return false
}

// blockHasCopyTo reports whether b contains an OP_COPY writing dstID from srcID.
func blockHasCopyTo(b @Block, dstID int, srcID int) bool {
	for i := 0; i < len(b.Instrs); i++ {
		var ins @Instr = b.Instrs[i]
		if ins.Op == iropcode.OP_COPY && ins.ID == dstID && len(ins.Args) == 1 &&
				ins.Args[0].ID == srcID {
			return true
		}
	}
	return false
}

func twoEntries(b1 @Block, v1 @Instr, b2 @Block, v2 @Instr) @[]PhiEntry {
	var pe1 PhiEntry
	pe1.Block = b1
	pe1.Val = v1
	var pe2 PhiEntry
	pe2.Block = b2
	pe2.Val = v2
	var es @[]PhiEntry = make_slice(PhiEntry, 2)
	es[0] = pe1
	es[1] = pe2
	return es
}

func oneRet(v @Instr) @[]@Instr {
	var r @[]@Instr = make_slice(@Instr, 1)
	r[0] = v
	return r
}

// A diamond: the merge's phi becomes a copy at the end of each arm (neither arm is
// a critical edge — each has a single successor — so no blocks are split).
func TestEliminatePhisDiamond() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var thenB @Block = AddBlock(f, "then")
	var elseB @Block = AddBlock(f, "else")
	var merge @Block = AddBlock(f, "merge")
	var cond @Instr = entry.EmitConstBool(true)
	entry.EmitBranch(cond, thenB, elseB)
	var a @Instr = thenB.EmitConstInt(10, types.TypInt())
	thenB.EmitJump(merge)
	var b @Instr = elseB.EmitConstInt(20, types.TypInt())
	elseB.EmitJump(merge)
	var phi @Instr = merge.EmitPhi(types.TypInt(), twoEntries(thenB, a, elseB, b))
	merge.EmitReturn(oneRet(phi))

	var phiID int = phi.ID
	EliminatePhis(f)

	if blockHasPhi(merge) {
		return fail("merge should have no phi after elimination")
	}
	if !blockHasCopyTo(thenB, phiID, a.ID) {
		return fail("then should copy a into the phi id")
	}
	if !blockHasCopyTo(elseB, phiID, b.ID) {
		return fail("else should copy b into the phi id")
	}
	if len(f.Blocks) != 4 {
		return fail("a diamond has no critical edges — expected no split blocks")
	}
	// Idempotent: a second run finds no phis and changes nothing.
	EliminatePhis(f)
	if len(f.Blocks) != 4 {
		return fail("second EliminatePhis run must be a no-op")
	}
	return ""
}

// Two mutually-referential loop-header phis (a<-b, b<-a on the back-edge) — the
// classic swap.  Naive sequential copies would clobber; EliminatePhis must break
// the cycle with a temp.  Simulate the latch's emitted copies on a register file
// and assert the values genuinely swap.
func TestEliminatePhisSwap() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var pre @Block = AddBlock(f, "pre")
	var header @Block = AddBlock(f, "header")
	var latch @Block = AddBlock(f, "latch")
	var exit @Block = AddBlock(f, "exit")

	var a0 @Instr = pre.EmitConstInt(1, types.TypInt())
	var b0 @Instr = pre.EmitConstInt(2, types.TypInt())
	pre.EmitJump(header)

	// Build both phis with a placeholder pre-only entry, then set the real 2-entry
	// lists that reference each other on the latch edge.
	var phiA @Instr = header.EmitPhi(types.TypInt(), twoEntries(pre, a0, pre, a0))
	var phiB @Instr = header.EmitPhi(types.TypInt(), twoEntries(pre, b0, pre, b0))
	phiA.Phis = twoEntries(pre, a0, latch, phiB) // a := b on the back-edge
	phiB.Phis = twoEntries(pre, b0, latch, phiA) // b := a on the back-edge

	var cond @Instr = header.EmitConstBool(true)
	header.EmitBranch(cond, latch, exit)
	latch.EmitJump(header)
	exit.EmitReturn(oneRet(phiA))

	var idA int = phiA.ID
	var idB int = phiB.ID
	EliminatePhis(f)

	if blockHasPhi(header) {
		return fail("header should have no phi after elimination")
	}
	// Simulate latch's copies (the swap) on a register file: id -> value.
	var regs @[]int = make_slice(int, f.NextID)
	regs[idA] = 100
	regs[idB] = 200
	for i := 0; i < len(latch.Instrs); i++ {
		var ins @Instr = latch.Instrs[i]
		if ins.Op == iropcode.OP_COPY {
			regs[ins.ID] = regs[ins.Args[0].ID]
		}
	}
	if regs[idA] != 200 {
		return fail("swap lost: phiA should hold phiB's old value (200)")
	}
	if regs[idB] != 100 {
		return fail("swap lost: phiB should hold phiA's old value (100)")
	}
	return ""
}

// A critical edge (a conditional-branch predecessor into a multi-predecessor merge)
// must be split: the copy goes in a new block on the edge, not at the branch's end.
func TestEliminatePhisCriticalEdge() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var p @Block = AddBlock(f, "p")
	var q @Block = AddBlock(f, "q")
	var merge @Block = AddBlock(f, "merge")
	var c @Block = AddBlock(f, "c")

	var cond @Instr = p.EmitConstBool(true)
	var pv @Instr = p.EmitConstInt(1, types.TypInt())
	p.EmitBranch(cond, merge, c) // p -> merge is the critical edge (merge has 2 preds)
	var qv @Instr = q.EmitConstInt(2, types.TypInt())
	q.EmitJump(merge)
	c.EmitReturn(make_slice(@Instr, 0))
	var phi @Instr = merge.EmitPhi(types.TypInt(), twoEntries(p, pv, q, qv))
	merge.EmitReturn(oneRet(phi))

	var phiID int = phi.ID
	var pTerm @Instr = p.Instrs[len(p.Instrs) - 1]
	EliminatePhis(f)

	if len(f.Blocks) != 5 {
		return fail("the critical p->merge edge should add exactly one split block")
	}
	if pTerm.Block1 == merge {
		return fail("p's branch to merge should be redirected to the split block")
	}
	if pTerm.Block2 != c {
		return fail("p's non-critical edge to c must be unchanged")
	}
	// The split block (the new one) holds the copy + a jump to merge.
	var split @Block = pTerm.Block1
	if !blockHasCopyTo(split, phiID, pv.ID) {
		return fail("the split block should copy pv into the phi id")
	}
	var splitTerm @Instr = split.Instrs[len(split.Instrs) - 1]
	if splitTerm.Op != iropcode.OP_JUMP || splitTerm.Block1 != merge {
		return fail("the split block should jump to merge")
	}
	// q -> merge is NOT critical (q ends in a jump) — copy spliced into q.
	if !blockHasCopyTo(q, phiID, qv.ID) {
		return fail("q should copy qv into the phi id (non-critical edge)")
	}
	return ""
}

// A function with no phis is left untouched.
func TestEliminatePhisNoPhiNoop() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var v @Instr = entry.EmitConstInt(5, types.TypInt())
	entry.EmitReturn(oneRet(v))
	var nInstrs int = len(entry.Instrs)
	var nBlocks int = len(f.Blocks)
	EliminatePhis(f)
	if len(f.Blocks) != nBlocks {
		return fail("no-phi function: block count must be unchanged")
	}
	if len(entry.Instrs) != nInstrs {
		return fail("no-phi function: instruction count must be unchanged")
	}
	return ""
}
