// ============================================================
// TestCallSelectorManaged — genSelector handles call().Field on @Struct result
// ============================================================

func TestCallSelectorManaged() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Inner struct { Val int }\n")
	src = concatChars(src, "func getInner() @Inner {\n")
	src = concatChars(src, "\tvar x @Inner = make(Inner)\n")
	src = concatChars(src, "\tx.Val = 42\n\treturn x\n}\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "\tvar n int = getInner().Val\n")
	src = concatChars(src, "\tprintln(n)\n}\n")
	var m @Module = genFromSource(src)
	// Find the main function
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "main.main") {
			mainFn = m.Funcs[i]
		}
	}
	if mainFn == nil { return fail("main func not found") }
	// Should have a CALL instruction for getInner()
	var callInstr @Instr = findOp(mainFn, OP_CALL)
	if callInstr == nil { return fail("expected OP_CALL for getInner()") }
	// Should have a GET_FIELD_PTR to access .Val
	var gfp @Instr = findOp(mainFn, OP_GET_FIELD_PTR)
	if gfp == nil { return fail("expected OP_GET_FIELD_PTR for .Val access") }
	return ""
}

// ============================================================
// Destructor generation tests
// ============================================================

func TestDtorGeneratedForStructWithManagedField() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Node struct { Val int\n Next @Node }\n")
	src = concatChars(src, "func main() { var n @Node = make(Node) }\n")
	var m @Module = genFromSource(src)
	var dtorFn @Func = findFunc(m, "__dtor_Node")
	if dtorFn == nil { return fail("expected __dtor_Node function") }
	// Dtor should have 1 parameter (ptr *uint8)
	if len(dtorFn.Params) != 1 { return fail("dtor should have 1 param") }
	// Dtor should contain OP_REFDEC for the @Node field
	var decCount int = countOp(dtorFn, OP_REFDEC)
	if decCount < 1 { return fail("dtor should have at least 1 OP_REFDEC") }
	// Dtor should contain OP_BIT_CAST (ptr → *Node)
	var castCount int = countOp(dtorFn, OP_BIT_CAST)
	if castCount < 1 { return fail("dtor should have OP_BIT_CAST") }
	return ""
}

func TestDtorNotGeneratedForPlainStruct() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Point struct { X int\n Y int }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	var dtorFn @Func = findFunc(m, "__dtor_Point")
	if dtorFn != nil { return fail("plain struct should not have a dtor") }
	return ""
}

func TestDtorForStructWithManagedSlice() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Container struct { Items @[]int }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	var dtorFn @Func = findFunc(m, "__dtor_Container")
	if dtorFn == nil { return fail("expected __dtor_Container function") }
	// Should have OP_REFDEC for the managed-slice backing
	var decCount int = countOp(dtorFn, OP_REFDEC)
	if decCount < 1 { return fail("dtor should RefDec the managed-slice backing") }
	return ""
}

func TestDtorSelfRefPassesDtor() testing.TestResult {
	// A struct with @Node field should pass __dtor_Node as dtor arg.
	// emitManagedPtrRefDec emits the dtor via EmitFuncHandle —
	// handle-pointer end-to-end (Phase 4 of
	// plan-uniform-native-fnptrs.md).  Native lowers to
	// `&__handle.F`; bytecode lowers to BC_FUNC_HANDLE, returning a
	// pointer to the function's 16-byte {vtable, data} structure
	// that BC_REFDEC_INLINE_FAST kind-discriminates on for
	// iterative-vs-cross-mode dispatch.
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Node struct { Val int\n Next @Node }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	var dtorFn @Func = findFunc(m, "__dtor_Node")
	if dtorFn == nil { return fail("expected __dtor_Node") }
	// Should have OP_FUNC_HANDLE to reference its own dtor.
	var handleCount int = countOp(dtorFn, OP_FUNC_HANDLE)
	if handleCount < 1 {
		return fail("expected OP_FUNC_HANDLE for self-referential dtor")
	}
	return ""
}

func TestTempSliceParamNotConsumed() testing.TestResult {
	// When @[]T is passed as *[]T param, the temp should NOT be consumed —
	// it stays in the cleanup list and gets RefDec'd at end of statement.
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func foo(s *[]int) int { return s[0] }\n")
	src = concatChars(src, "func main() {\n")
	src = concatChars(src, "  var x int = foo(make_slice(int, 3))\n")
	src = concatChars(src, "  println(x)\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	var mainFn @Func = findFunc(m, "main")
	if mainFn == nil { return fail("no main func") }
	// Should have OP_REFDEC for the temp managed-slice
	var decCount int = countOp(mainFn, OP_REFDEC)
	if decCount < 1 {
		return fail(
			"expected OP_REFDEC for temp managed-slice")
	}
	return ""
}

func TestArrayDtorGenerated() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Node struct { Val int }\n")
	src = concatChars(src, "type Container struct { Items [3]@Node }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	// Should generate __dtor_arr3_mp_Node
	var dtorFn @Func = findFunc(m, "__dtor_arr3_mp_Node")
	if dtorFn == nil { return fail("expected __dtor_arr3_mp_Node function") }
	// Should have a loop (OP_LT comparison)
	var cmpCount int = countOp(dtorFn, OP_LT)
	if cmpCount < 1 { return fail("array dtor should have loop condition") }
	return ""
}

func TestArrayDtorNotGeneratedForPlainElems() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Foo struct { Vals [5]int }\n")
	src = concatChars(src, "func main() { }\n")
	var m @Module = genFromSource(src)
	// [5]int doesn't need destruction — no dtor should be generated
	var dtorFn @Func = findFunc(m, "__dtor_Foo")
	if dtorFn != nil { return fail("Foo with [5]int should not need a dtor") }
	return ""
}

// ============================================================
// stripConstForIR — remove TYP_READONLY wrappers before codegen
// ============================================================

// Top-level const is peeled.
func TestStripConstForIROuterConst() testing.TestResult {
	var ci @types.Type = types.MakeReadonlyType(types.TypInt())
	var r @types.Type = stripConstForIR(ci)
	if r == nil { return fail("strip(const int) nil") }
	if r.Kind == types.TYP_READONLY { return fail("strip(const int) still const") }
	if !r.Identical(types.TypInt()) {
		return fail("strip(const int) should be int")
	}
	return ""
}

// Element-level const is peeled: *[]readonly char → *[]char.
func TestStripConstForIRSliceElemConst() testing.TestResult {
	var sc @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	var r @types.Type = stripConstForIR(sc)
	if r == nil { return fail("strip(*[]readonly char) nil") }
	if r.Kind != types.TYP_SLICE { return fail("strip(*[]readonly char) should be slice") }
	if r.Elem == nil { return fail("elem nil") }
	if r.Elem.Kind == types.TYP_READONLY {
		return fail("strip didn't peel element const")
	}
	return ""
}

// Pointer-element const is peeled: *readonly int → *int.
func TestStripConstForIRPointerElemConst() testing.TestResult {
	var pc @types.Type = types.MakePointerType(types.MakeReadonlyType(types.TypInt()))
	var r @types.Type = stripConstForIR(pc)
	if r == nil { return fail("strip(*readonly int) nil") }
	if r.Kind != types.TYP_POINTER { return fail("expected pointer") }
	if r.Elem == nil || r.Elem.Kind == types.TYP_READONLY {
		return fail("strip didn't peel pointer element const")
	}
	return ""
}

// Nested: *[]*readonly int — strip through two levels of references.
func TestStripConstForIRNested() testing.TestResult {
	var inner @types.Type = types.MakePointerType(types.MakeReadonlyType(types.TypInt()))
	var outer @types.Type = types.MakeSliceType(inner)
	var r @types.Type = stripConstForIR(outer)
	if r.Kind != types.TYP_SLICE { return fail("outer should be slice") }
	if r.Elem == nil || r.Elem.Kind != types.TYP_POINTER {
		return fail("inner should be pointer")
	}
	if r.Elem.Elem == nil || r.Elem.Elem.Kind == types.TYP_READONLY {
		return fail("nested const not peeled")
	}
	return ""
}

// Non-const input is returned structurally unchanged.
func TestStripConstForIRNoConst() testing.TestResult {
	var t @types.Type = types.MakeSliceType(types.TypInt())
	var r @types.Type = stripConstForIR(t)
	if !r.Identical(t) { return fail("non-const should be identical") }
	return ""
}

// nil input returns nil — no crash.
func TestStripConstForIRNil() testing.TestResult {
	var nilT @types.Type
	var r @types.Type = stripConstForIR(nilT)
	if r != nil { return fail("strip(nil) should be nil") }
	return ""
}
