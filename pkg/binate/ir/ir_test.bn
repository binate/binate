package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for AddBlock / AddFaultPad: the block lists grow through a builder vec
// whose element view they are, and stay right when a pass replaces a list.

// noTypes returns an empty result list.
func noTypes() @[]@types.Type { return make_slice(@types.Type, 0) }

// newTestFunc returns an empty function with no parameters and no results.
func newTestFunc() @Func { return NewFunc("", "t", make_slice(@Param, 0), noTypes()) }

// labelIs reports whether b's label is want.
func labelIs(b @Block, want *[]readonly char) bool {
	if len(b.Label) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if b.Label[i] != want[i] { return false }
	}
	return true
}

// Blocks added one by one are the list, in order, each labelled with its index.
func TestAddBlockAppendsInOrder() testing.TestResult {
	var f @Func = newTestFunc()
	var made @[]@Block = make_slice(@Block, 100)
	for i := 0; i < len(made); i++ { made[i] = AddBlock(f, "b") }
	if len(f.Blocks) != 100 || f.BlocksVec.Len() != 100 { return "100 blocks added" }
	for i := 0; i < len(made); i++ {
		if f.Blocks[i] != made[i] { return "the blocks are in the order added" }
	}
	if !labelIs(f.Blocks[0], "b.0") || !labelIs(f.Blocks[99], "b.99") {
		return "labels carry the index"
	}
	return ""
}

// After a pass replaces Blocks — dropping some, rearranging them at the same
// length, or cutting the list to a prefix of itself (the builder's own memory, so
// only the length tells) — AddBlock appends to the replaced list, not to the
// builder's old one.
func TestAddBlockAfterBlocksReplaced() testing.TestResult {
	var f @Func = newTestFunc()
	var made @[]@Block = make_slice(@Block, 5)
	for i := 0; i < len(made); i++ { made[i] = AddBlock(f, "b") }
	var kept @[]@Block = make_slice(@Block, 3)
	kept[0] = made[0]
	kept[1] = made[2]
	kept[2] = made[4]
	f.Blocks = kept
	var nb @Block = AddBlock(f, "n")
	if len(f.Blocks) != 4 || f.Blocks[0] != made[0] || f.Blocks[1] != made[2] ||
			f.Blocks[2] != made[4] || f.Blocks[3] != nb {
		return "a block added after pruning follows the pruned list"
	}
	if !labelIs(nb, "n.3") { return "its label carries its index in the pruned list" }
	var rev @[]@Block = make_slice(@Block, 4)
	for i := 0; i < 4; i++ { rev[i] = f.Blocks[3 - i] }
	f.Blocks = rev
	var nb2 @Block = AddBlock(f, "m")
	if len(f.Blocks) != 5 || f.Blocks[0] != nb || f.Blocks[3] != made[0] || f.Blocks[4] != nb2 {
		return "a block added after a same-length rearrangement follows the rearranged list"
	}
	f.Blocks = f.Blocks[0:2]
	var nb3 @Block = AddBlock(f, "p")
	if len(f.Blocks) != 3 || f.Blocks[0] != nb || f.Blocks[1] != made[4] || f.Blocks[2] != nb3 {
		return "a block added after the list is cut to a prefix of itself follows the prefix"
	}
	return ""
}

// Fault pads go to FaultPads, never Blocks, whether added directly or by AddBlock
// in pad-emit mode; and a function made without NewFunc (no builders yet) grows its
// lists too.
func TestAddFaultPadAndBareFunc() testing.TestResult {
	var f @Func = newTestFunc()
	var b @Block = AddBlock(f, "b")
	var p0 @Block = AddFaultPad(f, "pad")
	f.PadEmitMode = true
	var p1 @Block = AddBlock(f, "pad")
	f.PadEmitMode = false
	if len(f.Blocks) != 1 || f.Blocks[0] != b { return "pads stay off Blocks" }
	if len(f.FaultPads) != 2 || f.FaultPads[0] != p0 || f.FaultPads[1] != p1 {
		return "the pads, in order"
	}
	if !labelIs(p1, "pad.1") { return "a pad's label carries its index among the pads" }
	var g @Func = make(Func)
	var g0 @Block = AddBlock(g, "x")
	var g1 @Block = AddBlock(g, "x")
	if len(g.Blocks) != 2 || g.Blocks[0] != g0 || g.Blocks[1] != g1 {
		return "a bare Func grows its blocks"
	}
	return ""
}
