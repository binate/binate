package "pkg/binate/ir"

import "pkg/binate/irdata"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Package-level zero-value slices for NewFunc/NewExternFunc/EmitReturn/EmitCall calls.
var noParams @[]@Param

var noResults @[]@types.Type

var noArgs @[]@Instr

var noFields @[]@types.Field

// ============================================================
// Helpers
// ============================================================

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func startsWith(s *[]readonly char, prefix *[]readonly char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// ============================================================
// Module tests
// ============================================================

func TestNewModule() testing.TestResult {
	var m @Module = NewModule("test")
	if len(m.Funcs) != 0 { return fail("funcs not empty") }
	if len(m.Globals) != 0 { return fail("globals not empty") }
	if len(m.Types) != 0 { return fail("types not empty") }
	return ""
}

func TestAddFunc() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "main", noParams, noResults)
	m.AddFunc(f)
	if len(m.Funcs) != 1 { return fail("expected 1 func") }
	return ""
}

func TestAddGlobal() testing.TestResult {
	var m @Module = NewModule("test")
	var g @Global = make(Global)
	g.Name = "x"
	g.Typ = types.TypInt()
	m.AddGlobal(g)
	if len(m.Globals) != 1 { return fail("expected 1 global") }
	return ""
}

// ============================================================
// Function tests
// ============================================================

func TestNewExternFunc() testing.TestResult {
	var f @Func = NewExternFunc("", "write", noParams, noResults)
	if !f.IsExtern { return fail("should be extern") }
	return ""
}

// NewFunc caches its pkgPath argument on f.ModulePkgPath (inc 5a-2a) so
// the @Block emit methods qualify bare call targets off the func instead
// of a package-global, and qualifies f.Name with it.  An empty pkgPath
// leaves both bare.
func TestNewFuncCachesModulePkgPath() testing.TestResult {
	var f @Func = NewFunc("pkg/geom", "Dist", noParams, noResults)
	if !seq(f.ModulePkgPath, "pkg/geom") {
		return fail("NewFunc must cache pkgPath on f.ModulePkgPath")
	}
	if !seq(f.Name, "pkg/geom.Dist") {
		return fail("NewFunc must qualify f.Name with pkgPath")
	}
	var g @Func = NewFunc("", "Bare", noParams, noResults)
	if len(g.ModulePkgPath) != 0 {
		return fail("empty pkgPath must leave ModulePkgPath empty")
	}
	if !seq(g.Name, "Bare") { return fail("empty pkgPath must leave the name bare") }
	return ""
}

func TestNewParam() testing.TestResult {
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var p @Param = NewParam(f, "x", types.TypInt())
	if !seq(p.Name, "x") { return fail("name wrong") }
	if p.ID != 0 { return fail("first param ID should be 0") }
	var p2 @Param = NewParam(f, "y", types.TypBool())
	if p2.ID != 1 { return fail("second param ID should be 1") }
	return ""
}

func TestAddBlock() testing.TestResult {
	var f @Func = NewFunc("", "main", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	if !startsWith(entry.Label, "entry") { return fail("label should start with entry") }
	if len(f.Blocks) != 1 { return fail("expected 1 block") }
	var exit @Block = AddBlock(f, "exit")
	if len(f.Blocks) != 2 { return fail("expected 2 blocks") }
	if !startsWith(exit.Label, "exit") { return fail("exit label should start with exit") }
	return ""
}

func TestBlockLabelsUnique() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b1 @Block = AddBlock(f, "if.then")
	var b2 @Block = AddBlock(f, "if.then")
	var b3 @Block = AddBlock(f, "if.then")
	// All should have distinct labels
	if seq(b1.Label, b2.Label) { return fail("b1 and b2 have same label") }
	if seq(b2.Label, b3.Label) { return fail("b2 and b3 have same label") }
	if seq(b1.Label, b3.Label) { return fail("b1 and b3 have same label") }
	// All should start with the base name
	if !startsWith(b1.Label, "if.then") { return fail("b1 should start with if.then") }
	if !startsWith(b2.Label, "if.then") { return fail("b2 should start with if.then") }
	if !startsWith(b3.Label, "if.then") { return fail("b3 should start with if.then") }
	return ""
}

// ============================================================
// Instruction emission tests
// ============================================================

func TestEmitConstInt() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var instr @Instr = b.EmitConstInt(42, types.TypInt())
	if instr.Op != iropcode.OP_CONST_INT { return fail("op wrong") }
	if instr.IntVal != 42 { return fail("value wrong") }
	if len(b.Instrs) != 1 { return fail("expected 1 instr") }
	return ""
}

// EmitConstInt64 must store a value exceeding the host word width
// (here > 2^32) in the int64 IntVal slot without truncation.
func TestEmitConstInt64Wide() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var want int64 = (cast(int64, 1) << cast(int64, 40)) | cast(int64, 7)
	var instr @Instr = b.EmitConstInt64(want, types.TypInt64())
	if instr.Op != iropcode.OP_CONST_INT { return fail("op wrong") }
	if instr.IntVal != want { return fail("wide IntVal truncated") }
	return ""
}

func TestEmitConstBool() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var instr @Instr = b.EmitConstBool(true)
	if instr.Op != iropcode.OP_CONST_BOOL { return fail("op wrong") }
	if !instr.BoolVal { return fail("value wrong") }
	return ""
}

func TestEmitConstString() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var instr @Instr = b.EmitConstString("hello")
	if instr.Op != iropcode.OP_CONST_STRING { return fail("op wrong") }
	return ""
}

func TestEmitConstNil() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var instr @Instr = b.EmitConstNil(ptrTyp)
	if instr.Op != iropcode.OP_CONST_NIL { return fail("op wrong") }
	return ""
}

func TestEmitBinop() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var lhs @Instr = b.EmitConstInt(3, types.TypInt())
	var rhs @Instr = b.EmitConstInt(4, types.TypInt())
	var add @Instr = b.EmitBinop(iropcode.OP_ADD, lhs, rhs, types.TypInt())
	if add.Op != iropcode.OP_ADD { return fail("op wrong") }
	if len(add.Args) != 2 { return fail("expected 2 args") }
	if len(b.Instrs) != 3 { return fail("expected 3 instrs") }
	return ""
}

func TestEmitUnary() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var val @Instr = b.EmitConstInt(5, types.TypInt())
	var neg @Instr = b.EmitUnary(iropcode.OP_NEG, val, types.TypInt())
	if neg.Op != iropcode.OP_NEG { return fail("op wrong") }
	if len(neg.Args) != 1 { return fail("expected 1 arg") }
	return ""
}

// ============================================================
// Memory tests
// ============================================================

func TestEmitAllocLoadStore() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var ptr @Instr = b.EmitAlloc(types.TypInt())
	if ptr.Op != iropcode.OP_ALLOC { return fail("alloc op wrong") }
	var val @Instr = b.EmitConstInt(10, types.TypInt())
	b.EmitStore(ptr, val)
	var loaded @Instr = b.EmitLoad(ptr, types.TypInt())
	if loaded.Op != iropcode.OP_LOAD { return fail("load op wrong") }
	if len(b.Instrs) != 4 { return fail("expected 4 instrs") }
	// Store should be void (ID = -1)
	if b.Instrs[2].ID != -1 { return fail("store should be void") }
	return ""
}

func TestEmitGetFieldPtr() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var structTyp @types.Type = types.TypInt() // placeholder
	var ptr @Instr = b.EmitAlloc(structTyp)
	var fptr @Instr = b.EmitGetFieldPtr(ptr, 0, types.TypInt())
	if fptr.Op != iropcode.OP_GET_FIELD_PTR { return fail("op wrong") }
	if fptr.Index != 0 { return fail("index wrong") }
	return ""
}

// ============================================================
// SSA ID tests
// ============================================================

func TestSSAIDs() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var i1 @Instr = b.EmitConstInt(1, types.TypInt())
	var i2 @Instr = b.EmitConstInt(2, types.TypInt())
	var i3 @Instr = b.EmitBinop(iropcode.OP_ADD, i1, i2, types.TypInt())
	if i1.ID != 0 { return fail(buf.Concat("i1 ID wrong: ", strconv.Itoa(i1.ID))) }
	if i2.ID != 1 { return fail(buf.Concat("i2 ID wrong: ", strconv.Itoa(i2.ID))) }
	if i3.ID != 2 { return fail(buf.Concat("i3 ID wrong: ", strconv.Itoa(i3.ID))) }
	return ""
}

func TestParamIDsOffset() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var p @Param = NewParam(f, "x", types.TypInt())
	var b @Block = AddBlock(f, "entry")
	var i1 @Instr = b.EmitConstInt(1, types.TypInt())
	// Param gets ID 0, first instr gets ID 1
	if p.ID != 0 { return fail("param ID should be 0") }
	if i1.ID != 1 { return fail("instr ID should be 1") }
	return ""
}

