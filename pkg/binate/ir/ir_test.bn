package "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Tests for AddBlock / AddFaultPad: the block lists grow through a builder vec
// whose element view they are, and stay right when a pass replaces a list; a block's
// label is never given twice, nor is a pad's; a block a pass drops from Blocks, or a pad
// it drops from FaultPads, stays allocated as long as its function (AddedBlocks).

// noTypes returns an empty result list.
func noTypes() @[]@types.Type { return make_slice(@types.Type, 0) }

// newTestFunc returns an empty function with no parameters and no results.
func newTestFunc() @Func { return NewFunc("", "t", make_slice(@Param, 0), noTypes()) }

// labelIs reports whether b's label is want.
func labelIs(b @Block, want *[]readonly char) bool {
	if len(b.Label) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if b.Label[i] != want[i] { return false }
	}
	return true
}

// Blocks added one by one are the list, in order, each labelled with its index.
func TestAddBlockAppendsInOrder() testing.TestResult {
	var f @Func = newTestFunc()
	var made @[]@Block = make_slice(@Block, 100)
	for i := 0; i < len(made); i++ { made[i] = AddBlock(f, "b") }
	if len(f.Blocks) != 100 || f.BlocksVec.Len() != 100 { return "100 blocks added" }
	for i := 0; i < len(made); i++ {
		if f.Blocks[i] != made[i] { return "the blocks are in the order added" }
	}
	if !labelIs(f.Blocks[0], "b.0") || !labelIs(f.Blocks[99], "b.99") {
		return "labels carry the index"
	}
	return ""
}

// After a pass replaces Blocks — dropping some, rearranging them at the same
// length, or cutting the list to a prefix of itself (the builder's own memory, so
// only the length tells) — AddBlock appends to the replaced list, not to the
// builder's old one.
func TestAddBlockAfterBlocksReplaced() testing.TestResult {
	var f @Func = newTestFunc()
	var made @[]@Block = make_slice(@Block, 5)
	for i := 0; i < len(made); i++ { made[i] = AddBlock(f, "b") }
	var kept @[]@Block = make_slice(@Block, 3)
	kept[0] = made[0]
	kept[1] = made[2]
	kept[2] = made[4]
	f.Blocks = kept
	var nb @Block = AddBlock(f, "n")
	if len(f.Blocks) != 4 || f.Blocks[0] != made[0] || f.Blocks[1] != made[2] ||
			f.Blocks[2] != made[4] || f.Blocks[3] != nb {
		return "a block added after pruning follows the pruned list"
	}
	if !labelIs(nb, "n.5") { return "its label is numbered past the five blocks added before" }
	var rev @[]@Block = make_slice(@Block, 4)
	for i := 0; i < 4; i++ { rev[i] = f.Blocks[3 - i] }
	f.Blocks = rev
	var nb2 @Block = AddBlock(f, "m")
	if len(f.Blocks) != 5 || f.Blocks[0] != nb || f.Blocks[3] != made[0] || f.Blocks[4] != nb2 {
		return "a block added after a same-length rearrangement follows the rearranged list"
	}
	f.Blocks = f.Blocks[0:2]
	var nb3 @Block = AddBlock(f, "p")
	if len(f.Blocks) != 3 || f.Blocks[0] != nb || f.Blocks[1] != made[4] || f.Blocks[2] != nb3 {
		return "a block added after the list is cut to a prefix of itself follows the prefix"
	}
	return ""
}

// A block added after a pass dropped blocks from f.Blocks takes a label no earlier block
// had: labels are numbered from f.NextBlockNum, which only grows, not by the list's
// length, which the drop shortened.
func TestAddBlockLabelNotReusedAfterDrop() testing.TestResult {
	var f @Func = newTestFunc()
	var made @[]@Block = make_slice(@Block, 4)
	for i := 0; i < len(made); i++ { made[i] = AddBlock(f, "b") }
	var kept @[]@Block = make_slice(@Block, 2)
	kept[0] = made[0]
	kept[1] = made[1]
	f.Blocks = kept
	var nb @Block = AddBlock(f, "b")
	for i := 0; i < len(made); i++ {
		if labelIs(nb, made[i].Label) { return "the new block must not take an earlier block's label" }
	}
	if !labelIs(nb, "b.4") { return "the new block is numbered past the four added before" }
	return ""
}

// Fault pads go to FaultPads, never Blocks, whether added directly or by AddBlock
// in pad-emit mode; and a function made without NewFunc (no builders yet) grows its
// lists too.
func TestAddFaultPadAndBareFunc() testing.TestResult {
	var f @Func = newTestFunc()
	var b @Block = AddBlock(f, "b")
	var p0 @Block = AddFaultPad(f, "pad")
	f.PadEmitMode = true
	var p1 @Block = AddBlock(f, "pad")
	f.PadEmitMode = false
	if len(f.Blocks) != 1 || f.Blocks[0] != b { return "pads stay off Blocks" }
	if len(f.FaultPads) != 2 || f.FaultPads[0] != p0 || f.FaultPads[1] != p1 {
		return "the pads, in order"
	}
	if !labelIs(p1, "pad.1") { return "a pad's label carries its number among the pads" }
	var g @Func = make(Func)
	var g0 @Block = AddBlock(g, "x")
	var g1 @Block = AddBlock(g, "x")
	if len(g.Blocks) != 2 || g.Blocks[0] != g0 || g.Blocks[1] != g1 {
		return "a bare Func grows its blocks"
	}
	return ""
}

// dropLast adds blocks b.0, b.1 and b.2 to f, then drops b.2 from f.Blocks as a pass
// pruning blocks does, and returns it, raw: nothing of the caller's holds it.
func dropLast(f @Func) *Block {
	var b0 @Block = AddBlock(f, "b")
	var b1 @Block = AddBlock(f, "b")
	var b2 @Block = AddBlock(f, "b")
	var kept @[]@Block = make_slice(@Block, 2)
	kept[0] = b0
	kept[1] = b1
	f.Blocks = kept
	return b2
}

// A block a pass dropped from f.Blocks outlives the next AddBlock, which rebuilds the
// builder that was its last owner in Blocks: f.AddedBlocks holds it, after the blocks
// added before it and before the one added after.
func TestAddBlockKeepsDroppedBlock() testing.TestResult {
	var f @Func = newTestFunc()
	var dropped *Block = dropLast(f)
	var nb @Block = AddBlock(f, "n")
	if len(f.Blocks) != 3 || f.Blocks[2] != nb { return "the new block follows the kept two" }
	if f.AddedBlocks == nil || f.AddedBlocks.Len() != 4 {
		return "AddedBlocks holds the four blocks added, the dropped one among them"
	}
	var held *Block = f.AddedBlocks.Get(2)
	if !same(held, dropped) || f.AddedBlocks.Get(3) != nb {
		return "AddedBlocks is in the order added"
	}
	if !labelIs(f.AddedBlocks.Get(2), "b.2") { return "the dropped block is b.2, still allocated" }
	return ""
}

// dropLastPad adds pads pad.0, pad.1 and pad.2 to f, then drops pad.2 from f.FaultPads
// as a pass pruning pads does, and returns it, raw: nothing of the caller's holds it.
func dropLastPad(f @Func) *Block {
	var p0 @Block = AddFaultPad(f, "pad")
	var p1 @Block = AddFaultPad(f, "pad")
	var p2 @Block = AddFaultPad(f, "pad")
	var kept @[]@Block = make_slice(@Block, 2)
	kept[0] = p0
	kept[1] = p1
	f.FaultPads = kept
	return p2
}

// A pad a pass dropped from f.FaultPads outlives the next AddFaultPad, which rebuilds the
// builder that was its last owner in FaultPads: f.AddedBlocks holds it, in the order made
// among the blocks and pads.  The new pad takes a label no earlier pad had, numbered from
// f.NextPadNum, which only grows, not by the list's length, which the drop shortened; and
// blocks are numbered apart from pads, so a block added after them is b.1.
func TestAddFaultPadKeepsDroppedPad() testing.TestResult {
	var f @Func = newTestFunc()
	var b0 @Block = AddBlock(f, "b")
	var dropped *Block = dropLastPad(f)
	var np @Block = AddFaultPad(f, "pad")
	var b1 @Block = AddBlock(f, "b")
	if len(f.FaultPads) != 3 || f.FaultPads[2] != np { return "the new pad follows the kept two" }
	if !labelIs(np, "pad.3") { return "the new pad is numbered past the three added before" }
	if !labelIs(b1, "b.1") { return "a block's label counts the blocks alone" }
	if f.AddedBlocks == nil || f.AddedBlocks.Len() != 6 {
		return "AddedBlocks holds the two blocks and four pads made, the dropped pad among them"
	}
	var held *Block = f.AddedBlocks.Get(3)
	if !same(held, dropped) || f.AddedBlocks.Get(0) != b0 || f.AddedBlocks.Get(4) != np ||
			f.AddedBlocks.Get(5) != b1 {
		return "AddedBlocks is in the order made"
	}
	if !labelIs(f.AddedBlocks.Get(3), "pad.2") { return "the dropped pad is pad.2, still allocated" }
	return ""
}

// dropScope builds a function, drops a block and a pad from it, adds another of each and
// drops it all.
func dropScope() {
	var f @Func = newTestFunc()
	dropLast(f)
	AddBlock(f, "n")
	dropLastPad(f)
	AddFaultPad(f, "n")
}

// A function frees the blocks and pads a pass dropped from it when it is freed:
// AddedBlocks closes no reference cycle.  (A first run interns what later ones reuse.)
func TestDroppedBlocksFreedWithFunc() testing.TestResult {
	dropScope()
	var before int = rt.LiveBlocks()
	dropScope()
	if rt.LiveBlocks() != before { return "building and dropping a function must free all it made" }
	return ""
}
