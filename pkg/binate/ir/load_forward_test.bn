package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for load-forwarding (load_forward.bn).  These call forwardLoadsFunc
// directly (mem2reg does not run), so they can exercise scalar slots too; the
// aggregate case (the real target) is covered by the slice test here and by the
// loop-BCE conformance tests.

// A non-escaping single-store slot with two loads: both loads forward to the
// stored value, and the alloca/store/loads vanish.
func TestForwardSingleStoreTwoLoads() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var five @Instr = entry.EmitConstInt(5, types.TypInt())
	entry.EmitStore(x, five)
	var v1 @Instr = entry.EmitLoad(x, types.TypInt())
	var v2 @Instr = entry.EmitLoad(x, types.TypInt())
	var sum @Instr = entry.EmitBinop(iropcode.OP_ADD, v1, v2, types.TypInt())
	entry.EmitReturn(oneRet(sum))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("single-store: alloca/store/loads should be forwarded away")
	}
	if sum.Args[0] != five || sum.Args[1] != five {
		return fail("single-store: both loads should forward to the stored value")
	}
	return ""
}

// An aggregate (raw slice) slot forwards just like a scalar: the slice-header
// load feeding the slice-length extract (OP_EXTRACT) is replaced by the stored
// slice value.  This is the coalescing loop-BCE relies on.
func TestForwardAggregateSlot() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = types.MakeSliceType(types.TypInt())
	var x @Instr = entry.EmitAlloc(st)
	var nilSlice @Instr = entry.EmitConstNil(st)
	entry.EmitStore(x, nilSlice)
	var v @Instr = entry.EmitLoad(x, st)
	var ln @Instr = entry.EmitSliceLen(v)
	entry.EmitReturn(oneRet(ln))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("aggregate: the slice slot should be forwarded away")
	}
	if ln.Args[0] != nilSlice {
		return fail("aggregate: the length extract should read the stored slice value directly")
	}
	return ""
}

// A >16B by-address managed slice (@[]int = 4 words = 32B on LP64) is coalesced by
// REDUNDANT-LOAD-ELIMINATION, not store-forwarding: store-forwarding to the stored
// value would make a backend extractvalue a slice out of a `ptr` (a by-address
// param).  RLE keeps the alloca + store, inserts ONE materializing load after the
// store, and rewrites every load to it — so the length extract reads a LOAD, never
// the stored value.
func TestForwardManagedSliceRLE() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @Instr = entry.EmitAlloc(mst)
	var nilSlice @Instr = entry.EmitConstNil(mst)
	entry.EmitStore(x, nilSlice)
	var v @Instr = entry.EmitLoad(x, mst)
	var ln @Instr = entry.EmitSliceLen(v)
	entry.EmitReturn(oneRet(ln))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("RLE: the managed-slice alloca must be kept")
	}
	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("RLE: exactly one materializing load must remain")
	}
	// The extract must read the materializing OP_LOAD of the slot, NOT the stored
	// value (nilSlice).
	var l0 @Instr = ln.Args[0]
	if l0 == nilSlice {
		return fail("RLE: the length extract must not read the stored value")
	}
	if l0.Op != iropcode.OP_LOAD || len(l0.Args) < 1 || l0.Args[0] != x {
		return fail("RLE: the length extract must read an OP_LOAD of the slot")
	}
	return ""
}

// A managed slice loaded in a cleanup FAULT PAD (a RefDec read), whose store
// dominates the pad's fault point, is coalesced onto the same materialized load as
// the normal loads — so the pad's RefDec reads the same slice value V.  This is the
// VM-only fault-pad path RLE re-enables (store-forwarding could not, since V may be
// a `ptr`).
func TestForwardManagedSliceRLEPadLoad() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @Instr = entry.EmitAlloc(mst)
	entry.EmitStore(x, entry.EmitConstNil(mst))
	var guard @Instr = entry.EmitLoad(x, mst)
	var ln @Instr = entry.EmitSliceLen(guard)
	entry.EmitBoundsCheck(entry.EmitConstInt(0, types.TypInt()), ln)
	var chk @Instr = entry.Instrs[len(entry.Instrs) - 1]
	entry.EmitReturn(oneRet(ln))

	// A cleanup pad that loads the slot (the managed-local RefDec read) and uses it.
	var pad @Block = AddFaultPad(f, "fault_pad")
	var padLoad @Instr = pad.EmitLoad(x, mst)
	var padLen @Instr = pad.EmitSliceLen(padLoad)
	pad.EmitUnwindReturn()
	chk.PadBlock = pad

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("pad: the managed-slice alloca must be kept")
	}
	// The pad's OP_LOAD(x) is forwarded away.
	for ii := 0; ii < len(pad.Instrs); ii++ {
		var pi @Instr = pad.Instrs[ii]
		if pi.Op == iropcode.OP_LOAD && len(pi.Args) >= 1 && pi.Args[0] == x {
			return fail("pad: the cleanup load must be forwarded away")
		}
	}
	// The guard extract and the pad extract must read the SAME materialized load —
	// the coalescing loop-BCE relies on — and it must be an OP_LOAD of the slot.
	if ln.Args[0] != padLen.Args[0] {
		return fail("pad: guard and cleanup extracts must read the same materialized load")
	}
	var l0 @Instr = ln.Args[0]
	if l0.Op != iropcode.OP_LOAD || len(l0.Args) < 1 || l0.Args[0] != x {
		return fail("pad: the coalesced value must be an OP_LOAD of the slot")
	}
	return ""
}

// A NON-load use of the slot in a fault pad (here a store) is a real escape even in
// a pad — the slot is not forwarded (guard load kept, no materialized load).
func TestForwardManagedSlicePadNonLoadKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @Instr = entry.EmitAlloc(mst)
	entry.EmitStore(x, entry.EmitConstNil(mst))
	var guard @Instr = entry.EmitLoad(x, mst)
	var ln @Instr = entry.EmitSliceLen(guard)
	entry.EmitReturn(oneRet(ln))

	var pad @Block = AddFaultPad(f, "fault_pad")
	pad.EmitStore(x, pad.EmitConstNil(mst)) // a non-load use of x in the pad
	pad.EmitUnwindReturn()

	forwardLoadsFunc(f)

	// Escaped ⇒ untouched: the guard load stays and the extract still reads it.
	if ln.Args[0] != guard {
		return fail("pad non-load use: the slot must not be forwarded")
	}
	return ""
}

// A managed POINTER (@T — a managed value, but NOT a slice) loaded in a cleanup
// fault pad must NOT be forwarded: only managed slices get the relaxed pad escape.
// Forwarding it would delete the alloca + pad load and leave the pad's RefDec
// dangling — the VM-only refcount regression this guards.
func TestForwardManagedPtrPadLoadKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var pt @types.Type = types.MakeManagedPtrType(types.TypInt())
	var x @Instr = entry.EmitAlloc(pt)
	entry.EmitStore(x, entry.EmitConstNil(pt))
	var v @Instr = entry.EmitLoad(x, pt)
	_ = v
	var noRet @[]@Instr
	entry.EmitReturn(noRet)

	var pad @Block = AddFaultPad(f, "fault_pad")
	pad.EmitLoad(x, pt)
	pad.EmitUnwindReturn()

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail(
				"managed pointer with a pad load must not be forwarded (only slices relax the pad escape)")
	}
	return ""
}

// Two stores to the slot: not forwarded (the load could read either value).
func TestForwardTwoStoresKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(1, types.TypInt()))
	entry.EmitStore(x, entry.EmitConstInt(2, types.TypInt()))
	var v @Instr = entry.EmitLoad(x, types.TypInt())
	entry.EmitReturn(oneRet(v))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("two-store: a multi-store slot must not be forwarded")
	}
	return ""
}

// An escaping slot (address taken via GET_ELEM_PTR) is not forwarded.
func TestForwardEscapeKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	var idx @Instr = entry.EmitConstInt(0, types.TypInt())
	var gep @Instr = entry.EmitGetElemPtr(x, idx, types.TypInt())
	entry.EmitReturn(oneRet(gep))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("escape: an escaping slot must not be forwarded")
	}
	return ""
}

// The single store is in one arm of an if, so it does not dominate a load after
// the merge: not forwarded.
func TestForwardStoreNotDominatingKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var thenB @Block = AddBlock(f, "then")
	var elseB @Block = AddBlock(f, "else")
	var merge @Block = AddBlock(f, "merge")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitBranch(entry.EmitConstBool(true), thenB, elseB)
	thenB.EmitStore(x, thenB.EmitConstInt(1, types.TypInt())) // store only in the then-arm
	thenB.EmitJump(merge)
	elseB.EmitJump(merge)
	var v @Instr = merge.EmitLoad(x, types.TypInt())
	merge.EmitReturn(oneRet(v))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("not-dominating: a store that does not dominate the load must not forward")
	}
	return ""
}

// A load textually BEFORE the store in the same block reads the prior value, so
// the slot is not forwarded (Dominates(b,b) is order-blind, so this is the
// same-block textual-order guard).
func TestForwardLoadBeforeStoreKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var v @Instr = entry.EmitLoad(x, types.TypInt()) // load BEFORE the store
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	entry.EmitReturn(oneRet(v))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("load-before-store: a pre-store load must not be forwarded")
	}
	return ""
}

// Chained forwarding: `var x = y` with both single-store slots — x's load
// resolves through y's load to y's stored const (chaseRepl transitivity).
func TestForwardChained() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var y @Instr = entry.EmitAlloc(types.TypInt())
	var seven @Instr = entry.EmitConstInt(7, types.TypInt())
	entry.EmitStore(y, seven)
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var ytmp @Instr = entry.EmitLoad(y, types.TypInt())
	entry.EmitStore(x, ytmp)
	var xval @Instr = entry.EmitLoad(x, types.TypInt())
	entry.EmitReturn(oneRet(xval))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("chained: both slots should forward away")
	}
	if lastInstr(entry).Args[0] != seven {
		return fail("chained: x's load must resolve through y's load to the const")
	}
	return ""
}

// Cross-block positive forward: the store dominates a load in a successor block.
func TestForwardCrossBlock() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var next @Block = AddBlock(f, "next")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var five @Instr = entry.EmitConstInt(5, types.TypInt())
	entry.EmitStore(x, five)
	entry.EmitJump(next)
	var v @Instr = next.EmitLoad(x, types.TypInt())
	next.EmitReturn(oneRet(v))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("cross-block: a store dominating a successor-block load should forward")
	}
	if lastInstr(next).Args[0] != five {
		return fail("cross-block: the load should forward to the stored value")
	}
	return ""
}

// A two-store AGGREGATE (slice) slot is KEPT (the aggregate path, KEPT case).
func TestForwardAggregateTwoStoresKept() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = types.MakeSliceType(types.TypInt())
	var x @Instr = entry.EmitAlloc(st)
	entry.EmitStore(x, entry.EmitConstNil(st))
	entry.EmitStore(x, entry.EmitConstNil(st)) // second store
	var v @Instr = entry.EmitLoad(x, st)
	entry.EmitReturn(oneRet(entry.EmitSliceLen(v)))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("aggregate-two-store: a multi-store aggregate slot must not be forwarded")
	}
	return ""
}
