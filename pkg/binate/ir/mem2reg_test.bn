package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for scalar SSA promotion (mem2reg.bn): the pass driver, escape /
// type-gate rejection, and the mutation phase.  The rename/phi/grounding core
// is tested in mem2reg_rename_test.bn.  The package-shared countOp (ir_test.bn)
// counts instrs of an op across a func.

// firstPhi returns the first OP_PHI in block b, or nil.
func firstPhi(b @Block) @Instr {
	for ii := 0; ii < len(b.Instrs); ii++ {
		if b.Instrs[ii].Op == iropcode.OP_PHI {
			return b.Instrs[ii]
		}
	}
	var none @Instr
	return none
}

// lastInstr returns b's last instruction (its terminator in well-formed IR).
func lastInstr(b @Block) @Instr {
	return b.Instrs[len(b.Instrs) - 1]
}

// A straight-line `store; load` promotes to the stored value with NO phi, and
// the load/store/alloca vanish.
func TestMem2regStraightLine() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var five @Instr = entry.EmitConstInt(5, types.TypInt())
	entry.EmitStore(x, five)
	var v @Instr = entry.EmitLoad(x, types.TypInt())
	entry.EmitReturn(oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("straight-line: alloca/load/store should be gone")
	}
	if countOp(f, iropcode.OP_PHI) != 0 {
		return fail("straight-line: no phi for a single-block var")
	}
	if lastInstr(entry).Args[0] != five {
		return fail("straight-line: return should use the stored const directly")
	}
	return ""
}

// An alloca whose address escapes (returned as a pointer) is left untouched.
func TestMem2regEscapeNotPromoted() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	// Return the ADDRESS of the local — x appears in OP_RETURN's args, which is
	// not a load/store pointer operand, so the slot escapes.
	entry.EmitReturn(oneRet(x))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_STORE) != 1 {
		return fail("escape: an escaping slot must be left untouched")
	}
	if countOp(f, iropcode.OP_PHI) != 0 {
		return fail("escape: no phi for an unpromoted slot")
	}
	return ""
}

// A GET_ELEM_PTR use of the alloca (address arithmetic) also counts as escape.
func TestMem2regGepEscapeNotPromoted() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	var idx @Instr = entry.EmitConstInt(0, types.TypInt())
	var gep @Instr = entry.EmitGetElemPtr(x, idx, types.TypInt())
	entry.EmitReturn(oneRet(gep))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("gep-escape: address-arithmetic use must pin the slot")
	}
	return ""
}

// A float slot is not promotable (EliminatePhis has no float lowering).
func TestMem2regFloatNotPromoted() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypFloat64())
	entry.EmitStore(x, entry.EmitConstFloat("0", types.TypFloat64()))
	var v @Instr = entry.EmitLoad(x, types.TypFloat64())
	entry.EmitReturn(oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("float: a float slot must not be promoted")
	}
	return ""
}

// A slot loaded with no reaching store on the path is left untouched (the
// rename's nil-reaching-def bail-out), rather than promoted to an undef.
func TestMem2regLoadBeforeStoreNotPromoted() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var v @Instr = entry.EmitLoad(x, types.TypInt()) // load with no prior store
	entry.EmitReturn(oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("load-before-store: the slot must be left unpromoted")
	}
	if countOp(f, iropcode.OP_PHI) != 0 {
		return fail("load-before-store: no phi for an unpromoted slot")
	}
	return ""
}

// A benign orphan block (unreachable, but branching into a phi-merge) is pruned
// so the phi's entry count matches the merge's real predecessors — otherwise the
// LLVM backend would see a predecessor the phi lacks an entry for.
func TestMem2regOrphanPruned() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var thenB @Block = AddBlock(f, "then")
	var elseB @Block = AddBlock(f, "else")
	var merge @Block = AddBlock(f, "merge")
	var orphan @Block = AddBlock(f, "orphan") // unreachable: nothing branches here
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(0, types.TypInt()))
	entry.EmitBranch(entry.EmitConstBool(true), thenB, elseB)
	thenB.EmitStore(x, thenB.EmitConstInt(1, types.TypInt()))
	thenB.EmitJump(merge)
	elseB.EmitStore(x, elseB.EmitConstInt(2, types.TypInt()))
	elseB.EmitJump(merge)
	orphan.EmitJump(merge) // unreachable edge into the merge
	var v @Instr = merge.EmitLoad(x, types.TypInt())
	merge.EmitReturn(oneRet(v))

	promoteFuncScalars(f)

	if len(f.Blocks) != 4 {
		return fail("orphan: the unreachable block should be pruned")
	}
	if countOp(f, iropcode.OP_PHI) != 1 {
		return fail("orphan: exactly one phi expected")
	}
	var phi @Instr = firstPhi(merge)
	if phi == nil || len(phi.Phis) != 2 {
		return fail("orphan: phi must have 2 entries (then + else), not the orphan")
	}
	return ""
}

// Two independent scalars both promote in one function.
func TestMem2regMultipleAllocas() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	var one @Instr = entry.EmitConstInt(1, types.TypInt())
	entry.EmitStore(x, one)
	var y @Instr = entry.EmitAlloc(types.TypInt())
	var two @Instr = entry.EmitConstInt(2, types.TypInt())
	entry.EmitStore(y, two)
	var xv @Instr = entry.EmitLoad(x, types.TypInt())
	var yv @Instr = entry.EmitLoad(y, types.TypInt())
	var sum @Instr = entry.EmitBinop(iropcode.OP_ADD, xv, yv, types.TypInt())
	entry.EmitReturn(oneRet(sum))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("multi: both slots should promote away")
	}
	if sum.Args[0] != one || sum.Args[1] != two {
		return fail("multi: the add should read the two stored consts directly")
	}
	return ""
}

// A store-only slot (no loads) is a dead store: the alloca and its store are
// deleted with no phi and no cast.
func TestMem2regStoreOnlyDeadSlot() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	var noVals @[]@Instr
	entry.EmitReturn(noVals)

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_STORE) != 0 {
		return fail("dead-store: the store-only slot should be removed")
	}
	if countOp(f, iropcode.OP_PHI) != 0 || countOp(f, iropcode.OP_CAST) != 0 {
		return fail("dead-store: no phi or cast expected")
	}
	return ""
}

// Storing a slot's ADDRESS as a value (Args[1] of a store) escapes it.
func TestMem2regAddrStoredEscape() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.TypInt())
	entry.EmitStore(x, entry.EmitConstInt(5, types.TypInt()))
	var p @Instr = entry.EmitAlloc(types.MakePointerType(types.TypInt()))
	entry.EmitStore(p, x) // x's ADDRESS stored as a value -> x escapes
	entry.EmitReturn(oneRet(p)) // p's address returned -> p escapes too

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail("addr-escape: both slots must be left unpromoted")
	}
	return ""
}

// A managed-pointer slot is not a promotable scalar (refcount-bearing).
func TestMem2regManagedRejected() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var x @Instr = entry.EmitAlloc(types.MakeManagedPtrType(types.TypInt()))
	var v @Instr = entry.EmitLoad(x, types.MakeManagedPtrType(types.TypInt()))
	entry.EmitReturn(oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("managed: a managed-pointer slot must not be promoted")
	}
	return ""
}
