package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Module-entry / init-dispatcher emission.  These @Module methods build the
// synthetic per-module init and entry functions (`__init_all`, `bn_init`,
// `__entry`) that drivers wire up; they are methods on the IR data model (so
// they live in the `ir` package), even though the code that decides WHAT to
// emit — the AST-driven package-init generation — lives in the irgen package.

// EmitInitDispatcher emits a synthetic `<m_pkg>.__init_all`
// function into `m` that calls each package's init in order.
// `packageInitNames` is the list of qualified `<pkg>.__init`
// names to invoke (typically built from a dependency-walk loop,
// ending with the main package's own `<main>.__init` if present).
//
// Always emits the function — even with an empty list — so the
// entry wrapper (`<m_pkg>.__entry`, see EmitMainEntry) can call
// it unconditionally without a runtime existence check.
//
// The dispatcher's qualified name is `<m.PkgPath>.__init_all` (m.PkgPath
// is set on the module being generated by GeneratePackage / GenModule).
//
// This is the INTERP path's init mechanism: the VM runs `main.__init_all`
// before each entered function, and `EmitMainEntry`'s `__entry` calls it.
// The compiled (native + LLVM) drivers instead emit `bn_init` (EmitBnInit)
// and a `bn_init`-calling `__entry` (EmitBnEntry) — see those; the interp
// cannot use `bn_init` because it emits a `rt.BuildSatRegistry` call and the
// interp builds its satisfaction registry host-side.
func (m @Module) EmitInitDispatcher(packageInitNames @[]@[]char) {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__init_all")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)
	var entry @Block = AddBlock(f, "entry")
	var emptyArgs @[]@Instr
	// Register each `<pkg>.__init` as an extern in this module so
	// codegen emits a `declare void @bn_F...()` line (the package init function).
	// Without this, clang errors with "use of undefined value" on
	// the call below — the synthetic init names aren't in any
	// source `import` and so RegisterImport doesn't pick them up.
	// Skip the calling module's own `<m_pkg>.__init` (it's defined
	// locally; declaring it as extern would conflict).
	var ownInit @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__init")
	for i := 0; i < len(packageInitNames); i++ {
		if !irutil.Streq(packageInitNames[i], ownInit) {
			var ef @Func = NewExternFunc(m.PkgPath, packageInitNames[i], emptyParams, emptyResults)
			m.AddFunc(ef)
		}
		// Pass through QualifyName: each name already includes
		// the package prefix, so no re-qualification happens.
		entry.EmitCall(packageInitNames[i], emptyArgs, types.TypVoid())
	}
	var noVals @[]@Instr
	entry.EmitReturn(noVals)
	m.AddFunc(f)
}

// EmitBnInit emits the init dispatcher into `m`: a synthetic `<m_pkg>.__bninit`
// function that calls each package's `<pkg>.__init` in dependency order.  The
// mangler routes any `<pkg>.__bninit` to the reserved well-known linker symbol
// `bn_init` — the C runtime's idempotent whole-program / whole-library init.  It
// is emitted in EVERY artifact: for a program, `m` is the `main` module and
// `bn_entry` (EmitBnEntry) calls it before `main.main`; for a `--library`, `m`
// is the facade and a C host calls `bn_init` directly to init the whole `.a`.
//
// `packageInitNames` is the dependency-ordered list of `<pkg>.__init` names (the
// build root's transitive closure, incl. the root's own `__init` last if
// present) — the same shape EmitInitDispatcher takes.
//
// bn_init is IDEMPOTENT: a run-once guard so it may be called more than once (a C
// host calling `bn_init` and then the process running `bn_entry`, which re-calls
// it; or several merged libraries sharing the one `bn_init`) without re-running
// any package's var initializers.  The guard is a private zero-initialized
// (false) bool global `__bninit_done`; the body is
//
//	if __bninit_done { return }
//	__bninit_done = true
//	rt.BuildSatRegistry(&__pkg_satfrag)   // fill the interface-satisfaction registry
//	<call each package __init in dependency order>
//
// The store precedes the init calls so a (pathological) re-entrant init that
// reaches back into `bn_init` sees the guard already set and returns rather than
// recursing — matching the C `once`-style contract a host expects.
func (m @Module) EmitBnInit(packageInitNames @[]@[]char) {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__bninit")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)

	// The run-once guard global.  A `__`-prefixed reserved name a user cannot
	// declare (IsReservedIdentifier), so it never collides with a package var;
	// zero-init (false) means "inits not yet run".
	var guard @Global = make(Global)
	guard.Name = "__bninit_done"
	guard.Typ = types.TypBool()
	m.AddGlobal(guard)

	var entry @Block = AddBlock(f, "entry")
	var runBlk @Block = AddBlock(f, "run")
	var doneBlk @Block = AddBlock(f, "done")

	// entry: already-run? -> done (skip inits); else -> run.
	var already @Instr = entry.EmitLoad(bnInitGuardRef(), types.TypBool())
	entry.EmitBranch(already, doneBlk, runBlk)

	// run: mark the guard set, then call each package init in dependency order.
	runBlk.EmitStore(bnInitGuardRef(), runBlk.EmitConstBool(true))

	// Build the runtime satisfaction registry BEFORE any package init runs — a
	// top-level var initializer (executed by a `<pkg>.__init` below) can perform an
	// interface assertion, which needs the registry filled.  Without this the
	// artifact never fills the registry, so every interface assertion/satisfaction
	// lookup MISSES.  Walk the decentralized `__pkg_satfrag` graph from THIS build
	// root's node (main for a program, the facade for a library).  The store
	// precedes this so a re-entrant bn_init sees the guard already set.
	// SatRegistryRequested also drives codegen to pin the root's `__pkg_satfrag`
	// node (emitSatFragPin / collectDefinedDataSyms).  Compiled (native + LLVM)
	// path only — the interp never emits bn_init (it builds its registry
	// host-side).
	m.SatRegistryRequested = true
	emitBuildSatRegistryCall(runBlk, m)

	var emptyArgs @[]@Instr
	// Register each `<pkg>.__init` as an extern so codegen emits a `declare`
	// (mirrors EmitInitDispatcher); skip the build root's own `__init`, which is
	// defined locally in this same module.
	var ownInit @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__init")
	for i := 0; i < len(packageInitNames); i++ {
		if !irutil.Streq(packageInitNames[i], ownInit) {
			var ef @Func = NewExternFunc(m.PkgPath, packageInitNames[i], emptyParams, emptyResults)
			m.AddFunc(ef)
		}
		runBlk.EmitCall(packageInitNames[i], emptyArgs, types.TypVoid())
	}
	runBlk.EmitJump(doneBlk)

	// done: return.
	var noVals @[]@Instr
	doneBlk.EmitReturn(noVals)
	m.AddFunc(f)
}

// bnInitGuardRef builds a fresh IsGlobalRef pseudo-pointer to bn_init's
// run-once guard global (`__bninit_done`), mirroring lookupVar's global
// fallback: an OP_ALLOC pseudo (ID -1) whose StrVal is the global's name, so
// codegen's emitPtrRef renders it as `@<mangled __bninit_done>` — the exact
// symbol AddGlobal's definition emits (both go through GlobalName(modulePkg,
// "__bninit_done")).  A fresh instance per use keeps the load and the store
// from sharing one pseudo-Instr node.
func bnInitGuardRef() @Instr {
	var g @Instr = make(Instr)
	g.ID = -1
	g.Op = iropcode.OP_ALLOC
	g.StrVal = "__bninit_done"
	g.Typ = types.MakePointerType(types.TypBool())
	g.TypeArg = types.TypBool()
	g.IsGlobalRef = true
	return g
}

// EmitMainEntry emits a synthetic `<m_pkg>.__entry` function that runs
// `<m_pkg>.__init_all()` and then calls `main.main()`.  Mangler routes the
// qualified name `main.__entry` to the linker symbol `bn_entry`.
//
// This is the INTERP path's entry: it pairs with EmitInitDispatcher (the caller
// must have emitted `__init_all` first; the body calls it unconditionally).  The
// compiled (native + LLVM) drivers use EmitBnEntry instead, whose `__entry`
// calls `bn_init` rather than `__init_all` — see EmitBnEntry and
// EmitInitDispatcher for why the interp keeps `__init_all`.
func (m @Module) EmitMainEntry() {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)
	var entry @Block = AddBlock(f, "entry")
	var emptyArgs @[]@Instr
	entry.EmitCall(irutil.QualifyForPkgPath(m.PkgPath, "__init_all"), emptyArgs, types.TypVoid())
	entry.EmitCall("main.main", emptyArgs, types.TypVoid())
	var noVals @[]@Instr
	entry.EmitReturn(noVals)
	m.AddFunc(f)
}

// EmitBnEntry emits the compiled program's synthetic `<m_pkg>.__entry` function:
// `bn_init(); main.main()`.  Mangler routes `main.__entry` to the reserved
// linker symbol `bn_entry` — the C runtime's sole entry point into Binate — and
// `<m_pkg>.__bninit` to `bn_init`, so this is literally `bn_init(); main.main()`
// at the symbol level.  Keeping all entry-time init behind `bn_init` means a C
// host that calls `bn_init` directly (before or instead of running main) hits
// the exact same init path `bn_entry` uses; bn_init's run-once guard makes the
// two compose safely (init runs once even if both fire).
//
// Caller (cmd/bnc on the main module) must have emitted `bn_init` first via
// EmitBnInit; the body here calls it unconditionally.  This is the compiled
// counterpart of EmitMainEntry (interp) — emit exactly one of the two per main
// module, never both (both would define `<m_pkg>.__entry`).
func (m @Module) EmitBnEntry() {
	var emptyParams @[]@Param
	var emptyResults @[]@types.Type
	var name @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__entry")
	var f @Func = NewFunc(m.PkgPath, name, emptyParams, emptyResults)
	var entry @Block = AddBlock(f, "entry")
	var emptyArgs @[]@Instr
	entry.EmitCall(irutil.QualifyForPkgPath(m.PkgPath, "__bninit"), emptyArgs, types.TypVoid())
	entry.EmitCall("main.main", emptyArgs, types.TypVoid())
	var noVals @[]@Instr
	entry.EmitReturn(noVals)
	m.AddFunc(f)
}

// HasMainFunc reports whether this module defines the program entry point —
// the func `main.main` that the `__entry` wrapper calls (EmitBnEntry for a
// compiled program, EmitMainEntry for the interp).  A program with no entry
// can't be caught per-package at COMPILE time (Binate compiles one package at a
// time, and any package may be compiled independently), so program-assembly
// drivers call this on the main module and reject a missing entry (§17.3.1).
// The `--test` runner synthesizes its own `func main`, so this holds for it too.
//
// The check is the LITERAL `main.main` — exactly the symbol the entry wrappers
// call — not `qualifyForPkgPath(m.PkgPath, "main")`: a program whose
// entry package is (wrongly) not named "main" would otherwise define
// `<pkg>.main` and pass this check while `__entry` still calls the undefined
// `main.main`, trading a clean rejection for a raw link error.
func (m @Module) HasMainFunc() bool {
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.Streq(m.Funcs[i].Name, "main.main") { return true }
	}
	return false
}

// IsMainPackage reports whether this module's package is named "main" — the
// name a program's entry package must have (§17.3 `prog.main.package`).  A
// program assembled from a differently-named entry package defines
// `<pkg>.main`, but the entry wrappers call the literal `main.main`, so
// program-assembly drivers reject a non-"main" entry package with a message
// naming the real cause (rather than the less-precise "no main function").
func (m @Module) IsMainPackage() bool {
	return irutil.Streq(m.PkgPath, "main")
}

// HasPackageInit reports whether `m` contains a `<m_pkg>.__init`
// function (one was emitted by generatePackageInit).  Used by
// drivers that need to decide whether to include the package in
// the dispatcher's call list.
func (m @Module) HasPackageInit() bool {
	var initName @[]char = irutil.QualifyForPkgPath(m.PkgPath, "__init")
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.Streq(m.Funcs[i].Name, initName) { return true }
	}
	return false
}

// PackageInitName returns the qualified name `<pkg>.__init` for the
// given package.  Helper for drivers building the dispatcher's call
// list.  pkg may be a short name or a full path — QualifyName
// short-names it internally (full-path migration — see pkg/binate/mangle).
func PackageInitName(pkg *[]readonly char) @[]char {
	return mangle.QualifyName(pkg, "__init")
}
