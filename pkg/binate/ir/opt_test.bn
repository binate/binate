package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// countBoundsChecks returns the number of OP_BOUNDS_CHECK instructions still
// present in a block — the observable the BCE tests assert on.
func countBoundsChecks(blk @Block) int {
	var n int = 0
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i].Op == iropcode.OP_BOUNDS_CHECK {
			n = n + 1
		}
	}
	return n
}

// bceModuleWith builds a one-block func holding a single OP_BOUNDS_CHECK(idx,
// len) over two integer-constant operands, wrapped in a module ready for
// RunOptPasses.
func bceModuleWith(idxVal int, lenVal int) @Module {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var idx @Instr = b.EmitConstInt(idxVal, types.TypInt())
	var length @Instr = b.EmitConstInt(lenVal, types.TypInt())
	b.EmitBoundsCheck(idx, length)
	var m @Module = NewModule("test")
	m.AddFunc(f)
	return m
}

func TestBCEConstIndexRemovesSafe() testing.TestResult {
	var m @Module = bceModuleWith(3, 10) // 0 <= 3 < 10 ⇒ statically in-bounds
	var b @Block = m.Funcs[0].Blocks[0]
	if countBoundsChecks(b) != 1 { return fail("setup: expected 1 check") }
	RunOptPasses(m, 1)
	if countBoundsChecks(b) != 0 { return fail("safe const-index check should be removed at -O1") }
	return ""
}

func TestBCEConstIndexKeepsOutOfRange() testing.TestResult {
	// 15 >= 10: a genuine runtime fault the program must still take — KEEP.
	var m @Module = bceModuleWith(15, 10)
	var b @Block = m.Funcs[0].Blocks[0]
	RunOptPasses(m, 1)
	if countBoundsChecks(b) != 1 { return fail("out-of-range const index must keep its check") }
	return ""
}

func TestBCEConstIndexKeepsNegative() testing.TestResult {
	// The check guards the lower bound too (signed index); -1 must still fault.
	var m @Module = bceModuleWith(-1, 10)
	var b @Block = m.Funcs[0].Blocks[0]
	RunOptPasses(m, 1)
	if countBoundsChecks(b) != 1 { return fail("negative const index must keep its check") }
	return ""
}

func TestBCEConstIndexKeepsNonConstLen() testing.TestResult {
	// A slice access has a runtime (non-const) length — never eligible, even
	// with a constant, in-range-looking index.
	var f @Func = NewFunc("", "test", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @Instr = b.EmitConstNil(sliceTyp)
	var idx @Instr = b.EmitConstInt(0, types.TypInt())
	var length @Instr = b.EmitSliceLen(s)
	b.EmitBoundsCheck(idx, length)
	var m @Module = NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countBoundsChecks(b) != 1 { return fail("non-const (slice) length must keep its check") }
	return ""
}

func TestBCEConstIndexGatedByLevel() testing.TestResult {
	// -O0 must not touch any check (gating).
	var m @Module = bceModuleWith(3, 10)
	var b @Block = m.Funcs[0].Blocks[0]
	RunOptPasses(m, 0)
	if countBoundsChecks(b) != 1 { return fail("-O0 must not remove any check") }
	return ""
}

// A local fixed array indexed by a DYNAMIC (non-constant) index must KEEP its
// OP_BOUNDS_CHECK at -O1.  The hand-built bceModuleWith tests above can't reach
// this case: it needs the from-source path, where mem2reg / load-forwarding
// replace the index's param-slot load with the param-reference placeholder.  That
// placeholder used to be spelled OP_CONST_INT (the zero-valued enum default,
// IntVal 0), so bceConstIndex proved `a[j]` "0 <= 0 < len" and silently dropped
// the check — reading out of bounds without a fault at -O1 on every backend.
// OP_PARAM gives the placeholder an honest opcode so no const-folding pass
// mistakes a parameter for the integer constant 0.
func TestBCEKeepsLocalArrayDynamicIndex() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"func g(j int) int {\n"
					"\tvar a [4]int\n"
					"\ta[2] = 7\n"
					"\treturn a[j]\n}\n")
	if len(m.Funcs) < 1 { return fail("setup: expected the gen'd func") }
	var f @Func = m.Funcs[0]
	// -O0 baseline: both a[2] (const) and a[j] (dynamic) carry a check.
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 2 {
		return fail("setup: expected 2 bounds checks before opt")
	}
	RunOptPasses(m, 1)
	// a[2] (0 <= 2 < 4) is statically safe and removed; a[j] MUST survive.
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("dynamic local-array index must keep its bounds check at -O1")
	}
	return ""
}

// A counted loop whose induction variable STARTS from a parameter must keep its
// per-iteration OP_BOUNDS_CHECK at -O1.  bceLoop's lower-bound obligation is
// "init is a const >= 0"; when the param placeholder was OP_CONST_INT/IntVal 0 it
// spuriously satisfied that, so `for i := p; i < N; i++ { a[i] }` dropped the
// check and a negative `p` read out of bounds without faulting.  OP_PARAM makes
// the init non-constant, so the check is (correctly) kept.
func TestBCELoopKeepsCheckWhenInductionStartsFromParam() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"func g(p int) int {\n"
					"\tvar a [4]int\n"
					"\tvar s int = 0\n"
					"\tfor i := p; i < 4; i = i + 1 {\n"
					"\t\ts = s + a[i]\n"
					"\t}\n"
					"\treturn s\n}\n")
	if len(m.Funcs) < 1 { return fail("setup: expected the gen'd func") }
	var f @Func = m.Funcs[0]
	if countOp(f, iropcode.OP_BOUNDS_CHECK) < 1 {
		return fail("setup: expected a bounds check before opt")
	}
	RunOptPasses(m, 1)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("loop check must survive when the induction var starts from a param")
	}
	return ""
}

// A counted loop whose upper BOUND is a parameter must keep its OP_BOUNDS_CHECK at
// -O1.  bceLoop eliminates only when the guard bound L is provably <= the array
// length; when the param placeholder was OP_CONST_INT/IntVal 0, `lengthProvablyLE`
// read the param bound as the constant 0 and "proved" 0 <= len, dropping the check
// — so `for i := 0; i < n; i++ { a[i] }` on a [4]int read out of bounds for n > 4.
// OP_PARAM makes the bound non-constant, so the check is (correctly) kept.
func TestBCELoopKeepsCheckWhenBoundIsParam() testing.TestResult {
	var m @Module = genFromSource(
			"package \"test\"\n"
					"func g(n int) int {\n"
					"\tvar a [4]int\n"
					"\tvar s int = 0\n"
					"\tfor i := 0; i < n; i = i + 1 {\n"
					"\t\ts = s + a[i]\n"
					"\t}\n"
					"\treturn s\n}\n")
	if len(m.Funcs) < 1 { return fail("setup: expected the gen'd func") }
	var f @Func = m.Funcs[0]
	if countOp(f, iropcode.OP_BOUNDS_CHECK) < 1 {
		return fail("setup: expected a bounds check before opt")
	}
	RunOptPasses(m, 1)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("loop check must survive when the upper bound is a param")
	}
	return ""
}
