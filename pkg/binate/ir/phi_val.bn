package "pkg/binate/ir"

// PhiVal returns an owning handle to e's operand (see the declaration).  The
// operand is live — owned by a block, its function's ParamRefs or its module's
// GlobalRefs — so reinterpreting the raw pointer as managed is sound, and the
// caller's assignment takes the reference it needs.
func PhiVal(e PhiEntry) @Instr {
	return unsafe_cast(@Instr, e.Val)
}
