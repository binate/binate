package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for PhiVal (phi_val.bn).

// PhiVal's handle is the operand itself (the same instruction, not a copy).
func TestPhiValIsTheOperand() testing.TestResult {
	var f @Func = NewFunc("", "t", make_slice(@Param, 0), make_slice(@types.Type, 0))
	var v @Instr = NewInstr(f, iropcode.OP_CONST_INT, types.TypInt())
	var e PhiEntry
	e.Val = v
	var h @Instr = PhiVal(e)
	if h != v { return fail("PhiVal must return the operand itself") }
	if PhiVal(e).ID != v.ID { return fail("PhiVal's handle reads the operand's fields") }
	return ""
}
