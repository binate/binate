package "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// SROA Phase-2 MANAGED candidate collection (managed slices `@[]T` with a
// non-managed element, and leaf-managed structs).  These reuse the pad-AWARE L1
// (blockAllocaUsesAreL1 padAware=true) / L2 so the refcount spine's field-ptr /
// whole-load+extract cleanup in FaultPads does not pin the candidate.  Split from
// sroa_transform.bn (file length); the non-managed collection + the field-type
// predicates stay there.

// collectManagedStructCandidates returns the managed-struct allocas eligible for
// scalar replacement: a struct with only leaf-managed fields
// (managedStructLeafEligible), whose uses pass the pad-aware L1 (the inline
// cleanup's field-ptr RefDecs appear in blocks AND FaultPads) and L2, and whose
// whole stores are extractable.  Non-managed fields promote via mem2reg; each
// managed field becomes an unpromoted managed slot with a nil zero-init
// (makeFieldZeroInits), and the cleanup's field load forwards onto it — RefDec'd
// exactly once, mirroring the managed-slice refptr slot.
func collectManagedStructCandidates(f @Func) @[]@Instr {
	var out @[]@Instr
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var a @Instr = blk.Instrs[ii]
			if a.Op != iropcode.OP_ALLOC {
				continue
			}
			if !ManagedStructLeafEligible(a.TypeArg) {
				continue
			}
			if !managedAllocaUsesOK(f, a) {
				continue
			}
			if !managedLoadedValuesAllExtract(f, a) {
				continue
			}
			if !aggregateWholeStoresExtractable(f, a) {
				continue
			}
			out = slices.Append[@Instr](out, a)
		}
	}
	return out
}

// collectManagedSliceCandidates returns the managed-slice allocas eligible for
// Phase-2 scalar replacement: a `@[]T` local whose element type needs no
// destruction (so its refcount spine is just a whole-load + extract-2 of the
// refptr + OP_REFDEC — no whole-value-address elem-dtor escape), used only via
// whole load/store (incl. the refcount spine's whole-load+extract in FaultPads,
// which Phase 1's pad-pinning L1 would reject), with extractable whole stores.
func collectManagedSliceCandidates(f @Func) @[]@Instr {
	var out @[]@Instr
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var a @Instr = blk.Instrs[ii]
			if a.Op != iropcode.OP_ALLOC {
				continue
			}
			var t @types.Type = irutil.PeelTransparent(a.TypeArg)
			if t == nil || t.Kind != types.TYP_MANAGED_SLICE {
				continue
			}
			if !managedSliceElemScalarReplaceable(t) {
				continue
			}
			if !managedAllocaUsesOK(f, a) {
				continue
			}
			if !managedLoadedValuesAllExtract(f, a) {
				continue
			}
			if !aggregateWholeStoresExtractable(f, a) {
				continue
			}
			out = slices.Append[@Instr](out, a)
		}
	}
	return out
}

// managedSliceElemScalarReplaceable reports whether managed-slice type t's element
// permits scalar-replacing the slice.  At -O1+ (the only level SROA runs)
// EmitManagedSliceRefDec emits an EXTRACT-ONLY cleanup for EVERY element kind: a
// plain extract-2(refptr) + OP_REFDEC for a non-destruction element, and
// extract-2(refptr) + extract-3(backingLen) + call __dtor_ms_elems_<T> for a
// destruction-needing element — neither stores the whole slice value to a scratch,
// so the whole-load stays extract-only and the slice forwards.  So any real element
// is admissible; the whole-load L2 check in collectManagedSliceCandidates is the
// backstop that rejects a candidate whose cleanup somehow still materializes the
// value.
func managedSliceElemScalarReplaceable(t @types.Type) bool {
	return t.Elem != nil
}

// managedAllocaUsesOK is the L1 check for a managed-slice candidate, treating
// FaultPad appearances like block appearances (whole load/store — the refcount
// spine's whole-load is allowed) rather than pinning them.  Reuses the Phase-0
// per-block classifier.
func managedAllocaUsesOK(f @Func, a @Instr) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		if !blockAllocaUsesAreL1(f, f.Blocks[bi], a, true) {
			return false
		}
	}
	for pi := 0; pi < len(f.FaultPads); pi++ {
		if !blockAllocaUsesAreL1(f, f.FaultPads[pi], a, true) {
			return false
		}
	}
	return true
}

// managedLoadedValuesAllExtract is L2 for a managed-slice candidate: every whole
// OP_LOAD of a — in blocks AND FaultPads — must have its value used only by
// OP_EXTRACT (valueUsesAllExtract already scans blocks + pads for the uses).
func managedLoadedValuesAllExtract(f @Func, a @Instr) bool {
	if !managedLoadsAllExtractIn(f, f.Blocks, a) {
		return false
	}
	if !managedLoadsAllExtractIn(f, f.FaultPads, a) {
		return false
	}
	return true
}

// managedLoadsAllExtractIn checks the whole loads of a within one block list.
func managedLoadsAllExtractIn(f @Func, blocks @[]@Block, a @Instr) bool {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ld @Instr = blk.Instrs[ii]
			if ld.Op != iropcode.OP_LOAD || len(ld.Args) < 1 || ld.Args[0] != a {
				continue
			}
			if !valueUsesAllExtract(f, ld) {
				return false
			}
		}
	}
	return true
}
