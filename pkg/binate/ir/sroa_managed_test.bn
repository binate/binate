package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for Phase-2 MANAGED-STRUCT scalar replacement (sroa_managed.bn +
// gen_local_cleanup's emitManagedStructPtrDtor reshape + the nil-zero-init drop
// in sroa_rewrite.bn).  Reuses noParams / noResults / noFields / oneRet / countOp
// / instrInBlocks (other _test.bn in this package).

// leafManagedStruct builds `struct { a int; ref @Inner }` — a non-managed int
// field plus one leaf managed-pointer field.
func leafManagedStruct() @types.Type {
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "ref"
	f1.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = f0
	fields[1] = f1
	return types.MakeStructType("Holder", fields)
}

// A leaf-managed struct (int + @Inner) scalar-replaces: the int field slot
// promotes away, the managed field slot survives as an unpromoted managed slot
// with a nil zero-init (makeFieldZeroInits), and the cleanup's field load forwards
// onto it.
func TestSroaLeafManagedStructSplit() testing.TestResult {
	var st @types.Type = leafManagedStruct()
	var mpTyp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var h @Instr = entry.EmitAlloc(st)
	entry.EmitStore(entry.EmitGetFieldPtr(h, 0, types.TypInt()), entry.EmitConstInt(5, types.TypInt()))
	var av @Instr = entry.EmitLoad(entry.EmitGetFieldPtr(h, 0, types.TypInt()), types.TypInt())
	entry.EmitReturn(oneRet(av))
	// scope-exit cleanup: RefDec h.ref (the inline reshape's field-ptr shape).
	entry.EmitRefDec(entry.EmitLoad(entry.EmitGetFieldPtr(h, 1, mpTyp), mpTyp))

	if !sroaFunc(f) {
		return fail("SROA: a leaf-managed struct should be scalar-replaced")
	}
	if instrInBlocks(f, h) {
		return fail("SROA: the whole Holder alloca should be gone")
	}
	if countOp(f, iropcode.OP_CONST_NIL) < 1 {
		return fail("SROA: the managed field slot needs an explicit nil zero-init")
	}
	promoteFuncScalars(f)
	// The int slot promotes; only the managed field slot survives.
	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("SROA + mem2reg: only the managed field slot should remain")
	}
	return ""
}

// The cleanup field-ptrs of a managed struct legitimately appear in a FAULT PAD
// (emitManagedStructPtrDtor runs for the pad too); the pad-aware L1 must admit
// them rather than pin the struct on the pad appearance.
func TestSroaManagedStructFaultPadCleanupSplit() testing.TestResult {
	var st @types.Type = leafManagedStruct()
	var mpTyp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var h @Instr = entry.EmitAlloc(st)
	entry.EmitStore(entry.EmitGetFieldPtr(h, 0, types.TypInt()), entry.EmitConstInt(5, types.TypInt()))
	entry.EmitReturn(
			oneRet(entry.EmitLoad(entry.EmitGetFieldPtr(h, 0, types.TypInt()), types.TypInt())))
	entry.EmitRefDec(entry.EmitLoad(entry.EmitGetFieldPtr(h, 1, mpTyp), mpTyp)) // block cleanup
	var pad @Block = AddFaultPad(f, "pad")
	pad.EmitRefDec(pad.EmitLoad(pad.EmitGetFieldPtr(h, 1, mpTyp), mpTyp)) // pad cleanup (field-ptr)
	pad.EmitUnwindReturn()

	if !sroaFunc(f) {
		return fail("SROA: a managed struct with pad field-ptr cleanup should split")
	}
	if instrInBlocks(f, h) {
		return fail("SROA: the Holder alloca should be gone (pad-aware L1)")
	}
	return ""
}

// A whole-store of OP_CONST_NIL (the `var h S` managed-struct zero-init) is
// dropped in the rewrite — the candidate still splits, and no OP_EXTRACT of a nil
// is emitted (makeFieldZeroInits + mem2reg cover the per-field zeros).
func TestSroaManagedStructNilZeroInitDropped() testing.TestResult {
	var st @types.Type = leafManagedStruct()
	var mpTyp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var h @Instr = entry.EmitAlloc(st)
	var nilVal @Instr = entry.EmitConstNil(st)
	entry.EmitStore(h, nilVal) // whole-store nil zero-init
	entry.EmitStore(entry.EmitGetFieldPtr(h, 0, types.TypInt()), entry.EmitConstInt(5, types.TypInt()))
	entry.EmitReturn(
			oneRet(entry.EmitLoad(entry.EmitGetFieldPtr(h, 0, types.TypInt()), types.TypInt())))
	entry.EmitRefDec(entry.EmitLoad(entry.EmitGetFieldPtr(h, 1, mpTyp), mpTyp))

	if !sroaFunc(f) {
		return fail("SROA: a nil-zero-init managed struct should still split")
	}
	if instrInBlocks(f, h) {
		return fail("SROA: the Holder alloca should be gone")
	}
	if instrInBlocks(f, nilVal) {
		return fail("SROA: the dead OP_CONST_NIL zero-init value should be deleted too")
	}
	return ""
}

// A managed struct with a nested LEAF-managed struct field (`struct { a int;
// nested struct { ref @Inner } }`) is leaf-eligible (isLeafManagedField recurses)
// and SPLITS: the -O1+ inline cleanup recurses to field-ptr RefDecs on the nested
// field-ptr, so the outer splits, the nested struct field becomes its own slot,
// and the fixpoint scalar-replaces that too — leaving only the @Inner managed leaf
// slot after mem2reg.
func TestSroaNestedManagedStructFieldSplit() testing.TestResult {
	var mpTyp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	// inner: struct { ref @Inner } — a nested managed-containing struct, all-leaf
	var innerRef @types.Field = make(types.Field)
	innerRef.Name = "ref"
	innerRef.Type = mpTyp
	var innerFields @[]@types.Field = make_slice(@types.Field, 1)
	innerFields[0] = innerRef
	var innerStruct @types.Type = types.MakeStructType("Boxed", innerFields)

	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "nested"
	f1.Type = innerStruct
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = f0
	fields[1] = f1
	var st @types.Type = types.MakeStructType("Outer", fields)

	if !managedStructLeafEligible(st) {
		return fail("SROA: a struct with a nested LEAF-managed struct field must be leaf-eligible")
	}
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var h @Instr = entry.EmitAlloc(st)
	entry.EmitStore(entry.EmitGetFieldPtr(h, 0, types.TypInt()), entry.EmitConstInt(5, types.TypInt()))
	entry.EmitReturn(
			oneRet(entry.EmitLoad(entry.EmitGetFieldPtr(h, 0, types.TypInt()), types.TypInt())))
	// scope-exit cleanup, the inlineNested shape: RefDec h.nested.ref via a two-level
	// field-ptr chain (GET_FIELD_PTR(h,1) then GET_FIELD_PTR(.,0) then load+RefDec).
	var nfp @Instr = entry.EmitGetFieldPtr(h, 1, innerStruct)
	var rfp @Instr = entry.EmitGetFieldPtr(nfp, 0, mpTyp)
	entry.EmitRefDec(entry.EmitLoad(rfp, mpTyp))

	sroaFuncToFixpoint(f)
	if instrInBlocks(f, h) {
		return fail("SROA: the outer Outer alloca should be gone (nested-struct split)")
	}
	promoteFuncScalars(f)
	// The int slot promotes; the nested struct field slot splits; only the @Inner
	// managed leaf slot survives.
	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("SROA + mem2reg: only the nested @Inner managed leaf slot should remain")
	}
	return ""
}

// A nested struct field that is itself NON-leaf — it holds a `@[]@Inner` (a managed
// slice with a managed element, whose cleanup is a by-address ms-dtor call, not a
// forwardable load+RefDec) — keeps the OUTER struct INELIGIBLE (managedStructLeaf-
// Eligible recurses and rejects), so it stays pinned (deferred: increment 2b).
func TestSroaNestedNonLeafStructFieldPinned() testing.TestResult {
	var mpElem @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var msTyp @types.Type = types.MakeManagedSliceType(mpElem) // @[]@Inner — managed element
	var innerItems @types.Field = make(types.Field)
	innerItems.Name = "items"
	innerItems.Type = msTyp
	var innerFields @[]@types.Field = make_slice(@types.Field, 1)
	innerFields[0] = innerItems
	var innerStruct @types.Type = types.MakeStructType("Bag", innerFields)

	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "nested"
	f1.Type = innerStruct // a nested NON-leaf struct (holds @[]@Inner)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = f0
	fields[1] = f1
	var st @types.Type = types.MakeStructType("Outer2", fields)

	if managedStructLeafEligible(st) {
		return fail("SROA: a struct with a nested NON-leaf struct field must NOT be leaf-eligible")
	}
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var h @Instr = entry.EmitAlloc(st)
	entry.EmitStore(entry.EmitGetFieldPtr(h, 0, types.TypInt()), entry.EmitConstInt(5, types.TypInt()))
	entry.EmitReturn(
			oneRet(entry.EmitLoad(entry.EmitGetFieldPtr(h, 0, types.TypInt()), types.TypInt())))

	sroaFuncToFixpoint(f)
	if !instrInBlocks(f, h) {
		return fail("SROA: a nested-NON-leaf-struct-field struct must stay pinned")
	}
	return ""
}
