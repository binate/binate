package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SROA rewrite mechanics (sroa_rewrite.bn), exercised end to end
// via sroaFunc: scalar replacement of field-accessed structs, extractable
// whole-store copies, whole-load extract-forwarding, unstored-field zero-init,
// and raw-slice {data,len} splitting (then mem2reg promotion).  Reuses
// twoIntStruct (sroa_test.bn) and instrInBlocks (sroa_transform_test.bn).

// A field-accessed POD struct is scalar-replaced: the struct alloca and every
// field-ptr vanish, replaced by one scalar alloca per field, which mem2reg then
// promotes away entirely.
func TestSroaStructScalarReplaced() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(twoIntStruct())
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(7, types.TypInt()))
	var fp1 @Instr = entry.EmitGetFieldPtr(s, 1, types.TypInt())
	entry.EmitStore(fp1, entry.EmitConstInt(9, types.TypInt()))
	var fp0b @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var v @Instr = entry.EmitLoad(fp0b, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: every field-ptr of the struct should be gone")
	}
	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail("SROA: the struct alloca should become two scalar field allocas")
	}

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("SROA+mem2reg: field slots should be fully promoted away")
	}
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: return should forward the stored field-0 constant 7")
	}
	return ""
}

// A field never explicitly stored reads back as zero after SROA + mem2reg
// (mem2reg's undef-load-to-zero), matching struct zero-init semantics.
func TestSroaStructUnstoredFieldIsZero() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(twoIntStruct())
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(5, types.TypInt()))
	// field 1 is never stored; reading it must yield zero.
	var fp1 @Instr = entry.EmitGetFieldPtr(s, 1, types.TypInt())
	var v @Instr = entry.EmitLoad(fp1, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)
	promoteFuncScalars(f)

	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 0 {
		return fail("SROA+mem2reg: an unstored field must read back as zero")
	}
	return ""
}

// A whole OP_STORE whose value is a load result (a struct copy `t = s`) is
// scalarized into per-field OP_EXTRACT + OP_STORE; the copied-to alloca is split.
func TestSroaStructWholeStoreFromLoadScalarized() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var other @Instr = entry.EmitAlloc(st)
	var s @Instr = entry.EmitAlloc(st)
	var v @Instr = entry.EmitLoad(other, st) // struct value (copy source)
	entry.EmitStore(s, v) // whole store `s = other` — extractable value
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var r @Instr = entry.EmitLoad(fp0, types.TypInt())
	entry.EmitReturn(oneRet(r))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: field-ptr should be gone after whole-store scalarization")
	}
	if countOp(f, iropcode.OP_EXTRACT) != 2 {
		return fail("SROA: a whole store should scalarize into one extract per field")
	}
	return ""
}

// The whole-LOAD scalarization path: a candidate whose whole value is loaded and
// consumed only by OP_EXTRACT gets per-field loads at the load site, the extracts
// rewritten to them; the whole load and extracts vanish.  (Gen doesn't produce
// this shape for plain structs — field reads use GET_FIELD_PTR — so it is
// exercised here by hand; it is the machinery the raw-slice phase reuses.)
func TestSroaStructWholeLoadForwarded() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @Instr = entry.EmitAlloc(st)
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(7, types.TypInt()))
	var fp1 @Instr = entry.EmitGetFieldPtr(s, 1, types.TypInt())
	entry.EmitStore(fp1, entry.EmitConstInt(9, types.TypInt()))
	var v @Instr = entry.EmitLoad(s, st) // whole load; value used only by extract
	var e0 @Instr = entry.EmitExtract(v, 0, types.TypInt())
	entry.EmitReturn(oneRet(e0))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 || countOp(f, iropcode.OP_EXTRACT) != 0 {
		return fail("SROA: whole load + extract should be replaced by per-field loads")
	}

	promoteFuncScalars(f)

	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: the forwarded field-0 load should carry the stored 7")
	}
	return ""
}

// A raw slice initialized from the managed->raw decay (OP_MANAGED_TO_RAW — the
// `var s *[]T = make_slice(...)` shape) is scalar-replaced: OP_MANAGED_TO_RAW is
// a whitelisted extractable store value, and the managed source slice is left
// alone (managed).
func TestSroaRawSliceFromManagedToRawScalarReplaced() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var slt @types.Type = types.MakeSliceType(types.TypInt())
	var msAlloc @Instr = entry.EmitAlloc(mst)
	var mv @Instr = entry.EmitLoad(msAlloc, mst)
	var raw @Instr = entry.EmitManagedToRaw(mv) // OP_MANAGED_TO_RAW value
	var s @Instr = entry.EmitAlloc(slt)
	entry.EmitStore(s, raw) // whole store of a managed->raw value
	var sv @Instr = entry.EmitLoad(s, slt)
	var lenv @Instr = entry.EmitSliceLen(sv)
	entry.EmitReturn(oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a raw slice from OP_MANAGED_TO_RAW should be scalar-replaced")
	}
	if !instrInBlocks(f, msAlloc) {
		return fail("SROA: the managed source slice must be left untouched")
	}
	return ""
}

// A raw-slice local (`*[]int`) accessed via whole-load + OP_EXTRACT (len) and
// whole-stored from an extractable value is scalar-replaced into its {data,len}
// field slots.
func TestSroaRawSliceScalarReplaced() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var slt @types.Type = types.MakeSliceType(types.TypInt())
	var other @Instr = entry.EmitAlloc(slt)
	var s @Instr = entry.EmitAlloc(slt)
	var v @Instr = entry.EmitLoad(other, slt) // slice value (extractable)
	entry.EmitStore(s, v) // whole store `s = other`
	var sv @Instr = entry.EmitLoad(s, slt) // whole load
	var lenv @Instr = entry.EmitSliceLen(sv) // OP_EXTRACT(sv, 1)
	entry.EmitReturn(oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a raw-slice local should be scalar-replaced")
	}
	if !instrInBlocks(f, other) {
		return fail("SROA: the pinned source slice should remain")
	}
	return ""
}

// A managed slice of non-managed elements (`@[]int`) is scalar-replaced (Phase 2):
// data/len/backinglen promote, and the refptr goes to a managed field slot with
// an explicit nil zero-init.  The refcount spine (whole-load + extract-2) is
// forwarded to that slot.  The pinned copy source (its load feeds the store)
// remains.
func TestSroaManagedSliceScalarReplaced() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var other @Instr = entry.EmitAlloc(mst)
	var v @Instr = entry.EmitLoad(other, mst) // extractable managed-slice value
	var s @Instr = entry.EmitAlloc(mst)
	entry.EmitStore(s, v) // whole store `s = other`
	var sv @Instr = entry.EmitLoad(s, mst)
	var lenv @Instr = entry.EmitSliceLen(sv)
	entry.EmitReturn(oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a managed @[]int should be scalar-replaced (Phase 2)")
	}
	if !instrInBlocks(f, other) {
		return fail("SROA: the pinned copy source should remain")
	}
	if countOp(f, iropcode.OP_CONST_NIL) < 1 {
		return fail("SROA: the refptr field slot needs an explicit nil zero-init")
	}
	return ""
}
