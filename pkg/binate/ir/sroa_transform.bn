package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// SROA rewrite — Phase 1: NON-MANAGED, ALL-PROMOTABLE-FIELD STRUCTS.
//
// Consumes the Phase-0 eligibility analysis (sroa.bn).  For a splittable
// non-managed struct alloca whose every field is a mem2reg-promotable scalar,
// this creates one scalar alloca per field, rewrites the aggregate's accesses
// onto those field slots, and deletes the aggregate alloca.  mem2reg
// (promoteScalars, run right after this in RunOptPasses) then promotes the field
// slots to SSA, collapsing the field-by-field stack traffic the native backends
// emit for a local struct.
//
// The four access kinds a candidate alloca `a` can have (L1 admits only these),
// and how each is rewritten:
//   - OP_GET_FIELD_PTR(a, i)  -> replaced by the field alloca fa[i] (its load /
//     store consumers then load/store the scalar slot directly).
//   - whole OP_STORE(a, val)  -> per-field OP_STORE(fa[i], OP_EXTRACT(val, i)).
//     Sound ONLY when val is a coercion-free first-class aggregate value
//     (isExtractableAggregateValue) — a copy's load result.  An ABI-coerced call
//     result and a byval-param-ref (a `ptr`) are NOT extractvalue-able, so such a
//     candidate is pinned (see collectSroaStructCandidates).
//   - whole OP_LOAD(a)        -> per-field OP_LOAD(fa[i]) at the load's position;
//     each OP_EXTRACT(load, i) consumer is rewritten to fl[i].  L2 guarantees a
//     whole load's value is used only by OP_EXTRACT.
//   - the OP_ALLOC(a) itself   -> replaced by the fa[i] allocas.
//
// SCOPE gates (soundness):
//   - Non-managed structs only — a managed field needs refcount / fault-pad
//     handling and never reaches here (sroaAggregateContainsManaged excludes it,
//     and a non-managed struct never appears in a FaultPad).
//   - All fields mem2reg-promotable — deleting the struct alloca drops the
//     backend's implicit whole-struct zero-fill, so a field never explicitly
//     stored is recovered as zero ONLY by mem2reg zero-forwarding its undef load,
//     which needs the field slot to be promotable.
//   - Raw slices and managed aggregates are later phases.

// sroaStoreExp pairs each whole-store instruction (void, so not id-keyable) with
// the per-field extract+store instructions that replace it in the rebuild.
type sroaStoreExp struct {
	stores @[]@Instr
	exps   @[]@[]@Instr
}

// runSroa applies non-managed struct scalar replacement to every non-extern func
// in the module.  Invoked by RunOptPasses at -O1+, BEFORE promoteScalars.
func runSroa(m @Module) {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @Func = m.Funcs[fi]
		if f.IsExtern {
			continue
		}
		sroaFunc(f)
	}
}

// sroaFunc scalar-replaces every splittable non-managed struct alloca in f.
func sroaFunc(f @Func) {
	if len(f.Blocks) == 0 {
		return
	}
	var cands @[]@Instr = collectSroaStructCandidates(f)
	if len(cands) == 0 {
		return
	}
	validateSroaCandidates(f, cands) // fail-loud precondition guard (L1 + L2)

	// Per-alloca field slots, keyed by the ORIGINAL alloca id.  New instrs get
	// ids >= the original NextID; the id-keyed tables are sized to that original
	// NextID, so new ids fall outside them (guarded lookups).
	var origCap int = f.NextID
	var isCand @[]bool = boolTable(origCap)
	var fieldsOf @[]@[]@Instr = instrListTable(origCap)
	for ci := 0; ci < len(cands); ci++ {
		var a @Instr = cands[ci]
		isCand[a.ID] = true
		fieldsOf[a.ID] = makeFieldAllocas(f, a)
	}

	// Plan the rewrite: mark dropped instrs, build per-field loads for whole
	// loads, and collect the void whole-store expansions.  This creates all new
	// instrs, so f.NextID is final afterward.
	var deleted @[]bool = boolTable(origCap)
	var loadExp @[]@[]@Instr = instrListTable(origCap)
	var se @sroaStoreExp = planStructRewrite(f, isCand, fieldsOf, deleted, loadExp, origCap)

	// repl (field-ptr -> field alloca; extract -> per-field load) is keyed by
	// original id but sized to the final NextID so rewriteUsesInBlocks' bounds
	// check covers every id, including the new instrs it walks.
	var repl @[]@Instr = instrTable(f.NextID)
	fillReplacements(f, isCand, fieldsOf, deleted, loadExp, repl, origCap)

	rebuildSroaBlocks(f, isCand, fieldsOf, deleted, loadExp, se, origCap)
	rewriteUsesInBlocks(f.Blocks, repl, f.NextID)
	rewriteUsesInBlocks(f.FaultPads, repl, f.NextID)
	assertNoSurvivingSroaUses(f, deleted, origCap)
}

// collectSroaStructCandidates filters the Phase-0 candidate set to this phase's
// scope: a struct alloca with no managed field, all fields promotable, and every
// whole store into it carrying an extractable aggregate value.
func collectSroaStructCandidates(f @Func) @[]@Instr {
	var out @[]@Instr
	var all @[]@Instr = collectSroaCandidates(f)
	for i := 0; i < len(all); i++ {
		var a @Instr = all[i]
		var t @types.Type = peelTransparent(a.TypeArg)
		if t == nil || t.Kind != types.TYP_STRUCT {
			continue
		}
		if sroaAggregateContainsManaged(a.TypeArg) {
			continue
		}
		if !structFieldsAllPromotable(t) {
			continue
		}
		if !structWholeStoresExtractable(f, a) {
			continue
		}
		out = slices.Append[@Instr](out, a)
	}
	return out
}

// isScalarPromotableType reports whether an OP_ALLOC of type t is one mem2reg
// can promote a phi of: int (<= target word), bool, or a raw pointer.  Float /
// managed / aggregate are excluded.  The shared promotable-type predicate for
// mem2reg's isPromotableAlloca AND SROA's structFieldsAllPromotable, so SROA
// splits a struct only when mem2reg will then promote every field slot (and
// zero-forward any field with no reaching store, recovering the deleted struct
// alloca's implicit backend zero-fill; a non-promotable field slot would read
// stack garbage).
func isScalarPromotableType(t @types.Type) bool {
	t = peelToRepr(t)
	if t == nil {
		return false
	}
	if t.Kind == types.TYP_INT {
		return t.Width <= types.TypInt().Width
	}
	if t.Kind == types.TYP_BOOL {
		return true
	}
	if t.Kind == types.TYP_POINTER {
		return true
	}
	return false
}

// structFieldsAllPromotable reports whether EVERY field of struct type t is a
// mem2reg-promotable scalar (see isScalarPromotableType — required for zero-init
// safety after the struct alloca is deleted).
func structFieldsAllPromotable(t @types.Type) bool {
	t = peelTransparent(t)
	if t == nil {
		return false
	}
	for i := 0; i < len(t.Fields); i++ {
		if !isScalarPromotableType(t.Fields[i].Type) {
			return false
		}
	}
	return true
}

// structWholeStoresExtractable reports whether every whole OP_STORE into alloca a
// carries an extractable aggregate value.  a has already passed L1, so its only
// alloca uses are whole load/store + field-ptr; a whole load's value is
// extract-only by L2.  A whole store whose value is NOT extractable (e.g. a
// byval-param-ref `ptr`) cannot be scalarized via OP_EXTRACT, so it pins a.
func structWholeStoresExtractable(f @Func, a @Instr) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			if instr.Op != iropcode.OP_STORE || len(instr.Args) < 2 || instr.Args[0] != a {
				continue
			}
			if !isExtractableAggregateValue(instr.Args[1]) {
				return false
			}
		}
	}
	return true
}

// isExtractableAggregateValue reports whether val is a first-class aggregate SSA
// value that OP_EXTRACT can read a field from WITHOUT ABI-coercion trouble: a
// memory load result, or a nested extract.  Both are the aggregate's plain
// in-representation value.  A CALL result is deliberately EXCLUDED: the backends
// coerce a by-value aggregate return to the call ABI shape (e.g. a 2-word struct
// to `[2 x i64]`), so OP_EXTRACT on it emits a type-mismatched extractvalue
// (`extractvalue [2 x i64] %call, 0` where %call is typed as the struct).  A
// byval-param-ref (OP_PARAM, physically a `ptr`) and an alloca pointer
// (OP_ALLOC) are likewise excluded.  Coerced-value producers (calls) are a
// follow-up (scalarize via the un-coercion path, not extractvalue).
func isExtractableAggregateValue(val @Instr) bool {
	if val == nil {
		return false
	}
	return val.Op == iropcode.OP_LOAD || val.Op == iropcode.OP_EXTRACT
}

// makeFieldAllocas creates one OP_ALLOC per field of struct alloca a, typed by
// the field's declared type (the same index OP_GET_FIELD_PTR / OP_EXTRACT use).
func makeFieldAllocas(f @Func, a @Instr) @[]@Instr {
	var t @types.Type = peelTransparent(a.TypeArg)
	var out @[]@Instr
	for i := 0; i < len(t.Fields); i++ {
		var ft @types.Type = stripConstForIR(t.Fields[i].Type)
		var fa @Instr = newInstr(f, iropcode.OP_ALLOC, types.MakePointerType(ft))
		fa.TypeArg = ft
		fa.Line = a.Line
		out = slices.Append[@Instr](out, fa)
	}
	return out
}

// planStructRewrite marks the id-keyable dropped instrs (candidate alloca, whole
// load, field-ptr, extract-of-whole-load), builds each whole load's per-field
// loads into loadExp, and returns the whole-store expansions (which are void, so
// carried in a side list rather than an id table).
func planStructRewrite(f @Func, isCand @[]bool, fieldsOf @[]@[]@Instr, deleted @[]bool,
		loadExp @[]@[]@Instr, origCap int) @sroaStoreExp {
	var se @sroaStoreExp = make(sroaStoreExp)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			if instrIsCandAlloca(instr, isCand, origCap) {
				deleted[instr.ID] = true
				continue
			}
			if isWholeStoreOfCand(instr, isCand, origCap) {
				se.stores = slices.Append[@Instr](se.stores, instr)
				se.exps = slices.Append[@[]@Instr](se.exps, expandWholeStore(f, instr, fieldsOf))
				continue
			}
			if isWholeLoadOfCand(instr, isCand, origCap) {
				deleted[instr.ID] = true
				loadExp[instr.ID] = expandWholeLoad(f, instr, fieldsOf)
				continue
			}
			if isFieldPtrOfCand(instr, isCand, origCap) {
				deleted[instr.ID] = true // dropped; its uses are rewritten via repl
			}
		}
	}
	// Extracts of a whole load are dropped once the load is (their uses rewrite
	// to the per-field loads).  Second pass so every whole load is marked first.
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			if isExtractOfDeletedLoad(instr, deleted, origCap) {
				deleted[instr.ID] = true
			}
		}
	}
	return se
}

// fillReplacements records the SSA-value rewrites: each field-ptr of a candidate
// becomes its field alloca, and each extract of a (now-deleted) whole load
// becomes the matching per-field load created by expandWholeLoad.
func fillReplacements(f @Func, isCand @[]bool, fieldsOf @[]@[]@Instr, deleted @[]bool,
		loadExp @[]@[]@Instr, repl @[]@Instr, origCap int) {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			if isFieldPtrOfCand(instr, isCand, origCap) {
				var a @Instr = instr.Args[0]
				repl[instr.ID] = fieldsOf[a.ID][instr.Index]
				continue
			}
			if isExtractOfDeletedLoad(instr, deleted, origCap) {
				var ld @Instr = instr.Args[0]
				repl[instr.ID] = fieldLoadForIndex(loadExp[ld.ID], instr.Index)
			}
		}
	}
}

// expandWholeStore lowers OP_STORE(alloca, val) into per-field
// OP_STORE(fieldAlloca_i, OP_EXTRACT(val, i)).
func expandWholeStore(f @Func, store @Instr, fieldsOf @[]@[]@Instr) @[]@Instr {
	var a @Instr = store.Args[0]
	var val @Instr = store.Args[1]
	var fields @[]@Instr = fieldsOf[a.ID]
	var out @[]@Instr
	for i := 0; i < len(fields); i++ {
		var fa @Instr = fields[i]
		var ex @Instr = newInstr(f, iropcode.OP_EXTRACT, fa.TypeArg)
		ex.Args = makeArgs1(val)
		ex.Index = i
		ex.Line = store.Line
		var st @Instr = newVoidInstr(iropcode.OP_STORE)
		st.Args = makeArgs2(fa, ex)
		st.Line = store.Line
		out = slices.Append[@Instr](out, ex)
		out = slices.Append[@Instr](out, st)
	}
	return out
}

// expandWholeLoad materializes, at the whole load's position, one
// OP_LOAD(fieldAlloca_i) per field (reading the snapshot at the load point; the
// extracts that consumed the whole value are rewritten to reference these).
func expandWholeLoad(f @Func, load @Instr, fieldsOf @[]@[]@Instr) @[]@Instr {
	var a @Instr = load.Args[0]
	var fields @[]@Instr = fieldsOf[a.ID]
	var out @[]@Instr
	for i := 0; i < len(fields); i++ {
		var fa @Instr = fields[i]
		var fl @Instr = newInstr(f, iropcode.OP_LOAD, fa.TypeArg)
		fl.Args = makeArgs1(fa)
		fl.Line = load.Line
		out = slices.Append[@Instr](out, fl)
	}
	return out
}

// fieldLoadForIndex returns the per-field load at field index idx from a whole
// load's expansion (produced by expandWholeLoad, one entry per field in order).
func fieldLoadForIndex(loads @[]@Instr, idx int) @Instr {
	if idx >= 0 && idx < len(loads) {
		return loads[idx]
	}
	var none @Instr
	return none
}

// rebuildSroaBlocks rewrites each block's instruction list: a candidate alloca
// becomes its field allocas, a whole store becomes its per-field extract+store
// expansion, a whole load becomes its per-field loads, a dropped field-ptr /
// extract is removed, everything else is kept in order.
func rebuildSroaBlocks(f @Func, isCand @[]bool, fieldsOf @[]@[]@Instr, deleted @[]bool,
		loadExp @[]@[]@Instr, se @sroaStoreExp, origCap int) {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @Block = f.Blocks[bi]
		var kept @[]@Instr
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			if instrIsCandAlloca(instr, isCand, origCap) {
				kept = appendAll(kept, fieldsOf[instr.ID])
				continue
			}
			if isWholeStoreOfCand(instr, isCand, origCap) {
				kept = appendAll(kept, lookupStoreExp(se, instr))
				continue
			}
			if instr.ID >= 0 && instr.ID < origCap && deleted[instr.ID] {
				// whole load -> per-field loads; field-ptr / extract -> dropped (empty).
				kept = appendAll(kept, loadExp[instr.ID])
				continue
			}
			kept = slices.Append[@Instr](kept, instr)
		}
		blk.Instrs = kept
	}
}

// lookupStoreExp returns the expansion recorded for whole-store instr (matched by
// identity, since a void store has no usable id), or empty if not found.
func lookupStoreExp(se @sroaStoreExp, store @Instr) @[]@Instr {
	for k := 0; k < len(se.stores); k++ {
		if se.stores[k] == store {
			return se.exps[k]
		}
	}
	var none @[]@Instr
	return none
}

// appendAll appends every element of src to dst and returns the result.
func appendAll(dst @[]@Instr, src @[]@Instr) @[]@Instr {
	for i := 0; i < len(src); i++ {
		dst = slices.Append[@Instr](dst, src[i])
	}
	return dst
}

// assertNoSurvivingSroaUses fails loud if any operand still references a deleted
// (SROA-removed) alloca / field-ptr / whole load / extract after the rewrite —
// such a reference would be a miscompile (an under-approximated escape, or a
// non-unique id).
func assertNoSurvivingSroaUses(f @Func, deleted @[]bool, origCap int) {
	assertNoSurvivingSroaUsesIn(f.Blocks, deleted, origCap)
	assertNoSurvivingSroaUsesIn(f.FaultPads, deleted, origCap)
}

// assertNoSurvivingSroaUsesIn is assertNoSurvivingSroaUses over one block list.
func assertNoSurvivingSroaUsesIn(blocks @[]@Block, deleted @[]bool, origCap int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @Instr = blk.Instrs[ii]
			for k := 0; k < len(instr.Args); k++ {
				checkNoSurvivingSroaUse(instr.Args[k], deleted, origCap)
			}
			for k := 0; k < len(instr.Phis); k++ {
				checkNoSurvivingSroaUse(instr.Phis[k].Val, deleted, origCap)
			}
		}
	}
}

// checkNoSurvivingSroaUse panics if v is a deleted (SROA-removed) instruction.
func checkNoSurvivingSroaUse(v @Instr, deleted @[]bool, origCap int) {
	if v == nil || v.ID < 0 || v.ID >= origCap {
		return
	}
	if deleted[v.ID] {
		panic("ir SROA: a deleted instruction is still referenced after rewrite")
	}
}

// boolTable returns a length-n @[]bool initialized to false.
func boolTable(n int) @[]bool {
	var out @[]bool
	for i := 0; i < n; i++ {
		out = slices.Append[bool](out, false)
	}
	return out
}

// instrTable returns a length-n @[]@Instr initialized to nil.
func instrTable(n int) @[]@Instr {
	var out @[]@Instr
	for i := 0; i < n; i++ {
		var none @Instr
		out = slices.Append[@Instr](out, none)
	}
	return out
}

// instrListTable returns a length-n @[]@[]@Instr of empty lists.
func instrListTable(n int) @[]@[]@Instr {
	var out @[]@[]@Instr
	for i := 0; i < n; i++ {
		var empty @[]@Instr
		out = slices.Append[@[]@Instr](out, empty)
	}
	return out
}

// arg0IsCand reports whether instr's Args[0] is a candidate alloca (by original id).
func arg0IsCand(instr @Instr, isCand @[]bool, origCap int) bool {
	if len(instr.Args) < 1 {
		return false
	}
	var a @Instr = instr.Args[0]
	return a != nil && a.ID >= 0 && a.ID < origCap && isCand[a.ID]
}

// instrIsCandAlloca reports whether instr is a candidate alloca.
func instrIsCandAlloca(instr @Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_ALLOC && instr.ID >= 0 && instr.ID < origCap && isCand[instr.ID]
}

// isWholeStoreOfCand reports whether instr is a whole OP_STORE into a candidate.
func isWholeStoreOfCand(instr @Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_STORE && arg0IsCand(instr, isCand, origCap)
}

// isWholeLoadOfCand reports whether instr is a whole OP_LOAD of a candidate.
func isWholeLoadOfCand(instr @Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_LOAD && arg0IsCand(instr, isCand, origCap)
}

// isFieldPtrOfCand reports whether instr is a const-index OP_GET_FIELD_PTR of a
// candidate.
func isFieldPtrOfCand(instr @Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_GET_FIELD_PTR && arg0IsCand(instr, isCand, origCap)
}

// isExtractOfDeletedLoad reports whether instr is an OP_EXTRACT whose source is a
// (candidate) whole load already marked deleted.
func isExtractOfDeletedLoad(instr @Instr, deleted @[]bool, origCap int) bool {
	if instr.Op != iropcode.OP_EXTRACT || len(instr.Args) < 1 {
		return false
	}
	var src @Instr = instr.Args[0]
	if src == nil || src.Op != iropcode.OP_LOAD || src.ID < 0 || src.ID >= origCap {
		return false
	}
	return deleted[src.ID]
}
