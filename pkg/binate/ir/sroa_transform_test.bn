package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SROA Phase-1 field-ptr-only struct rewrite (sroa_transform.bn):
// scalar replacement of field-accessed structs (then mem2reg promotion), and the
// leave-alone cases (whole-store, managed struct, whole-value-returned).  Reuses
// the package-shared twoIntStruct (sroa_test.bn), oneRet, countOp, fail helpers.

// managedFieldStruct builds `struct { Ref @Inner }` — a managed aggregate.
func managedFieldStruct() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	fields[0] = f0
	return types.MakeStructType("Boxed", fields)
}

// A field-accessed POD struct is scalar-replaced: the struct alloca and every
// field-ptr vanish, replaced by one scalar alloca per field, which mem2reg then
// promotes away entirely.
func TestSroaStructScalarReplaced() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(twoIntStruct())
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(7, types.TypInt()))
	var fp1 @Instr = entry.EmitGetFieldPtr(s, 1, types.TypInt())
	entry.EmitStore(fp1, entry.EmitConstInt(9, types.TypInt()))
	var fp0b @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var v @Instr = entry.EmitLoad(fp0b, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: every field-ptr of the struct should be gone")
	}
	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail("SROA: the struct alloca should become two scalar field allocas")
	}

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("SROA+mem2reg: field slots should be fully promoted away")
	}
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: return should forward the stored field-0 constant 7")
	}
	return ""
}

// A field never explicitly stored reads back as zero after SROA + mem2reg
// (mem2reg's undef-load-to-zero), matching struct zero-init semantics.
func TestSroaStructUnstoredFieldIsZero() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(twoIntStruct())
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(5, types.TypInt()))
	// field 1 is never stored; reading it must yield zero.
	var fp1 @Instr = entry.EmitGetFieldPtr(s, 1, types.TypInt())
	var v @Instr = entry.EmitLoad(fp1, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)
	promoteFuncScalars(f)

	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 0 {
		return fail("SROA+mem2reg: an unstored field must read back as zero")
	}
	return ""
}

// A struct with a whole OP_STORE (its value could be a byval-param-ref, not an
// extractable aggregate) is left untouched — this increment is field-ptr-only.
func TestSroaStructWithWholeStorePinned() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @Instr = entry.EmitAlloc(st)
	var mk @Instr = entry.EmitCall("mk", noArgs, st) // a struct-valued producer
	entry.EmitStore(s, mk) // whole store — pins the slot in this increment
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var v @Instr = entry.EmitLoad(fp0, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("SROA: a struct with a whole store must be left untouched (field-ptr-only)")
	}
	return ""
}

// A struct with a non-promotable (float) field is left untouched: splitting it
// would drop the whole-struct zero-fill, and mem2reg can't promote the float
// slot, so an unwritten float field would read stack garbage instead of zero.
func TestSroaStructWithFloatFieldPinned() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "f"
	f1.Type = types.TypFloat64()
	fields[1] = f1
	var st @types.Type = types.MakeStructType("Mixed", fields)

	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(st)
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var v @Instr = entry.EmitLoad(fp0, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("SROA: a struct with a non-promotable field must be left untouched")
	}
	return ""
}

// A struct with a nested-aggregate field (a struct field, non-promotable) is
// left untouched — increment 1 requires all fields to be promotable scalars.
func TestSroaStructWithNestedAggregateFieldPinned() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "inner"
	f1.Type = twoIntStruct()
	fields[1] = f1
	var st @types.Type = types.MakeStructType("Outer", fields)

	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(st)
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	var v @Instr = entry.EmitLoad(fp0, types.TypInt())
	entry.EmitReturn(oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("SROA: a struct with a nested-aggregate field must be left untouched")
	}
	return ""
}

// A field-ptr-accessed POD struct whose ADDRESS also escapes (stored as a value,
// as a method value capturing &c does) is pinned by L1 — the whole reason the
// SSA-id-aliasing gen fix (so the escape is visible on the alloca) is needed.
func TestSroaFieldAccessedStructWhoseAddressEscapesPinned() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @Instr = entry.EmitAlloc(st)
	var fp0 @Instr = entry.EmitGetFieldPtr(s, 0, types.TypInt())
	entry.EmitStore(fp0, entry.EmitConstInt(7, types.TypInt()))
	// Capture &s: store the struct alloca (its address) as a value elsewhere.
	var dst @Instr = entry.EmitAlloc(types.MakePointerType(st))
	entry.EmitStore(dst, s)
	entry.EmitReturn(noArgs)

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("SROA: a struct whose address escapes must be pinned (L1), field-ptr kept")
	}
	return ""
}

// A managed struct (holds a @Inner field) is left untouched — Phase 1 is
// non-managed only.
func TestSroaManagedStructNotTransformed() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var s @Instr = entry.EmitAlloc(managedFieldStruct())
	var mtyp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	var fp @Instr = entry.EmitGetFieldPtr(s, 0, mtyp)
	entry.EmitStore(fp, entry.EmitConstNil(mtyp))
	entry.EmitReturn(noArgs)

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 || countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("SROA: a managed struct must be left untouched")
	}
	return ""
}

// A struct whose whole value is returned (pinned by L2) is left untouched.
func TestSroaPinnedStructNotTransformed() testing.TestResult {
	var f @Func = NewFunc("", "test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @Instr = entry.EmitAlloc(st)
	var v @Instr = entry.EmitLoad(s, st) // whole load
	entry.EmitReturn(oneRet(v)) // returned by value → pinned

	sroaFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("SROA: a by-value-returned struct must be left untouched")
	}
	return ""
}
