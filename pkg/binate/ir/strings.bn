package "pkg/binate/ir"

import "pkg/slices"

// CollectStrings walks all functions in a module, finds OP_CONST_STRING
// instructions, and returns a deduplicated list of string constants.
func (m @Module) CollectStrings() @[]StringConst {
	var strings @[]StringConst
	for i := 0; i < len(m.Funcs); i++ {
		strings = collectFuncStrings(strings, m.Funcs[i])
	}
	return strings
}

// collectFuncStrings scans a function's blocks for string constants, deduplicating into the list.
func collectFuncStrings(strings @[]StringConst, f @Func) @[]StringConst {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			// Both OP_CONST_STRING and the rodata composite-literal
			// ops carry their byte sequence on StrVal — collect them
			// uniformly so codegen can emit a single static global per
			// distinct byte sequence.
			if instr.Op == OP_CONST_STRING ||
					instr.Op == OP_RODATA_MSLICE ||
					instr.Op == OP_RODATA_SLICE ||
					instr.Op == OP_RODATA_ARRAY ||
					instr.Op == OP_RODATA_MSLICE_COPY {
				var found bool = false
				for k := 0; k < len(strings); k++ {
					if strEq(strings[k].Data, instr.StrVal) {
						found = true
					}
				}
				if !found {
					var sc StringConst
					sc.ID = len(strings)
					sc.Data = instr.StrVal
					sc.Len = len(instr.StrVal)
					strings = slices.Append[StringConst](strings, sc)
				}
			}
		}
	}
	return strings
}

// FindStringID returns the ID of a string constant with the given data,
// or -1 if not found.
// FinalizeStrings collects string constants and stores them on the module.
func (m @Module) FinalizeStrings() {
	m.Strings = m.CollectStrings()
}

// FindStringID returns the ID of a string constant with the given data, or -1 if not found.
func FindStringID(strings *[]StringConst, data *[]const char) int {
	for i := 0; i < len(strings); i++ {
		if strEq(strings[i].Data, data) {
			return strings[i].ID
		}
	}
	return -1
}

// strEq compares two char slices for equality.
func strEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
