package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/std/table"
import "pkg/std/vec"

// stringInterner deduplicates a module's string constants BY CONTENT in O(1)
// amortized, replacing collectFuncStrings' old O(D^2) dedup — a full linear
// `strEq` scan of the distinct-strings list (plus a grow-by-one slices.Append)
// per string-constant instruction, quadratic in the number of distinct strings
// D over a whole loaded program.  Out is the deduplicated StringConst list (its
// Items() are returned to the caller); Index maps string CONTENT → its Out
// position, so a repeat content is a no-op.  Index is a stdlib table.Table keyed
// by *[]readonly char under the zero-size FuncSigHasher / FuncSigEq policies
// (shared with the FuncSig index — djb2 hash + content equality), so its
// hash/equality calls are DIRECT and inlinable, at parity with an open-coded
// probe table.  Built fresh per CollectStrings call and discarded; each key
// borrows the chars of the StringConst.Data the Out vec owns, whose managed-slice
// backing is refcount-shared and outlives vec growth, so the borrow never dangles.
type stringInterner struct {
	Out   @vec.Vec[StringConst]
	Index @table.Table[*[]readonly char, int, FuncSigHasher, FuncSigEq]
}

// newStringInterner returns an empty interner.
func newStringInterner() @stringInterner {
	var si @stringInterner = make(stringInterner)
	si.Out = vec.New[StringConst]()
	si.Index = table.NewTable[*[]readonly char, int, FuncSigHasher, FuncSigEq](FuncSigHasher{},
			FuncSigEq{})
	return si
}

// internString records `data` if not already present (first-wins, matching the
// prior linear-scan dedup): a fresh string is appended to Out with its position
// as ID and its content indexed; a duplicate is a no-op.
func internString(si @stringInterner, data @[]char) {
	// One probe: GetOrPut records data→idx (the ID this string WOULD get) only if
	// absent, and reports whether it was already present.  On a hit we're done; on a
	// miss we append the StringConst at that idx.  data's char backing is alive
	// (the param) when the borrowed key is stored, and the Out.Push below hands
	// ownership to StringConst.Data, so the key never dangles.
	var idx int = si.Out.Len()
	var found bool
	_, found = si.Index.GetOrPut(data, idx)
	if found {
		return
	}
	var sc StringConst
	sc.ID = idx
	sc.Data = data
	sc.Len = len(data)
	si.Out.Push(sc)
}

// CollectStrings walks all functions in a module, finds string-carrying
// instructions, and returns a deduplicated list of string constants (with IDs
// assigned in first-seen order).
func (m @Module) CollectStrings() @[]StringConst {
	var si @stringInterner = newStringInterner()
	for i := 0; i < len(m.Funcs); i++ {
		collectFuncStringsInto(si, m.Funcs[i])
	}
	return si.Out.Items()
}

// collectFuncStringsInto interns every string-carrying instruction in a
// function's blocks.  Both OP_CONST_STRING and the rodata composite-literal ops
// carry their byte sequence on StrVal — collect them uniformly so codegen emits
// a single static global per distinct byte sequence.
func collectFuncStringsInto(si @stringInterner, f @Func) {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CONST_STRING || instr.Op == iropcode.OP_RODATA_MSLICE ||
					instr.Op == iropcode.OP_RODATA_SLICE || instr.Op == iropcode.OP_RODATA_ARRAY ||
					instr.Op == iropcode.OP_RODATA_MSLICE_COPY {
				internString(si, instr.StrVal)
			}
		}
	}
}

// FinalizeStrings collects string constants and stores them on the module.
func (m @Module) FinalizeStrings() {
	m.Strings = m.CollectStrings()
}

// FindStringID returns the ID of a string constant with the given data, or -1 if not found.
func FindStringID(strings *[]StringConst, data *[]readonly char) int {
	for i := 0; i < len(strings); i++ {
		if strEq(strings[i].Data, data) {
			return strings[i].ID
		}
	}
	return -1
}

// strEq compares two char slices for equality.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
