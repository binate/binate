package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/stdx/containers/vec"

// stringInterner deduplicates a module's string constants BY CONTENT in O(1)
// amortized, replacing collectFuncStrings' old O(D^2) dedup — a full linear
// `strEq` scan of the distinct-strings list (plus a grow-by-one slices.Append)
// per string-constant instruction, quadratic in the number of distinct strings
// D over a whole loaded program.  Out is the deduplicated StringConst list (its
// Items() are returned to the caller); Buckets is an open-addressing content
// hash → Out index, with `Buckets[h] == 0` meaning free and a populated slot
// holding `1 + the Out index` (so index 0 is representable and the empty string
// — a legal string constant — is NOT mistaken for a free slot, unlike the
// len==0 sentinel the FuncSig index can use for never-empty names).  Linear
// probing; capacity (Mask+1) is a power of two; resized at 75% load so a probe
// always meets a free slot.  Built fresh per CollectStrings call and discarded.
type stringInterner struct {
	Out     @vec.Vec[StringConst]
	Buckets @[]int
	Mask    int
	Count   int
}

// initialStringInternCap is the starting bucket count — a power of two large
// enough that most modules never resize.
const initialStringInternCap int = 256

// newStringInterner returns an empty interner with its bucket table allocated.
func newStringInterner() @stringInterner {
	var si @stringInterner = make(stringInterner)
	si.Out = vec.New[StringConst]()
	si.Buckets = make_slice(int, initialStringInternCap)
	si.Mask = initialStringInternCap - 1
	si.Count = 0
	return si
}

// internString records `data` if not already present (first-wins, matching the
// prior linear-scan dedup): a fresh string is appended to Out with its position
// as ID and its content indexed; a duplicate is a no-op.  funcSigHash is a djb2
// over the bytes (shared with the FuncSig index); strEq compares content.
func internString(si @stringInterner, data @[]char) {
	var bucket int = funcSigHash(data) & si.Mask
	var probes int = 0
	for probes <= si.Mask {
		var pos int = (bucket + probes) & si.Mask
		if si.Buckets[pos] == 0 {
			var idx int = si.Out.Len()
			var sc StringConst
			sc.ID = idx
			sc.Data = data
			sc.Len = len(data)
			si.Out.Push(sc)
			si.Buckets[pos] = idx + 1
			si.Count = si.Count + 1
			// Resize at 75% load: count*4 > capacity*3.
			if si.Count * 4 > (si.Mask + 1) * 3 {
				stringInternResize(si)
			}
			return
		}
		if strEq(si.Out.Get(si.Buckets[pos] - 1).Data, data) {
			return
		}
		probes = probes + 1
	}
	// Unreachable: the 75%-load resize guarantees a free slot.
}

// stringInternResize doubles the bucket capacity and rehashes every Out entry.
// O(D), called rarely (logarithmic in inserts).  Out (the storage) is unchanged;
// only the index is rebuilt.
func stringInternResize(si @stringInterner) {
	var newCap int = (si.Mask + 1) * 2
	si.Buckets = make_slice(int, newCap)
	si.Mask = newCap - 1
	si.Count = 0
	for i := 0; i < si.Out.Len(); i++ {
		stringInternReinsert(si, si.Out.Get(i).Data, i)
	}
}

// stringInternReinsert places an already-stored Out entry into the (freshly
// resized) bucket table.  Every key is unique here — Out already holds only
// distinct strings — so it always lands in the first free slot.
func stringInternReinsert(si @stringInterner, data *[]readonly char, idx int) {
	var bucket int = funcSigHash(data) & si.Mask
	var probes int = 0
	for probes <= si.Mask {
		var pos int = (bucket + probes) & si.Mask
		if si.Buckets[pos] == 0 {
			si.Buckets[pos] = idx + 1
			si.Count = si.Count + 1
			return
		}
		probes = probes + 1
	}
}

// CollectStrings walks all functions in a module, finds string-carrying
// instructions, and returns a deduplicated list of string constants (with IDs
// assigned in first-seen order).
func (m @Module) CollectStrings() @[]StringConst {
	var si @stringInterner = newStringInterner()
	for i := 0; i < len(m.Funcs); i++ {
		collectFuncStringsInto(si, m.Funcs[i])
	}
	return si.Out.Items()
}

// collectFuncStringsInto interns every string-carrying instruction in a
// function's blocks.  Both OP_CONST_STRING and the rodata composite-literal ops
// carry their byte sequence on StrVal — collect them uniformly so codegen emits
// a single static global per distinct byte sequence.
func collectFuncStringsInto(si @stringInterner, f @Func) {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CONST_STRING || instr.Op == iropcode.OP_RODATA_MSLICE ||
					instr.Op == iropcode.OP_RODATA_SLICE || instr.Op == iropcode.OP_RODATA_ARRAY ||
					instr.Op == iropcode.OP_RODATA_MSLICE_COPY {
				internString(si, instr.StrVal)
			}
		}
	}
}

// FinalizeStrings collects string constants and stores them on the module.
func (m @Module) FinalizeStrings() {
	m.Strings = m.CollectStrings()
}

// FindStringID returns the ID of a string constant with the given data, or -1 if not found.
func FindStringID(strings *[]StringConst, data *[]readonly char) int {
	for i := 0; i < len(strings); i++ {
		if strEq(strings[i].Data, data) {
			return strings[i].ID
		}
	}
	return -1
}

// strEq compares two char slices for equality.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
