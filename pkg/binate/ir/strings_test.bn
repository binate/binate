package "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// ============================================================
// CollectStrings / FindStringID tests
// ============================================================

func TestCollectStringsEmpty() testing.TestResult {
	var m @Module = NewModule("test")
	var strings @[]StringConst = m.CollectStrings()
	if len(strings) != 0 {
		return fail("expected 0 strings from empty module")
	}
	return ""
}

func TestCollectStringsSingle() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitConstString("hello")
	m.AddFunc(f)
	var strings @[]StringConst = m.CollectStrings()
	if len(strings) != 1 {
		return fail("expected 1 string")
	}
	if !charsEqual(strings[0].Data, "hello") {
		return fail("expected hello")
	}
	if strings[0].Len != 5 {
		return fail("expected len 5")
	}
	return ""
}

func TestCollectStringsDeduplicate() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitConstString("hello")
	b.EmitConstString("world")
	b.EmitConstString("hello")
	m.AddFunc(f)
	var strings @[]StringConst = m.CollectStrings()
	if len(strings) != 2 {
		return fail("expected 2 deduplicated strings")
	}
	return ""
}

func TestFindStringIDFound() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitConstString("alpha")
	b.EmitConstString("beta")
	m.AddFunc(f)
	var strings @[]StringConst = m.CollectStrings()
	var id int = FindStringID(strings, "beta")
	if id != 1 {
		return fail("expected id 1 for beta")
	}
	return ""
}

func TestFindStringIDNotFound() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitConstString("alpha")
	m.AddFunc(f)
	var strings @[]StringConst = m.CollectStrings()
	var id int = FindStringID(strings, "missing")
	if id != -1 {
		return fail("expected -1 for missing string")
	}
	return ""
}

// ============================================================
// len() of a bare string literal
// ============================================================

// len() applied directly to a string literal must fold to a compile-time
// OP_CONST_INT of the (unescaped) byte length, NOT an OP_EXTRACT of the
// slice length field over the bare OP_CONST_STRING data pointer.  The
// latter is invalid IR on compiled backends and a silent garbage read on
// the VM, because a bare literal lowers to a `*readonly uint8` pointer,
// not a {ptr,len} slice.
func TestLenStringLiteralFoldsToConst() testing.TestResult {
	var m @Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var n int = len(\"true\"); _ = n }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundLen @Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_EXTRACT && len(ins.Args) >= 1 && ins.Args[0] != nil &&
				ins.Args[0].Op == iropcode.OP_CONST_STRING {
			return fail(
					"len(string literal) extracted a length field from the bare iropcode.OP_CONST_STRING pointer")
		}
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 4 {
			foundLen = ins
		}
	}
	if foundLen == nil {
		return fail("len(\"true\") should fold to iropcode.OP_CONST_INT 4")
	}
	return ""
}

// ============================================================
// stringInterner dedup edge cases (empty string, resize rehash)
// ============================================================

// TestCollectStringsEmptyStringDedup: the empty string is a LEGAL string
// constant and must dedup like any other — the interner treats "" as an ordinary
// key (FuncSigHasher.Hash / FuncSigEq.Equal handle a len==0 slice fine), not a
// special case, so two "" constants collapse to a single entry.
func TestCollectStringsEmptyStringDedup() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	b.EmitConstString("")
	b.EmitConstString("x")
	b.EmitConstString("")
	m.AddFunc(f)
	var strs @[]StringConst = m.CollectStrings()
	if len(strs) != 2 {
		return fail("empty string must dedup like any other (expected 2 distinct)")
	}
	if strs[0].Len != 0 {
		return fail("first distinct constant should be the empty string (len 0)")
	}
	return ""
}

// TestCollectStringsCrossResize emits enough distinct strings (each twice) to
// force several of the interner's underlying table.Table grow-and-rehash steps,
// and verifies the rehash preserves exact dedup: n distinct entries, sequential
// first-seen IDs, and every key still findable after the rehash.
func TestCollectStringsCrossResize() testing.TestResult {
	var m @Module = NewModule("test")
	var f @Func = NewFunc("", "foo", noParams, noResults)
	var b @Block = AddBlock(f, "entry")
	var n int = 300
	for i := 0; i < n; i++ {
		var s @[]char = internTestKey(i)
		b.EmitConstString(s)
		b.EmitConstString(s)
	}
	m.AddFunc(f)
	var strs @[]StringConst = m.CollectStrings()
	if len(strs) != n {
		return fail("cross-resize dedup should keep exactly n distinct strings")
	}
	for i := 0; i < n; i++ {
		if strs[i].ID != i {
			return fail("IDs must be sequential first-seen order")
		}
	}
	if FindStringID(strs, internTestKey(0)) != 0 {
		return fail("first key lost after resize rehash")
	}
	if FindStringID(strs, internTestKey(n - 1)) != n - 1 {
		return fail("last key lost after resize rehash")
	}
	return ""
}

// internTestKey builds the distinct key "s"+decimal(i) without pkg/std/strings,
// so it doesn't shadow the `strings` package against this file's `strings`-named
// locals.
func internTestKey(i int) @[]char {
	var digits int = 1
	var t int = i
	for t >= 10 {
		digits = digits + 1
		t = t / 10
	}
	var out @[]char = make_slice(char, digits + 1)
	out[0] = 's'
	var k int = digits
	t = i
	for k >= 1 {
		out[k] = cast(char, cast(int, '0') + (t % 10))
		t = t / 10
		k = k - 1
	}
	return out
}
