package "pkg/binate/ir"

import "pkg/binate/irutil"
import "pkg/binate/types"

// ManagedStructLeafEligible reports whether t (peeled) is a struct with at least
// one managed field, EVERY managed field of which has a forwardable inline
// cleanup: a LEAF managed scalar RefDec'd via load+RefDec (managed pointer, managed
// func-value, managed iface-value), a managed slice `@[]T` of ANY element (its
// SROA-shape field cleanup is extract-refptr + RefDec, or extract-refptr/backinglen +
// call __dtor_ms_elems for a managed element — never a field-ptr bitcast), OR a
// nested managed-containing struct that is ITSELF leaf-eligible (its cleanup
// recurses to inline per-field RefDecs on the field-ptr — see isLeafManagedField /
// emitStructFieldRefDecs).  A field that is an array with managed elements makes t
// INELIGIBLE — its cleanup is a by-address elem-dtor call that would pin the split
// field slot (arrays are not SROA'd).  BOTH the cleanup-shape choice (gen, under SroaCleanupShape)
// and the SROA candidate gate use this predicate, so the inline cleanup and the
// split agree on exactly which structs.  Distinct from sroaAggregateContainsManaged
// (which excludes ANY managed content): this ADMITS the leaf-managed subset
// (recursively).
func ManagedStructLeafEligible(t @types.Type) bool {
	t = irutil.PeelTransparent(t)
	if t == nil || t.Kind != types.TYP_STRUCT {
		return false
	}
	var hasManaged bool = false
	for i := 0; i < len(t.Fields); i++ {
		var ft @types.Type = t.Fields[i].Type
		if ft == nil {
			return false
		}
		if !ft.NeedsDestruction() {
			continue // non-managed field — no cleanup, fine
		}
		hasManaged = true
		if !isLeafManagedField(irutil.PeelTransparent(ft)) {
			return false
		}
	}
	return hasManaged
}

// isLeafManagedField reports whether the peeled field type ft has a forwardable
// inline cleanup that keeps the struct scalar-replaceable (see
// managedStructLeafEligible): a leaf managed scalar RefDec'd via load+RefDec, or a
// nested managed-containing struct that is itself leaf-eligible (cleanup recurses).
func isLeafManagedField(ft @types.Type) bool {
	if ft == nil {
		return false
	}
	if ft.Kind == types.TYP_MANAGED_PTR || ft.Kind == types.TYP_MANAGED_FUNC_VALUE ||
			ft.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return true
	}
	if ft.Kind == types.TYP_MANAGED_SLICE {
		// @[]T (any element) is leaf-eligible: under SroaCleanupShape the field cleanup
		// (emitStructFieldRefDecs' TYP_MANAGED_SLICE arm) is the forwardable
		// extract-refptr + RefDec (non-managed element) or extract-refptr/backinglen
		// + call __dtor_ms_elems (managed element) — never a field-ptr bitcast — so
		// the field slot stays SROA-forwardable and splits (via the managed-slice
		// machinery).
		return ft.Elem != nil
	}
	if ft.Kind == types.TYP_STRUCT {
		// A nested managed-containing struct field is leaf-eligible IFF it is itself
		// leaf-eligible: emitStructFieldRefDecs' inlineNested default arm recurses,
		// emitting per-field RefDecs on the field-ptr (identical to inlining the
		// nested __dtor body) rather than a by-address elem-dtor call, so the nested
		// field slot stays field-ptr-only and the SROA fixpoint splits it too.
		return ManagedStructLeafEligible(ft)
	}
	return false
}
