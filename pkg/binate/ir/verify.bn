package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Structural IR verifier.  Walks a FINALIZED @Func and reports the ways a
// basic block can be malformed: an empty block, a block with no
// terminator, more than one terminator, a non-terminator after the
// terminator, or a jump/branch with a missing or foreign successor.
//
// This catches the "ctx.CurBlock desync" bug class: when IR-gen emits
// into an already-terminated block (e.g. a managed-field assignment splits
// the block but a stale ctx.CurBlock routes the next statement back into
// the terminated block), the displaced stores/statements pile up AFTER the
// terminator (or add a second one) and are silently dropped — a wrong-code
// defect output/refcount conformance tests cannot observe.  Both
// genExprOrFuncRef (47d05c81) and genMultiAssign (2f507f26) were this.
//
// What it deliberately does NOT check (see the design notes / TODO):
//   - Reachability: IR-gen legitimately leaves benign orphaned blocks
//     (a `switch.exit` / `if.merge` whose arms all return), so flagging
//     unreachable blocks would false-positive.  The desync's PRIMARY
//     symptom (the extra terminator / instr-after-terminator) is caught
//     structurally, so reachability adds no power for the known class.
//   - SSA def-dominates-use: needs a dominator computation plus param /
//     global / phi exemptions; high cost, redundant here.

// blockIndexIn returns i with f.Blocks[i] == target (reference identity),
// or -1 if target is not a block of f.  @Block is a managed pointer, so
// `==` compares identity.
func blockIndexIn(f @Func, target @Block) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return i
		}
	}
	return -1
}

// addViolation appends one IRViolation to vs and returns the grown slice.
func addViolation(vs @[]IRViolation, fname @[]char, bi int,
		blabel @[]char, ii int, code int, msg @[]char) @[]IRViolation {
	var v IRViolation
	v.FuncName = fname
	v.BlockIndex = bi
	v.BlockLabel = blabel
	v.InstrIndex = ii
	v.Code = code
	v.Msg = msg
	return slices.Append[IRViolation](vs, v)
}

// checkSuccessors validates the successor shape of a block's terminator:
// OP_JUMP needs a single in-func target; OP_BRANCH needs a cond arg and
// two in-func targets; OP_RETURN / OP_UNREACHABLE have no successor
// obligation.
func checkSuccessors(vs @[]IRViolation, f @Func, bi int,
		blabel @[]char, term @Instr) @[]IRViolation {
	if term.Op == iropcode.OP_JUMP {
		if term.Block1 == nil {
			return addViolation(vs, f.Name, bi, blabel, -1,
				VERR_NIL_SUCCESSOR, "jump has nil target")
		}
		if blockIndexIn(f, term.Block1) < 0 {
			return addViolation(vs, f.Name, bi, blabel, -1,
				VERR_BAD_SUCCESSOR, "jump target not in this func")
		}
		return vs
	}
	if term.Op == iropcode.OP_BRANCH {
		if len(term.Args) < 1 {
			vs = addViolation(vs, f.Name, bi, blabel, -1,
				VERR_NIL_SUCCESSOR, "branch missing cond")
		}
		if term.Block1 == nil || term.Block2 == nil {
			return addViolation(vs, f.Name, bi, blabel, -1,
				VERR_NIL_SUCCESSOR, "branch has nil then/else")
		}
		if blockIndexIn(f, term.Block1) < 0 {
			vs = addViolation(vs, f.Name, bi, blabel, -1,
				VERR_BAD_SUCCESSOR, "branch then-target not in this func")
		}
		if blockIndexIn(f, term.Block2) < 0 {
			vs = addViolation(vs, f.Name, bi, blabel, -1,
				VERR_BAD_SUCCESSOR, "branch else-target not in this func")
		}
		return vs
	}
	// OP_RETURN / OP_UNREACHABLE: no successor obligation.
	return vs
}

// VerifyFunc returns the structural IR defects in f (empty == well-formed).
func VerifyFunc(f @Func) @[]IRViolation {
	var vs @[]IRViolation
	if f.IsExtern {
		return vs
	}
	for i := 0; i < len(f.Blocks); i++ {
		var b @Block = f.Blocks[i]
		if len(b.Instrs) == 0 {
			vs = addViolation(vs, f.Name, i, b.Label, -1,
				VERR_EMPTY_BLOCK, "empty block")
			continue
		}
		// Count terminators; remember the last one's index.
		var termCount int = 0
		var lastTermIdx int = -1
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].IsTerminator() {
				termCount = termCount + 1
				lastTermIdx = j
			}
		}
		if termCount == 0 {
			vs = addViolation(vs, f.Name, i, b.Label, -1,
				VERR_MISSING_TERM, "block has no terminator")
			continue
		}
		if termCount > 1 {
			vs = addViolation(vs, f.Name, i, b.Label, lastTermIdx,
				VERR_TWO_TERMS, "block has more than one terminator")
		}
		if lastTermIdx != len(b.Instrs)-1 {
			vs = addViolation(vs, f.Name, i, b.Label, lastTermIdx,
				VERR_INSTR_AFTER_TERM,
				"non-terminator instruction follows terminator")
		}
		vs = checkSuccessors(vs, f, i, b.Label, b.Instrs[lastTermIdx])
	}
	return vs
}

// VerifyFuncOK reports whether f has zero structural defects.
func VerifyFuncOK(f @Func) bool {
	return len(VerifyFunc(f)) == 0
}

// VerifyModule returns the structural IR defects across all funcs in m.
func VerifyModule(m @Module) @[]IRViolation {
	var all @[]IRViolation
	for i := 0; i < len(m.Funcs); i++ {
		var vs @[]IRViolation = VerifyFunc(m.Funcs[i])
		for j := 0; j < len(vs); j++ {
			all = slices.Append[IRViolation](all, vs[j])
		}
	}
	return all
}

// ============================================================
// genFunc debug assertion (off by default)
// ============================================================

// verifyIR gates the genFunc-finalization structural assertion.  Off by
// default so a normal compile pays nothing; drivers/CI opt in via
// SetVerifyIR.
var verifyIR bool = false

// SetVerifyIR toggles the post-genFunc structural verification assertion.
// When on, genFunc aborts the compile (with diagnostics) the moment it
// finalizes a malformed func — converting a silent IR-gen miscompile into
// a loud, located failure.  A process-global flag; off by default.
func SetVerifyIR(on bool) {
	verifyIR = on
}

// verifyFuncOrAbort runs the structural verifier on a finalized func when
// verifyIR is on; on any violation it prints each and aborts the compile.
// A no-op when verifyIR is off (the default), so it is safe to call
// unconditionally at the end of genFunc.
func verifyFuncOrAbort(f @Func) {
	if !verifyIR {
		return
	}
	var vs @[]IRViolation = VerifyFunc(f)
	if len(vs) == 0 {
		return
	}
	println("ir: structural verifier found malformed IR:")
	for i := 0; i < len(vs); i++ {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("  ")
		cb.Write(vs[i].FuncName)
		cb.Write(" [")
		cb.Write(vs[i].BlockLabel)
		cb.Write("]: ")
		cb.Write(vs[i].Msg)
		println(buf.CopyStr(cb.String()))
	}
	os.Exit(1)
}
