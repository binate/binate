package "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the structural IR verifier (verify.bn).  Hand-built malformed
// funcs assert specific VERR_* codes (including the two known bug shapes);
// clean hand-built and gen-from-source funcs assert zero violations
// (notably switch/if shapes that leave benign orphaned blocks — these must
// NOT be flagged, since the verifier deliberately omits reachability).

// hasCode reports whether any violation carries the given code.
func hasCode(vs @[]IRViolation, code int) bool {
	for i := 0; i < len(vs); i++ {
		if vs[i].Code == code {
			return true
		}
	}
	return false
}

// --- malformed IR: positive cases (assert the code fires) ---

// Two terminators in one block — the genExprOrFuncRef (634) shape.
func TestVerifyTwoTerminators() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	entry.EmitReturn(noArgs)               // terminator #1
	entry.EmitAlloc(types.TypInt())        // non-terminator between
	entry.EmitReturn(noArgs)               // terminator #2
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_TWO_TERMS) {
		return fail("expected VERR_TWO_TERMS for two terminators")
	}
	return ""
}

// A non-terminator emitted after the terminator — the genMultiAssign (641)
// silent-drop shape.
func TestVerifyInstrAfterTerminator() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var target @Block = AddBlock(f, "target")
	target.EmitReturn(noArgs)
	entry.EmitJump(target)                 // single terminator...
	entry.EmitAlloc(types.TypInt())        // ...with an instr appended after it
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_INSTR_AFTER_TERM) {
		return fail("expected VERR_INSTR_AFTER_TERM for instr after terminator")
	}
	if hasCode(vs, VERR_TWO_TERMS) {
		return fail("single terminator must not report VERR_TWO_TERMS")
	}
	return ""
}

// A block with no terminator at all.
func TestVerifyMissingTerminator() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	entry.EmitAlloc(types.TypInt())        // only a non-terminator
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_MISSING_TERM) {
		return fail("expected VERR_MISSING_TERM for unterminated block")
	}
	return ""
}

// A block with no instructions.
func TestVerifyEmptyBlock() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	entry.EmitReturn(noArgs)
	AddBlock(f, "stranded")                // never emitted into
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_EMPTY_BLOCK) {
		return fail("expected VERR_EMPTY_BLOCK for empty block")
	}
	return ""
}

// A jump whose target belongs to a different func.
func TestVerifyBadSuccessor() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var other @Func = NewFunc("other", noParams, noResults)
	var foreign @Block = AddBlock(other, "foreign")
	foreign.EmitReturn(noArgs)
	entry.EmitJump(foreign)                // target not in f.Blocks
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_BAD_SUCCESSOR) {
		return fail("expected VERR_BAD_SUCCESSOR for foreign jump target")
	}
	return ""
}

// A jump with a nil target (hand-built, since EmitJump always sets one).
func TestVerifyNilSuccessor() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var jmp @Instr = newVoidInstr(OP_JUMP) // Block1 stays nil
	addInstr(entry, jmp)
	var vs @[]IRViolation = VerifyFunc(f)
	if !hasCode(vs, VERR_NIL_SUCCESSOR) {
		return fail("expected VERR_NIL_SUCCESSOR for nil jump target")
	}
	return ""
}

// --- clean IR: negative cases (assert no violations) ---

func TestVerifyAcceptsReturn() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	entry.EmitReturn(noArgs)
	if !VerifyFuncOK(f) {
		return fail("single-return func should verify clean")
	}
	return ""
}

func TestVerifyAcceptsBranch() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	var thenB @Block = AddBlock(f, "then")
	var elseB @Block = AddBlock(f, "else")
	var cond @Instr = entry.EmitConstInt(1, types.TypInt())
	entry.EmitBranch(cond, thenB, elseB)
	thenB.EmitReturn(noArgs)
	elseB.EmitReturn(noArgs)
	if !VerifyFuncOK(f) {
		return fail("branch to two terminated in-func blocks should verify clean")
	}
	return ""
}

// A block ending in unreachable/panic has no successor obligation.
func TestVerifyAcceptsUnreachableAndPanic() testing.TestResult {
	var f @Func = NewFunc("test", noParams, noResults)
	var entry @Block = AddBlock(f, "entry")
	entry.EmitUnreachable()
	if !VerifyFuncOK(f) {
		return fail("block ending in unreachable should verify clean")
	}
	return ""
}

// An extern (bodyless) func has no blocks and must verify clean.
func TestVerifyAcceptsExtern() testing.TestResult {
	var f @Func = NewExternFunc("ext", noParams, noResults)
	var vs @[]IRViolation = VerifyFunc(f)
	if len(vs) != 0 {
		return fail("extern func should produce no violations")
	}
	return ""
}

// --- gen-from-source: the generated IR must verify clean ---

// Control flow whose arms all return leaves benign orphaned merge/exit
// blocks; the verifier must NOT flag them (it omits reachability).
func TestVerifyAcceptsControlFlowIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func sw(n int) int {\n")
	cb.Write("  switch n {\n")
	cb.Write("  case 0: return 1\n")
	cb.Write("  default: return 2\n")
	cb.Write("  }\n")
	cb.Write("}\n")
	cb.Write("func iff(n int) int {\n")
	cb.Write("  if n > 0 { return 1 } else { return 2 }\n")
	cb.Write("}\n")
	cb.Write("func lp() int {\n")
	cb.Write("  var s int = 0\n")
	cb.Write("  for i := 0; i < 3; i = i + 1 { s = s + i }\n")
	cb.Write("  return s\n")
	cb.Write("}\n")
	var m @Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]IRViolation = VerifyModule(m)
	if len(vs) != 0 {
		return fail("generated control-flow IR should verify clean (no reachability FP)")
	}
	return ""
}

// The fixed @func-field assignment and multi-assign shapes (the 634/641
// reproducers in corrected form) must verify clean.
func TestVerifyAcceptsFuncFieldAndMultiAssignIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type IO struct { w @func() int; e @func() int }\n")
	cb.Write("type H struct { n int }\n")
	cb.Write("func fa() int { return 1 }\n")
	cb.Write("func fb() int { return 2 }\n")
	cb.Write("func tw() (@func() int, int) { return fa, 5 }\n")
	cb.Write("func mkIO() IO {\n")
	cb.Write("  var io IO\n")
	cb.Write("  io.w = fa\n")
	cb.Write("  io.e = fb\n")
	cb.Write("  return io\n")
	cb.Write("}\n")
	cb.Write("func mkH() H {\n")
	cb.Write("  var f @func() int = fa\n")
	cb.Write("  var h H\n")
	cb.Write("  f, h.n = tw()\n")
	cb.Write("  return h\n")
	cb.Write("}\n")
	var m @Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]IRViolation = VerifyModule(m)
	if len(vs) != 0 {
		return fail("generated @func-field / multi-assign IR should verify clean")
	}
	return ""
}

// A panic-terminated function must verify clean.  Regression guard for the
// dead-const-nil bug: panic(...) ends its block with a bootstrap.Exit call
// + unreachable terminator, and genPanicCall returns its dead expression
// "result" const-nil DETACHED (not added to that already-terminated block).
// Adding it would leave a non-terminator after the terminator, the
// finalizer would append a redundant unreachable, and the block would have
// two terminators (VERR_TWO_TERMS).
func TestVerifyAcceptsPanicTerminatedIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func mustPos(x int) int {\n")
	cb.Write("  if x > 0 { return x }\n")
	cb.Write("  panic(\"non-positive\")\n")
	cb.Write("}\n")
	var m @Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]IRViolation = VerifyModule(m)
	if len(vs) != 0 {
		return fail("panic-terminated func should verify clean (no dead const-nil)")
	}
	return ""
}

// Exercises the genFunc wire-up: with the assertion ON, generating clean
// source must NOT abort (a false positive would Exit the test process).
func TestVerifyIRAssertionAcceptsCleanGen() testing.TestResult {
	SetVerifyIR(true)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func f(n int) int {\n")
	cb.Write("  if n > 0 { return n } else { return 0 }\n")
	cb.Write("}\n")
	var m @Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	SetVerifyIR(false) // restore global state for other tests
	if len(VerifyModule(m)) != 0 {
		return fail("clean gen with assertion on should be violation-free")
	}
	return ""
}
