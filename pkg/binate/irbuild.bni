// Package irbuild is the IR construction + verification layer: the Emit* builder
// functions that assemble instructions onto blocks (EmitBinop, EmitCall,
// EmitReturn, …), the module-init/entry emitters, the managed-refdec emitters,
// and the IR verifier.  It builds and checks the `ir` data model, so it imports
// `ir`; `ir` itself never depends on `irbuild`.
package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"

// EmitAlloc emits a stack allocation (alloca) for the given element type.
func EmitAlloc(b @ir.Block, elemTyp @types.Type) @ir.Instr

// EmitBinop emits a binary operation (arithmetic, comparison, logical).
func EmitBinop(b @ir.Block, op int, lhs @ir.Instr, rhs @ir.Instr, typ @types.Type) @ir.Instr

// EmitBitCast emits a bitwise reinterpret cast (no value change, type only).
func EmitBitCast(b @ir.Block, val @ir.Instr, targetTyp @types.Type) @ir.Instr

// EmitBnEntry emits the compiled program's synthetic `<m_pkg>.__entry` function:
// `bn_init(); main.main()`.  Mangler routes `main.__entry` to the reserved
// linker symbol `bn_entry` — the C runtime's sole entry point into Binate — and
// `<m_pkg>.__bninit` to `bn_init`, so this is literally `bn_init(); main.main()`
// at the symbol level.  Keeping all entry-time init behind `bn_init` means a C
// host that calls `bn_init` directly (before or instead of running main) hits
// the exact same init path `bn_entry` uses; bn_init's run-once guard makes the
// two compose safely (init runs once even if both fire).
//
// Caller (cmd/bnc on the main module) must have emitted `bn_init` first via
// EmitBnInit; the body here calls it unconditionally.  This is the compiled
// counterpart of EmitMainEntry (interp) — emit exactly one of the two per main
// module, never both (both would define `<m_pkg>.__entry`).
func EmitBnEntry(m @ir.Module)

// EmitBnInit emits the init dispatcher into `m`: a synthetic `<m_pkg>.__bninit`
// function that calls each package's `<pkg>.__init` in dependency order.  The
// mangler routes any `<pkg>.__bninit` to the reserved well-known linker symbol
// `bn_init` — the C runtime's idempotent whole-program / whole-library init.  It
// is emitted in EVERY artifact: for a program, `m` is the `main` module and
// `bn_entry` (EmitBnEntry) calls it before `main.main`; for a `--library`, `m`
// is the facade and a C host calls `bn_init` directly to init the whole `.a`.
//
// `packageInitNames` is the dependency-ordered list of `<pkg>.__init` names (the
// build root's transitive closure, incl. the root's own `__init` last if
// present) — the same shape EmitInitDispatcher takes.
//
// bn_init is IDEMPOTENT: a run-once guard so it may be called more than once (a C
// host calling `bn_init` and then the process running `bn_entry`, which re-calls
// it; or several merged libraries sharing the one `bn_init`) without re-running
// any package's var initializers.  The guard is a private zero-initialized
// (false) bool global `__bninit_done`; the body is
//
//	if __bninit_done { return }
//	__bninit_done = true
//	rt.BuildSatRegistry(&__pkg_satfrag)   // fill the interface-satisfaction registry
//	<call each package __init in dependency order>
//
// The store precedes the init calls so a (pathological) re-entrant init that
// reaches back into `bn_init` sees the guard already set and returns rather than
// recursing — matching the C `once`-style contract a host expects.
func EmitBnInit(m @ir.Module, packageInitNames @[]@[]char)

// EmitBoundsCheck emits a runtime bounds check that panics if index >= length.
func EmitBoundsCheck(b @ir.Block, index @ir.Instr, length @ir.Instr)

// EmitBox emits a box instruction that wraps a value into a managed pointer.
func EmitBox(b @ir.Block, val @ir.Instr, ptrTyp @types.Type) @ir.Instr

// EmitBranch emits a conditional branch on cond to then/else blocks.
func EmitBranch(b @ir.Block, cond @ir.Instr, thenBlk @ir.Block, elseBlk @ir.Block)

// EmitCall emits a direct function call by name with the given arguments.
// Normalizes `name` through qualifyForCurrentModule so call sites see a
// fully-qualified name in instr.StrVal regardless of whether the caller
// passed a bare or qualified form. Backends can rely on the qualified
// form alone — no need to combine with their own modulePkgName state.
func EmitCall(b @ir.Block, name *[]readonly char, args @[]@ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitCallFuncValue emits a call through a function value. fnVal must
// be of type TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE. The Args layout
// on the resulting Instr is `[fnVal, args...]`; resultTyp is the
// return type (from fnVal.Typ.Results).
func EmitCallFuncValue(b @ir.Block, fnVal @ir.Instr, args @[]@ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitCallIfaceMethod emits an interface method dispatch. iv must be
// of type TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED.
// methodIdx is the 0-based slot in the interface's method-declaration
// order; resultTyp is the method's return type (TypVoid for void).
// Args layout on the resulting Instr: `[iv, args...]` — same shape
// as EmitCallFuncValue for symmetry.
func EmitCallIfaceMethod(b @ir.Block, iv @ir.Instr, args @[]@ir.Instr, methodIdx int,
		resultTyp @types.Type) @ir.Instr

// EmitCallIndirect emits an indirect function call through fnPtr.
// fnPtr must have type *uint8 (the canonical raw-function-pointer type).
// The signature is reconstructed from resultTyp (return type) and the
// argument operands' types — each arg Instr carries its Typ. The result
// Instr's Args layout is `[fnPtr, args...]`.
func EmitCallIndirect(b @ir.Block, fnPtr @ir.Instr, args @[]@ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitCast emits a type cast (sign/zero extend, truncate).
func EmitCast(b @ir.Block, val @ir.Instr, targetTyp @types.Type) @ir.Instr

// EmitConstBool emits a boolean constant instruction.
func EmitConstBool(b @ir.Block, val bool) @ir.Instr

// EmitConstFloat emits a floating-point constant instruction. The
// raw literal text is stored in StrVal; backends parse it at lowering
// time. Typ is the resolved float type (TYP_UNTYPED_FLOAT until
// context types it to float32/float64).
func EmitConstFloat(b @ir.Block, text @[]char, typ @types.Type) @ir.Instr

// EmitConstInt emits an integer constant instruction from a host-`int`
// value, widening it into the int64 IntVal slot.
func EmitConstInt(b @ir.Block, val int, typ @types.Type) @ir.Instr

// EmitConstInt64 emits an integer constant instruction from a
// fixed-width int64 value (the literal-value path).
func EmitConstInt64(b @ir.Block, val int64, typ @types.Type) @ir.Instr

// EmitConstNil emits a nil constant of the given type.
func EmitConstNil(b @ir.Block, typ @types.Type) @ir.Instr

// EmitConstString emits a string constant instruction. The result's
// type is `*readonly uint8` — a raw pointer to the rodata bytes; callers
// dispatch on `instr.Op == OP_CONST_STRING` to detect string-literal
// origins (the type alone is not load-bearing — `*readonly uint8` could
// arise from other sources too).
func EmitConstString(b @ir.Block, val @[]char) @ir.Instr

// EmitExtract extracts a field from a struct/multi-return value by index.
func EmitExtract(b @ir.Block, multi @ir.Instr, index int, typ @types.Type) @ir.Instr

// EmitFuncValue emits a function-value construction op for a named
// function. resultTyp must be TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE
// (the destination's declared type, since the construction is
// type-driven). The function name is stored on StrVal — qualified
// `pkg.name` for cross-package, bare for same-package.  No Args:
// the produced value's data slot is nil (Phase 1 non-capturing
// shape).  Use EmitFuncValueWithData for capturing closures.
func EmitFuncValue(b @ir.Block, name *[]readonly char, resultTyp @types.Type) @ir.Instr

// EmitFuncValueDtor emits an OP_FUNC_VALUE_DTOR that loads slot 0
// of the function value's vtable — the closure-struct dtor for an
// @func capturing closure (or null for a non-capturing literal /
// the *func form, in which case the runtime falls through to plain
// rt.Free).  Same shape as EmitIfaceDtor; the only difference is
// which slot of the 2-word value carries the vtable
// (BnFuncValue = {vtable, data} so slot 0; BnIfaceValue = {data,
// vtable} so slot 1).
func EmitFuncValueDtor(b @ir.Block, fv @ir.Instr) @ir.Instr

// EmitFuncValueWithData emits a function-value construction op
// whose data slot is the given pointer.  Used by capturing
// function-literal codegen — the data points at the alloca'd (or
// heap-allocated) closure struct.  The underlying function named by `name` must
// have Func.IsClosure=true so the per-shape `__shim.<mangled>`
// emitter reads the captures out of data.
func EmitFuncValueWithData(b @ir.Block, name *[]readonly char, data @ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitGetElemPtr emits a pointer to an array/slice element at a dynamic index.
func EmitGetElemPtr(b @ir.Block, ptr @ir.Instr, index @ir.Instr, elemTyp @types.Type) @ir.Instr

// EmitGetFieldPtr emits a pointer to a struct field at the given index.
func EmitGetFieldPtr(b @ir.Block, ptr @ir.Instr, index int, fieldTyp @types.Type) @ir.Instr

// EmitIfaceDtor emits an OP_IFACE_DTOR that loads slot 0 of iv's
// vtable — the receiver type's struct destructor (or null / 0 if
// the type has no dtor). The result is a *uint8, matching
// EmitFuncHandle's shape, so it can be passed straight to
// EmitRefDecDtor for @Iface scope-exit cleanup.
func EmitIfaceDtor(b @ir.Block, iv @ir.Instr) @ir.Instr

// EmitIfaceUpcast emits an OP_IFACE_UPCAST that rebuilds an
// interface value with the source's data ptr and the target
// interface's vtable.  Used to lower `*Child → *Parent` /
// `@Child → @Parent` upcasts.  targetVtableName names the `__ivt.<...>` global
// that the receiver type's transitive impl emission (Slice E.3)
// guarantees exists for every reachable ancestor.  resultTyp is
// TYP_INTERFACE_VALUE or TYP_INTERFACE_VALUE_MANAGED of the
// target interface.
func EmitIfaceUpcast(b @ir.Block, m @ir.Module, src @ir.Instr, targetVtableName @[]char,
		resultTyp @types.Type) @ir.Instr

// EmitIfaceValue emits an interface-value construction. dataPtr is
// the source pointer being placed in the data slot (raw or managed —
// the IR layer treats it as i8*-shaped; codegen bitcasts to i8* at
// the construction site). vtableName is the mangled name of the
// `@__ivt.<...>` global selected at type-check time. resultTyp is
// TYP_INTERFACE_VALUE or TYP_INTERFACE_VALUE_MANAGED.
//
// An EMPTY vtableName selects the DYNAMIC-vtable form instead (the
// vtable comes from a runtime register operand, Args[1]); that form
// is built via EmitIfaceValueDyn — this static helper always sets a
// non-empty StrVal and a 1-element Args.
func EmitIfaceValue(b @ir.Block, dataPtr @ir.Instr, vtableName @[]char,
		resultTyp @types.Type) @ir.Instr

// EmitInitDispatcher emits a synthetic `<m_pkg>.__init_all`
// function into `m` that calls each package's init in order.
// `packageInitNames` is the list of qualified `<pkg>.__init`
// names to invoke (typically built from a dependency-walk loop,
// ending with the main package's own `<main>.__init` if present).
//
// Always emits the function — even with an empty list — so the
// entry wrapper (`<m_pkg>.__entry`, see EmitMainEntry) can call
// it unconditionally without a runtime existence check.
//
// The dispatcher's qualified name is `<m.PkgPath>.__init_all` (m.PkgPath
// is set on the module being generated by GeneratePackage / GenModule).
//
// This is the INTERP path's init mechanism: the VM runs `main.__init_all`
// before each entered function, and `EmitMainEntry`'s `__entry` calls it.
// The compiled (native + LLVM) drivers instead emit `bn_init` (EmitBnInit)
// and a `bn_init`-calling `__entry` (EmitBnEntry) — see those; the interp
// cannot use `bn_init` because it emits a `rt.BuildSatRegistry` call and the
// interp builds its satisfaction registry host-side.
func EmitInitDispatcher(m @ir.Module, packageInitNames @[]@[]char)

// EmitJump emits an unconditional branch to the target block.
func EmitJump(b @ir.Block, target @ir.Block)

// EmitLoad emits a load from a pointer, producing a value of the given type.
func EmitLoad(b @ir.Block, ptr @ir.Instr, typ @types.Type) @ir.Instr

// EmitMainEntry emits a synthetic `<m_pkg>.__entry` function that runs
// `<m_pkg>.__init_all()` and then calls `main.main()`.  Mangler routes the
// qualified name `main.__entry` to the linker symbol `bn_entry`.
//
// This is the INTERP path's entry: it pairs with EmitInitDispatcher (the caller
// must have emitted `__init_all` first; the body calls it unconditionally).  The
// compiled (native + LLVM) drivers use EmitBnEntry instead, whose `__entry`
// calls `bn_init` rather than `__init_all` — see EmitBnEntry and
// EmitInitDispatcher for why the interp keeps `__init_all`.
func EmitMainEntry(m @ir.Module)

// EmitMake emits a make instruction that allocates a managed struct (@T).
func EmitMake(b @ir.Block, typ @types.Type) @ir.Instr

// EmitMakeSlice emits a make_slice instruction that allocates a managed-slice (@[]T).
func EmitMakeSlice(b @ir.Block, elemTyp @types.Type, length @ir.Instr) @ir.Instr

// EmitManagedPtrRefDec emits RefDec for a managed pointer value, passing the
// pointee's struct destructor if the pointee type needs destruction.
// Uses OP_FUNC_HANDLE (handle pointer end-to-end — the proper handle
// shape, replacing the transitional OP_FUNC_ADDR/idx-form stop-gap):
//
//   * Native: lowered to `&__handle.F` cast to i8*.  ZeroRefDestroy
//     calls _call_dtor(handle, ptr) → OP_CALL_HANDLE dispatches via
//     handle.vtable.call.
//   * Bytecode: BC_FUNC_HANDLE returns a *uint8 pointing at the
//     function's 16-byte {vtable, data} handle.
//     BC_REFDEC_INLINE_FAST's slow path inspects handle.data:
//     DATA_KIND_VM_CLOSURE_REC → recover FnIdx and do iterative push
//     (flat-stack, no host recursion); otherwise → cross-mode shim
//     call (bounded by the cross-mode chain, not the dtor field
//     graph).
//
// This makes dtor refs interop-correct: a managed value created in
// native that crosses into a bytecode VM (or vice-versa) can have
// its dtor resolved through the handle without depending on
// per-VM-instance function indices.
func EmitManagedPtrRefDec(f @ir.Func, b @ir.Block, ptrVal @ir.Instr)

// EmitManagedSliceRefDec cleans up a managed-slice value. If the element type
// needs destruction, stores the value to a temp alloca and calls the dtor.
// Otherwise just RefDec's the backing refptr.
func EmitManagedSliceRefDec(f @ir.Func, b @ir.Block, sliceVal @ir.Instr) @ir.Block

// EmitNilCheck emits a nil-check op (OP_NIL_CHECK) that traps if the pointer is nil.
// In the VM a nil pointer raises a RECOVERABLE user-code fault (Plan 2); compiled code
// treats it as a no-op (opt-in nil-checking is a VM/REPL recovery aid).  Emitted before
// a deref only when nil-checking is enabled (GenCtx.EmitNilChecks).  Returns the
// check instr so a caller can tag it with a cleanup pad (attachFaultPad).
func EmitNilCheck(b @ir.Block, ptr @ir.Instr) @ir.Instr

// EmitPhi emits a phi node that merges values from different predecessor blocks.
func EmitPhi(b @ir.Block, typ @types.Type, entries @[]ir.PhiEntry) @ir.Instr

// EmitRefDec emits an inline-fast-path refcount decrement (OP_REFDEC)
// for a managed pointer with no destructor. Backends lower the fast
// path inline (nil-check + header load/sub/store); on refcount zero
// they call rt.ZeroRefDestroy(ptr, null).
func EmitRefDec(b @ir.Block, ptr @ir.Instr)

// EmitRefDecDtor emits an inline-fast-path refcount decrement (OP_REFDEC)
// that calls dtor on free. Same lowering shape as EmitRefDec, but the
// slow-path call is rt.ZeroRefDestroy(ptr, dtor).
func EmitRefDecDtor(b @ir.Block, ptr @ir.Instr, dtor @ir.Instr)

// EmitRefInc emits an inline reference count increment (OP_REFINC) for
// a managed pointer. Backends lower it to an inline nil-check + header
// load/add/store (no rt.RefInc call).
func EmitRefInc(b @ir.Block, ptr @ir.Instr)

// EmitReturn emits a return instruction with the given values.
func EmitReturn(b @ir.Block, vals @[]@ir.Instr)

// EmitRodataArray emits an array literal initialized from rodata
// bytes. Allocates an `[N]T` buffer (size from arrayTyp.ArrayLen),
// memcpys `min(len(bytes), N)` bytes from a static global, and
// zero-pads the tail. Result is the array value (codegen materializes
// it through an alloca + memcpy + load).
func EmitRodataArray(b @ir.Block, bytes @[]char, arrayTyp @types.Type) @ir.Instr

// EmitRodataMSlice emits a managed-slice composite literal that aliases
// a static rodata global. Used when the entire literal is compile-time
// constant bytes and the target is `@[]readonly T` (read-only view —
// aliasing rodata is sound). `bytes` is the byte sequence to embed.
func EmitRodataMSlice(b @ir.Block, bytes @[]char, sliceTyp @types.Type) @ir.Instr

// EmitRodataSlice emits a raw-slice composite literal aliasing a static
// rodata global. Same byte-sequence shape as EmitRodataMSlice; codegen
// extracts the {data, len} prefix into a `*[]readonly T` value.
func EmitRodataSlice(b @ir.Block, bytes @[]char, sliceTyp @types.Type) @ir.Instr

// EmitSPRestore emits a statement-end marker that lets the VM
// reclaim vm.Stack temporaries pushed during the statement
// (aggregate return copy-backs, BC_MAKE_SLICE / BC_STRING_COPY*
// / BC_FUNC_VALUE pushes). No-op in the LLVM and native backends.
// Void instruction (no result, no operands).
func EmitSPRestore(b @ir.Block)

// EmitSliceExpr emits a subslice operation (s[lo:hi]) as a zero-copy view adjustment.
func EmitSliceExpr(b @ir.Block, slice @ir.Instr, lo @ir.Instr, hi @ir.Instr,
		typ @types.Type) @ir.Instr

// EmitSliceGet loads an element from a slice at the given index.
func EmitSliceGet(b @ir.Block, slice @ir.Instr, index @ir.Instr, elemTyp @types.Type) @ir.Instr

// EmitSliceLen extracts the length field from a slice value.
func EmitSliceLen(b @ir.Block, slice @ir.Instr) @ir.Instr

// EmitSliceSet stores a value into a slice element at the given index.
func EmitSliceSet(b @ir.Block, slice @ir.Instr, index @ir.Instr, val @ir.Instr, elemTyp @types.Type)

// EmitStackCheck appends OP_STACK_CHECK for a call to `name` (the callee-name
// string, qualified with the module's package path like EmitCall) — a VM-only
// pre-check emitted just before a call commits its args.  See the ir.bni doc.
func EmitStackCheck(b @ir.Block, name *[]readonly char)

// EmitStackFrames emits an OP_STACK_FRAMES that captures the caller chain of
// the enclosing function into the caller-owned buffer.  skip is the number of
// leading recordable frames to drop; buf is the destination raw slice
// (*[]debug.Frame, an {data,len} pair).  resultTyp is the int result type (the
// total recordable frame depth, which may exceed the buffer length).
func EmitStackFrames(b @ir.Block, skip @ir.Instr, buf @ir.Instr, resultTyp @types.Type) @ir.Instr

// EmitStore emits a store of a value into a pointer location.
func EmitStore(b @ir.Block, ptr @ir.Instr, val @ir.Instr)

// EmitUnary emits a unary operation (negation, not, bitwise not).
func EmitUnary(b @ir.Block, op int, arg @ir.Instr, typ @types.Type) @ir.Instr

// EmitUnreachable emits an unreachable terminator (marks dead code paths).
func EmitUnreachable(b @ir.Block)

// EmitUnwindReturn appends the terminator of a VM-only cleanup landing pad
// (Func.FaultPads): pop the frame like a return but copy back no value, then
// continue the fault unwind in the caller.  Only the VM lowers it (->
// BC_UNWIND_RETURN); the compiled backends never see it.
func EmitUnwindReturn(b @ir.Block)

// SetVerifyIR toggles the post-genFunc structural verification assertion.
// When on, genFunc aborts the compile (with diagnostics) the moment it
// finalizes a malformed func — converting a silent IR-gen miscompile into
// a loud, located failure.  A process-global flag; off by default.
func SetVerifyIR(on bool)

// VerifyFuncOrAbort runs the structural verifier on a finalized func when
// verifyIR is on; on any violation it prints each and aborts the compile.
// A no-op when verifyIR is off (the default), so it is safe to call
// unconditionally at the end of genFunc.
func VerifyFuncOrAbort(f @ir.Func)

// VerifyModule returns the structural IR defects across all funcs in m.
func VerifyModule(m @ir.Module) @[]ir.IRViolation

// EmitCCall emits a `__c_call` to a verbatim C symbol.  Unlike EmitCall,
// the symbol is stored on StrVal WITHOUT mangling (it names a real C
// symbol like `abs`, not a mangled Binate `bn_F...` func symbol).  fixedArgs is the
// count of fixed (named) arguments; the call is variadic iff fixedArgs <
// len(args).  resultTyp is the return type (nil/void => no result).
func EmitCCall(b @ir.Block, symbol @[]char, args @[]@ir.Instr, resultTyp @types.Type, fixedArgs int,
		variadic bool) @ir.Instr

// EmitCEntry emits an OP_C_ENTRY whose result is the address of a C entry of the
// declared function `funcName`, a raw *uint8 (spec §16.9 pkg.centry).  Like
// EmitFuncHandle it carries the (pkg-path-qualified) function name on StrVal so
// the backends can mangle it, takes no Args, and registers no cleanup temp (a
// code address borrows no managed value).  Compiled-mode only — the VM does no
// FFI, so an interpreted context rejects __c_entry at type-check.
func EmitCEntry(b @ir.Block, funcName *[]readonly char) @ir.Instr

// EmitCGlobal emits `__c_global("sym", T)` — an OP_C_GLOBAL whose result is the
// ADDRESS of the external C global `sym`, a raw *pointeeTyp.  StrVal holds the
// VERBATIM C symbol (no mangling, like EmitCCall); Typ is *T (the SSA result
// type) and TypeArg is T (the pointee, so backends can declare the external
// global / size the reference).  No Args, and the raw-pointer result is never
// registered as a managed temp (no refcount header on foreign storage).
func EmitCGlobal(b @ir.Block, symbol @[]char, pointeeTyp @types.Type) @ir.Instr

// EmitCallHandle emits a call through a function-value handle pointer.
// handle must be a *uint8 pointing at a 16-byte {vtable_ptr, data_ptr}
// structure (the result of EmitFuncHandle).  Backends load the handle's
// vtable.call and data, then dispatch as `call(data, args)`.  Args
// layout: `[handle, user_args...]`.  resultTyp is the return type
// (use TypVoid for void-returning calls; nil also accepted as void).
func EmitCallHandle(b @ir.Block, handle @ir.Instr, args @[]@ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitCallLocal emits a direct call to a MODULE-LOCAL symbol by its exact
// name, WITHOUT qualifying it with the enclosing function's package.  It is
// for the synthetic weak_odr element/backing dtor & copy helpers (`__dtor_ms_*`,
// `__dtor_arr*`, and the `__copy_` twins) that ensureMsDtor / ensureArrayDtor
// emit into whatever module needs them, under that module's package.  A plain
// EmitCall would qualify the bare name with `f.ModulePkgPath` — which, for a
// cross-package GENERIC instantiation whose struct/element dtor is attributed to
// the generic's HOME package but emitted into the CONSUMER's module, is the home
// package, not the module that defines the helper.  That names a symbol no module
// emits (compiled: undefined value; VM: extern not found).  Leaving the name bare
// lets codegen mangle it with the current module's package, resolving to this
// module's weak_odr copy — where the def actually lands.
func EmitCallLocal(b @ir.Block, name @[]char, args @[]@ir.Instr, resultTyp @types.Type) @ir.Instr

// EmitDataSymAddr emits an OP_DATA_SYM_ADDR whose result is the ADDRESS of a
// LOCAL Binate data global named by its already-MANGLED symbol `sym` (e.g.
// `__typeinfo.bn_…` / `__ifaceid.bn_…`), a raw *pointeeTyp.  Like EmitCGlobal it
// carries the pointee type on TypeArg (so LLVM can spell the `bitcast <T>*
// @<sym>`) and takes no Args, but the symbol is a Binate mangled name reached by
// a plain local address (not the verbatim GOT-indirect C symbol of EmitCGlobal).
// The compiled backends resolve the symbol via the linker; the VM lowers this to
// BC_DATA_SYM_ADDR, which resolves it at exec against the materialized
// data-symbol table (lookupDataSymAddr — RTTI Slice 5b).
func EmitDataSymAddr(b @ir.Block, sym @[]char, pointeeTyp @types.Type) @ir.Instr

// EmitDivCheck emits a runtime divide-fault guard before an integer
// OP_DIV / OP_REM. dividend and divisor must already be sign/zero-
// extended to 64-bit. width is the operand type's resolved bit width
// and signed its signedness — carried on IntVal / BoolVal so each
// backend can recover the type's signed MIN for the MIN/-1 check.
func EmitDivCheck(b @ir.Block, dividend @ir.Instr, divisor @ir.Instr, width int, signed bool)

// EmitFuncHandle emits a reference to a named function's static handle
// as an i8* value.  Result points at a 16-byte {vtable_ptr, data_ptr}
// block — either the bnc-emitted static `@__handle.F` or a runtime-
// allocated heap handle (for bytecode-only functions).  Consumed by
// OP_CALL_HANDLE (`_call_free_fn` lowering).
func EmitFuncHandle(b @ir.Block, funcName *[]readonly char) @ir.Instr

// EmitIfaceTypeInfo emits an OP_IFACE_TYPEINFO that reads the dynamic
// `*TypeInfo` out of an interface value's vtable any-block slot 1 (spec
// §7.13.8 / §11.12).  Args[0] is the iface value `iv`; the op extracts iv's
// vtable word (like OP_IFACE_DTOR) and reads slot 1 of it.  The caller has
// already null-checked the vtable word (a null vtable short-circuits to an
// assertion miss before this runs).  The result is a raw `*uint8` (the
// `*TypeInfo`).  A dedicated op rather than a GEP+LOAD of slot 1 because the
// vtable word's representation is backend-specific: native carries a real
// `@__ivt` pointer (GEP+LOAD works), but the VM carries a 1-based
// vm.IfaceVtables index (a per-vm dispatch table whose indices never leave the
// vm) — so the VM must resolve the type identity
// through that table, exactly as OP_IFACE_DTOR / OP_CALL_IFACE_METHOD read a
// vtable slot.
func EmitIfaceTypeInfo(b @ir.Block, iv @ir.Instr) @ir.Instr

// EmitIfaceTypeInfoAs is EmitIfaceTypeInfo with a caller-chosen POINTER result
// type.  The op yields the raw `*TypeInfo` word as a pointer value (an i8* at the
// LLVM level, like any raw-pointer-returning call); typing the result as e.g.
// `*reflect.TypeInfo` lets `reflect.TypeOf` return that pointer directly — a
// field access re-bitcasts the i8* exactly as it does for a `*T`-returning
// function — instead of routing through a separate OP_BIT_CAST whose TypeArg a
// downstream selector's field-access arm would clobber.  `resultTyp` MUST be a
// pointer type (the op produces a pointer word); the op's codegen ignores the
// result's TypeArg, so a selector setting it is harmless.
func EmitIfaceTypeInfoAs(b @ir.Block, iv @ir.Instr, resultTyp @types.Type) @ir.Instr

// EmitIfaceValueDyn emits an interface-value construction whose vtable
// is a RUNTIME value in a register, not a static `@__ivt.<...>` symbol.
// It is the same OP_IFACE_VALUE op as EmitIfaceValue, but with StrVal
// left EMPTY: an empty StrVal is what selects the dynamic-vtable form,
// where Args[1] holds the runtime vtable pointer (Args = [data, vtable]).
// Used by interface-assertion recovery (RTTI Slice 5), where the vtable
// to install is recovered from the satisfaction registry at runtime
// rather than known at type-check time. All backends lower the dynamic
// form: the native ones build {data, vtable} directly; the VM lowers it
// to BC_IFACE_VALUE_DYN (RTTI Slice 5b-2, see vm/lower_call.bn).
func EmitIfaceValueDyn(b @ir.Block, dataPtr @ir.Instr, vtablePtr @ir.Instr,
		resultTyp @types.Type) @ir.Instr

// EmitManagedToRaw converts a managed-slice (@[]T) to a raw slice (*[]T).
func EmitManagedToRaw(b @ir.Block, val @ir.Instr) @ir.Instr

// EmitPresent lowers `present(x)` for every sensible type — "does x hold
// something / is it set?".  Per kind: an interface value is present iff
// its vtable word is set (field 1 — {data, vtable}); a function value iff
// its vtable word is set (field 0 — {vtable, data}); a pointer iff
// non-null; a slice iff non-empty (len > 0 — a length-0 slice has no
// backing per the invariant, so len>0 is exactly "holds something").
// Value types are never operands (the checker rejects them).
func EmitPresent(b @ir.Block, x @ir.Instr, typ @types.Type) @ir.Instr

// EmitReturnTyped emits a return with an explicit multi-return struct type.
func EmitReturnTyped(b @ir.Block, vals @[]@ir.Instr, retTyp @types.Type)

// EmitSame lowers `same(a, other)`: reference identity for the type the
// checker already validated (pointer, interface value, or slice — both
// operands the same type).  A pointer compares as one word; an interface
// value compares both {data, vtable} words; a slice compares its view
// {data, len}.  Built from extract + OP_EQ + OP_LAND (OP_LAND is the
// non-short-circuit bool-and), so every backend lowers it for free (cf.
// EmitIfacePresent).
func EmitSame(b @ir.Block, a @ir.Instr, other @ir.Instr, typ @types.Type) @ir.Instr

// EmitSatLookup emits an OP_SAT_LOOKUP — the interface-satisfaction query
// `(dynamic *TypeInfo ti, &__ifaceid.<J> ifaceId) -> sub-vtable word | nil` an
// interface-target assertion `x.(*J)` runs to resolve the scrutinee's dynamic
// type against J.  The op is structurally a call to `rt.SatLookup` (it carries
// that name in StrVal and the two args, and a `*uint8` result), so the compiled
// backends lower it exactly as that call — querying the native itab-hash.  The
// distinct opcode exists only so the bytecode VM can lower it to BC_SAT_LOOKUP
// -> lookupSatEntry over its own `@VM` satentry registry (the native rt
// itab-hash is never built in the VM, so its bytecode rt.SatLookup would MISS).
func EmitSatLookup(b @ir.Block, ti @ir.Instr, ifaceId @ir.Instr) @ir.Instr

// EmitShiftCheck emits a runtime negative-shift-count guard before a
// guarded integer shift. count must already be sign-extended to 64-bit so
// a negative count of any width reads as negative. Lowers to a call to
// rt.ShiftCheck, which panics on a negative count.
func EmitShiftCheck(b @ir.Block, count @ir.Instr)

// EmitSliceElemPtr returns a pointer to a slice element (no load).
func EmitSliceElemPtr(b @ir.Block, slice @ir.Instr, index @ir.Instr, elemTyp @types.Type) @ir.Instr

// EmitStackCheckFV appends OP_STACK_CHECK_FV for a FUNC-VALUE call — the analog of
// EmitStackCheck for a callee that is a runtime value, not a static name.  fnVal is
// the func-value operand (already evaluated); the VM handler recognizes a same-vm VM
// function value by thunk identity and faults (via the op's args-owning cleanup pad)
// if pushing the callee frame would overflow, or if the func value is nil.  See the
// iropcode.bni doc.
func EmitStackCheckFV(b @ir.Block, fnVal @ir.Instr)

// EmitStackCheckIM appends OP_STACK_CHECK_IM for an INTERFACE-METHOD call — the
// analog of EmitStackCheckFV whose runtime callee is resolved from an interface
// receiver + a method vtable slot.  iv is the interface-value receiver (already
// evaluated); slot is the absolute method vtable slot (the same value carried on
// the OP_CALL_IFACE_METHOD op's Index).  The VM handler resolves the callee VMFunc
// from iv's vtable + slot and faults (via the op's args-owning cleanup pad) if
// pushing the callee frame would overflow, or if the interface value is nil.  See
// the iropcode.bni doc.
func EmitStackCheckIM(b @ir.Block, iv @ir.Instr, slot int)

// EmitStringToChars converts a string constant to a char slice
// (*[]readonly char, @[]char, or @[]readonly char). Phase 3.2 dispatch:
//
//   read-only managed-slice target (`@[]readonly char`)
//     → OP_RODATA_MSLICE   (zero-copy alias of static global)
//   read-only raw-slice target (`*[]readonly char`)
//     → OP_RODATA_SLICE    (zero-copy alias of {data, len} prefix)
//   mutable managed-slice target (`@[]char`, Stage 2b)
//     → OP_RODATA_MSLICE_COPY  (alloc + memcpy from static global)
//
// All three ops are non-string-specific; the same lowering applies
// to user-written const-byte composite literals (3.1).
func EmitStringToChars(b @ir.Block, str @ir.Instr, sliceTyp @types.Type) @ir.Instr
