package "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/vec"

// Building blocks for a func and its instructions: params and extern funcs, the
// fixed-size argument slices, void instructions, param and global-address
// references, a block's index in its func, and import-alias resolution.

// NewExternFunc creates an extern function declaration (no body, no param IDs).
func NewExternFunc(pkgPath @[]char, name @[]char, params @[]@ir.Param,
		results @[]@types.Type) @ir.Func {
	var f @ir.Func = make(ir.Func)
	if len(pkgPath) > 0 {
		f.Name = mangle.QualifyName(pkgPath, name)
	} else {
		f.Name = name
	}
	f.ModulePkgPath = pkgPath
	f.Params = params
	f.Results = results
	// A multi-return extern needs its result-tuple type, exactly as a local func
	// gets it (gen_func.bn) — codegen's sret decision (FuncReturnsBigMultiReturn)
	// reads f.MultiReturnType, so leaving it nil makes a cross-module call emit
	// the register-FCA convention while the defining module sret's the callee: an
	// ABI mismatch that corrupts a stack-spilled param on x64 (session.bn:193).
	if len(results) > 1 {
		f.MultiReturnType = irutil.MakeMultiReturnStructType(results)
	}
	f.IsExtern = true
	f.NextID = 0
	return f
}

// NewParam creates a new function parameter and assigns it a unique ID.
func NewParam(f @ir.Func, name @[]char, typ @types.Type) @ir.Param {
	var p @ir.Param = make(ir.Param)
	p.Name = name
	p.Typ = typ
	p.ID = f.NextID
	f.NextID = f.NextID + 1
	return p
}

// NewVoidInstr allocates a void instruction (ID -1, no result value).
func NewVoidInstr(op int) @ir.Instr {
	var instr @ir.Instr = make(ir.Instr)
	instr.ID = -1
	instr.Op = op
	return instr
}

// NewParamRef builds the by-ID placeholder @ir.Instr that stands for parameter `p`:
// an operand whose ID equals p's ID, which every backend resolves to the incoming
// argument (LLVM `%v<id>` / the VM+native param slot) straight from the function
// signature.  It is only ever an operand — never appended to a block as a def.
//
// Its opcode is OP_PARAM, NOT OP_CONST_INT.  A distinct opcode is load-bearing:
// the shared IR-level SSA passes read `.Op` (mem2reg / load-forwarding forward the
// placeholder as a param-slot load's reaching value; bceConstIndexFunc / bceLoopFunc
// inspect the resulting operand).  Spelled OP_CONST_INT — enum value 0, default
// IntVal 0 — those passes mistook a parameter for the integer constant 0 and
// dropped bounds checks (a silent -O1 out-of-bounds miscompile); OP_PARAM keeps a
// parameter from ever looking like a constant.
//
// IsByvalParamRef is set for a byval-aggregate param so that an OP_STORE of this
// ref into its slot lowers as a memcpy from the `ptr byval(<T>)` incoming pointer
// rather than a value store.  The flag is consumed ONLY by the store emitter, so
// it is inert on a ref that is instead loaded-through or forwarded (e.g. an
// interface-thunk's byval pass-through).
func NewParamRef(f @ir.Func, p @ir.Param) @ir.Instr {
	var ref @ir.Instr = make(ir.Instr)
	ref.ID = p.ID
	ref.Typ = p.Typ
	ref.Op = iropcode.OP_PARAM
	ref.IsByvalParamRef = p.Typ.IsByvalParam()
	if f.ParamRefs == nil {
		f.ParamRefs = vec.New[@ir.Instr]()
	}
	f.ParamRefs.Push(ref)
	return ref
}

// NewGlobalRef builds and registers a global-address pseudo (see the
// declaration).
func NewGlobalRef(m @ir.Module, name *[]readonly char, typ @types.Type) @ir.Instr {
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.Op = iropcode.OP_ALLOC
	g.StrVal = buf.CopyStr(name)
	g.Typ = types.MakePointerType(typ)
	g.TypeArg = typ
	g.IsGlobalRef = true
	if m.GlobalRefs == nil {
		m.GlobalRefs = vec.New[@ir.Instr]()
	}
	m.GlobalRefs.Push(g)
	return g
}

// Internal: build fixed-size Args slices
func MakeArgs1(a @ir.Instr) @[]@ir.Instr {
	var s @[]@ir.Instr = make_slice(@ir.Instr, 1)
	s[0] = a
	return s
}

// MakeArgs2 builds a 2-element instruction argument slice.
func MakeArgs2(a @ir.Instr, b @ir.Instr) @[]@ir.Instr {
	var s @[]@ir.Instr = make_slice(@ir.Instr, 2)
	s[0] = a
	s[1] = b
	return s
}

// BlockIndexIn returns i with f.Blocks[i] == target (reference identity),
// or -1 if target is not a block of f.
func BlockIndexIn(f @ir.Func, target *ir.Block) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return i
		}
	}
	return -1
}

// ResolveImportPkg maps an import alias to its full package path via
// m's import-alias map (m.ImportAliasNames / m.ImportAliasPaths — parallel
// arrays keyed alias short-name -> full path).  Returns a copy of the input
// unchanged when it isn't a known import alias — covering same-package
// references, names that are already full paths, and the universe package.
// This is the single point where the short source-level alias becomes the
// full path in the IR namespace (full-path mangling; see pkg/binate/mangle).
func ResolveImportPkg(m @ir.Module, alias *[]readonly char) @[]char {
	for i := 0; i < len(m.ImportAliasNames); i++ {
		if irutil.Streq(m.ImportAliasNames[i], alias) {
			return m.ImportAliasPaths[i]
		}
	}
	return buf.CopyStr(alias)
}
