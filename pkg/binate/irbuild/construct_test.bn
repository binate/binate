package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"

// NewParam numbers a func's params in order from its next SSA ID.
func TestNewParamAssignsSequentialIDs() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "f", noParams, noResults)
	var a @ir.Param = NewParam(f, "a", types.TypInt())
	var b @ir.Param = NewParam(f, "b", types.TypBool())
	if b.ID != a.ID + 1 || f.NextID != b.ID + 1 {
		return fail("NewParam should take consecutive IDs and advance NextID")
	}
	return ""
}

// NewExternFunc qualifies the name, marks the func extern, and gives a
// multi-result signature its result-tuple type.
func TestNewExternFuncQualifiesAndTuples() testing.TestResult {
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypInt()
	results[1] = types.TypBool()
	var f @ir.Func = NewExternFunc("pkg/p", "g", noParams, results)
	if !f.IsExtern || f.MultiReturnType == nil || !irutil.Streq(f.ModulePkgPath, "pkg/p") {
		return fail("NewExternFunc should mark extern, set the tuple type and the package")
	}
	var one @ir.Func = NewExternFunc("", "h", noParams, noResults)
	if !irutil.Streq(one.Name, "h") || one.MultiReturnType != nil {
		return fail("an unqualified, single-result extern keeps its name and has no tuple")
	}
	return ""
}

// NewParamRef and NewGlobalRef register their placeholders with the owning
// func / module, with the opcode and type each stands for.
func TestParamAndGlobalRefsRegister() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "f", noParams, noResults)
	var p @ir.Param = NewParam(f, "x", types.TypInt())
	var ref @ir.Instr = NewParamRef(f, p)
	if ref.Op != iropcode.OP_PARAM || ref.ID != p.ID || f.ParamRefs == nil || f.ParamRefs.Len() != 1 {
		return fail("NewParamRef should register an OP_PARAM ref carrying the param's ID")
	}
	var m @ir.Module = ir.NewModule("test")
	var g @ir.Instr = NewGlobalRef(m, "G", types.TypInt())
	if !g.IsGlobalRef || g.Typ.Kind != types.TYP_POINTER || m.GlobalRefs == nil ||
			m.GlobalRefs.Len() != 1 {
		return fail("NewGlobalRef should register a pointer-typed global-address pseudo")
	}
	return ""
}

// MakeArgs builds argument slices of the given instructions; NewVoidInstr has no
// result ID; BlockIndexIn finds a block by identity.
func TestArgsVoidAndBlockIndex() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "f", noParams, noResults)
	var b0 @ir.Block = ir.AddBlock(f, "entry")
	var b1 @ir.Block = ir.AddBlock(f, "next")
	if BlockIndexIn(f, b1) != 1 || BlockIndexIn(f, b0) != 0 {
		return fail("BlockIndexIn should find each block's index")
	}
	var v @ir.Instr = NewVoidInstr(iropcode.OP_RETURN)
	var w @ir.Instr = NewVoidInstr(iropcode.OP_RETURN)
	if v.ID != -1 || len(MakeArgs1(v)) != 1 || len(MakeArgs2(v, w)) != 2 || MakeArgs2(v, w)[1] != w {
		return fail("NewVoidInstr should have ID -1 and MakeArgs keep its operands in order")
	}
	return ""
}

// ResolveImportPkg maps an import alias to its package path, and returns any
// other name unchanged.
func TestResolveImportPkg() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	m.ImportAliasNames = make_slice(@[]char, 1)
	m.ImportAliasPaths = make_slice(@[]char, 1)
	m.ImportAliasNames[0] = "fmt"
	m.ImportAliasPaths[0] = "pkg/std/fmt"
	if !irutil.Streq(ResolveImportPkg(m, "fmt"), "pkg/std/fmt") ||
			!irutil.Streq(ResolveImportPkg(m, "os"), "os") {
		return fail("ResolveImportPkg should map a known alias and pass others through")
	}
	return ""
}
