package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/types"

// ============================================================
// Slices & arrays
// ============================================================

// EmitSliceLen extracts the length field from a slice value.
func EmitSliceLen(b @ir.Block, slice @ir.Instr) @ir.Instr {
	// Lower to primitive: extract len field (field 1) from slice struct.
	return EmitExtract(b, slice, 1, types.TypInt())
}

// EmitIfacePresent lowers `present(iv)`: an interface value is a 2-word
// {data, vtable} aggregate, and is "present" (holds a concrete impl)
// iff its vtable word (field 1) is non-null.  Honest about typed-nil —
// boxing a nil `*T` still fills the vtable, so the result is true.
// Interface values are not nillable (see claude-notes.md:1141), so this
// is the only emptiness test; it reuses the generic extract + compare
// primitives (no dedicated op, so every backend lowers it for free).
func EmitIfacePresent(b @ir.Block, iv @ir.Instr) @ir.Instr {
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var vtable @ir.Instr = EmitExtract(b, iv, 1, rawPtrTyp)
	var nullp @ir.Instr = EmitConstNil(b, rawPtrTyp)
	return EmitBinop(b, iropcode.OP_NE, vtable, nullp, types.TypBool())
}

// EmitPresent lowers `present(x)` for every sensible type — "does x hold
// something / is it set?".  Per kind: an interface value is present iff
// its vtable word is set (field 1 — {data, vtable}); a function value iff
// its vtable word is set (field 0 — {vtable, data}); a pointer iff
// non-null; a slice iff non-empty (len > 0 — a length-0 slice has no
// backing per the invariant, so len>0 is exactly "holds something").
// Value types are never operands (the checker rejects them).
func EmitPresent(b @ir.Block, x @ir.Instr, typ @types.Type) @ir.Instr {
	var t @types.Type = ir.PeelToUnderlying(typ)
	if t != nil &&
			(t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		return EmitIfacePresent(b, x)
	}
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var nullp @ir.Instr = EmitConstNil(b, rawPtrTyp)
	if t != nil && (t.Kind == types.TYP_FUNC_VALUE || t.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		var vtable @ir.Instr = EmitExtract(b, x, 0, rawPtrTyp)
		return EmitBinop(b, iropcode.OP_NE, vtable, nullp, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR) {
		var xp @ir.Instr = EmitBitCast(b, x, rawPtrTyp)
		return EmitBinop(b, iropcode.OP_NE, xp, nullp, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE) {
		var n @ir.Instr = EmitSliceLen(b, x)
		var zero @ir.Instr = EmitConstInt(b, 0, types.TypInt())
		return EmitBinop(b, iropcode.OP_GT, n, zero, types.TypBool())
	}
	// The checker guarantees one of the above; default to false.
	return EmitConstBool(b, false)
}

// EmitSame lowers `same(a, other)`: reference identity for the type the
// checker already validated (pointer, interface value, or slice — both
// operands the same type).  A pointer compares as one word; an interface
// value compares both {data, vtable} words; a slice compares its view
// {data, len}.  Built from extract + OP_EQ + OP_LAND (OP_LAND is the
// non-short-circuit bool-and), so every backend lowers it for free (cf.
// EmitIfacePresent).
func EmitSame(b @ir.Block, a @ir.Instr, other @ir.Instr, typ @types.Type) @ir.Instr {
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var t @types.Type = ir.PeelToUnderlying(typ)
	if t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR) {
		return EmitBinop(b, iropcode.OP_EQ, a, other, types.TypBool())
	}
	if t != nil &&
			(t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		var da @ir.Instr = EmitExtract(b, a, 0, rawPtrTyp)
		var db @ir.Instr = EmitExtract(b, other, 0, rawPtrTyp)
		var dataEq @ir.Instr = EmitBinop(b, iropcode.OP_EQ, da, db, types.TypBool())
		var va @ir.Instr = EmitExtract(b, a, 1, rawPtrTyp)
		var vb @ir.Instr = EmitExtract(b, other, 1, rawPtrTyp)
		var vtblEq @ir.Instr = EmitBinop(b, iropcode.OP_EQ, va, vb, types.TypBool())
		return EmitBinop(b, iropcode.OP_LAND, dataEq, vtblEq, types.TypBool())
	}
	if t != nil && (t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE) {
		var sa @ir.Instr = EmitExtract(b, a, 0, rawPtrTyp)
		var sb @ir.Instr = EmitExtract(b, other, 0, rawPtrTyp)
		var dataEq @ir.Instr = EmitBinop(b, iropcode.OP_EQ, sa, sb, types.TypBool())
		var la @ir.Instr = EmitExtract(b, a, 1, types.TypInt())
		var lb @ir.Instr = EmitExtract(b, other, 1, types.TypInt())
		var lenEq @ir.Instr = EmitBinop(b, iropcode.OP_EQ, la, lb, types.TypBool())
		return EmitBinop(b, iropcode.OP_LAND, dataEq, lenEq, types.TypBool())
	}
	// The checker guarantees one of the above; fall back to a one-word
	// compare rather than emitting nothing.
	return EmitBinop(b, iropcode.OP_EQ, a, other, types.TypBool())
}

// EmitSliceGet loads an element from a slice at the given index.
func EmitSliceGet(b @ir.Block, slice @ir.Instr, index @ir.Instr, elemTyp @types.Type) @ir.Instr {
	// Lower to primitives: extract data ptr (i8*), GEP by index, load.
	// The codegen's GEP handler bitcasts i8* to *elemType automatically.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @ir.Instr = EmitExtract(b, slice, 0, rawPtrTyp)
	var elemPtr @ir.Instr = EmitGetElemPtr(b, dataPtr, index, elemTyp)
	return EmitLoad(b, elemPtr, elemTyp)
}

// EmitSliceSet stores a value into a slice element at the given index.
func EmitSliceSet(b @ir.Block, slice @ir.Instr, index @ir.Instr, val @ir.Instr,
		elemTyp @types.Type) {
	// Lower to primitives: extract data ptr, GEP by index, store.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @ir.Instr = EmitExtract(b, slice, 0, rawPtrTyp)
	var elemPtr @ir.Instr = EmitGetElemPtr(b, dataPtr, index, elemTyp)
	EmitStore(b, elemPtr, val)
}

// EmitSliceElemPtr returns a pointer to a slice element (no load).
func EmitSliceElemPtr(b @ir.Block, slice @ir.Instr, index @ir.Instr,
		elemTyp @types.Type) @ir.Instr {
	// Lower to primitives: extract data ptr, GEP by index (returns pointer, no load).
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @ir.Instr = EmitExtract(b, slice, 0, rawPtrTyp)
	return EmitGetElemPtr(b, dataPtr, index, elemTyp)
}

// EmitSliceExpr emits a subslice operation (s[lo:hi]) as a zero-copy view adjustment.
func EmitSliceExpr(b @ir.Block, slice @ir.Instr, lo @ir.Instr, hi @ir.Instr,
		typ @types.Type) @ir.Instr {
	// Lower to primitives: zero-copy view adjustment.
	// Raw slice result: {data + lo * elemSize, hi - lo}
	// Managed slice result: {data + lo * elemSize, hi - lo, refptr, backingLen}
	// Peel a transparent wrapper (named / readonly / alias) to the underlying
	// @[]T. The header-field decision below keys off Kind, and the element
	// stride off `.Elem`, both of which a bare TYP_NAMED reports wrong (Kind is
	// TYP_NAMED, not TYP_MANAGED_SLICE; `.Elem` is nil). Without peeling, a
	// named-managed-slice subslice skips the backing_refptr/backingLen stores,
	// so those header words stay uninitialized: the subslice never pins its
	// backing (use-after-free) and its garbage refptr is RefInc/RefDec'd.
	var ut @types.Type = irutil.PeelTransparent(typ)
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @ir.Instr = EmitExtract(b, slice, 0, rawPtrTyp)

	// Compute new data pointer: data + lo * elemSize (byte-level GEP on i8*).
	// We use byte arithmetic to avoid LLVM type mismatches — the codegen's
	// GEP handler for raw pointers emits an internal bitcast that produces a
	// typed pointer (e.g., i64*), but slice field 0 expects i8*.
	var elemTyp @types.Type = ut.Elem
	var elemSize @ir.Instr = EmitConstInt(b, elemTyp.SizeOf(), types.TypInt())
	var byteOffset @ir.Instr = EmitBinop(b, iropcode.OP_MUL, lo, elemSize, types.TypInt())
	var newData @ir.Instr = EmitGetElemPtr(b, dataPtr, byteOffset, types.TypUint8())

	// Compute new length: hi - lo
	var newLen @ir.Instr = EmitBinop(b, iropcode.OP_SUB, hi, lo, types.TypInt())

	// Length-0 ⟹ no backing (claude-notes.md "Nil slices" / "Length-0 ⟹
	// no backing"): a length-0 subslice is the nil-equivalent {null, 0}
	// (raw) / {null, 0, null, 0} (managed) — it carries no backing pointer
	// and, managed, does not pin the backing.  newLen is already 0 in the
	// empty case; null out data (and managed refptr/backingLen) so empty
	// and "nil" slices are indistinguishable.  Branchless: `keep` is 1 when
	// non-empty, 0 when empty, and maskPointer / `* keep` null the fields
	// when empty.  A branch here would need block-splitting — EmitSliceExpr
	// is a @Block method with no GenContext.  The unconditional RefInc the
	// caller (genSliceExpr) then applies hits a null refptr → no-op, so the
	// refcount stays balanced (dtor RefDec(null) is a no-op too).
	var zero @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	var nonEmpty @ir.Instr = EmitBinop(b, iropcode.OP_NE, newLen, zero, types.TypBool())
	var keep @ir.Instr = EmitCast(b, nonEmpty, types.TypInt())
	newData = maskPointer(b, newData, keep, rawPtrTyp)

	// Build result slice via alloca + field stores + load
	var sliceAlloca @ir.Instr = EmitAlloc(b, typ)
	var f0 @ir.Instr = EmitGetFieldPtr(b, sliceAlloca, 0, rawPtrTyp)
	EmitStore(b, f0, newData)
	var f1 @ir.Instr = EmitGetFieldPtr(b, sliceAlloca, 1, types.TypInt())
	EmitStore(b, f1, newLen)

	if ut.Kind == types.TYP_MANAGED_SLICE {
		// Preserve backing refptr and backingLen from original — but null
		// them for a length-0 result (no backing, per the invariant above).
		var refptr @ir.Instr = EmitExtract(b, slice, 2, rawPtrTyp)
		var backingLen @ir.Instr = EmitExtract(b, slice, 3, types.TypInt())
		refptr = maskPointer(b, refptr, keep, rawPtrTyp)
		backingLen = EmitBinop(b, iropcode.OP_MUL, backingLen, keep, types.TypInt())
		var f2 @ir.Instr = EmitGetFieldPtr(b, sliceAlloca, 2, rawPtrTyp)
		EmitStore(b, f2, refptr)
		var f3 @ir.Instr = EmitGetFieldPtr(b, sliceAlloca, 3, types.TypInt())
		EmitStore(b, f3, backingLen)
	}

	return EmitLoad(b, sliceAlloca, typ)
}

// EmitBoundsCheck emits a runtime bounds check that panics if index >= length.
func EmitBoundsCheck(b @ir.Block, index @ir.Instr, length @ir.Instr) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_BOUNDS_CHECK)
	instr.Args = ir.MakeArgs2(index, length)
	addInstr(b, instr)
}

// EmitStackCheck appends OP_STACK_CHECK for a call to `name` (the callee-name
// string, qualified with the module's package path like EmitCall) — a VM-only
// pre-check emitted just before a call commits its args.  See the ir.bni doc.
func EmitStackCheck(b @ir.Block, name *[]readonly char) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_STACK_CHECK)
	instr.StrVal = irutil.QualifyForPkgPath(b.Func.ModulePkgPath, name)
	addInstr(b, instr)
}

// EmitStackCheckFV appends OP_STACK_CHECK_FV for a FUNC-VALUE call — the analog of
// EmitStackCheck for a callee that is a runtime value, not a static name.  fnVal is
// the func-value operand (already evaluated); the VM handler recognizes a same-vm VM
// function value by thunk identity and faults (via the op's args-owning cleanup pad)
// if pushing the callee frame would overflow, or if the func value is nil.  See the
// iropcode.bni doc.
func EmitStackCheckFV(b @ir.Block, fnVal @ir.Instr) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_STACK_CHECK_FV)
	instr.Args = ir.MakeArgs1(fnVal)
	addInstr(b, instr)
}

// EmitStackCheckIM appends OP_STACK_CHECK_IM for an INTERFACE-METHOD call — the
// analog of EmitStackCheckFV whose runtime callee is resolved from an interface
// receiver + a method vtable slot.  iv is the interface-value receiver (already
// evaluated); slot is the absolute method vtable slot (the same value carried on
// the OP_CALL_IFACE_METHOD op's Index).  The VM handler resolves the callee VMFunc
// from iv's vtable + slot and faults (via the op's args-owning cleanup pad) if
// pushing the callee frame would overflow, or if the interface value is nil.  See
// the iropcode.bni doc.
func EmitStackCheckIM(b @ir.Block, iv @ir.Instr, slot int) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_STACK_CHECK_IM)
	instr.Args = ir.MakeArgs1(iv)
	instr.IntVal = cast(int64, slot)
	addInstr(b, instr)
}

// EmitDivCheck emits a runtime divide-fault guard before an integer
// OP_DIV / OP_REM. dividend and divisor must already be sign/zero-
// extended to 64-bit. width is the operand type's resolved bit width
// and signed its signedness — carried on IntVal / BoolVal so each
// backend can recover the type's signed MIN for the MIN/-1 check.
func EmitDivCheck(b @ir.Block, dividend @ir.Instr, divisor @ir.Instr, width int, signed bool) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_DIV_CHECK)
	instr.Args = ir.MakeArgs2(dividend, divisor)
	instr.IntVal = cast(int64, width)
	instr.BoolVal = signed
	addInstr(b, instr)
}

// EmitShiftCheck emits a runtime negative-shift-count guard before a
// guarded integer shift. count must already be sign-extended to 64-bit so
// a negative count of any width reads as negative. Lowers to a call to
// rt.ShiftCheck, which panics on a negative count.
func EmitShiftCheck(b @ir.Block, count @ir.Instr) {
	var instr @ir.Instr = ir.NewVoidInstr(iropcode.OP_SHIFT_CHECK)
	instr.Args = ir.MakeArgs1(count)
	addInstr(b, instr)
}

// EmitUnwindReturn appends the terminator of a VM-only cleanup landing pad
// (Func.FaultPads): pop the frame like a return but copy back no value, then
// continue the fault unwind in the caller.  Only the VM lowers it (->
// BC_UNWIND_RETURN); the compiled backends never see it.
func EmitUnwindReturn(b @ir.Block) {
	addInstr(b, ir.NewVoidInstr(iropcode.OP_UNWIND_RETURN))
}

// ============================================================
// Strings
// ============================================================

// EmitStringToChars converts a string constant to a char slice
// (*[]readonly char, @[]char, or @[]readonly char). Phase 3.2 dispatch:
//
//   read-only managed-slice target (`@[]readonly char`)
//     → OP_RODATA_MSLICE   (zero-copy alias of static global)
//   read-only raw-slice target (`*[]readonly char`)
//     → OP_RODATA_SLICE    (zero-copy alias of {data, len} prefix)
//   mutable managed-slice target (`@[]char`, Stage 2b)
//     → OP_RODATA_MSLICE_COPY  (alloc + memcpy from static global)
//
// All three ops are non-string-specific; the same lowering applies
// to user-written const-byte composite literals (3.1).
func EmitStringToChars(b @ir.Block, str @ir.Instr, sliceTyp @types.Type) @ir.Instr {
	// Peel transparent wrappers (outer readonly / distinct-named / alias) to the
	// underlying slice type before dispatching, so a distinct named char-slice
	// destination (`type Str @[]char`) materializes exactly like @[]char instead
	// of falling through to a raw {ptr,len} slice stored into a managed slot.
	// peelTransparent subsumes the old alias/readonly peel loops; the result
	// records the peeled slice type, matching the peeled type the already-correct
	// assignment path (gen_control) hands in.  An element `readonly` stays intact
	// (peelTransparent only strips the outer chain), so @[]readonly char still
	// aliases (no copy) while @[]char copies.
	var resolved @types.Type = irutil.PeelTransparent(sliceTyp)
	if stringToCharsNeedsImplicitCopy(resolved) {
		return EmitRodataMSliceCopy(b, str.StrVal, resolved)
	}
	if resolved != nil && resolved.Kind == types.TYP_MANAGED_SLICE {
		return EmitRodataMSlice(b, str.StrVal, resolved)
	}
	return EmitRodataSlice(b, str.StrVal, resolved)
}

// EmitRodataMSlice emits a managed-slice composite literal that aliases
// a static rodata global. Used when the entire literal is compile-time
// constant bytes and the target is `@[]readonly T` (read-only view —
// aliasing rodata is sound). `bytes` is the byte sequence to embed.
func EmitRodataMSlice(b @ir.Block, bytes @[]char, sliceTyp @types.Type) @ir.Instr {
	// Length-0 ⟹ no backing: an empty literal/string is the nil-equivalent
	// {null,0,null,0}, never a header aliasing an empty rodata global.
	if len(bytes) == 0 {
		return EmitConstNil(b, sliceTyp)
	}
	var f *ir.Func = b.Func
	var instr @ir.Instr = ir.NewInstr(f, iropcode.OP_RODATA_MSLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataSlice emits a raw-slice composite literal aliasing a static
// rodata global. Same byte-sequence shape as EmitRodataMSlice; codegen
// extracts the {data, len} prefix into a `*[]readonly T` value.
func EmitRodataSlice(b @ir.Block, bytes @[]char, sliceTyp @types.Type) @ir.Instr {
	// Length-0 ⟹ no backing: empty raw literal/string → nil-equivalent.
	if len(bytes) == 0 {
		return EmitConstNil(b, sliceTyp)
	}
	var f *ir.Func = b.Func
	var instr @ir.Instr = ir.NewInstr(f, iropcode.OP_RODATA_SLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataArray emits an array literal initialized from rodata
// bytes. Allocates an `[N]T` buffer (size from arrayTyp.ArrayLen),
// memcpys `min(len(bytes), N)` bytes from a static global, and
// zero-pads the tail. Result is the array value (codegen materializes
// it through an alloca + memcpy + load).
func EmitRodataArray(b @ir.Block, bytes @[]char, arrayTyp @types.Type) @ir.Instr {
	// Record the structural [N]T (peel readonly / distinct-named / alias) so this
	// array materializer stays consistent with the slice one (EmitStringToChars)
	// and with the IR contract that an instr's type carries its structural layout:
	// downstream (codegen stringToArrayLen) reads the length off `.ArrayLen`, which
	// is populated only on a TYP_ARRAY.  On the string-literal path the checker
	// requires an exact length (N == len(bytes)), so the byte-count fallback would
	// agree anyway — the peel is the robust, gate-consistent choice here, not a fix
	// for a reachable mis-size.
	var f *ir.Func = b.Func
	var instr @ir.Instr = ir.NewInstr(f, iropcode.OP_RODATA_ARRAY, irutil.PeelTransparent(arrayTyp))
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataMSliceCopy emits a managed-slice that owns a fresh copy
// of `bytes`: MakeManagedSlice(elemSize=1, len=N) + memcpy from the
// static rodata global. Refcount 1, independent of rodata. Used for
// `@[]char = "..."` (Stage 2b implicit copy) and any mutable
// managed-slice composite literal whose elements are compile-time
// const bytes.
func EmitRodataMSliceCopy(b @ir.Block, bytes @[]char, sliceTyp @types.Type) @ir.Instr {
	// (No length-0 guard needed: this lowers to MakeManagedSlice(1, len),
	// which already returns the nil-equivalent {null,0,null,0} for len 0 —
	// the copy path is compliant with length-0 ⟹ no backing as-is.)
	var f *ir.Func = b.Func
	var instr @ir.Instr = ir.NewInstr(f, iropcode.OP_RODATA_MSLICE_COPY, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// maskPointer returns p when keep == 1 and null when keep == 0 (keep ∈
// {0, 1}).  Branchless: reinterpret the pointer as a word-size int (`int`
// is pointer-width) and multiply by keep — ×1 is identity, ×0 yields
// null.  Mirrors rt's bit_cast(int, ptr) address arithmetic, so it lowers
// on every backend.  Used to null a length-0 slice's data / refptr.
func maskPointer(b @ir.Block, p @ir.Instr, keep @ir.Instr, ptrTyp @types.Type) @ir.Instr {
	var pInt @ir.Instr = EmitBitCast(b, p, types.TypInt())
	var masked @ir.Instr = EmitBinop(b, iropcode.OP_MUL, pInt, keep, types.TypInt())
	return EmitBitCast(b, masked, ptrTyp)
}

// stringToCharsNeedsImplicitCopy reports whether a string → slice
// conversion with target `sliceTyp` must allocate a fresh managed
// backing and memcpy the bytes in (Stage 2b rule for `@[]char`).
// Alias-the-static-global is correct for every other target:
//   *[]readonly char   : caller can only read, rodata is fine.
//   @[]char         : OWNED + MUTABLE; alias would let a write
//                     target the rodata page → copy.
//   @[]readonly char   : caller can only read, rodata is fine.
func stringToCharsNeedsImplicitCopy(sliceTyp @types.Type) bool {
	if sliceTyp == nil { return false }
	for sliceTyp != nil && sliceTyp.Kind == types.TYP_ALIAS {
		sliceTyp = sliceTyp.Target
	}
	if sliceTyp == nil { return false }
	// Outer const: permissive wrt capability — the holder is const.
	if sliceTyp.Kind == types.TYP_READONLY {
		return stringToCharsNeedsImplicitCopy(sliceTyp.Elem)
	}
	// Only managed-slices get the implicit copy; raw slices must
	// already be *[]readonly char by Stage 2a (ratchet), so no copy.
	if sliceTyp.Kind != types.TYP_MANAGED_SLICE { return false }
	var elem @types.Type = sliceTyp.Elem
	for elem != nil && elem.Kind == types.TYP_ALIAS { elem = elem.Target }
	if elem == nil { return false }
	// Element const → caller can only read → alias is fine.
	if elem.Kind == types.TYP_READONLY { return false }
	// @[]char with a plain char element → needs copy.
	return true
}
