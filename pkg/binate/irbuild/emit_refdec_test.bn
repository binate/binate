package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Dropping an opaque-EXPORTED managed @X must RefDec THROUGH the type's dtor (emitted as
// an OP_FUNC_HANDLE), not a null-dtor free that would leak X's managed fields — an
// importer can't see X's fields to decide NeedsDestruction, so it always RefDecs through
// the guaranteed public dtor.
func TestOpaqueManagedPtrRefDecRunsDtor() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var opq @types.Type = types.MakeNamedType(buf.CopyStr("pkg/opq.Handle"))
	opq.OpaqueExportPkg = buf.CopyStr("pkg/opq")
	var pv @ir.Instr = EmitConstNil(b, types.MakeManagedPtrType(opq))
	EmitManagedPtrRefDec(f, b, pv)
	if countOp(f, iropcode.OP_FUNC_HANDLE) < 1 {
		return fail("opaque managed drop should RefDec through the type's dtor, not a null free")
	}
	return ""
}

// Dropping a managed pointer to a named-over-struct (`@NB` for `type NB Box`, Box
// holding a managed field) must RefDec through Box's dtor, like dropping `@Box` —
// the TYP_NAMED pointee holds a Box, and a null-dtor free would leak Box's
// managed fields.
func TestNamedStructManagedPtrRefDecRunsDtor() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = buf.CopyStr("s")
	fields[0].Type = types.MakeManagedSliceType(types.TypInt())
	var boxTyp @types.Type = types.MakeStructType(buf.CopyStr("Box"), fields)
	var nb @types.Type = types.MakeNamedType(buf.CopyStr("NB"))
	nb.Underlying = boxTyp
	var pv @ir.Instr = EmitConstNil(b, types.MakeManagedPtrType(nb))
	EmitManagedPtrRefDec(f, b, pv)
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == iropcode.OP_FUNC_HANDLE {
			if !seq(b.Instrs[i].StrVal, irutil.QualifiedDtorName("Box")) {
				return fail("named-over-struct managed drop should RefDec through Box's dtor")
			}
			return ""
		}
	}
	return fail("named-over-struct managed drop should RefDec through a dtor, not a null free")
}
