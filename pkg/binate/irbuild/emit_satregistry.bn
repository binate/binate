package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Satisfaction-registry helper — the compiled-codegen side of the decentralized
// `__pkg_satfrag` graph.  emitBuildSatRegistryCall injects the runtime registry
// fill (a walk of the build root's `__pkg_satfrag` node) into `bn_init`; the
// `&__pkg_satfrag` LEA it emits also keeps the node — and thus the `__satentry`
// chain — alive under dead-strip (spec §11.12 `iface.rtti`).

// emitBuildSatRegistryCall appends to `blk` the two instructions that fill the
// runtime satisfaction registry by walking `m`'s `__pkg_satfrag` graph node: an
// OP_DATA_SYM_ADDR LEA of `&__pkg_satfrag` and the BuildSatRegistry call taking
// it.  The LEA is a real use, so it also keeps the node — and thus the
// `__satentry` chain — alive under dead-strip (native retains via this reloc;
// LLVM additionally pins it in `@llvm.used` via codegen.emitSatFragPin, gated on
// m.SatRegistryRequested).  Sole caller is EmitBnInit, which places it in
// `bn_init` ahead of the package inits that may use the registry, and sets
// m.SatRegistryRequested.  Compiled (native + LLVM) path only — the interp never
// emits bn_init (it builds its registry host-side).
func emitBuildSatRegistryCall(blk @ir.Block, m @ir.Module) {
	var rootAddr @ir.Instr = EmitDataSymAddr(blk, mangle.GlobalName(m.PkgPath, "__pkg_satfrag"),
			types.TypUint8())
	EmitCall(blk, "pkg/builtins/rt.BuildSatRegistry", ir.MakeArgs1(rootAddr), types.TypVoid())
}
