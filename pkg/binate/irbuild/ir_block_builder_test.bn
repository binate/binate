package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// TestBlockInstrsGrowthPreservesOrder pins the amortized-growth builder behind
// Block.Instrs: addInstr Pushes onto InstrsVec and refreshes
// Instrs = InstrsVec.Items() (an O(1) sub-slice sharing the builder's backing).
// Appending enough instructions to cross several vec-growth reallocations (the
// 4->8->16->32 doublings) must leave Instrs a correct, in-order view of every
// appended instruction, with len(Instrs) the live count after EVERY append (not
// just at the end).  A stale view, or a growth realloc that dropped or reordered
// elements, would surface here.
func TestBlockInstrsGrowthPreservesOrder() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var n int = 20
	var got @[]@ir.Instr = make_slice(@ir.Instr, n)
	for i := 0; i < n; i++ {
		got[i] = EmitConstInt(b, i, types.TypInt())
		if len(b.Instrs) != i + 1 {
			return fail("len(Instrs) not current after append")
		}
	}
	if len(b.Instrs) != n { return fail("final len(Instrs) wrong") }
	for i := 0; i < n; i++ {
		// Identity: the view holds the SAME @Instr objects, in insertion order,
		// across all the growth reallocations.
		if b.Instrs[i] != got[i] {
			return fail("Instrs order/identity changed by growth")
		}
		if b.Instrs[i].IntVal != cast(int64, i) {
			return fail("Instrs content changed by growth")
		}
	}
	return ""
}

// TestModuleFuncsGrowthPreservesOrder pins the same amortized-growth builder
// behind Module.Funcs: AddFunc Pushes onto FuncsVec and refreshes
// Funcs = FuncsVec.Items().  Adding enough functions to cross several vec-growth
// reallocations must leave Funcs a correct, in-order view of every added
// function, with len(Funcs) the live count after every AddFunc.
func TestModuleFuncsGrowthPreservesOrder() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	if len(m.Funcs) != 0 { return fail("fresh module should have no funcs") }
	var n int = 20
	var got @[]@ir.Func = make_slice(@ir.Func, n)
	for i := 0; i < n; i++ {
		var f @ir.Func = ir.NewFunc("", "fn", noParams, noResults)
		got[i] = f
		m.AddFunc(f)
		if len(m.Funcs) != i + 1 {
			return fail("len(Funcs) not current after AddFunc")
		}
	}
	for i := 0; i < n; i++ {
		if m.Funcs[i] != got[i] {
			return fail("Funcs order/identity changed by growth")
		}
	}
	return ""
}
