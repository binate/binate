package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Managed pointer tests
// ============================================================

func TestEmitMake() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var instr @ir.Instr = EmitMake(b, types.TypInt())
	if instr.Op != iropcode.OP_MAKE { return fail("op wrong") }
	return ""
}

func TestEmitBox() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var val @ir.Instr = EmitConstInt(b, 42, types.TypInt())
	var ptrTyp @types.Type = types.MakeManagedPtrType(types.TypInt())
	var boxed @ir.Instr = EmitBox(b, val, ptrTyp)
	if boxed.Op != iropcode.OP_BOX { return fail("op wrong") }
	if len(boxed.Args) != 1 { return fail("expected 1 arg") }
	return ""
}

func TestEmitMakeSlice() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var length @ir.Instr = EmitConstInt(b, 5, types.TypInt())
	var ms @ir.Instr = EmitMakeSlice(b, types.TypInt(), length)
	if ms.Op != iropcode.OP_MAKE_SLICE { return fail("op wrong") }
	if len(ms.Args) != 1 { return fail("expected 1 arg (length)") }
	if ms.TypeArg == nil { return fail("TypeArg should not be nil") }
	if ms.Typ == nil { return fail("Typ should not be nil") }
	if ms.Typ.Kind != types.TYP_MANAGED_SLICE { return fail("result type should be managed-slice") }
	return ""
}

func TestEmitDeref() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ptr @ir.Instr = EmitAlloc(b, types.TypInt())
	var derefed @ir.Instr = EmitDeref(b, ptr, types.TypInt())
	if derefed.Op != iropcode.OP_DEREF { return fail("op wrong") }
	if len(derefed.Args) != 1 { return fail("expected 1 arg") }
	return ""
}

func TestEmitNilCheck() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var ptr @ir.Instr = EmitConstNil(b, ptrTyp)
	EmitNilCheck(b, ptr)
	// NilCheck is void, so ID should be -1
	var nc @ir.Instr = b.Instrs[1]
	if nc.Op != iropcode.OP_NIL_CHECK { return fail("op wrong") }
	if nc.ID != -1 { return fail("nil_check should be void") }
	if len(nc.Args) != 1 { return fail("expected 1 arg") }
	return ""
}
