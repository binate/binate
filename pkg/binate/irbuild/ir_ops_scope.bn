package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// NewScope issues the next scope id of f (f.NumScopes after it is counted): ids
// number the scopes an OP_ALLOC's and an OP_SCOPE_END's Scope name.
func NewScope(f @ir.Func) int {
	f.NumScopes = f.NumScopes + 1
	return f.NumScopes
}

// EmitScopeEnd appends an OP_SCOPE_END for scope (an id from NewScope): control
// leaves that scope here, ending the storage of the allocas it numbers.
func EmitScopeEnd(b @ir.Block, scope int) {
	var instr @ir.Instr = NewVoidInstr(iropcode.OP_SCOPE_END)
	instr.Scope = scope
	addInstr(b, instr)
}
