package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// NewScope numbers a function's scopes from 1 and counts them in NumScopes;
// EmitScopeEnd appends a void, operand-free OP_SCOPE_END naming its scope.
func TestNewScopeAndEmitScopeEnd() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	if f.NumScopes != 0 { return fail("a new function has no scopes") }
	var s1 int = NewScope(f)
	var s2 int = NewScope(f)
	if s1 != 1 || s2 != 2 || f.NumScopes != 2 {
		return fail("scopes are numbered 1, 2, ... and counted")
	}
	EmitScopeEnd(entry, s2)
	if len(entry.Instrs) != 1 { return fail("EmitScopeEnd appends one instruction") }
	var e @ir.Instr = entry.Instrs[0]
	if e.Op != iropcode.OP_SCOPE_END || e.Scope != s2 { return fail("the scope end names its scope") }
	if e.ID != -1 || len(e.Args) != 0 {
		return fail("a scope end makes no value and takes no operands")
	}
	return ""
}

// A scope end writes nothing, so it keeps a block's nil-checked slots, as a load
// does; a store does not.
func TestNilDedupKeepsSlotsAcrossScopeEnd() testing.TestResult {
	if !nilDedupPreservingOp(iropcode.OP_SCOPE_END) { return fail("a scope end keeps the set") }
	if nilDedupPreservingOp(iropcode.OP_STORE) { return fail("a store clears the set") }
	return ""
}
