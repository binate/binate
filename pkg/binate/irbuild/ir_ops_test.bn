package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Control flow tests
// ============================================================

func TestEmitJump() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b1 @ir.Block = ir.AddBlock(f, "entry")
	var b2 @ir.Block = ir.AddBlock(f, "next")
	EmitJump(b1, b2)
	if len(b1.Instrs) != 1 { return fail("expected 1 instr") }
	if b1.Instrs[0].Op != iropcode.OP_JUMP { return fail("op wrong") }
	return ""
}

func TestEmitBranch() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenBlk @ir.Block = ir.AddBlock(f, "then")
	var elseBlk @ir.Block = ir.AddBlock(f, "else")
	var cond @ir.Instr = EmitConstBool(entry, true)
	EmitBranch(entry, cond, thenBlk, elseBlk)
	var br @ir.Instr = entry.Instrs[1]
	if br.Op != iropcode.OP_BRANCH { return fail("op wrong") }
	if len(br.Args) != 1 { return fail("expected 1 arg (cond)") }
	return ""
}

func TestEmitReturn() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var val @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = val
	EmitReturn(b, retArgs)
	if b.Instrs[1].Op != iropcode.OP_RETURN { return fail("op wrong") }
	return ""
}

func TestEmitReturnVoid() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitReturn(b, noArgs)
	if b.Instrs[0].Op != iropcode.OP_RETURN { return fail("op wrong") }
	if len(b.Instrs[0].Args) != 0 { return fail("void return should have no args") }
	return ""
}

// ============================================================
// Call tests
// ============================================================

func TestEmitCall() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var arg @ir.Instr = EmitConstInt(b, 1, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	var result @ir.Instr = EmitCall(b, "add", callArgs, types.TypInt())
	if result.Op != iropcode.OP_CALL { return fail("op wrong") }
	if len(result.Args) != 1 { return fail("expected 1 arg") }
	return ""
}

func TestEmitCallIndirect() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = EmitConstNil(b, rawPtrTyp)
	var arg @ir.Instr = EmitConstInt(b, 42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	var result @ir.Instr = EmitCallIndirect(b, fnPtr, callArgs, types.TypInt())
	if result.Op != iropcode.OP_CALL_INDIRECT { return fail("op wrong") }
	if len(result.Args) != 2 { return fail("expected 2 args (fnPtr + 1 call arg)") }
	if result.Args[0].ID != fnPtr.ID { return fail("Args[0] should be fnPtr") }
	if result.Args[1].ID != arg.ID { return fail("Args[1] should be call arg") }
	return ""
}

func TestEmitCallIndirectVoid() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = EmitConstNil(b, rawPtrTyp)
	var result @ir.Instr = EmitCallIndirect(b, fnPtr, noArgs, types.TypVoid())
	if result.Op != iropcode.OP_CALL_INDIRECT { return fail("op wrong") }
	if len(result.Args) != 1 { return fail("expected just fnPtr arg") }
	if result.Typ == nil || result.Typ.Kind != types.TYP_VOID {
		return fail("expected void return type")
	}
	return ""
}

// ============================================================
// Helper tests
// ============================================================

// EmitSPRestore appends a void OP_SP_RESTORE instruction to the
// block. No operands, no result type — backends interpret it as a
// statement-end marker (VM resets vm.SP back to frame end; LLVM and
// native are no-ops). Bytecode-VM-side coverage lives with the
// lowering and execLoop arm in pkg/binate/vm.
func TestEmitSPRestore() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitSPRestore(b)
	if len(b.Instrs) != 1 { return fail("expected 1 instr in block") }
	var instr @ir.Instr = b.Instrs[0]
	if instr.Op != iropcode.OP_SP_RESTORE { return fail("op should be iropcode.OP_SP_RESTORE") }
	if instr.ID != -1 { return fail("iropcode.OP_SP_RESTORE should be void (ID == -1)") }
	if len(instr.Args) != 0 { return fail("iropcode.OP_SP_RESTORE should have no args") }
	if instr.IsTerminator() { return fail("iropcode.OP_SP_RESTORE should NOT be a terminator") }
	return ""
}

func TestIsTerminator() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var val @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	if val.IsTerminator() { return fail("const should not be terminator") }
	EmitReturn(b, noArgs)
	if !b.Instrs[1].IsTerminator() { return fail("return should be terminator") }
	return ""
}

// ============================================================
// Slice tests
// ============================================================

func TestEmitSliceOps() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = EmitConstNil(b, sliceTyp)
	var slen @ir.Instr = EmitSliceLen(b, s)
	if slen.Op != iropcode.OP_EXTRACT { return fail("len should lower to extract") }
	var idx @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	var elem @ir.Instr = EmitSliceGet(b, s, idx, types.TypInt())
	// EmitSliceGet now lowers to extract + GEP + load
	if elem.Op != iropcode.OP_LOAD { return fail("get should lower to load") }
	return ""
}

func TestEmitSliceSet() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = EmitConstNil(b, sliceTyp)
	var idx @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	var val @ir.Instr = EmitConstInt(b, 42, types.TypInt())
	EmitSliceSet(b, s, idx, val, types.TypInt())
	// Should lower to: extract(0) + get_elem_ptr + store
	var extract @ir.Instr = b.Instrs[3]
	if extract.Op != iropcode.OP_EXTRACT { return fail("expected extract for data ptr") }
	var gep @ir.Instr = b.Instrs[4]
	if gep.Op != iropcode.OP_GET_ELEM_PTR { return fail("expected GEP") }
	var store @ir.Instr = b.Instrs[5]
	if store.Op != iropcode.OP_STORE { return fail("expected store") }
	return ""
}

func TestEmitSliceExpr() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = EmitConstNil(b, sliceTyp)
	var lo @ir.Instr = EmitConstInt(b, 1, types.TypInt())
	var hi @ir.Instr = EmitConstInt(b, 5, types.TypInt())
	var se @ir.Instr = EmitSliceExpr(b, s, lo, hi, sliceTyp)
	// EmitSliceExpr now lowers to extract + GEP + sub + alloca + stores + load
	if se.Op != iropcode.OP_LOAD { return fail("slice_expr should lower to load") }
	return ""
}

func TestEmitBoundsCheck() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var idx @ir.Instr = EmitConstInt(b, 3, types.TypInt())
	var length @ir.Instr = EmitConstInt(b, 10, types.TypInt())
	EmitBoundsCheck(b, idx, length)
	var bc @ir.Instr = b.Instrs[2]
	if bc.Op != iropcode.OP_BOUNDS_CHECK { return fail("op wrong") }
	if bc.ID != -1 { return fail("bounds_check should be void") }
	if len(bc.Args) != 2 { return fail("expected 2 args") }
	return ""
}

func TestEmitSliceElemPtr() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = EmitConstNil(b, sliceTyp)
	var idx @ir.Instr = EmitConstInt(b, 0, types.TypInt())
	var ep @ir.Instr = EmitSliceElemPtr(b, s, idx, types.TypInt())
	// EmitSliceElemPtr now lowers to extract + GEP
	if ep.Op != iropcode.OP_GET_ELEM_PTR { return fail("should lower to GEP") }
	return ""
}

// ============================================================
// String conversion tests
// ============================================================

// Phase 3.3: EmitStringToArray was deleted; OP_RODATA_ARRAY is the
// op for string→[N]char and is constructed via EmitRodataArray.
func TestEmitRodataArray() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var arrayTyp @types.Type = types.MakeArrayType(types.TypChar(), 5)
	var ra @ir.Instr = EmitRodataArray(b, "hello", arrayTyp)
	if ra.Op != iropcode.OP_RODATA_ARRAY { return fail("op wrong") }
	if len(ra.StrVal) != 5 { return fail("expected 5 bytes on StrVal") }
	return ""
}

// ============================================================
// Conversion tests
// ============================================================

func TestEmitCast() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var val @ir.Instr = EmitConstInt(b, 65, types.TypInt())
	var casted @ir.Instr = EmitCast(b, val, types.TypUint8())
	if casted.Op != iropcode.OP_CAST { return fail("op wrong") }
	return ""
}

func TestEmitBitCast() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var val @ir.Instr = EmitConstInt(b, 42, types.TypInt())
	var bc @ir.Instr = EmitBitCast(b, val, types.TypUint64())
	if bc.Op != iropcode.OP_BIT_CAST { return fail("op wrong") }
	if len(bc.Args) != 1 { return fail("expected 1 arg") }
	if bc.TypeArg == nil { return fail("TypeArg should not be nil") }
	return ""
}

// ============================================================
// Struct tests
// ============================================================

func TestEmitStructLit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var structTyp @types.Type = types.TypInt() // placeholder
	var f1 @ir.Instr = EmitConstInt(b, 10, types.TypInt())
	var f2 @ir.Instr = EmitConstInt(b, 20, types.TypInt())
	var fields @[]@ir.Instr = make_slice(@ir.Instr, 2)
	fields[0] = f1
	fields[1] = f2
	var lit @ir.Instr = EmitStructLit(b, fields, structTyp)
	if lit.Op != iropcode.OP_STRUCT_LIT { return fail("op wrong") }
	if len(lit.Args) != 2 { return fail("expected 2 fields") }
	return ""
}

func TestEmitExtract() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var multi @ir.Instr = EmitCall(b, "multi_ret", noArgs, types.TypInt())
	var extracted @ir.Instr = EmitExtract(b, multi, 0, types.TypInt())
	if extracted.Op != iropcode.OP_EXTRACT { return fail("op wrong") }
	if extracted.Index != 0 { return fail("index wrong") }
	return ""
}

// ============================================================
// SSA / Phi tests
// ============================================================

func TestEmitPhi() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b1 @ir.Block = ir.AddBlock(f, "left")
	var b2 @ir.Block = ir.AddBlock(f, "right")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var val1 @ir.Instr = EmitConstInt(b1, 1, types.TypInt())
	var val2 @ir.Instr = EmitConstInt(b2, 2, types.TypInt())
	var pe1 ir.PhiEntry
	pe1.Block = b1
	pe1.Val = val1
	var pe2 ir.PhiEntry
	pe2.Block = b2
	pe2.Val = val2
	var phiEntries @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	phiEntries[0] = pe1
	phiEntries[1] = pe2
	var phi @ir.Instr = EmitPhi(merge, types.TypInt(), phiEntries)
	if phi.Op != iropcode.OP_PHI { return fail("op wrong") }
	if len(phi.Phis) != 2 { return fail("expected 2 phi entries") }
	return ""
}

// ============================================================
// Unreachable tests
// ============================================================

func TestEmitUnreachable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitUnreachable(b)
	var u @ir.Instr = b.Instrs[0]
	if u.Op != iropcode.OP_UNREACHABLE { return fail("op wrong") }
	if u.ID != -1 { return fail("unreachable should be void") }
	if !u.IsTerminator() { return fail("unreachable should be terminator") }
	return ""
}
