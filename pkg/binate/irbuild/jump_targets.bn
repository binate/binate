package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/cmp"
import "pkg/std/table"

// ForeignJumpError — see irbuild.bni.
func ForeignJumpError(f @ir.Func) @[]char {
	// f.Blocks' addresses, gathered at the first jump or branch.
	var own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]]
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op != iropcode.OP_JUMP && ins.Op != iropcode.OP_BRANCH { continue }
			if own == nil { own = blockAddrs(f) }
			var kind *[]readonly char = "a jump"
			var fault @[]char
			if ins.Op == iropcode.OP_JUMP {
				fault = targetFault(f, own, ins.Block1, "target")
			} else {
				kind = "a branch"
				fault = targetFault(f, own, ins.Block1, "then-block")
				if len(fault) == 0 { fault = targetFault(f, own, ins.Block2, "else-block") }
			}
			if len(fault) > 0 { return faultIn(kind, f, b, fault) }
		}
	}
	return ""
}

// ForeignPhiPredError — see irbuild.bni.
func ForeignPhiPredError(f @ir.Func) @[]char {
	// f.Blocks' addresses, gathered at the first phi entry.
	var own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]]
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			// A phi's entries (Phis is empty on every other instruction).
			var es @[]ir.PhiEntry = b.Instrs[ii].Phis
			for k := 0; k < len(es); k++ {
				if own == nil { own = blockAddrs(f) }
				var fault @[]char = targetFault(f, own, es[k].Block, "predecessor")
				if len(fault) > 0 { return faultIn("a phi", f, b, fault) }
			}
		}
	}
	return ""
}

// blockAddrs returns the set of the addresses of f.Blocks.
func blockAddrs(f @ir.Func) @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]] {
	var own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, bool,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	for bi := 0; bi < len(f.Blocks); bi++ {
		own.Put(bit_cast(int, f.Blocks[bi]), true)
	}
	return own
}

// faultIn describes fault (a targetFault) of an instruction of kind ("a jump", "a
// branch", "a phi") in block b of f.
func faultIn(kind *[]readonly char, f @ir.Func, b @ir.Block, fault *[]readonly char) @[]char {
	var where @[]char = buf.Concat(buf.Concat(kind, " in "), f.Name)
	where = buf.Concat(buf.Concat(where, " (block "), b.Label)
	return buf.Concat(buf.Concat(where, ") has "), fault)
}

// targetFault returns how target, the role block of a jump, branch or phi in f, is not
// one of f.Blocks, whose addresses own holds -- "no <role>" when it is nil, "its <role>
// <label> outside the function (a block of <function>)" when it is another function's,
// "its <role> <label> outside the function's blocks (a fault pad)" when it is one of f's
// fault pads, "its <role> <label> outside the function's blocks (a block dropped from
// them)" when it is a block of f a pass dropped from f.Blocks -- or "" when it is one of
// f.Blocks.
func targetFault(f @ir.Func, own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]],
		target *ir.Block, role *[]readonly char) @[]char {
	if target == nil { return buf.Concat("no ", role) }
	var why @[]char
	if target.Func != f {
		// A block that neither ir.AddBlock nor ir.AddFaultPad made (a hand-built one)
		// has no Func.
		var owner @[]char = "no function"
		if target.Func != nil { owner = target.Func.Name }
		why = buf.Concat(buf.Concat(" outside the function (a block of ", owner), ")")
	} else if target.IsFaultPad {
		why = " outside the function's blocks (a fault pad)"
	} else if !own.Has(bit_cast(int, target)) {
		why = " outside the function's blocks (a block dropped from them)"
	} else {
		return ""
	}
	var its @[]char = buf.Concat(buf.Concat("its ", role), " ")
	return buf.Concat(buf.Concat(its, target.Label), why)
}
