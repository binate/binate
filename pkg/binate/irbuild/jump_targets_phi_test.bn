package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ForeignPhiPredError: the first phi entry whose predecessor is not one of the
// function's blocks, described by the function, the phi's block and the predecessor.

// phiFunc returns a function named name, `entry: branch left, right; left: jump merge;
// right: jump merge; merge: p = phi [1, left], [2, right]; q = phi [3, left], [4, right];
// return p`, added to m (which keeps it alive while another function's phi names its
// blocks, as a module does in a compile), its four blocks and its two phis.
func phiFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block, @[]@ir.Instr) {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, noParams, results)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "left")
	bs[2] = ir.AddBlock(f, "right")
	bs[3] = ir.AddBlock(f, "merge")
	EmitBranch(bs[0], EmitConstBool(bs[0], true), bs[1], bs[2])
	var phis @[]@ir.Instr = make_slice(@ir.Instr, 2)
	for k := 0; k < 2; k++ {
		var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
		es[0].Block = bs[1]
		es[0].Val = EmitConstInt(bs[1], 2 * k + 1, types.TypInt())
		es[1].Block = bs[2]
		es[1].Val = EmitConstInt(bs[2], 2 * k + 2, types.TypInt())
		phis[k] = EmitPhi(bs[3], types.TypInt(), es)
	}
	EmitJump(bs[1], bs[3])
	EmitJump(bs[2], bs[3])
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = phis[0]
	EmitReturn(bs[3], rets)
	m.AddFunc(f)
	return f, bs, phis
}

// phiErrorIs fails unless ForeignPhiPredError(f) is want, prefixing the failure with
// what.
func phiErrorIs(f @ir.Func, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var got @[]char = ForeignPhiPredError(f)
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// A function whose phis' predecessors are all its own blocks has no error.
func TestForeignPhiPredErrorNoneForOwnBlocks() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var g @ir.Func
	f, _, _ = phiFunc(m, "main.f")
	g, _, _ = phiFunc(m, "main.g")
	var r testing.TestResult = phiErrorIs(f, "", "f's own predecessors")
	if len(r) > 0 { return r }
	return phiErrorIs(g, "", "g's own predecessors")
}

// A predecessor that is another function's block is reported, naming the block and its
// function, even when the function has a block of the same label, which a label-named
// predecessor would silently reach instead.
func TestForeignPhiPredErrorOtherFunctionsBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fp @[]@ir.Instr
	f, fb, fp = phiFunc(m, "main.f")
	var gb @[]@ir.Block
	_, gb, _ = phiFunc(m, "main.g")
	if !seq(gb[1].Label, "left.1") || !seq(fb[1].Label, "left.1") { return "both have a left.1" }
	fp[0].Phis[0].Block = gb[1]
	return phiErrorIs(f,
			"a phi in main.f (block merge.3) has its predecessor left.1 outside the function (a "
					"block of main.g)",
			"a predecessor in g")
}

// A phi entry with no predecessor is reported.
func TestForeignPhiPredErrorNilPredecessor() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fp @[]@ir.Instr
	f, _, fp = phiFunc(m, "main.f")
	var none *ir.Block
	fp[0].Phis[1].Block = none
	return phiErrorIs(f, "a phi in main.f (block merge.3) has no predecessor", "a nil predecessor")
}

// A predecessor that is one of the function's fault pads is reported -- here a pad
// whose label a block of the function also has (pads are numbered apart from blocks).
func TestForeignPhiPredErrorFaultPad() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fp @[]@ir.Instr
	f, fb, fp = phiFunc(m, "main.f")
	var pad @ir.Block = ir.AddFaultPad(f, "entry")
	EmitUnwindReturn(pad)
	if !seq(pad.Label, fb[0].Label) { return "the pad and the entry block are both entry.0" }
	fp[1].Phis[0].Block = pad
	return phiErrorIs(f,
			"a phi in main.f (block merge.3) has its predecessor entry.0 outside the function's "
					"blocks (a fault pad)",
			"a fault-pad predecessor")
}

// Of several faults, the first entry of the first phi in f.Blocks' order is the one
// reported.
func TestForeignPhiPredErrorReportsTheFirst() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fp @[]@ir.Instr
	f, _, fp = phiFunc(m, "main.f")
	var gb @[]@ir.Block
	_, gb, _ = phiFunc(m, "main.g")
	var none *ir.Block
	fp[1].Phis[0].Block = gb[1]
	fp[0].Phis[1].Block = gb[2]
	fp[1].Phis[1].Block = none
	return phiErrorIs(f,
			"a phi in main.f (block merge.3) has its predecessor right.2 outside the function (a "
					"block of main.g)",
			"the first phi's second entry comes first")
}
