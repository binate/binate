package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for ForeignJumpError: the first jump or branch whose target is not one of the
// function's blocks, described by the function, its block and the target.

// jumpFunc returns a function named name, `entry: jump body; body: branch then, other;
// then: return; other: return`, added to m (which keeps it alive while another
// function's jump names its blocks, as a module does in a compile), and its four blocks.
func jumpFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block) {
	var f @ir.Func = ir.NewFunc("", name, noParams, noResults)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "body")
	bs[2] = ir.AddBlock(f, "then")
	bs[3] = ir.AddBlock(f, "other")
	EmitJump(bs[0], bs[1])
	EmitBranch(bs[1], EmitConstBool(bs[1], true), bs[2], bs[3])
	EmitReturn(bs[2], noArgs)
	EmitReturn(bs[3], noArgs)
	m.AddFunc(f)
	return f, bs
}

// termOf returns b's last instruction (its terminator).
func termOf(b @ir.Block) @ir.Instr {
	return b.Instrs[len(b.Instrs) - 1]
}

// errorIs fails unless ForeignJumpError(f) is want, prefixing the failure with what.
func errorIs(f @ir.Func, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var got @[]char = ForeignJumpError(f)
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// A function whose jumps and branches all target its own blocks has no error.
func TestForeignJumpErrorNoneForOwnBlocks() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	f, _ = jumpFunc(m, "main.f")
	_, _ = jumpFunc(m, "main.g")
	return errorIs(f, "", "own targets")
}

// A jump to another function's block is reported, naming the block and its function,
// even when the function has a block of the same label, which a label-named target
// would silently reach instead.
func TestForeignJumpErrorOtherFunctionsBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var gb @[]@ir.Block
	_, gb = jumpFunc(m, "main.g")
	if !seq(gb[1].Label, "body.1") || !seq(fb[1].Label, "body.1") { return "both have a body.1" }
	termOf(fb[0]).Block1 = gb[1]
	return errorIs(f,
			"a jump in main.f (block entry.0) has its target body.1 outside the function (a block of "
					"main.g)",
			"a jump to g's block")
}

// A jump with no target is reported.
func TestForeignJumpErrorNilJumpTarget() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var none *ir.Block
	termOf(fb[0]).Block1 = none
	return errorIs(f, "a jump in main.f (block entry.0) has no target", "a nil jump target")
}

// A branch is reported for either target: a foreign or missing then-block, and a
// foreign or missing else-block.
func TestForeignJumpErrorBranchTargets() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var gb @[]@ir.Block
	_, gb = jumpFunc(m, "main.g")
	var br @ir.Instr = termOf(fb[1])
	var none *ir.Block
	br.Block1 = gb[2]
	var r testing.TestResult = errorIs(f,
			"a branch in main.f (block body.1) has its then-block then.2 outside the function (a "
					"block of main.g)",
			"a foreign then-block")
	if len(r) > 0 { return r }
	br.Block1 = none
	r = errorIs(f, "a branch in main.f (block body.1) has no then-block", "a nil then-block")
	if len(r) > 0 { return r }
	br.Block1 = fb[2]
	br.Block2 = gb[3]
	r = errorIs(f,
			"a branch in main.f (block body.1) has its else-block other.3 outside the function (a "
					"block of main.g)",
			"a foreign else-block")
	if len(r) > 0 { return r }
	br.Block2 = none
	return errorIs(f, "a branch in main.f (block body.1) has no else-block", "a nil else-block")
}

// Of several faults, the first in f.Blocks' order is the one reported.
func TestForeignJumpErrorReportsTheFirst() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var gb @[]@ir.Block
	_, gb = jumpFunc(m, "main.g")
	var none *ir.Block
	termOf(fb[1]).Block2 = none
	termOf(fb[0]).Block1 = gb[1]
	return errorIs(f,
			"a jump in main.f (block entry.0) has its target body.1 outside the function (a block of "
					"main.g)",
			"the entry block's jump comes first")
}

// A jump to one of the function's fault pads is reported -- here a pad whose label a
// block of the function also has (pads are numbered apart from blocks), which a
// label-named target would silently reach instead -- whether the pad was made by
// AddFaultPad or by AddBlock under PadEmitMode.
func TestForeignJumpErrorFaultPad() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var direct @ir.Block = ir.AddFaultPad(f, "pad")
	EmitUnwindReturn(direct)
	f.PadEmitMode = true
	var routed @ir.Block = ir.AddBlock(f, "body")
	f.PadEmitMode = false
	EmitUnwindReturn(routed)
	if !seq(routed.Label, "body.1") || len(f.FaultPads) != 2 { return "the second pad is body.1" }
	termOf(fb[0]).Block1 = direct
	var r testing.TestResult = errorIs(f,
			"a jump in main.f (block entry.0) has its target pad.0 outside the function's blocks (a "
					"fault pad)",
			"a jump to an AddFaultPad pad")
	if len(r) > 0 { return r }
	termOf(fb[0]).Block1 = fb[1]
	termOf(fb[1]).Block2 = routed
	return errorIs(f,
			"a branch in main.f (block body.1) has its else-block body.1 outside the function's "
					"blocks (a fault pad)",
			"a branch to a PadEmitMode pad")
}

// A target that no AddBlock or AddFaultPad made (its Func is nil) is another
// function's as far as the check goes.
func TestForeignJumpErrorHandBuiltTarget() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var hand @ir.Block = make(ir.Block)
	hand.Label = "body.1"
	termOf(fb[0]).Block1 = hand
	return errorIs(f,
			"a jump in main.f (block entry.0) has its target body.1 outside the function (a block of "
					"no function)",
			"a jump to a hand-built block")
}

// A block a pass dropped from f.Blocks is still f's (its Func is f and it is no pad), so
// it is not reported: no backend defines its label, so the jump fails as an undefined
// label instead.
func TestForeignJumpErrorDroppedBlockNotSeen() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpFunc(m, "main.f")
	var kept @[]@ir.Block = make_slice(@ir.Block, 3)
	kept[0] = fb[0]
	kept[1] = fb[2]
	kept[2] = fb[3]
	f.Blocks = kept
	return errorIs(f, "", "a jump to a block dropped from f.Blocks")
}
