package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for NarrowToInt and its use by EmitGetElemPtr / EmitSliceExpr: an index or
// slice bound wider than int reaches the element address as an int.

// withIntSize stamps a target whose int (and pointer) is size bytes and returns
// the prior target for the caller to restore.
func withIntSize(size int) types.TargetInfo {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = size
	t.IntSize = size
	t.MaxAlign = 8
	types.SetTarget(t)
	return old
}

// On a 32-bit target an int64 GEP index is narrowed: the GEP reads an OP_CAST of
// it to int, appended just before the GEP.
func TestEmitGetElemPtrNarrowsWideIndexOn32Bit() testing.TestResult {
	var old types.TargetInfo = withIntSize(4)
	defer types.SetTarget(old)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = EmitAlloc(b, types.MakeArrayType(types.TypInt(), 3))
	var idx @ir.Instr = EmitConstInt64(b, 2, types.TypInt64())
	var gep @ir.Instr = EmitGetElemPtr(b, base, idx, types.TypInt())
	var narrowed @ir.Instr = gep.Args[1]
	if narrowed == idx || narrowed.Op != iropcode.OP_CAST || narrowed.Args[0] != idx {
		return fail("32-bit target: the GEP should read the int64 index through a cast")
	}
	if types.StripWrappers(narrowed.Typ) != types.TypInt() {
		return fail("32-bit target: the narrowed index should be an int")
	}
	return ""
}

// An int index — and, on a 64-bit target, an int64 one — is used as it is.
func TestEmitGetElemPtrKeepsWordIndex() testing.TestResult {
	var old types.TargetInfo = withIntSize(4)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = EmitAlloc(b, types.MakeArrayType(types.TypInt(), 3))
	var idx @ir.Instr = EmitConstInt(b, 2, types.TypInt())
	var gep32 @ir.Instr = EmitGetElemPtr(b, base, idx, types.TypInt())
	types.SetTarget(old)
	if gep32.Args[1] != idx {
		return fail("32-bit target: an int index needs no cast")
	}
	old = withIntSize(8)
	defer types.SetTarget(old)
	var idx64 @ir.Instr = EmitConstInt64(b, 2, types.TypInt64())
	var gep64 @ir.Instr = EmitGetElemPtr(b, base, idx64, types.TypInt())
	if gep64.Args[1] != idx64 {
		return fail("64-bit target: an int64 index is a word and needs no cast")
	}
	return ""
}

// On a 32-bit target EmitSliceExpr narrows int64 lo and hi bounds: the view's
// int arithmetic reads OP_CASTs of them, never the 64-bit values.
func TestEmitSliceExprNarrowsWideBoundsOn32Bit() testing.TestResult {
	var old types.TargetInfo = withIntSize(4)
	defer types.SetTarget(old)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = EmitLoad(b, EmitAlloc(b, sliceTyp), sliceTyp)
	var lo @ir.Instr = EmitConstInt64(b, 1, types.TypInt64())
	var hi @ir.Instr = EmitConstInt64(b, 2, types.TypInt64())
	EmitSliceExpr(b, s, lo, hi, sliceTyp)
	var loCast bool = false
	var hiCast bool = false
	for i := 0; i < len(b.Instrs); i++ {
		var ins @ir.Instr = b.Instrs[i]
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != lo && ins.Args[k] != hi { continue }
			if ins.Op != iropcode.OP_CAST {
				return fail("32-bit target: a wide slice bound may reach the view only through a cast")
			}
			if ins.Args[k] == lo { loCast = true } else { hiCast = true }
		}
	}
	if !loCast || !hiCast {
		return fail("32-bit target: both wide slice bounds should be narrowed")
	}
	return ""
}
