package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/cmp"
import "pkg/std/containers/table"
import "pkg/std/strconv"

// The operand check runs on every function a backend lowers, so its walk over the
// instructions borrows: the helpers take raw pointers and slices, and the loops hold each
// block and instruction in a raw local, so nothing is retained or released per block,
// instruction or operand.  What they point at stays alive for the whole check, which
// changes nothing: f and mv are held by ForeignOperandError's caller, f's blocks by
// f.Blocks and f.FaultPads (and f.AddedBlocks), each block's instructions by its Instrs,
// and the parameter refs by the managed-slice ForeignOperandError keeps of them.

// ModuleValues — see irbuild.bni.
type ModuleValues struct {
	// mod is the module whose global-address pseudos an operand may be, and whose functions
	// an error names as a foreign operand's owner.
	mod @ir.Module
	// globals holds the addresses of mod's global-address pseudos, gathered the first time
	// an operand is one (moduleHolds); nil until then.
	globals @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]]
	// byID is the id-indexed array of the instructions of the function being checked
	// (fillByID), kept from one check to the next rather than allocated for each.  A check
	// clears and fills only the front of it, its function's id range, and looks only there:
	// an entry past that range is left from an earlier function -- a pointer to one of its
	// instructions -- and would otherwise pass that instruction for the function's own.
	byID @[]*ir.Instr
}

// NewModuleValues — see irbuild.bni.
func NewModuleValues(m @ir.Module) @ModuleValues {
	var mv @ModuleValues = make(ModuleValues)
	mv.mod = m
	return mv
}

// moduleHolds reports whether v, a global-address pseudo, is one of mv's module's,
// gathering their addresses on the first call.
func moduleHolds(mv *ModuleValues, v *ir.Instr) bool {
	if mv.globals == nil {
		mv.globals = table.NewTable[int, bool, ir.AddrHasher, cmp.Default[int]](ir.AddrHasher{},
				cmp.Default[int]{})
		if mv.mod.GlobalRefs != nil {
			addInstrs(mv.globals, mv.mod.GlobalRefs.Items())
		}
	}
	return mv.globals.Has(bit_cast(int, v))
}

// ForeignOperandError — see irbuild.bni.
func ForeignOperandError(f @ir.Func, mv @ModuleValues) @[]char {
	if f.PhisEliminated {
		var why *[]readonly char = " has had its phis eliminated, after which its operands cannot "
				"be checked (they may read phis no block holds)"
		return buf.Concat(f.Name, why)
	}
	var n int = fillByID(f, mv)
	// f's parameter refs, fetched the first time an operand not found by its id is a
	// parameter ref under the id of one of f.Params (otherOwnValue; Items makes a
	// managed-slice), and held here while the check reads them.
	var refs @[]@ir.Instr
	// The walk looks an operand up only in mv.byID's front n entries, f's id range: past it
	// it would find an earlier function's instruction.
	var at operandAt = foreignOperandIn(f, f.Blocks, mv.byID, n, &refs, mv)
	if at.bi < len(f.Blocks) { return operandFault(f, f.Blocks, "block", at, mv) }
	at = foreignOperandIn(f, f.FaultPads, mv.byID, n, &refs, mv)
	if at.bi < len(f.FaultPads) { return operandFault(f, f.FaultPads, "pad", at, mv) }
	// Every operand is f's own: the empty result, which allocates nothing.
	var none @[]char
	return none
}

// operandAt is a place in the walk over the operands of the instructions of a list of
// blocks (f's blocks, or its pads): operand k of the instruction at ii of the block at bi,
// where an instruction's operands are its arguments (ir.Instr.Args) and then its phi
// entries' values (ir.PhiEntry.Val), so k from len(Args) on is the value of its phi entry
// k - len(Args).  Past the last operand, bi is the list's length.
type operandAt struct {
	bi int
	ii int
	k  int
}

// foreignOperandIn returns the place of the first operand of an instruction of blocks, f's
// blocks or pads, that is not one of f's own values, or the place past the last operand
// when every one is f's own.  byID is mv.byID, its front n entries f's instructions by id
// (fillByID), and refs the managed-slice that holds f's parameter refs once fetched
// (otherOwnValue).  Each block's instructions are scanned for an operand not found by its
// id (scanInstrs), and a block with one is walked on from there (foreignOperandFrom).
func foreignOperandIn(f *ir.Func, blocks *[]@ir.Block, byID *[]*ir.Instr, n int, refs *@[]@ir.Instr,
		mv *ModuleValues) operandAt {
	var own *[]*ir.Instr = byID[0:n]
	for bi := 0; bi < len(blocks); bi++ {
		var b *ir.Block = blocks[bi]
		var ii int = scanInstrs(b.Instrs, own)
		if ii < len(b.Instrs) {
			var at operandAt = foreignOperandFrom(f, b.Instrs, ii, own, refs, mv)
			if at.ii < len(b.Instrs) {
				at.bi = bi
				return at
			}
		}
	}
	return placeAt(len(blocks), 0, 0)
}

// scanInstrs returns the index of the first instruction of instrs with an operand that is
// not found by its id in byID (foundByID), or len(instrs) when there is none.  Its loops
// start at 0 and hold only instrs, byID and their indexes, and it resolves no operand
// itself (its caller does, foreignOperandFrom), so a compiler can keep all it reads in
// registers and drop its index checks.
func scanInstrs(instrs *[]@ir.Instr, byID *[]*ir.Instr) int {
	for ii := 0; ii < len(instrs); ii++ {
		var ins *ir.Instr = instrs[ii]
		for k := 0; k < len(ins.Args); k++ {
			if !foundByID(ins.Args[k], byID) { return ii }
		}
		// A phi's operands are its entries' values (Phis is empty on every other
		// instruction).
		for p := 0; p < len(ins.Phis); p++ {
			if !foundByID(ins.Phis[p].Val, byID) { return ii }
		}
	}
	return len(instrs)
}

// foundByID reports whether v is nil (no operand) or the instruction byID holds at its id,
// compared by identity: the test that finds nearly every operand one of its function's own
// values.
func foundByID(v *ir.Instr, byID *[]*ir.Instr) bool {
	return v == nil || (v.ID >= 0 && v.ID < len(byID) && byID[v.ID] == v)
}

// foreignOperandFrom returns the place, its block unset, of the first operand of the
// instruction at ii of instrs, or of a later one, that is not one of f's own values -- not
// found by its id in byID, nor one otherOwnValue finds f's own -- or one with ii ==
// len(instrs) when every one is f's own.  The instruction at ii has an operand not found by
// its id (scanInstrs); after an instruction whose operands are all f's own, the scan
// resumes at the next.
func foreignOperandFrom(f *ir.Func, instrs *[]@ir.Instr, ii int, byID *[]*ir.Instr,
		refs *@[]@ir.Instr, mv *ModuleValues) operandAt {
	for ii < len(instrs) {
		var ins *ir.Instr = instrs[ii]
		for k := 0; k < len(ins.Args); k++ {
			var v *ir.Instr = ins.Args[k]
			if !foundByID(v, byID) && !otherOwnValue(f, refs, mv, v) { return placeAt(0, ii, k) }
		}
		for p := 0; p < len(ins.Phis); p++ {
			var v *ir.Instr = ins.Phis[p].Val
			if !foundByID(v, byID) && !otherOwnValue(f, refs, mv, v) {
				return placeAt(0, ii, len(ins.Args) + p)
			}
		}
		ii++
		ii = ii + scanInstrs(instrs[ii:], byID)
	}
	return placeAt(0, ii, 0)
}

// placeAt returns the place of operand k of the instruction at ii of the block at bi.
func placeAt(bi int, ii int, k int) operandAt {
	var at operandAt
	at.bi = bi
	at.ii = ii
	at.k = k
	return at
}

// operandIn returns the operand of an instruction of blocks at at.
func operandIn(blocks *[]@ir.Block, at operandAt) *ir.Instr {
	var b *ir.Block = blocks[at.bi]
	var ins *ir.Instr = b.Instrs[at.ii]
	if at.k < len(ins.Args) { return ins.Args[at.k] }
	return ins.Phis[at.k - len(ins.Args)].Val
}

// otherOwnValue reports whether v, an operand of an instruction of f that is not the
// instruction of f's blocks and pads with v's id, is one of f's own values all the same:
// one of mv's module's global-address pseudos, compared by address whatever its id (their
// ids are not f's), or one of f.ParamRefs' items under the id of one of f.Params (the
// backends read a parameter ref as the parameter of its id).  It fetches f's parameter
// refs into refs the first time it reads them (fetchParamRefs), and reads them there after
// that.
func otherOwnValue(f *ir.Func, refs *@[]@ir.Instr, mv *ModuleValues, v *ir.Instr) bool {
	if v.IsGlobalRef { return moduleHolds(mv, v) }
	if v.Op != iropcode.OP_PARAM || !isParamID(f.Params, v.ID) { return false }
	if len(*refs) == 0 { fetchParamRefs(f, refs) }
	return holdsInstr(*refs, v)
}

// fetchParamRefs sets refs to f's parameter refs, f.ParamRefs' items, when f has any.
func fetchParamRefs(f *ir.Func, refs *@[]@ir.Instr) {
	if f.ParamRefs != nil { *refs = f.ParamRefs.Items() }
}

// isParamID reports whether id is the id of one of params.
func isParamID(params *[]@ir.Param, id int) bool {
	for i := 0; i < len(params); i++ {
		var p *ir.Param = params[i]
		if p.ID == id { return true }
	}
	return false
}

// holdsInstr reports whether instrs holds v.
func holdsInstr(instrs *[]@ir.Instr, v *ir.Instr) bool {
	for i := 0; i < len(instrs); i++ {
		var ins *ir.Instr = instrs[i]
		if ins == v { return true }
	}
	return false
}

// operandFault describes the operand at at of an instruction of blocks, f's blocks or pads
// as kind says, which is not one of f's own values: "<op> in <f> (<kind> <label>) has its
// operand <k>" followed by what the operand is (operandOwner), k its index among the
// instruction's arguments or phi entries.
func operandFault(f *ir.Func, blocks *[]@ir.Block, kind *[]readonly char, at operandAt,
		mv *ModuleValues) @[]char {
	var b *ir.Block = blocks[at.bi]
	var ins *ir.Instr = b.Instrs[at.ii]
	var k int = at.k
	if k >= len(ins.Args) { k = k - len(ins.Args) }
	var op *[]readonly char = iropcode.OpName(ins.Op)
	var s @[]char = buf.Concat(buf.Concat(article(op), op), " in ")
	s = buf.Concat(buf.Concat(buf.Concat(s, f.Name), " ("), kind)
	s = buf.Concat(buf.Concat(buf.Concat(s, " "), b.Label), ") has its operand ")
	return buf.Concat(buf.Concat(s, strconv.Itoa(k)), operandOwner(f, operandIn(blocks, at), mv))
}

// article returns "an " for a word that starts with a vowel, else "a ".
func article(word *[]readonly char) *[]readonly char {
	if len(word) > 0 {
		var c char = word[0]
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' { return "an " }
	}
	return "a "
}

// operandOwner describes where v, an operand of an instruction of f that is not one of f's
// own values, comes from: a global-address pseudo not among mv's module's; an instruction
// of f with no id, or with an id an instruction before it has; a parameter ref of f under
// an id none of f's parameters has; an instruction of a block or pad a pass dropped from
// f.Blocks or f.FaultPads; another function's instruction or parameter (one of mv's
// module's functions); a parameter ref no function of the module holds; or an instruction
// in none of f's blocks and pads.
func operandOwner(f *ir.Func, v *ir.Instr, mv *ModuleValues) @[]char {
	if v.IsGlobalRef {
		return buf.Concat(buf.Concat(", the address of ", v.StrVal),
				", outside the module (not one of its global address pseudos)")
	}
	var s @[]char = buf.Concat(buf.Concat(" (v", strconv.Itoa(v.ID)), ") ")
	if blocksHold(f.Blocks, v) || blocksHold(f.FaultPads, v) {
		if v.ID < 0 { return buf.Concat(s, "inside the function, but with no value (no id)") }
		return buf.Concat(s, "inside the function, but under an id an instruction before it has")
	}
	if f.ParamRefs != nil && holdsInstr(f.ParamRefs.Items(), v) {
		var why *[]readonly char = "inside the function, but a parameter ref under an id none of "
				"its parameters has"
		return buf.Concat(s, why)
	}
	if f.AddedBlocks != nil && blocksHold(f.AddedBlocks.Items(), v) {
		return buf.Concat(s, "outside the function's blocks and pads (in one dropped from them)")
	}
	var fs @[]@ir.Func = mv.mod.Funcs
	for i := 0; i < len(fs); i++ {
		var g *ir.Func = fs[i]
		if g == f { continue }
		var what *[]readonly char = ""
		if blocksHold(g.Blocks, v) || blocksHold(g.FaultPads, v) {
			what = "outside the function (an instruction of "
		} else if g.ParamRefs != nil && holdsInstr(g.ParamRefs.Items(), v) {
			what = "outside the function (a parameter of "
		}
		if len(what) > 0 { return buf.Concat(buf.Concat(buf.Concat(s, what), g.Name), ")") }
	}
	if v.Op == iropcode.OP_PARAM {
		return buf.Concat(s, "outside the function (a parameter ref no function of the module holds)")
	}
	return buf.Concat(s, "outside the function (in none of its blocks and pads)")
}

// blocksHold reports whether one of blocks holds v in its Instrs.
func blocksHold(blocks *[]@ir.Block, v *ir.Instr) bool {
	for bi := 0; bi < len(blocks); bi++ {
		var b *ir.Block = blocks[bi]
		if holdsInstr(b.Instrs, v) { return true }
	}
	return false
}
