package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"

// The id array of the operand check (ModuleValues.byID): the instructions of the function
// being checked, each at its id, in the front of an array kept from one check to the next.

// fillByID records in mv.byID, at its id, each instruction of f.Blocks and f.FaultPads that
// has an id (not -1) -- the first of them for an id two have, nil for an id none has -- and
// returns f's id range n, the larger of f.NextID and one past the largest such id (0 at
// least).  It clears the range in the same pass as it records: [0, f.NextID) first, then,
// when an instruction's id is at or past the range's end, the range up to that id
// (extendByID), growing mv.byID when it is shorter.  It reads each block's Instrs, never
// InstrsVec, which keeps the instructions a pass removed from Instrs.  Ids are dense per
// function (below f.NextID), so this is one array, not a table, and an id past f.NextID is
// rare.
func fillByID(f *ir.Func, mv *ModuleValues) int {
	var n int = extendByID(mv, 0, f.NextID)
	n = recordIDs(f, mv, f.Blocks, n)
	return recordIDs(f, mv, f.FaultPads, n)
}

// extendByID clears mv.byID's entries [from, to), keeping its front from entries, and
// returns the larger of from and to.  It grows mv.byID when it is shorter than to: at
// least twofold, so a run of ever larger functions reallocates it only a few times
// (make_slice clears the new array, and the front from entries are copied into it).
func extendByID(mv *ModuleValues, from int, to int) int {
	if to <= from { return from }
	if to > len(mv.byID) {
		var size int = 2 * len(mv.byID)
		if size < to { size = to }
		var grown @[]*ir.Instr = make_slice(*ir.Instr, size)
		for i := 0; i < from; i++ { grown[i] = mv.byID[i] }
		mv.byID = grown
	} else {
		clearAll(mv.byID[from:to])
	}
	return to
}

// clearAll sets every entry of byID to nil.  The loop is bounded by byID's own length, so a
// compiler can drop its index check and clear the entries as one block of memory.
func clearAll(byID *[]*ir.Instr) {
	for i := 0; i < len(byID); i++ { byID[i] = nil }
}

// recordIDs records in mv.byID, at its id, each instruction of blocks, f's blocks or pads,
// that has an id, unless an earlier one has it, and returns the end of the range of mv.byID
// that is cleared or recorded, n on entry: it extends the range (extendByID) to each id past
// its end as one turns up.  An id of the largest int is an internal error (a panic): no
// range can end one past it.
func recordIDs(f *ir.Func, mv *ModuleValues, blocks *[]@ir.Block, n int) int {
	for bi := 0; bi < len(blocks); bi++ {
		var b *ir.Block = blocks[bi]
		var i int = recordFrom(mv.byID, n, b.Instrs, 0)
		for i < len(b.Instrs) {
			var past *ir.Instr = b.Instrs[i]
			// past's id is n or more, so one past it is n or less only when the id is the
			// largest int and the sum wraps.
			if past.ID + 1 <= n {
				panic(buf.Concat(buf.Concat("internal error: an instruction of ", f.Name),
						" has the largest int as its id, which no id range can hold"))
			}
			n = extendByID(mv, n, past.ID + 1)
			i = recordFrom(mv.byID, n, b.Instrs, i)
		}
	}
	return n
}

// recordFrom records in byID's front n entries, at its id, each instruction of instrs from
// i on that has an id, unless an earlier one has it, up to the first whose id is n or more;
// it returns that one's index, or len(instrs) when there is none.  instrs and byID are
// parameters, not fields read through a pointer, so a store into byID does not make a
// compiler read instrs' length again.
func recordFrom(byID *[]*ir.Instr, n int, instrs *[]@ir.Instr, i int) int {
	var front *[]*ir.Instr = byID[0:n]
	for i < len(instrs) {
		var ins *ir.Instr = instrs[i]
		if ins.ID >= len(front) { return i }
		if ins.ID >= 0 && front[ins.ID] == nil { front[ins.ID] = ins }
		i++
	}
	return i
}
