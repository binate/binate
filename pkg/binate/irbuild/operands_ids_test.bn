package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the operand check's id array (fillByID): one ModuleValues checks one function
// after another, reusing the array, and a check finds in it only its own function's
// instructions, whatever the function checked before left there and wherever an id past the
// function's NextID turns up.

// checkedOwn fails unless ForeignOperandError(f, values) is empty, prefixing the failure
// with what.
func checkedOwn(f @ir.Func, values @ModuleValues, what *[]readonly char) testing.TestResult {
	var got @[]char = ForeignOperandError(f, values)
	if len(got) == 0 { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// One ModuleValues checks one function after another, reusing its id array: another
// function's instruction left in it by that function's check is not one of the next
// function's values -- here g's constant 1 as an operand of f's add, under the id of f's
// own constant 1.
func TestForeignOperandErrorAfterAnotherFunctionsCheck() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	var gi @[]@ir.Instr
	g, _, gi = opFunc(m, "main.g")
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if gi[0].Args[1].ID != fi[0].Args[1].ID { return "g's constant 1 must have the id of f's" }
	fi[0].Args[1] = gi[0].Args[1]
	var got @[]char = ForeignOperandError(f, values)
	var want *[]readonly char = "an add in main.f (block entry.0) has its operand 1 (v1) outside the "
			"function (an instruction of main.g)"
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat("g's instruction, checked after g: got \"", got), "\""))
}

// A check clears the whole of its function's id range in the reused id array, not only the
// ids its instructions have: an id of f's range that none of f's instructions has keeps no
// instruction of the function checked before -- here g's constant 1 as an operand of f's
// add, under the id of f's constant 1, which has left entry's Instrs.
func TestForeignOperandErrorAfterAnotherFunctionsCheckUnderAnUnusedID() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var g @ir.Func
	var gi @[]@ir.Instr
	g, _, gi = opFunc(m, "main.g")
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if fb[0].Instrs[0] != fi[0].Args[1] { return "entry must start with the constant 1" }
	if gi[0].Args[1].ID != fi[0].Args[1].ID { return "g's constant 1 must have the id of f's" }
	fb[0].Instrs = fb[0].Instrs[1:]
	fi[0].Args[1] = gi[0].Args[1]
	var got @[]char = ForeignOperandError(f, values)
	var want *[]readonly char = "an add in main.f (block entry.0) has its operand 1 (v1) outside the "
			"function (an instruction of main.g)"
	if charsEqual(got, want) { return "" }
	var what *[]readonly char = "g's instruction under an id none of f's has, checked after g"
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// afterALargerFunction checks f, then a larger function g, for which the id array grows,
// then f again, with one ModuleValues, f's add fi[at] reading as its operand 1 g's
// instruction under the first id past f's range, and fails unless the error is want,
// prefixing the failure with what.
func afterALargerFunction(at int, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	g, _, _ = opFunc(m, "main.g")
	// g gets an id past f's range: a constant in a block of its own, which returns it.
	var extra @ir.Block = ir.AddBlock(g, "extra")
	var c @ir.Instr = EmitConstInt(extra, 8, types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = c
	EmitReturn(extra, rets)
	if c.ID != f.NextID { return "g's constant 8 must have the first id past f's range" }
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(f, values, "f's own values")
	if len(r) > 0 { return r }
	r = checkedOwn(g, values, "g's own values, after f")
	if len(r) > 0 { return r }
	if fi[at].Op != iropcode.OP_ADD { return "f's instruction must be an add" }
	fi[at].Args[1] = c
	var got @[]char = ForeignOperandError(f, values)
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// A check looks an operand up only within its function's id range, not the whole reused
// id array: an instruction of a larger function checked before, under an id past f's
// range, is not one of f's values.  The array is grown for the larger function too.
func TestForeignOperandErrorAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (block merge.3) has its operand 1 (v11) outside the "
			"function (an instruction of main.g)"
	return afterALargerFunction(3, want, "g's instruction past f's range, checked after g")
}

// An operand of an instruction of a fault pad is looked up only within the function's id
// range as well.
func TestForeignOperandErrorInPadAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (pad pad.0) has its operand 1 (v11) outside the "
			"function (an instruction of main.g)"
	return afterALargerFunction(4, want, "g's instruction past f's range in f's pad, checked after g")
}

// ownUnderAnIDPastNextID checks f, with a fresh ModuleValues, after giving its instruction
// fi[at] an id well past f.NextID -- past twice the id array's length once [0, f.NextID) is
// cleared -- and fails unless every operand is f's own, prefixing the failure with what.
func ownUnderAnIDPastNextID(at int, what *[]readonly char) testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	fi[at].ID = f.NextID + 20
	return checkedOwn(f, NewModuleValues(m), what)
}

// An id past the function's NextID, on an instruction of a block after others with ids
// below it, grows the id array while the instructions before it are already recorded, and
// they are kept: here f's add t, in its merge block, whose return reads it.
func TestForeignOperandErrorOwnValuesUnderAnIDPastNextID() testing.TestResult {
	return ownUnderAnIDPastNextID(3, "t under an id past f's NextID")
}

// So does one on an instruction of a fault pad, after every block's: here the pad's add u.
func TestForeignOperandErrorOwnValuesUnderAnIDPastNextIDInPad() testing.TestResult {
	return ownUnderAnIDPastNextID(4, "u, in f's pad, under an id past f's NextID")
}

// pastNextIDAfterALargerFunction checks a function g larger than f, then f with the same
// ModuleValues, after giving f's instruction fi[at] the id f.NextID + 2 and making f's add
// fi[reader] read as its operand 1 g's instruction under the id f.NextID + 1, between f's
// NextID and fi[at]'s id, and fails unless the error is want, prefixing the failure with
// what.  The id array is long enough for f's range, so no growth clears it.
func pastNextIDAfterALargerFunction(at int, reader int, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	g, _, _ = opFunc(m, "main.g")
	// g gets three ids past f's NextID: constants in a block of their own, which returns
	// the last.
	var extra @ir.Block = ir.AddBlock(g, "extra")
	var cs @[]@ir.Instr = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ { cs[i] = EmitConstInt(extra, 8 + i, types.TypInt()) }
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = cs[2]
	EmitReturn(extra, rets)
	if cs[0].ID != f.NextID { return "g's constant 8 must have the first id past f's range" }
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if fi[reader].Op != iropcode.OP_ADD { return "f's reader must be an add" }
	fi[at].ID = f.NextID + 2
	fi[reader].Args[1] = cs[1]
	var got @[]char = ForeignOperandError(f, values)
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// An id past the function's NextID, on an instruction of a block after others with ids
// below it, extends the function's id range there, and the extension is cleared as well:
// an instruction the larger function checked before left under an id of it is not one of
// the function's values -- here g's constant 9, under the id between f's NextID and that
// of f's add t, read by f's pad.
func TestForeignOperandErrorPastNextIDAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (pad pad.0) has its operand 1 (v12) outside the "
			"function (an instruction of main.g)"
	return pastNextIDAfterALargerFunction(3, 4, want, "g's instruction in the range t extends")
}

// An id past the function's NextID on an instruction of a fault pad extends the range
// there, and that extension is cleared as well -- here g's constant 9, under the id between
// f's NextID and that of the pad's add u, read by f's add t.
func TestForeignOperandErrorPastNextIDInPadAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (block merge.3) has its operand 1 (v12) outside "
			"the function (an instruction of main.g)"
	return pastNextIDAfterALargerFunction(4, 3, want, "g's instruction in the range u extends")
}

// After a larger function's check, an id at the function's NextID extends the range by one,
// and a later id past the id array's length grows the array, which keeps only the front
// recorded so far: an instruction the larger function left in the array past that front is
// not one of the function's values -- here g's constant 9, under the id one past f's NextID,
// read by f's pad, after f's add s (which the pad reads too) under the id f.NextID and f's
// add t under an id past the array.
func TestForeignOperandErrorGrownMidRecordAfterALargerFunctionsCheck() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	g, _, _ = opFunc(m, "main.g")
	// g gets three ids past f's NextID: constants in a block of their own, which returns the
	// last.
	var extra @ir.Block = ir.AddBlock(g, "extra")
	var cs @[]@ir.Instr = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ { cs[i] = EmitConstInt(extra, 8 + i, types.TypInt()) }
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = cs[2]
	EmitReturn(extra, rets)
	if cs[0].ID != f.NextID { return "g's constant 8 must have the first id past f's range" }
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if len(values.byID) != g.NextID { return "the id array must be as long as g's range" }
	if fi[4].Args[0] != fi[0] { return "f's pad add u must read f's add s" }
	fi[0].ID = f.NextID
	fi[3].ID = g.NextID + 5
	fi[4].Args[1] = cs[1]
	var got @[]char = ForeignOperandError(f, values)
	var want *[]readonly char = "an add in main.f (pad pad.0) has its operand 1 (v12) outside the "
			"function (an instruction of main.g)"
	if charsEqual(got, want) { return "" }
	var what *[]readonly char = "g's instruction past the front kept when the array grows"
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}
