package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ForeignOperandError: the first operand of an instruction of a function's
// blocks or pads that is not one of the function's own values, described by the function,
// the block or pad, the instruction's op, the operand's index and what the operand is.

// opFunc returns a function named name, `f(x int) int`, added to m (which keeps it alive
// while another function's instruction names its values, as a module does in a compile):
//
//	entry: s = add x, 1; l = load &gx; branch true, left, right
//	left: jump merge (after the constant 2)
//	right: jump merge (after the constant 3)
//	merge: p = phi [2, left], [3, right]; t = add p, l; return t
//	pad (a fault pad): u = add s, 7; unwind return
//
// x a parameter ref (f.ParamRefs) and &gx a global-address pseudo of m (m.GlobalRefs).
// It returns f, its blocks (entry, left, right, merge, pad) and its instructions s, l, p,
// t and u.
func opFunc(m @ir.Module, name @[]char) (@ir.Func, @[]@ir.Block, @[]@ir.Instr) {
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = make(ir.Param)
	ps[0].Name = "x"
	ps[0].Typ = types.TypInt()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, ps, results)
	var bs @[]@ir.Block = make_slice(@ir.Block, 5)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "left")
	bs[2] = ir.AddBlock(f, "right")
	bs[3] = ir.AddBlock(f, "merge")
	bs[4] = ir.AddFaultPad(f, "pad")
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 5)
	var x @ir.Instr = NewParamRef(f, f.Params[0])
	vals[0] = EmitBinop(bs[0], iropcode.OP_ADD, x, EmitConstInt(bs[0], 1, types.TypInt()),
			types.TypInt())
	vals[1] = EmitLoad(bs[0], NewGlobalRef(m, "main.gx", types.TypInt()), types.TypInt())
	EmitBranch(bs[0], EmitConstBool(bs[0], true), bs[1], bs[2])
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0].Block = bs[1]
	es[0].Val = EmitConstInt(bs[1], 2, types.TypInt())
	es[1].Block = bs[2]
	es[1].Val = EmitConstInt(bs[2], 3, types.TypInt())
	EmitJump(bs[1], bs[3])
	EmitJump(bs[2], bs[3])
	vals[2] = EmitPhi(bs[3], types.TypInt(), es)
	vals[3] = EmitBinop(bs[3], iropcode.OP_ADD, vals[2], vals[1], types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = vals[3]
	EmitReturn(bs[3], rets)
	vals[4] = EmitBinop(bs[4], iropcode.OP_ADD, vals[0], EmitConstInt(bs[4], 7, types.TypInt()),
			types.TypInt())
	EmitUnwindReturn(bs[4])
	m.AddFunc(f)
	return f, bs, vals
}

// operandErrorIs fails unless ForeignOperandError(f, the values of m) is want, prefixing
// the failure with what.
func operandErrorIs(f @ir.Func, m @ir.Module, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	var got @[]char = ForeignOperandError(f, NewModuleValues(m))
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// Every kind of a function's own value is taken: instructions of its blocks and of its
// fault pad (an argument, a phi entry's value), its parameter ref and its module's global
// pseudo -- the function's Mod unset, as on a destructor or a copy helper, since the module
// is passed in.
func TestForeignOperandErrorNoneForOwnValues() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var g @ir.Func
	f, _, _ = opFunc(m, "main.f")
	g, _, _ = opFunc(m, "main.g")
	if f.Mod != nil { return "f's Mod must be unset" }
	var r testing.TestResult = operandErrorIs(f, m, "", "f's own values")
	if len(r) > 0 { return r }
	return operandErrorIs(g, m, "", "g's own values")
}

// An operand that is another function's instruction is reported, naming that function --
// here one with the id of f's own instruction in its place, which a backend naming the
// operand by its id would silently read instead.
func TestForeignOperandErrorOtherFunctionsInstruction() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var gi @[]@ir.Instr
	_, _, gi = opFunc(m, "main.g")
	if gi[0].Args[1].ID != fi[0].Args[1].ID { return "g's constant 1 must have the id of f's" }
	fi[0].Args[1] = gi[0].Args[1]
	return operandErrorIs(f, m,
			"an add in main.f (block entry.0) has its operand 1 (v1) outside the function (an "
					"instruction of main.g)",
			"g's instruction")
}

// An operand that is another function's parameter is reported, naming that function.
func TestForeignOperandErrorOtherFunctionsParameter() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var gi @[]@ir.Instr
	_, _, gi = opFunc(m, "main.g")
	fi[0].Args[0] = gi[0].Args[0]
	return operandErrorIs(f, m,
			"an add in main.f (block entry.0) has its operand 0 (v0) outside the function (a "
					"parameter of main.g)",
			"g's parameter")
}

// A global-address pseudo of another module is reported, naming the global, and so is one
// no module holds; whatever id a pseudo has, its own module's is taken.
func TestForeignOperandErrorOtherModulesGlobal() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	// An id of one of f's instructions, as a backend may give a pseudo it materializes.
	fi[1].Args[0].ID = fi[0].ID
	var r testing.TestResult = operandErrorIs(f, m, "", "m's pseudo, under the id of f's add")
	if len(r) > 0 { return r }
	var other @ir.Module = ir.NewModule("\"other\"")
	fi[1].Args[0] = NewGlobalRef(other, "other.gy", types.TypInt())
	var want *[]readonly char = "a load in main.f (block entry.0) has its operand 0, the address of "
			"other.gy, outside the module (not one of its global address pseudos)"
	r = operandErrorIs(f, m, want, "another module's pseudo")
	if len(r) > 0 { return r }
	var loose @ir.Instr = make(ir.Instr)
	loose.ID = -1
	loose.Op = iropcode.OP_ALLOC
	loose.StrVal = "other.gy"
	loose.IsGlobalRef = true
	fi[1].Args[0] = loose
	return operandErrorIs(f, m, want, "a pseudo no module holds")
}

// An instruction in none of the function's blocks and pads is reported: one made for the
// function but never added to a block, and one a pass removed from its block's Instrs
// (which InstrsVec still holds).
func TestForeignOperandErrorInstructionInNoBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var detached @ir.Instr = ir.NewInstr(f, iropcode.OP_CONST_NIL, types.TypNil())
	fi[3].Args[1] = detached
	var r testing.TestResult = operandErrorIs(f, m,
			"an add in main.f (block merge.3) has its operand 1 (v11) outside the function (in none "
					"of its blocks and pads)",
			"a detached instruction")
	if len(r) > 0 { return r }
	// Remove the constant 1 from entry's Instrs (its first instruction), leaving it in
	// InstrsVec.
	f, fb, fi = opFunc(m, "main.h")
	if fb[0].Instrs[0] != fi[0].Args[1] { return "entry must start with the constant 1" }
	fb[0].Instrs = fb[0].Instrs[1:]
	return operandErrorIs(f, m,
			"an add in main.h (block entry.0) has its operand 1 (v1) outside the function (in none "
					"of its blocks and pads)",
			"an instruction removed from its block")
}

// An instruction of a block a pass dropped from f.Blocks is reported as such.
func TestForeignOperandErrorDroppedBlock() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var gone @ir.Block = ir.AddBlock(f, "gone")
	var c @ir.Instr = EmitConstInt(gone, 5, types.TypInt())
	EmitJump(gone, fb[3])
	f.Blocks = fb[0:4]
	fi[3].Args[1] = c
	return operandErrorIs(f, m,
			"an add in main.f (block merge.3) has its operand 1 (v11) outside the function's blocks "
					"and pads (in one dropped from them)",
			"an instruction of a dropped block")
}

// A phi entry's value that is another function's instruction is reported, the entry's
// index as the operand's.
func TestForeignOperandErrorPhiValue() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var gi @[]@ir.Instr
	_, _, gi = opFunc(m, "main.g")
	fi[2].Phis[1].Val = gi[2].Phis[1].Val
	return operandErrorIs(f, m,
			"a phi in main.f (block merge.3) has its operand 1 (v6) outside the function (an "
					"instruction of main.g)",
			"g's instruction as a phi value")
}

// An instruction of a fault pad a pass dropped from f.FaultPads is reported as such.
func TestForeignOperandErrorDroppedFaultPad() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var gone @ir.Block = ir.AddFaultPad(f, "gone")
	var c @ir.Instr = EmitConstInt(gone, 5, types.TypInt())
	EmitUnwindReturn(gone)
	if len(f.FaultPads) != 2 || f.FaultPads[0] != fb[4] { return "f must have its pad and gone" }
	f.FaultPads = f.FaultPads[0:1]
	fi[4].Args[1] = c
	return operandErrorIs(f, m,
			"an add in main.f (pad pad.0) has its operand 1 (v11) outside the function's blocks and "
					"pads (in one dropped from them)",
			"an instruction of a dropped pad")
}

// An operand of an instruction of a fault pad is checked as well, the pad named as such.
func TestForeignOperandErrorInFaultPad() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var gi @[]@ir.Instr
	_, _, gi = opFunc(m, "main.g")
	fi[4].Args[0] = gi[0]
	return operandErrorIs(f, m,
			"an add in main.f (pad pad.0) has its operand 0 (v2) outside the function (an "
					"instruction of main.g)",
			"g's instruction in f's pad")
}

// A parameter ref that is not among f.ParamRefs, nor any function's of the module, is
// reported.
func TestForeignOperandErrorUnheldParameterRef() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var ref @ir.Instr = make(ir.Instr)
	ref.ID = 0
	ref.Op = iropcode.OP_PARAM
	ref.Typ = types.TypInt()
	fi[0].Args[0] = ref
	return operandErrorIs(f, m,
			"an add in main.f (block entry.0) has its operand 0 (v0) outside the function (a "
					"parameter ref no function of the module holds)",
			"a parameter ref f does not hold")
}

// A parameter ref f.ParamRefs holds is not one of f's values under an id none of f.Params
// has -- here the id of one of f's instructions, which a backend reading the ref as the
// parameter of its id would read instead.
func TestForeignOperandErrorParamRefUnderOtherID() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var other @ir.Param = make(ir.Param)
	other.Name = "y"
	other.Typ = types.TypInt()
	other.ID = fi[1].ID
	fi[3].Args[1] = NewParamRef(f, other)
	return operandErrorIs(f, m,
			"an add in main.f (block merge.3) has its operand 1 (v3) inside the function, but a "
					"parameter ref under an id none of its parameters has",
			"a parameter ref of f under the load's id")
}

// The module's global-address pseudos are gathered when an operand check first meets one,
// not by NewModuleValues: a pseudo made for the module in between is the module's.
func TestForeignOperandErrorGathersGlobalsOnFirstUse() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var values @ModuleValues = NewModuleValues(m)
	var f @ir.Func
	f, _, _ = opFunc(m, "main.f")
	var got @[]char = ForeignOperandError(f, values)
	if len(got) == 0 { return "" }
	var what *[]readonly char = "a pseudo made after NewModuleValues, before any check: got \""
	return fail(buf.Concat(buf.Concat(what, got), "\""))
}

// An instruction of the function with no id, or under an id an instruction before it has,
// is not one of its values either: an operand names a value by its id.
func TestForeignOperandErrorOwnInstructionWithoutItsOwnID() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var jump @ir.Instr = fb[1].Instrs[len(fb[1].Instrs) - 1]
	fi[3].Args[1] = jump
	var r testing.TestResult = operandErrorIs(f, m,
			"an add in main.f (block merge.3) has its operand 1 (v-1) inside the function, but with "
					"no value (no id)",
			"f's jump")
	if len(r) > 0 { return r }
	// t under the id of l, which comes before it: the return reads t.
	f, _, fi = opFunc(m, "main.g")
	fi[3].ID = fi[1].ID
	return operandErrorIs(f, m,
			"a return in main.g (block merge.3) has its operand 0 (v3) inside the function, but under "
					"an id an instruction before it has",
			"g's add under the load's id")
}

// Once the function's phis are eliminated (ir.Func.PhisEliminated) its operands cannot be
// checked -- its instructions then read phis no block holds -- and the error says so, its
// operands its own or not.
func TestForeignOperandErrorAfterPhiElimination() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	// The phi leaves its block, as phi elimination removes it.
	fb[3].Instrs = fb[3].Instrs[1:]
	var r testing.TestResult = operandErrorIs(f, m,
			"an add in main.f (block merge.3) has its operand 0 (v7) outside the function (in none "
					"of its blocks and pads)",
			"the phi out of its block, before elimination")
	if len(r) > 0 { return r }
	if fi[3].Args[0] != fi[2] { return "the add must read the phi" }
	f.PhisEliminated = true
	var want *[]readonly char = "main.f has had its phis eliminated, after which its operands cannot "
			"be checked (they may read phis no block holds)"
	r = operandErrorIs(f, m, want, "the phi out of its block, after elimination")
	if len(r) > 0 { return r }
	var g @ir.Func
	g, _, _ = opFunc(m, "main.g")
	g.PhisEliminated = true
	return operandErrorIs(g, m, buf.Concat("main.g", want[6:]), "own operands, after elimination")
}

// checkedOwn fails unless ForeignOperandError(f, values) is empty, prefixing the failure
// with what.
func checkedOwn(f @ir.Func, values @ModuleValues, what *[]readonly char) testing.TestResult {
	var got @[]char = ForeignOperandError(f, values)
	if len(got) == 0 { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// One ModuleValues checks one function after another, reusing its id array: another
// function's instruction left in it by that function's check is not one of the next
// function's values -- here g's constant 1 as an operand of f's add, under the id of f's
// own constant 1.
func TestForeignOperandErrorAfterAnotherFunctionsCheck() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	var gi @[]@ir.Instr
	g, _, gi = opFunc(m, "main.g")
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if gi[0].Args[1].ID != fi[0].Args[1].ID { return "g's constant 1 must have the id of f's" }
	fi[0].Args[1] = gi[0].Args[1]
	var got @[]char = ForeignOperandError(f, values)
	var want *[]readonly char = "an add in main.f (block entry.0) has its operand 1 (v1) outside the "
			"function (an instruction of main.g)"
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat("g's instruction, checked after g: got \"", got), "\""))
}

// A check clears the whole of its function's id range in the reused id array, not only the
// ids its instructions have: an id of f's range that none of f's instructions has keeps no
// instruction of the function checked before -- here g's constant 1 as an operand of f's
// add, under the id of f's constant 1, which has left entry's Instrs.
func TestForeignOperandErrorAfterAnotherFunctionsCheckUnderAnUnusedID() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	var fi @[]@ir.Instr
	f, fb, fi = opFunc(m, "main.f")
	var g @ir.Func
	var gi @[]@ir.Instr
	g, _, gi = opFunc(m, "main.g")
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(g, values, "g's own values")
	if len(r) > 0 { return r }
	if fb[0].Instrs[0] != fi[0].Args[1] { return "entry must start with the constant 1" }
	if gi[0].Args[1].ID != fi[0].Args[1].ID { return "g's constant 1 must have the id of f's" }
	fb[0].Instrs = fb[0].Instrs[1:]
	fi[0].Args[1] = gi[0].Args[1]
	var got @[]char = ForeignOperandError(f, values)
	var want *[]readonly char = "an add in main.f (block entry.0) has its operand 1 (v1) outside the "
			"function (an instruction of main.g)"
	if charsEqual(got, want) { return "" }
	var what *[]readonly char = "g's instruction under an id none of f's has, checked after g"
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// afterALargerFunction checks f, then a larger function g, for which the id array grows,
// then f again, with one ModuleValues, f's add fi[at] reading as its operand 1 g's
// instruction under the first id past f's range, and fails unless the error is want,
// prefixing the failure with what.
func afterALargerFunction(at int, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fi @[]@ir.Instr
	f, _, fi = opFunc(m, "main.f")
	var g @ir.Func
	g, _, _ = opFunc(m, "main.g")
	// g gets an id past f's range: a constant in a block of its own, which returns it.
	var extra @ir.Block = ir.AddBlock(g, "extra")
	var c @ir.Instr = EmitConstInt(extra, 8, types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = c
	EmitReturn(extra, rets)
	if c.ID != f.NextID { return "g's constant 8 must have the first id past f's range" }
	var values @ModuleValues = NewModuleValues(m)
	var r testing.TestResult = checkedOwn(f, values, "f's own values")
	if len(r) > 0 { return r }
	r = checkedOwn(g, values, "g's own values, after f")
	if len(r) > 0 { return r }
	if fi[at].Op != iropcode.OP_ADD { return "f's instruction must be an add" }
	fi[at].Args[1] = c
	var got @[]char = ForeignOperandError(f, values)
	if charsEqual(got, want) { return "" }
	return fail(buf.Concat(buf.Concat(buf.Concat(what, ": got \""), got), "\""))
}

// A check looks an operand up only within its function's id range, not the whole reused
// id array: an instruction of a larger function checked before, under an id past f's
// range, is not one of f's values.  The array is grown for the larger function too.
func TestForeignOperandErrorAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (block merge.3) has its operand 1 (v11) outside the "
			"function (an instruction of main.g)"
	return afterALargerFunction(3, want, "g's instruction past f's range, checked after g")
}

// An operand of an instruction of a fault pad is looked up only within the function's id
// range as well.
func TestForeignOperandErrorInPadAfterALargerFunctionsCheck() testing.TestResult {
	var want *[]readonly char = "an add in main.f (pad pad.0) has its operand 1 (v11) outside the "
			"function (an instruction of main.g)"
	return afterALargerFunction(4, want, "g's instruction past f's range in f's pad, checked after g")
}
