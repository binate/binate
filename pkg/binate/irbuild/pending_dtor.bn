package "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/types"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/stdx/slices"

// Destructor work-lists: the module-level queues of dtor / helper bodies IR-gen
// discovers it needs while emitting cleanup (managed-slice, managed-pointer,
// struct / array dtors, and the single func-value / interface-value bodies),
// drained when the module's dtors are generated.

// RegisterPendingFuncValueDtor flags that the module needs the managed-func-value
// dtor `__dtor_func` emitted (drop of a `@(@func())`).  One signature-independent
// body, so a boolean flag rather than a per-type work-list.
func RegisterPendingFuncValueDtor(f @ir.Func) {
	if f.Mod == nil {
		fmt.Println("ir: registerPendingFuncValueDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	f.Mod.NeedsFuncValueDtor = true
}

// RegisterPendingIfaceValueDtor flags that the module needs the managed-iface-value
// dtor `__dtor_interface` emitted (drop of a `@(@I)`).  One interface-independent
// body, so a boolean flag rather than a per-type work-list.
func RegisterPendingIfaceValueDtor(f @ir.Func) {
	if f.Mod == nil {
		fmt.Println("ir: registerPendingIfaceValueDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	f.Mod.NeedsIfaceValueDtor = true
}

// RegisterPendingMpDtor records a managed-POINTER type `@T` that needs a
// `__dtor_mp_<T>` helper — mirrors registerPendingMsDtor.  Used when the drop of a
// `@(@T)` (a managed pointer to a managed value) references the pointee's mp-dtor.
func RegisterPendingMpDtor(f @ir.Func, mpTyp @types.Type) {
	if f.Mod == nil {
		fmt.Println("ir: registerPendingMpDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	registerPendingMpDtor(f.Mod, mpTyp)
}

// registerPendingMpDtor queues m's `__dtor_mp_<T>` body for mpTyp, once.
func registerPendingMpDtor(m *ir.Module, mpTyp @types.Type) {
	var name @[]char = irutil.DtorNameForType(mpTyp)
	if irutil.HasName(m.PendingMpDtorNames, name) { return }
	m.PendingMpDtors = slices.Append[@types.Type](m.PendingMpDtors, mpTyp)
	m.PendingMpDtorNames = slices.Append[@[]char](m.PendingMpDtorNames, name)
}

// RegisterPendingMsDtor records a managed-slice type that needs a dtor.  The
// work-list lives on the func's module (f.Mod) — see registerPendingStructDtor
// for the back-ref + nil-abort rationale.
func RegisterPendingMsDtor(f @ir.Func, msTyp @types.Type) {
	if f.Mod == nil {
		fmt.Println("ir: registerPendingMsDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	registerPendingMsDtor(f.Mod, msTyp)
}

// registerPendingMsDtor queues m's managed-slice dtor body for msTyp, once.
func registerPendingMsDtor(m *ir.Module, msTyp @types.Type) {
	var name @[]char = irutil.DtorNameForType(msTyp)
	if irutil.HasName(m.PendingMsDtorNames, name) { return }
	m.PendingMsDtors = slices.Append[@types.Type](m.PendingMsDtors, msTyp)
	m.PendingMsDtorNames = slices.Append[@[]char](m.PendingMsDtorNames, name)
}

// RegisterPendingStructDtor records a struct/array type that needs dtor and
// copy functions generated. This handles types discovered during scope cleanup
// that aren't in Module.Structs (e.g., array types used as local variables).
// The work-list lives on the func's module (f.Mod), reached via the raw
// back-ref set at body-gen creation; f.Mod is non-nil for every func whose
// body runs scope cleanup, so a nil Mod is an IR-gen bug (a registering func
// created off the genFuncWithPrependedParams path) — abort rather than drop
// the registration silently, which would leak the type's dtor.
func RegisterPendingStructDtor(f @ir.Func, typ @types.Type) {
	if f.Mod == nil {
		fmt.Println("ir: registerPendingStructDtor on a func with no module (f.Mod nil)")
		os.Exit(1)
	}
	registerPendingStructDtor(f.Mod, typ)
}

// registerPendingStructDtor queues m's struct / array dtor body for typ, once.
func registerPendingStructDtor(m *ir.Module, typ @types.Type) {
	var name @[]char = irutil.DtorNameForType(typ)
	if irutil.HasName(m.PendingStructDtorNames, name) { return }
	m.PendingStructDtors = slices.Append[@types.Type](m.PendingStructDtors, typ)
	m.PendingStructDtorNames = slices.Append[@[]char](m.PendingStructDtorNames, name)
}

// RegisterModulePendingDtor queues the destructor body a value of type t needs
// (see the .bni); it serves a caller with no func, e.g. a (T, any) row built at
// boxing or assertion time.
func RegisterModulePendingDtor(m @ir.Module, t @types.Type) {
	var p @types.Type = types.StripWrappers(t)
	if m == nil || p == nil { return }
	if p.Kind == types.TYP_MANAGED_SLICE {
		registerPendingMsDtor(m, p)
	} else if p.Kind == types.TYP_MANAGED_PTR {
		registerPendingMpDtor(m, p)
	} else if p.Kind == types.TYP_MANAGED_FUNC_VALUE {
		m.NeedsFuncValueDtor = true
	} else if p.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		m.NeedsIfaceValueDtor = true
	} else if p.Kind == types.TYP_ARRAY && p.NeedsDestruction() {
		registerPendingStructDtor(m, p)
	}
}
