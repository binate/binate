package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// RegisterModulePendingDtor queues exactly the destructor work a type needs, by
// its kind under any named-distinct / readonly wrapper, once per dtor name.
func TestRegisterModulePendingDtorKinds() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	RegisterModulePendingDtor(m, ms)
	RegisterModulePendingDtor(m, types.MakeReadonlyType(ms))
	var named @types.Type = types.MakeNamedType("test.S")
	named.Underlying = ms
	RegisterModulePendingDtor(m, named)
	if len(m.PendingMsDtors) != 1 {
		return fail("a managed slice, readonly or named, should queue one ms dtor")
	}
	RegisterModulePendingDtor(m, types.MakeManagedPtrType(types.TypInt()))
	if len(m.PendingMpDtors) != 1 {
		return fail("a managed pointer should queue one mp dtor")
	}
	var fvParams @[]@types.Param
	var fvResults @[]@types.Type
	RegisterModulePendingDtor(m, types.MakeManagedFuncValueType(fvParams, fvResults))
	if !m.NeedsFuncValueDtor {
		return fail("a managed function value should flag the func-value dtor")
	}
	var iface @types.Type = types.MakeInterfaceType("", "any")
	RegisterModulePendingDtor(m, types.MakeManagedInterfaceValueType(iface))
	if !m.NeedsIfaceValueDtor {
		return fail("a managed interface value should flag the interface-value dtor")
	}
	RegisterModulePendingDtor(m, types.MakeArrayType(ms, 2))
	if len(m.PendingStructDtors) != 1 {
		return fail("an array of managed slices should queue one array dtor")
	}
	return ""
}

// A type that owns nothing queues nothing, and a nil module or type is ignored.
func TestRegisterModulePendingDtorNothingToDrop() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	RegisterModulePendingDtor(m, types.MakeSliceType(types.TypInt()))
	RegisterModulePendingDtor(m, types.MakeArrayType(types.TypInt(), 3))
	RegisterModulePendingDtor(m, types.TypInt())
	RegisterModulePendingDtor(m, nil)
	RegisterModulePendingDtor(nil, types.MakeManagedSliceType(types.TypInt()))
	if len(m.PendingMsDtors) != 0 || len(m.PendingMpDtors) != 0 || len(m.PendingStructDtors) != 0 ||
			m.NeedsFuncValueDtor || m.NeedsIfaceValueDtor {
		return fail("a raw slice, a plain array, a scalar or nil should queue nothing")
	}
	return ""
}

// The per-func registration reaches the same per-module queue.
func TestRegisterPendingMsDtorViaFunc() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "f", noParams, noResults)
	f.Mod = m
	RegisterPendingMsDtor(f, types.MakeManagedSliceType(types.TypInt()))
	RegisterPendingMsDtor(f, types.MakeManagedSliceType(types.TypInt()))
	if len(m.PendingMsDtors) != 1 {
		return fail("RegisterPendingMsDtor should queue on f's module, once per dtor name")
	}
	return ""
}
