package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// ============================================================
// CollectStrings / FindStringID tests
// ============================================================

func TestCollectStringsEmpty() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var strings @[]ir.StringConst = m.CollectStrings()
	if len(strings) != 0 {
		return fail("expected 0 strings from empty module")
	}
	return ""
}

func TestCollectStringsSingle() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitConstString(b, "hello")
	m.AddFunc(f)
	var strings @[]ir.StringConst = m.CollectStrings()
	if len(strings) != 1 {
		return fail("expected 1 string")
	}
	if !charsEqual(strings[0].Data, "hello") {
		return fail("expected hello")
	}
	if strings[0].Len != 5 {
		return fail("expected len 5")
	}
	return ""
}

func TestCollectStringsDeduplicate() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitConstString(b, "hello")
	EmitConstString(b, "world")
	EmitConstString(b, "hello")
	m.AddFunc(f)
	var strings @[]ir.StringConst = m.CollectStrings()
	if len(strings) != 2 {
		return fail("expected 2 deduplicated strings")
	}
	return ""
}

func TestFindStringIDFound() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitConstString(b, "alpha")
	EmitConstString(b, "beta")
	m.AddFunc(f)
	var strings @[]ir.StringConst = m.CollectStrings()
	var id int = ir.FindStringID(strings, "beta")
	if id != 1 {
		return fail("expected id 1 for beta")
	}
	return ""
}

func TestFindStringIDNotFound() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitConstString(b, "alpha")
	m.AddFunc(f)
	var strings @[]ir.StringConst = m.CollectStrings()
	var id int = ir.FindStringID(strings, "missing")
	if id != -1 {
		return fail("expected -1 for missing string")
	}
	return ""
}

// ============================================================
// len() of a bare string literal
// ============================================================

// ============================================================
// stringInterner dedup edge cases (empty string, resize rehash)
// ============================================================

// TestCollectStringsEmptyStringDedup: the empty string is a LEGAL string
// constant and must dedup like any other — the interner treats "" as an ordinary
// key (FuncSigHasher.Hash / FuncSigEq.Equal handle a len==0 slice fine), not a
// special case, so two "" constants collapse to a single entry.
func TestCollectStringsEmptyStringDedup() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	EmitConstString(b, "")
	EmitConstString(b, "x")
	EmitConstString(b, "")
	m.AddFunc(f)
	var strs @[]ir.StringConst = m.CollectStrings()
	if len(strs) != 2 {
		return fail("empty string must dedup like any other (expected 2 distinct)")
	}
	if strs[0].Len != 0 {
		return fail("first distinct constant should be the empty string (len 0)")
	}
	return ""
}

// TestCollectStringsCrossResize emits enough distinct strings (each twice) to
// force several of the interner's underlying table.Table grow-and-rehash steps,
// and verifies the rehash preserves exact dedup: n distinct entries, sequential
// first-seen IDs, and every key still findable after the rehash.
func TestCollectStringsCrossResize() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var n int = 300
	for i := 0; i < n; i++ {
		var s @[]char = internTestKey(i)
		EmitConstString(b, s)
		EmitConstString(b, s)
	}
	m.AddFunc(f)
	var strs @[]ir.StringConst = m.CollectStrings()
	if len(strs) != n {
		return fail("cross-resize dedup should keep exactly n distinct strings")
	}
	for i := 0; i < n; i++ {
		if strs[i].ID != i {
			return fail("IDs must be sequential first-seen order")
		}
	}
	if ir.FindStringID(strs, internTestKey(0)) != 0 {
		return fail("first key lost after resize rehash")
	}
	if ir.FindStringID(strs, internTestKey(n - 1)) != n - 1 {
		return fail("last key lost after resize rehash")
	}
	return ""
}

// internTestKey builds the distinct key "s"+decimal(i) without pkg/std/strings,
// so it doesn't shadow the `strings` package against this file's `strings`-named
// locals.
func internTestKey(i int) @[]char {
	var digits int = 1
	var t int = i
	for t >= 10 {
		digits = digits + 1
		t = t / 10
	}
	var out @[]char = make_slice(char, digits + 1)
	out[0] = 's'
	var k int = digits
	t = i
	for k >= 1 {
		out[k] = cast(char, cast(int, '0') + (t % 10))
		t = t / 10
		k = k - 1
	}
	return out
}
