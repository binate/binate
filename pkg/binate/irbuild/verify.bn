package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Structural IR verifier.  Walks a FINALIZED @Func and reports the ways a
// basic block can be malformed: an empty block, a block with no
// terminator, more than one terminator, a non-terminator after the
// terminator, or a jump/branch with a missing or foreign successor.
//
// This catches the "ctx.CurBlock desync" bug class: when IR-gen emits
// into an already-terminated block (e.g. a managed-field assignment splits
// the block but a stale ctx.CurBlock routes the next statement back into
// the terminated block), the displaced stores/statements pile up AFTER the
// terminator (or add a second one) and are silently dropped — a wrong-code
// defect output/refcount conformance tests cannot observe.  Both
// genExprOrFuncRef (47d05c81) and genMultiAssign (2f507f26) were this.
//
// What it deliberately does NOT check (see the design notes / TODO):
//   - Reachability: IR-gen legitimately leaves benign orphaned blocks
//     (a `switch.exit` / `if.merge` whose arms all return), so flagging
//     unreachable blocks would false-positive.  The desync's PRIMARY
//     symptom (the extra terminator / instr-after-terminator) is caught
//     structurally, so reachability adds no power for the known class.
//   - SSA def-dominates-use: needs a dominator computation plus param /
//     global / phi exemptions; high cost, redundant here.

// IR-verifier violation codes.  Each names a way a FINALIZED basic block
// can be structurally malformed; VerifyFunc reports the code of each
// defect it finds so callers/tests can match on a stable value rather
// than prose.  These catch the "ctx.CurBlock desync" bug class, where
// IR-gen emits instructions into an already-terminated block (producing a
// second terminator, or a non-terminator after the terminator) and
// silently drops the displaced stores/statements.
const (
	VERR_EMPTY_BLOCK int = 1      // block has no instructions
	VERR_MISSING_TERM int = 2     // block has no terminator
	VERR_TWO_TERMS int = 3        // block has more than one terminator
	VERR_INSTR_AFTER_TERM int = 4 // a non-terminator follows the terminator
	VERR_BAD_SUCCESSOR int = 5    // a successor is not a block of this func
	VERR_NIL_SUCCESSOR int = 6    // a jump/branch is missing a target/cond
	VERR_BAD_PHI_PRED int = 7     // a phi's predecessor is not a block of this func
	VERR_PHI_VAL_UNOWNED int = 8  // a phi's operand is owned by nothing in its func
)

// addViolation appends one IRViolation to vs and returns the grown slice.
func addViolation(vs @[]ir.IRViolation, fname @[]char, bi int, blabel @[]char, ii int, code int,
		msg @[]char) @[]ir.IRViolation {
	var v ir.IRViolation
	v.FuncName = fname
	v.BlockIndex = bi
	v.BlockLabel = blabel
	v.InstrIndex = ii
	v.Code = code
	v.Msg = msg
	return slices.Append[ir.IRViolation](vs, v)
}

// checkSuccessors validates the successor shape of a block's terminator:
// OP_JUMP needs a single in-func target; OP_BRANCH needs a cond arg and
// two in-func targets; OP_RETURN / OP_UNREACHABLE have no successor
// obligation.
func checkSuccessors(vs @[]ir.IRViolation, f @ir.Func, bi int, blabel @[]char,
		term @ir.Instr) @[]ir.IRViolation {
	if term.Op == iropcode.OP_JUMP {
		if term.Block1 == nil {
			return addViolation(vs, f.Name, bi, blabel, -1, VERR_NIL_SUCCESSOR, "jump has nil target")
		}
		if ir.BlockIndexIn(f, term.Block1) < 0 {
			return addViolation(vs, f.Name, bi, blabel, -1, VERR_BAD_SUCCESSOR,
					"jump target not in this func")
		}
		return vs
	}
	if term.Op == iropcode.OP_BRANCH {
		if len(term.Args) < 1 {
			vs = addViolation(vs, f.Name, bi, blabel, -1, VERR_NIL_SUCCESSOR, "branch missing cond")
		}
		if term.Block1 == nil || term.Block2 == nil {
			return addViolation(vs, f.Name, bi, blabel, -1, VERR_NIL_SUCCESSOR, "branch has nil then/else")
		}
		if ir.BlockIndexIn(f, term.Block1) < 0 {
			vs = addViolation(vs, f.Name, bi, blabel, -1, VERR_BAD_SUCCESSOR,
					"branch then-target not in this func")
		}
		if ir.BlockIndexIn(f, term.Block2) < 0 {
			vs = addViolation(vs, f.Name, bi, blabel, -1, VERR_BAD_SUCCESSOR,
					"branch else-target not in this func")
		}
		return vs
	}
	// OP_RETURN / OP_UNREACHABLE: no successor obligation.
	return vs
}

// VerifyFunc returns the structural IR defects in f (empty == well-formed).
func verifyFunc(f @ir.Func) @[]ir.IRViolation {
	var vs @[]ir.IRViolation
	if f.IsExtern {
		return vs
	}
	for i := 0; i < len(f.Blocks); i++ {
		var b @ir.Block = f.Blocks[i]
		if len(b.Instrs) == 0 {
			vs = addViolation(vs, f.Name, i, b.Label, -1, VERR_EMPTY_BLOCK, "empty block")
			continue
		}
		// Count terminators; remember the last one's index.
		var termCount int = 0
		var lastTermIdx int = -1
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].IsTerminator() {
				termCount = termCount + 1
				lastTermIdx = j
			}
		}
		if termCount == 0 {
			vs = addViolation(vs, f.Name, i, b.Label, -1, VERR_MISSING_TERM, "block has no terminator")
			continue
		}
		if termCount > 1 {
			vs = addViolation(vs, f.Name, i, b.Label, lastTermIdx, VERR_TWO_TERMS,
					"block has more than one terminator")
		}
		if lastTermIdx != len(b.Instrs) - 1 {
			vs = addViolation(vs, f.Name, i, b.Label, lastTermIdx, VERR_INSTR_AFTER_TERM,
					"non-terminator instruction follows terminator")
		}
		vs = checkSuccessors(vs, f, i, b.Label, b.Instrs[lastTermIdx])
		vs = checkPhiPreds(vs, f, i, b)
	}
	return checkPhiOperandsOwned(vs, f)
}

// checkPhiPreds reports every phi entry of block b (index bi) whose
// predecessor is not a block of f.  Branch targets and phi predecessors are
// raw references (the function's block list owns every block), so one naming
// a block f no longer holds would dangle.
func checkPhiPreds(vs @[]ir.IRViolation, f @ir.Func, bi int, b @ir.Block) @[]ir.IRViolation {
	for j := 0; j < len(b.Instrs); j++ {
		var ins @ir.Instr = b.Instrs[j]
		for k := 0; k < len(ins.Phis); k++ {
			if ir.BlockIndexIn(f, ins.Phis[k].Block) < 0 {
				vs = addViolation(vs, f.Name, bi, b.Label, j, VERR_BAD_PHI_PRED,
						"phi predecessor not a block of this func")
			}
		}
	}
	return vs
}

// VerifyFuncOK reports whether f has zero structural defects.
func verifyFuncOK(f @ir.Func) bool {
	return len(verifyFunc(f)) == 0
}

// VerifyModule returns the structural IR defects across all funcs in m.
func VerifyModule(m @ir.Module) @[]ir.IRViolation {
	var all @[]ir.IRViolation
	for i := 0; i < len(m.Funcs); i++ {
		var vs @[]ir.IRViolation = verifyFunc(m.Funcs[i])
		for j := 0; j < len(vs); j++ {
			all = slices.Append[ir.IRViolation](all, vs[j])
		}
	}
	return all
}

// ============================================================
// genFunc debug assertion (off by default)
// ============================================================

// verifyIR gates the genFunc-finalization structural assertion.  Off by
// default so a normal compile pays nothing; drivers/CI opt in via
// SetVerifyIR.
var verifyIR bool = false

// SetVerifyIR toggles the post-genFunc structural verification assertion.
// When on, genFunc aborts the compile (with diagnostics) the moment it
// finalizes a malformed func — converting a silent IR-gen miscompile into
// a loud, located failure.  A process-global flag; off by default.
func SetVerifyIR(on bool) {
	verifyIR = on
}

// VerifyFuncOrAbort runs the structural verifier on a finalized func when
// verifyIR is on; on any violation it prints each and aborts the compile.
// A no-op when verifyIR is off (the default), so it is safe to call
// unconditionally at the end of genFunc.
func VerifyFuncOrAbort(f @ir.Func) {
	if !verifyIR {
		return
	}
	var vs @[]ir.IRViolation = verifyFunc(f)
	if len(vs) == 0 {
		return
	}
	fmt.Println("ir: structural verifier found malformed IR:")
	for i := 0; i < len(vs); i++ {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("  ")
		cb.Write(vs[i].FuncName)
		cb.Write(" [")
		cb.Write(vs[i].BlockLabel)
		cb.Write("]: ")
		cb.Write(vs[i].Msg)
		fmt.Println(buf.CopyStr(cb.String()))
	}
	os.Exit(1)
}
