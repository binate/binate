package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// An integer constant's value must be representable in its own type: a backend
// materializes the constant at that type's width, so a value outside the range
// is silently truncated by one backend, rejected by another, and — where the
// constant is dead — never noticed at all.  (A uint64 or int64 constant holds
// any int64 bit pattern; a uint64 value >= 2^63 is stored as its negative int64
// pattern.)

// checkConstsFit reports every OP_CONST_INT in f's blocks whose value does not
// fit its type (VERR_CONST_OUT_OF_RANGE).
func checkConstsFit(vs @[]ir.IRViolation, f @ir.Func) @[]ir.IRViolation {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_CONST_INT && !constFitsType(ins.IntVal, ins.Typ) {
				vs = addViolation(vs, f.Name, bi, b.Label, ii, VERR_CONST_OUT_OF_RANGE, constRangeMsg(ins))
			}
		}
	}
	return vs
}

// constFitsType reports whether v is representable in integer type t (named /
// alias / readonly wrappers peeled).  An untyped integer constant is judged as
// the target's signed `int`.  A type that is not an integer type is not
// judged here (true).
func constFitsType(v int64, t @types.Type) bool {
	var u @types.Type = ir.PeelToUnderlying(t)
	if u == nil { return true }
	var width int
	var signed bool
	if u.Kind == types.TYP_UNTYPED_INT {
		width = types.GetTarget().IntSize * 8
		signed = true
	} else if u.Kind == types.TYP_INT && u.Width > 0 {
		width = u.Width
		signed = u.Signed
	} else {
		return true
	}
	if width >= 64 { return true }
	var one int64 = 1
	if signed {
		var half int64 = one << cast(uint, width - 1)
		return v >= -half && v < half
	}
	return v >= 0 && v < (one << cast(uint, width))
}

// constRangeMsg describes an out-of-range integer constant: its value and type.
func constRangeMsg(ins @ir.Instr) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("integer constant ")
	stringutils.WriteInt64(sb, ins.IntVal)
	sb.Write(" does not fit its type ")
	if ins.Typ == nil {
		sb.Write("<nil>")
	} else {
		sb.Write(ins.Typ.TypeName())
	}
	return buf.CopyStr(sb.String())
}
