package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the integer-constant range check (verify_const.bn).

// constFuncWith returns a func whose entry block holds one OP_CONST_INT of
// value v and type t, then returns.
func constFuncWith(v int64, t @types.Type) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	_ = EmitConstInt64(entry, v, t)
	EmitReturn(entry, noArgs)
	return f
}

// Each width's range ends fit and the values one past them do not, for both
// signednesses; 64-bit types accept any int64 (a uint64 >= 2^63 is stored as
// its negative bit pattern).
func TestConstFitsTypeRangeEnds() testing.TestResult {
	var one int64 = 1
	var negOne int64 = cast(int64, 0) - one
	if !constFitsType(cast(int64, -128), types.TypInt8()) { return fail("int8 must accept -128") }
	if !constFitsType(cast(int64, 127), types.TypInt8()) { return fail("int8 must accept 127") }
	if constFitsType(cast(int64, -129), types.TypInt8()) { return fail("int8 must reject -129") }
	if constFitsType(cast(int64, 128), types.TypInt8()) { return fail("int8 must reject 128") }
	if !constFitsType(cast(int64, 0), types.TypUint8()) { return fail("uint8 must accept 0") }
	if !constFitsType(cast(int64, 255), types.TypUint8()) { return fail("uint8 must accept 255") }
	if constFitsType(cast(int64, 256), types.TypUint8()) { return fail("uint8 must reject 256") }
	if constFitsType(negOne, types.TypUint8()) {
		return fail("uint8 must reject -1 (its all-ones value is 255, not -1)")
	}
	if !constFitsType(cast(int64, 4294967295), types.TypUint32()) {
		return fail("uint32 must accept 2^32-1")
	}
	if constFitsType(negOne, types.TypUint32()) { return fail("uint32 must reject -1") }
	if !constFitsType(cast(int64, -2147483648), types.TypInt32()) {
		return fail("int32 must accept -2^31")
	}
	if constFitsType(cast(int64, 2147483648), types.TypInt32()) {
		return fail("int32 must reject 2^31")
	}
	if !constFitsType(negOne, types.TypUint64()) {
		return fail("uint64 must accept any int64 bit pattern")
	}
	return ""
}

// Named, alias and readonly wrappers are peeled to the integer type they wrap;
// a non-integer type is not judged.
func TestConstFitsTypePeelsWrappers() testing.TestResult {
	var ro @types.Type = types.MakeReadonlyType(types.TypUint8())
	if !constFitsType(cast(int64, 255), ro) || constFitsType(cast(int64, 256), ro) {
		return fail("readonly uint8 must be judged as uint8")
	}
	var al @types.Type = types.MakeAliasType("A", types.TypInt8())
	if constFitsType(cast(int64, 200), al) {
		return fail("an alias of int8 must be judged as int8")
	}
	if !constFitsType(cast(int64, 12345), types.TypBool()) {
		return fail("a non-integer type is not judged")
	}
	return ""
}

// An untyped constant is judged as the target's signed int.
func TestConstFitsTypeUntypedIsTargetInt() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
	var fits32 bool = constFitsType(cast(int64, 2147483647), types.TypUntypedInt())
	var over32 bool = constFitsType(cast(int64, 2147483648), types.TypUntypedInt())
	types.SetTarget(saved)
	if !fits32 { return fail("an untyped 2^31-1 fits a 32-bit int") }
	if over32 { return fail("an untyped 2^31 does not fit a 32-bit int") }
	return ""
}

// verifyFunc reports an out-of-range constant with VERR_CONST_OUT_OF_RANGE,
// naming the value and type, and accepts an in-range one.
func TestVerifyConstOutOfRange() testing.TestResult {
	var vs @[]ir.IRViolation = verifyFunc(constFuncWith(cast(int64, 256), types.TypUint8()))
	if !hasCode(vs, VERR_CONST_OUT_OF_RANGE) {
		return fail("a uint8 constant 256 must report VERR_CONST_OUT_OF_RANGE")
	}
	var want *[]readonly char = "integer constant 256 does not fit its type uint8"
	var got bool = false
	for i := 0; i < len(vs); i++ {
		if vs[i].Code == VERR_CONST_OUT_OF_RANGE && len(vs[i].Msg) == len(want) {
			got = true
			for k := 0; k < len(want); k++ {
				if vs[i].Msg[k] != want[k] { got = false }
			}
		}
	}
	if !got { return fail("the violation must name the value and the type") }
	if len(verifyFunc(constFuncWith(cast(int64, 255), types.TypUint8()))) != 0 {
		return fail("a uint8 constant 255 must verify clean")
	}
	return ""
}
