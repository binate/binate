package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/cmp"
import "pkg/std/table"

// A phi's operands are not owning (ir.PhiEntry.Val), so each must be owned by
// something that lives as long as the function: an instruction in one of its
// blocks, one of its parameter refs (f.ParamRefs), or a global-address pseudo of
// its module (f.Mod.GlobalRefs).  An operand owned by none of these is freed
// while the phi still names it.

// checkPhiOperandsOwned reports every operand of a phi in f's blocks that is
// not owned by one of them (VERR_PHI_VAL_UNOWNED).
func checkPhiOperandsOwned(vs @[]ir.IRViolation, f @ir.Func) @[]ir.IRViolation {
	if !hasPhi(f) {
		return vs
	}
	var owned @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, bool,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	addBlockInstrs(owned, f.Blocks)
	addBlockInstrs(owned, f.FaultPads)
	if f.ParamRefs != nil {
		addInstrs(owned, f.ParamRefs.Items())
	}
	if f.Mod != nil && f.Mod.GlobalRefs != nil {
		addInstrs(owned, f.Mod.GlobalRefs.Items())
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for j := 0; j < len(b.Instrs); j++ {
			var ins @ir.Instr = b.Instrs[j]
			for k := 0; k < len(ins.Phis); k++ {
				var v *ir.Instr = ins.Phis[k].Val
				if v != nil && !owned.Has(bit_cast(int, v)) {
					vs = addViolation(vs, f.Name, bi, b.Label, j, VERR_PHI_VAL_UNOWNED,
							"phi operand owned by no block, param ref or global ref")
				}
			}
		}
	}
	return vs
}

// hasPhi reports whether any block of f holds an OP_PHI.
func hasPhi(f @ir.Func) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == iropcode.OP_PHI {
				return true
			}
		}
	}
	return false
}

// addBlockInstrs adds every instruction of blocks to owned.
func addBlockInstrs(owned @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]],
		blocks @[]@ir.Block) {
	for bi := 0; bi < len(blocks); bi++ {
		addInstrs(owned, blocks[bi].Instrs)
	}
}

// addInstrs adds each instruction of instrs to owned.
func addInstrs(owned @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]],
		instrs *[]@ir.Instr) {
	for i := 0; i < len(instrs); i++ {
		owned.Put(bit_cast(int, instrs[i]), true)
	}
}
