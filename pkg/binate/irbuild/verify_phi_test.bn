package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the phi-operand ownership check (verify_phi.bn).  hasCode, noArgs
// and noResults live in the package's other test files.

// A phi operand must be owned by something the function keeps alive (a block's
// instruction, a param ref, a global ref), since the phi does not own it.
func TestVerifyPhiOperandOwnership() testing.TestResult {
	var m @ir.Module = ir.NewModule("t")
	var p @ir.Param = make(ir.Param)
	p.Name = "p"
	p.Typ = types.TypInt()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = p
	var f @ir.Func = ir.NewFunc("", "test", params, noResults)
	f.Mod = m
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var other @ir.Block = ir.AddBlock(f, "other")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	EmitBranch(entry, EmitConstBool(entry, true), other, merge)
	EmitJump(other, merge)
	var pref @ir.Instr = ir.NewParamRef(f, p)
	var gref @ir.Instr = ir.NewGlobalRef(m, "g", types.TypInt())
	var entries @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	entries[0].Block = entry
	entries[0].Val = pref
	entries[1].Block = other
	entries[1].Val = gref
	EmitPhi(merge, types.TypInt(), entries)
	EmitReturn(merge, noArgs)
	if len(verifyFunc(f)) != 0 {
		return fail("param-ref and global-ref phi operands are owned")
	}
	// An operand owned by nothing: a fresh instruction in no block.
	var loose @ir.Instr = ir.NewInstr(f, iropcode.OP_CONST_INT, types.TypInt())
	merge.Instrs[0].Phis[1].Val = loose
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_PHI_VAL_UNOWNED) || len(vs) != 1 {
		return fail("expected exactly VERR_PHI_VAL_UNOWNED for an operand in no block")
	}
	return ""
}
