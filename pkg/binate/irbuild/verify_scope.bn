package "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// A scope id (ir.Instr.Scope) tells a backend when an alloca's storage ends, so
// one that names no scope of the function, or a scope end with nothing to end,
// would let a backend share bytes that are still in use -- or never free them.

// checkScopes reports every instruction in f's blocks and fault pads whose Scope
// is not valid for its op (VERR_BAD_SCOPE): an OP_ALLOC's must be 0 (the whole
// function) or one of f's scopes (1..f.NumScopes), and 0 for a parameter's slot,
// which lives for the whole call; an OP_SCOPE_END's must be one of f's scopes, and
// it takes no operands and makes no value; any other op's must be 0.
func checkScopes(vs @[]IRViolation, f @ir.Func) @[]IRViolation {
	vs = checkBlocksScopes(vs, f, f.Blocks)
	return checkBlocksScopes(vs, f, f.FaultPads)
}

// checkBlocksScopes is checkScopes over one list of f's blocks.
func checkBlocksScopes(vs @[]IRViolation, f @ir.Func, blocks *[]@ir.Block) @[]IRViolation {
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			var msg @[]char = scopeError(f, ins)
			if len(msg) > 0 {
				vs = addViolation(vs, f.Name, bi, b.Label, ii, VERR_BAD_SCOPE, msg)
			}
		}
	}
	return vs
}

// scopeError describes what is wrong with ins's Scope in f, or is empty.
func scopeError(f @ir.Func, ins @ir.Instr) @[]char {
	if ins.Op == iropcode.OP_SCOPE_END {
		if ins.Scope < 1 || ins.Scope > f.NumScopes {
			return scopeRangeMsg("scope end names scope ", ins.Scope, f)
		}
		if len(ins.Args) > 0 || ins.ID >= 0 {
			return buf.CopyStr("scope end has operands or a value")
		}
		var none @[]char
		return none
	}
	if ins.Op == iropcode.OP_ALLOC {
		if ins.Scope < 0 || ins.Scope > f.NumScopes {
			return scopeRangeMsg("alloca names scope ", ins.Scope, f)
		}
		if ins.ParamIndex > 0 && ins.Scope != 0 {
			return buf.CopyStr("a parameter's slot carries a scope, but lives for the whole call")
		}
		var none @[]char
		return none
	}
	if ins.Scope != 0 {
		var sb @strings.Builder = strings.NewBuilder()
		sb.Write(iropcode.OpName(ins.Op))
		sb.Write(" carries scope ")
		stringutils.WriteInt64(sb, cast(int64, ins.Scope))
		sb.Write(", but only an alloca or a scope end takes one")
		return buf.CopyStr(sb.String())
	}
	var none @[]char
	return none
}

// scopeRangeMsg describes a scope id outside f's: what names it, the id and f's count.
func scopeRangeMsg(what *[]readonly char, scope int, f @ir.Func) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(what)
	stringutils.WriteInt64(sb, cast(int64, scope))
	sb.Write(", but the function has ")
	stringutils.WriteInt64(sb, cast(int64, f.NumScopes))
	sb.Write(" scopes")
	return buf.CopyStr(sb.String())
}
