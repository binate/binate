package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the scope-id check (verify_scope.bn).

// scopeFunc returns a func with two scopes whose entry block holds an int alloca
// in scope allocScope, the end of scope endScope, then a return.
func scopeFunc(allocScope int, endScope int) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	_ = NewScope(f)
	_ = NewScope(f)
	var a @ir.Instr = EmitAlloc(entry, types.TypInt())
	a.Scope = allocScope
	EmitScopeEnd(entry, endScope)
	EmitReturn(entry, noArgs)
	return f
}

// scopeMsg returns the message of vs's first VERR_BAD_SCOPE, or an empty one.
func scopeMsg(vs @[]IRViolation) @[]char {
	for i := 0; i < len(vs); i++ {
		if vs[i].Code == VERR_BAD_SCOPE { return vs[i].Msg }
	}
	var none @[]char
	return none
}

// The function's own scope ids pass, and so does an alloca with no scope (0).
func TestVerifyScopesAccept() testing.TestResult {
	if len(verifyFunc(scopeFunc(1, 1))) != 0 { return fail("scope 1 of 2 must pass") }
	if len(verifyFunc(scopeFunc(0, 2))) != 0 { return fail("an alloca without a scope must pass") }
	return ""
}

// An id outside 1..NumScopes -- 0 too, on a scope end -- reports VERR_BAD_SCOPE,
// naming the id and the function's count.
func TestVerifyScopesOutOfRange() testing.TestResult {
	if !hasCode(verifyFunc(scopeFunc(3, 1)), VERR_BAD_SCOPE) {
		return fail("an alloca in scope 3 of 2")
	}
	if !hasCode(verifyFunc(scopeFunc(-1, 1)), VERR_BAD_SCOPE) { return fail("an alloca in scope -1") }
	if !hasCode(verifyFunc(scopeFunc(1, 0)), VERR_BAD_SCOPE) { return fail("the end of scope 0") }
	if !hasCode(verifyFunc(scopeFunc(1, 3)), VERR_BAD_SCOPE) { return fail("the end of scope 3 of 2") }
	var want *[]readonly char = "scope end names scope 3, but the function has 2 scopes"
	var got @[]char = scopeMsg(verifyFunc(scopeFunc(1, 3)))
	if len(got) != len(want) { return fail("the message names the id and the count") }
	for i := 0; i < len(want); i++ {
		if got[i] != want[i] { return fail("the message names the id and the count") }
	}
	return ""
}

// A scope end with an operand or a value, a scope on another op, and a bad id in a
// fault pad each report VERR_BAD_SCOPE.
func TestVerifyScopesShape() testing.TestResult {
	var f @ir.Func = scopeFunc(1, 1)
	var end @ir.Instr = f.Blocks[0].Instrs[1]
	end.Args = slices.Append[@ir.Instr](end.Args, f.Blocks[0].Instrs[0])
	if !hasCode(verifyFunc(f), VERR_BAD_SCOPE) { return fail("a scope end with an operand") }
	f = scopeFunc(1, 1)
	f.Blocks[0].Instrs[1].ID = 5
	if !hasCode(verifyFunc(f), VERR_BAD_SCOPE) { return fail("a scope end with a value") }
	f = scopeFunc(1, 1)
	f.Blocks[0].Instrs[2].Scope = 1
	if !hasCode(verifyFunc(f), VERR_BAD_SCOPE) { return fail("a return carrying a scope") }
	f = scopeFunc(1, 1)
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	EmitScopeEnd(pad, 5)
	EmitUnwindReturn(pad)
	if !hasCode(verifyFunc(f), VERR_BAD_SCOPE) { return fail("a fault pad's end of scope 5 of 2") }
	f = scopeFunc(1, 1)
	f.Blocks[0].Instrs[0].ParamIndex = 1
	if !hasCode(verifyFunc(f), VERR_BAD_SCOPE) { return fail("a parameter's slot carrying a scope") }
	f = scopeFunc(0, 1)
	f.Blocks[0].Instrs[0].ParamIndex = 1
	if len(verifyFunc(f)) != 0 { return fail("a parameter's slot without a scope must pass") }
	return ""
}
