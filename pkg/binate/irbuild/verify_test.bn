package "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the structural IR verifier (verify.bn).  Hand-built malformed
// funcs assert specific VERR_* codes (including the two known bug shapes);
// clean hand-built and gen-from-source funcs assert zero violations
// (notably switch/if shapes that leave benign orphaned blocks — these must
// NOT be flagged, since the verifier deliberately omits reachability).

// hasCode reports whether any violation carries the given code.
func hasCode(vs @[]ir.IRViolation, code int) bool {
	for i := 0; i < len(vs); i++ {
		if vs[i].Code == code {
			return true
		}
	}
	return false
}

// --- malformed IR: positive cases (assert the code fires) ---

// Two terminators in one block — the genExprOrFuncRef (634) shape.
func TestVerifyTwoTerminators() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	EmitReturn(entry, noArgs) // terminator #1
	EmitAlloc(entry, types.TypInt()) // non-terminator between
	EmitReturn(entry, noArgs) // terminator #2
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_TWO_TERMS) {
		return fail("expected VERR_TWO_TERMS for two terminators")
	}
	return ""
}

// A non-terminator emitted after the terminator — the genMultiAssign (641)
// silent-drop shape.
func TestVerifyInstrAfterTerminator() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var target @ir.Block = ir.AddBlock(f, "target")
	EmitReturn(target, noArgs)
	EmitJump(entry, target) // single terminator...
	EmitAlloc(entry, types.TypInt()) // ...with an instr appended after it
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_INSTR_AFTER_TERM) {
		return fail("expected VERR_INSTR_AFTER_TERM for instr after terminator")
	}
	if hasCode(vs, VERR_TWO_TERMS) {
		return fail("single terminator must not report VERR_TWO_TERMS")
	}
	return ""
}

// A block with no terminator at all.
func TestVerifyMissingTerminator() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	EmitAlloc(entry, types.TypInt()) // only a non-terminator
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_MISSING_TERM) {
		return fail("expected VERR_MISSING_TERM for unterminated block")
	}
	return ""
}

// A block with no instructions.
func TestVerifyEmptyBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	EmitReturn(entry, noArgs)
	ir.AddBlock(f, "stranded") // never emitted into
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_EMPTY_BLOCK) {
		return fail("expected VERR_EMPTY_BLOCK for empty block")
	}
	return ""
}

// A jump whose target belongs to a different func.
func TestVerifyBadSuccessor() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var other @ir.Func = ir.NewFunc("", "other", noParams, noResults)
	var foreign @ir.Block = ir.AddBlock(other, "foreign")
	EmitReturn(foreign, noArgs)
	EmitJump(entry, foreign) // target not in f.Blocks
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_BAD_SUCCESSOR) {
		return fail("expected VERR_BAD_SUCCESSOR for foreign jump target")
	}
	return ""
}

// A jump with a nil target (hand-built, since EmitJump always sets one).
func TestVerifyNilSuccessor() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var jmp @ir.Instr = ir.NewVoidInstr(iropcode.OP_JUMP) // Block1 stays nil
	addInstr(entry, jmp)
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_NIL_SUCCESSOR) {
		return fail("expected VERR_NIL_SUCCESSOR for nil jump target")
	}
	return ""
}

// --- clean IR: negative cases (assert no violations) ---

func TestVerifyAcceptsReturn() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	EmitReturn(entry, noArgs)
	if !verifyFuncOK(f) {
		return fail("single-return func should verify clean")
	}
	return ""
}

func TestVerifyAcceptsBranch() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var cond @ir.Instr = EmitConstInt(entry, 1, types.TypInt())
	EmitBranch(entry, cond, thenB, elseB)
	EmitReturn(thenB, noArgs)
	EmitReturn(elseB, noArgs)
	if !verifyFuncOK(f) {
		return fail("branch to two terminated in-func blocks should verify clean")
	}
	return ""
}

// A block ending in unreachable/panic has no successor obligation.
func TestVerifyAcceptsUnreachableAndPanic() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	EmitUnreachable(entry)
	if !verifyFuncOK(f) {
		return fail("block ending in unreachable should verify clean")
	}
	return ""
}

// An extern (bodyless) func has no blocks and must verify clean.
func TestVerifyAcceptsExtern() testing.TestResult {
	var f @ir.Func = ir.NewExternFunc("", "ext", noParams, noResults)
	var vs @[]ir.IRViolation = verifyFunc(f)
	if len(vs) != 0 {
		return fail("extern func should produce no violations")
	}
	return ""
}

// --- gen-from-source: the generated IR must verify clean ---

// A phi whose predecessor is a block of another function: phi predecessors,
// like branch targets, are raw references the function's block list must own.
func TestVerifyPhiPredOutsideFunc() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var other @ir.Func = ir.NewFunc("", "other", noParams, noResults)
	var foreign @ir.Block = ir.AddBlock(other, "foreign")
	EmitReturn(foreign, noArgs)
	var one @ir.Instr = EmitConstInt(entry, 1, types.TypInt())
	EmitJump(entry, merge)
	var entries @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	entries[0].Block = entry
	entries[0].Val = one
	entries[1].Block = foreign
	entries[1].Val = one
	EmitPhi(merge, types.TypInt(), entries)
	EmitReturn(merge, noArgs)
	var vs @[]ir.IRViolation = verifyFunc(f)
	if !hasCode(vs, VERR_BAD_PHI_PRED) {
		return fail("expected VERR_BAD_PHI_PRED for a foreign phi predecessor")
	}
	if len(vs) != 1 {
		return fail("only the foreign predecessor is a defect")
	}
	return ""
}
