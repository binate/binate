// Package irdata is the backend-neutral static-data manifest: the DataGlobal /
// DataTerm description of a named static blob plus the Build* functions that lay
// each kind of static record (string constants, package globals, impl vtables,
// the reflect package descriptor, and the per-type / per-interface / per-(T,J)
// RTTI records).  Both compiler backends lower a DataGlobal through one
// emitDataGlobal, so each byte layout is described once and cannot drift.  It is
// a leaf package (no @Module dependency); the Collect* passes that walk a module
// to decide which records to emit live in pkg/binate/ir, which imports this.
package "pkg/binate/irdata"

// ============================================================
// Static data manifest (DataGlobal) + reflect/RTTI record builders
// ============================================================
//
// A backend-neutral description of one named static blob (DataGlobal) plus the
// Build* functions that lay each kind of static record (string constants,
// package globals, impl vtables, the __Package reflect descriptor, and the
// per-type / per-interface / per-(T,J) RTTI records).  Both the LLVM and native
// backends lower a DataGlobal through a single emitDataGlobal, so each byte
// layout is described ONCE and cannot drift between backends.  This leaf package
// is deliberately @Module-free — the Collect* passes that WALK a module to
// decide which records to emit stay in pkg/binate/ir (which imports this).
// See plan-codegen-data-global.md / todo #119.

// DataTerm kinds — which payload field of a DataTerm is meaningful.
const (
	DT_BYTES int = 0  // raw bytes (Bytes)
	DT_INT int = 1    // fixed-width little-endian integer (Width bytes, IntVal)
	DT_SYMREF int = 2 // pointer to another symbol Sym (+ Addend); empty Sym = null
	DT_ZERO int = 3   // Width zero bytes (padding / uninitialized)
)

// DataGlobal linkage kinds — mapped to each backend's spelling by
// emitDataGlobal (LLVM linkage keyword / native symbol binding).
const (
	DG_WEAK int = 0   // LLVM weak_odr  / native weak  — ODR-dedup across TUs
	DG_LOCAL int = 1  // LLVM private   / native local — TU-private
	DG_GLOBAL int = 2 // LLVM (external def) / native global — strong
)

// DataTerm is one element of a DataGlobal's contiguous initializer.
// Exactly one payload field is meaningful, selected by Kind.
type DataTerm struct {
	Kind   int
	Bytes  @[]uint8 // DT_BYTES
	Width  int // DT_INT: byte width (1/2/4/8) ; DT_ZERO: byte count
	IntVal uint64 // DT_INT: value (bit_cast a signed value in)
	Sym    @[]char // DT_SYMREF: target symbol (already mangled)
	Addend int // DT_SYMREF: addend added to the resolved address
}

// DataGlobal is a backend-neutral named static blob: an Init sequence of
// terms laid out contiguously, with linkage + alignment + a read-only
// (rodata/constant vs data/mutable) hint.
type DataGlobal struct {
	Name        @[]char
	Linkage     int // DG_*
	Align       int // byte alignment (>= 1)
	ReadOnly    bool // true -> rodata / LLVM `constant`
	UnnamedAddr bool // true -> LLVM `unnamed_addr` (address not significant;
	// lets LLVM merge identical constants).  Native: no-op.
	Init @[]@DataTerm
}

// DataBytes / DataInt / DataSymref / DataZero construct the four DataTerm
// kinds; NewDataGlobal makes a DataGlobal with an empty Init (append terms
// via slices.Append).  See irdata/data_global.bn.
func DataBytes(bytes @[]uint8) @DataTerm

func DataInt(width int, val uint64) @DataTerm

func DataSymref(sym @[]char, addend int) @DataTerm

func DataZero(n int) @DataTerm

func NewDataGlobal(name @[]char, linkage int, align int, ro bool) @DataGlobal

// BuildFuncValue builds the [vtable, handle] DataGlobal pair for one function
// value: `@__vt` = { dtor, call } and `@__handle` = { vtable, data=null }, both
// weak.  The gather supplies the symbol names + the call target (shim, or the
// function itself for a universal trampoline) + the closure-struct dtor handle
// (dtorSym empty -> null dtor slot).  See irdata/data_funcval.bn.
func BuildFuncValue(vtSym @[]char, dtorSym @[]char, callSym @[]char,
		handleSym @[]char) @[]@DataGlobal

// BuildImplVtable builds one interface-impl vtable (`@__ivt` raw or
// `@__ivtshim` shim) from its ordered slot symbols (empty entry -> null slot),
// weak.  The gather walks the iface hierarchy to produce the slots.  See
// irdata/data_impl_vtable.bn.
func BuildImplVtable(vtSym @[]char, slots @[]@[]char) @DataGlobal

// TypeInfoDesc is one per-type RTTI record to emit: its symbol, the scalar
// layout known at codegen (size/align), and the dtor.  DtorFuncName is the
// backend-neutral input (the receiver type's qualified dtor name, or empty for
// a type that needs none); each backend resolves it into DtorSym — the record's
// word-0 destructor-handle slot symbol — via the SAME helper it uses for the
// vtable any-block slot 0, so the record's dtor word is byte-identical to that
// slot.  Name is the type's canonical name (words 3–4).
type TypeInfoDesc struct {
	Sym   @[]char
	Size  int
	Align int
	// DtorFuncName: the receiver type's qualified dtor name (a per-type fact),
	// carried from the first ImplInfo of each type; empty when the type needs
	// no destruction.  Backends convert it to DtorSym (gated on the dtor being
	// present in the module, exactly like the vtable slot-0 dtor).
	DtorFuncName @[]char
	// DtorSym: the resolved, object-format-prefixed word-0 destructor-handle
	// slot symbol (LLVM `@__handle.<dtor>` / native `<pfx>__handle.<dtor>`), or
	// empty for a null slot.  Set by each backend from DtorFuncName before
	// BuildTypeInfo (like Sym), never by CollectTypeInfoDescs.
	DtorSym @[]char
	// Name: the type's canonical QualifiedTypeName, baked into the record's name
	// blob and pointed at by words 3–4 (pointer, length).  A per-type fact read
	// off the held RecvTyp at codegen (like Size/Align).  Empty → a null name.
	Name @[]char
	// NameSym: the symbol of the TU-local name blob
	// (`mangle.TypeInfoNameBlobName`).  Handled exactly like Sym:
	// CollectTypeInfoDescs sets the neutral form; LLVM uses it raw, native
	// prefixes it (object format) into the pd it builds.
	NameSym @[]char
}

// BuildTypeInfo builds the DataGlobals for the static per-type RTTI record
// `desc` (`__typeinfo.<T>`, weak) — the record itself PLUS its TU-local name
// blob when desc.Name is non-empty.  Returns them as an ordered list ([record,
// name-blob]) the backend lowers through its own emitDataGlobal, mirroring
// BuildPackageDescriptors.  Fixed 5-word record layout (spec §7.13.14).  See
// irdata/data_typeinfo.bn; the per-module gather is ir.CollectTypeInfoDescs.
func BuildTypeInfo(desc @TypeInfoDesc) @[]@DataGlobal

// BuildIfaceId builds the weak, read-only 1-byte per-interface identity marker
// named `sym` (mangle.IfaceIdName); only its address is meaningful (spec
// §11.12 `iface.rtti`).  See irdata/data_ifaceid.bn; the per-module gather is
// ir.CollectIfaceIdSyms.
func BuildIfaceId(sym @[]char) @DataGlobal

// SatEntryDesc is one per-`(T, J)` satisfaction entry to emit: its own weak
// symbol plus the three pointers it records — `&TypeInfo(T)`, `&IfaceId(J)`,
// and `&__ivt.<T>__<J>` (the sub-vtable, at offset 0).  All neutral; each
// backend prefixes them (object format) like Sym.  See irdata/data_satentry.bn.
type SatEntryDesc struct {
	Sym         @[]char
	TypeInfoSym @[]char
	IfaceIdSym  @[]char
	SubvtabSym  @[]char
}

// BuildSatEntry builds the weak per-`(T, J)` satisfaction-entry NODE
// (`__satentry.<T,J>`): a 2-word static-managed header (`refcount` sentinel) then
// the `{&TypeInfo, &IfaceId, &sub-vtable}` payload — a reflect.SatEntryInfo the
// per-package descriptor's SatEntries table lists.  See irdata/data_satentry.bn;
// the per-module gather is ir.CollectSatEntries.
func BuildSatEntry(refcount int, desc @SatEntryDesc) @DataGlobal

// SatRootEntry names one package whose `_pkg_satentries` backing array the
// whole-program SatEntry root must reference — its package path (the
// GlobalName input, e.g. "pkg/geom" or "main"), the number of `__satentry`
// nodes in that array (Count, so the reader knows the sub-array length: a
// `_pkg_satentries` array carries no length prefix), and IsOwn (true only for
// the main module's own package, whose `_pkg_satentries` is defined in the same
// object as the root, so no cross-TU extern declaration is needed for it).
// Gathered from `ldr.Order ∪ main` at the native-codegen drivers (M1) — see
// ir.Module.EmitSatEntryRoot and BuildSatEntryRoot.
type SatRootEntry struct {
	PkgPath @[]char
	Count   int
	IsOwn   bool
}

// BuildSatEntryRoot builds the whole-program SatEntry root — the compiler-
// synthesized `{ptr,len}[]` array that hands the Phase-5 reader a BOUNDED
// enumerable set of every package's `__satentry` nodes (retention is a bonus;
// the real job is bounding the scan — plan-type-assertions-execution.md §U.2a).
// Returns, in order: the `pairs` array (one `{&<pkg>._pkg_satentries, count}`
// pair per gathered package, DG_LOCAL — referenced only by the header, same TU)
// followed by the `root` header (a raw-slice `{&pairs, N}`, DG_WEAK — the symbol
// `__entry` references via OP_DATA_SYM_ADDR so the whole chain survives dead-
// strip).  `pkgSatSyms[i]` is the FINAL (backend-prefixed) `_pkg_satentries`
// symbol for pair i and `counts[i]` its length; the two slices are parallel and
// index-aligned.  With N == 0 (no package has satentries) the pairs array is
// omitted and the header is the empty slice `{null, 0}` — still emitted, so the
// C1 unconditional-root invariant holds.
func BuildSatEntryRoot(rootSym @[]char, pairsSym @[]char, pkgSatSyms @[]@[]char,
		counts @[]int) @[]@DataGlobal

// BuildStringBlob builds the read-only byte blob (bare `[N x i8]`, no NUL,
// private unnamed_addr, align 1) for a string constant.  See irdata/data_strings.bn.
func BuildStringBlob(blobSym @[]char, data @[]char) @DataGlobal

// BuildStringMSHeader builds the static managed-slice `.ms` header { data, len,
// null refptr, backing_len=len } aliasing a string blob, with caller-chosen
// linkage (LLVM private / native weak).  See irdata/data_strings.bn.
func BuildStringMSHeader(msSym @[]char, blobSym @[]char, length int, linkage int) @DataGlobal

// BuildGlobalVar builds the DataGlobal for one package-level `var` (mutable,
// strong, `size` zero bytes, `align`).  See irdata/data_globalvar.bn.
func BuildGlobalVar(sym @[]char, size int, align int) @DataGlobal

// BuildPackageDescriptor builds the DataGlobals for the per-package
// reflect.Package descriptor node + its name bytes (the single source of
// truth for that layout; both backends lower the result via emitDataGlobal).
// See irdata/data_pkg_descriptor.bn.
func BuildPackageDescriptor(refcount int, infoSym @[]char, nameSym @[]char, nameBytes @[]uint8,
		funcsSym @[]char, funcCount int, globalsSym @[]char, globalCount int, vtablesSym @[]char,
		vtableCount int, satentriesSym @[]char, satEntryCount int) @[]@DataGlobal

// Per-package reflect-descriptor info-table entries.  Each backend's gather
// pass computes its own (format-prefixed) symbol names + the backend-neutral
// payload scalars for one table row, then BuildPackageDescriptors lays the
// row's rodata + static-managed node bytes ONCE — so the FunctionInfo /
// GlobalInfo / VtableInfo node layout cannot drift between backends.  All
// owned-slice fields must outlive the returned DataGlobals (the caller copies
// borrowed source strings in).

// PkgFuncEntry is one reflect.FunctionInfo row: the __fninfo node + __fnname /
// __fnsig rodata symbols, the fully-qualified Name + signature bytes, the
// @__handle.<mangled> function-value block (the Value target), and the
// precomputed VM-dispatch RetbufSize / ParamSlots.
type PkgFuncEntry struct {
	NodeSym    @[]char
	NameSym    @[]char
	Name       @[]char
	SigSym     @[]char
	Sig        @[]char
	HandleSym  @[]char
	RetbufSize int
	ParamSlots int
}

// PkgGlobalEntry is one reflect.GlobalInfo row: the __glinfo node + __glname
// rodata symbols, the fully-qualified Name bytes, and the global's storage
// cell symbol (the Addr target — a raw `var` cell, no managed header).
type PkgGlobalEntry struct {
	NodeSym    @[]char
	NameSym    @[]char
	Name       @[]char
	StorageSym @[]char
}

// PkgVtableEntry is one reflect.VtableInfo row: the __vtinfo node + __vtname
// rodata symbols, the bare vtable Name bytes (the VM's findIfaceVtable key),
// and the @__ivt / @__ivtshim vtable globals (the Addr / ShimAddr targets —
// raw constant arrays, no managed header).
type PkgVtableEntry struct {
	NodeSym   @[]char
	NameSym   @[]char
	Name      @[]char
	VtableSym @[]char
	ShimSym   @[]char
	// SlotCount is the @__ivt / @__ivtshim slot count (dtor + concat method set);
	// emitted as reflect.VtableInfo.SlotCount so the VM can bound each vtable's
	// extent for the offset>0 upcast shim range-lookup.
	SlotCount int
}

// NewPkgFuncEntry / NewPkgGlobalEntry / NewPkgVtableEntry construct an entry
// from its fields (so callers don't hand-assemble the struct).  See
// irdata/data_pkg_funcs.bn, irdata/data_pkg_globals.bn, irdata/data_pkg_vtables.bn.
func NewPkgFuncEntry(nodeSym @[]char, nameSym @[]char, name @[]char, sigSym @[]char, sig @[]char,
		handleSym @[]char, retbufSize int, paramSlots int) @PkgFuncEntry

func NewPkgGlobalEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
		storageSym @[]char) @PkgGlobalEntry

func NewPkgVtableEntry(nodeSym @[]char, nameSym @[]char, name @[]char, vtableSym @[]char,
		shimSym @[]char, slotCount int) @PkgVtableEntry

// BuildPackageDescriptors builds the FULL ordered DataGlobal list for a
// module's reflect.Package descriptor: per func/global/vtable entry its rodata
// + static-managed info node, then each table's backing pointer array, then
// the descriptor node + name bytes (BuildPackageDescriptor's pair) LAST.  The
// emission order matches the per-backend gather order, so the native object is
// byte-identical to the pre-DataGlobal layout (modulo symbol-name prefixes).
// The single source of truth for the whole descriptor's byte layout; both
// backends lower the result via emitDataGlobal.  See irdata/data_pkg_descriptor.bn.
func BuildPackageDescriptors(refcount int, infoSym @[]char, nameSym @[]char, nameBytes @[]char,
		funcsSym @[]char, funcs @[]@PkgFuncEntry, globalsSym @[]char, globals @[]@PkgGlobalEntry,
		vtablesSym @[]char, vtables @[]@PkgVtableEntry, satentriesSym @[]char,
		satEntrySyms @[]@[]char) @[]@DataGlobal
