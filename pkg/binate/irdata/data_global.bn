package "pkg/binate/irdata"

// Constructors for the static-data manifest (DataGlobal / DataTerm —
// declared in irdata.bni).  A DataGlobal is a backend-neutral named static blob
// that both the LLVM and native backends lower through one emitDataGlobal,
// so the byte layout lives in one place.

// DataBytes makes a raw-bytes term.
func DataBytes(bytes @[]uint8) @DataTerm {
	var t @DataTerm = make(DataTerm)
	t.Kind = DT_BYTES
	t.Bytes = bytes
	return t
}

// DataInt makes a fixed-width little-endian integer term.  width is the byte
// width (1/2/4/8); val holds the bits (bit_cast a signed value in).
func DataInt(width int, val uint64) @DataTerm {
	var t @DataTerm = make(DataTerm)
	t.Kind = DT_INT
	t.Width = width
	t.IntVal = val
	return t
}

// DataSymref makes a pointer-to-symbol term: a target-pointer-sized field
// that resolves to sym + addend.
func DataSymref(sym @[]char, addend int) @DataTerm {
	var t @DataTerm = make(DataTerm)
	t.Kind = DT_SYMREF
	t.Sym = sym
	t.Addend = addend
	return t
}

// DataZero makes an n-zero-bytes term (padding / uninitialized space).
func DataZero(n int) @DataTerm {
	var t @DataTerm = make(DataTerm)
	t.Kind = DT_ZERO
	t.Width = n
	return t
}

// NewDataGlobal makes a DataGlobal with the given name, linkage, alignment,
// and read-only flag, and an empty Init (the caller appends terms).
func NewDataGlobal(name @[]char, linkage int, align int, ro bool) @DataGlobal {
	var dg @DataGlobal = make(DataGlobal)
	dg.Name = name
	dg.Linkage = linkage
	dg.Align = align
	dg.ReadOnly = ro
	return dg
}
