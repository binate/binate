package "pkg/binate/irdata"

// Package-level global-variable storage as an DataGlobal.  A `var X T` at
// package scope is a mutable, strong (exported, cross-package-referenced) symbol
// whose STATIC initializer is just zero bytes — the real initializer (for
// `var X T = expr`) is applied at startup by the package's `__init` function
// (see ir/gen_init.bn), so the static blob only needs to be a valid zero of the
// right size.  An all-zero blob is the bit pattern of every type's zero (null /
// 0.0 / zeroinitializer / 0), so a single DT_ZERO covers them all.
//
// IsExtern globals (a `.bni`-declared `var X T` imported from another package)
// are NOT built here — they are a *declaration* of the owner's symbol, not a
// definition, so each backend emits its own extern decl / reference.

// BuildGlobalVar builds the DataGlobal for one package-level `var`: `size`
// zero bytes (the type's SizeOf), `align` = the type's AlignOf, strong + mutable.
func BuildGlobalVar(sym @[]char, size int, align int) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(sym, DG_GLOBAL, align, false)
	dg.Init = appendTerm(dg.Init, DataZero(size))
	return dg
}
