package "pkg/binate/irdata"

import "pkg/binate/types"

// Interface-impl vtable layout — the `@__ivt` (raw) / `@__ivtshim` (shim)
// constant pointer arrays for an `(R, I)` impl.  The single source of truth
// both backends lower through emitDataGlobal, so the slot byte layout cannot
// drift.  Each backend's recursive layout walk computes the ORDERED slot
// symbols (per iface level: the receiver's dtor HANDLE then, after parent
// levels, the level's own-method symbols — the raw fn symbol for `@__ivt`, the
// method's `@__handle` for `@__ivtshim`) and hands the list here; a backend
// resolves its own format-prefixed symbol names.
//
// A slot symbol is an addend-0 pointer to that fn / handle; an EMPTY slot is a
// null pointer (a dtor slot for a receiver with no managed fields, or a
// defensive missing-method slot).  weak (LLVM weak_odr / native weak) so the
// "any TU may declare the impl" duplicate emissions dedupe at link time.

// BuildImplVtable builds the impl-vtable DataGlobal for `vtSym` from its ordered
// slot symbols (empty entry -> null slot).
func BuildImplVtable(vtSym @[]char, slots @[]@[]char) @DataGlobal {
	var w int = types.GetTarget().IntSize
	var vt @DataGlobal = NewDataGlobal(vtSym, DG_WEAK, w, true)
	for i := 0; i < len(slots); i++ {
		vt.Init = appendTerm(vt.Init, DataSymref(slots[i], 0))
	}
	return vt
}
