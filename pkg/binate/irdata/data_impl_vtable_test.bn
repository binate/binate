package "pkg/binate/irdata"

import "pkg/builtins/testing"

// BuildImplVtable lays an impl vtable from its ordered slot symbols: a non-empty
// slot is an addend-0 symref to that fn / handle, an empty slot is a null
// pointer.  Weak.  pinTarget64 (data_pkg_descriptor_test.bn) fixes the word
// width.
func TestBuildImplVtable() testing.TestResult {
	pinTarget64()
	// [dtor handle, null (no slot), method].
	var slots @[]@[]char = make_slice(@[]char, 3)
	slots[0] = "_h_dtor"
	slots[2] = "_m_foo"
	var vt @DataGlobal = BuildImplVtable("_ivt", slots)

	if vt.Linkage != DG_WEAK { return "impl vtable should be weak" }
	if !vt.ReadOnly { return "impl vtable should be read-only" }
	if len(vt.Init) != 3 { return "expected one term per slot" }
	if vt.Init[0].Kind != DT_SYMREF || len(vt.Init[0].Sym) == 0 || vt.Init[0].Addend != 0 {
		return "slot 0 should symref the dtor handle (addend 0)"
	}
	if vt.Init[1].Kind != DT_SYMREF || len(vt.Init[1].Sym) != 0 {
		return "an empty slot should be a null symref"
	}
	if vt.Init[2].Kind != DT_SYMREF || len(vt.Init[2].Sym) == 0 {
		return "a method slot should symref the method fn / handle"
	}
	return ""
}
