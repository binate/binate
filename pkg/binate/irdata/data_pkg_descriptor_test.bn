package "pkg/binate/irdata"

import "pkg/binate/types"
import "pkg/builtins/testing"

// pinTarget64 fixes a 64-bit target so the descriptor's word terms are 8 bytes.
func pinTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// TestBuildPackageDescriptor pins the descriptor node + name DataGlobals:
// the 2-word header, the Name slice, a populated Functions slice (symref +
// count), an empty Globals slice (null symref + 0), and the linkage / term
// structure both backends lower.
func TestBuildPackageDescriptor() testing.TestResult {
	pinTarget64()
	var nameBytes @[]uint8 = make_slice(uint8, 4)
	nameBytes[0] = cast(uint8, 'm')
	nameBytes[1] = cast(uint8, 'a')
	nameBytes[2] = cast(uint8, 'i')
	nameBytes[3] = cast(uint8, 'n')

	var dgs @[]@DataGlobal = BuildPackageDescriptor(-1073741824, "_info", "_name", nameBytes, "_funcs",
			1, "_globals", 0, "_vtables", 0, "_satentries", 0, "_ifaceids", 2)
	if len(dgs) != 2 { return "expected [node, name]" }

	var node @DataGlobal = dgs[0]
	if node.Linkage != DG_WEAK { return "node should be weak" }
	if !node.ReadOnly { return "node should be read-only" }
	// header(2) + Name(2) + Functions(2) + Globals(2) + Vtables(2)
	// + SatEntries(2) + IfaceIds(2) = 14 terms.
	if len(node.Init) != 14 { return "node should have 14 terms" }
	if node.Init[0].Kind != DT_INT || node.Init[0].Width != 8 {
		return "term 0 should be the 8-byte refcount int"
	}
	if node.Init[2].Kind != DT_SYMREF || len(node.Init[2].Sym) == 0 {
		return "Name.data should be a symref to the name bytes"
	}
	if node.Init[3].Kind != DT_INT || node.Init[3].IntVal != cast(uint64, 4) {
		return "Name.len should be 4"
	}
	// Functions count 1 -> symref to _funcs + count.
	if node.Init[4].Kind != DT_SYMREF || len(node.Init[4].Sym) == 0 {
		return "Functions.data should be a symref to _funcs"
	}
	if node.Init[5].IntVal != cast(uint64, 1) { return "Functions.len should be 1" }
	// Globals count 0 -> null symref + 0.
	if node.Init[6].Kind != DT_SYMREF || len(node.Init[6].Sym) != 0 {
		return "empty Globals.data should be a null symref"
	}
	if node.Init[7].IntVal != cast(uint64, 0) { return "Globals.len should be 0" }
	// SatEntries count 0 -> null symref + 0 at terms 10-11 (after Vtables 8-9).
	if node.Init[10].Kind != DT_SYMREF || len(node.Init[10].Sym) != 0 {
		return "empty SatEntries.data should be a null symref"
	}
	if node.Init[11].IntVal != cast(uint64, 0) { return "SatEntries.len should be 0" }
	// IfaceIds count 2 -> symref to _ifaceids + count at terms 12-13.
	if node.Init[12].Kind != DT_SYMREF || !charEq(node.Init[12].Sym, "_ifaceids") {
		return "IfaceIds.data should be a symref to _ifaceids"
	}
	if node.Init[13].IntVal != cast(uint64, 2) { return "IfaceIds.len should be 2" }

	var name @DataGlobal = dgs[1]
	if name.Linkage != DG_LOCAL { return "name should be local" }
	if len(name.Init) != 1 || name.Init[0].Kind != DT_BYTES {
		return "name should be a single bytes term"
	}
	if len(name.Init[0].Bytes) != 4 { return "name bytes should be 4" }
	return ""
}

// TestBuildPackageDescriptors pins the FULL ordered list for one func + one
// global + one vtable + one satentry + one interface id: per-table [name rodata,
// (sig rodata,) node] then the backing array, then the descriptor node + name —
// 16 DataGlobals.  Checks the
// per-kind node term counts + linkage, and the load-bearing detail that an
// info-node's PAYLOAD pointer (a FunctionInfo's Pkg field + every backing-array
// entry) carries the managed-header addend (2*w = 16 on a 64-bit target).
func TestBuildPackageDescriptors() testing.TestResult {
	pinTarget64()
	var funcs @[]@PkgFuncEntry = make_slice(@PkgFuncEntry, 1)
	funcs[0] = NewPkgFuncEntry("fn__fninfo", "fn__fnname", "Foo", "fn__fnsig", "(int)(int)",
			"__handle.fn", 0, 1)
	var globals @[]@PkgGlobalEntry = make_slice(@PkgGlobalEntry, 1)
	globals[0] = NewPkgGlobalEntry("g__glinfo", "g__glname", "pkg.G", "g_cell")
	var vtables @[]@PkgVtableEntry = make_slice(@PkgVtableEntry, 1)
	vtables[0] = NewPkgVtableEntry("vt__vtinfo", "vt__vtname", "__ivt.bn_x", "vt_ivt", "vt_ivtshim", 2)
	// SatEntries carries the (separately-emitted) __satentry node symbols; the
	// descriptor builds only their backing array (no per-entry node/rodata here).
	var satEntrySyms @[]@[]char = make_slice(@[]char, 1)
	satEntrySyms[0] = "sat_node"
	var ifaceIds @[]@PkgIfaceIdEntry = make_slice(@PkgIfaceIdEntry, 1)
	ifaceIds[0] = NewPkgIfaceIdEntry("id__idinfo", "id__idname", "__ifaceid.J", "id_marker")

	var dgs @[]@DataGlobal = BuildPackageDescriptors(-1073741824, "_info", "_name", "main", "_funcs",
			funcs, "_globals", globals, "_vtables", vtables, "_satentries", satEntrySyms, "_ifaceids",
			ifaceIds)
	// 3 func DGs (name, sig, node) + funcs array + 2 global DGs + globals array
	// + 2 vtable DGs + vtables array + satentries array + 2 interface-id DGs
	// + ifaceids array + descriptor node + name = 16.
	if len(dgs) != 16 {
		return "expected 16 DataGlobals for 1 func/global/vtable/satentry/interface id"
	}

	// dgs[0]: func name rodata — local, one bytes term.
	if dgs[0].Linkage != DG_LOCAL { return "func name rodata should be local" }
	if len(dgs[0].Init) != 1 || dgs[0].Init[0].Kind != DT_BYTES {
		return "func name rodata should be a single bytes term"
	}

	// dgs[2]: FunctionInfo node — weak, 10 terms; term 2 is the Pkg back-pointer,
	// a symref to _info carrying the managed-header addend (2*w = 16).
	var fnode @DataGlobal = dgs[2]
	if fnode.Linkage != DG_WEAK { return "FunctionInfo node should be weak" }
	if len(fnode.Init) != 10 { return "FunctionInfo node should have 10 terms" }
	if fnode.Init[2].Kind != DT_SYMREF || fnode.Init[2].Addend != 16 {
		return "FunctionInfo.Pkg should symref _info + 16 (header size)"
	}

	// dgs[3]: funcs backing array — weak, one symref to the node PAYLOAD (+16).
	var farr @DataGlobal = dgs[3]
	if farr.Linkage != DG_WEAK { return "funcs array should be weak" }
	if len(farr.Init) != 1 || farr.Init[0].Kind != DT_SYMREF {
		return "funcs array should hold one symref per node"
	}
	if farr.Init[0].Addend != 16 {
		return "funcs array entry should point at the node payload (+16)"
	}

	// dgs[5]: GlobalInfo node — weak, 5 terms (header + Name{data,len} + Addr).
	if dgs[5].Linkage != DG_WEAK || len(dgs[5].Init) != 5 {
		return "GlobalInfo node should be a weak 5-term node"
	}
	// dgs[8]: VtableInfo node — weak, 7 terms (header + Name{data,len} + Addr +
	// ShimAddr + SlotCount).
	if dgs[8].Linkage != DG_WEAK || len(dgs[8].Init) != 7 {
		return "VtableInfo node should be a weak 7-term node"
	}

	// dgs[10]: satentries backing array — weak, one symref to the __satentry node
	// PAYLOAD (+16, past the managed header).
	var sarr @DataGlobal = dgs[10]
	if sarr.Linkage != DG_WEAK { return "satentries array should be weak" }
	if len(sarr.Init) != 1 || sarr.Init[0].Kind != DT_SYMREF {
		return "satentries array should hold one symref per node"
	}
	if sarr.Init[0].Addend != 16 {
		return "satentries array entry should point at the node payload (+16)"
	}
	// dgs[11]: interface-id name rodata (local); dgs[12]: IfaceIdInfo node — weak,
	// 5 terms (header + Name{data,len} + Addr), Addr the marker itself.
	if dgs[11].Linkage != DG_LOCAL { return "interface-id name rodata should be local" }
	if dgs[12].Linkage != DG_WEAK || len(dgs[12].Init) != 5 {
		return "IfaceIdInfo node should be a weak 5-term node"
	}
	if !charEq(dgs[12].Init[4].Sym, "id_marker") || dgs[12].Init[4].Addend != 0 {
		return "IfaceIdInfo.Addr should symref the marker (addend 0)"
	}
	// dgs[13]: ifaceids backing array — one symref to the node PAYLOAD (+16).
	var iarr @DataGlobal = dgs[13]
	if iarr.Linkage != DG_WEAK || len(iarr.Init) != 1 || iarr.Init[0].Addend != 16 {
		return "ifaceids array should hold one symref to the node payload (+16)"
	}
	// dgs[14]/dgs[15]: the descriptor node (weak) + name bytes (local), last.
	if dgs[14].Linkage != DG_WEAK { return "descriptor node should be weak" }
	if dgs[15].Linkage != DG_LOCAL { return "descriptor name should be local" }
	return ""
}
