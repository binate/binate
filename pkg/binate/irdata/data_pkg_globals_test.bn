package "pkg/binate/irdata"

import "pkg/builtins/testing"

// buildGlobalInfoNode lays the 2-word managed header then the 3-word
// reflect.GlobalInfo payload { Name(data,len), Addr }.  Addr targets the
// global's `var` storage cell directly (addend 0 — no managed header).
func TestBuildGlobalInfoNode() testing.TestResult {
	var e @PkgGlobalEntry = NewPkgGlobalEntry("g__glinfo", "g__glname", "pkg.G", "g_cell")
	var node @DataGlobal = buildGlobalInfoNode(-1073741824, 8, e)

	if node.Linkage != DG_WEAK { return "GlobalInfo node should be weak" }
	// 2 header words + Name(data,len) + Addr = 5 terms.
	if len(node.Init) != 5 { return "node should have 5 terms" }
	// term 2 = Name.data symref; term 3 = Name.len = len("pkg.G") = 5.
	if node.Init[2].Kind != DT_SYMREF { return "Name.data should be a symref" }
	if node.Init[3].IntVal != cast(uint64, 5) { return "Name.len should be 5" }
	// term 4 = Addr -> storage cell directly (no header offset).
	if node.Init[4].Kind != DT_SYMREF || node.Init[4].Addend != 0 {
		return "Addr should symref the storage cell (addend 0)"
	}
	return ""
}
