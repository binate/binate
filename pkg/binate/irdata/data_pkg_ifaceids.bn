package "pkg/binate/irdata"

// reflect.IfaceIdInfo node layout for the per-package descriptor — the single
// source of truth every backend lowers through emitDataGlobal.  See
// data_pkg_descriptor.bn for the surrounding emission.

// NewPkgIfaceIdEntry builds a reflect.IfaceIdInfo descriptor row.  name must be
// owned (the returned entry retains it for the node + rodata blob).
func NewPkgIfaceIdEntry(nodeSym @[]char, nameSym @[]char, name @[]char,
		markerSym @[]char) @PkgIfaceIdEntry {
	var e @PkgIfaceIdEntry = make(PkgIfaceIdEntry)
	e.NodeSym = nodeSym
	e.NameSym = nameSym
	e.Name = name
	e.MarkerSym = markerSym
	return e
}

// buildIfaceIdInfoNode lays one immortal static-managed reflect.IfaceIdInfo node:
// the 2-word managed header then the { Name(data,len), Addr } payload (matching
// reflect.bni).  Addr targets the `__ifaceid.<J>` marker directly (addend 0).
// The node is weak: every package that looks a box up with J emits the same one.
func buildIfaceIdInfoNode(refcount int, w int, e @PkgIfaceIdEntry) @DataGlobal {
	var node @DataGlobal = NewDataGlobal(e.NodeSym, DG_WEAK, w, true)
	node.Init = appendTerm(node.Init, DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	node.Init = appendTerm(node.Init, DataSymref(e.NameSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(e.Name))))
	node.Init = appendTerm(node.Init, DataSymref(e.MarkerSym, 0))
	return node
}
