package "pkg/binate/irdata"

import "pkg/builtins/testing"

// buildIfaceIdInfoNode lays the 2-word managed header then the 3-word
// reflect.IfaceIdInfo payload { Name(data,len), Addr }.  Addr targets the marker
// directly (addend 0).
func TestBuildIfaceIdInfoNode() testing.TestResult {
	var e @PkgIfaceIdEntry = NewPkgIfaceIdEntry("__ifaceid.J__idinfo", "__ifaceid.J__idname",
			"__ifaceid.J", "__ifaceid.J")
	var node @DataGlobal = buildIfaceIdInfoNode(-1073741824, 8, e)

	if node.Linkage != DG_WEAK { return "IfaceIdInfo node should be weak" }
	// 2 header words + Name(data,len) + Addr = 5 terms.
	if len(node.Init) != 5 { return "node should have 5 terms" }
	if node.Init[2].Kind != DT_SYMREF { return "Name.data should be a symref" }
	if node.Init[3].IntVal != cast(uint64, 11) {
		return "Name.len should be len(\"__ifaceid.J\") = 11"
	}
	if node.Init[4].Kind != DT_SYMREF || node.Init[4].Addend != 0 {
		return "Addr should symref the marker (addend 0)"
	}
	return ""
}
