package "pkg/binate/irdata"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Per-package SatEntry graph node (`_pkg_satfrag`) — the decentralized way a
// program enumerates every package's satentries.  Each package emits its OWN
// `_pkg_satfrag` node carrying (a) a pointer to its own `_pkg_satentries`
// backing array + that array's length, and (b) symrefs to its DIRECT
// dependencies' `_pkg_satfrag` nodes.  A runtime walk from the main module's
// node then reaches every package's satentries by graph traversal, so no single
// TU needs the whole-program set (spec §11.12 `iface.rtti`).
//
// The node layout is:
//   { entriesPtr, ownCount, depCount, depFragSyms[0], ..., depFragSyms[depCount-1] }
// where entriesPtr / ownCount mirror the reflect.Package.SatEntries `{data,len}`
// slice (entriesPtr = &<pkg>._pkg_satentries, or null when the package has no
// satentries and thus emits no backing array), and each dep symref names a
// direct dependency's `_pkg_satfrag`.  A package's own node is STRONG (DG_GLOBAL);
// for each dep it ALSO emits a WEAK empty fallback (BuildSatFragFallback) so its
// object links standalone (separate compilation, `--pkg`, a facade/partial link)
// even when the dep's object is absent.  Where the dep IS linked its own strong
// node OVERRIDES the weak fallback; where the dep is absent the fallback keeps the
// edge pointing at a valid EMPTY node the runtime walk treats as a leaf.  This
// override model — not a strong undefined ref — is what lets an opaque object be
// distributed and linked without dragging in every transitive dependency's object.

// BuildPkgSatFrag lays a package's `_pkg_satfrag` graph node.  `entriesSym` is
// the package's `_pkg_satentries` backing-array symbol (used only when
// `ownCount > 0`; otherwise a null pointer is laid, since an empty package emits
// no backing array).  `depFragSyms` are the direct dependencies' `_pkg_satfrag`
// symbols, already mangled/prefixed by the caller.
func BuildPkgSatFrag(fragSym @[]char, entriesSym @[]char, ownCount int,
		depFragSyms @[]@[]char) @[]@DataGlobal {
	// w is the int-sized word width for the counts; the pointer fields
	// (entriesPtr + each dep symref) are pointer-sized DataSymrefs, assuming
	// PointerSize == IntSize (every current Binate target — the same assumption
	// BuildPackageDescriptor documents).
	var w int = types.GetTarget().IntSize

	// DG_GLOBAL (strong): each package defines its own node exactly once, and every
	// referencing package emits a WEAK empty fallback for it (BuildSatFragFallback)
	// so its object links even when this package's object is absent.  The real node
	// must be STRONG so that wherever both are linked it deterministically OVERRIDES
	// every weak fallback — two weak defs of differing size would let the linker
	// pick the empty one and silently drop this package's satentries.  Each node is
	// defined once per link in every workflow (whole-program compiles each package
	// once; `--pkg`/library builds emit each package's object once), so a strong def
	// never collides with another strong def of the same node.
	var frag @DataGlobal = NewDataGlobal(fragSym, DG_GLOBAL, w, true)

	// entriesPtr + ownCount: the package's own satentries, laid identically to the
	// reflect.Package.SatEntries `{data,len}` slice so the runtime walk reads them
	// the same way.  Null data when the package has no satentries.
	if ownCount > 0 {
		frag.Init = appendTerm(frag.Init, DataSymref(entriesSym, 0))
	} else {
		frag.Init = appendTerm(frag.Init, DataSymref("", 0))
	}
	frag.Init = appendTerm(frag.Init, DataInt(w, cast(uint64, ownCount)))

	// depCount + one symref per direct-dependency node.
	frag.Init = appendTerm(frag.Init, DataInt(w, cast(uint64, len(depFragSyms))))
	for i := 0; i < len(depFragSyms); i++ {
		frag.Init = appendTerm(frag.Init, DataSymref(depFragSyms[i], 0))
	}

	var out @[]@DataGlobal
	out = slices.Append[@DataGlobal](out, frag)
	return out
}

// BuildSatFragFallback lays a WEAK, empty (all-zero) `_pkg_satfrag` node for a
// dependency symbol `sym` — the overridable default a referencing package emits
// for each of its direct deps (see the file header).  Three int-words wide — the
// fields the runtime walk reads: entriesPtr (null), ownCount (0), depCount (0) —
// so an absent dep resolves to a valid leaf.  DG_WEAK so the dep's own STRONG node
// (BuildPkgSatFrag) overrides it wherever both are linked; the size difference
// between this 3-word fallback and a larger real node is benign because strong
// always wins.
func BuildSatFragFallback(sym @[]char) @DataGlobal {
	var w int = types.GetTarget().IntSize
	var fb @DataGlobal = NewDataGlobal(sym, DG_WEAK, w, true)
	fb.Init = appendTerm(fb.Init, DataZero(3 * w))
	return fb
}
