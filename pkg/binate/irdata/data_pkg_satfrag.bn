package "pkg/binate/irdata"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Per-package SatEntry graph node (`_pkg_satfrag`) — the decentralized way a
// program enumerates every package's satentries.  Each package emits its OWN
// `_pkg_satfrag` node carrying (a) a pointer to its own `_pkg_satentries`
// backing array + that array's length, and (b) symrefs to its DIRECT
// dependencies' `_pkg_satfrag` nodes.  A runtime walk from the main module's
// node then reaches every package's satentries by graph traversal, so no single
// TU needs the whole-program set (spec §11.12 `iface.rtti`).
//
// The node layout is:
//   { entriesPtr, ownCount, depCount, depFragSyms[0], ..., depFragSyms[depCount-1] }
// where entriesPtr / ownCount mirror the reflect.Package.SatEntries `{data,len}`
// slice (entriesPtr = &<pkg>._pkg_satentries, or null when the package has no
// satentries and thus emits no backing array), and each dep symref names a
// direct dependency's `_pkg_satfrag`.  The backends declare each dep symref a
// STRONG undefined ref (LLVM `external global` / native SetGlobal): every
// compiled package emits a node so the ref resolves, and a strong ref pulls the
// defining object from a static archive (opaque binary distribution).

// BuildPkgSatFrag lays a package's `_pkg_satfrag` graph node.  `entriesSym` is
// the package's `_pkg_satentries` backing-array symbol (used only when
// `ownCount > 0`; otherwise a null pointer is laid, since an empty package emits
// no backing array).  `depFragSyms` are the direct dependencies' `_pkg_satfrag`
// symbols, already mangled/prefixed by the caller.
func BuildPkgSatFrag(fragSym @[]char, entriesSym @[]char, ownCount int,
		depFragSyms @[]@[]char) @[]@DataGlobal {
	// w is the int-sized word width for the counts; the pointer fields
	// (entriesPtr + each dep symref) are pointer-sized DataSymrefs, assuming
	// PointerSize == IntSize (every current Binate target — the same assumption
	// BuildPackageDescriptor documents).
	var w int = types.GetTarget().IntSize

	// DG_WEAK: every package defines its node once, but many packages reference
	// each other's nodes, and the main node is an OP_DATA_SYM_ADDR target whose
	// lowering promotes its symbol's binding (a weak def resists the demotion).
	var frag @DataGlobal = NewDataGlobal(fragSym, DG_WEAK, w, true)

	// entriesPtr + ownCount: the package's own satentries, laid identically to the
	// reflect.Package.SatEntries `{data,len}` slice so the runtime walk reads them
	// the same way.  Null data when the package has no satentries.
	if ownCount > 0 {
		frag.Init = appendTerm(frag.Init, DataSymref(entriesSym, 0))
	} else {
		frag.Init = appendTerm(frag.Init, DataSymref("", 0))
	}
	frag.Init = appendTerm(frag.Init, DataInt(w, cast(uint64, ownCount)))

	// depCount + one symref per direct-dependency node.
	frag.Init = appendTerm(frag.Init, DataInt(w, cast(uint64, len(depFragSyms))))
	for i := 0; i < len(depFragSyms); i++ {
		frag.Init = appendTerm(frag.Init, DataSymref(depFragSyms[i], 0))
	}

	var out @[]@DataGlobal
	out = slices.Append[@DataGlobal](out, frag)
	return out
}
