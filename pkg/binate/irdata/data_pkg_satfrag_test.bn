package "pkg/binate/irdata"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for data_pkg_satfrag.bn (BuildPkgSatFrag).  The charEq / isIntTerm /
// isSymrefTerm term-shape helpers live below; pinTarget64 lives in
// data_pkg_descriptor_test.

// charEq reports whether two raw slices have identical contents (a local test
// helper — the ir package's charEq is not reachable from this leaf package).
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// isIntTerm reports whether t is an 8-byte DT_INT holding val.
func isIntTerm(t @DataTerm, val int) bool {
	return t.Kind == DT_INT && t.Width == 8 && t.IntVal == cast(uint64, val)
}

// isSymrefTerm reports whether t is a DT_SYMREF whose target symbol is sym.
func isSymrefTerm(t @DataTerm, sym *[]readonly char) bool {
	return t.Kind == DT_SYMREF && charEq(t.Sym, sym)
}

// A package with satentries + direct deps lays one STRONG node
// { &entries, ownCount, depCount, dep0, dep1 }.  Strong (DG_GLOBAL) so it
// deterministically overrides every referencing package's weak fallback.
func TestBuildPkgSatFrag() testing.TestResult {
	pinTarget64()
	var deps @[]@[]char
	deps = slices.Append[@[]char](deps, "_dep0")
	deps = slices.Append[@[]char](deps, "_dep1")

	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 2, deps)
	if len(dgs) != 1 { return "BuildPkgSatFrag should yield one node" }
	var frag @DataGlobal = dgs[0]
	if !charEq(frag.Name, "_frag") { return "node name should be _frag" }
	if frag.Linkage != DG_GLOBAL { return "node should be DG_GLOBAL (strong)" }
	if !frag.ReadOnly { return "node should be read-only" }
	if len(frag.Init) != 5 {
		return "node should have 5 terms {entries, ownCount, depCount, dep0, dep1}"
	}
	if !isSymrefTerm(frag.Init[0], "_entries") { return "term 0 should be &_entries" }
	if !isIntTerm(frag.Init[1], 2) { return "term 1 should be ownCount 2" }
	if !isIntTerm(frag.Init[2], 2) { return "term 2 should be depCount 2" }
	if !isSymrefTerm(frag.Init[3], "_dep0") { return "term 3 should be &_dep0" }
	if !isSymrefTerm(frag.Init[4], "_dep1") { return "term 4 should be &_dep1" }
	return ""
}

// A package with NO satentries lays a null entriesPtr + ownCount 0; with no deps,
// depCount 0 and no dep symrefs.  Every package emits a node even when empty (it
// is a graph waypoint), so len(dgs) is still 1.
func TestBuildPkgSatFragEmpty() testing.TestResult {
	pinTarget64()
	var noDeps @[]@[]char
	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 0, noDeps)
	if len(dgs) != 1 { return "an empty package still emits its node (waypoint)" }
	var frag @DataGlobal = dgs[0]
	if len(frag.Init) != 3 { return "empty node should have 3 terms {null, 0, 0}" }
	if frag.Init[0].Kind != DT_SYMREF || len(frag.Init[0].Sym) != 0 {
		return "empty node entriesPtr should be a null symref"
	}
	if !isIntTerm(frag.Init[1], 0) { return "empty node ownCount should be 0" }
	if !isIntTerm(frag.Init[2], 0) { return "empty node depCount should be 0" }
	return ""
}

// A package with satentries but no deps: entriesPtr points at the array,
// ownCount > 0, depCount 0.
func TestBuildPkgSatFragEntriesNoDeps() testing.TestResult {
	pinTarget64()
	var noDeps @[]@[]char
	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 3, noDeps)
	var frag @DataGlobal = dgs[0]
	if len(frag.Init) != 3 { return "node should have 3 terms {entries, ownCount, 0}" }
	if !isSymrefTerm(frag.Init[0], "_entries") { return "term 0 should be &_entries" }
	if !isIntTerm(frag.Init[1], 3) { return "term 1 should be ownCount 3" }
	if !isIntTerm(frag.Init[2], 0) { return "term 2 should be depCount 0" }
	return ""
}

// BuildSatFragFallback lays a WEAK, empty (3 int-words of zero) node for a dep
// symbol — the overridable default a referencing package emits so its object links
// when the dep's object is absent.  DG_WEAK so the dep's own strong node wins.
func TestBuildSatFragFallback() testing.TestResult {
	pinTarget64()
	var fb @DataGlobal = BuildSatFragFallback("_dep0")
	if !charEq(fb.Name, "_dep0") { return "fallback name should be _dep0" }
	if fb.Linkage != DG_WEAK { return "fallback should be DG_WEAK (overridable)" }
	if !fb.ReadOnly { return "fallback should be read-only" }
	if len(fb.Init) != 1 { return "fallback should be a single zero term" }
	// 3 int-words (entriesPtr, ownCount, depCount); pinTarget64 -> 8-byte words.
	if fb.Init[0].Kind != DT_ZERO || fb.Init[0].Width != 24 {
		return "fallback should be 24 zero bytes (3 int-words)"
	}
	return ""
}
