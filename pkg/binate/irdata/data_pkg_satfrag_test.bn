package "pkg/binate/irdata"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for data_pkg_satfrag.bn (BuildPkgSatFrag).  Reuses the charEq /
// isRootIntTerm / isRootSymrefTerm / pinTarget64 helpers from data_satroot_test.

// A package with satentries + direct deps lays one weak node
// { &entries, ownCount, depCount, dep0, dep1 }.
func TestBuildPkgSatFrag() testing.TestResult {
	pinTarget64()
	var deps @[]@[]char
	deps = slices.Append[@[]char](deps, "_dep0")
	deps = slices.Append[@[]char](deps, "_dep1")

	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 2, deps)
	if len(dgs) != 1 { return "BuildPkgSatFrag should yield one node" }
	var frag @DataGlobal = dgs[0]
	if !charEq(frag.Name, "_frag") { return "node name should be _frag" }
	if frag.Linkage != DG_WEAK { return "node should be DG_WEAK" }
	if !frag.ReadOnly { return "node should be read-only" }
	if len(frag.Init) != 5 {
		return "node should have 5 terms {entries, ownCount, depCount, dep0, dep1}"
	}
	if !isRootSymrefTerm(frag.Init[0], "_entries") { return "term 0 should be &_entries" }
	if !isRootIntTerm(frag.Init[1], 2) { return "term 1 should be ownCount 2" }
	if !isRootIntTerm(frag.Init[2], 2) { return "term 2 should be depCount 2" }
	if !isRootSymrefTerm(frag.Init[3], "_dep0") { return "term 3 should be &_dep0" }
	if !isRootSymrefTerm(frag.Init[4], "_dep1") { return "term 4 should be &_dep1" }
	return ""
}

// A package with NO satentries lays a null entriesPtr + ownCount 0; with no deps,
// depCount 0 and no dep symrefs.  Every package emits a node even when empty (it
// is a graph waypoint), so len(dgs) is still 1.
func TestBuildPkgSatFragEmpty() testing.TestResult {
	pinTarget64()
	var noDeps @[]@[]char
	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 0, noDeps)
	if len(dgs) != 1 { return "an empty package still emits its node (waypoint)" }
	var frag @DataGlobal = dgs[0]
	if len(frag.Init) != 3 { return "empty node should have 3 terms {null, 0, 0}" }
	if frag.Init[0].Kind != DT_SYMREF || len(frag.Init[0].Sym) != 0 {
		return "empty node entriesPtr should be a null symref"
	}
	if !isRootIntTerm(frag.Init[1], 0) { return "empty node ownCount should be 0" }
	if !isRootIntTerm(frag.Init[2], 0) { return "empty node depCount should be 0" }
	return ""
}

// A package with satentries but no deps: entriesPtr points at the array,
// ownCount > 0, depCount 0.
func TestBuildPkgSatFragEntriesNoDeps() testing.TestResult {
	pinTarget64()
	var noDeps @[]@[]char
	var dgs @[]@DataGlobal = BuildPkgSatFrag("_frag", "_entries", 3, noDeps)
	var frag @DataGlobal = dgs[0]
	if len(frag.Init) != 3 { return "node should have 3 terms {entries, ownCount, 0}" }
	if !isRootSymrefTerm(frag.Init[0], "_entries") { return "term 0 should be &_entries" }
	if !isRootIntTerm(frag.Init[1], 3) { return "term 1 should be ownCount 3" }
	if !isRootIntTerm(frag.Init[2], 0) { return "term 2 should be depCount 0" }
	return ""
}
