package "pkg/binate/irdata"

// reflect.VtableInfo node layout for the per-package descriptor — the single
// source of truth both backends lower through emitDataGlobal.  See
// data_pkg_descriptor.bn for the surrounding emission.

// NewPkgVtableEntry builds a reflect.VtableInfo descriptor row.  name must be
// owned (the returned entry retains it for the node + rodata blob).  slotCount is
// the @__ivt / @__ivtshim slot count (dtor + concat method set).
func NewPkgVtableEntry(nodeSym @[]char, nameSym @[]char, name @[]char, vtableSym @[]char,
		shimSym @[]char, slotCount int) @PkgVtableEntry {
	var e @PkgVtableEntry = make(PkgVtableEntry)
	e.NodeSym = nodeSym
	e.NameSym = nameSym
	e.Name = name
	e.VtableSym = vtableSym
	e.ShimSym = shimSym
	e.SlotCount = slotCount
	return e
}

// buildVtableInfoNode lays one immortal static-managed reflect.VtableInfo node:
// the 2-word managed header then the { Name(data,len), Addr, ShimAddr, SlotCount }
// payload (matching reflect.bni).  Addr / ShimAddr target the @__ivt / @__ivtshim
// vtable globals directly (addend 0 — constant arrays, no managed header);
// SlotCount is the vtable's slot count (the VM's upcast extent bound).
func buildVtableInfoNode(refcount int, w int, e @PkgVtableEntry) @DataGlobal {
	var node @DataGlobal = NewDataGlobal(e.NodeSym, DG_WEAK, w, true)
	node.Init = appendTerm(node.Init, DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, 0)))
	node.Init = appendTerm(node.Init, DataSymref(e.NameSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, len(e.Name))))
	node.Init = appendTerm(node.Init, DataSymref(e.VtableSym, 0))
	node.Init = appendTerm(node.Init, DataSymref(e.ShimSym, 0))
	node.Init = appendTerm(node.Init, DataInt(w, cast(uint64, e.SlotCount)))
	return node
}
