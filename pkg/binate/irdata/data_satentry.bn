package "pkg/binate/irdata"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Distributed interface-satisfaction entries (`__satentry.<T,J>`) — the
// registry an interface assertion `x.(*J)` scans (spec §11.12 `iface.rtti`,
// `type.layout.satisfaction`).  Because `impl` may live in any package (no
// orphan rule), no TU sees a type's complete impl set, so satisfaction is NOT a
// per-type table in TypeInfo; instead each `impl T : J` site emits one weak
// per-`(T, J)` entry (for J and every transitive ancestor), keyed on `(T, J)`
// and ODR-coalesced exactly like the `__ivt.<T>__<J>` sub-vtable it references.
// Each entry records `{&TypeInfo(T), &IfaceId(J), &__ivt.<T>__<J>}` followed by
// two `{data,len}` slices naming the NEUTRAL `__typeinfo.<T>` / `__ifaceid.<J>`
// symbols (so a bytecode-VM host can map a native value's RTTI across modes).
// The set to emit is gathered per-module by ir.CollectSatEntries.

// BuildSatEntry builds the weak satisfaction-entry NODE named `desc.Sym`
// (mangle.SatEntryName) PLUS its two TU-local symbol-name blobs, returned as
// [node, type-sym-blob, iface-sym-blob].  The node is a 2-word static-managed
// header (refcount sentinel + null freefn), then the `{&TypeInfo, &IfaceId,
// &sub-vtable}` payload, then two `{data,len}` raw slices (reflect.SatEntryInfo
// TypeSym/IfaceSym) pointing at the blobs.  The node IS a reflect.SatEntryInfo —
// the per-package descriptor's SatEntries table lists it as `@SatEntryInfo`
// (pointing past the header), so the runtime handles it as a managed node with
// no copy.  Weak so duplicate emissions across TUs coalesce to one — the header
// is a TU-invariant sentinel, the three payload referents are deterministic
// co-emitted symbols, and the two symbol-name blobs are TU-local (each TU that
// emits the weak node emits its own, like BuildTypeInfo's name blob), so the
// nodes stay equivalent.  Read-only but relocatable (five symrefs) →
// rodata_relro.
//
// The two blobs carry the NEUTRAL `__typeinfo.<T>` / `__ifaceid.<J>` symbol
// NAMES as strings so a bytecode-VM host importing a native package can key its
// data-symbol table on a value's canonical RTTI names and map the native
// addresses to VM-canonical identities (cross-mode assertions); the native
// reflect reader ignores them (it reads only the first three payload words).
func BuildSatEntry(refcount int, desc @SatEntryDesc) @[]@DataGlobal {
	var w int = types.GetTarget().IntSize
	var dg @DataGlobal = NewDataGlobal(desc.Sym, DG_WEAK, w, true)
	dg.Init = appendTerm(dg.Init, DataInt(w, bit_cast(uint64, cast(int64, refcount))))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, 0)))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.TypeInfoSym, 0))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.IfaceIdSym, 0))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.SubvtabSym, 0))
	// TypeSym / IfaceSym raw slices: each a `{data, len}` pair — a symref to the
	// TU-local blob plus its byte length.  Both symbols are always present (every
	// satentry has a T and a J), so no null-slot guard is needed.
	dg.Init = appendTerm(dg.Init, DataSymref(desc.TypeSymBlobSym, 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, len(desc.TypeSymStr)))))
	dg.Init = appendTerm(dg.Init, DataSymref(desc.IfaceSymBlobSym, 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, len(desc.IfaceSymStr)))))

	var out @[]@DataGlobal
	out = slices.Append[@DataGlobal](out, dg)
	out = slices.Append[@DataGlobal](out, buildRodata(desc.TypeSymBlobSym, desc.TypeSymStr))
	out = slices.Append[@DataGlobal](out, buildRodata(desc.IfaceSymBlobSym, desc.IfaceSymStr))
	return out
}
