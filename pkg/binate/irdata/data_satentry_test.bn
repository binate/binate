package "pkg/binate/irdata"

import "pkg/builtins/testing"

// BuildSatEntry lays a weak, read-only reflect.SatEntryInfo NODE — a 2-word
// static-managed header, then the `{&TypeInfo, &IfaceId, &sub-vtable}` payload,
// then two `{data,len}` symbol-name slices (TypeSym/IfaceSym) — plus the two
// TU-local blobs those slices point at, returned as [node, type-blob, iface-blob].
// pinTarget64 fixes the word width.
func TestBuildSatEntry() testing.TestResult {
	pinTarget64()
	var desc @SatEntryDesc = make(SatEntryDesc)
	desc.Sym = "_sat"
	desc.TypeInfoSym = "_ti"
	desc.IfaceIdSym = "_iid"
	desc.SubvtabSym = "_ivt"
	desc.TypeSymStr = "__typeinfo.T"
	desc.TypeSymBlobSym = "_tsblob"
	desc.IfaceSymStr = "__ifaceid.J"
	desc.IfaceSymBlobSym = "_isblob"
	var dgs @[]@DataGlobal = BuildSatEntry(-1073741824, desc)
	// [node, type-sym-blob, iface-sym-blob].
	if len(dgs) != 3 { return "expected [node, type-blob, iface-blob]" }
	var dg @DataGlobal = dgs[0]
	if dg.Linkage != DG_WEAK { return "SatEntry should be weak" }
	if !dg.ReadOnly { return "SatEntry should be read-only" }
	// 2-word header + 3 payload ptrs + 2 {data,len} slices = 9 terms.
	if len(dg.Init) != 9 {
		return "SatEntry node should have 9 terms (header + 3 ptrs + 2 sym slices)"
	}
	if dg.Init[0].Kind != DT_INT || dg.Init[0].Width != 8 {
		return "term 0 should be the 8-byte refcount int"
	}
	if dg.Init[2].Kind != DT_SYMREF || !charEq(dg.Init[2].Sym, "_ti") {
		return "payload word 0 should be a symref to &TypeInfo"
	}
	if dg.Init[3].Kind != DT_SYMREF || !charEq(dg.Init[3].Sym, "_iid") {
		return "payload word 1 should be a symref to &IfaceId"
	}
	if dg.Init[4].Kind != DT_SYMREF || !charEq(dg.Init[4].Sym, "_ivt") {
		return "payload word 2 should be a symref to &sub-vtable"
	}
	// TypeSym {data,len}: symref to the type-sym blob + len("__typeinfo.T")=12.
	if dg.Init[5].Kind != DT_SYMREF || !charEq(dg.Init[5].Sym, "_tsblob") {
		return "TypeSym.data should be a symref to the type-sym blob"
	}
	if dg.Init[6].Kind != DT_INT || dg.Init[6].IntVal != cast(uint64, 12) {
		return "TypeSym.len should be len(\"__typeinfo.T\")=12"
	}
	// IfaceSym {data,len}: symref to the iface-sym blob + len("__ifaceid.J")=11.
	if dg.Init[7].Kind != DT_SYMREF || !charEq(dg.Init[7].Sym, "_isblob") {
		return "IfaceSym.data should be a symref to the iface-sym blob"
	}
	if dg.Init[8].Kind != DT_INT || dg.Init[8].IntVal != cast(uint64, 11) {
		return "IfaceSym.len should be len(\"__ifaceid.J\")=11"
	}
	// The two blobs are TU-local byte runs holding the NEUTRAL symbol names.
	var tblob @DataGlobal = dgs[1]
	if tblob.Linkage != DG_LOCAL { return "type-sym blob should be TU-local" }
	if len(tblob.Init) != 1 || tblob.Init[0].Kind != DT_BYTES ||
			!charEq(tblob.Init[0].Bytes, "__typeinfo.T") {
		return "type-sym blob should hold the neutral __typeinfo.<T> name bytes"
	}
	var iblob @DataGlobal = dgs[2]
	if iblob.Linkage != DG_LOCAL { return "iface-sym blob should be TU-local" }
	if len(iblob.Init) != 1 || iblob.Init[0].Kind != DT_BYTES ||
			!charEq(iblob.Init[0].Bytes, "__ifaceid.J") {
		return "iface-sym blob should hold the neutral __ifaceid.<J> name bytes"
	}
	return ""
}
