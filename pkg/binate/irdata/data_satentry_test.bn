package "pkg/binate/irdata"

import "pkg/builtins/testing"

// BuildSatEntry lays a weak, read-only reflect.SatEntryInfo NODE: a 2-word
// static-managed header then the `{&TypeInfo, &IfaceId, &sub-vtable}` payload.
// pinTarget64 fixes the word width.
func TestBuildSatEntry() testing.TestResult {
	pinTarget64()
	var desc @SatEntryDesc = make(SatEntryDesc)
	desc.Sym = "_sat"
	desc.TypeInfoSym = "_ti"
	desc.IfaceIdSym = "_iid"
	desc.SubvtabSym = "_ivt"
	var dg @DataGlobal = BuildSatEntry(-1073741824, desc)
	if dg.Linkage != DG_WEAK { return "SatEntry should be weak" }
	if !dg.ReadOnly { return "SatEntry should be read-only" }
	// 2-word managed header + 3 pointer words = 5 terms.
	if len(dg.Init) != 5 {
		return "SatEntry node should have 5 terms (header + 3 ptrs)"
	}
	if dg.Init[0].Kind != DT_INT || dg.Init[0].Width != 8 {
		return "term 0 should be the 8-byte refcount int"
	}
	if dg.Init[2].Kind != DT_SYMREF || !charEq(dg.Init[2].Sym, "_ti") {
		return "payload word 0 should be a symref to &TypeInfo"
	}
	if dg.Init[3].Kind != DT_SYMREF || !charEq(dg.Init[3].Sym, "_iid") {
		return "payload word 1 should be a symref to &IfaceId"
	}
	if dg.Init[4].Kind != DT_SYMREF || !charEq(dg.Init[4].Sym, "_ivt") {
		return "payload word 2 should be a symref to &sub-vtable"
	}
	return ""
}
