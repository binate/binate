package "pkg/binate/irdata"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Whole-program SatEntry root — the compiler-synthesized `{ptr,len}[]` array
// that spans every package's `_pkg_satentries` backing array (spec §11.12
// `iface.rtti`).  Its job is to hand
// the Phase-5 interface-assertion reader a BOUNDED enumerable set of every
// `__satentry.<T,J>` node in the program: `impl` may live in any package (no
// orphan rule), so no single TU sees a type's whole impl set, and the reader
// must scan across packages.  Rooting the array from `__entry` (ir.EmitSatEntryRoot)
// also keeps the `__satentry` chain alive under `--gc-sections` / `-dead_strip`
// even when reflection is unused — but that retention is a bonus; the enumerable
// set is the point.
//
// The root is a two-DataGlobal pair: a `pairs` array of `{&<pkg>._pkg_satentries,
// count}` — one per package with ≥1 `__satentry` — and a `root` raw-slice header
// `{&pairs, N}` (the symbol `__entry` references).  The per-pair `count` is
// required because a `_pkg_satentries` array carries no length prefix.

// BuildSatEntryRoot lays the root's two DataGlobals — see the ir.bni contract.
func BuildSatEntryRoot(rootSym @[]char, pairsSym @[]char, pkgSatSyms @[]@[]char,
		counts @[]int) @[]@DataGlobal {
	// w is the int-sized word width for the header's length term and each pair's
	// count.  The pair/header DATA fields are pointer-sized DataSymrefs; this
	// assumes PointerSize == IntSize (every current Binate target) — the same
	// assumption BuildPackageDescriptor documents.
	var w int = types.GetTarget().IntSize
	var n int = len(pkgSatSyms)
	var out @[]@DataGlobal

	// pairs: N × { &_pkg_satentries (symref), count (int) }.  Emitted only when
	// non-empty; referenced solely by the header in the same TU, so DG_LOCAL.
	// The cross-TU symrefs make it relocatable → EmitDataGlobal routes it to
	// rodata_relro.
	if n > 0 {
		var pairs @DataGlobal = NewDataGlobal(pairsSym, DG_LOCAL, w, true)
		for i := 0; i < n; i++ {
			pairs.Init = appendTerm(pairs.Init, DataSymref(pkgSatSyms[i], 0))
			pairs.Init = appendTerm(pairs.Init, DataInt(w, cast(uint64, counts[i])))
		}
		out = slices.Append[@DataGlobal](out, pairs)
	}

	// root header: the raw slice { data, len } — { &pairs, N }, or { null, 0 }
	// when N == 0 (still emitted, so the C1 unconditional-root invariant holds).
	// DG_WEAK: this is the OP_DATA_SYM_ADDR target `__entry` references, and that
	// lowering promotes its symbol's binding (a weak def resists the demotion).
	var root @DataGlobal = NewDataGlobal(rootSym, DG_WEAK, w, true)
	if n > 0 {
		root.Init = appendTerm(root.Init, DataSymref(pairsSym, 0))
	} else {
		root.Init = appendTerm(root.Init, DataSymref("", 0))
	}
	root.Init = appendTerm(root.Init, DataInt(w, cast(uint64, n)))
	out = slices.Append[@DataGlobal](out, root)
	return out
}
