package "pkg/binate/irdata"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// charEq reports whether two raw slices have identical contents (a local test
// helper — the ir package's charEq is not reachable from this leaf package).
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// isRootIntTerm reports whether t is an 8-byte DT_INT holding val.
func isRootIntTerm(t @DataTerm, val int) bool {
	return t.Kind == DT_INT && t.Width == 8 && t.IntVal == cast(uint64, val)
}

// isRootSymrefTerm reports whether t is a DT_SYMREF whose target symbol is sym.
func isRootSymrefTerm(t @DataTerm, sym *[]readonly char) bool {
	return t.Kind == DT_SYMREF && charEq(t.Sym, sym)
}

// BuildSatEntryRoot lays the whole-program SatEntry root: a `pairs` array (one
// `{&_pkg_satentries, count}` per gathered package) followed by a `root`
// raw-slice header `{&pairs, N}`.  pinTarget64 fixes the word width at 8.
func TestBuildSatEntryRootNonEmpty() testing.TestResult {
	pinTarget64()
	var syms @[]@[]char
	syms = slices.Append[@[]char](syms, "_ps0")
	syms = slices.Append[@[]char](syms, "_ps1")
	var counts @[]int
	counts = slices.Append[int](counts, 3)
	counts = slices.Append[int](counts, 7)

	var dgs @[]@DataGlobal = BuildSatEntryRoot("_root", "_pairs", syms, counts)
	if len(dgs) != 2 { return "non-empty root should yield [pairs, root]" }

	// pairs: DG_LOCAL, read-only, 2 pairs × {symref, int} = 4 terms.
	var pairs @DataGlobal = dgs[0]
	if !charEq(pairs.Name, "_pairs") { return "dgs[0] should be the pairs array" }
	if pairs.Linkage != DG_LOCAL { return "pairs should be DG_LOCAL" }
	if !pairs.ReadOnly { return "pairs should be read-only" }
	if len(pairs.Init) != 4 { return "pairs should have 4 terms (2 pairs of {symref,int})" }
	if !isRootSymrefTerm(pairs.Init[0], "_ps0") { return "pair 0 word 0 should be &_ps0" }
	if !isRootIntTerm(pairs.Init[1], 3) { return "pair 0 word 1 should be the count 3" }
	if !isRootSymrefTerm(pairs.Init[2], "_ps1") { return "pair 1 word 0 should be &_ps1" }
	if !isRootIntTerm(pairs.Init[3], 7) { return "pair 1 word 1 should be the count 7" }

	// root header: DG_WEAK (the OP_DATA_SYM_ADDR target), read-only, {&pairs, N=2}.
	var root @DataGlobal = dgs[1]
	if !charEq(root.Name, "_root") { return "dgs[1] should be the root header" }
	if root.Linkage != DG_WEAK { return "root should be DG_WEAK" }
	if !root.ReadOnly { return "root should be read-only" }
	if len(root.Init) != 2 { return "root should have 2 terms ({&pairs, N})" }
	if !isRootSymrefTerm(root.Init[0], "_pairs") { return "root word 0 should be &pairs" }
	if !isRootIntTerm(root.Init[1], 2) { return "root word 1 should be the package count 2" }
	return ""
}

// With no gathered package the pairs array is omitted and the root is the empty
// slice `{null, 0}` — still emitted, so the C1 unconditional-root invariant
// holds and `__entry` always has a symbol to reference.
func TestBuildSatEntryRootEmpty() testing.TestResult {
	pinTarget64()
	var noSyms @[]@[]char
	var noCounts @[]int
	var dgs @[]@DataGlobal = BuildSatEntryRoot("_root", "_pairs", noSyms, noCounts)
	if len(dgs) != 1 { return "empty root should yield [root] only (no pairs array)" }
	var root @DataGlobal = dgs[0]
	if !charEq(root.Name, "_root") { return "dgs[0] should be the root header" }
	if root.Linkage != DG_WEAK { return "root should be DG_WEAK" }
	if len(root.Init) != 2 { return "empty root should have 2 terms ({null, 0})" }
	if root.Init[0].Kind != DT_SYMREF || len(root.Init[0].Sym) != 0 {
		return "empty root word 0 should be a null symref"
	}
	if !isRootIntTerm(root.Init[1], 0) { return "empty root word 1 should be the count 0" }
	return ""
}
