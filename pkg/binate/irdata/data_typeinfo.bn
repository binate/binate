package "pkg/binate/irdata"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Per-type RTTI record (`__typeinfo.<T>`) — the static `TypeInfo` a type
// assertion reads to recover an interface value's dynamic type (spec
// §7.13.14 `type.layout.typeinfo`, §11.12 `iface.rtti`).  One per concrete
// type program-wide (weak, ODR-coalesced); its ADDRESS is the identity a
// concrete assertion compares.  The `*TypeInfo` pointer lives in every
// interface vtable's any-block slot 1 (§7.13.8).
//
// 8-word layout (word = target int size), in emission order:
//   word 0: destructor handle (*void; null if the type needs none)
//   word 1: size  (SizeOf, bytes)
//   word 2: align (AlignOf, bytes)
//   word 3: name pointer (*readonly char into static storage)
//   word 4: name length
//   word 5: KIND (a KIND_* discriminator; how a reflective reader interprets the
//           value's bytes — the exact width is word 1 / a field's size)
//   word 6: fields pointer (&__typefields.<T>, the field-table blob; null for a
//           non-struct or a fieldless struct)
//   word 7: field count (0 for a non-struct)
//
// Words 6–7 are ordered {ptr, len} so a reflective reader can overlay a
// `*[]FieldInfo` raw slice on them.  Words 0–4 keep their offsets, so every
// existing assertion reader (which reads words 0–4 by fixed offset and compares
// the record ADDRESS for identity) is unaffected by the trailing additions.
//
// Interface SATISFACTION is deliberately NOT carried here (spec
// `type.layout.satisfaction`): because `impl` may live in any package (no orphan
// rule), no TU sees a type's complete impl set, so a per-type table cannot be
// built — satisfaction lives in a distributed `(concrete type, interface)`
// registry (the per-interface IfaceId markers + the per-(T,J) satisfaction
// entries).  The per-type set to emit is gathered by ir.CollectTypeInfoDescs.
//
// The word-0 dtor is the SAME destructor handle the vtable any-block slot 0
// carries — each backend resolves desc.DtorSym via the same helper it uses for
// that slot, so the two stay byte-identical (and the record coalesces cleanly
// across TUs: a type's need-for-destruction is a TU-invariant fact).

// BuildTypeInfo builds the static `TypeInfo` record named `desc.Sym`
// (mangle.TypeInfoName).  Weak so duplicate emissions across TUs coalesce
// to one record — hence one identity — per type program-wide.  For a struct it
// also emits two TU-local trailer blobs: the field table (`__typefields.<T>`)
// and the concatenated field-name blob (`__typefieldnames.<T>`).
//
// The record interleaves pointer-sized words (dtor, name-ptr, fields-ptr) with
// `IntSize`-wide scalar words (size, align, name-len, kind, field-count).  This
// is byte-consistent across the LLVM and native emitters only because
// `PointerSize == IntSize` on every current target (LP64 8/8, ILP32 4/4) — the
// same assumption BuildPackageDescriptor relies on.  A future target with
// `PointerSize != IntSize` would need explicit per-word widths here.
func BuildTypeInfo(desc @TypeInfoDesc) @[]@DataGlobal {
	var w int = types.GetTarget().IntSize
	var dg @DataGlobal = NewDataGlobal(desc.Sym, DG_WEAK, w, true)
	// word 0: destructor handle (desc.DtorSym; empty → a null slot, keeping the
	// record reloc-free — and in rodata rather than rodata_relro — for a type
	// that needs no destruction).
	dg.Init = appendTerm(dg.Init, DataSymref(desc.DtorSym, 0))
	// words 1-2: size, align (the type's layout).
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, desc.Size))))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, desc.Align))))
	// words 3-4: name pointer (desc.NameSym, into the TU-local blob below) +
	// byte length.  The pointer is emitted ONLY when there is a name (and hence
	// a blob) — an empty name gives a null pointer + 0 length, keeping this word
	// reloc-free and never referencing a blob that was not emitted.
	var nameSym @[]char
	if len(desc.Name) > 0 { nameSym = desc.NameSym }
	dg.Init = appendTerm(dg.Init, DataSymref(nameSym, 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, len(desc.Name)))))
	// word 5: KIND discriminator.
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, desc.Kind))))
	// words 6-7: fields pointer + count ({ptr, len}).  The pointer is emitted
	// ONLY for a struct with >= 1 field (and hence a field-table blob) — an
	// absent/empty field table gives a null pointer + 0 count, keeping the word
	// reloc-free and never referencing a blob that was not emitted.
	var fieldsSym @[]char
	if len(desc.Fields) > 0 { fieldsSym = desc.FieldsSym }
	dg.Init = appendTerm(dg.Init, DataSymref(fieldsSym, 0))
	dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, len(desc.Fields)))))

	var out @[]@DataGlobal
	out = slices.Append[@DataGlobal](out, dg)
	// The name blob is TU-local (buildRodata → DG_LOCAL): the weak record
	// coalesces to one survivor, which references its own TU's blob.  Emitted
	// only when the record carries a name.
	if len(desc.Name) > 0 {
		out = slices.Append[@DataGlobal](out, buildRodata(desc.NameSym, desc.Name))
	}
	// The field-table blob + concatenated field-name blob (both TU-local, like
	// the name blob) — emitted only for a struct with >= 1 field.
	if len(desc.Fields) > 0 {
		out = slices.Append[@DataGlobal](out, buildFieldTable(desc, w))
		out = slices.Append[@DataGlobal](out, buildFieldNames(desc))
	}
	return out
}

// buildFieldTable lays the field-table blob (`__typefields.<T>`): one 6-word
// FieldEntry per field {name-ptr, name-len, offset, kind, size, typeinfo-ptr},
// in declaration order.  name-ptr references the concatenated field-name blob
// (desc.NamesSym) with the field's byte offset into it as the symref addend;
// typeinfo-ptr references the field type's own `__typeinfo` record when set
// (empty → null, until reflection recurses into nested structs).  TU-local,
// word-aligned, read-only; it carries relocations (name-ptr), so the native
// lowering routes it to rodata_relro automatically.
func buildFieldTable(desc @TypeInfoDesc, w int) @DataGlobal {
	var dg @DataGlobal = NewDataGlobal(desc.FieldsSym, DG_LOCAL, w, true)
	var nameOff int = 0
	for i := 0; i < len(desc.Fields); i++ {
		var f @FieldInfoDesc = desc.Fields[i]
		dg.Init = appendTerm(dg.Init, DataSymref(desc.NamesSym, nameOff))
		dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, len(f.Name)))))
		dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, f.Offset))))
		dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, f.Kind))))
		dg.Init = appendTerm(dg.Init, DataInt(w, cast(uint64, cast(int64, f.Size))))
		dg.Init = appendTerm(dg.Init, DataSymref(f.TypeInfoSym, 0))
		nameOff = nameOff + len(f.Name)
	}
	return dg
}

// buildFieldNames lays the concatenated field-name blob (`__typefieldnames.<T>`):
// every field name laid end to end (no separators), each FieldEntry's name
// pointer referencing it at that field's byte offset.  TU-local, align-1,
// read-only — exactly like the type-name blob.
func buildFieldNames(desc @TypeInfoDesc) @DataGlobal {
	var all @[]char
	for i := 0; i < len(desc.Fields); i++ {
		all = buf.Concat(all, desc.Fields[i].Name)
	}
	return buildRodata(desc.NamesSym, all)
}
