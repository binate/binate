package "pkg/binate/irdata"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// BuildTypeInfo lays the 8-word RTTI record (dtor, size, align, name-ptr,
// name-len, KIND, fields-ptr, field-count) plus, when the desc carries a name, a
// sibling name blob — returned as [record, name-blob] for a non-struct.  Word 0
// is the destructor handle desc.DtorSym; words 1–2 the size/align; words 3–4 the
// name pointer (desc.NameSym) + byte length; word 5 the KIND; words 6–7 the
// fields pointer + count (null/0 for a non-struct).  Weak so duplicate emissions
// coalesce to one record per type program-wide.  pinTarget64
// (data_pkg_descriptor_test.bn) fixes the word width.
func TestBuildTypeInfo() testing.TestResult {
	pinTarget64()
	var desc @TypeInfoDesc = make(TypeInfoDesc)
	desc.Sym = "_ti"
	desc.Size = 24
	desc.Align = 8
	desc.DtorSym = "_dtorhandle"
	desc.Name = "main.T"
	desc.NameSym = "_ti_name"
	desc.Kind = KIND_INT
	var dgs @[]@DataGlobal = BuildTypeInfo(desc)
	// [record, name-blob] — the name is non-empty, so the blob is emitted; a
	// non-struct desc (no Fields) emits no field-table / name blobs.
	if len(dgs) != 2 { return "expected [record, name-blob] when desc has a name and no fields" }
	var ti @DataGlobal = dgs[0]

	if ti.Linkage != DG_WEAK { return "TypeInfo should be weak" }
	if !ti.ReadOnly { return "TypeInfo should be read-only" }
	if len(ti.Init) != 8 {
		// 8-word TypeInfo record (§7.13.14)
		return "expected an 8-word TypeInfo record"
	}
	// Word 0 carries desc.DtorSym as a symref.
	if ti.Init[0].Kind != DT_SYMREF || !charEq(ti.Init[0].Sym, "_dtorhandle") {
		return "word 0 (dtor) should be a symref to desc.DtorSym"
	}
	// Size / align words carry the desc's layout at 1, 2.
	if ti.Init[1].Kind != DT_INT || ti.Init[1].IntVal != cast(uint64, 24) {
		return "word 1 (size) should carry desc.Size"
	}
	if ti.Init[2].Kind != DT_INT || ti.Init[2].IntVal != cast(uint64, 8) {
		return "word 2 (align) should carry desc.Align"
	}
	// Word 3 is the name pointer (symref to desc.NameSym); word 4 its byte length.
	if ti.Init[3].Kind != DT_SYMREF || !charEq(ti.Init[3].Sym, "_ti_name") {
		return "word 3 (name pointer) should be a symref to desc.NameSym"
	}
	if ti.Init[4].Kind != DT_INT || ti.Init[4].IntVal != cast(uint64, 6) {
		return "word 4 (name-len) should be the name's byte length (len(\"main.T\")=6)"
	}
	// Word 5 is the KIND; words 6–7 are the fields pointer + count (null/0 here).
	if ti.Init[5].Kind != DT_INT || ti.Init[5].IntVal != cast(uint64, KIND_INT) {
		return "word 5 (kind) should carry desc.Kind"
	}
	if ti.Init[6].Kind != DT_SYMREF || len(ti.Init[6].Sym) != 0 {
		return "word 6 (fields pointer) should be a null symref for a non-struct"
	}
	if ti.Init[7].Kind != DT_INT || ti.Init[7].IntVal != cast(uint64, 0) {
		return "word 7 (field count) should be 0 for a non-struct"
	}
	// The name blob carries the name bytes.
	var blob @DataGlobal = dgs[1]
	if blob.Linkage != DG_LOCAL { return "name blob should be TU-local" }
	if len(blob.Init) != 1 || blob.Init[0].Kind != DT_BYTES {
		return "name blob should be a single byte-run term"
	}
	if !charEq(blob.Init[0].Bytes, "main.T") {
		return "name blob should hold the name bytes"
	}
	return ""
}

// BuildTypeInfo with an empty DtorSym / empty Name (a type that needs no
// destruction and carries no name) lays a NULL word-0 and word-3 slot and emits
// NO name blob, keeping the record reloc-free — the list is just [record].
func TestBuildTypeInfoNullDtor() testing.TestResult {
	pinTarget64()
	var desc @TypeInfoDesc = make(TypeInfoDesc)
	desc.Sym = "_ti"
	desc.Size = 8
	desc.Align = 8
	var dgs @[]@DataGlobal = BuildTypeInfo(desc)
	if len(dgs) != 1 { return "expected just [record] when desc has no name" }
	var ti @DataGlobal = dgs[0]
	if len(ti.Init) != 8 { return "expected an 8-word TypeInfo record" }
	if ti.Init[0].Kind != DT_SYMREF || len(ti.Init[0].Sym) != 0 {
		return "word 0 (dtor) should be a null symref when DtorSym is empty"
	}
	if ti.Init[3].Kind != DT_SYMREF || len(ti.Init[3].Sym) != 0 {
		return "word 3 (name) should be a null symref when Name is empty"
	}
	if ti.Init[4].Kind != DT_INT || ti.Init[4].IntVal != cast(uint64, 0) {
		return "word 4 (name-len) should be 0 when Name is empty"
	}
	if ti.Init[6].Kind != DT_SYMREF || len(ti.Init[6].Sym) != 0 {
		return "word 6 (fields) should be a null symref for a non-struct"
	}
	if ti.Init[7].Kind != DT_INT || ti.Init[7].IntVal != cast(uint64, 0) {
		return "word 7 (field count) should be 0 for a non-struct"
	}
	return ""
}

// A struct desc (KIND_STRUCT with Fields) emits [record, name-blob, fields-blob,
// names-blob].  The record's word 6 points at the field-table blob and word 7 is
// the field count; each 6-word FieldEntry carries {name-ptr (a symref into the
// concatenated names blob with the field's byte offset as addend), name-len,
// offset, kind, size, typeinfo-ptr}; the names blob holds the field names laid
// end to end.
func TestBuildTypeInfoFields() testing.TestResult {
	pinTarget64()
	var desc @TypeInfoDesc = make(TypeInfoDesc)
	desc.Sym = "_ti"
	desc.Size = 16
	desc.Align = 8
	desc.Name = "main.P"
	desc.NameSym = "_ti_name"
	desc.Kind = KIND_STRUCT
	desc.FieldsSym = "_ti_fields"
	desc.NamesSym = "_ti_names"
	var f0 @FieldInfoDesc = make(FieldInfoDesc)
	f0.Name = "x"
	f0.Offset = 0
	f0.Kind = KIND_INT
	f0.Size = 8
	var f1 @FieldInfoDesc = make(FieldInfoDesc)
	f1.Name = "yy"
	f1.Offset = 8
	f1.Kind = KIND_INT
	f1.Size = 8
	desc.Fields = slices.Append[@FieldInfoDesc](desc.Fields, f0)
	desc.Fields = slices.Append[@FieldInfoDesc](desc.Fields, f1)

	var dgs @[]@DataGlobal = BuildTypeInfo(desc)
	if len(dgs) != 4 {
		return "expected [record, name-blob, fields-blob, names-blob] for a struct with fields"
	}
	var ti @DataGlobal = dgs[0]
	if ti.Init[5].Kind != DT_INT || ti.Init[5].IntVal != cast(uint64, KIND_STRUCT) {
		return "word 5 (kind) should be KIND_STRUCT"
	}
	if ti.Init[6].Kind != DT_SYMREF || !charEq(ti.Init[6].Sym, "_ti_fields") {
		return "word 6 (fields pointer) should be a symref to desc.FieldsSym"
	}
	if ti.Init[7].Kind != DT_INT || ti.Init[7].IntVal != cast(uint64, 2) {
		return "word 7 (field count) should be len(desc.Fields)"
	}

	// Field-table blob: 2 fields x 8 words = 16 terms.  Each entry is {name-ptr,
	// name-len, offset, kind, size, typeinfo-ptr, elem-kind, elem-size}.
	var fields @DataGlobal = dgs[2]
	if fields.Linkage != DG_LOCAL { return "fields blob should be TU-local" }
	if len(fields.Init) != 16 { return "fields blob should hold 8 words per field" }
	// Field 0: name-ptr = symref(names, addend 0), name-len 1, offset 0, kind, size 8,
	// null typeinfo, elem-kind/elem-size 0 (a scalar int is not an array/slice).
	if fields.Init[0].Kind != DT_SYMREF || !charEq(fields.Init[0].Sym, "_ti_names") ||
			fields.Init[0].Addend != 0 {
		return "field 0 name-ptr should be a symref to the names blob at addend 0"
	}
	if fields.Init[1].Kind != DT_INT || fields.Init[1].IntVal != cast(uint64, 1) {
		return "field 0 name-len should be len(\"x\")=1"
	}
	if fields.Init[3].Kind != DT_INT || fields.Init[3].IntVal != cast(uint64, KIND_INT) {
		return "field 0 kind should be KIND_INT"
	}
	if fields.Init[5].Kind != DT_SYMREF || len(fields.Init[5].Sym) != 0 {
		return "field 0 typeinfo-ptr should be null (scalar field has no record)"
	}
	if fields.Init[6].Kind != DT_INT || fields.Init[6].IntVal != cast(uint64, 0) {
		return "field 0 elem-kind should be 0 (not an array/slice)"
	}
	if fields.Init[7].Kind != DT_INT || fields.Init[7].IntVal != cast(uint64, 0) {
		return "field 0 elem-size should be 0 (not an array/slice)"
	}
	// Field 1: name-ptr = symref(names, addend 1 — after "x"), name-len 2, offset 8.
	if fields.Init[8].Kind != DT_SYMREF || !charEq(fields.Init[8].Sym, "_ti_names") ||
			fields.Init[8].Addend != 1 {
		return "field 1 name-ptr should be a symref to the names blob at addend 1"
	}
	if fields.Init[9].Kind != DT_INT || fields.Init[9].IntVal != cast(uint64, 2) {
		return "field 1 name-len should be len(\"yy\")=2"
	}
	if fields.Init[10].Kind != DT_INT || fields.Init[10].IntVal != cast(uint64, 8) {
		return "field 1 offset should be 8"
	}

	// Names blob: the field names concatenated ("x" + "yy").
	var names @DataGlobal = dgs[3]
	if names.Linkage != DG_LOCAL { return "names blob should be TU-local" }
	if len(names.Init) != 1 || names.Init[0].Kind != DT_BYTES || !charEq(names.Init[0].Bytes, "xyy") {
		return "names blob should hold the concatenated field names"
	}
	return ""
}
