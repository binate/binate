// Package irgather is the per-module static-data / RTTI gather: it walks a module to
// decide which records each backend must emit -- the per-type records, the interface
// identity markers and the satisfaction entries -- and which markers the package
// descriptor lists for a host to bind.  The records' byte layout lives in the
// leaf package pkg/binate/irdata (DataGlobal and the Build* builders), which imports
// neither this package nor pkg/binate/ir; every backend emits the same set because each
// reads it from here.
package "pkg/binate/irgather"

import "pkg/binate/ir"
import "pkg/binate/irdata"

// CollectTypeInfoDescs returns the distinct per-type records module `m` must
// emit — one per TypeInfoEntry in the per-type registry (m.TypeInfos), each
// with that type's size/align/name read (at codegen) off the entry's held
// RecvTyp.  Each backend iterates it and emits irdata.BuildTypeInfo(desc).
func CollectTypeInfoDescs(m @ir.Module) @[]@irdata.TypeInfoDesc

// CollectIfaceIdSyms returns the distinct IfaceId marker symbols module `m` must
// emit — one per canonical interface in m.Interfaces (aliases skipped, `any`
// included), deduped.  Each backend iterates it and emits irdata.BuildIfaceId(sym).
func CollectIfaceIdSyms(m @ir.Module) @[]@[]char

// CollectLookupIfaceIdSyms returns the distinct IfaceId marker symbols module m's
// code looks a box up with (each OP_SAT_LOOKUP's interface operand), in first-use
// order.  The package descriptor lists them (reflect.Package.IfaceIds) for a
// bytecode-VM host to bind to the native markers.
func CollectLookupIfaceIdSyms(m @ir.Module) @[]@[]char

// CollectSatEntries returns the distinct satisfaction entries module `m` must
// emit — one per `(RecvPkg, RecvTypeName, IfacePkg, IfaceName)` across m.Impls
// (which already includes every transitive ancestor), deduped by entry symbol.
// Each backend iterates it and emits irdata.BuildSatEntry(desc).
func CollectSatEntries(m @ir.Module) @[]@irdata.SatEntryDesc
