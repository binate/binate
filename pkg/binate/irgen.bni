// Package irgen lowers a type-checked AST into ir's IR: it builds Modules,
// Funcs, Blocks and Instrs (via the ir data model + irutil helpers), resolves
// cross-package types, and emits dtor/copy/init glue.  It is the generation
// half split out of the ir package.
package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/types"

// IR Generation
// ============================================================

// GenModule lowers an AST file into a complete IR module, recording `c`
// as the module's type-Checker (m.Checker).
func GenModule(c @types.Checker, file @ast.File) @ir.Module

// InitModule creates a new empty module for incremental IR generation.
// Callers set m.Checker (the type-Checker that produced the typed AST)
// before any GeneratePackage / GenDecl on the module so IR-gen can
// consult per-expression resolved types; nil is safe (legacy fallback).
func InitModule(name @[]char) @ir.Module

// AliasMapSnapshot captures a module's ImportAliasNames/Paths so a scope that
// temporarily overlays a different package's imports on the module's alias map
// (monomorphized generic-body emission; the per-file import overlay) can restore
// them afterward.
type AliasMapSnapshot struct {
	Names @[]@[]char
	Paths @[]@[]char
}

// RecordImportPath maps an import alias to its full package path so
// cross-package symbols mangle under the importee's path. Normally
// invoked from RegisterImports' Pass 0; exposed for callers that
// need to seed the alias map directly.  m is the module whose alias
// map the (alias, path) pair is recorded into.
func RecordImportPath(m @ir.Module, alias *[]readonly char, path *[]readonly char)

// GenCtx is the per-compilation transient IR-generation context: the
// state scoped to one compilation (a package's full
// register-imports → register-self-types → GeneratePackage sweep, or a
// REPL session) rather than to a single function (that is the
// package-private GenContext).  The caller creates one per compilation
// and threads it through every gen entry point below, so the import
// pre-passes and GeneratePackage share one context.  Reentrancy carrier:
// it carries what used to be process-global
// ambient IR-gen state so two sequential or interleaved compilations in
// one process don't share it.
type GenCtx struct {
	// Mod is the IR Module being populated by this compilation.
	// nil outside any module-gen context.
	Mod @ir.Module
	// PkgPath is the package path used to qualify bare same-package
	// names during this gen phase.  It is phase-scoped, NOT always
	// Mod.PkgPath: GeneratePackage / GenModule set it from the module's
	// path, RegisterSelfTypes sets it from the .bni's path for the
	// duration of that pass, and the import pre-passes leave it empty.
	PkgPath @[]char
	// AnonStructCounter assigns synthetic `__anon_<n>` names to anonymous
	// struct types during this compilation.
	AnonStructCounter int
	// FuncLitCounter assigns synthetic `__funclit_<n>` ids to lifted
	// function literals (and `__mv_local_..._<n>` method-value closures)
	// during this compilation.  Reset at the start of each
	// GeneratePackage / GenModule (resetFuncLitState) so each package's
	// ids start at 0.
	FuncLitCounter int
	// CurrentTypeParamNames / CurrentTypeParamTypes are the active
	// generic-instantiation substitution context: while IR-gen emits a
	// specialized instantiation `f[T1, ...]`, Names lists the AST-level
	// type-param names and Types the parallel concrete @types.Type to
	// substitute (resolveTypeExpr consults them).  Empty outside any
	// instantiation; saved/restored around each ensureInstantiated*.
	CurrentTypeParamNames @[]@[]char
	CurrentTypeParamTypes @[]@types.Type
	// EmittedInstantiations records every monomorphized generic
	// instantiation already emitted this compilation, keyed by mangled
	// name, so a call site emits one IR func per unique `f[T](...)`.
	EmittedInstantiations @[]@[]char
	// GenericDecls / GenericDeclPkgs are the parallel per-compilation
	// registry of generic function AST decls and each decl's defining
	// package (current module's pkg for local decls, the import alias for
	// imported ones); lookupGenericDeclPkg disambiguates by both.
	GenericDecls    @[]@ast.Decl
	GenericDeclPkgs @[]@[]char
	// GenericTypeDecls / GenericTypeDeclPkgs: same, for generic struct decls.
	GenericTypeDecls    @[]@ast.Decl
	GenericTypeDeclPkgs @[]@[]char
	// GenericIfaceDecls / GenericIfaceDeclPkgs: same, for generic interface decls.
	GenericIfaceDecls    @[]@ast.Decl
	GenericIfaceDeclPkgs @[]@[]char
	// GenericDeclFiles / GenericTypeDeclFiles / GenericIfaceDeclFiles record,
	// parallel to the matching decl registries above, the AST file each generic
	// decl was defined in — so its body's package-qualified references are
	// lowered against THAT file's imports at the (later, possibly cross-package)
	// instantiation site, not the consumer's alias map.  Without this a generic
	// body that calls `dep.X()` / names `dep.T` (dep imported by the generic's
	// package, not the consumer) mis-resolves: dangling symbol or wrong-package
	// layout.  See lookupGenericDeclFile and ensureInstantiated*.
	GenericDeclFiles      @[]@ast.File
	GenericTypeDeclFiles  @[]@ast.File
	GenericIfaceDeclFiles @[]@ast.File
	// GenericMethodDecls / GenericMethodDeclPkgs / GenericMethodDeclFiles are
	// the parallel registry of methods whose receiver is a generic-type
	// instantiation (`func (it *Cursor[T]) Next()`, gen.method.generic-recv).
	// Unlike generic functions these carry no decl-level TypeParams (the
	// binders come from the receiver), so the concrete-method passes skip them
	// and stash them here; ensureInstantiatedMethods emits one monomorphized
	// body per struct instantiation, keyed by the receiver's generic base name
	// + defining package.  Files record each method's defining file for the
	// same import-overlay reason as GenericDeclFiles.
	GenericMethodDecls     @[]@ast.Decl
	GenericMethodDeclPkgs  @[]@[]char
	GenericMethodDeclFiles @[]@ast.File
	// InitOverlay{Files,Merged,Base} drive a per-STATEMENT import overlay while
	// lowering the synthetic package `__init` body.  That body COMBINES every
	// file's top-level `var x = expr` initializers into one function, so a single
	// merged overlay mis-resolves a cross-file same-alias initializer (file a:
	// `import dep "pkg/p1"; var A = dep.V()`; file b: `import dep "pkg/p2"; var B
	// = dep.V()` — both `dep` collapse to one package).  When InitOverlayMerged
	// is non-nil, genBlock switches the overlay to each init statement's own file
	// (by `Pos.File`, via declImportFile(Files, Merged, ...) restored onto Base)
	// before lowering it — the @init analogue of the GenericDeclFiles fix above.
	InitOverlayFiles  @[]@ast.File
	InitOverlayMerged @ast.File
	InitOverlayBase   AliasMapSnapshot
	// EmitNilChecks, when set for this compilation, makes IR-gen emit an
	// OP_NIL_CHECK + recoverable cleanup pad before each pointer deref — opt-in
	// nil-pointer-deref checking (a VM/REPL recovery aid).  Default false ⇒ no
	// checks emitted, so the IR is
	// byte-for-byte the pre-feature form.  The VM turns a nil deref into a
	// RECOVERABLE fault; compiled backends no-op OP_NIL_CHECK and stay C-like.
	EmitNilChecks bool
	// OptLevel is the IR optimization level this compilation will run
	// (`iropt.RunOptPasses(mod, OptLevel)` — the same value).  Gen reads it to
	// pick opt-level-dependent lowering shapes that must agree with what the
	// opt passes then expect: currently, at OptLevel >= 1 a managed struct
	// local's cleanup is emitted as inline per-field RefDecs (SROA-forwardable)
	// rather than a by-address `__dtor_T` call.  Default 0 (-O0) is always
	// safe — the by-address shape is correct, just not SROA-able — so a caller
	// that leaves it unset only forgoes an optimization, never correctness.
	OptLevel int
}

// NewGenCtx creates a per-compilation gen context bound to module m,
// seeding PkgPath from m.PkgPath (empty when m is nil or its path isn't
// set yet — e.g. during import registration before GeneratePackage).
func NewGenCtx(m @ir.Module) @GenCtx

// RegisterImport registers a single imported package for IR generation.
// path is the import path (e.g. "pkg/binate/loader") — used to seed the
// alias→path map; for a cmd package whose declared name is "main"
// the path is what the importee compiles under (e.g. "cmd/bnc"), not
// file.PkgName, so passing it explicitly avoids the "main"-derived
// misqualification.
func RegisterImport(alias @[]char, path *[]readonly char, file @ast.File, gc @GenCtx)

// RegisterImports registers multiple imported packages for IR
// generation. paths is parallel to aliases (same length, same order)
// and carries each import's path (see RegisterImport).
func RegisterImports(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterImportFuncSigs is RegisterImports without adding the imported extern
// Func entries: it registers the callees' signatures for call-site resolution
// but leaves the module's func table untouched (the REPL's mid-session import,
// so a following per-decl LowerOneFunc's indices stay in sync with the VM).
func RegisterImportFuncSigs(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterStructTypes registers struct types from imported packages
// into the type system. paths is parallel to aliases and used
// DIRECTLY for qualified-name construction (so two packages sharing
// a last-segment short alias still get distinct qualifiers).
func RegisterStructTypes(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterAllInterfaces registers DECL_INTERFACE entries from
// every loaded package (including transitive deps), so cross-
// package alias-chain resolution works even when the importing
// TU doesn't reference the alias's underlying interface package
// directly.
// paths is parallel to aliases and used directly for the
// interface's Pkg field (so two packages sharing a last-segment
// short alias still record distinct interfaces).
func RegisterAllInterfaces(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// FindInterfaceMethodSlot resolves (ifacePkg, ifaceName, methodName) against the
// module's interface registry to the method's absolute vtable slot plus its
// declared result types, param types, and last-param variadic flag (slot -1 if not
// found).  For host-driven interface dispatch (interp's CallIfaceMethod).
func FindInterfaceMethodSlot(m @ir.Module, ifacePkg *[]readonly char, ifaceName *[]readonly char,
		methodName *[]readonly char) (int, @[]@types.Type, @[]@types.Type, bool)

// RegisterFuncExterns registers ONLY function/method signatures + extern
// Funcs for the given packages (keyed by full path via `paths`), deduped
// against already-registered sigs.  For packages a monomorphized cross-package
// generic body may CALL but that the consumer does not directly import: their
// structs/interfaces are registered transitively (RegisterStructTypes /
// RegisterAllInterfaces), so only the func externs — the `declare`s the body's
// calls need to link — are missing.  Without these, a generic body calling
// `dep.V()` from a package the consumer does not import emits a call to an
// undeclared symbol (LLVM "use of undefined value"); the VM is unaffected.
func RegisterFuncExterns(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterGenericDecls stashes generic func/struct/interface decls for the
// given packages (keyed by full path via `paths`), deduped via the
// lookupGeneric*DeclPkg checks.  RegisterImport stashes generic decls only
// for the consumer's DIRECT imports; a generic body that instantiates ANOTHER
// package's generic (a transitive, not direct, import) needs that package's
// generic decl available to monomorphize it.  Registers ONLY generic decls;
// non-generic structs/sigs/consts/interfaces are handled elsewhere
// (RegisterStructTypes / RegisterImports / RegisterFuncExterns).
func RegisterGenericDecls(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterImportedImpls collects the given packages' impls into
// gc.Mod.ImportedImpls (deduped), so a generic body monomorphized at the
// consumer can upcast a receiver to an interface defined in a TRANSITIVELY-
// imported package — the upcast needs the imported impl's vtable symbol wired.
// collectImportedImplsFromDecl otherwise runs only over direct imports; without
// this a transitive-package upcast inside a monomorphized generic body produced
// a nil vtable (SIGSEGV).
func RegisterImportedImpls(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterSelfTypes registers struct types from the package's own .bni
// file.  `c` is the type-Checker (for pending-decl / const resolution);
// `gc` is the per-compilation context whose Mod is the module
// GeneratePackage will fill (self structs/aliases land in its per-module
// tables).  Sets gc.PkgPath to the .bni's package path for the duration
// of the pass, then restores it.
func RegisterSelfTypes(c @types.Checker, bniFile @ast.File, gc @GenCtx)

// GeneratePackage lowers an AST file into IR and adds it to the module
// gc.Mod, recording `c` as that module's type-Checker (Mod.Checker) for
// per-expression resolved types.  `files` are the package's per-file impl
// ASTs (loader.Package.Files); they make imports FILE-scoped (each decl's
// qualifiers resolve against its own file's imports).  Pass an empty slice for
// a single-file / synthetic module to fall back to the merged-imports overlay.
// Sets gc.Mod.PkgPath (and gc.PkgPath) from the module's name.
func GeneratePackage(c @types.Checker, file @ast.File, gc @GenCtx, files @[]@ast.File)

// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point.  `gc` supplies the module
// context (incl. gc.Mod.Checker); requires the surrounding module state
// to already be initialized via a prior GenModule / GeneratePackage call.
func GenSyntheticFunc(gc @GenCtx, name @[]char, body @[]@ast.Stmt) @ir.Func

// GenDecl IR-gens a single top-level declaration against the
// existing module gc.Mod and registers it for subsequent IR
// references.  REPL entry point for Tier 2.  Returns "" on
// success or a diagnostic message on a not-yet-supported kind.
// First cut: DECL_FUNC only (no methods, no type / var / const).
func GenDecl(d @ast.Decl, gc @GenCtx) @[]char

// GenConstMember registers a single resolved const-group
// member in moduleConsts using the given iota position.  REPL
// entry point for retryPending when a previously-parked const
// inside a `const ( ... )` group resolves: pass the member's
// IotaIdx (captured at park time and stored on the PendingDecl)
// so the value reflects its source-order position.
func GenConstMember(d @ast.Decl, gc @GenCtx, iotaIdx int)

// EnsureReplBodyHelpers drains managed-aggregate types registered
// during the most-recent prompt body's IR-gen into freshly-emitted
// `__dtor_<T>` / `__copy_<T>` helpers appended to `m.Funcs`,
// dedup'd against helpers already present.  Resets the pending
// lists on return.  Caller (REPL driver) is responsible for
// lowering the new entries: capture `helpersStart := len(m.Funcs)`
// before the call and lower `m.Funcs[helpersStart:]` afterwards.
// Lower helpers BEFORE the body that references them so the
// body's eager `CallCache` fill resolves every helper name.
//
// Counterpart to the in-decl `ensureReplStructHelpers` path that
// runs from `GenDecl` when a fresh `type` decl introduces a
// managed-field struct: together they cover both ways a prompt
// entry can introduce a new aggregate shape (typing the struct,
// or typing a body that uses an `@[]T` shape).
func EnsureReplBodyHelpers(m @ir.Module)

// MakeInitAssignStmt builds an `<d.Name> = <d.Value>` AST
// assignment for a `var x T = expr` declaration.  Caller is
// expected to wrap the result (alone or with peers) in a
// stmt list and pass it to GenSyntheticFunc — this is the
// one-shot synthetic the REPL uses to run a fresh prompt-level
// var's initializer right after registering the global.
//
// Caller must guarantee `d.Kind == DECL_VAR && d.Value != nil`
// and that d.Name is not the blank identifier.
func MakeInitAssignStmt(d @ast.Decl) @ast.Stmt

// ============================================================
