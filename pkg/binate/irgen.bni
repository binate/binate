// Package irgen lowers a type-checked AST into ir's IR: it builds Modules,
// Funcs, Blocks and Instrs (via the ir data model + irutil helpers), resolves
// cross-package types, and emits dtor/copy/init glue.  It is the generation
// half split out of the ir package.
package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/std/cmp"
import "pkg/std/containers/table"
import "pkg/std/hash"

// IR Generation
// ============================================================

// GenModule lowers an AST file into a complete IR module, recording `c`
// as the module's type-Checker (m.Checker).  IR-gen is defined only on a
// program its checker checked: a nil `c` is an internal error, here and in
// RegisterSelfTypes and GeneratePackage.
func GenModule(c @check.Checker, file @ast.File) @ir.Module

// InitModule creates a new empty module for incremental IR generation.
// Callers set m.Checker (the type-Checker that produced the typed AST)
// before any IR-gen pass on the module -- the import pre-passes,
// RegisterSelfTypes, GeneratePackage, GenDecl -- so IR-gen can consult
// per-expression resolved types.
func InitModule(name @[]char) @ir.Module

// GenCtx is the per-compilation transient IR-generation context: the
// state scoped to one compilation (a package's full
// register-imports → register-self-types → GeneratePackage sweep, or a
// REPL session) rather than to a single function (that is the
// package-private GenContext).  The caller creates one per compilation
// and threads it through every gen entry point below, so the import
// pre-passes and GeneratePackage share one context.  Reentrancy carrier:
// it carries the ambient IR-gen state, so two sequential or interleaved
// compilations in one process don't share it.
type GenCtx struct {
	// Mod is the IR Module being populated by this compilation.
	// nil outside any module-gen context.
	Mod @ir.Module
	// PkgPath is the package path used to qualify bare same-package
	// names during this gen phase.  It is phase-scoped, NOT always
	// Mod.PkgPath: GeneratePackage / GenModule set it from the module's
	// path, RegisterSelfTypes sets it from the .bni's path for the
	// duration of that pass, and the import pre-passes leave it empty.
	PkgPath @[]char
	// AnonStructCounter assigns synthetic `__anon_<n>` names to anonymous
	// struct types during this compilation.
	AnonStructCounter int
	// FuncLitCounter assigns synthetic `__funclit_<n>` ids to lifted
	// function literals (and `__mv_local_<n>` method-value closure records)
	// during this compilation.  Reset at the start of each
	// GeneratePackage / GenModule (resetFuncLitState) so each package's
	// ids start at 0.
	FuncLitCounter int
	// GlobalInitFunc is the qualified name of the function being generated by
	// GenGlobalInitFunc (a function whose body initializes package-level
	// variables), or empty.  A raw-slice literal generated directly in that
	// function gets a program-lifetime global backing.
	GlobalInitFunc @[]char
	// PendingNamedTypes holds the qualified names of named non-struct types
	// registered in Module.TypeAliases whose underlying is not resolved yet
	// (preRegisterNamedTypeDecl; registerTypeDeclEntry resolves it): a set, each
	// entry's value the name its key borrows; nil until the first is added.
	PendingNamedTypes @table.Table[*[]readonly char, @[]char, irdata.FuncSigHasher, irdata.FuncSigEq]
	// EmittedInstantiations records every monomorphized generic
	// instantiation already emitted this compilation, keyed by mangled
	// name, so a call site emits one IR func per unique `f[T](...)`.
	EmittedInstantiations @[]@[]char
	// GenericDecls / GenericDeclPkgs are the parallel per-compilation
	// registry of generic function AST decls and each decl's defining
	// package (current module's pkg for local decls, the package's path for
	// imported ones); lookupGenericDeclPkg disambiguates by both.
	GenericDecls    @[]@ast.Decl
	GenericDeclPkgs @[]@[]char
	// ReplacedGenericFuncs[i] is a generic function that a REPL redefinition of
	// the same signature replaced in GenericDecls, at index
	// ReplacedGenericSlots[i]: the code checked before the redefinition names it
	// (as the owner of its type parameters) and reaches the declaration that
	// index holds now (stashedGenericFunc).
	ReplacedGenericFuncs @[]@ast.Decl
	ReplacedGenericSlots @[]int
	// GenericTypeDecls / GenericTypeDeclPkgs: same, for generic struct decls.
	GenericTypeDecls    @[]@ast.Decl
	GenericTypeDeclPkgs @[]@[]char
	// GenericIfaceDecls / GenericIfaceDeclPkgs: same, for generic interface decls.
	GenericIfaceDecls    @[]@ast.Decl
	GenericIfaceDeclPkgs @[]@[]char
	// GenericMethodDecls / GenericMethodDeclPkgs are the parallel registry of
	// methods whose receiver is a generic-type instantiation
	// (`func (it *Cursor[T]) Next()`, gen.method.generic-recv).  Unlike generic
	// functions these carry no decl-level TypeParams (the binders come from the
	// receiver), so the concrete-method passes skip them and stash them here;
	// ensureInstantiatedMethods emits one monomorphized body per struct
	// instantiation, keyed by the receiver's generic base name + defining
	// package.
	GenericMethodDecls    @[]@ast.Decl
	GenericMethodDeclPkgs @[]@[]char
	// GenericImplDecls / GenericImplDeclPkgs are the parallel registry of
	// PARAMETERIZED impls (`impl *Box[T] : GJ[T]`, whose receiver is a generic
	// type): impl collection skips them, and ensureGenericImplRows mints an
	// instantiation's concrete rows from them when a value of it is boxed.
	// GenericImplMinted[i] lists the struct instantiations whose rows for impl i
	// were already minted into Mod, so repeated boxing sites of one instantiation
	// mint once.
	GenericImplDecls    @[]@ast.Decl
	GenericImplDeclPkgs @[]@[]char
	GenericImplMinted   @[]@[]@[]char
	// PendingIfaceAliasDecls / Pkgs record, in parallel, each interface alias of
	// a generic instantiation (`interface X = G[int]`) that registerIfaceStub
	// registered as an identity stub only: its declaration and package.  A type
	// argument naming one completes it on first use (completeIfaceAliasStub), so
	// the instance it names is the same whenever the type is resolved.
	// PendingIfaceAliasDone marks one completed or being completed.
	PendingIfaceAliasDecls @[]@ast.Decl
	PendingIfaceAliasPkgs  @[]@[]char
	PendingIfaceAliasDone  @[]bool
	// EmitNilChecks, when set for this compilation, makes IR-gen emit an
	// OP_NIL_CHECK + recoverable cleanup pad before each pointer deref — opt-in
	// nil-pointer-deref checking (a VM/REPL recovery aid).  Default false ⇒ no
	// checks emitted, so the IR is
	// byte-for-byte the pre-feature form.  The VM turns a nil deref into a
	// RECOVERABLE fault; compiled backends no-op OP_NIL_CHECK and stay C-like.
	EmitNilChecks bool
	// ReplSession is set for a REPL session's module: a type its file only
	// forward-declares may be defined at a later prompt, so it is registered as a
	// prompt's forward type is, with an empty placeholder destructor until then,
	// rather than as an opaque type whose destructor only a definition elsewhere
	// in the program could supply (registerUndefinedForwardTypes).  And a
	// value-receiver method of a generic type's instance is emitted with its
	// interface-dispatch thunk (addReplRecvThunk), not after the package's bodies:
	// the REPL builds an entry's vtables as soon as it lowers the entry.
	ReplSession bool
	// SroaCleanupShape is set when this compilation will run the SROA pass
	// (iropt PASS_SROA).  Gen then emits the cleanup shapes SROA can split: a
	// managed struct local's cleanup as inline per-field RefDecs (SROA-
	// forwardable) rather than a by-address `__dtor_T` call.  Default false is
	// always safe — the by-address shape is correct, just not SROA-able — so a
	// caller that leaves it unset only forgoes an optimization, never
	// correctness; the split shape is equally correct when SROA doesn't run.
	SroaCleanupShape bool
	// ReplEntry, while a REPL prompt entry is generated (BeginReplEntry), records
	// what that generation replaces, for UndoReplEntry; nil otherwise.
	ReplEntry @ReplEntry
	// NamingInstances is set while the checker's instance records are named
	// (matchInstanceCopy): a named type, or a generic struct or interface
	// instance, the checker's types name maps to a placeholder that carries only
	// its name, so naming a record neither looks anything up nor registers it.
	NamingInstances bool
	// InstanceCopyNames memoizes, per checked instance copy (check.InstanceBody's
	// Clone), the name in this module of the instance it is the copy of.
	InstanceCopyNames @table.Table[@ast.Decl, @[]char, DeclHasher, DeclEq]
	// RecordMappings counts the record mappings in progress (typeFromRecord nests
	// through registration), and AliasesMapped holds, while there are any, what
	// each checker alias met so far mapped to (irAliasFromChecker): made on the
	// first alias, dropped when the outermost mapping ends.
	RecordMappings int
	AliasesMapped  @table.Table[@types.Type, @types.Type, TypeHasher, TypeEq]
	// AliasDecls maps the checker's type for each alias declaration IR-gen has
	// registered (registerTypeDeclEntry) to that registration, so a mapping of a
	// chain of aliases stops at the first one registered (irAliasFromChecker).
	AliasDecls @table.Table[@types.Type, AliasDecl, TypeHasher, TypeEq]
	// ConcreteRecords holds the checker records requireConcreteRecord found concrete,
	// and the types on the chain of one-part types it followed to find it, so a record
	// over one of them (an alias of an alias, ...) is found concrete at it.
	ConcreteRecords @table.Table[@types.Type, bool, TypeHasher, TypeEq]
	// GlobalPrefixCounts holds, for each prefix newPackageStaticSlot names a hidden
	// global by, how many of Mod.Globals carry it (globalsWithPrefix), so naming one
	// costs time independent of the module's globals.  Its keys are the callers'
	// constant prefixes.
	GlobalPrefixCounts @table.Table[*[]readonly char, @GlobalPrefixCount, irdata.FuncSigHasher,
			irdata.FuncSigEq]
	// EqHelpers are the struct-equality helpers emitted into Mod (eqHelperFor), each
	// kept while Mod.Funcs still holds it at its index: a REPL entry undone pops the
	// functions it added, its helpers with them.
	EqHelpers @[]EqHelper
}

// AliasDecl is GenCtx.AliasDecls's record of a registered alias declaration: the
// name it is registered under and the type it was registered with.
type AliasDecl struct {
	Name @[]char
	Typ  @types.Type
}

// GlobalPrefixCount is a count of GenCtx.GlobalPrefixCounts: of the first UpTo of
// Mod.Globals, N carry the prefix, At being the last of them -- a count resumes there
// unless At has moved (a writer cut Globals: the REPL's rollback; no global is added
// to a module twice, so a global added after a cut is never At).
type GlobalPrefixCount struct {
	N    int
	UpTo int
	At   @ir.Global
}

// EqHelper is a struct-equality helper emitted into a module (GenCtx.EqHelpers): its
// name, its function and its index in the module's Funcs.
type EqHelper struct {
	Name  @[]char
	Fn    @ir.Func
	Index int
}

// DeclHasher / DeclEq are the zero-size policies of GenCtx.InstanceCopyNames,
// which keys a declaration by its identity (bodies in gen_generic_copy.bn).
type DeclHasher struct {}

impl DeclHasher : hash.Hasher[@ast.Decl]

// DeclHasher.Hash hashes a declaration's address.
func (h DeclHasher) Hash(k @ast.Decl) uint

// DeclEq is the identity equality paired with DeclHasher.
type DeclEq struct {}

impl DeclEq : cmp.Eq[@ast.Decl]

// DeclEq.Equal reports whether a and b are the same declaration.
func (e DeclEq) Equal(a @ast.Decl, b @ast.Decl) bool

// TypeHasher / TypeEq key a checker type by its identity: GenCtx.AliasesMapped,
// and the types a walk over a checker type has reached (bodies in
// gen_type_record.bn).
type TypeHasher struct {}

impl TypeHasher : hash.Hasher[@types.Type]

// TypeHasher.Hash hashes a type's address.
func (h TypeHasher) Hash(k @types.Type) uint

// TypeEq is the identity equality paired with TypeHasher.
type TypeEq struct {}

impl TypeEq : cmp.Eq[@types.Type]

// TypeEq.Equal reports whether a and b are the same type.
func (e TypeEq) Equal(a @types.Type, b @types.Type) bool

// NewGenCtx creates a per-compilation gen context bound to module m,
// seeding PkgPath from m.PkgPath (empty when m is nil or its path isn't
// set yet — e.g. during import registration before GeneratePackage).
func NewGenCtx(m @ir.Module) @GenCtx

// RegisterImport registers a single imported package for IR generation and
// adds it to the module's import list.  path is the import path (e.g.
// "pkg/binate/loader") — the package's identity, qualifying every name it
// registers.  For a cmd package whose declared name is "main" the path is
// what the importee compiles under (e.g. "cmd/bnc"), not file.PkgName, so
// passing it explicitly avoids the "main"-derived misqualification.
func RegisterImport(path *[]readonly char, file @ast.File, gc @GenCtx)

// RegisterImports registers multiple imported packages for IR generation, as
// RegisterImport does one: paths[k] is the path of the package files[k]
// declares.  A path may repeat (a file importing one package under several
// names); the package is registered once.
func RegisterImports(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterImportFuncSigs is RegisterImports without adding the imported extern
// Func entries: it registers the callees' signatures for call-site resolution
// but leaves the module's func table untouched (the REPL's mid-session import,
// so a following per-decl LowerOneFunc's indices stay in sync with the VM).
func RegisterImportFuncSigs(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterStructTypes registers struct types from imported packages
// into the type system, qualified by each package's path (paths[k] for
// files[k]), so two packages sharing a last path segment get distinct
// qualifiers.
func RegisterStructTypes(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterAllInterfaces registers DECL_INTERFACE entries from
// every loaded package (including transitive deps), so cross-
// package alias-chain resolution works even when the importing
// TU doesn't reference the alias's underlying interface package
// directly.
// Each interface's Pkg is its package's path (paths[k] for files[k]), so
// two packages sharing a last path segment record distinct interfaces.
func RegisterAllInterfaces(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// FindInterfaceMethodSlot resolves (ifacePkg, ifaceName, methodName) against the
// module's interface registry to the method's absolute vtable slot (-1 if not
// found).  For host-driven interface dispatch (interp's CallIfaceMethod).
func FindInterfaceMethodSlot(m @ir.Module, ifacePkg *[]readonly char, ifaceName *[]readonly char,
		methodName *[]readonly char) int

// ReLoweredAtConsumer reports whether a consumer of the package whose merged file
// is f and whose interface file is bni (nil if none) lowers some of its
// declarations itself in a way that can name the package's imports — f declares
// a generic (monomorphized at the consumer), or a constant the consumer can
// re-lower (one of the interface's, or transitively a constant of the package
// one of those names; a floating-point constant expression is re-lowered at
// each use) has an initializer naming another package — so the drivers register
// those imports for the consumer (RegisterGenericBodyDeps).
func ReLoweredAtConsumer(f @ast.File, bni @ast.File) bool

// RegisterGenericBodyDeps registers function/method signatures + extern Funcs
// (deduped against already-registered sigs), consts and extern vars for the
// given packages (keyed by full path via `paths`) — packages a monomorphized
// cross-package generic body may reach but that the consumer does not directly
// import.  Their structs/interfaces are registered transitively
// (RegisterStructTypes / RegisterAllInterfaces).  Without the func externs, a
// generic body calling `dep.V()` emits a call to an undeclared symbol (LLVM "use
// of undefined value"); without the consts and vars, a body of `dep` reading one
// of its own finds no registration for the checker's record of it (an internal
// error).
func RegisterGenericBodyDeps(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterGenericBodyDepSigs is RegisterGenericBodyDeps without adding extern
// Func entries, as RegisterImportFuncSigs is RegisterImports without them: the
// REPL's mid-session import, whose live module's func table mirrors the VM's.
func RegisterGenericBodyDepSigs(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterGenericDecls stashes generic func/struct/interface decls for the
// given packages (keyed by full path via `paths`), deduped via the
// lookupGeneric*DeclPkg checks.  RegisterImport stashes generic decls only
// for the consumer's DIRECT imports; a generic body that instantiates ANOTHER
// package's generic (a transitive, not direct, import) needs that package's
// generic decl available to monomorphize it.  Registers ONLY generic decls;
// non-generic structs/sigs/consts/interfaces are handled elsewhere
// (RegisterStructTypes / RegisterImports / RegisterGenericBodyDeps).
func RegisterGenericDecls(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterImportedImpls collects the given packages' impls into
// gc.Mod.ImportedImpls (deduped), so a generic body monomorphized at the
// consumer can upcast a receiver to an interface defined in a TRANSITIVELY-
// imported package — the upcast needs the imported impl's vtable symbol wired.
// collectImportedImplsFromDecl otherwise runs only over direct imports; without
// this a transitive-package upcast inside a monomorphized generic body produced
// a nil vtable (SIGSEGV).
func RegisterImportedImpls(paths @[]@[]char, files *[]@ast.File, gc @GenCtx)

// RegisterSelfTypes registers struct types from the package's own .bni
// file.  `c` is the type-Checker (for pending-decl / const resolution);
// `gc` is the per-compilation context whose Mod is the module
// GeneratePackage will fill (self structs/aliases land in its per-module
// tables).  Sets gc.PkgPath to the .bni's package path for the duration
// of the pass, then restores it.
func RegisterSelfTypes(c @check.Checker, bniFile @ast.File, gc @GenCtx)

// GeneratePackage lowers an AST file into IR and adds it to the module
// gc.Mod, recording `c` as that module's type-Checker (Mod.Checker) for
// per-expression resolved types.  Sets gc.Mod.PkgPath (and gc.PkgPath) from
// the module's name.
func GeneratePackage(c @check.Checker, file @ast.File, gc @GenCtx)

// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point.  `gc` supplies the module
// context (incl. gc.Mod.Checker); requires the surrounding module state
// to already be initialized via a prior GenModule / GeneratePackage call.
func GenSyntheticFunc(gc @GenCtx, name @[]char, body @[]@ast.Stmt) @ir.Func

// GenGlobalInitFunc generates the no-arg, no-result function name, which
// initializes the package variables decls declare, in order — the file-load
// module init, and each REPL top-level var's initialization: a declaration's
// initializer is stored into its variable's global as an assignment stores it; a
// declaration without one resets its variable to its type's zero value,
// releasing what it held (a variable the REPL keeps when it is redeclared with
// its own type); a blank variable's initializer runs for its side effects.  A
// raw-slice literal generated directly in it gets a hidden module global as its
// backing (which a REPL caller must materialize before running the function)
// rather than a slot on this one-shot function's stack.  Requires the module
// state GenSyntheticFunc does, with the variables' globals registered.
func GenGlobalInitFunc(gc @GenCtx, name @[]char, decls *[]@ast.Decl) @ir.Func

// GenDecl IR-gens a single top-level declaration against the
// existing module gc.Mod and registers it for subsequent IR
// references: the REPL's entry point for a declaration typed at the
// prompt.  Returns "" on success or a diagnostic message on a
// declaration it cannot lower at the prompt.  See gen_repl.bn for the
// kinds it handles.
func GenDecl(d @ast.Decl, gc @GenCtx) @[]char

// DeclareFunc declares function or method d to IR-gen without generating it,
// so code generated after it can call it: it registers d's signature, or
// stashes a generic d for instantiation where it is used.  A blank function
// declares nothing.  GenDecl of a function is DeclareFunc then GenFuncBody; a
// caller generating functions that may call one another declares them all
// before generating any, as a package's functions are.
func DeclareFunc(d @ast.Decl, gc @GenCtx)

// GenFuncBody generates function or method d, declared by DeclareFunc, and adds
// it to gc.Mod.Funcs, last after what generating it added (its function
// literals, say).  A generic or blank d generates nothing.
func GenFuncBody(d @ast.Decl, gc @GenCtx)

// GenTypeDecls IR-gens type and interface declarations that may refer to one
// another (a REPL prompt's, or a group of parked declarations resolved
// together): every struct and interface is registered by name, then the
// aliases and named non-struct types, then the interfaces' method sets and
// the structs' fields are built, then the destructor / copy helpers are
// generated.  The caller lowers the
// helpers added to gc.Mod.Funcs.  Returns "" or a diagnostic.
func GenTypeDecls(decls *[]@ast.Decl, gc @GenCtx) @[]char

// GenReplRecvThunk returns the interface-dispatch thunk of method f typed at
// the prompt, or nil when f needs none: a value-receiver method is dispatched
// through a thunk that takes the interface value's data pointer and calls f
// with the value.  The caller adds it to the module and lowers it after f.
func GenReplRecvThunk(m @ir.Module, f @ir.Func) @ir.Func

// IsGenericDecl reports whether d is a generic function (`func id[T any](x T)
// T`) or a method of a generic type (`func (c *Cur[T]) Get() T`).  GenDecl
// generates no function for one typed at the prompt: it is emitted per
// instantiation, where it is used.
func IsGenericDecl(d @ast.Decl) bool

// ReemitGeneric emits again, from generic function or generic-receiver method d
// (typed at the prompt and stashed by GenDecl), every instance of the
// declaration d redefines that was already emitted, and returns them; they are
// added to the module with what generating them added (instances first emitted
// then, among others).  The caller lowers them — replacing the old instances,
// or shadowing them as one group (vm.LowerFuncsShadow) when d's signature
// differs — and lowers the rest as new functions.
func ReemitGeneric(gc @GenCtx, d @ast.Decl) @[]@ir.Func

// ReplEntry records the session's IR-gen state a REPL prompt entry's generation
// may change — the session module's functions, signatures, globals, constants,
// types, interfaces and impl rows, the generic declarations stashed, the
// instances and method-value wrappers recorded as generated, the destructor and
// copy helpers queued — as it was when the entry began, and what the generation
// changes in place as it changes it (a signature registered again, a stashed
// generic redefined, a forward-declared type filled), so the entry can be undone
// when the REPL does not keep it (its code does not load).
type ReplEntry

// BeginReplEntry starts recording what the generation of a prompt entry
// changes; EndReplEntry or UndoReplEntry stops it.
func BeginReplEntry(gc @GenCtx) @ReplEntry

// EndReplEntry stops recording: the entry is kept.
func EndReplEntry(gc @GenCtx, e @ReplEntry)

// UndoReplEntry undoes the entry's generation, putting the session's IR-gen
// state back as it was before the entry: the functions it generated are dropped
// from the session module — none of them may have been lowered — and so is all
// it recorded or registered, so a later entry generates afresh what it uses (an
// instance of a generic, a type's helpers) from what is declared then.  It
// stops recording.
func UndoReplEntry(gc @GenCtx, e @ReplEntry)

// ReplGenericFunc returns the generic function of the session's package (typed
// at the prompt, or declared in the session's module) that IR-gen holds under
// name -- not one a later input shadowed, which IR-gen holds for the code
// declared before it -- or nil.
func ReplGenericFunc(gc @GenCtx, name *[]readonly char) @ast.Decl

// RenamedFunc is a function of the session's module that ShadowReplFunc renamed:
// its qualified name before and after.
type RenamedFunc struct {
	Old @[]char
	New @[]char
}

// ShadowReplFunc renames the session's function name -- its signature and IR
// function -- and, for a generic function, its emitted instances (each named
// after it), to the hidden name a declaration typed at the prompt that shadows
// it keeps it under, and returns what it renamed, for the caller to rename in the
// VM (vm.RenameFunc): code already lowered keeps calling them, and a use of the
// name from then on reaches the new declaration (a generic's instances are
// emitted from it anew).
func ShadowReplFunc(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) @[]RenamedFunc

// UnshadowReplFunc renames back each function ShadowReplFunc renamed (renamed,
// what it returned) -- its signature and IR function -- once the declaration that
// shadowed them is not kept and its entry is undone (UndoReplEntry).  The undo
// puts back the emitted-instance list the entry began with, under the old names,
// but not the signatures and IR functions renamed since, so they are renamed back
// by renamed, not found by their names in that list.
func UnshadowReplFunc(gc @GenCtx, renamed *[]RenamedFunc)

// ShadowReplConst renames the session's package constant name to hidden, as
// ShadowReplFunc renames a function, reporting whether there is one.
func ShadowReplConst(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) bool

// ShadowReplMethod renames the method of the session's type that the method
// declaration d, typed at the prompt, supersedes (check.ShadowedMethod: one of
// another signature) to hidden, its name as the type's member from then on --
// its function, its interface-dispatch thunk and its method-value wrappers --
// and returns what it renamed, as ShadowReplFunc does: code already lowered
// keeps calling them, and code checked later reaches them by the hidden name
// where it selects the superseded method.
func ShadowReplMethod(gc @GenCtx, d @ast.Decl, hidden *[]readonly char) @[]RenamedFunc

// ShadowReplGenericMethod is ShadowReplMethod for a method of the session's
// generic type: it renames the method d supersedes to hidden on each instance of
// the type emitted -- its function, thunk and method-value wrappers -- and in the
// record of the instances emitted, so the instances of d are emitted anew where
// used, and the superseded one for an instance only where code declared before
// selects it (check.GenericMethodName).
func ShadowReplGenericMethod(gc @GenCtx, d @ast.Decl, hidden *[]readonly char) @[]RenamedFunc

// EmitSupersedingMethod emits generic-receiver method d, typed at the prompt
// with another signature than the method of its name it supersedes, for each
// instance of its receiver type emitted that does not have d emitted yet -- those
// whose superseded method ShadowReplGenericMethod renamed -- and returns them, so
// the REPL load-checks them with d: they are new functions, which the caller
// shadow-lowers (vm.LowerFuncsShadow).
func EmitSupersedingMethod(gc @GenCtx, d @ast.Decl) @[]@ir.Func

// GenConstMember registers a single resolved const-group
// member in moduleConsts using the given iota position.  REPL
// entry point for retryPending when a previously-parked const
// inside a `const ( ... )` group resolves: pass the member's
// IotaIdx (captured at park time and stored on the PendingDecl)
// so the value reflects its source-order position.
func GenConstMember(d @ast.Decl, gc @GenCtx, iotaIdx int)

// EnsureReplBodyHelpers drains managed-aggregate types registered
// during the most-recent prompt body's IR-gen into freshly-emitted
// `__dtor_<T>` / `__copy_<T>` helpers appended to `m.Funcs`,
// dedup'd against helpers already present.  Resets the pending
// lists on return.  The caller (the REPL) lowers the new entries —
// preferably before the body that references them, so the body's
// eager `CallCache` fill resolves every helper name.
//
// Counterpart to the in-decl `ensureReplStructHelpers` path that
// runs from `GenDecl` when a fresh `type` decl introduces a
// managed-field struct: together they cover both ways a prompt
// entry can introduce a new aggregate shape (typing the struct,
// or typing a body that uses an `@[]T` shape).
func EnsureReplBodyHelpers(m @ir.Module)

// ShadowReplGlobal renames the session's global variable `name` — its
// GlobalVars entry and its ir.Global — to `hidden`, so a redeclaration of `name`
// with another type registers a new global under `name` while code already
// lowered keeps the old one (the REPL renames the VM's entry alike).  Returns
// false when the module has no global `name`.
func ShadowReplGlobal(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) bool

