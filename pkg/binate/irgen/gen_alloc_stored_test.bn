package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// A slot IR-gen stores whole right after allocating it -- a local declared with an
// initializer, a call result spilled to read a field of it -- skips its zero-fill
// (NoZeroInit), the store writing every byte; a local declared without one keeps it.

// slotOfSize returns the first OP_ALLOC of f whose slot is sz bytes, or nil.
func slotOfSize(f @ir.Func, sz int64) @ir.Instr {
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			var ins @ir.Instr = f.Blocks[i].Instrs[j]
			if ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil && ins.TypeArg.Size() == sz { return ins }
		}
	}
	return nil
}

func TestAllocStoredSkipsZeroFill() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type W struct { a [8]int64 }\n"
					"func get() W {\n\tvar w W\n\treturn w\n}\n"
					"func decl() int64 {\n\tvar r W = get()\n\treturn r.a[1]\n}\n"
					"func short() int64 {\n\tr := get()\n\treturn r.a[2]\n}\n"
					"func field() int64 { return get().a[3] }\n"
					"func bare() int64 {\n\tvar r W\n\treturn r.a[4]\n}\n")
	var stored @[]@[]char = make_slice(@[]char, 3)
	stored[0] = "decl"
	stored[1] = "short"
	stored[2] = "field"
	for i := 0; i < len(stored); i++ {
		var slot @ir.Instr = slotOfSize(findFunc(m, stored[i]), 64)
		if slot == nil || !slot.NoZeroInit {
			return "a slot stored whole right after its allocation is NoZeroInit"
		}
	}
	var bare @ir.Instr = slotOfSize(findFunc(m, "bare"), 64)
	if bare == nil || bare.NoZeroInit {
		return "a local declared without an initializer keeps its zero-fill"
	}
	return ""
}
