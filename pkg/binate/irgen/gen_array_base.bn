package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// Array bases of slice and index expressions: an array with storage is read
// in place through its address, so the base expression is evaluated exactly
// once and a slice of it aliases it.

// checkedArrayType returns the checker's type of e, peeled of transparent
// wrappers, when it is an array; nil otherwise (or with no checker).
func checkedArrayType(ctx @GenContext, e @ast.Expr) @types.Type {
	if ctx.Checker == nil || e == nil || e.ResolvedTypeID == 0 { return nil }
	var t @types.Type = irutil.PeelTransparent(ctx.Checker.ExprType(e.ResolvedTypeID))
	if t == nil || t.Kind != types.TYP_ARRAY { return nil }
	return t
}

// arrayStorageAddr returns the address of the array `x` that a slice or index
// expression reads, when `x` has storage: a variable, a struct field, a
// dereference, or an element of an array / slice.  The read is of `x`, so a nil
// base faults as a read would (forDeref / emitNilCheckIfEnabled).  Evaluates
// `x` once; the caller must not evaluate it again.  Returns nil for a value
// with no storage (a call result, a composite literal), which the caller
// evaluates as a value instead.
func arrayStorageAddr(ctx @GenContext, b @ir.Block, x @ast.Expr) @ir.Instr {
	if x.Kind == ast.EXPR_IDENT {
		return lookupVar(ctx, x.Name)
	}
	if x.Kind == ast.EXPR_SELECTOR {
		return genSelectorPtr(ctx, b, x, true)
	}
	if x.Kind == ast.EXPR_UNARY && x.Op == cast(int, token.STAR) {
		var p @ir.Instr = genExpr(ctx, b, x.X)
		emitNilCheckIfEnabled(ctx, ctx.CurBlock, p)
		return p
	}
	if x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return genIndexPtr(ctx, b, x, true)
	}
	return nil
}

// irArrayType returns the array type `ptr` (the address of an array) points
// at, as IR-gen typed it, or nil when its type does not say.  The checker's
// type decides THAT a base is an array; the element type the IR loads and
// stores comes from here, so it is the same type object every other IR-gen
// path uses for that storage (method dispatch on an interface-value element,
// for instance, does not accept the checker's type of `*I` in its place).
func irArrayType(ptr @ir.Instr) @types.Type {
	if ptr == nil || ptr.Typ == nil { return nil }
	var pt @types.Type = irutil.PeelTransparent(ptr.Typ)
	if pt == nil || pt.Elem == nil { return nil }
	if pt.Kind != types.TYP_POINTER && pt.Kind != types.TYP_MANAGED_PTR { return nil }
	var at @types.Type = irutil.PeelTransparent(pt.Elem)
	if at == nil || at.Kind != types.TYP_ARRAY { return nil }
	return at
}

// genArrayElemPtrInPlace returns the address of element `x[i]` of an array `x`
// with storage, and the element type: the array's address (arrayStorageAddr,
// evaluating `x` once), then the index and a bounds check against the array
// length (unless !checked).  Returns nil — having emitted nothing — when `x` is
// not an array with storage.  Reads (genArrayIndexInPlace) and stores (the
// assignment paths) both go through it, so neither loads the whole array to
// reach one element or evaluates `x` twice.
func genArrayElemPtrInPlace(ctx @GenContext, b @ir.Block, e @ast.Expr,
		checked bool) (@ir.Instr, @types.Type) {
	var noTyp @types.Type
	var arrSt @types.Type = checkedArrayType(ctx, e.X)
	if arrSt == nil || !arrayHasStorage(e.X) { return nil, noTyp }
	var arrPtr @ir.Instr = arrayStorageAddr(ctx, b, e.X)
	b = ctx.CurBlock
	if arrPtr == nil {
		panic("internal error: array base with storage has no address in IR-gen (compiler bug)")
	}
	var irArr @types.Type = irArrayType(arrPtr)
	if irArr != nil { arrSt = irArr }
	var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
	b = ctx.CurBlock
	if checked {
		genBoundsCheck(ctx, b, index, irbuild.EmitConstInt(b, arrSt.ArrayLen, types.TypInt()))
	}
	var elemTyp @types.Type = arrSt.Elem
	if elemTyp == nil { elemTyp = types.TypInt() }
	return irbuild.EmitGetElemPtr(b, arrPtr, index, elemTyp), elemTyp
}

// genArrayIndexInPlace lowers `x[i]` for an array `x` with storage: a load
// through its element address (genArrayElemPtrInPlace).  Returns nil — having
// emitted nothing — when `x` is not an array with storage, for genIndex's
// value path.
func genArrayIndexInPlace(ctx @GenContext, b @ir.Block, e @ast.Expr, checked bool) @ir.Instr {
	var elemPtr @ir.Instr
	var elemTyp @types.Type
	elemPtr, elemTyp = genArrayElemPtrInPlace(ctx, b, e, checked)
	if elemPtr == nil { return nil }
	return irbuild.EmitLoad(ctx.CurBlock, elemPtr, elemTyp)
}

// storeArrayElemInPlace stores rhs — combined with the element's current value
// for a compound assignment (`x[i] += v`) — through elemPtr, an element address
// from genArrayElemPtrInPlace.
func storeArrayElemInPlace(ctx @GenContext, b @ir.Block, stmt @ast.Stmt, elemPtr @ir.Instr,
		elemTyp @types.Type, rhs @ir.Instr) @ir.Block {
	if isCompoundAssign(stmt) {
		rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, elemPtr, elemTyp), rhs, elemTyp)
	}
	return emitArrayElemStore(ctx, b, elemPtr, rhs, elemTyp)
}

// arrayHasStorage reports whether an array-typed expression `x` is one of the
// shapes arrayStorageAddr takes the address of.
func arrayHasStorage(x @ast.Expr) bool {
	if x.Kind == ast.EXPR_IDENT || x.Kind == ast.EXPR_SELECTOR ||
			x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return true
	}
	return x.Kind == ast.EXPR_UNARY && x.Op == cast(int, token.STAR)
}
