package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"

// irArrayType reads the array type from the IR pointer's own type: an alloca of
// an array yields that array, an alloca of a scalar (or no pointer) yields nil.
func TestIrArrayType() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 3)
	var ap @ir.Instr = irbuild.EmitAlloc(b, arr)
	var got @types.Type = irArrayType(ap)
	if got == nil || got.Kind != types.TYP_ARRAY || got.ArrayLen != 3 {
		return "an alloca of [3]int must yield the array type"
	}
	if irArrayType(irbuild.EmitAlloc(b, types.TypInt())) != nil {
		return "an alloca of int is not an array"
	}
	if irArrayType(nil) != nil { return "nil pointer must yield nil" }
	return ""
}

// The shapes an array base has storage in: a variable, a field, an element, a
// dereference, a composite literal.  A call result has none.
func TestArrayHasStorage() testing.TestResult {
	var id @ast.Expr = mkIdentExpr("a")
	if !arrayHasStorage(id) { return "a variable has storage" }
	var sel @ast.Expr = make(ast.Expr)
	sel.Kind = ast.EXPR_SELECTOR
	sel.X = mkIdentExpr("s")
	sel.Name = "arr"
	if !arrayHasStorage(sel) { return "a field has storage" }
	var idx @ast.Expr = make(ast.Expr)
	idx.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
	idx.X = mkIdentExpr("n")
	if !arrayHasStorage(idx) { return "an element has storage" }
	var deref @ast.Expr = make(ast.Expr)
	deref.Kind = ast.EXPR_UNARY
	deref.Op = cast(int, token.STAR)
	deref.X = mkIdentExpr("p")
	if !arrayHasStorage(deref) { return "a dereference has storage" }
	var lit @ast.Expr = make(ast.Expr)
	lit.Kind = ast.EXPR_COMPOSITE
	if !arrayHasStorage(lit) { return "a composite literal has storage" }
	var neg @ast.Expr = make(ast.Expr)
	neg.Kind = ast.EXPR_UNARY
	neg.Op = cast(int, token.MINUS)
	neg.X = mkIdentExpr("p")
	if arrayHasStorage(neg) { return "a non-deref unary has no storage" }
	var call @ast.Expr = make(ast.Expr)
	call.Kind = ast.EXPR_CALL
	call.X = mkIdentExpr("mk")
	if arrayHasStorage(call) { return "a call result has no storage" }
	return ""
}

// countArrayLoads counts fn's loads of an array-typed value.
func countArrayLoads(fn @ir.Func) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			var ins @ir.Instr = b.Instrs[j]
			if ins.Op != iropcode.OP_LOAD || ins.Typ == nil { continue }
			var t @types.Type = irutil.PeelTransparent(ins.Typ)
			if t != nil && t.Kind == types.TYP_ARRAY { n = n + 1 }
		}
	}
	return n
}

// A store to an element of an array with storage goes through the element's
// address: no assignment form (plain, compound, multi-value, parallel) loads
// the array as a value.
func TestArrayElemStoreLoadsNoArray() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type Big struct { a [8]uint8 }\n"
					"var g [3]Big\n"
					"func pair() (uint8, uint8) { return 1, 2 }\n"
					"func set(i int, off int, v uint8) {\n"
					"\tg[i].a[off] = v\n"
					"\tg[i].a[off] += v\n"
					"\tg[i].a[off], g[0].a[1] = pair()\n"
					"\tg[i].a[off], g[1].a[2] = v, v\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "set")
	if fn == nil { return "set was not generated" }
	if countArrayLoads(fn) != 0 { return "an array element store loaded the array as a value" }
	return ""
}
