package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// entryOrderModule declares a parallel and a multi-value assignment whose
// right-hand sides, bases and indices are all calls.
func entryOrderModule() @ir.Module {
	return genFromSourceWithChecker(
			"package \"test\"\n"
					"var arr [3]int\n"
					"func base1() *([3]int) { return &arr }\n"
					"func base2() *([3]int) { return &arr }\n"
					"func idx1() int { return 0 }\n"
					"func idx2() int { return 1 }\n"
					"func val1() int { return 5 }\n"
					"func val2() int { return 6 }\n"
					"func pair() (int, int) { return 7, 8 }\n"
					"func par() { (*base1())[idx1()], (*base2())[idx2()] = val1(), val2() }\n"
					"func multi() { (*base1())[idx1()], (*base2())[idx2()] = pair() }\n")
}

// callSequence returns fn's calls to the functions named in names, in
// emission order, as their names separated by spaces.
func callSequence(fn @ir.Func, names @[]@[]char) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op != iropcode.OP_CALL { continue }
			for k := 0; k < len(names); k++ {
				if !containsSub(blk.Instrs[j].StrVal, names[k]) { continue }
				if sb.Len() > 0 { sb.WriteByte(' ') }
				sb.Write(names[k])
			}
		}
	}
	return buf.CopyStr(sb.String())
}

// orderNames is the call set entryOrderModule's assignments make.
func orderNames() @[]@[]char {
	var names @[]@[]char = make_slice(@[]char, 7)
	names[0] = buf.CopyStr("base1")
	names[1] = buf.CopyStr("base2")
	names[2] = buf.CopyStr("idx1")
	names[3] = buf.CopyStr("idx2")
	names[4] = buf.CopyStr("val1")
	names[5] = buf.CopyStr("val2")
	names[6] = buf.CopyStr("pair")
	return names
}

// A parallel assignment evaluates every right-hand side, then every target's
// base and index left to right.
func TestParallelAssignEvaluatesValuesThenTargets() testing.TestResult {
	var fn @ir.Func = findFunc(entryOrderModule(), "par")
	if fn == nil { return fail("par was not generated") }
	var got @[]char = callSequence(fn, orderNames())
	if !charsEqual(got, "val1 val2 base1 idx1 base2 idx2") {
		return fail(buf.Concat("parallel assignment call order: ", got))
	}
	return ""
}

// storeBeforeCall reports whether fn emits an OP_STORE before its first call to
// a function whose name contains name.
func storeBeforeCall(fn @ir.Func, name *[]readonly char) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && containsSub(ins.StrVal, name) { return false }
			if ins.Op == iropcode.OP_STORE { return true }
		}
	}
	return false
}

// A multi-value assignment evaluates its call, then every target's base and
// index left to right, and only then stores — no target is stored before the
// last target's designator is evaluated.
func TestMultiAssignEvaluatesCallThenTargets() testing.TestResult {
	var fn @ir.Func = findFunc(entryOrderModule(), "multi")
	if fn == nil { return fail("multi was not generated") }
	var got @[]char = callSequence(fn, orderNames())
	if !charsEqual(got, "pair base1 idx1 base2 idx2") {
		return fail(buf.Concat("multi-value assignment call order: ", got))
	}
	if storeBeforeCall(fn, "idx2") {
		return fail("a multi-value target must not be stored before every designator is evaluated")
	}
	return ""
}

// refDecBeforeLastStore reports whether fn emits an OP_REFDEC before its last
// OP_STORE into a location other than a local alloca (a parameter spill or a
// statement temp), in emission order.
func refDecBeforeLastStore(fn @ir.Func) bool {
	var lastStore int = -1
	var firstRefDec int = -1
	var ord int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) > 0 && ins.Args[0].Op != iropcode.OP_ALLOC {
				lastStore = ord
			}
			if ins.Op == iropcode.OP_REFDEC && firstRefDec < 0 { firstRefDec = ord }
			ord = ord + 1
		}
	}
	return firstRefDec >= 0 && firstRefDec < lastStore
}

// Every store of a multi-value or parallel assignment happens before the
// release of any value a store replaced: in `p, p.val = ...` the old p's field
// is stored into while the old p is still alive.
func TestAssignReleasesAfterAllStores() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type Node struct { val int }\n"
					"var p @Node\n"
					"func two() (@Node, int) { return make(Node), 5 }\n"
					"func multi() { p, p.val = two() }\n"
					"func par(q @Node) { p, p.val = q, 5 }\n")
	var multi @ir.Func = findFunc(m, "multi")
	var par @ir.Func = findFunc(m, "par")
	if multi == nil || par == nil { return fail("multi / par were not generated") }
	if refDecBeforeLastStore(multi) {
		return fail("multi-value assignment released a replaced value before its last store")
	}
	if refDecBeforeLastStore(par) {
		return fail("parallel assignment released a replaced value before its last store")
	}
	return ""
}
