package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// genIndexAssign lowers the single assignment `x[i] = rhs` (or a compound
// `x[i] op= rhs`), its rhs already generated: an array element is stored
// through its address, a pointer element through a GEP, and a slice element
// through the runtime set, each slot obeying the managed-value store
// discipline.
func genIndexAssign(ctx @GenContext, b @ir.Block, stmt @ast.Stmt, lhs @ast.Expr,
		rhs @ir.Instr) @ir.Block {
	// s[i] = v: slice or array index assignment.
	//
	// Nested-ARRAY target (`a[i][j] = v`): genExpr(lhs.X) would
	// load the inner array `a[i]` as an r-value with no backing
	// pointer, so the array arm below can't recover an element
	// pointer and would silently DROP the store.  Store through an
	// in-place element pointer (genIndexPtr) instead.  Detected by
	// TYPE so lhs.X (and its index) isn't generated twice.  Nested
	// SLICE targets need no special case (the loaded slice value
	// carries the backing pointer).
	if len(lhs.Args) == 1 && isNestedArrayBase(ctx, lhs) {
		// Store target off a nested-array element — deref => true.
		var elemPtr @ir.Instr = genIndexPtr(ctx, b, lhs, true)
		b = ctx.CurBlock
		if elemPtr != nil && elemPtr.Typ != nil && elemPtr.Typ.Elem != nil {
			if isCompoundAssign(stmt) {
				rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, elemPtr, elemPtr.Typ.Elem), rhs,
						elemPtr.Typ.Elem)
			}
			b = emitArrayElemStore(ctx, b, elemPtr, rhs, elemPtr.Typ.Elem)
			return b
		}
	}
	// An array with storage: store in place, its base evaluated once.
	var inPlace @ir.Instr
	var inPlaceTyp @types.Type
	inPlace, inPlaceTyp = genArrayElemPtrInPlace(ctx, b, lhs, true)
	if inPlace != nil {
		return storeArrayElemInPlace(ctx, ctx.CurBlock, stmt, inPlace, inPlaceTyp, rhs)
	}
	var collection @ir.Instr = genExpr(ctx, b, lhs.X)
	b = ctx.CurBlock
	var index @ir.Instr = genIntOperand(ctx, b, lhs.Args[0])
	b = ctx.CurBlock
	emitIndexBoundsCheck(ctx, b, collection, index)

	// Peel transparent wrappers so a named array (`var r Row` where
	// `type Row [3]int`) — or a readonly one — reaches the array
	// store arm and its element type comes from the underlying array,
	// not the wrapper (whose `.Elem` is nil).  Without this `r[0] = v`
	// falls through to the slice path and emits invalid IR.
	var collSt @types.Type = nil
	if collection.Typ != nil { collSt = types.StripWrappers(collection.Typ) }

	if collSt != nil && collSt.Kind == types.TYP_ARRAY {
		// Array: GEP + store.  Reached only for a base with no checker type;
		// genArrayElemPtrInPlace above stores to every checker-typed array
		// with storage.
		var arrPtr @ir.Instr = nil
		if lhs.X.Kind == ast.EXPR_IDENT {
			arrPtr = lookupVar(ctx, lhs.X.Name)
		}
		if arrPtr == nil && lhs.X.Kind == ast.EXPR_SELECTOR {
			arrPtr = genSelectorPtr(ctx, b, lhs.X, true)
			b = ctx.CurBlock
		}
		if arrPtr == nil && lhs.X.Kind == ast.EXPR_UNARY && lhs.X.Op == cast(int, token.STAR) {
			// `(*p)[i] = v`: p (a pointer-to-array) is the array's backing
			// address; GEP through it.  `collection` above loaded a COPY of
			// the array, so without this the store lands on the copy and is
			// silently dropped.
			arrPtr = genExpr(ctx, b, lhs.X.X)
			b = ctx.CurBlock
		}
		if arrPtr != nil {
			var elemTyp @types.Type = collSt.Elem
			if elemTyp == nil { elemTyp = types.TypInt() }
			var elemPtr @ir.Instr = irbuild.EmitGetElemPtr(b, arrPtr, index, elemTyp)
			if isCompoundAssign(stmt) {
				rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, elemPtr, elemTyp), rhs, elemTyp)
			}
			b = emitArrayElemStore(ctx, b, elemPtr, rhs, elemTyp)
		}
	} else if collSt != nil && collSt.Kind == types.TYP_POINTER {
		// Pointer: GEP + store.  A managed element obeys Axiom 5
		// (RefInc new / RefDec old) exactly like the TYP_ARRAY arm
		// above — the raw pointer only excuses tracking the *block*'s
		// lifetime, not balancing the managed values *inside* the
		// slot.  (The multi-value and parallel target path does the same
		// via storeAssignEntry.)  collSt is the peeled type so a named
		// pointer reaches this arm with a non-nil element type.
		var elemTyp @types.Type = collSt.Elem
		if elemTyp == nil { elemTyp = types.TypInt() }
		// A raw pointer carries no length (no bounds check), so the
		// store deref is otherwise unguarded — nil-check it (opt-in).
		emitNilCheckIfEnabled(ctx, b, collection)
		var elemPtr @ir.Instr = irbuild.EmitGetElemPtr(b, collection, index, elemTyp)
		// A string literal stored into a char-slice or char-array element.
		rhs = materializeStringLit(ctx, b, rhs, elemTyp)
		// Aggregate (struct OR array) alloca from a nested composite
		// lit: load the VALUE, else the alloca POINTER is stored raw.
		if isAggregateAllocToLoad(rhs, elemTyp) {
			rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
		}
		rhs = decayManagedToRaw(b, rhs, elemTyp)
		// Compound `p[i] += x`: read-modify-write through the
		// element pointer.
		if isCompoundAssign(stmt) {
			rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, elemPtr, elemTyp), rhs, elemTyp)
		}
		// Managed pointer element: same acquire-before-release store
		// as the array arm (the raw pointer only excuses tracking the
		// block's lifetime, not balancing the managed values inside the
		// slot).  Routing through the dispatcher also fixes the
		// self-alias `p[i] = p[i]` UAF the old release-then-acquire
		// ordering had.
		if irutil.IsManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
			b = emitStoreManagedSlot(ctx, b, elemPtr, rhs, elemTyp, false)
		} else {
			rhs = ensureWidth(ctx, b, nilForSlot(b, rhs, elemTyp), elemTyp)
			irbuild.EmitStore(b, elemPtr, rhs)
		}
	} else {
		// Element type comes from the PEELED slice type (collSt), not the
		// raw collection.Typ: a named-distinct slice (`type Buf @[]int`)
		// has Kind TYP_NAMED with a nil `.Elem` (its body hangs off
		// `.Underlying`), so reading `.Elem` off the wrapper yields nil.
		// EmitSliceSet would then build a GEP whose result element type is
		// nil — LLVM defaults a nil-element GEP to i64 and limps along
		// (latent wrong-stride for a non-8-byte named element), but the
		// native backend's ElemSizeOf reports 0, emitGetElemPtr early-
		// returns on `elemSize <= 0` without assigning the GEP's result
		// register, and the dropped GEP leaves the store's address slot
		// uninitialized (SIGSEGV).  The array arm above already peels.
		var collElem @types.Type = nil
		if collSt != nil { collElem = collSt.Elem }
		// This slice-set path does not go through emitStoreManagedSlot, so retype
		// a literal nil to the element type here (nilForSlot) — both words of a
		// function-value element.
		rhs = nilForSlot(b, rhs, collElem)
		// A string literal stored into a char-slice or char-array element.
		rhs = materializeStringLit(ctx, b, rhs, collElem)
		// If RHS is an aggregate alloca (struct OR array, from a nested
		// composite lit) AND the slot holds that aggregate by value, load
		// the VALUE before storing.  For slots holding pointers (e.g.
		// *[]*Item, *[]@Item) the element type isn't the aggregate, so
		// isAggregateAllocToLoad is false and the alloca pointer is stored
		// directly.
		if isAggregateAllocToLoad(rhs, collElem) {
			rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
		}
		rhs = decayManagedToRaw(b, rhs, collElem)
		// Refcounting for managed slice elements
		if irutil.IsManagedScalarType(collElem) {
			// Acquire the new value BEFORE releasing the old element.
			// This slice-set path has no slot pointer (EmitSliceGet /
			// EmitSliceSet), so it can't route through
			// emitStoreManagedSlot like the array/pointer arms, but it
			// shares the same discipline: a self-alias `s[i] = s[i]` of
			// a managed @T RefIncs the value first, so the RefDec of the
			// old occupant can't free it mid-store (the old hand-rolled
			// arms released first — a use-after-free).
			emitAcquireManagedScalar(ctx, b, rhs, collElem)
			var oldElem @ir.Instr = irbuild.EmitSliceGet(b, collection, index, collElem)
			b = emitManagedValueRefDec(ctx.Func, b, oldElem, collElem)
		}
		if collElem != nil && needsStructCopy(collElem) {
			// Struct element with managed fields: save old,
			// copy new (after store), dtor old.
			var oldElem @ir.Instr = irbuild.EmitSliceGet(b, collection, index, collElem)
			var oldSlot @ir.Instr = irbuild.EmitAlloc(b, collElem)
			irbuild.EmitStore(b, oldSlot, oldElem)
			var newSlot @ir.Instr = irbuild.EmitAlloc(b, collElem)
			irbuild.EmitStore(b, newSlot, rhs)
			emitStructCopy(ctx.Func, b, newSlot, collElem)
			emitStructDtor(ctx.Func, b, oldSlot, collElem)
		}
		// Slice: call runtime set
		var setElemTyp @types.Type = collElem
		// Compound `s[i] += x`: read-modify-write through the
		// runtime get/set (no element pointer for a slice).
		if setElemTyp != nil && isCompoundAssign(stmt) {
			rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitSliceGet(b, collection, index, setElemTyp),
					rhs, setElemTyp)
		}
		if setElemTyp != nil {
			rhs = ensureWidth(ctx, b, rhs, setElemTyp)
		}
		irbuild.EmitSliceSet(b, collection, index, rhs, setElemTyp)
	}
	return b
}
