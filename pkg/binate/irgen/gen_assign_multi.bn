package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// genMultiAssign lowers a multi-value assignment `q, r, ... = call(...)` in
// the three steps of gen_assign_entry.bn: it evaluates the call once and
// extracts each target's component, then evaluates every target's designator,
// then acquires the components, stores them, and releases the replaced managed
// values (Axiom 5).  A blank `_` target discards its component — the
// call-result temp's dtor frees it at end of statement.
func genMultiAssign(ctx @GenContext, b @ir.Block, stmt @ast.Stmt) @ir.Block {
	// A 2-target comma-ok type assertion (`v, ok = x.(*T)`) yields a synthesized
	// {recovered, ok} struct rather than a call result.
	var val @ir.Instr = genMultiValueSource(ctx, b, stmt.Exprs2[0], len(stmt.Exprs))
	b = ctx.CurBlock
	var retTypes @[]@types.Type
	if val.Op == iropcode.OP_CALL {
		retTypes = lookupFuncResults(ctx.Gc, val.StrVal)
	}
	// A func-value or interface-method call has no name to look up, but its
	// multi-return result is packed as a struct whose fields carry the
	// per-result types — derive them so a sub-word / managed component gets
	// a correctly-typed slot.  Without this, elemTyp below defaults to int
	// and `a, b = fv()` / `a, b = iv.m()` with a non-int component stores a
	// mistyped value (invalid IR; a managed component also skips its
	// Axiom-3 RefInc).  Mirrors genShortVar's fallback for the `:=` form.
	if len(retTypes) == 0 && val.Typ != nil && val.Typ.Kind == types.TYP_STRUCT {
		retTypes = multiReturnFieldTypes(val.Typ)
	}
	var entries @[]AssignEntry
	for i := 0; i < len(stmt.Exprs); i++ {
		var lhs @ast.Expr = stmt.Exprs[i]
		var e AssignEntry
		// A blank-identifier target (`_, n = f()`) discards its
		// component: nothing owns it, so do NOT copy-retain it.  The
		// call-result temp's dtor RefDec's the owned ref at end of
		// statement, freeing it; an Axiom-3 RefInc here would have no
		// matching RefDec and leak.
		if !isBlankTarget(lhs) {
			var elemTyp @types.Type = types.TypInt()
			if i < len(retTypes) { elemTyp = retTypes[i] }
			// Axiom 3: the extracted value is a COPY borrowed from the owned
			// call-result temp (whose dtor RefDec's it at end of statement), so
			// acquireAssignValue RefIncs it for the target that now co-owns it
			// (a managed struct/array is copied field-wise instead).  A RAW
			// target (`*T` from an @T, `*[]T` from an @[]T) BORROWS the
			// component — the temp still releases it at end of statement and the
			// raw slot never does — so it is not acquired (a managed slice also
			// decays to the raw {data, len}).
			e.Val = irbuild.EmitExtract(b, val, i, elemTyp)
		}
		entries = slices.Append[AssignEntry](entries, e)
	}
	return resolveAndStoreAssignEntries(ctx, b, stmt.Exprs, entries)
}
