package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// genParallelAssign lowers a matched-arity multi-expression assignment
// `a, b = e1, e2` (notably the swap idiom `a, b = b, a`) in the three steps of
// gen_assign_entry.bn: every right-hand expression evaluated, left to right;
// then every target's designator; then the values acquired, stored, and the
// replaced values released.  Without acquiring every value before any store,
// `a, b = b, a` of two solely-owned @T would RefDec a's old value to zero —
// freeing it — before the second store reads it (a UAF); and without
// evaluating every value first the swap would read an already-overwritten slot.
// A blank `_` target's expression is evaluated for effect only.
func genParallelAssign(ctx @GenContext, b @ir.Block, stmt @ast.Stmt) @ir.Block {
	var entries @[]AssignEntry
	for i := 0; i < len(stmt.Exprs); i++ {
		// Re-sync after a prior value split the block (mirrors
		// resolveAndStoreAssignEntries).
		ctx.CurBlock = b
		var lhs @ast.Expr = stmt.Exprs[i]
		var e AssignEntry
		if isBlankTarget(lhs) {
			genForEffect(ctx, b, stmt.Exprs2[i])
			b = ctx.CurBlock
		} else {
			e.Val = genExprOrFuncRef(ctx, b, stmt.Exprs2[i], assignHintType(ctx, lhs))
			e.SrcTyp = checkerExprType(ctx, stmt.Exprs2[i])
			b = ctx.CurBlock
		}
		entries = slices.Append[AssignEntry](entries, e)
	}
	return resolveAndStoreAssignEntries(ctx, b, stmt.Exprs, entries)
}
