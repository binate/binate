package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"

// Bare (unqualified) names resolve in the package whose declarations are being
// generated — CurrentImportPkg, set while a monomorphized generic body, an
// imported `.bni`'s declarations, or a parameterized impl of that package is
// generated — BEFORE the module's own names.  A same-named type, interface,
// const or global of the consuming package must not capture the name: a generic
// body bound to the consumer's struct reads the wrong layout (garbage /
// SIGSEGV), and one bound to the consumer's global reads the wrong variable.
// The module's own name is the fallback when the defining package has none.
// When CurrentImportPkg is the module's own package the two lookups coincide.

// definingPkgType returns the struct or alias type that CurrentImportPkg
// declares under `name`, or nil (none, or no package is active).
func definingPkgType(gc @GenCtx, name *[]readonly char) @types.Type {
	if len(gc.Mod.CurrentImportPkg) == 0 { return nil }
	var qualName @[]char = qualNameInPkg(gc.Mod.CurrentImportPkg, name)
	var si int = lookupStructIdx(gc, qualName)
	if si >= 0 { return gc.Mod.Structs[si].Typ }
	return lookupTypeAlias(gc, qualName)
}

// contextPkgType returns the struct or alias type that the package whose code
// is being generated declares under `name`: CurrentImportPkg when one is active
// (definingPkgType), otherwise the module's own package (gc.PkgPath).  Nil when
// that package declares no such type, or when gc has no module (NewGenCtx(nil)
// declares nothing).
func contextPkgType(gc @GenCtx, name *[]readonly char) @types.Type {
	if gc.Mod == nil { return nil }
	if len(gc.Mod.CurrentImportPkg) > 0 { return definingPkgType(gc, name) }
	return moduleOwnType(gc, name)
}

// moduleOwnType returns the struct or alias type the module's own package
// (gc.PkgPath) declares under `name`, or nil (also when gc has no module).
func moduleOwnType(gc @GenCtx, name *[]readonly char) @types.Type {
	if gc.Mod == nil { return nil }
	var si int = lookupStructIdx(gc, name)
	if si >= 0 { return gc.Mod.Structs[si].Typ }
	return lookupTypeAlias(gc, name)
}

// bareIfacePkg returns the package that the unqualified interface name `name`
// resolves to, and true; false when `name` names no interface.  A type
// parameter of the generic being generated is never one (resolveTypeExpr
// substitutes it).  Then the package whose code is being generated comes first
// — CurrentImportPkg when one is active, else the module's own package — where
// a struct or alias of that name means the name is NOT an interface, so that a
// package's own `any` shadows the universe one (lex.predeclared.are-idents);
// then the universe (`any`, package ""); then, for another package's code, the
// module's own package (the bare-name fallback).
func bareIfacePkg(gc @GenCtx, name *[]readonly char) (@[]char, bool) {
	var emptyPkg @[]char
	for i := 0; i < len(gc.CurrentTypeParamNames); i++ {
		if irutil.Streq(gc.CurrentTypeParamNames[i], name) { return emptyPkg, false }
	}
	var ctxPkg @[]char = gc.PkgPath
	if len(gc.Mod.CurrentImportPkg) > 0 { ctxPkg = gc.Mod.CurrentImportPkg }
	if ir.LookupModuleInterfaceIndex(gc.Mod, ctxPkg, name) >= 0 { return ctxPkg, true }
	if ir.LookupModuleInterfaceIndex(gc.Mod, emptyPkg, name) >= 0 {
		// The universe `any`, unless the package declares a non-interface type of
		// that name.
		if shadowsPredeclared(gc) && contextPkgType(gc, name) != nil { return emptyPkg, false }
		return emptyPkg, true
	}
	if len(gc.Mod.CurrentImportPkg) > 0 {
		if definingPkgType(gc, name) != nil { return emptyPkg, false }
		if ir.LookupModuleInterfaceIndex(gc.Mod, gc.PkgPath, name) >= 0 { return gc.PkgPath, true }
	}
	return emptyPkg, false
}

// shadowsPredeclared reports whether any struct or alias registered in gc.Mod is
// named like a predeclared type (or `any`), i.e. whether a predeclared name can
// be shadowed at all.  Shadowing is rare, so resolveTypeExpr and bareIfacePkg
// skip their package-type lookups for a predeclared name when it is false.  The
// type tables only grow, so each call checks just the entries registered since
// the previous one (rescanning from the start if a table ever shrinks).
func shadowsPredeclared(gc @GenCtx) bool {
	if gc.Mod == nil { return false }
	if gc.ShadowScanStructs > len(gc.Mod.Structs) || gc.ShadowScanAliases > len(gc.Mod.TypeAliases) {
		gc.ShadowScanStructs = 0
		gc.ShadowScanAliases = 0
		gc.ShadowsPredeclared = false
	}
	for i := gc.ShadowScanStructs; i < len(gc.Mod.Structs); i++ {
		if isPredeclaredTypeName(qualSuffix(gc.Mod.Structs[i].Name)) { gc.ShadowsPredeclared = true }
	}
	gc.ShadowScanStructs = len(gc.Mod.Structs)
	for i := gc.ShadowScanAliases; i < len(gc.Mod.TypeAliases); i++ {
		if isPredeclaredTypeName(qualSuffix(gc.Mod.TypeAliases[i].Name)) { gc.ShadowsPredeclared = true }
	}
	gc.ShadowScanAliases = len(gc.Mod.TypeAliases)
	return gc.ShadowsPredeclared
}

// isPredeclaredTypeName reports whether name is a predeclared type name or `any`.
func isPredeclaredTypeName(name *[]readonly char) bool {
	return predeclaredType(name) != nil || irutil.Streq(name, "any")
}

// qualSuffix returns the part of a registered type name after its last '.' (the
// type's own name for a package-qualified "pkg/path.Name"; the whole name when
// unqualified).
func qualSuffix(name *[]readonly char) *[]readonly char {
	for i := len(name) - 1; i >= 0; i-- {
		if name[i] == '.' { return name[i + 1:len(name)] }
	}
	return name
}

// bareGlobalIdx returns the index in Mod.GlobalVars of the global an
// unqualified name refers to — CurrentImportPkg's (registered under its
// qualified name), then the module's — or -1.  A const, func, type or
// interface of CurrentImportPkg by that name wins over a module global: -1.
// The module's own globals are not in scope in a body written in another
// package (an imported generic function or method): there a consumer global
// named like one of that package's generic functions, or like one of its
// imports, would otherwise read as a variable shadowing it.
func bareGlobalIdx(gc @GenCtx, name *[]readonly char) int {
	if len(gc.Mod.CurrentImportPkg) > 0 {
		var qualName @[]char = qualNameInPkg(gc.Mod.CurrentImportPkg, name)
		for i := 0; i < len(gc.Mod.GlobalVars); i++ {
			if irutil.Streq(gc.Mod.GlobalVars[i].Name, qualName) { return i }
		}
		if findModuleConst(gc, qualName) >= 0 || lookupFuncExists(gc, qualName) ||
				definingPkgType(gc, name) != nil ||
				ir.LookupModuleInterfaceIndex(gc.Mod, gc.Mod.CurrentImportPkg, name) >= 0 {
			return -1
		}
		if !irutil.Streq(gc.Mod.CurrentImportPkg, gc.PkgPath) { return -1 }
	}
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		if irutil.Streq(gc.Mod.GlobalVars[i].Name, name) { return i }
	}
	return -1
}

// methodExprName returns the method symbol that the method expression
// `typeName.method` names, or "" when typeName names no method-bearing type.
// typeName is resolved in the defining package of the generic body being
// emitted first (CurrentImportPkg), then in the module: at each level a named
// receiver type (a struct by the struct registry; a named-distinct scalar
// (`type Celsius int`), in no IR-gen registry, by the method symbol's
// existence, as a method def is registered as <pkg>.T.M for any receiver kind),
// then an alias of one (aliasTargetMethodName).  Finishing the defining
// package's level first keeps a same-named type of the consuming module from
// capturing the name.  A universe primitive names its method in the
// pkg/builtins/lang carve-out under the type's own name (`char` is `uint8`).
// At the module level an import alias (`pkg.Func`) names no type and skips the
// alias and primitive lookups; the defining package's level looks only its own
// aliases up, so the consuming module's import names cannot hide one.
func methodExprName(gc @GenCtx, typeName @[]char, method *[]readonly char) @[]char {
	var none @[]char
	var isImport bool = isImportAliasName(gc.Mod, typeName)
	if len(gc.Mod.CurrentImportPkg) > 0 {
		var defName @[]char = buildMethodQualName(gc.Mod.CurrentImportPkg, typeName, method)
		if lookupStructIdx(gc, qualNameInPkg(gc.Mod.CurrentImportPkg, typeName)) >= 0 ||
				lookupFuncExists(gc, defName) {
			return defName
		}
		var t @types.Type = lookupTypeAlias(gc, qualNameInPkg(gc.Mod.CurrentImportPkg, typeName))
		var defAliased @[]char = aliasTargetMethodName(gc, t, gc.Mod.CurrentImportPkg, method)
		if len(defAliased) > 0 { return defAliased }
	}
	var modName @[]char = buildMethodQualName(gc.PkgPath, typeName, method)
	if lookupStructIdx(gc, typeName) >= 0 || lookupFuncExists(gc, modName) { return modName }
	if isImport { return none }
	var aliased @[]char = aliasTargetMethodName(gc, lookupTypeAlias(gc, typeName), gc.PkgPath, method)
	if len(aliased) > 0 { return aliased }
	return aliasTargetMethodName(gc, predeclaredType(typeName), gc.PkgPath, method)
}

// aliasTargetMethodName returns the method symbol for `method` on t, the
// registered target of an alias (`type A = Point` — or a distinct named type,
// which the same TypeAliases table holds): a named struct or named type keys on
// its own qualified name (defaultPkg for an unqualified one), and a generic
// instance's methods are emitted here, as they are only at a use; a universe
// primitive (`type I = int`) names its carve-out method.  "" for any other
// target — an alias of an unnamed type (`type PA = *Point`) has no methods.
func aliasTargetMethodName(gc @GenCtx, t @types.Type, defaultPkg *[]readonly char,
		method *[]readonly char) @[]char {
	var none @[]char
	if t == nil { return none }
	if irutil.IsUniversePrimitive(t) && len(t.Name) > 0 {
		return primitiveMethodName(t.Name, method)
	}
	if len(t.Name) == 0 || (t.Kind != types.TYP_STRUCT && t.Kind != types.TYP_NAMED) {
		return none
	}
	ensureMethodsForInstName(gc, t.Name)
	var pkg @[]char = qualifierTypeName(t.Name)
	if len(pkg) == 0 { pkg = buf.CopyStr(defaultPkg) }
	return buildMethodQualName(pkg, shortTypeName(t.Name), method)
}

// primitiveMethodName returns the carve-out symbol of a method on a universe
// primitive: `pkg/builtins/lang.<type>.<method>`, as a method call on a
// primitive value names it.
func primitiveMethodName(typeName *[]readonly char, method *[]readonly char) @[]char {
	return irutil.PrimitiveQualifiedName(buf.Concat(buf.Concat(typeName, "."), method))
}

// isImportAliasName reports whether name is one of the module's import aliases
// (the `pkg` of `pkg.Func`).
func isImportAliasName(m @ir.Module, name *[]readonly char) bool {
	for i := 0; i < len(m.ImportAliasNames); i++ {
		if irutil.Streq(m.ImportAliasNames[i], name) { return true }
	}
	return false
}

// declareMethodExprTarget declares the method a method expression names when the
// module has no signature for it — a method of a type from a package the module
// does not import directly, reached through an alias — from the checker's type
// of the expression (the method's signature, receiver first), as ensureMethodSig
// does for a call through a value of that type.
func declareMethodExprTarget(ctx @GenContext, e @ast.Expr, qualName @[]char) {
	if ctx.Checker == nil || lookupFuncExists(ctx.Gc, qualName) { return }
	var fv @types.Type = types.StripWrappers(ctx.Checker.ExprType(e.ResolvedTypeID))
	if fv == nil || (fv.Kind != types.TYP_FUNC_VALUE && fv.Kind != types.TYP_MANAGED_FUNC_VALUE) {
		return
	}
	var m @types.Method = make(types.Method)
	m.Name = buf.CopyStr(e.Name)
	m.FuncType = types.MakeFuncType(fv.Params, fv.Results)
	ensureMethodSig(ctx, qualName, m)
}

// funcRefShadowed reports whether a variable in scope shadows the function
// reference e (resolved to refName by funcRefName): a local or parameter of the
// bare name — funcRefName qualifies a bare name to the defining package's
// function, which a local of that name hides — a variable naming a selector's
// base (`x.F` with a local `x` hiding an import `x` is a field or method value,
// not the package member), or a global of the resolved name.
func funcRefShadowed(ctx @GenContext, e @ast.Expr, refName *[]readonly char) bool {
	if e.Kind == ast.EXPR_IDENT && localValueBound(ctx, e.Name) { return true }
	if e.Kind == ast.EXPR_SELECTOR && selectorBaseIsVar(ctx, e) { return true }
	return localValueBound(ctx, refName)
}

// localValueBound reports whether name is bound to a value — a local variable
// or constant, a parameter, or a global — which shadows a function, type or
// package of the same name.
func localValueBound(ctx @GenContext, name *[]readonly char) bool {
	return lookupVarType(ctx, name) != nil || lookupLocalConst(ctx, name) >= 0
}

// selectorBaseIsVar reports whether the selector e's base `X` (in `X.M`) is a
// variable in scope — a local, parameter or global, which shadows a type or
// package of the same name — so `X.M` is a field or method VALUE, never a method
// expression or package member.
func selectorBaseIsVar(ctx @GenContext, e @ast.Expr) bool {
	return e.X != nil && e.X.Kind == ast.EXPR_IDENT && localValueBound(ctx, e.X.Name)
}
