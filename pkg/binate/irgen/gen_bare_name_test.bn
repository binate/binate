package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// addGlobal registers a module global named name.
func addGlobal(gc @GenCtx, name *[]readonly char) {
	var mg irsym.ModuleGlobal
	mg.Name = strToBytes(name)
	mg.Typ = types.TypInt()
	gc.Mod.GlobalVars = slices.Append[irsym.ModuleGlobal](gc.Mod.GlobalVars, mg)
}

// A bare global name resolves to the defining package's global (registered
// qualified) before the module's same-named one; with no package active, to the
// module's.
func TestBareGlobalIdxDefiningPkgFirst() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	addGlobal(gc, "Count")
	addGlobal(gc, "pkg/g.Count")
	if bareGlobalIdx(gc, "Count") != 0 {
		return fail("no active package: expected the module's global")
	}
	gc.Mod.CurrentImportPkg = strToBytes("pkg/g")
	if bareGlobalIdx(gc, "Count") != 1 { return fail("expected pkg/g's global") }
	if bareGlobalIdx(gc, "Missing") != -1 { return fail("expected -1 for an unknown name") }
	return ""
}

// A const of the defining package wins over a same-named module global: the
// bare name is not a global at all.
func TestBareGlobalIdxDefiningConstWins() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	addGlobal(gc, "Lim")
	var mc irsym.ModuleConst
	mc.Name = strToBytes("pkg/g.Lim")
	mc.Val = 9
	gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
	gc.Mod.CurrentImportPkg = strToBytes("pkg/g")
	if bareGlobalIdx(gc, "Lim") != -1 { return fail("expected pkg/g's const to win") }
	var v int
	var ok bool
	v, _, ok = lookupBareConst(gc, "Lim")
	if !ok || v != 9 { return fail("expected pkg/g's const value 9") }
	return ""
}
