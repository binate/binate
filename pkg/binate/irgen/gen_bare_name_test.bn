package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// addGlobal registers a module global named name.
func addGlobal(gc @GenCtx, name *[]readonly char) {
	var mg irsym.ModuleGlobal
	mg.Name = strToBytes(name)
	mg.Typ = types.TypInt()
	gc.Mod.GlobalVars = slices.Append[irsym.ModuleGlobal](gc.Mod.GlobalVars, mg)
}

// A bare global name is the module's own global: not another package's of the
// same name (registered qualified), and -1 for a name the module has none of.
func TestBareGlobalIdx() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	addGlobal(gc, "pkg/g.Count")
	addGlobal(gc, "Count")
	if bareGlobalIdx(gc, "Count") != 1 { return fail("expected the module's global") }
	if bareGlobalIdx(gc, "Missing") != -1 { return fail("expected -1 for an unknown name") }
	return ""
}

// addConst registers a module constant named name with value v — a function's
// local one when local.
func addConst(gc @GenCtx, name *[]readonly char, v int64, local bool) {
	var mc irsym.ModuleConst
	mc.Name = strToBytes(name)
	mc.Val = v
	mc.Local = local
	gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
}

// A bare constant name is the module's own package constant, and a function's
// constant of the same name, registered after it, shadows it; another package's
// constant (registered qualified) is not read by its bare name.
func TestBareModuleConst() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	gc.PkgPath = strToBytes("main")
	addConst(gc, "pkg/g.K", 3, false)
	addConst(gc, "pkg/g.J", 4, false)
	addConst(gc, "K", 1, false)
	if findModuleConst(gc, "K") != 2 || !isPackageConstIdent(gc, mkIdentExpr(strToBytes("K"))) {
		return fail("expected the module's constant")
	}
	if findModuleConst(gc, "J") != -1 || isPackageConstIdent(gc, mkIdentExpr(strToBytes("J"))) {
		return fail("another package's J must not be read by its bare name")
	}
	addConst(gc, "K", 2, true)
	if findModuleConst(gc, "K") != 3 { return fail("expected the local constant") }
	return ""
}
