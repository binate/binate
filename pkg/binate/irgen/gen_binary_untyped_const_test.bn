package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests that an untyped integer constant operand of a binary operator — however
// it is spelled: a literal, a negated literal, a parenthesized constant
// expression, or an untyped const name, on either side — is emitted once, at its
// typed peer's type, so the operation (and its result) is at the peer's type.

// isIntOfWidth reports whether t is a concrete integer type of the given width
// and signedness.
func isIntOfWidth(t @types.Type, width int, signed bool) bool {
	return t != nil && t.Kind == types.TYP_INT && t.Width == width && t.Signed == signed
}

// constsWithValue returns every OP_CONST_INT in f whose value is v.
func constsWithValue(f @ir.Func, v int64) @[]@ir.Instr {
	var n int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
			var ins @ir.Instr = f.Blocks[bi].Instrs[ii]
			if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == v { n = n + 1 }
		}
	}
	var out @[]@ir.Instr = make_slice(@ir.Instr, n)
	var k int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
			var ins @ir.Instr = f.Blocks[bi].Instrs[ii]
			if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == v {
				out[k] = ins
				k = k + 1
			}
		}
	}
	return out
}

// untypedConstBinop generates `src` (one function, f) and checks that its first
// `op` instruction and the one constant of value v are both of the given integer
// type, with no other constant of that value and no OP_NEG (a negative constant
// is emitted directly, not negated at the default type).  Returns "" or a
// failure message naming `what`.
func untypedConstBinop(src *[]readonly char, op int, v int64, width int, signed bool,
		what *[]readonly char) testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(src)
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var f @ir.Func = m.Funcs[0]
	var bin @ir.Instr = firstOp(f, op)
	if bin == nil { return fail(buf.CopyStr(what)) }
	if !isIntOfWidth(bin.Typ, width, signed) { return fail(buf.CopyStr(what)) }
	var cs @[]@ir.Instr = constsWithValue(f, v)
	if len(cs) != 1 { return fail(buf.CopyStr(what)) }
	if !isIntOfWidth(cs[0].Typ, width, signed) { return fail(buf.CopyStr(what)) }
	if firstOp(f, iropcode.OP_NEG) != nil { return fail(buf.CopyStr(what)) }
	return ""
}

// A negated literal on the LEFT of an int16 subtraction.
func TestNegatedLiteralLeftTakesPeerType() testing.TestResult {
	return untypedConstBinop("package \"test\"\nfunc f(x int16) int16 { return -30000 - x }\n",
			iropcode.OP_SUB, cast(int64, -30000), 16, true,
			"-30000 - x (x int16) must be an int16 SUB over one int16 constant -30000")
}

// A parenthesized negative constant expression on the RIGHT of an int16 AND.
func TestParenConstRightTakesPeerType() testing.TestResult {
	return untypedConstBinop("package \"test\"\nfunc f(x int16) int16 { return x & (0 - 32768) }\n",
			iropcode.OP_AND, cast(int64, -32768), 16, true,
			"x & (0 - 32768) (x int16) must be an int16 AND over one int16 constant -32768")
}

// A parenthesized negative constant expression on the LEFT of an int8 multiply.
func TestParenConstLeftTakesPeerType() testing.TestResult {
	return untypedConstBinop("package \"test\"\nfunc f(x int8) int8 { return (0 - 100) * x }\n",
			iropcode.OP_MUL, cast(int64, -100), 8, true,
			"(0 - 100) * x (x int8) must be an int8 MUL over one int8 constant -100")
}

// An untyped const name bound to a negative value, on the LEFT of an int32 add.
func TestUntypedConstNameLeftTakesPeerType() testing.TestResult {
	return untypedConstBinop(
			"package \"test\"\nconst K = -2000000000\nfunc f(x int32) int32 { return K + x }\n",
			iropcode.OP_ADD, cast(int64, -2000000000), 32, true,
			"K + x (K = -2000000000, x int32) must be an int32 ADD over one int32 constant")
}

// A constant expression above the int32 range on the LEFT of a uint32 OR: it
// takes uint32, not the int64 an oversized fold otherwise gets.
func TestWideConstLeftTakesUint32PeerType() testing.TestResult {
	return untypedConstBinop(
			"package \"test\"\nfunc f(x uint32) uint32 { return (0 + 4000000000) | x }\n", iropcode.OP_OR,
			cast(int64, 4000000000), 32, false,
			"(0 + 4000000000) | x (x uint32) must be a uint32 OR over one uint32 constant")
}

// A plain literal on the LEFT is emitted once — no dead default-typed copy
// before the one at the peer's type.
func TestLiteralLeftEmittedOnce() testing.TestResult {
	return untypedConstBinop("package \"test\"\nfunc f(x uint8) uint8 { return 5 | x }\n",
			iropcode.OP_OR, cast(int64, 5), 8, false,
			"5 | x (x uint8) must be a uint8 OR over exactly one uint8 constant 5")
}

// A compare against a negative constant expression compares at the peer's type.
func TestParenConstCompareTakesPeerType() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc f(x int8) bool { return (0 - 100) > x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var cs @[]@ir.Instr = constsWithValue(m.Funcs[0], cast(int64, -100))
	if len(cs) != 1 || !isIntOfWidth(cs[0].Typ, 8, true) {
		return fail("(0 - 100) > x (x int8) must compare against one int8 constant -100")
	}
	return ""
}
