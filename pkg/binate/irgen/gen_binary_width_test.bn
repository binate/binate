package "pkg/binate/irgen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// b43a0057 makes the divide-overflow guard see a named sub-word integer's
// true width and signedness via typeWidth / typeIsSigned (which peel
// TYP_NAMED).  widenType returns the named operand type for equal-width
// operands; this pins that a named int8 keeps width 8 + signed, so a
// `MIN / -1` divide is correctly guarded — it previously read width 64 /
// unsigned off the bare TYP_NAMED, letting the overflow escape.
func TestWidenTypePreservesNamedSubWordWidthAndSign() testing.TestResult {
	var i8 @types.Type = types.MakeNamedType("I8")
	i8.Underlying = types.TypInt8()
	var w @types.Type = widenType(i8, i8)
	if typeWidth(w) != 8 {
		return fail("widenType(I8,I8) must keep width 8")
	}
	if !typeIsSigned(w) {
		return fail("widenType(I8,I8) must keep signed=true")
	}
	return ""
}

// typeWidth sees through every transparent wrapper — readonly, alias, and
// named-over-readonly — to the underlying scalar's width.  A wrapper has no
// Width of its own, so reading it unpeeled gives the 64-bit default and an
// untyped literal stored into a `readonly float32` slot is never narrowed.
func TestTypeWidthPeelsReadonlyAndAlias() testing.TestResult {
	if typeWidth(types.MakeReadonlyType(types.TypFloat32())) != 32 {
		return fail("readonly float32 must have width 32")
	}
	if typeWidth(types.MakeReadonlyType(types.TypInt8())) != 8 {
		return fail("readonly int8 must have width 8")
	}
	if typeWidth(types.MakeAliasType("F", types.TypFloat32())) != 32 {
		return fail("an alias of float32 must have width 32")
	}
	var r @types.Type = types.MakeNamedType("R")
	r.Underlying = types.MakeReadonlyType(types.TypInt16())
	if typeWidth(r) != 16 {
		return fail("named-over-readonly int16 must have width 16")
	}
	return ""
}

// A wrapped integer left operand strictly WIDER than the right operand keeps
// its own type (not the TypInt() fallback): a named uint32 against a uint8
// stays the named uint32 (width 32, unsigned), and — on a 32-bit target, where
// `int` is 32 bits — a readonly int64 against an int stays 64 bits wide.
func TestWidenTypeKeepsWiderWrappedIntLeftOperand() testing.TestResult {
	var nu @types.Type = types.MakeNamedType("NU")
	nu.Underlying = types.TypUint32()
	var w @types.Type = widenType(nu, types.TypUint8())
	if w != nu { return fail("widenType(NU uint32, uint8) must return NU") }
	if typeWidth(w) != 32 || typeIsSigned(w) {
		return fail("widenType(NU uint32, uint8) must keep width 32, unsigned")
	}
	var saved types.TargetInfo = types.GetTarget()
	setTarget32()
	var w64 @types.Type = widenType(types.MakeReadonlyType(types.TypInt64()), types.TypInt())
	var width int = typeWidth(w64)
	types.SetTarget(saved)
	if width != 64 {
		return fail("widenType(readonly int64, int) on a 32-bit target must stay 64 bits")
	}
	return ""
}
