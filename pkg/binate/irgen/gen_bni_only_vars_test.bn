package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// A `.bni`-only package -- its merged file is the `.bni`, every declaration FromBNI,
// as the loader marks them -- declares its vars, top-level and grouped, as extern
// globals: their storage and initial value are its implementation's (a compiled
// library's, §16.5.1), so its own module neither defines them nor has an `__init` that
// stores a `.bni` initializer into them.  (strToBytes is in gen_test_support_test.bn.)
func TestBniOnlyPackageVarsAreExtern() testing.TestResult {
	var src *[]readonly char = "package \"pkg/solo\"\nvar V int\nvar C int = 5\nvar (\n\tA int\n"
			"\tB int = 2\n)\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "solo.bni")
	var file @ast.File = p.ParseFile()
	for i := 0; i < len(file.Decls); i++ { file.Decls[i].FromBNI = true }
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(nil, file, gc, make_slice(@ast.File, 0))
	if len(gc.Mod.Globals) != 4 { return fail("expected four globals") }
	for i := 0; i < len(gc.Mod.Globals); i++ {
		if !gc.Mod.Globals[i].IsExtern { return fail("a .bni-only package's var is defined") }
	}
	for i := 0; i < len(gc.Mod.Funcs); i++ {
		if irutil.Streq(gc.Mod.Funcs[i].Name, initFuncName(gc)) {
			return fail("a .bni initializer runs in the package's __init")
		}
	}
	return ""
}

// The same declarations in a package's own `.bn` files define the vars.
func TestBnPackageVarsAreDefined() testing.TestResult {
	var src *[]readonly char = "package \"pkg/solo\"\nvar V int\nvar C int = 5\nvar (\n\tA int\n"
			"\tB int = 2\n)\n"
	var p @parser.Parser = parser.New(strToBytes(src), "solo.bn")
	var file @ast.File = p.ParseFile()
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(nil, file, gc, make_slice(@ast.File, 0))
	if len(gc.Mod.Globals) != 4 { return fail("expected four globals") }
	for i := 0; i < len(gc.Mod.Globals); i++ {
		if gc.Mod.Globals[i].IsExtern { return fail("a .bn package's var is extern") }
	}
	return ""
}
