package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// Value-borrow lowering for implicit interface construction
// (iface.construct.value-borrow): the predicates that classify a borrowable
// value source and its materialised-temp type/cleanup, plus genBorrowSourceAddr
// (the read-flavoured address-of a borrowed operand).  Extracted from gen_util.bn
// to keep that file under the length cap; the borrow-materialise call sites live
// in gen_util.bn (genExprOrFuncRef) and gen_expr.bn.

// isBorrowableValueSource reports whether a source of checker type `t` is a
// genuine VALUE (not a pointer / managed pointer / interface value) — the shape
// the implicit interface value-borrow boxes by taking its ADDRESS rather than
// boxing a pointer directly.  Mirrors the checker's canBorrowValueIntoRawIface
// source filter.  A composite literal is such a value type here, but lowers to
// its backing pointer, so it satisfies the pointer path without a separate load.
func isBorrowableValueSource(t @types.Type) bool {
	if t == nil { return false }
	// Peel aliases and `readonly` only: a named type over a pointer or an interface
	// value (`type PS *S`, `type H @Node`, `type X @J`) is a value, borrowed by its
	// address like any other (iface.construct.named-pointer), so the box's data word
	// points at the PS and its value-receiver methods dispatch through the deref
	// thunk (needsRecvThunk).
	var r @types.Type = types.ResolveAliasAndConst(t)
	if r == nil { return false }
	return r.Kind != types.TYP_POINTER && r.Kind != types.TYP_MANAGED_PTR &&
			r.Kind != types.TYP_INTERFACE_VALUE && r.Kind != types.TYP_INTERFACE_VALUE_MANAGED &&
			r.Kind != types.TYP_NIL
}

// defaultedBorrowType maps an untyped source type to its concrete default, for
// the element type of a materialised value-borrow temporary.  Allocating the
// UNTYPED type would carry an untyped element into the `(T, any)` box record and
// re-trip the box(<untyped constant>) class of crash (checker/IR-gen divergence),
// so a `fmt.Print(42)` temp must be `int`, a `2.5` temp `float64`, etc.  Mirrors
// the checker's defaultType.  A concrete source type passes through unchanged.
func defaultedBorrowType(t @types.Type) @types.Type {
	if t == nil { return t }
	if t.Kind == types.TYP_UNTYPED_INT { return types.TypInt() }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return types.TypFloat64() }
	if t.Kind == types.TYP_UNTYPED_BOOL { return types.TypBool() }
	if t.Kind == types.TYP_UNTYPED_STRING {
		// A string literal borrows as a RAW *[]readonly char over rodata (no refcount,
		// no cleanup) — the shape the interface-value special case materialises.
		// Defensive: a string literal normally takes that special case and does not
		// reach the generic borrow-temp path; return the raw slice (NOT the managed
		// @[]readonly char default) so a temp allocated here would not try to RefDec
		// static rodata.
		return types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	}
	return t
}

// borrowSlotType is the IR type of the slot a non-addressable value borrowed into
// a raw interface is materialised in: the source's checker type, defaulted
// (defaultedBorrowType) and mapped to IR-gen's representation (irTypeFromChecker).
// The slot's type names the box's vtable, type info and destructor, so a checker
// spelling must not leak into it — a generic instance (`Box[int]`, or a named
// pointer to one) is IR-gen's mangled instance, else the box names a vtable and a
// destructor nothing defines.  The genExprOrFuncRef borrow paths and the defer
// pre-pass (deferArgBorrowVt) share it, so a pre-allocated defer slot has exactly
// the type the store into it uses.
func borrowSlotType(ctx @GenContext, srcT @types.Type) @types.Type {
	var vt @types.Type = defaultedBorrowType(srcT)
	var irT @types.Type = irTypeFromChecker(ctx.Gc, vt)
	if irT != nil { return irT }
	return vt
}

// borrowTempNeedsCleanup reports whether a materialised value-borrow temporary
// of type `t` owns a managed reference that must be RefDec'd (the copy into the
// temp acquired it).  Mirrors the managed-local cleanup predicate
// (emitDecForManagedLocals).  A pointer-free temp (a scalar, a pointer-free
// struct) needs no cleanup and is a plain frame-lived alloca.  A managed-pointer
// temp is the value of a named managed pointer type (`type H @Node`); a plain `@T`
// source is pointer-shaped and never borrowed.
func borrowTempNeedsCleanup(t @types.Type) bool {
	if t == nil { return false }
	var st @types.Type = types.StripWrappers(t)
	return irutil.IsManagedSliceType(st) || irutil.IsManagedIfaceValueType(st) ||
			irutil.IsManagedFuncValueType(st) || irutil.IsManagedPtrType(st) || needsStructCopy(st)
}

// genBorrowSourceAddr computes what the implicit value-borrow
// (iface.construct.value-borrow) of a VALUE source `e` boxes: the address of an
// addressable source, or the value of one the checker marked non-addressable
// (ast.Expr.BorrowTemp), which the caller copies into a temporary.  The address
// carries the nil-checks a READ of `e` performs (opt-in, --check-nil).  The box
// dereferences the returned pointer, so a field-access / deref through a NIL base
// must fault — exactly as a plain READ of `*p` / `p.f` does through genUnary / a
// field load.
// genLValueAddr alone hardcodes address-of semantics (forDeref=false), under which
// `&*p` / `&p.f` never fault: correct for a bare `&e`, but wrong for a value-borrow,
// which is semantically a read of `e`.  When --check-nil is OFF (the default),
// emitNilCheckIfEnabled and genSelectorPtr(forDeref=true) emit nothing, so the IR is
// byte-identical to genLValueAddr.  A deref, selector, or index operand carries a
// base to check (a nil deref / field-base / raw-pointer index base faults); every
// other shape falls back to genLValueAddr unchanged.  The bool reports whether the
// result is the source's ADDRESS (false: its value — the snapshot of a deferred
// call's operand, or a non-addressable source), as genLValueAddrOrValue does.
func genBorrowSourceAddr(ctx @GenContext, b @ir.Block, e @ast.Expr) (@ir.Instr, bool) {
	if e == nil { return nil, false }
	// Under a defer operand evaluation, return the VALUE (not the source's
	// address), forcing the caller's box path to materialise a snapshot temp and
	// box THAT — so `defer Println(x)` captures x's value now, not at exit
	// (§14.13 stmt.defer, eager by-value evaluation).  An addressable source's
	// address (the aliasing 2a path) would otherwise read the value at call time.
	if ctx.SnapshotBorrows {
		var v @ir.Instr = genExpr(ctx, b, e)
		// An aggregate source (a struct/array composite literal, or an addressable
		// aggregate) genExpr's to its backing POINTER, which the box would alias
		// (the 2a path) — freeing that defer-site backing's managed fields before
		// the deferred call runs.  Load the VALUE so the box snapshots it (the 2b
		// path), which the defer pre-pass pre-allocated an entry-depth slot for.
		if isStructOrArrayAlloc(v) {
			v = irbuild.EmitLoad(ctx.CurBlock, v, v.TypeArg)
		}
		return v, false
	}
	// A source the checker found non-addressable (ast.Expr.BorrowTemp) is borrowed
	// through a temporary holding its VALUE: a field or element of a call result
	// has an address inside that result's statement temporary, so boxing it would
	// dangle after the statement.  An aggregate's backing alloca is loaded so the
	// caller copies it into the temporary rather than boxing the alloca.
	if e.BorrowTemp {
		var tv @ir.Instr = genExpr(ctx, b, e)
		if tv != nil && isStructOrArrayAlloc(tv) {
			tv = irbuild.EmitLoad(ctx.CurBlock, tv, tv.TypeArg)
		}
		return tv, false
	}
	// *p: the address IS the pointer, and the box will deref it — nil-check it.
	// genExpr(e.X) evaluates the base EXACTLY once (no double-eval of a
	// side-effecting `*getP()`), mirroring genLValueAddr's deref arm.
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var p @ir.Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		emitNilCheckIfEnabled(ctx, b, p)
		return derefAddr(ctx, p), true
	}
	// p.field: nil-check the base pointer as the field address is computed
	// (forDeref=true), so a value-borrow of a field through a nil managed/raw
	// pointer faults like a direct field read.
	if e.Kind == ast.EXPR_SELECTOR {
		var fp @ir.Instr = genSelectorPtr(ctx, b, e, true)
		if fp != nil { return fp, true }
	}
	// coll[i]: compute the element address with forDeref=true, so a value-borrow
	// of an element through a nil RAW-POINTER base (`ptr[i]`) nil-checks the base
	// (genIndexPtr's pointer arm), like a direct `ptr[i]` read.  Array bases are
	// allocas and slice bases get a bounds check (a nil slice has len 0, so any
	// index faults there), so forDeref only adds the raw-pointer nil-check.  Falls
	// through to genLValueAddr for the generic-instantiation shape (genIndexPtr
	// returns nil), which never reaches the value-borrow anyway.
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var ep @ir.Instr = genIndexPtr(ctx, b, e, true)
		if ep != nil { return ep, true }
	}
	return genLValueAddrOrValue(ctx, b, e)
}
