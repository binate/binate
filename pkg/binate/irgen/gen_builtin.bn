package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// genBuiltin generates IR for builtin keyword expressions
// (cast, bit_cast, len, make, make_slice, box).
func genBuiltin(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	if e.Op == cast(int, token.CAST) || e.Op == cast(int, token.BIT_CAST) ||
			e.Op == cast(int, token.UNSAFE_CAST) {
		if len(e.Args) >= 1 {
			return genCastBuiltin(ctx, b, e)
		}
	}
	if e.Op == cast(int, token.LEN) {
		if len(e.Args) >= 1 {
			var arg @ir.Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			// For arrays, len is a compile-time constant.  Peel transparent
			// wrappers (readonly / named / alias) first: a named array
			// (`type Row [3]int`) carries its length on the underlying
			// TYP_ARRAY, not the TYP_NAMED wrapper (whose ArrayLen is 0), so
			// an un-peeled read would return len 0 and then fall through to
			// EmitSliceLen on a non-slice (invalid IR).
			var argSt @types.Type = nil
			if arg.Typ != nil { argSt = types.StripWrappers(arg.Typ) }
			if argSt != nil && argSt.Kind == types.TYP_ARRAY {
				return irbuild.EmitConstInt(b, argSt.ArrayLen, types.TypInt())
			}
			// A bare string literal lowers to OP_CONST_STRING — a
			// `*readonly uint8` data pointer, not a {ptr,len} slice — so
			// its length is compile-time known (the unescaped byte count).
			// Fold it like the array case; EmitSliceLen would extract a
			// length field the bare pointer doesn't have (invalid IR on
			// compiled backends, a garbage read on the VM).
			if arg.Op == iropcode.OP_CONST_STRING {
				return irbuild.EmitConstInt(b, len(arg.StrVal), types.TypInt())
			}
			return irbuild.EmitSliceLen(b, arg)
		}
	}
	if e.Op == cast(int, token.PRESENT) {
		if len(e.Args) >= 1 {
			var arg @ir.Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			return irbuild.EmitPresent(b, arg, arg.Typ)
		}
	}
	if e.Op == cast(int, token.SAME) {
		if len(e.Args) >= 2 {
			var a @ir.Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			var other @ir.Instr = genExpr(ctx, b, e.Args[1])
			b = ctx.CurBlock
			return irbuild.EmitSame(b, a, other, a.Typ)
		}
	}
	if e.Op == cast(int, token.UNSAFE_INDEX) {
		// unsafe_index(coll, idx): same lowering as coll[idx] but with
		// the bounds check skipped. Synthesize an EXPR_INSTANTIATE_OR_INDEX
		// node and call genIndex with checked=false.
		var proxy @ast.Expr = make(ast.Expr)
		proxy.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
		proxy.Pos = e.Pos
		proxy.X = e.Args[0]
		var idxArgs @[]@ast.Expr = make_slice(@ast.Expr, 1)
		idxArgs[0] = e.Args[1]
		proxy.Args = idxArgs
		return genIndex(ctx, b, proxy, false) // unchecked
	}
	if e.Op == cast(int, token.UNSAFE_DIV) || e.Op == cast(int, token.UNSAFE_REM) {
		// unsafe_div(a, b) / unsafe_rem(a, b): the same integer divide /
		// remainder as `/` / `%`, but WITHOUT the OP_DIV_CHECK guard —
		// the opt-out for hot paths the caller has already proven safe
		// (the divisor analogue of unsafe_index skipping the bounds
		// check). Mirrors genBinary's operand widening, then emits the
		// bare binop with no EmitDivCheck.
		var lhs @ir.Instr = genExpr(ctx, b, e.Args[0])
		b = ctx.CurBlock
		var rhs @ir.Instr = genExpr(ctx, b, e.Args[1])
		b = ctx.CurBlock
		var resultTyp @types.Type = widenType(lhs.Typ, rhs.Typ)
		lhs = ensureWidth(ctx, b, lhs, resultTyp)
		rhs = ensureWidth(ctx, b, rhs, resultTyp)
		var op int = iropcode.OP_DIV
		if e.Op == cast(int, token.UNSAFE_REM) { op = iropcode.OP_REM }
		return irbuild.EmitBinop(b, op, lhs, rhs, resultTyp)
	}
	if e.Op == cast(int, token.UNSAFE_SHL) || e.Op == cast(int, token.UNSAFE_SHR) {
		// unsafe_shl(v, n) / unsafe_shr(v, n): the same integer shift as
		// `<<` / `>>`, but WITHOUT the overshift guard (emitGuardedShift) and
		// WITHOUT the negative-count check (emitShiftCheckGuard) — the opt-out
		// for hot paths the caller has proven keep the count in [0, width).
		// Like a regular shift the result type is the checker's recorded type —
		// the value operand's, or for an untyped value operand the type its
		// context gives it (spec §13.5 expr.shift.untyped-value.unsafe); the count
		// is reconciled to that width and the bare hardware shift is emitted
		// (target-defined for a count outside [0, width)).
		var shiftTyp @types.Type = checkedIntType(ctx, e)
		var sv @ir.Instr = nil
		if shiftTyp != nil && isUntypedIntConst(ctx.Checker, e.Args[0]) {
			sv = genIntLitWithHint(ctx, b, e.Args[0], shiftTyp)
		}
		if sv == nil {
			sv = genExpr(ctx, b, e.Args[0])
		}
		b = ctx.CurBlock
		var sn @ir.Instr = genExpr(ctx, b, e.Args[1])
		b = ctx.CurBlock
		if shiftTyp == nil {
			shiftTyp = sv.Typ
		}
		sv = ensureWidth(ctx, b, sv, shiftTyp)
		sn = ensureWidth(ctx, b, sn, shiftTyp)
		var sop int = iropcode.OP_SHL
		if e.Op == cast(int, token.UNSAFE_SHR) { sop = iropcode.OP_SHR }
		return irbuild.EmitBinop(b, sop, sv, sn, shiftTyp)
	}
	if e.Op == cast(int, token.SIZEOF) {
		// Compile-time constant: the type's size in bytes. Returns
		// a uint-typed constant.
		var targetTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
		return irbuild.EmitConstInt(b, targetTyp.SizeOf(), types.TypUint())
	}
	if e.Op == cast(int, token.ALIGNOF) {
		// Compile-time constant: the type's alignment in bytes.
		var targetTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
		return irbuild.EmitConstInt(b, targetTyp.AlignOf(), types.TypUint())
	}
	if e.Op == cast(int, token.RAW_FUNC_ADDR) {
		// _raw_func_addr(F) (to be renamed _func_handle): emit
		// OP_FUNC_HANDLE.  Result is a *uint8 pointing at a
		// 16-byte {vtable_ptr, data_ptr} handle (the bnc-emitted
		// static `@__handle.F` natively, or a heap handle in
		// bytecode for vm-local functions).
		if len(e.Args) >= 1 {
			var arg @ast.Expr = e.Args[0]
			var name @[]char
			if arg.Kind == ast.EXPR_IDENT {
				name = arg.Name
			}
			if arg.Kind == ast.EXPR_SELECTOR && arg.X != nil && arg.X.Kind == ast.EXPR_IDENT {
				name = buildQualNameHomed(ctx.Gc.Mod, arg.X.Name, arg.Name)
			}
			return irbuild.EmitFuncHandle(b, name)
		}
	}
	// The foreign-function-boundary builtins (__c_call / __c_global / __c_entry)
	// are lowered by genFFIBuiltin (gen_builtin_ffi.bn), grouped there to keep
	// this file under the length cap.
	var ffiResult @ir.Instr
	var ffiHandled bool
	ffiResult, ffiHandled = genFFIBuiltin(ctx, b, e)
	if ffiHandled {
		return ffiResult
	}
	if e.Op == cast(int, token.MAKE) {
		// make(T) — allocate @T for any type T
		var targetTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
		var result @ir.Instr = irbuild.EmitMake(b, targetTyp)
		registerTemp(ctx, result)
		return result
	}
	if e.Op == cast(int, token.MAKE_SLICE) {
		// make_slice(T, n) — T is element type, n is size. Returns @[]T (managed-slice).
		var elemTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
		var length @ir.Instr = genIntOperand(ctx, b, e.Args[0])
		b = ctx.CurBlock
		var result @ir.Instr = irbuild.EmitMakeSlice(b, elemTyp, length)
		registerTemp(ctx, result)
		noteSPGrowingResult(ctx, result)
		return result
	}
	if e.Op == cast(int, token.BOX) {
		if len(e.Args) >= 1 {
			var val @ir.Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			// For alloca results, the elem type is in TypeArg (not the pointer type in Typ)
			var innerTyp @types.Type = val.Typ
			if val.Op == iropcode.OP_ALLOC && val.TypeArg != nil {
				innerTyp = val.TypeArg
			} else if val.Op == iropcode.OP_CONST_STRING {
				// A bare string literal defaults to @[]readonly char (the checker's
				// defaultType(TYP_UNTYPED_STRING) — check_builtin.bn box arm types
				// box("...") as @(@[]readonly char)).  Materialise the managed-slice
				// view of rodata and box THAT, so the 4-word payload matches the
				// checker's type — boxing the bare OP_CONST_STRING *readonly char
				// pointer would emit a 1-word cell a later deref over-reads (and
				// RefDecs a garbage refptr).  The rodata backing is immortal (nil
				// refptr), so the box's managed-slice RefInc/dtor are no-ops.
				var charSliceTyp @types.Type = types.MakeManagedSliceType(
						types.MakeReadonlyType(types.TypChar()))
				val = irbuild.EmitStringToChars(b, val, charSliceTyp)
				b = ctx.CurBlock
				innerTyp = charSliceTyp
				noteSPGrowingResult(ctx, val)
			} else {
				// Default an untyped constant operand to its concrete type.  box takes
				// ANY value, so `box(42)` / `box(2.5)` reaches IR-gen with no type
				// context; boxing it as `@untyped int` yields a DEGENERATE box — its
				// `@untyped-int` → `@any` coercion finds no concrete identity, so no
				// `__typeinfo` is emitted and a later `case int:` misses.  Mirror the
				// checker's defaultType (check_builtin.bn box arm), which already types
				// the box EXPRESSION `@int`; the boxed value must agree.
				var defaulted @types.Type = defaultUntypedType(innerTyp)
				if defaulted != innerTyp {
					innerTyp = defaulted
					val.Typ = defaulted
				}
			}
			var ptrTyp @types.Type = types.MakeManagedPtrType(innerTyp)
			var result @ir.Instr = irbuild.EmitBox(b, val, ptrTyp)
			// The boxed cell holds a bit-copy of val, which shares val's managed
			// references WITHOUT a RefInc — so when the source local/temp is
			// RefDec'd at scope/statement exit the shared referent is freed while
			// the box still points at it (a use-after-free).  Acquire the box's own
			// reference so it OWNS its payload (balanced by the managed-ptr dtor,
			// which runs the pointee's cleanup and RefDec's it when the box frees):
			//   - a struct/array with managed fields: emitStructCopy RefIncs each
			//     managed field of the copy (the box result points at the payload,
			//     the struct pointer emitStructCopy expects);
			//   - a bare managed SLICE (`box(s)` for `s @[]char`): RefInc the shared
			//     backing (balanced by the `@(@[]T)` dtor — emitManagedPtrRefDec's
			//     managed-slice arm).
			//   - a bare managed FUNC-value (`box(f)` for `f @func()`): RefInc the
			//     shared capture record (balanced by the `@(@func())` dtor --
			//     emitManagedPtrRefDec's func-value arm, `__dtor_func`).
			//   - a bare managed IFACE-value (`box(iv)` for `iv @I`): RefInc the
			//     iface value's data slot (balanced by the `@(@I)` dtor --
			//     emitManagedPtrRefDec's iface-value arm, `__dtor_interface`).
			if needsStructCopy(innerTyp) {
				emitStructCopy(ctx.Func, b, result, innerTyp)
			} else if irutil.IsManagedSliceType(innerTyp) {
				emitManagedSliceRefInc(ctx.Func, b, val)
			} else if irutil.IsManagedPtrType(innerTyp) {
				// box(mp) for a bare managed PTR (`mp @Node`): RefInc the pointee so the
				// box owns it (balanced by the `@(@T)` dtor -- emitManagedPtrRefDec's
				// managed-ptr arm).
				irbuild.EmitRefInc(b, val)
			} else if irutil.IsManagedFuncValueType(innerTyp) {
				// box(f) for a bare managed FUNC-value: RefInc the capture record so
				// the box owns it (balanced by the `@(@func())` dtor).
				emitManagedFuncValueRefInc(ctx.Func, b, val)
			} else if irutil.IsManagedIfaceValueType(innerTyp) {
				// box(iv) for a bare managed IFACE-value: RefInc the data slot so the
				// box owns it (balanced by the `@(@I)` dtor, `__dtor_interface`).
				emitManagedIfaceValueRefInc(ctx.Func, b, val)
			}
			registerTemp(ctx, result)
			return result
		}
	}
	return irbuild.EmitConstInt(b, 0, types.TypInt())
}

// defaultUntypedType maps an untyped constant kind to its concrete default —
// TYP_UNTYPED_INT → int, TYP_UNTYPED_FLOAT → float64, TYP_UNTYPED_BOOL → bool —
// mirroring the checker's defaultType (checker_util.bn) at the IR-gen box site,
// where an untyped literal operand has no destination to concretize it.  Any
// already-concrete type passes through unchanged.
func defaultUntypedType(t @types.Type) @types.Type {
	if t == nil {
		return t
	}
	if t.Kind == types.TYP_UNTYPED_INT {
		return types.TypInt()
	}
	if t.Kind == types.TYP_UNTYPED_FLOAT {
		return types.TypFloat64()
	}
	if t.Kind == types.TYP_UNTYPED_BOOL {
		return types.TypBool()
	}
	return t
}

// isSliceOrArrayKind reports whether kind is a raw slice, managed slice, or array
// (the length-carrying containers whose element retype must preserve element size).
func isSliceOrArrayKind(kind int) bool {
	return kind == types.TYP_SLICE || kind == types.TYP_MANAGED_SLICE || kind == types.TYP_ARRAY
}
