package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// genCastBuiltin generates IR for the conversion builtins `cast(T, x)`,
// `unsafe_cast(T, x)` and `bit_cast(T, x)` (e has at least one argument).
func genCastBuiltin(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	var targetTyp @types.Type = resolveTypeExpr(ctx.Gc, e.TypeRef)
	// When the cast operand is an integer literal that fits the
	// target type, emit it at the target type directly.
	// Otherwise `cast(uint64, 0x0102030405060708)` on a
	// 32-bit target would first lower the literal at the
	// untyped-int default (i32), truncating it to
	// 0x05060708 before the widening cast ever runs.
	// Fires for the value-conversion casts (CAST / UNSAFE_CAST);
	// BIT_CAST requires same-width operands so its literal
	// is already correctly typed by the type checker.
	var val @ir.Instr = nil
	if e.Op == cast(int, token.CAST) || e.Op == cast(int, token.UNSAFE_CAST) {
		val = genIntLitWithHint(ctx, b, e.Args[0], targetTyp)
		// A function-reference operand (`cast(*func(int) int, add1)`) must
		// become a function value of the target's kind, as it does in any
		// other function-value slot (func.ref.decay); genExpr alone never
		// forms one.
		var dst @types.Type = types.StripWrappers(targetTyp)
		if val == nil && dst != nil &&
				(dst.Kind == types.TYP_FUNC_VALUE || dst.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			// A managed function value built here is a registered statement
			// temporary (registerFreshFuncValueTemp): the cast's result is a
			// relabel a consumer copies, and the temporary is released at the
			// end of the statement.
			val = genExprOrFuncRef(ctx, b, e.Args[0], targetTyp)
		}
	}
	if val == nil {
		val = genExpr(ctx, b, e.Args[0])
	}
	b = ctx.CurBlock
	// A `nil` operand (`cast(*T, nil)`, `cast(*func(), nil)`) is simply the
	// target type's nil: there is nothing to convert, and the untyped nil has no
	// representation of its own a backend could convert from.  The constant keeps
	// the target's NAMED type (only readonly is stripped for the IR, as for any
	// cast result), since a method call or interface box on it keys on that name
	// (`cast(PS, nil).Get()` calls PS's method, not its underlying's).
	if (e.Op == cast(int, token.CAST) || e.Op == cast(int, token.UNSAFE_CAST)) && val != nil &&
			val.Typ != nil && val.Typ.Kind == types.TYP_NIL {
		return irbuild.EmitConstNil(b, targetTyp)
	}
	// A struct / array composite-literal operand (`cast(T, S{...})`,
	// `bit_cast(T, [N]E{...})`) evaluates to its alloca POINTER, where a
	// variable operand evaluates to the value; convert the VALUE.  Left as
	// the pointer, cast's shape guard sees pointer vs aggregate and
	// bit_cast's size check sees a pointer-sized source.
	if e.Args[0].Kind == ast.EXPR_COMPOSITE && val.Op == iropcode.OP_ALLOC && !val.IsGlobalRef &&
			isStructOrArrayAlloc(val) {
		val = irbuild.EmitLoad(b, val, val.TypeArg)
	}
	if e.Op == cast(int, token.CAST) || e.Op == cast(int, token.UNSAFE_CAST) {
		var lit @ir.Instr = castStringLiteral(ctx, b, val, targetTyp)
		if lit != nil {
			return lit
		}
	}
	if e.Op == cast(int, token.CAST) {
		var castSrc @types.Type = types.StripWrappers(val.Typ)
		var castDst @types.Type = types.StripWrappers(targetTyp)
		// Interface WIDENING (concrete pointer -> interface value): construct
		// the {data, vtable} pair — the safe conversion `cast` now performs
		// (the checker verified satisfaction).  Same lowering unsafe_cast uses.
		// The operand's checker type, not val.Typ, is the box's source type: the
		// IR type has `readonly` stripped, so a `@[]readonly char` would box as
		// `@[]char` and a `case @[]char:` would recover it as MUTABLE.
		if isIfaceValueKind(castDst) && !isIfaceValueKind(castSrc) {
			var wrapped @ir.Instr = wrapAsIfaceValue(ctx, b, val, targetTyp,
					ctx.Checker.ExprType(e.Args[0].ResolvedTypeID))
			if wrapped == nil {
				panic(
						"internal error: cast widening to an interface value produced "
								"no value (non-pointer operand or missing impl vtable); a VALUE "
								"operand reaches here only via a generic type parameter "
								"instantiated to an interface, which the definition-time checker "
								"could not resolve -- widen a pointer (`&x`) instead")
			}
			registerIfaceBox(ctx, wrapped, castDst)
			return wrapped
		}
		if isIfaceValueKind(castSrc) && isIfaceValueKind(castDst) {
			return genIfaceUpcast(ctx, b, val, targetTyp)
		}
		// Interface NARROWING (iface -> concrete): the checker rejects it for
		// CONCRETE types, but a `cast(T, x)` in a GENERIC body whose T
		// instantiates to a narrowing substitutes it only HERE (definition-time
		// saw an abstract type parameter).  `cast` cannot recover a concrete type
		// from an interface value -- fail loud (an OP_CAST would mis-declare the
		// 2-word %BnIfaceValue).
		if isIfaceValueKind(castSrc) || isIfaceValueKind(castDst) {
			panic(
					"internal error: cast to recover a concrete type from an interface "
							"value (narrowing) is not supported; this reached codegen via a "
							"generic type parameter -- recover with `x.(T)` / unsafe_cast")
		}
		return genCastValueConversion(b, val, targetTyp)
	}
	if e.Op == cast(int, token.UNSAFE_CAST) {
		// unsafe_cast is a superset of cast (spec §8.7); its interface
		// conversions are the part cast cannot do:
		//   - NARROWING (interface value -> concrete `@T`/`*T`/value): extract
		//     the data word UNCHECKED (no runtime type check, unlike `x.(T)`),
		//     taking NO reference — refcount-neutral; a binding to an owning
		//     location co-owns via its own copy-RefInc.
		//   - WIDENING (concrete pointer -> interface value): construct the
		//     {data, vtable} pair (RefInc for a managed target — the safe
		//     conversion cast performs; the checker verified satisfaction).
		// An interface -> interface conversion, and every non-interface one,
		// is cast's.
		var ucSrc @types.Type = types.StripWrappers(val.Typ)
		var ucDst @types.Type = types.StripWrappers(targetTyp)
		if isIfaceValueKind(ucSrc) && isIfaceValueKind(ucDst) {
			return genIfaceUpcast(ctx, b, val, targetTyp)
		}
		if isIfaceValueKind(ucSrc) && !isIfaceValueKind(ucDst) {
			return emitRecoveredValue(b, val, targetTyp)
		}
		if isIfaceValueKind(ucDst) && !isIfaceValueKind(ucSrc) {
			// The operand's checker type keeps element-`readonly` (see cast).
			var wrapped @ir.Instr = wrapAsIfaceValue(ctx, b, val, targetTyp,
					ctx.Checker.ExprType(e.Args[0].ResolvedTypeID))
			if wrapped == nil {
				panic(
						"internal error: unsafe_cast widening to an interface value "
								"produced no value (non-pointer operand or missing impl vtable); a "
								"VALUE operand reaches here only via a generic type parameter "
								"instantiated to an interface, which the definition-time checker "
								"could not resolve -- widen a pointer (`&x`) instead")
			}
			registerIfaceBox(ctx, wrapped, ucDst)
			return wrapped
		}
		return genCastValueConversion(b, val, targetTyp)
	}
	// A bit_cast that involves an aggregate stored BY ADDRESS (native/VM) /
	// BY-VALUE first-class (LLVM), or that crosses the by-address/by-value
	// storage boundary, cannot use a register OP_BIT_CAST — route it through a
	// scratch round-trip (bitCastNeedsMemory).  A same-representation scalar /
	// pointer / raw-slice reinterpret stays a direct OP_BIT_CAST.
	var bcSrc @types.Type = types.StripWrappers(val.Typ)
	var bcDst @types.Type = types.StripWrappers(targetTyp)
	// A same-size check the definition-time checker could NOT make: a
	// `bit_cast(T, x)` in a GENERIC body sees an abstract T, so a T
	// instantiated to a DIFFERENT-size type than x reaches here unchecked.
	// bit_cast requires equal size (spec §8.6) — fail loud rather than
	// round-trip mismatched sizes (which would read past / short of the
	// stored bytes).  For non-generic code the checker already guarantees
	// equal size, so this never fires there.
	if bcSrc != nil && bcDst != nil && bcSrc.SizeOf() != bcDst.SizeOf() {
		panic(
				"bit_cast requires the source and target to be the same size "
						"(this different-size bit_cast reached codegen via a generic type "
						"parameter, which the definition-time checker could not size)")
	}
	if bitCastNeedsMemory(bcSrc, bcDst) {
		return emitBitCastViaMemory(b, val, val.Typ, targetTyp)
	}
	return irbuild.EmitBitCast(b, val, targetTyp)
}

// genIfaceUpcast lowers a `cast` / `unsafe_cast` between two interface values.
// The checker accepts only the identity, the widening direction (a sub-interface
// to a super-interface or `any`) and the managed -> raw borrow (`@I -> *J`).
// Identical interface types are the value itself; otherwise the
// vtable-substituting upcast (the OP_IFACE_UPCAST an assignment uses), whose
// backends abort on a target that is not an ancestor of the source.  A raw ->
// managed conversion would invent a reference the source does not own, and no
// backend would catch it, so it fails loud here.
func genIfaceUpcast(ctx @GenContext, b @ir.Block, val @ir.Instr, targetTyp @types.Type) @ir.Instr {
	var src @types.Type = types.StripWrappers(val.Typ)
	var dst @types.Type = types.StripWrappers(targetTyp)
	if src != nil && dst != nil && src.Kind == types.TYP_INTERFACE_VALUE &&
			dst.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		panic("internal error: a raw interface value converted to a managed one reached IR-gen")
	}
	if ifaceValueTypesAgree(ctx.Gc.Mod, val.Typ, targetTyp) {
		return val
	}
	var iv @ir.Instr = irbuild.EmitIfaceUpcast(b, ctx.Gc.Mod, val, "", targetTyp)
	noteSPGrowingResult(ctx, iv)
	return iv
}
