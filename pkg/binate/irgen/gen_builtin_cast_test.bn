package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the conversion builtins in gen_builtin_cast.bn (cast, unsafe_cast,
// bit_cast).  genFromSource / fail live in gen_test_support_test.bn.

// castEntryHasOp reports whether main's entry block holds an instruction with op.
func castEntryHasOp(m @ir.Module, op int) bool {
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == op { return true }
	}
	return false
}

// An integer literal cast to a wide type is emitted at the target width, not
// first at the untyped-int default (which would truncate it on a 32-bit target).
func TestGenCastIntLitAtTargetWidth() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var x uint64 = cast(uint64, 0x0102030405060708)\n")
	cb.Write("  _ = x\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 0x0102030405060708 { return "" }
	}
	return fail("expected the literal as a full-width OP_CONST_INT")
}

// A same-size scalar bit_cast is a register OP_BIT_CAST.
func TestGenBitCastScalar() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float32 = 1.5\n")
	cb.Write("  var u uint32 = bit_cast(uint32, f)\n")
	cb.Write("  _ = u\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	if !castEntryHasOp(m, iropcode.OP_BIT_CAST) {
		return fail("expected OP_BIT_CAST for bit_cast(uint32, float32)")
	}
	return ""
}
