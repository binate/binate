package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the conversion builtins in gen_builtin_cast.bn (cast, unsafe_cast,
// bit_cast).  genFromSource / fail live in gen_test_support_test.bn.

// castEntryHasOp reports whether main's entry block holds an instruction with op.
func castEntryHasOp(m @ir.Module, op int) bool {
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == op { return true }
	}
	return false
}

// An integer literal cast to a wide type is emitted at the target width, not
// first at the untyped-int default (which would truncate it on a 32-bit target).
func TestGenCastIntLitAtTargetWidth() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var x uint64 = cast(uint64, 0x0102030405060708)\n")
	cb.Write("  _ = x\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 0x0102030405060708 { return "" }
	}
	return fail("expected the literal as a full-width OP_CONST_INT")
}

// A same-size scalar bit_cast is a register OP_BIT_CAST.
func TestGenBitCastScalar() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var f float32 = 1.5\n")
	cb.Write("  var u uint32 = bit_cast(uint32, f)\n")
	cb.Write("  _ = u\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	if !castEntryHasOp(m, iropcode.OP_BIT_CAST) {
		return fail("expected OP_BIT_CAST for bit_cast(uint32, float32)")
	}
	return ""
}

// A `nil` operand is the target type's nil — an OP_CONST_NIL of that type, with
// no conversion — for a raw pointer, a managed pointer and a function value.
func TestGenCastNilIsTypedNil() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var p *uint8 = cast(*uint8, nil)\n")
	cb.Write("  var m @int = unsafe_cast(@int, nil)\n")
	cb.Write("  var f *func() = cast(*func(), nil)\n")
	cb.Write("  _ = p\n  _ = m\n  _ = f\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	if castEntryHasOp(m, iropcode.OP_CAST) {
		return fail("cast(T, nil) must not emit an OP_CAST")
	}
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var kinds int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op != iropcode.OP_CONST_NIL || ins.Typ == nil { continue }
		if ins.Typ.Kind == types.TYP_POINTER { kinds = kinds | 1 }
		if ins.Typ.Kind == types.TYP_MANAGED_PTR { kinds = kinds | 2 }
		if ins.Typ.Kind == types.TYP_FUNC_VALUE { kinds = kinds | 4 }
	}
	if kinds != 7 {
		return fail("expected an OP_CONST_NIL typed *uint8, @int and *func()")
	}
	return ""
}

// A named pointer's nil keeps the NAMED type on the constant, as a non-nil cast
// result does: a method call or interface box on it keys on that name.
func TestGenCastNilKeepsNamedType() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type S struct { v int }\n")
	cb.Write("type PS *S\n")
	cb.Write("func main() {\n")
	cb.Write("  var p PS = cast(PS, nil)\n")
	cb.Write("  _ = p\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_NIL && ins.Typ != nil && ins.Typ.Kind == types.TYP_NAMED {
			return ""
		}
	}
	return fail("expected cast(PS, nil) to be an OP_CONST_NIL of the named type PS")
}

// unsafe_cast between interface values lowers as cast does: a sub-interface
// widened to a super-interface is the vtable-substituting OP_IFACE_UPCAST.
func TestGenUnsafeCastIfaceUpcast() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A { f() int }\n")
	cb.Write("interface B : A { g() int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var b @B\n")
	cb.Write("  var a @A = unsafe_cast(@A, b)\n")
	cb.Write("  _ = a\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	if !castEntryHasOp(m, iropcode.OP_IFACE_UPCAST) {
		return fail("expected OP_IFACE_UPCAST for unsafe_cast(@A, @B)")
	}
	return ""
}

// The identity between interface values is the value itself — no upcast.
func TestGenUnsafeCastIfaceIdentityNoUpcast() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface A { f() int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var a @A\n")
	cb.Write("  var b @A = unsafe_cast(@A, a)\n")
	cb.Write("  _ = b\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	if castEntryHasOp(m, iropcode.OP_IFACE_UPCAST) {
		return fail("unsafe_cast(@A, @A) must not emit OP_IFACE_UPCAST")
	}
	return ""
}
