package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the builtin-keyword expression generation in gen_builtin.bn
// (sizeof / alignof).  Shared compileToLLVM/contains/fail helpers live in the
// gen_*_test.bn files (same package).

// sizeof(T) lowers to OP_CONST_INT with T's byte size.
func TestGenSizeofInt() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var s uint = sizeof(int)\n")
	cb.Write("  _ = s\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	// Expect an OP_CONST_INT equal to the IR-gen target's sizeof(int),
	// computed via the SAME types API GenModule emits (targetTyp.SizeOf) —
	// NOT the compile-time `sizeof(int)`, which folds to the test binary's
	// own target width and diverges from the ambient layout target on a
	// cross-target unit run (e.g. the arm32_linux lane).
	var expected int64 = cast(int64, types.TypInt().SizeOf())
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == expected { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT sizeof(int) bytes") }
	return ""
}

// alignof(bool) = 1 (bool is 1 byte, aligned to 1).
func TestGenAlignofBool() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var a uint = alignof(bool)\n")
	cb.Write("  _ = a\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == 1 { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT 1 for alignof(bool)") }
	return ""
}

// sizeof of a raw slice = 2 words (data ptr + length).
func TestGenSizeofSlice() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {\n")
	cb.Write("  var s uint = sizeof(*[]int)\n")
	cb.Write("  _ = s\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	// A raw slice is 2 words; compute via the SAME types API GenModule emits
	// (the *[]int type's SizeOf) so it matches the ambient layout target on
	// any host — not the compile-time `sizeof(*uint8)`, which folds to the
	// test binary's own pointer width.
	var expected int64 = cast(int64, types.MakeSliceType(types.TypInt()).SizeOf())
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == expected { found = true }
	}
	if !found { return fail("expected iropcode.OP_CONST_INT 2*sizeof(ptr) for sizeof(*[]int)") }
	return ""
}

// firstBox returns the first OP_BOX in f, or nil.
func firstBox(f @ir.Func) @ir.Instr {
	if f == nil { return nil }
	for bi := 0; bi < len(f.Blocks); bi++ {
		for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
			var ins @ir.Instr = f.Blocks[bi].Instrs[ii]
			if ins.Op == iropcode.OP_BOX { return ins }
		}
	}
	return nil
}

// box takes its argument's value: a composite literal's slot is loaded before it
// is boxed, while `box(&x)` boxes x's address — the slot itself — typed `@(*S)`.
func TestGenBoxBoxesTheValue() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"test\"\n"
					"type S struct { a int; b int }\n"
					"func lit() @S { return box(S{a: 1, b: 2}) }\n"
					"func addr() @(*S) { var x S; return box(&x) }\n")
	var lit @ir.Instr = firstBox(findFunc(m, "lit"))
	if lit == nil { return fail("lit must box") }
	if lit.Args[0].Op != iropcode.OP_LOAD {
		return fail("a literal's box must box a load of its slot")
	}
	var addr @ir.Instr = firstBox(findFunc(m, "addr"))
	if addr == nil { return fail("addr must box") }
	if addr.Args[0].Op != iropcode.OP_ALLOC { return fail("box(&x) must box x's slot address") }
	var bt @types.Type = types.StripWrappers(ir.BoxedType(addr))
	if bt == nil || bt.Kind != types.TYP_POINTER { return fail("box(&x) must be typed @(*S)") }
	return ""
}
