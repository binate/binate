package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the call of a function by its name (genNamedCall, gen_call_named.bn).

// genNamedCall recognizes the compiler-internal magic names `_call_dtor` /
// `rt._call_dtor` / `_call_free_fn` / `rt._call_free_fn` and lowers
// them to OP_CALL_INDIRECT — Args[0] becomes the function pointer,
// the rest become call args. RefDec (`pkg/builtins/rt/rt.bn`) and Free use
// these to dispatch through a function pointer stored in the
// managed-allocation header without introducing a real callable
// symbol. A regression here would silently turn the indirect call
// into a direct call to a missing symbol (there is no real dtor
// trampoline to call).
func TestGenCallDtorLowersToCallHandle() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func _call_dtor(dtor *uint8, ptr *uint8) { }\n")
	cb.Write("func main() {\n")
	cb.Write("  var d *uint8 = nil\n")
	cb.Write("  var p *uint8 = nil\n")
	cb.Write("  _call_dtor(d, p)\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var mainFunc @ir.Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	var foundCallInd bool = false
	var foundDirectCall bool = false
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @ir.Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CALL_HANDLE { foundCallInd = true }
			if instr.Op == iropcode.OP_CALL && seq(instr.StrVal, "_call_dtor") {
				foundDirectCall = true
			}
		}
	}
	if !foundCallInd {
		return fail("_call_dtor(...) must lower to iropcode.OP_CALL_HANDLE")
	}
	if foundDirectCall {
		return fail("_call_dtor(...) must NOT lower to iropcode.OP_CALL — that's the bug shape")
	}
	return ""
}

// _call_free_fn dispatches through a function-value HANDLE: Args[0] is a *uint8 pointing
// at a 16-byte {vtable, data} block (the result of _func_handle).  Same
// shape as _call_dtor above; both
// lower to OP_CALL_HANDLE.  _call_shim_scalar / _call_shim_aggregate
// stay on OP_CALL_INDIRECT (raw shim+data shape).
func TestGenCallFreeFnLowersToCallHandle() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func _call_free_fn(freeFn *uint8, ptr *uint8) { }\n")
	cb.Write("func main() {\n")
	cb.Write("  var f *uint8 = nil\n")
	cb.Write("  var p *uint8 = nil\n")
	cb.Write("  _call_free_fn(f, p)\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var mainFunc @ir.Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	var foundCallHandle bool = false
	var foundDirectCall bool = false
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @ir.Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CALL_HANDLE { foundCallHandle = true }
			if instr.Op == iropcode.OP_CALL && seq(instr.StrVal, "_call_free_fn") {
				foundDirectCall = true
			}
		}
	}
	if !foundCallHandle {
		return fail("_call_free_fn(...) must lower to iropcode.OP_CALL_HANDLE")
	}
	if foundDirectCall {
		return fail("_call_free_fn(...) must NOT lower to iropcode.OP_CALL — that's the bug shape")
	}
	return ""
}

// A generic function's instantiation, called, is a direct call of its instance
// by the instance's name (genCallInstantiate).
func TestGenericInstanceCallNamesInstance() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nfunc id[T any](x T) T { return x }\n"
			"func main() {\n\tvar y int = id[int](3)\n\t_ = y\n}\n")
	var inst @ir.Func = nil
	var mainFunc @ir.Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if containsSub(m.Funcs[i].Name, "id__bn_inst") { inst = m.Funcs[i] }
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if inst == nil || mainFunc == nil { return fail("main and id[int]'s instance must be emitted") }
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @ir.Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CALL && seq(instr.StrVal, inst.Name) { return "" }
		}
	}
	return fail(buf.Concat("main must call the instance ", inst.Name))
}
