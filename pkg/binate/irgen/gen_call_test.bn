package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for genCall — the call dispatch and lowering logic in
// gen_call.bn. Function-value-call coverage lives in
// gen_func_value_test.bn; method-call coverage in gen_method_test.bn.

func TestNilFuncValueArgCoercion() testing.TestResult {
	// Passing nil to a function expecting a function-value parameter
	// should produce a nil instruction with the parameter's type (not
	// TYP_NIL), so codegen emits the two-word value's zeroinitializer
	// instead of i8* null.
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func take(f *func(int) int, n int) int {")
	cb.Write(" return n }\n")
	cb.Write("func main() { take(nil, 42) }\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 2 {
		return fail(buf.Concat(
				"expected 2 funcs, got ", strconv.Itoa(len(m.Funcs))))
	}
	// Find main function
	var mainFunc @ir.Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	// Find the OP_CALL instruction to "take" in main
	var callInstr @ir.Instr = nil
	for i := 0; i < len(mainFunc.Blocks); i++ {
		var blk @ir.Block = mainFunc.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_CALL && seq(instr.StrVal, "test.take") {
				callInstr = instr
			}
		}
	}
	if callInstr == nil { return fail("no call to take()") }
	// First arg should be nil with the function-value type, not TYP_NIL
	if len(callInstr.Args) < 2 {
		return fail(buf.Concat(
				"expected 2 args, got ", strconv.Itoa(len(callInstr.Args))))
	}
	var nilArg @ir.Instr = callInstr.Args[0]
	if nilArg.Op != iropcode.OP_CONST_NIL { return fail("first arg should be iropcode.OP_CONST_NIL") }
	if nilArg.Typ == nil { return fail("nil arg type is nil") }
	if nilArg.Typ.Kind == types.TYP_NIL {
		return fail("nil arg should have the function-value type, not TYP_NIL")
	}
	if nilArg.Typ.Kind != types.TYP_FUNC_VALUE {
		return fail(
				buf.Concat(
						"nil arg should be TYP_FUNC_VALUE, got kind ", strconv.Itoa(nilArg.Typ.Kind)))
	}
	return ""
}

// A PLAIN (no-managed-field) struct composite passed BY VALUE must be LOADED to a
// value before the call — a coerceArg that loads only inside the needsStructCopy
// branch passes a plain composite's alloca POINTER, and the callee reads pointer
// bits as the fields (garbage on LLVM + native; VM tolerant).
// hasStructLoad / funcByName live in sibling _test.bn files (same package).
func TestPlainCompositeByValueArgLoadsValue() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type Pt struct {\n\ta int\n\tb int\n}\n"
					"func use(p Pt) int { return p.a }\n"
					"func caller() int { return use(Pt{a: 3, b: 4}) }\n")
	var fn @ir.Func = funcByName(m, "caller")
	if fn == nil { return fail("caller not found in module") }
	if !hasStructLoad(fn) {
		return fail("plain composite passed by value must load the struct value, not the alloca pointer")
	}
	return ""
}
