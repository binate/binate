package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_cast_value.bn: the value-conversion lowering shared by `cast`
// and `unsafe_cast`, and the scratch-slot lowering of an aggregate bit_cast.

// castTestBlock returns a fresh function's entry block.
func castTestBlock() (@ir.Func, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	return f, ir.AddBlock(f, "entry")
}

// An integer width conversion is a plain OP_CAST at the target type.
func TestCastValueIntWidenIsCast() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = castTestBlock()
	_ = f
	var v @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 5), types.TypInt32())
	var r @ir.Instr = genCastValueConversion(b, v, types.TypInt64())
	if r.Op != iropcode.OP_CAST || r.Typ != types.TypInt64() {
		return fail("int32 -> int64 must lower to one OP_CAST at int64")
	}
	return ""
}

// A managed-slice to raw-slice cast is the {data, len} extraction the implicit
// decay uses, not a relabelling cast.
func TestCastValueManagedToRawSliceIsExtraction() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = castTestBlock()
	var ms @ir.Instr = irbuild.NewParamRef(f,
			irbuild.NewParam(f, "s", types.MakeManagedSliceType(types.TypInt())))
	var r @ir.Instr = genCastValueConversion(b, ms, types.MakeSliceType(types.TypInt()))
	if r.Op != iropcode.OP_MANAGED_TO_RAW {
		return fail("cast(*[]int, @[]int) must lower to OP_MANAGED_TO_RAW")
	}
	return ""
}

// An aggregate bit_cast round-trips through a stack slot: allocate, store the
// source bytes, reload them at the target type.
func TestBitCastViaMemoryRoundTripsASlot() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = castTestBlock()
	var ms @ir.Instr = irbuild.NewParamRef(f,
			irbuild.NewParam(f, "s", types.MakeManagedSliceType(types.TypInt())))
	var dst @types.Type = types.MakeManagedSliceType(types.TypUint())
	var r @ir.Instr = emitBitCastViaMemory(b, ms, ms.Typ, dst)
	if r.Op != iropcode.OP_LOAD || r.Typ != dst {
		return fail("the bit_cast result must be a load at the target type")
	}
	if firstOp(f, iropcode.OP_ALLOC) == nil || firstOp(f, iropcode.OP_STORE) == nil {
		return fail("the bit_cast must store the source into an allocated slot")
	}
	return ""
}
