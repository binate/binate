package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/irdata"
import "pkg/binate/irutil"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Checker type → IR-gen type
// ============================================================
//
// IR-gen types a value from the syntax that produces it (resolveTypeExpr, or the
// type of the generated instruction).  Where it must type a value WITHOUT
// generating it first — an inferred package-level variable, a deferred method
// call's receiver (built by a pre-pass at function entry, before any local is
// declared) — it has only the checker's type, which names types differently:
//   - an instantiation of a generic struct / interface is the checker's
//     `pkg.Box[int]` (carrying InstDecl / InstArgs), where IR-gen registers the
//     instantiated struct under a mangled name (ensureInstantiatedStruct);
//   - a named type is the checker's (Pkg, Name), where IR-gen's registered
//     struct / type-declaration entry is keyed on the qualified name;
//   - inside a generic body a type parameter is abstract to the checker, where
//     IR-gen substitutes the instantiation's argument (bound by owner and
//     position, CurrentTypeParamOwner / CurrentTypeParamArgs).

// irTypeFromChecker returns IR-gen's representation of the checker's type t —
// the type resolveTypeExpr gives the same type written in source — or nil when
// t reaches a type IR-gen has no representation for.  An untyped constant type
// maps to its default type, as the checker's defaultType does.
func irTypeFromChecker(gc @GenCtx, t @types.Type) @types.Type {
	if t == nil { return nil }
	var k int = t.Kind
	if k == types.TYP_INT || k == types.TYP_FLOAT || k == types.TYP_BOOL || k == types.TYP_VOID {
		return t
	}
	if k == types.TYP_UNTYPED_INT { return types.TypInt() }
	if k == types.TYP_UNTYPED_FLOAT { return types.TypFloat64() }
	if k == types.TYP_UNTYPED_BOOL { return types.TypBool() }
	if k == types.TYP_UNTYPED_STRING {
		return types.MakeManagedSliceType(types.MakeReadonlyType(types.TypUint8()))
	}
	if k == types.TYP_TYPE_PARAM {
		// Bound by the checker's identity for a type parameter — its owning
		// declaration and position — not by name: the checker's types in a
		// generic body carry the binder names of whichever declaration was
		// checked first (`Pair[V, K]` beside `Pair[K, V]`, a blank `_`), as
		// bindTypeParams notes.
		if gc.CurrentTypeParamOwner != nil && t.TpOwner == gc.CurrentTypeParamOwner && t.TpIndex >= 0 &&
				t.TpIndex < len(gc.CurrentTypeParamArgs) {
			return gc.CurrentTypeParamArgs[t.TpIndex]
		}
		return nil
	}
	if t.InstDecl != nil && (k == types.TYP_NAMED || k == types.TYP_INTERFACE) {
		return irInstantiationFromChecker(gc, t)
	}
	if k == types.TYP_NAMED {
		return irNamedFromChecker(gc, t)
	}
	if k == types.TYP_ALIAS { return irTypeFromChecker(gc, t.Target) }
	if k == types.TYP_INTERFACE {
		return types.MakeInterfaceType(buf.CopyStr(unquotePkg(t.Pkg)), buf.CopyStr(t.Name))
	}
	if k == types.TYP_STRUCT {
		return irStructFromChecker(gc, t)
	}
	if k == types.TYP_FUNC || k == types.TYP_FUNC_VALUE || k == types.TYP_MANAGED_FUNC_VALUE {
		return irFuncFromChecker(gc, t)
	}
	if k == types.TYP_TUPLE {
		var rs @[]@types.Type
		var ok bool
		rs, ok = irTypesFromChecker(gc, t.Results)
		if !ok { return nil }
		return types.MakeTupleType(rs)
	}
	if k == types.TYP_ARRAY && t.ArrayLenDependent { return nil }
	var elem @types.Type = irTypeFromChecker(gc, t.Elem)
	if elem == nil { return nil }
	if k == types.TYP_READONLY { return types.MakeReadonlyType(elem) }
	if k == types.TYP_POINTER { return types.MakePointerType(elem) }
	if k == types.TYP_MANAGED_PTR { return types.MakeManagedPtrType(elem) }
	if k == types.TYP_SLICE { return types.MakeSliceType(elem) }
	if k == types.TYP_MANAGED_SLICE { return types.MakeManagedSliceType(elem) }
	if k == types.TYP_ARRAY { return types.MakeArrayType(elem, t.ArrayLen) }
	if k == types.TYP_INTERFACE_VALUE { return types.MakeInterfaceValueType(elem) }
	if k == types.TYP_INTERFACE_VALUE_MANAGED {
		return types.MakeManagedInterfaceValueType(elem)
	}
	return nil
}

// irTypesFromChecker maps each of ts (irTypeFromChecker); false when any maps
// to nil.
func irTypesFromChecker(gc @GenCtx, ts @[]@types.Type) (@[]@types.Type, bool) {
	var out @[]@types.Type = make_slice(@types.Type, len(ts))
	for i := 0; i < len(ts); i++ {
		out[i] = irTypeFromChecker(gc, ts[i])
		if out[i] == nil { return out, false }
	}
	return out, true
}

// irInstantiationFromChecker instantiates, in IR-gen, the generic struct or
// interface a checker instantiation t names: the generic declaration IR-gen
// registered under the declaring package, with t's type arguments mapped.
func irInstantiationFromChecker(gc @GenCtx, t @types.Type) @types.Type {
	if gc.Mod == nil || gc.Mod.Checker == nil { return nil }
	var d @ast.Decl = bit_cast(@ast.Decl, t.InstDecl)
	var defPkg @[]char = buf.CopyStr(unquotePkg(gc.Mod.Checker.GenericDeclPkg(d)))
	var args @[]@types.Type
	var ok bool
	args, ok = irTypesFromChecker(gc, t.InstArgs)
	if !ok { return nil }
	if gc.NamingInstances {
		return irInstantiationName(gc, d, t.Kind == types.TYP_INTERFACE, defPkg, args)
	}
	if t.Kind == types.TYP_INTERFACE {
		var gi @ast.Decl = lookupGenericIfaceDeclPkg(gc, defPkg, d.Name)
		if gi == nil { return nil }
		var instName @[]char = ensureInstantiatedInterface(gc, gi, args, defPkg)
		return types.MakeInterfaceType(defPkg, instName)
	}
	var gd @ast.Decl = lookupGenericTypeDeclPkg(gc, defPkg, d.Name)
	if gd == nil { return nil }
	return ensureInstantiatedStruct(gc, gd, defPkg, args)
}

// irInstantiationName returns a placeholder for the instance of the generic
// struct or interface d (isIface) with IR-gen type arguments args that carries
// only the name the instance is registered under, so it mangles as the
// instance does without instantiating it (GenCtx.NamingInstances).
func irInstantiationName(gc @GenCtx, d @ast.Decl, isIface bool, defPkg @[]char,
		args @[]@types.Type) @types.Type {
	args, _ = canonicalTypeArgs(gc, args)
	var name @[]char = instantiationMangledName(gc, d, defPkg, args)
	if isIface {
		return types.MakeInterfaceType(defPkg, stripCurrentModuleQualifier(name))
	}
	var noFields @[]@types.Field
	return types.MakeStructType(name, noFields)
}

// irNamedFromChecker returns IR-gen's registered type for the checker's named
// type t: the struct, or the type-declaration entry (registerTypeDeclEntry) of a
// named non-struct type, under t's qualified name.
func irNamedFromChecker(gc @GenCtx, t @types.Type) @types.Type {
	if gc.Mod == nil { return nil }
	var qual @[]char = types.QualifyName(buf.CopyStr(unquotePkg(t.Pkg)), t.Name)
	if gc.NamingInstances {
		// A named type mangles by its qualified name alone (irutil.MangleTypeArg).
		var noFields @[]@types.Field
		return types.MakeStructType(qual, noFields)
	}
	var si int = lookupStructIdx(gc, qual)
	if si >= 0 { return gc.Mod.Structs[si].Typ }
	return lookupTypeAlias(gc, qual)
}

// irStructFromChecker maps a checker struct type: a named struct's (its Name is
// qualified) is the registered struct; an anonymous one's fields are mapped and
// the struct interned as resolveTypeExpr interns a written `struct { … }`.
// While naming instances (GenCtx.NamingInstances) neither is looked up or
// interned: the result only has to mangle as the struct does.
func irStructFromChecker(gc @GenCtx, t @types.Type) @types.Type {
	if len(t.Name) > 0 {
		if gc.Mod == nil { return nil }
		if gc.NamingInstances {
			// A named struct mangles by its qualified name alone.
			var none @[]@types.Field
			return types.MakeStructType(t.Name, none)
		}
		var si int = lookupStructIdx(gc, t.Name)
		if si < 0 { return nil }
		return gc.Mod.Structs[si].Typ
	}
	var fields @[]@types.Field = make_slice(@types.Field, len(t.Fields))
	for i := 0; i < len(t.Fields); i++ {
		var f @types.Field = make(types.Field)
		f.Name = t.Fields[i].Name
		f.Type = irTypeFromChecker(gc, t.Fields[i].Type)
		if f.Type == nil { return nil }
		fields[i] = f
	}
	if gc.NamingInstances {
		// An anonymous struct mangles by its fields (irutil.MangleTypeArg keys on
		// the `__anon_` prefix); naming it must not intern it, since its fields
		// may be placeholders that would stand in for the real struct's.
		return types.MakeStructType("__anon_", fields)
	}
	return internAnonStruct(gc, fields)
}

// irFuncFromChecker maps a function or function-value type's parameter and
// result types, keeping each parameter's name and variadic-ness.
func irFuncFromChecker(gc @GenCtx, t @types.Type) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, len(t.Params))
	for i := 0; i < len(t.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = t.Params[i].Name
		p.IsVariadic = t.Params[i].IsVariadic
		p.Type = irTypeFromChecker(gc, t.Params[i].Type)
		if p.Type == nil { return nil }
		params[i] = p
	}
	var results @[]@types.Type
	var ok bool
	results, ok = irTypesFromChecker(gc, t.Results)
	if !ok { return nil }
	if t.Kind == types.TYP_FUNC { return types.MakeFuncType(params, results) }
	if t.Kind == types.TYP_FUNC_VALUE { return types.MakeFuncValueType(params, results) }
	return types.MakeManagedFuncValueType(params, results)
}

// unquotePkg strips one pair of surrounding double quotes, if present: the
// checker spells some package paths quoted (`"main"`), IR-gen never does.
func unquotePkg(p *[]readonly char) *[]readonly char {
	if len(p) >= 2 && p[0] == '"' && p[len(p) - 1] == '"' { return p[1:len(p) - 1] }
	return p
}

// ensureMethodSig returns the FuncSig of the method qualName (found false when
// there is none).  When this module has none — a method of a type from a package
// the module does not import directly, reached through another package's
// result, which RegisterImports does not declare — it registers one built from
// the checker's signature m (receiver first), with an extern declaration, so a
// call, a deferred call or a method value binds its receiver and arguments as
// the method declares them.
func ensureMethodSig(ctx @GenContext, qualName @[]char, m @types.Method) (irdata.FuncSig, bool) {
	var sig irdata.FuncSig
	var found bool
	sig, found = lookupFuncSig(ctx.Gc, qualName)
	if found || m == nil || m.FuncType == nil { return sig, found }
	var ft @types.Type = irTypeFromChecker(ctx.Gc, m.FuncType)
	if ft == nil || ft.Kind != types.TYP_FUNC { return sig, false }
	var params @[]@types.Type
	var extParams @[]@ir.Param
	for i := 0; i < len(ft.Params); i++ {
		params = slices.Append[@types.Type](params, ft.Params[i].Type)
		var p @ir.Param = make(ir.Param)
		p.Typ = ft.Params[i].Type
		extParams = slices.Append[@ir.Param](extParams, p)
	}
	sig.Name = qualName
	sig.Params = params
	sig.Results = ft.Results
	sig.IsVariadic = types.FuncIsVariadic(ft)
	if len(ft.Results) > 1 {
		sig.MultiReturnType = irutil.MakeMultiReturnStructType(ft.Results)
	}
	setOrAppendFuncSig(ctx.Gc, sig)
	ctx.Gc.Mod.AddFunc(irbuild.NewExternFunc(make_slice(char, 0), qualName, extParams, ft.Results))
	return sig, true
}

// methodRecvCheckerType returns the receiver's base type for a method selector,
// looking through an explicit deref `(*p).m()` to the pointee (mirrors
// genMethodCall's recvBaseTypeName derivation).  It keeps the receiver's NAMED
// identity, stripping only alias / readonly wrappers (as the IR value type a
// direct method call names its receiver from does): a method is declared on the
// named type — `type Money int`, `type NP Pt`, `type PS *S` — so the full peel
// deferCalleeType does would look up `int.Show` / `Pt.Show` / `S.get` instead.
func methodRecvCheckerType(ctx @GenContext, sel @ast.Expr) @types.Type {
	if sel.X == nil || ctx.Checker == nil || sel.X.ResolvedTypeID == 0 { return nil }
	var t @types.Type = ir.StripConstForIR(ctx.Checker.ExprType(sel.X.ResolvedTypeID))
	if sel.X.Kind == ast.EXPR_UNARY && sel.X.Op == cast(int, token.STAR) {
		var pt @types.Type = types.StripWrappers(t)
		if pt != nil && (pt.Kind == types.TYP_POINTER || pt.Kind == types.TYP_MANAGED_PTR) &&
				pt.Elem != nil {
			return pt.Elem
		}
	}
	return t
}

// selectorMethod returns the checker's method for the method selector sel, whose
// receiver's type IR-gen names recvName, or nil when the checker has none.  In an
// instantiated generic body the checker types a receiver of a type parameter's
// type abstractly; its method is the type argument's, found by the name IR-gen
// gives the argument (`pkg/b.Thing`).
func selectorMethod(ctx @GenContext, sel @ast.Expr, recvName *[]readonly char) @types.Method {
	var base @types.Type = methodRecvCheckerType(ctx, sel)
	if base != nil { base = base.ReceiverBaseNamed() }
	if base == nil && ctx.Checker != nil {
		var pkg @[]char
		var name @[]char
		pkg, name = irutil.SplitQualName(recvName)
		if len(pkg) > 0 { base = ctx.Checker.PackageType(pkg, name) }
		if base != nil { base = base.ReceiverBaseNamed() }
	}
	if base == nil { return nil }
	return base.LookupMethod(sel.Name)
}
