package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/builtins/testing"

// Tests for irTypeFromChecker (checker type → IR-gen type).

// globalVarType returns the registered type of module global `name`, or nil.
func globalVarType(m @ir.Module, name *[]readonly char) @types.Type {
	for i := 0; i < len(m.GlobalVars); i++ {
		if irutil.Streq(m.GlobalVars[i].Name, name) { return m.GlobalVars[i].Typ }
	}
	return nil
}

// An inferred package-level variable gets exactly the type its explicitly typed
// twin does: a named struct, a generic instantiation (also behind a managed
// pointer, in an array, as a func-value parameter), a named non-struct type, an
// interface value, a pointer to a named struct, a raw slice of readonly
// elements (compared with readonly significant).
func TestIrTypeFromCheckerMatchesExplicitGlobals() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"main\"\n"
					"type P struct { x int }\n"
					"type Money int\n"
					"type Box[T any] struct { v T }\n"
					"interface Shape { Area() int }\n"
					"func mk() @Box[int] { return make(Box[int]) }\n"
					"func mkp() @P { return make(P) }\n"
					"func arr() [2]Box[int32] { var a [2]Box[int32]; return a }\n"
					"func use(b @Box[int]) int { return b.v }\n"
					"var m Money = 3\n"
					"var s *Shape\n"
					"var a = P{x: 1}\nvar a2 P\n"
					"var b = mk()\nvar b2 @Box[int]\n"
					"var c = m\nvar c2 Money\n"
					"var d = s\nvar d2 *Shape\n"
					"var e = mkp()\nvar e2 @P\n"
					"var f = &a\nvar f2 *P\n"
					"var g = arr()\nvar g2 [2]Box[int32]\n"
					"var h = use\nvar h2 @func(@Box[int]) int\n"
					"var cs *[]readonly char = \"hey\"\n"
					"var i = cs\nvar i2 *[]readonly char\n"
					"func main() {}\n")
	var names @[]@[]char = @[]@[]char{"a", "b", "c", "d", "e", "f", "g", "h", "i"}
	for i := 0; i < len(names); i++ {
		var inferred @types.Type = globalVarType(m, names[i])
		var twin @[]char = concatChars(names[i], "2")
		var explicit @types.Type = globalVarType(m, twin)
		if inferred == nil || explicit == nil {
			return fail(concatChars("global not typed: ", names[i]))
		}
		if !inferred.IdenticalStrict(explicit) {
			return fail(concatChars("inferred type differs from the explicit twin's: ", names[i]))
		}
	}
	return ""
}

// An untyped constant type maps to its default type; an interface's quoted
// package spelling is unquoted.
func TestIrTypeFromCheckerUntypedIface() testing.TestResult {
	var gc @GenCtx = NewGenCtx(nil)
	var ut @types.Type = make(types.Type)
	ut.Kind = types.TYP_UNTYPED_INT
	if !irTypeFromChecker(gc, ut).Identical(types.TypInt()) { return fail("untyped int maps to int") }
	var it @types.Type = irTypeFromChecker(gc,
			types.MakeInterfaceValueType(types.MakeInterfaceType("\"main\"", "Shape")))
	if it == nil || it.Elem == nil || !irutil.Streq(it.Elem.Pkg, "main") {
		return fail("an interface's quoted package maps unquoted")
	}
	return ""
}

// declaredTypeName takes the checker's name for the type a declaration declares,
// not the name written: a declaration given another declaration's record takes
// that type's name -- a struct's (whose checker name is qualified), a named
// type's, an interface's.  An interface alias (whose record is its target), a
// blank declaration and one with no record keep their written names.
func TestDeclaredTypeNameIsTheCheckersName() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"test\"\nfunc main() {}\n")
	var recorded @[]@ast.Decl = @[]@ast.Decl{
			checkedReplDecl(c, "type U struct { a int }"), checkedReplDecl(c, "type N int"),
			checkedReplDecl(c, "interface I { M() int }")}
	var want @[]*[]readonly char = @[]*[]readonly char{"U", "N", "I"}
	for i := 0; i < len(recorded); i++ {
		var d @ast.Decl = replDecl("type T struct { b int }")
		d.ResolvedTypeID = recorded[i].ResolvedTypeID
		if !seq(declaredTypeName(gc, d), want[i]) {
			return fail(buf.Concat("a declaration recorded as declaring ", want[i]))
		}
	}
	var alias @ast.Decl = checkedReplDecl(c, "interface J = I")
	if alias.ResolvedTypeID == 0 || !seq(declaredTypeName(gc, alias), "J") {
		return fail("an interface alias keeps its written name")
	}
	var blankDecl @ast.Decl = checkedReplDecl(c, "type _ struct { z int }")
	if !seq(declaredTypeName(gc, blankDecl), "_") { return fail("a blank declaration keeps `_`") }
	if !seq(declaredTypeName(gc, replDecl("type V int")), "V") {
		return fail("a declaration with no record keeps its written name")
	}
	return ""
}

// A struct typed at the prompt is registered, filled and given its helpers under
// the checker's name for it: here T's declaration carries U's record, so U is
// registered -- with T's fields and a destructor of its own -- and no T is.
func TestGenTypeDeclsRegistersUnderTheCheckersName() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"test\"\nfunc main() {}\n")
	var u @ast.Decl = checkedReplDecl(c, "type U struct { s @[]char }")
	var d @ast.Decl = replDecl("type T struct { s @[]char; n int }")
	d.ResolvedTypeID = u.ResolvedTypeID
	if len(GenTypeDecls(@[]@ast.Decl{d}, gc)) > 0 { return fail("GenTypeDecls failed") }
	var ui int = lookupStructIdx(gc, "U")
	if ui < 0 || lookupStructIdx(gc, "T") >= 0 {
		return fail("the struct must be registered as U, not T")
	}
	if len(gc.Mod.Structs[ui].Typ.Fields) != 2 {
		return fail("U must be filled with the declaration's fields")
	}
	if helperCount(gc.Mod, "__dtor_1U") != 1 { return fail("U must get its destructor") }
	return ""
}
