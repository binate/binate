package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Closure sites generated more than once.  A function literal or a method value
// is one closure site (func.closure.allocation): one lifted function and, for a
// capturing raw `*func` closure, one frame record per call, re-filled at each
// evaluation.  A deferred block is generated at each exit of its block
// (gen_defer.bn), so a site in it is generated once per exit edge; the copies
// must share the lifted function and the record — two records would let a
// function value made by one copy keep captures another copy's evaluation was
// meant to replace.

// ClosureSite records a closure site this function has generated: Expr is the
// site, Lifted the function literal's lifted function (nil for a method value),
// and Record its frame closure record (nil until one is allocated, and for a
// non-capturing or managed `@func` closure).
type ClosureSite struct {
	Expr   @ast.Expr
	Lifted @ir.Func
	Record @ir.Instr
}

// findClosureSite returns the index of e's entry in ctx.ClosureSites, or -1.
func findClosureSite(ctx @GenContext, e @ast.Expr) int {
	for i := 0; i < len(ctx.ClosureSites); i++ {
		if same(ctx.ClosureSites[i].Expr, e) { return i }
	}
	return -1
}

// addClosureSite records e as generated, with its lifted function, and returns
// its index in ctx.ClosureSites.
func addClosureSite(ctx @GenContext, e @ast.Expr, lifted @ir.Func) int {
	var s ClosureSite
	s.Expr = e
	s.Lifted = lifted
	ctx.ClosureSites = slices.Append[ClosureSite](ctx.ClosureSites, s)
	return len(ctx.ClosureSites) - 1
}
