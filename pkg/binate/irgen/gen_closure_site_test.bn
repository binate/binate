package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for gen_closure_site.bn.  fail is a shared test helper; the sharing of a
// site generated twice is covered by gen_defer_test.bn.

// A recorded site is found by identity; another expression is not.
func TestClosureSiteLookup() testing.TestResult {
	var ctx @GenContext = make(GenContext)
	var e1 @ast.Expr = make(ast.Expr)
	var e2 @ast.Expr = make(ast.Expr)
	if findClosureSite(ctx, e1) != -1 { return fail("no site should be recorded yet") }
	var noLifted @ir.Func = nil
	var i int = addClosureSite(ctx, e1, noLifted)
	if findClosureSite(ctx, e1) != i { return fail("the recorded site should be found") }
	if findClosureSite(ctx, e2) != -1 { return fail("another expression is not the recorded site") }
	return ""
}
