package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/types"

// IR generation for composite literals — `T{...}`.  genCompositeLit handles
// the struct form (positional or keyed fields) and dispatches the array /
// raw-slice / managed-slice forms to genArrayLit (below) / genRawSliceLit /
// genManagedSliceLit (gen_slice_lit.bn).

// genCompositeLit generates IR for a composite literal (struct or array).
//
// Dispatch is on the PEELED underlying kind, not on `e.TypeRef.Kind`, so a
// named-distinct wrapper (`type Row [3]int; Row{...}`, `type NS S; NS{...}`,
// `type Buf @[]int; Buf{...}`) lowers through the SAME path as its unnamed
// form.  Keying off the syntactic TypeRef kind instead would route every
// named wrapper (whose TypeRef is TEXPR_NAMED) to the struct branch, where
// lookupStructIdx misses the non-struct wrapper and the literal silently
// drops to a constant 0 — a wrong-code bug for every named array / slice /
// struct literal.  The element type / length / field layout / refcount must
// likewise come from the peeled type, never the wrapper.
func genCompositeLit(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	if e.TypeRef == nil {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	var typ @types.Type = types.StripWrappers(resolveTypeExpr(ctx.Gc, e.TypeRef))
	if typ == nil {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	// Array composite literal: [N]T{...} (incl. named-distinct `type R [N]T`).
	if typ.Kind == types.TYP_ARRAY {
		return genArrayLit(ctx, b, e, typ)
	}

	// Managed-slice composite literal: @[]T{...} (incl. `type Buf @[]T`).
	if typ.Kind == types.TYP_MANAGED_SLICE {
		return genManagedSliceLit(ctx, b, e, typ)
	}

	// Raw-slice composite literal: *[]readonly T{...} (incl. `type S *[]T`).
	if typ.Kind == types.TYP_SLICE {
		return genRawSliceLit(ctx, b, e, typ)
	}

	if typ.Kind != types.TYP_STRUCT {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	// The literal's storage (literalStorage): its alloca is registered as an
	// end-of-statement cleanup temp BEFORE the field loop, not after.  Two
	// reasons: (1) a fresh managed-field struct literal
	// is neither a named local nor a call-result temp, so nothing else RefDecs its
	// managed fields to balance the copy every consumer (return / by-value arg /
	// field-init / method receiver / assignment) takes — a leak per occurrence
	// (emitTempCleanupBody's OP_ALLOC arm dtors it, mirroring
	// registerManagedCallResult).  (2) Registering it here means a RECOVERABLE VM
	// fault WHILE a LATER field is being evaluated dispatches a pad that covers the
	// partial aggregate: each managed field is MOVED in as the loop goes
	// (emitStoreManagedSlot isInit -> consumeTemp, leaving ctx.Temps), so a fault
	// after some fields are moved would otherwise leak them.  The dtor RefDecs every
	// managed field; the not-yet-filled ones are null (pushFrame zero-fills the
	// frame), so RefDec(null) no-ops.  A consumer that instead REUSES the alloca as
	// durable storage (the var-init fast paths in genShortVar / genDecl)
	// consumeTemp's it, transferring ownership to the var.  A literal a defer's
	// operands address is built in its entry-depth defer slot instead.
	var structPtr @ir.Instr = literalStorage(ctx, b, e, typ)

	// Initialize all fields: from keyed or positional elements, or zero.
	// Fields come from the peeled struct type (the underlying struct's
	// layout), so a named wrapper `type NS S` finds S's fields, not the
	// wrapper's (which has none).
	var fields @[]@types.Field = typ.Fields
	var isKeyed bool = len(e.Elems) > 0 && e.Elems[0].Key != nil
	for i := 0; i < len(fields); i++ {
		var fieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, structPtr, i, fields[i].Type)
		var val @ir.Instr = nil
		if isKeyed {
			// Keyed: find element by field name
			for j := 0; j < len(e.Elems); j++ {
				if e.Elems[j].Key != nil && irutil.Streq(e.Elems[j].Key.Name, fields[i].Name) {
					val = genExprOrFuncRef(ctx, b, e.Elems[j].Value, fields[i].Type)
					b = ctx.CurBlock
				}
			}
		} else {
			// Positional: use element at index i if available
			if i < len(e.Elems) {
				val = genExprOrFuncRef(ctx, b, e.Elems[i].Value, fields[i].Type)
				b = ctx.CurBlock
			}
		}
		if val == nil {
			val = emitZeroValue(b, fields[i].Type)
		}
		// String literal assigned to a char-slice or char-array field: the
		// slice header or the array value, never the bare OP_CONST_STRING
		// pointer — for a managed-slice field the arm below would extract a
		// refptr from a bare i8*, so the RefInc and the store both go wrong.
		var ft @types.Type = fields[i].Type
		val = materializeStringLit(ctx, b, val, ft)
		// @[]T → *[]T conversion for raw slice field
		// (the temp stays in cleanup — RefDec at end of statement)
		val = decayManagedToRaw(b, val, ft)
		// If the value is an aggregate alloca (from a nested composite lit —
		// struct OR array), load the VALUE first; otherwise the alloca POINTER
		// lands in the field slot instead of the aggregate value.
		if isAggregateAllocToLoad(val, ft) {
			val = irbuild.EmitLoad(b, val, val.TypeArg)
		}
		// Narrow an untyped scalar LITERAL field value to the field's
		// width (e.g. an untyped-float 0.5 into a float32 field fptruncs
		// to single precision).  No-op for managed / struct / nil values.
		val = coerceScalarWidth(ctx, b, val, fields[i].Type)
		// Acquire-and-store through the shared dispatcher.  isInit: a fresh
		// field slot, no old value to release.  A fresh producer — including
		// an OP_CONST_NIL zero-init — is moved (consumeTemp), so no RefInc /
		// OP_EXTRACT runs on a nil constant (which the bytecode VM mis-lowers).
		b = emitStoreManagedSlot(ctx, b, fieldPtr, val, fields[i].Type, true)
	}
	return structPtr
}

// emitZeroValue emits the zero value of typ (spec decl.var.zero-init), for an
// omitted composite-literal field: false / 0.0 / 0 for a bool / float / integer,
// and the all-zero nil for everything else — pointers, slices, function and
// interface values, structs and arrays.  It decides on the peeled
// representation type, so a named or readonly wrapper gets its underlying's
// zero; an integer constant stored into any of the non-integer shapes is
// invalid IR (`add %BnSlice 0, 0`) on LLVM and native.
func emitZeroValue(b @ir.Block, typ @types.Type) @ir.Instr {
	var t @types.Type = types.StripWrappers(typ)
	if t != nil && (t.Kind == types.TYP_BOOL || t.Kind == types.TYP_UNTYPED_BOOL) {
		return irbuild.EmitConstBool(b, false)
	}
	if t != nil && (t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT) {
		return irbuild.EmitConstFloat(b, "0", typ)
	}
	if t != nil && (t.Kind == types.TYP_INT || t.Kind == types.TYP_UNTYPED_INT) {
		return irbuild.EmitConstInt(b, 0, typ)
	}
	return irbuild.EmitConstNil(b, typ)
}

// ============================================================
// Array literal
// ============================================================

// coerceCompositeElement applies the element coercions shared by every
// composite-element store — an array-literal element (genArrayLit), a raw- or
// managed-slice-literal element (genRawSliceLit / genManagedSliceLit) and a
// variadic-pack element (emitVariadicTail) — so the callers cannot drift and a
// future coercion applies to all of them:
//  1. narrow an untyped scalar literal to the element width (an 8-byte store into
//     a 4-byte slot otherwise corrupts memory);
//  2. give a string-literal element its char-slice header or char-array value,
//     not the bare OP_CONST_STRING data pointer (else a slice's len reads back
//     0 and an array holds the pointer's bytes);
//  3. load a struct/array composite-literal element's value — it returns its
//     alloca POINTER, which must not be stored into the aggregate-sized slot;
//  4. decay a managed-slice value stored into a raw-slice element to its
//     {data, len} view (a 4-word header in a 2-word slot overruns the backing).
// Returns the coerced value; none of the coercions split the block, so the
// caller's `b` stays current.
func coerceCompositeElement(ctx @GenContext, b @ir.Block, val @ir.Instr,
		elemTyp @types.Type) @ir.Instr {
	val = coerceScalarWidth(ctx, b, val, elemTyp)
	val = materializeStringLit(ctx, b, val, elemTyp)
	if isAggregateAllocToLoad(val, elemTyp) {
		val = irbuild.EmitLoad(b, val, val.TypeArg)
	}
	return decayManagedToRaw(b, val, elemTyp)
}

// genArrayLit generates IR for an array literal expression, allocating and
// storing each element.  `arrTyp` is the PEELED array type (a named-distinct
// `type R [N]T` wrapper has been peeled to its underlying [N]T by the caller),
// so the alloca, length, and element type all reflect the real array layout.
func genArrayLit(ctx @GenContext, b @ir.Block, e @ast.Expr, arrTyp @types.Type) @ir.Instr {
	// The literal's storage (literalStorage): the array alloca is registered for
	// cleanup BEFORE the element loop (same as the struct-literal case in
	// genCompositeLit): a fresh array literal with managed
	// elements needs its elements RefDec'd to balance the copy a consumer takes,
	// AND — since each element is MOVED in as the loop goes (emitStoreManagedSlot
	// isInit -> consumeTemp) — a recoverable VM fault while evaluating a LATER
	// element must release the elements moved so far, via a pad that covers the
	// partial array.  The dtor RefDecs every element; the not-yet-filled ones are
	// null (the alloca is zero-initialised), so RefDec(null) no-ops.  The var-init
	// fast paths consumeTemp it when they reuse the alloca as the variable's storage.
	var arrPtr @ir.Instr = literalStorage(ctx, b, e, arrTyp)

	var elemTyp @types.Type = arrTyp.Elem
	if elemTyp == nil {
		elemTyp = types.TypInt()
	}

	// Store each element.  An INDEXED element (`[N]T{k: v}`) places its value
	// at the constant index k; an unkeyed element follows the previous index
	// + 1 (Go array-literal semantics, so `[5]int{1: 10, 3: 30}` is
	// {0,10,0,30,0} and `[3]int{1, 2}` is {1,2,0}).  Gaps stay zero because the
	// array alloca is zero-initialised.  The checker (checkArrayLit) has
	// already const-folded and bounds/duplicate-checked the indices.
	var nextIdx int = 0
	for i := 0; i < len(e.Elems); i++ {
		var arrIdx int = nextIdx
		if e.Elems[i].Key != nil {
			// Read the checker's validated index (checkArrayLit stamped it after
			// bounds/duplicate-checking), like TypeExpr.LenVal.  The fallback
			// evaluation covers any un-stamped key defensively (a validated keyed
			// literal always stamps KeyKnown).
			if e.Elems[i].KeyKnown {
				arrIdx = e.Elems[i].KeyVal
			} else {
				var kv constval.Value
				var kst int
				kv, kst = exprConstIR(ctx.Gc, ctx.Checker, e.Elems[i].Key)
				if kst == constval.OK && !kv.IsBool { arrIdx = kv.N.ToInt() }
			}
		}
		nextIdx = arrIdx + 1
		var idx @ir.Instr = irbuild.EmitConstInt(b, arrIdx, types.TypInt())
		var elemPtr @ir.Instr = irbuild.EmitGetElemPtr(b, arrPtr, idx, elemTyp)
		// genExprOrFuncRef, not plain genExpr: a function reference
		// (`pkg.Func` / method expression `T.M`) as an element must
		// lower to a real function value (OP_FUNC_VALUE), exactly as the
		// struct-field path does.  Plain genExpr would route it to
		// genSelector's catch-all fallback (an aborting panic), since no
		// value site bound it to a func-value-typed slot.
		var val @ir.Instr = genExprOrFuncRef(ctx, b, e.Elems[i].Value, elemTyp)
		b = ctx.CurBlock
		// Narrow untyped scalar literals, convert string-literal char-slice
		// elements to a full slice header, and load composite-literal aggregate
		// elements — the shared element-store coercions (coerceCompositeElement).
		val = coerceCompositeElement(ctx, b, val, elemTyp)
		// Acquire-and-store through the shared dispatcher: the array co-owns
		// each managed element (its scope-exit dtor RefDec's it).  isInit: a
		// freshly-alloc'd slot, no old value to release.  A fresh producer —
		// including an OP_CONST_NIL zero-init — is moved (consumeTemp), so no
		// RefInc / OP_EXTRACT runs on a nil constant.
		b = emitStoreManagedSlot(ctx, b, elemPtr, val, elemTyp, true)
	}
	return arrPtr
}

// genCompositeAddr emits the address of the composite literal e: its storage,
// typed as a pointer to the literal's own type — a named type's name included
// (`&Row{…}` is a `*Row`), which method dispatch keys on.  A struct or array
// literal is built in an alloca, which is the storage.  A slice literal is a
// value, which is stored into an alloca of its own; a managed slice's reference
// moves into that alloca (or is taken, for a static literal), which becomes the
// statement temporary, so a store through the address releases what it replaces
// and the alloca's last value is released at the statement's end — or, for a
// literal addressed in a var initializer, at the binding scope's end
// (noteAddressedLit).
func genCompositeAddr(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	var lit @ir.Instr = genExpr(ctx, b, e)
	var declTyp @types.Type = compositeDeclType(ctx, e)
	if isStructOrArrayAlloc(lit) {
		if declTyp == nil || same(types.StripWrappers(declTyp), declTyp) { return lit }
		return irbuild.EmitCast(ctx.CurBlock, lit, types.MakePointerType(declTyp))
	}
	if declTyp == nil { declTyp = lit.Typ }
	// A slice literal a defer's operands address is stored in its entry-depth
	// defer slot (deferLitSlot), which the function's exit releases.
	var deferSlot @ir.Instr = deferLitSlot(ctx, e)
	var slot @ir.Instr = deferSlot
	if slot == nil { slot = irbuild.EmitAlloc(ctx.CurBlock, declTyp) }
	var st @types.Type = types.StripWrappers(declTyp)
	if irutil.IsManagedSliceType(st) {
		// The slot takes its own reference: a fresh literal's moves in; a static
		// one (OP_RODATA_MSLICE, borrowed) is retained, as any slot store does.
		ctx.CurBlock = emitStoreManagedSlot(ctx, ctx.CurBlock, slot, lit, st, true)
		if deferSlot == nil {
			registerTemp(ctx, slot)
			if e.LitAddressed { noteAddressedLit(ctx, slot, slot) }
		}
		return slot
	}
	irbuild.EmitStore(ctx.CurBlock, slot, lit)
	return slot
}

// compositeDeclType returns the type the composite literal e declares — a named
// type's name included (`PairN{…}` is a `PairN`, `Box[int]{…}` the instance) — or
// nil when e is no composite literal with a type.  A struct or array literal is
// built in an alloca of its underlying type, so a consumer that needs the
// declared type takes it from here: the literal's address (genCompositeAddr), on
// which method dispatch keys, and a boxed value (`box(PairN{…})`), whose type the
// box records as its dynamic type.
func compositeDeclType(ctx @GenContext, e @ast.Expr) @types.Type {
	if e == nil || e.Kind != ast.EXPR_COMPOSITE || e.TypeRef == nil { return nil }
	return resolveTypeExpr(ctx.Gc, e.TypeRef)
}
