package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The const producers (single + grouped, incl. iota).
// Const-expression evaluation, literal classification, and
// float/bool folding live in gen_const_fold.bn.

// constValueFitsSignedTarget reports whether a folded const integer value
// `val` fits its declared SIGNED integer target's range.  This is a DEFENSIVE
// guard, not the live check: the type-checker (untypedIntLitFitsTarget ->
// bignum.FitsSigned) is the authoritative gate and rejects every out-of-range
// const BEFORE IR-gen runs, so this only matters if a future checker-bypass
// const path reaches genConst/genConstGroup -- in which case the producer
// aborts loudly rather than silently storing a host-int-WRAPPED value (e.g.
// `1 << 31` for an int32 target would otherwise truncate to INT32_MIN at
// codegen, diverging from the abstract value 2^31 the checker computes in
// bignum and rejects).
//
// For a 64-bit signed target the compiler's host int IS that width, so a value
// that overflowed 2^63 has already become an indistinguishable wrapped bit
// pattern (a valid int64) by the time it reaches here -- only the checker's
// bignum can detect that case -- so this returns true (no-op) for width >= 64,
// leaving the checker authoritative there.
func constValueFitsSignedTarget(val int64, typ @types.Type) bool {
	if typ == nil { return true }
	var d @types.Type = typ.ResolveAlias()
	// Peel readonly / named wrappers to the underlying primitive: a named int
	// (`type Flags int32`) carries the real width / signedness on Underlying.
	var i int = 0
	for d != nil && i < 8 {
		if d.Kind == types.TYP_READONLY { d = d.Elem; i = i + 1; continue }
		if d.Kind == types.TYP_NAMED && d.Underlying != nil {
			d = d.Underlying
			i = i + 1
			continue
		}
		break
	}
	if d == nil || d.Kind != types.TYP_INT || !d.Signed { return true }
	var w int = d.Width
	if w <= 0 || w >= 64 { return true }
	// Compute bounds in int64: `1 << (w-1)` for w up to 63 (and even w==32 on
	// an ILP32 host) overflows a host int, so the shift and hi/lo must be int64.
	var hi int64 = (cast(int64, 1) << (w - 1)) - 1
	var lo int64 = 0 - (cast(int64, 1) << (w - 1))
	return val >= lo && val <= hi
}

// genLocalGroupDecl lowers a func-local grouped declaration (DECL_GROUP) per
// member kind (a group is homogeneous — the keyword fixes the member kind) and
// returns the possibly-advanced block:
//   - const group → genConstGroup registers every member (with iota /
//     bare-repeat) in Module.Consts; reads resolve via emitModuleConstByName
//     (genFunc truncates these per function), so no per-member var slot is
//     needed.  This is why a member may use `iota`, which has no runtime
//     lowering — its value is folded at registration time.
//   - var group → materialize each member like a single local var, threading
//     the block through ctx.CurBlock (an initializer may split blocks).
//   - type group → func-local `type` decls are rejected by the checker
//     (decl.type.package-only), so this never reaches IR-gen; nothing to do.
func genLocalGroupDecl(ctx @GenContext, b @ir.Block, d @ast.Decl) @ir.Block {
	if len(d.Decls) == 0 { return b }
	if d.Decls[0].Kind == ast.DECL_CONST {
		genConstGroup(ctx.Gc, ctx.Checker, d)
		return b
	}
	var mb @ir.Block = b
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m.Kind == ast.DECL_VAR {
			ctx.CurBlock = mb
			genDecl(ctx, mb, m)
			mb = ctx.CurBlock
		}
	}
	return mb
}

// genConst registers a single constant declaration in Module.Consts, with
// the value the checker recorded on its initializer (constFromInitializer).
// A string constant, which has no integer / boolean / floating-point value,
// is not registered.
func genConst(gc @GenCtx, c @check.Checker, d @ast.Decl) {
	if d.Value == nil { return }
	var mc irsym.ModuleConst
	mc.Name = buf.CopyStr(d.Name)
	if d.TypeRef != nil {
		mc.Typ = resolveTypeExpr(gc, d.TypeRef)
	}
	if !constFromInitializer(gc, &mc, d, d.Value, 0, false, true) {
		return
	}
	if !constValueFitsSignedTarget(mc.Val, mc.Typ) {
		panic(
				"internal error: const value overflows its signed target type -- "
						"the type-checker fit gate (untypedIntLitFitsTarget) was bypassed "
						"(compiler bug)")
	}
	gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
}

// genConstGroup registers a group of iota constants in Module.Consts.
// Skips parked members (the REPL's Tier 3 forward-ref machinery
// marks individual const members as pending when their value
// expression references undefined names — see plan-repl-tier3-
// pending-types.md Stage 1 (c)).  iotaVal still increments
// across the parked positions so resolved members get the
// correct positional iota — the same value retry will give
// the parked member when it eventually lands via GenConstMember.
func genConstGroup(gc @GenCtx, c @check.Checker, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// A bare const-group member repeats the previous explicit member's
	// initializer and type (none for an untyped one), at its own iota (spec
	// §9.1 decl.const) — so `const ( B0 int = 1 << iota; B1; B2 )` yields
	// 1,2,4 (the bit-flag idiom), not plain iota 1,1,2.  prevExpr / prevTyp
	// carry that spec across bare members.
	var prevExpr @ast.Expr = nil
	var prevTyp @types.Type = nil
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			if c != nil && c.IsPendingDecl(cd.Name) {
				// Parked member.  Still increment iotaVal so
				// the next resolved member's iota reflects
				// source position.  retryPending's
				// GenConstMember path will register this
				// member when its dep arrives, using the same
				// iotaVal (preserved on the PendingDecl).
				iotaVal = iotaVal + 1
				continue
			}
			var mc irsym.ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			// A bare member repeats the previous explicit member's type (none
			// for an untyped one) and initializer (spec §9.1 decl.const).
			if cd.Value != nil {
				prevTyp = nil
				if cd.TypeRef != nil {
					prevTyp = resolveTypeExpr(gc, cd.TypeRef)
				}
			}
			mc.Typ = prevTyp
			// An explicit member reads the value the checker recorded on its
			// own initializer; a bare member repeats prevExpr, evaluated at
			// THIS member's iota (the recorded value on prevExpr is the
			// explicit member's).
			var registered bool
			if cd.Value != nil {
				prevExpr = cd.Value
				registered = constFromInitializer(gc, &mc, cd, cd.Value, iotaVal, true, true)
			} else {
				registered = constFromInitializer(gc, &mc, cd, prevExpr, iotaVal, true, false)
			}
			if !registered {
				iotaVal = iotaVal + 1
				continue
			}
			// Defensive (see constValueFitsSignedTarget): a bool/float member's
			// mc.Typ is non-integer, so the guard no-ops for those.
			if !constValueFitsSignedTarget(mc.Val, mc.Typ) {
				panic(
						"internal error: grouped const value overflows its signed "
								"target type -- the type-checker fit gate was bypassed "
								"(compiler bug)")
			}
			gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
