package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests that IR-gen emits every integer constant within its type's range — a
// property the IR verifier checks — for the lowerings that once produced one
// outside it.

// constsCanonical reports whether m passes the IR verifier, whose checks include
// that every integer constant fits its type.
func constsCanonical(m @ir.Module) bool {
	return len(irbuild.VerifyModule(m)) == 0
}

// On a 32-bit target the int minimum is emitted as the one constant -2^31 at
// int, not as the magnitude 2^31 (outside the 32-bit int) negated.  The unary
// expression is lowered directly: in a 64-bit unit-test binary the predeclared
// int keeps its 64-bit width, so a typed context would narrow the literal
// through the peer-type hint before this path is reached.
func TestIntMinLiteralOn32BitIsOneConstant() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTarget32()
	var p @parser.Parser = parser.New(
			strToBytes("package \"test\"\nfunc f() int { return -2147483648 }\n"), "test")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var e @ast.Expr = file.Decls[0].Body.Stmts[0].Exprs[0]
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var v @ir.Instr = tryFoldOversizedConst(c, b, e)
	types.SetTarget(saved)
	if v == nil || v.Op != iropcode.OP_CONST_INT || v.IntVal != cast(int64, -2147483648) {
		return fail("-2147483648 on a 32-bit target must fold to one constant -2147483648")
	}
	if v.Typ != types.TypInt() {
		return fail("the int minimum must be typed int, as the negation's result is")
	}
	if len(b.Instrs) != 1 { return fail("the fold must emit exactly one instruction") }
	return ""
}

// A float-to-unsigned cast's saturation masks use the unsigned type's all-ones
// value (255 for uint8), not -1.
func TestFloatToUnsignedCastMasksInRange() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc f(x float64) uint8 { return cast(uint8, x) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	if !constsCanonical(m) { return fail("cast(uint8, float) left a constant outside uint8") }
	return ""
}

// A constant shift count that does not fit the shifted value's type (an
// overshift) is not retagged to that type.
func TestOvershiftCountNotRetaggedOutOfRange() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc f(x uint8) uint8 { return x << 256 }\n"
					"func g(x int8) int8 { return x >> 256 }\n")
	if len(m.Funcs) < 2 { return fail("no funcs") }
	if !constsCanonical(m) {
		return fail("an overshift count 256 was typed as the 8-bit value's type")
	}
	return ""
}
