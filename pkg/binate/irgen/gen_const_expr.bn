package "pkg/binate/irgen"

import "pkg/binate/ir"

// A constant computed through a floating-point value is not folded: it is
// stored as its initializer (CONST_EXPR, stashConstExpr) and re-lowered at each
// read.  These lower it.

// genConstExpr lowers the stashed initializer of the float const-expression
// Module.Consts[i] with only the first scopeLen local bindings visible — the
// ones in scope at its declaration, none for a package constant — so a name
// in it resolves as it did there, not to a later local of the same name (or,
// for `const ( F = F * 2.0 )`, to the constant itself).  A constant
// initializer names only constants, declared before it.
func genConstExpr(ctx @GenContext, b @ir.Block, i int, scopeLen int) @ir.Instr {
	var saved @[]VarSlot = ctx.Vars
	ctx.Vars = ctx.Vars[:scopeLen]
	var v @ir.Instr = genExpr(ctx, b, ctx.Gc.Mod.Consts[i].Expr)
	ctx.Vars = saved
	return v
}

// genImportedConstExpr is genConstExpr for a float const-expression of the
// imported package pkg read as `pkg.X`: its bare names are that package's
// constants, so it is lowered as a generic body of pkg is (CurrentImportPkg),
// seeing no local, under the imports it was declared under (genDeclaredConstExpr).
func genImportedConstExpr(ctx @GenContext, b @ir.Block, i int, pkg @[]char) @ir.Instr {
	var savedPkg @[]char = ctx.Gc.Mod.CurrentImportPkg
	ctx.Gc.Mod.CurrentImportPkg = pkg
	var v @ir.Instr = genDeclaredConstExpr(ctx, b, i)
	ctx.Gc.Mod.CurrentImportPkg = savedPkg
	return v
}

// genDeclaredConstExpr lowers the package-level float const-expression
// Module.Consts[i], seeing no local, under the import-alias map recorded where
// it was declared (stashConstExpr): its package-qualified names (`a.A`,
// `cast(a.T, …)`) mean what they meant there — not what the reading file binds
// `a` to (another file of the package, an importer), nor a later prompt import's
// rebinding at the REPL.
func genDeclaredConstExpr(ctx @GenContext, b @ir.Block, i int) @ir.Instr {
	var saved AliasMapSnapshot = SaveAliasMapState(ctx.Gc.Mod)
	ctx.Gc.Mod.ImportAliasNames = ctx.Gc.Mod.Consts[i].ImportNames
	ctx.Gc.Mod.ImportAliasPaths = ctx.Gc.Mod.Consts[i].ImportPaths
	var v @ir.Instr = genConstExpr(ctx, b, i, 0)
	RestoreAliasMapState(ctx.Gc.Mod, saved)
	return v
}
