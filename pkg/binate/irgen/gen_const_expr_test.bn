package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_const_expr.bn.

// addFloatConst registers the float constant qualName = text in m.
func addFloatConst(m @ir.Module, qualName *[]readonly char, text *[]readonly char) {
	var mc irsym.ModuleConst
	mc.Name = buf.CopyStr(qualName)
	mc.Kind = CONST_FLT
	mc.FltText = buf.CopyStr(text)
	mc.Typ = types.TypFloat64()
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, mc)
}

// funcHasFloatConst reports whether f emits the float constant text.
func funcHasFloatConst(f @ir.Func, text *[]readonly char) bool {
	for i := 0; i < len(f.Blocks); i++ {
		var b @ir.Block = f.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == iropcode.OP_CONST_FLOAT && charsEqual(b.Instrs[j].StrVal, text) {
				return true
			}
		}
	}
	return false
}

// A package constant expression read in a function is re-lowered from its
// initializer as the checker recorded it: its `A` is the package constant (1.5),
// not the reading function's local A.
func TestDeclaredConstExprNamesThePackageConst() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"const A = 1.5\n"
					"const X float64 = A * 2.0\n"
					"func f() float64 {\n"
					"\tvar A float64 = 9.25\n"
					"\treturn X + A\n"
					"}\n")
	if constKind(m, "X") != CONST_EXPR { return fail("X should be CONST_EXPR") }
	var f @ir.Func = findFunc(m, "f")
	if f == nil { return fail("no function f") }
	if !funcHasFloatConst(f, "1.5") { return fail("X should read the package constant A") }
	return ""
}
