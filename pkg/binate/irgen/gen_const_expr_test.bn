package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_const_expr.bn.

// addFloatConst registers the float constant qualName = text in m.
func addFloatConst(m @ir.Module, qualName *[]readonly char, text *[]readonly char) {
	var mc irsym.ModuleConst
	mc.Name = buf.CopyStr(qualName)
	mc.Kind = CONST_FLT
	mc.FltText = buf.CopyStr(text)
	mc.Typ = types.TypFloat64()
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, mc)
}

// A package-level constant expression `X = a.A` declared where `a` meant pkg/a
// is lowered under that binding, even where `a` now means pkg/b; the module's
// alias map is as it was afterwards.
func TestDeclaredConstExprUsesItsImports() testing.TestResult {
	var m @ir.Module = InitModule("\"main\"")
	var gc @GenCtx = NewGenCtx(m)
	addFloatConst(m, "pkg/a.A", "1.5")
	addFloatConst(m, "pkg/b.A", "100.25")
	var base @ast.Expr = make(ast.Expr)
	base.Kind = ast.EXPR_IDENT
	base.Name = "a"
	var sel @ast.Expr = make(ast.Expr)
	sel.Kind = ast.EXPR_SELECTOR
	sel.X = base
	sel.Name = "A"
	var x irsym.ModuleConst
	x.Name = buf.CopyStr("main.X")
	x.Kind = CONST_EXPR
	x.Expr = sel
	x.ImportNames = slices.Append[@[]char](x.ImportNames, buf.CopyStr("a"))
	x.ImportPaths = slices.Append[@[]char](x.ImportPaths, buf.CopyStr("pkg/a"))
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, x)
	m.ImportAliasNames = slices.Append[@[]char](m.ImportAliasNames, buf.CopyStr("a"))
	m.ImportAliasPaths = slices.Append[@[]char](m.ImportAliasPaths, buf.CopyStr("pkg/b"))
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("main", "t", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = gc
	ctx.CurBlock = entry
	var v @ir.Instr = genDeclaredConstExpr(ctx, entry, len(m.Consts) - 1)
	if v == nil || v.Op != iropcode.OP_CONST_FLOAT || !charsEqual(v.StrVal, "1.5") {
		return fail("X should read pkg/a's A, under the binding it was declared with")
	}
	if len(m.ImportAliasPaths) != 1 || !charsEqual(m.ImportAliasPaths[0], "pkg/b") {
		return fail("the module's alias map should be restored")
	}
	return ""
}
