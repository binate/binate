package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Classification of const initializers that constval does not evaluate:
// boolean and floating-point literals and floating-point const-expressions
// (with iota substitution).  Integer and boolean constant expressions are
// evaluated in gen_constval.bn; the producers (genConst / genConstGroup) live
// in gen_const.bn.

// boolLitValue extracts the boolean value from an EXPR_BOOL_LIT node.
// The parser records the literal either as the text "true"/"false" in
// Name or directly in BoolVal, so both forms are handled — matching how
// the expression path lowers a bool literal in genExpr.
func boolLitValue(e @ast.Expr) bool {
	if len(e.Name) > 0 { return irutil.Streq(e.Name, "true") }
	return e.BoolVal
}

// floatConstText returns the raw float-literal text for a const
// initializer that is a float literal — bare, or negated via unary
// minus.  `-1.5` parses as EXPR_UNARY(MINUS) over EXPR_FLOAT_LIT, so the
// sign is folded back into the text the backend parses (otherwise a
// negative float const would reach the constant evaluator, which folds only
// integers and booleans, and be dropped).  ok=false when the initializer is
// not a (possibly-negated) float literal.
func floatConstText(e @ast.Expr) (@[]char, bool) {
	var none @[]char
	if e == nil { return none, false }
	if e.Kind == ast.EXPR_FLOAT_LIT { return e.Name, true }
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.MINUS) && e.X != nil &&
			e.X.Kind == ast.EXPR_FLOAT_LIT {
		var b @strings.Builder = strings.NewBuilder()
		b.WriteByte('-')
		b.Write(e.X.Name)
		return buf.CopyStr(b.String()), true
	}
	return none, false
}

// classifyConstLit populates mc.Kind and the matching value slot when a
// const initializer is a bool or (possibly-negated) float literal, and
// reports whether it matched.  Centralizes the non-integer scalar
// literal recognition shared by every const producer (single + group,
// in-package + imported); callers fall back to the constant evaluator
// (constFromInitializer) when it returns false.  Consts are scalar-only, so there is no
// string case (string-typed const decls are rejected by the type
// checker).
func classifyConstLit(mc *irsym.ModuleConst, e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_BOOL_LIT {
		mc.BoolVal = boolLitValue(e)
		mc.Kind = CONST_BOOL
		return true
	}
	var fltText @[]char
	var isFlt bool
	fltText, isFlt = floatConstText(e)
	if isFlt {
		mc.FltText = fltText
		mc.Kind = CONST_FLT
		return true
	}
	return false
}

// isFloatExpr reports whether e is built, through the unary/binary operators
// and conversions, from a float literal, a float constant registered earlier or
// a conversion to a float type: how a constant the checker kept no record of is
// recognized as computed through a floating-point value (constFromInitializer).
// A bare/negated float LITERAL is handled earlier by classifyConstLit.  An
// expression of integers alone stays on the integer path (a float-typed constant
// cannot have one: an untyped integer is not assignable to a float type).
func isFloatExpr(gc @GenCtx, e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_FLOAT_LIT { return true }
	// A reference to an already-registered float const (CONST_FLT /
	// CONST_EXPR) makes its containing expression float — so
	// `const C float64 = A + B` (no float literal) is recognized rather
	// than falling to the integer path and reading back int 0.
	if e.Kind == ast.EXPR_IDENT { return isFloatConstIdent(gc, e.Name) }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		return isFloatConstIdent(gc, buildQualNameHomed(gc.Mod, e.X.Name, e.Name))
	}
	if e.Kind == ast.EXPR_UNARY { return isFloatExpr(gc, e.X) }
	if e.Kind == ast.EXPR_BINARY {
		return isFloatExpr(gc, e.X) || isFloatExpr(gc, e.Y)
	}
	// A conversion to a float type (`cast(float64, 5)`, `cast(Celsius, iota)`) is
	// a float value with no float literal in it, and a conversion of a float value
	// (`cast(int, F)`) is computed through one.
	if e.Kind == ast.EXPR_BUILTIN && e.TypeRef != nil &&
			(e.Op == cast(int, token.CAST) || e.Op == cast(int, token.UNSAFE_CAST) ||
					e.Op == cast(int, token.BIT_CAST)) {
		var t @types.Type = types.StripWrappers(resolveTypeExpr(gc, e.TypeRef))
		if t != nil && t.IsFloat() { return true }
		for i := 0; i < len(e.Args); i++ {
			if isFloatExpr(gc, e.Args[i]) { return true }
		}
	}
	return false
}

// isFloatConstIdent reports whether name resolves to a float const
// already registered in gc.Mod.Consts (CONST_FLT or CONST_EXPR).
func isFloatConstIdent(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.Mod.Consts); i++ {
		if irutil.Streq(gc.Mod.Consts[i].Name, name) {
			return gc.Mod.Consts[i].Kind == CONST_FLT || gc.Mod.Consts[i].Kind == CONST_EXPR
		}
	}
	return false
}

// substituteIota returns a copy of e with every `iota` identifier
// replaced by the integer literal iotaVal.  A float const-EXPRESSION is
// stashed as a CONST_EXPR AST and re-lowered at the read site, where
// `iota` is not in scope (it would lower to 0); baking the group
// member's iota into the stored AST keeps the re-lowered value correct
// (e.g. `1.5 * cast(float64, iota)` for member 2 becomes `1.5 *
// cast(float64, 2)`).  Only the node kinds a float const-expr can
// contain are deep-copied; other kinds pass through unchanged.
func substituteIota(e @ast.Expr, iotaVal int) @ast.Expr {
	if e == nil { return e }
	if e.Kind == ast.EXPR_IDENT {
		if irutil.Streq(e.Name, "iota") {
			var lit @ast.Expr = make(ast.Expr)
			lit.Kind = ast.EXPR_INT_LIT
			lit.Name = strconv.Itoa(iotaVal)
			lit.Pos = e.Pos
			return lit
		}
		return e
	}
	if e.Kind == ast.EXPR_UNARY {
		var nu @ast.Expr = make(ast.Expr)
		nu.Kind = e.Kind
		nu.Op = e.Op
		nu.Pos = e.Pos
		nu.X = substituteIota(e.X, iotaVal)
		return nu
	}
	if e.Kind == ast.EXPR_BINARY {
		var nb @ast.Expr = make(ast.Expr)
		nb.Kind = e.Kind
		nb.Op = e.Op
		nb.Pos = e.Pos
		nb.X = substituteIota(e.X, iotaVal)
		nb.Y = substituteIota(e.Y, iotaVal)
		return nb
	}
	if e.Kind == ast.EXPR_BUILTIN {
		var nc @ast.Expr = make(ast.Expr)
		nc.Kind = e.Kind
		nc.Op = e.Op
		nc.Pos = e.Pos
		nc.TypeRef = e.TypeRef
		var args @[]@ast.Expr
		for i := 0; i < len(e.Args); i++ {
			args = slices.Append[@ast.Expr](args, substituteIota(e.Args[i], iotaVal))
		}
		nc.Args = args
		return nc
	}
	return e
}

// stashConstExpr records a constant computed through a floating-point value as
// CONST_EXPR, stashing its initializer e so each read site re-lowers it
// (genExpr) and the backend computes the value at runtime.  The float-const path
// carries decimal text through a decimal-only parser and OP_CONST_FLOAT holds no
// bits, so a compile-time-folded result can't be re-encoded as text exactly;
// emitting the expression yields the exact IEEE result — the same way a LOCAL
// float const materializes (genDecl's var-init path).
func stashConstExpr(mc *irsym.ModuleConst, e @ast.Expr, iotaVal int) {
	mc.Expr = substituteIota(e, iotaVal)
	mc.Kind = CONST_EXPR
}
