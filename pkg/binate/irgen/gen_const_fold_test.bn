package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for IR-gen's constant evaluation (evalConstIR, through the helpers
// in gen_constval_test.bn) on the expression forms IR-gen folds itself.

// Pin the literal-int base case: `42` → 42, ok=true.
func TestEvalConstExprIntLit() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalIntIR(NewGenCtx(nil), mkIntLitExpr("42"), 0)
	if !ok { return fail("int lit eval failed") }
	if v != 42 { return fail("int lit value wrong") }
	return ""
}

// The bare-iota identifier should resolve to the supplied
// iotaVal.  Pins the const-group counter contract.
func TestEvalConstExprBareIota() testing.TestResult {
	var v int
	var ok bool
	v, ok = evalIntIR(NewGenCtx(nil), mkIdentExpr("iota"), 5)
	if !ok { return fail("iota eval failed") }
	if v != 5 { return fail("iota didn't return iotaVal") }
	return ""
}

// `iota + 32` — the pattern pkg/binate/asm/aarch64.bni uses for D0..D31.
// With iotaVal=16 it must return 48 (= D16's intended value); returning
// iotaVal alone (e.g. 0 for D0) makes FP_SCRATCH_A / B collide.
func TestEvalConstExprIotaPlusOffset() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.PLUS), mkIdentExpr("iota"), mkIntLitExpr("32"))
	var v int
	var ok bool
	v, ok = evalIntIR(NewGenCtx(nil), e, 16)
	if !ok { return fail("iota+32 eval failed") }
	if v != 48 { return fail("iota+32 with iota=16 should yield 48") }
	return ""
}

// checkedVarValue checks src and evaluates the initializer of its variable v
// (evalIntIR); a message when src does not check.
func checkedVarValue(src *[]readonly char) (int, bool, @[]char) {
	recordsSrc = buf.CopyStr(src)
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return 0, false, msg }
	var v int
	var ok bool
	v, ok = evalIntIR(gc, varInit(file, "v"), 0)
	return v, ok, msg
}

// `sizeof(int8)` evaluates at compile time -- a constant like `const HEADER_SIZE
// uint = sizeof(int)` needs it -- with a target-independent type (int8 is always
// 1 byte).
func TestEvalConstExprSizeofInt8() testing.TestResult {
	var v int
	var ok bool
	var msg @[]char
	v, ok, msg = checkedVarValue("package \"main\"\nvar v uint = sizeof(int8)\n")
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("sizeof(int8) eval failed") }
	if v != 1 { return fail("sizeof(int8) should be 1") }
	return ""
}

// `alignof(int32)` — target-independent (4 on every supported
// target).
func TestEvalConstExprAlignofInt32() testing.TestResult {
	var v int
	var ok bool
	var msg @[]char
	v, ok, msg = checkedVarValue("package \"main\"\nvar v uint = alignof(int32)\n")
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("alignof(int32) eval failed") }
	if v != 4 { return fail("alignof(int32) should be 4") }
	return ""
}

// `cast(int, 42)` — over a constant operand, value passes
// through.  A `const int = <count> * cast(int, sizeof(int))` shape (e.g. a
// header byte-size derived from a word count) requires this.
func TestEvalConstExprCastPassThrough() testing.TestResult {
	var v int
	var ok bool
	var msg @[]char
	v, ok, msg = checkedVarValue("package \"main\"\nvar v int = cast(int, 42)\n")
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("cast(int, 42) eval failed") }
	if v != 42 { return fail("cast pass-through value wrong") }
	return ""
}

// `bit_cast(int, 7)` — same pass-through behavior as cast.
func TestEvalConstExprBitCastPassThrough() testing.TestResult {
	var v int
	var ok bool
	var msg @[]char
	v, ok, msg = checkedVarValue("package \"main\"\nvar v int = bit_cast(int, 7)\n")
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("bit_cast(int, 7) eval failed") }
	if v != 7 { return fail("bit_cast pass-through value wrong") }
	return ""
}

// 2 * cast(int, sizeof(int8)) — the exact `<count> * cast(int, sizeof(T))`
// header-byte-size shape (but with a target-independent type so the expected
// value pins).  Combines binary + builtin + cast in one expression.
func TestEvalConstExprCompositeWithSizeof() testing.TestResult {
	var v int
	var ok bool
	var msg @[]char
	v, ok, msg = checkedVarValue("package \"main\"\nvar v int = 2 * cast(int, sizeof(int8))\n")
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("2 * cast(int, sizeof(int8)) eval failed") }
	if v != 2 { return fail("composite should be 2") }
	return ""
}

// `1 << iota` — pattern used for bitflag constants.  It must fold, not
// degrade to iotaVal.
func TestEvalConstExprShlIota() testing.TestResult {
	var e @ast.Expr = mkBinaryExpr(cast(int, token.SHL), mkIntLitExpr("1"), mkIdentExpr("iota"))
	var v int
	var ok bool
	v, ok = evalIntIR(NewGenCtx(nil), e, 4)
	if !ok { return fail("1<<iota eval failed") }
	if v != 16 { return fail("1<<4 should yield 16") }
	return ""
}

// An identifier naming a constant the module registered evaluates to its value,
// read from the module's table: registered as 43, not the 42 the checker folds.
func TestEvalConstExprIdentFromModuleConsts() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nconst ANSWER int = 42\nvar v int = ANSWER\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return fail(msg) }
	addConst(gc, "ANSWER", 43, false)
	var v int
	var ok bool
	v, ok = evalIntIR(gc, varInit(file, "v"), 0)
	if !ok { return fail("ident from the Consts table failed") }
	if v != 43 { return fail("ANSWER should be the table's 43") }
	return ""
}

// A package's member `pkg.NAME` evaluates to the constant the module registers
// under the name the checker recorded: the path that resolves `aarch64.D16` in
// `const FP_SCRATCH_A int = aarch64.D16`.
func TestEvalConstExprQualifiedSelector() testing.TestResult {
	var m @ir.Module = testInitModule("main")
	_ = checkedBni(m, "pkg/a", "package \"pkg/a\"\nconst X int = 99\n")
	var file @ast.File = checkedSource(m, "package \"main\"\nimport \"pkg/a\"\nvar v int = a.X\n")
	var gc @GenCtx = NewGenCtx(m)
	addConst(gc, "pkg/a.X", 99, false)
	var v int
	var ok bool
	v, ok = evalIntIR(gc, varInit(file, "v"), 0)
	if !ok { return fail("selector eval failed") }
	if v != 99 { return fail("a.X should resolve to 99") }
	return ""
}

// A name the checker recorded as no constant -- a variable -- is not one: (0,
// false).
func TestEvalConstExprVariableIdent() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nvar w int = 1\nvar v int = w\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return fail(msg) }
	var v int
	var ok bool
	v, ok = evalIntIR(gc, varInit(file, "v"), 3)
	if ok { return fail("a variable should return ok=false") }
	if v != 0 { return fail("a variable should yield 0") }
	return ""
}

// mkBoolLitExpr builds an EXPR_BOOL_LIT recording "true"/"false" in Name,
// per the parser convention.
func mkBoolLitExpr(value bool) @ast.Expr {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = ast.EXPR_BOOL_LIT
	if value {
		v.Name = "true"
	} else {
		v.Name = "false"
	}
	return v
}

// mkNotExpr builds a `!x` unary expression.
func mkNotExpr(x @ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_UNARY
	e.Op = cast(int, token.NOT)
	e.X = x
	return e
}

// NOT / LAND / LOR fold over boolean literals.
func TestEvalConstBoolLiteralLogic() testing.TestResult {
	var m @ir.Module = testModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var a @ast.Expr = mkBoolLitExpr(true)
	var b @ast.Expr = mkBoolLitExpr(false)
	var v bool
	var ok bool
	v, ok = evalBoolIR(gc, mkBinaryExpr(cast(int, token.LAND), a, b), 0)
	if !ok || v { return fail("true && false should fold to false") }
	v, ok = evalBoolIR(gc, mkBinaryExpr(cast(int, token.LOR), a, b), 0)
	if !ok || !v { return fail("true || false should fold to true") }
	v, ok = evalBoolIR(gc, mkNotExpr(a), 0)
	if !ok || v { return fail("!true should fold to false") }
	return ""
}

// A reference to another boolean const resolves — `const C bool = !A`.
func TestEvalConstBoolConstRef() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nconst A bool = false\nvar v bool = !A\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return fail(msg) }
	var mc irsym.ModuleConst
	mc.Name = "A"
	mc.Kind = CONST_BOOL
	mc.BoolVal = false
	gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
	var v bool
	var ok bool
	v, ok = evalBoolIR(gc, varInit(file, "v"), 0)
	if !ok || !v { return fail("!A (A=false) should fold to true") }
	return ""
}

// constValueFitsSignedTarget is the defensive guard genConst/genConstGroup use
// to fail loud (instead of silently host-int-wrapping) if a checker bypass ever
// lets a signed-overflow const reach IR-gen.  The checker is the live gate, so
// this only pins the guard's LOGIC (the producers panic on a false result).
func TestConstValueFitsSignedTargetGuard() testing.TestResult {
	// int32: boundaries fit; 2^31 (the `1<<31` overflow) does NOT.
	if !constValueFitsSignedTarget(2147483647, types.TypInt32()) {
		return fail("INT32_MAX must fit int32")
	}
	if !constValueFitsSignedTarget(0 - 2147483648, types.TypInt32()) {
		return fail("INT32_MIN must fit int32")
	}
	if constValueFitsSignedTarget(2147483648, types.TypInt32()) {
		return fail("2^31 must NOT fit int32 (the 1<<31 sign-bit overflow case)")
	}
	// int8 boundaries.
	if !constValueFitsSignedTarget(127, types.TypInt8()) {
		return fail("127 must fit int8")
	}
	if !constValueFitsSignedTarget(0 - 128, types.TypInt8()) {
		return fail("-128 must fit int8")
	}
	if constValueFitsSignedTarget(128, types.TypInt8()) {
		return fail("128 must NOT fit int8")
	}
	// A 64-bit signed target is a host-bounded no-op: the host int IS that
	// width, so an overflowed 2^63 is already an indistinguishable wrapped bit
	// pattern -- only the checker's bignum sees it (always returns true here).
	if !constValueFitsSignedTarget(2147483648, types.TypInt64()) {
		return fail("width-64 signed target must be a no-op (always fits)")
	}
	// Unsigned target: not a SIGNED target, so a no-op.
	if !constValueFitsSignedTarget(2147483648, types.TypUint32()) {
		return fail("unsigned target must be a no-op (always fits)")
	}
	// nil target: no-op.
	if !constValueFitsSignedTarget(123, nil) {
		return fail("nil target must be a no-op")
	}
	return ""
}

// substituteIota copies only the nodes on a path to an iota: a subtree with none is
// the original node.  A copy keeps its node's checker type ID, and the literal that
// replaces iota takes iota's — the expression was checked at this iota.
func TestSubstituteIotaKeepsSubtreesWithoutIota() testing.TestResult {
	var lit @ast.Expr = make(ast.Expr)
	lit.Kind = ast.EXPR_INT_LIT
	lit.Name = "1"
	var neg @ast.Expr = make(ast.Expr)
	neg.Kind = ast.EXPR_UNARY
	neg.Op = cast(int, token.MINUS)
	neg.X = lit
	neg.ResolvedTypeID = 7
	if substituteIota(neg, 3) != neg { return fail("a subtree with no iota is the original node") }
	var io @ast.Expr = make(ast.Expr)
	io.Kind = ast.EXPR_IDENT
	io.Name = "iota"
	io.ResolvedTypeID = 5
	var sum @ast.Expr = make(ast.Expr)
	sum.Kind = ast.EXPR_BINARY
	sum.Op = cast(int, token.PLUS)
	sum.X = neg
	sum.Y = io
	sum.ResolvedTypeID = 9
	var out @ast.Expr = substituteIota(sum, 3)
	if out == sum || out.ResolvedTypeID != 9 {
		return fail("a node over an iota is a copy keeping its type ID")
	}
	if out.X != neg { return fail("the copy keeps its iota-free operand") }
	if out.Y.Kind != ast.EXPR_INT_LIT || out.Y.Name[0] != '3' || out.Y.ResolvedTypeID != 5 {
		return fail("iota becomes its value, keeping iota's type ID")
	}
	var c1 @ast.Expr = make(ast.Expr)
	c1.Kind = ast.EXPR_BUILTIN
	c1.Op = cast(int, token.CAST)
	c1.Args = @[]@ast.Expr{neg}
	if substituteIota(c1, 3) != c1 { return fail("a builtin over no iota is the original node") }
	var c2 @ast.Expr = make(ast.Expr)
	c2.Kind = ast.EXPR_BUILTIN
	c2.Op = cast(int, token.CAST)
	c2.Args = @[]@ast.Expr{io}
	var cout @ast.Expr = substituteIota(c2, 3)
	if cout == c2 || cout.Args[0].Kind != ast.EXPR_INT_LIT {
		return fail("a builtin over an iota is a copy with iota's value")
	}
	return ""
}
