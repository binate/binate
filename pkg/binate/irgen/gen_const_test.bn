package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the const producers (genConst / genConstGroup).
// Const-expression evaluation / folding tests live in
// gen_const_fold_test.bn.

// ============================================================
// evalConstExpr — direct coverage of the const-expression
// evaluator.  Pins the cases that pkg/binate/asm/aarch64.bni's
// `D0 int = iota + 32` (and friends) actually need: literal
// ints, bare iota, qualified selectors, and binary arithmetic.
//
// Pre-fix, the genConstGroup / registerImportConstGroup paths
// only handled EXPR_INT_LIT and silently fell back to the raw
// iota counter for everything else — so `D0 int = iota + 32`
// became 0, then 1, ..., 31 instead of 32..63.  That made
// FP_SCRATCH_A and FP_SCRATCH_B both resolve to 0 in a self-
// hosted bnc (`FP_SCRATCH_A int = aarch64.D16` got iotaVal=0
// from the non-group path), so emitFloatBinop's two FMOVs
// targeted the same Dn register and `1.5 + 2.5` computed
// `2.5 + 2.5 = 5.0`.
// ============================================================

func mkIntLitExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INT_LIT
	e.Name = s
	return e
}

func mkFloatLitExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_FLOAT_LIT
	e.Name = s
	return e
}

func mkIdentExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Name = s
	return e
}

func mkBinaryExpr(op int, x @ast.Expr, y @ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BINARY
	e.Op = op
	e.X = x
	e.Y = y
	return e
}

// emptyExprList returns a freshly-typed nil-value @[]@ast.Expr —
// useful for builtin exprs (sizeof / alignof) that take no Args.
func emptyExprList() @[]@ast.Expr {
	var empty @[]@ast.Expr
	return empty
}

// Named-type expr helper for the sizeof / alignof tests below.
func mkNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

// Builtin-call expr (sizeof / alignof / cast / bit_cast) helper.
func mkBuiltinExpr(op int, typeRef @ast.TypeExpr, args @[]@ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Op = op
	e.TypeRef = typeRef
	e.Args = args
	return e
}

// mkConstBoolDecl builds a `const <name> bool = <true|false>` decl,
// mirroring the parser convention that an EXPR_BOOL_LIT records the
// literal text "true"/"false" in Name.
func mkConstBoolDecl(name @[]char, value bool) @ast.Decl {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = ast.EXPR_BOOL_LIT
	if value {
		v.Name = "true"
	} else {
		v.Name = "false"
	}
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Name = name
	d.Value = v
	return d
}

// A bool-typed top-level const must register with Kind == CONST_BOOL and
// the literal value in BoolVal, not fall through to the integer path
// (which lowers to EmitConstInt(0) = false at every read site, ignoring
// the declared value).  Both true and false are checked so a hardcoded
// value would fail.
func TestGenConstBoolLitRegistersKind() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	genConst(gc, nil, mkConstBoolDecl("Enabled", true))
	genConst(gc, nil, mkConstBoolDecl("Disabled", false))
	if len(m.Consts) != 2 { return fail("expected 2 entries") }
	if m.Consts[0].Kind != CONST_BOOL { return fail("Enabled Kind not CONST_BOOL") }
	if !m.Consts[0].BoolVal { return fail("Enabled BoolVal should be true") }
	if m.Consts[1].Kind != CONST_BOOL { return fail("Disabled Kind not CONST_BOOL") }
	if m.Consts[1].BoolVal { return fail("Disabled BoolVal should be false") }
	return ""
}

// mkConstExprDecl builds a `const <name> = <value>` decl from an
// arbitrary initializer expression (used to exercise const-expression
// folding, e.g. a comparison).
func mkConstExprDecl(name @[]char, value @ast.Expr) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Name = name
	d.Value = value
	return d
}

// A const whose initializer is a COMPARISON folds to a bool
// (classifyConstBoolExpr → CONST_BOOL) rather than being dropped by the
// integer-only evalConstExpr and read back as int 0.  `1 < 2` → true,
// `5 > 9` → false.
func TestGenConstComparisonRegistersBool() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var lt @ast.Expr = mkBinaryExpr(cast(int, token.LT), mkIntLitExpr("1"), mkIntLitExpr("2"))
	var gt @ast.Expr = mkBinaryExpr(cast(int, token.GT), mkIntLitExpr("5"), mkIntLitExpr("9"))
	genConst(gc, nil, mkConstExprDecl("T", lt))
	genConst(gc, nil, mkConstExprDecl("F", gt))
	if len(m.Consts) != 2 { return fail("expected 2 entries") }
	if m.Consts[0].Kind != CONST_BOOL { return fail("T Kind not CONST_BOOL") }
	if !m.Consts[0].BoolVal { return fail("T (1<2) should be true") }
	if m.Consts[1].Kind != CONST_BOOL { return fail("F Kind not CONST_BOOL") }
	if m.Consts[1].BoolVal { return fail("F (5>9) should be false") }
	return ""
}

// A float const-EXPRESSION registers as CONST_EXPR carrying its AST, so
// the read site re-lowers it (the float-const path can't carry a folded
// result as exact text).  `0.5 * 0.5` is a float binary expression, not
// a bare literal, so it does not take the CONST_FLT (literal-text) path.
func TestGenConstFloatExprRegistersExprKind() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mul @ast.Expr = mkBinaryExpr(cast(int, token.STAR), mkFloatLitExpr("0.5"),
			mkFloatLitExpr("0.5"))
	genConst(gc, nil, mkConstExprDecl("Q", mul))
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	if m.Consts[0].Kind != CONST_EXPR {
		return fail("Q Kind should be CONST_EXPR")
	}
	if m.Consts[0].Expr == nil {
		return fail("Q should stash its initializer expression")
	}
	return ""
}

// mkConstFloatDecl builds a `const <name> floatT = <text>` decl; an
// EXPR_FLOAT_LIT records the raw literal text in Name (the backend
// parses it at lowering time).
func mkConstFloatDecl(name @[]char, text @[]char) @ast.Decl {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = ast.EXPR_FLOAT_LIT
	v.Name = text
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Name = name
	d.Value = v
	return d
}

// A float-typed top-level const must register with Kind == CONST_FLT and
// the raw literal text in FltText, not fall through to the integer path
// (which lowers to EmitConstInt(0) = 0.0 at every read site).
func TestGenConstFloatLitRegistersKind() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	genConst(gc, nil, mkConstFloatDecl("Pi", "3.5"))
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	if m.Consts[0].Kind != CONST_FLT { return fail("Pi Kind not CONST_FLT") }
	if !seq(m.Consts[0].FltText, "3.5") { return fail("Pi FltText should be raw text 3.5") }
	return ""
}

// A negative float const (`const X float64 = -1.5`) parses as unary
// minus over EXPR_FLOAT_LIT, not a bare float literal, so genConst must
// still register it as CONST_FLT with the sign folded into FltText —
// otherwise it falls through to the integer-only evalConstExpr, is
// dropped, and reads back as 0.0.
func TestGenConstNegativeFloatLitRegistersKind() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	// Build `const X = -1.5`: EXPR_UNARY(MINUS) over EXPR_FLOAT_LIT.
	var lit @ast.Expr = make(ast.Expr)
	lit.Kind = ast.EXPR_FLOAT_LIT
	lit.Name = "1.5"
	var neg @ast.Expr = make(ast.Expr)
	neg.Kind = ast.EXPR_UNARY
	neg.Op = cast(int, token.MINUS)
	neg.X = lit
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Name = "X"
	d.Value = neg
	genConst(gc, nil, d)
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	if m.Consts[0].Kind != CONST_FLT { return fail("neg float Kind not CONST_FLT") }
	if !seq(m.Consts[0].FltText, "-1.5") { return fail("neg float FltText should be -1.5") }
	return ""
}

// Non-int members of a const GROUP (`const ( B bool = true; F float64
// = 2.5 )`) must classify by Kind too — genConstGroup previously routed
// every member through the integer-only evalConstExpr, so a bool member
// read back as false and a float member read back as its iota index.
// registerImportConstGroup shares classifyConstLit, so the imported-
// group path is covered by the same fix.
func TestGenConstGroupNonIntMembers() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var grp @ast.Decl = make(ast.Decl)
	grp.Kind = ast.DECL_GROUP
	var decls @[]@ast.Decl = make_slice(@ast.Decl, 2)
	decls[0] = mkConstBoolDecl("B", true)
	decls[1] = mkConstFloatDecl("F", "2.5")
	grp.Decls = decls
	genConstGroup(gc, nil, grp)
	if len(m.Consts) != 2 { return fail("expected 2 group entries") }
	if m.Consts[0].Kind != CONST_BOOL { return fail("B should be CONST_BOOL") }
	if !m.Consts[0].BoolVal { return fail("B should be true") }
	if m.Consts[1].Kind != CONST_FLT { return fail("F should be CONST_FLT") }
	if !seq(m.Consts[1].FltText, "2.5") { return fail("F FltText should be 2.5") }
	return ""
}

// mkBareConstDecl builds a bare const-group member (`B` with no value),
// which under iota-repeat inherits the previous member's initializer.
func mkBareConstDecl(name @[]char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Name = name
	return d
}

// Go-style iota-repeat: a bare const-group member repeats the previous
// member's initializer EXPRESSION with its own iota.  `B0 int = 1 << iota`
// with bare B1/B2/B3 yields the bit-flag idiom 1,2,4,8 — not plain iota
// (which gave B0=1, B1=1, B2=2, B3=3).
func TestGenConstGroupIotaRepeat() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var grp @ast.Decl = make(ast.Decl)
	grp.Kind = ast.DECL_GROUP
	var decls @[]@ast.Decl = make_slice(@ast.Decl, 4)
	var shift @ast.Expr = mkBinaryExpr(cast(int, token.SHL), mkIntLitExpr("1"), mkIdentExpr("iota"))
	decls[0] = mkConstExprDecl("B0", shift)
	decls[1] = mkBareConstDecl("B1")
	decls[2] = mkBareConstDecl("B2")
	decls[3] = mkBareConstDecl("B3")
	grp.Decls = decls
	genConstGroup(gc, nil, grp)
	if len(m.Consts) != 4 { return fail("expected 4 group entries") }
	if m.Consts[0].Val != 1 { return fail("B0 should be 1 (1<<0)") }
	if m.Consts[1].Val != 2 { return fail("B1 should be 2 (1<<1, repeated)") }
	if m.Consts[2].Val != 4 { return fail("B2 should be 4 (1<<2)") }
	if m.Consts[3].Val != 8 { return fail("B3 should be 8 (1<<3)") }
	return ""
}

// A named 64-bit const must keep its full value in irsym.ModuleConst.Val (int64):
// with a host-int Val a value >= 2^32 truncated on a 32-bit-int host (e.g. the
// stamped bignumToInt result was cast(int, ...)).  Match by value so const-name
// qualification doesn't matter.  Only bites on a 32-bit-host run (an LP64 host
// int already holds it) — the builder-comp_arm32_linux lane is the guard.
func TestGenNamedConstAbove32BitsNotTruncated() testing.TestResult {
	// WithChecker (not genFromSource, which passes a nil checker): the fix is on
	// the STAMPED path (checker records LitMag -> bignumToInt -> int64 ->
	// EmitConstInt64).  A nil checker would skip the stamp and fall to the
	// unchanged host-int parseIntLit fallback — which truncates on the
	// arm32_linux lane (reddening it) while passing vacuously on LP64.
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"const BIG uint64 = 0x100000001\n"
					"func use() uint64 { return BIG }\n")
	// BIG == 0x100000001 == 2^32 + 1 (built via shifts so the assertion has no
	// bare literal >= 2^31, which would overflow int on ILP32).
	var expected int64 = cast(int64, (cast(uint64, 1) << 32) | cast(uint64, 1))
	var found bool = false
	for i := 0; i < len(m.Consts); i++ {
		if m.Consts[i].Val == expected { found = true }
	}
	if !found {
		return fail("named 64-bit const 0x100000001 truncated (irsym.ModuleConst.Val must be int64)")
	}
	return ""
}
