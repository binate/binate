package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the const producers (genConst / genConstGroup).
// Const-expression evaluation / folding tests live in
// gen_const_fold_test.bn.

// ============================================================
// evalConstExpr — direct coverage of the const-expression
// evaluator.  Pins the cases that pkg/binate/asm/aarch64.bni's
// `D0 int = iota + 32` (and friends) actually need: literal
// ints, bare iota, qualified selectors, and binary arithmetic.
//
// genConstGroup / registerImportConstGroup paths that handle
// only EXPR_INT_LIT and silently fall back to the raw iota
// counter for everything else turn `D0 int = iota + 32` into
// 0, then 1, ..., 31 instead of 32..63.  In a self-hosted bnc
// that resolves FP_SCRATCH_A and FP_SCRATCH_B both to 0
// (`FP_SCRATCH_A int = aarch64.D16` gets iotaVal=0 from the
// non-group path), so emitFloatBinop's two FMOVs target the
// same Dn register and `1.5 + 2.5` computes `2.5 + 2.5 = 5.0`.
// ============================================================

func mkIntLitExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INT_LIT
	e.Name = s
	return e
}

func mkIdentExpr(s @[]char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Name = s
	return e
}

func mkBinaryExpr(op int, x @ast.Expr, y @ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BINARY
	e.Op = op
	e.X = x
	e.Y = y
	return e
}

// emptyExprList returns a freshly-typed nil-value @[]@ast.Expr —
// useful for builtin exprs (sizeof / alignof) that take no Args.
func emptyExprList() @[]@ast.Expr {
	var empty @[]@ast.Expr
	return empty
}

// Named-type expr helper for the sizeof / alignof tests below.
func mkNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

// Builtin-call expr (sizeof / alignof / cast / bit_cast) helper.
func mkBuiltinExpr(op int, typeRef @ast.TypeExpr, args @[]@ast.Expr) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Op = op
	e.TypeRef = typeRef
	e.Args = args
	return e
}

// A bool-typed top-level const must register with Kind == CONST_BOOL and
// the literal value in BoolVal, not fall through to the integer path
// (which lowers to EmitConstInt(0) = false at every read site, ignoring
// the declared value).  Both true and false are checked so a hardcoded
// value would fail.
func TestGenConstBoolLitRegistersKind() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst Enabled bool = true\n"
			"const Disabled bool = false\n")
	if len(m.Consts) != 2 { return fail("expected 2 entries") }
	var e int = constIdx(m, "Enabled")
	var d int = constIdx(m, "Disabled")
	if e < 0 || d < 0 { return fail("expected Enabled and Disabled registered") }
	if m.Consts[e].Kind != CONST_BOOL { return fail("Enabled Kind not CONST_BOOL") }
	if !m.Consts[e].BoolVal { return fail("Enabled BoolVal should be true") }
	if m.Consts[d].Kind != CONST_BOOL { return fail("Disabled Kind not CONST_BOOL") }
	if m.Consts[d].BoolVal { return fail("Disabled BoolVal should be false") }
	return ""
}

// A const whose initializer is a COMPARISON registers as a CONST_BOOL of the
// value the checker folded, not as an int: `1 < 2` → true, `5 > 9` → false.
func TestGenConstComparisonRegistersBool() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst T = 1 < 2\nconst F = 5 > 9\n")
	if len(m.Consts) != 2 { return fail("expected 2 entries") }
	var t int = constIdx(m, "T")
	var f int = constIdx(m, "F")
	if t < 0 || f < 0 { return fail("expected T and F registered") }
	if m.Consts[t].Kind != CONST_BOOL { return fail("T Kind not CONST_BOOL") }
	if !m.Consts[t].BoolVal { return fail("T (1<2) should be true") }
	if m.Consts[f].Kind != CONST_BOOL { return fail("F Kind not CONST_BOOL") }
	if m.Consts[f].BoolVal { return fail("F (5>9) should be false") }
	return ""
}

// A float const-EXPRESSION registers as CONST_EXPR carrying its AST, so
// the read site re-lowers it (the float-const path can't carry a folded
// result as exact text).  `0.5 * 0.5` is a float binary expression, not
// a bare literal, so it does not take the CONST_FLT (literal-text) path.
func TestGenConstFloatExprRegistersExprKind() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst Q = 0.5 * 0.5\n")
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	var q int = constIdx(m, "Q")
	if q < 0 { return fail("expected Q registered") }
	if m.Consts[q].Kind != CONST_EXPR {
		return fail("Q Kind should be CONST_EXPR")
	}
	if m.Consts[q].Expr == nil {
		return fail("Q should stash its initializer expression")
	}
	return ""
}

// A float-typed top-level const registers with Kind == CONST_FLT and the raw
// literal text in FltText, which a read site lowers -- not as an integer.
func TestGenConstFloatLitRegistersKind() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst Pi float64 = 3.5\n")
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	var pi int = constIdx(m, "Pi")
	if pi < 0 { return fail("expected Pi registered") }
	if m.Consts[pi].Kind != CONST_FLT { return fail("Pi Kind not CONST_FLT") }
	if !seq(m.Consts[pi].FltText, "3.5") { return fail("Pi FltText should be raw text 3.5") }
	return ""
}

// A negative float const (`const X = -1.5`) parses as unary minus over
// EXPR_FLOAT_LIT, not a bare float literal; it still registers as CONST_FLT
// with the sign folded into FltText.
func TestGenConstNegativeFloatLitRegistersKind() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst X = -1.5\n")
	if len(m.Consts) != 1 { return fail("expected 1 entry") }
	var x int = constIdx(m, "X")
	if x < 0 { return fail("expected X registered") }
	if m.Consts[x].Kind != CONST_FLT { return fail("neg float Kind not CONST_FLT") }
	if !seq(m.Consts[x].FltText, "-1.5") { return fail("neg float FltText should be -1.5") }
	return ""
}

// Non-int members of a const GROUP (`const ( B bool = true; F float64
// = 2.5 )`) register by their kind too: a bool member as CONST_BOOL with its
// value, a float one as CONST_FLT with its literal text -- not as integers.
func TestGenConstGroupNonIntMembers() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst (\n\tB bool = true\n"
			"\tF float64 = 2.5\n)\n")
	if len(m.Consts) != 2 { return fail("expected 2 group entries") }
	var b int = constIdx(m, "B")
	var f int = constIdx(m, "F")
	if b < 0 || f < 0 { return fail("expected the group's B and F registered") }
	if m.Consts[b].Kind != CONST_BOOL { return fail("B should be CONST_BOOL") }
	if !m.Consts[b].BoolVal { return fail("B should be true") }
	if m.Consts[f].Kind != CONST_FLT { return fail("F should be CONST_FLT") }
	if !seq(m.Consts[f].FltText, "2.5") { return fail("F FltText should be 2.5") }
	return ""
}

// Go-style iota-repeat: a bare const-group member repeats the previous
// member's initializer EXPRESSION with its own iota.  `B0 int = 1 << iota`
// with bare B1/B2/B3 yields the bit-flag idiom 1,2,4,8 — not plain iota
// (which gave B0=1, B1=1, B2=2, B3=3).
func TestGenConstGroupIotaRepeat() testing.TestResult {
	var m @ir.Module = genFromSourcePkg("package \"test\"\nconst (\n\tB0 int = 1 << iota\n"
			"\tB1\n\tB2\n\tB3\n)\n")
	if len(m.Consts) != 4 { return fail("expected 4 group entries") }
	if constVal(m, "B0") != 1 { return fail("B0 should be 1 (1<<0)") }
	if constVal(m, "B1") != 2 { return fail("B1 should be 2 (1<<1, repeated)") }
	if constVal(m, "B2") != 4 { return fail("B2 should be 4 (1<<2)") }
	if constVal(m, "B3") != 8 { return fail("B3 should be 8 (1<<3)") }
	return ""
}

// A named 64-bit const must keep its full value in irsym.ModuleConst.Val (int64):
// with a host-int Val a value >= 2^32 truncates on a 32-bit-int host (e.g. when
// the stamped bignumToInt result goes through cast(int, ...)).  Match by value so const-name
// qualification doesn't matter.  Only bites on a 32-bit-host run (an LP64 host
// int already holds it) — the builder-comp_arm32_linux lane is the guard.
func TestGenNamedConstAbove32BitsNotTruncated() testing.TestResult {
	// The case under test is the STAMPED path (checker records LitMag ->
	// bignumToInt -> int64 -> EmitConstInt64).
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"const BIG uint64 = 0x100000001\n"
					"func use() uint64 { return BIG }\n")
	// BIG == 0x100000001 == 2^32 + 1 (built via shifts so the assertion has no
	// bare literal >= 2^31, which would overflow int on ILP32).
	var expected int64 = cast(int64, (cast(uint64, 1) << 32) | cast(uint64, 1))
	var found bool = false
	for i := 0; i < len(m.Consts); i++ {
		if m.Consts[i].Val == expected { found = true }
	}
	if !found {
		return fail("named 64-bit const 0x100000001 truncated (irsym.ModuleConst.Val must be int64)")
	}
	return ""
}

// constIdx returns the index in m.Consts of the constant registered under name
// (with or without its package qualifier), or -1 when none is.
func constIdx(m @ir.Module, name *[]readonly char) int {
	for i := 0; i < len(m.Consts); i++ {
		var n @[]char = m.Consts[i].Name
		if len(n) >= len(name) && seq(n[len(n) - len(name):], name) &&
				(len(n) == len(name) || n[len(n) - len(name) - 1] == '.') {
			return i
		}
	}
	return -1
}

// constKind returns the Kind of the constant registered under name (constIdx), or
// -1 when none is.
func constKind(m @ir.Module, name *[]readonly char) int {
	var i int = constIdx(m, name)
	if i < 0 { return -1 }
	return m.Consts[i].Kind
}

// constVal returns the integer value (Val) of the constant registered under name
// (constIdx), or -1 when none is.
func constVal(m @ir.Module, name *[]readonly char) int64 {
	var i int = constIdx(m, name)
	if i < 0 { return -1 }
	return m.Consts[i].Val
}

// A constant computed through a float value -- a conversion of a float constant
// to an integer type, a bit_cast of one, a float expression over a constant
// declared later in the file, or a bool or int constant over another such
// constant -- is one the checker accepts without folding, and is stashed as
// CONST_EXPR for its uses to re-lower rather than left unregistered.
func TestGenConstThroughFloatRegistersExprKind() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"const G float64 = H + H\n"
					"const H = cast(float64, 1)\n"
					"const F float64 = 2.75\n"
					"const I int = cast(int, F)\n"
					"const B uint64 = bit_cast(uint64, cast(float64, 1))\n"
					"const L bool = !K\n"
					"const K bool = 1.5 < 2.5\n"
					"const J int = I + 1\n"
					"func use() int { return I }\n")
	if constKind(m, "G") != CONST_EXPR { return fail("G should be CONST_EXPR") }
	if constKind(m, "I") != CONST_EXPR { return fail("I should be CONST_EXPR") }
	if constKind(m, "B") != CONST_EXPR { return fail("B should be CONST_EXPR") }
	if constKind(m, "L") != CONST_EXPR { return fail("L should be CONST_EXPR") }
	if constKind(m, "K") != CONST_EXPR { return fail("K should be CONST_EXPR") }
	if constKind(m, "J") != CONST_EXPR { return fail("J should be CONST_EXPR") }
	return ""
}
