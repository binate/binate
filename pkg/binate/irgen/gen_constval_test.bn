package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/constval"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_constval.bn: IR-gen's constant evaluation through constval,
// and the values it records in Module.Consts.

// evalIntIR evaluates e at iota iotaVal as an integer constant: (value, true),
// or (0, false) when it is not one.
func evalIntIR(gc @GenCtx, e @ast.Expr, iotaVal int) (int, bool) {
	var v constval.Value
	var st int
	var at @ast.Expr
	v, st, at = evalConstIR(gc, e, iotaVal, true)
	_ = at
	if st != constval.OK || v.IsBool {
		return 0, false
	}
	return cast(int, v.N.ToInt64()), true
}

// evalBoolIR evaluates e as a boolean constant: (value, true), or (false,
// false) when it is not one.
func evalBoolIR(gc @GenCtx, e @ast.Expr, iotaVal int) (bool, bool) {
	var v constval.Value
	var st int
	var at @ast.Expr
	v, st, at = evalConstIR(gc, e, iotaVal, true)
	_ = at
	if st != constval.OK || !v.IsBool {
		return false, false
	}
	return v.B, true
}

// A typed constant in Module.Consts is evaluated at its type: U8 (uint8 200)
// + 100 wraps to 44, as the checker computes it.
func TestEvalConstIRTypedWraps() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mc irsym.ModuleConst
	mc.Name = "U8"
	mc.Typ = types.TypUint8()
	var v constval.Value
	v.N = bignum.FromInt(200)
	setModuleConstValue(&mc, v)
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, mc)
	var r int
	var ok bool
	r, ok = evalIntIR(gc, mkBinaryExpr(cast(int, token.PLUS), mkIdentExpr("U8"), mkIntLitExpr("100")),
			0)
	if !ok || r != 44 {
		return fail("U8 + 100 (U8 uint8 200) should wrap to 44")
	}
	return ""
}

// An untyped constant of 2^64-1 keeps its exact value (CVal), which its 64-bit
// pattern (Val, -1) cannot tell from -1: BIG >> 60 is 15, not -1.
func TestEvalConstIRUntypedExact() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var mc irsym.ModuleConst
	mc.Name = "BIG"
	var v constval.Value
	v.N = bignum.FromUint64(cast(uint64, 0) - 1)
	setModuleConstValue(&mc, v)
	if mc.Val != -1 || mc.Typ != types.TypUint64() {
		return fail("BIG's pattern should be -1, materialized as uint64")
	}
	m.Consts = slices.Append[irsym.ModuleConst](m.Consts, mc)
	var r int
	var ok bool
	r, ok = evalIntIR(gc, mkBinaryExpr(cast(int, token.SHR), mkIdentExpr("BIG"), mkIntLitExpr("60")),
			0)
	if !ok || r != 15 {
		return fail("BIG >> 60 (BIG = 2^64-1) should be 15")
	}
	return ""
}

// lookupConst returns the registered constant `name`'s value pattern and type,
// and whether it is registered.
func lookupConst(gc @GenCtx, name *[]readonly char) (int, @types.Type, bool) {
	var i int = findModuleConst(gc, name)
	if i < 0 {
		return 0, nil, false
	}
	return cast(int, gc.Mod.Consts[i].Val), gc.Mod.Consts[i].Typ, true
}

// lookupBareConst is lookupConst for an unqualified name (findBareModuleConst).
func lookupBareConst(gc @GenCtx, name *[]readonly char) (int, @types.Type, bool) {
	var i int = findBareModuleConst(gc, name)
	if i < 0 {
		return 0, nil, false
	}
	return cast(int, gc.Mod.Consts[i].Val), gc.Mod.Consts[i].Typ, true
}
