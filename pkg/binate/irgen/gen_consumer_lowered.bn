package "pkg/binate/irgen"

import "pkg/binate/ast"

// A consumer of a package lowers some of that package's code itself: a generic
// declaration's body is monomorphized at the consumer, and a floating-point
// constant expression is stored as its initializer and re-lowered at each use
// (CONST_EXPR).  That code names the package's OWN imports, which the consumer
// may not import, so the drivers register those imports' signatures, constants
// and variables for it (RegisterGenericBodyDeps) when ReLoweredAtConsumer says so.

// ReLoweredAtConsumer reports whether a consumer of the package whose merged file
// is f and whose interface file is bni (nil if it has none) lowers some of the
// package's declarations itself in a way that can name its imports: f declares a
// generic (in a group too), or an interface constant (bni's, else f's), which a
// consumer re-lowers, names another package in its initializer.  An interface
// constant's initializer names only the interface's own constants and other
// packages' (pkg.bni.self-contained), so the interface's constants are all
// there is to look at.  A type named there needs nothing (every loaded
// package's types are registered); a constant the checker folds is never
// re-lowered, so this over-approximates, at the cost of some extra registration.
func ReLoweredAtConsumer(f @ast.File, bni @ast.File) bool {
	if f == nil { return false }
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if len(d.TypeParams) > 0 { return true }
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				if len(d.Decls[j].TypeParams) > 0 { return true }
			}
		}
	}
	var surface @ast.File = bni
	if surface == nil { surface = f }
	return constNamesPackage(surface.Decls)
}

// constNamesPackage reports whether decls hold a constant — a group's member too
// — whose initializer names another package.  A bare group member repeats an
// earlier member's initializer, which is checked as that member's.
func constNamesPackage(decls *[]@ast.Decl) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_CONST && exprNamesPackage(d.Value) { return true }
		if d.Kind == ast.DECL_GROUP && constNamesPackage(d.Decls) { return true }
	}
	return false
}

// exprNamesPackage reports whether e names another package's member: a selector
// on an identifier (`p.X` — or a field read off a local, which a constant
// initializer cannot hold).
func exprNamesPackage(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT { return true }
	if exprNamesPackage(e.X) || exprNamesPackage(e.Y) || exprNamesPackage(e.Z) { return true }
	for i := 0; i < len(e.Args); i++ {
		if exprNamesPackage(e.Args[i]) { return true }
	}
	return false
}
