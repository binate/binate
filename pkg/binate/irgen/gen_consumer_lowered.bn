package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/irutil"
import "pkg/std/vec"

// A consumer of a package lowers some of that package's code itself: a generic
// declaration's body is monomorphized at the consumer, and a floating-point
// constant expression is stored as its initializer and re-lowered at each use
// (CONST_EXPR).  That code names the package's OWN imports, which the consumer
// may not import, so the drivers register those imports' signatures, constants
// and variables for it (RegisterGenericBodyDeps) when ReLoweredAtConsumer says so.

// ReLoweredAtConsumer reports whether a consumer of the package whose merged file
// is f and whose interface file is bni (nil if it has none) lowers some of the
// package's declarations itself in a way that can name its imports: f declares a
// generic (in a group too), or a constant a consumer can re-lower names another
// package in its initializer.  A consumer re-lowers an interface constant (bni's,
// else f's) and, as an initializer may name a sibling constant of the package
// (pkg.bni.const), every constant of f one of those names, transitively — not
// another (a generic body reaching one flags the file anyway).  A type named
// there needs nothing (every loaded package's types are registered); a constant
// the checker folds is never re-lowered, so this over-approximates, at the cost
// of some extra registration.
func ReLoweredAtConsumer(f @ast.File, bni @ast.File) bool {
	if f == nil { return false }
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if len(d.TypeParams) > 0 { return true }
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				if len(d.Decls[j].TypeParams) > 0 { return true }
			}
		}
	}
	var surface @ast.File = bni
	if surface == nil { surface = f }
	var all @vec.Vec[constInit] = vec.New[constInit]()
	collectConstInits(f.Decls, all)
	var reach @vec.Vec[constInit] = vec.New[constInit]()
	collectConstInits(surface.Decls, reach)
	for k := 0; k < reach.Len(); k++ {
		var ci constInit = reach.Get(k)
		if exprNamesPackage(ci.Value) { return true }
		addNamedConsts(ci.Value, all, reach)
	}
	return false
}

// constInit is a constant's name and its effective initializer: for a bare
// member of a group, the previous explicit member's, which it repeats
// (decl.const) and which IR-gen re-lowers for it.
type constInit struct {
	Name  @[]char
	Value @ast.Expr
}

// collectConstInits appends the constants of decls — a group's members too —
// with their effective initializers to out.
func collectConstInits(decls *[]@ast.Decl, out @vec.Vec[constInit]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_CONST {
			var ci constInit
			ci.Name = d.Name
			ci.Value = d.Value
			out.Push(ci)
		}
		if d.Kind == ast.DECL_GROUP {
			var prev @ast.Expr
			for j := 0; j < len(d.Decls); j++ {
				var m @ast.Decl = d.Decls[j]
				if m.Kind != ast.DECL_CONST { continue }
				if m.Value != nil { prev = m.Value }
				var ci constInit
				ci.Name = m.Name
				ci.Value = prev
				out.Push(ci)
			}
		}
	}
}

// addNamedConsts appends to reach each constant of all that e names by a bare
// name and reach does not hold yet.
func addNamedConsts(e @ast.Expr, all @vec.Vec[constInit], reach @vec.Vec[constInit]) {
	if e == nil { return }
	if e.Kind == ast.EXPR_IDENT {
		for i := 0; i < all.Len(); i++ {
			var ci constInit = all.Get(i)
			if irutil.Streq(ci.Name, e.Name) && !constNamed(reach, ci.Name) { reach.Push(ci) }
		}
		return
	}
	addNamedConsts(e.X, all, reach)
	addNamedConsts(e.Y, all, reach)
	addNamedConsts(e.Z, all, reach)
	for i := 0; i < len(e.Args); i++ {
		addNamedConsts(e.Args[i], all, reach)
	}
}

// constNamed reports whether cs holds a constant named name.
func constNamed(cs @vec.Vec[constInit], name *[]readonly char) bool {
	for i := 0; i < cs.Len(); i++ {
		if irutil.Streq(cs.Get(i).Name, name) { return true }
	}
	return false
}

// exprNamesPackage reports whether e names another package's member: a selector
// on an identifier (`p.X` — or a field read off a local, which a constant
// initializer cannot hold).
func exprNamesPackage(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT { return true }
	if exprNamesPackage(e.X) || exprNamesPackage(e.Y) || exprNamesPackage(e.Z) { return true }
	for i := 0; i < len(e.Args); i++ {
		if exprNamesPackage(e.Args[i]) { return true }
	}
	return false
}
