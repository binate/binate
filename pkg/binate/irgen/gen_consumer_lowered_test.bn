package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_consumer_lowered.bn.

// parseIfaceFile parses src as a .bni interface file.
func parseIfaceFile(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "t.bni")
	return p.ParseFile()
}

// A package is lowered at its consumer when its file declares a generic, or its
// interface a constant whose initializer names another package — directly or in
// a group — and not for one naming only a type, nor for a constant that only its
// .bn names a package in (no consumer can name it).
func TestReLoweredAtConsumer() testing.TestResult {
	var none @ast.File
	if !ReLoweredAtConsumer(parseIfaceFile("package \"p\"\nfunc F[T any](x T) T { return x }\n"),
			none) {
		return fail("a generic function should be lowered at the consumer")
	}
	var c @ast.File = parseIfaceFile("package \"p\"\nimport \"pkg/a\"\nconst X float64 = a.A * 2.0\n")
	if !ReLoweredAtConsumer(c, c) {
		return fail("an interface constant naming an import should be lowered at the consumer")
	}
	var g @ast.File = parseIfaceFile(
			"package \"p\"\nimport \"pkg/a\"\nconst ( Y = 1; Z float64 = -a.A )\n")
	if !ReLoweredAtConsumer(g, g) {
		return fail("a grouped interface constant naming an import should be lowered at the consumer")
	}
	var t @ast.File = parseIfaceFile(
			"package \"p\"\nimport \"pkg/a\"\nconst M a.T = cast(a.T, 7) * 1.5\n")
	if ReLoweredAtConsumer(t, t) {
		return fail("a constant naming only an import's type needs nothing registered")
	}
	var bni @ast.File = parseIfaceFile("package \"p\"\nfunc G() int\n")
	if ReLoweredAtConsumer(c, bni) {
		return fail("a constant outside the interface should not count")
	}
	var plain @ast.File = parseIfaceFile(
			"package \"p\"\nconst K = 1 << 3\nconst F float64 = 2.5 * 2.0\nfunc G() int\n")
	if ReLoweredAtConsumer(plain, plain) {
		return fail("a file of local constants and plain functions should not be")
	}
	if !ReLoweredAtConsumer(c, none) {
		return fail("with no interface file, the merged file's constants should count")
	}
	var siblingBni @ast.File = parseIfaceFile("package \"p\"\nconst X float64 = y * 2.0\n")
	var sibling @ast.File = parseIfaceFile(
			"package \"p\"\nimport \"pkg/a\"\nconst X float64 = y * 2.0\nconst y float64 = z + 0.5\n"
					"const z float64 = a.A\n")
	if !ReLoweredAtConsumer(sibling, siblingBni) {
		return fail("an interface constant naming a sibling that names an import should count")
	}
	var unreached @ast.File = parseIfaceFile(
			"package \"p\"\nimport \"pkg/a\"\nconst X float64 = y * 2.0\nconst y float64 = 0.5\n"
					"const w float64 = a.A\n")
	if ReLoweredAtConsumer(unreached, siblingBni) {
		return fail("a constant no interface constant reaches should not count")
	}
	var bareBni @ast.File = parseIfaceFile("package \"p\"\nconst X float64 = b * 2.0\n")
	var bare @ast.File = parseIfaceFile(
			"package \"p\"\nimport \"pkg/a\"\nconst X float64 = b * 2.0\n"
					"const ( c float64 = a.A + 0.25; b )\n")
	if !ReLoweredAtConsumer(bare, bareBni) {
		return fail("a bare group member repeating an initializer naming an import should count")
	}
	var grouped @ast.File = parseIfaceFile(
			"package \"p\"\ntype ( Box[T any] struct { v T }; Unit int )\n")
	if !ReLoweredAtConsumer(grouped, none) {
		return fail("a generic type declared in a group should be lowered at the consumer")
	}
	return ""
}
