package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// emitArrayElemStore stores `rhs` through `elemPtr` (a pointer to an array
// element of type `elemTyp`), applying the same string-literal conversion,
// struct-alloca load, and managed acquire-before-release discipline as a
// direct `a[i] = rhs`.  Shared by the IDENT/SELECTOR array arm and the
// nested-array arm of genAssign.
func emitArrayElemStore(ctx @GenContext, b @ir.Block, elemPtr @ir.Instr, rhs @ir.Instr,
		elemTyp @types.Type) @ir.Block {
	rhs = nilForSlot(b, rhs, elemTyp)
	rhs = materializeStringLit(ctx, b, rhs, elemTyp)
	// A struct/array-alloca RHS stored into a value slot of that same
	// aggregate kind is loaded to a value first; a pointer slot takes the
	// alloca pointer directly.  Covers inner-array elements too, so a whole-
	// inner-array store `a[i] = [M]T{...}` copies the array value, not the
	// alloca pointer.
	if isAggregateAllocToLoad(rhs, elemTyp) {
		rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
	}
	rhs = decayManagedToRaw(b, rhs, elemTyp)
	// Managed element / struct-with-managed-fields: acquire-before-release
	// store via the shared dispatcher (so a self-alias `a[i] = a[i]` can't
	// RefDec the value to zero before RefInc'ing it back).
	if irutil.IsManagedScalarType(elemTyp) || needsStructCopy(elemTyp) {
		return emitStoreManagedSlot(ctx, b, elemPtr, rhs, elemTyp, false)
	}
	rhs = ensureWidth(ctx, b, rhs, elemTyp)
	irbuild.EmitStore(b, elemPtr, rhs)
	return b
}

// isCompoundAssign reports whether `stmt` is a compound assignment
// (`a += b`, `a *= b`, …) rather than a plain `a = b`.
func isCompoundAssign(stmt @ast.Stmt) bool {
	return stmt.Op != 0 && stmt.Op != cast(int, token.ASSIGN)
}

// emitCompoundBinop returns `cur OP rhs` for the compound assignment
// `stmt` (`a OP= b`), emitting the divide-fault guard for `/=` / `%=`
// first.  `cur` is the current value of the lvalue, loaded by the caller
// however that lvalue form requires (a slot load, or EmitSliceGet for a
// slice element); `typ` is the lvalue's type.  Every lvalue arm of
// genAssign must route a compound assignment through this — applying it
// only in the IDENT arm silently dropped the operator for `a[i] += x`,
// `p.f += x`, `*p += x`, etc., storing the bare RHS.
func emitCompoundBinop(ctx @GenContext, b @ir.Block, stmt @ast.Stmt, cur @ir.Instr, rhs @ir.Instr,
		typ @types.Type) @ir.Instr {
	var op int = compoundToIROp(stmt.Op)
	// The result must be produced at the lvalue type `typ`.  `cur` is loaded
	// at `typ` already, but `rhs` can arrive at a different width — only the
	// IDENT lvalue arm width-coerces it before calling here, so a sub-word
	// element/field/deref target keeps an untyped-int count at int64 (e.g.
	// `a[0] <<= 40`).  Match both operands to `typ`, mirroring genBinaryExpr's
	// ensureWidth, so neither the emitted op nor the overshift guard's icmp
	// below mixes widths (a width-mismatched icmp/shl is invalid IR).
	var shiftInrange @ir.Instr = nil
	if typ != nil {
		cur = ensureWidth(ctx, b, cur, typ)
		// A constant count >= the value width must be caught before the rhs
		// ensureWidth truncates it into range (`a[0] uint8 <<= 256` -> 0, not
		// the masked no-op) — mirrors genBinaryExpr; see emitConstOvershiftOrNil.
		var constOvershift @ir.Instr = emitConstOvershiftOrNil(b, op, cur, rhs, typ)
		if constOvershift != nil {
			return constOvershift
		}
		// Likewise compute the RUNTIME overshift predicate from the original,
		// pre-ensureWidth count so a wider count's high bits aren't truncated
		// away before the guard — see emitShiftInrangeOrNil.
		shiftInrange = emitShiftInrangeOrNil(b, op, rhs, typ)
		// Negative-shift-count guard on the original (pre-ensureWidth) count —
		// see emitShiftCheckGuard.
		emitShiftCheckGuard(ctx, b, op, rhs, shiftInrange)
		rhs = ensureWidth(ctx, b, rhs, typ)
	}
	// A compound shift-assign must honor the overshift spec (0 for a logical
	// `<<=` / `>>=`, sign-fill for an arithmetic `>>=`) just like the
	// expression form in genBinaryExpr; routing through emitGuardedShift is
	// what makes `var y uint32 = 1; y <<= 40` yield 0 rather than the
	// hardware-masked `1 << (40 & 31)` = 256.  An in-range constant count
	// can't overshift, so it falls through to the plain EmitBinop fast path.
	if op == iropcode.OP_SHL || op == iropcode.OP_SHR {
		if shiftInrange != nil {
			return emitGuardedShift(b, op, cur, rhs, typ, shiftInrange)
		}
	}
	emitDivCheckGuard(ctx, b, op, cur, rhs, typ)
	return irbuild.EmitBinop(b, op, cur, rhs, typ)
}

// genAssign generates IR for assignment statements (single, multi, index, selector, deref LHS).
func genAssign(ctx @GenContext, b @ir.Block, stmt @ast.Stmt) @ir.Block {
	// Multi-assign: q, r = call(...)
	if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == 1 {
		return genMultiAssign(ctx, b, stmt)
	}
	// Parallel assign: a, b = e1, e2 (incl. the swap a, b = b, a).  Matched
	// arity (>1 each); the checker rejects unequal multi-expression counts.
	if len(stmt.Exprs) > 1 && len(stmt.Exprs2) == len(stmt.Exprs) {
		return genParallelAssign(ctx, b, stmt)
	}
	if len(stmt.Exprs) == 1 && len(stmt.Exprs2) == 1 {
		var lhs @ast.Expr = stmt.Exprs[0]
		if isBlankTarget(lhs) {
			genForEffect(ctx, b, stmt.Exprs2[0])
			return ctx.CurBlock
		}
		var rhs @ir.Instr = genExprOrFuncRef(ctx, b, stmt.Exprs2[0], assignHintType(ctx, lhs))
		b = ctx.CurBlock
		if lhs.Kind == ast.EXPR_IDENT {
			var ptr @ir.Instr = lookupVar(ctx, lhs.Name)
			if ptr != nil {
				// Ensure value width matches variable type
				var varTyp @types.Type = lookupVarType(ctx, lhs.Name)
				// Peel transparent wrappers for the slice classifications below: a
				// named-distinct slice var (`type Str *[]readonly char`) is TYP_NAMED,
				// so an un-peeled isCharSliceType / Kind gate skips the string-literal
				// / managed->raw coercion and stores garbage.
				var pvarTyp @types.Type = types.StripWrappers(varTyp)
				// A string literal assigned to a char-slice or char-array variable.
				rhs = materializeStringLit(ctx, b, rhs, pvarTyp)
				// For a COMPOUND assignment the operand is reconciled to the
				// lvalue width inside emitCompoundBinop — and only AFTER the
				// shift overshift / negative-count guards have read the count at
				// its own width.  Pre-truncating it here would feed those guards
				// a narrowed residue (a uint16 count 261 -> uint8 5), so a wide
				// count's overshift / negative-ness would be mis-read as in-range
				// (the other compound lvalue arms already pass the raw operand).
				// So coerce here only for a plain `=` assignment.
				if varTyp != nil && !isCompoundAssign(stmt) {
					rhs = ensureWidth(ctx, b, rhs, varTyp)
				}
				// Compound assignment (+=, -=, etc.)
				if isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, ptr, varTyp), rhs, varTyp)
				}
				// @[]T → *[]T conversion
				// (the temp stays in cleanup — RefDec at end of statement)
				rhs = decayManagedToRaw(b, rhs, pvarTyp)
				// A struct/array composite literal (or aggregate temp) arrives as
				// an OP_ALLOC pointer to its data; load the aggregate VALUE so the
				// store copies the contents, not the pointer (else `a = [N]T{...}`
				// / `a = other` stores the pointer and the slot keeps its old
				// contents).  Gate on the DESTINATION being that aggregate, like
				// the index arms: `&aggregateGlobal` also presents as an
				// OP_ALLOC-shaped (IsGlobalRef) rhs, but a pointer destination
				// (`var p *T = &g`, `p = &g`) must store the address as-is — the
				// dest-type-blind isStructOrArrayAlloc would load its first word
				// and store 0.
				if isAggregateAllocToLoad(rhs, varTyp) {
					rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
				}
				// Axiom 5: assignment = copy-then-destroy, centralized in the
				// shared dispatcher (acquire the new value before releasing the
				// old occupant; a nil / non-managed varTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, ptr, rhs, varTyp, false)
			}
		} else if lhs.Kind == ast.EXPR_UNARY && lhs.Op == cast(int, token.STAR) {
			// *p = val: store through dereferenced pointer
			var ptrVal @ir.Instr = genExpr(ctx, b, lhs.X)
			// Re-sync: a type-assertion pointer operand (`*(x.(*T)) = v`) splits the
			// block inside genExpr (the assert's MISS-abort branch), so the store below
			// must land in the HIT continuation — else it (and every following
			// statement) is stranded after a terminator.  A no-op for non-splitting
			// operands.
			b = ctx.CurBlock
			// Peel transparent wrappers (named-distinct / alias / readonly) and
			// accept a managed pointer too: a named pointer (`type P *T`) is
			// TYP_NAMED, so an un-peeled `== TYP_POINTER` check left derefTyp nil and
			// `*p = <aggregate>` mislowered (the aggregate-load and managed-aware
			// store below both key off derefTyp) — a silent miscompile.
			var derefTyp @types.Type = nil
			var pk @types.Type = nil
			if ptrVal.Typ != nil { pk = types.StripWrappers(ptrVal.Typ) }
			if pk != nil && (pk.Kind == types.TYP_POINTER || pk.Kind == types.TYP_MANAGED_PTR) {
				derefTyp = pk.Elem
			}
			// For a plain `=`, coerce the RHS to the pointee width — an untyped
			// literal or wider value must not be stored at its OWN width through
			// the pointer (`*pUint8 = 99` otherwise emits a 4-byte word store,
			// clobbering 3 neighbor bytes and Data-Aborting on strict-alignment
			// targets, e.g. arm32 bare-metal).  Mirrors the IDENT / SELECTOR arms'
			// ensureWidth.  Guarded on `!isCompoundAssign` like the IDENT arm: a
			// compound `*p <<= count` reconciles to derefTyp inside
			// emitCompoundBinop below, and pre-truncating the count here would feed
			// its overshift / negative-count guards a narrowed residue.
			if derefTyp != nil && !isCompoundAssign(stmt) {
				// A string literal stored through a char-slice / char-array pointer.
				rhs = materializeStringLit(ctx, b, rhs, derefTyp)
				rhs = decayManagedToRaw(b, rhs, derefTyp)
				rhs = ensureWidth(ctx, b, rhs, derefTyp)
			}
			// Compound `*p += x`: read-modify-write through the pointer.
			if derefTyp != nil && isCompoundAssign(stmt) {
				rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, ptrVal, derefTyp), rhs, derefTyp)
			}
			// Aggregate composite-literal/temp RHS arrives as an OP_ALLOC
			// pointer; load the value so the store copies contents.  Gated on the
			// deref'd destination being that aggregate (see the ident arm above).
			if isAggregateAllocToLoad(rhs, derefTyp) {
				rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
			}
			// Axiom 5: deref assignment = copy-then-destroy, via the shared
			// dispatcher (a nil / non-managed derefTyp falls through to a
			// plain store).
			b = emitStoreManagedSlot(ctx, b, ptrVal, rhs, derefTyp, false)
		} else if lhs.Kind == ast.EXPR_SELECTOR {
			// p.x = val: store through field pointer
			var fieldPtr @ir.Instr = genSelectorPtr(ctx, b, lhs, true)
			// Re-sync: a type-assertion base (`x.(*T).field = v`) splits the block
			// inside genSelectorPtr (the assert's MISS-abort branch), leaving the
			// recovered field pointer in the HIT continuation; the store below must
			// land there, not in the stale pre-branch block (else it is emitted after
			// a terminator and silently dropped).  A no-op for non-splitting bases.
			b = ctx.CurBlock
			if fieldPtr != nil {
				var fieldTyp @types.Type = fieldTargetType(ctx, lhs, fieldPtr)
				// Peel transparent wrappers for the slice classifications below (see
				// the ident arm): a named-distinct slice FIELD is TYP_NAMED, so an
				// un-peeled gate skips the string / managed->raw coercion and
				// stores garbage.
				var pfieldTyp @types.Type = types.StripWrappers(fieldTyp)
				// If RHS is a struct/array alloca, load the value before storing —
				// dest-type-gated so `p.f = &aggregateGlobal` (a pointer field)
				// stores the address, not its loaded first word (see the ident
				// arm above).
				if isAggregateAllocToLoad(rhs, fieldTyp) {
					rhs = irbuild.EmitLoad(b, rhs, rhs.TypeArg)
				}
				// A string literal assigned to a char-slice or char-array field.
				rhs = materializeStringLit(ctx, b, rhs, pfieldTyp)
				// @[]T → *[]T conversion for raw slice field
				// (the temp stays in cleanup — RefDec at end of statement)
				rhs = decayManagedToRaw(b, rhs, pfieldTyp)
				// Compound `p.f += x`: read-modify-write through the field
				// pointer.
				if fieldTyp != nil && isCompoundAssign(stmt) {
					rhs = emitCompoundBinop(ctx, b, stmt, irbuild.EmitLoad(b, fieldPtr, fieldTyp), rhs, fieldTyp)
				}
				// Width-adjust a non-managed field value (a no-op for the
				// managed kinds) before the store; emitStoreManagedSlot stores
				// the value as-is.
				if fieldTyp != nil {
					rhs = ensureWidth(ctx, b, rhs, fieldTyp)
				}
				// Axiom 5: field assignment = copy-then-destroy, via the shared
				// dispatcher (a nil / non-managed fieldTyp falls through to a
				// plain store).
				b = emitStoreManagedSlot(ctx, b, fieldPtr, rhs, fieldTyp, false)
			} else {
				// The checker accepted the target, so a field it cannot address is
				// an IR-gen gap; storing nothing would silently drop the assignment.
				panic("internal error: selector assignment target with no address in IR-gen (compiler bug)")
			}
		} else if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			return genIndexAssign(ctx, b, stmt, lhs, rhs)
		}
	}
	return b
}
