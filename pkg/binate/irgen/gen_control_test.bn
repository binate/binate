package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

func TestGenCompoundAssign() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() {")
	cb.Write(" var x int = 10; x += 5; _ = x }\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var addCount int = 0
	var storeCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_ADD { addCount = addCount + 1 }
		if entry.Instrs[i].Op == iropcode.OP_STORE { storeCount = storeCount + 1 }
	}
	if storeCount < 2 {
		return fail(buf.Concat(
				"expected >=2 stores, got ", strconv.Itoa(storeCount)))
	}
	if addCount < 1 { return fail("expected at least 1 add for compound assign") }
	return ""
}

// Phase 3.2: read-only string→slice assignments lower to OP_RODATA_SLICE
// (raw target) or OP_RODATA_MSLICE (managed target), not OP_STRING_TO_CHARS.
func TestAssignStringToChars() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func foo() *[]readonly char {\n")
	cb.Write("\tvar s *[]readonly char\n\ts = \"hello\"\n")
	cb.Write("\treturn s\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @ir.Func = m.Funcs[0]
	var found bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_RODATA_SLICE {
				found = true
			}
		}
	}
	if !found {
		return fail(
				"no iropcode.OP_RODATA_SLICE found for string-to-*[]readonly char")
	}
	return ""
}

func TestNilToSliceAssign() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc foo() {\n\tvar s *[]int\n\ts = nil\n}\n"
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @ir.Func = m.Funcs[0]
	var foundSliceNil bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_STORE && len(instr.Args) >= 2 {
				if instr.Args[1].Op == iropcode.OP_CONST_NIL && instr.Args[1].Typ != nil {
					if instr.Args[1].Typ.Kind == types.TYP_SLICE {
						foundSliceNil = true
					}
				}
			}
		}
	}
	if !foundSliceNil {
		return fail(
				"nil assigned to slice should re-emit as TYP_SLICE")
	}
	return ""
}

func TestManagedPtrDeclNilInit() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nimport \"pkg/binate/ast\"\n")
	cb.Write("func foo() {\n")
	cb.Write("\tvar d @ast.Decl\n\td = nil\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSourcePkg(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @ir.Func = m.Funcs[0]
	var foundNilStore bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_STORE && len(instr.Args) >= 2 {
				if instr.Args[1].Op == iropcode.OP_CONST_NIL {
					foundNilStore = true
				}
			}
		}
	}
	if !foundNilStore {
		return fail(
				"managed ptr decl should init with nil store")
	}
	return ""
}

// A deref-store `*p = <untyped literal>` must coerce the RHS to the POINTEE
// width, not store it at the literal's default `int` width — else a wide store
// clobbers neighbor bytes and (on strict-alignment / no-exception-vector targets
// like native arm32 bare-metal) Data-Aborts into a hang (599_addr_of_slice_elem).
// The IDENT and SELECTOR assign arms already ensureWidth; this pins the STAR arm.
// uint8 / uint16 pointees are fixed-width, so the assertion is target-independent.
func TestDerefStoreCoercesRhsToPointeeWidth() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func f(p *uint8, q *uint16) {\n")
	cb.Write("\t*p = 99\n")
	cb.Write("\t*q = 99\n")
	cb.Write("}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSource(src)
	var fn @ir.Func = findFunc(m, "f")
	var byteStores int = 0
	var halfStores int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_STORE && len(instr.Args) >= 2 && instr.Args[1].Typ != nil {
				var sz int = instr.Args[1].Typ.SizeOf()
				if sz == 1 { byteStores = byteStores + 1 }
				if sz == 2 { halfStores = halfStores + 1 }
			}
		}
	}
	if byteStores < 1 {
		return fail("*p = 99 (p *uint8) must store a 1-byte value, not a wide int")
	}
	if halfStores < 1 {
		return fail("*q = 99 (q *uint16) must store a 2-byte value, not a wide int")
	}
	return ""
}

// hasStructLoad reports whether `fn` emits any OP_LOAD whose result is a struct
// value (used to tell an aggregate VALUE copy from a pointer/address store).  An
// OP_LOAD carries its result type in `Typ` (TypeArg is the alloca element type,
// set only on OP_ALLOC), so this inspects `Typ`.
func hasStructLoad(fn @ir.Func) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_LOAD && ins.Typ != nil && ins.Typ.Kind == types.TYP_STRUCT {
				return true
			}
		}
	}
	return false
}

// `RP = &VS` (assign the address of a struct GLOBAL to a pointer var) must store
// the address, NOT load the struct value out of the IsGlobalRef.  The
// dest-type-blind isStructOrArrayAlloc(rhs) gate loaded the struct's first word
// (null) and stored that; the dest-type-aware isAggregateAllocToLoad(rhs, varTyp)
// gate sees a pointer destination and stores the address as-is.
func TestAssignAddrOfStructGlobalStoresAddress() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"var VS Node\n"
					"var RP *Node\n"
					"func put() { RP = &VS }\n")
	var fn @ir.Func = funcByName(m, "put")
	if fn == nil { return fail("put not found in module") }
	if hasStructLoad(fn) {
		return fail("RP = &VS must store the address, not load the struct value")
	}
	return ""
}

// Control for the fix above: `x = VS` (whole-struct copy FROM a global) has an
// aggregate destination, so it MUST still load the struct value.  Guards against
// an over-broad fix (e.g. excluding every IsGlobalRef from the load) that would
// re-break whole-aggregate copy from a global.
func TestAssignWholeStructFromGlobalLoadsValue() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"var VS Node\n"
					"func copyit() {\n"
					"\tvar x Node\n"
					"\tx = VS\n"
					"}\n")
	var fn @ir.Func = funcByName(m, "copyit")
	if fn == nil { return fail("copyit not found in module") }
	if !hasStructLoad(fn) {
		return fail("x = VS (whole-struct copy from a global) must load the struct value")
	}
	return ""
}
