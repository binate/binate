package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/stdx/slices"

// Declaration-order pre-passes (decl.order.forward: a declaration may name
// one declared later in its package).  Generic structs are stashed before any
// type is resolved (stashGenericTypeDecls, with the generic interfaces and the
// interface stubs — registerIfaceStub).  A package's non-struct type
// declarations (`type A = T`, `type A T`) are registered as ModuleTypeAliases in
// dependency order: one naming another of
// them declared later (`type P = *B` before `type B = C`) registers that one
// first, so the name resolves (decl.order.forward) rather than missing the
// registry — including one named only through an
// interface alias's target (typeDeclDepNames).  A cycle — which the checker
// rejects — just stops the walk (typeDeclWalk).

// typeExprBareNames appends to out the unqualified type names te refers to,
// anywhere within it.
func typeExprBareNames(te @ast.TypeExpr, out @[]@[]char) @[]@[]char {
	if te == nil { return out }
	if te.Kind == ast.TEXPR_NAMED && len(te.Pkg) == 0 {
		out = slices.Append[@[]char](out, te.Name)
	}
	out = typeExprBareNames(te.Base, out)
	for i := 0; i < len(te.TypeArgs); i++ {
		out = typeExprBareNames(te.TypeArgs[i], out)
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		out = typeExprBareNames(te.ParamTypes[i], out)
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		out = typeExprBareNames(te.ResultTypes[i], out)
	}
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { out = typeExprBareNames(te.Fields[i].Type, out) }
	}
	return out
}

// typeDeclDepNames returns the bare names te refers to, plus — transitively,
// through an alias of an alias — the bare names each same-package interface
// alias among them (found in idx) targets, each once.  A type declaration naming
// `X` (`interface X = G[T2]`) instantiates X's target when it resolves
// (completeIfaceAliasStub), exactly as spelling `G[T2]` there would, so T2 must be
// registered first.
func typeDeclDepNames(idx @typeDeclIndex, te @ast.TypeExpr) @[]@[]char {
	var none @[]@[]char
	var own @[]@[]char = typeExprBareNames(te, none)
	var first int = 0
	for first < len(own) && idx.ifaceAliasDecl(own[first]) == nil { first++ }
	if first == len(own) { return own }
	var names @vec.Vec[@[]char] = vec.New[@[]char]()
	var seen @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq] =
		newNameSet()
	for i := 0; i < len(own); i++ {
		names.Push(own[i])
		seen.Put(own[i], true)
	}
	for i := first; i < names.Len(); i++ {
		var a @ast.Decl = idx.ifaceAliasDecl(names.Get(i))
		if a == nil { continue }
		var more @[]@[]char = typeExprBareNames(a.TypeRef, none)
		for j := 0; j < len(more); j++ {
			if !seen.Has(more[j]) {
				names.Push(more[j])
				seen.Put(more[j], true)
			}
		}
	}
	return names.Items()
}

// typeDeclDepFirst reports whether dep, a type declaration another one names,
// must be registered before it: an alias (it resolves to its target) or a type
// not registered under `name` at all.  A named type already registered — by
// preRegisterNamedTypeDecl, its underlying perhaps still pending — resolves by
// name, so a group of named types that name one another needs no order.
func typeDeclDepFirst(gc @GenCtx, dep @ast.Decl, name *[]readonly char) bool {
	return dep.IsAlias || lookupTypeAlias(gc, name) == nil
}

// registerModuleTypeDecl registers the module's non-struct type declaration d
// under its module-qualified name (qualifyForCurrentModule — the name its
// importers use), after any alias of the module's it names (typeDeclDepFirst),
// found in idx, the index of the module's declarations (indexTypeDecls).
// The callers pre-register the module's named types first
// (preRegisterNamedTypeDecl), so a type naming itself or another named type
// resolves to it.
func registerModuleTypeDecl(gc @GenCtx, idx @typeDeclIndex, d @ast.Decl) {
	var qualName @[]char = qualifyForCurrentModule(gc, declaredTypeName(gc, d))
	if typeDeclRegistered(gc, qualName) { return }
	var w @typeDeclWalk = startTypeDeclWalk(idx, d, qualName)
	for {
		dep, top := w.next()
		if top == nil { return }
		if dep != nil {
			var depName @[]char = qualifyForCurrentModule(gc, declaredTypeName(gc, dep))
			if typeDeclDepFirst(gc, dep, depName) && !typeDeclRegistered(gc, depName) {
				w.enter(dep, depName)
			}
			continue
		}
		registerTypeDeclEntry(gc, top.qual, top.d)
		w.leave()
	}
}

// registerPkgTypeDecl registers another package's non-struct type declaration
// d (package path, its declarations indexed in idx) under its qualified name,
// after any alias of the package's it names (typeDeclDepFirst; the caller
// pre-registers the package's named types).
func registerPkgTypeDecl(gc @GenCtx, path *[]readonly char, idx @typeDeclIndex, d @ast.Decl) {
	var qualName @[]char = qualNameInPkg(path, declaredTypeName(gc, d))
	if typeDeclRegistered(gc, qualName) { return }
	var w @typeDeclWalk = startTypeDeclWalk(idx, d, qualName)
	for {
		dep, top := w.next()
		if top == nil { return }
		if dep != nil {
			var depName @[]char = qualNameInPkg(path, declaredTypeName(gc, dep))
			if typeDeclDepFirst(gc, dep, depName) && !typeDeclRegistered(gc, depName) {
				w.enter(dep, depName)
			}
			continue
		}
		registerTypeDeclEntry(gc, top.qual, top.d)
		w.leave()
	}
}

// stashGenericTypeDecl records the generic type decl d (declared in
// pkgPath) for use sites to instantiate, once.
func stashGenericTypeDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char) {
	if lookupGenericTypeDeclPkg(gc, pkgPath, d.Name) != nil { return }
	gc.GenericTypeDecls = slices.Append[@ast.Decl](gc.GenericTypeDecls, d)
	gc.GenericTypeDeclPkgs = slices.Append[@[]char](gc.GenericTypeDeclPkgs, buf.CopyStr(pkgPath))
}

// stashGenericTypeDecls stashes file's generic type decls (declared in
// pkgPath).
func stashGenericTypeDecls(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isGenericTypeDecl(d) {
			stashGenericTypeDecl(gc, d, pkgPath)
		}
	}
}
