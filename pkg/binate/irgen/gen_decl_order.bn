package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/irutil"
import "pkg/stdx/slices"

// Declaration-order pre-passes (decl.order.forward: a declaration may name
// one declared later in its package).  Generic structs are stashed before any
// type is resolved (stashGenericStructDecls, with the generic interfaces and the
// interface stubs — registerIfaceStub).  A package's non-struct type
// declarations (`type A = T`, `type A T`) are registered as ModuleTypeAliases in
// dependency order: one naming another of
// them declared later (`type P = *B` before `type B = C`) registers that one
// first, so the name resolves (decl.order.forward) instead of falling to
// resolveTypeExpr's int fallback.  A cycle — which the checker rejects — just
// stops the recursion.

// typeExprBareNames appends to out the unqualified type names te refers to,
// anywhere within it.
func typeExprBareNames(te @ast.TypeExpr, out @[]@[]char) @[]@[]char {
	if te == nil { return out }
	if te.Kind == ast.TEXPR_NAMED && len(te.Pkg) == 0 {
		out = slices.Append[@[]char](out, te.Name)
	}
	out = typeExprBareNames(te.Base, out)
	for i := 0; i < len(te.TypeArgs); i++ {
		out = typeExprBareNames(te.TypeArgs[i], out)
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		out = typeExprBareNames(te.ParamTypes[i], out)
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		out = typeExprBareNames(te.ResultTypes[i], out)
	}
	for i := 0; i < len(te.Fields); i++ {
		if te.Fields[i] != nil { out = typeExprBareNames(te.Fields[i].Type, out) }
	}
	return out
}

// findNonStructTypeDecl returns the non-struct type declaration of decls named
// name, or nil.
func findNonStructTypeDecl(decls *[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		if isNonStructTypeDecl(decls[i]) && irutil.Streq(decls[i].Name, name) { return decls[i] }
	}
	var none @ast.Decl
	return none
}

// namesContain reports whether names contains name.
func namesContain(names *[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if irutil.Streq(names[i], name) { return true }
	}
	return false
}

// registerModuleTypeDecl registers the module's non-struct type declaration d
// under its module-qualified name (qualifyForCurrentModule — the name its
// importers use), after any not-yet-registered one of the module's it names.
// files / file / fileScoped / aliasSnap are GeneratePackage's: each declaration
// resolves under its own file's imports.  visiting holds the names being
// registered further up (a cycle guard).
func registerModuleTypeDecl(gc @GenCtx, files @[]@ast.File, file @ast.File, fileScoped bool,
		aliasSnap AliasMapSnapshot, d @ast.Decl, visiting @[]@[]char) {
	if lookupTypeAlias(gc, d.Name) != nil { return }
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	var none @[]@[]char
	var names @[]@[]char = typeExprBareNames(d.TypeRef, none)
	for i := 0; i < len(names); i++ {
		if namesContain(inner, names[i]) { continue }
		var dep @ast.Decl = findNonStructTypeDecl(file.Decls, names[i])
		if dep == nil { continue }
		registerModuleTypeDecl(gc, files, file, fileScoped, aliasSnap, dep, inner)
	}
	if fileScoped {
		overlayFileImports(gc.Mod, aliasSnap, declImportFile(gc, files, file, d.Pos.File))
	}
	var ta irsym.ModuleTypeAlias
	ta.Name = qualifyForCurrentModule(gc, d.Name)
	ta.Typ = typeDeclEntryType(gc, ta.Name, d)
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
}

// registerPkgTypeDecl registers another package's non-struct type declaration
// d (package path, declarations decls) under its qualified name, after any
// not-yet-registered one of the package's it names.  Each resolves under its
// own source file's imports (di — a pass over the package's merged file): the
// one it names may come from another file.  visiting is as for
// registerModuleTypeDecl.
func registerPkgTypeDecl(gc @GenCtx, path *[]readonly char, di @declImports, decls *[]@ast.Decl,
		d @ast.Decl, visiting @[]@[]char) {
	var qualName @[]char = qualNameInPkg(path, d.Name)
	if lookupTypeAlias(gc, qualName) != nil { return }
	var inner @[]@[]char = slices.Append[@[]char](visiting, d.Name)
	var none @[]@[]char
	var names @[]@[]char = typeExprBareNames(d.TypeRef, none)
	for i := 0; i < len(names); i++ {
		if namesContain(inner, names[i]) { continue }
		var dep @ast.Decl = findNonStructTypeDecl(decls, names[i])
		if dep == nil { continue }
		registerPkgTypeDecl(gc, path, di, decls, dep, inner)
	}
	di.use(gc, d)
	var ta irsym.ModuleTypeAlias
	ta.Name = qualName
	ta.Typ = typeDeclEntryType(gc, qualName, d)
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
}

// stashGenericStructDecl records the generic struct decl d (declared in
// pkgPath, parsed from file) for use sites to instantiate, once.
func stashGenericStructDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char, file @ast.File) {
	if lookupGenericTypeDeclPkg(gc, pkgPath, d.Name) != nil { return }
	gc.GenericTypeDecls = slices.Append[@ast.Decl](gc.GenericTypeDecls, d)
	gc.GenericTypeDeclPkgs = slices.Append[@[]char](gc.GenericTypeDeclPkgs, buf.CopyStr(pkgPath))
	gc.GenericTypeDeclFiles = slices.Append[@ast.File](gc.GenericTypeDeclFiles, file)
}

// stashGenericStructDecls stashes file's generic struct decls (declared in
// pkgPath).
func stashGenericStructDecls(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT &&
				len(d.TypeParams) > 0 {
			stashGenericStructDecl(gc, d, pkgPath, file)
		}
	}
}
