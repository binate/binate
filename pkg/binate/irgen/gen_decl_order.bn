package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/stdx/slices"

// Declaration-order pre-passes (decl.order.forward: a declaration may name
// one declared later in its package).  Generic structs are stashed before any
// type is resolved (stashGenericTypeDecls, with the generic interfaces and the
// interface stubs — registerIfaceStub).  A package's non-struct type
// declarations (`type A = T`, `type A T`) are registered as ModuleTypeAliases in
// declaration order: the named ones by name first (preRegisterNamedTypeDecl), so
// those that name one another resolve to each other, and an alias through the
// checker's record of it, registered or not (irAliasFromChecker).  A mapping that
// passes through an alias of the pass not registered yet registers it on the way
// (pendAliasDecls), and the next mapping to reach it stops there: a chain of aliases
// declared head first (`type A0 = A1`, `type A1 = A2`, ...) is registered in time
// linear in its length, not mapped again from each link.

// registerTypeDecls registers the non-struct type declarations among decls, those
// of the package whose path is path, in declaration order: the named ones by name
// first, then each in turn (registerTypeDecl).
func registerTypeDecls(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	pendAliasDecls(gc, decls, path)
	for i := 0; i < len(decls); i++ {
		var td @ast.Decl = decls[i]
		if preRegistersNamedType(td) {
			preRegisterNamedTypeDecl(gc, irutil.QualifyForPkgPath(path, declaredTypeName(gc, td)), td)
		}
	}
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if isNonStructTypeDecl(d) {
			registerTypeDecl(gc, d, irutil.QualifyForPkgPath(path, declaredTypeName(gc, d)))
		}
	}
	dropPendingAliases(gc)
}

// registerTypeDecl registers the non-struct type declaration d under name, unless
// it is registered already: an alias perhaps by an earlier declaration's mapping
// (pendAliasDecls), a named type with its underlying resolved (typeDeclRegistered).
func registerTypeDecl(gc @GenCtx, d @ast.Decl, name @[]char) {
	if typeDeclRegistered(gc, name) { return }
	unpendAliasDecl(gc, d)
	registerTypeDeclEntry(gc, name, d)
}

// aliasDeclRecord returns the checker's type for the alias declaration d, or nil
// when d is no alias declaration with a record of one.
func aliasDeclRecord(gc @GenCtx, d @ast.Decl) @types.Type {
	if !d.IsAlias || d.ResolvedTypeID == 0 { return nil }
	var rec @types.Type = gc.Mod.Checker.ExprType(d.ResolvedTypeID)
	if rec == nil || rec.Kind != types.TYP_ALIAS { return nil }
	return rec
}

// pendAliasDecls notes the alias declarations among decls, of the package whose path
// is path, in GenCtx.PendingAliases under the checker's type for each, so a mapping
// that passes through one registers it (irAliasFromChecker).  A blank declaration,
// and one whose name is registered already, is left to its own registration.
func pendAliasDecls(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if !isNonStructTypeDecl(d) || isBlankDecl(d) { continue }
		var rec @types.Type = aliasDeclRecord(gc, d)
		if rec == nil { continue }
		var name @[]char = irutil.QualifyForPkgPath(path, declaredTypeName(gc, d))
		if lookupTypeAlias(gc, name) != nil { continue }
		if gc.PendingAliases == nil {
			gc.PendingAliases = table.NewTable[@types.Type, PendingAlias, TypeHasher, TypeEq](
					TypeHasher{}, TypeEq{})
		}
		var pa PendingAlias
		pa.Decl = d
		pa.Name = name
		gc.PendingAliases.Put(rec, pa)
	}
}

// unpendAliasDecl takes the alias declaration d off the pending list, as its own
// registration is about to register it.
func unpendAliasDecl(gc @GenCtx, d @ast.Decl) {
	if gc.PendingAliases == nil { return }
	var rec @types.Type = aliasDeclRecord(gc, d)
	if rec != nil { _ = gc.PendingAliases.Remove(rec) }
}

// dropPendingAliases empties the pending list at the end of a registration pass.
func dropPendingAliases(gc @GenCtx) {
	gc.PendingAliases = nil
}

// aliasRegisteredOnTheWay reports whether the alias declaration d is registered, as
// an earlier declaration's mapping registers an alias it passes (pendAliasDecls).
func aliasRegisteredOnTheWay(gc @GenCtx, d @ast.Decl) bool {
	var rec @types.Type = aliasDeclRecord(gc, d)
	return rec != nil && registeredAliasType(gc, rec) != nil
}

// registerPassedAliases registers each of passed, the checker's aliases a mapping
// passed through on its way to mapped, that is pending (pendAliasDecls) as mapped --
// what its declaration would register it as (registerTypeDeclEntry) -- and takes it
// off the pending list.  The deepest goes first, so each alias is registered after
// the one it names.  A name registered since it was noted is left alone.
func registerPassedAliases(gc @GenCtx, passed @vec.Vec[@types.Type], mapped @types.Type) {
	for i := passed.Len() - 1; i >= 0; i-- {
		var t @types.Type = passed.Get(i)
		pa, pending := gc.PendingAliases.Get(t)
		if !pending { continue }
		_ = gc.PendingAliases.Remove(t)
		if lookupTypeAlias(gc, pa.Name) != nil { continue }
		var ta irsym.ModuleTypeAlias
		ta.Name = pa.Name
		ta.Typ = mapped
		ir.RegisterModuleTypeAlias(gc.Mod, ta)
		noteAliasDecl(gc, pa.Decl, pa.Name, mapped)
	}
}

// stashGenericTypeDecl records the generic type decl d (declared in
// pkgPath) for use sites to instantiate, once.
func stashGenericTypeDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char) {
	if lookupGenericTypeDeclPkg(gc, pkgPath, d.Name) != nil { return }
	gc.GenericTypeDecls = slices.Append[@ast.Decl](gc.GenericTypeDecls, d)
	gc.GenericTypeDeclPkgs = slices.Append[@[]char](gc.GenericTypeDeclPkgs, buf.CopyStr(pkgPath))
}

// stashGenericTypeDecls stashes file's generic type decls (declared in
// pkgPath).
func stashGenericTypeDecls(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isGenericTypeDecl(d) {
			stashGenericTypeDecl(gc, d, pkgPath)
		}
	}
}
