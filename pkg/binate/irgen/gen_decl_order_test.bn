package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_decl_order.bn and the interface stubs (registerIfaceStub).

// A type expression's bare names are found anywhere within it.
func TestTypeExprBareNames() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ntype P = *Box[B]\n")
	var none @[]@[]char
	var names @[]@[]char = typeExprBareNames(file.Decls[0].TypeRef, none)
	if len(names) != 2 { return fail("expected Box and B") }
	if !charsEqual(names[0], "Box") || !charsEqual(names[1], "B") { return fail("expected [Box B]") }
	return ""
}

// An alias naming a later alias registers that one first, so both resolve to
// the final target.
func TestRegisterPkgTypeDeclForwardAlias() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ntype A = B\ntype B = int\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var none @[]@[]char
	var di @declImports = beginDeclImports(gc, file)
	registerPkgTypeDecl(gc, "pkg/x", di, file.Decls, file.Decls[0], none)
	di.end(gc)
	var a @types.Type = lookupTypeAlias(gc, "pkg/x.A")
	if a == nil || a.Kind != types.TYP_INT { return fail("A should be registered as int") }
	if lookupTypeAlias(gc, "pkg/x.B") == nil { return fail("B should be registered first") }
	return ""
}

// An interface stub is found by type resolution before the interface is
// collected, and collection fills it in place.
func TestRegisterIfaceStubFilled() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ninterface I { M() int }\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var before int = len(gc.Mod.Interfaces)
	registerIfaceStubs(gc, file, "pkg/x")
	var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	if idx < 0 || !gc.Mod.Interfaces[idx].IsStub { return fail("expected a stub for I") }
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/x", file)
	if len(gc.Mod.Interfaces) != before + 1 {
		return fail("collection should fill the stub, not append")
	}
	if gc.Mod.Interfaces[idx].IsStub || len(gc.Mod.Interfaces[idx].MethodNames) != 1 {
		return fail("the stub should now carry I's method")
	}
	return ""
}

// A type declaration's dependency names include, transitively, those of the
// same-package interface aliases it names: `type Y = Box[*Z]` with `interface Z
// = X` and `interface X = G[T2]` depends on T2.
func TestTypeDeclDepNamesFollowsIfaceAliases() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"type Y = Box[*Z]\n"
					"interface Z = X\n"
					"interface X = G[T2]\n"
					"type T2 = float64\n")
	var names @[]@[]char = typeDeclDepNames(file.Decls, file.Decls[0].TypeRef)
	if !namesContain(names, "T2") { return fail("Y should depend on T2 through Z and X") }
	if !namesContain(names, "Box") || !namesContain(names, "Z") {
		return fail("Y's own names should stay")
	}
	return ""
}

// The module's own non-struct definition of an opaque type registered from its
// .bni fills that type in place rather than registering a second one.
func TestRegisterModuleTypeDeclFillsOpaque() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ntype X @[]char\n")
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	gc.PkgPath = "pkg/x"
	var ph @types.Type = addOpaqueNamed(m, "pkg/x.X", "pkg/x", nil)
	var noFiles @[]@ast.File
	var noSnap AliasMapSnapshot
	var none @[]@[]char
	registerModuleTypeDecl(gc, noFiles, file, false, noSnap, file.Decls[0], none)
	if ph.Underlying == nil || ph.Underlying.Kind != types.TYP_MANAGED_SLICE {
		return fail("X must be filled with its definition")
	}
	if len(m.TypeAliases) != 1 { return fail("X must not be registered twice") }
	return ""
}
