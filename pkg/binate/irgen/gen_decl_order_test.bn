package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/iriface"
import "pkg/binate/irsym"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/stdx/slices"

// Tests for gen_decl_order.bn -- the registration of a declaration list's non-struct
// type declarations in declaration order -- and the interface stubs
// (registerIfaceStub).

// deepChain is how long the deep tests' chains are: far past what a walk with a call
// per link could hold on its stack, and past what mapping the rest of a chain again
// from each link could get through.
const deepChain int = 100000

// namedTypeExpr returns the type expression naming name.
func namedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

// aliasChainDecls returns the type alias declarations prefix0 = prefix1, ...,
// prefix<n-1> = end, built directly rather than parsed: parsing a file of n
// declarations takes time quadratic in n (the parser copies its list of them to add
// each).
func aliasChainDecls(prefix *[]readonly char, n int, end *[]readonly char) @[]@ast.Decl {
	var decls @[]@ast.Decl = make_slice(@ast.Decl, n)
	for i := 0; i < n; i++ {
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_TYPE
		d.IsAlias = true
		d.Name = buf.Concat(prefix, strconv.Itoa(i))
		if i + 1 < n {
			d.TypeRef = namedTypeExpr(buf.Concat(prefix, strconv.Itoa(i + 1)))
		} else {
			d.TypeRef = namedTypeExpr(buf.CopyStr(end))
		}
		decls[i] = d
	}
	return decls
}

// declFile returns a file holding decls.
func declFile(decls @[]@ast.Decl) @ast.File {
	var f @ast.File = make(ast.File)
	f.Decls = decls
	return f
}

// checkedDeclFile returns a file of the package path holding decls, loaded into m's
// checker as that package's `.bni` (checkPackageInto).
func checkedDeclFile(m @ir.Module, path *[]readonly char, decls @[]@ast.Decl) @ast.File {
	var f @ast.File = declFile(decls)
	f.PkgName = buf.Concat(buf.Concat("\"", path), "\"")
	checkPackageInto(moduleChecker(m), path, f, nil)
	return f
}

// releaseCheckedChain drops the chain of the checker's alias types of a file from
// checkedDeclFile a link at a time (releaseAliasChain), so its release, when gc's
// module and its checker go, does not nest one destruction per link.
func releaseCheckedChain(gc @GenCtx, file @ast.File) {
	releaseAliasChain(gc.Mod.Checker.ExprType(file.Decls[0].ResolvedTypeID))
}

// allBool reports whether every alias of a chain of n, its names prefix0 ..., is
// registered in gc as bool.
func allBool(gc @GenCtx, prefix *[]readonly char, n int) bool {
	for i := 0; i < n; i++ {
		var a @types.Type = lookupTypeAlias(gc, buf.Concat(prefix, strconv.Itoa(i)))
		if a == nil || a.Kind != types.TYP_BOOL { return false }
	}
	return true
}

// typeAliasPos returns the index in m.TypeAliases of the entry registered under
// name, or -1 when none is.
func typeAliasPos(m @ir.Module, name *[]readonly char) int {
	for i := 0; i < len(m.TypeAliases); i++ {
		if charsEqual(m.TypeAliases[i].Name, name) { return i }
	}
	return -1
}

// An alias naming later aliases registers them on the way, once each, the deepest
// first, and all resolve to the final target; the pass leaves nothing pending.
func TestRegisterTypeDeclsForwardAlias() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ntype A = B\ntype B = C\ntype C = bool\n")
	registerTypeDecls(gc, file.Decls, "pkg/x")
	var names @[]@[]char = @[]@[]char{"pkg/x.C", "pkg/x.B", "pkg/x.A"}
	if len(gc.Mod.TypeAliases) != len(names) { return fail("each alias should be registered once") }
	for i := 0; i < len(names); i++ {
		if !charsEqual(gc.Mod.TypeAliases[i].Name, names[i]) {
			return fail("the aliases should be registered C, B, A: each after the one it names")
		}
		if gc.Mod.TypeAliases[i].Typ.Kind != types.TYP_BOOL { return fail("each should be bool") }
	}
	if gc.PendingAliases != nil { return fail("the pass should leave nothing pending") }
	return ""
}

// A pending alias whose name is registered by the time a mapping passes it is not
// registered again.
func TestPassedAliasKeepsANameRegisteredSince() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype A = B\ntype B = bool\n")
	pendAliasDecls(gc, file.Decls, "pkg/x")
	var held irsym.ModuleTypeAlias
	held.Name = buf.CopyStr("pkg/x.B")
	held.Typ = types.TypInt()
	ir.RegisterModuleTypeAlias(gc.Mod, held)
	registerTypeDecl(gc, file.Decls[0], buf.CopyStr("pkg/x.A"))
	dropPendingAliases(gc)
	if len(gc.Mod.TypeAliases) != 2 || !same(lookupTypeAlias(gc, "pkg/x.B"), held.Typ) {
		return fail("B should keep the one registration it has")
	}
	var a @types.Type = lookupTypeAlias(gc, "pkg/x.A")
	if a == nil || a.Kind != types.TYP_BOOL { return fail("A should be registered as bool") }
	return ""
}

// An alias whose name is registered already (by an earlier pass) is not registered
// again on another's way, nor by its own registration.
func TestRegisterTypeDeclsKeepsARegisteredName() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype A = B\ntype B = bool\n")
	var held irsym.ModuleTypeAlias
	held.Name = buf.CopyStr("pkg/x.B")
	held.Typ = types.TypInt()
	ir.RegisterModuleTypeAlias(gc.Mod, held)
	registerTypeDecls(gc, file.Decls, "pkg/x")
	if typeAliasPos(gc.Mod, "pkg/x.B") != 0 || len(gc.Mod.TypeAliases) != 2 {
		return fail("B should keep its one registration")
	}
	if !same(lookupTypeAlias(gc, "pkg/x.B"), held.Typ) { return fail("B should be the type it held") }
	var a @types.Type = lookupTypeAlias(gc, "pkg/x.A")
	if a == nil || a.Kind != types.TYP_BOOL { return fail("A should be registered as bool") }
	return ""
}

// An interface stub is found by type resolution before the interface is
// collected, and collection fills it in place.
func TestRegisterIfaceStubFilled() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ninterface I { M() int }\n")
	var before int = len(gc.Mod.Interfaces)
	registerIfaceStubs(gc, file, "pkg/x")
	var idx int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	if idx < 0 || !gc.Mod.Interfaces[idx].IsStub { return fail("expected a stub for I") }
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/x")
	if len(gc.Mod.Interfaces) != before + 1 {
		return fail("collection should fill the stub, not append")
	}
	if gc.Mod.Interfaces[idx].IsStub || len(gc.Mod.Interfaces[idx].MethodNames) != 1 {
		return fail("the stub should now carry I's method")
	}
	return ""
}

// The module's own non-struct definition of an opaque type registered from its
// .bni fills that type in place rather than registering a second one.
func TestRegisterTypeDeclsFillsOpaque() testing.TestResult {
	var m @ir.Module = testModule("test")
	var file @ast.File = checkedBni(m, "pkg/x", "package \"pkg/x\"\ntype X @[]char\n")
	var gc @GenCtx = NewGenCtx(m)
	gc.PkgPath = "pkg/x"
	var ph @types.Type = addOpaqueNamed(m, "pkg/x.X", "pkg/x", nil)
	registerTypeDecls(gc, file.Decls, gc.PkgPath)
	if ph.Underlying == nil || ph.Underlying.Kind != types.TYP_MANAGED_SLICE {
		return fail("X must be filled with its definition")
	}
	if len(m.TypeAliases) != 1 { return fail("X must not be registered twice") }
	return ""
}

// A chain of aliases far longer than a stack could follow a call per link, declared
// head first, registers through another package's pass in time linear in its length,
// every alias resolving to the chain's end (bool).
func TestDeepAliasChainPkg() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var chain @[]@ast.Decl = aliasChainDecls("A", deepChain, "bool")
	var file @ast.File = checkedDeclFile(gc.Mod, "pkg/x", chain)
	registerStructTypesFlat(@[]@[]char{"pkg/x"}, @[]@ast.File{file}, gc)
	var ok bool = allBool(gc, "pkg/x.A", deepChain) && len(gc.Mod.TypeAliases) == deepChain
	releaseCheckedChain(gc, file)
	if !ok { return fail("every alias should be registered as bool") }
	return ""
}

// The module's pass registers such a chain too.
func TestDeepAliasChainModule() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var chain @[]@ast.Decl = aliasChainDecls("A", deepChain, "bool")
	var file @ast.File = checkedDeclFile(gc.Mod, "pkg/x", chain)
	gc.PkgPath = "pkg/x"
	registerTypeDecls(gc, file.Decls, gc.PkgPath)
	var ok bool = allBool(gc, "pkg/x.A", deepChain) && len(gc.Mod.TypeAliases) == deepChain
	releaseCheckedChain(gc, file)
	if !ok { return fail("every alias should be registered as bool") }
	return ""
}

// The REPL builds such a chain declared at one prompt: the session's checker checked
// it (with a main function, as its file's declarations).
func TestDeepAliasChainRepl() testing.TestResult {
	var decls @[]@ast.Decl = aliasChainDecls("A", deepChain, "bool")
	var file @ast.File = declFile(slices.Append[@ast.Decl](decls, mainDecl()))
	file.PkgName = buf.CopyStr("\"test\"")
	var c @check.Checker = check.NewChecker()
	c.CheckMainPersistent(file)
	stopOnCheckErrors(c)
	var m @ir.Module = InitModule("test")
	m.Checker = c
	var gc @GenCtx = NewGenCtx(m)
	var before int = len(m.TypeAliases)
	var msg @[]char = GenTypeDecls(decls, gc)
	var ok bool = len(msg) == 0 && allBool(gc, "A", deepChain) &&
			len(m.TypeAliases) == before + deepChain
	releaseCheckedChain(gc, file)
	if len(msg) > 0 { return fail(msg) }
	if !ok { return fail("every alias should be built as bool") }
	return ""
}

// The REPL builds an alias that an earlier one's mapping registered on the way
// once: `type A = B` registers B, which is not built again.
func TestReplAliasRegisteredOnTheWay() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes("package \"test\"\ntype A = B\ntype B = bool\nfunc main() {}\n"), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.CheckMainPersistent(file)
	stopOnCheckErrors(c)
	var m @ir.Module = InitModule("test")
	m.Checker = c
	var gc @GenCtx = NewGenCtx(m)
	var before int = len(m.TypeAliases)
	var msg @[]char = GenTypeDecls(file.Decls[0:2], gc)
	if len(msg) > 0 { return fail(msg) }
	if len(m.TypeAliases) != before + 2 { return fail("A and B should be built once each") }
	var bi int = typeAliasPos(m, qualifyForCurrentModule(gc, "B"))
	if bi != before || typeAliasPos(m, qualifyForCurrentModule(gc, "A")) != before + 1 {
		return fail("B should be built first, on A's way")
	}
	return ""
}

// mainDecl returns the declaration `func main() {}`.
func mainDecl() @ast.Decl {
	var p @parser.Parser = parser.New(strToBytes("package \"test\"\nfunc main() {}\n"), "test")
	return mustParse(p).Decls[0]
}
