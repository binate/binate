package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/irdata"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// The walks that register a declaration list's non-struct type declarations in
// dependency order (registerModuleTypeDecl, registerPkgTypeDecl, genReplAliasDecls)
// follow a declaration's dependencies on a stack of their own (typeDeclWalk), not a
// call per dependency: a chain of aliases (`type A0 = A1`, `type A1 = A2`, ...) is as
// long as a package makes it, with no type depth to bound it (an alias adds no level,
// type.named.depth).  They find the declarations a name refers to in an index built
// once per list (typeDeclIndex), and keep the names on their path in a set, so a walk
// over a chain of n declarations takes time linear in n -- though in a compile,
// registering each declaration maps its type from the checker's record of it, which
// follows the rest of an alias chain (irAliasFromChecker).

// A typeDeclIndex finds a declaration list's non-struct type declarations and
// interface aliases by name: the first of each name, as a search of the list would.
type typeDeclIndex struct {
	nonStruct    @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq]
	ifaceAliases @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq]
}

// newDeclTable returns an empty table of declarations by name.
func newDeclTable() @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher,
		irdata.FuncSigEq] {
	return table.NewTable[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
}

// newNameSet returns an empty set of names.
func newNameSet() @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq] {
	return table.NewTable[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq](
			irdata.FuncSigHasher{}, irdata.FuncSigEq{})
}

// indexTypeDecls indexes decls (typeDeclIndex).
func indexTypeDecls(decls *[]@ast.Decl) @typeDeclIndex {
	var x @typeDeclIndex = make(typeDeclIndex)
	x.nonStruct = newDeclTable()
	x.ifaceAliases = newDeclTable()
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if isNonStructTypeDecl(d) && !x.nonStruct.Has(d.Name) { x.nonStruct.Put(d.Name, d) }
		if d.Kind == ast.DECL_INTERFACE && d.IsAlias && d.TypeRef != nil && !x.ifaceAliases.Has(d.Name) {
			x.ifaceAliases.Put(d.Name, d)
		}
	}
	return x
}

// nonStructDecl returns the indexed non-struct type declaration named name, or nil.
func (x @typeDeclIndex) nonStructDecl(name *[]readonly char) @ast.Decl {
	var d @ast.Decl
	d, _ = x.nonStruct.Get(name)
	return d
}

// ifaceAliasDecl returns the indexed interface alias declaration named name, or nil.
func (x @typeDeclIndex) ifaceAliasDecl(name *[]readonly char) @ast.Decl {
	var d @ast.Decl
	d, _ = x.ifaceAliases.Get(name)
	return d
}

// A typeDeclStep is a declaration on a registration walk's path: its name as the walk
// registers it (qual), the names its type refers to (typeDeclDepNames) and how many of
// them the walk has looked at.
type typeDeclStep struct {
	d     @ast.Decl
	qual  @[]char
	names @[]@[]char
	next  int
}

// A typeDeclWalk is a registration walk's path through idx's declarations: the
// declarations being registered, each naming the one after it, and their names, which
// the walk does not enter again (a cycle, which the checker rejects, ends there).
type typeDeclWalk struct {
	idx    @typeDeclIndex
	steps  @vec.Vec[@typeDeclStep]
	onPath @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq]
}

// startTypeDeclWalk starts a walk of idx's declarations at d, registered as qual.
func startTypeDeclWalk(idx @typeDeclIndex, d @ast.Decl, qual @[]char) @typeDeclWalk {
	var w @typeDeclWalk = make(typeDeclWalk)
	w.idx = idx
	w.steps = vec.New[@typeDeclStep]()
	w.onPath = newNameSet()
	w.enter(d, qual)
	return w
}

// enter puts d, registered as qual, last on the walk's path.
func (w @typeDeclWalk) enter(d @ast.Decl, qual @[]char) {
	var s @typeDeclStep = make(typeDeclStep)
	s.d = d
	s.qual = qual
	s.names = typeDeclDepNames(w.idx, d.TypeRef)
	w.steps.Push(s)
	w.onPath.Put(d.Name, true)
}

// next returns the next declaration that the last on the walk's path names and that is
// not on the path, and that last step; nil and the step when it names no more; nil and
// nil when the path is empty.
func (w @typeDeclWalk) next() (@ast.Decl, @typeDeclStep) {
	var none @ast.Decl
	var noStep @typeDeclStep
	if w.steps.Len() == 0 { return none, noStep }
	var s @typeDeclStep = w.steps.Get(w.steps.Len() - 1)
	for s.next < len(s.names) {
		var name @[]char = s.names[s.next]
		s.next += 1
		if w.onPath.Has(name) { continue }
		var dep @ast.Decl = w.idx.nonStructDecl(name)
		if dep != nil { return dep, s }
	}
	return none, s
}

// leave takes the last declaration off the walk's path.
func (w @typeDeclWalk) leave() {
	s, _ := w.steps.Pop()
	_ = w.onPath.Remove(s.d.Name)
}
