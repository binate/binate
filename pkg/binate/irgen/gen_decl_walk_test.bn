package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for gen_decl_walk.bn: the declaration index and the registration walks that
// follow a chain of declarations on a stack of their own.

// deepChain is how long the deep tests' chains are: far past what a walk with a call
// per link could hold on its stack.
const deepChain int = 100000

// namedTypeExpr returns the type expression naming name.
func namedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

// aliasChainDecls returns the alias declarations prefix0 = prefix1, ..., prefix<n-1> =
// end, of the given kind (ast.DECL_TYPE or ast.DECL_INTERFACE), built directly rather
// than parsed: parsing a file of n declarations takes time quadratic in n (the parser
// copies its list of them to add each).
func aliasChainDecls(kind int, prefix *[]readonly char, n int, end *[]readonly char) @[]@ast.Decl {
	var decls @[]@ast.Decl = make_slice(@ast.Decl, n)
	for i := 0; i < n; i++ {
		var d @ast.Decl = make(ast.Decl)
		d.Kind = kind
		d.IsAlias = true
		d.Name = buf.Concat(prefix, strconv.Itoa(i))
		if i + 1 < n {
			d.TypeRef = namedTypeExpr(buf.Concat(prefix, strconv.Itoa(i + 1)))
		} else {
			d.TypeRef = namedTypeExpr(buf.CopyStr(end))
		}
		decls[i] = d
	}
	return decls
}

// declFile returns a file holding decls.
func declFile(decls @[]@ast.Decl) @ast.File {
	var f @ast.File = make(ast.File)
	f.Decls = decls
	return f
}

// checkedDeclFile returns a file of the package path holding decls, loaded into m's
// checker as that package's `.bni` (checkPackageInto).
func checkedDeclFile(m @ir.Module, path *[]readonly char, decls @[]@ast.Decl) @ast.File {
	var f @ast.File = declFile(decls)
	f.PkgName = buf.Concat(buf.Concat("\"", path), "\"")
	checkPackageInto(moduleChecker(m), path, f, nil)
	return f
}

// releaseCheckedChain drops the chain of the checker's alias types of a file from
// checkedDeclFile a link at a time (releaseAliasChain), so its release, when gc's
// module and its checker go, does not nest one destruction per link.
func releaseCheckedChain(gc @GenCtx, file @ast.File) {
	releaseAliasChain(gc.Mod.Checker.ExprType(file.Decls[0].ResolvedTypeID))
}

// allBool reports whether every alias of a chain of n, its names prefix0 ..., is
// registered in gc as bool.
func allBool(gc @GenCtx, prefix *[]readonly char, n int) bool {
	for i := 0; i < n; i++ {
		var a @types.Type = lookupTypeAlias(gc, buf.Concat(prefix, strconv.Itoa(i)))
		if a == nil || a.Kind != types.TYP_BOOL { return false }
	}
	return true
}

// The index finds the first non-struct type declaration and interface alias of each
// name, and no struct.
func TestIndexTypeDeclsFirstOfEachName() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"type A = int\n"
					"type A = bool\n"
					"interface I = J\n"
					"interface I = K\n"
					"type S struct {}\n")
	var idx @typeDeclIndex = indexTypeDecls(file.Decls)
	if !same(idx.nonStructDecl("A"), file.Decls[0]) { return fail("A should be the first A") }
	if !same(idx.ifaceAliasDecl("I"), file.Decls[2]) { return fail("I should be the first I") }
	if idx.nonStructDecl("S") != nil { return fail("a struct is not indexed") }
	if idx.nonStructDecl("I") != nil || idx.ifaceAliasDecl("A") != nil {
		return fail("each name is indexed only as what it declares")
	}
	return ""
}

// A chain of aliases far longer than a stack could follow a call per link registers
// through another package's walk, every alias resolving to the chain's end (bool).
func TestDeepAliasChainPkg() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var chain @[]@ast.Decl = aliasChainDecls(ast.DECL_TYPE, "A", deepChain, "bool")
	var file @ast.File = checkedDeclFile(gc.Mod, "pkg/x", chain)
	var di @declImports = beginDeclImports(gc, file)
	gc.Mod.CurrentImportPkg = "pkg/x"
	registerPkgTypeDecl(gc, "pkg/x", di, indexTypeDecls(file.Decls), file.Decls[0])
	di.end(gc)
	var ok bool = allBool(gc, "pkg/x.A", deepChain)
	releaseCheckedChain(gc, file)
	if !ok { return fail("every alias should be registered as bool") }
	return ""
}

// The module's walk registers such a chain too.
func TestDeepAliasChainModule() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var chain @[]@ast.Decl = aliasChainDecls(ast.DECL_TYPE, "A", deepChain, "bool")
	var file @ast.File = checkedDeclFile(gc.Mod, "pkg/x", chain)
	gc.PkgPath = "pkg/x"
	var noFiles @[]@ast.File
	var noSnap AliasMapSnapshot
	registerModuleTypeDecl(gc, noFiles, file, false, noSnap, indexTypeDecls(file.Decls), file.Decls[0])
	var ok bool = allBool(gc, "pkg/x.A", deepChain)
	releaseCheckedChain(gc, file)
	if !ok { return fail("every alias should be registered as bool") }
	return ""
}

// The REPL's walk builds such a chain declared at one prompt.
func TestDeepAliasChainRepl() testing.TestResult {
	var decls @[]@ast.Decl = aliasChainDecls(ast.DECL_TYPE, "A", deepChain, "bool")
	var gc @GenCtx = NewGenCtx(genFromSource("package \"test\"\nfunc main() {}\n"))
	var msg @[]char = GenTypeDecls(decls, gc)
	if len(msg) > 0 { return fail(msg) }
	if !allBool(gc, "A", deepChain) { return fail("every alias should be built as bool") }
	return ""
}

// A type naming the start of a chain of interface aliases depends on every name the
// chain reaches, each once.
func TestDeepIfaceAliasChainDepNames() testing.TestResult {
	var chain @[]@ast.Decl = aliasChainDecls(ast.DECL_INTERFACE, "I", deepChain, "J")
	var p @ast.TypeExpr = make(ast.TypeExpr)
	p.Kind = ast.TEXPR_POINTER
	p.Base = namedTypeExpr(buf.CopyStr("I0"))
	var names @[]@[]char = typeDeclDepNames(indexTypeDecls(chain), p)
	if len(names) != deepChain + 1 { return fail("P should depend on every I and on J, each once") }
	if !charsEqual(names[deepChain], "J") { return fail("the chain should end at J") }
	return ""
}
