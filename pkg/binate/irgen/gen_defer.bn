package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Defer statements (§14.13).  A defer statement evaluates nothing: it schedules
// its block on the innermost open scope — the block it appears in — and the
// block is generated, as ordinary code, at every exit of that scope: its
// fall-through end (closeScope) and each `break`, `continue` or `return` that
// leaves it (emitLeaveScopes), after the scopes inside it have exited and before
// its own variables are released, last scheduled first.  Which defer statements
// have executed at an exit is known from the program text (no `goto`), so a
// scope's list at an exit is exactly the defer statements before that exit: no
// runtime flag or record is needed.  A deferred block is generated once per exit
// edge of its scope; a closure site in it stays one site (gen_closure_site.bn).

// PendingDefer is a defer statement scheduled on a scope: Stmt is the statement
// (its Body, or the shorthand's call in X), VarLen the length of ctx.Vars at the
// statement — the variables declared after it are live at the scope's exit but
// not in the deferred block's scope.
type PendingDefer struct {
	Stmt   @ast.Stmt
	VarLen int
}

// scheduleDefer schedules the defer statement s on the innermost open scope.
func scheduleDefer(ctx @GenContext, s @ast.Stmt) {
	if len(ctx.Scopes) == 0 {
		panic("internal error: a defer statement outside any scope reached IR-gen")
	}
	var pd PendingDefer
	pd.Stmt = s
	pd.VarLen = len(ctx.Vars)
	var top int = len(ctx.Scopes) - 1
	ctx.Scopes[top].Defers = slices.Append[PendingDefer](ctx.Scopes[top].Defers, pd)
}

// hasPendingDefers reports whether any open scope has a deferred block scheduled.
func hasPendingDefers(ctx @GenContext) bool {
	for d := 0; d < len(ctx.Scopes); d++ {
		if len(ctx.Scopes[d].Defers) > 0 { return true }
	}
	return false
}

// emitScopeDefers emits, into b, the deferred blocks scheduled on scope d, last
// scheduled first — stopping if one ends the block (a deferred `panic`).
// Returns the block flow continues in.
func emitScopeDefers(ctx @GenContext, b @ir.Block, d int) @ir.Block {
	var defers @[]PendingDefer = ctx.Scopes[d].Defers
	for j := len(defers) - 1; j >= 0; j-- {
		if blockIsTerminated(b) { return b }
		b = emitDeferredBlock(ctx, b, d, defers[j])
	}
	return b
}

// emitDeferredBlock generates pd, scheduled on scope d, at an exit of that scope.
// The scopes inside d have exited — their deferred blocks ran and their variables
// were released — so they are out of view.  The variables d declared after the
// defer statement are live (a VM fault in the deferred code releases them) but
// not in the deferred block's scope, so they stay in ctx.Vars under an
// unspellable name (as `.typeswitch.scrutinee`), which no lookup finds.  A
// `break` / `continue` cannot leave a deferred block (stmt.defer.block, enforced
// by the checker), so the jump targets are cleared.  Returns the block flow
// continues in.
func emitDeferredBlock(ctx @GenContext, b @ir.Block, d int, pd PendingDefer) @ir.Block {
	if len(ctx.Temps) != 0 {
		panic("internal error: a deferred block generated with statement temporaries pending")
	}
	var savedVars @[]VarSlot = ctx.Vars
	var savedScopes @[]ScopeRec = ctx.Scopes
	var savedBreak @ir.Block = ctx.BreakTo
	var savedContinue @ir.Block = ctx.ContinueTo
	var end int = len(savedVars)
	if d + 1 < len(savedScopes) {
		end = savedScopes[d + 1].VarStart
	}
	var view @[]VarSlot = make_slice(VarSlot, end)
	for i := 0; i < end; i++ {
		view[i] = savedVars[i]
		if i >= pd.VarLen {
			view[i].Name = ".defer.later"
		}
	}
	ctx.Vars = view
	ctx.Scopes = savedScopes[:d + 1]
	ctx.BreakTo = nil
	ctx.ContinueTo = nil
	ctx.CurBlock = b
	if pd.Stmt.Body != nil {
		b = genBlock(ctx, b, pd.Stmt.Body)
	} else {
		b = genBlock(ctx, b, deferCallBlock(pd.Stmt))
	}
	ctx.Vars = savedVars
	ctx.Scopes = savedScopes
	ctx.BreakTo = savedBreak
	ctx.ContinueTo = savedContinue
	return b
}

// deferCallBlock is the block the shorthand `defer <call>` (s.X) stands for:
// one expression statement — generated as a block, so a variable its call
// declares (a raw-slice literal's backing) is released with the block.
func deferCallBlock(s @ast.Stmt) @ast.Stmt {
	var es @ast.Stmt = make(ast.Stmt)
	es.Kind = ast.STMT_EXPR
	es.Pos = s.Pos
	es.X = s.X
	var blk @ast.Stmt = make(ast.Stmt)
	blk.Kind = ast.STMT_BLOCK
	blk.Pos = s.Pos
	blk.Stmts = slices.Append[@ast.Stmt](blk.Stmts, es)
	return blk
}

// emitReturnThroughDefers ends a `return` whose function has deferred blocks
// pending (stmt.defer.return): the results — already evaluated, and each managed
// one holding the reference the caller receives — are stored in frame slots, so
// the deferred code's own statements, which reclaim the VM stack a result may
// still sit on, cannot clobber them, and registered in ctx.LiveResults, so a VM
// fault in that code releases them; the return statement's remaining
// temporaries are released (no VM stack restore); every open scope exits,
// innermost first (its deferred blocks, then its variables); the results are
// reloaded and returned.  Emits into b; returns the final block.
func emitReturnThroughDefers(ctx @GenContext, b @ir.Block, vals @[]@ir.Instr) @ir.Block {
	var slots @[]@ir.Instr
	for i := 0; i < len(vals); i++ {
		var slot @ir.Instr = irbuild.EmitAlloc(b, vals[i].Typ)
		irbuild.EmitStore(b, slot, vals[i])
		slots = slices.Append[@ir.Instr](slots, slot)
		// A result returned as a raw borrow of a managed value took no
		// reference, so there is none for a fault to release.
		if i < len(ctx.Func.Results) && isRawBorrowResult(vals[i], ctx.Func.Results[i]) {
			continue
		}
		var vs VarSlot
		vs.Name = ".return"
		vs.Ptr = slot
		vs.Typ = vals[i].Typ
		ctx.LiveResults = slices.Append[VarSlot](ctx.LiveResults, vs)
	}
	b = emitTempCleanupForReturn(ctx, b)
	forgetAddressedLits(ctx)
	b = emitLeaveScopes(ctx, b, 0, 0)
	var noLive @[]VarSlot
	ctx.LiveResults = noLive
	if blockIsTerminated(b) { return b }
	var out @[]@ir.Instr
	for i := 0; i < len(vals); i++ {
		out = slices.Append[@ir.Instr](out, irbuild.EmitLoad(b, slots[i], vals[i].Typ))
	}
	if ctx.Func.MultiReturnType != nil {
		irbuild.EmitReturnTyped(b, out, ctx.Func.MultiReturnType)
	} else {
		irbuild.EmitReturn(b, out)
	}
	return b
}
