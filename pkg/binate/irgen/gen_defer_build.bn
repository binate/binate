package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Per-shape defer-site builders (classify -> resolve dispatch key + operand/param
// types -> pre-allocate entry-depth slots).  Split from gen_defer.bn (which holds
// the pre-pass core + operand-slot helpers) for file length; see there for the
// overall model.

// buildDeferDirect resolves a direct call's symbol + signature and builds its arg
// operands.
func buildDeferDirect(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr) {
	var name @[]char
	if e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// `g[T](...)` / `pkg.G[T](...)`: monomorphize the generic function (once;
		// ensureInstantiated is idempotent) and take its mangled symbol — the same
		// name genCallInstantiate emits for the normal call.
		var gd @ast.Decl
		var alias @[]char
		gd, alias = instantiationHead(ctx, e.X)
		if gd != nil {
			var typeArgs @[]@types.Type
			for i := 0; i < len(e.X.Args); i++ {
				typeArgs = slices.Append[@types.Type](typeArgs, typeArgExprToType(ctx.Gc, e.X.Args[i]))
			}
			name = ensureInstantiated(ctx.Gc, gd, typeArgs, alias)
		}
	} else if e.X != nil && (e.X.Kind == ast.EXPR_IDENT || e.X.Kind == ast.EXPR_SELECTOR) {
		name = funcRefName(ctx, e.X)
	}
	if len(name) == 0 { panic("defer of an unresolved direct call") }
	var sig irdata.FuncSig
	var found bool
	sig, found = lookupFuncSig(ctx.Gc, name)
	if !found { panic("defer of an unknown function") }
	site.Sym = name
	site.ResultTyp = deferResultTyp(sig.Results, sig.MultiReturnType)
	buildDeferArgs(ctx, entry, site, e, sig.Params, 0, sig.IsVariadic, e.Spread)
}

// buildDeferArgs builds the argument operands, binding user args to the callee
// param types starting at paramBase (1 past a leading receiver param).  For a
// non-variadic callee each user arg is one operand.  For a variadic callee the
// leading fixed args bind positionally and the trailing args become the single
// `*[]T` variadic argument — either a spread operand `xs...` (one ordinary ARG
// bound to the `*[]T` param, so a managed @[]T rides the managed→raw path) or
// individual args packed at the defer site (an OPROLE_VARIADIC_PACK operand).
func buildDeferArgs(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr,
		paramTypes @[]@types.Type, paramBase int, isVariadic bool, spread bool) {
	if !isVariadic {
		for i := 0; i < len(e.Args); i++ {
			var pIdx int = paramBase + i
			var paramTyp @types.Type = nil
			if pIdx < len(paramTypes) { paramTyp = paramTypes[pIdx] }
			var op @DeferOperand = newDeferArgOp(ctx, entry, e.Args[i], paramTyp)
			site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, op)
			allocNestedDeferBorrowSlots(ctx, entry, site, e.Args[i])
			maybeAllocDeferBorrowSlot(ctx, entry, site, e.Args[i], paramTyp)
		}
		return
	}
	// Variadic: the variadic param is the last, at paramTypes[numParams-1]; the
	// user's fixed args bind to paramTypes[paramBase .. numParams-2].
	var numParams int = len(paramTypes)
	var variadicParamTyp @types.Type = paramTypes[numParams - 1]
	var numFixed int = numParams - 1 - paramBase
	for i := 0; i < numFixed; i++ {
		var op @DeferOperand = newDeferArgOp(ctx, entry, e.Args[i], paramTypes[paramBase + i])
		site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, op)
		allocNestedDeferBorrowSlots(ctx, entry, site, e.Args[i])
		maybeAllocDeferBorrowSlot(ctx, entry, site, e.Args[i], paramTypes[paramBase + i])
	}
	if spread {
		// `xs...`: the single trailing operand bound directly to the `*[]T` param.
		var sOp @DeferOperand = newDeferArgOp(ctx, entry, e.Args[numFixed], variadicParamTyp)
		site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, sOp)
		allocNestedDeferBorrowSlots(ctx, entry, site, e.Args[numFixed])
		return
	}
	// Individual trailing args packed into a `*[]T` header over a backing array.
	var elemTyp @types.Type = variadicParamTyp.SliceElem()
	if elemTyp == nil { elemTyp = variadicParamTyp }
	var pop @DeferOperand = make(DeferOperand)
	pop.Role = OPROLE_VARIADIC_PACK
	pop.ElemTyp = elemTyp
	pop.SlotTyp = variadicParamTyp
	pop.ParamTyp = variadicParamTyp
	allocDeferOperand(ctx, entry, pop)
	// Pre-allocate the backing array at entry depth so its (possibly managed)
	// elements live until the deferred call runs at exit — registered in ctx.Vars
	// (nil-init'd) when they are managed, so the whole-function cleanup / fault
	// pads release them exactly once, after the deferred calls.
	var nTrailing int = len(e.Args) - numFixed
	if nTrailing > 0 {
		var arrTyp @types.Type = types.MakeArrayType(elemTyp, nTrailing)
		var backing @ir.Instr = irbuild.EmitAlloc(entry, arrTyp)
		if needsStructCopy(arrTyp) {
			irbuild.EmitStore(entry, backing, irbuild.EmitConstNil(entry, arrTyp))
			defineDeferSlotVar(ctx, backing, arrTyp)
		}
		pop.BackingSlot = backing
	}
	// A managed element packed into a raw element type is retained in its own
	// entry-depth slot (nil-init'd, released after the deferred calls run), as a
	// managed-to-raw fixed argument is: the backing holds only the borrow.
	for i := numFixed; i < len(e.Args); i++ {
		var retain @ir.Instr = nil
		if isManagedToRawBinding(deferCalleeOwnType(ctx, e.Args[i]), elemTyp) {
			var slotTyp @types.Type = deferSlotType(ctx, e.Args[i])
			retain = irbuild.EmitAlloc(entry, slotTyp)
			irbuild.EmitStore(entry, retain, irbuild.EmitConstNil(entry, slotTyp))
			defineDeferSlotVar(ctx, retain, slotTyp)
		}
		pop.PackRetainSlots = slices.Append[@ir.Instr](pop.PackRetainSlots, retain)
	}
	// Pre-allocate a borrow-snapshot slot for each trailing element that boxes a
	// managed value into the variadic element's iface type (`...*any`) — in
	// element order, after the fixed-arg borrow slots (matching the store-time
	// consumption order: fixed args, then the pack's elements), each after the
	// slots of the borrows nested in it.
	for i := numFixed; i < len(e.Args); i++ {
		allocNestedDeferBorrowSlots(ctx, entry, site, e.Args[i])
		maybeAllocDeferBorrowSlot(ctx, entry, site, e.Args[i], elemTyp)
	}
	site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, pop)
}

// deferArgBorrowVt returns the borrow-temp type an operand expression needs when
// it boxes a managed-content VALUE into an interface type — a parameter, or a
// composite-literal element nested in an operand — replicating the exact
// condition genExprOrFuncRef's value-borrow path uses to enroll a managed
// snapshot temp (an interface-value target, a borrowable non-string-literal value
// source, and a defaulted borrow type that owns a managed reference).  Returns
// nil otherwise.  MUST stay in lockstep with that path (gen_util.bn) so the
// pre-allocated slots match one-for-one what the store consumes.
func deferArgBorrowVt(ctx @GenContext, argExpr @ast.Expr, paramTyp @types.Type) @types.Type {
	if paramTyp == nil || argExpr == nil { return nil }
	var pt @types.Type = types.ResolveAliasAndConst(paramTyp)
	if pt == nil || pt.Kind != types.TYP_INTERFACE_VALUE { return nil }
	if argExpr.Kind == ast.EXPR_STRING_LIT { return nil }
	if ctx.Checker == nil || argExpr.ResolvedTypeID == 0 { return nil }
	var srcT @types.Type = ctx.Checker.ExprType(argExpr.ResolvedTypeID)
	if !isBorrowableValueSource(srcT) { return nil }
	var vt @types.Type = borrowSlotType(ctx, srcT)
	if !borrowTempNeedsCleanup(vt) { return nil }
	return vt
}

// maybeAllocDeferBorrowSlot pre-allocates + nil-inits + registers (entry depth) a
// borrow-snapshot slot for an operand expression bound to paramTyp that needs one
// (deferArgBorrowVt), and appends it to site.BorrowSlots.  A no-op otherwise.
func maybeAllocDeferBorrowSlot(ctx @GenContext, entry @ir.Block, site @DeferSite, argExpr @ast.Expr,
		paramTyp @types.Type) {
	var vt @types.Type = deferArgBorrowVt(ctx, argExpr, paramTyp)
	if vt == nil { return }
	var slot @ir.Instr = irbuild.EmitAlloc(entry, vt)
	irbuild.EmitStore(entry, slot, irbuild.EmitConstNil(entry, vt))
	defineDeferSlotVar(ctx, slot, vt)
	site.BorrowSlots = slices.Append[@ir.Instr](site.BorrowSlots, slot)
}

// allocNestedDeferBorrowSlots pre-allocates the borrow-snapshot slots of the
// value-borrows NESTED in the defer operand expression x: the elements of a
// composite literal (struct, array or slice) bound to an interface type, wherever
// the literal sits in x.  Stored at the defer statement, they must live until the
// deferred call runs, as a top-level operand's do; a temporary of the enclosing
// block would be released when that block ends.  The slots follow the store's
// evaluation order: each element after the borrows nested in it, a struct
// literal's elements in field order (genCompositeLit), other operands left to
// right.  A call's arguments are not walked — they are evaluated with
// ctx.InCallArg set, so their borrows are statement temporaries of the defer
// statement — nor a function literal's body, which is lowered on its own.
func allocNestedDeferBorrowSlots(ctx @GenContext, entry @ir.Block, site @DeferSite, x @ast.Expr) {
	if x == nil || x.Kind == ast.EXPR_FUNC_LIT { return }
	if x.Kind == ast.EXPR_CALL {
		allocNestedDeferBorrowSlots(ctx, entry, site, x.X)
		return
	}
	if x.Kind == ast.EXPR_COMPOSITE {
		allocCompositeDeferBorrowSlots(ctx, entry, site, x)
		return
	}
	allocNestedDeferBorrowSlots(ctx, entry, site, x.X)
	allocNestedDeferBorrowSlots(ctx, entry, site, x.Y)
	allocNestedDeferBorrowSlots(ctx, entry, site, x.Z)
	for i := 0; i < len(x.Args); i++ {
		allocNestedDeferBorrowSlots(ctx, entry, site, x.Args[i])
	}
}

// allocCompositeDeferBorrowSlots is allocNestedDeferBorrowSlots for a composite
// literal x: each element in the order genCompositeLit evaluates it.
func allocCompositeDeferBorrowSlots(ctx @GenContext, entry @ir.Block, site @DeferSite,
		x @ast.Expr) {
	if x.TypeRef == nil { return }
	var typ @types.Type = types.StripWrappers(resolveTypeExpr(ctx.Gc, x.TypeRef))
	if typ == nil { return }
	if typ.Kind == types.TYP_STRUCT {
		var isKeyed bool = len(x.Elems) > 0 && x.Elems[0].Key != nil
		for i := 0; i < len(typ.Fields); i++ {
			if !isKeyed {
				if i < len(x.Elems) {
					allocDeferElemBorrowSlots(ctx, entry, site, x.Elems[i].Value, typ.Fields[i].Type)
				}
				continue
			}
			for j := 0; j < len(x.Elems); j++ {
				if x.Elems[j].Key != nil && irutil.Streq(x.Elems[j].Key.Name, typ.Fields[i].Name) {
					allocDeferElemBorrowSlots(ctx, entry, site, x.Elems[j].Value, typ.Fields[i].Type)
				}
			}
		}
		return
	}
	if typ.Kind == types.TYP_ARRAY || typ.Kind == types.TYP_SLICE ||
			typ.Kind == types.TYP_MANAGED_SLICE {
		for i := 0; i < len(x.Elems); i++ {
			allocDeferElemBorrowSlots(ctx, entry, site, x.Elems[i].Value, typ.Elem)
		}
	}
}

// allocDeferElemBorrowSlots pre-allocates the borrow-snapshot slots of composite
// element v bound to type t: those nested in v, then v's own.
func allocDeferElemBorrowSlots(ctx @GenContext, entry @ir.Block, site @DeferSite, v @ast.Expr,
		t @types.Type) {
	allocNestedDeferBorrowSlots(ctx, entry, site, v)
	maybeAllocDeferBorrowSlot(ctx, entry, site, v, t)
}

// deferRecvValueType returns the type of the value genMethodReceiver yields for
// the receiver of the method selector sel, whose expression has IR-gen type
// recvExprTyp: for an explicit dereference `(*X).m()`, X itself (`&*X == X`),
// or `*X` loaded when X points at a pointer to a struct (genDerefReceiverPtr);
// otherwise recvExprTyp.
func deferRecvValueType(ctx @GenContext, sel @ast.Expr, recvExprTyp @types.Type) @types.Type {
	var x @ast.Expr = sel.X
	if x == nil || x.Kind != ast.EXPR_UNARY || x.Op != cast(int, token.STAR) || x.X == nil ||
			ctx.Checker == nil || x.X.ResolvedTypeID == 0 {
		return recvExprTyp
	}
	var xt @types.Type = irTypeFromChecker(ctx.Gc,
			ir.StripConstForIR(ctx.Checker.ExprType(x.X.ResolvedTypeID)))
	if typePointsAtStructPtr(xt, false) {
		return types.StripWrappers(xt).Elem
	}
	return xt
}

// buildDeferMethod resolves a static method call's mangled symbol + signature,
// builds the receiver operand (converted eagerly at store) and the arg operands.
func buildDeferMethod(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr) {
	var sel @ast.Expr = e.X
	// The method's symbol is keyed on IR-gen's name for the receiver's type (an
	// instantiated struct's mangled name, an imported type's qualified name), as
	// a direct method call's is.  The receiver is not generated yet (defer sites
	// are built at function entry, before any local is declared), so its
	// checker type is mapped to IR-gen's.
	var recvExprTyp @types.Type = irTypeFromChecker(ctx.Gc, methodRecvCheckerType(ctx, sel))
	var recvBaseName @[]char = baseNamedTypeName(recvExprTyp)
	var qual @[]char = buildMethodQualName(ctx.Gc.PkgPath, recvBaseName, sel.Name)
	ensureMethodsForInstName(ctx.Gc, recvBaseName)
	var sig irdata.FuncSig
	var found bool
	sig, found = ensureMethodSig(ctx, qual, selectorMethod(ctx, sel, recvBaseName))
	if !found { panic("defer of an unresolved method call") }
	site.Sym = qual
	site.ResultTyp = deferResultTyp(sig.Results, sig.MultiReturnType)
	var recvParamTyp @types.Type = nil
	if len(sig.Params) > 0 { recvParamTyp = sig.Params[0] }
	var rop @DeferOperand = make(DeferOperand)
	rop.Role = OPROLE_RECEIVER
	rop.ParamTyp = recvParamTyp
	rop.SlotTyp = recvParamTyp
	// A managed receiver of a raw `*T` method is a managed-to-raw borrow: the
	// managed value is retained until the deferred call runs (stmt.defer), as an
	// argument's is, where storing the borrowed raw pointer would leave a call
	// result's temporary freed before the call.
	var recvValTyp @types.Type = deferRecvValueType(ctx, sel, recvExprTyp)
	var rpt @types.Type = ir.StripConstForIR(recvParamTyp)
	if rpt != nil && rpt.Kind == types.TYP_POINTER && irutil.IsManagedPtrType(recvValTyp) {
		rop.IsManagedToRaw = true
		rop.SlotTyp = recvValTyp
	}
	allocDeferOperand(ctx, entry, rop)
	site.RecvOp = rop
	allocNestedDeferBorrowSlots(ctx, entry, site, sel.X)
	buildDeferArgs(ctx, entry, site, e, sig.Params, 1, sig.IsVariadic, e.Spread)
}

// buildDeferIface resolves an interface method's vtable slot + signature, builds
// the iface receiver operand (stored whole) and the arg operands.  The receiver's
// type is IR-gen's (deferSlotType), as an operand slot's is: the interface it
// names is the one IR-gen registered — a generic interface's instance
// (`@Holder[int]`) under IR-gen's instance name, which the checker's type does
// not carry — whose methods findInterfaceMethod looks up.
func buildDeferIface(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr) {
	var sel @ast.Expr = e.X
	var slotTyp @types.Type = types.StripWrappers(deferSlotType(ctx, sel.X))
	var ifaceTyp @types.Type = types.StripWrappers(slotTyp)
	// A pointer to an interface value (`(&iv).M()`, `piv.M()`): the call
	// auto-dereferences it (classifyDeferShape's ifaceReceiverBase), so the
	// receiver stored is the interface value the pointer points at.
	var loadThrough bool = false
	if ifaceTyp != nil &&
			(ifaceTyp.Kind == types.TYP_POINTER || ifaceTyp.Kind == types.TYP_MANAGED_PTR) &&
			ifaceTyp.Elem != nil {
		slotTyp = types.StripWrappers(ifaceTyp.Elem)
		ifaceTyp = slotTyp
		loadThrough = true
	}
	if ifaceTyp == nil || ifaceTyp.Elem == nil { panic("defer of an unresolved interface call") }
	var idx int
	var resultTypes @[]@types.Type
	var paramTypes @[]@types.Type
	var isVariadic bool
	// The interface type carries the interface's full package path — the module
	// interface registry's key — so it is looked up as is (not through the
	// file's import aliases, where an alias spelled like a path segment could
	// rebind it).
	idx, resultTypes, paramTypes, isVariadic = findInterfaceMethod(ctx.Gc.Mod, ifaceTyp.Elem.Pkg,
			ifaceTyp.Elem.Name, sel.Name)
	if idx < 0 { panic("defer of an unresolved interface method") }
	site.MethodIdx = idx
	site.ResultTyp = deferResultTyp(resultTypes, nil)
	var rop @DeferOperand = make(DeferOperand)
	rop.Role = OPROLE_PASSTHRU
	rop.SlotTyp = slotTyp
	rop.LoadThrough = loadThrough
	allocDeferOperand(ctx, entry, rop)
	site.RecvOp = rop
	allocNestedDeferBorrowSlots(ctx, entry, site, sel.X)
	buildDeferArgs(ctx, entry, site, e, paramTypes, 0, isVariadic, e.Spread)
}

// buildDeferFuncVal builds the func-value operand (stored whole) and the arg
// operands from the func-value type's param list.  The function value's type
// is IR-gen's, as an operand slot's is (deferSlotType): with the checker's, a
// generic interface instance among its parameters (`*Holder[int]`) is named
// differently from the argument converted to it, which shows up as an
// interface conversion whose target is no ancestor of its source.
func buildDeferFuncVal(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr) {
	if deferCalleeType(ctx, e.X) == nil { panic("defer of an unresolved function-value call") }
	var fvTyp @types.Type = types.StripWrappers(deferSlotType(ctx, e.X))
	if fvTyp == nil { panic("defer of a function-value call with no IR type") }
	var paramTypes @[]@types.Type
	var isVariadic bool
	paramTypes, isVariadic = funcValueParamTypes(fvTyp)
	site.ResultTyp = deferResultTyp(fvTyp.Results, nil)
	var fop @DeferOperand = make(DeferOperand)
	fop.Role = OPROLE_PASSTHRU
	fop.SlotTyp = fvTyp
	allocDeferOperand(ctx, entry, fop)
	site.RecvOp = fop
	allocNestedDeferBorrowSlots(ctx, entry, site, e.X)
	buildDeferArgs(ctx, entry, site, e, paramTypes, 0, isVariadic, e.Spread)
}

// funcValueParamTypes extracts a function type's parameter TYPES (its Params is
// a @[]@Param carrying names) and reports whether its final parameter is
// variadic.
func funcValueParamTypes(fvTyp @types.Type) (@[]@types.Type, bool) {
	var out @[]@types.Type
	var variadic bool = false
	for i := 0; i < len(fvTyp.Params); i++ {
		out = slices.Append[@types.Type](out, fvTyp.Params[i].Type)
		if fvTyp.Params[i].IsVariadic { variadic = true }
	}
	return out, variadic
}

// buildDeferPanic builds the single message operand for `defer panic(msg)`.
func buildDeferPanic(ctx @GenContext, entry @ir.Block, site @DeferSite, e @ast.Expr) {
	site.ResultTyp = types.TypVoid()
	var msgTyp @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	if len(e.Args) == 0 {
		// panic() with no message: still needs a slot for the empty string.
		var op0 @DeferOperand = make(DeferOperand)
		op0.Role = OPROLE_ARG
		op0.ParamTyp = msgTyp
		op0.SlotTyp = msgTyp
		allocDeferOperand(ctx, entry, op0)
		site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, op0)
		return
	}
	var op @DeferOperand = newDeferArgOp(ctx, entry, e.Args[0], msgTyp)
	site.ArgOps = slices.Append[@DeferOperand](site.ArgOps, op)
	// The message is a char slice, never a borrow of its own; one nested in it
	// (`M{g: w, s: "boom"}.s`) still lives until the call.
	allocNestedDeferBorrowSlots(ctx, entry, site, e.Args[0])
}
