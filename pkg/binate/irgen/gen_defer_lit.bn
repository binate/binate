package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Composite literals addressed in a `defer` statement's operands
// (expr.composite.lifetime): `defer show(&P{…})`, `defer P{…}.Show()` with a
// pointer receiver, `defer f(id(&P{…}))`, `defer g(&@[]int{…}[0])`.  The deferred
// call reads the literal at the function's exit, so it lives until then: the defer
// pre-pass allocates an entry-depth slot for each one (allocDeferLitSlots),
// zeroed at entry and released at the function's exit after the deferred calls
// have run, as a defer's operand slots are, and the literal is built in its slot
// when the defer statement runs (deferLitSlot) rather than in a statement
// temporary.  A defer is never in a loop, so each slot holds the literal of at
// most one execution.

// allocDeferLitSlots allocates the slots of the composite literals the checker
// marked addressed (ast.Expr.LitAddressed) anywhere in the defer operand
// expression x — a function literal's body aside, which is lowered on its own.
func allocDeferLitSlots(ctx @GenContext, entry @ir.Block, x @ast.Expr) {
	if x == nil || x.Kind == ast.EXPR_FUNC_LIT { return }
	if x.Kind == ast.EXPR_COMPOSITE && x.LitAddressed {
		var t @types.Type = deferLitSlotType(ctx, x)
		if t != nil {
			var slot @ir.Instr = irbuild.EmitAlloc(entry, t)
			irbuild.EmitStore(entry, slot, irbuild.EmitConstNil(entry, t))
			defineDeferSlotVar(ctx, slot, t)
			ctx.DeferLitExprs = slices.Append[@ast.Expr](ctx.DeferLitExprs, x)
			ctx.DeferLitSlots = slices.Append[@ir.Instr](ctx.DeferLitSlots, slot)
		}
	}
	allocDeferLitSlots(ctx, entry, x.X)
	allocDeferLitSlots(ctx, entry, x.Y)
	allocDeferLitSlots(ctx, entry, x.Z)
	for i := 0; i < len(x.Args); i++ {
		allocDeferLitSlots(ctx, entry, x.Args[i])
	}
	for i := 0; i < len(x.Elems); i++ {
		if x.Elems[i] != nil { allocDeferLitSlots(ctx, entry, x.Elems[i].Value) }
	}
}

// deferLitSlotType is the type of the storage the composite literal x is built
// in: the underlying struct or array type genCompositeLit allocates, or the
// declared slice type genCompositeAddr stores a slice literal's value in; nil
// for a literal without a type.
func deferLitSlotType(ctx @GenContext, x @ast.Expr) @types.Type {
	var decl @types.Type = compositeDeclType(ctx, x)
	if decl == nil { return nil }
	var t @types.Type = types.StripWrappers(decl)
	if t == nil { return nil }
	if t.Kind == types.TYP_STRUCT || t.Kind == types.TYP_ARRAY { return t }
	if t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE { return decl }
	return nil
}

// deferLitSlot returns the entry-depth slot allocDeferLitSlots allocated for the
// composite literal e, or nil when e is no addressed literal of a defer.
func deferLitSlot(ctx @GenContext, e @ast.Expr) @ir.Instr {
	for i := 0; i < len(ctx.DeferLitExprs); i++ {
		if same(ctx.DeferLitExprs[i], e) { return ctx.DeferLitSlots[i] }
	}
	return nil
}

// literalStorage returns the storage the struct or array literal e, of the
// underlying type typ, is built in: its defer slot (deferLitSlot), or else a
// fresh alloca — registered as a statement temporary when it holds references,
// before its elements are stored (genCompositeLit), and noted when addressed for
// a var initializer to co-scope (noteAddressedLit).
func literalStorage(ctx @GenContext, b @ir.Block, e @ast.Expr, typ @types.Type) @ir.Instr {
	var slot @ir.Instr = deferLitSlot(ctx, e)
	if slot != nil { return slot }
	var p @ir.Instr = irbuild.EmitAlloc(b, typ)
	if needsStructCopy(typ) {
		registerTemp(ctx, p)
		if e.LitAddressed { noteAddressedLit(ctx, p, p) }
	}
	return p
}

// A composite-literal element of a defer operand that is a managed value
// borrowed as a raw one — `defer show(Opts{a: mkT(1)})` with `a *any`, or a `*T`,
// `*[]T`, `*I` or `*func` element from an `@T`, `@[]T`, `@I` or `@func` — keeps
// the managed value alive until the deferred call runs, as a top-level operand's
// does (stmt.defer): it is moved or copied into an entry-depth retain slot the
// pre-pass allocates (maybeAllocDeferElemRetainSlot), released at the function's
// exit after the deferred calls, and the element takes its raw borrow from that
// value.  A statement temporary would be released at the defer statement's end.
// The slots share the borrow-snapshot cursor (ctx.DeferBorrowSlots), so the
// pre-pass and the store visit the elements in one order.  An element inside a
// nested call's arguments is a statement temporary of the defer statement, as
// that call runs at once: the pre-pass does not walk call arguments, and the
// store evaluates them with ctx.InCallArg set.

// maybeAllocDeferElemRetainSlot pre-allocates + nil-inits + registers (entry
// depth) the retain slot of composite element v bound to type t when v is a
// managed value borrowed as a raw one, and appends it to site.BorrowSlots.
func maybeAllocDeferElemRetainSlot(ctx @GenContext, entry @ir.Block, site @DeferSite, v @ast.Expr,
		t @types.Type) {
	if !isManagedToRawBinding(deferCalleeOwnType(ctx, v), t) { return }
	var slotTyp @types.Type = deferSlotType(ctx, v)
	var slot @ir.Instr = irbuild.EmitAlloc(entry, slotTyp)
	irbuild.EmitStore(entry, slot, irbuild.EmitConstNil(entry, slotTyp))
	defineDeferSlotVar(ctx, slot, slotTyp)
	site.BorrowSlots = slices.Append[@ir.Instr](site.BorrowSlots, slot)
}

// genCompositeElem evaluates the composite-literal element v for a slot of type
// t (genExprOrFuncRef).  While a defer's operands are stored, a managed value
// borrowed as a raw element is first retained in its pre-allocated slot, after
// the slots of the borrows nested in v (see maybeAllocDeferElemRetainSlot).
func genCompositeElem(ctx @GenContext, b @ir.Block, v @ast.Expr, t @types.Type) @ir.Instr {
	if !ctx.SnapshotBorrows || ctx.InCallArg || !isManagedToRawBinding(deferCalleeOwnType(ctx, v), t) {
		return genExprOrFuncRef(ctx, b, v, t)
	}
	var slotTyp @types.Type = deferSlotType(ctx, v)
	var val @ir.Instr = genExprOrFuncRef(ctx, b, v, slotTyp)
	if ctx.DeferBorrowCursor >= len(ctx.DeferBorrowSlots) {
		panic("internal error: a deferred call's element borrowed as raw has no pre-allocated slot")
	}
	var slot @ir.Instr = ctx.DeferBorrowSlots[ctx.DeferBorrowCursor]
	if !slot.TypeArg.Identical(slotTyp) {
		panic("internal error: a deferred call's element borrowed as raw took a slot of another type")
	}
	ctx.DeferBorrowCursor = ctx.DeferBorrowCursor + 1
	ctx.CurBlock = emitStoreManagedSlot(ctx, ctx.CurBlock, slot, val, slotTyp, true)
	return convertToIfaceTarget(ctx, ctx.CurBlock, val, t, deferCalleeOwnType(ctx, v))
}
