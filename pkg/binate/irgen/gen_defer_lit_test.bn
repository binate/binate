package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_defer_lit.bn: composite literals addressed in a defer's operands.

// allocsOfStructIn counts the allocas of the struct type named name in fn's
// entry block (entry) or in its other blocks.
func allocsOfStructIn(fn @ir.Func, name *[]readonly char, entry bool) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		if (i == 0) != entry { continue }
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var t @types.Type = types.StripWrappers(ins.TypeArg)
			if ins.Op == iropcode.OP_ALLOC && t != nil && t.Kind == types.TYP_STRUCT &&
					containsSub(t.Name, name) {
				n = n + 1
			}
		}
	}
	return n
}

// A struct literal addressed in a conditional defer's argument, or as a
// pointer-receiver call's receiver, is built in a slot of the function's entry
// block, which the exit releases after the deferred call — not in the `if`
// block, whose storage the exit's cleanup could not reach.
func TestDeferAddressedLiteralEntrySlot() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"type P struct { n int; s @[]char }\n"
					"func (p *P) Show() {}\n"
					"func show(p *P) {}\n"
					"func run(c bool) {\n"
					"  if c {\n"
					"    defer show(&P{n: 1})\n"
					"    defer P{n: 2}.Show()\n"
					"  }\n"
					"}\n"
					"func main() { run(true) }\n")
	var fn @ir.Func = findFunc(m, "run")
	if fn == nil { return fail("run not generated") }
	if allocsOfStructIn(fn, "P", false) != 0 {
		return fail("an addressed literal of a defer must not be allocated in the if block")
	}
	if allocsOfStructIn(fn, "P", true) != 2 { return fail("expected two entry-block slots of P") }
	return ""
}
