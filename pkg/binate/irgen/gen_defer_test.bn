package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Tests for gen_defer.bn (defer statements, §14.13).  genFromSourceWithChecker,
// findFunc, containsSub and fail are shared test helpers.

// callsTo counts fn's calls whose target's name contains name.
func callsTo(fn @ir.Func, name *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		for j := 0; j < len(fn.Blocks[i].Instrs); j++ {
			var ins @ir.Instr = fn.Blocks[i].Instrs[j]
			if ins.Op == iropcode.OP_CALL && containsSub(ins.StrVal, name) { n = n + 1 }
		}
	}
	return n
}

// A deferred block is generated at each exit of its block — a `return` in an
// `if`, and the fall-through end — and the defer statement emits nothing.
func TestDeferGeneratedAtEachExit() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc g() {}\nfunc h() {}\n"
			"func f(c bool) {\n\tdefer { g() }\n\tif c {\n\t\treturn\n\t}\n\th()\n}\n"
	var m @ir.Module = genFromSourceWithChecker(src)
	var fn @ir.Func = findFunc(m, "f")
	if fn == nil { return fail("expected f") }
	if callsTo(fn, "g") != 2 { return fail("the deferred call should be generated at both exits") }
	return ""
}

// A defer in a loop body is generated at the body's exits — its fall-through
// end and a `continue` — not at the function's.
func TestDeferInLoopAtBodyExits() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc g() {}\nfunc h() {}\n"
			"func f(n int) {\n\tfor i := 0; i < n; i++ {\n\t\tdefer { g() }\n"
			"\t\tif i == 1 {\n\t\t\tcontinue\n\t\t}\n\t\th()\n\t}\n\th()\n}\n"
	var m @ir.Module = genFromSourceWithChecker(src)
	var fn @ir.Func = findFunc(m, "f")
	if fn == nil { return fail("expected f") }
	if callsTo(fn, "g") != 2 {
		return fail("the deferred call should be generated at the body's two exits")
	}
	return ""
}

// A defer statement after an exit is not generated at that exit: only the
// defers executed before an exit are pending there.
func TestDeferOnlyBeforeExit() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc g() {}\n"
			"func f(c bool) {\n\tif c {\n\t\treturn\n\t}\n\tdefer { g() }\n}\n"
	var m @ir.Module = genFromSourceWithChecker(src)
	var fn @ir.Func = findFunc(m, "f")
	if fn == nil { return fail("expected f") }
	if callsTo(fn, "g") != 1 {
		return fail("the deferred call should be generated at the fall-through exit only")
	}
	return ""
}

// A function literal in a deferred block generated at two exits is one closure
// site: it is lifted once.
func TestDeferredClosureSiteLiftedOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc use(k *func() int) {}\n"
			"func f(c bool, n int) {\n\tdefer {\n\t\tvar k *func() int = func() int { return n }\n"
			"\t\tuse(k)\n\t}\n\tif c {\n\t\treturn\n\t}\n}\n"
	var m @ir.Module = genFromSourceWithChecker(src)
	var fn @ir.Func = findFunc(m, "f")
	if fn == nil { return fail("expected f") }
	if callsTo(fn, "use") != 2 { return fail("the deferred block should be generated at both exits") }
	var lifted int = 0
	for i := 0; i < len(m.Funcs); i++ {
		if containsSub(m.Funcs[i].Name, "__funclit_") { lifted = lifted + 1 }
	}
	if lifted != 1 { return fail("the function literal should be lifted once") }
	return ""
}
