package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// IR-gen unit tests for defer (§14.13).  These pin the structural invariants of
// the lowering; runtime behavior is covered by the conformance suite
// (conformance/12*_defer_*).

// deferFindFunc returns the module function whose Name equals `name`, or nil.
func deferFindFunc(m @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, name) {
			return m.Funcs[i]
		}
	}
	return nil
}

// deferCountCalls counts direct OP_CALL instructions to symbol `sym` across all
// blocks of `f`.
func deferCountCalls(f @ir.Func, sym *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, sym) {
				n = n + 1
			}
		}
	}
	return n
}

// deferHasOp reports whether `f` contains any instruction with opcode `op`.
func deferHasOp(f @ir.Func, op int) bool {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op {
				return true
			}
		}
	}
	return false
}

// A single `defer g()` emits exactly one deferred call to g (run once at exit),
// plus the armed-flag conditional branch that gates it.
func TestGenDeferEmitsGuardedCall() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\nfunc f() { defer g() }\n")
	var f @ir.Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if deferCountCalls(f, "test.g") != 1 {
		return fail("expected exactly one deferred call to test.g")
	}
	// The armed flag is gated by a conditional branch before the call.
	if !deferHasOp(f, iropcode.OP_BRANCH) {
		return fail("expected an armed-flag conditional branch")
	}
	return ""
}

// Two defers each emit their own guarded call (both run at exit, LIFO).
func TestGenDeferTwoCalls() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\nfunc f() { defer g()\ndefer g() }\n")
	var f @ir.Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if deferCountCalls(f, "test.g") != 2 {
		return fail("expected two deferred calls to test.g")
	}
	return ""
}

// A defer whose statement did not execute is still safe: the armed flag is
// false-initialized at entry (an OP_CONST_BOOL store), so an early exit sweeps a
// nil no-op slot rather than stack garbage.
func TestGenDeferArmedFlagInitialized() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc g() {}\n"
					"func f(c bool) { if c { defer g() } }\n")
	var f @ir.Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	if !deferHasOp(f, iropcode.OP_CONST_BOOL) {
		return fail("expected a false-init of the armed flag (OP_CONST_BOOL)")
	}
	if deferCountCalls(f, "test.g") != 1 {
		return fail("expected one guarded deferred call to test.g")
	}
	return ""
}

// A deferred interface-method call through a pointer to an interface value
// (`(&iv).M()`, `piv.M()`) dispatches through the interface's vtable like the
// plain call: the defer loads the interface value through the pointer when it
// executes, and the exit runs an interface-method call.
func TestGenDeferIfaceMethodThroughPointer() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"interface I { M() }\n"
					"type S struct { n int }\n"
					"func (s *S) M() {}\n"
					"impl *S : I\n"
					"func f(iv *I) { defer (&iv).M() }\n"
					"func g(piv *(*I)) { defer piv.M() }\n")
	var names @[]@[]char = @[]@[]char{"test.f", "test.g"}
	for i := 0; i < len(names); i++ {
		var f @ir.Func = deferFindFunc(m, names[i])
		if f == nil { return fail("function not generated") }
		if !deferHasOp(f, iropcode.OP_CALL_IFACE_METHOD) {
			return fail("a deferred call through a pointer to an interface value must dispatch by vtable")
		}
	}
	return ""
}

// deferMethodCallSym returns the symbol of the first direct call in `f` whose
// symbol ends with `suffix`, or "".
func deferMethodCallSym(f @ir.Func, suffix *[]readonly char) @[]char {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var n int = len(ins.StrVal)
			if ins.Op == iropcode.OP_CALL && n >= len(suffix) && seq(ins.StrVal[n - len(suffix):], suffix) {
				return concatChars("", ins.StrVal)
			}
		}
	}
	return ""
}

// A deferred method call on a local of a generic instantiation — declared after
// the function's entry, where defer sites are built — calls the same method
// symbol as the direct call.
func TestGenDeferMethodOnGenericInstantiation() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\ntype Box[T any] struct { v T }\n"
					"func (b *Box[T]) Get() T { return b.v }\n"
					"func direct() int { var b Box[int]; return b.Get() }\n"
					"func deferred() { var b @Box[int] = make(Box[int]); defer b.Get() }\n")
	var fd @ir.Func = deferFindFunc(m, "test.direct")
	var ff @ir.Func = deferFindFunc(m, "test.deferred")
	if fd == nil || ff == nil { return fail("test.direct / test.deferred not generated") }
	var sym @[]char = deferMethodCallSym(fd, ".Get")
	if len(sym) == 0 { return fail("the direct call to Get not found") }
	if deferCountCalls(ff, sym) != 1 {
		return fail(concatChars("expected one deferred call to ", sym))
	}
	return ""
}
