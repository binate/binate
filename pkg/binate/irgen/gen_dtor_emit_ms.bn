package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// Managed-pointer / func-value / iface-value / managed-slice destructor body
// generators.  Split from gen_dtor_emit_bodies.bn (file-length) at the natural
// "// ===" section boundary; the struct and array dtor bodies stay there, and the
// orchestration (generateDtors, ensureMsDtor) + shared name/path helpers live in
// gen_dtor_emit.bn.

// ============================================================
// Managed-slice destructor generation
// ============================================================

// genManagedPtrDtor emits the `__dtor_mp_<T>` helper for a managed pointer `@T`:
// given a pointer to a cell holding a `@T`, load the `@T` and RefDec it (its own
// dtor — a struct dtor, or another mp/ms-dtor — runs at pointee refcount zero).
// The drop of a `@(@T)` (e.g. `box(mp)` for `mp @Node`) calls this; mirrors
// genManagedSliceDtor but with no element walk.
func genManagedPtrDtor(pkgPath @[]char, name @[]char, mpTyp @types.Type) @ir.Func {
	var ptrParam @ir.Param = make(ir.Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @ir.Func = ir.NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// Reference to parameter 0 — a *uint8 pointing at the cell (which holds a @T).
	var rawPtr @ir.Instr = ir.NewParamRef(f.Params[0])

	// Bitcast to pointer-to-managed-pointer, load the @T value, RefDec it.
	var mpPtrTyp @types.Type = types.MakePointerType(mpTyp)
	var mpPtr @ir.Instr = irbuild.EmitBitCast(entry, rawPtr, mpPtrTyp)
	var mpVal @ir.Instr = irbuild.EmitLoad(entry, mpPtr, mpTyp)
	irbuild.EmitManagedPtrRefDec(f, entry, mpVal)

	var noRetVals @[]@ir.Instr
	irbuild.EmitReturn(entry, noRetVals)
	return f
}

// genManagedFuncValueDtor emits the `__dtor_func` helper for a managed pointer to a
// managed func-value (`@(@func())`): given a pointer to a cell holding a `@func()`,
// load the `@func()` and RefDec its capture record.  The body is signature-
// INDEPENDENT (emitManagedFuncValueRefDec fetches the dtor from the value's own
// vtable), so ONE `__dtor_func` serves every func signature — genManagedFuncValueDtor
// is called with a canonical `@func()` load type.  Unlike genManagedPtrDtor, the
// RefDec splits the block on a null-data guard, so the return is emitted on the
// continuation block it hands back.
func genManagedFuncValueDtor(pkgPath @[]char, name @[]char, fvTyp @types.Type) @ir.Func {
	var ptrParam @ir.Param = make(ir.Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @ir.Func = ir.NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// Reference to parameter 0 — a *uint8 pointing at the cell (which holds a @func()).
	var rawPtr @ir.Instr = ir.NewParamRef(f.Params[0])

	// Bitcast to pointer-to-func-value, load the value, RefDec its capture record.
	var fvPtrTyp @types.Type = types.MakePointerType(fvTyp)
	var fvPtr @ir.Instr = irbuild.EmitBitCast(entry, rawPtr, fvPtrTyp)
	var fvVal @ir.Instr = irbuild.EmitLoad(entry, fvPtr, fvTyp)
	var cont @ir.Block = emitManagedFuncValueRefDec(f, entry, fvVal)

	var noRetVals @[]@ir.Instr
	irbuild.EmitReturn(cont, noRetVals)
	return f
}

// genManagedIfaceValueDtor emits the `__dtor_interface` helper for a managed pointer
// to a managed iface-value (`@(@I)`): given a pointer to a cell holding a `@I`, load
// the `@I` and RefDec its data slot.  The body is interface-INDEPENDENT
// (emitManagedIfaceValueRefDec fetches the receiver dtor from the value's own vtable
// at runtime), so ONE `__dtor_interface` serves every interface — called with a
// canonical iface-value load type.  Like genManagedFuncValueDtor, the RefDec splits
// the block on a null-data guard, so the return lands on the continuation block.
func genManagedIfaceValueDtor(pkgPath @[]char, name @[]char, ivTyp @types.Type) @ir.Func {
	var ptrParam @ir.Param = make(ir.Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @ir.Func = ir.NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// Reference to parameter 0 — a *uint8 pointing at the cell (which holds a @I).
	var rawPtr @ir.Instr = ir.NewParamRef(f.Params[0])

	// Bitcast to pointer-to-iface-value, load the value, RefDec its data slot.
	var ivPtrTyp @types.Type = types.MakePointerType(ivTyp)
	var ivPtr @ir.Instr = irbuild.EmitBitCast(entry, rawPtr, ivPtrTyp)
	var ivVal @ir.Instr = irbuild.EmitLoad(entry, ivPtr, ivTyp)
	var cont @ir.Block = emitManagedIfaceValueRefDec(f, entry, ivVal)

	var noRetVals @[]@ir.Instr
	irbuild.EmitReturn(cont, noRetVals)
	return f
}

// genManagedSliceDtor generates a destructor for a managed-slice type @[]T.
// It checks if the backing is the last reference, iterates elements to
// clean them up, then RefDec's the backing allocation.
func genManagedSliceDtor(pkgPath @[]char, name @[]char, msTyp @types.Type) @ir.Func {
	var ptrParam @ir.Param = make(ir.Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type

	var f @ir.Func = ir.NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// Reference to parameter 0
	var rawPtr @ir.Instr = ir.NewParamRef(f.Params[0])

	// Bitcast to managed-slice pointer, load the 4-word value
	var msPtrTyp @types.Type = types.MakePointerType(msTyp)
	var msPtr @ir.Instr = irbuild.EmitBitCast(entry, rawPtr, msPtrTyp)
	var msVal @ir.Instr = irbuild.EmitLoad(entry, msPtr, msTyp)

	// Extract backing refptr
	var refptr @ir.Instr = irbuild.EmitExtract(entry, msVal, 2, types.MakeManagedPtrType(nil))

	// peelTransparent so a `readonly`/named/alias-wrapped element dispatches on
	// its underlying kind below — mirroring genStructDtorWithName.  Without it a
	// `@[]readonly @Node` element (kind TYP_READONLY) misses the TYP_MANAGED_PTR
	// arm and falls to the generic `else`, emitting a call to an inline-only
	// managed-pointer "dtor helper" (`__dtor_mp_Node`) that is never generated —
	// an undefined-symbol link failure.
	var elemTyp @types.Type = irutil.PeelTransparent(msTyp.Elem)

	// If elements don't need destruction, just RefDec the backing and return
	if !elemTyp.NeedsDestruction() {
		irbuild.EmitRefDec(entry, refptr)
		var noRetVals2 @[]@ir.Instr
		irbuild.EmitReturn(entry, noRetVals2)
		return f
	}

	// Managed element: delegate the refcount==1-guarded element loop + backing
	// RefDec to the shared scalar-arg __dtor_ms_elems_<T> helper (ensureMsDtor
	// emits it alongside this dtor), passing the backing pointer + length directly.
	// The SROA-shape inline cleanup calls that same helper, so the element-loop body is
	// generated once and both cleanup shapes agree.
	var backingLen @ir.Instr = irbuild.EmitExtract(entry, msVal, 3, types.TypInt())
	var backingPtrRaw @ir.Instr = irbuild.EmitBitCast(entry, refptr,
			types.MakePointerType(types.TypUint8()))
	var elemsArgs @[]@ir.Instr = make_slice(@ir.Instr, 2)
	elemsArgs[0] = backingPtrRaw
	elemsArgs[1] = backingLen
	irbuild.EmitCallLocal(entry, irutil.MsElemsDtorName(msTyp), elemsArgs, types.TypVoid())

	var noRetVals @[]@ir.Instr
	irbuild.EmitReturn(entry, noRetVals)
	return f
}

// emitMsElemsCleanup emits the managed-slice element cleanup into `entry`, given
// the backing refptr (@ptr) and backingLen (int): if the backing's refcount is 1
// (the last reference, so its elements are about to be freed), iterate the
// backingLen elements calling each element's RefDec / dtor; then RefDec the
// backing.  Returns the exit block (the caller emits the return).  This is the one
// place the element loop is generated — genManagedSliceElemsDtor is its only
// caller; the by-address __dtor_<T> and the SROA-shape inline cleanup both reach it by
// calling that helper.  refptr must be the BACKING start (slice-image slot 2), not
// the data pointer, which after subslicing may point into the middle of the
// backing.  The caller guarantees peelTransparent(elemTyp) NeedsDestruction.
func emitMsElemsCleanup(f @ir.Func, entry @ir.Block, refptr @ir.Instr, backingLen @ir.Instr,
		elemTyp @types.Type) @ir.Block {
	var backingPtr @ir.Instr = irbuild.EmitBitCast(entry, refptr,
			types.MakePointerType(types.TypUint8()))

	// Check: refcount == 1 (last reference, safe to clean up elements)
	var rcArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rcArgs[0] = refptr
	var rc @ir.Instr = irbuild.EmitCall(entry, "pkg/builtins/rt.Refcount", rcArgs, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var isLast @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_EQ, rc, one, types.TypBool())

	var loopInit @ir.Block = ir.AddBlock(f, "ms_dtor_init")
	var exitBlock @ir.Block = ir.AddBlock(f, "ms_dtor_exit")

	irbuild.EmitBranch(entry, isLast, loopInit, exitBlock)

	// Loop counter via alloca
	var iSlot @ir.Instr = irbuild.EmitAlloc(loopInit, types.TypInt())
	var zero @ir.Instr = irbuild.EmitConstInt(loopInit, 0, types.TypInt())
	irbuild.EmitStore(loopInit, iSlot, zero)

	var loopCond @ir.Block = ir.AddBlock(f, "ms_dtor_cond")
	irbuild.EmitJump(loopInit, loopCond)

	// Loop condition: i < backing_len
	var iv @ir.Instr = irbuild.EmitLoad(loopCond, iSlot, types.TypInt())
	var cmp @ir.Instr = irbuild.EmitBinop(loopCond, iropcode.OP_LT, iv, backingLen, types.TypBool())
	var loopBody @ir.Block = ir.AddBlock(f, "ms_dtor_body")
	irbuild.EmitBranch(loopCond, cmp, loopBody, exitBlock)

	// Loop body: compute element address, call element cleanup
	var elemSize @ir.Instr = irbuild.EmitConstInt(loopBody, elemTyp.SizeOf(), types.TypInt())
	var offset @ir.Instr = irbuild.EmitBinop(loopBody, iropcode.OP_MUL, iv, elemSize, types.TypInt())
	var elemAddr @ir.Instr = irbuild.EmitGetElemPtr(loopBody, backingPtr, offset, types.TypUint8())
	var elemRawPtr @ir.Instr = irbuild.EmitBitCast(loopBody, elemAddr,
			types.MakePointerType(types.TypUint8()))

	switch elemTyp.Kind {
	case types.TYP_MANAGED_PTR:
		// Element is @T — load the pointer, RefDec with pointee dtor
		var elemPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedElemPtr @ir.Instr = irbuild.EmitBitCast(loopBody, elemAddr, elemPtrTyp)
		var elem @ir.Instr = irbuild.EmitLoad(loopBody, typedElemPtr, elemTyp)
		irbuild.EmitManagedPtrRefDec(f, loopBody, elem)
	case types.TYP_MANAGED_FUNC_VALUE:
		// Element is @func — load it and RefDec its data slot (slot 1).
		var elemFvPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedFvPtr @ir.Instr = irbuild.EmitBitCast(loopBody, elemAddr, elemFvPtrTyp)
		var fvElem @ir.Instr = irbuild.EmitLoad(loopBody, typedFvPtr, elemTyp)
		loopBody = emitManagedFuncValueRefDec(f, loopBody, fvElem)
	case types.TYP_INTERFACE_VALUE_MANAGED:
		// Element is @Iface — load it and RefDec its data slot (field 0).
		var elemIvPtrTyp @types.Type = types.MakePointerType(elemTyp)
		var typedIvPtr @ir.Instr = irbuild.EmitBitCast(loopBody, elemAddr, elemIvPtrTyp)
		var ivElem @ir.Instr = irbuild.EmitLoad(loopBody, typedIvPtr, elemTyp)
		loopBody = emitManagedIfaceValueRefDec(f, loopBody, ivElem)
	default:
		// Element is struct, @[]T, [N]T — call element type's dtor
		emitDtorOrCopyCall(f, loopBody, elemDtorName(elemTyp), elemRawPtr, isElemDtorModuleLocal(elemTyp))
	}

	// Increment counter, loop back
	var iNext @ir.Instr = irbuild.EmitBinop(loopBody, iropcode.OP_ADD, iv, one, types.TypInt())
	irbuild.EmitStore(loopBody, iSlot, iNext)
	irbuild.EmitJump(loopBody, loopCond)

	// Exit: RefDec the backing allocation (no dtor — it's raw memory)
	irbuild.EmitRefDec(exitBlock, refptr)
	return exitBlock
}

// genManagedSliceElemsDtor generates the scalar-arg element-cleanup helper
// `__dtor_ms_elems_<T>(backingPtr *uint8, backingLen int)` for a managed slice
// @[]@E — the shared body (emitMsElemsCleanup) the by-address __dtor_<T> AND the
// SROA-shape inline cleanup both call.  Taking the backing pointer + length as SCALARS
// (rather than a 4-word slice image by address) is exactly what lets the inline
// cleanup read them via extract-2 / extract-3 of the slice value and stay
// SROA-forwardable.  Only generated for a destruction-needing element.
func genManagedSliceElemsDtor(pkgPath @[]char, name @[]char, msTyp @types.Type) @ir.Func {
	var bpParam @ir.Param = make(ir.Param)
	bpParam.Name = "backingPtr"
	bpParam.Typ = types.MakePointerType(types.TypUint8())
	var blParam @ir.Param = make(ir.Param)
	blParam.Name = "backingLen"
	blParam.Typ = types.TypInt()
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = bpParam
	params[1] = blParam
	var noResults @[]@types.Type

	var f @ir.Func = ir.NewFunc(pkgPath, name, params, noResults)
	f.IsLinkOnce = true
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var backingPtrRaw @ir.Instr = ir.NewParamRef(f.Params[0])
	var backingLen @ir.Instr = ir.NewParamRef(f.Params[1])
	// Reconstitute the @ptr refptr for the backing RefDec.  The param is a raw
	// *uint8 (like every other dtor helper's param) so no managed-param
	// auto-refcount convention interferes with the single explicit RefDec.
	var refptr @ir.Instr = irbuild.EmitBitCast(entry, backingPtrRaw, types.MakeManagedPtrType(nil))
	var elemTyp @types.Type = irutil.PeelTransparent(msTyp.Elem)
	var b @ir.Block = emitMsElemsCleanup(f, entry, refptr, backingLen, elemTyp)

	var noRetVals @[]@ir.Instr
	irbuild.EmitReturn(b, noRetVals)
	return f
}
