package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// Utility function tests
// ============================================================

func TestShortPkgNameQuotedSlash() testing.TestResult {
	var result *[]readonly char = shortPkgName("\"pkg/binate/parser\"")
	if !charsEqual(result, "parser") {
		return fail("shortPkgName(\"pkg/binate/parser\") should be parser")
	}
	return ""
}

func TestShortPkgNameQuotedNoSlash() testing.TestResult {
	var result *[]readonly char = shortPkgName("\"main\"")
	if !charsEqual(result, "main") {
		return fail("shortPkgName(\"main\") should be main")
	}
	return ""
}

func TestShortPkgNameUnquoted() testing.TestResult {
	var result *[]readonly char = shortPkgName("main")
	if !charsEqual(result, "main") {
		return fail("shortPkgName(main) should be main")
	}
	return ""
}

func TestDotPrefixWithDot() testing.TestResult {
	if !charsEqual(dotPrefix("ast.File"), "ast") {
		return fail("dotPrefix(ast.File) should be ast")
	}
	return ""
}

func TestDotPrefixNoDot() testing.TestResult {
	if !charsEqual(dotPrefix("Node"), "Node") {
		return fail("dotPrefix(Node) should be Node")
	}
	return ""
}

func TestDotSuffixWithDot() testing.TestResult {
	if !charsEqual(irutil.DotSuffix("ast.File"), "File") {
		return fail("dotSuffix(ast.File) should be File")
	}
	return ""
}

func TestDotSuffixNoDot() testing.TestResult {
	if !charsEqual(irutil.DotSuffix("Node"), "Node") {
		return fail("dotSuffix(Node) should be Node")
	}
	return ""
}

func TestHasDotTrue() testing.TestResult {
	if !hasDot("ast.File") {
		return fail("hasDot(ast.File) should be true")
	}
	return ""
}

func TestHasDotFalse() testing.TestResult {
	if hasDot("Node") {
		return fail("hasDot(Node) should be false")
	}
	return ""
}

func TestHasNameEmpty() testing.TestResult {
	var empty @[]@[]char
	if irutil.HasName(empty, "foo") {
		return fail("hasName on empty list should be false")
	}
	return ""
}

func TestHasNameMatch() testing.TestResult {
	var names @[]@[]char = @[]@[]char{"alpha", "beta"}
	if !irutil.HasName(names, "beta") {
		return fail("hasName should find beta")
	}
	return ""
}

func TestHasNameNoMatch() testing.TestResult {
	var names @[]@[]char = @[]@[]char{"alpha", "beta"}
	if irutil.HasName(names, "gamma") {
		return fail("hasName should not find gamma")
	}
	return ""
}

// generateDtors and generateCopies close the layout query each holds open: a struct
// laid out after them, whose field's type then changes, is laid out again (a query
// left open would keep its first layout).
func TestDtorsAndCopiesCloseTheirLayoutQuery() testing.TestResult {
	var m @ir.Module = InitModule("\"pkg/t\"")
	m.PkgPath = buf.CopyStr("pkg/t")
	generateDtors(m)
	generateCopies(m)
	var n @types.Type = types.MakeNamedType(buf.CopyStr("N"))
	n.Underlying = types.TypInt()
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = buf.CopyStr("f")
	fields[0].Type = n
	var st @types.Type = types.MakeStructType(buf.CopyStr("pkg/t.S"), fields)
	var before int64 = st.Size()
	n.Underlying = types.MakeArrayType(types.TypInt(), 4)
	if st.Size() != 4 * before {
		return fail("the struct is laid out again after its field's type changes")
	}
	return ""
}
