package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/std/containers/vec"

// Destructor helpers the module's struct destructors and drops call: the managed-slice,
// managed-pointer, func-value, interface-value and array destructors (each generated
// once, recorded in `generated`), and extern declarations of another package's.

// ensureMsDtor ensures a managed-slice dtor exists for the given type, after the
// helpers its body calls for the element (ensureDtorHelpers).
func ensureMsDtor(m @ir.Module, msTyp @types.Type, generated @helperNames) {
	ensureDtorHelpers(m, helperMs, msTyp, generated)
}

// ensureMpDtor ensures a managed-POINTER dtor (`__dtor_mp_<T>`) exists for a `@T`
// type, after the pointee's (ensureDtorHelpers).
func ensureMpDtor(m @ir.Module, mpTyp @types.Type, generated @helperNames) {
	ensureDtorHelpers(m, helperMp, mpTyp, generated)
}

// ensureNestedMptrPointeeDtor ensures the pointee dtor for a managed-pointer-to-
// managed-value type — `@(@[]T)` (→ the pointee ms-dtor), `@(@T)` (→ the pointee
// mp-dtor), or `@([N]@Node)` (→ the pointee array-dtor).  The drop of such a
// field/element goes through emitManagedPtrRefDec, whose dtor reference a synthesized
// (module-less) dtor body can't register at emit time, so the emission passes ensure
// it here.  No-op for any other type.
func ensureNestedMptrPointeeDtor(m @ir.Module, t @types.Type, generated @helperNames) {
	var kind int
	var pointee @types.Type
	kind, pointee = pointeeHelper(t)
	if kind == helperNone { return }
	ensureDtorHelpers(m, kind, pointee, generated)
}

// ensureFuncValueDtor emits the single signature-independent `__dtor_func` managed-
// func-value dtor if the module needs it and it isn't already generated.  Called for
// a `@(@func())` pointee (ensureNestedMptrPointeeDtor) and drained from the
// NeedsFuncValueDtor flag.  One canonical `@func()` load type serves every signature.
func ensureFuncValueDtor(m @ir.Module, generated @helperNames) {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noParams, noResults)
	var name @[]char = irutil.DtorNameForType(fvTyp)
	if generated.has(name) { return }
	var dtorFunc @ir.Func = genManagedFuncValueDtor(m.PkgPath, name, fvTyp)
	m.AddFunc(dtorFunc)
	generated.add(name)
}

// ensureIfaceValueDtor emits the single interface-independent `__dtor_interface`
// managed-iface-value dtor if the module needs it and it isn't already generated.
// Called for a `@(@I)` pointee (ensureNestedMptrPointeeDtor) and drained from the
// NeedsIfaceValueDtor flag.  A canonical iface-value load type serves every interface
// (the receiver dtor is fetched from the value's own vtable at runtime).
func ensureIfaceValueDtor(m @ir.Module, generated @helperNames) {
	var ivTyp @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("", "any"))
	var name @[]char = irutil.DtorNameForType(ivTyp)
	if generated.has(name) { return }
	var dtorFunc @ir.Func = genManagedIfaceValueDtor(m.PkgPath, name, ivTyp)
	m.AddFunc(dtorFunc)
	generated.add(name)
}

// ensureArrayDtor ensures an array dtor exists for the given type, after the helpers
// its body calls for the element (ensureDtorHelpers).
func ensureArrayDtor(m @ir.Module, arrTyp @types.Type, generated @helperNames) {
	ensureDtorHelpers(m, helperArray, arrTyp, generated)
}

// declareExternDtor adds an extern function declaration for a cross-package dtor.
func declareExternDtor(m @ir.Module, name @[]char) {
	var ptrParam @ir.Param = make(ir.Param)
	ptrParam.Name = "ptr"
	ptrParam.Typ = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = ptrParam
	var noResults @[]@types.Type
	var ef @ir.Func = irbuild.NewExternFunc(m.PkgPath, name, params, noResults)
	m.AddFunc(ef)
}

// helperNone is no destructor helper (pointeeHelper's answer for a type needing none).
const helperNone int = 0

// helperMs is a managed-slice's destructor (genManagedSliceDtor), with its elements'
// (genManagedSliceElemsDtor) when they need destruction.
const helperMs int = 1

// helperMp is a managed pointer's destructor (genManagedPtrDtor).
const helperMp int = 2

// helperArray is an array's destructor (genArrayDtor).
const helperArray int = 3

// helperFuncValue is the single managed function value destructor (ensureFuncValueDtor).
const helperFuncValue int = 4

// helperIfaceValue is the single managed interface value destructor
// (ensureIfaceValueDtor).
const helperIfaceValue int = 5

// A helperPart is a helper a destructor helper's body calls, ensured before it: its
// kind and type.
type helperPart struct {
	kind int
	typ  @types.Type
}

// A helperFrame is a managed-slice, managed-pointer or array destructor being
// ensured: its kind, type and name, the helpers its body calls and how many of them
// have been ensured.
type helperFrame struct {
	kind  int
	typ   @types.Type
	name  @[]char
	parts @vec.Vec[@helperPart]
	next  int
}

// ensureDtorHelpers ensures the destructor helper of the given kind for t, and each
// helper its body calls for the element before it, depth first, each once (recorded
// in `generated`).  It works from a stack of its own, not a call per helper: an
// element can be a named type whose definition holds the next one (`type L0 @[]L1`,
// `type L1 @[]L2`, ...), and a ring of such types is as long as a package makes it.
// A helper is recorded before its element's are ensured: a type that reaches itself
// (`type Tree @[]Tree`) needs its own helper as its element's, and its body then calls
// itself by name.
func ensureDtorHelpers(m @ir.Module, kind int, t @types.Type, generated @helperNames) {
	var frames @vec.Vec[@helperFrame] = vec.New[@helperFrame]()
	startDtorHelper(m, frames, kind, t, generated)
	for frames.Len() > 0 {
		var f @helperFrame = frames.Get(frames.Len() - 1)
		if f.next < f.parts.Len() {
			var p @helperPart = f.parts.Get(f.next)
			f.next += 1
			startDtorHelper(m, frames, p.kind, p.typ, generated)
			continue
		}
		_, _ = frames.Pop()
		finishDtorHelper(m, f, generated)
	}
}

// startDtorHelper starts ensuring the helper of the given kind for t: the single
// function-value or interface-value destructor at once, and a managed-slice,
// managed-pointer or array one not yet generated by recording its name and pushing it
// on frames with the helpers its body calls.
func startDtorHelper(m @ir.Module, frames @vec.Vec[@helperFrame], kind int, t @types.Type,
		generated @helperNames) {
	if kind == helperFuncValue {
		ensureFuncValueDtor(m, generated)
		return
	}
	if kind == helperIfaceValue {
		ensureIfaceValueDtor(m, generated)
		return
	}
	var name @[]char = irutil.DtorNameForType(t)
	if generated.has(name) { return }
	generated.add(name)
	var f @helperFrame = make(helperFrame)
	f.kind = kind
	f.typ = t
	f.name = name
	f.parts = dtorHelperParts(kind, t)
	frames.Push(f)
}

// dtorHelperParts returns the helpers the body of t's destructor (a managed-slice's,
// a managed pointer's or an array's, by kind) calls for its element, in the order they
// are ensured.  A managed-slice element needs its ms-dtor; a managed-pointer element
// of a managed pointer its mp-dtor; a `@(@[]T)` / `@(@T)` element (a managed pointer
// to a managed value) of a managed-slice or an array its pointee's (pointeeHelper);
// and an ARRAY element its array dtor — without it, `@[]([N]@T)` named a local
// __dtor_arrN_... it never emitted (clang "use of undefined value").  A struct
// element's dtor comes from the module-structs / pending-dtor pass, not from here.
// StripWrappers (not the raw .Elem): a NAMED-distinct transparent wrapper element
// (`type Buf @[]@T`) must be classified by its UNDERLYING kind, else its helper is
// never emitted -- the outer body still calls it (by the wrapper's underlying name,
// since dtorNameForType peels NAMED), so the call references a symbol no pass
// produces (undefined value / VM extern not found).  Mirrors the StripWrappers the
// struct field-walk already applies.
func dtorHelperParts(kind int, t @types.Type) @vec.Vec[@helperPart] {
	var parts @vec.Vec[@helperPart] = vec.New[@helperPart]()
	var elem @types.Type = types.StripWrappers(t.Elem)
	if elem == nil { return parts }
	if elem.Kind == types.TYP_MANAGED_SLICE { addHelperPart(parts, helperMs, elem) }
	if kind == helperMp {
		if elem.Kind == types.TYP_MANAGED_PTR { addHelperPart(parts, helperMp, elem) }
		return parts
	}
	var pointeeKind int
	var pointee @types.Type
	pointeeKind, pointee = pointeeHelper(elem)
	if pointeeKind != helperNone { addHelperPart(parts, pointeeKind, pointee) }
	if elem.Kind == types.TYP_ARRAY && elem.Elem != nil && elem.Elem.NeedsDestruction() {
		addHelperPart(parts, helperArray, elem)
	}
	return parts
}

// addHelperPart appends the helper of the given kind for t to parts.
func addHelperPart(parts @vec.Vec[@helperPart], kind int, t @types.Type) {
	var p @helperPart = make(helperPart)
	p.kind = kind
	p.typ = t
	parts.Push(p)
}

// pointeeHelper returns the helper the drop of a value of type t calls for what it
// points to, when t is a managed pointer to a managed value — `@(@[]T)` (the pointee's
// ms-dtor), `@(@T)` (its mp-dtor), `@([N]@T)` (its array dtor), `@(@func())` and
// `@(@I)` (the single function-value and interface-value destructors) — with the
// pointee's type, or helperNone.
func pointeeHelper(t @types.Type) (int, @types.Type) {
	var none @types.Type
	if t == nil || t.Kind != types.TYP_MANAGED_PTR || t.Elem == nil { return helperNone, none }
	var pointee @types.Type = types.StripWrappers(t.Elem)
	if pointee == nil { return helperNone, none }
	if pointee.Kind == types.TYP_MANAGED_SLICE { return helperMs, pointee }
	if pointee.Kind == types.TYP_MANAGED_PTR { return helperMp, pointee }
	if pointee.Kind == types.TYP_ARRAY && pointee.Elem != nil && pointee.Elem.NeedsDestruction() {
		return helperArray, pointee
	}
	if pointee.Kind == types.TYP_MANAGED_FUNC_VALUE { return helperFuncValue, pointee }
	if pointee.Kind == types.TYP_INTERFACE_VALUE_MANAGED { return helperIfaceValue, pointee }
	return helperNone, none
}

// finishDtorHelper adds the body of f's helper, the helpers it calls all ensured.  A
// managed-slice destructor whose element needs destruction is joined by the scalar-arg
// __dtor_ms_elems_<T> helper the by-address one delegates to (and the SROA-shape
// inline cleanup calls) — a distinct name (msElemsDtorName), so its own guard in
// `generated`.
func finishDtorHelper(m @ir.Module, f @helperFrame, generated @helperNames) {
	if f.kind == helperMp {
		m.AddFunc(genManagedPtrDtor(m.PkgPath, f.name, f.typ))
		return
	}
	if f.kind == helperArray {
		m.AddFunc(genArrayDtor(m.PkgPath, f.name, f.typ))
		return
	}
	m.AddFunc(genManagedSliceDtor(m.PkgPath, f.name, f.typ))
	var elem @types.Type = types.StripWrappers(f.typ.Elem)
	if elem != nil && elem.NeedsDestruction() {
		var elemsName @[]char = irutil.MsElemsDtorName(f.typ)
		if !generated.has(elemsName) {
			m.AddFunc(genManagedSliceElemsDtor(m.PkgPath, elemsName, f.typ))
			generated.add(elemsName)
		}
	}
}
