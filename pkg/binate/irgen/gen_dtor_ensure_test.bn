package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// ============================================================
// declareExternDtor tests
// ============================================================

func TestDeclareExternDtor() testing.TestResult {
	var m @ir.Module = InitModule("test")
	declareExternDtor(m, "__dtor_Foo")
	if len(m.Funcs) != 1 {
		return fail("declareExternDtor should add 1 func")
	}
	var ef @ir.Func = m.Funcs[0]
	if !charsEqual(ef.Name, "__dtor_Foo") {
		return fail("extern dtor name should be __dtor_Foo")
	}
	if !ef.IsExtern {
		return fail("extern dtor should be extern")
	}
	if len(ef.Params) != 1 {
		return fail("extern dtor should have 1 param")
	}
	return ""
}

// deepRing is how many named types the deep test's ring holds: far past what a walk
// with a call per helper could hold on its stack.
const deepRing int = 100000

// The helpers a ring of named managed-slices far longer than a stack could follow
// needs are all generated, each once and depth first: each type's ms-dtor and its
// elements' helper, the ring's last first.
func TestDeepNamedSliceRingDtorHelpers() testing.TestResult {
	setTarget64()
	var ring @[]@types.Type = make_slice(@types.Type, deepRing)
	for i := 0; i < deepRing; i++ {
		ring[i] = types.MakeNamedType(buf.Concat("L", strconv.Itoa(i)))
	}
	for i := 0; i < deepRing; i++ {
		ring[i].Underlying = types.MakeManagedSliceTypeUncached(ring[(i + 1) % deepRing])
	}
	var m @ir.Module = InitModule("test")
	ensureMsDtor(m, ring[0].Underlying, newHelperNames())
	var firstWant @[]char = irutil.DtorNameForType(ring[deepRing - 1].Underlying)
	var lastWant @[]char = irutil.DtorNameForType(ring[0].Underlying)
	for i := 0; i < deepRing; i++ {
		ring[i].Underlying = nil
	}
	var n int = len(m.Funcs)
	if n != 2 * deepRing {
		return fail("each type of the ring should have its ms-dtor and elements' helper")
	}
	if !charsEqual(unqualifiedHelperName(m.Funcs[0].Name), firstWant) {
		return fail("the ring's last type's ms-dtor should come first")
	}
	if !charsEqual(unqualifiedHelperName(m.Funcs[n - 2].Name), lastWant) {
		return fail("the ms-dtor the walk started from should come last, before its elements' helper")
	}
	return ""
}
