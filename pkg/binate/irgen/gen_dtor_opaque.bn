package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/stdx/slices"

// Destructors of opaque types defined as something other than a struct literal,
// and the helpers destroying a value in place calls.

// ensureValueDtorHelpers ensures the helpers emitValueRefDecsAt calls to destroy a
// value of type t (wrappers stripped) in place: a managed slice's ms-dtor, an array's
// dtor, and for a managed pointer to a managed value (`@(@[]T)` / `@(@T)`, e.g.
// `Box[@[]int]`'s `p @T`) the pointee's ms- / mp-dtor its RefDec runs — a struct
// or named dtor body is generated with a module-less func, so it cannot register
// them while it is emitted.
func ensureValueDtorHelpers(m @ir.Module, t @types.Type, generated @[]@[]char) @[]@[]char {
	if t.Kind == types.TYP_MANAGED_SLICE {
		generated = ensureMsDtor(m, t, generated)
	}
	generated = ensureNestedMptrPointeeDtor(m, t, generated)
	if t.Kind == types.TYP_ARRAY && t.Elem.NeedsDestruction() {
		generated = ensureArrayDtor(m, t, generated)
	}
	return generated
}

// generateOpaqueNamedDtors emits the public destructor of each of the module's
// opaque types defined as something other than a struct literal (`type X` in the
// .bni, `type X @[]char` in the .bn) and ensures the helpers it calls.  An importer
// releases an `@X` through `<pkg>.__dtor_X` by name, so it must exist whatever X's
// definition; one defined as a struct literal gets its struct dtor (generateDtors).
// The module's references to another package's opaque types get that package's
// dtor declared extern, as an imported struct's is.
func generateOpaqueNamedDtors(m @ir.Module, modPkg *[]readonly char,
		generated @[]@[]char) @[]@[]char {
	for i := 0; i < len(m.TypeAliases); i++ {
		var t @types.Type = m.TypeAliases[i].Typ
		var name @[]char = m.TypeAliases[i].Name
		if t == nil || t.Kind != types.TYP_NAMED || len(t.OpaqueExportPkg) == 0 || !hasDot(name) {
			continue
		}
		if !irutil.Streq(dotPrefix(name), modPkg) {
			var ext @[]char = irutil.QualifiedDtorName(name)
			if !funcAlreadyDeclared(m, ext) {
				declareExternDtor(m, ext)
			}
			continue
		}
		var def @types.Type = t.Underlying
		if def == nil { continue }
		var dname @[]char = irutil.DtorName(irutil.DotSuffix(name))
		if irutil.HasName(generated, dname) { continue }
		var dtorFunc @ir.Func = genNamedDtorWithName(m.PkgPath, dname, def)
		dtorFunc.IsStructDtor = true
		m.AddFunc(dtorFunc)
		generated = slices.Append[@[]char](generated, dname)
		generated = ensureValueDtorHelpers(m, types.StripWrappers(def), generated)
	}
	return generated
}
