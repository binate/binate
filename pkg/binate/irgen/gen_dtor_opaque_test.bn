package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_dtor_opaque.bn.

// addOpaqueNamed registers in m the named type `name` stamped opaque-exported by
// pkg, with the given underlying (nil: not defined yet), and returns it.
func addOpaqueNamed(m @ir.Module, name @[]char, pkg @[]char, underlying @types.Type) @types.Type {
	var ta irsym.ModuleTypeAlias
	ta.Name = name
	var t @types.Type = types.MakeNamedType(name)
	t.OpaqueExportPkg = pkg
	t.Underlying = underlying
	ta.Typ = t
	m.TypeAliases = slices.Append[irsym.ModuleTypeAlias](m.TypeAliases, ta)
	return t
}

// The module's own opaque type defined as a managed slice of managed pointers
// gets a public dtor, and the managed-slice dtor it calls.
func TestGenerateOpaqueNamedDtors() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var inner @types.Type = types.MakeStructType("pkg/op.Inner", noFields)
	var sl @types.Type = types.MakeManagedSliceType(types.MakeManagedPtrType(inner))
	addOpaqueNamed(m, "pkg/op.SL", "pkg/op", sl)
	var none @[]@[]char
	var generated @[]@[]char = generateOpaqueNamedDtors(m, "pkg/op", none)
	if !irutil.HasName(generated, irutil.DtorName("SL")) { return fail("SL's dtor not generated") }
	if !irutil.HasName(generated, irutil.DtorNameForType(sl)) {
		return fail("the ms-dtor not ensured")
	}
	var dtorFound bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if m.Funcs[i].IsStructDtor { dtorFound = true }
	}
	if !dtorFound { return fail("the public dtor must be listed for cross-mode injection") }
	return ""
}

// The module's own opaque type not defined yet and a named type that is not
// opaque get no dtor; another package's opaque type gets its package's dtor
// declared extern, once.
func TestGenerateOpaqueNamedDtorsSkipsAndDeclares() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	addOpaqueNamed(m, "pkg/other.X", "pkg/other", nil)
	addOpaqueNamed(m, "pkg/op.F", "pkg/op", nil)
	var noPkg @[]char
	addOpaqueNamed(m, "pkg/op.N", noPkg, types.TypInt())
	var none @[]@[]char
	var generated @[]@[]char = generateOpaqueNamedDtors(m, "pkg/op", none)
	if len(generated) != 0 { return fail("nothing to generate") }
	generated = generateOpaqueNamedDtors(m, "pkg/op", generated)
	if len(m.Funcs) != 1 || !m.Funcs[0].IsExtern ||
			!charsEqual(m.Funcs[0].Name, irutil.QualifiedDtorName("pkg/other.X")) {
		return fail("pkg/other.X's dtor must be declared extern once")
	}
	return ""
}
