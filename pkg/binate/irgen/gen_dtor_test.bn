package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Destructor naming tests
// ============================================================

func TestDtorNameStruct() testing.TestResult {
	var t @types.Type = types.MakeStructType("Node", noFields)
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_4Node") {
		return fail("expected __dtor_4Node")
	}
	return ""
}

func TestDtorNameManagedPtr() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var t @types.Type = types.MakeManagedPtrType(inner)
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_mp_N0_4_Node") {
		return fail("expected __dtor_mp_N0_4_Node")
	}
	return ""
}

func TestDtorNameManagedSlice() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var t @types.Type = types.MakeManagedSliceType(mpT)
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_mp_N0_4_Node") {
		return fail("expected __dtor_ms_mp_N0_4_Node")
	}
	return ""
}

func TestDtorNameArray() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var t @types.Type = types.MakeArrayType(mpT, 5)
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_arr5_mp_N0_4_Node") {
		return fail("expected __dtor_arr5_mp_N0_4_Node")
	}
	return ""
}

// A `readonly T` element shares T's dtor suffix — readonly is transparent to
// dtor/copy element naming.  Without peeling it, the element falls through to the
// "unknown" fallback (`__dtor_ms_unknown` rather than `__dtor_ms_int`).
func TestDtorNameReadonlyScalarElem() testing.TestResult {
	var t @types.Type = types.MakeManagedSliceType(types.MakeReadonlyType(types.TypInt()))
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_int") {
		return fail("expected __dtor_ms_int (readonly int shares int's dtor)")
	}
	return ""
}

// A `readonly @T` element still names the managed-pointer dtor — the readonly
// wrapper must not hide the managed element (which would be the latent leak).
func TestDtorNameReadonlyManagedElem() testing.TestResult {
	var mp @types.Type = types.MakeManagedPtrType(types.MakeStructType("Node", noFields))
	var t @types.Type = types.MakeManagedSliceType(types.MakeReadonlyType(mp))
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_mp_N0_4_Node") {
		return fail("expected __dtor_ms_mp_N0_4_Node (readonly @Node shares @Node's dtor)")
	}
	return ""
}

func TestDtorNameNestedManagedSlice() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var mpT @types.Type = types.MakeManagedPtrType(inner)
	var ms1 @types.Type = types.MakeManagedSliceType(mpT)
	var t @types.Type = types.MakeManagedSliceType(ms1)
	var name @[]char = irutil.DtorNameForType(t)
	if !charsEqual(name, "__dtor_ms_ms_mp_N0_4_Node") {
		return fail("expected __dtor_ms_ms_mp_N0_4_Node")
	}
	return ""
}

// @[]@Iface and @[]@func encode their element with the reserved keywords
// `interface` / `func`, NOT the bare identifiers `iv` / `fv`.  A struct named
// `iv` / `fv` is a legal user type whose TYP_STRUCT suffix is its verbatim name,
// so `iv` / `fv` element tokens would collide with `@[]structNamed_iv` on
// __dtor_ms_iv (and __copy_ms_iv) — the name-keyed dtor dedup would emit one
// body for two structurally-different slices.  Keywords can never be struct
// names, so the collision is impossible.
func TestDtorNameIfaceFuncNoStructCollision() testing.TestResult {
	var noTypeParams @[]@types.Param
	var noTypeResults @[]@types.Type
	var ifaceSlice @types.Type = types.MakeManagedSliceType(
			types.MakeManagedInterfaceValueType(nil))
	var funcSlice @types.Type = types.MakeManagedSliceType(
			types.MakeManagedFuncValueType(noTypeParams, noTypeResults))
	var ivStructSlice @types.Type = types.MakeManagedSliceType(
			types.MakeStructType("iv", noFields))
	if !charsEqual(irutil.DtorNameForType(ifaceSlice), "__dtor_ms_interface") {
		return fail("@[]@Iface dtor name should be __dtor_ms_interface")
	}
	if !charsEqual(irutil.DtorNameForType(funcSlice), "__dtor_ms_func") {
		return fail("@[]@func dtor name should be __dtor_ms_func")
	}
	if !charsEqual(copyNameForType(ifaceSlice), "__copy_ms_interface") {
		return fail("@[]@Iface copy name should be __copy_ms_interface")
	}
	if charsEqual(irutil.DtorNameForType(ifaceSlice), irutil.DtorNameForType(ivStructSlice)) {
		return fail("@[]@Iface must not collide with @[]struct-named-iv")
	}
	return ""
}

// A struct adversarially named to spoof a kind token (`mp_`/`ms_`/…) no longer
// collides with the wrapped type it would have shadowed: the nested struct name is
// the identifier-only, full-path LpTypeArgNamedRaw encoding, not the bare leaf, so
// `@[]struct{mp_Node}` and `@[]@Node` (both `__dtor_ms_mp_Node` under the old scheme)
// get distinct dtor AND copy names.
func TestDtorNameInjectiveKindTokenSpoof() testing.TestResult {
	var spoof @types.Type = types.MakeManagedSliceType(types.MakeStructType("mp_Node", noFields))
	var real @types.Type = types.MakeManagedSliceType(
			types.MakeManagedPtrType(types.MakeStructType("Node", noFields)))
	if charsEqual(irutil.DtorNameForType(spoof), irutil.DtorNameForType(real)) {
		return fail("F1: @[]struct(mp_Node) must not collide with @[]@Node on the dtor name")
	}
	if charsEqual(copyNameForType(spoof), copyNameForType(real)) {
		return fail("F1: @[]struct(mp_Node) must not collide with @[]@Node on the copy name")
	}
	return ""
}

// Two same-leaf structs from DIFFERENT packages get distinct element-walk names —
// the nested encoding carries the full package path, so `@[]pkg/a.Config` and
// `@[]pkg/b.Config` (both `__dtor_ms_Config` under the leaf-only scheme) differ.
// Aligns with §16.6 pkg.identity (symbol identity is the full import path).
func TestDtorNameInjectiveCrossPackageSameLeaf() testing.TestResult {
	var a @types.Type = types.MakeManagedSliceType(types.MakeStructType("pkg/a.Config", noFields))
	var b @types.Type = types.MakeManagedSliceType(types.MakeStructType("pkg/b.Config", noFields))
	if charsEqual(irutil.DtorNameForType(a), irutil.DtorNameForType(b)) {
		return fail("F2: @[]pkg/a.Config must not collide with @[]pkg/b.Config")
	}
	return ""
}

// F3: a TOP-LEVEL struct source-named like a wrapper helper no longer collides with
// that wrapper's own helper — the top-level leaf is length-prefixed
// (writeStructLeafToken), so `struct mp_Node`'s dtor differs from `@Node`'s.
func TestDtorNameInjectiveTopLevelStructVsWrapper() testing.TestResult {
	var s @types.Type = types.MakeStructType("mp_Node", noFields)
	var w @types.Type = types.MakeManagedPtrType(types.MakeStructType("Node", noFields))
	if charsEqual(irutil.DtorNameForType(s), irutil.DtorNameForType(w)) {
		return fail("F3: struct mp_Node's dtor must not collide with @Node's dtor")
	}
	if charsEqual(copyNameForType(s), copyNameForType(w)) {
		return fail("F3: struct mp_Node's copy must not collide with @Node's copy")
	}
	return ""
}

// ============================================================
// Qualified dtor naming
// ============================================================

func TestQualifiedDtorNameLocal() testing.TestResult {
	var name @[]char = irutil.QualifiedDtorName("Node")
	if !charsEqual(name, "__dtor_4Node") {
		return fail("expected __dtor_4Node")
	}
	return ""
}

func TestQualifiedDtorNameCrossPkg() testing.TestResult {
	var name @[]char = irutil.QualifiedDtorName("ast.File")
	if !charsEqual(name, "ast.__dtor_4File") {
		return fail("expected ast.__dtor_4File")
	}
	return ""
}
