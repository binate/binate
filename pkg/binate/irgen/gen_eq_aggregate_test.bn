package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for the struct / array == / != field-wise lowering
// (gen_eq_aggregate.bn).  A struct / array comparison must NOT emit a single
// aggregate-operand OP_EQ (invalid IR) — it lowers to one OP_EQ per leaf
// field/element, conjoined with OP_LAND, over per-field/element address GEPs;
// != additionally negates with OP_NOT.

// A struct == of a 2-field struct lowers to one OP_EQ per field, conjoined
// with OP_LAND, over field-pointer GEPs of both operands (2 fields x 2
// operands = 4 OP_GET_FIELD_PTR).
func TestGenStructEqEmitsFieldwiseCompare() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func e() bool { var a Pt; var b Pt; return a == b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var f @ir.Func = m.Funcs[0]
	if countOp(f, iropcode.OP_EQ) < 2 {
		return fail("struct == should emit one OP_EQ per field (>=2)")
	}
	if countOp(f, iropcode.OP_LAND) < 1 {
		return fail("struct == should conjoin field compares with OP_LAND")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) < 4 {
		return fail("struct == should GEP each field of both operands (>=4)")
	}
	return ""
}

// A struct != negates the structural-equality with a single OP_NOT.
func TestGenStructNeqEmitsNot() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\ntype Pt struct { x int; y int }\n"
					"func e() bool { var a Pt; var b Pt; return a != b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var f @ir.Func = m.Funcs[0]
	if countOp(f, iropcode.OP_NOT) < 1 {
		return fail("struct != should negate the structural-eq with OP_NOT")
	}
	return ""
}

// An array == lowers to one OP_EQ per element, conjoined with OP_LAND, over
// element-pointer GEPs of both operands (3 elems x 2 operands = 6
// OP_GET_ELEM_PTR; 3 terms conjoined = 2 OP_LAND).
func TestGenArrayEqEmitsElementwiseCompare() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc e() bool { var a [3]int; var b [3]int; return a == b }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var f @ir.Func = m.Funcs[0]
	if countOp(f, iropcode.OP_EQ) < 3 {
		return fail("[3]int == should emit one OP_EQ per element (>=3)")
	}
	if countOp(f, iropcode.OP_LAND) < 2 {
		return fail("[3]int == should conjoin 3 element compares (>=2 OP_LAND)")
	}
	if countOp(f, iropcode.OP_GET_ELEM_PTR) < 6 {
		return fail("[3]int == should GEP each element of both operands (>=6)")
	}
	return ""
}

// eqFunc returns the IR of `func e() bool { <body> }` after the declarations decls.
func eqFunc(decls *[]readonly char, body *[]readonly char) @ir.Func {
	var src @[]char = buf.Concat(buf.Concat("package \"test\"\n", decls),
			buf.Concat(buf.Concat("func e() bool { ", body), " }\n"))
	var m @ir.Module = genFromSourceWithChecker(src)
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, "test.e") { return m.Funcs[i] }
	}
	return nil
}

// instrCount returns how many instructions f holds.
func instrCount(f @ir.Func) int {
	var n int = 0
	for i := 0; i < len(f.Blocks); i++ {
		n = n + len(f.Blocks[i].Instrs)
	}
	return n
}

// An array comparison of at most 16 scalar leaves is unrolled straight-line — `[16]int` and
// `[4][4]int` are 16 OP_EQs in one block — and one with more is a loop over the elements: a
// `[17]int` or `[1 << 20]int` is one OP_EQ in a loop's body, its bound an OP_LT, with no
// OP_LAND and IR the size of one element's comparison.
func TestGenLargeArrayEqLoops() testing.TestResult {
	var unrolled @[]*[]readonly char = @[]*[]readonly char{
			"var a [16]int; var b [16]int; return a == b", "var a [4][4]int; var b [4][4]int; return a == b"}
	for i := 0; i < len(unrolled); i++ {
		var f @ir.Func = eqFunc("", unrolled[i])
		if f == nil || countOp(f, iropcode.OP_EQ) != 16 || len(f.Blocks) != 1 {
			return fail(buf.Concat("not unrolled: ", unrolled[i]))
		}
	}
	var looped @[]*[]readonly char = @[]*[]readonly char{
			"var a [17]int; var b [17]int; return a == b",
			"var a [1 << 20]int; var b [1 << 20]int; return a == b"}
	for i := 0; i < len(looped); i++ {
		var f @ir.Func = eqFunc("", looped[i])
		if f == nil || countOp(f, iropcode.OP_EQ) != 1 || countOp(f, iropcode.OP_LT) != 1 ||
				countOp(f, iropcode.OP_LAND) != 0 || instrCount(f) > 60 {
			return fail(buf.Concat("not a loop: ", looped[i]))
		}
	}
	return ""
}

// A nested array past the limit loops at each level whose comparison passes it — `[100][100]int`
// is two loops around one OP_EQ — and a struct compares its scalar fields straight-line around
// the loop of its long array field (three OP_EQs, two OP_LANDs); `!=` negates the loop's result.
func TestGenNestedArrayEqLoops() testing.TestResult {
	var f @ir.Func = eqFunc("", "var a [100][100]int; var b [100][100]int; return a == b")
	if f == nil || countOp(f, iropcode.OP_EQ) != 1 || countOp(f, iropcode.OP_LT) != 2 ||
			instrCount(f) > 100 {
		return fail("[100][100]int is not two loops")
	}
	f = eqFunc("type P struct { x int; big [100]int; y int }\n", "var a P; var b P; return a != b")
	if f == nil || countOp(f, iropcode.OP_EQ) != 3 || countOp(f, iropcode.OP_LAND) != 2 ||
			countOp(f, iropcode.OP_LT) != 1 || countOp(f, iropcode.OP_NOT) != 1 {
		return fail("a struct with a long array field")
	}
	return ""
}

// An aggregate with no scalar leaf holds no data: an array of empty structs, however long
// (`[1 << 40]E` included, legal at size 0), or of zero-length arrays, compares equal with no
// compare and no loop.
func TestGenZeroLeafArrayEqIsTrue() testing.TestResult {
	var bodies @[]*[]readonly char = @[]*[]readonly char{
			"var a [1 << 16]E; var b [1 << 16]E; return a == b",
			"var a [1 << 40]E; var b [1 << 40]E; return a == b",
			"var a [1000][0]int; var b [1000][0]int; return a == b",
			"var a [70]struct { e E; z [0]int }; var b [70]struct { e E; z [0]int }; return a == b"}
	for i := 0; i < len(bodies); i++ {
		var f @ir.Func = eqFunc("type E struct {}\n", bodies[i])
		if f == nil || countOp(f, iropcode.OP_EQ) != 0 || countOp(f, iropcode.OP_LT) != 0 ||
				len(f.Blocks) != 1 || instrCount(f) > 20 {
			return fail(buf.Concat("not a constant: ", bodies[i]))
		}
	}
	return ""
}

// arrAllocs returns how many OP_ALLOCs of f hold a `[n]int`.
func arrAllocs(f @ir.Func, n int64) int {
	var k int = 0
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			var ins @ir.Instr = f.Blocks[i].Instrs[j]
			if ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil && ins.TypeArg.Kind == types.TYP_ARRAY &&
					ins.TypeArg.ArrayLen == n {
				k = k + 1
			}
		}
	}
	return k
}

// An operand that is a variable, field or element is compared where it is stored, with no
// copy, when nothing evaluated after it can write memory: `a == b` and `s.x == t.x` copy
// neither (the slots are a's and b's, or s's and t's), and `f() == a` copies only f's result.
// A left operand followed by a call is copied first — `a == f()` copies a, as f may change it.
func TestGenAggregateEqInPlace() testing.TestResult {
	var decls *[]readonly char = "type P struct { x [1000]int }\n"
			"func f() [1000]int { var r [1000]int; return r }\n"
	var bodies @[]*[]readonly char = @[]*[]readonly char{
			"var a [1000]int; var b [1000]int; return a == b", "var a [1000]int; return f() == a",
			"var a [1000]int; return a == f()"}
	var want @[]int = @[]int{2, 2, 3}
	for i := 0; i < len(bodies); i++ {
		var f @ir.Func = eqFunc(decls, bodies[i])
		if f == nil { return fail(buf.Concat("no function: ", bodies[i])) }
		var n int = arrAllocs(f, 1000)
		if n != want[i] || countOp(f, iropcode.OP_EQ) != 1 {
			return fail(buf.Concat(buf.Concat(bodies[i], ": [1000]int slots "), strconv.Itoa(n)))
		}
	}
	var g @ir.Func = eqFunc(decls, "var s P; var t P; return s.x != t.x")
	if g == nil || arrAllocs(g, 1000) != 0 || countOp(g, iropcode.OP_NOT) != 1 {
		return fail("s.x != t.x is not compared in place")
	}
	return ""
}
