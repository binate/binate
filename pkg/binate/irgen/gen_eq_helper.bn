package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Struct-equality helpers.  A comparison compares its struct's own fields in place, but
// a struct field or array element of more scalar leaves than aggEqUnrollLeaves is a call
// to its type's equality helper, a function comparing that struct's fields the same way.
// So the IR of a comparison grows with the depth of the nesting, not with the number of
// leaves, which doubles with each level of `type S1 struct { a, b S0 }`, `type S2
// struct { a, b S1 }`, ...; a flat struct keeps its straight-line comparison.  A helper is
// emitted once per module and type, linkonce, and named by the type (eqHelperName,
// injective), so every module's copy of one helper compares the same type.

// emitStructEqCall emits, in ctx.CurBlock, a call comparing the structs of type t at ptrA
// and ptrB with t's equality helper (eqHelperFor), and returns its bool result.  The call
// gets a fault pad, as every call does: the VM raises a stack overflow at a call that
// pushes past the stack as a recoverable fault, which unwinds through the call's pad.
func emitStructEqCall(ctx @GenContext, ptrA @ir.Instr, ptrB @ir.Instr, t @types.Type) @ir.Instr {
	var u8ptr @types.Type = types.MakePointerType(types.TypUint8())
	var name @[]char = eqHelperFor(ctx.Gc, t)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = irbuild.EmitBitCast(ctx.CurBlock, ptrA, u8ptr)
	args[1] = irbuild.EmitBitCast(ctx.CurBlock, ptrB, u8ptr)
	var eq @ir.Instr = irbuild.EmitCallLocal(ctx.CurBlock, name, args, types.TypBool())
	attachFaultPad(ctx, ctx.CurBlock)
	return eq
}

// eqHelperName returns the name of struct type t's equality helper: `__eq_` and t's
// type-argument token, which distinct types never share.
func eqHelperName(t @types.Type) @[]char {
	return buf.Concat("__eq_", irutil.MangleTypeArg(t))
}

// eqHelperFor returns the name of struct type t's equality helper in gc's module, emitting
// the helper first when the module does not hold it: `func(a *uint8, b *uint8) bool`,
// true when the structs at a and b compare equal field by field.
func eqHelperFor(gc @GenCtx, t @types.Type) @[]char {
	var name @[]char = eqHelperName(t)
	for i := 0; i < len(gc.EqHelpers); i++ {
		var h EqHelper = gc.EqHelpers[i]
		if irutil.Streq(h.Name, name) && h.Index < len(gc.Mod.Funcs) &&
				same(gc.Mod.Funcs[h.Index], h.Fn) {
			return name
		}
	}
	var u8ptr @types.Type = types.MakePointerType(types.TypUint8())
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = make(ir.Param)
	params[0].Name = buf.CopyStr("a")
	params[0].Typ = u8ptr
	params[1] = make(ir.Param)
	params[1].Name = buf.CopyStr("b")
	params[1].Typ = u8ptr
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypBool()
	var f @ir.Func = ir.NewFunc(gc.Mod.PkgPath, name, params, results)
	f.IsLinkOnce = true
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = gc
	ctx.CurBlock = ir.AddBlock(f, "entry")
	var eq @ir.Instr = emitStructEqFields(ctx, irbuild.NewParamRef(f, f.Params[0]),
			irbuild.NewParamRef(f, f.Params[1]), t)
	var ret @[]@ir.Instr = make_slice(@ir.Instr, 1)
	ret[0] = eq
	irbuild.EmitReturn(ctx.CurBlock, ret)
	gc.Mod.AddFunc(f)
	var h EqHelper
	h.Name = name
	h.Fn = f
	h.Index = len(gc.Mod.Funcs) - 1
	gc.EqHelpers = slices.Append[EqHelper](gc.EqHelpers, h)
	return name
}
