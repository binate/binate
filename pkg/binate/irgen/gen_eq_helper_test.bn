package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/parser"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for the struct-equality helpers (gen_eq_helper.bn).

// nestedStructDecls declares S0 (two ints) and S1 .. S<depth>, each two of the one below,
// so S<k> has 2^(k+1) scalar leaves.
func nestedStructDecls(depth int) @[]char {
	var src @[]char = buf.CopyStr("type S0 struct { a int; b int }\n")
	for k := 1; k <= depth; k++ {
		var line @[]char = buf.Concat("type S", strconv.Itoa(k))
		line = buf.Concat(line, " struct { a S")
		line = buf.Concat(line, strconv.Itoa(k - 1))
		line = buf.Concat(line, "; b S")
		line = buf.Concat(line, strconv.Itoa(k - 1))
		src = buf.Concat(src, buf.Concat(line, " }\n"))
	}
	return src
}

// eqModule returns the module of package "test" holding decls and `func e() bool { body }`,
// or nil when the checker rejects it.
func eqModule(decls *[]readonly char, body *[]readonly char) @ir.Module {
	var src @[]char = buf.Concat(buf.Concat("package \"test\"\n", decls),
			buf.Concat(buf.Concat("func e() bool { ", body), " }\n"))
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) > 0 { return nil }
	return GenModule(c, file)
}

// eqHelperCount returns how many of m's functions are struct-equality helpers.
func eqHelperCount(m @ir.Module) int {
	var n int = 0
	for i := 0; i < len(m.Funcs); i++ {
		if containsSub(m.Funcs[i].Name, "__eq_") { n = n + 1 }
	}
	return n
}

// moduleOps returns how many op instructions all of m's functions hold, and how many
// instructions in all.
func moduleOps(m @ir.Module, op int) (int, int) {
	var ops int = 0
	var all int = 0
	for i := 0; i < len(m.Funcs); i++ {
		ops = ops + countOp(m.Funcs[i], op)
		all = all + instrCount(m.Funcs[i])
	}
	return ops, all
}

// funcNamed returns m's function called name, or nil.
func funcNamed(m @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, name) { return m.Funcs[i] }
	}
	return nil
}

// eqCallsHavePads reports whether every call to an equality helper among m's functions
// has a fault pad.
func eqCallsHavePads(m @ir.Module) bool {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		for bi := 0; bi < len(f.Blocks); bi++ {
			for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
				var ins @ir.Instr = f.Blocks[bi].Instrs[ii]
				if ins.Op == iropcode.OP_CALL && containsSub(ins.StrVal, "__eq_") && ins.PadBlock == nil {
					return false
				}
			}
		}
	}
	return true
}

// A comparison of S12 (8192 leaves) compares its two S11 fields with two calls; S4 .. S11
// each get a helper, whose body calls the one below twice, except S4's, which compares its
// two S3 (16 leaves each) inline.  So the module holds 32 OP_EQ, not 8192, its IR stays
// small, and each helper call has a fault pad (the VM's stack overflow at a call unwinds
// through it).
func TestGenDeepStructEqOutlined() testing.TestResult {
	var m @ir.Module = eqModule(nestedStructDecls(12), "var x S12; var y S12; return x == y")
	if m == nil { return "the program was rejected" }
	var e @ir.Func = funcNamed(m, "test.e")
	if e == nil || countOp(e, iropcode.OP_CALL) != 2 || countOp(e, iropcode.OP_EQ) != 0 {
		return "expected e to compare the S12s' two fields with two calls and no OP_EQ"
	}
	if eqHelperCount(m) != 8 {
		return fail(buf.Concat("expected 8 helpers (S4 .. S11), got ", strconv.Itoa(eqHelperCount(m))))
	}
	eqs, all := moduleOps(m, iropcode.OP_EQ)
	if eqs != 32 {
		return fail(buf.Concat("expected 32 OP_EQ in the module, got ", strconv.Itoa(eqs)))
	}
	if all > 1200 {
		return fail(buf.Concat("expected a small module, got instructions: ", strconv.Itoa(all)))
	}
	if !eqCallsHavePads(m) { return "expected every helper call to have a fault pad" }
	return ""
}

// A comparison compares its own struct's fields inline, however many leaves it has: S3
// (16 leaves) and a flat 17-leaf struct are straight-line, with no helper.  A struct FIELD
// of more than 16 leaves is a call to its type's helper.
func TestGenStructEqFieldPastBudgetCalls() testing.TestResult {
	var m @ir.Module = eqModule(nestedStructDecls(3), "var x S3; var y S3; return x == y")
	if m == nil { return "the program was rejected" }
	var e @ir.Func = funcNamed(m, "test.e")
	if e == nil || countOp(e, iropcode.OP_EQ) != 16 || countOp(e, iropcode.OP_CALL) != 0 ||
			eqHelperCount(m) != 0 {
		return "expected S3 (16 leaves) compared inline with no helper"
	}
	var t *[]readonly char = "type T struct { a [16]int; b int }\n"
	var g @ir.Module = eqModule(t, "var x T; var y T; return x == y")
	if g == nil { return "the T program was rejected" }
	var ge @ir.Func = funcNamed(g, "test.e")
	if eqHelperCount(g) != 0 || countOp(ge, iropcode.OP_EQ) != 17 ||
			countOp(ge, iropcode.OP_CALL) != 0 {
		return "expected T (17 leaves) compared inline"
	}
	var h @ir.Module = eqModule(buf.Concat(t, "type U struct { t T; c int }\n"),
			"var x U; var y U; return x == y")
	if h == nil { return "the U program was rejected" }
	var he @ir.Func = funcNamed(h, "test.e")
	if eqHelperCount(h) != 1 || countOp(he, iropcode.OP_CALL) != 1 ||
			countOp(he, iropcode.OP_EQ) != 1 {
		return "expected U to compare its T field with a call to T's helper and its int inline"
	}
	return ""
}

// Comparisons of one type, in one function and in two, share one helper per field type;
// an array of such structs is a loop whose body calls it.
func TestGenStructEqHelperOncePerType() testing.TestResult {
	var decls @[]char = buf.Concat(nestedStructDecls(5), "func f(x S5, y S5) bool { return x != y }\n")
	var m @ir.Module = eqModule(decls, "var x S5; var y S5; return x == y && y == x")
	if m == nil { return "the program was rejected" }
	if eqHelperCount(m) != 1 { return "expected one helper, S4's" }
	if countOp(funcNamed(m, "test.e"), iropcode.OP_CALL) != 4 {
		return "expected e to call it four times"
	}
	if countOp(funcNamed(m, "test.f"), iropcode.OP_CALL) != 2 { return "expected f to call it twice" }
	var g @ir.Module = eqModule(nestedStructDecls(4), "var x [3]S4; var y [3]S4; return x == y")
	if g == nil { return "the array program was rejected" }
	var e @ir.Func = funcNamed(g, "test.e")
	if eqHelperCount(g) != 1 || countOp(e, iropcode.OP_CALL) != 1 || countOp(e, iropcode.OP_LT) != 1 {
		return "expected the [3]S4 comparison to loop over a call to S4's helper"
	}
	return ""
}
