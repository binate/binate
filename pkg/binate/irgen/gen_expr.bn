package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/constval"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Expression generation
// ============================================================

// genExpr generates IR for an expression, propagating source line info.
func genExpr(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	var result @ir.Instr = genExprInner(ctx, b, e)
	if result != nil && e != nil && e.Pos.Line > 0 {
		result.Line = e.Pos.Line
	}
	return result
}

// emitModuleConstByName emits the module-level constant named `name`,
// dispatching on its scalar family (bool → EmitConstBool, float →
// EmitConstFloat, const-expression → re-lower its stashed AST, int →
// EmitConstInt).  Returns nil if no module const has that exact name.
// Walks Module.Consts directly rather than going through lookupConst,
// which only carries the integer Val.
func emitModuleConstByName(ctx @GenContext, b @ir.Block, name *[]readonly char) @ir.Instr {
	var i int = findPackageConst(ctx.Gc, name)
	if i < 0 {
		return nil
	}
	// A package constant's initializer sees no local.
	return emitModuleConstAt(ctx, b, i, 0)
}

// isPackageConstName reports whether the bare name is a package constant — in
// CurrentImportPkg first, inside a body emitted for an imported package.
func isPackageConstName(gc @GenCtx, name *[]readonly char) bool {
	if len(gc.Mod.CurrentImportPkg) > 0 &&
			findPackageConst(gc, qualNameInPkg(gc.Mod.CurrentImportPkg, name)) >= 0 {
		return true
	}
	return findPackageConst(gc, name) >= 0
}

// findPackageConst returns the index in Module.Consts of the package
// constant name — not a function's local constant, which is read through its
// binding — or -1.
func findPackageConst(gc @GenCtx, name *[]readonly char) int {
	for i := 0; i < len(gc.Mod.Consts); i++ {
		if !gc.Mod.Consts[i].Local && irutil.Streq(gc.Mod.Consts[i].Name, name) {
			return i
		}
	}
	return -1
}

// genConstExpr lowers the stashed initializer of the float const-expression
// Module.Consts[i] with only the first scopeLen local bindings visible — the
// ones in scope at its declaration, none for a package constant — so a name
// in it resolves as it did there, not to a later local of the same name (or,
// for `const ( F = F * 2.0 )`, to the constant itself).  A constant
// initializer names only constants, declared before it.
func genConstExpr(ctx @GenContext, b @ir.Block, i int, scopeLen int) @ir.Instr {
	var saved @[]VarSlot = ctx.Vars
	ctx.Vars = ctx.Vars[:scopeLen]
	var v @ir.Instr = genExpr(ctx, b, ctx.Gc.Mod.Consts[i].Expr)
	ctx.Vars = saved
	return v
}

// genImportedConstExpr is genConstExpr for a float const-expression of the
// imported package pkg: its bare names are that package's constants, so it is
// lowered as a generic body of pkg is (CurrentImportPkg), seeing no local.
func genImportedConstExpr(ctx @GenContext, b @ir.Block, i int, pkg @[]char) @ir.Instr {
	var savedPkg @[]char = ctx.Gc.Mod.CurrentImportPkg
	ctx.Gc.Mod.CurrentImportPkg = pkg
	var v @ir.Instr = genConstExpr(ctx, b, i, 0)
	ctx.Gc.Mod.CurrentImportPkg = savedPkg
	return v
}

// emitModuleConstAt emits the value of the registered constant
// Module.Consts[i], whose initializer sees the first scopeLen local bindings
// (genConstExpr).
func emitModuleConstAt(ctx @GenContext, b @ir.Block, i int, scopeLen int) @ir.Instr {
	if ctx.Gc.Mod.Consts[i].Kind == CONST_BOOL {
		return irbuild.EmitConstBool(b, ctx.Gc.Mod.Consts[i].BoolVal)
	}
	if ctx.Gc.Mod.Consts[i].Kind == CONST_FLT {
		var ftyp @types.Type = ctx.Gc.Mod.Consts[i].Typ
		if ftyp == nil { ftyp = types.TypUntypedFloat() }
		return irbuild.EmitConstFloat(b, ctx.Gc.Mod.Consts[i].FltText, ftyp)
	}
	// A const-EXPRESSION re-lowers its stashed AST so the backend
	// computes the value (the float-const path can't carry a folded
	// result as exact text).
	if ctx.Gc.Mod.Consts[i].Kind == CONST_EXPR {
		return genConstExpr(ctx, b, i, scopeLen)
	}
	var ctyp @types.Type = ctx.Gc.Mod.Consts[i].Typ
	if ctyp == nil { ctyp = types.TypUntypedInt() }
	// EmitConstInt64: Val is int64, so a 64-bit named const emits its full
	// value (EmitConstInt would narrow through a host int on ILP32).
	return irbuild.EmitConstInt64(b, ctx.Gc.Mod.Consts[i].Val, ctyp)
}

// genExprInner dispatches expression generation by AST node kind.
func genExprInner(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	ctx.CurBlock = b
	if e.Kind == ast.EXPR_INT_LIT {
		// Prefer the type checker's bignum value (LitMag/LitSign on
		// the resolved Type) over re-parsing the literal text via
		// parseIntLit.  Same result for all values parseIntLit
		// handles correctly; more robust at the int64-min /
		// uint64 boundary.  Falls back to parseIntLit when the
		// checker isn't available (e.g. genFromSource tests that
		// skip type-check).
		var v int64 = exprIntLitValue(ctx.Checker, e)
		// A bare literal is a non-negative magnitude; a NEGATIVE int64 bit pattern
		// therefore means the value is >= 2^63 (uint64-only).  Stamp it unsigned so a
		// later int->float cast picks uitofp / BC_UITOF on EVERY backend —
		// TypUntypedInt is Signed=false (so LLVM's uitofp is right), but the VM/native
		// int->float predicate requires a CONCRETE TYP_INT, so they'd sign-convert a
		// TypUntypedInt source to a large NEGATIVE float.  TypUint64 converts unsigned
		// uniformly.  (For v >= 0 the two agree, so keep the untyped default.)
		if v < 0 {
			return irbuild.EmitConstInt64(b, v, types.TypUint64())
		}
		return irbuild.EmitConstInt64(b, v, types.TypUntypedInt())
	}

	if e.Kind == ast.EXPR_FLOAT_LIT {
		return irbuild.EmitConstFloat(b, e.Name, types.TypUntypedFloat())
	}

	if e.Kind == ast.EXPR_STRING_LIT {
		return irbuild.EmitConstString(b, unescapeStr(e.Name))
	}

	if e.Kind == ast.EXPR_CHAR_LIT {
		return irbuild.EmitConstInt(b, types.ParseCharLit(e.Name), types.TypUint8())
	}

	if e.Kind == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			return irbuild.EmitConstBool(b, irutil.Streq(e.Name, "true"))
		}
		return irbuild.EmitConstBool(b, e.BoolVal)
	}

	if e.Kind == ast.EXPR_NIL_LIT {
		return irbuild.EmitConstNil(b, types.TypNil())
	}

	if e.Kind == ast.EXPR_IDENT {
		var ci int = lookupLocalConst(ctx, e.Name)
		if ci >= 0 {
			return emitModuleConstAt(ctx, b, ctx.Vars[ci].ConstIdx - 1, ctx.Vars[ci].ScopeLen)
		}
		var ptr @ir.Instr = lookupVar(ctx, e.Name)
		if ptr != nil {
			var typ @types.Type = lookupVarType(ctx, e.Name)
			return irbuild.EmitLoad(b, ptr, typ)
		}
		// A constant the type checker recorded for this node: its value,
		// which resolves the name in the checker's scopes — so a
		// function-local const-group member shadows a package constant of the
		// same name, which the by-name lookup below cannot tell apart.
		if ctx.Checker != nil && e.ResolvedTypeID > 0 {
			var cv constval.Value
			var cst int
			cv, cst = ctx.Checker.ConstValue(e)
			if cst == constval.OK {
				return emitConstValue(b, cv)
			}
		}
		// Module-level constant.  Inside a monomorphized generic body
		// emitted for an imported package (CurrentImportPkg set), a
		// bare const name is registered under the defining-package
		// qualified name, so try that first — otherwise the bare lookup
		// misses and the value silently becomes the zero placeholder
		// below (e.g. `x * SCALE` → `x * 0`).
		if len(ctx.Gc.Mod.CurrentImportPkg) > 0 {
			var qc @ir.Instr = emitModuleConstByName(ctx, b,
					qualNameInPkg(ctx.Gc.Mod.CurrentImportPkg, e.Name))
			if qc != nil { return qc }
		}
		var c @ir.Instr = emitModuleConstByName(ctx, b, e.Name)
		if c != nil { return c }
		// Unknown ident — return a zero placeholder
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	if e.Kind == ast.EXPR_BINARY {
		var folded @ir.Instr = tryFoldOversizedConst(ctx.Checker, b, e)
		if folded != nil { return folded }
		return genBinary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_UNARY {
		var folded @ir.Instr = tryFoldOversizedConst(ctx.Checker, b, e)
		if folded != nil { return folded }
		return genUnary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_CALL {
		return genCall(ctx, b, e)
	}

	if e.Kind == ast.EXPR_BUILTIN {
		return genBuiltin(ctx, b, e)
	}

	if e.Kind == ast.EXPR_SELECTOR {
		// A selector whose resolved type is a function-value AND whose
		// X-side is a value (not a known type / package) is a
		// method value `x.M`.  Route to the method-value handler
		// which synthesizes a per-(method, receiver-shape) wrapper
		// + closure struct.
		if isMethodValueSelector(ctx, e) {
			return genMethodValue(ctx, b, e)
		}
		return genSelector(ctx, b, e)
	}

	if e.Kind == ast.EXPR_COMPOSITE {
		return genCompositeLit(ctx, b, e)
	}

	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// A generic-function instantiation with no func-value target type to
		// lower it against (`_ = Ident[int]`) is a func value of the
		// managed-by-default `@func` type, as `var f = Ident[int]` binds; lowered
		// as an index instead, it reads the function as an indexable value.
		var giName @[]char = genericFuncInstanceName(ctx, e)
		if len(giName) > 0 {
			var fv @ir.Instr = irbuild.EmitFuncValue(b, giName, managedFuncValueTypeForName(ctx.Gc, giName))
			noteSPGrowingResult(ctx, fv)
			registerFreshFuncValueTemp(ctx, fv)
			return fv
		}
		// Checked unless it is an `unsafe_index`, which the checker lowers to an
		// index node marked Unchecked.
		return genIndex(ctx, b, e, !e.Unchecked)
	}

	if e.Kind == ast.EXPR_SLICE {
		return genSliceExpr(ctx, b, e)
	}

	if e.Kind == ast.EXPR_FUNC_LIT {
		return genFuncLit(ctx, b, e)
	}
	if e.Kind == ast.EXPR_TYPE_ASSERT {
		return genTypeAssert(ctx, b, e)
	}

	// Unsupported expression
	return irbuild.EmitConstInt(b, 0, types.TypInt())
}

// genLValueAddr emits the ADDRESS of an addressable lvalue expression `x`
// (`x` itself, NOT `&x`): its storage pointer, with no load of the value.  It
// is the dispatch the address-of operator uses (genUnary's `&` arm delegates
// here) and that the implicit interface value-borrow reuses to take `&x` where
// the source carried no explicit `&`.  The caller must have established `x` is
// addressable (the type-checker's isAddressable); a non-addressable `x` falls
// through to genExpr, which yields the value, not an address.
func genLValueAddr(ctx @GenContext, b @ir.Block, x @ast.Expr) @ir.Instr {
	var p @ir.Instr
	p, _ = genLValueAddrOrValue(ctx, b, x)
	return p
}

// genLValueAddrOrValue is genLValueAddr reporting which it produced: true for the
// storage address of `x`, false when `x` has none and it fell through to genExpr's
// VALUE.  A caller that cannot tell the two apart by type needs this: the value of
// a named pointer type (`type H @Node`) is itself a pointer, but to the Node, not
// to an H.
func genLValueAddrOrValue(ctx @GenContext, b @ir.Block, x @ast.Expr) (@ir.Instr, bool) {
	// &ident: the variable's alloca pointer directly.
	if x.Kind == ast.EXPR_IDENT {
		var ptr @ir.Instr = lookupVar(ctx, x.Name)
		if ptr != nil {
			return ptr, true
		}
	}
	// &arr[i]: pointer to the element (GEP, not loaded value).
	if x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// Address-of: forDeref=false — `&nilp[i]` must not fault.
		var ptr @ir.Instr = genIndexPtr(ctx, b, x, false)
		if ptr != nil {
			return ptr, true
		}
	}
	// &s.field / &p.field / &globalStruct.field: delegate to genSelectorPtr,
	// which covers value structs, managed-ptr-to-struct, raw-ptr-to-struct, and
	// indexed element struct fields.  Returns the field pointer (a GEP), NOT the
	// loaded field value.
	if x.Kind == ast.EXPR_SELECTOR {
		// Address-of (`&s.field`): forDeref=false — computing the field address
		// must not fault on a nil base (no memory is touched here).
		var ptr @ir.Instr = genSelectorPtr(ctx, b, x, false)
		if ptr != nil {
			return ptr, true
		}
	}
	// &(*p): the address of a dereference is the pointer itself (`&*p == p`).
	// Without this the fallthrough returns the LOADED VALUE of *p as if it were
	// a pointer, so a write-through (`*pd = x`) stores to a garbage address.
	if x.Kind == ast.EXPR_UNARY && x.Op == cast(int, token.STAR) {
		return derefAddr(ctx, genExpr(ctx, b, x.X)), true
	}
	// A composite literal's address is its storage (genCompositeAddr).
	if x.Kind == ast.EXPR_COMPOSITE {
		return genCompositeAddr(ctx, b, x), true
	}
	return genExpr(ctx, b, x), false
}

// derefAddr returns the address of `*p` given p's value: p itself, relabelled from a
// named pointer type (`type P *int`, `type H @Node`) to its underlying pointer type.
// `&*p` is a pointer to the pointee, and a consumer that classifies the address by
// its type would otherwise read a value of the named pointer type — an interface
// box of `*p` must key on the pointee, not on P.
func derefAddr(ctx @GenContext, p @ir.Instr) @ir.Instr {
	if p == nil || p.Typ == nil { return p }
	var own @types.Type = types.ResolveAliasAndConst(p.Typ)
	if own == nil || own.Kind != types.TYP_NAMED { return p }
	var under @types.Type = types.StripWrappers(p.Typ)
	if under == nil || (under.Kind != types.TYP_POINTER && under.Kind != types.TYP_MANAGED_PTR) {
		return p
	}
	return irbuild.EmitCast(ctx.CurBlock, p, under)
}

// genUnary generates IR for unary expressions (&, *, -, !, ~).
func genUnary(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	// Address-of: &x returns the alloca pointer directly
	if e.Op == cast(int, token.AMP) {
		return genLValueAddr(ctx, b, e.X)
	}
	// Dereference: *p loads the pointer value, then loads through it.
	// Handles raw and managed pointers identically at the IR-gen level
	// — the deref produces an rvalue of the pointed-to type either
	// way.  Refcount semantics for the @T case stay on the *operand*
	// (the @T variable still owns its ref); the deref is a value
	// load, not an ownership transfer.  Required so that iv-method
	// dispatch routes correctly through `(*p).Foo()` when p is
	// `@(*Iface)` / `@(@Iface)` — otherwise the load is sized as
	// `i64` and the receiver carries the wrong type, failing the
	// `iv.Typ.Elem == nil` guard in genInterfaceMethodCall.
	if e.Op == cast(int, token.STAR) {
		var ptrVal @ir.Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		// Determine pointed-to type from the pointer's type.  Peel transparent
		// wrappers (named-distinct / alias / readonly): a named-distinct pointer
		// (`type P *T`) is TYP_NAMED, so an un-peeled Kind check falls through to
		// the TypInt() default and `*p` loads an int instead of the real pointee
		// (garbage for any non-int / aggregate pointee).
		var elemTyp @types.Type = types.TypInt()
		var pk @types.Type = nil
		if ptrVal.Typ != nil { pk = types.StripWrappers(ptrVal.Typ) }
		if pk != nil && (pk.Kind == types.TYP_POINTER || pk.Kind == types.TYP_MANAGED_PTR) &&
				pk.Elem != nil {
			elemTyp = pk.Elem
		} else if e.X.Kind == ast.EXPR_IDENT {
			var varTyp @types.Type = types.StripWrappers(lookupVarType(ctx, e.X.Name))
			if varTyp != nil && (varTyp.Kind == types.TYP_POINTER || varTyp.Kind == types.TYP_MANAGED_PTR) &&
					varTyp.Elem != nil {
				elemTyp = varTyp.Elem
			}
		}
		// Opt-in nil-pointer-deref check: with
		// GenCtx.EmitNilChecks on, guard the load through ptrVal unless ptrVal is
		// provably non-nil.  No-op when the flag is off (the default), so the
		// emitted IR is unchanged for a normal compile.
		emitNilCheckIfEnabled(ctx, b, ptrVal)
		return irbuild.EmitLoad(b, ptrVal, elemTyp)
	}

	// An untyped integer constant (`-lit`, `-(-lit)`, `~lit`) is the value the
	// checker folded, typed as emitUntypedIntConst types every such constant —
	// not computed from its operand's IR type: a literal of 2^63 or more is
	// lowered as uint64, which made `-9223372036854775808` negate, compare and
	// convert to float as the unsigned 2^63.
	var folded @ir.Instr = emitUntypedIntConst(ctx, b, e)
	if folded != nil { return folded }

	var arg @ir.Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	if e.Op == cast(int, token.PLUS) {
		// Unary + is a numeric no-op — the operand value is the result.
		return arg
	}
	if e.Op == cast(int, token.MINUS) {
		// Preserve the operand's EXACT numeric type so the backend negates at
		// the right width and signedness — floats use FP negation, and an
		// integer's width must be kept (sub-word too, not just int64).  OP_NEG
		// lowers to `sub <Typ> 0, arg`, so a hardcoded host-int Typ over a
		// sub-word arg emits invalid IR (`sub i64 %i8`) and a host-width
		// negation reads the wrong value (-1 as uint8 must be 255, not host
		// -1; -9223372036854775808 against i32 silently turns into 0 — see
		// conformance 423).  This is the exact analog of the
		// `~` (OP_BITNOT) result-type fix below — both peel a named-distinct
		// wrapper (`StripWrappers`) so `type Small uint8` negates at i8, not
		// host i64; llvmType unwraps the named type to its underlying width.
		// For an untyped-int operand (arg.Typ carries no Width) the checker's
		// resolved type supplies the concrete width — peeled like arg.Typ, since
		// a named typed constant's type (`-CS` with `type S int8`) is named.
		var negTyp @types.Type = types.TypInt()
		if arg.Typ != nil && arg.Typ.IsFloat() {
			negTyp = arg.Typ
		} else if arg.Typ != nil && types.StripWrappers(arg.Typ).Kind == types.TYP_INT {
			negTyp = arg.Typ
		} else if ctx.Checker != nil && e.ResolvedTypeID != 0 {
			var t @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
			if t != nil && types.StripWrappers(t).Kind == types.TYP_INT {
				negTyp = t
			}
		}
		return irbuild.EmitUnary(b, iropcode.OP_NEG, arg, negTyp)
	}
	if e.Op == cast(int, token.NOT) {
		return irbuild.EmitUnary(b, iropcode.OP_NOT, arg, types.TypBool())
	}
	if e.Op == cast(int, token.TILDE) {
		// `~` (bitwise complement) preserves the operand's type exactly — no
		// widening. The result type must therefore be the operand's own type,
		// not a hardcoded `int`: OP_BITNOT lowers to `xor <Typ> arg, -1`
		// (emit_instr.bn), so a hardcoded i64 `Typ` over a sub-word arg emits
		// invalid IR (`xor i64 %i8`), and a hardcoded signed `Typ` over an
		// unsigned operand makes a directly-consumed `>>` pick an arithmetic
		// shift instead of logical.
		var bnTyp @types.Type = arg.Typ
		if bnTyp == nil {
			bnTyp = types.TypInt()
		}
		return irbuild.EmitUnary(b, iropcode.OP_BITNOT, arg, bnTyp)
	}
	return arg
}
