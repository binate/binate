package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// TestGenVarDeclUint32LiteralStaysUint32 verifies that the
// var-decl emission path consumes the LHS type as a literal type hint
// and emits the RHS literal directly at the typed-int target —
// rather than falling through to the magnitude heuristic which
// would promote 0xFFFFFFFF (= UINT32_MAX) to int64.  This is the
// `var y uint32 = ... & 0xFFFFFFFF` / ror32 mask case.
func TestGenVarDeclUint32LiteralStaysUint32() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint32 = 4294967295; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 4294967295 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil { return fail("no iropcode.OP_CONST_INT for 4294967295") }
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_INT || foundLit.Typ.Width != 32 ||
			foundLit.Typ.Signed {
		return fail("uint32 literal in uint32 context should land at uint32")
	}
	return ""
}

// TestExprIntLitValueViaChecker verifies that with a Checker
// installed, EXPR_INT_LIT pulls its value from the type-checker's
// bignum (LitMag/LitSign) rather than parseIntLit.  The integer
// at int64-min stress-tests the boundary: both paths produce the
// same int64-min.
func TestExprIntLitValueViaChecker() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x int64 = -9223372036854775808; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == -9223372036854775807 - 1 {
			foundLit = ins
		}
	}
	if foundLit == nil {
		return fail("expected iropcode.OP_CONST_INT for int64-min via the checker")
	}
	return ""
}

// TestGenUnaryMinusInInt8ContextElidesOpNeg verifies the literal-narrowing
// non-EXPR_INT_LIT path: an EXPR_UNARY(MINUS, EXPR_INT_LIT) whose
// resolved Type carries HasLitVal (the type checker's
// checkUnaryExpr propagates the lit value with sign flipped)
// narrows to the typed-int hint directly when needsHintNarrowing
// fires for the hint.  int8 differs from the host's `int` in
// width, so on any host the narrow-to-hint path runs and
// OP_NEG is elided.  (`var lo int64 = -9223372036854775808` on
// 32-bit targets exercises the same code path with int64 differing
// from host int's width — caught at conformance, not here.)
func TestGenUnaryMinusInInt8ContextElidesOpNeg() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x int8 = -100; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	var foundNeg bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == -100 {
			foundLit = ins
		}
		if ins.Op == iropcode.OP_NEG { foundNeg = true }
	}
	if foundLit == nil {
		return fail("expected iropcode.OP_CONST_INT for -100")
	}
	if foundNeg {
		return fail("iropcode.OP_NEG should be elided when unary-minus folds to its int8 hint")
	}
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_INT || foundLit.Typ.Width != 8 ||
			!foundLit.Typ.Signed {
		return fail("folded literal should land at int8")
	}
	return ""
}

// TestGenWideIntLitPreservedInInt64Context verifies that an integer
// literal whose value exceeds int32 range, when assigned to a
// typed int64 slot, preserves its bit pattern through OP_CONST_INT
// without truncation.  The literal may stay TypUntypedInt (which
// lowers to host int width — i64 on the 64-bit test host) OR the
// typed-int hint may narrow it to int64 directly.  Both are correct
// emissions; what matters is the IntVal value lands untruncated on
// the OP_CONST_INT.
func TestGenWideIntLitPreservedInInt64Context() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x int64 = 5000000000; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 5000000000 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil { return fail("no iropcode.OP_CONST_INT for 5000000000") }
	return ""
}

// TestGenCastNegLitOverflowingHostIntPromotesToInt64 pins the fold
// of an int64 literal under unary minus (an arm32 miscompile without
// it).  The
// idiom `cast(int64, -9223372036854775807) - cast(int64, 1)` is
// how callers construct int64-min (the literal `-9223372036854775808`
// isn't directly parseable as a single token).  Without the fold,
// the unary-minus's recursive genExpr emits the inner literal at
// TypUntypedInt → intLL() = i32 under the 32-bit target, silently
// truncating 9223372036854775807 to -1 before negation, and the
// outer cast widens the wrong bit pattern.  The fold-aware path
// short-circuits at the unary node — its resolved type has
// HasLitVal=true with the full magnitude — emitting a single
// OP_CONST_INT at int64 instead.
//
// Switches to a 32-bit target so the fold gate fires (no-op on the
// LP64 host without it); saves and restores the prior target so the
// test doesn't pollute global state for subsequent tests (which
// matters when the unit-test binary itself is arm32 — restoring to
// an unconditional 64-bit there breaks every later test that reads
// `types.GetTarget().IntSize`).
func TestGenCastNegLitOverflowingHostIntPromotesToInt64() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTarget32()
	// `func f() int64 { return ... }` keeps the source under the
	// 100-char line cap while still pinning the same IR shape as
	// `var x int64 = ...; _ = x` (the OP_CONST_INT for the unary-
	// minus result is the same instruction either way).
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"func f() int64 { return cast(int64, -9223372036854775807) - cast(int64, 1)}\n")
	types.SetTarget(saved)
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundFold @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CONST_INT && ins.IntVal == -9223372036854775807 {
			foundFold = ins
		}
	}
	if foundFold == nil {
		return fail("expected fold-emitted iropcode.OP_CONST_INT for -9223372036854775807")
	}
	if foundFold.Typ == nil || foundFold.Typ.Kind != types.TYP_INT || foundFold.Typ.Width != 64 {
		return fail("fold-emitted literal should land at int64 (Width=64)")
	}
	return ""
}

// setTarget32 mirrors the helper in pkg/binate/types/scope_test.bn —
// duplicated here so this test file stays self-contained without
// pulling pkg/binate/types' test helpers in.  The matching restore is done
// directly via `types.SetTarget(saved)` against a `types.GetTarget()`
// snapshot taken before the override, so we don't bake the host
// width into a `setTarget64` constant that would clobber arm32-host
// runs.
func setTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
}

// TestGenCastWideLiteralHintsTargetType verifies that the operand
// of `cast(uint64, <int-literal>)` is emitted at the cast's target
// type (uint64), not at the untyped-int default.  On a 32-bit
// target the untyped default is i32, so without this the literal
// 0x0102030405060708 would truncate to its low word (0x05060708)
// before the widening cast — see conformance/488_cast_wide_literal
// for the end-to-end (truncation) guard.  Here on a 64-bit host
// the value survives either way; what this pins is that the
// literal carries the uint64 target type (the cast-operand type
// hint).
func TestGenCastWideLiteralHintsTargetType() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var v uint64 = cast(uint64, 0x0102030405060708); _ = v }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 72623859790382856 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil {
		return fail("no iropcode.OP_CONST_INT for 0x0102030405060708")
	}
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_INT || foundLit.Typ.Width != 64 ||
			foundLit.Typ.Signed {
		return fail("cast(uint64, lit) operand should land at uint64")
	}
	return ""
}

// TestGenNarrowIntLitStaysUntyped verifies the inverse: a literal
// that fits in int32 still rides on TYP_UNTYPED_INT (Width=0) so
// the type checker / type inference machinery can still narrow it
// to e.g. int8 / uint32 / etc. without an explicit cast.
func TestGenNarrowIntLitStaysUntyped() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\nfunc main() { var x int = 42; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundLit @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_INT && entry.Instrs[i].IntVal == 42 {
			foundLit = entry.Instrs[i]
		}
	}
	if foundLit == nil { return fail("no iropcode.OP_CONST_INT for 42") }
	if foundLit.Typ == nil || foundLit.Typ.Kind != types.TYP_UNTYPED_INT {
		return fail("narrow int literal should remain TYP_UNTYPED_INT")
	}
	return ""
}

// Negating a named typed constant (`-CS`, `const CS S = 5` with `type S int8`)
// is typed by the constant's type, peeled to the int8 it names — not the host
// int.
func TestGenUnaryMinusOnNamedTypedConst() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\ntype S int8\nconst CS S = 5\nfunc f() S { return -CS }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var neg @ir.Instr = firstOp(m.Funcs[0], iropcode.OP_NEG)
	if neg == nil { return fail("no iropcode.OP_NEG instruction") }
	var t @types.Type = types.StripWrappers(neg.Typ)
	if t == nil || t.Kind != types.TYP_INT || t.Width != 8 || !t.Signed {
		return fail("-CS should negate at int8")
	}
	return ""
}

// Unary minus `-x` on a sub-word int must type its OP_NEG result as the
// operand's width (not host int) — else codegen emits `sub i64 %i8` (invalid
// IR) and a host-width negation reads the wrong value.  The exact analog of
// the `~` OP_BITNOT width handling below.
func TestGenUnaryMinusOnUint16PreservesWidth() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint16 = 5; var y uint16 = -x; _ = y }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var found @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_NEG {
			found = entry.Instrs[i]
		}
	}
	if found == nil { return fail("no iropcode.OP_NEG instruction") }
	if found.Typ == nil || found.Typ.Kind != types.TYP_INT || found.Typ.Width != 16 {
		return fail("iropcode.OP_NEG on uint16 should keep Width=16, not int")
	}
	return ""
}

// NOTE: the NAMED sub-word variant (`type U16 uint16; -x`) is pinned by
// conformance regressions/unary-minus-named-subword, NOT a unit test here:
// the genFromSourceWithChecker harness does not link a named type's underlying
// the way the full pipeline does, so genUnary sees a host-int operand and
// produces a host-width OP_NEG either way — the harness can't distinguish a
// right lowering from a wrong one for named types (cf. the readonly/named note on
// TestGenReadonlyManagedPtrFieldRead in gen_selector_test.bn).

// `~x` (bitwise complement) must type its OP_BITNOT result as the OPERAND's
// type, not a hardcoded `int`.  A sub-word operand must keep its width — else
// codegen emits `xor i64 %i8`, which is invalid IR.
func TestGenBitnotOnUint16PreservesWidth() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint16 = 5; var y uint16 = ~x; _ = y }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var found @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_BITNOT {
			found = entry.Instrs[i]
		}
	}
	if found == nil { return fail("no iropcode.OP_BITNOT instruction") }
	if found.Typ == nil || found.Typ.Kind != types.TYP_INT || found.Typ.Width != 16 {
		return fail("iropcode.OP_BITNOT on uint16 should keep Width=16, not int")
	}
	return ""
}

// An unsigned operand must keep its signedness through `~` — else a directly
// consumed `>>` lowers to an arithmetic (sign-filling) shift, not logical.
func TestGenBitnotOnUint64IsUnsigned() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\nfunc main() { var x uint64 = 5; var y uint64 = ~x; _ = y }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var found @ir.Instr = nil
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_BITNOT {
			found = entry.Instrs[i]
		}
	}
	if found == nil { return fail("no iropcode.OP_BITNOT instruction") }
	if found.Typ == nil || found.Typ.Signed {
		return fail("iropcode.OP_BITNOT on uint64 must be unsigned, else >> is arithmetic")
	}
	return ""
}

// A float literal lowers to OP_CONST_FLOAT with the raw literal text
// preserved in StrVal.
func TestGenFloatLit() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func main() { var x float64 = 3.14; _ = x }\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundFloat bool = false
	var txt @[]char
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_CONST_FLOAT {
			foundFloat = true
			txt = entry.Instrs[i].StrVal
		}
	}
	if !foundFloat { return fail("no iropcode.OP_CONST_FLOAT instruction found") }
	if !irutil.CharEq(txt, "3.14") {
		return fail("iropcode.OP_CONST_FLOAT StrVal should be the raw literal '3.14'")
	}
	return ""
}

// Float arithmetic produces OP_ADD on float-typed operands. The
// existing OP_ADD dispatch is reused — backends look at the operand
// type to decide between integer and floating-point ops.

func TestGenConstIota() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tA int = iota\n\tB\n\tC\n)\n")
	cb.Write("func main() {")
	cb.Write(" _ = A; _ = B; _ = C }\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	// iota should emit A=0, B=1, C=2 as OP_CONST_INT. Verify each
	// value appears at least once in the const-int stream (rather
	// than by position, which other emitted consts could shift).
	var saw0 bool = false
	var saw1 bool = false
	var saw2 bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op != iropcode.OP_CONST_INT { continue }
		var v int64 = entry.Instrs[i].IntVal
		if v == 0 { saw0 = true }
		if v == 1 { saw1 = true }
		if v == 2 { saw2 = true }
	}
	if !saw0 { return fail("A=0 not emitted as const_int") }
	if !saw1 { return fail("B=1 not emitted as const_int") }
	if !saw2 { return fail("C=2 not emitted as const_int") }
	return ""
}

func TestSliceSetStringToChars() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\nfunc main() {\n")
	src = concatChars(src, "  var ss @[]*[]readonly char = make_slice(*[]readonly char, 1)\n")
	src = concatChars(src, "  ss[0] = \"hello\"\n")
	src = concatChars(src, "  ss[0] = \"replaced\"\n")
	src = concatChars(src, "}\n")
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("no funcs") }
	// The slice set of a string literal to a *[]readonly char element should emit string_to_chars
	// Slice set lowers to OP_STORE. Check that store exists.
	var found bool = false
	for i := 0; i < len(m.Funcs[0].Blocks); i++ {
		var b @ir.Block = m.Funcs[0].Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == iropcode.OP_STORE {
				found = true
			}
		}
	}
	if !found { return fail("no iropcode.OP_STORE found for slice set") }
	// Read-only string→*[]readonly char lowers to
	// OP_RODATA_SLICE (not OP_STRING_TO_CHARS).
	var stcCount int = 0
	for i := 0; i < len(m.Funcs[0].Blocks); i++ {
		var b @ir.Block = m.Funcs[0].Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == iropcode.OP_RODATA_SLICE {
				stcCount = stcCount + 1
			}
		}
	}
	// Should have at least 2: one for ss[0] = "hello", one for ss[0] = "replaced"
	if stcCount < 2 { return fail("expected at least 2 iropcode.OP_RODATA_SLICE") }
	return ""
}

// `&s.field` where s is a local struct must lower to OP_GET_FIELD_PTR
// (a field pointer), NOT to OP_LOAD of the field value. genUnary's
// `&` arm routes the address-of-selector case through genSelectorPtr;
// an EXPR_SELECTOR that falls through to `genExpr(e.X)` emits the
// LOAD.
func TestGenAmpOnLocalSelector() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Pt struct { x int; y int }\n")
	cb.Write("func main() {\n")
	cb.Write("  var p Pt\n")
	cb.Write("  var px *int = &p.x\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	var mainFunc @ir.Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	// A correct lowering of `&p.x` produces an OP_GET_FIELD_PTR
	// (the field pointer); a wrong one emits an OP_LOAD of the
	// field's value instead.
	var foundFieldPtr bool = false
	var foundLoadOfField bool = false
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @ir.Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == iropcode.OP_GET_FIELD_PTR {
				foundFieldPtr = true
			}
			// LOAD whose source is GET_FIELD_PTR — the wrong shape.
			// (The correct lowering produces no LOAD for `&p.x`.)
			if instr.Op == iropcode.OP_LOAD && len(instr.Args) > 0 && instr.Args[0] != nil &&
					instr.Args[0].Op == iropcode.OP_GET_FIELD_PTR {
				foundLoadOfField = true
			}
		}
	}
	if !foundFieldPtr {
		return fail("&p.x should produce iropcode.OP_GET_FIELD_PTR")
	}
	if foundLoadOfField {
		return fail("&p.x must NOT produce iropcode.OP_LOAD of the field — that's the bug shape")
	}
	return ""
}

// Deref of a managed pointer (`*p` where `p` is `@T`) must size the
// load by T, not fall back to int.  If gen_expr.bn's EXPR_UNARY/STAR
// branch matches only TYP_POINTER on the operand, TYP_MANAGED_PTR
// falls through to TypInt(), which breaks pointer-to-iface-value
// dispatch (`(*p).Foo()` returns a constant 0 — conformance 444 / 445).
func TestGenDerefManagedPtrSizesByElem() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface I { Foo() int }\n")
	cb.Write("type T struct { x int }\n")
	cb.Write("func (t *T) Foo() int { return t.x }\n")
	cb.Write("impl *T : I\n")
	cb.Write("func use(p @(*I)) int { return (*p).Foo() }\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	// Find use().  Walk its blocks for the OP_LOAD whose argument is
	// the managed-pointer parameter — that's the `*p` deref.  Its
	// result type must be the TYP_INTERFACE_VALUE iv shape, NOT
	// TypInt.
	var f @ir.Func
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.CharEq(m.Funcs[i].Name, "test.use") {
			f = m.Funcs[i]
		}
	}
	if f == nil { return fail("use() not in module") }
	var foundLoad bool = false
	var loadTypKind int = -1
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op != iropcode.OP_LOAD { continue }
			if ins.Typ == nil { continue }
			if ins.Typ.Kind == types.TYP_INTERFACE_VALUE {
				foundLoad = true
				loadTypKind = ins.Typ.Kind
			}
		}
	}
	if !foundLoad {
		return fail(
				"expected an iropcode.OP_LOAD with TYP_INTERFACE_VALUE result type")
	}
	if loadTypKind != types.TYP_INTERFACE_VALUE {
		return fail(
				"iropcode.OP_LOAD for *p (p: @(*Iface)) must size by iv, not int")
	}
	return ""
}

// Pointer-to-iv smoothing: `p.Foo()` for `p **I` must emit an
// OP_LOAD sized as TYP_INTERFACE_VALUE before OP_CALL_IFACE_METHOD;
// this test verifies both the IR-gen shape (the smoothing-load is
// emitted) and that the iface-dispatch instruction follows.
func TestGenSmoothingPtrToIvEmitsLoadThenDispatch() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface I { Foo() int }\n")
	cb.Write("type T struct { x int }\n")
	cb.Write("func (t *T) Foo() int { return t.x }\n")
	cb.Write("impl *T : I\n")
	cb.Write("func use(p **I) int { return p.Foo() }\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var f @ir.Func
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.CharEq(m.Funcs[i].Name, "test.use") {
			f = m.Funcs[i]
		}
	}
	if f == nil { return fail("use() not in module") }
	// Walk the use() body — must see (in order) an OP_LOAD with iv
	// result type (the smoothing load) followed by an
	// OP_CALL_IFACE_METHOD.
	var sawLoadIv bool = false
	var sawIfaceDispatch bool = false
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_LOAD && ins.Typ != nil && ins.Typ.Kind == types.TYP_INTERFACE_VALUE {
				sawLoadIv = true
			}
			if ins.Op == iropcode.OP_CALL_IFACE_METHOD && sawLoadIv {
				sawIfaceDispatch = true
			}
		}
	}
	if !sawLoadIv {
		return fail(
				"expected an iropcode.OP_LOAD with iv result type (smoothing load)")
	}
	if !sawIfaceDispatch {
		return fail(
				"expected iropcode.OP_CALL_IFACE_METHOD after the smoothing load")
	}
	return ""
}

// iv-element-write hint: `s[i] = &t` for a slice whose element
// type is iv must construct an iv (data + vtable) from the *T rhs,
// not store just the data pointer.  IR-gen passes the collection's
// element type as lhsTypHint so genExprOrFuncRef's wrap path runs,
// and the value reaching EmitSliceSet is an OP_IFACE_VALUE result,
// not a bare *T pointer.
func TestGenSliceElemAssignWrapsIfaceValue() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("interface I { Foo() int }\n")
	cb.Write("type T struct { x int }\n")
	cb.Write("func (t *T) Foo() int { return t.x }\n")
	cb.Write("impl *T : I\n")
	cb.Write("func use(s *[]*I, t *T) { s[0] = t }\n")
	var m @ir.Module = genFromSource(buf.CopyStr(cb.String()))
	var f @ir.Func
	for i := 0; i < len(m.Funcs); i++ {
		if irutil.CharEq(m.Funcs[i].Name, "test.use") {
			f = m.Funcs[i]
		}
	}
	if f == nil { return fail("use() not in module") }
	var sawIvConstruct bool = false
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_IFACE_VALUE {
				sawIvConstruct = true
			}
		}
	}
	if !sawIvConstruct {
		return fail(
				"expected iropcode.OP_IFACE_VALUE for `s[0] = &t` (slice element of iv type)")
	}
	return ""
}
