package "pkg/binate/irgen"

// nameIsCompilerInternalFunc reports whether a bodyless, `.bni`-exported function
// name is one of the compiler's OWN internal intrinsics — by convention
// `_`-prefixed (rt._call_shim_*, rt._call_dtor, rt._call_free_fn,
// debug._stack_frames, ...).  These are lowered inline to a dedicated op with NO
// linkable symbol (gen_call.bn / gen_stackframes.bn), so they must stay out of the
// package descriptor + func-value triple — a symref to their handle would dangle
// at link.
//
// This is deliberately a NARROW blocklist of the compiler's own `_`-prefixed
// helpers, NOT an allowlist of externally-provided functions: a user package must
// be free to provide an external (asm / C / …) definition for any PUBLICLY-named
// exported function (e.g. aarch64 rt.MemZero), and such a function — bodyless here,
// its definition linked in — DOES get a descriptor + triple (see genFunc's
// ExternalDef).  A public name is never `_`-prefixed, so the two never collide.
func nameIsCompilerInternalFunc(name *[]readonly char) bool {
	return len(name) > 0 && name[0] == '_'
}
