package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for gen_for_in.bn.

// forInExpr builds an expression node of the given kind over x.
func forInExpr(kind int, x @ast.Expr, name *[]readonly char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = kind
	e.X = x
	e.Name = buf.CopyStr(name)
	return e
}

// A range operand rooted in a variable — the variable, or a field / element /
// `*p` chain from one — is stable; a call result, a composite literal, or a
// chain rooted in one is not.
func TestForInOperandIsStable() testing.TestResult {
	var v @ast.Expr = forInExpr(ast.EXPR_IDENT, nil, "v")
	if !forInOperandIsStable(v) { return fail("a variable is stable") }
	if !forInOperandIsStable(forInExpr(ast.EXPR_SELECTOR, v, "f")) {
		return fail("a field of a variable is stable")
	}
	if !forInOperandIsStable(forInExpr(ast.EXPR_INSTANTIATE_OR_INDEX, v, "")) {
		return fail("an element of a variable is stable")
	}
	var star @ast.Expr = forInExpr(ast.EXPR_UNARY, v, "")
	star.Op = cast(int, token.STAR)
	if !forInOperandIsStable(star) { return fail("`*p` of a variable is stable") }
	var call @ast.Expr = forInExpr(ast.EXPR_CALL, v, "")
	if forInOperandIsStable(call) { return fail("a call result is not stable") }
	if forInOperandIsStable(forInExpr(ast.EXPR_SELECTOR, call, "f")) {
		return fail("a field of a call result is not stable")
	}
	if forInOperandIsStable(forInExpr(ast.EXPR_COMPOSITE, nil, "")) {
		return fail("a composite literal is not stable")
	}
	return ""
}

// A range loop over an array-returning call binds the result to the hidden
// operand local and ranges it through its storage (element pointers) — never
// as a slice value.
func TestForInArrayCallResultRangedThroughStorage() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func mk() [2]int { return [2]int{1, 2} }\n"
					"func main() {\n"
					"\tvar t int = 0\n"
					"\tfor x in mk() { t = t + x }\n"
					"\t_ = t\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "main")
	if fn == nil { return fail("main not found") }
	var hidden int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			var instr @ir.Instr = b.Instrs[j]
			if instr.Op == iropcode.OP_ALLOC && irutil.Streq(instr.StrVal, forInOperandName()) {
				hidden = hidden + 1
			}
		}
	}
	if hidden != 1 { return fail("the call result should be bound to one hidden operand local") }
	if countOp(fn, iropcode.OP_GET_ELEM_PTR) == 0 {
		return fail("the array should be ranged through element pointers")
	}
	return ""
}
