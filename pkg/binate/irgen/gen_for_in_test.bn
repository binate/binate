package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/builtins/testing"

// Tests for gen_for_in.bn.

// countForInOperands counts fn's allocas of a range loop's hidden operand local.
func countForInOperands(fn @ir.Func) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			var instr @ir.Instr = b.Instrs[j]
			if instr.Op == iropcode.OP_ALLOC && irutil.Streq(instr.StrVal, forInOperandName()) {
				n = n + 1
			}
		}
	}
	return n
}

// A range loop over an array-returning call binds the result to the hidden
// operand local and ranges it through its storage (element pointers) — never
// as a slice value.
func TestForInArrayCallResultRangedThroughStorage() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func mk() [2]int { return [2]int{1, 2} }\n"
					"func main() {\n"
					"\tvar t int = 0\n"
					"\tfor x in mk() { t = t + x }\n"
					"\t_ = t\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "main")
	if fn == nil { return fail("main not found") }
	if countForInOperands(fn) != 1 {
		return fail("the call result should be bound to one hidden operand local")
	}
	if countOp(fn, iropcode.OP_GET_ELEM_PTR) == 0 {
		return fail("the array should be ranged through element pointers")
	}
	return ""
}

// A variable operand gets a hidden operand local too — the loop ranges a copy
// of an array variable and holds its own reference to a managed-slice — so each
// of the two loops binds one.
func TestForInVariableOperandBoundToHiddenLocal() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func main() {\n"
					"\tvar a [2]int = [2]int{1, 2}\n"
					"\tvar s @[]int = make_slice(int, 2)\n"
					"\tvar t int = 0\n"
					"\tfor x in a { t = t + x }\n"
					"\tfor y in s { t = t + y }\n"
					"\t_ = t\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "main")
	if fn == nil { return fail("main not found") }
	if countForInOperands(fn) != 2 {
		return fail("each loop should bind its variable operand to a hidden operand local")
	}
	return ""
}
