package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Function generation
// ============================================================

// genFunc generates a complete IR function from a function declaration AST node.
func genFunc(gc @GenCtx, c @check.Checker, d @ast.Decl) @ir.Func {
	var noPrepended @[]@ir.Param
	return genFuncWithPrependedParams(gc, c, d, noPrepended, nil)
}

// funcSymbolName returns the name a function declaration is emitted under: its
// own name, or — for a blank `func _`, which IR-gen emits only when it carries
// `#[c_export]` (normalizeFileDecls) — `__c_export_<C name>`: the function binds
// no Binate name, so nothing in Binate calls it, and its C export name is unique
// (the linker rejects two definitions of one C symbol).  `__`-prefixed names are
// reserved for the implementation, so no user declaration collides with it.
func funcSymbolName(d @ast.Decl) @[]char {
	if !isBlank(d.Name) {
		return d.Name
	}
	var cnames @[]@[]char = collectCExportNames(d.Annotations)
	if len(cnames) == 0 {
		return d.Name
	}
	return buf.Concat("__c_export_", cnames[0])
}

// collectCExportNames extracts the C symbol name(s) from every `#[c_export(...)]`
// annotation on a decl, surrounding quotes stripped.  Empty for a decl with no
// c_export annotation.  buildcfg.DeclIncluded has already validated the argument
// form (each a single string literal), so a non-string arg is skipped defensively
// rather than re-reported here.
func collectCExportNames(annots @[]@ast.Annotation) @[]@[]char {
	var names @[]@[]char
	for i := 0; i < len(annots); i++ {
		var a @ast.Annotation = annots[i]
		if !irutil.Streq(a.Name, "c_export") { continue }
		for j := 0; j < len(a.Args); j++ {
			var arg @ast.Expr = a.Args[j]
			if arg == nil || arg.Kind != ast.EXPR_STRING_LIT { continue }
			names = slices.Append[@[]char](names, stripStrLit(arg.Name))
		}
	}
	return names
}

// stripStrLit returns the interior of a quoted string literal `lit` (whose text
// includes its surrounding quotes) as an owned copy — e.g. `"foo"` -> `foo`.
// Empty for a degenerate (< 2 char) literal.  No escape decoding: a C symbol
// name is a plain identifier, and the name is left permissive regardless.
func stripStrLit(lit *[]readonly char) @[]char {
	var n int = len(lit)
	if n < 2 {
		return buf.CopyStr("")
	}
	return buf.CopyStr(lit[1:n - 1])
}

// genFuncWithPrependedParams is the body of genFunc, parameterized
// by an additional list of params to prepend before the
// d.Params-derived ones.  Used by closure-literal codegen:
// captures are pre-resolved
// Params built from Decl.Captures + the checker's ExprTypes
// side-table, prepended here so the lifted body's defineVarParam
// pass naturally registers their names as local variables.
// Non-closure callers pass nil.  outer is the function enclosing a
// function literal (nil otherwise), whose local constants its body sees.
func genFuncWithPrependedParams(gc @GenCtx, c @check.Checker, d @ast.Decl, prepended @[]@ir.Param,
		outer @GenContext) @ir.Func {
	// Build params
	var params @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc(gc.PkgPath, funcSymbolName(d), params, noResults)
	// Raw back-ref to the module being generated.  This is the only func-
	// creation path whose body emission runs scope cleanup (emitStructDtor /
	// emitStructCopy / emitManagedSliceRefDec), which register pending dtors;
	// the registrars reach the module's work-lists through f.Mod.  Borrow
	// (managed @Module → raw *Module), mirroring AddBlock's `b.Func = f` — no
	// refcount cycle.  Set before genBlock so registrations during body-gen
	// land on the right module.
	f.Mod = gc.Mod
	f.Line = d.Pos.Line
	f.Exported = d.Exported
	f.CExportNames = collectCExportNames(d.Annotations)

	// Prepended params are already fully-built (Name + Typ + ID
	// assigned via NewParam-by-the-caller).  Re-bind their owner
	// to this Func by re-issuing IDs through NewParam, which is
	// the only way to get monotonically-correct IDs scoped to f.
	for i := 0; i < len(prepended); i++ {
		var pp @ir.Param = prepended[i]
		var np @ir.Param = irbuild.NewParam(f, pp.Name, pp.Typ)
		params = slices.Append[@ir.Param](params, np)
	}

	if len(d.Params) > 0 {
		for i := 0; i < len(d.Params); i++ {
			var pd @ast.ParamDecl = d.Params[i]
			var pt @types.Type = irResolveParamType(gc, pd)
			var p @ir.Param = irbuild.NewParam(f, pd.Name, pt)
			params = slices.Append[@ir.Param](params, p)
		}
	}
	if len(params) > 0 {
		f.Params = params
	}

	// Build results
	if len(d.Results) > 0 {
		var results @[]@types.Type
		for i := 0; i < len(d.Results); i++ {
			results = slices.Append[@types.Type](results, resolveTypeExpr(gc, d.Results[i]))
		}
		f.Results = results
		// For multi-return, create an anonymous struct type
		if len(results) > 1 {
			f.MultiReturnType = irutil.MakeMultiReturnStructType(results)
		}
	}

	// If no body, mark as extern (declaration only).  genFunc only ever sees
	// OWN-package decls (from the merged .bni-prepended decl set), so a bodyless
	// EXPORTED one is a function this package declares but does not compile a Binate
	// body for on this arch — its definition is provided by a linked object (e.g.
	// the hand-written aarch64 rt.MemZero `.s`, or a user package's own asm/C impl).
	// Flag it ExternalDef so the package descriptor + func-value triple still list
	// it (so the bytecode VM can bind it), while it stays IsExtern for body emission
	// (a `declare`, no `define` to collide with the linked symbol) and the
	// optimizer.  EXCEPT the compiler's own `_`-prefixed internal intrinsics
	// (rt._call_*, debug._stack_frames, ...), which are lowered inline to a
	// dedicated op with no linkable symbol — a descriptor symref to them would
	// dangle.  (Imported-package declarations are created via RegisterImport, not
	// genFunc, so they never get ExternalDef and remain descriptor-excluded.)
	if d.Body == nil {
		f.IsExtern = true
		f.ExternalDef = f.Exported && !nameIsCompilerInternalFunc(d.Name)
		return f
	}

	// Generate body
	if d.Body != nil {
		var entry @ir.Block = ir.AddBlock(f, "entry")

		// Allocate stack slots for parameters.  Every param gets an
		// alloca (the slot) and a store-of-param-into-slot.  For
		// byval-eligible aggregate params the LLVM IR-level param is a
		// `ptr byval(<T>)` pointer; the per-param byval handling — the
		// IsByvalParamRef flag on the store's source placeholder, which
		// makes OP_STORE's LLVM emit a memcpy from the byval pointer to
		// the alloca so the callee gets its own copy — is set up below.
		// Native backends ignore the flag and stash incoming bytes via
		// a uniform alloca + store.
		var paramSlots @[]@ir.Instr
		for i := 0; i < len(f.Params); i++ {
			var slot @ir.Instr = irbuild.EmitAlloc(entry, f.Params[i].Typ)
			// Tag the slot with its 1-based parameter index so the
			// LLVM debug-info path can emit `arg: <N>` on the
			// DILocalVariable.
			slot.ParamIndex = i + 1
			// Store the incoming param value (a by-ID OP_PARAM placeholder;
			// newParamRef also sets the byval-memcpy flag for a byval-aggregate
			// param) into its slot.
			var paramRef @ir.Instr = irbuild.NewParamRef(f, f.Params[i])
			irbuild.EmitStore(entry, slot, paramRef)
			paramSlots = slices.Append[@ir.Instr](paramSlots, slot)
		}

		var ctx @GenContext = make(GenContext)
		ctx.Func = f
		ctx.Gc = gc
		ctx.Checker = c
		ctx.ParamSlots = paramSlots
		ctx.CurBlock = entry
		// A function literal's body sees the enclosing function's local
		// constants; its parameters, bound below, shadow them.
		inheritConstBindings(ctx, outer)

		// Register params as named variables (marked as params so slices aren't freed)
		for i := 0; i < len(f.Params); i++ {
			defineVarParam(ctx, f.Params[i].Name, paramSlots[i], f.Params[i].Typ)
		}

		// Increment refcount for managed pointer/slice params (callee owns a reference)
		for i := 0; i < len(f.Params); i++ {
			if irutil.IsManagedPtrType(f.Params[i].Typ) {
				var ptrVal @ir.Instr = irbuild.EmitLoad(entry, paramSlots[i], f.Params[i].Typ)
				irbuild.EmitRefInc(entry, ptrVal)
			}
			if irutil.IsManagedSliceType(f.Params[i].Typ) {
				var sliceVal @ir.Instr = irbuild.EmitLoad(entry, paramSlots[i], f.Params[i].Typ)
				emitManagedSliceRefInc(f, entry, sliceVal)
			}
			if irutil.IsManagedFuncValueType(f.Params[i].Typ) {
				var fvVal @ir.Instr = irbuild.EmitLoad(entry, paramSlots[i], f.Params[i].Typ)
				emitManagedFuncValueRefInc(f, entry, fvVal)
			}
			// NOTE: managed interface-value params get NO entry RefInc.
			// They use the move model: the caller moves a fresh @Iface
			// arg into the call (consumeTemp) or RefInc's a borrowed one
			// at the call site (genCall / genMethod), and the param's
			// scope-exit RefDec releases that single ref.  An entry RefInc
			// would require the caller to retain+clean its arg COPY after
			// the call, which the bytecode VM cannot do for a 2-word
			// iface value passed on transient vm.SP (the call reclaims it).
			//
			// A closure's CAPTURE params (the prepended ones) have no such
			// caller: the shim / trampoline loads them straight out of the
			// closure struct with no acquire.  So do here what a caller
			// does for the caller-acquires param kinds — RefInc a managed
			// interface value, copy-in a by-value struct / array with
			// managed fields — and each call's scope-exit release drops
			// this acquire instead of the closure's own reference.
			if i < len(prepended) {
				if irutil.IsManagedIfaceValueType(f.Params[i].Typ) {
					var ivVal @ir.Instr = irbuild.EmitLoad(entry, paramSlots[i], f.Params[i].Typ)
					emitManagedIfaceValueRefInc(f, entry, ivVal)
				}
				if needsStructCopy(f.Params[i].Typ) {
					emitStructCopy(f, entry, paramSlots[i], f.Params[i].Typ)
				}
			}
		}

		// Local consts declared in the body are appended to Module.Consts
		// (so resolveTypeExpr / evalConstIR can read their compile-time
		// value for an array dimension `[N]int`).  Save the length now and
		// truncate after the body so a function's local consts don't leak
		// into sibling functions; save/restore nests correctly for inner
		// func literals.
		// Function-entry pre-pass: allocate the armed flag + operand slots for
		// every lexical defer in the body (registers managed operand slots into
		// ctx.Vars, so this must precede genBlock — the slots then sit at entry
		// depth, below any block's savedVarLen, and survive block-exit
		// truncation to every function exit).
		registerFuncDefers(ctx, entry, d.Body)
		var hasDefers bool = len(ctx.Defers) > 0
		// The prologue — parameter slots and their acquires, the defer slots — has
		// no faulting op; frame closure records are allocated here, ahead of the
		// body (allocFrameClosureRecord).
		ctx.FrameRecordAt = len(entry.Instrs)

		var savedConstLen int = len(gc.Mod.Consts)
		// When the function has defers, the outermost body block must NOT release
		// its function-scope locals on a fall-off exit — the epilogue below runs
		// the deferred calls first, while those locals are live (stmt.defer.exit),
		// then releases them.  A defer-free function keeps the original behavior.
		genBlockEx(ctx, entry, d.Body, hasDefers)
		gc.Mod.Consts = gc.Mod.Consts[:savedConstLen]

		// If block isn't terminated, add return or unreachable.  A void fall-off
		// is a normal function exit: run the pending deferred calls (LIFO,
		// armed-gated) BEFORE the whole-function managed-local release.
		var isVoid bool = len(f.Results) == 0
		if len(entry.Instrs) == 0 || !entry.Instrs[len(entry.Instrs) - 1].IsTerminator() {
			if isVoid {
				entry = emitPendingDefers(ctx, entry)
				var noRetExprs *[]@ast.Expr
				entry = emitDecForManagedLocals(ctx, entry, noRetExprs)
				var noRetVals @[]@ir.Instr
				irbuild.EmitReturn(entry, noRetVals)
			} else {
				irbuild.EmitUnreachable(entry)
			}
		}
		// Also check all blocks.  Snapshot the count first: emitPendingDefers
		// appends defer-runner blocks (all terminated), which must not be
		// re-scanned as fresh fall-off exits.
		var nBlocks int = len(f.Blocks)
		for i := 0; i < nBlocks; i++ {
			var blk @ir.Block = f.Blocks[i]
			if len(blk.Instrs) == 0 || !blk.Instrs[len(blk.Instrs) - 1].IsTerminator() {
				if isVoid {
					blk = emitPendingDefers(ctx, blk)
					var noRetExprs2 *[]@ast.Expr
					blk = emitDecForManagedLocals(ctx, blk, noRetExprs2)
					var noRetVals2 @[]@ir.Instr
					irbuild.EmitReturn(blk, noRetVals2)
				} else {
					irbuild.EmitUnreachable(blk)
				}
			}
		}
		// Release the frame closure records at every exit — including the exits
		// generated before their closure sites.
		releaseFrameClosureRecords(ctx)
	}

	// Structural IR check (off by default; toggle via SetVerifyIR).  When
	// on, aborts the compile with diagnostics if this finalized func is
	// malformed — turning a silent IR-gen miscompile (e.g. a ctx.CurBlock
	// desync that strands stores in a terminated block) into a loud,
	// located failure.
	irbuild.VerifyFuncOrAbort(f)
	return f
}

// GenContext holds state during IR generation for one function.
type GenContext struct {
	Func @ir.Func
	Gc   @GenCtx // the per-compilation gen context (copied from
	// the gc threaded into genFunc); per-function gen
	// reaches module-gen state through it (Gc.Mod).
	Checker @check.Checker // the module's type-Checker (copied from m.Checker
	// at GenContext creation); consulted for per-
	// expression resolved types.  Nil-safe.
	Vars       @[]VarSlot // named variable → alloca'd pointer
	ParamSlots @[]@ir.Instr // param index → alloca'd pointer
	BreakTo    @ir.Block // current break target
	ContinueTo @ir.Block // current continue target
	// len(Vars) at the point BreakTo/ContinueTo were set — the scope level of
	// the break/continue target.  STMT_BREAK / STMT_CONTINUE RefDec the managed
	// locals declared since then (Vars[BreakVarLen:]) before jumping, because the
	// target block does not (genBlock/genCaseBody drop those vars without a dec
	// on a terminator).  Without it a managed local declared before a
	// break/continue leaks (never released).
	BreakVarLen    int
	ContinueVarLen int
	CurBlock       @ir.Block // tracks current block (updated by short-circuit eval)
	// Defers holds one DeferSite per lexical `defer` statement in this function,
	// in lexical order, built by the function-entry pre-pass (registerFuncDefers,
	// gen_defer.bn).  It is a function-level list — never truncated on block exit
	// (unlike Vars) — so a defer registered while gen'ing a nested block survives
	// to every function exit, where emitPendingDefers runs the armed ones LIFO.
	Defers @[]@DeferSite
	// FrameSlots holds the closure records of the capturing raw `*func` closures
	// (function literals and method values) this function creates.  A record is
	// allocated zero-filled in the entry block and lives as long as the frame
	// (func.closure.allocation), so — like Defers — this list is never truncated
	// on block exit: once the body is generated, releaseFrameClosureRecords
	// releases every record before each function exit and fault-pad unwind
	// (allocFrameClosureRecord, gen_vars.bn).
	FrameSlots @[]VarSlot
	// FrameRecordAt is the entry-block index just past the prologue, where
	// allocFrameClosureRecord inserts the next record's allocation.
	FrameRecordAt int
	// LoopDepth counts the loops whose repeated parts — a `for`'s condition,
	// body and post statement, a range loop's body — enclose the code being
	// generated.  Code at depth 0 runs at most once per call (the language has
	// no `goto`), which closureSiteRunsOnce relies on.
	LoopDepth int
	// SnapshotBorrows is set while EVALUATING a defer statement's operands
	// (gen_defer_exit.bn), so an implicit interface-value box of a VALUE source
	// (`defer Println(x)`) snapshots x's value at the defer site rather than
	// borrowing the variable's address — which would read the value at CALL time
	// (function exit), violating eager by-value operand evaluation (§14.13
	// stmt.defer; proposal-defer §4 "no late-binding surprises").  It routes
	// genBorrowSourceAddr through the materialize-a-temp path.  (Explicit late
	// observation still goes through a pointer, as the proposal intends.)
	SnapshotBorrows bool
	// DeferBorrowSlots / DeferBorrowCursor thread the pre-allocated, entry-depth
	// borrow-snapshot slots for the defer whose operands are currently being
	// stored (set by storeDeferOperands).  When an implicit interface-value box of
	// a managed-content VALUE operand materializes its snapshot temp
	// (genExprOrFuncRef's value-borrow path), it consumes the next slot here
	// instead of a fresh block-scoped temp — so the snapshot survives a
	// nested/conditional defer to the deferred call at function exit rather than
	// being freed at block exit.  Cursor advances once per managed borrow-temp, in
	// operand-evaluation order; the pre-pass allocated them in the same order.
	DeferBorrowSlots  @[]@ir.Instr
	DeferBorrowCursor int
	Temps             @[]@ir.Instr // managed temporaries to RefDec at end of statement
	StmtGrewSP        bool // any vm.SP-growing IR op emitted this statement?
	// Set by IR-gen when emitting OP_CALL / CALL_INDIRECT /
	// CALL_FUNC_VALUE returning an aggregate, OP_MAKE_SLICE,
	// OP_FUNC_VALUE, OP_RODATA_MSLICE_COPY, OP_RODATA_ARRAY.
	// Read + cleared by emitTempCleanup at end of statement;
	// when true, the cleanup emits OP_SP_RESTORE so the
	// bytecode VM reclaims vm.Stack bytes the statement
	// accumulated. The return-path cleanup
	// (emitTempCleanupForReturn) MUST NOT emit OP_SP_RESTORE
	// — doing so would truncate the about-to-be-returned
	// aggregate's bytes before BC_RETURN's copy-back fires.
	// LLVM and native backends treat OP_SP_RESTORE as a no-op.
}
