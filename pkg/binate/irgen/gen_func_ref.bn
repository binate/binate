package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/types"

// Function-reference resolution: which function a name used as one -- called, or
// taken as a function value -- names, by the name the module registers it under.

// isFuncRefExpr reports whether e is a syntactic function reference
// — a bare Ident, a pkg.Name Selector, or a method expression
// (T.M Selector where T is a known local type and M a method on it).
// Doesn't validate that the name actually resolves to a function;
// callers (e.g. genVarDecl) ask funcRefTarget which function, if any,
// it names.
func isFuncRefExpr(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return true }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		return true
	}
	return false
}

// namesFunction reports whether e names a function — a function, a package's
// function or a method expression, by name (isFuncRefExpr), or a method
// expression off a generic type's instance (`Box[int].Get`) — rather than a
// value of the same spelling.
func namesFunction(ctx @GenContext, e @ast.Expr) bool {
	if e != nil && e.Kind == ast.EXPR_SELECTOR && e.X != nil &&
			e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return len(genericInstanceName(ctx, e.X)) > 0
	}
	if !isFuncRefExpr(e) { return false }
	return len(funcRefTarget(ctx, e)) > 0
}

// funcRefName returns the qualified function name for a function-
// reference expression. Three shapes:
//   - Ident `f`              → `f`            (free function)
//   - Selector `pkg.Func`    → `pkg.Func`     (package-qualified)
//   - Selector `T.M`         → `<pkg>.T.M`    (method expression)
// An identifier or `pkg.Func` is named as the checker recorded it
// (recordedFuncRef): "" when it is no function.  A selector with no record of a
// package's member is a method expression -- its X recorded as a type
// (methodExprTarget) -- or no function; an identifier with no record is an
// internal error.
func funcRefName(ctx @GenContext, e @ast.Expr) @[]char {
	if e == nil { return "" }
	var gc @GenCtx = ctx.Gc
	var rn @[]char
	var have bool
	if e.Kind == ast.EXPR_IDENT {
		// The predeclared `panic` used as a value is the runtime's abort function.
		// Only the checker's mark says so: by its name, a generic body of another
		// package could take it for the instantiating package's own `panic`.
		if e.PredeclaredPanic { return panicFuncName() }
		rn, have = recordedFuncRef(gc, e)
		if !have { noRecordICE(e) }
		return rn
	}
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		rn, have = recordedFuncRef(gc, e)
		if have { return rn }
		// A method EXPRESSION `T.M` (methodExprTarget), or no function.
		rn, have = methodExprTarget(ctx, e)
		if have { return rn }
		return ""
	}
	// A method expression off a generic type INSTANTIATION (`Box[int].M` /
	// `pkg.Box[int].M`): resolve the instance and emit its methods, then name the
	// method by the mangled instantiation and the method the checker recorded
	// (selectorMethodName) — the SAME symbol genExprOrFuncRef's func-value form and
	// a direct method call use, so a direct invocation `Box[int].M(args)` links to
	// it.  This serves the call dispatcher's
	// direct-by-name path; it is NOT a hot per-call predicate like isMethodCallSel,
	// so the resolve is safe.  (A func-field call on an indexed value can also
	// reach here; genericInstanceName names no instance for it — its head is a
	// variable, or names no generic type — and the dispatcher's func-value
	// fallback handles it.)
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var instName @[]char = genericInstanceName(ctx, e.X)
		if len(instName) > 0 {
			ensureMethodsForInstName(gc, instName)
			return buildMethodQualName(gc.PkgPath, instName, selectorMethodName(ctx, e))
		}
	}
	return ""
}

// funcRefTarget returns the function the function reference e (isFuncRefExpr)
// names, by the name the module registers it under (funcRefName), or "" when the
// checker recorded e as no function.  A method expression whose type the checker
// recorded names its method (recordedMethodExpr).
func funcRefTarget(ctx @GenContext, e @ast.Expr) @[]char {
	var none @[]char
	if e.Kind != ast.EXPR_IDENT || !e.PredeclaredPanic {
		var rn @[]char
		var have bool
		rn, have = recordedFuncRef(ctx.Gc, e)
		if have { return rn }
		rn, have = recordedMethodExpr(ctx, e)
		if have { return rn }
	}
	var fnName @[]char = funcRefName(ctx, e)
	if len(fnName) == 0 || !lookupFuncExists(ctx.Gc, fnName) { return none }
	return fnName
}

// methodExprTarget returns the method the selector e (`X.M`, X an identifier)
// names as a method expression, and true; false when it is none -- X is a value
// or a package.  The checker's record of X decides (recordedMethodExpr: a type);
// none is an internal error.
func methodExprTarget(ctx @GenContext, e @ast.Expr) (@[]char, bool) {
	var none @[]char
	var name @[]char
	var have bool
	name, have = recordedMethodExpr(ctx, e)
	if have { return name, true }
	_, _, have = recordedValue(ctx.Gc, e.X)
	if !have { noRecordICE(e.X) }
	return none, false
}

// recordedMethodExpr returns the method the selector e (`X.M`, X an identifier)
// names where the checker recorded X as a type -- the method expression's
// receiver type, an alias's target -- by the name the module registers it under
// (aliasTargetMethodName on IR-gen's type for the record, with the name of the
// method the checker recorded: selectedMethodName), and true; false when
// it recorded no type for X.  A method the module has no signature for is
// declared (declareMethodExprTarget); one it then still has none for, or a type
// that names none, is an internal error.
func recordedMethodExpr(ctx @GenContext, e @ast.Expr) (@[]char, bool) {
	var none @[]char
	if e == nil || e.Kind != ast.EXPR_SELECTOR || e.X == nil || e.X.Kind != ast.EXPR_IDENT {
		return none, false
	}
	var rec @types.Type = exprDenotedRecord(ctx.Gc, e.X)
	if rec == nil { return none, false }
	rec = requireConcreteRecord(ctx.Gc, rec.ResolveAlias(), e.X.Pos, "a method expression's type")
	var t @types.Type = typeFromRecord(ctx.Gc, rec)
	var method @[]char = selectedMethodName(e, ctx.Checker.ExprMethod(e))
	var name @[]char = aliasTargetMethodName(ctx.Gc, t, ctx.Gc.PkgPath, method)
	if len(name) == 0 { recordMissICE(e, "method of the type") }
	declareMethodExprTarget(ctx, e, name)
	if !lookupFuncExists(ctx.Gc, name) { recordMissICE(e, "signature for the method") }
	return name, true
}

// namesMethodExpr reports whether the selector e (`X.M`, X an identifier) is a
// method expression, without naming its method: the checker recorded X as a
// type.  No record of X is an internal error.
func namesMethodExpr(ctx @GenContext, e @ast.Expr) bool {
	if exprDenotedRecord(ctx.Gc, e.X) != nil { return true }
	var have bool
	_, _, have = recordedValue(ctx.Gc, e.X)
	if !have { noRecordICE(e.X) }
	return false
}
