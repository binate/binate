package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_func_ref.bn: function references, read from the checker's
// records.

// addFuncSigFor registers a signature for the function name (bare for the
// module's own package) in gc's module.
func addFuncSigFor(gc @GenCtx, name *[]readonly char) {
	var sig irdata.FuncSig
	sig.Name = qualifyForCurrentModule(gc, name)
	setOrAppendFuncSig(gc, sig)
}

// A function reference with a record names the function the checker resolved it
// to, whatever IR-gen's scopes and registries make of its spelling: helper is
// main's function, not the generic package's helper nor a local named helper;
// a.F is pkg/a's function through an import rebound to pkg/b; g's parameter
// helper is no function; and so for the operand of a `_func_handle` or
// `__c_entry`.  Named from another package's module, as a generic body's
// instance is, a recorded function is qualified with its package.  A reference
// with no record is still read by its spelling.
func TestFuncRefsFromRecords() testing.TestResult {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nimport \"pkg/a\"\nfunc helper() int { return 1 }\n"
					"var hv *func() int = helper\nvar av *func() int = a.F\n"
					"func g(helper *func() int) int { return helper() }\n"
					"var hh *uint8 = _func_handle(helper)\nvar ah *uint8 = _func_handle(a.F)\n"
					"func cb(n int32) int32 { return n }\nvar ce *uint8 = __c_entry(cb)\n")
	var ctx @GenContext
	var b @ir.Block
	var file @ast.File
	var msg @[]char
	ctx, b, file, msg = recordsCtx()
	if len(msg) > 0 { return fail(msg) }
	var hv @ast.Expr = varInit(file, "hv")
	var av @ast.Expr = varInit(file, "av")
	var call @ast.Expr = funcResult(file, "g")
	var hh @ast.Expr = varInit(file, "hh")
	var ah @ast.Expr = varInit(file, "ah")
	var ce @ast.Expr = varInit(file, "ce")
	if hv == nil || av == nil || call == nil || hh == nil || ah == nil || ce == nil {
		return fail("the references must be found")
	}
	var gc @GenCtx = ctx.Gc
	addFuncSigFor(gc, "helper")
	addFuncSigFor(gc, "pkg/a.F")
	addFuncSigFor(gc, "pkg/a.helper")
	addFuncSigFor(gc, "cb")
	gc.Mod.CurrentImportPkg = buf.CopyStr("pkg/a")
	RebindImportPath(gc.Mod, "a", "pkg/b")
	addManagedVar(ctx, b, "helper")
	if !irutil.Streq(funcRefName(ctx, hv), "helper") ||
			!irutil.Streq(funcRefTarget(ctx, hv), "helper") {
		return fail("hv's helper must be main's function")
	}
	if !namesFunction(ctx, hv) { return fail("helper must name a function") }
	if !irutil.Streq(funcRefTarget(ctx, av), "pkg/a.F") { return fail("a.F must be pkg/a's F") }
	if len(funcRefName(ctx, call.X)) > 0 || len(funcRefTarget(ctx, call.X)) > 0 ||
			namesFunction(ctx, call.X) {
		return fail("g's helper must be no function")
	}
	if !irutil.Streq(builtinFuncOperand(ctx, hh.Args[0]), "helper") {
		return fail("hh's operand must be main's helper")
	}
	if !irutil.Streq(builtinFuncOperand(ctx, ah.Args[0]), "pkg/a.F") {
		return fail("ah's operand must be pkg/a's F")
	}
	var fh @ir.Instr = genExpr(ctx, b, hh)
	if fh == nil || fh.Op != iropcode.OP_FUNC_HANDLE || !irutil.Streq(fh.StrVal, "helper") {
		return fail("hh must be the handle of main's helper")
	}
	var fc @ir.Instr = genExpr(ctx, b, ce)
	if fc == nil || fc.Op != iropcode.OP_C_ENTRY || !irutil.Streq(fc.StrVal, "cb") {
		return fail("ce must be the C entry of main's cb")
	}
	var w @ast.Expr = fakeExpr(ast.EXPR_IDENT, "helper", 1)
	if !irutil.Streq(funcRefName(ctx, w), "pkg/a.helper") {
		return fail("an unrecorded helper must be the generic package's, by its spelling")
	}
	if len(funcRefTarget(ctx, w)) > 0 {
		return fail("an unrecorded helper must be the local, by its spelling")
	}
	if !irutil.Streq(builtinFuncOperand(ctx, w), "helper") {
		return fail("an unrecorded operand must be read by its spelling")
	}
	gc.PkgPath = buf.CopyStr("pkg/user")
	if !irutil.Streq(funcRefTarget(ctx, hv), "main.helper") ||
			!irutil.Streq(builtinFuncOperand(ctx, hh.Args[0]), "main.helper") {
		return fail("from pkg/user's module, helper must be main.helper")
	}
	return ""
}

// A package's member with a record is named by the package it is declared in,
// whatever the import's name is bound to in IR-gen; one with no record has no
// name to read.
func TestRecordedMemberName() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nimport \"pkg/a\"\nvar z int = a.V\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return fail(msg) }
	var z @ast.Expr = varInit(file, "z")
	if z == nil { return fail("the initializer must be found") }
	RebindImportPath(gc.Mod, "a", "pkg/b")
	var rn @[]char
	var have bool
	rn, have = recordedMemberName(gc, z)
	if !have || !irutil.Streq(rn, "pkg/a.V") { return fail("a.V must be pkg/a's V") }
	if !irutil.Streq(pkgMemberQualName(gc, z), "pkg/a.V") {
		return fail("a.V's name must be pkg/a.V")
	}
	var sel @ast.Expr = fakeExpr(ast.EXPR_SELECTOR, "V", 1)
	sel.X = fakeExpr(ast.EXPR_IDENT, "a", 0)
	_, have = recordedMemberName(gc, sel)
	if have { return fail("an unrecorded selector must have no record") }
	if !irutil.Streq(pkgMemberQualName(gc, sel), "pkg/b.V") {
		return fail("an unrecorded a.V must be read through the import")
	}
	return ""
}

// A method expression whose type the checker recorded names that type's method,
// called or taken as a value, whatever IR-gen's import-alias map makes of its
// spelling: locv.Add is P's Add, and no member of a package, though the map holds
// a package named locv (as it does for a single-segment path a forwarder
// exposes).  One with no record is still read by its spelling: a member of that
// package.
func TestMethodExprFromRecord() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes(
					"package \"main\"\ntype P struct { x int }\n"
							"func (p P) Add(a int, b int) int { return p.x + a + b }\n"
							"type locv = P\nvar g *func(P, int, int) int = locv.Add\n"
							"func f() int { return locv.Add(P{x: 1}, 2, 3) }\n"),
			"test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = mustCheck(file)
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	RecordImportPath(gc.Mod, "locv", "locv")
	var ctx @GenContext
	ctx, _ = scopeTestCtx()
	ctx.Gc = gc
	ctx.Checker = c
	var g @ast.Expr = varInit(file, "g")
	var call @ast.Expr = funcResult(file, "f")
	if g == nil || call == nil { return fail("the method expressions must be found") }
	if !irutil.Streq(funcRefTarget(ctx, g), "main.P.Add") ||
			!irutil.Streq(funcRefName(ctx, call.X), "main.P.Add") {
		return fail("locv.Add must be P's Add")
	}
	if !namesMethodExpr(ctx, g) || isMethodValueSelector(ctx, g) {
		return fail("locv.Add must be a method expression")
	}
	if len(pkgMemberQualName(gc, g)) > 0 { return fail("locv.Add must be no package's member") }
	var sel @ast.Expr = fakeExpr(ast.EXPR_SELECTOR, "Add", 1)
	sel.X = fakeExpr(ast.EXPR_IDENT, "locv", 0)
	if !irutil.Streq(funcRefName(ctx, sel), "locv.Add") || namesMethodExpr(ctx, sel) {
		return fail("an unrecorded locv.Add must be read by its spelling: the package's")
	}
	return ""
}
