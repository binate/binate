package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Generic-instantiation IR generation.  Monomorphizes each unique
// `f[T1, T2, ...]` call site to a specialized IR func with the
// type-params substituted for concrete @types.Type instances.
// Constraint-method dispatch inside the body is handled separately;
// this covers unconstrained `[T any]` generics where the body
// uses T purely as a value carrier.

// lookupGenericDeclFile returns the AST file a stashed generic decl was defined
// in (gc.GenericDeclFiles / GenericTypeDeclFiles / GenericIfaceDeclFiles,
// parallel to the matching decl registries — narrowed to the decl's own source
// file by declSourceFile when a merged file was stashed), or nil.  Used to
// resolve the generic body's package-qualified references against the defining
// file's imports at the instantiation site, not the consumer's alias map.
func lookupGenericDeclFile(gc @GenCtx, d @ast.Decl) @ast.File {
	for i := 0; i < len(gc.GenericDecls); i++ {
		if same(gc.GenericDecls[i], d) {
			return declSourceFile(gc, gc.GenericDeclFiles[i], d)
		}
	}
	for i := 0; i < len(gc.GenericTypeDecls); i++ {
		if same(gc.GenericTypeDecls[i], d) {
			return declSourceFile(gc, gc.GenericTypeDeclFiles[i], d)
		}
	}
	for i := 0; i < len(gc.GenericIfaceDecls); i++ {
		if same(gc.GenericIfaceDecls[i], d) {
			return declSourceFile(gc, gc.GenericIfaceDeclFiles[i], d)
		}
	}
	var none @ast.File
	return none
}

// ensureInstantiated emits the specialized IR func for `(d,
// args)` if it isn't already registered on m.  Returns the
// mangled name (which the call site uses as the call target).
//
// definingPkg is the full path of the package `d` was
// declared in (empty for a same-package generic).  The body is
// emitted into the CONSUMER's module but was written in the
// defining package's namespace: its references are read from the checker's
// records of its instance copy, which name what they resolved to in that
// package.
func ensureInstantiated(gc @GenCtx, d @ast.Decl, args @[]@types.Type, definingPkg @[]char) @[]char {
	args, _ = canonicalTypeArgs(gc, args)
	var name @[]char = instantiationMangledName(gc, d, definingPkg, args)
	if instantiationAlreadyEmitted(gc, name) {
		return name
	}
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, name)
	var src @ast.Decl = instanceCopy(gc, d, d, definingPkg, name)

	var sc instScope = beginInstFunc(gc, d, args)
	var synth @ast.Decl = instFuncDecl(src, name)
	// Register the FuncSig — keyed on the defining-package-qualified name, so
	// call sites resolve the instance like any top-level function — BEFORE the
	// body is generated: a call to the instance from its own body needs it (see
	// gen_generic_inst.bn).
	setOrAppendFuncSig(gc, instSig(gc, synth, d, name))
	var f @ir.Func = genFunc(gc, gc.Mod.Checker, synth)
	endInstScope(gc, sc)
	// genFunc qualifies the func's symbol by the CONSUMER module (gc.PkgPath);
	// override it with the defining-package-qualified `name` so two
	// same-final-segment packages' instantiations don't collide, and emit it
	// IsLinkOnce so every consumer's copy of one instantiation merges to a
	// single definition at link/VM time (the dtor/copy-helper pattern).
	f.Name = buf.CopyStr(name)
	f.IsLinkOnce = true
	gc.Mod.AddFunc(f)
	return name
}

// beginInstFunc installs the context the instance of generic function d for
// args resolves in (beginInstScope): its type parameters bound to args, under
// the imports of the file d was declared in.
func beginInstFunc(gc @GenCtx, d @ast.Decl, args @[]@types.Type) instScope {
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	newNames, newTypes = declTypeParamBinding(d, args)
	return beginInstScope(gc, newNames, newTypes, lookupGenericDeclFile(gc, d))
}

// registerInstFuncSig registers the FuncSig of instance name of generic function
// d for args, as ensureInstantiated does before it generates the body: a REPL
// redefinition registers every instance's new signature before it emits any of
// their bodies (reemitGenericFunc).
func registerInstFuncSig(gc @GenCtx, d @ast.Decl, args @[]@types.Type, definingPkg @[]char,
		name *[]readonly char) {
	var src @ast.Decl = instanceCopy(gc, d, d, definingPkg, name)
	var sc instScope = beginInstFunc(gc, d, args)
	setOrAppendFuncSig(gc, instSig(gc, instFuncDecl(src, name), d, name))
	endInstScope(gc, sc)
}

// instFuncDecl returns the declaration instance name of a generic function is
// generated from: the instance's checked copy src, named name (genFunc
// consumes the Decl's Name for the function's own), without its type
// parameters, which the IR layer does not need.
func instFuncDecl(src @ast.Decl, name *[]readonly char) @ast.Decl {
	var synth @ast.Decl = make(ast.Decl)
	synth.Kind = src.Kind
	synth.Pos = src.Pos
	synth.Name = stripCurrentModuleQualifier(name)
	synth.Recv = src.Recv
	synth.Params = src.Params
	synth.Results = src.Results
	synth.Body = src.Body
	synth.TypeRef = src.TypeRef
	synth.Value = src.Value
	synth.IsAlias = src.IsAlias
	return synth
}

// instantiationAlreadyEmitted reports whether `name` is already in
// the gc.EmittedInstantiations cache for the current module.
func instantiationAlreadyEmitted(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		if irutil.Streq(gc.EmittedInstantiations[i], name) { return true }
	}
	return false
}

// declTypeParamBinding returns the substitution context for instantiating the
// generic decl d with args: each declared type-parameter name paired with its
// argument (void where args runs short), for gc.CurrentTypeParamNames /
// CurrentTypeParamTypes.  A blank `_` parameter names nothing, so it is not
// bound — any number of parameters may be `_`.
func declTypeParamBinding(d @ast.Decl, args @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var names @[]@[]char
	var typs @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		if isBlank(d.TypeParams[i].Name) {
			continue
		}
		names = slices.Append[@[]char](names, d.TypeParams[i].Name)
		if i < len(args) {
			typs = slices.Append[@types.Type](typs, args[i])
		} else {
			typs = slices.Append[@types.Type](typs, types.TypVoid())
		}
	}
	return names, typs
}

// stripCurrentModuleQualifier removes the leading `<pkg>.`
// prefix that qualifyForCurrentModule prepends.  genFunc and
// downstream re-qualify, so the synthetic decl's Name must be
// the bare identifier piece.
func stripCurrentModuleQualifier(qual *[]readonly char) @[]char {
	for i := 0; i < len(qual); i++ {
		if qual[i] == '.' {
			return buf.CopyStr(qual[i + 1:])
		}
	}
	return buf.CopyStr(qual)
}

// typeArgExprToType converts a parsed-as-Expr type argument to the IR-layer
// @types.Type: the checker's record of the type e names, mapped (an abstract one
// is an internal error: requireConcreteRecord); with no record, IR-gen's own
// reading, through an ast.TypeExpr of the expression's shape (exprToTypeExpr) fed
// to resolveTypeExpr, noted under the type differential.  Accepts the forms the
// checker's typeArgFromExpr does: EXPR_IDENT, EXPR_SELECTOR (`pkg.T`),
// EXPR_UNARY(STAR, X), EXPR_TYPE and EXPR_INSTANTIATE.
func typeArgExprToType(gc @GenCtx, e @ast.Expr) @types.Type {
	if e == nil { return types.TypVoid() }
	var rec @types.Type = exprDenotedRecord(gc, e)
	if rec != nil {
		return typeFromRecord(gc, requireConcreteRecord(gc, rec, e.Pos, "a type argument"))
	}
	var te @ast.TypeExpr = exprToTypeExpr(e)
	if te == nil { return types.TypVoid() }
	var t @types.Type = resolveTypeExpr(gc, te)
	// A type argument parsed as a type is its TypeRef, noted by resolveTypeExpr.
	if e.Kind != ast.EXPR_TYPE { noteExprSyntaxReading(gc, e, t) }
	return t
}

// exprToTypeExpr synthesizes an ast.TypeExpr from an ast.Expr
// in the type-arg shape.  Returns nil for shapes the IR gen
// doesn't know how to interpret (the type checker has already
// rejected these; we mirror the same set).
func exprToTypeExpr(e @ast.Expr) @ast.TypeExpr {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_TYPE {
		// Parser already produced the TypeExpr (parseBracketTypeArg)
		// for `@T` / `@[]T` / `*[]T` forms; hand it straight through.
		return e.TypeRef
	}
	if e.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.Name = e.Name
		return te
	}
	// A bare package-qualified value type (`pkg.T`) as a type argument parses as
	// an EXPR_SELECTOR; synthesize a qualified TEXPR_NAMED (Pkg + Name), the same
	// shape the EXPR_INSTANTIATE arm below builds for a selector HEAD.  Without
	// this the type-arg falls through to nil -> void, so a monomorphized body
	// that spells `var z T` emits an `alloca void` (rejected by the LLVM backend);
	// mirrors the checker's typeArgFromExpr EXPR_SELECTOR arm.
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.Pkg = e.X.Name
		te.Name = e.Name
		return te
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @ast.TypeExpr = exprToTypeExpr(e.X)
		if inner == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_POINTER
		te.Pos = e.Pos
		te.Base = inner
		return te
	}
	// A generic instantiation as a type argument (`Wrap[int]`, `pkg.Wrap[int]`):
	// synthesize a TEXPR_INSTANTIATE whose Base is the head's named type and
	// whose TypeArgs are the recursively-converted args, so resolveTypeExpr's
	// TEXPR_INSTANTIATE arm builds the concrete instantiated type.  Without this
	// the shape falls through to nil, the type-arg resolves to void, and a
	// monomorphized method call on such a binding (`bucketOf[int, Wrap[int]]`
	// dispatching `p.Hash(k)`) gets a void receiver — an empty mangled name and
	// a void-typed parameter.  Mirrors the checker's typeArgFromExpr arm.
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX && e.X != nil {
		var base @ast.TypeExpr = nil
		if e.X.Kind == ast.EXPR_IDENT {
			base = make(ast.TypeExpr)
			base.Kind = ast.TEXPR_NAMED
			base.Pos = e.X.Pos
			base.Name = e.X.Name
		} else if e.X.Kind == ast.EXPR_SELECTOR && e.X.X != nil && e.X.X.Kind == ast.EXPR_IDENT {
			base = make(ast.TypeExpr)
			base.Kind = ast.TEXPR_NAMED
			base.Pos = e.X.Pos
			base.Pkg = e.X.X.Name
			base.Name = e.X.Name
		}
		if base == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_INSTANTIATE
		te.Pos = e.Pos
		te.Base = base
		for i := 0; i < len(e.Args); i++ {
			var at @ast.TypeExpr = exprToTypeExpr(e.Args[i])
			if at == nil { return nil }
			te.TypeArgs = slices.Append[@ast.TypeExpr](te.TypeArgs, at)
		}
		return te
	}
	return nil
}

// lookupGenericDecl returns the same-package generic AST decl
// registered under `name`, or nil if no such decl exists.
// Defaults to gc.PkgPath — for cross-package
// lookups, call lookupGenericDeclPkg explicitly.
func lookupGenericDecl(gc @GenCtx, name *[]readonly char) @ast.Decl {
	return lookupGenericDeclPkg(gc, gc.PkgPath, name)
}

// lookupGenericDeclPkg returns the generic AST decl registered
// under (pkg, name), or nil.  Imported generic decls land in the
// same registry but pkg disambiguates a local `Id[T]` from an
// imported `genlib.Id[T]`.  A generic function a REPL input shadowed
// is no longer found by its name (genericDeclShadowed).
func lookupGenericDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericDecls); i++ {
		if !irutil.Streq(gc.GenericDecls[i].Name, name) { continue }
		if i < len(gc.GenericDeclPkgs) && !irutil.CharEq(gc.GenericDeclPkgs[i], pkg) {
			continue
		}
		if genericDeclShadowed(gc, gc.GenericDecls[i]) { continue }
		return gc.GenericDecls[i]
	}
	return nil
}

// lookupGenericTypeDeclPkg is the pkg-aware variant.
func lookupGenericTypeDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericTypeDecls); i++ {
		if !irutil.Streq(gc.GenericTypeDecls[i].Name, name) { continue }
		if i < len(gc.GenericTypeDeclPkgs) && !irutil.CharEq(gc.GenericTypeDeclPkgs[i], pkg) {
			continue
		}
		return gc.GenericTypeDecls[i]
	}
	return nil
}

// lookupGenericIfaceDecl returns the same-package generic
// interface AST decl registered under `name`, or nil.
// The interface counterpart to lookupGenericTypeDeclPkg.
func lookupGenericIfaceDecl(gc @GenCtx, name *[]readonly char) @ast.Decl {
	return lookupGenericIfaceDeclPkg(gc, gc.PkgPath, name)
}

// lookupGenericIfaceDeclPkg is the pkg-aware variant.
func lookupGenericIfaceDeclPkg(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericIfaceDecls); i++ {
		if !irutil.Streq(gc.GenericIfaceDecls[i].Name, name) { continue }
		if i < len(gc.GenericIfaceDeclPkgs) && !irutil.CharEq(gc.GenericIfaceDeclPkgs[i], pkg) {
			continue
		}
		return gc.GenericIfaceDecls[i]
	}
	return nil
}

// genericFuncInstanceName resolves a generic-FUNCTION instantiation used as an
// rvalue func value (`Id[int]`, `pkg.Id[int]`) and returns the mangled name of
// the specialized instance, emitting that instance as a side effect
// (ensureInstantiated is idempotent).  Returns "" when `e` is not a generic-
// function instantiation — an ordinary index (`arr[i]`), a generic TYPE
// instantiation, or a bare name shadowed by a local var — so callers keep their
// normal path.  Resolves the head as the call-site generic dispatch in genCall
// does (instantiationHead), but yields a func VALUE rather than a direct call —
// the difference the func-value slots (var / `:=` / call-arg / return / field)
// need, since isFuncRefExpr rejects the instantiate shape.
func genericFuncInstanceName(ctx @GenContext, e @ast.Expr) @[]char {
	var empty @[]char
	if e == nil || e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || e.X == nil { return empty }
	var gd @ast.Decl
	var defPkg @[]char
	gd, defPkg = instantiationHead(ctx, e)
	if gd == nil { return empty }
	if ctx.Gc.Mod == nil { return empty }
	var args @[]@types.Type
	for i := 0; i < len(e.Args); i++ {
		args = slices.Append[@types.Type](args, typeArgExprToType(ctx.Gc, e.Args[i]))
	}
	return ensureInstantiated(ctx.Gc, gd, args, defPkg)
}

// instantiationHead returns the generic function an EXPR_INSTANTIATE_OR_INDEX
// head instantiates, with the package it is declared in (empty for one of the
// current package), or nil when head is not a generic-function instantiation —
// an ordinary index (`fns[i]`), a generic TYPE instantiation, or a name a value
// shadows.  The checker's record of head's name decides (recordedGenericHead):
// a checked head with no record of a generic function is none (checkedExpr); a
// head the checker never saw is read by its spelling (instantiationHeadByName),
// noted under the value differential.  Detection only: no instantiation is
// emitted here.
func instantiationHead(ctx @GenContext, head @ast.Expr) (@ast.Decl, @[]char) {
	var noPkg @[]char
	var none @ast.Decl
	if head == nil || head.X == nil { return none, noPkg }
	var gd @ast.Decl
	var defPkg @[]char
	var have bool
	gd, defPkg, have = recordedGenericHead(ctx.Gc, head.X)
	if have { return gd, defPkg }
	if checkedExpr(ctx.Gc, head) { return none, noPkg }
	gd, defPkg = instantiationHeadByName(ctx, head)
	if gd != nil { noteGenericUnrecorded(ctx.Gc, head, defPkg, gd.Name) }
	return gd, defPkg
}

// instantiationHeadByName is instantiationHead for a head whose name the checker
// recorded nothing for, by its spelling.  The checker's type of head decides
// first — an index yields a function VALUE, an instantiation a function; the
// scope is consulted where the checker recorded no type.  A bare `g[T]` resolves
// in the module's own package; a `pkg.G[T]` through the homed qualifier.
func instantiationHeadByName(ctx @GenContext, head @ast.Expr) (@ast.Decl, @[]char) {
	var noPkg @[]char
	var none @ast.Decl
	if head.ResolvedTypeID != 0 {
		var ht @types.Type = types.StripWrappers(ctx.Checker.ExprType(head.ResolvedTypeID))
		if ht != nil && (ht.Kind == types.TYP_FUNC_VALUE || ht.Kind == types.TYP_MANAGED_FUNC_VALUE) {
			return none, noPkg
		}
	}
	if head.X.Kind == ast.EXPR_IDENT {
		// A local/global var of the same name shadows the generic function (the
		// checker then reads `name[i]` as indexing, not instantiation), so treat
		// it as an instantiation only when no such var is in scope.
		if identValueBound(ctx, head.X) { return none, noPkg }
		return lookupGenericDecl(ctx.Gc, head.X.Name), noPkg
	}
	if head.X.Kind == ast.EXPR_SELECTOR && head.X.X != nil && head.X.X.Kind == ast.EXPR_IDENT {
		// A local variable that shadows the import alias makes `pkg.Id[i]` an
		// index of its field `Id`, even when a generic function of that package
		// shares the field's name.
		if selectorBaseIsVar(ctx, head.X) { return none, noPkg }
		// Cross-package `pkg.Id[...]`: resolve the source alias `pkg` to its full
		// path (generic decls stash under the full path, also when the call is
		// spelled through an `expose` forwarder) before the lookup.
		var genPkg @[]char = homedQualifier(ctx.Gc.Mod, head.X.X.Name, head.X.Name)
		var gd @ast.Decl = lookupGenericDeclPkg(ctx.Gc, genPkg, head.X.Name)
		if gd != nil { return gd, genPkg }
	}
	return none, noPkg
}

// genCallInstantiate handles the IR-gen for an EXPR_CALL whose
// callee is an EXPR_INSTANTIATE_OR_INDEX with a generic head
// (the type checker validated this; here we emit code).
// Steps: convert the bracketed exprs to concrete @types.Type,
// ensure the specialized IR func is emitted, then emit a regular
// call to the mangled name.  Returns the call's @Instr (the
// loaded return value if any).
//
// definingPkg is the full path of the package `d` was declared in (empty for
// a same-package generic), which keys and names the instance
// (ensureInstantiated); the monomorphized body reads its names from the
// records of the checker's copy.  The type ARGUMENTS are resolved here, at
// the consumer call site where they were written.
func genCallInstantiate(ctx @GenContext, b @ir.Block, e @ast.Expr, d @ast.Decl,
		definingPkg @[]char) @ir.Instr {
	var head @ast.Expr = e.X // EXPR_INSTANTIATE_OR_INDEX
	var args @[]@types.Type
	for i := 0; i < len(head.Args); i++ {
		args = slices.Append[@types.Type](args, typeArgExprToType(ctx.Gc, head.Args[i]))
	}
	if ctx.Gc.Mod == nil { return nil }
	var name @[]char = ensureInstantiated(ctx.Gc, d, args, definingPkg)
	// The user arguments, a trailing spread included (`f[int](s...)`), are
	// passed to the instance, called by its name.
	return genNamedCall(ctx, b, e, name)
}
