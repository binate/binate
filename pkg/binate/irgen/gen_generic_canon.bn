package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"

// An interface alias is the interface it names (`interface PA = P`), so a
// generic instantiated with a type argument spelled through one — `H[*PA]`,
// `Box[@PA]`, `f[[]*PA]` — is the instantiation with the aliased interface.
// Instances are identified by their mangled name, built from the type
// arguments, so the ensureInstantiated* entry points first resolve every
// interface a type argument names to the tail of its alias chain
// (canonicalTypeArgs).  Otherwise `H[*PA]` would be an interface of its own
// that nothing implements: an assertion to it misses, and a method call through
// a value of it goes through a nil vtable.  An alias of a generic instantiation
// still registered as a stub is completed first (completeIfaceAliasChain): the
// result must not depend on whether the type is resolved before or after the
// alias is collected, or one type would name two instances.

// canonicalTypeArgs is canonicalTypeArg over args, reporting whether any
// changed — args itself when none does.
func canonicalTypeArgs(gc @GenCtx, args @[]@types.Type) (@[]@types.Type, bool) {
	if gc.Mod == nil { return args, false }
	for i := 0; i < len(args); i++ { completeIfaceAliasStubsIn(gc, args[i]) }
	return ir.CanonicalIfaceTypes(gc.Mod, args)
}

// canonicalTypeArg returns t with every interface it names resolved to the tail
// of its alias chain (ir.CanonicalIfaceType), after completing any pending
// alias-of-instantiation stub on the way (completeIfaceAliasStubsIn).
func canonicalTypeArg(gc @GenCtx, t @types.Type) @types.Type {
	if gc.Mod == nil { return t }
	completeIfaceAliasStubsIn(gc, t)
	return ir.CanonicalIfaceType(gc.Mod, t)
}

// completeIfaceAliasStubsIn completes each pending alias-of-instantiation stub
// on the alias chain of every interface t names, in the structure
// ir.CanonicalIfaceType resolves (completeIfaceAliasChain).
func completeIfaceAliasStubsIn(gc @GenCtx, t @types.Type) {
	if t == nil { return }
	if t.Kind == types.TYP_INTERFACE {
		completeIfaceAliasChain(gc, t.Pkg, t.Name)
		return
	}
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(t.Params); i++ { completeIfaceAliasStubsIn(gc, t.Params[i].Type) }
		for i := 0; i < len(t.Results); i++ { completeIfaceAliasStubsIn(gc, t.Results[i]) }
		return
	}
	if t.Kind == types.TYP_STRUCT {
		if !irutil.IsAnonStructName(t.Name) { return }
		for i := 0; i < len(t.Fields); i++ { completeIfaceAliasStubsIn(gc, t.Fields[i].Type) }
		return
	}
	completeIfaceAliasStubsIn(gc, t.Elem)
}

// completeIfaceAliasChain completes each pending alias-of-instantiation stub on
// the alias chain from (pkg, name) (completeIfaceAliasStub), so the chain can be
// followed to its tail.
func completeIfaceAliasChain(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) {
	var curPkg @[]char = buf.CopyStr(pkg)
	var curName @[]char = buf.CopyStr(name)
	for hop := 0; hop < 32; hop++ {
		var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, curPkg, curName)
		if idx < 0 { return }
		if gc.Mod.Interfaces[idx].IsStub { completeIfaceAliasStub(gc, curPkg, curName) }
		var target @[]char = gc.Mod.Interfaces[idx].AliasTarget
		if len(target) == 0 { return }
		curPkg = gc.Mod.Interfaces[idx].AliasTargetPkg
		curName = target
	}
}
