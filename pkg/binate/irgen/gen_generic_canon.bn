package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"

// An interface alias is the interface it names (`interface PA = P`), so a
// generic instantiated with a type argument spelled through one — `H[*PA]`,
// `Box[@PA]`, `f[[]*PA]` — is the instantiation with the aliased interface.
// Instances are identified by their mangled name, built from the type
// arguments, so the ensureInstantiated* entry points first resolve every
// interface a type argument names to the tail of its alias chain
// (canonicalTypeArgs).  Otherwise `H[*PA]` would be an interface of its own
// that nothing implements: an assertion to it misses, and a method call through
// a value of it goes through a nil vtable.  An alias of a generic instantiation
// still registered as a stub is completed first (completeIfaceAliasChain): the
// result must not depend on whether the type is resolved before or after the
// alias is collected, or one type would name two instances.

// canonicalTypeArgs returns args with each interface they name resolved
// through its alias chain (canonicalTypeArg), and whether any changed — args
// itself when none does.
func canonicalTypeArgs(gc @GenCtx, args @[]@types.Type) (@[]@types.Type, bool) {
	var out @[]@types.Type
	var changed bool = false
	if gc.Mod == nil { return args, false }
	for i := 0; i < len(args); i++ {
		var c @types.Type = canonicalTypeArg(gc, args[i])
		if same(c, args[i]) { continue }
		if !changed {
			out = make_slice(@types.Type, len(args))
			for j := 0; j < len(args); j++ { out[j] = args[j] }
			changed = true
		}
		out[i] = c
	}
	if !changed { return args, false }
	return out, true
}

// canonicalTypeArg returns t with every interface it names — directly or under
// pointer, managed-pointer, slice, managed-slice, array, readonly,
// interface-value, function-type or anonymous-struct structure — replaced by
// the tail of its alias chain (ir.CanonicalIfacePkg / CanonicalIfaceName); t
// itself when none changes.  Named types, named structs included, are left as
// they are: their identity is their name.  An anonymous struct's is its field
// types (it is mangled structurally), so they are resolved too.
func canonicalTypeArg(gc @GenCtx, t @types.Type) @types.Type {
	if t == nil { return t }
	var m @ir.Module = gc.Mod
	if t.Kind == types.TYP_INTERFACE {
		completeIfaceAliasChain(gc, t.Pkg, t.Name)
		var pkg @[]char = ir.CanonicalIfacePkg(m, t.Pkg, t.Name)
		var name @[]char = ir.CanonicalIfaceName(m, t.Pkg, t.Name)
		if irutil.CharEq(pkg, t.Pkg) && irutil.CharEq(name, t.Name) { return t }
		return types.MakeInterfaceType(pkg, name)
	}
	if t.Kind == types.TYP_FUNC || t.Kind == types.TYP_FUNC_VALUE ||
			t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return canonicalFuncTypeArg(gc, t)
	}
	if t.Kind == types.TYP_STRUCT && irutil.IsAnonStructName(t.Name) {
		return canonicalAnonStructTypeArg(gc, t)
	}
	var elem @types.Type = canonicalTypeArg(gc, t.Elem)
	if same(elem, t.Elem) { return t }
	if t.Kind == types.TYP_INTERFACE_VALUE { return types.MakeInterfaceValueType(elem) }
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return types.MakeManagedInterfaceValueType(elem)
	}
	if t.Kind == types.TYP_POINTER { return types.MakePointerType(elem) }
	if t.Kind == types.TYP_MANAGED_PTR { return types.MakeManagedPtrType(elem) }
	if t.Kind == types.TYP_SLICE { return types.MakeSliceType(elem) }
	if t.Kind == types.TYP_MANAGED_SLICE { return types.MakeManagedSliceType(elem) }
	if t.Kind == types.TYP_READONLY { return types.MakeReadonlyType(elem) }
	if t.Kind == types.TYP_ARRAY && !t.ArrayLenDependent {
		return types.MakeArrayType(elem, t.ArrayLen)
	}
	return t
}

// canonicalFuncTypeArg is canonicalTypeArg for a function or function-value
// type: its parameter and result types, each parameter keeping its name and
// variadic flag.
func canonicalFuncTypeArg(gc @GenCtx, t @types.Type) @types.Type {
	var changed bool = false
	var params @[]@types.Param = make_slice(@types.Param, len(t.Params))
	for i := 0; i < len(t.Params); i++ {
		var p @types.Param = t.Params[i]
		var pt @types.Type = canonicalTypeArg(gc, p.Type)
		if same(pt, p.Type) {
			params[i] = p
			continue
		}
		changed = true
		var np @types.Param = make(types.Param)
		np.Name = p.Name
		np.Type = pt
		np.IsVariadic = p.IsVariadic
		params[i] = np
	}
	var results @[]@types.Type
	var resultsChanged bool
	results, resultsChanged = canonicalTypeArgs(gc, t.Results)
	if !changed && !resultsChanged { return t }
	if t.Kind == types.TYP_FUNC_VALUE { return types.MakeFuncValueType(params, results) }
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		return types.MakeManagedFuncValueType(params, results)
	}
	return types.MakeFuncType(params, results)
}

// canonicalAnonStructTypeArg is canonicalTypeArg for an anonymous struct: its
// field types, each field keeping its name, under the same struct name.
func canonicalAnonStructTypeArg(gc @GenCtx, t @types.Type) @types.Type {
	var changed bool = false
	var fields @[]@types.Field = make_slice(@types.Field, len(t.Fields))
	for i := 0; i < len(t.Fields); i++ {
		var f @types.Field = t.Fields[i]
		var ft @types.Type = canonicalTypeArg(gc, f.Type)
		if same(ft, f.Type) {
			fields[i] = f
			continue
		}
		changed = true
		var nf @types.Field = make(types.Field)
		nf.Name = f.Name
		nf.Type = ft
		fields[i] = nf
	}
	if !changed { return t }
	return types.MakeStructType(t.Name, fields)
}

// completeIfaceAliasChain completes each pending alias-of-instantiation stub on
// the alias chain from (pkg, name) (completeIfaceAliasStub), so the chain can be
// followed to its tail.
func completeIfaceAliasChain(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) {
	var curPkg @[]char = buf.CopyStr(pkg)
	var curName @[]char = buf.CopyStr(name)
	for hop := 0; hop < 32; hop++ {
		var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, curPkg, curName)
		if idx < 0 { return }
		if gc.Mod.Interfaces[idx].IsStub { completeIfaceAliasStub(gc, curPkg, curName) }
		var target @[]char = gc.Mod.Interfaces[idx].AliasTarget
		if len(target) == 0 { return }
		curPkg = gc.Mod.Interfaces[idx].AliasTargetPkg
		curName = target
	}
}
