package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// canonModule returns a module declaring `interface P` and its alias
// `interface PA = P`.
func canonModule() @ir.Module {
	return genFromSource(
			"package \"test\"\n"
					"interface P { Get() int }\n"
					"interface PA = P\n"
					"func main() { }\n")
}

// ifaceVal returns the raw interface-value type `*<name>` of package test.
func ifaceVal(name *[]readonly char) @types.Type {
	return types.MakeInterfaceValueType(types.MakeInterfaceType("test", buf.CopyStr(name)))
}

// An interface named through an alias resolves to the aliased interface,
// directly and nested under slice / interface-value structure.
func TestCanonicalTypeArgResolvesAlias() testing.TestResult {
	var gc @GenCtx = NewGenCtx(canonModule())
	var t @types.Type = canonicalTypeArg(gc, ifaceVal("PA"))
	if t.Kind != types.TYP_INTERFACE_VALUE || !charsEqualOpt(t.Elem.Name, "P") {
		return fail("*PA should resolve to *P")
	}
	var s @types.Type = canonicalTypeArg(gc, types.MakeManagedSliceType(ifaceVal("PA")))
	if s.Kind != types.TYP_MANAGED_SLICE || !charsEqualOpt(s.Elem.Elem.Name, "P") {
		return fail("@[]*PA should resolve to @[]*P")
	}
	return ""
}

// A function type's parameters (keeping name and variadic flag) and results
// resolve too.
func TestCanonicalTypeArgFuncType() testing.TestResult {
	var gc @GenCtx = NewGenCtx(canonModule())
	var p @types.Param = make(types.Param)
	p.Name = "xs"
	p.Type = types.MakeSliceType(ifaceVal("PA"))
	p.IsVariadic = true
	var params @[]@types.Param = make_slice(@types.Param, 1)
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = ifaceVal("PA")
	var f @types.Type = canonicalTypeArg(gc, types.MakeFuncValueType(params, results))
	if f.Kind != types.TYP_FUNC_VALUE { return fail("should stay a func value type") }
	if !charsEqualOpt(f.Params[0].Type.Elem.Elem.Name, "P") { return fail("param should resolve") }
	if !charsEqualOpt(f.Params[0].Name, "xs") || !f.Params[0].IsVariadic {
		return fail("param name and variadic flag should be kept")
	}
	if !charsEqualOpt(f.Results[0].Elem.Name, "P") { return fail("result should resolve") }
	return ""
}

// A type naming no alias comes back as the same object, and the argument list
// reports whether anything changed.
func TestCanonicalTypeArgsUnchanged() testing.TestResult {
	var gc @GenCtx = NewGenCtx(canonModule())
	var direct @types.Type = ifaceVal("P")
	if !same(canonicalTypeArg(gc, direct), direct) { return fail("*P should come back unchanged") }
	var args @[]@types.Type = make_slice(@types.Type, 2)
	args[0] = types.TypInt()
	args[1] = direct
	var changed bool
	_, changed = canonicalTypeArgs(gc, args)
	if changed { return fail("[int, *P] should not change") }
	args[1] = ifaceVal("PA")
	var out @[]@types.Type
	out, changed = canonicalTypeArgs(gc, args)
	if !changed || !charsEqualOpt(out[1].Elem.Name, "P") || !same(out[0], args[0]) {
		return fail("[int, *PA] should become [int, *P]")
	}
	return ""
}

// An anonymous struct's field types resolve too (it is mangled structurally),
// under the same struct name.
func TestCanonicalTypeArgAnonStruct() testing.TestResult {
	var gc @GenCtx = NewGenCtx(canonModule())
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f @types.Field = make(types.Field)
	f.Name = "p"
	f.Type = ifaceVal("PA")
	fields[0] = f
	var st @types.Type = types.MakeStructType("__anon_7", fields)
	var c @types.Type = canonicalTypeArg(gc, st)
	if c.Kind != types.TYP_STRUCT || !charsEqualOpt(c.Name, "__anon_7") {
		return fail("should stay the same anonymous struct")
	}
	if !charsEqualOpt(c.Fields[0].Name, "p") || !charsEqualOpt(c.Fields[0].Type.Elem.Name, "P") {
		return fail("field p should resolve to *P")
	}
	return ""
}

// An alias of a generic instantiation still registered only as a stub is
// completed when a type argument names it, so the argument resolves to the
// instance whether it is resolved before or after the alias is collected.
func TestCanonicalTypeArgCompletesAliasStub() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"interface X = G[int]\n"
					"interface G[T any] { Get() T }\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	stashGenericIfaceDecls(gc, file, "pkg/home")
	registerIfaceStubs(gc, file, "pkg/home")
	var xi int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "X")
	if xi < 0 || !gc.Mod.Interfaces[xi].IsStub { return fail("X should start as a stub") }
	var x @types.Type = types.MakeInterfaceValueType(types.MakeInterfaceType("pkg/home", "X"))
	var c @types.Type = canonicalTypeArg(gc, x)
	if gc.Mod.Interfaces[xi].IsStub { return fail("X should be completed") }
	if charsEqualOpt(c.Elem.Name, "X") || len(c.Elem.Name) == 0 {
		return fail("*X should resolve to the G[int] instance")
	}
	if !charsEqualOpt(c.Elem.Name, gc.Mod.Interfaces[xi].AliasTarget) {
		return fail("*X should resolve to X's target")
	}
	return ""
}
