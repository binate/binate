package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/std/cmp"
import "pkg/std/hash"

impl DeclHasher : hash.Hasher[@ast.Decl]

impl DeclEq : cmp.Eq[@ast.Decl]

// An instance of a generic is emitted from the checker's checked copy of its
// declaration (check.InstanceBody, gen.mono.check): the copy was checked with
// the type arguments bound, so its annotations — expression types, constants,
// array lengths, a function literal's type — are the instance's, where the
// shared declaration's are those of the abstract body.  The checker names an
// instance by its own types and IR-gen by the mangled name of its own, so a
// copy is matched by mapping its type arguments into IR-gen's types
// (irTypesFromChecker) and comparing the names.  With no checker (IR-gen's unit
// tests) the shared declaration is emitted.

// instanceCopy returns the declaration to emit the instance of the generic
// function or generic-type method d from: the checker's copy whose type
// arguments name the instance keyName of keyDecl (d itself, or a method's
// generic type) in definingPkg.  A checked program with no such copy is an
// internal error: the checker did not check an instance IR-gen emits.
func instanceCopy(gc @GenCtx, d @ast.Decl, keyDecl @ast.Decl, definingPkg @[]char,
		keyName *[]readonly char) @ast.Decl {
	if gc.Mod == nil || gc.Mod.Checker == nil {
		return d
	}
	var src @ast.Decl = matchInstanceCopy(gc, gc.Mod.Checker.InstanceBodies(d), keyDecl, definingPkg,
			keyName)
	if src == nil {
		panic(buf.Concat("internal error: no checked copy of generic instance ", keyName))
	}
	return src
}

// typeInstanceCopy returns the declaration to resolve the members of the
// instance keyName of the generic struct or interface d from: the copy the
// checker resolved them from.  With no checker it is d.
func typeInstanceCopy(gc @GenCtx, d @ast.Decl, definingPkg @[]char,
		keyName *[]readonly char) @ast.Decl {
	if gc.Mod == nil || gc.Mod.Checker == nil {
		return d
	}
	var src @ast.Decl = matchInstanceCopy(gc, gc.Mod.Checker.TypeInstanceClones(d), d, definingPkg,
			keyName)
	if src == nil {
		panic(buf.Concat("internal error: no checked copy of generic type instance ", keyName))
	}
	return src
}

// matchInstanceCopy returns the copy among bodies whose type arguments, in
// IR-gen's types, give keyDecl the instance name keyName; nil when none does.
// A copy's name is computed once per module (GenCtx.InstanceCopyNames).
func matchInstanceCopy(gc @GenCtx, bodies *[]@check.InstanceBody, keyDecl @ast.Decl,
		definingPkg @[]char, keyName *[]readonly char) @ast.Decl {
	for i := 0; i < len(bodies); i++ {
		var name @[]char
		var have bool
		name, have = gc.InstanceCopyNames.Get(bodies[i].Clone)
		if !have {
			name = instanceCopyName(gc, bodies[i], keyDecl, definingPkg)
			gc.InstanceCopyNames.Put(bodies[i].Clone, name)
		}
		if irutil.Streq(name, keyName) {
			return bodies[i].Clone
		}
	}
	return nil
}

// instanceCopyName returns the name of the instance of keyDecl in definingPkg
// whose checked copy is body: its type arguments named in IR-gen's types
// without looking anything up or registering it (GenCtx.NamingInstances);
// empty when one has no IR-gen type.
func instanceCopyName(gc @GenCtx, body @check.InstanceBody, keyDecl @ast.Decl,
		definingPkg @[]char) @[]char {
	var savedNaming bool = gc.NamingInstances
	gc.NamingInstances = true
	var args @[]@types.Type
	var ok bool
	args, ok = irTypesFromChecker(gc, body.Args)
	var name @[]char
	if ok {
		args, _ = canonicalTypeArgs(gc, args)
		name = instantiationMangledName(gc, keyDecl, definingPkg, args)
	}
	gc.NamingInstances = savedNaming
	return name
}

// DeclHasher.Hash hashes a declaration's address.
func (h DeclHasher) Hash(k @ast.Decl) uint {
	var p uint = bit_cast(uint, bit_cast(*uint8, k))
	return p ^ (p >> 7)
}

// DeclEq.Equal reports whether a and b are the same declaration.
func (e DeclEq) Equal(a @ast.Decl, b @ast.Decl) bool {
	return same(a, b)
}
