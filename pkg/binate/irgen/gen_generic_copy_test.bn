package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// copyArrayLens returns the lengths of the array allocas in the functions of m
// whose name contains sub.
func copyArrayLens(m @ir.Module, sub *[]readonly char) @[]int {
	var out @[]int
	for i := 0; i < len(m.Funcs); i++ {
		if !containsSub(m.Funcs[i].Name, sub) { continue }
		for b := 0; b < len(m.Funcs[i].Blocks); b++ {
			var blk @ir.Block = m.Funcs[i].Blocks[b]
			for j := 0; j < len(blk.Instrs); j++ {
				var ins @ir.Instr = blk.Instrs[j]
				if ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil && ins.TypeArg.Kind == types.TYP_ARRAY {
					var grown @[]int = make_slice(int, len(out) + 1)
					for k := 0; k < len(out); k++ { grown[k] = out[k] }
					grown[len(out)] = ins.TypeArg.ArrayLen
					out = grown
				}
			}
		}
	}
	return out
}

// Each instance of a generic function is emitted from its own checked copy, so
// a length that depends on the type parameter is the instance's.  (IR-gen does
// not evaluate such a length itself: emitted from the generic's own
// declaration, the instance would hit an internal error.)
func TestGenericFuncInstanceFromCheckedCopy() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"func g[T any]() int { var a [sizeof(T)]uint8; return len(a) }\n"
					"func main() { var x int = g[int16]() + g[int64](); _ = x }\n")
	var lens @[]int = copyArrayLens(m, "g__bn_inst")
	if len(lens) != 2 { return "expected one array alloca in each of two instances" }
	if !(lens[0] == 2 && lens[1] == 8) && !(lens[0] == 8 && lens[1] == 2) {
		return "expected the instances' lengths 2 and 8"
	}
	return ""
}

// So is each method of a generic type's instance.  (Emitted from the method's
// own declaration it would hit the same internal error.)
func TestGenericMethodInstanceFromCheckedCopy() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"type Box[T any] struct { v T }\n"
					"func (b @Box[T]) Size() int { var a [sizeof(T) * 2]uint8; return len(a) }\n"
					"func main() { var b @Box[int32] = make(Box[int32]); var x int = b.Size(); _ = x }\n")
	var lens @[]int = copyArrayLens(m, "Size")
	if len(lens) != 1 || lens[0] != 8 { return "expected the instance's length 8" }
	return ""
}

// Without a checker (IR-gen's unit tests) an instance is emitted from the
// generic's own declaration.
func TestInstanceCopyNoChecker() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var d @ast.Decl = make(ast.Decl)
	var key @[]char
	if !same(instanceCopy(gc, d, d, key, "x"), d) { return "expected the declaration itself" }
	if !same(typeInstanceCopy(gc, d, key, "x"), d) { return "expected the declaration itself" }
	return ""
}

// ifaceValueOperands returns the opcodes of the data operands of the interface
// values built in the functions of m whose name contains sub.
func ifaceValueOperands(m @ir.Module, sub *[]readonly char) @[]int {
	var out @[]int
	for i := 0; i < len(m.Funcs); i++ {
		if !containsSub(m.Funcs[i].Name, sub) { continue }
		for b := 0; b < len(m.Funcs[i].Blocks); b++ {
			var blk @ir.Block = m.Funcs[i].Blocks[b]
			for j := 0; j < len(blk.Instrs); j++ {
				var ins @ir.Instr = blk.Instrs[j]
				if ins.Op == iropcode.OP_IFACE_VALUE && len(ins.Args) > 0 && ins.Args[0] != nil {
					var grown @[]int = make_slice(int, len(out) + 1)
					for k := 0; k < len(out); k++ { grown[k] = out[k] }
					grown[len(out)] = ins.Args[0].Op
					out = grown
				}
			}
		}
	}
	return out
}

// An instance reads its expressions' types from its checked copy, where a
// type parameter is bound: bound to a pointer, `var a *any = x` boxes the
// pointer x holds (a load of x), as it does outside a generic, not the
// address of x's slot (which the abstract `T`, a value type to the
// generic's own check, would borrow).
func TestGenericInstanceTypesFromCheckedCopy() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"type W struct { n int }\n"
					"func boxIt[T any](x T) int { var a *any = x; _ = a; return 0 }\n"
					"func main() { var w W; var n int = boxIt[*W](&w); _ = n }\n")
	var ops @[]int = ifaceValueOperands(m, "boxIt__bn_inst")
	if len(ops) != 1 { return "expected one interface value built in boxIt[*W]" }
	if ops[0] != iropcode.OP_LOAD { return "expected the pointer x holds boxed, not x's slot" }
	return ""
}
