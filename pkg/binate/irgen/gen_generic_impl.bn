package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Parameterized impls (`impl *Box[T] : GJ[T]`, whose receiver is a generic
// type): impl collection cannot key them — the receiver has no name until
// instantiated — so they are stashed here, and a concrete instantiation's rows
// ((Box[int], GJ[int]) + ancestors) are minted when a value of it is boxed.

// stashGenericImplDecl records a parameterized impl decl with its declaring
// package path and file (whose imports its interface refs resolve against).
// The same decl can be reached by more than one registration pass; it is
// recorded once.
func stashGenericImplDecl(gc @GenCtx, d @ast.Decl, pkg *[]readonly char, file @ast.File) {
	for i := 0; i < len(gc.GenericImplDecls); i++ {
		if same(gc.GenericImplDecls[i], d) { return }
	}
	gc.GenericImplDecls = slices.Append[@ast.Decl](gc.GenericImplDecls, d)
	gc.GenericImplDeclPkgs = slices.Append[@[]char](gc.GenericImplDeclPkgs, buf.CopyStr(pkg))
	gc.GenericImplDeclFiles = slices.Append[@ast.File](gc.GenericImplDeclFiles, file)
	var none @[]@[]char
	gc.GenericImplMinted = slices.Append[@[]@[]char](gc.GenericImplMinted, none)
}

// noteGenericImplDecl stashes d when it is a parameterized impl; the impl
// collectors skip such decls.
func noteGenericImplDecl(gc @GenCtx, d @ast.Decl, pkg *[]readonly char, file @ast.File) {
	if d.Kind == ast.DECL_IMPL && receiverGenericInstBase(d.TypeRef) != nil {
		stashGenericImplDecl(gc, d, pkg, file)
	}
}

// ensureGenericImplRows mints the (instantiation, interface) rows — and their
// ancestors' — of every parameterized impl of the generic type that the struct
// instantiation instName (`Box__bn_inst__…`) instantiates, for its type
// arguments.  Called when a value of the instantiation is boxed into ANY
// interface value: from then on its dynamic type can be asserted or
// type-switched to any interface it implements, and the runtime satisfaction
// lookup finds only rows that were minted (a value boxed into `any` and asserted
// to `*GJ[int]` would otherwise miss).  A no-op for a non-instantiation.
func ensureGenericImplRows(gc @GenCtx, instName *[]readonly char, recvTyp @types.Type) {
	var si int = lookupStructIdx(gc, instName)
	if si < 0 { return }
	var ms irsym.ModuleStruct = gc.Mod.Structs[si]
	if !ms.IsInstantiation || ms.InstDecl == nil { return }
	var defPkg @[]char = ms.InstDefPkg
	if len(defPkg) == 0 { defPkg = buf.CopyStr(gc.PkgPath) }
	var recvPkg @[]char
	var recvName @[]char
	recvPkg, recvName = irutil.SplitQualName(instName)
	if len(recvPkg) == 0 { recvPkg = buf.CopyStr(gc.PkgPath) }
	for i := 0; i < len(gc.GenericImplDecls); i++ {
		if !irutil.Streq(gc.GenericImplDeclPkgs[i], defPkg) { continue }
		var d @ast.Decl = gc.GenericImplDecls[i]
		var recvInst @ast.TypeExpr = receiverGenericInstBase(d.TypeRef)
		if recvInst == nil || recvInst.Base == nil { continue }
		if !irutil.Streq(recvInst.Base.Name, ms.InstDecl.Name) { continue }
		if genericImplMinted(gc, i, instName) { continue }
		gc.GenericImplMinted[i] = slices.Append[@[]char](gc.GenericImplMinted[i], buf.CopyStr(instName))
		mintGenericImplRows(gc, d, recvInst, ms.InstArgs, defPkg, gc.GenericImplDeclFiles[i], recvPkg,
				recvName, recvTyp)
	}
}

// genericImplMinted reports whether stashed impl i's rows for the struct
// instantiation instName were already minted into gc.Mod.
func genericImplMinted(gc @GenCtx, i int, instName *[]readonly char) bool {
	var done @[]@[]char = gc.GenericImplMinted[i]
	for j := 0; j < len(done); j++ {
		if irutil.Streq(done[j], instName) { return true }
	}
	return false
}

// mintGenericImplRows resolves one parameterized impl's interface refs for the
// instantiation args — with the receiver binders (`Box[U]`'s U) bound to args —
// under the impl's own file imports and package, and registers each
// (instantiation, interface) row via ensureGenericImplInfo.  Only the binders
// are bound: the checker requires one plain binder per type parameter, so they
// cover every position, and binding the struct's own parameter names too would
// shadow a same-named package type in an interface arg (`impl *Box[U] : GI[K]`
// with `type Box[K any]` and a package type K).
func mintGenericImplRows(gc @GenCtx, d @ast.Decl, recvInst @ast.TypeExpr, args @[]@types.Type,
		implPkg @[]char, file @ast.File, recvPkg @[]char, recvName @[]char, recvTyp @types.Type) {
	var savedNames @[]@[]char = gc.CurrentTypeParamNames
	var savedTypes @[]@types.Type = gc.CurrentTypeParamTypes
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	for i := 0; i < len(recvInst.TypeArgs) && i < len(args); i++ {
		var binder @ast.TypeExpr = recvInst.TypeArgs[i]
		if binder != nil && binder.Kind == ast.TEXPR_NAMED {
			newNames = slices.Append[@[]char](newNames, ast.ReceiverBinderName(binder, i))
			newTypes = slices.Append[@types.Type](newTypes, args[i])
		}
	}
	gc.CurrentTypeParamNames = newNames
	gc.CurrentTypeParamTypes = newTypes
	var savedImportPkg @[]char = gc.Mod.CurrentImportPkg
	var aliasSnap AliasMapSnapshot = SaveAliasMapState(gc.Mod)
	if file != nil {
		overlayFileImports(gc.Mod, aliasSnap, file)
	}
	gc.Mod.CurrentImportPkg = definingPkgFor(gc, implPkg)
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var ifacePkg @[]char
		var ifaceName @[]char
		if ref.Kind == ast.TEXPR_NAMED {
			if len(ref.Pkg) > 0 {
				ifacePkg = homedQualifier(gc.Mod, ref.Pkg, ref.Name)
			} else {
				ifacePkg = buf.CopyStr(implPkg)
			}
			ifaceName = buf.CopyStr(ref.Name)
		} else if ref.Kind == ast.TEXPR_INSTANTIATE && ref.Base != nil &&
				ref.Base.Kind == ast.TEXPR_NAMED {
			if len(ref.Base.Pkg) > 0 {
				ifacePkg = homedQualifier(gc.Mod, ref.Base.Pkg, ref.Base.Name)
			} else {
				ifacePkg = buf.CopyStr(implPkg)
			}
			var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc, ifacePkg, ref.Base.Name)
			if gd == nil { continue }
			var argTypes @[]@types.Type
			for ai := 0; ai < len(ref.TypeArgs); ai++ {
				argTypes = slices.Append[@types.Type](argTypes, resolveTypeExpr(gc, ref.TypeArgs[ai]))
			}
			ifaceName = ensureInstantiatedInterface(gc, gd, argTypes, ifacePkg)
		} else {
			continue
		}
		ensureGenericImplInfo(gc.Mod, recvPkg, recvName, ifacePkg, ifaceName, recvTyp)
	}
	RestoreAliasMapState(gc.Mod, aliasSnap)
	gc.Mod.CurrentImportPkg = savedImportPkg
	gc.CurrentTypeParamNames = savedNames
	gc.CurrentTypeParamTypes = savedTypes
}
