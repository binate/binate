package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// parseImplDecls parses src as an interface file.
func parseImplDecls(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "impls.bni")
	return mustParse(p)
}

// noteGenericImplDecl stashes only a PARAMETERIZED impl (generic receiver), and
// a decl reached twice is recorded once.
func TestNoteGenericImplDeclStashesParameterizedOnce() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"type Box[T any] struct { v T }\n"
					"interface GI[T any] { Get() T }\n"
					"type S struct { n int }\n"
					"interface I { Get() int }\n"
					"impl *Box[T] : GI[T]\n"
					"impl *S : I\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	for i := 0; i < len(file.Decls); i++ {
		noteGenericImplDecl(gc, file.Decls[i], "pkg/home", file)
	}
	if len(gc.GenericImplDecls) != 1 { return fail("expected exactly the one parameterized impl") }
	for i := 0; i < len(file.Decls); i++ {
		noteGenericImplDecl(gc, file.Decls[i], "pkg/home", file)
	}
	if len(gc.GenericImplDecls) != 1 { return fail("a decl noted again must not be recorded twice") }
	if !charsEqual(gc.GenericImplDeclPkgs[0], "pkg/home") { return fail("expected pkg/home") }
	if len(gc.GenericImplMinted) != 1 || len(gc.GenericImplMinted[0]) != 0 {
		return fail("expected one empty minted list, parallel to the stash")
	}
	return ""
}

// ensureGenericImplRows mints nothing for a name that is not a struct
// instantiation.
func TestEnsureGenericImplRowsNonInstantiationNoop() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	ensureGenericImplRows(gc, "test.S", nil)
	if len(m.Impls) != 0 { return fail("no rows expected for a non-instantiation") }
	return ""
}

// A named non-struct generic instance boxed into `any` alone gets the rows of its
// generic's parameterized impls, as a struct instance does: its dynamic type
// asserts to the impls' interfaces only through them.
func TestEnsureGenericImplRowsNamedInstance() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(
			"package \"test\"\n"
					"interface Sz { sz() int }\n"
					"type N[U any] [4]U\n"
					"func (w *N[U]) sz() int { return 30 }\n"
					"impl *N[U] : Sz\n"
					"func put(w *N[int16]) *any { return w }\n")
	for i := 0; i < len(m.Impls); i++ {
		var row @irdata.ImplInfo = m.Impls[i]
		if row != nil && nameIsGenericInst(row.RecvTypeName) && charsEqual(row.IfaceName, "Sz") {
			return ""
		}
	}
	return fail("a N[int16] boxed into any should get the (N[int16], Sz) row")
}

// A parameterized impl that lists the universe `any` adds no row for it: a N[int16]
// boxed into `any` gets its (N[int16], Sz) row, and no row names an `any` of the
// package's own (the universe's is the box's own target).
func TestGenericImplOfUniverseAnyMakesNoRow() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(
			"package \"test\"\n"
					"interface Sz { sz() int }\n"
					"type N[U any] [4]U\n"
					"func (w *N[U]) sz() int { return 30 }\n"
					"impl *N[U] : any\n"
					"impl *N[U] : Sz\n"
					"func put(w *N[int16]) *any { return w }\n")
	var sized bool
	for i := 0; i < len(m.Impls); i++ {
		var row @irdata.ImplInfo = m.Impls[i]
		if row == nil || !nameIsGenericInst(row.RecvTypeName) { continue }
		if charsEqual(row.IfaceName, "any") && len(row.IfacePkg) > 0 {
			return fail(buf.Concat("a row for an any of ", row.IfacePkg))
		}
		if charsEqual(row.IfaceName, "Sz") { sized = true }
	}
	if !sized { return fail("a N[int16] boxed into any should get the (N[int16], Sz) row") }
	return ""
}

// A parameterized impl's interface keys on what the checker resolved it to in its
// checked copy for the instance: with the copy's written interface renamed between
// the check and IR-gen, a Box[int] boxed into `any` still gets its (Box[int], I) row.
func TestGenericImplIfaceKeyIsTheCheckers() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes(
					"package \"test\"\n"
							"interface I { M() int }\n"
							"type Box[T any] struct { v T }\n"
							"func (b *Box[T]) M() int { return 1 }\n"
							"impl *Box[U] : I\n"
							"func put(b *Box[int]) *any { return b }\n"), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = mustCheck(file)
	var implDecl @ast.Decl
	for i := 0; i < len(file.Decls); i++ {
		if file.Decls[i].Kind == ast.DECL_IMPL { implDecl = file.Decls[i] }
	}
	var bodies @[]@check.InstanceBody = c.InstanceBodies(implDecl)
	if len(bodies) == 0 { return fail("the checker kept no copy of the impl for Box[int]") }
	for i := 0; i < len(bodies); i++ {
		bodies[i].Clone.Interfaces[0].Name = buf.CopyStr("Z")
	}
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	var keyed bool
	for i := 0; i < len(gc.Mod.Impls); i++ {
		var row @irdata.ImplInfo = gc.Mod.Impls[i]
		if row == nil || !nameIsGenericInst(row.RecvTypeName) { continue }
		if charsEqual(row.IfaceName, "Z") { return fail("the row keys on the copy's written name") }
		if charsEqual(row.IfaceName, "I") { keyed = true }
	}
	if !keyed { return fail("a Box[int] boxed into any should get the (Box[int], I) row") }
	return ""
}
