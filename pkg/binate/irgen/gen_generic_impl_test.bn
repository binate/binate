package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// parseImplDecls parses src as an interface file.
func parseImplDecls(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "impls.bni")
	return p.ParseFile()
}

// noteGenericImplDecl stashes only a PARAMETERIZED impl (generic receiver), and
// a decl reached twice is recorded once.
func TestNoteGenericImplDeclStashesParameterizedOnce() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"type Box[T any] struct { v T }\n"
					"interface GI[T any] { Get() T }\n"
					"type S struct { n int }\n"
					"interface I { Get() int }\n"
					"impl *Box[T] : GI[T]\n"
					"impl *S : I\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	for i := 0; i < len(file.Decls); i++ {
		noteGenericImplDecl(gc, file.Decls[i], "pkg/home", file)
	}
	if len(gc.GenericImplDecls) != 1 { return fail("expected exactly the one parameterized impl") }
	for i := 0; i < len(file.Decls); i++ {
		noteGenericImplDecl(gc, file.Decls[i], "pkg/home", file)
	}
	if len(gc.GenericImplDecls) != 1 { return fail("a decl noted again must not be recorded twice") }
	if !charsEqual(gc.GenericImplDeclPkgs[0], "pkg/home") { return fail("expected pkg/home") }
	if len(gc.GenericImplMinted) != 1 || len(gc.GenericImplMinted[0]) != 0 {
		return fail("expected one empty minted list, parallel to the stash")
	}
	return ""
}

// ensureGenericImplRows mints nothing for a name that is not a struct
// instantiation.
func TestEnsureGenericImplRowsNonInstantiationNoop() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	ensureGenericImplRows(gc, "test.S", nil)
	if len(m.Impls) != 0 { return fail("no rows expected for a non-instantiation") }
	return ""
}
