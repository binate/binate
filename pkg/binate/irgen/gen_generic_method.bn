package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// IR generation for methods on generic types (`gen.method.generic-recv`) and
// parameterized-receiver impls (`gen.impl.generic-recv`).  A method whose
// receiver names a generic-type instantiation — `func (it *Cursor[T]) Next()
// (T, bool)` — carries its type parameters in the RECEIVER, not in the decl's
// own TypeParams (which stay empty).  So the declaration-time concrete-method
// passes (gen_module's signature/body passes, gen_register_import) — which key
// their generic skip off `len(d.TypeParams) > 0` — do NOT skip these methods;
// left alone they would resolve the receiver with `T` unbound (an internal
// error) and mint a malformed `<pkg>..<Method>` name.  The passes must recognize such
// methods by their receiver shape and skip them; the bodies are emitted per
// instantiation instead (mirroring ensureInstantiated for generic functions).

// receiverGenericInstBase peels the pointer/managed/const/paren wrappers off a
// method-receiver TypeExpr and returns the base TEXPR_INSTANTIATE node when the
// receiver names a generic-type instantiation (`*Cursor[T]`), or nil otherwise.
// Mirrors the checker's receiverBaseInstantiation.
func receiverGenericInstBase(te @ast.TypeExpr) @ast.TypeExpr {
	var base @ast.TypeExpr = te
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER || base.Kind == ast.TEXPR_MANAGED ||
				base.Kind == ast.TEXPR_CONST || base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	if base != nil && base.Kind == ast.TEXPR_INSTANTIATE {
		return base
	}
	return nil
}

// isGenericReceiverMethod reports whether decl d is a method whose receiver is a
// generic-type instantiation (`func (it *Cursor[T]) ...`).  These are skipped by
// the declaration-time concrete-method passes and emitted per instantiation.
func isGenericReceiverMethod(d @ast.Decl) bool {
	return d.Recv != nil && receiverGenericInstBase(d.Recv.Type) != nil
}

// genericMethodRecvName returns the generic base type name of a generic-receiver
// method (`func (it *Cursor[T]) ...` → "Cursor"), used to match a method against
// the struct instantiation whose methods are being emitted.  Empty if d is not a
// generic-receiver method.
func genericMethodRecvName(d @ast.Decl) @[]char {
	var inst @ast.TypeExpr = receiverGenericInstBase(d.Recv.Type)
	if inst == nil || inst.Base == nil {
		var empty @[]char
		return empty
	}
	return inst.Base.Name
}

// stashGenericMethodDecl records a generic-receiver method decl (with its
// defining package and file) for later per-instantiation emission.
func stashGenericMethodDecl(gc @GenCtx, d @ast.Decl, pkg *[]readonly char, file @ast.File) {
	gc.GenericMethodDecls = slices.Append[@ast.Decl](gc.GenericMethodDecls, d)
	gc.GenericMethodDeclPkgs = slices.Append[@[]char](gc.GenericMethodDeclPkgs, buf.CopyStr(pkg))
	gc.GenericMethodDeclFiles = slices.Append[@ast.File](gc.GenericMethodDeclFiles, file)
}

// privateToImport reports whether the generic-receiver method or parameterized
// impl d of the package path, other than the one being generated, is private to
// that package's .bn: the package has a .bni -- file, its declarations, holds one
// parsed from it -- and d is not declared there.  An importer reads only the
// .bni (pkg.export), and the checker checks such a member only for the instances
// the package's own code names, so an importer neither emits such a method for
// its instances nor mints such an impl's rows (mintPrivateImplRows).
func privateToImport(gc @GenCtx, path *[]readonly char, file @ast.File, d @ast.Decl) bool {
	if declaredInBni(d) || irutil.Streq(path, gc.PkgPath) { return false }
	return fileHasBni(file)
}

// fileHasBni reports whether file, a package's declarations, holds one parsed
// from the package's .bni.
func fileHasBni(file @ast.File) bool {
	for i := 0; i < len(file.Decls); i++ {
		if declaredInBni(file.Decls[i]) { return true }
	}
	return false
}

// declaredInBni reports whether d was parsed from a .bni -- a member of a type
// group too, which the loader does not mark FromBNI.
func declaredInBni(d @ast.Decl) bool {
	var f @[]char = d.Pos.File
	return len(f) >= 4 && irutil.Streq(f[len(f) - 4:], ".bni")
}

// joinMethodName builds the IR-level qualified method name for an instantiation:
// `<struct-inst-name>.<method>` (e.g. `main.Box__bn_inst__int.Get`).  This is
// exactly the key the direct-call site derives (baseNamedTypeName of the
// instantiated receiver + "." + method), so the emitted body and the call agree.
func joinMethodName(structInstName @[]char, methodName @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(structInstName)
	cb.Write(".")
	cb.Write(methodName)
	return buf.CopyStr(cb.String())
}

// ensureMethodsForInstName emits the generic-receiver methods for the instantiated
// struct or named type called `instName`, if it is a recorded generic
// instantiation.  Called from
// the pass-2 use sites (a method call on, or the boxing of, a value of the
// instantiated type), where the method registry (pass-1 stash) and every other
// FuncSig are already in place — unlike ensureInstantiatedStruct, which can run in
// pass 1/2 before those exist.  A no-op for a non-instantiation name (deduped
// downstream via EmittedInstantiations, so repeated use sites emit once).
func ensureMethodsForInstName(gc @GenCtx, instName *[]readonly char) {
	var instDecl @ast.Decl
	var defPkg @[]char
	var instArgs @[]@types.Type
	instDecl, defPkg, instArgs = genericInstanceOf(gc, instName)
	if instDecl != nil {
		ensureInstantiatedMethods(gc, instDecl, defPkg, instArgs)
	}
}

// ensureInstantiatedMethods emits the monomorphized bodies of every method whose
// receiver is the generic type `structDecl`, for the instantiation `args`, if not
// already emitted.  Reached via ensureMethodsForInstName at each use site, so any
// use of `Cursor[int]` pulls in its methods (deduped via EmittedInstantiations,
// IsLinkOnce so every consumer's copy merges).
func ensureInstantiatedMethods(gc @GenCtx, structDecl @ast.Decl, definingPkg @[]char,
		args @[]@types.Type) {
	args, _ = canonicalTypeArgs(gc, args)
	var structInstName @[]char = instantiationMangledName(gc, structDecl, definingPkg, args)
	for i := 0; i < len(gc.GenericMethodDecls); i++ {
		if !irutil.Streq(gc.GenericMethodDeclPkgs[i], definingPkg) {
			continue
		}
		var mdecl @ast.Decl = gc.GenericMethodDecls[i]
		if !irutil.Streq(genericMethodRecvName(mdecl), structDecl.Name) {
			continue
		}
		emitInstantiatedMethod(gc, structDecl, mdecl, structInstName, definingPkg, args,
				declSourceFile(gc, gc.GenericMethodDeclFiles[i], mdecl))
	}
}

// definingPkgFor returns the CurrentImportPkg a monomorphized body should
// resolve unqualified references against: empty for a same-package (local)
// generic, else the defining package.  Mirrors genCallInstantiate's convention.
func definingPkgFor(gc @GenCtx, definingPkg @[]char) @[]char {
	if irutil.Streq(definingPkg, gc.PkgPath) {
		var empty @[]char
		return empty
	}
	return definingPkg
}

// ensureGenericImplInfo synthesizes, on demand, the concrete ImplInfo rows for a
// monomorphized generic receiver boxing into an interface value —
// `@Box[int] : Getter[int]` — the way ensureAnyImplInfo does for `any`.  The
// static impl-collection path (collectImplsFromDecl) skips a parameterized-
// receiver impl (`impl @Box[T] : Getter[T]`): its receiver name resolves empty
// pre-instantiation, so no vtable row exists until a concrete boxing site
// appears.  The checker has already verified the impl, so we mint the
// (instantiated-receiver, instantiated-iface) row plus its ancestor-closure rows
// here, mirroring collectImplsFromDecl.  MethodFuncs point at
// <recvPkg>.<recvName>.<method> — exactly the names ensureInstantiatedMethods
// emits — and DtorFuncName at the instantiated struct's dtor.  A named
// instantiation (gen.instantiate.type, recvTyp the named type) is a value
// receiver like any named type (iface.construct.named-pointer), and gets the
// slot-0 destructor collectImplsFromDecl gives one: its underlying type's — a
// struct's destructor, or the structural helper (for a named managed pointer,
// releasing the pointer its cell holds), queued here; none for a raw pointer.
func ensureGenericImplInfo(m @ir.Module, recvPkg @[]char, recvName @[]char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char, recvTyp @types.Type) {
	var dtorName @[]char = implDtorFuncName(recvPkg, recvName)
	if recvTyp != nil && recvTyp.Kind != types.TYP_STRUCT {
		var none @[]char
		dtorName = none
		if !isNamedRawPointer(recvTyp) {
			dtorName = boxSlot0DtorName(m, recvPkg, recvName, recvTyp)
			irbuild.RegisterModulePendingDtor(m, recvTyp)
		}
	}
	var canonPkg @[]char = ir.CanonicalIfacePkg(m, ifacePkg, ifaceName)
	var canonName @[]char = ir.CanonicalIfaceName(m, ifacePkg, ifaceName)
	if !moduleHasImpl(m, recvPkg, recvName, canonPkg, canonName) {
		m.Impls = slices.Append[@irdata.ImplInfo](m.Impls,
				makeOwnMethodsImplInfo(m, recvPkg, recvName, dtorName, canonPkg, canonName, recvTyp))
	}
	// Each ancestor of the listed interface satisfies the same receiver, so
	// register a row for it too (upcast dispatch reads the ancestor's slot).
	var aPkgs @[]@[]char = IfaceAncestorClosurePkgs(m, canonPkg, canonName)
	var aNames @[]@[]char = IfaceAncestorClosure(m, canonPkg, canonName)
	for j := 0; j < len(aPkgs); j++ {
		if moduleHasImpl(m, recvPkg, recvName, aPkgs[j], aNames[j]) {
			continue
		}
		m.Impls = slices.Append[@irdata.ImplInfo](m.Impls,
				makeOwnMethodsImplInfo(m, recvPkg, recvName, dtorName, aPkgs[j], aNames[j], recvTyp))
	}
}

// nameIsGenericInst reports whether an IR-level type name is a generic
// instantiation — it carries the `__bn_inst__` marker that
// instantiationMangledName inserts.  Distinguishes a monomorphized receiver,
// whose vtable row must be synthesized on demand, from an ordinary missing-impl
// at a boxing site (user type names cannot contain this marker).
func nameIsGenericInst(name *[]readonly char) bool {
	var marker *[]readonly char = "__bn_inst__"
	if len(name) < len(marker) {
		return false
	}
	for i := 0; i + len(marker) <= len(name); i++ {
		var match bool = true
		for j := 0; j < len(marker); j++ {
			if name[i + j] != marker[j] {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
	return false
}
