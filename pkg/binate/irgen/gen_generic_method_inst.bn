package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Emission of one instance of a method of a generic type: the instance's
// context (its receiver binders bound to the instance's type arguments, its
// defining file's imports), its declaration (the receiver promoted to the
// first parameter) and its signature.

// emitInstantiatedMethod lowers one generic-receiver method for a concrete
// instantiation.  It mirrors ensureInstantiated (generic functions): push the
// type-param substitution context (the receiver binders → concrete args), build a
// synthetic free-function Decl with the receiver PROMOTED to Params[0] (genFunc
// ignores Recv), emit via genFunc under the defining file's imports, then override
// the symbol to the defining-package-qualified `<struct-inst>.<method>` name and
// register its FuncSig so call sites resolve it.
func emitInstantiatedMethod(gc @GenCtx, structDecl @ast.Decl, mdecl @ast.Decl,
		structInstName @[]char, definingPkg @[]char, args @[]@types.Type, defFile @ast.File) {
	var methodInstName @[]char = joinMethodName(structInstName, mdecl.Name)
	if instantiationAlreadyEmitted(gc, methodInstName) {
		return
	}
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, methodInstName)
	var src @ast.Decl = instanceCopy(gc, mdecl, structDecl, definingPkg, structInstName)
	var sc instMethodScope = beginInstMethod(gc, structDecl, mdecl, definingPkg, args, defFile)
	var synth @ast.Decl = instMethodDecl(src, methodInstName)

	// Register the FuncSig BEFORE emitting the body, mirroring the non-generic
	// pre-pass in genModule (which registers every func/method sig before any body
	// so forward references and mutual recursion resolve).  A generic-receiver
	// method is instead emitted lazily at its use site, and one such emission can
	// re-enter and emit a SIBLING method NESTED inside this one's still-in-progress
	// genFunc: M2's body calls sibling M3, M3's genFunc calls another sibling (or
	// M2 itself), and that inner call re-triggers ensureInstantiatedMethods, which
	// walks the method list and emits any not-yet-emitted sibling — including one
	// whose body calls back into a method whose genFunc has not yet returned.  If
	// the FuncSig were registered only AFTER genFunc, that nested sibling's call to
	// the in-progress method would find NO params via lookupFuncSig (a zero
	// FuncSig), so coerceArg would skip the by-value managed-struct argument copy
	// (needsStructCopy sees a nil param type) — a missing RefInc that under-retains
	// the argument and double-frees it.  Resolving the params from the synth decl
	// here (the same helpers genFunc uses, under the same substitution + alias
	// context) makes the signature visible for the entire nested emission.
	// Replacing an existing sig matters only for a REPL redefinition, which emits
	// an instance again (ReemitGenericMethod), possibly with a new shape.
	setOrAppendFuncSig(gc, instMethodSig(gc, synth, mdecl, methodInstName))

	var f @ir.Func = genFunc(gc, gc.Mod.Checker, synth)
	endInstMethod(gc, sc)
	f.Name = buf.CopyStr(methodInstName)
	f.IsLinkOnce = true
	gc.Mod.AddFunc(f)
}

// registerInstMethodSig registers the FuncSig of the instance structInstName of
// generic-receiver method mdecl, as emitInstantiatedMethod does before it emits
// the body: a REPL redefinition registers every instance's new signature before
// it emits any of their bodies (ReemitGenericMethod).
func registerInstMethodSig(gc @GenCtx, structDecl @ast.Decl, mdecl @ast.Decl,
		structInstName @[]char, definingPkg @[]char, args @[]@types.Type, defFile @ast.File) {
	var methodInstName @[]char = joinMethodName(structInstName, mdecl.Name)
	var src @ast.Decl = instanceCopy(gc, mdecl, structDecl, definingPkg, structInstName)
	var sc instMethodScope = beginInstMethod(gc, structDecl, mdecl, definingPkg, args, defFile)
	var synth @ast.Decl = instMethodDecl(src, methodInstName)
	setOrAppendFuncSig(gc, instMethodSig(gc, synth, mdecl, methodInstName))
	endInstMethod(gc, sc)
}

// instMethodScope is the IR-gen context an instance of a generic-receiver
// method resolves in (beginInstMethod), holding the context it replaced.
type instMethodScope struct {
	savedNames     @[]@[]char
	savedTypes     @[]@types.Type
	savedOwner     *uint8
	savedArgs      @[]@types.Type
	savedImportPkg @[]char
	aliasSnap      AliasMapSnapshot
}

// beginInstMethod installs the context the instance (structDecl's instance for
// args) of generic-receiver method mdecl resolves in, returning what it replaced
// for endInstMethod.
//
// Substitution context.  Within the method only the RECEIVER BINDERS are in
// scope — they rename the type's params (`@Pair[A, B]` on `type Pair[K, V]`
// binds A→arg0, B→arg1; a SWAP `@Pair[V, K]` binds V→arg0, K→arg1).  The
// type's own param names are NOT in scope: `func (b *Box[U]) Get() K` on
// `type Box[K any]` names the package type K, not the type argument.  The
// checker requires one plain binder per type parameter, so the binders cover
// every position.  (Field types are declared in the type's own param names;
// they resolve under the type's binding when the instantiated struct is built,
// not here.)  Each binder is bound under its ast.ReceiverBinderName, which
// gives a blank `_` position a name of its own; the receiver parameter (see
// instMethodDecl) is resolved from ast.WithNamedBlankBinders(receiver) to match.
//
// The body resolves against the defining file's imports + package (empty alias
// for a same-package generic, mirroring genCallInstantiate's convention).
func beginInstMethod(gc @GenCtx, structDecl @ast.Decl, mdecl @ast.Decl, definingPkg @[]char,
		args @[]@types.Type, defFile @ast.File) instMethodScope {
	var sc instMethodScope
	sc.savedNames = gc.CurrentTypeParamNames
	sc.savedTypes = gc.CurrentTypeParamTypes
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	var recvInst @ast.TypeExpr = receiverGenericInstBase(mdecl.Recv.Type)
	if recvInst != nil {
		for i := 0; i < len(recvInst.TypeArgs) && i < len(args); i++ {
			var binder @ast.TypeExpr = recvInst.TypeArgs[i]
			if binder != nil && binder.Kind == ast.TEXPR_NAMED {
				newNames = slices.Append[@[]char](newNames, ast.ReceiverBinderName(binder, i))
				newTypes = slices.Append[@types.Type](newTypes, args[i])
			}
		}
	}
	gc.CurrentTypeParamNames = newNames
	gc.CurrentTypeParamTypes = newTypes
	// The checker owns receiver binders by the generic TYPE's declaration.
	sc.savedOwner = gc.CurrentTypeParamOwner
	sc.savedArgs = gc.CurrentTypeParamArgs
	gc.CurrentTypeParamOwner = bit_cast(*uint8, structDecl)
	gc.CurrentTypeParamArgs = args

	sc.savedImportPkg = gc.Mod.CurrentImportPkg
	sc.aliasSnap = SaveAliasMapState(gc.Mod)
	if defFile != nil {
		overlayFileImports(gc.Mod, sc.aliasSnap, defFile)
	}
	gc.Mod.CurrentImportPkg = definingPkgFor(gc, definingPkg)
	return sc
}

// endInstMethod restores the context beginInstMethod replaced.
func endInstMethod(gc @GenCtx, sc instMethodScope) {
	RestoreAliasMapState(gc.Mod, sc.aliasSnap)
	gc.Mod.CurrentImportPkg = sc.savedImportPkg
	gc.CurrentTypeParamNames = sc.savedNames
	gc.CurrentTypeParamTypes = sc.savedTypes
	gc.CurrentTypeParamOwner = sc.savedOwner
	gc.CurrentTypeParamArgs = sc.savedArgs
}

// instMethodDecl returns the free-function declaration an instance of a
// generic-receiver method is generated from: the instance's checked copy src,
// named methodInstName, with its receiver PROMOTED to Params[0] (genFunc
// ignores Recv), as genMethod does.
func instMethodDecl(src @ast.Decl, methodInstName *[]readonly char) @ast.Decl {
	var synth @ast.Decl = make(ast.Decl)
	synth.Kind = ast.DECL_FUNC
	synth.Pos = src.Pos
	synth.Name = stripCurrentModuleQualifier(methodInstName)
	var prepended @[]@ast.ParamDecl = make_slice(@ast.ParamDecl, len(src.Params) + 1)
	var recvParam @ast.ParamDecl = make(ast.ParamDecl)
	recvParam.Pos = src.Recv.Pos
	recvParam.Name = src.Recv.Name
	recvParam.Type = ast.WithNamedBlankBinders(src.Recv.Type)
	recvParam.Variadic = src.Recv.Variadic
	prepended[0] = recvParam
	for i := 0; i < len(src.Params); i++ {
		prepended[i + 1] = src.Params[i]
	}
	synth.Params = prepended
	synth.Results = src.Results
	synth.Body = src.Body
	return synth
}

// instMethodSig returns the FuncSig of the instance methodInstName of
// generic-receiver method mdecl, from its declaration synth (instMethodDecl),
// resolved in its context (beginInstMethod).
func instMethodSig(gc @GenCtx, synth @ast.Decl, mdecl @ast.Decl,
		methodInstName *[]readonly char) irdata.FuncSig {
	var sig irdata.FuncSig
	sig.Name = buf.CopyStr(methodInstName)
	var sigParams @[]@types.Type
	for i := 0; i < len(synth.Params); i++ {
		sigParams = slices.Append[@types.Type](sigParams, irResolveParamType(gc, synth.Params[i]))
	}
	sig.Params = sigParams
	sig.IsVariadic = declIsVariadic(mdecl)
	var sigResults @[]@types.Type
	for i := 0; i < len(synth.Results); i++ {
		sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(gc, synth.Results[i]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = irutil.MakeMultiReturnStructType(sigResults)
	}
	return sig
}
