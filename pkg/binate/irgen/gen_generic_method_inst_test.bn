package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_generic_method_inst.bn: the context, declaration and signature
// an instance of a method of a generic type is generated from.
// genFromSourcePkgGc / strToBytes live in gen_test_support_test.bn.

// curSrc declares a generic type with one method, used by Cur[int].
var curSrc *[]readonly char = "package \"test\"\ntype Cur[T any] struct { v T }\n"
		"func (c *Cur[T]) Get(k int) T { return c.v }\n"
		"func main() { var x Cur[int]; _ = x.Get(1) }\n"

// parseMethod parses one method declaration.
func parseMethod(src *[]readonly char) @ast.Decl {
	var p @parser.Parser = parser.New(strToBytes(src), "<test>")
	return p.ParseTopLevelDecl()
}

// intArgs returns the type-argument list [int].
func intArgs() @[]@types.Type {
	var args @[]@types.Type = make_slice(@types.Type, 1)
	args[0] = types.TypInt()
	return args
}

// An instance's declaration takes the receiver as its first parameter, and the
// instance's name without the module qualifier.
func TestInstMethodDeclPromotesReceiver() testing.TestResult {
	var d @ast.Decl = parseMethod("func (c *Cur[T]) Get(k int) T { return c.v }")
	var synth @ast.Decl = instMethodDecl(d, "test.Cur__inst.Get")
	if !irutil.Streq(synth.Name, "Cur__inst.Get") { return "the module qualifier must be stripped" }
	if len(synth.Params) != 2 { return "the receiver must be prepended to the parameters" }
	if !irutil.Streq(synth.Params[0].Name, "c") || !irutil.Streq(synth.Params[1].Name, "k") {
		return "the receiver must come first, then k"
	}
	if synth.Recv != nil { return "the declaration must have no receiver" }
	if !same(synth.Body, d.Body) || len(synth.Results) != 1 {
		return "the body and results must carry over"
	}
	return ""
}

// An instance's context binds the receiver's binders to the type arguments,
// owned by the generic type, and ending it restores the context before.
func TestInstMethodScopeBindsAndRestores() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(curSrc)
	var structDecl @ast.Decl = lookupGenericTypeDeclPkg(gc, gc.PkgPath, "Cur")
	if structDecl == nil || len(gc.GenericMethodDecls) != 1 { return "Cur and Get must be stashed" }
	var savedOwner *uint8 = gc.CurrentTypeParamOwner
	var savedNames int = len(gc.CurrentTypeParamNames)
	var sc instMethodScope = beginInstMethod(gc, structDecl, gc.GenericMethodDecls[0], gc.PkgPath,
			intArgs(), nil)
	if len(gc.CurrentTypeParamNames) != 1 || !irutil.Streq(gc.CurrentTypeParamNames[0], "T") ||
			gc.CurrentTypeParamTypes[0].Kind != types.TYP_INT {
		return "T must be bound to int"
	}
	if gc.CurrentTypeParamOwner != bit_cast(*uint8, structDecl) { return "Cur must own the binder" }
	endInstMethod(gc, sc)
	if gc.CurrentTypeParamOwner != savedOwner || len(gc.CurrentTypeParamNames) != savedNames {
		return "the context before must be restored"
	}
	return ""
}

// instSig returns the registered FuncSig named name.
func instSig(gc @GenCtx, name *[]readonly char) irdata.FuncSig {
	var none irdata.FuncSig
	var idx int = ir.FuncSigIndexLookup(gc.Mod, name)
	if idx < 0 { return none }
	return gc.Mod.FuncSigs.Get(idx)
}

// Registering an instance's signature from a redefinition replaces the one
// registered before (the REPL emits a redefined method's instances again).
func TestRegisterInstMethodSigReplaces() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(curSrc)
	var structDecl @ast.Decl = lookupGenericTypeDeclPkg(gc, gc.PkgPath, "Cur")
	var instName @[]char = instantiationMangledName(gc, structDecl, gc.PkgPath, intArgs())
	var name @[]char = joinMethodName(instName, "Get")
	if len(instSig(gc, name).Params) != 2 { return "Cur[int].Get must be registered with c and k" }
	var count int = gc.Mod.FuncSigs.Len()
	var redef @ast.Decl = parseMethod("func (c *Cur[T]) Get() bool { return true }")
	registerInstMethodSig(gc, structDecl, redef, instName, gc.PkgPath, intArgs(), nil)
	var sig irdata.FuncSig = instSig(gc, name)
	if len(sig.Params) != 1 || len(sig.Results) != 1 || sig.Results[0].Kind != types.TYP_BOOL {
		return "the redefinition's signature must replace the old one"
	}
	if gc.Mod.FuncSigs.Len() != count { return "the signature must be replaced, not added" }
	return ""
}
