package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/parser"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// exprToTypeExpr on EXPR_UNARY(STAR, IDENT) builds a
// TEXPR_POINTER over the inner ident: the checker's pointer
// type-arg form, mirrored here in the IR layer.
func TestExprToTypeExprPointer() testing.TestResult {
	var inner @ast.Expr = make(ast.Expr)
	inner.Kind = ast.EXPR_IDENT
	inner.Name = "int"
	var outer @ast.Expr = make(ast.Expr)
	outer.Kind = ast.EXPR_UNARY
	outer.Op = cast(int, token.STAR)
	outer.X = inner
	var te @ast.TypeExpr = exprToTypeExpr(outer)
	if te == nil { return "expected non-nil TypeExpr" }
	if te.Kind != ast.TEXPR_POINTER {
		return "expected TEXPR_POINTER"
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_NAMED || !irutil.Streq(te.Base.Name, "int") {
		return "expected pointer to 'int'"
	}
	return ""
}

// exprToTypeExpr on an EXPR_IDENT produces a matching
// TEXPR_NAMED.
func TestExprToTypeExprIdent() testing.TestResult {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Name = "int"
	var te @ast.TypeExpr = exprToTypeExpr(e)
	if te == nil { return "expected non-nil TypeExpr" }
	if te.Kind != ast.TEXPR_NAMED {
		return "expected TEXPR_NAMED"
	}
	if !irutil.Streq(te.Name, "int") {
		return "expected name 'int'"
	}
	return ""
}

// exprToTypeExpr on a non-supported expr shape (e.g., an int
// literal) returns nil — the synthesizer can't interpret it as
// a type.
func TestExprToTypeExprUnsupported() testing.TestResult {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INT_LIT
	e.Name = "1"
	if exprToTypeExpr(e) != nil {
		return "expected nil for INT_LIT"
	}
	return ""
}

// instantiationAlreadyEmitted returns false when the name isn't
// in the cache, true once added.
func TestInstantiationAlreadyEmitted() testing.TestResult {
	var gc @GenCtx = NewGenCtx(nil)
	if instantiationAlreadyEmitted(gc, "foo__bn_inst__int") {
		return "fresh cache should not report hit"
	}
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, "foo__bn_inst__int")
	if !instantiationAlreadyEmitted(gc, "foo__bn_inst__int") {
		return "should hit after append"
	}
	if instantiationAlreadyEmitted(gc, "foo__bn_inst__bool") {
		return "distinct mangled name should not hit"
	}
	return ""
}

// An instantiation's head is the generic function the checker recorded
// (recordedGenericHead): the module's own id.  An index of a variable named like a
// registered generic is no instantiation.  A head the checker never saw is read by
// its spelling, in the module's own package; a checked one with no record of a
// generic is none.
func TestInstantiationHeadFromRecord() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes(
					"package \"main\"\nfunc id[T any](v T) T { return v }\n"
							"var fns [1]*func(int) int\nvar f *func(int) int = id[int]\n"
							"func g() int { return fns[0](1) }\n"),
			"test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = mustCheck(file)
	var gc @GenCtx = NewGenCtx(testInitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	var own @ast.Decl = lookupGenericDecl(gc, "id")
	if own == nil { return fail("main's id must be registered") }
	var fake @ast.Decl = make(ast.Decl)
	fake.Name = buf.CopyStr("fns")
	registerTestGeneric(gc, fake, gc.PkgPath)
	var ctx @GenContext
	ctx, _ = scopeTestCtx()
	ctx.Gc = gc
	ctx.Checker = c
	var f @ast.Expr = varInit(file, "f")
	var call @ast.Expr = funcResult(file, "g")
	if f == nil || call == nil { return fail("the instantiation and the index must be found") }
	var gd @ast.Decl
	var defPkg @[]char
	gd, defPkg = instantiationHead(ctx, f)
	if !same(gd, own) || len(defPkg) > 0 { return fail("id[int] must be main's id") }
	gd, _ = instantiationHead(ctx, call.X)
	if gd != nil { return fail("fns[0] must index the variable") }
	var head @ast.Expr = fakeExpr(ast.EXPR_INSTANTIATE_OR_INDEX, "", 0)
	head.X = fakeExpr(ast.EXPR_IDENT, "id", 0)
	gd, defPkg = instantiationHead(ctx, head)
	if !same(gd, own) || len(defPkg) > 0 {
		return fail("an unrecorded id[int] must be read by its spelling: main's")
	}
	head.ResolvedTypeID = 1
	gd, _ = instantiationHead(ctx, head)
	if gd != nil { return fail("a checked id[int] with no record of a generic must be none") }
	return ""
}

// registerTestGeneric registers the generic declaration d as package pkg's.
func registerTestGeneric(gc @GenCtx, d @ast.Decl, pkg *[]readonly char) {
	gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
	gc.GenericDeclPkgs = slices.Append[@[]char](gc.GenericDeclPkgs, buf.CopyStr(pkg))
}

// A package-qualified head is the generic of the package the checker recorded
// (recordedGenericHead), which declares it, though IR-gen's import of the name a
// is rebound to another package that registers a generic of the same name.  A
// head with no record is read through IR-gen's import: the other package's Id.
func TestInstantiationHeadQualifiedFromRecord() testing.TestResult {
	var pa @parser.Parser = parser.NewInterface(
			strToBytes("package \"pkg/a\"\nfunc Id[T any](v T) T { return v }\n"), "a.bni")
	var fa @ast.File = mustParse(pa)
	if len(fa.Decls) != 1 || !irutil.Streq(fa.Decls[0].Name, "Id") {
		return fail("pkg/a must declare Id")
	}
	var c @check.Checker = check.NewChecker()
	c.LoadPackageInterface("pkg/a", fa)
	var p @parser.Parser = parser.New(
			strToBytes("package \"main\"\nimport \"pkg/a\"\nvar f *func(int) int = a.Id[int]\n"), "main.bn")
	var file @ast.File = mustParse(p)
	c.Check(file)
	if len(c.CheckerErrors()) > 0 {
		return fail(buf.Concat("the program must check: ", c.CheckerErrors()[0].Msg))
	}
	var gc @GenCtx = NewGenCtx(testInitModule(file.PkgName))
	gc.Mod.Checker = c
	gc.Mod.PkgPath = buf.CopyStr("main")
	gc.PkgPath = gc.Mod.PkgPath
	var other @ast.Decl = make(ast.Decl)
	other.Name = buf.CopyStr("Id")
	registerTestGeneric(gc, fa.Decls[0], "pkg/a")
	registerTestGeneric(gc, other, "pkg/b")
	RecordImportPath(gc.Mod, "a", "pkg/b")
	var ctx @GenContext
	ctx, _ = scopeTestCtx()
	ctx.Gc = gc
	ctx.Checker = c
	var f @ast.Expr = varInit(file, "f")
	if f == nil { return fail("the instantiation must be found") }
	var gd @ast.Decl
	var defPkg @[]char
	gd, defPkg = instantiationHead(ctx, f)
	if !same(gd, fa.Decls[0]) || !irutil.Streq(defPkg, "pkg/a") {
		return fail("a.Id[int] must be pkg/a's Id")
	}
	var head @ast.Expr = fakeExpr(ast.EXPR_INSTANTIATE_OR_INDEX, "", 0)
	head.X = fakeExpr(ast.EXPR_SELECTOR, "Id", 0)
	head.X.X = fakeExpr(ast.EXPR_IDENT, "a", 0)
	gd, defPkg = instantiationHead(ctx, head)
	if !same(gd, other) || !irutil.Streq(defPkg, "pkg/b") {
		return fail("an unrecorded a.Id[int] must be read through IR-gen's import: pkg/b's")
	}
	return ""
}
