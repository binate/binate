package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/types"

// Global-var type inference: the IR type of a top-level `var`.

// resolveGlobalVarType returns the type for a top-level `var` declaration: the
// declared one (resolveTypeExpr), or for `var x = expr` the one the checker gave
// the variable (Decl.ResolvedTypeID, mapped by typeFromRecord): an untyped
// initializer at its default type (`var x = 42` is an int, `var s = "hi"` an
// @[]readonly char), a function reference decayed to @func (`var G = add1`,
// `var G = glib.Ident[int]`), a generic instantiation IR-gen's instantiated
// struct, a named type the one registered under its qualified name (whose methods
// are looked up in its own package).  A declaration the checker gave no type is an
// internal error.
//
// Without a checker the type is inferred from a literal initializer's kind --
// `var x = 42` an int, `1.5` a float64, `true` a bool, `'a'` a char, `"hello"` an
// @[]readonly char -- and is nil for any other initializer.
func resolveGlobalVarType(gc @GenCtx, d @ast.Decl) @types.Type {
	if d.TypeRef != nil {
		return resolveTypeExpr(gc, d.TypeRef)
	}
	if d.Value == nil { return nil }
	if gc.Mod != nil && gc.Mod.Checker != nil {
		var rec @types.Type = gc.Mod.Checker.ExprType(d.ResolvedTypeID)
		if rec == nil {
			panic("internal error: a package variable the checker did not type (compiler bug)")
		}
		return typeFromRecord(gc, rec)
	}
	var e @ast.Expr = d.Value
	if e.Kind == ast.EXPR_INT_LIT { return types.TypInt() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypFloat64() }
	if e.Kind == ast.EXPR_STRING_LIT {
		return types.MakeManagedSliceType(
				types.MakeReadonlyType(types.TypUint8()))
	}
	return nil
}
