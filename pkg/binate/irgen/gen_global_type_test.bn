package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for global-var type inference (resolveGlobalVarType).

func TestResolveGlobalVarTypeIntLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_INT_LIT, "42")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t == nil { return fail("int lit: expected non-nil") }
	if t.Kind != types.TYP_INT { return fail("int lit: wrong kind") }
	return ""
}

func TestResolveGlobalVarTypeBoolLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_BOOL_LIT, "true")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t == nil { return fail("bool lit: expected non-nil") }
	if t.Kind != types.TYP_BOOL { return fail("bool lit: wrong kind") }
	return ""
}

func TestResolveGlobalVarTypeCharLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_CHAR_LIT, "A")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t == nil { return fail("char lit: expected non-nil") }
	// char is uint8.
	if t.Kind != types.TYP_INT { return fail("char lit: wrong kind") }
	if t.Width != 8 { return fail("char lit: wrong width") }
	return ""
}

func TestResolveGlobalVarTypeFloatLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_FLOAT_LIT, "1.5")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t == nil { return fail("float lit: expected non-nil") }
	if t.Kind != types.TYP_FLOAT {
		return fail("float lit: wrong kind")
	}
	return ""
}

func TestResolveGlobalVarTypeStringLit() testing.TestResult {
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_STRING_LIT, "hi")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t == nil { return fail("string lit: expected non-nil") }
	// Default is @[]readonly char — managed-slice of const-uint8.
	if t.Kind != types.TYP_MANAGED_SLICE {
		return fail("string lit: expected managed-slice default")
	}
	return ""
}

func TestResolveGlobalVarTypeNonLiteralReturnsNil() testing.TestResult {
	// `var x = a + b` — initializer is EXPR_BINARY, not a
	// recognized literal kind.  Must return nil so the caller
	// surfaces a "type required" diagnostic instead of silently
	// inferring something wrong.
	var d @ast.Decl = mkUntypedVarDecl(ast.EXPR_BINARY, "")
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t != nil {
		return fail("non-literal init: expected nil (caller errors)")
	}
	return ""
}

// A package-scope global with a bare function-reference initializer infers the
// decayed @func type (read from the checker's resolved expr type), so the global
// registers as a func-value slot rather than an opaque scalar — otherwise its
// __init assignment lowers the reference to a zero placeholder (no OP_FUNC_VALUE).
func TestResolveGlobalVarTypeFuncRefInfersFuncValue() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "func add1(x int) int { return x + 1 }\n")
	src = concatChars(src, "var G = add1\n")
	src = concatChars(src, "func main() { }\n")
	var m @ir.Module = genFromSourceWithChecker(src)
	var found bool = false
	for i := 0; i < len(m.GlobalVars); i++ {
		if !irutil.Streq(m.GlobalVars[i].Name, "G") { continue }
		found = true
		var t @types.Type = m.GlobalVars[i].Typ
		if t == nil { return fail("G: expected a non-nil func-value type") }
		if t.Kind != types.TYP_MANAGED_FUNC_VALUE {
			return fail("G: expected TYP_MANAGED_FUNC_VALUE (decayed @func)")
		}
	}
	if !found { return fail("global G not registered") }
	return ""
}

// A global inferred from another func-value variable of a NAMED func-value type
// (`type Fn @func(int)int; var base Fn = add1; var G = base`) registers exactly
// the type the explicit `var base Fn` gets: the named Fn over its @func (whose
// methods key on Fn).  A slot typed otherwise — the pointer-sized scalar of an
// untyped global — would be overrun by __init's two-word func-value store.
func TestResolveGlobalVarTypeNamedFuncValueVarKeepsNamed() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\n")
	src = concatChars(src, "type Fn @func(int) int\n")
	src = concatChars(src, "func add1(x int) int { return x + 1 }\n")
	src = concatChars(src, "var base Fn = add1\n")
	src = concatChars(src, "var G = base\n")
	src = concatChars(src, "func main() { }\n")
	var m @ir.Module = genFromSourceWithChecker(src)
	var g @types.Type = globalVarType(m, "G")
	var base @types.Type = globalVarType(m, "base")
	if g == nil || base == nil { return fail("G / base not registered with a type") }
	if g.Kind != types.TYP_NAMED || !g.IdenticalStrict(base) {
		return fail("G: expected base's type, the named Fn")
	}
	var u @types.Type = types.StripWrappers(g)
	if u == nil || u.Kind != types.TYP_MANAGED_FUNC_VALUE {
		return fail("G: expected Fn over a managed func value")
	}
	return ""
}

func TestResolveGlobalVarTypeNoInitReturnsNil() testing.TestResult {
	// `var x` (no type, no initializer) is malformed at the
	// var-decl parse level, but the helper must not crash.
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = "x"
	var t @types.Type = resolveGlobalVarType(NewGenCtx(nil), d)
	if t != nil { return fail("no init: expected nil") }
	return ""
}

// mkUntypedVarDecl builds `var x = <lit>` with no TypeRef and a
// synthetic Value of the requested kind.
func mkUntypedVarDecl(kind int, name @[]char) @ast.Decl {
	var v @ast.Expr = make(ast.Expr)
	v.Kind = kind
	v.Name = name
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = "x"
	d.Value = v
	return d
}
