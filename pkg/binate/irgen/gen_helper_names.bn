package "pkg/binate/irgen"

import "pkg/binate/irdata"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// A helperNames is the set of destructor and copy helpers generated for a module, by
// name.  The module's dtor and copy passes, and the REPL's, look each helper up before
// generating it, and a ring of named types (`type L0 @[]L1`, `type L1 @[]L2`, ...) has
// a helper for every type in it, so the set is a table rather than a list searched
// each time.  It owns its names (names); the table's keys view them.
type helperNames struct {
	names @vec.Vec[@[]char]
	index @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq]
}

// newHelperNames returns an empty set of helper names.
func newHelperNames() @helperNames {
	var h @helperNames = make(helperNames)
	h.names = vec.New[@[]char]()
	h.index = newNameSet()
	return h
}

// has reports whether the helper named name has been generated.
func (h @helperNames) has(name *[]readonly char) bool {
	return h.index.Has(name)
}

// add records the helper named name as generated.
func (h @helperNames) add(name @[]char) {
	if h.index.Has(name) { return }
	h.names.Push(name)
	h.index.Put(name, true)
}
