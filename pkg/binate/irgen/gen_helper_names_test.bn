package "pkg/binate/irgen"

import "pkg/builtins/testing"

// A name is in the set once added, and only then; adding it again keeps one copy.
func TestHelperNamesAddHas() testing.TestResult {
	var h @helperNames = newHelperNames()
	if h.has("__dtor_ms_int") { return fail("an empty set has no names") }
	h.add("__dtor_ms_int")
	h.add("__copy_arr2_ms_int")
	h.add("__dtor_ms_int")
	if !h.has("__dtor_ms_int") || !h.has("__copy_arr2_ms_int") {
		return fail("an added name should be in the set")
	}
	if h.has("__dtor_ms_bool") { return fail("a name never added should not be in the set") }
	if h.names.Len() != 2 { return fail("a name added twice should be kept once") }
	return ""
}
