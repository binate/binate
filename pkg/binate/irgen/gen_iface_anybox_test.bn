package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irutil"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the any-block support helpers in gen_iface_anybox.bn.  The pure name /
// identity helpers (splitQualName, receiverBaseTypeName, isUniverseAny) are pinned
// directly here; ensureAnyImplInfo's (T, any) row synthesis is exercised end-to-end
// by the any-box conformance tests (1077 / 1101 / 1109 ...).  fail lives in the
// package's other test files.

// splitQualName splits `pkg.Name` into its components and passes an unqualified
// name through with an empty package.
func TestSplitQualName() testing.TestResult {
	var pkg @[]char
	var name @[]char
	pkg, name = irutil.SplitQualName("hello.Hello")
	if !irutil.Streq(pkg, "hello") {
		return fail("splitQualName should split the package off `hello.Hello`")
	}
	if !irutil.Streq(name, "Hello") {
		return fail("splitQualName should keep `Hello` as the bare name")
	}
	pkg, name = irutil.SplitQualName("Plain")
	if len(pkg) != 0 {
		return fail("an unqualified name should have an empty package")
	}
	if !irutil.Streq(name, "Plain") {
		return fail("an unqualified name should pass through unchanged")
	}
	return ""
}

// receiverBaseTypeName peels pointer / managed-pointer wrappers to the nominal
// leaf, and returns empty for a name-less (slice) leaf or nil.
func TestReceiverBaseTypeName() testing.TestResult {
	var noFields @[]@types.Field
	var node @types.Type = types.MakeStructType("Node", noFields)
	if !irutil.Streq(irutil.ReceiverBaseTypeName(types.MakeManagedPtrType(node)), "Node") {
		return fail("receiverBaseTypeName should peel `@Node` to `Node`")
	}
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	if len(irutil.ReceiverBaseTypeName(types.MakeManagedPtrType(ms))) != 0 {
		return fail("a managed-slice pointee is name-less -> empty")
	}
	if len(irutil.ReceiverBaseTypeName(nil)) != 0 {
		return fail("nil -> empty")
	}
	return ""
}

// isUniverseAny recognizes the universe `any` (Pkg="", Name="any") and an alias
// of it another package declares (`interface A = any` in pkg/home reaches
// IR-gen as (pkg/home, A)), resolved through the module's interface registry —
// and nothing else.
func TestIsUniverseAny() testing.TestResult {
	var emptyPkg @[]char
	var m @ir.Module = ir.NewModule("test")
	if !isUniverseAny(m, types.MakeInterfaceType(emptyPkg, "any")) {
		return fail("the universe any (Pkg empty, Name=any) should match")
	}
	if isUniverseAny(m, types.MakeInterfaceType("pkg", "Foo")) {
		return fail("a named user interface should not match")
	}
	if isUniverseAny(m, types.MakeInterfaceType(emptyPkg, "Foo")) {
		return fail("Pkg empty but Name != any should not match")
	}
	if isUniverseAny(m, nil) {
		return fail("nil should not match")
	}
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\ninterface A = any\n" "interface B {\n\tf() int\n}\n")
	var gc @GenCtx = NewGenCtx(m)
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/home", file)
	collectInterfaceFromDecl(gc, file.Decls[1], "pkg/home", file)
	if !isUniverseAny(m, types.MakeInterfaceType("pkg/home", "A")) {
		return fail("another package's alias of any should match")
	}
	if isUniverseAny(m, types.MakeInterfaceType("pkg/home", "B")) {
		return fail("another package's own interface should not match")
	}
	return ""
}
