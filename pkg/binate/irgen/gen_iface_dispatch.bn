package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// IR-gen lowering for interface-method DISPATCH (`iv.method(args)`):
// detecting an interface-value receiver at a SELECTOR call site and
// emitting the vtable-dispatch call (including the pointer-to-iface-value
// smoothing loads), plus the interface method-table lookups.  Resolution
// of `*X` / `@X` to interface-value types and the lifting of `*T` / `@T`
// into interface values live in gen_iface.bn; the module-build-time
// interface registry / impl-collection live in gen_impl.bn.

// isInterfaceMethodCall reports whether sel.X resolves to an
// interface value at IR-gen time — peeks at the receiver
// expression's type via getSelectorType / lookupVarType without
// re-evaluating it. Used by genCall to route SELECTOR callees with
// interface-value receivers to the vtable-dispatch path.
//
// Pointer-to-iv smoothing: a receiver of kind `**I` / `*@I` / `@(*I)` / `@(@I)` also
// routes here.  `genInterfaceMethodCall` emits the load to recover
// the iv before dispatching.  The type-checker accepts the same
// shape via the smoothing rule in `tryMethodCall`.
func isInterfaceMethodCall(ctx @GenContext, sel @ast.Expr) bool {
	if sel == nil || sel.X == nil { return false }
	// A named type, or a pointer to one, has only its own methods
	// (type.named.methods-not-inherited): `x.M()` on `type X @J` calls X's M, never
	// J's vtable.  The checker's type of the receiver keeps the name, where
	// getSelectorType's peels it for a call / conversion / assertion receiver.
	if ctx.Checker != nil && sel.X.ResolvedTypeID != 0 &&
			isNamedRecvBase(ctx.Checker.ExprType(sel.X.ResolvedTypeID)) {
		return false
	}
	var recvTyp @types.Type = nil
	if sel.X.Kind == ast.EXPR_IDENT {
		recvTyp = lookupVarType(ctx, sel.X.Name)
	} else {
		// Every other receiver expression — a call result (`f(...).M()`, including
		// a generic-function instantiation callee `id[@Iface](x).M()`), a
		// conversion (`cast(@I, m).M()`), a type assertion (`x.(*I2).M()`), an
		// index, a field, a deref — types via getSelectorType.  A receiver left
		// untyped here falls to the concrete method path, which mangles a method
		// symbol with an EMPTY receiver-type name (`bn_F..main2_0_3_num`) that is
		// declared but never defined → link failure.
		recvTyp = getSelectorType(ctx, sel.X)
	}
	if recvTyp == nil { return false }
	// Peel aliases and `readonly` — as the checker's tryMethodCall does
	// (resolveAliasAndConst) — so a `readonly @Iface` receiver still routes
	// through interface dispatch; otherwise recvTyp.Kind == TYP_READONLY misses
	// both arms and the call falls to the regular method path, which mangles a
	// bogus `bn_F` method symbol.  Not a NAMED type: a named interface-value type
	// (`type X @J`) does not inherit J's methods, so `x.M()` calls X's own method
	// M, which J's vtable has no slot for.
	recvTyp = types.ResolveAliasAndConst(recvTyp)
	if recvTyp == nil { return false }
	if recvTyp.Kind == types.TYP_INTERFACE_VALUE || recvTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		return true
	}
	if (recvTyp.Kind == types.TYP_POINTER || recvTyp.Kind == types.TYP_MANAGED_PTR) &&
			recvTyp.Elem != nil {
		var inner @types.Type = types.ResolveAliasAndConst(recvTyp.Elem)
		if inner != nil &&
				(inner.Kind == types.TYP_INTERFACE_VALUE || inner.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
			return true
		}
	}
	return false
}

// isNamedRecvBase reports whether receiver type t — through aliases and `readonly`,
// and one pointer level — is a named type.
func isNamedRecvBase(t @types.Type) bool {
	t = types.ResolveAliasAndConst(t)
	if t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR) {
		t = types.ResolveAliasAndConst(t.Elem)
	}
	return t != nil && t.Kind == types.TYP_NAMED
}

// genInterfaceMethodCall lowers `iv.method(args)` where iv is a
// TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED to an
// OP_CALL_IFACE_METHOD instruction.  The method's vtable slot comes from the
// per-module interface registry, its signature from the checker's type of the
// receiver (ifaceCallMethodType).
//
// Pointer-to-iv smoothing: when sel.X produces a
// pointer-to-iv value, emit the load to recover the iv before
// dispatch.  The type-checker's smoothing rule guarantees this
// only fires when the user wrote `p.M()` for a pointer-to-iv `p`.
func genInterfaceMethodCall(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	var sel @ast.Expr = e.X
	var iv @ir.Instr = genExpr(ctx, b, sel.X)
	b = ctx.CurBlock
	if iv != nil && iv.Typ != nil &&
			(iv.Typ.Kind == types.TYP_POINTER || iv.Typ.Kind == types.TYP_MANAGED_PTR) &&
			iv.Typ.Elem != nil &&
			(iv.Typ.Elem.Kind == types.TYP_INTERFACE_VALUE ||
					iv.Typ.Elem.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		iv = irbuild.EmitLoad(b, iv, iv.Typ.Elem)
	}
	// Peel any IR-transparent wrapper (readonly/named/alias) before reading
	// the interface name: for a `readonly @Iface` receiver iv.Typ.Elem is the
	// wrapper's inner @Iface (whose Name is empty), so the dispatch would
	// mangle to a bogus `bn_F` method symbol; types.StripWrappers(iv.Typ).Elem is the
	// interface type that carries the name.
	var ifaceTyp @types.Type = nil
	if iv != nil { ifaceTyp = types.StripWrappers(iv.Typ) }
	if ifaceTyp == nil || ifaceTyp.Elem == nil {
		panic("internal error: IR-gen has no interface type for an interface method call (compiler bug)")
	}
	var ifacePkg @[]char = ifaceTyp.Elem.Pkg
	var ifaceName @[]char = ifaceTyp.Elem.Name
	var idx int = findInterfaceMethod(ctx.Gc.Mod, ifacePkg, ifaceName, sel.Name)
	if idx < 0 {
		var msg @[]char = buf.Concat("internal error: IR-gen has no method ", sel.Name)
		panic(buf.Concat(msg, " in the called interface (compiler bug)"))
	}
	var resultTypes @[]@types.Type
	var paramTypes @[]@types.Type
	var isVariadic bool
	resultTypes, paramTypes, isVariadic = ifaceCallSignature(ctx, sel)
	// Build the dispatch result type from the full result list: 0 -> void,
	// 1 -> the single type, >=2 -> the multi-return tuple struct (so a
	// downstream multi-assign `extractvalue`s against a real struct, not the
	// void a single-result store produced for a >=2-result method).  Mirrors
	// the direct multi-return call in gen_call.bn.
	var resultTyp @types.Type = types.TypVoid()
	if len(resultTypes) == 1 {
		resultTyp = resultTypes[0]
	} else if len(resultTypes) >= 2 {
		resultTyp = irutil.MakeMultiReturnStructType(resultTypes)
	}
	// Marshal args via the shared evalCallArgs / deliverCallArgs, exactly like the direct / method
	// / func-value call paths: a non-variadic method binds each arg positionally
	// (genExprOrFuncRef + coerceArg — func-value lifting, managed->raw slice,
	// string->chars, iface move/RefInc — without which a managed-slice arg to a
	// raw-slice param shifts later args), a variadic method packs its trailing
	// individual args into the single *[]T or forwards a spread operand.  At this
	// vtable-dispatch boundary variadic-ness is erased to a plain *[]T before the
	// indirection (func.variadic.identity); the variadic parameter's type is the
	// *[]T body type.
	// Split eval and delivery so an iface-method stack-overflow / nil PRE-CHECK sits
	// between them, mirroring genCall's OP_STACK_CHECK for direct calls: the args are
	// evaluated (SP reflects their growth) but not yet delivered/consumed, so
	// OP_STACK_CHECK_IM's cleanup pad still covers every owned arg, and delivery is
	// SP-neutral.  For a VM iface value (dispatched by a direct in-arm frame push) the
	// check is exact, and faulting here — instead of at the later pushFrame, after a
	// moved arg is consumed — keeps that arg from leaking on overflow (or on a nil
	// interface value).  iv is borrowed by the call (its data ptr becomes the
	// receiver, not consumed), so it stays a live temp the pad RefDecs once on fault.
	// VM-only: the compiled backends no-op OP_STACK_CHECK_IM.
	var args @[]@ir.Instr = evalCallArgs(ctx, b, e.Args, paramTypes, isVariadic, e.Spread)
	b = ctx.CurBlock
	irbuild.EmitStackCheckIM(b, iv, idx)
	attachFaultPad(ctx, b)
	args = deliverCallArgs(ctx, b, args, paramTypes, isVariadic)
	b = ctx.CurBlock
	var result @ir.Instr = irbuild.EmitCallIfaceMethod(b, iv, args, idx, resultTyp)
	// Stamp the cross-mode aggregate retbuf size from the method's full
	// result LIST — the lowered resultTyp collapses a multi-return into an
	// anonymous tuple that AggInRegCoercedKind excludes, so the VM dispatch
	// cannot recover the aggregate-ness from it.
	result.RetbufSize = abi.AggregateReturnSize(resultTypes)
	attachFaultPad(ctx, b) // call-site cleanup pad; see genCall's EmitCall site
	registerManagedCallResult(ctx, result, resultTyp)
	return result
}

// ifaceCallSignature returns the result types, parameter types and last-parameter
// variadic flag of the interface method the call selector sel dispatches, from
// the checker's signature of the method (ifaceCallMethodType) mapped to IR-gen
// types.  The checker rejects a call through an interface value of a method that
// mentions `Self` (iface.self.object-safety), so no such method reaches here.
func ifaceCallSignature(ctx @GenContext, sel @ast.Expr) (@[]@types.Type, @[]@types.Type, bool) {
	var ft @types.Type = ifaceCallMethodType(ctx, sel)
	if ft == nil {
		panic(buf.Concat("internal error: no checker signature for interface method ", sel.Name))
	}
	if types.FuncMentionsSelf(ft) {
		panic(buf.Concat("internal error: interface dispatch of a method that uses Self: ", sel.Name))
	}
	var mapped @types.Type = irTypeFromChecker(ctx.Gc, ft)
	if mapped == nil {
		panic(buf.Concat("internal error: interface method signature has no IR-gen type: ", sel.Name))
	}
	var params @[]@types.Type = make_slice(@types.Type, len(mapped.Params))
	for i := 0; i < len(mapped.Params); i++ {
		params[i] = mapped.Params[i].Type
	}
	return mapped.Results, params, types.FuncIsVariadic(ft)
}

// ifaceCallMethodType returns the checker's signature of the method the call
// selector sel names on its interface-value receiver — through aliases,
// `readonly` and one pointer level (the pointer-to-iv smoothing) — or nil when
// the receiver has no checker type or is not an interface value.
func ifaceCallMethodType(ctx @GenContext, sel @ast.Expr) @types.Type {
	if ctx.Checker == nil || sel.X == nil || sel.X.ResolvedTypeID == 0 { return nil }
	var t @types.Type = types.ResolveAliasAndConst(ctx.Checker.ExprType(sel.X.ResolvedTypeID))
	if t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR) {
		t = types.ResolveAliasAndConst(t.Elem)
	}
	if t == nil ||
			(t.Kind != types.TYP_INTERFACE_VALUE && t.Kind != types.TYP_INTERFACE_VALUE_MANAGED) {
		return nil
	}
	var m @types.Method = t.Elem.LookupInterfaceMethod(sel.Name)
	if m == nil { return nil }
	return m.FuncType
}

// findInterfaceMethod returns the absolute vtable slot of the named method on
// (ifacePkg, ifaceName), or -1 if not found.  The slot
// is 0-based into the canonical (R, I)
// vtable layout: slots 0-1 = the any-block (dtor, then *TypeInfo),
// slots 2.. populated by the concat layout (each parent's full
// vtable inlined, then own methods).  For a non-extended interface,
// slot = j + 2 where j is the method's 0-based position in
// MethodNames — accounting for the two-word any-block.
// For an extended interface, the slot may land inside a nested
// parent sub-vtable; the recursive walk computes that statically.
//
// Follows alias chains; cross-package lookups require ifacePkg
// to be the canonical package.
func findInterfaceMethod(m @ir.Module, ifacePkg *[]readonly char, ifaceName *[]readonly char,
		methodName *[]readonly char) int {
	return findInterfaceMethodFromBase(m, ifacePkg, ifaceName, methodName, 0)
}

// FindInterfaceMethodSlot is the exported wrapper over findInterfaceMethod for
// host-driven interface dispatch (interp's CallIfaceMethod): given a module whose
// interface registry covers (ifacePkg, ifaceName) and its parents, it resolves
// methodName to the method's ABSOLUTE vtable slot, or -1 if not found.
func FindInterfaceMethodSlot(m @ir.Module, ifacePkg *[]readonly char, ifaceName *[]readonly char,
		methodName *[]readonly char) int {
	return findInterfaceMethod(m, ifacePkg, ifaceName, methodName)
}

// findInterfaceMethodFromBase walks the recursive vtable structure
// of (ifacePkg, ifaceName), treating `base` as the offset where
// this interface's full vtable starts.  Returns the absolute slot
// index (in the outermost vtable) of the matching method, or -1.
func findInterfaceMethodFromBase(m @ir.Module, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, methodName *[]readonly char, base int) int {
	var idx int = ir.ResolveModuleInterface(m, ifacePkg, ifaceName)
	if idx < 0 { return -1 }
	var mi irsym.ModuleInterface = m.Interfaces[idx]
	// Slots `base` and `base+1` are this interface's any-block (dtor,
	// then *TypeInfo).  Parent sub-vtables follow, then own methods.
	var cursor int = base + 2
	for i := 0; i < len(mi.ParentPkgs); i++ {
		var pSlot int = findInterfaceMethodFromBase(m, mi.ParentPkgs[i], mi.ParentNames[i], methodName,
				cursor)
		if pSlot >= 0 { return pSlot }
		cursor = cursor + ir.IfaceFullVtableSize(m, mi.ParentPkgs[i], mi.ParentNames[i])
	}
	for j := 0; j < len(mi.MethodNames); j++ {
		if irutil.CharEq(mi.MethodNames[j], methodName) {
			return cursor + j
		}
	}
	return -1
}
