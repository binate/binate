package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/types"

// Structural type-identity for a NAME-LESS dynamic type (a slice / array /
// func-value, none of which can carry a nominal name) boxed into a raw `*any`.
// A name-less box keys its weak-coalesced `__ivt` / `__typeinfo` on a reserved
// synthetic receiver name derived purely from the type's STRUCTURE, so distinct
// spellings (`@[]char` vs `*[]int`) get distinct identities and the same
// spelling (across packages / compilation units) coalesces to one survivor.
// This is what a slice-assertion / type-switch target matches against (§11.12
// `iface.assert.slice`); the boxing site (wrapAsIfaceValue) and the match site
// (typeInfoSymFor) both run these helpers so the two symbols are byte-identical.

// isBoxableNamelessType reports whether source pointer `t`'s pointee is one of
// the NAME-LESS types — a slice, array, function value, or pointer — which have
// no nominal `__typeinfo` identity (anyPointeeName is empty) yet an `&x` source
// is still pointer-shaped and can be boxed.  wrapAsIfaceValue routes
// such a value into a RAW `*any` through a reserved STRUCTURAL identity
// (namelessAnySrcName) so the resulting iface value is well-formed (a real
// clean-miss record) rather than a degenerate 1-word box that segfaults on the
// next type-compare.
//
// It looks at the box's pointee only — one pointer level, the one the interface
// value's data word holds — as anyPointeeName (in gen_iface.bn's universe-`any`
// path) does, so the two agree on which sources are name-less: a pointee that is a
// slice, array or function value, or is itself a pointer (`&p` for p a
// `*@[]char`, `&np` for np an `@Node`), has no name and takes the structural path.
// Naming the kinds explicitly (rather than relying on "anyPointeeName was empty")
// keeps the intent clear and stops some OTHER empty-name source (a nil /
// interface / tuple pointee) from being swept into the structural path.
func isBoxableNamelessType(t @types.Type) bool {
	// StripWrappers first so a named-distinct pointer to a nameless pointee
	// (`type NRP *([2]int)` / `type NRA @([2]int)`) — TYP_NAMED — is recognized:
	// the checker admits it into `*any` (StripWrappers), so codegen must route it
	// through the name-less box too, else wrapAsIfaceValue returns a degenerate
	// null-vtable value (present() lies).
	var p @types.Type = types.StripWrappers(t)
	if p == nil || (p.Kind != types.TYP_POINTER && p.Kind != types.TYP_MANAGED_PTR) {
		return false
	}
	var b @types.Type = stripOuterReadonly(p.Elem)
	if b == nil { return false }
	return b.Kind == types.TYP_SLICE || b.Kind == types.TYP_MANAGED_SLICE ||
			b.Kind == types.TYP_ARRAY || b.Kind == types.TYP_FUNC_VALUE ||
			b.Kind == types.TYP_MANAGED_FUNC_VALUE || b.Kind == types.TYP_POINTER ||
			b.Kind == types.TYP_MANAGED_PTR
}

// anyPointeeName is the name a universe-`any` box of the pointer p keys its
// dynamic type on: the pointee's own name (a named type's, a named struct's, a
// primitive's), or empty when the pointee has none — a slice, array or function
// value, or a pointer.  Only the box's own pointer level is peeled (and the
// pointee's outer `readonly`): the dynamic type of `&np` for `np @Node` is
// `@Node`, not `Node`, and keying it on Node's row would let `case *Node:`
// recover the `@Node` cell as a Node, and give that row a destructor for the
// wrong layout — the managed-pointer dtor run on a Node cell once another box
// of a plain `@Node` reuses it.
func anyPointeeName(p @types.Type) @[]char {
	var empty @[]char
	if p == nil { return empty }
	var e @types.Type = stripOuterReadonly(p.Elem)
	if e == nil || e.Kind == types.TYP_POINTER || e.Kind == types.TYP_MANAGED_PTR {
		return empty
	}
	return irutil.ReceiverBaseTypeName(e)
}

// stripOuterReadonly returns t without its outer `readonly` — peeling transparent
// aliases, which can hide one (`type RO = readonly @[]char`) — so element
// `readonly` inside is untouched.  A boxed value's dynamic type is its type with
// the outer `readonly` stripped (§11.12 iface.assert).
func stripOuterReadonly(t @types.Type) @types.Type {
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else {
			t = t.Elem
		}
	}
	return t
}

// mergeQualifiedReadonly returns a type with `qualified`'s structure and its
// fully-qualified named leaves, but with `ro`'s element-`readonly` wrappers
// re-inserted.  It reconciles the two element types a name-less box has to work
// with: `qualified` is the IR type (val.Typ.Elem) — package-qualified named
// leaves, but `readonly` stripped by StripConstForIR (ir.bn:164); `ro` is the
// checker type (srcExprTyp.Elem) — preserves `readonly`, but its named leaves are
// UNqualified / package-dropped.  A name-less box's structural identity
// (mangleTypeArg) must carry BOTH — else `@[]readonly char` loses its `r` tag OR
// `@[]main.Point` / `@[]time.Point` collide / diverge from the match side
// (typeInfoSymFor uses resolveTypeExpr, which has both).
//
// The two are the same type modulo `readonly` (`qualified` == StripConstForIR of
// `ro`'s source), so a parallel walk aligns: peel a `readonly` on the `ro` side
// and re-wrap it around the recursion; otherwise recurse the matching composite
// structure taking `qualified`'s kind and (qualified) leaf.  If `ro` runs out
// (nil) the result degrades to `qualified` (qualified-correct, only losing a
// `readonly` that a misalignment would imply — which cannot happen for a
// StripConstForIR/source pair).
func mergeQualifiedReadonly(qualified @types.Type, ro @types.Type) @types.Type {
	// Peel a transparent alias on the `ro` side FIRST, mirroring StripConstForIR
	// (which resolved aliases AND stripped readonly on the `qualified` side).  An
	// alias can HIDE a `readonly` (`type Foo = readonly T`): if left opaque, the
	// walk never sees the inner readonly and the box silently drops it — a
	// write-through-readonly hole (a `@[]Foo` box would match `case @[]T:`).
	// Resolving the alias here surfaces the readonly so the box identity matches
	// the target side (resolveTypeExpr, which also resolves aliases).
	for ro != nil && ro.Kind == types.TYP_ALIAS {
		ro = ro.Target
	}
	if ro != nil && ro.Kind == types.TYP_READONLY {
		return types.MakeReadonlyType(mergeQualifiedReadonly(qualified, ro.Elem))
	}
	if qualified == nil {
		return qualified
	}
	var roElem @types.Type = nil
	if ro != nil {
		roElem = ro.Elem
	}
	if qualified.Kind == types.TYP_POINTER {
		return types.MakePointerType(mergeQualifiedReadonly(qualified.Elem, roElem))
	}
	if qualified.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(mergeQualifiedReadonly(qualified.Elem, roElem))
	}
	if qualified.Kind == types.TYP_SLICE {
		return types.MakeSliceType(mergeQualifiedReadonly(qualified.Elem, roElem))
	}
	if qualified.Kind == types.TYP_MANAGED_SLICE {
		return types.MakeManagedSliceType(mergeQualifiedReadonly(qualified.Elem, roElem))
	}
	if qualified.Kind == types.TYP_ARRAY {
		return types.MakeArrayType(mergeQualifiedReadonly(qualified.Elem, roElem), qualified.ArrayLen)
	}
	// Named / primitive / function leaf: keep `qualified` (the fully-qualified form).
	return qualified
}

// bindTypeParams returns t with each type parameter it reaches through pointer,
// slice, array and `readonly` structure replaced by the type argument the body
// being emitted binds it to: a parameter owned by gc.CurrentTypeParamOwner takes
// the argument at its index (the checker's own identity for a type parameter).
// IR-gen emits an instantiated generic body with the checker types recorded for
// the generic definition, so a box source typed `T` or `*T` would otherwise lose
// the type argument's element-`readonly` (and a bare `T` would have no pointee at
// all).  The names cannot be used instead: a generic type's methods share one
// checker instance per argument list, whose binder names come from whichever
// method was checked first (`Pair[V, K]` vs `Pair[K, V]`, a blank `_`).  Other
// kinds are returned unchanged: mergeQualifiedReadonly takes every leaf from the
// IR type.
func bindTypeParams(gc @GenCtx, t @types.Type) @types.Type {
	if t == nil || gc.CurrentTypeParamOwner == nil {
		return t
	}
	if t.Kind == types.TYP_TYPE_PARAM {
		if t.TpOwner == gc.CurrentTypeParamOwner && t.TpIndex >= 0 &&
				t.TpIndex < len(gc.CurrentTypeParamArgs) {
			return gc.CurrentTypeParamArgs[t.TpIndex]
		}
		return t
	}
	if t.Kind == types.TYP_READONLY {
		return types.MakeReadonlyType(bindTypeParams(gc, t.Elem))
	}
	if t.Kind == types.TYP_POINTER {
		return types.MakePointerType(bindTypeParams(gc, t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		return types.MakeManagedPtrType(bindTypeParams(gc, t.Elem))
	}
	if t.Kind == types.TYP_SLICE {
		return types.MakeSliceType(bindTypeParams(gc, t.Elem))
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		return types.MakeManagedSliceType(bindTypeParams(gc, t.Elem))
	}
	if t.Kind == types.TYP_ARRAY {
		return types.MakeArrayType(bindTypeParams(gc, t.Elem), t.ArrayLen)
	}
	return t
}
