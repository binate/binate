package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/types"

// Raw-origin variants of named dynamic types (iface.assert.origin).  A box
// records whether it was made from a managed pointer -- an `@T` source, `box(v)`
// -- or from a raw one -- a `*T` source, `&v`, the implicit borrow of a variable.
// A box made from a raw pointer carries T's raw-origin variant
// (irutil.RawVariantName), whose rows come only from the impls a raw pointer can
// supply (implAdmitsRawObject); its dynamic type is still T, whose record the
// variant's names and reflect.TypeOf returns (emitReflectTypeOf).  An interface-target
// assertion on it misses a J whose impl takes `@T`, since that impl's methods
// would take a reference the object -- perhaps on the stack, with no reference
// count -- cannot give.  A concrete target ignores the origin: `.(*T)` matches a
// box of a T made either way, since it compares the box's canonical record
// (emitTypeInfoMismatch).  The rows are made as the readonly variants' are
// (gen_iface_variants.bn).

// hasRawVariant reports whether a box of the dynamic type t (a box's pointee, an
// assertion target's base) records its origin: t is a struct or another declared
// named type.  A predeclared type's impls -- pkg/builtins/lang's alone
// (iface.canonical.carveout) -- all take value receivers, which a box made from a
// raw pointer supplies as well (collectImplsFromDecl fails loud on one that does
// not), so its boxes need no record of their origin.
func hasRawVariant(t @types.Type) bool {
	var u @types.Type = types.ResolveAliasAndConst(t)
	return u != nil && (u.Kind == types.TYP_STRUCT || u.Kind == types.TYP_NAMED)
}

// implAdmitsRawObject reports whether an impl with receiver type rt (the impl's
// receiver type expression, resolved) can be supplied from a box made from a raw
// pointer, so its rows get raw-origin variants: any receiver but a managed
// pointer (`@T`, `@readonly T`), whose methods take a reference the object may
// not have.  A value receiver is supplied by copying the object.
func implAdmitsRawObject(rt @types.Type) bool {
	var t @types.Type = rt
	for t != nil && (t.Kind == types.TYP_ALIAS || t.Kind == types.TYP_READONLY) {
		if t.Kind == types.TYP_ALIAS {
			t = t.Target
		} else {
			t = t.Elem
		}
	}
	return t != nil && t.Kind != types.TYP_MANAGED_PTR
}

// genericImplAdmitsRawObject is implAdmitsRawObject for a parameterized impl's
// receiver (`*Box[T]`), read off its syntax as genericImplAdmitsReadonlyObject
// reads it.
func genericImplAdmitsRawObject(te @ast.TypeExpr) bool {
	var t @ast.TypeExpr = peelTypeExprParens(te)
	if t != nil && t.Kind == ast.TEXPR_CONST {
		t = peelTypeExprParens(t.Base)
	}
	return t != nil && t.Kind != ast.TEXPR_MANAGED
}

// boxVariantName is the receiver identity a box carries: recvName's
// raw-origin variant when the box is made from a raw pointer (srcPtrTyp, the
// source's IR pointer type, is `*T`) to a type whose boxes record their origin
// (hasRawVariant); then the readonly variant of that name when the boxed object
// is readonly (boxReadonlyVariantName).  A name-less identity has no variant.
func boxVariantName(ctx @GenContext, recvName @[]char, srcPtrTyp @types.Type,
		srcExprTyp @types.Type) @[]char {
	var name @[]char = recvName
	if srcPtrTyp != nil && srcPtrTyp.Kind == types.TYP_POINTER &&
			!irutil.IsNamelessRecvName(recvName) && hasRawVariant(srcPtrTyp.Elem) {
		name = irutil.RawVariantName(recvName)
	}
	return boxReadonlyVariantName(ctx, name, srcExprTyp)
}
