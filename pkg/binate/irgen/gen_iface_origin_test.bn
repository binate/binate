package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/mangle"
import "pkg/builtins/testing"

// Raw-origin variants (gen_iface_origin.bn): the rows an impl gets, the vtable a
// box takes by its origin, and the records an assertion target compares against.

func rawOriginSrc() *[]readonly char {
	return "package \"test\"\n"
			"interface G { get() int }\n"
			"interface M { put() int }\n"
			"interface R { look() int }\n"
			"type T struct { x int }\n"
			"func (t *T) get() int { return t.x }\n"
			"func (t @T) put() int { return t.x }\n"
			"func (t *readonly T) look() int { return t.x }\n"
			"impl *T : G\n"
			"impl @T : M\n"
			"impl *readonly T : R\n"
			"type V struct { x int }\n"
			"func (v V) get() int { return v.x }\n"
			"impl V : G\n"
			"type B[U any] struct { u U }\n"
			"func (b *B[U]) get() int { return 1 }\n"
			"func (b @B[U]) put() int { return 2 }\n"
			"impl *B[U] : G\n"
			"impl @B[U] : M\n"
			"func boxRaw(t *T) *G { return t }\n"
			"func boxMgd(t @T) *G { return t }\n"
			"func boxRawAny(t *T) *any { return t }\n"
			"func boxMgdAny(t @T) @any { return t }\n"
			"func boxInt(p *int) *any { return p }\n"
			"func boxB(b *B[int]) *any { return b }\n"
			"func mut(x *any) *T { return x.(*T) }\n"
			"func mgd(x @any) @T { return x.(@T) }\n"
			"func ro(x *any) *readonly T { return x.(*readonly T) }\n"
			"func val(x *any) T { return x.(T) }\n"
}

// An impl for a predeclared type (pkg/builtins/lang's alone) gives no raw-origin
// rows: a box of such a type records no origin (hasRawVariant).
func TestRawVariantRowsPredeclared() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(
			"package \"pkg/builtins/lang\"\n"
					"interface Sz { sz() int }\n"
					"func (x int) sz() int { return x }\n"
					"impl int : Sz\n")
	if !hasImplRow(m, "int", "Sz") {
		return fail("`impl int : Sz` should give int's row")
	}
	if hasImplRow(m, "__raw_int", "Sz") {
		return fail("a predeclared type should get no raw-origin row")
	}
	return ""
}

// An impl a raw pointer can supply (`*T`, `*readonly T`, a value receiver) gives
// its rows raw-origin variants, the readonly one too for a readonly receiver; an
// `@T` impl gives none -- for a generic receiver as well.
func TestRawVariantRows() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(rawOriginSrc())
	if !hasImplRow(m, "__raw_T", "G") || !hasImplRow(m, "__raw_V", "G") {
		return fail("`impl *T : G` and `impl V : G` should give raw-origin rows")
	}
	if hasImplRow(m, "__raw_T", "M") || !hasImplRow(m, "T", "M") {
		return fail("`impl @T : M` should give T's row and no raw-origin one")
	}
	if !hasImplRow(m, "__raw_T", "R") || !hasImplRow(m, "__readonly___raw_T", "R") {
		return fail("`impl *readonly T : R` should give the raw-origin row and its readonly variant")
	}
	if hasImplRow(m, "__readonly___raw_T", "G") {
		return fail("`impl *T : G` (mutable receiver) must give no readonly raw-origin row")
	}
	var rawG bool = false
	for i := 0; i < len(m.Impls); i++ {
		var info @irdata.ImplInfo = m.Impls[i]
		if !irutil.IsRawVariantName(info.RecvTypeName) ||
				!nameIsGenericInst(irutil.VariantBase(info.RecvTypeName)) {
			continue
		}
		if charsEqual(info.IfaceName, "M") {
			return fail("`impl @B[U] : M` must give a boxed B[int] no raw-origin row")
		}
		if charsEqual(info.IfaceName, "G") { rawG = true }
	}
	if !rawG { return fail("a B[int] boxed from a raw pointer should get the raw-origin G row") }
	return ""
}

// A box made from a raw pointer takes the raw-origin variant's vtable, one made
// from a managed pointer T's own; a predeclared type's box has no variant.
func TestRawBoxVtable() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(rawOriginSrc())
	var raw @ir.Func = assertNamedFunc(m, "test.boxRaw")
	var mgd @ir.Func = assertNamedFunc(m, "test.boxMgd")
	if raw == nil || mgd == nil { return fail("box funcs not found") }
	if !funcNamesSym(raw, mangle.ImplVtableName("test", "__raw_T", "test", "G")) {
		return fail("a box made from a raw pointer should take the raw-origin variant's vtable")
	}
	if !funcNamesSym(mgd, mangle.ImplVtableName("test", "T", "test", "G")) {
		return fail("a box made from a managed pointer should take T's vtable")
	}
	if !hasImplRow(m, "__raw_T", "any") || !hasImplRow(m, "T", "any") {
		return fail("raw and managed boxes into any should take the raw-origin and T's any rows")
	}
	for i := 0; i < len(m.Impls); i++ {
		if irutil.IsRawVariantName(m.Impls[i].RecvTypeName) &&
				charsEqual(irutil.VariantBase(m.Impls[i].RecvTypeName), "int") {
			return fail("a box of a predeclared type should have no raw-origin variant")
		}
	}
	return ""
}

// A concrete target matches a box made either way: it compares the box's canonical
// record, so no assertion names a raw-origin variant's record -- `.(*T)` and
// `.(@T)` name T's alone, and the targets that may recover a readonly object T's
// readonly variant's too.
func TestRawAssertRecords() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(rawOriginSrc())
	var mu @ir.Func = assertNamedFunc(m, "test.mut")
	var mg @ir.Func = assertNamedFunc(m, "test.mgd")
	var ro @ir.Func = assertNamedFunc(m, "test.ro")
	var vl @ir.Func = assertNamedFunc(m, "test.val")
	if mu == nil || mg == nil || ro == nil || vl == nil { return fail("assert funcs not found") }
	var tiT @[]char = mangle.TypeInfoName("test", "T")
	var tiRaw @[]char = mangle.TypeInfoName("test", "__raw_T")
	var tiRo @[]char = mangle.TypeInfoName("test", "__readonly_T")
	var tiRoRaw @[]char = mangle.TypeInfoName("test", "__readonly___raw_T")
	if !funcNamesSym(mu, tiT) || funcNamesSym(mu, tiRo) || funcNamesSym(mu, tiRaw) ||
			funcNamesSym(mu, tiRoRaw) {
		return fail("`.(*T)` should compare against T's record alone")
	}
	if !funcNamesSym(mg, tiT) || funcNamesSym(mg, tiRo) || funcNamesSym(mg, tiRaw) {
		return fail("`.(@T)` should compare against T's record alone")
	}
	if !funcNamesSym(ro, tiT) || !funcNamesSym(ro, tiRo) || funcNamesSym(ro, tiRaw) ||
			funcNamesSym(ro, tiRoRaw) {
		return fail("`.(*readonly T)` should compare against T's and its readonly variant's")
	}
	if !funcNamesSym(vl, tiT) || !funcNamesSym(vl, tiRo) || funcNamesSym(vl, tiRaw) ||
			funcNamesSym(vl, tiRoRaw) {
		return fail("`.(T)` should compare against T's and its readonly variant's")
	}
	if !readsCanonicalWord(mu) || !readsCanonicalWord(vl) {
		return fail("a concrete assertion should compare the box's canonical record")
	}
	return ""
}

// readsCanonicalWord reports whether fn reads the canonical word of a record it
// read out of a vtable's slot 1.
func readsCanonicalWord(fn @ir.Func) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_GET_ELEM_PTR && ins.Args[0].Op == iropcode.OP_IFACE_TYPEINFO &&
					ins.Args[1].Op == iropcode.OP_CONST_INT &&
					ins.Args[1].IntVal == cast(int64, irdata.TYPEINFO_CANONICAL_WORD) {
				return true
			}
		}
	}
	return false
}
