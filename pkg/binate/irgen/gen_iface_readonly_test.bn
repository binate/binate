package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/mangle"
import "pkg/builtins/testing"

// Readonly variants of named dynamic types (gen_iface_readonly.bn): the rows an
// impl gets, the vtable a readonly box takes, and the records an assertion
// target compares against.

func readonlyVariantSrc() *[]readonly char {
	return "package \"test\"\n"
			"interface G { get() int }\n"
			"interface GS : G { get2() int }\n"
			"interface P { put(v int) }\n"
			"type T struct { x int }\n"
			"func (t *readonly T) get() int { return t.x }\n"
			"func (t *readonly T) get2() int { return t.x }\n"
			"func (t *T) put(v int) { t.x = v }\n"
			"impl *readonly T : GS\n"
			"impl *T : P\n"
			"type V struct { x int }\n"
			"func (v readonly V) get() int { return v.x }\n"
			"impl readonly V : G\n"
			"type W struct { x int }\n"
			"func (w W) get() int { return w.x }\n"
			"impl W : G\n"
			"func boxRo(c *readonly T) *G { return c }\n"
			"func boxMut(c *T) *G { return c }\n"
			"func mut(x *any) *T { return x.(*T) }\n"
			"func ro(x *any) *readonly T { return x.(*readonly T) }\n"
			"func val(x *any) T { return x.(T) }\n"
}

// hasImplRow reports whether m has the (recvName, ifaceName) impl row.
func hasImplRow(m @ir.Module, recvName *[]readonly char, ifaceName *[]readonly char) bool {
	return implRow(m, recvName, ifaceName) != nil
}

// A read-only-receiver impl (`*readonly T`, `readonly V`) gets readonly variant
// rows, its ancestors' included, sharing the base row's methods; a mutable- or
// plain-value-receiver impl (`*T`, `W`) does not.
func TestReadonlyVariantRows() testing.TestResult {
	var m @ir.Module = genCheckedPkg(readonlyVariantSrc())
	if !hasImplRow(m, "__readonly_T", "GS") || !hasImplRow(m, "__readonly_T", "G") {
		return fail("`impl *readonly T : GS` should give the variant GS and ancestor G rows")
	}
	if hasImplRow(m, "__readonly_T", "P") {
		return fail("`impl *T : P` (mutable receiver) must give no variant row")
	}
	if !hasImplRow(m, "__readonly_V", "G") {
		return fail("`impl readonly V : G` should give a variant row")
	}
	if hasImplRow(m, "__readonly_W", "G") {
		return fail("`impl W : G` (a value receiver that is not readonly) must give no variant row")
	}
	var base @irdata.ImplInfo = implRow(m, "T", "GS")
	var ro @irdata.ImplInfo = implRow(m, "__readonly_T", "GS")
	if len(ro.MethodFuncs) != len(base.MethodFuncs) || len(ro.MethodFuncs) == 0 {
		return fail("the variant row should have T's method slots")
	}
	for i := 0; i < len(ro.MethodFuncs); i++ {
		if !charsEqualOpt(ro.MethodFuncs[i], base.MethodFuncs[i]) {
			return fail("the variant row should share T's method functions")
		}
	}
	return ""
}

// implRow returns m's (recvName, ifaceName) impl row, or nil.
func implRow(m @ir.Module, recvName *[]readonly char, ifaceName *[]readonly char) @irdata.ImplInfo {
	for i := 0; i < len(m.Impls); i++ {
		var info @irdata.ImplInfo = m.Impls[i]
		if charsEqualOpt(info.RecvTypeName, recvName) && charsEqualOpt(info.IfaceName, ifaceName) {
			return info
		}
	}
	return nil
}

// A box of a read-only object takes the variant's vtable; a mutable one T's.
func TestReadonlyBoxVtable() testing.TestResult {
	var m @ir.Module = genCheckedPkg(readonlyVariantSrc())
	var ro @ir.Func = assertNamedFunc(m, "test.boxRo")
	var mu @ir.Func = assertNamedFunc(m, "test.boxMut")
	if ro == nil || mu == nil { return fail("box funcs not found") }
	if !funcNamesSym(ro, mangle.ImplVtableName("test", "__readonly_T", "test", "G")) {
		return fail("a readonly box should take the variant's vtable")
	}
	if !funcNamesSym(mu, mangle.ImplVtableName("test", "T", "test", "G")) {
		return fail("a mutable box should take T's vtable")
	}
	return ""
}

// funcNamesSym reports whether an instruction of fn names the symbol sym (a
// vtable an interface value is built with, a record an assertion compares).
func funcNamesSym(fn @ir.Func, sym *[]readonly char) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var b @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			if charsEqualOpt(b.Instrs[ii].StrVal, sym) { return true }
		}
	}
	return false
}

// A mutable target compares against T's record only; a readonly target and a
// value copy against T's and the variant's.
func TestReadonlyAssertRecords() testing.TestResult {
	var m @ir.Module = genCheckedPkg(readonlyVariantSrc())
	var mu @ir.Func = assertNamedFunc(m, "test.mut")
	var ro @ir.Func = assertNamedFunc(m, "test.ro")
	var val @ir.Func = assertNamedFunc(m, "test.val")
	if mu == nil || ro == nil || val == nil { return fail("assert funcs not found") }
	var tiT @[]char = mangle.TypeInfoName("test", "T")
	var tiRo @[]char = mangle.TypeInfoName("test", "__readonly_T")
	if !funcNamesSym(mu, tiT) || funcNamesSym(mu, tiRo) {
		return fail("`.(*T)` should compare against T's record only")
	}
	if !funcNamesSym(ro, tiT) || !funcNamesSym(ro, tiRo) {
		return fail("`.(*readonly T)` should compare against both records")
	}
	if !funcNamesSym(val, tiT) || !funcNamesSym(val, tiRo) {
		return fail("`.(T)` should compare against both records")
	}
	return ""
}
