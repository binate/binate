package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iriface"
import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Module-local interface registry: name → ordered method-name
// list, plus alias / parent metadata.  Built up
// during GeneratePackage / GenModule's first pass via
// collectInterfaceFromDecl; consumed by impl-collection
// (gen_impl.bn) and the use-site dispatch helpers
// (gen_iface.bn, gen_iface_extends.bn).

// (irsym.ModuleInterface — the registry entry type — and the @Module.Interfaces
// field that holds the registry live in ir.bni, so the exported @Module
// carries them and the backends can read interface metadata.)

// collectInterfaceFromDecl records a DECL_INTERFACE's method names
// (in source order — matches the slot ordering codegen uses for
// the vtable global). Alias forms (`interface X = Y`) record the
// target name only; methods are read via alias-following lookups
// (lookupModuleInterface / findInterfaceMethod). pkgPath is the full
// import path of the package declaring this interface — its identity.
func collectInterfaceFromDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}
	// Generic interface decls (TypeParams non-empty): stash the
	// AST decl in gc.GenericIfaceDecls, where a mapping of an instance
	// finds it (stashedGenericDecl) to instantiate it
	// (ensureInstantiatedInterface).
	// Each instantiation needs its own irsym.ModuleInterface with
	// substituted parents — that happens lazily.  Registering the
	// bare generic decl under the source-text name with unresolved
	// T-typed parents would create stale data that downstream
	// vtable / impl-satisfaction passes would mis-interpret.
	if len(d.TypeParams) > 0 {
		stashGenericIfaceDecl(gc, d, pkgPath)
		return
	}
	// pkgPath is the declaring package's full path, so the interface
	// identity matches full-path use-site references and the vtable
	// mangling (full-path mangling — see pkg/binate/mangle).
	var rpkg @[]char = buf.CopyStr(pkgPath)
	// An interface is collected once: a complete entry (another registration
	// pass reaching the same package) is kept; an identity stub
	// (registerIfaceStub) is filled in place below.
	var name @[]char = declaredTypeName(gc, d)
	var existing int = iriface.LookupModuleInterfaceIndex(gc.Mod, rpkg, name)
	if existing >= 0 && !gc.Mod.Interfaces[existing].IsStub { return }
	var mi irsym.ModuleInterface
	mi.Pkg = buf.CopyStr(rpkg)
	mi.Name = name
	if d.IsAlias {
		// Interface alias: the target the checker resolved it to
		// (ifaceAliasTarget).  A named interface is taken by its (Pkg, Name),
		// registered or not yet (a later declaration's stub may not be, as this
		// alias is collected in the stub pass); an instance of a generic
		// interface is instantiated (typeFromRecord) here, where its stub
		// completes.
		var target @types.Type = ifaceAliasTarget(gc, d)
		if target.InstDecl == nil {
			mi.AliasTargetPkg = buf.CopyStr(unquotePkg(target.Pkg))
			mi.AliasTarget = buf.CopyStr(target.Name)
		} else {
			var inst @types.Type = typeFromRecord(gc, target)
			mi.AliasTargetPkg = buf.CopyStr(inst.Pkg)
			mi.AliasTarget = buf.CopyStr(inst.Name)
		}
		if existing >= 0 {
			noteReplacedIface(gc, existing)
			gc.Mod.Interfaces[existing] = mi
		} else {
			gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](gc.Mod.Interfaces, mi)
		}
		return
	}
	// Register this interface's identity (Pkg + Name) in the registry
	// BEFORE resolving its parents.  An instantiated parent whose type
	// argument names this very interface (`interface A : G[*A]`) maps that
	// argument (typeFromRecord), which requires `A` to be registered
	// (requireRegisteredIface).  The fully-populated entry overwrites this stub
	// (or the one registerIfaceStub left) at the end.
	var selfIdx int = existing
	if selfIdx < 0 {
		selfIdx = len(gc.Mod.Interfaces)
		gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](
				gc.Mod.Interfaces, mi)
	}
	// The method names and the parents, in declaration order, come from the
	// checker's interface type for d (declaredTypeRecord): its own methods, and
	// the interfaces it extends (ifaceParentKeys).
	var rec @types.Type = declaredTypeRecord(gc, d)
	if rec.Kind != types.TYP_INTERFACE { notAnInterfaceICE("an interface declaration", d.Pos) }
	for i := 0; i < len(rec.Methods); i++ {
		mi.MethodNames = slices.Append[@[]char](mi.MethodNames, buf.CopyStr(rec.Methods[i].Name))
	}
	mi.ParentPkgs, mi.ParentNames = ifaceParentKeys(gc, rec, d)
	// Overwrite the identity stub appended above with the now-complete
	// entry (method names, parents).
	noteReplacedIface(gc, selfIdx)
	gc.Mod.Interfaces[selfIdx] = mi
}

// ifaceParentKeys returns, in parallel arrays, the (package, name) keys of the
// interfaces the checker's interface t, declared by d, extends (t.Parents, in
// declaration order), leaving out the universe `any` (isUniverseAnyKey): each
// mapped as a record is, an instance of a generic interface (`: Container[int]`)
// under its mangled name.
func ifaceParentKeys(gc @GenCtx, t @types.Type, d @ast.Decl) (@[]@[]char, @[]@[]char) {
	var parentPkgs @[]@[]char
	var parentNames @[]@[]char
	for i := 0; i < len(t.Parents); i++ {
		var p @types.Type = requireConcreteRecord(gc, t.Parents[i], d.Pos, "an interface's parent")
		if p.Kind != types.TYP_INTERFACE { notAnInterfaceICE("an interface's parent", d.Pos) }
		var it @types.Type = typeFromRecord(gc, p)
		if isUniverseAnyKey(it.Pkg, it.Name) { continue }
		parentPkgs = slices.Append[@[]char](parentPkgs, buf.CopyStr(it.Pkg))
		parentNames = slices.Append[@[]char](parentNames, buf.CopyStr(it.Name))
	}
	return parentPkgs, parentNames
}

// collectInterfaceParents resolves d's extension clause (d.Interfaces)
// to parallel (pkg, name) arrays for irsym.ModuleInterface.ParentPkgs /
// ParentNames, in declaration order, leaving out the universe `any`
// (isUniverseAnyKey): each parent is the interface the
// checker resolved it to (ifaceRefKey) -- an instance of a generic
// interface (`: Container[int]`) under its mangled name, so the
// concat-vtable layout and the ancestor-closure walk in
// collectImplsFromDecl reach the right (R, I) pair.  An instance of a generic
// interface passes the checker's copy for the instance, whose parents' records are
// concrete (`Container[int]` inside `WideBox[int]`).
func collectInterfaceParents(gc @GenCtx, d @ast.Decl) (@[]@[]char, @[]@[]char) {
	var parentPkgs @[]@[]char
	var parentNames @[]@[]char
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var parentPkg @[]char
		var parentName @[]char
		parentPkg, parentName = ifaceRefKey(gc, ref, "an interface's parent")
		if isUniverseAnyKey(parentPkg, parentName) { continue }
		parentPkgs = slices.Append[@[]char](parentPkgs, parentPkg)
		parentNames = slices.Append[@[]char](parentNames, parentName)
	}
	return parentPkgs, parentNames
}

// IfaceMethodCount returns the number of methods declared on the
// interface identified by canonical (pkg, name), following alias
// chains. Returns 0 if the interface isn't registered. Used by
// codegen to size the array type when declaring an
// imported vtable as `external constant [N+1 x i8*]`.
func IfaceMethodCount(m @ir.Module, pkg *[]readonly char, name *[]readonly char) int {
	return len(iriface.LookupModuleInterface(m, pkg, name))
}

// stashGenericIfaceDecl records the generic interface decl d (declared in
// pkgPath) for use sites (ensureInstantiatedInterface) and parent / impl
// resolution to instantiate; a decl already stashed under (pkgPath, name) is
// not recorded again.
func stashGenericIfaceDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char) {
	if lookupGenericIfaceDeclPkg(gc, pkgPath, d.Name) != nil { return }
	gc.GenericIfaceDecls = slices.Append[@ast.Decl](gc.GenericIfaceDecls, d)
	gc.GenericIfaceDeclPkgs = slices.Append[@[]char](gc.GenericIfaceDeclPkgs, buf.CopyStr(pkgPath))
}

// stashGenericIfaceDecls stashes every generic interface decl of file (declared
// in pkgPath) — run before any of the file's interfaces is collected, because an
// interface may name a generic parent declared after it (`interface Sub :
// Base[int]` before `interface Base[T any]`, which declaration order permits)
// and the parent's mapping (ifaceParentKeys) instantiates it from the stash.
func stashGenericIfaceDecls(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_INTERFACE && len(d.TypeParams) > 0 {
			stashGenericIfaceDecl(gc, d, pkgPath)
		}
	}
}

// registerIfaceStub registers the identity of the non-generic interface d
// (declared in pkgPath) before any type expression of its package is resolved:
// a type alias, global or field typed through an interface declared later — or,
// across packages, registered by a later pass (`var g *I` / `type P = *I`) —
// then resolves to the interface rather than missing the registry.
// collectInterfaceFromDecl fills the stub in place.  An alias of a named
// interface needs only its target, so it is collected whole; an alias of a
// generic instantiation (`interface X = G[int]`, also through another alias:
// `interface Z = X`, aliasOfInstance) gets a stub too — its target is
// instantiated when it is collected, after the package's type aliases are
// registered and its generic is stashed, since instantiating resolves the type
// arguments and the generic's parents, and the instance is cached for every use
// of it.
func registerIfaceStub(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char) {
	if d.Kind != ast.DECL_INTERFACE || len(d.TypeParams) > 0 { return }
	var name @[]char = declaredTypeName(gc, d)
	if iriface.LookupModuleInterfaceIndex(gc.Mod, pkgPath, name) >= 0 { return }
	if d.IsAlias && !aliasOfInstance(gc, d) {
		collectInterfaceFromDecl(gc, d, pkgPath)
		return
	}
	var mi irsym.ModuleInterface
	mi.Pkg = buf.CopyStr(pkgPath)
	mi.Name = name
	mi.IsStub = true
	gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](gc.Mod.Interfaces, mi)
	if d.IsAlias {
		gc.PendingIfaceAliasDecls = slices.Append[@ast.Decl](gc.PendingIfaceAliasDecls, d)
		gc.PendingIfaceAliasPkgs = slices.Append[@[]char](gc.PendingIfaceAliasPkgs, buf.CopyStr(pkgPath))
		gc.PendingIfaceAliasDone = slices.Append[bool](gc.PendingIfaceAliasDone, false)
	}
}

// aliasOfInstance reports whether the interface alias d targets an instance of a
// generic interface: written as one (`interface X = G[int]`), or so resolved by
// the checker through another alias (`interface Z = X`, its record the instance).
func aliasOfInstance(gc @GenCtx, d @ast.Decl) bool {
	return ifaceAliasTarget(gc, d).InstDecl != nil
}

// ifaceAliasTarget returns the interface the alias d names, as the checker resolved
// it: the declaration's record, an alias's own target already followed.  No record,
// an abstract one or one that is no interface is an internal error.
func ifaceAliasTarget(gc @GenCtx, d @ast.Decl) @types.Type {
	var rec @types.Type
	if d.ResolvedTypeID != 0 { rec = gc.Mod.Checker.ExprType(d.ResolvedTypeID) }
	if rec == nil { noTypeRecordICE(d.Pos) }
	rec = requireConcreteRecord(gc, rec, d.Pos, "an interface alias's target")
	if rec.Kind != types.TYP_INTERFACE { notAnInterfaceICE("an interface alias's target", d.Pos) }
	return rec
}

// completeIfaceAliasStub completes the pending alias-of-instantiation stub
// (pkg, name), if any: collects its declaration now.  Completing on first use
// instead of at registration keeps an unused alias from instantiating its target
// before the package's type aliases are registered; a use instantiates exactly
// what spelling the target there would.  An alias already completed, or being
// completed (a cycle), is left as it is.
func completeIfaceAliasStub(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) {
	for i := 0; i < len(gc.PendingIfaceAliasDecls); i++ {
		if gc.PendingIfaceAliasDone[i] { continue }
		var d @ast.Decl = gc.PendingIfaceAliasDecls[i]
		if !irutil.Streq(d.Name, name) || !irutil.Streq(gc.PendingIfaceAliasPkgs[i], pkg) { continue }
		gc.PendingIfaceAliasDone[i] = true
		collectInterfaceFromDecl(gc, d, gc.PendingIfaceAliasPkgs[i])
		return
	}
}

// registerIfaceStubs runs registerIfaceStub over file's declarations.
func registerIfaceStubs(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_INTERFACE { continue }
		registerIfaceStub(gc, d, pkgPath)
	}
}
