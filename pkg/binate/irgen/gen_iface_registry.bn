package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Module-local interface registry: name → ordered method-name
// list, plus result-type / alias / parent metadata.  Built up
// during GeneratePackage / GenModule's first pass via
// collectInterfaceFromDecl; consumed by impl-collection
// (gen_impl.bn) and the use-site dispatch helpers
// (gen_iface.bn, gen_iface_extends.bn).

// (irsym.ModuleInterface — the registry entry type — and the @Module.Interfaces
// field that holds the registry live in ir.bni, so the exported @Module
// carries them and the backends can read interface metadata.)

// collectInterfaceFromDecl records a DECL_INTERFACE's method names
// (in source order — matches the slot ordering codegen uses for
// the vtable global). Alias forms (`interface X = Y`) record the
// target name only; methods are read via alias-following lookups
// (lookupModuleInterface / findInterfaceMethod). pkgPath is the full
// import path of the package declaring this interface — its identity,
// used as is (never resolved through the alias map).  file is the AST file the
// decl was parsed from — recorded alongside a stashed generic decl so
// ensureInstantiatedInterface can resolve the deferred method
// signatures against the generic's own imports (see genericIfaceDeclFiles).
func collectInterfaceFromDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char, file @ast.File) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}
	// Generic interface decls (TypeParams non-empty): stash the
	// AST decl in gc.GenericIfaceDecls for use sites
	// (ensureInstantiatedInterface) and impl-collection
	// (collectImplsFromDecl's TEXPR_INSTANTIATE branch) to find.
	// Each instantiation needs its own irsym.ModuleInterface with
	// substituted method types — that happens lazily.  Registering
	// the bare generic decl under the source-text name with
	// unresolved T-typed methods would create stale data that
	// downstream vtable / impl-satisfaction passes would
	// mis-interpret.
	if len(d.TypeParams) > 0 {
		stashGenericIfaceDecl(gc, d, pkgPath, file)
		return
	}
	// pkgPath is the declaring package's full path, so the interface
	// identity matches full-path use-site references and the vtable
	// mangling (full-path mangling — see pkg/binate/mangle).
	var rpkg @[]char = buf.CopyStr(pkgPath)
	// An interface is collected once: a complete entry (another registration
	// pass reaching the same package) is kept; an identity stub
	// (registerIfaceStub) is filled in place below.
	var existing int = ir.LookupModuleInterfaceIndex(gc.Mod, rpkg, d.Name)
	if existing >= 0 && !gc.Mod.Interfaces[existing].IsStub { return }
	var mi irsym.ModuleInterface
	mi.Pkg = buf.CopyStr(rpkg)
	mi.Name = buf.CopyStr(d.Name)
	if d.IsAlias {
		// Interface alias. Target is a TEXPR_NAMED
		// produced by parseInterfaceRef; copy its Name into
		// AliasTarget so lookups can follow. For cross-package
		// alias targets, also store the target's HOME
		// package (where it is registered, also when reached
		// through an `expose` forwarder); otherwise default to
		// this interface's own package (alias to a same-package
		// iface).
		if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_NAMED {
			mi.AliasTarget = buf.CopyStr(d.TypeRef.Name)
			if len(d.TypeRef.Pkg) > 0 {
				mi.AliasTargetPkg = homedQualifier(gc.Mod, d.TypeRef.Pkg, d.TypeRef.Name)
			} else {
				mi.AliasTargetPkg = buf.CopyStr(rpkg)
			}
		} else if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_INSTANTIATE {
			mi.AliasTargetPkg, mi.AliasTarget = instantiatedAliasTarget(gc, d.TypeRef, rpkg, pkgPath)
		}
		if existing >= 0 {
			gc.Mod.Interfaces[existing] = mi
		} else {
			gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](gc.Mod.Interfaces, mi)
		}
		return
	}
	// Register this interface's identity (Pkg + Name) in the registry
	// BEFORE resolving its method and parent signatures.  A method
	// whose return type is this very interface — a self-reference like
	// `Unwrap() @Error` — resolves that type via resolveTypeExpr →
	// isInterfaceTypeExpr, which consults gc.Mod.Interfaces; with no
	// entry the lookup misses and `@Error` degrades to a managed
	// pointer (MakeManagedPtrType).  The dispatch shim would then carry
	// an `i8*` return while the method body returns a `%BnIfaceValue`,
	// an in-module ABI mismatch.  The fully-populated entry overwrites
	// this stub (or the one registerIfaceStub left) at the end.
	var selfIdx int = existing
	if selfIdx < 0 {
		selfIdx = len(gc.Mod.Interfaces)
		gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](
				gc.Mod.Interfaces, mi)
	}
	// Resolve method and parent signatures with the active-package
	// context pointing at this interface's own package, so a self-
	// referential return type (`Unwrap() @Error`) resolves against the
	// stub above even in the cross-package RegisterAllInterfaces pre-
	// pass — there gc.PkgPath is not yet this package, and
	// isInterfaceTypeExpr / ifaceTypeForName fall back to
	// CurrentImportPkg for a bare name.
	var savedImportPkg @[]char = gc.Mod.CurrentImportPkg
	gc.Mod.CurrentImportPkg = buf.CopyStr(pkgPath)
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC {
			continue
		}
		mi.MethodNames = slices.Append[@[]char](mi.MethodNames, buf.CopyStr(m.Name))
		// Resolve result + param types in the SAME loop (same
		// CurrentImportPkg context, after the self-stub append) so a
		// self-referential result/param type resolves to this interface, not
		// a degraded managed pointer.  Results flattened like params so a
		// 0- or >=2-result method carries all its types.
		for j := 0; j < len(m.Results); j++ {
			mi.MethodResultsFlat = slices.Append[@types.Type](
					mi.MethodResultsFlat, resolveTypeExpr(gc, m.Results[j]))
		}
		mi.MethodResultCounts = slices.Append[int](mi.MethodResultCounts, len(m.Results))
		for j := 0; j < len(m.Params); j++ {
			mi.MethodParamsFlat = slices.Append[@types.Type](
					mi.MethodParamsFlat, irResolveParamType(gc, m.Params[j]))
		}
		mi.MethodParamCounts = slices.Append[int](mi.MethodParamCounts, len(m.Params))
		mi.MethodParamVariadic = slices.Append[bool](mi.MethodParamVariadic, declIsVariadic(m))
	}
	// Record this interface's parents (in declaration order).
	// collectInterfaceParents handles both plain (`: Parent`) and
	// instantiated-generic (`: Container[int]`) parent refs.
	mi.ParentPkgs, mi.ParentNames = collectInterfaceParents(gc, d, rpkg, pkgPath)
	gc.Mod.CurrentImportPkg = savedImportPkg
	// Overwrite the identity stub appended above with the now-complete
	// entry (method names/results, parents).
	gc.Mod.Interfaces[selfIdx] = mi
}

// collectInterfaceParents resolves d's extension clause (d.Interfaces)
// to parallel (pkg, name) arrays for irsym.ModuleInterface.ParentPkgs /
// ParentNames, in declaration order.  Each parent ref is either a
// TEXPR_NAMED (`: Parent` / `: pkg.Parent`) or a TEXPR_INSTANTIATE
// (`: Container[int]`); the latter is instantiated lazily via
// ensureInstantiatedInterface and recorded under its mangled name so
// the concat-vtable layout and the ancestor-closure walk
// in collectImplsFromDecl reach the right (R, I) pair.  rpkg is the
// declaring interface's resolved package (used for same-package parent
// refs); declPkg is the package path same-package generic parent decls
// are stashed under.  Callers set CurrentImportPkg and (for generic
// instantiation) the type-param substitution context before calling, so
// resolveTypeExpr resolves type-args correctly — `Container[T]` inside
// `WideBox[int]` resolves to `Container[int]`.
func collectInterfaceParents(gc @GenCtx, d @ast.Decl, rpkg *[]readonly char,
		declPkg *[]readonly char) (@[]@[]char, @[]@[]char) {
	var parentPkgs @[]@[]char
	var parentNames @[]@[]char
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var parentPkg @[]char
		var parentName @[]char
		if ref.Kind == ast.TEXPR_NAMED {
			// A qualified parent keys on its HOME package, where it is
			// registered (also when reached through an `expose` forwarder).
			if len(ref.Pkg) > 0 {
				parentPkg = homedQualifier(gc.Mod, ref.Pkg, ref.Name)
			} else {
				parentPkg = buf.CopyStr(rpkg)
			}
			parentName = buf.CopyStr(ref.Name)
		} else if ref.Kind == ast.TEXPR_INSTANTIATE {
			// Parent ref may be qualified
			// (`interface Sub : pkg.Container[int]`); look the generic
			// decl up under its HOME package, where it is stashed (also
			// when reached through an `expose` forwarder).
			if ref.Base == nil { continue }
			if ref.Base.Kind != ast.TEXPR_NAMED { continue }
			var lookupPkg @[]char
			if len(ref.Base.Pkg) > 0 {
				lookupPkg = homedQualifier(gc.Mod, ref.Base.Pkg, ref.Base.Name)
			} else {
				lookupPkg = buf.CopyStr(declPkg)
			}
			var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc, lookupPkg, ref.Base.Name)
			if gd == nil { panicGenericIfaceMissing("an interface's parent", lookupPkg, ref.Base.Name) }
			var argTypes @[]@types.Type
			for ai := 0; ai < len(ref.TypeArgs); ai++ {
				argTypes = slices.Append[@types.Type](argTypes, resolveTypeExpr(gc, ref.TypeArgs[ai]))
			}
			parentPkg = buf.CopyStr(lookupPkg)
			parentName = ensureInstantiatedInterface(gc, gd, argTypes, lookupPkg)
		} else {
			continue
		}
		parentPkgs = slices.Append[@[]char](parentPkgs, parentPkg)
		parentNames = slices.Append[@[]char](parentNames, parentName)
	}
	return parentPkgs, parentNames
}

// IfaceMethodCount returns the number of methods declared on the
// interface identified by canonical (pkg, name), following alias
// chains. Returns 0 if the interface isn't registered. Used by
// codegen to size the array type when declaring an
// imported vtable as `external constant [N+1 x i8*]`.
func IfaceMethodCount(m @ir.Module, pkg *[]readonly char, name *[]readonly char) int {
	return len(ir.LookupModuleInterface(m, pkg, name))
}

// stashGenericIfaceDecl records the generic interface decl d (declared in
// pkgPath, parsed from file) for use sites (ensureInstantiatedInterface) and
// parent / impl resolution to instantiate; a decl already stashed under
// (pkgPath, name) is not recorded again.
func stashGenericIfaceDecl(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char, file @ast.File) {
	if lookupGenericIfaceDeclPkg(gc, pkgPath, d.Name) != nil { return }
	gc.GenericIfaceDecls = slices.Append[@ast.Decl](gc.GenericIfaceDecls, d)
	gc.GenericIfaceDeclPkgs = slices.Append[@[]char](gc.GenericIfaceDeclPkgs, buf.CopyStr(pkgPath))
	gc.GenericIfaceDeclFiles = slices.Append[@ast.File](gc.GenericIfaceDeclFiles, file)
}

// stashGenericIfaceDecls stashes every generic interface decl of file (declared
// in pkgPath) — run before any of the file's interfaces is collected, because an
// interface may name a generic parent declared after it (`interface Sub :
// Base[int]` before `interface Base[T any]`, which declaration order permits)
// and collectInterfaceParents instantiates the parent from the stash.
func stashGenericIfaceDecls(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_INTERFACE && len(d.TypeParams) > 0 {
			stashGenericIfaceDecl(gc, d, pkgPath, file)
		}
	}
}

// panicGenericIfaceMissing aborts IR-gen: the generic interface pkg.name, named
// by `what` (an extension clause or impl the checker accepted), was never
// stashed.  Every driver stashes each loaded package's generic interfaces
// before collecting any interface or impl (RegisterAllInterfaces /
// RegisterGenericDecls / stashGenericIfaceDecls), so a miss is a registration
// bug — dropping the parent or impl row instead would silently lose its
// methods and upcast.
func panicGenericIfaceMissing(what *[]readonly char, pkg *[]readonly char, name *[]readonly char) {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("internal error: generic interface ")
	sb.Write(pkg)
	sb.WriteByte('.')
	sb.Write(name)
	sb.Write(", named as ")
	sb.Write(what)
	sb.Write(", was never registered")
	panic(sb.String())
}

// registerIfaceStub registers the identity of the non-generic interface d
// (declared in pkgPath, parsed from file) before any type expression of its
// package is resolved: a type alias, global or field typed through an interface
// declared later — or, across packages, registered by a later pass (`var g *I`
// / `type P = *I`) — then resolves to the interface instead of
// resolveTypeExpr's int fallback.  collectInterfaceFromDecl fills the stub in
// place.  An alias of a named interface needs only its target, so it is
// collected whole (the caller has its file's imports active); an alias of a
// generic instantiation (`interface X = G[int]`) gets a stub too — its target
// is instantiated when it is collected, after the package's type aliases are
// registered, since instantiating resolves the generic's method types and the
// type arguments, and the instance is cached for every use of it.
func registerIfaceStub(gc @GenCtx, d @ast.Decl, pkgPath *[]readonly char, file @ast.File) {
	if d.Kind != ast.DECL_INTERFACE || len(d.TypeParams) > 0 { return }
	if ir.LookupModuleInterfaceIndex(gc.Mod, pkgPath, d.Name) >= 0 { return }
	if d.IsAlias && (d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_INSTANTIATE) {
		collectInterfaceFromDecl(gc, d, pkgPath, file)
		return
	}
	var mi irsym.ModuleInterface
	mi.Pkg = buf.CopyStr(pkgPath)
	mi.Name = buf.CopyStr(d.Name)
	mi.IsStub = true
	gc.Mod.Interfaces = slices.Append[irsym.ModuleInterface](gc.Mod.Interfaces, mi)
}

// registerIfaceStubs runs registerIfaceStub over file's declarations, each
// under its own source file's imports (declImports) — an alias stub resolves
// its target.
func registerIfaceStubs(gc @GenCtx, file @ast.File, pkgPath *[]readonly char) {
	var di @declImports = beginDeclImports(gc, file)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_INTERFACE { continue }
		registerIfaceStub(gc, d, pkgPath, di.use(gc, d))
	}
	di.end(gc)
}

// instantiatedAliasTarget resolves an interface alias's instantiated target
// (`interface X = home.Getter[int]`) to the instantiated interface's (package,
// name) — its defining package and mangled instance name, registered by
// ensureInstantiatedInterface — so the alias follows it like a named target.
// The type arguments resolve in the alias's own package (pkgPath); rpkg is that
// package's identity for a bare generic head.  The checker accepted the target,
// so its generic decl is stashed; a miss is an internal error.
func instantiatedAliasTarget(gc @GenCtx, ref @ast.TypeExpr, rpkg *[]readonly char,
		pkgPath *[]readonly char) (@[]char, @[]char) {
	if ref.Base == nil {
		panic("internal error: an interface alias's instantiated target names no generic interface")
	}
	var lookupPkg @[]char
	if len(ref.Base.Pkg) > 0 {
		lookupPkg = homedQualifier(gc.Mod, ref.Base.Pkg, ref.Base.Name)
	} else {
		lookupPkg = buf.CopyStr(rpkg)
	}
	var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc, lookupPkg, ref.Base.Name)
	if gd == nil {
		panicGenericIfaceMissing("an interface alias's target", lookupPkg, ref.Base.Name)
	}
	var savedImportPkg @[]char = gc.Mod.CurrentImportPkg
	gc.Mod.CurrentImportPkg = buf.CopyStr(pkgPath)
	var argTypes @[]@types.Type = make_slice(@types.Type, len(ref.TypeArgs))
	for i := 0; i < len(ref.TypeArgs); i++ {
		argTypes[i] = resolveTypeExpr(gc, ref.TypeArgs[i])
	}
	gc.Mod.CurrentImportPkg = savedImportPkg
	return lookupPkg, ensureInstantiatedInterface(gc, gd, argTypes, lookupPkg)
}
