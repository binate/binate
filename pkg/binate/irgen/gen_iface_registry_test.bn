package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/irsym"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Unit tests for the per-module interface registry in
// gen_iface_registry.bn.  Helpers (genFromSourcePkg, fail) live
// in ir_test.bn.

// A non-generic interface registers under (pkgShort, Name) with
// the method-name list in source order.  lookupModuleInterface
// returns those names; IfaceMethodCount reports their count.
func TestRegistryNonGenericInterface() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface RW { read() int; write() }\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	var names @[]@[]char = ir.LookupModuleInterface(m, "test", "RW")
	if len(names) != 2 {
		return fail("expected 2 methods on RW")
	}
	if !charsEqualOpt(names[0], "read") {
		return fail("method 0 should be read")
	}
	if !charsEqualOpt(names[1], "write") {
		return fail("method 1 should be write")
	}
	if IfaceMethodCount(m, "test", "RW") != 2 {
		return fail("IfaceMethodCount(RW) should be 2")
	}
	return ""
}

// `interface X = Y` registers X with AliasTarget = Y and an
// empty method list (methods are read through the chain).
// canonicalIfaceName follows the chain and returns Y; lookups
// against X return Y's method list.
func TestRegistryAliasFollowed() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Closer { Close() }\n"
			"interface Shutter = Closer\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	if !charsEqualOpt(ir.CanonicalIfaceName(m, "test", "Shutter"), "Closer") {
		return fail("Shutter canonicalizes to Closer")
	}
	var names @[]@[]char = ir.LookupModuleInterface(m, "test", "Shutter")
	if len(names) != 1 {
		return fail("Shutter should expose Closer's 1 method")
	}
	if !charsEqualOpt(names[0], "Close") {
		return fail("Shutter method 0 should be Close")
	}
	return ""
}

// A generic interface decl is stashed in genericIfaceDecls and
// intentionally NOT added
// to the module's Interfaces — instantiations register lazily under
// the mangled name (`Container__bn_inst__1_N0_3_int`).
func TestRegistrySkipsGenericInterface() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Container[T any] { get() T }\n"
			"func main() { }\n"
	var gc @GenCtx = genFromSourcePkgGc(src)
	if ir.LookupModuleInterfaceIndex(gc.Mod, "test", "Container") >= 0 {
		return fail(
				"generic Container should not occupy registry slot")
	}
	if lookupGenericIfaceDecl(gc, "Container") == nil {
		return fail(
				"generic Container should be in gc.GenericIfaceDecls")
	}
	return ""
}

// A non-generic iface that
// extends an instantiation of a generic iface
// (`interface IntCarrier : Container[int]`) must record the
// parent under its mangled name so the concat-vtable layout and
// ancestor-closure walk reach the right (R, I) pair.
func TestRegistryParentRefGenericInst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Container[T any] { get() T }\n"
			"interface IntCarrier : Container[int] { size() int }\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	var idx int = ir.LookupModuleInterfaceIndex(m, "test", "IntCarrier")
	if idx < 0 {
		return fail("IntCarrier should be registered")
	}
	var mi irsym.ModuleInterface = m.Interfaces[idx]
	if len(mi.ParentNames) != 1 {
		return fail(
				"IntCarrier should record 1 parent")
	}
	if !charsEqualOpt(mi.ParentNames[0], "Container__bn_inst__1_N0_3_int") {
		var emsg @strings.Builder = strings.NewBuilder()
		emsg.Write(
				"IntCarrier parent: want Container__bn_inst__1_N0_3_int, got ")
		emsg.Write(mi.ParentNames[0])
		return buf.CopyStr(emsg.String())
	}
	return ""
}

// `interface Wide : Closer` records Closer as a parent.  Bare
// (same-package) parent refs default to the current pkgShort
// for the ParentPkg field.
func TestRegistryParentRefRecorded() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Closer { Close() }\n"
			"interface Wide : Closer { Foo() }\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	var idx int = ir.LookupModuleInterfaceIndex(m, "test", "Wide")
	if idx < 0 {
		return fail("Wide should be registered")
	}
	var mi irsym.ModuleInterface = m.Interfaces[idx]
	if len(mi.ParentNames) != 1 {
		return fail("Wide should record 1 parent")
	}
	if !charsEqualOpt(mi.ParentNames[0], "Closer") {
		return fail("Wide's parent should be Closer")
	}
	if !charsEqualOpt(mi.ParentPkgs[0], "test") {
		var emsg @strings.Builder = strings.NewBuilder()
		emsg.Write(
				"Wide's parent pkg should be test, got ")
		emsg.Write(mi.ParentPkgs[0])
		return buf.CopyStr(emsg.String())
	}
	return ""
}

// A generic parent declared AFTER its child is stashed by the pre-pass
// (stashGenericIfaceDecls, deduped across passes), so collecting the child
// records the parent's instantiation.
func TestStashGenericIfaceDeclsForwardParent() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"interface Sub : Base[int] { Extra() int }\n"
					"interface Base[T any] { Get() T }\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	stashGenericIfaceDecls(gc, file, "pkg/home")
	stashGenericIfaceDecls(gc, file, "pkg/home")
	if len(gc.GenericIfaceDecls) != 1 { return fail("expected Base stashed exactly once") }
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/home", file)
	var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "Sub")
	if idx < 0 { return fail("expected Sub registered") }
	if len(gc.Mod.Interfaces[idx].ParentNames) != 1 { return fail("expected Sub's parent Base[int]") }
	return ""
}

// An interface alias of a generic interface's instantiation follows the
// instantiated interface, not an empty entry.
func TestIfaceAliasInstantiatedTarget() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"interface X = G[int]\n"
					"interface G[T any] { Get() T }\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	stashGenericIfaceDecls(gc, file, "pkg/home")
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/home", file)
	var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "X")
	if idx < 0 { return fail("expected X registered") }
	var mi irsym.ModuleInterface = gc.Mod.Interfaces[idx]
	if !charsEqualOpt(mi.AliasTargetPkg, "pkg/home") || len(mi.AliasTarget) == 0 {
		return fail("X should alias the instantiation in pkg/home")
	}
	var ti int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", mi.AliasTarget)
	if ti < 0 || len(gc.Mod.Interfaces[ti].MethodNames) != 1 {
		return fail("the alias target should be the instantiated G[int] with its method")
	}
	return ""
}

// An instantiated interface alias first gets an identity stub (registerIfaceStubs
// runs before the generic decls it instantiates are all stashed); collection
// then fills that stub in place — one entry, no longer a stub, following the
// instantiation.
func TestIfaceAliasInstantiatedStubFilled() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/home\"\n"
					"interface X = G[int]\n"
					"interface G[T any] { Get() T }\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	registerIfaceStubs(gc, file, "pkg/home")
	var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "X")
	if idx < 0 || !gc.Mod.Interfaces[idx].IsStub {
		return fail("expected an identity stub for X")
	}
	stashGenericIfaceDecls(gc, file, "pkg/home")
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/home", file)
	var count int = 0
	for i := 0; i < len(gc.Mod.Interfaces); i++ {
		var mi irsym.ModuleInterface = gc.Mod.Interfaces[i]
		if charsEqualOpt(mi.Pkg, "pkg/home") && charsEqualOpt(mi.Name, "X") {
			count = count + 1
		}
	}
	if count != 1 { return fail("X should be registered exactly once") }
	idx = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "X")
	var x irsym.ModuleInterface = gc.Mod.Interfaces[idx]
	if x.IsStub { return fail("X's stub should be filled") }
	if !charsEqualOpt(x.AliasTargetPkg, "pkg/home") || len(x.AliasTarget) == 0 {
		return fail("the filled X should alias the instantiation in pkg/home")
	}
	return ""
}

// A bare alias target naming a universe interface (`interface A = any`) aliases
// the universe entry (package ""), not a same-named interface of the alias's own
// package, so A canonicalizes to `any`.
func TestIfaceAliasOfUniverseAny() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/home\"\ninterface A = any\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	collectInterfaceFromDecl(gc, file.Decls[0], "pkg/home", file)
	var idx int = ir.LookupModuleInterfaceIndex(gc.Mod, "pkg/home", "A")
	if idx < 0 { return fail("expected A registered") }
	if len(gc.Mod.Interfaces[idx].AliasTargetPkg) != 0 { return fail("A should alias the universe") }
	if !charsEqualOpt(ir.CanonicalIfaceName(gc.Mod, "pkg/home", "A"), "any") ||
			len(ir.CanonicalIfacePkg(gc.Mod, "pkg/home", "A")) != 0 {
		return fail("A should canonicalize to the universe any")
	}
	return ""
}

// An interface alias's target is the interface the checker resolved it to: a checked
// `interface K = J`, J an alias of I, whose written target is then renamed, targets I
// (by its written name it would be J, or the renamed Z); `interface A = any` targets
// the universe interface.
func TestIfaceAliasTargetIsTheCheckers() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	var msg @[]char
	gc, c, msg = implSession()
	if len(msg) > 0 { return fail(msg) }
	var d @ast.Decl = checkedReplDecl(c, "interface K = J")
	d.TypeRef.Name = "Z"
	msg = GenDecl(d, gc)
	if len(msg) > 0 { return fail(buf.Concat("interface K = J: ", msg)) }
	msg = declareInSession(gc, c, "interface A = any")
	if len(msg) > 0 { return fail(buf.Concat("interface A = any: ", msg)) }
	var names @[]*[]readonly char = @[]*[]readonly char{"K", "A"}
	var wantPkgs @[]*[]readonly char = @[]*[]readonly char{"test", ""}
	var wantTargets @[]*[]readonly char = @[]*[]readonly char{"I", "any"}
	for i := 0; i < len(names); i++ {
		var k int = ir.LookupModuleInterfaceIndex(gc.Mod, "test", names[i])
		if k < 0 { return fail(buf.Concat("not registered: ", names[i])) }
		var mi irsym.ModuleInterface = gc.Mod.Interfaces[k]
		if !seq(mi.AliasTargetPkg, wantPkgs[i]) || !seq(mi.AliasTarget, wantTargets[i]) {
			return fail(buf.Concat("the target recorded for ", names[i]))
		}
	}
	return ""
}

// An alias the checker resolved to a generic instance through another alias
// (`interface Z = X`, X = G[int]) is a pending stub until its first use, as one
// written as an instance is, and then targets the instance itself, not X.
func TestIfaceAliasOfAliasOfInstanceIsPending() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"test\"\ninterface G[T any] { Get() T }\nfunc main() {}\n")
	var noFile @ast.File
	registerIfaceStub(gc, checkedReplDecl(c, "interface X = G[int]"), gc.PkgPath, noFile)
	registerIfaceStub(gc, checkedReplDecl(c, "interface Z = X"), gc.PkgPath, noFile)
	var zi int = ir.LookupModuleInterfaceIndex(gc.Mod, gc.PkgPath, "Z")
	if zi < 0 || !gc.Mod.Interfaces[zi].IsStub { return fail("Z should be a pending stub") }
	completeIfaceAliasStub(gc, gc.PkgPath, "Z")
	var mi irsym.ModuleInterface = gc.Mod.Interfaces[zi]
	if mi.IsStub || len(mi.AliasTarget) == 0 || seq(mi.AliasTarget, "X") {
		return fail("Z should target the instance itself")
	}
	if ir.LookupModuleInterfaceIndex(gc.Mod, mi.AliasTargetPkg, mi.AliasTarget) < 0 {
		return fail("Z's target should be the registered instance")
	}
	return ""
}
