package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The identities a box of a named type T records (iface.assert.readonly,
// iface.assert.origin): T itself, for a box of a mutable object made from a
// managed pointer; T's readonly variant (gen_iface_readonly.bn), for a readonly
// object; T's raw-origin variant (gen_iface_origin.bn), for a box made from a raw
// pointer; and the readonly variant of that, for a readonly object boxed from a
// raw pointer.  A variant is a receiver identity of its own in T's package -- its
// own TypeInfo record and impl rows (vtables, satisfaction entries) -- with T's
// layout, methods and destructor, and has rows only for the impls its box's
// object may reach, so an interface-target assertion on the box finds only
// those.  A raw-origin variant records only how its box was made: its record names
// T's own (the readonly variant's, for the readonly one) as the box's dynamic type
// (irutil.DynamicTypeName), the canonical record that reflect.TypeOf returns and a
// concrete target compares (emitTypeInfoMismatch).

// appendVariantRow appends the variant of impl row `info` whose receiver name is
// `name` -- the same methods, destructor and interface -- and registers the
// variant's TypeInfo record (recvTyp, the receiver's base value type).  A no-op
// when the module already has the row.
func appendVariantRow(m @ir.Module, info @irdata.ImplInfo, name @[]char, recvTyp @types.Type) {
	if moduleHasImpl(m, info.RecvPkg, name, info.IfacePkg, info.IfaceName) { return }
	var v @irdata.ImplInfo = make(irdata.ImplInfo)
	v.RecvPkg = info.RecvPkg
	v.RecvTypeName = name
	v.IfacePkg = info.IfacePkg
	v.IfaceName = info.IfaceName
	v.MethodFuncs = info.MethodFuncs
	v.DtorFuncName = info.DtorFuncName
	ir.RegisterTypeInfo(m, info.RecvPkg, name, recvTyp, info.DtorFuncName)
	m.Impls = slices.Append[@irdata.ImplInfo](m.Impls, v)
}

// appendVariantRows appends the variants of T's impl row `info` that the impl's
// receiver admits: the readonly variant when a readonly object may reach it
// (admitsReadonly), the raw-origin variant when a raw pointer may supply it
// (admitsRaw), and the readonly variant of that when both.
func appendVariantRows(m @ir.Module, info @irdata.ImplInfo, recvTyp @types.Type,
		admitsReadonly bool, admitsRaw bool) {
	if admitsReadonly {
		appendVariantRow(m, info, irutil.ReadonlyVariantName(info.RecvTypeName), recvTyp)
	}
	if !admitsRaw { return }
	var raw @[]char = irutil.RawVariantName(info.RecvTypeName)
	appendVariantRow(m, info, raw, recvTyp)
	if admitsReadonly {
		appendVariantRow(m, info, irutil.ReadonlyVariantName(raw), recvTyp)
	}
}

// ensureVariantRows gives the module's (recvName, iface) row and its ancestors'
// rows the variants the impl admits (appendVariantRows) -- the on-demand
// counterpart of collectImplsFromDecl's, for a monomorphized generic receiver
// whose rows are themselves minted on demand (ensureGenericImplInfo).
func ensureVariantRows(m @ir.Module, recvPkg *[]readonly char, recvName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char, recvTyp @types.Type, admitsReadonly bool,
		admitsRaw bool) {
	if !admitsReadonly && !admitsRaw { return }
	var canonPkg @[]char = ir.CanonicalIfacePkg(m, ifacePkg, ifaceName)
	var canonName @[]char = ir.CanonicalIfaceName(m, ifacePkg, ifaceName)
	var pkgs @[]@[]char = IfaceAncestorClosurePkgs(m, canonPkg, canonName)
	var names @[]@[]char = IfaceAncestorClosure(m, canonPkg, canonName)
	pkgs = slices.Append[@[]char](pkgs, canonPkg)
	names = slices.Append[@[]char](names, canonName)
	for i := 0; i < len(m.Impls); i++ {
		var info @irdata.ImplInfo = m.Impls[i]
		if info == nil { continue }
		if !irutil.CharEq(info.RecvPkg, recvPkg) || !irutil.CharEq(info.RecvTypeName, recvName) {
			continue
		}
		for j := 0; j < len(names); j++ {
			if irutil.CharEq(info.IfacePkg, pkgs[j]) && irutil.CharEq(info.IfaceName, names[j]) {
				appendVariantRows(m, info, recvTyp, admitsReadonly, admitsRaw)
				break
			}
		}
	}
}

// emitTypeInfoMismatch emits, into b, the test that a box whose vtable slot 1 holds
// the record slot1 does NOT have a dynamic type the asserted target matches: its
// canonical record (emitCanonicalRecord -- the same whichever way the box was made)
// is neither the target's record nor, for a target that may recover a readonly
// object, its readonly variant's (readonlyVariantTypeInfoSymFor).  Shared by the
// expression and comma-ok (and so type-switch) assertion forms.
func emitTypeInfoMismatch(ctx @GenContext, b @ir.Block, slot1 @ir.Instr,
		recoveredTyp @types.Type) @ir.Instr {
	var canon @ir.Instr = emitCanonicalRecord(b, slot1, types.MakePointerType(types.TypUint8()))
	var wrong @ir.Instr = emitTypeInfoNe(b, canon, typeInfoSymFor(ctx, recoveredTyp))
	var roSym @[]char = readonlyVariantTypeInfoSymFor(ctx, recoveredTyp)
	if len(roSym) == 0 { return wrong }
	// Mismatch iff it matches neither record: the bools AND-ed as ints (an i1 AND
	// is not a uniformly lowered op), then tested non-zero.
	var intTyp @types.Type = types.TypInt()
	var both @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_AND, irbuild.EmitCast(b, wrong, intTyp),
			irbuild.EmitCast(b, emitTypeInfoNe(b, canon, roSym), intTyp), intTyp)
	var zero @ir.Instr = irbuild.EmitConstInt(b, 0, intTyp)
	return irbuild.EmitBinop(b, iropcode.OP_NE, both, zero, types.TypBool())
}

// emitTypeInfoNe emits, into b, the test that the `*TypeInfo` slot1 is not the
// record sym.
func emitTypeInfoNe(b @ir.Block, slot1 @ir.Instr, sym @[]char) @ir.Instr {
	var want @ir.Instr = irbuild.EmitDataSymAddr(b, sym, types.TypUint8())
	return irbuild.EmitBinop(b, iropcode.OP_NE, slot1, want, types.TypBool())
}
