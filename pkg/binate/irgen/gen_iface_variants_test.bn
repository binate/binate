package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// appendVariantRows appends a T row's variants by what its impl admits: the
// readonly one, the raw-origin one, and the readonly one of that when both;
// none when neither, and each once.
func TestAppendVariantRows() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var info @irdata.ImplInfo = make(irdata.ImplInfo)
	info.RecvPkg = "test"
	info.RecvTypeName = "T"
	info.IfacePkg = "test"
	info.IfaceName = "G"
	appendVariantRows(m, info, types.TypInt(), false, false)
	if len(m.Impls) != 0 { return fail("an impl admitting neither should give no variant") }
	appendVariantRows(m, info, types.TypInt(), false, true)
	if len(m.Impls) != 1 || !hasImplRow(m, "__raw_T", "G") {
		return fail("an impl admitting a raw object should give the raw-origin variant")
	}
	appendVariantRows(m, info, types.TypInt(), true, true)
	if len(m.Impls) != 3 || !hasImplRow(m, "__readonly_T", "G") ||
			!hasImplRow(m, "__readonly___raw_T", "G") {
		return fail(
				"an impl admitting both should add the readonly variant and its raw-origin one, once each")
	}
	return ""
}

// ownImplRows returns m's impl rows for their receivers' own types -- every row
// but a variant's (irutil.VariantBase) -- in order.
func ownImplRows(m @ir.Module) @[]@irdata.ImplInfo {
	var rows @[]@irdata.ImplInfo
	for i := 0; i < len(m.Impls); i++ {
		var info @irdata.ImplInfo = m.Impls[i]
		if irutil.CharEq(irutil.VariantBase(info.RecvTypeName), info.RecvTypeName) {
			rows = slices.Append[@irdata.ImplInfo](rows, info)
		}
	}
	return rows
}
