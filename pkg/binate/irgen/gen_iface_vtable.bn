package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/mangle"

import "pkg/binate/buf"

import "pkg/stdx/slices"

// Vtable-name lookup for IR-gen.  Use sites (wrapAsIfaceValue in
// gen_iface.bn, OP_IFACE_VALUE construction elsewhere) read these to
// spell the canonical `__ivt.<...>` global that codegen's emit_impls.bn
// defines for each (impl, interface) pair.  The symbol itself is built
// by mangle.ImplVtableName (the single source of truth, shared with
// codegen and the VM); this file does the lookup/match against m.Impls.

// findImplVtableName searches m.Impls and m.ImportedImpls for an
// entry matching the canonical (recvPkg, recvName, ifacePkg,
// ifaceName), returning the mangled `__ivt.<...>` global name
// codegen emits for that impl. The query is canonicalized through
// the alias chain so a use-site referencing an alias matches an
// impl declared on the alias's target (or vice versa). Returns
// empty if no match — IR-gen's caller (genDecl interface-value
// path) treats that as "no impl" and falls back to a placeholder.
// The symbol form is canonicalized on
// (recv_pkg, recv_name, iface_pkg, iface_name); the search covers
// imported impls so cross-package use sites (where
// the impl lives in a different TU) can produce the canonical
// symbol that the linker resolves to the imported TU's weak_odr
// vtable, and the receiver lookup is split into (pkg, name) so
// imported recv names (which arrive qualified through IR-gen's
// type-resolution path) match the bare-name form stored on
// ImplInfo.
func findImplVtableName(m @ir.Module, recvPkg *[]readonly char, recvName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char {
	var canonName @[]char = ir.CanonicalIfaceName(m, ifacePkg, ifaceName)
	var canonPkg @[]char = ir.CanonicalIfacePkg(m, ifacePkg, ifaceName)
	var sym @[]char = findImplVtableNameIn(m.Impls, recvPkg, recvName, canonPkg, canonName)
	if len(sym) > 0 { return sym }
	return findImplVtableNameIn(m.ImportedImpls, recvPkg, recvName, canonPkg, canonName)
}

// findImplVtableNameIn scans a single ImplInfo collection for a
// matching (recvPkg, recvName, canonical iface) entry and returns
// the mangled vtable symbol, or empty if no match.
func findImplVtableNameIn(infos @[]@irdata.ImplInfo, recvPkg *[]readonly char,
		recvName *[]readonly char, canonPkg *[]readonly char, canonName *[]readonly char) @[]char {
	for i := 0; i < len(infos); i++ {
		var info @irdata.ImplInfo = infos[i]
		if info == nil { continue }
		if !irutil.CharEq(info.RecvPkg, recvPkg) { continue }
		if !irutil.CharEq(info.RecvTypeName, recvName) { continue }
		if !irutil.CharEq(info.IfacePkg, canonPkg) { continue }
		if !irutil.CharEq(info.IfaceName, canonName) { continue }
		return buildImplVtableSymbol(info)
	}
	var empty @[]char
	return empty
}

// buildImplVtableSymbol formats the canonical vtable symbol for an
// ImplInfo by delegating to mangle.ImplVtableName — the single source
// of truth shared with codegen (emit_impls.bn) and the VM.
func buildImplVtableSymbol(info @irdata.ImplInfo) @[]char {
	return mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName)
}

// ensureImportedImplInfo records on m.ImportedImpls the (recv, iface) row of an
// impl the module has none for: one declared in a package the module does not
// import directly (RegisterImports collects the impls of direct imports only),
// reached when a value of the receiver's type is boxed into the interface.  The
// checker accepted that boxing, so the impl exists, and its package emits the
// vtable under the symbol the row names (buildImplVtableSymbol keys it on the
// pair alone); the row lets this module name it, as a direct import's does.
func ensureImportedImplInfo(m @ir.Module, recvPkg *[]readonly char, recvName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) {
	var info @irdata.ImplInfo = make(irdata.ImplInfo)
	info.RecvPkg = buf.CopyStr(recvPkg)
	info.RecvTypeName = buf.CopyStr(recvName)
	info.IfacePkg = ir.CanonicalIfacePkg(m, ifacePkg, ifaceName)
	info.IfaceName = ir.CanonicalIfaceName(m, ifacePkg, ifaceName)
	// A (T, any) vtable is emitted by the module that boxes T (ensureAnyImplInfo),
	// never by another package, so a row naming one here would be a dangling extern.
	if len(info.IfacePkg) == 0 && irutil.CharEq(info.IfaceName, "any") {
		panic("ensureImportedImplInfo: a (T, any) row is the boxing module's own")
	}
	if moduleHasImportedImpl(m, info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName) {
		return
	}
	m.ImportedImpls = slices.Append[@irdata.ImplInfo](m.ImportedImpls, info)
}
