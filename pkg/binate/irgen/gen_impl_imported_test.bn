package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/builtins/testing"

// moduleHasImportedImpl matches on all four keys.
func TestModuleHasImportedImpl() testing.TestResult {
	var m @ir.Module = ir.NewModule("main")
	var info @irdata.ImplInfo = make(irdata.ImplInfo)
	info.RecvPkg = "pkg/a"
	info.RecvTypeName = "R"
	info.IfacePkg = "pkg/b"
	info.IfaceName = "I"
	m.ImportedImpls = make_slice(@irdata.ImplInfo, 1)
	m.ImportedImpls[0] = info
	if !moduleHasImportedImpl(m, "pkg/a", "R", "pkg/b", "I") { return fail("exact match") }
	if moduleHasImportedImpl(m, "pkg/x", "R", "pkg/b", "I") { return fail("recv pkg differs") }
	if moduleHasImportedImpl(m, "pkg/a", "Q", "pkg/b", "I") { return fail("recv name differs") }
	if moduleHasImportedImpl(m, "pkg/a", "R", "pkg/x", "I") { return fail("iface pkg differs") }
	if moduleHasImportedImpl(m, "pkg/a", "R", "pkg/b", "J") { return fail("iface name differs") }
	return ""
}
