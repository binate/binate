package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// parseImportedPkg parses src as an imported package's interface file.
func parseImportedPkg(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(strToBytes(src), "imported")
	return p.ParseFile()
}

// A transitive package's impl ref resolves against THAT package's own import
// (`dep` -> pkg/dep), even when the consumer's alias map already binds the same
// short alias to a different package; afterwards the consumer's map is as before.
func TestRegisterImportedImplsUsesPackagesOwnImports() testing.TestResult {
	var file @ast.File = parseImportedPkg(
			"package \"pkg/mid\"\n"
					"import \"pkg/dep\"\n"
					"type M struct { x int }\n"
					"impl *M : dep.I\n")
	var m @ir.Module = ir.NewModule("main")
	RecordImportPath(m, "dep", "pkg/other/dep")
	var gc @GenCtx = NewGenCtx(m)
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = "pkg/mid"
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImportedImpls(paths, paths, files, gc)
	if len(m.ImportedImpls) != 1 { return fail("expected 1 imported impl") }
	var info @irdata.ImplInfo = m.ImportedImpls[0]
	if !irutil.Streq(info.IfacePkg, "pkg/dep") {
		return fail("impl ref should resolve via the package's own import (pkg/dep)")
	}
	if !irutil.Streq(info.RecvPkg, "pkg/mid") || !irutil.Streq(info.RecvTypeName, "M") {
		return fail("receiver should key on pkg/mid.M")
	}
	if !irutil.Streq(ir.ResolveImportPkg(m, "dep"), "pkg/other/dep") {
		return fail("the consumer's alias map should be restored")
	}
	return ""
}

// A transitive package's alias the consumer does not bind at all resolves too
// (it must not stay the bare, unresolved alias "dep").
func TestRegisterImportedImplsResolvesUnboundAlias() testing.TestResult {
	var file @ast.File = parseImportedPkg(
			"package \"pkg/mid\"\n"
					"import \"pkg/dep\"\n"
					"type M struct { x int }\n"
					"impl *M : dep.I\n")
	var m @ir.Module = ir.NewModule("main")
	var gc @GenCtx = NewGenCtx(m)
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = "pkg/mid"
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterImportedImpls(paths, paths, files, gc)
	if len(m.ImportedImpls) != 1 { return fail("expected 1 imported impl") }
	if !irutil.Streq(m.ImportedImpls[0].IfacePkg, "pkg/dep") {
		return fail("impl ref should resolve via the package's own import (pkg/dep)")
	}
	if len(m.ImportAliasNames) != 0 {
		return fail("the consumer's (empty) alias map should be restored")
	}
	return ""
}

// moduleHasImportedImpl matches on all four keys.
func TestModuleHasImportedImpl() testing.TestResult {
	var m @ir.Module = ir.NewModule("main")
	var info @irdata.ImplInfo = make(irdata.ImplInfo)
	info.RecvPkg = "pkg/a"
	info.RecvTypeName = "R"
	info.IfacePkg = "pkg/b"
	info.IfaceName = "I"
	m.ImportedImpls = make_slice(@irdata.ImplInfo, 1)
	m.ImportedImpls[0] = info
	if !moduleHasImportedImpl(m, "pkg/a", "R", "pkg/b", "I") { return fail("exact match") }
	if moduleHasImportedImpl(m, "pkg/x", "R", "pkg/b", "I") { return fail("recv pkg differs") }
	if moduleHasImportedImpl(m, "pkg/a", "Q", "pkg/b", "I") { return fail("recv name differs") }
	if moduleHasImportedImpl(m, "pkg/a", "R", "pkg/x", "I") { return fail("iface pkg differs") }
	if moduleHasImportedImpl(m, "pkg/a", "R", "pkg/b", "J") { return fail("iface name differs") }
	return ""
}
