package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"

// The keys an impl's rows are filed under (collectImplsFromDecl,
// collectImportedImplsFromDecl, mintGenericImplRows) -- the receiver's name and
// defining package, and each listed interface's package and name -- and the parents
// of an instance of a generic interface (collectInterfaceParents; a declared
// interface's come from its type: ifaceParentKeys).  Each comes from the checker's
// record of the type expression, so a row or a parent names the very type the
// checker resolved; no record, or an abstract one, is an internal error.

// implRecvKey returns the name and the package the impl d's rows key its receiver
// on: the checker's base type of the receiver (its record, through aliases and
// pointer / managed / readonly wrappers: ReceiverBaseNamed) -- a named type, an
// instance of a generic one, or a predeclared type -- as IR-gen registers it
// (typeFromRecord): that name without its package, and its package, or, for a
// predeclared type, which has none, the impl's own (implPkg).  RecvPkg keys on the
// receiver's package, not the impl's: a third package's impl keyed on its own
// package would never be found where a value of the type is boxed (a null vtable at
// dispatch).  No record, an abstract one or one naming no such type is an internal
// error.
func implRecvKey(gc @GenCtx, d @ast.Decl, implPkg *[]readonly char) (@[]char, @[]char) {
	var rec @types.Type = typeExprRecord(gc, d.TypeRef)
	if rec == nil { noTypeRecordICE(d.TypeRef.Pos) }
	var base @types.Type = requireConcreteRecord(gc, rec, d.TypeRef.Pos, "an impl's receiver")
	base = base.ReceiverBaseNamed()
	if base == nil || len(base.Name) == 0 {
		var at @[]char = buf.Concat("internal error: the checker's record of the impl receiver at ",
				token.PosString(d.TypeRef.Pos))
		panic(buf.Concat(at, " names no type with methods (compiler bug)"))
	}
	var registered @types.Type = typeFromRecord(gc, base)
	var name @[]char = shortTypeName(registered.Name)
	var pkg @[]char = qualifierTypeName(registered.Name)
	if len(pkg) == 0 { pkg = buf.CopyStr(implPkg) }
	return name, pkg
}

// ifaceRefKey returns the package and the name of the interface ref names -- an
// impl's listed interface, or an interface's parent: the interface the checker
// resolved ref to (its record -- an alias's target; the universe `any`; an instance
// of a generic interface, which mapping it instantiates, keyed on the generic's
// defining package, where use sites look its vtables up).  No record, an abstract
// one or one that is no interface is an internal error, naming ref as what.
func ifaceRefKey(gc @GenCtx, ref @ast.TypeExpr, what *[]readonly char) (@[]char, @[]char) {
	var rec @types.Type = typeExprRecord(gc, ref)
	if rec == nil { noTypeRecordICE(ref.Pos) }
	rec = requireConcreteRecord(gc, rec, ref.Pos, what)
	if rec.Kind != types.TYP_INTERFACE { notAnInterfaceICE(what, ref.Pos) }
	var it @types.Type = typeFromRecord(gc, rec)
	return buf.CopyStr(it.Pkg), buf.CopyStr(it.Name)
}

// notAnInterfaceICE is the internal error for what, written at pos, whose record the
// checker made something other than an interface.
func notAnInterfaceICE(what *[]readonly char, pos token.Pos) {
	var msg @[]char = buf.Concat("internal error: the checker's record of ", what)
	msg = buf.Concat(msg, buf.Concat(" at ", token.PosString(pos)))
	panic(buf.Concat(msg, " is no interface (compiler bug)"))
}

// isUniverseAnyKey reports whether (pkg, name) is the universe interface `any`, which
// every type satisfies and every interface extends without saying so: an impl or
// an extension clause that lists it adds nothing, so it is left out -- `impl T :
// any` makes no row, and `interface X : any` has the layout `interface X` has.
func isUniverseAnyKey(pkg *[]readonly char, name *[]readonly char) bool {
	return len(pkg) == 0 && irutil.Streq(name, "any")
}
