package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The keys an impl's rows are filed under (collectImplsFromDecl,
// collectImportedImplsFromDecl): the receiver's name and defining package, and each
// listed interface's package and name.  Each comes from the checker's record of the
// impl's type expression, so a row names the very types the checker matched the
// impl to; an expression with no concrete record is resolved by its written name
// (implRecvKeyByName, implIfaceKeyByName).

// implRecvKey returns the name and the package the impl d's rows key its receiver
// on: the checker's base type of the receiver (its record, through aliases and
// pointer / managed / readonly wrappers: ReceiverBaseNamed) -- a named type, an
// instance of a generic one, or a predeclared type -- as IR-gen registers it
// (typeFromRecord): that name without its package, and its package, or, for a
// predeclared type, which has none, the impl's own (implPkg).  RecvPkg keys on the
// receiver's package, not the impl's: a third package's impl keyed on its own
// package would never be found where a value of the type is boxed (a null vtable at
// dispatch).  m resolves a written receiver's qualifier.  The name is empty for a
// receiver that names no such type.
func implRecvKey(gc @GenCtx, m @ir.Module, d @ast.Decl,
		implPkg *[]readonly char) (@[]char, @[]char) {
	var rec @types.Type = concreteRecord(gc, d.TypeRef)
	if rec != nil { rec = rec.ReceiverBaseNamed() }
	if rec == nil || len(rec.Name) == 0 { return implRecvKeyByName(gc, m, d.TypeRef, implPkg) }
	var registered @types.Type = typeFromRecord(gc, rec)
	var name @[]char = shortTypeName(registered.Name)
	var pkg @[]char = qualifierTypeName(registered.Name)
	if len(pkg) == 0 { pkg = buf.CopyStr(implPkg) }
	return name, pkg
}

// implRecvKeyByName is implRecvKey for a receiver with no concrete record: its
// written name, seen through a type alias (recvBaseNameAndPkg), keyed on the
// package its qualifier names -- the type's home package, also through an `expose`
// forwarder (homedQualifier) -- or, unqualified, on the impl's own.
func implRecvKeyByName(gc @GenCtx, m @ir.Module, te @ast.TypeExpr,
		implPkg *[]readonly char) (@[]char, @[]char) {
	var name @[]char
	var pkg @[]char
	name, pkg = recvBaseNameAndPkg(gc, te)
	if len(name) == 0 { return name, pkg }
	if len(pkg) == 0 { pkg = homedQualifier(m, recvTypePkg(te), name) }
	if len(pkg) == 0 { pkg = buf.CopyStr(implPkg) }
	return name, pkg
}

// implIfaceKey returns the package and the name the impl's rows key the interface
// ref it lists on: the interface the checker resolved ref to (its record -- an
// alias's target; an instance of a generic interface, which mapping it
// instantiates, keyed on the generic's defining package, where use sites look its
// vtables up), or, with no concrete record, ref resolved by its written name
// (implIfaceKeyByName); false for a ref that names no interface.  implPkg is the
// impl's package, m resolves a written qualifier, and what names the impl in an
// internal error.
func implIfaceKey(gc @GenCtx, m @ir.Module, ref @ast.TypeExpr, implPkg *[]readonly char,
		what *[]readonly char) (@[]char, @[]char, bool) {
	var rec @types.Type = concreteRecord(gc, ref)
	if rec == nil || rec.Kind != types.TYP_INTERFACE {
		return implIfaceKeyByName(gc, m, ref, implPkg, what)
	}
	var it @types.Type = typeFromRecord(gc, rec)
	return buf.CopyStr(it.Pkg), buf.CopyStr(it.Name), true
}

// implIfaceKeyByName is implIfaceKey for an interface ref with no concrete record:
// a named one keys on the package its qualifier names (its home package, where it
// is registered, also through an `expose` forwarder) or, unqualified, on the
// impl's; an instantiation of a generic interface is instantiated from the generic
// stashed under its home package and keyed there.  The caller canonicalizes an
// alias (ir.CanonicalIfacePkg / CanonicalIfaceName).
func implIfaceKeyByName(gc @GenCtx, m @ir.Module, ref @ast.TypeExpr, implPkg *[]readonly char,
		what *[]readonly char) (@[]char, @[]char, bool) {
	var none @[]char
	if ref.Kind == ast.TEXPR_NAMED {
		var pkg @[]char = buf.CopyStr(implPkg)
		if len(ref.Pkg) > 0 { pkg = homedQualifier(m, ref.Pkg, ref.Name) }
		return pkg, ref.Name, true
	}
	if ref.Kind != ast.TEXPR_INSTANTIATE || ref.Base == nil || ref.Base.Kind != ast.TEXPR_NAMED {
		return none, none, false
	}
	var lookupPkg @[]char = buf.CopyStr(implPkg)
	if len(ref.Base.Pkg) > 0 { lookupPkg = homedQualifier(m, ref.Base.Pkg, ref.Base.Name) }
	var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc, lookupPkg, ref.Base.Name)
	if gd == nil { panicGenericIfaceMissing(what, lookupPkg, ref.Base.Name) }
	var argTypes @[]@types.Type
	for ai := 0; ai < len(ref.TypeArgs); ai++ {
		argTypes = slices.Append[@types.Type](argTypes, resolveTypeExpr(gc, ref.TypeArgs[ai]))
	}
	return buf.CopyStr(lookupPkg), ensureInstantiatedInterface(gc, gd, argTypes, lookupPkg), true
}
