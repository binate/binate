package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/stdx/slices"

// The keys an impl's rows are filed under (collectImplsFromDecl,
// collectImportedImplsFromDecl) -- the receiver's name and defining package, and
// each listed interface's package and name -- and an interface's parents
// (collectInterfaceParents).  Each comes from the checker's record of the type
// expression, so a row or a parent names the very type the checker resolved; an
// expression with no concrete record is resolved by its written name
// (implRecvKeyByName, ifaceRefKeyByName).

// implRecvKey returns the name and the package the impl d's rows key its receiver
// on: the checker's base type of the receiver (its record, through aliases and
// pointer / managed / readonly wrappers: ReceiverBaseNamed) -- a named type, an
// instance of a generic one, or a predeclared type -- as IR-gen registers it
// (typeFromRecord): that name without its package, and its package, or, for a
// predeclared type, which has none, the impl's own (implPkg).  RecvPkg keys on the
// receiver's package, not the impl's: a third package's impl keyed on its own
// package would never be found where a value of the type is boxed (a null vtable at
// dispatch).  m resolves a written receiver's qualifier.  The name is empty for a
// receiver that names no such type.
func implRecvKey(gc @GenCtx, m @ir.Module, d @ast.Decl,
		implPkg *[]readonly char) (@[]char, @[]char) {
	var rec @types.Type = concreteRecord(gc, d.TypeRef)
	if rec != nil { rec = rec.ReceiverBaseNamed() }
	if rec == nil || len(rec.Name) == 0 { return implRecvKeyByName(gc, m, d.TypeRef, implPkg) }
	var registered @types.Type = typeFromRecord(gc, rec)
	var name @[]char = shortTypeName(registered.Name)
	var pkg @[]char = qualifierTypeName(registered.Name)
	if len(pkg) == 0 { pkg = buf.CopyStr(implPkg) }
	return name, pkg
}

// implRecvKeyByName is implRecvKey for a receiver with no concrete record: its
// written name, seen through a type alias (recvBaseNameAndPkg), keyed on the
// package its qualifier names -- the type's home package, also through an `expose`
// forwarder (homedQualifier) -- or, unqualified, on the impl's own.
func implRecvKeyByName(gc @GenCtx, m @ir.Module, te @ast.TypeExpr,
		implPkg *[]readonly char) (@[]char, @[]char) {
	var name @[]char
	var pkg @[]char
	name, pkg = recvBaseNameAndPkg(gc, te)
	if len(name) == 0 { return name, pkg }
	if len(pkg) == 0 { pkg = homedQualifier(m, recvTypePkg(te), name) }
	if len(pkg) == 0 { pkg = buf.CopyStr(implPkg) }
	return name, pkg
}

// ifaceRefKey returns the package and the name of the interface ref names -- an
// impl's listed interface, or an interface's parent: the interface the checker
// resolved ref to (its record -- an alias's target; the universe `any`; an instance
// of a generic interface, which mapping it instantiates, keyed on the generic's
// defining package, where use sites look its vtables up), or, with no concrete
// record, ref resolved by its written name (ifaceRefKeyByName); false for a ref
// that names no interface.  pkg is the package ref is written in, m resolves a
// written qualifier, and what names ref in an internal error.
func ifaceRefKey(gc @GenCtx, m @ir.Module, ref @ast.TypeExpr, pkg *[]readonly char,
		what *[]readonly char) (@[]char, @[]char, bool) {
	var rec @types.Type = concreteRecord(gc, ref)
	if rec == nil || rec.Kind != types.TYP_INTERFACE {
		return ifaceRefKeyByName(gc, m, ref, pkg, what)
	}
	var it @types.Type = typeFromRecord(gc, rec)
	return buf.CopyStr(it.Pkg), buf.CopyStr(it.Name), true
}

// ifaceRefKeyByName is ifaceRefKey for an interface ref with no concrete record: a
// named one keys on the package its qualifier names (its home package, where it is
// registered, also through an `expose` forwarder) or, unqualified, on pkg -- or on
// the universe, for `any` when pkg declares no interface of that name; an
// instantiation of a generic interface is instantiated from the generic stashed
// under its home package (pkg, unqualified) and keyed there.  An alias is not
// followed: an impl's caller canonicalizes it (ir.CanonicalIfacePkg /
// CanonicalIfaceName), and the ancestor walk follows a parent's.
func ifaceRefKeyByName(gc @GenCtx, m @ir.Module, ref @ast.TypeExpr, pkg *[]readonly char,
		what *[]readonly char) (@[]char, @[]char, bool) {
	var none @[]char
	if ref.Kind == ast.TEXPR_NAMED {
		var refPkg @[]char = buf.CopyStr(pkg)
		if len(ref.Pkg) > 0 {
			refPkg = homedQualifier(m, ref.Pkg, ref.Name)
		} else if ir.LookupModuleInterfaceIndex(m, refPkg, ref.Name) < 0 &&
				ir.LookupModuleInterfaceIndex(m, "", ref.Name) >= 0 {
			// The universe interface (`any`), when pkg declares none of that name.
			var universe @[]char
			refPkg = universe
		}
		return refPkg, buf.CopyStr(ref.Name), true
	}
	if ref.Kind != ast.TEXPR_INSTANTIATE || ref.Base == nil || ref.Base.Kind != ast.TEXPR_NAMED {
		return none, none, false
	}
	var lookupPkg @[]char = buf.CopyStr(pkg)
	if len(ref.Base.Pkg) > 0 { lookupPkg = homedQualifier(m, ref.Base.Pkg, ref.Base.Name) }
	var gd @ast.Decl = lookupGenericIfaceDeclPkg(gc, lookupPkg, ref.Base.Name)
	if gd == nil { panicGenericIfaceMissing(what, lookupPkg, ref.Base.Name) }
	var argTypes @[]@types.Type
	for ai := 0; ai < len(ref.TypeArgs); ai++ {
		argTypes = slices.Append[@types.Type](argTypes, resolveTypeExpr(gc, ref.TypeArgs[ai]))
	}
	return buf.CopyStr(lookupPkg), ensureInstantiatedInterface(gc, gd, argTypes, lookupPkg), true
}

// isUniverseAnyKey reports whether (pkg, name) is the universe interface `any`, which
// every type satisfies and every interface extends without saying so: an impl or
// an extension clause that lists it adds nothing, so it is left out -- `impl T :
// any` makes no row, and `interface X : any` has the layout `interface X` has.
func isUniverseAnyKey(pkg *[]readonly char, name *[]readonly char) bool {
	return len(pkg) == 0 && irutil.Streq(name, "any")
}
