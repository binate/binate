package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/builtins/testing"

// Tests for gen_impl_keys.bn: an impl's rows key its receiver and its listed
// interfaces on the types the checker resolved them to, not on how they are
// written.

// declareInSession checks src at the prompt of the session gc / c and generates
// it, as the REPL does -- a type through GenTypeDecls, anything else through
// GenDecl -- returning what generating it reports ("" when it succeeds).
func declareInSession(gc @GenCtx, c @check.Checker, src *[]readonly char) @[]char {
	var d @ast.Decl = checkedReplDecl(c, src)
	if d.Kind == ast.DECL_TYPE { return GenTypeDecls(@[]@ast.Decl{d}, gc) }
	return GenDecl(d, gc)
}

// implSession returns a REPL session that declares U, its method M, the interface
// I that M satisfies, and J, an alias of I, each checked and generated; or a
// message naming the declaration that failed.
func implSession() (@GenCtx, @check.Checker, @[]char) {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"test\"\nfunc main() {}\n")
	var srcs @[]*[]readonly char = @[]*[]readonly char{
			"type U struct { a int }", "func (u *U) M() int { return u.a }", "interface I { M() int }",
			"interface J = I"}
	for i := 0; i < len(srcs); i++ {
		var msg @[]char = declareInSession(gc, c, srcs[i])
		if len(msg) > 0 { return gc, c, buf.Concat(buf.Concat(srcs[i], ": "), msg) }
	}
	var none @[]char
	return gc, c, none
}

// The receiver key is the checker's base type of the receiver: a checked `impl *U :
// I`, and one through an alias of U, whose written receivers are then renamed,
// still key on U.  An unchecked impl keys on its written receiver.
func TestImplRecvKeyIsTheCheckersType() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	var msg @[]char
	gc, c, msg = implSession()
	if len(msg) > 0 { return fail(msg) }
	msg = declareInSession(gc, c, "type UA = U")
	if len(msg) > 0 { return fail(buf.Concat("type UA = U: ", msg)) }
	var srcs @[]*[]readonly char = @[]*[]readonly char{"impl *U : I", "impl *UA : I"}
	for i := 0; i < len(srcs); i++ {
		var d @ast.Decl = checkedReplDecl(c, srcs[i])
		if d.TypeRef.Base == nil { return fail("the receiver should be a pointer") }
		d.TypeRef.Base.Name = "T"
		var name @[]char
		var pkg @[]char
		name, pkg = implRecvKey(gc, gc.Mod, d, "test")
		if !seq(name, "U") || !seq(pkg, "test") { return fail("a checked receiver keys on U") }
	}
	var name @[]char
	var pkg @[]char
	name, pkg = implRecvKey(gc, gc.Mod, replDecl("impl *T : I"), "test")
	if !seq(name, "T") || !seq(pkg, "test") {
		return fail("an unchecked receiver keys on its written name")
	}
	return ""
}

// The interface key is the interface the checker resolved the listed one to: an
// alias's target, also once the written name is changed.  An unchecked impl's
// interface keys on its written name.
func TestImplIfaceKeyIsTheCheckersInterface() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	var msg @[]char
	gc, c, msg = implSession()
	if len(msg) > 0 { return fail(msg) }
	var d @ast.Decl = checkedReplDecl(c, "impl *U : J")
	d.Interfaces[0].Name = "K"
	var pkg @[]char
	var name @[]char
	var named bool
	pkg, name, named = ifaceRefKey(gc, gc.Mod, d.Interfaces[0], "test", "an impl's interface")
	if !named || !seq(pkg, "test") || !seq(name, "I") {
		return fail("a checked `impl *U : J` keys on I")
	}
	pkg, name, named = ifaceRefKey(gc, gc.Mod, replDecl("impl *U : K").Interfaces[0], "test",
			"an impl's interface")
	if !named || !seq(pkg, "test") || !seq(name, "K") {
		return fail("an unchecked interface keys on its written name")
	}
	pkg, name, named = ifaceRefKey(gc, gc.Mod, replDecl("impl *U : any").Interfaces[0], "test",
			"an impl's interface")
	if !named || len(pkg) != 0 || !seq(name, "any") {
		return fail("an unchecked `any` keys on the universe interface")
	}
	return ""
}

// `impl *U : any` lists the universe interface, which U satisfies without an impl:
// it makes no row.
func TestImplOfUniverseAnyMakesNoRow() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	var msg @[]char
	gc, c, msg = implSession()
	if len(msg) > 0 { return fail(msg) }
	var rows int = len(gc.Mod.Impls)
	msg = declareInSession(gc, c, "impl *U : any")
	if len(msg) > 0 { return fail(buf.Concat("impl *U : any: ", msg)) }
	if len(gc.Mod.Impls) != rows { return fail("`impl *U : any` must make no row") }
	return ""
}

// An interface's parents are the interfaces the checker resolved them to: `S : J`,
// J an alias of I, records I (by its written name it would be J), and `X : any`
// records none, as `any` adds nothing.
func TestCollectInterfaceParentsAreTheCheckers() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	var msg @[]char
	gc, c, msg = implSession()
	if len(msg) > 0 { return fail(msg) }
	var srcs @[]*[]readonly char = @[]*[]readonly char{"interface S : J { N() int }",
			"interface X : any { N() int }"}
	var names @[]*[]readonly char = @[]*[]readonly char{"S", "X"}
	var wantCounts @[]int = @[]int{1, 0}
	for i := 0; i < len(srcs); i++ {
		msg = declareInSession(gc, c, srcs[i])
		if len(msg) > 0 { return fail(buf.Concat(buf.Concat(srcs[i], ": "), msg)) }
		var k int = ir.LookupModuleInterfaceIndex(gc.Mod, "test", names[i])
		if k < 0 { return fail(buf.Concat("not registered: ", names[i])) }
		var mi irsym.ModuleInterface = gc.Mod.Interfaces[k]
		if len(mi.ParentNames) != wantCounts[i] ||
				wantCounts[i] == 1 && (!seq(mi.ParentPkgs[0], "test") || !seq(mi.ParentNames[0], "I")) {
			return fail(buf.Concat("the parents recorded for ", names[i]))
		}
	}
	return ""
}
