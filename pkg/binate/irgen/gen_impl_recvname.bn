package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/types"

// Receiver-name resolution for impl-vtable keying (collectImplsFromDecl /
// collectImportedImplsFromDecl in gen_impl.bn).  The vtable and its method
// symbols are keyed on the receiver's TARGET short name + defining package; a
// receiver spelled via a local type alias hides both behind the alias name,
// which recvTypeName's AST walk cannot see through — so these helpers resolve it
// through the type table (bug 754).

// recvBaseNameAndPkg returns the impl receiver's SHORT type name AND its
// defining package for vtable keying.  For an ordinary receiver this is
// (recvTypeName, "") -- the AST name is already the canonical key and the empty
// package tells the caller to derive RecvPkg from recvTypePkg as before.
//
// The one case it diverges is a receiver spelled via a type ALIAS — local
// (`type AB = *pkg.Box; impl AB : Getter`), another package's (`impl
// *home.SA : I`), or an imported package's own (`type LS = home.S; impl *LS : I`
// in its .bni) — see recvAliasEntry: recvTypeName's AST walk sees only
// "AB", but the method decls -- and thus the vtable key + method symbols --
// mangle the receiver by the TARGET's short name and package ("Box" in
// "pkg/box").  IR-gen registers a resolved base type under a package-qualified
// name (`pkg/box.Box` / `main.Box`), so BOTH the short name (segment after the
// last `.`) and the package (segment before it) are read off the resolved base
// and returned together -- keeping them consistent.  Returning only the name
// (and letting the caller derive the package from the pre-alias AST) mis-keys a
// cross-package alias: recvTypePkg sees the bare `AB` (no package) and falls
// back to the IMPL's package, so the (R, I) vtable lands in the wrong namespace
// and dispatch null-crashes -- the very bug 754 symptom (this bit the initial
// fix; it accepted cross-package alias impls that then SIGSEGV'd).
//
// The alias gate is essential: resolving EVERY receiver through the type table
// would key imported/cross-package receivers on their qualified registered name
// and primitive receivers on the carve-out path (`pkg/builtins/lang.int`) --
// both of which break codegen when spelled into an LLVM vtable global name.
// (Local distinct named types also pass the gate -- they too live in
// TypeAliases -- but resolve to the same name qualified by the current module,
// the package the caller defaults an unqualified receiver to, so nothing
// changes.)
func recvBaseNameAndPkg(gc @GenCtx, te @ast.TypeExpr) (@[]char, @[]char) {
	var astName @[]char = recvTypeName(te)
	var entry @types.Type = recvAliasEntry(gc, te, astName)
	if entry == nil {
		// Not an alias / distinct-named receiver -- AST name is canonical.
		return astName, ""
	}
	// Peel the entry found — not a re-resolution of te, whose bare-name-first
	// lookup could pick a same-named type of the module being generated over
	// the imported package's alias.
	var base @types.Type = peelToNamedBase(entry)
	if base != nil && len(base.Name) > 0 &&
			(base.Kind == types.TYP_STRUCT || base.Kind == types.TYP_NAMED) {
		return shortTypeName(base.Name), qualifierTypeName(base.Name)
	}
	return astName, ""
}

// recvAliasEntry returns the TypeAliases entry the receiver's name refers to, or
// nil when it names no alias / distinct named type — looked up under the name
// IR-gen registered it by: a QUALIFIED receiver (`impl *home.SA : I`, also
// through an `expose` forwarder) under the member's home package path; an
// unqualified one in an imported package's declarations (CurrentImportPkg set —
// `type LS = home.S; impl *LS : I` in that package's .bni) under that package's
// path; otherwise the current module's own name.
func recvAliasEntry(gc @GenCtx, te @ast.TypeExpr, astName *[]readonly char) @types.Type {
	var qual @[]char = recvTypePkg(te)
	if len(qual) > 0 {
		return lookupTypeAlias(gc, buildQualNameHomed(gc.Mod, qual, astName))
	}
	if len(gc.Mod.CurrentImportPkg) > 0 {
		var t @types.Type = lookupTypeAlias(gc, qualNameInPkg(gc.Mod.CurrentImportPkg, astName))
		if t != nil { return t }
	}
	return lookupTypeAlias(gc, astName)
}

// peelToNamedBase strips the pointer/managed/readonly wrappers a resolved
// receiver type carries, down to the base type recvBaseNameAndPkg keys the
// vtable on.  Mirrors ReceiverBaseNamed's wrapper set but stays in IR-gen's
// TYP_STRUCT world (structs are TYP_STRUCT with Name here, not TYP_NAMED).
func peelToNamedBase(t @types.Type) @types.Type {
	for t != nil {
		if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR ||
				t.Kind == types.TYP_READONLY {
			t = t.Elem
			continue
		}
		return t
	}
	return nil
}

// shortTypeName returns the short (unqualified) segment of an IR-gen type name,
// dropping any `pkg.` / `pkg/path.` qualifier (the part up to and including the
// last `.`).  A bare name is returned unchanged.
func shortTypeName(name @[]char) @[]char {
	var cut int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			cut = i
		}
	}
	if cut < 0 {
		return name
	}
	var out @[]char = make_slice(char, len(name) - cut - 1)
	for i := cut + 1; i < len(name); i++ {
		out[i - cut - 1] = name[i]
	}
	return out
}

// qualifierTypeName returns the package-qualifier segment of an IR-gen type name
// (the part before the last `.`, already the full package path since IR-gen
// qualifies every type name by its package's path), or ""
// if the name is bare (same-package / unqualified).  Complements shortTypeName:
// name == qualifierTypeName(name) + "." + shortTypeName(name) when qualified.
func qualifierTypeName(name *[]readonly char) @[]char {
	var cut int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			cut = i
		}
	}
	if cut < 0 {
		var empty @[]char
		return empty
	}
	var out @[]char = make_slice(char, cut)
	for i := 0; i < cut; i++ {
		out[i] = name[i]
	}
	return out
}
