package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_impl_recvname.bn — receiver short-name + package resolution for
// impl-vtable keying, including the local-alias peel (bug 754).  Helpers
// (genFromSourcePkg, charsEqualOpt, fail) live in ir_test.bn.

// An `impl` whose receiver is a LOCAL ALIAS to a same-package pointer-to-struct
// (`type AB = *T; impl AB : I`) must key the ImplInfo on the TARGET's short name
// "T" (the name the method decls mangle to), not the alias's "AB".  Keying on
// "AB" leaves the vtable slot null and dispatch crashes at runtime.
func TestRecvAliasImplKeysOnTarget() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"type AB = *T\n"
					"impl AB : I\n")
	var m @ir.Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 1 { return fail("expected 1 impl info") }
	var info @irdata.ImplInfo = m.Impls[0]
	if !charsEqualOpt(info.RecvTypeName, "T") {
		return fail("alias-receiver RecvTypeName should peel to target T")
	}
	if !charsEqualOpt(info.IfaceName, "I") {
		return fail("IfaceName should be I")
	}
	if len(info.MethodFuncs) != 1 {
		return fail("expected 1 method slot")
	}
	if !charsEqualOpt(info.MethodFuncs[0], "test.T.foo") {
		return fail("MethodFuncs[0] should key on the target: test.T.foo")
	}
	return ""
}

// A non-alias receiver is unaffected — the alias gate is a strict no-op, so the
// ImplInfo keys on the AST name exactly as before.
func TestRecvNonAliasUnchanged() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n")
	var m @ir.Module = genFromSourcePkg(buf.CopyStr(cb.String()))
	if len(m.Impls) != 1 { return fail("expected 1 impl info") }
	if !charsEqualOpt(m.Impls[0].RecvTypeName, "T") {
		return fail("non-alias RecvTypeName should be T")
	}
	return ""
}

// shortTypeName drops the package qualifier (segment up to and including the
// last `.`); a bare name is returned unchanged.
func TestShortTypeName() testing.TestResult {
	if !charsEqualOpt(shortTypeName(buf.CopyStr("Box")), "Box") {
		return fail("bare name should be unchanged")
	}
	if !charsEqualOpt(shortTypeName(buf.CopyStr("main.Box")), "Box") {
		return fail("module qualifier should be dropped")
	}
	if !charsEqualOpt(shortTypeName(buf.CopyStr("pkg/box.Box")), "Box") {
		return fail("path qualifier should be dropped")
	}
	if len(shortTypeName(buf.CopyStr("pkg/box."))) != 0 {
		return fail("trailing dot yields empty short name")
	}
	return ""
}

// qualifierTypeName returns the segment before the last `.` (empty for a bare
// name); it is the exact complement of shortTypeName.
func TestQualifierTypeName() testing.TestResult {
	if len(qualifierTypeName(buf.CopyStr("Box"))) != 0 {
		return fail("bare name has no qualifier")
	}
	if !charsEqualOpt(qualifierTypeName(buf.CopyStr("main.Box")), "main") {
		return fail("qualifier of main.Box should be main")
	}
	if !charsEqualOpt(qualifierTypeName(buf.CopyStr("pkg/box.Box")), "pkg/box") {
		return fail("qualifier of pkg/box.Box should be the full path pkg/box")
	}
	return ""
}

// recvAliasEntry finds an alias under the name IR-gen registered it by: a
// qualified receiver (`home.SA`) under the home package's path, and an
// unqualified one inside that package's own declarations (CurrentImportPkg)
// likewise; a struct receiver is no alias.
func TestRecvAliasEntryImportedAlias() testing.TestResult {
	var m @ir.Module = InitModule("\"main\"")
	var src *[]readonly char = "package \"pkg/home\"\ntype S struct { N int }\ntype SA = S\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "home.bni")
	var file @ast.File = p.ParseFile()
	var gc @GenCtx = NewGenCtx(m)
	RegisterImport("home", "pkg/home", file, gc)
	var qualAlias @ast.TypeExpr = make(ast.TypeExpr)
	qualAlias.Kind = ast.TEXPR_NAMED
	qualAlias.Pkg = "home"
	qualAlias.Name = "SA"
	if recvAliasEntry(gc, qualAlias, "SA") == nil {
		return fail("home.SA should be found as pkg/home.SA")
	}
	var qualStruct @ast.TypeExpr = make(ast.TypeExpr)
	qualStruct.Kind = ast.TEXPR_NAMED
	qualStruct.Pkg = "home"
	qualStruct.Name = "S"
	if recvAliasEntry(gc, qualStruct, "S") != nil {
		return fail("the struct home.S is not an alias")
	}
	var bare @ast.TypeExpr = make(ast.TypeExpr)
	bare.Kind = ast.TEXPR_NAMED
	bare.Name = "SA"
	m.CurrentImportPkg = "pkg/home"
	if recvAliasEntry(gc, bare, "SA") == nil {
		return fail("SA inside pkg/home's declarations should be found as pkg/home.SA")
	}
	return ""
}
