package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irdata"

import "pkg/binate/irutil"

import "pkg/binate/ir"
import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// reflectPackageStructType returns the `reflect.Package` STRUCT type (the
// TYP_NAMED wrapper peeled to its underlying struct), or nil if the checker
// has no reflect type loaded.  It is the result-element shape of the
// compiler-synthesized `__Package() @reflect.Package` accessor — the managed
// pointer to this struct.  The checker path-qualifies reflect.Package's
// fields (Option B step 3), so the mangler folds them to reflect's symbols.
// Shared by the imported-package registration (RegisterImport) and the
// current-package registration (registerCurrentModulePackageAccessor).
func reflectPackageStructType(c @check.Checker) @types.Type {
	if c == nil { return nil }
	var reflectPkgTy @types.Type = c.PackageType("pkg/builtins/reflect", "Package")
	if reflectPkgTy == nil { return nil }
	if reflectPkgTy.Kind == types.TYP_NAMED && reflectPkgTy.Underlying != nil {
		return reflectPkgTy.Underlying
	}
	return reflectPkgTy
}

// registerCurrentModulePackageAccessor registers the CURRENT module's
// compiler-synthesized `__Package() @reflect.Package` accessor in Module.FuncSigs,
// so an UNQUALIFIED `__Package()` call (a bare Ident, genCall's funcRefName
// path) resolves its result type and lowers to a call of the local
// `__Package` symbol — codegen's emit_pkg_descriptor.bn emits the matching
// `define` in this same module.  Mirrors RegisterImport's registration of an
// IMPORTED package's `__Package`, but keyed on the current module's qualified
// name (so lookupFunc* — which normalize a bare name via
// qualifyForCurrentModule — find it) and with no extern decl (the body is in
// this TU).
func registerCurrentModulePackageAccessor(gc @GenCtx, c @check.Checker) {
	var reflectStruct @types.Type = reflectPackageStructType(c)
	if reflectStruct == nil { return }
	var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
	pkgResults[0] = types.MakeManagedPtrType(reflectStruct)
	var pkgSig irdata.FuncSig
	pkgSig.Name = qualifyForCurrentModule(gc, "__Package")
	pkgSig.Results = pkgResults
	setOrAppendFuncSig(gc, pkgSig)

	// Stash the full `func() @reflect.Package` func-value type on the
	// module so the backends can self-list this accessor in the
	// per-package reflect Functions table.  The backends can't re-derive
	// reflect.Package (it lives in the checker), so they read this one
	// object — making the __Package FunctionInfo entry byte-identical
	// across LLVM and native by construction.
	var noParams @[]@types.Param
	gc.Mod.PackageAccessorSig = types.MakeFuncValueType(noParams, pkgResults)
}

// lastPathSegment is the local copy of cmd/bnc's shortName — IR
// needs it for pushFileImports and avoids the cmd-only dependency.
func lastPathSegment(p *[]readonly char) @[]char {
	var last int = 0
	for i := 0; i < len(p); i++ {
		if p[i] == '/' { last = i + 1 }
	}
	return buf.CopyStr(p[last:])
}

// unquote strips surrounding quotes (delegates to mangle's helper).
func unquote(s *[]readonly char) @[]char {
	return mangle.PkgPathFromQuoted(s)
}

// RecordImportPath maps an import alias to its full package path
// (the import path, e.g. `bni` → `cmd/bni`), so cross-package
// qualified names expand to the full path used by the importee's
// own compilation (see resolveImportPkg).  First write wins, so a
// caller that knows the true import path should call this before
// any file-based fallback runs.  No-op for an empty path.
//
// The path must be the IMPORT PATH, not the file's declared package
// name: a cmd package declares `package "main"` but is imported by
// its path (`cmd/bni`), and the importee compiles under that path —
// so a `file.PkgName`-based mapping (`bni → main`) would mis-qualify
// its symbols and collide with the importer's own `main`.
func RecordImportPath(m @ir.Module, alias *[]readonly char, path *[]readonly char) {
	if len(path) == 0 { return }
	for i := 0; i < len(m.ImportAliasNames); i++ {
		if irutil.Streq(m.ImportAliasNames[i], alias) { return }
	}
	m.ImportAliasNames = slices.Append[@[]char](m.ImportAliasNames, buf.CopyStr(alias))
	m.ImportAliasPaths = slices.Append[@[]char](m.ImportAliasPaths, buf.CopyStr(path))
}

// RebindImportPath binds alias to path in m's import-alias map, REPLACING any
// existing binding of alias — for a scope whose imports can shadow earlier ones
// under the same name (a REPL prompt's `import`, which the checker also
// rebinds), unlike RecordImportPath's first-wins.
func RebindImportPath(m @ir.Module, alias *[]readonly char, path *[]readonly char) {
	var names @[]@[]char
	var paths @[]@[]char
	for i := 0; i < len(m.ImportAliasNames); i++ {
		if irutil.Streq(m.ImportAliasNames[i], alias) { continue }
		names = slices.Append[@[]char](names, m.ImportAliasNames[i])
		paths = slices.Append[@[]char](paths, m.ImportAliasPaths[i])
	}
	m.ImportAliasNames = names
	m.ImportAliasPaths = paths
	RecordImportPath(m, alias, path)
}

// registerImportsImpl registers multiple imported packages with cross-
// package type resolution.  paths[k] is the import path for
// aliases[k] (e.g. "pkg/binate/loader") — passed explicitly rather than
// derived from file.PkgName so a cmd's `package "main"` still
// qualifies under its import path.  regExterns is threaded to
// registerImportFieldsAndFuncs (see there): true for the normal build path,
// false for the REPL's mid-session import.
func registerImportsImpl(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx,
		regExterns bool) {
	// gc is the threaded per-compilation context for the import pre-pass.
	// gc.Mod is the importing module; its PkgPath is still empty here
	// (GeneratePackage hasn't run), matching the former ""-valued global
	// during import registration — qualification uses the explicit import
	// paths instead.
	// Pass 0: record alias → full-path mappings, so the importer's
	// source-level qualifiers resolve to the imported packages' paths.
	for k := 0; k < len(aliases); k++ {
		RecordImportPath(gc.Mod, aliases[k], paths[k])
	}
	// Pass 1: register all struct type names from all imports.
	// Generic struct decls (TypeParams non-empty) stash in
	// gc.GenericTypeDecls under the import alias instead; per-(decl,
	// args) instantiations land in Module.Structs lazily at use
	// sites.
	for k := 0; k < len(aliases); k++ {
		if importPathSeenBefore(paths, k) { continue }
		var pkgPath @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				if len(d.TypeParams) > 0 {
					if lookupGenericTypeDeclPkg(gc, pkgPath, d.Name) == nil {
						gc.GenericTypeDecls = slices.Append[@ast.Decl](
								gc.GenericTypeDecls, d)
						gc.GenericTypeDeclPkgs = slices.Append[@[]char](
								gc.GenericTypeDeclPkgs, buf.CopyStr(pkgPath))
						gc.GenericTypeDeclFiles = slices.Append[@ast.File](
								gc.GenericTypeDeclFiles, file)
					}
					continue
				}
				var qualName @[]char = qualNameInPkg(pkgPath, d.Name)
				// Only add if not already registered
				if lookupStructIdx(gc, qualName) < 0 {
					var ms irsym.ModuleStruct
					ms.Name = qualName
					var noFields @[]@types.Field
					ms.Typ = types.MakeStructType(qualName, noFields)
					gc.Mod.Structs = slices.Append[irsym.ModuleStruct](gc.Mod.Structs, ms)
				}
			}
		}
	}

	// Pass 2: populate struct fields, register functions and
	// constants.  Each declaration resolves under its own source file's
	// imports (declImports, in registerImportFieldsAndFuncs), so
	// cross-package refs inside it (impls naming aliases that file
	// imports — e.g. hello's `impl *Hello : aliases.Hello` referencing
	// pkg/aliases — and method signatures' types) resolve via THAT FILE'S
	// aliases, not the importing module's.
	for k := 0; k < len(aliases); k++ {
		if importPathSeenBefore(paths, k) { continue }
		var pkgPath @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		gc.Mod.CurrentImportPkg = pkgPath
		registerImportFieldsAndFuncs(gc, pkgPath, file, gc.Mod, regExterns)
	}
	var noPkg @[]char
	gc.Mod.CurrentImportPkg = noPkg
}

// importPathSeenBefore reports whether paths[k] occurs earlier in paths.  A file
// may import one package under several names — a blank import plus a named one,
// two aliases — and every name is recorded (pass 0), but the package's
// declarations are registered once: registering them again adds a second extern
// Func for every function, which the LLVM backend then declares twice.
func importPathSeenBefore(paths @[]@[]char, k int) bool {
	for j := 0; j < k; j++ {
		if irutil.Streq(paths[j], paths[k]) { return true }
	}
	return false
}

// RegisterImports registers imported packages with cross-package type resolution
// AND adds their extern Func entries so cross-package calls resolve at link time.
func RegisterImports(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerImportsImpl(aliases, paths, normalizeFileDeclsAll(files), gc, true)
}

// RegisterImportFuncSigs is RegisterImports WITHOUT adding the imported extern
// Func entries (regExterns=false): it registers the callees' signatures
// (variadic-ness, param/result types) for call-site resolution but leaves the
// module's func table untouched.  The REPL's mid-session import uses it so a
// following per-decl LowerOneFunc's baked indices stay in sync with the VM's func
// table; the callee itself resolves through the VM's native extern table.
func RegisterImportFuncSigs(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerImportsImpl(aliases, paths, normalizeFileDeclsAll(files), gc, false)
}

// registerImportFieldsAndFuncs does the second pass of import registration:
// populates struct fields and registers function signatures, each declaration
// under its own source file's imports (declImports).
// Assumes all struct names are already registered.
func registerImportFieldsAndFuncs(gc @GenCtx, pkgPath *[]readonly char, file @ast.File,
		mod @ir.Module, regExterns bool) {
	var di @declImports = beginDeclImports(gc, file)
	// regExterns=false registers the imported functions' SIGNATURES (Module.FuncSigs
	// — enough for a call site to resolve variadic-ness, param, and return types)
	// but does NOT add their EXTERN Func entries to mod.Funcs.  The REPL's
	// mid-session import passes false: mod is the live session module whose func
	// index space is already mirrored 1:1 into the VM's func table, and a
	// per-decl LowerOneFunc that follows bakes indices against it — appending
	// extern Funcs mid-session desyncs the two, so a later prompt's synthetic (e.g.
	// a `var` initializer) calls a stale index and executes an unlowered extern as
	// bytecode → SIGSEGV.  The mid-session callee resolves through the VM's native
	// extern table instead (an injected package like pkg/builtins/testing), so the
	// IR extern is unneeded there.  Every non-REPL caller passes true.
	// Slice 2.7: register imported interfaces in the module's interface registry
	// under the import alias's pkg, so `*alias.Iface` /
	// `@alias.Iface` use sites resolve and findInterfaceMethod /
	// findImplVtableName see the imported method set.
	stashGenericIfaceDecls(gc, file, pkgPath)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, pkgPath, di.use(gc, d))
		}
	}

	// Register type aliases — before the impls below, whose receiver may be
	// spelled through one of this package's aliases (`type LS = home.S;
	// impl *LS : I`; recvBaseNameAndPkg peels it only if registered).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isNonStructTypeDecl(d) {
			di.use(gc, d)
			var qualName @[]char = qualNameInPkg(pkgPath, d.Name)
			var ta irsym.ModuleTypeAlias
			ta.Name = qualName
			ta.Typ = typeDeclEntryType(gc, qualName, d)
			gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		}
	}

	// Slice 2.8: register imported impls so cross-package iv
	// constructions in this TU can find the vtable's mangled name.
	// The vtable global itself was emitted by the imported
	// package's TU (with weak_odr linkage); we just need
	// findImplVtableName to recognize the (R, I) pair and produce
	// the same canonical symbol.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_IMPL {
			noteGenericImplDecl(gc, d, pkgPath, di.use(gc, d))
			collectImportedImplsFromDecl(gc, d, pkgPath, mod)
		}
	}

	// Populate struct fields.  Generic struct decls are skipped — their fields
	// stay in AST form until an instantiation site resolves them under the right
	// type-param context (ensureInstantiatedStruct).  Resolving them eagerly here
	// has no binders in scope, so a generic-typed field (`Cursor`'s
	// `t @Table[K,V,H,E]`) would degrade every param to the TypInt() fallback and
	// spuriously register a bogus all-`int` instantiation (Table[int,int,int,int])
	// with dead dtor/copy/reflect symbols.  Mirrors gen_module's second pass.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			if len(d.TypeParams) > 0 {
				continue
			}
			var qualName @[]char = qualNameInPkg(pkgPath, d.Name)
			var si int = lookupStructIdx(gc, qualName)
			if si >= 0 {
				di.use(gc, d)
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(gc, fd.Type)
					fields = slices.Append[@types.Field](fields, f)
				}
				var existTyp @types.Type = gc.Mod.Structs[si].Typ
				existTyp.Fields = fields
			}
		}
	}

	// Register function and method signatures, and add extern funcs
	// to the module so cross-package calls resolve.  Generic decls
	// (TypeParams non-empty) carry their body in the imported .bni
	// — stash them under the import alias so call-site
	// monomorphization at the consumer can look them up via
	// lookupGenericDeclPkg.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			if d.Recv == nil && lookupGenericDeclPkg(gc, pkgPath, d.Name) == nil {
				gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
				gc.GenericDeclPkgs = slices.Append[@[]char](
						gc.GenericDeclPkgs, buf.CopyStr(pkgPath))
				gc.GenericDeclFiles = slices.Append[@ast.File](
						gc.GenericDeclFiles, file)
			}
			continue
		}
		if isGenericReceiverMethod(d) {
			// Imported method on a generic type — its receiver `@Box[T]` can't
			// resolve here (T is unbound), so DON'T register a (garbage) extern
			// sig.  Stash it — keyed by the DEFINING package path, matching the
			// instantiation's InstDefPkg — so the consumer emits it per
			// instantiation at its use sites (ensureInstantiatedMethods), like a
			// same-package generic-receiver method.
			stashGenericMethodDecl(gc, d, buf.CopyStr(pkgPath), file)
			continue
		}
		di.use(gc, d)
		var qualName @[]char
		var sigParams @[]@types.Type
		var extParams @[]@ir.Param
		if d.Recv != nil {
			// Method: name as "<pkgPath>.<TypeName>.<MethodName>";
			// receiver is Params[0].  Resolve the import alias to the
			// full package path so the registered name matches the
			// call-site form (genMethodCall qualifies the receiver's
			// full-path-resolved type name).
			qualName = methodQualName(buf.CopyStr(pkgPath), d)
			var rt @types.Type = resolveTypeExpr(gc, d.Recv.Type)
			sigParams = slices.Append[@types.Type](sigParams, rt)
			var rp @ir.Param = make(ir.Param)
			rp.Name = d.Recv.Name
			rp.Typ = rt
			extParams = slices.Append[@ir.Param](extParams, rp)
		} else {
			qualName = qualNameInPkg(pkgPath, d.Name)
		}
		for j := 0; j < len(d.Params); j++ {
			var pt @types.Type = irResolveParamType(gc, d.Params[j])
			sigParams = slices.Append[@types.Type](sigParams, pt)
			var p @ir.Param = make(ir.Param)
			p.Name = d.Params[j].Name
			p.Typ = pt
			extParams = slices.Append[@ir.Param](extParams, p)
		}

		var sig irdata.FuncSig
		sig.Name = qualName
		sig.Params = sigParams
		sig.IsVariadic = declIsVariadic(d)
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = slices.Append[@types.Type](sigResults, resolveTypeExpr(gc, d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = irutil.MakeMultiReturnStructType(sigResults)
		}
		ir.RegisterFuncSig(gc.Mod, sig)

		var ef @ir.Func = irbuild.NewExternFunc(gc.PkgPath, qualName, extParams, sigResults)
		if regExterns {
			mod.AddFunc(ef)
		}
	}

	// Every package has a compiler-generated `__Package() @reflect.Package`
	// accessor (Phase B / codegen's emit_pkg_descriptor.bn).  It is not
	// declared in the .bni, so register it here as an imported extern: a
	// cross-package `pkg.__Package()` call then resolves (lookupFuncResults)
	// and codegen emits the matching `declare`; the imported package's own
	// compile emits the body.
	var reflectStruct @types.Type = reflectPackageStructType(mod.Checker)
	if reflectStruct != nil {
		var pkgQual @[]char = qualNameInPkg(pkgPath, "__Package")
		var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
		pkgResults[0] = types.MakeManagedPtrType(reflectStruct)
		var pkgSig irdata.FuncSig
		pkgSig.Name = pkgQual
		pkgSig.Results = pkgResults
		ir.RegisterFuncSig(gc.Mod, pkgSig)
		if regExterns {
			var pkgNoParams @[]@ir.Param
			mod.AddFunc(irbuild.NewExternFunc(gc.PkgPath, pkgQual, pkgNoParams, pkgResults))
		}
	}

	registerImportConstsAndVars(gc, pkgPath, file)
	di.end(gc)
}
