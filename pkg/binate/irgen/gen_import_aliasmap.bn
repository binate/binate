package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"

// pushFileImports snapshots the alias map and overlays file's own
// imports (the explicit alias, else the path's last segment) so the
// file's type and interface refs resolve via THAT FILE'S aliases — not
// whichever alias happened to win the global first-wins dedup across
// broadly-loaded packages.  Each file's imports unambiguously bind
// aliases within that file by source-level constraint; the map
// collision only arises from CONFLATING different files' aliases.  The
// overlay is AUTHORITATIVE (overlayFileImports): an entry already in
// the map under an alias the file rebinds — e.g. an importer's
// single-segment `import "lib"` while the file imports
// "pkg/other/lib" — is dropped for the duration, so the file's `lib`
// never resolves to the importer's package (a wrong-package type or
// impl binding).  Pop with popFileImports.
func pushFileImports(m @ir.Module, file @ast.File) AliasMapSnapshot {
	var snap AliasMapSnapshot = SaveAliasMapState(m)
	if file == nil { return snap }
	overlayFileImports(m, snap, file)
	return snap
}

// popFileImports restores the alias map from a pushFileImports
// snapshot.
func popFileImports(m @ir.Module, snap AliasMapSnapshot) {
	m.ImportAliasNames = snap.Names
	m.ImportAliasPaths = snap.Paths
}

// SaveAliasMapState captures m's import-alias map (m.ImportAliasNames /
// m.ImportAliasPaths) into a snapshot without applying any overlay.  Paired
// with RestoreAliasMapState to bracket a temporary import overlay: the
// monomorphized generic-body emission in gen_generic.bn (a generic's defining-
// package imports overlay the consumer module's map while its body is gen'd)
// and the per-file overlay in overlayFileImports.
func SaveAliasMapState(m @ir.Module) AliasMapSnapshot {
	var snap AliasMapSnapshot
	snap.Names = m.ImportAliasNames
	snap.Paths = m.ImportAliasPaths
	return snap
}

// RestoreAliasMapState writes back a snapshot from SaveAliasMapState over m's
// import-alias map.  Sibling of popFileImports but without the pop-by-snapshot
// file-imports overlay assumption — the generic-instantiation passes /
// overlayFileImports pair it with SaveAliasMapState to restore the map after a
// temporary overlay.
func RestoreAliasMapState(m @ir.Module, snap AliasMapSnapshot) {
	m.ImportAliasNames = snap.Names
	m.ImportAliasPaths = snap.Paths
}
