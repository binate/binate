package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"
import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// TestAliasMapSaveRestoreRoundTrip covers SaveAliasMapState / RestoreAliasMapState:
// a Save captures the current alias map, a later RecordImportPath grows it (via a
// fresh slice, leaving the snapshot's slice intact), and a Restore rewinds the map
// to exactly the saved state — the bracket the generic-body emission relies on.
func TestAliasMapSaveRestoreRoundTrip() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	RecordImportPath(m, "a", "pkg/a")
	if len(m.ImportAliasNames) != 1 { return fail("setup: expected 1 alias") }
	var snap AliasMapSnapshot = SaveAliasMapState(m)
	RecordImportPath(m, "b", "pkg/b")
	if len(m.ImportAliasNames) != 2 { return fail("expected 2 aliases after adding b") }
	RestoreAliasMapState(m, snap)
	if len(m.ImportAliasNames) != 1 { return fail("restore should drop b") }
	if !irutil.Streq(m.ImportAliasNames[0], "a") { return fail("restored alias should be a") }
	if len(m.ImportAliasPaths) != 1 || !irutil.Streq(m.ImportAliasPaths[0], "pkg/a") {
		return fail("restored path should be pkg/a")
	}
	return ""
}

// TestPushPopFileImportsRoundTrip covers pushFileImports / popFileImports: pushing a
// file's imports overlays its aliases (the implicit alias is the path's last
// segment) onto the module's map, and popping with the returned snapshot restores
// the prior map exactly.
func TestPushPopFileImportsRoundTrip() testing.TestResult {
	var p @parser.Parser = parser.New(strToBytes("package \"test\"\nimport \"pkg/foo/bar\"\n"), "test")
	var file @ast.File = mustParse(p)
	var m @ir.Module = ir.NewModule("test")
	var snap AliasMapSnapshot = pushFileImports(NewGenCtx(m), file)
	if len(m.ImportAliasNames) != 1 { return fail("pushFileImports should overlay 1 alias") }
	if !irutil.Streq(m.ImportAliasNames[0], "bar") {
		return fail("implicit alias should be last path segment")
	}
	if !irutil.Streq(m.ImportAliasPaths[0], "pkg/foo/bar") { return fail("overlaid path wrong") }
	popFileImports(m, snap)
	if len(m.ImportAliasNames) != 0 { return fail("popFileImports should restore the empty map") }
	return ""
}

// TestPushFileImportsIsAuthoritative covers the overlay rebinding an alias the map
// already holds: an importer's single-segment `lib` (path "lib") must not shadow
// the pushed file's `import "pkg/other/lib"` while that file is overlaid, and
// popping restores the importer's binding.
func TestPushFileImportsIsAuthoritative() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes("package \"test\"\nimport \"pkg/other/lib\"\n"), "test")
	var file @ast.File = mustParse(p)
	var m @ir.Module = ir.NewModule("test")
	RecordImportPath(m, "lib", "lib")
	var snap AliasMapSnapshot = pushFileImports(NewGenCtx(m), file)
	if !irutil.Streq(irbuild.ResolveImportPkg(m, "lib"), "pkg/other/lib") {
		return fail("the pushed file's `lib` should resolve to pkg/other/lib")
	}
	popFileImports(m, snap)
	if !irutil.Streq(irbuild.ResolveImportPkg(m, "lib"), "lib") {
		return fail("popping should restore the importer's `lib`")
	}
	return ""
}

// parseImportFile parses src, a package clause and imports.
func parseImportFile(src *[]readonly char) @ast.File {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	return mustParse(p)
}

// aliasMapText returns m's alias map as `alias=path` pairs, in order, joined by
// commas.
func aliasMapText(m @ir.Module) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(m.ImportAliasNames); i++ {
		if i > 0 { sb.Write(",") }
		sb.Write(m.ImportAliasNames[i])
		sb.Write("=")
		sb.Write(m.ImportAliasPaths[i])
	}
	return buf.CopyStr(sb.String())
}

// An overlay drops each base entry whose alias the file rebinds and appends the
// file's own imports; overlaying the same file onto the same base again gives
// back the map the first overlay built, not a rebuilt one.
func TestOverlayFileImportsReusesItsMap() testing.TestResult {
	var file @ast.File = parseImportFile("package \"test\"\nimport \"pkg/a/x\"\nimport y \"pkg/b\"\n")
	var m @ir.Module = ir.NewModule("test")
	RecordImportPath(m, "pkg/c", "pkg/c")
	RecordImportPath(m, "x", "pkg/other/x")
	var gc @GenCtx = NewGenCtx(m)
	var base AliasMapSnapshot = SaveAliasMapState(m)
	overlayFileImports(gc, base, file)
	if !irutil.Streq(aliasMapText(m), "pkg/c=pkg/c,x=pkg/a/x,y=pkg/b") {
		return fail("the overlaid map")
	}
	var built AliasMapSnapshot = SaveAliasMapState(m)
	RestoreAliasMapState(m, base)
	overlayFileImports(gc, base, file)
	if !same(m.ImportAliasNames, built.Names) || !same(m.ImportAliasPaths, built.Paths) {
		return fail("a second overlay of the file onto the same base reuses the map")
	}
	return ""
}

// A kept overlay is reused only for the same base and the same import list: onto
// another base, or once the file's import list is replaced, the map is built
// afresh.
func TestOverlayFileImportsRebuildsForANewBaseOrImports() testing.TestResult {
	var file @ast.File = parseImportFile("package \"test\"\nimport \"pkg/a/x\"\n")
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var empty AliasMapSnapshot = SaveAliasMapState(m)
	overlayFileImports(gc, empty, file)
	RecordImportPath(m, "z", "pkg/z")
	var base AliasMapSnapshot = SaveAliasMapState(m)
	overlayFileImports(gc, base, file)
	if !irutil.Streq(aliasMapText(m), "z=pkg/z,x=pkg/a/x") { return fail("onto a new base") }
	var other @ast.File = parseImportFile("package \"test\"\nimport \"pkg/q\"\n")
	file.Imports = other.Imports
	overlayFileImports(gc, empty, file)
	if !irutil.Streq(aliasMapText(m), "q=pkg/q") { return fail("once the import list is replaced") }
	return ""
}

// Within one file the first import of an alias binds it, as RecordImportPath's
// first-wins rule has it.
func TestOverlayFileImportsFirstImportOfAnAliasWins() testing.TestResult {
	var file @ast.File = parseImportFile("package \"test\"\nimport x \"pkg/p1\"\nimport \"pkg/q/x\"\n")
	var m @ir.Module = ir.NewModule("test")
	overlayFileImports(NewGenCtx(m), SaveAliasMapState(m), file)
	if !irutil.Streq(aliasMapText(m), "x=pkg/p1") { return fail("the first import of x binds it") }
	return ""
}

// Overlays of more files than the cache holds stay right: once it is full each
// new overlay replaces the oldest kept one, so a file whose overlay was replaced
// gets its map rebuilt, while the newest overlays are still reused.
func TestOverlayFileImportsPastTheCacheSize() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var base AliasMapSnapshot = SaveAliasMapState(m)
	var files @[]@ast.File = make_slice(@ast.File, overlayCacheSize + 2)
	for i := 0; i < len(files); i++ {
		var sb @strings.Builder = strings.NewBuilder()
		sb.Write("package \"test\"\nimport \"pkg/f")
		stringutils.WriteInt(sb, i)
		sb.Write("\"\n")
		files[i] = parseImportFile(sb.String())
	}
	var last AliasMapSnapshot
	for round := 0; round < 2; round++ {
		for i := 0; i < len(files); i++ {
			overlayFileImports(gc, base, files[i])
			if len(m.ImportAliasPaths) != 1 ||
					!irutil.Streq(m.ImportAliasPaths[0], unquote(files[i].Imports[0].Path)) {
				return fail("each file's overlay binds its own import")
			}
		}
		last = SaveAliasMapState(m)
	}
	overlayFileImports(gc, base, files[len(files) - 1])
	if !same(m.ImportAliasNames, last.Names) || !same(m.ImportAliasPaths, last.Paths) {
		return fail("the newest overlay is still reused once the cache has wrapped")
	}
	return ""
}

// An import with an empty path still rebinds its alias: the base entry under the
// alias is dropped, and the import itself binds nothing (RecordImportPath ignores
// an empty path), so the alias is unbound while the file is overlaid.
func TestOverlayFileImportsEmptyPathDropsItsAlias() testing.TestResult {
	var file @ast.File = parseImportFile("package \"test\"\nimport x \"\"\nimport \"pkg/b\"\n")
	var m @ir.Module = ir.NewModule("test")
	RecordImportPath(m, "x", "pkg/x")
	RecordImportPath(m, "c", "pkg/c")
	overlayFileImports(NewGenCtx(m), SaveAliasMapState(m), file)
	if !irutil.Streq(aliasMapText(m), "c=pkg/c,b=pkg/b") {
		return fail("x is dropped and not rebound")
	}
	return ""
}

// Files with the same import list share an overlay: two files with no imports,
// overlaid onto the same base, get the same map.
func TestOverlayFileImportsSharedBySameImportList() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	RecordImportPath(m, "c", "pkg/c")
	var gc @GenCtx = NewGenCtx(m)
	var base AliasMapSnapshot = SaveAliasMapState(m)
	overlayFileImports(gc, base, parseImportFile("package \"test\"\n"))
	var first AliasMapSnapshot = SaveAliasMapState(m)
	overlayFileImports(gc, base, parseImportFile("package \"other\"\n"))
	if !same(m.ImportAliasNames, first.Names) || !same(m.ImportAliasPaths, first.Paths) {
		return fail("the second import-less file reuses the first's overlay")
	}
	if !irutil.Streq(aliasMapText(m), "c=pkg/c") { return fail("the base, unchanged") }
	return ""
}
