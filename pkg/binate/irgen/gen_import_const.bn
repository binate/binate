package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Imported const-group registration (including iota implicit-repeat) into
// Module.Consts.

// registerImportConstGroup registers a group of iota constants from an
// imported package.  As in the in-package genConstGroup, a bare member repeats
// the previous explicit member's type and initializer, at its own iota.
func registerImportConstGroup(gc @GenCtx, pkgPath *[]readonly char, d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	var prevExpr @ast.Expr = nil
	var prevTyp @types.Type = nil
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			var mc irsym.ModuleConst
			mc.Name = qualNameInPkg(pkgPath, cd.Name)
			if cd.Value != nil {
				prevTyp = nil
				if cd.TypeRef != nil {
					prevTyp = resolveTypeExpr(gc, cd.TypeRef)
				}
			}
			mc.Typ = prevTyp
			var registered bool
			if cd.Value != nil {
				prevExpr = cd.Value
				registered = constFromInitializer(gc, &mc, cd, cd.Value, iotaVal, true, true)
			} else {
				registered = constFromInitializer(gc, &mc, cd, prevExpr, iotaVal, true, false)
			}
			if registered {
				gc.Mod.Consts = slices.Append[irsym.ModuleConst](gc.Mod.Consts, mc)
			}
			iotaVal = iotaVal + 1
		}
	}
}
