package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/builtins/testing"

// Another package's consts register as compile-time values and its vars as
// extern globals, both under their qualified names; registering the same
// package again (a second registration pass) adds no duplicate extern.
func TestRegisterImportConstsAndVars() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/h\"\nconst K int = 2\nvar Count int\n")
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	registerImportConstsAndVars(gc, "pkg/h", file)
	registerImportConstsAndVars(gc, "pkg/h", file)
	var v int
	var ok bool
	v, _, ok = lookupConst(gc, "pkg/h.K")
	if !ok || v != 2 { return fail("expected const pkg/h.K = 2") }
	var n int = 0
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		if irutil.Streq(gc.Mod.GlobalVars[i].Name, "pkg/h.Count") {
			if !gc.Mod.GlobalVars[i].IsExtern { return fail("expected an extern global") }
			n++
		}
	}
	if n != 1 { return fail("expected exactly one pkg/h.Count extern") }
	return ""
}
