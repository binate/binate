package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// reflect.Package's struct name is path-qualified by the checker, so the IR
// uses the checker's PackageType type directly for the synthetic
// `__Package()` descriptor — no rebuild helper.
// The qualified-name behavior is covered end-to-end by conformance 525 /
// 532 (reflect package descriptor + accessor).

// registerImportFieldsAndFuncs registers an imported package's compiler-
// synthesized `__Package()` accessor only when the module's checker has
// reflect.Package's type (reflectPackageStructType): its result is a pointer to
// one.
func TestImportPackageAccessorNeedsReflect() testing.TestResult {
	// Minimal pkg/builtins/reflect so the checker's
	// PackageType("pkg/builtins/reflect", "Package") resolves.
	var rp @parser.Parser = parser.NewInterface(
			strToBytes(
					"package \"pkg/builtins/reflect\"\ntype Package struct { Name int }\n"),
			"reflect.bni")
	var reflectFile @ast.File = mustParse(rp)
	var c @check.Checker = check.NewChecker()
	c.LoadPackageInterface("pkg/builtins/reflect", reflectFile)

	// The imported package whose __Package accessor we probe for.
	var ip @parser.Parser = parser.NewInterface(strToBytes(
			"package \"pkg/foo\"\nfunc Bar()\n"), "foo.bni")
	var fooFile @ast.File = mustParse(ip)
	var paths @[]@[]char = @[]@[]char{"pkg/foo"}

	// A checker with no reflect.Package → no __Package accessor.
	var m1 @ir.Module = testInitModule("\"main\"")
	var files1 @[]@ast.File = make_slice(@ast.File, 1)
	files1[0] = fooFile
	RegisterImports(paths, files1, NewGenCtx(m1))
	if lookupFuncExists(NewGenCtx(m1), "pkg/foo.__Package") {
		return fail("no reflect.Package: imported __Package must NOT be registered")
	}

	// A checker with reflect.Package → the __Package accessor is registered.
	var m2 @ir.Module = testInitModule("\"main\"")
	m2.Checker = c
	var files2 @[]@ast.File = make_slice(@ast.File, 1)
	files2[0] = fooFile
	RegisterImports(paths, files2, NewGenCtx(m2))
	if !lookupFuncExists(NewGenCtx(m2), "pkg/foo.__Package") {
		return fail("reflect.Package: imported __Package must be registered")
	}
	return ""
}

// A package imported under several names (a blank import plus a named one, two
// aliases) is registered once: each of its functions gets one extern Func (two
// would make the LLVM backend declare it twice), and its path is in the import list
// once.
func TestRegisterImportsDuplicatePathOnce() testing.TestResult {
	var m @ir.Module = testInitModule("\"main\"")
	var qaFile @ast.File = checkedBni(m, "pkg/qa", "package \"pkg/qa\"\nfunc Get() int\n")
	var paths @[]@[]char = @[]@[]char{"pkg/qa", "pkg/qa", "pkg/qa"}
	var files @[]@ast.File = make_slice(@ast.File, 3)
	for i := 0; i < 3; i++ { files[i] = qaFile }
	RegisterImports(paths, files, NewGenCtx(m))
	var n int = 0
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "pkg/qa.Get") { n = n + 1 }
	}
	if n != 1 {
		return fail("an imported function must be registered once, however many names import it")
	}
	var listed int = 0
	for i := 0; i < len(m.ImportPaths); i++ {
		if seq(m.ImportPaths[i], "pkg/qa") { listed = listed + 1 }
	}
	if listed != 1 { return fail("the package's path must be in the import list once") }
	return ""
}

// Only the import registration adds to a module's import list -- RegisterImport, even
// for a package that declares nothing, and RegisterImports, each path once, in order
// -- and the passes over the packages a module reaches without importing them add
// nothing.
func TestImportListHoldsTheImportsOnly() testing.TestResult {
	var m @ir.Module = testInitModule("\"main\"")
	var qa @ast.File = checkedBni(m, "pkg/qa", "package \"pkg/qa\"\nfunc Get() int\n")
	var qb @ast.File = checkedBni(m, "pkg/qb",
			"package \"pkg/qb\"\ntype B struct { n int }\nfunc Put(n int)\n")
	var qc @ast.File = checkedBni(m, "pkg/qc", "package \"pkg/qc\"\nfunc Run()\n")
	var qd @ast.File = checkedBni(m, "pkg/qd", "package \"pkg/qd\"\n")
	var gc @GenCtx = NewGenCtx(m)
	RegisterImport("pkg/qa", qa, gc)
	RegisterImport("pkg/qd", qd, gc)
	var reached @[]@[]char = @[]@[]char{"pkg/qb"}
	var reachedFiles @[]@ast.File = @[]@ast.File{qb}
	RegisterStructTypes(reached, reachedFiles, gc)
	RegisterAllInterfaces(reached, reachedFiles, gc)
	RegisterGenericDecls(reached, reachedFiles, gc)
	RegisterGenericBodyDeps(reached, reachedFiles, gc)
	RegisterImportedImpls(reached, reachedFiles, gc)
	RegisterImports(@[]@[]char{"pkg/qc", "pkg/qc"}, @[]@ast.File{qc, qc}, gc)
	var want @[]@[]char = @[]@[]char{"pkg/qa", "pkg/qd", "pkg/qc"}
	var inOrder bool = len(m.ImportPaths) == len(want)
	for i := 0; inOrder && i < len(want); i++ {
		inOrder = seq(m.ImportPaths[i], want[i])
	}
	if !inOrder { return fail("the import list must be pkg/qa, pkg/qd, pkg/qc, in that order") }
	return ""
}
