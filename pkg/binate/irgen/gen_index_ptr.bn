package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// genIndexPtr returns a pointer to an array/slice/pointer element (for field
// access on indexed structs, index-assignment lvalues, and `&coll[i]`).
// The base is evaluated before the index, each exactly once: the operands of
// an index designator evaluate left to right, the same order as a read of
// `coll[i]` (genIndex), so `coll[i]++`, `&coll[i]` and `coll[i].f` evaluate
// them as `coll[i] += 1` and `coll[i]` do.  Each arm below evaluates its base
// (and nil-checks it), then the index, then bounds-checks and GEPs.
// `forDeref` says whether the returned element address WILL be dereferenced
// (load/store) rather than merely address-computed (`&coll[i]`): when true, a
// RAW-POINTER base this function indexes through is nil-checked before the GEP
// (opt-in nil-checking; a no-op unless
// GenCtx.EmitNilChecks is on).  Array bases (an alloca) and slice bases (a
// bounds check catches a nil/short slice) need no such check.  Address-of
// callers pass false so `&nilp[i]` stays a bare address computation.  The
// recursion passes true (a nested `a[i][j]` loads `a[i]` through to reach `[j]`).
// On return ctx.CurBlock is the block emission continues in, which callers read
// back; it is set to b on entry, as genSelectorPtr's is.
func genIndexPtr(ctx @GenContext, b @ir.Block, e @ast.Expr, forDeref bool) @ir.Instr {
	ctx.CurBlock = b
	if e.X == nil || len(e.Args) != 1 { return nil }

	if e.X.Kind == ast.EXPR_IDENT {
		var arrPtr @ir.Instr = lookupVar(ctx, e.X.Name)
		var arrTyp @types.Type = lookupVarType(ctx, e.X.Name)
		if arrPtr != nil && arrTyp != nil {
			// Peel transparent wrappers so a named array (`type Row [3]int`)
			// — or a readonly one — is recognized; element type / length come
			// from the underlying array.  arrPtr (the variable's alloca) is
			// the array's backing regardless of the wrapper, so GEP through it.
			var arrUnd @types.Type = types.StripWrappers(arrTyp)
			if arrUnd != nil && arrUnd.Kind == types.TYP_ARRAY {
				var elemTyp @types.Type = arrUnd.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitConstInt(b, arrUnd.ArrayLen, types.TypInt())
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitGetElemPtr(b, arrPtr, index, elemTyp)
			}
			// Pointer indexing: load pointer value, GEP on it.  Use arrUnd (the
			// peeled type from the array check above) so a named-distinct pointer
			// (`type P *int`) reaches this arm; un-peeled its Kind is TYP_NAMED, so
			// it would fall through the slice/array arms (which miss it too),
			// genIndexPtr returns nil, and genLValueAddr hands back the loaded
			// element VALUE as its address — a wild pointer (SIGSEGV on write).
			if arrUnd != nil && arrUnd.Kind == types.TYP_POINTER {
				var ptrVal @ir.Instr = irbuild.EmitLoad(b, arrPtr, arrUnd)
				var elemTyp @types.Type = arrUnd.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				emitIndexNilCheck(ctx, b, e, ptrVal, forDeref)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				return irbuild.EmitGetElemPtr(b, ptrVal, index, elemTyp)
			}
			// Slice element: GEP a typed pointer to the element in-place,
			// for ANY element type (scalar or struct).  Gating this on a
			// struct element type makes &s[i] on a scalar-element slice
			// fall through to nil; genUnary then re-lowers s[i] as an
			// r-value and hands back the loaded element as if it were a
			// pointer — a wild pointer that SIGSEGVs on write-through.
			// Peel transparent wrappers (named-distinct / alias / readonly) so a
			// named slice (`type RBuf *[]int`) — which the checker accepts here
			// via StripWrappers in checkIndexExpr — is recognized; its backing
			// is a plain slice regardless of the wrapper, so load + GEP through it.
			// Un-peeled, isSliceType(named) is false and this arm falls through to
			// the same wild-pointer SIGSEGV.
			var arrSt @types.Type = types.StripWrappers(arrTyp)
			if isSliceType(arrSt) && arrSt != nil && arrSt.Elem != nil {
				var sliceVal @ir.Instr = irbuild.EmitLoad(b, arrPtr, arrSt)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitSliceLen(b, sliceVal)
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitSliceElemPtr(b, sliceVal, index, arrSt.Elem)
			}
		}
	}
	// A composite-literal array base (`[3]int{4, 5, 6}[i]`) is storage: the
	// literal's alloca (arrayStorageAddr).  Without this arm the element has no
	// address, and a caller that borrows it (a raw interface value, as
	// `testing.Println(lit[i])` takes) or reaches a field through it
	// (`lit[i].f`) is handed the loaded element value in its place.
	if e.X.Kind == ast.EXPR_COMPOSITE {
		// A managed-slice literal whose element is addressed (ast.Expr.LitAddressed:
		// `&@[]T{…}[i]`) is part of the literal, whose one reference owns the
		// backing: genCompositeAddr's slot holds it, so a `var` / `:=` initializer
		// co-scopes it with the binding (expr.composite.lifetime), and the element
		// is indexed through the slot's value.
		var litMs @types.Type = checkedManagedSliceType(ctx, e.X)
		if litMs != nil && e.X.LitAddressed && litMs.Elem != nil {
			var litSlot @ir.Instr = genCompositeAddr(ctx, b, e.X)
			b = ctx.CurBlock
			var msVal @ir.Instr = irbuild.EmitLoad(b, litSlot, litMs)
			var msIndex @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			genIndexBoundsCheck(ctx, b, e, msIndex, irbuild.EmitSliceLen(b, msVal))
			return irbuild.EmitSliceElemPtr(b, msVal, msIndex, litMs.Elem)
		}
		var litArr @types.Type = checkedArrayType(ctx, e.X)
		if litArr != nil {
			var litPtr @ir.Instr = arrayStorageAddr(ctx, b, e.X)
			b = ctx.CurBlock
			var irArr @types.Type = irArrayType(litPtr)
			if irArr != nil { litArr = irArr }
			var litElem @types.Type = litArr.Elem
			if litElem == nil { litElem = types.TypInt() }
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			genIndexBoundsCheck(ctx, b, e, index, irbuild.EmitConstInt(b, litArr.ArrayLen, types.TypInt()))
			return irbuild.EmitGetElemPtr(b, litPtr, index, litElem)
		}
	}
	// Selector base: e.g., c.Items[i] where c.Items is a selector
	if e.X.Kind == ast.EXPR_SELECTOR {
		var collTyp @types.Type = getSelectorType(ctx, e.X)
		// getSelectorType resolves fields through its own struct tables, which
		// miss some bases (a field of a generic instantiation, `mk[int]().m`);
		// the checker's type of the selector covers them.  Without it this arm
		// returns nil having evaluated nothing, and the caller's fallback
		// re-lowers the expression as a value.
		if collTyp == nil && ctx.Checker != nil && e.X.ResolvedTypeID != 0 {
			collTyp = ctx.Checker.ExprType(e.X.ResolvedTypeID)
		}
		// Peel transparent wrappers so a named-array field (`type Row [3]int`)
		// — or a readonly one — is recognized; the field pointer (arrPtr) is
		// the array's backing regardless of the wrapper.
		var collArr @types.Type = types.StripWrappers(collTyp)
		if collArr != nil && collArr.Kind == types.TYP_ARRAY {
			// Array field: get pointer to the array field, then GEP for element
			// (indexed/read below — a deref — so forDeref=true).
			var arrPtr @ir.Instr = genSelectorPtr(ctx, b, e.X, true)
			b = ctx.CurBlock
			if arrPtr != nil {
				var elemTyp @types.Type = collArr.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitConstInt(b, collArr.ArrayLen, types.TypInt())
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitGetElemPtr(b, arrPtr, index, elemTyp)
			}
		}
		// Pointer-field element: load the pointer VALUE from the field and GEP
		// through it (`&s.p[i]` where `p` is a raw-pointer field).  Without this
		// arm the SELECTOR base has no pointer case, so genIndexPtr returns nil and
		// genLValueAddr hands back the loaded pointer value as the element address
		// — a wild pointer (SIGSEGV on write).  Not named-distinct-specific (a
		// plain `*int` field needs it); collArr is peeled so a named pointer field
		// is recognized too.  Pointers carry no length, so no bounds check (as in
		// the IDENT pointer arm).
		if collArr != nil && collArr.Kind == types.TYP_POINTER {
			var ptrVal @ir.Instr = genExpr(ctx, b, e.X)
			b = ctx.CurBlock
			var elemTyp @types.Type = collArr.Elem
			if elemTyp == nil { elemTyp = types.TypInt() }
			emitIndexNilCheck(ctx, b, e, ptrVal, forDeref)
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			return irbuild.EmitGetElemPtr(b, ptrVal, index, elemTyp)
		}
		// Slice-field element: same as the IDENT slice arm, for ANY
		// element type — see the wild-pointer note there.  Peel transparent
		// wrappers (named-distinct / alias / readonly) so the element type
		// (and stride) comes from the underlying slice, and so a named slice
		// FIELD (`type RBuf *[]int`) is recognized rather than falling through.
		var collSt @types.Type = types.StripWrappers(collTyp)
		if collSt != nil && isSliceType(collSt) && collSt.Elem != nil {
			var sliceVal @ir.Instr = genExpr(ctx, b, e.X)
			b = ctx.CurBlock
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			var lenInstr @ir.Instr = irbuild.EmitSliceLen(b, sliceVal)
			genIndexBoundsCheck(ctx, b, e, index, lenInstr)
			return irbuild.EmitSliceElemPtr(b, sliceVal, index, collSt.Elem)
		}
	}
	// Deref-of-pointer-to-array base, e.g. `(*p)[i]` (and the inner `(*p)[i]`
	// of a nested `(*p)[i][j]`): p IS the array's backing address, so GEP
	// through the pointer value.  Without this the r-value fallback below loads
	// the array as a value (no backing) and returns nil → invalid IR / dropped
	// store.
	if e.X.Kind == ast.EXPR_UNARY && e.X.Op == cast(int, token.STAR) {
		var ptrVal @ir.Instr = genExpr(ctx, b, e.X.X)
		b = ctx.CurBlock
		// Peel the pointer's own type (named-distinct / alias / readonly): a named
		// pointer-to-array (`type PA *([3]int)`) is TYP_NAMED, so an un-peeled Kind
		// check misses it and `&(*p)[i]` falls through to a wild pointer.  A MANAGED
		// pointer to an array (`mp @([2][2]int)`) is TYP_MANAGED_PTR — its value is
		// the pointee (array) backing address, so it GEPs exactly like a raw pointer
		// (mirroring genUnary STAR in gen_expr.bn); without this arm a STORE through
		// `(*mp)[i][j]` returns nil here and the store is silently dropped.
		var pk @types.Type = nil
		if ptrVal != nil && ptrVal.Typ != nil { pk = types.StripWrappers(ptrVal.Typ) }
		if pk != nil && (pk.Kind == types.TYP_POINTER || pk.Kind == types.TYP_MANAGED_PTR) &&
				pk.Elem != nil {
			// StripWrappers (not just readonly) so `*Row` where
			// `type Row [3]int` recognizes the pointee as an array.
			var arrSt @types.Type = types.StripWrappers(pk.Elem)
			if arrSt != nil && arrSt.Kind == types.TYP_ARRAY {
				var elemTyp @types.Type = arrSt.Elem
				if elemTyp == nil { elemTyp = types.TypInt() }
				emitDerefNilCheck(ctx, b, ptrVal, forDeref)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitConstInt(b, arrSt.ArrayLen, types.TypInt())
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitGetElemPtr(b, ptrVal, index, elemTyp)
			}
			// Slice pointee — `(*sp)[i]` where `*sp` is a (raw/managed) slice value
			// held through the pointer: load the slice, then take an in-place element
			// pointer (mirrors the nested-index / r-value arms).  Without this a
			// selector STORE `(*sp)[i].f = v` returns nil here and is silently dropped.
			if arrSt != nil && isSliceType(arrSt) && arrSt.Elem != nil {
				emitDerefNilCheck(ctx, b, ptrVal, forDeref)
				var sliceVal @ir.Instr = irbuild.EmitLoad(b, ptrVal, arrSt)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitSliceLen(b, sliceVal)
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitSliceElemPtr(b, sliceVal, index, arrSt.Elem)
			}
			// Pointer pointee — `(*pp)[i]` where `*pp` is a raw pointer held through
			// the pointer: load the inner pointer, then GEP through it (a raw pointer
			// carries no length, so no bounds check — as in the IDENT pointer arm).
			if arrSt != nil && arrSt.Kind == types.TYP_POINTER && arrSt.Elem != nil {
				emitDerefNilCheck(ctx, b, ptrVal, forDeref)
				var innerPtr @ir.Instr = irbuild.EmitLoad(b, ptrVal, arrSt)
				emitIndexNilCheck(ctx, b, e, innerPtr, forDeref)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				return irbuild.EmitGetElemPtr(b, innerPtr, index, arrSt.Elem)
			}
		}
		return nil
	}
	// Nested-index base, e.g. `a[i][j]`: recurse for an in-place pointer
	// to the inner element `a[i]`, then index THAT.  Without this the
	// outer `&...` falls through and genUnary hands back the loaded inner
	// r-value as a pointer — a wild pointer (SIGSEGV) or invalid IR.  An
	// array inner element is stored in place, so GEP its pointer directly;
	// a slice / raw-pointer inner element is a value carrying its own
	// backing, so load it first and index through the value.
	if e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// The inner element is loaded through to reach the outer index — a deref —
		// so forDeref=true even when the outermost use is address-of.
		var basePtr @ir.Instr = genIndexPtr(ctx, b, e.X, true)
		b = ctx.CurBlock
		if basePtr == nil || basePtr.Typ == nil || basePtr.Typ.Kind != types.TYP_POINTER ||
				basePtr.Typ.Elem == nil {
			return nil
		}
		// StripWrappers (not just readonly) so a nested named-array inner
		// element (`type Row [3]int` as the element of an outer array) is
		// recognized as an array and GEP'd in place.
		var innerSt @types.Type = types.StripWrappers(basePtr.Typ.Elem)
		if innerSt == nil { return nil }
		if innerSt.Kind == types.TYP_ARRAY {
			var elemTyp @types.Type = innerSt.Elem
			if elemTyp == nil { elemTyp = types.TypInt() }
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			var lenInstr @ir.Instr = irbuild.EmitConstInt(b, innerSt.ArrayLen, types.TypInt())
			genIndexBoundsCheck(ctx, b, e, index, lenInstr)
			return irbuild.EmitGetElemPtr(b, basePtr, index, elemTyp)
		}
		if isSliceType(innerSt) && innerSt.Elem != nil {
			var sliceVal @ir.Instr = irbuild.EmitLoad(b, basePtr, innerSt)
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			var lenInstr @ir.Instr = irbuild.EmitSliceLen(b, sliceVal)
			genIndexBoundsCheck(ctx, b, e, index, lenInstr)
			return irbuild.EmitSliceElemPtr(b, sliceVal, index, innerSt.Elem)
		}
		if innerSt.Kind == types.TYP_POINTER && innerSt.Elem != nil {
			var ptrVal @ir.Instr = irbuild.EmitLoad(b, basePtr, innerSt)
			emitIndexNilCheck(ctx, b, e, ptrVal, forDeref)
			var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
			b = ctx.CurBlock
			return irbuild.EmitGetElemPtr(b, ptrVal, index, innerSt.Elem)
		}
		return nil
	}
	// R-value base that carries its own backing, e.g. `&get()[i]` where
	// get() returns a slice (or raw pointer): evaluate it and GEP into the
	// backing.  IDENT / SELECTOR bases are handled above; this is for the
	// remaining kinds (call results, etc.).  The caller borrows the
	// backing — for a managed-slice temp the standard end-of-statement
	// cleanup keeps refcounting honest (the backing must stay live via
	// another owner, else it is a user use-after-free, not a compiler
	// bug).  An r-value array has no stable address, so it returns nil.
	if e.X.Kind != ast.EXPR_IDENT && e.X.Kind != ast.EXPR_SELECTOR {
		var baseVal @ir.Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		if baseVal != nil && baseVal.Typ != nil {
			// Peel transparent wrappers (named-distinct / alias / readonly) so a
			// named slice returned by a call (`type RBuf *[]int`) is recognized;
			// EmitSliceLen/EmitSliceElemPtr read the value's fields, so the peeled
			// element type just supplies the GEP stride.
			var baseSt @types.Type = types.StripWrappers(baseVal.Typ)
			if baseSt != nil && isSliceType(baseSt) && baseSt.Elem != nil {
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenInstr @ir.Instr = irbuild.EmitSliceLen(b, baseVal)
				genIndexBoundsCheck(ctx, b, e, index, lenInstr)
				return irbuild.EmitSliceElemPtr(b, baseVal, index, baseSt.Elem)
			}
			// baseSt is peeled, so a named-distinct pointer returned by a call
			// (`type P *int`) reaches this arm rather than falling through
			// (genIndexPtr → nil, then the loaded pointer VALUE is used as the
			// element address — a wild pointer).
			if baseSt != nil && baseSt.Kind == types.TYP_POINTER && baseSt.Elem != nil {
				emitIndexNilCheck(ctx, b, e, baseVal, forDeref)
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				return irbuild.EmitGetElemPtr(b, baseVal, index, baseSt.Elem)
			}
			// R-value ARRAY (a call result `getArr()[i]`): no backing storage, so
			// materialize the array VALUE into an alloca and GEP the element.  This
			// returns the element pointer a nested / field read `getArr()[i].f` /
			// `getArr()[i].a.b` needs (genSelector / genSelectorPtr ask genIndexPtr
			// for it), evaluating the base call exactly ONCE — without it those
			// paths re-`genExpr` the base (a double side-effecting call) or hit the
			// unresolved-selector panic.  READ-only: the checker rejects a write /
			// `*T`-method through a non-addressable r-value-array element (see
			// isAddressable), so this is never an assignment lvalue where the store
			// would land in the discarded copy.  The temp borrows the call result's
			// genExpr-registered refs.
			var baseArr @types.Type = types.StripWrappers(baseVal.Typ)
			if baseArr != nil && baseArr.Kind == types.TYP_ARRAY {
				var aElem @types.Type = baseArr.Elem
				if aElem == nil { aElem = types.TypInt() }
				var index @ir.Instr = genIntOperand(ctx, b, e.Args[0])
				b = ctx.CurBlock
				var lenI @ir.Instr = irbuild.EmitConstInt(b, baseArr.ArrayLen, types.TypInt())
				genIndexBoundsCheck(ctx, b, e, index, lenI)
				var aTmp @ir.Instr = irbuild.EmitAlloc(b, baseVal.Typ)
				irbuild.EmitStore(b, aTmp, baseVal)
				return irbuild.EmitGetElemPtr(b, aTmp, index, aElem)
			}
		}
	}
	return nil
}

// checkedManagedSliceType returns the checker's type of e, its wrappers peeled,
// when that is a managed-slice, or nil.
func checkedManagedSliceType(ctx @GenContext, e @ast.Expr) @types.Type {
	if ctx.Checker == nil || e == nil || e.ResolvedTypeID == 0 { return nil }
	var t @types.Type = types.StripWrappers(ctx.Checker.ExprType(e.ResolvedTypeID))
	if t == nil || t.Kind != types.TYP_MANAGED_SLICE { return nil }
	return t
}
