package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// `pts[0].X = v` on a slice of structs addresses the element in place — a GEP
// to the element, then the field — rather than storing into a loaded copy.
func TestGenIndexPtrSliceOfStructs() testing.TestResult {
	// sliceOfStructs[i].field = value should produce
	// extract + GEP
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type Point struct {\n\tX int\n\tY int\n}\n"
					"func foo() {\n"
					"\tvar pts *[]Point = make_slice(Point, 1)\n"
					"\tpts[0] = Point{1, 2}\n"
					"\tpts[0].X = 99\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @ir.Func = m.Funcs[0]
	var foundGEP bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == iropcode.OP_GET_ELEM_PTR {
				foundGEP = true
			}
		}
	}
	if !foundGEP { return fail("slice-of-structs index assign should emit GEP") }
	return ""
}

// genIndexPtr evaluates an index designator's base before its index, whether
// the element's address is taken, the element incremented, or a field of it
// read.
func TestGenIndexPtrEvaluatesBaseBeforeIndex() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type P struct { f int }\n"
					"var arr [3]int\n"
					"var parr [3]P\n"
					"func base1() *([3]int) { return &arr }\n"
					"func base2() *([3]P) { return &parr }\n"
					"func idx1() int { return 1 }\n"
					"func addr() *int { return &(*base1())[idx1()] }\n"
					"func incr() { (*base1())[idx1()]++ }\n"
					"func field() int { return (*base2())[idx1()].f }\n")
	var names @[]@[]char = make_slice(@[]char, 3)
	names[0] = buf.CopyStr("base1")
	names[1] = buf.CopyStr("base2")
	names[2] = buf.CopyStr("idx1")
	var addr @ir.Func = findFunc(m, "addr")
	var incr @ir.Func = findFunc(m, "incr")
	var field @ir.Func = findFunc(m, "field")
	if addr == nil || incr == nil || field == nil {
		return fail("addr / incr / field were not generated")
	}
	if !charsEqual(callSequence(addr, names), "base1 idx1") {
		return fail("&x[i] must evaluate x before i")
	}
	if !charsEqual(callSequence(incr, names), "base1 idx1") {
		return fail("x[i]++ must evaluate x before i")
	}
	if !charsEqual(callSequence(field, names), "base2 idx1") {
		return fail("x[i].f must evaluate x before i")
	}
	return ""
}
