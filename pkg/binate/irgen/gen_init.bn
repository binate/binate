package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"

// Synthetic per-package init function generation.  When a package has any
// top-level `var x T = expr` decls with non-nil initializers, IR-gen emits a
// `<pkg>.__init` function that runs each initializer and stores its value into
// the variable (GenGlobalInitFunc), in the order the initializers depend on one
// another (initVarsInOrder).  The driver (cmd/bni for VM mode, an init
// dispatcher for compiled mode) is responsible for calling it before main.
//
// A global's storage starts zero-filled, so without this top-level
// `var x int = 42` would stay 0.

// initFuncName returns the qualified name of the per-package init
// function for the current module-gen context.  Always
// `<gc.PkgPath>.__init`.
func initFuncName(gc @GenCtx) @[]char {
	return qualifyForCurrentModule(gc, "__init")
}

// appendInitVarDecls appends to `out` every package-level var decl reachable
// from `decls` — a top-level DECL_VAR, plus each member of a `var ( ... )`
// DECL_GROUP.  A var group is pure syntactic grouping (no iota semantics), so
// its members initialize exactly like top-level vars; groups don't nest, but
// the recursion is defensive.  Preserves source order (a group's members
// appear where the group sits).  A var from the package's `.bni` (FromBNI, on it
// or its group) is left out: it is extern (registerVarGlobalsFrom), and its initial
// value is the implementation's.  (The checker rejects an initializer on a `.bni`
// var, decl.var.extern.no-init.)
func appendInitVarDecls(decls *[]@ast.Decl, out @vec.Vec[@ast.Decl]) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.FromBNI { continue }
		if d.Kind == ast.DECL_VAR {
			out.Push(d)
		} else if d.Kind == ast.DECL_GROUP {
			appendInitVarDecls(d.Decls, out)
		}
	}
}

// initVarDecls returns the flat, source-ordered list of package-level var
// decls (top-level + grouped members) — see appendInitVarDecls.
func initVarDecls(decls *[]@ast.Decl) @[]@ast.Decl {
	var out @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	appendInitVarDecls(decls, out)
	var none @[]@ast.Decl
	if out.Len() == 0 { return none }
	return out.Items()
}

// hasInitDecls reports whether `decls` (typically file.Decls)
// contains at least one `var x T = expr` with a non-nil
// initializer expression — i.e., whether emitting an init
// function for the package is worth the work.  It stops at the first: of the
// var decls appendInitVarDecls lists, a blank init (`var _ = f()`) has no name
// to assign to but still runs its initializer for side effects, so it counts.
func hasInitDecls(decls *[]@ast.Decl) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.FromBNI { continue }
		if d.Kind == ast.DECL_VAR && d.Value != nil { return true }
		if d.Kind == ast.DECL_GROUP && hasInitDecls(d.Decls) { return true }
	}
	return false
}

// isBlankName returns true for the blank identifier `_`.  A blank-named var
// binds no name, so its initializer has no variable to store into — it is
// evaluated for its side effects only (genPackageVarInit).
func isBlankName(name *[]readonly char) bool {
	return len(name) == 1 && name[0] == cast(char, 95) // '_'
}

// initVarsInOrder returns the variables of `decls` with an initializer in the
// order their initializations run.  When `order` is non-empty (the checker's
// dependency order — see check.VarInitOrder), in that order, so each
// initializer's package-var dependencies run first regardless of filename/source
// position.  An empty `order` falls back to source order, which still gives
// intra-file ordering for `var b int = a + 1` after `var a int = 5`.
//
// The order is used defensively: after the ordered names, any init-var NOT named
// in `order` follows in source order.  A well-formed order lists exactly the
// init-var set, so this only fires if the checker and IR-gen ever disagree on
// that set — and then the initializer still runs rather than being silently
// dropped (a lost init is a miscompile; a mis-ordered one is at worst a
// zero-value read).  The init-vars are found by name, and the names taken looked
// up, in tables (initVarsByName).
func initVarsInOrder(decls *[]@ast.Decl, order @[]@[]char) @[]@ast.Decl {
	var vs @[]@ast.Decl = initVarDecls(decls)
	var byName @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq] =
		initVarsByName(vs)
	var inits @vec.Vec[@ast.Decl] = vec.New[@ast.Decl]()
	var taken @table.Table[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq] =
		table.NewTable[*[]readonly char, bool, irdata.FuncSigHasher, irdata.FuncSigEq](
				irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(order); i++ {
		if taken.Has(order[i]) { continue }
		var d @ast.Decl
		var found bool
		d, found = byName.Get(order[i])
		if !found { continue }
		inits.Push(d)
		taken.Put(order[i], true)
	}
	for i := 0; i < len(vs); i++ {
		var d @ast.Decl = vs[i]
		if d.Value == nil { continue }
		if isBlankName(d.Name) { continue }
		if taken.Has(d.Name) { continue }
		inits.Push(d)
	}
	// Blank-var initializers (`var _ = f()`) run for their side effects but have
	// no name to assign to and cannot be a dependency target, so they run in a
	// source-order TAIL — after every named var (which are in dependency order),
	// so a blank that reads a package global sees it initialized.  (A blank
	// ordered only against a named var through a function call it makes is the
	// same deferred transitive-through-functions gap as for named vars.)
	for i := 0; i < len(vs); i++ {
		var d @ast.Decl = vs[i]
		if d.Value == nil { continue }
		if !isBlankName(d.Name) { continue }
		inits.Push(d)
	}
	var none @[]@ast.Decl
	if inits.Len() == 0 { return none }
	return inits.Items()
}

// initVarsByName returns the init-vars of vs (the flat list initVarDecls gives:
// non-nil Value, non-blank) by name, the first of each -- the init-var predicate
// the checker's dependency-order pass uses, so the ordered names resolve to exactly
// the emitted set.  Its keys borrow the declarations' names.
func initVarsByName(
		vs *[]@ast.Decl) @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher,
				irdata.FuncSigEq] {
	var byName @table.Table[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq] =
		table.NewTable[*[]readonly char, @ast.Decl, irdata.FuncSigHasher, irdata.FuncSigEq](
				irdata.FuncSigHasher{}, irdata.FuncSigEq{})
	for i := 0; i < len(vs); i++ {
		var d @ast.Decl = vs[i]
		if d.Value == nil || isBlankName(d.Name) || byName.Has(d.Name) { continue }
		byName.Put(d.Name, d)
	}
	return byName
}

// generatePackageInit emits a `<pkg>.__init` function for the
// module if `decls` has any non-trivial var initializers, and
// adds it to `m`.  No-op (returns without touching `m`) when
// there are no initializers — empty inits aren't worth a
// round-trip through the call cache.
//
// Caller must have set up Module.GlobalVars etc. via the surrounding
// GeneratePackage / GenModule pass — the initializations store into the
// variables' globals (declaredGlobal).
func generatePackageInit(gc @GenCtx, decls *[]@ast.Decl, m @ir.Module) {
	if !hasInitDecls(decls) { return }
	// The checker records a dependency order for the package's top-level
	// init-vars (none when no package-level variable has an initializer);
	// initVarsInOrder falls back to source order for an empty order.
	var order @[]@[]char = m.Checker.VarInitOrder(gc.PkgPath)
	var inits @[]@ast.Decl = initVarsInOrder(decls, order)
	var name @[]char = "__init"
	var f @ir.Func = GenGlobalInitFunc(gc, name, inits)
	// Register the init's qualified name in Module.FuncSigs so any
	// caller lowered later (e.g. the compiled-mode init
	// dispatcher) can resolve it the usual way.
	var sig irdata.FuncSig
	sig.Name = initFuncName(gc)
	var emptyParams @[]@types.Type
	var emptyResults @[]@types.Type
	sig.Params = emptyParams
	sig.Results = emptyResults
	setOrAppendFuncSig(gc, sig)
	m.AddFunc(f)
}
