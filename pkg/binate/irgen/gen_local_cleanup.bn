package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Whole-function managed-local cleanup — the RefDec sequence a return (or a
// recoverable fault) emits over ALL of ctx.Vars — and the VM-only cleanup
// landing pad that reuses it.  The per-type
// RefDec emitters, the temp-list cleanup, and the scope-partial
// emitDecForScopeVars live in gen_util_refcount.bn.

// emitDecForManagedLocals emits cleanup for all managed locals.
// Axiom 2: always dtor. No skip for returned locals — the return
// path always RefInc's (axiom 3), so the dtor balances.
// emitManagedStructPtrDtor cleans up a managed struct at the pointer structPtr
// (an alloca of the struct).  When SROA will run (GenCtx.SroaCleanupShape), for
// a LEAF-managed struct (managedStructLeafEligible), it emits inline per-field
// RefDecs on structPtr's OWN field-ptrs (no bitcast, no by-address __dtor_T
// call) — the L1-forwardable shape SROA scalar-replaces.  Otherwise, or for a
// struct SROA cannot split, it emits the shared by-address dtor call.  Used by every struct-local /
// struct-literal-temp cleanup site (blocks AND fault pads) so the SROA-eligible
// shape and the split agree everywhere.
func emitManagedStructPtrDtor(ctx @GenContext, b @ir.Block, structPtr @ir.Instr,
		structTyp @types.Type) @ir.Block {
	if ctx.Gc.SroaCleanupShape && ir.ManagedStructLeafEligible(structTyp) {
		// inlineNested=true: a nested leaf-managed struct field recurses to field-ptr
		// RefDecs (not a by-address __dtor call) so its slot also stays SROA-splittable.
		return emitStructFieldRefDecs(ctx.Func, b, structPtr, types.StripWrappers(structTyp), true)
	}
	emitStructDtor(ctx.Func, b, structPtr, structTyp)
	return b
}

// emitDecForManagedLocals emits scope-exit RefDec cleanup for every managed local
// in ctx.Vars (managed pointer / slice / iface-value / func-value load+RefDec, or
// a managed struct via emitManagedStructPtrDtor).  Returns the final block (a
// branching RefDec may split it).
func emitDecForManagedLocals(ctx @GenContext, b @ir.Block, retExprs *[]@ast.Expr) @ir.Block {
	for i := 0; i < len(ctx.Vars); i++ {
		b = emitDecForManagedLocal(ctx, b, ctx.Vars[i])
	}
	return b
}

// releaseFrameClosureRecords inserts the release of every frame closure record
// (ctx.FrameSlots, allocFrameClosureRecord) before every function-exit
// terminator: each OP_RETURN in ctx.Func.Blocks and each OP_UNWIND_RETURN in its
// fault pads.  It runs once the whole body is generated, because a record is
// registered only when IR-gen reaches its closure site, while an exit generated
// earlier — a `return` above the site in a loop body, a fault pad in the loop
// condition — can run after a later iteration has filled the record.  The exit
// sequences before the terminator (deferred calls, the locals' release) are
// unchanged, so the records outlive every deferred call.  Every record is
// allocated (and zero-filled) in the entry block's prologue, before any exit or
// faulting op can run, so a record whose site never ran is still zero and its
// release is a no-op.
func releaseFrameClosureRecords(ctx @GenContext) {
	if len(ctx.FrameSlots) == 0 { return }
	var f @ir.Func = ctx.Func
	// Snapshot both counts: a branching release splits its block, and the new
	// blocks — which end with the moved terminator — must not be visited again.
	var nBlocks int = len(f.Blocks)
	for i := 0; i < nBlocks; i++ {
		releaseFrameRecordsBeforeExit(ctx, f.Blocks[i], iropcode.OP_RETURN)
	}
	var nPads int = len(f.FaultPads)
	// PadEmitMode keeps any block a release splits off a pad in f.FaultPads,
	// off the compiled backends' block list (see emitPadCleanup).
	f.PadEmitMode = true
	for i := 0; i < nPads; i++ {
		releaseFrameRecordsBeforeExit(ctx, f.FaultPads[i], iropcode.OP_UNWIND_RETURN)
	}
	f.PadEmitMode = false
}

// releaseFrameRecordsBeforeExit emits the frame closure records' release in
// front of b's terminator when that terminator is exitOp: the terminator is
// detached, the releases appended, and the terminator re-attached to the end of
// the (possibly split) final block.
func releaseFrameRecordsBeforeExit(ctx @GenContext, b @ir.Block, exitOp int) {
	var n int = len(b.Instrs)
	if n == 0 || b.Instrs[n - 1].Op != exitOp { return }
	var term @ir.Instr
	var ok bool
	term, ok = b.InstrsVec.Pop()
	b.Instrs = b.InstrsVec.Items()
	var cur @ir.Block = b
	for i := 0; i < len(ctx.FrameSlots); i++ {
		cur = emitDecForManagedLocal(ctx, cur, ctx.FrameSlots[i])
	}
	if ok {
		cur.InstrsVec.Push(term)
		cur.Instrs = cur.InstrsVec.Items()
	}
}

// emitDecForManagedLocal emits the RefDec cleanup of one managed local slot
// (managed pointer / slice / iface-value / func-value load + RefDec, or a
// managed struct via emitManagedStructPtrDtor); a non-managed slot emits
// nothing.  Returns the final block (a branching RefDec may split it).
func emitDecForManagedLocal(ctx @GenContext, b @ir.Block, slot VarSlot) @ir.Block {
	// Peel IR-transparent wrappers like emitDecForScopeVars (see there): a
	// named-managed local must load and clean up via its underlying type.
	var st @types.Type = types.StripWrappers(slot.Typ)
	if irutil.IsManagedPtrType(st) {
		var ptrVal @ir.Instr = irbuild.EmitLoad(b, slot.Ptr, st)
		irbuild.EmitManagedPtrRefDec(ctx.Func, b, ptrVal)
	}
	if irutil.IsManagedSliceType(st) {
		var sliceVal @ir.Instr = irbuild.EmitLoad(b, slot.Ptr, st)
		b = irbuild.EmitManagedSliceRefDec(ctx.Func, b, sliceVal)
	}
	if irutil.IsManagedIfaceValueType(st) {
		var ivVal @ir.Instr = irbuild.EmitLoad(b, slot.Ptr, st)
		b = emitManagedIfaceValueRefDec(ctx.Func, b, ivVal)
	}
	if irutil.IsManagedFuncValueType(st) {
		var fvVal @ir.Instr = irbuild.EmitLoad(b, slot.Ptr, st)
		b = emitManagedFuncValueRefDec(ctx.Func, b, fvVal)
	}
	if needsStructCopy(st) {
		b = emitManagedStructPtrDtor(ctx, b, slot.Ptr, st)
	}
	return b
}

// emitPadCleanup emits, into pad block `p`, the RefDec cleanup for every managed
// value live at the current program point — all managed ctx.Vars locals plus all
// ctx.Temps temporaries — WITHOUT clearing either registry (the normal
// scope/statement cleanup still runs later).  This is exactly the cleanup an
// early return would emit here, packaged as a reusable fault landing pad.  A
// managed slice / iface-value / func-value RefDec can BRANCH into new blocks, so
// this runs under ctx.Func.PadEmitMode = true, which routes AddBlock into
// Func.FaultPads — keeping every pad block off Func.Blocks so the compiled
// backends never see them.  Returns the pad's EXIT block (where the caller
// appends EmitUnwindReturn).
func emitPadCleanup(ctx @GenContext, p @ir.Block) @ir.Block {
	// noRet = nil: on a FAULT (unlike a return) no value has been produced, so
	// every managed local is still live and must be RefDec'd — emitDecForManagedLocals
	// already RefDecs the whole ctx.Vars (Axiom 2), so passing no return exprs is
	// exactly right (there are no returned locals to skip).
	var noRet *[]@ast.Expr
	// PadEmitMode is set ONLY here and reset unconditionally below; it does NOT
	// nest, because pad cleanup emits only RefDec / dtor-call / null-guard-branch
	// ops — none of which is a faulting op, so none re-enters attachFaultPad ->
	// emitPadCleanup.  Any block a branching RefDec creates during this window
	// (AddBlock -> AddFaultPad) therefore stays in Func.FaultPads.
	ctx.Func.PadEmitMode = true
	p = emitDecForManagedLocals(ctx, p, noRet)
	p = emitTempRefDecs(ctx, p)
	ctx.Func.PadEmitMode = false
	return p
}

// attachFaultPad tags the block's most-recently-emitted (faulting) instruction
// with a fresh VM-only cleanup landing pad that RefDecs the live managed set at
// this point, so a recoverable VM fault at that op unwinds without leaking.
// Only the VM consumes it (Instr.PadBlock -> VMFunc.FaultTable); the compiled
// backends stay fatal and never see the pad.  Call right after a guard emit
// (EmitBoundsCheck, ...).
func attachFaultPad(ctx @GenContext, b @ir.Block) {
	if len(b.Instrs) == 0 { return }
	var faultOp @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	var entry @ir.Block = ir.AddFaultPad(ctx.Func, "fault_pad")
	var padExit @ir.Block = emitPadCleanup(ctx, entry)
	irbuild.EmitUnwindReturn(padExit)
	faultOp.PadBlock = entry
}

// attachEmptyFaultPad tags b's most-recently-emitted (call) instruction with a
// BARE cleanup pad — a fault landing that releases nothing, then
// BC_UNWIND_RETURNs — so a recoverable VM fault raised by the call relays through
// this frame instead of vmPanicking on a missing pad (the re-entrant-swallow
// dispatch, or a frame-push stack overflow, both look up this op's pad).  For a
// synthesized FORWARDING function (a method-value wrapper) an EMPTY pad is the
// correct one, NOT a param-releasing pad: the wrapper hands each param straight to
// the wrapped method, so an OWNED param (an @Iface / managed-field-struct passed
// by move) is released by the METHOD's own cleanup — its fault pad on an internal
// fault, its exit RefDec on the normal path — and a borrowed param (@T / @[]T /
// @func) by neither.  On an internal method fault the unwind runs this wrapper
// call-site pad AFTER the method's pad already released those params, so a
// param-releasing pad here would double-free; an empty pad matches how an ordinary
// call's call-site pad leaves a moved-out argument alone.  (The wrapper genuinely
// owns nothing else: its captured-receiver bridge is a shallow store-copy, a
// non-owning view — the closure record owns the receiver.)  VM-only (compiled
// backends ignore PadBlock); never entered on the happy path.
//
// The forward's FRAME-PUSH OVERFLOW is handled by a SEPARATE pre-check pad
// (attachMethodValueForwardPad, tagged on the wrapper's OP_STACK_CHECK op): it
// faults BEFORE the move and releases the wrapper's owned values, so this call-site
// pad stays empty and only relays an INTERNAL method fault — where the method
// already released the moved values via its own pad.  A value-releasing pad HERE
// would double-free on that internal-fault path; the overflow-only releases belong
// on the pre-check pad, not here.
func attachEmptyFaultPad(f @ir.Func, b @ir.Block) {
	if len(b.Instrs) == 0 { return }
	var faultOp @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	var entry @ir.Block = ir.AddFaultPad(f, "fault_pad")
	irbuild.EmitUnwindReturn(entry)
	faultOp.PadBlock = entry
}

// attachMethodValueForwardPad tags a method-value wrapper's forward-call PRE-CHECK
// (the last op in `checkBlock`) with a fault pad that RefDecs the wrapper's OWNED
// forwarded values, so a frame-push overflow on the forward — where the method
// never starts to release them — does not leak.  The wrapper forwards each value to
// the method BY MOVE.  Two owned kinds are released:
//   - user PARAMS idx >= 1 that are @Iface (RefDec) or a managed-field struct
//     (by-address dtor): the mv() caller delivered these OWNED (coerceArgDelivery's
//     RefInc / field-RefInc'ing struct copy), forwarded from their paramSlots.
//   - the RECEIVER copy `recvCopySlot` (nil unless the receiver is a value-struct
//     the wrapper field-RefInc'd into an owned copy, or an @Iface-represented value
//     it RefInc'd, before forwarding): the closure only lent a shallow view, so the
//     wrapper made the owned copy and must release it here on overflow.
// The bare receiver at paramSlots[0] is NOT released — a @T / *T / bridged receiver
// is borrowed (the method entry-RefIncs + exit-RefDecs it, net zero), and the OWNED
// receiver form is the separate recvCopySlot.  @T / @[]T / @func params are borrowed
// too, so none is released.  This is the counterpart pad to the CALL-site
// attachEmptyFaultPad, which stays empty for the internal-method-fault path (the
// method started and released the moved values via its own pad); the two pads sit on
// different ops, so no value is released twice.  Built GenContext-free (the wrapper
// is synthesized without one), mirroring attachFaultPad's PadEmitMode + FaultPad
// routing so a branching @Iface RefDec's new blocks land in Func.FaultPads.
// (emitStructDtor registers a pending dtor on f.Mod, which the wrapper sets.)
func attachMethodValueForwardPad(f @ir.Func, checkBlock @ir.Block, params @[]@ir.Param,
		paramSlots @[]@ir.Instr, recvCopySlot @ir.Instr) {
	if len(checkBlock.Instrs) == 0 { return }
	var faultOp @ir.Instr = checkBlock.Instrs[len(checkBlock.Instrs) - 1]
	var entry @ir.Block = ir.AddFaultPad(f, "fault_pad")
	f.PadEmitMode = true
	var p @ir.Block = entry
	// Owned receiver copy (recvCopySlot's alloc type is the receiver param type —
	// params[0].Typ): a value-struct copy, or an acquired @Iface receiver.
	if recvCopySlot != nil {
		var rt @types.Type = types.StripWrappers(params[0].Typ)
		if irutil.IsManagedIfaceValueType(rt) {
			p = emitManagedIfaceValueRefDec(f, p, irbuild.EmitLoad(p, recvCopySlot, rt))
		} else {
			emitStructDtor(f, p, recvCopySlot, rt)
		}
	}
	for i := 1; i < len(params); i++ {
		var st @types.Type = types.StripWrappers(params[i].Typ)
		if irutil.IsManagedIfaceValueType(st) {
			var iv @ir.Instr = irbuild.EmitLoad(p, paramSlots[i], st)
			p = emitManagedIfaceValueRefDec(f, p, iv)
		} else if needsStructCopy(st) {
			emitStructDtor(f, p, paramSlots[i], st)
		}
	}
	f.PadEmitMode = false
	irbuild.EmitUnwindReturn(p)
	faultOp.PadBlock = entry
}

// isProvablyNonNil reports whether ptr's defining IR op yields a value that is
// unconditionally non-nil, so an OP_NIL_CHECK before a deref of it can be elided
// (elision (a), "non-nil by construction").  Only ops
// whose result is non-nil REGARDLESS of their operands qualify — a fresh
// allocation: OP_ALLOC (a stack-slot address) or OP_BOX / OP_MAKE / OP_MAKE_SLICE
// (heap).  Base-relative address ops (OP_GET_FIELD_PTR / OP_GET_ELEM_PTR —
// `base ± offset`) are deliberately NOT included: they are non-nil only when
// their base is, which the dominating-check dedup (elision (b), a later
// increment) captures precisely.  Elision is purely an optimization — an
// un-elided check of a non-nil pointer simply passes at run time — so a
// conservative predicate here is always safe.
func isProvablyNonNil(ptr @ir.Instr) bool {
	if ptr == nil { return false }
	if ptr.Op == iropcode.OP_ALLOC { return true }
	if ptr.Op == iropcode.OP_BOX { return true }
	if ptr.Op == iropcode.OP_MAKE { return true }
	if ptr.Op == iropcode.OP_MAKE_SLICE { return true }
	return false
}

// emitNilCheckIfEnabled emits an OP_NIL_CHECK on ptr, tagged with a recoverable
// cleanup pad, immediately before a deref of ptr — but ONLY when nil-checking is
// enabled for this compilation (ctx.Gc.EmitNilChecks) and ptr is not already
// provably non-nil (isProvablyNonNil).  With the flag off it is a no-op, so the
// emitted IR is byte-for-byte the pre-feature form.  Call right before the
// load / store that derefs ptr, on the current block: it appends the check (and
// pad) to b and does NOT change ctx.CurBlock, so the caller's following deref
// still lands in b.
func emitNilCheckIfEnabled(ctx @GenContext, b @ir.Block, ptr @ir.Instr) {
	if !ctx.Gc.EmitNilChecks { return }
	if isProvablyNonNil(ptr) { return }
	// Intra-block dedup (N2d): if this pointer's source has already been
	// established non-nil in this block (and nothing since could have reassigned
	// it — addInstr clears the set on any store/call/dtor), skip the redundant
	// check.  `p.x + p.y` thus emits one OP_NIL_CHECK, not two.  A negative key is
	// the shared void/global-ref sentinel (-1) — NOT a unique source id — so it
	// never dedups and never pollutes the set (distinct globals must each check).
	var key int = nilDedupKey(ptr)
	if key >= 0 && intSliceContains(b.NilCheckedSlots, key) { return }
	irbuild.EmitNilCheck(b, ptr)
	attachFaultPad(ctx, b)
	if key >= 0 {
		b.NilCheckedSlots = slices.Append[int](b.NilCheckedSlots, key)
	}
}

// nilDedupKey returns the intra-block dedup key for a pointer being nil-checked
// (N2d): for a LOAD, the SOURCE address/slot's SSA id — so two loads of the same
// variable (`p.x` then `p.y`) share a key and the second check is elided; for any
// other value, the value's own SSA id (a reused SSA pointer value).  Keying on the
// load SOURCE rather than the (fresh each access) loaded value is what makes the
// common `p.x + p.y` redundancy dedup; addInstr invalidates the key on any store
// to that slot, so a reassigned `p` correctly re-checks.
func nilDedupKey(ptr @ir.Instr) int {
	// Key on the load's SOURCE only when that source is a genuine, STABLE slot —
	// an OP_ALLOC (a local / param / global-address pseudo).  Two loads of the
	// same variable (`p.x`, `p.y`) then share the alloca's id and the second check
	// is elided.  Crucially, if the source is any OTHER value — e.g. a call result
	// in `**f()`, where the checked pointer `f()` is ALSO the inner load's source —
	// keying on the source id would collide `f()`'s key (checked as a value) with
	// `*f()`'s (an INDEPENDENT pointer) and wrongly elide the inner check.  Those
	// non-alloca-sourced loads key on the load's OWN id, so each is checked.
	// The `ID >= 0` guard is essential: a global-variable address is synthesized
	// as an OP_ALLOC pseudo with the SHARED void sentinel id -1 (not a unique
	// per-variable id), so keying on it would collide DISTINCT globals (`g1.x`,
	// `g2.x`).  Requiring a real (non-negative, monotonically-unique) alloca id
	// restricts source-keying to genuine local/param slots; globals fall through
	// to the load's own unique id (no dedup, but no false collision).
	if ptr.Op == iropcode.OP_LOAD && len(ptr.Args) > 0 && ptr.Args[0] != nil &&
			ptr.Args[0].Op == iropcode.OP_ALLOC && ptr.Args[0].ID >= 0 {
		return ptr.Args[0].ID
	}
	return ptr.ID
}

// intSliceContains reports whether v is in s.
func intSliceContains(s *[]readonly int, v int) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == v { return true }
	}
	return false
}

// emitDerefNilCheck is emitNilCheckIfEnabled gated on `forDeref` — the caller's
// signal that the pointer being followed WILL be dereferenced (a load/store
// through it), not merely address-computed.  Address-of a field/element
// (`&p.field`, `&p[i]`) computes `base + offset` WITHOUT touching memory, so
// per the "deref only" design it must NOT fault on a nil
// base; the address-of callers pass forDeref=false.  Deref callers (reads,
// stores, `(*p)++`, method receivers via a load) pass true.  A pointer FOLLOWED
// to continue a chain (`p.a.b` loads `p.a` to reach `.b`) is always a deref, so
// genSelectorPtr's recursion passes true regardless of the outermost context.
func emitDerefNilCheck(ctx @GenContext, b @ir.Block, ptr @ir.Instr, forDeref bool) {
	if !forDeref { return }
	emitNilCheckIfEnabled(ctx, b, ptr)
}
