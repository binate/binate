package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_local_cleanup.bn.  noParams / noResults / fail are shared ir
// test helpers.  The populated (real live-set) pad case is covered end-to-end by
// pkg/binate/vm's lower_fault_pad_test.bn (source -> IR-gen -> lowering).

// emitDecForManagedLocals over a scope with no managed locals emits nothing and
// returns the same block — the whole-function cleanup a return (or a fault pad)
// runs is a no-op when there is nothing managed to release.
func TestEmitDecForManagedLocalsEmptyIsNoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var noRet *[]@ast.Expr
	var out @ir.Block = emitDecForManagedLocals(ctx, b, noRet)
	if out != b {
		return fail("no-locals cleanup should return the same block")
	}
	if len(b.Instrs) != 0 {
		return fail("no-locals cleanup should emit nothing")
	}
	return ""
}

// attachFaultPad tags the block's last instruction with a VM-only cleanup pad
// (in Func.FaultPads, NOT Func.Blocks) terminated by OP_UNWIND_RETURN.
func TestAttachFaultPadCreatesTaggedPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var idx @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var ln @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	irbuild.EmitBoundsCheck(b, idx, ln)
	var beforeBlocks int = len(f.Blocks)

	attachFaultPad(ctx, b)

	if len(f.FaultPads) != 1 {
		return fail("attachFaultPad should create exactly one FaultPad block")
	}
	if len(f.Blocks) != beforeBlocks {
		return fail("the pad must NOT be appended to Func.Blocks")
	}
	var pad @ir.Block = f.FaultPads[0]
	if len(pad.Instrs) == 0 {
		return fail("the pad should carry instructions")
	}
	var last @ir.Instr = pad.Instrs[len(pad.Instrs) - 1]
	if last.Op != iropcode.OP_UNWIND_RETURN {
		return fail("the pad must end with OP_UNWIND_RETURN")
	}
	// The tagged (bounds-check) op carries the pad entry as its PadBlock.
	var chk @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	if chk.PadBlock == nil {
		return fail("the faulting op should be tagged with its pad block")
	}
	// PadEmitMode must be reset after emitPadCleanup so later blocks route normally.
	if f.PadEmitMode {
		return fail("PadEmitMode must be reset after attachFaultPad")
	}
	return ""
}

// attachEmptyFaultPad tags the block's last (call) instruction with a BARE
// VM-only cleanup pad — one that releases nothing and just OP_UNWIND_RETURNs —
// for a synthesized forwarding function (a method-value wrapper) that owns no
// managed locals and has no @GenContext.  Distinct from attachFaultPad: the pad
// body is EMPTY (no RefDec cleanup), so it is exactly the single unwind
// terminator, and it still lets a fault relay through the frame instead of
// vmPanicking on a missing pad.
func TestAttachEmptyFaultPadCreatesBarePad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitCall(b, "test.callee", noArgs, types.TypVoid())
	var beforeBlocks int = len(f.Blocks)

	attachEmptyFaultPad(f, b)

	if len(f.FaultPads) != 1 {
		return fail("attachEmptyFaultPad should create exactly one FaultPad block")
	}
	if len(f.Blocks) != beforeBlocks {
		return fail("the pad must NOT be appended to Func.Blocks")
	}
	var pad @ir.Block = f.FaultPads[0]
	// A bare pad is exactly one instruction: the unwind terminator (no cleanup).
	if len(pad.Instrs) != 1 {
		return fail("the empty pad must carry ONLY the unwind terminator (no cleanup)")
	}
	if pad.Instrs[0].Op != iropcode.OP_UNWIND_RETURN {
		return fail("the empty pad must be a bare OP_UNWIND_RETURN")
	}
	var callOp @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	if callOp.PadBlock == nil {
		return fail("the forwarded call op should be tagged with its pad block")
	}
	return ""
}

// boundsCheckAt emits a bounds check at the end of b — the faulting op a pad
// attaches to — and returns it.
func boundsCheckAt(b @ir.Block) @ir.Instr {
	var idx @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var ln @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	irbuild.EmitBoundsCheck(b, idx, ln)
	return b.Instrs[len(b.Instrs) - 1]
}

// padLoads reports whether pad's entry block loads from slot.
func padLoads(pad *ir.Block, slot @ir.Instr) bool {
	for i := 0; i < len(pad.Instrs); i++ {
		var ins @ir.Instr = pad.Instrs[i]
		if ins.Op == iropcode.OP_LOAD && len(ins.Args) > 0 && ins.Args[0] == slot { return true }
	}
	return false
}

// Fault ops whose live set is the same land in one pad; a managed local declared,
// or a managed temporary registered, between two of them gives the later one a
// pad of its own, which releases the new value.
func TestAttachFaultPadSharedBySameLiveSet() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var c1 @ir.Instr = boundsCheckAt(b)
	attachFaultPad(ctx, b)
	var c2 @ir.Instr = boundsCheckAt(b)
	attachFaultPad(ctx, b)
	if len(f.FaultPads) != 1 || c1.PadBlock != c2.PadBlock {
		return fail("the same live set shares one pad")
	}

	var mpt @types.Type = types.MakeManagedPtrType(types.TypInt())
	var slot VarSlot
	slot.Name = "x"
	slot.Ptr = irbuild.EmitAlloc(b, mpt)
	slot.Typ = mpt
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
	var c3 @ir.Instr = boundsCheckAt(b)
	attachFaultPad(ctx, b)
	if c3.PadBlock == c2.PadBlock { return fail("a managed local declared since gives a new pad") }
	if !padLoads(c3.PadBlock, slot.Ptr) { return fail("the new pad releases the new local") }
	var c4 @ir.Instr = boundsCheckAt(b)
	attachFaultPad(ctx, b)
	if c4.PadBlock != c3.PadBlock { return fail("the next op with that live set shares the new pad") }

	var tmp @ir.Instr = irbuild.EmitLoad(b, slot.Ptr, mpt)
	ctx.Temps = slices.Append[@ir.Instr](ctx.Temps, tmp)
	var c5 @ir.Instr = boundsCheckAt(b)
	attachFaultPad(ctx, b)
	if c5.PadBlock == c4.PadBlock { return fail("a temporary registered since gives a new pad") }
	if len(f.FaultPads) < 3 { return fail("three pads in all") }
	return ""
}
