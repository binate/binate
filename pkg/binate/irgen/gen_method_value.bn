package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/std/strings"
import "pkg/stdx/slices"

// IR generation for method values `x.M`.  A method value binds a
// specific receiver
// instance to a method: the result is a function value whose
// signature is the method's signature MINUS the receiver, and
// invoking the function value calls M(boundReceiver, args...).
//
// Mechanism: per (method, receiver-shape) we synthesize a wrapper
// Func whose body forwards (receiver, user_args) to the
// underlying method.  The wrapper is marked IsClosure with one
// capture (the receiver) so the B.2 closure machinery — IR-gen
// alloca + store of the capture struct, OP_FUNC_VALUE-with-data,
// per-shape shim in each backend — does all the work.  No new
// backend code is needed; B.4 leverages B.2.
//
// B.4 status:
//   - Receiver kind T  + x type T  → capture T (works for any T).
//   - Receiver kind *T + x type *T → capture *T.
//   - Receiver kind @T (managed)   → gated to B.3 (CAP_MANAGED).
//   - Cross-kind smoothing (e.g. method takes *T, x is T) is not
//     yet supported — type-checker accepts only same-kind today.

// (The synthesized `T.M`-method-value wrapper dedup cache lives on
// @Module.MethodValueWrappers — a list of qualified wrapper names — so it's
// per-module rather than a package-global; see ir.bni.)

// isMethodValueSelector reports whether the EXPR_SELECTOR `e`
// resolves to a method value (B.4) rather than a struct field
// access or method expression.  Discriminators:
//   1. Resolved type must be a function-value type.
//   2. e.X must not be a recognized type name (that would be the
//      method-expression form T.M, handled separately).
//   3. e.X's type must have a METHOD named e.Name (not a field
//      of function-value type — fields take precedence, and the
//      type-checker has already routed that through the field
//      path).
func isMethodValueSelector(ctx @GenContext, e @ast.Expr) bool {
	var gc @GenCtx = ctx.Gc
	var c @check.Checker = ctx.Checker
	if e == nil || c == nil { return false }
	if e.ResolvedTypeID == 0 { return false }
	var t @types.Type = c.ExprType(e.ResolvedTypeID)
	if t == nil { return false }
	if t.Kind != types.TYP_FUNC_VALUE && t.Kind != types.TYP_MANAGED_FUNC_VALUE {
		return false
	}
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		// T.M — a method EXPRESSION over a struct or named-distinct scalar
		// receiver (methodExprName), not a bound value; mis-routed to
		// genMethodValue it would be a null-receiver value -> SIGSEGV.  A real
		// method VALUE `x.M` has e.X a VARIABLE — which may share its name with
		// a type, and then shadows it.
		if !selectorBaseIsVar(ctx, e) && len(methodExprName(gc, e.X.Name, e.Name)) > 0 {
			return false
		}
	}
	// A method EXPRESSION off a generic type instantiation (`Box[int].M`): the
	// base is an EXPR_INSTANTIATE_OR_INDEX generic-type instance, never a receiver
	// VALUE.  Recognize it so it is not mis-routed to genMethodValue (which would
	// treat the type as a null-receiver value -> SIGSEGV, the failure the
	// named-scalar carve-out above guards); genExprOrFuncRef emits it as a
	// method-expression func value.  A value-index base (`arr[i].M`) resolves to a
	// non-named type, so this does not fire and the bound-value path below runs.
	if e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		if len(baseNamedTypeName(typeArgExprToType(gc, e.X))) > 0 {
			return false
		}
	}
	// Check that e.X's type actually has a method named e.Name.
	// Without this guard, struct field access of a function-
	// value-typed field (e.g. `op.Fn` where Op has field Fn
	// *func(...) int) would mistakenly route here.
	if e.X == nil || e.X.ResolvedTypeID == 0 {
		return false
	}
	var xt @types.Type = c.ExprType(e.X.ResolvedTypeID)
	if xt == nil { return false }
	var recvBase @types.Type = xt.ReceiverBaseNamed()
	if recvBase == nil { return false }
	var m @types.Method = recvBase.LookupMethod(e.Name)
	if m == nil { return false }
	return true
}

// genMethodValue lowers `x.M` where M is a method on x's type.
// Returns the OP_FUNC_VALUE-with-data Instr that produces the
// 16-byte function value at runtime.
func genMethodValue(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	// Pull the receiver type from the type-checker's per-expr
	// registry — checker stored the receiver type at e.X's
	// ResolvedTypeID.
	var recvTyp @types.Type = nil
	if ctx.Checker != nil && e.X != nil && e.X.ResolvedTypeID != 0 {
		recvTyp = ctx.Checker.ExprType(e.X.ResolvedTypeID)
	}
	if recvTyp == nil {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	// Locate the method.
	var recvBase @types.Type = recvTyp.ReceiverBaseNamed()
	if recvBase == nil {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}
	var m @types.Method = recvBase.LookupMethod(e.Name)
	if m == nil || m.FuncType == nil {
		return irbuild.EmitConstInt(b, 0, types.TypInt())
	}

	// Compute the underlying method's qualified name in IR terms.  The method
	// symbol lives in the RECEIVER's DEFINING package, whose full path is carried
	// by the receiver's IR-gen type Name (path-qualified at the receiver's
	// declaration) — NOT by the checker's recvBase.Name, which is UNQUALIFIED
	// ("Box").  Using recvBase.Name made buildMethodQualName prepend ctx.Gc.PkgPath
	// (the importer, e.g. "main") → a reference to a nonexistent `main.Box.get`
	// symbol, a cross-package link failure.  Resolve the IR-gen receiver type
	// WITHOUT evaluating e.X (it is captured separately, once, by genCapturedRecv
	// below — a second genExpr here would double-evaluate a side-effecting
	// receiver).  A local receiver's name has no dot, so buildMethodQualName still
	// prepends this module's package, unchanged.
	var recvIRTyp @types.Type = methodValueRecvIRType(ctx, e.X)
	var recvTypeName @[]char = ""
	if recvIRTyp != nil {
		recvTypeName = baseNamedTypeName(recvIRTyp)
	}
	if len(recvTypeName) == 0 {
		recvTypeName = recvBase.Name
	}
	// A method VALUE on a generic instantiation references the monomorphized
	// method body just like a direct call — emit it now (a no-op otherwise) so
	// the wrapper's EmitCall below resolves to a defined symbol, not a dangling
	// one.  Mirrors genMethodCall / wrapAsIfaceValue: method bodies are emitted
	// lazily at every use site, not when the struct was laid out.
	ensureMethodsForInstName(ctx.Gc, recvTypeName)
	var methodQName @[]char = buildMethodQualName(
			ctx.Gc.PkgPath, recvTypeName, e.Name)

	// The closure struct holds the receiver in the form the
	// METHOD declares (not the form `e.X` was written as):
	//   * method takes `*T`, x is `T` → captured `*T = &x`
	//   * method takes `T`, x is `*T` or `@T` → captured `T` copy
	//   * method takes `@T`, x is `@T` → captured `@T` (RefInc'd)
	//   * etc.
	// `capturedTyp` is the captured form, computed below.  When it
	// differs from `recvTyp` (smoothing applies), `genCapturedRecv`
	// emits the appropriate address-of / deref at the construction
	// site.  Wrapper sig + closure-struct field + dedup key all
	// reflect the captured form, so two call sites with different
	// `e.X` types that smooth to the same captured form share one
	// wrapper.
	var capturedTyp @types.Type = m.FuncType.Params[0].Type

	// A value receiver on a pointer-receiver method captures its address when it
	// has one (func.method-value.capture: `*T` captures `&x`) — a variable, a
	// field (`obj.f.M`), an element (`arr[i].M`), `(*p).M`: the checker marks
	// those addressable receivers (e.ImplicitAddr), and genCapturedRecv takes the
	// address, so a call through the method value mutates x itself.  A
	// NON-addressable value receiver (`mk().M`, a by-value call result) has no
	// address to capture — &(a temporary) would dangle past the closure — so it
	// is captured BY VALUE, a copy the closure owns, which the wrapper
	// (synthMethodValueWrapper) allocas and addresses for the method call.
	if e.X != nil && e.X.Kind != ast.EXPR_IDENT && !e.ImplicitAddr && capturedTyp != nil &&
			capturedTyp.Kind == types.TYP_POINTER && capturedTyp.Elem != nil && recvTyp != nil &&
			recvTyp.Identical(capturedTyp.Elem) {
		// Capture ANY value receiver by value — register-returned OR sret
		// (> 16-byte, by-address), managed-field or not.  The closure store below
		// copies the receiver's bytes into the field (loading first if it arrived
		// as an aggregate alloca) and, for a struct with MANAGED fields, RefInc's
		// the copy's fields (emitStructCopy) so the closure owns its own reference
		// — balanced by the closure dtor's RefDec.  An sret call result is a
		// struct-typed value that EmitStore's aggregate lowering handles (LLVM
		// loads it and stores field-wise; native memcpys); the wrapper then
		// receives it as a byval param (see synthMethodValueWrapper's byval flag).
		capturedTyp = recvTyp
	}

	// For a generic-instantiation receiver, capturedTyp's base still carries the
	// checker's RAW name (`Box[int]`) — mangled into the closure struct / wrapper
	// sig it becomes an invalid LLVM identifier (`%bn_S..._Box[int]`).  Swap the
	// base for the IR-gen instantiated struct (`Box__bn_inst__int`, from the
	// receiver's IR-gen type), keeping the pointer/managed/value wrapper.  No-op
	// for a non-generic receiver.
	// How the receiver bridges to the captured form, decided on the checker's
	// types before the remap below renames a generic receiver's base.
	var bridge int = methodValueBridge(recvTyp, capturedTyp)
	capturedTyp = remapCapturedBaseToIR(capturedTyp, recvIRTyp)

	// Synthesize (or reuse) the wrapper Func.  Dedup by (method,
	// captured-form) — two call sites with smoothing into the
	// same captured form reuse one wrapper.
	var wrapperName @[]char = methodValueWrapperName(
			methodQName, capturedTyp)
	var have bool = false
	for i := 0; i < len(ctx.Gc.Mod.MethodValueWrappers); i++ {
		if irutil.Streq(ctx.Gc.Mod.MethodValueWrappers[i], wrapperName) {
			have = true
		}
	}
	if !have {
		synthMethodValueWrapper(ctx.Gc, wrapperName, methodQName, capturedTyp, m)
		ctx.Gc.Mod.MethodValueWrappers = slices.Append[@[]char](
				ctx.Gc.Mod.MethodValueWrappers, wrapperName)
	}

	// User-visible function-value type: method's params minus
	// the receiver.
	var userParams @[]@types.Param = make_slice(@types.Param, len(m.FuncType.Params) - 1)
	for i := 1; i < len(m.FuncType.Params); i++ {
		userParams[i - 1] = m.FuncType.Params[i]
	}
	var fnValTyp @types.Type = types.MakeFuncValueType(userParams, m.FuncType.Results)

	// At the selector site: store the evaluated receiver (possibly converted by
	// smoothing) into this site's frame closure record {receiver}
	// (allocFrameClosureRecord — allocated once per call, released at every
	// function exit), then emit OP_FUNC_VALUE-with-data pointing at the wrapper.
	// The store (emitStoreManagedSlot) gives the record its own reference to a
	// managed receiver — a fresh @T / @[]T call result is moved in, any other
	// @T / @[]T is RefInc'd, and a by-value struct's managed fields are copied
	// in (its call-result temp keeps its own end-of-statement release) — and
	// releases the previous evaluation's receiver, so a selector evaluated again
	// in the same call (a loop, a `for` condition) neither leaks nor frees early.
	var closureStruct @types.Type = buildMethodValueClosureStruct(ctx.Gc.PkgPath, wrapperName,
			capturedTyp)
	var closurePtr @ir.Instr = allocFrameClosureRecord(ctx, b, closureStruct, "")
	var recvVal @ir.Instr = genCapturedRecv(ctx, b, e.X, bridge, capturedTyp)
	// Re-sync: a type-assertion receiver (`a.(*T).Method`) splits the block inside
	// genCapturedRecv; the record stores below must land in the HIT continuation
	// (the record is allocated in the entry block, so it dominates it).  A no-op
	// for non-splitting receivers.
	b = ctx.CurBlock
	var fieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, closurePtr, 0, capturedTyp)
	// A struct that arrived as an aggregate alloca (a composite-literal temp,
	// `Pt{...}.M`) must be LOADED to a value before the store — EmitStore of the
	// alloca POINTER would store the address into the field (`store %S %ptr`), and
	// for a struct with managed fields the copy-in would then RefInc garbage.
	// The literal temp keeps its own end-of-statement release, so the record's
	// copy-in (emitStoreManagedSlot) gives it references of its own.  (A
	// call-result / field value receiver arrives as a struct-typed value (register
	// or sret), so this is a no-op there.)  Mirrors gen_call's
	// isAggregateAllocToLoad arg path.
	if isAggregateAllocToLoad(recvVal, capturedTyp) {
		recvVal = irbuild.EmitLoad(b, recvVal, capturedTyp)
	}
	b = emitStoreManagedSlot(ctx, b, fieldPtr, recvVal, capturedTyp, false)
	ctx.CurBlock = b
	if closureStruct.NeedsDestruction() && !isGlobalInitFunc(ctx) {
		// Name the frame record `__mv_local_<n>` for debug info; the counter is
		// shared with genFuncLit's `__funclit_<n>` names.
		var n int = ctx.Gc.FuncLitCounter
		ctx.Gc.FuncLitCounter = ctx.Gc.FuncLitCounter + 1
		closurePtr.StrVal = methodValueRecordName(n)
	}
	var fv @ir.Instr = irbuild.EmitFuncValueWithData(b, wrapperName, closurePtr, fnValTyp)
	fv.StaticClosureRecord = isGlobalInitFunc(ctx)
	noteSPGrowingResult(ctx, fv)
	return fv
}

// methodValueRecordName builds the debug name `__mv_local_<n>` of a method
// value's frame closure record (n is a gc.FuncLitCounter value).
func methodValueRecordName(n int) @[]char {
	var nameBuf @strings.Builder = strings.NewBuilder()
	nameBuf.Write("__mv_local_")
	nameBuf.Write(strconv.Itoa(n))
	return buf.CopyStr(nameBuf.String())
}

// methodValueWrapperName builds a stable name for the per-(method,
// receiver-shape) wrapper.  Including the receiver-type discriminator
// lets the same method support multiple receiver-shape wrappers (e.g.
// both `c.Add` with c:Counter and `(&c).Add` with c:*Counter, once
// smoothing lands).
func methodValueWrapperName(methodQName @[]char, recvTyp @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(methodQName)
	cb.Write("__methodval_")
	cb.Write(receiverShapeTag(recvTyp))
	return buf.CopyStr(cb.String())
}

// receiverShapeTag returns a short tag distinguishing receiver
// shape — `v` for value, `p` for raw pointer, `m` for managed
// pointer.  Drives the per-(method, captured-form) wrapper
// dedup: two call sites whose smoothings settle on the same
// captured form share one wrapper.
func receiverShapeTag(t @types.Type) @[]char {
	if t == nil { return "v" }
	var rt @types.Type = t.ResolveAlias()
	if rt == nil { return "v" }
	if rt.Kind == types.TYP_POINTER { return "p" }
	if rt.Kind == types.TYP_MANAGED_PTR { return "m" }
	return "v"
}

// buildMethodValueClosureStruct synthesizes the closure struct
// type {receiver}.  IR-gen for closure-struct field offset uses
// the standard struct layout machinery, same as B.2.
//
// The struct Name has two hard requirements:
//   1. Dot- and slash-free.  generateDtors' Pass 2 splits a dot-bearing struct
//      Name on the FIRST dot and treats the prefix as a package path — so
//      "__closure_main.Counter.Sum__methodval_v" would be mis-classified as
//      cross-package (pkg "__closure_main" != modPkg "main"), declared extern,
//      and never defined here; and a raw '/' in an LLVM type name is malformed.
//   2. UNIQUE per distinct wrapper.  A cross-package wrapperName embeds the
//      receiver's package path, so an ad-hoc '/'+'.'→'_' char fold would ALIAS
//      distinct receiver types onto one struct symbol (`pkg/a/b.C` and
//      `pkg/a.b_C` both fold to `__closure_pkg_a_b_C_...`) → a differently-
//      shaped-struct collision at codegen (the exact cross-package symbol-
//      collision class the mangler otherwise prevents).
// Deriving the Name from the wrapper's length-prefix-MANGLED symbol
// (mangle.FuncName) satisfies both: the mangled form is a flat, dot/slash-free
// identifier whose length prefixes keep every segment boundary distinct, so it
// stays in the unqualified-local dtor regime AND never aliases.
func buildMethodValueClosureStruct(pkgPath *[]readonly char, wrapperName *[]readonly char,
		recvTyp @types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fld @types.Field = make(types.Field)
	fld.Name = "recv"
	fld.Type = recvTyp
	fields[0] = fld
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__closure_")
	cb.Write(mangle.FuncName(pkgPath, wrapperName))
	return types.MakeStructType(buf.CopyStr(cb.String()), fields)
}
