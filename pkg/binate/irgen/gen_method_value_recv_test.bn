package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_method_value_recv.bn (method-value receiver handling).
// End-to-end behavior — including cross-package receiver-symbol qualification
// via methodValueRecvIRType — is covered by conformance/{503_method_value,
// 942_xpkg_method_value, 943_xpkg_method_value_selector}; these pin the
// helper-level shape.

// nameHasBracket detects the checker's raw generic-instantiation spelling.
func TestNameHasBracket() testing.TestResult {
	if !nameHasBracket("Box[int]") {
		return "expected bracket in Box[int]"
	}
	if nameHasBracket("Box__bn_inst__1_N0_3_int") {
		return "mangled name has no bracket"
	}
	if nameHasBracket("File") {
		return "plain name has no bracket"
	}
	return ""
}

// remapCapturedBaseToIR swaps a raw-bracket generic base for the IR-gen struct,
// keeping the pointer wrapper; a non-generic (no-bracket) base is unchanged.
func TestRemapCapturedBaseToIR() testing.TestResult {
	var noFields @[]@types.Field
	var captured @types.Type = types.MakePointerType(types.MakeStructType("Box[int]", noFields))
	var recvIR @types.Type = types.MakePointerType(
			types.MakeStructType("Box__bn_inst__1_N0_3_int", noFields))
	var got @types.Type = remapCapturedBaseToIR(captured, recvIR)
	if got == nil || got.Kind != types.TYP_POINTER {
		return "expected pointer result"
	}
	var gb @types.Type = peelToNamedBase(got)
	if gb == nil || !irutil.Streq(gb.Name, "Box__bn_inst__1_N0_3_int") {
		return "expected remapped base Box__bn_inst__1_N0_3_int"
	}
	var plain @types.Type = types.MakePointerType(types.MakeStructType("File", noFields))
	if remapCapturedBaseToIR(plain, recvIR) != plain {
		return "non-generic base should be returned unchanged"
	}
	return ""
}

// storesValueOfOp reports whether fn stores, anywhere, a value produced by an
// instruction with opcode op (the closure-struct capture of a method value).
func storesValueOfOp(fn @ir.Func, op int) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) == 2 && ins.Args[1].Op == op { return true }
		}
	}
	return false
}

// A method value bound to a `*T` method of an addressable field captures the
// field's ADDRESS (the closure stores the field pointer), so a call through it
// mutates the field; a by-value call result has no address and is captured as
// a copy (a loaded value, no field pointer stored).
func TestMethodValueCapturesFieldAddress() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type P struct { n int }\n"
					"func (p *P) bump() { p.n = p.n + 1 }\n"
					"type H struct { a int; p P }\n"
					"func mk() P { var p P; return p }\n"
					"func field() { var h H; var f *func() = h.p.bump; f() }\n"
					"func call() { var f *func() = mk().bump; f() }\n")
	if !storesValueOfOp(findFunc(m, "field"), iropcode.OP_GET_FIELD_PTR) {
		return fail("a method value on a field must capture the field's address")
	}
	if !storesValueOfOp(findFunc(m, "call"), iropcode.OP_CALL) {
		return fail("a method value on a call result must capture the result by value")
	}
	return ""
}
