package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_method_value.bn.  End-to-end behavior is covered by
// conformance/503_method_value; these pin the helper-level shape.

// receiverShapeTag distinguishes value-receiver from pointer-
// receiver in the wrapper name so the same method backs distinct
// wrappers per shape.
func TestReceiverShapeTagPtr() testing.TestResult {
	var pt @types.Type = types.MakePointerType(types.TypInt())
	var tag @[]char = receiverShapeTag(pt)
	if len(tag) != 1 || tag[0] != 'p' {
		return "expected `p` for *T"
	}
	return ""
}

func TestReceiverShapeTagValue() testing.TestResult {
	var s @types.Type = types.MakeStructType("T", make_slice(@types.Field, 0))
	var tag @[]char = receiverShapeTag(s)
	if len(tag) != 1 || tag[0] != 'v' {
		return "expected `v` for T (value)"
	}
	return ""
}

func TestReceiverShapeTagNil() testing.TestResult {
	var tag @[]char = receiverShapeTag(nil)
	if len(tag) != 1 || tag[0] != 'v' {
		return "expected `v` for nil (default)"
	}
	return ""
}

// isMethodValueWrapperOf matches a method's wrappers, of each receiver shape, and
// not those of a method whose name extends the method's.
func TestIsMethodValueWrapperOf() testing.TestResult {
	if !isMethodValueWrapperOf("test.Mv.Size__methodval_p", "test.Mv.Size") ||
			!isMethodValueWrapperOf("test.Mv.Size__methodval_v", "test.Mv.Size") {
		return "Size's wrappers must match"
	}
	if isMethodValueWrapperOf("test.Mv.Sizes__methodval_p", "test.Mv.Size") ||
			isMethodValueWrapperOf("test.Mv.Size__methodval_x__methodval_p", "test.Mv.Size") ||
			isMethodValueWrapperOf("test.Mv.Size", "test.Mv.Size") {
		return "only Size's wrappers must match"
	}
	return ""
}

// Shadowing a method forgets exactly its method-value wrappers — for a method of
// a generic type, those of each instance — and keeps the others.
func TestShadowReplMethodValues() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes(
					"package \"test\"\ntype Mv struct { n int }\n"
							"func (v *Mv) Size() int { return v.n }\n"
							"func (v *Mv) Other() int { return 2 }\n"
							"type Box[T any] struct { v T }\n"
							"func (b *Box[T]) get() T { return b.v }\n"
							"func main() { var mv Mv; var bi Box[int]; var bb Box[bool]\n"
							"\tvar f *func() int = mv.Size; var g *func() int = mv.Other\n"
							"\tvar h *func() int = bi.get; var k *func() bool = bb.get\n"
							"\t_ = f(); _ = g(); _ = h(); _ = k() }\n"), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	var size @ast.Decl
	var get @ast.Decl
	for i := 0; i < len(file.Decls); i++ {
		if irutil.Streq(file.Decls[i].Name, "Size") { size = file.Decls[i] }
		if irutil.Streq(file.Decls[i].Name, "get") { get = file.Decls[i] }
	}
	if size == nil || get == nil { return "Size and get must be declared" }
	if len(gc.Mod.MethodValueWrappers) != 4 { return "four wrappers must be synthesized" }
	var sw @[]@[]char = ShadowReplMethodValues(gc, size)
	if len(sw) != 1 || !isMethodValueWrapperOf(sw[0], "test.Mv.Size") {
		return "Size's wrapper must be shadowed"
	}
	if len(ShadowReplMethodValues(gc, get)) != 2 {
		return "the wrappers of Box[int].get and Box[bool].get must be shadowed"
	}
	if len(gc.Mod.MethodValueWrappers) != 1 ||
			!isMethodValueWrapperOf(gc.Mod.MethodValueWrappers[0], "test.Mv.Other") {
		return "Other's wrapper must be kept"
	}
	if len(ShadowReplMethodValues(gc, size)) != 0 {
		return "a forgotten wrapper is not shadowed again"
	}
	return ""
}
