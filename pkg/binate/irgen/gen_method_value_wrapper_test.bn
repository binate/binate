package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strings"

// IR-structural tests for synthMethodValueWrapper (gen_method_value_wrapper.bn).
// End-to-end behavior is covered by conformance/503_method_value and
// 1270_method_value_val_recv_managed; these pin the wrapper's emitted shape.

// wrapperFunc returns the synthesized IsClosure method-value wrapper in m (the only
// closure func these single-method-value programs produce), or nil.
func wrapperFunc(m @ir.Module) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if m.Funcs[i].IsClosure {
			return m.Funcs[i]
		}
	}
	return nil
}

// The wrapper forwards to the wrapped method through a recoverable-stack-overflow
// PRE-CHECK (OP_STACK_CHECK), so a frame-push overflow releases the wrapper's owned
// moved values via the pre-check's pad instead of orphaning them.
func TestWrapperEmitsForwardStackCheck() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type T struct {\n\tx int\n}\n"
					"func (t T) get() int { return t.x }\n"
					"func use() int {\n"
					"\tvar v T\n"
					"\tvar mv *func() int = v.get\n"
					"\treturn mv()\n}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var w @ir.Func = wrapperFunc(m)
	if w == nil {
		return fail("expected a synthesized method-value wrapper func")
	}
	if countOp(w, iropcode.OP_STACK_CHECK) < 1 {
		return fail("wrapper must emit OP_STACK_CHECK before forwarding to the method")
	}
	return ""
}

// A VALUE-struct receiver with managed fields is COPIED (field-RefInc'd via a
// __copy call) before the forward — the value method CONSUMES its receiver
// (dtor'd at its exit), so without the copy the wrapper over-releases the closure's
// captured receiver (double-free / UAF).  The copy shows up as an extra OP_CALL in
// the wrapper vs a non-managed value receiver (which needs none).
func TestWrapperValueStructManagedReceiverCopied() testing.TestResult {
	var managed @[]readonly char = "package \"test\"\n"
			"type Cell struct {\n\tp @int\n}\n"
			"func (c Cell) get() int { return *c.p }\n"
			"func use() int {\n"
			"\tvar c Cell\n"
			"\tc.p = box(0)\n"
			"\tvar mv *func() int = c.get\n"
			"\treturn mv()\n}\n"
	var plain @[]readonly char = "package \"test\"\n"
			"type Cell struct {\n\tn int\n}\n"
			"func (c Cell) get() int { return c.n }\n"
			"func use() int {\n"
			"\tvar c Cell\n"
			"\tvar mv *func() int = c.get\n"
			"\treturn mv()\n}\n"
	var wm @ir.Func = wrapperFunc(genFromSourceWithChecker(buf.CopyStr(managed)))
	var wp @ir.Func = wrapperFunc(genFromSourceWithChecker(buf.CopyStr(plain)))
	if wm == nil || wp == nil {
		return fail("expected a wrapper func for each program")
	}
	// The managed-field receiver wrapper has one more OP_CALL — the receiver
	// emitStructCopy — than the plain one (both share the single forward call).
	if countOp(wm, iropcode.OP_CALL) <= countOp(wp, iropcode.OP_CALL) {
		return fail("value-struct managed-field receiver must be emitStructCopy'd before the forward")
	}
	return ""
}

// The receiver __copy CALL is emitted BEFORE the forward pre-check, and in the VM
// that call pushes a frame that can overflow — so it must carry its own fault pad
// (releasing the wrapper's owned moved params) rather than orphaning them.  This
// pins that the copy call's PadBlock is set; without the pad it would be nil.
func TestWrapperCopyCallPaddedForOverflow() testing.TestResult {
	var src @[]readonly char = "package \"test\"\n"
			"type Cell struct {\n\tp @int\n}\n"
			"func (c Cell) get() int { return *c.p }\n"
			"func use() int {\n"
			"\tvar c Cell\n"
			"\tc.p = box(0)\n"
			"\tvar mv *func() int = c.get\n"
			"\treturn mv()\n}\n"
	var w @ir.Func = wrapperFunc(genFromSourceWithChecker(buf.CopyStr(src)))
	if w == nil {
		return fail("expected a wrapper func")
	}
	if !copyCallHasPad(w) {
		return fail("wrapper's receiver __copy call must carry a fault pad (overflow safety)")
	}
	return ""
}

// copyCallHasPad reports whether fn's first __copy OP_CALL carries a cleanup pad
// (PadBlock set).  Used to check the value-struct-receiver copy's overflow safety.
func copyCallHasPad(fn @ir.Func) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL && containsSub(ins.StrVal, "__copy") {
				return ins.PadBlock != nil
			}
		}
	}
	return false
}
