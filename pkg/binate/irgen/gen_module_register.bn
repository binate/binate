package "pkg/binate/irgen"

import "pkg/binate/ast"

// Cross-package type-registration pre-passes.  Before a package's IR is
// generated (GeneratePackage), every loaded package's interface and struct
// TYPES must be registered into the module, so a reference that crosses package
// boundaries resolves regardless of import order.  RegisterAllInterfaces
// registers DECL_INTERFACE entries; RegisterStructTypes registers struct names
// and populates their fields.  (Var globals and func externs are registered
// elsewhere — registerVarGlobals and RegisterImports.)

// registerAllInterfacesFlat (RegisterAllInterfaces, over type-group-flattened
// files) registers DECL_INTERFACE entries from every
// loaded package (including transitive dependencies that the
// importing TU doesn't reference directly). When an importing TU's IR-gen processes
// an imported package's DECL_IMPL whose iface ref points at a
// transitive package's alias (e.g., `impl *Hello : aliases.Hello`
// where the importing TU imports neither aliases nor greeter
// directly), canonicalIfacePkg / canonicalIfaceName must still
// resolve the alias chain — which requires the alias's underlying
// interface to be in the module's interface registry. Same pattern as
// RegisterStructTypes for transitive struct visibility.
func registerAllInterfacesFlat(paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	// Cross-package pre-pass: per-package paths (paths[k]) drive
	// qualification, so gc carries no module-of-its-own path here
	// (gc.PkgPath is empty — the importing module isn't GeneratePackage'd
	// yet).  gc.Mod is the importing module, so the resolution of parent
	// refs and their type arguments sees the cross-package structs
	// RegisterStructTypes registered into that same module.
	// paths[k] is the import path of files[k]; passing it as the
	// pkg for interface registration ensures two same-last-segment
	// packages' interfaces don't collide.  Every
	// package's generic interfaces are stashed first: an interface may name
	// a generic parent declared after it, in its own package or (in a pass
	// whose order is not the dependency order) another
	// (stashGenericIfaceDecls).
	for k := 0; k < len(paths); k++ {
		if files[k] != nil { stashGenericIfaceDecls(gc, files[k], paths[k]) }
	}
	for k := 0; k < len(paths); k++ {
		if files[k] != nil { collectDeclaredInterfaces(gc, files[k].Decls, paths[k]) }
	}
}

// registerStructTypesFlat (RegisterStructTypes, over type-group-flattened
// files) registers struct type names and populates fields from
// the given packages, without registering function signatures. Used to make
// transitive dependency struct types available for field type resolution.
func registerStructTypesFlat(paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	// Cross-package pre-pass (empty gc.PkgPath; see RegisterAllInterfaces).
	// gc.Mod is the importing module: this pass populates that module's
	// per-module Structs / TypeAliases tables.
	// Qualified names are built from paths[k] (qualNameInPkg), so two
	// packages sharing a last path segment get distinct qualifiers
	// (`pkg/alpha/widget.X` vs `pkg/beta/widget.X`).  These packages are
	// not added to the module's import list: that is the importing
	// module's RegisterImports' job, for its own imports.
	// The steps of gen_type_steps.bn, each for every package before the next: the
	// struct names; the generic stashes and interface stubs, so an alias of a
	// generic instantiation or typed through an interface resolves -- also when the
	// interface is collected only by the later RegisterAllInterfaces pass; each
	// package's opaque types, and then its type aliases and named non-struct types;
	// and the structs' fields.  A generic struct is no struct: only its instances
	// are, registered where they are used (ensureInstantiatedStruct).
	for k := 0; k < len(paths); k++ {
		if files[k] != nil { registerStructNames(gc, files[k].Decls, paths[k]) }
	}
	for k := 0; k < len(paths); k++ {
		if files[k] != nil { registerTypeStubs(gc, files[k].Decls, paths[k]) }
	}
	for k := 0; k < len(paths); k++ {
		if files[k] == nil { continue }
		registerOpaqueForwards(gc, files[k].Decls, paths[k])
		registerTypeDecls(gc, files[k].Decls, paths[k])
	}
	for k := 0; k < len(paths); k++ {
		if files[k] != nil { fillDeclaredStructFields(gc, files[k].Decls, paths[k]) }
	}
}
