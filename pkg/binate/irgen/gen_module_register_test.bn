package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// RegisterStructTypes (the cross-package struct pre-pass) writes the IMPORTING
// module's per-module Structs table.  A struct from a registered package must
// land in m.Structs under its full-path-qualified name, and must NOT be visible
// from an unrelated module (per-module isolation).
func TestRegisterStructTypesPopulatesImportingModule() testing.TestResult {
	var m @ir.Module = InitModule("\"main\"")
	var src *[]readonly char = "package \"pkg/shapes\"\ntype Circle struct {\n\tR int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "shapes.bni")
	var file @ast.File = p.ParseFile()
	var aliases @[]@[]char = @[]@[]char{"pkg/shapes"}
	var paths @[]@[]char = @[]@[]char{"pkg/shapes"}
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file

	RegisterStructTypes(aliases, paths, files, NewGenCtx(m))

	if lookupStructIdx(NewGenCtx(m), "pkg/shapes.Circle") < 0 {
		return fail("RegisterStructTypes must register pkg/shapes.Circle into m.Structs")
	}
	if lookupStructIdx(NewGenCtx(ir.NewModule("other")), "pkg/shapes.Circle") >= 0 {
		return fail("registered struct must not be visible from an unrelated module")
	}
	return ""
}

// A .bni-only opaque (forward-declared) type — `type Handle`, no body — must be
// registered as a distinct named type so a cross-package `@Handle` reference resolves
// (for method / dtor mangling) instead of falling to resolveTypeExpr's TypInt().  This
// is the interp/driver case: a compiled library injected as externs exposes an opaque
// type and a driver calls methods on it; without registration the receiver mis-lowers to
// an int and the method extern is not found.
func TestRegisterStructTypesOpaqueForwardDecl() testing.TestResult {
	var m @ir.Module = InitModule("\"main\"")
	var gc @GenCtx = NewGenCtx(m)
	var p @parser.Parser = parser.NewInterface(
			strToBytes("package \"pkg/opq\"\ntype Handle\n"), "opq.bni")
	var file @ast.File = p.ParseFile()

	var aliases @[]@[]char = make_slice(@[]char, 1)
	aliases[0] = buf.CopyStr("pkg/opq")
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("pkg/opq")
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterStructTypes(aliases, paths, files, gc)

	var t @types.Type = lookupTypeAlias(gc, "pkg/opq.Handle")
	if t == nil { return fail("opaque forward-declared type should be registered") }
	if t.Kind != types.TYP_NAMED { return fail("opaque type should be registered as TYP_NAMED") }
	if !seq(t.Name, "pkg/opq.Handle") { return fail("opaque type should carry its qualified name") }
	return ""
}
