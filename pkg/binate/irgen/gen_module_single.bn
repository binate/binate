package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// GenModule generates an IR module from a single ast.File — the
// simple-test / REPL-ish entry that owns both module construction
// and the full IR-gen sweep.  Multi-package callers go through
// InitModule + RegisterImport(s) + GeneratePackage in gen_module.bn
// instead; this wrapper bundles those steps for callers that only
// have one self-contained file.
func GenModule(c @check.Checker, file @ast.File) @ir.Module {
	requireChecker(c)
	file = normalizeFileDecls(file)
	var m @ir.Module = InitModule(file.PkgName)
	m.Checker = c
	// In this single-file path m.Name and file.PkgName agree (the
	// caller is testing or REPL-ish, where the file IS the module),
	// so it's safe to source the package path from file.PkgName here.
	// GeneratePackage sources from m.Name to handle the cmd/* case
	// where they disagree.
	// Module-scoped home for the path (see GeneratePackage).
	m.PkgPath = mangle.PkgPathFromQuoted(file.PkgName)
	// Per-compilation gen context (see GeneratePackage), threaded into
	// @GenContext.Gc.
	var gc @GenCtx = NewGenCtx(m)
	resetFuncLitState(gc)

	// The struct names, the generic stashes and interface stubs, and the type
	// aliases and named non-struct types (gen_type_steps.bn), before any const,
	// global or signature of the first pass is resolved through one -- as
	// GeneratePackage does, which gives the reasons.
	registerStructNames(gc, file.Decls, gc.PkgPath)
	registerTypeStubs(gc, file.Decls, gc.PkgPath)
	registerUndefinedForwardTypes(gc, file.Decls, file.Decls)
	registerTypeDecls(gc, file.Decls, gc.PkgPath)
	// First pass: constants, globals and the interfaces' method sets, interleaved
	// as in GeneratePackage.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			genConst(gc, m.Checker, d)
		}
		// DECL_GROUP contains grouped const declarations
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(gc, m.Checker, d)
		}
		// Struct type names are registered in the pre-pass above.
		// Global variable declarations (top-level or grouped var members;
		// blank vars get no storage — see registerVarGlobals).
		if d.Kind == ast.DECL_VAR || d.Kind == ast.DECL_GROUP {
			registerVarGlobals(gc, d)
		}
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, gc.PkgPath)
		}
	}
	// Impls pass: walk DECL_IMPL entries to populate m.Impls.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_IMPL {
			noteGenericImplDecl(gc, d, gc.PkgPath)
			collectImplsFromDecl(gc, d, gc.PkgPath, m)
		}
	}

	// Second pass: the structs' fields, on the registered type objects
	// (fillDeclaredStructFields).
	fillDeclaredStructFields(gc, file.Decls, gc.PkgPath)

	// Third pass: register function and method signatures (append to
	// existing, preserving imports).  Generic decls registered into
	// gc.GenericDecls for lazy monomorphization — see the non-
	// incremental compileToModule above for the rationale.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
			gc.GenericDeclPkgs = slices.Append[@[]char](
					gc.GenericDeclPkgs, buf.CopyStr(gc.PkgPath))
			continue
		}
		if isGenericReceiverMethod(d) {
			// Method on a generic type — stash for per-instantiation emission
			// (ensureMethodsForInstName), not at declaration time.
			stashGenericMethodDecl(gc, d, gc.PkgPath)
			continue
		}
		if d.Recv != nil {
			ir.RegisterFuncSig(gc.Mod, methodSig(gc, gc.PkgPath, d))
			continue
		}
		// A blank `func _` (kept only when it carries `#[c_export]`) binds no
		// name, so nothing in Binate calls it: no signature to register.
		if isBlank(d.Name) {
			continue
		}
		var sigParams @[]@types.Type = declParamTypes(gc, d)
		ir.RegisterFuncSig(gc.Mod,
				funcSigOf(qualifyForCurrentModule(gc, d.Name), sigParams, declIsVariadic(d),
						declResultTypes(gc, d)))
	}

	// Register the current module's compiler-synthesized `__Package()`
	// accessor so an unqualified `__Package()` call resolves and lowers.
	registerCurrentModulePackageAccessor(gc, m.Checker)

	// Add globals to module.  Imported extern vars (IsExtern) become
	// `external global` decls; same-package vars become definitions.
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		var g @ir.Global = make(ir.Global)
		g.Name = gc.Mod.GlobalVars[i].Name
		g.Typ = gc.Mod.GlobalVars[i].Typ
		g.IsExtern = gc.Mod.GlobalVars[i].IsExtern
		g.Exported = gc.Mod.GlobalVars[i].Exported
		m.AddGlobal(g)
	}

	// Third pass: generate function and method bodies.  Generic
	// decls skipped (emitted per instantiation).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			continue
		}
		if isGenericReceiverMethod(d) {
			continue
		}
		if d.Recv != nil {
			m.AddFunc(genMethod(gc, m.Checker, d, gc.PkgPath))
		} else {
			m.AddFunc(genFunc(gc, m.Checker, d))
		}
	}

	// Generate the per-package var-initializer function if any
	// top-level `var x T = expr` decls exist.
	generatePackageInit(gc, file.Decls, m)

	// Synthesize the VM-teardown function (RefDecs each managed global's
	// content) BEFORE generateDtors, so the dtors its body references get
	// generated — a managed global is destroyed nowhere else.
	addGlobalTeardownFunc(m)

	// Generate destructor functions (after user functions)
	generateDtors(m)

	// Generate copy functions (symmetric to dtors)
	generateCopies(m)

	// Generate iv-dispatch receiver thunks for value-receiver
	// impls (mirrors GeneratePackage above).
	generateIvDispatchThunks(m)

	return m
}
