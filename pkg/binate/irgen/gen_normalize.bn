package "pkg/binate/irgen"

import "pkg/binate/ast"

// Every file entering IR-gen is normalized first (normalizeFileDecls):
//
// Type declarations may be grouped — `type ( S struct { x int }; C int; P = *C )`
// — which is pure syntax (no iota or other group semantics).  IR-gen's passes
// walk a file's top-level type declarations, so each type group is flattened
// into its member declarations; otherwise every grouped type is missing — a
// grouped struct's fields are unresolvable and a grouped alias silently lowers
// as the int fallback.
//
// Blank declarations of a type, an interface or a function (`type _ …`,
// `interface _ …`, `func _(…) …`) are dropped: one binds no name and nothing can
// refer to it (the checker has already validated it), so there is nothing to
// lower — and registering or emitting several under the name `_` would collide.
// The exception is a blank function carrying `#[c_export]`: C calls it by its
// export name, so it is kept and emitted under a name derived from that
// (funcSymbolName).  (A blank `var _ = …` stays: its initializer runs.  Blank
// constants stay too: they carry no code, and a const group's `_` member still
// advances iota.)

// isTypeGroup reports whether d is a `type ( ... )` group.
func isTypeGroup(d @ast.Decl) bool {
	return d != nil && d.Kind == ast.DECL_GROUP && len(d.Decls) > 0 && d.Decls[0].Kind == ast.DECL_TYPE
}

// isBlankDecl reports whether d is a blank type, interface or (non-method)
// function declaration.
func isBlankDecl(d @ast.Decl) bool {
	if d == nil || !isBlank(d.Name) {
		return false
	}
	return d.Kind == ast.DECL_TYPE || d.Kind == ast.DECL_INTERFACE ||
			(d.Kind == ast.DECL_FUNC && d.Recv == nil)
}

// isDroppedBlankDecl reports whether d is a blank declaration normalizeFileDecls
// drops: every isBlankDecl but a blank function carrying `#[c_export]`.
func isDroppedBlankDecl(d @ast.Decl) bool {
	if !isBlankDecl(d) {
		return false
	}
	return d.Kind != ast.DECL_FUNC || len(collectCExportNames(d.Annotations)) == 0
}

// normalizeFileDecls returns file with each type group replaced by its member
// declarations, in order, and the blank declarations IR-gen drops removed —
// file itself when it has neither.
func normalizeFileDecls(file @ast.File) @ast.File {
	if file == nil { return file }
	var n int = 0
	var changed bool = false
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isTypeGroup(d) {
			changed = true
			for j := 0; j < len(d.Decls); j++ {
				if !isDroppedBlankDecl(d.Decls[j]) {
					n = n + 1
				}
			}
		} else if isDroppedBlankDecl(d) {
			changed = true
		} else {
			n = n + 1
		}
	}
	if !changed { return file }
	var decls @[]@ast.Decl = make_slice(@ast.Decl, n)
	var k int = 0
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isTypeGroup(d) {
			for j := 0; j < len(d.Decls); j++ {
				if !isDroppedBlankDecl(d.Decls[j]) {
					decls[k] = d.Decls[j]
					k = k + 1
				}
			}
		} else if !isDroppedBlankDecl(d) {
			decls[k] = d
			k = k + 1
		}
	}
	var flat @ast.File = make(ast.File)
	flat.Pos = file.Pos
	flat.PkgName = file.PkgName
	flat.Imports = file.Imports
	flat.Decls = decls
	flat.Annotations = file.Annotations
	flat.Comments = file.Comments
	return flat
}

// normalizeFileDeclsAll is normalizeFileDecls over each of files.
func normalizeFileDeclsAll(files *[]@ast.File) @[]@ast.File {
	var out @[]@ast.File = make_slice(@ast.File, len(files))
	for i := 0; i < len(files); i++ {
		out[i] = normalizeFileDecls(files[i])
	}
	return out
}

// RegisterStructTypes normalizes the files' declarations (normalizeFileDeclsAll) and runs
// registerStructTypesFlat.
func RegisterStructTypes(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerStructTypesFlat(aliases, paths, normalizeFileDeclsAll(files), gc)
}

// RegisterAllInterfaces normalizes the files' declarations (normalizeFileDeclsAll) and runs
// registerAllInterfacesFlat.
func RegisterAllInterfaces(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerAllInterfacesFlat(aliases, paths, normalizeFileDeclsAll(files), gc)
}

// RegisterGenericBodyDeps normalizes the files' declarations (normalizeFileDeclsAll) and runs
// registerGenericBodyDepsFlat.
func RegisterGenericBodyDeps(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerGenericBodyDepsFlat(aliases, paths, normalizeFileDeclsAll(files), gc, true)
}

// RegisterGenericBodyDepSigs normalizes the files' declarations (normalizeFileDeclsAll) and
// runs registerGenericBodyDepsFlat with no extern Funcs.
func RegisterGenericBodyDepSigs(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File,
		gc @GenCtx) {
	registerGenericBodyDepsFlat(aliases, paths, normalizeFileDeclsAll(files), gc, false)
}

// RegisterGenericDecls normalizes the files' declarations (normalizeFileDeclsAll) and runs
// registerGenericDeclsFlat.
func RegisterGenericDecls(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerGenericDeclsFlat(aliases, paths, normalizeFileDeclsAll(files), gc)
}

// RegisterImportedImpls normalizes the files' declarations (normalizeFileDeclsAll) and runs
// registerImportedImplsFlat.
func RegisterImportedImpls(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerImportedImplsFlat(aliases, paths, normalizeFileDeclsAll(files), gc)
}
