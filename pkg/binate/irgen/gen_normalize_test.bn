package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for gen_normalize.bn.

// A type group is replaced by its members, in place and in order; other
// declarations (a const group) stay as they are.
func TestNormalizeFlattensTypeGroups() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"const ( K1 int = 1; K2 int = 2 )\n"
					"type ( A int; B = A )\n"
					"type C int\n")
	var flat @ast.File = normalizeFileDecls(file)
	if len(flat.Decls) != 4 { return fail("expected the const group, A, B and C") }
	if flat.Decls[0].Kind != ast.DECL_GROUP { return fail("the const group should stay grouped") }
	if !charsEqual(flat.Decls[1].Name, "A") || !charsEqual(flat.Decls[2].Name, "B") {
		return fail("the type group's members should follow in order")
	}
	if !charsEqual(flat.Decls[3].Name, "C") { return fail("C should come last") }
	if len(file.Decls) != 3 { return fail("the input file must not change") }
	return ""
}

// A file without a type group or a dropped blank declaration is returned as is.
func TestNormalizeUnchangedFile() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ntype C int\n")
	if !same(normalizeFileDecls(file), file) { return fail("expected the same file") }
	return ""
}

// Blank type, interface and (non-method) function declarations are dropped —
// also from a type group — while a blank var and a blank const stay.
func TestNormalizeDropsBlankDecls() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"type _ int\n"
					"type ( A int; _ = A )\n"
					"interface _ { M() }\n"
					"func _() {}\n"
					"var _ int = 1\n"
					"const _ = 2\n"
					"func F() {}\n")
	var n @ast.File = normalizeFileDecls(file)
	if len(n.Decls) != 4 { return fail("expected A, the blank var, the blank const and F") }
	if !charsEqual(n.Decls[0].Name, "A") { return fail("A should come first") }
	if n.Decls[1].Kind != ast.DECL_VAR { return fail("the blank var should stay") }
	if n.Decls[2].Kind != ast.DECL_CONST { return fail("the blank const should stay") }
	if !charsEqual(n.Decls[3].Name, "F") { return fail("F should come last") }
	return ""
}

// A blank function carrying `#[c_export]` is kept: C calls it by that name.
func TestNormalizeKeepsBlankCExportFunc() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"func _() {}\n"
					"#[c_export(\"my_cb\")]\n"
					"func _() {}\n")
	var n @ast.File = normalizeFileDecls(file)
	if len(n.Decls) != 1 { return fail("expected only the c_export blank func") }
	if !charsEqual(funcSymbolName(n.Decls[0]), "__c_export_my_cb") {
		return fail("the blank c_export func should be named after its C export name")
	}
	return ""
}
