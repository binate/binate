package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// IR-gen for the predeclared `panic(msg)` function.

// genPanicCall lowers a `panic(msg)` call.  panic is the one predeclared
// function (spec §15.7): it takes a single message argument and aborts
// unrecoverably — Binate has no recoverable panic/recover.  It lowers to a
// call to rt.Panic (which prints "panic: <msg>" and aborts) followed by an
// unreachable terminator.
// Routing through rt.Panic matches the runtime-abort convention
// (rt.BoundsFail / rt.DivFail) and uses only OP_CALL + OP_UNREACHABLE,
// so it aborts loudly on every backend (LLVM, the VM, and native)
// without a backend-specific panic op.
func genPanicCall(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	// panic(msg) lowers to a call to rt.Panic (which prints "panic: <msg>" and
	// Aborts) followed by an unreachable terminator.  panic takes a single
	// string message — there is no variadic value-formatting form, so no
	// value-formatting helpers are pulled in.  The message slice is
	// materialized exactly as a normal call argument would be (coerceArg →
	// EmitStringToChars for a string-literal arg), since this special lowering
	// bypasses genCall.  The arity (exactly one string arg) is enforced by the
	// checker (checkCallExpr).
	var msg @ir.Instr
	if len(e.Args) > 0 {
		msg = genExpr(ctx, b, e.Args[0])
		b = ctx.CurBlock
	} else {
		var empty @[]char
		msg = irbuild.EmitConstString(b, empty)
	}
	var sliceTyp @types.Type = types.MakeSliceType(
			types.MakeReadonlyType(types.TypChar()))
	msg = coerceArg(ctx, b, msg, sliceTyp)
	irbuild.EmitCall(b, "pkg/builtins/rt.Panic", irbuild.MakeArgs1(msg), types.TypVoid())
	irbuild.EmitUnreachable(b)
	// The call + unreachable terminate b; panic's expression "result"
	// is dead.  Return a DETACHED const-nil (NOT added to b) so the
	// now-terminated block keeps a single terminator.
	return ir.NewInstr(b.Func, iropcode.OP_CONST_NIL, types.TypNil())
}
