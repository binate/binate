package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// genPanicCall lowers `panic(msg)` to a call to pkg/builtins/rt.Panic followed
// by an unreachable terminator (routing through rt.Panic — no value formatting,
// no backend-specific panic op, so it aborts loudly on every backend).  The
// checker marks the callee as the predeclared `panic`, so this needs its check.
func TestGenPanicCall() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker("package \"test\"\nfunc main() { panic(\"boom\") }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	var foundPanicCall bool = false
	var foundUnreachable bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, "pkg/builtins/rt.Panic") {
			foundPanicCall = true
		}
		if ins.Op == iropcode.OP_UNREACHABLE {
			foundUnreachable = true
		}
	}
	if !foundPanicCall {
		return fail("panic should lower to a call to pkg/builtins/rt.Panic")
	}
	if !foundUnreachable {
		return fail("panic should end in an OP_UNREACHABLE terminator")
	}
	return ""
}

// countOps counts fn's instructions with opcode op that name want (StrVal), or
// all of them when want is empty.
func countOps(fn @ir.Func, op int, want *[]readonly char) int {
	var n int = 0
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for i := 0; i < len(blk.Instrs); i++ {
			if blk.Instrs[i].Op == op && (len(want) == 0 || seq(blk.Instrs[i].StrVal, want)) { n++ }
		}
	}
	return n
}

// A call through a local or a parameter that shadows `panic` calls that binding:
// nothing is lowered to rt.Panic.
func TestGenPanicShadowedCall() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"func say(s *[]readonly char) { }\n"
					"func viaLocal() { panic := say\n panic(\"x\") }\n"
					"func viaParam(panic @func(*[]readonly char)) { panic(\"y\") }\n")
	var names @[]*[]readonly char = make_slice(*[]readonly char, 2)
	names[0] = "viaLocal"
	names[1] = "viaParam"
	for i := 0; i < len(names); i++ {
		var fn @ir.Func = findFunc(m, names[i])
		if fn == nil { return fail("missing function") }
		if countOps(fn, iropcode.OP_CALL, "pkg/builtins/rt.Panic") != 0 {
			return fail("a shadowing binding's call should not reach rt.Panic")
		}
		if countOps(fn, iropcode.OP_UNREACHABLE, "") != 0 {
			return fail("a shadowing binding's call should not end the block")
		}
	}
	return ""
}
