package "pkg/binate/irgen"

import "pkg/binate/irbuild"
import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// emitCanonicalRecord emits, into b, the load of the record of the dynamic type of
// a box whose vtable slot 1 holds the record `rec`, typed `typ`: rec's word
// TYPEINFO_CANONICAL_WORD -- rec itself, except for the record a box made from a
// raw pointer to an object of a declared named type carries (that type's
// raw-origin variant's, spec §11.12 `iface.assert.origin`), which names the type's
// own (spec §7.13.14 `type.layout.typeinfo`).  The word is read as a word of a
// pointer-indexed record, the way reflect's own fallback body reads slot 1.
func emitCanonicalRecord(b @ir.Block, rec @ir.Instr, typ @types.Type) @ir.Instr {
	var word @types.Type = types.MakePointerType(types.TypUint8())
	var idx @ir.Instr = irbuild.EmitConstInt(b, irdata.TYPEINFO_CANONICAL_WORD, types.TypInt())
	return irbuild.EmitLoad(b, irbuild.EmitGetElemPtr(b, rec, idx, word), typ)
}

// emitReflectTypeOf lowers `reflect.TypeOf(x)`, typed `resultTyp` (the declared
// `*reflect.TypeInfo`): nil for an unset interface value (a null vtable, which has
// no slot 1 to read), else the record of the dynamic type of x's box
// (emitCanonicalRecord).  The two results merge through a slot; IR-gen continues
// in the merge block.
func emitReflectTypeOf(ctx @GenContext, b @ir.Block, x @ir.Instr, resultTyp @types.Type) @ir.Instr {
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	var f @ir.Func = ctx.Func
	var slot @ir.Instr = irbuild.EmitAlloc(b, resultTyp)
	irbuild.EmitStore(b, slot, irbuild.EmitConstNil(b, resultTyp))
	var vtable @ir.Instr = irbuild.EmitExtract(b, x, types.IfaceValueVtableIndex(), rawPtr)
	var unset @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_EQ, vtable, irbuild.EmitConstNil(b, rawPtr),
			types.TypBool())
	var readBlk @ir.Block = ir.AddBlock(f, "typeof.read")
	var doneBlk @ir.Block = ir.AddBlock(f, "typeof.done")
	irbuild.EmitBranch(b, unset, doneBlk, readBlk)
	var rec @ir.Instr = irbuild.EmitIfaceTypeInfo(readBlk, x)
	irbuild.EmitStore(readBlk, slot, emitCanonicalRecord(readBlk, rec, resultTyp))
	irbuild.EmitJump(readBlk, doneBlk)
	ctx.CurBlock = doneBlk
	return irbuild.EmitLoad(doneBlk, slot, resultTyp)
}
