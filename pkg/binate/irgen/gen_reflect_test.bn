package "pkg/binate/irgen"

import "pkg/binate/irbuild"
import "pkg/binate/irdata"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The canonical record is the record's word TYPEINFO_CANONICAL_WORD, read as a
// pointer.
func TestEmitCanonicalRecord() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rec @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	var typ @types.Type = types.MakePointerType(types.TypInt())
	var got @ir.Instr = emitCanonicalRecord(b, rec, typ)
	if got.Op != iropcode.OP_LOAD || !same(got.Typ, typ) {
		return "the canonical record should be a load, typed as asked"
	}
	var at @ir.Instr = got.Args[0]
	if at.Op != iropcode.OP_GET_ELEM_PTR || !same(at.Args[0], rec) {
		return "the canonical record should be read from a word of the record"
	}
	var idx @ir.Instr = at.Args[1]
	if idx.Op != iropcode.OP_CONST_INT || idx.IntVal != cast(int64, irdata.TYPEINFO_CANONICAL_WORD) {
		return "the canonical record should be the record's canonical word"
	}
	if at.Typ.Kind != types.TYP_POINTER || at.Typ.Elem.Kind != types.TYP_POINTER {
		return "the record's words should be read as pointers"
	}
	return ""
}

// reflect.TypeOf branches on an unset interface value (a null vtable): the read
// block reads the record in vtable slot 1 and its canonical word; both paths merge
// through a slot, and IR-gen continues in the merge block.
func TestEmitReflectTypeOf() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var x @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	var resultTyp @types.Type = types.MakePointerType(types.TypInt())
	var got @ir.Instr = emitReflectTypeOf(ctx, b, x, resultTyp)
	if len(f.Blocks) != 3 || !same(ctx.CurBlock, f.Blocks[2]) {
		return "TypeOf should add a read and a merge block and continue in the merge block"
	}
	if got.Op != iropcode.OP_LOAD || !same(got.Typ, resultTyp) {
		return "TypeOf's result should be loaded in the merge block, typed as declared"
	}
	var read @ir.Block = f.Blocks[1]
	var sawRecord bool = false
	var sawCanonical bool = false
	for i := 0; i < len(read.Instrs); i++ {
		var ins @ir.Instr = read.Instrs[i]
		if ins.Op == iropcode.OP_IFACE_TYPEINFO && same(ins.Args[0], x) { sawRecord = true }
		if ins.Op == iropcode.OP_GET_ELEM_PTR && ins.Args[0].Op == iropcode.OP_IFACE_TYPEINFO {
			sawCanonical = true
		}
	}
	if !sawRecord || !sawCanonical {
		return "the read block should read the box's record and its canonical word"
	}
	return ""
}
