package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// RegisterImport processes an imported package's AST (from .bni or
// merged .bn) and registers its types, function signatures, and
// constants for cross-package resolution, and adds it to the module's import
// list.  path is its full import path — the identity every name it
// registers is qualified by; file is the parsed .bni/.bn AST.
//
// The sibling helper registerImportFieldsAndFuncs (in gen_import.bn)
// is the second-pass variant that runs against an already-registered
// set of struct names — used by the multi-file RegisterImports plural
// entry point.  registerImportConstGroup (also in gen_import.bn) is
// shared between both paths for iota-group constants.
func RegisterImport(path *[]readonly char, file @ast.File, gc @GenCtx) {
	requireChecker(gc.Mod.Checker)
	recordImportPath(gc.Mod, path)
	file = normalizeFileDecls(file)
	if file == nil || len(file.Decls) == 0 { return }
	// gc is the threaded per-compilation context; gc.PkgPath is empty here
	// (gc.Mod not yet GeneratePackage'd) — qualification uses the explicit
	// import path.

	// The struct names and generic types, the type aliases and named non-struct
	// types, and the structs' fields (gen_type_steps.bn); a generic struct is
	// stashed under the package's path, its instances registered where they are
	// used.
	registerStructNames(gc, file.Decls, path)
	stashGenericTypeDecls(gc, file, path)
	registerTypeDecls(gc, file.Decls, path)
	fillDeclaredStructFields(gc, file.Decls, path)

	// Register function and method signatures, and add extern funcs.
	// Generic decls (TypeParams non-empty) carry their body in the
	// imported .bni — register the AST under the package's path so
	// cross-package instantiation at the consumer's call site can
	// look it up via lookupGenericDeclPkg.  Generic bodies are carried
	// as source text in the .bni.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if len(d.TypeParams) > 0 {
			if d.Recv == nil && lookupGenericDeclPkg(gc, path, d.Name) == nil {
				// Methods can't have type parameters (spec §12.1
				// gen.no-generic-methods); the d.Recv == nil guard
				// keeps a method out of the generic-func registry.
				gc.GenericDecls = slices.Append[@ast.Decl](gc.GenericDecls, d)
				gc.GenericDeclPkgs = slices.Append[@[]char](
						gc.GenericDeclPkgs, buf.CopyStr(path))
			}
			continue
		}
		if isGenericReceiverMethod(d) {
			// Imported method on a generic type — no direct symbol; stash it
			// (keyed by the DEFINING package PATH, matching the instantiation's
			// InstDefPkg so ensureInstantiatedMethods finds it) so the consumer
			// emits it per instantiation at its use sites, just like a
			// same-package generic-receiver method (gen_module).
			if !privateToImport(gc, path, file, d) {
				stashGenericMethodDecl(gc, d, buf.CopyStr(path))
			}
			continue
		}
		var qualName @[]char
		var sigParams @[]@types.Type
		var extParams @[]@ir.Param
		if d.Recv != nil {
			qualName = methodQualName(gc, path, d)
			var rt @types.Type = resolveTypeExpr(gc, d.Recv.Type)
			sigParams = slices.Append[@types.Type](sigParams, rt)
			var rp @ir.Param = make(ir.Param)
			rp.Name = d.Recv.Name
			rp.Typ = rt
			extParams = slices.Append[@ir.Param](extParams, rp)
		} else {
			qualName = qualNameInPkg(path, d.Name)
		}
		for j := 0; j < len(d.Params); j++ {
			var pt @types.Type = irResolveParamType(gc, d.Params[j])
			sigParams = slices.Append[@types.Type](sigParams, pt)
			var p @ir.Param = make(ir.Param)
			p.Name = d.Params[j].Name
			p.Typ = pt
			extParams = slices.Append[@ir.Param](extParams, p)
		}

		var sigResults @[]@types.Type = declResultTypes(gc, d)
		ir.RegisterFuncSig(gc.Mod, funcSigOf(qualName, sigParams, declIsVariadic(d), sigResults))

		var ef @ir.Func = irbuild.NewExternFunc(gc.PkgPath, qualName, extParams, sigResults)
		gc.Mod.AddFunc(ef)
	}

	stashGenericIfaceDecls(gc, file, path)
	// Register constants
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			if d.Value != nil {
				var mc irsym.ModuleConst
				mc.Name = qualNameInPkg(path, d.Name)
				if d.TypeRef != nil {
					mc.Typ = resolveTypeExpr(gc, d.TypeRef)
				}
				if constFromInitializer(gc, &mc, d, d.Value, 0, false, true) {
					ir.RegisterModuleConst(gc.Mod, mc)
				}
			}
		}
		if d.Kind == ast.DECL_GROUP {
			registerImportConstGroup(gc, path, d)
		}
		// Register imported interfaces in the module's interface
		// registry under the package's path, so findInterfaceMethod /
		// findImplVtableName see the imported interface's method set.
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceFromDecl(gc, d, path)
		}
	}
}

// registerGenericBodyDepsFlat (RegisterGenericBodyDeps, over
// type-group-flattened files) registers function/method signatures + extern
// Funcs
// (deduped against already-registered sigs), consts and extern vars for the
// given packages, keyed by full path (`paths`).  For packages a monomorphized
// cross-package generic body may reach but that the consumer does not directly
// import: their
// structs/interfaces are already registered transitively (RegisterStructTypes /
// RegisterAllInterfaces), so the func externs — the `declare`s the body's
// calls need to link, the package's `__Package` accessor
// (registerPackageAccessor) among them — and the consts and vars its bare names
// read are missing.  Mirrors RegisterImport's func and const/var registration but omits
// structs/interfaces (already registered) and the import list.  With
// regExterns false the extern Funcs are left out (RegisterGenericBodyDepSigs).
func registerGenericBodyDepsFlat(paths @[]@[]char, files *[]@ast.File, gc @GenCtx,
		regExterns bool) {
	for k := 0; k < len(paths); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil { continue }
		registerPackageAccessor(gc, path, regExterns)
		if len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind != ast.DECL_FUNC { continue }
			// Generic decls have no direct symbol — they're instantiated
			// lazily at use sites; skip (a monomorphized body, not an extern).
			if len(d.TypeParams) > 0 { continue }
			if isGenericReceiverMethod(d) { continue }
			var qualName @[]char
			var sigParams @[]@types.Type
			var extParams @[]@ir.Param
			if d.Recv != nil {
				qualName = methodQualName(gc, path, d)
				var rt @types.Type = resolveTypeExpr(gc, d.Recv.Type)
				sigParams = slices.Append[@types.Type](sigParams, rt)
				var rp @ir.Param = make(ir.Param)
				rp.Name = d.Recv.Name
				rp.Typ = rt
				extParams = slices.Append[@ir.Param](extParams, rp)
			} else {
				qualName = qualNameInPkg(path, d.Name)
			}
			// Dedup: skip if this sig is already registered (a direct import,
			// or a previously-processed extern-dep package) — a second extern
			// Func would emit a duplicate `declare`.
			if funcSigRegistered(gc, qualName) { continue }
			for j := 0; j < len(d.Params); j++ {
				var pt @types.Type = irResolveParamType(gc, d.Params[j])
				sigParams = slices.Append[@types.Type](sigParams, pt)
				var p @ir.Param = make(ir.Param)
				p.Name = d.Params[j].Name
				p.Typ = pt
				extParams = slices.Append[@ir.Param](extParams, p)
			}
			var sigResults @[]@types.Type = declResultTypes(gc, d)
			ir.RegisterFuncSig(gc.Mod, funcSigOf(qualName, sigParams, declIsVariadic(d), sigResults))
			if regExterns {
				var ef @ir.Func = irbuild.NewExternFunc(gc.PkgPath, qualName, extParams, sigResults)
				gc.Mod.AddFunc(ef)
			}
		}
		registerImportConstsAndVars(gc, path, file)
	}
}

// registerGenericDeclsFlat (RegisterGenericDecls, over type-group-flattened
// files) stashes the generic FUNC / generic STRUCT / generic
// INTERFACE decls of the given packages into gc.Generic*Decls/Pkgs,
// keyed by full path (`paths`), deduped via the lookupGeneric*DeclPkg checks.
// RegisterImport only stashes generic decls for the consumer's DIRECT imports;
// a generic body that instantiates ANOTHER package's generic (e.g.
// genlib.Sum[T] -> mid.F[T], where mid is a transitive, not direct, import)
// needs mid's generic decl available to monomorphize mid.F[int].  Generic
// decls are in-memory only (no `.ll` emission — instantiations register lazily
// at use sites), so registering them across the whole transitive closure is
// cheap and safe.  Mirrors RegisterImport's stash blocks; registers ONLY
// generic things (non-generic structs/sigs/consts/ifaces are handled by
// RegisterStructTypes / RegisterImports / RegisterGenericBodyDeps).
func registerGenericDeclsFlat(paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	for k := 0; k < len(paths); k++ {
		var path @[]char = paths[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			// A parameterized impl of a transitively-loaded generic type: a
			// consumer can box that type's instantiation without importing its
			// package, and the instantiation's rows are minted from this stash.
			if !privateToImport(gc, path, file, d) { noteGenericImplDecl(gc, d, path) }
			if isGenericReceiverMethod(d) {
				// Generic-receiver method on a transitively-loaded generic type:
				// its type params live on the receiver, so decl-level TypeParams is
				// EMPTY and the `len==0 continue` below would drop it.  Stash it
				// (keyed by the defining path, matching InstDefPkg) so a consumer
				// that monomorphizes this type via a transitive-only import can
				// emit the method body (ensureInstantiatedMethods).  Deduped
				// downstream via EmittedInstantiations, so a both-direct-and-
				// transitive import stashing twice is a safe no-op.
				if !privateToImport(gc, path, file, d) {
					stashGenericMethodDecl(gc, d, buf.CopyStr(path))
				}
				continue
			}
			if len(d.TypeParams) == 0 { continue }
			// Generic type (mirror RegisterImport).
			if isGenericTypeDecl(d) {
				stashGenericTypeDecl(gc, d, path)
				continue
			}
			// Generic interface: DECL_INTERFACE + TypeParams.
			if d.Kind == ast.DECL_INTERFACE {
				stashGenericIfaceDecl(gc, d, path)
				continue
			}
			// Generic func (non-method — matching RegisterImport's d.Recv ==
			// nil guard).
			if d.Kind == ast.DECL_FUNC && d.Recv == nil {
				if lookupGenericDeclPkg(gc, path, d.Name) == nil {
					gc.GenericDecls = slices.Append[@ast.Decl](
							gc.GenericDecls, d)
					gc.GenericDeclPkgs = slices.Append[@[]char](
							gc.GenericDeclPkgs, buf.CopyStr(path))
				}
			}
		}
	}
}

// funcSigRegistered reports whether a func sig named qualName is already in
// gc.Mod.FuncSigs (so RegisterGenericBodyDeps doesn't emit a duplicate extern /
// `declare`).  Direct name match — qualName is already the full-path form.
func funcSigRegistered(gc @GenCtx, qualName *[]readonly char) bool {
	return ir.FuncSigIndexLookup(gc.Mod, qualName) >= 0
}
