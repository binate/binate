package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/irsym"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Undoing a REPL prompt entry's generation.  The REPL keeps an entry only once
// it loads (the VM's load check); one that does not is not kept, and the
// session's IR-gen state is put back as it was before the entry: nothing the
// entry generated is lowered, so nothing of it may stay recorded either — an
// instance of a generic, say, that a later definition of the generic would then
// reuse, or a type's registration that a later type of its name would take over.

// ReplEntry records the IR-gen state a prompt entry's generation may change
// (see the .bni).  The tables generation only appends to are recorded by length
// (the N fields); the lists it only ever replaces whole (each append or removal
// builds a new one) by their value when the entry began; flags and counters by
// value; and what it changes in place, as it changes it: the function signatures
// it registered again under a name that had one, with the signature each
// replaced, in order; the stashed generic functions and generic methods it
// redefined, by index, with the declaration and file each held; the interface
// registry entries it overwrote (IfaceIdx, IfaceOld); the named types whose
// underlying it set (UnderTypes, UnderOld: a forward-declared type its
// definition fills); the instance copies it named (CopyKeys,
// GenCtx.InstanceCopyNames); and the parameterized impls' records of the
// instances they minted rows for, and the pending interface aliases' completion
// flags, by copy.  The counters naming function literals and anonymous structs
// are put back too, so an entry generated again names them as before.
type ReplEntry struct {
	OldSigs         @[]irdata.FuncSig
	FuncStashIdx    @[]int
	FuncStashDecl   @[]@ast.Decl
	FuncStashFile   @[]@ast.File
	MethodStashIdx  @[]int
	MethodStashDecl @[]@ast.Decl
	MethodStashFile @[]@ast.File
	IfaceIdx        @[]int
	IfaceOld        @[]irsym.ModuleInterface
	UnderTypes      @[]@types.Type
	UnderOld        @[]@types.Type
	CopyKeys        @[]@ast.Decl
	FuncLits        int
	AnonStructs     int
	NFuncs          int
	NFuncSigs       int
	NGlobalRefs     int
	NGlobalVars     int
	NGlobals        int
	NConsts         int
	NStructs        int
	NTypeAliases    int
	NInterfaces     int
	NTypes          int
	NTypeInfos      int
	NImpls          int
	NImportedImpls  int
	NGenericDecls   int
	NGenericTypes   int
	NGenericIfaces  int
	NGenericMethods int
	NGenericImpls   int
	NIfaceAliases   int
	ImplMinted      @[]int
	IfaceAliasDone  @[]bool
	Emitted         @[]@[]char
	Wrappers        @[]@[]char
	PendingNamed    @[]@[]char
	PendingMs       @[]@types.Type
	PendingMsNames  @[]@[]char
	PendingSt       @[]@types.Type
	PendingStNames  @[]@[]char
	PendingMp       @[]@types.Type
	PendingMpNames  @[]@[]char
	NeedsFuncDtor   bool
	NeedsIfaceDtor  bool
	SatRegistry     bool
	ShadowStructs   int
	ShadowAliases   int
	ShadowsPredecl  bool
}

// BeginReplEntry starts recording a prompt entry's generation (see the .bni).
func BeginReplEntry(gc @GenCtx) @ReplEntry {
	var m @ir.Module = gc.Mod
	var e @ReplEntry = make(ReplEntry)
	e.NFuncs = len(m.Funcs)
	e.NFuncSigs = m.FuncSigs.Len()
	if m.GlobalRefs != nil {
		e.NGlobalRefs = m.GlobalRefs.Len()
	}
	e.NGlobalVars = len(m.GlobalVars)
	e.NGlobals = len(m.Globals)
	e.NConsts = len(m.Consts)
	e.NStructs = len(m.Structs)
	e.NTypeAliases = len(m.TypeAliases)
	e.NInterfaces = len(m.Interfaces)
	e.NTypes = len(m.Types)
	e.NTypeInfos = len(m.TypeInfos)
	e.NImpls = len(m.Impls)
	e.NImportedImpls = len(m.ImportedImpls)
	e.NGenericDecls = len(gc.GenericDecls)
	e.NGenericTypes = len(gc.GenericTypeDecls)
	e.NGenericIfaces = len(gc.GenericIfaceDecls)
	e.NGenericMethods = len(gc.GenericMethodDecls)
	e.NGenericImpls = len(gc.GenericImplDecls)
	e.NIfaceAliases = len(gc.PendingIfaceAliasDecls)
	e.ImplMinted = make_slice(int, len(gc.GenericImplMinted))
	for i := 0; i < len(gc.GenericImplMinted); i++ {
		e.ImplMinted[i] = len(gc.GenericImplMinted[i])
	}
	e.IfaceAliasDone = make_slice(bool, len(gc.PendingIfaceAliasDone))
	for i := 0; i < len(gc.PendingIfaceAliasDone); i++ {
		e.IfaceAliasDone[i] = gc.PendingIfaceAliasDone[i]
	}
	e.Emitted = gc.EmittedInstantiations
	e.Wrappers = m.MethodValueWrappers
	e.PendingNamed = gc.PendingNamedTypes
	e.PendingMs = m.PendingMsDtors
	e.PendingMsNames = m.PendingMsDtorNames
	e.PendingSt = m.PendingStructDtors
	e.PendingStNames = m.PendingStructDtorNames
	e.PendingMp = m.PendingMpDtors
	e.PendingMpNames = m.PendingMpDtorNames
	e.NeedsFuncDtor = m.NeedsFuncValueDtor
	e.NeedsIfaceDtor = m.NeedsIfaceValueDtor
	e.SatRegistry = m.SatRegistryRequested
	e.ShadowStructs = gc.ShadowScanStructs
	e.ShadowAliases = gc.ShadowScanAliases
	e.ShadowsPredecl = gc.ShadowsPredeclared
	e.FuncLits = gc.FuncLitCounter
	e.AnonStructs = gc.AnonStructCounter
	gc.ReplEntry = e
	return e
}

// EndReplEntry stops recording: the entry is kept (see the .bni).
func EndReplEntry(gc @GenCtx, e @ReplEntry) {
	if same(gc.ReplEntry, e) {
		gc.ReplEntry = nil
	}
}

// UndoReplEntry puts the session's IR-gen state back as it was before the entry
// (see the .bni).  What it changed in place is put back latest first, so a name
// replaced twice gets the one it had before the entry.
func UndoReplEntry(gc @GenCtx, e @ReplEntry) {
	EndReplEntry(gc, e)
	var m @ir.Module = gc.Mod
	for i := len(e.OldSigs) - 1; i >= 0; i-- {
		setOrAppendFuncSig(gc, e.OldSigs[i])
	}
	dropFuncSigs(m, e.NFuncSigs)
	for i := len(e.FuncStashIdx) - 1; i >= 0; i-- {
		gc.GenericDecls[e.FuncStashIdx[i]] = e.FuncStashDecl[i]
		gc.GenericDeclFiles[e.FuncStashIdx[i]] = e.FuncStashFile[i]
	}
	for i := len(e.MethodStashIdx) - 1; i >= 0; i-- {
		gc.GenericMethodDecls[e.MethodStashIdx[i]] = e.MethodStashDecl[i]
		gc.GenericMethodDeclFiles[e.MethodStashIdx[i]] = e.MethodStashFile[i]
	}
	for i := len(e.IfaceIdx) - 1; i >= 0; i-- {
		m.Interfaces[e.IfaceIdx[i]] = e.IfaceOld[i]
	}
	for i := len(e.UnderTypes) - 1; i >= 0; i-- {
		e.UnderTypes[i].Underlying = e.UnderOld[i]
	}
	for m.FuncsVec.Len() > e.NFuncs {
		_, _ = m.FuncsVec.Pop()
	}
	m.Funcs = m.FuncsVec.Items()
	for m.GlobalRefs != nil && m.GlobalRefs.Len() > e.NGlobalRefs {
		_, _ = m.GlobalRefs.Pop()
	}
	m.GlobalVars = m.GlobalVars[:e.NGlobalVars]
	m.Globals = m.Globals[:e.NGlobals]
	m.Consts = m.Consts[:e.NConsts]
	m.Structs = m.Structs[:e.NStructs]
	m.TypeAliases = m.TypeAliases[:e.NTypeAliases]
	m.Interfaces = m.Interfaces[:e.NInterfaces]
	m.Types = m.Types[:e.NTypes]
	m.TypeInfos = m.TypeInfos[:e.NTypeInfos]
	m.Impls = m.Impls[:e.NImpls]
	m.ImportedImpls = m.ImportedImpls[:e.NImportedImpls]
	undoReplGenerics(gc, e)
	gc.EmittedInstantiations = e.Emitted
	m.MethodValueWrappers = e.Wrappers
	gc.PendingNamedTypes = e.PendingNamed
	m.PendingMsDtors = e.PendingMs
	m.PendingMsDtorNames = e.PendingMsNames
	m.PendingStructDtors = e.PendingSt
	m.PendingStructDtorNames = e.PendingStNames
	m.PendingMpDtors = e.PendingMp
	m.PendingMpDtorNames = e.PendingMpNames
	m.NeedsFuncValueDtor = e.NeedsFuncDtor
	m.NeedsIfaceValueDtor = e.NeedsIfaceDtor
	m.SatRegistryRequested = e.SatRegistry
	gc.ShadowScanStructs = e.ShadowStructs
	gc.ShadowScanAliases = e.ShadowAliases
	gc.ShadowsPredeclared = e.ShadowsPredecl
	gc.FuncLitCounter = e.FuncLits
	gc.AnonStructCounter = e.AnonStructs
	for i := 0; i < len(e.CopyKeys); i++ {
		_ = gc.InstanceCopyNames.Remove(e.CopyKeys[i])
	}
}

// undoReplGenerics drops the generic declarations, parameterized impls and
// pending interface aliases the entry stashed, and the rows it recorded the
// parameterized impls minting (ensureGenericImplRows), and gives the aliases it
// completed their completion flags back (UndoReplEntry).
func undoReplGenerics(gc @GenCtx, e @ReplEntry) {
	gc.GenericDecls = gc.GenericDecls[:e.NGenericDecls]
	gc.GenericDeclPkgs = gc.GenericDeclPkgs[:e.NGenericDecls]
	gc.GenericDeclFiles = gc.GenericDeclFiles[:e.NGenericDecls]
	gc.GenericTypeDecls = gc.GenericTypeDecls[:e.NGenericTypes]
	gc.GenericTypeDeclPkgs = gc.GenericTypeDeclPkgs[:e.NGenericTypes]
	gc.GenericTypeDeclFiles = gc.GenericTypeDeclFiles[:e.NGenericTypes]
	gc.GenericIfaceDecls = gc.GenericIfaceDecls[:e.NGenericIfaces]
	gc.GenericIfaceDeclPkgs = gc.GenericIfaceDeclPkgs[:e.NGenericIfaces]
	gc.GenericIfaceDeclFiles = gc.GenericIfaceDeclFiles[:e.NGenericIfaces]
	gc.GenericMethodDecls = gc.GenericMethodDecls[:e.NGenericMethods]
	gc.GenericMethodDeclPkgs = gc.GenericMethodDeclPkgs[:e.NGenericMethods]
	gc.GenericMethodDeclFiles = gc.GenericMethodDeclFiles[:e.NGenericMethods]
	for i := 0; i < len(e.ImplMinted); i++ {
		gc.GenericImplMinted[i] = gc.GenericImplMinted[i][:e.ImplMinted[i]]
	}
	gc.GenericImplDecls = gc.GenericImplDecls[:e.NGenericImpls]
	gc.GenericImplDeclPkgs = gc.GenericImplDeclPkgs[:e.NGenericImpls]
	gc.GenericImplDeclFiles = gc.GenericImplDeclFiles[:e.NGenericImpls]
	gc.GenericImplMinted = gc.GenericImplMinted[:e.NGenericImpls]
	gc.PendingIfaceAliasDecls = gc.PendingIfaceAliasDecls[:e.NIfaceAliases]
	gc.PendingIfaceAliasPkgs = gc.PendingIfaceAliasPkgs[:e.NIfaceAliases]
	gc.PendingIfaceAliasFiles = gc.PendingIfaceAliasFiles[:e.NIfaceAliases]
	var done @[]bool = make_slice(bool, e.NIfaceAliases)
	for i := 0; i < e.NIfaceAliases; i++ {
		done[i] = e.IfaceAliasDone[i]
	}
	gc.PendingIfaceAliasDone = done
}

// dropFuncSigs drops the function signatures registered after the first n,
// unindexing each first (the index's key borrows the signature's name).
func dropFuncSigs(m @ir.Module, n int) {
	for m.FuncSigs.Len() > n {
		var last int = m.FuncSigs.Len() - 1
		var name @[]char = m.FuncSigs.Get(last).Name
		if ir.FuncSigIndexLookup(m, name) == last {
			_ = m.FuncSigIndex.Remove(name)
		}
		_, _ = m.FuncSigs.Pop()
	}
}

// noteReplacedSig records, while an entry is recorded, the signature old that a
// generation is about to replace under its name.
func noteReplacedSig(gc @GenCtx, old irdata.FuncSig) {
	if gc.ReplEntry == nil { return }
	gc.ReplEntry.OldSigs = slices.Append[irdata.FuncSig](gc.ReplEntry.OldSigs, old)
}

// noteReplacedGenericFunc records, while an entry is recorded, the stashed generic
// function at index i that a redefinition is about to replace.
func noteReplacedGenericFunc(gc @GenCtx, i int) {
	if gc.ReplEntry == nil { return }
	var e @ReplEntry = gc.ReplEntry
	e.FuncStashIdx = slices.Append[int](e.FuncStashIdx, i)
	e.FuncStashDecl = slices.Append[@ast.Decl](e.FuncStashDecl, gc.GenericDecls[i])
	e.FuncStashFile = slices.Append[@ast.File](e.FuncStashFile, gc.GenericDeclFiles[i])
}

// noteReplacedGenericMethod is noteReplacedGenericFunc for a stashed generic
// method.
func noteReplacedGenericMethod(gc @GenCtx, i int) {
	if gc.ReplEntry == nil { return }
	var e @ReplEntry = gc.ReplEntry
	e.MethodStashIdx = slices.Append[int](e.MethodStashIdx, i)
	e.MethodStashDecl = slices.Append[@ast.Decl](e.MethodStashDecl, gc.GenericMethodDecls[i])
	e.MethodStashFile = slices.Append[@ast.File](e.MethodStashFile, gc.GenericMethodDeclFiles[i])
}

// noteReplacedIface records, while an entry is recorded, the interface registry
// entry at index i that a generation is about to overwrite, when the entry did
// not add it.
func noteReplacedIface(gc @GenCtx, i int) {
	var e @ReplEntry = gc.ReplEntry
	if e == nil || i >= e.NInterfaces { return }
	e.IfaceIdx = slices.Append[int](e.IfaceIdx, i)
	e.IfaceOld = slices.Append[irsym.ModuleInterface](e.IfaceOld, gc.Mod.Interfaces[i])
}

// noteInstanceCopy records, while an entry is recorded, the instance copy key
// whose name a generation is about to memoize (matchInstanceCopy): the checker
// drops the copy when it undoes the entry, so the memo must not keep it.
func noteInstanceCopy(gc @GenCtx, key @ast.Decl) {
	var e @ReplEntry = gc.ReplEntry
	if e == nil { return }
	e.CopyKeys = slices.Append[@ast.Decl](e.CopyKeys, key)
}

// noteUnderlying records, while an entry is recorded, the underlying of the named
// type t that a generation is about to set.
func noteUnderlying(gc @GenCtx, t @types.Type) {
	var e @ReplEntry = gc.ReplEntry
	if e == nil { return }
	e.UnderTypes = slices.Append[@types.Type](e.UnderTypes, t)
	e.UnderOld = slices.Append[@types.Type](e.UnderOld, t.Underlying)
}
