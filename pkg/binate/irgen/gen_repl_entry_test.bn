package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for BeginReplEntry / EndReplEntry / UndoReplEntry (gen_repl_entry.bn).
// genFromSourcePkgGc, strToBytes, seq and fail are gen_test_support_test.bn's.

// replDecl parses one declaration as typed at the prompt.
func replDecl(src *[]readonly char) @ast.Decl {
	var p @parser.Parser = parser.New(strToBytes(src), "<repl>")
	return mustParseDecl(p)
}

// sigParamCount returns the number of parameters of the signature registered
// under qname, or -1 when none is.
func sigParamCount(m @ir.Module, qname *[]readonly char) int {
	var idx int = ir.FuncSigIndexLookup(m, qname)
	if idx < 0 { return -1 }
	return len(m.FuncSigs.Get(idx).Params)
}

// An undone entry puts back the signature a redefinition replaced and drops the
// global a variable declaration added; a kept one keeps what it generated.
func TestUndoReplEntryRestoresSigAndGlobals() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\nfunc helper() int { return 1 }\nfunc main() {}\n")
	var m @ir.Module = gc.Mod
	var globals int = len(m.Globals)
	var e @ReplEntry = BeginReplEntry(gc)
	if len(GenDecl(replDecl("func helper(a int) int { return a }"), gc)) > 0 ||
			len(GenDecl(replDecl("var v int = 3"), gc)) > 0 {
		return fail("GenDecl failed")
	}
	if sigParamCount(m, "test.helper") != 1 || len(m.Globals) != globals + 1 {
		return fail("GenDecl should register helper's new signature and v's global")
	}
	UndoReplEntry(gc, e)
	if sigParamCount(m, "test.helper") != 0 || len(m.Globals) != globals || gc.ReplEntry != nil {
		return fail("UndoReplEntry should put helper's signature back and drop v's global")
	}
	e = BeginReplEntry(gc)
	_ = GenDecl(replDecl("func helper(a int) int { return a }"), gc)
	EndReplEntry(gc, e)
	if sigParamCount(m, "test.helper") != 1 || gc.ReplEntry != nil {
		return fail("a kept entry keeps helper's new signature")
	}
	return ""
}

// An undone entry puts back the stashed declaration of a generic function it
// redefined, and drops one it declared.
func TestUndoReplEntryRestoresGenericStash() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nfunc main() {}\n")
	var g1 @ast.Decl = replDecl("func G[T any](x T) T { return x }")
	_ = GenDecl(g1, gc)
	var e @ReplEntry = BeginReplEntry(gc)
	_ = GenDecl(replDecl("func G[T any](x T) T { var y T = x; return y }"), gc)
	_ = GenDecl(replDecl("func H[T any](x T) T { return x }"), gc)
	if same(ReplGenericFunc(gc, "G"), g1) || ReplGenericFunc(gc, "H") == nil {
		return fail("GenDecl should stash the new G and H")
	}
	UndoReplEntry(gc, e)
	if !same(ReplGenericFunc(gc, "G"), g1) || ReplGenericFunc(gc, "H") != nil {
		return fail("UndoReplEntry should put G's declaration back and drop H")
	}
	return ""
}

// An undone entry drops the functions it generated and the signatures it
// registered for new names, and forgets the instances and method-value wrappers
// it recorded as generated — only those.
func TestUndoReplEntryForgets() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nfunc main() {}\n")
	var m @ir.Module = gc.Mod
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, "test.I1")
	m.MethodValueWrappers = slices.Append[@[]char](m.MethodValueWrappers, "test.W1")
	var funcs int = len(m.Funcs)
	var e @ReplEntry = BeginReplEntry(gc)
	gc.EmittedInstantiations = slices.Append[@[]char](gc.EmittedInstantiations, "test.I2")
	m.MethodValueWrappers = slices.Append[@[]char](m.MethodValueWrappers, "test.W2")
	if len(GenDecl(replDecl("func extra(a int) int { return a }"), gc)) > 0 {
		return fail("GenDecl failed")
	}
	if len(m.Funcs) != funcs + 1 || sigParamCount(m, "test.extra") != 1 {
		return fail("GenDecl should generate extra and register its signature")
	}
	UndoReplEntry(gc, e)
	if len(gc.EmittedInstantiations) != 1 || !seq(gc.EmittedInstantiations[0], "test.I1") ||
			len(m.MethodValueWrappers) != 1 || !seq(m.MethodValueWrappers[0], "test.W1") {
		return fail("UndoReplEntry should forget test.I2 and test.W2 only")
	}
	if len(m.Funcs) != funcs || sigParamCount(m, "test.extra") != -1 {
		return fail("UndoReplEntry should drop extra and its signature")
	}
	return ""
}

// typeDecls parses declarations typed at the prompt, one per element of srcs.
func typeDecls(srcs *[]*[]readonly char) @[]@ast.Decl {
	var ds @[]@ast.Decl = make_slice(@ast.Decl, len(srcs))
	for i := 0; i < len(srcs); i++ { ds[i] = replDecl(srcs[i]) }
	return ds
}

// An undone entry drops the types it registered, with their helpers, and
// unfills a forward-declared type it defined: a later entry declaring a type of
// the name, with another layout, registers it afresh, helpers and all.
func TestUndoReplEntryDropsTypes() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nfunc main() {}\n")
	var m @ir.Module = gc.Mod
	if len(GenTypeDecls(typeDecls(@[]*[]readonly char{"type F"}), gc)) > 0 {
		return fail("GenTypeDecls failed on F")
	}
	var fwd @types.Type = unfilledForward(gc, replDecl("type F struct { n int }"))
	if fwd == nil { return fail("F should be an unfilled forward type") }
	var structs int = len(m.Structs)
	var funcs int = len(m.Funcs)
	var e @ReplEntry = BeginReplEntry(gc)
	if len(
			GenTypeDecls(
					typeDecls(@[]*[]readonly char{"type F struct { s @[]char }", "type T4 struct { a @[]int }"}),
					gc)) > 0 {
		return fail("GenTypeDecls failed")
	}
	if lookupStructIdx(gc, "T4") < 0 || fwd.Underlying == nil || len(m.Funcs) == funcs {
		return fail("GenTypeDecls should register T4, fill F and generate their helpers")
	}
	UndoReplEntry(gc, e)
	if lookupStructIdx(gc, "T4") >= 0 || lookupStructIdx(gc, "F") >= 0 || fwd.Underlying != nil ||
			len(m.Structs) != structs || len(m.Funcs) != funcs {
		return fail("UndoReplEntry should drop T4, F's struct and their helpers, and unfill F")
	}
	if len(GenTypeDecls(typeDecls(@[]*[]readonly char{"type T4 struct { b int; c @[]char }"}), gc)) >
			0 {
		return fail("GenTypeDecls failed on the new T4")
	}
	var ti int = lookupStructIdx(gc, "T4")
	if ti < 0 || len(m.Structs[ti].Typ.Fields) != 2 || !seq(m.Structs[ti].Typ.Fields[1].Name, "c") {
		return fail("the new T4 should be registered with its own fields")
	}
	var sawDtor bool = false
	for i := funcs; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.__dtor_2T4") { sawDtor = true }
	}
	if !sawDtor { return fail("the new T4 should get its own destructor") }
	return ""
}

// An undone entry gives back a pending interface alias it completed — its
// registry entry, a stub again, and its completion flag — and drops the
// instantiation the completion registered.
func TestUndoReplEntryRestoresIfaceAlias() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\ninterface G[T any] { Get() T }\nfunc main() {}\n")
	var m @ir.Module = gc.Mod
	var noFile @ast.File
	registerIfaceStub(gc, replDecl("interface X = G[int]"), gc.PkgPath, noFile)
	var xi int = ir.LookupModuleInterfaceIndex(m, gc.PkgPath, "X")
	var last int = len(gc.PendingIfaceAliasDone) - 1
	if xi < 0 || !m.Interfaces[xi].IsStub || last < 0 || gc.PendingIfaceAliasDone[last] {
		return fail("X should be a pending alias stub")
	}
	var ifaces int = len(m.Interfaces)
	var e @ReplEntry = BeginReplEntry(gc)
	completeIfaceAliasStub(gc, gc.PkgPath, "X")
	if !gc.PendingIfaceAliasDone[last] || m.Interfaces[xi].IsStub || len(m.Interfaces) == ifaces {
		return fail("completing X should mark it done, fill its entry and instantiate G[int]")
	}
	UndoReplEntry(gc, e)
	if gc.PendingIfaceAliasDone[last] || !m.Interfaces[xi].IsStub || len(m.Interfaces) != ifaces {
		return fail("UndoReplEntry should give X its stub and flag back, and drop G[int]")
	}
	return ""
}
