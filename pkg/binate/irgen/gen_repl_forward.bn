package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Forward-declared types at the REPL prompt (`type T`, defined later): T is an
// opaque named type until its definition fills it (GenTypeDecls).

// registerReplForwardType registers the forward declaration d (`type T`) as an
// opaque named type, unless T is already known: what refers to T before it is
// defined refers to this type, which T's definition fills (GenTypeDecls,
// genReplTypeDecl), and releases an `@T` through `__dtor_T` by name, as code
// importing an opaque type does.  Until T is defined `__dtor_T` is an empty
// placeholder — no T value can exist yet, so only a nil `@T` is ever dropped,
// but its destructor handle must resolve — and T's definition replaces it
// (ensureReplNamedDtor).
func registerReplForwardType(gc @GenCtx, d @ast.Decl) {
	if lookupStructIdx(gc, d.Name) >= 0 || lookupTypeAlias(gc, d.Name) != nil { return }
	var ta irsym.ModuleTypeAlias
	ta.Name = qualifyForCurrentModule(gc, d.Name)
	var ot @types.Type = types.MakeNamedType(ta.Name)
	ot.OpaqueExportPkg = buf.CopyStr(gc.PkgPath)
	ta.Typ = ot
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
	var undefined @types.Type
	gc.Mod.AddFunc(genNamedDtorWithName(gc.Mod.PkgPath, replForwardDtorName(ta.Name), undefined))
}

// replForwardDtorName returns the unqualified name of the destructor code that
// cannot see the forward-declared type typeName's definition releases it with.
func replForwardDtorName(typeName *[]readonly char) @[]char {
	return irutil.DtorName(irutil.DotSuffix(typeName))
}

// unfilledForward returns the opaque named type a forward declaration of d's
// name registered, if d (a type declaration) defines it now, or nil.
func unfilledForward(gc @GenCtx, d @ast.Decl) @types.Type {
	var t @types.Type = lookupTypeAlias(gc, d.Name)
	if t == nil || !isUnfilledOpaque(t) { return nil }
	return t
}

// fillReplForward defines the forward-declared type fwd, which earlier code
// holds, as the struct def of its struct definition, and generates its
// destructor.  A non-struct definition fills fwd through registerTypeDeclEntry
// instead (fwd is pending).
func fillReplForward(gc @GenCtx, d @ast.Decl, fwd @types.Type, def @types.Type) {
	fwd.Underlying = def
	ensureReplNamedDtor(gc.Mod, qualifyForCurrentModule(gc, d.Name), def)
}

// ensureReplNamedDtor generates the destructor of the forward-declared type
// typeName, now defined as def — a struct's dtor for a struct, else the
// destructor of a named type over def, with the helpers it calls — replacing
// the placeholder registerReplForwardType generated (lowered under the same
// name, it takes the placeholder's place).
func ensureReplNamedDtor(m @ir.Module, typeName *[]readonly char, def @types.Type) {
	var dname @[]char = replForwardDtorName(typeName)
	if def.Kind == types.TYP_STRUCT {
		m.AddFunc(genStructDtorWithName(m.PkgPath, dname, def))
		return
	}
	m.AddFunc(genNamedDtorWithName(m.PkgPath, dname, def))
	ensureValueDtorHelpers(m, types.StripWrappers(def), collectExistingHelperNames(m))
}
