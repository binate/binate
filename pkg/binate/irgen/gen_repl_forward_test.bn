package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_repl_forward.bn: forward-declared types at the REPL prompt.

// genReplDecl parses the declaration src and lowers it into m as the prompt
// would, returning GenDecl's refusal message.
func genReplDecl(m @ir.Module, src *[]readonly char) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	return GenDecl(d, NewGenCtx(m))
}

// helperCount returns how many of m's functions are the helper named name
// (unqualified).
func helperCount(m @ir.Module, name *[]readonly char) int {
	var names @[]@[]char = collectExistingHelperNames(m)
	var n int = 0
	for i := 0; i < len(names); i++ {
		if charsEqual(names[i], name) { n = n + 1 }
	}
	return n
}

// A forward declaration registers an opaque named type that a type declared
// before the definition refers to, and a placeholder `__dtor_F`; a struct
// literal definition fills it in place and generates the real `__dtor_F` even
// with no managed field.
func TestGenDeclForwardTypeFilledByStruct() testing.TestResult {
	var m @ir.Module = genFromSource("package \"test\"\nfunc main() {}\n")
	if len(genReplDecl(m, "type F")) > 0 { return fail("forward declaration refused") }
	var f @types.Type = lookupTypeAlias(NewGenCtx(m), "F")
	if f == nil || f.Kind != types.TYP_NAMED || len(f.OpaqueExportPkg) == 0 || f.Underlying != nil {
		return fail("F must be an undefined opaque named type")
	}
	if helperCount(m, "__dtor_1F") != 1 { return fail("F's placeholder dtor must be generated") }
	if len(genReplDecl(m, "type P @@F")) > 0 { return fail("P refused") }
	if len(genReplDecl(m, "type F struct { n int }")) > 0 { return fail("F's definition refused") }
	if f.Underlying == nil || f.Underlying.Kind != types.TYP_STRUCT {
		return fail("the definition must fill F in place")
	}
	var p @types.Type = lookupTypeAlias(NewGenCtx(m), "P")
	if p == nil || p.Underlying.Elem.Elem.Underlying == nil {
		return fail("P must see F's definition")
	}
	if helperCount(m, "__dtor_1F") != 2 { return fail("F's dtor must be generated") }
	return ""
}

// A definition as another type fills the forward-declared type with it, and
// generates its dtor.
func TestGenDeclForwardTypeFilledByNonStruct() testing.TestResult {
	var m @ir.Module = genFromSource("package \"test\"\nfunc main() {}\n")
	genReplDecl(m, "type G")
	if len(genReplDecl(m, "type G @[]char")) > 0 { return fail("G's definition refused") }
	var g @types.Type = lookupTypeAlias(NewGenCtx(m), "G")
	if g == nil || g.Underlying == nil || g.Underlying.Kind != types.TYP_MANAGED_SLICE {
		return fail("G must be filled with its managed-slice definition")
	}
	if helperCount(m, "__dtor_1G") != 2 { return fail("G's dtor must be generated") }
	return ""
}

// A func-value definition fills the forward-declared type like any other: it
// stays the named type, over the func value.
func TestGenDeclForwardTypeDefinedAsFuncValue() testing.TestResult {
	var m @ir.Module = genFromSource("package \"test\"\nfunc main() {}\n")
	genReplDecl(m, "type FV")
	var fv @types.Type = lookupTypeAlias(NewGenCtx(m), "FV")
	if len(genReplDecl(m, "type FV @func(int) int")) > 0 { return fail("FV's definition refused") }
	if fv.Kind != types.TYP_NAMED || fv.Underlying == nil ||
			fv.Underlying.Kind != types.TYP_MANAGED_FUNC_VALUE {
		return fail("FV must be the named type over the func value")
	}
	if helperCount(m, "__dtor_2FV") != 2 { return fail("FV's dtor must be generated") }
	return ""
}
