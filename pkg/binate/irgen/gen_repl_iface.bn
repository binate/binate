package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// REPL interface and `impl` declarations: registered in the session module as
// the file-load passes register a package's (collectInterfaceFromDecl,
// collectImplsFromDecl).  The REPL builds an impl's VM vtable before the next
// prompt code runs.

// genReplInterfaceDecl registers an interface typed at the prompt: a generic
// one is stashed for instantiation at its uses.
func genReplInterfaceDecl(gc @GenCtx, d @ast.Decl) {
	var noFile @ast.File
	if len(d.TypeParams) > 0 {
		stashGenericIfaceDecl(gc, d, gc.PkgPath, noFile)
		return
	}
	collectInterfaceFromDecl(gc, d, gc.PkgPath, noFile)
}

// genReplImplDecl registers an `impl` typed at the prompt: a row per
// (receiver, interface) pair and ancestor.  The destructor its boxes run from
// slot 0 is queued now when it is a structural helper (irbuild.RegisterModulePendingDtor):
// file-load IR-gen emits it where a value is boxed, but a REPL vtable may be
// built — its slot 0 resolved — before any prompt code boxes a value.  A
// parameterized-receiver impl (`impl *Box[T] : I`) is not supported: its methods
// are generic-receiver methods, which the prompt does not support.
func genReplImplDecl(gc @GenCtx, d @ast.Decl) @[]char {
	if receiverGenericInstBase(d.TypeRef) != nil {
		return "impl declarations on a generic type are not supported at the prompt"
	}
	var m @ir.Module = gc.Mod
	collectImplsFromDecl(gc, d, gc.PkgPath, m)
	var recvTyp @types.Type = recvBaseValueType(gc, d.TypeRef)
	if recvTyp != nil {
		irbuild.RegisterModulePendingDtor(m, recvTyp)
	}
	return ""
}

// GenReplRecvThunk returns the interface-dispatch thunk of method f typed at
// the prompt, or nil when f needs none (needsRecvThunk): an interface value
// holds its data by pointer, so a value-receiver method is dispatched through
// a thunk that takes the pointer and calls f with the value.  File-load IR-gen
// emits every thunk after the package's bodies (generateIvDispatchThunks); the
// REPL emits one with each method, from its latest definition.  The caller
// adds it to the module and lowers it after f.
func GenReplRecvThunk(m @ir.Module, f @ir.Func) @ir.Func {
	if !needsRecvThunk(f) {
		var none @ir.Func
		return none
	}
	return genIvRecvThunk(m, ir.ThunkNameForMethod(f.Name), f)
}
