package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_repl_iface.bn — interface and `impl` declarations typed at
// the prompt, through GenDecl.

// replDeclOf parses one top-level declaration typed at the prompt.
func replDeclOf(src *[]readonly char) @ast.Decl {
	var p @parser.Parser = parser.New(strToBytes(src), "<repl>")
	return p.ParseTopLevelDecl()
}

// An interface typed at the prompt is registered in the session module.
func TestGenDeclInterface() testing.TestResult {
	var m @ir.Module = genFromSource("package \"test\"\nfunc main() {}\n")
	var msg @[]char = GenDecl(replDeclOf("interface Sizer { Size() int }"), NewGenCtx(m))
	if len(msg) > 0 { return fail(msg) }
	for i := 0; i < len(m.Interfaces); i++ {
		if seq(m.Interfaces[i].Name, "Sizer") { return "" }
	}
	return fail("Sizer must be registered in m.Interfaces")
}

// An impl typed at the prompt adds its (receiver, interface) row, and queues
// the structural destructor a box of its receiver runs from slot 0 (a named
// managed slice here).
func TestGenDeclImplQueuesBoxDtor() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ninterface Sizer { Size() int }\ntype MS @[]int\n"
			"func (m MS) Size() int { return len(m) }\nfunc main() {}\n"
	var m @ir.Module = genFromSource(src)
	var rows int = len(m.Impls)
	var msg @[]char = GenDecl(replDeclOf("impl MS : Sizer"), NewGenCtx(m))
	if len(msg) > 0 { return fail(msg) }
	if len(m.Impls) != rows + 1 {
		return fail("the impl must add one row")
	}
	if len(m.PendingMsDtors) == 0 {
		return fail("the managed-slice destructor for slot 0 must be queued")
	}
	return ""
}

// An impl on a generic type is refused at the prompt.
func TestGenDeclGenericReceiverImplRefused() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ninterface Getter { Get() int }\n"
			"type Cur[T any] struct { v T }\nfunc main() {}\n"
	var m @ir.Module = genFromSource(src)
	var rows int = len(m.Impls)
	var msg @[]char = GenDecl(replDeclOf("impl *Cur[T] : Getter"), NewGenCtx(m))
	if len(msg) == 0 {
		return fail("an impl on a generic type must be refused")
	}
	if len(m.Impls) != rows {
		return fail("a refused impl must add no row")
	}
	return ""
}

// For every receiver kind whose box needs a destructor, one is emitted under
// the name the impl's row gives slot 0 (boxSlot0DtorName): the structural
// helper GenDecl queues (a managed slice, an array), or the pointee struct's
// (a named managed pointer is boxed as the pointer itself).
func TestGenDeclImplBoxDtorEveryKind() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ninterface Sizer { Size() int }\n"
			"type Inner struct { p @[]int }\ntype MS @[]@Inner\ntype MP @Inner\ntype AR [2]@Inner\n"
			"func (m MS) Size() int { return 1 }\nfunc (m MP) Size() int { return 2 }\n"
			"func (a AR) Size() int { return 3 }\nfunc main() {}\n"
	var m @ir.Module = genFromSource(src)
	var gc @GenCtx = NewGenCtx(m)
	var rows int = len(m.Impls)
	var impls @[]@[]char = make_slice(@[]char, 3)
	impls[0] = "impl MS : Sizer"
	impls[1] = "impl MP : Sizer"
	impls[2] = "impl AR : Sizer"
	for i := 0; i < len(impls); i++ {
		var msg @[]char = GenDecl(replDeclOf(impls[i]), gc)
		if len(msg) > 0 { return fail(msg) }
	}
	EnsureReplBodyHelpers(m)
	if len(m.Impls) != rows + 3 {
		return fail("each impl must add one row")
	}
	for i := rows; i < len(m.Impls); i++ {
		var dtor @[]char = m.Impls[i].DtorFuncName
		if len(dtor) == 0 {
			return fail(buf.Concat("no slot-0 destructor named for ", m.Impls[i].RecvTypeName))
		}
		var found bool = false
		for j := 0; j < len(m.Funcs); j++ {
			if seq(m.Funcs[j].Name, dtor) { found = true }
		}
		if !found {
			return fail(buf.Concat("slot-0 destructor not emitted: ", dtor))
		}
	}
	return ""
}

// A value-receiver method typed at the prompt gets an interface-dispatch
// thunk; a pointer-receiver one does not.
func TestGenReplRecvThunk() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype N int\nfunc (n N) Get() int { return 1 }\n"
			"type P struct { v int }\nfunc (p *P) Get() int { return p.v }\nfunc main() {}\n"
	var m @ir.Module = genFromSource(src)
	var val @ir.Func
	var ptr @ir.Func
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.N.Get") { val = m.Funcs[i] }
		if seq(m.Funcs[i].Name, "test.P.Get") { ptr = m.Funcs[i] }
	}
	if val == nil || ptr == nil {
		return fail("setup: the methods must be generated")
	}
	var th @ir.Func = GenReplRecvThunk(m, val)
	if th == nil || !seq(th.Name, ir.ThunkNameForMethod(val.Name)) {
		return fail("a value-receiver method must get its thunk")
	}
	if GenReplRecvThunk(m, ptr) != nil {
		return fail("a pointer-receiver method needs no thunk")
	}
	return ""
}
