package "pkg/binate/irgen"

import "pkg/binate/check"
import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Re-emission of the instances a generic function, or a method of a generic
// type, already has when a declaration typed at the REPL prompt redefines it.

// ReemitGeneric emits again, from generic function or generic-receiver method
// d, every instance already emitted of the declaration d redefines (see
// irgen.bni).
func ReemitGeneric(gc @GenCtx, d @ast.Decl) @[]@ir.Func {
	if isGenericFunc(d) {
		return reemitGenericFunc(gc, d)
	}
	return reemitGenericMethod(gc, d)
}

// reemitGenericFunc emits again, from generic function d, every instance
// already emitted of the function d redefines — those the checker checked d
// for (it checks a redefinition for each instance of the definition it
// replaces).  Every instance's new signature is registered before any of their
// bodies is generated (as reemitGenericMethod does).
func reemitGenericFunc(gc @GenCtx, d @ast.Decl) @[]@ir.Func {
	var names @[]@[]char
	var redo @[]@[]@types.Type
	var none @[]char // a generic declared at the prompt is the module's own
	if gc.Mod.Checker != nil {
		var bodies @[]@check.InstanceBody = gc.Mod.Checker.InstanceBodies(d)
		for i := 0; i < len(bodies); i++ {
			var name @[]char = instanceCopyName(gc, bodies[i], d, none)
			if len(name) > 0 && forgetEmittedInstantiation(gc, name) {
				var args @[]@types.Type
				args, _ = irTypesFromChecker(gc, bodies[i].Args)
				args, _ = canonicalTypeArgs(gc, args)
				names = slices.Append[@[]char](names, name)
				redo = slices.Append[@[]@types.Type](redo, args)
			}
		}
	}
	for i := 0; i < len(redo); i++ {
		registerInstFuncSig(gc, d, redo[i], none, names[i])
	}
	var from int = len(gc.Mod.Funcs)
	for i := 0; i < len(redo); i++ {
		_ = ensureInstantiated(gc, d, redo[i], none)
	}
	return reemittedFuncs(gc, names, from)
}

// reemitGenericMethod emits again, from generic-receiver method d, every
// instance already emitted of the method d redefines.  Every
// instance's new signature is registered before any of their bodies is
// generated, so a body calling another instance of the method calls it with its
// new shape; an instance a body calls is emitted nested, at the call, and
// instances first emitted that way are new functions, not ones re-emitted.
func reemitGenericMethod(gc @GenCtx, d @ast.Decl) @[]@ir.Func {
	var recvName @[]char = genericMethodRecvName(d)
	var redo @[]int // indices in gc.Mod.Structs of the instances emitted before d
	for si := 0; si < len(gc.Mod.Structs); si++ {
		var ms irsym.ModuleStruct = gc.Mod.Structs[si]
		if ms.IsInstantiation && ms.InstDecl != nil && irutil.Streq(ms.InstDefPkg, gc.PkgPath) &&
				irutil.Streq(ms.InstDecl.Name, recvName) &&
				forgetEmittedInstantiation(gc, reemitMethodName(gc, ms, d)) {
			redo = slices.Append[int](redo, si)
		}
	}
	var noFile @ast.File
	for i := 0; i < len(redo); i++ {
		var ms irsym.ModuleStruct = gc.Mod.Structs[redo[i]]
		var args @[]@types.Type
		args, _ = canonicalTypeArgs(gc, ms.InstArgs)
		registerInstMethodSig(gc, ms.InstDecl, d,
				instantiationMangledName(gc, ms.InstDecl, ms.InstDefPkg, args), ms.InstDefPkg, args, noFile)
	}
	var from int = len(gc.Mod.Funcs)
	for i := 0; i < len(redo); i++ {
		var ms irsym.ModuleStruct = gc.Mod.Structs[redo[i]]
		var args @[]@types.Type
		args, _ = canonicalTypeArgs(gc, ms.InstArgs)
		emitInstantiatedMethod(gc, ms.InstDecl, d,
				instantiationMangledName(gc, ms.InstDecl, ms.InstDefPkg, args), ms.InstDefPkg, args, noFile)
	}
	var names @[]@[]char
	for i := 0; i < len(redo); i++ {
		names = slices.Append[@[]char](names, reemitMethodName(gc, gc.Mod.Structs[redo[i]], d))
	}
	return reemittedFuncs(gc, names, from)
}

// reemittedFuncs returns the functions named names among those added to the
// module from index from on: the instances emitted again.
func reemittedFuncs(gc @GenCtx, names *[]@[]char, from int) @[]@ir.Func {
	var redone @[]@ir.Func = make_slice(@ir.Func, len(names))
	for i := 0; i < len(names); i++ {
		for fi := from; fi < len(gc.Mod.Funcs); fi++ {
			if irutil.Streq(gc.Mod.Funcs[fi].Name, names[i]) { redone[i] = gc.Mod.Funcs[fi] }
		}
		if redone[i] == nil {
			panic(buf.Concat("internal error: no re-emitted instance ", names[i]))
		}
	}
	return redone
}

// reemitMethodName returns the name of instance ms's method d.
func reemitMethodName(gc @GenCtx, ms irsym.ModuleStruct, d @ast.Decl) @[]char {
	var args @[]@types.Type
	args, _ = canonicalTypeArgs(gc, ms.InstArgs)
	return joinMethodName(instantiationMangledName(gc, ms.InstDecl, ms.InstDefPkg, args), d.Name)
}

// forgetEmittedInstantiation removes name from gc.EmittedInstantiations, so it
// is emitted again; false when it was not emitted.
func forgetEmittedInstantiation(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		if irutil.Streq(gc.EmittedInstantiations[i], name) {
			var kept @[]@[]char = make_slice(@[]char, len(gc.EmittedInstantiations) - 1)
			for j := 0; j < i; j++ {
				kept[j] = gc.EmittedInstantiations[j]
			}
			for j := i + 1; j < len(gc.EmittedInstantiations); j++ {
				kept[j - 1] = gc.EmittedInstantiations[j]
			}
			gc.EmittedInstantiations = kept
			return true
		}
	}
	return false
}

// ReplGenericFunc returns the generic function declared at the prompt (or in
// the session's module) under name, or nil (see irgen.bni).
func ReplGenericFunc(gc @GenCtx, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(gc.GenericDecls); i++ {
		if irutil.Streq(gc.GenericDeclPkgs[i], gc.PkgPath) &&
				irutil.Streq(gc.GenericDecls[i].Name, name) {
			return gc.GenericDecls[i]
		}
	}
	return nil
}

// ShadowReplGenericFunc forgets the emitted instances of the generic function
// name and returns their names (see irgen.bni).  An instance's name is the
// function's qualified name, the instantiation marker, then the type-argument
// list, which starts with its count (instantiationMangledName): requiring that
// digit keeps the instances of a function whose name extends this one's with
// the marker's leading characters (`f__bn_inst`) out.
func ShadowReplGenericFunc(gc @GenCtx, name *[]readonly char) @[]@[]char {
	var prefix @[]char = buf.Concat(irutil.QualifyForPkgPath(gc.PkgPath, name), "__bn_inst__")
	var kept @[]@[]char
	var shadowed @[]@[]char
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		var n @[]char = gc.EmittedInstantiations[i]
		if len(n) > len(prefix) && irutil.Streq(n[:len(prefix)], prefix) && n[len(prefix)] >= '0' &&
				n[len(prefix)] <= '9' {
			shadowed = slices.Append[@[]char](shadowed, n)
		} else {
			kept = slices.Append[@[]char](kept, n)
		}
	}
	gc.EmittedInstantiations = kept
	return shadowed
}
