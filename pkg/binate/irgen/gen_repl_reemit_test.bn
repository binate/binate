package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/builtins/testing"

// Tests for gen_repl_reemit.bn.  The re-emission itself is exercised through
// the REPL (pkg/binate/repl's decl_generic_test.bn); genFromSourcePkgGc and
// genCheckedPkgGc live in gen_test_support_test.bn.

// An emitted instantiation is forgotten — so it is emitted again — once.
func TestForgetEmittedInstantiation() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nfunc main() {}\n")
	var names @[]@[]char = make_slice(@[]char, 3)
	names[0] = "test.a"
	names[1] = "test.b"
	names[2] = "test.c"
	gc.EmittedInstantiations = names
	if !forgetEmittedInstantiation(gc, "test.b") { return "test.b was emitted" }
	if len(gc.EmittedInstantiations) != 2 || !irutil.Streq(gc.EmittedInstantiations[1], "test.c") {
		return "test.b must be removed, the others kept in order"
	}
	if forgetEmittedInstantiation(gc, "test.b") { return "test.b is no longer emitted" }
	return ""
}

// The re-emitted instances are found by name among the functions added since
// the re-emission began.
func TestReemittedFuncsFindsByName() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nfunc main() {}\n")
	var from int = len(gc.Mod.Funcs)
	var f1 @ir.Func = make(ir.Func)
	f1.Name = "test.x"
	var f2 @ir.Func = make(ir.Func)
	f2.Name = "test.y"
	gc.Mod.AddFunc(f1)
	gc.Mod.AddFunc(f2)
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = "test.y"
	names[1] = "test.x"
	var redone @[]@ir.Func = reemittedFuncs(gc, names, from)
	if !same(redone[0], f2) || !same(redone[1], f1) { return "each name must find its function" }
	return ""
}

// Shadowing a generic function forgets exactly its instances, and finds the
// generic function by name.
func TestShadowReplGenericFunc() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\nfunc f[T any](x T) T { return x }\n"
					"func fg[T any](x T) T { return x }\n"
					"func main() { _ = f[int](1); _ = f[bool](true); _ = fg[int](2) }\n")
	if ReplGenericFunc(gc, "f") == nil || ReplGenericFunc(gc, "g") != nil {
		return "f must be found, g not"
	}
	var shadowed @[]@[]char = ShadowReplGenericFunc(gc, "f")
	if len(shadowed) != 2 { return "f[int] and f[bool] must be shadowed" }
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		for j := 0; j < len(shadowed); j++ {
			if irutil.Streq(gc.EmittedInstantiations[i], shadowed[j]) {
				return "a shadowed instance stays emitted"
			}
		}
	}
	if len(ShadowReplGenericFunc(gc, "fg")) != 1 { return "fg[int] must stay until fg is shadowed" }
	return ""
}

// Shadowing a generic-receiver method forgets exactly its instances: the
// method's, on every instance of its receiver type, and no other method's.
func TestShadowReplGenericMethod() testing.TestResult {
	var gc @GenCtx = genCheckedPkgGc(
			"package \"test\"\ntype Box[T any] struct { v T }\n"
					"func (b *Box[T]) get() T { return b.v }\n"
					"func (b *Box[T]) put(v T) { b.v = v }\n"
					"type Bag[T any] struct { v T }\n"
					"func (b *Bag[T]) get() T { return b.v }\n"
					"func main() { var a Box[int]; var c Box[bool]; var g Bag[int]; a.put(1); "
					"_ = a.get(); _ = c.get(); _ = g.get() }\n")
	var boxGet @ast.Decl
	for i := 0; i < len(gc.GenericMethodDecls); i++ {
		var d @ast.Decl = gc.GenericMethodDecls[i]
		if irutil.Streq(d.Name, "get") && irutil.Streq(genericMethodRecvName(d), "Box") { boxGet = d }
	}
	if boxGet == nil { return "Box.get must be stashed" }
	var before int = len(gc.EmittedInstantiations)
	var shadowed @[]@[]char = ShadowReplGenericMethod(gc, boxGet)
	if len(shadowed) != 2 { return "Box[int].get and Box[bool].get must be shadowed" }
	if len(gc.EmittedInstantiations) != before - 2 {
		return "only Box.get's instances must be forgotten"
	}
	for i := 0; i < len(shadowed); i++ {
		var n @[]char = shadowed[i]
		if len(n) < 12 || !irutil.Streq(n[:8], "test.Box") || !irutil.Streq(n[len(n) - 4:], ".get") {
			return buf.Concat("not an instance of Box.get: ", n)
		}
		if instantiationAlreadyEmitted(gc, n) { return "a shadowed instance stays emitted" }
	}
	if len(ShadowReplGenericMethod(gc, boxGet)) != 0 {
		return "a forgotten instance is not shadowed again"
	}
	return ""
}

// Shadowing a method of a generic type whose underlying type is not a struct
// forgets its instances too (they are recorded as named types, not structs),
// and EmitShadowedMethod emits them again.
func TestShadowReplGenericMethodOfNonStruct() testing.TestResult {
	var gc @GenCtx = genCheckedPkgGc(
			"package \"test\"\ntype Pair[T any] [2]T\n"
					"func (p Pair[T]) Second() T { return p[1] }\n"
					"func (p Pair[T]) First() T { return p[0] }\n"
					"type Duo[T any] [2]T\n"
					"func (p Duo[T]) Second() T { return p[1] }\n"
					"func main() { var a Pair[int]; var c Pair[bool]; var g Duo[int]; "
					"_ = a.Second(); _ = c.Second(); _ = a.First(); _ = g.Second() }\n")
	var pairSecond @ast.Decl
	for i := 0; i < len(gc.GenericMethodDecls); i++ {
		var d @ast.Decl = gc.GenericMethodDecls[i]
		if irutil.Streq(d.Name, "Second") && irutil.Streq(genericMethodRecvName(d), "Pair") {
			pairSecond = d
		}
	}
	if pairSecond == nil { return "Pair.Second must be stashed" }
	var before int = len(gc.EmittedInstantiations)
	var shadowed @[]@[]char = ShadowReplGenericMethod(gc, pairSecond)
	if len(shadowed) != 2 { return "Pair[int].Second and Pair[bool].Second must be shadowed" }
	if len(gc.EmittedInstantiations) != before - 2 {
		return "only Pair.Second's instances must be forgotten"
	}
	for i := 0; i < len(shadowed); i++ {
		var n @[]char = shadowed[i]
		if len(n) < 16 || !irutil.Streq(n[:9], "test.Pair") || !irutil.Streq(n[len(n) - 7:], ".Second") {
			return buf.Concat("not an instance of Pair.Second: ", n)
		}
		if instantiationAlreadyEmitted(gc, n) { return "a shadowed instance stays emitted" }
	}
	var redone @[]@ir.Func = EmitShadowedMethod(gc, pairSecond, shadowed)
	if len(redone) != 2 { return "both shadowed instances must be emitted again" }
	for i := 0; i < len(shadowed); i++ {
		if !instantiationAlreadyEmitted(gc, shadowed[i]) { return "an instance emitted again is emitted" }
	}
	return ""
}
