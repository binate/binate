package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iriface"
import "pkg/binate/irutil"
import "pkg/std/containers/vec"

// What a declaration typed at the prompt shadows is renamed to the hidden name
// the checker keeps the shadowed binding under (check.ShadowedBinding): a
// function's signature and IR function, a generic function's emitted instances,
// a package constant.  (A variable's global is ShadowReplGlobal's.)  So is a
// method a method declaration supersedes (check.ShadowedMethod): its function,
// its interface-dispatch thunk and its method-value wrappers.

// ShadowReplFunc renames the session's function name, and a generic function's
// instances, to hidden (see irgen.bni).
func ShadowReplFunc(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) @[]RenamedFunc {
	return renameReplFunc(gc, qualifyForCurrentModule(gc, name), qualifyForCurrentModule(gc, hidden))
}

// ShadowReplMethod renames the method of the session's type that the method
// declaration d supersedes to its hidden name (see irgen.bni).
func ShadowReplMethod(gc @GenCtx, d @ast.Decl, hidden *[]readonly char) @[]RenamedFunc {
	var out @vec.Vec[RenamedFunc] = vec.New[RenamedFunc]()
	var from @[]char = methodQualName(gc, gc.PkgPath, d)
	var to @[]char = buildMethodQualName(gc.PkgPath, methodRecvTypeName(gc, d), hidden)
	renameShadowedFunc(gc, out, from, to)
	renameShadowedFunc(gc, out, iriface.ThunkNameForMethod(from), iriface.ThunkNameForMethod(to))
	// The list is replaced whole, never written in place (a ReplEntry keeps the
	// one it began with).
	var wrappers @[]@[]char = make_slice(@[]char, len(gc.Mod.MethodValueWrappers))
	for i := 0; i < len(gc.Mod.MethodValueWrappers); i++ {
		var w @[]char = gc.Mod.MethodValueWrappers[i]
		wrappers[i] = w
		if isMethodValueWrapperOf(w, from) {
			wrappers[i] = buf.Concat(to, w[len(from):])
			renameShadowedFunc(gc, out, w, wrappers[i])
		}
	}
	gc.Mod.MethodValueWrappers = wrappers
	return out.Items()
}

// ShadowReplGenericMethod renames the method of the session's generic type that
// d supersedes to hidden on each instance of the type emitted (see irgen.bni).
func ShadowReplGenericMethod(gc @GenCtx, d @ast.Decl, hidden *[]readonly char) @[]RenamedFunc {
	var out @vec.Vec[RenamedFunc] = vec.New[RenamedFunc]()
	var recv @[]recvInst = methodRecvInstances(gc, d)
	// The lists are replaced whole, never written in place (a ReplEntry keeps the
	// ones it began with).
	var emitted @[]@[]char = make_slice(@[]char, len(gc.EmittedInstantiations))
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		emitted[i] = gc.EmittedInstantiations[i]
	}
	var wrappers @[]@[]char = make_slice(@[]char, len(gc.Mod.MethodValueWrappers))
	for i := 0; i < len(gc.Mod.MethodValueWrappers); i++ {
		wrappers[i] = gc.Mod.MethodValueWrappers[i]
	}
	for i := 0; i < len(recv); i++ {
		var inst @[]char = recvInstName(gc, recv[i])
		var from @[]char = joinMethodName(inst, d.Name)
		var to @[]char = joinMethodName(inst, buf.CopyStr(hidden))
		renameShadowedFunc(gc, out, from, to)
		renameShadowedFunc(gc, out, iriface.ThunkNameForMethod(from), iriface.ThunkNameForMethod(to))
		for j := 0; j < len(emitted); j++ {
			if irutil.Streq(emitted[j], from) { emitted[j] = buf.CopyStr(to) }
		}
		for j := 0; j < len(wrappers); j++ {
			if isMethodValueWrapperOf(wrappers[j], from) {
				var w @[]char = buf.Concat(to, wrappers[j][len(from):])
				renameShadowedFunc(gc, out, wrappers[j], w)
				wrappers[j] = w
			}
		}
	}
	gc.EmittedInstantiations = emitted
	gc.Mod.MethodValueWrappers = wrappers
	return out.Items()
}

// renameShadowedFunc renames the module's function from, when there is one, to
// to, and records it in out.
func renameShadowedFunc(gc @GenCtx, out @vec.Vec[RenamedFunc], from *[]readonly char,
		to *[]readonly char) {
	if renameModuleFunc(gc, from, to) { out.Push(renamedFunc(from, to)) }
}

// UnshadowReplFunc renames back each function ShadowReplFunc renamed (see
// irgen.bni).
func UnshadowReplFunc(gc @GenCtx, renamed *[]RenamedFunc) {
	for i := len(renamed) - 1; i >= 0; i-- {
		_ = renameModuleFunc(gc, renamed[i].New, renamed[i].Old)
	}
}

// renameReplFunc renames the function the module registers as from, and the
// instances emitted of a generic function from -- its qualified name, the
// instantiation marker, then the type-argument list, which starts with its count
// (instantiationMangledName): requiring that digit keeps out the instances of a
// function whose name extends from's with the marker's leading characters -- to
// to, and returns what it renamed.
func renameReplFunc(gc @GenCtx, from *[]readonly char, to *[]readonly char) @[]RenamedFunc {
	var out @vec.Vec[RenamedFunc] = vec.New[RenamedFunc]()
	if renameModuleFunc(gc, from, to) { out.Push(renamedFunc(from, to)) }
	var prefix @[]char = buf.Concat(from, "__bn_inst__")
	// The list is replaced whole, never written in place (a ReplEntry keeps the
	// one it began with).
	var emitted @[]@[]char = make_slice(@[]char, len(gc.EmittedInstantiations))
	for i := 0; i < len(gc.EmittedInstantiations); i++ {
		var n @[]char = gc.EmittedInstantiations[i]
		emitted[i] = n
		if len(n) <= len(prefix) || !irutil.Streq(n[:len(prefix)], prefix) || n[len(prefix)] < '0' ||
				n[len(prefix)] > '9' {
			continue
		}
		var renamed @[]char = buf.Concat(buf.Concat(to, "__bn_inst__"), n[len(prefix):])
		emitted[i] = renamed
		_ = renameModuleFunc(gc, n, renamed)
		out.Push(renamedFunc(n, renamed))
	}
	gc.EmittedInstantiations = emitted
	return out.Items()
}

// renamedFunc returns the RenamedFunc from -> to.
func renamedFunc(from *[]readonly char, to *[]readonly char) RenamedFunc {
	var r RenamedFunc
	r.Old = buf.CopyStr(from)
	r.New = buf.CopyStr(to)
	return r
}

// renameModuleFunc renames the module's function from -- its signature and its
// IR functions -- to to, reporting whether there was one.  A function the module
// registers as to already is an internal error: the IR functions would take a
// name its signature does not.
func renameModuleFunc(gc @GenCtx, from *[]readonly char, to *[]readonly char) bool {
	if ir.FuncSigIndexLookup(gc.Mod, to) >= 0 {
		panic(buf.Concat("internal error: REPL rename onto the registered function ", to))
	}
	var found bool = ir.RenameFuncSig(gc.Mod, from, to)
	for i := 0; i < len(gc.Mod.Funcs); i++ {
		if irutil.Streq(gc.Mod.Funcs[i].Name, from) {
			gc.Mod.Funcs[i].Name = buf.CopyStr(to)
			found = true
		}
	}
	return found
}

// ShadowReplConst renames the session's package constant name to hidden (see
// irgen.bni).
func ShadowReplConst(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) bool {
	var found bool = false
	for i := 0; i < len(gc.Mod.Consts); i++ {
		if !gc.Mod.Consts[i].Local && irutil.Streq(gc.Mod.Consts[i].Name, name) {
			gc.Mod.Consts[i].Name = buf.CopyStr(hidden)
			found = true
		}
	}
	return found
}
