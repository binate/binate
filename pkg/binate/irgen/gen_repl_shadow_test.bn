package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/builtins/testing"

// Tests for the renames of what a prompt declaration shadows (gen_repl_shadow.bn).

// A shadowed function is renamed -- its signature and IR function -- and so are
// the instances of a shadowed generic function, but not those of a generic whose
// name extends its; renaming back restores them.
func TestShadowReplFunc() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\nfunc f[T any](x T) T { return x }\n"
					"func fg[T any](x T) T { return x }\nfunc h() int { return 1 }\n"
					"func main() { _ = f[int](1); _ = f[bool](true); _ = fg[int](2); _ = h() }\n")
	var rs @[]RenamedFunc = ShadowReplFunc(gc, "f", "__repl_shadowed_3_f")
	if len(rs) != 2 { return "f[int] and f[bool] must be renamed" }
	for i := 0; i < len(rs); i++ {
		if !irutil.Streq(rs[i].Old[:len("test.f__bn_inst__")], "test.f__bn_inst__") ||
				!irutil.Streq(rs[i].New[:len("test.__repl_shadowed_3_f__bn_inst__")],
						"test.__repl_shadowed_3_f__bn_inst__") {
			return "an instance must be renamed after the hidden name"
		}
		if ir.FuncSigIndexLookup(gc.Mod, rs[i].Old) >= 0 || ir.FuncSigIndexLookup(gc.Mod, rs[i].New) < 0 {
			return "an instance's signature must be renamed"
		}
	}
	rs = ShadowReplFunc(gc, "h", "__repl_shadowed_3_h")
	if len(rs) != 1 || !irutil.Streq(rs[0].Old, "test.h") ||
			!irutil.Streq(rs[0].New, "test.__repl_shadowed_3_h") {
		return "h must be renamed"
	}
	if !replFuncNamed(gc, "test.__repl_shadowed_3_h") || replFuncNamed(gc, "test.h") {
		return "h's IR function must be renamed"
	}
	if !replFuncNamed(gc, "test.fg__bn_inst__1_N0_3_int") { return "fg's instance must keep its name" }
	UnshadowReplFunc(gc, "h", "__repl_shadowed_3_h")
	if !replFuncNamed(gc, "test.h") || ir.FuncSigIndexLookup(gc.Mod, "test.h") < 0 {
		return "h must be renamed back"
	}
	return ""
}

// replFuncNamed reports whether gc's module has an IR function named name.
func replFuncNamed(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.Mod.Funcs); i++ {
		if irutil.Streq(gc.Mod.Funcs[i].Name, name) { return true }
	}
	return false
}

// A shadowed package constant is renamed; a name with none is not.
func TestShadowReplConst() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nconst K float64 = 1.5\nfunc main() { }\n")
	if !ShadowReplConst(gc, "K", "__repl_shadowed_2_K") || ShadowReplConst(gc, "K", "x") {
		return "K must be renamed once"
	}
	if findPackageConst(gc, "__repl_shadowed_2_K") < 0 || findPackageConst(gc, "K") >= 0 {
		return "the constant must take its hidden name"
	}
	return ""
}
