package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the renames of what a prompt declaration shadows (gen_repl_shadow.bn).

// A shadowed function is renamed -- its signature and IR function -- and so are
// the instances of a shadowed generic function, but not those of a generic whose
// name extends its; renaming back restores them.
func TestShadowReplFunc() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\nfunc f[T any](x T) T { return x }\n"
					"func fg[T any](x T) T { return x }\nfunc h() int { return 1 }\n"
					"func main() { _ = f[int](1); _ = f[bool](true); _ = fg[int](2); _ = h() }\n")
	var rs @[]RenamedFunc = ShadowReplFunc(gc, "f", "__repl_shadowed_3_f")
	if len(rs) != 2 { return "f[int] and f[bool] must be renamed" }
	for i := 0; i < len(rs); i++ {
		if !irutil.Streq(rs[i].Old[:len("test.f__bn_inst__")], "test.f__bn_inst__") ||
				!irutil.Streq(rs[i].New[:len("test.__repl_shadowed_3_f__bn_inst__")],
						"test.__repl_shadowed_3_f__bn_inst__") {
			return "an instance must be renamed after the hidden name"
		}
		if ir.FuncSigIndexLookup(gc.Mod, rs[i].Old) >= 0 || ir.FuncSigIndexLookup(gc.Mod, rs[i].New) < 0 {
			return "an instance's signature must be renamed"
		}
	}
	rs = ShadowReplFunc(gc, "h", "__repl_shadowed_3_h")
	if len(rs) != 1 || !irutil.Streq(rs[0].Old, "test.h") ||
			!irutil.Streq(rs[0].New, "test.__repl_shadowed_3_h") {
		return "h must be renamed"
	}
	if !replFuncNamed(gc, "test.__repl_shadowed_3_h") || replFuncNamed(gc, "test.h") {
		return "h's IR function must be renamed"
	}
	if !replFuncNamed(gc, "test.fg__bn_inst__1_N0_3_int") { return "fg's instance must keep its name" }
	UnshadowReplFunc(gc, rs)
	if !replFuncNamed(gc, "test.h") || ir.FuncSigIndexLookup(gc.Mod, "test.h") < 0 {
		return "h must be renamed back"
	}
	return ""
}

// A superseded method is renamed -- its function and signature, its
// interface-dispatch thunk and its method-value wrapper -- and another method of
// its type is not; renaming back restores it.
func TestShadowReplMethod() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes(
					"package \"test\"\ntype Mv struct { n int }\n"
							"func (v Mv) Size() int { return v.n }\n"
							"func (v Mv) Other() int { return 2 }\n"
							"func main() { var mv Mv; var f *func() int = mv.Size\n"
							"\tvar g *func() int = mv.Other; _ = f(); _ = g() }\n"),
			"test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	var size @ast.Decl
	for i := 0; i < len(file.Decls); i++ {
		if irutil.Streq(file.Decls[i].Name, "Size") { size = file.Decls[i] }
	}
	if size == nil || !replFuncNamed(gc, "test.Mv.__bn_thunk_Size") {
		return "setup: Size must be declared, with a thunk"
	}
	var rs @[]RenamedFunc = ShadowReplMethod(gc, size, "__repl_shadowed_5_Size")
	if len(rs) != 3 { return "Size, its thunk and its wrapper must be renamed" }
	if !replFuncNamed(gc, "test.Mv.__repl_shadowed_5_Size") || replFuncNamed(gc, "test.Mv.Size") ||
			ir.FuncSigIndexLookup(gc.Mod, "test.Mv.__repl_shadowed_5_Size") < 0 {
		return "Size's function and signature must be renamed"
	}
	if !replFuncNamed(gc, "test.Mv.__bn_thunk___repl_shadowed_5_Size") ||
			replFuncNamed(gc, "test.Mv.__bn_thunk_Size") {
		return "Size's thunk must be renamed"
	}
	if len(gc.Mod.MethodValueWrappers) != 2 ||
			!irutil.Streq(gc.Mod.MethodValueWrappers[0], "test.Mv.__repl_shadowed_5_Size__methodval_v") ||
			!replFuncNamed(gc, "test.Mv.__repl_shadowed_5_Size__methodval_v") {
		return "Size's wrapper must be renamed"
	}
	if !replFuncNamed(gc, "test.Mv.Other") || !replFuncNamed(gc, "test.Mv.__bn_thunk_Other") ||
			!isMethodValueWrapperOf(gc.Mod.MethodValueWrappers[1], "test.Mv.Other") {
		return "Other must keep its names"
	}
	UnshadowReplFunc(gc, rs)
	if !replFuncNamed(gc, "test.Mv.Size") || !replFuncNamed(gc, "test.Mv.__bn_thunk_Size") ||
			ir.FuncSigIndexLookup(gc.Mod, "test.Mv.Size") < 0 {
		return "Size must be renamed back"
	}
	return ""
}

// A shadowing declaration that is not kept, in the REPL's order: its entry is
// undone -- which puts back the emitted-instance list, under the old names, but
// not the renamed signatures and IR functions -- and then what it shadowed is
// renamed back, the shadowed generic's instances included, so a later use of an
// instance finds its signature.
func TestUnshadowReplFuncAfterUndo() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc(
			"package \"test\"\nfunc f[T any](x T) T { return x }\nfunc main() { _ = f[int](1) }\n")
	var e @ReplEntry = BeginReplEntry(gc)
	var rs @[]RenamedFunc = ShadowReplFunc(gc, "f", "__repl_shadowed_3_f")
	if len(rs) != 1 { return "f[int] must be renamed" }
	if len(GenDecl(replDecl("func f() int8 { return 1 }"), gc)) > 0 { return "GenDecl failed" }
	UndoReplEntry(gc, e)
	UnshadowReplFunc(gc, rs)
	var inst *[]readonly char = "test.f__bn_inst__1_N0_3_int"
	if ir.FuncSigIndexLookup(gc.Mod, inst) < 0 || !replFuncNamed(gc, inst) ||
			!instantiationAlreadyEmitted(gc, inst) {
		return "f[int]'s signature, IR function and emitted name must be renamed back"
	}
	if ir.FuncSigIndexLookup(gc.Mod, "test.__repl_shadowed_3_f__bn_inst__1_N0_3_int") >= 0 ||
			replFuncNamed(gc, "test.__repl_shadowed_3_f__bn_inst__1_N0_3_int") {
		return "nothing must be left under the hidden name"
	}
	if ir.FuncSigIndexLookup(gc.Mod, "test.f") >= 0 { return "the undone f must be gone" }
	return ""
}

// replFuncNamed reports whether gc's module has an IR function named name.
func replFuncNamed(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.Mod.Funcs); i++ {
		if irutil.Streq(gc.Mod.Funcs[i].Name, name) { return true }
	}
	return false
}

// A shadowed package constant is renamed; a name with none is not.
func TestShadowReplConst() testing.TestResult {
	var gc @GenCtx = genFromSourcePkgGc("package \"test\"\nconst K float64 = 1.5\nfunc main() { }\n")
	if !ShadowReplConst(gc, "K", "__repl_shadowed_2_K") || ShadowReplConst(gc, "K", "x") {
		return "K must be renamed once"
	}
	if findPackageConst(gc, "__repl_shadowed_2_K") < 0 || findPackageConst(gc, "K") >= 0 {
		return "the constant must take its hidden name"
	}
	return ""
}

// A generic function a REPL input shadowed stays stashed: the code declared
// before the shadow finds it by its declaration, not by its name, which finds
// the generic that shadows it, and its instances emitted since are named after
// its hidden name, as those emitted before are renamed.
func TestShadowedGenericInstance() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"main\"\nfunc f[T any](x T) int { return 1 }\n"
			"func g[T any](x T) int { return f[T](x) }\nfunc main() { _ = g[int](1) }\n")
	var d @ast.Decl = checkedReplDecl(c, "func f[T any](x T) int8 { return 2 }")
	var sh check.ReplShadow
	var ok bool
	sh, ok = c.ShadowedBinding("f")
	if !ok { return fail("the checker must report f shadowed") }
	_ = ShadowReplFunc(gc, "f", sh.Hidden)
	if len(GenDecl(d, gc)) > 0 { return fail("GenDecl of the new f failed") }
	if !same(lookupGenericDecl(gc, "f"), d) { return fail("f must name the new generic") }
	var u @ast.Decl = checkedReplDecl(c, "func u() int { return g[bool](true) }")
	if len(GenDecl(u, gc)) > 0 { return fail("GenDecl of u failed") }
	var inst @[]char = buf.Concat(buf.Concat("main.", sh.Hidden), "__bn_inst__1_N0_4_bool")
	if !replFuncNamed(gc, inst) { return fail(buf.Concat("the old f's new instance must be ", inst)) }
	if replFuncNamed(gc, "main.f__bn_inst__1_N0_4_bool") {
		return fail("the new f must have no bool instance")
	}
	return ""
}

// A generic function a REPL redefinition of the same signature replaced is, to
// the code checked before the redefinition, the declaration that replaced it:
// a generic type's method, its instance checked then and emitted after, calls
// the new generic's instance.
func TestReplacedGenericReachedByEarlierCode() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"main\"\nfunc f[T any](x T) int { return 1 }\n"
			"type Box[T any] struct { v T }\nfunc (b *Box[T]) get() int { return f[T](b.v) }\n"
			"var bx Box[int]\nfunc main() { }\n")
	var d @ast.Decl = checkedReplDecl(c, "func f[T any](x T) int { return 2 }")
	if len(GenDecl(d, gc)) > 0 { return fail("GenDecl of the new f failed") }
	if !same(lookupGenericDecl(gc, "f"), d) { return fail("f must name the new generic") }
	var u @ast.Decl = checkedReplDecl(c, "func u() int { return bx.get() }")
	if len(GenDecl(u, gc)) > 0 { return fail("GenDecl of u failed") }
	if !replFuncNamed(gc, "main.f__bn_inst__1_N0_3_int") { return fail("get must call f[int]") }
	return ""
}
