package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/stdx/slices"

// REPL variable redefinition: a variable redeclared with its own type keeps its
// storage and is reset; one redeclared with another type is shadowed.

// replZeroName is the local MakeZeroAssignStmts declares; `__` names are
// reserved for the implementation.
func replZeroName() @[]char {
	return buf.CopyStr("__repl_zero")
}

// MakeZeroAssignStmts returns the statements resetting the variable d declares
// (see irgen.bni).
func MakeZeroAssignStmts(d @ast.Decl) @[]@ast.Stmt {
	var zero @ast.Decl = make(ast.Decl)
	zero.Kind = ast.DECL_VAR
	zero.Name = replZeroName()
	zero.TypeRef = d.TypeRef
	zero.Pos = d.Pos
	var decl @ast.Stmt = make(ast.Stmt)
	decl.Kind = ast.STMT_DECL
	decl.Pos = d.Pos
	decl.DeclRef = zero
	var lhs @ast.Expr = make(ast.Expr)
	lhs.Kind = ast.EXPR_IDENT
	lhs.Name = d.Name
	lhs.Pos = d.Pos
	var rhs @ast.Expr = make(ast.Expr)
	rhs.Kind = ast.EXPR_IDENT
	rhs.Name = replZeroName()
	rhs.Pos = d.Pos
	var assign @ast.Stmt = make(ast.Stmt)
	assign.Kind = ast.STMT_ASSIGN
	assign.Pos = d.Pos
	assign.Op = cast(int, token.ASSIGN)
	assign.Exprs = slices.Append[@ast.Expr](assign.Exprs, lhs)
	assign.Exprs2 = slices.Append[@ast.Expr](assign.Exprs2, rhs)
	var stmts @[]@ast.Stmt = make_slice(@ast.Stmt, 2)
	stmts[0] = decl
	stmts[1] = assign
	return stmts
}

// ShadowReplGlobal renames the session's global variable `name` to `hidden`
// (see irgen.bni).
func ShadowReplGlobal(gc @GenCtx, name *[]readonly char, hidden *[]readonly char) bool {
	var found bool = false
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		if irutil.Streq(gc.Mod.GlobalVars[i].Name, name) {
			gc.Mod.GlobalVars[i].Name = buf.CopyStr(hidden)
			found = true
		}
	}
	for i := 0; i < len(gc.Mod.Globals); i++ {
		if irutil.Streq(gc.Mod.Globals[i].Name, name) {
			gc.Mod.Globals[i].Name = buf.CopyStr(hidden)
		}
	}
	return found
}
