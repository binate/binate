package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_repl_vars.bn.

// A shadowed prompt variable's GlobalVars entry and ir.Global take the hidden
// name, so a redeclaration registers a new global under the plain one.
func TestShadowReplGlobalRenames() testing.TestResult {
	var m @ir.Module = genFromSource("package \"test\"\nfunc main() {}\n")
	var p @parser.Parser = parser.New(strToBytes("var x int = 1"), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if len(GenDecl(d, NewGenCtx(m))) > 0 { return fail("var x refused") }
	if !ShadowReplGlobal(NewGenCtx(m), "x", "__repl_shadowed_x") { return fail("x not found") }
	if bareGlobalIdx(NewGenCtx(m), "x") >= 0 { return fail("x must be renamed") }
	if bareGlobalIdx(NewGenCtx(m), "__repl_shadowed_x") < 0 {
		return fail("the hidden name must resolve")
	}
	if !charsEqual(m.Globals[len(m.Globals) - 1].Name, "__repl_shadowed_x") {
		return fail("the ir.Global must be renamed")
	}
	if ShadowReplGlobal(NewGenCtx(m), "missing", "y") {
		return fail("a missing global must report false")
	}
	return ""
}

// The zero-reset statements declare a local of the variable's type and assign
// it to the variable.
func TestMakeZeroAssignStmts() testing.TestResult {
	var p @parser.Parser = parser.New(strToBytes("var s @[]char"), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	var stmts @[]@ast.Stmt = MakeZeroAssignStmts(d)
	if len(stmts) != 2 { return fail("two statements") }
	if stmts[0].Kind != ast.STMT_DECL || stmts[0].DeclRef.TypeRef != d.TypeRef {
		return fail("a local of the variable's type")
	}
	if stmts[1].Kind != ast.STMT_ASSIGN || !charsEqual(stmts[1].Exprs[0].Name, "s") {
		return fail("assigned to the variable")
	}
	return ""
}
