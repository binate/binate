package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/builtins/testing"

// Tests for gen_repl_vars.bn.

// A shadowed prompt variable's GlobalVars entry and ir.Global take the hidden
// name, so a redeclaration registers a new global under the plain one.
func TestShadowReplGlobalRenames() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"test\"\nfunc main() {}\n")
	var m @ir.Module = gc.Mod
	var d @ast.Decl = checkedReplDecl(c, "var x int = 1")
	if len(GenDecl(d, gc)) > 0 { return fail("var x refused") }
	if !ShadowReplGlobal(gc, "x", "__repl_shadowed_x") { return fail("x not found") }
	if ir.GlobalVarIndexLookup(m, "x") >= 0 { return fail("x must be renamed") }
	if ir.GlobalVarIndexLookup(m, "__repl_shadowed_x") < 0 {
		return fail("the hidden name must resolve")
	}
	if !charsEqual(m.Globals[len(m.Globals) - 1].Name, "__repl_shadowed_x") {
		return fail("the ir.Global must be renamed")
	}
	if ShadowReplGlobal(gc, "missing", "y") {
		return fail("a missing global must report false")
	}
	return ""
}
