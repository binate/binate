package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for STMT_RETURN lowering (gen_return.bn).
// Uses helpers (genFromSource, findFunc, fail) from ir_test.bn.

func TestReturnStringAsManagedSlice() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc greet() @[]char {\n\treturn \"hello\"\n}\n"
	var m @ir.Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var f @ir.Func = m.Funcs[0]
	if len(f.Results) == 0 {
		return fail("expected return type")
	}
	if f.Results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type")
	}
	var found bool = false
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			if f.Blocks[i].Instrs[j].Op == iropcode.OP_RODATA_MSLICE_COPY {
				found = true
			}
		}
	}
	if !found { return fail("expected iropcode.OP_RODATA_MSLICE_COPY instruction") }
	return ""
}

// `return f()` for a multi-return outer should lower to one OP_CALL
// + one OP_EXTRACT per result + one OP_RETURN. The existing per-expr
// path emits one expression-evaluation per result, so the EmitExtract
// shape is the witness that the multi-return-call branch was taken.
func TestGenReturnMultiCallEmitsExtracts() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f() (int, bool) { return 1, true }\n")
	b.Write("func g() (int, bool) { return f() }\n")
	var src @[]char = buf.CopyStr(b.String())
	var m @ir.Module = genFromSource(src)
	var fn @ir.Func = findFunc(m, "g")
	if fn == nil { return fail("expected g func") }
	var nCalls int = 0
	var nExtracts int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CALL { nCalls = nCalls + 1 }
			if ins.Op == iropcode.OP_EXTRACT { nExtracts = nExtracts + 1 }
		}
	}
	if nCalls != 1 { return fail("expected exactly 1 iropcode.OP_CALL") }
	if nExtracts != 2 { return fail("expected exactly 2 iropcode.OP_EXTRACT") }
	return ""
}

// moveModule generates a package whose functions return and store call results
// of a struct with a managed field (R), a managed-slice and a managed pointer —
// fresh results a consumer moves — and borrowed locals of them.  R's copy
// function is `__copy_1R`.
func moveModule() @ir.Module {
	return genCheckedPkg(
			"package \"test\"\n"
					"type R struct {\n\ts @[]int\n\tn int\n}\n"
					"type B struct {\n\tv int\n}\n"
					"type H struct {\n\tr R\n}\n"
					"interface Mk {\n\tMake() @B\n}\n"
					"type M struct {\n\tk int\n}\n"
					"func (m *M) Make() @B { return make(B) }\n"
					"impl *M : Mk\n"
					"func mk() R {\n\tvar r R\n\treturn r\n}\n"
					"func mks() @[]int { return make_slice(int, 1) }\n"
					"func mkb() @B { return make(B) }\n"
					"func retR() R { return mk() }\n"
					"func retS() @[]int { return mks() }\n"
					"func retB() @B { return mkb() }\n"
					"func retLocal() R {\n\tvar r R = mk()\n\treturn r\n}\n"
					"func initR() int {\n\tvar r R = mk()\n\treturn r.n\n}\n"
					"func assignR() int {\n\tvar r R\n\tr = mk()\n\treturn r.n\n}\n"
					"func assignField(h *H) { h.r = mk() }\n"
					"func viaFv() @B {\n\tvar f *func() @B = mkb\n\tvar b @B = f()\n\treturn b\n}\n"
					"func viaIface(mi *Mk) @B {\n\tvar b @B = mi.Make()\n\treturn b\n}\n"
					"func sliceElem(s @[]R) { s[0] = mk() }\n"
					"func sliceLit() int {\n\tvar s @[]R = @[]R{mk()}\n\treturn len(s)\n}\n"
					"func arrElem() int {\n\tvar a [2]R\n\ta[0] = mk()\n\treturn a[0].n\n}\n"
					"func litField() int {\n\tvar h H = H{r: mk()}\n\treturn h.r.n\n}\n")
}

// `return f()` MOVES the call's result to the caller (spec mem.move): a struct
// with a managed field is neither copied (no `__copy_` call) nor released as the
// statement's temp (no `__dtor_` call), and a managed-slice or managed pointer is
// neither retained nor released.
func TestReturnMovesFreshCallResult() testing.TestResult {
	var m @ir.Module = moveModule()
	var r @ir.Func = findFunc(m, "retR")
	if countCallsTo(r, "__copy_") != 0 || countCallsTo(r, "__dtor_") != 0 {
		return fail("return of a struct call result: moved, not copied and released")
	}
	var s @ir.Func = findFunc(m, "retS")
	if countOp(s, iropcode.OP_REFINC) != 0 || countOp(s, iropcode.OP_REFDEC) != 0 {
		return fail("return of a managed-slice call result: moved, not retained and released")
	}
	var b @ir.Func = findFunc(m, "retB")
	if countOp(b, iropcode.OP_REFINC) != 0 || countOp(b, iropcode.OP_REFDEC) != 0 {
		return fail("return of a managed-pointer call result: moved, not retained and released")
	}
	return ""
}

// A returned local is borrowed: it is copied for the caller (one `__copy_` call),
// its own initializer — a call result — having been moved into it.
func TestReturnCopiesBorrowedLocal() testing.TestResult {
	var fn @ir.Func = findFunc(moveModule(), "retLocal")
	if countCallsTo(fn, "__copy_") != 1 {
		return fail("a returned local is copied once; its initializer is moved in")
	}
	return ""
}
