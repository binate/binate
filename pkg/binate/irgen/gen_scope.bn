package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/stdx/slices"

// IR-gen's variable scopes.  ctx.Vars holds the variables in scope at the
// current point, outermost first; ctx.Scopes partitions it into the scopes open
// there, innermost last — a block (a function body, a `{ }` block, an `if` /
// `else` / loop body, a switch or type-switch case body) or a construct's own
// variables (a C-style `for` statement's init variables, a range loop's operand
// and its per-iteration variables, a type switch's scrutinee) — each recording
// where its variables start.  A scope's variables are released when control
// leaves it: at its fall-through end (closeScope) or by a `break` / `continue`
// leaving it (emitLeaveScopes), innermost scope first.  (A `return` and the VM
// fault pads release every variable at once: emitDecForManagedLocals.)  The
// variables below the outermost scope are the function's own: its parameters,
// the defer pre-pass's operand slots, and a function literal's inherited
// constant bindings.

// ScopeRec is one open scope: its variables are ctx.Vars[VarStart:] up to the
// next scope's VarStart.
type ScopeRec struct {
	VarStart int
}

// openScope opens a scope whose variables start at the current end of ctx.Vars.
func openScope(ctx @GenContext) {
	var s ScopeRec
	s.VarStart = len(ctx.Vars)
	ctx.Scopes = slices.Append[ScopeRec](ctx.Scopes, s)
}

// closeScope closes the innermost scope and drops its variables from ctx.Vars.
// On a fall-through exit (release) their release is emitted into b first; on a
// terminated exit — a `return`, `break` or `continue` — the terminator has
// released them already.  Returns the block flow continues in.
func closeScope(ctx @GenContext, b @ir.Block, release bool) @ir.Block {
	var start int = ctx.Scopes[len(ctx.Scopes) - 1].VarStart
	if release {
		b = emitDecForScopeVars(ctx, b, start)
	}
	ctx.Vars = ctx.Vars[:start]
	ctx.Scopes = ctx.Scopes[:len(ctx.Scopes) - 1]
	return b
}

// emitLeaveScopes emits, into b, the release of the variables a `break` or
// `continue` leaves: those of ctx.Scopes[depth:], innermost scope first, then any
// declared between floor (the target's ctx.Vars length) and the outermost of
// those scopes — a hidden slot a switch's case expression declares (a raw-slice
// literal's backing, defineHiddenOwnedSlot), which belongs to the enclosing
// block and is marked ClearAfterRelease so the block's own release of it later
// is a no-op.  It changes neither ctx.Vars nor ctx.Scopes — the enclosing code
// closes the scopes as it unwinds.  Returns the final block (a branching release
// may split it).
func emitLeaveScopes(ctx @GenContext, b @ir.Block, depth int, floor int) @ir.Block {
	var end int = len(ctx.Vars)
	for d := len(ctx.Scopes) - 1; d >= depth; d-- {
		var start int = ctx.Scopes[d].VarStart
		b = emitDecForVarRange(ctx, b, start, end)
		end = start
	}
	return emitDecForVarRange(ctx, b, floor, end)
}
