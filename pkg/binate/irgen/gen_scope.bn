package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/stdx/slices"

// IR-gen's variable scopes.  ctx.Vars holds the variables in scope at the
// current point, outermost first; ctx.Scopes partitions it into the scopes open
// there, innermost last — a block (a function body, a `{ }` block, an `if` /
// `else` / loop body, a switch or type-switch case body) or a construct's own
// variables (a C-style `for` statement's init variables, a range loop's operand
// and its per-iteration variables, a type switch's scrutinee) — each recording
// where its variables start and the deferred blocks scheduled on it
// (gen_defer.bn).  When control leaves a scope — at its fall-through end
// (closeScope) or by a `break`, `continue` or `return` leaving it
// (emitLeaveScopes), innermost scope first — its deferred blocks run and then
// its variables are released.  (A `return` with no deferred block pending, and
// the VM fault pads, release every variable at once: emitDecForManagedLocals.)
// The variables below the outermost scope are the function's own: its
// parameters and a function literal's inherited constant bindings.

// ScopeRec is one open scope: its variables are ctx.Vars[VarStart:] up to the
// next scope's VarStart, and Defers its scheduled deferred blocks, in order.
type ScopeRec struct {
	VarStart int
	Defers   @[]PendingDefer
}

// openScope opens a scope whose variables start at the current end of ctx.Vars.
func openScope(ctx @GenContext) {
	var s ScopeRec
	s.VarStart = len(ctx.Vars)
	ctx.Scopes = slices.Append[ScopeRec](ctx.Scopes, s)
}

// closeScope closes the innermost scope and drops its variables from ctx.Vars.
// On a fall-through exit (release) its deferred blocks and then its variables'
// release are emitted into b first; on a terminated exit — a `return`, `break`
// or `continue` — the terminator has emitted both already.  Returns the block
// flow continues in (terminated if a deferred block ends in a panic).
func closeScope(ctx @GenContext, b @ir.Block, release bool) @ir.Block {
	var start int = ctx.Scopes[len(ctx.Scopes) - 1].VarStart
	if release {
		b = emitScopeDefers(ctx, b, len(ctx.Scopes) - 1)
		if !blockIsTerminated(b) {
			b = emitDecForScopeVars(ctx, b, start)
		}
	}
	ctx.Vars = ctx.Vars[:start]
	ctx.Scopes = ctx.Scopes[:len(ctx.Scopes) - 1]
	return b
}

// emitLeaveScopes emits, into b, the exit of the scopes a `break`, `continue` or
// `return` leaves: for each of ctx.Scopes[depth:], innermost scope first, its
// deferred blocks and then its variables' release; then the release of any
// variable declared between floor (the target's ctx.Vars length) and the
// outermost of those scopes — a hidden slot a switch's case expression declares
// (a raw-slice literal's backing, defineHiddenOwnedSlot), which belongs to the
// enclosing block and is marked ClearAfterRelease so the block's own release of
// it later is a no-op.  A `return` leaves every scope (depth and floor 0).  It
// changes neither ctx.Vars nor ctx.Scopes — the enclosing code closes the scopes
// as it unwinds.  Returns the final block — split by a branching release, or
// terminated if a deferred block ends in a panic, which ends the exit there.
func emitLeaveScopes(ctx @GenContext, b @ir.Block, depth int, floor int) @ir.Block {
	var end int = len(ctx.Vars)
	for d := len(ctx.Scopes) - 1; d >= depth; d-- {
		b = emitScopeDefers(ctx, b, d)
		if blockIsTerminated(b) { return b }
		var start int = ctx.Scopes[d].VarStart
		b = emitDecForVarRange(ctx, b, start, end)
		end = start
	}
	return emitDecForVarRange(ctx, b, floor, end)
}
