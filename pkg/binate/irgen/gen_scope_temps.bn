package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/std/containers/vec"

// A statement's temporaries end with the statement (spec mem.temporary), so the slots
// IR-gen makes for them can share frame bytes with the next statement's.  Such a slot
// carries the statement's scope (stmtTempSlot), and the statement ends that scope after
// its temporaries' releases (endStmtTemps) -- a value the expression reads back within
// the statement: a struct call result's field read, an array value's element read, a
// by-value argument's copy, an assignment's acquired value and the value it replaces,
// a composite literal nothing takes the address of.  Only those slots end so.  Any
// other slot IR-gen makes during a statement keeps scope 0, for the whole function,
// since some must outlive the statement: a borrow or an addressed literal a `var`
// binding keeps (expr.composite.lifetime), a raw slice literal's backing, a `return`'s
// results kept across its deferred blocks, the address of a field of a value.  A slot
// that becomes a variable's (defineVar) takes the variable's scope instead.
//
// A slot used only within one emitted sequence -- an aggregate copied into it to be
// handed to its dtor or copy function -- has a scope of its own, ended right after
// that use (ownScopeSlot, endOwnScope).

// StmtTemps is the statement state beginStmtTemps replaces, for endStmtTemps to
// restore: a deferred block's statements are generated inside a `return`.
type StmtTemps struct {
	Scope int
	Open  bool
}

// beginStmtTemps opens a statement for its temporaries' scope and returns the state
// to restore at its end.
func beginStmtTemps(ctx @GenContext) StmtTemps {
	var saved StmtTemps = suspendStmtTemps(ctx)
	ctx.StmtOpen = true
	return saved
}

// endStmtTemps closes the statement beginStmtTemps opened: when one of its temporaries
// took its scope, the scope ends in b, after their releases (a terminated b -- a
// `return`, a call that does not return -- ends nothing: no instruction follows).
// Then the enclosing state is restored.
func endStmtTemps(ctx @GenContext, b @ir.Block, saved StmtTemps) {
	if ctx.StmtScope > 0 && !blockIsTerminated(b) { irbuild.EmitScopeEnd(b, ctx.StmtScope) }
	resumeStmtTemps(ctx, saved)
}

// endStmtTempsOnEdges is endStmtTemps for a condition whose block ends in a branch to
// t or f: the scope ends at the start of each, not between the compare and its branch,
// which the backends fuse.  Each must be empty yet; a merge block another path reaches
// later ends a scope already ended there, which ends nothing.
func endStmtTempsOnEdges(ctx @GenContext, t @ir.Block, f @ir.Block, saved StmtTemps) {
	if ctx.StmtScope > 0 {
		if len(t.Instrs) != 0 || len(f.Instrs) != 0 {
			panic("internal error: a condition's scope ends in a successor already generated")
		}
		irbuild.EmitScopeEnd(t, ctx.StmtScope)
		irbuild.EmitScopeEnd(f, ctx.StmtScope)
	}
	resumeStmtTemps(ctx, saved)
}

// suspendStmtTemps closes the open statement, if any, without ending its scope, for
// statements generated inside it (a deferred block's, inside a `return`); it returns
// the state resumeStmtTemps restores.
func suspendStmtTemps(ctx @GenContext) StmtTemps {
	var saved StmtTemps
	saved.Scope = ctx.StmtScope
	saved.Open = ctx.StmtOpen
	ctx.StmtScope = 0
	ctx.StmtOpen = false
	return saved
}

// resumeStmtTemps restores the statement state suspendStmtTemps saved.
func resumeStmtTemps(ctx @GenContext, saved StmtTemps) {
	ctx.StmtScope = saved.Scope
	ctx.StmtOpen = saved.Open
}

// stmtTempSlot gives slot, an alloca holding one of the open statement's temporaries,
// the statement's scope -- the statement taking one with its first such slot -- and
// returns slot.  Outside a statement (a range loop's collection, a switch's case
// values) the slot keeps scope 0.
func stmtTempSlot(ctx @GenContext, slot @ir.Instr) @ir.Instr {
	if !ctx.StmtOpen || slot == nil || slot.Op != iropcode.OP_ALLOC || slot.Scope != 0 { return slot }
	if ctx.StmtScope == 0 {
		ctx.StmtScope = irbuild.NewScope(ctx.Func)
		if ctx.StmtScopes == nil { ctx.StmtScopes = vec.New[bool]() }
		for ctx.StmtScopes.Len() <= ctx.StmtScope { ctx.StmtScopes.Push(false) }
		ctx.StmtScopes.Set(ctx.StmtScope, true)
	}
	slot.Scope = ctx.StmtScope
	return slot
}

// isStmtScope reports whether scope id is a statement's (stmtTempSlot).
func isStmtScope(ctx @GenContext, id int) bool {
	return id > 0 && ctx.StmtScopes != nil && id < ctx.StmtScopes.Len() && ctx.StmtScopes.Get(id)
}

// ownScopeSlot gives slot, an alloca used only within the sequence being emitted, a
// scope of its own, and returns slot; endOwnScope ends it after the slot's last use.
func ownScopeSlot(ctx @GenContext, slot @ir.Instr) @ir.Instr {
	slot.Scope = irbuild.NewScope(ctx.Func)
	return slot
}

// endOwnScope ends slot's own scope (ownScopeSlot) in b, after the slot's last use.
func endOwnScope(b @ir.Block, slot @ir.Instr) {
	if slot.Scope > 0 && !blockIsTerminated(b) { irbuild.EmitScopeEnd(b, slot.Scope) }
}
