package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_scope_temps.bn.  scopeTestCtx, countScopeEnds, namedSlot
// (gen_scope_test.bn), containsSub, genFromSource, findFunc and fail are shared test
// helpers.

// A slot takes the open statement's scope, the statement taking one with its first
// such slot, and the statement's end ends it last; outside a statement, and inside a
// suspended one, a slot keeps scope 0, and resuming restores the statement's scope.
func TestStmtTempSlotTakesStatementScope() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.TypInt()
	var outside @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	if outside.Scope != 0 { return fail("outside a statement a slot keeps scope 0") }
	var st StmtTemps = beginStmtTemps(ctx)
	if ctx.StmtScope != 0 { return fail("a statement has no scope before its first temporary") }
	var x @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	var inner StmtTemps = suspendStmtTemps(ctx)
	var hidden @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	resumeStmtTemps(ctx, inner)
	var y @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	if x.Scope == 0 || y.Scope != x.Scope { return fail("x and y share the statement's scope") }
	if hidden.Scope != 0 { return fail("a suspended statement's slot keeps scope 0") }
	if !isStmtScope(ctx, x.Scope) { return fail("the statement's scope is marked") }
	endStmtTemps(ctx, b, st)
	var last @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	if last.Op != iropcode.OP_SCOPE_END || last.Scope != x.Scope {
		return fail("the end ends x's scope")
	}
	if ctx.StmtOpen || ctx.StmtScope != 0 { return fail("the end restores no open statement") }
	st = beginStmtTemps(ctx)
	endStmtTemps(ctx, b, st)
	if countScopeEnds(ctx.Func, 0) != 1 { return fail("a statement with no temporary ends nothing") }
	return ""
}

// A statement temporary's slot that becomes a variable's takes the variable's scope,
// or 0 for a hidden one; a slot with a variable's scope keeps it.
func TestDefineVarTakesStmtTempSlot() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.TypInt()
	openScope(ctx)
	var keep @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "keep", keep, it)
	var st StmtTemps = beginStmtTemps(ctx)
	var x @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	var h @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	defineVar(ctx, "x", x, it)
	defineVar(ctx, ".complit", h, it)
	openScope(ctx)
	defineVar(ctx, "again", keep, it)
	endStmtTemps(ctx, b, st)
	if x.Scope != keep.Scope { return fail("x takes its block's scope") }
	if h.Scope != 0 { return fail("a hidden variable's slot takes scope 0") }
	if keep.Scope != 1 { return fail("a variable's slot keeps its scope") }
	return ""
}

// An own scope is fresh and ends where endOwnScope is called; a condition's scope ends
// at the start of both successors, not before the branch.
func TestOwnScopeAndConditionEdges() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.TypInt()
	var a @ir.Instr = ownScopeSlot(ctx, irbuild.EmitAlloc(b, it))
	var c @ir.Instr = ownScopeSlot(ctx, irbuild.EmitAlloc(b, it))
	if a.Scope == 0 || c.Scope == a.Scope { return fail("each own scope is fresh") }
	endOwnScope(b, a)
	if countScopeEnds(ctx.Func, a.Scope) != 1 { return fail("a's scope ends once") }
	var st StmtTemps = beginStmtTemps(ctx)
	var x @ir.Instr = stmtTempSlot(ctx, irbuild.EmitAlloc(b, it))
	var t @ir.Block = ir.AddBlock(ctx.Func, "t")
	var f @ir.Block = ir.AddBlock(ctx.Func, "f")
	irbuild.EmitBranch(b, irbuild.EmitConstBool(b, true), t, f)
	endStmtTempsOnEdges(ctx, t, f, st)
	if len(t.Instrs) != 1 || t.Instrs[0].Op != iropcode.OP_SCOPE_END || t.Instrs[0].Scope != x.Scope ||
			len(f.Instrs) != 1 || f.Instrs[0].Scope != x.Scope {
		return fail("the condition's scope ends at the start of both successors")
	}
	if countScopeEnds(ctx.Func, x.Scope) != 2 { return fail("and nowhere else") }
	return ""
}

// structTempSlots returns fn's unnamed struct allocas, in block order.
func structTempSlots(fn @ir.Func) @[]@ir.Instr {
	var out @[]@ir.Instr
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op != iropcode.OP_ALLOC || len(ins.StrVal) != 0 || ins.TypeArg == nil { continue }
			if types.StripWrappers(ins.TypeArg).Kind != types.TYP_STRUCT { continue }
			out = slices.Append[@ir.Instr](out, ins)
		}
	}
	return out
}

// endBeforeTerminator reports whether some block of fn has an OP_SCOPE_END of scope s
// right before its terminator.
func endBeforeTerminator(fn @ir.Func, s int) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		var n int = len(blk.Instrs)
		if n < 2 || !blk.Instrs[n - 1].IsTerminator() { continue }
		var prev @ir.Instr = blk.Instrs[n - 2]
		if prev.Op == iropcode.OP_SCOPE_END && prev.Scope == s { return true }
	}
	return false
}

// tempsSrc reads fields of struct call results in a declaration, an `if` condition
// and a `return`, passes a literal's address, and binds a literal to a variable.
func tempsSrc() *[]readonly char {
	return "package \"test\"\n"
			"type P struct {\n\ta int\n\tb int\n\tc int\n\td int\n}\n"
			"func mk(k int) P {\n\tvar p P\n\tp.a = k\n\treturn p\n}\n"
			"func sum(p *P) int { return p.a + p.b }\n"
			"func f(k int) int {\n"
			"\tvar t int = mk(k).b\n"
			"\tif mk(k).c == 0 { t = t + 1 }\n"
			"\tt = t + sum(&P{a: k})\n"
			"\tvar q P = P{b: k}\n"
			"\treturn t + q.b + mk(k).d\n"
			"}\n"
			"func main() { _ = f(1) }\n"
}

// Through IR-gen: a field read of a call result takes its statement's scope, ended
// after the statement; an `if` condition's at the start of both successors; a
// `return`'s takes a scope with no end (the `ret` ends it); an addressed literal
// keeps scope 0; a literal bound to a variable takes the variable's scope.
func TestStmtTempsThroughIRGen() testing.TestResult {
	var m @ir.Module = genFromSource(tempsSrc())
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the module verifies") }
	var fn @ir.Func = findFunc(m, "f")
	var temps @[]@ir.Instr = structTempSlots(fn)
	if len(temps) != 4 { return fail("setup: f has four unnamed struct slots") }
	var decl @ir.Instr = temps[0]
	var cond @ir.Instr = temps[1]
	var lit @ir.Instr = temps[2]
	var ret @ir.Instr = temps[3]
	if decl.Scope == 0 || cond.Scope == 0 || ret.Scope == 0 || cond.Scope == decl.Scope ||
			ret.Scope == cond.Scope {
		return fail("each statement's temporary takes a scope of its own")
	}
	if countScopeEnds(fn, decl.Scope) != 1 { return fail("the declaration's temporary ends once") }
	if countScopeEnds(fn, cond.Scope) != 2 || endBeforeTerminator(fn, cond.Scope) {
		return fail("the condition's temporary ends at the start of both successors")
	}
	if countScopeEnds(fn, ret.Scope) != 0 { return fail("the return's temporary has no end") }
	if lit.Scope != 0 { return fail("an addressed literal keeps scope 0") }
	var q @ir.Instr = namedSlot(fn, "q")
	var t @ir.Instr = namedSlot(fn, "t")
	if q == nil || t == nil || q.Scope == 0 || q.Scope != t.Scope {
		return fail("the literal bound to q is q's storage, in the body's scope")
	}
	return ""
}

// endAfterCall reports whether fn has an OP_SCOPE_END of scope s right after an
// OP_CALL to a name containing callee.
func endAfterCall(fn @ir.Func, s int, callee *[]readonly char) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 1; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			var prev @ir.Instr = blk.Instrs[ii - 1]
			if ins.Op == iropcode.OP_SCOPE_END && ins.Scope == s && prev.Op == iropcode.OP_CALL &&
					containsSub(prev.StrVal, callee) {
				return true
			}
		}
	}
	return false
}

// A field store's replaced struct with references is destroyed through a slot of its
// own scope, ended right after its dtor; a call result passed by value is copied into
// a statement temporary, where it is destroyed at the statement's end, after the call
// to useM.
func TestOwnScopeSlotThroughIRGen() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type M struct {\n\ts @[]char\n\tn int\n}\n"
					"type Rec struct {\n\tm M\n}\n"
					"func mkM() M {\n\tvar m M\n\tm.n = 1\n\treturn m\n}\n"
					"func useM(m M) int { return m.n }\n"
					"func g(r @Rec) int {\n\tr.m = mkM()\n\tvar t int = useM(mkM())\n\treturn t\n}\n"
					"func main() { _ = g(make(Rec)) }\n")
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the module verifies") }
	var fn @ir.Func = findFunc(m, "g")
	var temps @[]@ir.Instr = structTempSlots(fn)
	if len(temps) != 2 {
		return fail("two slots: the replaced field's, and the argument's copy, mkM's result's home")
	}
	var copied bool = false
	var released bool = false
	for i := 0; i < len(temps); i++ {
		var s int = temps[i].Scope
		if s == 0 || countScopeEnds(fn, s) != 1 { continue }
		if endsAfter(fn, s, "useM") {
			copied = dtorTakes(fn, temps[i])
		} else if endAfterCall(fn, s, "__dtor_1M") {
			released = true
		}
	}
	if !copied { return fail("the argument's copy ends after the call, destroyed where it is") }
	if !released { return fail("the replaced field's slot ends right after its dtor") }
	return ""
}
