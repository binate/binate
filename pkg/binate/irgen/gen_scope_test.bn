package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_scope.bn.  noParams / noResults / fail are shared ir test
// helpers.

// scopeTestCtx returns a context over a fresh function and its entry block.
func scopeTestCtx() (@GenContext, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	return ctx, b
}

// addManagedVar declares a managed-pointer local named name in the innermost
// scope and returns its slot.
func addManagedVar(ctx @GenContext, b @ir.Block, name *[]readonly char) @ir.Instr {
	var typ @types.Type = types.MakeManagedPtrType(types.TypInt())
	var slot @ir.Instr = irbuild.EmitAlloc(b, typ)
	var vs VarSlot
	vs.Name = name
	vs.Ptr = slot
	vs.Typ = typ
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, vs)
	return slot
}

// loadOrder returns the slots the loads emitted into b (from index from on)
// read, in emission order — the order a release sequence visits its locals.
func loadOrder(b @ir.Block, from int) @[]@ir.Instr {
	var out @[]@ir.Instr
	for i := from; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == iropcode.OP_LOAD && len(b.Instrs[i].Args) > 0 {
			out = slices.Append[@ir.Instr](out, b.Instrs[i].Args[0])
		}
	}
	return out
}

// openScope records the current end of ctx.Vars; closeScope pops the scope and
// drops its variables.
func TestOpenCloseScopeTracksVarStart() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	addManagedVar(ctx, b, "outer")
	openScope(ctx)
	if len(ctx.Scopes) != 1 || ctx.Scopes[0].VarStart != 1 {
		return fail("openScope should record the current end of ctx.Vars")
	}
	addManagedVar(ctx, b, "inner")
	closeScope(ctx, b, false)
	if len(ctx.Scopes) != 0 {
		return fail("closeScope should pop the scope")
	}
	if len(ctx.Vars) != 1 {
		return fail("closeScope should drop the scope's variables only")
	}
	return ""
}

// A fall-through close releases the scope's managed locals; a terminated close
// (release false) emits nothing.
func TestCloseScopeReleasesOnFallThroughOnly() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	openScope(ctx)
	addManagedVar(ctx, b, "x")
	var before int = len(b.Instrs)
	closeScope(ctx, b, false)
	if len(b.Instrs) != before {
		return fail("a terminated close should emit nothing")
	}
	openScope(ctx)
	var y @ir.Instr = addManagedVar(ctx, b, "y")
	before = len(b.Instrs)
	var out @ir.Block = closeScope(ctx, b, true)
	var loads @[]@ir.Instr = loadOrder(out, before)
	if len(loads) != 1 || !same(loads[0], y) {
		return fail("a fall-through close should release the scope's managed local")
	}
	return ""
}

// emitLeaveScopes releases the scopes a break leaves innermost first, then the
// variables between the target's floor and those scopes, and leaves ctx.Vars
// and ctx.Scopes as they were.
func TestEmitLeaveScopesInnermostFirst() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var kept @ir.Instr = addManagedVar(ctx, b, "kept")
	var gap @ir.Instr = addManagedVar(ctx, b, "gap")
	openScope(ctx)
	var outer @ir.Instr = addManagedVar(ctx, b, "outer")
	openScope(ctx)
	var inner @ir.Instr = addManagedVar(ctx, b, "inner")
	var before int = len(b.Instrs)
	var out @ir.Block = emitLeaveScopes(ctx, b, 0, 1)
	var loads @[]@ir.Instr = loadOrder(out, before)
	if len(loads) != 3 {
		return fail("emitLeaveScopes should release the two scopes and the gap, not below the floor")
	}
	if !same(loads[0], inner) || !same(loads[1], outer) || !same(loads[2], gap) {
		return fail("emitLeaveScopes should release innermost first, then the gap")
	}
	if same(loads[2], kept) {
		return fail("a variable below the floor must not be released")
	}
	if len(ctx.Vars) != 4 || len(ctx.Scopes) != 2 {
		return fail("emitLeaveScopes must not change ctx.Vars or ctx.Scopes")
	}
	return ""
}
