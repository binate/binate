package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_scope.bn.  noParams / noResults / fail are shared ir test
// helpers.

// scopeTestCtx returns a context over a fresh function and its entry block.
func scopeTestCtx() (@GenContext, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	return ctx, b
}

// addManagedVar declares a managed-pointer local named name in the innermost
// scope and returns its slot.
func addManagedVar(ctx @GenContext, b @ir.Block, name *[]readonly char) @ir.Instr {
	var typ @types.Type = types.MakeManagedPtrType(types.TypInt())
	var slot @ir.Instr = irbuild.EmitAlloc(b, typ)
	var vs VarSlot
	vs.Name = name
	vs.Ptr = slot
	vs.Typ = typ
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, vs)
	return slot
}

// loadOrder returns the slots the loads emitted into b (from index from on)
// read, in emission order — the order a release sequence visits its locals.
func loadOrder(b @ir.Block, from int) @[]@ir.Instr {
	var out @[]@ir.Instr
	for i := from; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == iropcode.OP_LOAD && len(b.Instrs[i].Args) > 0 {
			out = slices.Append[@ir.Instr](out, b.Instrs[i].Args[0])
		}
	}
	return out
}

// openScope records the current end of ctx.Vars; closeScope pops the scope and
// drops its variables.
func TestOpenCloseScopeTracksVarStart() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	addManagedVar(ctx, b, "outer")
	openScope(ctx)
	if len(ctx.Scopes) != 1 || ctx.Scopes[0].VarStart != 1 {
		return fail("openScope should record the current end of ctx.Vars")
	}
	addManagedVar(ctx, b, "inner")
	closeScope(ctx, b, false)
	if len(ctx.Scopes) != 0 {
		return fail("closeScope should pop the scope")
	}
	if len(ctx.Vars) != 1 {
		return fail("closeScope should drop the scope's variables only")
	}
	return ""
}

// A fall-through close releases the scope's managed locals; a terminated close
// (release false) emits nothing.
func TestCloseScopeReleasesOnFallThroughOnly() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	openScope(ctx)
	addManagedVar(ctx, b, "x")
	var before int = len(b.Instrs)
	closeScope(ctx, b, false)
	if len(b.Instrs) != before {
		return fail("a terminated close should emit nothing")
	}
	openScope(ctx)
	var y @ir.Instr = addManagedVar(ctx, b, "y")
	before = len(b.Instrs)
	var out @ir.Block = closeScope(ctx, b, true)
	var loads @[]@ir.Instr = loadOrder(out, before)
	if len(loads) != 1 || !same(loads[0], y) {
		return fail("a fall-through close should release the scope's managed local")
	}
	return ""
}

// emitLeaveScopes releases the scopes a break leaves innermost first, then the
// variables between the target's floor and those scopes, and leaves ctx.Vars
// and ctx.Scopes as they were.
func TestEmitLeaveScopesInnermostFirst() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var kept @ir.Instr = addManagedVar(ctx, b, "kept")
	var gap @ir.Instr = addManagedVar(ctx, b, "gap")
	openScope(ctx)
	var outer @ir.Instr = addManagedVar(ctx, b, "outer")
	openScope(ctx)
	var inner @ir.Instr = addManagedVar(ctx, b, "inner")
	var before int = len(b.Instrs)
	var out @ir.Block = emitLeaveScopes(ctx, b, 0, 1)
	var loads @[]@ir.Instr = loadOrder(out, before)
	if len(loads) != 3 {
		return fail("emitLeaveScopes should release the two scopes and the gap, not below the floor")
	}
	if !same(loads[0], inner) || !same(loads[1], outer) || !same(loads[2], gap) {
		return fail("emitLeaveScopes should release innermost first, then the gap")
	}
	if same(loads[2], kept) {
		return fail("a variable below the floor must not be released")
	}
	if len(ctx.Vars) != 4 || len(ctx.Scopes) != 2 {
		return fail("emitLeaveScopes must not change ctx.Vars or ctx.Scopes")
	}
	return ""
}

// countScopeEnds counts fn's OP_SCOPE_ENDs of scope id (any scope when id is 0).
func countScopeEnds(fn @ir.Func, id int) int {
	var n int = 0
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op == iropcode.OP_SCOPE_END && (id == 0 || ins.Scope == id) { n = n + 1 }
		}
	}
	return n
}

// namedSlot returns fn's OP_ALLOC tagged name (a variable's slot), or nil.
func namedSlot(fn @ir.Func, name *[]readonly char) @ir.Instr {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op == iropcode.OP_ALLOC && seq(ins.StrVal, name) { return ins }
		}
	}
	var none @ir.Instr
	return none
}

// A named variable's slot takes the innermost scope's id, the scope taking one
// with its first slot; a second slot shares it, a nested scope gets its own, and a
// hidden (`.`) slot, a parameter's slot and a non-slot value keep scope 0.
func TestDefineVarStampsScope() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.TypInt()
	openScope(ctx)
	if ctx.Scopes[0].ID != 0 { return fail("a scope has no id before its first slot") }
	var x @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "x", x, it)
	var y @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "y", y, it)
	if x.Scope != 1 || y.Scope != 1 || ctx.Func.NumScopes != 1 { return fail("x and y share scope 1") }
	openScope(ctx)
	var z @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "z", z, it)
	if z.Scope != 2 { return fail("a nested scope's slot takes the next id") }
	var hidden @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, ".complit", hidden, it)
	var param @ir.Instr = irbuild.EmitAlloc(b, it)
	param.ParamIndex = 1
	defineVar(ctx, "p", param, it)
	var val @ir.Instr = irbuild.EmitConstInt(b, 3, it)
	defineVar(ctx, "v", val, it)
	if hidden.Scope != 0 || param.Scope != 0 || val.Scope != 0 {
		return fail("a hidden slot, a parameter's slot and a value keep scope 0")
	}
	return ""
}

// A fall-through close ends a stamped scope after its release; a terminated close
// and a scope with no stamped slot end nothing.
func TestCloseScopeEndsStampedScope() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.MakeManagedPtrType(types.TypInt())
	openScope(ctx)
	var x @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "x", x, it)
	var out @ir.Block = closeScope(ctx, b, true)
	var last @ir.Instr = out.Instrs[len(out.Instrs) - 1]
	if last.Op != iropcode.OP_SCOPE_END || last.Scope != x.Scope {
		return fail("a fall-through close ends x's scope last")
	}
	if len(loadOrder(out, 0)) != 1 { return fail("x is released before its scope ends") }
	openScope(ctx)
	defineVar(ctx, "y", irbuild.EmitAlloc(out, it), it)
	var n int = len(out.Instrs)
	closeScope(ctx, out, false)
	if len(out.Instrs) != n { return fail("a terminated close ends nothing") }
	openScope(ctx)
	defineVar(ctx, ".hidden", irbuild.EmitAlloc(out, it), it)
	n = len(out.Instrs)
	out = closeScope(ctx, out, true)
	for i := n; i < len(out.Instrs); i++ {
		if out.Instrs[i].Op == iropcode.OP_SCOPE_END {
			return fail("a scope with no stamped slot ends nothing")
		}
	}
	return ""
}

// emitLeaveScopes ends each scope it leaves after that scope's release.
func TestEmitLeaveScopesEndsEachScope() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	var it @types.Type = types.TypInt()
	openScope(ctx)
	var outer @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "outer", outer, it)
	openScope(ctx)
	var inner @ir.Instr = irbuild.EmitAlloc(b, it)
	defineVar(ctx, "inner", inner, it)
	var before int = len(b.Instrs)
	var out @ir.Block = emitLeaveScopes(ctx, b, 0, 0)
	var ends @[]int
	for i := before; i < len(out.Instrs); i++ {
		if out.Instrs[i].Op == iropcode.OP_SCOPE_END {
			ends = slices.Append[int](ends, out.Instrs[i].Scope)
		}
	}
	if len(ends) != 2 || ends[0] != inner.Scope || ends[1] != outer.Scope {
		return fail("emitLeaveScopes ends the inner scope, then the outer")
	}
	return ""
}

// Through IR-gen: a loop body's variable is ended on the fall-through, on a
// `continue` and on a `break`; the loop's own variable where the loop exits; a
// range loop's per-iteration variable in its post and break blocks.  Every id
// verifies.
func TestScopeEndsThroughLoops() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(s *[]int) int {\n"
					"\tvar t int\n"
					"\tfor i := 0; i < 3; i++ {\n"
					"\t\tvar x int = i\n"
					"\t\tif x == 1 { continue }\n"
					"\t\tif x == 2 { break }\n"
					"\t\tt = t + x\n"
					"\t}\n"
					"\tfor v in s {\n"
					"\t\tif v == 9 { break }\n"
					"\t\tt = t + v\n"
					"\t}\n"
					"\treturn t\n"
					"}\n"
					"func main() {\n\tvar s *[]int\n\t_ = f(s)\n}\n")
	var fn @ir.Func = findFunc(m, "f")
	var x @ir.Instr = namedSlot(fn, "x")
	var i @ir.Instr = namedSlot(fn, "i")
	var v @ir.Instr = namedSlot(fn, "v")
	if x == nil || i == nil || v == nil { return fail("setup: x, i and v have slots") }
	if x.Scope == 0 || i.Scope == 0 || v.Scope == 0 { return fail("x, i and v carry scopes") }
	if x.Scope == i.Scope || v.Scope == i.Scope {
		return fail("x, i and v are in scopes of their own")
	}
	if countScopeEnds(fn, x.Scope) != 3 {
		return fail("x's scope ends on the fall-through, continue and break")
	}
	if countScopeEnds(fn, i.Scope) != 1 { return fail("i's scope ends once, where the loop exits") }
	if countScopeEnds(fn, v.Scope) != 2 {
		return fail("v's scope ends in the post block and on the break")
	}
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the module must verify") }
	return ""
}

// endsAfter reports whether fn has an OP_SCOPE_END of scope s that comes after an
// OP_CALL to a name ending in callee in the same block.
func endsAfter(fn @ir.Func, s int, callee *[]readonly char) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		var called bool = false
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op == iropcode.OP_CALL && hasSuffix(ins.StrVal, callee) { called = true }
			if called && ins.Op == iropcode.OP_SCOPE_END && ins.Scope == s { return true }
		}
	}
	return false
}

// hasSuffix reports whether s ends in suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	return seq(s[len(s) - len(suffix):], suffix)
}

// Through IR-gen: a deferred block that reads a variable runs before its scope
// ends; a switch case's and a type switch's binder variables are ended; a parallel
// `:=` stamps its variables; a return with a deferred block pending ends the
// scopes it leaves.  Every id verifies.
func TestScopeEndsThroughOtherConstructs() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func sink(v int) {}\n"
					"interface I { foo() }\n"
					"type T struct { n int }\n"
					"func (t *T) foo() { }\n"
					"impl *T : I\n"
					"func f(k int, a *I) int {\n"
					"\tvar d int = k\n"
					"\tdefer { sink(d) }\n"
					"\tswitch k {\n"
					"\tcase 1:\n"
					"\t\tvar c int = 2\n"
					"\t\tsink(c)\n"
					"\t}\n"
					"\tswitch v := a.(type) {\n"
					"\tcase *T:\n"
					"\t\tsink(v.n)\n"
					"\t}\n"
					"\tp, q := k, k + 1\n"
					"\treturn p + q\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "f")
	var d @ir.Instr = namedSlot(fn, "d")
	var c @ir.Instr = namedSlot(fn, "c")
	var v @ir.Instr = namedSlot(fn, "v")
	var p @ir.Instr = namedSlot(fn, "p")
	var q @ir.Instr = namedSlot(fn, "q")
	if d == nil || c == nil || v == nil || p == nil || q == nil {
		return fail("setup: every variable has a slot")
	}
	if d.Scope == 0 || c.Scope == 0 || v.Scope == 0 { return fail("d, c and v carry scopes") }
	if p.Scope == 0 || q.Scope != p.Scope {
		return fail("a parallel := stamps both variables, in one scope")
	}
	if !endsAfter(fn, d.Scope, "sink") {
		return fail("d's scope ends after the deferred block reads it")
	}
	if countScopeEnds(fn, c.Scope) == 0 || countScopeEnds(fn, v.Scope) == 0 {
		return fail("a case's and a type-switch binder's scopes end")
	}
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the module must verify") }
	return ""
}

// A range loop over managed values releases the per-iteration value before its
// scope ends, in the post block and on a break.
func TestRangeScopeEndFollowsRelease() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type T struct { n int }\n"
					"func f(s *[]@T) int {\n"
					"\tvar t int\n"
					"\tfor v in s {\n"
					"\t\tif v.n == 9 { break }\n"
					"\t\tt = t + v.n\n"
					"\t}\n"
					"\treturn t\n"
					"}\n"
					"func main() {\n"
					"\tvar s *[]@T\n"
					"\t_ = f(s)\n"
					"}\n")
	var fn @ir.Func = findFunc(m, "f")
	var v @ir.Instr = namedSlot(fn, "v")
	if v == nil || v.Scope == 0 { return fail("setup: v carries a scope") }
	var ended int = 0
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		var released bool = false
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op == iropcode.OP_REFDEC { released = true }
			if ins.Op == iropcode.OP_SCOPE_END && ins.Scope == v.Scope {
				if !released { return fail("v's scope ends only after v is released") }
				ended = ended + 1
			}
		}
	}
	if ended != 2 { return fail("v's scope ends in the post block and on the break") }
	return ""
}
