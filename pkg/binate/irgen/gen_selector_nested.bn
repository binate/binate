package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/types"

// genNestedSelectorRead reads the field `e.Name` of a nested selector — e.X is
// itself a selector (`r.max.x`, `list.next.val`, `mk[int](&b).sub.v`) — or
// returns nil when it cannot resolve that shape (genSelector then falls through
// to its remaining arms).  The inner selector is a managed or raw pointer to a
// struct (loaded, then read through) or a struct (addressed in place with
// genSelectorPtr).  It returns the block it ends in along with the value: a
// type-assertion further down the chain splits the block.
func genNestedSelectorRead(ctx @GenContext, b @ir.Block, e @ast.Expr) (@ir.Instr, @ir.Block) {
	var innerTyp @types.Type = types.StripWrappers(getSelectorType(ctx, e.X))
	// Case 1a: inner selector returns a managed pointer (e.g., list.next is @Node)
	// Need to load the managed ptr value, then deref and access field
	if isManagedPtrToStruct(innerTyp) {
		var mptr @ir.Instr = genSelector(ctx, b, e.X)
		// Re-sync: an assert further down (`x.(S).mgdField.deeper`) splits the
		// block inside genSelector (the MISS-abort branch), so the GEP+load below
		// must emit into the HIT continuation.  A no-op for non-splitting bases.
		b = ctx.CurBlock
		var structTyp @types.Type = types.StripWrappers(innerTyp.Elem)
		var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
		if si >= 0 {
			var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
			var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
			emitNilCheckIfEnabled(ctx, b, mptr)
			var fieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, mptr, idx, ftyp)
			return irbuild.EmitLoad(b, fieldPtr, ftyp), b
		}
	}
	// Case 1b: inner selector returns a raw pointer (e.g., o.RawRef is *Node)
	if isRawPtrToStruct(innerTyp) {
		var rptr @ir.Instr = genSelector(ctx, b, e.X)
		// Re-sync (see Case 1a): an assert base splits the block.
		b = ctx.CurBlock
		var structTyp @types.Type = types.StripWrappers(innerTyp.Elem)
		var si int = lookupStructIdx(ctx.Gc, structTyp.Name)
		if si >= 0 {
			var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
			var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
			emitNilCheckIfEnabled(ctx, b, rptr)
			var fieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, rptr, idx, ftyp)
			return irbuild.EmitLoad(b, fieldPtr, ftyp), b
		}
	}
	// Case 2: inner selector returns a struct (e.g., r.max is Point)
	// forDeref=true: this is a field READ (the field is loaded below).
	var innerPtr @ir.Instr = genSelectorPtr(ctx, b, e.X, true)
	// Re-sync: a type-assertion base (`x.(S).inner.leaf`) splits the block inside
	// genSelectorPtr (the assert's MISS-abort branch), so the GEP+load below must
	// emit into the HIT continuation, not the stale pre-branch block (else the
	// load fails to dominate its use).  A no-op for non-splitting bases.
	b = ctx.CurBlock
	if innerPtr != nil {
		// A base getSelectorType cannot type (a generic call's or generic
		// method call's result): the inner field's type is the pointee of the
		// field pointer just produced — a struct read in place, or a pointer to
		// a struct loaded through.
		if innerTyp == nil {
			innerTyp = selectorPtrPointee(innerPtr)
			if isManagedPtrToStruct(innerTyp) || isRawPtrToStruct(innerTyp) {
				var p @ir.Instr = irbuild.EmitLoad(b, innerPtr, innerTyp)
				var pst @types.Type = types.StripWrappers(types.StripWrappers(innerTyp).Elem)
				var psi int = lookupStructIdx(ctx.Gc, pst.Name)
				if psi >= 0 {
					var pidx int = lookupFieldIndex(ctx.Gc, psi, e.Name)
					var pftyp @types.Type = lookupFieldType(ctx.Gc, psi, e.Name)
					emitNilCheckIfEnabled(ctx, b, p)
					var pfieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, p, pidx, pftyp)
					return irbuild.EmitLoad(b, pfieldPtr, pftyp), b
				}
			}
		}
		if innerTyp != nil && innerTyp.Kind == types.TYP_STRUCT {
			var si int = lookupStructIdx(ctx.Gc, innerTyp.Name)
			if si >= 0 {
				var idx int = lookupFieldIndex(ctx.Gc, si, e.Name)
				var ftyp @types.Type = lookupFieldType(ctx.Gc, si, e.Name)
				var fieldPtr @ir.Instr = irbuild.EmitGetFieldPtr(b, innerPtr, idx, ftyp)
				return irbuild.EmitLoad(b, fieldPtr, ftyp), b
			}
		}
	}
	return nil, b
}
