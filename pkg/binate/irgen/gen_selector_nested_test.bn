package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Tests for gen_selector_nested.bn: reading a field of a nested selector.

// A nested read (`r.max.x`) addresses the inner struct field in place and reads
// the outer field through it; one whose inner selector's base is a generic
// method call's or generic call's result (`b.Me().sub.v`, `mk[int](&b).sub.v`)
// is typed from the inner field pointer instead of falling through to the
// unresolved-selector panic.
func TestGenNestedSelectorRead() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"test\"\n"
					"type In struct { v int }\n"
					"type Pt struct { x int; y int }\n"
					"type R struct { max Pt }\n"
					"type Box[T any] struct { t T; sub In }\n"
					"func (b *Box[T]) Me() *Box[T] { return b }\n"
					"func mk[T any](b *Box[T]) *Box[T] { return b }\n"
					"func plain(r R) int { return r.max.x }\n"
					"func meth() int { var b Box[int]; return b.Me().sub.v }\n"
					"func call() int { var b Box[int]; return mk[int](&b).sub.v }\n")
	var names @[]@[]char = @[]@[]char{"plain", "meth", "call"}
	for i := 0; i < len(names); i++ {
		var fn @ir.Func = findFunc(m, names[i])
		if fn == nil { return fail(buf.Concat("missing function ", names[i])) }
		if hasCallTo(fn, "Panic") {
			return fail(
					buf.Concat("a nested selector read must not reach the unresolved-selector panic in ",
							names[i]))
		}
		if countOp(fn, iropcode.OP_GET_FIELD_PTR) < 2 {
			return fail(buf.Concat("a nested selector read must address both fields in ", names[i]))
		}
	}
	return ""
}
