package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Nested field read off a composite rvalue (`Line{...}.p.x`) routes through
// genSelectorPtr's composite-base arm; it must emit field pointers rather
// than falling through to nil (which read 0).
func TestGenSelectorPtrNestedCompositeField() testing.TestResult {
	var src @[]char = buf.CopyStr(
			"package \"test\"\n"
					"type Point struct {\n\tx int\n\ty int\n}\n"
					"type Line struct {\n\tp Point\n\tq Point\n}\n"
					"func main() {\n\t_ = Line{p: Point{x: 11, y: 12}, q: Point{x: 0, y: 0}}.p.x\n}\n")
	var m @ir.Module = genFromSource(src)
	var mainFn @ir.Func = findFunc(m, "main")
	if mainFn == nil { return fail("expected main func") }
	if countOp(mainFn, iropcode.OP_GET_FIELD_PTR) < 2 {
		return fail("nested composite-rvalue field read must emit GET_FIELD_PTR")
	}
	return ""
}

// A plain field-assignment lvalue (`p.x = 5`) is genSelectorPtr's primary
// use; it must produce a field pointer to store through.
func TestGenSelectorPtrFieldAssign() testing.TestResult {
	var src @[]char = buf.CopyStr(
			"package \"test\"\n"
					"type Point struct {\n\tx int\n\ty int\n}\n"
					"func main() {\n\tvar p Point = Point{x: 1, y: 2}\n\tp.x = 5\n\t_ = p.x\n}\n")
	var m @ir.Module = genFromSource(src)
	var mainFn @ir.Func = findFunc(m, "main")
	if mainFn == nil { return fail("expected main func") }
	if countOp(mainFn, iropcode.OP_GET_FIELD_PTR) < 1 {
		return fail("field assignment must emit GET_FIELD_PTR")
	}
	return ""
}

// An address-of base (`(&s).x`) is s's own storage: a store, a nested-field
// store and an element store all go through field pointers off s's address,
// and none falls through to the unresolved-selector panic — also when the
// pointee is a named type over the struct (`type T2 S`), through `&t` or `*p`.
func TestGenSelectorPtrAddressOfBase() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type In struct { v int }\n"
					"type S struct { x int; m [3]int; sub In }\n"
					"type T2 S\n"
					"func st() { var s S; (&s).x = 9; _ = s }\n"
					"func named() { var t T2; (&t).x = 9; _ = t }\n"
					"func derefNamed(p *T2) { (*p).x = 9 }\n"
					"func nested() { var s S; (&s).sub.v = 9; _ = s }\n"
					"func elem() { var s S; (&s).m[1] = 9; _ = s }\n"
					"func rd() int { var s S; return (&s).sub.v }\n")
	var names @[]@[]char = @[]@[]char{"st", "nested", "elem", "rd", "named", "derefNamed"}
	for i := 0; i < len(names); i++ {
		var fn @ir.Func = findFunc(m, names[i])
		if fn == nil { return fail(buf.Concat("missing function ", names[i])) }
		if hasCallTo(fn, "Panic") {
			return fail(
					buf.Concat("a selector on &s must not reach the unresolved-selector panic in ", names[i]))
		}
		if countOp(fn, iropcode.OP_GET_FIELD_PTR) < 1 {
			return fail(buf.Concat("a selector on &s must address the field in place in ", names[i]))
		}
	}
	if countOp(findFunc(m, "nested"), iropcode.OP_GET_FIELD_PTR) < 2 {
		return fail("(&s).sub.v must address sub, then v, in place")
	}
	return ""
}

// A read or a store through an address-of base goes through the object, so
// under opt-in nil checking a pointer the base is reached through is checked
// (`(&p.sub).v` checks p, as `p.sub.v` does); taking the field's address
// (`&(&p.sub).v`) touches no memory and checks nothing.
func TestGenSelectorAddressOfBaseNilChecks() testing.TestResult {
	var m @ir.Module = genPkgNilChecks(
			"package \"test\"\n"
					"type In struct { v int }\n"
					"type S struct { a int; sub In }\n"
					"func rd(p *S) int { return (&p.sub).v }\n"
					"func wr(p *S) { (&p.sub).v = 3 }\n"
					"func ad(p *S) *int { return &(&p.sub).v }\n")
	if countOp(findFunc(m, "rd"), iropcode.OP_NIL_CHECK) < 1 {
		return fail("a read of (&p.sub).v must nil-check p")
	}
	if countOp(findFunc(m, "wr"), iropcode.OP_NIL_CHECK) < 1 {
		return fail("a store to (&p.sub).v must nil-check p")
	}
	if countOp(findFunc(m, "ad"), iropcode.OP_NIL_CHECK) != 0 {
		return fail("&(&p.sub).v is an address computation and must not nil-check")
	}
	return ""
}
