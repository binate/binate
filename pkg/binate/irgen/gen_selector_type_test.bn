package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

import "pkg/binate/ast"
import "pkg/binate/types"
import "pkg/builtins/testing"

// getSelectorType must resolve a package-qualified imported var
// (`pkg.X`) to the var's declared type — otherwise a nested lvalue
// store (`pkg.X.field = v`) is silently dropped because genSelectorPtr
// can't determine the inner type (conformance 561 covers the full
// write end-to-end).  A getSelectorType that resolves the import
// alias `pkg` as a (nonexistent) variable returns nil.
func TestGetSelectorTypeQualifiedImportedVar() testing.TestResult {
	var m @ir.Module = testInitModule("\"main\"")
	var src *[]readonly char = "package \"pkg/store\"\ntype Node struct {\n\tV int\n}\nvar G @Node\n"
	var file @ast.File = checkedBni(m, "pkg/store", src)
	// Both import-registration passes: RegisterImport records the alias
	// + struct names; registerImportFieldsAndFuncs (keyed by the package
	// PATH) registers struct fields and the extern `var G` into m.GlobalVars.
	RegisterImport("store", "pkg/store", file, NewGenCtx(m))
	registerImportFieldsAndFuncs(NewGenCtx(m), "pkg/store", file, m, true)

	var prog @ast.File = checkedSource(m,
			"package \"main\"\nimport \"pkg/store\"\nvar x int = store.G.V\n")
	var ctx @GenContext = make(GenContext)
	// getSelectorType resolves the imported var through ctx.Gc.Mod's
	// GlobalVars table, so bind the context to the module the import
	// registration populated.
	ctx.Gc = NewGenCtx(m)
	ctx.Checker = m.Checker

	// `store.G` resolves to the imported var's type, @Node (managed ptr).
	var x @ast.Expr = varInit(prog, "x")
	if x == nil || x.X == nil { return fail("store.G.V must be found") }
	var tG @types.Type = getSelectorType(ctx, x.X)
	if tG == nil {
		return fail("getSelectorType(store.G) returned nil (561 regression)")
	}
	if tG.Kind != types.TYP_MANAGED_PTR {
		return fail("expected store.G to resolve to a managed ptr (@Node)")
	}
	if tG.Elem == nil || tG.Elem.Kind != types.TYP_STRUCT {
		return fail("expected store.G's managed-ptr type to point to the struct Node")
	}
	return ""
}

// `&x` types as a pointer to x's type, so a selector through it resolves x's
// fields (`(&s).sub` is In).
func TestGetSelectorTypeAddressOf() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type In struct { v int }\n"
					"type S struct { sub In }\n"
					"func f() int { var s S; return (&s).sub.v }\n")
	var fn @ir.Func = findFunc(m, "f")
	if fn == nil { return fail("missing function f") }
	if countOp(fn, iropcode.OP_GET_FIELD_PTR) != 2 {
		return fail("(&s).sub.v must resolve sub's struct type and address v through it")
	}
	return ""
}

// A generic instance named as a method expression's base (`mp.Box[int]` in
// `mp.Box[int].Get`) is a type, so it has no value type -- also where its head's
// spelling `mp.Box` names a variable of another package in the module's
// alias map (the single-segment package mp, beside pkg/mp).
func TestGetSelectorTypeOfAGenericInstanceIsNone() testing.TestResult {
	var m @ir.Module = testInitModule("\"main\"")
	var mp @ast.File = checkedBni(m, "mp", "package \"mp\"\nvar Box [3]int\n")
	_ = checkedBni(m, "pkg/mp", "package \"pkg/mp\"\ntype Box[T any] struct {\n\tval T\n}\n"
			"func (b *Box[T]) Get() T {\n\treturn b.val\n}\n")
	var mainFile @ast.File = checkedSource(m, "package \"main\"\nimport M \"mp\"\nimport \"pkg/mp\"\n"
			"func f(bx *mp.Box[int]) int {\n\treturn mp.Box[int].Get(bx) + M.Box[0]\n}\n")
	var gc @GenCtx = NewGenCtx(m)
	RegisterImport("mp", "mp", mp, gc)
	registerImportFieldsAndFuncs(gc, "mp", mp, m, true)
	var ctx @GenContext = make(GenContext)
	ctx.Gc = gc
	ctx.Checker = m.Checker
	var sum @ast.Expr = mainFile.Decls[0].Body.Stmts[0].Exprs[0]
	var inst @ast.Expr = sum.X.X.X
	if inst.Kind != ast.EXPR_INSTANTIATE_OR_INDEX { return fail("expected mp.Box[int]") }
	if getSelectorType(ctx, inst) != nil {
		return fail("mp.Box[int] is a type, not a value of mp's Box")
	}
	return ""
}
