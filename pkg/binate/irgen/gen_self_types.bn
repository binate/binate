package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/stdx/slices"

// RegisterSelfTypes registers type definitions from a package's own
// .bni file: struct types, type aliases, and constants that are
// declared in the .bni but not redefined in the .bn files.  The
// .bn-side compiler still has to see them so cross-file references
// inside the same package resolve at IR-gen.
func RegisterSelfTypes(c @check.Checker, bniFile @ast.File, gc @GenCtx) {
	bniFile = normalizeFileDecls(bniFile)
	if bniFile == nil { return }

	// gc is the threaded per-compilation context; gc.Mod is the module
	// GeneratePackage will fill — RegisterSelfTypes runs just before it on
	// that same module — so self structs/aliases land in the module's own
	// per-module tables.  gc.Mod.PkgPath isn't set until GeneratePackage, so
	// set gc.PkgPath to the .bni's package name (the SAME fully-qualified
	// value GeneratePackage will use) for the duration of this pass — keeping
	// qualifyForCurrentModule / lookupStructIdx consistent — then restore it.
	var savedPkgPath @[]char = gc.PkgPath
	gc.PkgPath = mangle.PkgPathFromQuoted(bniFile.PkgName)
	// Install the .bni's OWN imports so a cross-package alias/field TARGET
	// (`type X = sys.Y`, where `sys` is this file's source alias) resolves to the
	// target's full package path — without it the target reads as the bare `sys.Y`,
	// misses lookupTypeAlias, and falls to resolveTypeExpr's TypInt() scalar
	// fallback, mis-lowering the self type as i64.  Mirrors the per-file
	// pushFileImports in RegisterImports / RegisterStructTypes.
	var selfSnap AliasMapSnapshot = pushFileImports(gc.Mod, bniFile)

	// Pass 1: register struct type names (so self-references resolve).  A
	// generic struct declaration registers nothing: only its instantiations are
	// structs (ensureInstantiatedStruct).
	for i := 0; i < len(bniFile.Decls); i++ {
		var d @ast.Decl = bniFile.Decls[i]
		if isStructTypeDecl(d) && len(d.TypeParams) == 0 {
			if lookupStructIdx(gc, d.Name) < 0 {
				var qn @[]char = qualifyForCurrentModule(gc, d.Name)
				var ms irsym.ModuleStruct
				ms.Name = qn
				var noFields3 @[]@types.Field
				ms.Typ = types.MakeStructType(qn, noFields3)
				gc.Mod.Structs = slices.Append[irsym.ModuleStruct](gc.Mod.Structs, ms)
			}
		} else if d.Kind == ast.DECL_TYPE && d.IsForward && len(d.TypeParams) == 0 {
			registerSelfOpaque(c, gc, d)
		}
	}

	// Type aliases and named distinct non-struct types (the alias `type X =
	// int`, the distinct `type Type int`), in dependency order
	// (registerModuleTypeDecl), before any struct field or const below is
	// resolved through one.
	var noFiles @[]@ast.File
	var noSnap AliasMapSnapshot
	for i := 0; i < len(bniFile.Decls); i++ {
		preRegisterNamedTypeDecl(gc, qualifyForCurrentModule(gc, bniFile.Decls[i].Name), bniFile.Decls[i])
	}
	for i := 0; i < len(bniFile.Decls); i++ {
		if isNonStructTypeDecl(bniFile.Decls[i]) {
			var noNames @[]@[]char
			registerModuleTypeDecl(gc, noFiles, bniFile, false, noSnap, bniFile.Decls[i], noNames)
		}
	}

	// Pass 2: populate struct fields and register constants
	for i := 0; i < len(bniFile.Decls); i++ {
		var d @ast.Decl = bniFile.Decls[i]

		// Struct field population.  A generic struct decl is skipped — its fields
		// stay in AST form until an instantiation resolves them under the right
		// type-param context (ensureInstantiatedStruct); resolving them here with no
		// binders would spuriously instantiate a bogus all-`int` version of any
		// generic-typed field.  Mirrors gen_module's second pass and gen_import.
		if isStructTypeDecl(d) {
			if len(d.TypeParams) > 0 {
				continue
			}
			var si int = lookupStructIdx(gc, d.Name)
			if si >= 0 && len(d.TypeRef.Fields) > 0 {
				var styp @types.Type = gc.Mod.Structs[si].Typ
				if len(styp.Fields) == 0 {
					var fields @[]@types.Field
					for j := 0; j < len(d.TypeRef.Fields); j++ {
						var f @types.Field = make(types.Field)
						f.Name = d.TypeRef.Fields[j].Name
						f.Type = resolveTypeExpr(gc, d.TypeRef.Fields[j].Type)
						fields = slices.Append[@types.Field](fields, f)
					}
					styp.Fields = fields
					gc.Mod.Structs[si].Fields = fields
				}
			}
		}

		// Constants
		if d.Kind == ast.DECL_CONST {
			genConst(gc, c, d)
		}
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(gc, c, d)
		}
	}
	popFileImports(gc.Mod, selfSnap)
	gc.PkgPath = savedPkgPath
}

// opaqueDefinedAsStruct reports whether the package pkgPath's opaque type name is
// defined as a struct literal (`type X struct { … }`), per the checker: it fills
// the forward declaration's named type with the struct, which carries X's own
// qualified name — a definition over another type (`type X S`, `type X int`)
// leaves something else there.  When the checker does not know (no checker, no
// definition), a struct is assumed.
func opaqueDefinedAsStruct(c @check.Checker, pkgPath *[]readonly char, name *[]readonly char) bool {
	if c == nil { return true }
	var t @types.Type = c.PackageType(pkgPath, name)
	if t == nil || t.Kind != types.TYP_NAMED || t.Underlying == nil { return true }
	var u @types.Type = t.Underlying
	return u.Kind == types.TYP_STRUCT &&
			irutil.Streq(u.Name, types.QualifyName(buf.CopyStr(pkgPath), buf.CopyStr(name)))
}

// registerSelfOpaque registers the package's opaque-EXPORTED type d — `type X`
// with no body in its .bni, defined in a .bn — stamped opaque-exported, or stamps
// the entry an earlier pass already registered from the .bn's definition.  The
// stamp is the opaque-export guarantee: X's public dtor is emitted even when X
// needs no destruction (gen_dtor_emit for a struct, generateOpaqueNamedDtors
// otherwise), so an importer that sees only the .bni can always release an `@X`
// through it by name (emitManagedPtrRefDec's opaque arm) instead of freeing it
// with no dtor and leaking what it holds.  X not yet registered is pre-registered:
// as a struct for a struct-literal definition (GeneratePackage's field pass fills
// its fields), else as a named type that the .bn's definition fills in place
// (isPendingNamedType) — so what refers to X before then refers to the same type.
func registerSelfOpaque(c @check.Checker, gc @GenCtx, d @ast.Decl) {
	var pkg @[]char = buf.CopyStr(gc.PkgPath)
	var si int = lookupStructIdx(gc, d.Name)
	if si >= 0 {
		gc.Mod.Structs[si].Typ.OpaqueExportPkg = pkg
		return
	}
	var registered @types.Type = lookupTypeAlias(gc, d.Name)
	if registered != nil {
		if registered.Kind == types.TYP_NAMED { registered.OpaqueExportPkg = pkg }
		return
	}
	var qn @[]char = qualifyForCurrentModule(gc, d.Name)
	if opaqueDefinedAsStruct(c, gc.PkgPath, d.Name) {
		var ms irsym.ModuleStruct
		ms.Name = qn
		var noFields @[]@types.Field
		ms.Typ = types.MakeStructType(qn, noFields)
		ms.Typ.OpaqueExportPkg = pkg
		gc.Mod.Structs = slices.Append[irsym.ModuleStruct](gc.Mod.Structs, ms)
		return
	}
	var ta irsym.ModuleTypeAlias
	ta.Name = qn
	ta.Typ = types.MakeNamedType(qn)
	ta.Typ.OpaqueExportPkg = pkg
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
}
