package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// RegisterSelfTypes covers the same shape registrations as
// RegisterImport, but for the package's OWN .bni file: the names are
// qualified by the package's own path (the module being generated) rather
// than resolved through an import alias, and a bare lookup finds them.
// gen_import_test.bn covers the import side.

// TestRegisterSelfTypesStruct verifies a struct type from a
// package's own .bni lands in the module's Structs table under its
// package-qualified name, found by a bare lookup, and gets its fields
// populated.
func TestRegisterSelfTypesStruct() testing.TestResult {
	var src *[]readonly char = "package \"pkg/self\"\ntype Pt struct {\n\tX int\n\tY int\n}\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	var m @ir.Module = ir.NewModule("test")
	RegisterSelfTypes(nil, file, NewGenCtx(m))

	// RegisterSelfTypes registers self-types qualified by the .bni's
	// package path, so look up with a matching gc.PkgPath on the same module.
	var gc @GenCtx = NewGenCtx(m)
	gc.PkgPath = "pkg/self"
	var si int = lookupStructIdx(gc, "Pt")
	if si < 0 { return fail("expected struct Pt registered as pkg/self.Pt") }
	if len(m.Structs[si].Fields) != 2 {
		return fail("expected 2 fields on Pt")
	}
	return ""
}

// TestRegisterSelfTypesAlias verifies a type alias from the
// package's own .bni lands in the module's TypeAliases table under its
// package-qualified name.
func TestRegisterSelfTypesAlias() testing.TestResult {
	var src *[]readonly char = "package \"pkg/self\"\ntype TokenKind = int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	var m @ir.Module = ir.NewModule("test")
	RegisterSelfTypes(nil, file, NewGenCtx(m))

	var found bool = false
	for i := 0; i < len(m.TypeAliases); i++ {
		if seq(m.TypeAliases[i].Name, "pkg/self.TokenKind") {
			found = true
		}
	}
	if !found { return fail("expected TokenKind alias under pkg/self.TokenKind") }
	return ""
}

// TestRegisterSelfTypesNamedOneIdentity verifies a named non-struct type of
// the package's own .bni is ONE type: the import pre-pass (RegisterStructTypes,
// run before the module's package path is known) registers it as
// `pkg/self.MyN`, and the package's own pass (RegisterSelfTypes) reuses that
// entry rather than adding a second TYP_NAMED under another name.  Two names
// would be two types — `H[MyN]` would split into two interface instances, the
// impl rows on only one of them.
func TestRegisterSelfTypesNamedOneIdentity() testing.TestResult {
	var src *[]readonly char = "package \"pkg/self\"\ntype MyN int\n"
	var p @parser.Parser = parser.NewInterface(strToBytes(src), "self.bni")
	var file @ast.File = p.ParseFile()

	var m @ir.Module = ir.NewModule("test")
	var gc @GenCtx = NewGenCtx(m)
	var aliases @[]@[]char = make_slice(@[]char, 1)
	aliases[0] = buf.CopyStr("pkg/self")
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("pkg/self")
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	RegisterStructTypes(aliases, paths, files, gc)
	RegisterSelfTypes(nil, file, gc)

	var n int = 0
	for i := 0; i < len(m.TypeAliases); i++ {
		if seq(m.TypeAliases[i].Name, "pkg/self.MyN") {
			n = n + 1
		} else if seq(m.TypeAliases[i].Name, "MyN") {
			return fail("MyN must not be registered under its bare name")
		}
	}
	if n != 1 { return fail("expected exactly one pkg/self.MyN entry") }
	var t @types.Type = lookupTypeAlias(gc, "pkg/self.MyN")
	if t == nil || t.Kind != types.TYP_NAMED || !seq(t.Name, "pkg/self.MyN") {
		return fail("MyN should be the TYP_NAMED pkg/self.MyN")
	}
	return ""
}

// TestRegisterSelfTypesNilBniFile verifies the guard for a nil
// bniFile (package with no .bni — only .bn source) returns
// silently rather than dereferencing nil.
func TestRegisterSelfTypesNilBniFile() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	RegisterSelfTypes(nil, nil, NewGenCtx(m))
	return ""
}
