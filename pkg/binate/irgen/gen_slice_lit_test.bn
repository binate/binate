package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for gen_slice_lit.bn — raw-slice and managed-slice composite literals.

// genManagedSliceLit must acquire each managed-aggregate slice element via
// __copy_ — `@[]Wrap{...}` had no needsStructCopy arm pre-fix.
func TestManagedSliceLitAggregateAcquires() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type Node struct { Val int }\n"
					"type Wrap struct { b @Node }\n"
					"func foo() {\n"
					"\tvar w Wrap\n\tw.b = make(Node)\n"
					"\tvar s @[]Wrap = @[]Wrap{w, w}\n\t_ = s\n}\n")
	var fn @ir.Func = funcByName(m, "foo")
	if fn == nil { return fail("foo not found") }
	if !hasCallTo(fn, "__copy_") {
		return fail("managed-slice literal of an aggregate must call __copy_")
	}
	return ""
}

// genManagedSliceLit must acquire an `@func` element (the arm it omitted) —
// without it a fresh closure element is freed at end of statement, a UAF on
// invoke.  Compare a two-element vs one-element @func slice literal: both
// build a managed slice (identical backing-refptr RefInc, which a no-slice
// baseline would NOT have — that masks the per-element acquire), so the delta
// isolates the per-element @func acquire.
func TestManagedSliceLitFuncElemAcquires() testing.TestResult {
	var two @ir.Module = genFromSource(
			"package \"test\"\n"
					"func foo(g @func(int) int) {\n"
					"\tvar s @[]@func(int) int = @[]@func(int) int{g, g}\n\t_ = s\n}\n")
	var one @ir.Module = genFromSource(
			"package \"test\"\n"
					"func foo(g @func(int) int) {\n"
					"\tvar s @[]@func(int) int = @[]@func(int) int{g}\n\t_ = s\n}\n")
	var f2 @ir.Func = funcByName(two, "foo")
	var f1 @ir.Func = funcByName(one, "foo")
	if f2 == nil { return fail("foo not found (two)") }
	if f1 == nil { return fail("foo not found (one)") }
	if countOpInFunc(f2, iropcode.OP_REFINC) <= countOpInFunc(f1, iropcode.OP_REFINC) {
		return fail("managed-slice literal must acquire each @func element")
	}
	return ""
}

// A raw-slice literal whose elements hold managed references owns them through
// a hidden backing slot allocated in the ENTRY block (zero-filled once per
// call) even when the literal sits in a loop body, and the scope exit re-zeroes
// it (an OP_CONST_NIL store into the slot) so the next iteration neither
// double-releases nor leaks.  A literal of plain elements keeps its backing
// alloca at the evaluation point.
func TestRawSliceLitManagedBackingIsOwnedEntrySlot() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\ntype Box struct {\n\tb @int\n}\n")
	cb.Write("func mk(v int) Box {\n\tvar x Box\n\tx.b = box(v)\n\treturn x\n}\n")
	cb.Write("func f() int {\n\tvar t int = 0\n\tfor i := 0; i < 2; i++ {\n")
	cb.Write("\t\tvar rq *[]readonly Box = *[]readonly Box{mk(i)}\n\t\tt = t + len(rq)\n\t}\n")
	cb.Write("\tvar ri *[]readonly int = *[]readonly int{1, 2}\n\treturn t + len(ri)\n}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var f @ir.Func = findFunc(m, "f")
	if f == nil { return fail("no func f") }
	var backing @ir.Instr = nil
	var entry @ir.Block = f.Blocks[0]
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @ir.Instr = entry.Instrs[i]
		if ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil && ins.TypeArg.Kind == types.TYP_ARRAY &&
				ins.TypeArg.NeedsDestruction() {
			backing = ins
		}
	}
	if backing == nil {
		return fail("managed raw-slice-literal backing should be allocated in the entry block")
	}
	var cleared bool = false
	var plainOutsideEntry bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for i := 0; i < len(blk.Instrs); i++ {
			var ins @ir.Instr = blk.Instrs[i]
			if ins.Op == iropcode.OP_STORE && len(ins.Args) == 2 && ins.Args[0] == backing &&
					ins.Args[1].Op == iropcode.OP_CONST_NIL {
				cleared = true
			}
			if bi > 0 && ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil &&
					ins.TypeArg.Kind == types.TYP_ARRAY && !ins.TypeArg.NeedsDestruction() {
				plainOutsideEntry = true
			}
		}
	}
	if !cleared { return fail("the owned backing should be re-zeroed at scope exit") }
	if !plainOutsideEntry {
		return fail("a plain-element raw-slice literal should keep its alloca at the evaluation point")
	}
	return ""
}

// A raw-slice literal in a package-level initializer gets a hidden module
// global as its backing (program lifetime), not an alloca in the module-init
// function, whose stack is dead once init returns.
func TestRawSliceLitPackageLevelBackingIsGlobal() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\nvar g *[]readonly int = *[]readonly int{1, 2, 3}\n")
	cb.Write("func main() {\n\t_ = g\n}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var found bool = false
	for i := 0; i < len(m.Globals); i++ {
		var t @types.Type = m.Globals[i].Typ
		if startsWithChars(m.Globals[i].Name, "__rawslice_backing_") && t != nil &&
				t.Kind == types.TYP_ARRAY && t.ArrayLen == 3 {
			found = true
		}
	}
	if !found {
		return fail("package-level raw-slice literal should get a hidden [3]int global backing")
	}
	var init @ir.Func = findFunc(m, "__init")
	if init == nil { return fail("no module-init function") }
	for bi := 0; bi < len(init.Blocks); bi++ {
		var blk @ir.Block = init.Blocks[bi]
		for i := 0; i < len(blk.Instrs); i++ {
			var ins @ir.Instr = blk.Instrs[i]
			if ins.Op == iropcode.OP_ALLOC && !ins.IsGlobalRef && ins.TypeArg != nil &&
					ins.TypeArg.Kind == types.TYP_ARRAY {
				return fail("module init should not stack-allocate the literal's backing")
			}
		}
	}
	return ""
}
