package "pkg/binate/irgen"

import "pkg/binate/ast"

// A package reaches IR-gen as ONE merged file — its .bni's declarations
// followed by every .bn's — but a declaration's package-qualified names
// (`dep.W`) mean what its OWN source file's imports say: two files of a
// package may bind one alias to different packages, and the merged file's
// import list binds an alias to the first file's package only.  So the drivers
// register every loaded package's source files (RegisterSourceFiles),
// declSourceFile maps a declaration back to its own file by position, and a
// pass over a merged file's declarations installs each one's own imports
// (declImports) before resolving it.  A declaration whose file is not
// registered resolves under the merged file's imports.

// RegisterSourceFiles records bni and files, skipping nil entries and files
// already recorded.
func RegisterSourceFiles(gc @GenCtx, bni @ast.File, files *[]@ast.File) {
	registerSourceFile(gc, bni)
	for i := 0; i < len(files); i++ {
		registerSourceFile(gc, files[i])
	}
}

// registerSourceFile records f unless it is nil or already recorded.  The index
// key borrows f.Pos.File, which f — kept in gc.SourceFiles — owns.
func registerSourceFile(gc @GenCtx, f @ast.File) {
	if f == nil { return }
	var found bool
	_, found = gc.SourceFileIndex.GetOrPut(f.Pos.File, gc.SourceFiles.Len())
	if !found { gc.SourceFiles.Push(f) }
}

// sourceFileIndex returns the index in gc.SourceFiles of the file parsed from
// path, or -1.
func sourceFileIndex(gc @GenCtx, path *[]readonly char) int {
	var i int
	var ok bool
	i, ok = gc.SourceFileIndex.Get(path)
	if !ok { return -1 }
	return i
}

// declSourceFile returns the registered source file d was parsed from, or
// merged — the merged file d was reached through — when that file is not
// registered.
func declSourceFile(gc @GenCtx, merged @ast.File, d @ast.Decl) @ast.File {
	if d == nil { return merged }
	var i int = sourceFileIndex(gc, d.Pos.File)
	if i < 0 { return merged }
	return gc.SourceFiles.Get(i)
}

// declImports scopes a pass over one merged file's declarations: begin saves
// the alias map, use installs a declaration's own file's imports over it (only
// when that file changes), end restores it.
type declImports struct {
	base   AliasMapSnapshot
	merged @ast.File
	cur    @ast.File
}

// beginDeclImports starts a pass over merged's declarations.
func beginDeclImports(gc @GenCtx, merged @ast.File) @declImports {
	var di @declImports = make(declImports)
	di.base = SaveAliasMapState(gc.Mod)
	di.merged = merged
	return di
}

// use installs the imports of d's own source file (declSourceFile) and returns
// that file.
func (di @declImports) use(gc @GenCtx, d @ast.Decl) @ast.File {
	var f @ast.File = declSourceFile(gc, di.merged, d)
	if di.cur != nil && same(di.cur, f) { return f }
	overlayFileImports(gc.Mod, di.base, f)
	di.cur = f
	return f
}

// end restores the alias map saved by beginDeclImports.
func (di @declImports) end(gc @GenCtx) {
	popFileImports(gc.Mod, di.base)
}
