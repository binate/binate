package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// perFileImportFixture returns pkg/x's two source files — a.bn binds `dep` to
// pkg/p1, b.bn to pkg/p2, each declaring `type T? = dep.W` — and their merged
// file (declarations concatenated, imports first-wins: dep is pkg/p1), with
// pkg/p1.W and pkg/p2.W registered in gc as distinct named types.
func perFileImportFixture(gc @GenCtx) (@ast.File, @ast.File, @ast.File) {
	var pa @parser.Parser = parser.New(
			strToBytes("package \"pkg/x\"\nimport dep \"pkg/p1\"\ntype TA = dep.W\n"), "x/a.bn")
	var a @ast.File = pa.ParseFile()
	var pb @parser.Parser = parser.New(
			strToBytes("package \"pkg/x\"\nimport dep \"pkg/p2\"\ntype TB = dep.W\n"), "x/b.bn")
	var b @ast.File = pb.ParseFile()
	var merged @ast.File = make(ast.File)
	merged.Pos = a.Pos
	merged.PkgName = a.PkgName
	merged.Imports = slices.Append[@ast.ImportSpec](a.Imports, b.Imports[0])
	merged.Decls = slices.Append[@ast.Decl](a.Decls, b.Decls[0])
	var w1 irsym.ModuleTypeAlias
	w1.Name = "pkg/p1.W"
	w1.Typ = types.MakeNamedType("pkg/p1.W")
	var w2 irsym.ModuleTypeAlias
	w2.Name = "pkg/p2.W"
	w2.Typ = types.MakeNamedType("pkg/p2.W")
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, w1)
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, w2)
	return a, b, merged
}

// registerFixture runs RegisterStructTypes over merged as package pkg/x.
func registerFixture(gc @GenCtx, merged @ast.File) {
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = "pkg/x"
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = merged
	RegisterStructTypes(paths, paths, files, gc)
}

// aliasTargetIs reports whether pkg/x's alias name resolves to the named type
// target.
func aliasTargetIs(gc @GenCtx, name *[]readonly char, target *[]readonly char) bool {
	var t @types.Type = lookupTypeAlias(gc, name)
	return t != nil && t.Kind == types.TYP_NAMED && seq(t.Name, target)
}

// With the package's source files registered, each declaration of the merged
// file resolves under its OWN file's imports: TB (b.bn) is pkg/p2.W although
// the merged imports bind dep to pkg/p1.
func TestRegisterStructTypesPerFileImports() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var a @ast.File
	var b @ast.File
	var merged @ast.File
	a, b, merged = perFileImportFixture(gc)
	var srcs @[]@ast.File = make_slice(@ast.File, 2)
	srcs[0] = a
	srcs[1] = b
	RegisterSourceFiles(gc, nil, srcs)
	registerFixture(gc, merged)
	if !aliasTargetIs(gc, "pkg/x.TA", "pkg/p1.W") { return fail("TA should be pkg/p1.W") }
	if !aliasTargetIs(gc, "pkg/x.TB", "pkg/p2.W") { return fail("TB should be pkg/p2.W") }
	return ""
}

// A declaration whose source file is not registered resolves under the merged
// file's imports.
func TestRegisterStructTypesUnregisteredFallsBackToMerged() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var merged @ast.File
	_, _, merged = perFileImportFixture(gc)
	registerFixture(gc, merged)
	if !aliasTargetIs(gc, "pkg/x.TB", "pkg/p1.W") {
		return fail("unregistered TB should follow merged's dep")
	}
	return ""
}

// declSourceFile maps a declaration to its registered source file by position;
// a file registered twice is recorded once.
func TestDeclSourceFile() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var a @ast.File
	var b @ast.File
	var merged @ast.File
	a, b, merged = perFileImportFixture(gc)
	var srcs @[]@ast.File = make_slice(@ast.File, 3)
	srcs[0] = a
	srcs[1] = b
	srcs[2] = a
	RegisterSourceFiles(gc, nil, srcs)
	if gc.SourceFiles.Len() != 2 { return fail("a file registered twice should be recorded once") }
	if !same(declSourceFile(gc, merged, merged.Decls[1]), b) {
		return fail("TB's file should be b.bn")
	}
	if !same(declSourceFile(gc, merged, merged.Decls[0]), a) {
		return fail("TA's file should be a.bn")
	}
	return ""
}
