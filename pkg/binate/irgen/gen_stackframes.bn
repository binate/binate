package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/types"

// tryEmitStackFrames recognizes the pkg/std/debug `_stack_frames(skip, into)`
// compiler intrinsic and, when matched, emits the OP_STACK_FRAMES op that
// captures the caller chain of the enclosing function (debug.Callers/Caller)
// into `into`.  It returns the emitted instruction, or nil when the call is not
// the intrinsic (so genCall falls through to an ordinary call).
//
// Matching: the fully-qualified `pkg/std/debug._stack_frames`, and the BARE
// `_stack_frames` ONLY while compiling pkg/std/debug itself (pkgPath gate) —
// where the sole caller lives.  The bare gate keeps a same-named function in any
// other package from being hijacked into the op.  `_stack_frames` has no
// linkable symbol; the .bni decl is a type-checking shape only.
func tryEmitStackFrames(b @ir.Block, pkgPath *[]readonly char, name *[]readonly char,
		args @[]@ir.Instr, resultTyp @types.Type) @ir.Instr {
	if irutil.Streq(name, "pkg/std/debug._stack_frames") ||
			(irutil.Streq(name, "_stack_frames") && irutil.Streq(pkgPath, "pkg/std/debug")) {
		if len(args) >= 2 {
			return b.EmitStackFrames(args[0], args[1], resultTyp)
		}
	}
	return nil
}
