package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"

// annotateBlockInstrs sets the Line field on all instructions in a block
// that don't already have a line number set.
func annotateBlockInstrs(b @ir.Block, line int) {
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Line == 0 {
			b.Instrs[i].Line = line
		}
	}
}

// ============================================================
// Statement generation
// ============================================================

// genBlock generates IR for a block statement as its own scope: on a fall-off
// exit the block's deferred blocks run and its managed locals are released
// (closeScope); an exit by `return` / `break` / `continue` did both before its
// jump.
func genBlock(ctx @GenContext, b @ir.Block, stmt @ast.Stmt) @ir.Block {
	if stmt.Kind == ast.STMT_BLOCK {
		// Per-statement import overlay for the synthetic package `__init` body:
		// its statements come from different files (each file's top-level var
		// initializers), so each must be lowered under ITS file's imports, not a
		// merged map (see GenCtx.InitOverlay*).  Capture and disable for nested
		// blocks (a single initializer's own statements share its file), and
		// only the outermost __init block switches per statement.
		var ovMerged @ast.File = ctx.Gc.InitOverlayMerged
		if ovMerged != nil {
			ctx.Gc.InitOverlayMerged = nil
		}
		openScope(ctx)
		var cur @ir.Block = b
		for i := 0; i < len(stmt.Stmts); i++ {
			if ovMerged != nil {
				overlayFileImports(ctx.Gc, ctx.Gc.InitOverlayBase,
						declImportFile(ctx.Gc, ctx.Gc.InitOverlayFiles, ovMerged, stmt.Stmts[i].Pos.File))
			}
			var stmtLine int = stmt.Stmts[i].Pos.Line
			cur = genStmt(ctx, cur, stmt.Stmts[i])
			// Annotate instructions emitted by this statement with its line number
			if stmtLine > 0 {
				annotateBlockInstrs(cur, stmtLine)
			}
			// If block is terminated (return/break/continue), stop
			if len(cur.Instrs) > 0 && cur.Instrs[len(cur.Instrs) - 1].IsTerminator() {
				// No scope cleanup here: the return / break / continue ran this
				// scope's deferred blocks and released its variables before its
				// jump.
				return closeScope(ctx, cur, false)
			}
		}
		// Normal scope exit: run this scope's deferred blocks, then release its
		// managed locals.
		return closeScope(ctx, cur, true)
	}
	return genStmt(ctx, b, stmt)
}

// genStmt dispatches statement generation by AST node kind.  A statement
// starts in b, so ctx.CurBlock is set to b first: the helpers a statement calls
// read the block they continue in back from ctx.CurBlock, and it may still name
// a block the previous statement or the enclosing construct left behind (the
// loop condition's, for a loop body's first statement) — already terminated.
func genStmt(ctx @GenContext, b @ir.Block, stmt @ast.Stmt) @ir.Block {
	ctx.CurBlock = b
	if stmt.Kind == ast.STMT_EXPR {
		genForEffect(ctx, b, stmt.X)
		b = ctx.CurBlock
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_RETURN {
		return genReturnStmt(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_DECL {
		genDecl(ctx, b, stmt.DeclRef)
		b = ctx.CurBlock
		coScopeAddressedLits(ctx)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_ASSIGN {
		b = genAssign(ctx, b, stmt)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_SHORT_VAR {
		b = genShortVar(ctx, b, stmt)
		coScopeAddressedLits(ctx)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_IF {
		return genIf(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_FOR {
		return genFor(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_INC_DEC {
		b = genIncDec(ctx, b, stmt)
		b = emitTempCleanup(ctx, b)
		return b
	}

	if stmt.Kind == ast.STMT_BREAK {
		if ctx.BreakTo == nil {
			panic(
					"internal error: a break with no enclosing loop or switch, which the checker rejects, reached"
							" IR-gen")
		}
		// Exit the scopes the break leaves — their deferred blocks, then their
		// managed locals' release.  The target block doesn't (closeScope drops
		// them without a release on this terminator), so without it a managed
		// local before the break leaks.  A deferred `panic` ends the block.
		b = emitLeaveScopes(ctx, b, ctx.BreakScopes, ctx.BreakVarLen)
		if !blockIsTerminated(b) {
			irbuild.EmitJump(b, ctx.BreakTo)
		}
		return b
	}

	if stmt.Kind == ast.STMT_CONTINUE {
		if ctx.ContinueTo == nil {
			panic(
					"internal error: a continue with no enclosing loop, which the checker rejects, reached IR-gen")
		}
		b = emitLeaveScopes(ctx, b, ctx.ContinueScopes, ctx.ContinueVarLen)
		if !blockIsTerminated(b) {
			irbuild.EmitJump(b, ctx.ContinueTo)
		}
		return b
	}

	if stmt.Kind == ast.STMT_EMPTY {
		return b
	}

	if stmt.Kind == ast.STMT_BLOCK {
		return genBlock(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_SWITCH {
		return genSwitch(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_TYPE_SWITCH {
		return genTypeSwitch(ctx, b, stmt)
	}

	if stmt.Kind == ast.STMT_DEFER {
		scheduleDefer(ctx, stmt)
		return b
	}

	panic("internal error: IR-gen met a statement it does not lower (compiler bug)")
}
