package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/binate/types/abi"

// ============================================================
// Managed-store dispatchers
// ============================================================
//
// One home for the Axiom-5 managed-value store discipline used at every
// assignment / declaration / element-init / call-result site in IR-gen.
// Hand-authoring the four-way (@T / @[]T / @func / @Iface) plus
// aggregate switch at each site invites a new site that misses a kind
// (or gets the acquire/release ordering wrong) — the §3.4 leak/double-
// free/UAF family.  Routing every site through these dispatchers makes
// "support a new managed kind" a one-line edit here that propagates
// everywhere.

// emitAcquireManagedScalar acquires a managed-SCALAR value being stored
// into a slot: a fresh producer (make / make_slice / box / literal /
// call result — see isFreshManagedValue) is MOVED (consumeTemp removes
// its pending end-of-statement RefDec, transferring its single ref to
// the slot); a borrowed load is COPIED (RefInc).  No-op for non-scalar /
// non-managed types — an aggregate is acquired by emitStoreManagedSlot
// (acquireStoredAggregate), which needs the slot pointer.  Emits no block split
// (RefInc never branches), so no @Block return.
func emitAcquireManagedScalar(ctx @GenContext, b @ir.Block, val @ir.Instr, t @types.Type) {
	if !irutil.IsManagedScalarType(t) { return }
	if isFreshManagedValue(val, t) {
		consumeTemp(ctx, val)
	} else {
		emitManagedValueCopyRefInc(ctx.Func, b, val, t)
	}
}

// emitStoreManagedSlot performs the full Axiom-5 acquire-before-release
// store of val into a slot addressed by slotPtr.  For the four managed-
// scalar kinds it ACQUIRES the new value first (emitAcquireManagedScalar)
// then — unless isInit — RELEASES the prior occupant (load + RefDec).
// For a managed struct/array aggregate it stores, then acquires — a fresh call
// result is MOVED (isFreshManagedAggregate: consumeTemp hands its references to
// the slot), anything else is copied (emitStructCopy of the slot) — releasing the
// saved prior occupant via emitStructDtor.
// Acquiring before releasing makes a self-aliasing store — slot's old value
// IS the new value, e.g. `a[i] = a[i]` — safe: the value is retained before
// the old reference is dropped, so it can't be freed mid-store.  isInit
// (a freshly-alloc'd slot with no prior occupant — var decl, short-var,
// element-literal init, for-range bind) skips the release half.  Returns
// the continuation block: the slice / @Iface / @func RefDecs split the
// block for a null-guard, so callers must rebind b / ctx.CurBlock.
func emitStoreManagedSlot(ctx @GenContext, b @ir.Block, slotPtr @ir.Instr, val @ir.Instr,
		slotTyp @types.Type, isInit bool) @ir.Block {
	val = nilForSlot(b, val, slotTyp)
	if irutil.IsManagedScalarType(slotTyp) {
		emitAcquireManagedScalar(ctx, b, val, slotTyp)
		if !isInit {
			var oldVal @ir.Instr = irbuild.EmitLoad(b, slotPtr, slotTyp)
			b = emitManagedValueRefDec(ctx.Func, b, oldVal, slotTyp)
		}
		irbuild.EmitStore(b, slotPtr, val)
		return b
	}
	if needsStructCopy(slotTyp) {
		var move bool = isFreshManagedAggregate(ctx, val)
		if isInit {
			irbuild.EmitStore(b, slotPtr, val)
			acquireStoredAggregate(ctx, b, slotPtr, val, slotTyp, move)
			return b
		}
		var tmpSlot @ir.Instr = irbuild.EmitAlloc(b, slotTyp)
		var oldVal @ir.Instr = irbuild.EmitLoad(b, slotPtr, slotTyp)
		irbuild.EmitStore(b, tmpSlot, oldVal)
		irbuild.EmitStore(b, slotPtr, val)
		acquireStoredAggregate(ctx, b, slotPtr, val, slotTyp, move)
		emitStructDtor(ctx.Func, b, tmpSlot, slotTyp)
		return b
	}
	// Non-managed slot: a plain store, no acquire/release.
	irbuild.EmitStore(b, slotPtr, val)
	return b
}

// acquireStoredAggregate acquires the managed struct/array val just stored into the
// slot at slotPtr: moved (move — consumeTemp takes the fresh call result off the
// statement's temps, its references now the slot's) or copied (emitStructCopy
// RefIncs the slot's managed fields).
func acquireStoredAggregate(ctx @GenContext, b @ir.Block, slotPtr @ir.Instr, val @ir.Instr,
		slotTyp @types.Type, move bool) {
	if move {
		consumeTemp(ctx, val)
	} else {
		emitStructCopy(ctx.Func, b, slotPtr, slotTyp)
	}
}

// acquireAggregateValue acquires the managed struct/array val for a destination
// with no slot of its own to copy in place — a return, a slice element: a fresh
// call result is moved (consumeTemp), anything else is copied into a throwaway
// slot whose managed fields are RefInc'd (emitStructCopy).  The destination then
// receives val's bytes either way.
func acquireAggregateValue(ctx @GenContext, b @ir.Block, val @ir.Instr, t @types.Type) {
	if isFreshManagedAggregate(ctx, val) {
		consumeTemp(ctx, val)
		return
	}
	var tmpSlot @ir.Instr = allocStored(b, t, val)
	emitStructCopy(ctx.Func, b, tmpSlot, t)
}

// nilForSlot returns v retyped to the slot's type when v is a literal `nil`, and
// v unchanged otherwise.  A literal nil is lowered with the nil type — one
// pointer-sized null — so storing it as-is into a two-word function-value slot
// ({code, data}, raw or managed) zeroes only the code word: the data word keeps
// pointing at the closure the store has just released, which is released again
// later (a double free).  Retyped, it is the slot type's zero value — both words.
func nilForSlot(b @ir.Block, v @ir.Instr, slotTyp @types.Type) @ir.Instr {
	if v == nil || v.Typ == nil || v.Typ.Kind != types.TYP_NIL || slotTyp == nil {
		return v
	}
	return irbuild.EmitConstNil(b, types.StripWrappers(slotTyp))
}

// registerManagedCallResult registers a CALL result of a managed kind as
// an end-of-statement cleanup temp (so a discarded result is RefDec'd, not
// leaked), and marks the statement SP-growing for the multi-word kinds
// whose VM BC_RETURN copy-back grows the caller's vm.SP.  The single home
// for the registration at genCall / genFuncValueCallWithFn / genMethodCall /
// genInterfaceMethodCall (hand-rolled per site, a kind such as @func is easily
// missed).
// A managed pointer is a single register-width word, so it grows no SP.
func registerManagedCallResult(ctx @GenContext, result @ir.Instr, resultTyp @types.Type) {
	if irutil.IsManagedPtrType(resultTyp) {
		registerTemp(ctx, result)
		return
	}
	if irutil.IsManagedSliceType(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by 32 (slice header).
		ctx.StmtGrewSP = true
		return
	}
	if irutil.IsManagedFuncValueType(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by 16 (func value:
		// {shim, data}).  Omitting this leaked the closure data slot.
		ctx.StmtGrewSP = true
		return
	}
	if irutil.IsManagedIfaceValueType(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by 16 (iface value).
		ctx.StmtGrewSP = true
		return
	}
	if needsStructCopy(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by SizeOf(struct).
		ctx.StmtGrewSP = true
		return
	}
	// A RAW (unmanaged) aggregate / address-aggregate result — a `(*T, *U)`
	// multi-return tuple, a raw `*[]T` slice, a raw `[N]T` array, or a raw
	// struct / interface- / func-value — needs no RefDec, so it matched none of
	// the managed branches above; but the VM STILL copies it back onto vm.SP at
	// BC_RETURN.  Mark the statement SP-growing so IR-gen emits OP_SP_RESTORE to
	// reclaim it.  Without this, such a result returned per iteration of a hot
	// loop leaks vm.SP per call and overflows the VM stack (SP growth is a
	// return-SHAPE property, independent of managedness — keying it off
	// NeedsDestruction leaks).  `IsAggregateReturnKind` is the language-
	// level by-address-return kind gate (the pure-kind form, no size threshold),
	// matching the VM's own `isMultiWordField || isVMAddressAggregate` copy-back
	// condition.  Native / LLVM treat OP_SP_RESTORE as a no-op, so this is VM-only.
	if abi.IsAggregateReturnKind(resultTyp) {
		ctx.StmtGrewSP = true
	}
}

// allocStored emits a stack slot of type typ holding val, stored whole right after the
// slot's OP_ALLOC, which is NoZeroInit: the store writes every byte a zero-fill would.
// Besides its cost, a fill between a call and the store of the call's result into the
// slot would keep the call from writing its result there (common.CallResultSlots),
// costing a second copy of the result on the stack.
func allocStored(b @ir.Block, typ @types.Type, val @ir.Instr) @ir.Instr {
	var slot @ir.Instr = irbuild.EmitAlloc(b, typ)
	slot.NoZeroInit = true
	irbuild.EmitStore(b, slot, val)
	return slot
}
