package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the managed-store dispatchers in gen_store_slot.bn.
// fail / NewFunc / AddBlock / noParams / noResults / countOp live in the
// package's other test files.

// firstIdxOp returns the index of the first instruction in b with op, or
// -1 — used to assert relative ordering (acquire before release) within a
// single block.
func firstIdxOp(b @ir.Block, op int) int {
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == op { return i }
	}
	return -1
}

// registerManagedCallResult must register a @func-returning call result as
// a cleanup temp AND mark the statement SP-growing — the arm that was
// missing at every call site, leaking the closure data slot of a discarded
// @func result.
func TestRegisterManagedCallResultFuncValue() testing.TestResult {
	var noTypeParams @[]@types.Param
	var noTypeResults @[]@types.Type
	var fvTyp @types.Type = types.MakeManagedFuncValueType(noTypeParams, noTypeResults)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var result @ir.Instr = irbuild.EmitCall(b, "wrap", noArgs, fvTyp)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerManagedCallResult(ctx, result, fvTyp)
	if len(ctx.Temps) != 1 {
		return fail("a @func call result must be registered as one temp")
	}
	if ctx.Temps[0].ID != result.ID {
		return fail("the registered temp must be the call result")
	}
	if !ctx.StmtGrewSP {
		return fail("a @func result is a 2-word copy-back — must grow SP")
	}
	return ""
}

// A managed-pointer result is a single register-width word: registered for
// cleanup but NOT SP-growing (no BC_RETURN copy-back).
func TestRegisterManagedCallResultPtrNoSPGrow() testing.TestResult {
	var ptrTyp @types.Type = types.MakeManagedPtrType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var result @ir.Instr = irbuild.EmitCall(b, "mk", noArgs, ptrTyp)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerManagedCallResult(ctx, result, ptrTyp)
	if len(ctx.Temps) != 1 {
		return fail("a @T call result must be registered as one temp")
	}
	if ctx.StmtGrewSP {
		return fail("a @T result is one word — must NOT grow SP")
	}
	return ""
}

// emitStoreManagedSlot must ACQUIRE the new value (RefInc a borrow) BEFORE
// RELEASING the old occupant (RefDec) — the ordering that makes a self-
// aliasing store safe.  Pinned for a managed-ptr (its RefDec does not split
// the block, so both ops land in the entry block in emission order).
func TestEmitStoreManagedSlotAcquireBeforeRelease() testing.TestResult {
	var ptrTyp @types.Type = types.MakeManagedPtrType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(entry, ptrTyp)
	var src @ir.Instr = irbuild.EmitAlloc(entry, ptrTyp)
	var val @ir.Instr = irbuild.EmitLoad(entry, src, ptrTyp) // a borrow (not fresh)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var cont @ir.Block = emitStoreManagedSlot(ctx, entry, slot, val, ptrTyp, false)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(cont, noRet)
	var incIdx int = firstIdxOp(entry, iropcode.OP_REFINC)
	var decIdx int = firstIdxOp(entry, iropcode.OP_REFDEC)
	if incIdx < 0 {
		return fail("expected a RefInc acquiring the new value")
	}
	if decIdx < 0 {
		return fail("expected a RefDec releasing the old value")
	}
	if incIdx > decIdx {
		return fail("acquire (RefInc) must precede release (RefDec)")
	}
	if countOp(f, iropcode.OP_STORE) < 1 {
		return fail("expected the value to be stored into the slot")
	}
	return ""
}

// isInit selects the fresh-slot model: acquire the new value but emit NO
// old-value load + RefDec (the slot has no prior occupant).
func TestEmitStoreManagedSlotInitSkipsRelease() testing.TestResult {
	var ptrTyp @types.Type = types.MakeManagedPtrType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(entry, ptrTyp)
	var src @ir.Instr = irbuild.EmitAlloc(entry, ptrTyp)
	var val @ir.Instr = irbuild.EmitLoad(entry, src, ptrTyp) // a borrow (not fresh)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	var cont @ir.Block = emitStoreManagedSlot(ctx, entry, slot, val, ptrTyp, true)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(cont, noRet)
	if countOp(f, iropcode.OP_REFINC) < 1 {
		return fail("init store of a borrow must still acquire (RefInc)")
	}
	if countOp(f, iropcode.OP_REFDEC) != 0 {
		return fail("init store must NOT release an old value (no RefDec)")
	}
	return ""
}

// A fresh producer (make) is MOVED into the slot: consumeTemp removes its
// pending end-of-statement RefDec, and no RefInc is emitted.
func TestEmitStoreManagedSlotMovesFreshTemp() testing.TestResult {
	var s @types.Type = types.MakeStructType("S", noFields)
	var ptrTyp @types.Type = types.MakeManagedPtrType(s)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(entry, ptrTyp)
	var val @ir.Instr = irbuild.EmitMake(entry, s) // fresh — refcount 1
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerTemp(ctx, val)
	var cont @ir.Block = emitStoreManagedSlot(ctx, entry, slot, val, ptrTyp, true)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(cont, noRet)
	if len(ctx.Temps) != 0 {
		return fail("a moved fresh producer must be consumed from temps")
	}
	if countOp(f, iropcode.OP_REFINC) != 0 {
		return fail("a moved fresh producer must NOT be RefInc'd")
	}
	return ""
}

// A RAW multi-return tuple `(*int, *int)` — two raw pointers, no managed field —
// needs no RefDec cleanup temp, but the VM copies the 2-word tuple back onto
// vm.SP at BC_RETURN, so registerManagedCallResult MUST still mark the statement
// SP-growing.  Keying SP-growth off NeedsDestruction (needsStructCopy) was the
// leak: a raw multi-return returned per iteration of a hot loop leaked vm.SP.
func TestRegisterManagedCallResultRawMultiReturnGrowsSP() testing.TestResult {
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.MakePointerType(types.TypInt())
	results[1] = types.MakePointerType(types.TypInt())
	var tupleTyp @types.Type = irutil.MakeMultiReturnStructType(results)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var result @ir.Instr = irbuild.EmitCall(b, "rawPair", noArgs, tupleTyp)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerManagedCallResult(ctx, result, tupleTyp)
	if len(ctx.Temps) != 0 {
		return fail("a raw (*T,*U) multi-return has no managed field — no cleanup temp")
	}
	if !ctx.StmtGrewSP {
		return fail("a raw multi-return tuple is a copy-back — must grow SP (OP_SP_RESTORE)")
	}
	return ""
}

// A RAW slice `*[]int` result is a 2-word aggregate the VM copies back onto
// vm.SP; like the raw tuple it needs no RefDec but must mark SP-growing.
func TestRegisterManagedCallResultRawSliceGrowsSP() testing.TestResult {
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var result @ir.Instr = irbuild.EmitCall(b, "rawSlice", noArgs, sliceTyp)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerManagedCallResult(ctx, result, sliceTyp)
	if len(ctx.Temps) != 0 {
		return fail("a raw *[]T slice result has no managed field — no cleanup temp")
	}
	if !ctx.StmtGrewSP {
		return fail("a raw *[]T slice is a 2-word copy-back — must grow SP")
	}
	return ""
}

// A RAW pointer `*int` result is a single register-width word (no copy-back):
// it must NOT mark SP-growing — guards resultGrowsVMSP against over-breadth.
func TestRegisterManagedCallResultRawPtrNoSPGrow() testing.TestResult {
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var result @ir.Instr = irbuild.EmitCall(b, "addr", noArgs, ptrTyp)
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	registerManagedCallResult(ctx, result, ptrTyp)
	if ctx.StmtGrewSP {
		return fail("a raw *T pointer result is one word — must NOT grow SP")
	}
	return ""
}

// End-to-end: a raw multi-return `(*int, *int)` returned by a METHOD call must
// flow through registerManagedCallResult (gen_method.bn) and mark the caller
// statement SP-growing — so the caller emits OP_SP_RESTORE.  Guards the fix
// across a real call SITE (not just the direct registerManagedCallResult unit
// tests above); the method-call path is the one the reverted frame-skip
// optimization's frameRegs would exercise.
func TestRawMultiReturnMethodCallEmitsSPRestore() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"type T struct { x int }\n"
					"func (t *T) pair() (*int, *int) { return &t.x, &t.x }\n"
					"func caller(t *T) int {\n"
					"\tvar p *int\n"
					"\tvar q *int\n"
					"\tp, q = t.pair()\n"
					"\treturn *p + *q\n"
					"}\n")
	var fn @ir.Func = assertNamedFunc(m, "test.caller")
	if fn == nil { return fail("caller not found") }
	// The only SP-growing statement in caller is `p, q = t.pair()` (the raw
	// multi-return), so any OP_SP_RESTORE must come from the fix.
	if countOp(fn, iropcode.OP_SP_RESTORE) < 1 {
		return fail("a raw multi-return method call must emit OP_SP_RESTORE to reclaim vm.SP")
	}
	return ""
}
