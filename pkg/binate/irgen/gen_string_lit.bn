package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// materializeStringLit lowers a string-literal value — an OP_CONST_STRING,
// which is a bare pointer to the literal's static bytes — into the
// representation of the slot it is delivered to (spec §6.6
// `const.string.types`):
//   - a char-slice slot (`@[]readonly char`, `*[]readonly char`, `@[]char`)
//     gets its slice header (EmitStringToChars — a borrow of the static data,
//     or, for a mutable `@[]char`, a fresh copy);
//   - a char-array slot (`[N]char` / `[N]readonly char`) gets the array VALUE
//     (EmitRodataArray — the bytes copied, the tail zero-padded when the
//     checker admitted a shorter literal at an initializer).
// Any other value or slot is returned unchanged.  Delivering the bare pointer
// instead stores the pointer's own bytes into the slot: a silent garbage
// value, and for an array slot wider than a pointer a partial store (or, at a
// by-value array return / argument, invalid IR).
//
// A mutable `@[]char` copy (OP_RODATA_MSLICE_COPY) is a fresh owning value;
// whether it must be registered as a cleanup temp depends on how the caller
// consumes it, so that stays with the caller.
func materializeStringLit(ctx @GenContext, b @ir.Block, v @ir.Instr,
		slotTyp @types.Type) @ir.Instr {
	if v == nil || slotTyp == nil || v.Op != iropcode.OP_CONST_STRING { return v }
	if isCharSliceType(slotTyp) {
		v = irbuild.EmitStringToChars(b, v, slotTyp)
	} else if isCharArrayType(slotTyp) {
		v = irbuild.EmitRodataArray(b, v.StrVal, slotTyp)
	} else {
		return v
	}
	noteSPGrowingResult(ctx, v)
	return v
}
