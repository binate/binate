package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_string_lit.bn: a string literal delivered to a slot is lowered
// to the slot's representation.

// strLitTestBlock returns a fresh GenContext and a fresh function's entry block.
func strLitTestBlock() (@GenContext, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	return make(GenContext), ir.AddBlock(f, "entry")
}

// A char-array slot gets the array VALUE (OP_RODATA_ARRAY at the slot's
// structural type), not the bare string pointer.
func TestMaterializeStringLitCharArray() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = strLitTestBlock()
	var s @ir.Instr = irbuild.EmitConstString(b, "abc")
	var arrTyp @types.Type = types.MakeArrayType(types.TypChar(), 3)
	var r @ir.Instr = materializeStringLit(ctx, b, s, arrTyp)
	if r.Op != iropcode.OP_RODATA_ARRAY {
		return fail("a string literal into [3]char must lower to OP_RODATA_ARRAY")
	}
	if r.Typ.Kind != types.TYP_ARRAY || r.Typ.ArrayLen != 3 {
		return fail("the array value must carry the [3]char type")
	}
	if !ctx.StmtGrewSP {
		return fail("the array materialization must be noted as SP-growing")
	}
	return ""
}

// A distinct named char-array slot (`type Name [3]char`) materializes like its
// underlying array.
func TestMaterializeStringLitNamedCharArray() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = strLitTestBlock()
	var s @ir.Instr = irbuild.EmitConstString(b, "abc")
	var named @types.Type = types.MakeNamedType("Name")
	named.Underlying = types.MakeArrayType(types.TypChar(), 3)
	var r @ir.Instr = materializeStringLit(ctx, b, s, named)
	if r.Op != iropcode.OP_RODATA_ARRAY {
		return fail("a string literal into a named [3]char must lower to OP_RODATA_ARRAY")
	}
	return ""
}

// A char-slice slot gets its slice header: a borrow of the static data for
// `@[]readonly char`.
func TestMaterializeStringLitCharSlice() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = strLitTestBlock()
	var s @ir.Instr = irbuild.EmitConstString(b, "abc")
	var slTyp @types.Type = types.MakeManagedSliceType(types.MakeReadonlyType(types.TypChar()))
	var r @ir.Instr = materializeStringLit(ctx, b, s, slTyp)
	if r.Op != iropcode.OP_RODATA_MSLICE {
		return fail("a string literal into @[]readonly char must lower to OP_RODATA_MSLICE")
	}
	return ""
}

// Anything else — a non-string value, or a slot that is neither a char slice
// nor a char array — passes through unchanged.
func TestMaterializeStringLitPassesThrough() testing.TestResult {
	var ctx @GenContext
	var b @ir.Block
	ctx, b = strLitTestBlock()
	var s @ir.Instr = irbuild.EmitConstString(b, "abc")
	if !same(materializeStringLit(ctx, b, s, types.TypInt()), s) {
		return fail("a non-char slot must leave the string value unchanged")
	}
	var arrTyp @types.Type = types.MakeArrayType(types.TypChar(), 3)
	var k @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 5), types.TypInt())
	if !same(materializeStringLit(ctx, b, k, arrTyp), k) {
		return fail("a non-string value must pass through unchanged")
	}
	if ctx.StmtGrewSP {
		return fail("a pass-through must not note an SP-growing result")
	}
	return ""
}

// Every position that delivers a string literal to a [3]char slot copies the
// array: a plain, field, dereference, raw-pointer element, array element, slice
// element and parallel assignment, a return, a call argument, an array-literal
// element and a package variable's initializer (lowered as an assignment in the
// package init function).
func TestStringLitArrayEveryPosition() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\n"
					"type S struct { name [3]char }\n"
					"var G [3]char = \"glb\"\n"
					"func asg() { var a [3]char; a = \"asg\"; _ = a }\n"
					"func fld(s *S) { s.name = \"fld\" }\n"
					"func drf(p *([3]char)) { *p = \"drf\" }\n"
					"func pix(p *([3]char)) { p[1] = \"pix\" }\n"
					"func ael(a *([2][3]char)) { (*a)[1] = \"ael\" }\n"
					"func sel(s @[][3]char) { s[1] = \"sel\" }\n"
					"func par() int { var a [3]char; var n int; a, n = \"par\", 1; _ = a; return n }\n"
					"func ret() [3]char { return \"ret\" }\n"
					"func take(a [3]char) {}\n"
					"func arg() { take(\"arg\") }\n"
					"func lit() [2][3]char { return [2][3]char{\"cl0\", \"cl1\"} }\n")
	var names @[]@[]char = @[]@[]char{"asg", "fld", "drf", "pix", "ael", "sel", "par", "ret", "arg"}
	for i := 0; i < len(names); i++ {
		var fn @ir.Func = findFunc(m, names[i])
		if fn == nil { return fail(buf.Concat("missing function ", names[i])) }
		if countOp(fn, iropcode.OP_RODATA_ARRAY) != 1 {
			return fail(
					buf.Concat("the literal must be copied into the array (one OP_RODATA_ARRAY) in ", names[i]))
		}
	}
	var lit @ir.Func = findFunc(m, "lit")
	if lit == nil || countOp(lit, iropcode.OP_RODATA_ARRAY) != 2 {
		return fail("each array-literal element must copy its literal")
	}
	var init @ir.Func = findFunc(m, "__init")
	if init == nil || countOp(init, iropcode.OP_RODATA_ARRAY) != 1 {
		return fail("the package variable's initializer must copy the literal")
	}
	return ""
}
