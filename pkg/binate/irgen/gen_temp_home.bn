package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/stdx/slices"

// A struct temporary with references -- a call's result, released at the end of its
// statement (registerTemp) -- is destroyed where it is when IR-gen has stored it whole
// in a slot: the slot a field or element is read from or has its address taken in, a
// by-value argument's copy, a discarded result's slot (noteTempHome).  Without one, its
// release copies it into a slot of its own to hand to its dtor.  Whatever the slot
// holds at the release is what the temporary owns then, so a write through a field's
// address in the statement is destroyed with it.  A call can still write
// its result straight into a home: the dtor's call keeps no pointer argument
// (ir.Instr.ArgsNotKept), so handing the slot to it lets the address reach no callee.

// stmtTempCopy stores val whole in a fresh slot of its type, a temporary of the open
// statement (stmtTempSlot), and returns the slot, which is where val is destroyed when
// it is a struct temporary with references (noteTempHome).
func stmtTempCopy(ctx @GenContext, b @ir.Block, val @ir.Instr) @ir.Instr {
	var slot @ir.Instr = stmtTempSlot(ctx, allocStored(b, val.Typ, val))
	noteTempHome(ctx, val, slot)
	return slot
}

// noteTempHome records slot, which holds val's bytes and is never written again, as
// where val is destroyed at its release, when val is a struct temporary with
// references the statement still owns.
func noteTempHome(ctx @GenContext, val @ir.Instr, slot @ir.Instr) {
	if val == nil || val.Typ == nil || !needsStructCopy(val.Typ) || !isTemp(ctx, val) { return }
	ctx.TempHomeVals = slices.Append[@ir.Instr](ctx.TempHomeVals, val)
	ctx.TempHomeSlots = slices.Append[@ir.Instr](ctx.TempHomeSlots, slot)
}

// tempHome returns the slot the temporary tmp is destroyed in (noteTempHome), or nil.
func tempHome(ctx @GenContext, tmp @ir.Instr) @ir.Instr {
	for i := len(ctx.TempHomeVals) - 1; i >= 0; i-- {
		if ctx.TempHomeVals[i].ID == tmp.ID { return ctx.TempHomeSlots[i] }
	}
	return nil
}

// forgetTempHomes drops the homes of the statement's temporaries, once they are
// released together.  A temporary released or moved earlier (emitTempCleanupSince,
// consumeTemp) keeps its entry until then: value ids are unique in a function, so a
// lookup by a temporary still owned never meets it.
func forgetTempHomes(ctx @GenContext) {
	ctx.TempHomeVals = ctx.TempHomeVals[:0]
	ctx.TempHomeSlots = ctx.TempHomeSlots[:0]
}

// releaseStructTemp destroys the struct temporary tmp in b: in its home, or else in a
// slot of its own scope it is copied into, ended right after the dtor.
func releaseStructTemp(ctx @GenContext, b @ir.Block, tmp @ir.Instr) {
	var home @ir.Instr = tempHome(ctx, tmp)
	if home != nil {
		emitStructDtor(ctx.Func, b, home, tmp.Typ)
		return
	}
	var tmpSlot @ir.Instr = ownScopeSlot(ctx, allocStored(b, tmp.Typ, tmp))
	emitStructDtor(ctx.Func, b, tmpSlot, tmp.Typ)
	endOwnScope(b, tmpSlot)
}

// homeDiscarded gives v, a value evaluated for its effects only, a home right where it
// is made when it is a struct temporary with references, so a call writes its result
// straight there and the statement's end destroys it there.
func homeDiscarded(ctx @GenContext, v @ir.Instr) {
	if v == nil || v.Typ == nil || !needsStructCopy(v.Typ) || isStructOrArrayAlloc(v) { return }
	if !isTemp(ctx, v) { return }
	stmtTempCopy(ctx, ctx.CurBlock, v)
}
