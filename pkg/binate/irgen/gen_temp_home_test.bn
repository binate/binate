package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for gen_temp_home.bn.  structTempSlots (gen_scope_temps_test.bn), hasCallTo,
// containsSub, genFromSource, findFunc and fail are shared test helpers.

// homeSrcHead declares a struct with references and functions making one, an array
// of them, and passing one.
func homeSrcHead() *[]readonly char {
	return "package \"test\"\n"
			"type M struct {\n\ts @[]char\n\tn int\n}\n"
			"func mkM() M {\n\tvar m M\n\tm.n = 1\n\treturn m\n}\n"
			"func mkMs() [2]M {\n\tvar a [2]M\n\ta[1] = mkM()\n\treturn a\n}\n"
			"func pass(m M) M { return m }\n"
}

// dtorTakes reports whether fn has a dtor call whose argument is slot, cast to a byte
// pointer -- slot is destroyed where it is.
func dtorTakes(fn @ir.Func, slot @ir.Instr) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op != iropcode.OP_CALL || !containsSub(ins.StrVal, "__dtor_") || len(ins.Args) != 1 {
				continue
			}
			var arg @ir.Instr = ins.Args[0]
			if arg.Op == iropcode.OP_BIT_CAST && len(arg.Args) == 1 && arg.Args[0].ID == slot.ID {
				return true
			}
		}
	}
	return false
}

// genHome compiles homeSrcHead with body appended and returns function g.
func genHome(body *[]readonly char) @ir.Func {
	var src @[]char = make_slice(char, len(homeSrcHead()) + len(body))
	var n int = 0
	for i := 0; i < len(homeSrcHead()); i++ {
		src[n] = homeSrcHead()[i]
		n++
	}
	for i := 0; i < len(body); i++ {
		src[n] = body[i]
		n++
	}
	var m @ir.Module = genFromSource(src)
	if len(irbuild.VerifyModule(m)) != 0 { return nil }
	return findFunc(m, "g")
}

// allocAfterCall reports whether fn has a NoZeroInit OP_ALLOC right after an OP_CALL to
// a name containing callee, with the whole store of the call's result into it next.
func allocAfterCall(fn @ir.Func, callee *[]readonly char) bool {
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 1; ii < len(blk.Instrs); ii++ {
			var prev @ir.Instr = blk.Instrs[ii - 1]
			var al @ir.Instr = blk.Instrs[ii]
			if al.Op != iropcode.OP_ALLOC || !al.NoZeroInit || prev.Op != iropcode.OP_CALL ||
					!containsSub(prev.StrVal, callee) || ii + 1 >= len(blk.Instrs) {
				continue
			}
			var st @ir.Instr = blk.Instrs[ii + 1]
			if st.Op == iropcode.OP_STORE && st.Args[0].ID == al.ID && st.Args[1].ID == prev.ID {
				return true
			}
		}
	}
	return false
}

// A discarded struct result with references gets its slot right after its call, so
// the call writes the result there, and is destroyed there.
func TestDiscardedResultHomedAtItsCall() testing.TestResult {
	var fn @ir.Func = genHome("func g() { pass(mkM()) }\nfunc main() { g() }\n")
	if fn == nil { return fail("setup: g is generated and verifies") }
	if !allocAfterCall(fn, "pass") { return fail("the discarded result's slot follows its call") }
	var temps @[]@ir.Instr = structTempSlots(fn)
	if len(temps) != 2 {
		return fail("two slots: the argument's copy (mkM's result's home) and pass's result's home")
	}
	if !dtorTakes(fn, temps[0]) || !dtorTakes(fn, temps[1]) {
		return fail("each is destroyed where it is")
	}
	if !hasCallTo(fn, "__copy_1M") || !helperCallsKeepNoArg(fn) {
		return fail("the argument's copy and the dtors are calls that keep no argument")
	}
	return ""
}

// A call result whose field is read is destroyed in the slot the field is read from.
func TestFieldReadResultDestroyedInPlace() testing.TestResult {
	var fn @ir.Func = genHome(
			"func g() int {\n\tvar t int = mkM().n\n\treturn t\n}\nfunc main() { _ = g() }\n")
	if fn == nil { return fail("setup: g is generated and verifies") }
	var temps @[]@ir.Instr = structTempSlots(fn)
	if len(temps) != 1 { return fail("one slot: the result's, read and destroyed there") }
	if !dtorTakes(fn, temps[0]) { return fail("the result is destroyed in the slot it is read from") }
	if !helperCallsKeepNoArg(fn) { return fail("dtor and copy helper calls keep no argument") }
	return ""
}

// helperCallsKeepNoArg reports whether every call fn makes to a dtor or copy helper is
// marked as keeping none of its pointer arguments, and fn makes one.
func helperCallsKeepNoArg(fn @ir.Func) bool {
	var seen bool = false
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op != iropcode.OP_CALL { continue }
			if !containsSub(ins.StrVal, "__dtor_") && !containsSub(ins.StrVal, "__copy_") { continue }
			if !ins.ArgsNotKept { return false }
			seen = true
		}
	}
	return seen
}

// arraySlots returns fn's array allocas, in block order.
func arraySlots(fn @ir.Func) @[]@ir.Instr {
	var out @[]@ir.Instr
	for bi := 0; bi < len(fn.Blocks); bi++ {
		var blk @ir.Block = fn.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.Op != iropcode.OP_ALLOC || ins.TypeArg == nil { continue }
			if types.StripWrappers(ins.TypeArg).Kind == types.TYP_ARRAY {
				out = slices.Append[@ir.Instr](out, ins)
			}
		}
	}
	return out
}

// An array call result whose element's field is read is destroyed in the slot the
// element's address is taken in.
func TestElementReadResultDestroyedInPlace() testing.TestResult {
	var fn @ir.Func = genHome(
			"func g() int {\n\tvar t int = mkMs()[1].n\n\treturn t\n}\nfunc main() { _ = g() }\n")
	if fn == nil { return fail("setup: g is generated and verifies") }
	var arrs @[]@ir.Instr = arraySlots(fn)
	if len(arrs) != 1 { return fail("one array slot: the result's, read and destroyed there") }
	if !dtorTakes(fn, arrs[0]) { return fail("the result is destroyed in the slot it is read from") }
	return ""
}
