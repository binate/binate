package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

var noParams @[]@ir.Param

var noResults @[]@types.Type

var noFields @[]@types.Field

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func strToBytes(s *[]readonly char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = cast(uint8, s[i])
	}
	return r
}

// findFunc looks up a function by name. Callers may pass either the
// fully-qualified name ("test.main") or a bare name ("main"); the
// latter matches any function whose name ends in ".<name>". This
// keeps test sites readable, since NewFunc qualifies f.Name.
func findFunc(m @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		var fn @[]char = m.Funcs[i].Name
		if irutil.Streq(fn, name) { return m.Funcs[i] }
		var nlen int = len(name)
		var flen int = len(fn)
		if flen > nlen + 1 && fn[flen - nlen - 1] == '.' {
			var matches bool = true
			for k := 0; k < nlen; k++ {
				if fn[flen - nlen + k] != name[k] {
					matches = false
				}
			}
			if matches { return m.Funcs[i] }
		}
	}
	return nil
}

func findOp(fn @ir.Func, op int) @ir.Instr {
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op {
				return b.Instrs[j]
			}
		}
	}
	return nil
}

func countOp(fn @ir.Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op {
				n = n + 1
			}
		}
	}
	return n
}

func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func concatChars(a *[]readonly char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(a)
	cb.Write(b)
	return buf.CopyStr(cb.String())
}

// genFromSource parses and type-checks src (mustCheck), then generates it
// (GenModule) with the checker recorded on the module (m.Checker), so IR-gen
// reads the checker's records — expression and variable types, constant values —
// as it does in the compiler.
func genFromSource(src *[]readonly char) @ir.Module {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	return GenModule(mustCheck(file), file)
}

// mustCheck type-checks file and returns its checker (stopOnCheckErrors).
func mustCheck(file @ast.File) @check.Checker {
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	stopOnCheckErrors(c)
	return c
}

// stopOnCheckErrors stops the run, naming the first error, when c has reported
// one: IR-gen is defined only on a program that checks, so a test program (or a
// declaration typed at its prompt) that does not is a broken test.
func stopOnCheckErrors(c @check.Checker) {
	var errs @[]check.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		panic(buf.Concat("a test program does not type-check: ", check.FormatCheckError(errs[0])))
	}
}

// genFromSourcePkgGc parses and type-checks src (mustCheck), then generates it
// as a package (GeneratePackage, which instantiates generic functions and
// methods on demand), and returns the per-compilation @GenCtx used — so tests
// that inspect the generic registries on gc (gc.Generic*Decls etc.) can read the
// SAME context the gen wrote into.  genFromSourcePkg wraps it for the common
// case of inspecting only the produced @Module (gc.Mod).
func genFromSourcePkgGc(src *[]readonly char) @GenCtx {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = mustCheck(file)
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	return gc
}

func genFromSourcePkg(src *[]readonly char) @ir.Module {
	return genFromSourcePkgGc(src).Mod
}

// genReplSession is genFromSourcePkgGc for a REPL session: the checker keeps
// the file's scope (CheckMainPersistent), so a declaration typed after it is
// checked in that scope (CheckDeclInScope), as the REPL checks one before IR-gen
// sees it; returns the per-compilation @GenCtx and the checker.
func genReplSession(src *[]readonly char) (@GenCtx, @check.Checker) {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.CheckMainPersistent(file)
	stopOnCheckErrors(c)
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	GeneratePackage(c, file, gc, make_slice(@ast.File, 0))
	return gc, c
}

// checkedReplDecl parses src as a declaration typed at the prompt of the session
// c checks (genReplSession) and checks it in c's scope (CheckDeclInScope), as the
// REPL does before IR-gen sees it (stopOnCheckErrors).
func checkedReplDecl(c @check.Checker, src *[]readonly char) @ast.Decl {
	var p @parser.Parser = parser.New(strToBytes(src), "<repl>")
	var d @ast.Decl = mustParseDecl(p)
	c.CheckDeclInScope(d)
	stopOnCheckErrors(c)
	return d
}
