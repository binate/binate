package "pkg/binate/irgen"

import "pkg/binate/check"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

var noParams @[]@ir.Param

var noResults @[]@types.Type

var noFields @[]@types.Field

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func strToBytes(s *[]readonly char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = cast(uint8, s[i])
	}
	return r
}

// findFunc looks up a function by name. Callers may pass either the
// fully-qualified name ("test.main") or a bare name ("main"); the
// latter matches any function whose name ends in ".<name>". This
// keeps test sites readable now that NewFunc qualifies f.Name.
func findFunc(m @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		var fn @[]char = m.Funcs[i].Name
		if irutil.Streq(fn, name) { return m.Funcs[i] }
		var nlen int = len(name)
		var flen int = len(fn)
		if flen > nlen + 1 && fn[flen - nlen - 1] == '.' {
			var matches bool = true
			for k := 0; k < nlen; k++ {
				if fn[flen - nlen + k] != name[k] {
					matches = false
				}
			}
			if matches { return m.Funcs[i] }
		}
	}
	return nil
}

func findOp(fn @ir.Func, op int) @ir.Instr {
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op {
				return b.Instrs[j]
			}
		}
	}
	return nil
}

func countOp(fn @ir.Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op {
				n = n + 1
			}
		}
	}
	return n
}

func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func concatChars(a *[]readonly char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(a)
	cb.Write(b)
	return buf.CopyStr(cb.String())
}

func genFromSource(src *[]readonly char) @ir.Module {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	return GenModule(nil, file)
}

// genFromSourceWithChecker parses src, runs a real type-check
// (so Expr.ResolvedTypeID is populated and the bignum-fold values
// land on the Checker), then generates IR with that Checker recorded
// on the module (m.Checker via GenModule).  Use this in tests that need
// the IR-gen layer's Checker-consuming paths — genFromSource passes a nil
// Checker, so m.Checker stays nil and the legacy parseIntLit fallback fires.
func genFromSourceWithChecker(src *[]readonly char) @ir.Module {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var m @ir.Module = GenModule(c, file)
	return m
}

// genFromSourcePkgGc gens a package from source and returns the
// per-compilation @GenCtx used — so tests that inspect the now-on-gc
// generic registries (gc.Generic*Decls etc.) can read the SAME context
// the gen wrote into.  genFromSourcePkg wraps it for the common case of
// inspecting only the produced @Module (gc.Mod).
func genFromSourcePkgGc(src *[]readonly char) @GenCtx {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var m @ir.Module = InitModule(file.PkgName)
	var gc @GenCtx = NewGenCtx(m)
	GeneratePackage(nil, file, gc, make_slice(@ast.File, 0))
	return gc
}

func genFromSourcePkg(src *[]readonly char) @ir.Module {
	return genFromSourcePkgGc(src).Mod
}
