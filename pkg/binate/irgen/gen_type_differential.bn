package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irutil"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/strconv"

// The type differential: a diagnostic a driver switches on (bnc / bni
// --x-type-differential) that notes where IR-gen still reads types from syntax
// itself rather than from the checker's records, one line each appended to the
// file the driver names.  A type expression, and an expression that names a type
// (a type argument, a method expression's base), takes the checker's record
// when it is concrete (resolveTypeExpr, typeArgExprToType, genericInstanceName);
// the rest are noted, with IR-gen's type's identity (irutil.MangleTypeArg):
//
//	<file>:<line>:<col>: unrecorded: IR-gen <identity>
//	<file>:<line>:<col>: abstract: IR-gen <identity>, checker <name>
//
// the first for syntax the checker never saw (IR-gen's own: a `_`-binder
// receiver's copy, an inferred length's `[...]`), the second for a record of an
// abstract type (one holding a type parameter — a parameterized impl's, which
// IR-gen binds itself — Self, or an array whose length depends on a type
// parameter).

// typeDiffPath is the file the type differential appends to; empty when off.
var typeDiffPath @[]char

// SetTypeDifferential switches the type differential on, appending its findings
// to the file at path, or off for an empty path; false, leaving it off, when the
// file cannot be opened for appending.
func SetTypeDifferential(path *[]readonly char) bool {
	var none @[]char
	typeDiffPath = none
	if len(path) == 0 { return true }
	var f @os.File
	var err @errors.Error
	f, err = os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_APPEND, cast(os.FileMode, 0o644))
	if present(err) { return false }
	_ = f.Close()
	typeDiffPath = buf.CopyStr(path)
	return true
}

// noteSyntaxReading notes, under the type differential, that IR-gen read t,
// its type for the type expression te, from te's syntax: te is unrecorded, or
// its record abstract.
func noteSyntaxReading(gc @GenCtx, te @ast.TypeExpr, t @types.Type) {
	if len(typeDiffPath) == 0 || te == nil || !typeDiffApplies(gc) { return }
	noteReading(te.Pos, t, gc.Mod.Checker.TypeExprType(te))
}

// noteExprSyntaxReading is noteSyntaxReading for an expression e that names a
// type, read by IR-gen as the type t.
func noteExprSyntaxReading(gc @GenCtx, e @ast.Expr, t @types.Type) {
	if len(typeDiffPath) == 0 || e == nil || !typeDiffApplies(gc) { return }
	noteReading(e.Pos, t, gc.Mod.Checker.ExprDenotedType(e))
}

// noteReading writes the note for IR-gen's own reading t at pos, where the
// checker's record is rec (nil for none).
func noteReading(pos token.Pos, t @types.Type, rec @types.Type) {
	var irID @[]char = irutil.MangleTypeArg(t)
	if rec == nil {
		writeTypeDiff(pos, buf.Concat("unrecorded: IR-gen ", irID))
		return
	}
	writeTypeDiff(pos,
			buf.Concat(buf.Concat(buf.Concat("abstract: IR-gen ", irID), ", checker "), rec.TypeName()))
}

// typeDiffApplies reports whether gc resolves types the checker recorded: it has
// a checker, and it is not naming instances.
func typeDiffApplies(gc @GenCtx) bool {
	return gc.Mod != nil && gc.Mod.Checker != nil && !gc.NamingInstances
}

// isAbstractType reports whether the checker type t is abstract where the
// mapper walks it: a type parameter or Self occurs in it, or an array length
// depends on a type parameter (a type nested past depth levels counts as one).
func isAbstractType(t @types.Type, depth int) bool {
	if t == nil { return false }
	if depth > 32 { return true }
	if t.Kind == types.TYP_TYPE_PARAM || t.Kind == types.TYP_SELF { return true }
	if t.Kind == types.TYP_ARRAY && t.ArrayLenDependent { return true }
	if isAbstractType(t.Elem, depth + 1) || isAbstractType(t.Target, depth + 1) { return true }
	for i := 0; i < len(t.InstArgs); i++ {
		if isAbstractType(t.InstArgs[i], depth + 1) { return true }
	}
	if t.Kind == types.TYP_STRUCT && len(t.Name) == 0 {
		for i := 0; i < len(t.Fields); i++ {
			if isAbstractType(t.Fields[i].Type, depth + 1) { return true }
		}
	}
	for i := 0; i < len(t.Params); i++ {
		if isAbstractType(t.Params[i].Type, depth + 1) { return true }
	}
	for i := 0; i < len(t.Results); i++ {
		if isAbstractType(t.Results[i], depth + 1) { return true }
	}
	return false
}

// writeTypeDiff appends the finding finding at pos to the differential's file; a
// file it cannot open or write stops the compilation, so that no finding is lost.
func writeTypeDiff(pos token.Pos, finding *[]readonly char) {
	var s @[]char = buf.Concat(pos.File, ":")
	s = buf.Concat(s, strconv.Itoa(pos.Line))
	s = buf.Concat(s, ":")
	s = buf.Concat(s, strconv.Itoa(pos.Col))
	s = buf.Concat(s, ": ")
	s = buf.Concat(s, finding)
	s = buf.Concat(s, "\n")
	var f @os.File
	var err @errors.Error
	f, err = os.OpenFile(typeDiffPath, os.O_WRONLY | os.O_CREATE | os.O_APPEND,
			cast(os.FileMode, 0o644))
	if present(err) {
		panic(buf.Concat("cannot open the type differential's file ", typeDiffPath))
	}
	var werr @errors.Error
	_, werr = f.Write(s)
	_ = f.Close()
	if present(werr) {
		panic(buf.Concat("cannot write the type differential's file ", typeDiffPath))
	}
}
