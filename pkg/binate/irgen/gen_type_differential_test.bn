package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/parser"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"

// Tests for gen_type_differential.bn: the type differential's findings.

// readDiffFile returns the contents of the file at path ("" when there is none).
func readDiffFile(path *[]readonly char) @[]char {
	var out @[]char
	var f @os.File
	var err @errors.Error
	f, err = os.Open(path)
	if present(err) { return out }
	var b @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int
		n, err = f.Read(b)
		if n <= 0 { break }
		out = buf.Concat(out, b[:n])
		if present(err) { break }
	}
	_ = f.Close()
	return out
}

// withTypeDiffFile runs gen with the type differential on, writing to a file of
// its own, and returns what the differential wrote (gen's message instead when
// it returns one).
func withTypeDiffFile(gen *func() @[]char) @[]char {
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_typediff_")
	if present(derr) { return "no temporary directory" }
	defer { _ = os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/diff.txt")
	if !SetTypeDifferential(path) { return "the differential's file must open" }
	var msg @[]char = gen()
	_ = SetTypeDifferential("")
	if len(msg) > 0 { return msg }
	return readDiffFile(path)
}

// diffSrc is the program diffOf generates.
var diffSrc @[]char

// genDiffSrc checks diffSrc and generates it as a package, as a driver does
// (GeneratePackage), returning the first checker error.
func genDiffSrc() @[]char {
	var p @parser.Parser = parser.New(strToBytes(diffSrc), "test")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) > 0 {
		return buf.Concat("the program must check: ", c.CheckerErrors()[0].Msg)
	}
	GeneratePackage(c, file, NewGenCtx(InitModule(file.PkgName)), make_slice(@ast.File, 0))
	return ""
}

// diffOf checks and generates src under the type differential and returns what
// it wrote.
func diffOf(src *[]readonly char) @[]char {
	diffSrc = buf.CopyStr(src)
	return withTypeDiffFile(genDiffSrc)
}

// noteIntUnrecorded notes IR-gen's own reading of int where the checker has no
// record.
func noteIntUnrecorded() @[]char {
	var pos token.Pos
	pos.File = "f.bn"
	pos.Line = 3
	pos.Col = 7
	noteReading(pos, types.TypInt(), nil)
	return ""
}

// IR-gen's own reading of syntax the checker never saw is one line: where,
// "unrecorded", and the type's identity.
func TestTypeDifferentialNotesUnrecorded() testing.TestResult {
	var got @[]char = withTypeDiffFile(noteIntUnrecorded)
	if !containsSub(got, "f.bn:3:7: unrecorded: IR-gen ") {
		return fail(buf.Concat("the reading must be noted; got: ", got))
	}
	return ""
}

// A parameterized impl's type parameters, which IR-gen resolves through its own
// substitution, are reported as abstract records.
func TestTypeDifferentialReportsAbstractRecords() testing.TestResult {
	var got @[]char = diffOf(
			"package \"main\"\n"
					"interface Getter[T any] { Get() T }\n"
					"type Box[T any] struct { v T }\n"
					"func (b @Box[T]) Get() T { return b.v }\n"
					"impl @Box[T] : Getter[T]\n"
					"func main() { var b @Box[int] = make(Box[int]); var g @Getter[int] = b\n"
					"_ = g.Get() }\n")
	if !containsSub(got, ": abstract: ") {
		return fail(buf.Concat("the impl's type parameter must be reported; got: ", got))
	}
	return ""
}

// Types the checker recorded — named, composite, generic instances, type
// arguments written as expressions, a generic type's method-expression base —
// are taken from the records: nothing is noted.
func TestTypeDifferentialQuietWhenAgreeing() testing.TestResult {
	var got @[]char = diffOf(
			"package \"main\"\n"
					"type P struct { x int; y *[]readonly int }\n"
					"type Box[T any] struct { v T }\n"
					"func (b *Box[T]) Get() T { return b.v }\n"
					"func id[T any](x T) T { return x }\n"
					"var p P\n"
					"var get *func(*Box[int]) int = Box[int].Get\n"
					"var b Box[*P]\n"
					"func main() { _ = id[Box[int]](Box[int]{v: 1})\n"
					"var a [2]struct { s readonly int }; _ = a }\n")
	if len(got) > 0 {
		return fail(buf.Concat("nothing must be noted; got: ", got))
	}
	return ""
}

// A file that cannot be opened for appending leaves the differential off.
func TestTypeDifferentialUnopenableFile() testing.TestResult {
	if SetTypeDifferential("/nonexistent-binate-dir/diff.txt") {
		return fail("an unopenable file must not switch the differential on")
	}
	if len(typeDiffPath) != 0 { return fail("the differential must stay off") }
	return ""
}
