package "pkg/binate/irgen"

import "pkg/binate/ast"

// Type declarations may be grouped — `type ( S struct { x int }; C int; P = *C )`
// — which is pure syntax (no iota or other group semantics).  IR-gen's passes
// walk a file's top-level type declarations, so every file entering IR-gen has
// its type groups flattened into their member declarations (flatTypeGroups);
// otherwise every grouped type is missing — a grouped struct's fields are
// unresolvable and a grouped alias silently lowers as the int fallback.

// isTypeGroup reports whether d is a `type ( ... )` group.
func isTypeGroup(d @ast.Decl) bool {
	return d != nil && d.Kind == ast.DECL_GROUP && len(d.Decls) > 0 && d.Decls[0].Kind == ast.DECL_TYPE
}

// flatTypeGroups returns file with each type group replaced by its member
// declarations, in order — file itself when it has none.
func flatTypeGroups(file @ast.File) @ast.File {
	if file == nil { return file }
	var n int = 0
	var grouped bool = false
	for i := 0; i < len(file.Decls); i++ {
		if isTypeGroup(file.Decls[i]) {
			grouped = true
			n = n + len(file.Decls[i].Decls)
		} else {
			n = n + 1
		}
	}
	if !grouped { return file }
	var decls @[]@ast.Decl = make_slice(@ast.Decl, n)
	var k int = 0
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if isTypeGroup(d) {
			for j := 0; j < len(d.Decls); j++ {
				decls[k] = d.Decls[j]
				k = k + 1
			}
		} else {
			decls[k] = d
			k = k + 1
		}
	}
	var flat @ast.File = make(ast.File)
	flat.Pos = file.Pos
	flat.PkgName = file.PkgName
	flat.Imports = file.Imports
	flat.Decls = decls
	flat.Annotations = file.Annotations
	flat.Comments = file.Comments
	return flat
}

// flatTypeGroupFiles is flatTypeGroups over each of files.
func flatTypeGroupFiles(files *[]@ast.File) @[]@ast.File {
	var out @[]@ast.File = make_slice(@ast.File, len(files))
	for i := 0; i < len(files); i++ {
		out[i] = flatTypeGroups(files[i])
	}
	return out
}

// RegisterStructTypes flattens the files' type groups (flatTypeGroupFiles) and runs
// registerStructTypesFlat.
func RegisterStructTypes(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerStructTypesFlat(aliases, paths, flatTypeGroupFiles(files), gc)
}

// RegisterAllInterfaces flattens the files' type groups (flatTypeGroupFiles) and runs
// registerAllInterfacesFlat.
func RegisterAllInterfaces(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerAllInterfacesFlat(aliases, paths, flatTypeGroupFiles(files), gc)
}

// RegisterGenericBodyDeps flattens the files' type groups (flatTypeGroupFiles) and runs
