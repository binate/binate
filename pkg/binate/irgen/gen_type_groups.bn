func RegisterGenericBodyDeps(aliases @[]@[]char, paths @[]@[]char, files *[]@ast.File, gc @GenCtx) {
	registerGenericBodyDepsFlat(aliases, paths, flatTypeGroupFiles(files), gc)
}

