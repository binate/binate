package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for gen_type_groups.bn.

// A type group is replaced by its members, in place and in order; other
// declarations (a const group) stay as they are.
func TestFlatTypeGroups() testing.TestResult {
	var file @ast.File = parseImplDecls(
			"package \"pkg/x\"\n"
					"const ( K1 int = 1; K2 int = 2 )\n"
					"type ( A int; B = A )\n"
					"type C int\n")
	var flat @ast.File = flatTypeGroups(file)
	if len(flat.Decls) != 4 { return fail("expected the const group, A, B and C") }
	if flat.Decls[0].Kind != ast.DECL_GROUP { return fail("the const group should stay grouped") }
	if !charsEqual(flat.Decls[1].Name, "A") || !charsEqual(flat.Decls[2].Name, "B") {
		return fail("the type group's members should follow in order")
	}
	if !charsEqual(flat.Decls[3].Name, "C") { return fail("C should come last") }
	if len(file.Decls) != 3 { return fail("the input file must not change") }
	return ""
}

// A file without a type group is returned as is.
func TestFlatTypeGroupsNone() testing.TestResult {
	var file @ast.File = parseImplDecls("package \"pkg/x\"\ntype C int\n")
	if !same(flatTypeGroups(file), file) { return fail("expected the same file") }
	return ""
}
