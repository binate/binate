package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iriface"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for gen_type_lazy.bn: the types the mapper registers on meeting them
// unregistered.

// A struct met unregistered is registered under its name and filled before the
// mapping returns, its field that points to it pointing to the one registered.
func TestMetStructRegisteredAndFilled() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ntype S struct { n int; next *S }\n")
	var s @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	var si int = lookupStructIdx(gc, "pkg/x.S")
	if si < 0 || !same(gc.Mod.Structs[si].Typ, s) {
		return fail("S should be registered, as the type mapped")
	}
	if len(s.Fields) != 2 || s.Fields[1].Type.Kind != types.TYP_POINTER ||
			!same(s.Fields[1].Type.Elem, s) {
		return fail("S should be filled, its next pointing to S")
	}
	if gc.LazyTypes != nil || gc.MapDepth != 0 { return fail("nothing should be left queued") }
	return ""
}

// A named type met unregistered is registered and its underlying filled.
func TestMetNamedRegisteredAndFilled() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype N [3]int\n")
	var n @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	if !same(lookupTypeAlias(gc, "pkg/x.N"), n) {
		return fail("N should be registered, as the type mapped")
	}
	if n.Kind != types.TYP_NAMED || n.Underlying == nil || n.Underlying.Kind != types.TYP_ARRAY {
		return fail("N should be filled with its underlying array")
	}
	if isPendingNamedType(gc, "pkg/x.N") { return fail("N should be pending no more") }
	return ""
}

// An interface met unregistered is registered with its method set.
func TestMetIfaceRegisteredAndCompleted() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ninterface I { M() int; N() }\n")
	var it @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	if it.Kind != types.TYP_INTERFACE { return fail("I should map to an interface") }
	var idx int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	if idx < 0 || gc.Mod.Interfaces[idx].IsStub { return fail("I should be registered, complete") }
	var names @[]@[]char = gc.Mod.Interfaces[idx].MethodNames
	if len(names) != 2 || !charsEqual(names[0], "M") || !charsEqual(names[1], "N") {
		return fail("I's method set should be M, N")
	}
	return ""
}

// A forward declaration's named type, defined as a struct in its package's source,
// met unregistered, is registered as that struct and filled.
func TestMetForwardDefinedAsStruct() testing.TestResult {
	var m @ir.Module = testModule("test")
	var bp @parser.Parser = parser.NewInterface(strToBytes("package \"pkg/x\"\ntype X\n"), "x.bni")
	var bni @ast.File = mustParse(bp)
	var mp @parser.Parser = parser.New(
			strToBytes("package \"pkg/x\"\ntype X\ntype X struct { n int }\n"), "x.bn")
	var merged @ast.File = mustParse(mp)
	checkPackageInto(moduleChecker(m), "pkg/x", bni, merged)
	var gc @GenCtx = NewGenCtx(m)
	var x @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, bni.Decls[0]))
	var si int = lookupStructIdx(gc, "pkg/x.X")
	if si < 0 || !same(gc.Mod.Structs[si].Typ, x) || len(x.Fields) != 1 {
		return fail("X should be registered as its struct, filled")
	}
	return ""
}

// An opaque type nothing defines (a `.bni`-only package's `type X`), met
// unregistered, is registered as an opaque-exported named type with no underlying.
func TestMetOpaqueRegistered() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype X\n")
	var x @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	if !same(lookupTypeAlias(gc, "pkg/x.X"), x) || x.Underlying != nil ||
			!charsEqual(x.OpaqueExportPkg, "pkg/x") {
		return fail("X should be an opaque-exported named type of pkg/x")
	}
	if gc.PendingNamedTypes != nil && gc.PendingNamedTypes.Has("pkg/x.X") {
		return fail("X should not wait for an underlying")
	}
	return ""
}

// An interface met unregistered whose parent is unregistered too: the parent, met
// while the interface's method set is filled, is registered and completed in the
// same drain.
func TestMetIfaceWithMetParent() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ninterface P { A() }\ninterface I : P { B() }\n")
	_ = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[1]))
	var ii int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	var pi int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "P")
	if ii < 0 || pi < 0 || gc.Mod.Interfaces[ii].IsStub || gc.Mod.Interfaces[pi].IsStub {
		return fail("I and P should be registered, complete")
	}
	var parents @[]@[]char = gc.Mod.Interfaces[ii].ParentNames
	if len(parents) != 1 || !charsEqual(parents[0], "P") { return fail("I should extend P") }
	return ""
}

// The passes, reaching a struct, a named type and an interface the mapper
// registered, keep those entries: nothing is registered again.
func TestPassesKeepMetEntries() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ntype S struct { n int }\ntype N [2]int\ninterface I { M() }\n")
	var s @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	var n @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[1]))
	_ = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[2]))
	var structs int = len(gc.Mod.Structs)
	var named int = len(gc.Mod.TypeAliases)
	var ifaces int = len(gc.Mod.Interfaces)
	registerStructNames(gc, file.Decls, "pkg/x")
	registerTypeStubs(gc, file.Decls, "pkg/x")
	registerTypeDecls(gc, file.Decls, "pkg/x")
	collectDeclaredInterfaces(gc, file.Decls, "pkg/x")
	fillDeclaredStructFields(gc, file.Decls, "pkg/x")
	if len(gc.Mod.Structs) != structs || len(gc.Mod.TypeAliases) != named ||
			len(gc.Mod.Interfaces) != ifaces {
		return fail("the passes should register nothing again")
	}
	if !same(lookupTypeAlias(gc, "pkg/x.N"), n) || lookupStructIdx(gc, "pkg/x.S") < 0 ||
			!same(gc.Mod.Structs[lookupStructIdx(gc, "pkg/x.S")].Typ, s) {
		return fail("S and N should stay the types the mapper registered")
	}
	return ""
}

// While types are named (GenCtx.NamingInstances), a struct met unregistered is named
// by a placeholder, not registered.
func TestNamingRegistersNothing() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype S struct { n int }\n")
	var structs int = len(gc.Mod.Structs)
	gc.NamingInstances = true
	var s @types.Type = irTypeFromChecker(gc, declaredTypeRecord(gc, file.Decls[0]))
	gc.NamingInstances = false
	if s == nil || len(gc.Mod.Structs) != structs || gc.LazyTypes != nil {
		return fail("naming S should register nothing")
	}
	return ""
}

// ringLen is how many structs the ring test's ring holds: far past what a call per
// link could hold on its stack.
const ringLen int = 20000

// TestDeepMetStructRing maps one struct of a ring of ringLen, each pointing to the
// next, none registered: every one is registered and filled, in a loop over the
// queue rather than a call per link.  (A TestDeep, skipped on the VM and bare-metal
// lanes, which take minutes over its 20,000 declarations.)
func TestDeepMetStructRing() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var decls @[]@ast.Decl = make_slice(@ast.Decl, ringLen)
	for i := 0; i < ringLen; i++ {
		var next @ast.TypeExpr = make(ast.TypeExpr)
		next.Kind = ast.TEXPR_POINTER
		next.Base = namedTypeExpr(buf.Concat("S", strconv.Itoa((i + 1) % ringLen)))
		var f @ast.FieldDecl = make(ast.FieldDecl)
		f.Name = buf.CopyStr("next")
		f.Type = next
		var st @ast.TypeExpr = make(ast.TypeExpr)
		st.Kind = ast.TEXPR_STRUCT
		st.Fields = @[]@ast.FieldDecl{f}
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_TYPE
		d.Name = buf.Concat("S", strconv.Itoa(i))
		d.TypeRef = st
		decls[i] = d
	}
	var file @ast.File = checkedDeclFile(gc.Mod, "pkg/r", decls)
	var s0 @types.Type = typeFromRecord(gc, declaredTypeRecord(gc, file.Decls[0]))
	for i := 0; i < ringLen; i++ {
		var si int = lookupStructIdx(gc, buf.Concat("pkg/r.S", strconv.Itoa(i)))
		if si < 0 || len(gc.Mod.Structs[si].Typ.Fields) != 1 {
			return fail("every struct of the ring should be registered and filled")
		}
	}
	var last int = lookupStructIdx(gc, buf.Concat("pkg/r.S", strconv.Itoa(ringLen - 1)))
	if !same(gc.Mod.Structs[last].Typ.Fields[0].Type.Elem, s0) {
		return fail("the ring should close at S0")
	}
	return ""
}
