package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/containers/table"
import "pkg/std/strconv"

// Tests for gen_type_record.bn: the checker's records as IR-gen reads them.

// pointerChain returns n pointer types around leaf (*...*leaf).
func pointerChain(leaf @types.Type, n int) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		t = types.MakePointerType(t)
	}
	return t
}

// A type is abstract when a type parameter or Self occurs in it, however deep: a
// chain of 5000 pointers to int is concrete and one to Self abstract, as are an
// unnamed struct holding such a chain and an instance whose type argument is
// Self.  A named type's definition is not walked into, so a self-referring one
// ends the walk.
func TestIsAbstractTypeAtAnyDepth() testing.TestResult {
	if isAbstractType(pointerChain(types.TypInt(), 5000)) {
		return fail("a chain of pointers to int is concrete")
	}
	if !isAbstractType(pointerChain(types.TypSelf(), 5000)) {
		return fail("a chain of pointers to Self is abstract")
	}
	var f @types.Field = make(types.Field)
	f.Name = buf.CopyStr("x")
	f.Type = pointerChain(types.TypSelf(), 3)
	var none @[]char
	var st @types.Type = types.MakeStructType(none, @[]@types.Field{f})
	if !isAbstractType(types.MakeSliceType(st)) {
		return fail("an unnamed struct holding Self is abstract")
	}
	var inst @types.Type = types.MakeNamedType(buf.CopyStr("test.Box"))
	inst.InstArgs = @[]@types.Type{types.TypSelf()}
	if !isAbstractType(inst) { return fail("an instance whose type argument is Self is abstract") }
	var link @types.Field = make(types.Field)
	link.Name = buf.CopyStr("next")
	var s @types.Type = types.MakeStructType(buf.CopyStr("test.S"), @[]@types.Field{link})
	link.Type = types.MakePointerType(s)
	var selfRef bool = isAbstractType(types.MakePointerType(s))
	link.Type = nil
	if selfRef { return fail("a self-referring named type is concrete") }
	return ""
}

// A type nested more deeply than any fixed bound is taken from its record like any
// other: the differential notes nothing for a 40-level pointer type.
func TestTypeDifferentialQuietForDeepTypes() testing.TestResult {
	var src @[]char = buf.CopyStr("package \"main\"\nvar p ")
	for i := 0; i < 40; i++ {
		src = buf.Concat(src, "*")
	}
	src = buf.Concat(src, "int\nfunc main() { _ = p }\n")
	var got @[]char = diffOf(src)
	if len(got) > 0 { return fail(buf.Concat("nothing must be noted; got: ", got)) }
	return ""
}

// sharedStruct returns n levels of unnamed structs over int, each holding the level
// below twice -- one type reached along 2^n paths.
func sharedStruct(n int) @types.Type {
	var none @[]char
	var f @types.Field = make(types.Field)
	f.Name = buf.CopyStr("v")
	f.Type = types.TypInt()
	var t @types.Type = types.MakeStructType(none, @[]@types.Field{f})
	for i := 0; i < n; i++ {
		var x @types.Field = make(types.Field)
		x.Name = buf.CopyStr("x")
		x.Type = t
		var y @types.Field = make(types.Field)
		y.Name = buf.CopyStr("y")
		y.Type = t
		t = types.MakeStructType(none, @[]@types.Field{x, y})
	}
	return t
}

// A type reached along many paths is visited once: 40 levels of a struct holding
// the level below twice is walked in 41 visits, not 2^40.
func TestIsAbstractTypeVisitsASharedTypeOnce() testing.TestResult {
	if isAbstractType(sharedStruct(40)) { return fail("the shared struct is concrete") }
	return ""
}

// sharedAliasSrc returns a program declaring 40 levels of aliases, each of a type
// holding the level below twice (head, the level, mid, the level below, tail),
// over A0 = base, and a global of the top level.
func sharedAliasSrc(base *[]readonly char, head *[]readonly char, mid *[]readonly char,
		tail *[]readonly char) @[]char {
	var src @[]char = buf.Concat(buf.Concat("package \"main\"\ntype A0 = ", base), "\n")
	for i := 1; i <= 40; i++ {
		var below @[]char = buf.Concat("A", strconv.Itoa(i - 1))
		src = buf.Concat(src, buf.Concat(buf.Concat("type A", strconv.Itoa(i)), " = "))
		src = buf.Concat(src, buf.Concat(buf.Concat(head, below), buf.Concat(mid, below)))
		src = buf.Concat(src, buf.Concat(tail, "\n"))
	}
	return buf.Concat(src, "var g *A40\nfunc main() { _ = g }\n")
}

// A type shared through aliases is mapped once per mapping: 40 levels of aliases
// of a struct holding the level below twice generate, with one struct interned per
// level, and so do 40 levels of aliases of a function type taking it twice.
func TestSharedAliasTypesMapOnce() testing.TestResult {
	// The program's 41 nested pairs are a type of 2^43 bytes, past a 32-bit target's
	// largest object.
	var saved types.TargetInfo = types.GetTarget()
	setTarget64()
	defer { types.SetTarget(saved) }
	var m @ir.Module = genFromSourcePkg(
			sharedAliasSrc("struct { v int }", "struct { x ", "; y ", " }"))
	var anon int
	for i := 0; i < len(m.Structs); i++ {
		if len(m.Structs[i].Name) >= 7 && charsEqual(m.Structs[i].Name[:7], "__anon_") { anon++ }
	}
	if anon != 41 {
		return fail(buf.Concat("one struct per level expected; got ", strconv.Itoa(anon)))
	}
	_ = genFromSourcePkg(sharedAliasSrc("int", "*func(", ", ", ")"))
	return ""
}

// An alias of an alias registered before it takes that alias's registered type,
// rather than mapping the chain below it again: F0's type is F1's (one function type),
// and so is a variable's of type F0.
func TestAliasOfRegisteredAlias() testing.TestResult {
	var m @ir.Module = genFromSourcePkg(
			"package \"main\"\ntype F1 = *func(int) int\ntype F0 = F1\nvar g F0\n"
					"func main() { _ = g }\n")
	var f0 @types.Type
	var f1 @types.Type
	for i := 0; i < len(m.TypeAliases); i++ {
		var n @[]char = m.TypeAliases[i].Name
		if len(n) >= 2 && charsEqual(n[len(n) - 2:], "F0") { f0 = m.TypeAliases[i].Typ }
		if len(n) >= 2 && charsEqual(n[len(n) - 2:], "F1") { f1 = m.TypeAliases[i].Typ }
	}
	if f0 == nil || f1 == nil { return fail("F0 and F1 should both be registered") }
	if !same(f0, f1) { return fail("F0's registered type should be F1's") }
	return ""
}

// A recorded alias declaration stands for its registration only while its name still
// holds it: not once a REPL entry undone drops the registration, nor once another
// declaration of the name holds it.
func TestRegisteredAliasTypeChecksRegistration() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var t1 @types.Type = types.MakePointerType(types.TypInt())
	var rec @types.Type = types.MakeAliasType(buf.CopyStr("A"), types.TypInt())
	var ta irsym.ModuleTypeAlias
	ta.Name = buf.CopyStr("test.A")
	ta.Typ = t1
	ir.RegisterModuleTypeAlias(gc.Mod, ta)
	gc.AliasDecls = table.NewTable[@types.Type, AliasDecl, TypeHasher, TypeEq](TypeHasher{}, TypeEq{})
	var rd AliasDecl
	rd.Name = buf.CopyStr("test.A")
	rd.Typ = t1
	gc.AliasDecls.Put(rec, rd)
	if !same(registeredAliasType(gc, rec), t1) { return fail("the registration should be found") }
	gc.Mod.TypeAliases = gc.Mod.TypeAliases[:0]
	if registeredAliasType(gc, rec) != nil { return fail("an undone registration is not used") }
	ta.Typ = types.MakePointerType(types.TypInt8())
	ir.RegisterModuleTypeAlias(gc.Mod, ta)
	if registeredAliasType(gc, rec) != nil { return fail("another declaration's is not used") }
	return ""
}

// aliasChain returns n aliases around target, each of the one inside it.
func aliasChain(target @types.Type, n int) @types.Type {
	var t @types.Type = target
	for i := 0; i < n; i++ {
		t = types.MakeAliasType(buf.CopyStr("A"), t)
	}
	return t
}

// A record is found concrete once: the links of a chain of aliases over a concrete type
// are kept, and an alias over one of them is concrete at it; a chain over Self is
// abstract, and none of its links is kept.
func TestConcreteRecordsKept() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var chain @types.Type = aliasChain(types.MakePointerType(types.TypInt()), 5)
	if isAbstractTypeKept(gc, chain) { return fail("a chain over *int is concrete") }
	if !gc.ConcreteRecords.Has(chain) || !gc.ConcreteRecords.Has(chain.Target.Target) {
		return fail("the chain's links are kept")
	}
	var over @types.Type = types.MakeAliasType(buf.CopyStr("B"), chain.Target)
	if isAbstractTypeKept(gc, over) || !gc.ConcreteRecords.Has(over) {
		return fail("an alias over a kept link is concrete, and kept")
	}
	var abstract @types.Type = aliasChain(types.MakePointerType(types.TypSelf()), 3)
	if !isAbstractTypeKept(gc, abstract) || gc.ConcreteRecords.Has(abstract) {
		return fail("a chain over Self is abstract, and not kept")
	}
	return ""
}

// releaseAliasChain drops a chain of aliases a link at a time, so its release does not
// nest one destruction per link.
func releaseAliasChain(t @types.Type) {
	var cur @types.Type = t
	for cur != nil && cur.Kind == types.TYP_ALIAS {
		var next @types.Type = cur.Target
		cur.Target = nil
		cur = next
	}
}

// A chain of aliases far longer than a stack could follow a call per link maps to the
// type it ends at -- alone, and in a record holding it twice, where the second is
// reached through the mappings the first kept.
func TestDeepAliasChainRecord() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var chain @types.Type = aliasChain(types.MakePointerType(types.TypInt()), deepChain)
	var alone @types.Type = typeFromRecord(gc, chain)
	var x @types.Field = make(types.Field)
	x.Name = buf.CopyStr("x")
	x.Type = chain
	var y @types.Field = make(types.Field)
	y.Name = buf.CopyStr("y")
	y.Type = chain
	var none @[]char
	var st @types.Type = types.MakeStructType(none, @[]@types.Field{x, y})
	var twice @types.Type = typeFromRecord(gc, st)
	x.Type = nil
	y.Type = nil
	releaseAliasChain(chain)
	if alone.Kind != types.TYP_POINTER || alone.Elem.Kind != types.TYP_INT {
		return fail("the chain should map to a pointer to int")
	}
	if twice.Kind != types.TYP_STRUCT || len(twice.Fields) != 2 ||
			!same(twice.Fields[1].Type, twice.Fields[0].Type) {
		return fail("both fields should map to the chain's one type")
	}
	return ""
}
