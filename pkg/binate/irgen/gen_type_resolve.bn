package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ir"
import "pkg/binate/iriface"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irsym"
import "pkg/binate/stringutils"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Type resolution (syntax TypeExpr → types.Type)
// ============================================================
//
// resolveTypeExpr and its helpers (ifaceValueTypesAgree,
// findAnonStruct), split out of gen_util.bn for file-length hygiene.

// ifaceValueTypesAgree reports whether two iface-value types
// wrap the same canonical interface.  Both sides are resolved
// through the alias chain (canonicalIfacePkg / canonicalIfaceName)
// before comparing, so an interface and a re-export alias of it
// (`interface Greeter = inner.Greeter`) agree — they ARE the same
// interface, with an identical vtable layout, so no OP_IFACE_UPCAST
// (vtable base adjustment) is wanted.  Comparing the raw (Pkg, Name)
// instead treats the alias as a distinct interface, emits a spurious
// upcast, and IfaceParentSlotOffset then returns -1 (the alias is not
// a PARENT of its target) — used as a GEP offset that walks the
// vtable pointer one slot BEFORE its base, so the dispatched method
// slot loads the dtor word and the call jumps through null.  Kind
// differences (raw vs managed) flow through here as "not the
// same" — those go through the upcast path too (managed-to-raw
// decay across the same interface).
func ifaceValueTypesAgree(m @ir.Module, a @types.Type, b @types.Type) bool {
	if a == nil || b == nil { return false }
	if a.Kind != b.Kind { return false }
	if a.Elem == nil || b.Elem == nil { return false }
	if a.Elem.Kind != types.TYP_INTERFACE { return false }
	if b.Elem.Kind != types.TYP_INTERFACE { return false }
	var aPkg @[]char = iriface.CanonicalIfacePkg(m, a.Elem.Pkg, a.Elem.Name)
	var aName @[]char = iriface.CanonicalIfaceName(m, a.Elem.Pkg, a.Elem.Name)
	var bPkg @[]char = iriface.CanonicalIfacePkg(m, b.Elem.Pkg, b.Elem.Name)
	var bName @[]char = iriface.CanonicalIfaceName(m, b.Elem.Pkg, b.Elem.Name)
	return irutil.CharEq(aPkg, bPkg) && irutil.CharEq(aName, bName)
}

// irResolveParamType resolves a function parameter's IR type from its AST decl.
// For a variadic parameter (`name ...T`, pd.Variadic) the in-body type is the
// raw slice *[]T (func.variadic.decl) and pd.Type is the element type T: the
// parameter's type expression records T, so the *[]T derivation lives here,
// mirroring resolveFuncDeclType in the checker.  Every IR param loop / FuncSig
// build uses this so the callee param, FuncSig entry, and interface flat-param
// are all *[]T (never the scalar element).
func irResolveParamType(gc @GenCtx, pd @ast.ParamDecl) @types.Type {
	var pt @types.Type = resolveTypeExpr(gc, pd.Type)
	if pd.Variadic {
		return types.MakeSliceType(pt)
	}
	return pt
}

// declIsVariadic reports whether a func/method decl's final parameter is
// variadic — the value stamped on FuncSig.IsVariadic so a call site can detect a
// variadic callee.
func declIsVariadic(d @ast.Decl) bool {
	var n int = len(d.Params)
	if n == 0 { return false }
	return d.Params[n - 1].Variadic
}

// resolveTypeExpr returns IR-gen's type for the type expression te: the
// checker's record of what te denotes, mapped (typeFromRecord), or void for no
// type expression.  No record is an internal error (noTypeRecordICE), and so is a
// record IR-gen cannot map -- an abstract one (requireConcreteRecord), or a
// concrete one it cannot represent.
func resolveTypeExpr(gc @GenCtx, te @ast.TypeExpr) @types.Type {
	if te == nil { return types.TypVoid() }
	var rec @types.Type = typeExprRecord(gc, te)
	if rec == nil { noTypeRecordICE(te.Pos) }
	return typeFromRecord(gc, requireConcreteRecord(gc, rec, te.Pos, "a type expression"))
}

// internAnonStruct returns the anonymous struct type with these fields: the one
// already registered with identical field names and types, else a new one
// registered under a synthetic name (`__anon_N`) for codegen.
func internAnonStruct(gc @GenCtx, fields @[]@types.Field) @types.Type {
	var existing @types.Type = findAnonStruct(gc, fields)
	if existing != nil {
		return existing
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__anon_")
	stringutils.WriteInt(cb, gc.AnonStructCounter)
	gc.AnonStructCounter = gc.AnonStructCounter + 1
	var synthName @[]char = buf.CopyStr(cb.String())
	var anonTyp @types.Type = types.MakeStructType(synthName, fields)
	var ms irsym.ModuleStruct
	ms.Name = synthName
	ms.Typ = anonTyp
	ms.Fields = fields
	ir.RegisterModuleStruct(gc.Mod, ms)
	return anonTyp
}

// findAnonStruct looks for an existing anonymous struct in gc.Mod.Structs
// with identical field names and types, `readonly` included (IdenticalStrict):
// a struct is the type its fields are written with, not one of the same layout.
func findAnonStruct(gc @GenCtx, fields @[]@types.Field) @types.Type {
	for i := 0; i < len(gc.Mod.Structs); i++ {
		var ms irsym.ModuleStruct = gc.Mod.Structs[i]
		if ms.Typ == nil { continue }
		if ms.Typ.Kind != types.TYP_STRUCT { continue }
		// Only match synthetic anonymous names
		if len(ms.Name) < 7 { continue }
		if ms.Name[0] != '_' || ms.Name[1] != '_' { continue }
		if len(ms.Typ.Fields) != len(fields) { continue }
		var match bool = true
		for j := 0; j < len(fields); j++ {
			if !irutil.Streq(ms.Typ.Fields[j].Name, fields[j].Name) {
				match = false
			}
			if !ms.Typ.Fields[j].Type.IdenticalStrict(fields[j].Type) {
				match = false
			}
		}
		if match { return ms.Typ }
	}
	return nil
}

// genericInstanceName returns the name of the generic type instance the
// expression e (`Box[int]`, `pkg.Box[int]`) names, or empty when it names none:
// the checker's record of the type e names (an abstract one is an internal
// error: requireConcreteRecord).  An e with no record of a type names none -- an
// index expression (`arr[i]`, `lib.Box[i]` on a variable lib) is spelled the
// same way.
func genericInstanceName(ctx @GenContext, e @ast.Expr) @[]char {
	if e == nil || e.X == nil { return "" }
	var rec @types.Type = exprDenotedRecord(ctx.Gc, e)
	if rec == nil { return "" }
	return baseNamedTypeName(
			typeFromRecord(ctx.Gc, requireConcreteRecord(ctx.Gc, rec, e.Pos, "a generic type instance")))
}

// noTypeRecordICE is the internal error for a type expression, or a type argument,
// at pos that the checker kept no record of: IR-gen reads every type from the
// checker's records.
func noTypeRecordICE(pos token.Pos) {
	var at @[]char = buf.Concat("internal error: the checker kept no record of the type at ",
			token.PosString(pos))
	panic(buf.Concat(at, " for IR-gen (compiler bug)"))
}
