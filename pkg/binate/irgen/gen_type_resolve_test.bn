package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_type_resolve.bn: resolveTypeExpr (including the
// TEXPR_PAREN look-through) and ifaceValueTypesAgree (alias-chain
// canonicalization).

// resolveTypeExpr must look through TEXPR_PAREN; otherwise any
// parenthesized type (e.g., *(*[]readonly char), *([N]int)) resolves to void and
// downstream codegen emits `load void, void* ...`. Regression guard for
// conformance test 271.
func TestResolveTypeExprParen() testing.TestResult {
	// int
	var inner @ast.TypeExpr = make(ast.TypeExpr)
	inner.Kind = ast.TEXPR_NAMED
	inner.Name = "int"
	// (*[]int) — paren-wrapped slice (element of pointer)
	var slice @ast.TypeExpr = make(ast.TypeExpr)
	slice.Kind = ast.TEXPR_SLICE
	slice.Base = inner
	var paren @ast.TypeExpr = make(ast.TypeExpr)
	paren.Kind = ast.TEXPR_PAREN
	paren.Base = slice
	// *(*[]int)
	var ptr @ast.TypeExpr = make(ast.TypeExpr)
	ptr.Kind = ast.TEXPR_POINTER
	ptr.Base = paren

	var resolved @types.Type = resolveTypeExpr(NewGenCtx(nil), ptr)
	if resolved == nil { return fail("resolved was nil") }
	if resolved.Kind != types.TYP_POINTER { return fail("expected TYP_POINTER") }
	if resolved.Elem == nil { return fail("pointer Elem was nil") }
	if resolved.Elem.Kind != types.TYP_SLICE {
		return fail("expected TYP_SLICE element, got void means TEXPR_PAREN fell through")
	}
	if resolved.Elem.Elem == nil { return fail("slice Elem was nil") }
	if resolved.Elem.Elem.Kind != types.TYP_INT { return fail("expected TYP_INT element of slice") }
	return ""
}

// ifaceValueTypesAgree must resolve both sides through the alias
// chain: an interface and an alias of it (`interface Shutter =
// Closer`) ARE the same interface (identical vtable layout), so
// assigning / returning one as the other needs NO OP_IFACE_UPCAST.
// Comparing the raw (Pkg, Name) instead treats them as distinct,
// emits a spurious upcast, and IfaceParentSlotOffset returns -1 (the
// alias is not a PARENT of its target) — used as a GEP index it walks
// the vtable pointer one slot before its base, so the dispatch loads
// the dtor word (null) and jumps through null.  (This is the
// transitive-re-export SIGSEGV in conformance/665.)
func TestIfaceValueTypesAgreeAlias() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Closer { Close() }\n"
			"interface Shutter = Closer\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	var closerVal @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("test", "Closer"))
	var shutterVal @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("test", "Shutter"))
	if !ifaceValueTypesAgree(m, closerVal, shutterVal) {
		return fail("Closer and its alias Shutter must agree (no upcast)")
	}
	if !ifaceValueTypesAgree(m, shutterVal, closerVal) {
		return fail("agreement must be symmetric (Shutter vs Closer)")
	}
	return ""
}

// The flip side: two genuinely distinct interfaces must NOT agree, so
// a real cross-interface assignment still routes through the upcast
// path.  Guards against the canonicalization over-collapsing.
func TestIfaceValueTypesAgreeDistinct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Closer { Close() }\n"
			"interface Reader { Read() int }\n"
			"func main() { }\n"
	var m @ir.Module = genFromSourcePkg(src)
	var closerVal @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("test", "Closer"))
	var readerVal @types.Type = types.MakeManagedInterfaceValueType(
			types.MakeInterfaceType("test", "Reader"))
	if ifaceValueTypesAgree(m, closerVal, readerVal) {
		return fail("distinct interfaces Closer / Reader must not agree")
	}
	return ""
}

// genericInstanceName tells a generic type's instance (`Box[int]`, the base of a
// method expression) from an index expression spelled the same way (`arr[i]`),
// which names no type — with an identifier index, as `entries[i]`, it has the
// shape of an instance: only an instance resolves.
func TestGenericInstanceName() testing.TestResult {
	var ctx @GenContext = make(GenContext)
	ctx.Gc = genFromSourcePkgGc(
			"package \"main\"\ntype Box[T any] struct { v T }\nvar arr [2]int\nvar i int\n")
	var inst @ast.Expr = mustParseExpr(parser.New(strToBytes("Box[int]"), "e"))
	if len(genericInstanceName(ctx, inst)) == 0 { return "Box[int] should name an instance of Box" }
	var idx @ast.Expr = mustParseExpr(parser.New(strToBytes("arr[i]"), "e"))
	if len(genericInstanceName(ctx, idx)) != 0 { return "arr[i] names no type" }
	// A head that names no generic type and no variable in scope is no instance
	// either — it is not resolved.
	var unbound @ast.Expr = mustParseExpr(parser.New(strToBytes("zz[i]"), "e"))
	if len(genericInstanceName(ctx, unbound)) != 0 { return "zz[i] names no type" }
	return ""
}

// A generic struct declaration registers no struct of its own in the
// single-file path either: only its instances are structs.
func TestGenModuleSkipsGenericStructDecl() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"main\"\ntype Box[T any] struct { v T }\nfunc f(b Box[int]) int { return b.v }\n")
	for i := 0; i < len(m.Structs); i++ {
		if seq(m.Structs[i].Name, "main.Box") {
			return "a generic struct declaration registered a struct"
		}
	}
	return ""
}

// anonFields returns one field `a` of type t.
func anonFields(t @types.Type) @[]@types.Field {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f @types.Field = make(types.Field)
	f.Name = "a"
	f.Type = t
	fields[0] = f
	return fields
}

// Anonymous structs that differ only in a field's `readonly` are interned as two
// structs, each with its own field types, and the same struct again is the one
// interned first.
func TestInternAnonStructKeepsReadonly() testing.TestResult {
	var gc @GenCtx = NewGenCtx(ir.NewModule("test"))
	var plain @types.Type = internAnonStruct(gc, anonFields(types.TypInt()))
	var ro @types.Type = internAnonStruct(gc, anonFields(types.MakeReadonlyType(types.TypInt())))
	if same(plain, ro) {
		return fail("a struct whose field is readonly must not be interned as the one whose is not")
	}
	if ro.Fields[0].Type.Kind != types.TYP_READONLY ||
			plain.Fields[0].Type.Kind == types.TYP_READONLY {
		return fail("each struct must keep its own field types")
	}
	if !same(internAnonStruct(gc, anonFields(types.TypInt())), plain) {
		return fail("the same struct must be interned once")
	}
	return ""
}
