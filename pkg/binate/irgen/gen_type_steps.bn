package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irsym"
import "pkg/binate/irutil"
import "pkg/binate/types"

// The steps that register a package's type declarations, which every pass over a
// package's declarations takes, in this order: the structs' names
// (registerStructNames); the generic structs' and interfaces' stashes and the other
// interfaces' stubs (registerTypeStubs); the named types and aliases
// (registerTypeDecls -- before them, in the pass over every loaded package, the
// opaque types nothing defines: registerOpaqueForwards); the interfaces' method sets
// (collectDeclaredInterfaces); and the structs' fields (fillDeclaredStructFields).  A
// type naming one declared later in its package then resolves to it
// (decl.order.forward), and a pass over several packages takes each step for every
// one of them before the next, so one naming a type of another package does too.  A
// step registers a declaration once: a name registered already, by an earlier pass,
// is left alone.

// registerStructNames registers each non-generic struct declared among decls, in
// the package whose path is path, under its qualified name with no fields yet
// (fillDeclaredStructFields fills them), unless one is registered under that name.
func registerStructNames(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if !isStructTypeDecl(d) || len(d.TypeParams) > 0 || isBlankDecl(d) { continue }
		var qn @[]char = irutil.QualifyForPkgPath(path, declaredTypeName(gc, d))
		if lookupStructIdx(gc, qn) >= 0 { continue }
		var ms irsym.ModuleStruct
		ms.Name = qn
		var noFields @[]@types.Field
		ms.Typ = types.MakeStructType(qn, noFields)
		ir.RegisterModuleStruct(gc.Mod, ms)
	}
}

// registerTypeStubs stashes the generic interfaces and generic types declared among
// decls, in the package whose path is path, for their instances to be made from, and
// then registers each other interface's identity (registerIfaceStub), so a type
// naming an interface resolves before its method set is collected -- and an
// interface may name a generic declared after it.
func registerTypeStubs(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_INTERFACE && len(d.TypeParams) > 0 && !isBlankDecl(d) {
			stashGenericIfaceDecl(gc, d, path)
		}
	}
	for i := 0; i < len(decls); i++ {
		if isGenericTypeDecl(decls[i]) && !isBlankDecl(decls[i]) {
			stashGenericTypeDecl(gc, decls[i], path)
		}
	}
	for i := 0; i < len(decls); i++ {
		if !isBlankDecl(decls[i]) { registerIfaceStub(gc, decls[i], path) }
	}
}

// registerOpaqueForwards registers each opaque type declared among decls without a
// body (`type X`) and defined by none of them, in the package whose path is path, as
// a named type with no underlying, unless a struct or type is registered under its
// name.  A forward its package's source defines -- the loader puts a `.bni`'s
// forwards in its package's merged file -- is left to that definition
// (registerStructNames, registerTypeDecls).  An undefined one reaches IR-gen from a
// package available as a `.bni` alone: a compiled library injected as externs (an
// interpreted bnld driver's `link.*`), or any build against a precompiled package's
// interface.  The layout stays with the
// defining package's compiled `.bn`; an importer may only hold `@X` / `*X` and call
// methods, so X's name -- which mangles its method and destructor externs -- is all
// it needs.  The type is marked opaque-exported, so a managed `@X` drop releases
// through the defining package's destructor (emitManagedPtrRefDec's opaque arm)
// rather than freeing with no destructor, leaking what X holds.  A from-source build
// registers the full struct instead (registerStructNames).
func registerOpaqueForwards(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_TYPE || d.TypeRef != nil || d.IsAlias || len(d.TypeParams) > 0 ||
				isBlankDecl(d) || typeDeclDefines(decls, d.Name) {
			continue
		}
		var qn @[]char = irutil.QualifyForPkgPath(path, declaredTypeName(gc, d))
		if lookupStructIdx(gc, qn) >= 0 || lookupTypeAlias(gc, qn) != nil { continue }
		var ot @types.Type = types.MakeNamedType(qn)
		ot.OpaqueExportPkg = buf.CopyStr(path)
		var ta irsym.ModuleTypeAlias
		ta.Name = qn
		ta.Typ = ot
		ir.RegisterModuleTypeAlias(gc.Mod, ta)
	}
}

// collectDeclaredInterfaces collects the method set of each non-generic interface
// declared among decls, in the package whose path is path, into its stub
// (collectInterfaceFromDecl).
func collectDeclaredInterfaces(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_INTERFACE && len(d.TypeParams) == 0 && !isBlankDecl(d) {
			collectInterfaceFromDecl(gc, d, path)
		}
	}
}

// fillDeclaredStructFields fills, in place (fillStructFields), the fields of each
// non-generic struct declared among decls, in the package whose path is path, that
// is registered with none yet; a generic struct's instances get theirs from the
// checker's copy of its declaration (ensureInstantiatedStruct).
func fillDeclaredStructFields(gc @GenCtx, decls *[]@ast.Decl, path *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if !isStructTypeDecl(d) || len(d.TypeParams) > 0 || isBlankDecl(d) { continue }
		var si int = lookupStructIdx(gc, irutil.QualifyForPkgPath(path, declaredTypeName(gc, d)))
		if si < 0 || len(gc.Mod.Structs[si].Typ.Fields) > 0 { continue }
		fillStructFields(gc, si, d)
	}
}
