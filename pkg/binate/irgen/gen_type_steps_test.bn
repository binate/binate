package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iriface"
import "pkg/binate/irsym"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_type_steps.bn: the steps that register a package's type declarations.

// A non-generic struct is registered once, under its qualified name and with no
// fields yet; a generic one is not registered.
func TestRegisterStructNamesOnce() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ntype S struct { n int }\ntype G[T any] struct { v T }\n")
	var before int = len(gc.Mod.Structs)
	registerStructNames(gc, file.Decls, "pkg/x")
	registerStructNames(gc, file.Decls, "pkg/x")
	if len(gc.Mod.Structs) != before + 1 { return fail("S should be registered once, G not at all") }
	var si int = lookupStructIdx(gc, "pkg/x.S")
	if si < 0 || len(gc.Mod.Structs[si].Typ.Fields) != 0 {
		return fail("S should be registered with no fields yet")
	}
	return ""
}

// A registered struct with no fields gets its fields; one that has them keeps them.
func TestFillDeclaredStructFieldsOnce() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype S struct { n int }\n")
	registerStructNames(gc, file.Decls, "pkg/x")
	fillDeclaredStructFields(gc, file.Decls, "pkg/x")
	var si int = lookupStructIdx(gc, "pkg/x.S")
	var fields @[]@types.Field = gc.Mod.Structs[si].Typ.Fields
	if len(fields) != 1 || !charsEqual(fields[0].Name, "n") { return fail("S should get its field n") }
	fillDeclaredStructFields(gc, file.Decls, "pkg/x")
	if !same(gc.Mod.Structs[si].Typ.Fields, fields) { return fail("S's fields should be left alone") }
	return ""
}

// The generic interfaces and types are stashed, and the other interfaces stubbed.
func TestRegisterTypeStubs() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x",
			"package \"pkg/x\"\ninterface I { M() int }\ninterface J[T any] { Get() T }\n"
					"type B[T any] struct { v T }\n")
	registerTypeStubs(gc, file.Decls, "pkg/x")
	var idx int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	if idx < 0 || !gc.Mod.Interfaces[idx].IsStub { return fail("I should have a stub") }
	if lookupGenericIfaceDeclPkg(gc, "pkg/x", "J") == nil { return fail("J should be stashed") }
	if lookupGenericTypeDeclPkg(gc, "pkg/x", "B") == nil { return fail("B should be stashed") }
	if iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "J") >= 0 {
		return fail("a generic interface has no stub of its own")
	}
	return ""
}

// A collected interface's stub gets its method set.
func TestCollectDeclaredInterfaces() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ninterface I { M() int }\n")
	registerTypeStubs(gc, file.Decls, "pkg/x")
	collectDeclaredInterfaces(gc, file.Decls, "pkg/x")
	var idx int = iriface.LookupModuleInterfaceIndex(gc.Mod, "pkg/x", "I")
	if idx < 0 || gc.Mod.Interfaces[idx].IsStub || len(gc.Mod.Interfaces[idx].MethodNames) != 1 {
		return fail("I's stub should carry its method")
	}
	return ""
}

// An opaque type of a package read from its `.bni` alone is registered as an
// opaque-exported named type with no underlying -- unless its name is registered.
func TestRegisterOpaqueForwards() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype X\ntype Y\n")
	var ms irsym.ModuleStruct
	ms.Name = buf.CopyStr("pkg/x.Y")
	var noFields @[]@types.Field
	ms.Typ = types.MakeStructType(ms.Name, noFields)
	ir.RegisterModuleStruct(gc.Mod, ms)
	registerOpaqueForwards(gc, file.Decls, "pkg/x")
	var x @types.Type = lookupTypeAlias(gc, "pkg/x.X")
	if x == nil || x.Kind != types.TYP_NAMED || x.Underlying != nil ||
			!charsEqual(x.OpaqueExportPkg, "pkg/x") {
		return fail("X should be an opaque-exported named type of pkg/x")
	}
	if lookupTypeAlias(gc, "pkg/x.Y") != nil { return fail("Y is registered as a struct already") }
	return ""
}

// In a package read from its `.bni` alone, an alias declared before the opaque type
// it names resolves to it: the pass over every loaded package registers the opaque
// types before the aliases.
func TestRegisterStructTypesAliasBeforeOpaque() testing.TestResult {
	var gc @GenCtx = NewGenCtx(testModule("test"))
	var file @ast.File = checkedBni(gc.Mod, "pkg/x", "package \"pkg/x\"\ntype A = *X\ntype X\n")
	RegisterStructTypes(@[]@[]char{"pkg/x"}, @[]@ast.File{file}, gc)
	var x @types.Type = lookupTypeAlias(gc, "pkg/x.X")
	if x == nil || !charsEqual(x.OpaqueExportPkg, "pkg/x") {
		return fail("X should be opaque-exported")
	}
	var a @types.Type = lookupTypeAlias(gc, "pkg/x.A")
	if a == nil || a.Kind != types.TYP_POINTER || !same(a.Elem, x) {
		return fail("A should be a pointer to X")
	}
	return ""
}

// A `.bni`'s forward that its package's source defines -- the merged file holds both
// -- is the defined type, not an opaque-exported one, in the pass over every loaded
// package.
func TestRegisterStructTypesForwardDefinedInSource() testing.TestResult {
	var m @ir.Module = testModule("test")
	var bp @parser.Parser = parser.NewInterface(strToBytes("package \"pkg/x\"\ntype X\n"), "x.bni")
	var bni @ast.File = mustParse(bp)
	var mp @parser.Parser = parser.New(strToBytes("package \"pkg/x\"\ntype X\ntype X int\n"), "x.bn")
	var merged @ast.File = mustParse(mp)
	checkPackageInto(moduleChecker(m), "pkg/x", bni, merged)
	var gc @GenCtx = NewGenCtx(m)
	RegisterStructTypes(@[]@[]char{"pkg/x"}, @[]@ast.File{merged}, gc)
	var x @types.Type = lookupTypeAlias(gc, "pkg/x.X")
	if x == nil || x.Kind != types.TYP_NAMED || x.Underlying == nil ||
			x.Underlying.Kind != types.TYP_INT {
		return fail("X should be the named type defined over int")
	}
	if len(x.OpaqueExportPkg) > 0 {
		return fail("X is defined in source: it should not be opaque-exported")
	}
	return ""
}
