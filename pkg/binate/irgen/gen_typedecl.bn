package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/ast"
import "pkg/binate/irsym"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Type-declaration resolution for IR-gen: the Module.TypeAliases entry
// type for a non-struct `DECL_TYPE`, plus the TYP_NAMED peelers IR-gen's
// ad-hoc Kind / width / signedness decisions go through.

// lookupTypeAlias returns the registered gc.Mod.TypeAliases `.Typ` for a
// non-struct type-decl `name`, or nil if not registered.  Like structs
// (lookupStructIdx), own-module entries are registered under their
// fully-qualified name, so a bare key is qualified to the current module first;
// an already-qualified key passes through.
func lookupTypeAlias(gc @GenCtx, name *[]readonly char) @types.Type {
	var qname @[]char = qualifyForCurrentModule(gc, name)
	for i := 0; i < len(gc.Mod.TypeAliases); i++ {
		if irutil.Streq(gc.Mod.TypeAliases[i].Name, qname) {
			return gc.Mod.TypeAliases[i].Typ
		}
	}
	return nil
}

// lookupTypeAliasEntry returns the gc.Mod.TypeAliases entry registered under
// `name` (qualified as lookupTypeAlias does), or a zero entry.
func lookupTypeAliasEntry(gc @GenCtx, name *[]readonly char) irsym.ModuleTypeAlias {
	var qname @[]char = qualifyForCurrentModule(gc, name)
	for i := 0; i < len(gc.Mod.TypeAliases); i++ {
		if irutil.Streq(gc.Mod.TypeAliases[i].Name, qname) { return gc.Mod.TypeAliases[i] }
	}
	var none irsym.ModuleTypeAlias
	return none
}

// registerTypeDeclEntry registers the Module.TypeAliases entry for the
// non-struct `DECL_TYPE` d under `name`.  An alias (`type X = U`)
// collapses to its underlying type `U` — it has no distinct identity.
// A distinct type (`type X U`) becomes a `TYP_NAMED` carrying `name`
// with `.Underlying = U`, mirroring the checker (check_decl.bn), so the
// named identity survives into IR-gen (method dispatch keys off the
// name via baseNamedTypeName) and the correct scalar layout survives
// into lowering (llvmType / typeBits / the VM and native backends peel
// `.Underlying`).  `name` is the type's fully-qualified name (its defining
// package's path + its name) wherever it is compiled — the package's own
// module, the import pre-pass over the package's own `.bni`, an importer —
// exactly as named structs are named: the name is the type's identity in
// every mangled symbol (method keys, generic instances such as `H[MyN]`,
// vtables), so a type named differently in two places would be two types.
// A distinct func-value type (`type Fn @func(int) int`) is no exception: its
// methods and impls key on `Fn`, and `Box[Fn]` is not `Box[@func(int) int]`;
// every func-value consumer looks through the named wrapper to the kind.
// A distinct type's entry pre-registered by preRegisterNamedTypeDecl gets its
// underlying here; otherwise the entry is registered before its underlying is
// resolved.  Either way an underlying that names the type itself through an
// indirection (`type StateFn @func(int) StateFn`, `type P *P`) resolves to it
// rather than to an unregistered name.
func registerTypeDeclEntry(gc @GenCtx, name @[]char, d @ast.Decl) {
	if !d.IsAlias && isPendingNamedType(gc, name) {
		var pending @types.Type = lookupTypeAlias(gc, name)
		pending.Underlying = resolveTypeExpr(gc, d.TypeRef)
		removePendingNamedType(gc, name)
		return
	}
	var ta irsym.ModuleTypeAlias
	ta.Name = name
	if d.IsAlias {
		ta.Typ = resolveTypeExpr(gc, d.TypeRef)
		gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		return
	}
	var named @types.Type = types.MakeNamedType(name)
	ta.Typ = named
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
	named.Underlying = resolveTypeExpr(gc, d.TypeRef)
}

// preRegisterNamedTypeDecl registers, under `name`, the named entry of the
// distinct (non-alias) non-struct type declaration d with its underlying not
// yet resolved, so that every declaration of a package that names it — its own
// underlying (`type Tree @[]Tree`), another type's (`type A @[]B; type B
// @func(A) B`), an alias's — resolves to it whatever order the declarations
// are resolved in; registerTypeDeclEntry resolves the underlying.  A name that
// is already registered is left alone.
func preRegisterNamedTypeDecl(gc @GenCtx, name @[]char, d @ast.Decl) {
	if !isNonStructTypeDecl(d) || d.IsAlias || lookupTypeAlias(gc, name) != nil { return }
	var ta irsym.ModuleTypeAlias
	ta.Name = name
	ta.Typ = types.MakeNamedType(name)
	gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
	gc.PendingNamedTypes = slices.Append[@[]char](gc.PendingNamedTypes, name)
}

// registerUndefinedForwardTypes registers, as a named type with no underlying,
// each of the module's forward type declarations `type X` among decls (groups
// included) that no declaration of all defines — X's layout is outside the
// program (C or asm), or nowhere — so that a reference to X (a pointer's
// pointee, a generic instance's type argument) resolves to X itself — and
// `PBox[X]` is an instance of its own.  X is left pending, so a definition
// registered later — at a REPL prompt, for a forward declaration in the
// session's file — fills it in place (registerTypeDeclEntry) rather than
// registering a second X that the first would shadow.  A forward declaration a
// declaration of all defines is registered by that definition, and an X already
// registered (the package interface's, registerSelfOpaque) is left alone.
func registerUndefinedForwardTypes(gc @GenCtx, all *[]@ast.Decl, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			registerUndefinedForwardTypes(gc, all, d.Decls)
			continue
		}
		if d.Kind != ast.DECL_TYPE || !d.IsForward || len(d.TypeParams) > 0 || isBlankDecl(d) { continue }
		if typeDeclDefines(all, d.Name) { continue }
		var qn @[]char = qualifyForCurrentModule(gc, d.Name)
		if lookupStructIdx(gc, qn) >= 0 || lookupTypeAlias(gc, qn) != nil { continue }
		var ta irsym.ModuleTypeAlias
		ta.Name = qn
		ta.Typ = types.MakeNamedType(qn)
		gc.Mod.TypeAliases = slices.Append[irsym.ModuleTypeAlias](gc.Mod.TypeAliases, ta)
		gc.PendingNamedTypes = slices.Append[@[]char](gc.PendingNamedTypes, qn)
	}
}

// typeDeclDefines reports whether decls (and the groups among them) hold a
// type declaration of name with a body.
func typeDeclDefines(decls *[]@ast.Decl, name *[]readonly char) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP && typeDeclDefines(d.Decls, name) { return true }
		if d.Kind == ast.DECL_TYPE && !d.IsForward && irutil.Streq(d.Name, name) { return true }
	}
	return false
}

// isPendingNamedType reports whether the named type `name` is registered with
// its underlying not resolved yet: pre-registered (preRegisterNamedTypeDecl), or
// an opaque type registered before its definition was seen (isUnfilledOpaque).
func isPendingNamedType(gc @GenCtx, name *[]readonly char) bool {
	for i := 0; i < len(gc.PendingNamedTypes); i++ {
		if irutil.Streq(gc.PendingNamedTypes[i], name) { return true }
	}
	var t @types.Type = lookupTypeAlias(gc, name)
	return t != nil && isUnfilledOpaque(t)
}

// isUnfilledOpaque reports whether t is an opaque named type — `type X` in a
// .bni, its definition elsewhere, or a forward declaration at the REPL prompt —
// whose definition has not been registered yet (Underlying nil).
// registerTypeDeclEntry fills it in place, so what already refers to it sees
// the definition.
func isUnfilledOpaque(t @types.Type) bool {
	return t.Kind == types.TYP_NAMED && len(t.OpaqueExportPkg) > 0 && t.Underlying == nil
}

// removePendingNamedType drops `name` from gc.PendingNamedTypes.
func removePendingNamedType(gc @GenCtx, name *[]readonly char) {
	var kept @[]@[]char
	for i := 0; i < len(gc.PendingNamedTypes); i++ {
		if !irutil.Streq(gc.PendingNamedTypes[i], name) {
			kept = slices.Append[@[]char](kept, gc.PendingNamedTypes[i])
		}
	}
	gc.PendingNamedTypes = kept
}

// typeDeclRegistered reports whether the type declaration registered under
// `name` is complete: registered, and — for a named type — its underlying
// resolved.
func typeDeclRegistered(gc @GenCtx, name *[]readonly char) bool {
	return lookupTypeAlias(gc, name) != nil && !isPendingNamedType(gc, name)
}

// typeIsSigned reports whether t — peeling every transparent wrapper (named /
// alias / readonly, types.StripWrappers) — is a signed integer.  The
// wrappers leave `.Signed` false on themselves, so reading it off a bare
// TYP_NAMED (`type S int8`) or TYP_READONLY (`readonly int8`, or the
// named-over-readonly `type R readonly int8`) would mis-classify a signed
// type as unsigned — e.g. dropping the `MIN / -1` overflow guard.
func typeIsSigned(t @types.Type) bool {
	t = types.StripWrappers(t)
	return t != nil && t.Signed
}

// isStructTypeDecl reports whether d declares a struct type: a DECL_TYPE whose
// body is a struct literal, not an alias.  `type X = struct { … }`
// names the anonymous struct (an alias is its target), which the alias path
// (isNonStructTypeDecl, registerTypeDeclEntry) registers, so it is no struct
// type of its own; a generic one (`type A[T any] = struct { … }`) is a generic
// alias, instantiated as its target (ensureInstantiatedAlias).
func isStructTypeDecl(d @ast.Decl) bool {
	return d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT &&
			!d.IsAlias
}

// isGenericTypeDecl reports whether d is a generic type declaration that use
// sites instantiate: one with type parameters over a struct body, over any
// other underlying type (gen.instantiate.type), or an alias of one of them or
// of any type (gen.instantiate.alias).
func isGenericTypeDecl(d @ast.Decl) bool {
	return d.Kind == ast.DECL_TYPE && d.TypeRef != nil && len(d.TypeParams) > 0
}

// isNonStructTypeDecl reports whether `d` is a non-generic `DECL_TYPE`
// whose body is NOT a struct literal — i.e. an alias or a distinct
// scalar/composite-reference type that belongs in Module.TypeAliases.
// (Struct type decls are registered separately as Module.Structs; a
// `type X = SomeStruct` alias still lands here because IsAlias decls
// always collapse to their target regardless of its kind.)
func isNonStructTypeDecl(d @ast.Decl) bool {
	if d.Kind != ast.DECL_TYPE || d.TypeRef == nil {
		return false
	}
	if len(d.TypeParams) != 0 {
		return false
	}
	if d.IsAlias {
		return true
	}
	return d.TypeRef.Kind != ast.TEXPR_STRUCT
}
