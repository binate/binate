package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_typedecl.bn: signedness through type wrappers and the
// non-struct type-decl predicate, and the nominal named func-value type.

// typeIsSigned reads signedness through every transparent wrapper: readonly,
// alias, and named-over-readonly (none of which carry `.Signed` themselves).
func TestTypeIsSignedPeelsReadonlyAndAlias() testing.TestResult {
	if !typeIsSigned(types.MakeReadonlyType(types.TypInt8())) {
		return fail("readonly int8 must read as signed")
	}
	if typeIsSigned(types.MakeReadonlyType(types.TypUint8())) {
		return fail("readonly uint8 must NOT read as signed")
	}
	if !typeIsSigned(types.MakeAliasType("I8", types.TypInt8())) {
		return fail("an alias of int8 must read as signed")
	}
	var r @types.Type = types.MakeNamedType("R")
	r.Underlying = types.MakeReadonlyType(types.TypInt8())
	if !typeIsSigned(r) {
		return fail("named-over-readonly int8 must read as signed")
	}
	return ""
}

// typeIsSigned reads signedness through the TYP_NAMED wrapper, since
// MakeNamedType leaves `.Signed` false on the wrapper itself.
func TestTypeIsSignedPeelsNamed() testing.TestResult {
	var s @types.Type = types.MakeNamedType("S")
	s.Underlying = types.TypInt8()
	if !typeIsSigned(s) {
		return fail("named int8 must read as signed")
	}
	var u @types.Type = types.MakeNamedType("B")
	u.Underlying = types.TypUint8()
	if typeIsSigned(u) {
		return fail("named uint8 must NOT read as signed")
	}
	return ""
}

// isNonStructTypeDecl accepts aliases and distinct non-struct type decls,
// rejecting struct decls (registered separately) and generic decls.
func TestIsNonStructTypeDecl() testing.TestResult {
	// Distinct non-struct (`type Fn @func(...)`) → true.
	var dDistinct @ast.Decl = make(ast.Decl)
	dDistinct.Kind = ast.DECL_TYPE
	var teFunc @ast.TypeExpr = make(ast.TypeExpr)
	teFunc.Kind = ast.TEXPR_MANAGED_FUNC_VALUE
	dDistinct.TypeRef = teFunc
	if !isNonStructTypeDecl(dDistinct) {
		return fail("distinct non-struct type decl must be accepted")
	}
	// Struct decl → false (registered as a moduleStruct, not an alias).
	var dStruct @ast.Decl = make(ast.Decl)
	dStruct.Kind = ast.DECL_TYPE
	var teStruct @ast.TypeExpr = make(ast.TypeExpr)
	teStruct.Kind = ast.TEXPR_STRUCT
	dStruct.TypeRef = teStruct
	if isNonStructTypeDecl(dStruct) {
		return fail("a distinct struct type decl must NOT be a non-struct alias")
	}
	// An alias to a struct still lands here (IsAlias collapses to target).
	dStruct.IsAlias = true
	if !isNonStructTypeDecl(dStruct) {
		return fail("an alias decl must be accepted regardless of target kind")
	}
	return ""
}

// A named func-value type is nominal in IR-gen — TYP_NAMED over its func value,
// registered under its qualified name — and a variable of it initialized from a
// function reference builds the OP_FUNC_VALUE at the bare func-value type,
// stored into a slot of the named type.
func TestNamedFuncValueTypeIsNominal() testing.TestResult {
	var m @ir.Module = genFromSourceWithChecker(
			"package \"test\"\ntype Fn @func(int) int\nfunc inc(x int) int { return x + 1 }\n"
					"func f() int { var g Fn = inc; return g(1) }\n")
	var fn @types.Type = nil
	for i := 0; i < len(m.TypeAliases); i++ {
		if seq(m.TypeAliases[i].Name, "test.Fn") { fn = m.TypeAliases[i].Typ }
	}
	if fn == nil || fn.Kind != types.TYP_NAMED { return fail("test.Fn: expected a TYP_NAMED entry") }
	var u @types.Type = types.StripWrappers(fn)
	if u == nil || u.Kind != types.TYP_MANAGED_FUNC_VALUE {
		return fail("test.Fn: expected over @func")
	}
	var f @ir.Func = deferFindFunc(m, "test.f")
	if f == nil { return fail("test.f not generated") }
	var sawFV bool = false
	var sawSlot bool = false
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			var ins @ir.Instr = f.Blocks[i].Instrs[j]
			if ins.Op == iropcode.OP_FUNC_VALUE && ins.Typ != nil &&
					ins.Typ.Kind == types.TYP_MANAGED_FUNC_VALUE {
				sawFV = true
			}
			if ins.Op == iropcode.OP_ALLOC && ins.TypeArg != nil && ins.TypeArg.Kind == types.TYP_NAMED {
				sawSlot = true
			}
		}
	}
	if !sawFV { return fail("expected an OP_FUNC_VALUE at the bare @func type") }
	if !sawSlot { return fail("expected the variable's slot typed with the named Fn") }
	return ""
}

// An alias of a struct literal is the anonymous struct, not a struct type of its
// own: no struct is registered under the alias's name, and `g[Anon]` and
// `g[struct { a int8; b int8 }]` are one instance.
func TestStructAliasIsAnonymousStruct() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"type Anon = struct { a int8; b int8 }\n"
					"func g[T any](x T) int { return 1 }\n"
					"func main() {\n"
					" var an Anon\n"
					" var lit struct { a int8; b int8 }\n"
					" var n int = g[Anon](an) + g[struct { a int8; b int8 }](lit)\n"
					" _ = n\n"
					"}\n")
	for i := 0; i < len(m.Structs); i++ {
		if containsSub(m.Structs[i].Name, "Anon") { return "expected no struct registered as Anon" }
	}
	var instances int = 0
	for i := 0; i < len(m.Funcs); i++ {
		if containsSub(m.Funcs[i].Name, "g__bn_inst") { instances = instances + 1 }
	}
	if instances != 1 { return "expected g[Anon] and g[struct{...}] to be one instance" }
	return ""
}

// A generic alias of a struct literal has no single target: it is instantiated
// as a generic struct, as the checker checks it.
func TestGenericStructAliasIsGenericStruct() testing.TestResult {
	var m @ir.Module = genCheckedPkg(
			"package \"main\"\n"
					"type A[T any] = struct { x T; y int64 }\n"
					"func main() { var a A[int8]; a.x = 3; var n int8 = a.x; _ = n }\n")
	for i := 0; i < len(m.Structs); i++ {
		if containsSub(m.Structs[i].Name, "A__bn_inst") { return "" }
	}
	return "expected A[int8] instantiated as a generic struct"
}
