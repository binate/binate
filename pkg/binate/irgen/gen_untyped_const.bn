package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/types"

// emitUntypedIntConst emits the value the type checker folded for e, an untyped
// integer constant expression (its type carries HasLitVal), as one constant —
// or returns nil when e is not one.  genBinary and genUnary both call it, so a
// constant is typed the same way whether its last operator is binary or unary
// (`0 - 5`, `-5`, `-(-lit)`, `~5`), instead of being computed from an operand's
// IR type.
//
// The constant's type must reflect the TRUE value, not its int64 bit pattern,
// because int->float conversion (and a comparison or division consuming it)
// picks signed vs unsigned off the type:
//   - outside int32 but within int64, a genuine negative (LitSign) takes the
//     signed TypInt64 (sitofp), and a non-negative magnitude >= 2^63 (LitSign
//     false, yet a NEGATIVE int64 bit pattern) the unsigned TypUint64 (uitofp);
//     otherwise `cast(float64, 9223372036854775807 + 1)` would be ~-9.2e18 and
//     `-9223372036854775808 / d` would divide unsigned.  TypUint64, a concrete
//     TYP_INT, converts unsigned uniformly on LLVM (uitofp) and the VM / native
//     backends (BC_UITOF / ucvtf), where a bare TypUntypedInt would not (their
//     predicate requires a concrete TYP_INT).  A concrete 64-bit type also holds
//     the full value on ILP32, where the untyped default is 32-bit;
//   - an in-int32 NEGATIVE value takes the host-width signed TypInt: TypUntypedInt
//     has Signed=false, so `cast(float64, 0 - 5)` or `cast(float64, ~5)` would
//     read it as a huge unsigned float.  The width is unchanged on ILP32;
//   - a non-negative in-int32 value stays untyped (it converts identically
//     either way).
func emitUntypedIntConst(ctx @GenContext, b @ir.Block, e @ast.Expr) @ir.Instr {
	if ctx.Checker == nil || e.ResolvedTypeID == 0 { return nil }
	var t @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
	if t == nil || !t.HasLitVal || t.Kind != types.TYP_UNTYPED_INT { return nil }
	ctx.CurBlock = b
	var v int64 = bignumToInt(t.LitMag, t.LitSign)
	if v < -2147483648 || v > 2147483647 {
		if !t.LitSign && v < 0 {
			return irbuild.EmitConstInt64(b, v, types.TypUint64())
		}
		return irbuild.EmitConstInt64(b, v, types.TypInt64())
	}
	if t.LitSign && t.LitMag != cast(uint64, 0) {
		return irbuild.EmitConstInt64(b, v, types.TypInt())
	}
	return irbuild.EmitConstInt64(b, v, types.TypUntypedInt())
}
