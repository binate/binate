package "pkg/binate/irgen"

import "pkg/binate/ir"

import "pkg/binate/buf"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitUntypedIntConst (gen_untyped_const.bn): an untyped integer
// constant expression, unary or binary, is emitted as the one value the
// checker folded, typed by its true sign.

// untypedConstOf generates src (one function) and returns its one integer
// constant of value v, or nil when there is not exactly one, or an OP_NEG was
// emitted (the constant is folded, not negated).
func untypedConstOf(src *[]readonly char, v int64) @ir.Instr {
	var m @ir.Module = genFromSourceWithChecker(src)
	if len(m.Funcs) < 1 { return nil }
	if firstOp(m.Funcs[0], iropcode.OP_NEG) != nil { return nil }
	var cs @[]@ir.Instr = constsWithValue(m.Funcs[0], v)
	if len(cs) != 1 { return nil }
	return cs[0]
}

// The int64 minimum written as `-9223372036854775808` is one SIGNED 64-bit
// constant — in a plain int64, readonly int64, alias of int64 or division
// context — not the negation of the literal's uint64 2^63, which made it
// divide, compare and convert to float as unsigned.  Host-LP64-only: on ILP32
// tryFoldOversizedConst emits such a magnitude before genUnary is reached.
func TestUntypedConstNegatedInt64Min() testing.TestResult {
	if types.GetTarget().IntSize < 8 { return "" }
	var srcs @[]@[]char = make_slice(@[]char, 4)
	srcs[0] = buf.CopyStr(
			"package \"test\"\n"
					"func main() { var x int64 = -9223372036854775808; _ = x }\n")
	srcs[1] = buf.CopyStr(
			"package \"test\"\n"
					"func main() { var x readonly int64 = -9223372036854775808; _ = x }\n")
	srcs[2] = buf.CopyStr(
			"package \"test\"\ntype W = int64\n"
					"func main() { var x W = -9223372036854775808; _ = x }\n")
	srcs[3] = buf.CopyStr(
			"package \"test\"\n"
					"func main() { var d int64 = 3; var q int64 = -9223372036854775808 / d; _ = q }\n")
	var min int64 = -9223372036854775807 - 1
	for k := 0; k < len(srcs); k++ {
		var c @ir.Instr = untypedConstOf(srcs[k], min)
		if c == nil { return fail("the int64 minimum should be one folded constant") }
		if !isIntOfWidth(c.Typ, 64, true) {
			return fail("the int64 minimum should be a signed 64-bit constant")
		}
	}
	return ""
}

// `-(-9223372036854775808)` is +2^63 — beyond int64, so an UNSIGNED 64-bit
// constant (its int64 bit pattern is the minimum).  Host-LP64-only, as above.
func TestUntypedConstDoubleNegation() testing.TestResult {
	if types.GetTarget().IntSize < 8 { return "" }
	var c @ir.Instr = untypedConstOf(
			"package \"test\"\n"
					"func main() { var f float64 = cast(float64, -(-9223372036854775808)); _ = f }\n",
			-9223372036854775807 - 1)
	if c == nil { return fail("-(-2^63) should be one folded constant") }
	if !isIntOfWidth(c.Typ, 64, false) { return fail("+2^63 should be an unsigned 64-bit constant") }
	return ""
}

// `~5` is -6, a negative in-int32 value: a SIGNED constant (host int), so its
// float conversion is -6.0, not a huge unsigned value.
func TestUntypedConstComplementIsSigned() testing.TestResult {
	var c @ir.Instr = untypedConstOf(
			"package \"test\"\n"
					"func main() { var f float64 = cast(float64, ~5); _ = f }\n",
			-6)
	if c == nil { return fail("~5 should be one folded constant") }
	if c.Typ == nil || c.Typ.Kind != types.TYP_INT || !c.Typ.Signed {
		return fail("~5 should be a signed constant")
	}
	return ""
}
