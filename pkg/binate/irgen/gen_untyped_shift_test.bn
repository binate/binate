package "pkg/binate/irgen"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Tests that a shift with an untyped constant value and a non-constant count is
// lowered at the type its context gives it (spec §13.5
// expr.shift.untyped-value), with the value constant emitted once, at that
// type — whether the value is spelled as a literal or a constant expression.

// shiftAtType generates src (one function, f), finds its op instruction, and
// reports whether it and the single constant of value v are of the given
// integer type.
func shiftAtType(src *[]readonly char, op int, v int64, width int, signed bool) bool {
	var m @ir.Module = genFromSourceWithChecker(src)
	if len(m.Funcs) < 1 { return false }
	var sh @ir.Instr = firstOp(m.Funcs[0], op)
	if sh == nil || !isIntOfWidth(sh.Typ, width, signed) { return false }
	var cs @[]@ir.Instr = constsWithValue(m.Funcs[0], v)
	return len(cs) == 1 && isIntOfWidth(cs[0].Typ, width, signed)
}

// `return 5 << n` from an int64 function shifts at int64, not the count's uint8.
func TestUntypedShiftLiteralValueAtContextType() testing.TestResult {
	if !shiftAtType("package \"test\"\nfunc f(n uint8) int64 { return 5 << n }\n", iropcode.OP_SHL,
			cast(int64, 5), 64, true) {
		return fail("`5 << n` returned as int64 must be one int64 SHL over one int64 constant 5")
	}
	return ""
}

// A constant-expression value is lowered exactly like a literal.  (The values
// avoid 0, 1 and the width-minus-one constants the overshift guard emits.)
func TestUntypedShiftConstExprValueAtContextType() testing.TestResult {
	if !shiftAtType("package \"test\"\nfunc f(n uint8) int64 { return cast(int64, (0 + 5) << n) }\n",
			iropcode.OP_SHL, cast(int64, 5), 64, true) {
		return fail("`cast(int64, (0 + 5) << n)` must be one int64 SHL over one int64 constant 5")
	}
	return ""
}

// A negative constant value shifted right takes the context's (signed) type.
func TestUntypedShiftNegativeValueArithmetic() testing.TestResult {
	if !shiftAtType("package \"test\"\nfunc f(n uint8) int32 { return (0 - 16) >> n }\n",
			iropcode.OP_SHR, cast(int64, -16), 32, true) {
		return fail("`(0 - 16) >> n` returned as int32 must be one int32 SHR over one int32 constant -16")
	}
	return ""
}

// unsafe_shl with an untyped value is lowered at its context's type too.
func TestUnsafeShlUntypedValueAtContextType() testing.TestResult {
	if !shiftAtType("package \"test\"\nfunc f(n uint8) uint16 { return unsafe_shl(1, n) }\n",
			iropcode.OP_SHL, cast(int64, 1), 16, false) {
		return fail(
				"`unsafe_shl(1, n)` returned as uint16 must be one uint16 SHL over one uint16 constant 1")
	}
	return ""
}
