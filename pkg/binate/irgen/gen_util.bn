package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/ast"
import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Token → IR op mapping
// ============================================================

// tokenToOp converts an AST token kind to the corresponding IR opcode.
func tokenToOp(tok int) int {
	if tok == cast(int, token.PLUS) { return iropcode.OP_ADD }
	if tok == cast(int, token.MINUS) { return iropcode.OP_SUB }
	if tok == cast(int, token.STAR) { return iropcode.OP_MUL }
	if tok == cast(int, token.SLASH) { return iropcode.OP_DIV }
	if tok == cast(int, token.PERCENT) { return iropcode.OP_REM }
	if tok == cast(int, token.AMP) { return iropcode.OP_AND }
	if tok == cast(int, token.PIPE) { return iropcode.OP_OR }
	if tok == cast(int, token.CARET) { return iropcode.OP_XOR }
	if tok == cast(int, token.SHL) { return iropcode.OP_SHL }
	if tok == cast(int, token.SHR) { return iropcode.OP_SHR }
	if tok == cast(int, token.EQ) { return iropcode.OP_EQ }
	if tok == cast(int, token.NEQ) { return iropcode.OP_NE }
	if tok == cast(int, token.LT) { return iropcode.OP_LT }
	if tok == cast(int, token.LEQ) { return iropcode.OP_LE }
	if tok == cast(int, token.GT) { return iropcode.OP_GT }
	if tok == cast(int, token.GEQ) { return iropcode.OP_GE }
	if tok == cast(int, token.LAND) { return iropcode.OP_LAND }
	if tok == cast(int, token.LOR) { return iropcode.OP_LOR }
	return iropcode.OP_ADD // fallback
}

// compoundToIROp converts a compound assignment token (+=, -=, etc.) to the IR binary op.
func compoundToIROp(op int) int {
	if op == cast(int, token.ADD_ASSIGN) { return iropcode.OP_ADD }
	if op == cast(int, token.SUB_ASSIGN) { return iropcode.OP_SUB }
	if op == cast(int, token.MUL_ASSIGN) { return iropcode.OP_MUL }
	if op == cast(int, token.QUO_ASSIGN) { return iropcode.OP_DIV }
	if op == cast(int, token.REM_ASSIGN) { return iropcode.OP_REM }
	if op == cast(int, token.AND_ASSIGN) { return iropcode.OP_AND }
	if op == cast(int, token.OR_ASSIGN) { return iropcode.OP_OR }
	if op == cast(int, token.XOR_ASSIGN) { return iropcode.OP_XOR }
	if op == cast(int, token.SHL_ASSIGN) { return iropcode.OP_SHL }
	if op == cast(int, token.SHR_ASSIGN) { return iropcode.OP_SHR }
	return iropcode.OP_ADD
}

// ============================================================
// Function-reference resolution
// ============================================================

// isFuncRefExpr reports whether e is a syntactic function reference
// — a bare Ident, a pkg.Name Selector, or a method expression
// (T.M Selector where T is a known local type and M a method on it).
// Doesn't validate that the name actually resolves to a function;
// callers (e.g. genVarDecl) gate on lookupFuncExists, which the
// qualified name produced by funcRefName will satisfy.
func isFuncRefExpr(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind == ast.EXPR_IDENT { return true }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		return true
	}
	return false
}

// funcRefName returns the qualified function name for a function-
// reference expression. Three shapes:
//   - Ident `f`              → `f`            (free function)
//   - Selector `pkg.Func`    → `pkg.Func`     (package-qualified)
//   - Selector `T.M`         → `<pkg>.T.M`    (method expression)
// The method-expression case is detected by checking whether the
// X identifier names a receiver type (methodExprName) — unless X is a
// variable in scope, whose `X.M` is a method value.
func funcRefName(ctx @GenContext, e @ast.Expr) @[]char {
	if e == nil { return "" }
	var gc @GenCtx = ctx.Gc
	if e.Kind == ast.EXPR_IDENT {
		// Inside a monomorphized generic body emitted for an imported
		// package (CurrentImportPkg set), a bare function reference
		// names the DEFINING package's function — qualify it so the
		// call/func-value targets that package's symbol, not a same-
		// named one (or nothing) in the consumer module.  Guarded by
		// existence so builtins (`panic`) and locals stay bare.
		if len(gc.Mod.CurrentImportPkg) > 0 {
			var qn @[]char = qualNameInPkg(gc.Mod.CurrentImportPkg, e.Name)
			if lookupFuncExists(gc, qn) {
				return qn
			}
		}
		return e.Name
	}
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		// A method EXPRESSION `T.M` over a named receiver (methodExprName).  A
		// genuine package-qualified function (`pkg.Func`, e.X an import alias)
		// has no such receiver type and falls through to buildQualNameHomed.
		if !selectorBaseIsVar(ctx, e) {
			var methodName @[]char = methodExprName(gc, e.X.Name, e.Name)
			if len(methodName) > 0 {
				return methodName
			}
		}
		return buildQualNameHomed(gc.Mod, e.X.Name, e.Name)
	}
	// A method expression off a generic type INSTANTIATION (`Box[int].M` /
	// `pkg.Box[int].M`): resolve the instance and emit its methods, then name the
	// method by the mangled instantiation — the SAME symbol genExprOrFuncRef's
	// func-value form and a direct method call use, so a direct invocation
	// `Box[int].M(args)` links to it.  This serves the call dispatcher's
	// direct-by-name path; it is NOT a hot per-call predicate like isMethodCallSel,
	// so the resolve is safe.  (A func-field call on an indexed value can also
	// reach here, but there typeArgExprToType is a no-op — a value head is not a
	// generic decl, so no mutation, empty result, and the dispatcher's func-value
	// fallback handles it.)
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var instName @[]char = baseNamedTypeName(typeArgExprToType(gc, e.X))
		if len(instName) > 0 {
			ensureMethodsForInstName(gc, instName)
			return buildMethodQualName(gc.PkgPath, instName, e.Name)
		}
	}
	return ""
}

// genExprOrFuncRef evaluates e in the receiving context of targetTyp.
// When targetTyp is a function-value type and e is a function reference
// (Ident or pkg.Name), emits OP_FUNC_VALUE. When targetTyp is an
// interface-value type and e produces a pointer-shaped value, wraps
// the value with OP_IFACE_VALUE pointing at the matching impl's
// vtable.
// Otherwise falls back to genExpr. targetTyp may be nil — the helper
// is then a thin wrapper.
//
// Use this at every site where a function reference may legitimately
// flow into a function-value-typed slot OR a pointer-shaped value
// may legitimately flow into an interface-value slot: var decl with
// explicit type, call arg, return value, plain/selector/index
// assignment.
func genExprOrFuncRef(ctx @GenContext, b @ir.Block, e @ast.Expr, targetTyp @types.Type) @ir.Instr {
	// Peel transparent wrappers (readonly / named-distinct / alias) before
	// the func-value-kind test — emitting a function value is a representation
	// decision, so it must see through wrappers, exactly as the interface-
	// value dispatch below does.  Without this a func reference flowing into a
	// `readonly *func` slot (e.g. a `*[]readonly *func(...)` raw-slice element,
	// the only spelling raw-slice literals accept) or a named-distinct
	// `type FP *func(...)` slot fails the Kind-test and falls through to
	// genSelector's aborting fallback.
	var ftgt @types.Type = targetTyp
	if ftgt != nil { ftgt = types.StripWrappers(ftgt) }
	if e != nil && ftgt != nil &&
			(ftgt.Kind == types.TYP_FUNC_VALUE || ftgt.Kind == types.TYP_MANAGED_FUNC_VALUE) &&
			isFuncRefExpr(e) {
		var fnName @[]char = funcRefName(ctx, e)
		if !funcRefShadowed(ctx, e, fnName) && lookupFuncExists(ctx.Gc, fnName) {
			var fv @ir.Instr = irbuild.EmitFuncValue(b, fnName, ftgt)
			noteSPGrowingResult(ctx, fv)
			registerFreshFuncValueTemp(ctx, fv)
			// Sync ctx.CurBlock to the block we emitted into, like the
			// typed-int returns below and genExpr's pre-amble.  A caller
			// that does `b = ctx.CurBlock` after this call must land on
			// the block it passed in; without this sync it picks up a
			// stale ctx.CurBlock left by a prior statement that split the
			// block (e.g. an @func field assignment's old-value RefDec
			// guard), so the next statement emits into the already-
			// terminated block — two terminators + an orphaned
			// continuation, i.e. malformed IR that traps at runtime.
			ctx.CurBlock = b
			return fv
		}
	}
	// A generic-function instantiation flowing into a func-value slot
	// (`f(Id[int])`, `return pkg.Id[int]`, `S{fn: Id[int]}`, `var f @func = Id[int]`).
	// isFuncRefExpr rejects the EXPR_INSTANTIATE_OR_INDEX shape, so emit the
	// specialized instance's func value against the target func-value type.
	if e != nil && ftgt != nil &&
			(ftgt.Kind == types.TYP_FUNC_VALUE || ftgt.Kind == types.TYP_MANAGED_FUNC_VALUE) &&
			e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var giName @[]char = genericFuncInstanceName(ctx, e)
		if len(giName) > 0 {
			var fv @ir.Instr = irbuild.EmitFuncValue(b, giName, ftgt)
			noteSPGrowingResult(ctx, fv)
			registerFreshFuncValueTemp(ctx, fv)
			ctx.CurBlock = b
			return fv
		}
	}
	// A method EXPRESSION off a generic type instantiation (`Box[int].Get`)
	// flowing into a func-value slot: the base is an EXPR_INSTANTIATE_OR_INDEX
	// generic-type instance and the selector names a method.  Resolve the instance
	// (registering the struct under its defining package — the same path a direct
	// call uses, gen_method.bn), emit its methods (nothing CALLS the method here,
	// so it isn't otherwise instantiated), and emit the method's func value under
	// the mangled instantiation name so it links to the same symbol the bound form
	// (`bp.Get`) and direct calls use.  A value-index base (`arr[i].fnField`)
	// resolves to a non-named type, so recvName is empty and we fall through to
	// genSelector.
	if e != nil && ftgt != nil &&
			(ftgt.Kind == types.TYP_FUNC_VALUE || ftgt.Kind == types.TYP_MANAGED_FUNC_VALUE) &&
			e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		var instTyp @types.Type = typeArgExprToType(ctx.Gc, e.X)
		var recvName @[]char = baseNamedTypeName(instTyp)
		if len(recvName) > 0 {
			ensureMethodsForInstName(ctx.Gc, recvName)
			var mqName @[]char = buildMethodQualName(ctx.Gc.PkgPath, recvName, e.Name)
			if lookupFuncExists(ctx.Gc, mqName) {
				var fv @ir.Instr = irbuild.EmitFuncValue(b, mqName, ftgt)
				noteSPGrowingResult(ctx, fv)
				registerFreshFuncValueTemp(ctx, fv)
				ctx.CurBlock = b
				return fv
			}
		}
	}
	// Narrow an
	// integer-valued expression to its typed-int context.  The
	// expression may be a direct EXPR_INT_LIT or a more complex
	// untyped-int expression that the type checker folded (e.g.
	// EXPR_UNARY(MINUS, lit) producing int64-min; EXPR_BINARY of
	// two literals).  Both cases land HasLitVal=true on the
	// resolved Type via foldIntArith / checkUnaryExpr.
	//
	// Mirrors genExprInner's `ctx.CurBlock = b` pre-amble so
	// callers that do `b = ctx.CurBlock` after this call land on
	// the same block they passed in.  Without this sync the
	// caller would pick up a stale ctx.CurBlock — observable as
	// for-loop epilogue code emitted into the wrong block in any
	// function that does e.g. `for ...; sec.Data[i] = 0` (the
	// loop tail's CurBlock leaks past the post-loop statement).
	if e != nil && isTypedInt(targetTyp) && needsHintNarrowing(targetTyp) && ctx.Checker != nil &&
			e.ResolvedTypeID != 0 {
		var t @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
		if t != nil && t.HasLitVal {
			var v int64 = bignumToInt(t.LitMag, t.LitSign)
			if intFitsInType(v, targetTyp) {
				ctx.CurBlock = b
				return irbuild.EmitConstInt64(b, v, targetTyp)
			}
		}
	}
	// Fallback for the no-Checker test path: direct EXPR_INT_LIT
	// still narrows via parseIntLit.
	if e != nil && e.Kind == ast.EXPR_INT_LIT && isTypedInt(targetTyp) &&
			needsHintNarrowing(targetTyp) {
		var v int64 = exprIntLitValue(ctx.Checker, e)
		if intFitsInType(v, targetTyp) {
			ctx.CurBlock = b
			return irbuild.EmitConstInt64(b, v, targetTyp)
		}
	}
	// Implicit value-borrow (iface.construct.value-borrow): an ADDRESSABLE value
	// source constructing a raw `*Iface` (incl. `*any`) is boxed by an implicit
	// `&e`.  Take the address in place of a value load — genLValueAddr evaluates
	// `e` exactly once, as an address, so there is no wasted load and no double
	// evaluation (a load would also copy, mishandling a managed-carrying source).
	// The type checker admitted this (addressable only), so genLValueAddr yields
	// a real pointer; a composite literal already lowers to its backing pointer
	// and a `*T`/`@T`/iface source is not a value, so those take the pointer
	// paths below.  If genLValueAddr does not yield a pointer (a shape the checker
	// would not have accepted), its result is reused as the value to avoid a
	// second evaluation.
	var val @ir.Instr = nil
	var haveVal bool = false
	if e != nil && ctx.Checker != nil && targetTyp != nil && e.ResolvedTypeID != 0 {
		var bptgt @types.Type = types.StripWrappers(targetTyp)
		var srcT @types.Type = ctx.Checker.ExprType(e.ResolvedTypeID)
		if bptgt != nil && bptgt.Kind == types.TYP_INTERFACE_VALUE && isBorrowableValueSource(srcT) {
			// A STRING LITERAL borrowed into a raw `*any` must decay to its canonical
			// `*[]readonly char` char-slice and box THAT slice's address — the
			// spelling a `fmt` `case *[]readonly char:` recovers.  The genLValueAddr
			// path below instead decays the literal's `[N]readonly char` array natural
			// type to a `*char` element pointer and boxes a single `char`
			// (`lang.uint8`), which every char-slice `case` silently misses →
			// `%!?(unknown)`.  Materialise the
			// 2-word slice header into a frame-lived temp and box its address: a raw
			// slice borrows the static `{data, len}` (OP_RODATA_SLICE), so there is no
			// refcount and no cleanup — the static backing and the alloca both outlive
			// the borrowing call.
			if e.Kind == ast.EXPR_STRING_LIT {
				var strVal @ir.Instr = genExpr(ctx, b, e)
				if strVal != nil {
					var sliceTyp @types.Type = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
					var sliceVal @ir.Instr = irbuild.EmitStringToChars(ctx.CurBlock, strVal, sliceTyp)
					var slot @ir.Instr = irbuild.EmitAlloc(ctx.CurBlock, sliceTyp)
					irbuild.EmitStore(ctx.CurBlock, slot, sliceVal)
					var iv @ir.Instr = wrapAsIfaceValue(ctx, ctx.CurBlock, slot, bptgt,
							types.MakePointerType(sliceTyp))
					if iv != nil {
						noteSPGrowingResult(ctx, iv)
						return iv
					}
				}
			}
			var lp @ir.Instr = genBorrowSourceAddr(ctx, b, e)
			var boxPtr @ir.Instr = nil
			var boxSrcTyp @types.Type = nil
			// Peel transparent wrappers (named-distinct / alias / readonly) on lp's
			// type before the pointer-kind test.  genLValueAddr of a deref through a
			// NAMED pointer (`type P *int`; `&*p == p`, gen_expr.bn) yields a value
			// typed `P` (TYP_NAMED), which an un-peeled Kind check misreads as a
			// non-pointer rvalue → the 2b path stores the POINTER value into a value
			// slot, so the box captures the address instead of `*p`.  This block runs
			// only when srcT is a borrowable VALUE type (not a `*T`/`@T` — those skip
			// the value-borrow), so an lp whose peeled type is a pointer is
			// unambiguously the ADDRESS of that addressable value source (2a).
			var lpk @types.Type = nil
			if lp != nil && lp.Typ != nil { lpk = types.StripWrappers(lp.Typ) }
			if lpk != nil && (lpk.Kind == types.TYP_POINTER || lpk.Kind == types.TYP_MANAGED_PTR) {
				// 2a: ADDRESSABLE source — `lp` IS the `*T` (`&e` with no load).  The
				// box source type is the POINTER whose .Elem is the pointee (what
				// wrapAsIfaceValue's name-less `*any` path dereferences), matching
				// `lp` — NOT e's value type, whose `.Elem` is nil / the element for a
				// name-less func value / slice.  This is what the explicit `&e` path
				// supplies; inert for a named source (srcExprTyp unused there).
				boxPtr = lp
				boxSrcTyp = types.MakePointerType(srcT)
			} else if lp != nil {
				// 2b: NON-addressable rvalue — the checker admitted it only at a
				// BORROWING position, so materialise a stack temp of the DEFAULTED
				// concrete type (an untyped constant defaulted here — else it re-trips
				// the box(<untyped constant>) crash), store the value into it via
				// emitStoreManagedSlot (which MOVES a fresh managed value's ref, or
				// COPIES a managed-field struct's fields, or plain-stores a
				// pointer-free value), and box the temp's address.  A managed-carrying
				// temp then OWNS a reference and is enrolled for scope-end cleanup
				// (below); a pointer-free temp is a plain frame-lived alloca.
				var vt @types.Type = defaultedBorrowType(srcT)
				// A managed borrow-temp created while storing a defer's operands
				// uses a pre-allocated, entry-depth slot (already nil-init'd + in
				// ctx.Vars) so the snapshot survives a nested/conditional defer to
				// the deferred call, rather than being freed at block exit.  The
				// pre-pass allocated one per managed borrow-temp in the same order;
				// `usedDeferBorrowSlot` marks that this slot is already enrolled.
				var usedDeferBorrowSlot bool = false
				var slot @ir.Instr
				if borrowTempNeedsCleanup(vt) && ctx.DeferBorrowCursor < len(ctx.DeferBorrowSlots) {
					slot = ctx.DeferBorrowSlots[ctx.DeferBorrowCursor]
					ctx.DeferBorrowCursor = ctx.DeferBorrowCursor + 1
					usedDeferBorrowSlot = true
				} else {
					slot = irbuild.EmitAlloc(ctx.CurBlock, vt)
				}
				ctx.CurBlock = emitStoreManagedSlot(ctx, ctx.CurBlock, slot, lp, vt, true)
				if borrowTempNeedsCleanup(vt) && !usedDeferBorrowSlot {
					// A managed-carrying temp OWNS the copied/moved reference and must
					// be RefDec'd.  Enroll it as a SCOPE-scoped managed local
					// (ctx.Vars) rather than a statement temp: (1) emitTempRefDecs's
					// alloca arm only cleans STRUCT/ARRAY allocas, so a managed-scalar
					// alloca (@[]T / @T / @func / @Iface) registered as a statement temp
					// would leak; the scope-var cleanup (emitDecForManagedLocals) loads
					// the alloca and RefDec's every managed kind.  (2) scope lifetime
					// co-scopes the temp with a var-init binding (so a var-init'd *any
					// stays valid), and is sound for an argument too (the borrow does
					// not outlive the frame).  Mirrors the composite-literal-into-var
					// enrollment (gen_short_var.bn).  The `.`-prefixed synthetic name
					// (`.` is not an identifier char — unlike a `__` name, which is a legal
					// user ident that would shadow a same-named user var under the
					// most-recent-first lookupVar; convention shared with
					// `.typeswitch.scrutinee`) never
					// collides with a source ident and is never looked up.
					defineVar(ctx, ".borrow_temp", slot, vt)
				}
				boxPtr = slot
				boxSrcTyp = types.MakePointerType(vt)
			}
			if boxPtr != nil {
				var iv @ir.Instr = wrapAsIfaceValue(ctx, ctx.CurBlock, boxPtr, bptgt, boxSrcTyp)
				if iv != nil {
					noteSPGrowingResult(ctx, iv)
					return iv
				}
			}
			val = lp
			haveVal = true
		}
	}
	if !haveVal {
		val = genExpr(ctx, b, e)
	}
	return convertToIfaceTarget(ctx, ctx.CurBlock, val, targetTyp, checkerExprType(ctx, e))
}

// convertToIfaceTarget converts val for a slot of type targetTyp when that is an
// interface value: a concrete `*T` / `@T` is boxed into it (wrapAsIfaceValue),
// and an interface value that does not already agree with the target — one of a
// descendant interface (the checker accepted the conversion), or a managed `@I`
// decaying to a raw `*I` (the same vtable, offset 0) — goes through
// OP_IFACE_UPCAST.  Any other value or target is returned unchanged.  srcTyp is
// val's un-stripped checker type, or nil: a name-less box's structural identity
// keeps element-`readonly` from it (val's IR type has it stripped; see
// wrapAsIfaceValue).  Emits into b.
//
// A managed box RefIncs the source, exactly like the explicit `cast(@I, t)` box,
// and is registered as a cleanup temp so a fault before its consumer moves it
// out (a deferred-call fault at a return, a mid-statement fault in an argument
// or composite-element position) releases that reference; a raw `*Iface` box
// borrows (no RefInc) and only gets the SP mark.  An upcast keeps the source's
// data pointer and takes no reference.
func convertToIfaceTarget(ctx @GenContext, b @ir.Block, val @ir.Instr, targetTyp @types.Type,
		srcTyp @types.Type) @ir.Instr {
	if val == nil || val.Typ == nil || targetTyp == nil { return val }
	// Peel a transparent wrapper (readonly / alias) off the target, so a
	// `readonly @Iface` / alias-iface target is still converted.  Otherwise the
	// concrete value is stored into the iface slot with the vtable word left
	// garbage → SIGSEGV at the first dispatch.  wrapAsIfaceValue / EmitIfaceUpcast
	// gate on the same kind; readonly is layout-transparent.
	var ptgt @types.Type = types.StripWrappers(targetTyp)
	if ptgt == nil ||
			(ptgt.Kind != types.TYP_INTERFACE_VALUE && ptgt.Kind != types.TYP_INTERFACE_VALUE_MANAGED) {
		return val
	}
	if val.Typ.Kind != types.TYP_INTERFACE_VALUE && val.Typ.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		var iv @ir.Instr = wrapAsIfaceValue(ctx, b, val, ptgt, srcTyp)
		if iv == nil { return val }
		registerIfaceBox(ctx, iv, ptgt)
		return iv
	}
	if ifaceValueTypesAgree(ctx.Gc.Mod, val.Typ, ptgt) { return val }
	// Both Args[0].Typ.Elem (the source interface) and the result's Typ.Elem (the
	// target) ride on the instruction, so codegen and the VM derive the static
	// slot offset / target vtable name at lowering time.
	var up @ir.Instr = irbuild.EmitIfaceUpcast(b, ctx.Gc.Mod, val, "", ptgt)
	noteSPGrowingResult(ctx, up)
	return up
}

// checkerExprType returns e's un-stripped checker type, or nil without a Checker
// (the IR-gen unit-test path) or for an expression the checker did not type.
func checkerExprType(ctx @GenContext, e @ast.Expr) @types.Type {
	if ctx.Checker == nil || e == nil { return nil }
	return ctx.Checker.ExprType(e.ResolvedTypeID)
}
