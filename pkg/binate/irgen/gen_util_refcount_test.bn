package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/irutil"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the refcount emit/temp/scope helpers in gen_util_refcount.bn.
// The pure type/instr predicates (and their tests) live in
// gen_refcount_pred{,_test}.bn; the emit helpers (struct copy/dtor, scope
// cleanup) are exercised end-to-end by the gen_copy / gen_dtor tests and
// conformance.  needsStructCopy — the gate that decides whether an
// aggregate gets a copy/dtor call (and the predicate the @func/@Iface
// NeedsDestruction work pivots on) — is pinned directly here.
// fail / noFields live in the package's other test files.

// needsStructCopy is false for nil, non-aggregate types, and the
// inline-handled managed kinds (@T / @[]T).
func TestNeedsStructCopyNonAggregate() testing.TestResult {
	if needsStructCopy(nil) {
		return fail("nil should not need a struct copy")
	}
	if needsStructCopy(types.TypInt()) {
		return fail("int should not need a struct copy")
	}
	if needsStructCopy(types.MakeManagedPtrType(types.TypInt())) {
		return fail("@T is handled inline, not via a struct copy")
	}
	return ""
}

// A struct with a destructible (managed) field needs a copy/dtor.
func TestNeedsStructCopyStructWithManagedField() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(
			types.MakeStructType("Inner", noFields))
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Outer", fields)
	if !needsStructCopy(st) {
		return fail("a struct with a managed field needs a struct copy")
	}
	return ""
}

// A struct whose fields are all plain (non-managed) needs no copy/dtor.
func TestNeedsStructCopyPlainStruct() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "X"
	f0.Type = types.TypInt()
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Plain", fields)
	if needsStructCopy(st) {
		return fail("a struct with only plain fields needs no struct copy")
	}
	return ""
}

// emitManagedFuncValueRefDec must guard the closure-dtor fetch + RefDec
// behind a data != null check: a zero-initialized @func value is
// {vtable=null, data=null}, and the unguarded vtable[0] load (via
// OP_FUNC_VALUE_DTOR) would fault on the null vtable.  Pins the guarded
// shape — an equality compare and a conditional branch, with the dtor
// fetch and RefDec reachable on the non-null path — and the block split
// (the helper returns a fresh continuation block, so the function gains
// extra blocks beyond the entry it was handed).
func TestEmitFuncValueRefDecGuardsNullData() testing.TestResult {
	var noTypeParams @[]@types.Param
	var noTypeResults @[]@types.Type
	var fnTyp @types.Type = types.MakeManagedFuncValueType(noTypeParams, noTypeResults)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(entry, fnTyp)
	var fvVal @ir.Instr = irbuild.EmitLoad(entry, slot, fnTyp)
	var cont @ir.Block = emitManagedFuncValueRefDec(f, entry, fvVal)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(cont, noRet)
	if countOp(f, iropcode.OP_EQ) < 1 {
		return fail("expected a data==null compare (iropcode.OP_EQ) in the guard")
	}
	if countOp(f, iropcode.OP_BRANCH) < 1 {
		return fail("expected a conditional branch guarding the dtor load")
	}
	if countOp(f, iropcode.OP_FUNC_VALUE_DTOR) < 1 {
		return fail("expected iropcode.OP_FUNC_VALUE_DTOR (closure-dtor fetch)")
	}
	if countOp(f, iropcode.OP_REFDEC) < 1 {
		return fail("expected iropcode.OP_REFDEC on the capture record")
	}
	if len(f.Blocks) < 2 {
		return fail("guard should split the block (extra blocks added)")
	}
	return ""
}

// registerPendingStructDtor dedups by dtor NAME (not type identity) and keeps
// m.PendingStructDtorNames in lockstep with m.PendingStructDtors. A type
// registered repeatedly across many emit sites must add at most one entry —
// even when the same name arrives on a distinct @types.Type object — and the
// parallel name list must stay the same length. This is the invariant the
// O(1)-dedup relies on; a desync would silently let the list grow (the
// front-end OOM) or emit a duplicate dtor.  The work-list is reached through
// the func's @Func.Mod back-ref (per-module since inc 5d), so the test binds
// a fresh module to f and reads the lists back off it.
func TestRegisterPendingStructDtorDedup() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	f.Mod = m

	var a @types.Type = types.MakeStructType("DedupA", noFields)
	var b @types.Type = types.MakeStructType("DedupB", noFields)
	var a2 @types.Type = types.MakeStructType("DedupA", noFields) // distinct object, same name

	ir.RegisterPendingStructDtor(f, a)
	ir.RegisterPendingStructDtor(f, a)
	ir.RegisterPendingStructDtor(f, b)
	ir.RegisterPendingStructDtor(f, a2)

	var nStruct int = len(m.PendingStructDtors)
	var nNames int = len(m.PendingStructDtorNames)
	if nStruct != 2 {
		return fail("expected 2 distinct pending struct dtors (DedupA deduped, DedupB)")
	}
	if nNames != nStruct {
		return fail("PendingStructDtorNames out of sync with PendingStructDtors")
	}
	return ""
}

// registerPendingMsDtor dedups managed-slice dtor types the same way, keeping
// m.PendingMsDtorNames parallel to m.PendingMsDtors.
func TestRegisterPendingMsDtorDedup() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	f.Mod = m

	var elem @types.Type = types.MakeManagedPtrType(
			types.MakeStructType("MsElem", noFields))
	var ms1 @types.Type = types.MakeManagedSliceType(elem)
	var ms2 @types.Type = types.MakeManagedSliceType(elem) // same shape → same dtor name

	ir.RegisterPendingMsDtor(f, ms1)
	ir.RegisterPendingMsDtor(f, ms2)

	var nMs int = len(m.PendingMsDtors)
	var nNames int = len(m.PendingMsDtorNames)
	if nMs != 1 {
		return fail("expected 1 pending ms dtor (same-shape managed slice deduped)")
	}
	if nNames != nMs {
		return fail("PendingMsDtorNames out of sync with PendingMsDtors")
	}
	return ""
}

// registerPendingMpDtor dedups managed-POINTER dtor types (`@(@T)` drops reference
// the pointee's `__dtor_mp_<T>`), keeping m.PendingMpDtorNames parallel.
func TestRegisterPendingMpDtorDedup() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	f.Mod = m

	var node @types.Type = types.MakeStructType("MpNode", noFields)
	var mp1 @types.Type = types.MakeManagedPtrType(node)
	var mp2 @types.Type = types.MakeManagedPtrType(node) // same shape → same dtor name

	ir.RegisterPendingMpDtor(f, mp1)
	ir.RegisterPendingMpDtor(f, mp2)

	var nMp int = len(m.PendingMpDtors)
	var nNames int = len(m.PendingMpDtorNames)
	if nMp != 1 {
		return fail("expected 1 pending mp dtor (same-shape managed ptr deduped)")
	}
	if nNames != nMp {
		return fail("PendingMpDtorNames out of sync with PendingMpDtors")
	}
	return ""
}

// The pending-dtor work-lists are per-@Module (reached via the func's
// @Func.Mod back-ref), so two modules compiled in one process accumulate dtor
// work independently — the reentrancy guarantee.  A type registered through a
// func bound to module A must land on A's list
// only, never on B's (and vice-versa).  With the pre-5d package-global lists
// this isolation didn't hold: every registration piled onto the one shared
// list regardless of which compilation it came from.
func TestPendingDtorListsPerModuleIsolation() testing.TestResult {
	var ma @ir.Module = ir.NewModule("a")
	var mb @ir.Module = ir.NewModule("b")
	var fa @ir.Func = ir.NewFunc("", "fa", noParams, noResults)
	fa.Mod = ma
	var fb @ir.Func = ir.NewFunc("", "fb", noParams, noResults)
	fb.Mod = mb

	var ta @types.Type = types.MakeStructType("OnlyA", noFields)
	var tb @types.Type = types.MakeStructType("OnlyB", noFields)
	ir.RegisterPendingStructDtor(fa, ta)
	ir.RegisterPendingStructDtor(fb, tb)

	if len(ma.PendingStructDtors) != 1 {
		return fail("module A should hold exactly its own pending struct dtor")
	}
	if len(mb.PendingStructDtors) != 1 {
		return fail("module B should hold exactly its own pending struct dtor")
	}
	if !irutil.Streq(irutil.DtorNameForType(ma.PendingStructDtors[0]), irutil.DtorNameForType(ta)) {
		return fail("module A's pending dtor should be OnlyA's, uncontaminated by B")
	}
	if !irutil.Streq(irutil.DtorNameForType(mb.PendingStructDtors[0]), irutil.DtorNameForType(tb)) {
		return fail("module B's pending dtor should be OnlyB's, uncontaminated by A")
	}
	return ""
}
