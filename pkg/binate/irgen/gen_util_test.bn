package "pkg/binate/irgen"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_util.bn: tokenToOp, parseIntLit, isManagedPtrType, etc.

func TestTokenToOp() testing.TestResult {
	if tokenToOp(cast(int, token.PLUS)) != iropcode.OP_ADD {
		return fail("PLUS should map to iropcode.OP_ADD")
	}
	if tokenToOp(cast(int, token.MINUS)) != iropcode.OP_SUB {
		return fail("MINUS should map to iropcode.OP_SUB")
	}
	if tokenToOp(cast(int, token.STAR)) != iropcode.OP_MUL {
		return fail("STAR should map to iropcode.OP_MUL")
	}
	return ""
}

func TestParseIntLitDecimal() testing.TestResult {
	if parseIntLit("42") != 42 { return fail("expected 42") }
	if parseIntLit("0") != 0 { return fail("expected 0") }
	return ""
}

func TestParseIntLitHex() testing.TestResult {
	if parseIntLit("0xFF") != 255 { return fail("expected 255") }
	if parseIntLit("0x10") != 16 { return fail("expected 16") }
	return ""
}

func TestParseIntLitOctal() testing.TestResult {
	if parseIntLit("0o77") != 63 { return fail("expected 63") }
	return ""
}

func TestParseIntLitBinary() testing.TestResult {
	if parseIntLit("0b1010") != 10 { return fail("expected 10") }
	return ""
}

func TestIsManagedPtrType() testing.TestResult {
	var mp @types.Type = types.MakeManagedPtrType(types.TypInt())
	if !irutil.IsManagedPtrType(mp) { return fail("should be managed ptr") }
	if irutil.IsManagedPtrType(types.TypInt()) { return fail("int should not be managed ptr") }
	return ""
}

func TestIsManagedSliceType() testing.TestResult {
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !irutil.IsManagedSliceType(ms) { return fail("should be managed slice") }
	if irutil.IsManagedSliceType(types.TypInt()) { return fail("int should not be managed slice") }
	return ""
}
