package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"

// Tests for gen_value_differential.bn: the value differential's findings.

// withValueDiffFile runs gen with the value differential on, writing to a file
// of its own, and returns what the differential wrote (gen's message instead
// when it returns one).
func withValueDiffFile(gen *func() @[]char) @[]char {
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_valuediff_")
	if present(derr) { return "no temporary directory" }
	defer { _ = os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/diff.txt")
	if !SetValueDifferential(path) { return "the differential's file must open" }
	var msg @[]char = gen()
	_ = SetValueDifferential("")
	if len(msg) > 0 { return msg }
	return readDiffFile(path)
}

// valueDiffOf checks and generates src under the value differential and
// returns what it wrote.
func valueDiffOf(src *[]readonly char) @[]char {
	diffSrc = buf.CopyStr(src)
	return withValueDiffFile(genDiffSrc)
}

// A program IR-gen reads the way the checker resolved it -- locals, parameters,
// local and package constants (a floating-point one, which IR-gen reads from its
// own table), package variables, read, assigned, stepped and addressed, from
// their records, and a `_func_handle` operand by its spelling -- is noted nowhere,
// nor is the assignment IR-gen makes up to run g's initializer.
func TestValueDifferentialQuietWhenAgreeing() testing.TestResult {
	var got @[]char = valueDiffOf(
			"package \"main\"\n"
					"const F float64 = 1.5\n"
					"const K int = 3\n"
					"var g int = 2\n"
					"type P struct { x int }\n"
					"func add(a int, b int) int { return a + b }\n"
					"func id[T any](v T) T { return v }\n"
					"func main() {\n"
					"\tconst L int = 4\n"
					"\tconst H float64 = F * 2.0\n"
					"\tvar p P\n"
					"\tp.x = g\n"
					"\tvar q *P = &p\n"
					"\tq.x++\n"
					"\tg = g + L + K\n"
					"\tvar f float64 = F * H\n"
					"\t_ = f\n"
					"\tvar arr [3]int\n"
					"\tarr[1] = add(arr[0], id[int](g))\n"
					"\t_ = arr[1:2]\n"
					"\tvar h *uint8 = _func_handle(add)\n"
					"\t_ = h\n"
					"}\n")
	if len(got) > 0 { return fail(buf.Concat("nothing must be noted; got: ", got)) }
	return ""
}

// recordsSrc is the program noteDifferences checks.
var recordsSrc @[]char

// checkedRecords checks recordsSrc, with pkg/a's interface (`var V int`) loaded,
// and returns a GenCtx whose module has the checker, and the program's file;
// the message of the first checker error instead.
func checkedRecords() (@GenCtx, @ast.File, @[]char) {
	var none @[]char
	var pa @parser.Parser = parser.NewInterface(strToBytes("package \"pkg/a\"\nvar V int\n"), "a.bni")
	var fa @ast.File = mustParse(pa)
	var c @check.Checker = check.NewChecker()
	c.LoadPackageInterface("pkg/a", fa)
	var p @parser.Parser = parser.New(strToBytes(recordsSrc), "main.bn")
	var file @ast.File = mustParse(p)
	c.Check(file)
	if len(c.CheckerErrors()) > 0 {
		return nil, file, buf.Concat("the program must check: ", c.CheckerErrors()[0].Msg)
	}
	var gc @GenCtx = NewGenCtx(InitModule(file.PkgName))
	gc.Mod.Checker = c
	gc.Mod.PkgPath = buf.CopyStr("main")
	gc.PkgPath = gc.Mod.PkgPath
	return gc, file, none
}

// varInit returns the initializer of the package variable name in file.
func varInit(file @ast.File, name *[]readonly char) @ast.Expr {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_VAR && irutil.Streq(d.Name, name) { return d.Value }
	}
	return nil
}

// noteDifferences notes IR-gen answers that differ from the records of
// recordsSrc's initializers, and ones that agree.
func noteDifferences() @[]char {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nimport \"pkg/a\"\nvar x int = 1\nvar y int = x\nvar z int = a.V\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return msg }
	var y @ast.Expr = varInit(file, "y")
	var z @ast.Expr = varInit(file, "z")
	if y == nil || z == nil { return "the initializers must be found" }
	// A read taken for a local, and a variable lookup that finds none.
	noteValueReading(gc, y, DIFF_READ, VALUE_LOCAL, "x")
	noteValueReading(gc, y, DIFF_VAR, VALUE_LOCAL_CONST, "x")
	// Agreeing: the same variable, by its bare name, and no constant either way.
	noteValueReading(gc, y, DIFF_VAR, VALUE_VAR, "x")
	noteValueReading(gc, y, DIFF_CONST, VALUE_NONE, "x")
	// A member in another package, and in its own.
	noteMemberPkg(gc, z, "pkg/b.V")
	noteMemberPkg(gc, z, "pkg/a.V")
	return ""
}

// An answer that differs from the record is one line: where, IR-gen's answer,
// the checker's; one that agrees, or that both read as `none` for the question
// asked, is noted nowhere.
func TestValueDifferentialNotesDifferences() testing.TestResult {
	var got @[]char = withValueDiffFile(noteDifferences)
	var want *[]readonly char = "main.bn:4:13: value differs: IR-gen local, checker var main.x\n"
			"main.bn:4:13: value differs: IR-gen none, checker var main.x\n"
			"main.bn:5:15: value differs: IR-gen member pkg/b.V, checker member pkg/a.V\n"
	if !irutil.Streq(got, want) { return fail(buf.Concat("unexpected notes: ", got)) }
	return ""
}

// noteWiring drives the noting sites against the records of a checked program,
// with IR-gen's scopes and registries set up to disagree with them.
func noteWiring() @[]char {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nimport \"pkg/a\"\nvar x int = 1\nvar y int = x\nvar z int = a.V\n"
					"type T struct { n int }\nfunc (t T) M() int { return t.n }\n"
					"var f *func(T) int = T.M\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return msg }
	var y @ast.Expr = varInit(file, "y")
	var z @ast.Expr = varInit(file, "z")
	var f @ast.Expr = varInit(file, "f")
	if y == nil || z == nil || f == nil { return "the initializers must be found" }
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	ctx.Gc = gc
	ctx.Checker = gc.Mod.Checker
	// Identifiers with records are read from them, whatever IR-gen's scopes bind
	// their spellings to: a local x hiding the global y reads, locals named like
	// the package and the type a and T.
	addGlobal(gc, "x")
	addManagedVar(ctx, b, "x")
	addManagedVar(ctx, b, "a")
	addManagedVar(ctx, b, "T")
	_ = genExpr(ctx, b, y)
	_ = identVar(ctx, y)
	_ = identValueBound(ctx, y)
	_ = identVar(ctx, z.X)
	_ = identVar(ctx, f.X)
	// A checked identifier with no record is read by its spelling, as the local x:
	// a read, a variable lookup, its type and a shadowing test; a constant lookup
	// finds none.
	var w @ast.Expr = fakeExpr(ast.EXPR_IDENT, "x", 1)
	_ = genExpr(ctx, b, w)
	_ = identVar(ctx, w)
	_ = identVarType(ctx, w)
	_ = identValueBound(ctx, w)
	_ = isPackageConstIdent(gc, w)
	// `a.V` through an import of another package under the name a.
	RebindImportPath(gc.Mod, "a", "pkg/b")
	_ = pkgMemberQualName(gc, z)
	return ""
}

// Each noting site reports IR-gen's own reading by its spelling: of an identifier
// with no record, a read, a variable lookup, its type and a shadowing test; a
// member through an import of another package.  An identifier with a record is
// read from it, noted nowhere.
func TestValueDifferentialNotesEachSite() testing.TestResult {
	var got @[]char = withValueDiffFile(noteWiring)
	var want *[]readonly char = "f.bn:2:3: value unrecorded: IR-gen local\n"
			"f.bn:2:3: value unrecorded: IR-gen local\n"
			"f.bn:2:3: value unrecorded: IR-gen local\n"
			"f.bn:2:3: value unrecorded: IR-gen local\n"
			"main.bn:5:15: value differs: IR-gen member pkg/b.V, checker member pkg/a.V\n"
	if !irutil.Streq(got, want) { return fail(buf.Concat("unexpected notes: ", got)) }
	return ""
}

// fakeExpr returns an expression of kind kind named name at f.bn:2:3 with no
// record; a type ID marks it checked.
func fakeExpr(kind int, name *[]readonly char, typeID int) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = kind
	e.Name = buf.CopyStr(name)
	e.Pos.File = "f.bn"
	e.Pos.Line = 2
	e.Pos.Col = 3
	e.ResolvedTypeID = typeID
	return e
}

// noteUnrecorded notes IR-gen's answers for expressions with no record, checked
// and not.
func noteUnrecorded() @[]char {
	recordsSrc = buf.CopyStr("package \"main\"\nvar x int\n")
	var gc @GenCtx
	var msg @[]char
	gc, _, msg = checkedRecords()
	if len(msg) > 0 { return msg }
	var e @ast.Expr = fakeExpr(ast.EXPR_IDENT, "w", 1)
	noteValueReading(gc, e, DIFF_READ, VALUE_LOCAL, "w")
	noteValueReading(gc, e, DIFF_READ, VALUE_NONE, "w")
	noteValueReading(gc, fakeExpr(ast.EXPR_IDENT, "w", 0), DIFF_READ, VALUE_LOCAL, "w")
	var sel @ast.Expr = fakeExpr(ast.EXPR_SELECTOR, "U", 1)
	sel.X = fakeExpr(ast.EXPR_IDENT, "a", 0)
	noteMemberPkg(gc, sel, "pkg/a.U")
	noteMemberFound(gc, sel, "pkg/a.U")
	noteMemberFound(gc, fakeExpr(ast.EXPR_SELECTOR, "U", 0), "pkg/a.U")
	sel.Name = buf.CopyStr("__Package")
	noteMemberFound(gc, sel, "pkg/a.__Package")
	return ""
}

// A checked expression with no record is noted where IR-gen takes it for a value,
// or finds it as a member -- not where it only looks it up as one, nor for
// `__Package`, which no package declares; one the checker never saw is not noted.
func TestValueDifferentialNotesUnrecorded() testing.TestResult {
	var got @[]char = withValueDiffFile(noteUnrecorded)
	var want *[]readonly char = "f.bn:2:3: value unrecorded: IR-gen local\n"
			"f.bn:2:3: value unrecorded: IR-gen member pkg/a.U\n"
	if !irutil.Streq(got, want) { return fail(buf.Concat("unexpected notes: ", got)) }
	return ""
}

// A file that cannot be opened for appending leaves the differential off.
func TestValueDifferentialUnopenableFile() testing.TestResult {
	if SetValueDifferential("/nonexistent-binate-dir/diff.txt") {
		return fail("an unopenable file must not switch the differential on")
	}
	if len(valueDiffPath) != 0 { return fail("the differential must stay off") }
	return ""
}
