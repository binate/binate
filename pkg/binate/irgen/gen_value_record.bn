package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/constval"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/irutil"
import "pkg/binate/types"

// Value names read from the checker's records.  The checker records what each
// identifier, and each package-qualified member `pkg.X`, it checked resolves to
// as a value name (check.Checker.ExprSymbol); IR-gen reads a name with a record
// from it -- a function's variable or constant from the innermost binding of its
// name (ctx.Vars), a package-level variable, constant or function by the name
// the module registers it under -- whatever IR-gen's own scopes would make of
// its spelling.  A name with no record (no checker, or syntax the checker never
// saw) is still read by its spelling, and noted under the value differential.

// recordedValue returns the checker's record for the identifier e as an IR-gen
// answer, and true: its kind (a VALUE_* constant; VALUE_NONE for a type, a
// package, a predeclared name or any other symbol that is no variable,
// constant or function of a package or a function) and, for a package-level
// one, the name the module registers it under (recordedRegName).  false when e
// is no identifier or the checker recorded nothing for it.
func recordedValue(gc @GenCtx, e @ast.Expr) (int, @[]char, bool) {
	var none @[]char
	if e == nil || e.Kind != ast.EXPR_IDENT || gc == nil || gc.Mod == nil || gc.Mod.Checker == nil {
		return VALUE_NONE, none, false
	}
	var sym @check.Symbol = gc.Mod.Checker.ExprSymbol(e)
	if sym == nil { return VALUE_NONE, none, gc.Mod.Checker.ExprDenotedType(e) != nil }
	if sym.IsPredeclared() { return VALUE_NONE, none, true }
	var k int = sym.Kind()
	if !sym.IsPackageLevel() {
		if k == types.SYM_VAR { return VALUE_LOCAL, none, true }
		if k == types.SYM_CONST { return VALUE_LOCAL_CONST, none, true }
		return VALUE_NONE, none, true
	}
	var reg @[]char = recordedRegName(gc, sym.DeclPkg(), e.Name)
	if k == types.SYM_VAR { return VALUE_VAR, reg, true }
	if k == types.SYM_CONST { return VALUE_CONST, reg, true }
	if k == types.SYM_FUNC { return VALUE_FUNC, reg, true }
	return VALUE_NONE, none, true
}

// recordedMemberName returns the name the module registers the package-level
// symbol the checker recorded the package-qualified member e (`pkg.X`) as, and
// true; false when it recorded none -- a selector that is no package's member (a
// field, a method value or expression) -- or one that is not a package's own
// declaration.
func recordedMemberName(gc @GenCtx, e @ast.Expr) (@[]char, bool) {
	var sym @check.Symbol = recordedMember(gc, e)
	if sym == nil {
		var none @[]char
		return none, false
	}
	return recordedRegName(gc, sym.DeclPkg(), e.Name), true
}

// recordedMember returns the package-level symbol the checker recorded the
// selector e as, or nil (recordedMemberName).
func recordedMember(gc @GenCtx, e @ast.Expr) @check.Symbol {
	if e == nil || e.Kind != ast.EXPR_SELECTOR || gc == nil || gc.Mod == nil || gc.Mod.Checker == nil {
		return nil
	}
	var sym @check.Symbol = gc.Mod.Checker.ExprSymbol(e)
	if sym == nil || !sym.IsPackageLevel() { return nil }
	return sym
}

// memberPkgPath returns the package the package-qualified member e (`pkg.X`) is
// declared in: as the checker recorded it (recordedMember), or -- with no record
// of a package-level symbol -- by the import's name (homedQualifier).
func memberPkgPath(gc @GenCtx, e @ast.Expr) @[]char {
	var sym @check.Symbol = recordedMember(gc, e)
	if sym != nil { return buf.CopyStr(sym.DeclPkg()) }
	return homedQualifier(gc.Mod, e.X.Name, e.Name)
}

// recordedFuncRef returns the name the module registers the function under that
// the function reference e -- an identifier, or a package's member `pkg.F` --
// names as the checker recorded it, and true: "" when the record is of no
// package-level function (a variable, a constant, a type, a predeclared name).
// false when the checker recorded nothing for e (recordedValue,
// recordedMemberName).  An internal error when the module has no signature for
// the function.
func recordedFuncRef(gc @GenCtx, e @ast.Expr) (@[]char, bool) {
	var none @[]char
	var reg @[]char
	if e != nil && e.Kind == ast.EXPR_SELECTOR {
		var sym @check.Symbol = recordedMember(gc, e)
		if sym == nil { return none, false }
		if sym.Kind() != types.SYM_FUNC { return none, true }
		reg = recordedRegName(gc, sym.DeclPkg(), e.Name)
	} else {
		var kind int
		var have bool
		kind, reg, have = recordedValue(gc, e)
		if !have { return none, false }
		if kind != VALUE_FUNC { return none, true }
	}
	if !lookupFuncExists(gc, reg) { recordMissICE(e, buf.Concat("signature for the function ", reg)) }
	return reg, true
}

// recordedGenericHead returns the generic function the checker recorded the head
// e of an instantiation (`g`, `pkg.G`) as naming, with the package that declares
// it ("" for the module's own), and true; nil and true when it recorded e as
// anything else -- a variable indexed (`fns[i]`, `pkg.Fns[i]`), a type -- and
// false when it recorded nothing for e.  An internal error when the module
// registers no generic declaration for the function.
func recordedGenericHead(gc @GenCtx, e @ast.Expr) (@ast.Decl, @[]char, bool) {
	var noPkg @[]char
	var none @ast.Decl
	if e == nil || (e.Kind != ast.EXPR_IDENT && e.Kind != ast.EXPR_SELECTOR) || gc == nil ||
			gc.Mod == nil || gc.Mod.Checker == nil {
		return none, noPkg, false
	}
	var sym @check.Symbol = gc.Mod.Checker.ExprSymbol(e)
	if sym == nil { return none, noPkg, gc.Mod.Checker.ExprDenotedType(e) != nil }
	var ft @types.Type = sym.Type()
	if sym.Kind() != types.SYM_FUNC || !sym.IsPackageLevel() || ft == nil || len(ft.TypeParams) == 0 {
		return none, noPkg, true
	}
	var pkg @[]char = sym.DeclPkg()
	var gd @ast.Decl = lookupGenericDeclPkg(gc, pkg, e.Name)
	if gd == nil { recordMissICE(e, "generic declaration") }
	if irutil.Streq(pkg, gc.PkgPath) { return gd, noPkg, true }
	return gd, pkg, true
}

// recordedRegName returns the name the module registers the package-level name
// of package pkg under: bare for the module's own package, qualified with pkg
// for any other.
func recordedRegName(gc @GenCtx, pkg *[]readonly char, name *[]readonly char) @[]char {
	if irutil.Streq(pkg, gc.PkgPath) { return buf.CopyStr(name) }
	return qualNameInPkg(pkg, name)
}

// recordedLocal returns the index in ctx.Vars of the innermost binding of the
// identifier e, which the checker recorded as a function's constant (isConst)
// or variable; an internal error when IR-gen binds the name to none, or to the
// other kind.
func recordedLocal(ctx @GenContext, e @ast.Expr, isConst bool) int {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if !irutil.Streq(ctx.Vars[i].Name, e.Name) { continue }
		if (ctx.Vars[i].ConstIdx > 0) == isConst { return i }
		break
	}
	if isConst { recordMissICE(e, "a binding of the function constant") }
	recordMissICE(e, "a binding of the function variable")
	return -1
}

// recordedGlobal returns the index in Mod.GlobalVars of the package variable
// registered under regName, which the checker recorded the identifier e as
// reading; an internal error when the module registers none.
func recordedGlobal(gc @GenCtx, e @ast.Expr, regName *[]readonly char) int {
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		if irutil.Streq(gc.Mod.GlobalVars[i].Name, regName) { return i }
	}
	recordMissICE(e, buf.Concat("a global for the package variable ", regName))
	return -1
}

// recordedGlobalRef returns the address of the package variable the checker
// recorded the identifier e as reading, registered under regName.
func recordedGlobalRef(gc @GenCtx, e @ast.Expr, regName *[]readonly char) @ir.Instr {
	var gi int = recordedGlobal(gc, e, regName)
	return irbuild.NewGlobalRef(gc.Mod, gc.Mod.GlobalVars[gi].Name, gc.Mod.GlobalVars[gi].Typ)
}

// recordedConstIdx returns the index in Module.Consts of the constant the
// identifier e was recorded as (kind and regName from recordedValue): the last
// registered package constant of its registered name, or local constant of its
// name; -1 for any other record, or a constant the module has not registered.
func recordedConstIdx(gc @GenCtx, e @ast.Expr, kind int, regName *[]readonly char) int {
	if kind == VALUE_CONST { return lastRegisteredConst(gc, regName, false) }
	if kind == VALUE_LOCAL_CONST { return lastRegisteredConst(gc, e.Name, true) }
	return -1
}

// lastRegisteredConst returns the index of the last constant registered in
// Module.Consts under name that is a function's (local) or a package's (not
// local), or -1.
func lastRegisteredConst(gc @GenCtx, name *[]readonly char, local bool) int {
	for i := len(gc.Mod.Consts) - 1; i >= 0; i-- {
		if gc.Mod.Consts[i].Local == local && irutil.Streq(gc.Mod.Consts[i].Name, name) { return i }
	}
	return -1
}

// genRecordedIdent reads the identifier e as the checker recorded it (kind and
// regName from recordedValue): a function's constant or variable from its
// binding, a package variable from its global, a package constant from the
// checker's value, or -- one the checker folds no value for, a floating-point
// one -- from the module's table (recordedConstIdx).
func genRecordedIdent(ctx @GenContext, b @ir.Block, e @ast.Expr, kind int,
		regName *[]readonly char) @ir.Instr {
	if kind == VALUE_LOCAL_CONST {
		var ci int = recordedLocal(ctx, e, true)
		return emitModuleConstAt(ctx, b, ctx.Vars[ci].ConstIdx - 1, ctx.Vars[ci].ScopeLen)
	}
	if kind == VALUE_LOCAL {
		var li int = recordedLocal(ctx, e, false)
		return irbuild.EmitLoad(b, ctx.Vars[li].Ptr, ctx.Vars[li].Typ)
	}
	if kind == VALUE_VAR {
		var gp @ir.Instr = recordedGlobalRef(ctx.Gc, e, regName)
		return irbuild.EmitLoad(b, gp, gp.TypeArg)
	}
	if ctx.Checker != nil && e.ResolvedTypeID > 0 {
		var cv constval.Value
		var cst int
		cv, cst = ctx.Checker.ConstValue(e)
		if cst == constval.OK { return emitConstValue(b, cv) }
	}
	if kind == VALUE_CONST {
		var ci int = recordedConstIdx(ctx.Gc, e, kind, regName)
		// A package constant's initializer sees no local.
		if ci >= 0 { return emitModuleConstAt(ctx, b, ci, 0) }
		recordMissICE(e, buf.Concat("the package constant ", regName))
	}
	recordMissICE(e, "a value")
	return nil
}

// recordMissICE reports, as an internal error, that IR-gen has no what for the
// identifier e, which the checker resolved.
func recordMissICE(e @ast.Expr, what *[]readonly char) {
	var s @[]char = buf.Concat("internal error: IR-gen has no ", what)
	s = buf.Concat(s, " that the checker resolved ")
	s = buf.Concat(s, e.Name)
	panic(buf.Concat(s, " to (compiler bug)"))
}
