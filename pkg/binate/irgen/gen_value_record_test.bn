package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/constval"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_value_record.bn: identifiers read from the checker's records.

// recordsCtx checks recordsSrc (checkedRecords) and returns a function context
// in its module with a block to emit into, and the program's file; the
// message of the first checker error instead.
func recordsCtx() (@GenContext, @ir.Block, @ast.File, @[]char) {
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return nil, nil, file, msg }
	var ctx @GenContext
	var b @ir.Block
	ctx, b = scopeTestCtx()
	ctx.Gc = gc
	ctx.Checker = gc.Mod.Checker
	return ctx, b, file, msg
}

// recordsSrc is the program checkedRecords checks; each test sets it first.
var recordsSrc @[]char

// checkedRecords checks recordsSrc, with pkg/a's interface (`var V int` and `func
// F() int`) loaded, and returns a GenCtx whose module has the checker, and the
// program's file; the message of the first checker error instead.
func checkedRecords() (@GenCtx, @ast.File, @[]char) {
	var none @[]char
	var pa @parser.Parser = parser.NewInterface(
			strToBytes("package \"pkg/a\"\nvar V int\nfunc F() int\n"), "a.bni")
	var fa @ast.File = mustParse(pa)
	var c @check.Checker = check.NewChecker()
	c.LoadPackageInterface("pkg/a", fa)
	var p @parser.Parser = parser.New(strToBytes(recordsSrc), "main.bn")
	var file @ast.File = mustParse(p)
	c.Check(file)
	if len(c.CheckerErrors()) > 0 {
		return nil, file, buf.Concat("the program must check: ", c.CheckerErrors()[0].Msg)
	}
	var gc @GenCtx = NewGenCtx(testInitModule(file.PkgName))
	gc.Mod.Checker = c
	gc.Mod.PkgPath = buf.CopyStr("main")
	gc.PkgPath = gc.Mod.PkgPath
	return gc, file, none
}

// varInit returns the initializer of the package variable name in file.
func varInit(file @ast.File, name *[]readonly char) @ast.Expr {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_VAR && irutil.Streq(d.Name, name) { return d.Value }
	}
	return nil
}

// fakeExpr returns an expression of kind kind named name at f.bn:2:3 with no
// record; a type ID marks it checked.
func fakeExpr(kind int, name *[]readonly char, typeID int) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = kind
	e.Name = buf.CopyStr(name)
	e.Pos.File = "f.bn"
	e.Pos.Line = 2
	e.Pos.Col = 3
	e.ResolvedTypeID = typeID
	return e
}

// funcResult returns the expression the function name in file returns in its
// body's last statement, or nil.
func funcResult(file @ast.File, name *[]readonly char) @ast.Expr {
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC || !irutil.Streq(d.Name, name) || d.Body == nil { continue }
		var n int = len(d.Body.Stmts)
		if n == 0 || d.Body.Stmts[n - 1].Kind != ast.STMT_RETURN { return nil }
		return d.Body.Stmts[n - 1].Exprs[0]
	}
	return nil
}

// isGlobalLoad reports whether instr loads the package variable registered
// under name.
func isGlobalLoad(instr @ir.Instr, name *[]readonly char) bool {
	return instr != nil && instr.Op == iropcode.OP_LOAD && len(instr.Args) == 1 &&
			instr.Args[0].IsGlobalRef && irutil.Streq(instr.Args[0].StrVal, name)
}

// A package-level identifier with a record means what the checker resolved it
// to, whatever IR-gen's scopes bind its spelling to: locals named x, a, T and K
// hide neither the package variable x, nor the package a, the type T or the
// package constant K (which the module has not even registered).
func TestRecordedIdentsOverScopes() testing.TestResult {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nimport \"pkg/a\"\nvar x int = 1\nvar y int = x\nvar z int = a.V\n"
					"type T struct { n int }\nfunc (t T) M() int { return t.n }\n"
					"var f *func(T) int = T.M\nconst K int = 3\nvar k int = K\n")
	var ctx @GenContext
	var b @ir.Block
	var file @ast.File
	var msg @[]char
	ctx, b, file, msg = recordsCtx()
	if len(msg) > 0 { return fail(msg) }
	var y @ast.Expr = varInit(file, "y")
	var z @ast.Expr = varInit(file, "z")
	var f @ast.Expr = varInit(file, "f")
	var k @ast.Expr = varInit(file, "k")
	if y == nil || z == nil || f == nil || k == nil { return fail("the initializers must be found") }
	addGlobal(ctx.Gc, "x")
	addManagedVar(ctx, b, "x")
	addManagedVar(ctx, b, "a")
	addManagedVar(ctx, b, "T")
	addManagedVar(ctx, b, "K")
	var gp @ir.Instr = identVar(ctx, y)
	if gp == nil || !gp.IsGlobalRef || !irutil.Streq(gp.StrVal, "x") {
		return fail("y's x must be the package variable")
	}
	if identVarType(ctx, y) != ctx.Gc.Mod.GlobalVars[0].Typ {
		return fail("x's type must be the global's")
	}
	if !isGlobalLoad(genExpr(ctx, b, y), "x") { return fail("reading y's x must load the global") }
	if !identValueBound(ctx, y) { return fail("x must be a value") }
	if identVar(ctx, z.X) != nil || identValueBound(ctx, z.X) {
		return fail("a must name the package")
	}
	if identVar(ctx, f.X) != nil || identVarType(ctx, f.X) != nil {
		return fail("T must name the type")
	}
	if identVar(ctx, k) != nil || identValueBound(ctx, k) { return fail("K must be no variable") }
	if !isPackageConstIdent(ctx.Gc, k) { return fail("K must name the package constant") }
	var kc @ir.Instr = genExpr(ctx, b, k)
	if kc == nil || kc.Op != iropcode.OP_CONST_INT || kc.IntVal != 3 {
		return fail("reading K must give the constant 3, not load the local K")
	}
	return ""
}

// A function's variable or constant with a record is read from the innermost
// binding of its name: the parameter p, not the package variable p, and the
// local constant L.
func TestRecordedIdentsLocals() testing.TestResult {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nvar p int = 1\nfunc g(p int) int { return p }\n"
					"func h() int {\n\tconst L int = 4\n\treturn L\n}\n")
	var ctx @GenContext
	var b @ir.Block
	var file @ast.File
	var msg @[]char
	ctx, b, file, msg = recordsCtx()
	if len(msg) > 0 { return fail(msg) }
	var pr @ast.Expr = funcResult(file, "g")
	var lr @ast.Expr = funcResult(file, "h")
	if pr == nil || lr == nil { return fail("the results must be found") }
	addGlobal(ctx.Gc, "p")
	_ = addManagedVar(ctx, b, "p")
	var inner @ir.Instr = addManagedVar(ctx, b, "p")
	if identVar(ctx, pr) != inner { return fail("p must be the innermost binding") }
	if identVarType(ctx, pr) != ctx.Vars[1].Typ { return fail("p's type must be its binding's") }
	var ld @ir.Instr = genExpr(ctx, b, pr)
	if ld == nil || ld.Op != iropcode.OP_LOAD || ld.Args[0] != inner {
		return fail("reading p must load it")
	}
	addConst(ctx.Gc, "L", 4, true)
	defineConstBinding(ctx, "L", 0)
	var c @ir.Instr = genExpr(ctx, b, lr)
	if c == nil || c.Op != iropcode.OP_CONST_INT || c.IntVal != 4 { return fail("L must read 4") }
	if identVar(ctx, lr) != nil || !identValueBound(ctx, lr) || isPackageConstIdent(ctx.Gc, lr) {
		return fail("L must be a function's constant")
	}
	return ""
}

// A constant with a record is the one registered for it: the package constant K
// (bare, the module's own package), not the function constant K registered after
// it; the function constant L, not the package constant L registered after it.
func TestRecordedConstIdx() testing.TestResult {
	recordsSrc = buf.CopyStr(
			"package \"main\"\nconst K int = 3\nvar k int = K\nfunc h() int {\n\tconst L int = 4\n"
					"\treturn L\n}\n")
	var ctx @GenContext
	var file @ast.File
	var msg @[]char
	ctx, _, file, msg = recordsCtx()
	if len(msg) > 0 { return fail(msg) }
	var gc @GenCtx = ctx.Gc
	var k @ast.Expr = varInit(file, "k")
	var lr @ast.Expr = funcResult(file, "h")
	if k == nil || lr == nil { return fail("the identifiers must be found") }
	addConst(gc, "K", 3, false)
	addConst(gc, "K", 9, true)
	addConst(gc, "L", 4, true)
	addConst(gc, "L", 7, false)
	var env irgenEnv
	env.gc = gc
	var ep *irgenEnv = &env
	var v constval.Value
	var st int
	v, st = ep.Const(k)
	if st != constval.OK || v.N.ToInt64() != 3 { return fail("K must be the package constant") }
	v, st = ep.Const(lr)
	if st != constval.OK || v.N.ToInt64() != 4 { return fail("L must be the function constant") }
	if isFloatExpr(gc, k) { return fail("K is no float constant") }
	return ""
}

// A package constant the checker folds no value for -- a floating-point one --
// is read from the module's table: the last constant registered under its name.
func TestRecordedFloatConstFromTable() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nconst F float64 = 1.5\nvar f float64 = F\n")
	var ctx @GenContext
	var b @ir.Block
	var file @ast.File
	var msg @[]char
	ctx, b, file, msg = recordsCtx()
	if len(msg) > 0 { return fail(msg) }
	var fr @ast.Expr = varInit(file, "f")
	if fr == nil { return fail("the initializer must be found") }
	addFloatConst(ctx.Gc.Mod, "F", "1.5")
	addFloatConst(ctx.Gc.Mod, "F", "2.5")
	var c @ir.Instr = genExpr(ctx, b, fr)
	if c == nil || c.Op != iropcode.OP_CONST_FLOAT || !irutil.Streq(c.StrVal, "2.5") {
		return fail("reading F must give the last registered F, 2.5")
	}
	return ""
}

// The name a package-level record is registered under is bare for the module's
// own package, qualified for any other; an identifier with no record, and a
// selector, have none to read.
func TestRecordedRegName() testing.TestResult {
	recordsSrc = buf.CopyStr("package \"main\"\nimport \"pkg/a\"\nvar z int = a.V\n")
	var gc @GenCtx
	var file @ast.File
	var msg @[]char
	gc, file, msg = checkedRecords()
	if len(msg) > 0 { return fail(msg) }
	if !irutil.Streq(recordedRegName(gc, "main", "x"), "x") { return fail("main.x must be bare") }
	if !irutil.Streq(recordedRegName(gc, "pkg/a", "V"), "pkg/a.V") {
		return fail("pkg/a.V must be qualified")
	}
	var have bool
	_, _, have = recordedValue(gc, fakeExpr(ast.EXPR_IDENT, "x", 1))
	if have { return fail("an unrecorded identifier must have no record") }
	_, _, have = recordedValue(gc, varInit(file, "z"))
	if have { return fail("a selector must have no identifier record") }
	return ""
}

// At the REPL a package constant a later input shadowed is registered under its
// hidden name, and a record of it reads that name: a floating-point constant's
// initializer, lowered again at each read, names the constant it was checked
// against, not the one that shadows it.
func TestRecordedValueShadowedConst() testing.TestResult {
	var gc @GenCtx
	var c @check.Checker
	gc, c = genReplSession("package \"main\"\nconst H float64 = 2.5\nconst J float64 = H + 1.0\n"
			"func main() { }\n")
	var j int = findPackageConst(gc, "J")
	if j < 0 || gc.Mod.Consts[j].Kind != CONST_EXPR || gc.Mod.Consts[j].Expr.Kind != ast.EXPR_BINARY {
		return fail("J must keep its initializer")
	}
	var h @ast.Expr = gc.Mod.Consts[j].Expr.X
	var kind int
	var reg @[]char
	kind, reg, _ = recordedValue(gc, h)
	if kind != VALUE_CONST || !irutil.Streq(reg, "H") { return fail("J's H must read the constant H") }
	_ = checkedReplDecl(c, "const H float64 = 0.5")
	var sh check.ReplShadow
	var ok bool
	sh, ok = c.ShadowedBinding("H")
	if !ok { return fail("the checker must report H shadowed") }
	kind, reg, _ = recordedValue(gc, h)
	if kind != VALUE_CONST || !irutil.Streq(reg, sh.Hidden) {
		return fail(buf.Concat("J's H must read the shadowed constant's hidden name, not ", reg))
	}
	return ""
}
