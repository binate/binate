package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"

// The functions initializing package variables -- a package's init function, and
// each the REPL runs for a variable declared at the prompt -- store into each
// variable's global, which its declaration names.

// GenGlobalInitFunc generates a function initializing package variables (see
// irgen.bni): each declaration's initialization is a statement of its body
// (genPackageVarInit), and the body ends as a function's does (endFuncBody).
// gc.GlobalInitFunc names the function only while it is generated; a closure
// generated inside it is a different function and keeps the ordinary
// per-function path.
func GenGlobalInitFunc(gc @GenCtx, name @[]char, decls *[]@ast.Decl) @ir.Func {
	var saved @[]char = gc.GlobalInitFunc
	gc.GlobalInitFunc = qualifyForCurrentModule(gc, name)
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc(gc.PkgPath, name, noParams, noResults)
	// As genFunc's: the body's cleanup registers pending dtors through f.Mod.
	f.Mod = gc.Mod
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var ctx @GenContext = make(GenContext)
	ctx.Func = f
	ctx.Gc = gc
	ctx.Checker = gc.Mod.Checker
	ctx.CurBlock = entry
	// The body is a block (genBlock): its scope is released as it closes, unless a
	// statement ended it.
	openScope(ctx)
	var cur @ir.Block = entry
	var ended bool = false
	for i := 0; i < len(decls) && !ended; i++ {
		cur = genPackageVarInit(ctx, cur, decls[i])
		annotateBlockInstrs(cur, decls[i].Pos.Line)
		ended = blockIsTerminated(cur)
	}
	_ = closeScope(ctx, cur, !ended)
	endFuncBody(ctx, entry)
	irbuild.VerifyFuncOrAbort(f)
	gc.GlobalInitFunc = saved
	return f
}

// genPackageVarInit generates, as a statement starting in b, the initialization of
// the package variable the declaration d declares: its initializer stored into the
// variable's global as an assignment stores it (emitVarAssign), or, with none, its
// type's zero value, releasing what the global held; a blank variable's
// initializer is evaluated for its side effects.  The statement's temporaries are
// released at its end.
func genPackageVarInit(ctx @GenContext, b @ir.Block, d @ast.Decl) @ir.Block {
	ctx.CurBlock = b
	var st StmtTemps = beginStmtTemps(ctx)
	if isBlankName(d.Name) {
		if d.Value != nil { genForEffect(ctx, b, d.Value) }
		b = ctx.CurBlock
	} else {
		var gi int = declaredGlobal(ctx.Gc, d)
		var typ @types.Type = ctx.Gc.Mod.GlobalVars[gi].Typ
		var ptr @ir.Instr = irbuild.NewGlobalRef(ctx.Gc.Mod, ctx.Gc.Mod.GlobalVars[gi].Name, typ)
		var val @ir.Instr
		if d.Value != nil {
			val = genExprOrFuncRef(ctx, b, d.Value, typ)
			b = ctx.CurBlock
		} else {
			val = emitZeroValue(b, typ)
		}
		b = emitVarAssign(ctx, b, ptr, typ, val)
	}
	b = emitTempCleanup(ctx, b)
	endStmtTemps(ctx, b, st)
	return b
}

// declaredGlobal returns the index in Mod.GlobalVars of the global of the package
// variable the declaration d declares: the module registers each variable of its
// own package under the name the declaration gives it (registerVarGlobalsFrom; at
// the REPL, GenDecl, once a variable it shadows is renamed out of the way).  An
// internal error when the module registers none.
func declaredGlobal(gc @GenCtx, d @ast.Decl) int {
	var gi int = ir.GlobalVarIndexLookup(gc.Mod, d.Name)
	if gi < 0 {
		var s @[]char = buf.Concat(
				"internal error: IR-gen registered no global for the package variable ", d.Name)
		panic(buf.Concat(s, " (compiler bug)"))
	}
	return gi
}
