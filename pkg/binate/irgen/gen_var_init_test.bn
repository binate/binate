package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for gen_var_init.bn: the functions initializing package variables.

// globalStoreTo reports whether instr stores into the global name.
func globalStoreTo(instr @ir.Instr, name *[]readonly char) bool {
	return instr.Op == iropcode.OP_STORE && len(instr.Args) == 2 && instr.Args[0].IsGlobalRef &&
			irutil.Streq(instr.Args[0].StrVal, name)
}

// initEvents lists, in order, what f does that a package variable's initialization
// shows: each store into a global (`=name`) and each call (`call`).
func initEvents(f @ir.Func) @[]char {
	var out @[]char = ""
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			var instr @ir.Instr = f.Blocks[i].Instrs[j]
			if instr.Op == iropcode.OP_STORE && len(instr.Args) == 2 && instr.Args[0].IsGlobalRef {
				out = buf.Concat(buf.Concat(buf.Concat(out, "="), instr.Args[0].StrVal), " ")
			} else if instr.Op == iropcode.OP_CALL {
				out = buf.Concat(out, "call ")
			}
		}
	}
	return out
}

// A package's init function stores each initializer into its variable's global,
// in the order the initializers depend on one another (b reads a, declared after
// it), and then runs a blank variable's initializer for its side effects.
func TestGlobalInitStoresIntoDeclaredGlobals() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\nvar b int = a + 1\nvar _ int = side()\nvar a int = 5\n"
					"func side() int { return 1 }\nfunc main() {}\n")
	var f @ir.Func = lookupFunc(m, "test.__init")
	if f == nil { return fail("expected test.__init") }
	var got @[]char = initEvents(f)
	if !seq(got, "=a =b call ") { return fail(buf.Concat("test.__init does: ", got)) }
	return ""
}

// A declaration with no initializer -- the REPL's redeclaration of a variable with
// its own type -- resets its variable: the value it held is loaded and released,
// and its type's zero value is stored in its place.
func TestGlobalInitResetsWithoutInitializer() testing.TestResult {
	var p @parser.Parser = parser.New(
			strToBytes("package \"main\"\nvar s @int\nfunc main() { }\n"), "test")
	var file @ast.File = mustParse(p)
	var gc @GenCtx = NewGenCtx(testInitModule(file.PkgName))
	GeneratePackage(mustCheck(file), file, gc)
	var ds @[]@ast.Decl = make_slice(@ast.Decl, 1)
	ds[0] = file.Decls[0]
	var f @ir.Func = GenGlobalInitFunc(gc, buf.CopyStr("__reset"), ds)
	if len(gc.GlobalInitFunc) > 0 { return fail("GlobalInitFunc must name no function after") }
	var old @ir.Instr = nil
	var released bool = false
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			var instr @ir.Instr = f.Blocks[i].Instrs[j]
			if instr.Op == iropcode.OP_LOAD && len(instr.Args) == 1 && instr.Args[0].IsGlobalRef &&
					irutil.Streq(instr.Args[0].StrVal, "s") {
				old = instr
			}
			if instr.Op == iropcode.OP_REFDEC && old != nil && len(instr.Args) == 1 &&
					same(instr.Args[0], old) {
				released = true
			}
			if globalStoreTo(instr, "s") {
				if !released { return fail("s's value must be loaded and released before the store") }
				if instr.Args[1].Op != iropcode.OP_CONST_NIL { return fail("s must be stored its zero value") }
				return ""
			}
		}
	}
	return fail("s must be stored")
}
