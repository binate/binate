package "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Function-local variable slots: the VarSlot binding list (ctx.Vars) and its
// define / lookup helpers, including imported-global lookups by qualified name.

// VarSlot tracks a name → SSA-pointer binding for a function-local variable
// or parameter. Ptr is the OP_ALLOC instruction whose result holds the
// variable's address; Typ is the variable's declared type. IsParam
// distinguishes parameters (whose slice values aren't freed by the
// epilogue, since they came from the caller).
type VarSlot struct {
	Name    *[]readonly char
	Ptr     @ir.Instr
	Typ     @types.Type
	IsParam bool // true for function parameters (don't free slices)
	// ClearAfterRelease zeroes the slot after its scope-exit release, for a
	// hidden slot allocated once in the entry block and stored to with
	// release-the-old-value semantics (a raw-slice literal's backing): the
	// scope may be entered again (a loop body), and its next store or release
	// must not see the already-released values.
	ClearAfterRelease bool
	// ConstIdx is 1 + the Module.Consts index of the local constant bound to
	// Name, or 0 for a variable.  A constant has no storage (Ptr and Typ are
	// nil): a read emits its value (emitModuleConstAt), so an untyped constant
	// stays untyped, and the binding hides an outer variable of the same name.
	ConstIdx int
	// ScopeLen is, for a constant, the number of entries before it in Vars:
	// the bindings its initializer sees (genConstExpr).
	ScopeLen int
}

// lookupVar searches locals (most recent first) then globals for a variable's
// alloca: nil when the name is not a variable, including when the innermost
// local binding of the name is a constant (defineConstBinding).
func lookupVar(ctx @GenContext, name *[]readonly char) @ir.Instr {
	// Search backwards for most recent definition (shadowing)
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if irutil.Streq(ctx.Vars[i].Name, name) {
			return ctx.Vars[i].Ptr
		}
	}
	// Fall back to global variables: a pseudo-instruction for the global's
	// address.
	var gi int = bareGlobalIdx(ctx.Gc, name)
	if gi < 0 { return nil }
	return ir.NewGlobalRef(ctx.Gc.Mod, ctx.Gc.Mod.GlobalVars[gi].Name, ctx.Gc.Mod.GlobalVars[gi].Typ)
}

// renameVar renames the most recent variable slot named `from` to `to` (and
// the alloca's debug-info tag with it), making it visible under `to` from
// here on.  The parallel short variable declaration binds each element under
// a hidden name while the others are still being evaluated, then renames.
func renameVar(ctx @GenContext, from *[]readonly char, to *[]readonly char) {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if irutil.Streq(ctx.Vars[i].Name, from) {
			var ptr @ir.Instr = ctx.Vars[i].Ptr
			if ptr != nil && ptr.Op == iropcode.OP_ALLOC && irutil.Streq(ptr.StrVal, from) {
				ptr.StrVal = buf.CopyStr(to)
			}
			ctx.Vars[i].Name = to
			return
		}
	}
}

// lookupImportedGlobalPtr returns an IsGlobalRef pointer to an imported
// extern var (a `.bni`-declared `var X T` registered under its dotted
// defining-pkg qualname during RegisterImport), or nil if qualName isn't
// one.  Parallels lookupVar's same-package global fallback, but the
// pointer carries the DOTTED name so codegen's GlobalName mangles it to
// the owner's symbol (matching its definition), not the importing
// module's package path.  Used for reads (lookupImportedGlobalRead) and
// for write / address-of lvalues (genSelectorPtr).
func lookupImportedGlobalPtr(gc @GenCtx, qualName *[]readonly char) @ir.Instr {
	for i := 0; i < len(gc.Mod.GlobalVars); i++ {
		if !irutil.Streq(gc.Mod.GlobalVars[i].Name, qualName) { continue }
		return ir.NewGlobalRef(gc.Mod, gc.Mod.GlobalVars[i].Name, gc.Mod.GlobalVars[i].Typ)
	}
	return nil
}

// lookupImportedGlobalRead loads the value of an imported extern var
// (the read form of lookupImportedGlobalPtr; nil if qualName isn't one).
func lookupImportedGlobalRead(gc @GenCtx, b @ir.Block, qualName *[]readonly char) @ir.Instr {
	var gp @ir.Instr = lookupImportedGlobalPtr(gc, qualName)
	if gp == nil { return nil }
	return irbuild.EmitLoad(b, gp, gp.TypeArg)
}

// genImportedVarLvalue returns the IsGlobalRef pointer for a package-
// qualified imported var used as an lvalue (`&pkg.X` / `pkg.X = v`), or
// nil if e isn't such a selector.  e.X must be a package alias (lookupVar
// misses); the pointer carries the dotted defining-pkg name so codegen
// mangles it to the owner's symbol.  The genSelectorPtr counterpart to
// lookupImportedGlobalRead.
func genImportedVarLvalue(ctx @GenContext, e @ast.Expr) @ir.Instr {
	if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return nil }
	if lookupVar(ctx, e.X.Name) != nil { return nil }
	return lookupImportedGlobalPtr(ctx.Gc, buildQualNameHomed(ctx.Gc.Mod, e.X.Name, e.Name))
}

// lookupVarType returns the declared type of a variable (local or global).
func lookupVarType(ctx @GenContext, name *[]readonly char) @types.Type {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if irutil.Streq(ctx.Vars[i].Name, name) {
			return ctx.Vars[i].Typ
		}
	}
	// Fall back to global variables
	var gi int = bareGlobalIdx(ctx.Gc, name)
	if gi < 0 { return nil }
	return ctx.Gc.Mod.GlobalVars[gi].Typ
}

// defineConstBinding binds the local constant name, in the current scope, to
// Module.Consts[idx].
func defineConstBinding(ctx @GenContext, name *[]readonly char, idx int) {
	ctx.Gc.Mod.Consts[idx].Local = true
	var slot VarSlot
	slot.Name = name
	slot.ConstIdx = idx + 1
	slot.ScopeLen = len(ctx.Vars)
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}

// lookupLocalConst returns the index in ctx.Vars of the local constant name,
// or -1 when its innermost local binding is a variable or it has none.
func lookupLocalConst(ctx @GenContext, name *[]readonly char) int {
	for i := len(ctx.Vars) - 1; i >= 0; i-- {
		if irutil.Streq(ctx.Vars[i].Name, name) {
			if ctx.Vars[i].ConstIdx > 0 {
				return i
			}
			return -1
		}
	}
	return -1
}

// inheritConstBindings binds, in ctx (a function literal's body), every
// local constant bound in outer (the function enclosing the literal): a
// constant is not captured — it has no storage — but its name is in scope in
// the literal's body.
func inheritConstBindings(ctx @GenContext, outer @GenContext) {
	if outer == nil { return }
	for i := 0; i < len(outer.Vars); i++ {
		if outer.Vars[i].ConstIdx > 0 {
			// Its initializer sees the constants inherited before it.
			var slot VarSlot = outer.Vars[i]
			slot.ScopeLen = len(ctx.Vars)
			ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
		}
	}
}

// defineVar adds a local variable to the current scope in the GenContext.
func defineVar(ctx @GenContext, name *[]readonly char, ptr @ir.Instr, typ @types.Type) {
	// Tag the alloca with the variable name for debug info
	if ptr != nil && ptr.Op == iropcode.OP_ALLOC && len(ptr.StrVal) == 0 {
		ptr.StrVal = buf.CopyStr(name)
	}
	var slot VarSlot
	slot.Name = name
	slot.Ptr = ptr
	slot.Typ = typ
	slot.IsParam = false
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}

// defineHiddenOwnedSlot registers a compiler-created slot (never visible by
// name — `name` is not an identifier) as a scope variable that owns its
// managed contents: every exit of the current scope releases it and then
// zeroes it (ClearAfterRelease), so a later store into the same slot — the
// scope entered again, or the slot's expression evaluated again — neither
// double-releases nor leaks.  The slot must be allocated zero-filled in the
// entry block (irbuild.EmitEntryAlloc).
func defineHiddenOwnedSlot(ctx @GenContext, name *[]readonly char, ptr @ir.Instr, typ @types.Type) {
	var slot VarSlot
	slot.Name = name
	slot.Ptr = ptr
	slot.Typ = typ
	slot.IsParam = false
	slot.ClearAfterRelease = true
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}

// allocFrameClosureRecord allocates the closure record of a capturing raw
// `*func` closure — a function literal or a method value — generated in block
// `b`, for the lifetime of the frame (func.closure.allocation; in a package
// initializer, for the rest of the program): zero-filled once per call, tagged
// `debugName` (if non-empty) for debug info, and, when it holds managed
// captures, registered in ctx.FrameSlots so every function exit — and every
// fault pad — releases it (releaseFrameClosureRecords).  The allocation goes at
// the end of the entry block's prologue (ctx.FrameRecordAt), ahead of every
// faulting op of the body: a fault pad attached to an entry-block op generated
// before the closure site releases the record too, and the record's address
// must already be set (and the record zero) when that pad runs.  Each
// evaluation of the closure's site re-fills this one record, storing every
// capture with release-the-old-value semantics (emitStoreManagedSlot), so an
// evaluation repeated within one call — a loop body, a `for` condition — neither
// leaks the previous captures nor releases the record before the frame ends.
func allocFrameClosureRecord(ctx @GenContext, b @ir.Block, closureStruct @types.Type,
		debugName *[]readonly char) @ir.Instr {
	if isGlobalInitFunc(ctx) {
		// A package-level initializer's closure — a method value in a package
		// variable's initializer (a package-level literal has no locals to
		// capture) — has no frame to live in: its record is a package global,
		// live for the rest of the program and released, like every managed
		// global, only by the VM's global teardown (gen_teardown.bn).  The
		// global reference is a pseudo-operand, not a value: take the record's
		// address as a value in `b` (as a package-level raw-slice literal does its
		// backing's) so the stores and the function value's data word can use it.
		if closureStruct.NeedsDestruction() {
			registerClosureStructForCleanup(ctx.Gc, closureStruct)
		}
		var g @ir.Instr = newPackageStaticSlot(ctx.Gc.Mod, "__closure_record_", closureStruct)
		return irbuild.EmitBitCast(b, g, types.MakePointerType(closureStruct))
	}
	var ptr @ir.Instr = irbuild.EmitAllocAt(ctx.Func.Blocks[0], ctx.FrameRecordAt, closureStruct)
	ctx.FrameRecordAt = ctx.FrameRecordAt + 1
	if len(debugName) > 0 {
		ptr.StrVal = buf.CopyStr(debugName)
	}
	if closureStruct.NeedsDestruction() {
		registerClosureStructForCleanup(ctx.Gc, closureStruct)
		var slot VarSlot
		slot.Name = "<closure-record>"
		slot.Ptr = ptr
		slot.Typ = closureStruct
		ctx.FrameSlots = slices.Append[VarSlot](ctx.FrameSlots, slot)
	}
	return ptr
}

// defineFuncValueVar allocates a func-value slot of type `fvTyp`, constructs the
// non-capturing func value for the top-level function `name` into it, and binds
// `varName` to the slot.  The one home for the alloc→func-value→store→bind
// sequence that a func-reference initializer produces, shared by `var` (genDecl)
// and `:=` (genShortVar), for both a bare function reference (`add`) and a
// generic-function instantiation (`glib.Ident[int]`).
func defineFuncValueVar(ctx @GenContext, b @ir.Block, varName *[]readonly char,
		name *[]readonly char, fvTyp @types.Type) {
	var ptr @ir.Instr = irbuild.EmitAlloc(b, fvTyp)
	var val @ir.Instr = irbuild.EmitFuncValue(b, name, fvTyp)
	noteSPGrowingResult(ctx, val)
	irbuild.EmitStore(b, ptr, val)
	defineVar(ctx, varName, ptr, fvTyp)
}

// defineVarParam adds a function parameter variable to the scope (marked as param for cleanup).
func defineVarParam(ctx @GenContext, name *[]readonly char, ptr @ir.Instr, typ @types.Type) {
	// Tag the alloca with the variable name for debug info
	if ptr != nil && ptr.Op == iropcode.OP_ALLOC && len(ptr.StrVal) == 0 {
		ptr.StrVal = buf.CopyStr(name)
	}
	var slot VarSlot
	slot.Name = name
	slot.Ptr = ptr
	slot.Typ = typ
	slot.IsParam = true
	ctx.Vars = slices.Append[VarSlot](ctx.Vars, slot)
}
