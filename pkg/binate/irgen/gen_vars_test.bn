package "pkg/binate/irgen"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for gen_vars.bn — the variable-scope machinery (defineVar / lookupVar).

// Block-scoped `var x` shadows the outer `var x`. Each shadowed
// binding must produce its own OP_ALLOC — the variable-scope
// machinery (defineVar / lookupLocalVar / pushScope etc.) is what
// keeps the bindings distinct.
func TestGenScopeShadow() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\nfunc main() {\n")
	cb.Write("\tvar x int = 1\n\t{\n")
	cb.Write("\t\tvar x int = 2\n\t\t_ = x\n")
	cb.Write("\t}\n\t_ = x\n}\n")
	var src @[]char = buf.CopyStr(cb.String())
	var m @ir.Module = genFromSource(src)
	var entry @ir.Block = m.Funcs[0].Blocks[0]
	// Should have 2 allocs (outer x, inner x)
	var allocCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_ALLOC { allocCount = allocCount + 1 }
	}
	if allocCount < 2 {
		return fail(
				buf.Concat(
						"expected >=2 allocs for shadowed vars, got ", strconv.Itoa(allocCount)))
	}
	return ""
}
