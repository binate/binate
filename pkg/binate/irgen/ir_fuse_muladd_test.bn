package "pkg/binate/irgen"

import "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// fuseSetTarget64 configures a 64-bit target so `int` is a full-GP-width integer
// and the fuse-mul-add pass (which fuses only full-width integers) fires on it.
func fuseSetTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// A single-use multiply feeding an add (`a*b + c`) must fuse into one OP_MADD,
// leaving no standalone OP_MUL.
func TestFuseMulIntoAdd() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	fuseSetTarget64()
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(a int, b int, c int) int {\n"
					"\treturn a * b + c\n}\n")
	if len(m.Funcs) < 1 {
		types.SetTarget(saved)
		return fail("setup: expected the gen'd func")
	}
	iropt.RunOptPasses(m, 1)
	var madd int = countOp(m.Funcs[0], iropcode.OP_MADD)
	var mul int = countOp(m.Funcs[0], iropcode.OP_MUL)
	types.SetTarget(saved)
	if madd != 1 {
		return fail("a*b+c should fuse into exactly one OP_MADD")
	}
	if mul != 0 {
		return fail("the fused multiply must be removed")
	}
	return ""
}

// A single-use multiply as the subtrahend (`c - a*b`) must fuse into one OP_MSUB.
func TestFuseMulIntoSub() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	fuseSetTarget64()
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(a int, b int, c int) int {\n"
					"\treturn c - a * b\n}\n")
	if len(m.Funcs) < 1 {
		types.SetTarget(saved)
		return fail("setup: expected the gen'd func")
	}
	iropt.RunOptPasses(m, 1)
	var msub int = countOp(m.Funcs[0], iropcode.OP_MSUB)
	var mul int = countOp(m.Funcs[0], iropcode.OP_MUL)
	types.SetTarget(saved)
	if msub != 1 {
		return fail("c-a*b should fuse into exactly one OP_MSUB")
	}
	if mul != 0 {
		return fail("the fused multiply must be removed")
	}
	return ""
}

// A multiply whose result is used more than once must NOT fuse (the standalone
// product is still needed), so the OP_MUL survives and no OP_MADD is created.
func TestNoFuseMultiUseMul() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	fuseSetTarget64()
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(a int, b int, c int) int {\n"
					"\tvar t int = a * b\n"
					"\treturn (t + c) + t\n}\n")
	if len(m.Funcs) < 1 {
		types.SetTarget(saved)
		return fail("setup: expected the gen'd func")
	}
	iropt.RunOptPasses(m, 1)
	var madd int = countOp(m.Funcs[0], iropcode.OP_MADD)
	var mul int = countOp(m.Funcs[0], iropcode.OP_MUL)
	types.SetTarget(saved)
	if madd != 0 {
		return fail("a multi-use multiply must not fuse")
	}
	if mul != 1 {
		return fail("the multi-use multiply must survive")
	}
	return ""
}

// `a*b - c` must NOT fuse: MSUB computes `addend - product`, and there is no
// single fused form for `product - addend` (the multiply is the minuend).
func TestNoFuseSubMinuend() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	fuseSetTarget64()
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(a int, b int, c int) int {\n"
					"\treturn a * b - c\n}\n")
	if len(m.Funcs) < 1 {
		types.SetTarget(saved)
		return fail("setup: expected the gen'd func")
	}
	iropt.RunOptPasses(m, 1)
	var msub int = countOp(m.Funcs[0], iropcode.OP_MSUB)
	var mul int = countOp(m.Funcs[0], iropcode.OP_MUL)
	types.SetTarget(saved)
	if msub != 0 {
		return fail("product-minus-addend has no fused form and must not fuse")
	}
	if mul != 1 {
		return fail("the unfused multiply must survive")
	}
	return ""
}
