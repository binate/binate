package "pkg/binate/irgen"

import "pkg/binate/irdata"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// setOrAppendFuncSig replaces in place on a matching Name (no growth) and
// appends a fresh one otherwise; the index resolves to the (single) live entry
// either way.
func TestFuncSigIndexSetOrAppendReplaces() testing.TestResult {
	var m @ir.Module = ir.NewModule("m")
	var gc @GenCtx = NewGenCtx(m)
	var s1 irdata.FuncSig
	s1.Name = "S"
	s1.IsVariadic = false
	setOrAppendFuncSig(gc, s1)
	var s2 irdata.FuncSig
	s2.Name = "S"
	s2.IsVariadic = true
	setOrAppendFuncSig(gc, s2)
	if m.FuncSigs.Len() != 1 {
		return fail("setOrAppendFuncSig must replace S in place, not grow")
	}
	var idx int = ir.FuncSigIndexLookup(m, "S")
	if idx != 0 || !m.FuncSigs.Get(idx).IsVariadic {
		return fail("S must resolve to the replaced (variadic) entry")
	}
	return ""
}

// setOrAppendFuncSig's in-place replace (FuncSigs.Set) drops the OLD sig,
// freeing its Name @[]char.  The FuncSigIndex key BORROWS that Name backing, so
// the replace must refresh the stored key onto the NEW sig's live Name — else
// the key dangles and a later same-name lookup reads freed (possibly reused)
// memory: it misses on any allocator that clobbers freed bytes, which is how a
// REPL-redefined pointer-receiver method silently loses its params (and then
// passes its receiver by value, dropping the mutation) on macOS but not Linux.
// TestFuncSigIndexSetOrAppendReplaces above misses this because its two `"S"`
// LITERALS share immortal rodata — the borrow never dangles.  Here the two sigs
// get DISTINCT mutable backings, and the original is clobbered after the replace
// to emulate the freed-then-reused memory: with the key refresh the index still
// resolves via the new backing; without it, the clobbered old bytes miss.
func TestFuncSigIndexReplaceRefreshesBorrowKey() testing.TestResult {
	var m @ir.Module = ir.NewModule("m")
	var gc @GenCtx = NewGenCtx(m)
	var nameA @[]char = make_slice(char, 1)
	nameA[0] = 'S'
	var s1 irdata.FuncSig
	s1.Name = nameA
	setOrAppendFuncSig(gc, s1)
	var nameB @[]char = make_slice(char, 1)
	nameB[0] = 'S'
	var s2 irdata.FuncSig
	s2.Name = nameB
	s2.IsVariadic = true
	setOrAppendFuncSig(gc, s2)
	// Clobber the ORIGINAL Name backing (still reachable here via nameA) to stand
	// in for the freed-then-reused memory a dangling borrow key would read.
	nameA[0] = 'X'
	var idx int = ir.FuncSigIndexLookup(m, "S")
	if idx != 0 {
		return fail("'S' must resolve after its old Name backing is clobbered (key must refresh)")
	}
	if !m.FuncSigs.Get(idx).IsVariadic {
		return fail("lookup must return the replaced (variadic) entry")
	}
	return ""
}
