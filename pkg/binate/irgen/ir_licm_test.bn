package "pkg/binate/irgen"

import "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// blockHasBoth reports whether some block of fn contains both an opA and an opB
// instruction.
func blockHasBoth(fn @ir.Func, opA int, opB int) bool {
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		var hasA bool = false
		var hasB bool = false
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == opA {
				hasA = true
			}
			if b.Instrs[j].Op == opB {
				hasB = true
			}
		}
		if hasA && hasB {
			return true
		}
	}
	return false
}

// LICM must hoist the loop-invariant constant `7` (in `s += i*7`) out of the loop
// body into the preheader.  Before opt the body block holds both the OP_MUL and
// the OP_CONST_INT 7; after RunOptPasses no block holding the OP_MUL still holds a
// constant (the 7 was hoisted to the preheader, which has no mul).
func TestLICMHoistsInvariantConstOutOfLoop() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func sum(n int) int {\n"
					"\tvar s int = 0\n"
					"\tfor i := 0; i < n; i = i + 1 {\n"
					"\t\ts = s + i * 7\n"
					"\t}\n"
					"\treturn s\n}\n")
	if len(m.Funcs) < 1 {
		return fail("setup: expected the gen'd func")
	}
	var f @ir.Func = m.Funcs[0]
	if !blockHasBoth(f, iropcode.OP_MUL, iropcode.OP_CONST_INT) {
		return fail("setup: expected a loop-body block with both the mul and the const")
	}
	iropt.RunOptPasses(m, 1)
	if blockHasBoth(f, iropcode.OP_MUL, iropcode.OP_CONST_INT) {
		return fail("LICM should hoist the invariant const out of the loop body")
	}
	return ""
}

// countOpInBlock counts op instructions in one block.
func countOpInBlock(b @ir.Block, op int) int {
	var n int = 0
	for j := 0; j < len(b.Instrs); j++ {
		if b.Instrs[j].Op == op {
			n = n + 1
		}
	}
	return n
}

// A loop-invariant REMAINDER (`p % 7`, p a param) must NOT be hoisted — the raw
// OP_REM can trap (#DE), so speculating it into the preheader is unsound.  After
// LICM the OP_REM stays in the loop body (absent from the entry/preheader block,
// Blocks[0]), even though its invariant operand `7` IS hoisted there.
func TestLICMDoesNotHoistTrappingRem() testing.TestResult {
	var m @ir.Module = genFromSource(
			"package \"test\"\n"
					"func f(n int, p int) int {\n"
					"\tvar s int = 0\n"
					"\tfor i := 0; i < n; i = i + 1 {\n"
					"\t\ts = s + p % 7\n"
					"\t}\n"
					"\treturn s\n}\n")
	if len(m.Funcs) < 1 {
		return fail("setup: expected the gen'd func")
	}
	var f @ir.Func = m.Funcs[0]
	if countOp(f, iropcode.OP_REM) != 1 {
		return fail("setup: expected one OP_REM")
	}
	iropt.RunOptPasses(m, 1)
	// The REM must survive (not removed) and must NOT be hoisted to the preheader.
	if countOp(f, iropcode.OP_REM) != 1 {
		return fail("the invariant REM must not be removed")
	}
	if len(f.Blocks) == 0 || countOpInBlock(f.Blocks[0], iropcode.OP_REM) != 0 {
		return fail("LICM must NOT hoist a trapping OP_REM into the preheader")
	}
	return ""
}
