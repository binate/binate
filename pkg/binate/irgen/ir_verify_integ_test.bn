package "pkg/binate/irgen"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Control flow whose arms all return leaves benign orphaned merge/exit
// blocks; the verifier must NOT flag them (it omits reachability).
func TestVerifyAcceptsControlFlowIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func sw(n int) int {\n")
	cb.Write("  switch n {\n")
	cb.Write("  case 0: return 1\n")
	cb.Write("  default: return 2\n")
	cb.Write("  }\n")
	cb.Write("}\n")
	cb.Write("func iff(n int) int {\n")
	cb.Write("  if n > 0 { return 1 } else { return 2 }\n")
	cb.Write("}\n")
	cb.Write("func lp() int {\n")
	cb.Write("  var s int = 0\n")
	cb.Write("  for i := 0; i < 3; i = i + 1 { s = s + i }\n")
	cb.Write("  return s\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]ir.IRViolation = irbuild.VerifyModule(m)
	if len(vs) != 0 {
		return fail("generated control-flow IR should verify clean (no reachability FP)")
	}
	return ""
}

// The fixed @func-field assignment and multi-assign shapes (the 634/641
// reproducers in corrected form) must verify clean.
func TestVerifyAcceptsFuncFieldAndMultiAssignIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type IO struct { w @func() int; e @func() int }\n")
	cb.Write("type H struct { n int }\n")
	cb.Write("func fa() int { return 1 }\n")
	cb.Write("func fb() int { return 2 }\n")
	cb.Write("func tw() (@func() int, int) { return fa, 5 }\n")
	cb.Write("func mkIO() IO {\n")
	cb.Write("  var io IO\n")
	cb.Write("  io.w = fa\n")
	cb.Write("  io.e = fb\n")
	cb.Write("  return io\n")
	cb.Write("}\n")
	cb.Write("func mkH() H {\n")
	cb.Write("  var f @func() int = fa\n")
	cb.Write("  var h H\n")
	cb.Write("  f, h.n = tw()\n")
	cb.Write("  return h\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]ir.IRViolation = irbuild.VerifyModule(m)
	if len(vs) != 0 {
		return fail("generated @func-field / multi-assign IR should verify clean")
	}
	return ""
}

// A panic-terminated function must verify clean.  Regression guard for the
// dead-const-nil bug: panic(...) ends its block with an rt.Panic call
// + unreachable terminator, and genPanicCall returns its dead expression
// "result" const-nil DETACHED (not added to that already-terminated block).
// Adding it would leave a non-terminator after the terminator, the
// finalizer would append a redundant unreachable, and the block would have
// two terminators (VERR_TWO_TERMS).
func TestVerifyAcceptsPanicTerminatedIR() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func mustPos(x int) int {\n")
	cb.Write("  if x > 0 { return x }\n")
	cb.Write("  panic(\"non-positive\")\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	var vs @[]ir.IRViolation = irbuild.VerifyModule(m)
	if len(vs) != 0 {
		return fail("panic-terminated func should verify clean (no dead const-nil)")
	}
	return ""
}

// Exercises the genFunc wire-up: with the assertion ON, generating clean
// source must NOT abort (a false positive would Exit the test process).
func TestVerifyIRAssertionAcceptsCleanGen() testing.TestResult {
	irbuild.SetVerifyIR(true)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("func f(n int) int {\n")
	cb.Write("  if n > 0 { return n } else { return 0 }\n")
	cb.Write("}\n")
	var m @ir.Module = genFromSourceWithChecker(buf.CopyStr(cb.String()))
	irbuild.SetVerifyIR(false) // restore global state for other tests
	if len(irbuild.VerifyModule(m)) != 0 {
		return fail("clean gen with assertion on should be violation-free")
	}
	return ""
}
