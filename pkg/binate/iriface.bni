// Package iriface answers questions about a module's interface registry
// (ir.Module.Interfaces) and the vtables built from it: an interface's own methods
// and parents, its full vtable's size and where a parent's begins within it, the
// interface an alias names, the symbol each vtable slot points at, and the names of
// impl methods and their value-receiver thunks.  The backends, the VM and IR-gen
// all ask these questions.
package "pkg/binate/iriface"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"

// IfaceOwnMethodNames returns the OWN methods of the interface
// (pkg, name) in declaration order — the same list IR-gen
// records during DECL_INTERFACE collection.  Empty for unknown
// or alias-target-missing entries.  `m` names the module whose
// interface registry the (pkg, name) lookup keys on — shared by
// the Iface* query family below.
func IfaceOwnMethodNames(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// IfaceParentPkgs / IfaceParentNames are parallel arrays naming
// each parent interface of (pkg, name) in declaration order
// (`interface X : P1, P2`).  Empty for non-extending interfaces
// or unknown lookups.
func IfaceParentPkgs(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

func IfaceParentNames(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// IfaceFullVtableSize returns the number of slots a `(R, X)`
// vtable occupies under the concat layout:
//   size(X) = 2 (any-block: dtor + *TypeInfo)
//           + sum(size(P) for P in X.Parents)
//           + len(X's own methods)
// Returns 0 if the interface isn't registered.
func IfaceFullVtableSize(m @ir.Module, pkg *[]readonly char, name *[]readonly char) int

// IfaceParentSlotOffset returns the absolute slot index at which
// target's full vtable starts within src's concat vtable, or -1
// if target is not a (transitive) parent of src.  Used to lower
// OP_IFACE_UPCAST.
func IfaceParentSlotOffset(m @ir.Module, srcPkg *[]readonly char, srcName *[]readonly char,
		targetPkg *[]readonly char, targetName *[]readonly char) int

// LookupVtableSlotName returns the symbol name a vtable slot for
// `methodFuncName` should point at: the iv-dispatch thunk's name when
// methodFuncName resolves to a value-receiver method, or methodFuncName itself
// otherwise.  Single source of truth for the codegen vtable emitter and the VM
// vtable-lowering pass.
func LookupVtableSlotName(m @ir.Module, methodFuncName @[]char) @[]char

// CanonicalIfaceName resolves an interface (pkg, name) through the
// alias chain and returns the chain tail's name. If the input
// doesn't refer to a registered interface, returns a fresh copy of
// the input name — at worst the symbol mangles on the impl-site
// reference.
func CanonicalIfaceName(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]char

// CanonicalIfacePkg returns the package (full path) of the chain-tail
// of (pkg, name). Used by the vtable mangling (`__ivt.bn_V...`) to
// ensure aliases collapse to the underlying interface's package. If
// lookup fails, returns the input pkg unchanged.
func CanonicalIfacePkg(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]char

// CanonicalIfaceType returns t with every interface it names — directly or
// under pointer, slice, array, readonly, interface-value, function-type or
// anonymous-struct structure — resolved to the tail of its alias chain
// (CanonicalIfacePkg / CanonicalIfaceName); t itself when none changes.  Used
// wherever a type's identity is its spelling (an instantiation's type
// arguments, a name-less boxed type's structural key), so a type spelled
// through an interface alias is the type spelled with the aliased interface.
func CanonicalIfaceType(m @ir.Module, t @types.Type) @types.Type

// CanonicalIfaceTypes is CanonicalIfaceType over ts, reporting whether any
// changed — ts itself when none does.
func CanonicalIfaceTypes(m @ir.Module, ts @[]@types.Type) (@[]@types.Type, bool)

// LookupModuleInterface returns the cached method-name list for the
// interface (pkg, name), or an empty slice if not found. Follows
// alias chains. Lookup is keyed on (Pkg, Name).
func LookupModuleInterface(m @ir.Module, pkg *[]readonly char, name *[]readonly char) @[]@[]char

// ResolveModuleInterface returns the index in m.Interfaces of
// the entry for (pkg, name), following any alias chain. Returns -1
// on not-found or cycle (defensive cap at 32 hops). Lookup is
// keyed on (Pkg, Name) so cross-package interface refs
// resolve to the imported package's entry without colliding with
// a same-named local interface.
func ResolveModuleInterface(m @ir.Module, pkg *[]readonly char, name *[]readonly char) int

// ThunkNameForMethod returns the qualified IR-level name for
// the iv-dispatch thunk of a value-receiver method.  Input is
// the method's qualified name `<recvPkg>.<recvName>.<method>`;
// output inserts `__bn_thunk_` before the method part:
// `<recvPkg>.<recvName>.__bn_thunk_<method>`.  The `__bn_`
// prefix marks compiler-generated names.
func ThunkNameForMethod(methodFuncName *[]readonly char) @[]char

// ImplSlotFuncName returns the function the vtable slot of interface method
// method holds in the impl row info: the receiver's method the row binds it to
// (ImplInfo.BoundMethods / BoundTo -- another of the receiver's methods only at
// the REPL, the version of a parameterized impl's generation that a later input
// superseded), else the method of its own name (ImplMethodFuncName), or that
// method's value-receiver thunk (LookupVtableSlotName).  The single slot builder
// every backend's vtable layout walk and the VM's use.
func ImplSlotFuncName(m @ir.Module, info @irdata.ImplInfo, method *[]readonly char) @[]char

// ImplMethodFuncName is the qualified IR-level name `<recvPkg>.<T>.<method>` of the
// method an impl row's vtable slot dispatches to, for row receiver recvName.  A
// variant's row -- readonly (irutil.ReadonlyVariantName), raw-origin
// (irutil.RawVariantName) or both -- dispatches to its type's own methods, so it
// names them on the type T it stands for.
func ImplMethodFuncName(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char

// LookupModuleInterfaceIndex returns the index of the entry in m.Interfaces matching
// (pkg, name), or -1 if absent.  No alias-chain resolution.  pkg is the interface's
// package identity -- its full import path (full-path mangling, pkg/binate/mangle), or
// "" for the universe -- and is matched as is: the caller resolves a source-level
// import alias.
func LookupModuleInterfaceIndex(m @ir.Module, pkg *[]readonly char, name *[]readonly char) int
