package "pkg/binate/iriface"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/irutil"

import "pkg/builtins/testing"

// An impl row's method function is named for the receiver's base type, so a
// readonly variant row's vtable slots name the same functions as T's row.
func TestImplMethodFuncName() testing.TestResult {
	if !irutil.CharEq(ImplMethodFuncName("pkg/a", "T", "Get"), "pkg/a.T.Get") {
		return "a base row's method should be <pkg>.<T>.<method>"
	}
	if !irutil.CharEq(ImplMethodFuncName("pkg/a", irutil.ReadonlyVariantName("T"), "Get"),
			"pkg/a.T.Get") {
		return "a readonly variant row's method should name T's method"
	}
	var raw @[]char = irutil.RawVariantName("T")
	if !irutil.CharEq(ImplMethodFuncName("pkg/a", raw, "Get"), "pkg/a.T.Get") ||
			!irutil.CharEq(ImplMethodFuncName("pkg/a", irutil.ReadonlyVariantName(raw), "Get"),
					"pkg/a.T.Get") {
		return "a raw-origin variant row's method, readonly or not, should name T's method"
	}
	return ""
}

// A row's vtable slot holds the receiver's method the row binds the interface
// method to (ImplInfo.BoundMethods / BoundTo), else the method of its own name.
func TestImplSlotFuncName() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var info @irdata.ImplInfo = make(irdata.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "Cell"
	var methods @[]@[]char = make_slice(@[]char, 1)
	methods[0] = "Size"
	var to @[]@[]char = make_slice(@[]char, 1)
	to[0] = "__repl_shadowed_2_Size"
	info.BoundMethods = methods
	info.BoundTo = to
	if !irutil.CharEq(ImplSlotFuncName(m, info, "Size"), "main.Cell.__repl_shadowed_2_Size") {
		return "a bound method's slot should name the method it is bound to"
	}
	if !irutil.CharEq(ImplSlotFuncName(m, info, "Other"), "main.Cell.Other") {
		return "an unbound method's slot should name the method of its own name"
	}
	return ""
}
