// Package iropcode defines the IR instruction opcodes (the OP_* enum) and
// OpName, the opcode -> mnemonic mapping.  Split out of pkg/binate/ir so the
// instruction set is a small leaf package that the IR data model, IR-gen, and
// every backend (codegen / vm / native) share without depending on the whole
// ir surface.  Pure constants + one switch: no dependencies, BUILDER-trivial.
package "pkg/binate/iropcode"

// IR instruction opcodes.  Each OP_* names one SSA-form operation that IR-gen
// emits and the backends (codegen / vm / native) lower; values are assigned by
// iota, so NUM_OPS is the opcode count (used to size per-opcode tables).
// OpName maps each opcode to its mnemonic.
const (
	// Constants
	OP_CONST_INT int = iota
	OP_CONST_FLOAT          // StrVal = raw literal text; Typ = f32/f64/untyped
	OP_CONST_BOOL
	OP_CONST_STRING
	OP_CONST_NIL

	// Arithmetic (binary: Args[0], Args[1])
	OP_ADD
	OP_SUB
	OP_MUL
	OP_DIV // signed (sdiv) vs unsigned (udiv) selected by
	//   Typ.Signed; float operands → fdiv (IEEE: /0 yields
	//   ±Inf/NaN, no panic). Integer divide-by-zero AND the
	//   signed MIN/-1 overflow are a DEFINED runtime panic —
	//   the divisor analogue of OP_BOUNDS_CHECK, an
	//   OP_DIV_CHECK guard before the divide; the `unsafe_div`
	//   builtin opts out (cf. unsafe_index).
	OP_REM // integer-only (float `%` is a type error). Signed
	//   (srem) / unsigned (urem) by Typ.Signed — truncated
	//   remainder (sign follows the dividend). Same DEFINED
	//   panic on a zero divisor / MIN/-1 as OP_DIV; the
	//   `unsafe_rem` builtin opts out.

	// Bitwise (binary: Args[0], Args[1])
	OP_AND
	OP_OR
	OP_XOR
	OP_SHL
	OP_SHR // Typ.Signed picks arithmetic (sign-filling, signed) vs
	//   logical (zero-filling, unsigned) shift. OP_SHL is
	//   sign-agnostic — one form.

	// Comparison (binary: Args[0], Args[1] → bool)
	OP_EQ
	OP_NE
	OP_LT
	OP_LE
	OP_GT
	OP_GE

	// Logical (binary: Args[0], Args[1] → bool). NOT short-circuiting: both
	// operands are pre-evaluated, so these are plain bitwise-on-bool. User-level
	// && / || short-circuit via the branch-form lowering and never emit these —
	// OP_LAND/OP_LOR fire only where operands are already evaluated (e.g. the
	// switch case-list OR in gen_flow.bn).
	OP_LAND
	OP_LOR

	// Unary (Args[0])
	OP_NEG
	OP_NOT
	OP_BITNOT

	// Memory
	OP_ALLOC // stack alloc; TypeArg = element type; result = ptr.
	//   Borrowed raw stack-slot ptr (unmanaged); ALLOC owns
	//   nothing. A managed value later stored here is
	//   acquired/released by the store-site + scope cleanup.
	OP_LOAD // load from ptr: Args[0] = ptr.
	//   Result BORROWS the pointee — NO RefInc; the source
	//   slot must outlive it. Scalar: sized load, sign/zero-
	//   extend per Typ.Signed. Aggregate / 16-byte address-
	//   aggregate (iface/func) / slice / array: keeps the
	//   slot ADDRESS, not a value copy.
	OP_STORE // store to ptr: Args[0] = ptr, Args[1] = value (void).
	//   A RAW store of SizeOf(value) bytes — does NO
	//   refcounting and no save-copy-destroy. The EMITTER
	//   brackets it with acquire-new + release-old (Axiom 5,
	//   gen_control.bn arms); a blank `_` acquires nothing.
	//   Backends must not add or elide refcount.
	OP_GET_FIELD_PTR // struct field ptr: Args[0] = struct ptr, Index = field.
	//   Borrowed interior ptr (base + types.FieldOffset);
	//   pure address math, no ownership. Layout authority is
	//   pkg/binate/types — backends never re-derive offsets.
	OP_GET_ELEM_PTR // array/slice elem ptr: Args[0] = base, Args[1] = index.
	//   Borrowed interior ptr (base + index*SizeOf(elem));
	//   no ownership, no bounds check (OP_BOUNDS_CHECK does).

	// Managed pointers
	OP_BOX // box(val): Args[0] → managed ptr.
	//   Result fresh-owned @T, refcount 1 — caller must
	//   RefDec. Moves Args[0] in; EmitBox registers an
	//   end-of-statement cleanup temp, a store consumeTemp's
	//   it (isFreshManagedPtr). The op never RefDec's.
	OP_MAKE // make(T): TypeArg = type → managed ptr to zero value.
	//   Result fresh-owned @T, refcount 1 — caller must
	//   RefDec (cleanup temp from EmitMake; a var-decl/store
	//   consumeTemp's it).
	OP_MAKE_SLICE // make_slice(T, n): TypeArg = elem type, Args[0] = length → managed-slice
	//   Result fresh-owned @[]T, refcount 1 — caller must
	//   RefDec. Sets StmtGrewSP (VM copies the 3-word header
	//   to vm.SP; OP_SP_RESTORE reclaims). A store
	//   consumeTemp's it (isFreshManagedSlice).
	OP_DEREF // deref ptr: Args[0] → pointed-to value.
	//   Result BORROWS the pointed-to value (load-through,
	//   not a ptr producer); NO RefInc, pointee's slot must
	//   outlive it.
	OP_NIL_CHECK // panic if nil: Args[0] (void)
	OP_REFINC    // inc refcount inline (no call): Args[0] (void).
	//   Backends lower to a nil-check + header load/add/
	//   store. See plan-refcount-inlining.md.
	//   POLICY (Axiom 5, acquire half): IR-gen MUST emit this
	//   for the NEW managed value at every site that writes
	//   it into a slot a later RefDec/__dtor_ will release
	//   (every assignment form, composite/array/slice-literal
	//   element, return, param-entry, closure-capture) —
	//   UNLESS a fresh owned temp's sole ref transfers (then
	//   consumeTemp + move, no RefInc). Blank `_` acquires
	//   nothing. No-op on nil and on immortal (negative-
	//   sentinel) refcounts.
	OP_REFDEC // dec refcount inline fast path: Args[0] = ptr,
	//   optional Args[1] = dtor (void). Backends lower
	//   to a nil-check + header load/sub/store, with a
	//   call to rt.ZeroRefDestroy(ptr, dtor) when the
	//   refcount hits zero. See plan-refcount-inlining.md.
	//   POLICY (Axiom 5, release half): IR-gen MUST emit this
	//   for the PRIOR occupant of any managed slot it
	//   overwrites, and once per managed local/temp at scope
	//   exit. Order: acquire-new BEFORE release-old, so a
	//   self-aliasing store (a[i]=a[i]) can't free the value
	//   it is about to re-store. Args[1] is a dtor HANDLE
	//   (not a VM index), resolving across native↔VM; the
	//   iface/func arms fetch it from vtable[0] and guard on
	//   data!=nil. No-op on nil / immortal refcounts.

	// Slices & arrays
	OP_BOUNDS_CHECK // panic if OOB: Args[0] = index, Args[1] = len (void)

	// Integer divide-fault guard (void). Emitted before OP_DIV / OP_REM
	// on an integer result. Args[0] = dividend, Args[1] = divisor, both
	// already sign/zero-extended to 64-bit by IR-gen. IntVal carries the
	// operand type's resolved bit width and BoolVal its signedness, from
	// which each backend recovers the type's signed MIN. Lowers to a
	// call to rt.DivCheck. `unsafe_div` / `unsafe_rem` skip emission.
	OP_DIV_CHECK

	// Negative-shift-count guard (void). Emitted before a guarded integer
	// shift (`<<` / `>>`) whose count is of a SIGNED type. Args[0] = the
	// shift count, already sign-extended to 64-bit by IR-gen. Lowers to a
	// call to rt.ShiftCheck, which panics when the count is negative — a
	// shift count must be non-negative (a constant negative count is
	// rejected at compile time). `unsafe_shl` / `unsafe_shr` skip emission.
	OP_SHIFT_CHECK

	// Rodata composite literals (Phase 3 of composite-literal generalization).
	// Each op carries its byte sequence on `StrVal`. Codegen looks up the
	// matching string-table entry and emits the appropriate lowering.
	// String literals also flow through these — `EmitStringToChars`
	// dispatches to MSLICE/SLICE/MSLICE_COPY based on target type, and
	// the array equivalent emits OP_RODATA_ARRAY directly. The ops also
	// fire from user-written const-byte composite literals
	// (`@[]readonly char{'a','b','c'}` etc.) when genManagedSliceLit /
	// genRawSliceLit detect the all-const-byte shape.
	OP_RODATA_MSLICE      // rodata `@[]readonly T`: StrVal = byte sequence
	OP_RODATA_SLICE       // rodata `*[]readonly T`: StrVal = byte sequence
	OP_RODATA_ARRAY       // rodata `[N]T`: StrVal = bytes (memcpy + zero-pad)
	OP_RODATA_MSLICE_COPY // owned `@[]T`: alloc + memcpy from rodata (StrVal)

	// Control flow (terminators)
	OP_JUMP   // unconditional: Block1
	OP_BRANCH // conditional: Args[0], Block1, Block2
	OP_RETURN // return: Args = return values. Terminator, no result.
	//   Args carry already-ownership-transferred values:
	//   gen_return.bn emits the acquire (RefInc / save-copy-
	//   destroy / consumeTemp) and local releases BEFORE this
	//   op — backends MUST NOT add or elide refcount.
	//   Multi-return component placement =
	//   types.FieldOffset(MultiReturnType, i) for
	//   SizeOf(component) bytes; deliver ALL bytes incl. a
	//   sub-word tail. 16-byte address-aggregate components
	//   (iface, func) deliver BOTH words in every shape,
	//   iface and func identically. sret threshold = word*2;
	//   a 64-bit scalar single-return on a sub-8-byte word
	//   returns as a register/slot pair.
	OP_UNREACHABLE // unreachable (no args)

	// SSA
	OP_PHI // phi node: Phis = [{Block, Val}, ...].
	//   Managed-typed phi (CONTRACT; no IR-gen caller today):
	//   the merge yields ONE owned ref — exactly one incoming
	//   edge contributes the live value, the others must have
	//   released theirs on their own edge. The result is
	//   registered like any owned def and gets ONE balancing
	//   RefDec at scope/statement end. Never double-count.

	// Calls
	OP_CALL // direct: StrVal = func name, Args = arguments.
	//   A managed result is fresh-owned (refcount 1) — the
	//   caller registers an end-of-statement cleanup temp at
	//   this op (gen_call.bn / gen_method.bn) so it is
	//   RefDec'd even when discarded. Managed @T/@[]T/@func
	//   args are BORROWED (callee RefIncs at entry, RefDecs
	//   at scope exit); an @Iface arg is MOVED in (caller
	//   acquires, callee does not entry-RefInc); a managed
	//   struct/array arg is copied caller-side. Backends must
	//   not add or drop a RefInc/RefDec — the discipline is
	//   here.
	// indirect: Args[0] = fn_ptr (*uint8), Args[1..] = call args, Typ = return
	// type. A managed result is fresh-owned (register a cleanup temp, same as
	// OP_CALL); Args[0] is a raw *uint8 (not refcounted); managed args follow
	// OP_CALL's borrow/copy/move model.
	OP_CALL_INDIRECT
	OP_C_CALL        // `__c_call`: StrVal = verbatim C symbol (NOT
	// mangled), Args = arguments, Typ = return type
	// (nil/void => no result), CFixedArgs = fixed-arg
	// count (variadic iff CFixedArgs < len(Args)).
	// Lowered with the C-extern ABI.  See
	// explorations/plan-c-call.md.
	//   Result is a C value (scalar / raw ptr), NOT a
	//   refcounted managed value — the caller owns no Binate
	//   ref and registers no cleanup temp (the type checker
	//   bars managed __c_call args/results).
	OP_C_GLOBAL // `__c_global`: StrVal = verbatim C data symbol (NOT
	// mangled), Typ = *T (raw pointer to the pointee),
	// TypeArg = T (the pointee, so backends can declare the
	// external global / size the reference).  No Args.  The
	// result is the ADDRESS of the external C global — a raw
	// *T (never refcounted; registers no cleanup temp).
	// Compiled-mode only.  See plan-c-global.md.
	OP_DATA_SYM_ADDR // Address of a LOCAL Binate data global named by its
	// already-MANGLED symbol on StrVal (e.g. `__typeinfo.bn_…`
	// / `__ifaceid.bn_…`), materialized into the result reg.
	// Typ = *T (raw pointer); TypeArg = the global's pointee
	// type, so LLVM can spell the `bitcast <T>* @<sym>`.  No
	// Args.  Unlike OP_C_GLOBAL this is a same-module weak
	// symbol reached by a plain local address (RIP-LEA / ADRP+
	// ADD / MOVW+MOVT), NOT a GOT-indirect cross-DSO load; and
	// unlike OP_IFACE_VALUE's vtable slot it yields the address
	// as a value.  Compiled-mode only (the VM has no data-symbol
	// address model — see plan-type-assertions-execution.md).

	// Conversions
	OP_CAST     // numeric: Args[0], TypeArg = target
	OP_BIT_CAST // reinterpret: Args[0], TypeArg = target.
	//   Same-width, no value change, operand borrowed. When
	//   the operand is a managed ptr (e.g. bit_cast(*uint8,
	//   @T) feeding a dtor/copy call) the result ALIASES the
	//   payload: no new ref, must NOT be RefDec'd.
	OP_MANAGED_TO_RAW // @[]T → *[]T: extract {data, len} prefix from managed-slice.
	//   Result BORROWS the source's backing (NO own ref —
	//   must NOT be RefDec'd); copies no refptr, emits no
	//   RefInc. The source stays a live cleanup temp (NOT
	//   consumed), so its end-of-statement RefDec bounds the
	//   borrow. Storing the result where it outlives the
	//   source is a user UAF, not a compiler obligation.

	// Struct
	OP_STRUCT_LIT // construct: Args = field values, TypeArg = struct type.
	//   Result fresh-owned struct VALUE (insertvalue chain).
	//   Does NOT acquire its managed fields — Args MUST be
	//   already-acquired by the emitter (RefInc / __copy_ /
	//   consumeTemp-if-fresh) before construction; releases
	//   are the aggregate owner's (slot scope-dtor / whole-
	//   struct cleanup temp), never here.
	OP_EXTRACT // extract multi-return: Args[0], Index = which.
	//   Result BORROWS one component of an already-owned
	//   aggregate (the call-result tuple temp); adds NO
	//   RefInc — the whole tuple is RefDec'd once via its
	//   struct-dtor at end of statement. Component lives at
	//   types.FieldOffset(carrier, Index) for SizeOf bytes —
	//   NEVER 8*Index. A 16-byte address-aggregate component
	//   (iface OR func, identically) MUST be delivered in
	//   pointer mode carrying BOTH words (the register holds
	//   the field's slot ADDRESS), never one scalar word.
	OP_FUNC_HANDLE // function-value handle pointer as i8*:
	// StrVal = func name.  Result is a *uint8
	// pointing at a 16-byte {vtable_ptr,
	// data_ptr} block (the static `@__handle.F`
	// bnc emits, or a runtime-allocated handle
	// for bytecode-only functions).  Consumed by
	// OP_CALL_HANDLE.  Phase 4 of
	// plan-uniform-native-fnptrs.md.
	OP_FUNC_VALUE // function value (named-function reference):
	// StrVal = (qualified) function name; Typ =
	// TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE.
	// Result is a 2-word {vtable_ptr, data_ptr};
	// for Phase 1 (non-capturing) data_ptr is the
	// VM closure record (VM mode) or null (compiled
	// mode). See plan-function-values.md.
	//   OWNERSHIP: {vtable@0, data@1} (16B, OPPOSITE of
	//   iface). Capturing @func: data owns a ref to the heap
	//   closure struct; genFuncLit RefIncs each managed
	//   capture BEFORE storing — this op does NOT acquire.
	//   Balanced at the data slot's scope-exit RefDec, which
	//   runs the closure-struct dtor (vtable slot 0,
	//   OP_FUNC_VALUE_DTOR). A fresh @func is moved by
	//   consumeTemp at copy-sites; non-capturing compiled
	//   data=null (inert).
	OP_CALL_FUNC_VALUE // call through a function value:
	// Args[0] = function value (TYP_FUNC_VALUE or
	// TYP_MANAGED_FUNC_VALUE); Args[1..] = call
	// args; Typ = return type. Backends dispatch
	// mode-specifically (compiled: read vtable.call,
	// call indirect; VM: read closure record's
	// vm_func_idx, execFunc).
	//   OWNERSHIP: a managed result is fresh-owned — caller
	//   registers an end-of-statement cleanup temp (same as
	//   OP_CALL). Args[0] is borrowed for dispatch; user
	//   managed args follow OP_CALL's model.
	OP_CALL_HANDLE // call through a function-value handle pointer:
	// Args[0] = *uint8 pointing at a 16-byte
	// {vtable_ptr, data_ptr} block (the result
	// of OP_FUNC_HANDLE); Args[1..] = call args;
	// Typ = return type.  Backends load the
	// handle's vtable.call and data, then
	// dispatch as `call(data, args)` — same
	// shape BC_CALL_FUNC_VALUE uses.  Lowering
	// of `_call_free_fn`.  Phase 4 of
	// plan-uniform-native-fnptrs.md.
	//   OWNERSHIP: a managed result is fresh-owned (register
	//   a cleanup temp, same as OP_CALL); Args[0] (the *uint8
	//   handle) is borrowed; user managed args follow
	//   OP_CALL's model.
	OP_IFACE_VALUE // interface-value construction (Slice 2.3a-2
	// of plan-interface-syntax-revision.md).
	// Args[0] = data ptr (an i8*-shaped pointer
	// value; bitcast from the source's *T / @T at
	// emit time); StrVal = mangled vtable global
	// name (the __ivt vtable symbol for (T, I)). Result
	// is a 2-word {data_ptr, vtable_ptr} value
	// (TYP_INTERFACE_VALUE or
	// TYP_INTERFACE_VALUE_MANAGED depending on
	// construction-site).
	//   OWNERSHIP: {data@0, vtable@1} (16B, OPPOSITE of func).
	//   The MANAGED form (@Iface) owns its data ref, but the
	//   construction site (wrapAsIfaceValue) RefIncs the data
	//   source — this op does NOT acquire; balanced at drop
	//   by a null-guarded RefDec via OP_IFACE_DTOR (vtable
	//   slot 0). The raw form (*Iface) borrows. A fresh
	//   managed iv is moved by consumeTemp at copy-sites.
	OP_CALL_IFACE_METHOD // interface method dispatch (Slice 2.3a-3
	// of plan-interface-syntax-revision.md).
	// Args[0] = interface value (TYP_INTERFACE_VALUE
	// / TYP_INTERFACE_VALUE_MANAGED); Args[1..] =
	// user args; Index = ABSOLUTE concat-vtable slot
	// (slots 0-1 = any-block: dtor, *TypeInfo; first
	// method = slot 2), NOT a
	// 0-based declaration-order index;
	// Typ = return type. Backends extract the
	// data + vtable ptrs from the interface
	// value, GEP into the vtable at slot Index,
	// bitcast the loaded function pointer to
	// `<ret>(i8*, <args>)*`, and call indirect
	// with data as the first argument.
	//   OWNERSHIP: a managed dispatch result is fresh-owned —
	//   owned by the caller exactly like a direct call, and
	//   registered as an end-of-statement cleanup temp (the
	//   producer is irrelevant to lifecycle). Args[0] (the
	//   iv) is borrowed; user managed args follow OP_CALL's
	//   borrow/copy/move model.
	OP_IFACE_DTOR // load slot 0 (dtor) of an interface value's
	// vtable. Args[0] = interface value
	// (TYP_INTERFACE_VALUE /
	// TYP_INTERFACE_VALUE_MANAGED); result type is
	// *uint8 (an opaque function-pointer / handle).
	// Backends:
	//   LLVM: extractvalue iv, 1 (vtable i8*), GEP
	//         slot 0, load i8*.
	//   VM:  read iv[1] as vtable index into
	//         vm.IfaceVtables, return Methods[0]
	//         (1-based VM func index, or 0 = no
	//         dtor). Slot 0 was reserved by Slice
	//         2.5; see plan-interface-syntax-
	//         revision.md.
	OP_IFACE_UPCAST // upcast an interface value to one of its
	// ancestor interfaces (`*Child → *Parent` /
	// `@Child → @Parent`; managed-to-raw decay
	// also routes through here).  Args[0] =
	// source iv (TYP_INTERFACE_VALUE /
	// TYP_INTERFACE_VALUE_MANAGED); StrVal =
	// mangled name of the target's `__ivt.<...>`
	// vtable global (which the transitive impl
	// emission from Slice E.3 already emits for
	// every reachable ancestor); Typ = target iv
	// type.  Result is a new iv with the source's
	// data ptr and the target's vtable.
	// Backends:
	//   LLVM: extractvalue iv, 0 (data); bitcast
	//         the target vtable global to i8*;
	//         build a new {data, vtable}.
	//   VM:  read iv[0]; look up the target
	//         vtable index by name; build a new
	//         {data, vtIdx+1} on the VM stack.
	// Slice E.4 part 2b of
	// plan-interface-embedding.md.

	// Lifetime
	OP_SP_RESTORE // mark end of statement: any vm.Stack
	// temporaries pushed during this statement
	// (aggregate return values copied back by
	// BC_RETURN, BC_MAKE_SLICE / BC_STRING_COPY*
	// / BC_FUNC_VALUE pushes, etc.) are dead and
	// their bytes can be reclaimed. Per-backend
	// semantics:
	//   VM:  emit BC_SP_RESTORE; the handler sets
	//        vm.SP = frameStart + frame.totalSize.
	//   LLVM: no-op (alloca'd temporaries already
	//        get DCE'd / SROA'd by the optimizer).
	//   Native AArch64: no-op (PlanFrame already
	//        sized the frame; spill slots are
	//        function-scoped, not statement-scoped).
	// No operands: pure boundary marker. IR-gen
	// emits at the end of any statement that
	// contains a vm.Stack-growing op (analysis
	// upfront so the VM doesn't pay per-statement
	// dispatch cost on scalar-only statements).
	// See claude-todo.md "builder-comp-int-int:
	// vm.Stack overflow on 001_hello".
	OP_FUNC_VALUE_DTOR // load slot 0 (dtor) of an @func value's
	// vtable.  Args[0] = function value
	// (TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE);
	// result type is *uint8 (an opaque function-
	// pointer / handle).  Mirrors OP_IFACE_DTOR's
	// shape — the only difference is which slot
	// of the 2-word value carries the vtable:
	// BnFuncValue is {vtable (slot 0), data
	// (slot 1)}, BnIfaceValue is {data (slot 0),
	// vtable (slot 1)}.  Backends:
	//   LLVM: extractvalue fv, 0 (vtable i8*),
	//         GEP slot 0, load i8*.
	//   VM:  load fv[1] as the (vmHandle, fnIdx)
	//         tuple's vtable index; closure
	//         records carry the dtor in their
	//         own record so the dtor lookup is
	//         direct.  See vm_exec_funcref.bn.
	//   Native (aa64 / x64): LDR / MOV the
	//         vtable ptr from fv slot 0, then
	//         LDR / MOV the dtor from vtable[0].
	// B.3b commit 2 — drives the scope-end
	// RefDecDtor on a @func variable's data slot.

	OP_IFACE_TYPEINFO // read an interface value's dynamic `*TypeInfo`
	// (any-block slot 1, spec §7.13.8/§11.12).
	// Args[0] = the iface value `iv`; the op extracts
	// iv's vtable word (like OP_IFACE_DTOR) and reads
	// slot 1 of it.  Result is `*uint8` (the `*TypeInfo`).
	// A dedicated op — not a raw GEP+LOAD of slot 1 —
	// because the vtable word's REPRESENTATION differs by
	// backend: native holds a real `@__ivt` pointer, but
	// the VM holds a 1-based index into vm.IfaceVtables (a
	// per-vm dispatch table whose indices never leave the
	// vm — plan-uniform-native-fnptrs).  So each backend
	// reads the type identity for its own representation,
	// exactly as OP_IFACE_DTOR / OP_CALL_IFACE_METHOD do.
	// The caller has already null-checked the vtable word
	// (a null vtable short-circuits to a miss first).
	// Backends:
	//   LLVM / native (x64 / aa64 / arm32): extract iv's
	//         vtable word, GEP by 1 word, load — the real
	//         @__ivt slot 1.
	//   VM:  BC_IFACE_TYPEINFO — a vm word resolves via
	//         IfaceVtables[word-1].Methods[1] (the materialized
	//         `__typeinfo.<R>` address); a native-INJECTED word
	//         (ifaceVtIsNative) loud-fails, its cross-mode
	//         mapping deferred to RTTI Slice 5b-2.
	// RTTI Slice 5b of plan-type-assertions-execution.md.

	OP_SAT_LOOKUP // interface-satisfaction query for an interface-target
	// assertion `x.(*J)`: `(dynamic *TypeInfo, &__ifaceid.<J>)
	// -> sub-vtable word | nil`.  Args = [ti, ifaceId]; StrVal
	// carries `pkg/builtins/rt.SatLookup` and result is `*uint8`,
	// so it is structurally a call to rt.SatLookup — the compiled
	// backends lower it EXACTLY as that call (query the native
	// itab-hash rt global).  The distinct opcode is the
	// mode-dispatch point: the VM's bytecode rt.SatLookup would
	// MISS (that hash is only built native-side), so the VM lowers
	// this to BC_SAT_LOOKUP -> lookupSatEntry over its own @VM
	// satentry registry instead.  Backends:
	//   LLVM / native (x64 / aa64 / arm32): fall into the OP_CALL
	//         arm (emitCall reads StrVal + Args) — the call.
	//   VM:  BC_SAT_LOOKUP -> lookupSatEntry(vm, ti, ifaceId).
	// RTTI Slice 5b-2 of plan-type-assertions-execution.md.

	NUM_OPS
)

// OpName returns the human-readable name for an IR opcode.
func OpName(op int) *[]readonly char
