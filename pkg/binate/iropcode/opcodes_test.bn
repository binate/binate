package "pkg/binate/iropcode"

import "pkg/builtins/testing"

// fail returns a non-empty TestResult carrying the failure message.
func fail(msg @[]char) testing.TestResult {
	return msg
}

// seq reports whether two readonly char slices are byte-equal.
func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// TestOpName pins OpName's opcode -> mnemonic mapping for a representative
// spread of opcodes, plus the "unknown" fallback for an out-of-range op.
func TestOpName() testing.TestResult {
	if !seq(OpName(OP_ADD), "add") { return fail("add wrong") }
	if !seq(OpName(OP_RETURN), "return") { return fail("return wrong") }
	if !seq(OpName(OP_CALL), "call") { return fail("call wrong") }
	if !seq(OpName(OP_CALL_INDIRECT), "call_indirect") { return fail("call_indirect wrong") }
	if !seq(OpName(OP_CONST_INT), "const_int") { return fail("const_int wrong") }
	if !seq(OpName(OP_CONST_FLOAT), "const_float") { return fail("const_float wrong") }
	if !seq(OpName(OP_REFINC), "refinc") { return fail("refinc wrong") }
	if !seq(OpName(OP_REFDEC), "refdec") { return fail("refdec wrong") }
	if !seq(OpName(OP_SP_RESTORE), "sp_restore") { return fail("sp_restore wrong") }
	if !seq(OpName(OP_C_CALL), "c_call") { return fail("c_call wrong") }
	if !seq(OpName(OP_C_GLOBAL), "c_global") { return fail("c_global wrong") }
	if !seq(OpName(OP_FUNC_VALUE_DTOR), "func_value_dtor") { return fail("func_value_dtor wrong") }
	if !seq(OpName(OP_UNWIND_RETURN), "unwind_return") { return fail("unwind_return wrong") }
	if !seq(OpName(OP_PARAM), "param") { return fail("param wrong") }
	if !seq(OpName(999), "unknown") { return fail("unknown wrong") }
	return ""
}

// The opcode-enum tail is pinned as a canary: new ops append AFTER
// OP_UNWIND_RETURN (the VM-only cleanup-pad terminator) so its value stays stable,
// with OP_PARAM (the by-ID param-reference placeholder) the current last op before
// NUM_OPS, then OP_COPY (the shared SSA-destruction move) just ahead of it.  This
// catches a careless edit that renumbers OP_UNWIND_RETURN or misplaces a
// newly-appended op.
func TestOpcodeEnumTailPinned() testing.TestResult {
	if OP_UNWIND_RETURN >= NUM_OPS {
		return fail("OP_UNWIND_RETURN must be a valid opcode (< NUM_OPS)")
	}
	if OP_PARAM != NUM_OPS - 1 {
		return fail("OP_PARAM should be the last opcode before NUM_OPS")
	}
	if OP_COPY != OP_PARAM - 1 {
		return fail("OP_COPY should sit just before OP_PARAM")
	}
	if OP_UNWIND_RETURN != OP_COPY - 1 {
		return fail("OP_UNWIND_RETURN should sit just before OP_COPY (its value must stay stable)")
	}
	return ""
}
