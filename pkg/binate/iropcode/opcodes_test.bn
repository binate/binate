package "pkg/binate/iropcode"

import "pkg/builtins/testing"

// fail returns a non-empty TestResult carrying the failure message.
func fail(msg @[]char) testing.TestResult {
	return msg
}

// seq reports whether two readonly char slices are byte-equal.
func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// TestOpName pins OpName's opcode -> mnemonic mapping for a representative
// spread of opcodes, plus the "unknown" fallback for an out-of-range op.
func TestOpName() testing.TestResult {
	if !seq(OpName(OP_ADD), "add") { return fail("add wrong") }
	if !seq(OpName(OP_RETURN), "return") { return fail("return wrong") }
	if !seq(OpName(OP_CALL), "call") { return fail("call wrong") }
	if !seq(OpName(OP_CALL_INDIRECT), "call_indirect") { return fail("call_indirect wrong") }
	if !seq(OpName(OP_CONST_INT), "const_int") { return fail("const_int wrong") }
	if !seq(OpName(OP_REFINC), "refinc") { return fail("refinc wrong") }
	if !seq(OpName(OP_REFDEC), "refdec") { return fail("refdec wrong") }
	if !seq(OpName(OP_SP_RESTORE), "sp_restore") { return fail("sp_restore wrong") }
	if !seq(OpName(OP_C_CALL), "c_call") { return fail("c_call wrong") }
	if !seq(OpName(OP_FUNC_VALUE_DTOR), "func_value_dtor") { return fail("func_value_dtor wrong") }
	if !seq(OpName(999), "unknown") { return fail("unknown wrong") }
	return ""
}
