// Package iropt holds the IR-level optimizer: the opt-pass driver (RunOptPasses)
// and its passes (mem2reg, SROA, inlining, load-forwarding, bounds-check
// elimination, phi elimination), plus the dominator/loop analyses they use.
// It transforms and analyzes the `ir` data model, so it imports `ir` (and, once
// the builder split lands, `irbuild` for construction helpers).
package "pkg/binate/iropt"

import "pkg/binate/ir"

// The switchable optimization passes, in pipeline order (the order
// RunOptConfig runs them in; switching one off removes it from that order and
// never reorders the rest).  Each pass must be correct whichever others run: an
// earlier pass being off may make a later one find less, never make it wrong.
// OptPassName gives each its stable name (bnc/bni's -f<name> / -fno-<name>).
const (
	PASS_INLINE int = iota // within-package function inlining
	PASS_SROA              // scalar replacement of aggregates
	PASS_MEM2REG           // scalar SSA promotion
	PASS_DEAD_PHI          // dead-phi elimination
	PASS_LOAD_FWD          // single-store load forwarding
	PASS_FIELD_LOAD_FWD    // redundant field-load elimination
	PASS_SIMPLIFY          // algebraic identities + dead constants
	PASS_DIV_CHECK_ELIM    // elide provably-safe divide checks
	PASS_BCE_CONST         // constant-index bounds-check elimination
	PASS_BCE_LOOP          // induction-variable bounds-check elimination
	PASS_BCE_REDUNDANT     // dominated-duplicate bounds-check elimination
	PASS_LICM              // loop-invariant code motion
	PASS_FUSE_MADD         // multiply + add/sub fusion into OP_MADD / OP_MSUB
	NUM_OPT_PASSES         // must stay <= 32: OptConfig.Passes is a uint bitmask
)

// DEFAULT_INLINE_THRESHOLD is the inliner's default per-callee size threshold
// (instructions, including the terminator).
const DEFAULT_INLINE_THRESHOLD int = 15

// OptConfig selects which optimization passes run and tunes them.  A value
// type: derive one with LevelOptConfig, adjust it with WithOptPass, and pass it
// to RunOptConfig.  The zero value runs nothing.
type OptConfig struct {
	// Passes has bit p set iff pass p (a PASS_* value) runs.
	Passes uint
	// InlineThreshold is the inliner's per-callee size threshold
	// (bnc's --inline-threshold); only read when PASS_INLINE is on.  It is 0
	// in the zero value (inline almost nothing): a config that enables
	// PASS_INLINE should start from LevelOptConfig, which sets the default.
	InlineThreshold int
}

// LevelOptConfig returns the configuration optimization level `level` implies:
// 0 (or below) runs no pass; every level >= 1 runs every pass.
func LevelOptConfig(level int) OptConfig

// VMOptConfig returns the passes the bytecode VM runs on every module it loads.
// The VM has no ahead-of-time step, so its passes run on every load: a pass is
// in this set only when the run time it saves outweighs the load time it adds,
// and a new pass stays out of it until measured under the VM.
func VMOptConfig() OptConfig

// WithOptPass returns c with pass p switched on (on) or off.
func WithOptPass(c OptConfig, p int, on bool) OptConfig

// OptPassEnabled reports whether c runs pass p.
func OptPassEnabled(c OptConfig, p int) bool

// OptPassName returns pass p's stable name (e.g. "sroa", "bce-loop").
func OptPassName(p int) *[]readonly char

// OptPassByName returns the PASS_* value named `name`, or -1 if none is.
func OptPassByName(name *[]readonly char) int

// RunOptConfig runs the passes c enables, in pipeline order, on the finalized
// module m.  Invoked at every lowering boundary (bnc's compileModuleVia and
// --emit-llvm path; the interpreter's lowering path), so all consumers — the
// LLVM backend, the native backends, and the bytecode VM — share one optimized
// IR.  With no pass enabled it leaves m untouched.
func RunOptConfig(m @ir.Module, c OptConfig)

// RunOptConfigFunc runs the passes c enables other than inlining (the one
// inter-procedural pass), in pipeline order, on the single function f.
// RunOptConfig is inlining followed by this on every function of m.
func RunOptConfigFunc(f @ir.Func, c OptConfig)

// RunOptPasses is RunOptConfig(m, LevelOptConfig(level)).
func RunOptPasses(m @ir.Module, level int)

// EliminatePhis destructs SSA form (removes OP_PHI, inserts OP_COPY moves,
// splits critical edges, sequences parallel copies) for the backends that do not
// lower OP_PHI natively — the bytecode VM and the 3 native backends.  The LLVM
// backend keeps phis and does NOT call this.  v1 handles scalar
// (int/bool/raw-pointer) phis only and panics on an aggregate/managed phi.
// Idempotent on a phi-free function.
func EliminatePhis(f @ir.Func)

// ComputeLoopDepths returns each block's loop-nesting depth (0 = outside every
// loop), indexed by position in f.Blocks — a static execution-frequency proxy
// (each enclosing loop ~multiplies the iteration count) for heuristics such as
// the native register allocator's spill cost.  Built on the CFG's back-edges /
// natural loops; never a correctness input, so an imprecise depth only biases a
// heuristic.
func ComputeLoopDepths(f @ir.Func) @[]int
