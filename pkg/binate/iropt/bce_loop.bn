package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/std/vec"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// Loop bounds-check elimination — remove OP_BOUNDS_CHECK(P, len) for an
// induction-variable access in a counted loop.  It relies on mem2reg making the
// induction variable an SSA loop-header phi and on load-forwarding coalescing a
// slice's length loads, so it runs in RunOptConfig after those.
//
// The check guards `0 <= idx < len` on a SIGNED index; it is eliminable only
// when all three obligations are independently proven for the canonical
// ascending unit-stride loop `for i := 0; i < L; i++ { … a[i] … }`:
//   - idx IS the loop-header phi P;
//   - lower bound P >= 0: the init entry is a const >= 0 and the step is P + 1
//     (monotonic non-decreasing from a non-negative start);
//   - no overflow: unit stride, so P runs to exactly L-1 and the guard stops it;
//   - upper bound P < len: the header's guard is `OP_LT(P, L)` and the check's
//     block is dominated by the guard's true target, and L is provably <= len —
//     reading a constant L at the guard's type, so an unsigned guard's bound is
//     the unsigned value it compares against.
// Every case not matched is KEPT (still faults when the program should).

// bceLoopFunc removes the eliminable induction-variable bounds checks in f.
func bceLoopFunc(f @ir.Func) {
	if len(f.Blocks) == 0 {
		return
	}
	var d @DomInfo = ComputeDom(f)
	for bi := 0; bi < len(f.Blocks); bi++ {
		bceLoopBlock(f, d, bi)
	}
}

// bceLoopBlock drops the eliminable OP_BOUNDS_CHECKs from one block (the
// bceBlock rebuild pattern: only reassign blk.Instrs when something is
// removable; dropped checks stay owned by InstrsVec).
func bceLoopBlock(f @ir.Func, d @DomInfo, bi int) {
	var blk @ir.Block = f.Blocks[bi]
	var anyRemovable bool = false
	for ii := 0; ii < len(blk.Instrs); ii++ {
		var instr @ir.Instr = blk.Instrs[ii]
		if instr.Op == iropcode.OP_BOUNDS_CHECK && loopBCEEliminable(f, d, bi, instr) {
			anyRemovable = true
		}
	}
	if !anyRemovable {
		return
	}
	var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	for ii := 0; ii < len(blk.Instrs); ii++ {
		var instr @ir.Instr = blk.Instrs[ii]
		if instr.Op == iropcode.OP_BOUNDS_CHECK && loopBCEEliminable(f, d, bi, instr) {
			continue
		}
		kept.Push(instr)
	}
	blk.Instrs = kept.Items()
}

// loopBCEEliminable reports whether the bounds check in block `checkBi` proves
// all three obligations for its index and length.  Pure (no mutation).
func loopBCEEliminable(f @ir.Func, d @DomInfo, checkBi int, check @ir.Instr) bool {
	if len(check.Args) < 2 {
		return false
	}
	var idx @ir.Instr = check.Args[0]
	var lenv @ir.Instr = check.Args[1]

	// idx must be a 2-entry loop-header phi P.
	if idx == nil || idx.Op != iropcode.OP_PHI || len(idx.Phis) != 2 {
		return false
	}
	var pBlk int = instrBlockIndex(f, idx)
	if pBlk < 0 {
		return false
	}

	// Classify the phi entries: the latch (back-edge) block is dominated by P's
	// block H; the init (preheader) block is not.  Exactly one of each.
	var e0 int = irbuild.BlockIndexIn(f, idx.Phis[0].Block)
	var e1 int = irbuild.BlockIndexIn(f, idx.Phis[1].Block)
	if e0 < 0 || e1 < 0 {
		return false
	}
	var dom0 bool = d.Dominates(pBlk, e0)
	var dom1 bool = d.Dominates(pBlk, e1)
	var initVal *ir.Instr
	var stepVal *ir.Instr
	if dom1 && !dom0 {
		initVal = idx.Phis[0].Val
		stepVal = idx.Phis[1].Val
	} else if dom0 && !dom1 {
		initVal = idx.Phis[1].Val
		stepVal = idx.Phis[0].Val
	} else {
		return false // not a simple reducible counted loop
	}

	// Lower bound: init is a constant >= 0.
	if initVal == nil || initVal.Op != iropcode.OP_CONST_INT || initVal.IntVal < 0 {
		return false
	}
	// No overflow: unit stride, step = P + 1 (either operand order).
	if !isUnitStep(stepVal, idx) {
		return false
	}

	// Upper bound: P's block ends with OP_BRANCH(cond, T, F), cond = OP_LT(P, L),
	// and the check's block is dominated by the true target T.
	var term @ir.Instr = terminatorOf(f.Blocks[pBlk])
	if term == nil || term.Op != iropcode.OP_BRANCH || len(term.Args) < 1 {
		return false
	}
	var cond @ir.Instr = term.Args[0]
	if cond == nil || cond.Op != iropcode.OP_LT || len(cond.Args) < 2 || cond.Args[0] != idx {
		return false
	}
	var l @ir.Instr = cond.Args[1]
	var tBlk int = irbuild.BlockIndexIn(f, term.Block1) // true target
	if tBlk < 0 || !d.Dominates(tBlk, checkBi) {
		return false
	}
	// T dominating the check proves P < L there only when every path to the check
	// leaves the header by the guard's true edge on its last trip through it: T
	// must be entered from the header alone (in particular T is not the header
	// itself, the guard's true arm being the back edge, which leaves the loop with
	// P >= L), and the guard must be the loop's exit test, its false arm F leaving
	// the loop.  Otherwise the loop goes on through F, P keeps stepping past L and
	// wraps negative, and P < L holds again for an index out of bounds.
	var fBlk int = irbuild.BlockIndexIn(f, term.Block2)
	if fBlk < 0 || fBlk == tBlk || len(d.Preds[tBlk]) != 1 || d.Preds[tBlk][0] != pBlk {
		return false
	}

	// L provably <= len, so P < L <= len.  (Checked before the natural-loop walk,
	// which costs a pass over the loop.)
	if !lengthProvablyLE(l, lenv, idx.Typ) {
		return false
	}
	return !naturalLoopBody(d, pBlk, d.NumBlocks)[fBlk]
}

// isUnitStep reports whether step is `p + 1` (either operand order).
func isUnitStep(step *ir.Instr, p @ir.Instr) bool {
	if step == nil || step.Op != iropcode.OP_ADD || len(step.Args) < 2 {
		return false
	}
	if step.Args[0] == p && isConstOne(step.Args[1]) {
		return true
	}
	if step.Args[1] == p && isConstOne(step.Args[0]) {
		return true
	}
	return false
}

// isConstOne reports whether v is the integer constant 1.
func isConstOne(v @ir.Instr) bool {
	return v != nil && v.Op == iropcode.OP_CONST_INT && v.IntVal == 1
}

// lengthProvablyLE reports whether the guard bound `l` is provably <= the
// bounds-check length `lenv` — the crux of soundness (rejecting `i < n` where n
// is not the collection length).  Sound cases: the same SSA value; two integer
// constants with l <= lenv (an array length, or a literal bound <= the array
// length), l read at the guard's type `cmpTyp` (guardBoundValue); or the same
// slice length — a slice's `len` is `OP_EXTRACT(slice, 1)` (field 1 of the
// header), so both being that extract of the SSA-identical slice value
// (coalesced by load-forwarding) means l == len, hence l <= len.
func lengthProvablyLE(l @ir.Instr, lenv @ir.Instr, cmpTyp @types.Type) bool {
	if l == nil || lenv == nil {
		return false
	}
	if l == lenv {
		return true
	}
	if l.Op == iropcode.OP_CONST_INT && lenv.Op == iropcode.OP_CONST_INT {
		var bound int64
		var ok bool
		bound, ok = guardBoundValue(l, cmpTyp)
		return ok && bound <= lenv.IntVal
	}
	// Same slice's length: EmitSliceLen(s) == OP_EXTRACT(s, 1).
	if l.Op == iropcode.OP_EXTRACT && lenv.Op == iropcode.OP_EXTRACT && l.Index == 1 &&
			lenv.Index == 1 && len(l.Args) >= 1 && len(lenv.Args) >= 1 && l.Args[0] == lenv.Args[0] {
		return true
	}
	return false
}

// guardBoundValue returns the value the guard `P < l` compares against: l's
// IntVal for a signed guard, and for an unsigned one the same IntVal when it is
// the canonical (zero-extended, non-negative) form of an unsigned value of the
// guard's width.  ok is false otherwise — in particular for a 64-bit unsigned
// bound of 2^63 or more, whose IntVal is negative: read signed, it would pass as
// <= any length, and the check would go while the guard lets P run past the end.
// A non-canonical narrow constant is rejected rather than masked to the width,
// since a backend may compare against its raw IntVal.
func guardBoundValue(l @ir.Instr, cmpTyp @types.Type) (int64, bool) {
	var t @types.Type = types.StripWrappers(cmpTyp)
	if t == nil || t.Kind != types.TYP_INT || t.Signed {
		return l.IntVal, true
	}
	if l.IntVal < cast(int64, 0) || t.Width <= 0 {
		return 0, false
	}
	if t.Width < 64 && l.IntVal >= (cast(int64, 1) << cast(int64, t.Width)) {
		return 0, false
	}
	return l.IntVal, true
}

// instrBlockIndex returns the index of the block containing instr, or -1.
func instrBlockIndex(f @ir.Func, instr @ir.Instr) int {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			if blk.Instrs[ii] == instr {
				return bi
			}
		}
	}
	return -1
}
