package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for loop bounds-check elimination (bce_loop.bn).  Each builds the
// post-mem2reg / post-load-forwarding shape of `for i:=0; i<L; i++ { …check… }`
// by hand: pre -> header(phi + guard) -> body(bounds_check) -> post(step) ->
// header, exit.  twoPhiEntries wires the phi's init + latch entries.

// twoPhiEntries builds a 2-entry phi entry list.
func twoPhiEntries(b0 @ir.Block, v0 @ir.Instr, b1 @ir.Block, v1 @ir.Instr) @[]ir.PhiEntry {
	var e0 ir.PhiEntry
	e0.Block = b0
	e0.Val = v0
	var e1 ir.PhiEntry
	e1.Block = b1
	e1.Val = v1
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0] = e0
	es[1] = e1
	return es
}

// loopBodyChecks builds the canonical counted loop with the given init value,
// step constant, guard bound L, and bounds-check length, and returns the body
// block (which holds the OP_BOUNDS_CHECK) after running loop-BCE.  The four
// operand instrs are emitted in the blocks where they must live.
func buildAndRunLoop(initConst int, stepConst int, lIsSameAsLen bool, lConst int,
		lenConst int) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = pre.EmitConstInt(initConst, types.TypInt())
	pre.EmitJump(header)

	// Placeholder phi; real entries wired after the step exists.
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = header.EmitConstInt(lConst, types.TypInt())
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, phi, l, types.TypBool())
	header.EmitBranch(cond, body, exit)

	var lenV @ir.Instr = l
	if !lIsSameAsLen {
		lenV = body.EmitConstInt(lenConst, types.TypInt())
	}
	body.EmitBoundsCheck(phi, lenV)
	body.EmitJump(post)

	var stepC @ir.Instr = post.EmitConstInt(stepConst, types.TypInt())
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, stepC, types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)

	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)
	return f
}

// The canonical `for i:=0; i<N; i++` over an array (guard bound == check length,
// unit stride, init 0) — the bounds check is eliminated.
func TestLoopBCEEliminatesCanonical() testing.TestResult {
	var f @ir.Func = buildAndRunLoop(0, 1, true, 10, 10)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("canonical loop: the induction bounds check should be eliminated")
	}
	return ""
}

// A guard bound strictly less than the length still eliminates (P < L <= len).
func TestLoopBCEEliminatesGuardLtLen() testing.TestResult {
	var f @ir.Func = buildAndRunLoop(0, 1, false, 3, 5) // i < 3, array [5] -> safe
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("i<3 on [5] should eliminate (3 <= 5)")
	}
	return ""
}

// A guard bound GREATER than the length must be KEPT (P could reach len..L-1).
func TestLoopBCEKeepsGuardGtLen() testing.TestResult {
	var f @ir.Func = buildAndRunLoop(0, 1, false, 10, 5) // i < 10, array [5] -> unsafe
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("i<10 on [5] must KEEP the check (10 > 5)")
	}
	return ""
}

// A negative init must be KEPT (the guard says nothing about sign).
func TestLoopBCEKeepsNegativeInit() testing.TestResult {
	var f @ir.Func = buildAndRunLoop(-1, 1, true, 10, 10)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("negative init must KEEP the check")
	}
	return ""
}

// A non-unit stride must be KEPT (overflow / stepping past L not proven).
func TestLoopBCEKeepsNonUnitStride() testing.TestResult {
	var f @ir.Func = buildAndRunLoop(0, 2, true, 10, 10)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("non-unit stride must KEEP the check")
	}
	return ""
}

// A guard bound that is an opaque (non-const, non-slice-len) value must be KEPT
// — this is the `for i:=0;i<n;i++{ a[i] }` case where n is not the length.
func TestLoopBCEKeepsOpaqueBound() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	// Opaque bound: an ADD of two consts (Op is OP_ADD, not OP_CONST_INT).
	var n @ir.Instr = header.EmitBinop(iropcode.OP_ADD, header.EmitConstInt(5, types.TypInt()),
			header.EmitConstInt(5, types.TypInt()), types.TypInt())
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, phi, n, types.TypBool())
	header.EmitBranch(cond, body, exit)
	body.EmitBoundsCheck(phi, body.EmitConstInt(10, types.TypInt()))
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("opaque guard bound (i<n, n not the length) must KEEP the check")
	}
	return ""
}

// A non-induction index (a plain constant, not the phi) is not a loop-BCE
// candidate — KEPT here (constant-index BCE handles it separately).
func TestLoopBCEKeepsNonPhiIndex() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var idx @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var lenV @ir.Instr = entry.EmitConstInt(3, types.TypInt())
	entry.EmitBoundsCheck(idx, lenV)
	entry.EmitReturn(oneRet(entry.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("loop-BCE must not touch a non-phi (constant) index")
	}
	return ""
}

// The slice case: guard and check lengths are OP_SLICE_LEN of the SAME slice
// value (as load-forwarding produces) — eliminated.
func TestLoopBCEEliminatesSliceSameLen() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var st @types.Type = types.MakeSliceType(types.TypInt())

	var s @ir.Instr = pre.EmitConstNil(st) // the (loop-invariant) slice value
	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var lLen @ir.Instr = header.EmitSliceLen(s) // len(s) in the guard
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, phi, lLen, types.TypBool())
	header.EmitBranch(cond, body, exit)
	var checkLen @ir.Instr = body.EmitSliceLen(s) // len(s) for the access — SAME s
	body.EmitBoundsCheck(phi, checkLen)
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("slice loop with len(s) on one value should eliminate the check")
	}
	return ""
}

// Two DIFFERENT slice values (guard len(a), check len(b)) must be KEPT — b could
// be shorter than a.
func TestLoopBCEKeepsDifferentSlices() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var st @types.Type = types.MakeSliceType(types.TypInt())

	var a @ir.Instr = pre.EmitConstNil(st)
	var bslice @ir.Instr = pre.EmitConstNil(st) // a DIFFERENT slice value
	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, phi, header.EmitSliceLen(a), types.TypBool())
	header.EmitBranch(cond, body, exit)
	body.EmitBoundsCheck(phi, body.EmitSliceLen(bslice)) // len(b), not len(a)
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("guard len(a), check len(b) on different slices must KEEP the check")
	}
	return ""
}

// The phi's entries wired latch-first (step entry at index 0, init at index 1)
// must classify identically — exercises the dom0 && !dom1 branch.
func TestLoopBCEEliminatesSwappedPhiOrder() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = header.EmitConstInt(10, types.TypInt())
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, phi, l, types.TypBool())
	header.EmitBranch(cond, body, exit)
	body.EmitBoundsCheck(phi, l)
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	// Latch entry FIRST, init entry SECOND (swapped vs the canonical builder).
	phi.Phis = twoPhiEntries(post, step, pre, initV)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("swapped phi order: should still classify and eliminate")
	}
	return ""
}

// A `<=` guard (OP_LE) must be KEPT — `i <= len` would access index len.
func TestLoopBCEKeepsLeGuard() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = header.EmitConstInt(10, types.TypInt())
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LE, phi, l, types.TypBool()) // <= not <
	header.EmitBranch(cond, body, exit)
	body.EmitBoundsCheck(phi, l)
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("a <= guard must KEEP the check (would access index len)")
	}
	return ""
}

// The phi on the RIGHT of the comparison (OP_LT(L, P), i.e. `L < i`) must be
// KEPT — the pass matches only OP_LT(P, L) with P as Args[0].
func TestLoopBCEKeepsPhiOnRight() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = pre.EmitConstInt(0, types.TypInt())
	pre.EmitJump(header)
	var phi @ir.Instr = header.EmitPhi(types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = header.EmitConstInt(10, types.TypInt())
	var cond @ir.Instr = header.EmitBinop(iropcode.OP_LT, l, phi, types.TypBool()) // L < P
	header.EmitBranch(cond, body, exit)
	body.EmitBoundsCheck(phi, l)
	body.EmitJump(post)
	var step @ir.Instr = post.EmitBinop(iropcode.OP_ADD, phi, post.EmitConstInt(1, types.TypInt()),
			types.TypInt())
	post.EmitJump(header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	exit.EmitReturn(oneRet(exit.EmitConstInt(0, types.TypInt())))

	bceLoopFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("OP_LT(L, P) (phi on the right) must KEEP the check")
	}
	return ""
}
