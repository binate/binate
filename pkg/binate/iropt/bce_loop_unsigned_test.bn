package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Loop BCE (bce_loop.bn) on an unsigned induction variable: the guard `P < L`
// compares unsigned, so a constant bound is read at the guard's type.

// buildTypedLoop builds the canonical counted loop `for P := 0; P < bound; P++ {
// check(P, length) }` with P (and its constant bound) of type t, runs loop-BCE,
// and returns the function.  bound is the constant's IntVal — a 64-bit unsigned
// bound of 2^63 or more is stored negative, as IR-gen stores it.
func buildTypedLoop(t @types.Type, bound int64, length int) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var initV @ir.Instr = irbuild.EmitConstInt64(pre, 0, t)
	irbuild.EmitJump(pre, header)
	var phi @ir.Instr = irbuild.EmitPhi(header, t, twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = irbuild.EmitConstInt64(header, bound, t)
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, phi, l, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	irbuild.EmitBoundsCheck(body, phi, irbuild.EmitConstInt(body, length, types.TypInt()))
	irbuild.EmitJump(body, post)
	var step @ir.Instr = irbuild.EmitBinop(post, iropcode.OP_ADD, phi,
			irbuild.EmitConstInt64(post, 1, t), t)
	irbuild.EmitJump(post, header)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	irbuild.EmitReturn(exit, oneRet(irbuild.EmitConstInt(exit, 0, types.TypInt())))

	bceLoopFunc(f)
	return f
}

// A uint64 bound of 2^64 - 1 (IntVal -1) is past every length: the check stays.
// Read signed it would be -1 <= 3, and the loop would run past the array.
func TestLoopBCEKeepsUnsignedHugeBound() testing.TestResult {
	var f @ir.Func = buildTypedLoop(types.TypUint64(), cast(int64, -1), 3)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("u < 2^64-1 on [3] must KEEP the check")
	}
	f = buildTypedLoop(types.TypUint64(), cast(int64, -9223372036854775807) - cast(int64, 1), 3)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("u < 2^63 on [3] must KEEP the check")
	}
	return ""
}

// A narrow unsigned bound that is not the canonical (zero-extended) form of a
// value of its width — a uint8 IntVal of -1, or of 256 — keeps the check: what a
// backend compares against is then not certain, so nothing is proven.
func TestLoopBCEKeepsUnsignedNonCanonicalBound() testing.TestResult {
	var f @ir.Func = buildTypedLoop(types.TypUint8(), cast(int64, -1), 3)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("a uint8 bound with IntVal -1 on [3] must KEEP the check")
	}
	f = buildTypedLoop(types.TypUint8(), cast(int64, 256), 300)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("a uint8 bound with IntVal 256 on [300] must KEEP the check")
	}
	return ""
}

// An unsigned guard whose bound is within the length still eliminates.
func TestLoopBCEEliminatesUnsignedSmallBound() testing.TestResult {
	var f @ir.Func = buildTypedLoop(types.TypUint64(), cast(int64, 3), 3)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("u < 3 on [3] should eliminate the check")
	}
	f = buildTypedLoop(types.TypUint8(), cast(int64, 2), 5)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("a uint8 u < 2 on [5] should eliminate the check")
	}
	return ""
}
