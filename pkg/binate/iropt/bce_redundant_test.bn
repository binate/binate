package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for redundant bounds-check elimination (bce_redundant.bn): a check is
// dropped when a DOMINATING check with the same (idx, len) values already proved
// it.  Operand equality is value-based (bceSameValue), so distinct SSA instrs
// that name the same integer constant or the same field of the same SSA
// aggregate still match — the shape load-forwarding leaves behind for `seed[0]`
// accessed repeatedly (each access mints its own const-0 index and its own
// OP_EXTRACT(slice, 1) length off the one coalesced slice value).

// intSliceValue emits a loop-invariant slice value for length extraction.
func intSliceValue(b @ir.Block) @ir.Instr {
	return irbuild.EmitConstNil(b, types.MakeSliceType(types.TypInt()))
}

// The fasta genRandom shape: one block, three checks of index 0 against the same
// slice's length, each with its OWN const-0 and its OWN EmitSliceLen — two are
// redundant, one survives.
func TestRedundantBCESeed0ThreeAccesses() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	var s @ir.Instr = intSliceValue(b)
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("seed[0] x3 (same slice len) should collapse to one check")
	}
	return ""
}

// Two checks with equal-VALUED but distinct const index and const length instrs
// collapse to one (value equality, not SSA identity).
func TestRedundantBCEEqualConstOperands() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 2, types.TypInt()),
			irbuild.EmitConstInt(b, 10, types.TypInt()))
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 2, types.TypInt()),
			irbuild.EmitConstInt(b, 10, types.TypInt()))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("two checks with equal const operands should collapse to one")
	}
	return ""
}

// The same SSA index value (pointer-identical) reused across two checks of one
// slice's length collapses to one.
func TestRedundantBCESameSSAIndex() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	var s @ir.Instr = intSliceValue(b)
	var k @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, irbuild.EmitConstInt(b, 3, types.TypInt()),
			irbuild.EmitConstInt(b, 4, types.TypInt()), types.TypInt())
	irbuild.EmitBoundsCheck(b, k, irbuild.EmitSliceLen(b, s))
	irbuild.EmitBoundsCheck(b, k, irbuild.EmitSliceLen(b, s))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("two checks of the same SSA index + same slice len should collapse")
	}
	return ""
}

// A dominating check in a predecessor block removes the dominated check in a
// successor (linear chain: entry -> mid -> exit, entry dominates mid).
func TestRedundantBCEDominatingBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mid @ir.Block = ir.AddBlock(f, "mid")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var s @ir.Instr = intSliceValue(entry)
	irbuild.EmitBoundsCheck(entry, irbuild.EmitConstInt(entry, 0, types.TypInt()),
			irbuild.EmitSliceLen(entry, s))
	irbuild.EmitJump(entry, mid)
	irbuild.EmitBoundsCheck(mid, irbuild.EmitConstInt(mid, 0, types.TypInt()),
			irbuild.EmitSliceLen(mid, s))
	irbuild.EmitJump(mid, exit)
	irbuild.EmitReturn(exit, oneRet(irbuild.EmitConstInt(exit, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("check dominated by an equivalent predecessor check should be removed")
	}
	return ""
}

// Two checks in incomparable sibling blocks (neither dominates the other) are
// BOTH kept — each path needs its own check.
func TestRedundantBCESiblingBlocksKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var left @ir.Block = ir.AddBlock(f, "left")
	var right @ir.Block = ir.AddBlock(f, "right")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var s @ir.Instr = intSliceValue(entry)
	var cond @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT,
			irbuild.EmitConstInt(entry, 0, types.TypInt()), irbuild.EmitConstInt(entry, 1, types.TypInt()),
			types.TypBool())
	irbuild.EmitBranch(entry, cond, left, right)
	irbuild.EmitBoundsCheck(left, irbuild.EmitConstInt(left, 0, types.TypInt()),
			irbuild.EmitSliceLen(left, s))
	irbuild.EmitJump(left, exit)
	irbuild.EmitBoundsCheck(right, irbuild.EmitConstInt(right, 0, types.TypInt()),
			irbuild.EmitSliceLen(right, s))
	irbuild.EmitJump(right, exit)
	irbuild.EmitReturn(exit, oneRet(irbuild.EmitConstInt(exit, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 2 {
		return fail("checks in incomparable sibling blocks must both be kept")
	}
	return ""
}

// Different length values (two DIFFERENT slices) must be kept — one slice's
// extent says nothing about the other's.
func TestRedundantBCEDifferentLengthKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	var s1 @ir.Instr = intSliceValue(b)
	var s2 @ir.Instr = intSliceValue(b)
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s1))
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s2))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 2 {
		return fail("checks against two different slices' lengths must both be kept")
	}
	return ""
}

// Different index values must be kept.
func TestRedundantBCEDifferentIndexKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	var s @ir.Instr = intSliceValue(b)
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 1, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 2 {
		return fail("checks of different indices must both be kept")
	}
	return ""
}

// A single check is untouched (nothing dominates it).
func TestRedundantBCESingleCheckKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "b")
	var s @ir.Instr = intSliceValue(b)
	irbuild.EmitBoundsCheck(b, irbuild.EmitConstInt(b, 0, types.TypInt()), irbuild.EmitSliceLen(b, s))
	irbuild.EmitReturn(b, oneRet(irbuild.EmitConstInt(b, 0, types.TypInt())))

	bceRedundantFunc(f)

	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 1 {
		return fail("a lone check must be kept")
	}
	return ""
}
