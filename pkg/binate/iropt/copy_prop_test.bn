package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for copy propagation between stack slots (copy_prop.bn).

// copyFunc builds `x = mk(); y = x; return y[1]` in one block, with arr's slots x
// and y, and returns the function, its block, x, y and the element address the
// return reads (based on y).
func copyFunc(arr @types.Type) (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr, @ir.Instr) {
	var it @types.Type = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, x, irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), arr))
	var y @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, y, irbuild.EmitLoad(e, x, arr))
	var ep @ir.Instr = irbuild.EmitGetElemPtr(e, y, irbuild.EmitConstInt(e, 1, it), it)
	return f, e, x, y, ep
}

// finishCopyFunc ends copyFunc's block by returning the element ep reads.
func finishCopyFunc(e @ir.Block, ep @ir.Instr) {
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(e, ep, types.TypInt())
	irbuild.EmitReturn(e, rets)
}

// `var y = x` with x untouched afterwards: y becomes x — the copy and y's slot go,
// and y's element address is x's.
func TestCopyPropFolds() testing.TestResult {
	f, e, x, _, ep := copyFunc(types.MakeArrayType(types.TypInt(), 4))
	finishCopyFunc(e, ep)
	if !propagateFuncSlotCopies(f) { return fail("the copy should fold") }
	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_STORE) != 1 {
		return fail("y's slot and the copy into it go")
	}
	if ep.Args[0] != x { return fail("y's element address is x's") }
	if len(e.InstrsVec.Items()) != len(e.Instrs) { return fail("InstrsVec stays in step with Instrs") }
	return ""
}

// A chain folds to its head: `var y = x; var z = y; return z[2]` reads x.  (A source
// read after its copy keeps the copy: TestCopyPropKeeps.)
func TestCopyPropChain() testing.TestResult {
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 4)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, x, irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), arr))
	var y @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, y, irbuild.EmitLoad(e, x, arr))
	var z @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, z, irbuild.EmitLoad(e, y, arr))
	var zp @ir.Instr = irbuild.EmitGetElemPtr(e, z, irbuild.EmitConstInt(e, 2, it), it)
	finishCopyFunc(e, zp)
	propagateFuncSlotCopies(f)
	if zp.Args[0] != x { return fail("z folds into y, and y into x") }
	if countOp(f, iropcode.OP_ALLOC) != 1 { return fail("y's and z's slots go") }
	return ""
}

// x read after the copy, x touched in a block the copy's block reaches, y used
// before the copy, x's address passed on, and a slot named in a fault pad all keep
// the copy.
func TestCopyPropKeeps() testing.TestResult {
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 4)
	f1, e1, x1, _, ep1 := copyFunc(arr)
	irbuild.EmitLoad(e1, x1, arr)
	finishCopyFunc(e1, ep1)
	if propagateFuncSlotCopies(f1) { return fail("x is read after the copy") }
	f2, e2, x2, _, ep2 := copyFunc(arr)
	var next @ir.Block = ir.AddBlock(f2, "next")
	irbuild.EmitJump(e2, next)
	irbuild.EmitStore(next, x2, irbuild.EmitCall(next, "mk", make_slice(@ir.Instr, 0), arr))
	finishCopyFunc(next, ep2)
	if propagateFuncSlotCopies(f2) { return fail("x is written in a block the copy reaches") }
	f3, e3, _, y3, ep3 := copyFunc(arr)
	var g @ir.Func = ir.NewFunc("", "g", noParams, noResults)
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gx @ir.Instr = irbuild.EmitAlloc(ge, arr)
	irbuild.EmitStore(ge, gx, irbuild.EmitCall(ge, "mk", make_slice(@ir.Instr, 0), arr))
	var gy @ir.Instr = irbuild.EmitAlloc(ge, arr)
	irbuild.EmitLoad(ge, irbuild.EmitGetElemPtr(ge, gy, irbuild.EmitConstInt(ge, 0, it), it), it)
	irbuild.EmitStore(ge, gy, irbuild.EmitLoad(ge, gx, arr))
	irbuild.EmitReturn(ge, make_slice(@ir.Instr, 0))
	if propagateFuncSlotCopies(g) { return fail("y is read before the copy writes it") }
	finishCopyFunc(e3, ep3)
	if y3 == nil || !propagateFuncSlotCopies(f3) { return fail("the plain copy still folds") }
	f4, e4, x4, _, ep4 := copyFunc(arr)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = x4
	irbuild.EmitCall(e4, "keep", args, types.TypVoid())
	finishCopyFunc(e4, ep4)
	if propagateFuncSlotCopies(f4) { return fail("x's address passed to a call escapes") }
	f5, e5, x5, _, ep5 := copyFunc(arr)
	var pad @ir.Block = ir.AddFaultPad(f5, "pad")
	irbuild.EmitLoad(pad, x5, arr)
	finishCopyFunc(e5, ep5)
	if propagateFuncSlotCopies(f5) { return fail("x is named in a fault pad") }
	return ""
}

// A type holding a managed reference keeps its copy: the copy acquires references
// x and y release separately.
func TestCopyPropKeepsManaged() testing.TestResult {
	var arr @types.Type = types.MakeArrayType(types.MakeManagedSliceType(types.TypChar()), 2)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(e, arr)
	var y @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, y, irbuild.EmitLoad(e, x, arr))
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	if propagateFuncSlotCopies(f) { return fail("a managed copy stays") }
	return ""
}

// loopCopyFunc builds `entry: [x = mk()]; loop: [x = mk()]; y = x; y[0] = 1;
// branch loop / exit` — x's slot and its initialization in the entry block
// (inBody false) or at the top of the loop body (inBody true) — and returns the
// function and y's element address.
func loopCopyFunc(inBody bool) (@ir.Func, @ir.Instr) {
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 4)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var body @ir.Block = ir.AddBlock(f, "loop")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var home @ir.Block = e
	if inBody { home = body }
	var x @ir.Instr = irbuild.EmitAlloc(home, arr)
	irbuild.EmitStore(home, x, irbuild.EmitCall(home, "mk", make_slice(@ir.Instr, 0), arr))
	irbuild.EmitJump(e, body)
	var y @ir.Instr = irbuild.EmitAlloc(body, arr)
	irbuild.EmitStore(body, y, irbuild.EmitLoad(body, x, arr))
	var ep @ir.Instr = irbuild.EmitGetElemPtr(body, y, irbuild.EmitConstInt(body, 0, it), it)
	irbuild.EmitStore(body, ep, irbuild.EmitConstInt(body, 1, it))
	irbuild.EmitBranch(body, irbuild.EmitConstBool(body, true), body, exit)
	irbuild.EmitReturn(exit, make_slice(@ir.Instr, 0))
	return f, ep
}

// A copy in a loop body whose source lives outside the loop keeps its copy: the
// writes through y of one iteration would otherwise reach the next iteration's
// copy.  With x allocated in the body, each iteration re-creates x, and the copy
// folds.
func TestCopyPropLoop() testing.TestResult {
	f, _ := loopCopyFunc(false)
	if propagateFuncSlotCopies(f) { return fail("x outside the loop keeps the copy") }
	g, gep := loopCopyFunc(true)
	if !propagateFuncSlotCopies(g) { return fail("x re-created in the loop body lets the copy fold") }
	if gep.Args[0].Op != iropcode.OP_ALLOC || countOp(g, iropcode.OP_ALLOC) != 1 {
		return fail("y is x after the fold")
	}
	return ""
}

// Two copies with no slot in common fold in one round: both destinations become
// their sources, and each copy's store goes with its load.
func TestCopyPropTwoInOneRound() testing.TestResult {
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 4)
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var x1 @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, x1, irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), arr))
	var x2 @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, x2, irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), arr))
	var y1 @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, y1, irbuild.EmitLoad(e, x1, arr))
	var y2 @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, y2, irbuild.EmitLoad(e, x2, arr))
	var p1 @ir.Instr = irbuild.EmitGetElemPtr(e, y1, irbuild.EmitConstInt(e, 1, it), it)
	var p2 @ir.Instr = irbuild.EmitGetElemPtr(e, y2, irbuild.EmitConstInt(e, 2, it), it)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitBinop(e, iropcode.OP_ADD, irbuild.EmitLoad(e, p1, it),
			irbuild.EmitLoad(e, p2, it), it)
	irbuild.EmitReturn(e, rets)
	var d @DomInfo = ComputeDom(f)
	if findSlotCopies(f, d).Len() != 2 { return fail("both copies are found in one round") }
	if !propagateFuncSlotCopies(f) { return fail("the copies should fold") }
	if p1.Args[0] != x1 || p2.Args[0] != x2 { return fail("each destination becomes its own source") }
	if countOp(f, iropcode.OP_ALLOC) != 2 || countOp(f, iropcode.OP_STORE) != 2 {
		return fail("both copies' slots and stores go; the call results' stores stay")
	}
	return ""
}
