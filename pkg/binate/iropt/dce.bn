package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"

import "pkg/binate/iropcode"

// Dead-value elimination.
//
// Removing a store (dead-slot, dead-store) or a check (div-check-elim, the BCE
// passes) can leave the computation that fed it with no use: an extract, an
// address, an arithmetic chain, a dividend widened only for its divide check,
// or a loop phi that now feeds only itself (`acc = acc + i*3` kept for a field
// nothing reads).
// The LLVM backend's optimizer deletes such values; the native backends and the
// VM would compute them.  This pass marks live every instruction that does
// something besides producing a value — and everything such an instruction
// uses, transitively — and removes the rest.
//
// Only an op in the removable set (deadValueRemovable) can be removed: one
// that, besides producing its value, writes nothing and frees nothing.  That
// includes a load: a read of a bad (nil or dangling) pointer is not a defined
// panic, so an unused one need not happen — as the LLVM backend's optimizer
// already lets it not.  Checks, calls, stores, refcount operations and every
// instruction of a fault pad stay.  The pass keeps
// blk.InstrsVec in step with a rebuilt block.  Liveness is indexed by
// instruction ID, so it relies on IDs being unique across f's blocks and fault
// pads, as they are while the optimizer runs.

// deadValueRemovable reports whether an instruction of op may be removed when
// nothing uses its value.
func deadValueRemovable(op int) bool {
	if op == iropcode.OP_LOAD || op == iropcode.OP_EXTRACT || op == iropcode.OP_GET_FIELD_PTR ||
			op == iropcode.OP_GET_ELEM_PTR || op == iropcode.OP_DATA_SYM_ADDR ||
			op == iropcode.OP_MANAGED_TO_RAW || op == iropcode.OP_PHI {
		return true
	}
	if op == iropcode.OP_CONST_INT || op == iropcode.OP_CONST_FLOAT || op == iropcode.OP_CONST_BOOL ||
			op == iropcode.OP_CONST_NIL || op == iropcode.OP_CONST_STRING {
		return true
	}
	// Register arithmetic (a division's divide-by-zero check is a separate
	// OP_DIV_CHECK, which stays), and the boolean OP_LAND / OP_LOR of two values
	// already computed (short-circuiting is branches, not these ops).
	return isRegisterArith(op) || op == iropcode.OP_LAND || op == iropcode.OP_LOR
}

// eliminateFuncDeadValues removes f's removable instructions whose values no
// kept instruction uses, returning whether it removed any.
func eliminateFuncDeadValues(f @ir.Func) bool {
	var n int = f.NextID
	if n <= 0 { return false }
	var live @[]bool = make_slice(bool, n)
	var work @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	markDeadValueRoots(f.Blocks, false, live, work, n)
	markDeadValueRoots(f.FaultPads, true, live, work, n)
	for work.Len() > 0 {
		var ins @ir.Instr
		var ok bool
		ins, ok = work.Pop()
		if !ok { break }
		for k := 0; k < len(ins.Args); k++ { markValueLive(ins.Args[k], live, work, n) }
		for k := 0; k < len(ins.Phis); k++ { markValueLive(ir.PhiVal(ins.Phis[k]), live, work, n) }
	}
	var removed bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		var hit bool = false
		for ii := 0; ii < len(b.Instrs); ii++ {
			if isDeadValue(b.Instrs[ii], live, n) { hit = true }
		}
		if !hit { continue }
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(b.Instrs); ii++ {
			if !isDeadValue(b.Instrs[ii], live, n) { kept.Push(b.Instrs[ii]) }
		}
		b.InstrsVec = kept
		b.Instrs = kept.Items()
		removed = true
	}
	return removed
}

// markDeadValueRoots queues every instruction of blocks that must stay — a
// non-removable op, or anything in a fault pad (isPad) — marking it live.
func markDeadValueRoots(blocks @[]@ir.Block, isPad bool, live @[]bool, work @vec.Vec[@ir.Instr],
		n int) {
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if !isPad && deadValueRemovable(ins.Op) { continue }
			if ins.ID >= 0 && ins.ID < n {
				if live[ins.ID] { continue }
				live[ins.ID] = true
			}
			work.Push(ins)
		}
	}
}

// markValueLive marks v live and queues it, if it is not already.
func markValueLive(v @ir.Instr, live @[]bool, work @vec.Vec[@ir.Instr], n int) {
	if v == nil || v.ID < 0 || v.ID >= n || live[v.ID] { return }
	live[v.ID] = true
	work.Push(v)
}

// isDeadValue reports whether ins is removable and was not marked live.
func isDeadValue(ins @ir.Instr, live @[]bool, n int) bool {
	return deadValueRemovable(ins.Op) && ins.ID >= 0 && ins.ID < n && !live[ins.ID]
}
