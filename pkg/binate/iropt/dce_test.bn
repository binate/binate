package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for dead-value elimination (dce.bn).

// An arithmetic chain nothing uses goes, as does an unused load; the chain the
// return uses stays, with the load it reads.
func TestDceRemovesUnusedArithmetic() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var it @types.Type = types.TypInt()
	var a @ir.Instr = irbuild.EmitAlloc(e, it)
	var x @ir.Instr = irbuild.EmitLoad(e, a, it)
	var two @ir.Instr = irbuild.EmitConstInt(e, 2, it)
	var dead @ir.Instr = irbuild.EmitBinop(e, iropcode.OP_MUL, x, two, it)
	irbuild.EmitBinop(e, iropcode.OP_ADD, dead, two, it)
	irbuild.EmitLoad(e, a, it)
	var kept @ir.Instr = irbuild.EmitBinop(e, iropcode.OP_SUB, x, two, it)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = kept
	irbuild.EmitReturn(e, rets)
	if !eliminateFuncDeadValues(f) { return fail("the unused chain should go") }
	if countOp(f, iropcode.OP_MUL) != 0 || countOp(f, iropcode.OP_ADD) != 0 {
		return fail("the unused multiply and add go")
	}
	if countOp(f, iropcode.OP_SUB) != 1 || countOp(f, iropcode.OP_CONST_INT) != 1 {
		return fail("the used subtract and its constant stay")
	}
	if countOp(f, iropcode.OP_LOAD) != 1 { return fail("the unused load goes, the used one stays") }
	if len(e.InstrsVec.Items()) != len(e.Instrs) { return fail("InstrsVec stays in step with Instrs") }
	return ""
}

// A loop accumulator whose phi feeds only its own update (and nothing outside
// the loop) goes with the update; the induction variable the branch uses stays.
func TestDceRemovesSelfFeedingPhi() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var it @types.Type = types.TypInt()
	var zero @ir.Instr = irbuild.EmitConstInt(pre, 0, it)
	irbuild.EmitJump(pre, header)
	var i @ir.Instr = irbuild.EmitPhi(header, it, onePhiEntry(pre, zero))
	var acc @ir.Instr = irbuild.EmitPhi(header, it, onePhiEntry(pre, zero))
	var ten @ir.Instr = irbuild.EmitConstInt(header, 10, it)
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, i, ten, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	var one @ir.Instr = irbuild.EmitConstInt(body, 1, it)
	var i1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, i, one, it)
	var acc1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_MUL, acc, i, it)
	irbuild.EmitJump(body, header)
	addPhiEntry(i, body, i1)
	addPhiEntry(acc, body, acc1)
	irbuild.EmitReturn(exit, make_slice(@ir.Instr, 0))
	if !eliminateFuncDeadValues(f) { return fail("the self-feeding accumulator should go") }
	if countOp(f, iropcode.OP_PHI) != 1 { return fail("only the induction phi stays") }
	if countOp(f, iropcode.OP_MUL) != 0 { return fail("the accumulator's update goes") }
	if countOp(f, iropcode.OP_ADD) != 1 { return fail("the induction update stays") }
	return ""
}

// A value a fault pad uses stays, as does everything in the pad.
func TestDceKeepsPadUses() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var it @types.Type = types.TypInt()
	var two @ir.Instr = irbuild.EmitConstInt(e, 2, it)
	var v @ir.Instr = irbuild.EmitBinop(e, iropcode.OP_MUL, two, two, it)
	irbuild.EmitBinop(pad, iropcode.OP_ADD, v, two, it)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	eliminateFuncDeadValues(f)
	if countOp(f, iropcode.OP_MUL) != 1 { return fail("a value a pad uses stays") }
	if len(pad.Instrs) != 1 || pad.Instrs[0].Op != iropcode.OP_ADD {
		return fail("a pad's instructions stay")
	}
	return ""
}

// Run after the check-removing passes, dead-value elimination also removes what
// fed a removed check: here a dividend widened only for a divide check that
// div-check-elim drops (the divisor is a safe constant).
func TestDceRemovesRemovedCheckOperands() testing.TestResult {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "test", noParams, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var it @types.Type = types.TypInt()
	var x @ir.Instr = irbuild.EmitLoad(b, irbuild.EmitAlloc(b, types.TypInt32()), types.TypInt32())
	var seven @ir.Instr = irbuild.EmitConstInt(b, 7, it)
	var wide @ir.Instr = irbuild.EmitCast(b, x, it)
	irbuild.EmitDivCheck(b, wide, seven, 64, true)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitBinop(b, iropcode.OP_DIV, x, seven, it)
	irbuild.EmitReturn(b, rets)
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countOp(f, iropcode.OP_DIV_CHECK) != 0 {
		return fail("setup: the safe divide check is dropped")
	}
	if countOp(f, iropcode.OP_CAST) != 0 {
		return fail("the dividend widened only for the dropped check goes")
	}
	if countOp(f, iropcode.OP_DIV) != 1 { return fail("the returned division stays") }
	return ""
}
