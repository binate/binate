package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"

import "pkg/binate/iropcode"
import "pkg/stdx/slices"

// Dead-phi elimination.
//
// mem2reg (promoteFuncScalars) builds minimal, not pruned, SSA: it places a phi for a
// promoted slot at every block of the iterated dominance frontier of the slot's
// stores, whether or not the slot's value is live there.  A slot that is written
// and read within one loop iteration (a loop-body temporary) therefore gets a
// phi at the loop header that nothing reads except, possibly, other such phis.
// The LLVM backend deletes them, but the native backends and the VM destruct
// every phi into copies (EliminatePhis), so each dead phi costs a register or
// spill slot and a copy on every loop back-edge.
//
// A phi is live iff some non-phi instruction (in a block or a FaultPad) uses it,
// directly or through a chain of live phis' operands; every other phi is dead
// and is removed.  This is cycle-aware: a loop-header phi whose only use is its
// own back-edge operand (or another dead phi's) is dead.  The mark is complete
// because only Args and Phis[].Val reference value instrs (Block1 / Block2 /
// PadBlock reference blocks, not values).

// eliminateFuncDeadPhis removes f's dead phis, returning whether it removed any.
func eliminateFuncDeadPhis(f @ir.Func) bool {
	var cap int = f.NextID
	var live @[]bool = boolTable(cap)
	var work @[]@ir.Instr
	work = markPhiRoots(f.Blocks, false, live, work, cap)
	work = markPhiRoots(f.FaultPads, true, live, work, cap)
	// Propagate liveness through live phis' operands; work only grows, so an
	// index walk visits every queued phi once.
	for wi := 0; wi < len(work); wi++ {
		var p @ir.Instr = work[wi]
		for k := 0; k < len(p.Phis); k++ {
			work = markPhiLive(ir.PhiVal(p.Phis[k]), live, work, cap)
		}
	}
	var removed bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		var dropped bool = false
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if isDeadPhi(instr, live, cap) {
				dropped = true
				continue
			}
			kept.Push(instr)
		}
		if dropped {
			blk.Instrs = kept.Items()
			removed = true
		}
	}
	return removed
}

// markPhiRoots marks live every phi used as an argument by a non-phi instruction
// in blocks.  In FaultPads (isPad) every phi's operands are roots too: only
// f.Blocks is swept, so a phi in a pad is always kept and must keep its operands.
// Returns the extended worklist.
func markPhiRoots(blocks @[]@ir.Block, isPad bool, live @[]bool, work @[]@ir.Instr,
		cap int) @[]@ir.Instr {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if instr.Op == iropcode.OP_PHI {
				if isPad {
					for k := 0; k < len(instr.Phis); k++ {
						work = markPhiLive(ir.PhiVal(instr.Phis[k]), live, work, cap)
					}
				}
				continue
			}
			for k := 0; k < len(instr.Args); k++ {
				work = markPhiLive(instr.Args[k], live, work, cap)
			}
		}
	}
	return work
}

// markPhiLive marks v live and queues it if it is a not-yet-live phi.
func markPhiLive(v @ir.Instr, live @[]bool, work @[]@ir.Instr, cap int) @[]@ir.Instr {
	if v == nil || v.Op != iropcode.OP_PHI || v.ID < 0 || v.ID >= cap || live[v.ID] {
		return work
	}
	live[v.ID] = true
	return slices.Append[@ir.Instr](work, v)
}

// isDeadPhi reports whether instr is a phi the mark phase did not reach.
func isDeadPhi(instr @ir.Instr, live @[]bool, cap int) bool {
	return instr.Op == iropcode.OP_PHI && instr.ID >= 0 && instr.ID < cap && !live[instr.ID]
}
