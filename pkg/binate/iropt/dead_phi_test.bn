package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for dead-phi elimination (dead_phi.bn).

// addPhiEntry appends the edge (b, v) to phi p.
func addPhiEntry(p @ir.Instr, b @ir.Block, v @ir.Instr) {
	var pe ir.PhiEntry
	pe.Block = b
	pe.Val = v
	p.Phis = slices.Append[ir.PhiEntry](p.Phis, pe)
}

// onePhiEntry returns a single-entry phi-entry list (b, v).
func onePhiEntry(b @ir.Block, v @ir.Instr) @[]ir.PhiEntry {
	var out @[]ir.PhiEntry
	var pe ir.PhiEntry
	pe.Block = b
	pe.Val = v
	out = slices.Append[ir.PhiEntry](out, pe)
	return out
}

// countPhis counts OP_PHI instrs in f's blocks.
func countPhis(f @ir.Func) int {
	return countOp(f, iropcode.OP_PHI)
}

// A counted loop with a live induction phi `i` plus two loop-temporary phis: `t`
// (its back-edge operand is a body value; nothing reads it) and `d` (reads only
// the dead `t`).  Both temporaries are removed; `i`, read by the exit's return and
// the loop condition, stays.
func TestDeadPhiLoopTemporariesRemoved() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var zero @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)

	var i @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var t @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var d @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var ten @ir.Instr = irbuild.EmitConstInt(header, 10, types.TypInt())
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, i, ten, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)

	var one @ir.Instr = irbuild.EmitConstInt(body, 1, types.TypInt())
	var i1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, i, one, types.TypInt())
	var t1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, i1, one, types.TypInt())
	irbuild.EmitJump(body, header)
	addPhiEntry(i, body, i1)
	addPhiEntry(t, body, t1)
	addPhiEntry(d, body, t)

	irbuild.EmitReturn(exit, oneRet(i))

	if !eliminateFuncDeadPhis(f) {
		return fail("dead phi: the loop temporaries should be removed")
	}
	if countPhis(f) != 1 {
		return fail("dead phi: only the induction phi should remain")
	}
	if header.Instrs[0] != i {
		return fail("dead phi: the surviving phi should be the induction phi")
	}
	if eliminateFuncDeadPhis(f) {
		return fail("dead phi: a second run should find nothing to remove")
	}
	return ""
}

// A phi used only by another phi that IS live (read by the return) is live too.
func TestDeadPhiLiveThroughPhiChainKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var join @ir.Block = ir.AddBlock(f, "join")
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, cond, thenB, elseB)
	var a @ir.Instr = irbuild.EmitConstInt(thenB, 1, types.TypInt())
	irbuild.EmitJump(thenB, merge)
	var b @ir.Instr = irbuild.EmitConstInt(elseB, 2, types.TypInt())
	irbuild.EmitJump(elseB, merge)
	var p1 @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), twoEntries(thenB, a, elseB, b))
	irbuild.EmitJump(merge, join)
	var p2 @ir.Instr = irbuild.EmitPhi(join, types.TypInt(), onePhiEntry(merge, p1))
	irbuild.EmitReturn(join, oneRet(p2))

	if eliminateFuncDeadPhis(f) {
		return fail("dead phi: nothing is dead when the phi chain feeds the return")
	}
	if countPhis(f) != 2 {
		return fail("dead phi: both chained phis must be kept")
	}
	return ""
}

// A loop-header phi whose only use is its own back-edge operand (`t = phi(0, t)`)
// is a dead cycle and is removed; the live induction phi stays.
func TestDeadPhiSelfCycleRemoved() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var zero @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)
	var i @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var t @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var ten @ir.Instr = irbuild.EmitConstInt(header, 10, types.TypInt())
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, i, ten, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	var one @ir.Instr = irbuild.EmitConstInt(body, 1, types.TypInt())
	var i1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, i, one, types.TypInt())
	irbuild.EmitJump(body, header)
	addPhiEntry(i, body, i1)
	addPhiEntry(t, body, t)
	irbuild.EmitReturn(exit, oneRet(i))

	if !eliminateFuncDeadPhis(f) || countPhis(f) != 1 || header.Instrs[0] != i {
		return fail("dead phi: a self-referential header phi should be removed, the induction phi kept")
	}
	return ""
}

// A phi whose only use is an instruction in a FaultPad is live (pads are roots).
func TestDeadPhiUsedByFaultPadKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, cond, thenB, elseB)
	var a @ir.Instr = irbuild.EmitConstInt(thenB, 1, types.TypInt())
	irbuild.EmitJump(thenB, merge)
	var b @ir.Instr = irbuild.EmitConstInt(elseB, 2, types.TypInt())
	irbuild.EmitJump(elseB, merge)
	var p @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), twoEntries(thenB, a, elseB, b))
	irbuild.EmitReturn(merge, noArgs)
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitReturn(pad, oneRet(p))

	if eliminateFuncDeadPhis(f) || countPhis(f) != 1 {
		return fail("dead phi: a phi used only from a FaultPad must be kept")
	}
	return ""
}
