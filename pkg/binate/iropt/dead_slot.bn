package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"

import "pkg/binate/iropcode"

// Dead stack-slot elimination.
//
// A stack slot — an OP_ALLOC that is neither a package global's reference nor a
// parameter's slot — whose address is only ever the destination of a whole
// OP_STORE holds bytes nothing reads: no load, no address computation, no use as
// a value, no use in a fault pad.  Its zero-fill (part of the OP_ALLOC) and every
// store into it are dead.  SROA leaves such slots: `var x Big = *p; return x.n`
// splits x into a slot per field, and the slot of a field nothing reads is still
// zero-filled and copied into, which every backend then does at run time.  The
// slot and its stores are removed, then every OP_EXTRACT left without a use (the
// member those stores were fed), repeatedly, since one extract may feed only
// another.  A value read out of memory (an OP_LOAD) is kept even when unused.
//
// The pass rebuilds a changed block's instruction list and — unlike dead-phi —
// keeps blk.InstrsVec in step, so a later pass appending through it cannot
// bring a removed instruction back.  A block with nothing to remove is left
// untouched.

// eliminateFuncDeadSlots removes f's dead stack slots, their stores and the
// extracts left unused, returning whether it removed anything.
func eliminateFuncDeadSlots(f @ir.Func) bool {
	var n int = f.NextID
	if n <= 0 { return false }
	var dead @[]bool = make_slice(bool, n)
	var any bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_ALLOC && !ins.IsGlobalRef && ins.ParamIndex == 0 && ins.ID >= 0 &&
					ins.ID < n {
				dead[ins.ID] = true
				any = true
			}
		}
	}
	if !any { return false }
	keepReadSlots(f.Blocks, dead, n, false)
	keepReadSlots(f.FaultPads, dead, n, true)
	var removed bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		if dropDeadSlotInstrs(f.Blocks[bi], dead, n) { removed = true }
	}
	if !removed { return false }
	for dropUnusedExtracts(f) {}
	return true
}

// keepReadSlots un-marks every candidate slot in dead that an instruction of
// blocks uses other than as the destination of a whole OP_STORE — and, in a
// fault pad (isPad), every one it uses at all.
func keepReadSlots(blocks @[]@ir.Block, dead @[]bool, n int, isPad bool) {
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				var a @ir.Instr = ins.Args[k]
				if a == nil || a.ID < 0 || a.ID >= n || !dead[a.ID] { continue }
				if !isPad && ins.Op == iropcode.OP_STORE && k == 0 { continue }
				dead[a.ID] = false
			}
			for k := 0; k < len(ins.Phis); k++ {
				var v *ir.Instr = ins.Phis[k].Val
				if v != nil && v.ID >= 0 && v.ID < n { dead[v.ID] = false }
			}
		}
	}
}

// isDeadSlotInstr reports whether ins is a dead slot or a store into one.
func isDeadSlotInstr(ins @ir.Instr, dead @[]bool, n int) bool {
	if ins.Op == iropcode.OP_ALLOC { return ins.ID >= 0 && ins.ID < n && dead[ins.ID] }
	if ins.Op != iropcode.OP_STORE || len(ins.Args) < 1 { return false }
	var a @ir.Instr = ins.Args[0]
	return a != nil && a.ID >= 0 && a.ID < n && dead[a.ID]
}

// dropDeadSlotInstrs removes b's dead slots and stores into them, returning
// whether it removed any.
func dropDeadSlotInstrs(b @ir.Block, dead @[]bool, n int) bool {
	var hit bool = false
	for ii := 0; ii < len(b.Instrs); ii++ {
		if isDeadSlotInstr(b.Instrs[ii], dead, n) { hit = true }
	}
	if !hit { return false }
	var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	for ii := 0; ii < len(b.Instrs); ii++ {
		if !isDeadSlotInstr(b.Instrs[ii], dead, n) { kept.Push(b.Instrs[ii]) }
	}
	b.InstrsVec = kept
	b.Instrs = kept.Items()
	return true
}

// dropUnusedExtracts removes every OP_EXTRACT of f's blocks that nothing uses
// (in a block or a fault pad), returning whether it removed any.
func dropUnusedExtracts(f @ir.Func) bool {
	var n int = f.NextID
	var used @[]bool = make_slice(bool, n)
	markUsed(f.Blocks, used, n)
	markUsed(f.FaultPads, used, n)
	var removed bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		var hit bool = false
		for ii := 0; ii < len(b.Instrs); ii++ {
			if isUnusedExtract(b.Instrs[ii], used, n) { hit = true }
		}
		if !hit { continue }
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(b.Instrs); ii++ {
			if !isUnusedExtract(b.Instrs[ii], used, n) { kept.Push(b.Instrs[ii]) }
		}
		b.InstrsVec = kept
		b.Instrs = kept.Items()
		removed = true
	}
	return removed
}

// isUnusedExtract reports whether ins is an OP_EXTRACT nothing uses.
func isUnusedExtract(ins @ir.Instr, used @[]bool, n int) bool {
	return ins.Op == iropcode.OP_EXTRACT && ins.ID >= 0 && ins.ID < n && !used[ins.ID]
}
