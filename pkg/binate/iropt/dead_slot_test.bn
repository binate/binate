package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for dead stack-slot elimination (dead_slot.bn).

// bigStructType returns struct { data [100]int; n int }.
func bigStructType() @types.Type {
	var flds @[]@types.Field = make_slice(@types.Field, 2)
	flds[0] = make(types.Field)
	flds[0].Name = "data"
	flds[0].Type = types.MakeArrayType(types.TypInt(), 100)
	flds[1] = make(types.Field)
	flds[1].Name = "n"
	flds[1].Type = types.TypInt()
	return types.MakeStructType("", flds)
}

// The SROA leftover: a struct is loaded from p, its data member extracted and
// stored into a slot nothing reads, its n member returned.  The slot, its store
// and the data extract go; the load and the n extract stay.
func TestDeadSlotRemovesSlotStoresAndExtracts() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = bigStructType()
	var p @ir.Instr = irbuild.EmitAlloc(e, st)
	var slot @ir.Instr = irbuild.EmitAlloc(e, types.MakeArrayType(types.TypInt(), 100))
	var v @ir.Instr = irbuild.EmitLoad(e, p, st)
	var data @ir.Instr = irbuild.EmitExtract(e, v, 0, slot.Typ)
	irbuild.EmitStore(e, slot, data)
	var nf @ir.Instr = irbuild.EmitExtract(e, v, 1, types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = nf
	irbuild.EmitReturn(e, rets)
	if !eliminateFuncDeadSlots(f) { return fail("the slot only stored to should be removed") }
	if countOp(f, iropcode.OP_ALLOC) != 1 { return fail("only the read slot p stays") }
	if countOp(f, iropcode.OP_STORE) != 0 { return fail("the store into the dead slot goes") }
	if countOp(f, iropcode.OP_EXTRACT) != 1 {
		return fail("the data extract goes, the n extract stays")
	}
	if countOp(f, iropcode.OP_LOAD) != 1 { return fail("the load stays") }
	if len(e.InstrsVec.Items()) != len(e.Instrs) { return fail("InstrsVec stays in step with Instrs") }
	return ""
}

// A slot that is read (loaded, or used other than as a store destination — here
// passed to a call), a package global's reference, a parameter's slot and a slot
// a fault pad uses are all kept.
func TestDeadSlotKeepsReadSlots() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var it @types.Type = types.TypInt()
	var one @ir.Instr = irbuild.EmitConstInt(e, 1, it)
	var loaded @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, loaded, one)
	var passed @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, passed, one)
	var g @ir.Instr = irbuild.EmitAlloc(e, it)
	g.IsGlobalRef = true
	irbuild.EmitStore(e, g, one)
	var param @ir.Instr = irbuild.EmitAlloc(e, it)
	param.ParamIndex = 1
	irbuild.EmitStore(e, param, one)
	var padded @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, padded, one)
	irbuild.EmitStore(pad, padded, one)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = passed
	irbuild.EmitCall(e, "h", args, it)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(e, loaded, it)
	irbuild.EmitReturn(e, rets)
	if eliminateFuncDeadSlots(f) { return fail("no slot here is dead") }
	if countOp(f, iropcode.OP_ALLOC) != 5 || countOp(f, iropcode.OP_STORE) != 5 {
		return fail("every slot and store stays")
	}
	return ""
}

// A value stored into a dead slot that is also used elsewhere stays; only the
// store goes.
func TestDeadSlotKeepsStoredValueUsedElsewhere() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = bigStructType()
	var p @ir.Instr = irbuild.EmitAlloc(e, st)
	var slot @ir.Instr = irbuild.EmitAlloc(e, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(e, p, st)
	var nf @ir.Instr = irbuild.EmitExtract(e, v, 1, types.TypInt())
	irbuild.EmitStore(e, slot, nf)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = nf
	irbuild.EmitReturn(e, rets)
	if !eliminateFuncDeadSlots(f) { return fail("the slot should be removed") }
	if countOp(f, iropcode.OP_STORE) != 0 { return fail("the store goes") }
	if countOp(f, iropcode.OP_EXTRACT) != 1 { return fail("the extract the return uses stays") }
	return ""
}

// A slot is read when its address is a store's VALUE (it escapes into the
// stored-to memory), a phi operand, or the base of an address computation —
// each keeps the slot and its stores.
func TestDeadSlotKeepsEscapingSlots() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var it @types.Type = types.TypInt()
	var one @ir.Instr = irbuild.EmitConstInt(e, 1, it)
	var stored @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, stored, one)
	var holder @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(it))
	irbuild.EmitStore(e, holder, stored)
	var phied @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, phied, one)
	var arr @types.Type = types.MakeArrayType(it, 4)
	var based @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, based, irbuild.EmitLoad(e, irbuild.EmitAlloc(e, arr), arr))
	var ep @ir.Instr = irbuild.EmitGetElemPtr(e, based, one, it)
	irbuild.EmitJump(e, next)
	var phi @ir.Instr = irbuild.EmitPhi(next, phied.Typ, onePhiEntry(e, phied))
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(next, holder, holder.Typ)
	irbuild.EmitReturn(next, rets)
	_ = ep
	_ = phi
	eliminateFuncDeadSlots(f)
	if countOp(f, iropcode.OP_STORE) != 4 {
		return fail("a slot stored as a value, a phi operand or an address base keeps its stores")
	}
	return ""
}

// An extract feeding only another extract that fed only a dead slot's store goes
// too: unused extracts are removed until none is left.
func TestDeadSlotRemovesExtractChains() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var inner @types.Type = bigStructType()
	var flds @[]@types.Field = make_slice(@types.Field, 1)
	flds[0] = make(types.Field)
	flds[0].Name = "inner"
	flds[0].Type = inner
	var outer @types.Type = types.MakeStructType("", flds)
	var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitAlloc(e, outer), outer)
	var mid @ir.Instr = irbuild.EmitExtract(e, v, 0, inner)
	var data @ir.Instr = irbuild.EmitExtract(e, mid, 0, types.MakeArrayType(types.TypInt(), 100))
	irbuild.EmitStore(e, irbuild.EmitAlloc(e, data.Typ), data)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	if !eliminateFuncDeadSlots(f) { return fail("the slot should be removed") }
	if countOp(f, iropcode.OP_EXTRACT) != 0 { return fail("both extracts of the chain go") }
	return ""
}
