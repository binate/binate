package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for overwritten-store elimination (dead_store.bn).

// A store to a confined slot that a later whole store overwrites with no load
// in between goes; the loaded one stays.
func TestDeadStoreOverwritten() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var it @types.Type = types.TypInt()
	var a @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, a, irbuild.EmitConstInt(e, 0, it))
	irbuild.EmitStore(e, a, irbuild.EmitConstInt(e, 1, it))
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(e, a, it)
	irbuild.EmitReturn(e, rets)
	if !eliminateFuncDeadStores(f) { return fail("the overwritten store should go") }
	if countOp(f, iropcode.OP_STORE) != 1 { return fail("one store stays") }
	if len(e.InstrsVec.Items()) != len(e.Instrs) { return fail("InstrsVec stays in step with Instrs") }
	return ""
}

// A load between the two stores, an address computation of the slot (not
// confined), a store in another block and a slot named in a fault pad all keep
// every store.
func TestDeadStoreKeepsReadStores() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 2)
	var one @ir.Instr = irbuild.EmitConstInt(e, 1, it)
	var read @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, read, one)
	var v @ir.Instr = irbuild.EmitLoad(e, read, it)
	irbuild.EmitStore(e, read, v)
	var gep @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, gep, irbuild.EmitLoad(e, irbuild.EmitAlloc(e, arr), arr))
	irbuild.EmitGetElemPtr(e, gep, one, it)
	irbuild.EmitStore(e, gep, irbuild.EmitLoad(e, irbuild.EmitAlloc(e, arr), arr))
	var cross @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, cross, one)
	irbuild.EmitJump(e, next)
	irbuild.EmitStore(next, cross, one)
	var padded @ir.Instr = irbuild.EmitAlloc(next, it)
	irbuild.EmitStore(next, padded, one)
	irbuild.EmitStore(next, padded, one)
	irbuild.EmitLoad(pad, padded, it)
	irbuild.EmitReturn(next, make_slice(@ir.Instr, 0))
	eliminateFuncDeadStores(f)
	if countOp(f, iropcode.OP_STORE) != 8 { return fail("every store here stays") }
	return ""
}

// An OP_ALLOC whose first use in its block is a whole store of the slot is
// marked NoZeroInit; one first loaded, first used by an address computation,
// or first stored a smaller value, or named in a fault pad, is not.
func TestDeadStoreMarksFullyWrittenSlots() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var it @types.Type = types.TypInt()
	var arr @types.Type = types.MakeArrayType(it, 2)
	var src @ir.Instr = irbuild.EmitAlloc(e, arr)
	var whole @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, whole, irbuild.EmitLoad(e, src, arr))
	var loaded @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitLoad(e, loaded, arr)
	irbuild.EmitStore(e, loaded, irbuild.EmitLoad(e, src, arr))
	var gep @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitGetElemPtr(e, gep, irbuild.EmitConstInt(e, 0, it), it)
	var small @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, small, irbuild.EmitConstInt(e, 7, it))
	var padded @ir.Instr = irbuild.EmitAlloc(e, arr)
	irbuild.EmitStore(e, padded, irbuild.EmitLoad(e, src, arr))
	irbuild.EmitLoad(pad, padded, arr)
	irbuild.EmitReturn(e, make_slice(@ir.Instr, 0))
	eliminateFuncDeadStores(f)
	if !whole.NoZeroInit { return fail("a slot first stored whole needs no zero-fill") }
	if loaded.NoZeroInit || gep.NoZeroInit || small.NoZeroInit || padded.NoZeroInit {
		return fail("a slot first read, addressed, partly stored or named in a pad keeps its zero-fill")
	}
	if src.NoZeroInit { return fail("a slot only loaded keeps its zero-fill") }
	return ""
}

// A slot used as a phi operand (not confined), one whose address is the stored
// value of a store into itself, a package global's reference and a parameter
// slot keep all their stores.  The last three are not marked NoZeroInit; the
// phi-used one is — its first use, a whole store, writes it before the phi
// reads it.
func TestDeadStoreExclusions() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var it @types.Type = types.TypInt()
	var one @ir.Instr = irbuild.EmitConstInt(e, 1, it)
	var phied @ir.Instr = irbuild.EmitAlloc(e, it)
	irbuild.EmitStore(e, phied, one)
	irbuild.EmitStore(e, phied, one)
	var pt @types.Type = types.MakePointerType(it)
	var self @ir.Instr = irbuild.EmitAlloc(e, pt)
	irbuild.EmitStore(e, self, self)
	irbuild.EmitStore(e, self, self)
	var g @ir.Instr = irbuild.EmitAlloc(e, it)
	g.IsGlobalRef = true
	irbuild.EmitStore(e, g, one)
	irbuild.EmitStore(e, g, one)
	var param @ir.Instr = irbuild.EmitAlloc(e, it)
	param.ParamIndex = 1
	irbuild.EmitStore(e, param, one)
	irbuild.EmitStore(e, param, one)
	irbuild.EmitJump(e, next)
	irbuild.EmitPhi(next, phied.Typ, onePhiEntry(e, phied))
	irbuild.EmitReturn(next, make_slice(@ir.Instr, 0))
	eliminateFuncDeadStores(f)
	if countOp(f, iropcode.OP_STORE) != 8 { return fail("every store to an excluded slot stays") }
	if self.NoZeroInit || g.NoZeroInit || param.NoZeroInit {
		return fail("a self-storing, global or parameter slot is not marked NoZeroInit")
	}
	if !phied.NoZeroInit { return fail("a phi-used slot first stored whole is marked NoZeroInit") }
	return ""
}
