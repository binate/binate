package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// divCheckModule builds a one-block func holding an OP_DIV_CHECK over a constant
// divisor followed by the OP_DIV itself, wrapped in a module ready for
// RunOptPasses.  signed selects the guard's signedness (BoolVal).
func divCheckModule(divisorVal int, signed bool) @ir.Module {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dividend @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var divisor @ir.Instr = irbuild.EmitConstInt(b, divisorVal, types.TypInt())
	irbuild.EmitDivCheck(b, dividend, divisor, 64, signed)
	irbuild.EmitBinop(b, iropcode.OP_DIV, dividend, divisor, types.TypInt())
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	return m
}

// A nonzero, non-(-1) constant divisor cannot fault, so the guard is removed —
// but the OP_DIV itself stays.
func TestDivCheckConstDivisorRemoved() testing.TestResult {
	var m @ir.Module = divCheckModule(3, true)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 { return fail("setup: expected 1 check") }
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("safe const divisor: OP_DIV_CHECK should be elided")
	}
	if countOp(m.Funcs[0], iropcode.OP_DIV) != 1 {
		return fail("the OP_DIV itself must be kept")
	}
	return ""
}

// A zero constant divisor can divide-by-zero, so the guard is KEPT.
func TestDivCheckZeroDivisorKept() testing.TestResult {
	var m @ir.Module = divCheckModule(0, true)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("zero divisor: OP_DIV_CHECK must be kept (divide-by-zero)")
	}
	return ""
}

// A signed divide by the constant -1 can overflow (INT_MIN / -1), so KEEP it.
func TestDivCheckSignedMinusOneKept() testing.TestResult {
	var m @ir.Module = divCheckModule(0 - 1, true)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("signed -1 divisor: OP_DIV_CHECK must be kept (MIN/-1 overflow)")
	}
	return ""
}

// An UNSIGNED divide by -1's bit pattern has no overflow case (only zero faults),
// so a nonzero unsigned constant divisor elides the guard.
func TestDivCheckUnsignedMinusOneRemoved() testing.TestResult {
	var m @ir.Module = divCheckModule(0 - 1, false)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("unsigned nonzero divisor: OP_DIV_CHECK should be elided")
	}
	return ""
}

// The divisor was widened to 64-bit at emission; the elision peels that
// widening OP_CAST to reach the underlying constant.
func TestDivCheckConstDivisorViaCastRemoved() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dividend @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var inner @ir.Instr = irbuild.EmitConstInt(b, 7, types.TypInt())
	var divisor @ir.Instr = irbuild.EmitCast(b, inner, types.TypInt64())
	irbuild.EmitDivCheck(b, dividend, divisor, 32, true)
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 0 {
		return fail("safe const divisor behind a widening cast should be elided")
	}
	return ""
}

// A non-constant divisor (here an OP_ADD, which no pass folds) keeps the guard —
// the elision is constant-only.
func TestDivCheckNonConstDivisorKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dividend @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt())
	var divisor @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, c, c, types.TypInt())
	irbuild.EmitDivCheck(b, dividend, divisor, 64, true)
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("non-constant divisor: OP_DIV_CHECK must be kept")
	}
	return ""
}

// At -O0 no opt passes run, so the guard is never elided (matches BCE).
func TestDivCheckNotElidedAtO0() testing.TestResult {
	var m @ir.Module = divCheckModule(3, true)
	RunOptPasses(m, 0)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("-O0: OP_DIV_CHECK must be kept (no opt passes run)")
	}
	return ""
}

// A narrowing cast of a nonzero constant, as it actually reaches Args[1] — under
// the widening ensureInt64ForCheck cast — must KEEP the guard: the single-level
// peel removes only the outer (value-preserving) widening cast and lands on the
// inner narrowing cast (a non-const OP_CAST), so it does not read the
// pre-narrowing 256 and wrongly elide.  (cast(int8, 256) == 0 would divide-by-
// zero; here the elision never sees the 256.)
func TestDivCheckNarrowingCastUnderWideningKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dividend @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var inner @ir.Instr = irbuild.EmitConstInt(b, 256, types.TypInt64())
	var narrowed @ir.Instr = irbuild.EmitCast(b, inner, types.TypInt8())
	var divisor @ir.Instr = irbuild.EmitCast(b, narrowed, types.TypInt64())
	irbuild.EmitDivCheck(b, dividend, divisor, 8, true)
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("narrowing cast under widening: OP_DIV_CHECK must be kept")
	}
	return ""
}

// A float->int cast divisor must KEEP the guard: the underlying operand is a
// float constant, not OP_CONST_INT, so it never elides (cast(int, 0.5) == 0
// would divide-by-zero).
func TestDivCheckFloatToIntCastDivisorKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dividend @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var fc @ir.Instr = irbuild.EmitConstFloat(b, "0.5", types.TypFloat64())
	var divisor @ir.Instr = irbuild.EmitCast(b, fc, types.TypInt())
	irbuild.EmitDivCheck(b, dividend, divisor, 64, true)
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(f)
	RunOptPasses(m, 1)
	if countOp(m.Funcs[0], iropcode.OP_DIV_CHECK) != 1 {
		return fail("float->int cast divisor: OP_DIV_CHECK must be kept")
	}
	return ""
}
