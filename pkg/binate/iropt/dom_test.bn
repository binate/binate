package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the dominance infrastructure (dom.bn) on hand-built CFGs.

// hasInt reports whether s contains v.
func hasInt(s @[]int, v int) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == v {
			return true
		}
	}
	return false
}

// setEq reports whether s contains exactly the elements of want (order
// independent, no duplicates assumed in want).
func setEq(s @[]int, want @[]int) bool {
	if len(s) != len(want) {
		return false
	}
	for i := 0; i < len(want); i++ {
		if !hasInt(s, want[i]) {
			return false
		}
	}
	return true
}

// ints builds an @[]int from up to three values (n selects how many).
func ints0() @[]int {
	var s @[]int
	return s
}

func ints1(a int) @[]int {
	var s @[]int = make_slice(int, 1)
	s[0] = a
	return s
}

func ints2(a int, b int) @[]int {
	var s @[]int = make_slice(int, 2)
	s[0] = a
	s[1] = b
	return s
}

// A diamond: entry -> {then, else} -> merge.  The merge is dominated by
// the entry (not by either arm), and each arm's dominance frontier is
// the merge.
func TestComputeDomDiamond() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry") // 0
	var thenB @ir.Block = ir.AddBlock(f, "then") // 1
	var elseB @ir.Block = ir.AddBlock(f, "else") // 2
	var merge @ir.Block = ir.AddBlock(f, "merge") // 3
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, cond, thenB, elseB)
	irbuild.EmitJump(thenB, merge)
	irbuild.EmitJump(elseB, merge)
	var r @ir.Instr = irbuild.EmitConstInt(merge, 0, types.TypInt())
	irbuild.EmitReturn(merge, oneRet(r))

	var d @DomInfo = ComputeDom(f)

	// Predecessors.
	if !setEq(d.Preds[0], ints0()) {
		return fail("diamond: entry has no preds")
	}
	if !setEq(d.Preds[3], ints2(1, 2)) {
		return fail("diamond: merge preds are then+else")
	}
	// Immediate dominators: everything's idom is the entry.
	if d.Idom[0] != 0 || d.Idom[1] != 0 || d.Idom[2] != 0 || d.Idom[3] != 0 {
		return fail("diamond: all idoms should be the entry")
	}
	// Dominance frontiers.
	if !setEq(d.DF[1], ints1(3)) || !setEq(d.DF[2], ints1(3)) {
		return fail("diamond: each arm's DF is the merge")
	}
	if len(d.DF[0]) != 0 || len(d.DF[3]) != 0 {
		return fail("diamond: entry and merge have empty DF")
	}
	// Dominates relation.
	if !d.Dominates(0, 3) {
		return fail("diamond: entry dominates merge")
	}
	if d.Dominates(1, 3) {
		return fail("diamond: an arm does NOT dominate the merge")
	}
	if !d.Dominates(3, 3) {
		return fail("diamond: a block dominates itself")
	}
	// Iterated DF of a def in both arms is the merge.
	if !setEq(d.IteratedDF(ints2(1, 2)), ints1(3)) {
		return fail("diamond: IDF of both arms is {merge}")
	}
	return ""
}

// A reducible loop: pre -> header; header -> {body, exit}; body ->
// header (back-edge).  The loop header is in its own dominance frontier,
// so a def in the body needs a phi at the header.
func TestComputeDomLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre") // 0
	var header @ir.Block = ir.AddBlock(f, "header") // 1
	var body @ir.Block = ir.AddBlock(f, "body") // 2
	var exit @ir.Block = ir.AddBlock(f, "exit") // 3
	irbuild.EmitJump(pre, header)
	var cond @ir.Instr = irbuild.EmitConstBool(header, true)
	irbuild.EmitBranch(header, cond, body, exit)
	irbuild.EmitJump(body, header)
	var r @ir.Instr = irbuild.EmitConstInt(exit, 0, types.TypInt())
	irbuild.EmitReturn(exit, oneRet(r))

	var d @DomInfo = ComputeDom(f)

	if !setEq(d.Preds[1], ints2(0, 2)) {
		return fail("loop: header preds are pre + body")
	}
	// Idoms: header<-pre, body<-header, exit<-header.
	if d.Idom[0] != 0 || d.Idom[1] != 0 || d.Idom[2] != 1 || d.Idom[3] != 1 {
		return fail("loop: idom chain pre->header->{body,exit}")
	}
	// The header is in its own DF (the back-edge target).
	if !setEq(d.DF[1], ints1(1)) {
		return fail("loop: header's DF contains the header")
	}
	if !setEq(d.DF[2], ints1(1)) {
		return fail("loop: body's DF is the header")
	}
	if !d.Dominates(1, 2) || !d.Dominates(1, 3) {
		return fail("loop: header dominates body and exit")
	}
	if d.Dominates(2, 1) {
		return fail("loop: body does NOT dominate the header")
	}
	// A def in the body wants a phi at the header only.
	if !setEq(d.IteratedDF(ints1(2)), ints1(1)) {
		return fail("loop: IDF of a body def is {header}")
	}
	return ""
}

// A diamond nested inside the then-arm of an outer diamond:
//   entry -> {A, F};  A -> {B, C};  B,C -> D;  D -> F.
// Block indices: 0=entry 1=A 2=B 3=C 4=D 5=F.
// A dominates the inner region {B,C,D} but not F (reached via entry too).
func TestComputeDomNested() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry") // 0
	var a @ir.Block = ir.AddBlock(f, "A") // 1
	var b @ir.Block = ir.AddBlock(f, "B") // 2
	var c @ir.Block = ir.AddBlock(f, "C") // 3
	var dd @ir.Block = ir.AddBlock(f, "D") // 4
	var ff @ir.Block = ir.AddBlock(f, "F") // 5
	var cond0 @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, cond0, a, ff)
	var cond1 @ir.Instr = irbuild.EmitConstBool(a, true)
	irbuild.EmitBranch(a, cond1, b, c)
	irbuild.EmitJump(b, dd)
	irbuild.EmitJump(c, dd)
	irbuild.EmitJump(dd, ff)
	var r @ir.Instr = irbuild.EmitConstInt(ff, 0, types.TypInt())
	irbuild.EmitReturn(ff, oneRet(r))

	var d @DomInfo = ComputeDom(f)

	// Idoms: A<-entry, B<-A, C<-A, D<-A, F<-entry.
	if d.Idom[1] != 0 || d.Idom[2] != 1 || d.Idom[3] != 1 {
		return fail("nested: A<-entry, B<-A, C<-A")
	}
	if d.Idom[4] != 1 {
		return fail("nested: D<-A (common dom of both inner arms)")
	}
	if d.Idom[5] != 0 {
		return fail("nested: F<-entry (reached via entry AND D)")
	}
	// A dominates the inner region but not the outer merge F.
	if !d.Dominates(1, 4) {
		return fail("nested: A dominates D")
	}
	if d.Dominates(1, 5) {
		return fail("nested: A does NOT dominate F")
	}
	if d.Dominates(4, 5) {
		return fail("nested: D does NOT dominate F")
	}
	// Dominance frontiers.
	if !setEq(d.DF[2], ints1(4)) || !setEq(d.DF[3], ints1(4)) {
		return fail("nested: inner arms' DF is D")
	}
	if !setEq(d.DF[1], ints1(5)) || !setEq(d.DF[4], ints1(5)) {
		return fail("nested: A's and D's DF is F")
	}
	// A def in both inner arms needs phis at D then F (iterated).
	if !setEq(d.IteratedDF(ints2(2, 3)), ints2(4, 5)) {
		return fail("nested: IDF of the inner arms is {D, F}")
	}
	return ""
}

// A jump-only chain has no join points, so every DF is empty and the
// dominator tree is a straight line.
func TestComputeDomStraightLine() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b0 @ir.Block = ir.AddBlock(f, "b0")
	var b1 @ir.Block = ir.AddBlock(f, "b1")
	var b2 @ir.Block = ir.AddBlock(f, "b2")
	irbuild.EmitJump(b0, b1)
	irbuild.EmitJump(b1, b2)
	var r @ir.Instr = irbuild.EmitConstInt(b2, 0, types.TypInt())
	irbuild.EmitReturn(b2, oneRet(r))

	var d @DomInfo = ComputeDom(f)

	if d.Idom[0] != 0 || d.Idom[1] != 0 || d.Idom[2] != 1 {
		return fail("line: idom chain b0->b1->b2")
	}
	if len(d.DF[0]) != 0 || len(d.DF[1]) != 0 || len(d.DF[2]) != 0 {
		return fail("line: no joins means empty DFs")
	}
	if !d.Dominates(0, 2) || !d.Dominates(1, 2) {
		return fail("line: b0 and b1 dominate b2")
	}
	return ""
}
