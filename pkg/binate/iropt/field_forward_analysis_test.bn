package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the access-path + barrier primitives (field_forward_analysis.bn),
// in isolation from the whole-pass tests in field_forward_test.bn (which share the
// mkMPParam / mkNestedParam / fieldLoad / deepLoad helpers used here).

func ffIndices1(a int) @[]int {
	var s @[]int = make_slice(int, 1)
	s[0] = a
	return s
}

func ffIndices2(a int, b int) @[]int {
	var s @[]int = make_slice(int, 2)
	s[0] = a
	s[1] = b
	return s
}

// isPrefixOrEqual: [] and any true prefix (incl. equal) hold; a longer or divergent
// sequence does not.
func TestFFIsPrefixOrEqual() testing.TestResult {
	var empty @[]int
	if !isPrefixOrEqual(empty, ffIndices2(0, 1)) {
		return fail("[] is a prefix of anything")
	}
	if !isPrefixOrEqual(ffIndices1(0), ffIndices2(0, 1)) {
		return fail("[0] is a prefix of [0,1]")
	}
	if !isPrefixOrEqual(ffIndices2(0, 1), ffIndices2(0, 1)) {
		return fail("[0,1] equals [0,1]")
	}
	if isPrefixOrEqual(ffIndices2(0, 1), ffIndices1(0)) {
		return fail("[0,1] is not a prefix of the shorter [0]")
	}
	if isPrefixOrEqual(ffIndices1(1), ffIndices2(0, 1)) {
		return fail("[1] is not a prefix of [0,1] (diverges at index 0)")
	}
	return ""
}

// loadPath of a direct param field is a length-1 path; valuePath of that leaf load
// (an int, not a managed pointer) is NOT a dereferenceable base.
func TestFFLoadPathDepth1() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l @ir.Instr = fieldLoad(entry, base, 1)

	var c ffCoord = loadPath(l)
	if !c.ok || c.paramID != base.ID || len(c.indices) != 1 || c.indices[0] != 1 {
		return fail("loadPath(s.f1) should be (s, [1])")
	}
	if valuePath(l).ok {
		return fail("valuePath of an int-field load is not a dereferenceable base")
	}
	return ""
}

// loadPath of a depth-2 access (s.current.state) is a length-2 path.
func TestFFLoadPathDepth2() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr
	var innerPt @types.Type
	base, innerPt = mkNestedParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l @ir.Instr = deepLoad(entry, base, innerPt, 0)

	var c ffCoord = loadPath(l)
	if !c.ok || c.paramID != base.ID || len(c.indices) != 2 || c.indices[0] != 0 || c.indices[1] != 0 {
		return fail("loadPath(s.current.state) should be (s, [0, 0])")
	}
	return ""
}

// storeKillsPath: a store to s.f0 kills (s,[0]) [equal] and (s,[0,k]) [prefix], is
// disjoint from (s,[1]) [divergent], and an alloca-rooted store kills nothing.
func TestFFStoreKillsPath() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var gfp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 0, types.TypInt())

	var kSame ffKey
	kSame.paramID = base.ID
	kSame.indices = ffIndices1(0)
	var kDiv ffKey
	kDiv.paramID = base.ID
	kDiv.indices = ffIndices1(1)
	var kDeep ffKey
	kDeep.paramID = base.ID
	kDeep.indices = ffIndices2(0, 5)

	if !storeKillsPath(gfp0, kSame) {
		return fail("a store to s.f0 must kill the equal path (s,[0])")
	}
	if storeKillsPath(gfp0, kDiv) {
		return fail("a store to s.f0 is disjoint from the divergent path (s,[1])")
	}
	if !storeKillsPath(gfp0, kDeep) {
		return fail("a store to s.f0 must kill the extending path (s,[0,5])")
	}
	var slot @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	if storeKillsPath(slot, kSame) {
		return fail("a store rooted at a local alloca is disjoint from any heap path")
	}
	return ""
}

// mk2FieldStruct builds a named 2-int-field struct type.
func mk2FieldStruct(name @[]char) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "b"
	f1.Type = types.TypInt()
	fields[0] = f0
	fields[1] = f1
	return types.MakeStructType(name, fields)
}

// mkStructPtrParam adds a `@structTyp` managed-pointer parameter and returns its
// OP_PARAM reference.
func mkStructPtrParam(f @ir.Func, paramName @[]char, structTyp @types.Type) @ir.Instr {
	var pt @types.Type = types.MakeManagedPtrType(structTyp)
	var p @ir.Param = ir.NewParam(f, paramName, pt)
	return ir.NewParamRef(p)
}

// distinctStructObjects: distinct named structs are distinct objects; the same
// struct type is not (two @A may be the same object); nil / non-struct is not.
func TestFFDistinctStructObjects() testing.TestResult {
	var a @types.Type = mk2FieldStruct("A")
	var b @types.Type = mk2FieldStruct("B")
	if !distinctStructObjects(a, b) {
		return fail("distinct named structs A and B are distinct objects")
	}
	if distinctStructObjects(a, a) {
		return fail("the same struct type is NOT distinct (two @A may be one object)")
	}
	if distinctStructObjects(a, nil) {
		return fail("nil is not provably distinct")
	}
	if distinctStructObjects(a, types.TypInt()) {
		return fail("a non-struct type is not provably distinct")
	}
	return ""
}

// storeKillsPath across DIFFERENT root params: a store through @B does not kill a
// load through @A (distinct struct types can't alias), but a store through a
// second @A conservatively kills (two @A params may be the same object).
func TestFFStoreKillsPathDistinctType() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var aTyp @types.Type = mk2FieldStruct("A")
	var bTyp @types.Type = mk2FieldStruct("B")
	var aRef @ir.Instr = mkStructPtrParam(f, "a", aTyp)
	var bRef @ir.Instr = mkStructPtrParam(f, "b", bTyp)
	var a2Ref @ir.Instr = mkStructPtrParam(f, "a2", aTyp)

	// Key: a load of a.0, whose accessed object is the A struct.
	var kA ffKey
	kA.paramID = aRef.ID
	kA.indices = ffIndices1(0)
	kA.objTyp = aTyp

	var gfpB @ir.Instr = irbuild.EmitGetFieldPtr(entry, bRef, 0, types.TypInt())
	if storeKillsPath(gfpB, kA) {
		return fail("a store through @B must NOT kill a load through @A (distinct types can't alias)")
	}
	var gfpA2 @ir.Instr = irbuild.EmitGetFieldPtr(entry, a2Ref, 0, types.TypInt())
	if !storeKillsPath(gfpA2, kA) {
		return fail("a store through a second @A param must conservatively kill (may be the same object)")
	}
	return ""
}
