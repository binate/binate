package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for redundant field-load elimination (field_forward.bn).  Each builds a
// tiny function with a managed-pointer parameter, emits field loads through it,
// runs forwardFieldLoadsFunc, and checks which loads were coalesced.  Shared
// helpers (oneRet, countOp, fail) live in opt_helpers_test.bn.

// mkMPParam makes a managed-pointer parameter `@S` (S a 2-int-field struct) on f
// and returns its OP_PARAM reference — the field base the pass recognizes.
func mkMPParam(f @ir.Func) @ir.Instr {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "b"
	f1.Type = types.TypInt()
	fields[0] = f0
	fields[1] = f1
	var st @types.Type = types.MakeStructType("S", fields)
	var pt @types.Type = types.MakeManagedPtrType(st)
	var p @ir.Param = ir.NewParam(f, "s", pt)
	return ir.NewParamRef(p)
}

// fieldLoad emits LOAD(GET_FIELD_PTR(base, idx)) of an int field.
func fieldLoad(b @ir.Block, base @ir.Instr, idx int) @ir.Instr {
	var gfp @ir.Instr = irbuild.EmitGetFieldPtr(b, base, idx, types.TypInt())
	return irbuild.EmitLoad(b, gfp, types.TypInt())
}

// Two loads of the same param field with nothing between them coalesce onto the
// first; the second load and its now-dead GET_FIELD_PTR are deleted.
func TestFieldForwardCoalesce() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("coalesce: the redundant field load should be forwarded away")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("coalesce: the now-dead GET_FIELD_PTR should be dropped")
	}
	if sum.Args[0] != l1 || sum.Args[1] != l1 {
		return fail("coalesce: both uses should read the first load")
	}
	return ""
}

// A call between two loads is a barrier (arbitrary heap mutation): both loads are
// kept.
func TestFieldForwardCallBarrier() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var noArgs @[]@ir.Instr
	irbuild.EmitCall(entry, "sideEffect", noArgs, types.TypInt())
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("call barrier: a call between the loads must prevent coalescing")
	}
	return ""
}

// A store to the SAME field between the loads is a barrier: the field's value may
// have changed, so the second load is kept.
func TestFieldForwardSameFieldStoreBarrier() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var gfpStore @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 0, types.TypInt())
	irbuild.EmitStore(entry, gfpStore, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("same-field store: a write to the field must prevent coalescing")
	}
	return ""
}

// A store to a DIFFERENT field of the same param does NOT alias, so the two loads
// of field 0 still coalesce across it.
func TestFieldForwardDiffFieldStoreOK() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var gfpStore @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 1, types.TypInt())
	irbuild.EmitStore(entry, gfpStore, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("diff-field store: a write to another field must not block coalescing")
	}
	if sum.Args[1] != l1 {
		return fail("diff-field store: the second load should forward to the first")
	}
	return ""
}

// A field load through a NON-param base (here a local alloca of `@S`) is not a
// candidate — only managed-pointer parameters are forwarded — so nothing changes.
func TestFieldForwardNonParamBaseDeclined() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var st @types.Type = types.MakeStructType("S", fields)
	var pt @types.Type = types.MakeManagedPtrType(st)
	var slot @ir.Instr = irbuild.EmitAlloc(entry, pt)
	var base @ir.Instr = irbuild.EmitLoad(entry, slot, pt) // a loaded value, not an OP_PARAM
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	// The two field loads (l1, l2) both survive: base is not a managed-ptr param.
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 2 {
		return fail("non-param base: field loads through a non-param must not be coalesced")
	}
	return ""
}

// Robustness: if the entry block (block 0) ever has a CFG predecessor (a back-edge
// — which gen never produces today), a repr loaded inside the loop must NOT be
// treated as available at entry and forwarded to across a path that bypasses the
// loop body.  Here `body` (loading hb) does NOT dominate `exit` (the path
// entry->exit skips body), so exit's load must be kept.  meetPreds pins entry to
// all-⊥, which prevents the false forward.
func TestFieldForwardEntryBackedgeNoFalseForward() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, intResults1())
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry") // block 0
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, c, body, exit)
	var hb @ir.Instr = fieldLoad(body, base, 0)
	_ = hb
	irbuild.EmitJump(body, entry) // back-edge into block 0
	var he @ir.Instr = fieldLoad(exit, base, 0)
	irbuild.EmitReturn(exit, oneRet(he))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("entry back-edge: a loop-carried load must not forward to a non-dominating repr")
	}
	return ""
}

// A load in a dominating block and an identical load in a dominated successor, with
// no barrier between, coalesce across the block edge.
func TestFieldForwardCrossBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	irbuild.EmitJump(entry, next)
	var l2 @ir.Instr = fieldLoad(next, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(next, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("cross-block: a load dominated by an identical unbarriered load should coalesce")
	}
	if sum.Args[1] != l1 {
		return fail("cross-block: the dominated load should forward to the dominating one")
	}
	return ""
}

// mkNestedParam makes a param `@Outer` whose field 0 is a managed pointer `@Inner`
// (Inner: two int fields), and returns (OP_PARAM ref, @Inner type).  This is the
// `s.current.state` shape: a managed-ptr field reached through a managed-ptr param.
func mkNestedParam(f @ir.Func) (@ir.Instr, @types.Type) {
	var innerFields @[]@types.Field = make_slice(@types.Field, 2)
	var i0 @types.Field = make(types.Field)
	i0.Name = "state"
	i0.Type = types.TypInt()
	var i1 @types.Field = make(types.Field)
	i1.Name = "id"
	i1.Type = types.TypInt()
	innerFields[0] = i0
	innerFields[1] = i1
	var inner @types.Type = types.MakeStructType("Inner", innerFields)
	var innerPt @types.Type = types.MakeManagedPtrType(inner)
	var outerFields @[]@types.Field = make_slice(@types.Field, 1)
	var o0 @types.Field = make(types.Field)
	o0.Name = "current"
	o0.Type = innerPt
	outerFields[0] = o0
	var outer @types.Type = types.MakeStructType("Outer", outerFields)
	var outerPt @types.Type = types.MakeManagedPtrType(outer)
	var p @ir.Param = ir.NewParam(f, "s", outerPt)
	return ir.NewParamRef(p), innerPt
}

// deepLoad emits `s.current.<innerIdx>` = LOAD(GFP(LOAD(GFP(base, 0)), innerIdx)),
// a depth-2 access path (base.current is field 0, a managed pointer).
func deepLoad(b @ir.Block, base @ir.Instr, innerPt @types.Type, innerIdx int) @ir.Instr {
	var gfp0 @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 0, innerPt)
	var inner @ir.Instr = irbuild.EmitLoad(b, gfp0, innerPt)
	var gfp1 @ir.Instr = irbuild.EmitGetFieldPtr(b, inner, innerIdx, types.TypInt())
	return irbuild.EmitLoad(b, gfp1, types.TypInt())
}

// Depth-2: two reads of `s.current.state` with no barrier coalesce — both the
// inner `s.current` loads and the leaf `.state` loads collapse to one repr each.
func TestFieldForwardDepth2Coalesce() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr
	var innerPt @types.Type
	base, innerPt = mkNestedParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	var l2 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if sum.Args[0] != l1 || sum.Args[1] != l1 {
		return fail("depth-2: both s.current.state reads should forward to the first")
	}
	// One inner (s.current) load + one leaf (.state) load remain.
	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("depth-2: inner and leaf loads should each coalesce to one")
	}
	return ""
}

// Depth-2 prefix kill: a store to `s.current` (a prefix of `s.current.state`) may
// free *s.current, so a cached `s.current.state` must NOT be forwarded across it.
func TestFieldForwardDepth2PrefixKill() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr
	var innerPt @types.Type
	base, innerPt = mkNestedParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	// s.current = nil : a store to path (s,[current]) — prefix of (s,[current,state]).
	var gfpCur @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 0, innerPt)
	irbuild.EmitStore(entry, gfpCur, irbuild.EmitConstNil(entry, innerPt))
	var l2 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if sum.Args[1] == l1 {
		return fail("depth-2 prefix kill: a store to s.current must stop s.current.state forwarding")
	}
	return ""
}

// Depth-2 divergent store OK: a store to `s.current.id` (a different leaf field of
// the SAME *s.current) is disjoint from `s.current.state`, so the two reads of
// `s.current.state` still coalesce across it.
func TestFieldForwardDepth2DivergentOK() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr
	var innerPt @types.Type
	base, innerPt = mkNestedParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	// s.current.id = 7 : store to path (s,[current,id]) — diverges from [current,state].
	var gfpCur @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 0, innerPt)
	var inner @ir.Instr = irbuild.EmitLoad(entry, gfpCur, innerPt)
	var gfpId @ir.Instr = irbuild.EmitGetFieldPtr(entry, inner, 1, types.TypInt())
	irbuild.EmitStore(entry, gfpId, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var l2 @ir.Instr = deepLoad(entry, base, innerPt, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if sum.Args[1] != l1 {
		return fail("depth-2 divergent store: a store to s.current.id must not block s.current.state")
	}
	return ""
}

// mkTwoPtrParam makes a param `@Outer` with TWO managed-pointer fields f0, f1 (both
// `@Inner`, Inner: one int field), returning (OP_PARAM ref, @Inner type).  f0 and
// f1 may point to the SAME Inner at runtime — the aliasing the interior-divergence
// test needs.
func mkTwoPtrParam(f @ir.Func) (@ir.Instr, @types.Type) {
	var innerFields @[]@types.Field = make_slice(@types.Field, 1)
	var i0 @types.Field = make(types.Field)
	i0.Name = "state"
	i0.Type = types.TypInt()
	innerFields[0] = i0
	var inner @types.Type = types.MakeStructType("Inner2", innerFields)
	var innerPt @types.Type = types.MakeManagedPtrType(inner)
	var outerFields @[]@types.Field = make_slice(@types.Field, 2)
	var o0 @types.Field = make(types.Field)
	o0.Name = "f0"
	o0.Type = innerPt
	var o1 @types.Field = make(types.Field)
	o1.Name = "f1"
	o1.Type = innerPt
	outerFields[0] = o0
	outerFields[1] = o1
	var outer @types.Type = types.MakeStructType("Outer2", outerFields)
	var outerPt @types.Type = types.MakeManagedPtrType(outer)
	var p @ir.Param = ir.NewParam(f, "s", outerPt)
	return ir.NewParamRef(p), innerPt
}

// deepLoadAt emits `s.<outerIdx>.state` (state is Inner field 0).
func deepLoadAt(b @ir.Block, base @ir.Instr, outerIdx int, innerPt @types.Type) @ir.Instr {
	var gfp0 @ir.Instr = irbuild.EmitGetFieldPtr(b, base, outerIdx, innerPt)
	var inner @ir.Instr = irbuild.EmitLoad(b, gfp0, innerPt)
	var gfp1 @ir.Instr = irbuild.EmitGetFieldPtr(b, inner, 0, types.TypInt())
	return irbuild.EmitLoad(b, gfp1, types.TypInt())
}

// INTERIOR divergence must NOT be treated as disjoint: a store to `s.f1.state`
// (path (s,[1,0])) diverges from a cached `s.f0.state` (path (s,[0,0])) at the
// interior index 0 — but f0 and f1 may alias the same Inner, so the store may
// change s.f0.state.  The cached load must be killed (not forwarded).  This is the
// aliasing miscompile the leaf-only "divergent = disjoint" rule would produce.
func TestFieldForwardDepth2InteriorDivergenceKills() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr
	var innerPt @types.Type
	base, innerPt = mkTwoPtrParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = deepLoadAt(entry, base, 0, innerPt) // s.f0.state
	// s.f1.state = 5 : store to path (s,[1,0]), interior-divergent from (s,[0,0]).
	var gfp1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 1, innerPt)
	var i1 @ir.Instr = irbuild.EmitLoad(entry, gfp1, innerPt)
	var gfpS1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, i1, 0, types.TypInt())
	irbuild.EmitStore(entry, gfpS1, irbuild.EmitConstInt(entry, 5, types.TypInt()))
	var l2 @ir.Instr = deepLoadAt(entry, base, 0, innerPt) // s.f0.state again
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if sum.Args[1] == l1 {
		return fail(
				"interior divergence: a store to s.f1.state must kill cached s.f0.state (f0/f1 may alias)")
	}
	return ""
}
