package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for redundant field-load elimination (field_forward.bn).  Each builds a
// tiny function with a managed-pointer parameter, emits field loads through it,
// runs forwardFieldLoadsFunc, and checks which loads were coalesced.  Shared
// helpers (oneRet, countOp, fail) live in opt_helpers_test.bn.

// mkMPParam makes a managed-pointer parameter `@S` (S a 2-int-field struct) on f
// and returns its OP_PARAM reference — the field base the pass recognizes.
func mkMPParam(f @ir.Func) @ir.Instr {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	var f1 @types.Field = make(types.Field)
	f1.Name = "b"
	f1.Type = types.TypInt()
	fields[0] = f0
	fields[1] = f1
	var st @types.Type = types.MakeStructType("S", fields)
	var pt @types.Type = types.MakeManagedPtrType(st)
	var p @ir.Param = ir.NewParam(f, "s", pt)
	return ir.NewParamRef(p)
}

// fieldLoad emits LOAD(GET_FIELD_PTR(base, idx)) of an int field.
func fieldLoad(b @ir.Block, base @ir.Instr, idx int) @ir.Instr {
	var gfp @ir.Instr = irbuild.EmitGetFieldPtr(b, base, idx, types.TypInt())
	return irbuild.EmitLoad(b, gfp, types.TypInt())
}

// Two loads of the same param field with nothing between them coalesce onto the
// first; the second load and its now-dead GET_FIELD_PTR are deleted.
func TestFieldForwardCoalesce() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("coalesce: the redundant field load should be forwarded away")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 1 {
		return fail("coalesce: the now-dead GET_FIELD_PTR should be dropped")
	}
	if sum.Args[0] != l1 || sum.Args[1] != l1 {
		return fail("coalesce: both uses should read the first load")
	}
	return ""
}

// A call between two loads is a barrier (arbitrary heap mutation): both loads are
// kept.
func TestFieldForwardCallBarrier() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var noArgs @[]@ir.Instr
	irbuild.EmitCall(entry, "sideEffect", noArgs, types.TypInt())
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("call barrier: a call between the loads must prevent coalescing")
	}
	return ""
}

// A store to the SAME field between the loads is a barrier: the field's value may
// have changed, so the second load is kept.
func TestFieldForwardSameFieldStoreBarrier() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var gfpStore @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 0, types.TypInt())
	irbuild.EmitStore(entry, gfpStore, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("same-field store: a write to the field must prevent coalescing")
	}
	return ""
}

// A store to a DIFFERENT field of the same param does NOT alias, so the two loads
// of field 0 still coalesce across it.
func TestFieldForwardDiffFieldStoreOK() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var gfpStore @ir.Instr = irbuild.EmitGetFieldPtr(entry, base, 1, types.TypInt())
	irbuild.EmitStore(entry, gfpStore, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("diff-field store: a write to another field must not block coalescing")
	}
	if sum.Args[1] != l1 {
		return fail("diff-field store: the second load should forward to the first")
	}
	return ""
}

// A field load through a NON-param base (here a local alloca of `@S`) is not a
// candidate — only managed-pointer parameters are forwarded — so nothing changes.
func TestFieldForwardNonParamBaseDeclined() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var st @types.Type = types.MakeStructType("S", fields)
	var pt @types.Type = types.MakeManagedPtrType(st)
	var slot @ir.Instr = irbuild.EmitAlloc(entry, pt)
	var base @ir.Instr = irbuild.EmitLoad(entry, slot, pt) // a loaded value, not an OP_PARAM
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	var l2 @ir.Instr = fieldLoad(entry, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(sum))

	forwardFieldLoadsFunc(f)

	// The two field loads (l1, l2) both survive: base is not a managed-ptr param.
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 2 {
		return fail("non-param base: field loads through a non-param must not be coalesced")
	}
	return ""
}

// Robustness: if the entry block (block 0) ever has a CFG predecessor (a back-edge
// — which gen never produces today), a repr loaded inside the loop must NOT be
// treated as available at entry and forwarded to across a path that bypasses the
// loop body.  Here `body` (loading hb) does NOT dominate `exit` (the path
// entry->exit skips body), so exit's load must be kept.  meetPreds pins entry to
// all-⊥, which prevents the false forward.
func TestFieldForwardEntryBackedgeNoFalseForward() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, intResults1())
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry") // block 0
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, c, body, exit)
	var hb @ir.Instr = fieldLoad(body, base, 0)
	_ = hb
	irbuild.EmitJump(body, entry) // back-edge into block 0
	var he @ir.Instr = fieldLoad(exit, base, 0)
	irbuild.EmitReturn(exit, oneRet(he))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("entry back-edge: a loop-carried load must not forward to a non-dominating repr")
	}
	return ""
}

// A load in a dominating block and an identical load in a dominated successor, with
// no barrier between, coalesce across the block edge.
func TestFieldForwardCrossBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var base @ir.Instr = mkMPParam(f)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var l1 @ir.Instr = fieldLoad(entry, base, 0)
	irbuild.EmitJump(entry, next)
	var l2 @ir.Instr = fieldLoad(next, base, 0)
	var sum @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, l1, l2, types.TypInt())
	irbuild.EmitReturn(next, oneRet(sum))

	forwardFieldLoadsFunc(f)

	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("cross-block: a load dominated by an identical unbarriered load should coalesce")
	}
	if sum.Args[1] != l1 {
		return fail("cross-block: the dominated load should forward to the dominating one")
	}
	return ""
}
