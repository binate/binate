package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for constant-branch folding (fold_branch.bn).

// constOfType returns an OP_CONST_INT of type typ holding the raw IntVal v.
func constOfType(v int64, typ @types.Type) @ir.Instr {
	var c @ir.Instr = mkConstInt(v)
	c.Typ = typ
	return c
}

// hasLabel reports whether blk was added as `name` (AddBlock makes each label
// unique by appending "." and the block's index).
func hasLabel(blk @ir.Block, name *[]readonly char) bool {
	var n int = len(name)
	return len(blk.Label) > n && blk.Label[n] == '.' && seq(blk.Label[:n], name)
}

// boolParam returns an OP_PARAM bool value of f (a non-constant condition), not
// placed in any block.
func boolParam(f @ir.Func) @ir.Instr {
	var p @ir.Instr = make(ir.Instr)
	p.ID = ir.AllocValueID(f)
	p.Op = iropcode.OP_PARAM
	p.Typ = types.TypBool()
	return p
}

// An EQ / NE of two integer constants folds to the constant answer; integers
// are compared at the operand type's width, so a uint8 stored un-normalized as
// -1 equals one stored as 255.  Constants of different widths, or a non-constant
// operand, do not fold.
func TestFoldConstCompareInts() testing.TestResult {
	var eq @ir.Instr = mkBinop(iropcode.OP_EQ, mkConstInt(cast(int64, 3)), mkConstInt(cast(int64, 3)))
	if !foldConstCompare(eq) || eq.Op != iropcode.OP_CONST_BOOL || !eq.BoolVal || len(eq.Args) != 0 {
		return fail("3 == 3 should fold to true")
	}
	var ne @ir.Instr = mkBinop(iropcode.OP_NE, mkConstInt(cast(int64, 3)), mkConstInt(cast(int64, 4)))
	if !foldConstCompare(ne) || !ne.BoolVal {
		return fail("3 != 4 should fold to true")
	}
	var eqFalse @ir.Instr = mkBinop(iropcode.OP_EQ, mkConstInt(cast(int64, 3)),
			mkConstInt(cast(int64, 4)))
	if !foldConstCompare(eqFalse) || eqFalse.BoolVal {
		return fail("3 == 4 should fold to false")
	}
	var u8 @ir.Instr = mkBinop(iropcode.OP_EQ, constOfType(cast(int64, -1), types.TypUint8()),
			constOfType(cast(int64, 255), types.TypUint8()))
	if !foldConstCompare(u8) || !u8.BoolVal {
		return fail("uint8 -1 == 255 should fold to true at the type's width")
	}
	var mixed @ir.Instr = mkBinop(iropcode.OP_EQ, constOfType(cast(int64, 1), types.TypInt8()),
			constOfType(cast(int64, 1), types.TypInt64()))
	if foldConstCompare(mixed) || mixed.Op != iropcode.OP_EQ {
		return fail("constants of different widths must not fold")
	}
	var x @ir.Instr = make(ir.Instr)
	x.ID = 1
	x.Op = iropcode.OP_PARAM
	x.Typ = types.TypInt()
	var nonConst @ir.Instr = mkBinop(iropcode.OP_EQ, x, mkConstInt(cast(int64, 3)))
	if foldConstCompare(nonConst) || nonConst.Op != iropcode.OP_EQ {
		return fail("a non-constant operand must not fold")
	}
	var lt @ir.Instr = mkBinop(iropcode.OP_LT, mkConstInt(cast(int64, 3)), mkConstInt(cast(int64, 4)))
	if foldConstCompare(lt) {
		return fail("only EQ / NE fold")
	}
	return ""
}

// Bools compare by value and two nils are equal.
func TestFoldConstCompareBoolsAndNil() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var t @ir.Instr = irbuild.EmitConstBool(b, true)
	var fl @ir.Instr = irbuild.EmitConstBool(b, false)
	var ne @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_NE, t, fl, types.TypBool())
	if !foldConstCompare(ne) || !ne.BoolVal {
		return fail("true != false should fold to true")
	}
	var ptr @types.Type = types.MakeManagedPtrType(nil)
	var n1 @ir.Instr = irbuild.EmitConstNil(b, ptr)
	var n2 @ir.Instr = irbuild.EmitConstNil(b, ptr)
	var eq @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_EQ, n1, n2, types.TypBool())
	if !foldConstCompare(eq) || !eq.BoolVal {
		return fail("nil == nil should fold to true")
	}
	return ""
}

// diamond builds entry -(cond)-> then / else -> merge, where merge has a phi of
// thenVal (from then) and elseVal (from else) that it returns.  else goes
// through elseMore first when viaMore is set.
func diamond(f @ir.Func, cond bool, viaMore bool) @ir.Instr {
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var elseMore @ir.Block = elseB
	if viaMore {
		elseMore = ir.AddBlock(f, "else_more")
	}
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var c @ir.Instr = irbuild.EmitConstBool(entry, cond)
	irbuild.EmitBranch(entry, c, thenB, elseB)
	var thenVal @ir.Instr = irbuild.EmitConstInt(thenB, 1, types.TypInt())
	irbuild.EmitJump(thenB, merge)
	var elseVal @ir.Instr = irbuild.EmitConstInt(elseB, 2, types.TypInt())
	if viaMore {
		irbuild.EmitJump(elseB, elseMore)
	}
	irbuild.EmitJump(elseMore, merge)
	var phi @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), onePhiEntry(thenB, thenVal))
	addPhiEntry(phi, elseMore, elseVal)
	irbuild.EmitReturn(merge, oneRet(phi))
	return phi
}

// A branch on constant true becomes a jump to its then-target; the else arm is
// removed, and so is its entry in the merge's phi.
func TestFoldConstBranchTrue() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var phi @ir.Instr = diamond(f, true, false)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 3 {
		return fail("the else block should be removed")
	}
	var term @ir.Instr = f.Blocks[0].Instrs[len(f.Blocks[0].Instrs) - 1]
	if term.Op != iropcode.OP_JUMP || term.Block1 != f.Blocks[1] || term.Block2 != nil ||
			len(term.Args) != 0 {
		return fail("the entry should end in a jump to the then block")
	}
	if !hasLabel(f.Blocks[1], "then") || !hasLabel(f.Blocks[2], "merge") {
		return fail("the surviving blocks should be entry, then, merge")
	}
	if len(phi.Phis) != 1 || phi.Phis[0].Block != f.Blocks[1] ||
			phi.Phis[0].Val.IntVal != cast(int64, 1) {
		return fail("the phi should keep only the then entry")
	}
	if countOp(f, iropcode.OP_CONST_BOOL) != 0 {
		return fail("the unused branch condition should be removed")
	}
	return ""
}

// A branch on constant false takes its else-target; a dead chain of blocks
// (then, reached only from the folded branch) goes, and the phi entry of the
// chain's last block is dropped.
func TestFoldConstBranchFalseDropsDeadChain() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var phi @ir.Instr = diamond(f, false, true)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 4 {
		return fail("only the then block should be removed")
	}
	if !hasLabel(f.Blocks[1], "else") || !hasLabel(f.Blocks[2], "else_more") {
		return fail("the else chain should survive")
	}
	if len(phi.Phis) != 1 || phi.Phis[0].Block != f.Blocks[2] ||
			phi.Phis[0].Val.IntVal != cast(int64, 2) {
		return fail("the phi should keep only the else_more entry")
	}
	return ""
}

// ifThenMerge builds the shape mem2reg leaves for `x := 0; if cond { x = 1 }`:
// entry -(cond)-> then / merge, then -> merge, and merge's phi
// [entry: 0, then: 1] returned.
func ifThenMerge(f @ir.Func, cond bool) @ir.Instr {
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var x0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, cond), thenB, merge)
	var x1 @ir.Instr = irbuild.EmitConstInt(thenB, 1, types.TypInt())
	irbuild.EmitJump(thenB, merge)
	var phi @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), onePhiEntry(entry, x0))
	addPhiEntry(phi, thenB, x1)
	irbuild.EmitReturn(merge, oneRet(phi))
	return phi
}

// `if true`: the merge block stays reachable (through then) but loses its edge
// from entry, so the fold itself must drop entry's phi entry.
func TestFoldConstBranchDropsEdgeFromReachableMerge() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var phi @ir.Instr = ifThenMerge(f, true)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 3 || !hasLabel(f.Blocks[2], "merge") {
		return fail("every block should survive")
	}
	var term @ir.Instr = f.Blocks[0].Instrs[len(f.Blocks[0].Instrs) - 1]
	if term.Op != iropcode.OP_JUMP || term.Block1 != f.Blocks[1] {
		return fail("the entry should end in a jump to the then block")
	}
	if len(phi.Phis) != 1 || phi.Phis[0].Block != f.Blocks[1] ||
			phi.Phis[0].Val.IntVal != cast(int64, 1) {
		return fail("the phi should keep only the then entry")
	}
	return ""
}

// `if false`: then becomes unreachable and is removed, and with it its entry in
// the merge's phi; entry's entry stays.
func TestFoldConstBranchFalseKeepsEdgeToMerge() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var phi @ir.Instr = ifThenMerge(f, false)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 2 || !hasLabel(f.Blocks[1], "merge") {
		return fail("the then block should be removed")
	}
	if len(phi.Phis) != 1 || phi.Phis[0].Block != f.Blocks[0] ||
			phi.Phis[0].Val.IntVal != cast(int64, 0) {
		return fail("the phi should keep only the entry entry")
	}
	return ""
}

// An unreachable cycle (a loop only the folded arm entered) is removed whole.
func TestFoldConstBranchRemovesDeadLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, false), loop, exit)
	irbuild.EmitBranch(loop, boolParam(f), body, exit)
	irbuild.EmitJump(body, loop)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 2 || !hasLabel(f.Blocks[1], "exit") {
		return fail("the dead loop should be removed, leaving entry and exit")
	}
	return ""
}

// A branch on a non-constant, and a function with no constant branch, are left
// alone.
func TestFoldBranchLeavesNonConstant() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	irbuild.EmitBranch(entry, boolParam(f), a, b)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(a, noRet)
	irbuild.EmitReturn(b, noRet)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 3 || countOp(f, iropcode.OP_BRANCH) != 1 {
		return fail("a branch on a non-constant must stay")
	}
	return ""
}

// releaseOfFuncValue builds the release IR-gen emits for a managed function
// value (emitManagedFuncValueRefDec): extract the data word, compare it with
// nil, and RefDec it through the value's dtor when non-nil.
func releaseOfFuncValue(f @ir.Func) {
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var noP @[]@types.Param
	var noR @[]@types.Type
	var fv @ir.Instr = irbuild.EmitFuncValue(entry, "g", types.MakeManagedFuncValueType(noP, noR))
	var ptr @types.Type = types.MakeManagedPtrType(nil)
	var data @ir.Instr = irbuild.EmitExtract(entry, fv, types.FuncValueDataIndex(), ptr)
	var isNull @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_EQ, data,
			irbuild.EmitConstNil(entry, ptr), types.TypBool())
	var dec @ir.Block = ir.AddBlock(f, "fv_refdec")
	var cont @ir.Block = ir.AddBlock(f, "fv_refdec_cont")
	irbuild.EmitBranch(entry, isNull, cont, dec)
	var dtor @ir.Instr = irbuild.EmitFuncValueDtor(dec, fv)
	irbuild.EmitRefDecDtor(dec, data, dtor)
	irbuild.EmitJump(dec, cont)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(cont, noRet)
}

// With NullFuncValueData the release of a non-capturing function value folds
// away: no compare, no branch, no RefDec block.
func TestFoldBranchNullFuncValueData() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	releaseOfFuncValue(f)
	foldBranchesFunc(f, true)
	if len(f.Blocks) != 2 || !hasLabel(f.Blocks[1], "fv_refdec_cont") {
		return fail("the RefDec block should be removed")
	}
	if countOp(f, iropcode.OP_EQ) != 0 || countOp(f, iropcode.OP_BRANCH) != 0 ||
			countOp(f, iropcode.OP_REFDEC) != 0 || countOp(f, iropcode.OP_EXTRACT) != 0 {
		return fail("the data extract, compare, branch and RefDec should all be gone")
	}
	return ""
}

// Without NullFuncValueData (the VM, whose data word is the callee's closure
// record) the release is left alone.
func TestFoldBranchKeepsFuncValueReleaseWithoutNullData() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	releaseOfFuncValue(f)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 3 || countOp(f, iropcode.OP_BRANCH) != 1 ||
			countOp(f, iropcode.OP_REFDEC) != 1 {
		return fail("the release must be kept when the data word is not known null")
	}
	return ""
}
