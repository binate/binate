package "pkg/binate/iropt"

import "pkg/binate/types"
import "pkg/builtins/testing"

// setTgt configures a target with the given int width (in bytes) for a
// fusibleResultType check, using fixed-width operand types so the result does
// not depend on the `int` singleton's target-sensitive width.
func setTgt(intSize int) {
	var t types.TargetInfo
	t.PointerSize = intSize
	t.IntSize = intSize
	t.MaxAlign = intSize
	types.SetTarget(t)
}

// On a 64-bit target the fused multiply-add is a single 64-bit instruction, so a
// full-width 64-bit integer fuses; a sub-word (int32) result would need
// narrowing and is excluded; a float result is never an integer madd.
func TestFusibleResultType64() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTgt(8)
	var i64 bool = fusibleResultType(types.TypInt64())
	var i32 bool = fusibleResultType(types.TypInt32())
	var f64 bool = fusibleResultType(types.TypFloat64())
	types.SetTarget(saved)
	if !i64 {
		return "int64 must fuse on a 64-bit target"
	}
	if i32 {
		return "a sub-word int32 result must not fuse (it would need narrowing)"
	}
	if f64 {
		return "a float result must not fuse into an integer madd"
	}
	return ""
}

// On a 32-bit target (arm32) a 64-bit integer is a register pair with no
// single-instruction multiply-add, so it must NOT fuse; a full-width 32-bit
// integer does.
func TestFusibleResultType32() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTgt(4)
	var i64 bool = fusibleResultType(types.TypInt64())
	var i32 bool = fusibleResultType(types.TypInt32())
	types.SetTarget(saved)
	if i64 {
		return "int64 must NOT fuse on a 32-bit target (no single-instruction madd)"
	}
	if !i32 {
		return "a full-width 32-bit integer must fuse on a 32-bit target"
	}
	return ""
}
