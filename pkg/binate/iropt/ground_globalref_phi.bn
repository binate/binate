package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/stdx/slices"

// Ground global-address pseudos used as phi operands.  A global's address `&G`
// is represented as an OP_ALLOC pseudo with IsGlobalRef and SSA id -1 — the
// backend materializes it (ADRP+ADD / equivalent) at each use, so it never
// occupies an SSA register.  That is a valid operand for a direct use, but NOT
// for an OP_PHI: a phi operand must be a real SSA value, and an id -1 prints as
// the invalid `%v-1` (the LLVM backend rejects the whole module; the native
// backends and the VM silently accept a WRONG value from the malformed phi).
//
// Such an operand arises when a global address is stored into a promotable
// pointer slot inside a loop and the forwarding passes (mem2reg /
// load-forwarding) carry the pseudo into a loop-header phi — e.g. an inlined
// multi-return `p, q = f(&gx, &gy)` whose tuple slot SROA splits into per-field
// pointer slots.  Rather than teach each forwarding pass to avoid it, this final
// cleanup GROUNDS every such operand: it materializes the address once as a real
// SSA value (an identity OP_BIT_CAST of the pseudo) in the function entry block —
// the address is loop-invariant, so one materialization dominates every use and
// there is no per-iteration cost — and repoints the phi operands at it.
//
// Runs LAST in RunOptPasses, after every pass that could introduce such an
// operand; it only repoints phi operands and inserts entry-block instrs, so no
// later pass disturbs it.

// groundGlobalRefPhiOperands runs the grounding over every non-extern func.
func groundGlobalRefPhiOperands(m @ir.Module) {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern || len(f.Blocks) == 0 {
			continue
		}
		groundGlobalRefPhiOperandsFunc(f)
	}
}

// groundGlobalRefPhiOperandsFunc grounds f's global-ref phi operands: it repoints
// each to a per-pseudo identity bit-cast materialized in the entry block.
func groundGlobalRefPhiOperandsFunc(f @ir.Func) {
	var refs @[]@ir.Instr // distinct global-ref pseudos seen as a phi operand
	var grounds @[]@ir.Instr // parallel: the grounding bit-cast for each
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if instr.Op != iropcode.OP_PHI {
				continue
			}
			for pi := 0; pi < len(instr.Phis); pi++ {
				var v @ir.Instr = instr.Phis[pi].Val
				if v == nil || v.ID >= 0 || !v.IsGlobalRef {
					continue
				}
				var g @ir.Instr = lookupGrounding(refs, grounds, v)
				if g == nil {
					// An identity same-type bit_cast (ptr -> ptr) materializes the
					// pseudo as a real SSA pointer value.  TypeArg is the dest type
					// the codegen reads (a nil TypeArg would misclassify the cast as
					// ptr->int and emit `ptrtoint`, an i64) — set it like EmitBitCast.
					g = ir.NewInstr(f, iropcode.OP_BIT_CAST, v.Typ)
					g.TypeArg = v.Typ
					g.Args = ir.MakeArgs1(v)
					refs = slices.Append[@ir.Instr](refs, v)
					grounds = slices.Append[@ir.Instr](grounds, g)
				}
				instr.Phis[pi].Val = g
			}
		}
	}
	if len(grounds) == 0 {
		return
	}
	insertBeforeTerminator(f.Blocks[0], grounds)
}

// lookupGrounding returns the grounding already created for pseudo v (matched by
// pointer identity), or nil.
func lookupGrounding(refs @[]@ir.Instr, grounds @[]@ir.Instr, v @ir.Instr) @ir.Instr {
	for k := 0; k < len(refs); k++ {
		if refs[k] == v {
			return grounds[k]
		}
	}
	var none @ir.Instr
	return none
}

// insertBeforeTerminator splices `add` into blk just before its terminator (the
// last instr in well-formed IR), so the inserted values dominate every exit edge
// while staying after the block's own computation.
func insertBeforeTerminator(blk @ir.Block, add @[]@ir.Instr) {
	var n int = len(blk.Instrs)
	if n == 0 {
		return
	}
	var kept @[]@ir.Instr
	for ii := 0; ii < n - 1; ii++ {
		kept = slices.Append[@ir.Instr](kept, blk.Instrs[ii])
	}
	for k := 0; k < len(add); k++ {
		kept = slices.Append[@ir.Instr](kept, add[k])
	}
	kept = slices.Append[@ir.Instr](kept, blk.Instrs[n - 1])
	blk.Instrs = kept
}
