package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for grounding global-address pseudos used as phi operands
// (ground_globalref_phi.bn).

// makeGlobalRefPseudo builds the `&G` pseudo the IR uses for a global address:
// an OP_ALLOC with IsGlobalRef and SSA id -1, typed *elemTyp.
func makeGlobalRefPseudo(elemTyp @types.Type) @ir.Instr {
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.Op = iropcode.OP_ALLOC
	g.IsGlobalRef = true
	g.Typ = types.MakePointerType(elemTyp)
	g.TypeArg = elemTyp
	return g
}

// A global-ref (id -1) phi operand is repointed to a real-SSA identity bit-cast
// materialized in the entry block.
func TestGroundGlobalRefPhiOperand() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var gref @ir.Instr = makeGlobalRefPseudo(types.TypInt())

	irbuild.EmitJump(entry, loop)
	var ent @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	ent[0].Block = entry
	ent[0].Val = gref
	var phi @ir.Instr = irbuild.EmitPhi(loop, ptrTyp, ent)
	irbuild.EmitReturn(loop, noArgs)

	groundGlobalRefPhiOperandsFunc(f)

	var v @ir.Instr = phi.Phis[0].Val
	if v == nil || v == gref || v.ID < 0 || v.Op != iropcode.OP_BIT_CAST {
		return fail("the global-ref phi operand must be grounded to a real-SSA bit_cast")
	}
	if len(v.Args) < 1 || v.Args[0] != gref {
		return fail("the grounding bit_cast must wrap the original global-ref")
	}
	var inEntry bool = false
	for ii := 0; ii < len(entry.Instrs); ii++ {
		if entry.Instrs[ii] == v {
			inEntry = true
		}
	}
	if !inEntry {
		return fail("the grounding must be inserted in the entry block")
	}
	return ""
}

// Two phi operands referencing the SAME global-ref pseudo share ONE grounding.
func TestGroundGlobalRefPhiOperandDeduped() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var gref @ir.Instr = makeGlobalRefPseudo(types.TypInt())

	irbuild.EmitJump(entry, loop)
	var e1 @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	e1[0].Block = entry
	e1[0].Val = gref
	var phi1 @ir.Instr = irbuild.EmitPhi(loop, ptrTyp, e1)
	var e2 @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	e2[0].Block = entry
	e2[0].Val = gref
	var phi2 @ir.Instr = irbuild.EmitPhi(loop, ptrTyp, e2)
	irbuild.EmitReturn(loop, noArgs)

	groundGlobalRefPhiOperandsFunc(f)

	if phi1.Phis[0].Val != phi2.Phis[0].Val {
		return fail("two phi operands of the same global-ref must share one grounding")
	}
	if countOp(f, iropcode.OP_BIT_CAST) != 1 {
		return fail("exactly one grounding bit_cast should be created for the shared global-ref")
	}
	return ""
}

// A non-global-ref phi operand (a real SSA value) is left untouched.
func TestGroundGlobalRefPhiOperandLeavesRealValues() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var real @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	irbuild.EmitJump(entry, loop)
	var ent @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	ent[0].Block = entry
	ent[0].Val = real
	var phi @ir.Instr = irbuild.EmitPhi(loop, types.TypInt(), ent)
	irbuild.EmitReturn(loop, noArgs)

	groundGlobalRefPhiOperandsFunc(f)

	if phi.Phis[0].Val != real {
		return fail("a real-SSA phi operand must be left unchanged")
	}
	if countOp(f, iropcode.OP_BIT_CAST) != 0 {
		return fail("no grounding should be created when no operand is a global-ref")
	}
	return ""
}
