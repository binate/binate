package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// intResults1 builds a one-result (int) result list for a test func.
func intResults1() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt()
	return r
}

// countOpInBlock counts instructions with opcode `op` in `blk`.
func countOpInBlock(blk @ir.Block, op int) int {
	var n int = 0
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i].Op == op {
			n = n + 1
		}
	}
	return n
}

// TestInlineSimpleNoParamCall: `func k() int { return 42 }` called by
// `func caller() int { return k() }` — the call is spliced away, the const 42
// lands in the caller, and the return is retargeted to it.
func TestInlineSimpleNoParamCall() testing.TestResult {
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var cb @ir.Block = ir.AddBlock(callee, "entry")
	var c42 @ir.Instr = cb.EmitConstInt(42, types.TypInt())
	cb.EmitReturn(oneRet(c42))

	var caller @ir.Func = ir.NewFunc("", "caller", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var noArgs @[]@ir.Instr
	var callRes @ir.Instr = eb.EmitCall("k", noArgs, types.TypInt())
	eb.EmitReturn(oneRet(callRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_CALL) != 1 {
		return fail("setup: expected one call")
	}
	inlineCalls(m)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_CALL) != 0 {
		return fail("the call should be inlined away")
	}
	if countOpInBlock(caller.Blocks[0], iropcode.OP_CONST_INT) < 1 {
		return fail("the callee body (const 42) should be spliced into the caller")
	}
	// The return's value must be retargeted to the spliced const, not the
	// deleted call result.
	var last @ir.Instr = caller.Blocks[0].Instrs[len(caller.Blocks[0].Instrs) - 1]
	if last.Op != iropcode.OP_RETURN || len(last.Args) < 1 {
		return fail("expected a return with a value")
	}
	if last.Args[0].Op != iropcode.OP_CONST_INT || last.Args[0].IntVal != cast(int64, 42) {
		return fail("return value should be retargeted to the spliced const 42")
	}
	return ""
}

// countCallsTo counts OP_CALLs in `blk` whose target name is `name`.
func countCallsTo(blk @ir.Block, name *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i].Op == iropcode.OP_CALL && seq(blk.Instrs[i].StrVal, name) {
			n = n + 1
		}
	}
	return n
}

// TestInlineNonLeafCalleeInlined: a single-block callee `k3` that itself
// contains a direct call (to `someOther`, which is NOT a module func, so it stays
// a call) IS inlined — its body, including the cloned `someOther` call, is spliced
// into the caller.  After inlining, the caller has no `k3` call but does carry the
// cloned `someOther` call.  (`someOther` doesn't resolve, so it isn't further
// inlined; it exercises "a non-leaf body's own call is cloned verbatim".)
func TestInlineNonLeafCalleeInlined() testing.TestResult {
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "k3", noParams, intResults1())
	var cb @ir.Block = ir.AddBlock(callee, "entry")
	var noArgs @[]@ir.Instr
	var inner @ir.Instr = cb.EmitCall("someOther", noArgs, types.TypInt())
	cb.EmitReturn(oneRet(inner))

	var caller @ir.Func = ir.NewFunc("", "caller3", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var callRes @ir.Instr = eb.EmitCall("k3", noArgs, types.TypInt())
	eb.EmitReturn(oneRet(callRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	inlineCalls(m)
	if countCallsTo(caller.Blocks[0], "k3") != 0 {
		return fail("a non-leaf callee must be inlined (its k3 call should be gone)")
	}
	if countCallsTo(caller.Blocks[0], "someOther") != 1 {
		return fail("the non-leaf body's own call must be cloned into the caller")
	}
	return ""
}

// TestInlineDropsPairedStackCheck: a call preceded by its OP_STACK_CHECK pre-check
// (the shape genCall emits) is inlined — the post-pass must drop the now-orphaned
// pre-check too, else it would fault spuriously for a frame that is never pushed.
func TestInlineDropsPairedStackCheck() testing.TestResult {
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var cb @ir.Block = ir.AddBlock(callee, "entry")
	var c42 @ir.Instr = cb.EmitConstInt(42, types.TypInt())
	cb.EmitReturn(oneRet(c42))

	var caller @ir.Func = ir.NewFunc("", "caller", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var noArgs @[]@ir.Instr
	eb.EmitStackCheck("k") // the pre-check genCall emits before the call
	var callRes @ir.Instr = eb.EmitCall("k", noArgs, types.TypInt())
	eb.EmitReturn(oneRet(callRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_STACK_CHECK) != 1 {
		return fail("setup: expected one stack-check")
	}
	inlineCalls(m)

	if countOpInBlock(caller.Blocks[0], iropcode.OP_CALL) != 0 {
		return fail("the call should be inlined away")
	}
	if countOpInBlock(caller.Blocks[0], iropcode.OP_STACK_CHECK) != 0 {
		return fail("the orphaned pre-check must be dropped after its call is inlined")
	}
	return ""
}

// TestInlineKeepsUnpairedStackCheck: a pre-check whose call is NOT inlined (the
// callee isn't a module func, so it stays a real call that still pushes a frame)
// must be KEPT — dropping it would reintroduce the moved-arg overflow leak.
func TestInlineKeepsUnpairedStackCheck() testing.TestResult {
	// A leaf module callee so SOME inlining happens (dropOrphanedStackChecks only
	// runs when the function had a call inlined), plus a surviving call to a
	// non-module callee whose pre-check must survive.
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var cb @ir.Block = ir.AddBlock(callee, "entry")
	var c1 @ir.Instr = cb.EmitConstInt(1, types.TypInt())
	cb.EmitReturn(oneRet(c1))

	var caller @ir.Func = ir.NewFunc("", "caller", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var noArgs @[]@ir.Instr
	eb.EmitStackCheck("k")
	eb.EmitCall("k", noArgs, types.TypInt()) // inlined away (with its check)
	eb.EmitStackCheck("someExtern")
	var survRes @ir.Instr = eb.EmitCall("someExtern", noArgs, types.TypInt()) // stays a call
	eb.EmitReturn(oneRet(survRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)
	inlineCalls(m)

	if countCallsTo(caller.Blocks[0], "someExtern") != 1 {
		return fail("the non-module call must stay a real call")
	}
	if countOpInBlock(caller.Blocks[0], iropcode.OP_STACK_CHECK) != 1 {
		return fail("the surviving call's pre-check must be kept (only the inlined k's check dropped)")
	}
	return ""
}
