package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// Inliner eligibility predicates (extracted from inline_calls.bn): the shape
// gate that decides whether a direct OP_CALL's callee may be inlined, plus the
// call-family and result-type classifiers it consults.

// inlinableCallee returns the callee Func if `instr` is a direct OP_CALL that
// qualifies for inlining into f (single- OR multi-block), else nil.  The shape
// requirements: same-package non-extern, not self, not on a direct-call cycle
// (the recursion guard — else the transitive re-scan loops forever), size under
// the threshold (when SROA + mem2reg run, the SROA-adjusted size sroaAdjustedSize
// — the post-inline-SROA op-count estimate, so a SROA-thin aggregate shape scores
// by what it collapses to; otherwise the raw count),
// non-leaf permitted but only via DIRECT OP_CALLs
// (an indirect / iface / c-call in the body still disqualifies, since it
// can't be transitively inlined and its clone is not yet validated), any
// faulting op OR internal call has an empty or single-block cleanup pad (and the
// call site itself has a pad), no phis, at least one OP_RETURN site
// (multiple merge through a slot), every block ends in JUMP/BRANCH/
// RETURN, arity matches, at most one inlinable-typed result (scalar or a
// by-value data aggregate), and every value operand is a param or an
// in-callee value (so it is remappable).  Callers dispatch on len(callee.Blocks):
// Phase 1 handles single-block (splice), Phase 2 multi-block (CFG split).
func inlinableCallee(m @ir.Module, f @ir.Func, ia @inlineAnalysis, instr @ir.Instr) @ir.Func {
	if instr.Op != iropcode.OP_CALL {
		return nil
	}
	var callee @ir.Func = ir.LookupModuleFunc(m, instr.StrVal)
	if callee == nil || callee.IsExtern {
		return nil
	}
	if callee == f {
		return nil // no self-inline
	}
	if ia.isRecursive(callee.Name) {
		return nil // on a direct-call cycle — never inline (would expand forever)
	}
	if len(callee.Params) != len(instr.Args) {
		return nil // arity mismatch (defensive)
	}
	var cf calleeFacts = ia.factsOf(callee)
	if !cf.eligible {
		return nil
	}
	if cf.needsSitePad && instr.PadBlock == nil {
		// A faulting op or internal call in the body chains or reuses the call
		// site's cleanup pad (see computeCalleeFacts), so the site needs one.
		return nil
	}
	// Multiple return sites are handled by the multi-block path's merge slot;
	// a single-block callee always has exactly one return.
	return callee
}

// isCallFamilyOp reports whether op is any call/dispatch op (disqualifies a
// callee from the leaf-body requirement).
func isCallFamilyOp(op int) bool {
	return op == iropcode.OP_CALL || op == iropcode.OP_CALL_INDIRECT || op == iropcode.OP_C_CALL ||
			op == iropcode.OP_CALL_FUNC_VALUE || op == iropcode.OP_CALL_HANDLE ||
			op == iropcode.OP_CALL_IFACE_METHOD || op == iropcode.OP_SAT_LOOKUP
}

// isInlinableResultType reports whether a single result type is one the inliner
// can route through the merge slot / direct retVal: the single-register scalar
// kinds PLUS the by-value DATA aggregates (struct / slice / managed-slice /
// array) that ride sret/retbuf.  At the IR level the OP_RETURN carries
// the aggregate VALUE as Args[0], which flows to the call-result uses exactly
// like a scalar, and OP_STORE/OP_LOAD copy it bit-for-bit through an
// aggregate-typed slot with no implicit refcount.  No managed dtor is dropped:
// the callee's own refcount ops are cloned verbatim (the non-leaf path clones a
// direct OP_CALL dtor faithfully too), and a dtor dispatched via a handle/iface call
// (OP_CALL_HANDLE etc.) or a branching managed-slice/iface cleanup keeps the
// callee non-inlinable (the non-direct-call gate / the multi-block-pad gate).
// EXCLUDED: func-value / iface-value results (their cross-mode vtable
// substitution is not handled) and a TYP_NAMED peelTransparent could not resolve
// (nil Underlying).  Default-reject so a future kind can't slip through as an
// unhandled register value.  char/uint8/int32/... are all TYP_INT with a width.
func isInlinableResultType(t @types.Type) bool {
	if t == nil {
		return false
	}
	var r @types.Type = irutil.PeelTransparent(t)
	if r == nil {
		return false
	}
	return r.Kind == types.TYP_INT || r.Kind == types.TYP_FLOAT || r.Kind == types.TYP_BOOL ||
			r.Kind == types.TYP_POINTER || r.Kind == types.TYP_MANAGED_PTR || r.Kind == types.TYP_STRUCT ||
			r.Kind == types.TYP_SLICE || r.Kind == types.TYP_MANAGED_SLICE || r.Kind == types.TYP_ARRAY
}
