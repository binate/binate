package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the per-callee inlining facts cache (inline_facts.bn).

// factsModule builds a module with a small single-block callee `k`.
func factsModule() (@ir.Module, @ir.Func) {
	var k @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var kb @ir.Block = ir.AddBlock(k, "entry")
	irbuild.EmitReturn(kb, oneRet(irbuild.EmitConstInt(kb, 42, types.TypInt())))
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(k)
	return m, k
}

// Facts are cached until invalidated: growing the callee past the threshold is
// seen only after invalidateFacts (which the inliner calls on every function it
// inlines into).
func TestCalleeFactsCachedUntilInvalidated() testing.TestResult {
	var m @ir.Module
	var k @ir.Func
	m, k = factsModule()
	var ia @inlineAnalysis = computeRecursiveFuncs(m)
	ia.threshold = DEFAULT_INLINE_THRESHOLD
	ia.sroaDiscount = true
	var before calleeFacts = ia.factsOf(k)
	if !before.eligible || before.rawSize != 2 { return fail("k: eligible, size 2") }
	// Grow k's body well past the threshold: emit consts (appended after the
	// return), then move the return back to the end.
	var kb @ir.Block = k.Blocks[0]
	var ret @ir.Instr = kb.Instrs[len(kb.Instrs) - 1]
	for i := 0; i < DEFAULT_INLINE_THRESHOLD + 5; i++ {
		irbuild.EmitConstInt(kb, i, types.TypInt())
	}
	var body @[]@ir.Instr = make_slice(@ir.Instr, len(kb.Instrs))
	var n int = 0
	for i := 0; i < len(kb.Instrs); i++ {
		if kb.Instrs[i] != ret {
			body[n] = kb.Instrs[i]
			n = n + 1
		}
	}
	body[n] = ret
	kb.Instrs = body
	if !ia.factsOf(k).eligible {
		return fail("cached facts must not be recomputed before invalidation")
	}
	ia.invalidateFacts(k)
	var after calleeFacts = ia.factsOf(k)
	if after.eligible { return fail("after invalidation the grown k is over the threshold") }
	if after.rawSize <= before.rawSize {
		return fail("after invalidation rawSize reflects the growth")
	}
	return ""
}

// A callee the analysis snapshot doesn't know (added to m.Funcs afterwards) has
// no cache slot but is still evaluated.
func TestCalleeFactsUnknownFuncHasNoSlot() testing.TestResult {
	var m @ir.Module
	var k @ir.Func
	m, k = factsModule()
	var ia @inlineAnalysis = computeRecursiveFuncs(m)
	ia.threshold = DEFAULT_INLINE_THRESHOLD
	var j @ir.Func = ir.NewFunc("", "j", noParams, intResults1())
	var jb @ir.Block = ir.AddBlock(j, "entry")
	irbuild.EmitReturn(jb, oneRet(irbuild.EmitConstInt(jb, 1, types.TypInt())))
	if ia.factsSlot(j) != -1 { return fail("j has no cache slot") }
	if !ia.factsOf(j).eligible { return fail("j is still evaluated") }
	if ia.factsSlot(k) < 0 { return fail("k has a cache slot") }
	return ""
}

// sizedIntFunc builds `name` returning int: `nConst` consts, then (if callee is
// non-empty) a call to callee whose result is returned, else the last const.
func sizedIntFunc(name @[]char, nConst int, callee *[]readonly char) @ir.Func {
	var f @ir.Func = ir.NewFunc("", name, noParams, intResults1())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var last @ir.Instr
	for i := 0; i < nConst; i++ {
		last = irbuild.EmitConstInt(b, i, types.TypInt())
	}
	if len(callee) > 0 {
		last = irbuild.EmitCall(b, callee, noArgs, types.TypInt())
	}
	irbuild.EmitReturn(b, oneRet(last))
	return f
}

// Through the whole pass: `a` calls `f` first, caching f's facts while f is
// small (10 consts + a call to h + return = 12).  Inlining h (8 consts) into f
// then grows it to 19, over the threshold, so `g`, processed after f, must see
// f as ineligible and keep its call — only true if the pass invalidates f's
// cached facts after inlining into it.
func TestInlinePassInvalidatesGrownCallee() testing.TestResult {
	var a @ir.Func = sizedIntFunc("a", 0, "f")
	var f @ir.Func = sizedIntFunc("f", 10, "h")
	var g @ir.Func = sizedIntFunc("g", 0, "f")
	var h @ir.Func = sizedIntFunc("h", 8, "")
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(a)
	m.AddFunc(f)
	m.AddFunc(g)
	m.AddFunc(h)
	inlineCalls(m, DEFAULT_INLINE_THRESHOLD, true)
	if countOp(a, iropcode.OP_CALL) != 0 { return fail("a: the small f (and then h) inline") }
	if countOp(f, iropcode.OP_CALL) != 0 { return fail("f: h inlines") }
	if countOp(g, iropcode.OP_CALL) != 1 {
		return fail("g: f grew past the threshold, so its call must stay")
	}
	return ""
}

// needsSitePad is per call site: a callee whose bounds check carries an (empty)
// cleanup pad inlines at a call site that has a pad, and not at one that has
// none — with one analysis, so both sites share the callee's cached facts.
func TestInlineNeedsSitePadPerCallSite() testing.TestResult {
	var k @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var kb @ir.Block = ir.AddBlock(k, "entry")
	var i0 @ir.Instr = irbuild.EmitConstInt(kb, 0, types.TypInt())
	var n2 @ir.Instr = irbuild.EmitConstInt(kb, 2, types.TypInt())
	irbuild.EmitBoundsCheck(kb, i0, n2)
	var kpad @ir.Block = ir.AddFaultPad(k, "kpad")
	irbuild.EmitUnwindReturn(kpad)
	kb.Instrs[len(kb.Instrs) - 1].PadBlock = kpad
	irbuild.EmitReturn(kb, oneRet(i0))
	var withPad @ir.Func = sizedIntFunc("withPad", 0, "k")
	var sitePad @ir.Block = ir.AddFaultPad(withPad, "sitepad")
	irbuild.EmitUnwindReturn(sitePad)
	withPad.Blocks[0].Instrs[0].PadBlock = sitePad
	var noPad @ir.Func = sizedIntFunc("noPad", 0, "k")
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(k)
	m.AddFunc(withPad)
	m.AddFunc(noPad)
	var ia @inlineAnalysis = computeRecursiveFuncs(m)
	ia.threshold = DEFAULT_INLINE_THRESHOLD
	ia.sroaDiscount = true
	if inlinableCallee(m, withPad, ia, withPad.Blocks[0].Instrs[0]) != k {
		return fail("a padded call site inlines k")
	}
	if inlinableCallee(m, noPad, ia, noPad.Blocks[0].Instrs[0]) != nil {
		return fail("a call site without a pad must not inline k")
	}
	if !ia.factsOf(k).needsSitePad { return fail("k's facts record that it needs a site pad") }
	return ""
}

// Facts computed under one size gate are recomputed under another.
func TestCalleeFactsFollowThreshold() testing.TestResult {
	var m @ir.Module
	var k @ir.Func
	m, k = factsModule()
	var ia @inlineAnalysis = computeRecursiveFuncs(m)
	ia.threshold = DEFAULT_INLINE_THRESHOLD
	if !ia.factsOf(k).eligible { return fail("k fits the default threshold") }
	ia.threshold = 1
	if ia.factsOf(k).eligible { return fail("k (size 2) is over a threshold of 1") }
	return ""
}
