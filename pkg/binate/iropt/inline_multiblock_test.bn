package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the multi-block inliner path (inline_multiblock.bn).  Helpers
// (intResults1, countOpInBlock in inline_calls_test.bn; countOpInFunc in
// gen_assign_multi_test.bn; oneRet in ir_phi_elim_test.bn) are package-shared.

// TestInlineMultiBlockCallee: a two-block, single-return callee is
// inlined via a CFG split — the call is gone and the caller gains blocks (the
// pre-call part jumps to the cloned entry; the cloned return jumps to a
// continuation).
func TestInlineMultiBlockCallee() testing.TestResult {
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "k2", noParams, intResults1())
	var b0 @ir.Block = ir.AddBlock(callee, "entry")
	var b1 @ir.Block = ir.AddBlock(callee, "next")
	irbuild.EmitJump(b0, b1)
	var c @ir.Instr = irbuild.EmitConstInt(b1, 7, types.TypInt())
	irbuild.EmitReturn(b1, oneRet(c))

	var caller @ir.Func = ir.NewFunc("", "caller2", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var noArgs @[]@ir.Instr
	var callRes @ir.Instr = irbuild.EmitCall(eb, "k2", noArgs, types.TypInt())
	irbuild.EmitReturn(eb, oneRet(callRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	var blocksBefore int = len(caller.Blocks)
	inlineCalls(m)
	if countOpInFunc(caller, iropcode.OP_CALL) != 0 {
		return fail("a multi-block single-return callee should be inlined")
	}
	if len(caller.Blocks) <= blocksBefore {
		return fail("inlining a multi-block callee should split/add caller blocks")
	}
	// The callee body (const 7) should be cloned into the caller, and every
	// value-producing instr must have a unique ID (the assertInlinedFuncWellFormed
	// post-condition runs inside inlineCalls and would have panicked otherwise).
	if countOpInFunc(caller, iropcode.OP_CONST_INT) < 1 {
		return fail("the callee body (const 7) should be cloned into the caller")
	}
	return ""
}

// TestInlineMultiBlockCalleeTooBigSkipped: a multi-block callee over the size
// threshold is not inlined (its call remains).
func TestInlineMultiBlockCalleeTooBigSkipped() testing.TestResult {
	var noParams @[]@ir.Param
	var callee @ir.Func = ir.NewFunc("", "big2", noParams, intResults1())
	var b0 @ir.Block = ir.AddBlock(callee, "entry")
	var b1 @ir.Block = ir.AddBlock(callee, "next")
	// Pad b0 with more than InlineSizeThreshold const instrs before the jump.
	for i := 0; i < InlineSizeThreshold + 2; i++ {
		var tmp @ir.Instr = irbuild.EmitConstInt(b0, i, types.TypInt())
		_ = tmp
	}
	irbuild.EmitJump(b0, b1)
	var c @ir.Instr = irbuild.EmitConstInt(b1, 1, types.TypInt())
	irbuild.EmitReturn(b1, oneRet(c))

	var caller @ir.Func = ir.NewFunc("", "callerBig", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var noArgs @[]@ir.Instr
	var callRes @ir.Instr = irbuild.EmitCall(eb, "big2", noArgs, types.TypInt())
	irbuild.EmitReturn(eb, oneRet(callRes))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)

	inlineCalls(m)
	if countOpInFunc(caller, iropcode.OP_CALL) != 1 {
		return fail("a multi-block callee over InlineSizeThreshold must not be inlined")
	}
	return ""
}
