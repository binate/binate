package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/stdx/slices"

// Fault-pad handling for the inliner.  A recoverable fault op
// (bounds/div/shift/nil check) carries a cleanup PAD that the VM runs on a
// fault: it RefDecs the managed values live at the fault, then OP_UNWIND_RETURN
// unwinds the frame (dispatching the fault onward to the caller's call-site
// pad).  Compiled backends ignore pads (abort on fault); only the VM uses them.
//
// Inlining a fault-containing callee collapses callee+caller into ONE frame, so
// a fault at a cloned op must run BOTH the callee-side cleanup AND the caller's
// call-site cleanup, then unwind ONCE.  Two cases:
//   * EMPTY callee pad (no managed value live at the fault -> just
//     OP_UNWIND_RETURN): no callee cleanup to preserve, so the cloned op reuses
//     the caller's call-site pad directly — cloneInstrFields sets
//     PadBlock = callSitePad.
//   * NON-EMPTY single-block callee pad (managed-ptr local/param live at the
//     fault -> straight-line RefDecs then OP_UNWIND_RETURN): the pad is cloned
//     into the caller's FaultPads with its RefDec operands remapped to the
//     cloned callee values, and its terminal OP_UNWIND_RETURN replaced by an
//     OP_JUMP into the caller's call-site pad — chaining callee cleanup ->
//     caller cleanup -> a single unwind.  The RefDec sequence is a
//     faithful clone of the callee pad's, so refcounting balances by
//     construction (same ops, same order, one fewer frame pop).
// Multi-block pads (an iface / func-value RefDec, or the stack-overflow
// pre-check's pad, branches on a null-data guard into further pad blocks) ARE
// handled:
// cloneInlinablePad clones the whole pad sub-CFG (every block reachable from the
// entry via BRANCH/JUMP), remapping both operands and branch targets, and rewrites
// every terminal OP_UNWIND_RETURN into an OP_JUMP into the call-site pad — so the
// chained cleanup still ends in a single unwind.
//
// PadBlock is a raw `*Block` back-ref (it breaks the Instr->Block->Instr
// refcount cycle), but a block CFG target (Block1) is a managed `@Block`, so the
// cloned pad's chain-jump needs the call-site pad's @Block handle — recovered
// from Func.FaultPads by payload-address identity (faultPadHandle).

// isEmptyPad reports whether a fault pad is empty — exactly one instr, the
// terminal OP_UNWIND_RETURN — i.e. no managed value was live at the fault, so
// there is no callee-side cleanup to clone (the direct-reuse case).
func isEmptyPad(pad *ir.Block) bool {
	return len(pad.Instrs) == 1 && pad.Instrs[0].Op == iropcode.OP_UNWIND_RETURN
}

// containsAddr reports whether the payload-address `a` is already in `addrs`.
func containsAddr(addrs @[]int, a int) bool {
	for i := 0; i < len(addrs); i++ {
		if addrs[i] == a {
			return true
		}
	}
	return false
}

// addrInFaultPads reports whether `addr` is the payload address of one of
// callee's fault-pad blocks (identity by address, the faultPadHandle idiom).
func addrInFaultPads(callee @ir.Func, addr int) bool {
	for i := 0; i < len(callee.FaultPads); i++ {
		if bit_cast(int, callee.FaultPads[i]) == addr {
			return true
		}
	}
	return false
}

// collectPadBlocks returns every block of the fault pad rooted at `entryRaw` —
// the blocks reachable from the entry by following BRANCH/JUMP terminator targets
// until OP_UNWIND_RETURN — as callee.FaultPads @Block handles in FaultPads
// emission order (which is topological: a value is defined before its use, and pad
// blocks are emitted in program order, so cloning in this order sees every
// operand's clone already recorded).  Returns EMPTY if the pad is malformed for
// cloning: a block with no terminator, or a terminator target that is NOT a
// callee fault-pad block (a cleanup pad only ever branches within itself).
func collectPadBlocks(callee @ir.Func, entryRaw *ir.Block) @[]@ir.Block {
	var reach @[]int
	var frontier @[]int
	frontier = slices.Append[int](frontier, bit_cast(int, entryRaw))
	var fi int = 0
	for fi < len(frontier) {
		var addr int = frontier[fi]
		fi = fi + 1
		if containsAddr(reach, addr) {
			continue
		}
		if !addrInFaultPads(callee, addr) {
			return make_slice(@ir.Block, 0) // target outside the pad -> not clonable
		}
		reach = slices.Append[int](reach, addr)
		var blk *ir.Block = bit_cast(*ir.Block, addr)
		var n int = len(blk.Instrs)
		if n == 0 {
			return make_slice(@ir.Block, 0) // malformed (no terminator)
		}
		var term @ir.Instr = blk.Instrs[n - 1]
		if term.Block1 != nil {
			frontier = slices.Append[int](frontier, bit_cast(int, term.Block1))
		}
		if term.Block2 != nil {
			frontier = slices.Append[int](frontier, bit_cast(int, term.Block2))
		}
	}
	var result @[]@ir.Block
	for i := 0; i < len(callee.FaultPads); i++ {
		if containsAddr(reach, bit_cast(int, callee.FaultPads[i])) {
			result = slices.Append[@ir.Block](result, callee.FaultPads[i])
		}
	}
	return result
}

// padInlinable reports whether a NON-empty fault pad — single- OR multi-block —
// can be cloned into the caller: every block reachable from the pad entry ends in
// JUMP / BRANCH / OP_UNWIND_RETURN, and every cleanup instr is a non-faulting,
// non-call op with no phis whose operands are all remappable through the callee's
// dense value space (params / in-callee values / pad-internal values, id <
// callee.NextID).  A branching pad (an iface / func-value cleanup, or the
// stack-check pad — a managed-slice cleanup is straight-line, not branching) is now
// accepted — cloneInlinablePad clones its whole sub-CFG.  A pad whose blocks escape
// callee.FaultPads, or that carries a nested fault / call / phi / non-remappable
// operand, is rejected.
func padInlinable(pad *ir.Block, callee @ir.Func) bool {
	var blocks @[]@ir.Block = collectPadBlocks(callee, pad)
	if len(blocks) == 0 {
		return false
	}
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		var n int = len(blk.Instrs)
		if n == 0 {
			return false
		}
		var term int = blk.Instrs[n - 1].Op
		if term != iropcode.OP_UNWIND_RETURN && term != iropcode.OP_JUMP && term != iropcode.OP_BRANCH {
			return false
		}
		for k := 0; k < n; k++ {
			var pi @ir.Instr = blk.Instrs[k]
			if pi.PadBlock != nil {
				return false // pads don't nest faults (defensive)
			}
			if isCallFamilyOp(pi.Op) {
				return false // a dtor runs via OP_REFDEC, not a call (defensive)
			}
			if len(pi.Phis) != 0 {
				return false
			}
			for a := 0; a < len(pi.Args); a++ {
				var av @ir.Instr = pi.Args[a]
				if av == nil {
					continue
				}
				if av.IsGlobalRef {
					continue // a global operand is valid in the caller unchanged
				}
				if av.ID < 0 || av.ID >= callee.NextID {
					return false // operand not remappable
				}
			}
		}
	}
	return true
}

// faultPadHandle recovers the managed @Block for a raw `*Block` pad back-ref by
// scanning f.FaultPads for the same payload address (bit_cast identity — the
// same idiom load_forward.bn uses to match a faulting op's *Block PadBlock to a
// pad @Block).  Returns nil if not found (should not happen: a call-site pad
// lives in the caller's FaultPads and survives the inlined call's deletion).
func faultPadHandle(f @ir.Func, target *ir.Block) @ir.Block {
	var key int = bit_cast(int, target)
	for i := 0; i < len(f.FaultPads); i++ {
		if bit_cast(int, f.FaultPads[i]) == key {
			return f.FaultPads[i]
		}
	}
	return nil
}

// clonePadTarget maps a pad terminator's CFG target `t` to its freshly-created
// clone block (matched by payload address in the parallel srcKeys/cloneBlocks
// lists).  A target that is not a pad-internal block is returned unchanged
// (defensive — collectPadBlocks has already verified the pad's targets stay
// within it).
func clonePadTarget(t @ir.Block, srcKeys @[]int, cloneBlocks @[]@ir.Block) @ir.Block {
	var key int = bit_cast(int, t)
	for i := 0; i < len(srcKeys); i++ {
		if srcKeys[i] == key {
			return cloneBlocks[i]
		}
	}
	return t
}

// cloneInlinablePad clones a non-empty callee fault pad — single- OR multi-block —
// rooted at `entryRaw` into f's FaultPads, returning the clone of the entry block
// (which fixupInlinedPads wires into the faulting op's PadBlock).  Each cleanup
// instr is copied with its operands remapped through `remap` (the same dense value
// map the body clone populated, so the cloned RefDecs target the cloned callee
// locals); each block's terminator has its CFG targets remapped to the cloned pad
// blocks; and every terminal OP_UNWIND_RETURN becomes an OP_JUMP into
// `callSitePad`, chaining callee cleanup -> caller call-site cleanup -> a single
// unwind.  Blocks are cloned in FaultPads emission order (topological), so a
// pad-internal value's clone is recorded in `remap` before any later block refs
// it.  Pad cleanup instrs are never fault ops, so cloneInstrFields's callSitePad
// arg is unused (nil).
func cloneInlinablePad(f @ir.Func, callee @ir.Func, entryRaw *ir.Block, remap @[]@ir.Instr, cap int,
		callSitePad @ir.Block) @ir.Block {
	var srcBlocks @[]@ir.Block = collectPadBlocks(callee, entryRaw)
	// Pass 1: pre-create one clone block per source block, so a terminator can be
	// rewired to any (possibly later) block's clone.
	var srcKeys @[]int
	var cloneBlocks @[]@ir.Block
	for i := 0; i < len(srcBlocks); i++ {
		srcKeys = slices.Append[int](srcKeys, bit_cast(int, srcBlocks[i]))
		cloneBlocks = slices.Append[@ir.Block](cloneBlocks, ir.AddFaultPad(f, "inl_pad"))
	}
	// Pass 2: clone each block's instrs, remapping operands and terminator targets.
	for i := 0; i < len(srcBlocks); i++ {
		var src @ir.Block = srcBlocks[i]
		var dst @ir.Block = cloneBlocks[i]
		var built @[]@ir.Instr
		for k := 0; k < len(src.Instrs); k++ {
			var ins @ir.Instr = src.Instrs[k]
			if ins.Op == iropcode.OP_UNWIND_RETURN {
				var jmp @ir.Instr = ir.NewVoidInstr(iropcode.OP_JUMP)
				jmp.Block1 = callSitePad
				built = slices.Append[@ir.Instr](built, jmp)
				continue
			}
			var noPad *ir.Block
			var c @ir.Instr = cloneInstrFields(f, ins, noPad)
			for a := 0; a < len(c.Args); a++ {
				c.Args[a] = remapOperand(c.Args[a], remap, cap)
			}
			if ins.Block1 != nil {
				c.Block1 = clonePadTarget(ins.Block1, srcKeys, cloneBlocks)
			}
			if ins.Block2 != nil {
				c.Block2 = clonePadTarget(ins.Block2, srcKeys, cloneBlocks)
			}
			if ins.ID >= 0 {
				remap[ins.ID] = c
			}
			built = slices.Append[@ir.Instr](built, c)
		}
		dst.Instrs = built
	}
	var entryKey int = bit_cast(int, entryRaw)
	for i := 0; i < len(srcKeys); i++ {
		if srcKeys[i] == entryKey {
			return cloneBlocks[i]
		}
	}
	return cloneBlocks[0]
}

// fixupInlinedPads rewires every cloned NON-empty-pad fault op — cloneInstrFields
// left its PadBlock pointing at the CALLEE pad as a marker — to a freshly-cloned
// caller pad chained into the call-site pad.  Empty-pad fault ops (PadBlock ==
// callSitePad) and non-fault ops (PadBlock == nil) are untouched.  Fault ops
// that share one callee pad clone it once (dedup by payload address).  Runs
// AFTER the body clone, when `remap` covers every cloned callee value the pads'
// RefDecs reference.
func fixupInlinedPads(f @ir.Func, callee @ir.Func, instrs @[]@ir.Instr, remap @[]@ir.Instr, cap int,
		callSitePad *ir.Block) {
	var handle @ir.Block = faultPadHandle(f, callSitePad)
	var siteKey int = bit_cast(int, callSitePad)
	var srcKeys @[]int
	var clones @[]@ir.Block
	for i := 0; i < len(instrs); i++ {
		var c @ir.Instr = instrs[i]
		if c.PadBlock == nil {
			continue
		}
		var padKey int = bit_cast(int, c.PadBlock)
		if padKey == siteKey {
			continue // empty-pad reuse — nothing to clone
		}
		var cloned @ir.Block = nil
		for j := 0; j < len(srcKeys); j++ {
			if srcKeys[j] == padKey {
				cloned = clones[j]
				break
			}
		}
		if cloned == nil {
			cloned = cloneInlinablePad(f, callee, c.PadBlock, remap, cap, handle)
			srcKeys = slices.Append[int](srcKeys, padKey)
			clones = slices.Append[@ir.Block](clones, cloned)
		}
		// A managed @Block assigns into the raw *Block back-ref (a borrow;
		// f.FaultPads owns the pad) — same as attachFaultPad's faultOp.PadBlock.
		c.PadBlock = cloned
	}
}

// assertUniqueIDs marks every value-producing instr's dense SSA id across
// `blocks` in the shared `seen` set, failing loud on an out-of-range or
// duplicate id (a missed clone renumber -> silent VM/native miscompile).  Called
// for f.Blocks and f.FaultPads with one `seen` (a value never appears in both).
func assertUniqueIDs(f @ir.Func, blocks @[]@ir.Block, seen @[]bool) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var id int = blk.Instrs[ii].ID
			if id < 0 {
				continue
			}
			if id >= f.NextID {
				panic("inliner: instr ID out of range after inlining (missed renumber)")
			}
			if seen[id] {
				panic("inliner: duplicate SSA ID after inlining (missed renumber -> silent-miscompile risk)")
			}
			seen[id] = true
		}
	}
}

// markDefinedIDs sets defined[id] = true for every value-producing instr across
// `blocks` (used to build the in-scope value set for assertPadOperandsInScope).
func markDefinedIDs(blocks @[]@ir.Block, defined @[]bool, nextID int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var id int = blk.Instrs[ii].ID
			if id >= 0 && id < nextID {
				defined[id] = true
			}
		}
	}
}

// assertOperandsInScope fails loud if any instr operand across f.Blocks OR
// f.FaultPads references a value not defined within f (a param, an f-defined
// value, or a global-ref) — a dangling operand a bad clone / merge-slot store or
// load / pad clone left pointing outside the merged function.  assertUniqueIDs /
// assertPadRefsResolvable do NOT catch this: a dangling alloca operand is caught
// downstream by mem2reg, but a dangling plain SSA value (e.g. a managed-slice temp
// or a mis-remapped merge-slot operand) would be silent without this check.  For
// valid SSA every value operand references an in-function def, so this never fires
// on correct IR — only on a remap/clone bug.
func assertOperandsInScope(f @ir.Func) {
	var defined @[]bool = make_slice(bool, f.NextID)
	for i := 0; i < len(f.Params); i++ {
		var pid int = f.Params[i].ID
		if pid >= 0 && pid < f.NextID {
			defined[pid] = true
		}
	}
	markDefinedIDs(f.Blocks, defined, f.NextID)
	markDefinedIDs(f.FaultPads, defined, f.NextID)
	checkOperandsDefined(f.Blocks, defined, f.NextID)
	checkOperandsDefined(f.FaultPads, defined, f.NextID)
}

// checkOperandsDefined panics if any instr operand across `blocks` references a
// value not in `defined` (skipping nil and global-ref operands).
func checkOperandsDefined(blocks @[]@ir.Block, defined @[]bool, nextID int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			for a := 0; a < len(instr.Args); a++ {
				var av @ir.Instr = instr.Args[a]
				if av == nil {
					continue
				}
				if av.IsGlobalRef {
					continue
				}
				if av.ID < 0 || av.ID >= nextID || !defined[av.ID] {
					panic("inliner: operand not defined in f after inlining (dangling)")
				}
			}
		}
	}
}

// assertPadRefsResolvable fails loud if any faulting op in f.Blocks carries a
// PadBlock that is NOT one of f's own FaultPads (by payload identity) — i.e. a
// cloned fault op still dangling at a CALLEE pad because fixupInlinedPads missed
// it.  The VM resolves PadBlock against f.FaultPads, so a dangling ref would
// silently drop the fault handler.
func assertPadRefsResolvable(f @ir.Func) {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var pb *ir.Block = blk.Instrs[ii].PadBlock
			if pb == nil {
				continue
			}
			var key int = bit_cast(int, pb)
			var found bool = false
			for pi := 0; pi < len(f.FaultPads); pi++ {
				if bit_cast(int, f.FaultPads[pi]) == key {
					found = true
					break
				}
			}
			if !found {
				panic("inliner: fault op PadBlock not in f.FaultPads (dangling callee pad)")
			}
		}
	}
}
