package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the inliner's fault-pad helpers (inline_pads.bn).  The
// realistic clone-and-chain path is covered end-to-end by the VM leak tests
// (pkg/binate/vm vm_inline_leak_test.bn) and codegen (emit_inline_test.bn); these
// pin the structural predicates directly.  Shared helpers: NewFunc / AddFaultPad
// / intResults1 (inline_calls_test.bn + ir_phi_elim_test.bn), fail.

// TestIsEmptyPad: a pad that is exactly one OP_UNWIND_RETURN is empty; a pad with
// any preceding cleanup instr is not.
func TestIsEmptyPad() testing.TestResult {
	var noParams @[]@ir.Param
	var f @ir.Func = ir.NewFunc("", "iep", noParams, intResults1())
	var empty @ir.Block = ir.AddFaultPad(f, "empty")
	empty.EmitUnwindReturn()
	if !isEmptyPad(empty) {
		return fail("a pad of just OP_UNWIND_RETURN must be empty")
	}
	var nonempty @ir.Block = ir.AddFaultPad(f, "ne")
	var c @ir.Instr = nonempty.EmitConstInt(0, types.TypInt())
	_ = c
	nonempty.EmitUnwindReturn()
	if isEmptyPad(nonempty) {
		return fail("a pad with a preceding cleanup instr must not be empty")
	}
	return ""
}

// TestPadInlinable: a single straight-line block ending in OP_UNWIND_RETURN is
// inlinable; a well-formed MULTI-block (branching) pad whose whole sub-CFG stays
// within FaultPads and reaches OP_UNWIND_RETURN is ALSO inlinable; a pad whose
// terminator escapes FaultPads is rejected.
func TestPadInlinable() testing.TestResult {
	var noParams @[]@ir.Param
	var f @ir.Func = ir.NewFunc("", "psb", noParams, intResults1())
	var sb @ir.Block = ir.AddFaultPad(f, "sb")
	var c @ir.Instr = sb.EmitConstInt(0, types.TypInt())
	_ = c
	sb.EmitUnwindReturn()
	if !padInlinable(sb, f) {
		return fail("a single-block pad ending in OP_UNWIND_RETURN must be inlinable")
	}
	// A proper diamond pad: entry branches to a present arm + a merge; the arm
	// jumps to merge; merge unwinds.  All blocks are FaultPads, so it is clonable.
	var eb @ir.Block = ir.AddFaultPad(f, "mb_entry")
	var cond @ir.Instr = eb.EmitConstBool(true)
	var arm @ir.Block = ir.AddFaultPad(f, "mb_arm")
	var merge @ir.Block = ir.AddFaultPad(f, "mb_merge")
	eb.EmitBranch(cond, arm, merge)
	arm.EmitJump(merge)
	merge.EmitUnwindReturn()
	if !padInlinable(eb, f) {
		return fail("a well-formed multi-block (branching) pad must be inlinable")
	}
	// A pad whose terminator targets a NON-FaultPad (regular) block cannot be
	// cloned and must be rejected.
	var badEntry @ir.Block = ir.AddFaultPad(f, "bad_entry")
	var cond2 @ir.Instr = badEntry.EmitConstBool(true)
	var regular @ir.Block = ir.AddBlock(f, "regular")
	regular.EmitUnwindReturn()
	badEntry.EmitBranch(cond2, regular, regular)
	if padInlinable(badEntry, f) {
		return fail("a pad whose terminator escapes FaultPads must be rejected")
	}
	return ""
}

// TestFaultPadHandle: faultPadHandle recovers the managed @Block for a raw
// *Block back-ref by payload-address identity across f.FaultPads.
func TestFaultPadHandle() testing.TestResult {
	var noParams @[]@ir.Param
	var f @ir.Func = ir.NewFunc("", "fph", noParams, intResults1())
	var p0 @ir.Block = ir.AddFaultPad(f, "p0")
	var p1 @ir.Block = ir.AddFaultPad(f, "p1")
	_ = p0
	var got @ir.Block = faultPadHandle(f, p1)
	if bit_cast(int, got) != bit_cast(int, p1) {
		return fail("faultPadHandle must return the @Block matching the raw back-ref")
	}
	return ""
}
