package "pkg/binate/iropt"

import "pkg/binate/ir"

// An inlined callee's scope ids (ir.Instr.Scope) number the callee's scopes, which
// would collide with the caller's own.  Each inlined call reserves a range of the
// caller's ids, past every id the caller has issued, and its clones take their ids
// from it -- so two inlined copies of one callee never share a scope either.

// reserveInlinedScopes reserves callee.NumScopes scope ids of f for one inlined
// call and returns the base its clones add to their ids.
func reserveInlinedScopes(f @ir.Func, callee @ir.Func) int {
	var base int = f.NumScopes
	f.NumScopes = f.NumScopes + callee.NumScopes
	return base
}

// inlinedScope is a cloned instruction's scope id: 0 (none) stays 0, and a
// callee's scope moves past the caller's by base.
func inlinedScope(scope int, base int) int {
	if scope == 0 { return 0 }
	return scope + base
}
