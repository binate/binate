package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the inliner's scope renumbering (inline_scopes.bn).

// reserveInlinedScopes hands out the caller's next callee.NumScopes ids, and
// inlinedScope moves a callee's id past the base while keeping 0 (none).
func TestInlinedScopeIds() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	var callee @ir.Func = ir.NewFunc("", "k", noParams, noResults)
	_ = irbuild.NewScope(f)
	_ = irbuild.NewScope(callee)
	_ = irbuild.NewScope(callee)
	var base int = reserveInlinedScopes(f, callee)
	if base != 1 || f.NumScopes != 3 {
		return fail("a call reserves the callee's ids past the caller's")
	}
	if reserveInlinedScopes(f, callee) != 3 || f.NumScopes != 5 {
		return fail("a second call reserves new ones")
	}
	if inlinedScope(0, base) != 0 { return fail("no scope stays no scope") }
	if inlinedScope(2, base) != 3 { return fail("a callee's scope moves past the base") }
	return ""
}

// scopeCounts counts, for each scope id 1..n, f's instructions of op that carry it
// (index 0 unused).
func scopeCounts(f @ir.Func, op int, n int) @[]int {
	var counts @[]int = make_slice(int, n + 1)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == op && ins.Scope >= 1 && ins.Scope <= n { counts[ins.Scope] = counts[ins.Scope] + 1 }
		}
	}
	return counts
}

// eachScopeOnce reports whether f has exactly n scopes and exactly one alloca and
// one scope end in each.
func eachScopeOnce(f @ir.Func, n int) bool {
	if f.NumScopes != n { return false }
	var allocs @[]int = scopeCounts(f, iropcode.OP_ALLOC, n)
	var ends @[]int = scopeCounts(f, iropcode.OP_SCOPE_END, n)
	for s := 1; s <= n; s++ {
		if allocs[s] != 1 || ends[s] != 1 { return false }
	}
	return true
}

// scopedLocal appends an int alloca in a new scope of f to b and returns its scope.
func scopedLocal(f @ir.Func, b @ir.Block) int {
	var a @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	a.Scope = irbuild.NewScope(f)
	return a.Scope
}

// A single-block callee with two scopes, inlined twice into a caller with one:
// each copy's scopes get ids of their own past the caller's (5 in all, each with
// its alloca and its end), and the result verifies.
func TestInlineRenumbersScopes() testing.TestResult {
	var callee @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var cb @ir.Block = ir.AddBlock(callee, "entry")
	var s1 int = scopedLocal(callee, cb)
	var s2 int = scopedLocal(callee, cb)
	irbuild.EmitScopeEnd(cb, s2)
	irbuild.EmitScopeEnd(cb, s1)
	irbuild.EmitReturn(cb, oneRet(irbuild.EmitConstInt(cb, 42, types.TypInt())))

	var caller @ir.Func = ir.NewFunc("", "caller", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var own int = scopedLocal(caller, eb)
	var noArgs @[]@ir.Instr
	var r1 @ir.Instr = irbuild.EmitCall(eb, "k", noArgs, types.TypInt())
	_ = irbuild.EmitCall(eb, "k", noArgs, types.TypInt())
	irbuild.EmitScopeEnd(eb, own)
	irbuild.EmitReturn(eb, oneRet(r1))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)
	inlineCalls(m, DEFAULT_INLINE_THRESHOLD, true)
	if countOpInFunc(caller, iropcode.OP_CALL) != 0 {
		return fail("setup: both calls should be inlined")
	}
	if !eachScopeOnce(caller, 5) { return fail("each inlined copy's scopes need ids of their own") }
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the inlined module must verify") }
	return ""
}

// A multi-block callee's scope, inlined, takes an id past the caller's.
func TestInlineMultiBlockRenumbersScopes() testing.TestResult {
	var callee @ir.Func = ir.NewFunc("", "k2", noParams, intResults1())
	var b0 @ir.Block = ir.AddBlock(callee, "entry")
	var b1 @ir.Block = ir.AddBlock(callee, "next")
	var s int = scopedLocal(callee, b0)
	irbuild.EmitJump(b0, b1)
	irbuild.EmitScopeEnd(b1, s)
	irbuild.EmitReturn(b1, oneRet(irbuild.EmitConstInt(b1, 7, types.TypInt())))

	var caller @ir.Func = ir.NewFunc("", "caller2", noParams, intResults1())
	var eb @ir.Block = ir.AddBlock(caller, "entry")
	var own int = scopedLocal(caller, eb)
	var noArgs @[]@ir.Instr
	var r @ir.Instr = irbuild.EmitCall(eb, "k2", noArgs, types.TypInt())
	irbuild.EmitScopeEnd(eb, own)
	irbuild.EmitReturn(eb, oneRet(r))

	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(callee)
	m.AddFunc(caller)
	inlineCalls(m, DEFAULT_INLINE_THRESHOLD, true)
	if countOpInFunc(caller, iropcode.OP_CALL) != 0 {
		return fail("setup: the call should be inlined")
	}
	if !eachScopeOnce(caller, 2) { return fail("the inlined scope needs an id of its own") }
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the inlined module must verify") }
	return ""
}

// A callee fault pad's scope end, cloned into the caller, takes the call's base too.
func TestInlinedPadRenumbersScopes() testing.TestResult {
	var callee @ir.Func = ir.NewFunc("", "k", noParams, noResults)
	var pad @ir.Block = ir.AddFaultPad(callee, "pad")
	irbuild.EmitScopeEnd(pad, irbuild.NewScope(callee))
	irbuild.EmitUnwindReturn(pad)

	var caller @ir.Func = ir.NewFunc("", "caller", noParams, noResults)
	_ = irbuild.NewScope(caller)
	_ = irbuild.NewScope(caller)
	var site @ir.Block = ir.AddFaultPad(caller, "site")
	var base int = reserveInlinedScopes(caller, callee)
	var remap @[]@ir.Instr = make_slice(@ir.Instr, callee.NextID)
	var cloned @ir.Block = cloneInlinablePad(caller, callee, pad, remap, callee.NextID, site, base)
	if len(cloned.Instrs) != 2 { return fail("the pad clones its scope end and its exit") }
	var end @ir.Instr = cloned.Instrs[0]
	if end.Op != iropcode.OP_SCOPE_END || end.Scope != 3 {
		return fail("the cloned scope end names scope 3")
	}
	return ""
}

// A scope end costs nothing in the inliner's size count: no backend emits code for it.
func TestFuncInstrCountSkipsScopeEnds() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "k", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var s int = scopedLocal(f, b)
	irbuild.EmitScopeEnd(b, s)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	if funcInstrCount(f) != 2 {
		return fail("the alloca and the return count; the scope end does not")
	}
	return ""
}

// Through the whole pass: a callee's non-empty fault pad, cloned into the caller,
// takes the call's scope base like the body (the caller's own scope is 1, so the
// pad's scope end of the callee's scope 1 becomes 2).
func TestInlineClonedPadRenumbersScopes() testing.TestResult {
	var k @ir.Func = ir.NewFunc("", "k", noParams, intResults1())
	var kb @ir.Block = ir.AddBlock(k, "entry")
	var i0 @ir.Instr = irbuild.EmitConstInt(kb, 0, types.TypInt())
	irbuild.EmitBoundsCheck(kb, i0, irbuild.EmitConstInt(kb, 2, types.TypInt()))
	var kpad @ir.Block = ir.AddFaultPad(k, "kpad")
	irbuild.EmitScopeEnd(kpad, irbuild.NewScope(k))
	irbuild.EmitUnwindReturn(kpad)
	kb.Instrs[len(kb.Instrs) - 1].PadBlock = kpad
	irbuild.EmitReturn(kb, oneRet(i0))
	var caller @ir.Func = sizedIntFunc("caller", 0, "k")
	_ = irbuild.NewScope(caller)
	var sitePad @ir.Block = ir.AddFaultPad(caller, "sitepad")
	irbuild.EmitUnwindReturn(sitePad)
	caller.Blocks[0].Instrs[0].PadBlock = sitePad
	var m @ir.Module = ir.NewModule("test")
	m.AddFunc(k)
	m.AddFunc(caller)
	inlineCalls(m, DEFAULT_INLINE_THRESHOLD, true)
	if countOpInFunc(caller, iropcode.OP_CALL) != 0 { return fail("setup: k should be inlined") }
	if caller.NumScopes != 2 { return fail("the call reserves the callee's one scope") }
	var found int = 0
	for pi := 0; pi < len(caller.FaultPads); pi++ {
		var p @ir.Block = caller.FaultPads[pi]
		for ii := 0; ii < len(p.Instrs); ii++ {
			if p.Instrs[ii].Op == iropcode.OP_SCOPE_END {
				if p.Instrs[ii].Scope != 2 { return fail("the cloned pad's scope end names scope 2") }
				found = found + 1
			}
		}
	}
	if found != 1 { return fail("the callee's pad is cloned into the caller with its scope end") }
	if len(irbuild.VerifyModule(m)) != 0 { return fail("the inlined module must verify") }
	return ""
}

// The SROA-discounted size skips scope ends too, as the plain count does.
func TestSroaAdjustedSizeSkipsScopeEnds() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "k", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var s int = scopedLocal(f, b)
	irbuild.EmitScopeEnd(b, s)
	irbuild.EmitScopeEnd(b, s)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	if sroaAdjustedSize(f) != funcInstrCount(f) { return fail("both counts skip the scope ends") }
	return ""
}
