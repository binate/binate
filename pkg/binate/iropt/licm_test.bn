package "pkg/binate/iropt"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// isHoistable is the correctness-critical classifier: only pure, non-trapping,
// effect-free ops may be speculated into a preheader.  A false positive here
// (hoisting a trapping/effecting op) is a miscompile, so pin the boundary.
func TestIsHoistableAcceptsPureOps() testing.TestResult {
	var pure @[]int = make_slice(int, 0)
	pure = appendOp(pure, iropcode.OP_CONST_INT)
	pure = appendOp(pure, iropcode.OP_CONST_FLOAT)
	pure = appendOp(pure, iropcode.OP_CONST_BOOL)
	pure = appendOp(pure, iropcode.OP_CONST_STRING)
	pure = appendOp(pure, iropcode.OP_CONST_NIL)
	pure = appendOp(pure, iropcode.OP_ADD)
	pure = appendOp(pure, iropcode.OP_SUB)
	pure = appendOp(pure, iropcode.OP_MUL)
	pure = appendOp(pure, iropcode.OP_AND)
	pure = appendOp(pure, iropcode.OP_OR)
	pure = appendOp(pure, iropcode.OP_XOR)
	pure = appendOp(pure, iropcode.OP_SHL)
	pure = appendOp(pure, iropcode.OP_SHR)
	pure = appendOp(pure, iropcode.OP_EQ)
	pure = appendOp(pure, iropcode.OP_LT)
	pure = appendOp(pure, iropcode.OP_NEG)
	pure = appendOp(pure, iropcode.OP_CAST)
	pure = appendOp(pure, iropcode.OP_BIT_CAST)
	for i := 0; i < len(pure); i++ {
		if !isHoistable(pure[i]) {
			return "expected pure op to be hoistable"
		}
	}
	return ""
}

// The trapping and effecting ops must NEVER be hoisted.
func TestIsHoistableRejectsUnsafeOps() testing.TestResult {
	var unsafe @[]int = make_slice(int, 0)
	unsafe = appendOp(unsafe, iropcode.OP_DIV) // traps on /0
	unsafe = appendOp(unsafe, iropcode.OP_REM) // traps on /0
	unsafe = appendOp(unsafe, iropcode.OP_LOAD)
	unsafe = appendOp(unsafe, iropcode.OP_STORE)
	unsafe = appendOp(unsafe, iropcode.OP_CALL)
	unsafe = appendOp(unsafe, iropcode.OP_DIV_CHECK)
	unsafe = appendOp(unsafe, iropcode.OP_BOUNDS_CHECK)
	unsafe = appendOp(unsafe, iropcode.OP_PHI)
	unsafe = appendOp(unsafe, iropcode.OP_ALLOC)
	for i := 0; i < len(unsafe); i++ {
		if isHoistable(unsafe[i]) {
			return "trapping/effecting op must NOT be hoistable"
		}
	}
	return ""
}

func appendOp(s @[]int, v int) @[]int {
	var out @[]int = make_slice(int, len(s) + 1)
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	out[len(s)] = v
	return out
}
