package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Load-forwarding — a phi-free companion to mem2reg (mem2reg.bn) for AGGREGATE
// slots.  It coalesces the two slice-header loads gen emits for `len(s)` (loop
// guard) and `s[i]` (access) onto ONE SSA value so loop-BCE can prove the guard
// bound equals the bounds-check length.
//
// A slot is eligible only when it is by-value-representable OR a slice; the choice
// of strategy is keyed on BY-ADDRESS-ness (whether its OP_LOAD yields the slot
// value or the slot address — types' isAggregateLoadTyp / IsAggregateTyp, mirrored
// here by isBitCastMemoryLoweredKind):
//   * STORE-FORWARDING (BY-VALUE slots — scalars, INCLUDING a managed pointer @T):
//     rewrite every load to the single stored value V and delete the
//     alloca/store/loads.  Sound because a load of a by-value slot produces exactly
//     V.  A managed pointer @T is a single-word by-value value (not in
//     isBitCastMemoryLoweredKind), so it store-forwards like any scalar — but it is
//     also RefDec'd in a cleanup fault pad (via a plain load), so it gets the same
//     pad-load relaxation as a managed slice (see below): its pad loads are
//     collected and rewritten to V, and applyPromotion deletes them from the pad.
//   * REDUNDANT-LOAD-ELIMINATION (slices — raw *[]T AND managed @[]T, any word
//     size): a slice is a by-address aggregate — its OP_LOAD keeps the slot ADDRESS
//     — so store-forwarding to V is unsound (a backend would `extractvalue` a value
//     out of an address, and the VM read the wrong bytes).  Instead insert one
//     materializing OP_LOAD(A) right after the store and rewrite every load —
//     normal AND (for a managed slice) cleanup fault-pad — to IT; a load result is
//     by-value in every backend.  Keep the alloca/store/materializing-load.
//   * DECLINED: every other by-address aggregate — a STRUCT, ARRAY, interface value,
//     or function value (raw or managed).  These need no slice-header coalescing,
//     so they are simply left unoptimized rather than RLE'd; store-forwarding them
//     is unsound (the -O1+ VM read a nil interface / garbage func pointer /
//     reclaimed-SP struct).
//
// Soundness spine: escape analysis bars any aliasing write / address leak, so only
// the one store writes A; that store dominating every load (and every fault-pad
// load's fault point) means each load provably read exactly V.  Binate refcounting
// is explicit + operand-based (plain load/store carry no implicit inc/dec), so
// rewriting a load-use — or inserting a plain OP_LOAD — is refcount-neutral.
//
// Managed slices AND managed pointers are loaded in a cleanup FAULT PAD (for
// RefDec), which naively looks like an escape; forwardEscapes permits that plain
// pad load and the pad's RefDec is rewritten to the same value (V, or the
// materializing load for a slice), so the refcount trajectory is byte-identical.
// Fault pads are VM-only; compiled backends ignore them.

// forwardLoads runs load-forwarding over every non-extern func.  Invoked by
// RunOptConfig, after promoteScalars.
func forwardLoads(m @ir.Module) {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern {
			continue
		}
		forwardLoadsFunc(f)
	}
}

// forwardLoadsFunc forwards all eligible single-store slots in one function,
// dispatching each to store-forwarding or RLE by its analysis.  RLE runs first (it
// inserts instructions, so it needs live block positions); store-forwarding then
// runs position-independently (it keys off instruction ids), so the two passes do
// not interfere despite sharing f.Blocks.
func forwardLoadsFunc(f @ir.Func) {
	if len(f.Blocks) == 0 {
		return
	}
	var d @DomInfo = ComputeDom(f)
	// The analysis below reads f without mutating it (the rewrites run after it),
	// so one use index and one pad-site table serve every alloca.
	var ui @useIndex = buildUseIndex(f)
	var ps @padFaultSites = buildPadFaultSites(f)

	// Store-forwarding accumulators (load-id -> stored value; deleted allocas).
	var gReplID @vec.Vec[int] = vec.New[int]()
	var gReplVal @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gDeletedAlloca @vec.Vec[int] = vec.New[int]()
	var anyStore bool = false

	// RLE accumulators (parallel per-alloca arrays).
	var gRleAlloca @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gRleStoreBlk @vec.Vec[int] = vec.New[int]()
	var gRleStorePos @vec.Vec[int] = vec.New[int]()
	var gRleLoads @vec.Vec[@[]int] = vec.New[@[]int]()
	var anyRle bool = false

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if instr.Op != iropcode.OP_ALLOC {
				continue
			}
			if forwardEscapes(ui, instr) {
				continue
			}
			var res @fwdResult = analyzeForwardAlloca(ui, ps, d, instr)
			if !res.ok {
				continue
			}
			if res.useRLE {
				gRleAlloca.Push(instr)
				gRleStoreBlk.Push(res.storeBlk)
				gRleStorePos.Push(res.storePos)
				gRleLoads.Push(res.loadIDs)
				anyRle = true
			} else {
				for k := 0; k < len(res.loadIDs); k++ {
					gReplID.Push(res.loadIDs[k])
					gReplVal.Push(res.val)
				}
				gDeletedAlloca.Push(instr.ID)
				anyStore = true
			}
		}
	}

	// RLE and slice-extract coalescing delete instructions the store-forwarding
	// values gathered above may BE (a scalar slot initialized from a slice's length
	// is `extract(load b, 1)`, and that extract is coalesced away); each deleted
	// value's replacement is recorded in rleRepl, and the store-forwarding values are
	// chased through it before applyPromotion, else a forwarded load would be
	// replaced by an instruction no longer in f.
	var rleCap int = f.NextID
	var rleRepl @[]@ir.Instr = make_slice(@ir.Instr, rleCap)
	if anyRle {
		var l0s @[]@ir.Instr = applyRLE(f, gRleAlloca.Items(), gRleStoreBlk.Items(), gRleStorePos.Items(),
				gRleLoads.Items(), rleRepl)
		coalesceSliceExtractsInto(f, l0s, rleRepl)
	}
	if anyStore {
		var noPhi @[]@ir.Instr
		var noPhiBlock @[]int
		var noGroundL @[]@ir.Instr
		var noGroundV @[]@ir.Instr
		var noZero @[]@ir.Instr
		var replVals @[]@ir.Instr = gReplVal.Items()
		for k := 0; k < len(replVals); k++ {
			replVals[k] = chaseRepl(replVals[k], rleRepl, rleCap)
		}
		applyPromotion(f, d.NumBlocks, noPhi, noPhiBlock, gReplID.Items(), replVals, noGroundL, noGroundV,
				noZero, gDeletedAlloca.Items())
	}
}

// fwdResult is one alloca's analysis: whether it is forwardable, which strategy
// (useRLE), its loads (all forwarded — normal + fault-pad), the single stored
// value (store-forwarding target), and the store's position (RLE insertion point).
type fwdResult struct {
	ok       bool
	useRLE   bool
	loadIDs  @[]int
	val      @ir.Instr
	storeBlk int
	storePos int
}

// analyzeForwardAlloca decides whether alloca a is forwardable and how.  It
// requires exactly one store, at least one load, the store dominating every normal
// load (same block ⇒ store textually before), and a matching stored-value type.
// For a managed slice OR a managed pointer it additionally collects the cleanup
// fault-pad loads and requires the store to dominate each pad's fault point.
// useRLE is set for any slice (managed pointers store-forward like scalars); a
// >16B non-slice aggregate (large struct) is declined outright.
func analyzeForwardAlloca(ui @useIndex, ps @padFaultSites, d @DomInfo, a @ir.Instr) @fwdResult {
	var res @fwdResult = make(fwdResult)
	res.ok = false

	var isMS bool = isManagedSlice(a.TypeArg)
	var isMP bool = irutil.IsManagedPtrType(a.TypeArg)
	// Store-forwarding rewrites every load of the slot to the single stored value V
	// and DELETES the slot.  That is sound only for a slot whose OP_LOAD produces a
	// VALUE.  A BY-ADDRESS aggregate — struct, array, interface value, or function
	// value (raw OR managed) — instead loads the slot ADDRESS (kept by-address on
	// the VM and native; cf. types' isAggregateLoadTyp / IsAggregateTyp, and the
	// isBitCastMemoryLoweredKind set used here), so substituting V hands a consumer
	// a value where an address is expected: at -O1+ the VM read a nil interface / a
	// garbage func data pointer / a reclaimed-SP struct.  Decline it.  A SLICE (raw
	// or managed) is the one by-address aggregate this pass still forwards — its
	// slice-header coalescing is what loop-BCE consumes — but ALWAYS via the
	// address-preserving RLE path below (useRLE), never store-forwarding.  So the
	// store-forwarding path is left with exactly the by-VALUE scalar slots.
	var pt @types.Type = irutil.PeelTransparent(a.TypeArg)
	// isSlice off the peeled representation (peelTransparent == isManagedSlice's
	// ir.PeelToRepr) so a named-distinct / alias / `readonly`-wrapped slice is still
	// recognized and routed to RLE — isSliceType peels only `readonly` and would
	// miss `type Buf *[]T`, sending it down the unsound store-forwarding path.
	var isSlice bool = pt != nil && (pt.Kind == types.TYP_SLICE || pt.Kind == types.TYP_MANAGED_SLICE)
	// INVARIANT: isBitCastMemoryLoweredKind must cover every by-address load kind
	// (types' isAggregateLoadTyp / IsAggregateTyp) EXCEPT raw TYP_SLICE — today it
	// does (it is that set minus raw slice; raw slice is caught by `isSlice`).  A
	// new by-address kind added to isAggregateLoadTyp but NOT here (and not a slice)
	// would slip this gate and be store-forwarded — the 1054-class unsoundness.  The
	// TestForward*Declined per-kind tests are the tripwire; keep them in sync.
	if pt != nil && irutil.IsBitCastMemoryLoweredKind(pt) && !isSlice {
		return res
	}

	var storeCount int = 0
	var storeBlk int = -1
	var storePos int = -1
	var val @ir.Instr
	var loadIDs @[]int
	var loadBlks @[]int
	var loadPoss @[]int

	var us @[]valueUse = ui.usesOf(a)
	for i := 0; i < len(us); i++ {
		var instr @ir.Instr = us[i].user
		if us[i].inPad || us[i].argIdx != 0 {
			continue
		}
		if instr.Op == iropcode.OP_STORE && len(instr.Args) >= 2 {
			storeCount = storeCount + 1
			storeBlk = us[i].blockIdx
			storePos = us[i].pos
			val = instr.Args[1]
		} else if instr.Op == iropcode.OP_LOAD {
			loadIDs = slices.Append[int](loadIDs, instr.ID)
			loadBlks = slices.Append[int](loadBlks, us[i].blockIdx)
			loadPoss = slices.Append[int](loadPoss, us[i].pos)
		}
	}

	if storeCount != 1 || len(loadIDs) == 0 || val == nil {
		return res
	}
	// Type match: a load reads the slot AS its type.  For aggregates this always
	// agrees with the stored value; a scalar mismatch (looser stored type) would
	// need grounding — bail instead of forwarding a wrong-typed value.
	if needsGrounding(val, a.TypeArg) {
		return res
	}
	// The single store must dominate every normal load.
	for k := 0; k < len(loadIDs); k++ {
		if loadBlks[k] == storeBlk {
			if loadPoss[k] <= storePos {
				return res // load at/before the store in its block — reads a prior value
			}
		} else if !d.Dominates(storeBlk, loadBlks[k]) {
			return res
		}
	}

	// Managed slice or managed pointer: also forward the cleanup fault-pad loads.
	// Require the store to dominate each pad's fault point so the pad provably reads
	// V, not the zero-filled slot.  (forwardEscapes already barred any non-load pad
	// use.)
	if isMS || isMP {
		// The index lists pad reads in pad order, so each pad holding a load of
		// `a` is checked once, when its first load is reached.
		var lastPad int = -1
		for i := 0; i < len(us); i++ {
			var instr @ir.Instr = us[i].user
			if !us[i].inPad || us[i].argIdx != 0 || instr.Op != iropcode.OP_LOAD {
				continue
			}
			loadIDs = slices.Append[int](loadIDs, instr.ID)
			if us[i].blockIdx != lastPad {
				lastPad = us[i].blockIdx
				if !storeDominatesPad(ps, d, storeBlk, storePos, lastPad) {
					return res
				}
			}
		}
	}

	res.ok = true
	res.useRLE = isSlice
	res.loadIDs = loadIDs
	res.val = val
	res.storeBlk = storeBlk
	res.storePos = storePos
	return res
}

// isManagedSlice reports whether t is (after peeling wrappers) a managed slice
// (@[]T) — the only slot kind gen loads into a cleanup fault pad for RefDec.
func isManagedSlice(t @types.Type) bool {
	if t == nil {
		return false
	}
	var r @types.Type = ir.PeelToRepr(t)
	return r != nil && r.Kind == types.TYP_MANAGED_SLICE
}

// forwardEscapes is allocaEscapes relaxed for load-forwarding, for a managed SLICE
// or a managed POINTER: a plain OP_LOAD of such an A in a FAULT PAD (its cleanup
// RefDec read) is not an escape — analyzeForwardAlloca collects and forwards it
// with the normal loads (and applyPromotion / applyRLE deletes it from the pad).
// The relaxation is gated on those two kinds because they are the ones the
// pad-forwarding handles; other managed values (iface/func values) ALSO have
// cleanup pad loads, but those are not collected, so they must keep the strict
// "any pad appearance ⇒ escape" rule or forwarding would delete their alloca and
// pad load while leaving the pad's RefDec dangling.  Every non-pad escape (a
// store's value operand, GET_FIELD/ELEM_PTR, a phi entry) is barred exactly as
// allocaEscapes.
func forwardEscapes(ui @useIndex, a @ir.Instr) bool {
	var relaxPad bool = isManagedSlice(a.TypeArg) || irutil.IsManagedPtrType(a.TypeArg)
	var us @[]valueUse = ui.usesOf(a)
	for i := 0; i < len(us); i++ {
		var k int = us[i].argIdx
		var op int = us[i].user.Op
		if !us[i].inPad {
			if k != 0 || (op != iropcode.OP_LOAD && op != iropcode.OP_STORE) {
				return true // a phi entry, or any use but a load/store address
			}
		} else if !relaxPad || k != 0 || op != iropcode.OP_LOAD {
			return true // any pad appearance, or (relaxed) any but a pad load
		}
	}
	return false
}

// applyRLE materializes each RLE slot's value with one OP_LOAD inserted right after
// its store, rewrites every existing load (normal + fault-pad) to that
// materializing load, and deletes the rewritten loads — keeping the alloca, store,
// and new load.  (See the file header for why RLE, not store-forwarding, for a
// >16B by-address managed slice.)  Each deleted load's replacement is also
// recorded in rec (by id, for ids below len(rec)).
func applyRLE(f @ir.Func, allocas @[]@ir.Instr, storeBlks @[]int, storePoss @[]int,
		loadIDsPer @[]@[]int, rec @[]@ir.Instr) @[]@ir.Instr {
	var cap int = f.NextID
	// load-id -> materializing load; and the set of rewritten (deleted) loads.
	var replByID @[]@ir.Instr = make_slice(@ir.Instr, cap)
	var deletedLoad @[]bool = make_slice(bool, cap)
	var l0s @[]@ir.Instr
	for i := 0; i < len(allocas); i++ {
		var a @ir.Instr = allocas[i]
		var l0 @ir.Instr = ir.NewInstr(f, iropcode.OP_LOAD, a.TypeArg)
		l0.Args = ir.MakeArgs1(a)
		l0s = slices.Append[@ir.Instr](l0s, l0)
		for k := 0; k < len(loadIDsPer[i]); k++ {
			var lid int = loadIDsPer[i][k]
			replByID[lid] = l0
			deletedLoad[lid] = true
			if lid < len(rec) {
				rec[lid] = l0
			}
		}
	}
	// Rebuild f.Blocks: drop the rewritten loads; insert each L0 right after its
	// store (the store dominates every load, so it precedes them in its block).
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if instr.ID >= 0 && instr.ID < cap && deletedLoad[instr.ID] {
				continue
			}
			kept.Push(instr)
			for i := 0; i < len(allocas); i++ {
				if storeBlks[i] == bi && storePoss[i] == ii {
					kept.Push(l0s[i])
				}
			}
		}
		blk.Instrs = kept.Items()
	}
	// Rebuild each fault pad: drop the rewritten cleanup loads.
	for pi := 0; pi < len(f.FaultPads); pi++ {
		var pad @ir.Block = f.FaultPads[pi]
		var keptPad @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(pad.Instrs); ii++ {
			var instr @ir.Instr = pad.Instrs[ii]
			if instr.ID >= 0 && instr.ID < cap && deletedLoad[instr.ID] {
				continue
			}
			keptPad.Push(instr)
		}
		pad.Instrs = keptPad.Items()
	}
	// Rewrite every remaining use of a rewritten load to its materializing load,
	// then fail loud if any use of a deleted load survives.  No alloca is deleted
	// here, so allocaDeleted is all-false.
	rewriteUsesInBlocks(f.Blocks, replByID, cap)
	rewriteUsesInBlocks(f.FaultPads, replByID, cap)
	var noAllocaDeleted @[]bool = make_slice(bool, cap)
	assertNoSurvivingUses(f.Blocks, replByID, noAllocaDeleted, cap)
	assertNoSurvivingUses(f.FaultPads, replByID, noAllocaDeleted, cap)
	return l0s
}
