package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Load-forwarding tests for MANAGED-value and by-ADDRESS-aggregate slots (split
// from load_forward_test.bn for file length): the slice RLE path (raw + managed
// slices, incl. their cleanup fault-pad loads), managed-pointer store-forwarding
// with pad relaxation, and the interface-/function-value declines.  The scalar
// store-forwarding, dominance, and multi-store cases stay in load_forward_test.bn.
// Shared helpers (noParams, oneRet, countOp, fail) live in opt_helpers_test.bn.

// A >16B by-address managed slice (@[]int = 4 words = 32B on LP64) is coalesced by
// REDUNDANT-LOAD-ELIMINATION, not store-forwarding: store-forwarding to the stored
// value would make a backend extractvalue a slice out of a `ptr` (a by-address
// param).  RLE keeps the alloca + store, inserts ONE materializing load after the
// store, and rewrites every load to it — so the length extract reads a LOAD, never
// the stored value.
func TestForwardManagedSliceRLE() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @ir.Instr = irbuild.EmitAlloc(entry, mst)
	var nilSlice @ir.Instr = irbuild.EmitConstNil(entry, mst)
	irbuild.EmitStore(entry, x, nilSlice)
	var v @ir.Instr = irbuild.EmitLoad(entry, x, mst)
	var ln @ir.Instr = irbuild.EmitSliceLen(entry, v)
	irbuild.EmitReturn(entry, oneRet(ln))

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("RLE: the managed-slice alloca must be kept")
	}
	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("RLE: exactly one materializing load must remain")
	}
	// The extract must read the materializing OP_LOAD of the slot, NOT the stored
	// value (nilSlice).
	var l0 @ir.Instr = ln.Args[0]
	if l0 == nilSlice {
		return fail("RLE: the length extract must not read the stored value")
	}
	if l0.Op != iropcode.OP_LOAD || len(l0.Args) < 1 || l0.Args[0] != x {
		return fail("RLE: the length extract must read an OP_LOAD of the slot")
	}
	return ""
}

// A managed slice loaded in a cleanup FAULT PAD (a RefDec read), whose store
// dominates the pad's fault point, is coalesced onto the same materialized load as
// the normal loads — so the pad's RefDec reads the same slice value V.  This is the
// VM-only fault-pad path RLE re-enables (store-forwarding could not, since V may be
// a `ptr`).
func TestForwardManagedSliceRLEPadLoad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @ir.Instr = irbuild.EmitAlloc(entry, mst)
	irbuild.EmitStore(entry, x, irbuild.EmitConstNil(entry, mst))
	var guard @ir.Instr = irbuild.EmitLoad(entry, x, mst)
	var ln @ir.Instr = irbuild.EmitSliceLen(entry, guard)
	irbuild.EmitBoundsCheck(entry, irbuild.EmitConstInt(entry, 0, types.TypInt()), ln)
	var chk @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	irbuild.EmitReturn(entry, oneRet(ln))

	// A cleanup pad that loads the slot (the managed-local RefDec read) and uses it.
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	var padLoad @ir.Instr = irbuild.EmitLoad(pad, x, mst)
	var padLen @ir.Instr = irbuild.EmitSliceLen(pad, padLoad)
	irbuild.EmitUnwindReturn(pad)
	chk.PadBlock = pad

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 1 {
		return fail("pad: the managed-slice alloca must be kept")
	}
	// The pad's OP_LOAD(x) is forwarded away.
	for ii := 0; ii < len(pad.Instrs); ii++ {
		var pi @ir.Instr = pad.Instrs[ii]
		if pi.Op == iropcode.OP_LOAD && len(pi.Args) >= 1 && pi.Args[0] == x {
			return fail("pad: the cleanup load must be forwarded away")
		}
	}
	// The guard extract and the pad extract must read the SAME materialized load —
	// the coalescing loop-BCE relies on — and it must be an OP_LOAD of the slot.
	if ln.Args[0] != padLen.Args[0] {
		return fail("pad: guard and cleanup extracts must read the same materialized load")
	}
	var l0 @ir.Instr = ln.Args[0]
	if l0.Op != iropcode.OP_LOAD || len(l0.Args) < 1 || l0.Args[0] != x {
		return fail("pad: the coalesced value must be an OP_LOAD of the slot")
	}
	return ""
}

// A NON-load use of the slot in a fault pad (here a store) is a real escape even in
// a pad — the slot is not forwarded (guard load kept, no materialized load).
func TestForwardManagedSlicePadNonLoadKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var x @ir.Instr = irbuild.EmitAlloc(entry, mst)
	irbuild.EmitStore(entry, x, irbuild.EmitConstNil(entry, mst))
	var guard @ir.Instr = irbuild.EmitLoad(entry, x, mst)
	var ln @ir.Instr = irbuild.EmitSliceLen(entry, guard)
	irbuild.EmitReturn(entry, oneRet(ln))

	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	irbuild.EmitStore(pad, x, irbuild.EmitConstNil(pad, mst)) // a non-load use of x in the pad
	irbuild.EmitUnwindReturn(pad)

	forwardLoadsFunc(f)

	// Escaped ⇒ untouched: the guard load stays and the extract still reads it.
	if ln.Args[0] != guard {
		return fail("pad non-load use: the slot must not be forwarded")
	}
	return ""
}

// A managed POINTER (@T) loaded in a cleanup fault pad IS store-forwarded: @T is a
// single-word by-value scalar, so the alloca/store/loads vanish, the pad's cleanup
// load is deleted, and both the normal-block and pad-block RefDecs of the loaded
// value are rewritten to the single stored value V.  The refcount trajectory is
// byte-identical (a plain load carries no inc/dec), so this is refcount-neutral —
// the richards `s`/`cur` reload storm this eliminates.
func TestForwardManagedPtrPadLoadForwarded() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var pt @types.Type = types.MakeManagedPtrType(types.TypInt())
	var x @ir.Instr = irbuild.EmitAlloc(entry, pt)
	var v0 @ir.Instr = irbuild.EmitConstNil(entry, pt)
	irbuild.EmitStore(entry, x, v0)
	var nload @ir.Instr = irbuild.EmitLoad(entry, x, pt)
	irbuild.EmitRefDec(entry, nload) // a normal-block cleanup RefDec of the loaded value
	var ndec @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(entry, noRet)

	// A cleanup pad that loads the slot (the managed-local RefDec read) and RefDecs
	// it.  nload hosts the fault point (dominated by the store) so storeDominatesPad
	// locates the pad.
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	var padLoad @ir.Instr = irbuild.EmitLoad(pad, x, pt)
	irbuild.EmitRefDec(pad, padLoad)
	var pdec @ir.Instr = pad.Instrs[len(pad.Instrs) - 1]
	irbuild.EmitUnwindReturn(pad)
	nload.PadBlock = pad

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("managed pointer: alloca/store/normal-loads should be forwarded away")
	}
	// The pad's OP_LOAD(x) is deleted, and its RefDec now reads the stored value.
	for ii := 0; ii < len(pad.Instrs); ii++ {
		var pi @ir.Instr = pad.Instrs[ii]
		if pi.Op == iropcode.OP_LOAD && len(pi.Args) >= 1 && pi.Args[0] == x {
			return fail("managed pointer: the pad cleanup load must be deleted")
		}
	}
	if pdec.Args[0] != v0 {
		return fail("managed pointer: the pad RefDec must be rewritten to the stored value")
	}
	if ndec.Args[0] != v0 {
		return fail("managed pointer: the normal-block RefDec must be rewritten to the stored value")
	}
	return ""
}

// An interface-value slot — raw `*I` AND managed `@I` — is a 16-byte
// ADDRESS-aggregate: its OP_LOAD keeps the slot address, so store-forwarding the
// single stored value is unsound.  Even with a single dominating store and no
// fault pad (nothing bars it as an escape) both must be KEPT — before the
// address-aggregate guard they were forwarded and the VM read a nil interface
// value at -O1+.  Covers both kinds so dropping either from the guard fails here.
func TestForwardIfaceValueKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var rawIV @types.Type = types.MakeInterfaceValueType(types.MakeInterfaceType("m", "Iface"))
	var mgdIV @types.Type = types.MakeManagedInterfaceValueType(types.MakeInterfaceType("m", "Iface"))
	var xr @ir.Instr = irbuild.EmitAlloc(entry, rawIV)
	irbuild.EmitStore(entry, xr, irbuild.EmitConstNil(entry, rawIV))
	var vr @ir.Instr = irbuild.EmitLoad(entry, xr, rawIV)
	_ = vr
	var xm @ir.Instr = irbuild.EmitAlloc(entry, mgdIV)
	irbuild.EmitStore(entry, xm, irbuild.EmitConstNil(entry, mgdIV))
	var vm @ir.Instr = irbuild.EmitLoad(entry, xm, mgdIV)
	_ = vm
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(entry, noRet)

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail(
				"interface-value slots (16-byte address-aggregate, raw + managed) must not be store-forwarded")
	}
	return ""
}

// A function-value slot — raw `*func` AND managed `@func` — is likewise a 16-byte
// address-aggregate and must be KEPT for the same reason (the VM read a garbage
// func data pointer at -O1+ when it was forwarded).
func TestForwardFuncValueKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var noP @[]@types.Param
	var noR @[]@types.Type
	var rawFV @types.Type = types.MakeFuncValueType(noP, noR)
	var mgdFV @types.Type = types.MakeManagedFuncValueType(noP, noR)
	var xr @ir.Instr = irbuild.EmitAlloc(entry, rawFV)
	irbuild.EmitStore(entry, xr, irbuild.EmitConstNil(entry, rawFV))
	var vr @ir.Instr = irbuild.EmitLoad(entry, xr, rawFV)
	_ = vr
	var xm @ir.Instr = irbuild.EmitAlloc(entry, mgdFV)
	irbuild.EmitStore(entry, xm, irbuild.EmitConstNil(entry, mgdFV))
	var vm @ir.Instr = irbuild.EmitLoad(entry, xm, mgdFV)
	_ = vm
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(entry, noRet)

	forwardLoadsFunc(f)

	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail(
				"function-value slots (16-byte address-aggregate, raw + managed) must not be store-forwarded")
	}
	return ""
}
